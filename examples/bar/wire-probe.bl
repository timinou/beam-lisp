; examples/bar/wire-probe.bl — bisect the EPIPE: connect, send get_registry,
; print the exact bytes, then sync, then drain. Every step prints.

(ns bar.wire-probe
  (:require [wayland.wire :as wire]
            [wayland.conn :as conn]))

(let [r (conn/connect!)]
  (println (str "connect: " (pr-str (if (contains? r :error) (:error r) :ok))))
  (when (contains? r :ok)
    (let [c0 (:ok r)
          s (:socket c0)
          msg (wire/message 1 1 (wire/u32-le 2))]
      (println (str "get_registry bytes: " (pr-str (vec (to-list msg)))))
      (let [bin (wire/bytes-of msg)]
        (println (str "binary: " (pr-str bin) " size " (erlang/byte_size bin)))
        (let [sr (erlang/apply :socket :send (list s bin))]
          (println (str "send1: " (pr-str sr)))
          (erlang/apply :timer :sleep (list 300))
          (let [sr2 (erlang/apply :socket :send (list s (wire/bytes-of (wire/message 1 0 (wire/u32-le 3)))))]
            (println (str "send2 (sync): " (pr-str sr2)))
            (loop [i 0]
              (when (< i 6)
                (let [rr (erlang/apply :socket :recv (list s 8 600))]
                  (println (str "recv hdr: " (pr-str rr)))
                  (when (and (erlang/is_tuple rr) (= :ok (erlang/element 1 rr)))
                    (let [hdr (wire/read-header (wire/bin->bytes (erlang/element 2 rr)))
                          body-len (- (:size hdr) 8)
                          rb (if (> body-len 0)
                               (erlang/apply :socket :recv (list s body-len 600))
                               {:ok []})]
                      (println (str "  hdr " (pr-str hdr) " body " (pr-str (erlang/element 2 rb))))
                      (recur (inc i)))))))))))))
