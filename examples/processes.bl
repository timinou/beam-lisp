; processes.bl — beam-lisp fns are real Elixir fns, so OTP just works.
; Run: mix beam_lisp.run examples/processes.bl

(println "== two beam-lisp computations as BEAM processes ==")
(defn work [n]
  (loop [i 0 acc 0]
    (if (< i n)
      (recur (inc i) (+ acc i))
      acc)))

; Task/async takes an Elixir fun — which is exactly what (fn [] …) is.
(def t1 (Task/async (fn [] (work 1000000))))
(def t2 (Task/async (fn [] (work 500000))))
(println (+ (Task/await t1 10000) (Task/await t2 10000)))

(println "== an Agent holding beam-lisp data ==")
; Agent/start_link returns {:ok, pid}; tuples destructure via erlang/element.
(def box (erlang/element 2 (Agent/start_link (fn [] {:count 0}))))
(Agent/update box (fn [s] (Map/put s :count (inc (:count s)))))
(println (str "agent count: " (Agent/get box (fn [s] (:count s)))))

(println "== spawn/link: a supervised-style worker ==")
; spawn takes a fun too — our fns qualify anywhere Elixir's do.
(def worker (erlang/spawn (fn [] (println (str "hello from pid " (pr-str (erlang/self)))))))
(Process/sleep 50)
(println (str "spawned: " (pr-str worker)))
