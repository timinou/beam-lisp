#!/usr/bin/env bl
;; edn_report.bl — read an EDN data file, transform it, and print a report.
;; The archetypal Babashka job: EDN in, computed summary out. Exercises
;; clojure.edn (safe data reading), clojure.walk (keywordize), clojure.set
;; (relational ops), clojure.string (formatting), and the threading macros —
;; all unmodified Clojure idiom, on the BEAM.
;;
;; Run:  mix beam_lisp.run examples/babashka/edn_report.bl -- <data.edn>

(ns babashka.edn-report
  (:require [clojure.edn :as edn]
            [clojure.string :as str]
            [clojure.set :as set]
            [clojure.io]))

(defn load-people
  "Read a vector of person maps from an EDN file."
  [path]
  (edn/read-string (slurp path)))

(defn summarize
  "A report map: total people, the set of all roles seen, average age, and the
   names grouped by role."
  [people]
  {:total (count people)
   :roles (reduce set/union #{} (map (fn [p] (set (:roles p))) people))
   :avg-age (if (empty? people)
              0
              (/ (reduce + (map :age people)) (count people)))
   :by-role (reduce (fn [acc p]
                      (reduce (fn [a role]
                                (update a role (fn [names] (conj (or names []) (:name p)))))
                              acc
                              (:roles p)))
                    {}
                    people)})

(defn render [report]
  (str/join "\n"
    (concat
      [(str "People:  " (:total report))
       (str "Roles:   " (str/join ", " (sort (map name (:roles report)))))
       (str "Avg age: " (:avg-age report))
       "By role:"]
      (map (fn [role]
             (str "  " (name role) ": "
                  (str/join ", " (sort (get (:by-role report) role)))))
           (sort (keys (:by-role report)))))))

;; A bundled sample so the script self-demos when run with no file argument
;; (and so the example runner exercises it end-to-end, not just its defs).
(def sample-people
  [{:name "Ada"    :age 36 :roles [:admin :dev]}
   {:name "Grace"  :age 45 :roles [:admin]}
   {:name "Alan"   :age 41 :roles [:dev :ops]}
   {:name "Edsger" :age 40 :roles [:dev]}])

(defn -main [& args]
  (let [path (first args)
        people (if path (load-people path) sample-people)]
    (when (nil? path)
      (println "(no EDN file given — showing the bundled sample)"))
    (println (render (summarize people)))))

;; `current-command-line-args` resolves whether or not the script was run via
;; `bl run` (it reads the live argv); with no args -main shows the sample.
(apply -main (clojure.io/current-command-line-args))
