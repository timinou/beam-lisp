#!/usr/bin/env bl
;; wordfreq.bl — a word-frequency report, the kind of one-off text-crunching
;; script Babashka is loved for. Reads a text file, tokenizes with a regex,
;; lowercases, counts, and prints the top-N words.
;;
;; This is UNMODIFIED Clojure/Babashka idiom — clojure.string, regex, the
;; threading macros, frequencies, sort-by — running on the BEAM.
;;
;; Run:  mix beam_lisp.run examples/babashka/wordfreq.bl -- <file> [top-n]

(ns babashka.wordfreq
  (:require [clojure.string :as str]
            [clojure.io]))

(defn word-frequencies
  "Map of lowercased word -> count for all word-tokens in `text`."
  [text]
  (->> (re-seq (re-pattern "[A-Za-z']+") text)
       (map str/lower-case)
       frequencies))

(defn top-words
  "The `n` most frequent [word count] pairs in `text`, most frequent first."
  [text n]
  (->> (word-frequencies text)
       (sort-by val >)
       (take n)))

;; A bundled sample paragraph so the script self-demos with no file argument.
(def sample-text
  (str "the quick brown fox jumps over the lazy dog "
       "the dog barks the fox runs the quick fox wins "
       "a lazy dog sleeps while the quick fox thinks"))

(defn -main [& args]
  (let [file (first args)
        n (if (second args) (String/to_integer (second args)) 10)
        text (if file (slurp file) sample-text)
        label (if file file "(bundled sample)")
        total (count (re-seq (re-pattern "[A-Za-z']+") text))
        top (top-words text n)]
    (println (str "Top " n " words in " label " (" total " total):"))
    (println (str/join "\n"
      (map (fn [pair]
             (str "  " (str/join "" (repeat (- 4 (count (str (val pair)))) " "))
                  (val pair) "  " (key pair)))
           top)))))

;; `current-command-line-args` resolves whether or not the script was run via
;; `bl run` (it reads the live argv); with no args -main shows the bundled
;; sample, so the example runner exercises it end-to-end.
(apply -main (clojure.io/current-command-line-args))
