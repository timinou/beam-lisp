#!/usr/bin/env bl
;; loc.bl — a lines-of-code counter over a directory tree, the quintessential
;; Babashka utility. Globs source files, counts lines, groups by extension, and
;; prints a sorted table. Exercises babashka.fs (glob), clojure.string (split,
;; join), the threading macros, group-by, and sort-by — unmodified Clojure idiom
;; on the BEAM.
;;
;; Run:  mix beam_lisp.run examples/babashka/loc.bl -- <dir> [glob]

(ns babashka.loc
  (:require [babashka.fs :as fs]
            [clojure.string :as str]
            [clojure.io]))

(defn count-lines
  "Number of lines in the file at `path`."
  [path]
  (let [content (slurp path)]
    (if (= "" content)
      0
      (count (str/split content (re-pattern "\n"))))))

(defn ext-of [path]
  (or (fs/extension path) "(none)"))

(defn report
  "Map of extension -> {:files n :lines n} for all files matching `pattern`
   under `root` (recursively)."
  [root pattern]
  (->> (fs/glob root pattern)
       (filter fs/regular-file?)
       (reduce (fn [acc path]
                 (let [e (ext-of path)
                       lines (count-lines path)
                       cur (get acc e {:files 0 :lines 0})]
                   (assoc acc e {:files (+ 1 (:files cur))
                                 :lines (+ lines (:lines cur))})))
               {})))

(defn render [rep]
  (let [rows (sort-by (fn [pair] (:lines (val pair))) > rep)
        total-files (reduce + (map (fn [pair] (:files (val pair))) rep))
        total-lines (reduce + (map (fn [pair] (:lines (val pair))) rep))]
    (str/join "\n"
      (concat
        ["  ext     files    lines"
         "  ----    -----    -----"]
        (map (fn [pair]
               (let [e (key pair) v (val pair)]
                 (str "  " (pad (str e) 6) "  " (pad (str (:files v)) 6)
                      "  " (pad (str (:lines v)) 6))))
             rows)
        [(str "  " (pad "TOTAL" 6) "  " (pad (str total-files) 6)
              "  " (pad (str total-lines) 6))]))))

(defn pad [s n]
  (str s (str/join "" (repeat (max 0 (- n (count s))) " "))))

(defn -main [& args]
  ; defaults make this self-demoing: with no args it counts the compat layer's
  ; own .bl files, so `bl run loc.bl` prints a real table and the example runner
  ; exercises it end-to-end.
  (let [root (or (first args) "priv/compat")
        pattern (or (second args) "**/*.bl")]
    (println (str "LOC under " root " matching " pattern ":"))
    (println (render (report root pattern)))))

;; `current-command-line-args` resolves whether or not the script was run via
;; `bl run`; with no args -main uses the defaults above.
(apply -main (clojure.io/current-command-line-args))
