; aot_demo.bl — ahead-of-time compilation in action.
; Run: mix beam_lisp.run examples/aot_demo.bl
;
; Normal `defn` builds its per-namespace module at runtime (Module.create).
; AOT flips that: a `.bl` source is compiled once and its namespace module
; is written to disk as a .beam, then loaded in a fresh VM with no runtime
; compilation. This demo compiles examples/aot_target.bl ahead of time and
; calls the resulting module directly — the module is real BEAM code on the
; code path, not something synthesized by the compiler at call time.

(println "AOT-compiling examples/aot_target.bl ...")
(BeamLisp.AOT/compile_file "examples/aot_target.bl")

(println (BeamLisp.Ns.Examples.AotTarget/shout "hello"))
(println (str "sum-to(1000) = " (BeamLisp.Ns.Examples.AotTarget/sum-to 1000)))
