; examples/tooling/tick.bl — the heartbeat, in motion.
; Run: bl run examples/tooling/tick.bl
;
; A tick is a Timeout Edge with a body: a process that wakes itself. It is the
; primitive every other scheduling shape is built from, and it is deliberately
; small enough to read in one screen.
;
; What to watch for:
;
;   · a beat CANNOT overlap itself — it is a message, so a slow body delays the
;     next tick instead of stacking one (the counter and the state advance
;     together, never apart);
;   · `:anchor :wall` lands on a boundary, so it cannot drift;
;   · `:once` plus `tick-reset` is a DEBOUNCE: a burst of activity produces one
;     fire, because every reset makes the tick already in the mailbox stale;
;   · a throwing body, under `:on-error :continue`, is RECORDED, not swallowed.
;
; docs/scheduling/the-clock-and-the-wheel.md is the design of record.

(ns tooling.tick
  ; ONE require. `proc` is the tier's door: the FORM (defserver), the verbs, and
  ; — through the require itself — every clause this tree has registered.
  (:require [proc :as proc]))

(defn check! [truth message data]
  (when-not truth
    (throw (ex-info message data))))

;; ── 1. an interval beat ────────────────────────────────────────────────
;; The body runs, then re-arms. `n` and the body's own count advance together:
;; a tick that armed but did not run, or ran twice, would show as a gap.

(def interval-body-runs (atom 0))

(proc/defserver interval-beat
  (init [_] (ok {:n 0}))
  (tick 40 :ms [st]
    (do (swap! interval-body-runs inc)
        (noreply {:n (inc (:n st))})))
  (handle-call :n [_from st] (reply (:n st) st)))

(println "== an interval beat ==")
(let [s (start interval-beat nil {})]
  (Process/sleep 200)
  (let [n (call s :n)]
    (println (str "   200ms at 40ms  →  " n " ticks"))
    (check! (> n 2) "the beat should have fired several times" {:n n})
    (check! (= n @interval-body-runs) "state and body agreed on every fire" {}))
  (stop s))

;; ── 2. a wall-anchored beat ────────────────────────────────────────────
;; :anchor :wall re-arms to the next multiple of the period on the clock's
;; axis, so the tick lands on a boundary instead of drifting away from one.

(println "== a wall-anchored beat ==")
(let [period 500
      ; ONE reading of the clock. Asking a second time after the arm would
      ; measure the arming itself and drift by however long the call took.
      now (proc/wall-ms)
      armed (proc/tick-delay period {:anchor :wall} now)
      offset (rem (+ now armed) period)]
  (println (str "   arming " armed "ms puts the next tick " offset "ms past a boundary"))
  (check! (zero? offset) "a wall-anchored arm lands exactly on the boundary" {:offset offset}))

;; ── 3. a debounce ──────────────────────────────────────────────────────
;; {:once true} fires without re-arming, and every activity RESETS the timer.
;; The tick already in the mailbox is made stale by the generation bump, so a
;; burst produces exactly one fire — the quiet tail.

(proc/defserver debounced
  (init [_] (ok {:fires 0}))
  (tick 150 :ms {:once true} [st] (noreply {:fires (inc (:fires st))}))
  (handle-info [:activity] [st]
    (do (proc/tick-reset 150 {:name 'debounced}) (noreply st)))
  (handle-call :fires [_from st] (reply (:fires st) st)))

(println "== a debounce ==")
(let [s (start debounced nil {})]
  (doseq [_ (range 10)]
    (erlang/send s [:activity])
    (Process/sleep 20))
  (println (str "   200ms of activity, period 150ms  →  " (call s :fires) " fires"))
  (check! (= 0 (call s :fires)) "nothing fired while the burst was still arriving" {})
  (Process/sleep 320)
  (println (str "   320ms of quiet  →  " (call s :fires) " fires"))
  (check! (= 1 (call s :fires)) "the quiet tail fired exactly once" {})
  (stop s))

;; ── 4. a body that throws ──────────────────────────────────────────────
;; The default is to let it crash — the supervisor heals and re-arms, which is
;; the OTP answer. `:on-error :continue` is the other choice: keep beating, and
;; keep a record, rather than swallow the failure.

(def thrown (atom 0))

(proc/defserver flaky
  (init [_] (ok {:n 0}))
  (tick 25 :ms {:on-error :continue} [st]
    (do (swap! thrown inc)
        (if (< @thrown 3)
          (throw (ex-info "the first two throws are always" {:thrown @thrown}))
          (noreply {:n (inc (:n st))}))))
  (handle-call :n [_from st] (reply (:n st) st))
  (handle-call :failures [_from st] (reply (proc/tick-failures 'flaky) st)))

(println "== a throwing body ==")
(let [s (start flaky nil {})]
  (Process/sleep 200)
  (println (str "   2 throws of 3 beats  →  " (call s :n) " ticks ran, "
                (call s :failures) " recorded"))
  (check! (> (call s :n) 0) "the beat outlived the throws" {})
  (check! (>= (call s :failures) 2) "each throw was recorded, not swallowed" {})
  (stop s))

;; ── 5. what this is NOT ────────────────────────────────────────────────
;; A tick dies with its process and its counters die with it. A recurrence that
;; must survive a restart, that a human can pause, and that a pane can read
;; without asking a pid, is the Deadline Queue — `priv/lib/sched.bl` — where the
;; schedule is a fact in the store and the process is only the hand that turns
;; the wheel.

(println "== the boundary ==")
(println "   a tick lives in a process; a schedule lives in the store.")
(println "   rejected here, on purpose: "
         (try (proc/tick-delay 100 {:catch-up :coalesce} 0) "accepted?!"
              (catch e (str "a :catch-up option → "
                            (get e :message)))))

(println "\n✓ tick: the beat is a message you send yourself.")
