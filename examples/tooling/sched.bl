; examples/tooling/sched.bl — the deadline queue, in motion.
; Run: bl -p priv/std run examples/tooling/sched.bl
;
; A tick says "wake me in N ms". A schedule says "wake me when something is
; DUE" — and the something is declared, named, and inspectable. It is a CLAUSE,
; so it shares the process with whatever else the server does.
;
; What to watch for:
;
;   · the declaration is DATA: `spec` reads the whole thing back, and `next`
;     answers for one schedule without asking the process anything else;
;   · an occurrence has an ID (`<id>@<due>`), and the same occurrence is
;     refused twice — at-least-once delivery, at-most-once effect, with no store;
;   · the clock is a value, so "what happens after a 4-hour outage" is a test
;     you run in a millisecond rather than a thing you hope about;
;   · pause KEEPS the due, so resuming runs the occurrence it was on.

(ns tooling.sched
  ; ONE require: the form, the verbs, and every clause the tier has registered.
  (:require [proc :as proc]))

(defn check! [truth message data]
  (when-not truth
    (throw (ex-info message data))))

;; ── 1. a declaration ───────────────────────────────────────────────────
;; `:clock` is the injectable one; the shift lets this example move time
;; without moving it.

(def shift (atom 0))
(def log (atom []))

(defn now [] (+ (proc/wall-ms) @shift))

(proc/defserver house
  (init [_] (ok {:firm "acme"}))          ; the server's OWN slice of state
  (sched {:clock now}
    (every 60 :ms :reap  (fn [ev] (swap! log conj [:reap (:occurrence ev)]))
                             {:catch-up :skip :jitter 0.05})
    (at (+ (proc/wall-ms) 3600000) :go-live (fn [_] (swap! log conj [:go-live])))
    (daily 7 0 :digest (fn [_] (swap! log conj [:digest]))))
  (handle-call :firm [_from st] (reply (:firm st) st))
  (handle-call :log [_from st] (reply @log st)))

(println "== the declaration, as data ==")
(let [h (start house nil {})]
  (doseq [s (proc/spec h)]
    (println (str "   " (:id s)
                  "  " (pr-str (:rule s))
                  "  " (pr-str (:opts s))
                  "  next in " (:in-ms (proc/next h (:id s))) "ms")))
  (check! (= 3 (count (proc/spec h))) "three schedules are declared" {})
  (check! (= "acme" (call h :firm)) "…beside the server's own state" {})

  ;; ── 2. it fires ──────────────────────────────────────────────────────
  (println "== it fires ==")
  (Process/sleep 220)
  (let [n (count (call h :log))]
    (println (str "   220ms at 60ms  →  " n " runs"))
    (check! (> n 2) "several runs" {:n n}))

  ;; ── 3. an occurrence is refused twice ────────────────────────────────
  (println "== one occurrence, one run ==")
  (proc/pause h :reap)
  (Process/sleep 20)
  (let [before (count (call h :log))]
    (proc/run-now h :reap)
    (proc/run-now h :reap)
    (let [n (count (call h :log))]
      (println (str "   run-now twice  →  " (- n before) " run"))
      (check! (= (inc before) n)
              "the second run-now is refused: the occurrence id already ran" {})
      (check! (= "reap@" (subs (second (last (call h :log))) 0 5))
              "…and the id names the schedule and the due" {})))

  ;; ── 4. pause keeps the due ───────────────────────────────────────────
  (println "== pause keeps the due ==")
  (let [frozen (count (call h :log))]
    (Process/sleep 150)
    (check! (= frozen (count (call h :log))) "paused means paused" {})
    (println "   150ms paused  →  0 more runs"))
  (proc/resume h :reap)
  (Process/sleep 150)
  (check! (> (count (call h :log)) 0) "and resuming winds the wheel again" {})
  (println "   resumed  →  it is winding again")
  (stop h))

;; ── 5. a clock jump is a POLICY, not an accident ───────────────────────
;; Four hours pass while the process is alive but the wheel is not wound to
;; the gap. `:skip` drops it; `:coalesce` runs once, named by the period that
;; was missed rather than the instant it was noticed.

(println "== a clock jump ==")
(let [h (start house nil {})]
  (let [missed (:at (proc/next h :reap))]
    (reset! shift (* 4 3600000))
    (Process/sleep 150)
    (let [ran (some (fn [e] (= (:due (second e)) missed)) @log)]
      (println (str "   4 hours skipped  →  the missed occurrence "
                    (if ran "RAN" "was DROPPED") " (:catch-up :skip)"))
      (check! (not ran) ":skip dropped the gap and landed past now" {}))
    ;; …and the same jump under :coalesce runs exactly once
    (stop h)))

(println "\n✓ sched: the wheel is the store, and the store is not a loop.")
