; tooling/run-catalog.bl — the runnable entrypoint for the loom catalog.
;
; Run:  mix beam_lisp.run --path priv tooling/run-catalog.bl
;       BL_CATALOG_DIR=some/dir mix beam_lisp.run --path priv tooling/run-catalog.bl
;       (BL_CATALOG_DIR defaults to examples/loom)
; Open: http://127.0.0.1:4050
;
; This is a two-line file on purpose: tooling/catalog.bl is a pure LIBRARY (the
; engine, queries, and view — required freely by tests and other tools with no
; side effects), and THIS file is the only thing that actually indexes + serves.

(ns tooling.run-catalog
  (:require [tooling.catalog :as catalog]))

(catalog/main)
