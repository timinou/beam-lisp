; examples/semantic/04-local-rag.bl — private retrieval belongs beside private data.
; Run: mix beam_lisp.run --path priv --path examples examples/semantic/04-local-rag.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; Retrieval-augmented generation (RAG) first finds passages relevant to a
; question, then gives those passages to a language model as context. It is
; often drawn as a chain of cloud services. A personal app does not need
; that architecture: its journal, embeddings, and similarity index can live
; together in ONE embedded database on the phone.
;
; Here the journal never leaves the device. The fake embedder is local and
; deterministic, search makes no network request, and the store is one
; embedded file. Text and embeddings commit in the same transaction, so a
; search can never observe a journal entry without its matching vector.
;
; This example performs retrieval and assembles the prompt a real app WOULD
; hand to a local or remote LLM. It deliberately does not call an LLM.

(ns example.semantic.local-rag
  (:require [datom] [datom.vector] [semantic.embed :as embed]))

(defn- show [label v] (println (str "  " label "  " (pr-str v))))
(defn- heading [text] (println (str "\n" text)))

;; ── a private journal on the device ─────────────────────────────────

(def conn
  (datom/connect
    [{:db/ident :entry/date :db/valueType :db.type/string}
     {:db/ident :entry/text :db/valueType :db.type/string}
     {:db/ident :entry/embedding :db/valueType :db.type/vector}]))

;; These entries span ordinary parts of one life. The text is what we embed:
;; retrieval can therefore match a question's meaning even when its exact
;; wording never appeared in the journal.
(def entries
  [["May 03" "Adopted a tiny kitten today; the furry pet purred in my lap"]
   ["May 11" "Took the dog and puppy to the park for a long sunny walk"]
   ["May 19" "Reviewed my budget and moved money into the savings fund"]
   ["May 27" "Met with the bank to discuss a lower mortgage rate"]
   ["Jun 04" "Anxious about the software release deadline and too stressed to sleep"]
   ["Jun 12" "Debugged a difficult code bug, then refactored the software calmly"]
   ["Jun 20" "Burnout after a week of work deadlines; I need a quiet weekend"]
   ["Jun 28" "Baked sourdough bread and cooked dinner for friends"]
   ["Jul 06" "Practised a new song on guitar and felt happy afterwards"]
   ["Jul 14" "The cat and dog slept together; both pets looked peaceful"]])

;; Negative ids are transaction-local tempids. Each map writes the date, text,
;; and vector atomically — there is no second vector service to drift out of
;; sync with the journal.
(datom/transact! conn
  (into [] (map-indexed
             (fn [i entry]
               {:db/id (- (+ i 1))
                :entry/date (get entry 0)
                :entry/text (get entry 1)
                :entry/embedding (embed/embed (get entry 1))})
             entries)))

(def db (datom/db conn))

;; ── retrieval is a small local function ─────────────────────────────

(defn- retrieve
  "Embed a natural-language question and return its three nearest entries."
  [question]
  (let [q (embed/embed question)]
    (datom/q '[:find ?date ?text ?score
               :in $ ?q
               :where [(similar-to :entry/embedding ?q 3) [?e ?score]]
                      [?e :entry/date ?date]
                      [?e :entry/text ?text]]
             db q)))

(defn- context-block [matches]
  (join "\n"
    (map (fn [row] (str "- " (get row 0) ": " (get row 1))) matches)))

(defn- ask [question]
  (heading (str "── ask: " question " ──"))
  (let [matches (retrieve question)]
    (show "retrieved:" matches)
    matches))

;; The same function serves very different questions. There are no keyword
;; rules for "deadline" or "pets": the embedded question supplies the lens.
(def work-results (ask "When was I stressed about work?"))
(def pet-results (ask "What did I do with my pets?"))
(def money-results (ask "How was I handling money and savings?"))

;; ── assembling the RAG prompt ───────────────────────────────────────

(heading "── the prompt an LLM would receive ──")

(def question "When was I stressed about work?")
(def context (context-block work-results))
(def prompt
  (str "Use only these private journal entries to answer.\n\n"
       "CONTEXT\n" context "\n\n"
       "QUESTION\n" question))

(println prompt)

;; Retrieval stops here. A production app could pass `prompt` to an on-device
;; model for a fully offline flow, or — only with the user's consent — to a
;; remote model. This example makes no LLM call and no network request.

;; ── what to take away ───────────────────────────────────────────────

(heading "── what to take away ──")
(println "  Journal, embeddings, and search stay PRIVATE on the user's device")
(println "  The complete retrieval path works OFFLINE — no network or vector service")
(println "  One embedded store commits text and vectors transactionally together")
(println "  RAG is retrieval plus prompt assembly; the choice of LLM remains separate")
(println "\n  Next: 05-recommend.bl — finding useful neighbours without an LLM")
