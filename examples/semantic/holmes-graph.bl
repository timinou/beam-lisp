; examples/semantic/holmes-graph.bl — build the Holmes graph once, reuse it.
;
; Examples 13, 14 and 15 all need the same thing: the passages embedded and
; stored, and (for 14/15) the entity graph extracted from them. Rather than
; repeat that setup in each file, this helper builds a connection with
; everything in place. Because every model call is CACHED (see gemini.bl),
; the first run pays the API once and every later run is offline and fast.
;
; The schema it installs is the union of what the GraphRAG examples use:
;   passages   — text + story + embedding (the retrieval layer)
;   entities   — name (unique) + kind (the graph nodes)
;   relations  — source/target refs + kind (the graph edges)
;   community  — an entity's discovered community id + that community's summary

(ns semantic.holmes-graph
  (:require [datom] [datom.vector]
            [semantic.corpus-util :as corpus]
            [semantic.gemini :as gemini] [semantic.shape :as shape]))

(def CORPUS "examples/semantic/corpus/holmes.txt")

(def EXTRACTION
  {:entities [:list {:name :string
                     :kind [:enum "person" "place" "object" "organization"]}]
   :relationships [:list {:source :string
                          :target :string
                          :relation :string}]})

(defn- extract [text]
  (gemini/generate-structured
    (str "You are building a knowledge graph from Sherlock Holmes stories. "
         "Extract the named entities and the relationships between them from "
         "this passage. Use canonical names (e.g. 'Sherlock Holmes', not 'he'). "
         "Only include relationships where BOTH endpoints are named entities.\n\n"
         "Passage:\n" text)
    EXTRACTION))

(defn schema []
  [{:db/ident :passage/text :db/valueType :db.type/string}
   {:db/ident :passage/story :db/valueType :db.type/string}
   {:db/ident :passage/embedding :db/valueType :db.type/vector}
   {:db/ident :entity/name :db/valueType :db.type/string :db/unique :db.unique/identity}
   {:db/ident :entity/kind :db/valueType :db.type/keyword}
   {:db/ident :rel/source :db/valueType :db.type/ref}
   {:db/ident :rel/target :db/valueType :db.type/ref}
   {:db/ident :rel/kind :db/valueType :db.type/string}
   ; a direct entity->entity adjacency, materialised from relationships for
   ; community detection (which wants node-to-node edges, not edge entities).
   {:db/ident :entity/linked :db/valueType :db.type/ref :db/cardinality :db.cardinality/many}
   ; community results, written back onto entities as facts (example 14/15).
   {:db/ident :entity/community :db/valueType :db.type/long}
   {:db/ident :community/title :db/valueType :db.type/string}
   {:db/ident :community/summary :db/valueType :db.type/string}])

(defn build
  "A connection with `n` passages ingested and (when `with-graph?`) the
   entity graph extracted and stored. Returns the connection."
  [n with-graph?]
  (let [conn (datom/connect (schema))
        passages (into [] (take n (corpus/load-passages CORPUS 3)))]
    ;; passages + embeddings
    (datom/transact! conn
      (into [] (map-indexed
                 (fn [i p]
                   {:db/id (- (+ i 1))
                    :passage/story (get p 0)
                    :passage/text (get p 1)
                    :passage/embedding (gemini/embed-doc (get p 1))})
                 passages)))
    (when with-graph?
      (let [extractions (mapv (fn [p] (extract (get p 1))) passages)
            all-entities (into [] (distinct
                                    (reduce (fn [acc ex]
                                              (reduce (fn [a e] (conj a [(get e "name") (get e "kind")]))
                                                      acc (to-list (get ex "entities"))))
                                            [] extractions)))]
        (datom/transact! conn
          (into [] (map-indexed
                     (fn [i e] {:db/id (- (+ i 1))
                                :entity/name (get e 0)
                                :entity/kind (keyword (get e 1))})
                     all-entities)))
        (let [db0 (datom/db conn)
              eid (fn [nm]
                    (let [r (into [] (datom/q '[:find ?e :in $ ?n :where [?e :entity/name ?n]] db0 nm))]
                      (if (empty? r) nil (get (get r 0) 0))))
              edges (reduce (fn [acc ex]
                              (reduce (fn [a rel]
                                        (let [s (eid (get rel "source"))
                                              t (eid (get rel "target"))]
                                          (if (and (some? s) (some? t) (not (= s t)))
                                            (conj a {:rel/source s :rel/target t :rel/kind (get rel "relation")})
                                            a)))
                                      acc (to-list (get ex "relationships"))))
                            [] extractions)]
          (datom/transact! conn
            (into [] (map-indexed (fn [i e] (assoc e :db/id (- (+ i 1)))) edges))))))
    conn))

(defn entity-id
  "The id of the entity named `nm`, or nil."
  [db nm]
  (let [r (into [] (datom/q '[:find ?e :in $ ?n :where [?e :entity/name ?n]] db nm))]
    (if (empty? r) nil (get (get r 0) 0))))
