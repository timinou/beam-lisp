; examples/semantic/_embed.bl — a fake embedder, so the examples run offline.
;
; ── What this is, and what it is NOT ──────────────────────────────────
;
; A REAL embedding comes from a neural model: text in, a few hundred floats
; out, with the property that texts meaning similar things land near each
; other. That needs a model call — a network round trip and an API key —
; which would make these examples slow, non-deterministic, and unrunnable
; offline.
;
; So examples 01–10 use THIS instead: a deterministic word-hashing embedder.
; It is NOT a language model and does not understand anything. But it has
; the one property the examples need to DEMONSTRATE THE MECHANICS: texts
; sharing words (and, via a small hand-built concept lexicon, sharing
; TOPICS) get vectors that point in similar directions. That is enough to
; show similarity search, hybrid queries, clustering and community
; detection working for real — the query syntax and the engine are exactly
; what a real deployment uses; only the vector SOURCE is a toy.
;
; Examples 11–15 drop this and call Gemini for real (see _gemini.bl).
;
; ── How it works ──────────────────────────────────────────────────────
;
; Each word is hashed into a handful of the DIM dimensions and adds weight
; there. A small CONCEPTS table maps related words onto a shared "concept
; dimension", so "cat", "kitten" and "feline" reinforce the same axis and
; therefore end up near each other — the toy stand-in for meaning. The
; vector is then L2-normalised (by `datom.vector/embedding`).

(ns semantic.embed
  (:require [datom.vector]))

(def DIM 64)

;; ── a tiny concept lexicon ──────────────────────────────────────────
;;
;; Maps a word to a concept id. Words sharing a concept get extra weight on
;; the same dimension, so they cluster. This is what gives the offline demos
;; a semblance of *meaning* rather than pure lexical overlap. Real
;; embeddings learn millions of these relationships; here we hand-write a
;; dozen, enough for the fixtures the examples use.

(def CONCEPTS
  {"cat" 1 "kitten" 1 "feline" 1 "purr" 1 "meow" 1 "pet" 1 "furry" 1 "whisker" 1 "paw" 1
   "dog" 2 "puppy" 2 "canine" 2 "bark" 2 "woof" 2 "leash" 2 "fetch" 2
   "money" 3 "finance" 3 "bank" 3 "banking" 3 "invest" 3 "investing" 3 "loan" 3 "cash" 3
   "budget" 3 "saving" 3 "savings" 3 "mortgage" 3 "interest" 3 "fund" 3 "index" 3 "rate" 3
   "code" 4 "software" 4 "program" 4 "function" 4 "bug" 4 "compile" 4 "debug" 4
   "refactor" 4 "legacy" 4 "memory" 4 "leak" 4 "production" 4
   "rain" 5 "storm" 5 "weather" 5 "cloud" 5 "sunny" 5 "forecast" 5 "wind" 5
   "hiking" 5 "trail" 5 "autumn" 5 "outdoor" 5
   "food" 6 "cook" 6 "recipe" 6 "bake" 6 "baking" 6 "eat" 6 "meal" 6 "kitchen" 6
   "dinner" 6 "bread" 6 "sourdough" 6 "dough" 6
   "music" 7 "song" 7 "guitar" 7 "melody" 7 "concert" 7 "piano" 7 "rhythm" 7
   "travel" 8 "flight" 8 "hotel" 8 "trip" 8 "journey" 8 "vacation" 8 "passport" 8
   "anxious" 9 "anxiety" 9 "stress" 9 "worried" 9 "deadline" 9 "overwhelm" 9 "burnout" 9
   "happy" 10 "joy" 10 "grateful" 10 "calm" 10 "peaceful" 10 "content" 10 "relaxed" 10})

(defn- words
  "Lowercase `text` and split into words on any non-letter run.

   `re/split` (not `binary/split`): the latter treats its pattern as a
   LITERAL string, so `[^a-z]+` would match nothing and the whole text
   would come back as one giant word."
  [text]
  (filterv (fn [w] (> (count w) 0))
           (re/split (String/downcase text) "[^a-z]+")))

(defn- stem
  "A crude stemmer: drop a trailing `s` so `meows`/`cats` reduce to
   `meow`/`cat`. Real embedders learn morphology; this one gets a single
   rule, enough that plurals in the demo text still hit the concept table."
  [w]
  (if (and (> (count w) 3) (= "s" (subs w (- (count w) 1) (count w))))
    (subs w 0 (- (count w) 1))
    w))

(defn- concept-of
  "The concept id for a word, trying the word then its stem."
  [w]
  (let [direct (get CONCEPTS w)]
    (if (some? direct) direct (get CONCEPTS (stem w)))))

(defn- add-weight
  "Add `w` to dimension `i` of the accumulator vector `acc`."
  [acc i w]
  (assoc acc (rem i DIM) (+ (get acc (rem i DIM)) w)))

(defn raw-vector
  "The un-normalised DIM-vector for `text`: word hashes plus concept
   reinforcement. Returned as a plain vector of floats."
  [text]
  (let [ws (words text)
        zero (into [] (mapv (fn [_] 0.0) (range DIM)))]
    (reduce
      (fn [acc word]
        ; every word contributes to two hashed dimensions (so vectors are
        ; not one-hot and near-synonyms can partially overlap)…
        (let [h1 (erlang/phash2 word DIM)
              h2 (erlang/phash2 (str word "#2") DIM)
              acc1 (add-weight (add-weight acc h1 1.0) h2 0.5)
              ; …and, if it names a concept, a strong contribution to that
              ; concept's own dimension, which is what makes topically
              ; related texts cluster.
              concept (concept-of word)]
          (if (nil? concept)
            acc1
            (add-weight acc1 (+ 40 concept) 3.0))))
      zero
      ws)))

(defn embed
  "A `DVec` embedding for `text` — the offline stand-in for a model call.

   THIS is the one line a real deployment changes: swap `embed` for a call
   to `ReqLLM.Embedding`/Gemini (see 11-ingest.bl). Everything downstream —
   storage, `similar-to`, clustering — is identical."
  [text]
  (datom.vector/embedding (raw-vector text)))

(defn embed-all
  "Embed a sequence of texts."
  [texts]
  (mapv embed (to-list texts)))
