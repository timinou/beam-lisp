; examples/semantic/10-time-travel-search.bl — semantic search through database history.
; Run: mix beam_lisp.run --path priv --path examples examples/semantic/10-time-travel-search.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; A normal vector database answers "what is similar now?" This database can
; also answer "what was similar when the corpus looked like it did last week?"
; Embeddings are datoms, so they inherit the same transaction history as every
; other fact. `as-of` chooses a historical basis; `similar-to` searches only
; the embedding datoms visible at that basis.
;
; We will grow one collection in three transactions, remember each boundary,
; then run the EXACT same finance query against week 1, week 2, and today.
; Week 1 has no finance document. Week 2 does. Week 3 keeps those results while
; adding a different topic — all without snapshots or separate vector indexes.

(ns example.semantic.time-travel-search
  (:require [datom] [datom.vector] [semantic.embed :as embed]))

(defn- show [label v] (println (str "  " label "  " (pr-str v))))
(defn- heading [text] (println (str "\n" text)))

;; ── a collection that grows week by week ───────────────────────────

(def conn
  (datom/connect
    [{:db/ident :d/title :db/valueType :db.type/string}
     {:db/ident :d/emb :db/valueType :db.type/vector}]))

(defn- add-documents! [titles]
  ;; Tempids belong to one transaction, so each wave safely starts again at -1.
  (datom/transact! conn
    (into [] (map-indexed
               (fn [i title]
                 {:db/id (- (+ i 1))
                  :d/title title
                  :d/emb (embed/embed title)})
               titles))))

;; Week 1: only pets exist. Capture the basis AFTER this transaction: it is a
;; durable coordinate in database history, not a copy of the vector index.
(add-documents!
  ["Caring for a furry kitten with tiny paws"
   "Training a puppy to fetch and walk on a leash"
   "Why cats purr and twitch their whiskers"])
(def t-week-1 (datom/basis-t (datom/db conn)))

;; Week 2 adds the first finance material.
(add-documents!
  ["Choosing a savings fund for an emergency budget"
   "Comparing mortgage interest rates and bank loans"
   "Investing spare cash in a low-cost index fund"])
(def t-week-2 (datom/basis-t (datom/db conn)))

;; Week 3 adds software documents. The older bases still see neither this wave
;; nor any other datom transacted after their transaction boundary.
(add-documents!
  ["Debugging a memory leak in production software"
   "Refactoring code before the next compile"
   "Finding a subtle bug in a concurrent program"])
(def db-now (datom/db conn))
(def t-week-3 (datom/basis-t db-now))

(heading "── one corpus, three transaction boundaries ──")
(show "week 1 basis:" t-week-1)
(show "week 2 basis:" t-week-2)
(show "week 3 basis:" t-week-3)

;; ── the same semantic query at every point in history ───────────────

(def finance-query (embed/embed "finance savings mortgage bank fund"))

(defn- search [db]
  (datom/q '[:find ?title ?score
             :in $ ?q
             :where [(similar-to :d/emb ?q 20) [?e ?score]]
                    [?e :d/title ?title]]
           db finance-query))

(heading "── finance search AS OF week 1 ──")
(show "same query:" (search (datom/as-of db-now t-week-1)))
(println "  Only three pet documents existed. Any returned nearest neighbours are")
(println "  visibly irrelevant (and score near zero); finance had not entered history.")

(heading "── finance search AS OF week 2 ──")
(show "same query:" (search (datom/as-of db-now t-week-2)))
(println "  The finance documents now appear, while week 3 code is still invisible.")

(heading "── finance search against the current database ──")
(show "same query:" (search db-now))
(println "  All nine documents are candidates now; the finance matches remain strongest.")

;; `similar-to` needs no temporal option. It reads :d/emb through the database
;; value passed to the query, and that value already carries the `as-of` basis.
;; The ordinary title join uses that same basis, so vectors and facts cannot
;; drift into different historical snapshots.

;; ── why this is different from a bolt-on vector store ──────────────

(heading "── what a separate vector database would require ──")
(println "  A bolt-on vector database knows its current vectors, not datom history.")
(println "  Reproducing each old answer means snapshotting and reindexing that store")
(println "  for every point in time, then keeping its ids aligned with the fact DB.")
(println "  Here the transaction basis is already the history and already the index bound.")

;; ── what to take away ───────────────────────────────────────────────

(heading "── what to take away ──")
(println "  Embeddings are datoms, so semantic search inherits database time travel")
(println "  as-of changes the visible corpus; the similar-to clause needs no special flag")
(println "  Vectors and joined facts are read at one transaction-consistent basis")
(println "  Historical vector answers need no copied corpus and no rebuilt external index")
(println "\n  Next: 11-ingest.bl — real Gemini embeddings over the Sherlock Holmes canon")

:ok
