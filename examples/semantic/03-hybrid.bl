; examples/semantic/03-hybrid.bl — the join a vector database cannot do.
; Run: mix beam_lisp.run --path priv --path examples examples/semantic/03-hybrid.bl
;
; ── The whole point, in one sentence ──────────────────────────────────
;
; Because `similar-to` is a datalog CLAUSE and not a call to a separate
; system, it JOINS with ordinary facts — so you can ask for things that are
; semantically similar AND satisfy structured constraints, in ONE query,
; over ONE consistent snapshot.
;
; A bolt-on vector database (Pinecone, a pgvector service) cannot do this.
; It returns the k nearest vectors; then YOU fetch those ids from your real
; database and filter them, hoping the two systems agree. Here the
; similarity and the facts are the same datoms, so the join is free and
; always consistent.
;
; ── The two modes of similar-to ───────────────────────────────────────
;
; The clause behaves differently depending on whether its entity is already
; bound — and this falls straight out of how datalog unifies:
;
;   FREE ?e  — GENERATE: emit the k nearest as new rows (ordinary search).
;   BOUND ?e — FILTER: score only the entities upstream clauses selected.
;
; The second mode is the one that makes "similar AND structured" cheap: run
; the cheap structured filters first to a handful of candidates, THEN score
; just those.

(ns example.semantic.hybrid
  (:require [datom] [datom.vector] [semantic.embed :as embed]))

(defn- show [label v] (println (str "  " label "  " (pr-str v))))
(defn- heading [text] (println (str "\n" text)))

;; ── a journal of notes with real metadata ───────────────────────────

(def conn
  (datom/connect
    [{:db/ident :note/text :db/valueType :db.type/string}
     {:db/ident :note/embedding :db/valueType :db.type/vector}
     {:db/ident :note/day :db/valueType :db.type/long}          ; day number
     {:db/ident :note/tag :db/valueType :db.type/keyword}]))

;; Nine notes across a few weeks, each tagged and dated. Some are about
;; work stress, some about pets, some about money.
(def notes
  [["Missed the release deadline again, feeling overwhelmed"   28 :work]
   ["The kitten finally learned to use the scratching post"     27 :home]
   ["Reviewed the budget; savings are finally growing"          26 :money]
   ["Anxious about the quarterly review next week"              25 :work]
   ["Took the dog for a long walk, felt calm afterwards"        24 :home]
   ["Refinanced the mortgage at a much better rate"             20 :money]
   ["Burned out after three weeks of overtime"                  19 :work]
   ["Adopted a second cat; the two are inseparable"            15 :home]
   ["Set up an automatic transfer into the index fund"          12 :money]])

(datom/transact! conn
  (into [] (map-indexed
             (fn [i note]
               {:db/id (- (+ i 1))
                :note/text (get note 0)
                :note/embedding (embed/embed (get note 0))
                :note/day (get note 1)
                :note/tag (get note 2)})
             notes)))

(def db (datom/db conn))

;; ── the flagship query ──────────────────────────────────────────────

(heading "── notes that FEEL like burnout, tagged :work, in the last fortnight ──")

;; Read the query top to bottom:
;;   1. semantic — the 20 notes nearest to a "burnout" query vector
;;   2. factual  — keep only those tagged :work
;;   3. temporal — keep only those from day 21 onward
;; Vector search NARROWS; datalog FILTERS; one engine, one snapshot.

(def burnout (embed/embed "exhausted and stressed from too much work"))

(show "result:"
  (datom/q '[:find ?text ?score
             :in $ ?q
             :where [(similar-to :note/embedding ?q 20) [?e ?score]]
                    [?e :note/tag :work]
                    [?e :note/day ?day]
                    [(>= ?day 21)]
                    [?e :note/text ?text]]
           db burnout))

;; Only the work-tagged, recent, burnout-ish notes survive. The pet and
;; money notes are semantically far AND filtered out by tag; the older
;; burnout note is filtered out by date.

;; ── the same data, a different lens ─────────────────────────────────

(heading "── money notes similar to 'growing my savings' ──")

(def savings (embed/embed "growing my savings over time"))
(show "result:"
  (datom/q '[:find ?text ?score
             :in $ ?q
             :where [?e :note/tag :money]                 ; structured FIRST
                    [(similar-to :note/embedding ?q 20) [?e ?score]]  ; then score
                    [?e :note/text ?text]]
           db savings))

;; Here the tag clause runs first and binds ?e to just the money notes;
;; `similar-to` then SCORES those (the bound-?e filter mode). Same answer,
;; but the work happens in the other order — the planner's choice.

;; ── what to take away ───────────────────────────────────────────────

(heading "── what to take away ──")
(println "  similar-to JOINS with facts because it is a clause, not a service call")
(println "  'Semantically near AND tagged X AND recent' is ONE query, ONE snapshot")
(println "  Free ?e generates neighbours; bound ?e scores an existing candidate set")
(println "  No external vector DB can join meaning against your facts like this")
(println "\n  Next: 04-local-rag.bl — private, offline retrieval on a device")
