; examples/semantic/07-cluster.bl — discovering themes without labels.
; Run: mix beam_lisp.run --path priv --path examples examples/semantic/07-cluster.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; Clustering groups items so similar ones land together, WITHOUT you
; labelling anything. "Here are 200 support tickets — what are the natural
; themes?" is a clustering question: nobody told the machine the themes,
; it finds them from the embeddings.
;
; Here it is one datalog clause:
;
;   [(cluster :doc/embedding {:method :k-means :k 4}) [?e ?cluster]]
;
; binds each entity to a cluster id (0..k). Because that id is an ordinary
; bound variable, it JOINS and AGGREGATES like anything else — "how many
; items per discovered theme" is clustering + the group-by the query engine
; already has.
;
; ── Prior art ─────────────────────────────────────────────────────────
;
; Clustering inside datalog is established: Zaniolo et al. (2019) express
; k-means and k-nearest-neighbours as recursive datalog rules, and systems
; like SociaLite and BigDatalog run in-database ML this way. We do the
; numeric heavy lifting in Rust (k-means++), exposed as a clause.

(ns example.semantic.cluster
  (:require [datom] [datom.vector] [semantic.embed :as embed]))

(defn- show [label v] (println (str "  " label "  " (pr-str v))))
(defn- heading [text] (println (str "\n" text)))

;; ── a pile of unlabelled documents ──────────────────────────────────

(def conn
  (datom/connect
    [{:db/ident :doc/title :db/valueType :db.type/string}
     {:db/ident :doc/embedding :db/valueType :db.type/vector}]))

;; Twelve documents drawn from four topics, in NO order and with NO topic
;; label stored. The clustering has to rediscover the four groups.
(def documents
  ["Caring for a new kitten and litter training"
   "Refinancing a mortgage to a lower interest rate"
   "Debugging a memory leak in production software"
   "Best hiking trails to see the autumn weather"
   "Adopting a rescue puppy in its first week"
   "Building an emergency savings fund"
   "Refactoring legacy code without breaking it"
   "A weekend trip: flights, hotel, and packing"
   "Why cats purr and what it means"
   "Choosing an index fund for retirement"
   "Compiling and profiling a slow program"
   "Training a dog to fetch and sit"])

(datom/transact! conn
  (into [] (map-indexed
             (fn [i title]
               {:db/id (- (+ i 1))
                :doc/title title
                :doc/embedding (embed/embed title)})
             documents)))

(def db (datom/db conn))

;; ── cluster into 4 groups ───────────────────────────────────────────

(heading "── k-means into 4 clusters (themes are DISCOVERED, not given) ──")

;; Each document gets a cluster id. We print them grouped so the themes
;; are visible: pets, money, code, outdoors/travel should emerge.
(def assigned
  (into [] (datom/q '[:find ?cluster ?title
                      :where [(cluster :doc/embedding {:method :k-means :k 4}) [?e ?cluster]]
                             [?e :doc/title ?title]]
                    db)))

(def by-cluster (group-by (fn [row] (get row 0)) assigned))
(doseq [cluster (sort (keys by-cluster))]
  (println (str "\n  cluster " cluster ":"))
  (doseq [row (get by-cluster cluster)]
    (println (str "    - " (get row 1)))))

;; ── clustering composes with aggregation ────────────────────────────

(heading "── how many documents per discovered theme ──")

;; The cluster id is just a bound variable, so the aggregation the engine
;; already has counts per cluster — no special machinery.
(show "counts:"
  (datom/q '[:find ?cluster (count ?e)
             :where [(cluster :doc/embedding {:method :k-means :k 4}) [?e ?cluster]]]
           db))

;; ── what to take away ───────────────────────────────────────────────

(heading "── what to take away ──")
(println "  Clustering finds themes with NO labels — from the embeddings alone")
(println "  [(cluster :attr {:k n}) [?e ?cluster]] binds each entity to a group")
(println "  The cluster id is an ordinary variable, so it joins and aggregates")
(println "  k-means here; the verb is generic so density methods can join later")
(println "\n  Next: 08-reduce-2d.bl — see the clusters as a picture")
