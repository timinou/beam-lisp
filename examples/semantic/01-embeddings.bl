; examples/semantic/01-embeddings.bl — a vector is just a fact.
; Run: mix beam_lisp.run --path priv --path examples examples/semantic/01-embeddings.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; An EMBEDDING is a list of numbers a model produces from text, with one
; magic property: texts that MEAN similar things get vectors that point in
; similar directions. "I'm anxious about my deadline" and "work stress is
; keeping me up" share no words, yet their vectors are close.
;
; This database already stores facts as datoms — `[entity attribute value]`.
; The whole trick of semantic search here is that an embedding is just
; another kind of value. Store it as a datom and it is durable, it commits
; atomically with the entity it describes, and it time-travels — every
; property the database already guarantees, for free.
;
; This file shows the raw mechanics: make an embedding, store it, read it
; back, and measure similarity by hand. Later files let the query engine do
; the searching.
;
; (The embeddings here come from a fake offline embedder — see embed.bl.
;  A real deployment calls a model; the mechanics are identical.)

(ns example.semantic.embeddings
  (:require [datom] [datom.vector] [semantic.embed :as embed]))

(defn- show [label v] (println (str "  " label "  " (pr-str v))))
(defn- heading [text] (println (str "\n" text)))

;; ── an embedding is a value ─────────────────────────────────────────

(heading "── a vector is a value ──")

(def v (embed/embed "the cat sat on the mat"))
(show "dimensionality:" (datom.vector/dim v))
(show "first 6 numbers:" (into [] (take 6 (datom.vector/to-floats v))))

;; It is NORMALISED — its length is 1 — which is what lets "similarity" be
;; a single multiplication (a dot product) later. The numbers you read back
;; are the unit vector, not the raw input.

;; ── storing one as a datom ──────────────────────────────────────────

(heading "── store it like any other fact ──")

;; `:db.type/vector` is the value type that says "this column holds
;; embeddings, searchable by similarity" — exactly as `:db.type/ref` says
;; "this column holds references, navigable in reverse".

(def conn
  (datom/connect
    [{:db/ident :note/text :db/valueType :db.type/string}
     {:db/ident :note/embedding :db/valueType :db.type/vector}]))

(datom/transact! conn
  [{:db/id -1
    :note/text "the cat sat on the mat"
    :note/embedding (embed/embed "the cat sat on the mat")}])

(def db (datom/db conn))

;; The embedding is now a fact about the note entity, read like any other.
(def note-id
  (get (get (into [] (datom/q '[:find ?e :where [?e :note/text _]] db)) 0) 0))
(def stored (datom/entity db note-id))
(show "the note's text:" (:note/text stored))
(show "its embedding is a DVec:" (datom.vector/vec? (:note/embedding stored)))
(show "of dimensionality:" (datom.vector/dim (:note/embedding stored)))

;; ── similarity, by hand ─────────────────────────────────────────────

(heading "── closeness IS a dot product ──")

;; Cosine similarity of two unit vectors is their dot product: 1.0 means
;; identical direction, 0.0 means unrelated, -1.0 means opposite. We can
;; ask the vector engine to score one candidate to see the raw number.

(defn- similarity
  "Cosine similarity between two embeddings."
  [a b]
  (get (get (into [] (datom.vector/search a [[0 b]] 1 0)) 0) 1))

(def cat "the cat sat on the mat")
(def kitten "a small kitten purred softly")
(def finance "quarterly earnings and the stock market")

(show "cat ~ kitten (both feline):" (similarity (embed/embed cat) (embed/embed kitten)))
(show "cat ~ finance (unrelated):" (similarity (embed/embed cat) (embed/embed finance)))
(show "cat ~ cat (identical):" (similarity (embed/embed cat) (embed/embed cat)))

;; ── what to take away ───────────────────────────────────────────────

(heading "── what to take away ──")
(println "  An embedding is a list of numbers where CLOSE means SIMILAR MEANING")
(println "  :db.type/vector stores one as an ordinary, durable, time-travelling fact")
(println "  Vectors are normalised, so similarity is one dot product")
(println "  Nothing here is a separate 'vector database' — it is the datom store")
(println "\n  Next: 02-similar-to.bl — let the query engine do the searching")
