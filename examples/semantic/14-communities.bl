; examples/semantic/14-communities.bl — themes discovered, then summarised.
; Run: GOOGLE_API_KEY=... mix beam_lisp.run --path priv --path examples examples/semantic/14-communities.bl
;
; ── The GraphRAG index ────────────────────────────────────────────────
;
; File 13 turned the prose into a graph of entities and relationships. This
; file does the two steps that make GraphRAG answer GLOBAL questions:
;
;   1. DETECT COMMUNITIES — run community detection over the entity graph to
;      find densely-connected clusters. Each cluster is a "theme" the corpus
;      formed on its own: the people and places that co-occur in one web of
;      relationships (a case's cast, a criminal network).
;
;   2. SUMMARISE EACH COMMUNITY — have the model write a short summary of
;      each cluster from its member entities, and store that summary as a
;      datom. These summaries are the GraphRAG INDEX: pre-digested "what this
;      theme is about", ready to answer questions no single passage can.
;
; The community detection is the `community` clause you saw in example 09 —
; label propagation over a ref graph — now over a graph EXTRACTED FROM REAL
; PROSE. The summarisation uses structured output again, so the summary
; comes back as data in a declared shape.

(ns example.semantic.communities
  (:require [datom] [datom.vector]
            [semantic.holmes-graph :as hg]
            [semantic.gemini :as gemini] [semantic.shape :as shape]))

(defn- show [label v] (println (str "  " label "  " (pr-str v))))
(defn- heading [text] (println (str "\n" text)))

(def N-PASSAGES 40)

;; ── build the graph (cached) ────────────────────────────────────────

(heading "── building the entity graph ──")
(def conn (hg/build N-PASSAGES true))
(def db (datom/db conn))
(show "entities:" (datom/q '[:find (count ?e) :where [?e :entity/name _]] db))
(show "relationships:" (datom/q '[:find (count ?r) :where [?r :rel/kind _]] db))

;; ── detect communities in the graph ─────────────────────────────────

(heading "── detecting communities (label propagation over the graph) ──")

;; Build one undirected edge attribute the community clause can read. The
;; graph stored source/target as two ref attributes on a relationship
;; entity; for community detection we want entity→entity adjacency, so we
;; materialise a direct :entity/linked ref between the endpoints.
(def link-tx
  (reduce (fn [acc r]
            (let [s (get r 0) t (get r 1)]
              (conj acc {:db/id s :entity/linked t})))
          []
          (into [] (datom/q '[:find ?s ?t
                              :where [?r :rel/source ?s] [?r :rel/target ?t]]
                            db))))

;; :entity/linked is in the base schema; assert the adjacency edges.
(datom/transact! conn (into [] link-tx))
(def db2 (datom/db conn))

;; Now the community clause groups entities by connection.
(def communities
  (into [] (datom/q '[:find ?name ?comm
                      :where [(community :entity/linked) [?e ?comm]]
                             [?e :entity/name ?name]]
                    db2)))

(def by-comm (group-by (fn [row] (get row 1)) communities))
;; keep only communities with several members — singletons are not themes
(def real-comms
  (filterv (fn [pair] (>= (count (val pair)) 3))
           (seq by-comm)))

(show "communities found:" (count by-comm))
(show "communities with >= 3 members:" (count real-comms))

(doseq [pair (take 6 real-comms)]
  (println (str "\n  community " (key pair) " (" (count (val pair)) " members):"))
  (println (str "    " (join ", " (to-list (mapv (fn [r] (get r 0)) (take 8 (val pair))))))))

;; ── summarise each community with structured output ─────────────────

(heading "── summarising each community (the GraphRAG index) ──")

;; A summary shape: a title and a paragraph. Declared once; the JSON Schema
;; the model obeys is derived from it.
(def SUMMARY {:title :string :summary :string})

(defn summarise [members]
  (gemini/generate-structured
    (str "These entities from the Sherlock Holmes stories form one connected "
         "group. Give the group a short descriptive TITLE and a one-sentence "
         "SUMMARY of what connects them.\n\nEntities: "
         (join ", " (to-list members)))
    SUMMARY))

;; Summarise the largest few communities and print their titles + summaries.
(def top-comms (take 4 (reverse (sort-by (fn [p] (count (val p))) real-comms))))

(doseq [pair top-comms]
  (let [members (mapv (fn [r] (get r 0)) (val pair))
        s (summarise members)]
    (println (str "\n  “" (get s "title") "”"))
    (println (str "    " (get s "summary")))
    (println (str "    members: " (join ", " (to-list (take 6 members)))))))

;; ── what to take away ───────────────────────────────────────────────

(heading "── what to take away ──")
(println "  Community detection finds THEMES in the extracted graph, unsupervised")
(println "  Each theme is summarised once, into a datom — the GraphRAG index")
(println "  Same `community` clause as example 09, now over graph-from-prose")
(println "  These summaries answer GLOBAL questions no single passage can — next")
(println "\n  Next: 15-graphrag.bl — local vs global search, the whole system")
