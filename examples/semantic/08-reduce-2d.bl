; examples/semantic/08-reduce-2d.bl — turning embeddings into a picture a human can navigate.
; Run: mix beam_lisp.run --path priv --path examples examples/semantic/08-reduce-2d.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; An embedding may have hundreds of coordinates. That is useful to a
; machine, but a human cannot look at one and see its shape. PCA finds the
; two directions along which the whole collection varies most, then projects
; every embedding onto those directions. Related documents should land near
; one another in the resulting (x, y) plane.
;
; This is how "10,000 embeddings" becomes a picture a person can navigate:
; dense patches reveal themes, isolated points reveal outliers, and nearby
; points invite inspection. PCA is linear and fast. UMAP and t-SNE are useful
; nonlinear alternatives, but they are not implemented here.
;
; Here projection is one generating datalog clause:
;
;   [(project-2d :d/emb) [?e ?x ?y]]
;
; It binds each entity to two floats. Those bindings join with titles — and
; with a second analytic clause — exactly like stored facts.

(ns example.semantic.reduce-2d
  (:require [datom] [datom.vector] [semantic.embed :as embed]))

(defn- show [label v] (println (str "  " label "  " (pr-str v))))
(defn- heading [text] (println (str "\n" text)))

;; ── four themes in a high-dimensional space ────────────────────────

(def conn
  (datom/connect
    [{:db/ident :d/title :db/valueType :db.type/string}
     {:db/ident :d/emb :db/valueType :db.type/vector}]))

;; The topic names are deliberately NOT stored. Only text and its embedding
;; enter the database; geometric structure must recover pets, money, code,
;; and weather/outdoors from the words themselves.
(def documents
  ["A furry kitten with whiskers and a gentle purr"
   "A playful kitten with furry paws and whiskers"
   "A rescue cat is a calm family pet"
   "Planning a savings budget for the bank"
   "Mortgage interest and an investment fund"
   "A cash loan for personal finance"
   "Debugging a memory leak in software"
   "Refactor code before the program compile"
   "Fixing a stubborn bug in the program"
   "Rain clouds gathering above the hiking trail"
   "Autumn weather on a mountain hike"
   "A storm arrives during an outdoor trail walk"])

(datom/transact! conn
  (into [] (map-indexed
             (fn [i title]
               {:db/id (- (+ i 1))
                :d/title title
                :d/emb (embed/embed title)})
             documents)))

(def db (datom/db conn))

;; ── project every embedding onto the same two axes ─────────────────

(heading "── high-dimensional documents projected into 2-D ──")

;; project-2d examines the collection as a whole: x and y only make sense
;; relative to this snapshot. Coordinates can be positive or negative; their
;; absolute values do not matter. Distances and neighbourhoods do.
(def projected
  (into []
    (datom/q '[:find ?title ?x ?y
               :where [(project-2d :d/emb) [?e ?x ?y]]
                      [?e :d/title ?title]]
             db)))

(doseq [row (sort-by (fn [row] (get row 1)) projected)]
  (println (str "  (" (get row 1) ", " (get row 2) ")  " (get row 0))))

(show "points projected:" (count projected))

;; ── independent analyses should tell the same story ───────────────

(heading "── coordinates grouped by independently discovered cluster ──")

;; k-means works in the ORIGINAL embedding space; PCA supplies only x and y.
;; Joining both generated relations on ?e lets us compare them. If reduction
;; preserved the important structure, rows in one cluster should occupy a
;; nearby patch of the printed coordinate plane.
(def compared
  (into []
    (datom/q '[:find ?cluster ?x ?y ?title
               :where [(project-2d :d/emb) [?e ?x ?y]]
                      [(cluster :d/emb {:method :k-means :k 4}) [?e ?cluster]]
                      [?e :d/title ?title]]
             db)))

(def by-cluster (group-by (fn [row] (get row 0)) compared))
(doseq [cluster (sort (keys by-cluster))]
  (println (str "\n  cluster " cluster " (same digit = same high-D group):"))
  (doseq [row (sort-by (fn [row] (get row 1)) (get by-cluster cluster))]
    (println (str "    " cluster "  (" (get row 1) ", " (get row 2) ")  " (get row 3)))))

;; This is visual proof rather than a new metric: inspect each block. Its three
;; points should have similar coordinates, while other blocks occupy different
;; regions. The cluster ids themselves are arbitrary and may change between
;; runs; agreement means spatial grouping, not a particular digit.

;; ── what to take away ───────────────────────────────────────────────

(heading "── what to take away ──")
(println "  PCA finds the two directions of greatest variance in the collection")
(println "  Related embeddings land nearby, turning a corpus into a visible map")
(println "  k-means uses high-D vectors; nearby projected cluster-mates show agreement")
(println "  PCA is linear and fast; UMAP and t-SNE are nonlinear alternatives")
(println "\n  Next: 09-community.bl — discover communities in linked data")
