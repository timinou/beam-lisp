; examples/semantic/shape.bl — one shape declaration, many representations.
;
; ── The idea (from docs/auth-downstream-a-breeze.md) ──────────────────
;
; This repo's design thesis for data shapes is "declare the shape ONCE, as
; data, and derive every representation from it" — the storage schema, the
; struct, the JSON codec all fall out of one declaration rather than being
; written by hand three times and drifting. `defresource`/`defshape` are
; the surface that vision reaches for; the auth doc calls it "one need, one
; implementation."
;
; Structured LLM output is exactly that pattern applied to a model call.
; When we ask Gemini to extract entities, we want it to return DATA in a
; known shape, not prose we regex. Gemini supports this: hand it a JSON
; Schema and it returns JSON that validates. So the beam-lispy move is:
; declare the shape once, in the shared type-token vocabulary, and DERIVE
; the JSON Schema the API wants from it — never hand-write the schema.
;
; ── The shape grammar ─────────────────────────────────────────────────
;
; A shape is data, built from the same type tokens the contract system uses
; (`:string :integer :boolean :keyword :number`), composed with:
;
;   {:field shape …}        an OBJECT (a map from field name to field shape)
;   [:list shape]           an ARRAY of that shape
;   [:enum "a" "b" …]       a string constrained to those values
;   [:string]  etc.         a scalar (the bare token also works)
;
; So the entity-extraction shape is literally:
;
;   [:list {:name :string :kind [:enum "person" "place" "object"]}]
;
; and `->json-schema` turns that into the `{"type":"ARRAY", …}` Gemini
; wants. One definition; the schema, and (below) a validator, derive from
; it.

(ns semantic.shape)

;; ── the type tokens ─────────────────────────────────────────────────

(def SCALARS
  ; beam-lisp token -> Gemini JSON-Schema type. Shared vocabulary: these are
  ; the same tokens defcontract/defresource use, not a fourth language.
  {:string "STRING"
   :integer "INTEGER"
   :number "NUMBER"
   :boolean "BOOLEAN"
   :keyword "STRING"})    ; a keyword serialises as a string on the wire

(defn- scalar? [shape] (contains? SCALARS shape))

(defn ->json-schema
  "Derive the Gemini JSON Schema (as a plain map) from a shape.

   The three composite forms are recognised structurally:
     - a map        -> OBJECT with those properties (all required)
     - [:list s]    -> ARRAY of s
     - [:enum …]    -> STRING with an enum constraint
     - a scalar tok -> the mapped scalar type
   Nesting is by recursion, so a list of objects of scalars just works."
  [shape]
  (cond
    (scalar? shape)
      {"type" (get SCALARS shape)}

    (map? shape)
      {"type" "OBJECT"
       "properties" (reduce (fn [m k]
                              (assoc m (name k) (->json-schema (get shape k))))
                            {}
                            (keys shape))
       ; every declared field is required — a shape says what MUST be there.
       ; `to-list` so Jason sees a plain list, not a BeamLisp.Vector.
       "required" (to-list (mapv name (keys shape)))}

    (vector? shape)
      (cond
        (= (first shape) :list)
          {"type" "ARRAY" "items" (->json-schema (get shape 1))}
        (= (first shape) :enum)
          {"type" "STRING" "enum" (to-list (rest shape))}
        ; a single-token vector like [:string] is just that scalar
        (scalar? (first shape))
          (->json-schema (first shape))
        :else
          (throw (ex-info "unknown composite shape" {:shape shape})))

    :else
      (throw (ex-info "unknown shape" {:shape shape}))))

;; ── a light validator (the same shape, checking not describing) ─────

(defn valid?
  "Whether a decoded value conforms to `shape`. The shape is data, so one
   walk checks a value the same way another derived the schema — the two
   never disagree because they read the same declaration."
  [shape value]
  (cond
    (= shape :string) (erlang/is_binary value)
    (= shape :keyword) (erlang/is_binary value)
    (= shape :integer) (erlang/is_integer value)
    (= shape :number) (erlang/is_number value)
    (= shape :boolean) (erlang/is_boolean value)

    (map? shape)
      (and (map? value)
           (every? (fn [k] (valid? (get shape k) (get value (name k)))) (keys shape)))

    (vector? shape)
      (cond
        (= (first shape) :list)
          (and (or (list? value) (vector? value))
               (every? (fn [v] (valid? (get shape 1) v)) (to-list value)))
        (= (first shape) :enum)
          (contains? (set (rest shape)) value)
        (scalar? (first shape))
          (valid? (first shape) value)
        :else false)

    :else false))
