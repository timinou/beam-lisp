; examples/semantic/06-dedup.bl — similarity can become graph structure.
; Run: mix beam_lisp.run --path priv --path examples examples/semantic/06-dedup.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; Entity resolution starts with uncertainty. Two records may describe the
; same person without sharing the same spelling or wording, so equality is
; too strict. Embeddings give us likely matches; a score threshold turns
; those suggestions into a decision we can record.
;
; The important move is what happens next: the similarity result is not
; left in a search response. We transact a :record/same-as reference back
; into the database. A fuzzy observation has become ordinary graph
; structure — durable, queryable, and traversable like every other fact.

(ns example.semantic.dedup
  (:require [datom] [datom.vector] [semantic.embed :as embed]))

(defn- show [label v] (println (str "  " label "  " (pr-str v))))
(defn- heading [text] (println (str "\n" text)))

;; ── records from several untidy sources ─────────────────────────────

(def conn
  (datom/connect
    [{:db/ident :record/text :db/valueType :db.type/string}
     {:db/ident :record/embedding :db/valueType :db.type/vector}
     {:db/ident :record/same-as :db/valueType :db.type/ref}]))

;; Three pairs describe the same likely people in different words. The two
;; remaining records are deliberately unrelated controls. Real resolution
;; would also use names, email addresses, or human review; here we isolate
;; the semantic signal so its role is visible.
(def records
  ["Robert Smith, cat lover and software engineer"
   "Bob Smith works in software and has a pet kitten"
   "Alice Jones manages money, savings and investment funds"
   "A. Jones works in finance, banking and investing"
   "Maria Garcia bakes bread and sourdough at home"
   "M. Garcia loves cooking and baking fresh bread"
   "Daniel Lee books flights and hotels for travel"
   "Priya Patel hikes mountain trails in rainy weather"])

(datom/transact! conn
  (into [] (map-indexed
             (fn [i text]
               {:db/id (- (+ i 1))
                :record/text text
                :record/embedding (embed/embed text)})
             records)))

(def db-before (datom/db conn))

;; ── nearest OTHER record ────────────────────────────────────────────

(heading "── each record's nearest other record ──")

(def record-rows
  (into [] (datom/q '[:find ?e ?text :where [?e :record/text ?text]] db-before)))

(defn- nearest-other [eid]
  ;; Searching with the record's own vector returns itself first at ~1.0.
  ;; Ask for two neighbours, then remove self; the remaining row is the
  ;; nearest genuinely different entity.
  (let [q (:record/embedding (datom/entity db-before eid))
        hits (into []
               (datom/q '[:find ?other ?score
                          :in $ ?q
                          :where [(similar-to :record/embedding ?q 2)
                                  [?other ?score]]]
                        db-before q))]
    (get (into [] (filter (fn [hit] (not (= (get hit 0) eid))) hits)) 0)))

(def nearest
  (into []
    (map (fn [row]
           (let [eid (get row 0)
                 text (get row 1)
                 hit (nearest-other eid)
                 other-id (get hit 0)
                 score (get hit 1)
                 other-text (:record/text (datom/entity db-before other-id))]
             [eid text other-id other-text score]))
         record-rows)))

(into []
  (map (fn [match]
         (show (get match 1)
               [(get match 3) (get match 4)]))
       nearest))

;; ── threshold suggestions into asserted facts ──────────────────────

(heading "── candidate duplicates (score > 0.85) ──")

(def candidates
  (into [] (filter (fn [match] (> (get match 4) 0.85)) nearest)))

(into []
  (map (fn [match]
         (show (get match 1)
               ["same as" (get match 3) "score" (get match 4)]))
       candidates))

;; The ids here are the positive, permanent entity ids returned by queries,
;; not tempids. Each directed nearest-neighbour decision becomes a ref fact.
;; Reciprocal matches therefore produce reciprocal edges; that is useful
;; evidence that both records independently chose one another.
(datom/transact! conn
  (into []
    (map (fn [match]
           [:db/add (get match 0) :record/same-as (get match 2)])
         candidates)))

(def db-after (datom/db conn))

;; ── the result is now a graph ───────────────────────────────────────

(heading "── :same-as edges now stored in the graph ──")

(show "duplicate links:"
  (datom/q '[:find ?left ?right
             :where [?a :record/same-as ?b]
                    [?a :record/text ?left]
                    [?b :record/text ?right]]
           db-after))

;; References compose with more patterns. This two-hop query traverses a
;; duplicate cluster without embedding or scoring anything: after the
;; transaction, entity resolution is simply graph data.
(show "two-hop clusters:"
  (datom/q '[:find ?start ?middle ?end
             :where [?a :record/same-as ?b]
                    [?b :record/same-as ?c]
                    [?a :record/text ?start]
                    [?b :record/text ?middle]
                    [?c :record/text ?end]]
           db-after))

;; ── what to take away ───────────────────────────────────────────────

(heading "── what to take away ──")
(println "  Similarity proposes likely identity even when wording differs")
(println "  A threshold turns fuzzy scores into explicit :record/same-as references")
(println "  Similarity output becomes MORE facts in the same durable database")
(println "  Once asserted, duplicate clusters are traversed with ordinary datalog")
(println "\n  Next: build review workflows around uncertain semantic decisions")

:ok
