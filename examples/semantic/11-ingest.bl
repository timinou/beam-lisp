; examples/semantic/11-ingest.bl — a real book becomes searchable facts.
; Run: GOOGLE_API_KEY=... mix beam_lisp.run --path priv --path examples examples/semantic/11-ingest.bl
;
; ── The turn: from here on, the embeddings are REAL ───────────────────
;
; Examples 01–10 used a toy word-hashing embedder so they run offline.
; Examples 11–15 build a full GraphRAG system over an actual book — the
; complete "Adventures of Sherlock Holmes" from Project Gutenberg — using
; REAL embeddings from Google's Gemini model. The only thing that changes
; is the embedder: `gemini/embed-doc` instead of `embed/embed`. Everything
; else — storage, search, clustering — is the code you already saw.
;
; This file is the ETL: read the book, split it into passages, embed each
; (cached to disk, so you pay the API once), and store passage + embedding
; as datoms. After it, the book is a searchable database.
;
; ── What GraphRAG is, in one paragraph ────────────────────────────────
;
; Plain RAG (retrieval-augmented generation) answers a question by
; embedding it, retrieving the few most similar text chunks, and handing
; them to an LLM. It works for LOCAL questions ("what did Holmes deduce
; from the hat?") whose answer sits in one findable chunk. It FAILS for
; GLOBAL questions ("what are the recurring themes across all the
; stories?") whose answer is spread across the whole corpus. GraphRAG
; fixes that by also extracting an entity GRAPH from the text, detecting
; COMMUNITIES in it, and summarising them — so a global question is
; answered from the summaries, not from a handful of chunks. Files 12–15
; build that up. This one lays the foundation: the passages themselves.

(ns example.semantic.ingest
  (:require [datom] [datom.vector]
            [semantic.corpus-util :as corpus] [semantic.gemini :as gemini]))

(defn- show [label v] (println (str "  " label "  " (pr-str v))))
(defn- heading [text] (println (str "\n" text)))

(def CORPUS "examples/semantic/corpus/holmes.txt")
(def N-PASSAGES 80)     ; a slice, so the first run's embedding stays quick

;; ── read + split ────────────────────────────────────────────────────

(heading "── splitting the book into passages ──")

(def passages (into [] (take N-PASSAGES (corpus/load-passages CORPUS 3))))
(show "passages:" (count passages))
(show "first story:" (get (get passages 0) 0))
(show "a sample passage:" (str (subs (get (get passages 0) 1) 0 90) "…"))

;; ── embed (cached) + store ──────────────────────────────────────────

(heading "── embedding each passage with Gemini (cached to disk) ──")

;; A schema: each passage is an entity with its text, its story, and its
;; embedding. `:db.type/vector` marks the searchable column.
(def conn
  (datom/connect
    [{:db/ident :passage/text :db/valueType :db.type/string}
     {:db/ident :passage/story :db/valueType :db.type/string}
     {:db/ident :passage/embedding :db/valueType :db.type/vector}]))

;; Embed and transact. The embedding is cached, so re-running this file is
;; instant and offline after the first pass.
(datom/transact! conn
  (into [] (map-indexed
             (fn [i p]
               {:db/id (- (+ i 1))
                :passage/story (get p 0)
                :passage/text (get p 1)
                :passage/embedding (gemini/embed-doc (get p 1))})
             passages)))

(def db (datom/db conn))
(show "stored passages:" (datom/q '[:find (count ?e) :where [?e :passage/text _]] db))

;; ── the book is now searchable by meaning ───────────────────────────

(heading "── ask the book a question ──")

;; A query about a disguise — the answer is in the text but the words may
;; differ. Real embeddings match on meaning across that gap.
(defn- format-score [s]
  (subs (str s) 0 (min 5 (count (str s)))))

(defn ask [question]
  (let [q (gemini/embed-query question)]
    (into [] (datom/q '[:find ?story ?text ?score
                        :in $ ?q
                        :where [(similar-to :passage/embedding ?q 3) [?e ?score]]
                               [?e :passage/story ?story]
                               [?e :passage/text ?text]]
                      db q))))

(doseq [question ["a woman who outwits Holmes"
                  "a strange business advertisement offering easy money"]]
  (println (str "\n  Q: " question))
  (doseq [hit (reverse (sort-by (fn [h] (get h 2)) (ask question)))]
    (println (str "    [" (format-score (get hit 2)) "] " (get hit 0)))
    (println (str "        " (subs (get hit 1) 0 (min 100 (count (get hit 1)))) "…"))))


;; ── what to take away ───────────────────────────────────────────────

(heading "── what to take away ──")
(println "  A real book is now a database of passages searchable by MEANING")
(println "  The only change from the offline examples is the embedder — one line")
(println "  Embeddings are cached, so ingest is paid once and reruns are offline")
(println "  This is plain RAG's foundation; 12-15 add the GRAPH that RAG lacks")
(println "\n  Next: 12-naive-rag.bl — plain RAG, and the question it cannot answer")
