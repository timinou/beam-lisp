; examples/semantic/02-similar-to.bl — search is a query clause.
; Run: mix beam_lisp.run --path priv --path examples examples/semantic/02-similar-to.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; Datalog asks questions with PATTERNS: `[?e :doc/title ?t]` means "for
; every title datom, bind its entity and value". `similar-to` is one more
; kind of clause in the same language:
;
;   [(similar-to :doc/embedding ?q 5) [?e ?score]]
;
; reads "the 5 entities whose :doc/embedding is nearest to ?q, bound to
; ?e with their similarity ?score". It GENERATES rows the way a pattern
; does — so it composes with everything else datalog can do (next file).
;
; This file shows plain nearest-neighbour search and "more like this".

(ns example.semantic.similar-to
  (:require [datom] [datom.vector] [semantic.embed :as embed]))

(defn- show [label v] (println (str "  " label "  " (pr-str v))))
(defn- heading [text] (println (str "\n" text)))

;; ── a little library of documents ───────────────────────────────────

(def conn
  (datom/connect
    [{:db/ident :doc/title :db/valueType :db.type/string}
     {:db/ident :doc/embedding :db/valueType :db.type/vector}]))

(def documents
  ["A guide to caring for your new kitten"
   "Adopting a rescue puppy: the first week"
   "Understanding compound interest and savings"
   "How to refactor legacy code safely"
   "Baking sourdough bread at home"
   "The best hiking trails for autumn weather"
   "Debugging memory leaks in production software"
   "Choosing a mortgage: fixed vs variable rates"
   "Training your dog to sit and stay"
   "A beginner's guide to investing in index funds"])

;; Each document becomes an entity with a title and an embedding of that
;; title. In a real app you would embed the full text; a title is enough to
;; show the mechanism.
(datom/transact! conn
  (into [] (map-indexed
             (fn [i title]
               {:db/id (- (+ i 1))          ; tempids are negative integers
                :doc/title title
                :doc/embedding (embed/embed title)})
             documents)))

(def db (datom/db conn))

;; ── nearest-neighbour search ────────────────────────────────────────

(heading "── search: 'a small furry pet that meows' ──")

;; The query is text too — embed it, then ask for the nearest documents.
(def q1 (embed/embed "a small furry pet that meows"))

(show "top 3:"
  (datom/q '[:find ?title ?score
             :in $ ?q
             :where [(similar-to :doc/embedding ?q 3) [?e ?score]]
                    [?e :doc/title ?title]]
           db q1))

;; Notice: no document contains the words "furry", "pet" or "meows". The
;; match is by MEANING (the cat/kitten concept), not keywords.

(heading "── search: 'saving and investing money' ──")

(def q2 (embed/embed "saving and investing money"))
(show "top 3:"
  (datom/q '[:find ?title ?score
             :in $ ?q
             :where [(similar-to :doc/embedding ?q 3) [?e ?score]]
                    [?e :doc/title ?title]]
           db q2))

;; ── "more like this" ────────────────────────────────────────────────

(heading "── more like the dog-training article ──")

;; Recommendation is search where the QUERY is an existing item's own
;; embedding. Find the dog article, then find its neighbours.

(def dog-id
  (get (get (into [] (datom/q '[:find ?e
                                :where [?e :doc/title "Training your dog to sit and stay"]]
                              db))
            0)
       0))

(def dog-vec (:doc/embedding (datom/entity db dog-id)))

(show "like the dog article:"
  (datom/q '[:find ?title ?score
             :in $ ?q
             :where [(similar-to :doc/embedding ?q 3) [?e ?score]]
                    [?e :doc/title ?title]]
           db dog-vec))

;; The article itself scores ~1.0 (it is its own nearest neighbour); the
;; puppy article follows, because both are about dogs.

;; ── what to take away ───────────────────────────────────────────────

(heading "── what to take away ──")
(println "  similar-to is a query CLAUSE: [(similar-to :attr ?q k) [?e ?score]]")
(println "  It matches by MEANING, not keywords — no shared words required")
(println "  'More like this' is search whose query is an item's own embedding")
(println "  Because it is a clause, it JOINS with facts — the next file's subject")
(println "\n  Next: 03-hybrid.bl — semantic AND structured, in one query")
