; examples/semantic/12-naive-rag.bl — plain RAG, and the wall it hits.
; Run: GOOGLE_API_KEY=... mix beam_lisp.run --path priv --path examples examples/semantic/12-naive-rag.bl
;
; ── What plain RAG is ─────────────────────────────────────────────────
;
; Retrieval-Augmented Generation, the standard recipe:
;   1. embed the user's question
;   2. retrieve the few passages whose embeddings are nearest
;   3. paste those passages into a prompt and ask an LLM to answer
;
; The retrieved passages are the "context". The LLM answers FROM them
; rather than from memory, so it can cite a specific source and stay
; grounded. This is what example 11's search already does; here we assemble
; the context block that would go to the LLM.
;
; ── Where it works, and where it breaks ───────────────────────────────
;
; Plain RAG is excellent for LOCAL questions — ones whose answer lives in a
; findable passage or two: "How did Holmes know the man had been to
; China?" Retrieve the tattoo passage, done.
;
; It BREAKS on GLOBAL questions — ones whose answer is distributed across
; the whole corpus: "What are the recurring methods Holmes uses to solve
; cases?" No single passage contains that; it is a pattern over dozens.
; Retrieve the top 5 and you get 5 arbitrary scenes, not the synthesis the
; question asked for. The other 400 relevant passages are invisible.
;
; That failure is the entire reason GraphRAG exists (files 13–15). This
; file makes the failure concrete so the fix has something to fix.

(ns example.semantic.naive-rag
  (:require [datom] [datom.vector]
            [semantic.corpus-util :as corpus] [semantic.gemini :as gemini]))

(defn- heading [text] (println (str "\n" text)))

(def CORPUS "examples/semantic/corpus/holmes.txt")
(def N-PASSAGES 80)

;; ── build the passage store (same as ingest) ────────────────────────

(def conn
  (datom/connect
    [{:db/ident :passage/text :db/valueType :db.type/string}
     {:db/ident :passage/story :db/valueType :db.type/string}
     {:db/ident :passage/embedding :db/valueType :db.type/vector}]))

(def passages (into [] (take N-PASSAGES (corpus/load-passages CORPUS 3))))
(datom/transact! conn
  (into [] (map-indexed
             (fn [i p]
               {:db/id (- (+ i 1))
                :passage/story (get p 0)
                :passage/text (get p 1)
                :passage/embedding (gemini/embed-doc (get p 1))})
             passages)))
(def db (datom/db conn))

;; ── retrieval ───────────────────────────────────────────────────────

(defn retrieve
  "The `k` passages nearest to `question`, as `[story text score]`.

   The query is BUILT with `k` inlined as a literal rather than passed via
   `:in`: an analytic clause's numeric arguments are part of the clause
   shape (like the attribute), not query inputs, so `k` is a constant in
   the clause the same way `:passage/embedding` is. A query is just data,
   so building it with `k` spliced in is ordinary."
  [question k]
  (let [q (gemini/embed-query question)
        query [:find '?story '?text '?score
               :in '$ '?q
               :where [(list 'similar-to :passage/embedding '?q k) ['?e '?score]]
                      ['?e :passage/story '?story]
                      ['?e :passage/text '?text]]]
    (into [] (datom/q query db q))))

(defn assemble-context
  "The prompt a plain-RAG system would send: the retrieved passages, then
   the question. We print it rather than call an LLM — the point is the
   CONTEXT, which is what retrieval controls."
  [question k]
  (let [hits (reverse (sort-by (fn [h] (get h 2)) (retrieve question k)))]
    (str "Answer the question using ONLY these passages:\n\n"
         (join "\n\n" (to-list (mapv (fn [h] (str "[" (get h 0) "] " (get h 1))) hits)))
         "\n\nQuestion: " question)))

;; ── a LOCAL question: plain RAG shines ──────────────────────────────

(heading "── LOCAL question (plain RAG handles this) ──")
(println "  Q: Why did the man wear a mask when he visited Holmes?")
(println "\n  Retrieved context (the top passages):")
(doseq [h (reverse (sort-by (fn [x] (get x 2)) (retrieve "Why did the visitor wear a mask to hide his identity?" 3)))]
  (println (str "    [" (get h 0) "] " (subs (get h 1) 0 (min 90 (count (get h 1)))) "…")))
(println "\n  → The answer is IN these passages. An LLM would nail it.")

;; ── a GLOBAL question: plain RAG fails ──────────────────────────────

(heading "── GLOBAL question (plain RAG cannot answer this) ──")
(println "  Q: What are the recurring TYPES of clients who bring Holmes his cases?")
(println "\n  Retrieved context (the top passages):")
(doseq [h (reverse (sort-by (fn [x] (get x 2)) (retrieve "What kinds of people come to Sherlock Holmes for help across the stories?" 5)))]
  (println (str "    [" (get h 0) "] " (subs (get h 1) 0 (min 90 (count (get h 1)))) "…")))
(println "\n  → These are 5 arbitrary scenes. The question asked for a PATTERN")
(println "    across ALL the stories — and no single passage holds it. The")
(println "    other ~75 passages that bear on the answer were never retrieved.")
(println "    Retrieving MORE passages just floods the prompt; it does not")
(println "    synthesise. This is the global-question wall.")

;; ── what to take away ───────────────────────────────────────────────

(heading "── what to take away ──")
(println "  Plain RAG = embed question, retrieve nearest passages, prompt an LLM")
(println "  It excels at LOCAL questions answerable from a few passages")
(println "  It FAILS at GLOBAL questions whose answer spans the whole corpus")
(println "  The fix is a GRAPH + community summaries — the next three files")
(println "\n  Next: 13-entity-graph.bl — turn the prose into a graph of entities")
