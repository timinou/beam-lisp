; examples/semantic/gemini.bl — real embeddings, from Google's Gemini.
;
; ── What this is ──────────────────────────────────────────────────────
;
; Examples 01–10 used a fake offline embedder so they run anywhere with no
; network. Examples 11–15 (GraphRAG over the Sherlock Holmes canon) need
; REAL embeddings — vectors from a model that actually understands English —
; and this namespace is the one line that changes: `embed` here calls
; Google's `gemini-embedding-001` instead of hashing words.
;
; Everything downstream is identical. `(gemini/embed text)` returns a
; `DVec` exactly as `(embed/embed text)` did, so the storage, `similar-to`,
; clustering and community code all work unchanged. That is the payoff of
; making an embedding just a value: the SOURCE of the numbers is swappable.
;
; ── Caching: embed once, then run offline forever ─────────────────────
;
; Every `embed` call would otherwise be a network round trip that costs
; money and time. So each result is CACHED to disk, keyed by a hash of the
; text (and the task type and dimensionality — different tasks give
; different vectors). Embed the whole Holmes corpus once; every run after
; that reads the cache and needs no network at all. Delete the cache dir to
; re-embed.
;
; ── Task types ────────────────────────────────────────────────────────
;
; Gemini embeddings are better when you tell the model what the embedding
; is FOR. A document being stored for retrieval and a query searching for
; it are asymmetric, and the API takes a `taskType` to optimise each:
;   RETRIEVAL_DOCUMENT — text you store and later search over
;   RETRIEVAL_QUERY    — a search query against those documents
; `embed-doc` and `embed-query` set these; `embed` defaults to document.

(ns semantic.gemini
  (:require [datom.vector] [semantic.shape]))

(def MODEL "gemini-embedding-001")
(def DIM 768)                      ; Matryoshka-truncated from 3072; smaller
                                   ; index, still strong. Normalised on our side.
(def CACHE-DIR ".embcache")

;; ── the network call ────────────────────────────────────────────────

(defn- ensure-inets []
  ; httpc is the inets HTTP client, already on this app's code path
  ; (extra_applications). Starting twice is harmless — it returns
  ; {:error, {:already_started, _}}, which we ignore.
  (inets/start)
  (ssl/start))

(defn- api-key []
  (let [k (System/get_env "GOOGLE_API_KEY")]
    (if (or (nil? k) (= k ""))
      (throw (ex-info "GOOGLE_API_KEY is not set — needed for real embeddings"
                      {:hint "export GOOGLE_API_KEY=... (see .env)"}))
      k)))

(defn- call-gemini
  "POST one text to the embedContent endpoint, returning a vector of
   floats. Raises with the API's own message on a non-200."
  [text task]
  (ensure-inets)
  (let [url (erlang/binary_to_list
              (str "https://generativelanguage.googleapis.com/v1beta/models/"
                   MODEL ":embedContent"))
        payload (Jason/encode!
                  {"model" (str "models/" MODEL)
                   "content" {"parts" (to-list [{"text" text}])}
                   "taskType" task
                   "outputDimensionality" DIM}
                  ; the request map is plain; no vectors to convert here.
                  )
        headers (to-list [(erlang/list_to_tuple
                            (to-list [(erlang/binary_to_list "x-goog-api-key")
                                      (erlang/binary_to_list (api-key))]))])
        request (erlang/list_to_tuple
                  (to-list [url headers
                            (erlang/binary_to_list "application/json")
                            payload]))
        result (httpc/request :post request (to-list []) (to-list []))]
    (if (= (erlang/element 1 result) :ok)
      (let [resp (erlang/element 2 result)
            ; httpc's status line is `{HttpVersion, StatusCode, ReasonPhrase}`,
            ; so the code is element 2 (element 1 is "HTTP/1.1").
            status (erlang/element 2 (erlang/element 1 resp))
            body (erlang/list_to_binary (erlang/element 3 resp))]
        (if (= status 200)
          (into [] (get (get (Jason/decode! body) "embedding") "values"))
          (throw (ex-info (str "Gemini embedContent failed (HTTP " status ")")
                          {:status status :body body}))))
      (throw (ex-info "Gemini request transport error"
                      {:error (erlang/element 2 result)})))))

;; ── caching ─────────────────────────────────────────────────────────

(defn- cache-key
  [text task]
  (subs (String/downcase (Base/encode16 (crypto/hash :sha256 (str task "|" DIM "|" text))))
        0 32))

(defn- cache-path
  [text task]
  (str CACHE-DIR "/" (cache-key text task) ".json"))

(defn- read-cache
  "The cached float vector for `text`+`task`, or nil."
  [text task]
  (let [path (cache-path text task)]
    (if (File/exists? path)
      (into [] (Jason/decode! (File/read! path)))
      nil)))

(defn- write-cache
  [text task floats]
  (File/mkdir_p! CACHE-DIR)
  ; `to-list`: Jason encodes a plain Erlang list, not a BeamLisp.Vector.
  (File/write! (cache-path text task) (Jason/encode! (to-list floats))))

;; ── the public surface ──────────────────────────────────────────────

(defn embed-with
  "A `DVec` for `text` under Gemini `task`, cached. The network is touched
   only on a cache miss."
  [text task]
  (let [cached (read-cache text task)]
    (if (some? cached)
      (datom.vector/embedding cached)
      (let [floats (call-gemini text task)]
        (write-cache text task floats)
        (datom.vector/embedding floats)))))

(defn embed-doc
  "Embed a DOCUMENT for storage/retrieval (RETRIEVAL_DOCUMENT)."
  [text]
  (embed-with text "RETRIEVAL_DOCUMENT"))

(defn embed-query
  "Embed a QUERY that searches over documents (RETRIEVAL_QUERY)."
  [text]
  (embed-with text "RETRIEVAL_QUERY"))

(defn embed
  "Default embedding (document task). The drop-in for the fake embedder's
   `embed/embed`."
  [text]
  (embed-doc text))

(defn cached?
  "Whether `text` is already embedded on disk under `task` — useful for a
   progress readout during a bulk ingest."
  [text task]
  (File/exists? (cache-path text task)))

;; ── text generation (for entity extraction & community summaries) ───
;;
;; GraphRAG needs the model to WRITE as well as embed: to read a passage and
;; name the entities in it (example 13), and to summarise a community of
;; entities (example 14). These go to the generateContent endpoint. Same
;; caching discipline — a prompt's completion is cached by its hash, so an
;; extraction pass is paid once.

(def GEN-MODEL "gemini-3.6-flash")
(def GEN-CACHE-DIR ".gencache")

(defn- gen-cache-path
  [prompt]
  (str GEN-CACHE-DIR "/"
       (subs (String/downcase (Base/encode16 (crypto/hash :sha256 (str GEN-MODEL "|" prompt))))
             0 32)
       ".txt"))

(defn- call-generate
  "POST `prompt` to generateContent, returning the model's text reply."
  [prompt]
  (ensure-inets)
  (let [url (erlang/binary_to_list
              (str "https://generativelanguage.googleapis.com/v1beta/models/"
                   GEN-MODEL ":generateContent"))
        payload (Jason/encode!
                  {"contents" (to-list [{"parts" (to-list [{"text" prompt}])}])
                   "generationConfig" {"temperature" 0.2}})
        headers (to-list [(erlang/list_to_tuple
                            (to-list [(erlang/binary_to_list "x-goog-api-key")
                                      (erlang/binary_to_list (api-key))]))])
        request (erlang/list_to_tuple
                  (to-list [url headers
                            (erlang/binary_to_list "application/json")
                            payload]))
        result (httpc/request :post request (to-list []) (to-list []))]
    (if (= (erlang/element 1 result) :ok)
      (let [resp (erlang/element 2 result)
            status (erlang/element 2 (erlang/element 1 resp))
            body (erlang/list_to_binary (erlang/element 3 resp))]
        (if (= status 200)
          (let [parsed (Jason/decode! body)
                candidate (get (into [] (get parsed "candidates")) 0)
                parts (into [] (get (get candidate "content") "parts"))]
            ; a part carries `text` (and possibly a `thoughtSignature` we
            ; ignore); the answer is the first part's text.
            (get (get parts 0) "text"))
          (throw (ex-info (str "Gemini generateContent failed (HTTP " status ")")
                          {:status status :body body}))))
      (throw (ex-info "Gemini generate transport error"
                      {:error (erlang/element 2 result)})))))

(defn generate
  "The model's text reply to `prompt`, cached by prompt hash. Deterministic
   enough (low temperature) that a cached extraction is stable across runs."
  [prompt]
  (let [path (gen-cache-path prompt)]
    (if (File/exists? path)
      (File/read! path)
      (let [reply (call-generate prompt)]
        (File/mkdir_p! GEN-CACHE-DIR)
        (File/write! path reply)
        reply))))

;; ── STRUCTURED generation (schema-constrained JSON) ────────────────
;;
;; The beam-lispy way to get DATA out of the model instead of prose. The
;; caller passes a SHAPE (semantic.shape's data grammar); we derive the JSON
;; Schema from it and hand it to Gemini's `responseSchema`, so the reply is
;; guaranteed-shaped JSON we decode straight to a value — no regex, no
;; "parse the model's markdown". One shape declaration drives both the
;; request (schema) and, if you want it, the validation (semantic.shape's
;; `valid?`). This is "one definition, many representations" applied to an
;; LLM call.

(defn- call-generate-structured
  "POST `prompt` with a `responseSchema` derived from `shape`, returning the
   decoded value (already JSON-parsed)."
  [prompt shape]
  (ensure-inets)
  (let [url (erlang/binary_to_list
              (str "https://generativelanguage.googleapis.com/v1beta/models/"
                   GEN-MODEL ":generateContent"))
        payload (Jason/encode!
                  {"contents" (to-list [{"parts" (to-list [{"text" prompt}])}])
                   "generationConfig"
                   {"temperature" 0.2
                    "responseMimeType" "application/json"
                    ; the schema is DERIVED from the shape, never hand-written
                    "responseSchema" (semantic.shape/->json-schema shape)}})
        headers (to-list [(erlang/list_to_tuple
                            (to-list [(erlang/binary_to_list "x-goog-api-key")
                                      (erlang/binary_to_list (api-key))]))])
        request (erlang/list_to_tuple
                  (to-list [url headers
                            (erlang/binary_to_list "application/json")
                            payload]))
        result (httpc/request :post request (to-list []) (to-list []))]
    (if (= (erlang/element 1 result) :ok)
      (let [resp (erlang/element 2 result)
            status (erlang/element 2 (erlang/element 1 resp))
            body (erlang/list_to_binary (erlang/element 3 resp))]
        (if (= status 200)
          (let [parsed (Jason/decode! body)
                candidate (get (into [] (get parsed "candidates")) 0)
                parts (into [] (get (get candidate "content") "parts"))
                json-text (get (get parts 0) "text")]
            ; the model's reply is itself JSON (responseMimeType), so decode
            ; it once more into the actual value the shape describes.
            (Jason/decode! json-text))
          (throw (ex-info (str "Gemini structured generate failed (HTTP " status ")")
                          {:status status :body body}))))
      (throw (ex-info "Gemini structured transport error"
                      {:error (erlang/element 2 result)})))))

(defn generate-structured
  "Generate a VALUE conforming to `shape` from `prompt`, cached.

   `shape` is a `semantic.shape` declaration (e.g.
   `[:list {:name :string :kind [:enum \"person\" \"place\"]}]`). The JSON
   Schema handed to the model is derived from it, the reply is decoded, and
   — because the shape is data — checked against the SAME declaration before
   it is returned or cached. A reply that fails the shape raises rather than
   poisoning the cache with malformed data."
  [prompt shape]
  (let [; the cache key folds in the shape, so changing the schema
        ; invalidates stale completions.
        key-prompt (str (pr-str shape) "|" prompt)
        path (gen-cache-path key-prompt)]
    (if (File/exists? path)
      (Jason/decode! (File/read! path))
      (let [value (call-generate-structured prompt shape)]
        (if (semantic.shape/valid? shape value)
          (do (File/mkdir_p! GEN-CACHE-DIR)
              (File/write! path (Jason/encode! value))
              value)
          (throw (ex-info "model reply did not conform to shape"
                          {:shape shape :value value})))))))
