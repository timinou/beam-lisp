; examples/semantic/corpus_util.bl — turn a book into passages.
;
; ── Why passages, not the whole book ──────────────────────────────────
;
; Retrieval works on CHUNKS. Embedding a whole novel into one vector loses
; everything — the vector would mean "a Sherlock Holmes book" and match any
; query about Holmes equally. The unit of retrieval has to be small enough
; that its embedding means one SPECIFIC thing (a scene, an exchange, a
; clue) yet large enough to carry context. A paragraph or a few sentences
; is the usual sweet spot.
;
; This splitter reads the Gutenberg text, strips the license boilerplate,
; finds the twelve story headings, and cuts each story into passages of a
; few paragraphs each — tagging every passage with the story it came from,
; so a retrieved passage can say where it belongs.

(ns semantic.corpus-util)

(def STORY-TITLES
  ["A SCANDAL IN BOHEMIA"
   "THE RED-HEADED LEAGUE"
   "A CASE OF IDENTITY"
   "THE BOSCOMBE VALLEY MYSTERY"
   "THE FIVE ORANGE PIPS"
   "THE MAN WITH THE TWISTED LIP"
   "THE ADVENTURE OF THE BLUE CARBUNCLE"
   "THE ADVENTURE OF THE SPECKLED BAND"
   "THE ADVENTURE OF THE ENGINEER’S THUMB"
   "THE ADVENTURE OF THE NOBLE BACHELOR"
   "THE ADVENTURE OF THE BERYL CORONET"
   "THE ADVENTURE OF THE COPPER BEECHES"])

(defn- contains-sub?
  "Whether `s` contains `sub` (byte match)."
  [s sub]
  (not (= :nomatch (binary/match s sub))))

(defn- trim
  [s]
  (String/trim s))

(defn- blank-line? [line] (= "" (trim line)))

(defn story-of
  "The story title a line names, or nil. A heading line is short and
   contains one of the known titles in caps."
  [line]
  (let [t (trim line)]
    (reduce (fn [acc title]
              (if (some? acc)
                acc
                (if (and (contains-sub? t title) (< (count t) (+ (count title) 8)))
                  title
                  nil)))
            nil
            STORY-TITLES)))

(defn split-passages
  "Split `text` into `[story passage]` pairs.

   Paragraphs (blank-line separated) are grouped `per` at a time into a
   passage, so each passage is a few paragraphs of one story. Story
   membership is tracked by the most recent heading seen. Passages before
   the first story heading (the Gutenberg front matter) are dropped."
  [text per]
  (let [lines (binary/split text "\n" (to-list [:global]))
        ; fold lines into paragraphs, tracking the current story
        state (reduce
                (fn [acc line]
                  (let [para (get acc 0)       ; current paragraph lines
                        paras (get acc 1)      ; [story paragraph] collected
                        story (get acc 2)      ; current story
                        heading (story-of line)]
                    (cond
                      ; a heading switches story and flushes any pending para
                      (some? heading)
                        [[] (if (empty? para)
                              paras
                              (conj paras [story (String/trim (join " " (to-list para)))]))
                         heading]
                      ; a blank line ends a paragraph
                      (blank-line? line)
                        (if (empty? para)
                          [para paras story]
                          [[] (conj paras [story (String/trim (join " " (to-list para)))]) story])
                      ; otherwise accumulate the line
                      :else [(conj para (String/trim line)) paras story])))
                [[] [] nil]
                lines)
        paras (get state 1)
        ; keep only paragraphs that belong to a story and have real content
        real (filterv (fn [p] (and (some? (get p 0)) (> (count (get p 1)) 120))) paras)]
    ; group `per` paragraphs of the SAME story into one passage
    (let [grouped (reduce
                    (fn [acc p]
                      (let [cur (get acc 0)
                            out (get acc 1)
                            story (get p 0)
                            text (get p 1)]
                        (cond
                          (nil? cur) [[story [text]] out]
                          (and (= (get cur 0) story) (< (count (get cur 1)) per))
                            [[story (conj (get cur 1) text)] out]
                          :else [[story [text]]
                                 (conj out [(get cur 0) (join " " (to-list (get cur 1)))])])))
                    [nil []]
                    real)
          cur (get grouped 0)
          out (get grouped 1)]
      (if (nil? cur)
        out
        (conj out [(get cur 0) (join " " (to-list (get cur 1)))])))))

(defn load-passages
  "Read the corpus file at `path` and split it into `[story passage]`
   pairs, `per` paragraphs each."
  [path per]
  (split-passages (File/read! path) per))
