; examples/semantic/09-community.bl — finding groups from links, not meaning.
; Run: mix beam_lisp.run --path priv --path examples examples/semantic/09-community.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; Clustering asks which CONTENT is alike. Community detection asks which
; entities are densely CONNECTED. A cat article and a dog article may share
; a pets cluster while belonging to different citation circles; conversely,
; friends can discuss unrelated topics and still form one community.
;
; Connected components answer the coarse reachability question: "can any
; path get from A to B?" Community detection answers a finer question:
; "where are the dense circles inside that reachable graph?" One bridge can
; merge two circles into one component while label propagation keeps them
; as separate communities.
;
; This is datalog's home turf. Connected components and community detection
; are canonical recursive-datalog workloads in systems such as SociaLite and
; BigDatalog. Label propagation repeatedly adopts the neighbours' majority
; label until a fixpoint — recursion supplies the iteration.

(ns example.semantic.community
  (:require [datom] [datom.vector] [semantic.embed :as embed]))

(defn- show [label v] (println (str "  " label "  " (pr-str v))))
(defn- heading [text] (println (str "\n" text)))

;; ── people, their interests, and their actual friendships ──────────

(def conn
  (datom/connect
    [{:db/ident :person/name :db/valueType :db.type/string}
     {:db/ident :person/topic :db/valueType :db.type/string}
     {:db/ident :person/embedding :db/valueType :db.type/vector}
     {:db/ident :person/age :db/valueType :db.type/long}
     {:db/ident :person/friend :db/valueType :db.type/ref
      :db/cardinality :db.cardinality/many}]))

;; Circle A and circle B are dense internally, with ONE bridge (Dara → Eli).
;; Thus all eight people are reachable and form one component, but the weak
;; bridge should not erase the two friendship communities. Circle C is a
;; separate pair. Topics deliberately cross circles: the graph must ignore
;; semantic similarity, while clustering must ignore the friend links.
(def people
  [{:db/id -1  :person/name "Ada"  :person/topic "kitten purr whisker"
    :person/age 28 :person/friend [-2 -3 -4]}
   {:db/id -2  :person/name "Ben"  :person/topic "mortgage savings fund"
    :person/age 32 :person/friend [-1 -3 -4]}
   {:db/id -3  :person/name "Cleo" :person/topic "software bug debug"
    :person/age 36 :person/friend [-1 -2 -4]}
   {:db/id -4  :person/name "Dara" :person/topic "puppy bark fetch"
    :person/age 40 :person/friend [-1 -2 -3 -5]}

   {:db/id -5  :person/name "Eli"  :person/topic "cat feline paw"
    :person/age 48 :person/friend [-6 -7 -8 -4]}
   {:db/id -6  :person/name "Faye" :person/topic "bank budget loan"
    :person/age 52 :person/friend [-5 -7 -8]}
   {:db/id -7  :person/name "Gus"  :person/topic "compile program refactor"
    :person/age 56 :person/friend [-5 -6 -8]}
   {:db/id -8  :person/name "Hana" :person/topic "dog canine leash"
    :person/age 60 :person/friend [-5 -6 -7]}

   {:db/id -9  :person/name "Iris" :person/topic "rain storm cloud"
    :person/age 25 :person/friend [-10]}
   {:db/id -10 :person/name "Jules" :person/topic "hiking trail autumn"
    :person/age 35 :person/friend [-9]}])

(datom/transact! conn
  (into []
    (map (fn [person]
           (assoc person :person/embedding
                         (embed/embed (get person :person/topic))))
         people)))

(def db (datom/db conn))

(defn- print-groups [rows noun]
  (let [groups (group-by (fn [row] (get row 0)) rows)]
    (doseq [id (sort (keys groups))]
      (println (str "\n  " noun " " id ":"))
      (doseq [row (get groups id)]
        (println (str "    - " (get row 1)))))))

;; ── coarse: connected components ────────────────────────────────────

(heading "── connected components: who can reach whom ──")

(def component-rows
  (into []
    (datom/q '[:find ?component ?name
               :where [(components :person/friend) [?e ?component]]
                      [?e :person/name ?name]]
             db)))
(print-groups component-rows "component")

;; The bridge puts circles A and B in the SAME component. Iris and Jules
;; remain separate because no friendship path reaches the first eight.

;; ── fine: label-propagation communities ─────────────────────────────

(heading "── communities: dense friend circles inside the graph ──")

(def community-rows
  (into []
    (datom/q '[:find ?community ?name
               :where [(community :person/friend) [?e ?community]]
                      [?e :person/name ?name]]
             db)))
(print-groups community-rows "community")

;; Community ids are opaque labels, not rankings. What matters is equality:
;; people with the same id settled on the same label at the fixpoint.

;; ── content and connection are independent lenses ──────────────────

(heading "── content clusters: pets, money, code, and outdoors ──")

(def cluster-rows
  (into []
    (datom/q '[:find ?cluster ?name
               :where [(cluster :person/embedding {:k 4}) [?e ?cluster]]
                      [?e :person/name ?name]]
             db)))
(print-groups cluster-rows "content cluster")

;; Ada and Eli discuss cats, Ben and Faye discuss finance, and Cleo and Gus
;; discuss code — content pairs cross the friendship-circle boundary. This is
;; the pets-vs-friend-circles distinction: embeddings see meaning; graph
;; analytics see links.

;; ── discovered ids join and aggregate like ordinary facts ──────────

(heading "── average age per discovered community ──")

;; ?community is generated by the analytic clause, then joins to :person/age.
;; The query engine can aggregate it exactly like a stored category — no
;; export, second system, or application-side join.
(show "community + average age:"
  (datom/q '[:find ?community (avg ?age)
             :where [(community :person/friend) [?e ?community]]
                    [?e :person/age ?age]]
           db))

;; ── what to take away ───────────────────────────────────────────────

(heading "── what to take away ──")
(println "  Components group by reachability; communities reveal dense circles")
(println "  One bridge can join components without collapsing friend communities")
(println "  Clustering groups by CONTENT; community detection groups by CONNECTION")
(println "  Discovered community ids join with facts and aggregate like any variable")
(println "\n  Next: 10-time-travel-search.bl — semantic search over earlier snapshots")
