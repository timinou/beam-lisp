; examples/semantic/05-recommend.bl — recommendations are semantic joins with live business facts.
; Run: mix beam_lisp.run --path priv --path examples examples/semantic/05-recommend.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; "More like this" starts with meaning: use a product's own embedding to
; find nearby products. A useful shop recommendation must also obey facts
; that change constantly — is it in stock, and is it within the shopper's
; budget?
;
; Because the embedding, price, and inventory status are datoms in the
; same database, `similar-to` joins directly with those business rules.
; The result comes from ONE query over ONE consistent catalog snapshot.
;
; A bolt-on vector database instead returns similar ids. The application
; must fetch and filter those ids elsewhere, hoping its stock and price
; data are still fresh. Here there is no gap between semantic retrieval
; and the facts that decide whether a product can be recommended.

(ns example.semantic.recommend
  (:require [datom] [datom.vector] [semantic.embed :as embed]))

(defn- show [label v] (println (str "  " label "  " (pr-str v))))
(defn- heading [text] (println (str "\n" text)))

;; ── a catalog with meaning and business facts ──────────────────────

(def conn
  (datom/connect
    [{:db/ident :product/name :db/valueType :db.type/string}
     {:db/ident :product/embedding :db/valueType :db.type/vector}
     {:db/ident :product/price :db/valueType :db.type/long}
     {:db/ident :product/stock :db/valueType :db.type/boolean}
     {:db/ident :product/category :db/valueType :db.type/keyword}]))

;; Prices are integer cents, so 4999 means $49.99. The text deliberately
;; carries the product's meaning; production catalogs would usually embed
;; a richer name-plus-description assembled from their existing fields.
(def products
  [["Furry cat and kitten bed"                         3999 true  :pet]
   ["Soft cat scratching post for a happy pet"        2899 true  :pet]
   ["Dog and puppy walking harness"                    4599 false :pet]
   ["Sourdough bread baking stone"                     4299 true  :kitchen]
   ["Kitchen bread baking starter kit"                 5499 true  :kitchen]
   ["Cook and bake recipe scale"                       3499 false :kitchen]
   ["Beginner guitar music stand"                      2499 true  :music]
   ["Acoustic guitar song practice kit"                6999 true  :music]
   ["Rainproof hiking trail backpack"                  4799 true  :outdoor]
   ["Travel flight and hotel carry-on bag"             8999 true  :travel]])

(datom/transact! conn
  (into [] (map-indexed
             (fn [i product]
               {:db/id (- (+ i 1))
                :product/name (get product 0)
                :product/embedding (embed/embed (get product 0))
                :product/price (get product 1)
                :product/stock (get product 2)
                :product/category (get product 3)})
             products)))

(def db (datom/db conn))

;; ── more like this ──────────────────────────────────────────────────

(heading "── more like the sourdough baking stone ──")

;; Recommendation can begin with an item already in the catalog. Read its
;; stored embedding, then use that vector as the query — no second model
;; call and no separate recommendation index.
(def seed-id
  (get (get (into [] (datom/q '[:find ?e
                                :where [?e :product/name "Sourdough bread baking stone"]]
                              db))
            0)
       0))

(def seed-embedding (:product/embedding (datom/entity db seed-id)))

(show "top 3 (the seed itself scores 1.0):"
  (datom/q '[:find ?name ?score
             :in $ ?q
             :where [(similar-to :product/embedding ?q 3) [?e ?score]]
                    [?e :product/name ?name]]
           db seed-embedding))

;; The item itself is expected at 1.0. In a UI it is omitted, leaving the
;; nearby bread and baking products as the visible "more like this" rows.

;; ── the hybrid recommendation ──────────────────────────────────────

(heading "── similar AND in stock AND under $50 ──")

;; Read this as one recommendation policy:
;;   1. retrieve products semantically near the baking stone
;;   2. require inventory to say they are in stock
;;   3. require their integer-cent price to be below the 5000-cent budget
;; Price and stock are evaluated in the SAME snapshot as similarity.
(show "recommendations:"
  (datom/q '[:find ?name ?p ?category ?score
             :in $ ?q
             :where [(similar-to :product/embedding ?q 10) [?e ?score]]
                    [?e :product/stock true]
                    [?e :product/price ?p]
                    [(< ?p 5000)]
                    [?e :product/category ?category]
                    [?e :product/name ?name]]
           db seed-embedding))

;; The $54.99 bread kit is semantically relevant but over budget; the
;; $34.99 kitchen scale is under budget but out of stock. Both disappear
;; inside the query, rather than after a stale cross-system id lookup.

;; ── what to take away ───────────────────────────────────────────────

(heading "── what to take away ──")
(println "  'More like this' searches with an existing product's own embedding")
(println "  Semantic similarity AND stock AND price is ONE datalog query")
(println "  Integer-cent prices and inventory facts share the vector's snapshot")
(println "  No bolt-on vector DB, stale id handoff, or post-filter race is needed")
(println "\n  Next: 06-dedup.bl — use similarity to catch near-duplicates")
