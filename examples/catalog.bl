; examples/catalog.bl — the runnable entrypoint for the code explorer.
;
; Run:  bl serve examples/catalog.bl
;       BL_CATALOG_DIR=some/dir bl serve examples/catalog.bl
;       (BL_CATALOG_DIR defaults to examples/loom)
; Open: http://127.0.0.1:4050
;
; The engine is priv/lib/tooling/catalog.bl: it indexes a directory of source,
; builds the fact database, answers every query, and renders the live view. This
; file requires it and calls `main`.

(ns tooling.catalog-app
  (:require [tooling.catalog :as catalog]))

(catalog/main)
