; Native JavaScript written in BL. Run on the JavaScript target:
;   bin/bl js build examples.js-interop -p . --out /tmp/bl-js-interop
;   node /tmp/bl-js-interop/ns/examples.js-interop.mjs
(ns ^:js examples.js-interop)

(defn- clock []
  (.now js/performance))

(defn encode [data]
  (.stringify js/JSON (bl->js data)))

(defn decode [text]
  (js->bl (.parse js/JSON text) :keywordize-keys true))

(defn add-values [a b]
  (+ a b))

(let [values #js [3 1 2]
      compare (fn [a b] (- a b))]
  (.sort values compare)
  (println (.stringify js/JSON values)))

(println (:note (decode (encode {:note 69}))))
(println (.-size (js/Map.)))
