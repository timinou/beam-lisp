; examples/executor/demo.bl — a live capped-shell SSH executor you can ssh into.
;
;   Run:   bin/bl run examples/executor/demo.bl
;   Then:  copy the printed `ssh …` command and run it in another terminal
;
; It sets up a throwaway SSH keypair, enrolls two demo users in the datom
; `executor.store`, mints them Biscuit exec-tokens with DIFFERENT capabilities,
; and starts the pure-beam-lisp SSH executor (priv/std/executor/ssh.bl). You then
; ssh in and get a capped `bl>` REPL — caps enforced at compile time, memory and
; disk bounded per the policy.
;
;   alice → String only   : (String/upcase "hi") works; (File/read …) is denied.
;   bob   → String + Enum  : can also (Enum/map …); still no File / System.
;
; Nothing here touches your real ~/.ssh — everything lives under a UNIQUE temp
; root, so concurrent runs never collide and no run ever deletes another's keys.

(ns executor.demo
  (:require [executor.ssh :as ex]
            [executor.store :as st]
            [auth]))

;; ── a shell-out that CHECKS its exit code ────────────────────────────
;;
;; `System/cmd` returns `{output, exit-status}`. A non-zero status is raised
;; HERE, so a missing `ssh-keygen`, a bad flag, or a refused write is a loud
;; failure at the command that caused it — never a confusing "no such file"
;; three lines downstream.
(defn- sh!
  [prog argv]
  (let [r (System/cmd prog (to-list argv))
        out (elem r 0)
        status (elem r 1)]
    (if (= 0 status)
      (String/trim out)
      (throw (ex-info (str prog " exited " status ": " (String/trim out))
                      {:prog prog :argv argv :exit status})))))

;; ── a throwaway root, unique per run ─────────────────────────────────
;;
;; The old demo hard-coded /tmp/bl-exec-demo and `rm -rf`'d it on startup, so a
;; second run deleted the first run's keys out from under a live daemon. A unique
;; root removes the collision: no run touches another's state.
(def demo
  (str (System/tmp_dir!) "/bl-exec-demo-"
       (erlang/list_to_binary (os/getpid)) "-"
       (System/system_time :millisecond)))
(File/mkdir_p! demo)

;; Host key for the daemon.
(def host (Path/join demo "host"))
(File/mkdir_p! host)
(sh! "ssh-keygen"
     ["-t" "rsa" "-b" "2048"
      "-f" (Path/join host "ssh_host_rsa_key") "-N" "" "-q"])

;; A client keypair per user (throwaway). The `.pub` line is what gets enrolled.
(defn- gen-user
  [user]
  (let [dir (Path/join demo user)]
    (File/mkdir_p! dir)
    (sh! "ssh-keygen"
         ["-t" "ed25519" "-f" (Path/join dir "id") "-N" "" "-q"
          "-C" (str user "@demo")])
    {:dir dir :line (String/trim (File/read! (Path/join dir "id.pub")))}))

(def alice (gen-user "alice"))
(def bob (gen-user "bob"))

;; Build the store + tokens + daemon, all in beam-lisp. alice gets String only,
;; bob gets String + Enum. Policy: small memory ceiling, no disk.
(def root (auth/keypair))
(def conn (st/open))

(st/enroll! conn "alice" (:line alice)
            (auth/encode-base64
              (auth/issue root [["user" "alice"]
                                ["right" "Elixir.String" "call"]])))
(st/enroll! conn "bob" (:line bob)
            (auth/encode-base64
              (auth/issue root [["user" "bob"]
                                ["right" "Elixir.String" "call"]
                                ["right" "Elixir.Enum" "call"]])))

(def d
  (ex/serve {:port 0
             :system-dir host
             :store conn
             :root-pub (auth/public root)
             :policy {:mem-per-session 5000000 :mem-per-user 20000000
                      :disk-per-session 0 :disk-per-user 0}}))

;; A daemon that did not start must say so and stop — never print a port that
;; is not listening.
(if (not= :ok (elem d 0))
  (do (println (str "executor failed to start: " (pr-str (elem d 1))))
      (System/halt 1)))

(def port (ex/port (elem d 1)))

(defn- ssh-cmd
  [user dir]
  (str "ssh -p " port " -i " (Path/join dir "id") " -o IdentitiesOnly=yes "
       "-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "
       "-o PasswordAuthentication=no " user "@127.0.0.1"))

(println (str
  "\n"
  "┌──────────────────────────────────────────────────────────────────────────┐\n"
  "│  capped beam-lisp SSH executor is LIVE on port " port "\n"
  "└──────────────────────────────────────────────────────────────────────────┘\n"
  "\n"
  "Open another terminal and ssh in. Two users, different capabilities:\n"
  "\n"
  "  alice — String only:\n"
  "    " (ssh-cmd "alice" (:dir alice)) "\n"
  "\n"
  "  bob — String + Enum:\n"
  "    " (ssh-cmd "bob" (:dir bob)) "\n"
  "\n"
  "At the bl> prompt, try:\n"
  "    (String/upcase \"hello\")                 ; alice OK   bob OK\n"
  "    (Enum/count [1 2 3])                     ; alice DENIED   bob OK\n"
  "    (File/read \"/etc/passwd\")               ; both DENIED (compile-time)\n"
  "    (count (range 1 100))                    ; both OK (core fns)\n"
  "    :quit                                    ; leave\n"
  "\n"
  "Everything the token did not grant is UNSPEAKABLE — a compile error, not a\n"
  "runtime check. Memory is bounded per session; a runaway allocation kills only\n"
  "that eval, never the daemon.\n"
  "\n"
  "Press Ctrl-C to stop the daemon.\n"))

;; Keep the VM alive so the daemon serves. Ctrl-C stops it.
(Process/sleep :infinity)
