; hotswap.bl — replacing code in a process that never stops running.
; Run: mix beam_lisp.run examples/hotswap.bl
;
; This is the capability no other Lisp host offers. A JVM Clojure can
; redefine a var; it cannot preempt, supervise and hot-load the way the
; BEAM does as a matter of course. Here a process loops on a function
; while that function is redefined underneath it — no restart, no
; message, no cooperation from the loop.
;
; What this DOES promise: the next call after a redefinition runs the
; new code.
; What it does NOT promise: that a process already *inside* the old
; function jumps to the new one (it finishes the old body first), or
; that in-flight state migrates. Only the code moves; the data a
; process is holding is its own.

(ns hotswap.demo)

(defn version [] "v1")

(def seen (atom []))

; A worker that keeps asking for the current answer and records it.
; Bounded, so the example always terminates.
(def worker
  (erlang/spawn
    (fn []
      (doall
        (map (fn [_]
               (do (swap! seen conj (version))
                   (Process/sleep 20)))
             (range 40))))))

(println "== a process is running, calling (version) in a loop ==")
(Process/sleep 120)
(println (str "so far: " (pr-str (set @seen))))

(println "")
(println "== redefine (version) while it runs ==")

(defn version [] "v2-HOTSWAPPED")

(Process/sleep 200)
(println (str "now:    " (pr-str (set @seen))))

(println "")
(println (str "the worker was never restarted: " (pr-str (erlang/is_process_alive worker))))
(println "it simply started seeing the new definition.")

(erlang/exit worker :kill)
