; examples/rewrite.bl — a mechanical codemod, applied to a quoted form.
;
; This is not a model guessing at a fix: every transformation below is a
; {pattern, replacement} rule, so the before/after is exactly the sum of
; the rules you can read. A reviewer can check each rewrite by eye. The
; honest contract of the tool — and of this file — is that what you see
; is what the rules say, no more.
;
; The two rules codemod a piece of legacy style: `(= x nil)` reads clearer
; as `(nil? x)`, and `(if p x nil)` is `(when p x)`. Both are collected
; into an ordinary list and run over the whole form at every depth, to a
; fixed point.
(ns rewrite.demo)

; This example and the library it demos share the name `rewrite`, and on
; the require path a project file of the same name shadows the priv
; library — so a bare `(:require [rewrite])` here would load this file
; into itself. The honest way to demo a library whose name collides with
; its demo is to load it explicitly, the same path the threading example
; uses for its vendored macros. Everything else is ordinary beam-lisp.
(let [prev (BeamLisp.Env/current_ns)]
  (BeamLisp.Compiler/eval_string
    (File/read! "priv/rewrite.bl")
    (BeamLisp.Compiler/new_env "rewrite"))
  (BeamLisp.Env/in_ns prev))

(rewrite/defrule nil-eq (= ?x nil) (nil? ?x))
(rewrite/defrule if-nil (if ?p ?x nil) (when ?p ?x))

; Rules are data, so a ruleset is an ordinary collection and rulesets
; compose with the same concat you use on any two lists — there is no
; registry to update, no engine to configure.
(def eq-rules (list nil-eq))
(def control-rules (list if-nil))
(def codemod (concat eq-rules control-rules))

(def legacy-form
  '(if (or (= a nil) (= b nil))
     (if c 42 nil)
     nil))

(println (str "before: " (pr-str legacy-form)))
(println (str "after:  " (pr-str (rewrite/apply-rules codemod legacy-form))))

; => (when (or (nil? a) (nil? b)) (when c 42))
(println "rewrite codemod: OK")
