; desk.bl — the hotel's front page: the desk, the ledger, and the wheel.
;
; Run:  bl serve examples/hotel/desk.bl
; Open: http://127.0.0.1:4048
;
; ── What this is ──────────────────────────────────────────────────────
;
; `hotel.bl` is the hotel — a ledger with an heir, a desk with a beat, and a
; wheel that declares its own work. This is that hotel with a face, read
; through the verbs the file exposes and never through a copy of it:
;
;   hotel/rooms           the desk's rooms, asked of the desk
;   hotel/charges         tonight's charges, off the table the heir holds
;   (proc/schedules)      the declarations and their outcomes, off the store
;   (proc/op! srv id op)  the write path — pause · resume · run-now, BY NAME
;
; `(proc/schedules)` is the same read model `bl daemon status` renders. It is
; read-only BY CONSTRUCTION — the rows are a datom basis, written by the wheel
; at boot and at every mutation — so a page can hold the wheel's state without
; asking a process, and a reader never queues behind the writer.
;
; ── Why the control is a LINK ─────────────────────────────────────────
;
; No websocket, no client state, no JavaScript. A control is an anchor whose
; href carries the whole request — /?server=…&id=…&op=pause — so a click is an
; ordinary GET, the answer is a rendered page, and the same URL drives the
; hotel from curl or the address bar. A reader can read a control's effect off
; its href, and a page that holds nothing between requests cannot drift from
; the store it reads.

(ns hotel.desk
  (:require [proc :as proc]
            [hotel.hotel :as hotel]
            [loom.token :as t]
            [loom.box :as b]
            [loom.ui :as ui]
            [live.hiccup :as h]
            [web]))

;; ── the night the page opens on ────────────────────────────────────────
;;
;; A hotel with every room vacant and nothing on the book is a hard page to
;; read, so the front desk opens the night the way a clerk would — through the
;; hotel's OWN verbs, the same two guests and the same first charges the
;; walkthrough uses. The walkthrough (`bl run examples/hotel/hotel.bl`) is
;; where the MECHANISM is shown; here the mechanism is merely used, so the page
;; lands on a hotel that has a night in it.

(defn- open-the-night! []
  (hotel/start-desk!)
  (call :desk [:check-in "101" "Ada"])
  (call :desk [:check-in "103" "Grace"])
  (hotel/charge! "101" 129)
  (hotel/charge! "101" 45)
  (hotel/charge! "102" 210))

;; ── the query string IS the request ────────────────────────────────────
;;
;; `conn` carries the raw query string (`(:query_string conn)`), so a control's
;; three fields are one split on `&` and `=` — and the values are decoded,
;; because an id may arrive percent-encoded even when ours never are.

(defn- params [qs]
  (reduce
    (fn [m pair]
      (let [kv (String/split pair "=")]
        (if (>= (count kv) 2)
          (assoc m (first kv) (web/url-decode (second kv)))
          m)))
    {}
    (if (or (nil? qs) (= "" qs)) [] (String/split qs "&"))))

(def ^:private ops #{"pause" "resume" "run-now"})

(defn- act!
  "Do what the URL asked, when it asked for anything — a control clicked, or
   the same URL typed. Answers nil for a plain page, else the wheel's own
   answer with WHAT WAS ASKED attached: `proc/op!` answers a value rather than
   raising, because 'no scheduler is running' is a fact about the world and a
   control that cannot be delivered must say so."
  [q]
  (let [srv (get q "server")
        id (get q "id")
        op (get q "op")]
    (if (and (some? srv) (some? id) (contains? ops op))
      (assoc (proc/op! srv id op) :asked (str op " " srv "/" id))
      nil)))

;; ── the page ───────────────────────────────────────────────────────────

(defn- ms-text
  "A duration a reader can size up: sub-second stays in ms."
  [ms]
  (if (>= ms 1000) (str (quot ms 1000) "s") (str ms "ms")))

;; The row's `:in-ms` is measured against the REAL wall clock, because the pane
;; cannot know whose clock a declaration keeps — and the hotel's is a VALUE it
;; moves by hand (`hotel/clock`), so the store would report work due at the
;; hotel's 150ms as 56 years overdue. A page that knows the clock can do the
;; subtraction the pane could not: the wait is due minus the hotel's OWN now,
;; in the frame both numbers were written in.

(defn- due-text [due clock-ms]
  (if (nil? due)
    "no next run"
    (let [d (- due clock-ms)]
      (if (< d 0) "due now" (str "next in " (ms-text d))))))

(defn- state-tone [state]
  (case state :active :success :paused :warning :refused :danger :default))

(defn- op-href [srv id op]
  (str "/?server=" (web/url-encode srv)
       "&id=" (web/url-encode id)
       "&op=" (web/url-encode (name op))))

(defn- op-link
  "A control. `ui/button` merges the caller's opts LAST, so `:as :a` renders an
   anchor wearing the button's skin; `:type nil` drops the button attr an anchor
   has no business carrying."
  [srv id op label variant]
  (ui/button {:as :a :type nil :href (op-href srv id op)
              :variant variant :size :sm}
             label))

(defn- room-card [room st]
  (let [occupied (= :occupied (get st :state))
        guest (get st :guest)]
    (ui/card {:gap :2}
      (b/row {:justify :between :align :center :gap :3}
        (ui/heading 3 (str "room " room))
        (ui/badge {:tone (if occupied :success :default)}
                  (if occupied "occupied" "vacant")))
      (ui/prose {:tone :muted} (if (some? guest) (str "guest: " guest) "no guest")))))

(defn- ledger-row [r]
  (b/row {:justify :between :align :baseline :gap :4}
    (ui/prose {} (str "room " (first r)))
    (ui/prose {:tone :muted} (str (second r)))))

(defn- ledger-total [rows]
  (reduce (fn [acc r] (+ acc (second r))) 0 rows))

(defn- ledger-section []
  (let [rows (hotel/charges)]
    (ui/card {}
      (if (empty? rows)
        (ui/prose {:tone :faint}
          "nothing on the book — `bl run examples/hotel/hotel.bl` walks the night that puts the first charges here")
        (b/col {:gap :3}
          (b/col {:gap :2} (map (fn [r] (ledger-row r)) rows))
          (ui/divider)
          (b/row {:justify :between :align :baseline}
            (ui/prose {:tone :muted} "total")
            (ui/prose {} (str (ledger-total rows)))))))))

(defn- schedule-card [s clock-ms]
  (let [srv (:server s)
        id (:id s)
        state (get s :state :unknown)
        live (get s :live false)]
    (ui/card {}
      (b/row {:justify :between :align :center :gap :3 :wrap true}
        (ui/heading 3 (str srv " / " id))
        (b/row {:gap :2 :align :center}
          (ui/badge {:tone (state-tone state)} (name state))
          (ui/badge {:tone (if live :accent :warning)}
                    (if live "running" "no scheduler"))))
      (b/col {:gap :1}
        (ui/prose {:tone :muted}
          (str "runs " (:runs s) " · fails " (:fails s) " · " (due-text (:due s) clock-ms)))
        (when (some? (:last-error s))
          (ui/prose {:tone :faint} (str "last error: " (:last-error s)))))
      (b/row {:gap :2 :wrap true}
        (when (not= state :paused) (op-link srv id :pause "pause" :subtle))
        (when (= state :paused) (op-link srv id :resume "resume" :subtle))
        (op-link srv id :run-now "run now" :ghost)))))

(defn- wheel-section []
  (let [rows (proc/schedules)
        ;; the hotel's clock is the one its declarations were written against
        clock-ms (get (deref hotel/clock) :ms 0)]
    (if (empty? rows)
      (ui/alert {:tone :warning} "no schedule is declared — the store is empty")
      (b/col {:gap :4}
        (ui/prose {:tone :faint}
          "The hotel's clock is a value that starts at midnight, so nothing is due until the walkthrough moves it — or you click run now.")
        (b/grid {:min-col "320px" :gap :4}
          (map (fn [s] (schedule-card s clock-ms)) rows))))))

(defn- section [title body]
  (b/col {:gap :4}
    (ui/heading 2 title)
    body))

(defn view
  "The page, as a hiccup tree. `result` is the wheel's answer to the query
   string, or nil for a plain page — and the op has ALREADY been applied, so
   every read below is the state the control produced."
  [result]
  (b/col {:gap :7 :pad [:7 :5] :max-w "1100px" :style {:margin "0 auto"}}
    (b/col {:gap :2}
      (ui/heading 1 "the hotel · front desk")
      (ui/prose {:tone :muted}
        "The desk's rooms, the night ledger, and the wheel's schedules — read off the hotel in examples/hotel/hotel.bl, never copied from it."))
    (when (some? result)
      (ui/alert {:tone (if (:ok result) :success :warning)}
        (if (:ok result)
          (str (:asked result) " — done")
          (str (:asked result) " — " (:reason result)))))
    (section "the desk"
      (let [rooms (hotel/rooms)]
        (if (empty? rooms)
          (ui/alert {:tone :warning} "no desk is running — there are no rooms to show")
          (b/grid {:min-col "220px" :gap :4}
            (for [room (sort (keys rooms))]
              (room-card room (get rooms room)))))))
    (section "the night ledger" (ledger-section))
    (section "the wheel" (wheel-section))
    (ui/prose {:tone :faint}
      "pause · resume · run-now go through proc/op! by name. The page holds nothing between requests: reload it and you see whatever the hotel now holds.")))

(defn- page [result]
  (str "<!doctype html><html lang=\"en\"><head>"
       "<meta charset=\"utf-8\">"
       "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
       "<title>the hotel · front desk</title>"
       (h/hiccup->html (:style result))
       "</head><body>"
       (h/hiccup->html (:tree result))
       "</body></html>"))

(defn router
  "One route. A control is the same route with a query string on it, so there is
   nothing here to keep in step with the page."
  [conn]
  (let [q (params (web/query conn))
        result (t/with-sheet (fn [] (view (act! q))))]
    (web/route conn
      [:get "/"] (web/html conn (page result))
      :else (web/text conn 404 "not found"))))

(defn main []
  (open-the-night!)
  (hotel/start-housekeeping!)
  (web/serve {:port 4048 :plug router})
  (println "\n-- the hotel's front desk --")
  (println "  open:  http://127.0.0.1:4048\n"))

(main)
