; sorted.bl — ordered collections: the question a hash map cannot answer.
; Run: mix beam_lisp.run examples/sorted.bl
;
; A hashed collection answers "is x present?" in O(1). An ORDERED one also
; answers "everything between A and B, in order" — and that second question
; is the whole basis of a database index. This example builds up to that:
; the last section is, in miniature, how a datalog index scan works.

(ns sorted.demo)

(println "== construction: order is the contract, not the insertion sequence ==")

(def m (sorted-map :charlie 3 :alpha 1 :bravo 2))
(def s (sorted-set 5 1 4 2 3))

(println (str "sorted-map:   " (pr-str m)))
(println (str "sorted-set:   " (pr-str s)))
(println (str "keys:         " (pr-str (keys m))))

; A plain map iterates in whatever order the BEAM's map implementation
; happens to use. That is not a contract — it changes with map size.
(println (str "plain map:    " (pr-str {:charlie 3 :alpha 1 :bravo 2})))
(println (str "sorted?:      " (sorted? m) " vs plain " (sorted? {:a 1})))

(println "")
(println "== a sorted collection IS its hashed sibling, plus order ==")

; Every operation you already know works unchanged. A type that needed its
; own parallel vocabulary would not be worth having.
(println (str "(get m :bravo):     " (get m :bravo)))
(println (str "(contains? s 3):    " (contains? s 3)))
(println (str "(count m):          " (count m)))
(println (str "(assoc m :delta 4): " (pr-str (assoc m :delta 4))))
(println (str "(conj s 0):         " (pr-str (conj s 0))))
(println (str "(map? m) (set? s):  " (map? m) " " (set? s)))

; …and it composes with core's sequence vocabulary, in order.
(println (str "(map inc s):        " (pr-str (map inc s))))
(println (str "(filter even? s):   " (pr-str (filter even? s))))
(println (str "(reduce + 0 s):     " (reduce + 0 s)))

(println "")
(println "== endpoints are O(log n), not a scan ==")

; `first` on a hashed set is "some element". On an ordered one it is THE
; smallest, and finding it costs a tree descent rather than a traversal.
(println (str "(first s):    " (first s)))
(println (str "(last-key s): " (last-key s)))
(println (str "(first m):    " (pr-str (first m))))
(println (str "empty first:  " (pr-str (first (sorted-set)))))

(println "")
(println "== range scans: the reason these types exist ==")

(def years (into-sorted-set [1969 1972 1984 1991 1995 2007 2015 2024]))

(println (str "all:            " (pr-str (seq years))))
(println (str "1984..2007:     " (pr-str (range-of years 1984 2007))))
(println (str "..1984:         " (pr-str (range-of years nil 1984))))
(println (str "2007..:         " (pr-str (range-of years 2007 nil))))

; The bounds need not exist in the collection — which is what lets a query
; say "between 1980 and 2000" without knowing which years were recorded.
(println (str "1980..2000:     " (pr-str (range-of years 1980 2000))))
(println (str "descending:     " (pr-str (reverse-range-of years 1980 2000))))

; Cost is proportional to the RESULT, not the collection: the scan starts
; at the lower bound instead of filtering from the beginning.
(def big (into-sorted-set (range 0 100000)))
(println (str "3 of 100k:      " (pr-str (range-of big 49999 50001))))

(println "")
(println "== a sorted map ranges as [k v] entries ==")

(def log (into-sorted-map [[1001 :created] [1002 :updated] [1003 :deleted] [1004 :restored]]))

(println (str "entries 1002..1003: " (pr-str (into [] (range-of log 1002 1003)))))
(println (str "just the values:    "
              (pr-str (mapv (fn [e] (get e 1)) (range-of log 1002 1003)))))

(println "")
(println "== why a database wants this: an index, in miniature ==")

; An index is an order-preserving key encoding plus a range scan over it.
; Encode [attribute value entity] so that everything sharing an attribute
; is CONTIGUOUS — then "all people aged 30 to 40" is one bounded scan
; rather than a filter over every fact in the database.
;
; (Real index keys cannot be vectors: Erlang orders tuples by ARITY before
; content, so a short prefix bound does not bracket its partition. That is
; BUG-005, and wave 2 replaces these with a flat byte encoding. Strings
; below stand in for that encoding — they compare the way real keys will.)

(defn index-key
  "An index entry: attribute, then zero-padded value, then entity."
  [attr value entity]
  (str (name attr) "|" (format-num value) "|" entity))

(defn format-num
  "Zero-pad so that STRING order matches NUMERIC order — 9 must not sort
   after 10. This is the essence of order-preserving encoding."
  [n]
  (let [s (str n)]
    (str (apply str (repeat (- 4 (count s)) "0")) s)))

(def people-index
  (into-sorted-set
    [(index-key :age 25 "alice")
     (index-key :age 30 "bob")
     (index-key :age 35 "carol")
     (index-key :age 42 "dave")
     (index-key :name 0 "zara")]))

(println "the index, in key order:")
(doseq [k (seq people-index)] (println (str "  " k)))

(println "")
(println (str "query — ages 30 to 40 (one bounded scan, no filtering):"))
(doseq [k (range-of people-index (index-key :age 30 "") (index-key :age 40 "~"))]
  (println (str "  " k)))

(println "")
(println "That scan touched 2 entries out of 5. On a million facts it would")
(println "still touch 2 — which is the entire difference between an index")
(println "and a full scan, and the reason wave 2 builds EAVT/AEVT/AVET/VAET")
(println "on top of exactly this primitive.")
