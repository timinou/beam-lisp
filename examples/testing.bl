; testing.bl — beam-lisp tests itself: deftest/is/testing/are, then
; run-tests. The suite runs in-language; storage lives in the ETS
; registry behind BeamLisp.TestRT.
; Run: mix beam_lisp.run examples/testing.bl

; The test library ships in priv/ (loaded into core by `mix beam_lisp.test`);
; load it here so this example is self-contained.
(BeamLisp.Compiler/eval_string
  (File/read! (Application/app_dir :beam_lisp "priv/test.bl"))
  (BeamLisp.Compiler/new_env "core"))

(ns testing.example)

(println "== arithmetic ==")
(deftest arithmetic
  (is (= (+ 1 2) 3))
  (is (= (* 6 7) 42))
  (is (< 1 2)))

(println "== collections ==")
(deftest collections
  (testing "map over a vector"
    (is (= (map inc [1 2]) '(2 3))))
  (testing "conj appends to a vector"
    (is (= (conj [1] 2) [1 2]))))

(println "== table-driven (are) ==")
(deftest table-driven
  (are [x y] (= x y)
    1 1
    2 2
    3 3))

(println "== summary ==")
(run-tests)
