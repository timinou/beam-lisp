; 02-diff.bl — minimal patches: what makes this better than string diff.
;
; Run: mix beam_lisp.run --path priv examples/live/02-diff.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; LiveView diffs RENDERED STRINGS. This diffs the hiccup TREE, with real
; keys, so:
;   - a text change deep in a tree is ONE op, addressed by path;
;   - appending a row is ONE :insert, not a re-render of the list;
;   - reordering rows emits :move ops — the DOM nodes are PRESERVED, not
;     rewritten. A string diff cannot express "the same node moved".
;
; The op set is the wire: it serialises straight to JSON.

(ns example.live.diff
  (:require [live.diff :as d]))

(defn- show [label a b]
  (println (str "  " label))
  (println (str "    ops: " (pr-str (d/diff a b)))))

(println "── the diff is minimal, and keyed ──")
(println)

(show "one text change, deep — one op at a path"
      [:div [:header [:h1 "old"]]]
      [:div [:header [:h1 "new"]]])

(show "append a keyed row — one :insert, not a re-render"
      [:ul [:li {:key "a"} "A"]]
      [:ul [:li {:key "a"} "A"] [:li {:key "b"} "B"]])

(show "remove a keyed row — one :remove"
      [:ul [:li {:key "a"} "A"] [:li {:key "b"} "B"]]
      [:ul [:li {:key "b"} "B"]])

(show "reorder three rows — :move ops, DOM nodes preserved"
      [:ul [:li {:key "a"} "A"] [:li {:key "b"} "B"] [:li {:key "c"} "C"]]
      [:ul [:li {:key "c"} "C"] [:li {:key "a"} "A"] [:li {:key "b"} "B"]])

(println)
(println "── the diff round-trips: apply(diff(a,b), a) == b ──")
(let [a [:ul [:li {:key "a"} "A"] [:li {:key "b"} "B"]]
      b [:ul [:li {:key "b"} "B"] [:li {:key "c"} "C"] [:li {:key "a"} "A"]]]
  (println (str "  reconstruct == target? "
                (= (d/normalize b) (d/apply-ops (d/diff a b) a)))))

(println)
(println "  the shape of it: minimal, keyed patches. A reorder moves nodes")
(println "  instead of rewriting them — the property a string diff cannot reach.")
