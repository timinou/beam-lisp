; 11-designed-live-app.bl — the design system, LIVE.
;
; Run: mix beam_lisp.run --path priv examples/live/11-designed-live-app.bl
;
; The SAME components (live.ui) and design tokens (live.style) that build a
; static page (examples/ssg/ux-showcase.bl) here drive a LIVE socket: a click
; fires an intent, the world commits, and every viewer gets a MINIMAL patch —
; a button's variant and label change, or one keyed row appears. World-class
; UX and live interactivity, both expressed as beam-lisp values, sharing one
; design language with zero rewrite.

(ns live-ux (:require [live.ui :as ui] [live.style :as s] [live.hiccup :as h]
                      [live.socket :as sock] [datom]))

;; shared world: tasks with a done flag
(def conn (datom/connect
  [{:db/ident :task/id :db/valueType :db.type/string :db/unique :db.unique/identity}
   {:db/ident :task/title :db/valueType :db.type/string}
   {:db/ident :task/done :db/valueType :db.type/boolean}]))
(datom/transact! conn [{:db/id -1 :task/id "a" :task/title "Write the design system" :task/done false}])

;; a view built from the design vocabulary — DRIVES the live socket
(defn app [db _sess _locals]
  (let [tasks (sort (datom/q '[:find ?id ?title ?done
                               :where [?e :task/id ?id][?e :task/title ?title][?e :task/done ?done]] db))]
    (ui/stack {:gap :4}
      (ui/heading 1 "Live tasks")
      (ui/card {}
        (ui/stack {:gap :3}
          (for [t tasks]
            (ui/row {:key (nth t 0) :style {:justify-content "space-between"}}
              (ui/prose {} (nth t 1))
              (ui/button {:variant (if (nth t 2) :ghost :primary)
                          :on-click [:intent :toggle {:id (nth t 0)}]}
                (if (nth t 2) "done ✓" "mark done"))))))
      (ui/button {:variant :primary :on-click [:intent :add {}]} "Add task"))))

;; intents
(defn toggle-task [c payload _pr]
  (let [id (:id payload)
        cur (first (first (datom/q '[:find ?d :in $ ?id :where [?e :task/id ?id][?e :task/done ?d]] (datom/db c) id)))]
    [{:db/id -1 :task/id id :task/done (not cur)}]))
(defn add-task [c _payload _pr]
  [{:db/id -1 :task/id (str "t" (erlang/unique_integer (list :positive))) :task/title "New task" :task/done false}])

(def me (erlang/self))
(defn- drain [ms] (receive [:mount h] [:mount h] [:patch o] [:patch o] (after ms :none)))

;; mount the live app
(def st (sock/mount {:view app :shared conn :sink me
                     :intents {:toggle toggle-task :add add-task}}))
(println (str "MOUNT has styled button? " (not (nil? (index-of (second (drain 300)) "data-ev-click")))))

;; click "mark done" → intent → commit → minimal patch
(def st2 (sock/handle-event st [:intent :toggle {:id "a"}] {}))
(def st3 (sock/on-commit st2))
(let [[tag ops] (drain 300)]
  (println (str "after toggle: " tag " with " (count ops) " ops"))
  (println (str "  is a minimal patch (not full re-render)? " (< (count ops) 5))))

;; add a task → one keyed insert
(def st4 (sock/handle-event st3 [:intent :add {}] {}))
(def st5 (sock/on-commit st4))
(let [[tag ops] (drain 300)]
  (println (str "after add: " tag ", first op = " (first (first ops)))))
