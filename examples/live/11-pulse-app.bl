; 11-pulse-app.bl — Pulse: a friendly team check-in app, end to end.
;
; Run: mix beam_lisp.run --path priv examples/live/11-pulse-app.bl
;
; ── What this shows ───────────────────────────────────────────────────
;
; ONE small app that exercises the WHOLE stack we built, so you can see how
; the backend and the frontend are the same program:
;
;   • BRAND        a theme installed as a VALUE (loom.token) — Pulse purple
;   • DESIGN       the page is built from the accessible component vocabulary
;                  (loom.ui): cards, headings, fields, buttons, badges
;   • SHARED WORLD durable team check-ins live in a datom database (the facts)
;   • AUTH         each socket carries a principal; an intent is authorized
;                  and stamped with WHO acted — the write cannot lie about it
;   • SESSION      a per-socket in-memory conn holds this person's DRAFT note,
;                  private to their tab, gone when they leave (no cleanup)
;   • INTENT       a click is a FACT REQUEST, not a closure: [:intent :checkin]
;                  → authorized → transacted → committed to the log
;   • LIVE DIFF    the commit lands on the log; every viewer re-projects and
;                  gets a MINIMAL keyed patch (one row inserted), not a redraw
;   • CONVERGENCE  two people, two tabs, one shared world — a check-in by one
;                  appears in the other's tab THROUGH THE LOG, not a message
;
; The frontend (the view) is a pure function of the world; the backend (the
; intents + auth + log) decides what becomes true. They meet at the datom
; database. That is the whole idea.

(ns example.live.pulse
  (:require [loom.ui :as ui] [loom.box :as b] [loom.token :as s] [live.hiccup :as h]
            [live.socket :as sock] [datom]))

;; ════════════════════════════════════════════════════════════════════
;; BRAND — Pulse's look, as a value. Install once; everything repaints.
;; ════════════════════════════════════════════════════════════════════

(def pulse-brand
  {:color {:accent    "#7c5cff"   ; Pulse purple
           :accent-fg "#ffffff"
           :bg        "#0b0a10"
           :surface   "#16141f"
           :surface-2 "#201d2c"
           :border    "#2c2838"
           :text      "#ece9f5"
           :muted     "#9891ad"
           :success   "#46d18f"}
   :radius {:md "10px" :lg "18px" :full "9999px"}})

;; ════════════════════════════════════════════════════════════════════
;; SHARED WORLD — the team's check-ins (durable facts in datom)
;; ════════════════════════════════════════════════════════════════════

(defn open-team []
  (let [conn (datom/connect
               [{:db/ident :checkin/id   :db/valueType :db.type/string :db/unique :db.unique/identity}
                {:db/ident :checkin/who  :db/valueType :db.type/string}
                {:db/ident :checkin/mood :db/valueType :db.type/string}
                {:db/ident :checkin/note :db/valueType :db.type/string}])]
    (datom/transact! conn
      [{:db/id -1 :checkin/id "c000000" :checkin/who "ada"
        :checkin/mood "great" :checkin/note "shipped the keyed differ ✨"}])
    conn))

;; a plain query — the frontend reads facts, it does not reach for state.
;; Newest first: check-in ids are monotonic, so sorting by id DESCENDING puts
;; the latest at the top. A new check-in is then always an insert at position
;; 0 — the differ emits one clean :insert, and every viewer's feed grows the
;; same way.
(defn checkins [db]
  (reverse (sort-by (fn [r] (nth r 0))
    (datom/q '[:find ?id ?who ?mood ?note
               :where [?e :checkin/id ?id] [?e :checkin/who ?who]
                      [?e :checkin/mood ?mood] [?e :checkin/note ?note]] db))))

;; ════════════════════════════════════════════════════════════════════
;; SESSION — a per-socket draft, private to this tab (in-memory datom)
;; ════════════════════════════════════════════════════════════════════

(def draft-schema
  [{:db/ident :draft/note :db/valueType :db.type/string}])

(defn draft-note [sess-db]
  ; the view receives the session DB VALUE (already a snapshot), not the conn
  (if (nil? sess-db) ""
    (let [r (datom/q '[:find ?t :where [_ :draft/note ?t]] sess-db)]
      (if (empty? r) "" (first (first r))))))

;; ════════════════════════════════════════════════════════════════════
;; THE VIEW — a pure function of (shared-db session-db locals) → hiccup
;; ════════════════════════════════════════════════════════════════════
;;
;; mood → a friendly badge tone. Small touches like this are where an app
;; feels cared-for; because a component is a function, it is trivial to add.

(defn- mood-tone [mood]
  (cond (= mood "great") :success
        (= mood "good")  :accent
        :else :default))

(defn checkin-row [c]
  (b/row {:key (nth c 0) :justify :between :align :start}
    (b/col {:gap :1}
      (ui/prose {:style {:font-weight "600"}} (str "@" (nth c 1)))
      (ui/prose {:tone :muted} (nth c 3)))
    (ui/badge {:tone (mood-tone (nth c 2))} (nth c 2))))

(defn view [db sess locals]
  (s/install-theme! pulse-brand)             ; paint in the brand
  (let [me (:me locals)
        feed (checkins db)]
    (b/col {:gap :5 :max-w "560px" :style {:margin "0 auto" :padding (s/space :6)}}

      ;; header
      (b/row {:justify :between}
        (b/col {:gap :1}
          (ui/heading 1 "Pulse")
          (ui/prose {:tone :muted} "how the team is doing, right now"))
        (ui/badge {:tone :accent} (str (count feed) " today")))

      ;; the live feed of check-ins (keyed rows → minimal patches)
      (ui/card {}
        (b/col {:gap :4}
          (for [c feed] (checkin-row c))))

      ;; this person's check-in form — draft is session-private
      (ui/card {}
        (b/col {:gap :4}
          (ui/heading 3 (str "How are you, @" me "?"))
          (ui/field {:name :note :label "A word on your day" :value (draft-note sess)
                     :hint "Only you can see this until you check in."
                     :on-input [:assign :draft [:from :value]]})
          (b/row {:gap :3}
            (ui/button {:variant :primary :on-click [:intent :checkin {:mood "good"}]}
              "Check in")
            (ui/button {:variant :ghost :on-click [:intent :checkin {:mood "great"}]}
              "Feeling great")))))))

;; ════════════════════════════════════════════════════════════════════
;; BACKEND — the intent handlers. WHO acted comes from auth, not the client.
;; ════════════════════════════════════════════════════════════════════
;;
;; The view NAMED the intent (:checkin). The authority to perform it lives
;; here. The principal is the authenticated identity the socket carries — the
;; client cannot forge it, so a check-in is always stamped with the real who.

(defn do-checkin [conn payload principal]
  (let [note (:note payload "checked in")]
    [{:db/id -1
      :checkin/id (str "c" (erlang/unique_integer (list :positive :monotonic)))
      :checkin/who principal
      :checkin/mood (:mood payload)
      :checkin/note note}]))

;; ── a socket per viewer, as a real gen_server ──
(sock/deflive pulse-socket
  :view view
  :session draft-schema
  :intents {:checkin do-checkin}
  :listen {})

;; ════════════════════════════════════════════════════════════════════
;; A HEADLESS WALK-THROUGH of the whole loop (what a browser would drive)
;; ════════════════════════════════════════════════════════════════════

(defn- collector [label sink-to]
  (spawn
    (fn []
      (loop []
        (receive
          [:mount html] (do (erlang/send sink-to [label :mount html]) (recur))
          [:patch ops]  (do (erlang/send sink-to [label :patch ops]) (recur))
          (after 3000 nil))))))

;; Wait for a labelled message of a given kind. A non-matching message is
;; REQUEUED (sent back to self) so a concurrent viewer's message is never
;; dropped — this is what makes the two-tab collection race-free.
(defn- await-from [label kind ms]
  (let [me (erlang/self)]
    (receive
      [l k v] (if (and (= l label) (= k kind))
                v
                (do (erlang/send me [l k v]) (Process/sleep 5) (await-from label kind ms)))
      (after ms :none))))

(let [team (open-team)
      me (erlang/self)
      ;; two viewers: Ada and Bo, each a real socket with their own identity
      ada-sink (collector :ada me)
      bo-sink  (collector :bo me)
      ada (server-start-link pulse-socket
            {:shared team :sink ada-sink :locals {:me "ada"}
             :auth {:fn (fn [_ _ _] {:verdict :allow}) :principal "ada"}})
      bo  (server-start-link pulse-socket
            {:shared team :sink bo-sink :locals {:me "bo"}
             :auth {:fn (fn [_ _ _] {:verdict :allow}) :principal "bo"}})]
  (Process/sleep 60)

  (println "── Pulse: two teammates, one shared world ──")
  (println (str "  Ada's tab mounted, feed has "
                (if (index-of (await-from :ada :mount 500) "shipped the keyed differ") "the seed check-in" "?")))
  (println (str "  Bo's tab mounted too."))
  (println)

  ;; Bo checks in. It is a FACT: authorized (principal=bo), committed to the log.
  (println "── Bo clicks \"Feeling great\" ──")
  (server-call bo [:event [:intent :checkin {:mood "great" :note "design system clicks now"}]])
  (Process/sleep 100)

  ;; BOTH tabs re-render from the commit — through the log, not a message.
  ;; Each receives a MINIMAL keyed patch: the one new row, inserted. Neither
  ;; tab was sent the other's message; they re-projected from the new basis.
  (let [describe (fn [p] (if (= p :none) "(no patch)" (pr-str (map first p))))
        ada-patch (await-from :ada :patch 800)
        bo-patch  (await-from :bo :patch 800)]
    (println (str "  Ada's tab: " (describe ada-patch)))
    (println (str "  Bo's tab:  " (describe bo-patch)))
    (println "    → :text updated the \"N today\" count; :insert added Bo's row.")
    (println "      Exactly the two things that changed — nothing else redrawn."))
  (println)

  ;; the fact is stamped with the REAL who — Bo could not have forged it
  (println "── the log now holds ──")
  (doseq [c (checkins (datom/db team))]
    (println (str "  @" (nth c 1) " · " (nth c 2) " · " (nth c 3))))

  (server-stop ada)
  (server-stop bo)
  (println)
  (println "  The frontend is a pure function of the world. The backend decides")
  (println "  what becomes true. They meet at the database — and every viewer")
  (println "  converges on the same facts, live, through the log."))
