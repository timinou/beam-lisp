; 01-hiccup.bl — a view is a pure function from data to hiccup.
;
; Run: mix beam_lisp.run --path priv examples/live/01-hiccup.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; The whole view layer rests on one boring, powerful fact: a view is an
; ordinary function that returns ordinary data. No template language, no
; compile step, no DSL. You can call it in a REPL, print its output, test
; it with `=`. This file is that fact, made concrete.
;
; A hiccup tree is:
;   [:tag attrs? child*]   an element   (a leading map is attributes)
;   "text" / a number      a text node  (HTML-escaped on render)
;   a seq in child slot     splices      (so `(for …)` yields siblings)

(ns example.live.hiccup
  (:require [live.hiccup :as h]))

(defn- show [label html]
  (println (str "  " label))
  (println (str "    " html)))

(println "── a view is a function → hiccup → HTML ──")
(println)

;; the tag keyword carries shorthand: :div#id.class.class
(show "shorthand :main#app.board"
      (h/hiccup->html [:main#app.board "hello"]))

;; attributes are a leading map; classes from shorthand and :class merge
(show "attrs + class merge"
      (h/hiccup->html [:div.card {:class "active" :data-role "admin"} "x"]))

;; a seq in child position splices — this is how a list renders
(show "a task list (for splices)"
      (h/hiccup->html
        [:ul (for [t [{:slug "a" :title "First"}
                      {:slug "b" :title "Second"}]]
               [:li.task {:key (:slug t)} (:title t)])]))

;; text is escaped; :on-* becomes a client-binding marker, not an attribute
(show "escaping + event marker"
      (h/hiccup->html
        [:button {:on-click [:intent :go {}]} "Save & <exit>"]))

(println)
(println "  the shape of it: a view is data. No template, no DSL — a function")
(println "  you can call, print, and test with =. Everything else builds on this.")
