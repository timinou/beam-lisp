; 09-undo-redo.bl — undo is a basis pointer. No undo stack.
;
; Run: mix beam_lisp.run --path priv examples/live/09-undo-redo.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; A session conn keeps a durable, ordered log of every edit. So undo/redo is
; not a data structure you maintain — it is a COORDINATE you render at. The
; view is `db → hiccup`; `as-of db basis` is a db value at a past basis; so
; rendering the past is the SAME view function over a different coordinate.
;
;   edit      → transact! the session conn (basis advances)
;   undo      → render the view at the PREVIOUS basis
;   redo      → render at the next basis forward
;
; No command pattern, no snapshot copies, no inverse-op bookkeeping. The log
; already is the history; `as-of` already is the time machine.

(ns example.live.undo
  (:require [live.socket :as s] [live.hiccup :as h] [datom]))

;; a session conn holding a single editable draft
(def sess
  (s/open-session
    [{:db/ident :draft/id :db/valueType :db.type/long :db/unique :db.unique/identity}
     {:db/ident :draft/text :db/valueType :db.type/string}]))

(defn- text-at [db]
  (let [r (datom/q '[:find ?t :where [_ :draft/text ?t]] db)]
    (if (empty? r) "" (first (first r)))))

;; three edits, remembering the basis after each
(datom/transact! sess [{:db/id -1 :draft/id 1 :draft/text "hel"}])
(def b1 (datom/basis-t (datom/db sess)))
(datom/transact! sess [{:db/id -1 :draft/id 1 :draft/text "hello"}])
(def b2 (datom/basis-t (datom/db sess)))
(datom/transact! sess [{:db/id -1 :draft/id 1 :draft/text "hello world"}])
(def b3 (datom/basis-t (datom/db sess)))

;; the view renders the draft at whatever basis :at names (default: now)
(defn editor [_shared db locals]
  (let [db-at (if (:at locals) (datom/as-of db (:at locals)) db)]
    [:div#editor {:data-basis (str (or (:at locals) "now"))}
     [:p (text-at db-at)]]))

(defn- render-at [at]
  (h/hiccup->html (editor nil (datom/db sess) {:at at})))

(println "── undo/redo is a basis pointer over the session conn ──")
(println)
(println (str "  now      (b3): " (text-at (datom/db sess))))
(println (str "  undo →   (b2): " (text-at (datom/as-of (datom/db sess) b2))))
(println (str "  undo →   (b1): " (text-at (datom/as-of (datom/db sess) b1))))
(println (str "  redo →   (b3): " (text-at (datom/as-of (datom/db sess) b3))))
(println)
(println "  the same VIEW renders any of these — undo is just :at ← prev-basis:")
(println (str "    at b2: " (render-at b2)))
(println (str "    at b3: " (render-at b3)))

(println)
(println "  the shape of it: no undo stack, no snapshots, no inverse ops. The")
(println "  session log is the history; as-of is the time machine; the view is")
(println "  one function over a coordinate. Ctrl-Z = (assign :at prev-basis).")
