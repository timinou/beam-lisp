; 05-two-tabs.bl — two viewers converge on one write, through the log.
;
; Run: mix beam_lisp.run --path priv examples/live/05-two-tabs.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; This is the whole thesis in one program. Two independent sockets watch
; the same shared world. One write commits. BOTH sockets re-render — not
; because they talk to each other, but because the commit lands on the
; datom LOG, and each socket re-projects from the coordinate it moved to.
;
;   write → transact! → commit → [:datom/tx] → each socket's on-commit → patch
;
; LiveView's event→assigns→render happens inside ONE process and never
; leaves it. Here the loop closes through a durable, ordered log, so N
; viewers converge on one fact and a dropped patch is replayable.

(ns example.live.two-tabs
  (:require [live.socket :as s] [datom]))

;; the shared world
(def conn
  (datom/connect
    [{:db/ident :task/slug :db/valueType :db.type/string :db/unique :db.unique/identity}
     {:db/ident :task/title :db/valueType :db.type/string}]))

(datom/transact! conn [{:db/id -1 :task/slug "a" :task/title "First"}])

;; the view (shared-db session-db locals) → hiccup
(defn board [db _sess _locals]
  [:ul (for [t (sort (datom/q '[:find ?s ?t
                                :where [?e :task/slug ?s] [?e :task/title ?t]] db))]
         [:li {:key (first t)} (second t)])])

(defn create-task [c payload _principal]
  [{:db/id -1 :task/slug (:slug payload) :task/title (:title payload)}])

;; a socket that re-renders on any commit
(s/deflive tab
  :view board
  :intents {:create create-task}
  :listen {})

;; ── two tabs, each collecting the patches it receives ───────────────

(def me (erlang/self))

(defn- collector [label]
  (spawn
    (fn []
      (loop []
        (receive
          [:mount html] (do (erlang/send me [label :mount html]) (recur))
          [:patch ops]  (do (erlang/send me [label :patch ops]) (recur))
          (after 3000 nil))))))

(def tab-a (collector :A))
(def tab-b (collector :B))

(def sa (server-start-link tab {:shared conn :sink tab-a}))
(def sb (server-start-link tab {:shared conn :sink tab-b}))
(Process/sleep 60)

;; drain the two mount messages
(defn- await-msg [label kind ms]
  (receive [l k v] (if (and (= l label) (= k kind)) v (await-msg label kind ms))
    (after ms :none)))

(println "── two tabs, one shared world ──")
(println (str "  tab A mounted: " (await-msg :A :mount 500)))
(println (str "  tab B mounted: " (await-msg :B :mount 500)))

;; ── ONE write. Fired at neither tab — straight to the shared world. ──
(println)
(println "── one write commits — watch BOTH tabs re-render ──")
(datom/transact! conn [{:db/id -1 :task/slug "b" :task/title "Second"}])
(Process/sleep 100)

(println (str "  tab A patch: " (pr-str (await-msg :A :patch 500))))
(println (str "  tab B patch: " (pr-str (await-msg :B :patch 500))))

(server-stop sa)
(server-stop sb)

(println)
(println "  the shape of it: neither tab was told. The commit landed on the")
(println "  log; each socket re-projected from the new basis. Convergence is")
(println "  a property of the log, not a message between the tabs.")
