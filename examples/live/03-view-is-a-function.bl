; 03-view-is-a-function.bl — the view is pure, so it is testable.
;
; Run: mix beam_lisp.run --path priv examples/live/03-view-is-a-function.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; Because a view is a pure function of a db VALUE (never a connection, never
; a process), you can test it with an in-memory database and plain `=`. No
; socket, no browser, no running server. A whole page is checked in a unit
; test — the property LiveView's template layer makes awkward.

(ns example.live.view-fn
  (:require [live.hiccup :as h] [datom]))

;; a view: (shared-db session-db locals) → hiccup
(defn board [db _sess locals]
  [:main {:data-role (or (:role locals) "guest")}
   [:h1 "Tasks"]
   [:ul (for [t (sort (datom/q '[:find ?s ?t
                                 :where [?e :task/slug ?s] [?e :task/title ?t]] db))]
          [:li {:key (first t)} (second t)])]])

;; build a db VALUE in memory — no process, no file
(def db
  (let [c (datom/connect
            [{:db/ident :task/slug :db/valueType :db.type/string :db/unique :db.unique/identity}
             {:db/ident :task/title :db/valueType :db.type/string}])]
    (datom/transact! c [{:db/id -1 :task/slug "a" :task/title "First"}
                        {:db/id -2 :task/slug "b" :task/title "Second"}])
    (datom/db c)))

(println "── a view is a value you can assert on ──")
(println)

;; the view returns DATA — assert on the tree directly
(def tree (board db nil {:role "admin"}))
(println (str "  tree is a vector? " (vector? tree)))
(println (str "  root tag: " (first tree)))
(println (str "  role attr: " (:data-role (second tree))))

;; or render and check the HTML
(println (str "  renders two rows? "
              (= 2 (- (count (split (h/hiccup->html tree) "<li")) 1))))

;; a different locals value → a different view, same function
(println (str "  guest role: " (:data-role (second (board db nil {})))))

(println)
(println "  the shape of it: no socket, no browser, no server. A view is a")
(println "  function from a database value to data — unit-testable in full.")
