; 07-guarded-live.bl — the view is scoped, and a write is authorized.
;
; Run: mix beam_lisp.run --path priv examples/live/07-guarded-live.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; LiveView has no authorization model — you re-solve it by hand in every
; handle_event. Here authorization IS the same datalog as the view:
;
;   the VIEW   is row-scoped by `auth/guard` — a viewer cannot even RENDER a
;              row they may not see (the store never selects it);
;   the WRITE  is gated: an intent is authorized BEFORE it can transact, and
;              a denied intent NEVER reaches the log.
;
; And the deep symmetry: `auth/guard` injects a CONJUNCTIVE clause, which is
; MONOTONE — the very property that makes an incremental live view sound is
; the property that makes it secure. One idea, two guarantees.

(ns example.live.guarded
  (:require [live.socket :as s] [datom] [auth]))

;; a world of owned documents
(def conn
  (datom/connect
    [{:db/ident :doc/slug :db/valueType :db.type/string :db/unique :db.unique/identity}
     {:db/ident :doc/title :db/valueType :db.type/string}
     {:db/ident :doc/owner :db/valueType :db.type/string}]))
(datom/transact! conn
  [{:db/id -1 :doc/slug "a1" :doc/title "Alice's plan" :doc/owner "alice"}
   {:db/id -2 :doc/slug "b1" :doc/title "Bob's memo"   :doc/owner "bob"}])

;; the view is GUARDED: it lists only the principal's own documents. The app
;; writes one query; auth/guard scopes it per viewer. A forbidden row is
;; ABSENT, never rendered.
(defn my-docs [db _sess locals]
  (let [principal (:principal locals)
        guarded (auth/guard '[:find ?slug ?title
                              :where [?e :doc/slug ?slug] [?e :doc/title ?title]]
                            [(auth/owner-filter '?e :doc/owner principal)])]
    [:ul (for [d (sort (datom/q guarded db))]
           [:li {:key (first d)} (second d)])]))

(def me (erlang/self))
(defn- drain [ms] (receive [:mount h] [:mount h] [:patch o] [:patch o] [:denied w] [:denied w] (after ms :none)))

;; ── two principals, one view, disjoint results ──────────────────────
(println "── one guarded view, two principals — disjoint rows ──")

(def alice (s/mount {:view my-docs :shared conn :sink me :intents {}
                     :locals {:principal "alice"}}))
(println (str "  alice sees: " (second (drain 300))))

(def bob (s/mount {:view my-docs :shared conn :sink me :intents {}
                   :locals {:principal "bob"}}))
(println (str "  bob sees:   " (second (drain 300))))
(println "  alice never sees Bob's memo — the store never selected it for her.")

;; ── a write, gated: deny it, and prove nothing commits ──────────────
(println)
(println "── a denied intent never reaches the log ──")

(defn create-doc [c payload principal]
  [{:db/id -1 :doc/slug (:slug payload) :doc/title (:title payload) :doc/owner principal}])

;; a pluggable authorizer: deny writes for a read-only principal
(def readonly-auth
  {:fn (fn [op _payload _principal]
         (if (= op :create) {:verdict :deny :why :read-only} {:verdict :allow}))
   :principal "alice"})

(def guarded-sock (s/mount {:view my-docs :shared conn :sink me :intents {:create create-doc}
                            :locals {:principal "alice"} :auth readonly-auth}))
(drain 300)  ; mount
(def before (count (datom/q '[:find ?s :where [_ :doc/slug ?s]] (datom/db conn))))
(s/handle-event guarded-sock [:intent :create {:slug "a2" :title "New"}] {})
(println (str "  denial pushed: " (pr-str (drain 300))))
(def after (count (datom/q '[:find ?s :where [_ :doc/slug ?s]] (datom/db conn))))
(println (str "  docs before: " before "  after: " after "  (unchanged — no write)"))

(println)
(println "  the shape of it: the view is scoped and the write is gated, both in")
(println "  the SAME datalog. The guard's monotonicity is also the live diff's")
(println "  soundness gate — one idea securing and accelerating at once.")
