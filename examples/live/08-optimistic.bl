; 08-optimistic.bl — optimistic UI with a REAL rollback source.
;
; Run: mix beam_lisp.run --path priv examples/live/08-optimistic.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; Optimistic UI shows the result of an action before the server confirms it.
; The risk is the rollback: if the action is refused, the guess must be
; undone — and most stacks reconstruct that by hand on the client.
;
; Here the two states are already separated by the design:
;   the OPTIMISTIC value is a socket LOCAL (assigned instantly);
;   the AUTHORITATIVE value is a FACT (committed, then rendered from the log).
; A view prefers the optimistic local if present, else the committed fact.
; On the commit echo, the optimistic local is cleared → authoritative. On a
; DENIAL, the local is cleared WITHOUT a commit → the guess rolls back to the
; last committed fact. The rollback source is the log, not a client guess.

(ns example.live.optimistic
  (:require [live.socket :as s] [datom]))

(def conn
  (datom/connect
    [{:db/ident :task/slug :db/valueType :db.type/string :db/unique :db.unique/identity}
     {:db/ident :task/done :db/valueType :db.type/boolean}]))
(datom/transact! conn [{:db/id -1 :task/slug "a" :task/done false}])

;; the view prefers an optimistic local over the committed fact
(defn task-row [db _sess locals]
  (let [committed (first (first (datom/q '[:find ?d :where [_ :task/slug "a"] [_ :task/done ?d]] db)))
        optimistic (get-in locals [:optimistic "a"])
        shown (if (nil? optimistic) committed optimistic)]
    [:div#task {:data-done (str shown)
                :data-pending (if (nil? optimistic) "no" "yes")}
     (if shown "done" "open")]))

(defn complete [c _payload _principal]
  [{:db/id -1 :task/slug "a" :task/done true}])

(def me (erlang/self))
(defn- drain [ms] (receive [:mount h] [:mount h] [:patch o] [:patch o] [:denied w] [:denied w] (after ms :none)))

(println "── optimistic UI: render now, reconcile from the log ──")
(println)

;; ── the happy path: assign optimistically, then intent commits ──────
(def st (s/mount {:view task-row :shared conn :sink me :intents {:complete complete}}))
(drain 200)  ; mount: open

;; the click fires BOTH: assign the guess, then request the fact
(def st1 (s/handle-event st [[:assign [:optimistic "a"] true]
                             [:intent :complete {}]] {}))
(println (str "  optimistic patch (instant): " (pr-str (drain 200))))
;; the commit lands → clear the optimistic local, render authoritative
(def st2 (s/on-commit (assoc st1 :locals {})))
(println (str "  reconciled from commit:      " (pr-str (drain 200))))

;; ── the rollback path: a denied action clears the guess, no commit ──
(println)
(println "── a denied action rolls the guess back — from the last fact ──")
(def conn2
  (datom/connect
    [{:db/ident :task/slug :db/valueType :db.type/string :db/unique :db.unique/identity}
     {:db/ident :task/done :db/valueType :db.type/boolean}]))
(datom/transact! conn2 [{:db/id -1 :task/slug "a" :task/done false}])

(def deny-auth {:fn (fn [_op _p _pr] {:verdict :deny :why :forbidden}) :principal "x"})
(def sd (s/mount {:view task-row :shared conn2 :sink me :intents {:complete complete} :auth deny-auth}))
(drain 200)  ; mount: open
;; optimistic assign renders "done"…
(def sd1 (s/handle-event sd [:assign [:optimistic "a"] true] {}))
(println (str "  optimistic (guessed done):   " (pr-str (drain 200))))
;; …the intent is DENIED (no commit); clear the guess → back to the fact
(s/handle-event sd1 [:intent :complete {}] {})
(println (str "  denial:                      " (pr-str (drain 200))))
(def sd2 (s/on-commit (assoc sd1 :locals {})))
(println (str "  rolled back to committed:    " (pr-str (drain 200))))
(println (str "  shared world done? "
              (first (first (datom/q '[:find ?d :where [_ :task/done ?d]] (datom/db conn2))))
              " (still false — nothing committed)"))

(println)
(println "  the shape of it: the optimistic value is a local; the authoritative")
(println "  value is a fact. Reconcile clears the local on the commit echo, and")
(println "  a denial rolls back to the last fact — the log is the rollback source.")
