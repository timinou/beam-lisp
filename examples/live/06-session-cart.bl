; 06-session-cart.bl — per-socket state that is a database, not a variable.
;
; Run: mix beam_lisp.run --path priv examples/live/06-session-cart.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; A socket's ephemeral state (a draft, a cart, a wizard step) usually lives
; as scalar assigns. Here it can be a full in-memory datom conn — a SESSION
; world, per viewer — so socket-local state inherits q / pull / as-of /
; watch, exactly like the shared world. And because the ETS table is owned
; by the socket process, it dies with the socket: no cleanup, no leak.
;
; The view reads BOTH worlds: the catalogue from `shared`, the cart from
; `session`. A cart write re-renders THIS socket and touches no one else.

(ns example.live.session-cart
  (:require [live.socket :as s] [datom]))

;; ── shared: a product catalogue everyone sees ───────────────────────
(def shop
  (datom/connect
    [{:db/ident :item/sku :db/valueType :db.type/string :db/unique :db.unique/identity}
     {:db/ident :item/name :db/valueType :db.type/string}]))
(datom/transact! shop [{:db/id -1 :item/sku "book" :item/name "The Book"}
                       {:db/id -2 :item/sku "pen"  :item/name "A Pen"}])

;; ── session: THIS viewer's cart, its own little database ─────────────
(def cart-schema
  [{:db/ident :cart/sku :db/valueType :db.type/string :db/unique :db.unique/identity}])

;; the view over both worlds
(defn shopfront [db sess _locals]
  (let [items (sort (datom/q '[:find ?sku ?name
                               :where [?e :item/sku ?sku] [?e :item/name ?name]] db))
        in-cart (if sess
                  (into #{} (map first (datom/q '[:find ?sku :where [_ :cart/sku ?sku]] sess)))
                  #{})]
    [:ul (for [it items]
           [:li {:key (first it)
                 :data-in-cart (if (contains? in-cart (first it)) "yes" "no")}
            (second it)])]))

(def me (erlang/self))
(def sess (s/open-session cart-schema))
(def st (s/mount {:view shopfront :shared shop :session sess :sink me :intents {}}))

(defn- drain [ms] (receive [:mount h] [:mount h] [:patch o] [:patch o] (after ms :none)))

(println "── a per-socket cart, backed by a session datom conn ──")
(println (str "  mount: " (second (drain 300))))

;; add "book" to THIS socket's cart — a session-world write
(datom/transact! sess [{:db/id -1 :cart/sku "book"}])
(def st2 (s/on-commit st))
(println (str "  after add-to-cart: " (pr-str (second (drain 300)))))

(println)
(println "  the shared catalogue never changed — only this viewer's session.")
(println "  the cart is a DATABASE: it has q, pull, as-of, watch for free, and")
(println "  it dies with the socket process. Ephemeral state, zero teardown.")
