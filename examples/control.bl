; control.bl — cond/case/when/and/or are not compiler features.
; They are beam-lisp macros in the prelude (priv/boot/core.bl),
; expanding to plain `if` at compile time.
; Run: mix beam_lisp.run examples/control.bl

(println "== cond ==")
(defn describe [n]
  (cond
    (< n 0) "negative"
    (= n 0) "zero"
    :else "positive"))
(println (map describe [-1 0 1]))

(println "== case ==")
(defn color [x]
  (case x
    :red "warm"
    :blue "cool"
    "unknown"))
(println (map color [:red :blue :green]))

(println "== when / when-not ==")
(when (= 1 1)
  (println "when body runs")
  (println "multiple forms, one branch"))

(println "== and / or, short-circuiting ==")
(println (and 1 2 3))         ; last truthy value
(println (or nil false :found)) ; first truthy value
(println (or))                ; nil
