; ux-showcase.bl — a designed page, built entirely from values.
;
; Run: mix beam_lisp.run --path priv examples/ssg/ux-showcase.bl
;      then open /tmp/ux_out/index.html in a browser.
;
; Everything here — colour, spacing, type, the components, the accessibility
; — comes from live.style (the design tokens) and live.ui (the accessible
; component vocabulary). There is no CSS file: the stylesheet is GENERATED
; from the styles the page actually used, and collapsed so each rule appears
; once. This is a design SYSTEM expressed as data.

(ns example.ssg.ux-showcase
  (:require [live.ui :as ui] [live.style :as s] [live.hiccup :as h]))

;; ── the page body: composed from the component vocabulary ───────────

(defn board-body [tasks]
  (ui/stack {:gap :5 :style {:max-width "640px" :margin "48px auto" :padding (s/space :6)}}
    (ui/row {:style {:justify-content "space-between"}}
      (ui/heading 1 "Today")
      (ui/badge {:tone :accent} (str (count tasks) " open")))

    (ui/prose {:tone :muted} "A design language expressed as values.")

    (ui/card {}
      (ui/stack {:gap :3}
        (for [t tasks]
          (ui/row {:key (:id t) :style {:justify-content "space-between"}}
            (ui/prose {} (:title t))
            (ui/badge {:tone (if (:done t) :success :default)}
              (if (:done t) "done" "open"))))))

    (ui/card {}
      (ui/stack {}
        (ui/heading 3 "Add a task")
        (ui/field {:name :title :label "Title" :value ""
                   :hint "Keep it short and actionable."})
        (ui/field {:name :when :label "Due" :value "2026-09-01"
                   :error "Pick a date in the future."})
        (ui/row {}
          (ui/button {:variant :primary} "Save")
          (ui/button {:variant :ghost} "Cancel")
          (ui/button {:variant :danger} "Delete"))))))

;; ── render a full page: body first, then collect the styles it used ──

(defn page [tasks]
  (let [{:keys [tree style]} (s/with-sheet (fn [] (board-body tasks)))]
    (str "<!doctype html>"
      (h/hiccup->html
        [:html {:lang "en"}
         [:head
          [:meta {:charset "utf-8"}]
          [:meta {:name "viewport" :content "width=device-width,initial-scale=1"}]
          [:title "Today"]
          style]                       ; the generated stylesheet
         [:body tree]]))))

(def tasks
  [{:id "1" :title "Design the token scale" :done true}
   {:id "2" :title "Ship the component vocabulary" :done false}
   {:id "3" :title "Prove SSG and live share one design" :done false}])

(File/mkdir_p "/tmp/ux_out")
(File/write "/tmp/ux_out/index.html" (page tasks))
(println (str "Wrote /tmp/ux_out/index.html — open it in a browser."))
(println (str "The stylesheet was generated from " (count tasks)
              " tasks' worth of components; every rule appears once."))
