; examples/clojure-compat/decimal.bl — money arithmetic that never drifts.
;
; `123.45M` is an exact decimal, as it is in Clojure. Every core operator
; understands it, integers promote, floats are refused, and anything that can
; round says so in its arguments. Run: `bl run examples/clojure-compat/decimal.bl`.

(ns clojure-compat.decimal
  (:require [decimal :as d]))

;; The classic: three tenths, with floats and with decimals.
(println "float:  " (+ 0.1 0.2))                 ; 0.30000000000000004
(println "decimal:" (+ 0.1M 0.2M))               ; 0.3M

;; The scale is kept, not normalised: cents stay cents.
(println (+ 19.99M 0.01M) (* 3 4.50M) (- 100M 0.05M) (- 2.50M))

;; Two equalities, on purpose.
(println "=  " (= 1.5M 1.50M))                    ; false — different values
(println "== " (== 1.5M 1.50M))                   ; true  — same number
(println "<  " (< 1M 1.5M 2) "compare" (compare 2.50M 2.5M))

;; An integer beside a decimal promotes; a float is refused by name.
(println (+ 1M 2) (* 2.5M 4))
(println (try (+ 1M 0.1) (catch e (:type (ex-data e)))))

;; Rounding is explicit: scale + mode. Banker's rounding is the default.
(println (d/round 2.345M) (d/round 2.355M) (d/round 2.345M 2 :half-up))
(println (d/rescale 7M 2) (d/rescale 1.239M 2 :floor) (d/rescale 1.231M 2 :ceiling))

;; Division: exact when it terminates, refused when it does not, rounded on request.
(println (/ 1M 8M) (d/div 10M 3M 2 :half-even))
(println (try (/ 1M 3M) (catch e (:type (ex-data e)))))

;; Splitting a bill so the parts sum EXACTLY to the whole (largest remainder).
(defn split-evenly
  "Split `amount` into `n` parts at 2 places whose sum is exactly `amount`."
  [amount n]
  (let [base (d/div amount n 2 :down)
        remainder (- amount (* base n))
        cents (d/->long (d/move-point-right remainder 2))]
    (mapv (fn [i] (if (< i cents) (+ base 0.01M) base)) (range n))))

(let [parts (split-evenly 100M 3)]
  (println parts "sum" (reduce + 0M parts)))

;; Display: plain string, never an exponent; ->double only for sorting/plotting.
(println (d/plain-str 1234.5M) (d/->double 0.1M) (d/->long 3.99M) (pr-str (d/strip-zeros 1.500M)))
