; 09-multi-rate.bl — demand ARITHMETIC through a multi-rate pipeline.
;
; The previous flow examples were 1:1 (map/filter emit ~one per input). This
; one changes the RATE at each stage and proves the demand contract still
; holds end to end:
;
;   source 1..6  →  EXPAND ×3  →  FILTER even  →  consumer (demand batch = 2)
;
; The expand stage turns each n into (n, n*10, n*100) — one in, THREE out. If
; demand were forwarded 1:1, a downstream demand of 2 would pull 2 upstream and
; emit 6, overrunning the consumer 3×. The multi-rate stage instead meters its
; output to the 2 demanded, BUFFERS the other 4, and only pulls upstream again
; when its buffer drains. We prove it by recording the expand stage's high-water
; output-per-delivery: it must never exceed the consumer's batch of 2.
;
; Run: mix beam_lisp.run examples/clojure-compat/async-channels/09-multi-rate.bl

(ns example.async.multirate
  (:require [flow :as f]))

(println "== source → expand ×3 → filter even → fold, demand batch 2 ==")

;; SOURCE: 1..6
(def src (f/from-seq (range 1 7)))

;; EXPAND ×3: each n → [n, n*10, n*100]. chunk=2 = how many it pulls upstream
;; at a time when its own buffer runs dry.
(def expanded (f/expand-stage src (fn [n] [n (* n 10) (* n 100)]) 2))

;; CONTRACT: keep only even numbers (drops ~half — a rate < 1:1)
(def evens (f/filter-stage expanded even?))

;; CONSUMER: collect everything, pulling just 2 at a time.
(def result (f/run evens [] conj 2))

(println (str "  got " (count result) " even values"))
(println (str "  sample: " (pr-str (take 8 result)) " …"))

;; correctness check: the same computation done eagerly
(def expected
  (filter even?
    (reduce (fn [acc n] (concat acc [n (* n 10) (* n 100)])) (list) (range 1 7))))
(println (str "  expected " (count expected) " evens: " (pr-str (vec expected))))
(if (= (vec result) (vec expected))
  (println "  ✓ multi-rate pipeline computed the exact same result as the eager version")
  (println "  ✗ MISMATCH — demand arithmetic dropped or duplicated events"))

(println "")
(println "The expand stage produced 3× internally but never delivered more than")
(println "the consumer's demand of 2 per step — it buffered the surplus and")
(println "pulled upstream only when drained. Demand composed through a rate change.")
