; 07-native-flow.bl — the BEAM-native demand-driven tier (priv/flow.bl).
;
; This is NOT core.async and NOT channels. It is the GenStage model: a
; consumer PULLS by signalling demand, and a producer is structurally unable
; to send more than was asked for. Compare the mindset:
;
;   channels (push):  (ch/put! c v)   ; producer decides — may block on a full buffer
;   flow (pull):      demand flows up, events flow down — consumer sets the pace
;
; Run: mix beam_lisp.run examples/clojure-compat/async-channels/07-native-flow.bl

(ns example.async.flow
  (:require [flow :as f]))

(println "== a demand-driven pipeline: source -> map -> filter -> fold ==")

;; SOURCE: the numbers 1..20, emitted only as demanded
(def src (f/from-seq (range 1 21)))

;; STAGE 1: square each event (a producer-consumer; demand propagates up)
(def squared (f/map-stage src (fn [x] (* x x))))

;; STAGE 2: keep only the even squares
(def evens (f/filter-stage squared even?))

;; CONSUMER: fold the survivors, pulling 4 at a time. NOTHING above produced
;; a single event until this line issued demand — the consumer drives it all.
(def total (f/run evens 0 + 4))

(println (str "  sum of even squares in 1..20 = " total))
(println (str "  (check: " (reduce + (filter even? (map (fn [x] (* x x)) (range 1 21)))) ")"))
(println "the consumer set the pace; each stage demanded upstream in turn.")
