; 02-go-blocks.bl — go returns a channel carrying its result.
;
; On the JVM, `go` rewrites its body into a CPS state machine so the
; parking pool can multiplex it. Here `go` is `spawn` and the body runs
; on a real BEAM process — same API, none of the transform.
;
; Run: mix beam_lisp.run examples/clojure-compat/async-channels/02-go-blocks.bl

(ns example.async.go-blocks
  (:require [clojure.core.async :as a]))

(println "== go bodies are processes; their result comes back on a channel ==")

(defn slow-square [n]
  (a/go
    (Process/sleep 20)          ; pretend this is real work
    (* n n)))

;; launch ten "go blocks" — ten processes — at once
(def results (map slow-square (range 1 11)))

;; each go returned a channel; take the one value each will deliver
(def squares (map (fn [ch] (a/<!! ch)) results))

(println (str "  squares 1..10: " (pr-str squares)))
(println (str "  sum:           " (reduce + squares)))
(println "all ten ran concurrently, each on its own process.")
