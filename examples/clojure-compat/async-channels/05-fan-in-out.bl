; 05-fan-in-out.bl — a worker pool: fan-out to N workers, fan-in results.
;
; The payoff example. One job channel, many worker processes taking from
; it (fan-out / load-balancing — whoever is free grabs the next job), and
; one result channel they all write to (fan-in). This is a complete
; concurrency pattern in ~20 lines, and every worker is a real BEAM
; process the scheduler balances across cores.
;
; Run: mix beam_lisp.run examples/clojure-compat/async-channels/05-fan-in-out.bl

(ns example.async.fan
  (:require [clojure.core.async :as a]))

(println "== a worker pool over channels: fan-out jobs, fan-in results ==")

(def jobs    (a/chan 8))
(def results (a/chan 8))

;; a worker: pull jobs until the channel closes, push each result
(defn worker [id]
  (a/thread
    (loop [done 0]
      (let [job (a/<!! jobs)]
        (if (nil? job)
          (println (str "  worker " id " handled " done " jobs"))
          (do (a/>!! results {:worker id :job job :result (* job job)})
              (recur (inc done))))))))

;; start four workers — they self-balance: a free worker takes the next job
(doseq [id (range 1 5)]
  (worker id))

;; feed 12 jobs, then close so the workers wind down
(a/thread
  (doseq [j (range 1 13)]
    (a/>!! jobs j))
  (a/close! jobs))

;; collect all 12 results (order is nondeterministic — the point of a pool)
(loop [n 0 sum 0]
  (if (< n 12)
    (let [r (a/<!! results)]
      (recur (inc n) (+ sum (:result r))))
    (do
      (println (str "  collected 12 results; sum of squares = " sum))
      (println (str "  (expected 1+4+9+…+144 = " (reduce + (map (fn [x] (* x x)) (range 1 13))) ")")))))

(println "one job channel, four workers, one result channel — done.")
