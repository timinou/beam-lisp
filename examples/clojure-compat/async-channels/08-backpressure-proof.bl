; 08-backpressure-proof.bl — PROVE the producer cannot outrun the consumer.
;
; The claim that makes demand-driven flow different from channels: a slow
; consumer structurally throttles a fast producer, with no buffer to fill and
; no events dropped. This example makes it OBSERVABLE — the producer records
; how far ahead it ever got, and we assert it never exceeded the consumer's
; outstanding demand.
;
; Run: mix beam_lisp.run examples/clojure-compat/async-channels/08-backpressure-proof.bl

(ns example.async.backpressure
  (:require [flow :as f]))

(println "== a fast producer, a slow consumer, and a demand of 3 ==")

;; A producer whose generator RECORDS, in a shared atom, the largest number of
;; events it was ever allowed to emit in one go. With demand-driven flow this
;; can never exceed the batch the consumer asked for — that ceiling IS the
;; backpressure. A push producer (channels) would have raced ahead into a
;; buffer; this one cannot.
(def high-water (atom 0))

(def src
  (f/producer
    (fn [n max]
      ;; `max` is exactly the outstanding demand the producer sees. Record it.
      (swap! high-water (fn [h] (max h max)))
      (if (> n 30)
        :halt
        ;; emit up to `max` events — never more, by contract
        [(range n (min (+ n max) 31)) (+ n max)]))
    1))

;; A DELIBERATELY slow consumer: it sleeps on every batch, so the producer has
;; every opportunity to run ahead — and provably can't. Demand = 3.
(def seen
  (f/run src []
    (fn [acc e]
      (Process/sleep 5)          ; simulate slow work
      (conj acc e))
    3))

(println (str "  consumer saw " (count seen) " events: " (pr-str seen)))
(println (str "  producer's high-water demand ceiling = " (deref high-water)))
(println (str "  demand batch was 3 → ceiling should be 3 (never ran ahead)"))
(if (<= (deref high-water) 3)
  (println "  PROVEN: the producer never emitted more than the consumer demanded.")
  (println "  (unexpected: producer outran demand — would indicate a leak)"))
