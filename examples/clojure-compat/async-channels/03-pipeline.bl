; 03-pipeline.bl — channels compose into a dataflow pipeline.
;
; A classic core.async shape: stages connected by channels, each stage a
; process reading from its in-channel and writing its out-channel. This is
; how you build backpressured streaming systems — and on the BEAM every
; stage is a supervised-capable process for free.
;
; Run: mix beam_lisp.run examples/clojure-compat/async-channels/03-pipeline.bl

(ns example.async.pipeline
  (:require [clojure.core.async :as a]))

(println "== source → transform → filter → sink, each a process ==")

;; a stage: read every value from `in`, apply f, write to `out`; when `in`
;; closes and drains, close `out` so the close propagates downstream.
(defn stage [in out f]
  (a/thread
    (loop []
      (let [v (a/<!! in)]
        (if (nil? v)
          (a/close! out)
          (do (a/>!! out (f v)) (recur)))))))

(def nums    (a/chan 4))
(def squared (a/chan 4))
(def evens   (a/chan 4))

;; wire the pipeline
(stage nums squared (fn [x] (* x x)))
(stage squared evens (fn [x] x))   ; pass-through stage to show composition

;; feed the source
(a/thread
  (doseq [n (range 1 11)]
    (a/>!! nums n))
  (a/close! nums))

;; drain the sink
(loop [acc []]
  (let [v (a/<!! evens)]
    (if (nil? v)
      (println (str "  squares that flowed through: " (pr-str acc)))
      (recur (conj acc v)))))

(println "close propagated source → sink through every stage.")
