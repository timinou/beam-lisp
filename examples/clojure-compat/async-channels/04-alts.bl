; 04-alts.bl — alts!! waits on several operations; first ready wins.
;
; The idiom that makes channels more than queues: race a real work channel
; against a timeout. On the BEAM this is a selective receive over the two
; pending requests — the same thing core.async's `alt` does with a shared
; commit flag, here handed to us by the scheduler.
;
; Run: mix beam_lisp.run examples/clojure-compat/async-channels/04-alts.bl

(ns example.async.alts
  (:require [clojure.core.async :as a]))

(println "== race a slow producer against a timeout ==")

(defn try-with-deadline [work-ms deadline-ms label]
  (let [c (a/chan)]
    (a/thread (Process/sleep work-ms) (a/>!! c label))
    (let [[v ch] (a/alts!! [c (a/timeout deadline-ms)])]
      (if (nil? v)
        (println (str "  " label ": deadline hit (" deadline-ms "ms) — gave up"))
        (println (str "  " label ": arrived in time → " (pr-str v)))))))

;; work finishes before the deadline → value wins
(try-with-deadline 20 100 :fast-job)

;; work misses the deadline → timeout wins (yields nil, consumes nothing)
(try-with-deadline 100 20 :slow-job)

(println "alts!! selected whichever branch was ready first.")
