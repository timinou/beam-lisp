; 01-hello-channel.bl — the smallest possible proof.
;
; A channel, a producer process, a consumer. This is line-for-line the
; shape you'd write in Clojure with core.async — (chan), (>!! …), (<!! …),
; (close!) — except the (require …) points at clojure.core.async running
; on the BEAM.
;
; Run: mix beam_lisp.run examples/clojure-compat/async-channels/01-hello-channel.bl

(ns example.async.hello
  (:require [clojure.core.async :as a]))

(println "== a channel is a process; a put rendezvous with a take ==")

(def c (a/chan))

;; producer: a separate process puts three values, then closes
(a/thread
  (a/>!! c :hello)
  (a/>!! c :from)
  (a/>!! c :beam)
  (a/close! c))

;; consumer: take until the channel is closed (a closed+drained take → nil)
(loop []
  (let [v (a/<!! c)]
    (when-not (nil? v)
      (println (str "  got: " (pr-str v)))
      (recur))))

(println "done — the channel closed and the take returned nil.")
