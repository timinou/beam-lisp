; hygiene.bl — syntax-quote auto-gensym keeps macro temporaries
; from capturing, or being captured by, user locals.
;
; A symbol ending in `#` inside a backquote expands to a unique
; generated name (`x#` → `x__42__auto`), stable within that one
; backquote. Hand-written macros can do the same explicitly with
; `(gensym)`. Before this, and/or/case bound fixed temporaries that
; a user local of the same name silently shadowed.
; Run: mix beam_lisp.run examples/hygiene.bl

(println "== prelude macros ignore user locals of the temp names ==")
(println (let [and-tmp 5] (and 1 and-tmp)))      ; 5, not 1
(println (let [or-tmp 7] (or false or-tmp)))     ; 7, not false
(println (let [case-val 100] (case 9 9 case-val :other))) ; 100, not 9

(println "== a macro's own # temporaries stay private ==")
; `tmp#` is one gensym for the whole backquote, so the two references
; agree — and it never collides with a user's `tmp`.
(defmacro swap-args [a b]
  `(let [tmp# ~a]
     (list ~b tmp#)))
(println (swap-args 1 2))                   ; (2 1)
(println (let [tmp 9] (swap-args tmp 4)))   ; (4 9) — user tmp intact

(println "== hand-written macros can use (gensym) ==")
(defmacro once [x]
  (let [g (gensym "v")]
    `(let [~g ~x] ~g)))
(println (once 42))   ; 42
