; app.bl — a multi-file beam-lisp program.
; Requiring [geometry] loads geometry.bl from this file's directory.
; Run: mix beam_lisp.run examples/app.bl

(ns app
  (:require [geometry :as geo]
            [geometry :refer [circumference]]))

(println "== alias call ==")
(println (str "area of r=2: " (geo/area 2)))

(println "== referred var, bare ==")
(println (str "circumference of r=2: " (circumference 2)))

(println "== explicit namespace ==")
(println (str "pi: " geometry/pi))

(println "== core is still there from any ns ==")
(println (map inc [1 2 3]))
