; examples/datom/06-terms-and-disk.bl — any BEAM term, on a real disk.
; Run: mix beam_lisp.run --path priv examples/datom/06-terms-and-disk.bl
;
; ── Two things Datomic cannot do ──────────────────────────────────────
;
; Datomic's value types are a closed set: string, long, float, instant,
; uuid, keyword, ref, bytes. Want to store a nested map? Serialize it to
; a string, and give up querying it. That set exists because Datomic
; runs on the JVM and had to choose a serialization.
;
; This database runs on the BEAM, where a term is ALREADY a universal
; data type with a total order. So the value type is: any BEAM term.
;
; And the storage layer is six methods wide, so "which disk" is a
; parameter rather than an architecture.

(ns example.datom.terms
  (:require [datom] [datom.store-redb] [datom.codec]))

(defn- show [label value] (println (str "  " label "  " (pr-str value))))
(defn- heading [text] (println (str "\n" text)))
; The prelude's `tuple` is variadic — `(tuple :ok 200 "created")` — so a
; tuple is written directly rather than routed through a list and
; `list_to_tuple`, which was only ever a workaround for not reaching for
; the prelude in the first place.
(def T tuple)

;; ── a database on an actual file ────────────────────────────────────

(heading "── the store is a parameter ──")

(def db-path (str "/tmp/example-datom-" (erlang/unique_integer (to-list [:positive])) ".redb"))

(def conn
  (datom/connect-with
    (datom.store-redb/open db-path)
    [{:db/ident :doc/title :db/valueType :db.type/string}
     ; No :db/valueType at all, so this attribute accepts ANY term.
     {:db/ident :doc/payload}
     {:db/ident :doc/version :db/valueType :db.type/long :db/index true}]))

(show "database file:" db-path)
(show "native backend loaded:" (datom.store-redb/available?))

;; The same `connect-with` takes `store-ets/open` for an in-memory
;; database, or `store-map/open`, or anything else implementing the six
;; methods. Nothing above L1 changes.

;; ── every shape a BEAM term can take ────────────────────────────────

(heading "── storing terms Datomic has no type for ──")

(def payloads
  [["a tuple"        (T :ok 200 "created")]
   ["a nested map"   {:server {:host "localhost" :port 8080}
                      :retries [100 200 400]
                      :flags (into #{} [:tls :http2])}]
   ["a deep vector"  [1 [2 [3 [4 [5]]]]]]
   ["a set"          (into #{} [:read :write :admin])]
   ["a bignum"       123456789012345678901234567890]
   ["a float"        3.14159265358979]
   ["an erlang list" (to-list [:a :b :c])]])

(doseq [pair payloads]
  (let [label (get pair 0)
        value (get pair 1)
        report (datom/transact! conn [{:db/id -1 :doc/title label :doc/payload value}])
        id (get (:tempids report) -1)
        back (:doc/payload (datom/entity (datom/db conn) id))]
    (println (str "  " (if (= back value) "✓" "✗") " " label
                  " — round-tripped: " (pr-str back)))))

;; Nothing was serialized to a string on the way in, and nothing was
;; parsed on the way out. The term IS the value.

;; ── and they are queryable, not just storable ───────────────────────

(heading "── found by value ──")

(def db (datom/db conn))

(show "by tuple:"
      (datom/q '[:find ?t :in $ ?v :where [?e :doc/payload ?v] [?e :doc/title ?t]]
               db (T :ok 200 "created")))

;; A set found by an EQUAL set built in a different order — which only
;; works because the codec sorts members before encoding, so two equal
;; sets reach the same key.
(show "by set (built backwards):"
      (datom/q '[:find ?t :in $ ?v :where [?e :doc/payload ?v] [?e :doc/title ?t]]
               db (into #{} [:admin :write :read])))

(show "by nested map:"
      (datom/q '[:find ?t :in $ ?v :where [?e :doc/payload ?v] [?e :doc/title ?t]]
               db {:server {:host "localhost" :port 8080}
                   :retries [100 200 400]
                   :flags (into #{} [:tls :http2])}))

;; ── why that requires more than serialization ───────────────────────

(heading "── an index is an ORDER, not a hash ──")

;; Storing terms is easy: `term_to_binary` round-trips anything.
;; INDEXING them is the work, because an index is an order-preserving
;; encoding plus a range scan — and `term_to_binary` orders by
;; serialized SHAPE rather than by value.
;;
;; So the codec projects the language's own order into bytes:

(defn- byte-order
  [a b]
  (let [x (datom.codec/encode-value a) y (datom.codec/encode-value b)]
    (cond (erlang/< x y) "<" (erlang/> x y) ">" :else "=")))

(defn- compare-row
  [a b]
  (println (str "  " (pad-right (pr-str a) 22) (byte-order a b) "  " (pr-str b)
                "    (language says " (compare a b) ")")))

(defn- pad-right
  [s n]
  (str s (join "" (repeat (max 0 (- n (count s))) " "))))

(compare-row (T 9) (T 1 1))
(compare-row [1] [1 2])
(compare-row {:a 1} {:a 2})
(compare-row 1 3.14)
(compare-row 42 123456789012345678901234567890)

(println "")
(println "  Every one of those matches the language's own `compare`,")
(println "  which is what makes a range scan over such a column mean")
(println "  anything at all. It is checked exhaustively over 1,225 pairs")
(println "  in test/bl/datom/terms_test.bl.")

;; ── the part that only a real disk can show ─────────────────────────

(heading "── it is still there when the process is gone ──")

(datom/transact! conn [{:db/id -1 :doc/title "survivor" :doc/payload {:written :once}
                        :doc/version 1}])

(show "written, and the file is on disk:" db-path)
(println "")
(println "  A separate OS process, a fresh BEAM VM, opening the same path")
(println "  reads this back — the data, the schema, the transaction basis,")
(println "  and the full history. `connect-with` recovers all four from the")
(println "  store rather than assuming an empty one, which is what makes a")
(println "  restart a restart rather than a silent fresh start.")
(println "")
(println "  See test/bl/datom/conformance_test.bl, whose restart tests run")
(println "  against every store implementation — including this one.")

;; ── what the stack actually is ──────────────────────────────────────

(heading "── the whole stack ──")

(println "  priv/datom/*.bl            17 files   the database")
(println "  native/datom_redb/src      1 crate    transactions, durability")
(println "  Elixir modules for datom   0")
(println "")
(println "  `defnative` lets a beam-lisp namespace host a NIF directly, so")
(println "  the storage backend needs no Elixir wrapper. Elixir keeps only")
(println "  what is genuinely substrate — and a NIF is substrate, while the")
(println "  DECLARATION that one exists belongs beside the code using it.")

(heading "── what to take away ──")
(println "  The value type is any BEAM term, not a closed list")
(println "  Composites are INDEXED, not just serialized")
(println "  Equal values encode identically; different ones never collide")
(println "  The store is a parameter: ETS, a sorted map, or redb on disk")
(println "  Restart recovers data, schema, basis and history")
