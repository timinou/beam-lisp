; examples/datom/04-shapes.bl — pull, and reading trees out of a graph.
; Run: mix beam_lisp.run --path priv examples/datom/04-shapes.bl
;
; ── Two different questions ───────────────────────────────────────────
;
; Datalog answers "which entities satisfy these constraints?" and hands
; back tuples of scalars. That is the right shape for a report and the
; wrong shape for an application, which usually wants a TREE: this
; person, their details, and each of their friends' names.
;
; Expressing a tree in datalog alone means one query per level and
; stitching the results together in application code — the N+1 problem,
; and the reason ORMs exist.
;
; `pull` asks the second question directly. The PATTERN describes the
; shape you want, and because a pattern is data, a program can build one,
; store one, or derive one from a UI's field list.

(ns example.datom.shapes (:require [datom]))

(defn- show [label value] (println (str "  " label "  " (pr-str value))))
(defn- heading [text] (println (str "\n" text)))

(def conn
  (datom/connect
    [{:db/ident :person/name :db/valueType :db.type/string}
     {:db/ident :person/age :db/valueType :db.type/long}
     {:db/ident :person/email :db/valueType :db.type/string
      :db/unique :db.unique/identity}
     {:db/ident :person/friend :db/valueType :db.type/ref
      :db/cardinality :db.cardinality/many}
     {:db/ident :person/manager :db/valueType :db.type/ref}]))

(def r
  (datom/transact! conn
    [{:db/id -1 :person/name "Ada" :person/age 36 :person/email "ada@example.com"}
     {:db/id -2 :person/name "Grace" :person/age 45 :person/email "grace@example.com"}
     {:db/id -3 :person/name "Alan" :person/age 41 :person/email "alan@example.com"
      :person/friend [-1 -2] :person/manager -1}
     {:db/id -4 :person/name "Edsger" :person/age 52 :person/manager -3}]))

(def alan (get (:tempids r) -3))
(def ada (get (:tempids r) -1))
(def edsger (get (:tempids r) -4))
(def db (datom/db conn))

;; ── A pattern is a list of what you want ────────────────────────────

(heading "── flat ──")

(show "just the name:" (datom/pull db [:person/name] alan))
(show "name and age: " (datom/pull db [:person/name :person/age] alan))

;; `:db/id` comes back always, so the result round-trips as transaction
;; data: you can read a shape, change it, and transact it back.

(heading "── everything ──")

(show "[*]:" (datom/pull db ['*] alan))

;; `*` takes every attribute the entity has. References come back as ids
;; rather than nested maps, because `*` says nothing about how deep to go
;; — and guessing could walk the entire graph.

;; ── Nesting follows references ──────────────────────────────────────

(heading "── nesting ──")

(show "friends' names:"
      (datom/pull db [:person/name {:person/friend [:person/name]}] alan))

;; One call. In SQL this is a join plus a group-by plus application code
;; to reassemble the rows into a tree; here the pattern IS the tree.

(show "two levels:"
      (datom/pull db [:person/name
                      {:person/friend [:person/name
                                       {:person/friend [:person/name]}]}]
                  alan))

;; ── Backwards ───────────────────────────────────────────────────────

(heading "── reverse references ──")

;; An underscore on the attribute NAME reverses the direction: "who
;; refers to me?" This is what the VAET index exists to make cheap.

(show "who reports to Ada:"
      (datom/pull db [:person/name {:person/_manager [:person/name]}] ada))

;; The data was written one way — Alan has a manager — and read the
;; other. Nothing was denormalized to make that possible.

;; ── Recursion, for hierarchies of unknown depth ────────────────────

(heading "── recursion ──")

;; An org chart, a comment thread, a category tree: the depth is not
;; known when the pattern is written. A fixed pattern cannot express it
;; at all.

(show "the chain above Edsger:"
      (datom/pull db [:person/name {:person/manager '...}] edsger))

;; `...` descends until nothing new is reachable. An integer bounds it:

(show "one level only:"
      (datom/pull db [:person/name {:person/manager 1}] edsger))

;; Cycles terminate rather than looping. A revisited entity comes back as
;; a bare `{:db/id N}` — it is already in the result further up, so
;; expanding it again would recur forever.

(datom/transact! conn [[:db/add ada :person/manager edsger]])

(show "with a cycle (Ada -> Edsger -> Alan -> Ada):"
      (some? (datom/pull (datom/db conn)
                         [:person/name {:person/manager '...}] edsger)))

;; ── Options ─────────────────────────────────────────────────────────

(heading "── default, limit, rename ──")

(show "a default for an absent value:"
      (datom/pull db [:person/name '(default :person/nickname "none")] ada))

;; `default` distinguishes "absent" from "absent, and here is what to
;; assume" — a distinction the caller otherwise has to make everywhere.

(show "bounding an unbounded read:"
      (datom/pull db ['(limit :person/friend 1)] alan))

;; Without `limit`, pulling a popular entity is one unbounded read that
;; nobody asked for.

(show "renaming for the consumer:"
      (datom/pull db ['(:person/name :as :name)] ada))

;; ── Naming an entity without knowing its id ────────────────────────

(heading "── lookup refs ──")

;; `[:attr value]` names an entity by a UNIQUE value. Useful when the id
;; is an implementation detail you would rather not carry around:

(show "by email:" (datom/pull db [:person/name] [:person/email "grace@example.com"]))

;; ── Patterns are data ───────────────────────────────────────────────

(heading "── building a pattern at runtime ──")

;; A UI knows which fields it is displaying. That list IS a pull pattern:

(defn- pattern-for-fields
  [fields]
  (into [:person/name] fields))

(show "compact view:" (datom/pull db (pattern-for-fields [:person/age]) alan))
(show "detail view: "
      (datom/pull db (pattern-for-fields [:person/age :person/email
                                          {:person/friend [:person/name]}])
                  alan))

;; One function, two shapes, no query text. The over-fetching problem
;; that motivates GraphQL is answered by making the shape a parameter.

(heading "── and it works against the past ──")

(show "pulled from an earlier basis:"
      (datom/pull (datom/as-of (datom/db conn) (:tx r))
                  [:person/name {:person/manager [:person/name]}]
                  ada))

;; Ada had no manager at that transaction, so the key is simply absent.

(heading "── what to take away ──")
(println "  Datalog gives tuples; pull gives trees — different questions")
(println "  The pattern IS the shape: nesting, reverse, recursion")
(println "  Recursion handles hierarchies of unknown depth; cycles stop")
(println "  default/limit/:as make a pull fit its consumer")
(println "  A pattern is data, so the shape can be a parameter")
(println "\n  Next: 05-cost.bl — what it costs, and why that decides the backend")
