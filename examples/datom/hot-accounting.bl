; Minimal HERA workload. No application, provider, HTTP or model required.
; Run with the checkout: ./bin/bl run examples/datom/hot-accounting.bl
; HERA_REPRO_VERSIONS=27712 reproduces the observed 55,423-row history.
(ns examples.datom.hot-accounting
  (:require [datom.conn :as conn] [datom.current :as current]
            [datom.tx :as tx] [datom.index :as index] [datom.store :as store]
            [datom.store-ets :as ets-store] [datom.attr-basis :as basis]))

(defrecord CountingStore [inner rows]
  store/Store
  (-get [s k] (store/-get (:inner s) k))
  (-range [s lo hi] (let [r (store/-range (:inner s) lo hi)] (swap! (:rows s) + (count r)) r))
  (-put [s k v] (store/-put (:inner s) k v) s)
  (-delete [s k] (store/-delete (:inner s) k) s)
  (-update [s k f] (let [[_ v] (store/-update (:inner s) k f)] [s v]))
  (-commit [s ops] (store/-commit (:inner s) ops) s))

;; The prior writer algorithm, retained here only to reproduce the cost on
;; exactly the same store. The production replacement is tx/current-values.
(defn- legacy-values [s e a]
  (reduce (fn [vs d]
            (let [v (index/-v d)]
              (if (index/assertion? d)
                (if (contains? (set vs) v) vs (conj vs v))
                (filterv (fn [x] (not (= x v))) vs))))
          [] (sort-by index/-tx (index/scan s :eavt e a))))

(defn- measure [label rows f]
  (reset! rows 0)
  (let [started (erlang/monotonic_time :millisecond)
        before (elem (erlang/process_info (erlang/self) :reductions) 1)
        result (f)]
    {:path label :values result :history-rows @rows
     :ms (- (erlang/monotonic_time :millisecond) started)
     :reductions (- (elem (erlang/process_info (erlang/self) :reductions) 1) before)}))

(let [n (Integer/parse (or (System/get_env "HERA_REPRO_VERSIONS") "2048"))
      versions (elem n 0)
      c (conn/connect [{:db/ident :account/value :db/valueType :db.type/long}])
      rows (atom 0) s (->CountingStore (:store c) rows)
      ds (into [[9000 :account/value 0 100 true]]
           (mapcat (fn [i] [[9000 :account/value (dec i) (+ 100 i) false]
                           [9000 :account/value i (+ 100 i) true]]) (range 1 versions)))
      t (+ 100 versions)
      next [[9000 :account/value (dec versions) t false] [9000 :account/value versions t true]]]
  (try
    (index/write-datoms s @(:schema c) ds)
    (println (pr-str (measure :legacy rows (fn [] (legacy-values s 9000 :account/value)))))
    (println (pr-str (measure :adoption rows (fn [] (current/values s 9000 :account/value)))))
    (index/write-datoms s @(:schema c) next
      (into (current/transaction-ops s next t) (basis/record-ops s #{:account/value} t)))
    (println (pr-str (measure :projected rows (fn [] (tx/current-values s 9000 :account/value [])))))
    (assert (zero? @rows) "projected writes must not replay historical datoms")
    (finally (conn/close! c))))
