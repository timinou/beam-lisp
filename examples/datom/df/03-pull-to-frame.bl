; examples/datom/df/03-pull-to-frame.bl — entities as a table.
; Run: mix beam_lisp.run --path priv examples/datom/df/03-pull-to-frame.bl
;
; ── Two ways to leave the graph ───────────────────────────────────────
;
; `q-df` (examples 01–02) turns a QUERY into a frame — one row per answer
; tuple. `pull->df` turns a set of ENTITIES into a frame — one row per
; entity, one column per attribute you name. Where `pull` returns a list
; of maps (a shape), `pull->df` returns the same data column-oriented, for
; when you already have the entity ids and want a rectangular table.
;
;   pull      entity  → a map/tree      (one entity, nested)
;   pull->df  entities → a DataFrame     (many entities, flat, tabular)
;
; The headline feature: entities with DIFFERENT attribute sets still
; tabulate into ONE rectangular frame — a missing attribute is a null
; cell, not a ragged row. That is what makes a heterogeneous entity set
; safe to hand to a column engine.

(ns example.datom.df.pull (:require [datom]))

(defn- heading [text] (println (str "\n" text)))
(defn- show [label v] (println (str "  " label "  " (pr-str v))))

;; ── A graph where not every entity has every attribute ──────────────

(def conn
  (datom/connect
    [{:db/ident :person/name  :db/valueType :db.type/string}
     {:db/ident :person/age   :db/valueType :db.type/long}
     {:db/ident :person/city  :db/valueType :db.type/string}
     {:db/ident :person/email :db/valueType :db.type/string}]))

(def report
  (datom/transact! conn
    [{:db/id -1 :person/name "Ada"   :person/age 36 :person/city "London" :person/email "ada@x.io"}
     {:db/id -2 :person/name "Grace" :person/age 45 :person/city "London"}          ; no email
     {:db/id -3 :person/name "Alan"  :person/age 41}                                 ; no city, no email
     {:db/id -4 :person/name "Kay"                    :person/city "Paris"}]))       ; no age

;; Grab the real entity ids the transaction assigned to our tempids —
;; ids are the database's to give, not ours to guess.
(def ids (map (fn [t] (get (:tempids report) t)) [-1 -2 -3 -4]))
(def db  (datom/db conn))

(heading "── the entity ids we assigned ──")
(show "ids:" ids)

;; ── pull->df: entities in, table out ────────────────────────────────
;;
;; Name the entities and the attributes; get back a frame with a leading
;; `db/id` column and one column per attribute, IN THE ORDER you asked.

(def people
  (datom/pull->df db ids [:person/name :person/age :person/city :person/email]))

(heading "── the table ──")
(show "columns:" (Explorer.DataFrame/names people))
(show "shape:" (Explorer.DataFrame/shape people))

;; to_rows is the row-oriented view — one map per entity, with nulls for
;; the attributes an entity does not have.
(heading "── rows (nulls where an attribute is absent) ──")
(Enum/each (Explorer.DataFrame/to_rows people)
  (fn [row] (show "•" row)))

;; ── The frame is rectangular despite ragged entities ────────────────
;;
;; Alan has no city and no email; Kay has no age. Every one is a null
;; cell, so the frame is a clean rectangle a column engine can work with —
;; e.g. count how many people we have an email for.

(heading "── analytics over the pulled table ──")

(def email-col (Explorer.DataFrame/pull people "person/email"))
(show "rows total:"      (Explorer.DataFrame/n_rows people))
;; Series/count counts the NON-nil values — how many have an email.
(show "with an email:"   (Explorer.Series/count email-col))
(show "missing email:"   (Explorer.Series/nil_count email-col))

;; A filtered frame: only the people who live in London. mask keeps the
;; rows where a boolean Series is true; equal builds that mask in Rust.
(heading "── just the Londoners ──")
(def londoners
  (Explorer.DataFrame/mask people
    (Explorer.Series/equal (Explorer.DataFrame/pull people "person/city") "London")))
(show "londoners:" (Explorer.DataFrame/to_columns
                     (Explorer.DataFrame/select londoners (list "person/name" "person/city"))))

(heading "── done ──")
(println "  pull->df: a heterogeneous entity set, one rectangular table, nulls and all.")
