; examples/datom/df/01-query-to-frame.bl — a query IS a DataFrame.
; Run: mix beam_lisp.run --path priv examples/datom/df/01-query-to-frame.bl
;
; ── Start from the mismatch ───────────────────────────────────────────
;
; `datom/q` answers a question and returns a SET of tuples. That is the
; right shape for LOGIC — the same answer arriving by two derivations is
; one answer, so a set is exactly right. But it is the wrong shape for
; ARITHMETIC. To sum a column, group by another, take a percentile, you
; want COLUMNS, and a column engine (Polars) to run them fast.
;
; `datom/q-df` is the bridge: the SAME query, the SAME engine, the SAME
; answer — reshaped into an Explorer DataFrame. One column per :find
; element, in :find order. Nothing about the query changes; only the
; container the answer arrives in.
;
;   q     → a set of tuples      (logic)
;   q-df  → an Explorer.DataFrame (arithmetic)

(ns example.datom.df.query (:require [datom]))

(defn- heading [text] (println (str "\n" text)))
(defn- show [label v] (println (str "  " label "  " (pr-str v))))

;; ── A little database ───────────────────────────────────────────────

(def conn
  (datom/connect
    [{:db/ident :person/name :db/valueType :db.type/string}
     {:db/ident :person/age  :db/valueType :db.type/long}
     {:db/ident :person/city :db/valueType :db.type/string}]))

(datom/transact! conn
  [{:db/id -1 :person/name "Ada"   :person/age 36 :person/city "London"}
   {:db/id -2 :person/name "Grace" :person/age 45 :person/city "London"}
   {:db/id -3 :person/name "Alan"  :person/age 41 :person/city "Paris"}
   {:db/id -4 :person/name "Kay"   :person/age 29 :person/city "Paris"}])

(def db (datom/db conn))

;; ── The same question, two shapes ───────────────────────────────────

(heading "── q returns a SET of tuples ──")

(def query '[:find ?name ?age
             :where [?e :person/name ?name]
                    [?e :person/age ?age]])

(show "q:" (datom/q query db))
;; => a set like #{["Ada" 36] ["Grace" 45] …} — unordered, logic-shaped.

(heading "── q-df returns a DataFrame ──")

(def df (datom/q-df query db))

;; The columns are named for the :find variables (the ? dropped) and kept
;; in :find ORDER — name before age, not sorted alphabetically.
(show "names:" (Explorer.DataFrame/names df))
(show "shape:" (Explorer.DataFrame/shape df))    ; {rows cols}

;; to_columns is the plain-data view: column-name → its values.
(show "columns:" (Explorer.DataFrame/to_columns df))

;; A DataFrame's rows are ORDERED (a set's are not), so q-df sorts the
;; answer to a stable order — two runs of the same query give the same
;; frame, which is what makes it comparable and plottable.

;; ── Aggregates come across too ──────────────────────────────────────
;;
;; Datalog has no GROUP BY: the plain variables in :find ARE the grouping
;; key, and an aggregate call like (count ?e) folds each group. q-df
;; names an aggregate column `op_var` — here `count_e`.

(heading "── an aggregate: people per city ──")

(def by-city
  (datom/q-df '[:find ?city (count ?e)
                :where [?e :person/city ?city]]
              db))

(show "names:" (Explorer.DataFrame/names by-city))       ; ("city" "count_e")
(show "columns:" (Explorer.DataFrame/to_columns by-city)) ; London 2, Paris 2

;; ── The point ───────────────────────────────────────────────────────
;;
;; q-df added NOTHING to the query. It is `q` then hand-built columns,
;; value-for-value — a promise the conformance test pins. So anything you
;; can ask with q, you can get as a frame; and once it is a frame, the
;; whole Polars toolbox (group, summarise, sort, join, plot) is yours —
;; which is exactly what 02-analytics.bl does next.

(heading "── done ──")
(println "  q-df is q, in columns. See 02-analytics.bl for the Polars pipeline.")
