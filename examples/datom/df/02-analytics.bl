; examples/datom/df/02-analytics.bl — the Polars pipeline over datalog.
; Run: mix beam_lisp.run --path priv examples/datom/df/02-analytics.bl
;
; ── The payoff ────────────────────────────────────────────────────────
;
; Once a query is a DataFrame, the whole Explorer (Polars) toolbox opens:
; group, summarise, sort, filter, and column math — all running in Rust
; over columnar memory, not in a per-row beam-lisp loop. This is the
; reason q-df exists: the analytical majority of questions ("spend per
; model", "which key has the worst cache rate") are column arithmetic,
; and this is where they belong.
;
; The dataset here is a small SPEND ledger — the shape relay records for
; every LLM request — so the queries are the real ones a gateway asks.

(ns example.datom.df.analytics (:require [datom]))

(defn- heading [text] (println (str "\n" text)))
(defn- show [label v] (println (str "  " label "  " (pr-str v))))

;; ── A spend ledger, as datoms ───────────────────────────────────────

(def conn
  (datom/connect
    [{:db/ident :spend/model    :db/valueType :db.type/string}
     {:db/ident :spend/provider :db/valueType :db.type/string}
     {:db/ident :spend/cents    :db/valueType :db.type/long}
     {:db/ident :spend/input    :db/valueType :db.type/long}
     {:db/ident :spend/output   :db/valueType :db.type/long}]))

(datom/transact! conn
  [{:db/id -1 :spend/model "gpt-4o"        :spend/provider "openai"    :spend/cents 30 :spend/input 1000 :spend/output 200}
   {:db/id -2 :spend/model "gpt-4o"        :spend/provider "openai"    :spend/cents 45 :spend/input 1500 :spend/output 300}
   {:db/id -3 :spend/model "claude-sonnet" :spend/provider "anthropic" :spend/cents 60 :spend/input 2000 :spend/output 250}
   {:db/id -4 :spend/model "claude-sonnet" :spend/provider "anthropic" :spend/cents 20 :spend/input  800 :spend/output 100}
   {:db/id -5 :spend/model "claude-haiku"  :spend/provider "anthropic" :spend/cents  5 :spend/input  400 :spend/output  50}])

(def db (datom/db conn))

;; ── Pull the ledger into one frame ──────────────────────────────────
;;
;; One q-df call gathers the columns the analysis needs. From here on,
;; every step is Explorer running in Rust.

(def ledger
  (datom/q-df '[:find ?model ?provider ?cents ?input ?output
                :where [?e :spend/model ?model]
                       [?e :spend/provider ?provider]
                       [?e :spend/cents ?cents]
                       [?e :spend/input ?input]
                       [?e :spend/output ?output]]
              db))

(heading "── the ledger ──")
(show "shape:" (Explorer.DataFrame/shape ledger))
(show "columns:" (Explorer.DataFrame/names ledger))

;; ── Spend per model (group + summarise) ─────────────────────────────
;;
;; group_by names the grouping column(s) as an Erlang LIST (not a bl vector —
;; Explorer reads a list of column names). summarise_with takes a function of
;; the grouped frame and returns a KEYWORD LIST of aggregate columns — a list of
;; {name, Series} tuples. Inside, `pull` gets a column's Series, and Series/sum
;; runs the fold in Rust.

(heading "── total spend per model ──")

(defn- col [d name] (Explorer.DataFrame/pull d name))
(defn- agg [name series] (erlang/list_to_tuple (list name series)))

(def per-model
  (-> ledger
      (Explorer.DataFrame/group_by (list "model"))
      (Explorer.DataFrame/summarise_with
        (fn [d] (list (agg :total_cents (Explorer.Series/sum   (col d "cents")))
                      (agg :requests    (Explorer.Series/count (col d "cents"))))))))

(show "per-model:" (Explorer.DataFrame/to_columns per-model))
;; => gpt-4o 75c/2 req, claude-sonnet 80c/2, claude-haiku 5c/1

;; ── Spend per provider, sorted high → low ───────────────────────────
;;
;; sort_with takes a function returning a sort spec ([desc: col]); no
;; column-name macro needed, so it composes from beam-lisp cleanly.

(heading "── spend per provider, ranked ──")

(def per-provider
  (-> ledger
      (Explorer.DataFrame/group_by (list "provider"))
      (Explorer.DataFrame/summarise_with
        (fn [d] (list (agg :total_cents (Explorer.Series/sum (col d "cents"))))))
      (Explorer.DataFrame/sort_with
        (fn [d] (list (erlang/list_to_tuple (list :desc (col d "total_cents"))))))))

(show "per-provider:" (Explorer.DataFrame/to_columns per-provider))
;; => anthropic 85c, openai 75c

;; ── A derived column: cents per 1k input tokens ─────────────────────
;;
;; Column math is a Series over a Series — mutate adds a column computed
;; from existing ones, elementwise, in Rust.

(heading "── efficiency: cents per 1k input tokens ──")

(def with-eff
  (Explorer.DataFrame/mutate_with ledger
    (fn [d]
      (list (agg :cents_per_1k
                 (Explorer.Series/divide
                   (Explorer.Series/multiply (col d "cents") 1000)
                   (col d "input")))))))

(show "efficiency:" (Explorer.DataFrame/to_columns
                      (Explorer.DataFrame/select with-eff (list "model" "cents_per_1k"))))

;; ── Scalars back out ────────────────────────────────────────────────
;;
;; A whole-ledger number is a Series reduction — the grand total spend.

(heading "── grand total ──")
(show "total cents:" (Explorer.Series/sum (Explorer.DataFrame/pull ledger "cents")))
(show "mean cents:"  (Explorer.Series/mean (Explorer.DataFrame/pull ledger "cents")))

(heading "── done ──")
(println "  datalog in, Polars analytics out — one q-df call between them.")
