; examples/datom/12-recursive-rules.bl — user-defined recursive rules.
; Run: mix beam_lisp.run --path priv examples/datom/12-recursive-rules.bl
;
; ── The primitive this adds ───────────────────────────────────────────
;
; A rule is a named relation defined by implications, and a rule may
; invoke ITSELF — recursion. That single capability is what turns a query
; language into a Datalog: transitive closure, reachability, connected
; components, shortest paths, same-generation, PageRank-style iteration —
; the entire family of graph and fixpoint computations — are all "derive
; new facts from known facts until nothing new appears".
;
;   [(reachable ?a ?b) [?a :edge/to ?b]]                    ; base
;   [(reachable ?a ?b) [?a :edge/to ?x] (reachable ?x ?b)]  ; recursive
;
; Rules travel through `:in` as `%` (Datomic's spelling) and are invoked
; like any clause:
;
;   [:find ?b :in $ % ?start :where [(reachable ?start ?b)]]
;
; ── How it evaluates, and why it terminates ───────────────────────────
;
; Rules are materialised BOTTOM-UP to a least fixpoint: start from what the
; base rules derive, apply the recursive rules to what is known, add
; whatever is new, repeat until a round adds nothing. Bottom-up is what
; makes it TERMINATE on cyclic graphs — the derived set is finite and only
; grows, so it must stop — where a naive top-down expansion would chase a
; cycle forever.
;
; The engine uses SEMI-NAIVE evaluation: each round joins only the DELTA
; (facts new last round) against the base, because a fact can only be new
; this round if it used a fact new last round. The last section MEASURES
; how much that saves against the naive "recompute everything each round".

(ns example.datom.recursive-rules
  (:require [datom] [datom.query.rules] [datom.query.rules-native] [datom.query.engine]))

(defn- show [l v] (println (str "  " l "  " (pr-str v))))
(defn- heading [t] (println (str "\n" t)))

(defn- ms [f]
  (let [t0 (erlang/monotonic_time :millisecond)
        _ (f)
        t1 (erlang/monotonic_time :millisecond)]
    (- t1 t0)))

;; ═══════════════════════════════════════════════════════════════════
;; 1. REACHABILITY — transitive closure, and termination on a cycle
;; ═══════════════════════════════════════════════════════════════════

(heading "── 1. reachability (transitive closure) ──")

(def net
  (datom/connect
    [{:db/ident :node/name :db/valueType :db.type/string}
     {:db/ident :edge/to :db/valueType :db.type/ref :db/cardinality :db.cardinality/many}]))

;; a small network with a CYCLE: A→B→C→A, plus C→D→E
(datom/transact! net
  [{:db/id -1 :node/name "A" :edge/to [-2]}
   {:db/id -2 :node/name "B" :edge/to [-3]}
   {:db/id -3 :node/name "C" :edge/to [-1 -4]}
   {:db/id -4 :node/name "D" :edge/to [-5]}
   {:db/id -5 :node/name "E"}])

(def db (datom/db net))

(def REACH
  '[[(reachable ?a ?b) [?a :edge/to ?b]]
    [(reachable ?a ?b) [?a :edge/to ?x] (reachable ?x ?b)]])

(defn- node [nm]
  (get (get (into [] (datom/q '[:find ?e :in $ ?n :where [?e :node/name ?n]] db nm)) 0) 0))

(show "reachable from A (cycle + tail, terminates):"
  (sort (into [] (datom/q '[:find ?bn :in $ % ?s
                            :where [(reachable ?s ?b)] [?b :node/name ?bn]]
                          db REACH (node "A")))))

;; A recursive rule JOINS with ordinary clauses like anything else:
(show "reachable from A whose name > \"B\":"
  (sort (into [] (datom/q '[:find ?bn :in $ % ?s
                            :where [(reachable ?s ?b)] [?b :node/name ?bn] [(> ?bn "B")]]
                          db REACH (node "A")))))

;; ═══════════════════════════════════════════════════════════════════
;; 2. CONNECTED COMPONENTS — recursion + a stratified min aggregate
;; ═══════════════════════════════════════════════════════════════════
;;
;; The textbook Datalog formulation (Zaniolo et al.): a node's component
;; is the MINIMUM node id reachable from it in the UNDIRECTED graph. The
;; recursion computes reachability over symmetric edges; the `min`
;; aggregate in the OUTER query (a higher stratum) picks the component
;; label. Two nodes share a component iff they share that label.

(heading "── 2. connected components (recursion + min) ──")

(def COMPONENTS
  '[[(linked ?a ?b) [?a :edge/to ?b]]
    [(linked ?a ?b) [?b :edge/to ?a]]                      ; make it undirected
    [(conn ?a ?b) (linked ?a ?b)]
    [(conn ?a ?b) (linked ?a ?x) (conn ?x ?b)]])

;; a graph with two components: {A,B,C} (the cycle) and a fresh {P,Q}
(def net2
  (datom/connect
    [{:db/ident :node/name :db/valueType :db.type/string}
     {:db/ident :edge/to :db/valueType :db.type/ref :db/cardinality :db.cardinality/many}]))
(datom/transact! net2
  [{:db/id -1 :node/name "A" :edge/to [-2]}
   {:db/id -2 :node/name "B" :edge/to [-3]}
   {:db/id -3 :node/name "C" :edge/to [-1]}
   {:db/id -10 :node/name "P" :edge/to [-11]}
   {:db/id -11 :node/name "Q"}])
(def db2 (datom/db net2))

;; component label = smallest reachable id; nodes with equal labels are one
;; component. (A node is connected to itself through the cycle; P–Q form
;; their own component.)
(show "component label per node (min reachable id):"
  (sort (into [] (datom/q '[:find ?an (min ?b)
                            :in $ %
                            :where [?a :node/name ?an] (conn ?a ?b)]
                          db2 COMPONENTS))))

;; ═══════════════════════════════════════════════════════════════════
;; 3. SHORTEST PATH — arithmetic in the recursive body + min
;; ═══════════════════════════════════════════════════════════════════
;;
;; Zaniolo's Example 1: path(Y,D) is a cost D from the source to Y; the
;; recursive rule adds an edge weight to a known path's cost. The `min`
;; aggregate then selects the shortest. This needs ARITHMETIC inside the
;; recursion — `[(+ ?dx ?w) ?d]` — which composes because a rule body is
;; ordinary clauses.

(heading "── 3. shortest path (weighted, recursion + arithmetic + min) ──")

(def roads
  (datom/connect
    [{:db/ident :e/from :db/valueType :db.type/long}
     {:db/ident :e/to :db/valueType :db.type/long}
     {:db/ident :e/w :db/valueType :db.type/long}]))
;; 1→2 (1), 2→3 (2), 1→3 (10 — the tempting-but-wrong direct road), 3→4 (1)
(datom/transact! roads
  [{:db/id -1 :e/from 1 :e/to 2 :e/w 1}
   {:db/id -2 :e/from 2 :e/to 3 :e/w 2}
   {:db/id -3 :e/from 1 :e/to 3 :e/w 10}
   {:db/id -4 :e/from 3 :e/to 4 :e/w 1}])
(def dbr (datom/db roads))

(def SHORTEST
  '[[(path ?y ?d) [?e :e/from 1] [?e :e/to ?y] [?e :e/w ?d]]
    [(path ?y ?d) (path ?x ?dx) [?e :e/from ?x] [?e :e/to ?y] [?e :e/w ?w] [(+ ?dx ?w) ?d]]])

(show "shortest cost from node 1 (note 1→3 is 3, not the direct 10):"
  (sort (into [] (datom/q '[:find ?y (min ?d) :in $ % :where (path ?y ?d)] dbr SHORTEST))))

;; ═══════════════════════════════════════════════════════════════════
;; 4. SAME-GENERATION — non-linear (doubly recursive) rule
;; ═══════════════════════════════════════════════════════════════════

(heading "── 4. same-generation (non-linear recursion) ──")

(def fam
  (datom/connect
    [{:db/ident :p/name :db/valueType :db.type/string}
     {:db/ident :parent/of :db/valueType :db.type/ref :db/cardinality :db.cardinality/many}]))
(datom/transact! fam
  [{:db/id -1 :p/name "gp" :parent/of [-2 -3]}
   {:db/id -2 :p/name "a" :parent/of [-4 -5]}
   {:db/id -3 :p/name "b" :parent/of [-6]}
   {:db/id -4 :p/name "c"} {:db/id -5 :p/name "d"} {:db/id -6 :p/name "e"}])
(def dbf (datom/db fam))

;; same generation: siblings are (base), and children of a same-gen pair
;; are same-gen (the doubly-recursive step reaches cousins).
(def SAMEGEN
  '[[(sg ?x ?y) [?p :parent/of ?x] [?p :parent/of ?y]]
    [(sg ?x ?y) [?px :parent/of ?x] [?py :parent/of ?y] (sg ?px ?py)]])

(def c (get (get (into [] (datom/q '[:find ?e :where [?e :p/name "c"]] dbf)) 0) 0))
(show "same generation as c (siblings d, AND cousin e):"
  (sort (into [] (datom/q '[:find ?yn :in $ % ?c
                            :where [(sg ?c ?y)] [?y :p/name ?yn]]
                          dbf SAMEGEN c))))

;; ═══════════════════════════════════════════════════════════════════
;; 5. EFFICIENCY — semi-naive vs naive evaluation
;; ═══════════════════════════════════════════════════════════════════
;;
;; Both evaluators compute the SAME least fixpoint. Naive recomputes the
;; whole relation every round: on a chain of length N that is O(N) rounds ×
;; O(N²) closure = O(N³). Semi-naive joins only last round's DELTA against
;; the base, so each of the O(N²) closure tuples is derived about once —
;; O(N²). The gap widens with depth; the table shows it.

(heading "── 5. native fixpoint vs bl fallback (the one-truth speedup) ──")

;; the engine's callback for evaluating a rule body's ordinary clauses
(def eval-plain
  (fn [d b clause]
    (datom.query.engine/eval-clause
      d b clause
      (fn [op] (try (BeamLisp.Env/fetch! "core" (name op)) (catch e nil)))
      {})))

(defn- chain-db [n]
  (let [conn (datom/connect
               [{:db/ident :edge/to :db/valueType :db.type/ref :db/cardinality :db.cardinality/many}])]
    (datom/transact! conn
      (into [] (mapv (fn [i]
                       (if (< i (- n 1))
                         {:db/id (- (+ i 1)) :edge/to [(- (+ i 2))]}
                         {:db/id (- (+ i 1))}))
                     (range n))))
    (datom/db conn)))

(println "  chain length | bl-fallback ms | native ms | speedup | closure tuples | identical")
(doseq [n [10 20 30]]
  (let [cdb (chain-db n)
        ;; the bl fallback fixpoint (the SOLE bl evaluator, normally reserved
        ;; for arbitrary-predicate recursion) vs the native kernel that
        ;; `materialise` dispatches to for this program
        bl-rel (datom.query.rules/derive-semi-naive cdb REACH eval-plain)
        nv-rel (datom.query.rules-native/materialise-native cdb REACH eval-plain)
        bl (get (get bl-rel 0) 'reachable)
        nv (get nv-rel 'reachable)
        bt (ms (fn [] (datom.query.rules/derive-semi-naive cdb REACH eval-plain)))
        nt (ms (fn [] (datom.query.rules-native/materialise-native cdb REACH eval-plain)))]
    (println (str "       " n "      |      " bt "      |    " nt "    |   "
                  (if (> nt 0) (erlang/div bt nt) "-") "x   |   " (count nv)
                  "   |   " (= bl nv)))))

(println "\n  → `materialise` dispatches to the NATIVE kernel: bl owns pattern")
(println "    meaning + value interning + decode, native owns the whole fixpoint.")
(println "    Output is bit-identical to the bl fallback; the speedup grows with")
(println "    depth (the boundary is crossed once per query, not per round).")

;; ═══════════════════════════════════════════════════════════════════

(heading "── what to take away ──")
(println "  A rule that invokes itself is recursion — the primitive that makes")
(println "  this a Datalog: reachability, components, shortest paths, same-gen")
(println "  Rules travel through :in as % and invoke like any clause; they JOIN")
(println "  Bottom-up fixpoint TERMINATES on cycles where top-down would loop")
(println "  min/max in an outer stratum expresses components and shortest paths")
(println "  `materialise` dispatches to ONE native fixpoint (bl owns meaning+decode)")
