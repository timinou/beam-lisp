; examples/datom/files/03-history-and-gc.bl — a file has a history too.
; Run: mix beam_lisp.run --path priv examples/datom/files/03-history-and-gc.bl
;
; ── Because a file is a fact, everything the database does to facts ──
; ── it does to files. ────────────────────────────────────────────────
;
;   retraction   → the fact is gone from the present; `as-of` still has it,
;                  and the BYTES are still there to resolve it
;   `with`       → a speculative file lands in a blob overlay the real store
;                  never sees; db-after resolves it, the base never learns
;   GC           → only ORPHANS are garbage: bytes referenced by no datom in
;                  the whole history (an upload whose transaction never landed)

(ns example.datom.files.history
  (:require [datom] [datom.file] [datom.blob]))

(defn- show [label value] (println (str "  " label "  " (pr-str value))))
(defn- heading [text] (println (str "\n" text)))

(def SCHEMA
  [{:db/ident :doc/title :db/valueType :db.type/string}
   {:db/ident :doc/attachment :db/valueType :db.type/file}])

(def conn (datom/connect SCHEMA))

(def r (datom/transact! conn [{:db/id -1 :doc/title "report.pdf"
                               :doc/attachment (datom/file "v1 bytes")}]))
(def doc (get (:tempids r) -1))
(def v1 (:doc/attachment (datom/entity (datom/db conn) doc)))

;; ═════════════════════════════════════════════════════════════════════
(heading "── replace: a new file is a new fact; cardinality-one retracts the old ──")

(def before (datom/db conn))
(datom/transact! conn [{:db/id doc :doc/attachment (datom/file "v2 bytes")}])
(def v2 (:doc/attachment (datom/entity (datom/db conn) doc)))
(show "now:" (datom/file-bytes (datom/db conn) v2))
(show "as-of before, the OLD bytes:" (datom/file-bytes before v1))
(show "changes to the attachment:"
      (mapv (fn [c] [(:added c) (datom.file/sha-hex (:value c))]) (datom/changes (datom/db conn) doc :doc/attachment)))

;; ═════════════════════════════════════════════════════════════════════
(heading "── retract: gone from the present, kept by history ──")

(def before-retract (datom/db conn))
(datom/transact! conn [[:db/retract doc :doc/attachment v2]])
(show "attachment now:" (:doc/attachment (datom/entity (datom/db conn) doc)))
(show "attachment as-of before:" (datom/file-bytes before-retract (:doc/attachment (datom/entity before-retract doc))))
(show "gc sweeps nothing — both versions are in history:" (datom/gc-files! conn))

;; ═════════════════════════════════════════════════════════════════════
(heading "── with: a speculative file never touches the real blob store ──")

(def spec (datom/with conn [{:db/id doc :doc/attachment (datom/file "draft v3")}]))
(def draft (:doc/attachment (datom/entity (:db-after spec) doc)))
(show "db-after resolves it:" (datom/file-bytes (:db-after spec) draft))
(show "the real db does not:" (datom/file-bytes (datom/db conn) draft))
(show "real blob store holds:" (count (datom.blob/-blob-shas (:blobs conn))))

;; ═════════════════════════════════════════════════════════════════════
(heading "── gc: an upload whose transaction never landed is the only garbage ──")

(datom/put-file! conn "uploaded, then the request died")
(show "blobs held:" (count (datom.blob/-blob-shas (:blobs conn))))
(show "gc:" (datom/gc-files! conn))
(show "blobs held:" (count (datom.blob/-blob-shas (:blobs conn))))

; The sweep runs INSIDE the writer — the one place where "no transaction is
; in flight" is true — so a put-file! whose transaction is queued behind the
; sweep cannot lose its bytes.

;; ═════════════════════════════════════════════════════════════════════
(heading "── what GC will not do ──")

; Reclaiming a RETRACTED file's bytes would break `as-of`. That needs
; excision — deliberately forgetting a fact from history — which does not
; exist yet. Until it does, a retracted file costs its bytes forever, on
; purpose.
(show "still resolvable from a historical value:" (datom/file-bytes before v1))

(datom/close! conn)
(println "\n  Files travel through time because facts do.")
