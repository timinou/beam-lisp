; examples/datom/files/02-tiers.bl — bytes live wherever the database lives.
; Run: mix beam_lisp.run --path priv examples/datom/files/02-tiers.bl
;
; ── Tiering is a capability, not a branch ─────────────────────────────
;
; Where bytes go follows where the DATABASE is, by default:
;
;   in-memory db  (store-ets / store-map) → blob-ets, in memory      opt-in: :tmp
;   on-disk db    (store-fjall)           → blob-fs at <db>.blobs    opt-in: S3
;   cluster db    (store-hobbes, later)   → blob-s3, REQUIRED
;
; Each Store substrate declares its own default by extending
; `datom.blob/DefaultBlobs`. Nothing above the store inspects a store's type
; to decide — adding a substrate never edits a caller.
;
; The choice is made ONCE, at connect time, and belongs to the STORE: a
; second connection over the same store inherits it, and a second
; connection asking for a different one is refused. Bytes have one home.

(ns example.datom.files.tiers
  (:require [datom] [datom.blob] [datom.blob-ets] [datom.blob-fs] [datom.store-fjall]))

(defn- show [label value] (println (str "  " label "  " (pr-str value))))
(defn- heading [text] (println (str "\n" text)))
(defn- tier-of [conn]
  (let [b (:blobs conn)]
    (cond (instance? datom.blob-fs/BlobFs b) (str "blob-fs @ " (:dir b))
          (instance? datom.blob-ets/BlobEts b) "blob-ets (memory)"
          :else (pr-str b))))

(def SCHEMA
  [{:db/ident :doc/title :db/valueType :db.type/string}
   {:db/ident :doc/attachment :db/valueType :db.type/file}])

(def png (erlang/list_to_binary (to-list (mapv (fn [i] (rem i 256)) (range 0 4096)))))

(defn- attach! [conn]
  (let [r (datom/transact! conn [{:db/id -1 :doc/title "t" :doc/attachment (datom/file png)}])]
    (:doc/attachment (datom/entity (:db-after r) (get (:tempids r) -1)))))

;; ═════════════════════════════════════════════════════════════════════
(heading "── memory db → memory bytes ──")

(def mem (datom/connect SCHEMA))
(show "tier:" (tier-of mem))
(show "url:" (datom/file-url (datom/db mem) (attach! mem)))
(datom/close! mem)

;; ═════════════════════════════════════════════════════════════════════
(heading "── memory db, bytes too big for the heap → :tmp ──")

(def tmp (datom/connect SCHEMA {:blobs :tmp}))
(show "tier:" (tier-of tmp))
(def f (attach! tmp))
(show "url:" (datom/file-url (datom/db tmp) f))
(show "streams in chunks:" (count (datom/file-stream (datom/db tmp) f)))

;; ═════════════════════════════════════════════════════════════════════
(heading "── configured once: a second connection inherits, a rival is refused ──")

(def again (datom/connect-with (:store tmp) SCHEMA))
(show "second conn shares the blob store:" (= (:blobs again) (:blobs tmp)))
(show "a different tier on the same store:"
      (try (do (datom/connect-with (:store tmp) SCHEMA {:blobs (datom.blob-fs/open :tmp)}) :accepted)
           (catch e :refused)))

; close! deletes the :tmp directory — it was ours alone.
(def tmp-dir (:dir (:blobs tmp)))
(datom/close! tmp)
(show "tmp dir after close!:" (File/dir? tmp-dir))

;; ═════════════════════════════════════════════════════════════════════
(heading "── disk db → bytes beside it ──")

; A durable database keeps its bytes at <path>.blobs: a sibling directory,
; so the database and its files are moved and backed up as one thing.
(if (datom.store-fjall/available?)
  (let [store (datom.store-fjall/open-fresh)
        disk (datom/connect-with store SCHEMA)
        f (attach! disk)]
    (show "tier:" (tier-of disk))
    (show "sibling of the database:" (= (str (:path store) ".blobs") (:dir (:blobs disk))))
    (show "url:" (datom/file-url (datom/db disk) f))
    ; close! SYNCS a durable store and keeps its data — then the database
    ; reopens with every file resolvable.
    (datom/close! disk)
    (let [reopened (datom/connect-with (datom.store-fjall/open (:path store)))
          e (first (first (datom/q '[:find ?e :where [?e :doc/attachment _]] (datom/db reopened))))
          f2 (:doc/attachment (datom/entity (datom/db reopened) e))]
      (show "after close! + reopen, bytes intact:" (= png (datom/file-bytes (datom/db reopened) f2)))
      (datom/close! reopened)))
  (println "  (fjall backend not loaded — disk tier skipped)"))

;; ═════════════════════════════════════════════════════════════════════
(heading "── the S3 seam ──")

; `datom/file-url` exists so a client can fetch bytes WITHOUT crossing the
; BEAM: a `file://` path today, a presigned S3 GET when blob-s3 lands
; (FUP-025). The same `{:blobs (datom.blob-s3/open {...})}` at connect time
; is the whole configuration — nothing else in the database changes.
(println "  (datom/connect-with store SCHEMA {:blobs (datom.blob-s3/open {:bucket …})})")

(println "\n  The store knows its tier. You override once, at setup, or never.")
