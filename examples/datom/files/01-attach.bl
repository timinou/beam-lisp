; examples/datom/files/01-attach.bl — a file is a fact; its bytes are not.
; Run: mix beam_lisp.run --path priv examples/datom/files/01-attach.bl
;
; ── The one constraint ────────────────────────────────────────────────
;
; A datom's value is copied into 2–4 covering indexes, and in AVET it is
; part of the KEY. Put a 40 MB binary in a datom and the database writes it
; several times over and hands the key encoder a 40 MB term. So a file datom
; holds a ~50-byte CONTENT-ADDRESSED DESCRIPTOR — sha256, size, media type —
; and the bytes live in a blob store beside the database.
;
; This file shows the write and read paths. 02-tiers.bl shows where the
; bytes go; 03-history-and-gc.bl shows what history, speculation and GC do
; with them.

(ns example.datom.files.attach
  (:require [datom] [datom.file] [datom.blob]))

(defn- show [label value] (println (str "  " label "  " (pr-str value))))
(defn- heading [text] (println (str "\n" text)))

(def SCHEMA
  [{:db/ident :doc/title :db/valueType :db.type/string}
   {:db/ident :doc/attachment :db/valueType :db.type/file}])

(def conn (datom/connect SCHEMA))

;; ═════════════════════════════════════════════════════════════════════
(heading "── the one-shot form: a staged file in transaction data ──")

; `datom/file` hashes the bytes NOW, in this process, and returns a DFile
; still carrying its `:body`. The pipeline uploads the body before the
; commit and records the descriptor alone.
(def png (erlang/list_to_binary (to-list (mapv (fn [i] (rem i 256)) (range 0 4096)))))
(def r1 (datom/transact! conn [{:db/id -1 :doc/title "cat.png"
                                :doc/attachment (datom/file png {:media-type "image/png"})}]))
(def cat (get (:tempids r1) -1))

(def stored (:doc/attachment (datom/entity (datom/db conn) cat)))
(show "what the datom holds:" stored)
(show "a body in the datom?" (some? (get stored :body)))
(show "a body in the broadcast report?" (some? (get (datom/datom-v (first (:tx-datoms r1))) :body)))

;; ═════════════════════════════════════════════════════════════════════
(heading "── the efficient form: upload in YOUR process, transact a descriptor ──")

; The writer is a single process — it serializes every transaction. Bytes
; must not flow through it. `put-file!` uploads in the CALLER's process, so
; a hundred callers upload in parallel and the writer sees 50-byte
; descriptors.
(def big (erlang/list_to_binary (to-list (mapv (fn [i] (rem (* i 7) 256)) (range 0 262144)))))
(def desc (datom/put-file! conn big {:media-type "application/octet-stream"}))
(show "descriptor returned, no body:" desc)
(def r2 (datom/transact! conn [{:db/id -1 :doc/title "big.bin" :doc/attachment desc}]))
(show "256 KiB round-trips:" (= big (datom/file-bytes (:db-after r2) desc)))

; A descriptor whose bytes were never uploaded is refused — the transaction
; is rejected as a whole, so a datom never points at nothing.
(def bogus (datom.file/at-rest (datom.file/file "never uploaded")))
(show "dangling descriptor:"
      (try (do (datom/transact! conn [{:db/id -1 :doc/title "x" :doc/attachment bogus}]) :accepted)
           (catch e (:error (first (:problems (ex-data e)))))))

;; ═════════════════════════════════════════════════════════════════════
(heading "── reading: through the DB VALUE, three ways ──")

(def db (datom/db conn))
(show "file-bytes, identical:" (= png (datom/file-bytes db stored)))
(show "file-stream, chunks:" (count (datom/file-stream db desc)))
(show "file-url (memory tier has none):" (datom/file-url db desc))

;; ═════════════════════════════════════════════════════════════════════
(heading "── content-addressed: same bytes, one blob ──")

(datom/transact! conn [{:db/id -1 :doc/title "cat-copy.png" :doc/attachment (datom/file png)}])
(show "documents with an attachment:"
      (count (datom/q '[:find ?e :where [?e :doc/attachment _]] (datom/db conn))))
(show "blobs actually stored:" (count (datom.blob/-blob-shas (:blobs conn))))

;; ═════════════════════════════════════════════════════════════════════
(heading "── metadata is ordinary attributes, not a bigger descriptor ──")

; The descriptor is {sha size media-type}, nothing more. Filename, uploader,
; created-at are attributes on the ENTITY — queryable like anything else.
(show "png attachments by title:"
      (datom/q '[:find ?t :where [?e :doc/attachment ?f] [?e :doc/title ?t]
                                 [(get ?f :media-type) ?m] [(= ?m "image/png")]]
               (datom/db conn)))

(datom/close! conn)
(println "\n  The datom holds the fact. The blob store holds the bytes.")
