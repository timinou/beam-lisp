; examples/datom/time/08-chronolog.bl — a chronology is a database, and its
; three questions are three engines you already have.
; Run: mix beam_lisp.run --path priv examples/datom/time/08-chronolog.bl
;
; ── Start from the problem ────────────────────────────────────────────
;
; Tempo's most ambitious feature is Tempo.Network (the "ChronoLog"
; scheme): a web of partially-known intervals — reigns, archaeological
; strata, project tasks — with CONSTRAINTS between them ("the war ended
; before the treaty", "layer B sits above layer A"), from which it solves
; the TIGHTEST bound each interval can take, with a plain-English trace
; for every bound. Tempo.Schedule aims the same solver at project critical
; paths.
;
; In datom.time this is LEAST a port and MOST a recognition. The intervals
; are already entities in a db (02), so the constraint network IS a db —
; and the repo already contains, three ways over, the machinery of
; propagation to a fixpoint. Maximalist ChronoLog is not one solver but a
; dispatch over the QUESTION:
;
;   "tightest bound?"   → datom recursive rules to a FIXPOINT
;                         (examples/datom/12-recursive-rules.bl;
;                          benchmarked in bench/fixpoint_bench.bl)
;   "consistent?"       → z3   (unsat = your chronology contradicts itself,
;                         with the clashing constraints named)
;   "why this bound?"   → PROVENANCE, a first-class query result
;                         (examples/relations/07-graphrag-provenance.bl)
;   "all orderings?"    → miniKanren (enumerate every consistent schedule)
;
; One db, three engines, no separate network structure — because with one
; representation there was never anything to separate.
;
; ── What is LIVE vs SPECIFIED ─────────────────────────────────────────
;
; The datom fixpoint engine, z3, miniKanren, and provenance ALL SHIP. What
; datom.time adds is the encoding: ordering facts as datoms, the bound-
; tightening rule, and the SMT translation of "these intervals are
; mutually consistent". The datom.time/* calls below are that specified
; surface; they DISPATCH to the shipped engines.

(ns example.datom.time.chronolog
  (:require [datom] [datom.time :as time]))

(defn- show [label v] (println (str "  " label "  " (pr-str v))))
(defn- heading [t] (println (str "\n" t)))

;; ── a chronology is ordering facts over interval entities ───────────
;;
;; Each event is an entity with a (possibly wide / uncertain) :ev/span and
;; :ev/before edges to events it precedes. No bespoke Network type — the
;; constraint graph is datoms, so it time-travels and commits atomically
;; like everything else.

(heading "── a chronology, as ordinary datoms ──")
(def conn
  (datom/connect
    [{:db/ident :ev/name   :db/valueType :db.type/string}
     {:db/ident :ev/span   :db/valueType :db.type/time}
     {:db/ident :ev/before :db/valueType :db.type/ref :db/cardinality :db.cardinality/many}]))

;; What we know: a war (sometime in the 1010s), a treaty AFTER it, a reign
;; that CONTAINS both. Each span is uncertain; the ORDER constraints are
;; what tighten them.
(def tx (datom/transact! conn
  [{:db/id -1 :ev/name "the war"    :ev/span #o"101X"}
   {:db/id -2 :ev/name "the treaty" :ev/span #o"101X"}]))
(def war    (get (:tempids tx) -1))
(def treaty (get (:tempids tx) -2))
;; the war precedes the treaty
(datom/transact! conn [[:db/add war :ev/before treaty]])
(def db (datom/db conn))

(show "the war's span (uncertain):"
      (let [s (first (first (datom/q '[:find ?s :where [?e :ev/name "the war"] [?e :ev/span ?s]] db)))]
        [(time/from s) (time/to s)]))
;; ── CONSISTENT? — a z3 check (LIVE) ─────────────────────────────────
;;
;; Are the ordering constraints jointly satisfiable? consistent? encodes
;; each event's permitted start range and every `before` edge as SMT and
;; asks z3: sat = a consistent dating exists, unsat = the chronology
;; contradicts itself. This is the LIVE z3 path (priv/z3.bl). `bounds` is a
;; map event->[lo hi] start range; `constraints` a vector of [before after].

(heading "── consistent?: satisfiability of the network (LIVE z3) ──")
(def port (z3/open))
(def bounds {:war [1010 1019] :treaty [1010 1019]})
(show "war before treaty — consistent?"
      (time/consistent? port bounds [[:war :treaty]]))            ; => true

;; Add the contradiction — the treaty must ALSO precede the war — and the
;; network becomes unsatisfiable: no dating can put each before the other.
(show "war<treaty AND treaty<war — consistent?"
      (time/consistent? port bounds [[:war :treaty] [:treaty :war]]))
;; => {:consistent false}

;; ── the further questions ───────────────────────────────────────────
;;
;; consistent? is the LIVE z3 pole. The full ChronoLog surface adds three
;; more questions over the SAME db, each dispatching to an engine already
;; in the tree — the next builds named in docs/tempo-maximalist.md §7:
;;
;;   tighten   — the least fixpoint of the bounds (a recursive datom rule,
;;               examples/datom/12-recursive-rules.bl + fixpoint_bench.bl);
;;               longest-path over :ev/before is a schedule's critical path.
;;   why       — the provenance trace behind a tightened bound, read from
;;               the store's own provenance (relations/07-graphrag-*).
;;   orderings — every consistent total order, a miniKanren enumeration
;;               (§7 shows enumerating the feasible).
;;
;; One db, four engines, no separate Network structure — with one
;; representation, there was never anything to separate.

(heading "── what to take away ──")
(println "  A chronology is a db of interval events + ordering facts. Asking")
(println "  whether it is consistent is a z3 check — shown here, LIVE. The")
(println "  fuller surface (tighten / why / all-orderings) dispatches the SAME")
(println "  db to a datom fixpoint, the store's provenance, and a miniKanren")
(println "  run — the next builds in §7. There is no Network structure to build:")
(println "  with one representation, there was never anything to separate.")
