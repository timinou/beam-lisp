; examples/datom/time/01-interval.bl — a date is not a point, it is a span.
; Run: mix beam_lisp.run --path priv examples/datom/time/01-interval.bl
;
; ── Start from the problem ────────────────────────────────────────────
;
; Ask a normal library what `2026-06-15` means and it cannot tell you. Is
; it midnight — the instant the day begins? Or the whole day? The type
; says "a point" (a Date, a scalar), but every program USES it as a span:
; "is the meeting during the 15th?", "how many days until the 15th?". So
; every codebase grows its own `end_of_day` helper, and the gap between
; the point the type is and the span the program means is where the
; off-by-one bug lives. The meeting that ends "at 15:00" — is 15:00 inside
; the meeting or the first instant after it? The scalar type has no
; opinion, so two functions disagree and a booking double-books.
;
; One decision removes the whole class: a date IS the half-open interval
; [from, to). `2026-06-15` is exactly [2026-06-15, 2026-06-16). The lower
; bound is IN, the upper bound is OUT. 15:00 belongs to whatever interval
; starts at 15:00, never to the one that ends there. Adjacent spans then
; tile the line with no gap and no overlap — [a,b) ++ [b,c) == [a,c) —
; which is the algebraic property that makes "end of day" a non-question.
;
; And there is only ONE type. A year, a month, a day, a second are not
; four types (Date/Month/Time/Instant) — they are one interval type at
; four RESOLUTIONS. The resolution is how wide the span is; everything
; else is the same value.

(ns example.datom.time.interval
  (:require [datom.time :as time]))

(defn- show [label v] (println (str "  " label "  " (pr-str v))))
(defn- heading [t] (println (str "\n" t)))

;; ── one type, four resolutions ──────────────────────────────────────
;;
;; The SAME constructor, differing only in how fine the finest component
;; is. There is no Date vs DateTime decision to make: you say what you
;; know, and the resolution is whatever you stopped at.

(heading "── one type, four resolutions ──")
(show "a year:  " (time/interval :year 2026))
(show "a month: " (time/interval :year 2026 :month 6))
(show "a day:   " (time/interval :year 2026 :month 6 :day 15))
(show "a second:" (time/interval :year 2026 :month 6 :day 15
                                 :hour 14 :minute 30 :second 0))

;; ── the bounds are real, and half-open ──────────────────────────────
;;
;; The interval is not a label on a point — its endpoints are materialised
;; values you can ask for. `from` is inclusive, `to` is exclusive, and the
;; width is exactly one unit of the resolution.

(heading "── the bounds are real, and half-open ──")
(def d (time/interval :year 2026 :month 6 :day 15))
(show "from (inclusive):" (time/from d))         ; 2026-06-15
(show "to   (exclusive):" (time/to d))           ; 2026-06-16
(show "resolution:      " (time/resolution d))   ; :day

;; A coarser value is a WIDER span, not a different kind of thing.
(def m (time/interval :year 2026 :month 6))
(show "the month's span:" [(time/from m) (time/to m)])   ; [2026-06, 2026-07)

;; ── adjacency: no gap, no overlap ───────────────────────────────────
;;
;; This is the property that retires `end_of_day`. The 15th ends at the
;; exact instant the 16th begins, so a run of days tiles the timeline
;; seamlessly — no shared boundary instant to double-count, none missing.

(heading "── adjacency: no gap, no overlap ──")
(def d16 (time/interval :year 2026 :month 6 :day 16))
(show "15th meets 16th:      " (time/meets? d d16))        ; true
(show "15th overlaps 16th:   " (time/overlaps? d d16))     ; false — they only touch
(show "to(15th) = from(16th):" (= (time/to d) (time/from d16)))  ; true

;; ── a point in time is just an interval of the finest width ─────────
;;
;; "Now" is not a different type from "this year". It is the same interval
;; type at :second (or finer) resolution — a one-second-wide span. There
;; is no scalar instant hiding underneath; the interval is the bottom.

(heading "── a point is an interval too ──")
(def instant (time/interval :year 2026 :month 6 :day 15
                            :hour 14 :minute 30 :second 0))
(show "an instant's width:" [(time/from instant) (time/to instant)]) ; a 1-second span
(show "still the same type:" (= (time/resolution instant) :second))

(heading "── what to take away ──")
(println "  A date IS a half-open interval [from, to). One type; the")
(println "  resolution just sets the width. Adjacent intervals meet")
(println "  cleanly, so 'end of day' stops being a question. Next (02):")
(println "  how this interval is STORED — as a value, not an entity.")
