; examples/datom/time/02-value-not-entity.bl — an interval is a VALUE, and
; that is what makes it as fast and sturdy as a native :db.type/instant.
; Run: mix beam_lisp.run --path priv examples/datom/time/02-value-not-entity.bl
;
; ── Start from the fork ───────────────────────────────────────────────
;
; 01 said a date is an interval [from, to). This file is about the choice
; that decides whether that idea is efficient or merely elegant: HOW is
; the interval stored?
;
; The tempting answer is "as an ENTITY" — give it a :time/from datom, a
; :time/to datom, :time/resolution, :time/calendar, :time/zone, and point
; at it with a ref. It reads beautifully in a query (you can join on
; :time/from). But it is ~6 datoms and a ref-hop per date, where a native
; :db.type/instant is ONE packed 8-byte value. Six times the storage and
; an indirection on every read is not "sturdy like a real date".
;
; datom already faced this EXACT fork — with embeddings. See
; priv/lib/datom/vector.bl: "a :db.type/term can already hold [0.1 0.2 …] — do
; we reuse that? No." It gave embeddings their own value TYPE
; (:db.type/vector) and a packed shape (a DVec), for three named reasons:
; STORAGE (contiguous bytes, no per-element decode), MEANING (the type
; tells the schema what you can DO with the column), and SAFETY (a new
; type can't reinterpret an old value, so existing tests keep passing).
;
; An interval takes the same road. The ONE representation is a packed
; VALUE — :db.type/time — a fixed-width little-endian record that
; rides the same value-codec lane an :instant does:
;
;   from:i64(8) │ to:i64(8) │ res:u8(1) │ cal:u8(1) │ zone:u16(2)  = 20B
;
; The [from,to) "entity" view from 01 is then a PROJECTION — endpoints
; read out of the one value when a query wants to join on them — never a
; second stored copy. That is what keeps "one representation" honest.

(ns example.datom.time.value
  (:require [datom] [datom.time :as time]))

(defn- show [label v] (println (str "  " label "  " (pr-str v))))
(defn- heading [t] (println (str "\n" t)))

;; ── an interval column is a first-class typed column ─────────────────
;;
;; :db.type/time sits in the schema beside :string and :instant. A
;; reign's span is ONE value in ONE datom — not a ref to a five-datom
;; satellite entity.

(heading "── a first-class typed column ──")
(def conn
  (datom/connect
    [{:db/ident :reign/of   :db/valueType :db.type/string}
     {:db/ident :reign/span :db/valueType :db.type/time}]))   ; ← the value type

(def tx (datom/transact! conn [{:db/id -1 :reign/of "Aethelred" :reign/span #time"978/1016"}]))
(def db (datom/db conn))

;; ── it round-trips bit-identically, like any value ──────────────────
;;
;; The stored value equals the literal you put in. This is the value-codec
;; contract every :db.type/* obeys: encode then decode is identity. An
;; interval is not special here — that is the whole point.

(heading "── round-trips like any value ──")
(def span (first (first (datom/q '[:find ?span :where [?e :reign/span ?span]] db))))
(show "stored then read:    " span)
(show "equal to the literal:" (= span #time"978/1016"))

;; ── and it RANGE-SCANS: this is sturdiness, not just speed ──────────
;;
;; The value-codec has TWO encodings (see its header): the value slot
;; optimises decode speed, but the KEY slot must SORT. Give the interval a
; key codec that orders by (from, to) — using the same IEEE / two's-
;; complement bit-twiddling :db.type/long already uses — and "reigns
;; beginning before the year 1000" becomes an AVET index RANGE SCAN, not a
;; full-table filter. A range scan on a typed column is the property that
;; makes a native date sturdy; the interval inherits it.

(heading "── it range-scans on the index ──")
(datom/transact! conn [{:db/id -2 :reign/of "Cnut"    :reign/span #time"1016/1035"}
                       {:db/id -3 :reign/of "Alfred"  :reign/span #time"871/899"}])
(def db2 (datom/db conn))
(show "reigns starting before 1000:"
      (sort (map first
                 (datom/q '[:find ?of
                            :where [?e :reign/span ?s]
                                   [?e :reign/of ?of]
                                   [(datom.time/starts-before? ?s #time"1000")]]
                          db2))))   ; => ("Aethelred" "Alfred") — Cnut (1016) excluded

;; ── the day-one safety net: the ESC lane ────────────────────────────
;;
;; Before the packed LANE-INTERVAL is written, the value-codec's ESC lane
;; (term_to_binary of any BEAM term) round-trips an interval CORRECTLY —
;; one binary_to_term per value, slower but never wrong. So the module
;; ships correct on the ESC lane, and the packed lane is added later as a
;; pure storage optimisation that changes NOTHING above the codec — the
;; same migration priv/lib/datom/vector.bl documents for the DVec.

(heading "── correct before it is fast (ESC lane) ──")
(show "ESC-lane round-trip is identity:" (= span #time"978/1016"))
(println "  (the packed 20-byte lane is a later speed step, not a")
(println "   correctness one — the value is right either way.)")

;; ── what NOT to do ──────────────────────────────────────────────────
;;
;; Storing the interval as a plain bl MAP in a :db.type/term attribute
;; LOOKS fine — the ESC lane round-trips it bit-identically — but it
;; silently forfeits every sturdiness property above: no range scan (a
;; term has no sortable key), no fixed-width column for a NIF to build, no
;; schema validation that the value is even an interval. That is exactly
;; the "vector-as-a-term" anti-pattern vector.bl rejects. "Sturdy" means:
;; give time its value type; do not leave it in the term lane.

(heading "── the anti-pattern to avoid ──")
(println "  :db.type/term + a map  → round-trips, but:")
(println "    ✗ no range scan (no sortable key)")
(println "    ✗ no fixed-width column (no NIF-buildable storage)")
(println "    ✗ no schema validation (any map passes)")
(println "  :db.type/time      → all three, inherited from :instant's lane.")

(heading "── what to take away ──")
(println "  One representation: a packed VALUE, not an entity. It rides")
(println "  the value-codec lane a native :instant does, so it round-trips,")
(println "  range-scans, and stays correct on the ESC lane before the packed")
(println "  lane exists. The from/to view is a projection, not a copy.")
(println "  Next (03): how #time\"…\" text becomes this value, checked at read time.")
