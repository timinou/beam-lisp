; examples/datom/time/04-allen.bl — Allen's 13 relations, as a predicate
; AND as a join. One relation, two spellings.
; Run: mix beam_lisp.run --path priv examples/datom/time/04-allen.bl
;
; ── Start from the problem ────────────────────────────────────────────
;
; Once every value is an interval, "how do two of them relate?" has a
; complete answer — James Allen's 13 interval relations: precedes, meets,
; overlaps, starts, during, finishes, equals, and the six inverses. Every
; temporal comparison you can ask about two spans is exactly one of these,
; and the everyday predicates (overlaps?, contains?, disjoint?, subset?)
; are named FAMILIES of them.
;
; A normal library exposes this as a comparison API: you hold two values,
; you call a function, you get a boolean. beam-lisp gives you that — and,
; because an interval is already a store VALUE (02), a SECOND spelling a
; library cannot reach: the same 13 relations as a datom RELATION, an edge
; you JOIN on. [?a :~overlaps ?b] sits in a :where clause exactly like a
; stored fact, so "external meetings that overlap a deadline" is one query,
; not a fold over a comparison call.
;
; This is the "attribute spelling / call spelling, and both are the same
; relation" duality from examples/relations/01-defrelation.bl — pointed at
; time. Compute the relation ONCE; expose it TWICE.

(ns example.datom.time.allen
  (:require [datom]
            [datom.time :as time]))

(defn- show [label v] (println (str "  " label "  " (pr-str v))))
(defn- heading [t] (println (str "\n" t)))

;; ── spelling one: the predicate ─────────────────────────────────────
;;
;; Two intervals in hand, ask the single Allen relation between them, or
;; the derived predicate. Under the hood this is arithmetic on the two
;; endpoints of each value — the [from,to) longs of 02 — nothing more.

(heading "── the single Allen relation ──")
(def morning   #o"2026-06-15T09/2026-06-15T12")
(def midday    #o"2026-06-15T11/2026-06-15T14")
(def afternoon #o"2026-06-15T13/2026-06-15T17")

(show "morning vs midday:   " (time/allen morning midday))     ; :overlaps
(show "morning vs afternoon:" (time/allen morning afternoon))  ; :precedes
(show "midday vs morning:   " (time/allen midday morning))     ; :overlapped-by (inverse)

(heading "── the derived predicates (named families) ──")
(show "morning overlaps midday? " (time/overlaps? morning midday))     ; true
(show "morning disjoint afternoon?" (time/disjoint? morning afternoon)) ; true
(def day  #o"2026-06-15")
(show "day contains morning?    " (time/contains? day morning))         ; true
(show "morning subset of day?   " (time/subset? morning day))           ; true

;; ── the 13 are complete: exactly one holds ──────────────────────────
;;
;; Allen's set is a partition of the space of interval pairs: for any two
;; intervals, precisely one of the 13 relations is true. That totality is
;; why the predicates can be defined as families without gaps or overlaps.

(heading "── exactly one of the 13 holds ──")
(show "meets (touch, no overlap):"
      (time/allen day (time/interval :year 2026 :month 6 :day 16)))     ; :meets
(show "equals (same bounds):"
      (time/allen day #o"2026-06-15"))                                  ; :equals
(show "starts (same start, shorter):"
      (time/allen #o"2026-06-15T09/2026-06-15T10" morning))            ; :starts

;; ── spelling two: the SAME relation, inside a query ─────────────────
;;
;; This is the spelling tempo cannot reach. Because an interval is a store
;; VALUE (02), the Allen test lives INSIDE the :where as a predicate
;; clause — two interval columns bound from stored attributes, compared
;; by `overlaps?` with no projection and no fold. The temporal relation
;; and a plain attribute clause sit side by side in one query.

(def conn
  (datom/connect
    [{:db/ident :meeting/title :db/valueType :db.type/string}
     {:db/ident :meeting/kind  :db/valueType :db.type/keyword}
     {:db/ident :meeting/span  :db/valueType :db.type/time}
     {:db/ident :deadline/name :db/valueType :db.type/string}
     {:db/ident :deadline/span :db/valueType :db.type/time}]))

(datom/transact! conn
  [{:db/id -1 :meeting/title "vendor sync"  :meeting/kind :external :meeting/span #o"2026-06-15T10/2026-06-15T11"}
   {:db/id -2 :meeting/title "team standup" :meeting/kind :internal :meeting/span #o"2026-06-15T10/2026-06-15T11"}
   {:db/id -3 :deadline/name "ship v2"      :deadline/span #o"2026-06-15T09/2026-06-15T17"}])

;; "external meetings that overlap a deadline" — the Allen predicate joined
;; with a stored attribute in ONE query. Because an interval is a store
;; VALUE, `overlaps?` is a query predicate `[(datom.time/overlaps? ?a ?b)]`
;; exactly like `[(> ?age 40)]` — two interval columns compared inline, no
;; fold, no comparison loop. The value living in the store is what lets the
;; temporal test sit in the :where beside a plain attribute clause.
(heading "── one query: an Allen predicate joined with stored facts ──")
(show "external meetings overlapping a deadline:"
      (map first
           (datom/q '[:find ?title
                      :where [?m :meeting/title ?title]
                             [?m :meeting/kind :external]
                             [?m :meeting/span ?a]
                             [?d :deadline/span ?b]
                             [(datom.time/overlaps? ?a ?b)]]
                    (datom/db conn))))   ; => ("vendor sync")

;; ── the further step: the SAME relation as a named edge ─────────────
;;
;; The predicate above is the running form. The maximalist end-state wraps
;; that exact test as a COMPUTED relation (defrelation + a provider over
;; interval values), so it reads as an edge — [?a :~overlaps ?b] — and the
;; planner treats it like any stored fact. The provider is the value-level
;; sibling of datom.query.relations' entity-level adjacency providers; it
;; is the next build named by docs/tempo-maximalist.md §2. The predicate
;; and the edge are the same 13 relations, computed once, exposed twice.

(heading "── what to take away ──")
(println "  Allen's 13 relations, as a predicate you can drop into a :where")
(println "  beside a stored-attribute clause — because an interval is a store")
(println "  value, not a thing you fetch and fold. The named-edge spelling")
(println "  (:~overlaps) is the same relation wrapped as a computed edge, the")
(println "  next build in §2. Next (05): free time is the day minus the")
(println "  meetings, and that is just a query with 'not'.")
