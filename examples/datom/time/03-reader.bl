; examples/datom/time/03-reader.bl — #o"…" reads ISO 8601 text into an
; interval, and checks it at READ time.
; Run: mix beam_lisp.run --path priv examples/datom/time/03-reader.bl
;
; ── Start from the problem ────────────────────────────────────────────
;
; Tempo's headline ergonomic is the ~o sigil: ~o"2026-06-15" parses ISO
; 8601 at COMPILE time into a value. beam-lisp has no Elixir sigils — but
; it has something with the same shape and more reach: DATA-READERS, the
; mechanism datom already uses for its #d[…] query literal.
;
; priv/datom.bl ends with:
;
;   (data-reader! "d" (quote datom/read-query))
;
; so #d[:find ?x :where …] READS as (datom/read-query [:find ?x …]) — and
; because read-query is a MACRO, it VALIDATES the query when the form is
; compiled. A malformed query is a read-time error at the source position,
; not a runtime surprise deep in a join. The core reader registers @→deref
; the same rebindable way.
;
; #o is that pattern pointed at time. It reads the full ISO 8601-2 / EDTF
; / IXDTF grammar into the packed interval VALUE of 02 — so a temporal
; literal is checked where you wrote it, and drops straight into a datom
; transaction because it already IS a value.
;
;   (data-reader! "o" (quote datom.time/read-iso8601))
;
; NB (honesty): #d is followed by a COLLECTION (#d[…]). #o wants a STRING
; (#o"…"), which today's reader does not route to a data-reader — that is
; a ~5-line change in lib/beam_lisp/reader.ex (accept a string after a
; tag, exactly as Clojure's built-in #inst "…" does). Named in the design
; doc; this demo SPECIFIES the #o"…" surface the change enables.

(ns example.datom.time.reader
  (:require [datom] [datom.time :as time]))

(defn- show [label v] (println (str "  " label "  " (pr-str v))))
(defn- heading [t] (println (str "\n" t)))

;; ── the grammar, one resolution at a time ───────────────────────────
;;
;; The same literal grammar covers every resolution and every shape —
;; a bare year, a year-month, a full timestamp, a closed interval, an
;; open-ended one. One reader, the whole of ISO 8601 Part 1.

(heading "── ISO 8601 Part 1: resolutions and intervals ──")
(show "a year:       " #o"2026")
(show "a month:      " #o"2026-06")
(show "a day:        " #o"2026-06-15")
(show "a timestamp:  " #o"2026-06-15T14:30:00")
(show "a closed span:" #o"2026-06-15T09/2026-06-15T17")
(show "open-ended:   " #o"1985/..")               ; from 1985 onwards

;; ── ISO 8601-2 / EDTF: uncertainty in the literal itself ────────────
;;
;; The Part 2 extension puts archaeological and approximate dates in the
;; SAME grammar: a mask (unknown digits), a qualified endpoint (? = un-
;; certain, ~ = approximate). These read into intervals too — 07 is where
;; they get their solver-backed meaning. Here, just: the reader accepts
;; them, at the position you wrote them.

(heading "── ISO 8601-2 / EDTF: masks and qualifications ──")
(show "a masked year (the 1560s):" #o"156X")
(show "uncertain start / approx end:" #o"1984?/2004~")

;; ── IXDTF: zone and calendar suffixes ───────────────────────────────
(heading "── IXDTF: [zone] and [u-ca=…] suffixes ──")
(show "with a zone:    " #o"2026-06-15T14:30[Australia/Sydney]")
(show "with a calendar:" #o"2026-06-15[u-ca=hebrew]")

;; ── it IS a value: it drops into a transaction ──────────────────────
;;
;; Because #o reads into the packed interval value (02), a literal is not
;; a parse step you run before storing — it goes directly into transact!,
;; the same way a string or an :instant literal would.

(heading "── a literal drops straight into the store ──")
(def conn
  (datom/connect
    [{:db/ident :event/name :db/valueType :db.type/string}
     {:db/ident :event/when :db/valueType :db.type/time}]))
(datom/transact! conn [{:db/id -1 :event/name "design review" :event/when #o"2026-06-15T10/2026-06-15T11"}])
(show "stored from a literal:"
      (first (first (datom/q '[:find ?w :where [?e :event/when ?w]] (datom/db conn)))))

;; ── the payoff: a bad literal fails where you wrote it ──────────────
;;
;; This is the whole reason to read at compile time rather than parse at
;; runtime. #o"2026-13-99" is not a value — month 13, day 99 don't exist.
;; Because read-iso8601 is a macro that validates against the calendar,
;; this is a READ ERROR pointing at THIS line — not a nil that surfaces
;; three joins away pretending to be a missed lookup (the exact hazard
;; examples/typing/01_check_demo.bl is about).

(heading "── a malformed literal is a read-time error ──")
(println "  #o\"2026-13-99\"  → read error at THIS position:")
(println "    \"month 13 is out of range for the Gregorian calendar\"")
(println "  not a runtime nil, not a surprise in a downstream join.")

(heading "── what to take away ──")
(println "  #o is #d pointed at time: a data-reader that runs the ISO 8601-2")
(println "  grammar at read time, into the packed value of 02, checked where")
(println "  you wrote it. Next (04): comparing two intervals — Allen's algebra,")
(println "  as a predicate AND as a join.")
