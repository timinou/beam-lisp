; examples/datom/time/06-bitemporal.bl — two axes of time on one entity:
; when a fact is TRUE, and when we LEARNED it.
; Run: mix beam_lisp.run --path priv examples/datom/time/06-bitemporal.bl
;
; ── Start from the problem ────────────────────────────────────────────
;
; This is the demo that justifies the NAME. datom.time already owns one
; temporal axis — TRANSACTION time: as-of / since / history answer "what
; did the database KNOW, and when?" (priv/datom/time.bl, "the database
; remembers"). Every fact carries the t at which it was recorded, so you
; can rewind the store to any past belief.
;
; Tempo owns the OTHER axis — VALID time: the interval [from,to) answers
; "when is the fact TRUE IN THE WORLD?" A reign held from 978 to 1016
; regardless of when a scribe wrote it down.
;
; These are the two axes of a BITEMPORAL store (the temporal-database
; consensus tempo cites — Jensen & Dyreson's chronon). Neither library has
; both: tempo has valid time but no store to rewind; datom has transaction
; time but no interval to reason over. Put tempo's interval INTO datom.time
; and one entity carries both — which lets you ask a question neither can
; alone: "what did we believe LAST TUESDAY about when the reign HELD?"
;
;   transaction axis:  (datom.time/as-of db last-tuesday)   ← existing
;   valid axis:        (datom.time/overlaps? reign window)  ← this design
;
; A correction on Wednesday to the reign's dates does not rewrite history:
; the Tuesday belief is still there, and the two axes are independent
; coordinates on the same fact.

(ns example.datom.time.bitemporal
  (:require [datom] [datom.time :as time]))

(defn- show [label v] (println (str "  " label "  " (pr-str v))))
(defn- heading [t] (println (str "\n" t)))

;; ── a fact with a VALID-time span, recorded at a TRANSACTION time ────
;;
;; :reign/span is an interval (valid time). The transaction that asserts it
;; stamps it with a t (transaction time). Two axes, one datom.

(heading "── record a reign (valid span) at a moment (tx time) ──")
(def conn
  (datom/connect
    [{:db/ident :reign/of   :db/valueType :db.type/string}
     {:db/ident :reign/span :db/valueType :db.type/time}
     {:db/ident :audit/by   :db/valueType :db.type/string}]))

;; Tuesday: a scribe records the reign as 978–1014 (they had it slightly
;; wrong — we'll correct it Wednesday).
(def tue
  (datom/transact! conn [{:db/id -1 :reign/of "Aethelred" :reign/span #o"978/1014"}
                         {:db/id :db/current-tx :audit/by "scribe-tuesday"}]))
(def r (get (:tempids tue) -1))

;; Wednesday: a correction. The reign actually held until 1016. This does
;; NOT overwrite Tuesday's datom — it appends a retraction + a new
;; assertion, both stamped Wednesday.
(def wed
  (datom/transact! conn [[:db/add r :reign/span #o"978/1016"]
                         {:db/id :db/current-tx :audit/by "scribe-wednesday"}]))

;; ── the VALID axis: does the reign overlap a query window? ──────────
;;
;; Read the current db and ask a valid-time question: did the reign overlap
; the year 1015? Against today's belief (corrected to 1016), yes.

(heading "── valid axis: does the reign overlap 1015? (current belief) ──")
(def db (datom/db conn))
(show "reign span now:        " (:reign/span (datom/entity db r)))   ; #o"978/1016"
(show "overlaps 1015?         " (time/overlaps? (:reign/span (datom/entity db r)) #o"1015"))  ; true

;; ── the TRANSACTION axis: what did we believe on TUESDAY? ───────────
;;
;; Rewind the store to Tuesday's basis with as-of. The correction had not
;; happened yet, so the reign still reads 978–1014 — and the SAME valid-
;; time question now answers differently, because our BELIEF was different.

(heading "── transaction axis: rewind to Tuesday's belief ──")
(def db-tue (datom.time/as-of db (:tx tue)))
(show "reign span as-of Tuesday:" (:reign/span (datom/entity db-tue r)))  ; #o"978/1014"
(show "overlaps 1015? (Tuesday):" (time/overlaps? (:reign/span (datom/entity db-tue r)) #o"1015"))  ; false!

;; ── the bitemporal query: BOTH axes at once ─────────────────────────
;;
;; This is the sentence neither library can express alone. "As of what we
;; believed on Tuesday, did the reign hold during 1015?" — a transaction-
;; time rewind wrapping a valid-time predicate, on one entity.

(heading "── both axes: 'as of Tuesday, did the reign hold in 1015?' ──")
(show "answer:"
      (-> db
          (datom.time/as-of (:tx tue))                    ; transaction axis
          (datom/entity r)
          :reign/span
          (time/overlaps? #o"1015")))                     ; valid axis  => false

(show "and as of Wednesday's correction:"
      (-> db
          (datom.time/as-of (:tx wed))
          (datom/entity r)
          :reign/span
          (time/overlaps? #o"1015")))                     ; => true

;; ── history keeps BOTH stories ──────────────────────────────────────
;;
;; The correction did not erase Tuesday. Over history, the reign's span has
;; had two values — each attributed to the scribe who recorded it. Valid
;; time (the span) and transaction time (who/when) are independent
;; coordinates, and the audit trail is a query, not a subsystem.

(heading "── history: every belief, attributed ──")
(show "every recorded span, by scribe:"
      (datom/q '[:find ?span ?who
                 :where [?e :reign/span ?span ?tx]
                        [?tx :audit/by ?who]]
               (datom.time/history db)))
;; => ([#o"978/1014" "scribe-tuesday"] [#o"978/1016" "scribe-wednesday"])

(heading "── what to take away ──")
(println "  One entity, two temporal axes: valid time (the interval) and")
(println "  transaction time (the store's t). The same valid-time question")
(println "  answers differently depending on which past BELIEF you rewind to.")
(println "  That is the bitemporal query neither tempo nor datom has alone —")
(println "  and the reason maximalist tempo IS the second axis of datom.time.")
(println "  Next (07): what happens when the valid-time span itself is uncertain.")
