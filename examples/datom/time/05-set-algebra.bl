; examples/datom/time/05-set-algebra.bl — free time is the day minus the
; meetings, and that is a query with 'not'.
; Run: mix beam_lisp.run --path priv examples/datom/time/05-set-algebra.bl
;
; ── Start from the problem ────────────────────────────────────────────
;
; A calendar's core question is set-shaped: "when am I free?" is
; work-hours MINUS the meetings. Tempo answers it with %Tempo.IntervalSet{}
; — a sorted, non-overlapping, coalesced set with union / intersection /
; complement / difference, built (its README says) on "the same sweep-line
; algorithms" as PostgreSQL multiranges. That is real machinery someone
; had to write and prove: associativity of union, [a,b)++[b,c)==[a,c),
; distribution of intersection over union.
;
; With one representation there is nothing to write. A set of intervals is
; a set of VALUES in the store (02), and the set operations are the
; operations a database already HAS:
;
;   difference   →  a query with not-join   ("the day, minus the busy spans")
;   intersection →  a join                  ("both a and b cover this")
;   union        →  the store's own set semantics (coalesced on read)
;
; And the laws are not re-proved — they are INHERITED. You do not re-derive
; that join distributes over union; it is the query engine's invariant
; already. That is the difference between building an algebra and borrowing
; one. The bonus: metadata (a meeting's title, its location) is just more
; attributes on the interval entity, so it RIDES THROUGH the operation —
; "which meetings are in work hours" falls out of the same join.

(ns example.datom.time.set-algebra
  (:require [datom]
            [datom.time :as time]
            [optics :as o]))

(defn- show [label v] (println (str "  " label "  " (pr-str v))))
(defn- heading [t] (println (str "\n" t)))

;; ── a schedule is just datoms ───────────────────────────────────────
;;
;; No IntervalSet type. The meetings are entities with an interval-valued
;; :meeting/span and whatever metadata travels with them. The "set" is the
;; result of a query, coalesced by the store, not a bespoke structure.

(heading "── a schedule, as ordinary datoms ──")
(def conn
  (datom/connect
    [{:db/ident :work/span      :db/valueType :db.type/time}
     {:db/ident :meeting/title  :db/valueType :db.type/string}
     {:db/ident :meeting/where  :db/valueType :db.type/string}
     {:db/ident :meeting/span   :db/valueType :db.type/time}]))

(datom/transact! conn
  [{:db/id -1 :work/span #time"2026-06-15T09/2026-06-15T17"}
   {:db/id -2 :meeting/title "design review" :meeting/where "Room 101" :meeting/span #time"2026-06-15T10/2026-06-15T11"}
   {:db/id -3 :meeting/title "1:1 with Ada"  :meeting/where "Room 204" :meeting/span #time"2026-06-15T14/2026-06-15T15"}])
(def db (datom/db conn))

;; ── DIFFERENCE: free = work-hours minus busy ────────────────────────
;;
;; The day, minus every interval that overlaps a meeting. The store hands
;; you the window and the busy spans as values; time/subtract clips one
;; free span by one busy span (0, 1 or 2 pieces), and folding it over the
;; busy set leaves the gaps. No sweep-line code — subtract IS the sweep.
;; (The query-embedded `not-join` spelling is the same result computed
;; inside the engine; it is the next build in §3.)

(heading "── difference: free time = the day minus the meetings ──")
;; The window, then every busy span, come straight from the store as
;; values. subtract-all folds time/subtract over them: each busy span
;; clips the free set, and what survives is the gaps. The difference
;; operator is time/subtract (§value-level); the store hands it the spans.
(def window (first (first (datom/q '[:find ?w :where [_ :work/span ?w]] db))))
(def busy   (map first (datom/q '[:find ?s :where [?m :meeting/span ?s]] db)))
(defn- subtract-all [frees b]
  (mapcat (fn [f] (time/subtract f b)) frees))
(show "free windows:" (reduce subtract-all [window] busy))
;; => the three gaps: [09,10) [11,14) [15,17)

;; ── INTERSECTION is a join, and metadata RIDES the join ─────────────
;;
;; "Which meetings fall in the morning block?" is the morning window joined
;; with the meeting spans via the :~overlaps edge (04). Crucially, the
;; meeting's :title and :where come back TOO — not because the algebra was
;; taught to carry them, but because they are attributes on the same
;; entity, and a join returns whatever you ask for. Tempo's "metadata that
;; travels through set operations" is, here, just how joins work.

(heading "── intersection: which meetings are in the morning, with metadata ──")
;; The morning window is a literal bound by `let` in a predicate clause;
;; `overlaps?` keeps only the meetings that meet it, and :title + :where
;; ride along because they are attributes on the same entity — a join
;; returns whatever you ask for. That is tempo's "metadata travels through
;; set operations", here just how joins work.
(show "morning meetings (title + room ride along):"
      (datom/q '[:find ?title ?where
                 :in $ ?morning
                 :where [?m :meeting/span ?s]
                        [(datom.time/overlaps? ?s ?morning)]
                        [?m :meeting/title ?title]
                        [?m :meeting/where ?where]]
               db #time"2026-06-15T09/2026-06-15T12"))
;; => (["design review" "Room 101"])  — the 14:00 1:1 is outside the morning

;; ── pointwise rewrites are optics: clip every span at once ──────────
;;
;; For the value-in-hand case — take a schedule and clip EVERY interval to
;; work hours — priv/optics.bl does the thing update-in cannot spell
;; (examples/optics.bl): rewrite every slot in one traversal. `over` a
;; traversal applies the clip across the whole collection at once.

(heading "── optics: clip every interval to work hours in one traversal ──")
(def raw {:intervals [#time"2026-06-15T08/2026-06-15T10"    ; starts before work
                      #time"2026-06-15T12/2026-06-15T13"
                      #time"2026-06-15T16/2026-06-15T19"]}) ; ends after work
(def work #time"2026-06-15T09/2026-06-15T17")
(show "clipped to [09,17):"
      (o/over (o/*> (o/in :intervals) o/traversed)
              (fn [iv] (time/intersect iv work))
              raw))
;; => the first clipped to 09, the last clipped to 17, the middle untouched

;; ── the laws are inherited, not re-proved ───────────────────────────
;;
;; Adjacent intervals concatenate: [a,b) ++ [b,c) == [a,c). In tempo this
;; is a theorem about IntervalSet. Here it is the store's set semantics —
;; the same invariant that makes a datom query's result a coalesced set.
;; Nothing to prove; it was already true.

(heading "── adjacency concatenates (a store invariant, free) ──")
(show "[09,12) ++ [12,17) == [09,17):"
      (= (time/union #time"2026-06-15T09/2026-06-15T12"
                     #time"2026-06-15T12/2026-06-15T17")
         #time"2026-06-15T09/2026-06-15T17"))

(heading "── what to take away ──")
(println "  There is no IntervalSet type: a set of intervals is a set of")
(println "  store values. Difference is not-join, intersection is a join,")
(println "  metadata rides the join, and the algebraic laws are inherited")
(println "  from the query engine. Next (06): the payoff of living in")
(println "  datom.time — asking a valid-time question AS OF a past belief.")
