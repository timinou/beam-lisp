; examples/datom/01-facts.bl — the datom, and why five fields.
; Run: mix beam_lisp.run --path priv examples/datom/01-facts.bl
;
; ── Start from the problem ────────────────────────────────────────────
;
; A row in a table is a STRUCTURE. To record that Ada is 36 you must
; first decide that people have ages, make a column for it, and give
; every other person that column too — even the ones you know nothing
; about. Change your mind and you migrate.
;
; Worse: when Ada's age changes, the row is OVERWRITTEN. The fact that
; she was 36 is not moved somewhere else; it stops having ever existed.
; If you want it back you need a second system — an audit table, a
; trigger, a change-data-capture pipeline — that duplicates your schema
; and drifts from it.
;
; A datom is the other choice: record the FACT, not the shape.

(ns example.datom.facts (:require [datom]))

(defn- show [label value] (println (str "  " label "  " (pr-str value))))
(defn- heading [text] (println (str "\n" text)))

;; ── A fact has five parts ───────────────────────────────────────────
;;
;;   [entity  attribute  value  transaction  added?]
;;
;; "Entity 1's :person/name is \"Ada\", recorded by transaction 1000001,
;;  and it is an assertion rather than a retraction."
;;
;; The last two are what make this different from a key/value store. The
;; transaction says WHEN, and `added?` says whether the fact began or
;; ended — so the database can answer questions about change, not just
;; about current state.

(heading "── a database, and one fact in it ──")

(def conn
  (datom/connect
    [{:db/ident :person/name :db/valueType :db.type/string}
     {:db/ident :person/age :db/valueType :db.type/long}
     {:db/ident :person/nickname :db/valueType :db.type/string}]))

(def report (datom/transact! conn [{:db/id -1 :person/name "Ada" :person/age 36}]))
(def ada (get (:tempids report) -1))

(show "the entity id we got:" ada)
(show "what we recorded:    " (mapv (fn [d] [(datom/datom-e d) (datom/datom-a d)
                                             (datom/datom-v d) (datom/datom-added? d)])
                                    (:tx-datoms report)))

;; Two things worth noticing.
;;
;; The `:db/id -1` was a TEMPID — a placeholder scoped to the
;; transaction. Real ids are the database's business, and the report
;; tells you which one you got.
;;
;; A map is not a row. `{:person/name "Ada" :person/age 36}` became two
;; independent facts, and the transaction recorded a third about ITSELF
;; (when it happened). Nothing forces those facts to travel together.

(heading "── adding an attribute touches nothing else ──")

(datom/transact! conn [[:db/add ada :person/nickname "the Countess"]])

(show "Ada now:" (datom/entity (datom/db conn) ada))

;; There was no migration, and no other entity acquired a nickname
;; column, because there is no column. An entity is just whichever
;; datoms happen to share an id.

(def report-2 (datom/transact! conn [{:db/id -1 :person/name "Alan"}]))
(show "Alan has no age or nickname:"
      (datom/entity (datom/db conn) (get (:tempids report-2) -1)))

;; ── Changing a fact does not erase it ───────────────────────────────

(heading "── a change is an ending and a beginning ──")

(def birthday (datom/transact! conn [[:db/add ada :person/age 37]]))

(show "the transaction recorded:"
      (mapv (fn [d] [(datom/datom-a d) (datom/datom-v d)
                     (if (datom/datom-added? d) :asserted :RETRACTED)])
            (filterv (fn [d] (= :person/age (datom/datom-a d)))
                     (:tx-datoms birthday))))

;; TWO datoms, not one. Setting the age to 37 first RETRACTED 36. Both
;; carry the same transaction id, which is what makes the change atomic
;; — there is no moment at which Ada has two ages or none.
;;
;; And 36 is still there. It is marked as no longer true, which is a
;; different thing from being deleted:

(show "current age:" (:person/age (datom/entity (datom/db conn) ada)))
(show "every age she has had:"
      (mapv (fn [c] [(:value c) (if (:added c) :began :ended)])
            (datom/changes (datom/db conn) ada :person/age)))

;; ── Retraction is not deletion ──────────────────────────────────────

(heading "── retracting the nickname ──")

(datom/transact! conn [[:db/retract ada :person/nickname "the Countess"]])

(show "gone from the present:" (:person/nickname (datom/entity (datom/db conn) ada)))
(show "but it is in the record:"
      (mapv (fn [c] [(:value c) (if (:added c) :began :ended)])
            (datom/changes (datom/db conn) ada :person/nickname)))

;; This is the whole idea, in one line: the database remembers that
;; something STOPPED being true, and when. A row that was UPDATE'd
;; remembers nothing.

;; ── Facts about facts ───────────────────────────────────────────────

(heading "── who changed it, and when ──")

;; A transaction is an entity, so it can carry facts of its own.

(datom/install-schema! conn [{:db/ident :audit/by :db/valueType :db.type/string}])

(def audited
  (datom/transact! conn [[:db/add ada :person/age 38]
                         {:db/id :db/current-tx :audit/by "alice"}]))

(def db (datom/db conn))

(show "the transaction knows when it ran:"
      (some? (:db/txInstant (datom/entity db (:tx audited)))))

;; And a query can walk from a fact to the change that made it true, and
;; from there to whoever made it. A fourth term in a pattern binds the
;; transaction.

(show "who set Ada's age to 38:"
      (datom/q '[:find ?who
                 :where [?e :person/age 38 ?tx]
                        [?tx :audit/by ?who]]
               db))

;; There is no audit table here, and no trigger. The audit trail is what
;; the data model already was, once the transaction became addressable.

(heading "── what to take away ──")
(println "  A datom is a fact, not a row: [e a v tx added?]")
(println "  Adding an attribute is not a migration")
(println "  A change is a retraction plus an assertion, atomically")
(println "  Nothing is deleted, so history needs no separate machinery")
(println "  Transactions are entities, so changes can be annotated")
(println "\n  Next: 02-queries.bl — asking questions of facts")
