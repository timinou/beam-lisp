; examples/datom/09-migrations.bl — evolving a schema without breaking it.
; Run: mix beam_lisp.run --path priv examples/datom/09-migrations.bl
;
; ── The one hard problem in schema change ─────────────────────────────
;
; Adding an attribute is free — no existing datom mentions it, so nothing
; can break. The dangerous changes are the ones that TIGHTEN an
; invariant: "email is now unique", "role is now single-valued". Whether
; such a change is safe is not a fact about the schema. It is a fact about
; the DATA. "Email is unique" is fine on a database where emails happen to
; be unique and a corruption on one where they are not.
;
; And the database that decides is PRODUCTION — whose data shapes your
; laptop has never seen. A migration that passes every local test can
; still break against the one database that matters.
;
; `datom.migrate` answers this with three moves, each resting on a
; primitive the earlier examples did not have:
;
;   plan   — walk ANY database (a local db, or a production replica) and
;            report what would break, committing nothing. Rests on the
;            database being a VALUE.
;   apply! — remediate the data, re-check, then grow the schema and record
;            the migration as ONE atomic transaction. Rests on `:db/fn`
;            transaction functions and `with`.
;   the ledger is a QUERY, not a side table.

(ns example.datom.migrations (:require [datom] [datom.migrate]))

(defn- show [label value] (println (str "  " label "  " (pr-str value))))
(defn- heading [text] (println (str "\n" text)))
(defn- note [text] (println (str "  · " text)))

;; ── two databases: clean local, messy production ────────────────────
;;
;; Same schema. `local` is what you develop against; `prod` carries shapes
;; local has never had — a duplicated email across two people, and one
;; person with two roles.

(def base-schema
  [{:db/ident :person/name  :db/valueType :db.type/string}
   {:db/ident :person/email :db/valueType :db.type/string}
   {:db/ident :person/role  :db/valueType :db.type/keyword
    :db/cardinality :db.cardinality/many}])

(def local (datom/connect base-schema))
(datom/transact! local
  [{:db/id -1 :person/name "Ada"   :person/email "ada@x"   :person/role :admin}
   {:db/id -2 :person/name "Grace" :person/email "grace@x" :person/role :user}])

(def prod (datom/connect base-schema))
(datom/transact! prod
  [{:db/id -1 :person/name "Ada"    :person/email "ada@x"    :person/role :admin}
   {:db/id -2 :person/name "Grace"  :person/email "grace@x"  :person/role :user}
   ; the shapes that only exist in production:
   {:db/id -3 :person/name "Alan"   :person/email "dup@x"    :person/role :user}
   {:db/id -4 :person/name "Edsger" :person/email "dup@x"    :person/role [:user :admin]}])

;; ── the migration: ONE value ────────────────────────────────────────
;;
;; It carries its schema deltas (:grows), the invariants they tighten
;; (:checks), and the remediation that makes those invariants true (:fn).
;; The fn is built from the library's remediation helpers — pure functions
;; of a db value that return the retractions which fix each invariant.

(def tighten
  {:migration/id :2026-08-26-tighten-identity
   :migration/grows
     [{:db/ident :person/email :db/valueType :db.type/string
       :db/unique :db.unique/identity}
      {:db/ident :person/role :db/valueType :db.type/keyword
       :db/cardinality :db.cardinality/one}]
   :migration/checks
     [{:check :unique :attr :person/email}
      {:check :cardinality-one :attr :person/role}]
   :migration/fn
     (fn [db]
       (into (datom.migrate/dedup-unique db :person/email)
             (datom.migrate/collapse-cardinality-one db :person/role)))})

;; ── plan: the same migration, against two databases ─────────────────

(heading "── plan(local): clean ──")
(show "status:  " (get (datom.migrate/plan (datom/db local) tighten) :status))
(note "nothing local violates the new invariants")

(heading "── plan(prod): breaking, with the offending entities named ──")
(def prod-plan (datom.migrate/plan (datom/db prod) tighten))
(show "status:  " (get prod-plan :status))
(show "breaking:" (get prod-plan :breaking))
(note "these shapes exist only in production; local could never surface them")
(note "plan takes a db VALUE — point it at a prod replica and this is your")
(note "deploy gate: a breaking migration is known before anything ships")

;; ── plan commits nothing ────────────────────────────────────────────

(heading "── plan mutated nothing ──")
(show "prod still has the duplicate:"
      (count (datom/q '[:find ?e :where [?e :person/email "dup@x"]] (datom/db prod))))

;; ── apply to local: fn is a no-op, schema grows, ledger stamped ─────

(heading "── apply! to LOCAL (already conforms) ──")
(show "status:     " (get (datom.migrate/apply! local tighten) :status))
(show "applied ids:" (datom.migrate/applied-ids (datom/db local)))

;; ── apply to prod: fn remediates first, atomically ──────────────────

(heading "── apply! to PROD (remediates, then grows, in one transaction) ──")
(def prod-report (datom.migrate/apply! prod tighten))
(show "status:    " (get prod-report :status))
(show "remediated:" (get prod-report :remediated))
(show "dup@x now held by:"
      (count (datom/q '[:find ?e :where [?e :person/email "dup@x"]] (datom/db prod))))
(note "the duplicate email and the extra role were retracted BEFORE the")
(note "invariants were enforced — and it all committed as one transaction")

;; ── the whole migration is ONE transaction (atomicity) ──────────────

(heading "── atomicity: remediation and stamp share one tx ──")
(def stamp-tx
  (get (first (datom/q '[:find ?tx
                         :where [?m :migration/id :2026-08-26-tighten-identity ?tx]]
                       (datom/db prod))) 0))
(show "migration recorded at tx:" stamp-tx)
(show "and apply! reported tx:  " (get prod-report :tx))
(note "same tx — the data fix and the record of it can never disagree")

;; ── idempotence: re-applying is a no-op ─────────────────────────────

(heading "── idempotence ──")
(show "apply! again:" (get (datom.migrate/apply! prod tighten) :status))

;; ── post-migration, the invariants actually bite ────────────────────

(heading "── enforcement is real after the migration ──")
(datom/transact! prod [{:db/id -9 :person/email "ada@x" :person/name "Ada again"}])
(show "asserting an existing email UPSERTS (identity), still one holder:"
      (count (datom/q '[:find ?e :where [?e :person/email "ada@x"]] (datom/db prod))))

;; ── a migration whose remediation is insufficient is REFUSED ────────
;;
;; The gate: if the fn does not fully fix the invariant, apply! commits
;; nothing and returns :blocked with the residual violations.

(heading "── the gate: an under-remediating migration is blocked ──")
(def messy (datom/connect base-schema))
(datom/transact! messy [{:db/id -1 :person/email "d@x"} {:db/id -2 :person/email "d@x"}])
(def bad
  {:migration/id :bad
   :migration/grows [{:db/ident :person/email :db/valueType :db.type/string
                      :db/unique :db.unique/identity}]
   :migration/checks [{:check :unique :attr :person/email}]
   :migration/fn (fn [db] [])})   ; remediates nothing
(def bad-report (datom.migrate/apply! messy bad))
(show "status:  " (get bad-report :status))
(show "breaking:" (get bad-report :breaking))
(show "recorded?" (contains? (datom.migrate/applied-ids (datom/db messy)) :bad))
(note "the migration author's data assumption was wrong — refused, not")
(note "corrupted, with the offending value named")

;; ── what to take away ───────────────────────────────────────────────

(heading "── what to take away ──")
(println "  A migration is one value: schema deltas, invariants, remediation")
(println "  plan walks a db VALUE — including production — and commits nothing")
(println "  apply! remediates, re-checks, grows and records as ONE transaction")
(println "  the ledger is a query; applying twice is a no-op")
(println "  an under-remediating migration is refused, not applied halfway")
(println "\n  This rests on two primitives the earlier examples lacked:")
(println "  `with` (speculative transaction) and `:db/fn` (transaction")
(println "  functions) — see 10-with-efficiency.bl and 11-txfn-efficiency.bl")
(println "  for how each works and what it costs.")
