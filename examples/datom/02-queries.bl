; examples/datom/02-queries.bl — queries are data, and joins are free.
; Run: mix beam_lisp.run --path priv examples/datom/02-queries.bl
;
; ── The problem with query strings ────────────────────────────────────
;
; SQL is text. A program that builds a query builds a STRING, which means
; escaping, injection, and a compiler that cannot help you. Composing two
; queries means concatenating fragments and hoping.
;
; A datalog query here is a VECTOR. You can build it with `conj`, store
; it in a variable, pass it to a function, generate it from a form. It is
; data all the way down, which is the same reason transaction data is
; data: there is only one kind of thing in this system.
;
; ── And the other problem: joins ──────────────────────────────────────
;
; In SQL a join is a construction — you name the tables, the keys, and
; the direction. In datalog a join is what happens when two clauses SHARE
; A VARIABLE. That is the whole mechanism.

(ns example.datom.queries (:require [datom]))

(defn- show [label value] (println (str "  " label "  " (pr-str value))))
(defn- heading [text] (println (str "\n" text)))

(def conn
  (datom/connect
    [{:db/ident :person/name :db/valueType :db.type/string}
     {:db/ident :person/age :db/valueType :db.type/long}
     {:db/ident :person/city :db/valueType :db.type/string}
     {:db/ident :person/email :db/valueType :db.type/string
      :db/unique :db.unique/identity}
     {:db/ident :person/friend :db/valueType :db.type/ref
      :db/cardinality :db.cardinality/many}]))

(datom/transact! conn
  [{:db/id -1 :person/name "Ada" :person/age 36 :person/city "London"
    :person/email "ada@example.com"}
   {:db/id -2 :person/name "Grace" :person/age 45 :person/city "New York"
    :person/email "grace@example.com"}
   {:db/id -3 :person/name "Alan" :person/age 41 :person/city "London"
    :person/email "alan@example.com" :person/friend [-1 -2]}
   {:db/id -4 :person/name "Edsger" :person/age 52 :person/city "Austin"
    :person/email "edsger@example.com" :person/friend [-1]}])

(def db (datom/db conn))

;; ── A pattern is a fact with holes in it ────────────────────────────

(heading "── patterns ──")

;; `[?e :person/name ?name]` reads: "for every datom whose attribute is
;; :person/name, call its entity ?e and its value ?name". A variable is
;; a hole; a constant is a constraint.

(show "everyone:" (datom/q '[:find ?name :where [?e :person/name ?name]] db))

(show "people in London:"
      (datom/q '[:find ?name
                 :where [?e :person/city "London"]
                        [?e :person/name ?name]]
               db))

;; Two clauses. They share `?e`, so they JOIN: the same entity must
;; satisfy both. Nobody wrote a join.

(heading "── the join is the shared variable ──")

(show "who lives where:"
      (datom/q '[:find ?name ?city
                 :where [?e :person/name ?name]
                        [?e :person/city ?city]]
               db))

;; Follow a reference by sharing the variable across the ref:

(show "Alan's friends:"
      (datom/q '[:find ?friend-name
                 :where [?e :person/name "Alan"]
                        [?e :person/friend ?f]
                        [?f :person/name ?friend-name]]
               db))

;; `?f` is bound as a VALUE in one clause and as an ENTITY in the next.
;; That is all a graph traversal is here.

(heading "── backwards is the same query ──")

;; Nothing about the data privileges one direction. To ask who considers
;; Ada a friend, share the variable the other way around:

(show "who counts Ada as a friend:"
      (datom/q '[:find ?name
                 :where [?ada :person/name "Ada"]
                        [?e :person/friend ?ada]
                        [?e :person/name ?name]]
               db))

;; In SQL this is a different query with a different join direction. Here
;; the only change is which position the variable appears in.

;; ── Predicates filter, functions compute ───────────────────────────

(heading "── predicates and functions ──")

(show "over 40:"
      (datom/q '[:find ?name ?age
                 :where [?e :person/name ?name]
                        [?e :person/age ?age]
                        [(> ?age 40)]]
               db))

;; A predicate `[(> ?age 40)]` filters. A function `[(* ?age 2) ?double]`
;; BINDS a new variable — computed values enter the query without a
;; round trip.

(show "age doubled:"
      (datom/q '[:find ?name ?double
                 :where [?e :person/name ?name]
                        [?e :person/age ?age]
                        [(* ?age 2) ?double]]
               db))

;; ── Passing values in ───────────────────────────────────────────────

(heading "── :in, four ways ──")

;; A query is data, so parameters do not need string interpolation.

(show "one value:"
      (datom/q '[:find ?name :in $ ?city
                 :where [?e :person/city ?city] [?e :person/name ?name]]
               db "London"))

;; `[?x ...]` takes MANY values — this is how you write `IN (...)`:

(show "several values (IN):"
      (datom/q '[:find ?name :in $ [?city ...]
                 :where [?e :person/city ?city] [?e :person/name ?name]]
               db ["London" "Austin"]))

;; `[[?x ?y]]` takes a whole TABLE. This is how a query joins against
;; data the database does not hold — ids from another service, rows from
;; a CSV, the results of a previous query:

(show "joining an external table:"
      (datom/q '[:find ?name ?label :in $ [[?city ?label]]
                 :where [?e :person/city ?city] [?e :person/name ?name]]
               db [["London" "UK"] ["Austin" "US"]]))

;; ── Logic ───────────────────────────────────────────────────────────

(heading "── or, not, and their -join forms ──")

(show "in London or Austin:"
      (datom/q '[:find ?name
                 :where [?e :person/name ?name]
                        [:or [?e :person/city "London"]
                             [?e :person/city "Austin"]]]
               db))

(show "nobody's friend:"
      (datom/q '[:find ?name
                 :where [?e :person/name ?name]
                        [:not-join [?e] [?other :person/friend ?e]]]
               db))

;; `not-join` names which variables connect to the outer query; `?other`
;; stays local. Plain `:not` would need `?other` bound already, which is
;; impossible — the whole question is whether such an entity EXISTS.

(heading "── aggregates ──")

(show "how many people:" (datom/q '[:find (count ?e) :where [?e :person/name ?n]] db))
(show "average age:     " (datom/q '[:find (avg ?age) :where [?e :person/age ?age]] db))

;; Group by putting a variable beside the aggregate:

(show "count per city:"
      (datom/q '[:find ?city (count ?e)
                 :where [?e :person/city ?city] [?e :person/name ?n]]
               db))

;; ── Queries are values ──────────────────────────────────────────────

(heading "── building a query at runtime ──")

;; Because a query is a vector, a program can construct one. No string
;; assembly, no escaping, no injection: the parts are data and stay data.

(defn- people-where
  "A query for people matching one attribute/value pair."
  [attr value]
  [:find '?name
   :where ['?e attr value]
          ['?e :person/name '?name]])

(show "generated for city:" (datom/q (people-where :person/city "London") db))
(show "generated for age: " (datom/q (people-where :person/age 45) db))

;; The same function produced two different queries. In a string-based
;; language this is where injection bugs live.

(heading "── what to take away ──")
(println "  A pattern is a fact with holes; a variable is a hole")
(println "  A join is two clauses sharing a variable — nothing more")
(println "  Direction is not a property of the data, only of the query")
(println "  :in passes values, collections, tuples, or whole tables")
(println "  A query is a VECTOR, so programs can build queries safely")
(println "\n  Next: 03-time.bl — the database remembers")
