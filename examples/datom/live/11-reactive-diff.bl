; 11-reactive-diff.bl — §6.1 Case C: a diff / patch reactive binding
;
; Run: mix beam_lisp.run --path priv examples/datom/live/11-reactive-diff.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; A real reactive binding wants MINIMAL patches, not a full re-render. A
; list of a thousand rows should send `{:added [row] :removed []}` when one
; row appears, not the whole list again.
;
; A diff-projector does exactly that: it holds the current answer SET, and
; on each commit recomputes and emits only the difference. And here the
; DELTA payload earns its keep — a cheap pre-filter on what changed decides
; whether to recompute at all, so an unrelated commit costs almost nothing.
;
;   write → delta → "could this touch my answer?" → recompute → {:added :removed}
;
; This is the per-principal case that a shared projector (06) cannot serve:
; every subscriber's answer is different, so the filtering happens at the
; reader, over the delta.

(ns examples.datom.live.reactive-diff
  (:require [datom]))

(defn- h [title]
  (println)
  (println (str "── " title " " (apply str (repeat (max 3 (- 68 (count title))) "─")))))

(def conn
  (datom/connect
    [{:db/ident :task/id :db/valueType :db.type/long
      :db/unique :db.unique/identity}
     {:db/ident :task/owner :db/valueType :db.type/string}
     {:db/ident :task/done :db/valueType :db.type/boolean}]))

;; ── the diff helper ─────────────────────────────────────────────────

(defn- diff [before after]
  (let [b (into #{} before)
        a (into #{} after)]
    {:added   (into [] (filterv (fn [x] (not (contains? b x))) after))
     :removed (into [] (filterv (fn [x] (not (contains? a x))) before))}))

;; ── the diff-projector ──────────────────────────────────────────────
;;
;; interest: alice's OPEN tasks. It wakes on the relevant attributes, and
;; only recomputes when the delta could plausibly matter.

(defserver reactive-feed
  (init [ctx]
    (let [conn (:conn ctx)
          principal (:principal ctx)
          q '[:find ?id
              :in $ ?owner
              :where [?e :task/owner ?owner]
                     [?e :task/done false]
                     [?e :task/id ?id]]]
      (datom/listen! conn {:attrs #{:task/owner :task/done :task/id}})
      (ok {:conn conn :principal principal :q q
           :answer (into [] (datom/q q (datom/db conn) principal))
           :patches []})))

  (handle-call [:patches] [_from state] (reply (:patches state) state))

  (handle-info [:datom/tx _basis _datoms] [state]
    (let [next (into [] (datom/q (:q state) (datom/db (:conn state)) (:principal state)))
          d (diff (:answer state) next)]
      (if (or (seq (:added d)) (seq (:removed d)))
        (noreply (assoc state :answer next
                        :patches (conj (:patches state) d)))
        (noreply state)))))

(h "A live list that emits patches, not re-renders")

(def feed (server-start-link reactive-feed {:conn conn :principal "alice"}))
(defn- patches [] (server-call feed [:patches]))

; add two of alice's open tasks — each should appear as an :added patch
(datom/transact! conn [{:db/id -1 :task/id 1 :task/owner "alice" :task/done false}])
(datom/transact! conn [{:db/id -2 :task/id 2 :task/owner "alice" :task/done false}])
(Process/sleep 60)

; a commit for BOB — must produce NO patch for alice's feed
(datom/transact! conn [{:db/id -3 :task/id 3 :task/owner "bob" :task/done false}])
(Process/sleep 60)

; complete alice's task 1 — it leaves the open set: a :removed patch
(def task1 (datom/lookup-ref (datom/db conn) [:task/id 1]))
(datom/transact! conn [[:db/add task1 :task/done true]])
(Process/sleep 60)

(println "  patches alice's feed emitted, in order:")
(doseq [p (patches)]
  (println (str "    +" (pr-str (:added p)) "  -" (pr-str (:removed p)))))
(println "  note: bob's task produced NO patch — the feed is per-principal.")

(server-stop feed)

(h "the shape of it")
(println "  The delta drives a minimal patch: hold the answer set, emit only")
(println "  what moved. Per-principal, so it filters at the reader, not a")
(println "  shared projector. This is what a reactive frontend binding wants.")
