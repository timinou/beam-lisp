; 09-semantic-feed.bl — a changefeed that understands "similar" (semantic)
;
; Run: mix beam_lisp.run --path priv examples/datom/live/09-semantic-feed.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; "Notify me when something written is semantically NEAR this query vector."
; That is a live query whose filter is `similar-to` — and it works because
; of the same two-mode trick the hybrid query uses (examples/semantic/03):
;
;   FREE ?e  → GENERATE the k nearest (ordinary search)
;   BOUND ?e → FILTER: score only the entities upstream clauses selected
;
; In a watch, the "entities upstream" are the ones THIS COMMIT touched. So a
; semantic feed scores only what just changed — never the whole corpus. And
; because embeddings are ordinary datoms read through the db value's basis,
; the feed time-travels for free: the same clause, run `as-of` last week,
; sees last week's corpus.
;
; This example builds vectors by hand (three axes) so it runs offline under
; `--path priv`; a real deployment swaps in a model embedder unchanged.

(ns examples.datom.live.semantic-feed
  (:require [datom] [datom.vector]))

(defn- h [title]
  (println)
  (println (str "── " title " " (apply str (repeat (max 3 (- 68 (count title))) "─")))))

(def conn
  (datom/connect
    [{:db/ident :note/id :db/valueType :db.type/long
      :db/unique :db.unique/identity}
     {:db/ident :note/text :db/valueType :db.type/string}
     {:db/ident :note/embedding :db/valueType :db.type/vector}]))

;; three toy topic axes: [work home money]. A note points mostly along one.
(defn- vec-for [work home money] (datom.vector/embedding [work home money]))

;; ── a corpus already present, mostly unrelated to our interest ──────

(def seed-report
  (datom/transact! conn
    [{:db/id -1 :note/id 1 :note/text "adopted a kitten"        :note/embedding (vec-for 0.0 1.0 0.0)}
     {:db/id -2 :note/id 2 :note/text "refinanced the mortgage" :note/embedding (vec-for 0.0 0.0 1.0)}]))

; the basis right after the two seed notes — captured, not guessed
(def t-seed (:tx seed-report))

;; ── the semantic watch: near "work stress" (the work axis) ──────────

(h "A changefeed for notes near a query vector")

(def parent (erlang/self))
(def query-vec (vec-for 1.0 0.0 0.0))     ; the "work" direction

(def w
  (datom/watch conn
    '[:find ?e ?score
      :in $ ?q
      :where [?e :note/embedding _]
             [(similar-to :note/embedding ?q 5) [?e ?score]]]
    [query-vec]
    (fn [d]
      (doseq [row (:added d)]
        (erlang/send parent [:near (first row) (second row)])))))

(Process/sleep 30)

; the feed fires on any commit that touches an embedding (similar-to with
; k=5 scores whatever changed); the SCORE is the signal — high for a work
; note, near-zero for a home note.
(defn- report [label ms]
  (receive
    [:near e score]
      (println (str "  " label " → entity " e
                    " scored " (Float/round (* score 100.0)) "%"
                    (if (> score 0.5) "  ← a genuine neighbour" "  (barely related)")))
    (after ms
      (println (str "  " label " → no embedding changed")))))

;; a HOME note — orthogonal to the work axis; it fires but scores ~0%
(datom/transact! conn [{:db/id -3 :note/id 3 :note/text "walked the dog"
                        :note/embedding (vec-for 0.0 1.0 0.0)}])
(report "wrote a home note" 500)

;; a WORK note — near the query vector; scores ~99%
(datom/transact! conn [{:db/id -4 :note/id 4 :note/text "burned out after overtime"
                        :note/embedding (vec-for 1.0 0.1 0.05)}])
(report "wrote a work note" 1000)

(datom/unwatch w)

;; ── time-travel: the same clause over a past basis ──────────────────
;;
;; Because the corpus is datoms read at a basis, a semantic query as-of an
;; earlier point sees only what existed then — no separate vector index to
;; keep in sync.

(h "The same similarity, as-of the past")

(println (str "  work-nearest as-of basis " t-seed " (only the first 2 notes existed):"))
(println (str "    "
              (pr-str (sort (datom/q '[:find ?id ?score
                                       :in $ ?q
                                       :where [?e :note/embedding _]
                                              [(similar-to :note/embedding ?q 5) [?e ?score]]
                                              [?e :note/id ?id]]
                                     (datom/as-of (datom/db conn) t-seed) query-vec)))))
(println "  note 4 (the work note) is ABSENT — it did not exist at that basis.")

(h "the shape of it")
(println "  A semantic feed is a watch whose filter is similar-to. It scores")
(println "  only what changed (bound-?e), and time-travels for free — because")
(println "  an embedding is just a fact read at a basis.")
