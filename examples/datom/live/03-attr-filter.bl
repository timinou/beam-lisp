; 03-attr-filter.bl — wake only for the attributes you care about
;
; Run: mix beam_lisp.run --path priv examples/datom/live/03-attr-filter.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; A busy database commits constantly, and most commits are none of your
; business. `listen!` with `{:attrs #{…}}` is the cheapest filter (tier
; T0): the writer wakes you ONLY when a commit touches one of your
; attributes. It is a set-membership test over what changed — no query
; engine, no pattern matching, just "did this commit touch :order/status?"
;
; This is the 90% case: "tell me when an order's status changes," and
; nothing else.

(ns examples.datom.live.attr-filter
  (:require [datom]))

(defn- h [title]
  (println)
  (println (str "── " title " " (apply str (repeat (max 3 (- 68 (count title))) "─")))))

(def conn
  (datom/connect
    [{:db/ident :order/id :db/valueType :db.type/long
      :db/unique :db.unique/identity}
     {:db/ident :order/status :db/valueType :db.type/keyword}
     {:db/ident :order/total :db/valueType :db.type/long}]))

;; ── subscribe to :order/status only ─────────────────────────────────

(h "Subscribed to :order/status — deaf to everything else")

(datom/listen! conn {:attrs #{:order/status}})

;; helper: did a message arrive within `ms`?
(defn- heard? [ms]
  (receive
    [:datom/tx _basis tx-datoms] {:woke true :datoms tx-datoms}
    (after ms {:woke false})))

;; ── 1. a commit touching only :order/total does NOT wake us ─────────

(datom/transact! conn [{:db/id -1 :order/id 1 :order/total 50}])
(let [r (heard? 300)]
  (println (str "  wrote :order/total only  → woke? " (:woke r)
                "   (want false)")))

;; ── 2. a commit touching :order/status DOES wake us ─────────────────

(datom/transact! conn [{:db/id -2 :order/id 2 :order/status :shipped}])
(let [r (heard? 2000)]
  (println (str "  wrote :order/status      → woke? " (:woke r)
                "    (want true)"))
  (when (:woke r)
    (let [s (first (filterv (fn [d] (= :order/status (datom/datom-a d))) (:datoms r)))]
      (println (str "    and the delta carried :order/status = " (pr-str (datom/datom-v s)))))))

;; ── 3. an unfiltered listener hears everything ──────────────────────
;;
;; A subscriber with no :attrs wakes on every commit — the filter is
;; opt-in, and "no filter" means "all commits."

(h "No filter means every commit")

(datom/unlisten! conn)
(datom/listen! conn)   ; no :attrs
(datom/transact! conn [{:db/id -3 :order/id 3 :order/total 99}])
(let [r (heard? 2000)]
  (println (str "  unfiltered, wrote :order/total → woke? " (:woke r)
                "   (want true)")))

(h "the shape of it")
(println "  The cheapest subscription is a set membership test on what")
(println "  changed. It reads the delta's attributes, nothing more.")
