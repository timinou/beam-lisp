; 07-pattern-watch.bl — a live query on a pattern (T1)
;
; Run: mix beam_lisp.run --path priv examples/datom/live/07-pattern-watch.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; L2's `listen!` wakes you on EVERY commit; you filter in your own code.
; `watch` moves the filter DOWN: give it a pattern of interest, and it fires
; only when a commit writes a datom that matches. "Tell me when any order
; becomes :shipped" is one line, and an unrelated commit costs you nothing —
; the matcher runs against the delta, not the store.
;
; And the matcher is not new. It is `query.engine/unify-pattern` — the SAME
; function the datalog engine uses to match one clause against one datom. A
; T1 watch and the equivalent query agree by construction, because they run
; the same code. No second engine to drift.

(ns examples.datom.live.pattern-watch
  (:require [datom]))

(defn- h [title]
  (println)
  (println (str "── " title " " (apply str (repeat (max 3 (- 68 (count title))) "─")))))

(def conn
  (datom/connect
    [{:db/ident :order/id :db/valueType :db.type/long
      :db/unique :db.unique/identity}
     {:db/ident :order/status :db/valueType :db.type/keyword}]))

;; ── watch for orders becoming :shipped ──────────────────────────────

(h "A watch that fires only on [?e :order/status :shipped]")

(def parent (erlang/self))

; the callback runs in the WATCH's process; we forward a summary to `parent`
; so the linear script below can observe it.
(def w
  (datom/watch conn '[?e :order/status :shipped]
    (fn [changes]
      (doseq [c changes]
        (erlang/send parent [:shipped (:e c) (:added c)])))))

(Process/sleep 30)

; helper: report what (if anything) the watch delivered within `ms`
(defn- report [label ms]
  (receive
    [:shipped e added]
      (println (str "  " label " → watch fired: entity " e
                    (if added " shipped" " (shipped retracted)")))
    (after ms
      (println (str "  " label " → watch stayed silent")))))

;; a :pending order — must NOT fire
(datom/transact! conn [{:db/id -1 :order/id 1 :order/status :pending}])
(report "wrote :pending" 300)

;; a :shipped order — MUST fire, with the entity
(datom/transact! conn [{:db/id -2 :order/id 2 :order/status :shipped}])
(report "wrote :shipped" 1000)

;; ── a retraction fires too ──────────────────────────────────────────
;;
;; Changing a shipped order's status RETRACTS :shipped. The watch sees the
;; retraction — a live query must know when something LEAVES its set, not
;; only when it enters.

(h "Leaving the set fires the watch too")

(def order2 (datom/lookup-ref (datom/db conn) [:order/id 2]))
(datom/transact! conn [[:db/add order2 :order/status :delivered]])
(report "order 2 → :delivered" 1000)

(datom/unwatch w)

(h "the shape of it")
(println "  A pattern watch reuses the engine's own matcher against the")
(println "  delta. Precise interest, no re-query, assertions AND retractions.")
