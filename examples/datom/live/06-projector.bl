; 06-projector.bl — compute a shared view once, fan out to many
;
; Run: mix beam_lisp.run --path priv examples/datom/live/06-projector.bl
;
; ── The problem ───────────────────────────────────────────────────────
;
; Ten thousand people watch one public leaderboard. You do NOT want ten
; thousand processes each re-deriving it on every commit, and you MUST NOT
; push a rendered board out of the writer — the writer is blind to who is
; asking, and a projection is a function of (data, who is asking).
;
; The answer is a PROJECTOR: one subscriber that computes the shared view
; ONCE per commit and re-broadcasts the finished board to every identical
; viewer. Note where it sits: it is a *subscriber*, downstream of the
; writer, that CHOSE to fix (query, principal = "the public"). That is why
; it may put a projection on the wire when the writer may not — it is not
; guessing an audience, it is serving one it defined.
;
; ── The distinction that matters ──────────────────────────────────────
;
;   writer   → emits FACTS (the delta). Never a projection. It cannot know
;              whose board to render.
;   projector → a subscriber that emits a PROJECTION, legitimately, for a
;              view it fixed. Compute once; fan out.
;
; Per-principal feeds (where every viewer sees something different) have no
; single projection to share, so they cannot use this — they filter at the
; reader instead (see 11-reactive-diff). Public shared views should.

(ns examples.datom.live.projector
  (:require [datom]))

(defn- h [title]
  (println)
  (println (str "── " title " " (apply str (repeat (max 3 (- 68 (count title))) "─")))))

;; ── a self-contained Phoenix.PubSub, so the example needs no web app ──
;;
;; In a real system SpellWeb.PubSub already runs in the supervision tree;
;; here we start our own so the file is runnable on its own. Swapping this
;; for the app's PubSub — or a Redis-backed one for cross-region — is a
;; config change, not a code change: the projector only knows "broadcast
;; to a topic."

(def PubSub (erlang/binary_to_atom "Elixir.Phoenix.PubSub"))

(Supervisor/start_link
  (list (erlang/list_to_tuple
          (list PubSub (list (erlang/list_to_tuple (list :name :demo-pubsub))))))
  (list (erlang/list_to_tuple (list :strategy :one_for_one))))

(def conn
  (datom/connect
    [{:db/ident :player/name :db/valueType :db.type/string
      :db/unique :db.unique/identity}
     {:db/ident :player/points :db/valueType :db.type/long}]))

;; ── the projector: subscribe, compute once, re-broadcast ────────────

(defserver leaderboard-projector
  (init [conn]
    (do (datom/listen! conn {:attrs #{:player/points}})
        (ok conn)))

  (handle-info [:datom/tx _basis _datoms] [conn]
    (let [board (datom/q '[:find ?name ?pts
                           :where [?e :player/name ?name]
                                  [?e :player/points ?pts]]
                         (datom/db conn))
          ; the shared view, computed ONCE for every identical viewer
          ranked (reverse (sort-by second (into [] board)))]
      (Phoenix.PubSub/broadcast :demo-pubsub "leaderboard" [:board ranked])
      (noreply conn))))

;; ── many viewers, all subscribed to the same finished board ─────────

(h "Three viewers, one computed board")

(def projector (server-start-link leaderboard-projector conn))

; each "viewer" is a process that subscribes to the leaderboard topic and
; prints whatever finished board arrives — it does no querying itself.
(def parent (erlang/self))
(defn- viewer [id]
  (erlang/spawn
    (fn []
      (Phoenix.PubSub/subscribe :demo-pubsub "leaderboard")
      (erlang/send parent [:ready id])
      (receive
        [:board ranked]
          (erlang/send parent [:saw id ranked])
        (after 3000 (erlang/send parent [:saw id :timeout]))))))

(def viewers (to-list (map viewer [1 2 3])))
; wait for all three to be subscribed before we transact
(doseq [_ viewers] (receive [:ready _] :ok (after 2000 :ok)))

; one write → the projector computes once → all three viewers get the board
(datom/transact! conn [{:db/id -1 :player/name "Ada"  :player/points 40}
                       {:db/id -2 :player/name "Grace" :player/points 55}
                       {:db/id -3 :player/name "Alan"  :player/points 30}])

(doseq [_ viewers]
  (receive
    [:saw id ranked]
      (println (str "  viewer " id " received: " (pr-str ranked)))
    (after 3000 (println "  (a viewer timed out)"))))

(server-stop projector)

(h "the shape of it")
(println "  The writer never rendered a board. A projector — a subscriber")
(println "  that fixed the query and the audience — computed it once and")
(println "  fanned it out. One derivation, N identical viewers.")
