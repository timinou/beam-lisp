; 12-derived-fact.bl — §6.1 Case D: derived state is a FACT, not a projection
;
; Run: mix beam_lisp.run --path priv examples/datom/live/12-derived-fact.bl
;
; ── The boundary line ─────────────────────────────────────────────────
;
; Sometimes the frontend wants to bind to a value that is a FUNCTION of
; other facts: an order's total is the sum of its line items. It is
; tempting to "project it at write" — have the writer compute the total and
; broadcast it. Don't. The writer emits facts, and a per-viewer computed
; value is a projection.
;
; The right move is to record the derived value AS A FACT, with a
; transaction function. A tx-fn runs against the before-value and splices
; its datoms into the SAME atomic commit. So the total becomes an ordinary
; datom — and then it flows through the delta, is watchable, filterable, and
; time-travellable exactly like any hand-written fact. Zero special-casing
; downstream.
;
;   derived-at-write  → a FACT the writer records   (this file)
;   derived-per-viewer → a PROJECTION the reader computes (10, 11)
;
; That is the whole distinction.

(ns examples.datom.live.derived-fact
  (:require [datom]))

(defn- h [title]
  (println)
  (println (str "── " title " " (apply str (repeat (max 3 (- 68 (count title))) "─")))))

(def conn
  (datom/connect
    [{:db/ident :order/id :db/valueType :db.type/long
      :db/unique :db.unique/identity}
     {:db/ident :order/item :db/valueType :db.type/long
      :db/cardinality :db.cardinality/many}
     {:db/ident :order/total :db/valueType :db.type/long}]))

;; ── a tx-fn that derives the total from the items ───────────────────
;;
;; It reads the order's items in the before-value, sums them, and returns a
;; datom asserting :order/total. That datom commits atomically with whatever
;; else the transaction carries.

(datom/register-tx-fn! :recalc-total
  (fn [db order]
    (let [items (datom/q '[:find ?v :in $ ?o :where [?o :order/item ?v]] db order)
          total (reduce + 0 (map first items))]
      [[:db/add order :order/total total]])))

;; ── a subscriber that just watches the delta ────────────────────────
;;
;; It knows nothing about "totals being derived." It sees :order/total move
;; like any other fact — which is the point.

(datom/listen! conn {:attrs #{:order/total}})

(h "The total arrives as a fact, through the ordinary delta")

; create an order with two items. A tx-fn runs against the BEFORE-value, so
; it can only sum items already committed — we add the items, then recalc in
; the next transaction. (Folding both into one commit would sum only the
; items that existed BEFORE it, which is a useful subtlety to know.)
(datom/transact! conn [{:db/id -1 :order/id 1 :order/item 30}])
(def order1 (datom/lookup-ref (datom/db conn) [:order/id 1]))
(datom/transact! conn [[:db/add order1 :order/item 12]])

; now recalc: the tx-fn sees both items (30, 12) in the before-value
(datom/transact! conn [[:db/fn :recalc-total order1]])

(receive
  [:datom/tx _basis tx-datoms]
    (let [total (first (filterv (fn [d] (= :order/total (datom/datom-a d))) tx-datoms))]
      (when total
        (println (str "  the subscriber saw :order/total = "
                      (pr-str (datom/datom-v total))
                      "  (derived: 30 + 12)"))))
  (after 2000 (println "  (timed out)")))

; add another item, then re-derive — the new total flows the same way
(datom/transact! conn [[:db/add order1 :order/item 8]])
(datom/transact! conn [[:db/fn :recalc-total order1]])
(receive
  [:datom/tx _basis tx-datoms]
    (let [total (first (filterv (fn [d] (and (= :order/total (datom/datom-a d))
                                             (datom/datom-added? d)))
                                tx-datoms))]
      (when total
        (println (str "  after adding an item, :order/total = "
                      (pr-str (datom/datom-v total)) "  (30 + 12 + 8)"))))
  (after 2000 (println "  (timed out)")))

; and it is queryable/time-travellable like any fact — because it IS one
(println (str "  queried from the current db: :order/total = "
              (pr-str (datom/q '[:find ?t :where [?e :order/total ?t]]
                               (datom/db conn)))))

(h "the shape of it")
(println "  The writer recorded a derived value as a FACT, not a view. So it")
(println "  broadcasts, filters, queries and time-travels with zero special")
(println "  handling. The writer emits facts (even derived ones); readers project.")
