; 04-replay-gap.bl — a dropped message is never a lost event
;
; Run: mix beam_lisp.run --path priv examples/datom/live/04-replay-gap.bl
;
; ── The guarantee that beats raw messaging ────────────────────────────
;
; Raw BEAM `send` is at-most-once: drop a message and it is gone. datom's
; broadcast rides on `send` too — but over a DURABLE, ORDERED log, and
; that changes everything. Every payload carries the new basis, so a
; subscriber can always tell whether it fell behind, and the log can
; always reconstruct what it missed.
;
;   broadcast = an accelerator (fast, best-effort)
;   the log   = the truth (durable, replayable)
;
; A missed message degrades to a slightly slower read — `(since db t)`
; from the last confirmed point — never a lost event. That is
; effectively-exactly-once delivery, which raw `send` cannot give you.

(ns examples.datom.live.replay-gap
  (:require [datom]))

(defn- h [title]
  (println)
  (println (str "── " title " " (apply str (repeat (max 3 (- 68 (count title))) "─")))))

(def conn
  (datom/connect
    [{:db/ident :order/id :db/valueType :db.type/long
      :db/unique :db.unique/identity}
     {:db/ident :order/status :db/valueType :db.type/keyword}]))

;; ── a subscriber that remembers its last confirmed basis ────────────

(h "A subscriber falls behind, then catches up from the log")

; commit one BEFORE subscribing — the subscriber will never see this via
; the stream; it is the "already confirmed" watermark.
(datom/transact! conn [{:db/id -1 :order/id 1 :order/status :pending}])
(def t0 (datom/basis-t (datom/db conn)))
(println (str "  last confirmed basis: " t0 "  (entity 1 already seen)"))

(datom/listen! conn)

; three more commits arrive
(datom/transact! conn [{:db/id -2 :order/id 2 :order/status :pending}])
(datom/transact! conn [{:db/id -3 :order/id 3 :order/status :shipped}])
(datom/transact! conn [{:db/id -4 :order/id 4 :order/status :shipped}])

;; ── simulate a DROP: read only the LAST delta, discard the rest ─────
;;
;; A real subscriber might crash, GC-pause, or overflow its mailbox and
;; miss messages. Here we deliberately read only the newest, then notice
;; the basis jumped far past t0.

; drain everything currently in the mailbox, keeping the highest basis seen
(defn- drain [acc]
  (receive
    [:datom/tx basis _datoms] (drain (max acc basis))
    (after 100 acc)))

(def newest-seen (drain 0))
(println (str "  newest basis the subscriber actually observed: " newest-seen))
(println (str "  but it processed them out of order / dropped some — so it"))
(println (str "  does NOT trust its incremental state. It replays instead."))

;; ── reconstruct the gap straight from the log ───────────────────────
;;
;; `(since db t0)` is every datom committed after t0 — exactly what the
;; subscriber missed, whether it saw the messages or not.

(h "Replay: (since db t0) reconstructs everything after the watermark")

(def recovered (datom/since (datom/db conn) t0))
(def ids (datom/q '[:find ?id :where [?e :order/id ?id]] recovered))

(println (str "  entities recovered after t0: " (pr-str (sort (map first ids)))))
(println (str "  entity 1 (before t0) excluded? " (not (contains? ids [1]))
              "   (want true — no double-count)"))

(h "the shape of it")
(println "  The broadcast is best-effort; the log is durable and ordered.")
(println "  A gap is detectable (the basis) and recoverable (`since`), so")
(println "  delivery is effectively exactly-once — stronger than raw send.")
