; 01-listen-delta.bl — the database learns to say "it changed"
;
; Run: mix beam_lisp.run --path priv examples/datom/live/01-listen-delta.bl
;
; ── The one primitive datom lacked ────────────────────────────────────
;
; A datom database already keeps a durable, totally-ordered log of facts
; and lets any process hold a consistent VALUE of it for free. The only
; thing it could not do was tell you it had changed. `listen!` adds that:
; subscribe, and every commit lands in your mailbox.
;
; The payload is the DELTA — the exact datoms the commit wrote, `[e a v tx
; op]`. Not a basis you must re-query, not a rendered view: the facts
; themselves. So the reader filters what changed with NO second trip to
; the store. That is the whole point of a delta-by-default design.

(ns examples.datom.live.listen-delta
  (:require [datom]))

(defn- h [title]
  (println)
  (println (str "── " title " " (apply str (repeat (max 3 (- 68 (count title))) "─")))))

(def conn
  (datom/connect
    [{:db/ident :order/id :db/valueType :db.type/long
      :db/unique :db.unique/identity}
     {:db/ident :order/status :db/valueType :db.type/keyword}]))

;; ── 1. subscribe, then transact ─────────────────────────────────────
;;
;; `listen!` subscribes the CALLING process. From here on, any commit on
;; this connection is delivered to our mailbox as
;; `[:datom/tx basis tx-datoms]`.

(h "1. A commit arrives in the mailbox")

(datom/listen! conn)

(datom/transact! conn [{:db/id -1 :order/id 1 :order/status :pending}])

;; ── 2. read the delta — no re-query ─────────────────────────────────
;;
;; The datoms are already in hand. We ask each one what it says with the
;; datom accessors; the store is never touched.

(receive
  [:datom/tx basis tx-datoms]
    (do (println (str "  a commit landed at basis " basis))
        (println (str "  it wrote " (count tx-datoms) " datoms:"))
        (doseq [d tx-datoms]
          (println (str "    [" (datom/datom-e d) " " (datom/datom-a d)
                        " " (pr-str (datom/datom-v d))
                        (if (datom/datom-added? d) "" " RETRACTED") "]"))))
  (after 2000 (println "  (timed out — no commit?)")))

;; ── 3. a change is an assertion AND a retraction ────────────────────
;;
;; Nothing is ever overwritten. Changing :order/status appends a
;; retraction of the old value and an assertion of the new one — and the
;; delta shows you both, so a subscriber sees exactly what moved.

(h "2. A change shows the retraction and the assertion")

; A lookup ref reads fine but is not yet accepted in transaction entity
; position (FEAT-015), so resolve the entity id first, then assert onto it.
(def order1 (datom/lookup-ref (datom/db conn) [:order/id 1]))
(datom/transact! conn [[:db/add order1 :order/status :shipped]])

(receive
  [:datom/tx _basis tx-datoms]
    (doseq [d tx-datoms]
      (when (= :order/status (datom/datom-a d))
        (println (str "    :order/status → " (pr-str (datom/datom-v d))
                      (if (datom/datom-added? d) "  (asserted)" "  (retracted)")))))
  (after 2000 (println "  (timed out)")))

(h "the shape of it")
(println "  A commit is a message. The log is the topic. The delta is the")
(println "  payload — the facts themselves, so the reader never re-queries.")
