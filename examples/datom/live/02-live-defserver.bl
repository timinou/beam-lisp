; 02-live-defserver.bl — a GenServer whose state stays live
;
; Run: mix beam_lisp.run --path priv examples/datom/live/02-live-defserver.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; 08-otp showed a GenServer whose state IS a database value — queryable,
; supervisable, recoverable. But its value was frozen at the moment it was
; captured: the server answered questions about a world that had moved on.
;
; `listen!` closes that gap. A server subscribes in `init`, and each
; `[:datom/tx …]` in `handle-info` adopts the new value. Its state is now
; a LIVE db value: always the latest, still immutable, still O(1) to hold.
;
; This is the canonical shape — a process whose state tracks the database
; — and it is three lines: subscribe, then `noreply` the new value.

(ns examples.datom.live.live-defserver
  (:require [datom]))

(defn- h [title]
  (println)
  (println (str "── " title " " (apply str (repeat (max 3 (- 68 (count title))) "─")))))

(def conn
  (datom/connect
    [{:db/ident :order/id :db/valueType :db.type/long
      :db/unique :db.unique/identity}
     {:db/ident :order/status :db/valueType :db.type/keyword}]))

;; ── a server whose state is a live db value ─────────────────────────
;;
;; It subscribes in `init` and re-reads the connection on every commit.
;; Because a db value is O(1) and shares the store, adopting the latest
;; costs nothing — there is no data to copy.

(defserver order-view
  (init [conn]
    (do (datom/listen! conn)
        (ok {:conn conn :db (datom/db conn)})))

  ; a query call answers from whatever value the state currently holds
  (handle-call [:count-shipped] [_from state]
    (reply (datom/q '[:find (count ?e) :where [?e :order/status :shipped]]
                    (:db state))
           state))

  ; the world moved — adopt the new value. No re-query needed to update
  ; state; the next query call will see the fresh db.
  (handle-info [:datom/tx _basis _datoms] [state]
    (noreply (assoc state :db (datom/db (:conn state))))))

(h "A server that tracks the database")

(def view (server-start-link order-view conn))

(defn- shipped [] (server-call view [:count-shipped]))

(println (str "  at start:           " (pr-str (shipped))))

(datom/transact! conn [{:db/id -1 :order/id 1 :order/status :shipped}])
(datom/transact! conn [{:db/id -2 :order/id 2 :order/status :pending}])
(datom/transact! conn [{:db/id -3 :order/id 3 :order/status :shipped}])
(Process/sleep 100)   ; let the info messages be processed

(println (str "  after three writes: " (pr-str (shipped))))
(println "  the server never re-subscribed and never polled — its state")
(println "  simply follows the log, one commit at a time.")

(server-stop view)

(h "the shape of it")
(println "  A db value as GenServer state was already the pattern. `listen!`")
(println "  makes it LIVE: `handle-info` adopts the latest world, for free.")
