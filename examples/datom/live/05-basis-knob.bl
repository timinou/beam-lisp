; 05-basis-knob.bl — when a coordinate beats the delta
;
; Run: mix beam_lisp.run --path priv examples/datom/live/05-basis-knob.bl
;
; ── The knob ──────────────────────────────────────────────────────────
;
; The default payload is the DELTA — the datoms themselves — because it
; is query-free for the reader. But sometimes you do NOT want the datoms:
;
;   * a HUGE write (10⁶ datoms) you would rather not copy into a mailbox
;   * a subscriber that re-derives a complex view from `as-of` anyway, so
;     the individual datoms are noise it would discard
;
; For those, `{:payload :basis}` sends a COORDINATE instead:
; `[:datom/changed basis changed-attrs]` — the new basis plus the set of
; attributes that moved. The reader reconstructs the value it needs with
; `(as-of db basis)` and runs its own query. This is the LiveView shape:
; a page re-renders its whole assign and diffs the DOM, so a coordinate is
; all it ever needed.
;
; It is a knob, not a default: reach for it when the delta is the wrong
; size, not as a habit.

(ns examples.datom.live.basis-knob
  (:require [datom]))

(defn- h [title]
  (println)
  (println (str "── " title " " (apply str (repeat (max 3 (- 68 (count title))) "─")))))

(def conn
  (datom/connect
    [{:db/ident :order/id :db/valueType :db.type/long
      :db/unique :db.unique/identity}
     {:db/ident :order/status :db/valueType :db.type/keyword}]))

;; ── subscribe for coordinates, not datoms ───────────────────────────

(h "A basis subscriber gets a coordinate, then re-derives")

(datom/listen! conn {:payload :basis})

(datom/transact! conn [{:db/id -1 :order/id 1 :order/status :shipped}])

(receive
  ; note the shape: :datom/changed, not :datom/tx, and NO datoms
  [:datom/changed basis changed-attrs]
    (do
      (println (str "  the world moved to basis " basis))
      (println (str "  attributes that changed: " (pr-str changed-attrs)))
      (println "  (no datoms in the payload — this subscriber re-derives)")
      ;; reconstruct the value at that coordinate and run our own query
      (let [db (datom/as-of (datom/db conn) basis)
            shipped (datom/q '[:find (count ?e)
                               :where [?e :order/status :shipped]] db)]
        (println (str "  re-derived: shipped count at basis " basis
                      " = " (pr-str shipped)))))
  [:datom/tx _ _]
    (println "  ERROR: got a delta; expected a basis coordinate")
  (after 2000 (println "  (timed out)")))

;; ── the changed-attrs set excludes txInstant noise ──────────────────
;;
;; Every transaction writes a :db/txInstant self-datom. The changed-attrs
;; set omits it, so it never spuriously wakes an attribute filter.

(h "changed-attrs is clean")

(datom/transact! conn [{:db/id -2 :order/id 2 :order/status :pending}])
(receive
  [:datom/changed _basis attrs]
    (println (str "  changed-attrs: " (pr-str attrs)
                  "   (no :db/txInstant)"))
  (after 2000 (println "  (timed out)")))

(h "the shape of it")
(println "  Delta by default; basis by knob. A coordinate is right when the")
(println "  reader will re-derive anyway — the LiveView case FEAT-016 was")
(println "  written for. The writer still emits a fact, never a projection.")
