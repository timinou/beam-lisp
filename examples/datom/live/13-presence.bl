; 13-presence.bl — §6.1 Case E: a presence binding beside a datom feed
;
; Run: mix beam_lisp.run --path priv examples/datom/live/13-presence.bl
;
; ── Two different substrates on one page ──────────────────────────────
;
; A collaborative page answers two live questions at once:
;
;   "what is the data?"      → the datom feed (this whole folder)
;   "who else is here?"      → PRESENCE — replicated membership
;
; They are NOT the same mechanism, and forcing them together would be a
; mistake. The data feed is a durable, ordered LOG. Presence is ephemeral,
; convergent STATE: when a viewer's process dies, they are simply gone, and
; no log should remember a cursor position forever. That is a CRDT's job,
; not a database's.
;
; The native BEAM membership primitive is `:pg` (process groups): join a
; group, and `get_members` is the live set — a member that dies leaves
; automatically. `Phoenix.Presence` is the richer upgrade: the same
; membership, PLUS per-member metadata (name, cursor) replicated across the
; cluster as a CRDT. This example uses `:pg` so it is self-contained; the
; upgrade to `Phoenix.Presence` is a swap of the same shape.
;
; The point: the two bindings COMPOSE on one page, each on the substrate
; that fits it.

(ns examples.datom.live.presence
  (:require [datom]))

(defn- h [title]
  (println)
  (println (str "── " title " " (apply str (repeat (max 3 (- 68 (count title))) "─")))))

;; ── the data substrate: an ordinary datom feed ──────────────────────

(def conn
  (datom/connect
    [{:db/ident :doc/id :db/valueType :db.type/long
      :db/unique :db.unique/identity}
     {:db/ident :doc/body :db/valueType :db.type/string}]))

;; ── the presence substrate: a :pg group per document ────────────────

(pg/start_link :presence)

(defn- join-doc [doc-topic who]
  ; a viewer process joins the document's presence group and holds it open
  (erlang/spawn
    (fn []
      (pg/join :presence doc-topic (erlang/self))
      ; also subscribe to the DATA feed, to prove the two coexist
      (datom/listen! conn {:attrs #{:doc/body}})
      (receive
        :leave :ok
        (after 60000 :ok)))))

(defn- who-is-here [doc-topic]
  (count (pg/get_members :presence doc-topic)))

;; ── the scene ───────────────────────────────────────────────────────

(h "Presence and data, side by side on one document")

(datom/transact! conn [{:db/id -1 :doc/id 42 :doc/body "draft"}])

(println (str "  viewers on doc:42 at start: " (who-is-here "doc:42")))

(def alice (join-doc "doc:42" "alice"))
(def bob   (join-doc "doc:42" "bob"))
(Process/sleep 100)
(println (str "  after alice and bob open it: " (who-is-here "doc:42")
              "   (presence — a membership binding)"))

; the DATA changes independently of who is watching
(def doc42 (datom/lookup-ref (datom/db conn) [:doc/id 42]))
(datom/transact! conn [[:db/add doc42 :doc/body "edited together"]])
(println (str "  the document body is now: "
              (pr-str (datom/q '[:find ?b :where [?e :doc/id 42] [?e :doc/body ?b]]
                               (datom/db conn)))))

; a viewer leaves — presence updates itself, no datom involved
(erlang/send bob :leave)
(Process/sleep 100)
(println (str "  after bob closes the tab: " (who-is-here "doc:42")
              "   (presence shrank — no write, no log entry)"))

; and if a viewer's process simply DIES, presence still updates: membership
; is tied to the process, not to a fact someone must remember to retract.
(erlang/exit alice :kill)
(Process/sleep 100)
(println (str "  after alice's process crashes: " (who-is-here "doc:42")
              "   (gone automatically — ephemeral state, not a durable fact)"))

(h "the shape of it")
(println "  Data is a durable ordered log (datom). Presence is ephemeral")
(println "  convergent membership (:pg here, Phoenix.Presence in a cluster).")
(println "  Different substrates, composed on one page — each where it fits.")
