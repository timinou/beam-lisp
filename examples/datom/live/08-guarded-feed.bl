; 08-guarded-feed.bl — a per-principal live feed (T2a), no leak
;
; Run: mix beam_lisp.run --path priv examples/datom/live/08-guarded-feed.bl
;
; ── The seam ──────────────────────────────────────────────────────────
;
; The most important composition in this whole design: a per-principal live
; feed is `auth/guard` ∘ `datom/watch`. The SAME datalog clause that scopes
; a READ (row-level security) scopes the FEED — one policy language, one
; enforcement point.
;
;   (auth/guard query [(auth/owner-filter '?e :doc/owner principal)])
;
; injects a `:where` clause that keeps only the principal's rows. Injection
; is MONOTONIC: a conjunctive clause can only remove rows, never add one, so
; a guarded feed is INCAPABLE of delivering a fact the guard excludes. That
; is not a runtime check you can forget — it is a property of the query.
;
; So two principals watching the same app query get two disjoint feeds, and
; neither can ever see the other's rows. This example proves it live.

(ns examples.datom.live.guarded-feed
  (:require [datom] [auth]))

(defn- h [title]
  (println)
  (println (str "── " title " " (apply str (repeat (max 3 (- 68 (count title))) "─")))))

(def conn
  (datom/connect
    [{:db/ident :doc/id :db/valueType :db.type/long
      :db/unique :db.unique/identity}
     {:db/ident :doc/owner :db/valueType :db.type/string}
     {:db/ident :doc/title :db/valueType :db.type/string}]))

;; ── one app query, guarded per principal ────────────────────────────
;;
;; The application writes ONE query, innocent of who is asking. `auth/guard`
;; rewrites it for each principal. The watch fires with a {:added :removed}
;; diff whenever that principal's rows change.

(def parent (erlang/self))

(defn- live-feed [principal]
  (let [q (auth/guard '[:find ?id ?title
                        :where [?e :doc/id ?id] [?e :doc/title ?title]]
                      [(auth/owner-filter '?e :doc/owner principal)])]
    (datom/watch conn q
      (fn [d] (erlang/send parent [:feed principal (:added d)])))))

(h "Alice and Bob each watch the same query — disjoint feeds")

(def wa (live-feed "alice"))
(def wb (live-feed "bob"))
(Process/sleep 30)

;; interleaved writes to both owners
(datom/transact! conn [{:db/id -1 :doc/id 1 :doc/owner "alice" :doc/title "Alice's roadmap"}])
(datom/transact! conn [{:db/id -2 :doc/id 2 :doc/owner "bob"   :doc/title "Bob's budget"}])
(datom/transact! conn [{:db/id -3 :doc/id 3 :doc/owner "alice" :doc/title "Alice's notes"}])

;; drain both feeds in one pass (they deliver concurrently)
(defn- drain [ms acc]
  (receive
    [:feed p added]
      (drain ms (assoc acc p (into (or (get acc p) []) (into [] added))))
    (after ms acc)))

(def seen (drain 600 {}))

(println (str "  alice's feed received: " (pr-str (sort (or (get seen "alice") [])))))
(println (str "  bob's feed received:   " (pr-str (sort (or (get seen "bob") [])))))
(println "  each principal saw ONLY their own documents — the guard clause")
(println "  makes a cross-principal leak impossible, not merely unlikely.")

(datom/unwatch wa)
(datom/unwatch wb)

(h "the shape of it")
(println "  auth/guard ∘ datom/watch: security and subscription are ONE")
(println "  datalog. The clause that filters a read filters the live feed,")
(println "  monotonically — a feed can never carry a row its guard excludes.")
