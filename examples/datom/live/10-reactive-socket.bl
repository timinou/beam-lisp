; 10-reactive-socket.bl — §6.1 Case A: a per-socket reactive binding
;
; Run: mix beam_lisp.run --path priv examples/datom/live/10-reactive-socket.bl
;
; ── The canonical frontend case ───────────────────────────────────────
;
; This is what a LiveView page IS: a process, one per connected viewer,
; that mirrors some slice of the database to a browser. Each viewer sees a
; DIFFERENT slice — their own rows, under their own identity — so there is
; no single projection to broadcast. The projection is computed at the
; READER, where "who is asking" is known.
;
; And here the basis payload is not arcane, it is OPTIMAL: a page re-renders
; its whole assign and diffs the DOM anyway, so all it ever needs from the
; write is the coordinate "the world moved to basis T." It reconstructs its
; own view with `(as-of db T)` and its own query.
;
; So: subscribe for a basis, and on each one, re-project THIS viewer's rows.
; That is the whole reactive binding.

(ns examples.datom.live.reactive-socket
  (:require [datom]))

(defn- h [title]
  (println)
  (println (str "── " title " " (apply str (repeat (max 3 (- 68 (count title))) "─")))))

(def conn
  (datom/connect
    [{:db/ident :doc/id :db/valueType :db.type/long
      :db/unique :db.unique/identity}
     {:db/ident :doc/owner :db/valueType :db.type/string}
     {:db/ident :doc/title :db/valueType :db.type/string}]))

;; ── a socket process: one per viewer, holding WHO is asking ─────────
;;
;; The query is scoped to the viewer's own documents. In L3 (PLAN-045)
;; this scoping is `auth/guard`; here we write the owner clause directly to
;; keep the example about the reactive binding, not about auth.

(defserver socket-view
  (init [ctx]
    (let [conn (:conn ctx)
          principal (:principal ctx)]
      (datom/listen! conn {:payload :basis})   ; Case A: a basis is enough
      (ok {:conn conn :principal principal :rows []})))

  (handle-call [:rows] [_from state] (reply (:rows state) state))

  ; the world moved — re-project THIS viewer's slice from the coordinate
  (handle-info [:datom/changed basis _attrs] [state]
    (let [db (datom/as-of (datom/db (:conn state)) basis)
          rows (datom/q '[:find ?id ?title
                          :in $ ?owner
                          :where [?e :doc/owner ?owner]
                                 [?e :doc/id ?id]
                                 [?e :doc/title ?title]]
                        db (:principal state))]
      (noreply (assoc state :rows (into [] rows))))))

(h "Two viewers, two different projections, one write each")

(def alice (server-start-link socket-view {:conn conn :principal "alice"}))
(def bob   (server-start-link socket-view {:conn conn :principal "bob"}))

(defn- rows-of [v] (server-call v [:rows]))

; a document for alice, then one for bob
(datom/transact! conn [{:db/id -1 :doc/id 1 :doc/owner "alice" :doc/title "Alice's plan"}])
(datom/transact! conn [{:db/id -2 :doc/id 2 :doc/owner "bob"   :doc/title "Bob's notes"}])
(Process/sleep 100)   ; let both sockets process their basis messages

(println (str "  alice's socket sees: " (pr-str (rows-of alice))))
(println (str "  bob's socket sees:   " (pr-str (rows-of bob))))
(println "  same coordinate, two projections — each computed at the reader,")
(println "  under its own identity. The writer sent only a basis.")

(server-stop alice)
(server-stop bob)

(h "the shape of it")
(println "  A LiveView page is a reader that re-projects on a coordinate.")
(println "  Basis-only is right here: the page re-renders and diffs anyway.")
