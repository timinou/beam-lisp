; examples/datom/03-time.bl — the database remembers.
; Run: mix beam_lisp.run --path priv examples/datom/03-time.bl
;
; ── The feature everything else was built for ─────────────────────────
;
; Ask a normal database "what did this customer's balance look like last
; Tuesday?" and the honest answer is: gone. The row was UPDATE'd. To get
; it back you needed to have decided, in advance, to keep it — an audit
; table, a trigger, a temporal extension, an event log. Each is a second
; system that duplicates your schema and drifts from it.
;
; Here the question is trivial, and not because time travel was
; implemented. It is trivial because nothing was ever deleted. The past
; is not archived somewhere; it is simply still here, and every datom
; carries the transaction that made it true.
;
; So time travel is a FILTER over data that never went anywhere:
;
;   as-of t    ignore everything after t     -> the world as it was
;   since t    only what changed after t     -> the delta
;   history    every datom, both kinds       -> what changed, and when
;
; That is why `as-of` is O(1) to construct and copies nothing.

(ns example.datom.time (:require [datom]))

(defn- show [label value] (println (str "  " label "  " (pr-str value))))
(defn- heading [text] (println (str "\n" text)))

(def conn
  (datom/connect
    [{:db/ident :account/holder :db/valueType :db.type/string}
     {:db/ident :account/balance :db/valueType :db.type/long}
     {:db/ident :audit/by :db/valueType :db.type/string}
     {:db/ident :audit/reason :db/valueType :db.type/string}]))

;; A small history: an account opened, then three balance changes.

(def opened
  (datom/transact! conn [{:db/id -1 :account/holder "Ada" :account/balance 100}
                         {:db/id :db/current-tx :audit/by "system"
                          :audit/reason "account opened"}]))

(def acct (get (:tempids opened) -1))

(def deposit
  (datom/transact! conn [[:db/add acct :account/balance 250]
                         {:db/id :db/current-tx :audit/by "alice"
                          :audit/reason "deposit"}]))

(def withdrawal
  (datom/transact! conn [[:db/add acct :account/balance 175]
                         {:db/id :db/current-tx :audit/by "bob"
                          :audit/reason "withdrawal"}]))

(def db (datom/db conn))

;; ── The world as it was ─────────────────────────────────────────────

(heading "── as-of: the same question, at three moments ──")

(show "balance now:        " (:account/balance (datom/entity db acct)))
(show "after the deposit:  "
      (:account/balance (datom/entity (datom/as-of db (:tx deposit)) acct)))
(show "when it was opened: "
      (:account/balance (datom/entity (datom/as-of db (:tx opened)) acct)))

;; Note what did NOT happen: no snapshot was restored, no backup was
;; read, no separate history table was consulted. `as-of` returned a
;; value that shares the same storage and differs only in which
;; transaction it reads up to.

(heading "── a historical value is a database value ──")

;; Every operation works against it, unchanged. The query does not know
;; it is looking at the past — there is no `FOR SYSTEM_TIME`, no special
;; syntax, no separate API.

(show "query, at the opening:"
      (datom/q '[:find ?holder ?balance
                 :where [?e :account/holder ?holder]
                        [?e :account/balance ?balance]]
               (datom/as-of db (:tx opened))))

(show "query, now:           "
      (datom/q '[:find ?holder ?balance
                 :where [?e :account/holder ?holder]
                        [?e :account/balance ?balance]]
               db))

(show "pull, at the deposit: "
      (datom/pull (datom/as-of db (:tx deposit)) [:account/balance] acct))

;; ── Following one field through time ────────────────────────────────

(heading "── changes: what a field has been ──")

(show "every balance:"
      (mapv (fn [c] [(:value c) (if (:added c) :began :ended)])
            (datom/changes db acct :account/balance)))

;; Five entries for three values: each change ENDS the old fact and
;; BEGINS the new one. That pairing is what makes the history a record of
;; change rather than a list of states.

(show "when did it become 250:" (datom/tx-of db acct :account/balance 250))
(show "value at the opening:  " (datom/value-at db (:tx opened) acct :account/balance))

;; ── The full audit trail ────────────────────────────────────────────

(heading "── who changed it, and why ──")

;; The transactions carry annotations, and a fourth term in a pattern
;; binds the transaction that recorded a datom. So the trail is a query,
;; not a subsystem:

(show "every balance change, attributed:"
      (datom/q '[:find ?balance ?who ?why
                 :where [?e :account/balance ?balance ?tx]
                        [?tx :audit/by ?who]
                        [?tx :audit/reason ?why]]
               (datom/history db)))

;; Reading over `history` rather than `db` is what makes the SUPERSEDED
;; values visible — the current view holds only what is true now.

(heading "── since: only what changed ──")

(show "datoms after the deposit:"
      (count (datom/datoms (datom/since db (:tx deposit)) :eavt acct)))

;; `as-of` is inclusive and `since` exclusive, so together they partition
;; the record exactly: every datom falls in one half or the other, never
;; both, never neither.

;; ── Why this is cheap ───────────────────────────────────────────────

(heading "── the cost of remembering ──")

;; A historical value shares the store with the present one. Constructing
;; it is a change of parameter, not a copy:

(def past (datom/as-of db (:tx opened)))
(show "same store, different basis:" [(datom/basis-t past) (datom/basis-t db)])

;; This is what "the database is a value" means in practice. You can hold
;; a db from an hour ago as cheaply as holding an integer, pass it to a
;; function, and it will still answer questions about that hour.

(heading "── what history is NOT ──")

;; A history view holds every value an attribute ever had. Asking for it
;; as an ENTITY would fold three balances into one map — a state the
;; account was never in. So it refuses:

(show "entity on a history view:"
      (try (do (datom/entity (datom/history db) acct) :returned-something)
           (catch e :refused)))

;; That is a deliberate choice: a plausible-looking wrong answer is worse
;; than an error, because nothing about it looks wrong.

(heading "── what to take away ──")
(println "  Time travel is a filter, not a feature — nothing was deleted")
(println "  as-of is O(1) and copies nothing: same store, different basis")
(println "  Queries and pull work unchanged against the past")
(println "  changes/tx-of/value-at follow one field through time")
(println "  Annotated transactions make the audit trail a QUERY")
(println "  A history view is not a state, and says so rather than lying")
(println "\n  Next: 04-shapes.bl — pull, and reading trees out of a graph")
