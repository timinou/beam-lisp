; atoms.bl — Clojure's reference types on the BEAM.
; Run: mix beam_lisp.run examples/atoms.bl

(println "== a counter atom, incremented by 10 processes ==")
(def counter (atom 0))
(def n-workers 10)

; Each worker bumps the atom 1000 times, then signals its parent.
(defn bump-and-done [parent]
  (loop [i 0]
    (when (< i 1000)
      (swap! counter inc)
      (recur (inc i))))
  (erlang/send parent :done))

(def parent (erlang/self))
; map is lazy: the spawn side effects only run when the seq is forced, so
; dorun them — a side-effecting map is exactly what Clojure requires you to
; realize explicitly.
(dorun (map (fn [_] (erlang/spawn (fn [] (bump-and-done parent)))) (range n-workers)))

; Wait until every worker has reported back before reading the count.
(loop [remaining n-workers]
  (when (> remaining 0)
    (receive :done (recur (dec remaining)))))
(println (str "final count: " @counter " (expect " (* n-workers 1000) ")"))

(println "== a future computed on the BEAM ==")
(def fut (future (loop [i 0 acc 0]
                   (if (< i 100000)
                     (recur (inc i) (+ acc i))
                     acc))))
(println (str "sum 0..99999 = " (deref fut)))

(println "== a promise handed between two processes ==")
(def p (promise))
(def p-parent (erlang/self))
(def consumer
  (erlang/spawn (fn [] (erlang/send p-parent (str "consumer got: " (deref p))))))
(Process/sleep 50) ; let the consumer block on the promise before we deliver
(deliver p :beam-lisp)
(receive msg (println msg))
