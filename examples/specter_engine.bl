; specter_engine.bl — navigating and transforming nested data with a
; port of Specter's compiled-path engine.
;
; A navigator is a pair of functions in continuation-passing style, and
; a path is navigators composed. That is the whole idea; everything
; below is a consequence of it.

(ns specter.demo
  (:require [specter.navs :refer :all]))

(println "== select: pulling values out ==")

(def data {:name "hq" :people [{:name "ada" :age 36} {:name "grace" :age 45}]})

(println "a key:            " (select [:name] data))
(println "through a vector: " (select [:people ALL :name] data))
(println "empty path:       " (select [] 42))

; Selecting nothing gives you an empty vector — never nil, and never the
; engine's internal sentinel.
(println "nothing matched:  " (select [:people ALL :missing] {}))

(println "")
(println "== filters are just navigators ==")

; A bare function in a path is a predicate. Composed after ALL it keeps
; the elements that satisfy it.
(println "odds:             " (select [ALL odd?] [1 2 3 4 5]))
(println "adults:           " (select [:people ALL (pred* (fn [p] (> (:age p) 40))) :name] data))

(println "")
(println "== select-any stops at the first hit ==")

; This is why the engine threads a continuation rather than building a
; list: a result can short-circuit back out through every layer at once.
; The structure below is infinite, and the search still returns.
(println "first of infinite:" (select-any [ALL] (iterate inc 1)))
(println "first or nil:     " (select-first [ALL] []))

(println "")
(println "== transform: changing what you navigated to, and nothing else ==")

(println "one key:          " (transform [:name] (fn [s] (str s "!")) data))
(println "every element:    " (transform [ALL] inc [1 2 3]))
(println "only the odds:    " (transform [ALL odd?] inc [1 2 3 4]))

; The structure keeps its shape. beam-lisp keeps [] and () structurally
; distinct, so a transformed vector comes back a vector.
(println "still a vector?   " (vector? (transform [ALL] inc [1 2 3])))
(println "a list stays list:" (vector? (transform [ALL] inc (list 1 2 3))))

(println "")
(println "== setval, and the sentinel that removes a key ==")

(println "replace:          " (setval [:name] "HQ" data))

; Setting a value to NONE removes it. This is the one place the engine's
; internal sentinel is deliberately part of the user-facing contract.
(println "remove a key:     " (setval [:name] NONE {:name "hq" :size 3}))

(println "")
(println "== deep composition ==")

; Paths nest: a sub-path is a path, so these two are the same navigator.
(def flat [:people ALL :age])
(def nested [[:people ALL] :age])
(println "flat:             " (select flat data))
(println "nested, same:     " (select nested data))

; And transforms reach as deep as you point them.
(println "everyone ages:    "
         (select [:people ALL :age] (transform [:people ALL :age] inc data)))

(println "")
(println "== srange: a slice as a single value ==")

(println "reverse middle:   " (transform [(srange* 1 3)] reverse [1 2 3 4]))
(println "select the slice: " (select [(srange* 1 3)] [1 2 3 4]))

(println "")
(println "done.")
