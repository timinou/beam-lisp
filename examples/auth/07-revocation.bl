; examples/auth/07-revocation.bl — the honest limit, made a choice.
; Run: mix beam_lisp.run --path priv examples/auth/07-revocation.bl
;
; ── The tension at the heart of offline tokens ────────────────────────
;
; Everything good about capability tokens comes from OFFLINE verification:
; no call home. But that same property fights REVOCATION. To un-grant a
; token immediately, you must check something that changed after it was
; minted — which means calling home. You cannot have instant revocation
; AND zero dependencies at the same time. That is not a flaw in the
; design; it is a real tradeoff in the world.
;
; `auth` refuses to pretend otherwise. Instead of picking for you, it
; makes revocation a PER-CALL choice:
;
;     provide no revocation checker → pure offline. Tokens just expire.
;     provide one                   → the verifier consults it, and a
;                                      revoked token is denied.
;
; Same token, same authorizer; the deployment decides by whether it hands
; in an oracle. This file shows both stances.

(ns example.auth.revocation (:require [auth]))

(defn- show [label value] (println (str "  " label "  " (pr-str value))))
(defn- heading [text] (println (str "\n" text)))

(def root (auth/keypair))
(def root-pub (auth/public root))
(def token (auth/issue root [["user" "alice"] ["right" "doc" "read"]]))

;; a permissive context, reused below; the only thing that changes between
;; the two stances is whether we add a :revocation oracle to it.
(def base {:facts [] :rules [] :checks [] :policies [(auth/allow [])]})

;; ── Stance 1: pure offline (no oracle) ──────────────────────────────
;;
;; With no revocation checker, the verifier never asks "was this revoked?"
;; — it just checks the signature and the logic. This is the most
;; Biscuit-idiomatic stance, correct for short-lived tokens where you lean
;; on expiry instead of a revocation list.

(heading "── offline: no oracle, token is honoured ──")

(show "verdict:" (:verdict (auth/authorize root-pub token (auth/context base))))

;; ── A token's revocation ids ────────────────────────────────────────
;;
;; Every block of a token has a revocation id — which is simply its
;; signature bytes (a signature uniquely identifies a block). To revoke a
;; token you record one of its ids. Revoking a block revokes every token
;; that contains it, including every attenuation derived from it.

(heading "── the token's revocation ids ──")

(def ids (auth/revocation-ids token))

(show "number of ids (one per block):" (count ids))
(show "each is a 64-byte signature:  " (erlang/byte_size (first ids)))

;; ── Stance 2: online (with an oracle) ───────────────────────────────
;;
;; An oracle is anything that can answer "is this id revoked?". The
;; simplest is an in-memory set. We revoke this token by putting its id in
;; the set, then authorize WITH that oracle — and now the same token,
;; which passed a moment ago, is denied.

(heading "── online: revoke the id, then deny ──")

(def oracle (auth/revocation-set ids))

(def revoked-decision
  (auth/authorize root-pub token
    (auth/context (assoc base :revocation oracle))))

(show "verdict:" (:verdict revoked-decision))
(show "reason: " (:reason revoked-decision))

;; ── Revocation as a queryable fact ──────────────────────────────────
;;
;; The in-memory set is the simple case. In production the oracle is a
;; function that closes over your own store — typically datom, where a
;; revocation is just a fact with a timestamp. Because datom is temporal,
;; "was this token revoked AS OF the moment the action happened?" is an
;; ordinary query, not special machinery. Here we fake that store with a
;; set, to show the shape:

(heading "── an oracle backed by your own lookup ──")

(def revoked-set (set ids))
(def fn-oracle
  (auth/revocation-oracle (fn [id] (contains? revoked-set id))))

(show "function-backed oracle also denies:"
      (:verdict (auth/authorize root-pub token
                  (auth/context (assoc base :revocation fn-oracle)))))

;; ── The point ───────────────────────────────────────────────────────
;;
;; There is no third option that is both instant and offline — so `auth`
;; does not invent one. It gives you the mechanism and lets each call pick
;; its stance. Short-lived and dependency-free, or instantly revocable and
;; online: your deployment's choice, per request, over the very same token.

(heading "── done ──")
(println "  offline by default; revocable when you hand in an oracle.")
