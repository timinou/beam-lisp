; examples/auth/03-attenuation-only-narrows.bl — safe delegation.
; Run: mix beam_lisp.run --path priv examples/auth/03-attenuation-only-narrows.bl
;
; ── The idea that makes capabilities safe to share ────────────────────
;
; You hold a token that lets you read AND write doc-42. You want to hand a
; background job a token that can only READ, and only for the next five
; minutes. With server-side sessions you would mint a new, weaker session
; and track it. With a capability you do it yourself, offline, in one
; step: you ATTENUATE the token you already hold.
;
; Attenuation appends a block of new CHECKS — extra conditions the token
; must now satisfy. And here is the guarantee that makes it safe:
;
;     appending a block can only ever RESTRICT what a token authorizes.
;     there is no block you can add that GRANTS a right it did not have.
;
; So handing a token to a subprocess, a coworker, or a third party is
; safe: whatever they do to it, they can only make it weaker. This file
; shows attenuation narrowing a token, and shows the one operation that
; ends the line — sealing.

(ns example.auth.attenuate (:require [auth]))

(defn- show [label value] (println (str "  " label "  " (pr-str value))))
(defn- heading [text] (println (str "\n" text)))

(def root (auth/keypair))
(def root-pub (auth/public root))

;; ── A full-power token ──────────────────────────────────────────────

(heading "── the original token ──")

(def token
  (auth/issue root
    [["user" "alice"]
     ["right" "doc-42" "read"]
     ["right" "doc-42" "write"]]))

(show "verifies:        " (auth/verify root-pub token))
(show "attenuation blocks:" (count (:blocks token)))

;; ── Attenuate: add a restricting block ──────────────────────────────
;;
;; The bearer needs NO secret from the issuer to do this — only the token
;; itself, which carries its own proof key. The issuer is never contacted.
;; Each `attenuate` appends one block; the chain grows, and the token gets
;; strictly weaker.

(heading "── narrow it: read-only, for this task only ──")

(def delegated
  (-> token
      (auth/attenuate [["check" "read-only"]])       ; a marker block
      (auth/attenuate [["check" "task-42-only"]])))

(show "still verifies:  " (auth/verify root-pub delegated))
(show "now has blocks:  " (count (:blocks delegated)))
(show "original unchanged:" (count (:blocks token)))

;; The original token is untouched — attenuation returns a NEW value, like
;; every other operation in this language. You can keep your full-power
;; token and hand out weakened copies from it.

;; ── The chain is append-only, cryptographically ─────────────────────
;;
;; You cannot rewrite or drop a block that is already in the chain without
;; breaking a signature (example 02 showed why tampering fails). So the
;; blocks you added are permanent, and the rights the original carried
;; can never be edited back UP. The only direction is narrower.

(heading "── the narrowing is permanent ──")

(show "removing the added blocks breaks it:"
      (auth/verify root-pub (assoc delegated :blocks [])))

;; ── Sealing: end the line ───────────────────────────────────────────
;;
;; Sometimes you want a token that can NEVER be attenuated again — a
;; long-lived credential like an API key, which should be used as-is and
;; not further delegated. `seal` does that: it proves the holder possessed
;; the last secret, then throws it away, so no further block can be added.
;; A sealed token still verifies; it just cannot grow.

(heading "── seal it: frozen, the shape of an API key ──")

(def sealed (auth/seal token))

(show "sealed still verifies:" (auth/verify root-pub sealed))
(show "but cannot be attenuated:"
      (try (do (auth/attenuate sealed [["check" "nope"]]) false)
           (catch _e true)))

;; ── The point ───────────────────────────────────────────────────────
;;
;; Delegation without a server: hand someone a token, and they can only
;; ever hold a weaker one than you. That single guarantee — monotonic
;; narrowing — is what lets capabilities flow freely through a system
;; without any of them becoming a way to escalate.

(heading "── done ──")
(println "  attenuation only narrows; sealing ends the line.")
