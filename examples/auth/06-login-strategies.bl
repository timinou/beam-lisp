; examples/auth/06-login-strategies.bl — login is a function, not a framework.
; Run: bl run examples/auth/06-login-strategies.bl
;
; ── Where do a token's facts come from? ───────────────────────────────
;
; Every example so far started with facts already in hand — user("alice"),
; right("doc-42","read"). But those facts have to come from somewhere: a
; password check, an OAuth login, an API key. That step is authentication,
; and each method (password, social login, key) looks different on the
; surface.
;
; Underneath, they are all the SAME shape: a function that takes some
; credentials and returns the facts a token should carry — or nil, if the
; credentials are no good. That is a "strategy". It is a plain function,
; not a behaviour module or a framework plugin, so you can build one,
; test it with a literal map, and register it in a plain map.
;
; This file builds all three common kinds and shows they are one shape.

(ns example.auth.strategies (:require [auth]))

(defn- show [label value] (println (str "  " label "  " (pr-str value))))
(defn- heading [text] (println (str "\n" text)))

;; ── Password: verify a credential, emit identity facts ──────────────
;;
;; The app supplies the actual password CHECK (it owns the hash store and
;; the hashing algorithm). The strategy just orchestrates: given an email
;; and password, if the check passes, emit user(<email>); else nil.

(heading "── a password strategy ──")

;; a toy "hash check" — a real app would compare against a stored hash
(defn- check-password [_email password] (= password "correct-horse"))

(def password
  (auth/password-strategy :email :password check-password))

(show "good credentials → facts:" (password {:email "ada@x.com" :password "correct-horse"}))
(show "bad credentials → nil:   " (password {:email "ada@x.com" :password "wrong"}))

;; ── Claims: an OAuth / SSO login already verified elsewhere ─────────
;;
;; `auth` is NOT an OAuth client — it does not talk to GitHub or Google.
;; By the time it is involved, some transport has already exchanged the
;; login and produced VERIFIED claims (a trusted map of who the user is).
;; The strategy's only job is to map those claims to facts. This is also
;; exactly how enterprise SSO (SAML/OIDC) plugs in — same shape.

(heading "── a claims strategy (OAuth / SSO) ──")

(def github
  (auth/claims-strategy :claims
    (fn [claims]
      [["user" (:sub claims)]
       ["email" (:email claims)]])))

(show "verified claims → facts:"
      (github {:claims {:sub "github|42" :email "dev@x.com"}}))

;; A group an SSO provider asserts becomes a fact too, and a policy can
;; read it directly — this is how "Okta group → access" needs no glue:
(def okta
  (auth/claims-strategy :claims
    (fn [claims]
      (into [["user" (:sub claims)]]
            (mapv (fn [g] ["group" (:sub claims) g]) (:groups claims))))))

(show "SSO groups → group facts:"
      (okta {:claims {:sub "u1" :groups ["engineering" "oncall"]}}))

;; ── API key: a lookup that returns facts ────────────────────────────
;;
;; An API key is the long-lived analogue of a login: present a key, get
;; back the facts it grants. Same shape — params in, facts out.

(heading "── an api-key strategy ──")

(def known-keys
  {"key-ci-abc" [["service" "ci"] ["right" "*" "read"]]})

(def api-key
  (auth/api-key-strategy :key (fn [k] (get known-keys k))))

(show "known key → service facts:" (api-key {:key "key-ci-abc"}))
(show "unknown key → nil:        " (api-key {:key "key-xyz"}))

;; ── A registry is just a map ────────────────────────────────────────
;;
;; Registering strategies is building a plain map from name to function.
;; Composing two apps' strategies is `merge`. Running one is a lookup and
;; a call. No hidden registration, no generated modules.

(heading "── register them, run by name ──")

(def registry
  (-> (auth/strategies)
      (auth/register-strategy :password password)
      (auth/register-strategy :github github)
      (auth/register-strategy :api-key api-key)))

(show "run :password:" (auth/run-strategy registry :password
                          {:email "ada@x.com" :password "correct-horse"}))
(show "run :api-key: " (auth/run-strategy registry :api-key {:key "key-ci-abc"}))

;; ── From login to token ─────────────────────────────────────────────
;;
;; The facts a strategy returns are exactly what `issue` mints a token
;; from. Login and token-minting connect with no adapter — the output of
;; one is the input of the other.

(heading "── login → mint a token ──")

(def root (auth/keypair))
(def facts (auth/run-strategy registry :password
             {:email "ada@x.com" :password "correct-horse"}))
(def token (auth/issue root facts))

(show "minted from login facts, verifies:" (auth/verify (auth/public root) token))

;; ── Where the stored verifier comes from: registration ─────────────
;;
;; The password strategy above assumes a verifier already exists. Making one
;; is the other half of the account, and it is the half where an app quietly
;; stores a plaintext or enforces no minimum. `register` names it once: check
;; a POLICY (data), hash, and emit the same user(...) facts a login emits —
;; so the two halves meet with no adapter.

(heading "── register a credential ──")

(def reg (auth/register {:identity "ada@x.com" :password "correct-horse"}))

;; what comes back is what you STORE (the verifier) and what you MINT from (the facts)
(show "registered → verifier:" (String/slice (:verifier (:ok reg)) 0 24))
(show "  ...and it verifies:" (auth/verify-password "correct-horse" (:verifier (:ok reg))))
(show "  facts:" (:facts (:ok reg)))

;; a weak password is refused with a reason a form can render, never a throw
(show "weak password → reason:" (auth/register {:identity "ada@x.com" :password "no"}))
(show "blank identity → reason:" (auth/register {:identity "" :password "correct-horse"}))

;; the policy is DATA: a 12-character floor is one map, and the default is a map
(show "strict policy → refused:"
      (auth/register {:identity "ada@x.com" :password "short-horse"} {:min-length 12}))
(show "the default policy:" auth/password-policy)

;; registration and login are one seam: a registered identity mints a token
;; carrying the same shape a logged-in one does.
(def reg-facts (:facts (:ok (auth/register {:identity "grace@x.com" :password "correct-horse"}))))
(show "registration facts mint a token:"
      (auth/verify (auth/public root) (auth/issue root reg-facts)))

(heading "── done ──")
(println "  every login method is one shape: credentials → facts.")
