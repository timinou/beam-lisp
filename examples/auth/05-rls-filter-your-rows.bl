; examples/auth/05-rls-filter-your-rows.bl — which rows may you see?
; Run: mix beam_lisp.run --path priv examples/auth/05-rls-filter-your-rows.bl
;
; ── The other half of authorization ───────────────────────────────────
;
; "May alice read documents?" is a yes/no question — example 04. But a
; list endpoint asks a different question: "of ALL the documents, which
; ones may alice see?" That is row-level security, and the naive way to
; do it — fetch everything, then drop the rows she shouldn't see — leaks
; two things: work (you read rows you discard) and existence (a hidden row
; you fetched-then-dropped can still be counted or timed).
;
; `auth` does it the beam-lisp way: it INJECTS the restriction into the
; query itself, before the query runs. The app writes ONE query, innocent
; of who is asking; `auth` rewrites it for this principal so the database
; never even selects the forbidden rows. Absent, not hidden.
;
; And the restriction is written in the SAME datalog the tokens use — so a
; permission and a row-filter are the same kind of thing, composed for
; free.

(ns example.auth.rls (:require [auth] [datom]))

(defn- show [label value] (println (str "  " label "  " (pr-str value))))
(defn- heading [text] (println (str "\n" text)))

;; ── A little database of owned documents ────────────────────────────

(def conn
  (datom/connect
    [{:db/ident :doc/title :db/valueType :db.type/string}
     {:db/ident :doc/owner :db/valueType :db.type/string}]))

(datom/transact! conn
  [{:db/id -1 :doc/title "Alice's Notes"  :doc/owner "alice"}
   {:db/id -2 :doc/title "Alice's Draft"  :doc/owner "alice"}
   {:db/id -3 :doc/title "Bob's Memo"     :doc/owner "bob"}])

(def db (datom/db conn))

;; ── The app's query — no notion of who is asking ────────────────────
;;
;; This is the query the application author writes. It lists every
;; document's title. It knows nothing about principals or ownership.

(def all-docs
  '[:find ?title :where [?doc :doc/title ?title]])

(heading "── the raw query sees everything ──")

(show "all documents:" (datom/q all-docs db))

;; ── Guard it for a principal ────────────────────────────────────────
;;
;; `guard` takes the query and a filter, and returns a NEW query with the
;; filter's clauses spliced into its `:where`. `owner-filter` builds the
;; clause "the document's owner is this principal". The result is an
;; ordinary datom query you run the same way — the security is now IN the
;; query, so there is no separate enforcement step to forget.

(heading "── the same query, guarded per principal ──")

(def alice-docs
  (auth/guard all-docs [(auth/owner-filter '?doc :doc/owner "alice")]))
(def bob-docs
  (auth/guard all-docs [(auth/owner-filter '?doc :doc/owner "bob")]))

(show "alice sees:" (datom/q alice-docs db))
(show "bob sees:  " (datom/q bob-docs db))

;; Two principals, ONE app query, disjoint results. alice never sees Bob's
;; memo, and the database never selected it for her — it was filtered at
;; the source, not after the fact.

;; ── Forbidden rows are absent, never errors ─────────────────────────
;;
;; A principal who owns nothing gets an EMPTY list — not an error, not a
;; "forbidden". That matters for security: if a hidden row raised an
;; error, an attacker could probe for which rows EXIST by watching for the
;; error. Returning nothing reveals nothing.

(heading "── someone with no rows gets nothing, cleanly ──")

(def carol-docs
  (auth/guard all-docs [(auth/owner-filter '?doc :doc/owner "carol")]))

(show "carol (owns nothing) sees:" (datom/q carol-docs db))
(show "it is empty, not an error:" (empty? (datom/q carol-docs db)))

;; ── The guarded query is just a value ───────────────────────────────
;;
;; Because the guarded query is a plain data structure, you can look at it
;; — see the extra clause `auth` added:

(heading "── the injected clause, visible ──")

(show "alice's guarded :where:" (:where alice-docs))

;; ── The point ───────────────────────────────────────────────────────
;;
;; Row security is not a separate system bolted onto the database. It is
;; the same datalog the tokens speak, injected into the query the app
;; already wrote. One engine, both sides — "may you?" and "which rows?" —
;; and forbidden data is simply never selected.

(heading "── done ──")
(println "  one query, guarded per principal; forbidden rows are absent.")
