; examples/auth/04-authorize-is-a-function.bl — the decision, as a value.
; Run: mix beam_lisp.run --path priv examples/auth/04-authorize-is-a-function.bl
;
; ── What "authorize" actually is ──────────────────────────────────────
;
; A token proves WHO you are and what you were granted. But a request is a
; specific act — "read doc-42, right now" — and deciding whether to allow
; it means reasoning over three things at once:
;
;     the token's facts     — what the bearer was granted
;     the request context   — what they are trying to do, and when
;     the policies          — the rules your app applies (allow / deny)
;
; `authorize` runs a tiny logic program over all three and returns a
; decision. It is a PURE FUNCTION: the same token, request, and key give
; the same answer every time, with no I/O. You can call it in a test with
; a literal token and get a literal decision — no server, no mocking.
;
; And the policies it evaluates are DATA, not code. You build them, print
; them, reorder them, store them. This file shows the decision, and shows
; that reordering the policy data changes the outcome.

(ns example.auth.authorize (:require [auth]))

(defn- show [label value] (println (str "  " label "  " (pr-str value))))
(defn- heading [text] (println (str "\n" text)))

(def root (auth/keypair))
(def root-pub (auth/public root))

;; alice may read doc-42.
(def token (auth/issue root [["user" "alice"] ["right" "doc-42" "read"]]))

;; ── A check ties the request to a granted right ─────────────────────
;;
;; The verifier adds two things to the reasoning:
;;   - FACTS about the request: resource("doc-42"), operation("read")
;;   - a CHECK: the request is only valid if the bearer holds the matching
;;     right. `$r` is a variable — it joins the request's resource to the
;;     token's `right` fact, exactly like a database join.
;;
;; A check is a query that must produce at least one answer. If it cannot,
;; the token is unauthorized — no matter what the policies say.

(def right-check
  {:queries [{:head {:name "q" :terms []}
              :body [{:name "resource" :terms [{:var 1}]}
                     {:name "operation" :terms [{:var 2}]}
                     {:name "right" :terms [{:var 1} {:var 2}]}]
              :exprs [] :symbols []}]
   :kind 0})

;; ── Authorize a READ — should be allowed ────────────────────────────

(heading "── a read request alice is entitled to ──")

(def read-ctx
  (auth/context
    {:facts    [["resource" "doc-42"] ["operation" "read"]]
     :checks   [right-check]
     :policies [(auth/allow [])]}))         ; allow, once checks pass

(def read-decision (auth/authorize root-pub token read-ctx))

(show "verdict:" (:verdict read-decision))

;; ── Authorize a WRITE — should be denied ────────────────────────────
;;
;; alice was granted read, not write. The same check now joins
;; operation("write") against her rights and finds nothing — so the check
;; fails, and the decision tells you WHY: a failed check, not a policy.

(heading "── a write request she was not granted ──")

(def write-ctx
  (auth/context
    {:facts    [["resource" "doc-42"] ["operation" "write"]]
     :checks   [right-check]
     :policies [(auth/allow [])]}))

(def write-decision (auth/authorize root-pub token write-ctx))

(show "verdict:" (:verdict write-decision))
(show "reason: " (:reason write-decision))

;; ── Policies are data you can reorder ───────────────────────────────
;;
;; Biscuit evaluates policies IN ORDER, first match wins. So whether a
;; deny takes precedence over an allow is decided by their ORDER — and
;; since policies are just values in a vector, you control it directly.
;; "deny-overrides" is simply putting the deny first.

(heading "── deny-overrides is just ordering ──")

(def deny-first
  (auth/context {:policies [(auth/deny []) (auth/allow [])]}))
(def allow-first
  (auth/context {:policies [(auth/allow []) (auth/deny [])]}))

(show "deny before allow →" (:verdict (auth/authorize root-pub token deny-first)))
(show "allow before deny →" (:verdict (auth/authorize root-pub token allow-first)))

;; The policies themselves are inspectable values — no macro, no hidden
;; expansion. You can print one:
(show "a policy is just data:" (auth/deny []))

;; ── Purity ──────────────────────────────────────────────────────────
;;
;; Because authorize is a pure function, the same inputs always give the
;; same decision. That is what makes an authorization reproducible: you
;; can re-run last Tuesday's decision against last Tuesday's facts and get
;; last Tuesday's answer — a property no stateful pipeline can promise.

(heading "── the same inputs always decide the same way ──")

(show "decision is stable:"
      (= (auth/authorize root-pub token read-ctx)
         (auth/authorize root-pub token read-ctx)))

(heading "── done ──")
(println "  authorize is a pure function; policy is data you reorder.")
