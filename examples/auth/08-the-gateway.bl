; examples/auth/08-the-gateway.bl — the whole thing, on one screen.
; Run: mix beam_lisp.run --path priv examples/auth/08-the-gateway.bl
;
; ── Putting it together ───────────────────────────────────────────────
;
; Each earlier file showed one idea in isolation. This one composes them
; into the shape a real application takes: a login that mints a
; capability, and a request handler that turns that capability into an
; authorized, row-filtered view of the data.
;
; The point of this file is how SMALL that is. What would be a login
; system, an authorization layer, a row-security layer, and a token
; service in another stack is here a handful of functions over values —
; because ACL, RLS, IAM, and tokens were all one thing underneath: facts,
; and a logic query over them.

(ns example.auth.gateway (:require [auth] [datom]))

(defn- show [label value] (println (str "  " label "  " (pr-str value))))
(defn- heading [text] (println (str "\n" text)))

;; ── The application's data ──────────────────────────────────────────

(def conn
  (datom/connect
    [{:db/ident :doc/title :db/valueType :db.type/string}
     {:db/ident :doc/owner :db/valueType :db.type/string}]))

(datom/transact! conn
  [{:db/id -1 :doc/title "Ada's Report"  :doc/owner "ada@x.com"}
   {:db/id -2 :doc/title "Ada's Notes"   :doc/owner "ada@x.com"}
   {:db/id -3 :doc/title "Bob's Memo"    :doc/owner "bob@x.com"}])

;; ── The gateway's setup: one keypair, one login method ──────────────

(def root (auth/keypair))

(def registry
  (-> (auth/strategies)
      (auth/register-strategy :password
        (auth/password-strategy :email :password
          (fn [_email pw] (= pw "s3cret"))))))

;; ── login: credentials → a capability token ─────────────────────────
;;
;; The strategy verifies the password and returns identity facts; `issue`
;; mints a token from them. We also grant a read right, so the token
;; carries both who they are and what they may do.

(defn login [creds]
  (let [facts (auth/run-strategy registry :password creds)]
    (if (nil? facts)
      nil                                       ; bad credentials
      (auth/issue root (conj facts ["right" "docs" "read"])))))

;; ── handle: a request → an authorized, filtered view ────────────────
;;
;; One function does the whole job:
;;   1. verify + authorize the request against the token (the ACL answer)
;;   2. if allowed, run the app's query GUARDED for this principal (RLS)
;; The principal is read from the token's own facts — we pass it in here
;; for brevity, but it rides along in the capability.

(def read-check
  {:queries [{:head {:name "q" :terms []}
              :body [{:name "right" :terms ["docs" "read"]}]
              :exprs [] :symbols []}]
   :kind 0})

(defn handle [token principal]
  (let [ctx (auth/context
              {:facts    [["operation" "read"]]
               :checks   [read-check]
               :policies [(auth/allow [])]})
        decision (auth/authorize (auth/public root) token ctx)]
    (if (= :allow (:verdict decision))
      ;; authorized — return only THIS principal's rows
      (let [q (auth/guard '[:find ?title :where [?doc :doc/title ?title]]
                          [(auth/owner-filter '?doc :doc/owner principal)])]
        {:ok (datom/q q (datom/db conn))})
      {:denied (:reason decision)})))

;; ── Run the gateway ─────────────────────────────────────────────────

(heading "── ada logs in and lists her documents ──")

(def ada-token (login {:email "ada@x.com" :password "s3cret"}))

(show "login succeeded:" (some? ada-token))
(show "ada's view:     " (handle ada-token "ada@x.com"))

;; the SAME handler, the SAME query — a different principal sees different
;; rows, because the guard scopes to whoever is asking.

(heading "── bob logs in and lists his ──")

(def bob-token (login {:email "bob@x.com" :password "s3cret"}))

(show "bob's view:" (handle bob-token "bob@x.com"))

;; ── A bad login mints nothing ───────────────────────────────────────

(heading "── a wrong password gets no token ──")

(show "login with bad password:" (login {:email "ada@x.com" :password "nope"}))

;; ── The whole flow, recounted ───────────────────────────────────────
;;
;; Login ran a strategy (a function) → facts → a signed token. A request
;; verified that token offline, authorized the action with a datalog
;; check and an allow policy, and then filtered the result rows with the
;; same datalog — all pure functions over values. That is ACL, IAM, and
;; RLS, and (from the token) offline trust and safe delegation, in one
;; short program.

(heading "── done ──")
(println "  login → capability → authorized, row-filtered view. One screen.")
