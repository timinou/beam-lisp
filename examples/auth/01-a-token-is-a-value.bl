; examples/auth/01-a-token-is-a-value.bl — a capability is a value you hold.
; Run: mix beam_lisp.run --path priv examples/auth/01-a-token-is-a-value.bl
;
; ── Start from the problem ────────────────────────────────────────────
;
; Most auth systems keep the truth on the SERVER: a session row, a
; database of who-can-do-what, looked up on every request. The token the
; user carries is opaque — a random string that means nothing until the
; server dereferences it. To trust a request you must call home.
;
; A capability token is the other choice. The token IS the truth: it
; carries the facts about who the bearer is and what they may do, and it
; carries its own proof of authenticity. Nothing to look up. It is a
; VALUE — you mint it, hold it, serialize it, and hand it on, the same way
; you would any other value in this language.
;
; This file makes exactly one point: a token is a value. We mint one,
; look inside it, and carry it across a wire and back.

(ns example.auth.token (:require [auth]))

(defn- show [label value] (println (str "  " label "  " (pr-str value))))
(defn- heading [text] (println (str "\n" text)))

;; ── A keypair: the one secret, and the public check ─────────────────
;;
;; The PRIVATE key mints and signs tokens — it is the root of trust, and
;; it never leaves the issuer. The PUBLIC key only VERIFIES; you can hand
;; it to anyone, publish it, bake it into a client. That asymmetry is the
;; whole reason a token can be checked without contacting the issuer.

(heading "── a root keypair ──")

(def root (auth/keypair))

(show "public key bytes: " (erlang/byte_size (auth/public root)))
(show "we hold a private:" (contains? root :private))

;; ── Issue a token: facts about the bearer ───────────────────────────
;;
;; A token carries FACTS, written as plain tuples: `["user" "alice"]` is
;; the fact user("alice"); `["right" "doc-42" "read"]` is the fact that
;; alice may read doc-42. These are the "authority" facts — what the
;; issuer asserts is true at the moment of minting.

(heading "── mint a token of authority facts ──")

(def token
  (auth/issue root
    [["user" "alice"]
     ["right" "doc-42" "read"]
     ["right" "doc-42" "write"]]))

(show "token has an authority block:" (contains? token :authority))
(show "and no attenuation blocks yet:" (count (:blocks token)))
(show "and a proof (its last secret):" (contains? (:proof token) :secret))

;; ── A token is portable: serialize it, carry it, read it back ───────
;;
;; `encode` gives the raw Biscuit wire bytes — a real `.bc` token any
;; Biscuit implementation in any language could read. `encode-base64`
;; gives the URL-safe text form you would put in an HTTP header or a
;; cookie. Either way it round-trips back to the same value.

(heading "── carry it across a wire ──")

(def wire (auth/encode token))
(def text (auth/encode-base64 token))

(show "wire bytes:      " (erlang/byte_size wire))
(show "base64 (head):   " (str (String/slice text 0 24) "…"))

(def recovered (auth/decode wire))

(show "decoded back to a token:" (contains? recovered :authority))
(show "same authority bytes:   "
      (= (:data (:authority token)) (:data (:authority recovered))))

;; ── The point ───────────────────────────────────────────────────────
;;
;; Nothing here touched a server, a session store, or a database. The
;; token is a self-contained value: its facts travel with it, and (as the
;; next file shows) so does its proof of authenticity. That is what makes
;; it a CAPABILITY — holding it IS the permission, and passing it is how
;; you delegate.

(heading "── done ──")
(println "  a token is a value: minted, inspected, carried, recovered.")
