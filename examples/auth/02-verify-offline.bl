; examples/auth/02-verify-offline.bl — trust, without calling home.
; Run: mix beam_lisp.run --path priv examples/auth/02-verify-offline.bl
;
; ── The question this answers ─────────────────────────────────────────
;
; A request arrives carrying a token. How do you know it is real — that
; your issuer minted it, and that nobody altered it on the way? The
; ordinary answer is: look it up in a database only the issuer has. That
; means every service that checks a token must reach the issuer, on every
; request. It couples everything to one box.
;
; The capability answer: the token is SIGNED. Whoever holds the matching
; PUBLIC key can check the signature themselves — no lookup, no network,
; no shared database. A phone, a CLI, another company's server: any of
; them can verify a token if you have handed them the public key.
;
; This file shows the two things verification guarantees, and the two
; ways it can fail.

(ns example.auth.verify (:require [auth]))

(defn- show [label value] (println (str "  " label "  " (pr-str value))))
(defn- heading [text] (println (str "\n" text)))

(def root (auth/keypair))
(def token (auth/issue root [["user" "alice"] ["right" "doc-42" "read"]]))

;; ── A verifier needs ONLY the public key ────────────────────────────
;;
;; Notice what the verifier does NOT have: the private key, a database, a
;; connection to the issuer. It has one 32-byte public key, and that is
;; enough to prove the token is authentic and untampered.

(heading "── verify with only the public key ──")

(def root-pub (auth/public root))

(show "verifies under the right public key:" (auth/verify root-pub token))

;; ── Failure 1: the wrong issuer ─────────────────────────────────────
;;
;; A token signed by SOME OTHER root does not verify under ours. This is
;; how a verifier refuses tokens it was not meant to trust — it simply
;; does not recognise the signature.

(heading "── a token from a different issuer is rejected ──")

(def impostor (auth/keypair))
(def forged (auth/issue impostor [["user" "alice"] ["right" "doc-42" "read"]]))

(show "forged token, checked against OUR public key:" (auth/verify root-pub forged))

;; ── Failure 2: tampering ────────────────────────────────────────────
;;
;; Suppose an attacker takes a real token and edits a fact — changing what
;; it grants. The signature was computed over the ORIGINAL bytes, so the
;; moment the bytes change, the signature no longer matches. We simulate
;; that by decoding a token, rewriting its authority block, and checking:

(heading "── a tampered token no longer verifies ──")

(def tampered
  (assoc token :authority
         (assoc (:authority token) :data (auth/encode token))))  ; garbage bytes

(show "original still good:" (auth/verify root-pub token))
(show "tampered is caught: " (auth/verify root-pub tampered))

;; ── Why this matters ────────────────────────────────────────────────
;;
;; Offline verification is what lets a capability travel. You can hand a
;; token to a background job, a mobile client, a partner service — and
;; each can check it is genuine on its own, with nothing but the public
;; key. No central bottleneck, no per-request lookup, no shared secret
;; spread across every service.

(heading "── done ──")
(println "  authentic + untampered, proven with a public key alone.")
