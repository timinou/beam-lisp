; multimethods.bl — open dispatch, the classic shapes/area plus the one
; thing open dispatch does that closed dispatch cannot: a brand-new
; shape added after the fact, with the earlier call sites still working.
; Run: mix beam_lisp.run examples/multimethods.bl

(defmulti area :shape)

(defmethod area :circle [s] (* 3.14159 (:r s) (:r s)))
(defmethod area :rect [s] (* (:w s) (:h s)))
(defmethod area :triangle [s] (* 0.5 (:base s) (:height s)))

(println "== a closed set of shapes ==")
(println (str "circle r=2:  " (area {:shape :circle :r 2})))
(println (str "rect 3x4:    " (area {:shape :rect :w 3 :h 4})))
(println (str "tri b4 h3:   " (area {:shape :triangle :base 4 :height 3})))

; --- open dispatch: a pentagon joins later, no edits above ---
(defmethod area :pentagon [s] (* 5 0.5 (:apothem s) (:side s)))

(println "== a shape added after the fact, earlier calls untouched ==")
(println (str "pentagon:    " (area {:shape :pentagon :apothem 2 :side 3})))
(println (str "circle still:" (area {:shape :circle :r 2})))

; --- :default fallback for anything unregistered ---
(defmethod area :default [s] 0)
(println "== :default fallback ==")
(println (str "unknown:     " (area {:shape :dodecahedron})))

; --- multi-argument dispatch with a vector dispatch value ---
(defn kind-of [o] (:kind o))
(defmulti collide (fn [a b] [(kind-of a) (kind-of b)]))
(defmethod collide [:asteroid :ship] [a b] "KABOOM")
(defmethod collide [:ship :ship] [a b] "clang")
(defmethod collide :default [& xs] "nothing happens")

(println "== vector dispatch value (classic collide) ==")
(println (str "asteroid+ship: " (collide {:kind :asteroid} {:kind :ship})))
(println (str "ship+ship:     " (collide {:kind :ship} {:kind :ship})))
(println (str "ship+asteroid: " (collide {:kind :ship} {:kind :asteroid})))

; --- hierarchy-aware dispatch (derive / isa?) ---
; A dispatch value derived from a registered key still hits that key's
; method, as in Clojure. (BeamLisp.Multi is reached by slash interop;
; multi/derive & friends are the wrapper equivalents.)
(BeamLisp.Multi/derive (BeamLisp.Env/current_ns) :cat :animal)
(BeamLisp.Multi/derive (BeamLisp.Env/current_ns) :dog :animal)

(defmulti speak :kind)
(defmethod speak :animal [a] "some animal sound")
(defmethod speak :cat [a] "meow")

(println "== isa? dispatch (cat hits :cat, dog falls through to :animal) ==")
(println (str "cat:  " (speak {:kind :cat})))
(println (str "dog:  " (speak {:kind :dog})))
