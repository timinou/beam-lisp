; bench.bl — what var linking buys: defns and prims compile to
; direct BEAM calls, no ETS lookup, no invoke dispatch.
; Run: mix beam_lisp.run examples/bench.bl

(defn now [] (erlang/monotonic_time :millisecond))
(defn time-it [f] (let [t (now)] (f) (- (now) t)))

(println (str "1M-iteration loop: "
  (time-it (fn [] (loop [i 0 acc 0] (if (< i 1000000) (recur (inc i) (+ acc i)) acc))))
  "ms"))

(defn countdown [n] (if (= n 0) :done (recur (dec n))))
(println (str "10M fn-recur countdown: " (time-it (fn [] (countdown 10000000))) "ms"))

(println "(pre-linking, the same 1M loop took ~1.6s)")
