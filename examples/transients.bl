; transients.bl — Clojure transients: a mutable-inside-a-scope view of a
; persistent collection. Run: mix beam_lisp.run examples/transients.bl
;
; Builds an N-element vector two ways — through a transient (conj! +
; persistent!) and through plain persistent conj — and prints equality
; and timing for each. On the BEAM this is an API-compatibility layer:
; the persistent vector's tail buffer already gives amortized O(1)
; append, and the transient's process-dictionary indirection costs about
; as much as it saves. The value is fidelity (upstream core.jank runs
; verbatim) and the one-way persistent! door, not speed.

(defn now [] (erlang/monotonic_time :millisecond))
(defn time-it [f] (let [t (now)] (let [r (f)] [r (- (now) t)])))

(def n 10000)

(defn build-transient [n]
  (persistent!
   (reduce (fn [acc i] (conj! acc i)) (transient []) (range n))))

(defn build-plain [n]
  (reduce (fn [acc i] (conj acc i)) [] (range n)))

(let [[tv t] (time-it (fn [] (build-transient n)))
      [pv p] (time-it (fn [] (build-plain n)))]
  (println (str "transient build (" n "): " t "ms"))
  (println (str "plain conj    (" n "): " p "ms"))
  (println (str "equal: " (= tv pv))))

; Map transients, for good measure (no speed claim — Elixir maps are
; already persistent; this is the API-compat path the fixtures use).
(println (persistent! (assoc! (assoc! (transient {}) :a 1) :b 2)))
