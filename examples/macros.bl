; macros.bl — defmacro + syntax-quote: code is data is code.
; Run: mix beam_lisp.run examples/macros.bl

(println "== unless ==")
(defmacro unless [c then else]
  `(if (not ~c) ~then ~else))
(println (unless (= 1 2) "one is not two" "wait what"))

(println "== infix: the operator arrives as data ==")
(defmacro infix [a op b]
  `(~op ~a ~b))
(println (infix 6 * 7))

(println "== defn2: a macro that writes fns ==")
; ~params is a *vector* — macros work because vectors are not lists.
(defmacro defn2 [name params body]
  `(defn ~name ~params ~body))
(defn2 triple [x] (* x 3))
(println (triple 14))

(println "== show: macro args arrive unevaluated ==")
(defmacro show [form]
  `(do
     (println (str "evaluating: " (pr-str (quote ~form))))
     ~form))
(println (show (+ 1 2)))
