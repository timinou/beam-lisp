;; examples/mcp-demo.bl — the MCP 2026-07-28 surface, over real source.
;;
;; Eleven exchanges against the REAL fact database — beam-lisp indexing ITSELF
;; (priv/std/codebase.bl + priv/std/typed.bl):
;;    1 discover                    → protocol handshake
;;    2 tools/list                  → the seven-tool surface (cacheable)
;;    3 code/list                   → mounted codebases + live fn/call counts
;;    4 code/query (datalog)        → raw query: fns that may return "string"
;;    5 code/ask impact (no target) → MRTR: input_required elicits the target fn
;;    6 code/ask impact retry       → inputResponses → who breaks if t-meet changes
;;    7 code/verify (correct)       → □(balance ≥ 0) proven for every state/input
;;    8 code/verify + repair        → violated, z3 synthesizes the guard
;;    9 code/subscribe              → watch callers of t-meet
;;   10 code/poll                   → drain the events the watch fired
;;   11 bad version                 → -32022
;;
;; Run: bl run examples/mcp-demo.bl

(ns tooling.mcp-demo
  (:require [mcp.server :as server]
            [mcp.jsonrpc :as jsonrpc]
            [mcp.tools :as tools]))

(defn client-meta []
  {"io.modelcontextprotocol/protocolVersion" (jsonrpc/protocol-version)
   "io.modelcontextprotocol/clientCapabilities"
   {"roots" {:listChanged false} "sampling" {}}})

(defn make-request [id method params]
  (merge {"jsonrpc" "2.0" "id" id "method" method "_meta" (client-meta)}
         (when (some? params) {"params" params})))

(defn show-exchange [label request response]
  (println (str label))
  (println (str "   → " (pr-str response))))

(defn -main []
  (let [srv (server/start)]
    (try
      ;; 1 — discover
      (let [req (make-request 1 "server/discover" nil)
            res (server/request srv req)]
        (show-exchange "1 discover" req res)
        (assert (= (get-in res ["result" "resultType"]) "complete"))
        (assert (= (get-in res ["result" "protocolVersion"]) "2026-07-28")))

      ;; 2 — tools/list (the six-tool surface)
      (let [req (make-request 2 "tools/list" nil)
            res (server/request srv req)]
        (show-exchange "2 tools/list" req res)
        (assert (= (get-in res ["result" "resultType"]) "complete"))
        (assert (= (count (get-in res ["result" "tools"])) 7))
        (assert (= (get-in res ["result" "ttlMs"]) 60000)))

      ;; 3 — code/list (mounted codebases + live counts)
      (let [req (make-request 3 "tools/call"
                  {"name" "code/list" "arguments" {}})
            res (server/request srv req)]
        (show-exchange "3 code/list" req res)
        (assert (= (get-in res ["result" "resultType"]) "complete"))
        (let [cb (first (get-in res ["result" "codebases"]))]
          (assert (= (get cb "name") "beam-lisp"))
          (assert (> (get-in cb ["entities" "functions"]) 0))
          (println (str "   fns indexed=" (get-in cb ["entities" "functions"])
                        " calls=" (get-in cb ["entities" "calls"])))))

      ;; 4 — code/query: raw datalog, fns that may return "string"
      (let [query '[:find ?name ?src :in $ ?wanted
                    :where [?d :fn/name ?name] [?d :fn/ret-tag ?wanted]
                           [?d :fn/ret-source ?src]]
            req (make-request 4 "tools/call"
                  {"name" "code/query"
                   "arguments" {"codebase" "beam-lisp" "query" query
                                "bindings" ["string"]}})
            res (server/request srv req)]
        (show-exchange "4 code/query (returns string?)" req res)
        (assert (= (get-in res ["result" "resultType"]) "complete"))
        (println (str "   rows=" (count (get-in res ["result" "rows"])))))

      ;; 5 — code/ask impact with NO target → MRTR input_required
      (let [req (make-request 5 "tools/call"
                  {"name" "code/ask" "arguments" {"question" "impact"}})
            res (server/request srv req)]
        (show-exchange "5 code/ask impact (missing target)" req res)
        (assert (= (get-in res ["result" "resultType"]) "input_required"))
        (assert (some? (get-in res ["result" "inputRequests"]))))

      ;; 6 — retry with inputResponses → the real impact of a real fn.
      ;; t-meet is the lattice heart of typed.bl; ask who breaks if it changes.
      (let [req (make-request 6 "tools/call"
                  {"name" "code/ask"
                   "arguments" {"question" "impact"}
                   "inputResponses" {"target" "t-meet"}})
            res (server/request srv req)]
        (show-exchange "6 code/ask impact retry (target=t-meet)" req res)
        (assert (= (get-in res ["result" "resultType"]) "complete"))
        (let [callers (get-in res ["result" "rows"])]
          (println (str "   who breaks if t-meet changes: "
                        (pr-str (to-list (map first callers)))))
          (assert (not-empty callers))))

      ;; 7 — code/verify: prove a defserver's invariant, and repair a broken one.
      ;; The single most differentiated tool: a machine-checked safety verdict.
      (let [good "(defserver ^{:invariant (>= balance 0)} account
                    (init [balance] (ok balance))
                    (handle-call [:withdraw amt] [_ balance] :when (and (>= amt 0) (>= balance amt))
                      (reply :ok (- balance amt))))"
            req (make-request 7 "tools/call"
                  {"name" "code/verify" "arguments" {"source" good}})
            res (server/request srv req)]
        (show-exchange "7 code/verify (correct account)" req res)
        (assert (= (get-in res ["result" "verdict"]) "holds"))
        (println (str "   □(balance ≥ 0) proven for every state and input")))

      ;; 8 — verify a BROKEN account with repair: z3 synthesizes the guard.
      (let [buggy "(defserver ^{:invariant (>= balance 0)} account
                     (init [balance] (ok balance))
                     (handle-call [:withdraw amt] [_ balance] (reply :ok (- balance amt))))"
            req (make-request 8 "tools/call"
                  {"name" "code/verify"
                   "arguments" {"source" buggy "repair" true}})
            res (server/request srv req)]
        (show-exchange "8 code/verify + repair (broken account)" req res)
        (assert (= (get-in res ["result" "verdict"]) "violated"))
        (let [repairs (get-in res ["result" "repairs"])]
          (assert (not-empty repairs))
          (println (str "   synthesized guard: "
                        (get (first repairs) "guard")
                        " on " (get (first repairs) "transition")))))

      ;; 9 — code/subscribe + code/poll: live fact changes via datom L3 watch.
      ;; Subscribe to callers of t-meet, then a NEW caller lands and poll sees it.
      (let [sub-req (make-request 9 "tools/call"
                      {"name" "code/subscribe" "arguments" {"callee" "t-meet"}})
            sub-res (server/request srv sub-req)
            sub-id (get-in sub-res ["result" "subscription"])]
        (show-exchange "9 code/subscribe (callers of t-meet)" sub-req sub-res)
        (assert (some? sub-id))
        ;; a new caller of t-meet is committed (the in-process equivalent of an
        ;; edit adding a call). The watch fires; give it a beat to deliver.
        (tools/assert-call! "freshly-added-fn" "t-meet" 2 1)
        (Process/sleep 200)
        (let [poll-req (make-request 10 "tools/call"
                         {"name" "code/poll" "arguments" {"subscription" sub-id}})
              poll-res (server/request srv poll-req)]
          (show-exchange "10 code/poll (drain events)" poll-req poll-res)
          (let [events (get-in poll-res ["result" "events"])]
            (assert (not-empty events))
            (println (str "   watch fired — new caller: "
                          (get (first events) "caller"))))))

      ;; 11 — bad protocol version
      (let [bad-meta (assoc (client-meta)
                            "io.modelcontextprotocol/protocolVersion" "1999-01-01")
            req (merge {"jsonrpc" "2.0" "id" 11
                        "method" "server/discover" "_meta" bad-meta})
            res (server/request srv req)]
        (show-exchange "11 bad version" req res)
        (assert (= (get-in res ["error" "code"]) -32022)))

      (println "✓ All 11 exchanges passed (2026-07-28 envelopes, real self-index)")
      (finally
        (server/stop srv)))))

(-main)
