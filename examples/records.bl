; records.bl — defrecord and deftype: beam-lisp's user types.
;
; A record is a map with a known key set plus a type. beam-lisp backs it
; with a real Elixir struct, so Elixir interop, IO.inspect and pattern
; matching all work on a record, and equality is Clojure's for free:
; same type + same value are equal; a record and a plain map with the
; same entries are not; two records of different types never are.
;
; deftype is the leaner sibling: named fields, no map semantics — no
; keyword lookup, no seq/assoc/count. Reach for deftype when you want a
; fast, opaque holder that only a protocol can talk to; reach for
; defrecord when you want a first-class map-shaped value.
;
; Run: mix beam_lisp.run examples/records.bl

(ns records.demo)

; --- a record is defined with its fields; use it as a map -------------
(defrecord Point [x y])

; The type name is a value; the constructors are ->Name and map->Name.
(println "== constructors ==")
(println (str "->Point:      " (->Point 1 2)))
(println (str "map->Point:   " (map->Point {:x 3 :y 4})))

; Keyword lookup, get, count and seq all read the public fields.
(println "== a record is a map ==")
(println (str "(:x p):       " (:x (->Point 1 2))))
(println (str "(get p :y):   " (get (->Point 1 2) :y)))
(println (str "(count p):    " (count (->Point 1 2))))
(println (str "(seq p):      " (seq (->Point 1 2))))

; assoc keeps the record type for a known key, and for an unknown key it
; stays a record with the extra entry — exactly Clojure's behavior.
(println (str "assoc :x:     " (assoc (->Point 1 2) :x 9)))
(println (str "assoc :z:     " (assoc (->Point 1 2) :z 3)))

; --- implement a protocol inline --------------------------------------
(defprotocol Shape (area [this]) (perimeter [this]))

(defrecord Rect [w h]
  Shape
  (area [this] (* (:w this) (:h this)))
  (perimeter [this] (+ (* 2 (:w this)) (* 2 (:h this)))))

(println "== inline protocol implementation ==")
(println (str "rect 3x4 area:      " (area (->Rect 3 4))))
(println (str "rect 3x4 perimeter: " (perimeter (->Rect 3 4))))

; --- equality is by type AND value ------------------------------------
(defrecord Square [side])

(println "== type-based equality ==")
(println (str "same type+value: " (= (->Point 1 2) (->Point 1 2))))
(println (str "different type:  " (= (->Point 1 2) (->Square 1))))
(println (str "record vs map:   " (= (->Point 1 2) {:x 1 :y 2})))

; --- deftype: named fields, no map semantics --------------------------
; A Line is just two numbers. There is no (:a line), no seq, no assoc —
; its only interface is the protocol it implements and its fields.
(deftype Line [a b])

(println "== deftype ==")
(println (str "->Line:        " (->Line 1 2)))
(println (str "field .a:      " (.a (->Line 1 2))))
(println (str "field .-b:     " (.-b (->Line 1 2))))
(println (str "map? line:     " (map? (->Line 1 2))))

; deftype implements a protocol inline too.
(defprotocol Length (len [this]))

(deftype Vec [x y]
  Length
  (len [this] (+ (.x this) (.y this))))

(println (str "vector len:    " (len (->Vec 3 4))))

; --- records print readably and read back -----------------------------
; pr-str emits a tagged literal; the reader lowers it back into a record,
; so a record survives a round-trip through its printed form.
(println "== pr-str round-trip ==")
(println (str "pr-str:        " (pr-str (->Point 1 2))))

; End with the kind of thing that tells you deftype from defrecord: a
; record is a map you can thread through seq/reduce; a deftype is not.
(println "== why each ==")
(println (str "reduce over a record's entries: "
              (reduce (fn [acc e] (+ acc (second e))) 0 (seq (->Rect 3 4)))))
(println (str "deftype has no map path:      "
              (try (count (->Line 1 2)) (catch e (str "error — " (ex-message e))))))
