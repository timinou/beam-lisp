; wry_hello.bl — a native window with a WebView, in a handful of forms.
;
; Run:  QT_QPA_PLATFORM=xcb mix beam_lisp.run examples/wry_hello.bl
; (the QT var is only relevant if you also run the emulator; wry itself is
;  fine on Wayland via WebKitGTK. On a headless box, see the note at the end.)
;
; What it shows:
;   1. open a window with inline HTML and an :on-message handler
;   2. push JavaScript into the live page with `eval`
;   3. receive a message back from the page via `bl.send(...)`

(ns wry-hello
  (:require [wry]))

(when (not (wry/available?))
  (println "wry backend not available (no WebKitGTK / no display?) — exiting")
  (System/halt 0))

; A page with a button that talks back to beam-lisp.
(def page
  (str "<!doctype html><meta charset=utf-8>"
       "<body style=\"font-family:system-ui;display:grid;place-items:center;height:90vh;margin:0\">"
       "<div style=\"text-align:center\">"
       "<h1 id=hi>hello from beam-lisp</h1>"
       "<button onclick=\"bl.send('button clicked at ' + Date.now())\">ping beam-lisp</button>"
       "</div>"))

; Open. :on-message runs (in the window's receiver process) for every bl.send.
(def w
  (wry/open
    {:title "beam-lisp · wry"
     :width 520 :height 360
     :html page
     :on-message (fn [msg] (println "  ← page says:" msg))}))

(println "window open. mutating it from beam-lisp in 1s…")
(Process/sleep 1000)

; Drive the live page from beam-lisp.
(wry/eval w "document.getElementById('hi').textContent = 'mutated by beam-lisp'")
(wry/eval w "document.body.style.background = 'rebeccapurple'; document.body.style.color = 'white'")

(println "eval sent. click the button to send a message back.")
(println "closing in 8s (or click the window's close box)…")
(Process/sleep 8000)

(wry/close w)
(println "closed. bye.")
