;; studio.bl — the dev-tooling studio: one real live app, fully instrumented.
;;
;;   BL_SERVE=1 mix beam_lisp.run --path priv examples/data/studio.bl
;;   → http://127.0.0.1:4088
;;
;; The app is an ordinary live.app: a board of cards in a datom world (shared
;; facts), a per-viewer theme (locals), intents as data. Nothing in the app
;; knows about tooling. It is opened with ONE extra key — `:tap (pulse/tap)` —
;; and from that single value the studio grows: the pulse chip narrates every
;; commit the instant it lands, Paint flashes the exact elements each op
;; touched, the Timeline lets you scrub back through every frame, and Inspect
;; lets you point at anything and ask (and change) what feeds it.

(ns studio
  (:require [live.app :as app]
            [live.hiccup :as h]
            [loom.ui :as ui]
            [loom.box :as b]
            [loom.token :as tok]
            [datom]
            [web]
            [tooling.pulse :as pulse]))

;; ── the shared world: cards on a board ──────────────────────────────
(def board
  (let [c (datom/connect
            [{:db/ident :card/id    :db/valueType :db.type/string :db/unique :db.unique/identity}
             {:db/ident :card/title :db/valueType :db.type/string}
             {:db/ident :card/lane  :db/valueType :db.type/string}
             {:db/ident :card/votes :db/valueType :db.type/long}])]
    (datom/transact! c
      [{:db/id -1 :card/id "c1" :card/title "keyed differ"     :card/lane "done"  :card/votes 3}
       {:db/id -2 :card/id "c2" :card/title "tap every commit" :card/lane "doing" :card/votes 1}
       {:db/id -3 :card/id "c3" :card/title "paint the diff"   :card/lane "todo"  :card/votes 0}])
    c))

(defn cards [db]
  (sort-by first
    (datom/q '[:find ?id ?title ?lane ?votes
               :where [?e :card/id ?id] [?e :card/title ?title]
                      [?e :card/lane ?lane] [?e :card/votes ?votes]] db)))

(defn card-eid [db id]
  (first (first (datom/q '[:find ?e :in $ ?id :where [?e :card/id ?id]] db id))))

(def lanes ["todo" "doing" "done"])
(defn next-lane [l] (case l "todo" "doing" "doing" "done" "todo"))

;; ── the view: pure fn of (world, locals) ────────────────────────────
(def brand-dark  {:color {:accent "#39d0d8" :bg "#0a0e14" :surface "#121821" :surface-2 "#182030"
                          :border "#1f2733" :text "#e6edf3" :muted "#7d8590"}})
(def brand-light {:color {:accent "#ff5c8a" :bg "#fbf7f2" :surface "#ffffff" :surface-2 "#f3ece4"
                          :border "#e6dccf" :text "#1d1a17" :muted "#7a716a"}})

(defn card-row [c]
  (let [[id title lane votes] c]
    (b/row {:key id :justify :between}
      (b/col {:gap :1}
        (ui/prose {:style {:font-weight "600"}} title)
        (ui/prose {:tone :muted} (str "#" id)))
      (b/row {:gap :2}
        (ui/badge {:tone (if (= lane "done") :success :accent)} lane)
        (ui/button {:variant :ghost :on-click [:intent :vote {:id id}]} (str "▲ " votes))
        (ui/button {:variant :ghost :on-click [:intent :advance {:id id}]} "→")))))

(app/defscreen home [{:keys [db locals]}]
  (let [world (db :board)
        cs (cards world)
        theme (get locals :theme "dark")]
    (tok/install-theme! (if (= theme "light") brand-light brand-dark))
    (b/col {:gap :5 :max-w "680px" :style {:margin "0 auto" :padding "48px 24px"}}
      (b/row {:justify :between}
        (b/col {:gap :1}
          (ui/heading 1 "studio")
          (ui/prose {:tone :muted} "a board. click anything — then open the chip and look."))
        (ui/badge {:tone :accent} (str (count cs) " cards")))
      (ui/card {}
        (b/col {:gap :3}
          (for [c cs] (card-row c))))
      (b/row {:gap :3}
        (ui/button {:variant :primary :on-click [:intent :add {}]} "+ card")
        (ui/button {:variant :subtle :on-click [:assign :theme (if (= theme "light") "dark" "light")]}
          (str "theme: " theme))
        (ui/button {:variant :subtle :on-click [:assign :clicks (inc (get locals :clicks 0))]}
          (str "clicks: " (get locals :clicks 0)))))))

;; ── intents: the only writes ────────────────────────────────────────
(defn vote [conn payload _who]
  (let [db (datom/db conn) e (card-eid db (:id payload))
        v (first (first (datom/q '[:find ?v :in $ ?e :where [?e :card/votes ?v]] db e)))]
    [[:db/add e :card/votes (inc v)]]))

(defn advance [conn payload _who]
  (let [db (datom/db conn) e (card-eid db (:id payload))
        l (first (first (datom/q '[:find ?l :in $ ?e :where [?e :card/lane ?l]] db e)))]
    [[:db/add e :card/lane (next-lane l)]]))

(defn add [conn _payload _who]
  (let [n (inc (count (cards (datom/db conn))))]
    [{:db/id -1 :card/id (str "c" n) :card/title (str "card " n) :card/lane "todo" :card/votes 0}]))

;; ── the shell: the page + the studio chip ───────────────────────────
(defn shell [title body style]
  (str "<!doctype html><html lang=en><head><meta charset=utf-8>"
       "<meta name=viewport content=\"width=device-width,initial-scale=1\">"
       "<title>" title "</title>" style
       "<style>body{margin:0;background:#0a0e14;transition:background .3s}</style>"
       "</head><body>"
       "<div id=live-root>" body "</div>"
       (h/hiccup->html (pulse/chip-hiccup "/__pulse/ws"))
       "<script src=/client.js></script>"
       "<script>Live.connect({url:'ws://'+location.host+'/ws'+location.pathname,"
       "root:document.getElementById('live-root')})</script>"
       "</body></html>"))

(def studio
  {:home "/"
   :title "studio"
   :routes [["/" home]]
   :principal (fn [_conn] "you")
   :worlds (fn [_me _params] {:board (datom/db board)})
   :observe (fn [_me] [board])
   :shared-conn board
   :intents {:vote vote :advance advance :add add}
   :warm ["/"]
   :shell shell
   ;; the one line that turns an app into a studio
   :tap (pulse/tap)
   ;; the chip's own feed
   :http (fn [conn path]
           (if (= path "/__pulse/ws")
             (web/upgrade conn (:ws-handlers (pulse/mount)) nil)
             nil))})

(pulse/track :datom "board" (fn [] (count (cards (datom/db board)))))

(app/serve studio {:port 4088})
(println "STUDIO_UP")
(if (contains? #{"1" "true"} (System/get_env "BL_SERVE"))
  (Process/sleep 600000)
  (println "(set BL_SERVE=1 to keep serving)"))
