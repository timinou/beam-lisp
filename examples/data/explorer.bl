;; explorer.bl — an interactive tour of data + tooling.
;; Run:  BL_SERVE=1 mix beam_lisp.run --path priv examples/data/explorer.bl
;; Open: http://127.0.0.1:4077
;;
;; Click the buttons. Each click flows browser -> websocket -> server, mutates
;; a cell, re-renders through pulse/traced subtrees (so only the changed part
;; recomputes), diffs, and pushes fresh HTML back. The pulse chip narrates
;; which subtree recomputed and how many ops shipped — the whole stack, live.

(ns explorer
  (:require [web]
            [live.hiccup :as h]
            [live.diff :as diff]
            [data.config :as cfg]
            [data.cache :as cache]
            [tooling.pulse :as pulse]))

;; ── app state: ordinary cells ───────────────────────────────────────
(def clicks   (atom 0))
(def theme    (cfg/create {:name "dark" :accent "#39d0d8"}))
(def fib-n    (atom 20))
(def fib-cache (cache/open "fib"))

(pulse/track :atom   "clicks"  (fn [] @clicks))
(pulse/track :atom   "fib-n"   (fn [] @fib-n))
(pulse/track :config "theme"   (fn [] (cfg/settings theme)))
(pulse/track :cache  "fib"     (fn [] (cache/stats fib-cache)))

(defn fib [n] (cache/get! fib-cache [n]
                (fn [] (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))))

;; ── the view: three traced subtrees ─────────────────────────────────
;; Each subtree depends on ONE cell, so a click that changes clicks does NOT
;; recompute the fib panel, and vice-versa. pulse/traced records which one ran.
(def counter-panel
  (pulse/traced :counter [clicks]
    (fn [] [:div {:class "panel"}
            [:div {:class "big"} (str @clicks)]
            [:div {:class "lbl"} "clicks"]])))

(def fib-panel
  (pulse/traced :fib [fib-n]
    (fn [] [:div {:class "panel"}
            [:div {:class "big"} (str (fib @fib-n))]
            [:div {:class "lbl"} (str "fib(" @fib-n ") — cached")]])))

(def theme-panel
  (pulse/traced :theme [(cfg/ref theme)]
    (fn [] [:div {:class "panel"}
            [:div {:class "big" :style (str "color:" (cfg/fetch theme :accent))}
             (cfg/fetch theme :name)]
            [:div {:class "lbl"} "theme"]])))

(defn app-body []
  [:div {:id "app-root"}
   [:h1 "explorer"]
   [:p {:class "hint"} "click a button — watch the pulse chip say what recomputed"]
   [:div {:class "row"} @counter-panel @fib-panel @theme-panel]
   [:div {:class "buttons"}
    [:button {:onclick "ev('click')"} "+1 click"]
    [:button {:onclick "ev('fib-up')"} "fib n+1"]
    [:button {:onclick "ev('fib-down')"} "fib n-1"]
    [:button {:onclick "ev('toggle-theme')"} "toggle theme"]]])

;; ── event handling: mutate, re-render, diff, push ───────────────────
(defn handle-event [ev]
  (pulse/clear-trace!)
  (cond
    (= ev "click")        (swap! clicks inc)
    (= ev "fib-up")       (swap! fib-n inc)
    (= ev "fib-down")     (swap! fib-n (fn [n] (max 0 (dec n))))
    (= ev "toggle-theme") (if (= "dark" (cfg/fetch theme :name))
                            (do (cfg/put theme :name "light") (cfg/put theme :accent "#ff5c8a"))
                            (do (cfg/put theme :name "dark")  (cfg/put theme :accent "#39d0d8")))
    :else nil))

;; ── the app websocket: the whole UI over one connection ─────────────
(def app-tree (atom nil))

(defn- render-and-diff! []
  (let [next (app-body)
        prev @app-tree
        ops (if prev (diff/diff prev next) [])]
    (reset! app-tree next)
    (pulse/note-patch! (count ops))
    (h/hiccup->html next)))

(defn app-ws-init [_s]
  (reset! app-tree (app-body))
  [:push (list (list :text (h/hiccup->html @app-tree))) {}])

(defn app-ws-in [frame state]
  ;; frame is [:text "eventname"]
  (let [ev (if (sequential? frame) (second frame) nil)]
    (when ev (handle-event ev))
    [:push (list (list :text (render-and-diff!))) state]))

(def app-ws {:init app-ws-init
             :handle-in app-ws-in
             :handle-info (fn [_m s] [:ok s])})

;; ── page + pulse chip ───────────────────────────────────────────────
(def dash (pulse/mount))

(defn page []
  (str "<!doctype html><html><head><meta charset=utf-8><title>explorer</title>"
       "<style>"
       "body{background:#0a0e14;color:#e6edf3;font:15px/1.5 ui-monospace,Menlo,monospace;margin:0}"
       "#shell{max-width:720px;margin:60px auto;padding:0 20px}"
       "h1{font-size:34px;letter-spacing:.08em}.hint{color:#7d8590}"
       ".row{display:flex;gap:14px;margin:24px 0}"
       ".panel{flex:1;background:#121821;border:1px solid #1f2733;border-radius:14px;padding:20px;text-align:center}"
       ".big{font-size:30px;font-weight:700}.lbl{color:#7d8590;font-size:12px;text-transform:uppercase;letter-spacing:.12em;margin-top:6px}"
       ".buttons{display:flex;gap:10px;flex-wrap:wrap}"
       "button{background:#1f2733;color:#e6edf3;border:1px solid #2b3542;border-radius:10px;padding:10px 16px;font:inherit;cursor:pointer}"
       "button:hover{border-color:#39d0d8}"
       "</style></head><body><div id=shell>"
       "<div id=mount></div></div>"
       ;; the pulse chip (own feed at /__pulse/ws), narrating the trace
       (h/hiccup->html (pulse/chip-hiccup "/__pulse/ws"))
       "<script>"
       "var aws=new WebSocket('ws://'+location.host+'/app/ws');"
       "aws.onmessage=function(e){document.getElementById('mount').innerHTML=e.data};"
       "window.ev=function(name){aws.send(name)};"
       "</script></body></html>"))

(defn router [conn]
  (web/route conn
    [:get "/"]            (web/html conn (page))
    [:get "/app/ws"]      (web/upgrade conn app-ws nil)
    [:get "/__pulse/ws"]  (web/upgrade conn (:ws-handlers dash) nil)
    :else                 (web/text conn 404 "not found")))

(web/serve {:port 4077 :plug router})
(println "EXPLORER_UP")
(if (contains? #{"1" "true"} (System/get_env "BL_SERVE"))
  (Process/sleep 120000)
  (println "(set BL_SERVE=1 to keep serving)"))
