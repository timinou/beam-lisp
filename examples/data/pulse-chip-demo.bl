(ns data-demo
  (:require [web]
            [live.hiccup :as h]
            [data.config :as cfg]
            [data.cache :as cache]
            [tooling.pulse :as pulse]
            [tooling.incremental :as inc]))

;; ── app state: ordinary cells ───────────────────────────────────────
(def clicks (atom 0))
(def settings (cfg/create {:theme "dark" :title "data demo"}))
(def compute-cache (cache/open "demo"))

;; register the app's cells with the pulse instrument
(pulse/track :atom "clicks" (fn [] @clicks))
(pulse/track :config "settings" (fn [] (cfg/settings settings)))
(pulse/track :cache "compute-cache" (fn [] (cache/stats compute-cache)))

;; an expensive computation, memoized through data.cache
(defn fib [n] (cache/get! compute-cache [:fib n]
                (fn [] (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))))

;; ── the view: plain hiccup, decorated with the pulse chip ────────────
(defn app-view []
  [:div {:style "max-width:640px;margin:60px auto;font-family:ui-monospace,monospace;color:#e6edf3"}
   [:h1 {:style "font-size:32px"} (cfg/fetch settings :title)]
   [:p {:style "color:#7d8590"} (str "theme: " (cfg/fetch settings :theme))]
   [:p (str "clicks so far: " @clicks)]
   [:p (str "fib(30) via data.cache = " (fib 30))]
   [:p {:style "color:#39d0d8"} "the pulse chip is bottom-right \u2014 click it"]])

;; with-chip injects the live cell dashboard chip into the view
(def view (pulse/with-chip app-view "/__pulse/ws"))

(defn page [] (str "<!doctype html><html><head><meta charset=utf-8>"
                   "<title>data demo</title></head>"
                   "<body style=\"background:#0a0e14;margin:0\">"
                   (h/hiccup->html (view))
                   "</body></html>"))

(def dash (pulse/mount))

(defn router [conn]
  (web/route conn
    [:get "/"]            (web/html conn (page))
    [:get "/__pulse/ws"]  (web/upgrade conn (:ws-handlers dash) nil)
    :else                 (web/text conn 404 "not found")))

(web/serve {:port 4066 :plug router})
(println "DATA_DEMO_UP")
(if (contains? #{"1" "true"} (System/get_env "BL_SERVE"))
  (Process/sleep 90000)
  (println "(set BL_SERVE=1 to keep serving)"))
