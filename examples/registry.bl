; registry.bl — find a process by what it is, not by its address.
; Run: mix beam_lisp.run --path priv examples/registry.bl

(ns example.registry
  (:require [reg :as reg]))

(defn check! [truth message data]
  (when-not truth
    (throw (ex-info message data))))

;; a tiny server to look up
(defserver worker
  (init [id] (ok {:id id :done 0}))
  (handle-call :id [_from s] (reply (:id s) s)))

(println "== a registry is a server whose state is a relation ==")

(reg/defregistry workers (keys :id))
(def r (start workers nil {:name :workers}))

(def w1 (start worker 1))
(def w2 (start worker 2))

(check! (= :ok (reg/register r w1 {:id 1})) "register w1" {})
(check! (= :ok (reg/register r w2 {:id 2})) "register w2" {})

(println (str "  whereis {:id 1} → " (pr-str (reg/whereis r {:id 1}))))
(check! (= w1 (reg/whereis r {:id 1})) "whereis finds the pid" {})

(println (str "  where {}        → " (count (reg/where r {})) " pids"))
(check! (= 2 (count (reg/where r {}))) "where lists both" {})

(println "== a name is a value ==")
;; [:workers {:id 2}] anywhere a pid is expected — resolution happens inside
;; the verb, once.
(check! (= 2 (call [:workers {:id 2}] :id)) "call by name answers" {})
(println "  (call [:workers {:id 2}] :id) → 2")

(println "== entries retract themselves (Monitor) ==")
(kill w1)
(Process/sleep 60)   ; let the :DOWN land
(check! (nil? (reg/whereis r {:id 1})) "w1 retracted after death" {})
(println "  killed w1; (reg/whereis r {:id 1}) → nil")

(println "== undeclared keys are declined ==")
(def bad (reg/register r w2 {:oops 1}))
(check! (= :error (first bad)) "unknown key is an error" {})
(println (str "  (reg/register r w2 {:oops 1}) → " (pr-str bad)))

(stop w2)
(stop r)
(println "\nregistry green.")
:ok
