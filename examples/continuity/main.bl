(ns continuity.main (:require [continuity.desk :as desk] [web]))
(let [root (or (System/get_env "CONTINUITY_ROOT")
              (str (System/get_env "HOME") "/tmp/beam-continuity-" (System/system_time :nanosecond)))
      port (String/to_integer (or (System/get_env "CONTINUITY_PORT") "4048"))
      h (desk/open! {:root root :port port :source-root (Path/expand "examples/continuity")})
      listener (web/serve {:port port :ip (tuple 127 0 0 1) :log :off :plug #(desk/router h %)})]
 (println (str "Continuity · http://127.0.0.1:" port " · sandbox receipts " root))
 (try (Process/sleep :infinity)
  (finally (Supervisor/stop (elem listener 1)) (desk/close! h))))
