(ns continuity.orders (:require [proc.evolve :as evolve] [continuity.receipts :as receipts]))
(defn finish-job [job] {:id (:demo/id job) :version 2})
(defn job-handler [] finish-job)
(defn definition []
 (evolve/prepare-spec
  {:version 2 :digest "orders-v2" :accept? (fn [m] (and (map? m) (or (= :inspect (:op m)) (and (= :order (:op m)) (string? (:id m)) (int? (:cents m)) (pos? (:cents m))))))
   :check-state (fn [s] (and (map? s) (:store s) (int? (:orders s)) (int? (:gross-cents s)) (>= (:gross-cents s) 0) (= "USD" (:currency s))))
   :check-reply (fn [r] (and (map? r) (int? (:orders r)) (int? (:gross-cents r))))
   :migrate-state (fn [s] (-> s (dissoc :cents) (assoc :gross-cents (:cents s) :currency "USD")))
   :upcast (fn [m] {:op :order :id (nth m 1) :cents (nth m 2)})
   :downcast (fn [r] (:orders r))
   :handler (fn [m s]
              (if (= :inspect (:op m)) {:reply (select-keys s [:orders :gross-cents]) :state s}
               (let [t (receipts/record! (:store s) (:id m) (:cents m))
                     next (assoc s :orders (:orders t) :gross-cents (:cents t))]
                {:reply (select-keys next [:orders :gross-cents]) :state next})))}))
