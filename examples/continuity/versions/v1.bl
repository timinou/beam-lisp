(ns continuity.orders (:require [proc.evolve :as evolve] [continuity.receipts :as receipts]))
(defn finish-job [job] {:id (:demo/id job) :version 1})
(defn job-handler [] finish-job)
(defn definition []
 (evolve/prepare-spec
  {:version 1 :digest "orders-v1" :accept? (fn [m] (and (vector? m) (= 3 (count m)) (= :order (first m)) (string? (nth m 1)) (int? (nth m 2)) (pos? (nth m 2))))
   :check-state (fn [s] (and (map? s) (:store s) (int? (:orders s)) (int? (:cents s)) (>= (:cents s) 0)))
   :check-reply int?
   :handler (fn [m s] (let [t (receipts/record! (:store s) (nth m 1) (nth m 2))]
                       {:reply (:orders t) :state (assoc s :orders (:orders t) :cents (:cents t))}))}))
