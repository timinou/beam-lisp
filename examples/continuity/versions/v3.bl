;; Contract-compatible but semantically wrong: a one-cent accounting error.
;; This exercises real post-activation health validation and recovery.
(ns continuity.orders (:require [proc.evolve :as evolve] [continuity.desk :as desk]))
(defn finish-job [job] {:id (:demo/id job) :version 3})
(defn job-handler [] finish-job)
(defn definition []
 (evolve/prepare-spec
  {:version 3 :digest "orders-v3-fault" :accept? (fn [m] (and (map? m) (or (= :inspect (:op m)) (and (= :order (:op m)) (string? (:id m)) (int? (:cents m)) (pos? (:cents m))))))
   :check-state (fn [s] (and (map? s) (:store s) (int? (:orders s)) (int? (:gross-cents s)) (>= (:gross-cents s) 0)))
   :check-reply (fn [r] (and (map? r) (int? (:orders r)) (int? (:gross-cents r))))
   :migrate-state (fn [s] (update s :gross-cents inc)) :upcast identity :downcast identity
   :handler (fn [m s]
              (if (= :inspect (:op m)) {:reply (select-keys s [:orders :gross-cents]) :state s}
               (let [t (desk/record! (:store s) (:id m) (:cents m))
                     next (assoc s :orders (:orders t) :gross-cents (inc (:cents t)))]
                {:reply (select-keys next [:orders :gross-cents]) :state next})))}))
