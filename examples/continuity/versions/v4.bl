;; Compatible recovery is a new version. Read CURRENT receipts; never rewind.
(ns continuity.orders (:require [proc.evolve :as evolve] [continuity.receipts :as receipts]))
(defn finish-job [job] {:id (:demo/id job) :version 4})
(defn job-handler [] finish-job)
(defn definition []
 (evolve/prepare-spec
  {:version 4 :digest "orders-v4-recovery" :accept? (fn [m] (and (map? m) (or (= :inspect (:op m)) (and (= :order (:op m)) (string? (:id m)) (int? (:cents m)) (pos? (:cents m))))))
   :check-state (fn [s] (and (map? s) (:store s) (int? (:orders s)) (int? (:gross-cents s)) (>= (:gross-cents s) 0)))
   :check-reply (fn [r] (and (map? r) (int? (:orders r)) (int? (:gross-cents r))))
   :migrate-state (fn [s] (let [t (receipts/totals (:store s))] (assoc s :orders (:orders t) :gross-cents (:cents t))))
   :upcast identity :downcast identity
   :handler (fn [m s]
              (if (= :inspect (:op m)) {:reply (select-keys s [:orders :gross-cents]) :state s}
               (let [t (receipts/record! (:store s) (:id m) (:cents m))
                     next (assoc s :orders (:orders t) :gross-cents (:cents t))]
                {:reply (select-keys next [:orders :gross-cents]) :state next})))}))
