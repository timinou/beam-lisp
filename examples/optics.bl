; optics.bl — van Laarhoven optics, side by side with the alternatives.
; Run: mix beam_lisp.run examples/optics.bl
;
; A lens is a pair of a getter and a setter; `(*> outer inner)` composes
; them outside-in into a path — `(*> (in :app) (in :users))` reads
; ":app then :users". Where update-in rewrites a single slot, a traversal
; rewrites *every* slot at once: `(over (*> (in :users) traversed (in :hits))
; inc data)` bumps every user's hits in one expression — the case update-in
; has no spelling for.
;
; This file shares its basename with the library it demonstrates
; (priv/optics.bl). The loader matches a require to the file whose
; declared `(ns …)` owns the name, not to the first same-named file on
; the path — so this example's `(ns optics.example)` never hijacks the
; require below, and the real `(ns optics)` library is pulled from
; priv/. The example calls are qualified `optics/…`.

(ns optics.example
  (:require [optics]))

; update-in is not in the runtime yet, so spell the single-slot rewrite by
; hand for the comparison. Note what it cannot do further down.
(defn update-in [m ks f]
  (if (empty? ks)
    (f m)
    (assoc m (first ks) (update-in (get m (first ks)) (rest ks) f))))

(def data
  {:app {:users [{:name "Ada"   :hits 41}
                 {:name "Grace" :hits 12}]}})

(println "== a lens: view / setv / over ==")
(println (str "  view  :app :users 0 :hits -> " (optics/view (optics/*> (optics/in :app) (optics/in :users) (optics/idx 0) (optics/in :hits)) data)))
(println (str "  setv  :app :users 0 :hits = 99 -> " (optics/setv (optics/*> (optics/in :app) (optics/in :users) (optics/idx 0) (optics/in :hits)) 99 data)))
(println (str "  over  :app :users 0 :hits inc -> " (optics/over (optics/*> (optics/in :app) (optics/in :users) (optics/idx 0) (optics/in :hits)) optics/inc data)))

(println "== one slot: update-in and a lens write the same thing ==")
(println (str "  update-in: " (update-in data [:app :users 0 :hits] optics/inc)))
(println (str "  optics:    " (optics/over (optics/*> (optics/in :app) (optics/in :users) (optics/idx 0) (optics/in :hits)) optics/inc data)))

(println "== all of them: update-in has no spelling for this ==")
(println (str "  before:    " data))
(println (str "  optics:    " (optics/over (optics/*> (optics/in :app) (optics/in :users) optics/traversed (optics/in :hits)) optics/inc data)))

(println "== optional: touch only the maps that have the key ==")
(println (str "  before:    " [{:name "Ada" :hits 41} {:name "Lin"}]))
(println (str "  optics:    " (optics/over (optics/*> optics/traversed (optics/optional :hits)) optics/inc [{:name "Ada" :hits 41} {:name "Lin"}])))
