; sets.bl — sets in real use.
; Run: mix beam_lisp.run examples/sets.bl
;
; beam-lisp sets are backed by Elixir's MapSet (BeamLisp.Set). They are
; distinct from vectors and maps (a set is a struct, so `map?` is false
; but `coll?` is true), membership is hash-based, and `conj`/`disj` add
; and remove idempotently. `#{...}` literals are a reader-level concern
; not yet wired, so sets are built with `(set coll)` here.

(defn print-sets []
  (let [fruits (set ["apple" "banana" "cherry" "apple" "banana"])
        guests (set ["alice" "bob"])
        rsvps  (set ["bob" "carol"])]
    (println (str "fruits (distinct): " (pr-str fruits)))
    (println (str "count: " (count fruits)))
    (println (str "has banana? " (contains? fruits "banana")))
    (println (str "has durian? " (contains? fruits "durian")))
    (println (str "fruits is a set, not a map: " (and (set? fruits) (not (map? fruits)))))
    (println (str "invite both guests: " (pr-str (conj guests "dave"))))
    (println (str "rsvps after bob cancels: " (pr-str (disj rsvps "bob"))))
    (println (str "union-ish via reduce conj: " (pr-str (reduce conj fruits ["elderberry" "fig"]))))
    (println (str "set vs vector distinct: " (not= (set [1 2]) [1 2])))))

(print-sets)
