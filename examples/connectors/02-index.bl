; examples/connectors/02-index.bl — one index over three services.
;
;     bl run examples/connectors/02-index.bl
;
; ── What this is ─────────────────────────────────────────────────────
;
; The thing no Google client can do. Every query below is a `datom/q` over
; DOMAIN relations — `:~msg/messages`, `:~file/files` — and not one of them
; names a provider, an endpoint, or Google. The same `:where` clause would run
; unchanged over an mbox, a CalDAV server, or a local directory, because the
; relations belong to the DOMAIN and a provider only BINDS its methods onto
; them.
;
; That is the whole thesis of `docs/connectors/an-api-is-a-relation.md`, and
; this file is its acceptance test: if the join needed a line of glue, or a
; provider name, the interface would be wrong.
;
; ── Why the call shape is still the same shape ───────────────────────
;
; There is no `connector/call` and no client object. A one-shot read is a
; fully-bound query; a list is a partly-bound one. The connector's
; contribution is RELATIONS, not verbs — which is why `datom/q` needed no
; change to reach three services at once, and why a third provider adds no
; code here at all.

(ns connectors.index
  (:require [datom]
            [msg]
            [files]
            [connector :as conn]
            [connector.google.gmail :as gmail]
            [connector.google.gdrive :as gdrive]
            [credential.store :as store]
            [credential.env :as env]))

;; ── the connection ───────────────────────────────────────────────────
;
; A connection is a spec (what the service is), a client (who the application
; is), and where the grant lives. It does NOT hold the grant — that expires and
; rotates, and a copy in a struct is a copy that goes stale while every reader
; believes it.

(def env-map (env/read-file ".env"))

(def client
  {:client-id (env/require! env-map "GOOGLE_OAUTH_CLIENT_ID")
   :client-secret (env/require! env-map "GOOGLE_OAUTH_CLIENT_SECRET")})

(def store-path
  (str (System/get_env "HOME") "/.local/share/beam-lisp/credentials"))

(def account-id
  (or (env/lookup env-map "GOOGLE_ACCOUNT_ID")
      (let [held (store/-list (store/store-file store-path))]
        (if (empty? held)
          (do (println "no account connected — run 01-authorize.bl first")
              (System/halt 1))
          (second (first (to-list held)))))))

(def st (store/store-file store-path))

(defn connect!
  "Provision one connection per aspect. `have!` is the promise that a relation
   can answer NOW; the relation reads the provisioned set at CALL time, so a
   relation registered before anything was connected starts answering the
   moment something is."
  [spec aspect]
  (conn/have! (conn/open spec {:service :google
                               :account-id account-id
                               :client client
                               :store st})
              aspect))

;; ── the queries ──────────────────────────────────────────────────────

(def db (datom/db (datom/connect)))

(defn banner! [s]
  (println "")
  (println (str "── " s " " (join "" (repeat (max 0 (- 66 (count s))) "─")))))

(defn show-messages! []
  (let [rows (datom/q '[:find ?subj ?from ?when
                        :where [(:~msg/messages) [?m ?subj ?from ?when]]]
                      db)]
    (banner! (str "messages: " (count rows)))
    (doseq [r (take 8 (sort-by (fn [x] (- (get x 2))) rows))]
      (println (str "  " (get r 2) "  "
                    (subs (str (get r 0)) 0 (min 46 (count (str (get r 0))))) "  ← "
                    (subs (str (get r 1)) 0 (min 30 (count (str (get r 1))))))))))

(defn show-files! []
  (let [rows (datom/q '[:find ?name ?when
                        :where [(:~file/files) [?f ?name ?when]]]
                      db)]
    (banner! (str "files: " (count rows)))
    (doseq [r (take 8 (sort-by (fn [x] (- (or (get x 1) 0))) rows))]
      (println (str "  " (get r 1) "  " (get r 0))))))

(defn search! [needle]
  (let [rows (datom/q '[:find ?subj ?from
                        :where [(:~msg/messages) [?m ?subj ?from ?when]]]
                      db)
        hits (filter (fn [r] (includes? (str (get r 0)) needle)) rows)]
    (banner! (str "matching " needle ": " (count hits)))
    (doseq [r (take 6 hits)]
      (println (str "  " (get r 0) "  ← " (get r 1))))))

;; ── the run ──────────────────────────────────────────────────────────

; Registration is an ACTION, not a load-time accident: an AOT-compiled
; namespace does not re-run its top-level effects, so a relation written as a
; bare call at the bottom of a file exists only in the VM that compiled it.
(msg/register!)
(files/register!)

(connect! gmail/spec :~msg/messages)
(connect! gdrive/spec :~file/files)

(banner! "one query, no provider named")
(show-messages!)
(show-files!)
(search! "AI")

(println "")
(println (str "account: " account-id "   (entities are composite: [:google <account> <remote-id>])"))
