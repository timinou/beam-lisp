; examples/connectors/03-keep-folder.bl — keep ONE real Drive folder, and watch
; what sync does, through the same console an app shows.
;
; Run (after 01-authorize.bl has stored a grant with drive.readonly):
;
;     bl run examples/connectors/03-keep-folder.bl                 ; lists My Drive's folders
;     bl run examples/connectors/03-keep-folder.bl -- FOLDER_ID     ; keeps that folder
;
; With a folder id it: opens (or reuses) a durable sync store under
; .local/examples/keep-<id>.fjall, takes the cursor, seeds the folder, runs one
; drain of a projection whose "library" is a map printed to the terminal, and
; prints the console. Run it again after adding, renaming, moving in/out, or
; trashing a file in Drive: the second run pages the change feed only.
;
; Nothing is ever written to Drive (drive.readonly). Nothing outside the folder
; is written to the store — the M1 law; `bl sync status --store PATH` shows it.

(ns connectors.keep-folder
  (:require [datom] [datom.store-fjall] [files]
            [datom.projection :as pj]
            [connector :as conn]
            [connector.keep :as keep]
            [connector.console :as console]
            [connector.google.gdrive :as gdrive]
            [credential.store :as store]
            [credential.env :as env]))

(files/register-under!)

(def env-map (env/read-file ".env"))
(def client {:client-id (env/require! env-map "GOOGLE_OAUTH_CLIENT_ID")
             :client-secret (env/require! env-map "GOOGLE_OAUTH_CLIENT_SECRET")})
(def store-path (str (System/get_env "HOME") "/.local/share/beam-lisp/credentials"))

(def account-id
  (or (env/lookup env-map "GOOGLE_ACCOUNT_ID")
      (let [held (store/-list (store/store-file store-path))]
        (if (empty? held)
          (do (println "no account connected — run 01-authorize.bl first") (System/halt 1))
          (second (first (to-list held)))))))

(def c (conn/open gdrive/spec {:service :google :account-id account-id :client client
                               :store (store/store-file store-path)}))
(def get (gdrive/get-via c))

(def DOC
  (pj/projection :example/doc
    {:active   '[[?scope :mount/state :active]]
     :member   '[[?scope :mount/root ?r] [?src :~file/live-under ?r] [:not [?src :file/folder? true]]]
     :revision '[[?src :file/rev ?rev]]}))

(def MOUNT-SCHEMA
  [{:db/ident :mount/id :db/valueType :db.type/string :db/unique :db.unique/identity}
   {:db/ident :mount/root :db/valueType :db.type/ref}
   {:db/ident :mount/state :db/valueType :db.type/keyword}])

(defn- list-folders []
  (let [r (gdrive/browse get account-id "root")]
    (if (contains? r :error)
      (println "Drive answered an error:" (pr-str (:error r)))
      (do (println "Folders in My Drive (pass one id after --):")
          (doseq [f (filter :folder? (:ok r))]
            (println (str "  " (nth (:key f) 2) "  " (:name f))))))))

(defn- keep-folder [folder-id]
  (File/mkdir_p! ".local/examples")
  (let [path (str ".local/examples/keep-" folder-id ".fjall")
        sc (datom/connect-with (datom.store-fjall/open path)
                               (-> (keep/full-schema) (into pj/schema) (into console/schema) (into MOUNT-SCHEMA)))
        root [:gdrive account-id folder-id]
        k {:conn sc :feed (gdrive/feed account-id) :get get :roots (fn [_] [root])}
        step (console/timed-step! sc k)]
    (println "step:" (pr-str step))
    (when (nil? (:error step))
      (datom/transact! sc [{:db/id -1 :mount/id "example" :mount/state :active
                            :mount/root (nth (first (into [] (datom/datoms (datom/db sc) :avet :conn/key root))) 0)}])
      (let [scope (first (first (into [] (datom/q '[:find ?m :where [?m :mount/id "example"]] (datom/db sc)))))
            opts {:scope-key "example" :concurrency 4
                  ;; the "library" of this example is the terminal: the
                  ;; target is just the revision seen, and nothing is downloaded
                  :apply (fn [row _]
                           (let [p (datom/pull (datom/db sc) [:file/name :file/mime] (:src row))]
                             (println (str "  + " (:file/name p) "  (" (:file/mime p) ")"))
                             {:target (:rev row)}))
                  :retire (fn [row _] (println (str "  - " (pr-str (:src-key row)))))}
            d (console/timed-drain! sc (keep/feed-key (:feed k)) DOC scope opts)]
        (println "drain:" (pr-str (dissoc d :errors)))
        (println)
        (println (console/render (console/snapshot sc {:feed (:feed k) :roots [root] :projection DOC
                                                        :scopes [{:scope scope :key "example"}]})))))
    (datom/close! sc)
    (println)
    (println (str "store: " path "   (inspect any time: bl sync status --store " path ")"))))

(let [argv (into [] (BeamLisp/argv))]
  (if (empty? argv) (list-folders) (keep-folder (first argv))))
