; examples/connectors/01-authorize.bl — connect a Google account, once.
;
; ── What this is ─────────────────────────────────────────────────────
;
; The whole of a Google connection, in one runnable file: read the client
; from `.env`, bind a loopback port, send a browser to Google, take the
; callback, trade the code for tokens, and store the grant 0600. Run it:
;
;     bl run examples/connectors/01-authorize.bl
;
; Then you click once. That is the only step a machine cannot do, and it is
; the reason the flow is split in two — everything on either side of the
; click is code, and the click is a person.
;
; ── Why there is no port literal ─────────────────────────────────────
;
; A hard-coded 8000 is a promise about a number, and a laptop with a dev
; server on 8000 breaks the promise. So the port is BOUND, not assumed:
; `credential.flow/begin!` binds and reads the number back off the socket.
;
; The one thing that can override that is the provider. A redirect URI is
; REGISTERED, and a client type decides how strictly it is compared: an
; installed-app client accepts loopback on any port (RFC 8252), while a web
; client must match the registered URI character for character. So the port
; is DERIVED from the registered URI when `GOOGLE_OAUTH_PORT` is unset —
; never typed here — and setting it to 0 asks for an ephemeral port, which
; is the right answer exactly when the registration allows it.
;
; ── The shape of a grant ─────────────────────────────────────────────
;
; Nothing here keeps a token in memory longer than it must, and nothing
; prints one. The account is keyed by the OIDC `sub` — the subject — and not
; by the email address, because an email can be reassigned and a subject
; cannot. The email is a LABEL, and it is stored as one.

(ns connectors.authorize
  (:require [credential.env :as env]
            [credential.oauth2 :as oauth]
            [credential.flow :as flow]
            [credential.store :as store]))

;; ── where things come from ───────────────────────────────────────────

(def ENV-FILE ".env")

(def STORE-DIR
  (str (System/get_env "HOME") "/.local/share/beam-lisp/credentials"))

(def SERVICE :google)

(def DEFAULT-SCOPES
  "`openid` and `email` first, and not as an afterthought: without `openid`
   Google returns no id_token, so there is no `sub`, so there is no stable
   account identity to key a grant on. The Calendar scope is the one this
   tree's existing client was registered for."
  ["openid"
   "email"
   "https://www.googleapis.com/auth/calendar.readonly"])

(defn- scopes
  "The scopes to ask for. Space-separated in `GOOGLE_OAUTH_SCOPES`, because
   that is how the consent screen and every console show them."
  [e]
  (let [raw (env/lookup e "GOOGLE_OAUTH_SCOPES")]
    (if (or (nil? raw) (= "" raw))
      DEFAULT-SCOPES
      (to-list (String/split (String/trim raw) " ")))))

(defn- config
  "Everything `begin!` needs, read from `.env`. The redirect falls back to
   the Calendar URI this tree already ships, because it is the registration
   that exists."
  [e]
  {:client-id (env/require! e "GOOGLE_OAUTH_CLIENT_ID")
   :client-secret (env/require! e "GOOGLE_OAUTH_CLIENT_SECRET")
   :redirect (or (env/lookup e "GOOGLE_OAUTH_REDIRECT_URI")
                 (env/require! e "GOOGLE_CALENDAR_REDIRECT_URI"))
   :scopes (scopes e)
   ;; `state` binds this URL to this run. It is not a secret; it is a
   ;; session binding, and a callback carrying a different one did not come
   ;; from the URL we printed.
   :state (binary/encode_hex (erlang/apply :crypto :strong_rand_bytes (list 16)))
   :port (let [p (env/lookup e "GOOGLE_OAUTH_PORT")]
           (if (nil? p) nil (erlang/binary_to_integer p)))})

;; ── the browser ──────────────────────────────────────────────────────

(defn- open-browser!
  "Ask the desktop to open `url` → :opened | [:failed why].

   A failure here is NOT fatal, and that is the point of returning it
   instead of raising: the URL is printed either way, so a headless
   machine, a container, or a box with no `xdg-open` is one paste away
   from working rather than stopped."
  [url]
  (if (some? (System/get_env "GOOGLE_OAUTH_NO_BROWSER"))
    :skipped
    (try
    (let [r (System/cmd "xdg-open" (to-list [url]))]
      (if (= 0 (elem r 1)) :opened [:failed (elem r 0)]))
    (catch e [:failed (ex-message e)]))))

;; ── reporting ────────────────────────────────────────────────────────

(defn- line! [s] (println s))

(defn- banner!
  [begun]
  (line! "")
  (line! "┌─ connect a Google account ───────────────────────────────────────┐")
  (line! (str "│ listening on 127.0.0.1:" (:port begun)))
  (line! (str "│ redirect_uri  " (:redirect begun)))
  (line! (str "│ scopes        " (count (:scopes begun))))
  (line! "└──────────────────────────────────────────────────────────────────┘")
  (line! "")
  (line! "Open this URL if your browser did not open:")
  (line! "")
  (line! (:url begun))
  (line! ""))

(defn- summarize!
  "What we got, with every secret replaced by its length. A summary that can
   be pasted into an issue is a summary worth printing."
  [grant]
  (line! "")
  (line! "┌─ connected ──────────────────────────────────────────────────────┐")
  (line! (str "│ account   " (:label grant)))
  (line! (str "│ subject   " (:account-id grant)))
  (line! (str "│ service   " (name (:service grant))))
  (line! (str "│ scopes    " (count (:scopes grant))))
  (line! (str "│ access    " (count (:access grant)) " chars, expires at " (:expires-at grant)))
  (line! (str "│ refresh   " (count (:refresh grant)) " chars (stored, never printed)"))
  (line! "└──────────────────────────────────────────────────────────────────┘")
  (line! ""))

;; ── the run ──────────────────────────────────────────────────────────

(def e (env/read-file ENV-FILE))
(def st (store/store-file STORE-DIR))
(def cfg (config e))

(if (< (count e) 1)
  (do (line! (str "no " ENV-FILE " found — put GOOGLE_OAUTH_CLIENT_ID and"))
      (line! "GOOGLE_OAUTH_CLIENT_SECRET in it (mode 0600, gitignored)."))
  (let [begun (flow/begin! cfg)
        _ (banner! begun)
        opened (open-browser! (:url begun))]
    (line! (cond (= :opened opened) "opened your browser."
                 (= :skipped opened) "GOOGLE_OAUTH_NO_BROWSER set — not opening one."
                 :else (str "could not open a browser: " opened)))
    (line! "waiting for you to approve… (this blocks until the callback lands)")
    (let [got (flow/finish! cfg begun)]
      (cond
        (= :declined (get got :error))
        (do (line! (str "declined: " (get got :reason)))
            (line! "nothing was stored. this is a normal outcome, not a failure."))

        (some? (get got :error))
        ;; WHAT WAS SENT, with every secret replaced by its length. A rejected
        ;; exchange is the one place guessing costs the most: Google answers
        ;; `invalid_grant` for a stale code, a replayed code, a verifier that
        ;; does not match and a redirect_uri that does not match — four
        ;; different repairs behind one word.
        (do (line! (str "could not finish: " (get got :error)))
            (when (some? (get got :reason))
              (line! (str "  provider said: " (get got :reason) " — " (get got :description))))
            (when (some? (get got :request))
              (line! "  sent (secrets as lengths):")
              (line! (str "    " (get got :request))))
            (when (nil? (get got :request))
              (line! (str "  " (pr-str got)))))

        :else
        (let [tok (get got :ok)
              claims (oauth/id-claims (:id-token tok))
              sub (if (nil? claims) nil (get claims "sub"))]
          (if (nil? sub)
            (do (line! "no id_token in the response — add `openid` to GOOGLE_OAUTH_SCOPES")
                (line! (str "raw fields: " (join ", " (to-list (keys (:raw tok)))))))
            (let [grant {:service SERVICE
                         :account-id sub
                         :label (get claims "email")
                         :access (:access tok)
                         :refresh (:refresh tok)
                         :scopes (:scopes tok)
                         :expires-at (:expires-at tok)
                         :obtained-at (erlang/system_time :millisecond)
                         :client-id (:client-id cfg)}]
              (store/-put st SERVICE sub grant)
              (summarize! grant)
              (line! (str "stored at " (store/-where st)))
              (line! (str "held accounts: " (pr-str (store/-list st)))))))))))
