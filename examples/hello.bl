; hello.bl — beam-lisp basics.
; Run: mix beam_lisp.run examples/hello.bl

(println "== values ==")
(println [1 :two "three"])           ; vectors are first-class
(println {:name "beam" :lang :lisp}) ; maps
(println '(a quoted list))           ; quote

(println "== functions ==")
(defn square [x] (* x x))
(println (map square (range 6)))

(println "== multi-arity + variadic ==")
(defn greet
  ( [] "hello, world")
  ( [name] (str "hello, " name))
  ( [name & others] (str "hello, " name " and " (count others) " others")))
(println (greet))
(println (greet "jank"))
(println (greet "a" "b" "c"))

(println "== loop/recur: constant stack ==")
(defn sum-to [n]
  (loop [i 0 acc 0]
    (if (< i n)
      (recur (inc i) (+ acc i))
      acc)))
(println (sum-to 1000000))

(println "== fns are recur targets too ==")
(defn fib [n]
  (let [step (fn [n a b] (if (= n 0) a (recur (dec n) b (+ a b))))]
    (step n 0 1)))
(println (str "fib(30): " (fib 30)))

(println "== destructuring ==")
(let [{:keys [name] :as person} {:name "beam" :host "the Erlang VM"}]
  (println (str name " runs on " (:host person))))
(let [[x y & more] (range 10)]
  (println (str "first two: " x ", " y "; " (count more) " more")))
