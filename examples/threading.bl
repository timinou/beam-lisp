; jank's threading macros, unmodified, running on the BEAM.
;
; This loads ->, ->> and doto byte-for-byte from jank's core.jank (see
; docs/jank-compat.md) and threads data through them. The macros carry
; source metadata with `with-meta`/`meta` on the forms they build — a
; layer that lives entirely on form data (compiler-controlled) and never
; leaks into the values. Only the "load the file" glue below is ours.

(ns threading.demo)

; --- load the upstream threading macros verbatim ---
(BeamLisp.Compiler/eval_string
  (File/read! "test/fixtures/jank/slice_10_thread_macro.bl")
  (BeamLisp.Compiler/new_env "threading.demo"))
(BeamLisp.Compiler/eval_string
  (File/read! "test/fixtures/jank/slice_11_thread_last_macro.bl")
  (BeamLisp.Compiler/new_env "threading.demo"))
(BeamLisp.Compiler/eval_string
  (File/read! "test/fixtures/jank/slice_18_doto.bl")
  (BeamLisp.Compiler/new_env "threading.demo"))

; --- use them, jank macros against BEAM data ---

; `->` threads x in as the second item of each form.
(println (str "->: " (-> 5 inc inc (* 10)))) ; ((5+1)+1)*10 = 70

; `->>` threads x in as the last item.
(println (str "->>: " (pr-str (->> [1 2 3] (map inc) (map inc))))) ; [3 4 5]

; `doto` calls every form on one value, returns the value.
(def box (doto (atom 0) (swap! + 10) (swap! + 5)))
(println (str "doto: " @box)) ; 15

; a threaded pipeline reads left-to-right: evens of 1..10, squared, summed.
(def total (->> (range 1 11) (filter even?) (map #(* % %)) (reduce +)))
(println (str "sum of squared evens 1..10: " total)) ; 220

(println "jank threading macros: OK")
