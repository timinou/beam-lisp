; 00-the-property-is-the-code.bl — fuzz, coverage, and hypothesis, from structure.
; Run: mix beam_lisp.run --path priv examples/fuzz/00-the-property-is-the-code.bl
;
; A beam-lisp function is a set of (guard → body) clauses. system.model reads
; that structure as DATA, so the "property" of a function is not something you
; write on the side — it is the clause set itself. Four checks fall out, each
; applying to ANY function with no bespoke test:
;
;   LINT       — do the guards leave a hole?              (static)
;   FUZZ/PROVE — does every input land in a clause?        (coverage, decidable)
;   HYPOTHESIS — does a property of the OUTPUT hold?        (refute + shrink)

(ns example.fuzz.demo
  (:require [fuzz]))

(defn- h [t] (println (str "\n── " t " ──")))
(defn- show [label v] (println (str "  " label "  " (pr-str v))))

; ── The functions under test — real guarded defns (from examples/guards.bl) ─

(def classify
  "(defn classify ([n] :when (pos? n) :positive) ([n] :when (neg? n) :negative))")

(def classify-fixed
  "(defn classify ([n] :when (pos? n) :positive) ([n] :when (neg? n) :negative) ([n] :when (zero? n) :zero))")

(def kind-partial
  "(defn kind ([x] :when (keyword? x) :keyword) ([x] :when (int? x) :int) ([x] :when (string? x) :string))")

(def safe-div
  "(defn safe-div ([a b] :when (not (zero? b)) (/ a b)) ([a b] :when (zero? b) :undefined))")

; ── 1. The property is READ from the code, not written ──────────────────────

(h "the property IS the function's clauses — read as data")
(show "classify guards:" (:guards (fuzz/shape-of classify)))
(show "safe-div params:" (:params (fuzz/shape-of safe-div)))

; ── 2. FUZZ finds the gap: an input no clause handles ───────────────────────

(h "fuzz over integers — classify forgets zero")
(let [r (fuzz/check classify (fuzz/ints -100 100 12) [0])]
  (show "verdict:" (:verdict r))
  (show "uncovered (the gap):" (:uncovered r)))

; ── 3. PROVE the edge is MANAGED once the code covers it ────────────────────

(h "prove: fix the code, and the edge is managed")
(show "buggy classify:" (fuzz/prove classify (fuzz/ints -100 100 20)))
(show "fixed classify:" (fuzz/prove classify-fixed (fuzz/ints -100 100 20)))

; ── 4. Type-partiality only shows over a MIXED domain ───────────────────────

(h "coverage is only as good as the domain's type spread")
(let [r (fuzz/check kind-partial (fuzz/mixed) [])]
  (show "kind-partial verdict:" (:verdict r))
  (show "uncovered types:" (:uncovered r)))

; ── 5. Multi-arg coverage ───────────────────────────────────────────────────

(h "multi-arg: safe-div covers both b=0 and b≠0")
(show "verdict:" (:verdict (fuzz/check safe-div (fuzz/pairs (fuzz/ints -5 5 3) (fuzz/ints -5 5 3)) [])))

; ── 6. HYPOTHESIS testing — a property of the OUTPUT, refuted and SHRUNK ─────

(h "a hypothesis that HOLDS: |n| is always non-negative")
(def my-abs "(defn my-abs ([n] :when (neg? n) (- 0 n)) ([n] :when (>= n 0) n))")
(show "(>= result 0):" (fuzz/hypothesis my-abs "(>= result 0)" (fuzz/ints -100 100 20)))

(h "a hypothesis that FAILS and SHRINKS to the minimal witness")
; a buggy double: off-by-one for n>50, so the result stops being even there
(def dbl "(defn dbl ([n] :when (> n 50) (+ (* 2 n) 1)) ([n] :when (<= n 50) (* 2 n)))")
(let [r (fuzz/hypothesis dbl "(= 0 (mod result 2))" (fuzz/ints 0 100 30))]
  (show "even? refuted, first witness:" (:witness r))
  (show "shrunk to minimal witness:" (:shrunk r))
  (show "  (51 is the exact boundary the bug begins at)" (:result r)))

(h "a hypothesis that catches a CRASH")
(def recip "(defn recip ([n] (/ 100 n)))")
(show "(number? result):" (fuzz/hypothesis recip "(number? result)" (fuzz/ints -10 10 10)))

(h "the point")
(println "  Nothing here wrote a test case. The COVERAGE property is read from")
(println "  the function's own guard heads; the HYPOTHESIS is one line about the")
(println "  output, checked against fuzzed inputs and shrunk to the simplest")
(println "  failure. Both apply to every clause by construction — and once the")
(println "  code covers an edge, `prove` flips to :holds true: the edge is")
(println "  MANAGED, proven from the structure, not asserted by hand.")
