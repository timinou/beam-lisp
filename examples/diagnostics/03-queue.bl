; Run: ./bin/bl -p priv/std run examples/diagnostics/03-queue.bl
; A controlled queue boundary with an explicit clock; no external work.
(ns examples.diagnostics.queue
  (:require [diagnostics :as diag] [proc.queue :as queue] [datom :as datom]))

(def captured (atom []))
(def clock (atom 1000))
(def server :diagnostics-example)
(def decl (queue/normalise-decl {:of :example/read :lease 1 :retry {:max 1}}))
(def c (queue/conn server))
(queue/register-perform! server
 (fn [_] (throw (ex-info "private failure" {:kind :transport}))))
(def initial (queue/init-state server decl #(deref clock)))
(queue/enqueue! server {:example/input "private fixture"} {:at 1000})
(def settled
  (diag/with-options {:sink #(swap! captured conj %)}
    (let [running (queue/run-due initial)]
      (receive [:bl-queue/finished ref out] (queue/settle running ref out)
        (after 2000 (throw (ex-info "fixture timed out" {})))))))
(def job (first (datom/q '[:find ?e :where [?e :job/state :failed]] (datom/db c))))
(def failure (:job/last-failure (datom/entity (datom/db c) (first job))))

; Reclaim a real job after its lease. An old owner cannot overwrite the new one.
(def next-job (queue/enqueue! server {:example/input "second private fixture"} {:at 1000}))
(def old-claim (queue/claim! c next-job 1000 1000))
(def new-claim (queue/claim! c old-claim 2001 1000))
(def old-entry {:e (:db/id old-claim) :token (:job/owner old-claim)
                :attempts (:job/attempts old-claim) :lease-until 2000})
(def old-state (assoc-in settled [:queue :running] {:old old-entry}))
(reset! clock 2001)
(diag/with-options {:sink #(swap! captured conj %)}
  ; Reports :lost even though the old worker returned normally.
  (queue/settle old-state :old {:ok :old-result})
  ; Frees the expired local slot; the new lease remains live in the store.
  (queue/run-due old-state)
  (queue/settle (assoc-in settled [:queue :running]
                  {:new {:e (:db/id new-claim) :token (:job/owner new-claim)
                         :attempts (:job/attempts new-claim) :lease-until 3001}})
                :new {:ok :new-result}))

{:failure failure
 :final-result (:job/result (datom/entity (datom/db c) (:db/id next-job)))
 :events (mapv #(dissoc % :diagnostics/at) @captured)}
