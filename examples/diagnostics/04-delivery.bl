(ns examples.diagnostics.delivery
  (:require [diagnostics :as diag] [diagnostics.otp :as otp]))
(def seen (atom []))
(def channel (otp/install! {:capacity 4 :writer #(swap! seen conj %)
                            :events {:example.worker/completed {:fields {:worker/items :count}}}}))
(try
  (diag/emit! :example.worker/completed {:worker/items 3 :document/text "private fixture"})
  (logger/error "private fixture")
  (finally (otp/uninstall! 1000)))
(assert (= 2 (count @seen)))
(assert (not (String/contains? (pr-str @seen) "private fixture")))
{:events (mapv :diagnostics/event @seen)
 :delivery (select-keys (diagnostics.delivery/stats channel) [:accepted :written :failed :pending])}
