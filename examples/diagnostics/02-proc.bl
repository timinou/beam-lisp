; Run: ./bin/bl -p priv/std run examples/diagnostics/02-proc.bl
(ns examples.diagnostics.proc
  (:require [diagnostics :as diag] [proc.fence :as fence] [proc.tick :as tick]))

(def captured (atom []))
(def outcomes
  (diag/with-options {:sink #(swap! captured conj %)}
    (diag/with-context {:diagnostics/operation-id "op_proc_demo"}
      (let [returned (fence/fence 500 (+ 20 22))
            timed-out (fence/fence 10 (Process/sleep 1000))]
        (tick/tick-failed! :fixture (ex-info "private exception fixture" {:kind :transport}))
        {:returned returned :timed-out timed-out
         :tick-failures (tick/tick-failures :fixture)
         :tick-last-failure (tick/tick-last-failure :fixture)}))))

; kill-requested? records a request, not proof of downstream cancellation.
{:outcomes outcomes :events (mapv #(dissoc % :diagnostics/at :proc.fence/duration-ms) @captured)}
