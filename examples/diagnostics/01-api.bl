; Run: ./bin/bl -p priv/std run examples/diagnostics/01-api.bl
(ns examples.diagnostics.api (:require [diagnostics :as diag]))

(def events {:example.reader/read {:fields {:reader/pages :count}}
             :example.reader/published {:fields {:reader/chunks :count}}})
(def captured (atom []))

(def result
  (diag/with-options {:sink #(swap! captured conj %) :events events}
    (diag/with-context {:diagnostics/operation-id "op_demo" :diagnostics/tenant-id "tenant_demo"}
      (diag/with-span :example.reader/read {:reader/pages 2}
        ; Short anonymous functions work today. Publication is a separate fact.
        (diag/with-span-fn :example.reader/read {} #(+ 40 2))
        (diag/emit! :example.reader/published {:reader/chunks 4 :document/text "private fixture"})
        42))))

{:result result
 :events (mapv #(dissoc % :diagnostics/at :diagnostics/span-id :diagnostics/parent-span-id) @captured)
 :context-after (diag/context)}
