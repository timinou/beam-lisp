; examples/sandbox/05-the-confused-deputy.bl — the leak the gate cannot see alone.
; Run: mix beam_lisp.run --path priv examples/sandbox/05-the-confused-deputy.bl
;
; ── The one attack the capability gate does NOT stop by itself ────────
;
; The gate governs code compiled INSIDE a capped env. It does not
; re-mediate a service that already runs at :global. So the classic
; confused-deputy shows up here too:
;
;     capped client  ──"read this for me"──▶  :global server
;                                                  │ has full authority
;                                                  ▼ does the read
;                     ◀──────the bytes─────────────┘
;
; The client couldn't read the file itself. But a helpful server, running
; with its OWN authority, does it on the client's behalf — and the caps
; system is none the wiser, because the server is allowed to read.
;
; The fix is not a new gate. It is CONVEYANCE: the server re-enters the
; CALLER's environment before doing the work, so the caller's ceiling —
; not the server's — governs. This is the setuid-doctrine rule made
; operational: a privileged wrapper must borrow the caller's authority,
; never lend its own.

(ns example.sandbox.deputy
  (:require [auth] [env]))

(defn- heading [t] (println (str "\n" t)))
(defn- show [label v] (println (str "  " label "  " (pr-str v))))

;; A String-only client sandbox — it may NOT read files.
(def root (auth/keypair))
(def token (auth/issue root [["right" "Elixir.String" "call"]]))
(defn- client-env []
  (:ok (auth/sandbox-fork (auth/public root) token
                          (auth/context {:policies [(auth/allow [])]}) :global)))

;; A secret only a File-capable actor should reach.
(def secret-path (str (System/tmp_dir) "/deputy-secret"))
(File/write secret-path "TOP-SECRET")

;; ── The naive deputy: serves anyone, with its own authority ─────────
;;
;; It runs at :global, so `File/read` inside it always works — no matter
;; who asked. We message it from a capped client and get the secret back.

(defn- naive-deputy []
  (erlang/spawn
    (fn []
      (receive
        [:read path from] (erlang/send from [:served (File/read path)])))))

(heading "── a naive :global deputy leaks its authority ──")
(def client1 (client-env))
(env/with-env client1
  (fn []
    (show "client may read files?" (env/allowed? "Elixir.File"))
    (let [srv (naive-deputy)]
      (erlang/send srv [:read secret-path (erlang/self)])
      (receive
        [:served data] (show "deputy handed back:" (elem data 1))))))
(env/destroy client1)

;; ── The conveying deputy: borrows the caller's authority ────────────
;;
;; The client sends its env token along. The deputy binds it — now it is
;; standing in the caller's world — and reaches the file through the
;; GATED interop path (a $remote handle, which re-checks caps at invoke).
;; The caller holds String only, so File is denied. The deputy cannot do
;; for the client what the client could not do for itself.

(def file-read (BeamLisp.RT/remote_fun :Elixir.File :read))

(defn- conveying-deputy []
  (erlang/spawn
    (fn []
      (receive
        [:read path caller-token from]
          (let [result (try
                         (do (env/bind caller-token)
                             [:served (BeamLisp.RT/invoke file-read (list path))])
                         (catch _ [:denied :file-not-in-callers-caps]))]
            (erlang/send from result))))))

(heading "── a conveying deputy is bound by the caller's ceiling ──")
(def client2 (client-env))
(env/with-env client2
  (fn []
    (let [srv (conveying-deputy)]
      (erlang/send srv [:read secret-path (env/capture) (erlang/self)])
      (receive
        [tag payload] (do (show "outcome:" tag)
                          (show "detail: " payload))))))
(env/destroy client2)

(File/rm secret-path)

(heading "── the point ──")
(println "  The gate stops a sandbox from DOING the act. It cannot, alone,")
(println "  stop a sandbox from ASKING a privileged process to do it. The")
(println "  answer is conveyance: a deputy that binds the caller's env acts")
(println "  with the caller's rights — so the confused deputy is un-confused.")
