; examples/sandbox/03-a-token-becomes-a-sandbox.bl — the token IS the caps.
; Run: mix beam_lisp.run --path priv examples/sandbox/03-a-token-becomes-a-sandbox.bl
;
; ── Where identity meets enforcement ──────────────────────────────────
;
; examples/auth/ ended with `authorize` — a pure decision. This is the
; next breath: `auth/sandbox-fork` authorizes a token AND, on allow,
; forks an env carrying exactly the rights the token's authority block
; granted. One call turns "who you are" into "the world your code runs
; in".
;
;     token grants right("Elixir.String", "call")
;               │  auth/sandbox-fork
;               ▼
;     env whose caps = {String}   ← code inside can call String, nothing else
;
; And the decision is honest both ways. A revoked token, or one past its
; TTL, returns {:error verdict} — NO env is forked. You never hold a
; sandbox that shouldn't exist; the verdict's :reason is the audit trail.

(ns example.sandbox.becomes
  (:require [auth] [env]))

(defn- heading [t] (println (str "\n" t)))
(defn- show [label v] (println (str "  " label "  " (pr-str v))))
(defn- caps-list []
  (let [c (env/caps)]
    (if (= c :all) :all (sort (Enum/map c (fn [m] (erlang/atom_to_binary m)))))))

;; ── Mint a token that grants String (and nothing else) ──────────────

(def root (auth/keypair))
(def root-pub (auth/public root))

;; A `right($module, "call")` fact is what sandbox-fork reads into caps.
(def token
  (auth/issue root [["user" "worker-7"]
                    ["right" "Elixir.String" "call"]]))

;; The verifier's context: what the runtime asserts and permits. An empty
;; allow means "allow if the checks pass"; no revocation ⇒ pure offline.
(defn- open-ctx []
  (auth/context {:policies [(auth/allow [])]}))

;; ── Allow → a sandbox appears ───────────────────────────────────────

(heading "── a valid token forks its sandbox ──")
(def result (auth/sandbox-fork root-pub token (open-ctx) :global))
(show "sandbox-fork:" (if (contains? result :ok) :OK-env-forked result))

(def sandbox (:ok result))
(env/with-env sandbox
  (fn []
    (show "caps in the sandbox:" (caps-list))
    (show "granted work:" (env/eval "(ns s.ok) (String/upcase \"worker\")"))
    (show "ungranted work:"
          (try (env/eval "(ns s.no) (File/read \"/etc/passwd\")")
               (catch _ :denied-at-COMPILE-time)))))
(env/destroy sandbox)

;; ── Deny → no sandbox at all ────────────────────────────────────────
;;
;; Revoke the token (add any of its block signatures to an oracle) and ask
;; again. sandbox-fork returns {:error verdict}; there is nothing to enter.

(heading "── a revoked token forks NOTHING ──")
(def oracle (auth/revocation-set (auth/revocation-ids token)))
(def revoked-ctx
  (auth/context {:policies [(auth/allow [])] :revocation oracle}))
(def denied (auth/sandbox-fork root-pub token revoked-ctx :global))
(show "sandbox-fork:" (if (contains? denied :error) :ERROR-no-env denied))
(show "verdict:" (:verdict (:error denied)))
(show "reason: " (:reason (:error denied)))

(heading "── the point ──")
(println "  You never fork on a maybe. The authorize and the fork are one")
(println "  atomic step: allow ⇒ exactly-scoped env, deny ⇒ no env and a")
(println "  reason you can record. A sandbox that shouldn't exist, doesn't.")
