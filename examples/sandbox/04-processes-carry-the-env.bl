; examples/sandbox/04-processes-carry-the-env.bl — spinning workers under a ceiling.
; Run: mix beam_lisp.run --path priv examples/sandbox/04-processes-carry-the-env.bl
;
; ── The whole reason BEAM exists is to spawn ──────────────────────────
;
; Real work here means processes: Task/async for parallelism, spawn for
; fire-and-forget, Agent/GenServer for state, a supervisor over the lot.
; So the honest question for a sandbox is not "what can this ONE process
; call?" but "what can the thousand workers it spawns call?".
;
; The answer is deliberate, and that is the point. An env binding does
; NOT ride `spawn`/`Task.async` automatically — a fresh process starts at
; :global unless told otherwise. `env/capture` + `env/bind` are how the
; ceiling crosses the process boundary ON PURPOSE:
;
;     parent:  tok  (env/capture)  ──▶  passed into the closure
;     child:   (env/bind tok)      ──▶  now runs under the parent's caps
;
; And `bind` re-derives caps from the env registry, never from the token
; bytes — so a stale or smuggled token carries NO rights. Fail closed.

(ns example.sandbox.processes
  (:require [auth] [env]))

(defn- heading [t] (println (str "\n" t)))
(defn- show [label v] (println (str "  " label "  " (pr-str v))))
(defn- caps-count []
  ; NB: `count` on a host MapSet is unreliable in bl (it sees the struct as
  ; one opaque value), so project to a list first, then count.
  (let [c (env/caps)]
    (if (= c :all) :all (count (Enum/map c (fn [m] m))))))

;; A String-only sandbox to spawn from.
(def root (auth/keypair))
(def token (auth/issue root [["right" "Elixir.String" "call"]]))
(def sandbox
  (:ok (auth/sandbox-fork (auth/public root) token
                          (auth/context {:policies [(auth/allow [])]}) :global)))

(env/with-env sandbox
  (fn []
    (show "this process's caps:" (caps-count))

    ;; ── A worker that does NOT carry the env starts at :global ──────
    ;;
    ;; This is the trap to understand: forget to convey, and your worker
    ;; runs with FULL authority — not the sandbox's. The boundary is
    ;; explicit precisely so this is visible, not silent.
    (heading "── a naive Task/async does NOT inherit the sandbox ──")
    (let [naive (Task/async (fn [] (env/caps)))]
      (show "naive worker sees:" (Task/await naive 5000)))

    ;; ── Carry the ceiling deliberately ─────────────────────────────
    (heading "── capture + bind carries the ceiling into the worker ──")
    (let [tok (env/capture)
          worker (Task/async
                   (fn []
                     (env/bind tok)
                     ;; inside the worker the sandbox rules again:
                     {:caps (caps-count)
                      :granted (env/eval "(ns w.ok) (String/downcase \"WORK\")")
                      :denied (try (env/eval "(ns w.no) (File/read \"/etc/passwd\")")
                                   (catch _ :denied-at-COMPILE-time))}))]
      (let [r (Task/await worker 5000)]
        (show "worker cap-count:" (:caps r))
        (show "worker granted:  " (:granted r))
        (show "worker denied:   " (:denied r))))

    ;; ── Fan out: many workers, one ceiling ─────────────────────────
    ;;
    ;; The pattern scales: capture once, bind in each worker. Every one
    ;; of them is bounded by the same caps — a fleet under a single
    ;; authority, which is exactly what a tenant's job should look like.
    (heading "── a fleet of workers, all under the same caps ──")
    (let [tok (env/capture)
          workers (Enum/map [1 2 3 4]
                    (fn [n]
                      (Task/async (fn [] (env/bind tok)
                                          [n (env/allowed? "Elixir.String")
                                             (env/allowed? "Elixir.File")]))))]
      (Enum/each workers
        (fn [w] (let [r (Task/await w 5000)]
                  (show (str "worker " (nth r 0) " String/File:")
                        [(nth r 1) (nth r 2)])))))))

(env/destroy sandbox)

;; ── A stale token grants nothing ────────────────────────────────────
;;
;; The sandbox is destroyed above. A worker that binds its captured token
;; NOW re-derives caps from the (gone) env registry — and gets the empty
;; set: String is no longer reachable. Authority cannot outlive the env
;; that granted it.
(heading "── binding a destroyed env's token fails CLOSED ──")
(let [stale (env/with-env sandbox (fn [] (env/capture)))
      ghost (Task/async (fn [] (env/bind stale)
                                [(env/allowed? "Elixir.String")
                                 (try (env/eval "(ns gh) (String/upcase \"x\")")
                                      (catch _ :denied))]))]
  (let [r (Task/await ghost 5000)]
    (show "ghost String reachable?" (nth r 0))
    (show "ghost String/upcase:   " (nth r 1))))

(heading "── the point ──")
(println "  Processes are the unit of work AND the unit of isolation. The")
(println "  ceiling crosses a spawn only when you carry it — capture/bind —")
(println "  and a token re-derives its rights live, so nothing stale or")
(println "  forged can smuggle authority into a worker.")
