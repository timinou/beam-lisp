; examples/sandbox/01-the-env-is-a-world.bl — an env is a world of callable code.
; Run: mix beam_lisp.run --path priv examples/sandbox/01-the-env-is-a-world.bl
;
; ── What an environment IS ────────────────────────────────────────────
;
; Every process runs inside an *environment*: a world that decides which
; host modules its code may call. Unbound, you are at `:global` — every
; module, all authority (`:all`). That is the parent every sandbox forks
; from.
;
; `(env/fork parent {:caps [...]})` makes a child world whose host-interop
; rights are NARROWED to the named modules. And the enforcement is not a
; runtime check you might forget — it happens at COMPILE time. Code that
; names an ungranted module never becomes bytecode at all. There is
; nothing to slip past, because the forbidden call was never born.

(ns example.sandbox.world (:require [env]))

(defn- heading [t] (println (str "\n" t)))
(defn- show [label v] (println (str "  " label "  " (pr-str v))))

;; A small helper: render this process's caps as sorted strings. (:all is
;; the ungated global; a fork carries a set of module atoms.)
(defn- caps-list []
  (let [c (env/caps)]
    (if (= c :all)
      :all
      (sort (Enum/map c (fn [m] (erlang/atom_to_binary m)))))))

;; ── At :global, everything is callable ──────────────────────────────

(heading "── the global world holds all authority ──")
(show "caps at :global:" (caps-list))
(show "String granted?" (env/allowed? "Elixir.String"))
(show "File granted?  " (env/allowed? "Elixir.File"))

;; ── Fork a world that may touch String, and nothing else ────────────

(heading "── fork a world scoped to String only ──")
(def sandbox (env/fork (env/current) {:caps ["Elixir.String"]}))

(env/with-env sandbox
  (fn []
    (show "caps in sandbox:" (caps-list))
    (show "String granted?" (env/allowed? "Elixir.String"))
    (show "File granted?  " (env/allowed? "Elixir.File"))

    ;; A GRANTED call compiles and runs. `env/eval` compiles new source
    ;; in the CURRENT env, so the gate applies to exactly this code.
    (heading "── granted code compiles and runs ──")
    (show "String/upcase:" (env/eval "(ns w.ok) (String/upcase \"hello\")"))

    ;; An UNGRANTED call never compiles. We catch the compile error to
    ;; keep the example running — but note WHEN it fires: before any
    ;; bytecode exists, not when the call would have executed.
    (heading "── ungranted code never becomes bytecode ──")
    (show "File/read:"
          (try (env/eval "(ns w.no) (File/read \"/etc/passwd\")")
               (catch _ :denied-at-COMPILE-time)))))

(env/destroy sandbox)

(heading "── the point ──")
(println "  A capability is not a runtime guard sprinkled over calls.")
(println "  It is the vocabulary of a world: ungranted names are unspeakable,")
(println "  so the forbidden call is a compile error, never a runtime surprise.")
