; examples/sandbox/06-the-audit-trail.bl — every verdict is a row.
; Run: mix beam_lisp.run --path priv examples/sandbox/06-the-audit-trail.bl
;
; ── "What happened" is a datalog question ─────────────────────────────
;
; A capability decision is not a log line to grep later — it is data. Each
; authorization, ALLOW and DENY alike, becomes one datom entity: which
; token, what verdict, the reason it was denied, the operation and
; resource it concerned. Transaction time comes free with the datom, so
; "what was this token allowed to do, and when?" is just a query.
;
; Denials are recorded as deliberately as grants. "Who was turned away,
; and why" is the exact question a security review runs — so it must be a
; row, not a silence.
;
; `auth/sandbox-fork-audited` does it all in one atomic step: authorize
; ONCE, record the verdict, and (on allow) fork the sandbox. One call, one
; row, one env — or one row and no env.

(ns example.sandbox.audit
  (:require [auth] [datom] [env]))

(defn- heading [t] (println (str "\n" t)))
(defn- show [label v] (println (str "  " label "  " (pr-str v))))

(def root (auth/keypair))
(def root-pub (auth/public root))

;; The audit store is an ordinary datom db — the verdict schema is just
;; attributes. You query it like any other data.
(def audit
  (datom/connect
    [{:db/ident :audit/token :db/valueType :db.type/string}
     {:db/ident :audit/verdict :db/valueType :db.type/keyword}
     {:db/ident :audit/reason :db/valueType :db.type/keyword}
     {:db/ident :audit/policy-index :db/valueType :db.type/long}
     {:db/ident :audit/operation :db/valueType :db.type/string}
     {:db/ident :audit/resource :db/valueType :db.type/string}]))

;; The request context asserts what is being attempted.
(defn- ctx []
  (auth/context {:facts [["operation" "read"] ["resource" "doc-42"]]
                 :policies [(auth/allow [])]}))

;; ── An allow leaves a row AND an env ────────────────────────────────

(heading "── alice is granted: a sandbox AND an audit row ──")
(def alice (auth/issue root [["user" "alice"] ["right" "Elixir.String" "call"]]))
(def a-result (auth/sandbox-fork-audited root-pub alice (ctx) :global audit))
(show "forked an env?" (contains? a-result :ok))
(when (contains? a-result :ok) (env/destroy (:ok a-result)))

;; ── A deny leaves a row and NO env ──────────────────────────────────
;;
;; A forged token (right key, wrong root). No sandbox is created — but the
;; refusal is recorded, with its reason.

(heading "── mallory is forged: no sandbox, but a recorded refusal ──")
(def other-root (auth/keypair))
(def mallory (auth/issue other-root [["user" "mallory"] ["right" "Elixir.File" "write"]]))
(def m-result (auth/sandbox-fork-audited root-pub mallory (ctx) :global audit))
(show "forked an env?" (contains? m-result :ok))
(show "verdict:" (:verdict (:error m-result)))
(show "reason: " (:reason (:error m-result)))

;; ── The trail is a query ────────────────────────────────────────────
;;
;; Read the whole history back: every decision, keyed by token id, with
;; its verdict and (for denials) its reason.

(heading "── the audit trail, read back as data ──")
(def db (datom/db audit))
(def rows
  (datom/q '[:find ?tok ?v
             :where [?e :audit/token ?tok]
                    [?e :audit/verdict ?v]]
           db))
(Enum/each (sort-by (fn [r] (pr-str (nth r 1))) rows)
  (fn [r]
    (show (str (subs (nth r 0) 0 12) "… verdict:") (nth r 1))))

(heading "── who was denied, and why (the security review's query) ──")
(def denials
  (datom/q '[:find ?tok ?reason
             :where [?e :audit/verdict :deny]
                    [?e :audit/token ?tok]
                    [?e :audit/reason ?reason]]
           db))
(Enum/each denials
  (fn [r] (show (str (subs (nth r 0) 0 12) "… denied:") (nth r 1))))

(heading "── the point ──")
(println "  The sandbox is the enforcement; the audit is the memory. Both")
(println "  allow and deny are rows, so 'what did we grant, to whom, when,")
(println "  and who did we turn away' is one datalog query over history —")
(println "  not a forensic reconstruction from log text.")
