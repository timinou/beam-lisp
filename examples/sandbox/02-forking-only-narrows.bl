; examples/sandbox/02-forking-only-narrows.bl — a fork can only take away.
; Run: mix beam_lisp.run --path priv examples/sandbox/02-forking-only-narrows.bl
;
; ── The one-way street ────────────────────────────────────────────────
;
; This is the same invariant that makes Biscuit attenuation safe, one
; layer down. A Biscuit block can only RESTRICT a token; an `env/fork`
; can only RESTRICT rights. The child's effective caps are:
;
;     child caps  =  parent caps  ∩  requested caps
;
; Intersection, always. Ask for a module the parent doesn't hold and you
; simply don't get it — there is no widening operation anywhere in the
; API. So authority flows strictly downward: a grandchild can never
; recover a right an ancestor gave up. You can reason about the whole
; tree by looking only at the path from the root.

(ns example.sandbox.narrows (:require [env]))

(defn- heading [t] (println (str "\n" t)))
(defn- show [label v] (println (str "  " label "  " (pr-str v))))
(defn- caps-list []
  (let [c (env/caps)]
    (if (= c :all) :all (sort (Enum/map c (fn [m] (erlang/atom_to_binary m)))))))

;; ── A parent that may touch String and Enum ─────────────────────────

(heading "── parent: {String, Enum} ──")
(def parent (env/fork (env/current) {:caps ["Elixir.String" "Elixir.Enum"]}))
(env/with-env parent (fn [] (show "parent caps:" (caps-list))))

;; ── A child asks for MORE than the parent holds ─────────────────────
;;
;; It requests String, Enum AND File. The intersection drops File — the
;; parent never had it to give.

(heading "── child asks for {String, Enum, File} → File is denied ──")
(def child (env/fork parent {:caps ["Elixir.String" "Elixir.Enum" "Elixir.File"]}))
(env/with-env child
  (fn []
    (show "child caps:" (caps-list))
    (show "File granted?" (env/allowed? "Elixir.File"))))

;; ── A grandchild narrows further, to String alone ───────────────────

(heading "── grandchild narrows to {String} ──")
(def grandchild (env/fork child {:caps ["Elixir.String"]}))
(env/with-env grandchild
  (fn []
    (show "grandchild caps:" (caps-list))
    ;; ...and it cannot claw Enum back, even though `child` still has it.
    (show "Enum granted?" (env/allowed? "Elixir.Enum"))
    (show "reclaim Enum in code:"
          (try (env/eval "(ns g.no) (Enum/count [1 2 3])")
               (catch _ :denied-narrowing-is-one-way)))))

(env/destroy grandchild)
(env/destroy child)
(env/destroy parent)

(heading "── the point ──")
(println "  There is no widen. fork ∩ spec is the only motion, so every")
(println "  descendant is weaker than every ancestor — the same monotonic")
(println "  guarantee attenuation gives a token, enforced on running code.")
