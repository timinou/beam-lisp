; aot_target.bl — the namespace aot_demo.bl compiles ahead of time.
; A plain .bl source, treated as a build input: mix compile.beam_lisp
; (or BeamLisp.AOT.compile_file) turns it into a BEAM module.

(ns examples.aot_target)

(defn shout [s] (str s " (AOT-compiled)"))

(defn sum-to [n]
  (loop [i 0 acc 0]
    (if (< i n)
      (recur (inc i) (+ acc i))
      acc)))
