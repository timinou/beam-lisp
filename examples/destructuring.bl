; destructuring.bl — Clojure-style map destructuring.
; :keys/:or give keyword lookup with defaults, :as keeps the whole
; map, and patterns nest. Docstrings are looked up with `doc`.
; Run: mix beam_lisp.run examples/destructuring.bl

(defn connect "Connect to a host, defaulting the missing bits."
  [{:keys [host port] :or {host "localhost" port 8080} :as cfg}]
  (println (str "connecting to " host ":" port " (cfg=" (count cfg) " keys)")))

(println "== :keys with :or defaults ==")
(connect {})
(connect {:host "db.internal" :port 5432})

; A nested pattern: the :tls value is itself a map, destructured in
; the parameter list.
(defn start "Start a server, reading the nested :tls map."
  [{:keys [port] {:keys [enabled]} :tls}]
  (println (str "port " port ", tls " enabled)))

(println "== nested map destructuring in a defn ==")
(start {:port 9090 :tls {:enabled true}})

(println "== docstrings ==")
(doc (quote connect))
(doc (quote start))
