; examples/deodorant.bl — removing the smell from generated code.
; Run: mix beam_lisp.run examples/deodorant.bl
;
; An agent writes `(if (not (map? x)) a b)`. It is correct. It is also
; noise: the language already has `if-not`. Deodorant is a curated
; ruleset over the `rewrite` engine that turns the long spelling into the
; word the language already has — mechanically, and only ever into a word
; that actually resolves.
;
; The whole contract is that every correction is a {pattern, replacement}
; rule you can read in priv/deodorant.bl. Nothing is guessed; the "after"
; is exactly the sum of the rules. This example shows the three things a
; caller does with them: correct one form, detect smells without touching
; anything, and pick a tier.

(ns deodorant.example
  (:require [deodorant :as deo]))

(println "== correct one form: the long spelling becomes the word ==")
(println (str "  " (pr-str (deo/deodorize '(if (not (map? x)) a b)))))
(println (str "  " (pr-str (deo/deodorize '(not (nil? user))))))
(println (str "  " (pr-str (deo/deodorize '(if ready (go) nil)))))

(println "")
(println "== corrections compose: one pass cleans a whole nesting ==")
(def messy '(defn handler [req]
              (if (not (map? req))
                (when (not (nil? (first (rest (get req :items)))))
                  (if (= (count req) 0) (+ i 1) (> n 0)))
                nil)))
(println (str "  before: " (pr-str messy)))
(println (str "  after:  " (pr-str (deo/deodorize messy))))

(println "")
(println "== detect without changing: a {smell -> count} report ==")
; This is the linter half. It walks every node and tells you what is
; there, so a pre-commit check can report smells and let a human decide.
(println (str "  " (pr-str (deo/report deo/all-rules messy))))

(println "")
(println "== two tiers: SAFE always, IDIOMATIC on request ==")
; `(= n 0)` is `(zero? n)` only when n is a number — true at a comparison
; against 0, but an assumption nonetheless. So it lives in the idiomatic
; tier: the safe ruleset leaves it alone, the full ruleset cleans it.
(println (str "  safe leaves it:  " (pr-str (deo/deodorize-with deo/safe-rules '(= n 0)))))
(println (str "  all cleans it:   " (pr-str (deo/deodorize-with deo/all-rules  '(= n 0)))))

(println "")
(println "== whole-file source pass ==")
; read -> correct -> print. NB: a form-level codemod normalizes layout and
; drops comments, which is why the primary API is per-form (clean a form
; as it is emitted); the source driver is for a batch report.
(def src "(defn ok? [r] (if (not (nil? r)) true false))\n(defn n [xs] (first (rest xs)))")
(println "  before:")
(println (str "    " (join "\n    " (split src "\n"))))
(println "  after:")
(println (str "    " (join "\n    " (split (deo/deodorize-source deo/all-rules src) "\n"))))

(println "")
(println "deodorant: OK")
