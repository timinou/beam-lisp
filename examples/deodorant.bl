; examples/deodorant.bl — removing the smell from generated code.
; Run: mix beam_lisp.run examples/deodorant.bl
;
; An agent writes `(if (not (map? x)) a b)`. It is correct. It is also
; noise: the language already has `if-not`. Worse, an agent writes a whole
; `(reduce (fn [acc x] (+ acc 1)) 0 xs)` — that is `count`, spelled the
; long way. Deodorant is a curated, tiered ruleset over the `rewrite`
; engine that turns the long spelling into the word the language already
; has — mechanically, and only ever into a word that actually resolves.
;
; The whole contract is that every correction is a {pattern, replacement}
; rule you can read in priv/std/deodorant.bl. Nothing is guessed; the "after"
; is exactly the sum of the rules.

(ns deodorant.example
  (:require [deodorant :as deo]))

(println "== correct one form: the long spelling becomes the word ==")
(println (str "  " (pr-str (deo/deodorize '(if (not (map? x)) a b)))))
(println (str "  " (pr-str (deo/deodorize '(not (nil? user))))))
(println (str "  " (pr-str (deo/deodorize '(if ready (go) nil)))))

(println "")
(println "== corrections compose: one pass cleans a whole nesting ==")
(def messy '(defn handler [req]
              (if (not (map? req))
                (when (not (nil? (first (rest (get req :items)))))
                  (if (= (count req) 0) (+ i 1) (> n 0)))
                nil)))
(println (str "  before: " (pr-str messy)))
(println (str "  after:  " (pr-str (deo/deodorize messy))))

(println "")
(println "== the payoff: catch a reinvented stdlib function ==")
; An agent reimplements `count`, `sum`, and a map-then-reduce by hand.
; These are the `:reinvention` tier — exact, but they restructure more of
; the form, so they are opt-in via `every-rule`.
(println (str "  count:      " (pr-str (deo/deodorize-with (deo/every-rule)
                 '(reduce (fn [acc x] (+ acc 1)) 0 items)))))
(println (str "  sum:        " (pr-str (deo/deodorize-with (deo/every-rule)
                 '(reduce (fn [acc x] (+ acc x)) 0 nums)))))
(println (str "  map+reduce: " (pr-str (deo/deodorize-with (deo/every-rule)
                 '(reduce (fn [a r] (+ a (val-fn r))) 0 rs)))))

(println "")
(println "== detect without changing: a {smell -> count} report ==")
; The linter half. It walks every node and tells you what is there, so a
; pre-commit check can report smells and let a human decide.
(println (str "  " (pr-str (deo/report (deo/every-rule) messy))))

(println "")
(println "== three tiers: SAFE always, IDIOMATIC/REINVENTION on request ==")
(println (str "  registered: " (count (deo/all-smells)) " smells"
              "  (safe " (count (deo/safe-rules))
              ", idiomatic " (count (deo/rules-of-tier :idiomatic))
              ", reinvention " (count (deo/rules-of-tier :reinvention)) ")"))
; `(= n 0)` is `(zero? n)` only when n is a number — true at a comparison
; against 0, but an assumption. So it lives in the idiomatic tier: the
; safe ruleset leaves it alone, the default (safe+idiomatic) cleans it.
(println (str "  safe leaves (= n 0):  " (pr-str (deo/deodorize-with (deo/safe-rules) '(= n 0)))))
(println (str "  default cleans it:    " (pr-str (deo/deodorize '(= n 0)))))

(println "")
(println "== map access: the interop call becomes the language's own word ==")
; `(Map/get m :k)` is Elixir spelled out; with a keyword-literal key the
; idiomatic forms are `(:k m)`, `(get m :k default)`, `(get-in m [:a :b])`.
; A GUARD confines the rule to keyword literals — `(Map/get m k)` with a
; variable or string key is left alone, because the key might not be a
; keyword at runtime.
(println (str "  " (pr-str (deo/deodorize '(Map/get req :opts)))))
(println (str "  " (pr-str (deo/deodorize '(Map/get req :opts {})))))
(println (str "  " (pr-str (deo/deodorize '(Map/get (Map/get req :opts {}) :cache?)))))
(println (str "  untouched (variable key): " (pr-str (deo/deodorize '(Map/get m k)))))
(println (str "  untouched (string key):   " (pr-str (deo/deodorize '(Map/get headers "authorization")))))

(println "")
(println "== fix a whole file in place, comments preserved ==")
; fix-source splices each smelled subform's exact source span and leaves
; everything else byte-for-byte; fix-file! writes it. The result is
; re-parsed before returning — the fixer never produces broken source.
(def fixable "(defn f [req]\n  ; this comment survives\n  (Map/get req :opts {}))\n")
(println (str (:source (deo/fix-source (deo/all-rules) fixable))))

(println "")
(println "== extend it: declare your own smell with defsmell ==")
; Rules are data and the registry is open. A project declares its house
; idioms in its own file; each `defsmell` auto-registers, no library edit.
; Here: this codebase prefers `str` over a manual `String/concat`.
(deo/defsmell string-concat->str :safe (String/concat ?a ?b) => (str ?a ?b))
(println (str "  after defsmell, registry: " (count (deo/all-smells)) " smells"))
(println (str "  your rule fires: "
              (pr-str (deo/deodorize-with (deo/every-rule) '(String/concat greeting name)))))

(println "")
(println "deodorant: OK")
