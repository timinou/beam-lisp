; vectors.bl — the persistent vector: a 32-way trie with a tail buffer,
; so append (conj) is amortized O(1) and indexed access is O(log32 n).
; Run: mix beam_lisp.run examples/vectors.bl

(println "== persistence: conj returns a new vector, the old is intact ==")
(def v0 [1 2 3])
(def v1 (conj v0 4))
(println "v0 (unchanged after conj):") (println v0)
(println "v1 (conj v0 4):")            (println v1)
(def v2 (conj v1 5))
(println "v0 is still:") (println v0)
(println "v1 is still:") (println v1)
(println "v2 (conj v1 5):") (println v2)

(println "== a large vector builds fast and reads by index ==")
; build 0..N by repeated conj — amortized O(1) each, not a quadratic copy.
; 20000 crosses both the tail→trie flush (32) and the first root depth
; growth (1056); the full 100k root-overflow build is benchmarked in
; test/beam_lisp/vector_trie_test.exs (@tag :bench, 12ms).
(def n 20000)
(def big
  (reduce (fn [acc i] (conj acc i)) [] (range n)))
(println (str "built " (count big) " elements"))
(println (str "first: " (nth big 0)
              " ; at 1000: " (nth big 1000)
              " ; last: " (nth big (dec n))))
(println (str "last equals n-1: " (= (nth big (dec n)) (dec n))))

(println "== nth is lenient out of range, first/rest work ==")
(println (str "nth past the end is nil: " (= (nth big n) nil)))
(println (str "first is " (first big)))
(println "rest drops the head:") (println (rest [7 8 9]))

(println "== vectors are not lists ==")
(println (str "[] == () ? " (= [] ())))
