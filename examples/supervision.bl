; supervision.bl — a supervision tree as data, and a crash it survives.
; Run: mix beam_lisp.run examples/supervision.bl
;
; A supervision tree IS a nested data structure, and Lisp is the
; language where that is literally true rather than a metaphor. The
; result is a real Elixir Supervisor: Supervisor/which_children and
; Supervisor/count_children work on it, and a killed child comes back.

(ns supervision.demo)

(println "== a supervised worker ==")

(def sup
  (supervise :one-for-one
    [(worker :w (fn [] (Process/sleep 60000)))]))

; which_children returns Erlang 4-tuples: {id, pid, type, modules}.
(defn child-pid [s]
  (erlang/element 2 (erlang/hd (Supervisor/which_children s))))

(def before (child-pid sup))
(println (str "child running: " (pr-str before)))
(println (str "tree:          " (pr-str (Supervisor/count_children sup))))

(println "")
(println "== kill it, and watch OTP put it back ==")

(erlang/exit before :kill)

; Poll for the replacement rather than sleeping a hopeful interval:
; the restart is asynchronous, so the only honest wait is one that
; checks. Bounded, so this example always terminates.
(defn wait-for-new [s old n]
  (if (zero? n)
    old
    (let [now (child-pid s)]
      (if (= now old)
        (do (Process/sleep 20) (wait-for-new s old (dec n)))
        now))))

(def after (wait-for-new sup before 100))

(println (str "restarted as: " (pr-str after)))
(println (str "same pid?     " (= before after)))
(println (str "still alive:  " (pr-str (Supervisor/count_children sup))))

(Supervisor/stop sup)
(println "")
(println "supervisor stopped.")
