; 10-ward-warm-runner.bl — a warm, isolated test runner that CANNOT be
; contaminated by a sibling file.
;
; Run: mix beam_lisp.run --path priv examples/reload/10-ward-warm-runner.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; A shared test image is fragile: one suite that stops a process or purges a
; module corrupts every suite after it, and a compiled test can pass while
; running STALE code. `ward` — built on the coherent-reload machinery — dissolves
; both, structurally:
;
;   ISOLATION       each file runs in its own env fork, destroyed on exit; no
;                   shared mutable state for one file to pull from another.
;   CRASH-CONTAINED a file that explodes at load is caught in its fork; the
;                   sibling still runs.
;   ALWAYS-LATEST   the SOURCE is evaluated fresh; there is no beam to go stale.
;   WARM            the test library loads once; each file forks off it.
;
; This demo runs four little "files" (source strings) through ward: one clean,
; one that references an undefined var, one that CRASHES at load, and one that
; proves it cannot see the first file's private state. Watch every misbehaving
; file be contained while the good ones stay green.

(ns example.reload.ward-demo
  (:require [reload.ward :as ward]))

;; ── four files, three of them adversarial ────────────────────────────────

(def clean
  "(ns demo.clean)\n(deftest arithmetic (is (= 4 (* 2 2))))\n")

;; references a var that exists nowhere — coherence WARNS, the call fails inside
;; the fork's try when it runs; the runner is untouched.
(def dangling
  "(ns demo.dangling)\n(deftest oops (is (= 1 (never-defined))))\n")

;; throws at LOAD time, before any test — the strongest contamination test.
(def explosive
  "(ns demo.explosive)\n(throw \"kaboom at load\")\n(deftest never (is true))\n")

;; proves ISOLATION: demo.clean defined nothing this file can reach.
(def isolated-proof
  (str "(ns demo.proof)\n"
       "(deftest cannot-see-clean\n"
       "  (is (= :isolated (try (env/eval \"demo.clean/arithmetic\")\n"
       "                        (catch _ :isolated)))))\n"))

;; ── run them all through ward ────────────────────────────────────────────

(println "── running four files through ward (one clean, three adversarial) ──\n")

(def result (ward/run (list clean dangling explosive isolated-proof)))

(println (ward/report result))

(println "\n── the shape of it ──")
(println (str "  clean + isolation-proof passed; the dangling and explosive files"))
(println (str "  were CONTAINED \u2014 neither could crash the run or corrupt a sibling."))
(println (str "  ok? = " (:ok? result) "  (not green, because two files misbehaved \u2014"))
(println (str "  which is exactly what a runner should report, having survived them)."))
