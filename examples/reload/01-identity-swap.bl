; 01-identity-swap.bl — redefine a pure fn; callers never notice.
;
; Run: mix beam_lisp.run --path priv examples/reload/01-identity-swap.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; A live namespace is DOWNSTREAM of its source: the running fn is a projection
; of the text, always. So redefining a pure function is an atomic per-var swap —
; the next call runs the new code, and a caller already in flight finishes on
; the code it started with. This is the simplest shape of the whole system.

(ns example.reload.identity
  (:require [reload] [env]))

(defn- call [expr] (env/eval expr))

(println "── redefine a pure fn, live ──\n")

;; commit a first version
(reload/stage "(ns app.greet)\n(defn hello [] \"v1: hello\")\n")
(println "  commit v1:" (:status (reload/commit)))
(println "  hello =>  " (call "(app.greet/hello)"))

;; edit it — same name, same shape (identity swap): callers are unaffected
(reload/stage "(ns app.greet)\n(defn hello [] \"v2: hi there\")\n")
(println "\n  commit v2:" (:status (reload/commit)))
(println "  hello =>  " (call "(app.greet/hello)"))

(println "\n── the shape of it ──")
(println "  The fn's identity (its name) is unchanged, so no caller can tell a")
(println "  swap happened — it just calls `hello` and gets the new answer. The")
(println "  running image tracked the source, atomically, with no restart.")
