; 02-dangling-half-bundle.bl — a half-finished edit is HELD; old code serves.
;
; Run: mix beam_lisp.run --path priv examples/reload/02-dangling-half-bundle.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; The transaction unit is the BUNDLE — the set of edits since the last coherent
; image — not one file, not one form. So an edit that leaves a dangling
; reference (a call to a name nothing defines) does NOT go live: the whole
; bundle is HELD, every reason printed, and the OLD code keeps serving, until a
; later edit completes it. This is the exact `undefined var` failure that a
; stale compiled beam once caused — made unrepresentable as an observable state.

(ns example.reload.dangling
  (:require [reload] [env]))

(defn- call [expr] (env/eval expr))

(println "── an edit that dangles is held, not applied ──\n")

;; a working function
(reload/stage "(ns app.pay)\n(defn charge [] :charged)\n")
(reload/commit)
(println "  charge =>" (call "(app.pay/charge)"))

;; edit it to call a helper that exists NOWHERE — incoherent
(println "\n  stage an edit calling an undefined `apply-fee`:")
(reload/stage "(ns app.pay)\n(defn charge [] (apply-fee))\n")
(let [r (reload/commit)]
  (println "  commit status:" (:status r)))

;; the live image is UNTOUCHED — charge still answers the old way
(println "\n  charge STILL =>" (call "(app.pay/charge)") "  ← old code served through the hold")

;; complete the bundle: define the helper too → coherent as a whole
(println "\n  now stage BOTH the helper and the caller together:")
(reload/stage "(ns app.pay)\n(defn apply-fee [] :fee)\n(defn charge [] (apply-fee))\n")
(println "  commit status:" (:status (reload/commit)))
(println "  charge =>" (call "(app.pay/charge)") "  ← the whole bundle landed atomically")

(println "\n── the shape of it ──")
(println "  At no instant did a caller of `charge` see a missing `apply-fee`.")
(println "  The incoherent window is unbounded and harmless: the bundle waits,")
(println "  the old code serves, and only a coherent whole is ever made live.")
