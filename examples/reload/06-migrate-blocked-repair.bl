; 06-migrate-blocked-repair.bl — a wrong migration is blocked, WITH a repair.
;
; Run: mix beam_lisp.run --path priv examples/reload/06-migrate-blocked-repair.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; Verification is not a grade, it is a gate: a migration that COULD break the
; new handler's invariant is :blocked at commit — before it ships, the process
; never stopping. And the checker does more than reject: it runs backwards and
; SYNTHESIZES the guard that would make the transition safe. Block becomes
; actionable.

(ns example.reload.migrate-repair
  (:require [reload.migrate :as mig] [system.core :as sys] [z3]))

(def port (z3/open))

; a GUARDED handler whose invariant (>= balance 0) discover-invariant finds.
(def acct-src
  (str "(defserver acct\n"
       "  (init [] (ok 100))\n"
       "  (handle-call [:withdraw amt] [_ balance] :when (>= balance amt)\n"
       "    (reply :ok (- balance amt))))"))
(def acct (first (BeamLisp.Reader/read_string acct-src)))
(def decls "(declare-const b1 Int)\n(declare-const b2 Int)\n")

(println "── a migration that could break balance ≥ 0 is BLOCKED at commit ──\n")
;; migrate: subtract 1000 — can drive the balance negative
(def bad (mig/migration {:strategy :reroute :decls decls
                         :v1 "b1" :v2 "b2" :migrate "(- b1 1000)"}))
(def br (mig/verify-migration port bad acct))
(println "  verified?:" (:verified br) "   reason:" (:reason br))
(println "  → the wrong migration never reaches a live mailbox.")

(println "\n── the checker also runs BACKWARDS: it synthesizes the fix ──")
;; repair-process needs an annotated handler with a BROKEN (unguarded) transition
;; — it returns the weakest guard that repairs it, checked forward.
(def broken-src
  (str "(defserver ^{:invariant (>= balance 0)} acct\n"
       "  (init [] (ok 100))\n"
       "  (handle-call [:withdraw amt] [_ balance]\n"       ; NO guard — the bug
       "    (reply :ok (- balance amt))))"))
(def broken (first (BeamLisp.Reader/read_string broken-src)))
(def repair (sys/repair-process port broken))
(println "  repair checked?:" (:checked repair) "  invariant holds as-is?:" (:holds repair))
(doseq [rp (:repairs repair)]
  (println (str "    " (:label rp) " repaired by guard:  " (:guard rp))))

(println "\n── the shape of it ──")
(println "  The migration is refused BEFORE it reaches a live mailbox, and the")
(println "  system tells you what would make it safe — synthesized backward,")
(println "  checked forward. A wrong upgrade never ships.")
