; 03-promise.bl — a promise holds the bundle until it is kept.
;
; Run: mix beam_lisp.run --path priv examples/reload/03-promise.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; `(declare later)` is a PROMISE: "a definition of `later` is coming." It is the
; static analogue of a message queued for a handler that does not exist yet — a
; commitment the bundle must honour before it can go live. An unkept promise
; holds the bundle; keeping it (defining the name) makes the whole thing
; coherent and applies it.

(ns example.reload.promise
  (:require [reload] [env]))

(defn- call [expr] (env/eval expr))

(println "── a declared-but-undefined promise holds the bundle ──\n")

;; declare `validate`, use it, but don't define it yet
(reload/stage "(ns app.form)\n(declare validate)\n(defn submit [] (validate))\n")
(let [r (reload/commit)]
  (println "  commit status:" (:status r))
  (println "  reasons:")
  (doseq [e (:errors r)]
    (println (str "    [" (name (:kind e)) "] " (:msg e)))))

;; keep the promise: define validate in the next edit → coherent
(println "\n  keep the promise — define `validate`:")
(reload/stage "(ns app.form)\n(declare validate)\n(defn submit [] (validate))\n(defn validate [] :valid)\n")
(println "  commit status:" (:status (reload/commit)))
(println "  submit =>" (call "(app.form/submit)"))

(println "\n── the shape of it ──")
(println "  A promise and a queued message are the same thing at two layers: an")
(println "  obligation the system refuses to run against until it is fulfilled.")
