; 05-migrate-verified.bl — an in-flight message migration, VERIFIED, no annotation.
;
; Run: mix beam_lisp.run --path priv examples/reload/05-migrate-verified.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; A message queued in a mailbox is an unfulfilled promise: the sender promised
; the receiver a value of a shape it handles. Change the receiver's contract and
; a migration must fulfil those messages under the new shape. For :reroute,
; verification is MANDATORY — and the relation the migration must preserve is
; DEDUCED from the new handler (its own inductive invariant), not written by
; hand. This rides the exact machinery `08_hot_upgrade` proves.

(ns example.reload.migrate-verified
  (:require [reload.migrate :as mig] [z3]))

(def port (z3/open))

;; the NEW account handler — no invariant annotation; discover-invariant finds
;; (>= balance 0) on its own.
(def acct-src
  (str "(defserver acct\n"
       "  (init [] (ok 100))\n"
       "  (handle-call [:withdraw amt] [_ balance] :when (>= balance amt)\n"
       "    (reply :ok (- balance amt))))"))
(def acct (first (BeamLisp.Reader/read_string acct-src)))
(def decls "(declare-const b1 Int)\n(declare-const b2 Int)\n")

(println "── R is DEDUCED — no annotation needed ──\n")
(def r (mig/deduce-r port acct))
(println "  discovered invariant:" (:raw r) "  (source:" (:source r) ")")

(println "\n── a good migration verifies ──")
;; migrate: keep the balance as-is (b2 := b1) — trivially preserves balance≥0
(def good (mig/migration {:strategy :reroute :decls decls
                          :v1 "b1" :v2 "b2" :migrate "b1"}))
(def gr (mig/verify-migration port good acct))
(println "  b2 := b1 verified?:" (:verified gr) " via" (:r-source gr))

(println "\n── the shape of it ──")
(println "  You wrote a handler and a migration; the system DISCOVERED the")
(println "  property the migration must respect and proved it holds — the wrong")
(println "  migration would be rejected before it ever touched a live process.")
