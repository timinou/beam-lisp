; 08-reroute.bl — transform in-flight messages to the new contract, no loss.
;
; Run: mix beam_lisp.run --path priv examples/reload/08-reroute.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; The REROUTE strategy moves DATA instead of time: when you cannot wait for the
; mailboxes to drain, transform each in-flight message to the new shape as it is
; delivered. A contract change then costs ZERO dropped messages — the legacy
; messages are upgraded on the way in, the new handler only ever sees the new
; shape.

(ns example.reload.reroute
  (:require [reload.migrate :as mig]))

(println "── upgrade in-flight messages to the new contract ──\n")

;; the contract tightens: bare `:inc` becomes `{:inc n}`. The migration fn is the
;; upgrade old-message → new-message.
(def m (mig/migration {:id :inc-amount
                       :modules ["counter"]
                       :strategy :reroute
                       :fn (fn [msg] (if (= msg :inc) {:inc 1} msg))}))

;; a mailbox holding a mix of legacy and already-new messages
(def in-flight [:inc {:inc 5} :inc {:inc 2}])

(println "  plan (speculative — commits nothing):")
(doseq [p (mig/plan m in-flight)]
  (println (str "    " (pr-str (:msg p)) "  →  " (pr-str (:migrated p))
                (if (:changed? p) "   (upgraded)" "   (already new)"))))

(println "\n  every legacy :inc becomes {:inc 1}; new-shape messages pass through,")
(println "  and NONE are dropped.")

(println "\n── the shape of it ──")
(println "  quiesce and reroute are a duality: quiesce moves time (wait for")
(println "  calm), reroute moves data (rewrite in flight). Together they cover")
(println "  every contract change — with a migration verified before it lands.")
