; 04-bundle-atomicity.bl — a new caller and its callee land together, or not at all.
;
; Run: mix beam_lisp.run --path priv examples/reload/04-bundle-atomicity.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; reload is NAMESPACE-LEVEL: the staged source is the whole namespace, applied as
; one atom. So introducing a CALLER of a NEW name is all-or-nothing — the caller
; and its callee must land in the same bundle, or the caller dangles and the
; whole bundle is held. (The other face of this atom is removal: a name the new
; source drops is truly gone — demo 02's rename shows that side.)

(ns example.reload.atomicity
  (:require [reload] [env]))

(defn- call [expr] (env/eval expr))

(println "── a caller of a new name needs its callee in the same bundle ──\n")

;; seed
(reload/stage "(ns app.report)\n(defn render [] :plain)\n")
(reload/commit)
(println "  render =>" (call "(app.report/render)"))

;; edit render to call a brand-new `header` — staged ALONE, it dangles
(println "\n  stage render calling a new `header`, alone:")
(reload/stage "(ns app.report)\n(defn render [] (header))\n")
(println "  commit status:" (:status (reload/commit)) "  ← held: `header` undefined")
(println "  render STILL =>" (call "(app.report/render)"))

;; land BOTH in one bundle → atomic
(println "\n  stage `header` AND `render` together:")
(reload/stage "(ns app.report)\n(defn header [] :HEADER)\n(defn render [] (header))\n")
(println "  commit status:" (:status (reload/commit)))
(println "  render =>" (call "(app.report/render)"))

(println "\n── the shape of it ──")
(println "  There is no intermediate image where `render` calls a `header` that")
(println "  is not there. The bundle is the atom of change; a partial edit is")
(println "  never observed.")
