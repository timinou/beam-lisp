; 09-web-monitor.bl — the final boss of monitorability: watch the running system,
; live, in a browser, and SEE migrations happen.
;
; Run:  mix beam_lisp.run --path priv examples/reload/09-web-monitor.bl
; Open: http://127.0.0.1:4041
; Then, in another terminal, edit a .bl file under the watched dir (printed at
; boot) and watch the browser update the instant the image changes — an applied
; swap in green, a held bundle in red with its reason, a message migration as it
; lands.
;
; ── The idea ──────────────────────────────────────────────────────────
;
; `reload/inspect` is the read-model; `reload/subscribe` pushes `[:reload/event …]`
; to a process on every commit. This server does two things:
;   1. serves the live image as an HTML page (server-rendered from render-view),
;   2. upgrades /ws to a WebSocket that subscribes to reload events and pushes a
;      fresh full render on each one.
; The browser is a pure sink: on every frame it swaps the monitor's innerHTML.
; One read-model, rendered in the terminal (demo below) and the browser (here) —
; they cannot disagree, because they render the same snapshot.

(ns example.reload.web-monitor
  (:require [reload]
            [reload.monitor :as mon]
            [live.hiccup :as h]
            [web]
            [interop]))

;; ── the watched directory: a scratch dir we also seed with a file ────────

(def watch-dir (str (System/tmp_dir!) "/bl-reload-web-demo"))

(File/mkdir_p! watch-dir)
(File/write! (str watch-dir "/orders.bl")
             "(ns shop.orders)\n(defn total [items] (reduce + 0 items))\n")

;; ── render the live image to a full HTML document ────────────────────────

(def page-style
  (str "*{box-sizing:border-box;margin:0}"
       "body{background:#0d1117;color:#e6edf3;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;padding:24px;line-height:1.5}"
       "h1{font-size:20px;margin-bottom:4px}.sub{color:#7d8590;font-size:13px;margin-bottom:20px}"
       ".monitor{max-width:1000px;margin:0 auto}"
       ".banner{display:flex;align-items:center;gap:10px;padding:12px 16px;border-radius:10px;font-weight:600;margin-bottom:18px}"
       ".banner-glyph{font-size:20px}"
       ".banner-applied{background:#132e1a;color:#4ac26b;border:1px solid #2ea04326}"
       ".banner-held{background:#2d1416;color:#f77;border:1px solid #f8514926}"
       ".banner-empty,.banner-staged{background:#161b22;color:#7d8590;border:1px solid #30363d}"
       ".columns{display:grid;grid-template-columns:1fr 1fr;gap:20px}"
       "h2{font-size:13px;text-transform:uppercase;letter-spacing:.05em;color:#7d8590;margin-bottom:10px}"
       ".ns-row{padding:10px 12px;background:#161b22;border:1px solid #30363d;border-radius:8px;margin-bottom:8px}"
       ".ns-name{font-weight:600;color:#79c0ff}.ns-count{float:right;color:#7d8590;font-size:12px}"
       ".ns-vars{margin-top:6px}.var-chip{display:inline-block;background:#21262d;color:#adbac7;padding:1px 7px;border-radius:5px;margin:2px 3px 0 0;font-size:12px}"
       ".ev{padding:8px 12px;border-radius:8px;margin-bottom:6px;font-size:13px;border-left:3px solid #30363d;background:#161b22}"
       ".ev-applied{border-left-color:#2ea043}.ev-held{border-left-color:#f85149}"
       ".ev-kind{font-weight:600}.ev-nses{color:#79c0ff;margin-left:8px}"
       ".ev-why{display:block;color:#f77;margin-top:3px}.ev-ok{color:#7d8590;margin-left:8px}"
       ".empty{color:#7d8590;padding:16px;text-align:center;background:#161b22;border-radius:8px}"))

(defn- monitor-html []
  (h/hiccup->html (mon/render-view (reload/inspect))))

(defn- page []
  (str "<!doctype html><html><head><meta charset=\"utf-8\">"
       "<title>beam-lisp · live reload monitor</title>"
       "<style>" page-style "</style></head><body>"
       "<h1>beam-lisp · live reload monitor</h1>"
       "<div class=\"sub\">the running image, live. edit a .bl file under the watched dir and watch it change.</div>"
       "<div id=\"monitor-root\">" (monitor-html) "</div>"
       "<script>"
       "var ws=new WebSocket((location.protocol==='https:'?'wss://':'ws://')+location.host+'/ws');"
       "ws.onmessage=function(e){document.getElementById('monitor-root').innerHTML=e.data};"
       "</script>"
       "</body></html>"))

;; ── the WebSocket: subscribe to reload, push a fresh render on each event ─

(defn- ws-init [_principal]
  ;; register this socket process for reload events, and push the current image
  ;; immediately so a fresh tab is never blank.
  (reload/subscribe (erlang/self))
  [:push (list (list :text (monitor-html))) {}])

(defn- ws-handle-in [_frame state]
  ;; the browser never sends us anything; ignore inbound frames.
  [:ok state])

(defn- ws-handle-info [msg state]
  ;; msg = [:reload/event ev] from reload/notify! → push a fresh full render.
  (if (and (sequential? msg) (= :reload/event (first msg)))
    [:push (list (list :text (monitor-html))) state]
    [:ok state]))

(def ws-handlers
  {:init ws-init
   :handle-in ws-handle-in
   :handle-info ws-handle-info})

;; ── HTTP routing ─────────────────────────────────────────────────────────

(defn router [conn]
  (web/route conn
    [:get "/ws"] (web/upgrade conn ws-handlers nil)
    [:get "/"]   (web/html conn (page))
    :else        (web/text conn 404 "not found")))

;; ── boot: start the watcher over the scratch dir, then serve ─────────────

(reload/subscribe (erlang/self))  ; keep the demo process itself in the loop

(BeamLisp.ReloadWatcher/start_link
  (interop/->kwlist {:dirs (list watch-dir) :auto_commit true}))

(web/serve {:port 4041 :plug router})

(println (str "\n── live reload monitor ──"))
(println (str "  watching:  " watch-dir))
(println (str "  open:      http://127.0.0.1:4041"))
(println (str "  try:       edit " watch-dir "/orders.bl and watch the browser\n"))

;; Park only when explicitly asked to keep serving — `BL_SERVE=1`. As a plain
;; example this returns immediately (so the examples harness runs it clean and
;; does not hang on a 24h sleep); to actually use the monitor, run it with the
;; server kept alive:
;;
;;   BL_SERVE=1 mix beam_lisp.run --path priv examples/reload/09-web-monitor.bl
(if (contains? #{"1" "true"} (System/get_env "BL_SERVE"))
  (Process/sleep 86400000)
  (println "  (set BL_SERVE=1 to keep the server running; returning now)"))
