; 07-quiesce.bl — "pending calmness": swap only once no message is in flight.
;
; Run: mix beam_lisp.run --path priv examples/reload/07-quiesce.bl
;
; ── The idea ──────────────────────────────────────────────────────────
;
; The QUIESCE strategy moves TIME instead of data: to change a handler's message
; contract safely, wait until no message belonging to the migrating modules is
; still in flight, THEN swap. "Calm" is not a sleep-and-hope — it is a QUERY over
; the live mailboxes, so the system can answer "are we calm yet?" precisely, and
; a driver swaps the instant the answer is yes.

(ns example.reload.quiesce
  (:require [reload.migrate :as mig]))

(println "── calmness is a query over live mailboxes ──\n")

(def m (mig/migration {:id :tighten-inc
                       :modules ["counter" "ledger"]
                       :strategy :quiesce}))

;; `mailbox-count` is injected: `module → in-flight count`. In production it is
;; the live-mailbox query; here we simulate a mailbox draining over time.
(defn- counts-at [t]
  ;; both modules busy at t=0, draining to empty by t=2
  (fn [_module] (max 0 (- 2 t))))

(doseq [t [0 1 2]]
  (let [calm (mig/calm? m (counts-at t))]
    (println (str "  t=" t "  in-flight=" ((counts-at t) "counter")
                  "  calm? " calm
                  (if calm "  → SWAP NOW" "  → wait")))))

(println "\n── the shape of it ──")
(println "  The swap is gated on an OBSERVABLE, queryable state — pending")
(println "  calmness — not a timer. When the mailboxes drain, the contract")
(println "  change lands with zero messages caught mid-flight.")
