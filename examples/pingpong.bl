; pingpong.bl — receive: pattern-matched messages in lisp syntax.
; Keyword, tuple/vector, and map patterns, plus after-timeout.
; Run: mix beam_lisp.run examples/pingpong.bl

(println "== an echo process with a receive loop ==")

(def me (erlang/self))

(defn echo-loop [me]
  (receive
    :ping
    (do (println "echo: :ping") (erlang/send me :pong) (echo-loop me))

    ; a vector pattern matches vectors AND Erlang tuples
    [:greet name]
    (do (println (str "echo: greet for " name))
        (erlang/send me [:greeted name])
        (echo-loop me))

    ; a map pattern
    {:cmd n}
    (do (println (str "echo: cmd " n)) (erlang/send me (* n 2)) (echo-loop me))

    :stop
    (println "echo: stopping")

    (after 5000 (println "echo: idle timeout"))))

(def echo (spawn (fn [] (echo-loop me))))

(erlang/send echo :ping)
(receive :pong (println "main: pong"))

(erlang/send echo [:greet "world"])
(receive
  [:greeted name] (println (str "main: greeted " name)))

(erlang/send echo {:cmd 21})
(receive
  n (println (str "main: doubled to " n)))

(println "== after-timeout ==")
(receive
  :never-comes (println "unreachable")
  (after 50 (println "main: timed out as planned")))

(erlang/send echo :stop)
(println "done")
