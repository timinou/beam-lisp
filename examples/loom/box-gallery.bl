; box-gallery.bl — a live pressure-test of the layout algebra, in the browser.
;
; Run:  BL_SERVE=1 mix beam_lisp.run --path priv examples/loom/box-gallery.bl
; Open: http://127.0.0.1:4048
;
; ── What this is ──────────────────────────────────────────────────────
;
; The box_test.bl suite proves the algebra maps to the RIGHT CSS. This proves
; the other half of sufficiency: that a lot of real arrangements, built from
; ONE primitive, actually LOOK GOOD together — and that the escape hatches let
; a page go past the vocabulary without fighting it. Resize the window to see
; the `:at` breakpoints reflow live.
;
; Every panel below is a point (or a few points) in the layout space. No panel
; reaches for a component library or a stylesheet — just `loom.box` and
; `loom.token`. The <style> block is COLLECTED from the classes the page used.

(ns example.loom.box-gallery
  (:require [loom.box :as b]
            [loom.token :as t]
            [live.hiccup :as h]
            [web]))

;; ── small local helpers for the demo (swatches, labels) ──────────────

(defn- swatch
  ([] (swatch (t/color :accent)))
  ([bg] (b/box {:w :6 :h :6 :bg bg :radius :sm})))

(defn- tile [label]
  (b/box {:pad :3 :bg :surface-2 :radius :md :align :center :justify :center
          :fg :text :min-h "48px"}
    label))


(defn- demo [title note specimen]
  (b/col {:gap :3 :pad :5 :bg :surface :radius :lg :border true
          :shadow :sm}
    (b/col {:gap :1}
      [:h3 {:class (t/sx {:font-size (t/text :lg) :font-weight (t/weight :semibold)
                          :color (t/color :text)})} title]
      [:p {:class (t/sx {:font-size (t/text :sm) :color (t/color :muted)
                         :line-height (t/tok :leading :normal)})} note])
    specimen))

;; ════════════════════════════════════════════════════════════════════
;; THE SPECIMENS — many configurations of one primitive
;; ════════════════════════════════════════════════════════════════════

(defn- s-directions []
  (demo "Direction & gap"
        "One primitive, four flows. :dir + :gap is the whole story."
    (b/col {:gap :4}
      (b/row {:gap :2} (tile "1") (tile "2") (tile "3"))
      (b/row {:gap :5} (tile "wide") (tile "gap"))
      (b/box {:dir :row-reverse :gap :2} (tile "a") (tile "b") (tile "c")))))

(defn- s-align-justify []
  (demo "Align & justify"
        "The two flex axes as data. Each row is the same box, one prop changed."
    (b/col {:gap :2}
      (b/row {:justify :between :bg :surface-2 :radius :md :pad :2}
        (swatch) (swatch (t/color :accent-2)) (swatch (t/color :success)))
      (b/row {:justify :center :gap :2 :bg :surface-2 :radius :md :pad :2}
        (swatch) (swatch) (swatch))
      (b/row {:justify :end :gap :2 :bg :surface-2 :radius :md :pad :2}
        (swatch) (swatch)))))

(defn- s-wrap []
  (demo "Wrap"
        "A row that wraps. Add items — they flow to the next line on the gap."
    (b/wrap {:gap :2}
      (for [i (range 12)]
        (b/box {:pad :2 :bg :surface-2 :radius :md :min-w "72px" :align :center :justify :center}
          (str "item " i))))))

(defn- s-grid []
  (demo "Grid — auto-fit"
        "A responsive grid with ZERO media queries: auto-fit + a min column."
    (b/grid {:min-col "120px" :gap :3}
      (for [i (range 8)]
        (b/box {:pad :4 :bg :surface-2 :radius :md :align :center :justify :center
                :fg :accent}
          (str "#" i))))))

(defn- s-grid-fixed []
  (demo "Grid — fixed columns"
        "Three equal columns; a raw template for the asymmetric one below."
    (b/col {:gap :3}
      (b/box {:grid 3 :gap :2}
        (tile "a") (tile "b") (tile "c") (tile "d") (tile "e") (tile "f"))
      (b/box {:grid "2fr 1fr" :gap :2}
        (b/box {:pad :3 :bg :accent :fg :accent-fg :radius :md} "2fr — main")
        (b/box {:pad :3 :bg :surface-2 :radius :md} "1fr")))))

(defn- s-sidebar []
  (demo "Sidebar + content"
        "A classic app shell: a fixed-basis aside, a growing main. One row."
    (b/row {:gap :3 :align :stretch}
      (b/col {:basis "160px" :shrink 0 :gap :2 :pad :3 :bg :surface-2 :radius :md}
        (tile "nav") (tile "nav") (tile "nav"))
      (b/col {:grow 1 :gap :2 :pad :3 :bg :surface-2 :radius :md}
        (b/box {:pad :5 :bg :surface-3 :radius :md :fg :muted} "main content grows to fill")))))

(defn- s-spacer []
  (demo "Spacer — push apart"
        "A toolbar: a title, a spacer that eats the slack, actions on the right."
    (b/row {:gap :2 :bg :surface-2 :radius :md :pad :3 :align :center}
      [:strong {:class (t/sx {:color (t/color :text)})} "Title"]
      (b/spacer)
      (b/box {:pad :2 :bg :surface-3 :radius :sm :fg :muted} "cancel")
      (b/box {:pad :2 :bg :accent :fg :accent-fg :radius :sm} "save"))))

(defn- s-responsive []
  (demo "Responsive — :at"
        "Column on narrow, row from :md up. RESIZE the window to see it flip."
    (b/box {:dir :col :gap :3 :at {:md {:dir :row}}}
      (b/box {:grow 1 :pad :5 :bg :accent :fg :accent-fg :radius :md :align :center :justify :center} "A")
      (b/box {:grow 1 :pad :5 :bg :accent-2 :fg :accent-fg :radius :md :align :center :justify :center} "B")
      (b/box {:grow 1 :pad :5 :bg :success :fg :accent-fg :radius :md :align :center :justify :center} "C"))))

(defn- s-hover []
  (demo "Stateful — :on"
        "A tile that lifts on hover. Pseudo-state is data, in the same class."
    (b/row {:gap :3}
      (for [c [:accent :accent-2 :success :danger]]
        (b/box {:pad :5 :bg :surface-2 :radius :lg :fg :text :align :center :justify :center
                :min-w "96px"
                :style {:cursor "pointer" :transition "transform 120ms, background 120ms"}
                :on {:hover {:background (t/color c) :color (t/color :accent-fg)
                             :transform "translateY(-3px)"}}}
          "hover")))))

(defn- s-escape []
  (demo "No ceiling — the escape hatch"
        "Props the algebra never modelled, via :style. A glass panel with a gradient."
    (b/box {:pad :6 :radius :xl :align :center :justify :center :min-h "120px"
            :style {:background "linear-gradient(135deg,#7c5cff,#5b8def)"
                    :backdrop-filter "blur(8px)"
                    :box-shadow "0 20px 60px rgba(124,92,255,.4)"
                    :color "white" :font-weight "600" :letter-spacing "0.5px"}}
      "arbitrary CSS, zero friction")))

;; ── the page ────────────────────────────────────────────────────────

(defn- specimens []
  [(s-directions) (s-align-justify) (s-wrap) (s-grid) (s-grid-fixed)
   (s-sidebar) (s-spacer) (s-responsive) (s-hover) (s-escape)])

(defn view []
  (b/col {:gap :7 :pad [:7 :5] :max-w "1100px"
          :style {:margin "0 auto"}}
    ;; header
    (b/col {:gap :2}
      [:h1 {:class (t/sx {:font-size (t/text :3xl) :font-weight (t/weight :bold)
                          :color (t/color :text) :line-height (t/tok :leading :tight)})}
       "loom · the box algebra"]
      [:p {:class (t/sx {:font-size (t/text :lg) :color (t/color :muted)
                         :line-height (t/tok :leading :normal)})}
       "Every panel below is a point in one layout space. One primitive, composed."])
    ;; a responsive gallery of the demo cards
    (into (b/grid {:min-col "320px" :gap :5}) (specimens))))

(defn page []
  (let [result (t/with-sheet view)]
    (str "<!doctype html><html lang=\"en\"><head>"
         "<meta charset=\"utf-8\">"
         "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
         "<title>loom · box gallery</title>"
         (h/hiccup->html (:style result))
         "</head><body>"
         (h/hiccup->html (:tree result))
         "</body></html>")))

;; ── serve (or render once) ──────────────────────────────────────────

(defn router [conn]
  (web/route conn
    [:get "/"] (web/html conn (page))
    :else      (web/text conn 404 "not found")))

(defn main []
 (if (contains? #{"1" "true"} (System/get_env "BL_SERVE"))
  (do
    (web/serve {:port 4048 :plug router})
    (println "\n-- loom box gallery --")
    (println "  open: http://127.0.0.1:4048")
    (println "  resize the window to see the :at breakpoints reflow.\n")
    (Process/sleep 86400000))
  (do
    ;; headless: render once, prove the page builds and collects styles
    (let [html (page)]
      (println "-- loom box gallery (headless) --")
      (println (str "  page bytes:    " (count html)))
      (println (str "  has <style>:   " (some? (index-of html "<style>"))))
      (println (str "  media queries: " (if (index-of html "@media (min-width") "present" "absent")))
      (println (str "  hover rules:   " (if (index-of html ":hover{") "present" "absent")))
      (println "  set BL_SERVE=1 to view it live.")))))

(when (not (Process/get :loom.catalog/indexing))
  (main))
