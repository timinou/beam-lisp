; form-gallery.bl — a form derived from a datom schema, shown live.
;
; Run:  BL_SERVE=1 mix beam_lisp.run --path priv examples/loom/form-gallery.bl
; Open: http://127.0.0.1:4052
;
; The thesis, demonstrated: a schema is a value, so a form is a projection of
; it. Change the schema below and the form changes — one field per attribute,
; the input kind chosen by the value type, the validation the same predicate
; the database uses. Nothing is hand-wired.

(ns example.loom.form-gallery
  (:require [loom.ui :as ui]
            [loom.box :as b]
            [loom.token :as t]
            [loom.form :as form]
            [live.hiccup :as h]
            [web]))

;; ── a real schema (the SAME shape you'd hand datom/connect) ─────────

(def person-schema
  [{:db/ident :person/name :db/valueType :db.type/string :db/unique :db.unique/identity
    :db/doc "Their full name, as they'd like it shown."}
   {:db/ident :person/email :db/valueType :db.type/string
    :db/doc "We only use it to sign you in."}
   {:db/ident :person/age :db/valueType :db.type/long}
   {:db/ident :person/role :db/valueType :db.type/keyword
    :form/enum [[:admin "Admin"] [:member "Member"] [:guest "Guest"]]}
   {:db/ident :person/newsletter :db/valueType :db.type/boolean
    :form/label "Send me the newsletter"}
   {:db/ident :person/bio :db/valueType :db.type/string :form/multiline true
    :db/doc "A sentence or two about yourself."}])

;; ── catalog entries ─────────────────────────────────────────────────

(defn ^{:catalog {:group "Data-driven" :title "Form from a schema"
                  :doc "One field per attribute, its input kind chosen by the value type. Change the schema, the form changes — nothing hand-wired."
                  :tags [:form :schema :data]}}
  demo-form []
  (form/form-for person-schema
    {:on-submit [:intent :save-person {}]
     :values {:person/name "Ada Lovelace" :person/role :member}
     :submit "Create account"}))

(defn ^{:catalog {:group "Data-driven" :title "Form with validation errors"
                  :doc "Errors are a plain map {attr → message}, rendered through the aria-wired field — announced to assistive tech, no extra work."
                  :tags [:form :schema :a11y]}}
  demo-form-errors []
  (form/form-for person-schema
    {:on-submit [:intent :save-person {}]
     :values {:person/name "Ada" :person/email "not-an-email" :person/age 200}
     :errors {:person/email "That doesn't look like an email address."
              :person/age "Age must be between 0 and 150."}
     :only [:person/name :person/email :person/age]
     :submit "Try again"}))

(defn ^{:catalog {:group "Data-driven" :title "Edit mode: identity locked"
                  :doc "With :edit? true, a unique-identity attribute renders read-only — you cannot change the key that identifies the row."
                  :tags [:form :schema]}}
  demo-form-edit []
  (form/form-for person-schema
    {:on-submit [:intent :update-person {}]
     :values {:person/name "Ada Lovelace" :person/email "ada@example.com" :person/role :admin}
     :edit? true
     :only [:person/name :person/email :person/role]
     :submit "Save changes"}))

;; ── page ─────────────────────────────────────────────────────────────

(def entries [demo-form demo-form-errors demo-form-edit])
(def titles ["Form from a schema" "With validation errors" "Edit mode: identity locked"])

(defn view []
  (b/col {:gap :6 :pad [:7 :5] :max-w "900px" :style {:margin "0 auto"}}
    (b/col {:gap :2}
      (ui/heading 1 "loom · forms from schema")
      (ui/prose {:tone :muted}
        "A schema is a value, so a form is a projection of it. The GoG lesson: derive the axis from the scale."))
    (into (b/col {:gap :5})
          (map (fn [ttl e]
                 (ui/card {}
                   (ui/heading 3 ttl)
                   (b/box {:style {:margin-top (t/space :3)}} (e))))
               titles entries))))

(defn page []
  (let [result (t/with-sheet view)]
    (str "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">"
         "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
         "<title>loom · forms from schema</title>"
         (h/hiccup->html (:style result))
         "</head><body>" (h/hiccup->html (:tree result)) "</body></html>")))

(defn router [conn]
  (web/route conn
    [:get "/"] (web/html conn (page))
    :else      (web/text conn 404 "not found")))

(defn main []
 (if (contains? #{"1" "true"} (System/get_env "BL_SERVE"))
  (do
    (web/serve {:port 4052 :plug router})
    (println "\n-- loom form gallery --")
    (println "  open: http://127.0.0.1:4052\n")
    (Process/sleep 86400000))
  (let [html (page)]
    (println "-- loom form gallery (headless) --")
    (println (str "  page bytes: " (count html)))
    (println (str "  has <form>: " (some? (index-of html "<form"))))
    (println (str "  has <select>: " (some? (index-of html "<select"))))
    (println "  set BL_SERVE=1 to view it live."))))

(when (not (Process/get :loom.catalog/indexing))
  (main))
