; token-gallery.bl — the scale itself, shown as swatches and rows.
;
; Run:  BL_SERVE=1 mix beam_lisp.run --path priv examples/loom/token-gallery.bl
; Open: http://127.0.0.1:4049
;
; ── What this is ──────────────────────────────────────────────────────
;
; loom/token holds the design DECISIONS as data: a colour ramp, a spacing
; scale, radii, a type scale, weights, shadows, breakpoints. Every other loom
; module reads them THROUGH box and ui, so the tokens rarely appear by name in
; app code. This gallery is where they appear directly: each demo calls a token
; resolver (`t/color`, `t/space`, `t/radius`, `t/text`, `t/weight`, `t/shadow`,
; `t/screen`, `t/len`, `t/hue`, `t/sx`) and paints its result, so the scale is
; visible and the resolvers are demonstrated.
;
; Built from loom/token + loom/box + loom/ui — the scale shows itself.

(ns example.loom.token-gallery
  (:require [loom.token :as t]
            [loom.box :as b]
            [loom.ui :as ui]
            [live.hiccup :as h]
            [web]))

;; ── a labelled swatch: a coloured chip over its token name and value ──

(defn- swatch [k]
  (b/col {:key k :gap :1 :align :center}
    (b/box {:w "56px" :h "56px" :radius :md
            :style {:background (t/color k)
                    :border (str "1px solid " (t/color :border))}})
    [:span {:class (t/sx {:font-size (t/text :xs) :color (t/color :text)
                          :font-family (t/tok :font :mono)})}
     (name k)]))

;; ════════════════════════════════════════════════════════════════════
;; THE CATALOG ENTRIES — each a ^:catalog defn whose body is the example
;; ════════════════════════════════════════════════════════════════════

(defn ^{:catalog {:group "Scale" :title "Colour"
                  :doc "The colour ramp: surfaces, text tones, and the semantic roles. `t/color` resolves a token to its hex; an off-scale key fails loud."
                  :tags [:scale :color]}}
  demo-color []
  (b/col {:gap :4}
    (b/wrap {:gap :3}
      (for [k [:bg :surface :surface-2 :surface-3 :border :border-2]] (swatch k)))
    (b/wrap {:gap :3}
      (for [k [:text :muted :faint]] (swatch k)))
    (b/wrap {:gap :3}
      (for [k [:accent :accent-2 :success :warning :danger]] (swatch k)))))

(defn ^{:catalog {:group "Scale" :title "Spacing"
                  :doc "The spacing scale, 0–10. `t/space` maps a step to its pixels; every gap and pad in loom is one of these, so rhythm stays consistent. The bar length IS the value."
                  :tags [:scale :space]}}
  demo-space []
  (b/col {:gap :2}
    (for [k [:1 :2 :3 :4 :5 :6 :7 :8]]
      (b/row {:key k :gap :3 :align :center}
        [:span {:class (t/sx {:width "28px" :font-size (t/text :xs)
                              :color (t/color :muted) :font-family (t/tok :font :mono)})}
         (name k)]
        (b/box {:h "14px" :radius :sm
                :style {:width (t/space k) :background (t/color :accent)}})
        [:span {:class (t/sx {:font-size (t/text :xs) :color (t/color :faint)
                              :font-family (t/tok :font :mono)})}
         (t/space k)]))))

(defn ^{:catalog {:group "Scale" :title "Radius"
                  :doc "The corner-radius scale. `t/radius` resolves a token; `t/len` accepts a token OR a raw value, so a one-off `\"3px\"` is never blocked."
                  :tags [:scale :radius]}}
  demo-radius []
  (b/wrap {:gap :4}
    (for [k [:sm :md :lg :xl :full]]
      (b/col {:key k :gap :1 :align :center}
        (b/box {:w "64px" :h "64px"
                :style {:background (t/color :surface-3)
                        :border (str "1px solid " (t/color :border-2))
                        :border-radius (t/radius k)}})
        [:span {:class (t/sx {:font-size (t/text :xs) :color (t/color :muted)
                              :font-family (t/tok :font :mono)})}
         (str (name k) " · " (t/radius k))]))))

(defn ^{:catalog {:group "Scale" :title "Type scale"
                  :doc "The type sizes and weights. `t/text` resolves a size, `t/weight` a weight. Each line is rendered at the size it names."
                  :tags [:scale :type]}}
  demo-type []
  (b/col {:gap :2}
    (b/col {:gap :1}
      (for [k [:xs :sm :md :lg :xl :2xl :3xl]]
        [:div {:key k
               :class (t/sx {:font-size (t/text k) :color (t/color :text)
                             :line-height (t/tok :leading :tight)})}
         (str "text " (name k) " — " (t/text k))]))
    (ui/divider)
    (b/row {:gap :4 :wrap true}
      (for [k [:normal :medium :semibold :bold]]
        [:span {:key k
                :class (t/sx {:font-weight (t/weight k) :color (t/color :text)
                              :font-size (t/text :lg)})}
         (name k)]))))

(defn ^{:catalog {:group "Scale" :title "Shadow"
                  :doc "The elevation scale. `t/shadow` resolves a box-shadow token; higher steps read as more lifted off the page."
                  :tags [:scale :shadow]}}
  demo-shadow []
  (b/wrap {:gap :5 :style {:padding (t/space :3)}}
    (for [k [:sm :md :lg :xl]]
      (b/col {:key k :gap :2 :align :center}
        (b/box {:w "72px" :h "72px" :radius :lg
                :style {:background (t/color :surface-2)
                        :box-shadow (t/shadow k)}})
        [:span {:class (t/sx {:font-size (t/text :xs) :color (t/color :muted)
                              :font-family (t/tok :font :mono)})}
         (name k)]))))

(defn ^{:catalog {:group "Scale" :title "Breakpoints"
                  :doc "The responsive breakpoints. `t/screen` resolves a min-width token — the same values box's `:at` overrides key off. Each bar is scaled to its width."
                  :tags [:scale :responsive]}}
  demo-screen []
  (b/col {:gap :2}
    (for [k [:sm :md :lg :xl :2xl]]
      (b/row {:key k :gap :3 :align :center}
        [:span {:class (t/sx {:width "32px" :font-size (t/text :xs)
                              :color (t/color :muted) :font-family (t/tok :font :mono)})}
         (name k)]
        (b/box {:h "10px" :radius :full
                :style {:width (str "calc(" (t/screen k) " / 12)")
                        :background (t/color :accent-2)}})
        [:span {:class (t/sx {:font-size (t/text :xs) :color (t/color :faint)
                              :font-family (t/tok :font :mono)})}
         (t/screen k)]))))

(defn ^{:catalog {:group "Scale" :title "Raw escape hatch"
                  :doc "The scale is the happy path, never a ceiling. `t/len` and `t/hue` take a token OR any raw value, so an app can always say something the vocabulary did not anticipate."
                  :tags [:scale :escape]}}
  demo-raw []
  (b/wrap {:gap :3 :align :center}
    ;; token inputs
    (b/box {:w (t/len :7) :h (t/len :7) :radius :md :style {:background (t/hue :accent)}})
    ;; raw inputs — passed straight through, no token needed
    (b/box {:style {:width (t/len "72px") :height (t/len 72)
                    :border-radius (t/radius :md)
                    :background (t/hue "linear-gradient(135deg,#5b8def,#7c5cff)")}})
    [:span {:class (t/sx {:font-size (t/text :xs) :color (t/color :muted)
                          :font-family (t/tok :font :mono)})}
     "token · raw · number"]))

;; ════════════════════════════════════════════════════════════════════
;; THE PAGE — arrange the entries into a gallery (headless-safe)
;; ════════════════════════════════════════════════════════════════════

(def entries
  [demo-color demo-space demo-radius demo-type demo-shadow demo-screen demo-raw])

(def entry-meta
  [["Scale" "Colour"] ["Scale" "Spacing"] ["Scale" "Radius"] ["Scale" "Type scale"]
   ["Scale" "Shadow"] ["Scale" "Breakpoints"] ["Scale" "Raw escape hatch"]])

(defn- demo-card-for [meta thunk]
  (b/col {:key (second meta) :gap :3 :pad :5 :bg :surface :radius :lg :border true :shadow :sm}
    (b/col {:gap :1}
      [:span {:class (t/sx {:font-size (t/text :xs) :color (t/color :faint)
                            :text-transform "uppercase" :letter-spacing "0.06em"})}
       (first meta)]
      (ui/heading 3 (second meta)))
    (thunk)))

(defn view []
  (b/col {:gap :7 :pad [:7 :5] :max-w "1100px" :style {:margin "0 auto"}}
    (b/col {:gap :2}
      (ui/heading 1 "loom · scale")
      (ui/prose {:tone :muted}
        "The design tokens, shown directly. Every other module reads these through box and ui; here they appear by name."))
    (into (b/grid {:min-col "340px" :gap :5})
          (map (fn [m e] (demo-card-for m e)) entry-meta entries))))

(defn page []
  (let [result (t/with-sheet view)]
    (str "<!doctype html><html lang=\"en\"><head>"
         "<meta charset=\"utf-8\">"
         "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
         "<title>loom · scale</title>"
         (h/hiccup->html (:style result))
         "</head><body>"
         (h/hiccup->html (:tree result))
         "</body></html>")))

(defn router [conn]
  (web/route conn
    [:get "/"] (web/html conn (page))
    :else      (web/text conn 404 "not found")))

(defn main []
  (if (contains? #{"1" "true"} (System/get_env "BL_SERVE"))
    (do
      (web/serve {:port 4049 :plug router})
      (println "\n-- loom scale gallery --")
      (println "  open: http://127.0.0.1:4049\n")
      (Process/sleep 86400000))
    (let [html (page)]
      (println "-- loom scale gallery (headless) --")
      (println (str "  page bytes:  " (count html)))
      (println (str "  has <style>: " (some? (index-of html "<style>"))))
      (println "  set BL_SERVE=1 to view it live."))))

(when (not (Process/get :loom.catalog/indexing))
  (main))
