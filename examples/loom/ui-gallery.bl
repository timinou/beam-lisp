; ui-gallery.bl — the loom component vocabulary, shown live and self-describing.
;
; Run:  BL_SERVE=1 mix beam_lisp.run --path priv examples/loom/ui-gallery.bl
; Open: http://127.0.0.1:4049
;
; ── What this is ──────────────────────────────────────────────────────
;
; Every component in loom/ui, rendered from ONE source of truth: each demo is a
; defn carrying `^:catalog` metadata (group, title, doc). The body returns the
; live example; the metadata is the catalog entry. The catalog tool
; (tooling/catalog.bl) reads THIS FILE to build itself — so a demo and its
; documentation can never drift, because they are the same form.
;
; Built entirely from loom/ui + loom/box + loom/token — the vocabulary
; demonstrates itself.

(ns example.loom.ui-gallery
  (:require [loom.ui :as ui]
            [loom.box :as b]
            [loom.token :as t]
            [live.hiccup :as h]
            [web]))

;; ════════════════════════════════════════════════════════════════════
;; THE CATALOG ENTRIES — each a ^:catalog defn whose body is the example
;; ════════════════════════════════════════════════════════════════════

(defn ^{:catalog {:group "Inputs" :title "Button"
                  :doc "The workhorse action. Variants and sizes; a disabled button carries no handler."
                  :tags [:input :action]}}
  demo-button []
  (b/col {:gap :3}
    (b/row {:gap :2 :wrap true}
      (ui/button {:variant :primary} "Primary")
      (ui/button {:variant :subtle} "Subtle")
      (ui/button {:variant :ghost} "Ghost")
      (ui/button {:variant :danger} "Danger"))
    (b/row {:gap :2 :align :center :wrap true}
      (ui/button {:size :sm} "Small")
      (ui/button {:size :md} "Medium")
      (ui/button {:size :lg} "Large")
      (ui/button {:disabled true} "Disabled"))))

(defn ^{:catalog {:group "Inputs" :title "Field"
                  :doc "A labelled input wired for assistive tech: label tied to input, error announced, hint described."
                  :tags [:input :form :a11y]}}
  demo-field []
  (b/col {:gap :2 :style {:max-width "360px"}}
    (ui/field {:name :email :label "Email" :value "ada@example.com"
               :hint "We never share it."})
    (ui/field {:name :pw :label "Password" :value "x" :type "password"
               :error "Must be at least 8 characters."})
    (ui/field {:name :bio :label "Bio" :multiline true
               :value "A short paragraph about yourself."})))

(defn ^{:catalog {:group "Inputs" :title "Checkbox & Select"
                  :doc "A boolean and a keyword choice, each labelled and tied to its control."
                  :tags [:input :form]}}
  demo-choice []
  (b/col {:gap :3 :style {:max-width "360px"}}
    (ui/checkbox {:name :agree :label "I agree to the terms" :checked true})
    (ui/checkbox {:name :news :label "Send me occasional updates"})
    (ui/select {:name :role :value :member
                :options [[:admin "Admin"] [:member "Member"] [:guest "Guest"]]})))

(defn ^{:catalog {:group "Surfaces" :title "Card"
                  :doc "A raised surface for grouping. A box with a border, radius, padding, and shadow."
                  :tags [:surface :layout]}}
  demo-card []
  (b/grid {:min-col "220px" :gap :3}
    (ui/card {}
      (ui/heading 3 "Plain card")
      (ui/prose {:tone :muted} "Content grouped on a raised surface."))
    (ui/card {:style {:border-color (t/color :accent)}}
      (ui/heading 3 "Accent border")
      (ui/prose {:tone :muted} "The :style escape hatch, on a component."))))

(defn ^{:catalog {:group "Surfaces" :title "Badge"
                  :doc "A small status pill. Tones map to the semantic colour roles."
                  :tags [:surface :status]}}
  demo-badge []
  (b/row {:gap :2 :wrap true :align :center}
    (ui/badge {:tone :default} "Default")
    (ui/badge {:tone :accent} "Accent")
    (ui/badge {:tone :success} "Live")
    (ui/badge {:tone :warning} "Beta")
    (ui/badge {:tone :danger} "Down")))

(defn ^{:catalog {:group "Surfaces" :title "Alert"
                  :doc "An announced message block (role=alert). Tones tint the leading border."
                  :tags [:surface :feedback :a11y]}}
  demo-alert []
  (b/col {:gap :2}
    (ui/alert {:tone :info} "A neutral, informational message.")
    (ui/alert {:tone :success} "Saved successfully.")
    (ui/alert {:tone :warning} "Your session expires soon.")
    (ui/alert {:tone :danger} "Something went wrong.")))

(defn ^{:catalog {:group "Surfaces" :title "Divider & Skeleton"
                  :doc "A hairline separator, and a loading placeholder hidden from assistive tech."
                  :tags [:surface :loading]}}
  demo-misc []
  (b/col {:gap :3 :style {:max-width "360px"}}
    (ui/prose {} "Above the line.")
    (ui/divider)
    (ui/prose {:tone :muted} "Below the line.")
    (b/col {:gap :2}
      (ui/skeleton {:h :5})
      (ui/skeleton {:h :5 :w "60%"}))))

(defn ^{:catalog {:group "Typography" :title "Headings & prose"
                  :doc "Typographic roles from the type scale. Levels 1-4 and toned body text."
                  :tags [:type]}}
  demo-type []
  (b/col {:gap :2}
    (ui/heading 1 "Heading 1")
    (ui/heading 2 "Heading 2")
    (ui/heading 3 "Heading 3")
    (ui/prose {} "Default body text at a relaxed line height.")
    (ui/prose {:tone :muted} "Muted secondary text.")
    (ui/prose {:tone :faint} "Faint tertiary text.")
    (ui/link {:href "#"} "A link →")))

;; ════════════════════════════════════════════════════════════════════
;; THE PAGE — arrange the entries into a gallery
;; ════════════════════════════════════════════════════════════════════

(def entries
  [demo-button demo-field demo-choice demo-card demo-badge demo-alert demo-misc demo-type])

(def entry-meta
  ;; kept in step with `entries` — the gallery header for each card. (The
  ;; catalog TOOL reads these from ^:catalog metadata; here we just label.)
  [["Inputs" "Button"] ["Inputs" "Field"] ["Inputs" "Checkbox & Select"]
   ["Surfaces" "Card"] ["Surfaces" "Badge"] ["Surfaces" "Alert"]
   ["Surfaces" "Divider & Skeleton"] ["Typography" "Headings & prose"]])

(defn- demo-card-for [meta thunk]
  (b/col {:gap :3 :pad :5 :bg :surface :radius :lg :border true :shadow :sm}
    (b/col {:gap :1}
      [:span {:class (t/sx {:font-size (t/text :xs) :color (t/color :faint)
                            :text-transform "uppercase" :letter-spacing "0.06em"})}
       (first meta)]
      (ui/heading 3 (second meta)))
    (thunk)))

(defn view []
  (b/col {:gap :7 :pad [:7 :5] :max-w "1100px" :style {:margin "0 auto"}}
    (b/col {:gap :2}
      (ui/heading 1 "loom · components")
      (ui/prose {:tone :muted}
        "Every component, from one source. Each card is a ^:catalog defn — the demo and its docs are the same form."))
    (into (b/grid {:min-col "340px" :gap :5})
          (map (fn [m e] (demo-card-for m e)) entry-meta entries))))

(defn page []
  (let [result (t/with-sheet view)]
    (str "<!doctype html><html lang=\"en\"><head>"
         "<meta charset=\"utf-8\">"
         "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
         "<title>loom · components</title>"
         (h/hiccup->html (:style result))
         "</head><body>"
         (h/hiccup->html (:tree result))
         "</body></html>")))

(defn router [conn]
  (web/route conn
    [:get "/"] (web/html conn (page))
    :else      (web/text conn 404 "not found")))

(defn main []
 (if (contains? #{"1" "true"} (System/get_env "BL_SERVE"))
  (do
    (web/serve {:port 4049 :plug router})
    (println "\n-- loom component gallery --")
    (println "  open: http://127.0.0.1:4049\n")
    (Process/sleep 86400000))
  (let [html (page)]
    (println "-- loom component gallery (headless) --")
    (println (str "  page bytes:  " (count html)))
    (println (str "  has <style>: " (some? (index-of html "<style>"))))
    (println (str "  role=alert:  " (if (index-of html "role=\"alert\"") "present" "absent")))
    (println (str "  data-ev:     " (if (index-of html "data-ev-") "present" "absent")))
    (println "  set BL_SERVE=1 to view it live."))))

(when (not (Process/get :loom.catalog/indexing))
  (main))
