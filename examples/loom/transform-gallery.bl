; transform-gallery.bl — the view is data, shown live.
;
; Run:  BL_SERVE=1 mix beam_lisp.run --path priv examples/loom/transform-gallery.bl
; Open: http://127.0.0.1:4051
;
; Each entry demonstrates a cross-cutting UI concern solved as a TRANSFORM over
; the view value — no framework feature, just the path-algebra applied to
; hiccup. The catalog indexes these under the group "The view is data".

(ns example.loom.transform-gallery
  (:require [loom.ui :as ui]
            [loom.box :as b]
            [loom.token :as t]
            [loom.transform :as tf]
            [live.hiccup :as h]
            [web]))

;; a small specimen view every transform will act on
(defn- specimen []
  (b/col {:gap :2}
    (ui/button {:variant :primary :on-click [:intent :save {}]} "Save")
    (ui/badge {:tone :accent} "accent")))

;; ════════════════════════════════════════════════════════════════════
;; CATALOG ENTRIES
;; ════════════════════════════════════════════════════════════════════

(defn ^{:catalog {:group "The view is data" :title "Retarget every handler"
                  :doc "A higher-order component as a VALUE: redirect every :on-click in a subtree through one pass. Here, every intent becomes an audited intent."
                  :tags [:transform :optics]}}
  demo-retarget []
  (let [original (specimen)
        audited (tf/retarget-events
                  (fn [_k v] (if (= :intent (first v)) [:intent :audited (nth v 2)] v))
                  original)]
    (b/row {:gap :5 :wrap true}
      (b/col {:gap :1} (ui/prose {:tone :faint} "original") original)
      (b/col {:gap :1} (ui/prose {:tone :faint} "→ retargeted")
        [:pre {:class (t/sx {:font-family (t/tok :font :mono) :font-size (t/text :xs)
                             :color (t/color :muted) :white-space "pre-wrap"})}
         (pr-str (get (nth (nth audited 2) 1) :on-click))]))))

(defn ^{:catalog {:group "The view is data" :title "A11y audit as a query"
                  :doc "An accessibility linter expressed as a SELECT over the tree: find every input with no way for a label to reach it."
                  :tags [:transform :specter :a11y]}}
  demo-audit []
  (let [tree [:div {}
              [:input {:id "ok" :type "text"}]
              [:input {:type "text"}]
              [:input {:aria-label "search" :type "text"}]
              [:textarea {}]]
        holes (tf/audit-missing-labels tree)]
    (b/col {:gap :2}
      (ui/prose {} (str "This tree has " (count holes) " unlabelled input(s):"))
      (for [hole holes]
        (ui/alert {:tone :warning}
          (str (tf/tag-of hole) " — no id, aria-label, or aria-labelledby"))))))

(defn ^{:catalog {:group "The view is data" :title "Aliases: extend the vocabulary"
                  :doc "A custom tag that expands to real hiccup, defined as a DATA rule (Replicant's aliases). A terse dialect that stays inspectable."
                  :tags [:transform :rewrite]}}
  demo-alias []
  (let [aliases {:ui/kbd (fn [_a cs]
                           (into [:span {:class (t/sx {:font-family (t/tok :font :mono)
                                                       :font-size (t/text :sm)
                                                       :padding (str (t/space :0) " " (t/space :2))
                                                       :background (t/color :surface-3)
                                                       :border (str "1px solid " (t/color :border))
                                                       :border-radius (t/radius :sm)})} ] cs))}
        authored [:div {} "Press " [:ui/kbd {} "Ctrl"] " + " [:ui/kbd {} "C"]]
        expanded (tf/expand-aliases aliases authored)]
    (b/col {:gap :2}
      (ui/prose {:tone :faint} "authored with a custom :ui/kbd tag →")
      expanded)))

(defn ^{:catalog {:group "The view is data" :title "Retheme a subtree"
                  :doc "Swap values throughout a tree in one pass — a colour change reaching into every :style map, because a style is just a value."
                  :tags [:transform :rewrite]}}
  demo-retheme []
  ;; retheme swaps values that live IN THE TREE — inline style strings, text,
  ;; attributes. (A `box` compiles :style to a hashed CSS class, so its colour
  ;; lives in the stylesheet, not the tree; inline style is what retheme reaches.)
  (let [swatch (fn [hex] [:div {:style (str "background:" hex ";color:white;padding:12px 16px;"
                                            "border-radius:8px;font-size:14px")} hex])
        tree [:div {:style "display:flex;gap:8px"} (swatch "#e5534b") (swatch "#e5534b")]
        rethemed (tf/retheme {(str "background:" "#e5534b" ";color:white;padding:12px 16px;border-radius:8px;font-size:14px")
                              (str "background:" "#3fb950" ";color:white;padding:12px 16px;border-radius:8px;font-size:14px")}
                             tree)]
    (b/col {:gap :2}
      (b/col {:gap :1} (ui/prose {:tone :faint} "original") tree)
      (b/col {:gap :1} (ui/prose {:tone :faint} "→ retheme red→green") rethemed))))

;; ════════════════════════════════════════════════════════════════════
;; PAGE
;; ════════════════════════════════════════════════════════════════════

(def entries [demo-retarget demo-audit demo-alias demo-retheme])
(def titles ["Retarget every handler" "A11y audit as a query"
             "Aliases: extend the vocabulary" "Retheme a subtree"])

(defn view []
  (b/col {:gap :6 :pad [:7 :5] :max-w "1000px" :style {:margin "0 auto"}}
    (b/col {:gap :2}
      (ui/heading 1 "loom · the view is data")
      (ui/prose {:tone :muted}
        "Every panel solves a cross-cutting concern as a transform over the view value — no new engine, just the path-algebra applied to hiccup."))
    (into (b/col {:gap :5})
          (map (fn [ttl e]
                 (ui/card {}
                   (ui/heading 3 ttl)
                   (b/box {:pad :4 :bg :bg :radius :md :style {:margin-top (t/space :2)}} (e))))
               titles entries))))

(defn page []
  (let [result (t/with-sheet view)]
    (str "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">"
         "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
         "<title>loom · the view is data</title>"
         (h/hiccup->html (:style result))
         "</head><body>" (h/hiccup->html (:tree result)) "</body></html>")))

(defn router [conn]
  (web/route conn
    [:get "/"] (web/html conn (page))
    :else      (web/text conn 404 "not found")))

(defn main []
 (if (contains? #{"1" "true"} (System/get_env "BL_SERVE"))
  (do
    (web/serve {:port 4051 :plug router})
    (println "\n-- loom transform gallery --")
    (println "  open: http://127.0.0.1:4051\n")
    (Process/sleep 86400000))
  (let [html (page)]
    (println "-- loom transform gallery (headless) --")
    (println (str "  page bytes: " (count html)))
    (println (str "  has <style>: " (some? (index-of html "<style>"))))
    (println "  set BL_SERVE=1 to view it live."))))

(when (not (Process/get :loom.catalog/indexing))
  (main))
