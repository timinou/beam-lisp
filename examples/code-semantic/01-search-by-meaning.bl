; examples/code-semantic/01-search-by-meaning.bl — ask the codebase a question
; in English, and get functions back.
;
; Run:
;   mix bl run --path priv --path examples examples/code-semantic/01-search-by-meaning.bl
;
; ── The question this answers ─────────────────────────────────────────
;
; `codebase.bl` already answers exact questions about beam-lisp's source: who
; calls X, what breaks if X changes, which functions return a string. Those
; questions have a NAME in the code, so grep and datalog both find them.
;
; The question a person actually starts with is different:
;
;     "where do we check that a transaction's schema is valid?"
;
; Nothing is named `check-transaction-schema-valid`. The words do not appear.
; The answer is `datom.tx/validate`, and the only way to reach it is to know
; what the code MEANS.
;
; ── What is on show ───────────────────────────────────────────────────
;
;   1. a real embedding model, running locally, over real beam-lisp source
;   2. the same question answered by keyword search, to show the difference
;   3. semantic AND structural in ONE query (nearest… among fns returning a tag)
;   4. "more like this" — a stored embedding used as a query vector
;
; ── The optional part ─────────────────────────────────────────────────
;
; The model is 33 MB of weights, downloaded — not source, not built. So this
; example is OPTIONAL by construction: with no model it fails with
; `code embeddings unavailable` and the example runner SKIPS it, rather than
; reporting a broken demo. Fetch once with `mix bl.embed.fetch`, and
; every run after that is offline.

(ns example.code-semantic.search-by-meaning
  (:require [code.embed] [code.semantic] [datom]))

;; ── the corpus ────────────────────────────────────────────────────────
;;
;; beam-lisp's own source: the database that stores the vectors, the query
;; engine that ranks them, and — because a demo should eat its own cooking —
;; the two namespaces that implement what you are reading.

(def CORPUS
  [["datom.vector"         "priv/lib/datom/vector.bl"]
   ["datom.tx"             "priv/lib/datom/tx.bl"]
   ["datom.conn"           "priv/lib/datom/conn.bl"]
   ["datom.query.analytic" "priv/lib/datom/query/analytic.bl"]
   ["datom.query.engine"   "priv/lib/datom/query/engine.bl"]
   ["codebase"             "priv/std/codebase.bl"]
   ["code.embed"           "priv/lib/code/embed.bl"]
   ["code.semantic"        "priv/lib/code/semantic.bl"]])

(defn- heading [text] (println (str "\n── " text " ──")))

(defn- show-hits
  "Print `rows` as `name  (line N)  score`."
  [rows]
  (doseq [r rows]
    (println (str "      " (:ns r) "/" (:name r)
                  "   line " (:line r)
                  "   " (:score r)))))

;; ── a keyword baseline, for contrast ──────────────────────────────────
;;
;; Deliberately the simplest honest thing: the words of the question, scored
;; by how many distinct question words appear in the function's source. This
;; is what "search" means without an embedding, and running it beside the
;; semantic result is the whole argument for the feature.

(defn- words [text]
  (filterv (fn [w] (> (count w) 3))
           (re/split (String/downcase text) "[^a-z]+")))

(defn- keyword-hits
  [docs query k]
  (let [ws (words query)]
    (->> (mapv (fn [d]
                 (let [low (String/downcase (:text d))
                       n (count (filter (fn [w] (some? (index-of low w))) ws))]
                   (assoc d :hits n)))
               docs)
         (filterv (fn [d] (> (:hits d) 0)))
         (sort-by (fn [d] (:hits d)) (fn [a b] (compare b a)))
         (take k))))

;; ── act 0: is the model here? ─────────────────────────────────────────
;;
;; `require-model!` is the gate. With no model it raises a message the example
;; runner classifies as an absent optional dependency — a skip, not a failure.

(heading "the model")
(code.embed/require-model!)
(println (str "      " (:model (code.embed/info))
              "  ·  " (:dim (code.embed/info)) "-dimensional"
              "  ·  " (:dir (code.embed/info))))

;; ── act 1: index the corpus ───────────────────────────────────────────

(heading "indexing")

(def conn (code.semantic/connect))
(def t0 (System/monotonic_time :millisecond))
(def indexed (code.semantic/index! conn CORPUS))
(def elapsed (- (System/monotonic_time :millisecond) t0))

(def docs (into [] (mapcat (fn [r] (code.semantic/documents (:ns r) (File/read! (:file r))))
                         indexed)))
(def db (datom/db conn))

(println (str "      " (count CORPUS) " files, "
              (get (code.semantic/stats db) :functions) " functions, "
              (get (code.semantic/stats db) :embedded) " embeddings, "
              (get (code.semantic/stats db) :calls) " call facts"
              "   in " elapsed " ms"))
(println "      each embedding is one more fact: [?e :fn/embedding ?v]")

;; ── act 2: a question with no matching words ──────────────────────────

(def Q1 "where do we check that a transaction's schema is valid")

(heading (str "Q: " Q1))

(println "    keyword search (any word over 3 letters, ranked by overlap):")
(let [kw (keyword-hits docs Q1 3)]
  (if (empty? kw)
    (println "      — nothing —")
    (doseq [d kw] (println (str "      " (:ns d) "/" (:name d) "   line " (:line d))))))

(println "    semantic search:")
(show-hits (code.semantic/search-text db Q1 5))

(println "\n    Keyword search can only match WORDS. All three of `transaction`,")
(println "    `schema` and `valid` do occur in this source — in prose comments, and")
(println "    in helpers that merely mention them — so it returns a plausible-looking")
(println "    list of functions that are not the answer. The semantic pass ranks by")
(println "    what the code DOES, and the top of its list is the transaction pipeline:")
(println "    the functions that install, check and run a schema. No word in the")
(println "    question appears in any of their names.")

;; ── act 3: the same question, asked as a datalog CLAUSE ───────────────
;;
;; `similar-to` is an ordinary clause, so it composes with the facts the way
;; any other clause does — the ranking and the structural filter are one
;; query, not two systems joined in application code.

(heading "the clause form: nearest, joined with facts")

(println "    [(similar-to :fn/embedding ?q 10) [?e ?score]] + [?e :fn/ns ?ns]")

(doseq [r (sort-by (fn [r] (get r 2)) (fn [a b] (compare b a))
                   (into [] (datom/q '[:find ?name ?ns ?score
                                       :in $ ?q
                                       :where [(similar-to :fn/embedding ?q 10) [?e ?score]]
                                              [?e :fn/name ?name]
                                              [?e :fn/ns ?ns]]
                                     db (code.embed/embed "packing floats into contiguous bytes"))))]
  (println (str "      " (get r 1) "/" (get r 0) "   " (get r 2))))

(println "\n    The order of the two clauses is the whole story, and it is easy to")
(println "    get backwards. `similar-to` GENERATES when the entity is free — the")
(println "    k nearest of everything, ranked — and the fact filter then narrows")
(println "    THAT list. It is nearest-then-filter. Filter-then-nearest is a")
(println "    different question, below.")

;; ── act 4: nearest WITHIN a set ───────────────────────────────────────
;;
;; "The k nearest among the functions that return a string" is NOT the same
;; question as "the nearest k, filtered" — and it cannot be written as one
;; either, because a clause sees one entity at a time. See the long note in
;; code.semantic: the set has to be visible at once, which is what this call
;; does and what the alternative silently gets wrong.

(heading "Q: nearest functions that RETURN a string, about building a name")

(println "    (corpus = fns whose return type may include \"string\")")
(show-hits (code.semantic/search-returning db (code.embed/embed "build a name from parts") "string" 5))

(heading "Q: how does the query engine rank things?   (within datom.query.engine)")

(show-hits (code.semantic/search-in-ns db (code.embed/embed "rank and order candidate rows") "datom.query.engine" 5))

;; ── act 5: more like this ─────────────────────────────────────────────
;;
;; A stored embedding IS a value, so it can be a query. No second system, no
;; id lookup, no re-embedding.

(heading "more like datom.vector/search")

(show-hits (code.semantic/similar db "search" 5))

;; ── what to take away ─────────────────────────────────────────────────

(heading "what to take away")

(println "      · an embedding is a FACT — same conn, same transaction, same time axis")
(println "      · so semantic and structural filters compose in ONE datalog query")
(println "      · nearest-neighbour is a CLAUSE: [(similar-to :fn/embedding ?q 10) [?e ?score]]")
(println "      · the model is optional, local, and 33 MB — no server, no API key, offline")
(println "")
(println "      it is ALSO not a replacement for grep: on the CoIR code-retrieval")
(println "      benchmark this model scores 39.1 NDCG@10 and BM25 scores 42.3 —")
(println "      together, 43.4. Keep both; that is why the feature is a clause you")
(println "      add, not a search engine you switch to.")
(println "")
(println "      next: 02-live.bl — the same index, kept live as you edit.")
