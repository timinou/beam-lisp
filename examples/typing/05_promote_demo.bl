; examples/typing/05_promote_demo.bl — MVP-E: deodorant × types.
;
; An idiomatic smell declares its type assumptions; wherever the type
; environment PROVES them, the match is promoted to safe — the checker
; discharges what the tier was only assuming. Where it cannot, the
; match stays idiomatic. Sound contract unchanged: no vetoes, no
; guesses.

(ns typed-promote-demo
  (:require [deodorant] [typed] [promote]))

(println "── MVP-E: type-discharged smell promotion ──")

; The solver-derived assumption, declared: MVP-C's prove-equiv answered
; SAT with countermodel tag_x = :string for (= x 0) → (zero? x), i.e.
; the rule is sound exactly when x : number. That assumption is data:
(deodorant/defsmell eq-zero→zero? :idiomatic (= ?x 0) => (zero? ?x) :needs '{?x int})

(def src
  "(ns m)
   (defn f [x]
     (if (int? x)
       (= x 0)        ; x narrowed to int HERE — assumption discharged
       (= x 1)))      ; hmm: also then-narrowed… no, else-branch: unproven
   (defn g [x] (= x 0))   ; param unannotated: any — stays idiomatic
   (defn h [] (= 5 0))    ; literal: provably int — discharged
   (defn k [] (= \"s\" 0)) ; literal string: DISPROVEN — never matches zero?
")

(def r (promote/report src))

(println "promoted to SAFE (assumptions discharged):")
(doall (map (fn [e]
              (println (str "  line " (:line e) ": " (:smell e))))
            (:promoted r)))

(println "stay idiomatic (unproven ≠ disproven):")
(doall (map (fn [e]
              (println (str "  line " (:line e) ": " (:smell e)
                            " — missing " (pr-str (:missing e)))))
            (:idiomatic r)))

(def promoted-lines (set (map (fn [e] (:line e)) (:promoted r))))
(def idiomatic-lines (set (map (fn [e] (:line e)) (:idiomatic r))))

; line 4: then-branch under (int? x) — x:int proven → PROMOTED
; line 6: g's unannotated param — any → stays idiomatic
; line 7: h's literal 5 — provably int → PROMOTED
; line 8: k's string literal — got :string, need :int → stays idiomatic
; (line 5's (= x 1) never matches the (= ?x 0) pattern at all)
(println (str (if (and (contains? promoted-lines 4)
                       (contains? promoted-lines 7)
                       (contains? idiomatic-lines 6)
                       (contains? idiomatic-lines 8))
                "PASS" "FAIL")
              ": MVP-E — the type checker promotes what it can prove"))
