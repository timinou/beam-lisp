; examples/typing/01_check_demo.bl — MVP-A: the checker, as a user
; experiences it. Run:
;   mix beam_lisp.run examples/typing/01_check_demo.bl
;
; A clean module with annotations runs for real; a buggy SNIPPET (never
; run — that's the point) is checked from source and produces positioned,
; delaborated warnings. Hover shows the evidence table.

(ns typing-demo-01
  (:require [typed]))

; ── the annotated module (runs; its ^ meta flows to the checker) ──────

(defn ^{:args [int] :ret int} double [x] (* x 2))

(defn clean [n]
  (if (int? n) (double n) 0))

(println "── MVP-A: typed/check-source ──")

; ── a buggy snippet, checked — never run ──────────────────────────────

(def buggy-src
  "(ns shop)
   (def order (->> \"5\" (double) (str)))
   (defn classify [x]
     (if (int? x)
       x
       (if (int? x) :still-int :not-int)))
   (def opts (:opts (double 5)))")

(def result (typed/check-source buggy-src "typing-demo-01"))

(println (str "warnings: " (count (:warnings result))))
(doall (map (fn [w]
              (println (str "  shop.bl:" (:line w) ":" (:col w)
                            "  " (:msg w))))
            (:warnings result)))

; ── hover: what does the checker think this expression is? ────────────

(def ev (:evidence result))
(println (str "hover over (double) in the ->>  → " (typed/hover ev 2 24)))

(println (str (if (= 3 (count (:warnings result))) "PASS" "FAIL")
              ": three bugs, each at the position the user wrote"))
