; examples/typing/07_errors_demo.bl — P11: error rendering (L12).
;
; Five archetypes, one rendering contract: file:line:col, the user's
; own line, a caret under the offending form, delaborated types.
; delaborated? is L12 as a predicate — no raw repr may survive.

(ns typing-demo-07
  (:require [typed] [errors] [deferred] [termination] [promote]
            [deodorant]))

(println "── P11: five error archetypes, one rendering ──")

; ── 1 + 2. argument mismatch & dead branch (typed) ────────────────────
; the callee is REAL — annotations flow through the P0 env pipe
(defn ^{:args [int] :ret int} double-it [x] (* x 2))
(def src1
  "(ns m)
   (defn buggy [] (double-it \"s\"))
   (defn dead [x] (let [s \"txt\"] (if (int? s) 1 2)))")
(reset! typed/warnings [])
(reset! typed/evidence {})
(def r1 (typed/check-source src1 "typing-demo-07"))
(def w1 (:warnings r1))
(println (str "  typed: " (count w1) " warnings"))
(doall (map (fn [w] (println (errors/render "m.bl" src1 w))) w1))

; ── 3. deferred, then proven (deferred) ───────────────────────────────
(reset! deferred/deferred [])
(reset! typed/warnings [])
(def file-a "(ns file-a)\n(defn use-it [] (helper \"s\"))")
(deferred/check-file-deferring file-a "file-a")
(defn ^{:args [int] :ret int} helper [x] (* x 2))
(def w3 (deferred/retry-deferred! "typing-demo-07"))
(println "  deferred, retried after helper loaded:")
(doall (map (fn [w] (println (errors/render "file-a.bl" file-a
                                           {:msg (:msg w)
                                            :line (if (= 0 (:line w)) 2 (:line w))
                                            :col 19})))
            w3))

; ── 4. termination rejection (termination) ────────────────────────────
(def src4 "(ns t)\n(defn badcount [n] (loop [i n] (if (> i 0) (recur (inc i)) i)))")
(def v4 (termination/check-source src4))
(def w4 {:msg (:detail (first v4)) :line 2 :col 37})
(println "  termination:")
(println (errors/render "t.bl" src4 w4))

; ── 5. smell promotion report (promote) ───────────────────────────────
(deodorant/defsmell eq-zero→zero? :idiomatic (= ?x 0) => (zero? ?x)
                    :needs '{?x int})
(def src5 "(ns s)\n(defn g [x] (= x 0))")
(def r5 (promote/report src5))
(def e5 (first (:idiomatic r5)))
(def w5 {:msg (str (:smell e5) ": stays idiomatic — unproven: "
                   (pr-str (map (fn [[v d]] (str (pr-str v) " : "
                                                 (pr-str (sort (into [] d)))))
                                (:missing e5))))
         :line (:line e5) :col (:col e5)})
(println "  promotion:")
(println (errors/render "s.bl" src5 w5))

; ── L12: no raw repr survives in ANY rendered output ──────────────────
(def all-rendered
  (str (errors/render-all "m.bl" src1 w1)
       (errors/render "file-a.bl" file-a {:msg (:msg (first w3)) :line 2 :col 19})
       (errors/render "t.bl" src4 w4)
       (errors/render "s.bl" src5 w5)))
(def leak (errors/delaborated? all-rendered))

(println (str (if (and (= 2 (count w1))
                       (= 1 (count w3))
                       (some? (index-of all-rendered "m.bl:2:"))
                       (some? (index-of all-rendered "file-a.bl:2:19"))
                       (some? (index-of all-rendered "t.bl:2:37"))
                       (some? (index-of all-rendered "s.bl:2:13"))
                       (some? (index-of all-rendered "^^"))
                       (nil? leak))
                "PASS" (str "FAIL" (if (nil? leak) "" (str " — leaked: " leak))))
              ": P11 — five archetypes, positioned, caret'd, delaborated"))
