; examples/typing/06_live_demo.bl — MVP-F: proven live queries.
;
; A live query re-runs on every relevant commit. That re-derivation is
; sound only when the query is MONOTONE — negation lets a new datom
; retract an old answer. live/register-live! gates on exactly that, and
; reports the callback's declared effect honestly.

(ns typing-demo-06
  (:require [datom] [datom.conn] [datom.store-map] [datom.watch]
            [live] [effects]))

(println "── MVP-F: proven live queries ──")

(def conn (datom.conn/connect-with
            (datom.store-map/open)
            [{:db/ident :order/id :db/valueType :db.type/long}
             {:db/ident :order/status :db/valueType :db.type/keyword}
             {:db/ident :order/total :db/valueType :db.type/long}]))

; a forwarding callback: delivery is a :process effect by nature
(def inbox (atom (erlang/self)))

(defn forward [d] (erlang/send (deref inbox) [:cb d]))

; a callback CLAIMING purity — the claim is checked file-wide below
(defn ^:pure pure-forward [d] (erlang/send (deref inbox) [:cb d]))

; ── 1. monotonicity gate ──────────────────────────────────────────────
(def shipped-q '[:find ?e :where [?e :order/status :shipped]])
(def not-q '[:find ?e :where [?e :order/id ?id]
                             [:not [?e :order/status :cancelled]]])

(def mono (live/check-query shipped-q))
(def nonmono (live/check-query not-q))
(println (str "  monotone query:  " (pr-str mono)))
(println (str "  negated query:   monotone=" (:monotone nonmono)
              " — " (:reason (first (:violations nonmono)))))

; ── 2. registration gate ─────────────────────────────────────────────
(def rejected (live/register-live! conn not-q [] "typing-demo-06" "forward"))
(println (str "  [:not …] registration: "
              (pr-str (get rejected :error :WRONGLY-ACCEPTED))))

; ── 3. a proven live query, end to end ────────────────────────────────
(def reg (live/register-live! conn shipped-q [] "typing-demo-06" "forward"))
(println (str "  monotone registration: ok=" (contains? reg :ok)
              ", callback effect reported: " (name (:callback-effect reg))))

(Process/sleep 30)
(datom/transact! conn [{:db/id -1 :order/id 1 :order/status :pending}])
(def silent (receive [:cb p] p (after 300 :silent)))
(datom/transact! conn [{:db/id -2 :order/id 2 :order/status :shipped}])
(def fired (receive [:cb p] p (after 1000 :silent)))
(println (str "  :pending fired? " (not (= :silent silent))
              " (must be false)"))
(println (str "  :shipped diff:  " (pr-str fired)))

; ── 4. the purity claim, proven file-wide ─────────────────────────────
; pure-forward CLAIMS ^:pure but calls erlang/send → :process.
; effects/check-purity-claims over this file must REJECT the claim.
(def own-src (second (erlang/tuple_to_list
                        (File/read "examples/typing/06_live_demo.bl"))))
(def liars (effects/check-purity-claims own-src))
(doall (map (fn [w] (println (str "  ✗ " (:name w)
                                 " claims ^:pure but has :"
                                 (name (:effect w)) " effect")))
            liars))

(datom.watch/unwatch (:ok reg))

(println (str (if (and (:monotone mono)
                       (not (:monotone nonmono))
                       (contains? rejected :error)
                       (contains? reg :ok)
                       (= :unknown (:callback-effect reg))  ; no claim = honestly unknown
                       (= :silent silent)
                       (not (= :silent fired))
                       (= 1 (count (filter (fn [w] (= "pure-forward" (:name w)))
                                           liars))))
                "PASS" "FAIL")
              ": MVP-F — monotone or no watch; effects are honest"))
