; examples/typing/02_codebase_demo.bl — MVP-B: the codebase as a
; database. Run:
;   mix beam_lisp.run examples/typing/02_codebase_demo.bl
;
; A small shop module is indexed from SOURCE (annotations read off the
; forms, return types inferred where missing), then the questions a
; developer actually asks become queries: what breaks if I change X?
; which fns return string? which calls don't line up?

(ns typing-demo-02
  (:require [codebase] [typed]))

(def sigs (merge typed/core-sigs typed/core-seeds-v2 typed/host-seeds))

(def SHOP
  "(ns shop)
   (defn ^{:args [int] :ret int} double [x] (* x 2))
   (defn ^{:args [int] :ret string} label [n] (str \"#\" n))
   (defn total [items] (reduce + 0 items))
   (defn describe [n]
     (str (label (double n)) \" of \" (total [n])))
   (defn main []
     (println (describe 5))
     (println (double 5 6))
     (println (watzit 3)))")

(def conn (codebase/connect-codebase))
(codebase/transact-source! conn sigs "shop" SHOP)
(def db (datom/db conn))
(def core (codebase/core-callee-names "shop"))

(println "── MVP-B: the codebase as a database ──")

(println "arity mismatches:")
(doall (map (fn [r] (println (str "  ✗ line " (nth r 3) ": " (nth r 0)
                                 " calls " (nth r 1) "/" (nth r 2))))
            (codebase/arity-mismatches db)))

(println "unknown callees:")
(doall (map (fn [r] (println (str "  ✗ line " (nth r 2) ": " (nth r 0)
                                 " calls undefined " (nth r 1))))
            (codebase/unknown-callees db core)))

(println (str "impact of double (who breaks if it changes): "
              (pr-str (codebase/impact db "double"))))
(println (str "reachable from main: "
              (pr-str (codebase/reachable db "main"))))
(println (str "fns that may return string: "
              (pr-str (codebase/find-by-type db "string"))))
(println (str "fns returning ONLY string: "
              (pr-str (codebase/find-returning-only db #{"string"}))))

; ── act 2: the checker, indexed as a codebase ─────────────────────────
; priv/typed.bl (~700 lines, the thing running right now) as facts:
; impact analysis over ITS call graph.

(def conn2 (codebase/connect-codebase))
(codebase/transact-source! conn2 sigs "typed"
  (second (File/read "priv/typed.bl")))
(def db2 (datom/db conn2))

(println "── act 2: priv/typed.bl as a database ──")
(println (str "fns indexed: "
              (count (datom/q (quote [:find ?name :where [?d :fn/name ?name]])
                              db2))))
(println (str "impact of t-meet (the lattice heart): "
              (pr-str (codebase/impact db2 "t-meet"))))
(println (str "unknown callees in typed.bl: "
              (pr-str (codebase/unknown-callees db2
                        (codebase/core-callee-names "typed")))))

(def names-of (fn [rows] (set (map (fn [r] (first r)) rows))))

(println (str (if (and (= 1 (count (codebase/arity-mismatches db)))
                       (= 1 (count (codebase/unknown-callees db core)))
                       (contains? (names-of (codebase/impact db "double")) "describe")
                       (contains? (names-of (codebase/find-by-type db "string")) "label")
                       (not (contains? (names-of (codebase/find-by-type db "string")) "double"))
                       (contains? (names-of (codebase/find-returning-only db #{"string"})) "label"))
                "PASS" "FAIL")
              ": the codebase answers questions"))
