; examples/typing/04_holes_demo.bl — MVP-D: holes and synthesis.
; Run: mix beam_lisp.run examples/typing/04_holes_demo.bl
;
; A program with a hole is a question. The typed checker finds the hole
; and its expected type; miniKanren answers with INHABITANTS —
; expressions of that type, in the local context. The relation is the
; same artifact that checks (forwards), refutes (sideways), and
; synthesizes (backwards): typeo.
;
; The mini language: int/string/bool literals, vars, (if c t e),
; (fn [x] body), (f a) — unary application, curried fns. Written here
; with the MACRO interface (conde/fresh/run), which is the point:
; recursive relations without hand-written delays.

(ns typing-demo-04
  (:require [minikanren :as mk]))

; env spine: [binding rest-env], binding = [sym type], empty = []
(defn lookupo [env x t]
  (mk/conde
    [(mk/fresh [rest]
       (mk/=== env [[x t] rest]))]
    [(mk/fresh [y s rest]
       (mk/=== env [[y s] rest])
       (lookupo rest x t))]))

(defn typeo [env e t]
  (mk/conde
    [(mk/numbero e) (mk/=== t 'int)]
    [(mk/stringo e) (mk/=== t 'string)]
    [(mk/booleo e) (mk/=== t 'bool)]
    [(mk/symbolo e) (lookupo env e t)]
    [(mk/fresh [c tb eb]
       (mk/=== e (list 'if c tb eb))
       (typeo env c 'bool)
       (typeo env tb t)
       (typeo env eb t))]
    [(mk/fresh [x body a b]
       (mk/=== e (list 'fn (list x) body))
       (mk/=== t (list 'fn a b))
       (mk/symbolo x)
       (typeo [[x a] env] body b))]
    [(mk/fresh [f a at]
       (mk/=== e (list f a))
       (typeo env f (list 'fn at t))
       (typeo env a at))]))

(println "── MVP-D: holes and synthesis ──")

; ── forwards (sanity: the relation still checks) ──────────────────────
(println (str "forwards  ((fn [y] y) 5) : "
              (pr-str (mk/run 1 t (typeo '() '((fn (y) y) 5) t)))))

; ── the hole demo ──────────────────────────────────────────────────────
; The program:  (defn f [x] ((+ 1) _))   in the curried mini-language.
; Local context: x : int, + : int → int → int. The hole's expected type:
; int. Synthesize inhabitants:

(def env '[[+ (fn int (fn int int))] [[x int] []]])

(println "the program:  (defn f [x] ((+ 1) _))")
(println "the context:  x : int,  + : int → int → int")
(println "the question: what can fill the hole? (expected: int)")

(def t0 (erlang/monotonic_time :millisecond))
(def candidates
  (mk/run 3 e (typeo env (list (list '+ 1) e) 'int)))
(def t1 (erlang/monotonic_time :millisecond))

(println (str "answers [" (- t1 t0) " ms]:"))
(doall (map (fn [c] (println (str "  ((+ 1) " (pr-str c) ")")))
            candidates))

; ── sideways: the ill-typed hole-filler has no answer ─────────────────
(def bad (mk/run 1 e (typeo env (list (list '+ 1) "nope") 'int)))
(println (str "sideways: ((+ 1) \"nope\") : " (pr-str bad)
              "  ;; empty — string fills no int hole"))

(println (str (if (and (= 3 (count candidates))
                       (= 0 (count bad)))
                "PASS" "FAIL")
              ": the hole got inhabitants; the misfit got none"))
