; examples/typing/03_solver_demo.bl — MVP-C: solver-backed proofs.
; Run: mix beam_lisp.run examples/typing/03_solver_demo.bl  (needs z3)
;
; Deodorant's rules under the solver: SAFE rules proven, an IDIOMATIC
; rule's hidden assumption DERIVED from its counterexample, the same
; rule PROVEN once the checker's tag lattice discharges the assumption,
; and a deliberately broken rule CAUGHT.

(ns typing-demo-03
  (:require [z3]))

(def port (z3/open))

(println "── MVP-C: rules under the solver ──")

(defn report [label r proven-means]
  (println (str "  " label ": "
                (if (= "unsat" (:verdict r))
                  (str "PROVEN — " proven-means)
                  (if (= "sat" (:verdict r))
                    (str "COUNTEREXAMPLE\n" (:model r))
                    (:verdict r))))))

; SAFE: (if p true false) ≡ (boolean p)  — over Bool p, both identity.
(def r1 (z3/prove-equiv port
           {:result "(ite p true false)" :raises "false"}
           {:result "p" :raises "false"}
           "(declare-const p Bool)\n"))
(report "SAFE     (if p true false) → (boolean p)" r1 "equivalent for all p")

; SAFE: (not (nil? x)) ≡ (some? x)
(def r2 (z3/prove-equiv port
           {:result (z3/not-tag :nil) :raises "false"}
           {:result (z3/not-tag :nil) :raises "false"}
           ""))
(report "SAFE     (not (nil? x)) → (some? x)" r2 "equivalent for all x")

; IDIOMATIC: (= x 0) → (zero? x)  — zero? raises on non-numbers.
(def r3 (z3/prove-equiv port
           (z3/eq-const-expr :int 0)
           (z3/pred-expr :int 0)
           ""))
(report "IDIOMATIC (= x 0) → (zero? x)" r3 "equivalent")

; the SAME rule under the discharged assumption x:int → PROVEN.
(def r4 (z3/prove-equiv port
           (z3/eq-const-expr :int 0)
           (z3/pred-expr :int 0)
           "(assert (= tag_x 1))\n"))
(report "  same rule, x:int discharged by the checker" r4
        "SOUND under inferred x:int — auto-promoted to SAFE")

; BROKEN on purpose: (= x 1) → (zero? x)
(def r5 (z3/prove-equiv port
           (z3/eq-const-expr :int 1)
           (z3/pred-expr :int 0)
           ""))
(report "BROKEN   (= x 1) → (zero? x)   (on purpose)" r5 "should never happen")

(println (str (if (and (= "unsat" (:verdict r1))
                       (= "unsat" (:verdict r2))
                       (= "sat"   (:verdict r3))
                       (= "unsat" (:verdict r4))
                       (= "sat"   (:verdict r5)))
                "PASS" "FAIL")
              ": two proven, one assumption derived, one promotion, one caught"))
