; hearth.bl — a real multi-user message board. PURE beam-lisp. One file.
;
;   mix beam_lisp.run --path priv examples/server/hearth.bl
;   → open http://localhost:4000 in two browsers, log in as different names,
;     and chat live.
;
; ── What this is ──────────────────────────────────────────────────────
;
; A complete live app — HTTP server, WebSocket, auth, rooms, messages, and a
; branded UI — with NO Elixir in the app. The web layer (`web`) starts Bandit
; and upgrades connections to WebSockets, all from beam-lisp; the live layer
; (`live.*`) renders views and ships minimal patches; datom is the shared log.
;
;   browser  --HTTP GET /-->   first paint (server-rendered HTML + client.js)
;   browser  --WebSocket-->    a WebSocket process that owns a `deflive` socket
;            <--[:mount]--      full HTML
;            <--[:patch]--      minimal keyed ops on every change
;   browser  --[:event]-->     an intent term -> authorized -> transact! -> log
;
; One shared datom database is the board. A post by anyone commits a fact; the
; log broadcasts; every connected socket re-projects and ships a minimal patch.
; Auth is real: you log in, get a cookie, and every post is stamped with your
; authenticated identity — you cannot post as someone else.

(ns hearth
  (:require [live.ui :as ui] [live.style :as s] [live.hiccup :as h]
            [live.socket :as sock] [datom] [interop] [web]))

;; ══════════════════════════════════════════════════════════════════════
;; BRAND
;; ══════════════════════════════════════════════════════════════════════

(def brand
  {:color {:accent "#ff7a59" :accent-fg "#1a1206" :bg "#12100e"
           :surface "#1c1917" :surface-2 "#262220" :border "#332e2a"
           :text "#f3ede6" :muted "#a89f95" :success "#5bbf7a"}
   :radius {:md "10px" :lg "18px" :full "9999px"}})

;; ══════════════════════════════════════════════════════════════════════
;; THE WORLD: rooms + messages, one shared datom db
;; ══════════════════════════════════════════════════════════════════════

(def world
  (datom/connect
    [{:db/ident :room/id    :db/valueType :db.type/string :db/unique :db.unique/identity}
     {:db/ident :room/name  :db/valueType :db.type/string}
     {:db/ident :msg/id     :db/valueType :db.type/string :db/unique :db.unique/identity}
     {:db/ident :msg/room   :db/valueType :db.type/string}
     {:db/ident :msg/who    :db/valueType :db.type/string}
     {:db/ident :msg/text   :db/valueType :db.type/string}
     {:db/ident :msg/at     :db/valueType :db.type/long}]))

(datom/transact! world
  [{:db/id -1 :room/id "general" :room/name "general"}
   {:db/id -2 :room/id "random"  :room/name "random"}
   {:db/id -3 :msg/id "m000000" :msg/room "general" :msg/who "hearth"
    :msg/text "welcome! pick a room and say hello" :msg/at 0}])

;; ── queries ───────────────────────────────────────────────────────────
(defn rooms [db]
  (sort (datom/q '[:find ?id ?name :where [?e :room/id ?id] [?e :room/name ?name]] db)))

(defn messages [db room]
  (sort-by (fn [m] (nth m 0))
    (datom/q '[:find ?id ?who ?text ?at
               :in $ ?room
               :where [?e :msg/room ?room] [?e :msg/id ?id]
                      [?e :msg/who ?who] [?e :msg/text ?text] [?e :msg/at ?at]]
             db room)))

;; ══════════════════════════════════════════════════════════════════════
;; COMPONENTS + THE VIEW
;; ══════════════════════════════════════════════════════════════════════

(defn- avatar [who]
  (let [hue (rem (erlang/phash2 who) 360)]
    [:div {:style (str "width:34px;height:34px;flex:0 0 34px;border-radius:9999px;"
                       "display:flex;align-items:center;justify-content:center;"
                       "font-weight:700;font-size:14px;color:#12100e;"
                       "background:hsl(" (str hue) ",70%,68%)")}
     (subs (str who) 0 1)]))

(defn- message-row [m me]
  (let [who (nth m 1) text (nth m 2) mine (= who me)]
    (ui/row {:key (nth m 0) :style {:align "flex-start" :gap :3}}
      (avatar who)
      (ui/stack {:gap :1 :style {:flex "1"}}
        (ui/row {:gap :2}
          (ui/prose {:style {:font-weight "600"}} (str "@" who))
          (when mine (ui/badge {:tone :accent} "you")))
        (ui/prose {:style {:color (s/color :text)}} text)))))

(defn- room-link [r current]
  (let [id (nth r 0) name (nth r 1) active (= id current)]
    [:button {:class (s/sx {:display "block" :width "100%" :text-align "left"
                            :padding (str (s/space :2) " " (s/space :3))
                            :margin-bottom (s/space :1)
                            :border "none" :border-radius (s/radius :md)
                            :cursor "pointer" :font-size (s/text :md)
                            :background (if active (s/color :surface-2) "transparent")
                            :color (if active (s/color :text) (s/color :muted))})
              :on-click [:assign :room id]}
     (str "# " name)]))

(defn board [db _sess locals]
  (s/install-theme! brand)
  (let [me   (:me locals)
        room (or (:room locals) "general")
        msgs (messages db room)]
    [:div {:style (str "display:flex;height:100vh;max-width:1000px;margin:0 auto;"
                       "border-left:1px solid " (s/color :border) ";"
                       "border-right:1px solid " (s/color :border))}

     [:aside {:style (str "width:240px;flex:0 0 240px;padding:" (s/space :5) ";"
                          "border-right:1px solid " (s/color :border) ";"
                          "display:flex;flex-direction:column;gap:" (s/space :4))}
      (ui/stack {:gap :1}
        (ui/heading 2 "Hearth")
        (ui/prose {:tone :muted} "gather round the fire"))
      (ui/stack {:gap :1}
        (ui/prose {:tone :muted :style {:font-size (s/text :xs)
                                        :text-transform "uppercase"
                                        :letter-spacing "0.08em"}} "Rooms")
        (into [:div] (for [r (rooms db)] (room-link r room)))
        ;; add a channel: Enter commits an :add-room fact; the log broadcasts,
        ;; so the new room appears in EVERY connected sidebar, not just yours.
        [:input {:class (s/sx {:width "100%" :margin-top (s/space :2)
                               :padding (str (s/space :2) " " (s/space :3))
                               :font-size (s/text :sm) :color (s/color :text)
                               :background (s/color :surface)
                               :border (str "1px solid " (s/color :border))
                               :border-radius (s/radius :md)})
                 :placeholder "+ add channel"
                 :value ""
                 :on-keydown.enter [:intent :add-room {}]}])
      [:div {:style "margin-top:auto"}
       (ui/row {:gap :2} (avatar me) (ui/prose {:style {:font-weight "600"}} (str "@" me)))]]

     [:main {:style "flex:1;display:flex;flex-direction:column;min-width:0"}
      [:header {:style (str "padding:" (s/space :4) " " (s/space :5) ";"
                            "border-bottom:1px solid " (s/color :border) ";")}
       (ui/heading 3 (str "# " room))]

      [:div {:style (str "flex:1;overflow-y:auto;padding:" (s/space :5) ";"
                         "display:flex;flex-direction:column;gap:" (s/space :4))}
       (if (empty? msgs)
         (ui/prose {:tone :muted} "no messages yet — be the first.")
         (into [:div {:style (str "display:flex;flex-direction:column;gap:" (s/space :4))}]
               (for [m msgs] (message-row m me))))]

      [:footer {:style (str "padding:" (s/space :4) " " (s/space :5) ";"
                            "border-top:1px solid " (s/color :border) ";")}
       (ui/row {:gap :2}
         [:input {:class (s/sx {:flex "1" :padding (str (s/space :3) " " (s/space :3))
                                :font-size (s/text :md) :color (s/color :text)
                                :background (s/color :surface) :border (str "1px solid " (s/color :border))
                                :border-radius (s/radius :md)})
                  :placeholder (str "message #" room)
                  :value ""
                  :on-keydown.enter [:intent :post {:room room}]}]
         (ui/button {:variant :primary :on-click [:intent :post {:room room}]} "Send"))]]]))

;; ══════════════════════════════════════════════════════════════════════
;; THE BACKEND: the intent. WHO from auth, TEXT from the field.
;; ══════════════════════════════════════════════════════════════════════

(defn post-message [conn payload principal]
  (let [text (:value payload)]
    (when (and text (not= (String/trim text) ""))
      [{:db/id -1
        :msg/id (str "m" (erlang/unique_integer (list :positive :monotonic)))
        :msg/room (:room payload)
        :msg/who principal
        :msg/text (String/trim text)
        :msg/at (System/system_time :millisecond)}])))

;; A room id is a lowercased, space-free slug of the typed name. A blank name,
;; or a name that already exists, is a no-op — :room/id has :db.unique/identity,
;; so an existing id would UPSERT (silently renaming), which we guard against.
(defn- slugify [s]
  (String/replace (String/downcase (String/trim s)) " " "-"))

(defn create-room [conn payload _principal]
  (let [nm (:value payload)]
    (when (and nm (not= (String/trim nm) ""))
      (let [id (slugify nm)
            exists (seq (datom/q '[:find ?e :in $ ?rid :where [?e :room/id ?rid]]
                                 (datom/db conn) id))]
        (when (not exists)
          [{:db/id -1 :room/id id :room/name id}])))))

(sock/deflive board-socket
  :view board
  :intents {:post post-message :add-room create-room}
  :listen {})

;; ══════════════════════════════════════════════════════════════════════
;; THE WEBSOCKET HANDLER — bridges a browser to a live socket, in bl
;; ══════════════════════════════════════════════════════════════════════
;;
;; Each WebSocket connection owns one `deflive` socket. The live socket's SINK
;; is this WebSocket process itself, so its [:mount …]/[:patch …] pushes arrive
;; here as :handle-info messages, which we forward to the browser as JSON text
;; frames. An inbound frame is a browser event; we decode it and dispatch it to
;; the live socket. State carries the live socket pid and the principal.

(defn- keywordize [m]
  (if (map? m)
    (reduce (fn [acc kv] (assoc acc (keyword (str (first kv))) (second kv))) {} (seq m))
    m))

(defn- ws-init [principal]
  ;; start the live socket with THIS process as its sink
  (let [srv (server-start-link board-socket
              {:shared world :sink (erlang/self)
               :locals {:me principal}
               :auth {:fn (fn [_op _payload _pr] {:verdict :allow}) :principal principal}})]
    [:ok {:srv srv :principal principal}]))

(defn- ws-handle-in [frame state]
  ;; frame = [:text json]; decode ["event", term, data] and dispatch
  (let [payload (nth frame 1)
        decoded (interop/json-> payload)]
    (if (and (sequential? decoded) (= "event" (first decoded)))
      (let [term (nth decoded 1)
            data (if (> (count decoded) 2) (nth decoded 2) {})]
        (server-call (:srv state)
                     [:event (sock/normalize-event term) (keywordize data)])
        [:ok state])
      [:ok state])))

(defn- ws-handle-info [msg state]
  ;; msg is a [:mount html] / [:patch ops] push from the live socket → JSON frame
  [:push [[:text (interop/->json msg)]] state])

(def ws-handlers
  {:init ws-init
   :handle-in ws-handle-in
   :handle-info ws-handle-info})

;; ══════════════════════════════════════════════════════════════════════
;; HTTP: login, the board page, the client script, the WebSocket route
;; ══════════════════════════════════════════════════════════════════════

(def base-head
  (str "<meta charset=\"utf-8\">"
       "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
       "<style>"
       "*,*::before,*::after{box-sizing:border-box;margin:0}"
       "body{background:#12100e;color:#f3ede6;font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;font-size:16px;line-height:1.5;-webkit-font-smoothing:antialiased}"
       "button{font-family:inherit}"
       "input:focus,button:focus-visible{outline:2px solid #ff7a59;outline-offset:2px}"
       "::-webkit-scrollbar{width:10px}::-webkit-scrollbar-thumb{background:#332e2a;border-radius:8px}"
       "</style>"))

(defn- login-page []
  (str "<!doctype html><html lang=\"en\"><head>" base-head "<title>Hearth · sign in</title></head><body>"
       "<div style=\"min-height:100vh;display:flex;align-items:center;justify-content:center\">"
       "<form action=\"/login\" method=\"get\" style=\"width:340px;padding:40px;background:#1c1917;border:1px solid #332e2a;border-radius:18px;display:flex;flex-direction:column;gap:16px\">"
       "<div style=\"font-size:34px;font-weight:800\">Hearth</div>"
       "<div style=\"color:#a89f95\">gather round the fire — pick a name to join.</div>"
       "<input name=\"name\" autofocus placeholder=\"your name\" required style=\"padding:12px;font-size:16px;color:#f3ede6;background:#12100e;border:1px solid #332e2a;border-radius:10px\">"
       "<button type=\"submit\" style=\"padding:12px;font-size:16px;font-weight:600;color:#1a1206;background:#ff7a59;border:none;border-radius:10px;cursor:pointer\">Enter</button>"
       "</form></div></body></html>"))

(defn- board-page [principal]
  (let [body (h/hiccup->html (board (datom/db world) nil {:me principal :room "general"}))]
    (str "<!doctype html><html lang=\"en\"><head>" base-head "<title>Hearth</title></head><body>"
         "<div id=\"live-root\">" body "</div>"
         "<script src=\"/client.js\"></script>"
         "<script>Live.connect({url:(location.protocol==='https:'?'wss://':'ws://')+location.host+'/ws',root:document.getElementById('live-root')})</script>"
         "</body></html>")))

;; the JS client, read from priv at boot
(def client-js (File/read! (str (web/priv-dir) "/live/client.js")))

;; parse ?name=… out of a query string (tiny, single-key)
(defn- query-name [qs]
  (if (and qs (String/starts_with? qs "name="))
    (web/url-decode (subs qs 5 (count qs)))
    nil))

(defn router [conn]
  (web/route conn
    [:get "/login"]
    (let [name (query-name (web/query conn))]
      (if (or (nil? name) (= (String/trim name) ""))
        (web/html conn (login-page))
        (web/redirect (web/put-cookie conn "who" name) "/")))

    [:get "/ws"]
    (let [who (web/req-cookie conn "who")]
      (if (or (nil? who) (= who ""))
        (web/text conn 401 "log in first")
        (web/upgrade conn ws-handlers who)))

    [:get "/client.js"]
    (web/js conn client-js)

    [:get "/"]
    (let [who (web/req-cookie conn "who")]
      (if (or (nil? who) (= who ""))
        (web/redirect conn "/login")
        (web/html conn (board-page who))))

    :else (web/text conn 404 "not found")))

;; ══════════════════════════════════════════════════════════════════════
;; GO
;; ══════════════════════════════════════════════════════════════════════

(web/serve {:port 4000 :plug router})

(println "")
(println "  Hearth is live at  http://localhost:4000")
(println "")
(println "      Open it in two browser windows, sign in with different names,")
(println "      and watch messages appear live in both. Every post is stamped")
(println "      with your authenticated identity, committed to one shared log,")
(println "      and every connected tab re-projects with a minimal patch.")
(println "")
(println "      Ctrl-C to stop.")
(println "")

;; keep the process alive to serve requests
(Process/sleep 86400000)
