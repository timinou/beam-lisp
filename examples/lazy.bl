; examples/lazy.bl — lazy sequences
;
; beam-lisp's seq fns are uniformly lazy, as in Clojure: `map`, `filter`,
; `range` (bounded AND unbounded), `concat`, `take-while`, `drop-while`, …
; compose without realizing what a consumer never asks for, and they chunk
; at 32 so a small strict map does not pay per-element LazySeq overhead.
; A lazy cell's thunk runs at most once (and realizes a whole chunk).
;
; Run: mix beam_lisp.run examples/lazy.bl

(ns lazy.demo)

; --- bounded-range laziness: the canonical Clojure demo ---

; `(range 1000000)` is lazy, so `(take 5 (map f …))` realizes only the one
; 32-element chunk `take` asks for — not all 1,000,000. Before beam-lisp's
; seq fns were lazy, bounded range was eager and this forced every element
; (measured ~4.7s). The counter proves it: 32, not 1,000,000.
(def realized (atom 0))
(def five (take 5 (map (fn [x] (swap! realized inc) (* x x)) (range 1000000))))
(println (str "(take 5 (map f (range 1000000)))  " (pr-str five)))
(println (str "realized " @realized " of 1,000,000 - one 32-element chunk, not the whole range"))

; --- infinite sequences ---

; The naturals: an infinite lazy range, mapped lazily.
(def naturals (map inc (range)))              ; 1, 2, 3, …
(println (str "first 10 naturals:      " (pr-str (take 10 naturals))))

; Fibonacci via iterate over adjacent pairs.
(def fibs (map first (iterate (fn [[a b]] [b (+ a b)]) [0 1])))
(println (str "first 12 fibs:          " (pr-str (take 12 fibs))))

; cycle repeats a collection forever.
(println (str "cycle weekdays, 7:      " (pr-str (take 7 (cycle (list :mon :tue :wed))))))

; --- chunked realization: a thunk runs once and yields a whole chunk ---

(def realized2 (atom 0))
(def counted-squares (map (fn [x] (swap! realized2 inc) (* x x)) (range)))

(println (str "squares, first 5:       " (pr-str (doall (take 5 counted-squares)))))
(println (str "thunk ran " @realized2 " time(s) for 5 elements - one 32-element chunk"))
(println (str "re-forcing same cells:  " (pr-str (doall (take 5 counted-squares)))))
(println (str "thunk still at " @realized2 " realization(s) - nothing re-ran"))

; --- take-while / drop-while ---

(println (str "take-while (< 8):       " (pr-str (doall (take-while (fn [x] (< x 8)) (range))))))
(println (str "drop-while (< 3), 4:    " (pr-str (take 4 (drop-while (fn [x] (< x 3)) (range))))))

; --- Elixir Enum interop ---

(println (str "Enum sum of first 100:  " (Enum/sum (take 100 naturals))))
(println (str "Enum/take 3 naturals:   " (pr-str (Enum/take naturals 3))))

; --- doall: a large chain realizes without blowing the stack ---

(println (str "sum of 10000 squares:   " (reduce + 0 (doall (take 10000 (map (fn [x] (* x x)) (range)))))))

; --- printing is bounded ---

(println (str "an infinite seq prints: " (pr-str (map inc (range)))))
