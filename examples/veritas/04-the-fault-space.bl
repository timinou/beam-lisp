; 04-the-fault-space.bl — wrong responses, generated by z3, analysed by datalog.
; Run: mix beam_lisp.run --path priv examples/veritas/04-the-fault-space.bl
;
; veritas.fault is the ∃-not half grown into a SURFACE. z3 GENERATES an isolated
; mutant per law (wrong for exactly that law); datalog ANALYSES the set — coverage
; (which laws a suite exercises), redundancy (which mutants test the same thing),
; independence (which laws are implied by the others). Two engines, each at its
; best: z3 finds witnesses, datalog reasons about the set.

(ns example.fault-space
  (:require [veritas.fault :as f] [veritas.mock :as m] [z3] [core]))

(def port (z3/open))
(defn- show [label v] (println "  " label " " (pr-str v)))

; A contract with a DELIBERATELY redundant law: law 2 (>= v -50) is implied by
; law 0 (>= v -40) — anything below -50 is already below -40.
(def band
  (m/contract-from [["v" "Int"]]
                   ['(>= v -40) '(<= v 60) '(>= v -50)]))

(println "── z3 generates the isolated faults ──")
(doseq [i (range 0 3)]
  (let [r (f/isolate port band i)]
    (show (str "break law " i " alone:")
          (if (:implied r) :IMPLIED-cannot-break-alone (:value r)))))

(println "\n── datalog analyses independence ──")
(show "laws:" (f/independent-laws (f/isolate-all port band)))
(println "   law 2 is z3-PROVEN redundant — a finding about the SPEC, not a guess.")

(println "\n── coverage is a not-join query ──")
; a suite that only ever breaks law 0 (a value in [-50,-40))
(def suite [{:value {:v -45} :fault/id 0 :kind :isolated :clause 0}])
(def db (:db (f/build-db port band suite)))
(show "covered clauses:" (f/covered-clauses db))
(show "uncovered (blind spots):" (f/uncovered-clauses db))

(println "\n── a server that injects errors by NAME ──")
(def api (m/make-mock port (m/contract-from [["v" "Int"]] ['(and (>= v 0) (<= v 100))]) "v"))
(def srv (f/make-server api {:boom 0}))
(show "normal request 42:" (f/serve srv 42))
(show "injected error :boom:" (f/serve srv :boom))

(println "\n── the point ──")
(println "  The fault space is not a second tool — it is ∃ with a negated law. z3")
(println "  hands you a value wrong for exactly one nameable law (or PROVES the law")
(println "  can't be broken alone ⇒ redundant); datalog then answers coverage and")
(println "  redundancy as ordinary queries over the fault set.")

:ok
