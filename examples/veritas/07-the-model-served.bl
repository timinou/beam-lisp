; 07-the-model-served.bl — a model, served: the state machine IS the fake service.
; Run: bl run examples/veritas/07-the-model-served.bl
;
; A todo service written once as a veritas model. `serve` binds a loopback port and
; answers real HTTP from the model's state; `check` quantifies over the very same
; commands. No second hand-written fake exists to drift from the model.
;
; The one shape to know: a command with :request takes the REQUEST map as its args
; — {:method :path :params :query :body :headers} — in :pre, :next and :response
; alike. :response sees the state AFTER :next, as a real API's create does.

(ns example.model-served
  (:require [veritas.model :as vm]))

(defn- todo-id [req] (String/to_integer (get (:params req) "id")))

(def todos
  (vm/model "todos"
    {:state {:next-id 1 :items {} :broken false}
     :commands
     {:add-ok   {:request [:post "/todos"]
                 :pre  (fn [_ req] (string? (get (:body req) "title")))
                 :next (fn [s req] (let [id (:next-id s)]
                                     (-> s (assoc :next-id (+ id 1))
                                           (assoc-in [:items id] {"id" id "title" (get (:body req) "title") "done" false}))))
                 :response (fn [s _] {:status 201 :body (get (:items s) (- (:next-id s) 1))})
                 ; for `check`: draw a request-shaped map, same as the wire sends
                 :args (fn [_ g] [{:method :post :path "/todos" :params {} :query {} :headers {}
                                   :body {"title" "write docs"}} g])}
      :complete {:request [:patch "/todos/:id"]
                 :pre  (fn [s req] (contains? (:items s) (todo-id req)))
                 :next (fn [s req] (assoc-in s [:items (todo-id req) "done"] true))
                 :response (fn [s req] {:body (get (:items s) (todo-id req))})}
      :list     {:request [:get "/todos"]
                 :response (fn [s req]
                             (let [only (get (:query req) "done")]
                               {:body (into [] (filter (fn [t] (or (nil? only) (= only (str (get t "done")))))
                                                       (vals (:items s))))}))}
      ; a fault toggle: no :request, so it is driven by `inject!`, never by HTTP
      :break    {:pre  (fn [s _] (not (:broken s)))
                 :next (fn [s _] (assoc s :broken true))}
      ; routes are tried in name order: :add-fault sorts before :add-ok, so while
      ; broken it answers instead
      :add-fault {:request [:post "/todos"]
                 :pre  (fn [s _] (:broken s))
                 :response (fn [_ _] {:status 503 :headers {"X-Fault" "injected"}
                                      :body {:error {:code "unavailable" :message "injected fault"}}})}}
     :invariants {:ids-are-allocated (fn [s _] (every? (fn [id] (< id (:next-id s))) (keys (:items s))))}}))

(defn- show [label r] (println " " label (:status r) (pr-str (:body r))))

(def srv (vm/serve todos))
(println "serving at" (:url srv))

(println "\n── real HTTP against the model ──")
(show "POST /todos         " (vm/request srv :post "/todos" {"title" "ship it"}))
(show "POST /todos         " (vm/request srv :post "/todos" {"title" "test it"}))
(show "PATCH /todos/1      " (vm/request srv :patch "/todos/1"))
(show "GET /todos?done=true" (vm/request srv :get "/todos?done=true"))
(show "PATCH /todos/99     " (vm/request srv :patch "/todos/99"))   ; :pre unmet → 409
(show "GET /nope           " (vm/request srv :get "/nope"))          ; no route → 404

(println "\n── a fault, injected by name ──")
(println "  inject! :break →" (:ok ((:inject! srv) :break nil)))
(show "POST /todos         " (vm/request srv :post "/todos" {"title" "under fault"}))

(println "\n── the log, for assertions ──")
(doseq [e ((:log srv))]
  (println " " (name (:method e)) (:path e) "→" (:status e) (or (:command e) "-")))

((:stop srv))

(println "\n── the same model, checked ──")
(def verdict (vm/check todos {:histories 20 :max-len 8}))
(println " " (:modality verdict) "—" (:why verdict))

:ok
