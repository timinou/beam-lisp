; 03-the-mock-server.bl — a contract, run backwards, is a deterministic server.
; Run: mix beam_lisp.run --path priv examples/veritas/03-the-mock-server.bl
;
; veritas.mock is the ∃ half of the one verb, grown into a SERVER: a contract
; synthesised backward gives one valid value; PIN a field to a request key and the
; same key always yields the same value — a pure fn input→response. And z3's
; OPTIMIZER hands you the boundary responses a hand-written mock always forgets.

(ns example.mock-server
  (:require [veritas.mock :as m] [z3] [core]))

(def port (z3/open))

(defn- show [label v] (println "  " label " " (pr-str v)))

; A weather API contract, written as bl predicates over the response fields.
(def weather
  (m/contract-from
    [["temp" "Int"] ["code" "Int"]]
    ['(and (>= temp -40) (<= temp 60))    ; a plausible temperature band
     '(and (>= code 200) (< code 300))])) ; a 2xx status

(println "── a contract IS a mock ──")
(show "one valid response:" (:value (m/synth port weather "")))

(println "\n── the mock is a deterministic SERVER ──")
(def srv (m/make-mock port weather "code"))
(show "request 200 →" (:value (m/answer srv 200)))
(show "request 200 again →" (:value (m/answer srv 200)))      ; identical
(show "request 250 →" (:value (m/answer srv 250)))            ; its own pinned answer
(println "   same key ⇒ same response: "
         (= (:value (m/answer srv 200)) (:value (m/answer srv 200))))

(println "\n── the boundaries, generated for free ──")
(show "coldest valid temp:" (:value (m/synth-boundary port weather "temp" :min)))
(show "hottest valid temp:" (:value (m/synth-boundary port weather "temp" :max)))

(println "\n── adversarial: a response the contract FORBIDS ──")
(def bad (:value (m/synth-invalid port weather)))
(show "an invalid response:" bad)
(println "   still inside the contract? " (m/check port weather bad))  ; false, provably

(println "\n── the point ──")
(println "  A mock is not written — it is DERIVED from the same contract the real")
(println "  impl is checked against, so the two answer to one predicate and are")
(println "  interchangeable. Determinism makes it a server; the optimizer makes the")
(println "  edges free; the negation makes the adversarial case provably wrong.")

:ok
