; 01-the-generator-algebra.bl — one typed generator feeds three engines.
; Run: mix beam_lisp.run --path priv examples/veritas/01-the-generator-algebra.bl
;
; A generator is the object that unifies fuzz, exhaustion, and z3. Each generator
; knows how to SAMPLE itself (fuzz), ENUMERATE itself (exhaustive when finite),
; and CONSTRAIN itself (z3 decls+asserts). `check` picks the strongest engine the
; generator supports — so the SAME query is proven, enumerated, or sampled purely
; by which generator you hand it.

(ns example.veritas.gens
  (:require [veritas :as v] [z3]))

(defn- h [t] (println (str "\n── " t " ──")))
(defn- show [label q] (println (str "  " label "  " (pr-str q))))

(def port (z3/open))

; ── Scalars, each carrying its own z3 theory ────────────────────────────────

(h "int — the Int theory")
(show "∃ n in [1,10], n>7:" (v/exists port "n" (v/int-of 1 10) "(> n 7)"))

(h "real — the Real theory, exact rationals")
(show "∃ r in (0,1), r>0.9:" (v/exists port "r" (v/real-of 0.0 1.0) "(> r 0.9)"))

(h "string — the String theory, structured values")
(show "∃ s prefixed sk_, len≥8:" (v/exists port "s" (v/string-of "sk_" 8 20) "(>= (str-len s) 8)"))

(h "bool — finite, so ∀ is EXHAUSTIVELY proven")
(show "∀ b, b or not b:" (v/for-all port "b" (v/bool-of) "(or b (not b))"))

(h "one-of — a finite value set; ∀ enumerates, ∃ picks")
(show "∀ code<600:" (v/for-all port "code" (v/one-of 200 404 500) "(< code 600)"))
(show "∀ code=200 (refuted):" (v/for-all port "code" (v/one-of 200 404 500) "(= code 200)"))

; ── The same query, three engines, by generator alone ───────────────────────

(h "the SAME predicate (n≥0), three generators, three modalities")
(show "int [0,3]  → z3 proves:     " (v/for-all port "n" (v/int-of 0 3) "(>= n 0)"))
(show "one-of {0,1,2} → enumerate: " (v/for-all port "n" (v/one-of 0 1 2) "(>= n 0)"))
(show "any → sample (witnessed):   " (v/for-all port "n" (v/any-of) "(>= n 0)"))

(h "the point")
(println "  You did not choose an engine — you chose a GENERATOR, and the")
(println "  strongest engine it supports followed. int and one-of prove or")
(println "  enumerate; gen/any can only sample, and says so. The generator is")
(println "  the seam between the three engines the whole system runs on.")
