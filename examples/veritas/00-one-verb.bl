; 00-one-verb.bl — mock, fuzz, coverage, and proof are ONE verb.
; Run: mix beam_lisp.run --path priv examples/veritas/00-one-verb.bl
;
; Four tools were four costumes on one operation:
;   (quantifier [var generator] predicate) → verdict
; exists = the mock (∃ a value satisfying a spec).
; for-all = the property test (∀ input, a property holds) — refuted + shrunk.
; covers = the coverage lint (∀ input, some clause handles it).
; And every verdict carries a MODALITY, so a sample can never pose as a proof.

(ns example.veritas.one
  (:require [veritas :as v] [z3]))

(defn- h [t] (println (str "\n── " t " ──")))
(defn- show [label q] (println (str "  " label "  " (pr-str q))))

(def port (z3/open))

; ── EXISTS = the mock: synthesize a value satisfying a spec ──────────────────
;
; z3 solves it symbolically ⟹ :modality :proven, and the model IS the value.

(h "exists = the mock (∃ a value the spec admits)")
(show "∃ temp>50 in [-90,60]:" (v/exists port "temp" (v/int-of -90 60) '(> temp 50)))
(show "∃ rate in (0.3,0.4):  " (v/exists port "rate" (v/real-of 0.0 1.0) '(and (> rate 0.3) (< rate 0.4))))
(show "∃ sk_-prefixed token: " (v/exists port "tok" (v/string-of "sk_" 8 16) '(str-prefix? "sk_" tok)))

; ── FOR-ALL = the property test: refuted, then SHRUNK ────────────────────────
;
; A linear property is PROVEN by z3 (a real ∀). A property outside the decidable
; fragment falls to sampling and is :witnessed — honestly not a proof.

(h "for-all = the property (∀ input, the property holds)")
(show "∀ n≥0 in [0,100] (z3):    " (v/for-all port "n" (v/int-of 0 100) '(>= n 0)))
(show "∀ n<50 in [0,100] refuted:" (v/for-all port "n" (v/int-of 0 100) '(< n 50)))

; ── COVERS = the coverage lint: read the function's OWN guards ───────────────
;
; No property written — the "spec" is the function's guard heads. A finite
; domain makes coverage a PROOF (exhaustive), not a sample.

(h "covers = the lint (∀ input, some clause handles it)")
(def classify "(defn classify ([n] :when (pos? n) :positive) ([n] :when (neg? n) :negative))")
(def fixed    "(defn classify ([n] :when (pos? n) :positive) ([n] :when (neg? n) :negative) ([n] :when (zero? n) :zero))")
(show "classify over [-5,5] (gap):    " (v/covers port classify (v/int-of -5 5)))
(show "fixed over [-5,5] (PROVEN):    " (v/covers port fixed (v/int-of -5 5)))

; ── The MODALITY is the whole point ──────────────────────────────────────────

(h "the modality never lets a sample pose as a proof")
(show "∀ int?(x) over gen/any:" (v/for-all port "x" (v/any-of) "(int? x)"))
(println "  → :witnessed/:refuted by SAMPLE — gen/any spans every type, so the")
(println "    float 1.5 witnesses the gap automatically; no proof is claimed.")

(h "the point")
(println "  One verb, one generator algebra, three engines. exists is the mock,")
(println "  for-all is the property test, covers is the lint — and each verdict")
(println "  says whether z3 PROVED it, exhaustion PROVED it, or a sample merely")
(println "  WITNESSED it. The confidence is in the value, not a footnote.")
