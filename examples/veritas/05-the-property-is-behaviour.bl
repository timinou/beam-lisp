; 05-the-property-is-behaviour.bl — a property over a function's OUTPUT, shrunk.
; Run: mix beam_lisp.run --path priv examples/veritas/05-the-property-is-behaviour.bl
;
; veritas core's `covers` reads a function's guards — a STRUCTURAL question that
; never runs the code. veritas.property is the behavioural analogue: RUN the
; function and assert a predicate over its RETURN. A refuted property is SHRUNK to
; the simplest failing input — the report names the minimal case, not the first
; random one. The fuzz domain is a veritas GENERATOR, the same algebra the core
; uses.

(ns example.property
  (:require [veritas.property :as p] [veritas :as v] [core]))

(defn- show [label v] (println "  " label " " (pr-str v)))

(println "── a property that HOLDS ──")
; NB: the string bindings are named `*-src`, distinct from the function names they
; DEFINE. hypothesis env/evals the source (which introduces `dbl`, `boom`, … into
; this namespace); a binding sharing that name would be shadowed after the first
; call and then read as a function, not a string. Distinct names sidestep it.
(def dbl-src "(defn dbl [n] (* 2 n))")
(show "∀ n∈[0,100]. 2n ≥ n :" (p/hypothesis dbl-src '(>= result n) (v/int-of 0 100) 40))

(println "\n── a property that is REFUTED, then SHRUNK ──")
(show "∀ n. 2n > n  (false at 0):"
      (p/hypothesis dbl-src '(> result n) (v/int-of 0 100) 40))
(println "   the witness shrank to 0 — the SIMPLEST failing input, not the first.")

(println "\n── a crash is a first-class outcome ──")
(def boom-src "(defn boom [n] (core/quot n (- n n)))")
(show "divide by zero:" (p/hypothesis boom-src '(int? result) (v/int-of 1 10) 20))

(println "\n── the generator picks the domain — any-of spans types ──")
(def ident-src "(defn ident [n] n)")
(show "∀ n. int?(n) over any-of:"
      (p/hypothesis ident-src '(int? n) (v/any-of) 20))
(println "   any-of yields a float/string/… so the type property is refuted — no")
(println "   hand-built mixed domain to remember.")

(println "\n── a multi-arg property draws from tuple-of ──")
(def sub-src "(defn sub [a b] (- a b))")
(show "∀ a,b∈[0,20]. a-b ≥ 0 :"
      (p/hypothesis sub-src '(>= result 0) (v/tuple-of (v/int-of 0 20) (v/int-of 0 20)) 8))

(println "\n── the point ──")
(println "  A property is the code's own behaviour, checked over a generated domain")
(println "  and shrunk to its minimal witness. Same generator algebra as the core's")
(println "  exists/for-all — one seam feeds the symbolic, exhaustive, and behavioural")
(println "  checks alike.")

:ok
