; 06-all-theories.bl — every sort the translator speaks, one verb.
; Run: mix beam_lisp.run --path priv examples/veritas/06-all-theories.bl
;
; The check escalator was already honest about its width: a predicate outside
; the SMT fragment fell to sampling, and the modality said so. What was missing
; was the other direction — two theories the TRANSLATOR always had that the
; GENERATOR algebra could not bind. This demo walks the full lattice now:
; Int, Real, Bool, String, ENUM DATATYPES (enum-of), and COLLECTION LENGTHS
; (coll-of) — each decided on its strongest rung, each witness a real bl value.

(ns example.veritas.theories
  (:require [veritas :as v] [z3]))

(defn- h [t] (println (str "\n── " t " ──")))
(defn- show [label q] (println (str "  " label "  " (pr-str q))))

(def port (z3/open))

; ── enums: the datatype IS the domain ────────────────────────────────────────
;
; (enum-of :pending :running :done) declares a z3 datatype whose constructors
; are exactly these tags. All-nullary enums are FINITE, so the enumerate rung
; can prove by exhaustion — and when the predicate stays in the SMT fragment,
; the z3 rung decides over the same domain. No junk constructors, no junk tags.

(h "a nullary enum: proven symbolically, refuted with a projected witness")
(show "for-all t. t∈{pending,running,done}:"
      (v/for-all port "phase" (v/enum-of :pending :running :done)
                 '(or (= phase :pending) (= phase :running) (= phase :done))))
(show "for-all t. t≠:running:"
      (v/for-all port "phase" (v/enum-of :pending :running :done)
                 '(not (= phase :running))))

(h "the same law outside the fragment — exhaustion proves it instead")
(show "for-all t. (keyword? t):"
      (v/for-all port "phase" (v/enum-of :a :b) '(keyword? phase)))

; ── enums with a payload arm: an open domain, z3 synthesizes into it ─────────
;
; A [tag sort] arm adds an accessor + discriminant: (:on mode) is a z3 field
; selector, (some? (:on mode)) the arm test. z3 can SYNTHESIZE the arm — and
; the witness comes back as the bl value it would have sampled as.

(h "a payload enum: z3 answers exists by building the {:on n} record itself")
(show "exists m. (:on m) present:"
      (v/exists port "mode" (v/enum-of [:on :int] :off) '(some? (:on mode))))
(show "for-all m. the arm law:"
      (v/for-all port "mode" (v/enum-of [:on :int] :off)
                 '(or (some? (:on mode)) (= mode :off))))

; ── collections: the length abstraction ─────────────────────────────────────
;
; (coll-of lo hi) binds a real vector on the bl rung and its LENGTH on the z3
; rung: count/conj/rest/pop/empty? become arithmetic on c_len. A length law is
; PROVEN over an unbounded domain; a content predicate (includes?) stays
; outside the fragment and falls to sampling — the modality says which.

(h "length laws: proven over every vector, refuted with the offending length")
(show "for-all c∈len[0,5]. (count c) ≤ 5:"
      (v/for-all port "c" (v/coll-of 0 5) '(<= (count c) 5)))
(show "for-all c∈len[0,9]. (count c) ≤ 5:"
      (v/for-all port "c" (v/coll-of 0 9) '(<= (count c) 5)))
(show "exists c∈len[0,3]. (count c) > 3:"
      (v/exists port "c" (v/coll-of 0 3) '(> (count c) 3)))
(show "for-all c∈len[0,9]. 7 ∉ c:  (falls to sample — content is open)"
      (v/for-all port "c" (v/coll-of 0 9) '(not (some (fn [x] (= x 7)) c))))

; ── tuples: two sorts, one query — or an honest refusal ─────────────────────

(h "a joint query over Int × enum: one z3 call, both datatypes")
(show "for-all p. (nth p 1) ≠ :a:"
      (v/for-all port "p" (v/tuple-of (v/int-of 0 3) (v/enum-of :a :b))
                 '(not (= (nth p 1) :a))))
(println "  …but coll × enum needs variants AND lengths in one pass — none")
(println "  exists, so that tuple samples, and the verdict says :witnessed.")

(h "the point")
(println "  A theory is not a feature of the solver — it is a GENERATOR. Bind the")
(println "  domain on the bl rung, declare it to z3 on the symbolic rung, project")
(println "  witnesses back to bl values, and every quantifier you already have")
(println "  (exists / for-all / covers / faults) speaks the new sort for free.")
