; 02-faults-are-queries.bl — the wrong stuff is an exists-not query.
; Run: mix beam_lisp.run --path priv examples/veritas/02-faults-are-queries.bl
;
; The fault space needs no new machinery. "A response wrong for exactly law i" is
; the query (∃ v. ¬law_i ∧ (every other law)). z3 answers it — and the answer's
; MODALITY is itself a finding: a :proven witness is an isolated fault; a :proven
; :none means law i CANNOT be broken while the others hold, i.e. it is IMPLIED by
; them — a redundant law in the spec, proven redundant.

(ns example.veritas.faults
  (:require [veritas :as v] [z3]))

(defn- h [t] (println (str "\n── " t " ──")))
(defn- show [label q] (println (str "  " label "  " (pr-str q))))

(def port (z3/open))

; ── A contract with a DELIBERATELY redundant law ────────────────────────────
;
; law 0: temp ≥ -40   law 1: temp ≤ 60   law 2: temp ≥ -50  ← implied by law 0

(def weather
  {:gen (v/int-of -100 100)
   :laws ['(>= v -40) '(<= v 60) '(>= v -50)]})

(h "an error for exactly one law — requested by the law it breaks")
(show "wrong for law 0 (temp≥-40):" (v/isolate-fault port (:gen weather) (:laws weather) 0))
(show "wrong for law 1 (temp≤60): " (v/isolate-fault port (:gen weather) (:laws weather) 1))
(show "wrong for law 2 (temp≥-50):" (v/isolate-fault port (:gen weather) (:laws weather) 2))

(h "the whole fault space at once")
(def report (v/faults port weather))
(doseq [f report]
  (println (str "  law " (:law f)
                " → modality " (:modality f)
                (if (:implied f)
                  "  IMPLIED (redundant — proven un-breakable alone)"
                  (str "  isolated fault: " (pr-str (:isolated-fault f)))))))

(h "the point")
(println "  The fault space is not a second tool — it is exists with a negated")
(println "  law. z3 either hands you an isolated fault (wrong for exactly that")
(println "  law) or PROVES the law cannot be broken alone, which means the")
(println "  contract stated it twice. The redundancy is proven, not guessed —")
(println "  the modality carries the finding.")
