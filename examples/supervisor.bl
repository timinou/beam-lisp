; supervisor.bl — a tree as data: heal, pool, observe.
; Run: bl run examples/supervisor.bl

(ns example.supervisor
  (:require [proc.super :as super]))

(defn check! [truth message data]
  (when-not truth
    (throw (ex-info message data))))

(defserver worker
  (init [id] (ok {:id id :jobs 0}))
  (handle-call :id [_from s] (reply (:id s) s))
  (handle-cast [:job j] [s]
    (do (println (str "  worker " (pr-str (:id s)) " did job " j))
        (noreply (assoc s :jobs (inc (:jobs s)))))))

(println "== a tree as data ==")

(proc.super/defsupervisor shop
  (strategy :one-for-one)
  (intensity 3 5000)
  (child :boss worker :boss)
  (child :hands (pool worker 3)))

(def s (start-link shop))

(println (str "  children: "
              (pr-str (vec (map (fn [c] (:id c)) (proc.super/children s))))))
(check! (= 2 (count (proc.super/children s))) "two top-level children" {})

(println "== reach a child by name ==")
(def boss (proc.super/child-of s :boss))
(check! (= :boss (call boss :id)) "boss answers" {})
(println "  (call (proc.super/child-of s :boss) :id) → :boss")

(println "== the pool: cast once, jobs spread round-robin ==")
(def hands (proc.super/child-of s :hands))
(cast hands [:job 1])
(cast hands [:job 2])
(cast hands [:job 3])
(Process/sleep 120)   ; each of the three lines below names a different worker

(println "== let it crash ==")
(def old-boss boss)
(kill boss)
(Process/sleep 120)
(def new-boss (proc.super/child-of s :boss))
(check! (not (= old-boss new-boss)) "boss healed with a new pid" {})
(check! (= :boss (call new-boss :id)) "healed boss answers" {})
(println "  killed the boss; the tree grew a new one")

(stop s)
(println "\nsupervisor green.")
:ok
