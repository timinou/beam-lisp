; examples/gen/01_spike.bl — gen.code spike. Run: bl run examples/gen/01_spike.bl
(ns gen-spike (:require [gen.code :as gen]))

(println :clamp-in   (gen/call "clamp x to the range [lo, hi]" 5 0 10))
(println :clamp-low  (gen/call "clamp x to the range [lo, hi]" -3 0 10))  ; memo hit — no LLM
(println :fib        (gen/call "fibonacci of n" 10))
(gen/defn! "collatz step: even n -> n/2, odd n -> 3n+1")
