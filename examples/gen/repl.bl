; examples/gen/repl.bl — load gen.code, then drop into the repl with it ready.
;
;   bl run examples/gen/repl.bl
;
; The repl evaluates in `user`, and a file's (:require …) aliases live in the
; FILE's namespace — so the second form re-declares `user` with gen.code
; required and aliased. After that, `gen/…` resolves at the prompt:
;
;   user=> (gen/call "square of a number" 7)
;   49
;
; (Why not (require …) at the prompt: there is no require FUNCTION — requiring
; is what the (ns …) form does. `(ns user (:require [gen.code :as gen]))`
; typed at a bare `bl repl` works too; this file just saves you the typing.)

(ns gen-repl.boot
  (:require [gen.code :as gen]
            [bl.repl]))

(BeamLisp/eval "(ns user (:require [gen.code :as gen]))")
(println "gen.code loaded — gen/call · gen/f · gen/defn! · gen/candidate · gen/spec")
(bl.repl/run nil nil)
