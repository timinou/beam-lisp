; examples/z3/10-corpus.bl — every machine in the tree, one verdict each.
;
; ── what you need to know first ──────────────────────────────────────────────
; `system.core/verify-process` checks ONE process form: it reads ^{:invariant …},
; translates the machine's guards and next-states to SMT, and proves □Inv against
; z3. It is a verifier for a form you already have. This example is the thing
; that FINDS the forms — every `defserver` under a directory tree — hands each to
; the engine, and reports what came back, with a cost. It is the measurement that
; turns "a machine's invariant was proven" into "N of M machines in this tree are
; proven, and here is the price of the slowest one".
;
; The walk is written down in priv/lib/z3corpus.bl, and it is careful for three
; reasons that were each a bug first: a `.md` handed to the reader kills the VM
; (rc=141, no diagnostic), a machine is often a STRING literal that must be
; re-read, and a machine with an invariant is METADATA-wrapped so a walker that
; matches only bare top-level lists misses exactly the annotated machines — one
; such walker reported "machines: 4" over 104 files and was deleted.
;
; The BEAM part: the per-machine microsecond costs below and the ledger are kept
; in a `:counters` array — a lock-free, mutable, shared integer array that many
; processes could bump without a lock — plus a per-process trail in the PROCESS
; DICTIONARY (a dynamically scoped list), so two callers never see each other's
; questions. And every question is asked of a z3 OS process owned by a gen_server
; in `z3pool`; a machine's whole transition set LEASES one solver for the length
; of its conversation, so the pool's other solvers stay free.
; ─────────────────────────────────────────────────────────────────────────────

(ns corpus
  (:require [z3corpus :as cor]
            [z3]
            [system.decide :as decide]))

;; The pool arms z3's own ceiling at every lease. Clear any leftover this VM may
;; carry so the run measures the pool's default, not a neighbour's experiment.
(System/delete_env "BL_Z3_TIMEOUT")
(z3/pool! 4)
(decide/reset-ledger!)

(def dirs ["priv" "examples"])

;; ── 1. what the walk sees ───────────────────────────────────────────────────
;; The bound is a DIFFERENT instrument (raw text, not forms) and it is the guard
;; whose absence let the deleted walker report a cheerful zero. It counts FILES
;; that spell "defserver" — comments and docstrings included — so the walker's
;; MACHINE count (several per file) is what must reach it.
(def fs (cor/files dirs))
(def bound (cor/grep-bound dirs "defserver"))
(println "1. walk of" (pr-str dirs) "→" (count fs) "`.bl` files")
(println "   grep bound: " bound "files spell \"defserver\" (text-level, an independent count)")

;; ── 2. the corpus ───────────────────────────────────────────────────────────
(def r (cor/corpus dirs))
(def ms (:machines r))
(println "2. machines:" (count ms)
         "| re-read failures:" (count (:failures r))
         "| unreadable files:" (count (:unreadable r)))

;; ── 3. the per-machine table ────────────────────────────────────────────────
(println "3. per-machine (file · name · outcome · µs · solver asks)")
(vec (map (fn [m]
            (println "   " (:file m) "·" (pr-str (:name m)) "·"
                     (name (:outcome m)) "·" (:us m) "·" (:calls m)))
          ms))

;; ── 4. the four-way outcome histogram ───────────────────────────────────────
;; proved / refuted / undecided / declined are four different things. `declined`
;; is a live/reactive machine the engine REFUSES to model — not a proof, and not
;; a failure; `undecided` is a checked machine where z3 hit its ceiling.
(def c (:counts r))
(println "4. outcomes:  proved" (:proven c)
         "| refuted" (:refuted c)
         "| undecided" (:undecided c)
         "| declined" (:declined c)
         "| error" (:error c))

;; ── 5. the ten slowest machines ─────────────────────────────────────────────
(println "5. ten slowest:")
(vec (map (fn [m] (println "   " (:us m) "µs  " (name (:outcome m)) "  "
                           (:file m) "·" (pr-str (:name m))))
          (vec (take 10 (sort-by (fn [m] (- 0 (:us m))) ms)))))
(println "   median" (:median r) "µs | worst" (:worst r) "µs")

;; ── 6. the ledger ───────────────────────────────────────────────────────────
;; Which rung answered, and what it cost. `:z3` is the solver; `:memo` is an
;; identical script answered from memory (an establishment obligation can repeat);
;; `:native-witness` is the cheap rung, off by default.
(def lg (:ledger r))
(println "6. ledger: decisions" (:count lg)
         "| total" (:total_us lg) "µs | max" (:max_us lg) "µs | tiers" (pr-str (:tiers lg)))

;; ── 7. the coverage line: the walker vs. an independent count ───────────────
(def measured (count ms))
(def files-with-machines (count (distinct (vec (map (fn [m] (:file m)) ms)))))
(println "7. coverage: machines" measured "≥ grep bound" bound
         "→" (if (<= bound measured) "PASS" "FAIL")
         "| files with a machine:" files-with-machines)
;; A REAL assertion, not a comment: a walker that cannot reach a count it did not
;; compute itself has to fail the program, not print a number nobody checks.
(when (< measured bound)
  (throw (ex-info (str "corpus walk reached only " measured
                       " machines, below the independent grep bound " bound)
                  {})))

;; ── 8. the outcome column ───────────────────────────────────────────────────
;; One letter per machine, in walk order. Running this example twice must print
;; the same column: that is the determinism claim, checked by eye or by diff.
(defn- letter [o]
  (cond (= o :proven) "P" (= o :refuted) "R" (= o :undecided) "U"
        (= o :declined) "D" :else "E"))
(println "8. outcome column (" (count ms) "machines):")
(println (apply str (map letter (vec (map (fn [m] (:outcome m)) ms)))))

;; ── what just happened ──────────────────────────────────────────────────────
;   The numbers above are MEASURED on this revision, not illustrative:
;     files: 397 .bl | grep bound: 58 | machines: 75 | unreadable: 0 | re-read failures: 5
;     outcomes: proved 27, refuted 15, undecided 0, declined 33, error 0
;     (they move when the tree moves; the fixpoint is the PASS on section 7 and
;      the same section-8 column on a second run)
;
; Read it honestly:
;   * "declined" is the LARGEST bucket, and that is the engine being truthful:
;     most machines in this tree are live/reactive and carry no ^{:invariant}, so
;     there is nothing to prove. A verifier that called those "proven" would be
;     the cheerful zero again.
;   * the grep bound counts FILES THAT MENTION the word — comments and docstrings
;     included — so it is NOT a lower bound on files-with-machines (printed in §7;
;     it is smaller than the bound). It is a bound on the WORD, and the walker's
;     MACHINE count is what beats it. Do not compare the file count to it.
;   * the bound is itself inflated by TWO: `priv/lib/z3corpus.bl` and this file
;     spell "defserver" in comments. The margin is not the point -- a walker that
;     returned `machines: 4` is what the comparison exists to catch.
;   * the walker walks TEXT, not values. A machine assembled at runtime from
;     non-literal pieces — `(str "(defserver " (:name d) " …")` — has no whole
;     form in any literal, so it is NOT found; its literal fragments can surface
;     in §2's re-read failures. The walker re-reads single literals and all-
;     literal `(str …)` concatenations; anything more dynamic is invisible.
;   * macro templates are found where they are written: `(defserver ~name …)` in
;     a macro body counts, and its name reads as `(unquote name)`. A macro that
;     builds the HEAD dynamically is invisible.
;   * `:us` is wall-clock for one machine in one process, and the ledger covers
;     this process's decisions only.
;
; Where to look:
;   priv/lib/z3corpus.bl      bl-file? · machines-in-source · corpus · grep-bound
;   priv/lib/system/core.bl   verify-process — the engine each machine is handed to
;   priv/std/z3pool.bl        the gen_servers and the lease behind every question
;   lib/beam_lisp/z3_ledger.ex  the :counters rollup and the per-process trail
