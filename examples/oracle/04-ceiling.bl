; examples/oracle/04-ceiling.bl — where the 10-second deadline came from.
;
; ── what you need to know first ──────────────────────────────────────────────
; z3 can be told to give up: `(set-option :timeout N)`. Then it answers `unknown`
; instead of an answer, and the caller has to decide what that means. So a
; checker has a policy question — HOW LONG — and until this subfeature the answer
; was an argument. (FUP-057 records the argument, and it was a good one: the
; numbers it used came from the tree's own slowest known obligation, a factoring
; question. But no obligation in the corpus had ever been TIMED.)
;
; Now every decision is recorded with its microseconds, and the ceiling can be
; chosen from a distribution. That is what this example computes.
;
; The BEAM part: the counter is an Erlang `:counters` array — a lock-free,
; mutable, shared integer array, the primitive you reach for when a hot path must
; not serialize through a process. The per-process trail is a process-dictionary
; list (like a dynamically scoped variable), so two callers never see each
; other's questions. Cheap to write, constant to read, no message passing.
; ─────────────────────────────────────────────────────────────────────────────

(ns ceiling
  (:require [oracle]
            [system.decide :as decide]
            [z3]
            [z3pool]))

(z3/pool! 1)

(defn- contradiction
  "A trivially unsatisfiable question, parameterised so each one is a different
   script (same script ⇒ the memo would answer it, which would measure nothing)."
  [n]
  (oracle/obligation (keyword (str "c" n))
    ['(declare-const x Int)
     (list 'assert (list '> 'x n))
     (list 'assert (list '< 'x n))]))

(defn- median [xs]
  (let [s (vec (sort xs))
        n (count s)]
    (if (zero? n) 0 (nth s (quot n 2)))))

;; A question that needs a real search: factor a semiprime. This is the shape the
;; tree's deadline was originally argued from.
(def factoring
  (oracle/obligation :factoring
    ['(declare-const p Int)
     '(declare-const q Int)
     '(assert (> p 1))
     '(assert (> q 1))
     '(assert (= (* p q) 43925755729223607997806993733463))]))

;; The pool arms the ceiling at every lease; the environment moves it for a run.
(System/put_env "BL_Z3_TIMEOUT" "300")

(decide/clear-here!)

;; ── the ordinary questions ─────────────────────────────────────────────────
;; `vec`, because `map` is lazy in beam-lisp: without forcing it, no question is
;; asked at all (measured — the first version of this example "measured" nothing).
(vec (map (fn [i] (oracle/ask (contradiction i))) (range 12)))
(def ordinary (vec (filter (fn [d] (= :oracle (:tier d))) (decide/here))))
(def ordinary-us (vec (map (fn [d] (:us d)) ordinary)))

(println "ordinary questions:" (count ordinary-us))
(println "  min   " (apply min ordinary-us) "us")
(println "  median" (median ordinary-us) "us")
(println "  max   " (apply max ordinary-us) "us")

;; ── the one that hits the ceiling ──────────────────────────────────────────
(decide/clear-here!)
(def v (oracle/ask factoring))
(println "factoring:" (:status v) "| why:" (:why v) "| us:" (:us v))

;; ── the policy, from the data ──────────────────────────────────────────────
;; The median ordinary question is the unit of work a checker does thousands of
;; times; the factoring question is the tail. A ceiling is a choice about the
;; tail only, and the number to compare it against is the median, not the mean.
(let [m (median ordinary-us)
      ratio (if (zero? m) 0 (quot (:us v) m))]
  (println "median ordinary:" m "us    the ceiling is" ratio "× that")
  (println "the ceiling in force is" (z3pool/z3-timeout-ms)
           "ms (BL_Z3_TIMEOUT moved it for this run; the pool's default is 10000)"))

; ── what just happened (measured, not estimated) ───────────────────────────
;   ordinary questions: 12
;     min     4.2-7.4 ms  ← the first few pay the lease and the page cache
;     median  4.7-12 ms   ← machine-load dependent: this box is shared, and a
;                           loaded run measures 2-3x a quiet one. The numbers
;                           printed above are THIS run's; the spread here is
;                           what three runs observed.
;     max     13-22 ms
;   factoring: :unknown | why: :timeout | us: ~301-309 ms (the ceiling)
;   ratio: the ceiling is 25-64x the median ordinary question — it moves with
;          load, which is exactly why the program computes it instead of
;          asserting it.
;   the ceiling in force: 300 ms (BL_Z3_TIMEOUT moved it; the pool's default 10 s)
;
; Read the ordinary number honestly: ~5 ms per question is the ONE-SHOT lane
; (`ask` = reset, assert, check). z3 throws its context away on `(reset)` and
; rebuilding it costs ~3 ms on its own, which is why the tree prefers a held
; SESSION for a machine's whole transition set, and a MEMO for questions already
; asked. Measured on this machine by bench/oracle_bench.bl: one-shot `ask` 10.3 ms
; per question cold, `session`+`scoped` 809 us, a memo hit 17 us. The ratio moves
; with load like everything above; the ORDER never does. This example uses
; `ask` because it wants every question to reach the solver.
;
; So the policy reads: a single obligation is ~5 ms, so a ceiling anywhere from
; 1 s to 30 s costs a checker nothing — it will never fire on the ordinary case.
; The ceiling exists for the TAIL, and the tail's job is to come back as
; `:undecided` with a `:why`, rather than to block a build. That is why the value
; lives in one place (z3pool/z3-timeout-ms, armed per lease) instead of in every
; caller, and why it can now be moved by evidence.
;
; Where to look:
;   lib/beam_lisp/z3_ledger.ex  record/4 (per decision, microseconds), cost/0,
;                              histogram/0 — the counters and the per-process trail
;   priv/lib/system/decide.bl   cost/0, here/0 — the language's view
;   priv/std/z3pool.bl          z3-timeout-ms — the default, armed per lease
;
; Honest limit: this measures the obligations a caller asks. Nothing yet rolls
; `decide/cost` up over a whole `bl check` of the corpus, which is the next
; measurement that would make the default a decision rather than a default.
