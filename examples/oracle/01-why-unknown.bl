; examples/oracle/01-why-unknown.bl — "no answer" is not one thing.
;
; ── what you need to know first ──────────────────────────────────────────────
; z3 is a separate OS process. This runtime talks to it over a pipe — an Erlang
; `port` — and keeps a small POOL of them behind gen_servers (priv/std/z3pool.bl).
; A question is: build SMT-LIB text, send it down the pipe, read ONE WORD back:
; `sat`, `unsat`, or `unknown`.
;
; `unknown` is the interesting one. It means z3 DID NOT DECIDE. A verifier that
; reads "did not decide" as "fine" is broken; one that reads it as "violated" is
; a liar. So a verdict record here has a status that can be a third thing — and
; as of this subfeature, it also carries z3's own reason for the silence.
;
; The BEAM part: none of this blocks a scheduler. The waiting happens inside the
; gen_server that owns the pipe; `ask`/`scoped` are ordinary message-passing
; calls into it. If you know `GenServer.call/3`, you already know the shape.
; ─────────────────────────────────────────────────────────────────────────────

(ns why-unknown
  (:require [oracle]
            [system.decide :as decide]
            [z3]))

;; One solver is enough for a lesson. A real run uses the pool (z3/pool! 4).
(z3/pool! 1)

;; A question z3 can answer instantly: x cannot be both > 1 and < 0.
(def contradiction
  (oracle/obligation :contradiction
    ['(declare-const x Int)
     '(assert (> x 1))
     '(assert (< x 0))]))

;; A question z3 CANNOT answer, and cannot be made to answer: factor this number.
;; p and q are > 1 and their product is a semiprime — factoring is the original
;; hard problem, so this is a question where a ceiling is the honest answer and
;; a longer ceiling would only be a longer wait.
(def factoring
  (oracle/obligation :factoring
    ['(declare-const p Int)
     '(declare-const q Int)
     '(assert (> p 1))
     '(assert (> q 1))
     '(assert (= (* p q) 43925755729223607997806993733463))]))

;; The pool arms z3's own ceiling at every lease; the environment is how we move
;; it for one run. 300 ms keeps the lesson short.
(System/put_env "BL_Z3_TIMEOUT" "300")

(decide/clear-here!)

;; A `session` is a held conversation: the pool leases one solver and keeps it.
;; `scoped` is one question inside it — push, assert, check, pop — so the next
;; question does not start over. (Cheaper AND it keeps the pool's other solvers
;; free for other work; see priv/std/z3pool.bl.)
(z3/with-solver
  (fn []
    (let [v (oracle/scoped contradiction)]
      (println "contradiction →" (:status v)
               "| why:" (:why v)
               "| us:" (:us v)))

    (let [v (oracle/scoped factoring)]
      (println "factoring     →" (:status v)
               "| why:" (:why v)
               "| us:" (:us v))
      ;; THE POINT: a caller can now tell the two kinds of silence apart. A
      ;; `:timeout`/`:canceled` reason says "raise the ceiling or simplify the
      ;; question"; an `:incomplete` reason says "no ceiling will ever help".
      (println "  is it an answer?  proven?" (oracle/proven? v) "refuted?" (oracle/refuted? v))
      (println "  is it a ceiling?  timeout/canceled →"
               (if (or (= :timeout (:why v)) (= :canceled (:why v))) "yes" "no"))
      (println "  undecided?" (oracle/undecided? v)))))

;; Every decision the runtime made is in the ledger, with its cost — which is how
;; a ceiling gets chosen from a distribution instead of an argument.
(println "ledger:" (decide/cost))

; ── what just happened ───────────────────────────────────────────────────────
;   contradiction → :unsat | why: nil      ← a proof explains itself
;   factoring     → :unknown | why: :canceled | us: ~301-302 ms (the ceiling;
;                                 the number printed above is THIS run's)
;   ledger: {:count 2 :total_us … :max_us …}
;
; `why` is nil exactly when there IS an answer: z3 replies to
; `(get-info :reason-unknown)` with the empty string after a decided check, and
; the runtime turns that into nil rather than into a name it would be inventing.
;
; Where to look:
;   lib/beam_lisp/z3_port.ex   raw_reason/3 + extract_reason/1 — the ask, and the
;                              parse that refuses to guess
;   priv/lib/oracle.bl         why-kw/1 — the wire's words as keywords, with an
;                              unrecognised reason passed through verbatim
;   priv/lib/z3.bl             :why rides on every verdict record, with :status
;
; The BEAM lesson: a blocking, non-deterministic, sometimes-silent external
; process is a normal thing to own from a gen_server. What was missing was not
; concurrency — it was asking the process WHY it stayed silent, and carrying the
; answer back as data.
