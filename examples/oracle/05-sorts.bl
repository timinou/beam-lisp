; examples/z3/05-sorts.bl — a field's type decides which arithmetic z3 does.
;
; ── what you need to know first ──────────────────────────────────────────────
; Every state field of a machine becomes an SMT constant of some SORT: `Int`,
; `Real`, `Bool`, `String`, or a datatype for an enum. That choice is not
; cosmetic. `2 * x = 1` has NO integer solution and exactly one real one, so a
; checker that declares `x` as `Int` when the machine means a real number will
; answer a different question than the one you asked — usually without telling
; you (measured below: the same script, one word changed, goes `unsat` → `sat`).
;
; The sorts come from the init literals, through one functor
; (`system.smt/sort-of-value`): `3 → Int`, `0.5 → Real`, `true → Bool`,
; `"hi" → String`, and a keyword init value becomes an enum datatype.
;
; The BEAM part: nothing here is concurrent. This is the "types are a bird's-eye
; view" move — the runtime reads the type from the value it was handed instead of
; guessing, and the guess it used to make (`Int`, always) is exactly the kind of
; locally-reasonable choice that is globally wrong.
; ─────────────────────────────────────────────────────────────────────────────

(ns sorts
  (:require [system.core :as sys]
            [system.smt :as smt]
            [z3]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))

;; ── a machine whose state is a real number ─────────────────────────────────
;; `x` starts at 0.5, and the invariant says its double is 1 — true of 0.5, and
;; false of every integer. Modelled as `Real`, this verifies. Modelled as `Int`
;; (what the runtime used to do for a bare literal init), the establishment check
;; answers `sat` — "here is a state that does not establish it" — and a correct
;; machine is reported as broken.
(def real-state
  "(defserver ^{:invariant (= (* x 2) 1)} half
     (init [x] (ok 0.5))
     (handle-call [:noop] [_ x] (reply :ok x)))")

;; ── the same shape with an integer ─────────────────────────────────────────
(def int-state
  "(defserver ^{:invariant (>= n 0)} counter
     (init [n] (ok 0))
     (handle-call [:bump] [_ n] (reply :ok (+ n 1))))")

;; ── and one that is genuinely broken (the fix must not pass everything) ────
(def broken
  "(defserver ^{:invariant (= (* x 2) 1)} wrong
     (init [x] (ok 0.75))
     (handle-call [:noop] [_ x] (reply :ok x)))")
(defn- show [title src]
  (let [r (sys/verify-process (z3/open) (read1 src))]
    (println (str "── " title)
             "| holds:" (:holds r)
             "| warned:" (count (:warnings r))
             "| failures:" (count (:failures r)))
    ;; a refusal now names WHICH check refused and hands back the state that did:
    (vec (map (fn [f]
                (println (str "     " (name (:label f)) " → " (:sentence (:counterexample f))
                              (if (some? (:blame f))
                                (str "   blame: " (name (:blame (:blame f))))
                                ""))))
              (:failures r)))))
(z3/pool! 1)
(show "a real-valued state (0.5, 2x = 1)" real-state)
(show "an integer state (0, n >= 0)" int-state)
(show "the same invariant with 0.75" broken)

;; What the sorts actually are, straight from the functor:
(let [n1 (fn [s] (first (BeamLisp.Reader/read_string s)))]
  (println "sorts:" "3 →" (smt/sort-of-value (n1 "3"))
           "| 0.5 →" (smt/sort-of-value (n1 "0.5"))
           "| true →" (smt/sort-of-value (n1 "true"))))

; ── what just happened (measured) ────────────────────────────────────────────
;   a real-valued state (0.5, 2x = 1)   | holds: true  | warned: 0 | failures: 0
;   an integer state (0, n >= 0)        | holds: true  | warned: 0 | failures: 0
;   the same invariant with 0.75        | holds: false | warned: 1 | failures: 1
;     init → counterexample: x = 0.75   blame: next-step-breaks-it
;
; The first line is the fix. Before it, the runtime took the init literal's sort
; from a two-case string match and everything else became `Int`, so this machine
; read `holds: false` — and the same script through the bundled z3 says why:
;
;   (define-fun Inv ((x Real)) Bool (= (* x 2) 1))   (assert (not (Inv 0.5)))  → unsat
;   (define-fun Inv ((x Int))  Bool (= (* x 2) 1))   (assert (not (Inv 0.5)))  → sat
;
; One word. The third line is the control that keeps this honest: with 0.75 the
; invariant is false of the initial state, and the checker still refuses it —
; the fix teaches the runtime a sort, it does not teach it optimism.
;
; The refusal is a REFUSAL NOW, not a number: the establishment check is an entry
; in `:failures` (`:label :init`) like a refuted step, carrying the state that
; failed (`x = 0.75`) and a blame. `holds: false` with `failures: 0` used to send
; the reader to this prose to find out WHICH check refused; the map says it.
;
; Where to look:
;   priv/lib/system/core.bl      state-shape — which sort each field gets, and
;                                the scalar branch that now asks the functor;
;                                establishment-verdict — the init check that now
;                                reports a `:failures` entry
;   priv/lib/system/smt.bl       sort-of-value — :int→Int :float→Real :bool→Bool
;                                :string→String
;
; What is still open (FUP-059): the functor reads the INIT LITERAL. A field with
; no readable literal, or one whose true sort only appears in an annotation, still
; falls back to Int — and `typed` already holds the annotations to read. That is
; the half of this subfeature that is not done, and it changes verdicts, so it
; wants its own before/after differential over the corpus.
