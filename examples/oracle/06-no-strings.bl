; examples/oracle/06-no-strings.bl — a predicate that arrives as TEXT is READ, not pasted.
;
; ── what you need to know first ──────────────────────────────────────────────
; Everything this checker sends z3 is a FORM (priv/lib/smt.bl). beam-lisp's
; prefix notation IS SMT-LIB's, so a constraint is `(>= balance 0)` and exactly
; one function — `smt/emit` — turns a form into text at the z3 port's edge. But
; the CALLER may still hand a predicate as a STRING: that is the API of every
; example and tool in this tree, and it stays the API.
;
; What changed is where a string may go. It used to be CONCATENATED into a
; script — `(str "(assert " t ")")` — and concatenation cannot tell a TERM from
; a STRING LITERAL. A predicate that arrived quoted reached z3 as `"z < 0"`: an
; inert VALUE, not a constraint, which z3 happily answers `sat` to. That is how
; `z > 1 ∧ z < 0` came back REFUTED.
;
; Now a string is READ ONCE, at the edge (`smt/read-term`), into the form that
; `emit` renders back — so every path downstream of that helper is form-only,
; and malformed text is REFUSED with its own text in the message instead of
; being emitted.
;
; The BEAM part: the cost of each decision goes into an Erlang `:counters`
; array — a shared, lock-free, mutable integer array — plus a per-process trail
; (the process dictionary, i.e. a dynamically scoped variable). `(decide/here)`
; reads this process's trail, `(decide/cost)` the counters. That is how the
; numbers below are MEASURED rather than assumed, and why the ledger shows the
; three routes in section 2 really did ask ONE question.
; ─────────────────────────────────────────────────────────────────────────────

(ns no-strings
  (:require [oracle]
            [smt :as smtlib]
            [system.decide :as decide]
            [system.smt :as smt]
            [z3]))

(z3/pool! 1)

;; ── 1. one obligation, three ways in ────────────────────────────────────────
;; The predicate is `z > 1 ∧ z < 0`: unsatisfiable — and exactly the shape that a
;; pasted string used to turn satisfiable.

(def decl-z (smtlib/declare-const 'z 'Int))
(def predicate-text "(and (> z 1) (< z 0))")

;; (a) the native lane — a quoted FORM, composed as data
(def via-form
  (oracle/obligation :z-contradiction
    [decl-z (smtlib/assert '(and (> z 1) (< z 0)))]))

;; (b) the legacy lane — the same predicate as TEXT, READ once here
(def via-text
  (oracle/obligation :z-contradiction
    [decl-z (smtlib/assert (smtlib/read-term predicate-text))]))

;; (c) the source lane — a bl expression the ENGINE's translator lowers
;;     (`system.smt`): this is where a `defserver` guard comes from.
(def via-body
  (oracle/obligation :z-contradiction
    [decl-z (smtlib/assert (smt/of-source #{"z"} predicate-text))]))

(defn- show [tag obl]
  (println tag)
  (println (smtlib/script (:cmds obl))))

(show "(a) from a quoted FORM:" via-form)
(show "(b) from a legacy STRING, read once:" via-text)
(show "(c) from a bl source expression, translated:" via-body)

(def scripts (vec (map (fn [o] (smtlib/script (:cmds o))) [via-form via-text via-body])))
(println "the three scripts are the same text:"
         (and (= (nth scripts 0) (nth scripts 1))
              (= (nth scripts 1) (nth scripts 2))))

;; ── 2. three questions, or one? the ledger decides ──────────────────────────
;; Asking is what costs: an obligation's script is memoised, so a route that
;; produces the SAME text is answered from the memo without a solver call.
(decide/clear-here!)
(def verdicts (vec (map (fn [o] (oracle/ask o)) [via-form via-text via-body])))
(println "verdicts:" (pr-str (vec (map (fn [v] (:status v)) verdicts))))
(println "answered by:" (pr-str (vec (map (fn [d] (:tier d)) (decide/here)))))
(println "ledger:" (pr-str (decide/cost)))

;; ── 3. a BLOCK is not a term ────────────────────────────────────────────────
;; A `decls` block is a SEQUENCE of commands, not one s-expression; the plural
;; reader (`smt/read-terms`) reads all of them.
(def decls-block "(declare-const balance Int)\n(declare-const amt Int)\n")
(def premises-block "(assert (>= b1 amt))\n(assert (>= amt 0))")
(println "decls block   →" (pr-str (smtlib/read-terms decls-block)))
(println "premise block →")
(println (smtlib/script (smtlib/read-terms premises-block)))
(println "blank text is" (count (smtlib/read-terms "")) "commands")

;; ── 4. what the reader REFUSES ──────────────────────────────────────────────
;; A malformed predicate must never be emitted as a literal; it throws, and the
;; message carries the offending text.
(defn- refusal [f]
  (try (f) "NO ERROR — it was accepted as a value" (catch e (:message e))))

(println "unclosed predicate →" (refusal (fn [] (smtlib/read-term "(>= z 0"))))
(println "two terms          →" (refusal (fn [] (smtlib/read-term "z w"))))
(println "unclosed block     →" (refusal (fn [] (smtlib/read-terms "(declare-const z Int"))))

;; ONE SMT-LIB spelling this reader does NOT reproduce, so it is worth seeing:
;; z3 reads `"a""b"` as the one string `a"b` (SMT-LIB doubles a quote inside a
;; literal); the language reader sees two adjacent strings. Measured, not
;; asserted:
(println "doubled-quote literal →"
         (pr-str (smtlib/emit (smtlib/read-term "(= s \"a\"\"b\")"))))

;; ── 5. the round trip, over the predicates this tree actually passes ────────
;; Every string below is one a test or an example hands the engine today
;; (test/bl/system/*.bl, examples/system/*.bl): guards, next-state expressions,
;; an init constant, and the block-shaped ones.
(def predicates
  ["(>= balance 0)" "(>= amt 0)" "(and (>= amt 0) (>= balance amt))"
   "(+ balance amt)" "(- balance amt)" "(+ n 1)" "(+ c 1)" "(= n c)" "0"
   "(>= b1 amt)"])
(def blocks
  ["(declare-const balance Int)\n(declare-const amt Int)\n"
   "(declare-const n Int)\n(declare-const c Int)\n"
   "(declare-const b1 Int)\n(declare-const b2 Int)\n(declare-const amt Int)\n"
   "(assert (>= b1 amt))\n(assert (>= amt 0))"])
(def mismatches
  (vec (filter (fn [p] (not= p (smtlib/emit (smtlib/read-term p)))) predicates)))
(println "predicates:" (count predicates)
         "| read then emitted back identically:" (- (count predicates) (count mismatches))
         "| mismatches:" (count mismatches))
(println "block commands read:" (count (vec (mapcat smtlib/read-terms blocks))))

; ── what just happened (measured, not estimated) ─────────────────────────────
;   (a)/(b)/(c) emit the SAME three lines — `(declare-const z Int)` then
;   `(assert (and (> z 1) (< z 0)))`. No quotes: a string literal cannot appear
;   in the script at all.
;   verdicts: [:unsat :unsat :unsat] — three routes in, one answer out.
;   answered by: [:oracle :memo :memo] with ledger {:count 3 :max_us … :total_us …}:
;   the first question pays the solver lease (tens of ms, machine-dependent) and
;   the memoised two cost 0 us — so the three produced ONE question, and the
;   ledger (an Erlang :counters array) is what says so.
;   refusals name their input: `smt/read-terms: not SMT-LIB: (>= z 0`.
;   round trip over the tree's own predicates: 10 of 10 identical, 0 mismatches,
;   and 9 commands read out of 4 blocks. The doubled-quote literal above comes
;   back as `(= s "a" "b")` — a DIFFERENT term, which is the limit stated below.
;
; Where to look:
;   priv/lib/smt.bl          read-term / read-terms / normalise — the reader,
;                            and the ONE difference from an SMT atom: an
;                            attribute keyword keeps its colon (`:named`, not
;                            `named`)
;   priv/lib/system/core.bl  as-term / as-cmds — the two helpers that read a
;                            legacy string once, at the edge; every other helper
;                            composes forms
;   priv/lib/system/decide.bl, lib/beam_lisp/z3_ledger.ex — here/cost, and the
;                            :counters behind them
;
; Honest limit: this is the language's READER with a normalisation pass, not a
; full SMT-LIB parser. Two things it will not take, both MEASURED above: the
; doubled-quote string literal (it reads as two strings), and anything the
; reader rejects (`#…` reader macros are not SMT). It also does not EVALUATE:
; the form it returns is data. And the round trip shown holds for the predicates
; this tree passes — evidence, not a proof about every SMT-LIB term z3 accepts.
; `smt/raw` is untouched and still the right tool for a whole literal script
; (`oracle/script-lines` uses it).
