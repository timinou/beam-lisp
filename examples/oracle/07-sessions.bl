; examples/oracle/07-sessions.bl — why a conversation beats a question.
;
; ── what you need to know first ──────────────────────────────────────────────
; `oracle/ask` sends z3 a COMPLETE script: `(reset)`, the declarations, the
; assertions, `(check-sat)`. The `(reset)` throws the solver's context away, and
; rebuilding it is most of what a question costs.
;
; `discover-invariant` asks a DOZEN questions about ONE machine and they all share
; a prefix — the state declarations and their primed copies. Holding an
; `oracle/session` declares that prefix ONCE and then asks each candidate inside
; it with `oracle/scoped`, a push/assert/check/pop that costs microseconds at the
; solver. Same questions, same answers, a fraction of the time.
; `BL_ORACLE_SESSIONS=off` keeps the one-shot path alive, so the comparison below
; is possible AT ALL: a switch kept for a differential, not a feature flag.
;
; The BEAM part: a session is a LEASE on a `z3-solver` gen_server — one of four
; in the pool, checked out for the whole conversation and returned in a `finally`
; (or by monitor if the borrower dies). The solver answers one call at a time, so
; the lease IS the mutual exclusion: no lock, no owner bookkeeping. The same
; shape as any checkout with a deadline.
; ─────────────────────────────────────────────────────────────────────────────

(ns sessions
  (:require [system.core :as sys] [oracle] [system.decide :as decide] [z3] [z3pool]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- h [t] (println (str "\n── " t " ──")))
(defn- now [] (erlang/monotonic_time :microsecond))

;; the machine from examples/system/14_discover_invariant.bl: an account with NO
;; invariant — discovery has to find one.
(def account
  "(defserver account
     (init [] (ok 0))
     (handle-call [:deposit amt] [_ balance] :when (>= amt 0)
       (reply :ok (+ balance amt)))
     (handle-call [:withdraw amt] [_ balance] :when (and (>= amt 0) (>= balance amt))
       (reply :ok (- balance amt))))")

;; The candidate vocabulary is fixed and small: (op balance k) for op ∈ {<=, >=}
;; and k ∈ {0, 1} — four candidates. `questions` in the report is how many SOLVER
;; questions the Houdini fixpoint asked to choose among them.
(def candidate-count 4)

(defn- discovery [sessions-on?]
  ;; the switch is read from the environment PER CALL, so both lanes run the same
  ;; discovery code with only the ask strategy changed
  (if sessions-on?
    (System/delete_env "BL_ORACLE_SESSIONS")
    (System/put_env "BL_ORACLE_SESSIONS" "off"))
  (oracle/memo-clear!)
  (decide/reset-ledger!)
  (decide/clear-here!)
  (let [t0 (now)
        d (sys/discover-invariant (z3/open) (read1 account))
        wall (- (now) t0)
        c (decide/cost)
        tiers (decide/here)]
    (System/delete_env "BL_ORACLE_SESSIONS")
    {:discovered (:discovered d)
     :checked (:checked d)
     :questions (:count c)
     :total_us (:total_us c)
     :max_us (:max_us c)
     :solver-calls (count (filter (fn [t] (= :oracle (:tier t))) tiers))
     :memo-hits (count (filter (fn [t] (= :memo (:tier t))) tiers))
     :wall_us wall}))

(defn- report [tag r]
  (println (str "  " tag))
  (println "    candidates tried:" candidate-count
           "| questions asked:" (:questions r)
           "| solver calls:" (:solver-calls r)
           "| memo hits:" (:memo-hits r))
  (println "    ledger:" (:total_us r) "µs total | worst" (:max_us r) "µs"
           "| wall clock" (:wall_us r) "µs")
  (println "    discovered:" (:discovered r) "| checked:" (:checked r)))

(z3/pool! 4)

;; ── 0. warm the pool FIRST ───────────────────────────────────────────────────
;; The first questions a fresh VM asks pay a one-time cost (the port, z3's own
;; start-up). `bench/oracle_bench.bl` warms before it times, for the same reason;
;; without this the comparison measures the warm-up, not the strategy. The warm-up
;; is a discarded discovery on the SAME machine; the memo is cleared before each
;; measured lane, so the warm-up cannot answer either one.
(def warmed (discovery true))
(println "0. warm-up (discarded):" (:discovered warmed)
         "| " (:questions warmed) "questions | wall" (:wall_us warmed) "µs")
(println "   the two lanes below ask the same" (:questions warmed) "questions")

(h "1. discovery, one-shot (BL_ORACLE_SESSIONS=off — the path before the session)")
(def before (discovery false))
(report "before:" before)

(h "2. discovery, ONE session")
(def after (discovery true))
(report "after: " after)

(h "3. the point: the SAME answer, cheaper")
(println "  discovered identical:" (= (pr-str (:discovered before)) (pr-str (:discovered after))))
(println "  checked identical:   " (= (:checked before) (:checked after)))
(println "  questions asked:     " (:questions before) "→" (:questions after))
(println "  ledger µs:           " (:total_us before) "→" (:total_us after))
(println "  µs per question:     "
         (quot (:total_us before) (max 1 (:questions before))) "→"
         (quot (:total_us after) (max 1 (:questions after))))

(h "4. the session IS a lease on a gen_server")
(println "  (z3pool/current) outside a session:" (pr-str (z3pool/current)))
(oracle/session []
  (fn [] (println "  (z3pool/current) inside  a session:" (pr-str (z3pool/current)))))
(println "  ... and outside again:              " (pr-str (z3pool/current)))

(h "the takeaway")
(println "  A conversation, not a question: hold the solver, declare the shared")
(println "  prefix once, ask each candidate with a push/pop. `discover-invariant`")
(println "  and `synthesize-capacity` both do this now, and BL_ORACLE_SESSIONS=off")
(println "  keeps the old one-shot lane reachable — so the equality in section 3 is")
(println "  a MEASURED differential, not a promise.")

; ── what just happened (measured) ────────────────────────────────────────────
;   One run on the account machine (the numbers print above; they MOVE run to run):
;     before (one-shot):   10 questions | ledger 65525 µs | 6552 µs/question | wall 77868 µs
;     after  (one session): 10 questions | ledger  2435 µs |  243 µs/question | wall 20752 µs
;     discovered identical: true | checked identical: true | questions asked: 10 → 10
;
;   What the numbers are NOT: the ~15× of `bench/oracle_bench.bl`, which repeats
;   ONE question 100 times over a small prelude. Discovery asks 10 DIFFERENT
;   questions and the fixpoint's later passes ask fewer of them; the ratio moves
;   with the machine and the load, so compare the two printed lines, not this one.
;
; Honest limits:
;   * the one-shot lane is memoised (`oracle/ask` caches a decided script); the
;     session lane is not (`scoped` means whatever the conversation holds). Both
;     lanes printed `memo hits: 0` here — discovery's candidate questions are
;     distinct — so neither is flattered, but the two paths really do differ.
;   * the first questions in a freshly-pooled VM pay a warm-up; section 0 removes
;     most of it, and the OFF lane is measured AFTER the ON lane's warm-up, so it
;     is if anything favoured.
;   * wall clock is one process's start-to-finish time; the ledger is the sum of
;     the solver calls. Neither is a ceiling for a bigger machine.
;   * a HANDLER (`oracle/with-oracle`) is answered by the handler in both lanes;
;     `oracle/scoped` then sends prelude+scope as one script, so the session path
;     stays correct with no solver at all (oracle_test covers it).
;
; A bug worth keeping in the record, because the differential did NOT catch it: the
; first cut of the switch wrote `(or (nil? v) …)` inside a `not`, so an UNSET
; `BL_ORACLE_SESSIONS` turned sessions OFF and BOTH lanes ran one-shot. The values
; still matched (they are the same questions!), so the equality in section 3 was
; true AND meaningless — a differential that pins values without pinning the
; MECHANISM cannot see a dead switch. Both lanes then read ~5 ms/question. What
; caught it was asking `(z3pool/current)` inside a lane: nil, because no session
; was held. `oracle_test`'s `the-lane-switch-is-observable` now pins the mechanism.

