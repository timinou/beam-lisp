; examples/z3/03-memo.bl — the same question, the second time, costs nothing.
;
; ── what you need to know first ──────────────────────────────────────────────
; A question to z3 is built as a VALUE here: `(oracle/obligation label cmds)`
; renders a script and keeps its text. That text is the question's IDENTITY — so
; "have I asked this before?" needs no clever comparison, just a hash of the
; bytes, and the answer can be remembered.
;
; The BEAM part: the memory is an ETS table (`:oracle-memo`) — the same
; concurrency primitive you would reach for first in Erlang: a hash table shared
; between processes, read without going through any gen_server. There is no cache
; process, no message, no invalidation protocol. The lookup is one ETS read.
;
; The ledger (lib/beam_lisp/z3_ledger.ex) records WHO answered every decision —
; `:z3`, `:native-witness`, or `:memo` — which is how this example can prove the
; second ask never reached the solver.
; ─────────────────────────────────────────────────────────────────────────────

(ns memo-example
  (:require [oracle]
            [system.decide :as decide]
            [z3]))

(z3/pool! 1)
(oracle/memo-clear!)
(decide/clear-here!)

;; A question with one answer and no ambiguity: x cannot be both > 1 and < 0.
(def contradiction
  (oracle/obligation :contradiction
    ['(declare-const x Int)
     '(assert (> x 1))
     '(assert (< x 0))]))

(def solver-calls
  (fn [] (count (filter (fn [d] (= :z3 (:tier d))) (decide/here)))))

;; ── the first ask goes to z3 ────────────────────────────────────────────────
(def first-answer (oracle/ask contradiction))
(println "first  →" (:status first-answer)
         "| tier:" (:tier first-answer)
         "| us:" (:us first-answer)
         "| solver calls so far:" (solver-calls))

;; ── the second ask is answered from memory ─────────────────────────────────
(decide/clear-here!)
(def second-answer (oracle/ask contradiction))
(println "second →" (:status second-answer)
         "| tier:" (:tier second-answer)
         "| us:" (:us second-answer)
         "| solver calls:" (solver-calls)
         "| memo entries:" (oracle/memo-size))

;; ── and the two answers are the same answer ────────────────────────────────
(println "same verdict?" (= (:status first-answer) (:status second-answer)))

;; ── what is NOT remembered, and why ────────────────────────────────────────
;; 1. `unknown` is not an answer, it is a statement about the SOLVER (a ceiling it
;;    hit). Caching it would make a transient limit permanent.
;; 2. `error` is a transport failure, and must not stick to the script either.
;; 3. A CONVERSATION question (`scoped`) is never memoised: the same commands mean
;;    different things depending on what the conversation has already asserted, so
;;    the text is not an identity there.
(oracle/memo-clear!)
(System/put_env "BL_Z3_TIMEOUT" "1")
(def hard (oracle/obligation :factoring
            ['(declare-const p Int) '(declare-const q Int)
             '(assert (> p 1)) '(assert (> q 1))
             '(assert (= (* p q) 43925755729223607997806993733463))]))
(println "hard  →" (:status (oracle/ask hard)) "| memo entries now:" (oracle/memo-size)
         "(nothing cached: an undecided question is not a fact)")
(System/delete_env "BL_Z3_TIMEOUT")

(println "ledger:" (decide/cost))

; ── what just happened ───────────────────────────────────────────────────────
;   first  → :unsat | tier :z3   | us ~13-17 ms | solver calls so far: 1
;           (the FIRST ask pays for the lease and z3's first answer; the number
;            printed above is this run's. The ledger line below does NOT count it:
;            the program clears its per-request cost between the two asks, which is
;            why :count 2 is the memo ask plus the hard ask.)
;   second → :unsat | tier :memo | us 0      | solver calls: 0 | memo entries: 1
;   same verdict? true
;   hard   → :unknown | memo entries now: 0
;
; The second question cost one ETS read. Multiply that by a tree: the engine's
; obligations are functions of the code they came from, so re-verifying code that
; has not changed asks the solver nothing — which is the difference between a
; checker you run on every save and one you run before a release.
;
; Where to look:
;   priv/lib/oracle.bl        obligation/2 — the text IS the identity, hashed;
;                             ask/2 — memo first, `:memo` recorded in the ledger;
;                             memo-on!/memo-off!/with-memo — the policy switch
;   lib/beam_lisp/z3_ledger.ex  record/4 and the tier histogram
;
; Honest limit: the memo covers `ask`. The engine's per-transition loops use
; `scoped` inside a session (cheaper per question, and stateful), so they are not
; memoised — a state-independent key for those is the open work.
