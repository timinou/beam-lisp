; examples/z3/09-blame.bl — when repair cannot help, it says why.
;
; ── what you need to know first ──────────────────────────────────────────────
; There are two ways to be refused, and they are POLAR OPPOSITES:
;
;   * `verify-process` asks "can this step BREAK the invariant?" —
;     Inv(s) ∧ guard ∧ next ∧ ¬Inv(s2). A refusal is `sat`, so the hint is a
;     MODEL: `oracle/witness` hands back the state and input that break it.
;   * when `repair-process` cannot save a broken transition it asks the DUAL —
;     "can any state this transition reaches SATISFY the invariant?" —
;     guard ∧ next ∧ Inv(s2). THAT question's expected answer is `unsat`, so its
;     hint is an UNSAT CORE: `oracle/explain` reads the subset of NAMED
;     assertions that made the question unsatisfiable, and the subset is the
;     diagnosis.
;
;   Asking for a core of a `sat` answer is asking z3 for something it does not
;   have. The engine names its three step parts (`g_guard`, `g_next`, `g_inv2`)
;   so the core can say WHICH part is at fault.
;
; The BEAM part: every lease arms `(set-option :produce-unsat-cores true)`, so any
; conversation can be asked for a core AFTER a refusal at no cost until then. The
; core is one extra question on a conversation already held — section 5 prices it.
; ─────────────────────────────────────────────────────────────────────────────

(ns blame
  (:require [system.core :as sys] [oracle] [smt :as smtlib]
            [system.decide :as decide] [z3] [z3pool]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- h [t] (println (str "\n── " t " ──")))
(defn- now [] (erlang/monotonic_time :microsecond))

;; ── 1. repairable: a guard the vocabulary can supply ────────────────────────
(def overdraft
  "(defserver ^{:invariant (>= balance 0)} acct
     (init [] (ok 100))
     (handle-call [:withdraw amt] [_ balance]
       (reply :ok (- balance amt))))")

;; ── 2. unrepairable: the next-state can NEVER satisfy the invariant ─────────
(def drain
  "(defserver ^{:invariant (>= balance 0)} drain
     (init [] (ok 100))
     (handle-call [:drain] [_ balance]
       (reply :ok (- 0 1))))")

;; ── 3. unrepairable: the guard excludes every good post-state ───────────────
(def blocked
  "(defserver ^{:invariant (>= n 0)} blocked
     (init [] (ok 0))
     (handle-call [:dec] [_ n] :when (<= n 0)
       (reply :ok (- n 1))))")

;; ── 4. the invariant admits no state at all ────────────────────────────────
(def impossible
  "(defserver ^{:invariant (and (>= x 5) (<= x 1))} bad
     (init [x] (ok 0))
     (handle-call [:noop] [_ x] (reply :ok x)))")

(defn- ledger-of [f]
  (oracle/memo-clear!)
  (decide/reset-ledger!)
  (decide/clear-here!)
  (let [t0 (now)
        r (f)
        c (decide/cost)]
    {:r r :decisions (:count c) :us (:total_us c) :max (:max_us c)
     :wall (- (now) t0)}))

(defn- show-repair [title e]
  (let [m (:m e) entry (:entry e)]
    (println (str "  " title)
             "| guard:" (pr-str (:guard entry))
             "| decisions:" (:decisions m) "| µs:" (:us m))
    (when (some? (:counterexample entry))
      (println (str "     witness (sat → MODEL): " (:sentence (:counterexample entry)))))
    (when (some? (:blame entry))
      (println (str "     blame   (unsat → CORE): " (name (:blame (:blame entry)))
                    "  core " (pr-str (:core (:blame entry)))))
      (println (str "       " (:sentence (:blame entry)))))))

(defn- repair-of [src]
  (let [m (ledger-of (fn [] (sys/repair-process (z3/open) (read1 src))))]
    {:m m :r (:r m) :entry (first (:repairs (:r m)))}))

(defn- establish-of [src]
  (let [m (ledger-of (fn [] (sys/verify-process (z3/open) (read1 src))))]
    {:m m :r (:r m) :entry (first (:failures (:r m)))}))

(z3/pool! 4)
;; warm the pool before the priced sections (the first questions a fresh VM asks
;; pay the port/start-up; `bench/oracle_bench.bl` warms for the same reason)
(sys/repair-process (z3/open) (read1 overdraft))

(h "1. a broken transition the vocabulary CAN repair")
(def r1 (repair-of overdraft))
(show-repair "overdraft" r1)

(h "2. unrepairable — the next-state expression can never be good")
(def r2 (repair-of drain))
(show-repair "drain    " r2)

(h "3. unrepairable — the guard excludes every good post-state")
(def r3 (repair-of blocked))
(show-repair "blocked  " r3)

(h "4. the invariant itself is impossible (an ESTABLISHMENT refusal)")
(def r4 (establish-of impossible))
(show-repair "impossible" r4)

(h "5. the failure maps, side by side")
(println "  repairable   " (pr-str (:entry r1)))
(println "  next-breaks  " (pr-str (:entry r2)))
(println "  guard-blocks " (pr-str (:entry r3)))
(println "  impossible   " (pr-str (:entry r4)))

(h "6. what the extra question costs")
;; The blame question is a core question: `oracle/scoped` returns a status only,
;; so the lane pushes the named parts itself and reads `oracle/here-verdict` with
;; `:core?`. Price the two on the SAME conversation, same question.
(def dual-prelude
  ['(define-fun Inv ((balance Int)) Bool (>= balance 0))
   '(declare-const balance Int)
   '(declare-const balance2 Int)])
(def dual-parts
  [(smtlib/assert (list '! '(= balance2 (- 0 1)) (symbol ":named") (symbol "g_next")))
   (smtlib/assert (list '! '(Inv balance2) (symbol ":named") (symbol "g_inv2")))])
(decide/clear-here!)
(oracle/memo-clear!)
(oracle/session dual-prelude
  (fn []
    (let [obl (oracle/obligation :dual dual-parts)]
      ;; warm this conversation's first question OUT of the measurement
      (oracle/scoped obl)
      (decide/clear-here!)
      (let [v (oracle/scoped obl)]
        (println "  scoped (status only):   " (:status v) "| us" (:us v)))
      (z3pool/command "(push 1)")
      (z3pool/command (smtlib/script dual-parts))
      (let [cv (oracle/here-verdict {:core? true})]
        (z3pool/command "(pop 1)")
        (println "  here-verdict (core on): " (:status cv)
                 "| core" (pr-str (:core cv)) "| us" (:us cv))))))
(println "  ledger for the pair:" (pr-str (decide/cost)))

(h "the takeaway")
(println "  A refusal is not a wall. A REFUTATION is `sat`, so its hint is the")
(println "  MODEL that breaks it (`oracle/witness`). A BLAME is a question whose")
(println "  expected answer is `unsat`, so its hint is the CORE that made it")
(println "  impossible (`oracle/explain`) — and the engine NAMES the parts, so the")
(println "  core is a diagnosis and not just a fact about z3.")

; ── what just happened (measured) ────────────────────────────────────────────
;   Overdraft is REPAIRED: the search finds `(<= amt balance)` and the round trip
;   through the forward checker accepts it (repair_test pins that).
;   Drain and blocked are UNREPAIRABLE, and the two blames differ:
;     drain    core [g_next g_inv2]      → :next-step-breaks-it
;     blocked  core [g_guard g_next g_inv2] → :guard-too-weak
;   The impossible machine is refused at ESTABLISHMENT and its blame is
;     core [g_inv2]                      → :invariant-impossible
;   — the invariant alone is unsatisfiable, so no step can ever be good.
;
;   Section 6 prices it on one held conversation, after a discarded warm-up
;   question. TWO runs on this machine put the plain question at 91 and 178 µs,
;   and the SAME question with the core read at 99 and 323 µs — so the core round
;   trip is cheap next to the question, and the blame lane's real added cost is
;   ONE more question per unrepairable transition. The two lines the program
;   prints for the run you are reading are the measurement; they move.
;   The per-machine ledger prices whole calls (one run):
;     overdraft (repaired, search) 27 decisions | 147867 µs
;     drain / blocked (search + blame) 11 decisions | ~30k µs each
;     impossible (establishment + blame) 3 decisions | 5266 µs
;   Those are one-shot `ask` questions — the repair/search path — plus, in the
;   blame lane, one held-session question (the core question itself, section 6).
;
; Honest limits:
;   * the blame lane needs a LIVE conversation: `blame-of` returns nil when the
;     oracle is HANDLED (`oracle/with-oracle` — a table or `deny`), because a
;     handler answers `ask`/`scoped` but has no core to give. A core invented
;     there would be a lie, so the engine omits `:blame` rather than guess.
;   * a transition that is unrepairable only because the GUARD VOCABULARY is too
;     small (a state it can reach safely, with no candidate expressing it) gets
;     no blame at all: the dual question is `sat` (`:no-core`), and the engine
;     does not invent one. The `:counterexample` still shows the break.
;   * the blame is a diagnosis of the LAST question asked; `oracle/explain` maps
;     the core by name, and an unrecognised name is reported as
;     `:unrecognised-core` rather than approximated into one of the three.
