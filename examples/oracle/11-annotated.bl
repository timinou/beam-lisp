; examples/oracle/11-annotated.bl — a sort the PROGRAMMER states, and the script z3 sees.
;
; ── what you need to know first ──────────────────────────────────────────────
; Every state field becomes an SMT constant of some SORT. `state-shape` reads
; that sort from the field's INIT LITERAL (`0.5 → Real`), which is a good default
; and a bad authority: a machine whose init is a PARAMETER
; (`(init [rate] (ok {:rate rate}))`) has no literal to read, so the field falls
; back to `Int` — and you are then checking a REAL-valued machine with an integer
; solver theory under the same invariant, the same transition and the same word
; "holds".
;
; The programmer already knows the answer, so the NAME metadata may state it:
;
;     (defserver ^{:invariant (>= rate 0.0) :sorts {:rate Real}} bank …)
;
; The declaration WINS over the literal rule and over the Int fallback. Two
; failure modes are LOUD rather than silent, because both would otherwise be a
; verdict about a theory the machine does not have: an unknown sort NAME throws
; (naming the sort and the field), and a declared sort that CONTRADICTS the init
; literal throws (the annotation and the code disagreeing about what the state
; IS, which a silent override would hide behind a green check).
;
; `{:emit true}` hands back the declarations and the invariant `define-fun` the
; verdict was decided OVER. A proof is only as meaningful as the sorts it was
; decided over, and this is how a reader sees them without asking z3.
;
; The BEAM part: metadata here is DATA, never a value. `Real` is not looked up,
; resolved or evaluated — the reader stores the annotation as a node in the
; name's position slot and `declared-sorts` reads a NAME out of it. That is why
; `^{:sorts {:rate Real}}` can say a sort at a point in the program where `Real`
; is not anything.
; ─────────────────────────────────────────────────────────────────────────────

(ns annotated
  (:require [system.core :as sys] [oracle] [smt :as smtlib] [z3]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- h [t] (println (str "\n── " t " ──")))

(z3/pool! 1)

(defn- verify
  ([src] (verify src {}))
  ([src opts] (sys/verify-process (z3/open) (read1 src) (merge {:emit true} opts))))

(defn- show [tag r]
  (println (str "  " tag))
  (println "    holds:" (:holds r) "| checked:" (:checked r)
           (if (:reason r) (str "| reason: " (:reason r)) ""))
  (println "    the declarations z3 was given:")
  (println (smtlib/script (get-in r [:emitted :decls])))
  (doseq [f (:failures r)]
    (println (str "      " (name (:label f)) " → " (:sentence (:counterexample f))))))

;; ── 1. an init that is a PARAMETER: the fallback is Int ─────────────────────
;; `rate` is the caller's opening state, so the literal rule reads nothing.
(def half
  "(defserver ^{:invariant (= (* rate 2) 1)} half
     (init [rate] (ok {:rate rate}))
     (handle-call [:scale] [_ {:keys [rate]}] (reply :ok {:rate (* rate 2)})))")

;; ── 2. the SAME machine, with the sort declared ─────────────────────────────
(def half-real
  "(defserver ^{:invariant (= (* rate 2) 1) :sorts {:rate Real}} half
     (init [rate] (ok {:rate rate}))
     (handle-call [:scale] [_ {:keys [rate]}] (reply :ok {:rate (* rate 2)})))")

(h "1. unannotated — `rate` falls back to Int, and the answer means nothing")
(show "half" (verify half))
(println "  This machine is BROKEN: `:scale` doubles the rate, so rate 0.5 becomes")
(println "  1.0 and 2·1.0 ≠ 1. It reads `holds: true` — and not because the invariant")
(println "  is preserved. Over Int, `2·rate = 1` has NO SOLUTION AT ALL, so the")
(println "  induction question `Inv(s) ∧ …` is unsatisfiable for the wrong reason.")
(println "  A refutation is what would have caught this; there was nothing to refute.")

(h "1b. the same question, asked of z3 directly, in both theories")
(println "  (declare-const rate Int)")
(println "  (assert (= (* rate 2) 1))   → "
         (:status (oracle/ask (oracle/obligation :int
                   ['(declare-const rate Int) '(assert (= (* rate 2) 1)) '(check-sat)]))))
(println "  (declare-const rate Real)")
(println "  (assert (= (* rate 2) 1))   → "
         (:status (oracle/ask (oracle/obligation :real
                   ['(declare-const rate Real) '(assert (= (* rate 2) 1)) '(check-sat)]))))
(println "  one word — the SORT — is the whole difference between \"no such state\"")
(println "  and \"here is the state\".")

(h "2. the same machine with :sorts {:rate Real}")
(show "half, declared Real" (verify half-real))
(println "  The declarations say `Real` instead of `Int`, and the same invariant is")
(println "  now refused WITH a counterexample: the state that survives `:scale` is")
(println "  rate = 0.5 → 1.0. The declaration did not make the checker kinder; it")
(println "  made the question mean what the machine means.")

;; ── 3. the invariant's OTHER half: a helper as a define-fun ────────────────
;; `(twice x)` is opaque — the translator has no body for a name it was not
;; handed a program for — so the machine is SKIPPED (`:checked false`). `:defs`
;; hands the helper over: it becomes a z3 `define-fun` in the prelude, and the
;; invariant becomes an APPLICATION of it.
(def half2
  "(defserver ^{:invariant (= (twice x) 1) :sorts {:twice Real}} half2
     (init [x] (ok 0.5))
     (handle-call [:noop] [_ x] (reply :ok x)))")

(def twice-src "(defn twice [v] (* v 2))")

(h "3a. a helper in the invariant, with nobody handing it over")
(show "half2, no :defs" (verify half2))

(h "3b. the same machine, with the helper declared")
(def r3 (verify half2 {:defs [twice-src]}))
(show "half2, :defs [(defn twice [v] (* v 2))]" r3)
(println "    the emitted prelude (Inv is a define-fun too — it always was):")
(println (smtlib/script (get-in r3 [:emitted :inv])))
(println "  The helper's RETURN SORT is declared, not inferred: `defn->define-fun`")
(println "  cannot read it, so it comes from the same `^{:sorts …}` map. That is why")
(println "  the annotation carries `:twice Real` as well as `:rate Real` — one map,")
(println "  one meaning: these names have these sorts.")

(h "the takeaway")
(println "  A sort is not a detail of the script; it is the QUESTION. `:sorts` states")
(println "  it where the init cannot, an unknown sort is refused by name rather than")
(println "  silently becoming Int, and `{:emit true}` shows the declarations the")
(println "  verdict was a statement about.")

; ── what just happened (measured) ────────────────────────────────────────────
;   1.  half            | holds: true  | (declare-const rate Int)   ← vacuous
;   1b. z3 direct       | (= (* rate 2) 1) over Int → unsat | over Real → sat
;   2.  half + :sorts   | holds: false | (declare-const rate Real)
;                       | scale → counterexample: rate = 0.5, rate2 = 1.0
;   3a. half2, no :defs | checked: false | reason: invariant not translatable
;   3b. half2 + :defs   | holds: true  | (define-fun twice ((v Real)) Real (* v 2))
;                       |           and (define-fun Inv ((x Real)) Bool (= (twice x) 1))
;
; The DIFFERENTIAL, for Change A + Change B together, over
; `examples/system examples/veritas priv/lib` (49 machines, `z3corpus/corpus`):
; the machine-by-machine outcome column is EMPTY — no machine moved. That is the
; expected result and it is the point: not one machine in the tree declares a
; sort or asks for `:k`, so the committed engine and this one answer identically
; on every machine that exists. A verdict only moves where an annotation says so.
;
; Honest limits — what is still NOT declarable:
;   * an INPUT's sort. `amt` is inferred BY FLOW (it inherits the sort of the
;     first scalar field its next-state mentions) and defaults to Int. An amount
;     that flowed into nothing, or into two fields of different sorts, has no
;     declaration lane at all.
;   * an ARRAY / sequence / collection field's ELEMENT sort. A collection is
;     abstracted to its LENGTH (`verify-capacity`), and length is Int; there is
;     nowhere to say "a list of Reals".
;   * a RECORD/ARRAY field inside a field. A field whose value is a map is
;     allocated one scalar tag by the functor, not a sort per component.
;   * the helper lane covers `:defs` for the INVARIANT only. A guard or a
;     next-state expression that calls a helper is still `:untranslatable`, and
;     the transition is then DROPPED (`:complete false`, `:unmodelled` names it).
;   * a declared sort is honoured for the fields `state-shape` names; a key for
;     something that is not a state field is not an error (it is how `:twice`
;     above carries the helper's sort). A typo in a FIELD name is therefore
;     silent — the shape, not the annotation, decides which variables exist.
;
; Where to look:
;   priv/lib/system/core.bl        declared-sorts / field-sort — the DECLARED
;                                  lane and the two loud failure modes;
;                                  state-shape — where a declared sort is applied,
;                                  once, for every init shape;
;                                  verify-process's `:emit` and `:defs`
;   priv/lib/system/smt.bl         of-node-funs — the translator's declared-
;                                  function lane (define-fun, not inline)
