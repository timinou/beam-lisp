; examples/oracle/08-k-induction.bl — when one step is not enough to prove a machine safe.
;
; ── what you need to know first ──────────────────────────────────────────────
; `verify-process` proves □Inv by INDUCTION: it asks z3 whether
;
;     Inv(s) ∧ guard ∧ s' = next(s)  ⟹  Inv(s')
;
; for every transition, and if all those are unsatisfiable the invariant holds in
; every reachable state. That is the k = 1 question, and it is the only one the
; engine used to ask.
;
; It is not always ENOUGH. An invariant is a SUPERSET of the reachable states,
; and it may contain an unreachable state that can step out of itself. The
; machine is safe; the one-step question is refuted; and neither the machine nor
; the answer is wrong. k-INDUCTION asks a stronger question: unroll k copies of
; the transition over the states s₀ … s₍ₖ₎, ASSUME the invariant at every earlier
; state, and check it at the end. The unreachable state is then excluded by the
; step that would have had to reach it.
;
; `:k` is an OPTION and 1 is the default, so nothing that passes today changes
; answer. `:k` comes back in the result, and a k > 1 refusal carries the same
; `:failures` shape as a k = 1 one — the counterexample, with the state of every
; copy it took to get there.
;
; The BEAM part: this is a pure computation over one form — no process, no
; concurrency. The work is a script built by SHAPE (declare k + 1 copies of the
; state, write the transition out k times, ask once) and a session held for the
; whole question, so the declarations are sent to z3 once instead of k times.
; ─────────────────────────────────────────────────────────────────────────────

(ns k-induction
  (:require [system.core :as sys] [oracle] [system.decide :as decide] [z3]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- h [t] (println (str "\n── " t " ──")))

;; ── the machine ─────────────────────────────────────────────────────────────
;; A counter that counts to 3, waits, and LEAPS off at 5. Every state it can
;; actually reach — 0, 1, 2, 3 — satisfies the invariant
;; `(or (<= x 3) (= x 5))`. But the invariant also admits x = 5, which it can
;; never reach, and `:leap` takes x = 5 to x = 6, which it does NOT satisfy.
;; So the machine is safe, and one step of induction cannot say so.
(def island
  "(defserver ^{:invariant (or (<= x 3) (= x 5))} island
     (init [x] (ok 0))
     (handle-call [:up] [_ x] :when (< x 3) (reply :ok (+ x 1)))
     (handle-call [:stay] [_ x] :when (and (>= x 3) (< x 5)) (reply :ok x))
     (handle-call [:leap] [_ x] :when (>= x 5) (reply :ok (+ x 1))))")

;; The negative control: unsafe on its FIRST step. Nothing about a deeper
;; question may rescue it — see section 3 for why that is a separate check.
(def jumper
  "(defserver ^{:invariant (or (<= x 3) (= x 5))} jumper
     (init [x] (ok 0))
     (handle-call [:jump] [_ x] (reply :ok 7)))")

(defn- report [tag r cost]
  (println (str "  " tag))
  (println "    holds:" (:holds r) "| checked:" (:checked r) "| complete:" (:complete r)
           "| undecided:" (:undecided r) "| k:" (:k r))
  (println "    failures:" (count (:failures r))
           "| solver questions:" (:count cost)
           "| ledger:" (:total_us cost) "µs total, worst" (:max_us cost) "µs")
  (doseq [f (:failures r)]
    (println (str "      " (name (:label f)) " → " (:sentence (:counterexample f))))))

(defn- run [src k]
  (oracle/memo-clear!)
  (decide/reset-ledger!)
  (let [r (sys/verify-process (z3/open) (read1 src) {:k k})]
    {:result r :cost (decide/cost)}))

(z3/pool! 1)

;; ── 0. warm the pool FIRST ───────────────────────────────────────────────────
;; The first question a fresh VM asks pays z3's own start-up; without this, lane 2
;; would look faster than lane 1 for a reason that has nothing to do with k.
(oracle/memo-clear!)
(decide/reset-ledger!)
(sys/verify-process (z3/open) (read1 jumper))
(println "0. warm-up (discarded):" (:count (decide/cost)) "questions,"
         (:total_us (decide/cost)) "µs")

;; ── 1. k = 1: the machine is refused, WITH a counterexample ─────────────────
(h "1. k = 1 — the one-step question, and the island it cannot exclude")
(def one (run island 1))
(report "island, :k 1" (:result one) (:cost one))
(println "  read it as: `:leap` may fire from x = 5 with x ≥ 5, and 5 is inside")
(println "  the invariant. The counterexample is a real state pair (5 → 6); the")
(println "  question the engine asked is just the wrong one.")

;; ── 2. k = 2: the same machine, PROVEN ──────────────────────────────────────
(h "2. k = 2 — Inv at s₀ AND s₁, so the island has no way in")
(def two (run island 2))
(report "island, :k 2" (:result two) (:cost two))
(println "  the counterexample is GONE, not hidden: at k = 2 the state x₁ = 5 would")
(println "  have to come from a state that also satisfies the invariant, and the only")
(println "  transitions into 5 are from x = 4, which does not. `:k 2` in the result")
(println "  is what says which question answered.")

(h "3. the BASE is a separate question, and it is not free")
(def j (run jumper 2))
(report "jumper (unsafe on step 0), :k 2" (:result j) (:cost j))
(println "  a k > 1 step only says \"if Inv held for the previous k states, it holds")
(println "  for the next one\". Something must say it holds for the FIRST k−1, and")
(println "  `:base` is that check. An engine with the step alone would be answering a")
(println "  question about a path that never has to reach an invariant state.")
(println "  Note WHICH question refused: only the base. The step is silent here because")
(println "  its own assumption — Inv at every earlier state — already rules out x₁ = 7,")
(println "  so it holds VACUOUSLY. That is the division of labour, not a gap: the step")
(println "  excludes bad successors of good states, the base excludes a bad first step.")

;; ── 4. a 1-inductive machine is unaffected ──────────────────────────────────
(h "4. a machine that was already provable does not change answer")
(def counter
  "(defserver ^{:invariant (>= n 0)} counter
     (init [n] (ok 0))
     (handle-call [:bump] [_ n] (reply :ok (+ n 1))))")
(doseq [k [1 2 3]]
  (let [r (run counter k)]
    (println "  counter, :k" k "→ holds:" (get-in r [:result :holds])
             "| questions:" (get-in r [:cost :count]))))

(h "the takeaway")
(println "  k-induction is a stronger QUESTION about the same script, not a second")
(println "  checker: k = 1 is bit-for-bit what the engine always did, and k > 1 adds")
(println "  the copies, the base, and nothing else. A machine that is safe but whose")
(println "  invariant admits an unreachable island is now decidable at 2.")

; ── what just happened (measured) ────────────────────────────────────────────
;   One run on this machine (the numbers print above; they MOVE run to run —
;   the ledger lines are the spread, not a constant):
;     1. island, :k 1 → holds: false | failures: 1 | leap → x = 5, x2 = 6
;                     | 5 questions | 7545 µs total, worst 6206 µs
;     2. island, :k 2 → holds: true  | failures: 0
;                     | 5 questions | 5193 µs total, worst 4148 µs
;     3. jumper, :k 2 → holds: false | failures: 1 | base → x = 0, x2 = 7
;                     | 4 questions | 4964 µs total, worst 4175 µs
;     4. counter      → holds at k = 1, 2 and 3 (2, 3, 3 questions)
;
;   What the numbers are NOT: a speed-up. Section 2 asks a strictly larger
;   question (k + 1 declared states instead of 2), so it costs MORE, and the two
;   lanes are printed so the reader can see the shape of the growth rather than a
;   ratio from another machine. The `:k 1` lane pays for its own counterexample —
;   a refutation is asked twice, once for the verdict and once with the model on.
;
; Honest limits — these are the ones that matter:
;   * k-INDUCTION FINDS PROOFS, NOT INVARIANTS. A `holds` at k = 2 is a proof; a
;     refusal at k = 3 (or any k) is NOT a disproof of the machine. The invariant
;     may simply be too weak to be k-inductive, and a stronger one — a different
;     annotation, or `discover-invariant` — might be 1-inductive. The verdict
;     stays three-valued for exactly this reason: `:k` tells you how strong the
;     question was, not how safe the machine is.
;   * the counterexample at k > 1 is a PATH of k + 1 states, not a reachable
;     state. `x = 5, x2 = 5, x3 = 6` is a real counterexample to the QUESTION and
;     need not be a state the machine can be in.
;   * `:k` is bounded by nothing here — k = 8 is eight copies of every transition
;     and z3 will answer `unknown` long before it answers wrongly. A ceiling is a
;     policy question, not a soundness one.
;   * this covers UNROLLING only. The base is checked at depth k − 1 with the
;     transition relation made TOTAL by stutter; the step is checked without
;     stutter (a bad `Inv` state that could also sit still would be its own
;     predecessor and no k would ever help). Both choices are argued in
;     core.bl's k-INDUCTION section.
;   * only a CONCRETE init can seed the base. A pure pass-through init is the
;     caller's contract, so the base starts from `Inv(s₀)` — which is what the
;     engine already trusts at k = 1, and which means a pass-through machine
;     cannot gain from a deeper k.
;
; Where to look:
;   priv/lib/system/core.bl   the k-INDUCTION section: step-relation (no stutter),
;                             base-relation (with it), k-induction-check (the
;                             questions), and verify-process's `:k` option
