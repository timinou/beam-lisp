; examples/oracle/12-stats.bl — the oracle's own dashboard, and the state behind it.
;
; ── what you need to know first ──────────────────────────────────────────────
; Three instruments already measure the z3 lane and none of them ADDS UP.
; `system.decide/cost` times ONE process's decisions. `BeamLisp.Z3.Ledger` keeps
; a `:counters` rollup of which tier answered. `z3corpus/corpus` verifies every
; `defserver` in a tree and reports four-way outcomes with a cost. `bl oracle stats`
; is the rollup: it walks the corpus once and prints the corpus and its coverage
; guard, the cost (with the worst machine NAMED), the tier and fragment
; histogram, every undecided machine with z3's own :why, and the failures.
;
; The BEAM angle — read the SAME state TWO ways. The ledger is an Erlang
; `:counters` array: lock-free, ownerless, created at module load, so it outlives
; the process that made it and ANY reader can read it. The memo above the oracle
; is an ETS table owned by the keeper process, found by NAME. So the CLI is not a
; second source of truth — it is a VIEW over VM state, and section 3 reads that
; state again, directly, and shows the numbers are the same ones the report
; printed: the shared counters (`BeamLisp.Z3.Ledger/histogram`), the per-process
; trail (`(decide/cost)`), and the keeper's ETS table (`ets/info`).
; ─────────────────────────────────────────────────────────────────────────────

(ns stats
  (:require [bl.oracle :as bo]
            [oracle]
            [system.decide :as decide]))

;; The pool arms z3's own ceiling at every lease. Clear any leftover a neighbour
;; set, so the walk below measures the pool's default and not an experiment.
(System/delete_env "BL_Z3_TIMEOUT")

(def dirs ["priv" "examples"])

;; ── 1. one walk, and the rollup as a value ──────────────────────────────────
;; `stats-report` is the data; `render` (below) is a printer of it. The CLI
;; routes this same value through `u/emit`, so `--json` changes the printer, not
;; the data a caller sees.
(def report (bo/stats-report {:dirs dirs :walk? true}))
(println "1. report" (:mode report)
         "| files:" (:files report)
         "| machines:" (:machines report)
         "| ok:" (:ok report))
(println "   outcomes:" (pr-str (:counts report)))
(println "   coverage:" (pr-str (:coverage report)))
;; ── 2. the text `bl oracle stats` prints ────────────────────────────────────────
(println "2. bl oracle stats prints:")

(println (bo/render report))

;; ── 3. the same state, read a second way ────────────────────────────────────
;; Section 3 of the report read `BeamLisp.Z3.Ledger/histogram`; call the counter
;; rollup again, then the per-process cost, then the keeper's ETS table by name.
(def hist (BeamLisp.Z3.Ledger/histogram))
(println "3. read again:" (pr-str hist))
(def cost (decide/cost))
(println "   this process's cost:" (pr-str cost))
(def memo (oracle/memo-stats))
(println "   memo (ETS, owned by the keeper):" (pr-str memo))
(println "   ETS :oracle-memo size directly:"
         (if (= :undefined (ets/info :oracle-memo)) 0 (ets/info :oracle-memo :size)))

;; ── 4. the undecided machines — each with z3's own :why ─────────────────────
;; Undecided is neither proved nor refuted: z3 hit the ceiling, or the theory is
;; incomplete. The corpus carries the reason its decisions recorded, so "none"
;; is always printed BESIDE the count of machines examined — a zero you can tell
;; apart from "we did not look".
(def undecided (:undecided report))
(println "4. undecided:" (count undecided) "of" (:examined report) "machines examined")
(vec (map (fn [m] (println "   " (:file m) "·" (:name m) "— why:" (pr-str (:why m))))
          undecided))

;; ── 5. failures, zero printed as an explicit count ──────────────────────────
(def unreadable (get-in report [:failures :unreadable]))
(def reread (get-in report [:failures :reread]))
(println "5. unreadable files:" (count unreadable)
         "| re-read failures:" (count reread))
(vec (map (fn [p] (println "   ✗ unreadable:" p)) unreadable))
(vec (map (fn [x] (println "   ✗ re-read:" (:file x) ":" (:error x))) reread))

;; ── 6. the coverage gate is a REAL assertion, not a printed line ────────────
;; A walk that cannot reach an independent, text-level count of "defserver" has
;; to FAIL the program. The instrument's whole point is that a cheerful zero can
;; never exit green: this is the assertion the count is measured against.
(when (not (:ok report))
  (throw (ex-info (str "z3 stats: coverage failed — " (pr-str (:coverage report))) {})))

; ── what just happened (measured, not estimated) ───────────────────────────
;   The numbers above are THIS run's, on this revision. They move when the tree
;   moves; the fixpoint is section 6: the walk's machine count reaches an
;   independent text-level grep bound, and a build that cannot reach it fails.
;
;   observed on this revision (2026-09-14): files 398 · machines 75 · coverage
;   bound 59 → PASS · outcomes proved 27 / refuted 15 / undecided 0 / declined 33 /
;   error 0 · decisions 88 (z3 77, memo 11) · total 122594 us · worst machine
;   examples/bundles/00-all-five.bl · worker (52070 us) · re-read failures 5.
;
;   Read it honestly:
;   * section 3 must AGREE with the report, and it is the point of the example:
;     the tier histogram and the cost the CLI printed are the same `:counters`
;     and the same process trail read a second time. If they ever disagree, the
;     CLI has grown a private copy of the truth — which is the bug this shape
;     prevents.
;   * "declined" is usually the LARGEST outcome bucket, and that is the engine
;     being truthful: most machines in this tree are live/reactive with no
;     `^{:invariant}`, so there is nothing to prove. A verifier that called those
;     "proven" would be the cheerful zero in a different costume.
;   * the walk is SERIAL on purpose. The ledger trail is the PROCESS's, so two
;     machines verified at once would attribute each other's decisions and make
;     every per-machine cost a lie. The pool is still armed; the walk leases one
;     solver at a time.
;   * the ledger is per-VM and starts EMPTY. A section-3 "total 0" means no
;     question was asked in this process, which is not the same claim as "we did
;     not check" — the report says which mode ran for exactly that reason.
;   * `:why` is z3's own word (`:timeout`, `:memout`, …) kept on the decision
;     beside its status; a machine with no recorded reason prints
;     "unknown (z3 gave no reason)" rather than an invented label.
;
; Where to look:
;   priv/std/bl/oracle.bl.md        stats-report (the value) · render · run
;   priv/lib/z3corpus.bl            corpus — the walk and the per-machine :why
;   lib/beam_lisp/z3_ledger.ex      the `:counters` rollup and the trail
;   priv/lib/system/decide.bl       cost/0 · histogram/0 — the language's view
;   priv/std/z3pool.bl              the solvers every decision leased
