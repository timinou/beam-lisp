; examples/oracle/13-faults.bl — a fault's predicate may arrive as TEXT; the reader
; sits at the port boundary.
;
; ── what you need to know first ──────────────────────────────────────────────
; `veritas.fault` asks z3 for a MUTANT of a contract: a value wrong for exactly
; one named law. Building it means asserting `(not law_i)` beside the other laws
; and handing the script to the oracle, which writes SMT-LIB down a pipe to a z3
; OS process. A contract's `:ensures` is normally lowered from quoted forms
; (`veritas.mock/contract-from` → `system.smt`), but the API still accepts each
; clause as a legacy SMT STRING too — so a fault has to reach z3 as TEXT.
;
; That is exactly where text is dangerous. The old code built the assertion by
; CONCATENATION — `(str "(assert " e ")")` — and concatenation cannot tell a TERM
; from a STRING LITERAL: an `e` that reached a quoted position became `"…"`, an
; inert VALUE that z3 answers `sat` to. So the reader lives at this ONE boundary:
; `smt/read-term` reads the TEXT once into the same form a form-shaped clause
; already is, and every path past it is form-only. Malformed text THROWS, naming
; it, instead of ever reaching z3 as a literal.
;
; The BEAM part: veritas's mock server and z3 are two separate OS processes, and
; the only thing that crosses between the language and z3 is BYTES down a port —
; a `defserver` in `z3pool` leases one z3 process per conversation. A fault must
; become text to make that trip (which is why the string shape ever existed), and
; the reader is the one place that conversion is safe.
; ─────────────────────────────────────────────────────────────────────────────

(ns z3-faults
  (:require [veritas.fault :as f]
            [veritas.mock :as m]
            [oracle]
            [smt :as smtlib]
            [z3]))

(z3/pool! 1)
(def port (z3/open))

;; ── 1. one law, two authoring shapes ────────────────────────────────────────
;; The normal surface is `contract-from` (quoted forms). The legacy surface is a
;; hand-built contract whose `:ensures` are SMT TEXT. They describe the same law.
(def legacy {:fields [["v" "Int"]] :ensures ["(>= v -40)" "(<= v 60)"]})
(def normal (m/contract-from [["v" "Int"]] ['(>= v -40) '(<= v 60)]))

(println "1. the same two clauses, as DATA")
(println "   legacy :ensures:" (pr-str (:ensures legacy)))
(println "   normal :ensures:" (pr-str (:ensures normal)))
;; A bare string is NOT a term: the printer quotes it, so it is a value, not a
;; constraint. This is the shape that used to reach z3 whenever it landed in a
;; quoted position.
(println "   emit of raw TEXT (a literal, not a term):" (pr-str (smtlib/emit "(>= v -40)")))
(println "   emit of it READ once:                    " (pr-str (smtlib/emit (smtlib/read-term "(>= v -40)"))))

;; ── 2. what veritas.fault actually hands the oracle ─────────────────────────
;; Capture the script at the ORACLE boundary (L6: `with-oracle` handles `ask`),
;; so this is the module's real output, not a re-derivation of it.
(defn- emitted [thunk]
  (let [seen (atom nil)]
    (do
      (oracle/with-oracle
        (fn [text _model?] (reset! seen text) {:status "sat" :model nil :core nil :why nil})
        thunk)
      @seen)))

(def script-legacy (emitted (fn [] (f/isolate port legacy 0))))
(def script-normal (emitted (fn [] (f/isolate port normal 0))))

(println "\n2. the script veritas.fault emits to break law 0 (captured at the port)")
(println "   from the STRING clauses:")
(println script-legacy)
(println "   from the FORM clauses:")
(println script-normal)
(println "   byte-identical:" (= script-legacy script-normal))

;; ── 3. ... and the verdict is the same ──────────────────────────────────────
;; The equality is the point: the reader erases the shape, so the question z3 is
;; asked — and the answer it gives — cannot depend on how the clause was typed.
(def v-legacy (f/isolate port legacy 0))
(def v-normal (f/isolate port normal 0))

(println "3. the verdict does not depend on the shape")
(println "   string:" (pr-str v-legacy))
(println "   form  :" (pr-str v-normal))
(println "   identical:" (= v-legacy v-normal))

;; ── 4. malformed text is refused, naming itself ─────────────────────────────
;; A concatenation would have pasted the broken text into a script; the reader
;; throws with the offending text instead, so it can never become a literal.
(defn- refusal [thunk] (try (thunk) "NO ERROR — accepted as a value" (catch e (:message e))))

(println "\n4. a malformed clause never reaches z3")
(println "   \"(>= v\" →" (refusal (fn [] (f/isolate port {:fields [["v" "Int"]] :ensures ["(>= v"]} 0))))
(println "   \"z w\"    →" (refusal (fn [] (f/isolate port {:fields [["v" "Int"]] :ensures ["z w"]} 0))))

(println "\n── the point ──")
(println "  A fault crosses a process boundary as TEXT, so a predicate may arrive")
(println "  as a string. Reading it ONCE at that boundary makes both shapes the same")
(println "  form before z3 is ever asked — and turns malformed text into a throw that")
(println "  names itself, instead of an inert literal z3 would answer `sat` to.")

; ── what just happened (MEASURED on this revision, not estimated) ─────────────
;   §2 the two shapes emit the IDENTICAL script:
;        (set-option :timeout 3000)
;        (declare-const v Int)
;        (assert (not (>= v (- 40))))
;        (assert (<= v 60))
;      — one negated clause (the break) and one kept clause (the rest of the law).
;   §3 the verdicts are equal to each other AND to the form lane:
;        {:clause 0 :status :sat :modality :proven :implied false :value {:v -41}}
;   §4 refusals name their text:
;        smt/read-terms: not SMT-LIB: (>= v   and   smt/read-term: expected ONE term, got 2: z w
;
; Honest limit: read-term is the language's READER with a normalisation pass, not
; a full SMT-LIB parser (see examples/oracle/06-no-strings.bl, which measures exactly
; what it will not take: a doubled-quote string literal reads as two strings).
; The `:ensures`-as-string shape is the API's legacy lane; nothing in this tree
; still AUTHORS a contract that way — `contract-from` lowers quoted forms through
; system.smt — so §1/§3 exercise the lane deliberately rather than as a live
; caller. And §2 captures the oracle boundary with a stub handler, so the script
; shown is what the module EMITS, not what re-arrives from z3.
;
; Where to look:
;   priv/lib/veritas.bl        as-term — the one read-once boundary (beside
;                              pred-form, which guards the authoring surface)
;   priv/lib/veritas/fault.bl  assert-except — a clause's break/keep assertions
;   priv/lib/veritas/mock.bl   assert-all — the same boundary for synthesis
;   priv/lib/smt.bl            read-term / read-terms — the reader itself

:ok
