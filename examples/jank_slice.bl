; jank's stdlib, unmodified, running on the BEAM.
;
; This loads verbatim slices of jank's core.jank (see docs/jank-compat.md)
; and uses them. Every definition here is byte-for-byte upstream source —
; beam-lisp reads it, compiles it, and calls it like native code. The
; slice text is never rewritten; only the "load the file" glue below is
; ours. Slices that need a change are FAILs, recorded, not edited.

(ns jank.slicedemo)

; --- load the accepted slices verbatim (each is one `defn`/`defmacro`) ---
; `while` — a macro that loops while a test holds.
(BeamLisp.Compiler/eval_string
  (File/read! "test/fixtures/jank/slice_20_while.bl")
  (BeamLisp.Compiler/new_env "jank.slicedemo"))
; `constantly` — a fn ignoring its args.
(BeamLisp.Compiler/eval_string
  (File/read! "test/fixtures/jank/slice_01_constantly.bl")
  (BeamLisp.Compiler/new_env "jank.slicedemo"))
; `complement` — a fn flipping a predicate.
(BeamLisp.Compiler/eval_string
  (File/read! "test/fixtures/jank/slice_03_complement.bl")
  (BeamLisp.Compiler/new_env "jank.slicedemo"))
; `fnil` — a fn patching nil args.
(BeamLisp.Compiler/eval_string
  (File/read! "test/fixtures/jank/slice_07_fnil.bl")
  (BeamLisp.Compiler/new_env "jank.slicedemo"))
; `key` and `val` — map-entry accessors.
(BeamLisp.Compiler/eval_string
  (File/read! "test/fixtures/jank/slice_12_map_entries.bl")
  (BeamLisp.Compiler/new_env "jank.slicedemo"))
; `reverse` — reduce conj onto the empty list.
(BeamLisp.Compiler/eval_string
  (File/read! "test/fixtures/jank/slice_22_reverse.bl")
  (BeamLisp.Compiler/new_env "jank.slicedemo"))
; `run!` — reduce for side effects, returns nil.
(BeamLisp.Compiler/eval_string
  (File/read! "test/fixtures/jank/slice_23_run.bl")
  (BeamLisp.Compiler/new_env "jank.slicedemo"))
; `every-pred` — a predicate combinator (boolean + every? + list*).
(BeamLisp.Compiler/eval_string
  (File/read! "test/fixtures/jank/slice_24_every_pred.bl")
  (BeamLisp.Compiler/new_env "jank.slicedemo"))
; `if-some` — a nil-aware binding macro (assert-macro-args + temp#).
(BeamLisp.Compiler/eval_string
  (File/read! "test/fixtures/jank/slice_34_if_some.bl")
  (BeamLisp.Compiler/new_env "jank.slicedemo"))
; `update` — apply a fn to one key's value.
(BeamLisp.Compiler/eval_string
  (File/read! "test/fixtures/jank/slice_47_update.bl")
  (BeamLisp.Compiler/new_env "jank.slicedemo"))
; `max-key` — the x with the greatest (k x).
(BeamLisp.Compiler/eval_string
  (File/read! "test/fixtures/jank/slice_62_max_key.bl")
  (BeamLisp.Compiler/new_env "jank.slicedemo"))

; --- use them, jank code against BEAM data ---
(defn fib [n]
  (loop [a 0 b 1 i n]
    (if (zero? i) a (recur b (+ a b) (dec i)))))

; `while` loops against an atom, exactly as Clojure would.
(def counter (atom 0))
(while (< @counter 3) (swap! counter inc))
(println (str "while counter: " @counter))

; `constantly` through map.
(println (str "constantly: " (pr-str (map (constantly :x) [1 2 3]))))

; `complement` flips a predicate for filter.
(println (str "complement: " (pr-str (filter (complement even?) [1 2 3 4 5 6]))))

; `fnil` patches nil where a default belongs.
(println (str "fnil: " ((fnil + 0) nil 5) " " ((fnil + 0 10) 5 nil)))

; `key`/`val` pick apart a map entry (a 2-vector).
(println (str "key/val: " (key [:alice 3]) " -> " (val [:alice 3])))
(println (str "key/val on seq: " (pr-str (map key [[:a 1] [:b 2]]))))

(println (str "fib 10: " (fib 10)))

; wave-16 newcomers: combinators, map surgery, and reverse.
; `reverse` folds conj onto '() — a native list again.
(println (str "reverse: " (pr-str (reverse [1 2 3 4]))))
; `run!` reduces a proc for side effects; its value is nil.
(def acc (atom 0))
(run! (fn [x] (swap! acc + x)) [1 2 3 4])
(println (str "run!: side effects accumulated " @acc ", value nil"))
; `every-pred` composes predicates with and, short-circuiting.
(println (str "every-pred: " (pr-str (filter (every-pred even? pos?) [1 2 -4 4 6]))))
; `if-some` binds only when the test is not nil (false binds).
(println (str "if-some: " (if-some [x 5] (* x 10) :none) " / " (if-some [x nil] 1 :none)))
; `update` applies a fn to one key's value, returning a new map.
(println (str "update: " (pr-str (update {:a 1 :b 2} :a inc))))
; `max-key` returns the x with the greatest (k x).
(println (str "max-key: " (pr-str (max-key count [1 2 3] [4] [5 6]))))
; wave-24 newcomers: the pure reduce/seq layer that needs no new prims.
; `completing` adds the arity-1/arity-0 signatures to a reducing fn.
(BeamLisp.Compiler/eval_string
  (File/read! "test/fixtures/jank/slice_71_completing.bl")
  (BeamLisp.Compiler/new_env "jank.slicedemo"))
; `take-nth` keeps every nth item (collection arity).
(BeamLisp.Compiler/eval_string
  (File/read! "test/fixtures/jank/slice_88_take_nth.bl")
  (BeamLisp.Compiler/new_env "jank.slicedemo"))
; `filterv` returns a vector of the kept items, via transients.
(BeamLisp.Compiler/eval_string
  (File/read! "test/fixtures/jank/slice_102_filterv.bl")
  (BeamLisp.Compiler/new_env "jank.slicedemo"))
; `nthnext` — the nth seq, or nil when exhausted.
(BeamLisp.Compiler/eval_string
  (File/read! "test/fixtures/jank/slice_86_nthnext.bl")
  (BeamLisp.Compiler/new_env "jank.slicedemo"))
; `distinct?` — true when no two args are equal.
(BeamLisp.Compiler/eval_string
  (File/read! "test/fixtures/jank/slice_103_distinct_q.bl")
  (BeamLisp.Compiler/new_env "jank.slicedemo"))

; `completing` turns a 2-arity + into a full reducing fn.
(println (str "completing: " ((completing +) 1 2) " / " ((completing +) 7)))
; `take-nth` walks lazily.
(println (str "take-nth: " (pr-str (doall (take-nth 2 [1 2 3 4 5])))))
; `filterv` gives a vector, not a lazy seq.
(println (str "filterv: " (pr-str (filterv even? [1 2 3 4 5]))))
; `nthnext` stops at nil, as a walk should.
(println (str "nthnext: " (pr-str (nthnext [1 2 3 4 5] 3))))
; `distinct?` reads set membership from a literal.
(println (str "distinct?: " (distinct? 1 2 3) " / " (distinct? 1 2 1)))

(println "jank stdlib slices: OK")
