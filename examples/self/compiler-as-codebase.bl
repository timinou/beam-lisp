; compiler-as-codebase.bl — the loop closes.
;
; The beam-lisp compiler is now written in beam-lisp (priv/compiler.bl). That
; means it is just another beam-lisp program — and the language's own source
; analysis tool (codebase, backed by the datom database) can ingest it and
; answer questions about it. The compiler becomes a database of facts about
; itself.
;
; Run: mix beam_lisp.run examples/self/compiler-as-codebase.bl

(ns self.compiler-as-codebase
  (:require [codebase :as cb] [typed :as t] [datom :as d]))

;; Index the self-hosted compiler as a set of datom facts: one fact per
;; function definition, one per call site.
(def sigs (merge t/core-sigs t/core-seeds-v2 t/host-seeds))
(def conn (cb/connect-codebase))
(cb/transact-source! conn sigs "compiler" (File/read! "priv/compiler.bl"))
(def db (d/db conn))

(defn callers-of
  "Every function that calls `callee` directly — the answer to
   \u2018what breaks if I change this?\u2019, as a datalog query over the compiler."
  [callee]
  (sort (into [] (map first
    (d/q '[:find ?caller :in $ ?callee :where
           [?c :call/caller ?caller] [?c :call/callee ?callee]] db callee)))))

(def fn-count
  (count (d/q '[:find ?n :where [?d :fn/name ?n]] db)))

(println "The self-hosted compiler, analyzed by the language it implements:")
(println "  functions captured:" fn-count)
(println)

(println "  arity mismatches in the compiler (empty = all calls well-formed):")
(doseq [m (take 5 (cb/arity-mismatches db))] (println "    " m))
(println)

(println "  what breaks if I change compile-body?")
(doseq [c (callers-of "compile-body")] (println "     <-" c))
(println)

(println "  how many functions depend on ast-node?" (count (callers-of "ast-node")))
(println)
(println "  The compiler is a program the language can reason about — the same")
(println "  datom queries that analyze any beam-lisp code analyze the compiler.")
