; server.bl — a real OTP GenServer, written in beam-lisp.
; Run: mix beam_lisp.run examples/server.bl
;
; `defserver` does not imitate a GenServer; it compiles to one. The
; module it produces declares @behaviour :gen_server, so :observer,
; :sys and Supervisor all recognise it — which is the whole point of
; putting a Lisp on this VM rather than on another one.

(ns server.demo)

(defserver counter
  ; init returns an OTP init tuple: (ok state) or (stop reason).
  (init [start] (ok start))

  ; Each handle-call clause dispatches on the message, and compiles to
  ; a handle_call/3 function clause. `(reply v state)` is {:reply, v, s}.
  (handle-call :inc [_from state] (reply (inc state) (inc state)))
  (handle-call :get [_from state] (reply state state))

  ; A cast has no reply — only a new state.
  (handle-cast :reset [_state] (noreply 0))

  ; Anything else that lands in the mailbox.
  (handle-info _msg [state] (noreply state)))

(println "== a counter as a supervised OTP process ==")

(def c (server-start-link counter 10))
(println (str "start:    " (server-call c :get)))
(println (str "inc:      " (server-call c :inc)))
(println (str "inc:      " (server-call c :inc)))

(server-cast c :reset)
(println (str "reset:    " (server-call c :get)))

(println "")
(println "== it is a genuine gen_server, not a lookalike ==")

; :sys is OTP's debugging interface. It works only on a process that
; really implements the behaviour, so this is the proof.
(println (str "sys/get_state:   " (pr-str (sys/get_state c))))
; `counter` is bound to the generated module name, so it can be asked
; directly what behaviours it declares.
(println (str "generated module:   " (pr-str counter)))
; erlang/apply wants a real Erlang list, and a beam-lisp vector is a
; struct — `list` builds the shape the BIF expects.
(println (str "declared behaviour: " (pr-str (Keyword/get (erlang/apply counter :module_info (list :attributes)) :behaviour))))

(server-stop c)
(println "")
(println "stopped cleanly.")
