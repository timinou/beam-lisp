; hello-app.bl — a native desktop app that is a loom view over live state.
;
; Run:  mix beam_lisp.run --path priv examples/desktop/hello-app.bl
;
; ── What it shows ─────────────────────────────────────────────────────
;
; The whole desktop grammar in one screen:
;   • state           — a map {:count :name}
;   • view            — a PURE function state → loom hiccup (real components:
;                       card, heading, buttons, a field, a badge)
;   • on-event        — a PURE reducer (state, event) → state
;   • live re-render  — every click/keystroke folds an event and the native
;                       window converges, over the wry `eval` channel
;
; The buttons carry loom's ordinary `:on-click [:term …]` — the SAME event
; vocabulary a live web page uses. The desktop client hook binds those markers
; to the app with zero extra wiring: you write the view, you get the events.

(ns example.desktop.hello-app
  (:require [loom.desktop :as d]
            [loom.ui :as ui]
            [loom.box :as b]
            [loom.token :as t]))

;; ── the view: state → loom hiccup ────────────────────────────────────

(defn view [state]
  (let [n (get state :count 0)
        who (get state :name "world")]
    (b/col {:gap :5 :pad :6 :h :screen :justify :center
            :style {:background (t/color :bg)}}
      (ui/card {:style {:max-width "460px" :margin "0 auto" :width "100%"}}
        (b/row {:justify :between :align :center}
          (ui/heading 2 (str "Hello, " who))
          (ui/badge {:tone (if (> n 0) :success :default)}
            (str n " click" (if (= n 1) "" "s"))))

        (ui/divider)

        (ui/prose {:tone :muted}
          "A native window whose page is a pure projection of state. "
          "Click a button or type your name — the reducer runs and the "
          "window re-renders.")

        (ui/field {:name :name :label "Your name" :value who
                   ;; :on-input carries the field's value back with the term
                   :on-input [:set-name]})

        (b/row {:gap :2 :wrap true}
          (ui/button {:variant :primary :on-click [:inc]} "+1")
          (ui/button {:variant :subtle  :on-click [:dec]} "−1")
          (ui/button {:variant :ghost   :on-click [:reset]} "reset")
          (ui/button {:variant :danger  :on-click [:quit]} "quit"))))))

;; ── the reducer: (state, event) → state ──────────────────────────────
;;
;; Each event is the term written in the view, parsed back to beam-lisp data.
;; :set-name arrives as [[:set-name] "typed value"] because the input hook
;; wraps the term with the field value — we destructure that shape.

(defn on-event [state ev]
  (let [head (if (or (list? ev) (vector? ev)) (first ev) ev)]
    (cond
      (= head :inc)   (update state :count (fn [n] (+ (or n 0) 1)))
      (= head :dec)   (update state :count (fn [n] (- (or n 0) 1)))
      (= head :reset) (assoc state :count 0)
      (= head :quit)  (do (System/halt 0) state)
      ;; [[:set-name] value] — the input wrapper shape
      (and (or (list? head) (vector? head)) (= (first head) :set-name))
        (assoc state :name (let [v (second ev)] (if (or (nil? v) (= v "")) "world" v)))
      :else state)))

;; ── mount ─────────────────────────────────────────────────────────────

(when (not (d/available?))
  (println "wry backend not available (no WebKitGTK / no display?) — exiting")
  (System/halt 0))

(def app
  (d/app {:title "loom · hello"
          :width 520 :height 460
          :state {:count 0 :name "world"}
          :view view
          :on-event on-event}))

(println "hello-app running. close the window (or click quit) to exit.")
;; keep the node alive while the window is open
(Process/sleep 86400000)
