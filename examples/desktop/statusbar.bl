; statusbar.bl — a top-bar statusbar: the BEAM's vital signs, always on top.
;
; Run:  mix beam_lisp.run --path priv examples/desktop/statusbar.bl
;
; ── What it shows ─────────────────────────────────────────────────────
;
; `desktop/bar` — a frameless, always-on-top strip docked to the top of the
; screen — driven by the SAME loom view-over-state loop as a normal app. The
; only difference from `hello-app` is a point in the window-option space
; (no chrome, above everything, pinned to y=0, full width).
;
; The bar reads the live VM every second (`:tick`) and re-renders: a clock, the
; BEAM process count, total memory, run-queue depth, and a heartbeat dot that
; pulses each frame. It observes the runtime it runs in — the vitals are read
; as DATA (erlang/memory, erlang/system_info) and painted by loom. Clicking the
; heartbeat toggles a compact/expanded layout, proving events work from a bar
; exactly as from a window.

(ns example.desktop.statusbar
  (:require [loom.desktop :as d]
            [loom.box :as b]
            [loom.token :as t]))

;; ── the read-model: the VM's vital signs, as a plain map ──────────────
;;
;; A passive read of the runtime — nothing is disturbed. `erlang/memory` and
;; `erlang/system_info` are the BEAM describing itself.

(defn- mb [bytes] (/ (erlang/round (/ bytes 104857.6)) 10.0)) ; bytes → MB, 1dp

(defn- vitals []
  (let [hms (parse-now)
        h (get hms :hour) m (get hms :minute) s (get hms :second)
        mem (erlang/memory)]
    {:clock (str (pad2 h) ":" (pad2 m) ":" (pad2 s))
     :procs (erlang/system_info :process_count)
     :mem-total (mb (get-mem mem :total))
     :mem-proc  (mb (get-mem mem :processes))
     :run-queue (erlang/statistics :run_queue)
     :schedulers (erlang/system_info :schedulers)}))

;; small helpers kept local so the example is self-contained
(defn- pad2 [n] (let [s (str n)] (if (= (count s) 1) (str "0" s) s)))
(defn- get-mem [mem k]
  ;; erlang/memory returns a proplist (list of {k,v} tuples)
  (let [pair (first (filter (fn [t] (= (erlang/element 1 t) k)) mem))]
    (if pair (erlang/element 2 pair) 0)))
(defn- parse-now []
  (let [t (erlang/localtime)               ; {{Y Mo D} {H Mi S}}
        hms (erlang/element 2 t)]
    {:hour (erlang/element 1 hms)
     :minute (erlang/element 2 hms)
     :second (erlang/element 3 hms)}))

;; ── the view: vitals → a loom row of GLASS blocks ─────────────────────
;;
;; The bar window itself is transparent (see the mount), so the compositor
;; shows through everywhere the CSS is translucent. The design leans into that:
;; the stats live inside `glass` pills — a semi-opaque surface with a
;; `backdrop-filter: blur`, a hairline highlight border, and a soft shadow, the
;; standard glassmorphism recipe. Nothing here is a token ceiling; the blur and
;; the rgba() are raw CSS through loom's `:style` escape hatch.

(defn- glass
  "A translucent, blurred block — the glassmorphic surface. `& body` are its
   children; `opts` may pass extra style."
  [opts & body]
  (apply b/row
    (merge {:gap :2 :align :center :pad [:1 :3]
            :style (merge
                     {:background "rgba(30, 33, 36, 0.45)"
                      :backdrop-filter "blur(14px) saturate(1.4)"
                      :-webkit-backdrop-filter "blur(14px) saturate(1.4)"
                      :border "1px solid rgba(255,255,255,0.10)"
                      :border-radius (t/radius :full)
                      :box-shadow "0 2px 12px rgba(0,0,0,0.28)"}
                     (get opts :style {}))}
           (dissoc opts :style))
    body))

(defn- stat [label value tone]
  (b/row {:gap :1 :align :baseline}
    [:span {:class (t/sx {:font-size (t/text :xs) :color (t/color :faint)
                          :text-transform "uppercase" :letter-spacing "0.05em"})}
     label]
    [:span {:class (t/sx {:font-size (t/text :sm) :font-weight (t/weight :semibold)
                          :color (t/color tone) :font-variant-numeric "tabular-nums"})}
     value]))

(defn- sep []
  [:span {:class (t/sx {:color "rgba(255,255,255,0.14)"})} "│"])

;; one detailed stat row for inside the dropdown panel
(defn- stat-row [label value tone]
  (b/row {:justify :between :align :center
          :style {:padding "5px 8px" :min-width "180px"}}
    [:span {:class (t/sx {:font-size (t/text :xs) :color (t/color :muted)
                          :text-transform "uppercase" :letter-spacing "0.05em"})}
     label]
    [:span {:class (t/sx {:font-size (t/text :sm) :font-weight (t/weight :semibold)
                          :color (t/color tone) :font-variant-numeric "tabular-nums"})}
     value]))

(defn view [state]
  (let [v (:vitals state)
        beat (:beat state)
        open (:menu-open state)]
    ;; the OUTER bar is fully transparent — no background, just padding — so
    ;; the compositor shows through and only the glass pills read as solid.
    ;; Tighter than before: gap :2, less padding — the bar earns its footprint.
    (b/row {:align :center :gap :2 :h :full
            :pad [:0 :2]
            :style {:background "transparent"
                    :height "100%" :width "100%"
                    :font-family (t/tok :font :sans)
                    :-webkit-user-select "none" :user-select "none"}}
      ;; brand + heartbeat, in their own glass pill
      (glass {}
        [:span {:class (t/sx {:width "8px" :height "8px" :border-radius "50%"
                              :background (if beat (t/color :success) "rgba(255,255,255,0.25)")
                              :box-shadow (if beat (str "0 0 8px " (t/color :success)) "none")
                              :transition "background 200ms, box-shadow 200ms"
                              :flex-shrink "0"})}]
        [:span {:class (t/sx {:font-weight (t/weight :bold) :color (t/color :text)
                              :font-size (t/text :sm)})}
         "beam-lisp"])

      ;; the always-on stats: time + process count
      (glass {}
        (stat "time" (:clock v) :text)
        (sep)
        (stat "procs" (str (:procs v)) :accent))

      ;; push the menu to the right edge
      [:div {:class (t/sx {:flex-grow "1"})}]

      ;; a real DROPDOWN: the extra vitals live in a panel that OVERLAYS the
      ;; windows below — it does not widen the bar (spacing preserved) and does
      ;; not push tiled windows down (the reserved zone stays the bar height).
      ;; The surface auto-grows to show it and shrinks back on close.
      (glass {:style {:padding "3px 6px"}}
        (d/dropdown
          {:open? open :on-click [:menu] :align :right :width 240
           :trigger (b/row {:gap :1 :align :center
                            :style {:cursor "pointer"}}
                      [:span {:class (t/sx {:font-size (t/text :sm)
                                            :color (t/color :text)})} "vitals"]
                      [:span {:class (t/sx {:font-size (t/text :xs)
                                            :color (t/color :muted)
                                            :transition "transform 160ms"
                                            :transform (if open "rotate(180deg)" "none")})}
                       "▾"])}
          (stat-row "memory" (str (:mem-total v) " MB") :accent-2)
          (stat-row "heap" (str (:mem-proc v) " MB") :muted)
          (stat-row "run queue" (str (:run-queue v)) (if (> (:run-queue v) 0) :warning :muted))
          (stat-row "schedulers" (str (:schedulers v)) :muted))))))

;; ── the reducer ───────────────────────────────────────────────────────

(defn on-event [state ev]
  (let [head (if (or (list? ev) (vector? ev)) (first ev) ev)]
    (cond
      ;; a tick: refresh vitals and flip the heartbeat so the dot pulses
      (= head :frame)
        (-> state (assoc :vitals (vitals)) (update :beat not))
      ;; the vitals menu trigger was clicked: toggle the dropdown
      (= head :menu)
        (update state :menu-open not)
      :else state)))

;; ── mount ─────────────────────────────────────────────────────────────

(when (not (d/available?))
  (println "wry backend not available (no WebKitGTK / no display?) — exiting")
  (System/halt 0))

(def app
  ;; d/bar docks via wlr-layer-shell: anchored top+left+right, so it spans the
  ;; full screen width with no pixel size to guess, sits above tiled windows,
  ;; and reserves its strip (windows tile below it). :transparent is on by
  ;; default for the glass look.
  (d/bar {:title "beam-lisp statusbar"
          :edge :top
          :height 40
          :state {:vitals (vitals) :beat true :menu-open false}
          :view view
          :on-event on-event
          ;; re-read the VM once a second and re-render
          :tick {:every-ms 1000 :event [:frame]}}))

(println "statusbar running: docked to the top via wlr-layer-shell,")
(println "above tiled windows, glassmorphic (transparent + blur).")
(println "click 'vitals ▾' for the dropdown — it overlays, the bar keeps its size.")
(println "Ctrl-C to exit.")
(Process/sleep 86400000)
