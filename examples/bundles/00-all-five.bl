; 00-all-five.bl — the five bundles in one program.
; Run: mix beam_lisp.run --path priv examples/bundles/00-all-five.bl
;
; A tiny job shop:
;   - a POOL of workers under a SUPERVISOR (bundle 5)
;   - each job runs behind a FENCE (bundle 3): ok | crash | timeout
;   - outcomes are published to BUSES (bundle 6): results and errors
;   - workers self-register in a REGISTRY (bundle 5→2 pattern): name as value
;   - the worker carries an INVARIANT, proven from source (bundle 4)
;
; The crash and the hang are deliberate: job 13 always crashes, job 7 always
; hangs past the fence. Watch the bundles absorb both without a single
; defensive paren.

(ns examples.bundles.00-all-five
  (:require [fence :refer :all]
            [reg :as reg]
            [bus :as bus]
            [flow :as flow]
            [super :as super]
            [system.core :as sys]))

(defn check! [truth message data]
  (when-not truth
    (throw (ex-info message data))))

;; ── the work ───────────────────────────────────────────────────────────
;; Job 13 crashes, job 7 hangs, everything else computes.

(defn process [j]
  (cond
    (= j 13) (throw (ex-info "job 13 always crashes" {:job j}))
    (= j 7)  (do (Process/sleep 500) j)
    :else    (* j j)))

;; ── the worker: fence + buses + registry + invariant ───────────────────
;; The invariant's spelling is the one the prover reads: the state IS the
;; counter, named the same in the meta and in every handler. done ≥ 0 — a
;; crash mid-job must not un-count completed work.

(defserver ^{:invariant (>= done 0)} worker
  (init [i]
    (do (reg/register :workers (erlang/self) {:id i})
        (ok 0)))
  (handle-cast [:job j] [done]
    (let [outcome (fence 50 (process j))]
      (cond
        (contains? outcome :ok)
        (do (bus/publish :results-bus (:ok outcome))
            (noreply (inc done)))
        (contains? outcome :crash)
        (do (bus/publish :errors-bus {:job j :why :crashed})
            (noreply done))
        :else
        (do (bus/publish :errors-bus {:job j :why :hung})
            (noreply done)))))
  (handle-call :stats [_from done] (reply done done)))

;; ── the buses and the registry ─────────────────────────────────────────

(bus/defbus results-bus (demand 32))
(bus/defbus errors-bus  (demand 8))
(reg/defregistry workers (keys :id))

;; ── the tree ───────────────────────────────────────────────────────────

(super/defsupervisor app
  (strategy :one-for-one)
  (intensity 5 10000)
  (child :workers-reg workers    nil {:name :workers})
  (child :results     results-bus nil {:name :results-bus})
  (child :errors      errors-bus  nil {:name :errors-bus})
  (child :pool        (pool worker 3)))

;; ── prove before boot ──────────────────────────────────────────────────

(println "== the gate ==")
(def verdict (sys/verify 'examples.bundles.00-all-five/app))
(println (str "  (sys/verify 'examples.bundles.00-all-five/app) → " (pr-str verdict)))
(check! (= :ok verdict) "the tree's invariants hold" {:verdict verdict})

;; ── boot ───────────────────────────────────────────────────────────────

(def s (start-link app))
(Process/sleep 50)   ; workers self-register in init

(println "== the tree ==")
(println (str "  children: "
              (pr-str (vec (map (fn [c] (:id c)) (super/children s))))))
(check! (= 3 (count (reg/where :workers {}))) "three workers registered" {})

;; ── listen to the error bus ────────────────────────────────────────────

(def parent (erlang/self))
(flow/subscribe (super/child-of s :errors) :log
                (fn [ev] (erlang/send parent [:err ev]))
                {:demand 1})

;; ── work ───────────────────────────────────────────────────────────────

(println "== work: 16 jobs, one hangs, one crashes ==")
(def hands (super/child-of s :pool))
(doseq [j (range 16)]
  (cast hands [:job j]))

;; collect the two expected error events
(def errs [(receive [:err ev] ev (after 2000 :missed))
           (receive [:err ev] ev (after 2000 :missed))])
(println (str "  errors bus saw: " (pr-str errs)))
(check! (some (fn [e] (= :hung (:why e))) errs) "job 7 hung past the fence" {})
(check! (some (fn [e] (= :crashed (:why e))) errs) "job 13 crashed behind the fence" {})

;; ── name as value: ask worker 2 for its stats ──────────────────────────

(def stats (call [:workers {:id 2}] :stats))
(println (str "  (call [:workers {:id 2}] :stats) → " (pr-str stats) " jobs done"))
(check! (int? stats) "the name resolves" {})

;; ── kill a worker: the tree regrows it, the registry re-points ─────────

(def before (reg/whereis :workers {:id 1}))
(kill before)
(Process/sleep 120)   ; :DOWN retracts, restart re-registers
(def after-pid (reg/whereis :workers {:id 1}))
(check! (not (nil? after-pid)) "worker 1 regrew" {})
(check! (not (= before after-pid)) "the name now points at the new pid" {})
(println "  killed worker 1; the tree regrew it and the registry re-pointed")

(stop s)
(println "\nall five bundles, one program: green.")
:ok
