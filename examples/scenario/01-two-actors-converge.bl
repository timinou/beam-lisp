; examples/scenario/01-two-actors-converge.bl — a complete scenario-runner host.
;
; Run: bl run examples/scenario/01-two-actors-converge.bl
;        → http://127.0.0.1:4063/runs   (RUNNER_PORT overrides)
;      BL_SMOKE=1 bl run examples/scenario/01-two-actors-converge.bl   (headless)
;
; The runner (`scenario.runner.app`) is domain-neutral and ships NO runs: the
; host injects a Suite with `set-suite!`. `scenario.plant` (examples/scenario/
; plant.bl) supplies four multi-actor runs; swap `plant/suite` for your own and
; the whole interface follows.

(ns example.scenario.two-actors-converge
  (:require [live.app :as app] [live.hiccup :as h]
            [scenario.plant :as plant]
            [scenario.runner.app :as rapp]))

;; ── host ────────────────────────────────────────────────────────────

(defn smoke
  "Headless: inject the suite, render every screen, check scrubbing moves."
  []
  (rapp/set-suite! (plant/suite))
  (let [av (rapp/app-value)]
    (doseq [target ["/runs" "/run/rush-refuted" "/run/nightly-smoke"]]
      (let [body (h/hiccup->html (app/dispatch nil nil {:app av :me "viewer" :route target}))]
        (assert (> (count body) 400) (str target " renders"))
        (println (str "  ✓ " target " (" (count body) " bytes)"))))
    (let [b1 (h/hiccup->html (app/dispatch nil nil {:app av :me "viewer" :route "/run/rush-refuted" :at 1}))
          b3 (h/hiccup->html (app/dispatch nil nil {:app av :me "viewer" :route "/run/rush-refuted" :at 3}))]
      (assert (not= b1 b3) "scrubbing to a different step re-renders differently")
      (println "  ✓ :at 1 and :at 3 render different bases"))))

(defn main []
  (if (contains? #{"1" "true"} (System/get_env "BL_SMOKE"))
    (smoke)
    (let [port (let [p (System/get_env "RUNNER_PORT")]
                 (if (and p (not= p "")) (erlang/binary_to_integer p) 4063))]
      (rapp/set-suite! (plant/suite))
      (rapp/serve port)
      (println (str "\n  suite: http://127.0.0.1:" port "/runs"))
      (Process/sleep 86400000))))

(when (let [f (or (System/get_env "BL_FILE") "")] (String/ends_with? f "01-two-actors-converge.bl"))
  (main))
