; examples/scenario/plant.bl — a tiny plant and four multi-actor scenarios over it.
;
; The fixture shared by the host example (01-two-actors-converge.bl) and the
; scenario tests: the slice of a plant schema the scenarios touch, and a
; `suite` of four runs in the model world — an operator's incident that slips
; the commercial's promise (refuted), a cascade over three actors (refuted), an
; honest repair (proven), a quiet night (proven) — each adapted to a Run.
; Domain lives HERE; `scenario` and `scenario.runner.*` know none of it.

(ns scenario.plant
  (:require [datom] [datom.time :as time]
            [scenario :as s]
            [scenario.runner.adapt :as adapt]))

;; The slice of a plant schema the four scenarios touch.
(def plant-schema
  [{:db/ident :job/id :db/valueType :db.type/string :db/unique :db.unique/identity}
   {:db/ident :job/status :db/valueType :db.type/keyword}
   {:db/ident :resource/id :db/valueType :db.type/string :db/unique :db.unique/identity}
   {:db/ident :resource/kind :db/valueType :db.type/keyword}
   {:db/ident :resource/status :db/valueType :db.type/keyword}
   {:db/ident :assign/id :db/valueType :db.type/string :db/unique :db.unique/identity}
   {:db/ident :assign/status :db/valueType :db.type/keyword}
   {:db/ident :assign/span :db/valueType :db.type/time}
   {:db/ident :incident/id :db/valueType :db.type/string :db/unique :db.unique/identity}
   {:db/ident :incident/scope :db/valueType :db.type/keyword}
   {:db/ident :incident/kind :db/valueType :db.type/keyword}
   {:db/ident :incident/at :db/valueType :db.type/ref}
   {:db/ident :incident/resolved :db/valueType :db.type/boolean}])

;; ── the scenarios, run in the model world, adapted to Runs ──────

(def thursday (time/interval :year 2026 :month 9 :day 3 :hour 10))
(def friday   (time/interval :year 2026 :month 9 :day 4 :hour 14))

(defn- seed-plant []
  (let [conn (datom/connect plant-schema)
        _ (datom/transact! conn
            [{:db/id -1 :job/id "DJ-2617" :job/status :planned}
             {:db/id -2 :resource/id "cd102" :resource/kind :machine :resource/status :up}])
        rep (datom/transact! conn
              [{:db/id -3 :assign/id "a-1" :assign/status :pending :assign/span thursday}])]
    {:conn conn :assign (get (:tempids rep) -3)}))

(defn- perform [conn actor action A]
  (if (= :log-incident (first action))
    (do (datom/transact! conn
          [{:db/id -10 :incident/id "inc-1" :incident/scope :artifact
            :incident/kind :paper-jam :incident/at A :incident/resolved false}
           [:db/add A :assign/status :blocked]
           [:db/add A :assign/span friday]])
        {:logged true})
    :ok))

(defn- promise-lens [db A] (:assign/span (datom/entity db A)))

(defn- resolve-incident [conn A]
  ;; the honest repair: acknowledge the slip, but recover the promise to Thu.
  (datom/transact! conn
    [[:db/add A :assign/status :ready]
     [:db/add A :assign/span thursday]])
  {:resolved true})

(defn- perform-full [conn actor action A]
  (case (first action)
    :log-incident (perform conn actor action A)
    :resolve      (resolve-incident conn A)
    :ok))

(defn- world-for [conn assign performer]
  (s/model-world conn (fn [c a act] (performer c a act assign))
    (fn [db _actor] {:status (:assign/status (datom/entity db assign))
                     :promised-date (:assign/span (datom/entity db assign))})))

(defn- run-refuted []
  (let [{:keys [conn assign]} (seed-plant)
        world (world-for conn assign perform)
        scen (s/scenario "Rush incident — the promise"
               {:amina {:role :commerciale} :op12 {:role {:kiosk :cd102}}}
               [(s/sees :amina (fn [db _] (time/overlaps? (promise-lens db assign) thursday))
                       "the promise is Thursday 10:00 — computed, in delay")
                (s/does :op12 (s/act :log-incident))
                (s/sees :amina (fn [db _] (time/overlaps? (promise-lens db assign) thursday))
                       "the promise is Thursday — a lie after the incident")]
               [(s/stays :amina (fn [db] (promise-lens db assign)) "le temps perdu reste perdu")])]
    (adapt/of-scenario (s/run-world scen world) {:id "rush-refuted" :tags [:incident]})))

(defn- run-proven []
  (let [{:keys [conn assign]} (seed-plant)
        world (world-for conn assign perform)
        scen (s/scenario "Nightly smoke — promise holds"
               {:amina {:role :commerciale}}
               [(s/sees :amina (fn [db _] (time/overlaps? (promise-lens db assign) thursday))
                       "the promise is Thursday and stays Thursday")]
               [(s/stays :amina (fn [db] (promise-lens db assign)) "no incident, no drift")])]
    (adapt/of-scenario (s/run-world scen world) {:id "nightly-smoke" :tags [:smoke]})))

(defn- run-repair []
  ;; the honest arc: promise slips on an incident, then a repair recovers it.
  ;; Every OBSERVATION along the way holds (starts Thu · blocks · ends Thu), so
  ;; the run is PROVEN. NB: we do NOT assert `stays` here — the promise genuinely
  ;; drifted mid-run, and `stays` means "never changed"; asserting it would (and
  ;; did, in an earlier draft) refute honestly. The truth we claim is the
  ;; journey, not stasis.
  (let [{:keys [conn assign]} (seed-plant)
        world (world-for conn assign perform-full)
        scen (s/scenario "Incident — then an honest repair"
               {:amina {:role :commerciale} :op12 {:role {:kiosk :cd102}}}
               [(s/sees :amina (fn [db _] (time/overlaps? (promise-lens db assign) thursday))
                       "the promise starts Thursday")
                (s/does :op12 (s/act :log-incident))
                (s/sees :op12 (fn [db _] (= :blocked (:assign/status (datom/entity db assign))))
                       "the incident blocks the job")
                (s/does :op12 (s/act :resolve))
                (s/sees :amina (fn [db _] (time/overlaps? (promise-lens db assign) thursday))
                       "the promise is Thursday again — recovered, honestly")])]
    (adapt/of-scenario (s/run-world scen world) {:id "incident-repair" :tags [:incident :repair]})))

(defn- run-cascade []
  ;; a longer multi-actor timeline (5 scenes) to show a rich filmstrip; the
  ;; incident slips the promise and the final claim catches the lie (refuted).
  (let [{:keys [conn assign]} (seed-plant)
        world (world-for conn assign perform)
        scen (s/scenario "Cascade — the incident ripples"
               {:amina {:role :commerciale} :karim {:role :chef} :op12 {:role {:kiosk :cd102}}}
               [(s/sees :amina (fn [db _] (time/overlaps? (promise-lens db assign) thursday))
                       "amina quotes Thursday to the customer")
                (s/sees :karim (fn [db _] (= :pending (:assign/status (datom/entity db assign))))
                       "karim sees the job pending, on plan")
                (s/does :op12 (s/act :log-incident))
                (s/sees :karim (fn [db _] (= :blocked (:assign/status (datom/entity db assign))))
                       "karim sees the job blocked by the incident")
                (s/sees :amina (fn [db _] (time/overlaps? (promise-lens db assign) thursday))
                       "amina still says Thursday — now false")]
               [(s/stays :amina (fn [db] (promise-lens db assign)) "a promise, once given, must hold")])]
    (adapt/of-scenario (s/run-world scen world) {:id "cascade" :tags [:incident :cascade]})))

(defn suite
  "The four reference runs, adapted to a Suite."
  []
  (adapt/suite "Scenario suite"
    [(run-refuted) (run-cascade) (run-repair) (run-proven)]))


