; bus.bl — one stream, independent demand, bounded lag.
; Run: mix beam_lisp.run --path priv examples/bus.bl

(ns example.bus
  (:require [bus :as bus]
            [flow :as flow]))

(bus/defbus readings (demand 4))

(defn check! [truth message data]
  (when-not truth
    (throw (ex-info message data))))

(def parent (erlang/self))
(def b (start readings {:max-lag 3}))

(def fast
  (flow/subscribe b :fast
    (fn [event] (erlang/send parent [:fast event]))
    {:demand 1 :on-lag :block :max-lag 3}))

(def slow
  (flow/subscribe b :slow
    (fn [event]
      (Process/sleep 40)
      (erlang/send parent [:slow event]))
    {:demand 1 :on-lag :drop-oldest :max-lag 3}))

(def fast-ref (monitor fast))
(def slow-ref (monitor slow))

; The fast subscriber's :block policy makes each publish wait if its queue is
; full. The slow subscriber never blocks that publisher: its oldest queued
; values are discarded once its private lag reaches three.
(vec (map (fn [n] (bus/publish b n)) (range 1 21)))
(stop b)

(defn collect [fast-events slow-events fast-done? slow-done? fast-monitor slow-monitor]
  (if (and fast-done? slow-done?)
    {:fast fast-events :slow slow-events}
    (receive
      [:fast event]
      (collect (conj fast-events event) slow-events fast-done? slow-done? fast-monitor slow-monitor)

      [:slow event]
      (collect fast-events (conj slow-events event) fast-done? slow-done? fast-monitor slow-monitor)

      [:DOWN down-ref :process _pid :normal]
      :when (= down-ref fast-monitor)
      (collect fast-events slow-events true slow-done? fast-monitor slow-monitor)

      [:DOWN down-ref :process _pid :normal]
      :when (= down-ref slow-monitor)
      (collect fast-events slow-events fast-done? true fast-monitor slow-monitor)

      (after 5000
        (throw (ex-info "subscribers did not receive end-of-stream"
                        {:fast-done fast-done? :slow-done slow-done?}))))))

(def observed (collect [] [] false false fast-ref slow-ref))
(def expected (vec (range 1 21)))

(check! (= (:fast observed) expected)
        "fast subscriber missed events"
        {:expected expected :actual (:fast observed)})
(check! (< (count (:slow observed)) (count expected))
        "slow subscriber did not drop old events"
        {:slow (:slow observed)})
(println (str "fast saw all " (count (:fast observed)) " events"))
(println (str "slow saw " (count (:slow observed)) " events: " (pr-str (:slow observed))))
(println "drop-oldest fired; [:done] reached both subscribers")
