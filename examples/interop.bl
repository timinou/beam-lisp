; interop.bl — every Elixir and Erlang library is callable, no FFI.
; Run: mix beam_lisp.run examples/interop.bl

(println "== elixir modules (Uppercase prefix) ==")
(println (String/upcase "hello from the beam"))
(println (Enum/sum [1 2 3 4 5]))
(println (Enum/map [1 2 3] (fn [x] (* x x)))) ; vectors are Enumerable
(println (Base/encode16 (crypto/strong_rand_bytes 4)))

(println "== erlang modules (lowercase prefix) ==")
(println (lists/reverse '(1 2 3)))
(println (maps/to_list {:a 1 :b 2}))

(println "== remote fns are first-class values ==")
(println (map String/capitalize ["hello" "beam"]))

(println "== data flows both ways, converted never ==")
(def user {:name "Ada" :role :admin})
(println (Map/get user :role))
(println (Map/keys user))
