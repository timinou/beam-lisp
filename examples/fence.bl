; fence.bl — a computation becomes one of three bounded outcomes.
; Run: mix beam_lisp.run --path priv examples/fence.bl

(ns examples.fence
  (:require [fence :refer :all]))

(defn- check [label expected? outcome]
  (println (str label ": " (pr-str outcome)))
  (when-not (expected? outcome)
    (throw (ex-info (str label " assertion failed") {:outcome outcome}))))

(def ok-result (fence 200 (+ 20 22)))
(def crash-result (fence {:ms 200} (throw :boom)))
(def timeout-result (fence 20 (Process/sleep 200)))

(check "ok" #(= % {:ok 42}) ok-result)
(check "crash" #(contains? % :crash) crash-result)
(check "timeout" #(= % {:timeout true}) timeout-result)

(println "fence: all three outcomes passed")
