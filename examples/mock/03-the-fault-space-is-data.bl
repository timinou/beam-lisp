; 03-the-fault-space-is-data.bl — wrong responses, generated and analysed.
; Run: mix beam_lisp.run --path priv examples/mock/03-the-fault-space-is-data.bl
;
; A sturdy mock is not one wrong value — it is the whole SURFACE of wrong, and a
; way to ask for any point on it BY NAME for a test. This file shows both halves
; of the engine division:
;
;   z3       GENERATES wrong responses — one per law, each wrong for exactly that
;            law (an isolated mutant), plus errors on demand for tests.
;   datalog  ANALYSES the fault surface — coverage, redundancy, independence, all
;            as ordinary queries over :fault/violates, once the faults are datoms.

(ns example.mock.faults
  (:require [mock] [mock.fault :as fault] [z3] [core]))

(defn- h [t] (println (str "\n── " t " ──")))
(defn- show [label v] (println (str "  " label "  " (pr-str v))))

(def port (z3/open))

; ── The contract under test ────────────────────────────────────────────────
;
; A weather response with a deliberately REDUNDANT law so the analysis has
; something to find: `temp >= -50` is implied by `temp >= -40`, so it can never
; be broken alone. The tool will report that, unprompted.

(def weather
  (mock/contract-from
    [["temp" "Int"] ["humidity" "Int"] ["code" "Int"]]
    ["(>= temp -40)"        ; clause 0
     "(<= temp 60)"         ; clause 1
     "(>= temp -50)"        ; clause 2 — IMPLIED by clause 0, cannot break alone
     "(>= humidity 0)"      ; clause 3
     "(<= humidity 100)"    ; clause 4
     "(>= code 200)"        ; clause 5
     "(<= code 599)"]))     ; clause 6

; ── 1. Errors ON DEMAND — request a wrong response by the law it breaks ────
;
; For a test, you do not want "some wrong value"; you want the response that is
; wrong for exactly the reason you are testing. `error-for` gives you that.

(h "an error for exactly clause 1 (temp <= 60) — wrong for ONE named reason")
(let [e (fault/error-for port weather 1)]
  (show "response:" e)
  (show "breaks temp<=60?" (not (mock/check port {:fields (:fields weather)
                                                  :ensures ["(<= temp 60)"]} e)))
  (show "still valid humidity?" (mock/check port {:fields (:fields weather)
                                                  :ensures ["(>= humidity 0)" "(<= humidity 100)"]} e)))

(h "the whole error catalogue — every single-law error, keyed by the law it breaks")
(let [es (fault/errors port weather)]
  (doseq [i (sort (keys es))]
    (show (str "error breaking clause " i " (" (nth (:ensures weather) i) "):") (get es i))))

; ── 2. A mock SERVER that injects errors for tests ─────────────────────────
;
; Valid by default; a chosen fault when the request asks for it. The caller does
; not branch — the injection is data. And the verdict rides WITH the response, so
; a test knows exactly which case it exercised.

(h "a mock server: valid by default, an injected error for a chosen request")
(def server
  (fault/make-server port weather "temp"
    {:bad-temp 1        ; request :bad-temp → break clause 1 (temp <= 60)
     :bad-code 6}))     ; request :bad-code → break clause 6 (code <= 599)
(show "serve(:normal) →" (fault/serve server :normal))
(show "serve(:bad-temp) →" (fault/serve server :bad-temp))
(show "serve(:bad-code) →" (fault/serve server :bad-code))

; ── 3. The fault surface as DATALOG — sturdiness is a query ────────────────
;
; Generate every isolated mutant, load them as datoms, and ask the hard
; questions as queries. This is the datalog half: coverage, redundancy, and
; which laws are truly independent.

(h "the full robustness report (datalog over the fault datoms)")
(def r (fault/report port weather))
(show "clauses in contract:" (:clauses r))
(show "distinct faults generated:" (:faults r))
(show "clauses a fault covers:" (:covered r))
(show "clauses NO fault covers (blind spots):" (:uncovered r))
(show "independent laws (breakable alone):" (:independent (:laws r)))
(show "IMPLIED laws (redundant — cannot break alone):" (:implied (:laws r)))

; ── 4. What the analysis caught ────────────────────────────────────────────
;
; Clause 2 (temp >= -50) shows up as IMPLIED: no isolated mutant exists for it,
; because any temp below -50 is already below -40 (clause 0). The tool found a
; redundant law in the contract — a real finding about the SPEC, from data.

(h "the point")
(println "  \"Wrong\" is not one value — it is a surface, and every point on it")
(println "  is nameable: an error for clause i is wrong for exactly law i, so a")
(println "  test asks for the fault it means to exercise. Generation is z3's job")
(println "  (find a value); COVERAGE, REDUNDANCY, and INDEPENDENCE are datalog's")
(println "  (query a set). The redundant law (clause 2) was found, not guessed —")
(println "  the contract's own fault space told on it.")
