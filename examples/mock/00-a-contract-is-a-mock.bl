; 00-a-contract-is-a-mock.bl — a contract, run backwards, is a mock server.
; Run: mix beam_lisp.run --path priv examples/mock/00-a-contract-is-a-mock.bl
;
; The claim, made concrete: you do not WRITE a mock. You write the CONTRACT the
; real API must satisfy, and the mock falls out of running that contract
; backwards through the same solver that CHECKS the real one. Same predicate,
; two directions.

(ns example.mock.demo
  (:require [mock] [z3] [core]))

(defn- h [t] (println (str "\n── " t " ──")))
(defn- show [label v] (println (str "  " label "  " (pr-str v))))

(def port (z3/open))

; ── The API under mock: a weather endpoint ────────────────────────────────
;
; GET /current → { temp : Int, humidity : Int, code : Int }
; The CONTRACT — the same laws the real api.weather.com response must obey:
;   temp is a real earth temperature   (-90 ≤ temp ≤ 60)
;   humidity is a percentage           (0 ≤ humidity ≤ 100)
;   code is a status enum              (200 ≤ code ≤ 599)
;
; Written as ordinary beam-lisp predicates over the response fields. Nothing
; here mentions a mock — these are the API's laws, full stop.

(def weather
  (mock/contract-from
    [["temp" "Int"] ["humidity" "Int"] ["code" "Int"]]
    ["(>= temp -90)" "(<= temp 60)"
     "(>= humidity 0)" "(<= humidity 100)"
     "(>= code 200)" "(<= code 599)"]))

(h "the contract, as translated to the solver's vocabulary")
(show "ensures:" (:ensures weather))

; ── 0. Is the contract even realizable? ────────────────────────────────────
; Before any implementation exists, the solver decides whether the laws can be
; satisfied at all. A self-contradictory spec is caught here — with no code.

(h "is the contract satisfiable at all? (caught before any impl)")
(show "satisfiable?" (mock/satisfiable? port weather))

; ── 1. Synthesize ONE valid response ───────────────────────────────────────
; z3 answers the SAT query with a MODEL — and the model IS the response value.

(h "a valid response, synthesized (the model IS the value)")
(show "GET /current →" (:value (mock/synth port weather "")))

; ── 2. A DETERMINISTIC mock server: input → response, purely ───────────────
; Seed the synthesis by a request-derived integer and the same request always
; yields the same response. This is a mock SERVER: a pure function of its input.

(h "a mock server: same request → same response (a pure function)")
(defn serve [request-id]
  (:value (mock/synth-seeded port weather "temp" (core/mod request-id 60))))
(show "serve(42) →  " (serve 42))
(show "serve(42) →  " (serve 42))
(show "serve(7)  →  " (serve 7))

; ── 3. BOUNDARY responses, for free ────────────────────────────────────────
; The edge cases a hand-written mock always forgets. z3's optimizer finds the
; coldest and hottest temperature the contract still admits.

(h "boundary responses — the edges, generated by the solver")
(show "coldest valid temp:" (:value (mock/synth-boundary port weather "temp" :min)))
(show "hottest valid temp:" (:value (mock/synth-boundary port weather "temp" :max)))

; ── 4. ADVERSARIAL responses the contract FORBIDS ──────────────────────────
; Assert the NEGATION of the contract: every value returned is, by construction,
; a violation. This is fault injection whose fault-type is contract-derived —
; the mock can be hostile while provably inside the sandbox.

(h "an adversarial response the contract forbids (negative test, by construction)")
(let [bad (:value (mock/synth-invalid port weather))]
  (show "a forbidden response:" bad)
  (show "does it satisfy the contract?" (mock/check port weather bad)))

; ── 5. The forward round-trip: synthesize backward, VERIFY forward ─────────
; A synthesized response is only trusted if it survives the forward check — the
; same solver, the same predicate, run the other way. A valid response checks
; true; the adversarial one checks false. The two directions verify each other.

(h "synthesize backward, verify forward — the two directions agree")
(let [good (:value (mock/synth port weather ""))]
  (show "valid response satisfies contract?  " (mock/check port weather good)))

; ── 6. A contradictory contract is caught with no implementation ───────────
; "temp above 60 AND below -90" — no earth temperature satisfies both. The
; solver reports it unrealizable, so you learn the spec is broken before you
; write a line of the server OR the mock.

(h "a self-contradictory contract is caught before any code")
(def broken
  (mock/contract-from
    [["temp" "Int"]]
    ["(> temp 60)" "(< temp -90)"]))
(show "satisfiable-status:" (mock/satisfiable-status port broken))

(h "the point")
(println "  The mock was never written. It was DERIVED from the contract the")
(println "  real API must satisfy — by running that contract backwards through")
(println "  the same solver that would CHECK the real one. One predicate, two")
(println "  directions: forward it verifies, backward it mocks. So a mock that")
(println "  drifts from the contract is impossible — there is only the contract.")
