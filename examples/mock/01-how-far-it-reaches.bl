; 01-how-far-it-reaches.bl — the reach of a synthesized mock.
; Run: mix beam_lisp.run --path priv examples/mock/01-how-far-it-reaches.bl
;
; 00 mocked integer fields. The solver's theories reach much further: strings
; (with structure — a prefix, a bounded length), reals, and — the payoff —
; RELATIONAL constraints that tie fields to each other. A hand-written mock
; drifts on exactly these: it returns a `total` that does not equal
; `price + tax`, a `max` below the `min`. A synthesized mock CANNOT, because the
; relation is asserted, not remembered.
;
; It also shows the HONEST edge: nonlinear arithmetic (price × qty) is
; undecidable, so the engine returns "unknown" rather than hanging or lying.

(ns example.mock.reach
  (:require [mock] [z3] [core]))

(defn- h [t] (println (str "\n── " t " ──")))
(defn- show [label v] (println (str "  " label "  " (pr-str v))))

(def port (z3/open))

; ── 1. STRING theory: a token endpoint with STRUCTURE ──────────────────────
;
; POST /session → { token : String, kind : String }
; The contract says a token is PREFIXED sk_ and a kind is one of a set. z3's
; string theory synthesizes a value with that structure — not a random blob.

(h "a token with structure (string theory: prefix + membership)")
(def session
  {:fields  [["token" "String"] ["kind" "String"]]
   :ensures ["(str.prefixof \"sk_\" token)"
             "(>= (str.len token) 8)"
             "(or (= kind \"bearer\") (= kind \"basic\"))"]})
(show "POST /session →" (:value (mock/synth port session "")))

; ── 2. REAL theory: a pricing endpoint ─────────────────────────────────────
;
; GET /quote → { rate : Real }  where  0 < rate < 1
; The Real theory synthesizes a fractional value the Int theory could not; z3
; renders it as an exact rational (1/2), which the model parser reads back.

(h "a fractional rate (real theory, exact rational)")
(def quote
  {:fields  [["rate" "Real"]]
   :ensures ["(> rate 0.0)" "(< rate 1.0)"]})
(show "GET /quote →" (:value (mock/synth port quote "")))

; ── 3. RELATIONAL: fields the mock MUST keep consistent (LINEAR) ────────────
;
; POST /invoice → { subtotal : Int, tax : Int, total : Int }
; The law a hand-written mock forgets: total = subtotal + tax, tax is 10% band,
; amounts bounded. LINEAR, so fully decidable — the solver returns a response
; where all three fields agree, because the relation is part of the contract.

(h "a response whose fields must agree (linear relational contract)")
(def invoice
  {:fields  [["subtotal" "Int"] ["tax" "Int"] ["total" "Int"]]
   :ensures ["(>= subtotal 100)" "(<= subtotal 1000)"
             "(>= tax 0)" "(<= tax 200)"
             "(= total (+ subtotal tax))"]})       ; the cross-field invariant
(let [resp (:value (mock/synth-seeded port invoice "subtotal" 250))]
  (show "POST /invoice →" resp)
  (show "total = subtotal + tax?" (= (:total resp) (+ (:subtotal resp) (:tax resp)))))

; ── 4. The relational law makes a WRONG mock impossible ────────────────────
;
; Ask for a response that VIOLATES the contract. The solver can only do it by
; breaking a clause — and `check` confirms it is outside the contract. You
; cannot synthesize an inconsistent invoice and have it pass.

(h "an invoice that breaks the total law is caught by the forward check")
(let [bad (:value (mock/synth-invalid port invoice))]
  (show "a forbidden invoice:" bad)
  (show "satisfies contract?" (mock/check port invoice bad)))

; ── 5. NONLINEAR is undecidable — the engine says so, HONESTLY ─────────────
;
; total = price × qty is nonlinear integer arithmetic. z3 can still SYNTHESIZE a
; valid one (SAT is fast), but PROVING a contradictory nonlinear spec unsat can
; spin forever — so the engine bounds it with a timeout and returns "unknown"
; rather than hanging or claiming a false answer.

(h "nonlinear: synthesis still works (SAT is fast)")
(def order
  {:fields  [["price" "Int"] ["qty" "Int"] ["total" "Int"]]
   :ensures ["(>= price 1)" "(<= price 100)"
             "(>= qty 1)" "(<= qty 5)"
             "(= total (* price qty))"]})
(let [resp (:value (mock/synth-seeded port order "qty" 3))]
  (show "POST /order →" resp)
  (show "total = price × qty?" (= (:total resp) (* (:price resp) (:qty resp)))))

(h "nonlinear: an over-constrained spec is UNKNOWN, not a hang, not a lie")
(def impossible
  {:fields  [["price" "Int"] ["qty" "Int"] ["total" "Int"]]
   :ensures ["(>= price 1)" "(>= qty 2)"
             "(= total (* price qty))"
             "(= (mod qty 2) 0)"                ; qty even
             "(= (mod total 2) 1)"]})           ; total odd — impossible if qty even
(show "satisfiable-status:" (mock/satisfiable-status port impossible))

(h "the reach")
(println "  Int, Real, String — and the relations BETWEEN fields. Wherever the")
(println "  contract can state a law, the mock can honour it and the checker can")
(println "  enforce it, because they are the same law read two ways. The ceiling")
(println "  is the solver's: linear constraints are decided both ways; nonlinear")
(println "  ones still SYNTHESISE, and where a proof is undecidable the engine")
(println "  returns \"unknown\" — never a hang, never a false mock.")
