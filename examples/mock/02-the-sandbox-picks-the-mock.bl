; 02-the-sandbox-picks-the-mock.bl — the mock is chosen by the WORLD, not an if.
; Run: mix beam_lisp.run --path priv examples/mock/02-the-sandbox-picks-the-mock.bl
;
; This is the use case that motivated the whole thing: an API call that, when
; the sandbox forbids the capability the real impl needs, transparently resolves
; to a PURE mock derived from the same contract — with no `if sandbox` branch
; anywhere in the code.
;
; The selection is a property of the ENVIRONMENT the code runs in. An env that
; grants the impl's capability can reach the real endpoint; an env that does not
; cannot even NAME the module (ungranted modules are unspeakable — a compile
; error, not a runtime check). So the resolver's rule is simply: reach the real
; impl if the world permits it, else fall back to the contract-derived mock.
; Fail-closed becomes fall-back-to-mock.
;
; Here the capability the "network" impl needs is represented by a real loaded
; module the fork can narrow away. (When per-host egress caps land — PLAN-060
; Requirement C — the very same shape keys on "may reach api.weather.com:443"
; instead of a module name; the resolver does not change.)

(ns example.mock.sandbox
  (:require [mock] [z3] [env] [core]))

(defn- h [t] (println (str "\n── " t " ──")))
(defn- show [label v] (println (str "  " label "  " (pr-str v))))

(def port (z3/open))

; ── The contract — the API's laws, shared by real impl and mock ────────────

(def weather
  (mock/contract-from
    [["temp" "Int"] ["humidity" "Int"]]
    ["(>= temp -90)" "(<= temp 60)" "(>= humidity 0)" "(<= humidity 100)"]))

; The capability the real impl needs, named as a module. A world that grants it
; can run the network impl; a fork that withholds it cannot.
(def EGRESS-CAP "Elixir.File")

; The "real" implementation reaches the network — it needs EGRESS-CAP.
(defn real-current [city]
  {:source :network :city city :temp 21 :humidity 55})

; A city name → a deterministic seed via the BEAM's own hash.
(defn city-seed [city] (erlang/rem (erlang/phash2 city) 60))

; The mock implementation is DERIVED, pure, deterministic per request.
(defn mock-current [city]
  (assoc (:value (mock/synth-seeded port weather "temp" (city-seed city)))
         :source :mock :city city))

; ── The resolver: the WORLD decides, not an `if` in the caller ─────────────
;
; `current` asks the environment one question — may I reach the impl's cap? —
; and dispatches. The caller never mentions "mock"; it just calls `current`. In
; a granted world it gets the network; in a sandbox it gets the mock, and the
; mock is guaranteed to satisfy the same contract the real one is checked against.

(defn egress-granted? []
  (env/allowed? EGRESS-CAP))

(defn current [city]
  (if (egress-granted?)
    (real-current city)
    (mock-current city)))

; ── At :global — the capability is granted, the real impl answers ──────────

(h "at :global — the world grants the impl's capability, the real impl answers")
(show "egress granted?" (egress-granted?))
(show "current(\"paris\") →" (current "paris"))

; ── In a sandbox WITHOUT the capability — the mock answers, purely ─────────
;
; Fork a world scoped to a couple of harmless modules — crucially NOT the impl's
; capability. Inside it, `egress-granted?` is false, so the very same `current`
; call resolves to the contract-derived mock. No branch in the caller changed;
; the world did.

(h "in a sandbox without the capability — the SAME call yields the mock")
(def sandbox (env/fork (env/current) {:caps ["Elixir.String" "Elixir.Enum"]}))
(env/with-env sandbox
  (fn []
    (show "egress granted?" (egress-granted?))
    (show "current(\"paris\") →" (current "paris"))
    (show "current(\"paris\") again →" (current "paris"))    ; deterministic
    (show "current(\"tokyo\") →" (current "tokyo"))))
(env/destroy sandbox)

; ── Why the swap is safe: the mock satisfies the contract ──────────────────
;
; The mock is not "some fake data". It is a value the solver PROVED satisfies
; the contract's laws — so anything the caller may assume of a real response
; holds of the mock too. We check one here to make the guarantee visible.

(h "the mock is contract-valid by construction (checked)")
(let [m (mock-current "paris")]
  (show "mock response:" m)
  (show "satisfies the weather contract?"
        (mock/check port weather (dissoc m :source :city))))

(h "the point")
(println "  The caller wrote `current`, never `mock`. Whether it reaches the")
(println "  real endpoint or a synthesized stand-in is decided by the WORLD the")
(println "  code runs in — the presence or absence of a capability — not by a")
(println "  branch the caller had to remember. And the stand-in is safe because")
(println "  it answers to the very contract the real endpoint is held to.")
