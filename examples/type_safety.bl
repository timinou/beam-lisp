; type_safety.bl — what a value IS, and why that was the hardest question
; in this language to answer correctly.
;
; Run: mix beam_lisp.run examples/type_safety.bl
;
; This example exists because of a bug class, not a feature. On the BEAM a
; struct IS a map: `is_map(%Vector{})` is true, because a struct is a map
; carrying a hidden :__struct__ key. beam-lisp's own map type is a PLAIN
; map, and eleven other beam-lisp values happen to be struct-backed. So a
; guard that reads `is_map(x)` and means "a beam-lisp map" silently accepts
; a lazy seq, a vector, an atom-ref, a record — anything.
;
; Roughly a third of this project's bugs were that one fact.

(ns type.safety)

(defrecord Point [x y])
(deftype Marker [tag])

(defn show [label v]
  (println (str "  " label " => " (try (str (v)) (catch e "raises")))))

(println "== a reference is not a collection ==")

; This is the bug in its clearest form. `(count (atom 1))` used to answer
; 2 — it was counting the atom struct's own hidden fields, :__struct__ and
; :pid. A plausible integer, arbitrarily far from the mistake that caused
; it. Now it refuses.
(show "(count (atom 1))     " (fn [] (count (atom 1))))
(show "(get (atom 1) :value)" (fn [] (get (atom 1) :value)))
(show "(coll? (atom 1))     " (fn [] (coll? (atom 1))))
(show "(map? (atom 1))      " (fn [] (map? (atom 1))))

; The `get` case was the worst of them: it answered nil, which is a
; perfectly legitimate result for a map lookup that missed. There was no
; way to tell the bug from a correct answer.

(println)
(println "== a record IS a map, and every operation agrees ==")

; A record is user-facing map data, so every map operation accepts it.
; `map?` used to be the single dissenter — returning false while count,
; seq, get, assoc, find and coll? all treated a record as a map. A
; predicate that disagrees with every operation it guards is worse than
; no predicate at all.
(def p (->Point 1 2))
(show "(map? p)      " (fn [] (map? p)))
(show "(coll? p)     " (fn [] (coll? p)))
(show "(count p)     " (fn [] (count p)))
(show "(get p :x)    " (fn [] (get p :x)))
(show "(seq p)       " (fn [] (seq p)))
(show "(assoc p :x 9)" (fn [] (assoc p :x 9)))

(println)
(println "== but a NON-record struct is not a map ==")

; A lazy seq and a vector are structs too, and they are emphatically not
; maps. `(assoc lazy-seq :a 1)` used to SILENTLY CORRUPT the value by
; adding an :a field to the struct — a lazy seq that then behaved
; unpredictably wherever it was later forced.
(show "(map? [1 2])              " (fn [] (map? [1 2])))
(show "(map? (map inc [1 2]))    " (fn [] (map? (map inc [1 2]))))
(show "(assoc (map inc [1 2]) :a 1)" (fn [] (assoc (map inc [1 2]) :a 1)))

(println)
(println "== deftype: a tuple, deliberately ==")

; `deftype` is NOT a struct — it compiles to a tagged tuple. That is a
; direct response to this hazard: a tuple can never be swallowed by an
; is_map clause, no matter how carelessly one is written later.
(def m (->Marker :urgent))
(show "(.-tag m)  " (fn [] (.-tag m)))
(show "(map? m)   " (fn [] (map? m)))

(println)
(println "== how the invariant is kept ==")
(println "  BeamLisp.Guards.is_bl_map/1  a defguard that CANNOT be written")
(println "                               to admit a struct")
(println "  is_map_lint_test.exs         fails the build on a bare is_map(")
(println "                               without an `is_map-ok:` reason")
(println "  dispatch_table_test.exs      306 cells: every value type against")
(println "                               every collection fn")
(println)
(println "  The lint found a site the hand-written census had missed,")
(println "  which is the argument for enforcement over convention.")
