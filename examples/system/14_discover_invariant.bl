; examples/system/14_discover_invariant.bl — P18 ★: the invariant from NOTHING.
; Run: mix beam_lisp.run --path priv examples/system/14_discover_invariant.bl
;
; Every checker so far needed you to WRITE ^{:invariant …}. This is the headline:
; point the checker at an UN-ANNOTATED server and it DISCOVERS the invariant —
; then you can prove it. The last annotate-only property, closed.
;
; It is a Houdini fixpoint (Flanagan–Leino) over exactly the pieces the tier
; already had: candidates (miniKanren enumerates predicates), the state vars,
; and z3 (decides preservation). Start from every candidate true at init; drop
; any a transition can break; the fixpoint is the strongest inductive invariant
; expressible in the vocabulary — sound by construction.

(ns example.system.discover
  (:require [system.core :as sys] [z3]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- h [t] (println (str "\n── " t " ──")))
(def port (z3/open))

; ════════════════════════════════════════════════════════════════════════
; An account with NO ^{:invariant}. Nothing tells the checker what to prove.
; ════════════════════════════════════════════════════════════════════════

(def account
  "(defserver account
     (init [] (ok 0))
     (handle-call [:deposit amt] [_ balance] :when (>= amt 0)
       (reply :ok (+ balance amt)))
     (handle-call [:withdraw amt] [_ balance] :when (and (>= amt 0) (>= balance amt))
       (reply :ok (- balance amt))))")

(h "point the checker at an un-annotated server")
(def d (sys/discover-invariant port (read1 account)))
(println "  machine:            " (:name d))
(println "  DISCOVERED invariant:" (:discovered d))
(println "  (proven established at init AND preserved by every transition)")

; ════════════════════════════════════════════════════════════════════════
; The discovery is SOUND by construction — but we can feed it straight back
; into verify-process as if it had been annotated, and it proves.
; ════════════════════════════════════════════════════════════════════════

(h "the discovered invariant proves when annotated back")
(def annotated
  (str "(defserver ^{:invariant " (:discovered d) "} account"
       "   (init [balance] (ok balance))"
       "   (handle-call [:deposit amt] [_ balance] :when (>= amt 0)"
       "     (reply :ok (+ balance amt)))"
       "   (handle-call [:withdraw amt] [_ balance] :when (and (>= amt 0) (>= balance amt))"
       "     (reply :ok (- balance amt))))"))
(def v (sys/verify-process port (read1 annotated)))
(println "  □" (:discovered d) "holds:" (:holds v))

; ════════════════════════════════════════════════════════════════════════
; A counter whose withdraw is UNguarded discovers NO lower bound — honest:
; we found no invariant of that shape, rather than a false one.
; ════════════════════════════════════════════════════════════════════════

(def leaky
  "(defserver leaky
     (init [] (ok 0))
     (handle-call [:dec] [_ n] (reply :ok (- n 1))))")

(h "an unbounded-below machine discovers no lower bound (honest)")
(def d2 (sys/discover-invariant port (read1 leaky)))
(println "  DISCOVERED:" (pr-str (:discovered d2)) " (no (>= n 0) — dec can go negative)")

(h "the takeaway")
(println "  The invariant is abduce's search aimed at the WHOLE property, run as")
(println "  a Houdini fixpoint seeded by the state vars. No annotation needed —")
(println "  and when the shape admits none, we say so rather than invent one.")
