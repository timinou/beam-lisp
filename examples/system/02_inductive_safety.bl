; examples/system/02_inductive_safety.bl — □Inv, proven unbounded.
; Run: mix beam_lisp.run --path priv examples/system/02_inductive_safety.bl
;
; z3 discharges the Hoare triple Inv(s) ∧ guard ∧ s'=next(s) ⊢ Inv(s') for
; EVERY state and EVERY input — so a bank account's balance ≥ 0 is proven over
; an unbounded state space, not just the states a finite search enumerates.

(ns example.system.inductive
  (:require [system :as sys] [z3]))

(defn- h [t] (println (str "\n── " t " ──")))
(def port (z3/open))
(defn- inv [v] (str "(>= " v " 0)"))
(def decls "(declare-const balance Int)\n(declare-const amt Int)\n")

(h "a correct bank account: □(balance ≥ 0) proven unbounded")
(def good
  [{:label :deposit  :guard "(>= amt 0)" :next "(+ balance amt)"}
   {:label :withdraw :guard "(and (>= amt 0) (>= balance amt))" :next "(- balance amt)"}])
(def r (sys/prove-box port inv "balance" decls "0" good))
(println "  init establishes balance ≥ 0:  " (:established (:init r)))
(doall (map (fn [s] (println (str "  " (:label s) " preserves it: " (:preserved s))))
            (:steps r)))
(println "  □(balance ≥ 0) HOLDS:" (:holds r) "— for every balance and every amount")

(h "a bug: withdraw without the balance ≥ amt guard")
(def bad [{:label :withdraw :guard "(>= amt 0)" :next "(- balance amt)"}])
(def br (sys/prove-box port inv "balance" decls "0" bad))
(def f (first (:failures br)))
(println "  holds:" (:holds br) "— the checker caught the missing guard")
(println "  counterexample (state+amount that overdraws):")
(doall (map (fn [line] (println (str "    " line))) (split (:model f) "\n")))
(println "\n  → not 'unsound' — the exact overdrawing state, from the source.")
