; examples/system/06_deadlock.bl — deadlock-freedom, structurally.
; Run: mix beam_lisp.run --path priv --path priv/datom examples/system/06_deadlock.bl
;
; A synchronous call blocks until reply; a cycle in the waits-for graph is a
; deadlock. That graph is datoms; a deadlock is "A reachable from A" — a
; recursive datalog query on the shipped fixpoint engine. No z3, no state
; exploration. We report the structural CYCLE — the cause, servers named.

(ns example.system.deadlock
  (:require [system.core :as sys] [datom]))

(defn- h [t] (println (str "\n── " t " ──")))
(def SCHEMA
  [{:db/ident :server/name :db/valueType :db.type/string :db/unique :db.unique/identity}
   {:db/ident :waits/on :db/valueType :db.type/ref :db/cardinality :db.cardinality/many}])
(defn- q% [query db & args] (apply datom/q query db args))

(h "an acyclic call graph — provably deadlock-free")
(def c1 (datom/connect SCHEMA))
(datom/transact! c1
  [{:db/id -1 :server/name "gateway" :waits/on [-2 -3]}
   {:db/id -2 :server/name "auth"    :waits/on [-4]}
   {:db/id -3 :server/name "cache"}
   {:db/id -4 :server/name "store"}])
(println "  gateway→{auth,cache}, auth→store  (a DAG)")
(println "  deadlocked servers:" (pr-str (sys/deadlocked (datom/db c1) q%)))

(h "a synchronous call cycle — the deadlock, named")
(def c2 (datom/connect SCHEMA))
(datom/transact! c2
  [{:db/id -1 :server/name "orders"   :waits/on [-2 -4]}
   {:db/id -2 :server/name "billing"  :waits/on [-3]}
   {:db/id -3 :server/name "shipping" :waits/on [-1]}
   {:db/id -4 :server/name "audit"}])
(println "  orders→billing→shipping→orders (cycle), +orders→audit")
(println "  deadlocked servers:" (pr-str (sys/deadlocked (datom/db c2) q%)))
(println "  → the three cycle members named; audit (acyclic) excluded.")

(h "break the cycle: make one call async → healed, same query confirms")
(def c3 (datom/connect SCHEMA))
(datom/transact! c3
  [{:db/id -1 :server/name "orders"   :waits/on [-2]}
   {:db/id -2 :server/name "billing"  :waits/on [-3]}
   {:db/id -3 :server/name "shipping"}])       ; shipping→orders now async, no edge
(println "  deadlocked servers:" (pr-str (sys/deadlocked (datom/db c3) q%)))
(println "\n  → TLA+ reports a deadlock STATE after search; we report the structural")
(println "    CYCLE — the actual cause, from the call graph directly.")
