; examples/system/12_collection_state.bl — P18 Rung 3: collection state.
; Run: mix beam_lisp.run --path priv examples/system/12_collection_state.bl
;
; State holds a COLLECTION — a queue of pending work. Two classes of invariant
; with DIFFERENT decidability, and the honesty is that the checker tells them
; apart in the guarantee catalog:
;
;   CAPACITY / SIZE  — "the queue never exceeds 10". The length is an integer;
;      conj is +1, rest is -1. This ABSTRACTS the collection to its size and is
;      EXACT and decidable — Rung 1 over a derived quantity. Registered :exact.
;
;   CONTENT  — "no duplicate", "every session has a socket". This needs the
;      elements — z3 sequences, a BOUNDED (BMC) check. Registered :approximate.
;
; This demo shows the exact one, live through the checker, and the catalog
; distinction that keeps the tier honest.

(ns example.system.collection
  (:require [system.core :as sys] [z3]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- h [t] (println (str "\n── " t " ──")))
(def port (z3/open))

; ════════════════════════════════════════════════════════════════════════
; A bounded work queue, capacity 10. State is the queue itself; the invariant
; is a CAPACITY property over its length. enqueue is guarded by room; dequeue
; by non-emptiness.
; ════════════════════════════════════════════════════════════════════════

(def work-queue
  "(defserver ^{:invariant (<= (count pending) 10)} worker
     (init [] (ok []))
     (handle-call [:enqueue job] [_ pending] :when (< (count pending) 10)
       (reply :ok (conj pending job)))
     (handle-call [:dequeue] [_ pending] :when (> (count pending) 0)
       (reply :ok (rest pending))))")

(h "capacity as an EXACT guarantee (length abstraction)")
(def r (sys/verify-capacity port (read1 work-queue)))
(println "  machine:   " (:name r))
(println "  checked:   " (:checked r) "  (pending abstracted to its length)")
(println "  □(count pending ≤ 10) holds:" (:holds r))
(println "  extension: " (:extension r) "  — proven for ALL traces, unbounded")
(println "  warnings:  " (pr-str (:warnings r)))

; ════════════════════════════════════════════════════════════════════════
; The bug: an enqueue with no room-check. It can overflow the capacity. Caught.
; ════════════════════════════════════════════════════════════════════════

(def overflowing
  "(defserver ^{:invariant (<= (count pending) 10)} worker
     (init [] (ok []))
     (handle-call [:enqueue job] [_ pending] (reply :ok (conj pending job))))")

(h "an unguarded enqueue can overflow — caught")
(def rb (sys/verify-capacity port (read1 overflowing)))
(println "  holds:" (:holds rb) "  warning:" (pr-str (map :msg (:warnings rb))))

; ════════════════════════════════════════════════════════════════════════
; The catalog keeps the two honesty tiers apart: capacity is exact; a content
; property (no-duplicate) would register as approximate with its bound.
; ════════════════════════════════════════════════════════════════════════

(h "the honesty: the guarantee catalog")
(sys/register-guarantee! :worker-no-duplicate {:extension :approximate :bound 8 :kind :content})
(println "  exact guarantees:       " (pr-str (sys/exact-guarantees)))
(println "  approximate guarantees: " (pr-str (sys/approximate-guarantees)))

(h "the takeaway")
(println "  A collection is its LENGTH for a capacity invariant — Rung 1 over a")
(println "  derived integer, EXACT. Content needs the elements and is a bounded")
(println "  check. The catalog says which is which; we never call bounded exact.")
