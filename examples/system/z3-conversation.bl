; examples/system/z3-conversation.bl — what a leased solver buys over a query.
;
; Run: bl run examples/system/z3-conversation.bl
;
; `z3/check` answers one question at a time: it RESETS, asserts, checks and
; throws the context away. Right shape for "does this hold?", wrong shape for
; everything else z3 can do. A LEASE turns the solver into a conversation:
; assertions accumulate, push/pop scope a hypothesis, check-sat-assuming asks
; "what if" with no mutation, and an unsat core names the assertions that are
; jointly guilty — the difference between "violated" and "violated, and here is
; why". The lease is also what makes it safe to expose: one conversation at a
; time, released even if the borrower dies.
;
; Written as top-level forms (the shape `bl run` executes and prints), so the
; output is the real thing rather than a description of it.

(ns tooling.z3-conversation
  (:require [z3]))

(println "1. one context, many questions (no reset between them)")
(z3/with-solver
  (fn []
    (println "   declare:" (pr-str (z3/command "(declare-const balance Int)")))
    (println "   assert: " (pr-str (z3/command "(assert (>= balance 0))")))
    (println "   assert: " (pr-str (z3/command "(assert (<= balance 100))")))
    (println "   balance in [0,100] ->" (z3/check-here))
    (z3/push)
    (println "   push, then assert amt > balance")
    (z3/command "(declare-const amt Int)")
    (z3/command "(assert (= amt 150))")
    (z3/command "(assert (> amt balance))")
    (println "   inside the hypothesis ->" (z3/check-here))
    (z3/pop)
    (println "   after pop ->" (z3/check-here))))

(println "2. what-if, with no mutation at all")
(z3/with-solver
  (fn []
    (z3/command "(declare-const a Bool)")
    (z3/command "(declare-const b Bool)")
    (z3/command "(assert (or a b))")
    (println "   a off and b off ->" (pr-str (z3/check-assuming ["(not a)" "(not b)"])))
    (println "   a on            ->" (pr-str (z3/check-assuming ["a"])))))

(println "3. an unsat core names the guilty guards")
(z3/with-solver
  (fn []
    ;; z3 refuses :produce-unsat-cores once an assertion exists — verified
    ;; against the pinned binary, so it must come first in the conversation.
    (z3/command "(set-option :produce-unsat-cores true)")
    (z3/command "(declare-const x Int)")
    (z3/command "(assert (! (> x 0) :named g_positive))")
    (z3/command "(assert (! (< x 0) :named g_negative))")
    (let [r (z3/check-core)]
      (println "   status ->" (:status r))
      (println "   core   ->" (pr-str (:core r)))
      (println "   -> a repair can name the guards to choose between, not just say 'violated'"))))

(println "4. the lease is exclusive, and always returned")
(println "   owner outside a conversation:" (pr-str (BeamLisp.Z3.Solver/owner nil)))
(println "   a conversation verb with NO lease is refused, not tolerated:")
(println "     ->" (pr-str (try (do (z3/command "(push 1)") :ran)
                               (catch e (str e)))))
(z3/with-solver
  (fn []
    (println "   owner inside: " (pr-str (BeamLisp.Z3.Solver/owner nil))
             " (me:" (pr-str (erlang/self)) ")")
    (println "   and inside the lease the same verb runs:"
             (pr-str (z3/command "(push 1)")))))
(println "   owner after release:" (pr-str (BeamLisp.Z3.Solver/owner nil)))
(println "OK - conversations came back in order, each from a fresh context")
