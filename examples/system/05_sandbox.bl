; examples/system/05_sandbox.bl — footprint ⊆ caps, the sandbox unified.
; Run: mix beam_lisp.run --path priv examples/system/05_sandbox.bl
;
; Capabilities and effect-footprints are ONE lattice from opposite ends: granted
; caps are the UPPER bound (the sandbox enforces at compile time, a fork
; narrows child ⊆ parent); the inferred footprint is the LOWER bound. Verifying
; a sandboxed process is the containment footprint ⊆ caps.

(ns example.system.sandbox
  (:require [system :as sys] [footprint :as fp]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- fpo [s] (fp/fp-walk {} (read1 s)))
(defn- h [t] (println (str "\n── " t " ──")))

(h "the fork tree IS a fleet non-interference proof")
(def a-work (fpo "(swap! orders conj o)"))
(def b-work (fpo "(swap! inventory dec)"))
(println "  tenant A caps #{orders}   work footprint" (pr-str a-work)
         " ⊆ caps?" (sys/footprint-in-caps? a-work #{"orders"}))
(println "  tenant B caps #{inventory} work footprint" (pr-str b-work)
         " ⊆ caps?" (sys/footprint-in-caps? b-work #{"inventory"}))
(println "  A-work ⋈ B-work commute?" (fp/commute? a-work b-work))
(println "  → disjoint caps ⟹ disjoint footprints ⟹ all A-workers commute with")
(println "    all B-workers. A thousand-worker fleet, race-free, from the fork tree.")

(h "an un-conveyed spawn escalates to :opaque-world — the confused deputy, caught")
(def naive (sys/spawn-footprint {} (read1 "(erlang/spawn (fn [] (swap! x inc)))")))
(def conveyed (sys/spawn-footprint {} (read1 "(erlang/spawn (bind env (fn [] (swap! y inc))))")))
(println "  (erlang/spawn (fn …))          footprint" (pr-str naive)
         " ⊆ #{x}?" (sys/footprint-in-caps? naive #{"x"}))
(println "  (erlang/spawn (bind env (fn …))) footprint" (pr-str conveyed) " (bounded)")
(println "\n  → the un-conveyed spawn escapes any finite cap set → flagged; conveying")
(println "    it via capture/bind keeps the child within the granted authority.")
