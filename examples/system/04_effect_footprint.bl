; examples/system/04_effect_footprint.bl — an effect is a footprint.
; Run: mix beam_lisp.run --path priv examples/system/04_effect_footprint.bl
;
; An effect is not a rung on a ladder; it is a set of resources, each touched in
; a mode {:R read :A append :W write :S send :K recv :X spawn}. The rung is
; recovered as rank(join of modes) — nothing lost — and the algebra the
; footprint carries IS the guarantees: purity, monotonicity, commutativity, and
; the Separation-Logic frame rule.

(ns example.system.footprint
  (:require [footprint :as fp]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- fpo [s] (fp/fp-walk {} (read1 s)))
(defn- h [t] (println (str "\n── " t " ──")))

(h "the rung is recovered — the footprint model regresses nothing")
(doall (map (fn [s] (println (str "  " s "  →  footprint " (pr-str (fpo s))
                                  "  rung " (fp/rung (fpo s)))))
            ["(deref a)" "(swap! a inc)" "(erlang/send p m)" "(println x)"]))

(h "purity = footprint touches only :R  (refinement: pure ops name no resource)")
(println "  (+ (deref a) (count xs)) →" (pr-str (fpo "(+ (deref a) (count xs))"))
         " pure?" (fp/pure? (fpo "(+ (deref a) (count xs))")))
(println "  (swap! a inc)            →" (pr-str (fpo "(swap! a inc)"))
         " pure?" (fp/pure? (fpo "(swap! a inc)")))

(h "monotonicity = footprint touches only :R/:A  (MVP-F's live-query gate)")
(println "  (datom/transact! conn tx) →" (pr-str (fpo "(datom/transact! conn tx)"))
         " monotone?" (fp/monotone? (fpo "(datom/transact! conn tx)")))
(println "  (swap! cache assoc k v)   →" (pr-str (fpo "(swap! cache assoc k v)"))
         " monotone?" (fp/monotone? (fpo "(swap! cache assoc k v)")))

(h "the frame rule: disjoint resources ⟹ independent, decided structurally")
(def orders  (fpo "(swap! orders conj o)"))
(def balance (fpo "(swap! balance + n)"))
(println "  :orders handler ⋈ :balance handler frame-independent?"
         (fp/frame-independent? orders balance))
(println "\n  → the :orders handler CANNOT break an invariant over :balance —")
(println "    local reasoning, no annotation. This is what makes it SCALE.")
