; examples/system/20_greatest_fixpoint.bl — P19 R2: the greatest-fixpoint dual.
; Run: mix beam_lisp.run --path priv examples/system/20_greatest_fixpoint.bl
;
; datom's recursive rules GROW a set from nothing (reachability, closure). A
; family of verification questions is the DUAL — SHRINK a set from everything
; until it is stable. One driver, `system.gfp/gfp`, hosts them; the per-step
; decision is the caller's. Here: a CTL safe-region and a bisimulation, from the
; same eight-line primitive.

(ns example.system.gfp
  (:require [system.gfp :as gfp]))

(defn- h [t] (println (str "\n── " t " ──")))

; ════════════════════════════════════════════════════════════════════════
; 1. CTL AG: the SAFE REGION. A state is safe iff it is not bad AND all its
; successors are safe — the largest such set is a greatest fixpoint. Model a
; small controller: 0→1→2→3→0 is a healthy cycle; state 4 can slip to 5 (a
; fault); 5 is terminal-bad. The safe region is everything that can never reach 5.
; ════════════════════════════════════════════════════════════════════════

(def succ {0 [1] 1 [2] 2 [3] 3 [0] 4 [2 5] 5 []})

(h "CTL AG¬fault: the provably-safe region")
(def safe (gfp/safe-region [0 1 2 3 4 5] (fn [s] (get succ s [])) (fn [s] (= s 5))))
(println "  safe states:" (sort (into [] safe)))
(println "  4 is unsafe — it can step to the fault; 5 is the fault itself.")
(println "  the 0→1→2→3→0 cycle never reaches 5, so it is provably safe.")

; ════════════════════════════════════════════════════════════════════════
; 2. BISIMULATION: behavioural minimization. Two states are equivalent iff they
; offer the same moves and each move lands in equivalent states. The coarsest
; such relation is a greatest fixpoint over state PAIRS. States that turn out
; equivalent can be merged — the state space shrinks with no behaviour lost.
; ════════════════════════════════════════════════════════════════════════

(def delta {[0 :a] 1 [0 :b] 2 [1 :a] 3 [2 :a] 3 [3 :a] 3})
(defn- labels [s] (into #{} (keep (fn [l] (if (contains? delta [s l]) l nil)) [:a :b])))
(defn- step [s l] (get delta [s l]))

(h "bisimulation: which states are behaviourally identical")
(def bisim (gfp/bisimulation [0 1 2 3] labels step))
(def classes (distinct (map (fn [a] (sort (into [] (keep (fn [b] (if (contains? bisim [a b]) b nil)) [0 1 2 3])))) [0 1 2 3])))
(println "  equivalence classes:" classes)
(println "  states 1,2,3 all do just :a→(a-sink); 0 alone offers :b.")
(println "  the machine minimizes from 4 states to" (count classes) "classes.")

; ════════════════════════════════════════════════════════════════════════
; 3. PROVENANCE: gfp-explained records WHY each element fell, in which round —
; the derivation a hand loop discards. Here, drop numbers a predicate rejects.
; ════════════════════════════════════════════════════════════════════════

(h "provenance: why each element fell")
(def r (gfp/gfp-explained #{1 2 3 4 5}
         (fn [t s] (cond (= 0 (mod t 2)) :even (> t 3) :too-big :else nil))))
(println "  survivors:" (sort (into [] (:fixpoint r))))
(doseq [e (:log r)] (println "   dropped" (:tuple e) "— reason" (:witness e)))

(h "the takeaway")
(println "  One primitive — seed full, keep what survives the current survivors,")
(println "  repeat until stable — is the greatest fixpoint. It is the exact dual")
(println "  of datom's grow-from-nothing recursion, and it hosts CTL safe-regions,")
(println "  bisimulation, and (with a z3 decision) Houdini invariant discovery.")
(println "  The decision is the caller's; the shrink is the engine's.")
