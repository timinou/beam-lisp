; examples/system/27_engine_fixpoints.bl — P23: both fixpoints, one engine.
; Run: mix beam_lisp.run --path priv examples/system/27_engine_fixpoints.bl
;
; datom's recursive rules compute a LEAST fixpoint (grow from nothing:
; reachability, closure). P23 adds the DUAL — a GREATEST fixpoint (seed full,
; shrink to stable) — into the same engine, with the same semi-naive delta. Now
; every fixpoint the verifier needs, least and greatest, is one primitive: one
; optimiser, one result shape (a relation). The verification wrappers
; (safe-region, bisimulation, liveness) are thin surfaces over it.

(ns example.system.engine-fixpoints
  (:require [datom.query.rules :as rules] [datom]))

(defn- h [t] (println (str "\n── " t " ──")))

; a small controller graph: 0→1→2→3→0 healthy cycle; 4 can slip to fault 5.
(def succ {0 [1] 1 [2] 2 [3] 3 [0] 4 [2 5] 5 []})

; ════════════════════════════════════════════════════════════════════════
; LEAST fixpoint — reachability. Grow from a start, adding successors, until
; stable. This is datom's native recursive-rule shape (shown here directly).
; ════════════════════════════════════════════════════════════════════════

(h "least fixpoint: what is reachable from 4 (grow from nothing)")
(defn reach [start]
  (loop [seen #{start} frontier [start]]
    (if (empty? frontier) seen
      (let [nexts (mapcat (fn [s] (get succ s [])) frontier)
            fresh (filter (fn [n] (not (contains? seen n))) nexts)]
        (recur (into seen fresh) fresh)))))
(println "  reachable from 4:" (sort (into [] (reach 4))) "  (4 can reach the fault 5)")

; ════════════════════════════════════════════════════════════════════════
; GREATEST fixpoint — the safe region (CTL AG). Seed EVERYTHING, remove any
; state that is bad or can step to a removed one, until stable. Same engine,
; opposite direction — materialise-gfp, with the semi-naive delta.
; ════════════════════════════════════════════════════════════════════════

(h "greatest fixpoint: the provably-safe region (shrink from everything)")
(def gfp-result
  (rules/derive-gfp #{0 1 2 3 4 5}
    (fn [s S] (and (not (= s 5)) (every? (fn [n] (contains? S n)) (get succ s []))))
    (fn [t fell] (some (fn [n] (contains? fell n)) (get succ t [])))))
(println "  safe states:" (sort (into [] (:relation gfp-result))))
(println "  computed in" (:rounds gfp-result) "rounds," (:checks gfp-result) "checks (semi-naive delta)")
(println "  4 is unsafe (it can reach the fault); the 0→1→2→3 cycle is safe.")

; ════════════════════════════════════════════════════════════════════════
; The two answers are complementary and come from ONE engine. Reachability
; (least) tells you where you CAN go; the safe region (greatest) tells you where
; you can NEVER go wrong. Before P23 only the least fixpoint was native; now the
; greatest is too, so verification's fixpoints stop leaking out of datom.
; ════════════════════════════════════════════════════════════════════════

(h "the takeaway")
(println "  One engine, two directions. Least fixpoint grows from a seed and")
(println "  answers reachability, closure, connected components. Greatest fixpoint")
(println "  shrinks from the full set and answers safe regions, bisimulation, and")
(println "  — with a z3 decision per step — Houdini invariant discovery. Same")
(println "  semi-naive delta accelerates both; both return a relation. The")
(println "  fixpoint the verifier needs no longer lives outside the database.")
