; examples/system/16_real_valued_state.bl — P19: state over the REAL theory.
; Run: mix beam_lisp.run --path priv examples/system/16_real_valued_state.bl
;
; Every rung before this modelled state as an integer. But z3 was never an Int
; solver — the Int-only limit lived in OUR translator (smt.bl), which emitted
; nothing but Int declarations. P19 replaces that with a SORT FUNCTOR: each
; state field's tag-lattice tag picks its z3 theory. A field that inits to a
; FLOAT (0.05) is a `Real`, and the invariant is proven over real arithmetic —
; the same one `verify-process` call, no new checker.

(ns example.system.real
  (:require [system.core :as sys] [z3]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- h [t] (println (str "\n── " t " ──")))
(def port (z3/open))

; ════════════════════════════════════════════════════════════════════════
; An interest-rate account. `rate` inits to 0.05 — a FLOAT — so the functor
; declares it `Real`. The invariant (>= rate 0.0) is a real-arithmetic fact;
; :bump adds a (non-negative) amount, whose sort z3 infers as Real BY FLOW
; because it feeds the Real `rate`. Nothing here is an integer.
; ════════════════════════════════════════════════════════════════════════

(def rated
  "(defserver ^{:invariant (>= rate 0.0)} rated
     (init [b] (ok {:rate 0.05}))
     (handle-call [:bump amt] [_ {:keys [rate]}] :when (>= amt 0.0)
       (reply :ok {:rate (+ rate amt)})))")

(h "a Real-valued invariant, proven over real arithmetic")
(def r (sys/verify-process port (read1 rated)))
(println "  machine:   " (:name r))
(println "  checked:   " (:checked r) "  (rate:Real read from the 0.05 init)")
(println "  □(rate ≥ 0.0) holds:" (:holds r))
(println "  warnings:  " (pr-str (:warnings r)))

; ════════════════════════════════════════════════════════════════════════
; The bug: a :bump with NO (>= amt 0.0) guard. Over the reals, amt could be
; negative and push rate below zero — caught, and the amount input is itself
; a Real (inferred from the field it flows into), so the counterexample is real.
; ════════════════════════════════════════════════════════════════════════

(def buggy
  "(defserver ^{:invariant (>= rate 0.0)} rated2
     (init [b] (ok {:rate 0.05}))
     (handle-call [:bump amt] [_ {:keys [rate]}]
       (reply :ok {:rate (+ rate amt)})))")

(h "an unguarded bump is caught in the Real theory")
(def rb (sys/verify-process port (read1 buggy)))
(println "  holds:    " (:holds rb) "  (an unguarded real amount breaks it)")
(println "  warnings: " (pr-str (:warnings rb)))

(h "the takeaway")
(println "  z3 speaks every theory; the translator now speaks Real. A field is")
(println "  its lattice-inferred SORT — :float → Real — and message amounts")
(println "  inherit the sort of the field they flow into. Same verify-process,")
(println "  new theory, zero new checker code.")
