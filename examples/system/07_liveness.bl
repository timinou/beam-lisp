; examples/system/07_liveness.bl — bounded liveness, honestly labelled.
; Run: mix beam_lisp.run --path priv examples/system/07_liveness.bl
;
; Safety we prove unbounded; liveness ("every request eventually replies") is
; about infinite behaviours, so the practical method is bounded model checking:
; search for a lasso up to depth k. A found lasso is a real violation with a
; witness; no lasso ≤ k is a guarantee UP TO k — registered as APPROXIMATE, so
; "which guarantees are exact vs bounded?" is a query. Honesty is structural.

(ns example.system.liveness
  (:require [system.core :as sys]))

(defn- h [t] (println (str "\n── " t " ──")))
(defn- good-step [s _] (cond (= s :idle) :pending (= s :pending) :replied :else s))
(defn- buggy-step [s input]
  (cond (= s :idle) :pending
        (and (= s :pending) (= input :ok)) :replied
        (and (= s :pending) (= input :retry)) :pending      ; ← spins forever
        :else s))

(h "a good handler: no lasso ≤ 20 → live up to the bound (APPROXIMATE)")
(def gr (sys/find-lasso good-step :any :replied (fn [s] s) :idle 20))
(println "  searched to depth" (:depth gr) ", lasso found?" (:lasso gr))

(h "a buggy handler: :retry spins forever → the lasso is found, with a witness")
(def bad (sys/find-lasso buggy-step :retry :replied (fn [s] s) :idle 20))
(println "  trace:" (pr-str (:trace bad)) ", lasso at depth" (:depth bad))
(println "  → a concrete stuck cycle (:pending → :pending, no :replied). Sound.")

(h "honesty is structural: exact vs approximate is a query")
(sys/register-guarantee! :~replies-eventually
  {:extension :approximate :bound 20 :property "every request replies"})
(sys/register-guarantee! :~balance-nonneg
  {:extension :exact :property "balance ≥ 0 (inductive)"})
(println "  approximate guarantees:" (pr-str (sys/approximate-guarantees)))
(println "  exact guarantees:      " (pr-str (sys/exact-guarantees)))
(println "\n  → no guarantee lies about its own strength.")
