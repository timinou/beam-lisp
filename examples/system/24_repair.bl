; examples/system/24_repair.bl — P21: the checker run backwards (repair).
; Run: mix beam_lisp.run --path priv examples/system/24_repair.bl
;
; The inference phase built a RELATION, not a one-way checker. The same query
; that asks "does this guard preserve the invariant?" runs backwards to ask
; "what guard WOULD?". So a process that fails verification can be REPAIRED: for
; each broken transition, synthesize the weakest guard that fixes it — then
; confirm the fix with the forward checker. Synthesize backward, verify forward.

(ns example.system.repair
  (:require [system.core :as sys] [z3]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- h [t] (println (str "\n── " t " ──")))
(def port (z3/open))

; ════════════════════════════════════════════════════════════════════════
; A bank account with the overdraft bug: :withdraw has no balance guard, so a
; large amount drives the balance negative. verify-process rejects it; repair
; synthesizes the guard it needs.
; ════════════════════════════════════════════════════════════════════════

(def overdraft
  "(defserver ^{:invariant (>= balance 0)} account
     (init [] (ok {:balance 100}))
     (handle-call [:withdraw amt] [_ {:keys [balance]}]
       (reply :ok {:balance (- balance amt)}))
     (handle-call [:deposit amt] [_ {:keys [balance]}] :when (>= amt 0)
       (reply :ok {:balance (+ balance amt)})))")

(h "the broken account fails verification")
(def v (sys/verify-process port (read1 overdraft)))
(println "  holds:   " (:holds v))
(println "  warnings:" (pr-str (:warnings v)))

(h "repair: synthesize the guard each broken transition needs")
(def rep (sys/repair-process port (read1 overdraft)))
(println "  nothing to repair?" (:holds rep))
(doseq [r (:repairs rep)]
  (println "  transition" (:label r) "→ add guard" (pr-str (:guard r))))

; ════════════════════════════════════════════════════════════════════════
; The repair is the WEAKEST sound guard, not just any. abduce would also accept
; (<= amt 0) — "only withdraw non-positive amounts" — which is sound but useless
; (it forbids the whole point). The ranking prefers (<= amt balance), which
; admits every safe withdrawal and only those.
; ════════════════════════════════════════════════════════════════════════

(h "the repair is the most permissive sound guard")
(def rt (sys/repair-transition port (fn [x] (str "(>= " x " 0)")) "balance"
          "(declare-const balance Int)\n(declare-const amt Int)\n"
          "(- balance amt)" (list "balance" "amt" "0")))
(println "  chosen:      " (pr-str (:repair rt)) "  (admits every safe withdrawal)")
(println "  all sound:   " (pr-str (:alternatives rt)))
(println "  rejected the degenerate (<= amt 0) — sound but forbids the useful case")

; ════════════════════════════════════════════════════════════════════════
; The round trip: insert the synthesized guard and the SAME forward checker now
; passes. A repair is only accepted if it verifies.
; ════════════════════════════════════════════════════════════════════════

(def repaired
  "(defserver ^{:invariant (>= balance 0)} account
     (init [] (ok {:balance 100}))
     (handle-call [:withdraw amt] [_ {:keys [balance]}] :when (<= amt balance)
       (reply :ok {:balance (- balance amt)})))")

(h "round trip: the repaired machine verifies")
(def v2 (sys/verify-process port (read1 repaired)))
(println "  with the synthesized guard, holds:" (:holds v2))

(h "the takeaway")
(println "  A checker that is a RELATION runs both ways. Forward it proves a")
(println "  guard sufficient; backward it SYNTHESIZES the guard, and the weakest")
(println "  sound one is the repair. The forward checker confirms it — synthesize")
(println "  backward, verify forward. (The repair is as expressive as its")
(println "  candidate vocabulary: relational (op a b) guards here; a richer")
(println "  vocabulary would synthesize compound guards like (<= (+ r amt) bal).)")
