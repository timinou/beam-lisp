; examples/system/15_type_directed.bl — P18: one checker, every state shape.
; Run: mix beam_lisp.run --path priv examples/system/15_type_directed.bl
;
; The whole P18 thesis in one file: state is the SHAPE the type lattice infers,
; not one integer, and the SAME verify-process adapts by reading each field's
; sort from the init state. This demo runs the one checker across FOUR shapes —
; scalar int, tuple of ints, mixed-sort record, phase-coded variant — plus the
; collection length-abstraction and invariant discovery. One mechanism, the
; whole ladder.

(ns example.system.type-directed
  (:require [system.core :as sys] [z3]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- line [label r]
  (println (str "  " label
                (apply str (repeat (max 1 (- 34 (count label))) " "))
                (if (:holds r) "✓ holds" "✗ FAILS")
                (if (:extension r) (str "   [" (:extension r) "]") ""))))
(def port (z3/open))

(println "── one verify-process, every state shape ──\n")

; Rung 1 (N=1): scalar integer state
(line "scalar int  (balance ≥ 0)"
  (sys/verify-process port
    (read1 "(defserver ^{:invariant (>= balance 0)} a
              (init [balance] (ok balance))
              (handle-call [:withdraw amt] [_ balance] :when (and (>= amt 0) (>= balance amt))
                (reply :ok (- balance amt))))")))

; Rung 1 (N>1): tuple of ints, relational invariant
(line "tuple ints  (balance ≥ reserved)"
  (sys/verify-process port
    (read1 "(defserver ^{:invariant (and (>= reserved 0) (>= balance reserved))} b
              (init [balance reserved] (ok [balance reserved]))
              (handle-call [:withdraw amt] [_ [balance reserved]] :when (and (>= amt 0) (>= (- balance reserved) amt))
                (reply :ok [(- balance amt) reserved])))")))

; Rung 2: mixed-sort record (Int × Bool)
(line "record Int×Bool (frozen ⇒ 0)"
  (sys/verify-process port
    (read1 "(defserver ^{:invariant (or (not frozen) (= balance 0))} c
              (init [balance] (ok {:balance balance :frozen false}))
              (handle-call [:deposit amt] [_ {:keys [balance frozen]}] :when (and (not frozen) (>= amt 0))
                (reply :ok {:balance (+ balance amt) :frozen frozen})))")))

; Rung 4: phase-coded variant (protocol conformance)
(line "variant/phase (send⇒open)"
  (sys/verify-process port
    (read1 "(defserver ^{:invariant (or (not sending) (= phase 1))} d
              (init [] (ok {:phase 0 :sending false}))
              (handle-call [:send] [_ {:keys [phase sending]}] :when (= phase 1)
                (reply :ok {:phase 1 :sending true})))")))

; Rung 3: collection, capacity via length abstraction
(line "collection  (count ≤ 10)"
  (sys/verify-capacity port
    (read1 "(defserver ^{:invariant (<= (count q) 10)} e
              (init [] (ok []))
              (handle-call [:enq x] [_ q] :when (< (count q) 10)
                (reply :ok (conj q x))))")))

; ★ discovery: no annotation at all
(println "")
(println "── ★ invariant discovered from an UN-annotated machine ──")
(def d (sys/discover-invariant port
  (read1 "(defserver f
            (init [] (ok 0))
            (handle-call [:dec] [_ n] :when (> n 0) (reply :ok (- n 1)))
            (handle-call [:inc] [_ n] (reply :ok (+ n 1))))")))
(println (str "  discovered:  " (:discovered d)))

(println "")
(println "── the thesis ──")
(println "  state ≜ ⟦type-lattice⟧, not Int. One verify-process reads each")
(println "  field's sort from the init state and proves the invariant over the")
(println "  whole shape. int · tuple · record · variant · collection · and the")
(println "  invariant itself, discovered. The engines never changed; only the")
(println "  wire from the type phase to the SMT translator was missing.")
