; examples/system/13_protocol_state.bl — P18 Rung 4 / P19 R1a: sum-typed state.
; Run: mix beam_lisp.run --path priv examples/system/13_protocol_state.bl
;
; State carries a TAGGED VARIANT — a connection is :idle | :open | :closed. Two
; kinds of guarantee come out of it, and the engine split is the whole point:
;
;   z3      decides the ARITHMETIC/relational invariant — the session type
;           (sending ⇒ phase = open). Over a z3 DATATYPE, not an integer code:
;           you write :open, there is no idle=0/open=1 legend to drift, and z3's
;           no-junk axiom fences phase to exactly the three tags (an Int encoding
;           would let phase=99 leak in).
;   datalog reasons over the phase GRAPH as code-as-data: which tags are
;           reachable, which are terminal, which are declared-but-dead. Structure
;           is the tag lattice's job, not the solver's.

(ns example.system.protocol
  (:require [system.core :as sys] [system.model :as model] [datom] [z3]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- h [t] (println (str "\n── " t " ──")))
(def port (z3/open))

; ════════════════════════════════════════════════════════════════════════
; A connection protocol. State {:phase <tag>, :sending Bool}. The invariant is
; the session type: you may only be sending while open.
;   open: idle→open · send: stays open, sets sending · close: open→closed.
; phase is written as the KEYWORDS :idle :open :closed — a native z3 datatype.
; ════════════════════════════════════════════════════════════════════════

(def connection
  "(defserver ^{:invariant (or (not sending) (= phase :open))} conn
     (init [] (ok {:phase :idle :sending false}))
     (handle-call [:open]  [_ {:keys [phase sending]}] :when (= phase :idle)
       (reply :ok {:phase :open :sending false}))
     (handle-call [:send]  [_ {:keys [phase sending]}] :when (= phase :open)
       (reply :ok {:phase :open :sending true}))
     (handle-call [:close] [_ {:keys [phase sending]}] :when (= phase :open)
       (reply :ok {:phase :closed :sending false})))")

(h "z3: protocol conformance over a datatype (send only while open)")
(def r (sys/verify-process port (read1 connection)))
(println "  machine:  " (:name r))
(println "  checked:  " (:checked r) "  (phase : E_phase — a z3 datatype, not an Int)")
(println "  □(sending ⇒ phase = :open) holds:" (:holds r))
(println "  warnings: " (pr-str (:warnings r)))

; ── datalog: the phase graph as code-as-data ────────────────────────────
; The transitions form a labelled graph over the tags. Reachability, terminals,
; and dead variants are datalog queries over it — the shipped fixpoint engine.

; wire the injected reachable-from: build a tag-graph db, run REACHABLE.
(def REACH '[[(reach ?a ?b) [?a :edge/to ?b]]
             [(reach ?a ?b) [?a :edge/to ?x] (reach ?x ?b)]])
(defn reachable-from [edges init-tag]
  (let [tags (into [] (distinct (mapcat (fn [e] [(first e) (second e)]) edges)))
        id-of (into {} (map-indexed (fn [i t] [t (- (+ i 1))]) tags))
        out (reduce (fn [m e] (assoc m (get id-of (first e))
                                (conj (or (get m (get id-of (first e))) []) (get id-of (second e)))))
                    {} edges)
        txs (map (fn [t] (let [id (get id-of t) os (get out id)]
                           (if os {:db/id id :tag/name t :edge/to os} {:db/id id :tag/name t})))
                 tags)
        conn (datom/connect [{:db/ident :tag/name :db/valueType :db.type/string}
                             {:db/ident :edge/to :db/valueType :db.type/ref :db/cardinality :db.cardinality/many}])]
    (datom/transact! conn (into [] txs))
    (let [db (datom/db conn)
          start (get (get (into [] (datom/q '[:find ?e :in $ ?n :where [?e :tag/name ?n]] db init-tag)) 0) 0)]
      (if (nil? start) #{}
        (into #{} (map first
                    (datom/q '[:find ?bn :in $ % ?s :where [(reach ?s ?b)] [?b :tag/name ?bn]]
                             db REACH start)))))))

(def sm (model/system-model (read1 connection)))
(def msg-cs (filter (fn [c] (not (= :init (:label c)))) (:transitions sm)))
(def universe #{"idle" "open" "closed"})
(def pa (sys/phase-analysis "phase" universe "idle" msg-cs reachable-from))

(h "datalog: the phase graph, reasoned as code-as-data")
(println "  edges (from→to):" (pr-str (sys/phase-edges "phase" "idle" msg-cs)))
(println "  reachable tags :" (pr-str (:reachable pa)) "  (all three — no dead states)")
(println "  terminal tags  :" (pr-str (:terminal pa)) "  (closed is a sink — correct)")
(println "  dead tags      :" (pr-str (:dead pa)) "  (none — every variant is reachable)")

; ════════════════════════════════════════════════════════════════════════
; The classic protocol bug: a :send from :closed (use-after-close). It sets
; sending=true while phase=closed, violating the session type. z3 catches it.
; ════════════════════════════════════════════════════════════════════════

(def use-after-close
  "(defserver ^{:invariant (or (not sending) (= phase :open))} conn
     (init [] (ok {:phase :idle :sending false}))
     (handle-call [:send] [_ {:keys [phase sending]}] :when (= phase :closed)
       (reply :ok {:phase :closed :sending true})))")

(h "z3: use-after-close is caught")
(doall (map (fn [w] (println w)) (sys/verify-file port "conn.bl" use-after-close)))

(h "the takeaway")
(println "  A variant is a z3 DATATYPE: you write :open, the checker fences the")
(println "  phase to exactly {idle,open,closed} for free, and z3 proves the")
(println "  session type over it. The phase GRAPH — reachable, terminal, dead —")
(println "  is datalog over code-as-data, the same engine deadlock and message")
(println "  coverage use. z3 decides; datalog reasons about structure; neither")
(println "  does the other's job.")
