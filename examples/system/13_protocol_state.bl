; examples/system/13_protocol_state.bl — P18 Rung 4: sum-typed protocol state.
; Run: mix beam_lisp.run --path priv examples/system/13_protocol_state.bl
;
; State is a TAGGED VARIANT — a connection is :idle | :open | :closed. The
; invariant is about LEGAL TRANSITIONS: you may only :send while :open, and
; :closed is terminal. This is protocol / session-type conformance.
;
; The encoding: a variant with a finite tag set is a PHASE, and a phase is an
; integer-coded enum (idle=0, open=1, closed=2). "Legal transition" is then an
; integer relation z3 decides — the SAME Rung-1 machinery over the phase var,
; through the SAME verify-process. No new checker; a variant is just a phase.

(ns example.system.protocol
  (:require [system.core :as sys] [z3]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- h [t] (println (str "\n── " t " ──")))
(def port (z3/open))

; ════════════════════════════════════════════════════════════════════════
; A connection protocol. State {:phase Int, :sending Bool}, phases idle=0,
; open=1, closed=2. The invariant enforces the session type:
;   (or (not sending) (= phase 1))   — "you can only be sending while open"
; open: idle→open · send: stays open, sets sending · close: open→closed.
; ════════════════════════════════════════════════════════════════════════

(def connection
  "(defserver ^{:invariant (or (not sending) (= phase 1))} conn
     (init [] (ok {:phase 0 :sending false}))
     (handle-call [:open]  [_ {:keys [phase sending]}] :when (= phase 0)
       (reply :ok {:phase 1 :sending false}))
     (handle-call [:send]  [_ {:keys [phase sending]}] :when (= phase 1)
       (reply :ok {:phase 1 :sending true}))
     (handle-call [:close] [_ {:keys [phase sending]}] :when (= phase 1)
       (reply :ok {:phase 2 :sending false})))")

(h "protocol conformance: send only while open")
(def r (sys/verify-process port (read1 connection)))
(println "  machine:  " (:name r))
(println "  checked:  " (:checked r) "  (phase = integer-coded variant tag)")
(println "  □(sending ⇒ phase = open) holds:" (:holds r))
(println "  warnings: " (pr-str (:warnings r)))

; ════════════════════════════════════════════════════════════════════════
; The classic protocol bug: a :send that fires from :closed (use-after-close).
; It sets sending=true while phase=closed, violating the session type. Caught.
; ════════════════════════════════════════════════════════════════════════

(def use-after-close
  "(defserver ^{:invariant (or (not sending) (= phase 1))} conn
     (init [] (ok {:phase 0 :sending false}))
     (handle-call [:send] [_ {:keys [phase sending]}] :when (= phase 2)
       (reply :ok {:phase 2 :sending true})))")

(h "use-after-close is caught")
(doall (map (fn [w] (println w)) (sys/verify-file port "conn.bl" use-after-close)))

(h "the takeaway")
(println "  A variant with a finite tag set is a PHASE; a phase is an integer-")
(println "  coded enum; a legal-transition rule is an integer relation. Protocol")
(println "  conformance is Rung 1 over the phase var — same verify-process, no")
(println "  new checker. This is where the refinement machinery (session types,")
(println "  verified hot upgrade) meets sum-typed state.")
