; examples/system/21_clause_facts.bl — P19 R4: the clause topology as data.
; Run: mix beam_lisp.run --path priv examples/system/21_clause_facts.bl
;
; A process is more than its arithmetic. Its DISPATCH — which messages it
; handles, which are total, which fire only under a guard — is pure structure,
; and structure is datalog's job (the engine split: datom = code-as-data, z3 =
; arithmetic decisions). model.bl's clauses become facts; the implicit protocol
; properties are queries over them, no solver involved.

(ns example.system.clause-facts
  (:require [system.facts :as facts] [datom]))

(defn- h [t] (println (str "\n── " t " ──")))
(defn- mk-conn [schema] (datom/connect schema))
(defn- transact [conn fs] (datom/transact! conn fs))
(defn- q-fn [db query & args] (apply datom/q query db args))

; ════════════════════════════════════════════════════════════════════════
; A connection server. :open and :send are guarded (they assume a phase);
; :close is unconditional. The dispatch shape is implicit in the code — we
; read it out as facts and query it.
; ════════════════════════════════════════════════════════════════════════

(def conn-src
  "(defserver conn
     (init [] (ok {:phase :idle}))
     (handle-call [:open] [_ {:keys [phase]}] :when (= phase :idle) (reply :ok {:phase :open}))
     (handle-call [:send] [_ {:keys [phase]}] :when (= phase :open) (reply :ok {:phase :open}))
     (handle-cast [:close] [_ {:keys [phase]}] (noreply {:phase :closed})))")

(def conn (facts/facts-db (first (BeamLisp.Reader/read_string conn-src)) mk-conn transact))
(def db (datom/db conn))
(def rep (facts/dispatch-report db q-fn))

(h "the dispatch topology, read as facts")
(println "  handled labels    :" (pr-str (:handled rep)))
(println "  always fireable    :" (pr-str (:always-fireable rep)) "  (unguarded — total handlers)")
(println "  guarded-only       :" (pr-str (:guarded-only rep)) "  (partial — a sender can be ignored)")

(h "the guard preconditions — the spec nobody wrote down")
(doseq [pair (:preconditions rep)]
  (println "  " (first pair) "requires" (pr-str (second pair))))

(h "a raw datalog query over the same facts")
(println "  labels with a phase-guard:"
         (pr-str (into #{} (map first
                    (q-fn db '[:find ?l :where [?c :clause/label ?l]
                                              [?c :clause/guard ?g]])))))

(h "the takeaway")
(println "  Dispatch, guards, and patterns are STRUCTURE, so they are datalog —")
(println "  the same engine deadlock and message-coverage already use. The guard")
(println "  preconditions are the process's real precondition spec, extracted")
(println "  from the :when clauses rather than annotated. z3 never runs here;")
(println "  structure is not its job.")
