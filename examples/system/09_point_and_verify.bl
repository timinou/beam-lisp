; examples/system/09_point_and_verify.bl — the whole tier in one call.
; Run: mix beam_lisp.run --path priv --path priv/datom examples/system/09_point_and_verify.bl
;
; This is what the system-model tier is FOR: you write an ordinary defserver,
; annotate its name with ^{:invariant …}, and the checker does the rest —
; extract the transitions, translate the guards to SMT, prove the invariant
; holds for every state and input, and render any failure like a normal
; compiler warning. No hand-written SMT, no separate spec file, no TLA+.

(ns example.system.point-and-verify
  (:require [system.core :as sys] [system.model :as model] [z3] [datom]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- h [t] (println (str "\n── " t " ──")))
(def port (z3/open))

; ════════════════════════════════════════════════════════════════════════
; A correct bank account. The ONLY thing that makes it verifiable is the
; ^{:invariant} annotation on the name — everything else is an ordinary server.
; ════════════════════════════════════════════════════════════════════════

(def account
  "(defserver ^{:invariant (>= balance 0)} account
     (init [balance] (ok balance))
     (handle-call [:deposit amt]  [_ balance] :when (>= amt 0)
       (reply :ok (+ balance amt)))
     (handle-call [:withdraw amt] [_ balance] :when (and (>= amt 0) (>= balance amt))
       (reply :ok (- balance amt))))")

(h "point the checker at the annotated server")
(def r (sys/verify-process port (read1 account)))
(println "  machine:  " (:name r))
(println "  checked:  " (:checked r) "  (it has an ^{:invariant})")
(println "  □(balance ≥ 0) holds:" (:holds r) "  — proven for every balance and amount")
(println "  warnings: " (pr-str (:warnings r)))

; ════════════════════════════════════════════════════════════════════════
; The same server with one guard removed. The checker catches it and renders
; the failure as a normal file:line:col warning.
; ════════════════════════════════════════════════════════════════════════

(def buggy
  "(defserver ^{:invariant (>= balance 0)} account
     (init [balance] (ok balance))
     (handle-call [:withdraw amt] [_ balance] (reply :ok (- balance amt))))")

(h "remove the withdraw guard — the checker renders the failure")
(doall (map (fn [w] (println w)) (sys/verify-file port "account.bl" buggy)))

; ════════════════════════════════════════════════════════════════════════
; Message coverage: a message SENT to the server that it does not handle is a
; latent crash, found from the whole call graph — the check only we can do.
; ════════════════════════════════════════════════════════════════════════

(h "whole-program message coverage")
(def cs (model/transitions (read1 account)))
(println "  the server handles: " (pr-str (sys/handled-labels cs)))
(println "  a caller sends :deposit, :withdraw, and :close …")
(println "  unhandled (latent FunctionClauseError):"
         (pr-str (sys/unhandled-messages cs #{:deposit :withdraw :close})))
(println "\n  → TLA+ cannot do this: it has no callers. We check the model against")
(println "    the very code that calls it — one join over the call graph.")

(h "the takeaway")
(println "  Verification is a property of the beam-lisp EVALUATOR. You wrote an")
(println "  ordinary defserver; one annotation made it verifiable; every process")
(println "  form that lowers to receive/loop/clauses inherits the same battery.")
