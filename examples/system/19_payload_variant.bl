; examples/system/19_payload_variant.bl — P19 R1b: sum type WITH payload.
; Run: mix beam_lisp.run --path priv examples/system/19_payload_variant.bl
;
; A variant arm can carry data. The whole surface is structural — no reserved
; key, no type declaration:
;   :paused        a NULLARY arm — the tag is the keyword itself
;   {:on 7}        a PAYLOAD arm — the single key is the tag, its value the data
; A field that holds either shape is a sum type; the checker reads the arms from
; the code and builds the z3 algebraic datatype. Discriminant and accessor are
; ordinary bl map ops — (some? (:on mode)) is "the :on arm is present",
; (:on mode) is its payload — so the invariant reads and RUNS as plain bl, and
; verifies as z3.

(ns example.system.payload
  (:require [system.core :as sys] [z3]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- h [t] (println (str "\n── " t " ──")))
(def port (z3/open))

; ════════════════════════════════════════════════════════════════════════
; A dimmer. State `mode` is :paused OR {:on <level>}. The invariant couples the
; discriminant to the payload: WHEN on, the level is non-negative.
;   (or (not (some? (:on mode)))   ; not the :on arm — vacuously ok
;       (>= (:on mode) 0))         ; or the on-level is ≥ 0
; turn-on is guarded (>= lvl 0); pause returns to the nullary arm.
; ════════════════════════════════════════════════════════════════════════

(def dial
  "(defserver ^{:invariant (or (not (some? (:on mode))) (>= (:on mode) 0))} dial
     (init [] (ok {:mode :paused}))
     (handle-call [:turn-on lvl] [_ {:keys [mode]}] :when (>= lvl 0)
       (reply :ok {:mode {:on lvl}}))
     (handle-call [:pause] [_ {:keys [mode]}]
       (reply :ok {:mode :paused})))")

(h "a payload variant, proven over a z3 datatype")
(def r (sys/verify-process port (read1 dial)))
(println "  machine:  " (:name r))
(println "  checked:  " (:checked r) "  (mode : E_mode = paused | (on Int))")
(println "  □(on ⇒ level ≥ 0) holds:" (:holds r))
(println "  warnings: " (pr-str (:warnings r)))

; ════════════════════════════════════════════════════════════════════════
; The bug: turn-on with NO (>= lvl 0) guard. A negative level can enter the
; :on arm, breaking the coupling. Caught — over the datatype accessor, not an
; integer stand-in.
; ════════════════════════════════════════════════════════════════════════

(def buggy
  "(defserver ^{:invariant (or (not (some? (:on mode))) (>= (:on mode) 0))} dial2
     (init [] (ok {:mode :paused}))
     (handle-call [:turn-on lvl] [_ {:keys [mode]}]
       (reply :ok {:mode {:on lvl}})))")

(h "an unguarded turn-on is caught")
(def rb (sys/verify-process port (read1 buggy)))
(println "  holds:    " (:holds rb) "  (a negative level can enter :on)")
(println "  warnings: " (pr-str (:warnings rb)))

; ════════════════════════════════════════════════════════════════════════
; The discriminant is total in plain bl too: (:on :paused) is nil, so
; (some? (:on mode)) is false on the nullary arm. The invariant is ordinary
; bl code — it evaluates AND it verifies, the same text.
; ════════════════════════════════════════════════════════════════════════

(h "the same invariant runs as ordinary bl")
(def inv (fn [mode] (or (not (some? (:on mode))) (>= (:on mode) 0))))
(println "  (inv :paused)   =>" (inv :paused)   "  (nullary arm — vacuously true)")
(println "  (inv {:on 5})   =>" (inv {:on 5})   "  (on, level 5 — true)")
(println "  (inv {:on -1})  =>" (inv {:on -1})  "  (on, level -1 — false, the bug)")

(h "the takeaway")
(println "  One structural scheme spans the whole sum-type story: a keyword is a")
(println "  nullary arm, a single-key map is a payload arm, an all-nullary field")
(println "  is the enum (demo 13). Discriminant and accessor are plain bl map ops")
(println "  that already mean the right thing, so a verified invariant is just an")
(println "  invariant you could have written anyway. z3's no-junk axiom fences")
(println "  the field to exactly its arms; the accessor is total under the guard.")
