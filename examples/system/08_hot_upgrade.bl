; examples/system/08_hot_upgrade.bl — refinement & VERIFIED HOT UPGRADE.
; Run: mix beam_lisp.run --path priv examples/system/08_hot_upgrade.bl
;
; Refinement: concrete C implements abstract A via a simulation relation R that
; related states preserve. When C refines A, every property proven on A
; transfers to C for free. The crown is a property almost no system checks:
; correctness ACROSS a hot code upgrade — code_change is just another
; transition the simulation relation must respect.

(ns example.system.hot-upgrade
  (:require [system.core :as sys] [z3]))

(defn- h [t] (println (str "\n── " t " ──")))
(def port (z3/open))
(defn- inv [v] (str "(>= " v " 0)"))

(h "optimization: a batched counter refines the simple one")
(def R (fn [a c] (str "(= " a " " c ")")))
(println "  batched tick c+1 simulates abstract tick n+1 under R(n,c)=(n=c):"
         (sys/simulates? port R "(declare-const n Int)\n(declare-const c Int)\n"
                         "n" "c" "(+ n 1)" "(+ c 1)" nil))
(println "  → so balance≥0 and every property proven on the SIMPLE counter transfers.")

(h "protocol conformance: a connection refines the open/close protocol")
(def d2 "(declare-const phase Int)\n(declare-const cphase Int)\n")
(println "  the connection's phase tracks the protocol on open:"
         (sys/simulates? port (fn [a c] (str "(= " a " " c ")")) d2 "phase" "cphase"
                         "1" "1" "(assert (= phase 0))\n(assert (= cphase 0))"))
(println "  → it can NEVER emit a message out of order. The abstract machine IS")
(println "    the session type.")

(h "VERIFIED HOT UPGRADE — code_change from v1 {:balance} to v2 {:balance :currency}")
(def d3 "(declare-const b1 Int)\n(declare-const b2 Int)\n(declare-const amt Int)\n")
(println "  1. migration b2 := b1 preserves balance ≥ 0:"
         (sys/migration-preserves? port inv d3 "b1" "b2" "b1"))
(println "  2. v2.withdraw simulates v1.withdraw (observable balance identical):"
         (sys/simulates? port R d3 "b1" "b2" "(- b1 amt)" "(- b2 amt)"
                         "(assert (>= b1 amt))\n(assert (>= amt 0))"))
; a broken migration that zeroes the balance keeps the LOCAL invariant but
; breaks the SIMULATION relation R(v1,v2) — refinement catches it.
(def broken-smt
  "(declare-const b1 Int)\n(declare-const b2 Int)\n(assert (>= b1 0))\n(assert (= b2 0))\n(assert (not (= b1 b2)))\n")
(println "  3. a migration that zeroes the balance is caught:"
         (= "sat" (z3/check port broken-smt)))
(println "\n  → the hot upgrade is VERIFIED end to end. code_change preserves R, v2")
(println "    simulates v1, and balance≥0 — proven on v1 — survives the LIVE swap.")
(println "    A wrong migration is rejected BEFORE it ships, the process never")
(println "    stopping. This is the guarantee the BEAM's signature feature lacked.")
