; examples/system/25_content_invariant.bl — P22: content, not just count.
; Run: mix beam_lisp.run --path priv examples/system/25_content_invariant.bl
;
; verify-capacity proves how MANY items a collection holds. verify-content
; proves WHAT it holds — here, that a set stays DUPLICATE-FREE. The collection
; is a z3 Array; distinctness is ∀ i<j. a[i] ≠ a[j], established by the empty
; init and preserved by an append guarded on freshness. This is the element-
; level reasoning length-abstraction is blind to.

(ns example.system.content
  (:require [system.core :as sys] [z3]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- h [t] (println (str "\n── " t " ──")))
(def port (z3/open))

; ════════════════════════════════════════════════════════════════════════
; A unique-set: :add x only when x is not already present. The freshness guard
; (not (includes? items x)) is exactly how you'd write "add if absent", and it
; is what makes distinctness inductive.
; ════════════════════════════════════════════════════════════════════════

(def uniqueset
  "(defserver ^{:invariant true} uniqset
     (init [] (ok {:items []}))
     (handle-call [:add x] [_ {:keys [items]}] :when (not (includes? items x))
       (reply :ok {:items (conj items x)})))")

(h "a freshness-guarded set stays duplicate-free")
(def r (sys/verify-content port (read1 uniqueset)))
(println "  machine:  " (:name r))
(println "  checked:  " (:checked r) "  (items : Array Int Int)")
(println "  distinct (no duplicates ever) holds:" (:holds r))
(println "  guarantee:" (:extension r) "  (quantified array reasoning — sound but not always decidable)")

; ════════════════════════════════════════════════════════════════════════
; Remove the freshness guard and the same :add can insert a value already in
; the set — a duplicate. verify-content catches it; length-abstraction never
; could, because the LENGTH is fine, only the CONTENT is wrong.
; ════════════════════════════════════════════════════════════════════════

(def dupset
  "(defserver ^{:invariant true} dupset
     (init [] (ok {:items []}))
     (handle-call [:add x] [_ {:keys [items]}]
       (reply :ok {:items (conj items x)})))")

(h "an unguarded add can insert a duplicate — caught")
(def rb (sys/verify-content port (read1 dupset)))
(println "  distinct holds:" (:holds rb))
(println "  warnings:      " (pr-str (:warnings rb)))

(h "the takeaway")
(println "  A collection is a z3 Array, not a length. 'No duplicates' is a")
(println "  content invariant — ∀ i<j. a[i] ≠ a[j] — proven over the elements.")
(println "  The freshness guard is what makes it inductive; without it, z3 finds")
(println "  the value that collides. Length says how big; the Array says what's")
(println "  inside. Gap 1, closed by the theory that was always in the solver.")
