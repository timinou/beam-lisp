; examples/system/23_composition.bl — P20: the composition flywheel.
; Run: mix beam_lisp.run --path priv examples/system/23_composition.bl
;
; Each process's guarantees — its dispatch, its guard preconditions, its
; invariant — are computed by separate checks, and each answers a WITHIN-process
; question. The questions that matter across a system are CROSS-cutting:
;   · which send hits a guarded precondition the sender must satisfy?
;   · which send is dropped because the receiver doesn't handle it?
;   · which send could break the RECEIVER'S invariant?
; None is answerable by a single-process check. Project every guarantee into ONE
; datom relation and each becomes a datalog JOIN.

(ns example.system.composition
  (:require [system.knowledge :as k] [datom]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- h [t] (println (str "\n── " t " ──")))
(defn- mk-conn [schema] (datom/connect schema))
(defn- transact [conn fs] (datom/transact! conn fs))
(defn- q-fn [db query & args] (apply datom/q query db args))

; ════════════════════════════════════════════════════════════════════════
; Two processes. An ACCOUNT with the invariant balance ≥ 0: :withdraw is
; guarded (balance ≥ amt), :deposit is total. A LEDGER that only logs. A CLIENT
; wires sends to both — including a :withdraw (guarded), a :close (unhandled by
; account), and a :log (handled by ledger).
; ════════════════════════════════════════════════════════════════════════

(def account
  "(defserver ^{:invariant (>= balance 0)} account
     (init [] (ok {:balance 100}))
     (handle-call [:withdraw amt] [_ {:keys [balance]}] :when (>= balance amt)
       (reply :ok {:balance (- balance amt)}))
     (handle-call [:deposit amt] [_ {:keys [balance]}]
       (reply :ok {:balance (+ balance amt)})))")

(def ledger
  "(defserver ledger
     (init [] (ok {:count 0}))
     (handle-cast [:log entry] [_ {:keys [count]}]
       (noreply {:count (+ count 1)})))")

(def sends
  [["client" "account" :withdraw]     ; guarded — sender must ensure balance ≥ amt
   ["client" "account" :deposit]      ; total — always safe
   ["client" "account" :close]        ; UNHANDLED by account — dropped
   ["client" "ledger"  :log]])        ; handled by ledger

(def conn (k/knowledge [(read1 account) (read1 ledger)] sends mk-conn transact))
(def db (datom/db conn))

(h "sends that hit a GUARDED precondition (sender must establish it)")
(doseq [g (k/guarded-sends db q-fn)]
  (println "  " (:from g) "→" (:to g) (:label g) "requires" (pr-str (:guard g))))

(h "sends that are DROPPED (receiver has no handler)")
(doseq [u (k/unhandled-sends db q-fn)]
  (println "  " (:from u) "→" (:to u) (:label u) "— no handler, silently dropped"))

(h "the composition: sends that could break the RECEIVER'S invariant")
(doseq [x (k/invariant-bearing-guarded-sends db q-fn)]
  (println "  " (:from x) "→" (:to x) (:label x))
  (println "      guard:    " (pr-str (:guard x)))
  (println "      protects: " (pr-str (:receiver-invariant x)) "— violate the guard, break this"))

(h "a raw cross-cutting datalog query")
(println "  processes carrying an invariant:")
(doseq [p (k/processes-with-invariant db q-fn)]
  (println "   " (:process p) "guarantees" (pr-str (:invariant p))))

(h "the takeaway")
(println "  Dispatch, guards, and invariants were separate within-process checks.")
(println "  Projected into ONE relation they JOIN: 'which send could break the")
(println "  receiver's invariant' is (send × receiver-clause × guard × invariant)")
(println "  — a datalog query, not a new checker. Each capability added joins with")
(println "  every prior one: N guarantees, N² questions, for the cost of projection.")
