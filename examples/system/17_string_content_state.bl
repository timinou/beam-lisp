; examples/system/17_string_content_state.bl — P19: state over the STRING theory.
; Run: mix beam_lisp.run --path priv examples/system/17_string_content_state.bl
;
; Length-abstraction (Rung 3) could say "the queue holds ≤ 10 items" but never
; anything about the CONTENT. z3's String theory reasons about actual text:
; concatenation, containment, prefixes, length. The sort functor declares a
; field that inits to a STRING as `String`, and bl's string calls map to the
; SMT str.* operators — so a message-format invariant on real content is proven.

(ns example.system.strings
  (:require [system.core :as sys] [z3]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- h [t] (println (str "\n── " t " ──")))
(def port (z3/open))

; ════════════════════════════════════════════════════════════════════════
; An audit log whose `last` entry must always carry the "evt:" prefix. State
; is a String (inits to "evt:init"); the append transition prepends the prefix
; to whatever body arrives, so the prefix invariant is preserved. The invariant
; (str-prefix? "evt:" last) becomes (str.prefixof "evt:" last) — real strings.
; ════════════════════════════════════════════════════════════════════════

(def log
  "(defserver ^{:invariant (str-prefix? \"evt:\" last)} auditlog
     (init [] (ok {:last \"evt:init\"}))
     (handle-cast [:append body] [_ {:keys [last]}]
       (noreply {:last (str \"evt:\" body)})))")

(h "a string-content invariant, proven over the String theory")
(def r (sys/verify-process port (read1 log)))
(println "  machine:   " (:name r))
(println "  checked:   " (:checked r) "  (last:String read from the \"evt:init\" init)")
(println "  □(\"evt:\" is a prefix of last) holds:" (:holds r))
(println "  warnings:  " (pr-str (:warnings r)))

; ════════════════════════════════════════════════════════════════════════
; The bug: an append that stores the raw body WITHOUT the prefix. Now `last`
; can be any string, breaking the prefix invariant — caught over real strings,
; not a length approximation.
; ════════════════════════════════════════════════════════════════════════

(def buggy
  "(defserver ^{:invariant (str-prefix? \"evt:\" last)} auditlog2
     (init [] (ok {:last \"evt:init\"}))
     (handle-cast [:append body] [_ {:keys [last]}]
       (noreply {:last body})))")

(h "an append that drops the prefix is caught")
(def rb (sys/verify-process port (read1 buggy)))
(println "  holds:    " (:holds rb) "  (raw body need not start with evt:)")
(println "  warnings: " (pr-str (:warnings rb)))

(h "the takeaway")
(println "  Content, not count. (str-prefix? …) → (str.prefixof …), (str a b) →")
(println "  (str.++ …), (str-len s) → (str.len s). The message body is a String")
(println "  input, and the format invariant is proven on the actual text. This")
(println "  is the collection-content frontier (Gap 1), reached through a theory")
(println "  that was always in the solver — we just weren't emitting it.")
