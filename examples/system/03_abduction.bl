; examples/system/03_abduction.bl — auto-strengthen a non-inductive invariant.
; Run: mix beam_lisp.run --path priv --path priv/datom examples/system/03_abduction.bl
;
; When an invariant is true but not inductive, three engines cooperate with
; strict non-overlap: miniKanren ENUMERATES candidate preconditions, z3 DECIDES
; which are sufficient, datalog DISCHARGES them against the call graph — the
; check only we can do (TLA+ has no callers).

(ns example.system.abduction
  (:require [system.core :as sys] [z3] [datom]))

(defn- h [t] (println (str "\n── " t " ──")))
(def port (z3/open))
(defn- inv [v] (str "(>= " v " 0)"))
(def decls "(declare-const balance Int)\n(declare-const amt Int)\n")

(h "abduce the missing precondition for an unguarded withdraw")
(def ps (sys/abduce port inv "balance" decls nil "(- balance amt)" '[balance amt 0]))
(println "  miniKanren enumerated, z3 decided.")
(println "  sufficient preconditions (shortest first):" (pr-str (take 3 ps)))
(println "  → e.g." (pr-str (first ps)) "— a non-positive withdrawal cannot overdraw.")

(h "domain-relative honesty: too small a vocabulary → no fabricated proof")
(def none (sys/abduce port inv "balance" decls nil "(- balance amt)" '[amt]))
(println "  candidates over {amt} only:" (pr-str none) "— nothing, honestly.")
(println "  widen to {balance amt 0}:  " (pr-str (take 1 ps)) "— the fix appears.")

(h "the discharge only we can do: does every SENDER already guarantee it?")
(def conn (datom/connect
            [{:db/ident :call/callee :db/valueType :db.type/keyword}
             {:db/ident :call/guarantees :db/valueType :db.type/string}]))
(datom/transact! conn
  [{:db/id -1 :call/callee :withdraw :call/guarantees "(>= balance amt)"}
   {:db/id -2 :call/callee :withdraw :call/guarantees "(>= balance amt)"}])
(defn- q3 [query db & args] (apply datom/q query db args))
(println "  all callers guarantee (>= balance amt):"
         (sys/all-senders-guarantee? (datom/db conn) q3 :withdraw "(>= balance amt)")
         "→ NO annotation needed.")
(datom/transact! conn [{:db/id -3 :call/callee :withdraw}])
(println "  after one careless caller:"
         (sys/all-senders-guarantee? (datom/db conn) q3 :withdraw "(>= balance amt)")
         "→ the exact site is found.")
(println "\n  → TLA+ cannot do this: it has no callers. We have the whole call graph.")
