; examples/system/01_extraction.bl — a process IS a transition relation.
; Run: mix beam_lisp.run --path priv examples/system/01_extraction.bl
;
; The load-bearing idea of the system-model tier: verification attaches to the
; PRIMITIVES (receive / loop-recur / clauses / guards / defmulti / defserver),
; not to any macro. So the same counter machine — written three different ways
; — lowers to the IDENTICAL transition graph. Verification written once over
; that graph is inherited by every form, defserver included, unchanged.

(ns example.system.extraction
  (:require [system.model :as model]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- h [t] (println (str "\n── " t " ──")))

; the counter machine: inc → n+1 ; dec (when n>0) → n-1 ; reset → 0
(def as-loop
  "(loop [n n]
     (receive
       [:inc]              (recur (+ n 1))
       [:dec] :when (> n 0) (recur (- n 1))
       [:reset]            (recur 0)))")

(def as-server
  "(defserver counter
     (init [n] (ok n))
     (handle-call [:inc]  [_from n] (reply :ok (+ n 1)))
     (handle-call [:dec]  [_from n] :when (> n 0) (reply :ok (- n 1)))
     (handle-call [:reset] [_from n] (reply :ok 0)))")

(def as-methods
  ["(defmethod step :inc  [n _] (+ n 1))"
   "(defmethod step :dec  [n _] (- n 1))"
   "(defmethod step :reset [n _] 0)"])

(h "three surface forms, one machine")
(defn- msg-graph [cs]
  (model/graph (filter (fn [c] (not (= :init (:label c)))) cs)))

(def gl (msg-graph (model/transitions (read1 as-loop))))
(def gs (msg-graph (model/transitions (read1 as-server))))
(def gm (msg-graph (model/extract-defmethods (map read1 as-methods))))

(println "  raw receive-loop:  " (pr-str gl))
(println "  defserver (OTP):   " (pr-str gs))
(println "  defmulti dispatch: " (pr-str gm))
(println "  all three identical:" (and (= gl gs) (= gl gm)))

(h "the guard is reported where the source writes it — never fabricated")
(def loop-cs (model/transitions (read1 as-loop)))
(doall (map (fn [c]
              (println (str "  " (:label c) " → " (:next c)
                            (if (:guard c) (str "   [when " (:guard c) "]") ""))))
            loop-cs))

(h "the naming trichotomy — every machine has a stable identity")
(println "  defserver, by binding:      " (:name (model/system-model (read1 as-server))))
(println "  anonymous loop, content-hash:" (:name (model/system-model (read1 as-loop))))
(println "\n  → verification is written ONCE over the transition graph; every")
(println "    dispatch form inherits it. defserver gets the whole battery, unchanged.")
