; examples/system/28_invariant_clause.bl — the (invariant …) clause, verified.
; Run: mix beam_lisp.run --path priv examples/system/28_invariant_clause.bl
;
; The ^{:invariant …} name meta (example 09) made a server verifiable. The
; (invariant [s] pred) CLAUSE is the same check in the defserver's own clause
; dialect — and `system.core/verify` takes a quoted name and does everything:
; find the file, read the form, open z3, prove, report.

(ns example.system.invariant-clause
  (:require [system.core :as sys] [z3]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- h [t] (println (str "\n── " t " ──")))

(h "verify by quoted name: 'examples.guards/account")
; The account server in examples/guards.bl carries
;   (invariant [balance] (>= balance 0))
; One call resolves ns → file → form → proof:
(println "  (sys/verify 'examples.guards/account) →"
         (sys/verify 'examples.guards/account))

(h "the clause's binder is its own name for the state")
; init names the state `balance`; the clause calls it `b`. verify-process
; substitutes the init's name before translating — the clause author names
; the state whatever reads best.
(def port (z3/open))
(def good
  "(defserver wallet
     (init [balance] (ok balance))
     (invariant [b] (>= b 0))
     (handle-call [:spend n] :when (and (>= n 0) (>= balance n)) [_ balance]
       (reply :ok (- balance n))))")
(def r (sys/verify-process port (read1 good)))
(println "  checked:" (:checked r) "  □(b ≥ 0) holds:" (:holds r)
         " — binder `b` substituted for `balance` and proven")

(h "a buggy server with the clause is CAUGHT")
(def buggy
  "(defserver wallet
     (init [balance] (ok balance))
     (invariant [b] (>= b 0))
     (handle-call [:spend n] :when (>= n 0) [_ balance]
       (reply :ok (- balance n))))")
(doall (map (fn [w] (println w)) (sys/verify-file port "wallet.bl" buggy)))

(h "the meta spelling still verifies (same engine, both spellings)")
(def meta-good
  "(defserver ^{:invariant (>= balance 0)} wallet
     (init [balance] (ok balance))
     (handle-call [:spend n] :when (and (>= n 0) (>= balance n)) [_ balance]
       (reply :ok (- balance n))))")
(def mr (sys/verify-process port (read1 meta-good)))
(println "  ^{:invariant} meta — checked:" (:checked mr) "  holds:" (:holds mr))

(h "honest negatives")
(println "  unknown name →" (sys/verify 'no.such/process)
         " (source not found: :unchecked, never a silent pass)")
(def plain
  "(defserver ticker
     (init [n] (ok n))
     (handle-call :tick [_ n] (reply n (inc n))))")
(def pr (sys/verify-process port (read1 plain)))
(println "  no invariant at all → checked:" (:checked pr)
         " (the checker stays silent on what it cannot model)")

(println "\n  → one clause in the server, one call at the gate: □Inv proven")
(println "    from source, before the process ever boots.")
:ok
