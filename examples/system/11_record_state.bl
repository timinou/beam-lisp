; examples/system/11_record_state.bl — P18 Rung 2: record / mixed-sort state.
; Run: mix beam_lisp.run --path priv examples/system/11_record_state.bl
;
; Rung 1 was a tuple of ints. Rung 2 is a RECORD whose fields have DIFFERENT
; sorts — an int `balance` AND a bool `frozen` — with an invariant that couples
; them across sorts. The realization: smt.bl already emits true/false and
; not/and/or; the ONLY type-directed change is each field's z3 sort. Same one
; call, same annotation; the checker reads each field's sort from the init
; record and proves the invariant over the whole mixed-sort state at once.

(ns example.system.record
  (:require [system.core :as sys] [z3]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- h [t] (println (str "\n── " t " ──")))
(def port (z3/open))

; ════════════════════════════════════════════════════════════════════════
; A freezable vault. State is {:balance Int, :frozen Bool}. The invariant
; couples the two sorts:  (or (not frozen) (= balance 0))  — "a frozen vault
; is empty". deposit is guarded by (not frozen); freeze is guarded by an empty
; balance. Both must keep the cross-sort coupling.
; ════════════════════════════════════════════════════════════════════════

(def vault
  "(defserver ^{:invariant (or (not frozen) (= balance 0))} vault
     (init [balance] (ok {:balance balance :frozen false}))
     (handle-call [:deposit amt] [_ {:keys [balance frozen]}] :when (and (not frozen) (>= amt 0))
       (reply :ok {:balance (+ balance amt) :frozen frozen}))
     (handle-call [:freeze] [_ {:keys [balance frozen]}] :when (= balance 0)
       (reply :ok {:balance balance :frozen true})))")

(h "a mixed-sort (Int × Bool) invariant, proven jointly")
(def r (sys/verify-process port (read1 vault)))
(println "  machine:  " (:name r))
(println "  checked:  " (:checked r) "  (fields balance:Int, frozen:Bool read from init)")
(println "  □(frozen ⇒ balance = 0) holds:" (:holds r))
(println "  warnings: " (pr-str (:warnings r)))

; ════════════════════════════════════════════════════════════════════════
; The bug: a deposit that ignores the freeze (no (not frozen) guard). It can
; add to a frozen vault, breaking (frozen ⇒ balance = 0). Caught and rendered.
; ════════════════════════════════════════════════════════════════════════

(def buggy
  "(defserver ^{:invariant (or (not frozen) (= balance 0))} vault
     (init [balance] (ok {:balance balance :frozen false}))
     (handle-call [:deposit amt] [_ {:keys [balance frozen]}] :when (>= amt 0)
       (reply :ok {:balance (+ balance amt) :frozen frozen})))")

(h "a deposit that ignores the freeze is caught")
(doall (map (fn [w] (println w)) (sys/verify-file port "vault.bl" buggy)))

(h "the takeaway")
(println "  A field is its lattice-inferred SORT, not always Int. The bool")
(println "  `frozen` and the int `balance` are proven together — one define-fun")
(println "  over a mixed-sort state. Rung 2: type-directed SMT translation.")
