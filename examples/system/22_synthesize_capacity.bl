; examples/system/22_synthesize_capacity.bl — P19 R5: the verifier run backwards.
; Run: mix beam_lisp.run --path priv examples/system/22_synthesize_capacity.bl
;
; verify-capacity CHECKS a capacity you wrote: "does (count items ≤ 10) hold?"
; synthesize-capacity DISCOVERS the tightest one: it searches for the smallest k
; that is inductive (established at init, preserved by every transition). Because
; k-inductiveness is monotone — if k is safe, k+1 is — the smallest inductive k
; is the exact capacity. The annotation stops being an input and becomes output.

(ns example.system.synth
  (:require [system.core :as sys] [z3]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- h [t] (println (str "\n── " t " ──")))
(def port (z3/open))

; ════════════════════════════════════════════════════════════════════════
; A work queue guarded to accept only while it holds fewer than 5 items. No
; capacity is written anywhere — the guard (< (count items) 5) is the only clue,
; and synthesis reads the tightest bound OUT of it.
; ════════════════════════════════════════════════════════════════════════

(def bounded
  "(defserver q5
     (init [] (ok {:items []}))
     (handle-call [:enq x] [_ {:keys [items]}] :when (< (count items) 5)
       (reply :ok {:items (conj items x)}))
     (handle-call [:deq] [_ {:keys [items]}] :when (not (empty? items))
       (reply :ok {:items (rest items)})))")

(h "synthesize the capacity — no annotation")
(def r (sys/synthesize-capacity port (read1 bounded)))
(println "  machine:      " (:name r))
(println "  bounded:      " (:bounded r))
(println "  SYNTHESIZED capacity:" (:synthesized r) "  (guard admits at count<5, then +1 → max 5)")

; ════════════════════════════════════════════════════════════════════════
; The same queue with the guard removed: enqueue always accepts. Now the length
; can grow without bound, and synthesis says so — it returns no finite k rather
; than a plausible-but-wrong number.
; ════════════════════════════════════════════════════════════════════════

(def unbounded
  "(defserver qinf
     (init [] (ok {:items []}))
     (handle-call [:enq x] [_ {:keys [items]}]
       (reply :ok {:items (conj items x)})))")

(h "an unguarded queue has no finite capacity")
(def r2 (sys/synthesize-capacity port (read1 unbounded)))
(println "  bounded:      " (:bounded r2))
(println "  synthesized:  " (:synthesized r2) "  (nil — honestly unbounded, not a guess)")

(h "the takeaway")
(println "  The typing phase built a RELATION, not a one-way checker: the same")
(println "  inductiveness query that PROVES an annotated bound also SEARCHES for")
(println "  the tightest bound when none is written. Run it forwards to check,")
(println "  backwards to synthesize. The capacity that used to be an annotation")
(println "  is now a result — and an unbounded machine is reported, never faked.")
