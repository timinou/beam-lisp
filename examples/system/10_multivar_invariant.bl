; examples/system/10_multivar_invariant.bl — P18 Rung 1: relational invariants.
; Run: mix beam_lisp.run --path priv examples/system/10_multivar_invariant.bl
;
; The P17 seam modelled state as ONE integer. This is the first rung up: state
; is a TUPLE, and the invariant COUPLES its variables — (balance ≥ reserved) is
; a relation no single-integer model can even express. Same one call
; (verify-process), same annotation on the name; the checker now proves the
; invariant for the whole primed tuple at once.

(ns example.system.multivar
  (:require [system.core :as sys] [z3]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- h [t] (println (str "\n── " t " ──")))
(def port (z3/open))

; ════════════════════════════════════════════════════════════════════════
; A reservation account. State is {balance, reserved}: `reserved` funds are
; earmarked and may never exceed the balance. The invariant is RELATIONAL:
;   (and (>= reserved 0) (>= balance reserved))
; reserve  earmarks free funds; release frees them; withdraw takes only the
; FREE (unreserved) part. All three must keep the coupling.
; ════════════════════════════════════════════════════════════════════════

(def account
  "(defserver ^{:invariant (and (>= reserved 0) (>= balance reserved))} account
     (init [balance reserved] (ok [balance reserved]))
     (handle-call [:reserve amt]  [_ [balance reserved]] :when (and (>= amt 0) (>= (- balance reserved) amt))
       (reply :ok [balance (+ reserved amt)]))
     (handle-call [:release amt]  [_ [balance reserved]] :when (and (>= amt 0) (>= reserved amt))
       (reply :ok [balance (- reserved amt)]))
     (handle-call [:withdraw amt] [_ [balance reserved]] :when (and (>= amt 0) (>= (- balance reserved) amt))
       (reply :ok [(- balance amt) reserved])))")

(h "a two-variable RELATIONAL invariant, proven jointly")
(def r (sys/verify-process port (read1 account)))
(println "  machine:  " (:name r))
(println "  checked:  " (:checked r) "  (^{:invariant} couples balance and reserved)")
(println "  □(reserved ≥ 0 ∧ balance ≥ reserved) holds:" (:holds r))
(println "  warnings: " (pr-str (:warnings r)))

; ════════════════════════════════════════════════════════════════════════
; The bug a single-variable model is blind to: a withdraw that guards the
; WHOLE balance (ignoring the reservation). It keeps balance ≥ 0, so a
; one-variable invariant would pass it — but it can drive balance < reserved.
; ════════════════════════════════════════════════════════════════════════

(def buggy
  "(defserver ^{:invariant (and (>= reserved 0) (>= balance reserved))} account
     (init [balance reserved] (ok [balance reserved]))
     (handle-call [:withdraw amt] [_ [balance reserved]] :when (and (>= amt 0) (>= balance amt))
       (reply :ok [(- balance amt) reserved])))")

(h "the reservation-ignoring withdraw is caught")
(doall (map (fn [w] (println w)) (sys/verify-file port "account.bl" buggy)))

; ════════════════════════════════════════════════════════════════════════
; And the single-variable case still works unchanged — N=1 is the special
; case of the same joint machinery (one param in the define-fun).
; ════════════════════════════════════════════════════════════════════════

(def simple
  "(defserver ^{:invariant (>= balance 0)} account
     (init [balance] (ok balance))
     (handle-call [:withdraw amt] [_ balance] :when (and (>= amt 0) (>= balance amt))
       (reply :ok (- balance amt))))")

(h "the single-variable seam is unchanged (N=1)")
(def r2 (sys/verify-process port (read1 simple)))
(println "  □(balance ≥ 0) holds:" (:holds r2) "  checked:" (:checked r2))

(h "the takeaway")
(println "  State is the shape the type lattice infers, not one integer. A")
(println "  relational invariant over a tuple is proven for the whole primed")
(println "  tuple at once — one define-fun, N params. Rung 1 of richer state.")
