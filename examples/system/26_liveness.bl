; examples/system/26_liveness.bl — P22: liveness (◇, eventually).
; Run: mix beam_lisp.run --path priv examples/system/26_liveness.bl
;
; Every check so far is SAFETY: □, nothing bad ever happens. Liveness is the
; other half of temporal logic: ◇, something good EVENTUALLY happens. "From the
; start, does every path reach the goal?" is AF — a LEAST fixpoint over the
; phase graph, the exact dual of the safe-region greatest fixpoint. A machine
; that can loop forever without reaching the goal (starvation) fails.

(ns example.system.liveness
  (:require [system.core :as sys] [z3]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- h [t] (println (str "\n── " t " ──")))

; ════════════════════════════════════════════════════════════════════════
; A job that always completes: pending → running → done. Every path from
; pending leads to done — liveness holds.
; ════════════════════════════════════════════════════════════════════════

(def job
  "(defserver job
     (init [] (ok {:phase :pending}))
     (handle-call [:start]  [_ {:keys [phase]}] :when (= phase :pending)
       (reply :ok {:phase :running}))
     (handle-call [:finish] [_ {:keys [phase]}] :when (= phase :running)
       (reply :ok {:phase :done})))")

(h "a job that always eventually completes (AF done)")
(def r (sys/verify-liveness (read1 job) "phase" #{"done"}))
(println "  machine:      " (:name r))
(println "  from phase:   " (:from r))
(println "  ◇done (every path reaches done) holds:" (:holds r))
(println "  states that reach done:" (pr-str (sort (into [] (:af r)))))

; ════════════════════════════════════════════════════════════════════════
; A job with a retry that loops running → running. Now there is a path that
; stays in running forever and never reaches done — starvation. Liveness fails,
; even though nothing BAD happens (safety would be fine).
; ════════════════════════════════════════════════════════════════════════

(def stuck
  "(defserver stuck
     (init [] (ok {:phase :pending}))
     (handle-call [:start] [_ {:keys [phase]}] :when (= phase :pending)
       (reply :ok {:phase :running}))
     (handle-call [:retry] [_ {:keys [phase]}] :when (= phase :running)
       (reply :ok {:phase :running})))")

(h "a job that can retry forever never guarantees completion")
(def rb (sys/verify-liveness (read1 stuck) "phase" #{"done"}))
(println "  ◇done holds:" (:holds rb) "  (a running→running loop starves)")
(println "  states that reach done:" (pr-str (sort (into [] (:af rb))))
         "  (running is NOT among them)")

(h "the takeaway")
(println "  Safety (□) shrinks from everything, keeping states that never touch")
(println "  bad — a greatest fixpoint. Liveness (◇) grows from the goal, adding")
(println "  states whose every future reaches it — a LEAST fixpoint. Same phase")
(println "  graph, dual directions. With both, the tier proves the two halves of")
(println "  temporal logic natively — no JVM, no TLA⁺ export. A starvation loop")
(println "  is caught precisely because it is NOT in the least fixpoint.")
