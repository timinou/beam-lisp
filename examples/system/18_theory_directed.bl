; examples/system/18_theory_directed.bl — P19: ONE checker, MANY z3 theories.
; Run: mix beam_lisp.run --path priv examples/system/18_theory_directed.bl
;
; The mechanism demo. Demo 15 showed one verify-process across many state
; SHAPES (scalar, tuple, record, variant, collection) — all Int underneath.
; This shows one verify-process across many z3 THEORIES: Int, Real, Bool, and
; String, chosen per field by the tag-lattice sort functor. Same call, same
; annotation; the field's inferred sort picks the theory. "state ≜ ⟦type-lattice⟧"
; with the lattice finally reaching past the integers.

(ns example.system.theory-directed
  (:require [system.core :as sys] [z3]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- line [name src]
  (let [r (sys/verify-process (deref port) (read1 src))]
    (println (str "  " name)
             " sort→theory checked=" (:checked r)
             " holds=" (:holds r)
             (if (empty? (:warnings r)) "" (str " ⚠" (count (:warnings r)))))))
(def port (atom nil))
(reset! port (z3/open))

(println "── one verify-process, four z3 theories, each field its own ──\n")

; Int — a bounded counter. field n inits to 0 (:int → Int).
(line "Int    counter (n ≥ 0)      "
  "(defserver ^{:invariant (>= n 0)} counter
     (init [] (ok {:n 0}))
     (handle-call [:inc] [_ {:keys [n]}] (reply :ok {:n (+ n 1)})))")

; Real — an interest rate. field rate inits to 0.05 (:float → Real).
(line "Real   rate (rate ≥ 0.0)    "
  "(defserver ^{:invariant (>= rate 0.0)} rated
     (init [] (ok {:rate 0.05}))
     (handle-call [:bump amt] [_ {:keys [rate]}] :when (>= amt 0.0)
       (reply :ok {:rate (+ rate amt)})))")

; Bool — a latch that never un-sets. field done inits to false (:bool → Bool).
(line "Bool   latch (done ⇒ done)  "
  "(defserver ^{:invariant (or (not done) done)} latch
     (init [] (ok {:done false}))
     (handle-call [:finish] [_ {:keys [done]}] (reply :ok {:done true})))")

; String — a prefixed log. field last inits to \"evt:init\" (:string → String).
(line "String log (evt: prefix)    "
  "(defserver ^{:invariant (str-prefix? \"evt:\" last)} auditlog
     (init [] (ok {:last \"evt:init\"}))
     (handle-cast [:append body] [_ {:keys [last]}]
       (noreply {:last (str \"evt:\" body)})))")

(println "\n── the takeaway ──")
(println "  Four machines, four z3 theories, ONE verify-process. No per-theory")
(println "  code path — each field's tag (:int :float :bool :string) selects its")
(println "  sort (Int Real Bool String) through the functor, and message inputs")
(println "  inherit the sort of the field they flow into. The Int prison was")
(println "  ours, in the translator; z3 always spoke every theory. Removing two")
(println "  hardcoded sorts opened all of them.")
