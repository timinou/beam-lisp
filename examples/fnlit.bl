; #() fn literals — `%` args, desugared in the reader.
;
; `#(+ % 1)` reads as `(fn [p1__] (+ p1__ 1))`: `%` is `%1`, `%2`… are
; positional, `%&` is the rest arg, arity is the highest `%N` used, and a
; literal with no `%` is a zero-arg fn. Nested `#()` is an error. This is
; how Clojure does it too — a reader macro, not a special form.

(ns fnlit.example)

; `%` in map — square each element.
(println (str "map %:      " (pr-str (map #(* % %) [1 2 3 4]))))

; `%` in filter — keep only the evens.
(println (str "filter %:   " (pr-str (filter #(even? %) [1 2 3 4 5 6]))))

; `%1`/`%2` in reduce — fold with the first two positionals.
(println (str "reduce %1%2: " (reduce #(+ %1 %2) 0 (range 1 11))))

; `%1`/`%2` positionals in a direct call.
(println (str "%1 %2:      " (#(str %1 "=" %2) :key 42)))

; `%&` collects the rest args, passed on through a variadic apply.
(defn sum-of [& xs]
  (apply + xs))

(println
  (str "apply %&:   " (apply sum-of (map #(* % 10) [1 2 3 4]))))

; A literal with no `%` at all is a zero-arg fn.
(println
  (str "zero-arg:   " ((fn [] "plain fn")) " / " (#(str "anon " 42))))

; (A nested `#()` would be a read error — the reader refuses it.)
(println "fn literals: OK")
