; guards.bl — clause dispatch: choosing a clause by what is TRUE, not
; only by how many arguments arrived.
; Run: mix beam_lisp.run examples/guards.bl
;
; ── Why this exists ───────────────────────────────────────────────────
;
; Clojure dispatches a `defn` on ARITY. That is a real limitation of the
; JVM it targets, not a design position: the JVM picks a method by
; signature, so a second one-argument clause has nowhere to go.
;
; The BEAM picks a clause by pattern AND guard, and Elixir's quoted
; format — the format beam-lisp compiles into — can express both. So the
; ceiling was never the runtime here; it was that the language had no
; SPELLING for the half it already had.
;
; A guard is written `:when` between a clause's head and its body, and it
; compiles into the real BEAM clause head. That is the whole feature, and
; everything below follows from it.

(ns examples.guards)

(defn- h [title]
  (println)
  (println (str "── " title " " (apply str (repeat (max 3 (- 66 (count title))) "─")))))

(defn- pad [s n]
  (let [t (str s)]
    (str t (apply str (repeat (max 0 (- n (count t))) " ")))))

;; ── 1. Same arity, different meaning ────────────────────────────────

(h "1. Three clauses, one argument each")

; In Clojure this is impossible to write: three `[x]` clauses would be an
; arity conflict. Here each one states the condition it answers under,
; and the BEAM tries them in order.
(defn describe
  ([n] :when (and (int? n) (pos? n)) (str n " is a positive integer"))
  ([n] :when (int? n)                (str n " is an integer, but not positive"))
  ([s] :when (string? s)             (str "\"" s "\" is a string"))
  ([x]                               (str (pr-str x) " is something else")))

(doseq [v [7 -7 "hello" :keyword]]
  (println "  " (describe v)))

(println)
(println "  Without guards the second, third and fourth clauses would be")
(println "  unreachable — and, before this existed, they were silently so:")
(println "  a second same-arity clause REPLACED the first in the dispatch")
(println "  table. Code that looked live was dead.")

;; ── 2. A guard is not an `if` ───────────────────────────────────────

(h "2. Why not just write an `if` in the body?")

; For a plain function the two are nearly interchangeable, and an `if` is
; often clearer. The difference appears the moment a clause can DECLINE:
; a guard failure means "this clause did not match", so the next clause —
; or the caller's next option — still applies.
;
; This matters most where the alternative is not another clause but
; another PROCESS, another time, or another message. Sections 3 and 4.

; Note what the guard has to SAY. `(not (zero? b))` alone is not enough:
; `zero?` answers false for `:nope` (guards never raise — a raising guard
; would kill the process instead of trying the next clause), so `not`
; makes it TRUE and a keyword would reach the division. The condition
; being asked for is "a non-zero NUMBER", so that is what it must say.
;
; This is the ordinary discipline of total functions, and the guard is
; where it becomes visible: an unstated assumption in a body is a latent
; crash, while an unstated assumption in a head is a clause that matches
; too much.
(defn- safe-div
  ([a b] :when (and (number? b) (not (zero? b))) (/ a b))
  ([_a _b] :undefined))

(println "  10 / 2     =" (safe-div 10 2))
(println "  10 / 0     =" (safe-div 10 0))
(println "  10 / :nope =" (safe-div 10 :nope))

;; ── 3. A receive guard leaves the message alone ─────────────────────

(h "3. Selective receive: the message you decline stays yours")

; THIS is what an `if` cannot do. A message that fails a guard was never
; received, so it is still in the mailbox. Here both messages arrive
; before either is read, and the SECOND receive takes the one the first
; declined — in the order the guards ask for, not the order they came.

(erlang/send (erlang/self) [:job 1 :low])
(erlang/send (erlang/self) [:job 2 :high])

(let [urgent (receive [:job n :high] n (after 1000 :none))
      rest   (receive [:job n _p]    n (after 1000 :none))]
  (println "  arrived: job 1 (low), then job 2 (high)")
  (println "  handled first: job" urgent "— because the guard asked for :high")
  (println "  handled next:  job" rest "— the one the first receive declined")
  (println)
  (println "  The low-priority job was never consumed and never lost. An")
  (println "  `if` inside the first receive's body could not do this: by")
  (println "  then the message is already out of the mailbox."))

;; ── 4. A server whose contract lives in its clause heads ────────────

(h "4. Validity as part of the API, not the body")

; `defserver` compiles to a genuine gen_server. A guard on a callback
; lands in the OTP callback's own def head, so a request that fails it is
; declined by DISPATCH — the handler body only ever runs on input it can
; actually serve.

(defserver account
  (init [balance] (ok balance))

  ; A withdrawal must be positive AND affordable. Two conditions, two
  ; clauses, and neither handler contains a validity check.
  (handle-call [:withdraw n] :when (and (pos? n) (int? n)) [_from balance]
    (if (>= balance n)
      (reply [:ok (- balance n)] (- balance n))
      (reply [:insufficient balance] balance)))

  (handle-call [:withdraw n] [_from balance]
    (reply [:invalid-amount n] balance))

  (handle-call :balance [_from balance] (reply balance balance)))

(def acct (server-start-link account 100))

(doseq [req [[:withdraw 30] [:withdraw 1000] [:withdraw -5] [:withdraw 1.5]]]
  (println "  " (pr-str req) "→" (server-call acct req)))

(println "   balance →" (server-call acct :balance))
(server-stop acct)

;; ── 5. What a guard may contain, and why ────────────────────────────

(h "5. The guard dialect")

; The BEAM evaluates a guard WITHOUT calling user code — that is what
; makes guards safe to run during dispatch, before a clause is committed
; to. So the vocabulary is fixed: comparisons, arithmetic, the type
; predicates, and and/or/not.
;
; Anything else is refused at COMPILE time with the permitted set named.
; `(defn f ([x] :when (println x) …))` does not compile — which is the
; point, because a guard that could print could also block, and dispatch
; would no longer be dispatch.

(defn kind
  ([x] :when (keyword? x) :keyword)
  ([x] :when (map? x)     :map)
  ([x] :when (vector? x)  :vector)
  ([x] :when (string? x)  :string)
  ([x] :when (int? x)     :int)
  ([x] :when (float? x)   :float)
  ([x] :when (pid? x)     :pid)
  ; `:nil` READS as the keyword nil, and this language's `nil?` is exactly
  ; the guard that distinguishes them — so the label is a string.
  ([x] :when (nil? x)     "nil")
  ([_x]                   :other))

(doseq [v [:k {:a 1} [1 2] "s" 42 1.5 (erlang/self) nil (list 1)]]
  (println "  " (pad (pr-str v) 22) "→" (kind v)))

(println)
(println "  `map?` here excludes structs, exactly as it does everywhere")
(println "  else in this language: on the BEAM a struct IS a map, so a")
(println "  bare is_map guard would swallow every vector, set and lazy")
(println "  seq. The guard expands to the same test `map?` already means.")

;; ── 6. recur across a guard ─────────────────────────────────────────

(h "6. A loop that terminates by falling through")

; `recur` re-enters the DISPATCHER, not the clause it was written in. So
; a recursive call whose new arguments fail this clause's guard lands in
; the NEXT clause — the base case is where the guard stops holding,
; rather than a condition tested twice.

(defn countdown
  ([n acc] :when (pos? n) (recur (- n 1) (conj acc n)))
  ([_n acc] acc))

(println "  (countdown 5 []) →" (countdown 5 []))
(println)
(println "  No `if`, no base-case test in the body. The recursion stops")
(println "  because `(pos? n)` stopped being true, and the second clause")
(println "  was waiting for exactly that.")

;; ── the shape of it ─────────────────────────────────────────────────

(h "the shape of it")

(println "  Clojure dispatches on arity because the JVM does. beam-lisp")
(println "  compiles to Elixir's quoted format, where a clause is chosen")
(println "  by pattern AND guard — so the restriction was never the")
(println "  runtime's, it was a missing spelling.")
(println)
(println "  The payoff is not shorter code. It is that a condition stated")
(println "  in a clause head can DECLINE: another clause answers, or the")
(println "  message stays in the mailbox, or OTP tries the next callback.")
(println "  A condition inside a body has already committed.")
(println)
