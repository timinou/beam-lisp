; collections.bl — pouring one collection into another, and the type
; predicates that decide what a value IS.
;
; Run: mix beam_lisp.run examples/collections.bl
;
; Everything here was added in wave 27, and most of it exists because
; running someone else's code demanded it: `into` was the last genuine
; failure in the 120-slice jank fidelity sample, and the type prims were
; what Specter needed before its navigators could even be constructed.

(ns collections.demo)

(println "== into: every target keeps its own kind ==")

; The target decides the result type. A vector target yields a vector even
; when the source is a list — in beam-lisp `[]` and `()` are structurally
; distinct, so this is a real conversion, not a formality.
(println (str "  (into [] '(1 2 3))        => " (into [] '(1 2 3))))
(println (str "  (into [0] [1 2])          => " (into [0] [1 2])))

; A map target accepts an entry in either spelling: the 2-element vector
; that `seq` yields over a map, or a 2-element list. Both had to work,
; because upstream code produces both.
(println (str "  (into {} [[:a 1] [:b 2]]) => " (into {} [[:a 1] [:b 2]])))
(println (str "  (into {} '((:a 1)))       => " (into {} '((:a 1)))))

; A set target dedupes, because that is what a set is for.
(println (str "  (into (set []) [1 2 2])   => " (into (set []) [1 2 2])))

(println)
(println "== into with a transducer ==")

; `(map inc)` with no collection is a TRANSDUCER: a recipe for a
; transformation, not a transformed thing. `into` runs it over the source
; while pouring, so there is no intermediate sequence.
(println (str "  (into [] (map inc) [1 2 3])     => " (into [] (map inc) [1 2 3])))
(println (str "  (into [] (filter odd?) [1 2 3]) => " (into [] (filter odd?) [1 2 3])))

; The collection arities are unchanged, and still lazy. This is the part
; worth proving rather than asserting: adding the transducer form meant
; rebinding `map`, and a careless rebinding would have quietly made the
; whole seq layer eager.
(def realized (atom 0))
(def head (doall (take 3 (map (fn [x] (do (swap! realized inc) (inc x)))
                              (range 1 1000000)))))
(println (str "  (take 3 (map f (range 1 1000000))) => " head))
(println (str "  cells actually realized            => " @realized
              "  (one 32-cell chunk, not a million)"))

(println)
(println "== merge ==")

; Later keys win; nil maps are skipped. Merging NOTHING is nil rather than
; an empty map — that is Clojure's contract, and it is what makes
; (apply merge coll) safe when coll turns out to be empty.
(println (str "  (merge {:a 1} {:b 2})   => " (merge {:a 1} {:b 2})))
(println (str "  (merge {:a 1} {:a 9})   => " (merge {:a 1} {:a 9})))
(println (str "  (merge nil {:a 1})      => " (merge nil {:a 1})))
(println (str "  (apply merge [])        => " (apply merge []) " (nil, not {})"))

(println)
(println "== keys and vals ==")

; keys and vals agree with each other and with seq, so they round-trip.
; They do NOT promise insertion order: a beam-lisp map is an Erlang map,
; which iterates in term order. Code that needs an order must sort.
(def m {:a 1 :b 2 :c 3})
(println (str "  (keys m) => " (keys m)))
(println (str "  (vals m) => " (vals m)))
(println (str "  (zipmap (keys m) (vals m)) = m => " (= m (zipmap (keys m) (vals m)))))

(println)
(println "== what IS this value? ==")

(defrecord Point [x y])
(deftype Marker [tag])

; `type` answers with one vocabulary: a keyword for a builtin, the defining
; module for a record or deftype. One vocabulary matters — a type system
; with two names for the same thing cannot be dispatched on.
(println (str "  (type 5)           => " (type 5)))
(println (str "  (type \"s\")         => " (type "s")))
(println (str "  (type [1 2])       => " (type [1 2])))
(println (str "  (type (->Point 1 2)) => " (type (->Point 1 2))))

(println (str "  (instance? :integer 5) => " (instance? :integer 5)))

; A record IS a map here: count, get, assoc, seq and map? all agree, which
; they did not before this wave — `map?` used to be the lone dissenter.
(def p (->Point 1 2))
(println (str "  (map? (->Point 1 2))  => " (map? p) "   a record is a map, as in Clojure"))
(println (str "  (count (->Point 1 2)) => " (count p)))
(println (str "  (get (->Point 1 2) :x) => " (get p :x)))

; ...but a reference is NOT a collection, and says so instead of quietly
; exposing its internals. `(count (atom 1))` used to answer 2 — it was
; counting the struct's own hidden fields.
(println (str "  (map? (atom 1))       => " (map? (atom 1))))
(println (str "  (count (atom 1))      => "
              (try (count (atom 1)) (catch e "raises: not a collection"))))

(println)
(println "== symbols are values ==")

; A symbol built at runtime is the same value the reader produces for the
; same text. If those two diverged, a macro that constructs a name would
; silently disagree with one that reads a name.
(println (str "  (symbol \"foo\")        => " (symbol "foo")))
(println (str "  (= (symbol \"foo\") 'foo) => " (= (symbol "foo") 'foo)))

(println)
(println "== sequence vs seq on an empty collection ==")

; The difference is the whole reason `sequence` exists: `seq` answers nil
; so you can test it, `sequence` answers an empty seq so you can keep
; threading it.
(println (str "  (seq [])      => " (seq []) " (nil)"))
(println (str "  (sequence []) => " (sequence []) " (an empty seq)"))
