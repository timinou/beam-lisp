; errors.bl — throw/try error handling.
; `throw` raises a value; `try` catches it with a typed or untyped
; `catch` clause and runs an optional `finally` either way.
; Run: mix beam_lisp.run examples/errors.bl

(defn explode []
  (throw (ex-info "boom" {:code 42})))

(println "== throw + untyped catch ==")
(try
  (explode)
  (catch e
    (println (str "caught:" (ex-message e)))
    (println (str "data:" (pr-str (ex-data e)))))
  (finally
    (println "cleanup ran")))

(println "== typed catch ==")
(try
  (throw (ex-info "typed" {:code 7}))
  (catch BeamLisp.ExInfo e
    (println (str "typed caught:" (pr-str (ex-data e)))))
  (finally
    (println "typed cleanup")))

(println "done")
