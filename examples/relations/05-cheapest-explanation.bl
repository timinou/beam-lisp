; examples/relations/05-cheapest-explanation.bl — ranking as arithmetic-in-recursion.
; Run: mix beam_lisp.run --path priv --path examples examples/relations/05-cheapest-explanation.bl
;
; The native fixpoint does arithmetic-in-recursion (it is a shortest-path
; engine). Give it a WEIGHTED relation and it ranks CHAINS by total cost —
; the cheapest, i.e. most coherent, path to each reachable node.
;
; Here the skeleton is the acyclic CITATION graph (a real reasoning structure:
; A cites B cites C…), and each citation edge is WEIGHTED by semantic distance
; between the two papers — a citation between things that mean similar things
; is a cheap, coherent step. `min` over the recursion picks the most coherent
; chain to each document.
;
;   [(reach ?a ?b ?c) [?a :cost ?b ?c]]                          ; a first hop
;   [(reach ?a ?b ?c) (reach ?a ?x ?cx) [?x :cost ?b ?w] [(+ ?cx ?w) ?c]]
;
; The citation graph is a DAG, so the recursion terminates naturally. (Shortest
; path over a CYCLIC graph needs min-aggregation each round — PreM, priv/datom/
; query/prem.bl — a deliberately separate concern.)

(ns example.relations.cheapest
  (:require [datom] [relations.corpus :as c]
            [datom.query.relation :as rel]
            [datom.vector :as v]))

(def db (c/db))

;; :cost is a computed relation: a WEIGHTED citation edge. Its provider walks
;; the stored :doc/cites edges and weights each by semantic distance (in
;; integer milli-units, so the i64 kernel ranks them). A computed relation
;; DERIVED FROM stored edges + embeddings — the two composing.
(defn- vec-of [db e]
  (get (get (into [] (datom/q '[:find ?vv :in $ ?e :where [?e :doc/vec ?vv]] db e)) 0) 0))

(defn- score [db a b]
  ;; cosine via search: score of b when searching from a's vector over just b.
  (let [hit (first (into [] (v/search (vec-of db a) [[b (vec-of db b)]] 1 0)))]
    (if (nil? hit) 0.0 (get hit 1))))

(rel/defrelation :cost
  {:arity 3 :modes #{:bf} :tags #{:weighted} :args []
   :doc "a citation edge weighted by 1000*(1 - cosine) between the two docs"
   :provider
   (fn [db mode bound args]
     (mapv (fn [pair]
             (let [a (get pair 0) b (get pair 1)]
               [a b (erlang/round (* 1000 (- 1.0 (score db a b))))]))
           (into [] (datom/q '[:find ?a ?b :where [?a :doc/cites ?b]] db))))})

(def REACH
  '[[(reach ?a ?b ?c) [?a :cost ?b ?c]]
    [(reach ?a ?b ?c) (reach ?a ?x ?cx) [?x :cost ?b ?w] [(+ ?cx ?w) ?c]]])

(defn- id-of [t] (get (get (into [] (datom/q '[:find ?e :in $ ?t :where [?e :doc/title ?t]] db t)) 0) 0))

(c/heading "── the weighted citation edges (cost = semantic distance) ──")
(doseq [r (sort (into [] (datom/q '[:find ?ta ?tb ?c
                                    :where [?a :cost ?b ?c]
                                           [?a :doc/title ?ta] [?b :doc/title ?tb]]
                                  db)))]
  (c/show "cost" r))

(c/heading "── cheapest (most coherent) chain from a budget article ──")
;; "A budget for investing your cash" cites 5 and 6; follow the cheapest chain.
(def budget (id-of "A budget for investing your cash"))
(c/show "min cost to reach each ancestor:"
  (sort (into [] (datom/q '[:find ?tb (min ?c) :in $ % ?src
                            :where (reach ?src ?b ?c) [?b :doc/title ?tb]]
                          db REACH budget))))

(c/heading "── what to take away ──")
(println "  A WEIGHTED relation + arithmetic-in-recursion + min = the cheapest")
(println "  reasoning chain, ranked. The weight here composes a STORED graph")
(println "  (:doc/cites) with COMPUTED distance (embeddings) — two relations")
(println "  feeding one native fixpoint. Next: the fixpoint AS a labeller.")
