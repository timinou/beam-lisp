; examples/relations/corpus.bl — a shared little world for the examples.
;
; A handful of documents with text, an embedding (offline fake), a topic, a
; date, and a citation graph. Enough structure that every use case — semantic
; search, recursion, ranking, provenance, time-travel, the catalog — has real
; data to bite on, without each file rebuilding it.

(ns relations.corpus
  (:require [datom] [datom.vector] [semantic.embed :as embed]))

;; ── schema ──────────────────────────────────────────────────────────
;;
;; Ordinary attributes (stored relations) plus the catalog attributes, so a
;; relation can describe ITSELF into the same store the facts live in.

(def SCHEMA
  [{:db/ident :doc/title :db/valueType :db.type/string}
   {:db/ident :doc/text  :db/valueType :db.type/string}
   {:db/ident :doc/vec   :db/valueType :db.type/vector}
   {:db/ident :doc/topic :db/valueType :db.type/keyword}
   {:db/ident :doc/day   :db/valueType :db.type/long}          ; a coarse "date"
   {:db/ident :doc/cites :db/valueType :db.type/ref :db/cardinality :db.cardinality/many}
   ;; the relation catalog, as data
   {:db/ident :relation/ident      :db/valueType :db.type/keyword :db/unique :db.unique/identity}
   {:db/ident :relation/extension  :db/valueType :db.type/keyword}
   {:db/ident :relation/arity      :db/valueType :db.type/long}
   {:db/ident :relation/mode       :db/valueType :db.type/keyword :db/cardinality :db.cardinality/many}
   {:db/ident :relation/tag        :db/valueType :db.type/keyword :db/cardinality :db.cardinality/many}
   {:db/ident :relation/doc        :db/valueType :db.type/string}])

;; ── the documents ───────────────────────────────────────────────────
;;
;; Two topical clusters (pets, finance) plus a couple of bridges, so
;; similarity, clustering and recursion all have something to find. `:doc/cites`
;; is a small citation DAG. `:doc/day` lets an as-of demo split history.

(def DOCS
  [{:id 1  :title "Caring for your new kitten"        :topic :pets    :day 1  :cites []}
   {:id 2  :title "Training your dog to sit and stay" :topic :pets    :day 1  :cites [1]}
   {:id 3  :title "Adopting a rescue puppy"           :topic :pets    :day 2  :cites [2]}
   {:id 4  :title "A feline guide to the purring cat" :topic :pets    :day 2  :cites [1]}
   {:id 5  :title "Index funds and the interest rate" :topic :finance :day 3  :cites []}
   {:id 6  :title "Saving money on a mortgage loan"   :topic :finance :day 3  :cites [5]}
   {:id 7  :title "A budget for investing your cash"  :topic :finance :day 4  :cites [5 6]}
   {:id 8  :title "The bank raised the savings rate"  :topic :finance :day 4  :cites [5]}])

(defn connect
  "A fresh connection populated with the shared corpus. Each doc gets an
   embedding of its title from the offline fake embedder."
  []
  (let [conn (datom/connect SCHEMA)]
    (datom/transact! conn
      (mapv (fn [d]
              {:db/id (get d :id)
               :doc/title (get d :title)
               :doc/text (get d :title)
               :doc/vec (embed/embed (get d :title))
               :doc/topic (get d :topic)
               :doc/day (get d :day)
               :doc/cites (mapv (fn [c] c) (get d :cites))})
            DOCS))
    conn))

(defn db [] (datom/db (connect)))

;; ── small helpers the examples reuse ────────────────────────────────

(defn title-of
  "The title of entity `e` in `db`."
  [db e]
  (get (get (into [] (datom/q '[:find ?t :in $ ?e :where [?e :doc/title ?t]] db e)) 0) 0))

(defn show [label v] (println (str "  " label "  " (pr-str v))))
(defn heading [text] (println (str "\n" text)))
