; examples/relations/02-access-modes.bl — one relation, three access modes.
; Run: mix beam_lisp.run --path priv --path examples examples/relations/02-access-modes.bl
;
; A relation is not one-directional. The way a query BINDS its columns (the
; adornment) selects an access MODE, and one relation serves all of them:
;
;   :bf   ?a bound, ?b free   → a's neighbours          (the forward index)
;   :bb   both bound          → is (a,b) an edge?        (the probe / filter)
;   :fb   ?a free, ?b bound   → who has b as a neighbour (the reverse index)
;
; A bolted-on vector database gives you :bf (generate) only. Because :~similar
; is a relation the engine unifies against, the SAME declaration answers all
; three — the engine picks the mode from how you wrote the clause.

(ns example.relations.access-modes
  (:require [datom] [relations.corpus :as c]
            [datom.query.relation :as rel] [datom.query.relations :as rels]))

(def db (c/db))

(rel/defrelation :~similar
  {:arity 2 :modes #{:bf :bb :fb} :tags #{:semantic} :args []
   :provider (rels/hnsw-adjacency :doc/vec {:k 2 :threshold 0.35})})

;; helper: entity id of a titled doc
(defn- id-of [t] (get (get (into [] (datom/q '[:find ?e :in $ ?t :where [?e :doc/title ?t]] db t)) 0) 0))
(def kitten (id-of "Caring for your new kitten"))

(c/heading "── :bf — generate: the neighbours of a bound entity ──")
;; ?a is bound (kitten), ?b free → search from kitten.
(c/show "near kitten:"
  (sort (into [] (datom/q '[:find ?tb :in $ ?a
                            :where [?a :~similar ?b] [?b :doc/title ?tb]]
                          db kitten))))

(c/heading "── :bb — probe: is THIS pair a semantic edge? ──")
;; both ends bound → yes/no. Ask if kitten ~ the feline guide, and ~ a bank doc.
(let [feline (id-of "A feline guide to the purring cat")
      bank   (id-of "The bank raised the savings rate")]
  (c/show "kitten ~ feline-guide?"
    (not (empty? (into [] (datom/q '[:find ?b :in $ ?a ?b
                                     :where [?a :~similar ?b]] db kitten feline)))))
  (c/show "kitten ~ bank-doc?"
    (not (empty? (into [] (datom/q '[:find ?b :in $ ?a ?b
                                     :where [?a :~similar ?b]] db kitten bank))))))

(c/heading "── :fb — reverse: who has THIS entity as a neighbour? ──")
;; ?b bound (feline guide), ?a free → the reverse index, for free.
(let [feline (id-of "A feline guide to the purring cat")]
  (c/show "who is near the feline guide:"
    (sort (into [] (datom/q '[:find ?ta :in $ ?b
                              :where [?a :~similar ?b] [?a :doc/title ?ta]]
                            db feline)))))

(c/heading "── what to take away ──")
(println "  ONE relation, THREE access patterns — generate, probe, reverse —")
(println "  selected by how the query binds the columns (the adornment).")
(println "  A vector DB does generate only; a relation does all three because")
(println "  the engine unifies against it like any edge. Next: swap the provider.")
