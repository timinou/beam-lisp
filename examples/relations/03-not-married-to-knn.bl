; examples/relations/03-not-married-to-knn.bl — swap the mechanism, keep the query.
; Run: mix beam_lisp.run --path priv --path examples examples/relations/03-not-married-to-knn.bl
;
; "Similar" is a MEANING, not a mechanism. `:~related` is declared once as an
; edge; the PROVIDER decides how similarity is computed. This file registers
; the same relation ident against four different providers and runs the SAME
; query each time. Nothing in the query changes — only the configuration.
;
;   knn-adjacency        vector cosine top-k
;   threshold-adjacency  same stored topic (a business rule; no vectors)
;   fn-adjacency         a caller-supplied pair scorer (learned relatedness)
;   union-adjacency      the union of providers (hybrid / ensemble)

(ns example.relations.not-married
  (:require [datom] [relations.corpus :as c]
            [datom.query.relation :as rel] [datom.query.relations :as rels]))

(def db (c/db))

;; the ONE query we run against every provider — never changes.
(def QUERY
  '[:find ?ta ?tb
    :where [?a :~related ?b] [?a :doc/title ?ta] [?b :doc/title ?tb]])

(defn- run-with [label provider]
  (rel/register-relation! :~related
    {:arity 2 :modes #{:bf :bb :fb} :args [] :provider provider})
  (c/heading (str "── provider: " label " ──"))
  (doseq [r (take 4 (sort (into [] (datom/q QUERY db))))]
    (c/show "~" r)))

;; 1. vector k-NN — meaning by embedding proximity
(run-with "knn-adjacency (cosine top-k)"
  (rels/knn-adjacency :doc/vec {:k 1 :threshold 0.35}))

;; 2. threshold on a stored attribute — "related" = same topic. No vectors.
(run-with "threshold-adjacency (same :doc/topic)"
  (rels/threshold-adjacency :doc/topic {:tol 0}))

;; 3. a caller function — relatedness is anything you can compute. Here:
;;    two docs are related if one cites the other (a learned/domain rule).
(run-with "fn-adjacency (cites either way)"
  (rels/fn-adjacency :doc/title
    (fn [db a b]
      (let [a->b (into [] (datom/q '[:find ?b :in $ ?a ?b :where [?a :doc/cites ?b]] db a b))
            b->a (into [] (datom/q '[:find ?a :in $ ?a ?b :where [?b :doc/cites ?a]] db a b))]
        (if (and (empty? a->b) (empty? b->a)) nil 1.0)))
    {:threshold 0.5}))

;; 4. hybrid — union of k-NN and same-topic. Best recall, one line to switch.
(run-with "union-adjacency (knn ∪ same-topic)"
  (rels/union-adjacency
    [(rels/knn-adjacency :doc/vec {:k 1 :threshold 0.35})
     (rels/threshold-adjacency :doc/topic {:tol 0})]))

(c/heading "── what to take away ──")
(println "  The query names :~related and NEVER changed across four mechanisms.")
(println "  You are not married to k-NN — the provider is configuration. Swap it")
(println "  for BM25, a learned scorer, or a hybrid, and every query that")
(println "  traverses :~related — including recursive ones — is unaffected.")
