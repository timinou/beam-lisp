; examples/relations/01-defrelation.bl — declare a computed relation.
; Run: mix beam_lisp.run --path priv --path examples examples/relations/01-defrelation.bl
;
; A COMPUTED relation is one whose tuples are produced by a function instead of
; stored as datoms — yet it is a full citizen: it joins, it has access modes,
; it describes itself. `defrelation` declares one; a `provider` computes it.
;
; The point of THIS file: once declared, `:~similar` is usable two ways, and
; both are the same relation —
;   attribute spelling   [?a :~similar ?b]              (like a stored edge)
;   call spelling        [(:~similar) [?a ?b]]          (like an analytic op)

(ns example.relations.defrelation
  (:require [datom] [relations.corpus :as c]
            [datom.query.relation :as rel] [datom.query.relations :as rels]))

(def db (c/db))

;; ── declare a computed relation ─────────────────────────────────────
;;
;; :~similar links each document to its nearest neighbours by MEANING. The
;; provider is k-NN over the embedding column; :args fixes the column + k at
;; declaration, so the attribute spelling carries no parameters (it reads as a
;; plain edge). :modes lists the access patterns it supports; :tags feed the
;; catalog (see 09).

(rel/defrelation :~similar
  {:arity 2
   :modes #{:bf :bb :fb}
   :tags #{:semantic}
   :args []
   :doc "documents whose titles are nearest by embedding"
   :provider (rels/knn-adjacency :doc/vec {:k 2 :threshold 0.35})})

(c/heading "── it is a real relation: attribute spelling ──")
;; [?a :~similar ?b] sits in :where exactly like [?a :doc/cites ?b] would.
(doseq [r (sort (into [] (datom/q '[:find ?ta ?tb
                                    :where [?a :~similar ?b]
                                           [?a :doc/title ?ta] [?b :doc/title ?tb]]
                                  db)))]
  (c/show "~" r))

(c/heading "── the SAME relation, joined with a stored fact ──")
;; a computed edge and a stored attribute (:doc/topic) in ONE query.
(c/show "pet docs similar to something:"
  (sort (into [] (datom/q '[:find ?ta
                            :where [?a :doc/topic :pets]
                                   [?a :~similar ?b]
                                   [?a :doc/title ?ta]]
                          db))))

(c/heading "── what to take away ──")
(println "  A computed relation is DECLARED with defrelation + a provider.")
(println "  [?a :~similar ?b] is an edge — it joins with stored facts freely.")
(println "  The query names the MEANING (:~similar); the provider (k-NN) is a")
(println "  configuration detail the query never sees. Next: its access modes.")
