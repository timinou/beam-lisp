; examples/relations/06-label-propagation.bl — the fixpoint IS the algorithm.
; Run: mix beam_lisp.run --path priv --path examples examples/relations/06-label-propagation.bl
;
; Semi-supervised labelling: you know the topic of a FEW seed documents; you
; want to label the rest. The rule is one sentence — "a doc has topic T if it
; is similar to a seed of T, or similar to something already labelled T" — and
; the RECURSION over the semantic relation spreads the labels to a fixpoint.
; There is no separate ML pass; the least-fixpoint IS label propagation.
;
;   [(topic ?d ?t) [?s :seed ?t] [?s :~similar ?d]]         ; from a seed
;   [(topic ?d ?t) (topic ?x ?t) [?x :~similar ?d]]         ; spread along meaning

(ns example.relations.label-propagation
  (:require [datom] [relations.corpus :as c] [semantic.embed :as embed]
            [datom.query.relation :as rel] [datom.query.relations :as rels]))

;; a corpus where only TWO documents carry a known label (:seed), the rest are
;; unlabelled and must be reached through the semantic graph.
(def conn
  (datom/connect
    (conj relations.corpus/SCHEMA {:db/ident :seed :db/valueType :db.type/keyword})))
(datom/transact! conn
  (mapv (fn [d]
          (let [base {:db/id (get d :id) :doc/title (get d :title)
                      :doc/vec (embed/embed (get d :title))}]
            ;; label only doc 1 (a pet) and doc 5 (a finance) as seeds
            (cond
              (= (get d :id) 1) (assoc base :seed :pets)
              (= (get d :id) 5) (assoc base :seed :finance)
              :else base)))
        relations.corpus/DOCS))
(def db (datom/db conn))

(rel/defrelation :~similar
  {:arity 2 :modes #{:bf :bb :fb} :tags #{:semantic} :args []
   :provider (rels/knn-adjacency :doc/vec {:k 2 :threshold 0.3})})

(def LABEL
  '[[(topic ?d ?t) [?s :seed ?t] [?s :~similar ?d]]
    [(topic ?d ?t) (topic ?x ?t) [?x :~similar ?d]]])

(c/heading "── seeds: only two documents are labelled up front ──")
(doseq [r (sort (into [] (datom/q '[:find ?ta ?t :where [?a :seed ?t] [?a :doc/title ?ta]] db)))]
  (c/show "seed" r))

(c/heading "── after propagation: every reachable doc gets a topic ──")
;; the recursion spreads :pets and :finance along semantic similarity.
(doseq [r (sort (into [] (datom/q '[:find ?td ?t :in $ %
                                    :where (topic ?d ?t) [?d :doc/title ?td]]
                                  db LABEL)))]
  (c/show "label" r))

(c/heading "── what to take away ──")
(println "  Two seed labels + one recursive rule over :~similar = a running")
(println "  label-propagation / graph-SSL algorithm. The FIXPOINT is the")
(println "  algorithm — no separate ML step. Add a seed, rerun, labels respread.")
(println "  Next: multi-hop retrieval that carries its own justification.")
