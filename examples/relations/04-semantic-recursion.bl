; examples/relations/04-semantic-recursion.bl — recursion over MEANING, native.
; Run: mix beam_lisp.run --path priv --path examples examples/relations/04-semantic-recursion.bl
;
; ── The unlock ────────────────────────────────────────────────────────
;
; A computed relation is a base relation the moment the fixpoint demands it.
; So `:~similar` can appear in a RECURSIVE rule and the whole thing runs on the
; native fixpoint — "documents reachable through a chain of meaning", at native
; speed. This is the frontier that earlier could only run in the slow bl path.
;
;   [(meaning-reaches ?a ?b) [?a :~similar ?b]]                    ; one hop
;   [(meaning-reaches ?a ?b) [?a :~similar ?x] (meaning-reaches ?x ?b)]  ; chain
;
; The k-NN graph is materialised ONCE as a base relation; the recursion is
; pure-relational over integers from there. Native.

(ns example.relations.semantic-recursion
  (:require [datom] [relations.corpus :as c]
            [datom.query.relation :as rel] [datom.query.relations :as rels]
            [datom.query.fixpoint :as fp]))

(def db (c/db))

;; k=2 so the semantic graph has forward chains, not just mutual nearest pairs.
(rel/defrelation :~similar
  {:arity 2 :modes #{:bf :bb :fb} :tags #{:semantic} :args []
   :provider (rels/knn-adjacency :doc/vec {:k 2 :threshold 0.3})})

(def MEANING
  '[[(meaning-reaches ?a ?b) [?a :~similar ?b]]
    [(meaning-reaches ?a ?b) [?a :~similar ?x] (meaning-reaches ?x ?b)]])

(c/heading "── is this recursion native? ──")
;; a computed edge in recursion is still native-compatible: the provider makes
;; it a base relation, and the fixpoint over integers is the native kernel's.
(c/show "native-compatible?:" (fp/compatible? MEANING))

(c/heading "── one hop vs the whole chain of meaning ──")
(defn- id-of [t] (get (get (into [] (datom/q '[:find ?e :in $ ?t :where [?e :doc/title ?t]] db t)) 0) 0))
(def kitten (id-of "Caring for your new kitten"))

(c/show "directly similar to kitten:"
  (sort (into [] (datom/q '[:find ?tb :in $ ?a
                            :where [?a :~similar ?b] [?b :doc/title ?tb]]
                          db kitten))))

(c/show "reachable through a CHAIN of meaning from kitten:"
  (sort (into [] (datom/q '[:find ?tb :in $ % ?a
                            :where (meaning-reaches ?a ?b) [?b :doc/title ?tb]]
                          db MEANING kitten))))

(c/heading "── it still JOINS with structure ──")
;; semantic reach, then keep only the finance ones — recursion + a stored filter
(c/show "finance docs reachable by meaning from an index-funds doc:"
  (sort (into [] (datom/q '[:find ?tb :in $ % ?a
                            :where (meaning-reaches ?a ?b)
                                   [?b :doc/topic :finance] [?b :doc/title ?tb]]
                          db MEANING (id-of "Index funds and the interest rate")))))

(c/heading "── what to take away ──")
(println "  A computed relation in a RECURSIVE rule runs on the native fixpoint:")
(println "  the k-NN graph materialises once as a base relation, then the")
(println "  recursion is native. Semantic transitive closure — reachability")
(println "  through meaning — at native speed. Next: rank those chains by cost.")
