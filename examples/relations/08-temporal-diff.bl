; examples/relations/08-temporal-diff.bl — what became true between two times.
; Run: mix beam_lisp.run --path priv --path examples examples/relations/08-temporal-diff.bl
;
; A computed relation is a pure function of the db VALUE. The store is
; immutable, so each transaction yields a new value you can query independently
; — and a relation evaluated `as-of` an old value sees the old corpus, for free.
;
; So "what new conclusions follow from what changed?" is a set difference:
; materialise the semantic closure at time T1 and at T2, subtract. This is
; monitoring, provenance, and change-detection — falling straight out of the
; fact that relations are basis-relative.

(ns example.relations.temporal-diff
  (:require [datom] [relations.corpus :as c] [semantic.embed :as embed]
            [datom.query.relation :as rel] [datom.query.relations :as rels]))

(def conn (datom/connect relations.corpus/SCHEMA))

(rel/defrelation :~similar
  {:arity 2 :modes #{:bf :bb :fb} :tags #{:semantic} :args []
   :provider (rels/hnsw-adjacency :doc/vec {:k 2 :threshold 0.3})})

(def REACH
  '[[(reaches ?a ?b) [?a :~similar ?b]]
    [(reaches ?a ?b) [?a :~similar ?x] (reaches ?x ?b)]])

(defn- doc-tx [d]
  {:db/id (get d :id) :doc/title (get d :title) :doc/vec (embed/embed (get d :title))})

;; ── time T1: only the pet documents exist ───────────────────────────
(def r1 (datom/transact! conn (mapv doc-tx (filterv (fn [d] (= (get d :topic) :pets)) relations.corpus/DOCS))))
(def db-t1 (get r1 :db-after))

;; ── time T2: the finance documents arrive ───────────────────────────
(def r2 (datom/transact! conn (mapv doc-tx (filterv (fn [d] (= (get d :topic) :finance)) relations.corpus/DOCS))))
(def db-t2 (get r2 :db-after))

(defn- closure [db]
  (set (mapv (fn [row] [(c/title-of db (get row 0)) (c/title-of db (get row 1))])
             (into [] (datom/q '[:find ?a ?b :in $ % :where (reaches ?a ?b)] db REACH)))))

(c/heading "── semantic closure at T1 (pets only) ──")
(c/show "reachable pairs:" (count (closure db-t1)))

(c/heading "── semantic closure at T2 (pets + finance) ──")
(c/show "reachable pairs:" (count (closure db-t2)))

(c/heading "── the DELTA: conclusions that became true between T1 and T2 ──")
;; set difference — new semantic reachabilities the finance docs introduced.
(def delta (into [] (reduce (fn [acc p] (if (contains? (closure db-t1) p) acc (conj acc p)))
                            [] (into [] (closure db-t2)))))
(doseq [p (sort delta)] (c/show "new" p))

(c/heading "── what to take away ──")
(println "  A relation is basis-relative: evaluated against an old db value it")
(println "  sees the old world, for free (the store is immutable). Diffing two")
(println "  closures across time = what new knowledge followed from what changed.")
(println "  Monitoring and change-detection as a set difference. Next: the catalog.")
