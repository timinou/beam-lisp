; examples/relations/10-relation-polymorphism.bl — a relation is a VALUE.
; Run: mix beam_lisp.run --path priv --path examples examples/relations/10-relation-polymorphism.bl
;
; The apex of first-classness: a relation is so much a citizen that you can
; QUANTIFY OVER relations. A pattern `[?a ?rel ?b]` whose attribute is a
; VARIABLE traverses whatever relation `?rel` is bound to — stored or computed,
; one code path. Bind `?rel` from `:in`, from an upstream clause, or FROM THE
; CATALOG, and one rule becomes polymorphic over the relations themselves.

(ns example.relations.polymorphism
  (:require [datom] [relations.corpus :as c]
            [datom.query.relation :as rel] [datom.query.relations :as rels]))

(rel/defrelation :~similar
  {:arity 2 :modes #{:bf :bb :fb} :tags #{:semantic} :args []
   :provider (rels/hnsw-adjacency :doc/vec {:k 2 :threshold 0.3})})
(rel/defrelation :~same-topic
  {:arity 2 :modes #{:bf :fb} :tags #{:semantic} :args []
   :provider (rels/threshold-adjacency :doc/topic {:tol 0})})

;; a db carrying BOTH the corpus AND the relation catalog as data
(def conn (datom/connect relations.corpus/SCHEMA))
(datom/transact! conn
  (mapv (fn [d] {:db/id (get d :id) :doc/title (get d :title)
                 :doc/topic (get d :topic) :doc/vec (semantic.embed/embed (get d :title))})
        relations.corpus/DOCS))
;; catalog datoms for the two semantic relations
(datom/transact! conn
  (into [] (map-indexed
    (fn [i s] {:db/id (- (+ i 1000)) :relation/ident (get s :ident)
               :relation/tag (into [] (get s :tags))})
    (filterv (fn [s] (contains? #{:~similar :~same-topic} (get s :ident))) (rel/all-specs)))))
(def db (datom/db conn))

(defn- id-of [t] (get (get (into [] (datom/q '[:find ?e :in $ ?t :where [?e :doc/title ?t]] db t)) 0) 0))
(def kitten (id-of "Caring for your new kitten"))

(c/heading "── bind ?rel from :in — traverse WHICHEVER relation you pass ──")
(c/show "via :~similar:"
  (sort (into [] (datom/q '[:find ?tb :in $ ?a ?rel
                            :where [?a ?rel ?b] [?b :doc/title ?tb]]
                          db kitten :~similar))))
(c/show "via :~same-topic:"
  (sort (into [] (datom/q '[:find ?tb :in $ ?a ?rel
                            :where [?a ?rel ?b] [?b :doc/title ?tb]]
                          db kitten :~same-topic))))

(c/heading "── bind ?rel FROM THE CATALOG — traverse every :semantic relation ──")
;; ?rel is chosen by asking the catalog, then used to traverse. One query, and
;; it picks up ANY relation tagged :semantic — including ones added later.
(c/show "reachable from kitten via any :semantic relation:"
  (sort (into [] (datom/q '[:find ?tb :in $ ?a
                            :where [?r :relation/tag :semantic] [?r :relation/ident ?rel]
                                   [?a ?rel ?b] [?b :doc/title ?tb]]
                          db kitten))))

(c/heading "── what to take away ──")
(println "  [?a ?rel ?b] with ?rel a VARIABLE = relation-polymorphism. The rule")
(println "  traverses whatever relation is bound — stored or computed, one path.")
(println "  Bind it from the CATALOG and one query ranges over every :semantic")
(println "  relation, present and future. Relations are values you quantify over.")
