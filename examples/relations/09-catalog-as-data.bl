; examples/relations/09-catalog-as-data.bl — relations describe relations.
; Run: mix beam_lisp.run --path priv --path examples examples/relations/09-catalog-as-data.bl
;
; The deep move datom makes with attributes — the schema is DATA in the same
; log as the facts — extends to every computed relation. A `defrelation`
; describes itself as `:relation/*` datoms, so the catalog is queryable exactly
; like the facts. The system becomes self-describing about its COMPUTED
; knowledge, not just its stored knowledge.

(ns example.relations.catalog
  (:require [datom] [relations.corpus :as c]
            [datom.query.relation :as rel] [datom.query.relations :as rels]))

;; declare a few relations with different tags/modes so the catalog has variety
(rel/defrelation :~similar
  {:arity 2 :modes #{:bf :bb :fb} :tags #{:semantic :embedding} :args []
   :doc "nearest neighbours by embedding"
   :provider (rels/knn-adjacency :doc/vec {:k 2})})
(rel/defrelation :~same-topic
  {:arity 2 :modes #{:bf :fb} :tags #{:semantic :structural} :args []
   :doc "documents sharing a stored topic"
   :provider (rels/threshold-adjacency :doc/topic {:tol 0})})

;; transact each relation's SELF-DESCRIPTION into a db, one entity per relation.
(def conn (datom/connect relations.corpus/SCHEMA))
(def cat-tx
  (into [] (map-indexed
    (fn [i s]
      ;; :relation/tag and :relation/mode are cardinality/many, so pass the
      ;; WHOLE set as one value (a repeated assoc would overwrite).
      {:db/id (- (+ i 1000))
       :relation/ident (get s :ident)
       :relation/extension (get s :extension)
       :relation/arity (get s :arity)
       :relation/doc (or (get s :doc) "")
       :relation/mode (into [] (get s :modes))
       :relation/tag (into [] (or (get s :tags) []))})
    (filterv (fn [s] (contains? #{:~similar :~same-topic} (get s :ident))) (rel/all-specs)))))
(datom/transact! conn cat-tx)
(def db (datom/db conn))

(c/heading "── the catalog is queryable like any facts ──")
(c/show "which relations are :semantic?"
  (sort (into [] (datom/q '[:find ?id
                            :where [?r :relation/tag :semantic] [?r :relation/ident ?id]]
                          db))))

(c/heading "── which relations support the REVERSE (:fb) mode? ──")
(c/show "reverse-capable:"
  (sort (into [] (datom/q '[:find ?id
                            :where [?r :relation/mode :fb] [?r :relation/ident ?id]]
                          db))))

(c/heading "── every relation's self-description ──")
(doseq [r (sort (into [] (datom/q '[:find ?id ?ext ?arity ?doc
                                    :where [?r :relation/ident ?id]
                                           [?r :relation/extension ?ext]
                                           [?r :relation/arity ?arity]
                                           [?r :relation/doc ?doc]]
                                  db)))]
  (c/show "•" r))

(c/heading "── what to take away ──")
(println "  A defrelation describes ITSELF as :relation/* datoms, so the")
(println "  catalog is queryable like the facts. The system can reason about")
(println "  its own computed knowledge — which relations are semantic, which")
(println "  reverse. Next: querying that lets a rule CHOOSE relations at runtime.")
