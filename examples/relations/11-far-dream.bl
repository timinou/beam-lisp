; examples/relations/11-far-dream.bl — every power, in one query.
; Run: mix beam_lisp.run --path priv --path examples examples/relations/11-far-dream.bl
;
; The whole point of making relations first-class citizens: retrieval,
; reasoning, ranking, time-travel, and meta-reasoning stop being five systems
; glued together and become five kinds of CLAUSE over one store. This file
; composes them.
;
; A bolted-on stack (a vector DB + a graph DB + an orchestrator + a feature
; store) needs four consistency models to attempt this, and still cannot give
; you "the ranked reasoning chain, as of a past instant, over whichever
; relations the system considers semantic". Here it is one query, because:
;   • one fixpoint  — computed and stored edges feed the same native solver
;   • one codec     — scores, weights, ids intern through one boundary
;   • one basis     — as-of makes every relation a pure fn of an immutable value

(ns example.relations.far-dream
  (:require [datom] [relations.corpus :as c] [semantic.embed :as embed]
            [datom.query.relation :as rel] [datom.query.relations :as rels]
            [datom.vector :as v]))

;; ── the relations ───────────────────────────────────────────────────

(rel/defrelation :~similar
  {:arity 2 :modes #{:bf :bb :fb} :tags #{:semantic} :args []
   :provider (rels/hnsw-adjacency :doc/vec {:k 2 :threshold 0.3})})

;; a WEIGHTED citation edge (cost = semantic distance), tagged :semantic so the
;; meta-query can discover it. Acyclic (citations), so recursion terminates.
(defn- vec-of [db e] (get (get (into [] (datom/q '[:find ?vv :in $ ?e :where [?e :doc/vec ?vv]] db e)) 0) 0))
(defn- score [db a b]
  (let [hit (first (into [] (v/search (vec-of db a) [[b (vec-of db b)]] 1 0)))]
    (if (nil? hit) 0.0 (get hit 1))))
(rel/defrelation :~cites-cost
  {:arity 3 :modes #{:bf} :tags #{:semantic :weighted} :args []
   :provider (fn [db mode bounds args]
               (mapv (fn [p] [(get p 0) (get p 1) (erlang/round (* 1000 (- 1.0 (score db (get p 0) (get p 1)))))])
                     (into [] (datom/q '[:find ?a ?b :where [?a :doc/cites ?b]] db))))})

;; ── build a store that grows over time, and carries the catalog ─────

(def conn (datom/connect relations.corpus/SCHEMA))
(defn- doc-tx [d] {:db/id (get d :id) :doc/title (get d :title) :doc/topic (get d :topic)
                   :doc/vec (embed/embed (get d :title))
                   :doc/cites (mapv (fn [x] x) (get d :cites))})

;; T1: the first four documents; T2: all eight.
(def r1 (datom/transact! conn (mapv doc-tx (filterv (fn [d] (<= (get d :id) 4)) relations.corpus/DOCS))))
(def r2 (datom/transact! conn (mapv doc-tx (filterv (fn [d] (> (get d :id) 4)) relations.corpus/DOCS))))
;; the catalog, as data, so the query can ask which relations are semantic
(datom/transact! conn
  (into [] (map-indexed
    (fn [i s] {:db/id (- (+ i 1000)) :relation/ident (get s :ident)
               :relation/tag (into [] (get s :tags))})
    (filterv (fn [s] (contains? #{:~similar :~cites-cost} (get s :ident))) (rel/all-specs)))))

(def db-now (datom/db conn))
(def db-t1 (get r1 :db-after))

(defn- id-of [db t] (get (get (into [] (datom/q '[:find ?e :in $ ?t :where [?e :doc/title ?t]] db t)) 0) 0))

;; ── 1. RETRIEVE + REASON + META: reach through any :semantic relation ─

(c/heading "── retrieve+reason+meta: reachable via any :semantic relation ──")
;; ask the catalog which relations are semantic, bind ?rel, traverse them.
(def kitten (id-of db-now "Caring for your new kitten"))
(c/show "from kitten, via catalog-selected :semantic relations:"
  (sort (into [] (datom/q '[:find ?tb :in $ ?a
                            :where [?r :relation/tag :semantic]
                                   [?r :relation/ident ?rel]
                                   [?a ?rel ?b]
                                   [?b :doc/title ?tb]]
                          db-now kitten))))

;; ── 2. RANK: cheapest reasoning chain (arithmetic-in-recursion) ─────

(c/heading "── rank: cheapest citation-reasoning chain from a budget doc ──")
(def PATH
  '[[(path ?a ?b ?c) [?a :~cites-cost ?b ?c]]
    [(path ?a ?b ?c) (path ?a ?x ?cx) [?x :~cites-cost ?b ?w] [(+ ?cx ?w) ?c]]])
(def budget (id-of db-now "A budget for investing your cash"))
(c/show "min cost to each ancestor:"
  (sort (into [] (datom/q '[:find ?tb (min ?c) :in $ % ?src
                            :where (path ?src ?b ?c) [?b :doc/title ?tb]]
                          db-now PATH budget))))

;; ── 3. TIME: the same retrieval, as of T1 (before finance existed) ──

(c/heading "── time: semantic neighbours of an index doc, T1 vs now ──")
;; index-funds doc only exists at T2, so ask about a PET doc that exists at both.
(def feline-now (id-of db-now "A feline guide to the purring cat"))
(c/show "neighbours as of now:"
  (sort (into [] (datom/q '[:find ?tb :in $ ?a :where [?a :~similar ?b] [?b :doc/title ?tb]] db-now feline-now))))
(c/show "neighbours as of T1 (same, pets already all present):"
  (sort (into [] (datom/q '[:find ?tb :in $ ?a :where [?a :~similar ?b] [?b :doc/title ?tb]] db-t1 feline-now))))

;; ── 4. ALL AT ONCE: retrieve by meaning, rank by coherence, filter by topic ─

(c/heading "── all at once: coherent finance chains reachable from budget ──")
(c/show "finance ancestors of budget, ranked by chain cost:"
  (sort-by (fn [r] (get r 1))
    (into [] (datom/q '[:find ?tb (min ?c) :in $ % ?src
                        :where (path ?src ?b ?c)
                               [?b :doc/topic :finance] [?b :doc/title ?tb]]
                      db-now PATH budget))))

(c/heading "── what to take away ──")
(println "  retrieve (similar-to) · reason (recursion) · rank (min over +) ·")
(println "  time (as-of) · meta (catalog-chosen relations) — five kinds of")
(println "  CLAUSE over ONE store, one fixpoint, one basis. No glue layer, no")
(println "  four consistency models. This is what first-class relations buy.")
