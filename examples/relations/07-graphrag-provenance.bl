; examples/relations/07-graphrag-provenance.bl — retrieval that shows its work.
; Run: mix beam_lisp.run --path priv --path examples examples/relations/07-graphrag-provenance.bl
;
; GraphRAG is not "embed → top-k → stuff a prompt". It is a TRAVERSAL: seed by
; meaning, then hop through the knowledge graph — citations AND semantic edges,
; interleaved — collecting the documents that are relevant AND the PATH that
; justified each. That path is the citation the answer needs.
;
; Because a computed relation and a stored one are both just edges, one
; recursive rule mixes them, and a carried ?path column accumulates provenance.
;
;   [(evidence ?d ?path) [?seed :~similar ?d] [(list ?seed ?d) ?path]]
;   [(evidence ?d ?path) (evidence ?x ?p) [?x :doc/cites ?d] [(conj ?p ?d) ?path]]

(ns example.relations.graphrag
  (:require [datom] [relations.corpus :as c]
            [datom.query.relation :as rel] [datom.query.relations :as rels]))

(def db (c/db))

(rel/defrelation :~similar
  {:arity 2 :modes #{:bf :bb :fb} :tags #{:semantic} :args []
   :provider (rels/hnsw-adjacency :doc/vec {:k 2 :threshold 0.3})})

(defn- id-of [t] (get (get (into [] (datom/q '[:find ?e :in $ ?t :where [?e :doc/title ?t]] db t)) 0) 0))

;; Provenance-carrying retrieval. NB: this mixes a computed relation
;; (:~similar) with an arbitrary bl function (conj on the path). A rule with a
;; bl function over a recursive variable runs on the bl fixpoint — the honest
;; boundary: the moment you compute over the path, you leave the native kernel.
;; Correctness is identical; only the evaluator differs. (A native-speed
;; variant drops ?path and recovers it in a second pass.)
;;
;; Seed via :in; the first hop is a similarity edge, then hops follow citations,
;; accumulating the path.
(def EVIDENCE2
  '[[(evidence ?seed ?d ?path) [?seed :~similar ?d] [(list ?seed ?d) ?path]]
    [(evidence ?seed ?d ?path) (evidence ?seed ?x ?p) [?x :doc/cites ?d]
                               [(conj ?p ?d) ?path]]])

(def seed (id-of "Index funds and the interest rate"))

(c/heading "── evidence for a query, WITH the path that justified it ──")
(doseq [r (sort-by (fn [row] (count (get row 1)))
                   (into [] (datom/q '[:find ?td ?path :in $ % ?seed
                                       :where (evidence ?seed ?d ?path) [?d :doc/title ?td]]
                                     db EVIDENCE2 seed)))]
  (c/show "•" [(get r 0) (str "path len " (count (get r 1)))]))

(c/heading "── the same, as human-readable chains ──")
(doseq [r (into [] (datom/q '[:find ?path :in $ % ?seed
                              :where (evidence ?seed ?d ?path)]
                            db EVIDENCE2 seed))]
  (let [titles (mapv (fn [e] (c/title-of db e)) (get r 0))]
    (when (> (count titles) 1) (c/show "chain" titles))))

(c/heading "── what to take away ──")
(println "  Retrieval as a TRAVERSAL: seed by meaning, hop through citations,")
(println "  carry the path. The answer returns evidence AND its justification —")
(println "  the provenance a RAG citation needs. Mixing a computed relation with")
(println "  a bl function (conj) runs on the bl fixpoint: the honest boundary.")
