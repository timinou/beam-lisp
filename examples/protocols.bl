; protocols.bl — defprotocol/extend-type: dispatch on the type tag of
; the first argument (Multi.type_of/1). There is no deftype/defrecord
; here — Elixir structs cover user types via interop, and beam-lisp
; types are the builtin value tags (:vector, :integer, :map, …).
; Run: mix beam_lisp.run examples/protocols.bl

; Its own namespace: examples/multimethods.bl also defines `area`, and
; vars are per-namespace — sharing `user` would let whichever loaded
; last win.
(ns protocols.demo)

(defprotocol Shape (area [this]) (perimeter [this]))

(extend-type :vector Shape
  (area [v] (reduce + 0 v))
  (perimeter [v] (count v)))

(extend-type :integer Shape
  (area [n] (* n n))
  (perimeter [n] (* 4 n)))

(extend-protocol Shape
  :binary (area [s] (count s)) (perimeter [s] (count s))
  :map (area [m] (count m)) (perimeter [m] (count m)))

(println "== protocol dispatch on type tags ==")
(println (str "vector [1 2 3] area:  " (area [1 2 3])))
(println (str "integer 7 area:       " (area 7)))
(println (str "string \"hello\" area:  " (area "hello")))
(println (str "map {:a 1} area:      " (area {:a 1})))
(println (str "integer 5 perimeter:  " (perimeter 5)))

; --- extending a type after the fact, old calls unaffected ---
(extend-type :list Shape
  (area [l] (reduce + 0 l))
  (perimeter [l] (count l)))

(println "== a type extended after the fact ==")
(println (str "list (1 2 3) area:    " (area '(1 2 3))))
(println (str "vector [10 20] still: " (area [10 20])))
