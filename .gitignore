# The image directory bin/bl builds out of symlinks: the app-shaped view of
# `build/` + `priv/` that OTP's lib_dir/priv_dir questions need. Rebuilt on every
# boot; safe to delete at any time.
/.bl/
# Workspace lock anchors when the workspace itself is named .bl.
.bl-locks/
/_build/
/deps
/doc/
*.beam
# EXCEPT the committed bootstrap seed: the AOT-compiled compiler closure that
# lets a fresh clone boot the self-hosted compiler without a genesis fallback.
# These beams are tracked on purpose; the installer copies them into the build
# on first compile. Regenerate: bl build --force --out DIR && bl seed --ebin DIR
# (a clean --out is required — an in-tree build/ is re-poisoned by the OLD floor
# on every boot, which is what made the pre-BUG-048 reseed impossible).
!/priv/bootstrap/seed/*.beam

# The codegen SOURCE digest folded into `AOTCache.compiler_key/0` (BUG-048).
# Derived, written by whichever checkout computes the key, read by an image that
# ships no `.ex` (a release drop) so it computes the same key as the tree it was
# built from. Never hand-edited, never committed — the same rule as priv/z3 and
# priv/native/*.so, which are also built-and-shipped rather than tracked.
priv/codegen.sources
# Generated SDK admission and parsing indexes for a prepared checkout image.
/priv/precompiled.term
/priv/parts/

*.ez
/.spell/
/!sessions/
/projects/

.env
.env.*

.clj-kondo/
.lsp/
.spell/

# crash dumps
erl_crash.dump

# the served site is derived state: the loop rewrites it on every publish
spell/ui/*.edn
spell/ui/build-status.json
spell/ui/.build-status.json.tmp
.fastembed_cache
spell/state/
tmp/

# local prototypes / scratch plans, not tracked
/scratch-*/
/scratch-*.md
.embcache/
.gencache/

# per-checkout state: the analysis store (content-addressed per source, built by
# any verb that reads the codebase) and the dev binaries `.local/blrun` /
# `.local/bltest`. Safe to delete at any time — rebuild: bl search / bl ask.
.local/bl/
# Local task-roster journal: retained on disk, never part of a feature commit.
.local/!journal/

# the harness: its session documents, its bearer token and the mcp.json that
# carries it (see priv/lib/harness/mcp.bl). The token grants `eval` in the
# project VM, so this must never be committed.
.local/harness/
# examples/connectors/03-keep-folder.bl: a real account's sync store (names from Drive)
.local/examples/

# built native artifacts — the whole directory, because the stage installs
# `priv/native/<crate>` with NO extension (the name :erlang.load_nif/2 is
# handed), so a `*.so` rule would leave every one of them untracked-but-
# committable. Rebuild: bl build (the native stage is priv/build/build.bl).
priv/native/*

# bundled z3 solver (rebuild: mix bl.z3.fetch — pinned + sha256-verified).
# No trailing slash: a worktree that shares the main checkout's solver symlinks
# the DIRECTORY here, and a symlink is not a directory to git.
/priv/z3

# the bundled embedding weights (rebuild: mix bl.embed.fetch --bundle — same pin)
# are ignored from INSIDE that directory (priv/embed/.gitignore ignores all but
# itself), so the rule travels with the data it protects.

librarium-cache/
/bl
.tmp/

# editor tooling build artifacts
editors/tree-sitter-beamlisp/node_modules/
editors/emacs/*.elc

/bl.*

# `bl self-build --out ./bl-v<version>` — a drop is 140 MB of built artifact, and
# `/bl.*` does not match a hyphenated tag. Same reason as `/bl` above.
/bl-*

# `bl build`'s output directory when the tree declares no other (env.bl)
/build/

# `bl build`'s CARGO target dir — the native crates under `native/*` write here
# (38 MB after one build). It is a cache, not an artifact: deleting it costs a
# rebuild and nothing else.
#
# Unanchored on purpose: a crate built in place (CARGO_TARGET_DIR unset, e.g.
# `cargo build` inside native/<crate> or research/j1_probe) writes
# <crate>/target, and a rule that only names the root would let that into the
# object database — where it stays forever.
target/

# PLAN-135 repl spike runtime state (private AOT cache + server log)
/.bl-spike-aot/
/.bl-spike-aot.lock
/research/repl-spike/server.log
/.env.local.bl

# durable split logs (bl serve research/split-beam/serve.bl)
/data/

# generated, large, and rebuilt on demand: publication staging trees
# (`.local/foundation-publication-*`), prior native builds kept for comparison, an
# exported agent-session page, and Python bytecode from the task scripts.
.local/foundation-publication-*/
.local/native-prior-*.so
spell-session-*.html
.local/
__pycache__/

# bl-ed: the compiled editor modules are build output (apps/bl-ed/build.sh)
/apps/bl-ed/web/out/

# a nested checkout under apps/ (apps/foundry carries its own .git and a 7 MB
# erl_crash.dump). Named, not apps/ wholesale: apps/bl-ed is part of this tree.
/apps/foundry/
/apps/!tasks/

