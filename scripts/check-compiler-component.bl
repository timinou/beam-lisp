;; Private semantic check through the edited compiler's native front door.
;; This is component evidence; floor reproduction and sealed SDK qualification
;; remain mandatory. Public compatibility Vars are omitted, as the compiler's
;; kernel invariant requires its implementation to use literal getters.
(ns tooling.compiler-component (:require [reader-node :as rn]))
(let [root (System/fetch_env! "BL_TEST_SOURCE_ROOT")
      out (System/fetch_env! "BL_COMPILER_COMPONENT_OUT")
      source (File/read! (Path/join root "priv/boot/compiler.bl"))
      characters (String/to_charlist source)
      forms (BeamLisp.Reader/read_string source "compiler.bl")
      fragments (Enum/flat_map forms
                  (fn [form]
                   (let [node (rn/node-form form)]
                    (if (and (= :list (rn/node-tag node))
                             (contains? #{"ns" "defn" "defn-"}
                               (rn/node-name (first (rn/node-items node)))))
                     (let [position (elem form 2)]
                      (list (List/to_string (Enum/slice characters (:offset position)
                                               (- (:end-offset position) (:offset position))))))
                     (list)))))
      program (String/replace (Enum/join fragments "\n") "(ns compiler" "(ns compiler-component"
                              (list (tuple :global false)))
      path (Path/join out "compiler.bl")
      started (erlang/monotonic_time :millisecond)]
 (when (ets/member :beam_lisp_vars :bl_sdk_runtime_lease)
  (throw (ex-info "Compiler component VM already owns an SDK" {})))
 (File/mkdir_p! out) (File/write! path program)
 (BeamLisp.AOT/compile_host_file (Path/join root "priv/host/server.bl")
  (list (tuple :module :Elixir.BeamLisp.Server) (tuple :output_dir out) (tuple :load? true)))
 (BeamLisp.AOT/compile_host_file path
  (list (tuple :module :Elixir.BeamLisp.CompilerComponent) (tuple :output_dir out) (tuple :load? true)))
 (let [facade (String/replace (File/read! (Path/join root "priv/host/compiler.bl"))
                  "Elixir.BeamLisp.Ns.Compiler" "Elixir.BeamLisp.CompilerComponent")
       path (Path/join out "facade.bl")]
  (File/write! path facade)
  (BeamLisp.AOT/compile_host_file path
   (list (tuple :module :Elixir.BeamLisp.Compiler) (tuple :output_dir out) (tuple :load? true))))
 (println "Edited compiler component prepared in" (- (erlang/monotonic_time :millisecond) started) "ms")
 (let [identity (BeamLisp.Compiler/module_info :md5)
       paths (String/split (System/fetch_env! "BL_COMPILER_COMPONENT_TESTS") "\n" (list (tuple :trim true)))
       result (BeamLisp.TestRT/run_suite paths (list))]
  (when-not (= identity (BeamLisp.Compiler/module_info :md5))
   (throw (ex-info "SDK retention replaced the edited compiler facade" {})))
  (println "EDITED COMPILER COMPONENT" (Kernel/inspect result))
  (System/halt (if (= 0 (+ (:fail result) (:error result))) 0 1))))
