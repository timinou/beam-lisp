;; Run through the immutable source archive's own bin/bl, with cwd=archive.
(ns tooling.build-source-sdk
 (:require [selfbuild :as sdk] [build :as native] [provenance :as provenance]
           [seed :as seed]))
(let [root (System/cwd)
      scratch (System/get_env "BL_SDK_SCRATCH")
      commit (System/get_env "BL_SDK_SOURCE_COMMIT")
      launcher (System/get_env "BL_SDK_LAUNCHER")
      output (System/get_env "BL_SDK_OUTPUT")
      source-repo (System/get_env "BL_SDK_SOURCE_REPO")]
 (when-not (every? (fn [v] (and (string? v) (not= "" v))) [scratch launcher output source-repo])
  (throw (ex-info "Set BL_SDK_SCRATCH, BL_SDK_LAUNCHER, BL_SDK_OUTPUT and BL_SDK_SOURCE_REPO" {})))
 (when-not (and (string? commit) (= 40 (String/length commit))
                (every? #(includes? "0123456789abcdef" %) (String/codepoints commit)))
  (throw (ex-info "Exact committed SDK source identity is required" {})))
 (when-not (= (File/stat! (str root "/priv")) (File/stat! (BeamLisp.Tiers/priv_root)))
  (throw (ex-info "SDK builder is not running the archived source image" {:root root :priv (BeamLisp.Tiers/priv_root)})))
 ;; A source stamp cannot make an old pinned host ABI current. Release assembly
 ;; copies the running substrate; judge the entire committed floor first.
 (let [floor (seed/check {:root root})]
  (when-not (:ok? floor)
   (throw (ex-info "SDK bootstrap floor differs from committed source; regenerate and commit it first"
            {:kind :sdk-bootstrap-source-drift :floor floor}))))
 (let [natives (native/build-native root println)]
  (println {:native-build natives})
  (when (seq (:errors natives))
   (throw (ex-info "Native sources did not produce a complete SDK" {:errors (:errors natives)}))))
 (let [identity (assoc (provenance/collect root)
                  :source-repo source-repo
                  :worktree root :branch "main"
                  :remote "git@github.com:timinou/beam-lisp.git"
                  :commit commit :source-key commit :dirty false :diffhash nil)
       result (sdk/run {:bin launcher :out output
                        :scratch scratch
                        :jobs 4 :provenance identity})]
  (println {:sdk-build result})
  (when-not (:ok? result) (throw (ex-info "Fresh standalone SDK assembly failed" {:errors (:errors result)})))))
