;; Prepare native libraries and application metadata without rebuilding the compiler.
(ns tooling.prepare-release
  (:require [build :as native] [app-resource :as ar] [bl.env :as env]))
(let [root (System/cwd)
      project (env/literal (Path/join root "env.bl"))
      built (native/build-native root println)]
  (when (seq (:errors built))
    (throw (ex-info "Release native build failed" {:errors (:errors built)})))
  (when-not (:ok project)
    (throw (ex-info "Release requires a literal project declaration" {:project project})))
  (let [app (ar/write-project! (:ok project) (Path/join root "build"))]
    (when-not (:ok? app)
      (throw (ex-info "Release application metadata failed" app))))
  (println {:release-natives built :application (:app (:ok project))}))
