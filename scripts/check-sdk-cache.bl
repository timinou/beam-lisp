;; A successful SDK assembly alone does not prove that shards can reuse its
;; addressed units. Read representative complete entries through the real
;; validator before transferring the prepared store.
(ns ci.sdk-cache)

(let [out (Path/join (System/tmp_dir!)
            (str "bl-sdk-cache-check-" (erlang/unique_integer (list :positive))))]
 (try
  (BeamLisp.AOT/with_source_snapshot
   (fn []
    (doseq [namespace ["errors" "proc.server" "eval.closed"]]
     (let [key (BeamLisp.AOTCache/key_for_ns namespace)
           closure (BeamLisp.AOT/ns_closure_hash namespace)
           result (BeamLisp.AOTCache/fetch key closure out)]
      (when-not (and (erlang/is_tuple result) (= :ok (elem result 0))
                    (> (count (elem result 1)) 1))
       (throw (ex-info "SDK cache publication failed"
                {:namespace namespace :compiler-key key :closure closure})))
      (println "Verified SDK cache" namespace (count (elem result 1)) "modules")))))
  (finally (File/rm_rf! out))))
