#!/bin/sh
# Regenerate the bootstrap floor (priv/bootstrap/seed) from this tree's sources.
#
#   scripts/regenerate-seed [OUTPUT_DIR]        generate into OUTPUT_DIR (review only)
#   BL_BOOTSTRAP_INSTALL=1 scripts/regenerate-seed [OUTPUT_DIR]   ... and install it
#
# WHY A BARE VM. `bl run scripts/regenerate-seed.bl` can never work: the launcher
# takes an SDK/application lease before the script runs, and regeneration needs
# a VM that holds no custody at all (it reloads the compiler hosts it compiles).
# This script builds the same code path `bin/bl` does and starts the application
# and the compiler directly, with no launcher, no daemon and no SDK lease.
#
# The VM is capped (systemd-run MemoryMax when available) and gets every core:
# the boot tier and host compiles are parallel where their dependencies allow.
set -eu
ROOT=$(CDPATH='' cd "$(dirname "$0")/.." && pwd -P)
OUT=${1:-${BL_BOOTSTRAP_OUTPUT:-$ROOT/.bl/regen/$(date +%Y%m%dT%H%M%S)}}
case "$OUT" in /*) ;; *) OUT=$PWD/$OUT ;; esac
if [ -d "$OUT" ] && [ -n "$(ls -A "$OUT" 2>/dev/null)" ]; then
  echo "regenerate-seed: output dir must be empty or absent: $OUT" >&2; exit 64
fi
mkdir -p "$OUT"

EBIN=${BEAM_LISP_EBIN:-$ROOT/build}
[ -d "$EBIN" ] || { echo "regenerate-seed: no build image at $EBIN; run ./bin/bl once first" >&2; exit 66; }
IMAGE=$ROOT/.bl/lib/beam_lisp-0.1.0
[ -e "$IMAGE/ebin" ] || { echo "regenerate-seed: no image links under $IMAGE; run ./bin/bl once first" >&2; exit 66; }

# Library code path, computed exactly as bin/bl computes it.
PA=""
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/beam_lisp/ebin
TAG=$(elixir -e 'IO.write("erts#{:erlang.system_info(:version)}-elixir#{System.version()}")')
for d in "$ROOT"/deps/*/ebin "$CACHE"/*-"$TAG"/ebin; do
  [ -d "$d" ] && PA="$PA -pa $d"
done
PA="$PA -pa $IMAGE/ebin"

N=$(nproc 2>/dev/null || echo 4)
ERL_OPTS="+S $N:$N +SDcpu $N:$N +SDio $N:$N"
DRIVER=$(mktemp "${TMPDIR:-/tmp}/regen-seed-XXXXXX.exs")
trap 'rm -f "$DRIVER"' EXIT
cat > "$DRIVER" <<'EOF'
Application.load(:beam_lisp)
for app <- Application.spec(:beam_lisp, :applications) || [], do: {:ok, _} = Application.ensure_all_started(app)
BeamLisp.AOT.boot()
BeamLisp.with_argv([System.fetch_env!("BL_ROOT")], fn ->
  BeamLisp.run_file(Path.join(System.fetch_env!("BL_ROOT"), "scripts/regenerate-seed.bl"))
end)
EOF

set -- env BL_ROOT="$ROOT" BL_BOOTSTRAP_OUTPUT="$OUT" BL_DAEMON=off \
  BL_BOOTSTRAP_INSTALL="${BL_BOOTSTRAP_INSTALL:-}" ELIXIR_ERL_OPTIONS="$ERL_OPTS" \
  elixir $PA "$DRIVER"
if command -v systemd-run >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
  set -- systemd-run --user --collect --wait --pipe --quiet --working-directory="$ROOT" \
    --property=MemoryMax="${BL_REGEN_MEMORY_MAX:-8G}" --property=MemorySwapMax=1G "$@"
fi
echo "regenerate-seed: $ROOT -> $OUT (${N} schedulers)" >&2
"$@"
