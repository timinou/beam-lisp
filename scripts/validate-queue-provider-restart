#!/usr/bin/env bash
set -euo pipefail
root_dir=$(cd "$(dirname "$0")/.." && pwd)
mkdir -p "${HOME}/tmp/live-upgrade-queue"
run_dir=$(mktemp -d "${HOME}/tmp/queue-provider-restart.XXXXXX")
export TMPDIR="${HOME}/tmp/live-upgrade-queue"
export BL_QUEUE_RESTART_PATH="$run_dir"
cd "$root_dir"
set +e
BL_QUEUE_RESTART_PHASE=submit ./bin/bl run '!tasks/acceptance/queue-provider-restart.bl'
submit_status=$?
set -e
if [ "$submit_status" -ne 73 ]; then
  printf 'Expected deliberate abrupt exit 73, received %s\n' "$submit_status" >&2
  exit 1
fi
BL_QUEUE_RESTART_PHASE=recover ./bin/bl run '!tasks/acceptance/queue-provider-restart.bl'
printf 'Restart evidence: %s\n' "$run_dir"
