;; Install a completely generated floor; the manifest is published last.
(ns tooling.install-seed)
(let [args (BeamLisp/argv)
      _ (when (> (count args) 1)
          (throw (ex-info "Usage: install-seed.bl [source-root]" {})))
      root (Path/expand (or (first args) (System/cwd))) source (System/get_env "BL_BOOTSTRAP_SEED")
      destination (str root "/priv/bootstrap/seed")
      digest (fn [bytes] (Base/encode16 (crypto/hash :sha256 bytes) (list (tuple :case :lower))))]
 (when-not (and (string? source) (not= "" source))
  (throw (ex-info "Set BL_BOOTSTRAP_SEED to the completed output/seed directory" {})))
 (when-not (= (File/stat! (str root "/priv")) (File/stat! (BeamLisp.Tiers/priv_root)))
  (throw (ex-info "Install must run through this source tree's bin/bl" {})))
 (let [manifest-bytes (File/read! (str source "/manifest.term"))
       parsed (file/consult (str source "/manifest.term"))]
  (when-not (and (= :ok (elem parsed 0)) (= 1 (count (elem parsed 1)))
                (map? (first (elem parsed 1)))
                (= manifest-bytes (File/read! (str source "/manifest.term"))))
   (throw (ex-info "Generated manifest must contain one stable data map" {})))
  (let [manifest (first (elem parsed 1)) app (get manifest "app")
        declared (assoc (get manifest "modules") (get app "file") (get app "sha256"))
        names (conj (set (keys declared)) "manifest.term")]
   (when-not (and (BeamLisp.Bootstrap/key_matches? manifest)
                 (> (count declared) 0) (string? (get app "file"))
                 (= names (set (File/ls! source)))
                 (every? (fn [name]
                           (and (string? name) (= name (Path/basename name))
                                (or (String/ends_with? name ".beam") (= name (get app "file")))))
                         (keys declared)))
    (throw (ex-info "Generated floor inventory or source identity is inconsistent" {})))
   ;; A matching compiler key alone cannot detect runtime-only host drift.
   ;; Use the existing complete source-floor judge before publishing any bytes.
   (BeamLisp.Env/add_search_path (str root "/priv/build"))
   (BeamLisp.Loader/ensure_loaded "seed")
   (let [checked (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! "seed" "check")
                   (list {:root root :out source}))]
    (when-not (:ok? checked)
     (throw (ex-info "Generated floor no longer matches current sources" {:check checked}))))
   ;; Read and verify all bytes before changing any installed file. Publication
   ;; uses this snapshot rather than rereading a potentially changing candidate.
   (let [files (into {} (map (fn [[name expected]]
                             (let [path (str source "/" name) bytes (File/read! path)]
                              (when-not (and (= :regular (:type (File/lstat! path)))
                                              (= expected (digest bytes)))
                               (throw (ex-info "Generated floor digest mismatch" {:file name})))
                              [name bytes])) declared))
         publish (fn [name bytes]
                   (let [path (str destination "/" name)
                         temporary (str path ".installing-" (erlang/unique_integer (list :positive)))]
                    (File/write! temporary bytes) (File/rename! temporary path)))]
    (let [existing (if (File/dir? destination) (File/ls! destination) [])]
     (doseq [name existing]
      (when-not (or (contains? names name) (String/ends_with? name ".beam") (String/ends_with? name ".app"))
       (throw (ex-info "Unexpected file in installed bootstrap floor" {:file name}))))
     (File/mkdir_p! destination)
     (doseq [[name bytes] files] (publish name bytes))
     (doseq [name existing]
      (when-not (contains? names name) (File/rm! (str destination "/" name)))))
    (publish "manifest.term" manifest-bytes)
    (println {:status :installed :files (count names) :manifest-sha256 (digest manifest-bytes)})))))
