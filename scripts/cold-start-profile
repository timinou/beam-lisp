#!/bin/sh
# Measure `bin/bl` cold starts: wall time per run, plus deterministic counters
# (modules loaded, apps started, file calls, compile calls, persistent_term and
# ETS counts) from one instrumented run.
#
#   scripts/cold-start-profile [N] [SCRIPT.bl]
#
# Wall time on a busy host is noisy; read the spread, and gate on the counters.
# Every run is a fresh VM (`--cold`), the same script, the same tree.
set -eu
ROOT=$(CDPATH='' cd "$(dirname "$0")/.." && pwd -P)
N=${1:-5}
SCRIPT=${2:-}
if [ -z "$SCRIPT" ]; then
  SCRIPT=$(mktemp "${TMPDIR:-/tmp}/bl-cold-XXXXXX.bl")
  trap 'rm -f "$SCRIPT"' EXIT
  echo '(println :ok)' > "$SCRIPT"
fi
ms() { date +%s%3N; }
times=""
i=0
while [ "$i" -lt "$N" ]; do
  t0=$(ms)
  "$ROOT/bin/bl" --cold run "$SCRIPT" >/dev/null 2>&1 || { echo "cold-start-profile: run failed" >&2; exit 1; }
  t1=$(ms)
  times="$times $((t1 - t0))"
  i=$((i + 1))
done
echo "wall_ms:$times"
echo "$times" | tr ' ' '\n' | grep -v '^$' | sort -n | awk '{a[NR]=$1} END {printf "min=%d median=%d max=%d\n", a[1], a[int((NR+1)/2)], a[NR]}'
# Counters (one instrumented run; the launcher halts through the seam that prints them).
BL_PROFILE=1 "$ROOT/bin/bl" --cold run "$SCRIPT" 2>&1 >/dev/null | grep -E '^bl-(profile|count)' || true
