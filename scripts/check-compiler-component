#!/usr/bin/env python3
"""Check edited compiler semantics against a complete SDK before rebuilding its floor.

Tests must exercise BeamLisp.Compiler's front door. Namespace-level compiler
imports still name the frozen SDK; this check is not compiler-floor or release
qualification. Only this private VM's native compiler and server are replaced.
"""
import argparse
import os
from pathlib import Path
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
BOOT = '''Application.load(:beam_lisp)
for app <- Application.spec(:beam_lisp, :applications) || [], do: {:ok, _} = Application.ensure_all_started(app)
BeamLisp.AOT.boot()
BeamLisp.run_file(Path.join(System.fetch_env!("BL_TEST_SOURCE_ROOT"), "scripts/check-compiler-component.bl"))
'''


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--sdk-image", type=Path, required=True)
    parser.add_argument("--work-dir", type=Path)
    parser.add_argument("tests", nargs="*", default=["test/bl/server_return_model_test.bl"])
    args = parser.parse_args()
    image = args.sdk_image.resolve()
    if not all((image / name).is_file() for name in
               ("priv/precompiled.term", "priv/sdk-code.term", "priv/bootstrap/seed/manifest.term")):
        parser.error("--sdk-image must name a complete, sealed SDK application")
    with tempfile.TemporaryDirectory(prefix="bl-compiler-component-") as temporary:
        work = args.work_dir.resolve() if args.work_dir else Path(temporary)
        work.mkdir(parents=True, exist_ok=True)
        driver = work / "bootstrap.exs"
        driver.write_text(BOOT)
        command = ["systemd-run", "--user", "--collect", "--wait", "--pipe", "--quiet",
                   f"--working-directory={ROOT}", "--property=MemoryMax=6G",
                   "--property=MemorySwapMax=0", "--property=RuntimeMaxSec=300",
                   f"--setenv=PATH={os.environ.get('PATH', '')}", f"--setenv=BL_ROOT={image}",
                   f"--setenv=BL_TEST_SOURCE_ROOT={ROOT}", "--setenv=BL_DAEMON=off",
                   f"--setenv=BL_COMPILER_COMPONENT_OUT={work}",
                   f"--setenv=BL_COMPILER_COMPONENT_TESTS={chr(10).join(args.tests)}",
                   "--setenv=ELIXIR_ERL_OPTIONS=+S 4:4 +SDcpu 2:2 +SDio 1:1", "elixir"]
        for path in sorted(image.parent.glob("*/ebin")):
            command += ["-pa", str(path)]
        command += ["-pa", str(image / "ebin"), str(driver)]
        return subprocess.call(command, cwd=ROOT)


if __name__ == "__main__":
    raise SystemExit(main())
