;; One-shot official bootstrap regeneration from current MAIN host sources.
;; Run in the owned capped VM; install output only after the whole run passes.
(ns tooling.regenerate-seed)

(defn- bootstrap-project-app! [root]
 ;; Read this physical tree afresh. A provisioning VM may have no CLI project,
 ;; and an inherited command project must never label another tree's floor.
 (BeamLisp.Loader/ensure_loaded "bl.env")
 (BeamLisp.Loader/ensure_loaded "app-resource")
 (let [project (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! "bl.env" "project") (list root))
       expected-root (Path/expand root)
       app (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! "app-resource" "of-project") (list project))]
  (when-not (and (= expected-root (:root project))
                 (= (Path/join expected-root "env.bl") (:path project))
                 (empty? (:errors project)) (= true (:ok? app)))
   (throw (ex-info "Current physical bootstrap project is invalid"
                  {:kind :bootstrap-project-invalid :root expected-root
                   :project-errors (:errors project) :app-error (:why app)})))
  app))

(defn regenerate-source-floor! [root output]
 (when-not (and (string? output) (not= "" output))
  (throw (ex-info "Set BL_BOOTSTRAP_OUTPUT to an owned scratch directory" {})))
 ;; Project refusal precedes host compilation, build work or output writes.
 (let [hosts (str output "/fresh-hosts")
      ebin (str output "/ebin")
      floor (str output "/seed")
      original-ns (BeamLisp.Env/current_ns)
      captured (BeamLisp.Env/capture)]
 ;; Recovery can run this script through a coherent older source launcher;
 ;; all provenance is still anchored on the explicit CURRENT source tree.
 ;; A source CLI has a process-local OS-env overlay. Compiler provenance
 ;; deliberately reads the physical launcher root through raw System, so
 ;; change that native process environment explicitly for this one-shot build.
 (erlang/apply :Elixir.System :put_env (list "BL_ROOT" root))
 ;; Tiers resolves priv/ through OTP application-image shape, separately from
 ;; BL_ROOT. Prefer MAIN's valid image while preserving already warm substrate.
 (Code/prepend_path (str root "/.bl/lib/beam_lisp-0.1.0/ebin"))
 (when-not (= (File/stat! (str root "/priv")) (File/stat! (BeamLisp.Tiers/priv_root)))
  (throw (ex-info "Build image does not resolve current MAIN priv" {:actual (BeamLisp.Tiers/priv_root)})))
 (BeamLisp.Env/add_search_path (str root "/priv/build"))
 (let [app (bootstrap-project-app! root)]
 (File/mkdir_p! hosts)
 ;; Compile the entire changed host ABI before loading any replacement.
 ;; AOT/Loader/Env and compiler-generated classes call each other. Loading AOT
 ;; first can call a new guard against the old Loader during regeneration.
 ;; All compilation uses the coherent recovery compiler; only after every host
 ;; emits successfully do we load the coherent replacement set in this VM.
 ;; LazyMemo is emitted for the NEXT VM only. Its native library deliberately
 ;; has no reload/upgrade callback: the recovery VM already owns resources from
 ;; the old library. Loading another wrapper here would mix incompatible native
 ;; lifetimes. seed/run recompiles and checks its on-disk source provenance
 ;; without loading it; a fresh process accepts the complete floor afterwards.
 (let [compiled
       (BeamLisp.Env/with_ns original-ns
        (fn []
         (mapv
          (fn [[leaf module]]
           (let [source (str root "/priv/host/" leaf)
                 digest (Base/encode16 (crypto/hash :sha256 (File/read! source)) (list (tuple :case :lower)))]
            (try
             (let [result (BeamLisp.AOT/compile_host_file source
                           (list (tuple :module module) (tuple :output_dir hosts)
                                 (tuple :source_hash digest) (tuple :load? false)))]
              (println {:compiled-host module :artifact result})
              result)
             (finally (BeamLisp.Env/bind captured)))))
          [["env.bl" :Elixir.BeamLisp.Env]
           ["loader.bl" :Elixir.BeamLisp.Loader]
           ["record.bl" :Elixir.BeamLisp.Record]
           ["refs.bl" :Elixir.BeamLisp.Refs]
           ["lazy_memo.bl" :Elixir.BeamLisp.LazyMemo]
           ["compiler_data.bl" :Elixir.BeamLisp.CompilerData]
           ["source_graph.bl" :Elixir.BeamLisp.SourceGraph]
           ["ns_interface.bl" :Elixir.BeamLisp.NamespaceInterface]
           ["build_plan.bl" :Elixir.BeamLisp.BuildPlan]
           ["compiler.bl" :Elixir.BeamLisp.Compiler]
           ["aot_cache.bl" :Elixir.BeamLisp.AOTCache]
           ["aot.bl" :Elixir.BeamLisp.AOT]
           ["server.bl" :Elixir.BeamLisp.Server]
           ["supervisor.bl" :Elixir.BeamLisp.Supervisor]
           ["bootstrap.bl" :Elixir.BeamLisp.Bootstrap]
           ["application.bl" :Elixir.BeamLisp.Application]])))]
  (doseq [result compiled]
   (let [module (elem result 0) path (elem result 1)
         native-only? (= module :Elixir.BeamLisp.LazyMemo)]
    (if native-only?
     (println {:next-vm-host module :artifact result :loaded? false})
     (let [loaded (code/load_binary module (String/to_charlist path) (File/read! path))]
      (when-not (= loaded (tuple :module module))
       (throw (ex-info "Fresh host load failed" {:module module :result loaded})))
      (println {:fresh-host module :artifact result}))))))
 ;; Native-owned fresh recovery seam BEFORE compiler boot / guarded Ref use.
 ;; Hotloaded Env does not rerun start_link. No Root/Source caller may create
 ;; these tables or adopt rows from an earlier custody/runtime lifetime.
 (doseq [[name arity] [[:initialize_native_commands! 0] [:source_ensure_private! 0]
                       [:source_execution_observation! 0] [:source_push! 2] [:source_leave! 1]
                       [:assert_native_framework_execution! 0] [:register_native_command! 3]
                       [:begin_native_command_boundary! 1] [:end_native_command_boundary! 2]
                       [:assert_native_command_context! 1] [:assert_native_command_bootstrap_context! 1]
                       [:dispatch_native_command! 2] [:with_native_command_callback! 1]
                       [:assert_native_command_turn! 1] [:refresh_native_command_cells! 1]
                       [:assert_native_command_census_context! 1] [:assert_critical_cell_mutation! 2]
                       [:native_command_critical_active? 0] [:native_command_unknown! 1]
                       [:native_command_retirement_blocker! 1] [:native_start_table_evidence! 0]]]
  (when-not (erlang/function_exported :Elixir.BeamLisp.Env name arity)
   (throw (ex-info "Coupled native Source/command ABI is not installed"
                  {:kind :bootstrap-native-command-abi-missing :function name :arity arity}))))
 (when (or (ets/member :beam_lisp_vars :bl_sdk_runtime_lease)
           (not= 0 (ets/info :beam_lisp_owner_index :size)))
  (throw (ex-info "Fresh native recovery required before SDK/application custody"
                 {:kind :bootstrap-native-command-recovery-not-fresh})))
 (BeamLisp.Env/initialize_native_commands!)
 (BeamLisp.Env/native_start_table_evidence!)
 (let [owner (Process/whereis :Elixir.BeamLisp.Env)
       tables [[:beam_lisp_vars :public :set] [:beam_lisp_code_leases :public :ordered_set]
               [:beam_lisp_owner_index :public :ordered_set] [:beam_lisp_owner_revisions :public :set]
               [:beam_lisp_server_starts :private :set] [:beam_lisp_owner_transitions :private :set]
               [:beam_lisp_owner_transition_heads :private :set] [:beam_lisp_server_initializers :private :set]
               [:beam_lisp_source_extents :private :set] [:beam_lisp_source_lease_domains :private :set]
               [:beam_lisp_source_extent_heads :protected :set]
               [:beam_lisp_native_commands :private :set] [:beam_lisp_native_command_frames :private :set]
               [:beam_lisp_native_command_effects :private :set]
               [:beam_lisp_native_owned_starts :private :set] [:beam_lisp_native_launches :private :set]
               [:beam_lisp_native_start_code :protected :set]]]
  (when-not (erlang/is_pid owner) (throw (ex-info "Actual Env is absent" {:kind :bootstrap-native-env-missing})))
  (doseq [[table protection type] tables]
   (when-not (and (= owner (ets/info table :owner)) (= protection (ets/info table :protection))
                  (= type (ets/info table :type)))
    (throw (ex-info "Actual native table custody mismatch"
                   {:kind :bootstrap-native-table-custody :table table}))))
  (doseq [table [:beam_lisp_native_commands :beam_lisp_native_command_frames :beam_lisp_native_command_effects
                 :beam_lisp_source_extents :beam_lisp_source_lease_domains :beam_lisp_native_owned_starts
                 :beam_lisp_native_launches :beam_lisp_native_start_code]]
   (when-not (= 0 (ets/info table :size))
    (throw (ex-info "Fresh native custody table is not empty" {:kind :bootstrap-native-table-live :table table}))))
  (when (or (ets/member :beam_lisp_vars :bl_sdk_runtime_lease)
            (not= 0 (ets/info :beam_lisp_owner_index :size))
            (BeamLisp.Env/native_command_critical_active?))
   (throw (ex-info "Fresh initializer admitted unexpected custody" {:kind :bootstrap-native-custody-created})))
  (println {:native-command-initialization :actual-env-owned :custody-tables (count tables)
            :private 11 :protected 2 :public 4 :sdk-lease? false :owner-rows 0}))
 ;; Exercise current native emitter compatibility against the actual recovery
 ;; Core before any expensive boot-unit compilation. This constructs IR only;
 ;; no generated factory/initializer runs and no SDK authority is published.
 (println {:bootstrap-callable-materialization
           (BeamLisp.AOT/assert_bootstrap_callable_materialization!)})
 ;; Current CompilerData is already loaded. Check the pure Symbol/metadata
 ;; validator before compiling any boot unit; no callbacks or SDK authority.
 (println {:bootstrap-metadata-symbol-data
           (BeamLisp.CompilerData/assert_bootstrap_metadata_symbol_data!)})
 ;; Recovery changes the physical source root: both tier memo keys must move.
 ;; The build key includes compiler identity and cannot retain the old root.
 (BeamLisp.AOTCache/reset_keys)
 (println {:physical-root (erlang/apply :Elixir.System :get_env (list "BL_ROOT"))
           :priv-root (BeamLisp.Tiers/priv_root)
           :compiler-key (BeamLisp.AOTCache/compiler_key)})
 ;; Resolve driver functions only after both current native hosts are loaded;
 ;; no ns :require or cached driver call can race ahead of that boundary.
 (doseq [name ["build" "seed" "app-resource"]]
  (BeamLisp.Loader/ensure_loaded name))
 (BeamLisp/eval (File/read! (str root "/priv/build/seed.bl")))
 (BeamLisp.Env/bind captured)
 (let [sources (conj (vec (Path/wildcard (str root "/priv/boot/*.bl")))
                     (str root "/priv/std/multi.bl"))
       expected-key (BeamLisp.AOTCache/compiler_key)
       built (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! "build" "run")
               (list {:sources sources :out ebin :jobs 2 :scope :scoped :log println}))]
  (println {:build built})
  (when (seq (:errors built))
   (throw (ex-info "Current-host keyed bootstrap build failed" {:errors (:errors built)})))
  (let [seeded (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! "seed" "run")
                 (list {:root root :ebin ebin :out floor :app app}))]
   (println {:seed seeded})
   (when-not (:ok? seeded)
    (throw (ex-info "Current-host bootstrap seed failed" {:errors (:errors seeded)})))
   (BeamLisp.AOTCache/reset_keys)
   (when-not (= expected-key (BeamLisp.AOTCache/compiler_key))
    (throw (ex-info "Compiler source moved during seed generation" {:expected expected-key :actual (BeamLisp.AOTCache/compiler_key)})))
   (when-not (= expected-key (:compiler-key seeded))
    (throw (ex-info "Seed compiler identity differs from fresh native compiler" {:expected expected-key :actual (:compiler-key seeded)})))
   ;; Runtime-only host edits do not rotate compiler_key. Check every pinned
   ;; host source hash too, after the entire floor has been produced.
   (let [checked (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! "seed" "check")
                   (list {:root root :out floor}))]
    (when-not (:ok? checked)
     (throw (ex-info "Generated bootstrap floor differs from current sources" {:check checked})))
    (println {:source-floor-check checked}))
   (println {:status :ready-to-install :seed floor
             :compiler-key (BeamLisp.AOTCache/compiler_key)
             :install-order [:beams :app :manifest-last]})
   ;; Recovery may not be able to start MAIN until this floor is installed.
   ;; Keep installation in the already warmed VM, using the same complete
   ;; source/hash validator and manifest-last publisher as a separate install.
   ;; Generation remains review-only by default; explicit 1 requests install.
   (when (= "1" (System/get_env "BL_BOOTSTRAP_INSTALL"))
    (System/put_env "BL_BOOTSTRAP_SEED" floor)
    (BeamLisp/eval (File/read! (str root "/scripts/install-seed.bl")))))))))


(regenerate-source-floor! (System/cwd) (System/get_env "BL_BOOTSTRAP_OUTPUT"))
