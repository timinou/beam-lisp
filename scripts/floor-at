#!/bin/sh
# Reproduce the committed bootstrap floor at any commit that has one.
#
#   scripts/floor-at [--keep] [--dir DIR] [--output DIR] COMMIT
#
# A floor is a claim about a commit: its beams and manifest.term are exactly
# what that commit's own regenerator emits from its own sources. This script
# proves or disproves that claim without touching the working checkout:
#
#   1. add a detached throwaway worktree at COMMIT (under $TMPDIR or --dir);
#   2. stage a coherent image for that tree: build/ holds the committed seed
#      beams, .bl/lib/beam_lisp-0.1.0/{ebin,priv} point at build/ and priv/,
#      and the gitignored priv/native, priv/z3 and priv/codegen.sources are
#      reflink-copied from this checkout;
#   3. run that commit's scripts/regenerate-seed with BL_REGEN_FROM_SCRATCH=1
#      into a scratch output directory;
#   4. compare every beam and manifest.term with the committed floor.
#
# Prints one line:
#   <sha> reproduces
#   <sha> differs (<n>/<m> beams, manifest same|differs)
#
# Exit status: 0 reproduces, 1 differs, 2 setup or regeneration failure.
# The worktree is always removed. The regenerated floor is removed unless
# --keep is given, in which case its path is printed on standard error.
#
# Commits before v2026.7 have no content-addressed floor and no regenerator;
# they fail immediately with status 2.
set -eu

REPO=$(CDPATH='' cd "$(dirname "$0")/.." && pwd -P)
KEEP=0
BASE=${TMPDIR:-/tmp}
OUT=

usage() {
  cat >&2 <<'EOF'
usage: scripts/floor-at [--keep] [--dir DIR] [--output DIR] COMMIT

  --keep        keep the regenerated floor and print its path
  --dir DIR     create the throwaway worktree under DIR (default $TMPDIR)
  --output DIR  write the regenerated floor to DIR (default a temp directory)
EOF
}

fail() {
  echo "floor-at: $*" >&2
  exit 2
}

while [ $# -gt 0 ]; do
  case $1 in
    --keep) KEEP=1; shift ;;
    --dir) [ $# -ge 2 ] || { usage; exit 2; }; BASE=$2; shift 2 ;;
    --output) [ $# -ge 2 ] || { usage; exit 2; }; OUT=$2; shift 2 ;;
    -h|--help) usage; exit 2 ;;
    --) shift; break ;;
    -*) echo "floor-at: unknown option $1" >&2; usage; exit 2 ;;
    *) break ;;
  esac
done
[ $# -eq 1 ] || { usage; exit 2; }
COMMIT=$1

# Resolve directories before changing into anything; --output is handed to the
# regenerator, which runs with the worktree as its cwd.
case $BASE in /*) ;; *) BASE=$PWD/$BASE ;; esac
case $OUT in ''|/*) ;; *) OUT=$PWD/$OUT ;; esac

[ -d "$BASE" ] || fail "worktree base directory does not exist: $BASE"
mkdir -p "$BASE"

SHA=$(git -C "$REPO" rev-parse --verify --quiet --end-of-options "$COMMIT^{commit}") \
  || fail "not a commit in $REPO: $COMMIT"

# A floor and its regenerator arrived together in v2026.7. Refuse older
# commits before paying for a checkout.
git -C "$REPO" cat-file -e "$SHA:scripts/regenerate-seed" 2>/dev/null \
  || fail "$SHA is before v2026.7: no scripts/regenerate-seed, so there is no floor to reproduce"
git -C "$REPO" cat-file -e "$SHA:priv/bootstrap/seed/manifest.term" 2>/dev/null \
  || fail "$SHA is before v2026.7: no content-addressed floor at priv/bootstrap/seed"

for asset in priv/native priv/z3 priv/codegen.sources; do
  [ -e "$REPO/$asset" ] || fail "this checkout lacks $asset; run ./bin/bl once first"
done

WT_PARENT=$(mktemp -d "$BASE/floor-at-worktree.XXXXXX") \
  || fail "cannot create a worktree directory under $BASE"
WT=$WT_PARENT/tree
LOG=$WT_PARENT/regenerate.log
OUT_CREATED=0
if [ -z "$OUT" ]; then
  OUT=$(mktemp -d "$BASE/floor-at-output.XXXXXX") || fail "cannot create output under $BASE"
  OUT_CREATED=1
elif [ -e "$OUT" ]; then
  [ -d "$OUT" ] && [ -z "$(ls -A "$OUT")" ] \
    || fail "output directory must be empty or absent: $OUT"
fi

cleanup() {
  status=$?
  trap - EXIT INT TERM
  if [ -n "${WT:-}" ] && [ -d "$WT" ]; then
    git -C "$REPO" worktree remove --force "$WT" >/dev/null 2>&1 \
      || rm -rf "$WT"
    git -C "$REPO" worktree prune >/dev/null 2>&1 || true
  fi
  [ -n "${WT_PARENT:-}" ] && rm -rf "$WT_PARENT"
  if [ -n "${OUT:-}" ] && [ -d "$OUT" ]; then
    if [ "$KEEP" -eq 1 ]; then
      echo "floor-at: kept regenerated floor at $OUT" >&2
    else
      rm -rf "$OUT"
    fi
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 2' INT TERM

echo "floor-at: $COMMIT is $SHA" >&2
git -C "$REPO" worktree add --detach --quiet "$WT" "$SHA" \
  || fail "cannot check out $SHA at $WT"

SEED=$WT/priv/bootstrap/seed
[ -d "$SEED" ] || fail "$SHA has no priv/bootstrap/seed directory"

# Stage the image the tree's own regenerate-seed loads: the committed floor
# beams are the complete compiler image (build/ minus its build record). The
# regenerator needs the exact application-image shape bin/bl creates.
mkdir -p "$WT/build" "$WT/.bl/lib/beam_lisp-0.1.0"
cp -a "$SEED"/*.beam "$SEED/beam_lisp.app" "$WT/build/" \
  || fail "cannot stage build/ from the committed floor"
ln -s "$WT/build" "$WT/.bl/lib/beam_lisp-0.1.0/ebin"
ln -s "$WT/priv" "$WT/.bl/lib/beam_lisp-0.1.0/priv"

# Ignored build inputs live only in a working checkout, never in a commit.
for asset in priv/native priv/z3 priv/codegen.sources; do
  cp -a --reflink=auto "$REPO/$asset" "$WT/priv/" \
    || fail "cannot copy $asset into the worktree"
done

echo "floor-at: regenerating $SHA from scratch into $OUT" >&2
if ! (
  cd "$WT"
  env -u BL_REGEN_ROOT -u BL_BOOTSTRAP_INSTALL \
    BL_REGEN_FROM_SCRATCH=1 \
    BL_REGEN_MEMORY_MAX="${BL_REGEN_MEMORY_MAX:-6G}" \
    sh ./scripts/regenerate-seed "$OUT"
) >"$LOG" 2>&1; then
  echo "floor-at: regeneration failed for $SHA" >&2
  tail -n 40 "$LOG" >&2 || true
  fail "see the log above"
fi

GEN=$OUT/seed
[ -d "$GEN" ] || fail "regeneration produced no floor at $GEN"

# Compare the whole inventory, not just the committed side: an extra beam is a
# difference too. m is the union size; on a sound floor it equals the committed
# beam count.
NAMES=$(
  { cd "$SEED" && ls -1 ./*.beam 2>/dev/null || true
    cd "$GEN" && ls -1 ./*.beam 2>/dev/null || true
  } | sed 's|^\./||' | LC_ALL=C sort -u
)
M=0
N=0
for name in $NAMES; do
  M=$((M + 1))
  if [ ! -f "$SEED/$name" ] || [ ! -f "$GEN/$name" ] \
     || ! cmp -s "$SEED/$name" "$GEN/$name"; then
    N=$((N + 1))
  fi
done

if [ -f "$GEN/manifest.term" ] && cmp -s "$SEED/manifest.term" "$GEN/manifest.term"; then
  MANIFEST=same
else
  MANIFEST=differs
fi

if [ "$N" -eq 0 ] && [ "$M" -gt 0 ] && [ "$MANIFEST" = same ]; then
  printf '%s reproduces\n' "$SHA"
  exit 0
fi
printf '%s differs (%d/%d beams, manifest %s)\n' "$SHA" "$N" "$M" "$MANIFEST"
exit 1
