;; Use the product's own warm, monitored, isolated test runner. Add receipts;
;; retain its source checks, runtime scope, environment restoration and cleanup.
;; The checkout's project declaration also develops its priv/lib sources.
;; Candidate tests keep their examples and cwd, but resolve SDK libraries from
;; the selected executable. Otherwise a sealed SDK meets foreign declarations.
(doseq [path (BeamLisp.Env/search_paths)]
 (when (String/starts_with? (Path/expand path)
         (str (System/fetch_env! "BL_TEST_SOURCE_ROOT") "/priv/"))
  (BeamLisp.Env/remove_search_path path)))
(when-not (= :public (BeamLisp.Loader/with_declaration_snapshot
                      #(BeamLisp.AOT/sdk_declaration_kind "datom" "connect")))
 (throw (ex-info "Candidate SDK declaration source is not selected" {:kind :candidate-sdk-source-mismatch})))
;; A drop prepends its private ERTS tools to PATH. Standalone host proofs must
;; use the system VM; explicit artifact children supply their own library paths.
(let [erts-prefix (str (erlang/list_to_binary (code/root_dir)) "/erts-")]
 (System/put_env "PATH" (String/join
  (filter #(not (String/starts_with? % erts-prefix))
          (String/split (or (System/get_env "PATH") "") ":")) ":")))
(doseq [name ["ERTS_BIN" "ERL_ROOTDIR"]] (System/delete_env name))
(ns tooling.qualify-candidate (:require [reload.ward :as ward]))
(defn- detail [report]
 {"test" (:test report) "type" (str (:type report))
  "actual" (Kernel/inspect (:actual report)) "expected" (Kernel/inspect (:expected report))
  "message" (Kernel/inspect (:msg report))
  "form" (Kernel/inspect (:form report))
  "data" (Kernel/inspect (try (BeamLisp.ExInfo/ex_data (:actual report)) (catch _ nil)))})
(defn- receipt [result elapsed]
 (let [totals (:totals result)
       row {"file" (:path result) "status" (str (:status result))
            "elapsed_ms" elapsed "tests" (or (:tests totals) 0)
            "pass" (or (:pass totals) 0) "fail" (or (:fail totals) 0)
            "error" (+ (or (:error totals) 0) (if (= :incoherent (:status result)) 1 0))
            "details" (to-list (concat (map detail (:reports result))
                          (map (fn [error] {"test" "suite-load-or-worker" "actual" (Kernel/inspect error)})
                               (:errors result))))}]
  (IO/puts (erlang/iolist_to_binary
             (list "BL-QUALIFY " (erlang/apply :json :encode (list row)))))))
(defn- runtime-budget []
 (erlang/apply :persistent_term :get (list :bl_sealed_generation_budget {})))
(defn- continue-in-this-vm? []
 ;; Native generation admission is node-lifetime policy: retired graphs do not
 ;; replenish atoms. Hand over at half its limits instead of resetting policy.
 ;; Leave room for one file and its children inside the external process cap.
 (let [used (runtime-budget)]
  (and (< (get used :preparations 0) 128) (< (get used :namespaces 0) 2048)
       (< (get used :source-bytes 0) 67108864)
       (< (erlang/memory :total) 3221225472))))
(let [paths (String/split (System/fetch_env! "BL_QUALIFY_FILES") "\n" (list (tuple :trim true)))
      timeout (String/to_integer (or (System/get_env "BL_QUALIFY_TIMEOUT_MS") "300000"))
      started (atom 0)
      entries (mapv (fn [path]
                (try {:path path :src (BeamLisp.Loader/read_source path)}
                 (catch error {:path path :src nil :unreadable (ex-message error)}))) paths)]
 (System/put_env "BL_TEST_TIMEOUT" (str (max 1 (quot timeout 1000))))
 (let [result (ward/run entries
                (fn [event]
                 (if (= :file-start (:phase event))
                  (do (reset! started (erlang/monotonic_time :millisecond))
                      (println "QUALIFY START" (:ns event)))
                  (receipt (:result event) (- (erlang/monotonic_time :millisecond) @started))))
                {:continue? continue-in-this-vm?})]
  (when (:stopped? result)
   (IO/puts (erlang/iolist_to_binary
     (list "BL-QUALIFY-HANDOVER "
      (erlang/apply :json :encode
       (list {"reason" "native-lifetime-budget" "completed" (count (:files result))
              "budget" (Kernel/inspect (runtime-budget)) "memory_bytes" (erlang/memory :total)}))))))
  (System/halt (if (:ok? result) 0 1))))
