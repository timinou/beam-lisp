;; One immutable runtime, serial files, separate process dictionaries and
;; structured receipts. Loading errors must not hide the rest of the corpus.
(ns tooling.qualify-candidate)
(defn- run-file [path]
 (try
  (let [totals (BeamLisp.TestRT/run_suite (list path) (list))
        reports (mapcat (fn [entry]
                   (if (and (tuple? (elem entry 0)) (= :test_run (elem (elem entry 0) 0)))
                    (filter #(not= :pass (:type %)) (:reports (elem entry 1))) []))
                  (Process/get))]
   {"tests" (:tests totals) "pass" (:pass totals)
    "fail" (:fail totals) "error" (:error totals)
    "details" (to-list (map (fn [report]
                 {"test" (:test report) "type" (str (:type report))
                  "actual" (Kernel/inspect (:actual report))
                  "expected" (Kernel/inspect (:expected report))
                  "form" (Kernel/inspect (:form report))
                  "data" (Kernel/inspect (try (BeamLisp.ExInfo/ex_data (:actual report)) (catch _ nil)))}) reports))})
  (catch error
   {"tests" 0 "pass" 0 "fail" 0 "error" 1
    "details" (list {"test" "suite-load" "actual" (Kernel/inspect error)
                     "data" (Kernel/inspect (BeamLisp.ExInfo/ex_data error))})})))
(Process/flag :trap_exit true)
(let [paths (String/split (System/fetch_env! "BL_QUALIFY_FILES") "\n" (list (tuple :trim true)))
      timeout (String/to_integer (or (System/get_env "BL_QUALIFY_TIMEOUT_MS") "300000"))
      failed (atom false)]
 (doseq [path paths]
  (println "QUALIFY START" path)
  (let [started (erlang/monotonic_time :millisecond)
        task (Task/async (fn [] (run-file path)))
        yielded (Task/yield task timeout)
        result (if (and yielded (= :ok (elem yielded 0))) (elem yielded 1)
                 (do (Task/shutdown task :brutal_kill)
                  {"tests" 0 "pass" 0 "fail" 0 "error" 1
                   "details" (list {"test" (if yielded "suite-exit" "suite-timeout")
                                    "actual" (if yielded (Kernel/inspect (elem yielded 1)) "per-file deadline exceeded")})}))
        row (assoc result "file" path "elapsed_ms" (- (erlang/monotonic_time :millisecond) started))]
   (when (> (+ (get row "fail") (get row "error")) 0) (reset! failed true))
   (IO/puts (erlang/iolist_to_binary (list "BL-QUALIFY " (erlang/apply :json :encode (list row)))))))
 (System/halt (if @failed 1 0)))
