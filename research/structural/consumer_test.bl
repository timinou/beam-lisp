; consumer_test.bl — executable evidence for the (first (filter …)) consumer
; spike. Every result here is UNRUN at authoring time; the orchestrator runs
; one capped VM.
;
; Proves, in order:
;   1. ANF parity: the lowering preserves the baseline result for eligible
;      cases, INCLUDING a matched `false` and a matched `nil`.
;   2. The negative control: the plausible `some` lowering loses a `false`
;      match — an executable witness, not a prose claim.
;   3. Refusal: effectful / raising / global ops and non-materialized or
;      unresolved sources are refused; the lazy spelling is untouched.
;   4. Central integration: the checked optimizer proves its integer-fold
;      machinery, has NO law for first/filter, refuses the inner invoke, and
;      accepts our lowered node unchanged (fixed point).
;   5. Logic: veritas EXHAUSTIVELY enumerates a finite (list × predicate)
;      domain — parity is `:proven`, the naive lowering is `:refuted` with a
;      witness; z3 proves the emitted halting-scan contract and exhibits the
;      false/nil boundary.
;   6. Work: the chunk overscan is an observable callback count (32 vs the
;      index of the first match); reductions on a pre-compiled run/0 fall.
;
; Run:  bl -p . test research/structural/consumer_test.bl
; (the file's ns `research.structural.consumer-test` needs the repo root on
;  the path; the test runner adds it when needed.)

(ns research.structural.consumer-test
  (:require [research.structural.consumer :as consumer]
            [anf :as a]
            [optimize :as opt]
            [compiler :as c]
            [lower :as l]
            [veritas :as v]
            [z3]
            [oracle]
            [env]))

;; ── compile + run helpers ────────────────────────────────────────────────

(defn- fresh-atom [stem]
  (erlang/binary_to_atom
    (str "Elixir.Research.Structural.ConsumerTest." stem "."
         (erlang/unique_integer (list :positive)))))

;; Read one source form through the self-hosted reader. The compile helpers
;; accept source strings; already-compiled nodes go directly to consumer/lower.
(defn- read-one-form [src]
  (first (BeamLisp.Ns.Reader/read_string src nil)))

(defn- compile-node [src]
  (c/reset-fresh!)
  (c/compile-node (read-one-form src) (c/new-env "user")))

(defn- descriptor [src]
  (c/reset-fresh!)
  (a/module (fresh-atom "Image")
    (list {:op :defn-clause :fname :run :params (list) :guard nil
           :body (c/compile-node (read-one-form src)
                                 (c/new-env "user"))
           :ann {}})
    (list [:run 0]) (list)))

(defn- run-node [node]
  (l/eval-anf (fresh-atom "Eval") node))

(defn- candidate [src]
  (consumer/lower {:expr (compile-node src) :resolved? true}))

;; ── 1. ANF parity, including false and nil matches ───────────────────────

(deftest lowered-first-filter-preserves-result
  (doseq [[src expected]
          [["(first (filter (fn [x] (> x 3)) (lists/seq 0 8)))" 4]
           ["(first (filter (fn [x] (> x 30)) (lists/seq 0 8)))" nil]
           ["(first (filter (fn [x] (== x false)) (quote (1 2 false 4))))" false]
           ["(first (filter (fn [x] (== x nil)) (quote (1 2 nil 4))))" nil]
           ["(first (filter (fn [x] (and (>= x 2) (< x 5))) (quote (0 1 2 3 4))))" 2]
           ["(first (filter (fn [x] (or (== x false) (== x 7))) (quote (0 false 7))))" false]]]
    (let [r (candidate src)
          base (run-node (compile-node src))]
      (is (contains? r :lowered) (str src " should lower: " (pr-str r)))
      (is (= expected base))
      (is (= base (run-node (:lowered r)))))))

(deftest lowering-reports-the-rule-and-conditions
  (let [r (candidate "(first (filter (fn [x] (> x 1)) (lists/seq 0 4)))")]
    (is (= :first-filter-halting-fold (:rule (:evidence r))))
    (is (= :sequential-left-to-right
           (:order (:conditions (:evidence r)))))
    (is (= :first-matching-element-or-nil
           (:result (:conditions (:evidence r)))))))

;; ── 2. the negative control: the naive `some` lowering loses `false` ─────

(deftest naive-some-lowering-loses-a-false-match
  (let [src "(first (filter (fn [x] (== x false)) (quote (1 2 false 4))))"
        node (compile-node src)
        naive (consumer/naive-lower {:expr node})]
    (is (= false (run-node node)))
    (is (= nil (run-node naive)) "some discards a false selector result")
    (is (= false (run-node (:lowered (candidate src)))))
    (is (not= (run-node node) (run-node naive)))))

;; ── 3. refusals — the fallback keeps the lazy spelling ───────────────────

(deftest out-of-domain-candidates-are-refused
  ; effectful predicate: a println in the body
  (is (= :predicate-not-total-effect-free
         (:refused (candidate "(first (filter (fn [x] (println x)) (lists/seq 0 8)))"))))
  ; raising predicate: division is not in the total comparison grammar
  (is (= :predicate-not-total-effect-free
         (:refused (candidate "(first (filter (fn [x] (/ 1 x)) (lists/seq 1 8)))"))))
  ; native/map/keyword predicate: not a total comparison
  (is (= :predicate-not-total-effect-free
         (:refused (candidate "(first (filter (fn [x] (odd? x)) (lists/seq 0 8)))"))))
  ; captured free variable: the parameter is not the only operand
  (is (= :predicate-not-total-effect-free
         (:refused (candidate "(first (filter (fn [x] (> x k)) (lists/seq 0 8)))"))))
  ; lazy provider source (range) — not materialized
  (is (= :collection-not-materialized
         (:refused (candidate "(first (filter (fn [x] (> x 1)) (range 0 10)))"))))
  ; unknown global source
  (is (= :collection-not-materialized
         (:refused (candidate "(first (filter (fn [x] (> x 1)) xs))"))))
  ; a non-first expression is not a candidate at all
  (is (= :not-a-first-of-filter
         (:refused (candidate "(take 1 (filter (fn [x] (> x 1)) (lists/seq 0 8)))")))))

(deftest seq-range-totality-is-a-strict-refusal
  ; a backwards literal range is not a materialized value list: lists:seq/2
  ; raises for it, so it gets its own refusal rather than a lowering.
  (is (= :collection-range-not-total
         (:refused (candidate "(first (filter (fn [x] (> x 1)) (lists/seq 8 0)))"))))
  ; a non-literal bound is not a range at all — plain not-materialized
  (is (= :collection-not-materialized
         (:refused (candidate "(first (filter (fn [x] (> x 1)) (lists/seq 0 n)))"))))
  ; the forward literal range on the same predicate still lowers
  (is (contains? (candidate "(first (filter (fn [x] (> x 1)) (lists/seq 0 8)))") :lowered)))

(deftest boolean-and-nil-domains-are-preserved-exactly
  ; `simple-lit?` admits booleans and nil, and the halting fold returns the
  ; ELEMENT, so a matched true/false/nil survives where a selector fold would
  ; not. This is the false/nil boundary at the node level.
  (doseq [[src expected]
          [["(first (filter (fn [x] (== x true)) (quote (0 false true nil))))" true]
           ["(first (filter (fn [x] (== x false)) (quote (0 false true nil))))" false]
           ["(first (filter (fn [x] (== x nil)) (quote (0 false nil 4))))" nil]]]
    (let [r (candidate src)
          base (run-node (compile-node src))]
      (is (contains? r :lowered) (str src " should lower"))
      (is (= expected base))
      (is (= base (run-node (:lowered r)))))))

(deftest effectful-and-raising-tails-are-strictly-refused
  ; effect and raising both land in the SAME refusal: the total-effect-free
  ; grammar rejects the body shape, and `system.footprint/pure?` independently
  ; sees the effect. A `throw` tail is not total either.
  (doseq [src ["(first (filter (fn [x] (println x)) (lists/seq 0 8)))"
               "(first (filter (fn [x] (throw x)) (lists/seq 0 8)))"
               "(first (filter (fn [x] (do (swap! k inc) x)) (lists/seq 0 8)))"
               "(first (filter (fn [x] (/ 1 x)) (lists/seq 1 8)))"]]
    (is (= :predicate-not-total-effect-free (:refused (candidate src)))
        (str src " must be refused"))))

(deftest report-exposes-admission-and-negative-witness
  (let [rep (consumer/report
              (compile-node "(first (filter (fn [x] (> x 3)) (lists/seq 0 8)))") 1)]
    (is (:eligible rep))
    (is (= :first-filter-halting-fold (:rule rep)))
    (is (= :first-matching-element-or-nil (:result (:conditions rep))))
    (is (= 4 (get-in rep [:metrics :baseline :value])))
    (is (= 4 (get-in rep [:metrics :lowered-run :value])))
    (is (some? (:naive rep)))
    (is (= :research-adapter (:authority rep))))
  (let [rep (consumer/report
              (compile-node "(first (filter (fn [x] (> x 1)) xs))") 1)]
    (is (not (:eligible rep)))
    (is (= :collection-not-materialized (:refused rep)))
    (is (nil? (:lowered rep)))))

(deftest unresolved-filter-spelling-requires-declaration
  (let [node (compile-node "(first (filter (fn [x] (> x 1)) (lists/seq 0 8)))")]
    (is (= :filter-resolution-unproven
           (:refused (consumer/lower {:expr node}))))
    (is (contains? (consumer/lower {:expr node :resolved? true}) :lowered))))

;; ── 4. central-optimizer integration: proof, refusal, fixed point ────────

(deftest central-owns-fold-facts-and-has-no-first-filter-law
  ; the central pass DOES own the strict map/fold callback + domain machinery
  (let [d (descriptor
            (str "(let [xs (lists/map (fn [x] (* x 2)) (lists/seq 0 8))] "
                 "(lists/foldl (fn [x a] (+ a x)) 0 xs))"))]
    (is (contains? (set (map :rule (:evidence (opt/explain d))))
                   :strict-map-fold)))
  ; …and has NO law for first/filter: the inner invoke is refused, the outer
  ; first is left untouched (no evidence for the shape as a unit)
  (let [d (descriptor "(first (filter (fn [x] (> x 3)) (lists/seq 0 8)))")
        r (opt/explain d)]
    (is (empty? (:evidence r)))
    (is (contains? (set (map :reason (:refusals r)))
                   :unknown-or-mismatched-native-arity)))
  ; our lowered ANF is a fixed point of the central node pass
  (let [node (compile-node "(first (filter (fn [x] (> x 3)) (lists/seq 0 8)))")
        low (:lowered (consumer/lower {:expr node :resolved? true}))]
    (is (= low (opt/node low)))))

;; ── 5a. veritas: exhaustive finite-domain parity, and the naive witness ──

(defn- lists-exact [alphabet k]
  (if (= k 0)
    (list (list))
    (mapcat (fn [xs] (map (fn [a] (cons a xs)) alphabet))
            (lists-exact alphabet (erlang/- k 1)))))

(defn- lists-upto [alphabet n]
  (loop [k 0 out (list (list))]
    (if (>= k n)
      out
      (recur (erlang/+ k 1) (concat out (lists-exact alphabet (erlang/+ k 1)))))))

(defrecord ListGen [alphabet maxlen])

(extend-type ListGen v/Gen
  (gen-sample [g seed n] (into [] (lists-upto (:alphabet g) (:maxlen g))))
  (gen-enumerate [g] (into [] (lists-upto (:alphabet g) (:maxlen g))))
  (gen-constrain [g var] nil)
  (gen-tag [g] :list))

(def parity-form
  '(let [xs x_0
         p  (cond (= x_1 0) (fn [x] (> x 1))
                  (= x_1 1) (fn [x] (== x false))
                  (= x_1 2) (fn [x] (or (< x 2) (== x 3)))
                  :else     (fn [x] nil))]
     (= (first (filter p xs))
        (reduce (fn [acc e] (if (p e) (reduced e) acc)) nil xs))))

(def naive-form
  '(let [xs x_0
         p  (cond (= x_1 0) (fn [x] (> x 1))
                  (= x_1 1) (fn [x] (== x false))
                  (= x_1 2) (fn [x] (or (< x 2) (== x 3)))
                  :else     (fn [x] nil))]
     (= (first (filter p xs))
        (some (fn [e] (if (p e) e nil)) xs))))

(defn- domain []
  (v/tuple-of (->ListGen [0 1 2 3 false nil] 2) (v/one-of 0 1 2 3)))

(deftest domain-parity-is-exhaustively-proven
  (let [r (v/for-all nil "x" (domain) parity-form)]
    (is (= :proven (:modality r)))
    (is (= :enumerate (:engine r)))
    (is (pos? (:tried r)))))

(deftest naive-some-is-refuted-with-a-witness
  (let [r (v/for-all nil "x" (domain) naive-form)]
    (is (= :refuted (:modality r)))
    (is (some? (:witness r)))))

;; ── 5b. z3: the emitted halting-scan contract and the false/nil boundary ─

;; The oracle is the pooled `z3` surface (README: a supervised handle, not a
;; private port; there is no `z3/close`). A one-shot `z3/check` leases a solver
;; and returns it in its own finally, so nothing here opens a port to close.

(deftest halting-fold-contract-and-false-boundary
  (let [port (z3/open)]
    ; O1: the emitted halting-scan shape equals the first-match spec (N=3).
    ; SAT of the negation would be a shape bug; UNSAT is the proof.
    (is (oracle/proven?
          (z3/check port
            (str "(set-option :timeout 3000)\n"
                 "(declare-fun P (Int) Bool)\n"
                 "(declare-const x0 Int)(declare-const x1 Int)(declare-const x2 Int)\n"
                 "(declare-const ref Int)(declare-const fold Int)\n"
                 "(assert (= ref (ite (P x0) x0 (ite (P x1) x1 (ite (P x2) x2 0)))))\n"
                 "(assert (= fold (ite (P x0) x0 (ite (P x1) x1 (ite (P x2) x2 0)))))\n"
                 "(assert (not (= ref fold)))"))))
    ; O2: the naive selector fold loses a false match — SAT / witness.
    (is (oracle/refuted?
          (z3/check port
            (str "(set-option :timeout 3000)\n"
                 "(declare-fun P (Int) Bool)(declare-const x0 Int)\n"
                 "(assert (P x0))(assert (= x0 1))\n"
                 "(assert (not (= (ite (P x0) x0 0)\n"
                 "                (ite (and (P x0) (and (not (= x0 0)) (not (= x0 1)))) x0 0))))"))))
    ; O3: on truthy matched elements the naive fold agrees — UNSAT.
    (is (oracle/proven?
          (z3/check port
            (str "(set-option :timeout 3000)\n"
                 "(declare-fun P (Int) Bool)(declare-const x0 Int)\n"
                 "(assert (P x0))(assert (not (= x0 0)))(assert (not (= x0 1)))\n"
                 "(assert (not (= (ite (P x0) x0 0)\n"
                 "                (ite (and (P x0) (and (not (= x0 0)) (not (= x0 1)))) x0 0))))"))))))

;; ── 6. work: overscan callback count and reduction experiment ────────────

(deftest chunk-overscan-is-observable-and-refused
  (let [base (env/eval
               (str "(let [k (atom 0)] "
                    "[(first (filter (fn [x] (do (swap! k inc) (> x 3))) (lists/seq 0 1000))) "
                    "(deref k)])"))
        low (env/eval
              (str "(let [k (atom 0)] "
                   "[(reduce (fn [acc x] (if (do (swap! k inc) (> x 3)) (reduced x) acc)) "
                   "nil (lists/seq 0 1000)) (deref k)])"))]
    (is (= 32 (nth base 1)) "filter forces a whole 32-input chunk")
    (is (= 5 (nth low 1)) "the halting fold runs pred only up to the match")
    (is (= (nth base 0) (nth low 0)))
    ; the lowering is refused for exactly this effectful predicate
    (is (= :predicate-not-total-effect-free
           (:refused (candidate
                       (str "(first (filter (fn [x] (do (swap! k inc) (> x 3))) "
                            "(lists/seq 0 1000)))")))))))

(deftest work-experiment-measures-fewer-reductions
  (let [node (compile-node "(first (filter (fn [x] (> x 3)) (lists/seq 0 1000)))")
        m (consumer/measure node 5)]
    (is (= 4 (:value (:baseline m))))
    (is (= 4 (:value (:lowered m))))
    (is (erlang/> (:reductions (:baseline m)) (:reductions (:lowered m))))))

(deftest pure-strict-boolean-primitives-are-not-total-over-the-source-domain
  (doseq [[src first-call]
          [["(first (filter (fn [x] (erlang/not x)) (quote (false 0))))" "(erlang/not false)"]
           ["(first (filter (fn [x] (erlang/and x true)) (quote (true 0))))" "(erlang/and true true)"]
           ["(first (filter (fn [x] (erlang/or x false)) (quote (true 0))))" "(erlang/or true false)"]]]
    (is (= true (run-node (compile-node first-call))) "the first predicate call is valid and matches")
    (is (thrown? (run-node (compile-node src)))
        "the lazy chunk observes the non-boolean tail and raises after the first match")
    (is (= :predicate-not-total-effect-free (:refused (candidate src)))
        "pure-but-partial BIFs need an operand type proof, not just a pure footprint")))
