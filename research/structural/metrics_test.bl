; Run the work probes once, then assert mechanism/result rather than a desired speedup.
(ns research.structural.metrics-test
  (:require [research.structural.run :as driver]))

(deftest measurements-exercise-real-work-and-preserve-results
  (let [r driver/results d (:dependencies r) l (:lookup r) c (:consumer r)]
    (is (> (:initial-rows d) 0))
    (is (= 0 (:unrelated-write-rows d)))
    (is (:unrelated-reused? d))
    (is (not (:relevant-reused? d)))
    (is (> (:relevant-write-rows d) 0))
    (is (:agrees l))
    (is (= 4000 (:steps l)))
    (is (<= 1 (:fetches l) 3))
    (is (:eligible c))
    (is (= 4 (get-in c [:metrics :baseline :value])))
    (is (= 4 (get-in c [:metrics :lowered-run :value])))))

(deftest write-stamp-assumption-is-reported-not-silently-claimed
  (let [a (:lookup-mutation-coverage driver/results)]
    (is (:raw-missing? a))
    (is (contains? #{true false} (:epoch-advanced? a)))
    (if (:epoch-advanced? a)
      (is (:cached-agrees-with-raw? a))
      (is (:cached-prior-binding? a)
          "a non-epoch-bumping mutator is an explicit negative control, not a soundness proof"))))
