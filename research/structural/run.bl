; Reproducible work metrics, separate from semantic/model assurance tests.
(ns research.structural.run
  (:require [research.structural.dependencies :as deps]
            [research.structural.bounded :as bounded]
            [research.structural.lookup :as lookup]
            [research.structural.consumer :as consumer]
            [compiler :as compiler]
            [datom] [datom.profile :as profile] [datom.store-ets]
            [datom.store-fjall]))

(defn dependency-metrics []
  (let [store (profile/watch (datom.store-ets/open))
        conn (datom/connect-with store
               [{:db/ident :p/name :db/valueType :db.type/string}
                {:db/ident :p/score :db/valueType :db.type/long}
                {:db/ident :p/audit :db/valueType :db.type/string}])]
    (try
      (let [rep (datom/transact! conn
                  (mapv (fn [i] {:db/id (- -1 i) :p/name (str "n" i) :p/score i}) (range 6)))
            rows (fn [] (:rows (profile/counters store)))
            r0 (rows)
            first (deps/project nil store (datom/db conn) [:p/name :p/score] [] 0)
            r1 (rows)
            _ (datom/transact! conn [{:db/id -99 :p/audit "unrelated"}])
            r2 (rows)
            unchanged (deps/project first store (datom/db conn) [:p/name :p/score] [] 0)
            r3 (rows)
            _ (datom/transact! conn [{:db/id (get (:tempids rep) -1) :p/score 100}])
            r4 (rows)
            changed (deps/project unchanged store (datom/db conn) [:p/name :p/score] [] 0)
            r5 (rows)]
        {:initial-rows (- r1 r0) :unrelated-write-rows (- r3 r2)
         :relevant-write-rows (- r5 r4) :unrelated-reused? (:reused? unchanged)
         :relevant-reused? (:reused? changed)})
      (finally (datom/close! conn)))))

(defn lookup-metrics []
  (BeamLisp.Env/intern "research.structural.lookup-fixture" "sum" (fn [a x] (+ a x)))
  (lookup/report "research.structural.lookup-fixture" "sum" (lists/seq 0 3999) 0 5))

(defn consumer-metrics []
  (let [expr (compiler/compile-node
               (BeamLisp.Reader/read_one "(first (filter (fn [x] (> x 3)) (lists/seq 0 1000)))")
               (compiler/new-env "user"))
        r (consumer/report expr 200)]
    {:eligible (:eligible r) :authority (:authority r)
     :rule (:rule r) :metrics (:metrics r)}))

(defn report []
  {:dependencies (dependency-metrics)
   :lookup (lookup-metrics)
   :lookup-mutation-coverage (lookup/audit-bulk-delete)
   :consumer (consumer-metrics)
   :native-pagescan-available? (datom.store-fjall/available?)
   :note "Research fixtures only; model/parity/cursor/realm gates run separately in the five test files."})

(def results (report))
(println "STRUCTURAL-SPIKE-RESULTS" (pr-str results))
