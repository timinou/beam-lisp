; research/split-beam/log.bl — read (or, for tests, tamper with) a split
; app's durable log, from outside the server.
;
;   bl run research/split-beam/log.bl -- list   <keyspace.fjall> <app>
;       one JSON line per commit: {revision, actor, op, args, nonce}
;   bl run research/split-beam/log.bl -- forge  <keyspace.fjall> <app> <json>
;       append a commit as given (no authority involved) — how verify-team
;       proves that a log the authority would refuse fails the boot closed
;
; The server must be stopped: a fjall keyspace has one owner at a time.

(ns split-beam.log
  (:require [split.log :as slog] [bl.json]))

(defn- kw-args [m] (reduce (fn [acc k] (assoc acc (keyword k) (get m k))) {} (keys m)))

(defn main [[cmd path app json]]
  (let [log (slog/open path app)]
    (cond
      (= cmd "list")
        (doseq [c (slog/commits log)]
          (println (bl.json/encode {:revision (:revision c) :actor (:actor c) :op (:op c)
                                    :args (:args c) :nonce (:nonce c)})))
      (= cmd "forge")
        (let [j (bl.json/decode json)]
          (slog/append! log {:entry {:revision (get j "revision") :op (keyword (get j "op"))}
                             :args (kw-args (get j "args")) :nonce (get j "nonce") :actor (get j "actor")})
          (println "forged revision" (get j "revision")))
      :else (do (println "usage: log.bl -- list|forge <keyspace> <app> [json]") (System/halt 2)))))

(main (BeamLisp/argv))
