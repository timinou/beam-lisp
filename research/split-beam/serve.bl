; research/split-beam/serve.bl — serve the split showcases from ONE BEAM.
;
;   bl serve research/split-beam/serve.bl                    all six + the gallery
;   bl serve research/split-beam/serve.bl -- groceries       one app, at /
;   bl serve research/split-beam/serve.bl --port 8791 -- team outline
;
; Each app is its own file under research/js-actors/apps/ (the launch board is
; research/js-actors/showcase.bl): pure functions and one `split/defapp`. The
; server half is that namespace running here, natively; the browser half is
; what `bl run research/js-actors/compiler.bl` built into research/js-actors/out.
; Apps with :history keep their log in data/split (gitignored); set
; SPLIT_DATA to put it elsewhere, or SPLIT_DATA=none to keep nothing on disk.

(ns split-beam.serve
  (:require [split.web :as sweb] [bl.serve]))

; the apps live beside the research compiler that builds their browser halves
(BeamLisp.Env/add_search_path "research/js-actors/apps")
(BeamLisp.Env/add_search_path "research/js-actors")
(doseq [n ["showcase" "outline" "groceries" "team" "triage" "ledger"]] (BeamLisp.Loader/ensure_loaded n))

(def apps
  "stem → [app value, one line for the gallery]"
  {"showcase"  [showcase/launch-board "Launch board — filters built from small functions"]
   "outline"   [outline/outline "Product plan — nested data, rolled up and searched"]
   "groceries" [groceries/groceries "Groceries — instant edits that survive going offline"]
   "team"      [team/team-board "Team board — sign in, permissions, presence, undo, history"]
   "triage"    [triage/triage "Bug inbox — keyboard, drag and inline edits as data"]
   "ledger"    [ledger/ledger "Household ledger — exact money past 2^53"]})

(def order ["showcase" "outline" "groceries" "team" "triage" "ledger"])

(defn- esc [s]
  (-> s (String/replace "&" "&amp;") (String/replace "<" "&lt;") (String/replace ">" "&gt;")))

(defn gallery [stems]
  (str "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">"
       "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
       "<title>split on BEAM — gallery</title><style>"
       "body{font:16px/1.5 system-ui,sans-serif;background:#0f1320;color:#e7eaf3;margin:0;padding:48px}"
       "h1{font-size:28px;margin:0 0 4px}p.lede{color:#9aa3b8;margin:0 0 32px;max-width:60ch}"
       "ul{list-style:none;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px}"
       "a{display:block;padding:20px;border:1px solid #2a3150;border-radius:12px;background:#161b2e;color:inherit;text-decoration:none}"
       "a:hover{border-color:#6b8cff}strong{display:block;font-size:18px;margin-bottom:4px}span{color:#9aa3b8}"
       "code{color:#b9c6ff}</style></head><body>"
       "<h1>One file, two programs</h1>"
       "<p class=\"lede\">Each app below is one <code>.bl</code> file. Its server half runs here, natively on BEAM; "
       "its browser half was compiled to JavaScript from the same file. No app wrote a route, a codec or a socket.</p><ul>"
       (apply str (map (fn [stem]
                         (let [[a line] (get apps stem)
                               [title what] (String/split line " — ")]
                           (str "<li><a href=\"/" stem "/\"><strong>" (esc title) "</strong><span>" (esc what)
                                "</span><br><code>apps/" stem ".bl</code></a></li>")))
                       stems))
       "</ul></body></html>"))

(defn main [argv]
  (let [asked (vec (filter (fn [a] (contains? apps a)) argv))
        stems (if (empty? asked) order asked)
        data (let [d (System/get_env "SPLIT_DATA")] (cond (nil? d) "data/split" (= d "none") nil :else d))
        port (bl.serve/port 4040)]
    (when (some? data) (File/mkdir_p! data))
    (let [served (try (sweb/serve (mapv (fn [s] [s (first (get apps s))]) stems)
                                  {:port port :data data :index (gallery stems)})
                      (catch e
                        ; a log the authority refuses: fail closed, loudly
                        (IO/puts :stderr (str "SPLIT FAILED " (ex-message e)))
                        (System/halt 1)))]
      (doseq [[stem m] (:mounts served)]
        (when (some? (:log m)) (println (str "SPLIT REPLAYED " (:replayed m) " commits for " stem))))
      (println (str "split: serving " (apply str (interpose ", " stems)) " on http://127.0.0.1:" port "/")))))

(main (BeamLisp/argv))
