(ns s2 (:require [datom] [datom.store-fjall]))
; one entity per commit; the value is the proposal as EDN (a closed-data string),
; so the log is the same shape the Node JSONL held, now as facts
(def schema
  [{:db/ident :split.commit/app :db/valueType :db.type/string}
   {:db/ident :split.commit/revision :db/valueType :db.type/long}
   {:db/ident :split.commit/actor :db/valueType :db.type/string}
   {:db/ident :split.commit/op :db/valueType :db.type/keyword}
   {:db/ident :split.commit/args}
   {:db/ident :split.commit/nonce :db/valueType :db.type/string}])

(def path (str "/tmp/p150/s2.fjall"))

(defn commit! [conn app rev actor op args nonce]
  (datom/transact! conn [(merge {:db/id -1 :split.commit/app app :split.commit/revision rev :split.commit/op op
                                 :split.commit/args args :split.commit/nonce nonce}
                                (if (nil? actor) {} {:split.commit/actor actor}))]))

(defn commits [conn app]
  (->> (datom/q '[:find ?r ?op ?a ?n :in $ ?app
                  :where [?e :split.commit/app ?app] [?e :split.commit/revision ?r]
                         [?e :split.commit/op ?op] [?e :split.commit/args ?a] [?e :split.commit/nonce ?n]]
                (datom/db conn) app)
       (sort-by first)
       (mapv (fn [[r op a n]] {:revision r :op op :args a :nonce n}))))

(let [mode (first (BeamLisp/argv))
      conn (datom/connect-with (datom.store-fjall/open path) schema)]
  (if (= mode "write")
    (do (commit! conn "groceries" 1 nil :tick-item {:id 3 :got true} "t:1")
        (commit! conn "groceries" 2 "ana" :add-item {:name "Eggs" :aisle :dairy} "t:2")
        (commit! conn "team" 1 "ben" :move {:id 1} "t:3")
        (println "wrote" (count (commits conn "groceries"))))
    (println "recovered" (pr-str (commits conn "groceries")))))
