; ── S1: the transport on web.bl — codec, hub actor, router ──────────────────
(def ROOT (str (File/cwd!) "/research/js-actors/"))

(defn resolve-spec [spec]
  (cond (= spec :bool) :bool (= spec :exact) :exact
        (keyword? spec) (get-in contract-memo [:wire spec]) :else spec))

(defn decode [spec v depth]
  ; JSON value → BL value of the declared shape, or throw. Shape only; the
  ; authority re-checks with wire-ok? and decides.
  (let [t (resolve-spec spec)]
    (cond
      (= t :bool) (if (or (= v true) (= v false)) v (throw "bool"))
      (= t :exact) (if (int? v) v (throw "exact"))
      (not (vector? t)) (throw "contract")
      (< 24 depth) (throw "depth")
      (= (first t) :text) (if (string? v) v (throw "text"))
      (= (first t) :int) (if (int? v) v (throw "int"))
      (= (first t) :one-of) (or (some (fn [k] (if (= (name k) v) k nil)) (rest t)) (throw "one-of"))
      (= (first t) :list) (if (and (vector? v) (<= (count v) (nth t 1)))
                            (mapv (fn [x] (decode (nth t 2) x (inc depth))) v) (throw "list"))
      (= (first t) :record)
        (let [fields (nth t 1)]
          (if (and (map? v) (= (sort (map name (keys fields))) (sort (keys v))))
            (reduce (fn [m k] (assoc m k (decode (get fields k) (get v (name k)) (inc depth)))) {} (keys fields))
            (throw "record")))
      :else (throw "tag"))))

(def proposal-keys ["args" "digest" "nonce" "op" "request" "revision"])

(defn decode-proposal [j]
  (cond
    (not (and (map? j) (= proposal-keys (sort (keys j))))) [:bad 400 :malformed-proposal]
    (not (and (int? (get j "request")) (int? (get j "revision")) (string? (get j "nonce")) (string? (get j "op"))))
      [:bad 400 :malformed-proposal]
    (not (= digest-memo (get j "digest"))) [:bad 409 :client-outdated]
    :else
      (let [op (some (fn [k] (if (= (name k) (get j "op")) k nil)) (keys (:intents contract-memo)))]
        (if (nil? op) [:bad 400 :unknown-intent]
          (try [:ok {:request (get j "request") :revision (get j "revision") :digest (get j "digest")
                     :nonce (get j "nonce") :op op :actor nil
                     :args (decode [:record (get-in contract-memo [:intents op :params])] (get j "args") 0)}]
               (catch _ [:bad 400 :malformed-args]))))))

; ── the hub: one actor owns the authority's outputs and the open streams ──
(defn hub-loop [auth st]
  (receive
    [:ready v] (hub-loop auth (assoc st :current {:revision (:revision v) :board (:board v)}))
    [:propose from p]
      (let [n (inc (:next st))]
        (erlang/send auth [:browser :intent (assoc p :request n)])
        (hub-loop auth (-> st (assoc :next n) (assoc-in [:waiting n] [from (:request p)]))))
    [:result v]
      (let [[from req] (get-in st [:waiting (:request v)])]
        (when from (erlang/send from [:answer (assoc v :request req)]))
        (hub-loop auth (-> st (update :waiting dissoc (:request v))
                           (assoc :current (if (:ok v) {:revision (:revision v) :board (:board v)} (:current st))))))
    [:snapshot v]
      (let [line (str "event: snapshot\ndata: " (bl.json/encode (assoc (dissoc v :request) :by nil)) "\n\n")]
        (doseq [s (:streams st)] (erlang/send s [:sse line]))
        (hub-loop auth st))
    [:commit _] (hub-loop auth st)
    [:hello from] (do (erlang/send from [:hello (:current st)])
                      (erlang/monitor :process from)
                      (hub-loop auth (update st :streams conj from)))
    [:DOWN _ _ pid _] (hub-loop auth (update st :streams disj pid))))

(defn hub [] (erlang/whereis :split-hub))

(defn send-json [conn status v]
  (web/json (web/resp-header conn "cache-control" "no-store") status v))

(defn sse-raw [conn line]
  (let [r (erlang/apply (erlang/binary_to_atom "Elixir.Plug.Conn") :chunk (list conn line))]
    (if (= (erlang/element 1 r) :ok) {:ok (erlang/element 2 r)} {:error (erlang/element 2 r)})))

(defn stream-loop [conn]
  (receive
    [:sse line] (let [r (sse-raw conn line)] (if (:ok r) (stream-loop (:ok r)) conn))
    (after 15000 (let [r (web/sse-comment conn)] (if (:ok r) (stream-loop (:ok r)) conn)))))

(defn handle-events [conn]
  (erlang/send (hub) [:hello (erlang/self)])
  (let [cur (receive [:hello c] c)
        c (web/sse-open conn)
        r (web/sse-event c "hello" (bl.json/encode {:digest digest-memo :revision (:revision cur) :board (:board cur)}))]
    (stream-loop (:ok r))))

(defn handle-intent [conn]
  (let [[body conn] (web/read-body* conn)
        j (try (bl.json/decode body) (catch _ :bad-json))]
    (if (= j :bad-json) (send-json conn 400 {:ok false :reason :malformed-json})
      (let [d (decode-proposal j)]
        (if (= :bad (first d))
          (send-json conn (nth d 1) {:ok false :reason (nth d 2)})
          (do (erlang/send (hub) [:propose (erlang/self) (nth d 1)])
              (receive
                [:answer v] (send-json conn (if (:ok v) 200 (if (= :stale-revision (:reason v)) 409 422)) v)
                (after 4000 (send-json conn 503 {:ok false :reason :authority-unavailable})))))))))

(def statics
  {"/" ["showcase.html" "text/html; charset=utf-8"]
   "/showcase-page.mjs" ["showcase-page.mjs" "text/javascript; charset=utf-8"]
   "/split-worker.mjs" ["split-worker.mjs" "text/javascript; charset=utf-8"]
   "/split-codec.mjs" ["split-codec.mjs" "text/javascript; charset=utf-8"]
   "/host.mjs" ["host.mjs" "text/javascript; charset=utf-8"]
   "/app.css" ["apps/groceries.css" "text/css; charset=utf-8"]
   "/app.page.json" ["apps/groceries.page.json" "application/json"]
   "/out/groceries-client.mjs" ["out/groceries-client.mjs" "text/javascript; charset=utf-8"]
   "/out/groceries.contract.json" ["out/groceries.contract.json" "application/json"]
   "/out/groceries.split.json" ["out/groceries.split.json" "application/json"]})

(defn router [conn]
  (let [p (web/path conn) m (web/method conn)]
    (cond
      (contains? statics p) (let [[f ct] (get statics p)] (web/bytes conn ct (File/read! (str ROOT f))))
      (= p "/api/app") (send-json conn 200 {:app "groceries" :digest digest-memo})
      (= p "/api/events") (handle-events conn)
      (and (= p "/api/intent") (= m "post")) (handle-intent conn)
      :else (send-json conn 404 {:ok false :reason :not-found}))))

(def hub-pid (spawn (fn [] (receive [:go auth] (hub-loop auth {:next 0 :waiting {} :streams #{} :current nil})))))
(erlang/register :split-hub hub-pid)
(reset! sink hub-pid)
(def auth (spawn split-server-main))
(erlang/send hub-pid [:go auth])
(web/serve {:port 8791 :plug router :ip (tuple 127 0 0 1) :log :off})
(println "S1 serving http://127.0.0.1:8791/")
(receive never never)
