(ns p4 (:require [bl.json]))
(defn two [a b] a)
(defn three [a b c] c)
(defn multi ([a b] a) ([a b c] c))
(println "count é/🍌/e+◌́:" (count "é") (count "🍌") (count "e\u0301") "bytes" (erlang/byte_size "🍌"))
(println "codepoints 🍌:" (count (unicode/characters_to_list "🍌")))
(println "arity3?:" (BeamLisp.Ns.Rt/invocable? two 3) (BeamLisp.Ns.Rt/invocable? three 3) (BeamLisp.Ns.Rt/invocable? multi 3) (BeamLisp.Ns.Rt/invocable? multi 2))
(println "json big:" (bl.json/encode {:n 12345678901234567890 :f 1.5}))
(println "json dec 1.0:" (pr-str (bl.json/decode "[1.0, 1e3, 9007199254740993]")))
(println "json bad utf8:" (pr-str (try (bl.json/decode (erlang/list_to_binary [34 255 34])) (catch e (str "refused: " (ex-message e))))))
(println "json lone surrogate:" (pr-str (try (bl.json/decode "\"\\ud800\"") (catch e (str "refused: " (ex-message e))))))
