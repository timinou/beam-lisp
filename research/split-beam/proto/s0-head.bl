(ns s0 (:require [bl.json]))
; host shim: the effects the authority names
(def sink (atom nil))
(defn host-emit [topic v] (erlang/send (deref sink) [topic v]))
; split/defapp as a macro: the declaration kept as data AND its symbols resolved to fns
(defmacro defapp-native [name decl]
  `(def ~'the-app {:name ~(str name) :decl '~decl :fns ~decl :arity {}}))
