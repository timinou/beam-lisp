; ── glue: derived from the app VALUE, not generated source ──
(defn app-decl [] (:decl the-app))
(defn intent-fn [op role] (get-in the-app [:fns :intents op role]))
(defn cjson-esc [s] (let [e (bl.json/encode [s])] (subs e 1 (dec (count e)))))
(defn cjson [v]
  (cond (nil? v) "null" (= v true) "true" (= v false) "false" (int? v) (str v)
        (string? v) (cjson-esc v) (keyword? v) (cjson-esc (name v))
        (map? v) (let [ks (sort-by (fn [k] (if (keyword? k) (name k) (str k))) (keys v))]
                   (str "{" (apply str (interpose "," (map (fn [k] (str (cjson-esc (if (keyword? k) (name k) (str k))) ":" (cjson (get v k)))) ks))) "}"))
        :else (str "[" (apply str (interpose "," (map cjson (vec v)))) "]")))
(defn hex [bin] (apply str (map (fn [b] (let [s (String/downcase (Integer/to_string b 16))] (if (< b 16) (str "0" s) s))) (erlang/binary_to_list bin))))
(defn the-contract []
  (let [d (app-decl) hist (some? (get-in d [:server :history]))]
    {:schema 1 :app (:name the-app) :wire (:wire d) :snapshot (get-in d [:server :snapshot])
     :people (some? (get-in d [:server :people])) :history hist
     :intents (reduce (fn [m op] (assoc m op {:params (get-in d [:intents op :params])}))
                      (if hist {:undo {:params {}} :redo {:params {}}} {}) (keys (:intents d)))}))
(def contract-memo (the-contract))
(def digest-memo (hex (crypto/hash :sha256 (cjson contract-memo))))
(defn split-contract [] contract-memo)
(defn split-digest [] digest-memo)
(defn split-server-init [] ((get-in the-app [:fns :server :init])))
(defn split-check [op board args] (let [f (intent-fn op :check)] (if (nil? f) :unknown-intent (f board args))))
(defn split-guard [op state args] (let [f (intent-fn op :guard)] (if (nil? f) nil (f state args))))
(defn split-allow [op who board args] (let [f (intent-fn op :allow)] (if (nil? f) nil (f who board args))))
(defn split-says [op board args] (let [f (intent-fn op :says)] (if (nil? f) nil (f board args))))
(defn split-apply [op state args who]
  (let [f (intent-fn op :apply)]
    (if (nil? f) nil (if (= 3 (get-in the-app [:arity op])) (f state args who) (f state args)))))
(defn split-people [] (let [f (get-in the-app [:fns :server :people])] (if (nil? f) nil (f))))
(defn split-history-size [] (or (get-in (app-decl) [:server :history]) 0))
(defn split-undo-allow [who board] (let [f (get-in the-app [:fns :server :undo-allow])] (if (nil? f) nil (f who board))))
; ── driver ──
(reset! sink (erlang/self))
(def auth (spawn split-server-main))
(defn next-frame [] (receive [t v] [t v] (after 2000 [:timeout nil])))
(let [[t ready] (next-frame)]
  (println "ready" t (:revision ready) "digest-matches-js-build"
           (= digest-memo (get (bl.json/decode (File/read! "research/js-actors/out/groceries.contract.json")) "digest")))
  (println "BOARD0" (bl.json/encode (:board ready))))
(def props
  [{:request 1 :revision 0 :digest digest-memo :nonce "tabtabtab:1" :actor nil :op :tick-item :args {:id 1 :got true}}
   {:request 2 :revision 1 :digest digest-memo :nonce "tabtabtab:2" :actor nil :op :add-item :args {:name "Eggs" :aisle :dairy}}
   {:request 3 :revision 1 :digest digest-memo :nonce "tabtabtab:3" :actor nil :op :remove-item :args {:id 99}}
   {:request 4 :revision 2 :digest digest-memo :nonce "tabtabtab:4" :actor nil :op :remove-item :args {:id 99}}
   {:request 5 :revision 2 :digest digest-memo :nonce "tabtabtab:2" :actor nil :op :add-item :args {:name "Eggs" :aisle :dairy}}
   {:request 6 :revision 2 :digest "nope" :nonce "tabtabtab:6" :actor nil :op :clear-basket :args {}}])
(doseq [p props]
  (erlang/send auth [:browser :intent p])
  (loop [] (let [[t v] (next-frame)]
             (if (or (= t :result) (= t :timeout))
               (println "RESULT" t (bl.json/encode (dissoc v :board :recent :history)) "items" (count (:items (:board v))))
               (recur)))))
