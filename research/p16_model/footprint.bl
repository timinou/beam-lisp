; research/p16_model/footprint.bl — P16b: an effect is a FOOTPRINT.
;
; ── The redefinition ──────────────────────────────────────────────────
;
; The shipped effects.bl models an effect as a RUNG on a ladder
; (pure < atom < process < io). That is the JOIN — a lossy summary. To reach
; separation-logic-grade reasoning, an effect is promoted to what it actually
; is: a set of RESOURCES, each touched in a MODE.
;
;     footprint ≜ {resource → mode}
;     mode ∈ {:R read · :A append/monotone · :W write · :S send · :K recv · :X spawn}
;
; The rung lattice is RECOVERED, nothing lost:  rung = rank(join of modes).
; And the algebra the footprint carries IS the guarantees:
;
;     purity        ≜ footprint touches only :R (or is empty)
;     monotonicity  ≜ footprint touches only :R/:A   ← MVP-F's monotone live
;                                                       query is THIS special case
;     commutativity ≜ no shared resource carries a CONFLICTING mode pair
;     frame rule    ≜ disjoint resources ⟹ e1 preserves any invariant over e2's
;                     region (Separation Logic, decided STRUCTURALLY — no annotation)
;
; Un-nameable resources (a runtime pid, message contents) collapse to a single
; :opaque-world top that conflicts with everything — precise where we can name
; (atoms, datom conns, io), sound where we cannot. (User-confirmed floor.)

(ns footprint
  (:require [typed]))

; ── the mode lattice ────────────────────────────────────────────────────
;
; rank recovers the rung: R read-only → :pure ; A/W on an atom → :atom ;
; S/K/X (message/process) → :process ; W on :io → :io.

(def mode-rank {:R 0 :A 1 :W 2 :S 3 :K 3 :X 3})

(def opaque-world :opaque-world)

; Two modes on the SAME resource CONFLICT unless both are reads, or both are
; appends (appends commute — the monotone-merge property). Everything else on
; a shared resource is order-sensitive.
(defn conflict? [m1 m2]
  (not (or (and (= m1 :R) (= m2 :R))
           (and (= m1 :A) (= m2 :A)))))

; ── seeds: primitive → (resource-of-args → mode) ────────────────────────
;
; The resource of an op is, where nameable, the SYMBOL of its first argument
; (the atom/conn/table it acts on); else :opaque-world. datom/transact! is
; :A (append — a datom log only grows), which is why live queries over it are
; monotone. erlang/send touches :opaque-world (the target pid is a runtime
; value we cannot name) with mode :S.

(def op-mode
  {"swap!" :W "reset!" :W "deref" :R "atom" :R
   "datom/transact!" :A "datom/listen!" :R "datom/db" :R "datom/q" :R
   "erlang/send" :S "erlang/spawn" :X "receive" :K
   "println" :W "File/read" :R "File/write" :W
   "str" :R "+" :R "*" :R "-" :R "inc" :R "count" :R "get" :R "assoc" :R})

; io ops act on the ambient :io resource, not on an argument.
(def io-ops #{"println" "File/read" "File/write"})

(defn- arg-resource
  "The resource an op touches: the io channel for io ops; else the first
   argument's symbol name when it is a symbol; else :opaque-world."
  [hname items]
  (cond
    (contains? io-ops hname) :io
    (>= (count items) 2)
      (let [a0 (typed/node-form (second items))]
        (if (= :symbol (typed/node-tag a0))
          (typed/node-name a0)
          opaque-world))
    :else opaque-world))

; ── footprint inference over a form ─────────────────────────────────────
;
; Returns {resource → mode}, joining modes (higher rank wins) when a resource
; is touched several ways. Special forms recurse; fn defers (its body's
; footprint is the fn value's, realized at call — out of spike scope).

(defn join-fp [a b]
  (reduce (fn [m [r mode]]
            (let [prev (get m r)]
              (if (or (nil? prev) (> (get mode-rank mode) (get mode-rank prev)))
                (assoc m r mode)
                m)))
          a b))

(declare fp-walk)

(defn- fp-children [env items]
  (reduce (fn [m x] (join-fp m (fp-walk env x))) {} items))

(defn fp-walk
  "The footprint of a form: {resource → mode}."
  [env node]
  (let [tag (typed/node-tag node)]
    (cond
      (= tag :meta) (fp-walk env (second (erlang/tuple_to_list node)))
      (contains? #{:vector :set} tag) (fp-children env (typed/node-items node))
      (= tag :map)
        (reduce (fn [m p] (join-fp m (fp-walk env (second (erlang/tuple_to_list p)))))
                {} (typed/node-items node))
      (= tag :list)
        (let [items (typed/node-items node)
              head  (typed/node-form (first items))]
          (if (not (= :symbol (typed/node-tag head)))
            (fp-children env items)
            (let [hname (typed/node-name head)]
              (cond
                (= hname "quote") {}
                (= hname "fn")    {}
                (contains? #{"if" "do" "let" "loop" "when" "recur"} hname)
                  (fp-children env (rest items))
                (contains? op-mode hname)
                  (join-fp {(arg-resource hname items) (get op-mode hname)}
                           (fp-children env (rest items)))
                :else
                  ; unknown callee: touches :opaque-world (sound — can't see it)
                  (join-fp {opaque-world :W} (fp-children env (rest items)))))))
      :else {})))

; ── the algebra ─────────────────────────────────────────────────────────

(defn rung
  "Recover the ladder rung from a footprint: the join of its mode ranks."
  [fp]
  (let [max-rank (reduce (fn [r [_ m]] (max r (get mode-rank m))) -1 fp)]
    (cond (< max-rank 0) :pure
          (= max-rank 0) :pure
          (<= max-rank 2)
            (if (some (fn [[r _]] (= r :io)) fp) :io :atom)
          :else :process)))

(defn pure? [fp]
  (every? (fn [[_ m]] (= m :R)) fp))

(defn monotone? [fp]
  (every? (fn [[_ m]] (contains? #{:R :A} m)) fp))

(defn resources [fp] (set (keys fp)))

; set intersection via membership (mirrors typed/t-meet) — no clojure.set in bl.
(defn- intersect [a b] (set (filter (fn [x] (contains? a x)) (into [] b))))

(defn commute?
  "Two footprints commute iff no SHARED resource carries a conflicting mode
   pair. Disjoint resources ⟹ trivially commute (the frame rule's core)."
  [fp1 fp2]
  (every? (fn [r] (not (conflict? (get fp1 r) (get fp2 r))))
          (into [] (intersect (resources fp1) (resources fp2)))))

(defn frame-independent?
  "e1 preserves any invariant over e2's region iff their resources are
   disjoint — Separation Logic's frame rule, decided structurally."
  [fp1 fp2]
  (empty? (intersect (resources fp1) (resources fp2))))
