; research/p16_model/run_deadlock.bl — P16f: deadlock-freedom, structurally.
;
; ── The insight ───────────────────────────────────────────────────────
;
; A synchronous `call` blocks the caller until the callee replies. If a chain
; of blocked calls forms a CYCLE — A waits on B, B waits on C, C waits on A —
; every process in it is stuck forever. That is a deadlock.
;
; The "waits-for" relation is a GRAPH over the code: an edge A→B exists when a
; handler in A makes a synchronous call to B. A deadlock is exactly a CYCLE in
; that graph — and a cycle is `A reachable from A`, a recursive datalog query
; over codebase-as-data. No z3, no model exploration: the transitive closure
; (the SHIPPED fixpoint engine, semi-naive, terminates on cycles) IS the check.
;
; This is where datalog does the whole job. TLA+ finds a deadlock STATE after
; searching the state space; we find the structural CYCLE — the actual cause,
; the servers named — from the call graph directly.

(ns p16f-run
  (:require [datom]))

(defn- h [t] (println) (println (str "── " t " ──")))

; ── the waits-for graph as datoms: [?e :waits/on ?callee] per sync call site ──
;
; Extracted from source: every handler doing a synchronous server-call emits a
; :waits/on edge from its OWNING server to the CALLEE server. (Async cast/send
; do NOT block, so they contribute no edge — the model is precise about which
; calls can deadlock.)

(def SCHEMA
  [{:db/ident :server/name :db/valueType :db.type/string
    :db/unique :db.unique/identity}
   {:db/ident :waits/on :db/valueType :db.type/ref
    :db/cardinality :db.cardinality/many}])

; the recursive "blocked-on" closure: transitive waits-for.
(def BLOCKED
  '[[(blocked ?a ?b) [?a :waits/on ?b]]
    [(blocked ?a ?b) [?a :waits/on ?x] (blocked ?x ?b)]])

(defn- server [db nm]
  (get (get (into [] (datom/q '[:find ?e :in $ ?n :where [?e :server/name ?n]] db nm)) 0) 0))

; a server is in a deadlock iff it is blocked ON ITSELF (a cycle).
(defn deadlocked [db]
  (sort (map (fn [row] (get row 0))
             (into [] (datom/q '[:find ?n :in $ %
                                 :where [(blocked ?a ?a)] [?a :server/name ?n]]
                               db BLOCKED)))))

; ════════════════════════════════════════════════════════════════════════
; 1. a healthy topology: a DAG of synchronous calls — no cycle, no deadlock.
;    gateway → auth → store ;  gateway → cache.  Acyclic ⟹ deadlock-free.
; ════════════════════════════════════════════════════════════════════════

(h "topology 1: an acyclic call graph — provably deadlock-free")
(def conn1 (datom/connect SCHEMA))
(datom/transact! conn1
  [{:db/id -1 :server/name "gateway" :waits/on [-2 -4]}
   {:db/id -2 :server/name "auth"    :waits/on [-3]}
   {:db/id -3 :server/name "store"}
   {:db/id -4 :server/name "cache"}])
(def dl1 (deadlocked (datom/db conn1)))
(println (str "  waits-for: gateway→{auth,cache}, auth→store  (a DAG)"))
(println (str "  deadlocked servers: " (pr-str dl1)))
(println (if (empty? dl1)
           "  PASS: no server is blocked on itself — deadlock-free, proven from the graph."
           "  FAIL"))

; ════════════════════════════════════════════════════════════════════════
; 2. a cyclic topology: A→B→C→A. Every server in the cycle is deadlocked.
;    The checker NAMES them — the actual cause, not a mystery stuck state.
; ════════════════════════════════════════════════════════════════════════

(h "topology 2: a synchronous call cycle — the deadlock, named")
(def conn2 (datom/connect SCHEMA))
(datom/transact! conn2
  [{:db/id -1 :server/name "orders"   :waits/on [-2 -4]}
   {:db/id -2 :server/name "billing"  :waits/on [-3]}
   {:db/id -3 :server/name "shipping" :waits/on [-1]}    ; ← closes the cycle
   {:db/id -4 :server/name "audit"}])                    ; audit off to the side, safe
(def dl2 (deadlocked (datom/db conn2)))
(println (str "  waits-for: orders→billing→shipping→orders  (a CYCLE), +orders→audit"))
(println (str "  deadlocked servers: " (pr-str dl2)))
(println (if (= dl2 '("billing" "orders" "shipping"))
           (str "  PASS: the three servers in the cycle are named; audit (acyclic) is\n"
                "        correctly EXCLUDED. The cause is reported, not a stuck state.")
           "  FAIL"))

; ════════════════════════════════════════════════════════════════════════
; 3. breaking the cycle heals it: make shipping→orders ASYNC (a cast, no edge).
;    The same query now reports no deadlock — the fix is verified.
; ════════════════════════════════════════════════════════════════════════

(h "topology 3: make one call async → the cycle is broken, verified")
(def conn3 (datom/connect SCHEMA))
(datom/transact! conn3
  [{:db/id -1 :server/name "orders"   :waits/on [-2]}
   {:db/id -2 :server/name "billing"  :waits/on [-3]}
   {:db/id -3 :server/name "shipping"}])
   ; shipping→orders is now a CAST (async): it contributes NO :waits/on edge.
(def dl3 (deadlocked (datom/db conn3)))
(println (str "  waits-for: orders→billing→shipping  (shipping→orders is async, no edge)"))
(println (str "  deadlocked servers: " (pr-str dl3)))
(println (if (empty? dl3)
           (str "  PASS: turning the back-edge into an async cast removes the wait —\n"
                "        the same structural query confirms the fix. Async never blocks.")
           "  FAIL"))

(h "P16f verdict")
(println (if (and (empty? dl1)
                  (= dl2 '("billing" "orders" "shipping"))
                  (empty? dl3))
           (str "  PASS: deadlock = a cycle in waits-for = a recursive datalog query\n"
                "        over codebase-as-data. Structural cause, not a searched state.")
           "  FAIL"))
:done
