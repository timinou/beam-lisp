; research/p16_model/inductive.bl — P16c: □Inv by induction, UNBOUNDED.
;
; ── The leap ──────────────────────────────────────────────────────────
;
; P16a proved a bad state unreachable by BFS over a FINITE instance (n∈0..3).
; That is model-checking: sound only for the states you enumerate. This spike
; makes the leap to PROOF: z3 discharges the Hoare triple
;
;     Inv(s) ∧ guard(s) ∧ s' = next(s)  ⊢  Inv(s')
;
; for EVERY state and EVERY input — unbounded. If init establishes Inv and
; every transition preserves it, then □Inv holds by induction over an
; unbounded state space. This is the direct extension of MVP-C (z3.bl): there
; we proved rewrite-equivalence; here we prove state-invariant preservation.
;
; Why z3 and not BFS: inputs (a withdrawal amount) are FREE. BFS cannot
; enumerate every amount; z3 proves over all of them at once.
;
; The encoding: to prove the triple valid, assert its NEGATION and check-sat.
;   unsat  ⟹ no counterexample exists ⟹ the transition PRESERVES Inv.
;   sat    ⟹ the model is a concrete counterexample (state+input that breaks it).
;
; beam-lisp's prefix source is already valid SMT-LIB integer arithmetic
; ((>= balance amt), (- balance amt), (+ balance amt)) — so the translation
; from an extracted transition to a proof obligation is near-identity.

(ns inductive
  (:require [z3]))

; ── the proof obligation for one transition ─────────────────────────────
;
;   inv    (fn [var] "smt-predicate")     the invariant over a state var
;   svar   "balance"                       the state variable name
;   decls  "(declare-const …)…"            state + input variable declarations
;   guard  "(…)" | nil                     the enabling condition (source ≈ SMT)
;   next   "(…)"                            the next-state expression
;
; We introduce s2 = next(s), assume Inv(s) ∧ guard, and ask z3 whether
; ¬Inv(s2) is satisfiable. unsat ⟹ preserved.

(defn preserves?
  [port inv svar decls guard next]
  (let [smt (str decls
                 "(declare-const " svar "2 Int)\n"
                 "(assert " (inv svar) ")\n"
                 (if guard (str "(assert " guard ")\n") "")
                 "(assert (= " svar "2 " next "))\n"
                 "(assert (not " (inv (str svar "2")) "))\n")
        r (z3/check-model port smt)]
    {:preserved (= "unsat" (:status r))
     :model     (:model r)}))

; ── init establishes Inv ────────────────────────────────────────────────
;
; The initial state expression `init` (over the declared inputs) must satisfy
; Inv. Same shape: assert ¬Inv(init); unsat ⟹ established.

(defn establishes?
  [port inv decls init]
  (let [smt (str decls
                 "(assert (not " (inv init) "))\n")
        r (z3/check-model port smt)]
    {:established (= "unsat" (:status r))
     :model       (:model r)}))

; ── the box: □Inv iff init establishes AND every transition preserves ───
;
; transitions: [{:label :guard :next} …]. Returns a report naming any
; transition that fails, with the z3 counterexample.

(defn prove-box
  [port inv svar decls init transitions]
  (let [init-r (establishes? port inv decls init)
        step-rs (map (fn [t]
                       (let [r (preserves? port inv svar decls
                                           (:guard t) (:next t))]
                         (assoc r :label (:label t))))
                     transitions)
        failures (filter (fn [r] (not (:preserved r))) step-rs)
        ok (and (:established init-r) (empty? failures))]
    {:holds ok
     :init init-r
     :steps step-rs
     :failures failures}))
