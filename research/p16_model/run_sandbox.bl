; research/p16_model/run_sandbox.bl — P16e: footprint ⊆ caps. The unification.
;
; ── The insight (examples/sandbox/) ───────────────────────────────────
;
; Capabilities and effect-footprints are ONE lattice, seen from opposite ends:
;
;     granted caps   (UPPER bound: what code MAY touch; fork narrows child⊆parent)
;         ⊇
;     inferred footprint (LOWER bound: what code DOES touch; effect inference)
;
; The sandbox ALREADY enforces the upper bound at compile time ("code cannot
; even name what it wasn't granted"). Effect inference computes the lower.
; Verifying a sandboxed process is then one containment: footprint ⊆ caps.
;
; Four payoffs, each pressure-tested against the real mechanics in
; examples/sandbox/ files 02/04/05:
;   1. fork tree = FREE fleet non-interference (disjoint caps ⟹ commute)
;   2. un-conveyed spawn = detectable effect escalation to :opaque-world
;   3. ghost worker (destroyed env → ∅ caps) provably inert
;   4. the :global-wrapper doctrine as a proof obligation
;
; This spike models caps as resource SETS and reuses P16b's footprint algebra —
; showing the two systems are the same lattice, no new machinery.

(ns p16e-run
  (:require [footprint :as fp]))

(defn- h [t] (println) (println (str "── " t " ──")))
(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- fp-of [s] (fp/fp-walk {} (read1 s)))

; caps as a set of resource names a process MAY touch. footprint ⊆ caps.
(defn footprint-in-caps? [footprint caps]
  (every? (fn [r] (contains? caps r)) (into [] (fp/resources footprint))))

; ════════════════════════════════════════════════════════════════════════
; 1. fork tree = free fleet non-interference.
;
; examples/sandbox/02: a fork can only NARROW (child caps = parent ∩ spec).
; Two tenants forked with DISJOINT caps ⟹ their footprints are disjoint by
; construction ⟹ every worker of one commutes with every worker of the other.
; The whole fleet's non-interference is proven by the FORK TREE, no per-pair z3.
; ════════════════════════════════════════════════════════════════════════

(h "payoff 1: the fork tree IS the fleet non-interference proof")
(def tenant-a-caps #{"orders"})       ; forked: may touch :orders only
(def tenant-b-caps #{"inventory"})    ; forked: may touch :inventory only
(def a-work (fp-of "(swap! orders conj o)"))
(def b-work (fp-of "(swap! inventory dec)"))
(println (str "  tenant A caps " (pr-str tenant-a-caps) "  work footprint " (pr-str a-work)))
(println (str "  tenant B caps " (pr-str tenant-b-caps) "  work footprint " (pr-str b-work)))
(def a-ok (footprint-in-caps? a-work tenant-a-caps))
(def b-ok (footprint-in-caps? b-work tenant-b-caps))
(def cross-commute (fp/commute? a-work b-work))
(println (str "  A footprint ⊆ A caps: " a-ok "   B footprint ⊆ B caps: " b-ok))
(println (str "  A-work ⋈ B-work commute: " cross-commute))
(println (if (and a-ok b-ok cross-commute)
           (str "  PASS: disjoint caps ⟹ disjoint footprints ⟹ ALL A-workers commute\n"
                "        with ALL B-workers. A thousand-worker fleet's race-freedom\n"
                "        falls out of the fork tree — zero per-pair checks.")
           "  FAIL"))

; ════════════════════════════════════════════════════════════════════════
; 2. un-conveyed spawn = effect escalation to :opaque-world.
;
; examples/sandbox/04: a spawn does NOT carry the env — a naive worker runs at
; :global (full authority). So an un-conveyed spawn ESCALATES the footprint to
; :opaque-world, which is NOT contained in any finite cap set → the checker
; flags it. A CONVEYED spawn (capture/bind) stays within caps.
; ════════════════════════════════════════════════════════════════════════

(h "payoff 2: un-conveyed spawn escalates the footprint — caught")
(def naive-spawn (fp-of "(erlang/spawn worker)"))            ; no convey
(def sandbox-caps #{"orders" "inventory"})
(println (str "  (erlang/spawn worker)  footprint " (pr-str naive-spawn)))
(def escalates (not (footprint-in-caps? naive-spawn sandbox-caps)))
(println (str "  footprint ⊆ sandbox caps? " (not escalates)))
(println (if escalates
           (str "  PASS: :opaque-world ∉ caps → escalation flagged. The security lint\n"
                "        the sandbox docs STATE as an operator rule (file 04's trap,\n"
                "        file 05's confused deputy) is now a machine-checked obligation:\n"
                "        convey via capture/bind, or annotate ^{:trusted-spawn}.")
           "  FAIL"))

; ════════════════════════════════════════════════════════════════════════
; 3. ghost worker: a destroyed env → ∅ caps → footprint ⊆ ∅ only if inert.
;
; examples/sandbox/04: bind re-derives caps LIVE; a destroyed env yields the
; empty cap set. Any footprint touching ANYTHING then violates ⊆ ∅ → the ghost
; is provably NOT inert only if it acts. An inert ghost (footprint = {}) passes;
; a ghost that tries to touch a resource is caught. Fail-closed becomes
; fail-PROVEN-closed.
; ════════════════════════════════════════════════════════════════════════

(h "payoff 3: ghost worker (∅ caps) — inert passes, acting is caught")
(def no-caps #{})
(def inert-ghost (fp-of "(deref cached)"))          ; a read — touches "cached"
(def truly-inert (fp-of "42"))                       ; touches nothing
(println (str "  ghost reads 'cached': footprint " (pr-str inert-ghost)
              "  ⊆ ∅? " (footprint-in-caps? inert-ghost no-caps)))
(println (str "  ghost returns 42:     footprint " (pr-str truly-inert)
              "  ⊆ ∅? " (footprint-in-caps? truly-inert no-caps)))
(println (if (and (not (footprint-in-caps? inert-ghost no-caps))
                  (footprint-in-caps? truly-inert no-caps))
           (str "  PASS: a destroyed-env worker that TOUCHES anything violates ⊆∅ and\n"
                "        is caught; one that touches nothing is provably inert.\n"
                "        Authority cannot outlive the env that granted it — proven.")
           "  FAIL"))

; ════════════════════════════════════════════════════════════════════════
; 4. the :global-wrapper doctrine as a proof obligation.
;
; examples/sandbox/05: the gate does NOT re-mediate code already compiled at
; :global (setuid-helper semantics). The doctrine: "anything a sandbox must not
; do must not be reachable through a :global wrapper." In the footprint model, a
; call into an UNVERIFIED :global callee is :opaque-world — so a wrapper that
; leaks authority fails footprint ⊆ caps. A VERIFIED :global helper contributes
; its OWN (contained) footprint instead. The doctrine becomes checkable.
; ════════════════════════════════════════════════════════════════════════

(h "payoff 4: the :global-wrapper doctrine, machine-checked")
(def leaky-wrapper (fp-of "(global-helper/read-any path)"))   ; unverified :global call
(def verified-helper-fp {"orders" :R})                         ; a KNOWN-safe helper's fp
(println (str "  call into unverified :global helper: footprint " (pr-str leaky-wrapper)))
(def leaks (not (footprint-in-caps? leaky-wrapper sandbox-caps)))
(println (str "  leaky wrapper ⊆ caps? " (not leaks)))
(println (str "  a VERIFIED helper contributes its own fp " (pr-str verified-helper-fp)
              "  ⊆ caps? " (footprint-in-caps? verified-helper-fp sandbox-caps)))
(println (if (and leaks (footprint-in-caps? verified-helper-fp sandbox-caps))
           (str "  PASS: an unverified :global wrapper is :opaque-world → flagged; a\n"
                "        verified helper contributes a contained footprint → passes.\n"
                "        The setuid-helper hole the README warns about is now a\n"
                "        discharged proof obligation, not an operator caveat.")
           "  FAIL"))

(h "P16e verdict")
(println (if (and a-ok b-ok cross-commute escalates
                  (not (footprint-in-caps? inert-ghost no-caps))
                  (footprint-in-caps? truly-inert no-caps)
                  leaks)
           (str "  PASS: caps and footprints are ONE lattice. The sandbox enforces\n"
                "        the upper bound; effect inference computes the lower; the\n"
                "        containment footprint ⊆ caps unifies them.")
           "  FAIL"))
:done
