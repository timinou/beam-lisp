; research/p16_model/run_footprint.bl — P16b driver: the footprint algebra.
;
; Five claims, each a guarantee the RUNG ladder cannot express but the
; FOOTPRINT does:
;   1. the rung is RECOVERED — nothing regresses (retrofit is safe)
;   2. purity   = footprint touches only :R
;   3. monotone = footprint touches only :R/:A  (MVP-F is THIS special case)
;   4. commute  = no shared resource with a conflicting mode
;   5. frame    = disjoint resources ⟹ independent (Separation Logic, structural)

(ns p16b-run
  (:require [footprint :as fp]))

(defn- h [t] (println) (println (str "── " t " ──")))
(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- fp-of [s] (fp/fp-walk {} (read1 s)))

; ════════════════════════════════════════════════════════════════════════
; 1. the rung is recovered — the retrofit loses nothing.
; ════════════════════════════════════════════════════════════════════════

(h "claim 1: the ladder rung is recovered from the footprint")
(def cases
  [["(deref a)"              :pure]
   ["(swap! a inc)"          :atom]
   ["(erlang/send p :msg)"   :process]
   ["(println x)"            :io]])
(doall (map (fn [[src expected]]
              (let [got (fp/rung (fp-of src))]
                (println (str "  " src "  → rung " got
                              (if (= got expected) "  ✓" (str "  ✗ want " expected))))))
            cases))
(def rungs-ok (every? (fn [[src exp]] (= exp (fp/rung (fp-of src)))) cases))
(println (if rungs-ok "  PASS: rank(footprint) reproduces the shipped ladder." "  FAIL"))

; ════════════════════════════════════════════════════════════════════════
; 2. purity — footprint touches only reads.
; ════════════════════════════════════════════════════════════════════════

(h "claim 2: purity = footprint touches only :R")
(def pure-fp   (fp-of "(+ (deref a) (count xs))"))
(def impure-fp (fp-of "(swap! a inc)"))
(println (str "  (+ (deref a) (count xs))  footprint " (pr-str pure-fp)
              "  pure? " (fp/pure? pure-fp)))
(println (str "  (swap! a inc)             footprint " (pr-str impure-fp)
              "  pure? " (fp/pure? impure-fp)))
(println (if (and (fp/pure? pure-fp) (not (fp/pure? impure-fp)))
           "  PASS: purity is a property of the footprint, per-resource."
           "  FAIL"))

; ════════════════════════════════════════════════════════════════════════
; 3. monotonicity — MVP-F's monotone live query is the :R/:A special case.
; ════════════════════════════════════════════════════════════════════════

(h "claim 3: monotonicity = footprint touches only :R/:A (MVP-F retrofitted)")
(def append-fp (fp-of "(datom/transact! conn tx)"))    ; a log only GROWS → :A
(def write-fp  (fp-of "(swap! cache assoc k v)"))       ; overwrite → :W
(println (str "  (datom/transact! conn tx)  footprint " (pr-str append-fp)
              "  monotone? " (fp/monotone? append-fp)))
(println (str "  (swap! cache assoc k v)    footprint " (pr-str write-fp)
              "  monotone? " (fp/monotone? write-fp)))
(println (if (and (fp/monotone? append-fp) (not (fp/monotone? write-fp)))
           (str "  PASS: transact! is monotone (append-only) — exactly why a live\n"
                "        query over it is safe. MVP-F's gate is this one predicate.")
           "  FAIL"))

; ════════════════════════════════════════════════════════════════════════
; 4. commutativity — no shared resource with a conflicting mode.
; ════════════════════════════════════════════════════════════════════════

(h "claim 4: commutativity by shared-resource conflict")
(def w-a  (fp-of "(swap! a inc)"))       ; write a
(def w-b  (fp-of "(swap! b inc)"))       ; write b (disjoint)
(def w-a2 (fp-of "(swap! a dec)"))       ; write a (SAME resource)
(println (str "  swap!a  ⋈  swap!b  (disjoint):  commute? " (fp/commute? w-a w-b)))
(println (str "  swap!a  ⋈  swap!a  (shared W):  commute? " (fp/commute? w-a w-a2)))
(println (if (and (fp/commute? w-a w-b) (not (fp/commute? w-a w-a2)))
           (str "  PASS: disjoint writes commute; two writes to the SAME atom do not.\n"
                "        Confluence proven by ALGEBRA, not by exploring interleavings.")
           "  FAIL"))

; ════════════════════════════════════════════════════════════════════════
; 5. the frame rule — disjoint resources ⟹ independent reasoning.
; ════════════════════════════════════════════════════════════════════════

(h "claim 5: the Separation-Logic frame rule, decided structurally")
(def orders-h  (fp-of "(swap! orders conj o)"))    ; touches :orders
(def balance-h (fp-of "(swap! balance + n)"))       ; touches :balance
(println (str "  handler over :orders   footprint " (pr-str orders-h)))
(println (str "  handler over :balance  footprint " (pr-str balance-h)))
(println (str "  frame-independent? " (fp/frame-independent? orders-h balance-h)))
(println (if (fp/frame-independent? orders-h balance-h)
           (str "  PASS: the :orders handler CANNOT break an invariant over :balance —\n"
                "        their footprints are disjoint. Local reasoning, no annotation,\n"
                "        no whole-state proof. This is what makes it scale.")
           "  FAIL"))

(h "P16b verdict")
(println (if (and rungs-ok
                  (fp/pure? pure-fp) (not (fp/pure? impure-fp))
                  (fp/monotone? append-fp) (not (fp/monotone? write-fp))
                  (fp/commute? w-a w-b) (not (fp/commute? w-a w-a2))
                  (fp/frame-independent? orders-h balance-h))
           "  PASS: footprint recovers the rung AND yields purity/monotone/commute/frame."
           "  FAIL"))
:done
