; research/p16_model/abduce.bl — P16d: auto-strengthening via three engines.
;
; ── The problem ───────────────────────────────────────────────────────
;
; P16c proves □Inv when Inv is INDUCTIVE. But users write invariants that are
; TRUE yet not inductive: the property holds in every reachable state, but the
; one-step Hoare triple fails because it quantifies over states the guard never
; actually reaches. TLA+ users hit this constantly ("strengthen the inductive
; invariant"). The fix is a missing precondition P such that
;
;     Inv(s) ∧ P ∧ guard ∧ s'=next(s)  ⊢  Inv(s')
;
; ABDUCTION is the search for that P. Here it is done by THREE engines with
; STRICT non-overlap (the project's rule):
;
;   miniKanren  OWNS the search space — it ENUMERATES candidate predicate
;               structures relationally (a grammar over the state/input vars).
;               This is FEAT-027's backwards synthesis pointed at PREDICATES.
;   z3          OWNS the decision — for each candidate, is the triple valid?
;               (assert-negation, check unsat). miniKanren cannot decide
;               validity; z3 cannot enumerate structure. No overlap.
;   datalog     OWNS the discharge — "do ALL senders already establish P?"
;               is a query over the call graph. If yes, P needs NO annotation:
;               the whole program already guarantees it. Only we can do this —
;               TLA+ has no callers to query.

(ns abduce
  (:require [z3] [minikanren :as mk]))

; ── render a generated candidate (bl data) to an SMT-LIB string ─────────

(defn render [t]
  (cond
    (list? t)   (str "(" (join " " (map render t)) ")")
    (symbol? t) (str t)
    :else       (pr-str t)))

; ── the candidate grammar, enumerated RELATIONALLY by miniKanren ────────
;
; A candidate is (op a b) with op ∈ {<= >=} and a,b drawn from a domain of
; terms over the state/input variables. The domain is passed in (per problem).
; miniKanren generates the structures blindly; z3 decides which are sound.

(defn oneof [x xs]
  (mk/disj* (map (fn [v] (mk/=== x v)) xs)))

(defn candidates
  "Every (op a b) over the domain, as rendered SMT strings, deduped."
  [domain]
  (let [terms (mk/run 400 q
                (mk/fresh [op a b]
                  (mk/=== q (list op a b))
                  (oneof op (list '<= '>=))
                  (oneof a domain)
                  (oneof b domain)))]
    (distinct (map render terms))))

; ── z3 decides: is a candidate SUFFICIENT to make the triple valid? ─────

(defn sufficient?
  "Does `cand` (an SMT predicate) close the triple
   Inv(s) ∧ cand ∧ guard ∧ s'=next ⊢ Inv(s')?"
  [port inv svar decls guard next cand]
  (let [smt (str decls
                 "(declare-const " svar "2 Int)\n"
                 "(assert " (inv svar) ")\n"
                 "(assert " cand ")\n"
                 (if guard (str "(assert " guard ")\n") "")
                 "(assert (= " svar "2 " next "))\n"
                 "(assert (not " (inv (str svar "2")) "))\n")]
    (= "unsat" (z3/check port smt))))

; ── a candidate is VACUOUS if it is unsatisfiable together with Inv ─────
;
; `(>= amt amt)`-style tautologies are sound but useless; a candidate that
; CONTRADICTS Inv (making the premise false) trivially "closes" the triple
; but forbids the transition entirely. We reject both: keep candidates that
; are (a) sufficient AND (b) still allow the transition to fire (satisfiable
; with Inv and the guard).

(defn fireable?
  [port inv svar decls guard cand]
  (let [smt (str decls
                 "(assert " (inv svar) ")\n"
                 "(assert " cand ")\n"
                 (if guard (str "(assert " guard ")\n") ""))]
    (= "sat" (z3/check port smt))))

; ── the abduction: enumerate → decide → rank ────────────────────────────
;
; Returns sufficient, fireable candidates, shortest-first (a shorter predicate
; is a weaker, more general precondition — the one you want).

(defn abduce
  [port inv svar decls guard next domain]
  (let [cands (candidates domain)
        good  (filter (fn [c] (and (sufficient? port inv svar decls guard next c)
                                   (fireable? port inv svar decls guard c)))
                      cands)]
    (sort-by count good)))

; ── datalog discharge: do ALL senders already establish P? ──────────────
;
; sender-facts: a db with [?c :call/callee LABEL] [?c :call/guarantees PRED].
; If every caller of `label` guarantees `pred`, P needs no annotation.

(defn all-senders-guarantee?
  "True when every sender of `label` in `db` guarantees `pred`."
  [db q-fn label pred]
  (let [senders (q-fn '[:find ?c :in $ ?label
                        :where [?c :call/callee ?label]]
                      db label)
        establishing (q-fn '[:find ?c :in $ ?label ?pred
                             :where [?c :call/callee ?label]
                                    [?c :call/guarantees ?pred]]
                           db label pred)]
    (and (seq senders) (= (count senders) (count establishing)))))
