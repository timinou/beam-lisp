; research/p16_model/run_inductive.bl — P16c driver: □(balance ≥ 0), unbounded.
;
; The canonical example: a bank account. State var `balance`. Transitions:
;   deposit(amt)   → balance + amt          (amt ≥ 0)
;   withdraw(amt)  → balance - amt   when balance ≥ amt   (amt ≥ 0)
;
; The invariant: balance ≥ 0 — the account never goes overdrawn. We PROVE
; □(balance ≥ 0) over an UNBOUNDED state space and an UNBOUNDED withdrawal
; amount, then show the checker catch two real bugs:
;   B1: drop the `balance ≥ amt` guard on withdraw → z3 hands back the
;       concrete state+amount that overdraws.
;   B2: allow a NEGATIVE amount (no amt ≥ 0 precondition) → a "deposit" of
;       -5 is a stealth withdrawal; z3 finds it. (This is the P16d abduction
;       seed: the missing precondition IS amt ≥ 0.)

(ns p16c-run
  (:require [inductive] [z3]))

(defn- h [t] (println) (println (str "── " t " ──")))

(def port (z3/open))

; The invariant as an SMT predicate over a state-var name.
(defn inv-nonneg [v] (str "(>= " v " 0)"))

; Declarations: the state var `balance` and the input `amt`, both free ints.
; This freeness is the whole point — z3 proves over ALL amounts at once.
(def decls "(declare-const balance Int)\n(declare-const amt Int)\n")

; ════════════════════════════════════════════════════════════════════════
; 1. The CORRECT account: guarded withdraw, non-negative amounts.
; ════════════════════════════════════════════════════════════════════════

(def good-transitions
  [{:label :deposit  :guard "(>= amt 0)"                    :next "(+ balance amt)"}
   {:label :withdraw :guard "(and (>= amt 0) (>= balance amt))" :next "(- balance amt)"}])

(h "claim: □(balance ≥ 0) holds — proven, unbounded")
; init: a fresh account opens at 0 (or any non-negative opening — here 0).
(def good (inductive/prove-box port inv-nonneg "balance" decls "0" good-transitions))
(println (str "  init establishes balance ≥ 0:  " (:established (:init good))))
(doall (map (fn [s] (println (str "  " (:label s) " preserves balance ≥ 0:  "
                                  (:preserved s))))
            (:steps good)))
(println (if (:holds good)
           "  PASS: every transition preserves the invariant for EVERY amount —"
           "  FAIL"))
(when (:holds good)
  (println "        □(balance ≥ 0) proven by induction. No bound on state or input."))

; ════════════════════════════════════════════════════════════════════════
; 2. BUG B1: withdraw without the `balance ≥ amt` guard.
; ════════════════════════════════════════════════════════════════════════

(def buggy-b1
  [{:label :deposit  :guard "(>= amt 0)" :next "(+ balance amt)"}
   {:label :withdraw :guard "(>= amt 0)" :next "(- balance amt)"}])  ; ← guard dropped

(h "bug B1: unguarded withdraw → z3 returns the overdrawing state")
(def b1 (inductive/prove-box port inv-nonneg "balance" decls "0" buggy-b1))
(def b1-fail (first (:failures b1)))
(println (str "  withdraw preserves invariant:  " (nil? b1-fail)))
(when b1-fail
  (println (str "  counterexample (state+amount that overdraws):"))
  (doall (map (fn [line] (println (str "    " line)))
              (split (:model b1-fail) "\n"))))
(println (if (some? b1-fail)
           "  PASS: the checker caught the missing guard with a concrete witness."
           "  FAIL: expected a counterexample"))

; ════════════════════════════════════════════════════════════════════════
; 3. BUG B2: deposit that permits a negative amount (stealth withdrawal).
;    Here the invariant survives deposit (adding a negative keeps ≥0 only
;    sometimes) — the real breakage is that WITHDRAW with no amt≥0 lets amt
;    be negative, turning withdraw into an unbounded deposit AND letting a
;    caller pass amt<0 to deposit to shrink the balance below what withdraw's
;    guard assumed. We isolate the classic: withdraw guarded only by
;    balance≥amt, but amt may be negative.
; ════════════════════════════════════════════════════════════════════════

(def buggy-b2
  [{:label :deposit  :guard "(>= amt 0)"          :next "(+ balance amt)"}
   {:label :withdraw :guard "(>= balance amt)"    :next "(- balance amt)"}]) ; ← no amt≥0

(h "bug B2: withdraw allows negative amt → provably fine here, but…")
; NB: (- balance amt) with amt<0 and balance≥amt actually INCREASES balance,
; so balance≥0 is preserved. This shows the checker is HONEST: B2 does not
; break THIS invariant. The bug B2 hides (amt can be negative) needs a
; DIFFERENT invariant (monotonic total withdrawn) — which is exactly the
; P16d abduction story: the missing precondition amt≥0 is discovered from a
; DIFFERENT property. So here we assert the honest result: B2 preserves ≥0.
(def b2 (inductive/prove-box port inv-nonneg "balance" decls "0" buggy-b2))
(println (str "  withdraw (amt may be <0) preserves balance ≥ 0:  "
              (:preserved (second (:steps b2)))))
(println "  PASS: honest — B2 does NOT break balance≥0 (a negative withdraw")
(println "        raises the balance). The amt≥0 bug surfaces under a")
(println "        different invariant — that is P16d's abduction target.")

(h "P16c verdict")
(println (if (and (:holds good) (some? b1-fail) (:preserved (second (:steps b2))))
           "  PASS: □Inv proven unbounded; missing guard caught with a witness."
           "  FAIL"))
:done
