; research/p16_model/run_liveness.bl — P16g: bounded liveness, honestly labelled.
;
; ── The honest limit ──────────────────────────────────────────────────
;
; Safety ("nothing bad happens") we PROVE inductively, unbounded (P16c). Liveness
; ("something good eventually happens" — every request eventually replies) is
; harder: it is a statement about INFINITE behaviours. The complete method is
; temporal proof; the practical method is BOUNDED MODEL CHECKING — search for a
; LASSO (a lreachable loop that never makes progress) up to depth k.
;
;   found a lasso    ⟹ a real liveness VIOLATION (a concrete stuck cycle) — sound.
;   no lasso ≤ k     ⟹ live UP TO depth k — an APPROXIMATE guarantee, not a proof.
;
; The discipline: a bounded result is registered as an APPROXIMATE relation, so
; "which of my guarantees are exact vs bounded?" is itself a query. Honesty is
; STRUCTURAL — the bound is in the catalog, never hidden in a footnote.
;
; We model a request machine with a "pending" flag and search for a cycle that
; returns to a pending state without ever reaching :replied.

(ns p16g-run)

(defn- h [t] (println) (println (str "── " t " ──")))

; ── the approximate-relation catalog (mirrors datom.query.relation's axis) ──
;
; A guarantee is registered with :extension :exact | :approximate and, when
; approximate, the :bound it was checked to. The catalog is data.

(def catalog (atom {}))
(defn register! [ident spec] (swap! catalog assoc ident spec) ident)
(defn approximate-guarantees []
  (sort (map (fn [[k _]] k)
             (filter (fn [[_ v]] (= :approximate (:extension v)))
                     (into [] (deref catalog))))))

; ── the machine: a request handler as a transition function ─────────────
;
; state = {:phase :input}. A GOOD handler always drives :pending → :replied.
; A BUGGY handler has a branch that loops :pending → :pending forever (a
; request that spins without answering) — the lasso we must find.

; good: pending + any input → replied (one step, always progresses)
(defn good-step [s]
  (cond
    (= (:phase s) :idle)    {:phase :pending}
    (= (:phase s) :pending) {:phase :replied}
    :else s))

; buggy: a :retry input keeps it pending forever (no progress → a lasso)
(defn buggy-step [s input]
  (cond
    (= (:phase s) :idle)                        {:phase :pending}
    (and (= (:phase s) :pending) (= input :ok)) {:phase :replied}
    (and (= (:phase s) :pending) (= input :retry)) {:phase :pending} ; ← spins
    :else s))

; ── BMC: search for a lasso up to depth k ────────────────────────────────
;
; A lasso for "every request eventually replies" = a reachable state we can
; return to (a cycle) without :replied appearing on the cycle. We do a bounded
; DFS over the buggy machine driven by the worst-case input (:retry), tracking
; visited phases; a repeat with no :replied between is a liveness violation.

(defn find-lasso [step-fn worst-input k]
  (loop [s {:phase :idle} seen [] i 0]
    (cond
      (>= i k) {:lasso false :depth i :trace (conj seen (:phase s))}
      (and (some (fn [p] (= p (:phase s))) seen)
           (not (some (fn [p] (= p :replied)) seen)))
        {:lasso true :depth i :trace (conj seen (:phase s))}
      :else
        (recur (step-fn s worst-input) (conj seen (:phase s)) (+ i 1)))))

; ════════════════════════════════════════════════════════════════════════
; 1. the GOOD handler: no lasso up to k=20 → live up to depth 20 (approximate).
; ════════════════════════════════════════════════════════════════════════

(h "claim 1: good handler — no lasso ≤ k, live up to the bound (APPROXIMATE)")
(def good-r (find-lasso (fn [s _] (good-step s)) :any 20))
(println (str "  searched to depth " (:depth good-r) ": lasso found? " (:lasso good-r)))
(register! :~replies-eventually
           {:extension :approximate :bound 20 :property "every request replies"})
(println (str "  registered :~replies-eventually as " (:extension (get (deref catalog) :~replies-eventually))
              " (bound " (:bound (get (deref catalog) :~replies-eventually)) ")"))
(println (if (not (:lasso good-r))
           (str "  PASS: no stuck cycle within 20 steps → live UP TO depth 20.\n"
                "        This is a BOUNDED guarantee — and it is labelled as one.")
           "  FAIL"))

; ════════════════════════════════════════════════════════════════════════
; 2. the BUGGY handler: :retry spins forever → a lasso is FOUND (sound bug).
; ════════════════════════════════════════════════════════════════════════

(h "claim 2: buggy handler — the :retry lasso is found (a sound violation)")
(def buggy-r (find-lasso buggy-step :retry 20))
(println (str "  worst-case input :retry, trace: " (pr-str (:trace buggy-r))))
(println (str "  lasso found at depth " (:depth buggy-r) ": " (:lasso buggy-r)))
(println (if (:lasso buggy-r)
           (str "  PASS: a concrete stuck cycle (:pending → :pending, no :replied) —\n"
                "        a liveness VIOLATION with a witness trace. Sound: a found\n"
                "        lasso is always a real bug.")
           "  FAIL"))

; ════════════════════════════════════════════════════════════════════════
; 3. honesty is structural: the catalog distinguishes exact from approximate.
; ════════════════════════════════════════════════════════════════════════

(h "claim 3: 'which guarantees are exact vs bounded?' is a query")
(register! :~balance-nonneg
           {:extension :exact :property "balance ≥ 0 (P16c, inductive)"})
(println (str "  approximate guarantees: " (pr-str (approximate-guarantees))))
(println (str "  :~balance-nonneg extension: "
              (:extension (get (deref catalog) :~balance-nonneg)) " (proven unbounded)"))
(println (if (and (= (approximate-guarantees) '(:~replies-eventually))
                  (= :exact (:extension (get (deref catalog) :~balance-nonneg))))
           (str "  PASS: the bounded liveness result is CATALOGUED as approximate;\n"
                "        the inductive safety result as exact. No guarantee lies about\n"
                "        its own strength.")
           "  FAIL"))

(h "P16g verdict")
(println (if (and (not (:lasso good-r)) (:lasso buggy-r)
                  (= (approximate-guarantees) '(:~replies-eventually)))
           (str "  PASS: BMC finds real lassos (sound) and bounds the rest (honest) —\n"
                "        the approximation is structural, in the catalog, not hidden.")
           "  FAIL"))
:done
