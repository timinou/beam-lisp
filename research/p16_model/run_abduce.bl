; research/p16_model/run_abduce.bl — P16d driver: the abduction ladder.
;
; Four rungs, trivial → impossible, each showing the three-engine cooperation
; and where it honestly stops:
;   rung 1  already inductive          → nothing to abduce (P16c handles it)
;   rung 2  needs ONE conjunct         → miniKanren enumerates, z3 decides, found
;   rung 3  discharged by SENDERS       → datalog proves no annotation needed
;   rung 4  genuinely not provable      → all candidates rejected, honest report
;
; The engines never overlap: miniKanren ENUMERATES structure, z3 DECIDES
; validity, datalog DISCHARGES against the call graph.

(ns p16d-run
  (:require [abduce] [z3] [datom]))

(defn- h [t] (println) (println (str "── " t " ──")))
(def port (z3/open))

(defn inv-nonneg [v] (str "(>= " v " 0)"))
(def decls "(declare-const balance Int)\n(declare-const amt Int)\n")
; the term domain abduction searches over: the vars and 0
(def domain '[balance amt 0])

; ════════════════════════════════════════════════════════════════════════
; rung 1 — already inductive: withdraw guarded by (>= balance amt).
; ════════════════════════════════════════════════════════════════════════

(h "rung 1: already inductive — nothing to abduce")
(def r1-suff
  (abduce/sufficient? port inv-nonneg "balance" decls
                      "(>= balance amt)" "(- balance amt)" "true"))
(println (str "  withdraw guarded (>= balance amt), no extra P needed: " r1-suff))
(println (if r1-suff "  PASS: the guard alone makes it inductive." "  FAIL"))

; ════════════════════════════════════════════════════════════════════════
; rung 2 — NOT inductive: withdraw guarded only by (>= balance amt) but amt
; may be negative? No — that preserves ≥0. The real non-inductive case: a
; withdraw with NO guard at all. z3 (P16c) says it fails; abduction searches
; for the P that fixes it.
; ════════════════════════════════════════════════════════════════════════

(h "rung 2: unguarded withdraw — abduce the missing precondition")
(println "  z3 says the bare triple fails (P16c). Searching for P…")
(def r2
  (abduce/abduce port inv-nonneg "balance" decls
                 nil                       ; no guard
                 "(- balance amt)"         ; withdraw
                 domain))
(println (str "  candidates enumerated by miniKanren, decided by z3."))
(println (str "  sufficient + fireable Ps (shortest first): " (pr-str (take 3 r2))))
(def r2-found (some (fn [c] (or (= c "(<= amt balance)") (= c "(>= balance amt)"))) r2))
(println (str "  shortest sufficient P: " (pr-str (first r2))
              "  (a non-positive withdrawal cannot overdraw)"))
(println (if (seq r2)
           "  PASS: miniKanren enumerated, z3 decided — a sound precondition found."
           "  FAIL: no precondition found"))

; ════════════════════════════════════════════════════════════════════════
; rung 3 — the discharge only WE can do: does the whole program already
; guarantee P at every call site? A datalog query over the call graph. If
; every caller of :withdraw guarantees (>= balance amt), P needs NO annotation.
; ════════════════════════════════════════════════════════════════════════

(h "rung 3: datalog discharge — do all senders already guarantee P?")
(def conn
  (datom/connect
    [{:db/ident :call/callee     :db/valueType :db.type/keyword}
     {:db/ident :call/guarantees :db/valueType :db.type/string}]))
; two call sites of :withdraw, BOTH guarding the amount first
(datom/transact! conn
  [{:db/id -1 :call/callee :withdraw :call/guarantees "(>= balance amt)"}
   {:db/id -2 :call/callee :withdraw :call/guarantees "(>= balance amt)"}])

(defn q3 [query db & args] (apply datom/q query db args))
(def discharged
  (abduce/all-senders-guarantee? (datom/db conn) q3 :withdraw "(>= balance amt)"))
(println (str "  every caller of :withdraw guarantees (>= balance amt): " discharged))
(println (if discharged
           "  PASS: the precondition holds at every send — NO annotation needed."
           "  FAIL"))
(println "        TLA+ cannot do this: it has no callers to query. We do.")

; add a THIRD, careless caller that does NOT guarantee it → discharge fails
(datom/transact! conn [{:db/id -3 :call/callee :withdraw}])
(def discharged2
  (abduce/all-senders-guarantee? (datom/db conn) q3 :withdraw "(>= balance amt)"))
(println (str "  after adding an unguarded caller: still discharged? " discharged2))
(println (if (not discharged2)
           "  PASS: the one careless call site is found — annotate or guard it."
           "  FAIL"))

; ════════════════════════════════════════════════════════════════════════
; rung 4 — genuinely not provable: an invariant no single-conjunct P can fix.
; balance ≥ 100 after an unguarded withdraw of a free amt: no precondition
; over {balance amt 0} of the shape (op a b) makes it inductive from a general
; balance (you'd need balance ≥ 100 + amt, a term not in the tiny domain).
; The honest outcome: abduction returns nothing → report, don't fabricate.
; ════════════════════════════════════════════════════════════════════════

(h "rung 4: abduction is domain-relative — too small a vocabulary, honest silence")
(def tiny-domain '[amt])   ; no balance, no 0 — cannot express the fix
(def r4
  (abduce/abduce port inv-nonneg "balance" decls nil "(- balance amt)" tiny-domain))
(println (str "  candidates over {amt} that close (>= balance 0): " (pr-str r4)))
(def r4-wide
  (abduce/abduce port inv-nonneg "balance" decls nil "(- balance amt)" domain))
(println (str "  … widening the domain to {balance amt 0} finds: "
              (pr-str (take 1 r4-wide))))
(println (if (and (empty? r4) (seq r4-wide))
           (str "  PASS: nothing in the tiny domain — the checker reports 'cannot\n"
                "        strengthen with this vocabulary', never a false proof.\n"
                "        Widen the domain (a knob) and the fix appears.")
           "  FAIL"))


(h "P16d verdict")
(println (if (and r1-suff (seq r2) discharged (not discharged2) (empty? r4) (seq r4-wide))
           "  PASS: three engines, strict non-overlap — enumerate, decide, discharge."
           "  FAIL"))
:done
