; rt/probe-read.bl — differential test for read-data and registries.
;
; Tests the 5 names in the read group and compares the BL implementations
; against the Elixir BeamLisp.RT functions.
;
; Shared state: both implementations use BeamLisp.Env directly, so state
; persists across calls and between the two runtimes.

(ns rt.probe-read
  (:require [rt.read :as read]))

(defn- outcome [f]
  "Invoke f and capture either the result or that an exception was raised."
  (try {:ok (f)} (catch _e {:raised true})))

(defn- verdict [bl ex]
  "Compare two outcomes: agree if both raised or both returned the same value."
  (cond
    (and (:raised bl) (:raised ex)) :agree
    (:raised ex) :bl-more-total
    (:raised bl) :fail
    :else (if (erlang/== (:ok bl) (:ok ex)) :agree :fail)))

(defn- test-read-data []
  "read-data: test valid source."
  (let [bl-r (outcome #(read/read-data "(+ 1 2)"))
        ex-r (outcome #(BeamLisp.RT/read_data "(+ 1 2)"))]
    (verdict bl-r ex-r)))

(defn- test-reader-macro-miss []
  "reader-macro: lookup non-existent entry returns :error."
  (let [bl-r (outcome #(read/reader-macro "NonExistent"))
        ex-r (outcome #(BeamLisp.RT/reader_macro "NonExistent"))]
    (verdict bl-r ex-r)))

(defn- test-reader-macro-register []
  "reader-macro!: register and verify lookup."
  (let [sym 'probe-rm-test
        _ (read/reader-macro! "Q" sym)
        _ (BeamLisp.RT/reader_macro! "Q" sym)
        bl-r (outcome #(read/reader-macro "Q"))
        ex-r (outcome #(BeamLisp.RT/reader_macro "Q"))]
    (verdict bl-r ex-r)))

(defn- test-data-reader-miss []
  "data-reader: lookup non-existent entry returns :error."
  (let [bl-r (outcome #(read/data-reader "missing"))
        ex-r (outcome #(BeamLisp.RT/data_reader "missing"))]
    (verdict bl-r ex-r)))

(defn- test-data-reader-register []
  "data-reader!: register and verify lookup."
  (let [sym 'probe-dr-test
        _ (read/data-reader! "Z" sym)
        _ (BeamLisp.RT/data_reader! "Z" sym)
        bl-r (outcome #(read/data-reader "Z"))
        ex-r (outcome #(BeamLisp.RT/data_reader "Z"))]
    (verdict bl-r ex-r)))

(defn run []
  (let [tests (list
                (list "read-data" test-read-data)
                (list "reader-macro miss" test-reader-macro-miss)
                (list "reader-macro! register" test-reader-macro-register)
                (list "data-reader miss" test-data-reader-miss)
                (list "data-reader! register" test-data-reader-register))]
    (loop [agree 0 fail 0 bl-more 0 ts tests]
      (cond
        (erlang/== ts ())
        (do
          (println (str "read group: " agree " agree, " fail " fail, "
                        bl-more " bl-more-total"))
          (when (erlang/> fail 0)
            (println "FAILURES DETECTED")))
        :else
        (let [test-pair (erlang/hd ts)
              label (erlang/element 1 test-pair)
              test-fn (erlang/element 2 test-pair)
              result (test-fn)]
          (cond
            (erlang/== result :agree)
            (recur (erlang/+ agree 1) fail bl-more (erlang/tl ts))
            (erlang/== result :fail)
            (do
              (println (str "  FAIL: " label))
              (recur agree (erlang/+ fail 1) bl-more (erlang/tl ts)))
            (erlang/== result :bl-more-total)
            (recur agree fail (erlang/+ bl-more 1) (erlang/tl ts))
            :else
            (recur agree fail bl-more (erlang/tl ts))))))))

(run)
