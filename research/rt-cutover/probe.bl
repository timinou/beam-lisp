; rt/probe.bl — the cutover's mechanism proof (PLAN-143 P0).
;
; Nothing here is a semantic test; the oracle (P1) is that. This file proves the
; three structural facts the whole cutover rests on, before a single runtime
; operation is ported:
;
;   1. a BL namespace `rt` emits the BEAM module `Elixir.BeamLisp.Ns.Rt` with
;      real exports a plain remote call can reach;
;   2. calling through the public namespace works from another BL namespace;
;   3. a link row authored IN BEAM-LISP (`BeamLisp.Env/put_link`) routes a BARE
;      name to that module — which is the whole mechanism by which the compiler
;      will target the BL runtime without a compiler change. `seed_links/0` is a
;      data table today; this is that table, written on the other side.

(ns rt.probe
  (:require [rt :as r]))

(defn- check [label ok]
  (when (not ok) (throw (ex-info (str "rt.probe assertion: " label) {}))))

(defn- exports-of
  "The export list of a module atom, as {name arity} tuples."
  [mod]
  (to-list (erlang/apply mod :module_info (list :exports))))

(defn- exports? [mod name arity]
  (some (fn [p] (and (erlang/== name (erlang/element 1 p))
                     (erlang/== arity (erlang/element 2 p))))
        (exports-of mod)))

(defn run []
  (let [mod (erlang/binary_to_atom "Elixir.BeamLisp.Ns.Rt" :utf8)]

    ;; (1) identity + exports: the namespace is a real module with real arities.
    (check "module Elixir.BeamLisp.Ns.Rt is loaded"
           (not (erlang/== false (erlang/apply :code :is_loaded (list mod)))))
    (check "exports kind/1" (exports? mod :kind 1))
    (check "exports vector?/1" (exports? mod :vector? 1))
    (check "exports map?/1" (exports? mod :map? 1))
    (check "a private helper is NOT exported" (not (exports? mod :is-kind? 1)))

    ;; (2) the public namespace answers, from another namespace.
    (check "kind of a vector" (erlang/== :vector (r/kind [1 2 3])))
    (check "kind of a map" (erlang/== :map (r/kind {:a 1})))
    (check "kind of a list" (erlang/== :list (r/kind (list 1 2))))
    (check "kind of nil" (erlang/== :nil (r/kind nil)))
    (check "vector? true" (erlang/== true (r/vector? [1])))
    (check "vector? false on a map" (erlang/== false (r/vector? {:a 1})))
    (check "map? false on a vector" (erlang/== false (r/map? [1])))
    (check "number? true on a decimal" (erlang/== true (r/number? 1M)))

    ;; (3) a BL-authored link row routes a bare name to this module. `kind-of`
    ;; does not exist anywhere else, so answering :vector can only mean the call
    ;; reached Elixir.BeamLisp.Ns.Rt.
    (let [nsname "rt.probe-client"]
      (BeamLisp.Env/put_link nsname "kind-of" (tuple mod {1 :kind} nil))
      (BeamLisp.Env/in_ns nsname)
      (check "a BL link row routes a bare name to the BL runtime"
             (erlang/== :vector (BeamLisp/eval "(kind-of [1 2 3])")))
      (check "the same bare name is unresolvable without the row"
             (try (do (BeamLisp/eval "(no-such-linked-name [1 2])") false)
                  (catch _e true)))))

  (println "PASS rt.probe: module identity, exports, and a BL-authored link row"))(run)
