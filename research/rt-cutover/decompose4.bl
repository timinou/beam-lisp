; rt/decompose4.bl — per-element costs, correctly normalised.
;
; Earlier attempts had two defects of mine: the timed lambda constructed its own
; argument list (so the row measured construction), and `erlang/apply :lists
; :reverse <list>` spread the list as 1000 arguments. This file makes every row
; do exactly the work it names and reports ns PER ELEMENT.

(ns rt.decompose4
  (:require [rt :as rt]
            [rt.seq :as s]))

(defn- now [] (erlang/monotonic_time :nanosecond))

(defn- consume [x] (cond (erlang/== x nil) 0 (erlang/== x true) 1 :else 2))

(defn- best-of [rounds f n]
  (loop [r rounds best nil]
    (cond
      (erlang/== r 0) best
      :else (let [t0 (now)
                  _ (loop [i 0 acc 0]
                      (cond (erlang/>= i n) acc
                            :else (recur (erlang/+ i 1) (erlang/+ acc (consume (f))))))
                  d (erlang/- (now) t0)]
              (recur (erlang/- r 1) (if (or (erlang/== best nil) (erlang/< d best)) d best))))))

(defn- per-element
  "`f` performs exactly one walk of NELEMS elements; report ns per element."
  [label f rounds nelems]
  (println (str "  " label "\t ns/element "
                (erlang/div (best-of 3 f rounds) (erlang/* rounds nelems)))))

(defn- mk
  "A list of n integers IN ORDER, matching (range n) except at index i."
  [n i]
  (erlang/apply :lists :reverse
    (list (loop [j 0 acc ()]
            (cond
              (erlang/>= j n) acc
              :else (recur (erlang/+ j 1)
                           (cons (if (erlang/== j i) 100000 j) acc)))))))

(defn- mv
  "A vector of n integers in order, matching (range n) except at index i."
  [n i]
  (loop [j 0 acc []]
    (cond
      (erlang/>= j n) acc
      :else (recur (erlang/+ j 1) (conj acc (if (erlang/== j i) 100000 j))))))

(defn- add1 [x] (erlang/+ x 1))

(defn run []
  (let [n 1000
        l (to-list (range n))
        ld (mk n (erlang/- n 1))
        v (into [] (range n))
        vd (mv n (erlang/- n 1))]

    (println "=== the raw walks (no comparison) ===")
    (per-element "list walk hd/tl"
      (fn [] (loop [xs l acc 0]
               (cond (erlang/== xs ()) acc
                     :else (recur (erlang/tl xs) (erlang/+ acc (erlang/hd xs))))))
      2000 n)
    (per-element "vector walk seq/first/next"
      (fn [] (loop [xs (s/k-seq v) acc 0]
               (cond (erlang/== xs nil) acc
                     :else (recur (s/k-next xs) (erlang/+ acc (s/k-first xs))))))
      500 n)
    (per-element "vector walk k-first+k-next only"
      (fn [] (loop [xs (s/k-seq v) acc 0]
               (cond (erlang/== xs nil) acc
                     :else (recur (s/k-next xs) (erlang/+ acc 1)))))
      500 n)

    (println "=== one call, in a loop, nothing constructed ===")
    (per-element "call local defn"
      (fn [] (loop [i 0 acc 0]
               (cond (erlang/>= i n) acc :else (recur (erlang/+ i 1) (add1 acc)))))
      2000 n)
    (per-element "call a BIF"
      (fn [] (loop [i 0 acc 0]
               (cond (erlang/>= i n) acc :else (recur (erlang/+ i 1) (erlang/abs acc)))))
      2000 n)

    (println "=== full comparisons, differ at the LAST element ===")
    (per-element "compare 1000-list" (fn [] (rt/compare l ld)) 300 n)
    (per-element "compare 1000-vector" (fn [] (rt/compare v vd)) 100 n)
    (per-element "compare 1000-vector, EQUAL" (fn [] (rt/compare v (into [] (range n)))) 500 n))
  (println "done"))

(run)
