; rt/coll.bl — collection operations dispatched on representation.

(ns rt.coll
  (:require [rt.kind :as k]
            [rt.raw :as raw]
            [rt.seq :as seq]
            [rt.eq :as eq]))

;; ── helpers ────────────────────────────────────────────────────────────────

(defn- entry [kk v]
  (maps/put :meta nil
    (maps/put :items (raw/tuple2 kk v)
      (maps/put :__struct__ k/VEC-MOD (maps/new)))))

(defn- hash-key [k]
  (BeamLisp.RT/hash_key k))

;; ── GET ────────────────────────────────────────────────────────────────────

(defn get [m key & args]
  (let [default (cond (erlang/> (count args) 0) (first args) :else nil)]
    (let [kd (k/kind m)]
      (cond
        (erlang/== kd :vector) (BeamLisp.Vector/nth m key)
        (erlang/== kd :set) (cond (BeamLisp.Set/member? m key) key :else default)
        (erlang/== kd :sorted-set) (cond (BeamLisp.Sorted/set_member? m key) key :else default)
        (erlang/== kd :sorted-map) (BeamLisp.Sorted/map_get m key default)
        (erlang/== kd :record)
        (cond (erlang/== key :__struct__) default
              :else (maps/get key m default))
        (erlang/== kd :map) (maps/get (hash-key key) m default)
        (erlang/== kd :nil) default
        :else default))))

;; ── CONJ ───────────────────────────────────────────────────────────────────

(defn conj
  ([x] x)
  ([x v]
   (let [kd (k/kind x)]
     (cond
       (erlang/== kd :nil) (raw/cons v ())
       (erlang/== kd :list) (raw/cons v x)
       (erlang/== kd :vector) (BeamLisp.Vector/conj x v)
       (erlang/== kd :lazy) (raw/cons v x)
       (erlang/== kd :set) (BeamLisp.Set/add x v)
       (erlang/== kd :sorted-set) (BeamLisp.Sorted/set_add x v)
       (erlang/== kd :sorted-map)
       (cond
         (erlang/== (k/kind v) :vector)
         (let [items (erlang/map_get :items v)]
           (BeamLisp.Sorted/map_put x (erlang/element 1 items) (erlang/element 2 items)))
         :else x)
       (erlang/== kd :map)
       (cond
         (erlang/== (k/kind v) :vector)
         (let [items (erlang/map_get :items v)]
           (maps/put (hash-key (erlang/element 1 items)) (erlang/element 2 items) x))
         (erlang/is_list v)
         (cond (erlang/== 2 (erlang/apply :length (raw/cons v ())))
               (let [k (erlang/hd v) val (erlang/hd (erlang/tl v))]
                 (maps/put (hash-key k) val x))
               :else x)
         (erlang/is_tuple v)
         (cond (erlang/== 2 (erlang/tuple_size v))
               (maps/put (hash-key (erlang/element 1 v)) (erlang/element 2 v) x)
               :else x)
         :else x)
       (erlang/== kd :record)
       (cond
         (erlang/== (k/kind v) :vector)
         (let [items (erlang/map_get :items v)]
           (maps/put (erlang/element 1 items) (erlang/element 2 items) x))
         :else x)
       :else x))))

;; ── CONTAINS? ──────────────────────────────────────────────────────────────

(defn contains? [coll key]
  (let [kd (k/kind coll)]
    (cond
      (erlang/== kd :vector) (cond (erlang/>= key 0) (erlang/< key (BeamLisp.Vector/count coll)) :else false)
      (erlang/== kd :set) (BeamLisp.Set/member? coll key)
      (erlang/== kd :sorted-set) (BeamLisp.Sorted/set_member? coll key)
      (erlang/== kd :sorted-map) (BeamLisp.Sorted/map_has_key? coll key)
      (erlang/== kd :record) (cond (erlang/== key :__struct__) false :else (erlang/is_map_key key coll))
      (erlang/== kd :map) (erlang/is_map_key (hash-key key) coll)
      :else false)))

;; ── ASSOC ──────────────────────────────────────────────────────────────────

(defn assoc [coll key val]
  (let [kd (k/kind coll)]
    (cond
      (erlang/== kd :vector) (BeamLisp.Vector/assoc coll key val)
      (erlang/== kd :sorted-map) (BeamLisp.Sorted/map_put coll key val)
      (erlang/== kd :record)
      (cond (erlang/== key :__struct__) coll
            :else (maps/put key val coll))
      (erlang/== kd :map) (maps/put (hash-key key) val coll)
      (erlang/== kd :nil) (maps/put (hash-key key) val (maps/new))
      :else coll)))

(defn assoc-variadic [coll key val rest]
  (loop [acc (assoc coll key val) ks rest]
    (cond
      (erlang/== ks ()) acc
      :else
      (let [k (erlang/hd ks)
            v (erlang/hd (erlang/tl ks))
            ks2 (erlang/tl (erlang/tl ks))]
        (recur (assoc acc k v) ks2)))))

;; ── FIND ───────────────────────────────────────────────────────────────────

(defn find [m key]
  (let [kd (k/kind m)]
    (cond
      (erlang/== kd :sorted-map)
      (cond (BeamLisp.Sorted/map_has_key? m key)
            (entry key (BeamLisp.Sorted/map_get m key nil))
            :else nil)
      (erlang/== kd :record)
      (cond (erlang/== key :__struct__) nil
            (erlang/is_map_key key m) (entry key (maps/get key m))
            :else nil)
      (erlang/== kd :map)
      (let [hk (hash-key key)]
        (cond (erlang/is_map_key hk m) (entry key (maps/get hk m))
              :else nil))
      :else nil)))

;; ── SET ────────────────────────────────────────────────────────────────────

(defn set [coll]
  (let [kd (k/kind coll)]
    (cond
      (erlang/== kd :set) coll
      :else (BeamLisp.Set/new (seq/k-to-list (seq/k-seq coll))))))

;; ── DISJ ───────────────────────────────────────────────────────────────────

(defn disj [coll elem]
  (let [kd (k/kind coll)]
    (cond
      (erlang/== kd :set) (BeamLisp.Set/del coll elem)
      (erlang/== kd :sorted-set) (BeamLisp.Sorted/set_del coll elem)
      :else coll)))

;; ── PEEK ───────────────────────────────────────────────────────────────────

(defn peek [coll]
  (let [kd (k/kind coll)]
    (cond
      (erlang/== kd :vector)
      (let [xs (BeamLisp.Vector/to_list coll)]
        (cond (erlang/== xs ()) nil
              :else (erlang/apply :lists :last (raw/cons xs ()))))
      (erlang/== kd :nil) nil
      :else (BeamLisp.RT/first coll))))

;; ── POP ────────────────────────────────────────────────────────────────────

(defn pop [coll]
  (let [kd (k/kind coll)]
    (cond
      (erlang/== kd :vector)
      (let [xs (BeamLisp.Vector/to_list coll)]
        (cond (erlang/== xs ()) (erlang/error (raw/tuple2 :"$error" "Can't pop empty vector"))
              :else (BeamLisp.Vector/new (erlang/apply :lists :droplast (raw/cons xs ())))))
      (erlang/== kd :list)
      (cond (erlang/== coll ()) (erlang/error (raw/tuple2 :"$error" "Can't pop empty list"))
            :else (erlang/tl coll))
      (erlang/== kd :nil) (erlang/error (raw/tuple2 :"$error" "Can't pop empty list"))
      :else (BeamLisp.RT/rest coll))))

;; ── LAST-KEY ──────────────────────────────────────────────────────────────

(defn last-key [coll]
  (let [kd (k/kind coll)]
    (cond
      (erlang/== kd :sorted-map) (BeamLisp.Sorted/last_key coll)
      (erlang/== kd :sorted-set) (BeamLisp.Sorted/last_key coll)
      :else nil)))

;; ── LAST-ENTRY ────────────────────────────────────────────────────────────

(defn last-entry [coll]
  (let [kd (k/kind coll)]
    (cond
      (erlang/== kd :sorted-map)
      (let [e (BeamLisp.Sorted/last_entry coll)]
        (cond (erlang/== e nil) nil
              :else (entry (erlang/element 1 e) (erlang/element 2 e))))
      :else nil)))

;; ── CONCAT ─────────────────────────────────────────────────────────────────

(defn concat [seqs]
  (BeamLisp.RT/concat seqs))

;; ── SORT ───────────────────────────────────────────────────────────────────

(defn sort [coll]
  (erlang/apply :lists :sort
    (raw/cons
      (fn [a b] (erlang/=< (eq/k-compare a b) 0))
      (raw/cons (seq/k-to-list (seq/k-seq coll)) ()))))
