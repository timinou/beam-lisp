; rt/print.bl — printing and stringification.
;
; The printer is the bootstrap seed's required set — the compiler calls
; print-str directly. It handles every representation the runtime can hold.

(ns rt.print
  (:require [rt.raw :as raw]))

;; Module atoms for struct detection
(def VEC-MOD     (erlang/binary_to_atom "Elixir.BeamLisp.Vector" :utf8))
(def SET-MOD     (erlang/binary_to_atom "Elixir.BeamLisp.Set" :utf8))
(def LAZY-MOD    (erlang/binary_to_atom "Elixir.BeamLisp.LazySeq" :utf8))
(def SMAP-MOD    (erlang/binary_to_atom "Elixir.BeamLisp.Sorted.SortedMap" :utf8))
(def SSET-MOD    (erlang/binary_to_atom "Elixir.BeamLisp.Sorted.SortedSet" :utf8))
(def DECIMAL-MOD (erlang/binary_to_atom "Elixir.BeamLisp.Decimal" :utf8))

;; Helper functions

(defn- struct-mod
  "Extract the __struct__ module from a value, or nil."
  [x]
  (cond
    (erlang/is_map x) (maps/get :__struct__ x nil)
    :else nil))

(defn- name-part
  "Extract name from 'ns/name' string."
  [s]
  (let [idx (erlang/string:find s "/")]
    (cond
      (erlang/== idx :nomatch) s
      :else (erlang/string:substr s (erlang/+ idx 2)))))

(defn- ns-part
  "Extract namespace from 'ns/name' string, or nil."
  [s]
  (let [idx (erlang/string:find s "/")]
    (cond
      (erlang/== idx :nomatch) nil
      :else (erlang/string:substr s 1 (erlang/- idx 1)))))

(defn- split-keyword
  "Split namespace and name from keyword inputs."
  [ns name]
  (let [name-str (cond (erlang/is_binary name) name :else (erlang/atom_to_binary name :utf8))
        ns-str (cond (erlang/== ns nil) nil (erlang/is_binary ns) ns :else (erlang/atom_to_binary ns :utf8))
        name-idx (erlang/string:find name-str "/")]
    (cond
      (not (erlang/== name-idx :nomatch))
      (let [extracted-ns (erlang/string:substr name-str 1 (erlang/- name-idx 1))
            extracted-name (erlang/string:substr name-str (erlang/+ name-idx 2))]
        (raw/tuple2 extracted-ns extracted-name))
      :else
      (raw/tuple2 ns-str name-str))))

(defn- improper-list?
  "Check if list ends in LazySeq."
  [xs]
  (loop [x xs]
    (cond
      (erlang/== nil x) false
      (erlang/== [] x) false
      (erlang/is_list x)
      (let [tail (erlang/tl x)]
        (cond
          (erlang/is_map tail)
          (erlang/== (struct-mod tail) LAZY-MOD)
          :else (recur tail)))
      :else false)))

;; Print functions - define print-str first, no recursion

(defn print-str
  "Print a value non-readably."
  [x]
  (let [mod (struct-mod x)]
    (cond
      ;; Vector
      (erlang/== mod VEC-MOD)
      (let [vec-list (erlang/apply (:BeamLisp.Vector :to_list) [x])]
        (erlang/apply :string :concat ["[" (print-elem-list vec-list) "]"]))
      
      ;; Set
      (erlang/== mod SET-MOD)
      (let [set-list (erlang/apply (:BeamLisp.Set :to_list) [x])]
        (erlang/apply :string :concat ["#{" (print-elem-list set-list) "}"]))
      
      ;; SortedSet
      (erlang/== mod SSET-MOD)
      (let [sset-list (erlang/apply (:BeamLisp.Sorted :set_to_list) [x])]
        (erlang/apply :string :concat ["#{" (print-elem-list sset-list) "}"]))
      
      ;; SortedMap
      (erlang/== mod SMAP-MOD)
      (let [smap-list (erlang/apply (:BeamLisp.Sorted :map_to_list) [x])
            strs (loop [xs smap-list acc ()]
                   (cond
                     (erlang/== xs nil) (erlang/apply :lists :reverse [acc])
                     :else
                     (let [kv (erlang/hd xs)
                           k (erlang/element 1 kv)
                           v (erlang/element 2 kv)
                           pair-str (erlang/apply :string :concat [(print-str k) " " (print-str v)])]
                       (recur (erlang/tl xs) (raw/cons pair-str acc)))))]
        (erlang/apply :string :concat ["{" (erlang/apply :string :join [strs ", "]) "}"]))
      
      ;; Decimal
      (erlang/== mod DECIMAL-MOD)
      (erlang/apply (:BeamLisp.Decimal :to_literal) [x])
      
      ;; Record
      (and (erlang/is_map x) (erlang/is_map_key :__struct__ x)
           (erlang/apply (:BeamLisp.Record :record?) [mod]))
      (let [info (erlang/apply (:BeamLisp.Record :info) [mod])
            ns (erlang/element 2 info)
            name (erlang/element 3 info)
            pairs (erlang/apply :maps :to_list [x])
            strs (loop [xs pairs acc ()]
                   (cond
                     (erlang/== xs nil) (erlang/apply :lists :reverse [acc])
                     :else
                     (let [kv (erlang/hd xs)
                           k (erlang/element 1 kv)
                           v (erlang/element 2 kv)]
                       (if (erlang/== k :__struct__)
                         (recur (erlang/tl xs) acc)
                         (let [pair-str (erlang/apply :string :concat [(print-str k) " " (print-str v)])]
                           (recur (erlang/tl xs) (raw/cons pair-str acc)))))))]
        (erlang/apply :string :concat ["#" ns "/" name "{" (erlang/apply :string :join [strs ", "]) "}"]))
      
      ;; Unknown struct use inspect
      (erlang/is_map x)
      (erlang/apply :erlang :inspect [x])
      
      ;; Tuples: functions and symbols
      (erlang/is_tuple x)
      (cond
        (erlang/>= (erlang/tuple_size x) 1)
        (let [tag (erlang/element 1 x)]
          (cond
            (erlang/== tag :$blfn)
            (if (erlang/>= (erlang/tuple_size x) 3)
              (if (erlang/== (erlang/element 3 x) nil)
                "#fn[multi-arity]"
                "#fn[variadic]")
              "#fn[multi-arity]")
            
            (erlang/== tag :$remote)
            (if (erlang/>= (erlang/tuple_size x) 3)
              (erlang/apply :string :concat ["#fn[" (erlang/element 2 x) "/" (erlang/element 3 x) "]"])
              (erlang/apply :erlang :inspect [x]))
            
            (erlang/== tag :symbol)
            (erlang/element 2 x)
            
            :else (erlang/apply :erlang :inspect [x])))
        :else (erlang/apply :erlang :inspect [x]))
      
      ;; Strings
      (erlang/is_binary x) x
      
      ;; nil, true, false
      (erlang/== x nil) "nil"
      (erlang/== x true) "true"
      (erlang/== x false) "false"
      
      ;; Atoms (keywords)
      (is_atom x) (erlang/apply :erlang :++ [":" (erlang/atom_to_binary x :utf8)])
      
      ;; Lists
      (erlang/is_list x)
      (if (improper-list? x)
        (print-seq x)
        (erlang/apply :string :concat ["(" (print-elem-list x) ")"]))
      
      ;; Fallback
      :else (erlang/apply :erlang :inspect [x]))))

(defn- print-elem-list
  "Print list of elements space-separated."
  [elems]
  (loop [xs elems acc ""]
    (cond
      (erlang/== xs nil) acc
      :else
      (let [elem-str (print-str (erlang/hd xs))
            new-acc (if (erlang/== acc "")
                      elem-str
                      (erlang/apply :string :concat [acc " " elem-str]))]
        (recur (erlang/tl xs) new-acc)))))

(defn- print-seq
  "Print bounded lazy seq or improper list (max 20 elements)."
  [lazy]
  (let [sample-result (erlang/apply (:BeamLisp.LazySeq :sample) [lazy 20])
        elems (erlang/element 1 sample-result)
        truncated (erlang/element 2 sample-result)
        body (print-elem-list elems)
        suffix (if truncated " …" "")]
    (erlang/apply :string :concat ["(" body suffix ")"])))

(defn print-readably
  "Print a value readably (strings are quoted)."
  [x]
  (if (erlang/is_binary x)
    (erlang/apply :erlang :inspect [x])
    (print-str x)))

(defn- to-str
  "Convert value to string."
  [x]
  (cond
    (erlang/== x nil) ""
    (erlang/is_binary x) x
    (is_atom x) (erlang/atom_to_binary x :utf8)
    (erlang/is_tuple x)
    (if (erlang/>= (erlang/tuple_size x) 2)
      (if (erlang/== (erlang/element 1 x) :symbol)
        (erlang/element 2 x)
        (print-str x))
      (print-str x))
    (erlang/is_list x) (print-str x)
    (erlang/is_map x) (print-str x)
    :else (erlang/apply :erlang :to_string [x])))

(defn str
  "Stringify and concatenate arguments."
  ([] "")
  ([x] (to-str x))
  ([x & rest]
   (let [all-args (raw/cons x rest)
         str-fn (fn [v]
                  (if (erlang/is_map v)
                    (let [mod (struct-mod v)]
                      (if (erlang/== mod DECIMAL-MOD)
                        (let [lit (erlang/apply (:BeamLisp.Decimal :to_literal) [v])]
                          (erlang/string:substr lit 1 (erlang/- (erlang/string:len lit) 1)))
                        (to-str v)))
                    (to-str v)))
         parts (loop [xs all-args acc ()]
                 (cond
                   (erlang/== xs nil) (erlang/apply :lists :reverse [acc])
                   :else (recur (erlang/tl xs) (raw/cons (str-fn (erlang/hd xs)) acc))))]
     (erlang/apply :string :concat [parts]))))

(defn println
  "Print with newline."
  ([] (erlang/apply :io :puts [""]))
  ([x] (erlang/apply :io :puts [(print-str x)]))
  ([x & rest] (println-multi x rest)))

(defn println-multi
  "Print multiple args space-separated with newline."
  [x rest-list]
  (let [all-args (raw/cons x rest-list)
        parts (loop [xs all-args acc ()]
                (cond
                  (erlang/== xs nil) (erlang/apply :lists :reverse [acc])
                  :else (recur (erlang/tl xs) (raw/cons (print-str (erlang/hd xs)) acc))))]
    (erlang/apply :io :puts [(erlang/apply :string :join [parts " "])])))

(defn print-elem
  "Print an element (same as print-str)."
  [x]
  (print-str x))

(defn name-of
  "Extract name part from keyword, symbol, or string."
  [x]
  (cond
    (erlang/is_binary x) x
    (erlang/is_tuple x)
    (if (erlang/>= (erlang/tuple_size x) 2)
      (if (erlang/== (erlang/element 1 x) :symbol)
        (name-part (erlang/element 2 x))
        nil)
      nil)
    (is_atom x)
    (if (and (not (erlang/== x true)) (not (erlang/== x false)) (not (erlang/== x nil)))
      (name-part (erlang/atom_to_binary x :utf8))
      nil)
    :else nil))

(defn namespace-of
  "Extract namespace part from keyword or symbol."
  [x]
  (cond
    (erlang/is_tuple x)
    (if (erlang/>= (erlang/tuple_size x) 2)
      (if (erlang/== (erlang/element 1 x) :symbol)
        (ns-part (erlang/element 2 x))
        nil)
      nil)
    (is_atom x)
    (if (and (not (erlang/== x true)) (not (erlang/== x false)) (not (erlang/== x nil)))
      (ns-part (erlang/atom_to_binary x :utf8))
      nil)
    :else nil))

(defn keyword-of
  "Create a keyword with the given namespace and name."
  [ns name]
  (let [kw-tuple (split-keyword ns name)
        ns-part (erlang/element 1 kw-tuple)
        name-part (erlang/element 2 kw-tuple)
        kw-str (if (erlang/== ns-part nil)
                 name-part
                 (erlang/apply :string :concat [ns-part "/" name-part]))]
    (erlang/apply :erlang :binary_to_atom [kw-str :utf8])))

(defn gensym
  "Generate a unique symbol."
  ([] (gensym "G"))
  ([prefix]
   (let [prefix-str (if (erlang/is_binary prefix) prefix (erlang/atom_to_binary prefix :utf8))
         unique (erlang/apply :erlang :system_time [:nanosecond])
         gensym-name (erlang/apply :string :concat [prefix-str "__" (erlang/apply :erlang :integer_to_binary [unique]) "__auto"])]
     (raw/tuple2 :symbol gensym-name))))
