; rt/decompose2.bl — the fixed/variable split, in ONE run, adjacent rows.
;
; decompose.bl said a bare list walk costs 19ns per element, and list COMPARISON
; costs 327ns per element — a 17x gap with no allocation in either loop. Two
; candidates: a large fixed cost per compare call (the classifier runs on both
; operands, and `erlang/is_list` on a long list may itself walk), or something
; per element. Separate them by comparing lists that differ at the FIRST element
; (one step) against lists that differ at the LAST (n steps), and by timing the
; classifier on a long list directly.

(ns rt.decompose2
  (:require [rt :as rt]
            [rt.kind :as k]))

(defn- now [] (erlang/monotonic_time :nanosecond))

(defn- consume [x] (cond (erlang/== x nil) 0 (erlang/== x true) 1 :else 2))

(defn- best-of [rounds f n]
  (loop [r rounds best nil]
    (cond
      (erlang/== r 0) best
      :else (let [t0 (now)
                  _ (loop [i 0 acc 0]
                      (cond (erlang/>= i n) acc
                            :else (recur (erlang/+ i 1) (erlang/+ acc (consume (f))))))
                  d (erlang/- (now) t0)]
              (recur (erlang/- r 1) (if (or (erlang/== best nil) (erlang/< d best)) d best))))))

(defn- row-n [label f n]
  (println (str "  " label "\t bl " (erlang/div (best-of 3 f n) n) "\t n " n)))

(defn- ints-at
  "A list of n integers matching `(range n)` except at index i."
  [n i]
  (loop [j 0 acc ()]
    (cond
      (erlang/>= j n) acc
      :else (recur (erlang/+ j 1)
                   (cons (if (erlang/== j i) 100000 j) acc)))))

(defn run []
  (let [l1000 (to-list (range 1000))
        l100 (to-list (range 100))
        l10 (to-list (range 10))
        first-diff (ints-at 1000 0)
        last-diff (ints-at 1000 999)]
    (println "=== classifier on values of different lengths (is a tag test O(n)?) ===")
    (row-n "kind 10-list"   (fn [] (k/kind l10)) 200000)
    (row-n "kind 100-list"  (fn [] (k/kind l100)) 50000)
    (row-n "kind 1000-list" (fn [] (k/kind l1000)) 20000)
    (row-n "is_list 1000-list" (fn [] (erlang/is_list l1000)) 20000)
    (row-n "is_list 10-list"   (fn [] (erlang/is_list l10)) 200000)
    (row-n "family(kind 1000-list)" (fn [] (k/family (k/kind l1000))) 20000)

    (println "=== compare on lists: one step vs n steps (the fixed/variable split) ===")
    (row-n "compare 1000-list, differ FIRST" (fn [] (rt/compare l1000 first-diff)) 2000)
    (row-n "compare 1000-list, differ LAST"  (fn [] (rt/compare l1000 last-diff)) 500)
    (row-n "compare 100-list, differ LAST"   (fn [] (rt/compare l100 (ints-at 100 99))) 5000)
    (row-n "compare 10-list, differ LAST"    (fn [] (rt/compare l10 (ints-at 10 9))) 20000)
    (println "done")))

(run)
