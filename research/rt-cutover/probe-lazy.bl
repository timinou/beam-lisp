; probe-lazy.bl — differential test for lazy sequences.
;
; Runs every lazy function over a corpus of values, comparing the BL
; implementation against BeamLisp.RT. Lazy results must be forced before
; comparing, since the oracle normalizes them to proper lists.

(ns rt.probe-lazy
  (:require [rt.lazy :as lazy]))

(def ^:private LAZYCQ-MOD :"Elixir.BeamLisp.LazySeq")

(def vals
  (list nil true false 0 1 -1 2.5 1M :kw 'sym "str"
        () (list 1 2 3) (list 1)
        [] [1 2 3] [1]
        (into [] (range 40))
        #{} #{1 2 3}
        {} {:a 1} {:a 1 :b 2}
        (BeamLisp.LazySeq/new (fn [] (list 1 2 3)))
        (lazy/range)
        (lazy/range 5)
        (lazy/range 2 7)
        (lazy/iterate (fn [x] (erlang/+ x 1)) 0)
        (lazy/repeat :x)
        (lazy/cycle (list 1 2))))

;; ── force a lazy result to a list for comparison ────────────────────────────
(defn- force-lazy [x]
  "If x is lazy or an improper list, force it to a proper list. Otherwise
   return it unchanged."
  (cond
    (erlang/is_map x)
    (cond
      (erlang/== (maps/get :"__struct__" x nil)
        LAZYCQ-MOD)
      (BeamLisp.LazySeq/to_list x)
      :else x)
    (erlang/is_list x)
    (cond
      (is-improper? x)
      (BeamLisp.LazySeq/to_list x)
      :else x)
    :else x))

(defn- is-improper? [xs]
  (cond
    (erlang/is_list xs)
    (cond
      (erlang/== () xs) false
      :else (is-improper-tail? (erlang/tl xs)))
    :else false))

(defn- is-improper-tail? [tail]
  (cond
    (erlang/== nil tail) false
    (erlang/== () tail) false
    (erlang/is_map tail)
    (cond
      (erlang/== (maps/get :"__struct__" tail nil)
        LAZYCQ-MOD)
      true
      :else false)
    (erlang/is_list tail) (is-improper-tail? (erlang/tl tail))
    :else false))

;; ── outcome helper ────────────────────────────────────────────────────────
(defn- outcome [f v]
  "Call f on v, capturing raises as {:raised true}."
  (try {:ok (f v)} (catch _e {:raised true})))

;; ── equality check with force-lazy ───────────────────────────────────────
(defn- agree? [a b]
  (let [fa (cond (:ok a) (force-lazy (:ok a)) (:raised a) :raised :else :error)
        fb (cond (:ok b) (force-lazy (:ok b)) (:raised b) :raised :else :error)]
    (erlang/== fa fb)))

;; ── run all tests ────────────────────────────────────────────────────────
(defn run []
  (let [;; Test map
        map-results (map (fn [v]
                           (let [f (fn [x] (erlang/+ x 1))
                                 a (outcome (fn [c] (force-lazy (lazy/map f c))) v)
                                 b (outcome (fn [c] (force-lazy (BeamLisp.RT/map f c))) v)]
                             (cond (agree? a b) :agree :else {:fail v :fn "map" :bl a :rt b})))
                         vals)
        map-fails (filter (fn [r] (map? r)) map-results)

        ;; Test filter
        filter-results (map (fn [v]
                              (let [p (fn [x] (erlang/> x 0))
                                    a (outcome (fn [c] (force-lazy (lazy/filter p c))) v)
                                    b (outcome (fn [c] (force-lazy (BeamLisp.RT/filter p c))) v)]
                                (cond (agree? a b) :agree :else {:fail v :fn "filter" :bl a :rt b})))
                            vals)
        filter-fails (filter (fn [r] (map? r)) filter-results)

        ;; Test take-while
        take-while-results (map (fn [v]
                                  (let [p (fn [x] (erlang/< x 3))
                                        a (outcome (fn [c] (force-lazy (lazy/take-while p c))) v)
                                        b (outcome (fn [c] (force-lazy (BeamLisp.RT/take_while p c))) v)]
                                    (cond (agree? a b) :agree :else {:fail v :fn "take-while" :bl a :rt b})))
                                vals)
        take-while-fails (filter (fn [r] (map? r)) take-while-results)

        ;; Test drop-while
        drop-while-results (map (fn [v]
                                  (let [p (fn [x] (erlang/< x 2))
                                        a (outcome (fn [c] (force-lazy (lazy/drop-while p c))) v)
                                        b (outcome (fn [c] (force-lazy (BeamLisp.RT/drop_while p c))) v)]
                                    (cond (agree? a b) :agree :else {:fail v :fn "drop-while" :bl a :rt b})))
                                vals)
        drop-while-fails (filter (fn [r] (map? r)) drop-while-results)

        ;; Test doall
        doall-results (map (fn [v]
                             (let [a (outcome lazy/doall v)
                                   b (outcome BeamLisp.RT/doall v)]
                               (cond (agree? a b) :agree :else {:fail v :fn "doall" :bl a :rt b})))
                           vals)
        doall-fails (filter (fn [r] (map? r)) doall-results)

        ;; Test dorun
        dorun-results (map (fn [v]
                             (let [a (outcome lazy/dorun v)
                                   b (outcome BeamLisp.RT/dorun v)]
                               (cond (erlang/== (:ok a) (:ok b)) :agree
                                     (and (:raised a) (:raised b)) :agree
                                     :else {:fail v :fn "dorun" :bl a :rt b})))
                           vals)
        dorun-fails (filter (fn [r] (map? r)) dorun-results)

        ;; Test iterate (limit to 5 elements to compare)
        iterate-results (map (fn [init]
                               (let [f (fn [x] (erlang/+ x 1))
                                     a (take 5 (force-lazy (lazy/iterate f init)))
                                     b (take 5 (force-lazy (BeamLisp.RT/iterate f init)))]
                                 (cond (erlang/== a b) :agree :else {:fail init :fn "iterate" :bl a :rt b})))
                             (list 0 1 2.5))
        iterate-fails (filter (fn [r] (map? r)) iterate-results)

        ;; Test repeat (limit to 5 elements)
        repeat-results (map (fn [v]
                              (let [a (take 5 (force-lazy (lazy/repeat v)))
                                    b (take 5 (force-lazy (BeamLisp.RT/repeat v)))]
                                (cond (erlang/== a b) :agree :else {:fail v :fn "repeat" :bl a :rt b})))
                            (list 1 :a "x"))
        repeat-fails (filter (fn [r] (map? r)) repeat-results)

        ;; Test range (various arities)
        range-results (list
          (let [a (force-lazy (lazy/range))
                b (force-lazy (BeamLisp.RT/range))
                ;; Compare first 10 elements
                a10 (take 10 a) b10 (take 10 b)]
            (cond (erlang/== a10 b10) :agree :else {:fail "range/0" :bl a10 :rt b10}))
          (let [a (force-lazy (lazy/range 5))
                b (force-lazy (BeamLisp.RT/range 5))]
            (cond (erlang/== a b) :agree :else {:fail "range/1" :bl a :rt b}))
          (let [a (force-lazy (lazy/range 2 7))
                b (force-lazy (BeamLisp.RT/range 2 7))]
            (cond (erlang/== a b) :agree :else {:fail "range/2" :bl a :rt b})))
        range-fails (filter (fn [r] (map? r)) range-results)

        ;; Test cycle (limit to 6 elements)
        cycle-results (map (fn [v]
                             (let [a (take 6 (force-lazy (lazy/cycle v)))
                                   b (take 6 (force-lazy (BeamLisp.RT/cycle v)))]
                               (cond (erlang/== a b) :agree :else {:fail v :fn "cycle" :bl a :rt b})))
                           (list (list 1 2) (list :a) ()))
        cycle-fails (filter (fn [r] (map? r)) cycle-results)

        ;; Test map-multi
        map-multi-results (let [f (fn [a b] (erlang/+ a b))
                                 v1 (list 1 2 3)
                                 v2 (list 10 20 30)]
                             (let [a (force-lazy (lazy/map-multi f v1 (list v2)))
                                   b (force-lazy (BeamLisp.RT/map_multi f v1 (list v2)))]
                               (cond (erlang/== a b) :agree :else {:fail "map-multi" :bl a :rt b})))
        map-multi-fails (cond (map? map-multi-results) (list map-multi-results) :else ())

        ;; Test tree-seq
        tree-seq-results (let [branch? (fn [x] (erlang/is_list x))
                                children (fn [x] x)
                                root (list (list 1 2) (list 3 4))]
                            (let [a (lazy/tree-seq branch? children root)
                                  b (BeamLisp.RT/tree_seq branch? children root)]
                              (cond (erlang/== a b) :agree :else {:fail "tree-seq" :bl a :rt b})))
        tree-seq-fails (cond (map? tree-seq-results) (list tree-seq-results) :else ())

        ;; Test subseq and rsubseq with sorted maps
        sorted-tests (let [sm (BeamLisp.Sorted/new :map (list (list 1 :a) (list 2 :b) (list 3 :c) (list 4 :d)))]
                       (list
                         (let [a (lazy/subseq sm 2 4)
                               b (BeamLisp.RT/subseq sm 2 4)]
                           (cond (erlang/== a b) :agree :else {:fail "subseq" :bl a :rt b}))
                         (let [a (lazy/rsubseq sm 4 2)
                               b (BeamLisp.RT/rsubseq sm 4 2)]
                           (cond (erlang/== a b) :agree :else {:fail "rsubseq" :bl a :rt b}))))
        sorted-fails (filter (fn [r] (map? r)) sorted-tests)

        ;; Collect all failures
        all-fails (concat map-fails filter-fails take-while-fails drop-while-fails
                          doall-fails dorun-fails iterate-fails repeat-fails
                          range-fails cycle-fails map-multi-fails tree-seq-fails
                          sorted-fails)
        total (erlang/+ (count map-results) (count filter-results) (count take-while-results)
                        (count drop-while-results) (count doall-results) (count dorun-results)
                        (count iterate-results) (count repeat-results) (count range-results)
                        (count cycle-results) 1 1 (count sorted-tests))]
    (println (str "lazy: " total " values, " (erlang/- total (count all-fails)) " agree, " (count all-fails) " fail"))
    (doseq [f all-fails]
      (let [fn-name (cond (map? f) (:fn f) :else "unknown")
            fail-val (cond (map? f) (:fail f) :else f)]
        (println (str "  FAIL on " (pr-str fail-val)))))
    (println (cond (erlang/== 0 (count all-fails)) "PASS rt.probe-lazy"
                   :else "FAIL rt.probe-lazy"))))

(run)
