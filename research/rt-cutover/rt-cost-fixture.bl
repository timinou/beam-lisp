; rt-cost-fixture.bl — the census' own test.
;
; An instrument that reports nothing is indistinguishable from one that cannot
; report. This file contains three shapes whose work class is known BY
; CONSTRUCTION, so a run of cost.bl is judged rather than believed:
;
;   walk-all   a loop with a constant body                          -> class 1
;   wasteful   calls walk-all on an argument that NEVER changes     -> QUADRATIC
;   proper     calls walk-all on the shrinking argument             -> not flagged
;
; `wasteful` is not a hypothetical: it is the shape the first `seq-cmp` had
; (realizing both sides on every element) and the shape the resolution census
; found in `EMPTY`. It is here so that a clean run on the runtime means
; something.

(ns rt.cost-fixture)

(defn- walk-all
  "Linear in xs: one pass, constant body."
  [xs]
  (loop [ys xs acc 0]
    (cond (erlang/== ys ()) acc
          :else (recur (erlang/tl ys) (erlang/+ acc 1)))))

(defn- wasteful
  "Quadratic by construction: a linear call on the WHOLE input, once per
   element. The argument is loop-invariant, which is the whole point."
  [xs]
  (loop [ys xs]
    (cond (erlang/== ys ()) nil
          :else (do (walk-all xs) (recur (erlang/tl ys))))))

(defn- proper
  "Linear: the same call, on the argument this iteration actually has."
  [xs]
  (loop [ys xs]
    (cond (erlang/== ys ()) nil
          :else (do (walk-all ys) (recur (erlang/tl ys))))))
