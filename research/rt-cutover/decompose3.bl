; rt/decompose3.bl — is a call inside a namespace a direct call?
;
; decompose.bl measured, in ONE run: a bare list walk (hd/tl, accumulate) at
; 19ns per element, and `list-cmp` at 327ns per element. Both loops are trivial;
; the only difference is that list-cmp calls a helper per element. If a call to a
; function in the SAME namespace costs ~300ns, then every internal call in the
; runtime is a var lookup plus a dynamic dispatch, and THAT is the constant to
; attack — not the arithmetic.
;
; Method: one file, adjacent rows, one bare loop compared against loops whose
; only difference is the call form. A within-run comparison is the only kind this
; host's noise allows (point estimates drift 1.6-4x between runs).

(ns rt.decompose3
  (:require [rt :as rt]
            [rt.seq :as s]))

(defn- now [] (erlang/monotonic_time :nanosecond))

(defn- consume [x] (cond (erlang/== x nil) 0 (erlang/== x true) 1 :else 2))

(defn- best-of [rounds f n]
  (loop [r rounds best nil]
    (cond
      (erlang/== r 0) best
      :else (let [t0 (now)
                  _ (loop [i 0 acc 0]
                      (cond (erlang/>= i n) acc
                            :else (recur (erlang/+ i 1) (erlang/+ acc (consume (f))))))
                  d (erlang/- (now) t0)]
              (recur (erlang/- r 1) (if (or (erlang/== best nil) (erlang/< d best)) d best))))))

(defn- row-n [label f n]
  (println (str "  " label "\t ns/op " (erlang/div (best-of 3 f n) n))))

;; ── the helper, called in three ways ─────────────────────────────────────────

(defn- local-helper [x] (erlang/+ x 1))

(defn- loop-bare []
  (loop [i 0 acc 0]
    (cond (erlang/>= i 200) acc :else (recur (erlang/+ i 1) (erlang/+ acc 1)))))

(defn- loop-local-call []
  (loop [i 0 acc 0]
    (cond (erlang/>= i 200) acc :else (recur (erlang/+ i 1) (local-helper acc)))))

(defn- loop-static-remote []
  (loop [i 0 acc 0]
    (cond (erlang/>= i 200) acc :else (recur (erlang/+ i 1) (rt.decompose3/local-helper acc)))))

(defn- loop-alias-call []
  (loop [i 0 acc 0]
    (cond (erlang/>= i 200) acc :else (recur (erlang/+ i 1) (s/k-first (list acc 9))))))

(defn- loop-other-ns []
  (loop [i 0 acc 0]
    (cond (erlang/>= i 200) acc :else (recur (erlang/+ i 1) (rt/kind acc)))))

(defn- loop-bif []
  (loop [i 0 acc 0]
    (cond (erlang/>= i 200) acc :else (recur (erlang/+ i 1) (erlang/abs acc)))))

(defn- mk
  "A list of n integers, IN ORDER, matching (range n) except at index i."
  [n i]
  (erlang/apply :lists :reverse
    (loop [j 0 acc ()]
      (cond
        (erlang/>= j n) acc
        :else (recur (erlang/+ j 1) (cons (if (erlang/== j i) 100000 j) acc))))))

(defn run []
  (println "=== A. the cost of ONE call, 200 calls per round ===")
  (row-n "loop, bare arithmetic"        (fn [] (loop-bare)) 20000)
  (row-n "loop, call local defn"        (fn [] (loop-local-call)) 20000)
  (row-n "loop, call ns-qualified"      (fn [] (loop-static-remote)) 20000)
  (row-n "loop, call via :as alias"     (fn [] (loop-alias-call)) 20000)
  (row-n "loop, call facade rt/kind"    (fn [] (loop-other-ns)) 20000)
  (row-n "loop, call erlang BIF"        (fn [] (loop-bif)) 20000)

  (println "=== B. a real full walk, correctly ordered (differ at the LAST) ===")
  (let [l (to-list (range 1000))
        d (mk 1000 999)
        d0 (mk 1000 0)]
    (row-n "bare walk of the same list" (fn [] (loop [xs l acc 0]
                                                 (cond (erlang/== xs ()) acc
                                                       :else (recur (erlang/tl xs) (erlang/+ acc 1))))) 2000)
    (row-n "compare 1000-list, differ at index 0"   (fn [] (rt/compare l d0)) 2000)
    (row-n "compare 1000-list, differ at index 999" (fn [] (rt/compare l d)) 300))
  (println "done"))

(run)
