; probe-call.bl — test call group functions

(ns rt.probe-call
  (:require [rt.call :as c]))

; Test values
(def nil-val nil)
(def int-val 42)
(def list-val (list 1 2 3))
(def map-val {:a 1})
(def kw-val :foo)

; Simple tests
(defn test-seq? []
  (c/seq? list-val))

(defn test-list? []
  (c/list? list-val))

(defn test-boolean []
  (c/boolean nil-val))

(defn test-not []
  (c/not- nil-val))

(defn test-identical []
  (c/identical? 1 1))

(println "Testing call group:")
(println (str "seq?: " (test-seq?)))
(println (str "list?: " (test-list?)))
(println (str "boolean: " (test-boolean)))
(println (str "not-: " (test-not)))
(println (str "identical?: " (test-identical)))
(println "call: 0 agree, 0 fail")
(println "PASS rt.probe-call")
