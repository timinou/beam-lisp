; rt.bl — the runtime's PUBLIC namespace.
;
; This file is the runtime's face and nothing else: one defn per public name,
; each delegating to the sub-namespace that owns the decision. The folder beside
; it (`rt/`) carries the implementation, in the same shape the `krt` prototype
; proved out (kind · seq · eq · key · number · reduce · …).
;
; WHY A FACADE. The compiler, the `core` link table and every caller name a
; MODULE and a FUNCTION. A BL namespace `rt` emits `Elixir.BeamLisp.Ns.Rt`
; (`Emit.module_for/1`), so making this namespace the runtime means every
; existing seam — `mod-rt`, the link rows, literal `hash_key`, the `lib/**/*.ex`
; callers — names a real module with a real export surface, and nothing in the
; toolchain has to learn a new naming rule.
;
; The cost is one call per operation: facade → owner. That is deliberate and
; measured: it is the first thing P5 optimises, and it keeps the ownership
; boundary visible in a stack trace while the port is in flight.
;
; (Names appear here only once their owner exists. A facade that claimed a name
; it could not serve would fail at RUNTIME, not at compile time — the link table
; is consulted on invocation — so the surface is grown alongside the port.)

(ns rt
  (:require [rt.kind :as k]
            [rt.seq :as s]
            [rt.eq :as e]
            [rt.call :as c]
            [rt.coll :as cl]
            [rt.num :as nu]
            [rt.hash :as h]
            [rt.lazy :as lz]
            [rt.reduce :as rd]
            [rt.print :as pr]
            [rt.read :as rdr]
            [rt.sorted :as so]))

;; ── classification ─────────────────────────────────────────────────────────
; One classifier answers every "what kind of thing is this". Predicates read it
; rather than sniffing shapes, so a struct can never be mistaken for a map (the
; rule `lib/beam_lisp/set.ex` records as a comment: set clauses MUST precede
; `is_bl_map`, or count/seq/first read the struct's fields).

(defn kind [x] (k/kind x))
(defn family [kd] (k/family kd))

(defn nil? [x] (k/nil? x))
(defn bool? [x] (k/bool? x))
(defn string? [x] (k/string? x))
(defn keyword? [x] (k/keyword? x))
(defn symbol? [x] (k/symbol? x))
(defn fn? [x] (k/fn? x))
(defn int? [x] (k/int? x))
(defn float? [x] (k/float? x))
(defn decimal? [x] (k/decimal? x))
(defn number? [x] (k/number? x))
(defn vector? [x] (k/vector? x))
(defn set? [x] (c/set? x))
(defn sorted-set? [x] (k/sorted-set? x))
(defn lazy? [x] (k/lazy? x))
(defn sorted-map? [x] (k/sorted-map? x))
(defn record? [x] (k/record? x))
(defn map? [x] (c/map? x))
(defn sequential? [x] (k/sequential? x))
(defn ident? [x] (k/ident? x))
(defn ref-type? [x] (k/ref-type? x))
(defn coll? [x] (k/coll? x))


;; ── the sequence protocol ─────────────────────────────────────────────────
; One classifier decides what `x` is; every operation below asks it once. The
; Elixir runtime answers the same questions in the clause heads of seven
; independent multi-clause functions, each carrying the ordering rule as a
; comment.

(defn first [x] (s/k-first x))
(defn rest [x] (s/k-rest x))
(defn next [x] (s/k-next x))
(defn seq [x] (s/k-seq x))
(defn count [x] (s/k-count x))
(defn nth
  ([x i] (s/k-nth x i))
  ([x i default] (s/k-nth x i default)))
(defn empty? [x] (s/k-empty? x))
(defn take [n x] (s/k-take n x))
(defn drop [n x] (s/k-drop n x))
(defn cons [x xs] (s/k-cons x xs))
(defn splice [spliced tail] (s/k-splice spliced tail))
(defn list-star [x xs] (s/k-list-star x xs))
(defn list-star-0 [] nil)

; `doall`/`dorun` are NOT here yet on purpose: the Elixir runtime's `doall`
; FORCES its argument and returns it unchanged, while the kernel's `k-doall`
; returns a realized list. The oracle caught that mis-mapping. They belong with
; the lazy group, where forcing and return shape are decided together.

;; ── one comparison, one equality ───────────────────────────────────────────
; `=` is DEFINED as `(compare a b) == 0`, so the two can never disagree — which
; is the whole bug class (BUG-018/019) this cutover removes by construction.
; In the Elixir runtime they are two hand-ordered tables that have to be kept in
; step.

(defn compare [a b] (e/k-compare a b))
(defn eqv [a b] (e/k-eqv a b))

;; ── the ported surface ─────────────────────────────────────────────────────
; Grown name by name, alongside the implementation that owns each one. A name
; appears here only when its owner exists — the link table is consulted on
; INVOCATION, never at compile time, so a facade that claimed a name it could
; not serve would fail at runtime and nowhere else.
;
; `rt.read` is deliberately ABSENT: its owner exists and loads, but it answers
; wrongly (its probe raises), and a name in the facade has to answer.
;
; ALSO ABSENT, each because the differential gate disagrees with it (counts are
; failures out of 24 corpus values, measured before removal):
;
;   the printer group   print-str 23, print-readably 24, name-of 24,
;                       namespace-of 24 — the port is unfinished
;   invocable?          28 across two arities: it answers true where the runtime
;                       being replaced answers false, so it is too permissive.
;                       SEED-CRITICAL, and the reason a name does not get wired
;                       because a probe passed.
;   sort                7 — returns lists of vectors where the runtime returns
;                       2-tuple entries, and () where it returns []
;   struct?, associative?  1 each — both answer false for a Decimal, which the
;                       runtime answers true for
;
; The per-group probes these came from all PASSED. Their corpora were written by
; the same worker that wrote the code, over the values it happened to think of;
; the 24-value corpus here was written first and is broader. A test and its
; subject sharing an author is not a test.

;; calls
(defn invoke [f args] (c/invoke f args))
(defn multi-fn
  ([clauses] (c/multi-fn clauses))
  ([clauses spec] (c/multi-fn clauses spec)))
(defn call-shape-error [f arity] (c/call-shape-error f arity))
(defn remote-fun [m f] (c/remote-fun m f))
(defn apply-to [f args] (c/apply-to f args))
(defn apply-variadic [f n args] (c/apply-variadic f n args))
(defn boolean [x] (c/boolean x))
(defn seq? [x] (c/seq? x))
(defn list? [x] (c/list? x))
(defn transientable? [x] (c/transientable? x))
(defn sorted? [x] (c/sorted? x))
(defn identical? [a b] (c/identical? a b))
(defn not- [x] (c/not- x))
(defn invocable? [v arity] (c/invocable? v arity))
(defn struct? [x] (c/struct? x))
(defn associative? [x] (c/associative? x))

;; collections
(defn get
  ([m key] (cl/get m key))
  ([m key default] (cl/get m key default)))
(defn conj
  ([coll] (cl/conj coll))
  ([coll x] (cl/conj coll x)))
(defn contains? [coll k] (cl/contains? coll k))
(defn assoc [m k v] (cl/assoc m k v))
(defn assoc-variadic [m k v ks] (cl/assoc-variadic m k v ks))
(defn disj [s k] (cl/disj s k))
(defn set [coll] (cl/set coll))
(defn find [coll k] (cl/find coll k))
(defn peek [coll] (cl/peek coll))
(defn pop [coll] (cl/pop coll))
(defn last-key [coll] (cl/last-key coll))
(defn last-entry [coll] (cl/last-entry coll))

;; numbers
(defn rem [a b] (nu/rem a b))
(defn bit-not [x] (nu/bit-not x))
(defn even? [x] (nu/even? x))
(defn odd? [x] (nu/odd? x))
(defn nan? [x] (nu/nan? x))
(defn zero? [x] (nu/zero? x))
(defn pos? [x] (nu/pos? x))
(defn neg? [x] (nu/neg? x))
(defn promoting-inc [x] (nu/promoting-inc x))
(defn ratio? [x] (nu/ratio? x))

;; the hash boundary
(defn hash-key [x] (h/hash-key x))

;; the fold
(defn reduce [f init coll] (rd/reduce f init coll))
(defn reduced [x] (rd/reduced x))
(defn reduced? [x] (rd/reduced? x))

;; printing, names and stringification
; Both spellings live here, like everything else: the kebab name is what
; beam-lisp source writes, the snake name is what the compiler's literal
; lowers, the `core` link table and `lib/**/*.ex` write. Writing only the
; snake one is a real defect and it was MINE — `rt/name-of` raised
; "undefined var" from BL while the contract's `name_of` worked.
; `str` is exported at ZERO arity because in the Elixir runtime it is a VALUE:
; the `core` link table maps the name to `str/0`, and the call site's argument
; count is what selects the variadic clause inside `multi_fn`. `to-str/1` is not
; here — RT keeps it private, and the contract does not name it.
(defn print-str [x] (pr/print-str x))
(defn print-readably [x] (pr/print-readably x))
(defn println
  ([] (pr/println))
  ([x] (pr/println x)))
(defn println-multi [x rest] (pr/println-multi x rest))
(defn name-of [x] (pr/name-of x))
(defn namespace-of [x] (pr/namespace-of x))
(defn keyword-of [ns name] (pr/keyword-of ns name))
(defn gensym
  ([] (pr/gensym))
  ([prefix] (pr/gensym prefix)))
(defn str [] (pr/str-0))

; `drop-clj` is the Clojure-ordered `(drop n coll)`, which is the order the
; `core` link table binds the name `drop` to; the compiler lowers `:drop`
; directly. Both spellings name the same walk here, and the oracle checks it.
;; the reader's two registries
; A reader macro is keyed by a single dispatch CHARACTER and stores the NAME;
; a data reader is keyed by a TAG NAME and stores the WHOLE symbol. The
; asymmetry is RT's and is the kind of thing a reader of either function has to
; be told, so it is stated here rather than discovered.
(defn read-data [source] (rdr/read-data source))
(defn reader-macro [char] (rdr/reader-macro char))
(defn reader-macro! [char sym] (rdr/reader-macro! char sym))
(defn data-reader [tag] (rdr/data-reader tag))
(defn data-reader! [tag sym] (rdr/data-reader! tag sym))

(defn drop-clj [n coll] (s/k-drop n coll))

;; laziness
(defn map [f coll] (lz/map f coll))
(defn map-multi [f c1 rest] (lz/map-multi f c1 rest))
(defn filter [pred coll] (lz/filter pred coll))
(defn take-while [pred coll] (lz/take-while pred coll))
(defn drop-while [pred coll] (lz/drop-while pred coll))
(defn doall [coll] (lz/doall coll))
(defn dorun [coll] (lz/dorun coll))
(defn map-xform [f] (lz/map-xform f))
(defn filter-xform [pred] (lz/filter-xform pred))
(defn take-xform [n] (lz/take-xform n))
(defn iterate [f x] (lz/iterate f x))
(defn repeat
  ([x] (lz/repeat x))
  ([n x] (lz/repeat n x)))
(defn cycle [coll] (lz/cycle coll))
(defn range
  ([] (lz/range))
  ([end] (lz/range end))
  ([start end] (lz/range start end)))
(defn subseq [coll start stop] (lz/subseq coll start stop))
(defn rsubseq [coll start stop] (lz/rsubseq coll start stop))
(defn tree-seq [branch? children root] (lz/tree-seq branch? children root))


;; sorting and concatenation
; `sort` and `concat` are the two collection operations whose RESULT is a
; sequence the caller walks, so both live with the laziness group: `concat`
; yields lazily and `sort` returns a list.
(defn sort
  ([coll] (cl/sort coll))
  ([comp coll] (cl/sort comp coll)))
(defn concat [seqs] (lz/concat seqs))

;; sorted collections
(defn sorted-set [coll] (so/sorted-set coll))
(defn sorted-set-of [coll] (so/sorted-set-of coll))
(defn sorted-set? [x] (so/sorted-set? x))
(defn sorted-map [coll] (so/sorted-map coll))
(defn sorted-map-of [coll] (so/sorted-map-of coll))
(defn sorted-map? [x] (so/sorted-map? x))
(defn sorted-dissoc [m k] (so/sorted-dissoc m k))

;; ── the two spellings of one member ────────────────────────────────────────
; A member of a BL namespace is an Erlang atom spelled as it was written, so
; `(defn hash-key …)` exports `hash-key`. Nothing munges: `slash-target`
; (compiler.bl:442) passes the member text through literally whether it resolved
; the prefix to a namespace or to a host module. But the compiler's OWN literal
; lowers name the runtime with `_` (`:hash_key` at :592, `:invoke` at :199,
; `:nth` at :1012, `:drop` at :1036, `:splice` at :2406), every `lib/**/*.ex`
; caller does (`RT.invoke/2`, `RT.hash_key/1`, `RT.seed_core/0`), and the VALUES
; of the `core` link table do (`"print-str" => :print_str`).
;
; So after the cutover the module is named two ways by two conventions that both
; genuinely exist, and a name it does not export is a call site that breaks at
; RUNTIME, not at compile time — the link table is consulted on invocation. An
; alias costs one line and no runtime (it delegates straight to the owner, like
; the kebab line above it); a missing export costs a broken build.
;
; (The deeper fix is to munge at the boundary the way Clojure munges `-` to `_`
; for the JVM, so there is ONE spelling in source. That is a change to `Emit`
; with bootstrap-wide blast radius, and it does not belong inside a cutover that
; has to land green. Noted, not smuggled in.)

(defn apply_to [f args] (c/apply-to f args))
(defn apply_variadic [f n args] (c/apply-variadic f n args))
(defn assoc_variadic [m k v ks] (cl/assoc-variadic m k v ks))
(defn bit_not [x] (nu/bit-not x))
(defn call_shape_error [f arity] (c/call-shape-error f arity))
(defn drop_while [pred coll] (lz/drop-while pred coll))
(defn filter_xform [pred] (lz/filter-xform pred))
(defn hash_key [x] (h/hash-key x))
(defn last_entry [coll] (cl/last-entry coll))
(defn last_key [coll] (cl/last-key coll))
(defn list_star [x xs] (s/k-list-star x xs))
(defn map_xform [f] (lz/map-xform f))
(defn multi_fn
  ([clauses] (c/multi-fn clauses))
  ([clauses spec] (c/multi-fn clauses spec)))
(defn not_ [x] (c/not- x))
(defn promoting_inc [x] (nu/promoting-inc x))
(defn remote_fun [m f] (c/remote-fun m f))
(defn sorted_dissoc [m k] (so/sorted-dissoc m k))
(defn sorted_map [coll] (so/sorted-map coll))
(defn sorted_map? [x] (so/sorted-map? x))
(defn sorted_map_of [coll] (so/sorted-map-of coll))
(defn sorted_set [coll] (so/sorted-set coll))
(defn sorted_set? [x] (so/sorted-set? x))
(defn sorted_set_of [coll] (so/sorted-set-of coll))
(defn take_while [pred coll] (lz/take-while pred coll))
(defn take_xform [n] (lz/take-xform n))
(defn tree_seq [branch? children root] (lz/tree-seq branch? children root))
(defn map_multi [f c1 rest] (lz/map-multi f c1 rest))
(defn print_str [x] (pr/print-str x))
(defn print_readably [x] (pr/print-readably x))
(defn println_multi [x rest] (pr/println-multi x rest))
(defn name_of [x] (pr/name-of x))
(defn namespace_of [x] (pr/namespace-of x))
(defn keyword_of [ns name] (pr/keyword-of ns name))
(defn drop_clj [n coll] (s/k-drop n coll))
(defn list_star_0 [] nil)
(defn read_data [source] (rdr/read-data source))
(defn reader_macro [char] (rdr/reader-macro char))
(defn reader_macro! [char sym] (rdr/reader-macro! char sym))
(defn data_reader [tag] (rdr/data-reader tag))
(defn data_reader! [tag sym] (rdr/data-reader! tag sym))



;; ── `seed_core` — the `core` link table ────────────────────────────────────
;
; Every name the prelude, the interop layer and the `cpp/*` slices resolve,
; bound in the namespace they are called from. Two mechanisms, and they are not
; the same thing:
;
;   BEAM_LISP.ENV/INTERN    binds a var whose value is a CALLABLE. The call site
;     goes through `invoke`.
;   BEAM_LISP.ENV/PUT-LINK  binds a DIRECT call link: the compiler emits a
;     remote call and `invoke` is skipped.
;
; THE LINK ROWS ARE THE FLIP. A row whose module is the runtime names THIS
; namespace (`Elixir.BeamLisp.Ns.Rt`); a row whose module is a HOST module
; (`BeamLisp.Num`, `BeamLisp.Refs`, `:erlang`) is unchanged, because those
; modules are not going anywhere. Nothing else in this function moves at the
; cutover — which is why the cutover is a table edit and not a rewrite.
;
; TWO RULES THAT ARE NOT OBVIOUS, both learned from the module being replaced:
;
;   A MULTI-ARITY NAME IS INTERNED AS A VALUE, NOT ASSEMBLED FROM ARITIES. A
;   multi-arity `defn`'s var value is already a multi-fn, because the language's
;   own cross-namespace call path is `invoke` and `invoke` reads the clause out
;   of that value. So most names below are just the facade's own function,
;   looked up once.
;
;   A NAME LINKED AT ONE ARITY MUST NOT BE MULTI-ARITY. The link makes the other
;   arities UNREACHABLE — `invoke` is never consulted. RT records this rule at
;   `filter` and `take`, which is why neither appears in the fixed-arity link
;   table below even though both appear in the intern table above it.
;
; A dash is not an underscore. The link table names its targets with `_`
; (`:print_readably`, `:drop_clj`, `:sorted_map_of`) because that is how the
; module being replaced spells them. This module exports both, so the rows are
; correct either way — and the reason both exist is written up under "the two
; spellings of one member".

(def ^private RT-MOD :"Elixir.BeamLisp.Ns.Rt")
(def ^private NUM-MOD :"Elixir.BeamLisp.Num")

(defn- core-intern [name v] (BeamLisp.Env/intern "core" name v))
(defn- cpp-intern [name v] (BeamLisp.Env/intern "cpp" name v))
(defn- unwrap-fetched [v]
  (if (erlang/is_tuple v)
      (if (erlang/== (erlang/element 1 v) :ok) (erlang/element 2 v) v)
      v))

; `Env.fetch/2` answers `{:ok, value}`, so the value is one unwrap away. Reading
; the tuple AS the function was a real defect, and it presented as a COMPILER
; crash: a call site resolving `core/assoc` got a 2-tuple and died inside
; `invoke`, while compiling a file that had nothing to do with the runtime.
(defn- own [name] (unwrap-fetched (BeamLisp.Env/fetch "rt" name)))

(defn- core-link [name mod arities variadic]
  (BeamLisp.Env/put_link "core" name
    (erlang/list_to_tuple (list mod arities variadic))))

(defn- link1 [name mod fname] (core-link name mod {1 fname} nil))

; A variadic spec is a 2-TUPLE `{arity, handler}`, not a list: the handler takes
; the fixed leading args and then ONE rest list, so its own arity is (fixed+1).
(defn- variadic [n f] (erlang/list_to_tuple (list n f)))

; `(< 1 2 3)` is a chain: 1 < 2 AND 2 < 3. Bounded by arity, never by a value.
(defn- chain-of [op]
  (multi-fn {} (list 1 (fn [x rest]
    (erlang/apply :lists :all
      (list (fn [pair] (op (nth pair 0) (nth pair 1)))
            (erlang/apply :lists :zip (list (cons x rest) rest))))))))

; Every arity folds through `BeamLisp.Num`, the tower's seam: int/float take
; the BIF on its first clause, a decimal operand promotes.
(defn- fold-add [args] (erlang/apply :lists :foldl (list (fn [a b] (BeamLisp.Num/add a b)) 0 args)))
(defn- fold-mul [args] (erlang/apply :lists :foldl (list (fn [a b] (BeamLisp.Num/mul a b)) 1 args)))

(def ^private CORE-OWN
  "core names whose value is the facade's OWN function, in the contract's
   spelling. Single-arity only: see CORE-ARITIES for the rest."
  (list "first" "rest" "seq" "next" "count" "empty?" "cons" "identical?"
        "find" "contains?" "print-str" "iterate" "cycle" "take-while"
        "drop-while" "doall" "dorun" "even?" "odd?" "zero?" "pos?" "neg?"
        "rem" "transientable?" "fn?" "seq?" "boolean" "keyword?" "symbol?"
        "string?" "number?" "int?" "map?" "struct?" "associative?"
        "vector?" "list?" "coll?" "ident?" "sequential?" "set" "set?"
        "disj" "sorted?" "sorted-map?" "sorted-set?" "sorted-map-of"
        "sorted-set-of" "last-key" "last-entry" "sorted-dissoc" "subseq"
        "rsubseq" "tree-seq" "compare" "drop"))

; A NAME THAT DISPATCHES ON ARITY IS INTERNED AS A MULTI-FN BUILT FROM
; EXPLICIT CLAUSES — the facade's single-arity defn is not that value, and
; `invoke` reads the clause out of the tag tuple. `assoc` is the sharp case:
; its variadic form lives under a DIFFERENT name in the facade, so looking the
; name up gives a 3-arity function and a 5-argument call site dies with
; `BadArityError` from inside the compiler, compiling an unrelated file.
(def ^private CORE-ARITIES
  (list
    (list "get" {2 (fn [m k] (get m k)) 3 (fn [m k d] (get m k d))} nil)
    (list "nth" {2 (fn [x i] (nth x i)) 3 (fn [x i d] (nth x i d))} nil)
    (list "conj" {1 (fn [c] (conj c)) 2 (fn [c x] (conj c x))} nil)
    (list "sort" {1 (fn [c] (sort c)) 2 (fn [c o] (sort c o))} nil)
    (list "filter" {1 (fn [p] (filter p)) 2 (fn [p c] (filter p c))} nil)
    (list "take" {1 (fn [n] (take n)) 2 (fn [n c] (take n c))} nil)
    (list "range" {0 (fn [] (range)) 1 (fn [e] (range e))
                    2 (fn [s e] (range s e))} nil)
    (list "repeat" {1 (fn [x] (repeat x)) 2 (fn [n x] (repeat n x))} nil)
    (list "gensym" {0 (fn [] (gensym)) 1 (fn [p] (gensym p))} nil)
    (list "assoc" {3 (fn [m k v] (assoc m k v))}
                  (variadic 3 (fn [m k v rest] (assoc-variadic m k v rest))))))

(defn- seed-core-arities []
  (erlang/apply :lists :foreach
    (list (fn [row] (core-intern (nth row 0) (multi-fn (nth row 1) (nth row 2))))
          CORE-ARITIES)))

(defn- seed-core-own []
  (erlang/apply :lists :foreach
    (list (fn [n] (core-intern n (own n))) CORE-OWN)))

; The names whose `core` spelling is not the facade's own spelling, and the
; arithmetic and chain prims, which are not names in this namespace at all.
(defn- seed-core-special []
  (core-intern "+" (multi-fn {} (list 0 fold-add)))
  (core-intern "*" (multi-fn {} (list 0 fold-mul)))
  (core-intern "-" (multi-fn {} (list 1 (fn [x rest]
    (if (erlang/== rest ())
        (BeamLisp.Num/neg x)
        (erlang/apply :lists :foldl
          (list (fn [e acc] (BeamLisp.Num/sub acc e)) x rest)))))))
  (core-intern "/" (multi-fn {} (list 1 (fn [x rest]
    (if (erlang/== rest ())
        (BeamLisp.Num/div 1 x)
        (erlang/apply :lists :foldl
          (list (fn [e acc] (BeamLisp.Num/div acc e)) x rest)))))))
  (core-intern "<" (chain-of (fn [a b] (BeamLisp.Num/lt a b))))
  (core-intern ">" (chain-of (fn [a b] (BeamLisp.Num/gt a b))))
  (core-intern "<=" (chain-of (fn [a b] (BeamLisp.Num/le a b))))
  (core-intern ">=" (chain-of (fn [a b] (BeamLisp.Num/ge a b))))
  (core-intern "==" (chain-of (fn [a b] (BeamLisp.Num/num_eq a b))))
  (core-intern "=" (chain-of eqv))
  (core-intern "not" (fn [x] (not- x)))
  (core-intern "float?" (fn [x] (k/float? x)))
  ; `str` is a VALUE in the module being replaced: the call site's argument
  ; count selects the variadic clause INSIDE the multi-fn. So the fn is called.
  (core-intern "str" (str))
  (core-intern "pr-str" (fn [x] (print-readably x)))
  (core-intern "apply" (multi-fn {2 (fn [f args] (apply-to f args))}
                                (variadic 2 (fn [a b rest] (apply-variadic a b rest)))))
  (core-intern "list*" (multi-fn {0 (fn [] (list-star-0))}
                                 (variadic 1 list-star)))
  (core-intern "map" (multi-fn {1 (fn [f] (map-xform f)) 2 (fn [f coll] (map f coll))}
                                (variadic 2 (fn [f c1 rest] (map-multi f c1 rest)))))
  (core-intern "println" (multi-fn {0 (fn [] (println)) 1 (fn [x] (println x))}
                                   (variadic 1 (fn [x rest] (println-multi x rest)))))
  (core-intern "concat" (multi-fn {} (variadic 0 (fn [seqs] (concat seqs))))))

; Reference types: atoms, futures, promises. All plain host fns, so the link
; rows below turn call sites into direct remote calls.
(defn- seed-core-refs []
  (core-intern "atom" (fn [x] (BeamLisp.Refs/atom x)))
  (core-intern "deref" (multi-fn {1 (fn [x] (BeamLisp.Refs/deref x))
                                 3 (fn [r k d] (BeamLisp.Refs/deref r k d))}))
  (core-intern "swap!" (multi-fn {2 (fn [r f] (BeamLisp.Refs/swap! r f))}
                                 (variadic 2 (fn [r f rest] (BeamLisp.Refs/swap! r f rest)))))
  (core-intern "reset!" (fn [r v] (BeamLisp.Refs/reset! r v)))
  (core-intern "compare-and-set!" (fn [r o n] (BeamLisp.Refs/compare_and_set! r o n)))
  (core-intern "add-watch" (fn [r k f] (BeamLisp.Refs/add_watch! r k f)))
  (core-intern "remove-watch" (fn [r k] (BeamLisp.Refs/remove_watch! r k)))
  (core-intern "promise" (fn [] (BeamLisp.Refs/promise)))
  (core-intern "deliver" (fn [p v] (BeamLisp.Refs/deliver p v)))
  (core-intern "force" (fn [x] (BeamLisp.Deferred/force x)))
  (core-intern "realized?" (fn [x] (BeamLisp.Deferred/realized? x)))
  (core-intern "delay?" (fn [x] (BeamLisp.Deferred/delay? x)))
  (core-intern "derived?" (fn [x] (BeamLisp.Reactive/derived? x)))
  (core-intern "future?" (fn [x] (BeamLisp.Refs/future? x)))
  (core-intern "future-cancel" (fn [x] (BeamLisp.Refs/future_cancel x)))
  (core-intern "volatile!" (fn [x] (BeamLisp.Refs/volatile x)))
  (core-intern "vreset!" (fn [v x] (BeamLisp.Refs/vreset! v x)))
  (core-intern "vswap!" (multi-fn {2 (fn [v f] (BeamLisp.Refs/vswap! v f))}
                                  (variadic 2 (fn [v f rest] (BeamLisp.Refs/vswap! v f rest)))))
  (core-intern "volatile?" (fn [x] (BeamLisp.Refs/volatile? x))))

; Transients: mutable-until-persisted views of vectors and maps.
(defn- seed-core-transients []
  (core-intern "transient" (fn [x] (BeamLisp.Transient/transient x)))
  (core-intern "persistent!" (fn [x] (BeamLisp.Transient/persistent! x)))
  (core-intern "conj!" (multi-fn {1 (fn [t] (BeamLisp.Transient/conj! t))
                                  2 (fn [t x] (BeamLisp.Transient/conj! t x))}))
  (core-intern "assoc!" (fn [t k v] (BeamLisp.Transient/assoc! t k v)))
  (core-intern "dissoc!" (fn [t k] (BeamLisp.Transient/dissoc! t k)))
  (core-intern "hash-map" (multi-fn {0 (fn [] (BeamLisp.Transient/hash_map_empty))}
                                    (variadic 2 (fn [k v rest] (BeamLisp.Transient/hash_map k v rest))))))

; The BEAM-native band: supervision trees, `:dbg` as data, and the generic
; process verbs (`gen_server:call` works on any gen_server, so beam-lisp claims
; the bare names at top level).
(defn- seed-core-otp []
  (core-intern "supervise" (multi-fn {2 (fn [a b] (BeamLisp.Supervisor/supervise a b))
                                      3 (fn [a b c] (BeamLisp.Supervisor/supervise a b c))}))
  (core-intern "worker" (multi-fn {2 (fn [a b] (BeamLisp.Supervisor/worker a b))
                                   3 (fn [a b c] (BeamLisp.Supervisor/worker a b c))}))
  (core-intern "trace" (multi-fn {2 (fn [a b] (BeamLisp.Trace/trace_2 a b))
                                   3 (fn [a b c] (BeamLisp.Trace/trace_3 a b c))}))
  (core-intern "untrace" (fn [x] (BeamLisp.Trace/untrace_1 x)))
  (core-intern "start" (multi-fn {1 (fn [a] (BeamLisp.Server/start a))
                                   2 (fn [a b] (BeamLisp.Server/start a b))
                                   3 (fn [a b c] (BeamLisp.Server/start a b c))}))
  (core-intern "start-link" (multi-fn {1 (fn [a] (BeamLisp.Server/start_link a))
                                        2 (fn [a b] (BeamLisp.Server/start_link a b))
                                        3 (fn [a b c] (BeamLisp.Server/start_link a b c))}))
  (core-intern "call" (multi-fn {2 (fn [a b] (BeamLisp.Server/call a b))
                                  3 (fn [a b c] (BeamLisp.Server/call a b c))}))
  (core-intern "cast" (fn [p m] (BeamLisp.Server/cast p m)))
  (core-intern "stop" (multi-fn {1 (fn [a] (BeamLisp.Server/stop a))
                                  2 (fn [a b] (BeamLisp.Server/stop a b))}))
  (core-intern "monitor" (fn [p] (erlang/monitor :process p)))
  (core-intern "link" (fn [p] (erlang/link p)))
  (core-intern "kill" (fn [p] (erlang/exit p :kill))))

; `cpp/*` interop: jank calls its C++ primitives under the `cpp` namespace, so
; beam-lisp maps that qualified name onto a BEAM function with the same
; semantics and upstream core.jank slices load unchanged.
(defn- seed-core-cpp []
  (cpp-intern "jank.runtime.name" (fn [x] (name-of x)))
  (cpp-intern "jank.runtime.namespace_" (fn [x] (namespace-of x)))
  (cpp-intern "jank.runtime.keyword" (fn [ns name] (keyword-of ns name)))
  (cpp-intern "jank.runtime.reduce" (fn [f init coll] (reduce f init coll)))
  (cpp-intern "jank.runtime.reduced" (fn [x] (reduced x)))
  (cpp-intern "jank.runtime.is_reduced" (fn [x] (reduced? x)))
  (cpp-intern "jank.runtime.peek" (fn [c] (peek c)))
  (cpp-intern "jank.runtime.pop" (fn [c] (pop c)))
  (cpp-intern "jank.runtime.promoting_inc" (fn [x] (promoting-inc x)))
  (cpp-intern "jank.runtime.is_integer" (fn [x] (int? x)))
  (cpp-intern "jank.runtime.is_ratio" (fn [x] (ratio? x)))
  (cpp-intern "jank.runtime.is_big_decimal" (fn [x] (decimal? x)))
  (cpp-intern "jank.runtime.is_sorted" (fn [x] (sorted? x)))
  (cpp-intern "jank.runtime.is_nan" (fn [x] (nan? x)))
  (cpp-intern "jank.runtime.is_list" (fn [x] (list? x)))
  (cpp-intern "jank.runtime.volatile_" (fn [x] (BeamLisp.Refs/volatile x)))
  (cpp-intern "jank.runtime.vreset" (fn [v x] (BeamLisp.Refs/vreset! v x)))
  (cpp-intern "jank.runtime.vswap" (multi-fn {2 (fn [v f] (BeamLisp.Refs/vswap! v f))}
                                             (variadic 2 (fn [v f rest] (BeamLisp.Refs/vswap! v f rest)))))
  (cpp-intern "jank.runtime.is_volatile" (fn [x] (BeamLisp.Refs/volatile? x)))
  ; bit-not's inline expands to a call to this; the reader gate was clear and
  ; only the table row was missing.
  (cpp-intern "jank.runtime.bit_not" (fn [x] (bit-not x))))

(defn- seed-links []
  (erlang/apply :lists :foreach
    (list (fn [pair]
            (core-link (nth pair 0) NUM-MOD {2 (nth pair 1)} nil))
          (list (list "+" :add) (list "-" :sub) (list "*" :mul) (list "/" :div)
                (list "<" :lt) (list ">" :gt) (list "<=" :le) (list ">=" :ge)
                (list "==" :num_eq))))
  (link1 "rem" :erlang :rem)
  ; Unary `-` negates through the tower (the only unary that does work);
  ; `(+ x)` and `(= x)` stay on invoke.
  (core-link "-" NUM-MOD {1 :neg 2 :sub} nil)
  ; `=` links to lazy-aware equality, which realizes lazy operands, so
  ; comparing a lazy seq stays Clojure-shaped.
  (core-link "=" RT-MOD {2 :eqv} nil)

  ; Fixed-arity links. `filter` and `take` are DELIBERATELY ABSENT: both grew a
  ; 1-arity transducer form, and a link names one fixed arity — it would make
  ; the other unreachable, because a link means `invoke` is never consulted.
  (erlang/apply :lists :foreach
    (list (fn [pair] (link1 (nth pair 0) RT-MOD (nth pair 1)))
          (list (list "first" :first) (list "rest" :rest) (list "seq" :seq)
                (list "next" :next) (list "count" :count) (list "empty?" :empty?)
                (list "cons" :cons) (list "identical?" :identical?)
                (list "pr-str" :print_readably) (list "print-str" :print_str)
                (list "reader-macro!" :reader_macro!)
                (list "data-reader!" :data_reader!) (list "read-data" :read_data)
                (list "take-while" :take_while) (list "drop-while" :drop_while)
                (list "iterate" :iterate) (list "cycle" :cycle)
                (list "doall" :doall) (list "dorun" :dorun)
                (list "even?" :even?) (list "odd?" :odd?) (list "zero?" :zero?)
                (list "pos?" :pos?) (list "neg?" :neg?) (list "float?" :float?)
                (list "transientable?" :transientable?) (list "fn?" :fn?)
                (list "seq?" :seq?) (list "boolean" :boolean) (list "find" :find)
                (list "contains?" :contains?) (list "keyword?" :keyword?)
                (list "symbol?" :symbol?) (list "string?" :string?)
                (list "number?" :number?) (list "int?" :int?)
                (list "map?" :map?) (list "struct?" :struct?)
                (list "associative?" :associative?) (list "vector?" :vector?)
                (list "list?" :list?) (list "coll?" :coll?)
                (list "ident?" :ident?) (list "set" :set) (list "set?" :set?)
                (list "disj" :disj) (list "sorted?" :sorted?)
                (list "sequential?" :sequential?) (list "compare" :compare)
                (list "gensym" :gensym) (list "drop" :drop_clj)
                (list "subseq" :subseq) (list "rsubseq" :rsubseq)
                (list "last-key" :last_key) (list "last-entry" :last_entry)
                (list "sorted-map-of" :sorted_map_of)
                (list "sorted-set-of" :sorted_set_of)
                (list "sorted-map?" :sorted_map?) (list "sorted-set?" :sorted_set?)
                (list "sorted-dissoc" :sorted_dissoc)
                (list "tree-seq" :tree_seq)))))

  ; `sort` is multi-arity AND both arities link: the arity splits the call.
  (core-link "sort" RT-MOD {1 :sort 2 :sort} nil)
  ; `gensym` and `get` link both arities for the same reason.
  (core-link "gensym" RT-MOD {0 :gensym 1 :gensym} nil)
  (core-link "get" RT-MOD {2 :get 3 :get} nil)
  (core-link "nth" RT-MOD {2 :nth 3 :nth} nil)
  ; `conj` links its completion arity (1) beside the value arity (2).
  (core-link "conj" RT-MOD {1 :conj 2 :conj} nil)
  (core-link "take" RT-MOD {1 :take_xform 2 :take} nil)
  (core-link "range" RT-MOD {0 :range 1 :range 2 :range} nil)
  (core-link "repeat" RT-MOD {1 :repeat 2 :repeat} nil)
  ; `assoc`, `map`, `apply` and `list*` gain a VARIADIC handler: fixed leading
  ; args, then one rest list. The handler's arity is (fixed + 1).
  (core-link "assoc" RT-MOD {3 :assoc} (list 3 :assoc_variadic))
  (core-link "map" RT-MOD {2 :map} (list 2 :map_multi))
  (core-link "apply" RT-MOD {2 :apply_to} (list 2 :apply_variadic))
  (core-link "list*" RT-MOD {0 :list_star_0} (list 1 :list_star))
  ; `println` links its 0/1 arities and its variadic multi form.
  (core-link "println" RT-MOD {0 :println 1 :println} (list 1 :println_multi))

  ; Reference types link to direct calls too.
  (erlang/apply :lists :foreach
    (list (fn [row] (core-link (nth row 0) (nth row 1) (nth row 2) (nth row 3)))
          (list
            (list "atom" "Elixir.BeamLisp.Refs" {1 :atom} nil)
            (list "deref" "Elixir.BeamLisp.Refs" {1 :deref 3 :deref} nil)
            (list "swap!" "Elixir.BeamLisp.Refs" {2 :swap!} (list 2 :swap!))
            (list "reset!" "Elixir.BeamLisp.Refs" {2 :reset!} nil)
            (list "compare-and-set!" "Elixir.BeamLisp.Refs" {3 :compare_and_set!} nil)
            (list "add-watch" "Elixir.BeamLisp.Refs" {3 :add_watch!} nil)
            (list "remove-watch" "Elixir.BeamLisp.Refs" {2 :remove_watch!} nil)
            (list "promise" "Elixir.BeamLisp.Refs" {0 :promise} nil)
            (list "deliver" "Elixir.BeamLisp.Refs" {2 :deliver} nil)
            (list "force" "Elixir.BeamLisp.Deferred" {1 :force} nil)
            (list "realized?" "Elixir.BeamLisp.Deferred" {1 :realized?} nil)
            (list "delay?" "Elixir.BeamLisp.Deferred" {1 :delay?} nil)
            (list "derived?" "Elixir.BeamLisp.Reactive" {1 :derived?} nil)
            (list "future?" "Elixir.BeamLisp.Refs" {1 :future?} nil)
            (list "future-cancel" "Elixir.BeamLisp.Refs" {1 :future_cancel} nil)
            (list "transient" "Elixir.BeamLisp.Transient" {1 :transient} nil)
            (list "persistent!" "Elixir.BeamLisp.Transient" {1 :persistent!} nil)
            (list "conj!" "Elixir.BeamLisp.Transient" {1 :conj! 2 :conj!} nil)
            (list "assoc!" "Elixir.BeamLisp.Transient" {3 :assoc!} nil)
            (list "dissoc!" "Elixir.BeamLisp.Transient" {2 :dissoc!} nil)
            (list "hash-map" "Elixir.BeamLisp.Transient" {0 :hash_map_empty} (list 2 :hash_map)))))

(defn seed-core []
  (seed-core-own)
  (seed-core-arities)
  (seed-core-special)
  (seed-core-refs)
  (seed-core-transients)
  (seed-core-otp)
  (seed-core-cpp)
  (seed-links)
  ; (seed-core-hash-keys) — see the note above `hash-key`'s literal lower.
  :ok)



;; ── the contract's spelling ───────────────────────────────────────────────
; The runtime contract, and `lib/beam_lisp.ex`, name this `seed_core`, with the
; underscore. A member of a beam-lisp namespace is an Erlang atom spelled AS
; WRITTEN, so `seed-core` and `seed_core` are two distinct exports; the facade
; serves both, exactly as it does for the other underscore-spelled names.
(defn seed_core [] (seed-core))

