; rt/scaling.bl — the census' third question, and the only one that cannot lie:
; what does the cost actually DO when the data grows?
;
; census.bl reads the IR for variable resolutions, cost.bl computes work classes
; over the call graph, and BOTH are models. This measures: the same operation at
; n and at 4n, on the same run, and the ratio between them. Four times the data
; costs four times the time when the operation is linear, one time when it is
; constant, and sixteen when something quadratic is hiding.
;
; The ratio is the whole output. No logarithms are taken and no model is fitted
; — a ratio of 4 IS linear, and printing the number is more honest than printing
; an exponent derived from it.
;
; WHY IT MATTERS HERE: the runtime is the floor under every bl program. An
; operation that is accidentally quadratic does not cost twice as much on twice
; the data — it costs four times, and the programs that notice are exactly the
; ones big enough to care. The static passes can miss a shape; this cannot miss
; a cost.

(ns rt.scaling
  (:require [rt.seq :as s]
            [rt.eq :as e]
            [rt.key :as k]
            [rt.reduce :as r]
            [rt.number :as n]))

(defn- now [] (erlang/monotonic_time :nanosecond))

(defn- consume [x] (cond (erlang/== x nil) 0 (erlang/== x true) 1 (erlang/== x false) 2 :else 3))

(defn- hammer [f n]
  (loop [i 0 acc 0]
    (cond
      (erlang/>= i n) acc
      :else (recur (erlang/+ i 1) (erlang/+ acc (consume (f)))))))

(defn- best-of [rounds f n]
  (loop [r rounds best nil]
    (cond
      (erlang/== r 0) best
      :else (let [t0 (now)
                  _ (hammer f n)
                  d (erlang/- (now) t0)]
              (recur (erlang/- r 1)
                     (if (or (erlang/== best nil) (erlang/< d best)) d best))))))

(def reps 50)

(defn- per-call [op coll] (erlang/div (best-of 3 (fn [] (op coll)) reps) reps))

(defn- minv [a b] (cond (erlang/== a nil) b (erlang/< b a) b :else a))

(defn- sample3
  "Three sizes, sampled ALTERNATELY, each keeping its own best.

   Interleaving is not politeness: the host drifts 1.6-5x within a run, and
   measuring the sizes in sequence charges that drift to whichever size ran
   during it. That is how a linear `to-list` reported 11x growth. Drift lands on
   all three arms here, so the RATIOS survive it."
  [op c1 c2 c3 rounds]
  (loop [i 0 b1 nil b2 nil b3 nil]
    (cond
      (erlang/== i rounds) (list b1 b2 b3)
      :else (recur (erlang/+ i 1)
                   (minv b1 (per-call op c1))
                   (minv b2 (per-call op c2))
                   (minv b3 (per-call op c3))))))

(defn- ratio [a b] (cond (erlang/== b 0) 0 :else (erlang// a b)))

(defn- verdict
  "Two ratios, each over 4x the data: 4 is linear, 1 is constant, 16 is
   quadratic. ONE ratio cannot tell n.log n from n^2 — map building sits around
   5-7 for both reasons — so the instrument refuses to judge on one."
  [r1 r2]
  (cond
    (and (erlang/> r1 10) (erlang/> r2 10)) "\t  QUADRATIC-SHAPED"
    (and (erlang/< r1 2) (erlang/< r2 2)) "\t  constant"
    (and (erlang/< r1 7) (erlang/< r2 7)) "\t  linear"
    :else "\t  CHECK (allocation? log factor?)"))

(defn- probe [label build op]
  (let [c1 (build 200)
        c2 (build 800)
        c3 (build 3200)
        [t1 t2 t3] (sample3 op c1 c2 c3 2)
        r1 (ratio t2 t1)
        r2 (ratio t3 t2)]
    (println (str "  " label
                  "\t 200:" t1 " 800:" t2 " 3200:" t3 " ns"
                  "\t x4:" r1 "x"
                  "\t x4 again:" r2 "x"
                  (verdict r1 r2)))))

(defn- vec-of [n] (into [] (range n)))

(defn- walk
  "Walk a sequence to its end through first/next — the shape every traversal in
   the runtime is built from."
  [xs]
  (loop [x xs acc 0]
    (cond
      (erlang/== (s/k-next x) nil) acc
      :else (recur (s/k-next x) (erlang/+ acc 1)))))

(defn run []
  (println "  ── harness floor")
  (probe "(identity call)" vec-of (fn [c] c))

  (println "  ── constant-in-n questions")
  (probe "count vector" vec-of (fn [c] (s/k-count c)))
  (probe "count list" (fn [n] (s/k-to-list (vec-of n))) (fn [c] (s/k-count c)))
  (probe "empty? vector" vec-of (fn [c] (s/k-empty? c)))
  (probe "first vector" vec-of (fn [c] (s/k-first c)))

  (println "  ── walk the whole thing")
  (probe "nth at n/2 (vector)" vec-of (fn [c] (s/k-nth c (erlang/div (s/k-count c) 2))))
  (probe "to-list (vector)" vec-of (fn [c] (s/k-to-list c)))
  (probe "seq walk (vector)" vec-of (fn [c] (walk (s/k-seq c))))
  (probe "seq walk (list)" (fn [n] (s/k-to-list (vec-of n))) (fn [c] (walk (s/k-seq c))))
  (probe "take n/2 (vector)" vec-of (fn [c] (s/k-take c (erlang/div (s/k-count c) 2))))
  (probe "drop n/2 (vector)" vec-of (fn [c] (s/k-drop c (erlang/div (s/k-count c) 2))))
  (probe "reduce + (vector)" vec-of (fn [c] (r/k-reduce (fn [a b] (erlang/+ a b)) 0 c)))
  (probe "semantic-hash (vector)" vec-of (fn [c] (k/semantic-hash c)))

  (println "  ── equality")
  (probe "eqv two equal vectors" vec-of (fn [c] (e/k-eqv c c)))
  (probe "compare two equal vectors" vec-of (fn [c] (e/k-compare c c)))

  (println "  ── accumulators: the shapes bl programs are built from")
  ;; These are the loops that appear in REAL code, where the collection is built
  ;; one element at a time. If conj copies, or into re-walks, the idiomatic
  ;; program is quadratic and no single operation looks guilty.
  (probe "build vector by conj" (fn [n] n)
         (fn [n] (loop [i 0 v []] (cond (erlang/== i n) (s/k-count v)
                                        :else (recur (erlang/+ i 1) (conj v i))))))
  (probe "build list by cons" (fn [n] n)
         (fn [n] (loop [i 0 ys ()] (cond (erlang/== i n) (s/k-count ys)
                                         :else (recur (erlang/+ i 1) (s/k-cons i ys))))))
  (probe "build map by assoc" (fn [n] n)
         (fn [n] (loop [i 0 m {}] (cond (erlang/== i n) (s/k-count m)
                                        :else (recur (erlang/+ i 1) (assoc m i i))))))
  (probe "build vector by into" (fn [n] n)
         (fn [n] (s/k-count (into [] (range n)))))
  (probe "concat two halves" (fn [n] n)
         (fn [n] (s/k-count (concat (into [] (range (erlang/div n 2)))
                                    (into [] (range (erlang/div n 2)))))))
  (println "done"))

(run)
