; probe-coll.bl — test coll functions against the runtime.

(ns rt.probe-coll
  (:require [rt.coll :as c]))

;; ── simple comparison ──────────────────────────────────────────────────────

(defn- same? [bl-result rt-result]
  (erlang/== bl-result rt-result))

(defn- eqv? [bl-result rt-result]
  (BeamLisp.RT/eqv bl-result rt-result))

(defn- run-test [name f v args check-fn]
  (try
    (let [bl-result (erlang/apply f (raw/cons v args))
          rt-fn (erlang/apply BeamLisp.RT (raw/cons (erlang/binary_to_atom (erlang/atom_to_binary name :utf8) :utf8) ()))
          rt-result (erlang/apply rt-fn (raw/cons v args))]
      (cond
        (check-fn bl-result rt-result) :agree
        :else {:fail name :on v :args args :bl bl-result :rt rt-result}))
    (catch e {:error name :on v :exception e})))

;; ── test cases ─────────────────────────────────────────────────────────────

(defn run-get []
  (let [test-cases [
        [[1 2 3] 0]
        [[1 2 3] 99]
        [{:a 1} :a]
        [{:a 1} :b]
        ]
        results (map (fn [[coll k]]
                       (try
                         (let [bl-result (c/get coll k)
                               rt-result (BeamLisp.RT/get coll k)]
                           (cond
                             (erlang/== bl-result rt-result) :agree
                             :else {:fail :get :coll coll :key k :bl bl-result :rt rt-result}))
                         (catch e {:error :get :coll coll :exception e})))
                    test-cases)
        fails (filter (fn [r] (map? r)) results)]
    (println (str "get: " (erlang/- (count test-cases) (count fails)) " agree, " (count fails) " fail"))
    (doseq [f fails]
      (println (str "  " f)))
    fails))

(defn run-conj []
  (let [test-cases [
        [() 1]
        [[1 2] 3]
        [#{} 1]
        [{:a 1} [:b 2]]
        ]
        fails (filter (fn [r] (map? r))
                (map (fn [[coll val]]
                       (try
                         (let [bl-result (c/conj coll val)
                               rt-result (BeamLisp.RT/conj coll val)]
                           (cond
                             (eqv? bl-result rt-result) :agree
                             :else {:fail :conj :coll coll :val val}))
                         (catch _e {:error :conj})))
                      test-cases))]
    (println (str "conj: " (erlang/- (count test-cases) (count fails)) " agree, " (count fails) " fail"))
    fails))

(defn run-contains? []
  (let [test-cases [
        [[1 2 3] 0]
        [[1 2 3] 10]
        [#{1 2 3} 1]
        [{:a 1} :a]
        [(sorted-set 1 2 3) 2]
        ]
        fails (filter (fn [r] (map? r))
                (map (fn [[coll k]]
                       (try
                         (let [bl-result (c/contains? coll k)
                               rt-result (BeamLisp.RT/contains? coll k)]
                           (cond
                             (erlang/== bl-result rt-result) :agree
                             :else {:fail :contains? :coll coll :key k}))
                         (catch _e {:error :contains?})))
                      test-cases))]
    (println (str "contains?: " (erlang/- (count test-cases) (count fails)) " agree, " (count fails) " fail"))
    fails))

(defn run-assoc []
  (let [test-cases [
        [[1 2 3] 0 99]
        [{:a 1} :b 2]
        [nil :x 10]
        ]
        fails (filter (fn [r] (map? r))
                (map (fn [[coll k v]]
                       (try
                         (let [bl-result (c/assoc coll k v)
                               rt-result (BeamLisp.RT/assoc coll k v)]
                           (cond
                             (eqv? bl-result rt-result) :agree
                             :else {:fail :assoc}))
                         (catch _e {:error :assoc})))
                      test-cases))]
    (println (str "assoc: " (erlang/- (count test-cases) (count fails)) " agree, " (count fails) " fail"))
    fails))

(defn run-find []
  (let [test-cases [
        [{:a 1 :b 2} :a]
        [{:a 1 :b 2} :x]
        [(sorted-map :a 1 :b 2) :a]
        ]
        fails (filter (fn [r] (map? r))
                (map (fn [[coll k]]
                       (try
                         (let [bl-result (c/find coll k)
                               rt-result (BeamLisp.RT/find coll k)]
                           (cond
                             (erlang/== bl-result rt-result) :agree
                             (and (erlang/== bl-result nil) (erlang/== rt-result nil)) :agree
                             (eqv? bl-result rt-result) :agree
                             :else {:fail :find}))
                         (catch _e {:error :find})))
                      test-cases))]
    (println (str "find: " (erlang/- (count test-cases) (count fails)) " agree, " (count fails) " fail"))
    fails))

(defn run-set []
  (let [test-cases [
        [#{1 2 3}]
        [(list 1 2 3)]
        ]
        results (map (fn [[coll]]
                       (try
                         (let [bl-result (c/set coll)
                               rt-result (BeamLisp.RT/set coll)]
                           (cond
                             (eqv? bl-result rt-result) :agree
                             :else {:fail :set :coll coll :bl bl-result :rt rt-result}))
                         (catch e {:error :set :coll coll :exception e})))
                      test-cases)
        fails (filter (fn [r] (map? r)) results)]
    (println (str "set: " (erlang/- (count test-cases) (count fails)) " agree, " (count fails) " fail"))
    (doseq [f fails]
      (println (str "  " f)))
    fails))

