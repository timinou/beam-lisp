        ]
        results (map (fn [[coll]]
                       (try
                         (let [bl-result (c/peek coll)
                               rt-result (BeamLisp.RT/peek coll)]
                           (cond
                             (erlang/== bl-result rt-result) :agree
                             :else {:fail :peek :coll coll :bl bl-result :rt rt-result}))
                         (catch e {:error :peek :coll coll :exception e})))
                      test-cases)
        fails (filter (fn [r] (map? r)) results)]
    (println (str "peek: " (erlang/- (count test-cases) (count fails)) " agree, " (count fails) " fail"))
    (doseq [f fails]
      (println (str "  " f)))
    fails))

(defn run-pop []
  (let [test-cases [
        [[1 2 3]]
        [(list 1 2 3)]
        ]
        results (map (fn [[coll]]
                       (try
                         (let [bl-result (c/pop coll)
                               rt-result (BeamLisp.RT/pop coll)]
                           (cond
                             (eqv? bl-result rt-result) :agree
                             :else {:fail :pop :coll coll :bl bl-result :rt rt-result}))
                         (catch e {:error :pop :coll coll :exception e})))
                      test-cases)
        fails (filter (fn [r] (map? r)) results)]
    (println (str "pop: " (erlang/- (count test-cases) (count fails)) " agree, " (count fails) " fail"))
    (doseq [f fails]
      (println (str "  " f)))
    fails))

(defn run-last-key []
  (let [test-cases [
        [(sorted-map :a 1 :b 2 :c 3)]
        [(sorted-set 1 2 3)]
        ]
        fails (filter (fn [r] (map? r))
                (map (fn [[coll]]
                       (try
                         (let [bl-result (c/last-key coll)
                               rt-result (BeamLisp.RT/last_key coll)]
                           (cond
                             (erlang/== bl-result rt-result) :agree
                             :else {:fail :last-key}))
                         (catch _e {:error :last-key})))
                      test-cases))]
    (println (str "last-key: " (erlang/- (count test-cases) (count fails)) " agree, " (count fails) " fail"))
    fails))

(defn run-last-entry []
  (let [test-cases [
        [(sorted-map :a 1 :b 2 :c 3)]
        ]
        fails (filter (fn [r] (map? r))
                (map (fn [[coll]]
                       (try
                         (let [bl-result (c/last-entry coll)
                               rt-result (BeamLisp.RT/last_entry coll)]
                           (cond
                             (erlang/== bl-result rt-result) :agree
                             (and (erlang/== bl-result nil) (erlang/== rt-result nil)) :agree
                             (eqv? bl-result rt-result) :agree
                             :else {:fail :last-entry}))
                         (catch _e {:error :last-entry})))
                      test-cases))]
    (println (str "last-entry: " (erlang/- (count test-cases) (count fails)) " agree, " (count fails) " fail"))
    fails))

(defn run-assoc-variadic []
  (let [test-cases [
        [{} :a 1 (list :b 2 :c 3)]
        [(sorted-map) :x 10 (list :y 20)]
        ]
        fails (filter (fn [r] (map? r))
                (map (fn [[coll k v rest]]
                       (try
                         (let [bl-result (c/assoc-variadic coll k v rest)
                               rt-result (BeamLisp.RT/assoc_variadic coll k v rest)]
                           (cond
                             (eqv? bl-result rt-result) :agree
                             :else {:fail :assoc-variadic}))
                         (catch _e {:error :assoc-variadic})))
                      test-cases))]
    (println (str "assoc-variadic: " (erlang/- (count test-cases) (count fails)) " agree, " (count fails) " fail"))
    fails))

(defn run-sort []
  (let [test-cases [
        [(list 3 1 2)]
        [[3 1 2]]
        ]
        results (map (fn [[coll]]
                       (try
                         (let [bl-result (c/sort coll)
                               rt-result (BeamLisp.RT/sort coll)]
                           (cond
                             (eqv? bl-result rt-result) :agree
                             :else {:fail :sort :coll coll :bl bl-result :rt rt-result}))
                         (catch e {:error :sort :coll coll :exception e})))
                      test-cases)
        fails (filter (fn [r] (map? r)) results)]
    (println (str "sort: " (erlang/- (count test-cases) (count fails)) " agree, " (count fails) " fail"))
    (doseq [f fails]
      (println (str "  " f)))
    fails))

(defn run []
  (let [results [
        (run-get)
        (run-conj)
        (run-contains?)
        (run-assoc)
        (run-find)
        (run-set)
        (run-disj)
        (run-peek)
        (run-pop)
        (run-last-key)
        (run-last-entry)
        (run-sort)
        (run-assoc-variadic)
        ]
        total-fails (reduce + 0 (map count results))]
    (cond
      (erlang/== 0 total-fails)
      (println "\nPASS rt.probe-coll")
      :else
      (println (str "\nFAIL rt.probe-coll — " total-fails " failures")))))

(run)
