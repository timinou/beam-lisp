  (let [test-cases [
        [#{1 2 3} 2]
        [(sorted-set 1 2 3) 2]
        ]
        fails (filter (fn [r] (map? r))
                (map (fn [[coll e]]
                       (try
                         (let [bl-result (c/disj coll e)
                               rt-result (BeamLisp.RT/disj coll e)]
                           (cond
                             (eqv? bl-result rt-result) :agree
                             :else {:fail :disj}))
                         (catch _e {:error :disj})))
                      test-cases))]
    (println (str "disj: " (erlang/- (count test-cases) (count fails)) " agree, " (count fails) " fail"))
    fails))

(defn run-peek []
  (let [test-cases [
        [[1 2 3]]
        [(list 1 2 3)]
