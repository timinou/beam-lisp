; probe-print.bl — test print functions against BeamLisp.RT
;
; Tests print-str, print-readably, str, println, println-multi, name-of,
; namespace-of, keyword-of, and gensym against the Elixir runtime.

(ns rt.probe-print
  (:require [rt.print :as p]))

(def test-vals
  "Comprehensive test corpus for print functions."
  (list
    ; nil and booleans
    nil true false
    ; numbers
    0 1 -1 42 2.5 -3.14 1M
    ; strings with escapes
    "" "plain" "quote\"here" "backslash\\here" "newline\nhere" "tab\there"
    ; atoms/keywords/symbols
    :simple :foo/bar :| :|| :|:
    'simple 'foo/bar '| '|| '|:
    ; empty collections
    () [] #{} {}
    ; small collections
    (list 1 2 3)
    [1 2 3]
    [1 [2 3]]
    #{1 2 3}
    {:a 1 :b 2}
    ; nested/complex
    {:list (list 1 2) :map {:k :v} :vec [1 2 3]}
    [^{:meta 1} 1 2 3]
    ))

(defn- test-print-str []
  "Test print-str non-readable mode."
  (let [results (map (fn [v]
                       (try
                         {:ok true
                          :bl (p/print-str v)
                          :rt (BeamLisp.RT/print_str v)}
                         (catch e {:ok false :error e})))
                     test-vals)
        agrees (filter (fn [r] (and (:ok r) (erlang/== (:bl r) (:rt r)))) results)
        fails (filter (fn [r] (and (:ok r) (not (erlang/== (:bl r) (:rt r))))) results)]
    {:test "print-str"
     :agree (count agrees)
     :fail (count fails)
     :failures fails}))

(defn- test-print-readably []
  "Test print-readably readable mode."
  (let [results (map (fn [v]
                       (try
                         {:ok true
                          :bl (p/print-readably v)
                          :rt (BeamLisp.RT/print_readably v)}
                         (catch e {:ok false :error e})))
                     test-vals)
        agrees (filter (fn [r] (and (:ok r) (erlang/== (:bl r) (:rt r)))) results)
        fails (filter (fn [r] (and (:ok r) (not (erlang/== (:bl r) (:rt r))))) results)]
    {:test "print-readably"
     :agree (count agrees)
     :fail (count fails)
     :failures fails}))

(defn- test-str []
  "Test str stringification."
  (let [test-cases (list
                     (list)
                     (list nil)
                     (list true)
                     (list "text")
                     (list 42)
                     (list 3.14)
                     (list 1M)
                     (list 'sym)
                     (list :kw)
                     (list "a" "b" "c")
                     (list 1 2 3)
                     (list :x :y :z)
                     (list [1 2])
                     (list {:a 1})
                     )
        results (map (fn [args]
                       (try
                         {:ok true
                          :bl (apply p/str args)
                          :rt (apply BeamLisp.RT/str args)}
                         (catch e {:ok false :error e})))
                     test-cases)
        agrees (filter (fn [r] (and (:ok r) (erlang/== (:bl r) (:rt r)))) results)
        fails (filter (fn [r] (and (:ok r) (not (erlang/== (:bl r) (:rt r))))) results)]
    {:test "str"
     :agree (count agrees)
     :fail (count fails)
     :failures fails}))

(defn- test-name-of []
  "Test name-of."
  (let [test-cases (list :simple :foo/bar 'simple 'foo/bar "text" "ns/name")
        results (map (fn [v]
                       (try
                         {:ok true
                          :bl (p/name-of v)
                          :rt (BeamLisp.RT/name_of v)}
                         (catch e {:ok false :error e})))
                     test-cases)
        agrees (filter (fn [r] (and (:ok r) (erlang/== (:bl r) (:rt r)))) results)
        fails (filter (fn [r] (and (:ok r) (not (erlang/== (:bl r) (:rt r))))) results)]
    {:test "name-of"
     :agree (count agrees)
     :fail (count fails)
     :failures fails}))

(defn- test-namespace-of []
  "Test namespace-of."
  (let [test-cases (list :simple :foo/bar 'simple 'foo/bar "text" "ns/name")
        results (map (fn [v]
                       (try
                         {:ok true
                          :bl (p/namespace-of v)
                          :rt (BeamLisp.RT/namespace_of v)}
                         (catch e {:ok false :error e})))
                     test-cases)
        agrees (filter (fn [r] (and (:ok r) (erlang/== (:bl r) (:rt r)))) results)
        fails (filter (fn [r] (and (:ok r) (not (erlang/== (:bl r) (:rt r))))) results)]
    {:test "namespace-of"
     :agree (count agrees)
     :fail (count fails)
     :failures fails}))

(defn- test-keyword-of []
  "Test keyword-of."
  (let [test-cases (list
                     (list nil "foo")
                     (list nil :foo)
                     (list "ns" "foo")
                     (list "ns" :foo)
                     (list nil "ns/foo")
                     (list "ns1" "ns2/foo")
                     )
        results (map (fn [[ns name]]
                       (try
                         {:ok true
                          :bl (p/keyword-of ns name)
                          :rt (BeamLisp.RT/keyword_of ns name)}
                         (catch e {:ok false :error e})))
                     test-cases)
        agrees (filter (fn [r] (and (:ok r) (erlang/== (:bl r) (:rt r)))) results)
        fails (filter (fn [r] (and (:ok r) (not (erlang/== (:bl r) (:rt r))))) results)]
    {:test "keyword-of"
     :agree (count agrees)
     :fail (count fails)
     :failures fails}))

(defn- test-gensym []
  "Test gensym generates valid shape."
  (try
    (let [sym0 (p/gensym)
          sym1 (p/gensym "PREFIX")
          rt0 (BeamLisp.RT/gensym)
          rt1 (BeamLisp.RT/gensym "PREFIX")
          bl-ok (and (erlang/== (erlang/element 1 sym0) :symbol)
                     (erlang/== (erlang/element 1 sym1) :symbol))
          rt-ok (and (erlang/== (erlang/element 1 rt0) :symbol)
                     (erlang/== (erlang/element 1 rt1) :symbol))]
      {:test "gensym"
       :agree (cond (and bl-ok rt-ok) 4 :else 0)
       :fail (cond (and bl-ok rt-ok) 0 :else 4)
       :failures (list)})
    (catch e {:test "gensym" :agree 0 :fail 4 :failures (list e)})))

(defn run []
  "Run all probes and report results."
  (let [results (list (test-print-str)
                      (test-print-readably)
                      (test-str)
                      (test-name-of)
                      (test-namespace-of)
                      (test-keyword-of)
                      (test-gensym))
        total-agree (reduce + 0 (map :agree results))
        total-fail (reduce + 0 (map :fail results))
        all-failures (mapcat :failures results)]
    
    ; Print summary
    (doseq [r results]
      (println (str (:test r) ": " (:agree r) " agree, " (:fail r) " fail")))
    
    (println "")
    (println (str "TOTAL: " total-agree " agree, " total-fail " fail"))
    
    ; Print failures if any
    (when (> total-fail 0)
      (println "")
      (doseq [f (filter identity all-failures)]
        (println (str "  FAIL: " (pr-str f)))))
    
    (println "")))

(run)
