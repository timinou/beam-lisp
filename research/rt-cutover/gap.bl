; rt/gap.bl — what the port still OWES, read from the two modules themselves.
;
; `surface.bl` prints the contract; this prints the DIFFERENCE between the
; contract and what the facade can serve. Both sides come from
; `module_info(:exports)`, so the answer is the compiler's, never a list a human
; keeps in step by hand.
;
; ── why there are two spellings, and why that is not a bug ─────────────────
;
; A member of a BL namespace is an Erlang atom spelled exactly as it was written,
; so `(defn hash-key …)` exports `hash-key`. Nothing munges: `slash-target`
; (compiler.bl:442) hands the member text through literally whether it resolves
; the prefix to a namespace or to a host module. Meanwhile the compiler's own
; literal lowers (`:hash_key` at :592, `:invoke` at :199, `:nth` at :1012), every
; `lib/**/*.ex` caller, and the VALUES of the `core` link table (`"print-str" =>
; :print_str`) all name the same member with `_`.
;
; So the facade has to serve both spellings, and this instrument has to tell a
; name that is merely spelled the other way from one that does not exist yet.
; That distinction is the whole point of the report: the first is an alias line,
; the second is a port.
;
; The `(:require [rt])` is load-bearing twice over: it forces the facade module
; to exist, and it fails loudly if any group the facade requires has stopped
; loading. A gap report that could not load the facade would report a full gap.

(ns rt.gap
  (:require [rt :as r]))

(defn- mod-atom [s] (erlang/binary_to_atom s :utf8))

(defn- exports [s]
  (->> (erlang/apply (mod-atom s) :module_info (list :exports))
       (filter (fn [p]
                 (let [n (erlang/element 1 p)]
                   (and (not (erlang/== n :module_info))
                        (not (erlang/== n :__info__))))))
       (map (fn [p] (str (erlang/element 1 p) "/" (erlang/element 2 p))))
       (sort)))

(defn- name-of [row] (first (split row "/")))
(defn- arity-of [row] (nth (split row "/") 1))

(defn- kebab [s] (join "-" (split s "_")))

; spelling-insensitive identity: `apply_to/2` and `apply-to/2` are one member
(defn- norm [row] (str (kebab (name-of row)) "/" (arity-of row)))

(defn- member? [x xs] (erlang/apply :lists :member (list x xs)))

(def runtime-files
  "Every file that will BE the runtime, once the facade's module name changes.

   They live under `research/` rather than `priv/std/` for a load-bearing
   reason, not a stylistic one: a namespace in a BUILT tier is compiled by
   `bl build`, and compiling `rt` needs `BeamLisp.Ns.Rt` — which is the very
   module `rt` defines. `BeamLisp.Set.member?`, which the host compiler calls
   on every node, hashes through the runtime, so the runtime can only ever
   arrive as a beam (the seed, or the AOT cache), never be built from source.
   Moving these files into a built tier therefore breaks the build outright.
   Read `PLAN-143` before moving them."
  (list "research/rt-cutover/rt.bl"
        "research/rt-cutover/rt/raw.bl"
        "research/rt-cutover/rt/kind.bl"
        "research/rt-cutover/rt/seq.bl"
        "research/rt-cutover/rt/eq.bl"
        "research/rt-cutover/rt/key.bl"
        "research/rt-cutover/rt/number.bl"
        "research/rt-cutover/rt/reduce.bl"
        "research/rt-cutover/rt/hash.bl"
        "research/rt-cutover/rt/call.bl"
        "research/rt-cutover/rt/coll.bl"
        "research/rt-cutover/rt/lazy.bl"
        "research/rt-cutover/rt/num.bl"
        "research/rt-cutover/rt/print.bl"
        "research/rt-cutover/rt/read.bl"
        "research/rt-cutover/rt/sorted.bl"))

(defn- comment? [l]
  (Elixir.String/starts_with? (Elixir.String/trim_leading l) ";"))

(defn- forwarders
  "Code lines that name the module this cutover DELETES.

   Two shapes, and the second is why one grep is not enough:
     `BeamLisp.RT/f`          a call site — caught by a plain grep;
     \"Elixir.BeamLisp.RT\"    a module named in a STRING, for a computed
                             `erlang/apply` — invisible to `BeamLisp.RT/`.

   Both ANSWER CORRECTLY today, so the differential gate cannot see them: they
   are calls into the layer being deleted, and they break at the flip and
   nowhere earlier. Four call sites and two computed atoms were live when this
   check was written. Comment lines are excluded, because the prose here names
   the doomed module constantly and on purpose."
  [path]
  (->> (split (File/read! path) "\n")
       (filter (fn [l] (not (comment? l))))
       (filter (fn [l] (or (Elixir.String/contains? l "BeamLisp.RT/")
                           (Elixir.String/contains? l "Elixir.BeamLisp.RT"))))
       (map (fn [l] (str path ":  " (Elixir.String/trim l))))))

(defn- run-forwarders []
  (let [hits (mapcat (fn [p] (to-list (forwarders p))) runtime-files)]
    (println (str "FORWARDERS into the module being deleted: " (count hits)
                  " (of " (count runtime-files) " files)"))
    (doseq [h hits] (println (str "  " h)))
    (cond
      (not (empty? hits))
      (throw (ex-info (str "gap: " (count hits)
                           " forwarders would break at the flip") {}))
      :else nil)))

(defn- frozen-contract
  "The runtime's export surface, as it stood when `lib/beam_lisp/rt.ex` was
   deleted. Read from `CONTRACT.txt`, NOT from the module: the module is the
   thing this cutover removes, so a gate that asked the deleted implementation
   what it used to export would answer nothing and report a 123-name gap as if
   the facade were empty.

   Captured before the deletion, from `BeamLisp.RT.module_info(:exports)` — the
   compiler's answer, never a list a human typed."
  []
  (->> (split (File/read! "research/rt-cutover/CONTRACT.txt") "\n")
       (map Elixir.String/trim)
       (filter (fn [l] (not (or (erlang/== "" l)
                                (Elixir.String/starts_with? l ";")))))
       (sort)))

(defn run []
  (let [want (frozen-contract)
        have (exports "Elixir.BeamLisp.Ns.Rt")
        want-n (to-list (map norm want))
        have-n (to-list (map norm have))
        missing (filter (fn [w] (not (member? w have))) want)
        spelled (filter (fn [m] (member? (norm m) have-n)) missing)
        absent (filter (fn [m] (not (member? (norm m) have-n))) missing)
        extras (filter (fn [h] (not (member? (norm h) want-n))) have)]
    (println (str "contract " (count want) " name/arity"
                  "   facade " (count have)))
    (println (str "SPELLING only — the owner is there, it needs the contract's"
                  " spelling: " (count spelled)))
    (doseq [x spelled] (println (str "  " x)))
    (println (str "ABSENT — needs a port: " (count absent)))
    (doseq [x absent] (println (str "  " x)))
    (println (str "facade extras (kernel names, not in the contract): "
                  (count extras)))
    (run-forwarders)))

(run)
