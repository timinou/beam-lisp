; rt/gap.bl — what the port still OWES, read from the two modules themselves.
;
; `surface.bl` prints the contract; this prints the DIFFERENCE between the
; contract and what the facade can serve. Both sides come from
; `module_info(:exports)`, so the answer is the compiler's, never a list a human
; keeps in step by hand.
;
; ── why there are two spellings, and why that is not a bug ─────────────────
;
; A member of a BL namespace is an Erlang atom spelled exactly as it was written,
; so `(defn hash-key …)` exports `hash-key`. Nothing munges: `slash-target`
; (compiler.bl:442) hands the member text through literally whether it resolves
; the prefix to a namespace or to a host module. Meanwhile the compiler's own
; literal lowers (`:hash_key` at :592, `:invoke` at :199, `:nth` at :1012), every
; `lib/**/*.ex` caller, and the VALUES of the `core` link table (`"print-str" =>
; :print_str`) all name the same member with `_`.
;
; So the facade has to serve both spellings, and this instrument has to tell a
; name that is merely spelled the other way from one that does not exist yet.
; That distinction is the whole point of the report: the first is an alias line,
; the second is a port.
;
; The `(:require [rt])` is load-bearing twice over: it forces the facade module
; to exist, and it fails loudly if any group the facade requires has stopped
; loading. A gap report that could not load the facade would report a full gap.

(ns rt.gap
  (:require [rt :as r]))

(defn- mod-atom [s] (erlang/binary_to_atom s :utf8))

(defn- exports [s]
  (->> (erlang/apply (mod-atom s) :module_info (list :exports))
       (filter (fn [p]
                 (let [n (erlang/element 1 p)]
                   (and (not (erlang/== n :module_info))
                        (not (erlang/== n :__info__))))))
       (map (fn [p] (str (erlang/element 1 p) "/" (erlang/element 2 p))))
       (sort)))

(defn- name-of [row] (first (split row "/")))
(defn- arity-of [row] (nth (split row "/") 1))

(defn- kebab [s] (join "-" (split s "_")))

; spelling-insensitive identity: `apply_to/2` and `apply-to/2` are one member
(defn- norm [row] (str (kebab (name-of row)) "/" (arity-of row)))

(defn- member? [x xs] (erlang/apply :lists :member (list x xs)))

(defn run []
  (let [want (exports "Elixir.BeamLisp.RT")
        have (exports "Elixir.BeamLisp.Ns.Rt")
        want-n (to-list (map norm want))
        have-n (to-list (map norm have))
        missing (filter (fn [w] (not (member? w have))) want)
        spelled (filter (fn [m] (member? (norm m) have-n)) missing)
        absent (filter (fn [m] (not (member? (norm m) have-n))) missing)
        extras (filter (fn [h] (not (member? (norm h) want-n))) have)]
    (println (str "contract " (count want) " name/arity"
                  "   facade " (count have)))
    (println (str "SPELLING only — the owner is there, it needs the contract's"
                  " spelling: " (count spelled)))
    (doseq [x spelled] (println (str "  " x)))
    (println (str "ABSENT — needs a port: " (count absent)))
    (doseq [x absent] (println (str "  " x)))
    (println (str "facade extras (kernel names, not in the contract): "
                  (count extras)))))

(run)
