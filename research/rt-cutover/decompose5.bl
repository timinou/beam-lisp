; rt/decompose5.bl — is `recur` inside a `defn` a tail call?
;
; decompose4 measured, in one run: a `loop`-based list walk at 25ns per element,
; a local call at 17ns, a BIF at 24ns — and a comparison step costing ~380ns per
; element in BOTH representations. The difference between the two loop shapes is
; the only structural thing left: the walk helpers (`list-cmp`, `walk-cmp`) are
; `defn`s that re-enter themselves with `recur`, while every measured floor was a
; `loop` inside an anonymous fn. If self-recursion in a defn costs ~300ns per
; turn, every recursive function in the runtime is paying it, and the fix is in
; the compiler's tail-call emission, not in the runtime.

(ns rt.decompose5)

(defn- now [] (erlang/monotonic_time :nanosecond))

(defn- consume [x] (cond (erlang/== x nil) 0 (erlang/== x true) 1 :else 2))

(defn- best-of [rounds f n]
  (loop [r rounds best nil]
    (cond
      (erlang/== r 0) best
      :else (let [t0 (now)
                  _ (loop [i 0 acc 0]
                      (cond (erlang/>= i n) acc
                            :else (recur (erlang/+ i 1) (erlang/+ acc (consume (f))))))
                  d (erlang/- (now) t0)]
              (recur (erlang/- r 1) (if (or (erlang/== best nil) (erlang/< d best)) d best))))))

;; A tail-recursive fn that re-enters itself with `recur` from a cond.
(defn- down-defn [i acc]
  (cond (erlang/== i 0) acc
        :else (recur (erlang/- i 1) (erlang/+ acc 1))))

;; The same loop, spelled with `loop`.
(defn- down-loop [i]
  (loop [i i acc 0]
    (cond (erlang/== i 0) acc
          :else (recur (erlang/- i 1) (erlang/+ acc 1)))))

;; A second `defn`, to separate "self-recursion" from "any defn call".
(defn- add1 [x] (erlang/+ x 1))

(defn- via-helper [i]
  (loop [i i acc 0]
    (cond (erlang/== i 0) acc
          :else (recur (erlang/- i 1) (add1 acc)))))

(defn- per-element [label f rounds nelems]
  (println (str "  " label "\t ns/element "
                (erlang/div (best-of 3 f rounds) (erlang/* rounds nelems)))))

(defn run []
  (let [n 1000]
    (per-element "defn + recur (self tail call)" (fn [] (down-defn n 0)) 2000 n)
    (per-element "loop + recur"                  (fn [] (down-loop n)) 2000 n)
    (per-element "loop + helper call"            (fn [] (via-helper n)) 2000 n)
    (per-element "defn + recur, 100 turns"       (fn [] (down-defn 100 0)) 20000 100)
    (per-element "loop + recur, 100 turns"       (fn [] (down-loop 100)) 20000 100))
  (println "done"))

(run)
