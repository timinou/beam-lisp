; probe-hash.bl — hash_key against the runtime it replaces.
;
; The interesting cases are the ones with metadata INSIDE a structure: metadata
; is invisible to `eqv`, so it must be invisible to hashing, and the walk has to
; reach a nested vector through a list, a set and a map. The plain values are
; here because the common case must return the SAME term, not an equal one
; (rebuilding it on every key operation is the cost the fast path exists to
; avoid) — `erlang/==` cannot tell those apart, so the counts below are about
; answers, and the fast path is checked by reading the code.

(ns rt.probe-hash
  (:require [rt.hash :as h]))

(def vals
  (list nil true false 0 1 -1 2.5 1M :kw 'sym "str"
        () (list 1 2 3)
        [] [1 2 3]
        (into [] (range 40))
        #{} #{1 2 3}
        {} {:a 1} {:a 1 :b 2}
        ^{:a 1} [1 2 3]
        (list ^{:a 1} [1 2 3] 4)
        [^{:a 1} [1 2] 3]
        #{^{:a 1} [1 2]}
        {:k ^{:a 1} [1 2]}
        (list ^{:a 1} [1 2] (list 3 ^{:b 2} [4]))))

(defn- outcome [f v]
  (try {:ok (f v)} (catch e {:raised e})))

(defn run []
  (let [rows (map (fn [v]
                    (let [a (outcome h/hash-key v)
                          b (outcome BeamLisp.RT/hash_key v)]
                      (cond
                        (and (:raised a) (:raised b)) :agree
                        (and (:raised a) (:raised b)) :agree
                        (erlang/== a b) :agree
                        :else {:fail v :bl a :rt b})))
                  vals)
        fails (filter (fn [r] (map? r)) rows)]
    (println (str "hash-key: " (count vals) " values, "
                  (erlang/- (count vals) (count fails)) " agree, "
                  (count fails) " fail"))
    (doseq [f fails]
      (println (str "  FAIL on " (pr-str (:fail f))
                    "  bl=" (pr-str (:bl f))
                    "  rt=" (pr-str (:rt f)))))
    (println (cond (erlang/== 0 (count fails)) "PASS rt.probe-hash"
                   :else "FAIL rt.probe-hash"))))

(run)
