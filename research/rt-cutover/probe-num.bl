; probe-num.bl — differential test for numeric functions (even?, odd?, zero?, pos?, neg?, nan?, rem, bit-not, promoting-inc, ratio?)

(ns probe-num
  (:require [rt.num :as num]))

(def vals
  (list nil 0 1 -1 2 2.5 1M :kw 'sym "str" [1 2 3] [] {} (list) (list 1 2)))

(defn- outcome [f v]
  (try {:ok (f v)} (catch _e {:raised true})))

(defn- verdict [a b]
  (cond
    (and (:raised a) (:raised b)) :agree
    (:raised b) :bl-more-total
    (:raised a) :fail
    :else (if (erlang/== (:ok a) (:ok b)) :agree :fail)))

(defn- run-op [[label bl-fn rt-fn]]
  (reduce
    (fn [acc v]
      (let [a (outcome bl-fn v)
            b (outcome rt-fn v)
            d (verdict a b)]
        {:total (inc (:total acc))
         :agree (if (= d :agree) (inc (:agree acc)) (:agree acc))
         :fail  (if (= d :fail)  (inc (:fail acc))  (:fail acc))
         :rows  (if (= d :fail)
                  (conj (:rows acc) [label v a b])
                  (:rows acc))}))
    {:total 0 :agree 0 :fail 0 :rows []}
    vals))

(defn- run-binary-op [[label bl-fn rt-fn]]
  (let [pairs (list [0 0] [0 1] [1 0] [1 2] [2 2] [-1 2])]
    (reduce
      (fn [acc [a b]]
        (let [x (outcome (fn [_] (bl-fn a b)) nil)
              y (outcome (fn [_] (rt-fn a b)) nil)
              d (verdict x y)]
          {:total (inc (:total acc))
           :agree (if (= d :agree) (inc (:agree acc)) (:agree acc))
           :fail  (if (= d :fail)  (inc (:fail acc))  (:fail acc))
           :rows  (if (= d :fail)
                    (conj (:rows acc) [label [a b] x y])
                    (:rows acc))}))
      {:total 0 :agree 0 :fail 0 :rows []}
      pairs)))

(def ops
  (list
    ["even?"       (fn [v] (num/even? v))       (fn [v] (BeamLisp.RT/even? v))]
    ["odd?"        (fn [v] (num/odd? v))        (fn [v] (BeamLisp.RT/odd? v))]
    ["zero?"       (fn [v] (num/zero? v))       (fn [v] (BeamLisp.RT/zero? v))]
    ["pos?"        (fn [v] (num/pos? v))        (fn [v] (BeamLisp.RT/pos? v))]
    ["neg?"        (fn [v] (num/neg? v))        (fn [v] (BeamLisp.RT/neg? v))]
    ["nan?"        (fn [v] (num/nan? v))        (fn [v] (BeamLisp.RT/nan? v))]
    ["ratio?"      (fn [v] (num/ratio? v))      (fn [v] (BeamLisp.RT/ratio? v))]
    ["promoting-inc" (fn [v] (num/promoting-inc v)) (fn [v] (BeamLisp.RT/promoting_inc v))]
    ["rem"         (fn [a b] (num/rem a b))     (fn [a b] (BeamLisp.RT/rem a b))]
    ["bit-not"     (fn [v] (num/bit-not v))     (fn [v] (BeamLisp.RT/bit_not v))]))

(let [results (map
                (fn [op]
                  (cond
                    (or (= (first op) "rem") (= (first op) "bit-not"))
                    (run-binary-op op)
                    :else
                    (run-op op)))
                ops)
      total-agree (reduce #(+ %1 (:agree %2)) 0 results)
      total-fail  (reduce #(+ %1 (:fail %2)) 0 results)]
  (do
    (println (str total-agree " agree / " total-fail " fail"))
    (doseq [r results]
      (when (> (:fail r) 0)
        (doseq [row (:rows r)]
          (println (str "FAIL " (first row) " on " (second row))))))))
