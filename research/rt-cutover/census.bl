; rt/census.bl — find the slow shapes STATICALLY, over the compiler's own IR.
;
; The profiler found the cost — `BeamLisp.Env` lookups — and the IR says which
; source forms produce them:
;
;   a namespace `def` VALUE     compiles to  {:op :global :ns … :name …}
;   a call to a same-ns `defn`  compiles to  :global  +  RT.invoke
;   an `erlang/…` BIF           compiles to  {:op :remote :mod :erlang …}
;   a `loop`                    compiles to  a `:let` binding a `:fn` that its
;                                            own body applies by name
;
; So the question "which functions resolve a variable on every iteration?" is
; answerable without running anything, for every definition at once, using the
; substrate's own vocabulary (`system.ir`) rather than a bespoke reader. That is
; the point of the IR: ONE meaning for a program, computed by the compiler.
;
; `:global` is the cost. A `:global` inside a loop body is the structural
; inefficiency — it is re-resolved every iteration.

(ns rt.census
  (:require [system.analyze :as an]
            [system.ir :as ir]))

(def files
  ["research/rt-cutover/rt/raw.bl"
   "research/rt-cutover/rt/kind.bl"
   "research/rt-cutover/rt/seq.bl"
   "research/rt-cutover/rt/eq.bl"
   "research/rt-cutover/rt/key.bl"
   "research/rt-cutover/rt/number.bl"
   "research/rt-cutover/rt/reduce.bl"])

;; ── generic traversal over ir/child-nodes ──────────────────────────────────

(defn- collect [n pred]
  (cond
    (not (ir/node? n)) ()
    :else (concat
            (if (pred n) (list n) ())
            (mapcat (fn [c] (collect c pred)) (ir/child-nodes n)))))

(defn- count-nodes [n] (count (collect n (fn [_] true))))

;; ── loop detection: a :let whose own body applies the name it binds ────────

(defn- let-self-applied?
  [n]
  (let [b (:body n)]
    (and (erlang/== (:op n) :let)
         (ir/node? b)
         (erlang/== (:op b) :apply)
         (ir/node? (:fn b))
         (erlang/== (:op (:fn b)) :var)
         (erlang/== (:name (:fn b)) (:name n)))))

(defn- innermost-fn-body
  "A `loop` compiles to nested :fn nodes; the body that runs per iteration is
   the innermost clause body."
  [n]
  (cond
    (and (ir/node? n) (erlang/== (:op n) :fn))
    (let [b (:body (first (:clauses n)))]
      (cond (and (ir/node? b) (erlang/== (:op b) :fn)) (innermost-fn-body b)
            :else b))
    :else nil))

(defn- loop-bodies [n]
  (cond
    (not (ir/node? n)) ()
    :else (let [inner (mapcat (fn [c] (loop-bodies c)) (ir/child-nodes n))]
            (cond
              (and (erlang/== (:op n) :let) (let-self-applied? n))
              (cons (innermost-fn-body (:init n)) inner)
              :else inner))))

;; ── the census ─────────────────────────────────────────────────────────────

(defn- global-refs [n]
  (collect n (fn [x] (erlang/== (:op x) :global))))

(defn- names-of [gs] (distinct (map (fn [g] (str (:ns g) "/" (:name g))) gs)))

(defn- census-fn [name body]
  (let [inloop (mapcat (fn [lb] (global-refs lb)) (loop-bodies body))
        total (global-refs body)]
    {:name name
     :nodes (count-nodes body)
     :globals (count total)
     :in-loop (count inloop)
     :loop-names (names-of inloop)}))

(defn- report [path]
  (let [src (File/read! path)
        bodies (an/fn-bodies src)
        rows (map (fn [n] (census-fn n (:body (get bodies n)))) (keys bodies))
        worst (reverse (sort-by (fn [r] (:in-loop r)) rows))
        hot (filter (fn [r] (erlang/> (:in-loop r) 0)) worst)]
    (println (str "──── " path "  (" (count rows) " definitions)"))
    (doseq [r hot]
      (println (str "   in-loop globals " (:in-loop r)
                    "  of " (:globals r) " total"
                    "  (" (:nodes r) " nodes)  " (:name r)))
      (doseq [g (:loop-names r)] (println (str "        " g))))))

(defn run []
  (doseq [f files] (report f))
  (println "done"))

(run)
