; rt/profile.bl — call COUNTS, not timings.
;
; Differencing micro-benchmarks got as far as it can: a comparison step measures
; ~380ns per element in both representations, while every constituent call
; measures 2-25ns, and the arithmetic does not close. Micro-benchmarks amplify
; noise by subtraction; a profiler does not. `eprof` reports, per function, how
; many times it was called and where the time went — which answers the actual
; question: how much work does ONE comparison step perform?
;
; eprof is slow and perturbs timing, so read the COUNTS, not the percentages.

(ns rt.profile
  (:require [rt :as rt]))

(defn- mk
  "A list of n integers in order, matching (range n) except at index i."
  [n i]
  (erlang/apply :lists :reverse
    (list (loop [j 0 acc ()]
            (cond (erlang/>= j n) acc
                  :else (recur (erlang/+ j 1)
                               (cons (if (erlang/== j i) 100000 j) acc)))))))

(defn- mv [n i]
  (loop [j 0 acc []]
    (cond (erlang/>= j n) acc
          :else (recur (erlang/+ j 1) (conj acc (if (erlang/== j i) 100000 j))))))

(defn- profile [label f]
  (println (str "──── " label " ────"))
  (erlang/apply :eprof :start (list))
  (erlang/apply :eprof :profile (list f))
  (erlang/apply :eprof :analyze (list))
  (erlang/apply :eprof :stop (list)))

(defn run []
  (let [n 1000
        l (to-list (range n))
        ld (mk n (erlang/- n 1))
        v (into [] (range n))
        vd (mv n (erlang/- n 1))]
    (profile "ONE compare of two 1000-element LISTS (differ at the last)"
             (fn [] (rt/compare l ld)))
    (profile "ONE compare of two 1000-element VECTORS (differ at the last)"
             (fn [] (rt/compare v vd)))
    (profile "ONE compare of two 1000-element VECTORS (equal)"
             (fn [] (rt/compare v v))))
  (println "done"))

(run)
