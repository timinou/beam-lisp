; rt/decompose.bl — where the time actually goes.
;
; The benchmark gave two numbers a per-element model cannot explain at once:
; comparing two 10-element vectors that differ at the LAST element costs ~14us,
; and two 1000-element vectors that differ at the last cost ~360us. If the walk
; were purely per-element, the ratio would be 100. Something is O(1) and large,
; or the per-element cost falls with length.
;
; So measure the SHAPE, not a point: T(n) for several n on both representations,
; then the individual operations each walk step performs. A cost model fitted to
; these rows says which lever moves the number and by how much — a claim that can
; be checked by re-running the same rows after a change.

(ns rt.decompose
  (:require [rt :as rt]
            [rt.kind :as k]
            [rt.seq :as s]))

(defn- now [] (erlang/monotonic_time :nanosecond))

(defn- consume [x] (cond (erlang/== x nil) 0 (erlang/== x true) 1 :else 2))

(defn- best-of [rounds f n]
  (loop [r rounds best nil]
    (cond
      (erlang/== r 0) best
      :else (let [t0 (now)
                  _ (loop [i 0 acc 0]
                      (cond (erlang/>= i n) acc
                            :else (recur (erlang/+ i 1) (erlang/+ acc (consume (f))))))
                  d (erlang/- (now) t0)]
              (recur (erlang/- r 1) (if (or (erlang/== best nil) (erlang/< d best)) d best))))))

(defn- ns-per [d n] (erlang/div d n))

(defn- row-n [label bl rt-fn n]
  (let [a (ns-per (best-of 3 bl n) n)
        b (if (erlang/== rt-fn nil) :na (ns-per (best-of 3 rt-fn n) n))]
    (println (str "  " label "\t bl " a "\t rt " b "\t n " n))))

(defn- row [label bl rt-fn] (row-n label bl rt-fn 200000))

;; ── values ─────────────────────────────────────────────────────────────────

(defn- vec-plain [n] (into [] (range n)))

(defn- vec-diff-at
  "A vector of length n that matches `vec-plain` everywhere EXCEPT index i, so a
   comparison walks exactly i+1 elements before it knows the answer."
  [n i]
  (loop [j 0 acc (into [] [])]
    (cond
      (erlang/>= j n) acc
      :else (recur (erlang/+ j 1)
                   (conj acc (if (erlang/== j i) 100000 j))))))

(defn- lst-diff-at [n i] (to-list (vec-diff-at n i)))

;; ── the scaling curve ──────────────────────────────────────────────────────

(defn- scaling [label mk-a mk-b iters]
  (doseq [n (list 2 10 100 1000)]
    (let [a (mk-a n) b (mk-b n)
          i (erlang/- n 1)]
      (row-n (str label " n=" n) (fn [] (rt/compare a b)) (fn [] (BeamLisp.RT/compare a b)) iters))))

(defn run []
  (println "=== A. compare, two vectors differing only at the LAST index ===")
  (println "   (the walk must reach the end; n=2..1000 shows fixed vs per-element)")
  (doseq [n (list 2 10 100 1000)]
    (let [a (vec-plain n) b (vec-diff-at n (erlang/- n 1))]
      (row-n (str "  vectors differ-last n=" n)
             (fn [] (rt/compare a b)) (fn [] (BeamLisp.RT/compare a b))
             (cond (erlang/=< n 2) 50000 (erlang/=< n 10) 20000 (erlang/=< n 100) 2000 :else 200))))

  (println "=== B. the same walk over a LIST (cons cells, not a trie) ===")
  (doseq [n (list 10 100 1000)]
    (let [a (to-list (vec-plain n)) b (lst-diff-at n (erlang/- n 1))]
      (row-n (str "  lists differ-last n=" n)
             (fn [] (rt/compare a b)) (fn [] (BeamLisp.RT/compare a b))
             (cond (erlang/=< n 10) 20000 (erlang/=< n 100) 2000 :else 200))))

  (println "=== C. how much is known BEFORE the walk? (differ at index 0) ===")
  (doseq [n (list 10 1000)]
    (let [a (vec-plain n) b (vec-diff-at n 0)]
      (row-n (str "  vectors differ-FIRST n=" n)
             (fn [] (rt/compare a b)) (fn [] (BeamLisp.RT/compare a b))
             (cond (erlang/=< n 10) 20000 :else 200))))

  (println "=== D. the primitives each step performs ===")
  (let [v10 (vec-plain 10) v1000 (vec-plain 1000) l1000 (to-list (vec-plain 1000))]
    (row    "  kind(vector)"        (fn [] (k/kind v10))        (fn [] :na))
    (row    "  family-of-kind"      (fn [] (k/family (k/kind v10))) (fn [] :na))
    (row    "  seq(vector)"         (fn [] (s/k-seq v10))       (fn [] (BeamLisp.RT/seq v10)))
    (row    "  first(vector)"       (fn [] (s/k-first v10))     (fn [] (BeamLisp.RT/first v10)))
    (row    "  rest(vector)"        (fn [] (s/k-rest v10))      (fn [] (BeamLisp.RT/rest v10)))
    (row    "  next(vector)"        (fn [] (s/k-next v10))      (fn [] (BeamLisp.RT/next v10)))
    (row-n  "  to-list 10-vector"   (fn [] (s/k-to-list v10))   (fn [] (BeamLisp.RT/doall v10)) 20000)
    (row-n  "  to-list 1000-vector" (fn [] (s/k-to-list v1000)) (fn [] (BeamLisp.RT/doall v1000)) 200)
    (row-n  "  to-list 1000-list"   (fn [] (s/k-to-list l1000)) (fn [] (BeamLisp.RT/doall l1000)) 200))

  (println "=== E. what counts as 'equal' costs (the short-circuit) ===")
  (let [v1000 (vec-plain 1000) v1000b (vec-plain 1000)]
    (row-n "  compare equal 1000-vec" (fn [] (rt/compare v1000 v1000b)) (fn [] (BeamLisp.RT/compare v1000 v1000b)) 2000))
  (println "=== F. the floor: what a bare BL loop costs per element ===")
  (let [l1000 (to-list (vec-plain 1000)) v1000 (vec-plain 1000)]
    (row-n "  list walk, hd/tl, sum"
           (fn [] (loop [xs l1000 acc 0]
                    (cond (erlang/== xs ()) acc
                          :else (recur (erlang/tl xs) (erlang/+ acc (erlang/hd xs))))))
           nil 500)
    (row-n "  list walk, no arithmetic"
           (fn [] (loop [xs l1000 n 0]
                    (cond (erlang/== xs ()) n
                          :else (recur (erlang/tl xs) (erlang/+ n 1)))))
           nil 500)
    (row-n "  list walk calling a LOCAL helper"
           (fn [] (loop [xs l1000 acc 0]
                    (cond (erlang/== xs ()) acc
                          :else (recur (erlang/tl xs) (erlang/+ acc (erlang/hd xs))))))
           nil 500)
    (row-n "  vector walk, seq/first/next"
           (fn [] (loop [xs (s/k-seq v1000) n 0]
                    (cond (erlang/== xs nil) n
                          :else (recur (s/k-next xs) (erlang/+ n (s/k-first xs))))))
           nil 200)
    (row-n "  element-cmp on equal ints"
           (fn [] (loop [i 0 acc 0]
                    (cond (erlang/>= i 1000) acc
                          :else (recur (erlang/+ i 1) (erlang/+ acc (rt/compare 7 7))))))
           nil 2000)
    (row-n "  k-first via ns alias" (fn [] (s/k-first v1000)) (fn [] (BeamLisp.RT/first v1000)) 100000))

  (println "done"))

(run)
