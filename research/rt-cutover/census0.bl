; rt/census0.bl — what does the compiler's own IR say a reference costs?
;
; The profiler found the cost (BeamLisp.Env lookups). The IR can say WHICH
; source forms produce them, across every function at once, without running
; anything. This file is the discovery step: compile two tiny definitions whose
; only difference is how they name a constant and a foreign function, and print
; the ANF the compiler produced for each.

(ns rt.census0
  (:require [system.analyze :as an]))

(def sample
  "
(def ^:private LIMIT 10)

(defn same-ns-const [xs]
  (loop [ys xs n 0]
    (cond (erlang/== ys LIMIT) n
          :else (recur (erlang/tl ys) (erlang/+ n 1)))))

(defn local-call [x] (erlang/+ x 1))

(defn calls-local [xs]
  (loop [ys xs n 0]
    (cond (erlang/== ys ()) n
          :else (recur (erlang/tl ys) (local-call n)))))
")

(defn run []
  (let [bodies (an/fn-bodies sample)]
    (doseq [name (sort (keys bodies))]
      (println (str "──── " name " ────"))
      (println (pr-str (:body (get bodies name))))
      (println)))
  (println "done"))

(run)
