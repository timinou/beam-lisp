; rt/surface.bl — the cutover's contract, read from the module itself.
;
; The replacement must export every one of these names at these arities, or a
; call site that exists today breaks at RUNTIME (the link table is consulted on
; invocation, never at compile time). Read from `module_info(:exports)` rather
; than from a grep, so the list is the compiler's answer, not a pattern's.

(ns rt.surface)

(defn- rt-exports []
  (let [mod (erlang/binary_to_atom "Elixir.BeamLisp.RT" :utf8)]
    (->> (to-list (erlang/apply mod :module_info (list :exports)))
         (filter (fn [p] (let [n (erlang/element 1 p)]
                           (and (not (erlang/== n :module_info))
                                (not (erlang/== n :__info__))))))
         (map (fn [p] (str (erlang/element 1 p) "/" (erlang/element 2 p))))
         (sort))))

(defn run []
  (let [xs (rt-exports)]
    (println (str "BeamLisp.RT exports: " (count xs)))
    (doseq [x xs] (println (str "  " x)))
    (println "--- end ---")))

(run)
