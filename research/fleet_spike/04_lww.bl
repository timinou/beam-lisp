; 04_lww.bl — LWW-Register: a single value that converges by "last writer wins",
;             with a deterministic tiebreak. The membership/health CRDT.
; Run: ./blx run research/fleet_spike/04_lww.bl
;
; Data class: MEMBERSHIP / HEALTH (fleet/README §the map). "node vps-2 is :up as of
; t=1700." Each fact is a single value that changes over time; when two nodes report
; different statuses concurrently, we need ONE to win, deterministically, on every
; replica. That is a Last-Writer-Wins Register.
;
; The subtlety is the word "last". Wall clocks disagree across nodes, so ties on
; timestamp are possible and must be broken the SAME way everywhere — else two
; replicas pick different winners and never converge. The rule: compare by
; (timestamp, node-id); the node-id tiebreak is total and identical on all
; replicas, so merge is deterministic and commutative.

(ns fleet.lww)

;; ═══ a register value: {:val v :ts logical-time :node id} ═══════════════════
(defn reg [val ts node] {:val val :ts ts :node node})

;; merge: higher ts wins; tie on ts broken by higher node-id. Total order ⇒
;; commutative, associative, idempotent.
(defn lww-merge [a b]
  (cond
    (> (:ts a) (:ts b)) a
    (< (:ts a) (:ts b)) b
    ;; equal timestamps: break the tie deterministically by node id
    (>= (compare (:node a) (:node b)) 0) a
    :else b))

;; ═══ scenario: three nodes report a service's health, concurrently ══════════
;; node-a says :up @10, node-b says :down @12 (a later observation), node-c also
;; says :up @12 (a tie with b on ts). The whole fleet must agree on ONE answer.
(def from-a (reg :up   10 "node-a"))
(def from-b (reg :down 12 "node-b"))
(def from-c (reg :up   12 "node-c"))

;; deliver in every order to different replicas
(def r1 (lww-merge (lww-merge from-a from-b) from-c))   ; a,b,c
(def r2 (lww-merge (lww-merge from-c from-a) from-b))   ; c,a,b
(def r3 (lww-merge from-b (lww-merge from-c from-a)))   ; b,(c,a)
(println "── three health reports, merged in three orders ──")
(println (str "  a=" (pr-str from-a)))
(println (str "  b=" (pr-str from-b)))
(println (str "  c=" (pr-str from-c)))
(println (str "  order a,b,c → " (pr-str r1)))
(println (str "  order c,a,b → " (pr-str r2)))
(println (str "  order b,c,a → " (pr-str r3)))

;; ═══ convergence + which value won and why ══════════════════════════════════
(def converged (= r1 r2 r3))
;; b and c tie at ts=12; tiebreak by node id: "node-c" > "node-b" ⇒ c wins ⇒ :up
(def winner (:val r1))
(def winner-node (:node r1))
(println "── result ──")
(println (str "  converged: " converged
              "   winning value: " winner " from " winner-node
              "  (ts tie at 12 broken by node-id: node-c > node-b)"))

;; ═══ idempotence + the wall-clock hazard, named ═════════════════════════════
(def idem (= (lww-merge r1 r1) r1))
;; NOTE: with real wall clocks, a node with a fast clock can "win" forever — LWW
;; silently drops the loser's write. That is acceptable for HEALTH (a later probe
;; supersedes an earlier one) but NOT for desired state, which is why desired
;; state uses Raft (spike 06), not LWW.
(println (str "  idempotent: " idem
              "   (LWW drops the loser's write — fine for health, NOT for desired state)"))

;; ═══ assertions ═════════════════════════════════════════════════════════════
(def ok (and converged                 ; all delivery orders agree
             (= :up winner)             ; c's :up @12 beats b's :down @12 by node-id
             (= "node-c" winner-node)
             idem))
(println "")
(println (str (if ok "PASS" "FAIL") " 04_lww  (last-writer-wins converges with a deterministic tiebreak)"))
