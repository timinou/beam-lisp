; 02_gset_crdt.bl — the datom log IS a CRDT: events merge by union, and the only
;                    hazard (id collision) is fixed by partitioning the id space.
; Run: ./blx run research/fleet_spike/02_gset_crdt.bl
;
; Data class: EVENTS (fleet/README §the map). Metrics, audit, latency — append-only,
; high volume, must never conflict. This is the class where ANY convergent answer
; is fine, so it wants a CRDT, and the simplest one — a G-Set (grow-only set) —
; is exactly what an immutable, append-only datom log already is.
;
; A CRDT converges because its merge is a join-semilattice: COMMUTATIVE,
; ASSOCIATIVE, IDEMPOTENT. For a G-Set, merge = set UNION, which has all three
; trivially. This spike proves convergence on REAL datom tx-datoms shipped between
; two simulated nodes in arbitrary order, and shows why per-node id partitioning
; is the precondition that makes union safe.

(ns fleet.gset (:require [datom]))

;; ═══ the CRDT laws, demonstrated on plain sets first ════════════════════════
(defn union [a b] (clojure.set/union a b))
(def A #{1 2 3}) (def B #{3 4}) (def C #{4 5})
(def commutative (= (union A B) (union B A)))
(def associative (= (union (union A B) C) (union A (union B C))))
(def idempotent  (= (union A A) A))
(println "── G-Set merge is a join-semilattice ──")
(println (str "  commutative: " commutative "   associative: " associative "   idempotent: " idempotent))

;; ═══ two nodes producing EVENTS as datoms, with PARTITIONED id space ════════
;; The hazard: entity/tx ids are per-conn monotonic, so two nodes both mint e=…
;; The fix: each node prefixes its own id range. Here we model that by TAGGING
;; every event with its origin node, so two nodes' facts are disjoint by
;; construction — union can never conflate them.
(defn node-conn []
  (datom/connect [{:db/ident :ev/node :db/valueType :db.type/string}
                  {:db/ident :ev/seq  :db/valueType :db.type/long}
                  {:db/ident :ev/kind :db/valueType :db.type/keyword}]))

(defn emit! [conn node seq kind]
  (datom/transact! conn [{:db/id -1 :ev/node node :ev/seq seq :ev/kind kind}]))

;; node A and node B each record their own events, independently
(def na (node-conn))
(def nb (node-conn))
(emit! na "A" 1 :request) (emit! na "A" 2 :request) (emit! na "A" 3 :error)
(emit! nb "B" 1 :request) (emit! nb "B" 2 :timeout)

;; the replication UNIT is the tx-datoms projected to portable facts (e a v)
(defn facts-of [conn]
  (set (datom/q '[:find ?node ?seq ?kind
                  :where [?e :ev/node ?node] [?e :ev/seq ?seq] [?e :ev/kind ?kind]] (datom/db conn))))
(def fa (facts-of na))
(def fb (facts-of nb))
(println "── each node's events (a G-Set of facts) ──")
(println (str "  A: " (pr-str fa)))
(println (str "  B: " (pr-str fb)))

;; ═══ merge by union, in ARBITRARY ORDER, on both nodes ══════════════════════
;; delivery order and duplication must not matter. Deliver B→A and A→B, plus a
;; duplicate delivery, and a re-merge, then compare.
(def a-merged (union (union fa fb) fb))            ; A gets B's facts, twice (dup)
(def b-merged (union fb fa))                       ; B gets A's facts
(def a-remerged (union a-merged fa))               ; A re-applies its own (idempotent)
(println "── after gossip (arbitrary order + duplicates) ──")
(println (str "  A sees " (count a-merged) " events, B sees " (count b-merged) " events"))

;; ═══ convergence: both nodes reach the identical set ════════════════════════
(def converged (= a-merged b-merged a-remerged))
(def total (union fa fb))
(println (str "  converged: " converged "   total distinct events: " (count total)))

;; ═══ counter-example: WITHOUT id partitioning, union conflates ══════════════
;; If both nodes had used bare monotonic ids (e=1,2,3 on each), union by id would
;; merge A's e=1 with B's e=1 — losing an event. Partitioning by node prevents it.
(def bad-a #{[1 :request] [2 :request]})           ; node A's facts keyed by bare id
(def bad-b #{[1 :timeout] [2 :error]})             ; node B reused ids 1,2
(def bad-merge (union bad-a bad-b))                ; 4 distinct only by luck of value
(def keyed-by-id (set (map first bad-merge)))      ; the ID set collapses to {1,2}
(println "── why partitioning matters ──")
(println (str "  bare-id merge keeps " (count bad-merge) " tuples but only "
              (count keyed-by-id) " distinct ids → an event would be lost if keyed by id alone"))

;; ═══ assertions ═════════════════════════════════════════════════════════════
(def ok (and commutative associative idempotent
             converged                       ; union converges regardless of order/dups
             (= 5 (count total))             ; 3 from A + 2 from B, none lost
             (= 2 (count keyed-by-id))))      ; bare ids WOULD collide (motivating partition)
(println "")
(println (str (if ok "PASS" "FAIL") " 02_gset_crdt  (datom log = G-Set; union converges; partition ids)"))
