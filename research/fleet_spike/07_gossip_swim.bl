; 07_gossip_swim.bl — how a fleet DISSEMINATES facts and DETECTS failure without
;                      a central coordinator: anti-entropy gossip + SWIM.
; Run: ./blx run research/fleet_spike/07_gossip_swim.bl
;
; Data class: DISSEMINATION + MEMBERSHIP (fleet/README §the map). Two jobs:
;   (1) spread a fact (a new route, a health update) to every node, cheaply and
;       robustly, without a broadcast bottleneck — ANTI-ENTROPY GOSSIP.
;   (2) decide a node is dead without a central monitor and without false alarms
;       from one unlucky dropped packet — SWIM (Scalable Weakly-consistent
;       Infection-style process group Membership).
;
; Gossip: each round, every node picks a random peer and they exchange state,
; taking the union (a CRDT merge — spike 02). A fact reaches all N nodes in
; O(log N) rounds, and no single node is a bottleneck or a single point of failure.
;
; SWIM failure detection: to check node T, prober P sends a ping. If no ack, P
; doesn't declare T dead (one lost packet ≠ death). Instead P asks k OTHER nodes
; to ping T on its behalf (indirect probe). Only if direct AND all indirect probes
; fail is T marked suspect, then dead. This is what removes false positives that a
; naive "missed one heartbeat ⇒ dead" detector suffers.

(ns fleet.swim)

;; ═══ anti-entropy gossip: union-merge state to a random peer each round ═════
;; state = set of known facts. Model 8 nodes; node 0 learns a fact; measure how
;; many rounds until ALL know it. Peer choice is deterministic-pseudo-random here
;; (phash on round+node) so the spike is reproducible.
(def N 8)
(defn peer-of [node round]
  (let [p (rem (erlang/phash2 [node round] 1000000) N)]
    (if (= p node) (rem (inc p) N) p)))            ; never self

(defn gossip-round [states round]
  ;; each node pushes its state to one peer; peer unions it in (push gossip)
  (reduce (fn [st node]
            (let [peer (peer-of node round)]
              (update st peer (fn [s] (clojure.set/union s (get st node))))))
          states (range N)))

(defn all-know? [states fact]
  (every? (fn [node] (contains? (get states node) fact)) (range N)))

;; node 0 starts knowing :route-web; everyone else empty
(def init (into {} (map (fn [i] [i (if (= i 0) #{:route-web} #{})]) (range N))))
(def rounds
  (loop [st init r 0]
    (if (or (all-know? st :route-web) (> r 20))
      r
      (recur (gossip-round st (inc r)) (inc r)))))
(println "── anti-entropy gossip (8 nodes, push) ──")
(println (str "  fact :route-web reached all " N " nodes in " rounds " rounds  (~log2 N = "
              (erlang/round (/ (erlang/apply :math :log (list N)) (erlang/apply :math :log (list 2)))) ")"))

;; ═══ SWIM failure detection: direct ping + indirect probes ══════════════════
;; model each node's reachability as a fn. A "dead" node acks nothing; a node
;; behind a single lossy link acks direct sometimes, indirect via others always.
(defn ping [alive? target] (alive? target))

(defn swim-check [target direct-ok? indirect-oks k]
  ;; direct probe; on failure, k indirect probes via other members
  (if direct-ok?
    {:status :alive :via :direct}
    (let [acked (some identity (take k indirect-oks))]
      (if acked
        {:status :alive :via :indirect}          ; someone reached it ⇒ not dead
        {:status :dead  :via :none}))))            ; nobody reached it ⇒ dead

;; case A: target healthy — direct ack
(def healthy (swim-check "n7" true [] 3))
;; case B: target behind ONE lossy link to the prober, but reachable by others.
;; naive detector would false-positive; SWIM's indirect probes save it.
(def lossy (swim-check "n7" false [false true false] 3))
;; case C: target genuinely dead — direct fails AND all indirect fail
(def dead (swim-check "n7" false [false false false] 3))
(println "── SWIM failure detection ──")
(println (str "  healthy node:            " (pr-str healthy)))
(println (str "  prober's link lossy:     " (pr-str lossy)   "  (indirect probe avoided a false positive)"))
(println (str "  genuinely dead:          " (pr-str dead)))

;; ═══ assertions ═════════════════════════════════════════════════════════════
(def ok (and (<= rounds 12)                      ; gossip converges fast (O(log N)-ish)
             (= :alive (:status healthy))
             (= :alive (:status lossy))          ; SWIM avoids the false positive
             (= :indirect (:via lossy))          ; ...specifically via indirect probe
             (= :dead (:status dead))))          ; only declares dead when truly unreachable
(println "")
(println (str (if ok "PASS" "FAIL") " 07_gossip_swim  (gossip spreads in O(log N); SWIM avoids false deaths)"))
