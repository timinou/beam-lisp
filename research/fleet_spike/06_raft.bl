; 06_raft.bl — consensus for the one class that needs it: DESIRED STATE.
;              leader election, log replication, commit-by-majority, and the
;              split-brain guarantee — a minority CANNOT commit.
; Run: ./blx run research/fleet_spike/06_raft.bl
;
; Data class: DESIRED STATE (fleet/README §the map). "billing runs on vps-2." This
; is the one class where a CRDT is WRONG: two nodes' conflicting placements must
; not silently merge into a convergent-but-wrong answer. Raft gives a single
; agreed truth, and — crucially — REFUSES to make progress without a majority, so
; a network partition halts writes on the minority side instead of forking reality.
;
; Raft in one breath: nodes have a TERM (a logical epoch). To become leader a node
; increments its term and asks for votes; a node grants at most one vote per term;
; a candidate with a MAJORITY becomes leader. The leader appends entries to a log
; and replicates them; an entry COMMITS once a majority has stored it. Because two
; majorities always overlap, two leaders can't both commit in the same term — that
; overlap is the whole safety argument.
;
; We model 5 nodes as pure state, and a network we can PARTITION, and drive an
; election, a replication round, and a split-brain to show the minority stalls.

(ns fleet.raft)

;; ═══ node state: {:id :term :voted-for :role :log :commit} ══════════════════
(defn node [id] {:id id :term 0 :voted-for nil :role :follower :log [] :commit 0})
(def cluster ["n1" "n2" "n3" "n4" "n5"])           ; 5 nodes ⇒ majority = 3
(defn majority [ids] (inc (quot (count ids) 2)))    ; 3

;; ═══ election: a candidate requests votes within a term, over a REACHABLE set ═
;; A voter grants iff the candidate's term is >= its own AND it hasn't voted this
;; term. Returns [elected? leader-term voters].
(defn request-votes [nodes candidate-id reachable]
  (let [cand (get nodes candidate-id)
        new-term (inc (:term cand))
        voters (filter (fn [id] (contains? (set reachable) id)) (keys nodes))
        granted (filter (fn [id]
                          (let [v (get nodes id)]
                            (or (= id candidate-id)              ; votes for self
                                (>= new-term (:term v)))))       ; fresh enough term
                        voters)]
    {:term new-term
     :votes (count granted)
     :elected (>= (count granted) (majority cluster))
     :voters granted}))

;; ═══ replicate an entry: commits iff a MAJORITY of reachable nodes store it ══
(defn replicate [reachable value term]
  (let [stored (count (filter (fn [id] (contains? (set cluster) id)) reachable))]
    {:value value :term term
     :stored stored
     :committed (>= stored (majority cluster))}))

;; ═══ 1. a healthy election: all 5 reachable ════════════════════════════════
(def nodes0 (into {} (map (fn [id] [id (node id)]) cluster)))
(def elect-all (request-votes nodes0 "n1" cluster))
(println "── election, all 5 reachable ──")
(println (str "  n1 runs in term " (:term elect-all) ", got " (:votes elect-all)
              " votes (need " (majority cluster) ") → elected: " (:elected elect-all)))

;; ═══ 2. leader replicates desired state; majority ⇒ commit ═════════════════
(def commit1 (replicate cluster {:service "billing" :host "vps-2"} (:term elect-all)))
(println "── replicate desired state {billing→vps-2} ──")
(println (str "  stored on " (:stored commit1) "/5 → committed: " (:committed commit1)))

;; ═══ 3. SPLIT BRAIN: partition {n1 n2} | {n3 n4 n5} ═════════════════════════
;; The minority side (n1,n2) tries to elect and commit a CONFLICTING value; the
;; majority side (n3,n4,n5) elects and commits. Raft must let ONLY the majority win.
(def minority ["n1" "n2"])
(def majority-side ["n3" "n4" "n5"])
(def elect-min (request-votes nodes0 "n1" minority))
(def elect-maj (request-votes nodes0 "n3" majority-side))
(println "── partition: {n1,n2} | {n3,n4,n5} ──")
(println (str "  minority n1: " (:votes elect-min) " votes → elected: " (:elected elect-min)))
(println (str "  majority n3: " (:votes elect-maj) " votes → elected: " (:elected elect-maj)))

;; each side tries to commit its own value
(def commit-min (replicate minority {:service "billing" :host "vps-1"} (:term elect-min)))
(def commit-maj (replicate majority-side {:service "billing" :host "vps-3"} (:term elect-maj)))
(println "── each side tries to commit a CONFLICTING placement ──")
(println (str "  minority commit {billing→vps-1}: " (:committed commit-min) "  (stored " (:stored commit-min) "/5)"))
(println (str "  majority commit {billing→vps-3}: " (:committed commit-maj) "  (stored " (:stored commit-maj) "/5)"))
(println "  ∴ no split-brain: the minority CANNOT commit; reality does not fork.")

;; ═══ 4. two-majorities-overlap: the safety core, stated ═════════════════════
;; Any two subsets of size >= majority(5)=3 share at least one node. That node
;; would have to vote twice in one term, which it refuses — so ≤1 leader per term.
(def overlap-guaranteed (> (* 2 (majority cluster)) (count cluster)))  ; 2*3 > 5

;; ═══ assertions ═════════════════════════════════════════════════════════════
(def ok (and (:elected elect-all)          ; healthy election succeeds
             (:committed commit1)          ; majority commits desired state
             (not (:elected elect-min))    ; minority CANNOT elect a leader
             (:elected elect-maj)          ; majority side CAN
             (not (:committed commit-min)) ; minority CANNOT commit → no fork
             (:committed commit-maj)       ; only the majority commits
             overlap-guaranteed))          ; two majorities always overlap
(println "")
(println (str (if ok "PASS" "FAIL") " 06_raft  (majority elects & commits; minority stalls; no split-brain)"))
