; 01_sharding.bl — placement: where does a service live? consistent hashing
;                  and rendezvous (HRW), and why they beat `hash mod N`.
; Run: ./blx run research/fleet_spike/01_sharding.bl
;
; Data class: PLACEMENT (fleet/README §the map). Which node owns a service or a
; key. The requirement is not consistency — it is BALANCE plus MINIMAL CHURN: when
; a node joins or leaves, as few keys as possible should move, or the whole fleet
; reshuffles on every membership change.
;
; The naive answer, `node = hash(key) mod N`, fails the churn test catastrophically:
; change N (a node joins/leaves) and almost EVERY key remaps. Two algorithms fix
; this — consistent hashing (a ring) and rendezvous/HRW (highest-random-weight).
; This spike implements both and MEASURES the churn.

(ns fleet.sharding)

(defn h [s] (erlang/phash2 s 4294967296))          ; a stable 32-bit hash

;; ═══ 1. the naive baseline: hash mod N ══════════════════════════════════════
(defn mod-place [nodes key] (nth nodes (rem (h key) (count nodes))))

;; ═══ 2. consistent hashing: nodes and keys on one ring ══════════════════════
;; Each node is placed at V points on a 2^32 ring (V = virtual nodes, for
;; balance). A key hashes to a point; its owner is the first node clockwise.
(def V 64)
(defn ring [nodes]
  (sort-by first
    (mapcat (fn [n] (map (fn [v] [(h (str n "#" v)) n]) (range V))) nodes)))
(defn ring-place [r key]
  (let [p (h key)
        ;; first ring point with position >= p, else wrap to the first
        after (some (fn [[pos n]] (if (>= pos p) n nil)) r)]
    (or after (second (first r)))))

;; ═══ 3. rendezvous (HRW): key picks the node with the highest combined hash ══
;; No ring, no virtual nodes: for each node, score = hash(node,key); the highest
;; score wins. Naturally balanced, and on removal only the losing node's keys move.
(defn hrw-place [nodes key]
  (second (reduce (fn [best n]
                    (let [w (h (str n "|" key))]
                      (if (> w (first best)) [w n] best)))
                  [-1 nil] nodes)))

;; ═══ measure churn: how many keys move when a node is removed? ═══════════════
(def keys- (map (fn [i] (str "svc-" i)) (range 1000)))
(def nodes5 ["a" "b" "c" "d" "e"])
(def nodes4 ["a" "b" "c" "d"])                      ; "e" failed

(defn churn [place-fn n5 n4]
  (let [before (map (fn [k] (place-fn n5 k)) keys-)
        after  (map (fn [k] (place-fn n4 k)) keys-)
        moved  (count (filter (fn [[b a]] (not= b a)) (map (fn [a b] [a b]) before after)))]
    (/ (* 100 moved) (count keys-))))

;; mod uses count-sensitive N, so wrap ring/hrw to the same (nodes,key) shape
(def mod-churn  (churn mod-place nodes5 nodes4))
(def hrw-churn  (churn hrw-place nodes5 nodes4))
(def ring-churn
  (let [r5 (ring nodes5) r4 (ring nodes4)
        before (map (fn [k] (ring-place r5 k)) keys-)
        after  (map (fn [k] (ring-place r4 k)) keys-)
        moved  (count (filter (fn [[b a]] (not= b a)) (map (fn [a b] [a b]) before after)))]
    (/ (* 100 moved) (count keys-))))

(println "── churn when 1 of 5 nodes fails (1000 keys) ──")
(println (str "  hash mod N:        " mod-churn "% of keys move  (near-total reshuffle)"))
(println (str "  consistent hash:   " ring-churn "% move  (~ the failed node's share)"))
(println (str "  rendezvous (HRW):  " hrw-churn "% move  (only the failed node's keys)"))

;; ═══ balance: is load spread evenly across nodes? ═══════════════════════════
(defn distribution [place-fn nodes]
  (-> (group-by (fn [k] (place-fn nodes k)) keys-) (update-vals count)))
(def hrw-dist (distribution hrw-place nodes5))
(println "── balance (HRW, 1000 keys over 5 nodes; ideal ~200 each) ──")
(println (str "  " (pr-str hrw-dist)))
(def spread (- (reduce max (vals hrw-dist)) (reduce min (vals hrw-dist))))

;; ═══ assertions ═════════════════════════════════════════════════════════════
;; ideal churn for removing 1 of 5 nodes is ~20% (that node's share). mod N
;; should be far worse; ring and HRW should be near-ideal.
(def ok (and (> mod-churn 50)              ; naive: catastrophic reshuffle
             (< ring-churn 35)             ; consistent hashing: ~ one node's share
             (<= hrw-churn 30)             ; HRW: exactly the failed node's keys (its share, ~25%)
             (< spread 120)))              ; HRW load is reasonably balanced
(println "")
(println (str (if ok "PASS" "FAIL") " 01_sharding  (consistent hashing + HRW minimise churn)"))
