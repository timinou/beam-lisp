; 09_fleet_lifecycle.bl — the capstone: a whole day in the life of a 2-node bl
;   fleet, with EVERY algorithm from this suite doing its real job on REAL datom.
; Run: ./blx run research/fleet_spike/09_fleet_lifecycle.bl
;
; The other spikes teach one algorithm each. This one puts them ALL on one stage
; and runs a narrative — join, place, replicate, migrate, partition, fail over,
; heal, converge — so you can see how the per-data-class model composes into a
; living system. Two datom connections are two nodes; the "network" is a value we
; can cut and restore.
;
; The cast (each links to its teaching spike):
;   · placement       → HRW rendezvous            (01_sharding.bl)
;   · desired state    → single-writer + Raft quorum (06_raft.bl)
;   · events           → G-Set union on real datom  (02_gset_crdt.bl)
;   · routes           → OR-Set add-wins            (03_orset.bl)
;   · health           → LWW-Register               (04_lww.bl)
;   · dissemination    → log-shipping (basis-t/since) + gossip (07_gossip_swim.bl)
;   · failure detect   → SWIM verdict               (07_gossip_swim.bl)
;   · migration gate   → z3 proof, refuse-or-admit   (08_upgrade_refusal.bl)

(ns fleet.lifecycle (:require [datom] [system.core :as sys] [z3]))

;; ═══ the substrate: two nodes = two datom conns; each holds desired + events ═
(def dstate-schema
  [{:db/ident :svc/id   :db/valueType :db.type/string :db/unique :db.unique/identity}
   {:db/ident :svc/host :db/valueType :db.type/string}
   {:db/ident :svc/gen  :db/valueType :db.type/long}])
(defn new-node [] {:conn (datom/connect dstate-schema) :basis 0})

(def vps1 (atom (new-node)))
(def vps2 (atom (new-node)))
(def cluster ["vps-1" "vps-2"])

(defn h [s] (erlang/phash2 s 4294967296))

;; ── log-shipping: replicate the leader's desired-state facts to a follower ──
(defn desired-facts [node]
  (set (datom/q '[:find ?id ?host ?gen
                  :where [?e :svc/id ?id][?e :svc/host ?host][?e :svc/gen ?gen]]
                (datom/db (:conn node)))))
(defn ship! [from-node to-atom]
  (let [facts (desired-facts from-node)
        r (datom/transact! (:conn (deref to-atom))
            (vec (map-indexed (fn [i f] {:db/id (- (- i) 1) :svc/id (nth f 0)
                                         :svc/host (nth f 1) :svc/gen (nth f 2)}) facts)))]
    (swap! to-atom assoc :basis (datom/basis-t (:db-after r)))))

(println "══════════ A DAY IN A 2-NODE bl FLEET ══════════")

;; ═══ SCENE 1 — the cluster forms; leader is elected ════════════════════════
;; single-writer discipline (06): ONE node owns desired-state writes. With 2
;; nodes, majority = 2, so a real quorum needs both; we elect vps-1 as writer and
;; note the honest caveat (2-node clusters can't tolerate a failure and keep
;; quorum — that's why 3 or 5 is the real recommendation, see the tutorial).
(def leader "vps-1")
(defn majority [] (inc (quot (count cluster) 2)))       ; 2
(println (str "\nSCENE 1 — cluster {" (clojure.string/join ", " cluster)
              "} forms; leader=" leader " (writer); majority=" (majority)))

;; ═══ SCENE 2 — place two services by HRW, transact desired state on leader ══
(defn hrw-host [key] (second (reduce (fn [best n]
                                       (let [w (h (str n "|" key))]
                                         (if (> w (first best)) [w n] best)))
                                     [-1 nil] cluster)))
(def placements {"billing" (hrw-host "billing") "api" (hrw-host "api")})
(datom/transact! (:conn (deref vps1))
  [{:db/id -1 :svc/id "billing" :svc/host (get placements "billing") :svc/gen 1}
   {:db/id -2 :svc/id "api"     :svc/host (get placements "api")     :svc/gen 1}])
(println (str "\nSCENE 2 — HRW places services: " (pr-str placements)))
(println "  leader transacted desired state (billing, api) at gen 1")

;; ═══ SCENE 3 — replicate to the follower (log-shipping) ════════════════════
(ship! (deref vps1) vps2)
(println "\nSCENE 3 — replicate leader → follower (ship tx facts)")
(println (str "  follower vps-2 desired state: " (pr-str (desired-facts (deref vps2)))))
(def replicated (= (desired-facts (deref vps1)) (desired-facts (deref vps2))))
(println (str "  converged: " replicated))

;; ═══ SCENE 4 — routes (OR-Set) and events (G-Set) flow, coordination-free ══
;; routes: an OR-Set of name→backend claims, each side may add; merge = union
(defn or-add [s e tag] (update-in s [:adds e] (fn [t] (clojure.set/union (or t #{}) #{tag}))))
(defn or-val [s] (set (keep (fn [[e t]] (if (seq (clojure.set/difference t (:rems s))) e nil)) (:adds s))))
(defn or-merge [x y] {:adds (merge-with clojure.set/union (:adds x) (:adds y)) :rems (clojure.set/union (:rems x) (:rems y))})
(def routes1 (-> {:adds {} :rems #{}} (or-add "billing.app" [:vps1 1])))
(def routes2 (-> {:adds {} :rems #{}} (or-add "web.app" [:vps2 1])))
(def routes (or-merge routes1 routes2))
;; events: each node emits its own, merge = union (a G-Set); no id collision bc tagged by node
(def events (clojure.set/union #{[:vps1 :req 1] [:vps1 :req 2]} #{[:vps2 :req 1] [:vps2 :err 1]}))
(println "\nSCENE 4 — coordination-free data flows")
(println (str "  routes (OR-Set union): " (pr-str (or-val routes))))
(println (str "  events (G-Set union):  " (count events) " events, node-tagged, no collision"))

;; ═══ SCENE 5 — migrate billing vps→vps, GATED by a proven migration ════════
;; Moving a stateful service across hosts is an upgrade: its state at rest must
;; still satisfy the invariant after the move, and in-flight messages queued under
;; the old placement must still be honoured under the new one. The fleet REFUSES
;; to replicate a migration until BOTH are proven by z3 (08_upgrade_refusal). So
;; the scene has two acts: 5a the operator submits an incomplete plan and is
;; refused, with a clear reason each time, until it is fixed; 5b the proven plan
;; is admitted, the desired state flips, and it replicates.
(def target (if (= (get placements "billing") "vps-1") "vps-2" "vps-1"))
(defn host-of [node id] (first (first (datom/q '[:find ?h :in $ ?id :where [?e :svc/id ?id][?e :svc/host ?h]] (datom/db (:conn node)) id))))

;; the migration gate: prove the data migration preserves the service invariant
;; (billing's ledger balance ≥ 0) AND the new message handler simulates the old.
(def port (z3/open))
(defn inv [v] (str "(>= " v " 0)"))                 ; billing invariant: balance ≥ 0
(def decls "(declare-const b1 Int)\n(declare-const b2 Int)\n(declare-const amt Int)\n")
(def R (fn [a c] (str "(= " a " " c ")")))          ; observable: same balance

(defn admit-migration
  "Decide a host migration. `data-mig` maps old state→new (b1→b2 expr); `msg-mig`
   is the new handler's transition. nil = that half of the plan is MISSING.
   Returns {:ok true} or {:refused reason} — the fleet ships only on :ok."
  [data-mig msg-mig]
  (let [data-ok (and data-mig (sys/migration-preserves? port inv decls "b1" "b2" data-mig))
        msg-ok  (and msg-mig (sys/simulates? port R decls "b1" "b2" "(- b1 amt)" msg-mig
                                              "(assert (>= b1 amt))\n(assert (>= amt 0))"))]
    (cond
      (not data-mig) {:refused "data migration missing: billing carries a ledger; moving it without a state migration would strand the balance"}
      (not data-ok)  {:refused "data migration unsafe: z3 found a starting balance the migration drives below 0 (invariant balance≥0 broken)"}
      (not msg-mig)  {:refused "message migration missing: in-flight charge requests queued on the old host have no handler on the new one"}
      (not msg-ok)   {:refused "message migration unsafe: z3 found a message the new handler answers differently from the old (observable divergence)"}
      :else          {:ok true})))

(println (str "\nSCENE 5a — operator submits an incomplete migration of billing → " target))
;; the plan evolves as the operator fixes each refusal in turn:
(def attempt-1 (admit-migration nil          nil))           ; nothing proven
(def attempt-2 (admit-migration "(- b1 100)" nil))           ; data mig added, but unsafe
(def attempt-3 (admit-migration "b1"         nil))           ; data mig fixed; msg mig missing
(def attempt-4 (admit-migration "b1"         "(+ (- b2 amt) 1)")) ; msg mig added, but diverges
(doseq [[label a] [["attempt 1 (empty plan)   " attempt-1]
                   ["attempt 2 (+data, unsafe) " attempt-2]
                   ["attempt 3 (data ok, -msg) " attempt-3]
                   ["attempt 4 (+msg, diverges)" attempt-4]]]
  (println (str "  ✗ " label " → REFUSED: " (:refused a))))

;; 5b — the operator submits a complete, correct plan; z3 admits it; it ships.
(def final-plan (admit-migration "b1" "(- b2 amt)"))         ; carry balance, handler simulates
(println (str "\nSCENE 5b — corrected plan (carry state + simulating handler)"))
(println (str "  ✓ migration gate → " (if (:ok final-plan) "ADMITTED (data preserved ∧ messages simulate)" (:refused final-plan))))
(when (:ok final-plan)
  (datom/transact! (:conn (deref vps1)) [{:db/id -1 :svc/id "billing" :svc/host target :svc/gen 2}])
  (ship! (deref vps1) vps2))
(println (str "  billing migrated → " target ", replicated:"))
(println (str "    vps-1 sees billing on: " (host-of (deref vps1) "billing")))
(println (str "    vps-2 sees billing on: " (host-of (deref vps2) "billing")))
(def migrated (= target (host-of (deref vps1) "billing") (host-of (deref vps2) "billing")))
;; ═══ SCENE 6 — PARTITION: the follower is cut off; writes must not fork ════
;; With the network cut, the follower tries to accept a CONFLICTING write. Single-
;; writer + quorum (06) forbids it: a lone follower is a minority (1 < majority 2),
;; so its write is REFUSED — reality does not fork. Meanwhile SWIM on the leader
;; probes the follower and (after indirect probes also fail) marks it suspect.
(def network-up (atom false))                          ; partition!
(defn can-commit? [reachable-count] (>= reachable-count (majority)))
(def follower-alone 1)                                  ; only itself reachable
(def follower-write-refused (not (can-commit? follower-alone)))
;; SWIM verdict from the leader's side: direct fails, indirect (no other nodes) fails ⇒ suspect
(def swim-verdict (if (deref network-up) :alive :suspect))
(println "\nSCENE 6 — PARTITION {vps-1} | {vps-2}")
(println (str "  follower tries a conflicting write {billing→vps-1}"))
(println (str "  quorum check: 1 reachable < majority " (majority) " → write REFUSED: " follower-write-refused))
(println (str "  SWIM on leader: follower verdict = " swim-verdict " (direct+indirect probes failed)"))
(println "  ∴ no split-brain: the minority cannot commit; the leader keeps serving reads.")

;; ═══ SCENE 7 — HEAL: network restored; anti-entropy reconverges ════════════
;; on heal, the follower pulls the leader's log since its last basis and applies
;; it. LWW health (04) marks the follower :up again with a fresh timestamp.
(reset! network-up true)
(ship! (deref vps1) vps2)                               ; catch-up replicate
(defn lww-merge [a b] (if (>= (:ts b) (:ts a)) b a))
(def health (lww-merge {:node "vps-2" :val :suspect :ts 10} {:node "vps-2" :val :up :ts 20}))
(println "\nSCENE 7 — HEAL: network restored")
(println (str "  follower catches up; billing on vps-2 = " (host-of (deref vps2) "billing")))
(println (str "  LWW health: vps-2 now " (:val health) " @ts " (:ts health)))
(def healed (= (desired-facts (deref vps1)) (desired-facts (deref vps2))))
(println (str "  final convergence (leader == follower): " healed))

;; ═══ THE CURTAIN — assertions across the whole lifecycle ═══════════════════
(def ok (and replicated                          ; scene 3: replication converged
             (:refused attempt-1) (:refused attempt-2) ; scene 5a: incomplete plans refused
             (:refused attempt-3) (:refused attempt-4) ; ...each with a distinct reason
             (:ok final-plan)                     ; scene 5b: proven plan admitted
             (= 2 (count (or-val routes)))        ; scene 4: both routes present (OR-Set)
             (= 4 (count events))                 ; scene 4: all events survive (G-Set)
             migrated                             ; scene 5b: migration replicated to both
             follower-write-refused               ; scene 6: minority cannot commit (no fork)
             (= :suspect swim-verdict)            ; scene 6: SWIM detected the partition
             (= :up (:val health))                ; scene 7: LWW healed health
             healed))                             ; scene 7: full reconvergence
(println "\n═══════════════════════════════════════════════")
(println (str (if ok "PASS" "FAIL")
              " 09_fleet_lifecycle  (join→place→replicate→gate→migrate→partition→heal, all algorithms)"))
