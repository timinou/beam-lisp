; research/p19_datalog_feed/spike_gfp.bl
; ══════════════════════════════════════════════════════════════════════════
; P19 Layer B — the GREATEST-FIXPOINT primitive: datom's missing dual.
;
; derive-semi-naive (rules.bl) grows from EMPTY: seed base facts, ADD what the
; rules force, stop when a round adds nothing = LEAST fixpoint. Every recursive
; capability datom has (reachability, shortest path, same-generation) is that
; one shape.
;
; A whole family of verification/analysis problems is the OTHER shape — seed
; FULL, REMOVE what the rules condemn, stop when a round removes nothing =
; GREATEST fixpoint:
;   · Houdini invariant discovery   (strong, mutual-support)
;   · safe-region / AG φ model check (CTL invariance)
;   · bisimulation / behavioural equivalence  (state minimization)
;   · dead-code / liveness, attractors, coarsest partition refinement
;
; The claim under test: ALL of these are ONE primitive — a monotone operator
; iterated DOWNWARD to its greatest fixpoint — and the per-step DECISION is
; supplied by whichever engine already owns it (z3 for Houdini, pure relation
; for safe-set/bisim). Build the driver once; the capabilities are inputs.
;
; This spike builds the driver (naive + semi-naive/delta + provenance) and
; pressure-tests it on THREE demos, each COMBINED with a shipped piece:
;   D1 Houdini   × z3 define-fun prover  → discovers a MUTUAL-SUPPORT invariant
;                                          the weakened (each-alone) loop cannot.
;   D2 safe-set  × pure relation + DELTA → CTL AG; incremental re-check on edit.
;   D3 bisim     × the transition model  → behavioural equivalence = minimization.
; ══════════════════════════════════════════════════════════════════════════

(ns p19.spike-gfp (:require [z3]))

; ── THE PRIMITIVE ─────────────────────────────────────────────────────────
; gfp: greatest fixpoint by downward iteration. The dual of derive-semi-naive.
;   seed      — the full candidate relation (a set).
;   survives? — (fn [t S] -> bool), MONOTONE in S: growing S can only turn a
;               tuple from falling to surviving, never the reverse. (Proof
;               obligation on the caller; all three demos satisfy it.)
; Returns {:fixpoint S* :rounds}. S* is the greatest S ⊆ seed with
;   S* = { t ∈ S* | survives? t S* }.

(defn gfp [seed survives?]
  (loop [s seed round 0]
    (let [s2 (into #{} (filter (fn [t] (survives? t s)) (into [] s)))]
      (if (= (count s2) (count s))
        {:fixpoint s2 :rounds round}
        (recur s2 (+ round 1))))))

; gfp-delta: the SEMI-NAIVE dual. A tuple can only NEWLY fall this round if
; something it depends on fell LAST round. `depends-on?` (fn [t fell-set] ->
; bool) is the optimizer hook — the exact analogue of semi-naive reading the
; delta. `checks` counts survives? calls so we can PROVE it does less work.
(defn gfp-delta [seed survives? depends-on?]
  (loop [s seed to-check (into [] seed) round 0 checks 0]
    (let [fell   (into #{} (filter (fn [t] (not (survives? t s))) to-check))
          checks (+ checks (count to-check))]
      (if (empty? fell)
        {:fixpoint s :rounds round :checks checks}
        (let [s2  (into #{} (filter (fn [t] (not (contains? fell t))) (into [] s)))
              nxt (into [] (filter (fn [t] (depends-on? t fell)) (into [] s2)))]
          (recur s2 nxt (+ round 1) checks))))))

; gfp-explained: provenance. `falls-why` returns nil (survives) or a WITNESS
; (why it fell). The log is the derivation the string loop throws away.
(defn gfp-explained [seed falls-why]
  (loop [s seed round 0 log []]
    (let [checked (map (fn [t] [t (falls-why t s)]) (into [] s))
          fallen  (filter (fn [p] (some? (second p))) checked)
          s2      (into #{} (map first (filter (fn [p] (nil? (second p))) checked)))]
      (if (empty? fallen)
        {:fixpoint s2 :rounds round :log log}
        (recur s2 (+ round 1)
               (into log (map (fn [p] {:tuple (first p) :round round :witness (second p)})
                              fallen)))))))

; ══════════════════════════════════════════════════════════════════════════
; DEMO 1 — HOUDINI × z3.  The strong loop as ONE gfp call.
;
; Machine (state x,y; init 0,0):
;   :bump  next (x+1, y)        — x grows unboundedly
;   :tick  next (x+y, y)        — x += y ; y unchanged
; The interesting invariant x≥0 is NOT 1-inductive alone (tick adds y, which
; alone could be negative) — it survives ONLY with y≥0 also assumed. That is
; MUTUAL SUPPORT, the whole reason Houdini beats "check each candidate alone".
; ══════════════════════════════════════════════════════════════════════════

(def port (z3/open))

(def d1-svars ["x" "y"])
(def d1-init  {"x" "0" "y" "0"})
(def d1-trans
  [{:label :bump :guard nil :next {"x" "(+ x 1)" "y" "y"}}
   {:label :tick :guard nil :next {"x" "(+ x y)" "y" "y"}}])

(defn- sig [svars] (join " " (map (fn [v] (str "(" v " Int)")) svars)))
(defn- cdef [svars cand] (str "(define-fun C (" (sig svars) ") Bool " cand ")\n"))
(defn- adef [svars s]
  (str "(define-fun A (" (sig svars) ") Bool "
       (if (empty? s) "true" (str "(and " (join " " (into [] s)) ")")) ")\n"))

; whole-state priming with ZERO textual substitution — the correctness fix the
; shipped discover-invariant never adopted (it primed by string split → substring
; collisions on names like bal/balance). z3 binds the params.
(defn- breaks? [svars s cand t]
  (let [decls (str (join "" (map (fn [v] (str "(declare-const " v " Int)\n")) svars))
                   (join "" (map (fn [v] (str "(declare-const " v "2 Int)\n")) svars)))
        eqs   (join "" (map (fn [v] (str "(assert (= " v "2 " (get (:next t) v v) "))\n")) svars))
        cur   (join " " svars)
        pri   (join " " (map (fn [v] (str v "2")) svars))
        smt   (str (adef svars s) (cdef svars cand) decls
                   "(assert (A " cur "))\n"
                   (if (:guard t) (str "(assert " (:guard t) ")\n") "")
                   eqs
                   "(assert (not (C " pri ")))\n")]
    (= "sat" (z3/check port smt))))     ; sat = counterexample = candidate breaks

(defn- holds-at-init? [svars cand init]
  (let [args (join " " (map (fn [v] (get init v)) svars))]
    (= "unsat" (z3/check port (str (cdef svars cand)
                                   "(assert (not (C " args ")))\n")))))

; relational candidate vocabulary — (op a b) over vars ∪ consts, a≠b. This is
; the Gap-2 fix: relational, not the hardcoded single-var (op v 0|1).
(defn- rel-candidates [vars consts]
  (let [dom (concat vars (map str consts))]
    (distinct
      (mapcat (fn [op]
                (mapcat (fn [a]
                          (keep (fn [b] (if (= a b) nil (str "(" op " " a " " b ")"))) dom))
                        dom))
              ["<=" ">="]))))

(defn discover-strong [svars init trans]
  (let [cands (rel-candidates svars [0])
        est   (into #{} (filter (fn [c] (holds-at-init? svars c init)) cands))]
    (:fixpoint (gfp est (fn [c s] (not (some (fn [t] (breaks? svars s c t)) trans)))))))

; weakened = each candidate proven inductive ALONE (antecedent = itself only).
; This is exactly what an all-datalog (least-fixpoint) discovery can express —
; and what it LOSES relative to the strong gfp.
(defn discover-weak [svars init trans]
  (let [cands (rel-candidates svars [0])
        est   (into #{} (filter (fn [c] (holds-at-init? svars c init)) cands))]
    (into #{} (filter (fn [c] (not (some (fn [t] (breaks? svars #{c} c t)) trans))) est))))

(defn demo1 []
  (let [strong (discover-strong d1-svars d1-init d1-trans)
        weak   (discover-weak   d1-svars d1-init d1-trans)
        ; provenance: which transition kills which candidate, which round
        est    (into #{} (filter (fn [c] (holds-at-init? d1-svars c d1-init))
                                 (rel-candidates d1-svars [0])))
        prov   (gfp-explained est
                 (fn [c s] (some (fn [t] (if (breaks? d1-svars s c t) (:label t) nil)) d1-trans)))]
    (println "── D1 Houdini × z3 ──────────────────────────────────────────")
    (println "strong gfp discovers :" (sort (into [] strong)))
    (println "weak (each-alone)    :" (sort (into [] weak)))
    (println "MUTUAL-SUPPORT gain  :" (sort (into [] (filter (fn [c] (not (contains? weak c))) strong))))
    (println "  (these survive ONLY because a sibling conjunct is co-assumed —")
    (println "   an all-least-fixpoint datalog discovery cannot find them.)")
    (println "provenance (kill log, first 4):")
    (doseq [e (take 4 (:log prov))]
      (println "   round" (:round e) "— dropped" (:tuple e) "— broken by :" (:witness e)))
    {:strong strong :weak weak}))

; ══════════════════════════════════════════════════════════════════════════
; DEMO 2 — SAFE-SET × pure relation + DELTA.  CTL "AG safe", and INCREMENTAL.
;
; A state is safe iff it is not bad AND all its successors are safe. The largest
; such set is a greatest fixpoint — the invariant region a model checker proves.
; No z3: the per-step decision is a pure relational check. Then we EDIT the
; machine (mark a new bad state) and show gfp-delta re-checks only the AFFECTED
; region — the incremental-verification advantage a from-scratch loop cannot get.
; ══════════════════════════════════════════════════════════════════════════

(def succ {0 [1] 1 [2] 2 [3] 3 [0] 4 [2 5] 5 []})   ; 0..3 cycle; 4→{2,5}; 5 sink

(defn- safe-survives? [bad] (fn [s S]
  (and (not (contains? bad s))
       (every? (fn [n] (contains? S n)) (get succ s [])))))

; a state may NEWLY fall only if one of its successors fell last round.
(defn- safe-depends? [t fell] (some (fn [n] (contains? fell n)) (get succ t [])))

(defn demo2 []
  (let [all   #{0 1 2 3 4 5}
        bad0  #{5}
        cold  (gfp-delta all (safe-survives? bad0) safe-depends?)
        ; EDIT: state 2 becomes bad. Re-verify from the PRIOR fixpoint, only
        ; re-checking states reachable-to the change — vs a cold run from full.
        bad1  #{5 2}
        warm  (gfp-delta (:fixpoint cold) (safe-survives? bad1) safe-depends?)
        cold2 (gfp-delta all (safe-survives? bad1) safe-depends?)]
    (println "── D2 safe-set (CTL AG) × delta ─────────────────────────────")
    (println "safe region (bad={5})      :" (sort (into [] (:fixpoint cold)))
             " checks=" (:checks cold))
    (println "after edit bad={5,2} WARM  :" (sort (into [] (:fixpoint warm)))
             " checks=" (:checks warm) "(from prior fixpoint)")
    (println "same result COLD from full :" (sort (into [] (:fixpoint cold2)))
             " checks=" (:checks cold2) "(from scratch)")
    (println "  incremental re-verify did" (:checks warm) "checks vs" (:checks cold2)
             "cold — same answer, less work.")
    {:cold cold :warm warm :cold2 cold2}))

; ══════════════════════════════════════════════════════════════════════════
; DEMO 3 — BISIMULATION × the transition model.  Behavioural minimization.
;
; Two states are bisimilar iff they enable the same labels AND each label leads
; to bisimilar states. The COARSEST bisimulation is a greatest fixpoint over
; state PAIRS — seed all pairs, drop any pair that can distinguish. This is the
; relation-level fixpoint SITTING ON TOP of a per-step check (here structural;
; in the real tier it would be simulates? / the z3 step). gfp + the shipped
; transition model = automatic state-space minimization.
; ══════════════════════════════════════════════════════════════════════════

; deterministic labelled transitions: {[state label] -> state}. States 1 and 2
; are behaviourally identical (both: :a→3, nothing else); a minimizer must merge.
(def delta {[0 :a] 1  [0 :b] 2
            [1 :a] 3
            [2 :a] 3
            [3 :a] 3})
(def states [0 1 2 3])
(defn- labels [s] (into #{} (keep (fn [l] (if (contains? delta [s l]) l nil)) [:a :b])))

(defn demo3 []
  (let [pairs (into #{} (mapcat (fn [a] (map (fn [b] [a b]) states)) states))
        surv? (fn [pr S]
                (let [a (first pr) b (second pr)]
                  (and (= (labels a) (labels b))
                       (every? (fn [l] (contains? S [(get delta [a l]) (get delta [b l])]))
                               (into [] (labels a))))))
        bisim (:fixpoint (gfp pairs surv?))
        ; equivalence classes: group states by their bisim-related set
        classes (distinct (map (fn [a]
                                 (sort (into [] (keep (fn [b] (if (contains? bisim [a b]) b nil)) states))))
                               states))]
    (println "── D3 bisimulation × transition model ───────────────────────")
    (println "coarsest bisimulation pairs:" (sort (into [] bisim)))
    (println "equivalence classes        :" classes)
    (println "  states 1 and 2 merge — same observable behaviour ⇒ the state")
    (println "  space minimizes from" (count states) "to" (count classes) "classes.")
    {:bisim bisim :classes classes}))

(defn run [] (demo1) (println) (demo2) (println) (demo3) :ok)
(run)
