; research/p19_datalog_feed/spike_theories.bl
; ══════════════════════════════════════════════════════════════════════════
; P19 — z3 is NOT an Int solver. The Int prison was OURS (smt.bl/lit-sort),
; never the port's. z3/check pipes raw SMT-LIB text and reads sat/unsat — so
; EVERY z3 theory is already reachable through the SHIPPED port, no change.
;
; This spike fires one query per theory THROUGH z3/check, and next to each
; writes the beam-lisp capability it unlocks — "far dreams" that are actually
; implementable now because the wire already carries them.
;
; Theories probed: Bool · Real (nonlinear) · BitVec · Array · String/Seq ·
; Datatype (ADT/sum) · Set (via Array→Bool) · Quantifiers (∀) · Optimize
; (maximize) · UF (uninterpreted functions).
; ══════════════════════════════════════════════════════════════════════════

(ns p19.spike-theories (:require [z3]))

(def port (z3/open))

(defn probe [title smt expect]
  (let [got (z3/check port smt)]
    (println (if (= got expect) "  ok " " ??? ") title "→" got
             (if (= got expect) "" (str "(expected " expect ")")))
    (= got expect)))

; ── 1. REAL / nonlinear arithmetic ────────────────────────────────────────
; DREAM: numeric-stability & physical-unit invariants. "a PID controller's
; error never diverges", "this fixed-point accumulator can't overflow given
; |x|<1" — properties over ℝ, not ℤ. Rung-1 with Real sorts, verbatim machinery.
(probe "Real: ∃x. x²=2 ∧ x>0 (√2 exists)"
  "(declare-const x Real)\n(assert (= (* x x) 2.0))\n(assert (> x 0.0))\n" "sat")
(probe "Real: ∀-free refute x²≥0 is UNSAT to break (always true)"
  "(declare-const x Real)\n(assert (< (* x x) 0.0))\n" "unsat")

; ── 2. BITVECTOR ──────────────────────────────────────────────────────────
; DREAM: bit-exact protocol/flag invariants and REAL overflow. beam uses
; bit-flags for capability sets & message tags; "these two cap-masks are
; disjoint", "this counter wraps at 2^16" — machine arithmetic, provable.
(probe "BitVec: (x & (x-1)) = 0 has a solution (power of two)"
  "(declare-const x (_ BitVec 8))\n(assert (= (bvand x (bvsub x #x01)) #x00))\n(assert (not (= x #x00)))\n" "sat")
(probe "BitVec: overflow — ∃ 8-bit x,y. x+y < x (wrap)"
  "(declare-const x (_ BitVec 8))\n(declare-const y (_ BitVec 8))\n(assert (bvult (bvadd x y) x))\n" "sat")

; ── 3. ARRAY ──────────────────────────────────────────────────────────────
; DREAM: COLLECTION CONTENT invariants directly (Gap 1, exactly). A queue/map
; state is an Array; "after store k v, select k = v", "no key maps to a bad
; value" — content properties length-abstraction can't see. Rung-3 done right.
(probe "Array: read-over-write — select(store(a,i,v),i) = v, refute is UNSAT"
  "(declare-const a (Array Int Int))\n(declare-const i Int)\n(declare-const v Int)\n(assert (not (= (select (store a i v) i) v)))\n" "unsat")
(probe "Array: ∃ array with a[0]=1 ∧ a[1]=2 (a concrete collection state)"
  "(declare-const a (Array Int Int))\n(assert (= (select a 0) 1))\n(assert (= (select a 1) 2))\n" "sat")

; ── 4. STRING / SEQUENCE ───────────────────────────────────────────────────
; DREAM: message-format & sequence-protocol invariants on ACTUAL content.
; "every logged token is prefixed 'evt:'", "the reply never contains the
; secret", "the sequence of sends is a valid session word". Content, not count.
(probe "String: ∃ s. (str.++ \"evt:\" s) has length 10 ∧ contains 'ok'"
  "(declare-const s String)\n(assert (= (str.len (str.++ \"evt:\" s)) 10))\n(assert (str.contains s \"ok\"))\n" "sat")
(probe "Seq: refute — a seq of len 1 cannot equal one of len 2 (UNSAT)"
  "(declare-const p (Seq Int))\n(assert (= (seq.len p) 1))\n(assert (= p (seq.++ (seq.unit 1) (seq.unit 2))))\n" "unsat")

; ── 5. DATATYPE (ADT / SUM TYPE) ───────────────────────────────────────────
; DREAM: Rung-4 sum types NATIVELY, not integer-coded. A connection is
; (idle | (running Job) | closed); z3 knows the discriminant & payload. "in
; closed, no field access is valid", protocol conformance with real variants.
(probe "ADT: Conn = idle|open(fd Int)|closed; ∃c. is-open(c) ∧ fd(c)=3"
  (str "(declare-datatypes () ((Conn idle (open (fd Int)) closed)))\n"
       "(declare-const c Conn)\n(assert ((_ is open) c))\n(assert (= (fd c) 3))\n") "sat")
(probe "ADT: refute — idle is never open (UNSAT)"
  (str "(declare-datatypes () ((Conn idle (open (fd Int)) closed)))\n"
       "(assert ((_ is open) idle))\n") "unsat")

; ── 6. SET (Array→Bool) ────────────────────────────────────────────────────
; DREAM: capability-set / footprint containment as a THEORY, not a bl every?.
; footprint-in-caps? today folds over a set in bl; as z3 sets it becomes
; "footprint ⊆ caps" with quantified guarantees over ALL resources at once.
(probe "Set: ∃ disjoint nonempty caps A,B (subset/inter as Array Int Bool)"
  (str "(declare-const A (Array Int Bool))\n(declare-const B (Array Int Bool))\n"
       "(assert (= ((_ const Bool) false) ((_ map and) A B)))\n"      ; A∩B = ∅
       "(assert (not (= A ((_ const Bool) false))))\n") "sat")

; ── 7. QUANTIFIERS (∀) ─────────────────────────────────────────────────────
; DREAM: invariants over ALL inputs/indices, not just the ones we enumerate.
; "for every message n, handler preserves inv", "∀ i. sorted a[i]≤a[i+1]" —
; discovery's candidates can carry a ∀, lifting Houdini past ground predicates.
(probe "∀: refute monotonicity of f where f(x)=x+1 is order-preserving (UNSAT)"
  (str "(declare-fun f (Int) Int)\n(assert (forall ((x Int)) (= (f x) (+ x 1))))\n"
       "(assert (exists ((a Int) (b Int)) (and (<= a b) (> (f a) (f b)))))\n") "unsat")

; ── 8. OPTIMIZE (maximize) ─────────────────────────────────────────────────
; DREAM: not just "is it safe" but "what's the TIGHTEST bound". "the largest
; queue depth reachable in k steps", "worst-case balance" — z3 Optimize turns
; a verifier into a bound-SYNTHESISER. Capacity numbers DISCOVERED, not annotated.
(probe "Optimize: maximize x s.t. x≤10 ∧ x≤7 → 7 (sat w/ objective)"
  "(declare-const x Int)\n(assert (<= x 10))\n(assert (<= x 7))\n(maximize x)\n" "sat")

; ── 9. UNINTERPRETED FUNCTIONS ─────────────────────────────────────────────
; DREAM: abstract an opaque operation and STILL prove structure. "we don't know
; what hash does, but equal inputs ⇒ equal outputs" — reason about pure
; unknown effects (the :opaque-world footprint) without modelling their body.
(probe "UF: refute congruence — a=b ⇒ g(a)=g(b), so a=b∧g(a)≠g(b) is UNSAT"
  "(declare-fun g (Int) Int)\n(declare-const a Int)\n(declare-const b Int)\n(assert (= a b))\n(assert (not (= (g a) (g b))))\n" "unsat")

; ── 10. MIXED-THEORY (the real payoff) ─────────────────────────────────────
; DREAM: ONE state model spanning theories at once — a record whose fields are
; {phase: ADT, buffer: Array, count: Int, flags: BitVec, name: String}. z3
; solves them JOINTLY. This is "state ≜ ⟦type-lattice⟧" with the FULL lattice,
; every tag → its natural theory, one solver call.
(probe "MIXED: phase=open ∧ buf[0]=count ∧ count=2 ∧ (flags & 1)=1 — jointly sat"
  (str "(declare-datatypes () ((Ph idle open closed)))\n"
       "(declare-const phase Ph)\n(declare-const buf (Array Int Int))\n"
       "(declare-const count Int)\n(declare-const flags (_ BitVec 8))\n"
       "(assert (= phase open))\n(assert (= (select buf 0) count))\n"
       "(assert (= count 2))\n(assert (= (bvand flags #x01) #x01))\n") "sat")

(println "\n── the point ──")
(println "Every line above went through the UNCHANGED z3/check. The Int-only")
(println "limitation lived in smt.bl's translator, not the solver. Wiring the")
(println "tag lattice → z3 SORT (int→Int, float→Real, bool→Bool, vec→Array/Seq,")
(println "set→Array·Bool, sum→Datatype, string→String) turns each demo into a")
(println "verify-process shape we already ship.")
:ok
