; research/p19_datalog_feed/spike_fixpoint_z3.bl
; ── P19 crux: can the datom fixpoint DRIVE z3 as a predicate mid-recursion? ──
;
; The P18 feeding layer hand-rolls, as string surgery, work that four shipped
; engines already own (typed=STRUCTURE, mk=RELATIONS, datom=codebase-as-data,
; z3=DECISIONS). Before cutting ~180 lines over to datalog, THREE questions must
; be answered by RUNNING, not reasoning:
;
;   Q1 MECHANISM   — does datom.query.rules/derive-semi-naive evaluate a bl
;                    predicate [(pred ?x)] where ?x is a RECURSIVE variable, and
;                    can that predicate call z3? (rules.bl:43 claims this is the
;                    exact program class derive-semi-naive exists for; fixpoint_
;                    test.bl:178 asserts the FALLBACK fires — but never with z3.)
;   Q2 ESTABLISH   — can the establishment filter (keep candidates true at INIT)
;                    be a datalog query whose filter is a z3 predicate? This is a
;                    NON-recursive, MONOTONE filter — the easy half.
;   Q3 HOUDINI     — is the induction fixpoint (drop conjuncts some transition
;                    breaks UNDER THE CURRENT SURVIVOR SET) expressible as datom's
;                    LEAST fixpoint? Or is it inherently a GREATEST fixpoint with
;                    recursion-through-negation (killed depends on ¬killed via the
;                    shrinking antecedent)? This decides whether discovery's LOOP
;                    moves to datalog or stays bl (consuming datom FACTS either way).
;
; Honest expected outcome (to be confirmed/refuted by the run):
;   Q1 ✓  Q2 ✓  Q3 ✗ (greatest-fixpoint ≠ datom's least-fixpoint) — so the
;   feeding FACTS + establishment become datalog; the Houdini ITERATION stays a
;   bl loop over datom-derived candidates. That is still the cutover: the string
;   helpers die; the loop that remains is 8 lines over facts, not a lexer.

(ns p19.spike-fixpoint-z3
  (:require [datom]
            [datom.query.fixpoint :as fp]
            [datom.query.rules :as blr]
            [datom.query.engine :as eng]
            [z3]))

(def port (z3/open))

; eval-plain: the engine's single-clause evaluator, resolving ops in THIS ns so
; our z3 predicates below resolve (same shape as fixpoint_test.bl).
(def eval-plain
  (fn [d b c]
    (eng/eval-clause d b c
                     (fn [op] (try (BeamLisp.Env/fetch! "p19.spike-fixpoint-z3" (name op))
                                   (catch e (try (BeamLisp.Env/fetch! "core" (name op))
                                                 (catch e2 nil)))))
                     {})))

; ── the z3 predicate: "is candidate P inductive one-step from state N?" ─────
; A minimal account machine: state = balance (Int), transition withdraw amt with
; guard (>= amt 0)(>= balance amt) next (- balance amt), and deposit amt guard
; (>= amt 0) next (+ balance amt). We ask z3, per candidate string, whether the
; candidate is preserved by BOTH transitions. This is the DECISION the fixpoint
; would call mid-recursion.

(defn cand-preserved?
  "z3: does candidate `cand` (an SMT pred over `balance`) survive both
   transitions? Assert cand(balance) ∧ guard ∧ balance2=next ∧ ¬cand(balance2);
   unsat for BOTH ⟹ preserved. Returns true/false — a plain bl predicate the
   datalog engine can call on a bound row value."
  [cand]
  (let [prime (fn [s] (join "balance2" (split s "balance")))
        step (fn [guard next]
               (str "(declare-const balance Int)\n(declare-const balance2 Int)\n"
                    "(declare-const amt Int)\n"
                    "(assert " cand ")\n"
                    (if guard (str "(assert " guard ")\n") "")
                    "(assert (= balance2 " next "))\n"
                    "(assert (not " (prime cand) "))\n"))
        dep (z3/check port (step "(>= amt 0)" "(+ balance amt)"))
        wd  (z3/check port (step "(and (>= amt 0) (>= balance amt))" "(- balance amt)"))]
    (and (= "unsat" dep) (= "unsat" wd))))

; a plain-bl truthy predicate usable inside a datalog [(...)] clause.
(defn z3-inductive? [cand] (if (cand-preserved? cand) true false))

; a z3 predicate over an INTEGER recursive variable, for Q1: "is n a fixed point
; of (fn x → x) reachable — i.e. does z3 agree n>=0?" contrived only to prove the
; ENGINE will call z3 on a recursive-bound var.
(defn z3-nonneg? [n]
  (= "unsat" (z3/check port (str "(declare-const n Int)\n(assert (= n " n "))\n(assert (< n 0))\n"))))

; ═══════════════════════════════════════════════════════════════════════
; Q1 — z3 predicate on a RECURSIVE variable inside derive-semi-naive.
;
; Rule: succ-reach grows {n | reachable by +1 from 0, bounded}, FILTERED by a z3
; predicate on the recursive var. If the fixpoint calls z3 per newly-derived n
; and keeps only those z3 approves, the mechanism is proven.
;   base:  (nn ?n)  [?e :seed/val ?n]                 ; seed 0..k as base facts
;   rec :  (nn ?n)  (nn ?m) [(inc ?m) ?n] [(<= ?n 3)] [(p19.../z3-nonneg? ?n)]
; ═══════════════════════════════════════════════════════════════════════

(def SEED-ATTRS [{:db/ident :seed/val :db/valueType :db.type/long}])

(defn q1-db []
  (let [conn (datom/connect SEED-ATTRS)]
    (datom/transact! conn [{:db/id -1 :seed/val 0}])
    (datom/db conn)))

(def Q1-RULES
  '[[(nn ?n) [?e :seed/val ?n]]
    [(nn ?n) (nn ?m) [(inc ?m) ?n] [(<= ?n 3)] [(p19.spike-fixpoint-z3/z3-nonneg? ?n)]]])

(defn q1 []
  (let [db (q1-db)
        r (try (get (blr/derive-semi-naive db Q1-RULES eval-plain) 0)
               (catch e {:error (str e)}))]
    r))

; ═══════════════════════════════════════════════════════════════════════
; Q2 — establishment filter as a NON-recursive datalog query + z3 predicate.
; candidates are base facts; keep those a z3 predicate approves. Monotone, no
; recursion — this should "just work" if a z3 predicate is legal at all.
; ═══════════════════════════════════════════════════════════════════════

(def CAND-ATTRS [{:db/ident :cand/smt :db/valueType :db.type/string}])

(defn q2-db []
  (let [conn (datom/connect CAND-ATTRS)]
    (datom/transact! conn
      [{:db/id -1 :cand/smt "(>= balance 0)"}     ; TRUE inductive
       {:db/id -2 :cand/smt "(>= balance 5)"}     ; false (init 0 breaks est; but here we test INDUCTIVE filter)
       {:db/id -3 :cand/smt "(<= balance 0)"}])   ; false — deposit breaks it
    (datom/db conn)))

(defn q2 []
  (let [db (q2-db)]
    (datom/q '[:find ?smt
               :where [?c :cand/smt ?smt]
                      [(p19.spike-fixpoint-z3/z3-inductive? ?smt)]]
             db)))

; ═══════════════════════════════════════════════════════════════════════
; Q3 — the Houdini INDUCTION as a least-fixpoint? Expose the non-monotonicity.
;
; The precise Houdini step keeps candidate p iff p survives EVERY transition
; UNDER THE CONJUNCTION OF CURRENT SURVIVORS as antecedent. "current survivors"
; = candidates − killed, so "killed(p)" would depend on "¬killed(q)" for the
; other q's in the antecedent → recursion through negation. datom's fixpoint is
; a LEAST fixpoint of MONOTONE rules; it has :not in NON-recursive position only.
;
; This function does NOT try to trick datom into it. It reports the shape so the
; conclusion is explicit: we run the WEAKENED monotone version (antecedent =
; FULL candidate set, no mutual support) as a datalog+z3 fixpoint, and note that
; it is SOUND but less precise than the bl greatest-fixpoint. If the weakened
; version already finds (>= balance 0) on this machine, datalog suffices HERE;
; the bl loop is only needed when mutual support matters.
; ═══════════════════════════════════════════════════════════════════════

; weakened: inductive with NO antecedent (each candidate alone). This is exactly
; z3-inductive? above → so the "discovered set" under weakening = q2's result.
(defn q3-weakened []
  (into [] (map (fn [t] (first t)) (q2))))

; ── run all three ──────────────────────────────────────────────────────────
(defn run []
  (let [r1 (q1)
        r2 (into [] (map (fn [t] (first t)) (q2)))
        r3 (q3-weakened)]
    (println "Q1 z3-predicate-on-recursive-var →" (get r1 'nn))
    (println "   (expect a bounded set {0,1,2,3}; :error map = mechanism FAILS)")
    (println "Q2 establishment/inductive filter as datalog+z3 →" r2)
    (println "   (expect [\"(>= balance 0)\"] only)")
    (println "Q3 weakened-Houdini (no mutual support) discovers →" r3)
    (println "   (if it contains (>= balance 0), datalog+z3 suffices for THIS machine)")
    {:q1 (get r1 'nn) :q2 r2 :q3 r3}))

(run)
