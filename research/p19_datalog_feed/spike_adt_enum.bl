; research/p19_datalog_feed/spike_adt_enum.bl
; ══════════════════════════════════════════════════════════════════════════
; R1a — NATIVE ENUM VARIANTS. Design validation before wiring into core.bl.
;
; Today (Rung 4) a variant is hand-encoded as an integer: idle=0, open=1,
; closed=2, and you write (= phase 1) with a comment saying "1 means open".
; z3 has a DATATYPE theory: declare the variant universe once, then compare
; against named constructors. You write (= phase :open); no legend, no drift.
;
; This spike generates, BY HAND, the SMT a functor would emit for the
; connection protocol, and proves: (1) the good machine's session-type
; invariant holds, (2) a use-after-close bug is caught — over the datatype,
; not an integer code.
;
; The machine (what you'd WRITE):
;   ^{:invariant (or (not sending) (= phase :open))}
;   init                     {:phase :idle   :sending false}
;   open  :when (= phase :idle)    {:phase :open   :sending false}
;   send  :when (= phase :open)    {:phase :open   :sending true}
;   close :when (= phase :open)    {:phase :closed :sending false}
;
; DESIGN RULES (each forced by a z3 fact, probed):
;   · constructors are SORT-PREFIXED (Phase-open) — bare `open` collides across
;     datatypes ("ambiguous constant reference"); prefixing is unconditional.
;   · the universe {idle open closed} is GATHERED from every keyword that
;     mentions the field (init + next + guards + invariant) — user's choice.
;   · a keyword literal :open → the constructor Phase-open, wherever it appears.
; ══════════════════════════════════════════════════════════════════════════

(ns p19.spike-adt-enum (:require [z3]))

(def port (z3/open))

; ── what the functor would emit ────────────────────────────────────────────
; the datatype declaration for field `phase`, universe {idle open closed}:
(def phase-decl "(declare-datatypes () ((Phase Phase-idle Phase-open Phase-closed)))\n")

; the invariant as a define-fun over the sorted state (phase:Phase, sending:Bool).
; :open in the invariant → Phase-open. Everything else is ordinary bool logic.
(def inv-def
  (str "(define-fun Inv ((phase Phase) (sending Bool)) Bool "
       "(or (not sending) (= phase Phase-open)))\n"))

; a transition preservation check, native-datatype flavour: assert Inv(s) ∧
; guard ∧ s2=next ∧ ¬Inv(s2); unsat ⟹ preserved. The state is (phase, sending);
; priming declares phase2/sending2; guards/nexts use prefixed constructors.
(defn preserved? [guard phase-next sending-next]
  (let [smt (str phase-decl inv-def
                 "(declare-const phase Phase)\n(declare-const sending Bool)\n"
                 "(declare-const phase2 Phase)\n(declare-const sending2 Bool)\n"
                 "(assert (Inv phase sending))\n"
                 (if guard (str "(assert " guard ")\n") "")
                 "(assert (= phase2 " phase-next "))\n"
                 "(assert (= sending2 " sending-next "))\n"
                 "(assert (not (Inv phase2 sending2)))\n")]
    (= "unsat" (z3/check port smt))))

; establishment: init {:phase :idle :sending false} establishes Inv?
(defn established? []
  (= "unsat" (z3/check port
               (str phase-decl inv-def
                    "(assert (not (Inv Phase-idle false)))\n"))))

(println "── R1a: native enum protocol, over z3's datatype theory ──\n")

; the GOOD machine — three legal transitions, all preserve the session type.
(def good
  (and (established?)
       (preserved? "(= phase Phase-idle)" "Phase-open"   "false")   ; open
       (preserved? "(= phase Phase-open)" "Phase-open"   "true")    ; send
       (preserved? "(= phase Phase-open)" "Phase-closed" "false"))) ; close
(println "good protocol — established + all transitions preserve  :" good)
(println "  (sending ⇒ phase = Phase-open, proven over the datatype)")

; the BUG — a :send fired from :closed, setting sending=true while closed.
(def bug (preserved? "(= phase Phase-closed)" "Phase-closed" "true"))
(println "use-after-close preserved? (want false = caught)        :" bug)
(println "  z3 finds phase=Phase-closed ∧ sending=true — the counterexample.")

; sanity: the discriminant / no-junk property — a Phase is EXACTLY one of three.
(def exhaustive
  (= "unsat" (z3/check port
               (str phase-decl "(declare-const p Phase)\n"
                    "(assert (not (or (= p Phase-idle) (= p Phase-open) (= p Phase-closed))))\n"))))
(println "\nexhaustive — a Phase is exactly one of {idle,open,closed}   :" exhaustive)
(println "  (the datatype theory gives this for free; an Int encoding must")
(println "   assert 0 ≤ phase ≤ 2 by hand and can still leak phase=99.)")

(println "\n── what this buys over the integer encoding ──")
(println "  · you write :open, not 1 — no legend, nothing to drift")
(println "  · the universe is closed: no phase=99 to reason away")
(println "  · discriminants/accessors (payload variants) are the same theory,")
(println "    the next slice (R1b): (running j) → (Phase-running j), (job c).")
:ok
