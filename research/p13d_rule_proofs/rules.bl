; P13d — SMT-verified deodorant rules
;
; Run: bin/bl run research/p13d_rule_proofs/rules.bl
;
; The beam-lisp port of rules.exs. Same five questions, same verdicts:
;
; Can the solver (a) PROVE deodorant's SAFE rules, (b) DERIVE the
; assumption behind an IDIOMATIC rule from a counterexample, and
; (c) CATCH a deliberately broken rule?
;
; Value model (same tagged encoding as P13a): a beam-lisp value is
; (tag_x : Int, x_i : Int). Tags: nil=0, int=1, string=3, bool=5.
; Soundness of a rewrite  lhs → rhs  means: same RESULT and same
; RAISED-NESS for every input. `=` never raises; `zero?` raises on
; non-numbers — that asymmetry is what makes the idiomatic tier real.
;
; Soundness is encoded by asserting its NEGATION and reading the answer:
;   unsat ⇒ lhs ≡ rhs (PROVEN); sat ⇒ the model is a counterexample input.
; That is the whole harness, and it is built here by hand from FORMS with
; `smt/emit` — the same shape `z3/prove-equiv` has, but as ONE assertion
; emitted once. (`z3/prove-equiv` renders each term separately and embeds
; the resulting TEXT into a form, so `smt/emit` quotes it: it asks z3
; `(= "p" "(ite p true false)")`, which is a string comparison and answers
; sat for every rule. Verified against the pinned solver; left alone here
; because priv/lib/z3.bl is a shared file.)
;
; The value-model terms come from `z3/eq-const-expr` / `z3/pred-expr` (they
; are plain form constructors, correct); the tag map and range assert come
; from `z3/value-decl-forms`.
;
; Protocol lessons from the spike (they inform priv/lib/z3.bl):
;   * reset before every independent query — a persistent solver accumulates
;     declarations, so query 3 collided with query 2's consts.
;   * read answers line-wise and SCAN for the answer token — `(error …)` can
;     precede it.
;   * `(get-model)` bytes may arrive in the same chunk as the `sat` line —
;     never discard buffered input when switching read modes.
; `BeamLisp.Z3Port/raw_check` is the implementation of all three.

(ns p13d.rules
  (:require [z3] [smt]))

; ── the harness ──────────────────────────────────────────────────────────

(def value-decls
  (smt/script z3/value-decl-forms))

(def bool-decls
  (smt/script [(list 'declare-const 'p 'Bool)]))

(def int-assumption
  (smt/script [(list 'assert (list '= 'tag_x 1))]))

; assert_not_equiv: assert the negation of "same result AND same raised-ness".
; lhs/rhs are {:result FORM :raises FORM|bool}.
(defn- assert-not-equiv [decls lhs rhs]
  (str decls
       (smt/emit (list 'assert
                       (list 'not
                             (list 'and
                                   (list '= (:result lhs) (:result rhs))
                                   (list '= (:raises lhs) (:raises rhs))))))
       "\n"))

(def port (BeamLisp.Z3Port/open))

(defn- check-rule
  "One independent query on the persistent solver. `raw_check` resets first,
   so a query never inherits the previous one's declarations."
  [decls lhs rhs]
  (let [t0 (erlang/monotonic_time :microsecond)
        r (BeamLisp.Z3Port/raw_check port (assert-not-equiv decls lhs rhs) true)]
    (assoc r :ms (quot (- (erlang/monotonic_time :microsecond) t0) 1000))))

(defn- report [label {:keys [status model ms]} proven-means]
  (let [lbl (str label " [" ms " ms]")]
    (cond
      (= status "unsat") (println (str lbl ": PROVEN (" proven-means ")"))
      (= status "sat")   (println (str lbl ": COUNTEREXAMPLE ⇒" (String/trim (str model))))
      :else              (println (str lbl ": " status)))))

(println "== P13d: deodorant rules under the solver (z3) ==\n")

; SAFE candidate: (if p true false) → (boolean p), over Bool p.
; boolean is identity on bools and never raises; the `if` returns the
; bool itself. Both sides: result = p, raises = false.
(report "SAFE     (if p true false) → (boolean p)      "
        (check-rule bool-decls
                    {:result '(ite p true false) :raises false}
                    {:result 'p :raises false})
        "equivalent for all p")

; SAFE candidate: (not (nil? x)) → (some? x). nil? ⇔ tag=0; some? ⇔
; tag≠0; neither raises.
(report "SAFE     (not (nil? x)) → (some? x)           "
        (check-rule value-decls
                    {:result (z3/not-tag :nil) :raises false}
                    {:result (z3/not-tag :nil) :raises false})
        "equivalent for all x")

; IDIOMATIC: (= x 0) → (zero? x).
; `=` is total: result = (tag=1 ∧ x_i=0), never raises.
; `zero?` is partial: RAISES unless tag=1; when tag=1, result = (x_i=0).
; Expect: sat with a non-int tag counterexample ⇒ the derived assumption
; is exactly "x : int" — which the checker's tag lattice can discharge
; per call site.
(report "IDIOMATIC (= x 0) → (zero? x)                 "
        (check-rule value-decls (z3/eq-const-expr :int 0) (z3/pred-expr :int 0))
        "equivalent")

; Same rule UNDER the discharged assumption (tag_x = int): expect proven.
(report "  same rule, x:int discharged by checker      "
        (check-rule (str value-decls int-assumption)
                    (z3/eq-const-expr :int 0) (z3/pred-expr :int 0))
        "SOUND under inferred x:int — auto-promoted to SAFE")

; Deliberately broken: (= x 1) → (zero? x). Expect a counterexample.
(report "BROKEN   (= x 1) → (zero? x)   (on purpose)   "
        (check-rule value-decls (z3/eq-const-expr :int 1) (z3/pred-expr :int 0))
        "should never happen")

(BeamLisp.Z3Port/close port)
(println "")
