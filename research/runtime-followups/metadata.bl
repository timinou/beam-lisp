(ns research.runtime-followups.metadata (:require [research.runtime-followups.common :as c] [env]))
(defn captured-definitions [f]
 (let [me (erlang/self)
       tracer (erlang/spawn (fn []
        (loop [names #{}]
         (receive [:trace _ :call mfa]
           (let [args (elem mfa 2)] (recur (conj names [(first args) (second args)])))
          :finish (erlang/send me [:captured names])
          _ (recur names)))))
       pattern (tuple :Elixir.BeamLisp.Env :put_ns_definition 3)]
  (erlang/trace_pattern pattern true (list :local))
  (erlang/trace me true (list :call (tuple :tracer tracer)))
  (try (f)
   (finally
    (erlang/trace me false (list :call))
    (erlang/trace_pattern pattern false (list :local))
    (erlang/trace_delivered me)
    (receive [:trace_delivered _ _] nil (after 5000 (throw :trace-timeout)))
    (erlang/send tracer :finish)))
  (receive [:captured names] names (after 5000 (throw :capture-timeout)))))
(defn run []
 (let [e (BeamLisp.Env/fork :global) ns "followups.tracked.fixture"]
  (try
   (BeamLisp.Env/with_env e
    (fn []
     (let [capture (c/measure (fn [] (captured-definitions
                       (fn [] (env/eval "(ns followups.tracked.fixture) (defmacro make [] '(defn generated [x] (+ x 1))) (defn ordinary [x] x) (make)")))))
           names (set (map second (filter (fn [[n _]] (= ns n)) (:value capture))))
           definitions (BeamLisp.Env/ns_defs ns)]
      (c/need "observer captures macro-generated definition" (contains? names "generated"))
      (c/need "lexical-only negative control loses generated" (not= (select-keys definitions ["ordinary"]) (select-keys definitions names)))
      (c/emit :metadata-capture (assoc capture :value (vec (sort names))))
      (doseq [size [128 2048]]
       (BeamLisp.Env/put_ns_defs ns
        (merge (into {} (map (fn [i] [(str "inherited-" i) (vec (repeat 24 {:ast (String/duplicate "x" 64)}))]) (range size))) definitions))
       (doseq [variant c/schedule]
        (let [sample (c/measure (fn []
               (reduce + (mapv (fn [_]
                (let [selected (if (= variant :baseline)
                      (select-keys (BeamLisp.Env/ns_defs ns) names)
                      (BeamLisp.Env/selected_ns_definitions ns names))]
                 (c/need "same definitions" (= (select-keys definitions names) selected))
                 (count selected))) (range 100)))))]
         (c/emit :metadata (assoc sample :variant variant :inherited size :selected (count names) :operations 100))))))))
   (finally (BeamLisp.Env/destroy e)))))
