(ns followups.application-aot (:require [bl.json :as json] [build :as build]))
(def mode (System/get_env "FOLLOWUP_MODE"))
(def root (System/get_env "FOLLOWUP_ROOT"))
(def src (str root "/source"))
(def out (str root "/package/ebin"))
(def targets ["knowledger.dates" "followups.fixture.application"])
(defn total-reductions [] (elem (erlang/statistics :reductions) 0))
(defn emit [record] (println (str "FOLLOWUP_JSON " (json/encode record))))
(if (= mode "build")
 (let [files (sort (Path/wildcard (str src "/**/*.bl")))
       t (erlang/monotonic_time :microsecond) r (total-reductions)
       result (BeamLisp.Loader/with_search_dir src
                (fn [] (build/run {:sources files :out out :jobs 1 :force? true})))
       build-us (- (erlang/monotonic_time :microsecond) t)
       build-reductions (- (total-reductions) r)]
  (assert (empty? (:errors result)))
  (emit {:mode mode :built (:built result) :us build-us :reductions build-reductions
         :compiler (BeamLisp.AOTCache/compiler_key) :files (count files)})
  (let [again (BeamLisp.Loader/with_search_dir src
                (fn [] (build/run {:sources files :out out :jobs 1}))) ]
   (assert (empty? (:errors again)))
   (emit {:mode :noop :built (:built again) :errors (:errors again)})
   (assert (= 0 (:built again)))))
 (do
  (when (= mode "artifact") (Code/prepend_path out))
  (let [pattern (tuple :Elixir.BeamLisp.Compiler :eval_string 3)]
   (erlang/trace_pattern pattern true (list :call_count))
   (let [t (erlang/monotonic_time :microsecond) r (total-reductions)
         run (fn [] (doseq [ns targets] (BeamLisp.Loader/ensure_loaded ns)))
         _ (if (= mode "source") (BeamLisp.Loader/with_search_dir src run) (run))
         us (- (erlang/monotonic_time :microsecond) t)
         reductions (- (total-reductions) r)
         calls (elem (erlang/trace_info pattern :call_count) 1)
         answer (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! "followups.fixture.application" "answer") (list))
         locales (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! "knowledger.i18n" "locales") (list))]
    (emit {:mode :diagnostic :answer answer :calls calls :value (System/get_env "FOLLOWUP_VALUE") :locales locales})
    (assert (= [(System/get_env "FOLLOWUP_VALUE") 255] answer))
    (assert (= [:en :fr] locales))
    (run)
    (assert (= 1 (count (String/split (String/trim (File/read! (System/get_env "FOLLOWUP_MARK"))) "\n"))))
    (when (= mode "artifact") (assert (= 0 calls))
      (assert (nil? (BeamLisp.Loader/source_content "followups.fixture.application"))))
    (when (= mode "source") (assert (> calls 0)))
    (emit {:mode mode :us us :reductions reductions :eval-string-calls calls
           :answer answer :locales locales :memory-bytes (erlang/memory :total)})))))
