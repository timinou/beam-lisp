(ns research.runtime-followups.logic (:require [research.runtime-followups.common :as c] [veritas :as v] [z3]))
(defn run []
 (let [port (z3/open)
       flags (v/tuple-of (v/bool-of) (v/bool-of) (v/bool-of) (v/bool-of))
       checks {:admitted-always-drains (v/for-all port "x" flags '(or (not x_2) (or x_2 (and x_0 x_1))))
               :dead-unadmitted-never-starts (v/for-all port "x" flags '(or x_0 x_2 (not (or x_2 (and x_0 x_1)))))
               :no-retirement-with-lease (v/for-all port "x" flags '(or (not x_3) (not (and (not x_3) (not x_2)))))
               :unsafe-lexical-tracker-counterexample (v/exists port "x" flags '(and x_0 (not x_1)))}]
  (doseq [[label verdict] checks]
   (c/need (str "finite logic " label) (= :proven (:modality verdict)))
   (c/emit :logic {:claim label :modality (:modality verdict) :engine (:engine verdict)})))))
