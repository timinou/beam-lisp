(ns followups.application-negative)
(def root (System/get_env "FOLLOWUP_ROOT"))
(Code/prepend_path (str root "/package/ebin"))
(def refused (try
 (BeamLisp.Loader/with_search_dir (str root "/source")
  (fn [] (BeamLisp.Loader/ensure_loaded "followups.fixture.application")))
 false
 (catch e
  (let [message (Kernel/inspect e)]
   (println message)
   (String/contains? message "stale AOT beam for followups.fixture.application")))))
(assert refused)
(assert (not (File/exists? (System/get_env "FOLLOWUP_MARK"))))
(println "FOLLOWUP_STALE_SOURCE_REFUSED_BEFORE_INITIALIZER")
