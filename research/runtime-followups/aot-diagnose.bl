(ns followups.aot-diagnose (:require [build-plan :as p] [bl.json :as json]))
(def root (System/get_env "FOLLOWUP_ROOT"))
(def src (str root "/source"))
(BeamLisp.Loader/with_search_dir src
 (fn []
  (let [files (sort (Path/wildcard (str src "/**/*.bl")))
        nodes (mapv (fn [path] (p/node-from path (BeamLisp.Loader/read_source path))) files)
        plan (p/plan nodes)]
   (doseq [ns ["followups.fixture.application" "followups.fixture.leaf" "knowledger.dates" "knowledger.i18n"]]
    (let [path (BeamLisp.Loader/source_path ns)
          same (p/key-for ns (fn [n] (BeamLisp.Loader/source_content n)) nil)
          memo (BeamLisp.AOT/ns_closure_hash ns path)]
     (println (str "FOLLOWUP_JSON " (json/encode {:ns ns :path path :planned (get (:key plan) path)
                  :computed same :aot memo :header (:reqs (p/node-from path (File/read! path)))}))))))))
