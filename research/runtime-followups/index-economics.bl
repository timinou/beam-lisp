(ns research.runtime-followups.index-economics
 (:require [research.runtime-followups.common :as c] [datom :as d] [datom.db :as db]
           [datom.conn :as conn] [datom.store-fjall :as fjall]
           [datom.query.rank-plan :as plan] [datom.query.rank-index :as rank]))
(def schema [{:db/ident :item/scope :db/valueType :db.type/ref}
             {:db/ident :item/order :db/valueType :db.type/long}
             {:db/ident :item/name :db/valueType :db.type/string}])
(def query '[:find ?e ?at ?name :in $ ?scope :where [?e :item/scope ?scope] [?e :item/order ?at] [?e :item/name ?name]])
(defn run []
 (doseq [size [100 1000]]
  (let [root (str (System/tmp_dir!) "/rank-economics-" (erlang/unique_integer (list :positive)))
        s (fjall/open root) conn (d/connect-with s schema)]
   (try
    (d/transact! conn (mapv (fn [i] {:db/id i :item/scope 7 :item/order i :item/name (str i)}) (range 1 (inc size))))
    (let [database (d/db conn) offset (- size 10)
          expected (subvec (vec (sort-by second (d/q query database 7))) offset size)
          descriptor (plan/descriptor query (db/schema-of database) [7] ['?at :asc])
          id (conn/ensure-query-rank! conn descriptor)
          built (c/measure (fn []
           (loop [steps 0 max-step 0]
            (c/need "bounded rank build" (< steps 2000))
            (let [t (erlang/monotonic_time :microsecond) h (conn/advance-query-rank! conn id)
                  step (- (erlang/monotonic_time :microsecond) t)]
             (if (= :building (:status h)) (recur (inc steps) (max max-step step))
              (do (c/need "complete index" (= :complete (:status h)))
               {:steps (inc steps) :max-writer-step-us (max step max-step) :members (:members h)}))))))]
     (c/emit :index-build (assoc built :entities size))
     (doseq [variant c/schedule]
      (let [sample (c/measure (fn []
         (reduce + (mapv (fn [_]
          (let [rows (if (= variant :baseline)
                       (subvec (vec (sort-by second (d/q query database 7))) offset size)
                       (:rows (rank/read-page database id descriptor offset 10)))]
           (c/need "deep-page parity" (= expected rows)) (count rows))) (range 10)))))]
       (c/emit :index-read (assoc sample :variant variant :entities size :operations 10))))
     (let [sample (c/measure (fn []
             (doseq [i (range 1 11)] (d/transact! conn [{:db/id i :item/name (str "updated-" i)}])) 10))]
      (c/emit :index-maintained-writes (assoc sample :entities size :operations 10))))
    (finally (d/close! conn) (File/rm_rf! root))))))
