(ns research.runtime-followups.run
 (:require [research.runtime-followups.common :as c]
           [research.runtime-followups.metadata :as metadata]
           [research.runtime-followups.realm :as realm]
           [research.runtime-followups.dependencies :as dependencies]
           [research.runtime-followups.index-economics :as economics]
           [research.runtime-followups.lifetimes :as lifetimes]
           [research.runtime-followups.logic :as logic]))
(doseq [[label f] [[:metadata metadata/run] [:realm realm/run] [:dependencies dependencies/run]
                  [:index-economics economics/run] [:lifetimes lifetimes/run] [:logic logic/run]]]
 (println (str "FOLLOWUP_START " label))
 (f)
 (println (str "FOLLOWUP_PASS " label)))
