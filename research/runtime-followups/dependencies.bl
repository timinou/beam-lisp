(ns research.runtime-followups.dependencies
 (:require [research.runtime-followups.common :as c]
           [research.structural.dependencies :as dep] [datom :as d]
           [datom.profile :as profile] [datom.store-ets :as store]))
(def schema [{:db/ident :p/name :db/valueType :db.type/string}
             {:db/ident :p/score :db/valueType :db.type/long}
             {:db/ident :p/audit :db/valueType :db.type/string}
             {:db/ident :p/absent :db/valueType :db.type/string}])
(defn run []
 (doseq [size [100 1000]]
  (let [s (profile/watch (store/open)) conn (d/connect-with s schema)]
   (try
    (d/transact! conn (mapv (fn [i] {:db/id i :p/name (str "n" i) :p/score i}) (range 1 (inc size))))
    (let [cached (dep/project nil s (d/db conn) [:p/name :p/score] [:p/absent] 0)]
     (d/transact! conn [{:db/id (+ size 1) :p/audit "unrelated"}])
     (doseq [variant c/schedule]
      (let [before (:rows (profile/counters s))
            sample (c/measure (fn []
             (reduce + (mapv (fn [_]
               (let [r (dep/project (when (= variant :candidate) cached) s (d/db conn) [:p/name :p/score] [:p/absent] 0)]
                (c/need "projection equality" (= (:rows cached) (:rows r))) (count (:rows r)))) (range 20))))]
       (c/emit :dependencies (assoc sample :variant variant :entities size :operations 20
                              :store-rows (- (:rows (profile/counters s)) before)))))
     (d/transact! conn [{:db/id 1 :p/score -1}])
     (let [r (dep/project cached s (d/db conn) [:p/name :p/score] [:p/absent] 0)]
      (c/need "relevant write refuses reuse" (not (:reused? r)))
      (d/transact! conn [{:db/id 1 :p/absent "now present"}])
      (c/need "negative read invalidates after insertion" (not (:reused? (dep/project r s (d/db conn) [:p/name :p/score] [:p/absent] 0)))))
     (c/emit :dependency-controls {:relevant-write :passed :negative-read :passed :size size} ))
    (finally (d/close! conn))))))
