(ns research.runtime-followups.realm
 (:require [research.runtime-followups.common :as c] [compiler :as compiler]
           [system.footprint :as footprint] [codebase] [typed] [system.ir :as ir]))
(defn run []
 (let [root (str (System/tmp_dir!) "/realm-admission-" (erlang/unique_integer (list :positive)))
       ns "followups.realm.fixture" file (str root "/followups/realm/fixture.bl")
       macro-source "(defmacro make [] '(defn computed [x] (+ x 7))) (make)"
       plain "(defn computed [x] (+ x 7))"
       prefix (str "(ns " ns ") (def setting (System/get_env \"FOLLOWUP_REALM_VALUE\")) ")
       suffix (str (join "\n" (map (fn [i] (str "(defn f" i " [x] (+ x " i "))")) (range 64))) "\n(defn answer [] [setting (computed 0)])")
       original (str prefix macro-source suffix) expanded (str prefix plain suffix)
       macro-digest (Base/encode16 (crypto/hash :sha256 macro-source))
       realm-key (str "Followup" (subs macro-digest 0 12))
       pure (compiler/compile-node (BeamLisp.Reader/read_one "(fn [x] (+ x 7))") (compiler/new-env "user"))
       effectful (compiler/compile-node (BeamLisp.Reader/read_one "(fn [] (File/write! \"never-executed\" \"effect\"))") (compiler/new-env "user"))
       analysis (c/measure (fn [] {:pure (footprint/pure? (footprint/fp-fn-body (if (ir/self-scaffold? pure) (ir/scaffold-inner pure) pure)))
                                  :effect (footprint/pure? (footprint/fp-fn-body (if (ir/self-scaffold? effectful) (ir/scaffold-inner effectful) effectful)))
                                  :functions (count (:fn (codebase/index-source (typed/sigs-from-env "core") ns expanded)))}))]
  (File/mkdir_p! (Path/dirname file))
  (c/need "pure expanded function admitted by footprint" (:pure (:value analysis)))
  (c/need "effectful expansion refused" (not (:effect (:value analysis))))
  (c/need "current finite admission declines macro source" (not (BeamLisp.AOT/local_cacheable_source? original)))
  (c/need "expanded closed source is admitted" (BeamLisp.AOT/local_cacheable_source? expanded))
  (c/emit :realm-analysis analysis)
  (try
   (File/write! file expanded)
   ;; Warm an admitted artifact, then measure fresh target environments.
   (doseq [variant (cons :candidate c/schedule)]
    (let [e (BeamLisp.Env/fork :global) value (str (erlang/unique_integer (list :positive)))]
     (File/write! file (if (= variant :baseline) original expanded))
     (System/put_env "FOLLOWUP_REALM_VALUE" value)
     (System/put_env "BEAM_LISP_AOT_REPAIR" (if (= variant :baseline) "off" "on"))
     (try
      (BeamLisp.Env/with_env e
       (fn []
        (BeamLisp.Env/put_key (tuple :realm_key) realm-key)
        (BeamLisp.Env/put_key (tuple :realm_decl) {:shadow [] :uses {}})
        (BeamLisp.Loader/with_search_dir root
         (fn []
          (let [sample (c/measure (fn [] (BeamLisp.Loader/ensure_loaded ns)
                        (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! ns "answer") (list))))]
           (c/need "fresh env value and function parity" (= [value 7] (:value sample)))
           (c/emit :realm (assoc sample :variant variant :macro-authority macro-digest)))))))
      (finally (BeamLisp.Env/destroy e)))))
   (finally (System/delete_env "BEAM_LISP_AOT_REPAIR")
            (System/delete_env "FOLLOWUP_REALM_VALUE") (File/rm_rf! root)))))
