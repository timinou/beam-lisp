; census.bl — count canonical :op/:pop nodes over successfully compiled source.
; Compiles every top-level form of boot+std+lib+examples with compiler.bl
; and tallies node op/pop kinds from the bl-ANF output.
; :lit and :plit nodes are counted but their :val fields are never descended
; into — those contain raw data (numbers, atoms, binaries, tuples), not grammar.
(ns census (:require [compiler :as c]))
(defn wildcard [pat]
  (map (fn [cs] (erlang/list_to_binary cs))
       (filelib/wildcard (erlang/binary_to_list pat))))
(def files
  (to-list (concat
    (wildcard "priv/boot/*.bl")
    (wildcard "priv/std/*.bl")
    (wildcard "priv/std/**/*.bl")
    (wildcard "priv/lib/*.bl")
    (wildcard "priv/lib/**/*.bl")
    (wildcard "examples/**/*.bl"))))

(def counts (atom {}))
(def ok (atom 0))
(def fails (atom 0))

(defn count-nodes!
  "Walk an ANF/pattern node tree, incrementing :op/:pop kind counts.
   :lit/:plit are counted but never descended into: their :val is raw data,
   not grammar, and recursing into it would miscount non-node values."
  [x]
  (cond
    (and (map? x) (contains? x :op))
      (let [k (:op x)]
        (swap! counts (fn [m] (assoc m k (+ 1 (get m k 0)))))
        (when (not= :lit k)
          (doseq [ki (maps/keys x)] (count-nodes! (get x ki)))))
    (and (map? x) (contains? x :pop))
      (let [k (:pop x)]
        (swap! counts (fn [m] (assoc m k (+ 1 (get m k 0)))))
        (when (not= :plit k)
          (doseq [ki (maps/keys x)] (count-nodes! (get x ki)))))
    (map? x)
      (doseq [ki (maps/keys x)] (count-nodes! (get x ki)))
    (BeamLisp.RT/vector? x)
      (doseq [v (BeamLisp.Vector/to_list x)] (count-nodes! v))
    (erlang/is_list x)
      (doseq [v x] (count-nodes! v))
    (erlang/is_tuple x)
      (doseq [v (erlang/tuple_to_list x)] (count-nodes! v))
    :else nil))

(defn try-file [f]
  (let [src (BeamLisp.Loader/read_source f)
        forms (BeamLisp.Reader/read_string src f)]
    (doseq [form forms]
      (try
        (let [env (assoc (c/new-env "user") :ns "user")
              node (c/compile form env)]
          (count-nodes! node)
          (swap! ok inc))
        (catch e (swap! fails inc))))))

(doseq [f files] (try-file f))
(println "compiled ok:" (deref ok) "  compile-fails:" (deref fails))
(println "\n:op/:pop node counts (canonical ANF grammar):")
(doseq [[k n] (sort-by (fn [[_ n]] (- n)) (to-list (deref counts)))]
  (println "  " k n))
