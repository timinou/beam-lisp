; census.bl — compile every top-level form of the boot+std tiers with
; compiler.bl, try ce1/lower on the result, and tally what lower rejects.
(ns census (:require [ce1] [compiler :as c]))
(defn wildcard [pat] (map (fn [cs] (erlang/list_to_binary cs)) (filelib/wildcard (erlang/binary_to_list pat))))
(def files (to-list (concat (wildcard "priv/boot/*.bl") (wildcard "priv/std/*.bl") (wildcard "priv/std/**/*.bl") (wildcard "priv/lib/*.bl") (wildcard "priv/lib/**/*.bl") (wildcard "examples/**/*.bl"))))
(def fails (atom {}))
(def ok (atom 0))
(defn tag-of [node]
  (cond (and (tuple? node) (= 3 (tuple-size node)) (erlang/is_atom (elem node 0))) (elem node 0)
        (tuple? node) (str "tuple/" (tuple-size node))
        :else (type node)))
(defn try-file [f]
  (let [src (File/read! f)
        forms (BeamLisp.Reader/read_string src f)
        ns-name (atom "user")]
    (doseq [form forms]
      (try
        (let [env (assoc (c/new-env (deref ns-name)) :ns (deref ns-name))
              q (c/compile form env)]
          ; track ns switches so later forms resolve
          (when (and (tuple? form) (= :list (elem (rn-form form) 0))) nil)
          (try (do (ce1/lower q) (swap! ok inc))
               (catch e
                 (let [d (ex-data e) node (and (map? d) (:node d))]
                   (swap! fails (fn [m] (let [k (tag-of node)] (assoc m k (cons [f (pr-str-short node)] (get m k (list)))))))))))
        (catch e (swap! fails (fn [m] (assoc m :COMPILE-ERR (cons [f (pr-str-short (if (map? e) (:message e) e))] (get m :COMPILE-ERR (list)))))))))))
(defn rn-form [n] (if (and (tuple? n) (= :meta (elem n 0))) (elem n 1) n))
(defn pr-str-short [x] (let [s (pr-str x)] (if (> (count s) 140) (subs s 0 140) s)))
(doseq [f files] (try-file f))
(println "lowered ok:" (deref ok))
(doseq [[k vs] (sort-by (fn [[k vs]] (- (count vs))) (to-list (deref fails)))]
  (println "\n──" k (count vs))
  (doseq [[f s] (take 3 vs)] (println "  " f "\n     " s)))
