; bench.bl — canonical compile and emission latency, honest labels.
; Measures source→ANF compile time and ANF→.beam emission time.
; Same source for both passes. N repetitions each. µs/form output.
; No quoted backend, no Elixir-path label.
(ns bench (:require [compiler :as c] [lower :as lo] [anf :as anf]))
(defn now [] (erlang/monotonic_time :microsecond))
(defn time-n [n f]
  (let [t0 (now)]
    (loop [i 0] (when (< i n) (f) (recur (inc i))))
    (quot (- (now) t0) n)))
(def src "(loop [i 0 acc 0] (if (< i 10) (recur (+ i 1) (+ acc i)) acc))")
(def kenv (assoc (c/new-env "user") :ns "user"))
(def n 200)
(def counter (atom 0))
(defn fresh-mod []
  (erlang/binary_to_atom (str "bl_bench_" (swap! counter inc))))
(defn do-compile []
  (c/compile (BeamLisp.Reader/read_one src) kenv))
;; Compile once to ANF for repeated emission timing
;; (emission measures descriptor→beam, not compile→beam).
(def anf-node (do-compile))
(defn do-emit []
  (let [m (fresh-mod)
        cl {:op :defn-clause :fname :run :params (list) :guard nil :body anf-node :ann {}}
        descriptor (anf/module m (list cl) (list [:run 0]) (list))]
    (lo/descriptor->beam descriptor)
    nil))
;; Warm-up
(do-compile) (do-emit)
(println "form:" src)
(println "  compile source→ANF:   " (time-n n do-compile) "µs")
(println "  emit    ANF→.beam:    " (time-n n do-emit) "µs")
