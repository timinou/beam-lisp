; bench.bl — per-form backend latency: Elixir quoted→beam vs Core→beam.
; Same quoted tree in, module built+loaded out, N reps, µs per form.
(ns bench (:require [ce1]))
(defn now [] (erlang/monotonic_time :microsecond))
(defn time-n [n f] (let [t0 (now)] (loop [i 0] (when (< i n) (f) (recur (inc i)))) (quot (- (now) t0) n)))
(def src "(loop [i 0 acc 0] (if (< i 10) (recur (+ i 1) (+ acc i)) acc))")
(def q (ce1/quoted-of src))
(def n 200)
(def core (ce1/lower q))
;; Elixir path: what eval_form does — a throwaway module via Module.create
(defn elixir-build []
  (let [m (erlang/binary_to_atom (str "Elixir.BeamLisp.Eval.B" (swap! ce1/counter inc)))]
    (BeamLisp.Emit/build_module m (erlang/list_to_tuple (list :def (list) (list (erlang/list_to_tuple (list :run (list) (list))) (list (erlang/list_to_tuple (list :do q)))))) nil)
    (code/purge m) (code/delete m)))
;; Core path: compile/forms from_core + load_binary
(defn core-build []
  (let [m (erlang/binary_to_atom (str "bl_ce_b" (swap! ce1/counter inc)))]
    (ce1/load-module! (ce1/expr->module m core))
    (code/purge m) (code/delete m)))
(elixir-build) (core-build)
(println "form:" src)
(println "  lower quoted→cerl:      " (time-n n (fn [] (ce1/lower q))) "µs")
(println "  Elixir  quoted→.beam:   " (time-n n elixir-build) "µs")
(println "  Core    cerl→.beam:     " (time-n n core-build) "µs")
