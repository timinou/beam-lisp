; oracle.bl — the wide value oracle: whole test files, evaluated through Core.
;
; Every top-level form of a .bl test file is compiled by compiler.bl, lowered
; to Core, loaded, and RUN via the Core backend (defn → core-defvar; anything
; else → a run/0 module). Then the file's own deftests execute — each `is` is
; a value assertion on Core-compiled code. The Elixir backend's verdict on the
; same file (mix beam_lisp.test) is the reference.
(ns oracle (:require [ce1] [compiler :as c]))

(defn eval-core-form
  "One top-level form → its value, via the Core backend."
  [form env]
  (let [q (c/compile form env)]
    (if (and (ce1/call-node? q)
             (= 2 (count (ce1/args (ce1/head q))))
             (= :defvar (second (ce1/args (ce1/head q)))))
      (ce1/eval-def q)
      (ce1/via-core q))))

(def last-ns (atom "user"))

(defn load-source-core
  "Evaluate every form of `src` through Core, starting in `start-ns`; an `ns`
   form inside switches the namespace for the forms after it (as the loader
   does). Restores the caller's ns."
  [src path start-ns]
  (let [forms (BeamLisp.Reader/read_string src path)
        n (atom 0)
        prev (BeamLisp.Env/current_ns)]
    (BeamLisp.Env/in_ns start-ns)
    (doseq [form forms]
      (let [ns (BeamLisp.Env/current_ns)
            env (assoc (c/new-env ns) :ns ns)]
        (eval-core-form form env)
        (reset! last-ns (BeamLisp.Env/current_ns))
        (swap! n inc)))
    (BeamLisp.Env/in_ns prev)
    (deref n)))

(defn load-file-core [path] (load-source-core (File/read! path) path "user"))

;; the test library itself (deftest/is/are/run-tests) goes through Core first,
;; into `core` — exactly what TestRT.run_suite does with eval_string.
(println "test.bl through Core:" (load-source-core (BeamLisp.TestRT/test_lib_source) "test.bl" "core") "forms")

(defn run-file [path]
  (println "\n══" path)
  (let [n (load-file-core path)
        ns (deref last-ns)]
    (println n "forms through Core; running" ns)
    (BeamLisp.TestRT/run_ns ns)))

(def files ["test/bl/prelude_test.bl" "test/bl/core_additions_test.bl" "test/bl/optics_test.bl" "test/bl/sugar-test.bl" "test/bl/rewrite_test.bl" "test/bl/reader_meta_test.bl"])
(def totals (to-list (map run-file files)))
(println "\n── Core-backend suite totals ──")
(doseq [[f t] (map (fn [a b] [a b]) files totals)]
  (println "  " f (pr-str (select-keys t [:tests :pass :fail :error]))))
