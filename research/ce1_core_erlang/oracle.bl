; oracle.bl — value oracle: whole test files through canonical eval-form.
;
; Every top-level form of a .bl test file is compiled and evaluated by the
; canonical compiler/eval-form path (bl-ANF → Core Erlang → run/0). No
; special dispatch for def forms — eval-form handles defn/defvar internally.
; The six test files are the same as the Elixir-backend reference suite;
; the BeamLisp.TestRT/run_ns results are the assertions.
;
; Caller namespace is restored in a try/finally even when a form raises.
(ns oracle (:require [compiler :as c]))

(def last-ns (atom "user"))

(defn load-source
  "Evaluate every form of `src` through canonical eval-form, starting in
   `start-ns`. An `ns` form switches the namespace for subsequent forms as
   the loader does. Caller namespace is restored in a finally block even on
   failure — so a crashing file never leaves the process in the wrong ns."
  [src path start-ns]
  (let [forms (BeamLisp.Reader/read_string src path)
        n (atom 0)
        prev (BeamLisp.Env/current_ns)]
    (try
      (BeamLisp.Env/in_ns start-ns)
      (doseq [form forms]
        (let [ns (BeamLisp.Env/current_ns)
              env (assoc (c/new-env ns) :ns ns)]
          (c/eval-form form env)
          (reset! last-ns (BeamLisp.Env/current_ns))
          (swap! n inc)))
      (deref n)
      (finally
        (BeamLisp.Env/in_ns prev)))))

(defn load-file [path] (load-source (File/read! path) path "user"))

;; Load the test library itself first (deftest/is/are/run-tests).
(println "test.bl through canonical eval-form:"
         (load-source (BeamLisp.TestRT/test_lib_source) "test.bl" "core")
         "forms")

(defn run-file [path]
  (println "\n══" path)
  (let [n (load-file path)
        ns (deref last-ns)]
    (println n "forms through canonical eval-form; running" ns)
    (BeamLisp.TestRT/run_ns ns)))

(def files
  ["test/bl/prelude_test.bl"
   "test/bl/core_additions_test.bl"
   "test/bl/optics_test.bl"
   "test/bl/sugar-test.bl"
   "test/bl/rewrite_test.bl"
   "test/bl/reader_meta_test.bl"])

(def totals (to-list (map run-file files)))
(println "\n── Oracle suite totals ──")
(doseq [[f t] (map (fn [a b] [a b]) files totals)]
  (println "  " f (pr-str (select-keys t [:tests :pass :fail :error]))))
