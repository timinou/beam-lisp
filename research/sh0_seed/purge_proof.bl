; P0 definitive proof: the AOT'd .bl nano-compiler runs with beam-lisp's OWN
; compiler modules PURGED from the VM. If it still turns (+ 1 2) into 3, then
; nothing about beam-lisp's compiler is in the runtime loop — only the AOT'd
; .beam + Elixir/Erlang stdlib.
;
; Reproduce:
;   bin/bl -p priv run research/sh0_seed/purge_proof.bl
;
; The form is reader-shaped data: a list whose head is the symbol +. (The
; original .exs passed the Elixir tuple {:symbol, "+"}, which `lower` refuses;
; the reader-shaped symbol the compiler actually feeds it is the symbol +.)
(ns purge-proof (:require [bootstrap.nano :as nano]))

(BeamLisp/init)

(def form (list '+ 1 2))

(def before (nano/run form))
(println "with compiler present:  (+ 1 2) =>" before)

; Now remove beam-lisp's compiler and reader from the running VM entirely.
(doseq [m [:Elixir.BeamLisp.Compiler :Elixir.BeamLisp.Reader]]
  (code/purge m)
  (code/delete m)
  (code/purge m))

(def loaded-after
  (filter (fn [m] (code/is_loaded m))
          [:Elixir.BeamLisp.Compiler :Elixir.BeamLisp.Reader]))
(println "compiler/reader loaded after purge:" (if (empty? loaded-after) [] loaded-after))

(def after-val (nano/run form))
(println "with compiler PURGED:   (+ 1 2) =>" after-val)

(println (if (and (erlang/== after-val 3) (empty? loaded-after)) "P0 PASS" "P0 FAIL"))
