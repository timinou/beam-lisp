; P0 probe — .bl builds a real Elixir AST call node and evaluates it.
; Elixir AST for (+ 1 2) is {:+, [], [1, 2]}: head is the ATOM :+, then
; empty metadata, then the argument list. A beam-lisp keyword :+ compiles
; straight to the atom :+, which is exactly the head an AST call needs.
(def plus-ast (erlang/list_to_tuple (list :+ (list) (list 1 2))))
(println "AST:" plus-ast)
(def result (first (erlang/tuple_to_list (Code/eval_quoted plus-ast))))
(println "eval result:" result)
(println "seam OK?" (= result 3))
