; research/p8_shapes/run.bl — P8 driver: precision gain vs FP rate.

(ns p8run
  (:require [shapes]))

(println "── P8: map shapes, go/no-go ──")

; ── precision demo: ok/err union flows through if, kw-calls narrow ────
(reset! typed/warnings [])
(def demo
  "(defn result [c]
     (if c {:ok (double 5)} {:err \"bad\"}))
   (defn use-ok [c]
     (let [r (result c)]
       (str (:err r))))
   (defn bad-key [c]
     (:missing (if c {:ok 1} {:err \"e\"})))")
(defn ^{:args [int] :ret int} double [x] (* x 2))
(def dw (shapes/check-source demo "p8run"))
(println (str "demo warnings: " (count (:warnings dw))))
(doall (map (fn [w] (println (str "  ✗ " (:line w) ":" (:col w) " " (:msg w))))
            (:warnings dw)))

; ── FP rate + precision on the real store corpus ───────────────────────
(def stores [["priv/datom/store-map.bl" "datom.store-map"]
             ["priv/datom/store-overlay.bl" "datom.store-overlay"]
             ["priv/datom/store-ets.bl" "datom.store-ets"]])

(doall
  (map (fn [[path ns]]
         (reset! typed/warnings [])
         (let [src (second (File/read path))
               r   (shapes/check-source src ns)]
           (println (str "  " ns ": " (count (:warnings r)) " warnings")))
         (doall (map (fn [w] (println (str "    " (:line w) ":" (:col w)
                                          " " (:msg w))))
                     (deref typed/warnings))))
       stores))
