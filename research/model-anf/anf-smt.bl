; anf_smt.bl — translate bl-ANF (not surface syntax) to an SMT formula, and
; INLINE proven-pure helpers into the formula.
;
; ── The last surface-coupled engine ──────────────────────────────────────
;
; system.smt/translate walks the SURFACE reader-node tree (typed/node-*). That
; was the last engine reading syntax instead of the IR. Two costs:
;
; 1. It re-implements operator resolution. `(>= balance 0)` is matched by NAME
;    ("+", ">=", …) against a surface list; a macro that expands to the same
;    arithmetic, or a qualified `erlang/>=`, is a different surface shape and is
;    missed. The compiler ALREADY resolved every operator to a [mod fun] in ANF.
;
; 2. It cannot see through a CALL. A guard `(safe? balance)` where `safe?` is a
;    pure helper is opaque to the surface translator — it becomes an
;    uninterpreted predicate or :untranslatable. This is the Phase-4 soundness
;    hole generalised: a transition whose next-state is computed by a helper is
;    silently dropped.
;
; ── The ANF translator ───────────────────────────────────────────────────
;
; Reading ANF fixes both. Operators arrive pre-resolved as :remote [mod fun];
; one table maps [mod fun] → SMT op, and macro/qualified spellings collapse to
; the same node. And a user call is a clear (RT/invoke (:global f) args) — so if
; `f` is PROVEN PURE (system.analyze footprint = ∅), we look up its ANF body and
; INLINE it, substituting the arguments. The formula then models the helper's
; actual computation, soundly, instead of dropping the transition.

(ns anf-smt
  (:require [system.ir :as ir]
            [system.analyze :as analyze]
            [compiler :as c]))

(def rt :Elixir.BeamLisp.RT)

; [mod fun] → SMT operator symbol. The compiler resolved every surface spelling
; (`>=`, `erlang/>=`, a macro expanding to it) to ONE of these, so the table is
; small and total over the arithmetic/relational fragment.
(def op-table
  {[:erlang :+] '+ [:erlang :-] '- [:erlang :*] '*
   [:erlang :>] '> [:erlang :<] '< [:erlang :>=] '>= [:erlang :=<] '<=
   [:erlang :==] '= [:erlang :=:=] '=
   [:erlang :andalso] 'and [:erlang :and] 'and
   [:erlang :orelse] 'or [:erlang :or] 'or [:erlang :not] 'not})

(declare translate)

(defn- cons->args [node]
  (loop [n node acc []]
    (if (= :cons (:op n)) (recur (:tail n) (conj acc (:head n))) acc)))

(defn- translate-call
  "A user call (RT/invoke (:global f) args). If `f` is a pure fn whose body is
   in `bodies`, INLINE it: translate its body with params bound to the
   translated actuals. Otherwise :untranslatable (honest — an unknown or impure
   callee is not modellable)."
  [env bodies pure? node]
  (let [args (:args node)
        callee (first args)
        actuals (if (>= (count args) 2) (cons->args (second args)) [])]
    (if (and (= :global (:op callee))
             (contains? bodies (:name callee))
             (pure? (:name callee)))
      (let [d (get bodies (:name callee))
            params (:params d)
            ; bind each param name → translated actual
            benv (reduce (fn [m [p a]] (assoc m p (translate env bodies pure? a)))
                         env (map (fn [p a] [p a]) params actuals))]
        (translate benv bodies pure? (:body d)))
      :untranslatable)))

(defn translate
  "bl-ANF node → an SMT formula (a quoted s-expr), or :untranslatable. `env`
   maps a var/param name → its already-translated formula (for inlining);
   `bodies` is {fn-name → {:params :body}}; `pure?` tells whether a callee may
   be inlined."
  [env bodies pure? node]
  (cond
    (not (ir/node? node)) :untranslatable
    (= :lit (:op node))    (:val node)
    (= :global (:op node)) (get env (:name node) (symbol (:name node)))
    (= :var (:op node))    (get env (:name node) (symbol (:name node)))
    (= :if (:op node))
      (let [t (translate env bodies pure? (:test node))
            a (translate env bodies pure? (:then node))
            b (translate env bodies pure? (:else node))]
        (if (some #{:untranslatable} [t a b]) :untranslatable (list 'ite t a b)))
    (= :remote (:op node))
      (if (and (= (:mod node) rt) (= (:fun node) :invoke))
        (translate-call env bodies pure? node)
        (let [op (get op-table [(:mod node) (:fun node)])]
          (if (nil? op)
            :untranslatable
            (let [targs (map (fn [a] (translate env bodies pure? a)) (:args node))]
              (if (some #{:untranslatable} targs)
                :untranslatable
                (apply list op targs))))))
    :else :untranslatable))

; ── entry: translate a predicate SOURCE against a program ────────────────

(defn of-source
  "Translate predicate `pred-src` (e.g. \"(>= balance 0)\" or \"(safe? balance)\")
   to an SMT formula, inlining any pure helper it calls, using the whole-program
   analysis of `prog-src`. `state-vars` seed the env as SMT symbols."
  [prog-src state-vars pred-src]
  (let [summaries (analyze/analyze prog-src)
        bodies (analyze/fn-bodies prog-src)
        pure? (fn [name] (empty? (:footprint (get summaries name {:footprint {:x 1}}))))
        env (reduce (fn [m v] (assoc m v (symbol v))) {} state-vars)
        anf (c/compile-node (first (BeamLisp.Reader/read_string pred-src)) (c/new-env "anf-smt"))]
    (translate env bodies pure? anf)))
