; Prototype: inter-procedural return-tag flow over bl-ANF.
(ns research.anf-engines.typed-interproc
  (:require [compiler :as c] [typed :as typed]))

(def rt :Elixir.BeamLisp.RT)
(def number-tags #{:int :float})

(defn read1 [src] (first (BeamLisp.Reader/read_string src)))
(defn compile-expr [src] (c/compile-node (read1 src) (c/new-env "typed-interproc")))

(defn global-call-name [n]
  (if (and (= :remote (:op n))
           (= rt (:mod n))
           (= :invoke (:fun n))
           (= :global (:op (first (:args n)))))
    (:name (first (:args n)))
    nil))

(defn join-all [types]
  (reduce typed/t-union typed/never types))

(declare infer)

(defn infer-clause [returns env cl warnings]
  (infer returns env (:body cl) warnings))

(defn infer-remote [returns env n warnings]
  (let [name (global-call-name n)
        args (if (nil? name) (:args n) (rest (:args n)))
        arg-types (map (fn [a] (infer returns env a warnings)) args)
        k [(:mod n) (:fun n)]]
    (cond
      (some? name) (get returns name typed/any)
      (contains? #{[:erlang :+] [:erlang :-] [:erlang :*] [:erlang :/] } k)
        (do
          (doall (map-indexed
            (fn [i ty]
              (if (empty? (typed/t-meet ty number-tags))
                (swap! warnings conj
                  {:kind :type-error :callee (second k) :argument (+ i 1)
                   :actual ty :required number-tags
                   :ann (:ann n)})
                nil))
            arg-types))
          number-tags)
      :else typed/any)))

(defn infer [returns env n warnings]
  (let [op (:op n)]
    (cond
      (nil? n) typed/never
      (= :lit op) (typed/lit-type (:val n))
      (= :var op) (get env (:name n) typed/any)
      (= :global op) #{:fn}
      (= :remote op) (infer-remote returns env n warnings)
      (= :apply op)
        (let [callee (:fn n)
              name (if (= :global (:op callee)) (:name callee) nil)]
          (doall (map (fn [a] (infer returns env a warnings)) (:args n)))
          (if (nil? name) typed/any (get returns name typed/any)))
      (= :let op)
        (let [init-type (infer returns env (:init n) warnings)]
          (infer returns (assoc env (:name n) init-type) (:body n) warnings))
      (= :if op)
        (do (infer returns env (:test n) warnings)
            (typed/t-union (infer returns env (:then n) warnings)
                           (infer returns env (:else n) warnings)))
      (= :do op) (reduce (fn [_ x] (infer returns env x warnings)) typed/never (:stmts n))
      (= :case op)
        (do (infer returns env (:subj n) warnings)
            (join-all (map (fn [cl] (infer-clause returns env cl warnings)) (:clauses n))))
      (= :fn op) #{:fn}
      (= :tuple op) (doall (map (fn [x] (infer returns env x warnings)) (:elems n))) #{:vec}
      (= :map op) (doall (mapcat (fn [p] (map (fn [x] (infer returns env x warnings)) p)) (:pairs n))) #{:map}
      (= :cons op) (do (infer returns env (:head n) warnings) (infer returns env (:tail n) warnings) #{:list})
      :else typed/any)))

(defn infer-returns [fns known]
  (reduce (fn [m f]
            (assoc m (:name f) (infer known {} (:anf f) (atom []))))
          {} fns))

(defn analyze [fns]
  ; Pass 1 discovers direct/literal returns. Pass 2 lets those returns flow
  ; through resolved ANF calls and checks host-call argument requirements.
  (let [pass1 (infer-returns fns {})
        pass2 (merge pass1 (infer-returns fns pass1))
        warnings (atom [])
        final-returns (reduce (fn [m f]
                                (assoc m (:name f)
                                  (infer pass2 {} (:anf f) warnings)))
                              {} fns)]
    {:pass1 pass1 :returns final-returns :warnings (deref warnings)}))

(def corpus
  [{:label :keyword-into-plus
    :source "(defn mk [] :a-keyword)\n(defn use-it [] (+ 1 (mk)))"
    :fns [{:name "mk" :body ":a-keyword"}
          {:name "use-it" :body "(+ 1 (mk))"}]}
   {:label :string-into-minus
    :source "(defn text [] \"oops\")\n(defn subtract [] (- 8 (text)))"
    :fns [{:name "text" :body "\"oops\""}
          {:name "subtract" :body "(- 8 (text))"}]}
   {:label :valid-number-call
    :source "(defn amount [] 41)\n(defn add-one [] (+ 1 (amount)))"
    :fns [{:name "amount" :body "41"}
          {:name "add-one" :body "(+ 1 (amount))"}]}
   {:label :direct-control
    :source "(defn broken [] (+ 1 :bad))"
    :fns [{:name "broken" :body "(+ 1 :bad)"}]}])

(defn run-case [case]
  (let [surface (typed/check-source (:source case) "research.anf-engines.typed-interproc")
        fns (map (fn [f] (assoc f :anf (compile-expr (:body f)))) (:fns case))
        anf (analyze fns)]
    (println "TINTERPROC" (pr-str {:case (:label case)
                                    :surface-warnings (:warnings surface)
                                    :anf-returns (:returns anf)
                                    :anf-warnings (:warnings anf)}))))

(doall (map run-case corpus))
(println "TINTERPROC" (pr-str {:position-note "Warnings retain each ANF node's :ann; compile-node currently carries source :line when the compiled body reader node has location metadata. A production defn-body compile must preserve the original surface node :ann to map inter-procedural evidence back to [line col]."}))
