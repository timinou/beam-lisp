; Compare the surface codebase call graph with calls visible after full ANF expansion.
(ns research.anf-engines.codebase-reach
  (:require [compiler :as c]
            [codebase]
            [typed]
            [system.ir :as ir]
            [clojure.set :as set]))

; Deliberately requires two macroexpand-1 steps before println is exposed.
(defmacro buried-call [x] `(println ~x))
(defmacro outer-call [x] `(buried-call ~x))

(def seeds (merge typed/core-seeds-v2 typed/host-seeds))
(def ns-name "research.anf-engines.codebase-reach")

(def corpora
  [{:name :nested-macros
    :source "(defn nested-demo [x] (outer-call x))"
    :body "(outer-call x)"}
   {:name :direct-and-threaded
    :source "(defn pipeline-demo [x] (-> x inc str println))"
    :body "(-> x inc str println)"}
   {:name :higher-order
    :source "(defn dispatch-demo [f x] (apply f [x]))"
    :body "(apply f [x])"}])

(defn read1 [source]
  (first (BeamLisp.Reader/read_string source)))

(defn call-target [node]
  (let [o (:op node)]
    (cond
      (= o :global) [:global (:ns node) (:name node)]
      (= o :var) [:var (:name node)]
      (= o :remote) [:remote (:mod node) (:fun node)]
      (= o :fn) [:closure]
      (= o :let) [:computed :let]
      :else [:computed o])))

(defn logical-remote-target [node]
  (let [raw [(:mod node) (:fun node)]
        target (first (:args node))]
    (cond
      (and (= raw [:Elixir.BeamLisp.RT :invoke]) (= :global (:op target)))
        [:global (:ns target) (:name target)]
      (= raw [:Elixir.BeamLisp.RT :apply_to])
        [:opaque-apply (call-target target)]
      :else [:remote (:mod node) (:fun node)])))

(defn anf-calls [root]
  (loop [pending (list root) remotes #{} applies #{} resolved #{}]
    (if (empty? pending)
      {:remote remotes :apply applies :resolved resolved}
      (let [node (first pending)
            more (concat (ir/child-nodes node) (rest pending))
            o (:op node)]
        (cond
          (= o :remote)
            (recur more (conj remotes [(:mod node) (:fun node)]) applies
                   (conj resolved (logical-remote-target node)))
          (= o :apply)
            (let [target (call-target (:fn node))]
              (recur more remotes (conj applies target) (conj resolved [:apply target])))
          :else (recur more remotes applies resolved))))))

(defn target-name [target]
  (cond
    (= :global (first target)) (str (nth target 2))
    (= :remote (first target)) (str (nth target 2))
    :else (pr-str target)))

(defn compare-one [{:keys [name source body]}]
  (let [indexed (codebase/index-source seeds ns-name source)
        surface (set (map :call/callee (:calls indexed)))
        root (c/compile-node (read1 body) (c/new-env ns-name))
        anf (anf-calls root)
        remotes (:remote anf)
        applies (:apply anf)
        resolved (:resolved anf)
        anf-names (set (map target-name resolved))]
    (println "REACH|corpus=" (pr-str name))
    (println "REACH|anf-root=" (pr-str root))
    (println "REACH|surface=" (pr-str surface))
    (println "REACH|anf-remote=" (pr-str remotes))
    (println "REACH|anf-apply=" (pr-str applies))
    (println "REACH|anf-resolved=" (pr-str resolved))
    (println "REACH|surface-only-names=" (pr-str (set/difference surface anf-names)))
    (println "REACH|anf-only-names=" (pr-str (set/difference anf-names surface)))))

(doseq [corpus corpora] (compare-one corpus))
