; cost_and_model.bl — (1) cost of engine-over-ANF vs engine-over-surface;
; (2) what a defserver looks like as a canonical descriptor, i.e. what
; system.model's extractor would consume instead of re-parsing surface forms.
; Run: mix beam_lisp.run --path priv research/anf_engines/cost_and_model.bl
(ns research.anf-engines.cost
  (:require [compiler :as c] [anf] [lower]
            [system.footprint :as fp]
            [research.anf-engines.fp-anf :as fa]))

(defn- read1 [s] (first (BeamLisp.Ns.Reader/read_string s nil)))

(def body
  "(let [bal (deref balance) n (count (deref orders))]
     (if (> bal n)
       (do (swap! orders conj {:id n}) (-> balance (swap! - n)) (println :ok))
       (datom/transact! conn [[:db/add 1 :x n]])))")

(defn- time-us [f k]
  (let [t0 (erlang/monotonic_time :microsecond)]
    (loop [i 0] (when (< i k) (f) (recur (inc i))))
    (/ (- (erlang/monotonic_time :microsecond) t0) k)))

(def form (read1 body))
(def env (c/new-env "cost"))
(def node (c/compile-node form env))

(println "\n── cost per walk (µs, mean of 2000)")
(println "  surface fp-walk         :" (time-us (fn [] (fp/fp-walk {} form)) 2000))
(println "  compile-node (ANF)      :" (time-us (fn [] (c/compile-node form env)) 2000))
(println "  fp-anf on ready ANF     :" (time-us (fn [] (fa/fp-anf node)) 2000))
(println "  compile + fp-anf        :" (time-us (fn [] (fa/fp-anf (c/compile-node form env))) 2000))
(println "  surface result:" (pr-str (fp/fp-walk {} form)))
(println "  anf result    :" (pr-str (fa/fp-anf node)))

; ── defserver as descriptor ─────────────────────────────────────────────
;
; system.model/extract-defserver re-parses (handle-call PAT [args state]
; :when GUARD body) by hand, in two dialects. The compiler ALREADY does this
; to build the descriptor. Show the clause shape the model engine would get.

(def server-src
  "(defserver ^{:invariant (>= balance 0)} account
     (init [] (ok {:balance 100}))
     (handle-call [:withdraw amt] [_ {:keys [balance]}] :when (<= amt balance)
       (reply :ok {:balance (- balance amt)}))
     (handle-call [:deposit amt] [_ {:keys [balance]}]
       (reply :ok {:balance (+ balance amt)})))")

; compile-defserver is private and publishes; reach the descriptor through
; the compiler's own clause builder by compiling the form and inspecting the
; published module's provenance is not what we want. Instead: compile the
; handle-call clause bodies as plain forms to show guard/body ANF shape.
(def guard-form (read1 "(<= amt balance)"))
(def next-form  (read1 "(reply :ok {:balance (- balance amt)})"))
(println "\n── defserver clause parts as ANF")
(println "  guard :" (pr-str (c/compile-node guard-form env)))
(println "  next  :" (pr-str (c/compile-node next-form env)))

; ── :ann extras survive descriptor->beam (lower reads only :line/:file) ──
(def ann-node (fa/annotate (c/compile-node (read1 "(let [x 1] (+ x 41))") env)))
(def clause {:op :defn-clause :fname :answer :params (list) :guard nil :body ann-node :ann {}})
(def descriptor (anf/module :anf_ann_probe (list clause) [[:answer 0]] (list) {:file "probe.bl"}))
(def mb (lower/descriptor->beam descriptor))
(code/load_binary (elem mb 0) (erlang/binary_to_list "probe.bl") (elem mb 1))
(println "\n── annotated node emitted and ran:" (anf_ann_probe/answer)
         " root :ann keys" (pr-str (keys (:ann ann-node))))

