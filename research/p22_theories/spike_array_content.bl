; research/p22_theories/spike_array_content.bl
; ══════════════════════════════════════════════════════════════════════════
; P22 THEORIES — collection CONTENT invariants over z3 arrays.
;
; Length-abstraction (Rung 3) proves "the queue holds ≤ K items" but is blind to
; WHAT is inside. z3's Array theory reasons about the elements: this spike proves
; a NO-DUPLICATE work queue keeps its elements distinct — a content property no
; integer length can express. Modelled as (Array Int Int) + a length; enqueue
; appends at index len; the invariant is ∀ i<j<len. a[i] ≠ a[j].
; ══════════════════════════════════════════════════════════════════════════

(ns p22.spike-array-content (:require [z3]))

(def port (z3/open))

; distinct(a, len): ∀ i,j. 0≤i<j<len ⇒ a[i]≠a[j]
(defn distinct-inv [a len]
  (str "(forall ((i Int) (j Int)) "
       "(=> (and (<= 0 i) (< i j) (< j " len ") (not (= (select " a " i) (select " a " j)))) true))"))

; the real distinctness predicate (as a define-fun for reuse)
(def distinct-def
  (str "(define-fun Distinct ((a (Array Int Int)) (len Int)) Bool "
       "(forall ((i Int) (j Int)) "
       "(=> (and (<= 0 i) (< i j) (< j len)) (not (= (select a i) (select a j))))))\n"))

(println "── P22: array CONTENT invariant — a no-duplicate work queue ──\n")

; ESTABLISHMENT: the empty queue (len 0) is trivially distinct.
(def est
  (= "unsat" (z3/check port
    (str distinct-def
         "(declare-const a (Array Int Int))\n"
         "(assert (not (Distinct a 0)))\n"))))
(println "empty queue is distinct (establishment):" est)

; PRESERVATION of a GUARDED enqueue: enqueue x only when x is FRESH
; (∀ i<len. a[i] ≠ x). Then store x at index len, len'=len+1, still distinct.
(def enqueue-preserves
  (= "unsat" (z3/check port
    (str distinct-def
         "(declare-const a (Array Int Int))\n(declare-const len Int)\n(declare-const x Int)\n"
         "(assert (>= len 0))\n"
         "(assert (Distinct a len))\n"
         ; guard: x is fresh
         "(assert (forall ((i Int)) (=> (and (<= 0 i) (< i len)) (not (= (select a i) x)))))\n"
         ; negate: the extended queue is NOT distinct
         "(assert (not (Distinct (store a len x) (+ len 1))))\n"))))
(println "guarded enqueue (fresh x) preserves distinctness:" enqueue-preserves)

; the BUG: enqueue WITHOUT the freshness guard — a duplicate can enter.
(def unguarded-caught
  (= "sat" (z3/check port
    (str distinct-def
         "(declare-const a (Array Int Int))\n(declare-const len Int)\n(declare-const x Int)\n"
         "(assert (>= len 0))\n"
         "(assert (Distinct a len))\n"
         ; NO freshness guard
         "(assert (not (Distinct (store a len x) (+ len 1))))\n"))))
(println "unguarded enqueue CAN break distinctness (bug caught):" unguarded-caught)

(println "\n── the point ──")
(println "The queue is a z3 Array, not a length. 'No duplicate ids' is a genuine")
(println "CONTENT invariant — ∀ i<j. a[i]≠a[j] — that length-abstraction is blind")
(println "to. z3 proves the guarded enqueue preserves it and catches the")
(println "unguarded one. The sort functor's next tag: :vec → (Array Int T), and")
(println "the collection ops (conj→store, count→len, get→select) translate like")
(println "any theory. Gap 1, done right. (Quantified array reasoning can return")
(println ":unknown on hard instances → register :approximate; here it decides.)")
:ok
