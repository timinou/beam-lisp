; research/p22_theories/spike_liveness.bl
; ══════════════════════════════════════════════════════════════════════════
; P22 TIME — LIVENESS. Everything shipped so far is SAFETY (□, nothing bad
; ever happens). The other half of TLA⁺ is LIVENESS (◇, something good
; EVENTUALLY happens). The fixpoint duality we built (P19 R2) is exactly the
; CTL machinery:
;   AG¬bad  = safety   = GREATEST fixpoint (system.gfp/safe-region, SHIPPED)
;   AF goal = liveness = LEAST fixpoint    (this spike)
;
; AF goal = "on every path, goal is eventually reached". Least fixpoint:
;   AF = μZ. goal ∨ (has-successors ∧ every successor ∈ Z)
; Seed with the goal states, grow by adding any state ALL of whose successors
; already eventually-reach — until stable.
; ══════════════════════════════════════════════════════════════════════════

(ns p22.spike-liveness)

; AF: the least set containing `goal` and closed under "all successors are in it".
; `succ` is (state → [states]). A deadlock (no successors) that is not a goal can
; never satisfy AF — correctly excluded (every-successor-in over an empty set is
; vacuously true, so we require has-successors OR goal).
(defn af [states succ goal?]
  (loop [reached (into #{} (filter goal? states)) round 0]
    (let [reached2 (into #{} (concat (into [] reached)
                    (filter (fn [s]
                              (let [outs (succ s)]
                                (and (not (empty? outs))
                                     (every? (fn [n] (contains? reached n)) outs))))
                            states)))]
      (if (= (count reached2) (count reached))
        {:af reached :rounds round}
        (recur reached2 (+ round 1))))))

(println "── P22: liveness — AF (eventually) as a least fixpoint ──\n")

; a mutex-grant model: 0=idle → 1=requesting → 2=granted (goal) → 0. State 3 is a
; STARVATION trap: 3→3 forever, never reaching granted.
(def succ {0 [1] 1 [2] 2 [0] 3 [3]})
(def r (af [0 1 2 3] (fn [s] (get succ s [])) (fn [s] (= s 2))))
(println "states that EVENTUALLY reach granted (AF granted):" (sort (into [] (:af r))))
(println "  0,1,2 all reach granted; 3 is a starvation loop — correctly excluded.")

; liveness VERDICT for a start state: does 0 (idle) always eventually grant?
(println "\nfrom idle, service is guaranteed (0 ∈ AF granted)?" (contains? (:af r) 0))
(println "from the trap, service is guaranteed (3 ∈ AF granted)?" (contains? (:af r) 3))

; contrast with SAFETY (gfp): the safe region is about NEVER reaching bad; this
; is about ALWAYS reaching good. Same transition graph, dual fixpoint.
(println "\n── the point ──")
(println "AG (safety) shrinks from everything, keeping states that never touch")
(println "bad — a GREATEST fixpoint (shipped as safe-region). AF (liveness) grows")
(println "from the goal, adding states all of whose futures reach it — a LEAST")
(println "fixpoint. Same graph, dual directions. With both, the tier proves the")
(println "two halves of temporal logic natively — □ and ◇ — no JVM, no TLA⁺ export.")
(println "A starvation loop is caught precisely because it is NOT in the least")
(println "fixpoint: it has a future that never reaches the goal.")
:ok
