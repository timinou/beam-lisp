; research/p18_state_models/spike_multivar.bl
; ── P18 Rung 1: multi-variable relational invariants ──────────────────
;
; Q: does the existing seam machinery generalize from one integer state var
;    to N — with a RELATIONAL invariant that couples them (something a
;    single-variable model structurally cannot express)?
;
; The claim to prove: state ≜ a tuple of ints; a transition updates a SUBSET
; of them; z3 discharges □Inv over the JOINT primed state. If this runs, Rung
; 1 is "delete the (first svars) truncation + declare all vars", not research.
;
; The example (genuinely relational — NOT expressible over one var):
;   state {:balance b, :reserved r}
;   invariant  (and (>= reserved 0) (>= balance reserved))
;              "reserved funds are non-negative AND never exceed the balance"
;   reserve  amt : guard (>= (- balance reserved) amt)
;                  next  balance'=balance,  reserved'=(+ reserved amt)
;   release  amt : guard (>= reserved amt)
;                  next  balance'=balance,  reserved'=(- reserved amt)
;   withdraw amt : guard (>= (- balance reserved) amt)      ; only FREE funds
;                  next  balance'=(- balance amt), reserved'=reserved
;
; and a BUGGY withdraw that ignores the reservation (withdraws against the
; whole balance) — must be caught, because it can drive balance < reserved.

(ns p18.spike-multivar
  (:require [z3]))

(def port (z3/open))

; ── the multi-variable preservation check ────────────────────────────────
;
; `vars`   : ordered list of state-var names (strings)
; `inv`    : fn (rename) → SMT predicate, where (rename v) gives the current
;            name to use for state var v (so we can prime the whole tuple)
; `guard`  : SMT string over unprimed vars + inputs, or nil
; `nexts`  : map {var → SMT string for its next value} (unmentioned = unchanged)
; `inputs` : input var names to declare (amounts etc.)
;
; Assert Inv(s) ∧ guard ∧ (⋀ vᵢ'=nextᵢ) ∧ ¬Inv(s'); unsat ⟹ preserved.

(defn preserves-joint? [port vars inv guard nexts inputs]
  (let [decl (fn [n] (str "(declare-const " n " Int)\n"))
        cur-decls  (join "" (map decl vars))
        in-decls   (join "" (map decl inputs))
        prime-decls (join "" (map (fn [v] (decl (str v "2"))) vars))
        ; each primed var equals its next expr (or its current value if
        ; the transition doesn't mention it). Primed name = v+"2" (the
        ; suffix convention core.bl's preserves? already uses).
        prime-eqs (join "" (map (fn [v]
                                  (str "(assert (= " v "2 "
                                       (get nexts v v) "))\n"))
                                vars))
        inv-cur   (inv (fn [v] v))
        inv-prime (inv (fn [v] (str v "2")))
        smt (str cur-decls in-decls prime-decls
                 "(assert " inv-cur ")\n"
                 (if guard (str "(assert " guard ")\n") "")
                 prime-eqs
                 "(assert (not " inv-prime "))\n")]
    (= "unsat" (z3/check port smt))))

; the relational invariant, as a fn of the renamer
(defn inv [rn]
  (str "(and (>= " (rn "reserved") " 0) (>= " (rn "balance") " " (rn "reserved") "))"))

(def vars ["balance" "reserved"])

(println "── P18 Rung 1: multi-variable relational invariant ──")
(println "  state:     {:balance b, :reserved r}")
(println "  invariant: (and (>= reserved 0) (>= balance reserved))")
(println "")

; ── the three GOOD transitions — each must preserve the joint invariant ──
(def reserve-ok
  (preserves-joint? port vars inv
    "(and (>= amt 0) (>= (- balance reserved) amt))"   ; enough FREE funds
    {"reserved" "(+ reserved amt)"}            ; next: reserved grows
    ["amt"]))

(def release-ok
  (preserves-joint? port vars inv
    "(and (>= amt 0) (>= reserved amt))"               ; enough reserved
    {"reserved" "(- reserved amt)"}
    ["amt"]))

(def withdraw-ok
  (preserves-joint? port vars inv
    "(and (>= amt 0) (>= (- balance reserved) amt))"   ; only free funds
    {"balance" "(- balance amt)"}
    ["amt"]))

(println (str "  reserve  preserves invariant: " reserve-ok))
(println (str "  release  preserves invariant: " release-ok))
(println (str "  withdraw preserves invariant: " withdraw-ok "   (guards against FREE funds)"))

; ── the BUGGY withdraw — ignores the reservation, must be CAUGHT ──────────
(def withdraw-bug
  (preserves-joint? port vars inv
    "(>= balance amt)"                          ; BUG: guards whole balance
    {"balance" "(- balance amt)"}
    ["amt"]))

(println (str "  buggy withdraw preserves invariant: " withdraw-bug
              "   (guards whole balance — can drive balance < reserved)"))
(println "")

(def pass (and reserve-ok release-ok withdraw-ok (not withdraw-bug)))
(println (str (if pass "PASS" "FAIL")
              ": three good transitions proven, the reservation-ignoring bug caught"))
(println "")
(println "∴ the seam's preserves? generalizes to N vars by declaring the whole")
(println "  tuple and priming it jointly. Rung 1 = delete (first svars), keep the set.")
