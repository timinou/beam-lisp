; research/p18_state_models/spike_discover.bl
; ── P18 "crazier thing": INVARIANT DISCOVERY (implied invariant, from nothing) ──
;
; verify-process today needs you to WRITE ^{:invariant (>= balance 0)}. abduce
; STRENGTHENS a given invariant with a missing conjunct. Neither DISCOVERS the
; invariant from nothing.
;
; But every part needed already exists:
;   - candidate enumeration  (system.core/candidates via miniKanren)
;   - z3 preservation check   (preserves? — "does transition keep P?")
;   - the state vars          (would come from the type lattice)
;
; The synthesis loop is HOUDINI (Flanagan/Leino): start from the conjunction of
; EVERY candidate predicate; repeatedly drop any conjunct some transition can
; break; the fixpoint is the strongest INDUCTIVE invariant expressible in the
; candidate vocabulary. No annotation. This spike proves the loop converges to
; the right thing on the account machine.
;
; The machine (UNANNOTATED — we discover its invariant):
;   state   balance
;   deposit  amt : guard (>= amt 0)                  next (+ balance amt)
;   withdraw amt : guard (and (>= amt 0) (>= balance amt))  next (- balance amt)
;   init     balance = 0
;
; Expected discovery: (>= balance 0) survives; bogus candidates like
; (<= balance 0) or (>= balance 5) get refuted and dropped.

(ns p18.spike-discover
  (:require [z3] [minikanren :as mk]))

(def port (z3/open))

; ── candidate vocabulary: (op balance k), op ∈ {<= >=}, k ∈ small ints ──
; (miniKanren enumerates relationally, exactly like system.core/candidates)
(defn candidates []
  (let [terms (mk/run 40 q
                (mk/fresh [op k]
                  (mk/=== q (list op 'balance k))
                  (mk/conde [(mk/=== op '<=)] [(mk/=== op '>=)])
                  (mk/conde [(mk/=== k 0)] [(mk/=== k 1)] [(mk/=== k 5)])))]
    (distinct
      (map (fn [t] (str "(" (first t) " balance " (nth t 2) ")")) terms))))

; ── the Houdini step: does `cand` (a single conjunct) survive `transition`? ──
; Preservation under the FULL current candidate set as the antecedent (that's
; what makes Houdini find the greatest INDUCTIVE subset, not just per-conjunct).
(defn survives? [port conj-set guard next cand]
  (let [antecedent (join "\n" (map (fn [c] (str "(assert " c ")")) conj-set))
        smt (str "(declare-const balance Int)\n(declare-const balance2 Int)\n"
                 "(declare-const amt Int)\n"
                 antecedent "\n"
                 (if guard (str "(assert " guard ")\n") "")
                 "(assert (= balance2 " next "))\n"
                 ; ¬cand[balance←balance2]
                 "(assert (not " (join "balance2" (split cand "balance")) "))\n")]
    (= "unsat" (z3/check port smt))))

; the machine's message transitions (guard, next) — UNANNOTATED
(def transitions
  [{:label "deposit"  :guard "(>= amt 0)"                 :next "(+ balance amt)"}
   {:label "withdraw" :guard "(and (>= amt 0) (>= balance amt))" :next "(- balance amt)"}])

; ── the Houdini fixpoint ──────────────────────────────────────────────────
; Start with ALL candidates; drop any that some transition fails to preserve
; under the current set; iterate until stable.
(defn houdini [port cands transitions]
  (loop [conj-set cands]
    (let [survivors (filter
                      (fn [c]
                        (every? (fn [t]
                                  (survives? port conj-set (:guard t) (:next t) c))
                                transitions))
                      conj-set)]
      (if (= (count survivors) (count conj-set))
        conj-set
        (recur survivors)))))

(println "── P18: invariant DISCOVERY (no annotation) ──")
(def cands (candidates))
(println (str "  candidate vocabulary (" (count cands) "): " (pr-str (sort cands))))
(println "")

; establishment filter: keep only candidates true at init (balance = 0)
(defn holds-at-init? [port cand]
  (let [smt (str "(declare-const balance Int)\n"
                 "(assert (= balance 0))\n"
                 "(assert (not " cand "))\n")]
    (= "unsat" (z3/check port smt))))

; Houdini needs a CONSISTENT seed. The full vocabulary contains mutually
; contradictory predicates ((>= balance 5) ∧ (<= balance 0)) whose conjunction
; is empty — induction over an unsatisfiable antecedent is vacuous (everything
; trivially 'survives'). Filtering to what holds at the concrete init state
; FIRST yields a satisfiable set (init witnesses it), so induction has teeth.
(def established (filter (fn [c] (holds-at-init? port c)) cands))
(println (str "  hold at init (balance=0): " (pr-str (sort established))))

(def discovered (houdini port established transitions))
(println (str "  ∧ survive induction:      " (pr-str (sort discovered))))
(println "")

; the discovered invariant is the conjunction
(def inv-str (str "(and " (join " " (sort discovered)) ")"))
(println (str "  DISCOVERED INVARIANT:  " inv-str))
(println "")

; ── did we discover the right thing? ──────────────────────────────────────
; (>= balance 0) MUST be in it; (<= balance 0) and (>= balance 5) must NOT.
(def pass
  (and (some (fn [c] (= c "(>= balance 0)")) discovered)
       (not (some (fn [c] (= c "(<= balance 0)")) discovered))
       (not (some (fn [c] (= c "(>= balance 5)")) discovered))))

(println (str (if pass "PASS" "FAIL")
              ": discovered (>= balance 0) from nothing; refuted the bogus candidates"))
(println "")
(println "∴ implied invariants are abduce's machinery run as a Houdini fixpoint,")
(println "  seeded by the type lattice's state vars. No annotation required.")
