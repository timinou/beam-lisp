; research/p18_state_models/spike_protocol.bl
; ── P18 Rung 4: sum-typed protocol state ──────────────────────────────────
;
; State is a TAGGED VARIANT — a connection is :idle | :open | :closed. The
; invariant is about LEGAL TRANSITIONS: you can only :send while :open, only
; :open from :idle, and :closed is terminal. This is protocol / session-type
; conformance — the thing refinement (simulates?) was built to check.
;
; The encoding: a variant with a finite tag set is a PHASE, and a phase is an
; integer-coded enum (idle=0, open=1, closed=2). Then "legal transition" is an
; integer relation z3 decides — exactly the Rung-1 machinery over the phase var.
; The invariant "never :send while not :open" becomes a guard obligation:
; every :send transition must be guarded by (= phase open).
;
; We prove a correct protocol machine conforms, and catch a machine that sends
; from :closed (use-after-close — the classic protocol bug).

(ns p18.spike-protocol
  (:require [z3]))

(def port (z3/open))

; phase codes
(def IDLE 0)
(def OPEN 1)
(def CLOSED 2)

; ── conformance as a reachability / guard check ───────────────────────────
;
; A protocol machine is a set of (from-phase, guard, to-phase) transitions. The
; conformance property: a designated ACTION (here :send) may only fire from a
; designated phase (:open). We check: is there a reachable phase from which the
; action fires that is NOT the required phase? z3 decides the one-step version;
; for the machine we check every transition labelled :send.

(defn send-only-from-open? [port send-transitions]
  ; each send-transition is {:from <phase-expr>}; conformance holds iff for ALL,
  ; the from-phase is provably OPEN. We ask z3: can from ≠ OPEN? unsat ⟹ safe.
  (every?
    (fn [t]
      (let [smt (str "(declare-const phase Int)\n"
                     "(assert (= phase " (:from t) "))\n"
                     "(assert (not (= phase " OPEN ")))\n")]
        (= "unsat" (z3/check port smt))))
    send-transitions))

(println "── P18 Rung 4: sum-typed protocol conformance ──")
(println "  phases: idle=0, open=1, closed=2")
(println "  rule:   :send may only fire while :open")
(println "")

; ── a CORRECT protocol: send guarded to the open phase ────────────────────
(def good-sends [{:from OPEN}])          ; the only :send fires from :open
(def good (send-only-from-open? port good-sends))
(println (str "  correct machine (send from :open only): conforms = " good))

; ── a BUGGY protocol: a send from :closed (use-after-close) ───────────────
(def bad-sends [{:from OPEN} {:from CLOSED}])   ; a stray :send from :closed
(def bad (send-only-from-open? port bad-sends))
(println (str "  buggy machine (send also from :closed): conforms = " bad
              "  (use-after-close caught)"))
(println "")

; ── transition legality: the phase graph itself ───────────────────────────
;
; :open only from :idle; :close only from :open; :closed is terminal. Encode as
; a next-phase function and check no transition leaves the legal set. The legal
; edges: idle→open, open→closed. An illegal edge (closed→open, "reopen") must
; be caught.

(defn legal-edge? [port from to legal-pairs]
  ; legal iff (from,to) ∈ legal-pairs; z3 checks the disjunction
  (let [clauses (map (fn [p] (str "(and (= from " (first p) ") (= to " (second p) "))"))
                     legal-pairs)
        smt (str "(declare-const from Int)\n(declare-const to Int)\n"
                 "(assert (= from " from "))\n(assert (= to " to "))\n"
                 "(assert (not (or " (join " " clauses) ")))\n")]
    ; unsat ⟹ (from,to) is in the legal set
    (= "unsat" (z3/check port smt))))

(def legal [[IDLE OPEN] [OPEN CLOSED]])
(def open-from-idle (legal-edge? port IDLE OPEN legal))
(def reopen-closed  (legal-edge? port CLOSED OPEN legal))

(println "── transition legality (the phase graph) ──")
(println (str "  idle → open  is legal: " open-from-idle))
(println (str "  closed → open (reopen) is legal: " reopen-closed "  (illegal reopen caught)"))
(println "")

(def pass (and good (not bad) open-from-idle (not reopen-closed)))
(println (str (if pass "PASS" "FAIL")
              ": conformance proven; use-after-close and illegal-reopen both caught"))
(println "")
(println "∴ Rung 4 = a variant with a finite tag set is a PHASE; a phase is an")
(println "  integer-coded enum; legal-transition is an integer relation z3")
(println "  decides. Protocol conformance is Rung 1 over the phase var.")
