; research/p18_state_models/spike_records.bl
; ── P18 Rung 2: record / mixed-sort state ─────────────────────────────────
;
; Q: does the seam generalize from a tuple-of-ints to a RECORD whose fields
;    have DIFFERENT sorts — an int balance AND a bool frozen — with an
;    invariant that couples them across sorts?
;
; The claim: state is a product of typed fields; each field is its own z3 var
; of its OWN sort (Int, Bool); the invariant translates once and proves jointly.
; The key realization: smt.bl ALREADY emits true/false as SMT bool literals and
; not/and/or as passthrough ops — the ONLY thing hardcoded to Int is the
; (declare-const v Int) line. So Rung 2 = type-DIRECTED declaration: pick each
; field's sort instead of assuming Int. Translation is unchanged.
;
; The example (a freezable vault):
;   state    {:balance Int, :frozen Bool}
;   invariant (or (not frozen) (= balance 0))   "a frozen vault is empty"
;   deposit amt : guard (and (not frozen) (>= amt 0))
;                 next  {:balance (+ balance amt), :frozen frozen}
;   freeze      : guard (= balance 0)
;                 next  {:balance balance, :frozen true}
;   init         {:balance 0, :frozen false}
;
; and a BUGGY deposit that ignores the freeze (pays out while frozen) — must be
; caught, because it can make (and frozen (> balance 0)) — the invariant's
; negation.

(ns p18.spike-records
  (:require [z3]))

(def port (z3/open))

; ── sort-directed preservation ────────────────────────────────────────────
;
; `sorts` : {var → "Int"|"Bool"}   (the type-directed part — from the lattice)
; `inv`   : SMT predicate string over the state vars
; `guard` : SMT string over vars + inputs, or nil
; `nexts` : {var → next-SMT}        (unmentioned = unchanged)
; `inputs`: {var → sort}            (amounts etc.)
;
; The invariant is a define-fun over the field vars in a fixed order, so the
; primed state is checked by applying it to the primed args — no substitution.

(defn decl [n sort] (str "(declare-const " n " " sort ")\n"))

(defn preserves? [port vars sorts inv guard nexts inputs]
  (let [inv-params (join " " (map (fn [v] (str "(" v " " (get sorts v) ")")) vars))
        inv-def (str "(define-fun Inv (" inv-params ") Bool " inv ")\n")
        cur-decls (join "" (map (fn [v] (decl v (get sorts v))) vars))
        in-decls  (join "" (map (fn [p] (decl (first p) (second p))) inputs))
        pri-decls (join "" (map (fn [v] (decl (str v "2") (get sorts v))) vars))
        pri-eqs   (join "" (map (fn [v] (str "(assert (= " v "2 " (get nexts v v) "))\n")) vars))
        cur-args (join " " vars)
        pri-args (join " " (map (fn [v] (str v "2")) vars))
        smt (str inv-def cur-decls in-decls pri-decls
                 "(assert (Inv " cur-args "))\n"
                 (if guard (str "(assert " guard ")\n") "")
                 pri-eqs
                 "(assert (not (Inv " pri-args ")))\n")]
    (= "unsat" (z3/check port smt))))

(def vars ["balance" "frozen"])
(def sorts {"balance" "Int" "frozen" "Bool"})
(def inv "(or (not frozen) (= balance 0))")

(println "── P18 Rung 2: mixed-sort record state ──")
(println "  state:     {:balance Int, :frozen Bool}")
(println "  invariant: (or (not frozen) (= balance 0))   \"a frozen vault is empty\"")
(println "")

; ── the GOOD transitions ──────────────────────────────────────────────────
(def deposit-ok
  (preserves? port vars sorts inv
    "(and (not frozen) (>= amt 0))"
    {"balance" "(+ balance amt)"}           ; frozen carries through
    [["amt" "Int"]]))

(def freeze-ok
  (preserves? port vars sorts inv
    "(= balance 0)"
    {"frozen" "true"}                        ; balance carries through
    []))

(println (str "  deposit preserves invariant: " deposit-ok "   (guarded by (not frozen))"))
(println (str "  freeze  preserves invariant: " freeze-ok "   (guarded by (= balance 0))"))

; ── the BUGGY deposit — pays out while frozen, must be CAUGHT ──────────────
(def deposit-bug
  (preserves? port vars sorts inv
    "(>= amt 0)"                             ; BUG: no (not frozen) guard
    {"balance" "(+ balance amt)"}
    [["amt" "Int"]]))

(println (str "  buggy deposit preserves invariant: " deposit-bug
              "   (no (not frozen) guard — can add to a frozen vault)"))
(println "")

; a subtle check: freeze must be blocked when balance>0 (it is — guard (= balance 0)).
; and a bug where freeze ignores the balance:
(def freeze-bug
  (preserves? port vars sorts inv
    nil                                      ; BUG: freeze with no guard
    {"frozen" "true"}
    []))
(println (str "  buggy freeze (no guard) preserves invariant: " freeze-bug
              "   (freezing a non-empty vault breaks it)"))
(println "")

(def pass (and deposit-ok freeze-ok (not deposit-bug) (not freeze-bug)))
(println (str (if pass "PASS" "FAIL")
              ": mixed-sort invariant proven; both freeze-ignoring bugs caught"))
(println "")
(println "∴ Rung 2 = type-DIRECTED declaration. smt.bl already emits bool")
(println "  literals + not/and/or; only the sort of (declare-const) changes.")
(println "  Each field gets its lattice-inferred sort; the invariant proves once.")
