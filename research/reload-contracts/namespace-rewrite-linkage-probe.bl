; Read only after a benchmark has completed; never run candidate functions.
(ns tooling.rewrite-linkage-probe (:require [system.ir :as ir]))
(defn- edges [expression]
 (loop [todo (list expression) counts {} budget 10000]
  (cond
   (empty? todo) counts
   (<= budget 0) {:truncated true}
   :else
    (let [node (first todo) key (case (:op node)
                                :global [:global (:lookup node) (:ns node) (:name node)]
                                :remote [:remote (:mod node) (:fun node)] nil)]
     (recur (concat (ir/child-nodes node) (rest todo))
            (if key (update counts key (fn [n] (inc (or n 0)))) counts) (dec budget))))))
(doseq [[namespace definitions]
        [["rewrite-candidate" ["rewrite-source" "rewrite-token" "rewrite-fragment"]]
         ["reader-rewrite-candidate" ["read-form" "read-until" "read-next-string"]]]]
 (println "REWRITE-PROVIDER"
  (pr-str {:namespace namespace :loaded (BeamLisp.Env/loaded_ns? namespace)
           :ready (BeamLisp.Env/ns_ready? namespace)
           :source (BeamLisp.Loader/source_path namespace)
           :deferred (BeamLisp.Env/deferred_dirs namespace)}))
 (doseq [definition definitions]
  (let [callback (BeamLisp.Env/fetch_exact! namespace definition)
        entries (BeamLisp.Env/ns_definition namespace definition)]
   (println "REWRITE-LINKAGE"
    (pr-str {:namespace namespace :definition definition
             :function-info (mapv #(erlang/fun_info callback %) [:module :name :arity :type])
             :clauses (mapv (fn [entry]
                             {:body-module (elem entry 4)
                              :edges (edges (:body (elem entry 3)))}) entries)})))))
