; Actual native actors in small synthetic one-module application contexts.
; Compare app-local membership paging with scanning the legacy shared var table.
; No business/provider effects; no application/navigation speedup claim.
(ns research.owner-inventory-bench
 (:require [proc.owner-registry :as owners] [proc.inventory :as inventory] [bl.json :as json]))

(defserver actor (init [_] (ok nil)) (handle-call :ping [_ st] (reply :pong st)))
(defn- under [app action]
 (let [before (BeamLisp.Env/capture)]
  (try
   (Process/put :bl_generation {:application-id app :digest "synthetic-inventory-benchmark" :modules [actor]})
   (action)
   (finally (BeamLisp.Env/bind before)))))
(defn- start-many [app n] (under app #(mapv (fn [_] (core/start actor)) (range n))))
(defn- legacy [app]
 (vec (keep (fn [row]
              (let [key (elem row 0)]
               (when (and (tuple? key) (= 2 (erlang/tuple_size key))
                          (= :bl_generation_owner (elem key 0)))
                (let [entry (elem row 1)]
                 (when (and (= app (:application-id entry)) (Process/alive? (elem key 1))) entry)))))
            (ets/tab2list :beam_lisp_vars))))
(defn- measure [action iterations]
 (let [start (System/monotonic_time :microsecond)]
  (doseq [_ (range iterations)] (action))
  (/ (- (System/monotonic_time :microsecond) start) iterations)))
(defn- distribution [samples]
 (let [sorted (vec (sort samples)) last (dec (count sorted))]
  {:samples-us samples :p50-us (nth sorted (erlang/div last 2)) :p95-us (nth sorted (erlang/div (* last 95) 100))}))
(defn- phase [unrelated]
 (let [old (atom []) bounded (atom []) joined (atom []) iterations 10
       baseline #(when-not (= 20 (count (legacy "inventory-benchmark"))) (throw (ex-info "Legacy inventory mismatch" {})))
       page #(let [r (owners/page "inventory-benchmark" nil 10)]
              (when-not (and (= :more (:status r)) (= 10 (:scanned r)) (= 20 (get-in r [:receipt :total])))
               (throw (ex-info "Bounded inventory mismatch" {:result r}))))
       snapshot #(let [r (inventory/snapshot "inventory-benchmark" 10 100)]
                  (when-not (and (= :valid (:status r)) (= 20 (:scanned r)))
                   (throw (ex-info "Joined native inventory mismatch" {:result r}))))]
  (doseq [_ (range 2)] (baseline) (page) (snapshot))
  (doseq [i (range 12)]
   (if (zero? (erlang/rem i 2))
    (do (swap! old conj (measure baseline iterations)) (swap! bounded conj (measure page iterations)))
    (do (swap! bounded conj (measure page iterations)) (swap! old conj (measure baseline iterations))))
   (swap! joined conj (measure snapshot iterations)))
  {:unrelated-live-actors unrelated :target-live-actors 20
   :legacy-table-rows (ets/info :beam_lisp_vars :size)
   :ordered-index-memory-bytes (* (ets/info owners/INDEX :memory) (erlang/system_info :wordsize))
   :revision-table-memory-bytes (* (ets/info owners/META :memory) (erlang/system_info :wordsize))
   :legacy-full-membership-scan (distribution @old)
   :indexed-membership-page-10 (distribution @bounded)
   :native-authority-snapshot-20 (distribution @joined)}))

(let [output (System/get_env "BL_OWNER_BENCH_OUTPUT") _ (when-not output (throw (ex-info "Set BL_OWNER_BENCH_OUTPUT" {})))
      target (start-many "inventory-benchmark" 20) others (atom []) results (atom [])]
 (try
  (doseq [n [0 100 1000 3000]]
   (swap! others into (start-many "inventory-other" (- n (count @others))))
   (swap! results conj (phase n)))
  (let [result {:fixture "real native actors; synthetic one-module context; 20 app owners; bounded membership vs full legacy scan; joined native snapshot reported separately"
                :order "paired alternating membership paths" :warmup-per-path 2 :samples-per-path 12 :iterations-per-sample 10
                :phases @results}]
   (File/write! output (json/encode result)) (println (json/encode result)))
  (finally (doseq [pid (concat target @others)] (GenServer/stop pid)))))
