; Controlled startup measurement. Same native graph, actor and Env fork depth;
; app-scoped registration versus the existing unscoped no-registration branch.
; This isolates that branch, NOT all common dispatcher/lease/conveyance costs.
(ns research.owner-start-cost
 (:require [proc.inventory :as inventory] [reload.generation :as generation] [bl.json :as json]))

(defserver actor (init [_] (ok nil)) (handle-call :ping [_ state] (reply :pong state)))
(defn- memory [pid] (elem (erlang/process_info pid :memory) 1))
(defn- sample [pid]
 (let [dictionary (elem (erlang/process_info pid :dictionary) 1)]
  {:memory-bytes (memory pid)
   :dictionary-external-bytes (erlang/external_size dictionary)
   :largest-dictionary-values
    (vec (take 12 (reverse (sort-by :external-bytes
      (map (fn [row] {:key (Kernel/inspect (elem row 0)) :external-bytes (erlang/external_size (elem row 1))}) dictionary)))))}))
(defn- complete [app n]
 (loop [left 100]
  (let [result (inventory/snapshot app)]
   (if (or (zero? left) (and (= :valid (:status result)) (= n (count (:participants result))))) result
    (do (Process/sleep 5) (recur (dec left)))))))
(defn- one-case [enabled? iteration n]
 (let [previous (BeamLisp.Env/capture) scope (BeamLisp.Env/fork) pids (atom [])
       app (str "owner-cost." (if enabled? "enabled" "control") "." iteration)]
  (try
   (BeamLisp.Env/with_env scope
    (fn []
     (Process/put :bl_generation {:application-id (when enabled? app) :digest "synthetic-start-cost" :modules [actor]})
     (let [begin (System/monotonic_time :microsecond)
           _ (doseq [_ (range n)] (swap! pids conj (core/start actor)))
           elapsed (- (System/monotonic_time :microsecond) begin)
           result (complete app (if enabled? n 0))
           _ (when-not (and (= :valid (:status result)) (= (if enabled? n 0) (count (:participants result))))
               (do (println {:status (:status result) :observed (count (:participants result))
                             :expected (if enabled? n 0) :kind (:kind result)})
                   (throw (ex-info "Startup control did not isolate discovery" {}))))
           total (reduce + 0 (map memory @pids))
           before (sample (first @pids))
           _ (when-not (= :pong (GenServer/call (first @pids) :ping)) (throw (ex-info "Actor failed" {})))
           _ (erlang/garbage_collect (first @pids))
           after (sample (first @pids))]
      {:registration-enabled enabled? :iteration iteration :actors n
       :startup-total-us elapsed :startup-us-per-actor (/ elapsed n)
       :actor-total-memory-before-gc-bytes total
       :sample-before-gc before :sample-after-explicit-gc after})))
   (finally
    ; Control actors deliberately have no collector registration. Reclaim only
    ; their exact native lease/evidence, after stopping each real owned actor.
    (doseq [pid @pids]
     (let [row (first (ets/lookup :beam_lisp_vars (tuple :bl_generation_owner pid)))
           lease (when row (:lease (elem row 1)))]
      (when (Process/alive? pid) (GenServer/stop pid))
      (when lease (BeamLisp.Env/release_code! lease))
      (generation/owner-evidence pid)))
    (BeamLisp.Env/bind previous)
    (BeamLisp.Env/destroy scope)))))

(let [output (System/get_env "BL_OWNER_START_OUTPUT")
      _ (when-not output (throw (ex-info "Set BL_OWNER_START_OUTPUT" {})))
      results (atom [])]
 (doseq [i (range 4)]
  (doseq [enabled? (if (zero? (erlang/rem i 2)) [false true] [true false])]
   (let [result (one-case enabled? i 100)]
    (swap! results conj result)
    (println (select-keys result [:registration-enabled :iteration :startup-us-per-actor :actor-total-memory-before-gc-bytes])))))
 (let [result {:fixture "100 identical native actors per case; alternating app-scoped registration versus unscoped branch; same retained native graph leases and fork depth"
               :priv-root (BeamLisp.Tiers/priv_root)
               :scope "startup cost and sampled heap retention; explicit GC is diagnostic only, not an implemented policy"
               :results @results}]
  (File/write! output (json/encode result)) (println (json/encode result))))
