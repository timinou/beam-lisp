; Inspect the actual sealed compiler IR;never execute a candidate transform.
; This is diagnostic evidence,not a publication authorization or a new checker.
(ns reload.clause-purity-probe
 (:require [reload.generation :as g] [system.summary :as summary]
           [system.footprint :as fp] [env] [bl.json :as json]))
(def source
 "(ns clause.purity-probe)
  (defn pure [clause ctx] {:clauses (list (list 'handle-call '[:peek] '[state] (list 'reply (get ctx :name) 'state)))})
  (defn immediate [clause ctx] (System/put_env \"BL_CLAUSE_PURITY_PROBE\" \"unsafe\") {})
  (defn delayed [clause ctx] {:clauses (lazy-seq (System/put_env \"BL_CLAUSE_PURITY_PROBE\" \"unsafe\") nil)})
  (defn unknown [transform clause ctx] (transform clause ctx))
  (defn recursive [clause ctx] (recursive clause ctx))")
(let [before (System/get_env "BL_CLAUSE_PURITY_PROBE")
      graph (g/prepare! {:application-id "clause-purity-probe" :native-modules #{"System"}
                         :sources {"clause.purity-probe" source}})
      _ (assert (= before (System/get_env "BL_CLAUSE_PURITY_PROBE")) "Preparation must not execute transform effects")
      physical (get (:mapping graph) "clause.purity-probe")]
 (try
  (let [report (env/with-env (:scope graph)
                (fn []
                 (mapv (fn [definition]
                         (let [entries (BeamLisp.Env/ns_definition physical definition)]
                          {:definition definition
                           :clauses (mapv (fn [entry]
                                           (let [ir (elem entry 3) facts (summary/summarize {} (:body ir))]
                                            {:footprint (pr-str (:footprint facts))
                                             :calls (pr-str (:calls facts))
                                             :local-loop-check (:terminates facts)
                                             :returns (pr-str (:returns facts))})) entries)}))
                       ["pure" "immediate" "delayed" "unknown" "recursive"])))
        result {:scope "actual sealed ANF summaries;no transform executed;local loop checks do not establish transitive termination"
                :source source :summaries report
                :effect-environment-unchanged (= before (System/get_env "BL_CLAUSE_PURITY_PROBE"))}
        out (System/get_env "BL_CLAUSE_PURITY_REPORT")]
   (when out
    (assert (String/starts_with? (Path/expand out) (str (System/get_env "HOME") "/tmp/")) "HOME tmp output required")
    (File/write! out (json/encode result)))
   (println (json/encode result)))
  (finally (g/retire! graph))))
