; Root-only one-VM benchmark. No server, store or external provider starts.
(ns research.runtime-class-benchmark
 (:require [reload.generation :as generation] [reload.execution :as execution] [bl.json :as json]))
(defn- current [] (Process/get :bl_generation))
(defn- refuse! [kind data] (throw (ex-info "Immutable generation refused" (assoc data :kind kind))))
(defn baseline-runtime-resource
 "Read a live handle owned by this generation's initializer. Owner death,
  retired graph and missing binding fail closed, including conveyed callbacks."
 [key]
 (let [generation (current) state (when generation @(:state generation)) runtime (:runtime state)]
  (when-not (and runtime (not (:retired state)) (Process/alive? (:owner runtime))
                (contains? (:values runtime) key))
   (refuse! :missing-runtime-resource {:resource key}))
  (get (:values runtime) key)))


(defn- sample [action repetitions]
 (let [before (System/monotonic_time :microsecond)]
  (loop [remaining repetitions last-value nil]
   (if (zero? remaining)
    {:us (- (System/monotonic_time :microsecond) before) :value last-value}
    (recur (dec remaining) (action))))))
(defn- median [values] (nth (vec (sort values)) (quot (count values) 2)))
(defn- case! [size]
 (let [graph (generation/prepare! {:sources {"bench.runtime" "(ns bench.runtime) (defn entry [] :ready)"}
                                   :resources {:configuration {:benchmark-size size}}})
       payload (atom {:values (vec (range size))}) iterations 20000]
  (try
   (generation/with! graph #(generation/bind-runtime! {:bench payload}))
   (generation/with! graph
    (fn []
     ;; Warm both actual call routes, then alternate order to reduce drift.
     (sample #(baseline-runtime-resource :bench) 1000)
     (sample #(execution/runtime-resource :bench) 1000)
     (let [pairs (mapv (fn [round]
                  (let [order (if (even? round) [:baseline :current] [:current :baseline])]
                   (into {} (map (fn [version]
                    (let [r (sample (if (= :baseline version) #(baseline-runtime-resource :bench)
                                            #(execution/runtime-resource :bench)) iterations)]
                     (when-not (= payload (:value r)) (throw :wrong-runtime-handle)) [version (:us r)])) order))))
                 (range 4))
           scans (mapv (fn [_] (sample #(execution/check-runtime! graph) 5)) (range 3))
           observation (execution/runtime-inspection graph {:bench payload})]
      {"size" size "lookupIterations" iterations "pairsUs" pairs
       "baselineMedianUs" (median (map :baseline pairs)) "currentMedianUs" (median (map :current pairs))
       "validationIterations" 5 "validationUs" (mapv :us scans)
       "validationObservation" observation})))
   (finally (generation/retire! graph)))))
(println (json/encode {"kind" "runtime-class-lookup-benchmark/v1" "cases" (mapv case! [10 1000 20000])
 "method" "same VM/current graph/payload, four alternating lookup pairs; separate bounded publication scans"
 "limits" ["Lookup getter source unchanged; this is a regression benchmark, not an app speedup claim"
           "No universal postpublication protection from future raw Atom alias writes"
           "Opaque native data migration/accepted work remains separate"]}))
