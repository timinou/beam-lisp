(ns research.constructor-shadow-probe)
;; Root-only diagnostic. Every fixture must already exist at its exact selected
;; SDK source path inside an isolated archive. This prints evidence, not pass/fail.
(let [out (System/get_env "BL_CONSTRUCTOR_SHADOW_OUTPUT")
      namespaces ["research.constructor.local-native"
                  "research.constructor.local-protocol"
                  "research.constructor.referred-protocol"
                  "research.constructor.refer-all-protocol"
                  "research.constructor.explicit-loader"
                  "research.constructor.core-positive"]]
 (when-not out (throw (ex-info "Missing probe output" {:kind :missing-probe-output})))
 (doseq [namespace namespaces]
  (let [file (BeamLisp.Loader/source_path namespace)
        before (BeamLisp.Env/capture)
        provider-before (BeamLisp.Env/loaded_ns? "research.constructor.provider")
        result (try
                {:status :compiled
                 :modules (mapv first
                   (BeamLisp.AOT/compile_source (File/read! file)
                     (list (tuple :file file)
                           (tuple :output_dir (str out "/" namespace))
                           (tuple :stage-sdk? true))))}
                (catch error {:status :refused :data (ex-data error)}))]
   (println {:namespace namespace :result result
             :context-restored (= before (BeamLisp.Env/capture))
             :provider-unchanged (= provider-before
                                    (BeamLisp.Env/loaded_ns? "research.constructor.provider"))}))))
