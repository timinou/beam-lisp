; Run after coherent native/SDK acceptance. Output contains measurements only.
; Compare the same persisted rows through genuine native and managed Source
; callers. This measures admission cost; it does not claim an application win.
(ns source-storage-read-benchmark
 (:require [reload.generation :as g] [datom.store :as store]
           [datom.store-fjall :as fjall] [json]))

(defn- timed [action repeats]
 (let [before (System/monotonic_time :nanosecond)
       checksum (loop [n repeats total 0]
                 (if (= n 0) total
                  (recur (dec n) (+ total (count (action))))))]
  {:nanoseconds (- (System/monotonic_time :nanosecond) before)
   :iterations repeats :rows-read checksum}))

(let [output (System/get_env "BL_STORAGE_BENCHMARK_OUTPUT")
      _ (when-not (and output (String/starts_with? output (str (System/get_env "HOME") "/")))
          (throw (ex-info "Benchmark output must be explicitly below HOME" {})))
      generation (g/prepare!
       {:sources {"storage.benchmark"
         "(ns storage.benchmark (:require [datom.store :as store]))
          (defn read-all [s] (store/scan-datoms s nil nil))"}
        :stable-namespaces #{"datom.store"}})
      measurements (atom [])]
 (try
  (doseq [shape [:scalar :etf]]
   (let [s (fjall/open-fresh)
         rows (mapv (fn [i] [(inc i) :storage/benchmark
                            (if (= :scalar shape) i {:value i :tags [:a :b]}) 1 true]) (range 512))
         _ (store/-commit s (mapv (fn [i row] [:put (str "row-" (+ i 10000)) row]) (range 512) rows))
         native #(store/scan-datoms s nil nil)
         source #(g/invoke! generation "storage.benchmark/read-all" [s])]
    (when-not (and (= rows (native)) (= rows (source)))
     (throw (ex-info "Benchmark read mismatch" {:shape shape})))
    (dotimes [_ 2] (native) (source))
    (doseq [pair (range 4)]
     (doseq [mode (if (even? pair) [:native :source] [:source :native])]
      (let [result (timed (if (= :native mode) native source) 25)]
       (when-not (= (* 25 512) (:rows-read result)) (throw (ex-info "Benchmark checksum mismatch" {})))
       (swap! measurements conj (assoc result :shape shape :mode mode :pair pair :rows 512)))))))
  (let [result {:kind "source-storage-read-admission" :application-speedup-claim false
                :same-persisted-input true :pairs-per-shape 4 :samples @measurements}]
   (File/write! output (json/generate result))
   (println result))
  (finally (g/retire! generation))))
