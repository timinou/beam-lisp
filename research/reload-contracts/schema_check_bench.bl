; Same-VM, balanced preview benchmark. Baseline is exact pre-change source;
; both paths enforce uniqueness, cardinality-one and string values.
(ns research.schema-check-bench
 (:require [datom :as d] [datom.migrate :as migrate] [bl.json :as json]))

(defn percentile [values numerator denominator]
 (nth (vec (sort values)) (erlang/div (* (dec (count values)) numerator) denominator)))
(defn summary [values]
 {:samples values :p50-us (percentile values 1 2) :p95-us (percentile values 95 100)})
(defn measure [f c spec]
 (let [start (System/monotonic_time :microsecond) result (f c spec)
       elapsed (- (System/monotonic_time :microsecond) start)]
  (when-not (= :clean (:status result)) (throw (ex-info "Benchmark preview failed" result)))
  elapsed))

(let [path (System/get_env "BL_MIGRATE_BASELINE") inferred-path (System/get_env "BL_MIGRATE_INFERRED_BASELINE")
      output (System/get_env "BL_CONTRACT_BENCH_OUTPUT")
      _ (when-not (and path inferred-path output) (throw (ex-info "Set both benchmark baseline and output paths" {})))
      source (File/read! path)
      _ (BeamLisp.Env/with_ns (BeamLisp.Env/current_ns)
           #(BeamLisp/eval (String/replace source "(ns datom.migrate\n" "(ns datom.migrate-benchmark-baseline\n")))
      baseline (BeamLisp.Env/fetch! "datom.migrate-benchmark-baseline" "plan-with")
      _ (BeamLisp.Env/with_ns (BeamLisp.Env/current_ns)
           #(BeamLisp/eval (String/replace (File/read! inferred-path) "(ns datom.migrate\n" "(ns datom.migrate-benchmark-inferred\n")))
      inferred-baseline (BeamLisp.Env/fetch! "datom.migrate-benchmark-inferred" "plan-with")
      c (d/connect [{:db/ident :bench/value :db/valueType :db.type/string :db/cardinality :db.cardinality/many}])
      migration {:migration/id :bench/constraints
                 :migration/grows [{:db/ident :bench/value :db/valueType :db.type/string
                                    :db/unique :db.unique/identity}]}
      explicit (assoc migration :migration/checks
                  [{:check :unique :attr :bench/value} {:check :cardinality-one :attr :bench/value}
                   {:check :predicate :id :string-values
                    :fn (fn [db] (every? #(string? (first %))
                                  (d/q '[:find ?value :where [_ :bench/value ?value]] db)))}])]
 (try
  (d/transact! c (mapv (fn [i] {:db/id (- -1 i) :bench/value (str "value-" i)}) (range 1000)))
  (let [basis (d/basis-t (d/db c)) old (atom []) inferred (atom []) current (atom [])
        paths [[baseline explicit old] [inferred-baseline migration inferred] [migrate/plan-with migration current]]
        orders [[0 1 2] [0 2 1] [1 0 2] [1 2 0] [2 0 1] [2 1 0]]]
   (doseq [_ (range 2) [f spec _] paths] (measure f c spec))
   (doseq [i (range 12)]
    (doseq [index (nth orders (erlang/rem i 6))]
     (let [[f spec destination] (nth paths index)] (swap! destination conj (measure f c spec)))))
   (when-not (= basis (d/basis-t (d/db c))) (throw (ex-info "Preview benchmark mutated data" {})))
   (let [result {:fixture {:backend "ETS" :rows 1000 :attributes 1 :constraints ["unique" "cardinality-one" "string"]}
                 :baseline-source "2af85666" :inferred-baseline-source "481fb3c9"
                 :order "balanced triples; all six permutations twice" :warmup-per-path 2
                 :baseline (summary @old) :initial-inferred (summary @inferred) :inferred (summary @current)
                 :scope "warm read-only migration preflight on one fixed basis; includes query reuse; excludes commit, disk, network and page navigation"}]
    (File/write! output (json/encode result))
    (println (json/encode result))))
  (finally (d/close! c))))
