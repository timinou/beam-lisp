(ns sdk-seed-snapshot-benchmark (:require [bl.json :as json]))

(def dependencies
 [:lists :maps :file :io :code :Elixir.Enum :Elixir.Map :Elixir.String])
(def repetitions 64)
(def manifest-trace (tuple :Elixir.BeamLisp.Bootstrap :manifest 0))

(defn measure [strategy]
 (erlang/trace_pattern manifest-trace true (list :local :call_count))
 (let [start (erlang/monotonic_time :microsecond)
       reductions-before (elem (erlang/process_info (erlang/self) :reductions) 1)
       snapshot (when (= strategy :scoped) (BeamLisp.Bootstrap/manifest))]
  (try
   (dotimes [_ repetitions]
    (doseq [module dependencies]
     (let [result (if (= strategy :scoped)
                   (BeamLisp.AOT/seed_dependency_from_manifest! module snapshot)
                   (BeamLisp.AOT/seed_dependency! module))]
      (when result (throw (ex-info "Expected ordinary native dependency" {:module module}))))))
   (when snapshot (BeamLisp.AOT/assert_sdk_seed_snapshot! snapshot))
   (let [elapsed (- (erlang/monotonic_time :microsecond) start)
         reductions (- (elem (erlang/process_info (erlang/self) :reductions) 1) reductions-before)
         observed (erlang/trace_info manifest-trace :call_count)
         expected (if (= strategy :scoped) 2 (* repetitions (count dependencies)))]
    (when-not (= (tuple :call_count expected) observed)
     (throw (ex-info "Actual bootstrap-read count mismatch" {:expected expected :actual observed})))
    {:strategy strategy :elapsedUs elapsed :processReductions reductions
     :actualManifestCalls expected :dependencyLookups (* repetitions (count dependencies))})
   (finally (erlang/trace_pattern manifest-trace false (list :local :call_count))))))

(let [manifest (BeamLisp.Bootstrap/manifest)
      before (ets/lookup :beam_lisp_vars :bl_sdk_runtime_lease)
      _ (doseq [module dependencies]
          (when (get (get manifest "modules") (str (Atom/to_string module) ".beam"))
           (throw (ex-info "Native control is a seed artifact" {:module module}))))
      rows (mapv measure [:per-import :scoped :scoped :per-import
                          :scoped :per-import :per-import :scoped])
      _ (when-not (= before (ets/lookup :beam_lisp_vars :bl_sdk_runtime_lease))
          (throw (ex-info "Benchmark changed SDK custody" {})))
      receipt {:acceptance false :benchmark true
       :scope "Same-VM algorithm comparison: ordinary native dependency lookups only; not whole startup/navigation"
       :baseline "Existing one-arity helper rereads native manifest per import"
       :candidate "Captured manifest plus final native drift recheck; selected artifact checks unchanged"
       :sdkLeaseUnchanged true :samples rows}
      path (System/fetch_env! "BL_SEED_SNAPSHOT_BENCHMARK_RECEIPT")]
 (when-not (String/starts_with? path "/home/user/tmp/")
  (throw (ex-info "Expected HOME-local benchmark output" {})))
 (File/write! path (json/encode receipt))
 (println receipt))
