; Inspect compiler-resolved registration shapes;never invoke a tx callback or
; execute a registration to discover whether it is safe.
(ns reload.tx-declaration-probe
 (:require [reload.generation :as g] [env] [bl.json :as json]))
(def SOURCE
 "(ns tx.catalog-probe (:require [datom :as d] [datom.tx :as tx]))
  (defn callback [db amount] [[:db/add 1 :amount amount]])
  (defn public-registration [] (d/register-tx-fn! :probe/public callback))
  (defn low-registration [] (tx/register-fn! :probe/low callback))
  (defn dynamic-registration [key f] (d/register-tx-fn! key f))
  (defn quoted [] '(d/register-tx-fn! :inert callback))")
(let [graph (g/prepare! {:application-id "tx-catalog-probe"
                        :stable-namespaces #{"datom" "datom.tx"}
                        :sources {"tx.catalog-probe" SOURCE}})]
 (try
  (let [physical (get (:mapping graph) "tx.catalog-probe")
        compiled (env/with-env (:scope graph)
                   #(into {} (map (fn [name]
                                    [name (pr-str (BeamLisp.Env/ns_definition physical name))])
                                  ["callback" "public-registration" "low-registration"
                                   "dynamic-registration" "quoted"])))
        result {:scope "actual prepared function IR;no registration/callback/transaction invoked"
                :source SOURCE :compiled compiled}
        path (System/get_env "BL_TX_DECLARATION_REPORT")]
   (when path
    (assert (String/starts_with? (Path/expand path) (str (System/get_env "HOME") "/tmp/"))
            "HOME tmp output required")
    (File/write! path (json/encode result)))
   (println (json/encode result)))
  (finally (g/retire! graph))))
