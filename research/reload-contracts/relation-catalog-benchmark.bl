; Same-process control:mutable Agent dispatch vs exact graph declarations.
; Five alternating-order warmed samples;not a navigation or provider benchmark.
(ns reload.relation-catalog-benchmark
 (:require [reload.generation :as g] [datom.query.relation :as rel] [bl.json :as json]))
(def ident :~benchmark/value)
(def iterations 1000)
(defn proposal [seed]
 {:application-id "relation-benchmark" :stable-namespaces #{"datom.query.relation"}
  :sources {"benchmark.relation"
   (str "(ns benchmark.relation (:require [datom.query.relation :as rel])) "
        "(def seed " seed ") (rel/defrelation :~benchmark/value {:arity 2 :provider (fn [_ _ _ _] [[1 seed]])}) "
        "(defn run [] (rel/eval-relation nil :~benchmark/value [] {}))")}})
(defn reductions [] (elem (erlang/process_info (erlang/self) :reductions) 1))
(defn sample [label action]
 (let [r (reductions) t (System/monotonic_time :microsecond)
       result (loop [n iterations total 0]
                (if (zero? n) total (recur (dec n) (+ total (action)))))]
  (assert (= (* iterations 42) result) "Benchmark work must execute and return the expected value")
  {:method label :iterations iterations :microseconds (- (System/monotonic_time :microsecond) t)
   :caller-reductions (- (reductions) r) :checksum result}))
(def seed 42)
(rel/register-relation! ident {:arity 2 :provider (fn [_ _ _ _] [[1 seed]])})
(BeamLisp.Loader/ensure_loaded "reload.generation")
(let [t (System/monotonic_time :microsecond) graph (g/prepare! (proposal 42))
      prepare-us (- (System/monotonic_time :microsecond) t)
      global (fn [] (second (first (rel/eval-relation nil ident [] {}))))
      managed (fn [selected label]
                (g/with! selected
                 (fn [] (sample label (fn [] (second (first (rel/eval-relation nil ident [] {}))))))))
      cached (fn [] (managed graph :managed-cached))
      uncached (fn [] (managed (dissoc graph :callables) :managed-uncached))]
 (try
  (sample :development-warmup global)
  (cached) (uncached)
  (let [samples (mapv (fn [index]
                       (if (even? index)
                        [(sample :development-agent global) (uncached) (cached)]
                        [(cached) (uncached) (sample :development-agent global)])) (range 5))
        result {:scope "same-process paired catalogue dispatch;development Agent vs managed immutable graph,not browser latency"
                :warmups-per-method 1 :pairs 5 :iterations-per-sample iterations
                :cold-prepare-microseconds prepare-us
                :preparation-note "framework loaded before timer;one fresh native graph compilation"
                :control-note "cached and uncached execute identical managed code and graph;uncached benchmark removes only the validated callable binding map"
                :agent-work-note "caller reductions exclude work in the separate registry Agent"
                :samples samples}
        out (System/get_env "BL_RELATION_BENCH_REPORT")]
   (when out
    (assert (String/starts_with? (Path/expand out) (str (System/get_env "HOME") "/tmp/")) "HOME tmp output required")
    (File/write! out (json/encode result)))
   (println (json/encode result)))
  (finally (g/retire! graph))))
