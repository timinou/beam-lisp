; Bounded same-VM ABBA comparison of reviewed old/new actual Reader and pure
; namespace-rewrite algorithms. No application evaluation,graph preparation,
; listener/store/provider effects or giant legacy source benchmark.
(ns reload.rewrite-benchmark (:require [env] [proc.fence :as fence] [bl.json :as json]))
(def DIR (System/get_env "BL_REWRITE_PROTOTYPE_DIR"))
(assert (and DIR (String/starts_with? (Path/expand DIR) (str (System/get_env "HOME") "/tmp/"))))
(doseq [file ["reader-rewrite-baseline.bl" "reader-rewrite-candidate.bl"
              "rewrite-baseline.bl" "rewrite-candidate.bl"]]
 (let [previous (env/capture)]
  (try (env/eval (File/read! (str DIR "/" file))) (finally (env/bind previous)))))
(def MAPPING {"rewrite.a" "sealed.fixed.rewrite.a" "rewrite.b" "sealed.fixed.rewrite.b"})
(defn- fetch [namespace name] (BeamLisp.Env/fetch_exact! namespace name))
(def IMPLEMENTATIONS
 (into {} (map (fn [label]
                [label {:rewrite (fetch (str "rewrite-" label) "rewrite-source")
                        :stream (fetch (str "reader-rewrite-" label) "stream")
                        :next (fetch (str "reader-rewrite-" label) "read-next-string")}])
              ["baseline" "candidate"])))
(defn- hash [text] (String/downcase (Base/encode16 (crypto/hash :sha256 text))))
(defn- wide [n]
 (str "(ns rewrite.a (:require [rewrite.b]))\n(defn f [] ["
      (join " " (repeat n "(rewrite.b/x)")) "])\n"))
(defn- nested [depth]
 (str "(ns rewrite.a (:require [rewrite.b]))\n(defn f [] "
      (join "" (repeat depth "(identity "))
      "[(rewrite.b/x) (rewrite.b/x) (rewrite.b/x) (rewrite.b/x)]"
      (join "" (repeat depth ")")) ")\n"))
(defn- streamed [implementation source]
 (loop [cursor ((:stream implementation) source nil) n 0]
  (let [result ((:next implementation) cursor)]
   (if (= :eof (first result)) n (recur (nth result 3) (inc n))))))
(defn- once [phase label source n index]
 (let [implementation (get IMPLEMENTATIONS label)
       before (erlang/system_info :atom_count)
       result (fence/fence-fn 5000
                (fn []
                 (let [start (erlang/monotonic_time :microsecond)
                       value (if (= phase "reader-wide") (streamed implementation source)
                               ((:rewrite implementation) source nil MAPPING))
                       us (- (erlang/monotonic_time :microsecond) start)]
                  {:microseconds us
                   :result (if (string? value) (hash value) value)
                   :output-bytes (when (string? value) (erlang/byte_size value))})))
       growth (- (erlang/system_info :atom_count) before)
       report (merge {:phase phase :implementation label :size n :sample index
                      :input-bytes (erlang/byte_size source) :atom-growth growth}
                     (if (contains? result :ok) (assoc (:ok result) :status :completed)
                      {:status (if (:timeout result) :timeout :crashed) :budget-ms 5000}))]
  ;; No source-dependent atom/module names are created by these pure algorithms.
  ;; A small fixed allowance covers lazy native infrastructure after warmup.
  (when (>= index 0)
   (assert (<= growth 64) "Unexpected atom growth in source-only rewrite benchmark"))
  (println "REWRITE-SAMPLE" (pr-str report)) report))

; Warm all four algorithm paths before observing timings/atom growth.
(doseq [label ["baseline" "candidate"]]
 (once "reader-wide" label (join " " (repeat 16 "leaf")) 16 -1)
 (once "namespace-wide" label (wide 4) 4 -1))
(let [samples (vec
               (mapcat (fn [[phase sizes generator]]
                         (mapcat (fn [n]
                                   (map-indexed (fn [index label]
                                                  (once phase label (generator n) n index))
                                                ["baseline" "candidate" "candidate" "baseline"])) sizes))
                       [["reader-wide" [512 1024 2048] (fn [n] (join " " (repeat n "leaf")))]
                        ["namespace-wide" [32 128 512] wide]
                        ["namespace-nested" [2 8 16] nested]]))
      grouped (group-by (fn [row] [(:phase row) (:size row)]) samples)
      checks (mapv (fn [[key rows]]
                     (let [completed (filterv #(= :completed (:status %)) rows)
                           exact? (and (= 4 (count completed))
                                       (= 1 (count (set (map :result completed)))))]
                      {:fixture key :exact-equivalence exact?
                       :bounded (every? #(contains? #{:completed :timeout} (:status %)) rows)})) grouped)
      snapshots (into {} (map (fn [file] [file (hash (File/read! (str DIR "/" file)))])
                        ["reader-rewrite-baseline.bl" "reader-rewrite-candidate.bl"
                         "rewrite-baseline.bl" "rewrite-candidate.bl"]))
      report {:scope "offline source-only Reader and namespace rewrite;no page-navigation inference"
              :ordering "ABBA per shape/size;5s individual pure sample cap"
              :snapshot-sha256 snapshots :samples samples :controls checks}
      destination (System/get_env "BL_REWRITE_REPORT")]
 (when destination
  (assert (String/starts_with? (Path/expand destination) (str (System/get_env "HOME") "/tmp/")))
  (File/write! destination (json/encode report)))
 (println "REWRITE-CONTROLS" (pr-str checks))
 (assert (every? :bounded checks) "A source algorithm crashed")
 ;; Censored controls are explicit timeout evidence;never a fabricated speedup.
 (doseq [[key rows] grouped]
  (when (every? #(= :completed (:status %)) rows)
   (assert (= 1 (count (set (map :result rows)))) "Old/new source semantics differ")))
 :ok)
