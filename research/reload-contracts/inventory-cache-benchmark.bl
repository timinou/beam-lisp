; Controlled same-VM comparison. BL_INVENTORY_BASELINE points to a trusted SDK
; source snapshot renamed reload.generation-inventory-baseline, with only the
; two checker inventory calls changed to bypass the private cache. No production
; option/authority bypass is added. Both implementations compile identical actor
; source and retire every graph; distinct application IDs prevent prepared reuse.
(ns inventory-cache-benchmark (:require [reload.generation :as generation] [env]
                                        [proc.server] [proc.reconcile] [proc.queue] [proc.tick]))

(def SOURCE
 "(ns owned.reconciler (:require [proc.server :as server]))
  (defn config-for [srv policy] {:marker :benchmark})
  (server/defserver runtime (reconcile {:config-fn config-for :level nil}))")

(defn- sample [prepare retire label index]
 (let [start (erlang/monotonic_time :microsecond)
       graph (prepare {:application-id (str "inventory-benchmark-" label "-" index)
                       :stable-namespaces #{"proc.server" "proc.reconcile" "proc.queue" "proc.tick"}
                       :sources {"owned.reconciler" SOURCE}})
       elapsed (- (erlang/monotonic_time :microsecond) start)]
  (try
   {:implementation label :sample index :microseconds elapsed
    :metrics (:preparation-metrics graph) :modules (count (:modules graph))
    :declarations (count (get-in graph [:declarations :reconcile]))}
   (finally
    (let [result (retire graph)]
     (when-not (contains? #{:retired :already-retired} (:status result))
      (throw (ex-info "Benchmark graph did not retire" result))))))))

(let [file (System/get_env "BL_INVENTORY_BASELINE")
      _ (when-not file (throw "Set BL_INVENTORY_BASELINE to the reviewed SDK snapshot"))
      _ (env/eval (File/read! file))
      off-prepare (BeamLisp.Env/fetch_exact! "reload.generation-inventory-baseline" "prepare!")
      off-retire (BeamLisp.Env/fetch_exact! "reload.generation-inventory-baseline" "retire!")
      implementations {"on" [generation/prepare! generation/retire!] "off" [off-prepare off-retire]}]
 (doseq [[index order] [[0 ["on" "off"]] [1 ["off" "on"]]]]
  (doseq [label order]
   (let [[prepare retire] (get implementations label)]
    (println "inventory-cache-benchmark" (sample prepare retire label index))))))
