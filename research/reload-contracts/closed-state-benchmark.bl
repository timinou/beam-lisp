; Run in one capped sandbox VM. Optional BL_CLOSED_NATIVE_BASELINE points to a
; saved pre-change evaluator renamed eval.closed-native-cells-baseline. Neither
; benchmark compiles model source; env/eval loads only this trusted SDK baseline.
(ns closed-state-benchmark (:require [eval.closed :as closed] [env]))

(defn- sample [run n]
 (let [source (str "(reduce + 0 (take " n " (range)))")
       start (erlang/monotonic_time :microsecond)
       result (run source {:timeout-ms 2500})]
  {:n n :status (:status result) :value (:value result) :steps (:steps result)
   :microseconds (- (erlang/monotonic_time :microsecond) start)}))

(let [baseline (when-let [file (System/get_env "BL_CLOSED_NATIVE_BASELINE")]
                 (env/eval (File/read! file))
                 (BeamLisp.Env/fetch_exact! "eval.closed-native-cells-baseline" "run"))]
 (doseq [[name run] (concat (when baseline [["native-cell-registry" baseline]]) [["process-owned-registry" closed/run]])]
  (run "(+ 20 22)")
  (doseq [n [128 256 512]]
   (let [samples (mapv (fn [_] (sample run n)) (range 3))]
    (println "closed-state-benchmark" {:implementation name :samples samples
              :median-microseconds (nth (sort (map :microseconds samples)) 1)})))))
