; Paired Native/Source callback boundary cost only. Preparation is OUTSIDE
; Source for BOTH domains. Genuine current SDK/G preparation; no imported lease.
(ns prepared-callback-argument-benchmark
 (:require [reload.generation :as g] [reload.prepared-callback-fixture :as sdk]))
(defn- prepare-arm [f arity]
 (erlang/apply :Elixir.BeamLisp.Ns.Rt :"call-prepare-callback" (list f arity)))
(let [graph (g/prepare!
              {:application-id (str "prepared-bench-" (erlang/unique_integer (list :positive)))
               :sources {"prepared.benchmark"
                 "(ns prepared.benchmark (:require [reload.prepared-callback-fixture :as sdk]))
                  (defn run [prepared arity repeats] (sdk/benchmark-prepared prepared arity repeats))"}
               :stable-namespaces #{"reload.prepared-callback-fixture"}})
      unary (prepare-arm sdk/add-one 1) binary (prepare-arm sdk/add-two 2)
      samples (atom []) repeats 1000]
 (try
  (doseq [round [1 2 3 4] [arity prepared] [[1 unary] [2 binary]]
          domain (if (odd? round) [:native :source] [:source :native])]
   (let [run (fn []
               (if (= domain :source)
                 (g/invoke! graph "prepared.benchmark/run" [prepared arity repeats])
                 (g/with! graph #(sdk/benchmark-prepared prepared arity repeats))))
         _ (run)
         result (run)]
    (when-not (and (= repeats (:answer result)) (= repeats (:repeats result))
                   (= (= domain :source) (:source-active result)))
     (throw (ex-info "Prepared callback benchmark domain/result mismatch" {:kind :prepared-callback-benchmark-failed})))
    (swap! samples conj (assoc result :arity arity :round round :domain domain :prepared-outside-source true))))
  (let [receipt {:scope "Paired sameVM callback boundary cost only; no SDK stage/startup/navigation benchmark"
                 :acceptance false :samples @samples :samples-count (count @samples)
                 :repeats-per-sample repeats :preparation-outside-source true}
        output (System/get_env "BL_PREPARED_CALLBACK_BENCHMARK_RECEIPT")]
   (when-not (and output (= 16 (count @samples)))
    (throw (ex-info "Prepared callback benchmark receipt path/count missing" {:kind :prepared-callback-benchmark-failed})))
   (File/write! output (Jason/encode! receipt))
   (println {:prepared-callback-benchmark {:samples 16 :repeats repeats :acceptance false}}))
  (finally (g/retire! graph))))
