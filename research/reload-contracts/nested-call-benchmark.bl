; Real native graph leases; synthetic namespaces isolate binding overhead.
(ns research.nested-call-benchmark (:require [reload.generation :as g] [bl.json :as json]))
(let [count-ns 32 iterations 1000 samples 5
      padding (into {} (mapv (fn [n]
                        (let [name (str "nested.padding" n)]
                         [name (str "(ns " name ") "
                                "(defn a [] :a) (defn b [] :b) (defn c [] :c) (defn d [] :d)")])) (range count-ns)))
      graph (g/prepare! {:sources (assoc padding "nested.benchmark" "(ns nested.benchmark) (defn run [] :done)")})
      run (fn [] (g/with! graph (fn [] (doseq [_ (range iterations)] (g/invoke! graph "nested.benchmark/run" [])))))
      destination (System/get_env "BL_NESTED_BENCH_OUTPUT")]
 (try
  (run)
  (let [measurements (mapv (fn [_]
                        (let [before (elem (Process/info (erlang/self) :reductions) 1)
                              started (System/monotonic_time :microsecond)
                              _ (run)
                              elapsed (- (System/monotonic_time :microsecond) started)
                              reductions (- (elem (Process/info (erlang/self) :reductions) 1) before)]
                         {:us elapsed :reductions reductions})) (range samples))
        result {:kind "synthetic native nested graph binding; not page latency"
                :namespaces (inc count-ns) :modules (count (:modules graph))
                :calls-per-sample iterations :samples measurements
                :registrations-after (:registrations (g/evidence graph))}]
   (println (pr-str result))
   (when destination (File/write! destination (json/encode result))))
  (finally (g/retire! graph))))
