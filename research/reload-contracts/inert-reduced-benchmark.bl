; Paired sustained Source extent versus Native SDK traversal with the SAME
; actual Source-owned reducer. No SDK-stage/startup/navigation claim.
(ns inert-reduced-benchmark
 (:require [reload.generation :as g] [reload.inert-reduced-fixture :as sdk]))
; Deliberately own a fresh genuine graph; do not call private test helpers.
(let [graph (g/prepare!
             {:application-id (str "inert-benchmark-" (erlang/unique_integer (list :positive)))
              :sources {"inert.benchmark.app"
               "(ns inert.benchmark.app (:require [reload.inert-reduced-fixture :as sdk]))
                (defn reducer [] (fn [acc item] [acc item]))
                (defn benchmark [n] (sdk/benchmark-growing (fn [acc item] [acc item]) n))"}
              :stable-namespaces #{"reload.inert-reduced-fixture"}})
      reducer (g/invoke! graph "inert.benchmark.app/reducer" [])
      samples (atom [])]
 (try
  (doseq [round [1 2 3 4] n [4096 32768]
          domain (if (odd? round) [:native :source] [:source :native])]
   (let [run (fn []
              (if (= domain :source)
               (g/invoke! graph "inert.benchmark.app/benchmark" [n])
               (g/with! graph #(sdk/benchmark-growing reducer n))))
         _ (run) result (run)]
    (when-not (and (= n (:depth result)) (= (quot (* n (dec n)) 2) (:sum result))
                   (:empty-leaf result) (= (= domain :source) (:source-active result)))
     (throw (ex-info "Inert reduced benchmark mismatch" {:kind :inert-reduced-benchmark-failed})))
    (swap! samples conj (assoc result :round round :domain domain))))
  (let [output (System/get_env "BL_INERT_REDUCED_BENCHMARK_RECEIPT")
        receipt {:scope "sameVM warm growing nested-vector fold; input creation excluded; sustained Source extent versus Native SDK traversal, both use genuine Source-owned reducers"
                 :acceptance false :samples-count (count @samples) :samples @samples
                 :sizes [4096 32768] :rounds 4 :warmups-per-sample 1
                 :flat-source-large-fold-proven false}]
   (when-not (and output (= 16 (count @samples)))
    (throw (ex-info "Inert reduced benchmark receipt missing" {:kind :inert-reduced-benchmark-failed})))
   (File/write! output (Jason/encode! receipt))
   (println {:inert-reduced-benchmark {:samples 16 :acceptance false}}))
  (finally (g/retire! graph))))
