; offload_run.bl — drive the gated native-offload pipeline end to end.
;
; Loads the shipped engines + native.eligible + lower2 + the offload
; orchestrator, then runs the flow on an ELIGIBLE kernel (checksum) and a
; REFUSED one (dot, which calls nth — outside the arithmetic fragment), printing
; the measured BEAM-vs-Cranelift speedup gated on the differential oracle.

(ns offrun (:require [env]))

; the shipped engines lower2 + eligible depend on
(env/eval (second (File/read "priv/lib/system/ir.bl")))
(env/eval (second (File/read "priv/lib/system/footprint.bl")))
(env/eval (second (File/read "priv/lib/system/summary.bl")))
(env/eval (second (File/read "priv/lib/system/analyze.bl")))
(env/eval (second (File/read "priv/lib/system/smt.bl")))
(env/eval (second (File/read "priv/std/termination.bl")))
(env/eval (second (File/read "priv/lib/native/eligible.bl")))
(env/eval (second (File/read "research/lowerers_spike/lower2.bl")))
(env/eval (second (File/read "research/native-offload/offload.bl")))

; interned entry points
(def eligible-fn (BeamLisp.Env/fetch! "native.eligible" "eligible"))
(def lower-fn    (BeamLisp.Env/fetch! "lower2" "lower-kernel"))
(def irtext-fn   (BeamLisp.Env/fetch! "lower2" "ir-text"))
(def offload!    (BeamLisp.Env/fetch! "offload" "offload!"))

; the kernels, as WHOLE programs (eligible analyses the program; lower reads the fn)
(def checksum-prog
  "(defn checksum [buf n]
     (loop [i 0 acc 0]
       (if (< i n) (recur (+ i 1) (+ (* 31 acc) (binary/at buf i))) acc)))")

(def dot-prog
  "(defn dot [xs ys n]
     (loop [i 0 acc 0]
       (if (< i n) (recur (+ i 1) (+ acc (* (nth xs i) (nth ys i)))) acc)))")

(defn show [r]
  (println "─────────────────────────────────────────")
  (if (not (:ran? r))
    (println (str "  " (:name r) ": REFUSED by the gate — " (pr-str (:reason r))
                  (if (:detail r) (str " " (pr-str (:detail r))) "")))
    (do
      (println (str "  " (:name r) ": ELIGIBLE → lowered (" (:ir-lines r) " IR lines) → JIT"))
      (println (str "    differential oracle: BEAM=" (:beam-value r)
                    "  JIT=" (:jit-value r)
                    "  " (if (:oracle-ok r) "✓ IDENTICAL" "✗ MISMATCH")))
      (println (str "    BEAM interp: " (:beam-us r) " µs   |   " (:jit-raw r))))))

(println "══ proof-directed native offload — the whole gated pipeline ══")
(show (offload! eligible-fn lower-fn irtext-fn checksum-prog "checksum" checksum-prog))
(show (offload! eligible-fn lower-fn irtext-fn dot-prog "dot" dot-prog))
