(ns p19.smoke-functor (:require [system.smt :as smt] [system.core :as sys] [z3]))
(defn- r [s] (first (BeamLisp.Reader/read_string s)))

(println "sort-of-value 1.5   :" (smt/sort-of-value (r "1.5")))
(println "sort-of-value true  :" (smt/sort-of-value (r "true")))
(println "sort-of-value \"hi\"  :" (smt/sort-of-value (r "\"hi\"")))
(println "sort-of-value 42    :" (smt/sort-of-value (r "42")))
(println "translate float     :" (smt/of-source #{} "(>= rate 0.05)"))
(println "translate str-contains:" (smt/of-source #{"reply"} "(str-contains? reply \"ok\")"))
(println "translate str-len   :" (smt/of-source #{"name"} "(>= (str-len name) 1)"))

; end-to-end: a Real-valued interest-rate machine. balance:Real, rate:Real.
; invariant: rate stays non-negative; accrue multiplies — Real arithmetic.
(def port (z3/open))
(def acct
  "(defserver ^{:invariant (>= rate 0.0)} rated
     (init [b] (ok {:balance b :rate 0.05}))
     (handle-call [:accrue] [_ {:keys [balance rate]}] :when (>= rate 0.0)
       (reply :ok {:balance (+ balance (* balance rate)) :rate rate})))")
(def res (sys/verify-process port (r acct)))
(println "\nReal-machine checked:" (:checked res) " holds:" (:holds res)
         " sorts-carry-Real (else untranslatable if forced Int)")
:ok
