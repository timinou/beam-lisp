(ns p2corpus (:require [reader :as r] [self.oracle :as o]))
(defn wildcard [pat]
  (map (fn [cs] (erlang/list_to_binary cs))
       (filelib/wildcard (erlang/binary_to_list pat))))
(defn check-file [path]
  (let [src (File/read! path)]
    (try
      (let [want (BeamLisp.Reader/read_all src)
            got  (r/read-all src)]
        (if (o/forms-equal? want got)
          {:path path :status :ok}
          {:path path :status :mismatch :diff (:index (o/first-diff want got))}))
      (catch e {:path path :status :error}))))
(def files
  (concat (wildcard "priv/**/*.bl") (wildcard "examples/**/*.bl")
          (wildcard "test/bl/**/*.bl") (wildcard "bench/**/*.bl")))
(def results (into [] (map check-file files)))
(println "total:" (count files)
         " OK:" (count (filter (fn [x] (= :ok (:status x))) results))
         " MISMATCH:" (count (filter (fn [x] (= :mismatch (:status x))) results))
         " ERROR:" (count (filter (fn [x] (= :error (:status x))) results)))
(println "--- mismatches ---")
(doseq [m (filter (fn [x] (= :mismatch (:status x))) results)]
  (println "  MISMATCH" (:path m) "@form" (:diff m)))
(println "--- errors ---")
(doseq [e (filter (fn [x] (= :error (:status x))) results)]
  (println "  ERROR" (:path e)))
