; END-TO-END: the .bl compiler compiles code, then we EVAL its output and run it.
; This proves the compiler doesn't just MATCH the oracle's AST — it produces
; working code the BEAM actually runs.
(ns e2e (:require [compiler :as c]))
(def kenv (assoc (c/new-env "user") :ns "user"))
(defn run [src]
  (let [form (BeamLisp.Reader/read_one src)
        ast (c/compile form kenv)]
    ; eval the .bl-compiler-produced AST via Elixir
    (first (erlang/tuple_to_list (Code/eval_quoted ast)))))
(println "(+ 1 2) =>" (run "(+ 1 2)"))
(println "(let [x 5 y 3] (* x y)) =>" (run "(let [x 5 y 3] (* x y))"))
(println "((fn [n] (if (< n 2) 1 n)) 5) =>" (run "((fn [n] (if (< n 2) 1 n)) 5)"))
(println "(if (> 3 2) :yes :no) =>" (run "(if (> 3 2) :yes :no)"))
(println "(str \"a\" \"b\" \"c\") =>" (run "(str \"a\" \"b\" \"c\")"))
(println "loop-sum =>" (run "(loop [i 0 acc 0] (if (< i 10) (recur (+ i 1) (+ acc i)) acc))"))
