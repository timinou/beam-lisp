(ns p5param (:require [compiler :as c] [self.oracle :as o]))
(def env (BeamLisp.Compiler/new_env "user"))
(def kenv (c/new-env "user"))
(def pass (atom 0)) (def fail (atom 0))
(defn check [src]
  (try
    (let [f (BeamLisp.Reader/read_one src)]
      (if (o/ast-equal? (o/oracle-compile f env) (c/compile f kenv))
        (swap! pass inc) (do (swap! fail inc) (println "FAIL ::" src))))
    (catch e (do (swap! fail inc) (println "ERR  ::" src)))))
(doseq [s (list
  "(fn [{:keys [x]}] x)"
  "(fn [{:keys [x y]}] (+ x y))"
  "(fn [[a b]] (+ a b))"
  "(fn [{:keys [host port] :or {port 80}}] port)"
  "(fn [a {:keys [x]}] (+ a x))"
  "(fn [[a & rest]] rest)"
  "(fn [{p :port}] p)")]
  (check s))
(println "PASS:" (deref pass) "FAIL:" (deref fail))
