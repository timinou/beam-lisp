; P12c — AST post-processing as an optics traversal (Nugget 7).
; The kernel stamps source locations by hand-rolled recursion. Tier-1 can
; express the same as an optics `over`: "walk to every node of a shape, apply
; a transform" — composable data, not buried recursion.
(ns p12copt (:require [optics :as op] [reader-node :as rn]))

; A traversal over the ELEMENTS of a reader list node: its focus is every
; child, and `over` maps a transform across them, rebuilding the node.
(def list-items
  {:view (fn [n] (rn/node-items n))
   :over (fn [f n] (rn/list-node (map f (rn/node-items n))))
   :traversal true})

; stamp: mark each child (here, tag it — a stand-in for line/col stamping)
(defn stamp-tag [child]
  (if (= :symbol (rn/node-tag (rn/node-form child)))
    (str "sym:" (rn/node-name (rn/node-form child)))
    (rn/node-tag (rn/node-form child))))

(def form (BeamLisp.Reader/read_one "(foo a b c)"))
(println "AST post-processing as an optics traversal:")
(println "  view all children:" (into [] (op/view list-items form)))
(println "  over stamp each child:" (into [] (op/view list-items (op/over list-items
  (fn [c] c) form))))
(println "  stamped tags:" (into [] (map stamp-tag (op/view list-items form))))
(println)
(println "  A compiler pass = path + transform. `over list-items stamp` replaces")
(println "  hand-rolled recursion with one composable optic. The full deep-walk")
(println "  traversal (all-list-nodes, recursive) composes the same way.")
