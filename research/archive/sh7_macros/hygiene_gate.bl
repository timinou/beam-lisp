(ns p7hyg (:require [compiler :as c] [self.oracle :as o]))
(def env (BeamLisp.Compiler/new_env "user"))
(def kenv (c/new-env "user"))
(def pass (atom 0)) (def fail (atom 0))
(defn check [src]
  (try (if (o/ast-equal? (o/oracle-compile (BeamLisp.Reader/read_one src) env)
                         (c/compile (BeamLisp.Reader/read_one src) kenv))
         (swap! pass inc) (do (swap! fail inc) (println "FAIL ::" src)))
    (catch e (do (swap! fail inc) (println "ERR  ::" src)))))
; the documented hygiene case: (let [and-tmp 5] (and 1 and-tmp)) must not capture
(check "(let [and-tmp 5] (and 1 and-tmp))")
(check "(and 1 2 3)")
(check "(or nil false 3)")
(check "(when-let [x (foo)] x)")
(check "(if-let [x (foo)] x y)")
(check "(cond (< x 0) :neg (> x 0) :pos :else :zero)")
(check "(-> x (foo 1) (bar 2))")
(check "(->> xs (map inc) (filter odd?))")
(check "(defmacro unless [c & body] `(if ~c nil (do ~@body)))")
(check "(doto x (foo) (bar))")
(println "PASS:" (deref pass) "FAIL:" (deref fail))
