(ns p9nat (:require [compiler :as c] [self.oracle :as o]))
(def env (BeamLisp.Compiler/new_env "user"))
(def kenv (c/new-env "user"))
(defn check [src]
  (try (println (if (o/ast-equal? (o/oracle-compile (BeamLisp.Reader/read_one src) env)
                                  (c/compile (BeamLisp.Reader/read_one src) kenv)) "OK  " "FAIL") "::" src)
    (catch e (println "ERR  ::" src))))
(check "(defnative \"mycrate\" (add 2) (sub 2))")
(check "(defnative \"foo\" (bar 1))")
