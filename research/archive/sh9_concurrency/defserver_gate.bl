(ns p9srv (:require [compiler :as c] [self.oracle :as o]))
(def env (BeamLisp.Compiler/new_env "user"))
(def kenv (c/new-env "user"))
(defn check [src]
  (try (println (if (o/ast-equal? (o/oracle-compile (BeamLisp.Reader/read_one src) env)
                                  (c/compile (BeamLisp.Reader/read_one src) kenv)) "OK  " "FAIL") "::" src)
    (catch e (println "ERR  ::" src))))
(check "(defserver counter (init [n] (ok n)))")
(check "(defserver counter (init [n] (ok n)) (handle-call :get [from state] (reply state state)))")
(check "(defserver kv (init [_] (ok {})) (handle-cast [:put k v] [state] (noreply state)))")
