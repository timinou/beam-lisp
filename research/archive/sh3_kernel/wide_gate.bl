(ns p3wide (:require [compiler :as c] [self.oracle :as o]))
(def env (BeamLisp.Compiler/new_env "user"))
(def kenv (c/new-env "user"))
(def pass (atom 0)) (def fail (atom 0))
(defn check [src]
  (let [form (BeamLisp.Reader/read_one src)
        want (o/oracle-compile form env)
        got  (c/compile form kenv)]
    (if (o/ast-equal? want got)
      (swap! pass inc)
      (do (swap! fail inc) (println "FAIL ::" src)))))
(doseq [s (list
  "[]" "{}" "#{}" "[[1] [2]]" "{:a [1 2] :b {:c 3}}" "#{[1] [2]}"
  "(- 5)" "(* 2 3 4)" "(< 1 2)" "(rem 7 3)"
  "(map inc [1 2 3])" "(reduce + 0 xs)" "(str a b c)"
  "(Enum/map f xs)" "(:erlang/system_time)" "(erlang/monotonic_time :millisecond)"
  "(get m :k)" "(assoc m :k v)" "(String/split s \",\")"
  "(f)" "()" "(g (h x) (i y))" "[1 \"two\" :three nil true]"
  "{:vec [1 2] :set #{3 4} :nested {:a 1}}")]
  (check s))
(println "PASS:" (deref pass) "FAIL:" (deref fail))
