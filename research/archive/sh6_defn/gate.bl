(ns p6 (:require [compiler :as c] [self.oracle :as o]))
(def env (BeamLisp.Compiler/new_env "user"))
(def kenv (c/new-env "user"))
(def pass (atom 0)) (def fail (atom 0))
(defn check [src]
  (try (if (o/ast-equal? (o/oracle-compile (BeamLisp.Reader/read_one src) env)
                         (c/compile (BeamLisp.Reader/read_one src) kenv))
         (swap! pass inc) (do (swap! fail inc) (println "FAIL ::" src)))
    (catch e (do (swap! fail inc) (println "ERR  ::" src)))))
(doseq [s (list
  "(def x 42)"
  "(def y (+ 1 2))"
  "(defn sq [x] (* x x))"
  "(defn add [x y] (+ x y))"
  "(defn fact [n] (if (< n 2) 1 (* n (fact (- n 1)))))"
  "(defn id [x] x)"
  "(defn cnt ([] 0) ([x] 1) ([x y] 2))"
  "(defn vari [x & rest] rest)"
  "(defn classify [n] :when (int? n) :int)"
  "(defn get-x [{:keys [x]}] x)")]
  (check s))
(println "PASS:" (deref pass) "FAIL:" (deref fail))
