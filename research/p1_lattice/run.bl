; research/p1_lattice/run.bl — P1 driver: run the clean demo (defs + meta
; into Env), check BOTH files from source, print warnings + timings.

(ns p1run
  (:require [lattice]))

; the clean demo runs first: annotations land in Env via the REAL pipe
(BeamLisp.Loader/ensure_loaded "p1demo")

(def clean-src (second (File/read "research/p1_lattice/p1demo.bl")))
(def bugs-src  (second (File/read "research/p1_lattice/p1bugs.bl")))

(println "── P1: tag-lattice check ──")

(def t0 (erlang/monotonic_time :microsecond))
(def clean-warnings (lattice/check-source clean-src "p1demo"))
(def t1 (erlang/monotonic_time :microsecond))
(def bug-warnings (lattice/check-source bugs-src "p1demo"))
(def t2 (erlang/monotonic_time :microsecond))

(println (str "clean file warnings: " (count clean-warnings)
              "  [" (- t1 t0) " µs]"))
(doall (map (fn [w] (println (str "  ✗ " (:msg w) "\n      in " (:form w))))
            clean-warnings))
(println (str "bugs file warnings: " (count bug-warnings)
              "  [" (- t2 t1) " µs]"))
(doall (map (fn [w] (println (str "  ✗ " (:msg w) "\n      in " (:form w))))
            bug-warnings))

; steady state: the first check pays module/JIT warmup; the question the
; matrix asks (µs-scale per form) is about the THIRD run, not the first.
(def warm
  (map (fn [_]
         (let [a (erlang/monotonic_time :microsecond)]
           (lattice/check-source bugs-src "p1demo")
           (- (erlang/monotonic_time :microsecond) a)))
       [1 2 3]))
(println (str "warm runs (µs): " (pr-str (into [] warm))))

; --- the contract, asserted ----------------------------------------------
; clean file: ZERO warnings (a false positive fails the spike).
; bugs file: exactly three (disjoint arg, unreachable branch, kw on
; non-map).
(println (str (if (and (= 0 (count clean-warnings))
                       (= 3 (count bug-warnings)))
                "PASS" "FAIL")
              ": zero false positives, exactly the three seeded bugs"))
