; research/p1_lattice/p1bugs.bl — the three seeded bugs. NEVER RUN (bug1
; would crash at runtime — which is exactly the point of catching it
; statically); this file exists to be READ AS DATA and checked.

(ns p1bugs)

; BUG 1: disjoint argument — string into a declared int.
(def bug1 (double "seven"))

; BUG 2: unreachable branch — the inner test re-narrows to never.
(defn bug2 [x]
  (if (int? x)
    x
    (if (int? x) 1 2)))

; BUG 3: keyword called on a value that is provably a fn's int return.
(def bug3 (:opts (double 5)))
