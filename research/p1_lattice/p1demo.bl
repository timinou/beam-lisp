; research/p1_lattice/p1demo.bl — P1's CLEAN corpus: annotated defs that
; run safely (their ^ meta lands in Env via the real pipe) and must check
; with ZERO warnings.

(ns p1demo)

(defn ^{:args [int] :ret int} double [x] (* x 2))

(defn clean-narrow [n]
  (if (int? n) (double n) 0))

(defn clean-let [x]
  (let [y (* 2 3)]
    (if (some? x) (str y) "none")))

(def clean-top (double 41))
