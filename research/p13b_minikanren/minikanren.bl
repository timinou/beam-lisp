; research/p13b_minikanren/microkanren.bl — µKanren in pure beam-lisp.
;
; The question under test: can a RELATIONAL type checker — one that runs
; forwards (check), sideways (what type was intended), and backwards
; (synthesize expressions of a given type) — be self-hosted in beam-lisp
; as a library, per the re-implement-natively principle?
;
; µKanren ("A Minimal Functional Core for Relational Programming",
; Hemann & Friedman) is the ~50-line kernel of the miniKanren family.
; Streams are the one interesting choice: a stream is
;   '()                 — empty (no answers)
;   (state . stream)    — a mature answer followed by more
;   (fn [] stream)      — a thunk, a suspended search (interleaving is
;                         what makes disjunction FAIR: neither branch can
;                         starve the other)
; An improper tail (state . thunk) is not list? in Erlang, so the stream
; predicates are ordered: fn? first, empty? second, mature otherwise.
;
; Design point lifted from Barliman: an UNBOUND logic variable in an
; answer is a HOLE — a partially-synthesized program. (run 4 e (typeo …))
; yielding templates with holes is a feature, not an incompleteness.

(ns minikanren)

; ── logic vars & state ────────────────────────────────────────────────

(defn lvar [id] {:lvar id})
(defn lvar? [x] (and (map? x) (int? (:lvar x))))

(def empty-state {:subst {} :counter 1})

; ── substitution walking & unification (no occurs check, as canonical) ──

(defn walk [v subst]
  (if (lvar? v)
    (let [found (get subst v)]
      (if (nil? found) v (walk found subst)))
    v))

(defn- unify-vecs [u v subst]
  (if (or (not (vector? v)) (not (= (count u) (count v))))
    false
    (loop [i 0, s subst]
      (cond
        (not s) false
        (= i (count u)) s
        :else (recur (+ i 1) (unify (nth u i) (nth v i) s))))))

(defn unify [u v subst]
  (let [u (walk u subst)
        v (walk v subst)]
    (cond
      (and (lvar? u) (lvar? v) (= u v)) subst
      (lvar? u) (assoc subst u v)
      (lvar? v) (assoc subst v u)
      (and (list? u) (list? v) (empty? u) (empty? v)) subst
      (and (list? u) (list? v) (seq u) (seq v))
        (let [s2 (unify (first u) (first v) subst)]
          (if s2 (unify (rest u) (rest v) s2) false))
      (vector? u) (unify-vecs u v subst)
      :else (if (= u v) subst false))))

; ── goals ──────────────────────────────────────────────────────────────
; A goal is (fn [state] stream-of-states).

(def mzero '())
(defn unit [state] [:cons state '()])

(defn === [u v]
  (fn [state]
    (let [s2 (unify u v (:subst state))]
      (if s2 (unit (assoc state :subst s2)) mzero))))

; Predicate goals. The Barliman move: on an UNBOUND var the goal SUCCEEDS
; and leaves the var alone — the var survives into answers as a hole.
(defn numbero [x]
  (fn [state]
    (let [v (walk x (:subst state))]
      (cond
        (lvar? v) (unit state)
        (int? v) (unit state)
        :else mzero))))

(defn symbolo [x]
  (fn [state]
    (let [v (walk x (:subst state))]
      (cond
        (lvar? v) (unit state)
        (symbol? v) (unit state)
        :else mzero))))

(defn booleo [x]
  (fn [state]
    (let [v (walk x (:subst state))]
      (cond
        (lvar? v) (unit state)
        (or (= v true) (= v false)) (unit state)
        :else mzero))))

(defn stringo [x]
  (fn [state]
    (let [v (walk x (:subst state))]
      (cond
        (lvar? v) (unit state)
        (string? v) (unit state)
        :else mzero))))

; ── streams ────────────────────────────────────────────────────────────
; beam-lisp cons requires a proper-list tail, so the canonical
; (state . thunk) improper pair is spelled as a TAGGED VECTOR here:
;   '()                — empty
;   [:cons state s]    — mature answer + continuation stream
;   [:thunk f]         — suspended search (fair interleave via mplus)

(defn- thunk? [s] (and (vector? s) (= :thunk (first s))))

(defn mplus [s1 s2]
  (cond
    (thunk? s1) [:thunk (fn [] (mplus s2 ((nth s1 1))))]
    (empty? s1) s2
    :else [:cons (nth s1 1) (mplus (nth s1 2) s2)]))

(defn bind [s g]
  (cond
    (thunk? s) [:thunk (fn [] (bind ((nth s 1)) g))]
    (empty? s) mzero
    :else (mplus (g (nth s 1)) (bind (nth s 2) g))))

(defn pull [s] (if (thunk? s) (pull ((nth s 1))) s))

(defn take* [n s]
  (if (<= n 0)
    '()
    (let [s (pull s)]
      (if (empty? s)
        '()
        (cons (nth s 1) (take* (- n 1) (nth s 2)))))))

; ── combinators ────────────────────────────────────────────────────────

(defn disj2 [g1 g2] (fn [state] (mplus (g1 state) (g2 state))))
(defn conj2 [g1 g2] (fn [state] (bind (g1 state) g2)))

; η-expansion: delay a recursive relation call until the goal is INVOKED,
; and yield an IMMATURE (thunk) stream so mplus interleaves instead of
; descending eagerly — without the thunk, bind forces the recursive branch
; on the spot and the search tree never comes back up. (Canonical
; miniKanren's Zzz/conde macros exist for exactly this.)
; Recursive sites spell (delay-goal (fn [] (my-rel …))).
(defn delay-goal [gf] (fn [state] [:thunk (fn [] ((gf) state))]))

(def fail-goal (fn [_] mzero))
(def succeed-goal (fn [state] (unit state)))

(defn disj* [goals] (reduce disj2 fail-goal goals))
(defn conj* [goals] (reduce conj2 succeed-goal goals))

; conde: each clause is a vector of goals; clauses are alternatives,
; goals within a clause are conjuncts.
(defn conde* [clauses]
  (disj* (map (fn [goals] (conj* goals)) clauses)))

; fresh: introduce logic vars. f takes the vars and returns a goal.
(defn fresh1 [f]
  (fn [state]
    (let [c (:counter state)]
      ((f (lvar c)) (assoc state :counter (+ c 1))))))

(defn fresh2 [f]
  (fresh1 (fn [a] (fresh1 (fn [b] (f a b))))))

(defn fresh3 [f]
  (fresh1 (fn [a] (fresh2 (fn [b c] (f a b c))))))

(defn fresh4 [f]
  (fresh1 (fn [a] (fresh3 (fn [b c d] (f a b c d))))))

; ── run & reify ────────────────────────────────────────────────────────

(defn reify-walk [v subst]
  (let [v (walk v subst)]
    (cond
      (lvar? v) (symbol (str "_" (:lvar v)))
      (list? v) (doall (map (fn [x] (reify-walk x subst)) v))
      (vector? v) (doall (map (fn [x] (reify-walk x subst)) v))
      :else v)))

(defn run [n f]
  (let [q (lvar 0)
        states (take* n ((f q) {:subst {} :counter 1}))]
    (doall (map (fn [st] (reify-walk q (:subst st))) states))))
