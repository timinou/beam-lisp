; research/p13b_minikanren/types.bl — a RELATIONAL featherweight type
; checker for a mini beam-lisp, on the µKanren kernel.
;
; The mini language: int/string/bool literals, vars, (if c t e),
; (fn [x] body), (f a). Types: int | string | bool | (fn a b).
;
; Because typeo is a RELATION, not a function, the one artifact answers
; three questions depending on what is left as a logic variable:
;   forwards   — given expr, find type          (checking)
;   sideways   — given ill-typed expr, show no type exists (diagnostics)
;   backwards  — given type, find exprs          (synthesis, with holes)
;
; Run: mix beam_lisp.run --path priv --path research/p13b_minikanren \
;        research/p13b_minikanren/types.bl

(ns minikanren.types
  (:require [minikanren :as mk]))

; Environments are VECTOR spines [binding rest-env] (beam-lisp cons needs
; a proper-list tail; a vector tail can be a logic var). Bindings are
; [sym type] vectors; the empty env is [].
(defn lookupo [env x t]
  (mk/conde*
    [[(mk/fresh1 (fn [rest]
        (mk/=== env [[x t] rest])))]
     [(mk/fresh3 (fn [y s rest]
        (mk/conj* [(mk/=== env [[y s] rest])
                   (mk/delay-goal (fn [] (lookupo rest x t)))])))]]))

(defn typeo [env e t]
  (mk/conde*
    [; int literal
     [(mk/numbero e) (mk/=== t 'int)]
     ; string literal
     [(mk/stringo e) (mk/=== t 'string)]
     ; bool literal
     [(mk/booleo e) (mk/=== t 'bool)]
     ; variable — type from the environment
     [(mk/symbolo e) (lookupo env e t)]
     ; (if c then else) — condition must be bool, branches agree
     [(mk/fresh3 (fn [c tb eb]
        (mk/conj* [(mk/=== e (list 'if c tb eb))
                   (mk/delay-goal (fn [] (typeo env c 'bool)))
                   (mk/delay-goal (fn [] (typeo env tb t)))
                   (mk/delay-goal (fn [] (typeo env eb t)))])))]
     ; (fn [x] body) : (fn arg-type ret-type)
     [(mk/fresh4 (fn [x body a b]
        (mk/conj* [(mk/=== e (list 'fn (list x) body))
                   (mk/=== t (list 'fn a b))
                   (mk/symbolo x)
                   (mk/delay-goal (fn [] (typeo [[x a] env] body b)))])))]
     ; (f a) — application
     [(mk/fresh3 (fn [f a at]
        (mk/conj* [(mk/=== e (list f a))
                   (mk/delay-goal (fn [] (typeo env f (list 'fn at t))))
                   (mk/delay-goal (fn [] (typeo env a at)))])))]]))

; ── the three directions ──────────────────────────────────────────────

(defn heading [s] (println (str "\n── " s " ──")))

(heading "forwards: checking")
(println (str "  (if true 1 2)        : " (pr-str (mk/run 1 (fn [t] (typeo '() '(if true 1 2) t))))))
(println (str "  ((fn [y] y) 5)       : " (pr-str (mk/run 1 (fn [t] (typeo '() '((fn (y) y) 5) t))))))
(println (str "  x, env {x:int}       : " (pr-str (mk/run 1 (fn [t] (typeo '[[x int] []] 'x t))))))
(println (str "  (fn [x] x)           : " (pr-str (mk/run 1 (fn [t] (typeo '() '(fn (x) x) t))))))

(heading "sideways: the ill-typed program has NO answer")
(println (str "  (if true 1 \"s\")      : " (pr-str (mk/run 1 (fn [t] (typeo '() '(if true 1 "s") t)))) "  ;; empty — no type exists; the branches disagree"))

(defn timed [label n f]
  (let [t0 (erlang/monotonic_time :millisecond)
        r (mk/run n f)
        t1 (erlang/monotonic_time :millisecond)]
    (println (str "  " label " : " (pr-str r) "   [" (- t1 t0) " ms]"))))

(heading "backwards: synthesis from a type (holes are logic vars)")
(timed "1 expr  of type bool" 1 (fn [e] (typeo '() e 'bool)))
(timed "2 exprs of type bool" 2 (fn [e] (typeo '() e 'bool)))
(timed "3 exprs of type bool" 3 (fn [e] (typeo '() e 'bool)))

(heading "backwards with intent: fns from int to bool")
(timed "1 fn int→bool" 1 (fn [e] (typeo '() e '(fn int bool))))
