; boot-deps.bl — does the boot tier depend on the language it bootstraps?
;
; ── The invariant ───────────────────────────────────────────────────────────
;
; `priv/boot/` is the compiler: reader, compiler, ANF, lowerer, core, sugar.
; It is loaded in an environment that has the SEED and nothing else — no `core`
; (it is what DEFINES core), no runtime, no library. So a boot-tier file may
; reach only:
;
;   · primitives — `erlang/*`, special forms
;   · seeded names — `seed_core` installs these BEFORE the prelude, so `nth`,
;     `first`, `map`, `not` are all legitimately available
;   · HOST modules — `BeamLisp.Env`, `BeamLisp.Vector`, `BeamLisp.Set`, …
;   · names the boot tier itself defines
;
; It may NOT reach a name that `core.bl` defines. That is not a style rule: it
; is the load order. `core.bl` has not run when the tier is being loaded.
;
; ── Why this is worth a gate ────────────────────────────────────────────────
;
; The violation is INVISIBLE in the normal loop, because the prelude is loaded
; from a compiled beam and nothing reads a source before `core` is up. It only
; bites when a boot-tier edit changes `compiler_key`, the AOT cache misses, and
; the prelude is then evaluated FROM SOURCE — at which point the reader is
; asked to read `core.bl` and dies on its own dependency:
;
;     priv/boot/reader-node.bl:123  (apply list xs)     ; `list` is core.bl:85
;     → ** (RuntimeError) undefined var: reader-node/list
;
; Measured: changing `priv/boot/compiler.bl`'s module constant alone flips a
; cold `bl build` from exit 0 to exit 70 with that exact message; an inert
; comment change does not. So the class is real, reachable by a one-line edit,
; and its symptom names a file that is not at fault.
;
; This program names the SITES. It walks every boot-tier source, collects the
; symbols it references, subtracts what the tier defines for itself, and
; reports those that `core.bl` defines — each one a dependency on a namespace
; that has not been built yet when it is used.
;
; A local binding shadowing a core name is reported too (the scan is syntactic).
; That is deliberate: the list is short, and a false positive costs a glance.

(ns boot-tier-deps)

(def boot-dir "priv/boot")

(def defining-heads
  "Forms whose second element names something the tier defines."
  #{"def" "defn" "defn-" "defmacro" "defmacro-" "defmulti" "defprotocol"
    "defnative" "defonce" "defstruct" "defrecord"})

(defn boot-files [] (sort (Path/wildcard (Path/join boot-dir "*.bl"))))

(defn- forms-of [p] (BeamLisp.Ns.Source-graph/forms (File/read! p)))

(defn- node? [n tag] (erlang/== (BeamLisp.Ns.Reader-node/node-tag n) tag))

(defn- walk
  "Every symbol name in a reader node tree."
  [n]
  (cond
    (node? n :symbol) (list (BeamLisp.Ns.Reader-node/node-name n))
    (or (node? n :list) (node? n :vector) (node? n :map) (node? n :set))
    (mapcat walk (BeamLisp.Ns.Reader-node/node-items n))
    (node? n :meta) (mapcat walk (BeamLisp.Ns.Reader-node/node-items n))
    :else nil))

(defn- head-name-of [f]
  (when (node? f :list)
    (let [items (BeamLisp.Ns.Reader-node/node-items f)]
      (when (not (empty? items))
        (let [n (first items)]
          (when (node? n :symbol) (BeamLisp.Ns.Reader-node/node-name n)))))))

(defn- second-name-of [f]
  (when (node? f :list)
    (let [items (BeamLisp.Ns.Reader-node/node-items f)]
      (when (>= (count items) 2)
        (let [n (nth items 1)]
          (when (node? n :symbol) (BeamLisp.Ns.Reader-node/node-name n)))))))

(defn- defines
  "Names a file's forms define at top level."
  [forms]
  (keep (fn [f] (when (contains? defining-heads (head-name-of f)) (second-name-of f)))
        forms))

(def core-defs
  "Names `core.bl` defines — the ones that do not exist until the tier has run.

   Seeded primitives are deliberately NOT here. `seed_core` runs BEFORE the
   prelude and installs `nth`, `first`, `map`, `not` … so a boot-tier file may
   use those; it may not use `list`, `not=`, `str` when core.bl owns them."
  (set (to-list (defines (forms-of (Path/join boot-dir "core.bl"))))))

(defn- analyse
  "One file's references into `core.bl`: `{:path p :names […]}`."
  [boot-defs path]
  (let [refs (distinct (to-list (mapcat walk (forms-of path))))
        hits (filter (fn [n] (and (not (contains? boot-defs n))
                                  (contains? core-defs n))) refs)]
    {:path path :names (sort (to-list hits))}))

(defn run []
  (let [paths (boot-files)
        core-path (Path/join boot-dir "core.bl")
        ;; `core.bl`'s OWN definitions must NOT be subtracted: they are exactly
        ;; the names that do not exist yet when the rest of the tier is loaded.
        ;; Subtracting the whole tier (core.bl included) hides every real
        ;; violation — measured: it reported 0 where there are several.
        boot-defs (set (to-list (mapcat (fn [p] (defines (forms-of p)))
                                       (filter (fn [p] (not (erlang/== p core-path))) paths))))
        rows (map (fn [p] (analyse boot-defs p)) paths)
        total (reduce (fn [a r] (+ a (count (:names r)))) 0 rows)]
    (println (str "boot tier: " (count rows) " files, "
                  total " references into `core.bl`"))
    (doseq [r rows]
      (when (not (empty? (:names r)))
        (println (str "  " (:path r)))
        (doseq [n (:names r)] (println (str "    " n)))))
    (if (= 0 total)
      (println "  none — the tier stands on primitives and host modules")
      (println "\nthe boot tier must not reach `core.bl`: it is what defines it."))))

(run)
