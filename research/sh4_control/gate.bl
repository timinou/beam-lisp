(ns p4full (:require [compiler :as c] [self.oracle :as o]))
(def env (BeamLisp.Compiler/new_env "user"))
(def kenv (c/new-env "user"))
(def pass (atom 0)) (def fail (atom 0))
(defn check [src]
  (let [form (BeamLisp.Reader/read_one src)
        want (o/oracle-compile form env)
        got  (c/compile form kenv)]
    (if (o/ast-equal? want got) (swap! pass inc)
      (do (swap! fail inc) (println "FAIL ::" src)))))
(doseq [s (list
  "(if a b c)" "(if a b)" "(do a b c)" "(throw x)"
  "(let [x 1] x)" "(let [x 1 y 2] (+ x y))" "(let [x (+ 1 2)] (* x x))"
  "(loop [i 0] (if (< i 10) (recur (+ i 1)) i))"
  "(quote x)" "(quote (a b c))" "(quote [1 2])" "(quote :k)" "(quote 42)"
  "(quote (defn f [x] (* x x)))" "(quote {:a 1})"
  "(if (nil? x) (quote none) x)"
  "(let [xs (quote (1 2 3))] (first xs))")]
  (check s))
(println "PASS:" (deref pass) "FAIL:" (deref fail))
