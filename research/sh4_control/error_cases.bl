(ns p4err (:require [compiler :as c]))
(def kenv (c/new-env "user"))
(defn try-compile [label src]
  (try
    (do (c/compile (BeamLisp.Reader/read_one src) kenv)
        (println label ": NO-ERROR (BAD)"))
    (catch e (println label ": threw (GOOD)"))))
(try-compile "recur-outside" "(recur 1)")
(try-compile "recur-nontail" "(loop [i 0] (+ 1 (recur (+ i 1))))")
(try-compile "recur-arity" "(loop [i 0] (recur 1 2))")
