; research/p2_positions/run.bl — P2 driver.

(ns p2run
  (:require [poswalk]))

(BeamLisp.Loader/ensure_loaded "p2demo")

(def clean-forms (BeamLisp.Reader/read_string
                   (second (File/read "research/p2_positions/p2demo.bl"))))
(def bugs-forms (BeamLisp.Reader/read_string
                  (second (File/read "research/p2_positions/p2bugs.bl"))))

(println "── P2: positions × macros ──")

(def clean (poswalk/check-forms clean-forms "p2demo"))
(def bugs  (poswalk/check-forms bugs-forms "p2demo"))

(println (str "clean warnings: " (count (:warnings clean))))
(doall (map (fn [w] (println (str "  ✗ " (:line w) ":" (:col w) " " (:msg w))))
            (:warnings clean)))
(println (str "bugs warnings: " (count (:warnings bugs))))
(doall (map (fn [w] (println (str "  ✗ " (:line w) ":" (:col w) " " (:msg w))))
            (:warnings bugs)))

; evidence table + hover (L1/L12 preview): the (double n) call inside
; clean-thread sits at line 8, col 13.
(def ev (:evidence clean))
(println (str "evidence entries: " (count ev)))
(println (str "evidence keys: " (pr-str (sort (into [] (keys ev))))))
(println (str "hover 9:10 → " (poswalk/hover ev 9 10)))
(println (str "hover 12:18 → " (poswalk/hover ev 12 18)))

(println (str (if (and (= 0 (count (:warnings clean)))
                       (= 3 (count (:warnings bugs)))
                       (every? (fn [w] (> (:line w) 0)) (:warnings bugs)))
                "PASS" "FAIL")
              ": macro-shaped bugs carry user-written positions, clean corpus silent"))
