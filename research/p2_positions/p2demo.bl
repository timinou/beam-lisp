; research/p2_positions/p2demo.bl — P2's CLEAN corpus. Runs safely;
; must check with ZERO warnings through every whitelisted macro shape.

(ns p2demo)

(defn ^{:args [int] :ret int} double [x] (* x 2))

(defn clean-thread [n]
  (->> n (double) (str)))

(defn clean-when [x]
  (when (int? x) (double x)))

(defn clean-cond [x]
  (cond
    (int? x)    (double x)
    (string? x) 0
    :else       1))

(def clean-and (fn [x] (and (int? x) (double x))))
