; research/p2_positions/p2bugs.bl — seeded bugs INSIDE macro shapes.
; Never run; read with Reader/read_string and checked.

(ns p2bugs)

; BUG 1: disjoint argument through ->> — the synthesized (double "s")
; must warn AT the (double) step the user wrote.
(def bug-thread (->> "s" (double) (str)))

; BUG 2: unreachable branch through when — the when's test narrows to
; never because the outer if's else already excluded int.
(defn bug-when [x]
  (if (int? x)
    x
    (when (int? x) 1)))

; BUG 3: disjoint argument through cond, at top level. (An annotated
; defn here would NOT work: this file is never run, so its defs' meta
; never reaches Env — the sound answer for an unannotated param is
; `any`, and `any` stays silent. Literals are provable.)
(def bug-cond
  (cond
    (string? "s") (double "s")
    :else         0))
