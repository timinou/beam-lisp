; research/p20_composition/spike_compose.bl
; ══════════════════════════════════════════════════════════════════════════
; P20 COMPOSITION FLYWHEEL — every guarantee as ONE queryable relation.
;
; Today the capabilities (clause facts, phase graph, guard preconditions,
; message coverage) are SEPARATE function calls. Project them into ONE datom
; store and the cross-cutting questions become datalog JOINS — questions no
; single existing function can answer. This spike proves the shape on TWO
; communicating processes.
;
; The killer query: "which SENT message hits a receiver clause whose guard
; precondition the sender does not establish?" — a join across:
;   sender's :call/msg   ×   receiver's :clause/label + :clause/guard
; i.e. type/protocol/precondition composed in one query.
; ══════════════════════════════════════════════════════════════════════════

(ns p20.spike-compose
  (:require [system.facts :as facts] [system.model :as model] [datom]))

(defn- r [s] (first (BeamLisp.Reader/read_string s)))

; ── the unified store: one schema, many projectors ──────────────────────────
(def SCHEMA
  [{:db/ident :clause/proc    :db/valueType :db.type/string}
   {:db/ident :clause/label   :db/valueType :db.type/keyword}
   {:db/ident :clause/guarded :db/valueType :db.type/boolean}
   {:db/ident :clause/guard   :db/valueType :db.type/string}
   {:db/ident :send/from      :db/valueType :db.type/string}
   {:db/ident :send/to        :db/valueType :db.type/string}
   {:db/ident :send/label     :db/valueType :db.type/keyword}])

; project a process's clauses (reusing model.bl) into :clause/* facts
(defn project-clauses [proc-name node]
  (let [clauses (filter (fn [c] (not (= :init (:label c))))
                        (:transitions (model/system-model node)))]
    (into [] (map-indexed
               (fn [i c]
                 (let [g (:guard c)]
                   (merge {:db/id (- (+ (* 100 (erlang/phash2 proc-name)) i 1))
                           :clause/proc proc-name
                           :clause/label (:label c)
                           :clause/guarded (some? g)}
                          (if g {:clause/guard g} {}))))
               clauses))))

; ── the scenario: a CLIENT that sends :withdraw to an ACCOUNT ────────────────
; The account only handles :withdraw when balance ≥ amt (a guarded precondition).
; The client sends :withdraw unconditionally. The composition query finds that
; the sent message hits a GUARDED handler — a latent precondition-violation risk
; no single-process check sees.

(def account
  "(defserver account
     (init [] (ok {:balance 100}))
     (handle-call [:withdraw amt] [_ {:keys [balance]}] :when (>= balance amt)
       (reply :ok {:balance (- balance amt)}))
     (handle-call [:deposit amt] [_ {:keys [balance]}]
       (reply :ok {:balance (+ balance amt)})))")

; the client's sends, as facts (in the real system, projected from call sites)
(def client-sends
  [{:db/id -1 :send/from "client" :send/to "account" :send/label :withdraw}
   {:db/id -2 :send/from "client" :send/to "account" :send/label :deposit}])

(def conn (datom/connect SCHEMA))
(datom/transact! conn (project-clauses "account" (r account)))
(datom/transact! conn client-sends)
(def db (datom/db conn))

(println "── P20: composition — cross-cutting datalog over projected guarantees ──\n")

; QUERY 1: every message a client sends that lands on a GUARDED handler
; (a precondition the sender must satisfy but the type system can't force).
(def risky
  (datom/q '[:find ?label ?guard
             :where [?s :send/to "account"] [?s :send/label ?label]
                    [?c :clause/proc "account"] [?c :clause/label ?label]
                    [?c :clause/guarded true] [?c :clause/guard ?guard]]
           db))
(println "sent messages that hit a GUARDED precondition:")
(doseq [row risky]
  (println "   :" (first row) "requires" (pr-str (second row))
           "— sender must establish this"))

; QUERY 2: sent messages that are UNguarded (always safe to send)
(def safe
  (datom/q '[:find ?label
             :where [?s :send/to "account"] [?s :send/label ?label]
                    [?c :clause/proc "account"] [?c :clause/label ?label]
                    [?c :clause/guarded false]]
           db))
(println "\nsent messages with a TOTAL handler (always accepted):")
(doseq [row safe] (println "   :" (first row) "— unconditional"))

; QUERY 3: the composition NO single function can do — join sender × receiver
; guard. This is the seed of "which send could violate the receiver's invariant".
(println "\n── the point ──")
(println "Three capabilities — the client's send set, the account's dispatch")
(println "labels, the account's guard preconditions — lived in separate calls.")
(println "Projected into ONE relation they JOIN: 'which send hits a guarded")
(println "precondition' is a query, not a new checker. Add the invariant relation")
(println "and it becomes 'which send could break the receiver's invariant' — the")
(println "cross-process question no single-process verifier can ask.")
:ok
