; research/p3_guards/run.bl — P3 driver: the checker over REAL examples,
; hand-audited. The corpus files RUN fine (they're clean examples); the
; contract is: every warning is either a true positive or a bug in the
; checker — and clean code must produce none.

(ns p3run
  (:require [poswalk]))

; the corpus loads for real: defs + meta in Env
(BeamLisp.Loader/ensure_loaded "examples.guards")
(BeamLisp/run_file "examples/destructuring.bl")

(defn check-file [path ns]
  (poswalk/check-forms
    (BeamLisp.Reader/read_string (second (File/read path))) ns))

(println "── P3: checker over the real corpus ──")

(def g (check-file "examples/guards.bl" "examples.guards"))
(println (str "guards.bl warnings: " (count (:warnings g))))
(doall (map (fn [w] (println (str "  " (:line w) ":" (:col w) " " (:msg w))))
            (:warnings g)))

(def d (check-file "examples/destructuring.bl" "destructuring"))
(println (str "destructuring.bl warnings: " (count (:warnings d))))
(doall (map (fn [w] (println (str "  " (:line w) ":" (:col w) " " (:msg w))))
            (:warnings d)))

; the reachability rule must also FIRE when it should: a bare catch-all
; clause followed by another same-arity clause is dead code.
(poswalk/check-forms
  (BeamLisp.Reader/read_string
    "(ns deadcode)
     (defn f ([x] 1) ([x] :when (int? x) 2))")
  "deadcode")
(def dead (deref poswalk/warnings))
(def dead-new (drop (+ (count (:warnings g)) (count (:warnings d))) dead))
(println (str "synthetic dead clause: " (count dead-new) " warning(s)"))
(doall (map (fn [w] (println (str "  " (:line w) ":" (:col w) " " (:msg w))))
            dead-new))

(println (str (if (and (= 0 (count (:warnings g)))
                       (= 0 (count (:warnings d)))
                       (= 1 (count dead-new)))
                "PASS" "FAIL")
              ": corpus silent, dead clause caught"))
