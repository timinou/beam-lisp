(ns ck1d2 (:require [compiler :as c] [self.oracle :as o] [reader-node :as rn]))
(defn ns-of [form]
  (let [f (rn/node-form form)]
    (if (and (= :list (rn/node-tag f)) (not (empty? (rn/node-items f)))
             (= :symbol (rn/node-tag (rn/node-form (first (rn/node-items f)))))
             (= "ns" (rn/node-name (rn/node-form (first (rn/node-items f))))))
      (rn/node-name (rn/node-form (second (rn/node-items f)))) nil)))
(defn diag [path]
  (loop [fs (BeamLisp.Reader/read_all (File/read! path)) cur "user" i 0 shown 0]
    (if (or (empty? fs) (>= shown 2)) (println "done" path)
      (let [f (first fs) nn (ns-of f)
            oenv (BeamLisp.Compiler/new_env cur)
            kenv (assoc (c/new-env cur) :ns cur)
            eq (try (o/ast-equal? (o/oracle-compile f oenv) (c/compile f kenv)) (catch e :err))]
        (if (= eq true)
          (recur (rest fs) (if (nil? nn) cur nn) (+ i 1) shown)
          (do (println "FAIL" path "form" i)
              (File/write! (str "/tmp/d_want.txt") (try (Macro/to_string (o/oracle-compile f oenv)) (catch e "E")))
              (File/write! (str "/tmp/d_got.txt") (try (Macro/to_string (c/compile f kenv)) (catch e (str "ERR " e))))
              (recur (rest fs) (if (nil? nn) cur nn) (+ i 1) (+ shown 1))))))))
(diag "priv/core.bl")
