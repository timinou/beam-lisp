(ns ck1 (:require [compiler :as c] [self.oracle :as o] [reader-node :as rn]))
(defn wildcard [pat]
  (map (fn [cs] (erlang/list_to_binary cs)) (filelib/wildcard (erlang/binary_to_list pat))))
(defn ns-of [form]
  ; if form is (ns NAME ...), return NAME, else nil
  (let [f (rn/node-form form)]
    (if (and (= :list (rn/node-tag f))
             (let [items (rn/node-items f)]
               (and (not (empty? items))
                    (= :symbol (rn/node-tag (rn/node-form (first items))))
                    (= "ns" (rn/node-name (rn/node-form (first items)))))))
      (rn/node-name (rn/node-form (second (rn/node-items f))))
      nil)))
(defn check-file [path]
  (let [src (File/read! path)
        forms (try (BeamLisp.Reader/read_all src) (catch e :readerr))]
    (if (= forms :readerr)
      {:path path :ok 0 :fail 0}
      (loop [fs forms cur-ns "user" ok 0 fail 0 firstfail nil]
        (if (empty? fs)
          {:path path :ok ok :fail fail :firstfail firstfail}
          (let [f (first fs)
                nn (ns-of f)
                oenv (BeamLisp.Compiler/new_env cur-ns)
                kenv (assoc (c/new-env cur-ns) :ns cur-ns)
                eq (try (o/ast-equal? (o/oracle-compile f oenv) (c/compile f kenv)) (catch e :err))
                next-ns (if (nil? nn) cur-ns nn)]
            (recur (rest fs) next-ns
                   (if (= eq true) (+ ok 1) ok)
                   (if (= eq true) fail (+ fail 1))
                   (if (and (nil? firstfail) (not (= eq true))) f firstfail))))))))
(def files (concat (wildcard "priv/boot/*.bl") (wildcard "priv/std/*.bl") (wildcard "priv/lib/system/*.bl")))
(def results (into [] (map check-file files)))
(println "FILES:" (count files)
         "OK:" (reduce + 0 (map :ok results))
         "FAIL:" (reduce + 0 (map :fail results)))
(println "-- top offenders --")
(doseq [r (take 12 (sort-by (fn [x] (- 0 (:fail x))) results))]
  (when (> (:fail r) 0) (println "  " (:path r) "ok:" (:ok r) "fail:" (:fail r))))
