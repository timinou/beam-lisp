; research/p5_protocols/run.bl — P5 driver.

(ns p5run
  (:require [protos]))

(reset! protos/proto-table {})
(reset! typed/warnings [])

(println "── P5: protocols, the checked-interface story ──")

; ── world v1: Shape with vector + integer impls ───────────────────────
(def v1
  "(defprotocol Shape (area [this]) (perimeter [this]))
   (extend-type :vector Shape
     (area [v] 42)
     (perimeter [v] 3))
   (extend-type :integer Shape
     (area [n] (* n n)))")          ; missing perimeter → structural warning

(def r1 (protos/check-source v1 "p5run"))
(println (str "v1 def warnings: " (count (:warnings r1))))
(doall (map (fn [w] (println (str "  ✗ " (:line w) ":" (:col w) " " (:msg w))))
            (:warnings r1)))

; ── call sites ─────────────────────────────────────────────────────────
(reset! typed/warnings [])
(def calls
  "(area [1 2 3])
   (area 7)
   (area #{1 2})")
(def r2 (protos/check-source calls "p5run"))
(println (str "call warnings: " (count (:warnings r2))))
(doall (map (fn [w] (println (str "  ✗ " (:line w) ":" (:col w) " " (:msg w))))
            (:warnings r2)))

; ── extension revokes: a :set impl arrives ────────────────────────────
(def ext "(extend-type :set Shape (area [s] (count s)) (perimeter [s] 1))")
; NOTE: :set maps to no lattice tag today — the sound answer stays
; 'no implementation' until the lattice grows :set. Use :map instead
; to show revocation honestly.
(def ext2 "(extend-type :map Shape (area [m] 9) (perimeter [m] 1))")
(def calls2 "(area {:x 1})")

(reset! typed/warnings [])
(def r3 (protos/check-source calls2 "p5run"))
(println (str "map call, before ext: " (count (:warnings r3)) " warning(s)"))
(protos/check-source ext2 "p5run")
(reset! typed/warnings [])
(def r4 (protos/check-source calls2 "p5run"))
(println (str "map call, after ext:  " (count (:warnings r4)) " warning(s)"))

(println (str (if (and (= 1 (count (:warnings r1)))   ; missing perimeter
                       (= 1 (count (:warnings r2)))   ; set: no impl
                       (= 1 (count (:warnings r3)))   ; map: no impl
                       (= 0 (count (:warnings r4))))  ; revoked
                "PASS" "FAIL")
              ": completeness, no-impl, and revocation all behave"))
