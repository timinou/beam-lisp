(ns p2verify (:require [reader :as r] [self.oracle :as o]))
(defn check [src]
  (let [want (BeamLisp.Reader/read_all src)
        got  (r/read-all src)
        ok (o/forms-equal? want got)]
    (println (if ok "OK  " "FAIL") "::" src)
    (when (not ok) (println "  diff:" (:index (o/first-diff want got))))))
(check "(+ 1 2)")
(check "(defn sq [x] (* x x))")
(check "[1 2 3]")
(check "{:a 1 :b 2}")
(check "#{1 2 3}")
(check "\"hello\\nworld\"")
(check ":keyword")
(check "'(a b c)")
(check "`(a ~b ~@c)")
(check "@x")
(check "#(+ % 1)")
(check "(a ; comment\n b)")
(check "nil true false 3.14 -5")
(check "(let [{:keys [a b]} m] a)")
(check "\\newline")
(check ":\"weird key\"")
