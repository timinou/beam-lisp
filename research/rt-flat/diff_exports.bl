; diff_exports.bl — every exported function the two runtimes share, called
; with every combination of values from a corpus, answer compared.
;
; The oracle calls each runtime through ONE hand-written row per operation, so
; it sees only what its rows name. Three defects shipped past it (`apply` and
; `list*` not spreading a vector, `drop`'s argument order) because no row named
; that shape or that order. This asks mechanically: for EVERY function both
; modules export at an arity, over a corpus of vectors, lazy seqs, nested lists
; and reader nodes, do they agree?
;
; BeamLisp.RT is gone from the tree, so the reference is a preserved beam of it
; (built from any pre-cutover commit): put its directory on the code path.
;
;   bin/bl --code-path DIR_WITH_OLD_RT_BEAM run research/rt-flat/diff_exports.bl
;   BL_DIFF_FRESH=1 bin/bl --code-path DIR_WITH_OLD_RT_BEAM run research/rt-flat/diff_exports.bl
;
; BL_DIFF_FRESH compiles priv/boot/rt.bl into this VM before comparison, so
; the differential judges the source rather than the last built runtime.
; Exit status 1 on any disagreement. The recorded result is 110 shared
; functions and 21455 calls.
(ns diff-exports)
(BeamLisp/init)

(when (= "1" (System/get_env "BL_DIFF_FRESH"))
  (let [root (BeamLisp/cwd)
        out (Path/join (System/tmp_dir!)
                       (str "bl-diff-rt-" (erlang/unique_integer (list :positive))))]
    (File/mkdir_p! out)
    (try
      (BeamLisp.Env/add_search_path (Path/join root "priv/boot"))
      (BeamLisp.Env/add_search_path (Path/join root "priv/std"))
      (BeamLisp.Loader/ensure_loaded "build")
      (BeamLisp.AOT/compile_file (Path/join root "priv/boot/rt.bl")
                                 (list (tuple :output_dir out)))
      (finally (File/rm_rf! out)))))

(def old :Elixir.BeamLisp.RT)
(def new :Elixir.BeamLisp.Ns.Rt)
(def vec (fn [xs] (vec xs)))
(def tup (fn [xs] (erlang/list_to_tuple xs)))

(BeamLisp.Compiler/eval_string "(ns diffx.rec) (defrecord DxR [a b])")
(ns diff-exports)
(def record (BeamLisp.Compiler/eval_string "(diffx.rec/->DxR 1 2)"))

(def corpus
  (list nil true false 0 1 -3 2.5 "ab" "" :k (tup (list :symbol "s"))
        (list) (list 1 2 3) (list (list 1 2) (list 3)) (list :a (list 1 2))
        (vec (list)) (vec (list 1 2 3))
        (vec (list (vec (list :a 1)) (vec (list :b 2))))
        (vec (list (tup (list :symbol "s")) (tup (list :list (list)))))
        (BeamLisp.LazySeq/new (fn [] (list 1 2)))
        {} {:a 1} #{1 2}
        (tup (list :list (list (tup (list :symbol "f")) 1)))
        (tup (list :meta (tup (list :symbol "x")) {:line 1}))
        (BeamLisp.Refs/atom 1) (BeamLisp.Refs/volatile 1)
        record (Kernel/struct :Elixir.URI {:host "h"})))

; Functions as arguments: invoke, apply_to, map, filter, reduce … take one first.
(def fns (list (fn [x] x) (fn [x] (int? x)) (fn [a b] (tup (list a b)))))

; Global state, processes, printing, nondeterminism: an answer says nothing.
(def skip #{:seed_core :println :println_multi :gensym :reader_macro! :data_reader!
            :module_info :__info__ :__bl_init__ :__bl_provenance__ :trace_2 :untrace_1
            ; a message builder the compiler calls with an INTEGER arity only; the
            ; corpus passes it arbitrary values, and RT's answer there is Elixir
            ; interpolating a nil — not a contract
            :call_shape_error})

(def shared
  (for [[f a] (erlang/apply old :__info__ (list :functions))
        :when (and (not (contains? skip f))
                   (erlang/function_exported new f a)
                   (<= 1 a 3))]
    (list f a)))

(def realize (fn [x] (if (lazy? x) (list :lazy (BeamLisp.LazySeq/to_list x)) x)))

(defn outcome [m f args]
  (let [task (Task/async (fn []
               (try (list :ok (realize (erlang/apply m f args)))
                    (catch e (list :raised (or (:__struct__ e) e))))))
        r (Task/yield task 500)]
    (if (nil? r)
      (do (Task/shutdown task :brutal_kill) :timeout)
      (erlang/element 2 r))))

(def pinned #{:count :seq :first :rest :next :get :assoc :conj :contains? :find :empty?})

; A DELIBERATE refusal type is part of the contract (a caller rescues it by
; name): ArgumentError, BeamLisp.CompileError, BeamLisp.ExInfo. An incidental
; one — CaseClauseError, a BIF's badarg surfacing as ArgumentError from deep
; inside — is how RT happened to fail and nothing can rescue it meaningfully.
; FunctionClauseError vs ArgumentError is contract too, for the collection fns
; dispatch_table_test pins per (fn, value), and only for those.
(defn contract-for [f]
  (concat (list :Elixir.BeamLisp.CompileError :Elixir.BeamLisp.ExInfo)
          (if (contains? pinned f)
            (list :Elixir.FunctionClauseError :Elixir.ArgumentError)
            (list))))

(defn raised-pair? [x] (and (list? x) (erlang/== (first x) :raised)))
(defn raised-val? [x] (or (erlang/== x :raised) (raised-pair? x)))
(defn ok-pair? [x] (and (list? x) (erlang/== (first x) :ok)))

(defn norm [f x]
  (if (raised-pair? x)
    (if (contains? (set (contract-for f)) (second x)) x :raised)
    x))

(defn arg-sets [a]
  (cond
    (erlang/== a 1) (for [x corpus] (list x))
    (erlang/== a 2) (concat (for [x corpus y (Enum/take corpus 12)] (list x y))
                            (for [f fns x corpus] (list f x)))
    :else (concat (for [f fns x (Enum/take corpus 10) y (Enum/take corpus 10)] (list f x y))
                  (for [x (Enum/take corpus 10) y (Enum/take corpus 6) z (Enum/take corpus 6)] (list x y z)))))

(defn classify [f o n]
  (cond
    (erlang/== o n) :agree
    (and (raised-val? o) (not (raised-val? n))) :new_more_total
    ; RT crashed incidentally where the bl runtime raises the CONTRACT error
    (and (erlang/== o :raised) (raised-pair? n)) :new_more_total
    :else :differ))

; An explicit reduce over every (fn, arity) × argument-set — 21455 calls total.
; Every call runs inside a Task with a 500 ms cap, so a hanging function counts
; as a timeout instead of stalling the sweep.
(def results
  (reduce
    (fn [out [f a]]
      (concat out
        (reduce (fn [acc args]
                  (let [o (norm f (outcome old f args))
                        n (norm f (outcome new f args))]
                    (cons {:f f :a a :args args :o o :n n :verdict (classify f o n)} acc)))
                (list) (arg-sets a))))
    (list) shared))

; Departures the oracle DECLARES, each with its reason there
; (research/rt-cutover/oracle.bl `declared`); a disagreement matching one is
; accounted for, not a defect.
(defn seq-fam? [x] (or (list? x) (vector? x) (lazy? x)))
(defn meta-node? [x]
  (and (tuple? x) (>= (erlang/tuple_size x) 1) (erlang/== (erlang/element 1 x) :meta)))
(defn empty-res? [o n]
  (and (ok-pair? o) (ok-pair? n)
       (vector? (second o)) (erlang/== 0 (count (second o)))
       (list? (second n)) (erlang/== 0 (count (second n)))))

(def declared-ops #{:eqv :compare})
(def declared-sort #{:sort :take})
(def declared-xforms #{:map_xform :filter_xform :take_xform})

(defn declared? [r]
  (let [f (:f r) args (:args r) o (:o r) n (:n r)]
    (cond
      ; sequential-family-is-one-value
      (and (contains? declared-ops f) (erlang/== 2 (count args))
           (list? (first args)) (list? (second args))) true
      (contains? declared-ops f)
        (let [x (first args) y (second args)]
          (or (and (seq-fam? x) (seq-fam? y))
              ; family-rank orders identities (fns, pids, refs) after data
              ; tuples; order between families is the policy table's call
              (and (fn? x) (tuple? y)) (and (tuple? x) (fn? y))
              (and (fn? x) (struct? y)) (and (struct? x) (fn? y))
              ; a {:meta form m} reader wrapper compares as its form
              (meta-node? x) (meta-node? y)))
      ; rt-empty-result-is-a-VECTOR, and rt-yields-raw-tuple-entries: sort walks
      ; a map through RT's seqable
      (contains? declared-sort f)
        (or (empty-res? o n)
            (some (fn [x] (and (map? x) (not (struct? x)))) args))
      ; rt-yields-raw-tuple-entries
      (and (erlang/== f :sorted_set_of) (erlang/== 1 (count args)))
        (let [m (first args)] (and (map? m) (not (struct? m))))
      ; host-struct-leaks-as-a-collection: RT called any non-bl struct a collection
      (and (erlang/== f :coll?) (erlang/== 1 (count args)))
        (let [x (first args)] (and (struct? x) (not (vector? x))))
      ; a transducer is a FRESH closure per call: two are never ==, in either runtime
      (contains? declared-xforms f)
        (and (ok-pair? o) (ok-pair? n) (fn? (second o)) (fn? (second n)))
      :else false)))

(def results
  (map (fn [r] (if (and (erlang/== (:verdict r) :differ) (declared? r))
                 (assoc r :verdict :declared)
                 r))
       results))

(def by (group-by (fn [r] (:verdict r)) results))
(println "functions compared:" (count shared) "  calls:" (count results))
(doseq [v [:agree :new_more_total :declared :differ]]
  (println "  " v ":" (count (get by v (list)))))

(def differ (get by :differ (list)))

(doseq [grp (sort-by (fn [g] (list (first (first g)) (second (first g))))
                   (group-by (fn [r] (list (:f r) (:a r))) differ))]
  (let [rows (second grp) r (first rows)]
    (println "DIFFER" (:f r) "/" (:a r) "(" (count rows) "calls) e.g."
             (String/slice (pr-str (:args r)) 0 160))
    (println "    old" (String/slice (pr-str (:o r)) 0 120))
    (println "    new" (String/slice (pr-str (:n r)) 0 120))))

(if (empty? differ)
  (println "DIFF PASS: no undeclared differences")
  (do (println "DIFF FAIL:" (count differ) "undeclared differences")
      (System/halt 1)))
