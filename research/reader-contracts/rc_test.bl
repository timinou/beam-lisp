; research/reader-contracts/rc_test.bl
;
;   ./bl -p research/reader-contracts test research/reader-contracts/rc_test.bl
;
; The suite the four contracts are pinned by, and the seed of the
; unbalanced-paren suite. Every case names a mistake a PERSON makes — not a
; shape the parser happens to have.
;
; Assertions go through reader-node's accessors rather than literal node tuples,
; because in beam-lisp `{:list …}` is a MAP and the reader emits an Erlang
; TUPLE; the accessors are the vocabulary that hides the difference.

(ns rc_test
  (:require [rc-reader :as r]
            [rc-repair :as fix]
            [reader-node :as rn]))

(def nl (unicode/characters_to_binary (list 10)))
(def q (unicode/characters_to_binary (list 34)))
(def bs (unicode/characters_to_binary (list 92)))

(defn- diags-of [src opts] (second (r/read src (merge {:file "t.bl"} opts))))
(defn- forms-of [src opts] (first (r/read src (merge {:file "t.bl"} opts))))
(defn- first-diag [src] (first (diags-of src {:file "t.bl"})))

; ── diagnostics: what is wrong, and where ────────────────────────────────────

(deftest stray-closer-names-its-position
  (let [src (str "(defn f [x]" nl "  (let [y (inc x)] (IO/puts y))))" nl)
        d (first-diag src)]
    (is (= :unexpected-close (get d :kind)))
    (is (= 2 (get (get d :span) :line)))
    ; OFFSETS make this exact: the stray char is the one before the newline.
    (is (= (- (String/length src) 2) (get (get d :span) :offset)))
    (is (= ")" (r/slice src (get d :span))))))

(deftest mismatch-names-both-delimiters
  (let [d (first-diag (str "(let [x 1)" nl "  x)" nl))]
    (is (= :mismatch (get d :kind)))
    (is (= "]" (get d :expected)))
    (is (= "[" (get d :opened)))
    ; the opener is on a DIFFERENT line from the mistake, which is why a
    ; one-line message cannot do the job
    (is (= 1 (get (get d :opened-span) :line)))
    (is (= 6 (get (get d :opened-span) :col)))))

(deftest unterminated-names-the-innermost-opener-and-lists-the-rest
  (let [d (first-diag (str "(defn f [x]" nl "  (let [y 2]" nl))]
    (is (= :unterminated (get d :kind)))
    (is (= "(" (get d :opened)))
    (is (= ")" (get d :expected)))
    ; the caret lands on the opener a human forgot, not on EOF
    (is (= 2 (get (get d :span) :line)))
    (is (= 3 (get (get d :span) :col)))
    (is (= 2 (count (get d :unclosed))))
    (is (= 3 (get (get d :eof-span) :line)))))

(deftest unterminated-string-is-its-own-diagnostic
  (let [d (first-diag (str "(defn f [] (str " q "hello" nl))]
    (is (= :unterminated-string (get d :kind)))
    (is (= q (get d :opened)))
    (is (= 1 (get (get d :span) :line)))))

(deftest the-one-line-form-is-file-line-col
  (let [line (r/diag-line (first-diag (str "(a" nl)))]
    (is (String/starts_with? line "t.bl:1:1: unterminated ("))))

; ── traps: parentheses that are not parentheses ──────────────────────────────

(deftest a-closer-in-a-string-a-comment-and-a-char-literal-is-not-a-closer
  ; (defn f []        ;; a closer inside a string is text
  ;   (str ")" \))    ;; and so is one in a character literal
  ;   ; (             ;; and an opener in a comment opens nothing
  ; )
  (let [src (str "(defn f []" nl "  (str " q ")" q " " bs "))" nl "  ; (" nl ")" nl)]
    (is (= 0 (count (diags-of src {:file "t.bl"}))))))

(deftest a-lone-closer-in-a-string-closes-nothing
  (is (= 0 (count (diags-of (str "(str " q ")" q ")" nl) {:file "t.bl"})))))

(deftest an-opener-in-a-comment-opens-nothing
  (is (= 0 (count (diags-of (str "; ( ( (" nl "(inc 1)" nl) {:file "t.bl"})))))

(deftest a-set-closes-with-a-brace
  (is (= 0 (count (diags-of (str "#{1 2 3}" nl) {:file "t.bl"}))))
  (let [d (first-diag (str "#{1 2 3)" nl))]
    (is (= :mismatch (get d :kind)))
    (is (= "}" (get d :expected)))))

; ── contract 1: options are a value ──────────────────────────────────────────

(deftest location-none-keeps-every-node-bare
  (let [f (first (forms-of "(a)" {:location :none}))]
    (is (= :list (rn/node-tag f)))))

(deftest location-lists-is-the-default
  (let [f (first (forms-of "(a)" {:file "t.bl"}))]
    (is (= :meta (rn/node-tag f)))
    (is (= :list (rn/node-tag (rn/node-form f)))))
  ; a vector stays bare under the default, which is today's reader shape
  (let [v (first (forms-of "[1 2]" {:file "t.bl"}))]
    (is (= :vector (rn/node-tag v)))))

(deftest location-collections-wraps-a-vector-and-its-span-slices-back
  (let [src "[1 2]"
        v (first (forms-of src {:location :collections}))
        sp (rn/node-pos v)]
    (is (= :meta (rn/node-tag v)))
    (is (= :vector (rn/node-tag (rn/node-form v))))
    (is (= src (r/slice src sp)))
    (is (= 0 (get sp :offset)))
    (is (= 5 (get sp :end-offset)))))

(deftest raise-mode-carries-the-position-in-the-message
  (let [msg (try (do (r/read! (str "(defn f [x]" nl "  (inc x" nl) {:file "t.bl"})
                         "no error")
                     (catch e (ex-message e)))]
    (is (String/starts_with? msg "t.bl:2:3:"))))

(deftest read-cond-preserve-keeps-every-branch
  (let [v (first (forms-of "[1 #?(:clj :x :cljs :y)]" {:read-cond :preserve}))
        items (rn/node-items v)]
    (is (= 2 (count items)))
    (is (= :read-cond (rn/node-tag (second items))))))

(deftest read-cond-select-takes-the-branch-that-matches
  (let [v (first (forms-of "[1 #?(:clj :x :cljs :y)]" {:file "t.bl"}))
        items (rn/node-items v)]
    (is (= :keyword (rn/node-tag (second items))))
    (is (= "x" (rn/node-name (second items))))))

; ── contract 2: offsets ──────────────────────────────────────────────────────

(deftest a-forms-own-text-keeps-its-comments
  (let [src (str "(defn f [x]" nl "  ; why" nl "  (inc x))" nl)
        r0 (r/read-next-string (r/stream src {:file "t.bl"}))]
    (is (= :ok (first r0)))
    (is (= (str "(defn f [x]" nl "  ; why" nl "  (inc x))") (nth r0 2)))))

; ── contract 4: streaming ────────────────────────────────────────────────────

(deftest one-form-at-a-time-then-eof
  (let [s0 (r/stream "(a b) :after" {:file "t.bl"})
        r1 (r/read-next s0)
        r2 (r/read-next (nth r1 2))
        r3 (r/read-next (nth r2 2))]
    (is (= :ok (first r1)))
    (is (= :keyword (rn/node-tag (second r2))))
    (is (= :eof (first r3)))))

(deftest the-source-text-of-a-form-comes-back-with-it
  (let [src (str "(defn f [x]" nl "  ;; c" nl "  (inc x)) 42")
        r1 (r/read-next-string (r/stream src {:file "t.bl"}))
        r2 (r/read-next-string (nth r1 3))]
    (is (= (str "(defn f [x]" nl "  ;; c" nl "  (inc x))") (nth r1 2)))
    (is (= 42 (second r2)))))

; ── goal #1: repairs, and knowing when NOT to guess ──────────────────────────

(deftest a-stray-closer-has-two-repairs-that-both-work
  (let [src (str "(a b))" nl)
        d (first-diag src)
        cs (fix/candidates d src {:file "t.bl"})
        choice (fix/choose cs)]
    (is (fix/ambiguous? cs))
    (is (= 2 (count (fix/viable cs))))
    (is (get choice :ambiguous))
    (is (= :cheapest-then-declared-preference (get choice :policy)))
    (is (= 1 (count (get choice :others))))))

(deftest forward-verification-collapses-a-false-tie
  (let [src (str "(when x [1 2)" nl)
        d (first-diag src)
        cs (fix/candidates d src {:file "t.bl"})
        chosen (get (fix/choose cs) :chosen)]
    ; two candidates at one edit each, but only one yields a text that parses
    (is (= 2 (count (filter (fn [c] (= 1 (get c :edits))) cs))))
    (is (= 1 (count (fix/viable cs))))
    (is (not (fix/ambiguous? cs)))
    (is (= :insert-close-before (get chosen :kind)))
    (is (= "]" (get chosen :insert)))))

(deftest an-unclosed-form-with-real-source-after-it-is-genuinely-ambiguous
  (let [src (str "(defn f [x]" nl "  (inc x" nl nl "(defn g [y] (dec y))" nl)
        d (first-diag src)
        cs (fix/candidates d src {:file "t.bl"})
        kinds (set (map (fn [c] (get c :kind)) (fix/viable cs)))]
    ; closing at the end of line 2 and closing at EOF are both valid, and they
    ; are DIFFERENT PROGRAMS (the second swallows g into f). No tool may choose
    ; silently here.
    (is (fix/ambiguous? cs))
    (is (contains? kinds :insert-closers-at-boundary))
    (is (contains? kinds :insert-closers-at-eof))))

(deftest an-unclosed-form-at-eof-is-not-ambiguous
  (let [src (str "(defn f [x]" nl "  (let [y 2]" nl)
        cs (fix/candidates (first-diag src) src {:file "t.bl"})]
    ; a trailing newline is not a choice
    (is (not (fix/ambiguous? cs)))
    (is (= 1 (count (fix/viable cs))))))

(deftest every-chosen-repair-reads-cleanly
  (doseq [src (list (str "(a b))" nl)
                   (str "(when x [1 2)" nl)
                   (str "(defn f [x]" nl "  (inc x" nl nl "(defn g [y] (dec y))" nl)
                   (str "(defn f [x]" nl "  (let [y 2]" nl)
                   (str "(let [x 1)" nl "  x)" nl))]
    (let [cs (fix/candidates (first-diag src) src {:file "t.bl"})
          choice (fix/choose cs)]
      (is (get choice :solved))
      (is (fix/solves? src (get choice :chosen) {:file "t.bl"})))))

(deftest the-fix-loop-clears-every-fixture
  ; including one with two independent defects: an unterminated string AND two
  ; unclosed openers, which no single edit can clear
  (doseq [src (list (str "(a b))" nl)
                   (str "(when x [1 2)" nl)
                   (str "(defn f [x]" nl "  (inc x" nl nl "(defn g [y] (dec y))" nl)
                   (str "(defn f [x]" nl "  (let [y 2]" nl)
                   (str "(defn f [] (str " q "hello" nl)
                   (str "(let [x 1)" nl "  x)" nl))]
    (is (get (fix/fix-all src {:file "t.bl"}) :ok))))

; ── the rendered message ─────────────────────────────────────────────────────

(deftest the-message-has-a-caret-and-a-help-line
  (let [src (str "(when x [1 2)" nl)
        out (fix/render (first-diag src) src)]
    (is (String/starts_with? out "t.bl:1:13:"))
    (is (String/contains? out (str "1 | (when x [1 2)")))
    (is (String/contains? out "^"))
    (is (String/contains? out "help: insert ] before the )"))))

(deftest the-openers-own-snippet-is-shown-when-it-is-elsewhere
  (let [src (str "(let [x 1" nl "     y 2)" nl)
        out (fix/render (first-diag src) src)]
    (is (String/contains? out "opened here is never closed"))))

(deftest a-long-line-is-windowed-around-the-caret
  (let [pad (join "" (map (fn [i] "a") (range 60)))
        src (str "(defn f [x]" nl "  (let [y (inc x)] (IO/puts " q pad q " y))))" nl)
        out (fix/render (first-diag src) src)]
    (is (String/contains? out "…"))
    (is (String/contains? out "^"))))

(deftest when-repairs-tie-the-message-asks
  (let [src (str "(defn f [x]" nl "  (inc x" nl nl "(defn g [y] (dec y))" nl)
        out (fix/render (first-diag src) src)]
    (is (String/contains? out "which did you mean?"))
    (is (String/contains? out "clears the file"))))
