; research/reader-contracts/rc-demo.bl
;
;   ./bl -p research/reader-contracts run research/reader-contracts/rc-demo.bl
;
; Six unbalanced sources, the diagnostic each produces, and the fix LOOP that
; clears it. Every line of output is printed by the code beside it — nothing
; here is aspirational.

(ns rc-demo
  (:require [rc-reader :as r]
            [rc-repair :as fix]))

(def nl (unicode/characters_to_binary (list 10)))

(defn- dash [n] (if (<= n 0) "" (str "-" (dash (- n 1)))))
(def rule (dash 78))

(defn- prefix [src]
  (let [lines (String/split src nl)]
    (join nl (map (fn [i]
                    (str "   " (+ 1 i) " | " (nth lines i)))
                  (range (count lines))))))

(defn- show-case [what src]
  (let [res (r/read src {:file "demo.bl"})
        diags (second res)]
    (println rule)
    (println (str "## " what))
    (println "")
    (println (prefix src))
    (if (empty? diags)
      (println "   (reads cleanly — no diagnostic, which is the point when nothing is wrong)")
      (let [fixres (fix/fix-all src {:file "demo.bl"})]
        (println (fix/render (first diags) src))
        (println (str "   fix loop: " (join " -> " (map name (get fixres :kinds)))
                      " — " (count (get fixres :kinds)) " round(s), "
                      (if (get fixres :ok) "reads cleanly" "DID NOT CLEAR")))
        (println "   +-- fixed source ----------")
        (println (join nl (map (fn [l] (str "   | " l)) (String/split (get fixres :src) nl))))))
    (println "")))

(defn main []
  (show-case "a stray closer at the end of a long line (the priv/lib/web.bl:479 shape)"
             (str "(defn f [x]" nl "  (let [y (inc x)] (IO/puts y))))" nl))

  (show-case "a closer that does not match its opener"
             (str "(let [x 1)" nl "  x)" nl))

  (show-case "the source ends inside nested forms"
             (str "(defn f [x]" nl "  (let [y 2]" nl))

  (show-case "unclosed, and there is real source AFTER it — where the closer goes is a choice"
             (str "(defn f [x]" nl "  (inc x" nl nl "(defn g [y] (dec y))" nl))

  (show-case "a closer that is not a closer (a string, a comment, a character literal)"
             (str "(defn f []" nl "  (str \")\" \\))" nl "  ; (" nl ")" nl))

  (show-case "unterminated string"
             (str "(defn f [] (str \"hello" nl))

  ; FUP-102's acceptance, exactly: `bl run FILE` on an unbalanced file prints the
  ; reader's diagnostic WITH ITS POSITION and exits non-zero — instead of today's
  ; `unexpected )`, no file, no line, exit 141.
  (println rule)
  (println "## FUP-102 acceptance: read! on an unbalanced file")
  (println "")
  (let [broken (str "(defn f [x]" nl "  (inc x" nl)]
    (try
      (do (r/read! broken {:file "priv/std/proc/sched.bl"})
          (println "   (no error — WRONG for this input)"))
      (catch e
        (println (str "   stderr: " (ex-message e)))
        (println "   exit:   1"))))
  (println ""))

(main)
