; 06_backups_dr.bl — a restore you can prove, on a schedule.
; Run: ./blx run research/vps_spike/06_backups_dr.bl
;
; Hints at: backups-and-dr.md, bootstrap.md §recovery, devops.md §storage.
;
; A backup is judged by one question: when did you last PROVE a restore works?
; Here the proof is a fence-bounded function whose result is a datom, so the
; answer to the question is itself a query (max :drill/at). Checkpoint/restore
; is a real round-trip: facts out of one conn, back into a fresh conn, queried
; to confirm equality.

(ns vps.backups (:require [datom] [fence]))

(def schema
  [{:db/ident :svc/id  :db/valueType :db.type/string :db/unique :db.unique/identity}
   {:db/ident :svc/src :db/valueType :db.type/string}
   {:db/ident :drill/at :db/valueType :db.type/long}
   {:db/ident :drill/ok :db/valueType :db.type/boolean}
   {:db/ident :drill/checkpoint :db/valueType :db.type/long}])

;; ── the live node's desired state ───────────────────────────────────────────
(def prod (datom/connect schema))
(datom/transact! prod [{:db/id -1 :svc/id "web" :svc/src "v3"}
                       {:db/id -2 :svc/id "api" :svc/src "v2"}
                       {:db/id -3 :svc/id "cron" :svc/src "v1"}])

;; ── checkpoint: extract the desired-state facts (→ S3 in the real thing) ─────
(defn checkpoint [conn]
  (datom/q '[:find ?id ?src :where [?e :svc/id ?id] [?e :svc/src ?src]] (datom/db conn)))

;; ── restore: load a checkpoint into a FRESH conn (a reprovisioned node) ──────
(defn restore [ckpt]
  (let [c (datom/connect schema)]
    (datom/transact! c
      (vec (map-indexed (fn [i [id src]] {:db/id (- (- i) 1) :svc/id id :svc/src src})
                        (into [] ckpt))))
    c))

;; ── the restore drill: bounded, and its result is a fact ────────────────────
(defn restore-drill! [conn]
  (fence/fence-fn 5000
    (fn []
      (let [ckpt (checkpoint conn)
            scratch (restore ckpt)
            back (checkpoint scratch)]
        (= (set ckpt) (set back))))))          ; smoke: restored == original

(def ckpt (checkpoint prod))
(println "── checkpoint ──" (count ckpt) "services")
(def drill (restore-drill! prod))
(def drill-ok (= {:ok true} drill))
(println "── restore drill ──" (pr-str drill))

;; record the drill result — so "when did we last prove restore?" is a query
(when drill-ok
  (datom/transact! prod [{:db/id -1 :drill/at 1700 :drill/ok true :drill/checkpoint (count ckpt)}]))

(def last-drill
  (first (first (datom/q '[:find (max ?t) :where [?d :drill/at ?t]] (datom/db prod)))))
(println "── compliance query: last proven restore @" last-drill "──")

;; ── assertions ──────────────────────────────────────────────────────────────
(def ok (and (= 3 (count ckpt))
             drill-ok                              ; restore verified equal
             (= 1700 last-drill)))                 ; drill is a queryable fact
(println "")
(println (str (if ok "PASS" "FAIL") " 06_backups_dr  (a restore you can prove)"))
