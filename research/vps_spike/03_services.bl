; 03_services.bl — a service is a supervised tree inside a capped env.
; Run: ./blx run research/vps_spike/03_services.bl
;
; Hints at: services-and-schedules.md, devops.md §services, zero-downtime L2.
;
; systemd dissolves upward: `systemctl restart` becomes OTP restarting a child;
; the service's isolation is a vm.core env (capped, owned) and its liveness is a
; super tree. Draining the env is total teardown — no orphans, because ownership
; is substrate bookkeeping. The scheduler (proc.sched in the full tree) is
; modelled here as a tiny deadline wheel to hint at cron-as-data.

(ns vps.services (:require [super] [vm.core :as vm]))

;; ── a service: an env that owns a supervised tree ───────────────────────────
(defn start-service [id]
  (let [v (vm/spawn-vm {:id id :root "/tmp" :base :global :caps :all})
        sup (vm/run v
              (fn []
                (supervise :one-for-one
                  [(worker :web  (fn [] (Process/sleep 60000)))
                   (worker :cron (fn [] (Process/sleep 60000)))])))]
    {:vm v :sup sup}))

(def svc (start-service "blog@main"))
(println "── service blog@main up ──")
(println "  tree:" (pr-str (map :id (super/children (:sup svc)))))

;; systemctl restart web  ≡  OTP restart of the :web child
(def before (super/child-of (:sup svc) :web))
(erlang/exit before :kill)
(Process/sleep 120)
(def after (super/child-of (:sup svc) :web))
(println "  restart :web →" (if (not= before after) "OTP put it back" "STUCK"))

;; ── cron as data: a deadline wheel (proc.sched, in miniature) ───────────────
;; schedules are declarations, not daemons: {:id :due-ms :fired}
(defn due? [sched now] (>= now (:due-ms sched)))
(def now 1000)
(def schedules [{:id :backup :due-ms 500}    ; overdue
                {:id :reap   :due-ms 2000}]) ; not yet
(def fired (filter (fn [s] (due? s now)) schedules))
(println "── schedule wheel @t=" now "──")
(doseq [s schedules]
  (println (str "  " (name (:id s)) "  due=" (:due-ms s)
                (if (due? s now) "  ⟵ FIRE" ""))))

;; drain: total teardown of the env and its owned processes
(def halted (vm/drain (:vm svc)))
(println "── drained ──" (pr-str halted))

;; ── assertions ──────────────────────────────────────────────────────────────
(def ok (and (not= before after)                 ; worker restarted
             (= 1 (count fired))                 ; exactly :backup is due
             (= :backup (:id (first fired)))
             (>= (:halted halted) 0)))            ; env torn down cleanly
(println "")
(println (str (if ok "PASS" "FAIL") " 03_services  (systemd+cron dissolved upward)"))
