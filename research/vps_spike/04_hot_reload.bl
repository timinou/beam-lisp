; 04_hot_reload.bl — app AND bl updates are hot, never blue-green.
; Run: ./blx run research/vps_spike/04_hot_reload.bl
;
; Hints at: zero-downtime.md L1, devops.md §deploys, reload.bl (the REAL gate).
;
; The correction this spike encodes: blue-green is for the PLATFORM floor only
; (kernel, OTP, the OS closure — see 09_platform_swap). EVERYTHING that is bl —
; an app namespace, and the language's own stdlib namespaces — updates by HOT
; RELOAD inside the one long-lived node. No request is dropped and nothing
; restarts, because a `defn` swap is atomic per var: a caller in flight finishes
; on its captured body, the next call resolves the new one.
;
; And the gate is SAFE BY CONSTRUCTION: `reload/commit` proves the whole bundle
; coherent STATICALLY before swapping; an incoherent edit is HELD with the old
; code still serving. This spike drives the real reload machinery — not a model.

(ns vps.hot-reload (:require [reload]))

(reload/set-enabled! true)                 ; prod gate: mutating reloads on

;; ── a live app namespace, v1, being called by a concurrent stream ───────────
(reload/stage "app" "(ns app) (defn handle [] \"v1\")")
(reload/commit)
(def results (atom []))
(def halt? (atom false))
(def loper
  (erlang/spawn
    (fn [] (loop []
             (when (not (deref halt?))
               (swap! results conj (app/handle))
               (Process/sleep 2) (recur))))))
(Process/sleep 20)

;; ── L1a: an APP update, hot — stage v2, commit, keep serving ────────────────
(reload/stage "app" "(ns app) (defn handle [] \"v2\")")
(def app-up (reload/commit))
(Process/sleep 20)
(println "── app update ──" (:status app-up) " handle→" (app/handle))

;; ── L1b: a BL STDLIB update, hot — a stdlib ns swaps the same way ───────────
;; define a tiny "stdlib" ns, then hot-upgrade it while the node lives
(reload/stage "mylib" "(ns mylib) (defn version [] \"lib-1\")")
(reload/commit)
(def before-lib (mylib/version))
(reload/stage "mylib" "(ns mylib) (defn version [] \"lib-2\")")
(def lib-up (reload/commit))
(println "── bl/stdlib update ──" (:status lib-up)
         " version " before-lib "→" (mylib/version))

;; ── the safety net: an INCOHERENT edit is refused, old code serves ──────────
;; the bundle drops `helper` yet a sibling still calls it → dangling, in-image.
(reload/stage "app" "(ns app) (defn helper [] 1) (defn handle [] (str \"v\" (helper)))")
(reload/commit)
(def bad "(ns app) (defn handle [] (helper))")    ; helper removed, still called
(reload/stage "app" bad)
(def coh (reload/coherence [["app" bad]]))
(def held (reload/commit))
(Process/sleep 10)
(reset! halt? true) (Process/sleep 10)
(println "── incoherent edit ──" (:status held)
         " coherence-errors=" (count coh) " handle STILL→" (app/handle))

;; ── the stream never saw a bad value across all of it ───────────────────────
(def seen (deref results))
(def answers (distinct seen))
(println "── request stream ──" (count seen) "reqs, answers=" (pr-str answers))

;; ── assertions ──────────────────────────────────────────────────────────────
(def ok (and (= :applied (:status app-up))      ; app hot-updated
             (= :applied (:status lib-up))      ; bl/stdlib hot-updated
             (= "lib-2" (mylib/version))
             (= 1 (count coh))                  ; the bad edit is incoherent (dangling)
             (= :held (:status held))           ; and REFUSED — old code serves
             (> (count seen) 5)
             ;; every observed value is a real answer, never a broken one
             (every? (fn [x] (or (= x "v1") (= x "v2") (= x "v1") (String/starts_with? x "v"))) seen)))
(println "")
(println (str (if ok "PASS" "FAIL") " 04_hot_reload  (app+bl hot; incoherent HELD)"))
