(ns research.navigation.evidence-test
  (:require [datom] [codebase :as cb] [typed :as typed]
            [deodorant :as d] [system.analyze :as analyze]
            [system.incr :as incr] [system.footprint :as fp]
            [system.smt :as translation]))

(defn corpus [sources]
  (let [c (cb/connect-codebase)]
    (doseq [[i [ns source]] (map-indexed (fn [i x] [i x]) sources)]
      (let [facts (cb/index-source {} ns source)
            rows (concat (:fn facts) (:calls facts) (:requires facts) (:instr facts))]
        (datom/transact! c (mapv (fn [r] (update r :db/id + (* 1000000 i))) rows))))
    (datom/db c)))

(deftest graph-completeness-is-useful-but-not-a-cache-permission
  (let [good (corpus [["probe.view" "(ns probe.view (:require [probe.data :as data])) (defn render [x] (data/read x))"]
                     ["probe.data" "(ns probe.data) (defn read [x] x)"]])
        bad (corpus [["probe.view" "(ns probe.view) (defn render [f x] (f x))"]])
        a (cb/dependency-cone good "probe.view/render")
        b (cb/dependency-cone bad "probe.view/render")]
    (is (= true (:complete a)))
    (is (= ["probe.data/read" "probe.view/render"] (:reached a)))
    (is (= false (:complete b)))
    (is (some (fn [c] (= :unresolved (:status c))) (:calls b)))
    (println "PROTOTYPE call-cone" {:closed (:complete a) :callback (:complete b)})))

(deftest changed-helper-dirties-caller-despite-unchanged-caller-body
  (let [a "(defn leaf [x] (erlang/+ x 1)) (defn entry [x] (leaf x)) (defn other [x] x)"
        b "(defn leaf [x] (erlang/+ x 2)) (defn entry [x] (leaf x)) (defn other [x] x)"
        first (incr/analyze-incremental {} a)
        next (incr/analyze-incremental (:cache first) b)
        dirty (incr/dirty-set (analyze/analyze a) (:misses next))]
    (is (some (fn [x] (= x "entry")) (:hits next)))
    (is (contains? dirty "entry"))
    (is (contains? dirty "leaf"))
    (is (not (contains? dirty "other")))
    (println "PROTOTYPE invalidation" {:local-hits (:hits next) :dirty dirty})))

(deftest read-only-effect-needs-a-resource-version
  (let [s (get (analyze/analyze "(defn read-value [] (deref state))") "read-value")
        cell (atom 1) read (fn [] (deref cell)) a (read)]
    (is (fp/pure? (:footprint s)))
    (is (seq (:footprint s)))
    (reset! cell 2)
    (is (not= a (read)))
    (println "PROTOTYPE read-only-not-stable" {:footprint (:footprint s) :before a :after (read)})))

(deftest type-and-cost-evidence-are-not-effect-evidence
  (let [typed (typed/check-source "(defn numeric [x] (erlang/+ x 1))" "probe.types")
        c (cb/connect-codebase)
        _ (cb/transact-source! c {} "probe.cost"
            "(defn row [db id] (datom/pull db '[*] id)) (defn rows [db ids] (mapv (fn [id] (row db id)) ids))")
        sites (cb/nplus1 (datom/db c))]
    (is (= [] (:warnings typed)))
    (is (seq sites))
    (is (d/n+1-read? '(mapv (fn [id] (datom/pull db '[*] id)) ids)))
    (println "PROTOTYPE nplus1" sites)))

(deftest ambiguous-types-must-not-authorize-scalar-proof
  ;; Record actual standalone translator behavior, and test our stricter gate.
  ;; This does not claim every caller exposes that behavior unsafely.
  (let [tags #{:int :string}
        existing (translation/sort-of-tags tags)
        safe (if (= 1 (count tags)) (translation/sort-of-tags tags) :unknown)]
    (is (= "Int" existing))
    (is (= :unknown safe))
    (println "PROTOTYPE ambiguous-sort" {:tags tags :existing existing :admitted safe})))
