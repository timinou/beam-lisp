(ns research.navigation.scoped-page-test
  (:require [datom] [datom.conn :as conn] [datom.db :as db]
            [datom.index :as index] [datom.codec :as codec]
            [datom.store :as store] [datom.store-ets :as ets-store]
            [datom.store-fjall :as fjall]))

(def schema [{:db/ident :p/firm :db/valueType :db.type/long}
             {:db/ident :p/at :db/valueType :db.type/long :db/index true}
             {:db/ident :p/order :db/valueType :db.type/tuple
              :db/tupleAttrs [:p/firm :p/at] :db/index true}])

(defn tuple-prefix [attr scope]
  ;; Fixed tuple arity is required. Removing the vector terminator exposes the
  ;; already self-delimited first component. No persisted codec changes.
  (let [component (codec/encode-value [scope])]
    (erlang/iolist_to_binary
      (list (index/key-prefix :avet attr)
            (binary/part component 0 (dec (erlang/byte_size component)))))))

(defn fixture [s foreign]
  (let [c (conn/connect-with s schema)]
    (datom/transact! c (mapv (fn [i] {:db/id (- -1 i) :p/firm 7 :p/at i}) (range 12)))
    (datom/transact! c (mapv (fn [i] {:db/id (- -1000 i) :p/firm 8 :p/at (+ 100 i)}) (range foreign)))
    c))

(deftest exact-tuple-prefix-is-not-a-component-prefix
  (let [s (ets-store/open) c (fixture s 32)
        naive (index/key-prefix :avet :p/order [7])
        p (store/ordered-page s naive nil (index/prefix-end naive) 5 :desc)]
    (is (= [] (:datoms p)))
    (println "PROTOTYPE naive-tuple-prefix" {:rows (count (:datoms p))})))

(deftest compound-range-work-does-not-grow-with-foreign-rows
  (doseq [s [(ets-store/open) (fjall/open-fresh)]]
    (let [c (fixture s 32)
          prefix (tuple-prefix :p/order 7)
          page (store/ordered-page s prefix nil (index/prefix-end prefix) 5 :desc)
          expected (take 5 (reverse (sort (mapv second
                       (datom/q '[:find ?e ?at :in $ ?firm
                                 :where [?e :p/firm ?firm] [?e :p/at ?at]] (conn/db c) 7)))))]
      (is (= (vec expected) (mapv (fn [d] (second (nth d 2))) (:datoms page))))
      (is (= 5 (count (:datoms page))))
      (is (every? (fn [d] (= 7 (first (nth d 2)))) (:datoms page)))
      (datom/transact! c (mapv (fn [i] {:db/id (- -2000 i) :p/firm 8 :p/at (+ 1000 i)}) (range 128)))
      (let [again (store/ordered-page s prefix nil (index/prefix-end prefix) 5 :desc)]
        (is (= (:datoms page) (:datoms again)))
        (is (= (:bytes page) (:bytes again)))
        (println "PROTOTYPE scoped-access" {:backend (type s) :foreign-before 32 :foreign-after 160
                                           :page-rows (count (:datoms again)) :bytes (:bytes again)})))))

(deftest adding-tuple-schema-now-derives-existing-entities
  (let [c (datom/connect (subvec schema 0 2))]
    (datom/transact! c [{:db/id -1 :p/firm 7 :p/at 11}])
    (conn/install-schema! c [(nth schema 2)])
    (is (= 1 (count (db/datoms (conn/db c) :avet :p/order))))
    (is (= 1 (count (datom/q '[:find ?e :where [?e :p/firm 7]] (conn/db c)))))
    (println "PROTOTYPE tuple-backfill-gap" {:existing-entities 1 :derived-index-rows 1})))
