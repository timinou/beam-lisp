(ns research.navigation.render-validity-test
  (:require [datom] [datom.cache-validity :as validity] [native.eligible :as native] [system.analyze :as analyze] [system.smt :as smt]))

(defn certificate [db principal policy expires]
  {:reads (validity/read-stamp db [:p/read]) :principal principal :policy policy :expires expires})
(defn reusable [saved db principal policy now]
  (and (some? (:reads saved)) (= (:reads saved) (validity/read-stamp db [:p/read]))
       (= principal (:principal saved)) (= policy (:policy saved)) (< now (:expires saved))))

(deftest empty-reads-principal-policy-and-time-are-dependencies
  (let [c (datom/connect [{:db/ident :p/read :db/valueType :db.type/string}
                          {:db/ident :p/other :db/valueType :db.type/string}])
        q '[:find ?v :where [?e :p/read ?v]]]
    ;; A historical write/retraction establishes an attribute mark while the
    ;; current query is empty; an unseen attribute would conservatively use basis.
    (datom/transact! c [{:db/id -1 :p/read "gone"}])
    (let [id (first (first (datom/q '[:find ?e :where [?e :p/read "gone"]] (datom/db c))))]
      (datom/transact! c [[:db/retract id :p/read "gone"]])
      (is (= #{} (datom/q q (datom/db c))))
      ;; Warm runtime definition publication before comparing read stamps.
      (validity/read-stamp (datom/db c) [:p/read])
      (let [saved (certificate (datom/db c) "alice" 4 100)]
        (is (reusable saved (datom/db c) "alice" 4 99))
        (is (not (reusable saved (datom/db c) "bob" 4 99)))
        (is (not (reusable saved (datom/db c) "alice" 5 99)))
        (is (not (reusable saved (datom/db c) "alice" 4 100)))
        (datom/transact! c [{:db/id -2 :p/other "unrelated"}])
        (is (reusable saved (datom/db c) "alice" 4 99))
        (datom/transact! c [{:db/id -3 :p/read "first current result"}])
        (is (not (reusable saved (datom/db c) "alice" 4 99)))
        (is (= #{["first current result"]} (datom/q q (datom/db c))))
        (println "PROTOTYPE render-validity" {:unrelated-write :reuse :empty-read-insertion :miss
                                             :principal-change :miss :policy-change :miss :exact-expiry :miss})))))

(deftest mixed-scalar-tags-reach-an-actual-eligibility-consumer
  ;; Prototype records the existing verdict, rather than changing its contract.
  (let [r (native/eligible "(defn choose [x] (if x 1 \"text\"))" "choose")]
    (println "PROTOTYPE native-mixed-sort" r)
    (is (= true (:eligible r)))
    (is (= "Int" (:sort r)))
    (let [summary (get (analyze/analyze "(defn choose [x] (if x 1 \"text\"))") "choose")
          tags (:returns summary)
          strict (if (= 1 (count tags)) (smt/sort-of-tags tags) :unknown)]
      (is (= #{:int :string} tags))
      (is (= :unknown strict))
      (println "PROTOTYPE strict-native-sort" {:returns tags :sort strict :eligible false}))))
