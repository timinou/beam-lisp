; CK2 preflight — the .bl compiler loads and runs real code.
;
; Reproduce:
;   bin/bl run research/sh13_cutover/ck2_preflight.bl
;
; The original preflight reached into BeamLisp.Ns.Compiler:compile/2 and
; eval'd the returned AST. The compiler now lowers to ANF and emits through
; Emit/Link, so that AST is no longer a value Code.eval_quoted accepts; the
; equivalent public entry point is BeamLisp.Compiler/eval_string, the same
; path the loader takes for every .bl program. Same contract, stronger claim:
; it is now the LIVE compiler, not a preflight of a delegation.
(ns ck2-preflight)
(BeamLisp/init)
(BeamLisp.Loader/ensure_loaded "compiler")

; a real multi-form module: two definitions and a call, compiled by the .bl
; compiler.
(BeamLisp.Compiler/eval_string "(defn sq [x] (* x x))")
(BeamLisp.Compiler/eval_string "(defn sum-sq [xs] (reduce + 0 (map sq xs)))")

(def result (BeamLisp.Compiler/eval_string "(sum-sq [1 2 3 4])"))
(println "sum-sq [1 2 3 4] via the .bl compiler backend:" result)
(println (if (erlang/== result 30)
           "CK2-PREFLIGHT PASS: .bl compiler loads+runs real code"
           "FAIL"))
