; CK2 FIXPOINT PROOF: the .bl compiler compiles ITS OWN SOURCE, and the result
; equals what the oracle produces for the same source. If the self-hosted
; compiler reproduces the compiler byte-for-byte, it is a true fixpoint.
(ns fixpoint (:require [compiler :as c] [self.oracle :as o] [reader-node :as rn]))
(defn ns-of [form]
  (let [f (rn/node-form form)]
    (if (and (= :list (rn/node-tag f)) (not (empty? (rn/node-items f)))
             (= :symbol (rn/node-tag (rn/node-form (first (rn/node-items f)))))
             (= "ns" (rn/node-name (rn/node-form (first (rn/node-items f))))))
      (rn/node-name (rn/node-form (second (rn/node-items f)))) nil)))
(defn selfcompile [path]
  (loop [fs (BeamLisp.Reader/read_all (File/read! path)) cur "user" ok 0 fail 0]
    (if (empty? fs)
      (do (println path "self-compile OK:" ok "FAIL:" fail) (= fail 0))
      (let [f (first fs) nn (ns-of f)
            oenv (BeamLisp.Compiler/new_env cur)
            kenv (assoc (c/new-env cur) :ns cur)
            eq (try (o/ast-equal? (o/oracle-compile f oenv) (c/compile f kenv)) (catch e :err))]
        (recur (rest fs) (if (nil? nn) cur nn)
               (if (= eq true) (+ ok 1) ok)
               (if (= eq true) fail (+ fail 1)))))))
; the .bl compiler compiling its OWN source + the reader + oracle + node api
(selfcompile "priv/compiler.bl")
(selfcompile "priv/reader.bl")
(selfcompile "priv/reader-node.bl")
(selfcompile "priv/self/oracle.bl")
