(ns p3gate (:require [compiler :as c] [self.oracle :as o]))
(def env (BeamLisp.Compiler/new_env "user"))
(def kenv (c/new-env "user"))
(defn check [src]
  (let [form (BeamLisp.Reader/read_one src)
        want (o/oracle-compile form env)
        got  (c/compile form kenv)
        ok (o/ast-equal? want got)]
    (println (if ok "OK  " "FAIL") "::" src)))
(check "42")
(check "3.14")
(check "\"hi\"")
(check ":kw")
(check "true")
(check "nil")
(check "[1 2 3]")
(check "{:a 1 :b 2}")
(check "#{1 2}")
(check "foo")
(check "(+ 1 2)")
(check "(foo 1 2)")
(check "(String/upcase s)")
(check "(lists/reverse xs)")
(check "(:a m)")
(check "(f (g 1) 2)")
