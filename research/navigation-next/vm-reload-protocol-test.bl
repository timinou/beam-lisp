(ns navigation.vm-reload-protocol-test
 (:require [z3] [veritas.model :as vm]))

;; Deliberately split the old snapshot read from its later reset. The current
;; set is authoritative; a pruning snapshot authorizes removal, never replacement.
(def INITIAL {:subscribers #{:dead} :snapshot nil :subscribed? false})
(defn step [s op stale?]
 (case op
  :snapshot (assoc s :snapshot (:subscribers s))
  :subscribe (assoc s :subscribers (conj (:subscribers s) :new) :subscribed? true)
  :prune (if (nil? (:snapshot s)) s
           (assoc s :subscribers (disj (if stale? (:snapshot s) (:subscribers s)) :dead)
                    :snapshot nil))
  s))
(defn protocol [stale?]
 (vm/model "reload pruning preserves concurrent subscriptions"
  {:state INITIAL :init (fn [] (atom INITIAL))
   :commands (into {} (map (fn [op]
     [op {:next (fn [s _] (step s op false))
          :run (fn [system _] (swap! system step op stale?))}])
     [:snapshot :subscribe :prune]))
   :invariants {:membership (fn [_ system]
     (or (not (:subscribed? @system)) (contains? (:subscribers @system) :new)))}}))
(deftest pruning-has-a-replayable-lost-subscription-counterexample
 (let [bad (vm/check (protocol true) {:seed 23 :histories 250 :max-len 20})
       good (vm/check (protocol false) {:seed 23 :histories 250 :max-len 20})]
  (is (= :refuted (:modality bad)))
  (is (= false (:ok (vm/replay (protocol true) (:shrunk bad)))))
  (is (= :witnessed (:modality good)))
  (println "reload-prune-protocol" {:counterexample (:shrunk bad) :fixed (:modality good)})))

(deftest queue-ticket-conservation-has-an-explicit-arithmetic-obligation
 (let [result (z3/check nil
   ['(declare-const live Int) '(declare-const admitted Int) '(declare-const retired Int)
    '(assert (and (<= 0 live) (<= 0 admitted) (<= 0 retired) (<= retired (+ live admitted))))
    '(assert (< (- (+ live admitted) retired) 0))])]
  (is (= :unsat (:status result)))))
