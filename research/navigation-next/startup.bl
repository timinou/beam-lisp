(ns research.navigation-next.startup (:require [compiler :as c]))
(deftest warm-evaluation-and-user-entry
 (println "NEXT-ENTRY-MS" (erlang/system_time :millisecond))
 (let [before (erlang/monotonic_time :microsecond)
       env (c/new-env "research.navigation-next.warm-eval")
       values (mapv (fn [_] (c/eval-string "(+ 1 2)" env "navigation-startup-prototype")) (range 20))
       after (erlang/monotonic_time :microsecond)]
  (is (every? (fn [v] (= 3 v)) values))
  (println "NEXT-WARM-20-US" (- after before))))
