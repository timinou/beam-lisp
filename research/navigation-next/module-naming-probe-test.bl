(ns navigation.module-naming-probe-test (:require [veritas.model :as vm]))
(def PROBE :Elixir.BeamLisp.ModuleNamingProbe)
(def CACHE :bl_emit_module_names_v1)
(defn candidate [ns] (erlang/apply PROBE :module_for (list ns)))
(defn failure-class [f]
 (try (f) :returned (catch e (:__struct__ e))))
(defn cost [f]
 (let [r (elem (erlang/process_info (erlang/self) :reductions) 1)
       t (erlang/monotonic_time :microsecond)]
  (Enum/each (Enum/to_list (range 10000)) (fn [_] (f)))
  {:reductions (- (elem (erlang/process_info (erlang/self) :reductions) 1) r)
   :elapsed-us (- (erlang/monotonic_time :microsecond) t)}))
(deftest canonical-name-memo-is-bounded-and-follows-live-realm-ownership
 (let [source (str (BeamLisp/cwd) "/research/navigation-next/module-naming-host-probe.bl")
       dir (str (System/tmp_dir!) "/module-naming-" (erlang/unique_integer (list :positive)))
       old (erlang/get CACHE) child (BeamLisp.Env/fork)]
  (try
   (File/mkdir_p! dir)
   (let [beam (BeamLisp.AOT/compile_host_file source
                (list (tuple :module PROBE) (tuple :output_dir dir) (tuple :load? false)))]
    (code/load_binary PROBE (erlang/binary_to_list (elem beam 1)) (File/read! (elem beam 1))))
   (doseq [ns [nil 5 :bad (list "a")]]
    (is (= (failure-class (fn [] (BeamLisp.Emit/module_for ns)))
           (failure-class (fn [] (candidate ns))))))
   (doseq [ns ["datom.query.rank-build" "example.a-b" "example.a_b"]]
    (is (= (BeamLisp.Emit/module_for ns) (candidate ns))))
   (BeamLisp.Env/with_env child (fn []
    (doseq [realm ["RCacheFixtureOne" "RCacheFixtureTwo"]]
     (BeamLisp.Env/put_key (tuple :realm_local "example.cached") realm)
     (is (= (BeamLisp.Emit/module_for "example.cached") (candidate "example.cached"))))
    (BeamLisp.Env/delete_key (tuple :realm_local "example.cached"))
    (is (= (BeamLisp.Emit/module_for "example.cached") (candidate "example.cached")))))
   (doseq [n (range 600)] (candidate (str "cache.fixture.n" n)))
   (is (<= (erlang/map_size (erlang/get CACHE)) 256))
   (doseq [round (range 4)]
    (let [ns "datom.query.rank-build"
          baseline (fn [] (BeamLisp.Emit/module_for ns)) optimized (fn [] (candidate ns))
          results (if (even? round) {:baseline (cost baseline) :candidate (cost optimized)}
                      (let [next (cost optimized)] {:baseline (cost baseline) :candidate next}))]
     (println "module-naming-prototype" (assoc results :round round :calls 10000))))
   (finally
    (BeamLisp.Env/destroy child)
    (if (= :undefined old) (erlang/erase CACHE) (erlang/put CACHE old))
    (code/soft_purge PROBE) (code/delete PROBE) (File/rm_rf! dir)))))

(def INITIAL {:realm :a :memo {} :wrong? false})
(defn step [s op namespace-only?]
 (case op
  :switch (assoc s :realm (if (= :a (:realm s)) :b :a))
  :read (let [key (if namespace-only? :ns [:ns (:realm s)])
              value (get (:memo s) key (:realm s))]
          (assoc s :memo (assoc (:memo s) key value) :wrong? (not= value (:realm s))))
  s))
(defn protocol [namespace-only?]
 (vm/model "module names follow freshly resolved realm identity"
  {:state INITIAL :init (fn [] (atom INITIAL))
   :commands (into {} (map (fn [op]
    [op {:next (fn [s _] (step s op false))
         :run (fn [system _] (swap! system step op namespace-only?))}]) [:switch :read]))
   :invariants {:ownership (fn [_ system] (not (:wrong? @system)))}}))
(deftest namespace-only-memo-leaks-ownership
 (let [bad (vm/check (protocol true) {:seed 23 :histories 500 :max-len 20})
       good (vm/check (protocol false) {:seed 23 :histories 500 :max-len 20})]
  (is (= :refuted (:modality bad)))
  (is (= false (:ok (vm/replay (protocol true) (:shrunk bad)))))
  (is (= :witnessed (:modality good)))
  (println "module-naming-protocol" {:counterexample (:shrunk bad) :candidate (:modality good)})))
