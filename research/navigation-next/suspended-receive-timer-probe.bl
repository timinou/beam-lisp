; Run with ./bin/bl --cold run research/navigation-next/suspended-receive-timer-probe.bl.
; Native OTP observations only; stalls are reported as data.
(ns research.suspended-sleep-probe)
(defn- waiting [pid deadline]
 (cond
  (= (tuple :status :waiting) (Process/info pid :status)) :ok
  (< (System/monotonic_time :millisecond) deadline) (recur pid deadline)
  :else :miss))
(defn- trial [kind n]
 (let [parent (erlang/self)
       pid (erlang/spawn
            (fn []
             (case kind
              :dynamic (Process/sleep 1)
              :constant (receive (after 1 :ok))
              :message (let [ticket (erlang/start_timer 1 (erlang/self) :retry)]
                         (receive [:timeout seen :retry] :when (= ticket seen) :ok)))
             (erlang/send parent (tuple :done (erlang/self))))) ]
  (try
   (if (= :ok (waiting pid (+ (System/monotonic_time :millisecond) 100)))
    (try
     (erlang/suspend_process pid) (Process/sleep 3) (erlang/resume_process pid)
     (receive [:done seen] :when (= pid seen) :continue
      (after 100
       (IO/inspect (tuple :stalled kind n (Process/info pid (list :status :reductions :current_stacktrace))))
       (erlang/send pid :probe_wakeup)
       (receive [:done seen] :when (= pid seen) (IO/inspect (tuple :wakeup_recovered kind n))
        (after 100 (IO/inspect (tuple :wakeup_still_stalled kind n))))
       :stop))
     (catch _ :continue))
    :continue)
   (finally (Process/exit pid :kill)))))
(defn- run [kind]
 (loop [n 1]
  (if (or (> n 500) (= :stop (trial kind n)))
   (IO/puts (str "completed " kind ": " (min n 500)))
   (recur (inc n)))))
(IO/inspect (tuple (System/otp_release) (System/version)) (list (tuple :label "runtime")))
(run :dynamic) (run :constant) (run :message)
