(ns navigation.corpus-publication-proof-test
 (:require [z3] [veritas.model :as vm]))

(deftest tally-and-empty-slot-bound-have-explicit-symbolic-obligations
 (let [tally (z3/check nil
               ['(declare-const other Int) '(declare-const old Int) '(declare-const new Int)
                '(assert (and (<= 0 other) (<= 0 old) (<= 0 new)))
                '(assert (not (= (+ (+ other old) (- new old)) (+ other new))))])
       bound (z3/check nil
               ['(declare-const n Int) '(declare-const budget Int)
                '(assert (and (<= 0 n) (<= 0 budget) (<= (* n 256) budget)))
                '(assert (> n (div budget 256)))])
       stale (z3/check nil
               ['(declare-const other Int) '(declare-const old Int) '(declare-const saved Int)
                '(declare-const new Int)
                '(assert (and (= other 0) (= old 104) (= saved 0) (= new 16)))
                '(assert (not (= (+ (+ other old) (- new saved)) (+ other new))))])]
  (is (= :unsat (:status tally)))
  (is (= :unsat (:status bound)))
  (is (= :sat (:status stale)))
  (println "corpus-symbolic-obligations" {:actual-winner-tally (:status tally)
           :charged-empty-slots (:status bound) :stale-counterexample (:status stale)})))

(def INITIAL {:slot 0 :bytes 0 :a nil :b nil})
(defn transition [state op unsafe?]
 (case op
  :read-a (assoc state :a (:slot state))
  :read-b (assoc state :b (:slot state))
  :clear (assoc state :slot 0 :bytes 0)
  :publish-a (if (nil? (:a state)) state
               (assoc state :slot 104 :a nil
                :bytes (+ (:bytes state) (- 104 (if unsafe? (:a state) (:slot state))))))
  :publish-b (if (nil? (:b state)) state
               (assoc state :slot 256 :b nil
                :bytes (+ (:bytes state) (- 256 (if unsafe? (:b state) (:slot state))))))
  state))
(defn protocol [unsafe?]
 (vm/model "derived artifact publication accounts against the winning slot"
  {:state INITIAL :init (fn [] (atom INITIAL))
   :commands (into {} (map (fn [op]
                            [op {:next (fn [state _] (transition state op false))
                                 :run (fn [system _] (swap! system transition op unsafe?))}])
                          [:read-a :read-b :publish-a :publish-b :clear]))
   :invariants {:tally (fn [_ system] (= (:slot @system) (:bytes @system)))
                :nonnegative (fn [_ system] (>= (:bytes @system) 0))}}))
(deftest interleaved-publish-and-clear-refute-stale-accounting
 (let [bad (vm/check (protocol true) {:seed 23 :histories 250 :max-len 20})
       good (vm/check (protocol false) {:seed 23 :histories 250 :max-len 20})]
  (is (= :refuted (:modality bad)))
  (is (= :witnessed (:modality good)))
  (is (= false (:ok (vm/replay (protocol true) (:shrunk bad)))))
  (println "corpus-publication-protocol" {:stale-history (:shrunk bad)
           :serialized (:modality good) :coverage (:coverage good)})))
