(ns navigation.cache-roots
 (:require [datom :as d] [datom.store :as store] [datom.store-map :as memory]
           [datom.store-fjall :as fjall] [datom.attr-basis :as marks]
           [datom.query.corpus :as corpus] [datom.vector :as vector] [env]))
(defn contains-ref [x tag depth]
 (when (< depth 128)
  (cond
   (erlang/is_reference x) (= tag (erlang/ref_to_list x))
   (erlang/is_tuple x) (some #(contains-ref % tag (inc depth)) (erlang/tuple_to_list x))
   (erlang/is_map x) (some #(contains-ref % tag (inc depth)) (maps/to_list x))
   (erlang/is_list x) (some #(contains-ref % tag (inc depth)) x)
   (erlang/is_function x) (contains-ref (elem (erlang/fun_info x :env) 1) tag (inc depth))
   :else false)))
(defn inspect-roots [tag]
 (doseq [t (ets/all)]
  (try (when (some #(contains-ref % tag 0) (ets/tab2list t))
         (println "retained-resource-ETS-root" {:table (ets/info t :name) :owner (ets/info t :owner)}))
       (catch _ nil)))
 (doseq [pid (erlang/processes)]
  (let [info (erlang/process_info pid :dictionary)]
   (when (and (tuple? info) (contains-ref (elem info 1) tag 0))
    (println "retained-resource-dictionary-root" {:pid pid :registered (erlang/process_info pid :registered_name)}))))
 (doseq [name [:datom-conn-registry :datom-guard-registry :datom-profile-registry]]
  (when (not= :undefined (erlang/whereis name))
   (println "retained-resource-agent-root" {:name name :retains? (contains-ref (sys/get_state name 1000) tag 0)}))))
(def SCHEMA [{:db/ident :vec :db/valueType :db.type/vector}])
(let [_ (marks/hydrate! (memory/open)) sentinel (d/connect SCHEMA)
      path (store/fresh-path ".cache-roots") parent (erlang/self) token (env/capture)]
 (try
  (d/transact! sentinel [{:db/id -1 :vec (vector/embedding [1.0 0.0])}])
  (corpus/column (d/db sentinel) :vec)
  (let [child (erlang/spawn
               (fn []
                (env/bind token)
                (let [s (fjall/open path) c (d/connect-with s SCHEMA)
                      tag (erlang/ref_to_list (:handle s))]
                 (try
                  (d/transact! c [{:db/id -1 :vec (vector/embedding [1.0 0.0])}])
                  (corpus/column (d/db c) :vec)
                  (finally (d/release! c) (store/close s)))
                 (erlang/send parent [:root-tag tag]))))
        monitor (erlang/monitor :process child)
        tag (receive [:root-tag t] t (after 20000 (throw :child-timeout)))]
   (receive [:DOWN ref :process pid why] (assert (= :normal why)) (after 20000 (throw :child-timeout)))
   (erlang/garbage_collect)
   (inspect-roots tag)
   (println "memo-collector-before" (BeamLisp.LazyMemo/collector_status))
   (println "memo-cycle-round" (BeamLisp.LazyMemo/collect_cycles))
   (erlang/garbage_collect)
   (Process/sleep 100)
   (inspect-roots tag)
   (erlang/demonitor monitor (list :flush)))
  (finally (d/close! sentinel) (File/rm_rf! path) (File/rm_rf! (str path ".blobs")))))
