(ns research.navigation-next.fjall-rank-crash
 (:require [datom :as d] [datom.conn :as conn] [datom.db :as db]
           [datom.store-fjall :as fjall] [datom.query.rank-plan :as plan]
           [datom.query.rank-index :as rank]))
(def S [{:db/ident :item/scope :db/valueType :db.type/ref :db/index true}
        {:db/ident :item/order :db/valueType :db.type/long :db/index true}
        {:db/ident :item/name :db/valueType :db.type/string}])
(def Q '[:find ?e ?at ?name :in $ ?scope :where [?e :item/scope ?scope]
         [?e :item/order ?at] [?e :item/name ?name]])
(def C '[:find (count ?e) . :in $ ?scope :where [?e :item/scope ?scope]
         [?e :item/order ?at] [?e :item/name ?name]])
(defn demand [condition reason] (when-not condition (throw {:failed reason})))
(let [path (System/get_env "NAV_RANK_CRASH_PATH") phase (System/get_env "NAV_RANK_CRASH_PHASE")
      complete? (= "1" (System/get_env "NAV_RANK_CRASH_COMPLETE"))
      s (fjall/open path) c (d/connect-with s S)]
 (if (= phase "stage")
  (do
   (d/transact! c (mapv (fn [eid] {:db/id eid :item/scope 7 :item/order (quot eid 3) :item/name (str eid)})
                        (range 1 101)))
   (let [database (d/db c) _ (d/q Q database 7)
         p (plan/descriptor Q (db/schema-of database) [7] ['?at :asc])
         id (conn/ensure-query-rank! c p)]
    (doseq [n (range 3)] (conn/advance-query-rank! c id))
    (when complete?
     (loop [n 0]
      (demand (< n 1000) :initial-build-not-bounded)
      (when (= :building (:status (conn/advance-query-rank! c id))) (recur (inc n)))))
    (demand (= (if complete? :complete :building) (:status (rank/header s id))) :stage-status)
    (demand (pos? (:members (rank/header s id))) :no-committed-progress)
    (when-not complete? (demand (nil? (rank/read-page database id p 0 10)) :partial-stage-visible))
    (println "NAV-RANK-COMMITTED-CHECKPOINT")
    (Process/sleep 600000)))
  (try
   (let [database (d/db c) _ (d/q Q database 7)
         p (plan/descriptor Q (db/schema-of database) [7] ['?at :asc])
         id (datom.query.rank-build/ident p) previous (rank/header s id)]
    (demand (= (if complete? :complete :building) (:status previous)) :checkpoint-not-recovered)
    (demand (= 100 (d/q C database 7)) :source-not-recovered)
    (when-not complete? (demand (nil? (rank/read-page database id p 0 10)) :partial-reopen-visible))
    (if complete?
     ;; No source mutation: the automatic query worker must retire the old
     ;; completed certificate and converge, rather than remain stuck forever.
     (let [ready (loop [n 0]
                   (demand (< n 1000) :completed-root-not-rebuilt)
                   (let [r (d/q-window Q database {:order-by ['?at :asc] :offset 90 :limit 10} 7)]
                    (if (= :exact (:status r)) r (do (Process/sleep 10) (recur (inc n))))))]
      (demand (= 100 (:total ready)) :completed-root-count-changed))
     (do
      ;; A normal write invalidates the previous VM's stage atomically.
      (d/transact! c [{:db/id 101 :item/scope 7 :item/order 40 :item/name "new"}])
      (demand (= :aborted (:status (rank/header s id))) :restart-code-not-declined)
      (loop [n 0]
       (demand (< n 1000) :cleanup-not-bounded)
       (when (rank/header s id) (conn/advance-query-rank! c id) (recur (inc n))))))
    (let [next (conn/ensure-query-rank! c p)
          complete (loop [n 0]
                    (demand (< n 1000) :rebuild-not-bounded)
                    (let [h (conn/advance-query-rank! c next)]
                     (if (= :building (:status h)) (recur (inc n)) h)))
          current (d/db c)
          expected (vec (sort-by (fn [r] [(second r) (first r)]) (into [] (d/q Q current 7))))]
     (demand (= :complete (:status complete)) :restart-not-complete)
     (demand (not= (:generation previous) (:generation complete)) :reused-unproven-generation)
     (demand (= (if complete? 100 101) (d/q C current 7)) :source-count-changed)
     (demand (= (subvec expected 90 100) (:rows (rank/read-page current next p 90 10))) :recovered-page-mismatch)
     (println "NAV-RANK-RECOVERY-PASSED" {:members (if complete? 100 101) :offset 90 :rows 10 :completed-root complete?})))
   (finally (d/close! c)))))
