(ns navigation.cache-lifetime-phases
 (:require [datom :as d] [datom.store :as store] [datom.store-fjall :as fjall]
           [datom.attr-basis :as marks] [datom.query.corpus :as corpus]
           [datom.vector :as vector] [env]))
(def SCHEMA [{:db/ident :vec :db/valueType :db.type/vector}])
(defn unlocked? [path]
 (let [script (str "import os,sys,fcntl\nfd=os.open(sys.argv[1],os.O_RDONLY)\n"
                   "try:\n fcntl.flock(fd,fcntl.LOCK_EX|fcntl.LOCK_NB)\n"
                   "except BlockingIOError:\n sys.exit(73)\n")
       result (System/cmd "python3" (to-list ["-c" script path]) (list (tuple :stderr_to_stdout true)))]
  (when (not (contains? #{0 73} (elem result 1))) (throw {:probe result}))
  (= 0 (elem result 1))))
(defn phase [kind]
 (let [path (store/fresh-path ".lifetime-phase") token (env/capture) parent (erlang/self)
       child (erlang/spawn
              (fn []
               (env/bind token)
               (let [s (fjall/open path)]
                (case kind
                 :bare nil
                 :identity (store/cache-key s)
                 :connection (let [c (d/connect-with s SCHEMA)] (d/release! c))
                 :transaction (let [c (d/connect-with s SCHEMA)]
                                (d/transact! c [{:db/id -1 :vec (vector/embedding [1.0 0.0])}])
                                (d/release! c))
                 :corpus (let [c (d/connect-with s SCHEMA)]
                           (d/transact! c [{:db/id -1 :vec (vector/embedding [1.0 0.0])}])
                           (corpus/column (d/db c) :vec)
                           (d/release! c)))
                (store/close s))
               (erlang/send parent [:phase :finished])))
       monitor (erlang/monitor :process child)]
  (try
   (receive [:phase :finished] :ok (after 20000 (throw :phase-timeout)))
   (receive [:DOWN ref :process pid why] (assert (= :normal why)) (after 20000 (throw :phase-timeout)))
   (doseq [name [:datom-conn-registry :datom-guard-registry]]
    (let [pid (erlang/whereis name)]
     (when (not= :undefined pid) (erlang/garbage_collect pid))))
   (erlang/garbage_collect)
   (Process/sleep 100)
   (println "native-lifetime-phase" {:phase kind :unlocked? (unlocked? path)})
   (finally
    (when (Process/alive? child) (Process/exit child :kill))
    (erlang/demonitor monitor (list :flush))
    (File/rm_rf! path) (File/rm_rf! (str path ".blobs"))))))
(doseq [kind [:bare :identity :connection :transaction :corpus]] (phase kind))
