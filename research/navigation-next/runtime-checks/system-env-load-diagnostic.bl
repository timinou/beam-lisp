(ns navigation.system-env-load-diagnostic (:require [env]))
(try
 (env/eval (str "(ns core) " (File/read! "priv/std/test.bl")))
 (env/eval (File/read! "test/bl/vm/system_env_isolation_test.bl"))
 (println "SYSTEM-ENV-FIXTURE-LOADED")
 (catch e (println "SYSTEM-ENV-COMPILE-DIAGNOSTIC" e (ex-data e))))
