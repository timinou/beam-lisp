;; Pinned native prototype: no core/Rt calls on the naming path.
(defn module_name_cached
  "Bounded process-local memo of canonical names, keyed by freshly resolved
   base and namespace. It retains no Env or store handles."
  [ns base]
  (let [key (tuple base ns)
        cache (Process/get :bl_emit_module_names_v1 (maps/new))
        found (Map/get cache key :undefined)]
    (if (erlang/== :undefined found)
      (let [result (Enum/reduce (String/split ns ".") base
                     (fn [segment mod] (Module/concat mod (Macro/camelize segment))))]
        (when (erlang/=< (erlang/+ (erlang/byte_size ns)
                                  (erlang/byte_size (erlang/atom_to_binary base :utf8))) 1024)
          (Process/put :bl_emit_module_names_v1
            (Map/put (if (erlang/>= (erlang/map_size cache) 256) (maps/new) cache) key result)))
        result)
      found)))

(defn base_module_for [ns]
  (module_name_cached ns :"Elixir.BeamLisp.Ns"))

(defn module_for [ns]
  ;; Realm resolution remains fresh on every call. A namespace-only memo would
  ;; return another realm's module after binding or ownership changes.
  (module_name_cached ns (BeamLisp.Emit/realm_base ns :"Elixir.BeamLisp.Ns")))

