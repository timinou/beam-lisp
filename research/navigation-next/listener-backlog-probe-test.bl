(ns navigation.listener-backlog-probe-test
 (:require [vm.net :as net] [vm.osenv :as osenv] [vm.paths :as paths]))
;; Exploratory fixture: on this host 132 connects succeeded with requested
;; backlog=1. This does NOT establish saturation or reproduce a probe failure.
;; Keep the observation separate from accepted endpoint ownership regressions.
(defn with-runtime [f]
 (let [runtime (str (System/user_home!) "/.tmp/nlo-" (erlang/unique_integer (list :positive)))]
  (File/mkdir_p! runtime) (File/chmod runtime 448)
  (try
   (osenv/with-env {"XDG_RUNTIME_DIR" runtime "BL_BUILD_ID" "listener-ownership"} f)
   (finally (File/rm_rf! runtime)))))

(deftest queued-connections-do-not-establish-backlog-saturation
 (with-runtime (fn []
  (let [endpoint (:ok (paths/endpoints nil (paths/build-id) true))
        socket (:sock endpoint)
        options (list (tuple :inet_backend :inet) :local :binary (tuple :active false))
        listener (elem (gen_tcp/listen 0
                   (erlang/++ options (list (tuple :ifaddr (tuple :local (erlang/binary_to_list socket)))
                                         (tuple :backlog 1)))) 1)
        clients (atom []) replacement (atom nil)]
   (try
    (doseq [_ (range 132)]
     (let [result (gen_tcp/connect (tuple :local (erlang/binary_to_list socket)) 0 options 50)]
      (when (= :ok (elem result 0)) (swap! clients conj (elem result 1)))))
    (assert (pos? (count @clients)) "fixture has queued connections")
    (println "listener-backlog-fixture" {:connected (count @clients) :answering (net/answering? socket)})
    (is (net/answering? socket))
    (let [result (net/listen nil (fn [_ _] nil) {:shared true})]
     (reset! replacement (:ok result))
     (is (= :already-running (:error result))))
    (finally
     (when @replacement (net/stop @replacement))
     (doseq [client @clients] (gen_tcp/close client))
     (gen_tcp/close listener)))))))
