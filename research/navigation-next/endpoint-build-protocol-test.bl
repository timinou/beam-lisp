(ns navigation.endpoint-build-protocol-test (:require [veritas.model :as vm]))
(def INITIAL {:ambient :a :bound nil :reported nil})
(defn step [s op frozen?]
 (case op
  :bind (assoc s :bound (:ambient s) :reported nil)
  :change (assoc s :ambient :b)
  :hello (if (:bound s) (assoc s :reported (if frozen? (:bound s) (:ambient s))) s)
  s))
(defn protocol [frozen?]
 (vm/model "handshake reports the build that owns the bound endpoint"
  {:state INITIAL :init (fn [] (atom INITIAL))
   :commands (into {} (map (fn [op]
    [op {:next (fn [s _] (step s op true))
         :run (fn [system _] (swap! system step op frozen?))}]) [:bind :change :hello]))
   :invariants {:identity (fn [_ system]
                  (or (nil? (:reported @system)) (= (:bound @system) (:reported @system))))}}))
(deftest mutable-ambient-build-is-not-endpoint-identity
 (let [bad (vm/check (protocol false) {:seed 23 :histories 500 :max-len 20})
       good (vm/check (protocol true) {:seed 23 :histories 500 :max-len 20})]
  (is (= :refuted (:modality bad)))
  (is (= false (:ok (vm/replay (protocol false) (:shrunk bad)))))
  (is (= :witnessed (:modality good)))
  (println "endpoint-build-protocol" {:negative (:shrunk bad) :candidate (:modality good)})))
