;; Actual ETS projection experiment; no publication/purity authority.
(ns navigation.selected-definition-prototype (:require [env]))
(defn selected [ns name]
 (let [row (Enum/find_value (BeamLisp.Env/chain) :error
             (fn [world]
               (let [key (BeamLisp.Env/pfx world (tuple :ns_defs ns))
                     found (ets/select :beam_lisp_vars
                       (list
                         (tuple (tuple key :"$1")
                           (list (tuple :is_map :"$1")
                                 (tuple :is_map_key (tuple :const name) :"$1"))
                           (list (tuple (tuple :ok (tuple :map_get (tuple :const name) :"$1")))))
                         (tuple (tuple key :"$1") (list (tuple :is_map :"$1"))
                           (list (tuple (tuple :ok nil))))
                         (tuple (tuple key :"$1") (list)
                           (list (tuple (tuple :descriptor :"$1"))))))]
                 (when (seq found) (first found)))))]
  (cond
   (= :error row) nil
   (= :ok (elem row 0)) (elem row 1)
   :else (let [descriptor (elem row 1)]
           (when (and (tuple? descriptor) (= 2 (erlang/tuple_size descriptor))
                      (= :"$beam" (elem descriptor 0))
                      (erlang/function_exported (elem descriptor 1) :__bl_ns_defs__ 0))
             (get (erlang/apply (elem descriptor 1) :__bl_ns_defs__ (list)) name))))))

(deftest exact-projection-respects-whole-table-shadowing
 (let [parent (env/fork (env/current)) child (env/fork parent)
       ns (str "selected.projection.p" (erlang/unique_integer (list :positive)))]
  (try
   (env/with-env parent
    (fn []
     (BeamLisp.Env/put_ns_defs ns {"alpha" [1] "beta" [2]})
     (is (= [1] (selected ns "alpha")))
     (is (nil? (selected ns "missing")))))
   (env/with-env child
    (fn []
     (is (= [1] (selected ns "alpha")))
     (BeamLisp.Env/put_ns_defs ns {"beta" [3]})
     (is (nil? (selected ns "alpha")))
     (is (= [3] (selected ns "beta")))
     (is (= (get (BeamLisp.Env/ns_defs ns) "beta") (selected ns "beta")))))
   (finally (env/destroy child) (env/destroy parent)))))

(deftest exact-projection-selects-only-one-large-metadata-entry
 (let [world (env/fork (env/current))
       ns (str "selected.large.p" (erlang/unique_integer (list :positive)))
       payload (String/duplicate "x" 1024)
       table (into {} (map (fn [n] [(str n) {:body payload :identity n}]) (range 64)))]
  (try
   (env/with-env world
    (fn []
     (BeamLisp.Env/put_ns_defs ns table)
     (let [picked (selected ns "31") full (BeamLisp.Env/ns_defs ns)]
      (is (= (get full "31") picked))
      (is (< (* 32 (erlang/external_size picked)) (erlang/external_size full)))
      (println "selected-definition-prototype-metrics"
               {:entries 64 :whole-return-bytes (erlang/external_size full)
                :selected-return-bytes (erlang/external_size picked)}))))
   (finally (env/destroy world)))))

(deftest exact-projection-resolves-lazy-aot-table-descriptors
 (let [world (env/fork (env/current))
       ns (str "selected.lazy.p" (erlang/unique_integer (list :positive)))
       dir (str (System/tmp_dir!) "/selected-definition-" (erlang/unique_integer (list :positive)))]
  (try
   (env/with-env world
    (fn []
     (BeamLisp.AOT/compile_source (str "(ns " ns ") (defn chosen [x] x)")
       (list (tuple :output_dir dir)))
     (let [mod (BeamLisp.Emit/module_for ns)]
      (is (erlang/function_exported mod :__bl_ns_defs__ 0))
      (BeamLisp.Env/put_ns_defs ns (tuple :"$beam" mod))
      (is (= (get (BeamLisp.Env/ns_defs ns) "chosen") (selected ns "chosen")))
      (is (some? (selected ns "chosen")))
      (is (nil? (selected ns "__missing_selected_prototype__"))))))
   (finally (File/rm_rf! dir) (env/destroy world)))))
