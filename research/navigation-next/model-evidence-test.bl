(ns research.navigation-next.model-evidence-test
 (:require [datom] [datom.cache-validity :as validity] [system.evidence :as evidence]
           [native.eligible :as native] [z3] [veritas.model :as vm]))

;; Hand-wired publication token: explicitly NOT an actual compiler descriptor.
;; Test the admission contract before deciding where to emit that descriptor.
(defn capture [worlds token principal policy expiry]
 {:worlds (mapv (fn [[name d attrs]] [name (:store d) (validity/read-stamp d attrs)]) worlds)
  :token token :principal principal :policy policy :expiry expiry})
(defn admit [saved worlds token principal policy now]
 (let [fresh (capture worlds token principal policy (:expiry saved))]
  (and (every? (fn [[_ _ stamp]] (some? stamp)) (:worlds saved))
       (= saved fresh) (< now (:expiry saved)))))

(deftest multi-world-empty-read-and-publication-contract
 (let [schema [{:db/ident :p/read :db/valueType :db.type/long}
               {:db/ident :p/other :db/valueType :db.type/long}]
       a (datom/connect schema) b (datom/connect schema)
       worlds (fn [] [[:a (datom/db a) [:p/read]] [:b (datom/db b) [:p/read]]])]
  ;; Warm namespace publication before stamping unknown(empty) attributes.
  (capture (worlds) [:expanded-ir 1] "alice" 1 100)
  (let [saved (capture (worlds) [:expanded-ir 1] "alice" 1 100)]
   (is (admit saved (worlds) [:expanded-ir 1] "alice" 1 99))
   (is (not (admit saved (worlds) [:expanded-ir 2] "alice" 1 99)))
   (is (not (admit saved (worlds) [:expanded-ir 1] "bob" 1 99)))
   (is (not (admit saved (worlds) [:expanded-ir 1] "alice" 2 99)))
   (is (not (admit saved (worlds) [:expanded-ir 1] "alice" 1 100)))
   (is (not (admit saved [[:a (datom/db b) [:p/read]] [:b (datom/db a) [:p/read]]]
                        [:expanded-ir 1] "alice" 1 99)))
   (datom/transact! b [{:db/id -1 :p/read 42}])
   (is (not (admit saved (worlds) [:expanded-ir 1] "alice" 1 99)))
   (println "NEXT-PROTOTYPE model-contract" {:empty-other-world-insert :miss
                  :world-swap :miss :code :miss :principal :miss :policy :miss :expiry :miss}))))

(deftest actual-source-evidence-remains-a-candidate-not-native-permission
 (let [p (evidence/source "(defn kernel [x] (erlang/div x 2))")
       f (get (:functions p) "kernel")]
  (is (:admitted p))
  (is (= :value-candidate (:reuse f)))
  (is (:native-candidate f))
  ;; Symbolic argument/work obligation is independent of that verdict.
  (let [decl ['(declare-const x Int) '(declare-const n Int)]
        unsafe (z3/check nil (into decl ['(assert (> x 2147483647))]))
        safe (z3/check nil (into decl ['(assert (and (<= -2147483648 x) (<= x 2147483647)))
                                     '(assert (or (< x -2147483648) (> x 2147483647)))]))
        work (z3/check nil (into decl ['(assert (and (<= 0 n) (<= n 1024))) '(assert (> n 1024))]))]
   (is (= :sat (:status unsafe)))
   (is (= :unsat (:status safe)))
   (is (= :unsat (:status work)))
   (println "NEXT-PROTOTYPE native" {:source-candidate (:native-candidate f) :argument-bound (:status safe)
                                  :work-bound (:status work) :unbounded-counterexample (:status unsafe)}))))

(def START {:generation 1 :requested 1 :phase :model :effects 0 :lost 0})
(defn step [s op unsafe]
 (case op
  :navigate (assoc s :requested 2)
  :effect (if (= :model (:phase s)) (assoc s :phase :committed :effects 1) s)
  :cancel (if (not= (:generation s) (:requested s))
            (if (or unsafe (= :model (:phase s)))
              (assoc s :phase :cancelled :lost (:effects s)) s) s)
  :finish (if (= :committed (:phase s)) (assoc s :phase :finished) s)
  s))
(defn cancellation [unsafe]
 (vm/model "cancel only before effect commit"
  {:state START :init (fn [] (atom START))
   :commands (into {} (map (fn [op] [op {:next (fn [s _] (step s op false))
                                         :run (fn [sys _] (swap! sys step op unsafe))}])
                          [:navigate :effect :cancel :finish]))
   :invariants {:no-lost-effect (fn [_ sys] (= 0 (:lost @sys)))}}))
(deftest cancellation-counterexample
 (let [bad (vm/check (cancellation true) {:seed 17 :histories 250 :max-len 20})
       good (vm/check (cancellation false) {:seed 17 :histories 250 :max-len 20})]
  (is (= :refuted (:modality bad)))
  (is (= :witnessed (:modality good)))
  (is (= false (:ok (vm/replay (cancellation true) (:shrunk bad)))))
  (println "NEXT-PROTOTYPE cancellation" {:unsafe (:shrunk bad) :safe (:modality good)
                                         :coverage (:coverage good)})))
