(ns navigation.socket-handoff-protocol-test (:require [veritas.model :as vm]))
;; Finite protocol model assumes OTP closes ports when their owner dies and
;; monitors eventually deliver DOWN. It is not evidence of runtime scheduling.
(def INITIAL {:parent true :worker true :owner :parent :transferred false :serving false})
(defn step [s op checked?]
 (case op
  :transfer (if (and (:parent s) (:worker s))
              (assoc s :owner :worker :transferred true) s)
  :start (if (and (:worker s) (or (not checked?) (and (:parent s) (:transferred s))))
           (assoc s :serving true) s)
  :parent-dies (cond
                  (= :parent (:owner s)) (assoc s :parent false :owner nil :worker false :serving false)
                  (not (:serving s)) (assoc s :parent false :owner nil :worker false)
                  :else (assoc s :parent false))
  :worker-dies (assoc s :worker false :serving false :owner (if (= :worker (:owner s)) nil (:owner s)))
  s))
(defn protocol [checked?]
 (vm/model "serving requires successful socket ownership transfer"
  {:state INITIAL :init (fn [] (atom INITIAL))
   :commands (into {} (map (fn [op]
     [op {:next (fn [s _] (step s op checked?))
          :run (fn [system _] (swap! system step op checked?))}])
     [:transfer :start :parent-dies :worker-dies]))
   :invariants {:owns-before-serving (fn [_ system]
     (or (not (:serving @system))
         (and (:transferred @system) (= :worker (:owner @system)) (:worker @system))))}}))
(deftest checked-handoff-refutes-serve-before-transfer
 (let [bad (vm/check (protocol false) {:seed 37 :histories 500 :max-len 20})
       good (vm/check (protocol true) {:seed 37 :histories 1000 :max-len 20})]
  (is (= :refuted (:modality bad)))
  (is (= false (:ok (vm/replay (protocol false) (:shrunk bad)))))
  (is (= :witnessed (:modality good)))
  (println "socket-handoff-protocol" {:negative (:shrunk bad) :candidate (:modality good)})))

;; This retirement model assumes the binding/retirement section serializes.
;; It does not prove the current age-based cross-OS start lock under suspension.
(def RETIREMENT {:old-live true :owner :old :endpoint true :replacement false})
(defn retirement-step [s op fenced?]
 (case op
  :old-dies (assoc s :old-live false :endpoint (if (= :old (:owner s)) false (:endpoint s)))
  :replace (if (and (not (:old-live s)) (not (:replacement s)))
             (assoc s :owner :new :endpoint true :replacement true) s)
  :stop-old (assoc s :old-live false
                  :endpoint (if (and fenced? (= :new (:owner s))) (:endpoint s) false))
  s))
(defn retirement-protocol [fenced?]
 (vm/model "old listener retirement preserves a replacement binding"
  {:state RETIREMENT :init (fn [] (atom RETIREMENT))
   :commands (into {} (map (fn [op]
    [op {:next (fn [s _] (retirement-step s op fenced?))
         :run (fn [system _] (swap! system retirement-step op fenced?))}])
    [:old-dies :replace :stop-old]))
   :invariants {:replacement-survives (fn [_ system]
      (or (not (:replacement @system)) (:endpoint @system)))}}))
(deftest generation-fencing-refutes-old-handle-unlink
 (let [bad (vm/check (retirement-protocol false) {:seed 47 :histories 500 :max-len 20})
       good (vm/check (retirement-protocol true) {:seed 47 :histories 1000 :max-len 20})]
  (is (= :refuted (:modality bad)))
  (is (= false (:ok (vm/replay (retirement-protocol false) (:shrunk bad)))))
  (is (= :witnessed (:modality good)))
  (println "listener-retirement-protocol" {:negative (:shrunk bad) :candidate (:modality good)})))
