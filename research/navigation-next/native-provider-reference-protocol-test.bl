(ns navigation.native-provider-reference-protocol-test (:require [veritas.model :as vm]))
;; Scope definition tables may retain a lazy pointer to an AOT literal. Loading
;; a new provider must freeze EVERY old pointer, and new pointers must not attach
;; between detachment and loading. This is metadata lifetime, not code leasing.
(def INITIAL {:provider 0 :refs {:a :lazy :b :lazy} :expected {:a 0 :b 0}
              :held? false :detached #{} :bad? false})
(defn freeze [s scope]
 (-> s
  (assoc-in [:refs scope] (if (= :lazy (get-in s [:refs scope])) (:provider s) (get-in s [:refs scope])))
  (update :detached conj scope)))
(defn step [s op all-providers? module-lock?]
 (let [scope (case op :link-a :a :link-b :b :detach-a :a :detach-b :b :read-a :a :read-b :b nil)]
  (case op
   :prepare (if (:held? s) s (assoc s :held? true :detached #{}))
   :link-a (if (and module-lock? (:held? s)) s
             (-> s (assoc-in [:refs :a] :lazy) (assoc-in [:expected :a] (:provider s))))
   :link-b (if (and module-lock? (:held? s)) s
             (-> s (assoc-in [:refs :b] :lazy) (assoc-in [:expected :b] (:provider s))))
   :detach-a (if (:held? s) (freeze s :a) s)
   :detach-b (if (:held? s) (freeze s :b) s)
   :publish (if (and (:held? s) (contains? (:detached s) :a)
                     (or (not all-providers?) (contains? (:detached s) :b)))
              (assoc s :provider (inc (:provider s)) :held? false) s)
   :writer-dies (assoc s :held? false :detached #{})
   :read-a (let [value (get-in s [:refs scope])]
             (assoc s :bad? (or (:bad? s) (not= (get-in s [:expected scope])
                                               (if (= :lazy value) (:provider s) value)))))
   :read-b (let [value (get-in s [:refs scope])]
             (assoc s :bad? (or (:bad? s) (not= (get-in s [:expected scope])
                                               (if (= :lazy value) (:provider s) value)))))
   s)))
(defn protocol [all-providers? module-lock?]
 (vm/model "lazy table lifetime follows physical provider ownership"
  {:state INITIAL :init (fn [] (atom INITIAL))
   :commands (into {} (map (fn [op]
    [op {:next (fn [s _] (step s op true true))
         :run (fn [system _] (swap! system step op all-providers? module-lock?))}])
    [:prepare :link-a :link-b :detach-a :detach-b :publish :writer-dies :read-a :read-b]))
   :invariants {:no-silent-table-replacement (fn [_ system] (not (:bad? @system)))}}))
(deftest requested-namespace-only-and-unlocked-attachment-are-insufficient
 (doseq [[all? locked? label] [[false true :partial-provider-set] [true false :unlocked-attachment]]]
  (let [result (vm/check (protocol all? locked?) {:seed 61 :histories 1000 :max-len 40})]
   (is (= :refuted (:modality result)))
   (is (= false (:ok (vm/replay (protocol all? locked?) (:shrunk result)))))
   (println "native-provider-reference-negative" {:variant label :counterexample (:shrunk result)})))
 (is (= :witnessed (:modality (vm/check (protocol true true)
                              {:seed 61 :histories 1000 :max-len 40})))))
