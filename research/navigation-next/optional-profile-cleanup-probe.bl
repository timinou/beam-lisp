;; Run in a pristine VM with `bl run`, not Ward: other tests may initialize
;; profiling. A deferred declaration must not turn connection cleanup into
;; optional instrumentation startup. VM reductions include loader-worker work.
(ns navigation.optional-profile-cleanup (:require [datom]))
(BeamLisp.Env/note_deferred "datom.profile" (BeamLisp.Loader/search_dirs))
(let [before (BeamLisp.Env/loaded_ns? "datom.profile")
      conn (datom/connect [])
      started (erlang/monotonic_time :microsecond)
      reductions (elem (erlang/statistics :reductions) 0)]
 (datom/close! conn)
 (let [after (BeamLisp.Env/loaded_ns? "datom.profile")]
  (println "optional-profile-cleanup" {:before before :after after
    :elapsed-us (- (erlang/monotonic_time :microsecond) started)
    :vm-reductions (- (elem (erlang/statistics :reductions) 0) reductions)})
  (assert (= false before) "this probe requires an initially unloaded profiler")
  (assert (= false after) "ordinary connection cleanup must not autoload profiling")))
