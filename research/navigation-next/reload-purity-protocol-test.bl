(ns navigation.reload-purity-protocol-test (:require [veritas.model :as vm]))
;; A fresh certificate before dispatch cannot freeze mutable shim/helper calls.
;; This model concerns an accepted effect being lost under stale-work cancellation;
;; it does not claim that a dependency certificate currently enables cancellation.
(def INITIAL {:provider :pure :captured nil :admitted? false :executed? false
              :effect 0 :requested 1 :generation 1 :lost 0})
(defn step [s op pinned-graph?]
 (case op
  :certify (if (= :pure (:provider s)) (assoc s :captured :pure :admitted? true) s)
  :reload (assoc s :provider :effectful)
  :navigate (assoc s :requested 2)
  :execute (if (and (:admitted? s) (not (:executed? s)))
             (assoc s :executed? true :effect
               (if (= :effectful (if pinned-graph? (:captured s) (:provider s))) 1 0)) s)
  :cancel (if (and (:admitted? s) (not= (:requested s) (:generation s)))
             (assoc s :lost (:effect s)) s)
  s))
(defn protocol [pinned-graph?]
 (vm/model "purity evidence must bind the graph actually executed"
  {:state INITIAL :init (fn [] (atom INITIAL))
   :commands (into {} (map (fn [op]
    [op {:next (fn [s _] (step s op true))
         :run (fn [system _] (swap! system step op pinned-graph?))}])
    [:certify :reload :navigate :execute :cancel]))
   :invariants {:accepted-effects-drain (fn [_ system] (= 0 (:lost @system)))}}))
(deftest pre-dispatch-validation-alone-does-not-authorize-cancellation
 (let [bad (vm/check (protocol false) {:seed 23 :histories 1000 :max-len 30})
       pinned (vm/check (protocol true) {:seed 23 :histories 1000 :max-len 30})]
  (is (= :refuted (:modality bad)))
  (is (= false (:ok (vm/replay (protocol false) (:shrunk bad)))))
  (is (= :witnessed (:modality pinned)))
  (println "reload-purity-protocol" {:counterexample (:shrunk bad)
    :immutable-graph-candidate (:modality pinned)})))
