(ns research.navigation-next.emitted-descriptor-test
 (:require [compiler :as c] [system.ir :as ir] [system.incr :as incr]
           [typed] [codebase] [datom]))

;; Observe the literal descriptors emitted by real top-level defn compilation.
;; No module publication and no annotation trusted as execution permission.
(defn descriptors [n]
 (if-not (ir/node? n) []
  (let [own (if (and (= :lit (:op n)) (erlang/is_list (:val n)))
             (keep (fn [entry]
                     (when (erlang/is_tuple entry)
                      (let [d (last (erlang/tuple_to_list entry))]
                       (when (and (map? d) (:body d))
                         (assoc d :dispatch (subvec (into [] (erlang/tuple_to_list entry)) 0 2)))))) (:val n)) [])]
   (into [] (concat own (mapcat descriptors (ir/child-nodes n)))))))
(defn emitted [source]
 (let [nodes (mapv (fn [f] (c/compile-node f (c/new-env "research.navigation-next.emitted")))
                   (into [] (BeamLisp.Reader/read_string source)))
       clauses (into [] (mapcat descriptors nodes))]
  (when (seq clauses)
   {:dispatch (mapv :dispatch clauses)
    :identity (incr/fn-identity {:clauses (mapv (fn [d] {:params (mapv :name (:params d))
                   :body (dissoc d :dispatch :fname)}) clauses)})})))
(deftest actual-emitted-body-identity
 (let [a (emitted "(defn choose [a b] a)")
       b (emitted "(defn choose [a b] b)")
       repeat (emitted "(defn choose [a b] a)")
       multi (emitted "(defn choose ([a] a) ([a b] b))")]
  (is (some? a))
  (is (= a repeat))
  (is (not= a b))
  (is (= 2 (count (:identity multi))))
  (is (not= multi (emitted "(defn choose ([a] a) ([a b] a))")))
  (is (not= (emitted "(defn choose [a] :when (> a 0) a)")
             (emitted "(defn choose [a] :when (> a 1) a)")))
  (is (not= (emitted "(defn choose [a b] a)")
             (emitted "(defn choose [a & b] a)")))
  (is (nil? (emitted "(let [captured 1] (defn choose [x] captured))")))
  (println "NEXT-PROTOTYPE emitted-descriptor" {:clauses (count (:identity multi)) :repeat :equal
              :parameter-swap :different :later-arity :different :capturing-defn :refuse})))

(deftest source-tools-are-useful-but-not-a-publication-registry
 (let [src "(defn choose [a b] a)"
       facts (codebase/index-source {} "research.navigation-next.source" src)
       checked (typed/check-source src "research.navigation-next.source")]
  (is (= 1 (count (:fn facts))))
  (is (map? (:evidence checked)))
  (println "NEXT-PROTOTYPE source-tools" {:functions (count (:fn facts))
            :type-observations (count (:evidence checked)) :publication-identity :separate})))
