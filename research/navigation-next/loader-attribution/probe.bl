(ns navigation.loader-attribution-probe)
;; VM-wide counters are only for an isolated benchmark VM. No process tracing,
;; source bodies, call arguments or principal data are recorded. Do not use in
;; a shared production VM. This prototype does not change default runtime cost.
(def MFAS
 {:source-evaluation (tuple :Elixir.BeamLisp.Loader :do_load 3)
  :aot-attempt (tuple :Elixir.BeamLisp.AOT :ensure_loaded 1)
  :aot-initializer (tuple :Elixir.BeamLisp.AOT :init_loaded_module 2)
  :aot-repair (tuple :Elixir.BeamLisp.AOT :repair_library 1)
  :aot-source-compilation (tuple :Elixir.BeamLisp.AOT :compile_and_publish 4)
  :aot-cache-replay (tuple :Elixir.BeamLisp.AOT :load_cached_entry
                      (if (erlang/function_exported :Elixir.BeamLisp.AOT :load_cached_entry 4) 4 3))
  :descriptor-compilation (tuple :Elixir.BeamLisp.Emit :compile_descriptor 1)})
(defn uninstall! [owned]
 (doseq [mfa owned] (erlang/trace_pattern mfa false (list :local :call_count)))
 nil)
(defn install! []
 (let [owned (atom [])]
  (try
   (doseq [[label mfa] MFAS]
    (when (not (erlang/function_exported (elem mfa 0) (elem mfa 1) (elem mfa 2)))
     (throw (ex-info "attribution boundary is unavailable" {:boundary label})))
    (when (not= (tuple :call_count false) (erlang/trace_info mfa :call_count))
     (throw (ex-info "attribution boundary is already instrumented" {:boundary label})))
    (when (not= 1 (erlang/trace_pattern mfa true (list :local :call_count)))
     (throw (ex-info "attribution boundary could not be instrumented" {:boundary label})))
    (swap! owned conj mfa))
   @owned
   (catch e (uninstall! @owned) (throw e)))))
(defn snapshot []
 (into {} (map (fn [[label mfa]]
  (let [result (erlang/trace_info mfa :call_count)]
   (when (or (not (tuple? result)) (not (erlang/is_integer (elem result 1))))
    (throw (ex-info "attribution counter generation was lost" {:boundary label})))
   [label (elem result 1)])) MFAS)))

(let [owned (install!)
      previous-cache (System/get_env "BEAM_LISP_AOT_CACHE")
      dir (str (System/tmp_dir!) "/loader-attribution-" (erlang/unique_integer (list :positive)))]
 (try
  (System/put_env "BEAM_LISP_AOT_CACHE" "off")
  (let [before (snapshot)]
   (assert (= :declined (try (install!) :unexpected (catch _ :declined))))
   (assert (= before (snapshot)) "refusal must preserve instrumentation")
   (File/mkdir_p! (str dir "/navigation/attribution"))
   (File/write! (str dir "/navigation/attribution/fixture.bl")
                "(ns navigation.attribution.fixture) (defn answer [] 42)")
   (BeamLisp.Loader/with_ambient_dirs (list dir)
     (fn [] (BeamLisp.Loader/ensure_loaded "navigation.attribution.fixture")))
   (assert (= 42 (BeamLisp.Ns.Rt/invoke
                    (BeamLisp.Env/fetch! "navigation.attribution.fixture" "answer") (list))))
   (let [after (snapshot) delta (into {} (map (fn [[k v]] [k (- v (get before k))]) after))]
    (println "loader-attribution-counters" delta)
    (assert (= 1 (:source-evaluation delta)) "one source evaluation")
    (assert (> (:descriptor-compilation delta) 0))
    nil))
  (finally
    (uninstall! owned)
    (if previous-cache (System/put_env "BEAM_LISP_AOT_CACHE" previous-cache)
                      (System/delete_env "BEAM_LISP_AOT_CACHE"))
    (File/rm_rf! dir)))
 (doseq [[_ mfa] MFAS]
  (assert (= (tuple :call_count false) (erlang/trace_info mfa :call_count)))))
