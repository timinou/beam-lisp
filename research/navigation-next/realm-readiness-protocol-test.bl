(ns navigation.realm-readiness-protocol-test (:require [veritas.model :as vm]))
(def INITIAL {:manager? false :services? false :returned? false})
(defn step [s op ensure?]
 (case op
  :publish (assoc s :manager? true)
  :creator-starts (if (:manager? s) (assoc s :services? true) s)
  :open (if (:manager? s)
          (assoc s :returned? true :services? (if ensure? true (:services? s))) s)
  :close INITIAL
  s))
(defn protocol [ensure?]
 (vm/model "realm open returns with service ownership"
  {:state INITIAL :init (fn [] (atom INITIAL))
   :commands (into {} (map (fn [op]
     [op {:next (fn [s _] (step s op true))
          :run (fn [system _] (swap! system step op ensure?))}])
     [:publish :creator-starts :open :close]))
   :invariants {:ready-return (fn [_ system]
     (or (not (:returned? @system)) (and (:manager? @system) (:services? @system))))}}))
(deftest creator-only-startup-has-an-incomplete-return-history
 (let [bad (vm/check (protocol false) {:seed 23 :histories 250 :max-len 20})
       good (vm/check (protocol true) {:seed 23 :histories 250 :max-len 20})]
  (is (= :refuted (:modality bad)))
  (is (= false (:ok (vm/replay (protocol false) (:shrunk bad)))))
  (is (= :witnessed (:modality good)))
  (println "realm-readiness-protocol" {:counterexample (:shrunk bad) :fixed (:modality good)})))
