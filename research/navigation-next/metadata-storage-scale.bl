;; Standalone isolated storage-mechanics benchmark. Native baseline compiled from
;; the exact archived Env source named by NAV_METADATA_BASELINE_SOURCE. This does
;; not measure body/shim compilation or app navigation; use those gates separately.
(ns navigation.metadata-storage-scale (:require [interop]))
(def OLD :Elixir.BeamLisp.MetadataBaselineEnv)
(defn invoke-old [name args] (erlang/apply OLD name args))
(defn measure [f]
 (let [r (elem (erlang/process_info (erlang/self) :reductions) 1)
       t (erlang/monotonic_time :microsecond) value (f)]
  {:reductions (- (elem (erlang/process_info (erlang/self) :reductions) 1) r)
   :elapsed-us (- (erlang/monotonic_time :microsecond) t) :value value}))
(defn payload [nodes]
 (mapv (fn [i] {:op :tuple :args [{:op :lit :value i} {:op :lit :value "synthetic"}]
               :annotation {:line i :kind :fixture}}) (range nodes)))
(defn read-sample [kind definitions nodes round]
 (let [e (BeamLisp.Env/fork) ns "metadata.scale.read" p (payload nodes)
       defs (into {} (map (fn [n] [(str "f" n) p]) (range definitions)))]
  (try
   (BeamLisp.Env/with_env e (fn []
    (if (= :legacy kind) (invoke-old :put_ns_defs (list ns defs))
      (BeamLisp.Env/put_ns_defs ns defs))
    (let [result (measure (fn []
                   (doseq [_ (range 1000)]
                    (let [value (if (= :legacy kind)
                                  (invoke-old :ns_definition (list ns "f0"))
                                  (BeamLisp.Env/ns_definition ns "f0"))]
                     (assert (= p value) "selected read oracle")))))]
     (println "metadata-selected-read" (interop/->json
       (assoc (dissoc result :value) :kind kind :definitions definitions
              :nodes nodes :round round :reads 1000))))))
   (finally (BeamLisp.Env/destroy e)))))
(defn sample [kind definitions nodes round]
 (let [e (BeamLisp.Env/fork) ns (str "metadata.scale." (name kind)) p (payload nodes)]
  (try
   (BeamLisp.Env/with_env e (fn []
    (let [result (measure (fn []
                   (doseq [n (range definitions)]
                    (let [key (str "f" n)]
                     (if (= :legacy kind)
                      (invoke-old :put_ns_defs
                       (list ns (assoc (invoke-old :ns_defs (list ns)) key p)))
                      (BeamLisp.Env/put_ns_definition ns key p))))))
          defs (if (= :legacy kind) (invoke-old :ns_defs (list ns)) (BeamLisp.Env/ns_defs ns))
          raw (BeamLisp.Env/lookup_own (tuple :ns_defs ns))]
     (assert (= definitions (count defs)) "complete metadata oracle")
     (assert (= p (get defs (str "f" (dec definitions)))) "last definition oracle")
     (println "metadata-storage-scale" (interop/->json
       (assoc (dissoc result :value) :kind kind :definitions definitions :nodes nodes :round round
         :root-flat-bytes (* (erlang/system_info :wordsize) (erts_debug/flat_size raw))
         :materialized-flat-bytes (* (erlang/system_info :wordsize) (erts_debug/flat_size defs))))))))
   (finally (BeamLisp.Env/destroy e)))))

(let [source (System/get_env "NAV_METADATA_BASELINE_SOURCE")
      dir (str (System/tmp_dir!) "/metadata-baseline-" (erlang/unique_integer (list :positive)))]
 (assert (and source (File/regular? source)) "explicit archived baseline source required")
 (try
  (File/mkdir_p! dir)
  (let [beam (BeamLisp.AOT/compile_host_file source
                (list (tuple :module OLD) (tuple :output_dir dir) (tuple :load? false)))]
   (code/load_binary OLD (erlang/binary_to_list (elem beam 1)) (File/read! (elem beam 1))))
  (when (not= "reads" (System/get_env "NAV_METADATA_MODE"))
  (doseq [nodes [8 64] definitions [16 64 256 1024] round (range 4)]
   (doseq [kind (if (even? round) [:legacy :incremental] [:incremental :legacy])]
    (sample kind definitions nodes round))))
  (when (not= "storage" (System/get_env "NAV_METADATA_MODE"))
  (doseq [nodes [8 64] definitions [16 1024] round (range 4)]
   (doseq [kind (if (even? round) [:legacy :incremental] [:incremental :legacy])]
    (read-sample kind definitions nodes round))))
  (finally (code/soft_purge OLD) (code/delete OLD) (File/rm_rf! dir))))
