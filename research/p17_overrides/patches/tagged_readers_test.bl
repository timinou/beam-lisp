; tagged_readers_test.bl — the explicit unit tests of the edn-tagged-readers
; patch. Run BY `bl override apply` against the override it just wrote; the
; apply raises and rolls back when any of these fail.
;
; NB: tag and payload must be ADJACENT — `#t{:a 1}`, not `#t {:a 1}`. The
; reader floor (both readers, bug-for-bug parity) only joins a tag to a `{`
; that follows it immediately; a space makes the tag a bare symbol. Clojure
; allows the whitespace; this stack does not — a reader-level quirk the EDN
; layer inherits.

(ns edn-tagged-readers-test
  (:require [clojure.edn :as edn]))

(deftest readers-map-dispatches-tags
  ; a :readers hit, keyed by symbol, receives the realized payload
  (is (= {:version 1 :read true}
         (edn/read-string {:readers {'spell/meta (fn [m] (assoc m :read true))}}
                          "#spell/meta{:version 1}"))))

(deftest readers-keyed-by-string-too
  (is (= [:got {:x 1}]
         (edn/read-string {:readers {"my/tag" (fn [v] [:got v])}}
                          "#my/tag{:x 1}"))))

(deftest default-catches-otherwise-unknown-tags
  ; :default receives the tag as a STRING (reader symbols keep the slash in
  ; their name; constructed symbols ns-split — the string is the honest form)
  ; and the realized value
  (is (= [:unknown "foo/bar" {:x 1}]
         (edn/read-string {:default (fn [tag v] [:unknown tag v])}
                          "#foo/bar{:x 1}"))))

(deftest unknown-tag-without-reader-raises
  ; clojure.edn's contract: no reader, no default → an error, not silence
  (is (thrown? (edn/read-string "#unregistered/thing{:a 1}"))))

(deftest payloads-nest
  (is (= {:outer {:inner 1 :tagged true}}
         (edn/read-string {:readers {'t (fn [m] (assoc m :tagged true))}}
                          "{:outer #t{:inner 1}}"))))

(deftest old-behavior-untouched
  ; everything the shipped read-string did, it still does
  (is (= {:a 1} (edn/read-string "{:a 1}")))
  (is (= [1 2 3] (edn/read-string "[1 2 3]")))
  (is (= 42 (edn/read-string {:eof :end} "42")))
  (is (= :end (edn/read-string {:eof :end} "   ")))
  (is (= nil (edn/read-string nil)))
  (is (= (list (symbol "inc") 1) (edn/read-string "(inc 1)"))))
