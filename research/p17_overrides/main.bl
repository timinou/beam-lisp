; main.bl — the feature in action, after `bl override apply`.
; Run: bl run main.bl   (from this directory)

(ns override-demo (:require [clojure.edn :as edn]))

; `.spell`-flavored data with its own tags, read through the PATCHED
; clojure.edn — the shipped one ignores :readers entirely.
(let [text "{:name \"spell-demo\" :meta #spell/meta{:version 1 :channel :dev}}"
      value (edn/read-string
             {:readers {'spell/meta (fn [m] (assoc m :via :tag-reader))}}
             text)]
  (println "read:" (pr-str value))
  (println "tag realized:" (pr-str (get value :meta))))
