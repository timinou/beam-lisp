; super-demo.bl — the visible supervision application.
;
; The tree is a DECLARATION: `proc.super/defsupervisor` is lowered by
; compiler.bl to a spec constructor bound under `demo-tree`, and runtime.bl's
; supervisor actor starts and drives it. JavaScript transports DOM strings and
; nothing else — every line printed below is the supervisor's OWN state, read
; back through `sup-children`.
;
; The app:
;
;   * registers itself as the browser input sink;
;   * starts the tree from its declaration and prints the initial ledger;
;   * accepts `[:browser :send …]` (plain traffic, to show it keeps serving),
;     `[:browser :crash …]` (deliberately crash the child and print the ledger
;     AFTER the restart) and `[:browser :stop …]` (graceful stop — every child
;     is stopped and the tree ends normally);
;   * MONITORS the tree, so an escalation (the intensity window exhausted by
;     repeated crashes) is an observed death and is reported instead of failing
;     the run.

(defn demo-child
  "The supervised worker. `[:cast :crash]` ends it ABNORMALLY — the one death
   the demo triggers — and a call is answered so the app can prove the child is
   alive again after a restart."
  [tag]
  (receive
    [:cast :crash] (erlang/exit [:demo-crash tag])
    [:call ref from msg] (do (rt-reply-to from ref [:pong tag msg]) (demo-child tag))))

(proc.super/defsupervisor demo-tree
  (strategy :one-for-one)
  (intensity 3 10000)
  (child :worker demo-child :worker {:shutdown 100 :name :demo-worker}))

(defn demo-child-line
  "Every child of a snapshot, as one line: id, status, incarnation pid and the
   restarts it has taken. The pid CHANGES on a restart, which is what the
   browser transcript shows."
  [cs]
  (if (empty? cs)
    ""
    (let [c (first cs)]
      (host/str-cat (host/describe (:id c))
                    "=" (:status c)
                    "(pid " (host/describe (:pid c))
                    ", restarts " (:restarts c) ") "
                    (demo-child-line (rest cs))))))

(defn demo-status
  "A snapshot as one line: the tree's policy, the restarts inside the intensity
   window, the cumulative count, and every child."
  [snap]
  (host/str-cat "strategy=" (host/describe (:strategy snap))
                " window-restarts=" (:restarts snap)
                " total=" (:restart-total snap)
                " | " (demo-child-line (:children snap))))

(defn main []
  (rt-register-input!)
  (let [sup (sup-start (demo-tree))
        mref (rt-monitor sup)]
    (do
      (host/write (str "BL supervisor ready — " (demo-status (sup-children sup))))
      (loop [seen 0]
        (receive
          [:browser :send text]
            (do
              (host/write (str "BL supervisor app received #" (inc seen) ": " text
                               "; named child replied "
                               (host/describe (call :demo-worker text))))
              (recur (inc seen)))
          [:browser :crash _]
            (let [kid (sup-child sup :worker)
                  watched (rt-monitor kid)]
              (do
                (cast kid :crash)
                (host/write
                  (receive
                    [:down ref :process pid why]
                      :when (= ref watched)
                      (str "BL monitor DOWN child " (host/describe pid)
                           " reason " (host/describe why))
                    (after 2000 "BL monitor DOWN missing after child crash")))
                (host/write (str "BL supervisor ledger after crash: "
                                 (demo-status (sup-children sup))))
                (recur seen)))
          [:browser :stop reason]
            (do
              (stop sup :normal)
              (host/write (str "BL supervisor app stopped after " seen
                               " message(s): " reason)))
          [:down ref :process _pid reason]
            :when (= ref mref)
            (host/write (str "BL supervisor escalated: " (host/describe reason))))))))
