(ns js-actors.staging-fixture)

; Expansion helpers are defined at build time, never application initializers.
(defn- plus-form [x] (list '+ x x))
(defn- twice-form [x] (plus-form x))
(defmacro twice [x] (twice-form x))

; Forward references and expansion use the same staged namespace environment.
(defn main [] (host/write (message)))
(defn message [] (str "STAGED " (twice 21)))
