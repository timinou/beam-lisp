(ns ^:js js-actors-native-fixture
  (:require [js-actors-native-helper :as helper]))
(defn child []
  (receive
    [:test sender object]
      (rt-send sender [:result (helper/identity object)])))
(defn main []
  (let [object #js {:hello #js [1 2 3]}
        pid (rt-spawn child [])]
    (rt-send pid [:test (rt-self) object])
    (receive
      [:result received]
        (do
          (helper/identity received)
          (try (.push (.-hello received) 4)
               (finally (.push (.-hello received) 5)))
          (js/console.log #js {:identity (js/Object.is object received)
                               :method (.join (.-hello received) ",")
                               :undefined (js/undefined? (.-missing received))
                               :conversion (.-hello (bl->js {:hello [1 2 3]}))})
          (host/emit :native received)))))
