(ns canonical-emitter.prototype (:require [js.actor :as actor] [bl.js :as js] [bl.json :as json] [js.emit :as emit]))
(let [out "/tmp/bl-canonical-kernel"
      modules "/tmp/bl-actor-module-prototype"
      manifest (get (json/decode (File/read! (str modules "/native-modules.json"))) "modules")
      used (atom #{}) missing (atom [])
      _ (File/mkdir_p! (str out "/out"))
      source (File/read! (str (actor/runtime-directory) "/runtime.bl"))
      source (subs source (index-of source "; 2. Actor runtime"))
      source (reduce (fn [s [old new]] (String/replace s old new)) source [["rt-first" "first"] ["rt-nth" "nth"] ["rt-count" "count"]])]
 (File/write! (str out "/kernel.bl") source)
 (File/cp! (or (System/get_env "BL_ACTOR_FIXTURE") "/tmp/bl-common-kernel/fixture.bl") (str out "/fixture.bl"))
 (let [defs (vec (concat (actor/compile-source (str out "/kernel.bl") "js")
                         (actor/compile-source (or (System/get_env "BL_ACTOR_FIXTURE") (str out "/fixture.bl")) "js")))
       body (actor/emit-common-init defs {:modules manifest :leaves (js/leaf-names) :used used :missing missing})]
  (when (seq @missing) (println @missing) (throw (ex-info "canonical kernel unresolved" {:missing @missing})))
  (actor/write-runtime! out (str "file://" modules "/rt.mjs"))
  (File/write! (str out "/module.mjs")
   (String/replace (File/read! (str (actor/runtime-directory) "/module.mjs")) "'../rt.mjs'" (emit/js-str (str "file://" modules "/rt.mjs"))))
  (File/write! (str out "/out/canonical.mjs")
   (str "import * as H from '../host.mjs';import * as Control from '../module.mjs';"
        "import * as J from 'file://" modules "/interop.mjs';import * as A from 'file://" modules "/abi.mjs';import * as E_ from 'file://" modules "/env.mjs';import * as L from 'file://" modules "/leaves.mjs';"
        "import 'file://" modules "/ns/base.mjs';"
        (apply str (map (fn [ns] (str "import * as N_" (emit/mangle ns) " from 'file://" modules "/ns/" ns ".mjs';")) @used))
        "const rt=H.newRuntime();" body "\nawait H.init(rt);H.def(rt,'js/entry',H.ref(rt,'js','main'));await H.boot(rt);"))))
