(ns ^:js js-actors.initializers-fixture)

; Forward function calls are hoisted; value/effect initializers keep source order.
(def first-value (later))
(defn later [] (count [1 2 3]))
(host/write (str "FIRST " first-value))
(def second-value (+ first-value 4))
(host/write (str "SECOND " second-value))
(def native-undefined (.-missing #js {}))
(defn main []
  (host/write (str "INITIALIZED " first-value " " second-value " "
                   (if (js/undefined? native-undefined) "undefined" "wrong"))))
