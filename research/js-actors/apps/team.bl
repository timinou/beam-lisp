; apps/team.bl — a small team's task board, ONE BL file.
;
; What this app shows (PLAN-149 tracks 4 and 5):
;
;   WHO   a roster (`team`), sign-in, and a session the transport verifies and
;         STAMPS on every proposal — the browser cannot claim to be anyone.
;         Permissions are BL on the server (`:allow`): a viewer reads, a
;         member moves the cards they own or are assigned, only the lead
;         assigns and deletes. "Assigned to me", "who's here" and every
;         card's author come from that identity.
;   WHEN  `:history 50`: every commit is written to a durable log the server
;         replays at boot (restart loses nothing), an activity feed in the
;         server's own words, shared undo/redo, and "view as of" any recent
;         revision.
;
; The browser still gets only what the view reaches; `can?` runs in both
; halves so a button a person may not use is not offered — and the server
; asks the same question again before anything commits.

; ─────────────────────────────────────────────────────────────────────────────
; The team and the board
; ─────────────────────────────────────────────────────────────────────────────

(defn team
  "Who may sign in, and as what. A demo roster: no passwords (loopback only);
   the point is that the SERVER knows who proposes, not how they proved it."
  []
  [{:id "ana" :name "Ana" :role :lead}
   {:id "ben" :name "Ben" :role :member}
   {:id "chloe" :name "Chloé" :role :member}
   {:id "dev" :name "Dev" :role :viewer}])

(defn card [id title col owner assignee]
  {:id id :title title :col col :owner owner :assignee assignee})

(defn initial-board []
  {:cards [(card 1 "Draft the Q4 roadmap" :doing "ana" "ana")
           (card 2 "Fix flaky login test" :todo "ben" "ben")
           (card 3 "Pricing page copy" :todo "ana" "chloe")
           (card 4 "Upgrade the database" :todo "ben" "")
           (card 5 "Customer interview notes" :done "chloe" "chloe")
           (card 6 "Onboarding checklist" :doing "chloe" "ben")]
   :next-id 7})

(defn columns []
  [{:key :todo :label "To do"} {:key :doing :label "In progress"} {:key :done :label "Done"}])

; ─────────────────────────────────────────────────────────────────────────────
; Shared — checks, and what each role may do
; ─────────────────────────────────────────────────────────────────────────────

(defn find-card [cards id] (some (fn [c] (if (= id (:id c)) c nil)) cards))

(defn role-of [who] (if (nil? who) :none (:role who)))

(defn can?
  "May `who` do `op` to `c` (nil for board-level ops)? The rule, in one place:
   a viewer only reads; a member adds, and moves or renames what they own or
   are assigned; the lead does anything."
  [who op c]
  (let [role (role-of who)
        mine (and (some? c) (some? who) (or (= (:id who) (:owner c)) (= (:id who) (:assignee c))))]
    (cond
      (= role :lead) true
      (= role :member) (or (= op :add-card) (and (or (= op :move-card) (= op :rename-card)) mine))
      :else false)))

(defn allow-add [who _board _args] (if (can? who :add-card nil) nil :viewers-cannot-add))

(defn allow-card-op [op]
  (fn [who board args]
    (let [c (find-card (:cards board) (:id args))]
      (cond
        (nil? c) nil
        (can? who op c) nil
        (= :viewer (role-of who)) :viewers-cannot-edit
        (= :assign-card op) :only-the-lead-assigns
        (= :delete-card op) :only-the-lead-deletes
        :else :not-your-card))))

(defn allow-move [who board args] ((allow-card-op :move-card) who board args))
(defn allow-rename [who board args] ((allow-card-op :rename-card) who board args))
(defn allow-assign [who board args] ((allow-card-op :assign-card) who board args))
(defn allow-delete [who board args] ((allow-card-op :delete-card) who board args))

(defn lead-only [who _board] (if (= :lead (role-of who)) nil :only-the-lead-undoes))

(defn in-team? [id] (some? (some (fn [p] (if (= id (:id p)) p nil)) (team))))

(defn add-problem [board args]
  (cond
    (= 0 (count (:title args))) :empty-title
    (<= 30 (count (:cards board))) :board-full
    :else nil))

(defn card-problem [board args]
  (if (nil? (find-card (:cards board) (:id args))) :no-such-card nil))

(defn move-problem [board args]
  (let [c (find-card (:cards board) (:id args))]
    (cond (nil? c) :no-such-card (= (:col c) (:col args)) :already-there :else nil)))

(defn assign-problem [board args]
  (cond
    (nil? (find-card (:cards board) (:id args))) :no-such-card
    (and (not (= "" (:to args))) (not (in-team? (:to args)))) :not-on-the-team
    :else nil))

(defn rename-problem [board args]
  (cond (nil? (find-card (:cards board) (:id args))) :no-such-card
        (= 0 (count (:title args))) :empty-title
        :else nil))

; ─────────────────────────────────────────────────────────────────────────────
; Server-only — commits, in the server's words
; ─────────────────────────────────────────────────────────────────────────────

(defn with-card [board id f]
  (assoc board :cards (mapv (fn [c] (if (= id (:id c)) (f c) c)) (:cards board))))

(defn add-card [board args who]
  (let [id (:next-id board)]
    (assoc board :cards (conj (:cards board) (card id (:title args) :todo (:id who) (:id who)))
           :next-id (inc id))))

(defn move-card [board args] (with-card board (:id args) (fn [c] (assoc c :col (:col args)))))
(defn rename-card [board args] (with-card board (:id args) (fn [c] (assoc c :title (:title args)))))
(defn assign-card [board args] (with-card board (:id args) (fn [c] (assoc c :assignee (:to args)))))
(defn delete-card [board args]
  (assoc board :cards (filterv (fn [c] (not (= (:id args) (:id c)))) (:cards board))))

(defn col-label [k] (or (some (fn [c] (if (= k (:key c)) (:label c) nil)) (columns)) (name k)))
(defn person-name [id] (or (some (fn [p] (if (= id (:id p)) (:name p) nil)) (team)) "nobody"))
(defn card-title [board id] (let [c (find-card (:cards board) id)] (if (nil? c) "a card" (str "“" (:title c) "”"))))

(defn says-add [_board args] (str "added “" (:title args) "”"))
(defn says-move [board args] (str "moved " (card-title board (:id args)) " to " (col-label (:col args))))
(defn says-rename [board args] (str "renamed " (card-title board (:id args)) " to “" (:title args) "”"))
(defn says-assign [board args]
  (if (= "" (:to args))
    (str "unassigned " (card-title board (:id args)))
    (str "assigned " (card-title board (:id args)) " to " (person-name (:to args)))))
(defn says-delete [board args] (str "deleted " (card-title board (:id args))))

; ─────────────────────────────────────────────────────────────────────────────
; Client-only — this tab
; ─────────────────────────────────────────────────────────────────────────────

(defn initial-local [] {:mine false :draft "" :editing 0 :rename ""})

(defn on-event [local event]
  (let [kind (first event)]
    (cond
      (= kind :mine) {:local (assoc local :mine (not (:mine local)))}
      (= kind :draft) {:local (assoc local :draft (nth event 1))}
      (= kind :add) {:local (assoc local :draft "") :intent [:add-card {:title (:draft local)}]}
      (= kind :move) {:local local :intent [:move-card {:id (nth event 1) :col (nth event 2)}]}
      (= kind :assign) {:local local :intent [:assign-card {:id (nth event 1) :to (nth event 2)}]}
      (= kind :delete) {:local local :intent [:delete-card {:id (nth event 1)}]}
      (= kind :edit) {:local (assoc local :editing (nth event 1) :rename (nth event 2))}
      (= kind :rename-draft) {:local (assoc local :rename (nth event 1))}
      (= kind :cancel-edit) {:local (assoc local :editing 0 :rename "")}
      (= kind :rename) {:local (assoc local :editing 0 :rename "")
                        :intent [:rename-card {:id (:editing local) :title (:rename local)}]}
      (= kind :undo) {:local local :intent [:undo {}]}
      (= kind :redo) {:local local :intent [:redo {}]}
      :else {:local local})))

(defn initial [nm] (if (= "" nm) "?" (subs nm 0 1)))

(defn avatar [people id]
  (let [p (some (fn [p] (if (= id (:id p)) p nil)) people)]
    (if (nil? p)
      [:span {:class "avatar none" :title "Unassigned"} "·"]
      [:span {:class (str "avatar u-" (:id p)) :title (:name p)} (initial (:name p))])))

(defn next-col [k] (cond (= k :todo) :doing (= k :doing) :done :else nil))
(defn prev-col [k] (cond (= k :done) :doing (= k :doing) :todo :else nil))

(defn card-view [c me people local]
  (let [may-move (can? me :move-card c)
        lead (= :lead (role-of me))
        editing (= (:editing local) (:id c))]
    [:li {:key (str "c" (:id c)) :class (str "card" (if (and (some? me) (= (:id me) (:assignee c))) " mine" ""))}
     (if editing
       [:input {:type "text" :value (:rename local) :maxlength 60 :autofocus true :aria-label "Card title"
                :on-input [:rename-draft] :on-enter [:rename] :on-escape [:cancel-edit]}]
       [:p {:class "title"} (:title c)])
     [:div {:class "meta"}
      (avatar people (:assignee c))
      [:small {:class "by"} (str "by " (person-name (:owner c)))]
      [:span {:class "acts"}
       (if (and may-move (some? (prev-col (:col c))))
         [:button {:class "mv" :title (str "Move to " (col-label (prev-col (:col c))))
                   :aria-label (str "Move back " (:title c)) :on-click [:move (:id c) (prev-col (:col c))]} "←"]
         "")
       (if (and may-move (some? (next-col (:col c))))
         [:button {:class "mv" :title (str "Move to " (col-label (next-col (:col c))))
                   :aria-label (str "Move on " (:title c)) :on-click [:move (:id c) (next-col (:col c))]} "→"]
         "")
       (if (and (can? me :rename-card c) (not editing))
         [:button {:class "mv" :title "Rename" :aria-label (str "Rename " (:title c))
                   :on-click [:edit (:id c) (:title c)]} "✎"]
         "")
       (if lead
         [:span {:class "assign"}
          (mapv (fn [p] [:button {:class (if (= (:id p) (:assignee c)) "who on" "who")
                                 :title (str "Assign to " (:name p))
                                 :aria-label (str "Assign " (:title c) " to " (:name p))
                                 :on-click [:assign (:id c) (if (= (:id p) (:assignee c)) "" (:id p))]}
                         (initial (:name p))])
                (filterv (fn [p] (not (= :viewer (:role p)))) people))]
         "")
       (if lead
         [:button {:class "mv danger" :title "Delete" :aria-label (str "Delete " (:title c)) :on-click [:delete (:id c)]} "✕"]
         "")]]]))

(defn column-view [col cards me people local]
  (let [mine (filterv (fn [c] (= (:key col) (:col c))) cards)]
    [:section {:key (str "k" (name (:key col))) :class (str "col " (name (:key col)))}
     [:h3 {} (:label col) [:small {} (str (count mine))]]
     [:ul {:class "cards"} (mapv (fn [c] (card-view c me people local)) mine)]]))

(defn reason-text [reason]
  (get {:viewers-cannot-add "viewers can look, not add." :viewers-cannot-edit "viewers can look, not change."
        :only-the-lead-assigns "only the lead assigns cards." :only-the-lead-deletes "only the lead deletes cards."
        :only-the-lead-undoes "only the lead can undo for everyone." :not-your-card "that card isn't yours or assigned to you."
        :not-signed-in "sign in first." :nothing-to-undo "nothing to undo." :nothing-to-redo "nothing to redo."
        :already-there "it's already there." :no-such-card "that card is gone." :empty-title "type a title first."
        :board-full "the board is full." :not-on-the-team "that person isn't on the team."
        :viewing-history "you're looking at the past — go back to live to change things."}
       reason (name reason)))

(defn note-banner [note]
  (if (nil? note)
    ""
    [:p {:class (str "note " (name (:where note)))}
     [:strong {} (if (= :server (:where note)) "Not allowed — " "Not applied — ")]
     (if (= :link (:where note)) "you're offline; changes will wait." (reason-text (:reason note)))]))

(defn feed [recent people]
  [:ol {:class "feed"}
   (mapv (fn [e]
           [:li {:key (str "e" (:revision e))}
            (avatar people (:actor e))
            [:span {} [:strong {} (if (= "" (:name e)) "Someone" (:name e))] (str " " (:says e))]
            [:small {} (str "#" (:revision e))]])
         (reverse recent))])

(defn board-view [board local sync]
  (let [me (:me sync)
        people (:people sync)
        cards (if (and (:mine local) (some? me))
                (filterv (fn [c] (= (:id me) (:assignee c))) (:cards board))
                (:cards board))
        mine-count (if (nil? me) 0 (count (filterv (fn [c] (= (:id me) (:assignee c))) (:cards board))))
        h (:history sync)
        lead (= :lead (role-of me))]
    [:section {:class "team"}
     [:header {:class "head"}
      [:div {}
       [:h1 {} "Team board"]
       [:p {:class "sub"} (if (nil? me)
                            "You are viewing as a guest — sign in to make changes."
                            (str "Signed in as " (:name me) " · " (name (:role me))))]]
      [:div {:class "here" :aria-label "Who's here"}
       [:small {} "here now"]
       (mapv (fn [p] [:span {:key (str "h" (:id p)) :class "here-one"} (avatar people (:id p))]) (:online sync))]]
     (if (some? (:asof sync))
       [:p {:class "note past"} [:strong {} (str "Revision " (:asof sync) " — ")]
        "the board as it was then. Read-only."]
       "")
     (note-banner (:note sync))
     [:div {:class "bar"}
      (if (can? me :add-card nil)
        [:div {:class "composer"}
         [:input {:type "text" :value (:draft local) :maxlength 60 :placeholder "New card…"
                  :aria-label "New card title" :on-input [:draft] :on-enter [:add]}]
         [:button {:class "add" :on-click [:add]} "Add"]]
        [:div {:class "composer"}])
      [:nav {:class "tools"}
       (if (some? me)
         [:button {:class (if (:mine local) "chip on" "chip") :aria-pressed (:mine local) :on-click [:mine]}
          (str "Assigned to me · " mine-count)]
         "")
       [:button {:class "ghost" :disabled (or (not lead) (nil? (:undo h)))
                 :title (if (nil? (:undo h)) "Nothing to undo" (str "Undo: " (:says (:undo h))))
                 :on-click [:undo]} "↶ Undo"]
       [:button {:class "ghost" :disabled (or (not lead) (nil? (:redo h)))
                 :title (if (nil? (:redo h)) "Nothing to redo" (str "Redo: " (:says (:redo h))))
                 :on-click [:redo]} "↷ Redo"]]]
     [:div {:class "cols"} (mapv (fn [col] (column-view col cards me people local)) (columns))]
     [:aside {:class "activity"}
      [:h3 {} "Activity" [:small {} (str "revision " (:revision sync))]]
      (if (empty? (:recent sync)) [:p {:class "empty"} "No changes yet."] (feed (:recent sync) people))]]))

; ─────────────────────────────────────────────────────────────────────────────

(split/defapp team-board
  {:wire {:card [:record {:id [:int 1 9999] :title [:text 1 60] :col :col
                          :owner [:text 0 16] :assignee [:text 0 16]}]
          :col [:one-of :todo :doing :done]
          :board [:record {:cards [:list 30 :card]}]}
   :server {:init initial-board :snapshot :board :people team
            :history 50 :undo-allow lead-only}
   :client {:init initial-local :view board-view :on on-event}
   :intents {:add-card {:params {:title [:text 1 60]}
                        :check add-problem :allow allow-add :says says-add :apply add-card}
             :move-card {:params {:id [:int 1 9999] :col :col}
                         :check move-problem :allow allow-move :says says-move :apply move-card
                         :predict move-card}
             :rename-card {:params {:id [:int 1 9999] :title [:text 1 60]}
                           :check rename-problem :allow allow-rename :says says-rename :apply rename-card
                           :predict rename-card}
             :assign-card {:params {:id [:int 1 9999] :to [:text 0 16]}
                           :check assign-problem :allow allow-assign :says says-assign :apply assign-card
                           :predict assign-card}
             :delete-card {:params {:id [:int 1 9999]}
                           :check card-problem :allow allow-delete :says says-delete :apply delete-card
                           :predict delete-card}}})
