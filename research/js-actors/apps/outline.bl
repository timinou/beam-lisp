; apps/outline.bl — a nested project plan, ONE BL file.
;
; What this app shows (PLAN-149 track 2): data of ANY shape, and code that
; follows it. A plan is a tree — phases hold tasks, tasks hold steps — and
; every function that walks it is plain structural recursion:
;
;   the WIRE     `:item` names itself through `[:list 16 :item]`, so the
;                snapshot type is a tree; the codec and the BL checker bound its
;                depth (split-wire.bl `wire-max-depth`)
;   the VIEW     `item-row` renders an item and, inside it, `item-row` of each
;                child; progress, search and "how many are left" are recursive
;                roll-ups computed in the browser
;   the CHECKS   `find-item`/`depth-of` walk the tree in the browser AND on the
;                server before anything commits
;   the SERVER   adds, toggles (a whole subtree at once) and removes by
;                rebuilding the path down to one item
;
; Nothing here is declared terminating. The build PROVES each recursion ends —
; every recursive call passes a strict part of its argument (a child from
; `(:kids item)`) — and would refuse the app otherwise (compiler.bl, "closure
; flow", structural descent). The placement panel shows the proof per function.

; ─────────────────────────────────────────────────────────────────────────────
; The model the server owns
; ─────────────────────────────────────────────────────────────────────────────

(defn leaf [id text done] {:id id :text text :done done :kids []})

(defn initial-plan
  "A small product launch. `:next-id` never crosses the wire."
  []
  {:items [{:id 1 :text "Research" :done false
            :kids [(leaf 2 "Interview five customers" true)
                   (leaf 3 "Summarize the interviews" true)
                   {:id 4 :text "Competitor teardown" :done false
                    :kids [(leaf 5 "Pricing pages" true)
                           (leaf 6 "Onboarding flows" false)]}]}
           {:id 7 :text "Build" :done false
            :kids [{:id 8 :text "Sign-up flow" :done false
                    :kids [(leaf 9 "Email + password" true)
                           (leaf 10 "Magic link" false)
                           (leaf 11 "Error states" false)]}
                   (leaf 12 "Billing page" false)
                   (leaf 13 "Usage dashboard" false)]}
           {:id 14 :text "Launch" :done false
            :kids [(leaf 15 "Write the announcement" false)
                   (leaf 16 "Record a two-minute demo" false)
                   (leaf 17 "Tell the beta list" false)]}]
   :next-id 18})

; ─────────────────────────────────────────────────────────────────────────────
; Walking the tree — shared by both halves
; ─────────────────────────────────────────────────────────────────────────────

(defn find-item
  "The item with `id` anywhere under `items`, or nil."
  [items id]
  (some (fn [it] (if (= id (:id it)) it (find-item (:kids it) id))) items))

(defn depth-of
  "How deep `id` sits (1 = top level), or 0 when it is not in the plan."
  [items id]
  (or (some (fn [it]
              (if (= id (:id it))
                1
                (let [d (depth-of (:kids it) id)] (if (< 0 d) (inc d) nil))))
            items)
      0))

(defn item-count [items]
  (reduce (fn [n it] (+ n 1 (item-count (:kids it)))) 0 items))

(defn max-depth [] 5)
(defn max-items [] 120)
(defn max-kids [] 16)

(defn add-problem
  "Why adding `text` under `parent` (0 = top level) would be refused, or nil."
  [plan args]
  (let [items (:items plan)
        parent (:parent args)
        under (if (= 0 parent) items (:kids (find-item items parent)))]
    (cond
      (= 0 (count (:text args))) :empty-text
      (and (< 0 parent) (nil? (find-item items parent))) :no-such-item
      (<= (max-depth) (depth-of items parent)) :too-deep
      (<= (max-kids) (count under)) :too-many-children
      (<= (max-items) (item-count items)) :plan-full
      :else nil)))

(defn exists-problem [plan args]
  (if (nil? (find-item (:items plan) (:id args))) :no-such-item nil))

; ─────────────────────────────────────────────────────────────────────────────
; Server-only — rebuilding the tree
; ─────────────────────────────────────────────────────────────────────────────

(defn set-done
  "The item and every item under it, marked `done`."
  [it done]
  (assoc it :done done :kids (mapv (fn [k] (set-done k done)) (:kids it))))

(defn all-done? [it]
  (if (empty? (:kids it))
    (:done it)
    (every? all-done? (:kids it))))

(defn toggle-in [items id]
  (mapv (fn [it]
          (if (= id (:id it))
            (set-done it (not (all-done? it)))
            (assoc it :kids (toggle-in (:kids it) id))))
        items))

(defn add-in [items parent new]
  (mapv (fn [it]
          (if (= parent (:id it))
            (assoc it :kids (conj (:kids it) new) :done false)
            (assoc it :kids (add-in (:kids it) parent new))))
        items))

(defn remove-in [items id]
  (filterv some?
           (mapv (fn [it] (if (= id (:id it)) nil (assoc it :kids (remove-in (:kids it) id))))
                 items)))

(defn add-item [plan args]
  (let [id (:next-id plan)
        new (leaf id (:text args) false)]
    (assoc plan
           :items (if (= 0 (:parent args)) (conj (:items plan) new) (add-in (:items plan) (:parent args) new))
           :next-id (inc id))))

(defn toggle-item [plan args]
  (assoc plan :items (toggle-in (:items plan) (:id args))))

(defn remove-item [plan args]
  (assoc plan :items (remove-in (:items plan) (:id args))))

; ─────────────────────────────────────────────────────────────────────────────
; Client-only — this tab's view of the plan
; ─────────────────────────────────────────────────────────────────────────────

(defn initial-local [] {:collapsed [] :adding nil :draft "" :query ""})

(defn member? [xs x] (some? (some (fn [y] (if (= x y) y nil)) xs)))

(defn toggle-member [xs x]
  (if (member? xs x) (filterv (fn [y] (not (= x y))) xs) (conj xs x)))

(defn parent-ids
  "Every item that has children: what \"collapse all\" folds."
  [items]
  (reduce (fn [acc it] (into (if (empty? (:kids it)) acc (conj acc (:id it))) (parent-ids (:kids it))))
          [] items))

(defn on-event [local event]
  (let [kind (first event)]
    (cond
      (= kind :fold) {:local (assoc local :collapsed (toggle-member (:collapsed local) (nth event 1)))}
      (= kind :fold-all) {:local (assoc local :collapsed (nth event 1))}
      (= kind :unfold-all) {:local (assoc local :collapsed [])}
      (= kind :query) {:local (assoc local :query (nth event 1))}
      (= kind :open-add) {:local (assoc local :adding (nth event 1) :draft "")}
      (= kind :cancel-add) {:local (assoc local :adding nil :draft "")}
      (= kind :draft) {:local (assoc local :draft (nth event 1))}
      (= kind :submit) {:local (assoc local :draft "")
                        :intent [:add-item {:parent (or (:adding local) 0) :text (:draft local)}]}
      (= kind :toggle) {:local local :intent [:toggle-item {:id (nth event 1)}]}
      (= kind :remove) {:local local :intent [:remove-item {:id (nth event 1)}]}
      :else {:local local})))

; ── roll-ups: one recursive walk each ────────────────────────────────────────

(defn tally
  "[done total] over the LEAVES under `it`: a phase is as done as its steps."
  [it]
  (if (empty? (:kids it))
    [(if (:done it) 1 0) 1]
    (reduce (fn [acc k] (let [t (tally k)] [(+ (first acc) (first t)) (+ (second acc) (second t))]))
            [0 0] (:kids it))))

(defn tally-all [items]
  (reduce (fn [acc it] (let [t (tally it)] [(+ (first acc) (first t)) (+ (second acc) (second t))]))
          [0 0] items))

; ── search: ASCII case folding, then keep matches AND their ancestors ────────

(defn fold-char [c]
  (get {"A" "a" "B" "b" "C" "c" "D" "d" "E" "e" "F" "f" "G" "g" "H" "h" "I" "i" "J" "j" "K" "k" "L" "l"
        "M" "m" "N" "n" "O" "o" "P" "p" "Q" "q" "R" "r" "S" "s" "T" "t" "U" "u" "V" "v" "W" "w" "X" "x"
        "Y" "y" "Z" "z"}
       c c))

(defn fold-case [s]
  (let [n (count s)]
    (loop [i 0 acc ""]
      (if (< i n) (recur (inc i) (str acc (fold-char (subs s i (inc i))))) acc))))

(defn match-at
  "Where `q` first occurs in `text`, ignoring ASCII case, or -1."
  [text q]
  (let [t (fold-case text) f (fold-case q) n (count f) last-start (- (count t) n)]
    (loop [i 0]
      (cond
        (< last-start i) -1
        (= f (subs t i (+ i n))) i
        :else (recur (inc i))))))

(defn prune
  "The item if it or anything under it matches `q` — with only the matching
   branches kept — else nil."
  [it q]
  (let [kids (filterv some? (mapv (fn [k] (prune k q)) (:kids it)))]
    (if (or (<= 0 (match-at (:text it) q)) (seq kids))
      (assoc it :kids kids)
      nil)))

(defn visible-items [items q]
  (if (= "" q) items (filterv some? (mapv (fn [it] (prune it q)) items))))

; ── the view ─────────────────────────────────────────────────────────────────

(defn marked-text
  "The item's text with the search match wrapped in <em>."
  [text q]
  (let [i (if (= "" q) -1 (match-at text q))]
    (if (< i 0)
      [:span {:class "text"} text]
      [:span {:class "text"}
       (subs text 0 i)
       [:em {} (subs text i (+ i (count q)))]
       (subs text (+ i (count q)))])))

(defn meter
  "A ten-cell progress meter."
  [done total]
  ; cell i is lit when (i + 1/2)·total <= 10·done: done/total of ten, rounded
  (let [on (if (= 0 total) 0
             (count (filterv (fn [i] (<= (* (+ (* 2 i) 1) total) (* 20 done))) (range 10))))]
    [:span {:class "meter" :role "img" :aria-label (str done " of " total " done")}
     (mapv (fn [i] [:span {:key (str "m" i) :class (if (< i on) "cell on" "cell")} ""]) (range 10))]))

(defn add-row [local depth]
  [:li {:key "adding" :class "item adding"}
   [:div {:class "row"}
    [:span {:class "fold spacer"} ""]
    [:input {:type "text" :value (:draft local) :maxlength 60 :autofocus true
             :placeholder (if (= 1 depth) "New phase" "New step")
             :aria-label "New item" :on-input [:draft] :on-enter [:submit] :on-escape [:cancel-add]}]
    [:button {:class "ghost" :on-click [:cancel-add]} "Cancel"]]])

(defn item-row
  "One item and, nested inside it, every child — the same function, one level
   down. `depth` only styles the row. While searching, `it` is the PRUNED item
   (only matching branches), but its progress counts the whole branch as it
   is in `plan` — a filter must not change what done means."
  [it plan local q depth]
  (let [kids (:kids it)
        t (tally (if (= "" q) it (or (find-item plan (:id it)) it)))
        done (= (first t) (second t))
        folded (and (= "" q) (member? (:collapsed local) (:id it)))
        adding-here (= (:adding local) (:id it))]
    [:li {:key (str "i" (:id it)) :class (str "item d" depth (if done " done" ""))}
     [:div {:class "row"}
      (if (empty? kids)
        [:span {:class "fold spacer"} ""]
        [:button {:class (if folded "fold shut" "fold") :aria-expanded (not folded)
                  :aria-label (str (if folded "Expand " "Collapse ") (:text it))
                  :on-click [:fold (:id it)]} "▸"])
      [:button {:class "check" :aria-pressed done :aria-label (str "Toggle " (:text it))
                :on-click [:toggle (:id it)]}
       (if done "✓" "")]
      (marked-text (:text it) q)
      (if (empty? kids)
        ""
        [:span {:class "roll"} (meter (first t) (second t))
         [:small {:class "count"} (str (first t) "/" (second t))]])
      [:span {:class "acts"}
       (if (< depth (max-depth))
         [:button {:class "ghost" :title "Add a step inside" :on-click [:open-add (:id it)]} "+ step"]
         "")
       [:button {:class "ghost danger" :title "Remove with everything inside" :on-click [:remove (:id it)]} "✕"]]]
     (if (or folded (and (empty? kids) (not adding-here)))
       ""
       [:ul {:class "kids"}
        (mapv (fn [k] (item-row k plan local q (inc depth))) kids)
        (if adding-here (add-row local (inc depth)) "")])]))

(defn note-banner [note]
  (if (nil? note)
    ""
    [:p {:class (str "note " (name (:where note)))}
     [:strong {} (cond
                   (= :client (:where note)) "Checked in your browser: "
                   (= :server (:where note)) "Refused by the server: "
                   :else "Not sent: ")]
     (name (:reason note))]))

(defn plan-view [plan local sync]
  (let [items (:items plan)
        q (:query local)
        shown (visible-items items q)
        t (tally-all items)
        left (- (second t) (first t))]
    [:section {:class "outline"}
     [:header {:class "head"}
      [:div {}
       [:h1 {} "Product launch"]
       [:p {:class "sub"} (str (first t) " of " (second t) " steps done · "
                               (if (= 0 left) "all done 🎉" (str left " to go")))]]
      (meter (first t) (second t))]
     (note-banner (:note sync))
     [:div {:class "bar"}
      [:input {:type "search" :value q :maxlength 40 :placeholder "Search the plan"
               :aria-label "Search the plan" :on-input [:query]}]
      [:nav {:class "tools"}
       [:button {:class "ghost" :on-click [:unfold-all]} "Expand all"]
       [:button {:class "ghost" :on-click [:fold-all (parent-ids items)]} "Collapse all"]]]
     (if (and (not (= "" q)) (empty? shown))
       [:p {:class "empty"} (str "Nothing matches “" q "”.")]
       [:ul {:class "tree" :role "tree"}
        (mapv (fn [it] (item-row it items local q 1)) shown)
        (if (= 0 (or (:adding local) -1)) (add-row local 1) "")])
     [:footer {:class "foot"}
      [:button {:class "add" :on-click [:open-add 0]} "+ Add a phase"]
      [:small {} (str (item-count items) " items · revision " (:revision sync))]]]))

; ─────────────────────────────────────────────────────────────────────────────
; The declaration the build reads
; ─────────────────────────────────────────────────────────────────────────────

(split/defapp outline
  {:wire {:item [:record {:id [:int 1 9999] :text [:text 1 60] :done :bool :kids [:list 16 :item]}]
          :plan [:record {:items [:list 16 :item]}]}
   :server {:init initial-plan :snapshot :plan}
   :client {:init initial-local :view plan-view :on on-event}
   :intents {:add-item {:params {:parent [:int 0 9999] :text [:text 1 60]}
                        :check add-problem :apply add-item}
             :toggle-item {:params {:id [:int 1 9999]}
                           :check exists-problem :apply toggle-item}
             :remove-item {:params {:id [:int 1 9999]}
                           :check exists-problem :apply remove-item}}})
