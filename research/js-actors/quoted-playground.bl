; Interactive, JS-only view evaluator. The Worker parses a closed data form and
; delivers its BL value as :preview; this actor owns evaluation and refusals.
; No server version or intent is read or changed here.

(defn qp-result-line [result]
  (if (host/eq :ok (host/vec-el result 0))
    (host/str-cat "QV-FRONT VIEW " (host/describe result))
    (host/str-cat "QV-PLAY REFUSED " (host/describe result))))

(defn main []
  (do
    (rt-register-input!)
    (host/write "QV-PLAY READY")
    (loop [active nil version 7]
      (receive
        [:browser :preview form]
          (let [result (qv-render {:unread (host/to-str version)} form)]
            (do
              (host/write (qp-result-line result))
              (recur (if (host/eq :ok (host/vec-el result 0)) form active) version)))
        [:browser :version wire]
          (if (or (host/is-nil active)
                  (host/eq version 9007199254740991)
                  (not (host/is-str wire))
                  (not (host/eq wire (host/to-str (inc version)))))
            (do
              (host/write "QV-PLAY REFUSED invalid-server-version")
              (recur active version))
            (let [next (inc version)]
              (do
                (host/write (qp-result-line (qv-render {:unread (host/to-str next)} active)))
                (recur active next))))
        [:browser :stop _payload]
          (host/write "QV-PLAY STOP")
        [:browser topic _payload]
          (do
            (host/write (host/str-cat "QV-PLAY REFUSED unknown-topic " (host/describe topic)))
            (recur active version))))))
