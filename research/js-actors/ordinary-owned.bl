; Imported ordinary namespaces receive on the caller's existing actor runtime.
(ns ^:js ordinary-owned (:require [actor-module.fixture :as ordinary]))
(defn main []
 (let [parent (rt-self)
       child (rt-spawn-owned (fn [] (rt-send parent [:reply (ordinary/owned-receive)])) [])]
  (rt-send child [:value 42])
  (receive [:reply value]
   (if (= value 42) (js/console.log "ordinary-owned: PASS") (throw "Wrong imported receive value"))
   (after 2000 (throw "Imported receive timed out")))))
