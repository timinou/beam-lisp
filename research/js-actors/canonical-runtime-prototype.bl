; Research only: exercise canonical collections in the existing actor machine.
; No alternate scheduler or collection implementation is introduced.
(ns canonical.runtime-prototype
 (:require [js.actor :as actor] [bl.json :as json]))
(let [modules (System/get_env "BL_CANONICAL_MODULES")
      output (System/get_env "BL_CANONICAL_PROTOTYPE")
      _ (when-not (and modules output) (throw (ex-info "Set BL_CANONICAL_MODULES and BL_CANONICAL_PROTOTYPE" {})))
      manifest (json/decode (File/read! (str modules "/native-modules.json")))
      exports (get-in manifest ["modules" "rt" "exports"])
      selected [["rt-first" "first" ["x"]] ["rt-rest" "rest" ["x"]]
                ["rt-count" "count" ["x"]]]
      links (into {} (map (fn [[_ name args]]
        (let [shape (get exports name)]
         (when-not (and shape (some (fn [n] (= n (count args))) (get shape "arities")))
          (throw (ex-info "Canonical runtime contract missing" {:name name})))
         [(str "canonical/" name) {:abi :bl :arities (set (get shape "arities"))
          :export (get shape "export") :path "../canonical-ready.mjs"}])) selected))
      prior (erlang/get :js-actors-native-links)]
 (File/mkdir_p! output)
 (File/write! (str output "/canonical-ready.mjs")
  (str "import " (json/encode (str "file://" modules "/core.mjs")) ";\nexport * from "
       (json/encode (str "file://" modules "/ns/rt.mjs")) ";\n"))
 (erlang/put :js-actors-native-links links)
 (try
  (File/write! (str output "/canonical.bl")
   (str "(ns ^:js canonical.wrappers)\n"
    (apply str (map (fn [[target name args]]
      (str "(defn " target " [" (join " " args) "] (canonical/" name " " (join " " args) "))\n")) selected))))
  (File/write! (str output "/fixture.bl")
   "(ns ^:js canonical.fixture)\n(defn check [v msg] (when-not v (throw (js/Error. msg))))\n(defn child [parent] (rt-send parent [:values (first \"beam\") (count \"beam\") (first [7 8]) (first (rest [7 8]))]))\n(defn main [] (let [me (rt-self) p (rt-spawn-owned child [me])] (receive [:values a b c d] (do (check (= a \"b\") \"canonical string first\") (check (= b 4) \"canonical string count\") (check (= c 7) \"canonical vector first\") (check (= d 8) \"canonical vector rest\")) (after 1000 (throw (js/Error. \"actor reply timed out\"))))) (.log js/console \"canonical collection actor prototype PASS\"))\n")
  (let [replaced (set (map first selected))
        kernel (actor/compile-source (str (actor/runtime-directory) "/runtime.bl") "js")
        wrappers (actor/compile-source (str output "/canonical.bl") "js")
        app (actor/compile-source (str output "/fixture.bl") "js")
        defs (actor/prune-defs (vec (concat (remove (fn [d] (contains? replaced (:name d))) kernel) wrappers app))
                              ["main" "bl-main" "rt-observation"])]
   (actor/write-runtime! output (str "file://" modules "/rt.mjs"))
   (actor/write-bundle! output "canonical.mjs" ["canonical runtime link prototype"] defs)
   (File/write! (str output "/contracts.json") (json/encode {:selected selected :links links})))
  (finally (erlang/put :js-actors-native-links prior))))
