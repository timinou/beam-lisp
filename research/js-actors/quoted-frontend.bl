; quoted-frontend.bl — the BROWSER half of the quoted-view prototype: a BL actor
; that renders ONE accessible data-form view and re-renders it whenever the
; server reports a new version.
;
; THE EVALUATOR AND THE WIRE RULE ARE NOT HERE. The closed op grammar, the
; bounds, `qv-render` and the version-wire bounds all live in
; `quoted-view-core.bl`. THIS file is only the frontend application: it owns the
; ONE fixed view, the ONE number that view displays, and the ONE browser event it
; answers. It re-implements no check, so the frontend and the pure core can never
; disagree about what a view or a wire is.
;
; THE BUNDLE IS BUILT FROM THREE SOURCES —
;     runtime.bl + quoted-view-core.bl + quoted-frontend.bl
; — the same `runtime + core + app` shape the demo and backend bundles use, so
; the evaluator has ONE definition shared by every bundle. `compiler.bl`'s
; `build-one` takes the optional extra source list.
;
; WHAT THE VIEW IS. `qf-form` is the ONE view, written as self-evaluating DATA —
; an ordinary vector whose head is a keyword — exactly as `quoted-view.bl`
; demonstrates: a card with a level-2 Inbox heading, the RESTRICTED `:unread`
; field, one increment button, and one static line. There is no quoted literal,
; no symbol resolution, no eval and no DOM here; the view is the core's closed
; grammar and nothing else. The env handed to `qv-render` is built by `qf-env`
; from the integer version this actor holds, so `:unread` is ALWAYS the canonical
; decimal string of that version — never a value read from a host.
;
; THE EVENT. The shared host delivers a browser event as `[:browser <topic>
; <payload>]` where `topic` is a keyword and `payload` is a string. This actor
; answers exactly three topics and refuses every other one WITHOUT rendering:
;
;   * `:version` — the server reports the version the frontend should show.
;     `qf-version` validates the wire and, on success, the actor re-renders and
;     writes ONE `QV-FRONT VIEW …` line; on refusal it writes ONE
;     `QV-FRONT REFUSED …` line and renders nothing.
;   * `:stop`    — the verifier's clean-termination signal. The actor writes
;     `QV-FRONT STOP` and ENDS, so the scheduler has no live process left and the
;     driving Node process exits normally.
;   * anything else — a typed `[:unknown-topic …]` refusal, again with no render.
;
; WHY THE VERSION WIRE IS JUDGED BY EQUALITY, NOT BY PARSING. This target has no
; digit access — no substring, no character index — so a wire cannot be scanned
; for digits and cannot be converted to a number here. The checked ABI's whole
; string surface is `host/str-cat`, `host/str-size`, `host/describe` and
; `host/to-str`; the core's own wire adapter (`qv-intent-apply-wire`) resolves a
; wire the same way. `qf-version` therefore:
;
;   1. requires a string (else `[:malformed-version]`);
;   2. bounds its length by the core's `qv-max-version-wire` (else
;      `[:oversized-request n]`), so the dynamic field is bounded before it can
;      reach the view;
;   3. accepts it only when it equals the ONE canonical decimal this actor can
;      build — `(host/to-str (inc version))`, the successor the server just
;      reported. A mismatch is `[:stale-version wire expected]`.
;
; The value is therefore never re-parsed and never rounded, and the field bound
; (`qv-max-attr-text`, enforced by the core) holds because an accepted wire is at
; most `qv-max-version-wire` characters. The cost is stated, not hidden: a
; canonical decimal that is NOT this actor's successor (say `"9"` when it holds
; 8) is refused as stale, because distingushing it from `"0x9"` would need the
; digit access this target does not have.
;
; ONE LINE PER EVENT, safely parseable. Every line is `host/write`n through
; `host/describe`, which QUOTES and ESCAPES a string, so no payload — a newline,
; a `"`, or the literal text `QV-FRONT VIEW` — can break the frame or fabricate a
; second line. Refusals use the DISTINCT `QV-FRONT REFUSED` prefix, so a bad
; input can never masquerade as a rendered frame.

; ─────────────────────────────────────────────────────────────────────────────
; The ONE view, its env, and its frame
; ─────────────────────────────────────────────────────────────────────────────

(defn qf-initial-version
  "The version this frontend holds before any event: the server's version 7, as
   the canonical decimal string `\"7\"` in the view's env. Named once so the
   initial render and the loop start from the same value."
  [] 7)

(defn qf-form
  "The ONE view this frontend renders, as self-evaluating DATA: a card with a
   level-2 Inbox heading, the restricted `:unread` field, one increment button,
   and one static line. Nothing here is a quoted literal and nothing resolves a
   symbol; `qv-render` gives this vector its meaning."
  []
  [:card {:id "inbox"}
   [:heading {:level 2 :text "Inbox"}]
   [:field :unread]
   [:button {:label "Mark all read" :intent [:intent :increment]}]
   [:text "no unread mail"]])

(defn qf-env
  "The view's immutable env for `version`: `:unread` is the canonical version
   string built with `host/to-str`. No other field is exposed to the view, so
   the only dynamic value it can render is this bounded decimal."
  [version]
  {:unread (host/to-str version)})

(defn qf-frame
  "The rendered view for `version`, written exactly as the core answered it: the
   `host/describe` of `qv-render`'s value. The fixed form and the bounded env
   make `[:ok …]` the only possible answer, so this is always an ACCEPTED frame."
  [version]
  (host/describe (qv-render (qf-env version) (qf-form))))

; ─────────────────────────────────────────────────────────────────────────────
; The version wire
; ─────────────────────────────────────────────────────────────────────────────

(defn qf-version
  "Validate the server's version wire against `version` (the version this actor
   holds) and answer `[:ok <next-version>]` or `[:refused <reason>]`. The checks,
   in order — shape, bound, then exact canonical equality — are the whole rule;
   see the file header for why a canonical-but-not-successor wire is refused."
  [version wire]
  (cond
    (not (host/is-str wire)) [:refused [:malformed-version]]
    (host/lt (qv-max-version-wire) (host/str-size wire))
      [:refused [:oversized-request (host/str-size wire)]]
    (host/eq wire (host/to-str (host/arith "add" version 1)))
      [:ok (host/arith "add" version 1)]
    :else [:refused [:stale-version wire (host/to-str (host/arith "add" version 1))]]))

; ─────────────────────────────────────────────────────────────────────────────
; One line per event
; ─────────────────────────────────────────────────────────────────────────────

(defn qf-view-line
  "`QV-FRONT VIEW <describe qv-render result>`. The prefix and the single space
   are literals; the result is the core's own `[:ok …]` value, so the line is
   exactly what the evaluator answered."
  [version]
  (host/str-cat "QV-FRONT VIEW " (qf-frame version)))

(defn qf-refused-line
  "`QV-FRONT REFUSED <describe refusal>`. The prefix is DISTINCT from the view
   prefix on purpose: a refused wire can only ever produce a REFUSED line, never
   a `QV-FRONT VIEW` line, and the quoted refusal cannot contain a bare newline."
  [result]
  (host/str-cat "QV-FRONT REFUSED " (host/describe result)))

; ─────────────────────────────────────────────────────────────────────────────
; The actor
; ─────────────────────────────────────────────────────────────────────────────

(defn main
  "Register as the host's input sink, render the initial view ONCE, then answer
   one browser event at a time. An accepted `:version` re-renders and advances
   the version; a refused wire or an unknown topic renders NOTHING and leaves the
   version untouched, so the next event is judged against the same version. A
   `:stop` ends the process cleanly, which is what lets the Node verifier finish."
  []
  (do
    (rt-register-input!)
    (host/write (qf-view-line (qf-initial-version)))
    (loop [version (qf-initial-version)]
      (receive
        [:browser :version payload]
          (let [result (qf-version version payload)]
            (if (host/eq :ok (host/vec-el result 0))
              (let [next (host/vec-el result 1)]
                (do
                  (host/write (qf-view-line next))
                  (recur next)))
              (do
                (host/write (qf-refused-line result))
                (recur version))))
        [:browser :stop _payload]
          (host/write "QV-FRONT STOP")
        [:browser topic _payload]
          (do
            (host/write (qf-refused-line [:refused [:unknown-topic topic]]))
            (recur version))))))
