(def core-map
  "Core names the compiler leaves as a namespace-global fetch. The emitter
   falls back from the source namespace to `core`, mirroring Env.fetch!/2."
  {"str" "core-str" "not" "core-not" "list" "core-list" "vector" "core-vector"
   "print" "core-print" "println" "core-println" "hash-map" "core-hash-map"
   "nil?" "core-nil?" "some?" "core-some?" "not=" "core-not=" "inc" "core-inc"
   "dec" "core-dec" "keyword" "core-keyword" "name" "core-name"
   "ex-info" "core-ex-info" "ex-data" "core-ex-data"
   "ex-message" "core-ex-message" "ex-original" "core-ex-original"
   "boolean?" "rt-boolean?" "assoc" "core-assoc"
   ; value functions reached by name: `(mapv identity xs)`, `(filterv odd? xs)`
   "identity" "core-identity" "odd?" "rt-odd?" "even?" "rt-even?"
   "pos?" "rt-pos?" "neg?" "rt-neg?" "zero?" "rt-zero?" "empty?" "rt-empty?" "count" "rt-count"
   "+" "core-add" "*" "core-mul" "-" "core-sub" "max" "core-max" "min" "core-min"
   "first" "rt-first" "keyword?" "rt-keyword?" "string?" "rt-string?" "int?" "rt-int?"
   ; the ordering names as VALUES — `(sort > xs)`, `(sort-by :id compare xs)`
   "compare" "rt-compare" "<" "core-lt" ">" "core-gt" "<=" "core-le"
   ">=" "core-ge" "=" "core-eq"
   ; The generic PROCESS verbs (runtime.bl section 4): `send`, `call`, `cast`,
   ; `stop` and the name verbs all take a pid OR a name through one resolver, so
   ; a bundle spells `(call server msg)` on this target exactly as it does on
   ; BEAM — no second, JS-only process vocabulary to learn.
   "send" "core-send" "call" "core-call" "cast" "core-cast" "stop" "core-stop"
   "whereis" "core-whereis" "register" "core-register"
   "unregister" "core-unregister"
   ; The SUPERVISOR verbs (runtime.bl section 6): a bundle starts a tree from
   ; its `proc.super/defsupervisor` declaration and drives it with the same
   ; unqualified names the process verbs use. A supervisor is an ordinary
   ; process, so nothing here is a second vocabulary.
   "sup-start" "core-sup-start" "sup-start-link" "core-sup-start-link"
   "sup-children" "core-sup-children" "sup-child" "core-sup-child"
   "sup-restart" "core-sup-restart" "sup-terminate" "core-sup-terminate"})

(defn remote-key [m f] (str (str m) "/" (str f)))

(defn callee-js [m f]
  (cond
    (= m mod-host) (str "H.hostRef(rt," (js-str (str f)) ")")
    (= m mod-erlang) (str "H.erlangRef(" (js-str (str f)) ")")
    :else (str "H.ref(rt," (js-str (str m)) "," (js-str (str f)) ")")))

(defn lit-key-js [keynode where]
  (if (and (erlang/is_map keynode) (= :lit (:op keynode)))
    (let [v (:val keynode)]
      (if (erlang/is_atom v)
        (str v)
        (throw (ex-info (str "js-actors: " where " keys must be keywords") {:key v}))))
    (throw (ex-info (str "js-actors: " where " keys must be literal nodes") {:key keynode}))))

; ─────────────────────────────────────────────────────────────────────────────
; Trusted numeric range provenance for `:arith`
;
; WHAT THE EVIDENCE IS, AND WHERE IT CAN COME FROM
;
;   `:ann` on a bl-ANF node is COMPILER-OWNED. `priv/boot/compiler.bl::with-ann`
;   copies the reader's source span (`:line :file :col :end-line :end-col`) onto
;   it, and the only proof-carrying key any pass writes is `:decreasing` (a
;   trusted loop measure). No pass writes numeric type/range facts, and
;   `author-meta` strips position keys out of USER metadata — so a source-level
;   annotation cannot even reach `:ann` as a value fact. `:ann` is provenance for
;   POSITIONS, not for numeric ranges.
;
;   The only numeric evidence this emitter can TRUST is evidence it DISCHARGES
;   itself, from the node's own structure:
;
;     * literal-only arithmetic — every leaf is an integer `:lit` inside
;       ±(2^53-1), every operator is closed over the integers, and EVERY
;       intermediate and final result is inside ±(2^53-1); and
;     * a `:let` whose initializer is itself such an expression, whose proven
;       range then bounds the bound name in that let's body.
;
;   A `:ann` numeric fact (`{:num {:cat :int :range [lo hi] :witness {…}}}`) is
;   honoured ONLY when this re-derivation discharges it — same category, same
;   range, same literal witness. A declaration that disagrees, or that sits on a
;   node with no literal proof, REFUSES the fast path and keeps the checked
;   `H.arith`. A declared-but-unverified bound never authorizes a raw Number.
;
; WHAT THE GATE DELIBERATELY DOES NOT DO
;
;   * it never inspects source text; every fact is read off ANF values, so it
;     cannot be fooled by how the source was spelled;
;   * it never crosses `:div` or a comparison — `/` leaves the integer domain
;     (`7/2` is not an integer, so it cannot carry an integer range) and
;     `H.lt`/`H.eq` order arbitrary BL values, not raw JS numbers;
;   * it never widens a float: `1.0` is a float even though
;     `Number.isInteger(1.0)` is true, so any float leaf fails the fold closed.
;     The emitter reads that int/float distinction directly off the ANF literal —
;     the same distinction `typed/lit-type` draws, with no source-text step;
;   * it never assumes a bound for a parameter, a pattern variable, a foreign
;     message or a dynamic call: those have no literal proof, so they stay
;     checked. Reason: the value boundary — not the expression — must establish
;     the fact before the guard can be dropped, and this emitter does not yet
;     insert input guards. A clause's own binders are also CLEARED from the
;     range environment, so a name a clause binds can never inherit an enclosing
;     let-derived range.
; ─────────────────────────────────────────────────────────────────────────────

(def num-safe-max 9007199254740991)      ; 2^53 - 1
(def num-safe-min -9007199254740991)

(def num-fast-ops
  "The `:arith` names that are closed over the integers AND identical to their
   raw JS operator on safe-integer operands: `:add`→`+`, `:sub`→`-`,
   `:mul`→`*`, `:rem`→`%` (BL `rem` and JS `%` both truncate toward zero).
   `:div` and the comparisons are absent by design — see the section comment."
  {:add "+" :sub "-" :mul "*" :rem "%"})

(defn num-safe-int? [v]
  (and (erlang/is_integer v) (>= v num-safe-min) (<= v num-safe-max)))

(defn num-range-ok? [r]
  (and (or (erlang/is_list r) (BeamLisp.Ns.Rt/vector? r))
       (= 2 (count r))
       (num-safe-int? (first r))
       (num-safe-int? (second r))
       (<= (first r) (second r))))

(defn num-min-int [xs]
  (reduce (fn [a b] (if (< b a) b a)) (first xs) (rest xs)))

(defn num-max-int [xs]
  (reduce (fn [a b] (if (> b a) b a)) (first xs) (rest xs)))

(defn num-fold
  "Fold an ANF expression to an exact integer interval, or nil when the emitter
   cannot discharge it. → {:cat :int :range [lo hi] :leaves [v…] :ops [k…]}.
   This is the ONLY trusted source of a numeric range: the facts come from the
   node's own literals and operators, never from metadata."
  [node ranges]
  (let [op (:op node)]
    (cond
      (= op :lit)
        (let [v (:val node)]
          (if (num-safe-int? v)
            {:cat :int :range [v v] :leaves [v] :ops []}
            nil))

      (= op :var)
        ; A bound name carries the WHOLE fold of its initializer — range and the
        ; literal provenance that justified it — so a witness stays ground truth
        ; all the way down to the literals, with no opaque interval in between.
        (let [rec (get ranges (:name node))]
          (if (and (erlang/is_map rec) (num-range-ok? (:range rec)))
            rec
            nil))

      (= op :arith)
        (if (contains? num-fast-ops (:fun node))
          (let [a (num-fold (nth (:args node) 0) ranges)
                b (num-fold (nth (:args node) 1) ranges)]
            (if (or (nil? a) (nil? b))
              nil
              (let [ra (:range a) rb (:range b) f (:fun node)
                    r (cond
                        (= f :add)
                          [(erlang/+ (first ra) (first rb)) (erlang/+ (second ra) (second rb))]
                        (= f :sub)
                          [(erlang/- (first ra) (second rb)) (erlang/- (second ra) (first rb))]
                        (= f :mul)
                          (let [ps [(erlang/* (first ra) (first rb))
                                    (erlang/* (first ra) (second rb))
                                    (erlang/* (second ra) (first rb))
                                    (erlang/* (second ra) (second rb))]]
                            [(num-min-int ps) (num-max-int ps)])
                        ; |rem(a,b)| < |b|, and b must be provably nonzero — a
                        ; divisor range that contains 0 is refused, not bounded.
                        (= f :rem)
                          (let [alo (erlang/abs (first rb)) ahi (erlang/abs (second rb))]
                            (if (and (<= (first rb) 0) (<= 0 (second rb)))
                              nil
                              [(erlang/- 1 (if (< alo ahi) ahi alo))
                               (erlang/- (if (< alo ahi) ahi alo) 1)]))
                        :else nil)]
                (if (num-range-ok? r)
                  {:cat :int :range r
                   :leaves (to-list (concat (:leaves a) (:leaves b)))
                   :ops (to-list (concat (:ops a) (:ops b) [f]))}
                  nil))))
          nil)

      :else nil)))

(defn num-range-eq? [a b]
  (and (num-range-ok? a) (num-range-ok? b)
       (= (first a) (first b)) (= (second a) (second b))))

(defn num-fact-discharged?
  "Whether a DECLARED `:ann` numeric fact is discharged by the emitter's own
   re-derivation. Trust is the equality, never the declaration: a fact the
   emitter cannot re-derive is not a fact."
  [declared derived]
  (and (erlang/is_map declared)
       (= :int (:cat declared))
       (num-range-eq? (:range declared) (:range derived))
       (let [w (:witness declared)]
         (and (erlang/is_map w)
              (= :literals (:kind w))
              (= (to-list (or (:leaves w) [])) (to-list (:leaves derived)))
              (= (to-list (or (:ops w) [])) (to-list (:ops derived)))))))

(defn num-evidence
  "The GATE for one `:arith` node: `:raw` — permission to emit a raw JS Number
   operator, with the witness — or `:checked`, keep `H.arith`, with the reason.
   `:raw` needs a discharged derivation AND, when the node carries an `:ann`
   numeric fact, that the declared fact be discharged too. An undischargeable or
   conflicting declaration fails closed."
  [node ranges]
  (let [derived (num-fold node ranges)
        declared (get (:ann node) :num)]
    (cond
      (nil? derived)
        {:decision :checked
         :reason (if (some? declared) :annotation-not-discharged :no-literal-proof)}
      (and (some? declared) (not (num-fact-discharged? declared derived)))
        {:decision :checked :reason :annotation-not-discharged}
      :else
        {:decision :raw :cat (:cat derived) :range (:range derived)
         :leaves (:leaves derived) :ops (:ops derived)})))

(defn pat-binder-names
  "Every name a pattern binds. Used to clear a clause's own binders out of the
   range environment, so a body or guard can never inherit a let-derived range
   through a shadowed name."
  [p]
  (let [op (:pop p)]
    (cond
      (= op :pvar) (if (= "_" (:name p)) [] [(:name p)])
      (= op :ptuple) (mapcat pat-binder-names (:elems p))
      (= op :pcons) (concat (pat-binder-names (:head p)) (pat-binder-names (:tail p)))
      (= op :palias) (concat (pat-binder-names (:a p)) (pat-binder-names (:b p)))
      (= op :pmap) (mapcat (fn [pair] (pat-binder-names (second pair))) (:pairs p))
      (= op :pstruct) (mapcat (fn [pair] (pat-binder-names (second pair))) (:fields p))
      :else [])))

(defn without-binders
  "`ctx` with `names` removed from the range environment. A binder shadows: a
   clause body or guard must see no range for a name the clause itself binds."
  [ctx names]
  (let [rs (:ranges ctx)]
    (if (or (nil? rs) (empty? names))
      ctx
      (assoc ctx :ranges (reduce (fn [m n] (if (contains? m n) (dissoc m n) m)) rs names)))))

; ── the decision ledger — the build report's raw material ────────────────────

(defn num-sites-reset! [] (erlang/put :js-actors-num-sites ()))

(defn num-record! [node ev]
  (let [prev (erlang/get :js-actors-num-sites)
        cur (if (= prev :undefined) () prev)]
    (erlang/put :js-actors-num-sites
                (concat cur
                        (list {:fun (str (:fun node))
                               :decision (:decision ev)
                               :reason (:reason ev)
                               :cat (:cat ev)
                               :range (:range ev)
                               :leaves (:leaves ev)
                               :ops (:ops ev)})))))

(defn num-sites []
  (let [v (erlang/get :js-actors-num-sites)]
    (if (= v :undefined) () v)))

(defn num-json-str [s] (str "\"" (js-escape s) "\""))

(defn num-report-json
  "The machine-readable side of the build report: one record per `:arith` site,
   so a verifier can compare the EMITTER's decision with the emitted artifact."
  [output sites]
  (let [raw (count (filter (fn [s] (= :raw (:decision s))) sites))
        checked (erlang/- (count sites) raw)
        site-json (join-str
                    (map (fn [s]
                           (let [range (:range s)
                                 rng (if (some? range)
                                       (str "[" (first range) "," (second range) "]")
                                       "null")
                                 ops (:ops s)
                                 leaves (:leaves s)]
                             (str "{\"decision\":" (num-json-str (str (:decision s)))
                                  ",\"fun\":" (num-json-str (:fun s))
                                  ",\"cat\":" (if (some? (:cat s)) (num-json-str (str (:cat s))) "null")
                                  ",\"range\":" rng
                                  ",\"ops\":" (if (some? ops)
                                                 (str "[" (join-str (map (fn [o] (num-json-str (str o))) ops) ",") "]")
                                                 "null")
                                  ",\"leaves\":" (if (some? leaves)
                                                    (str "[" (join-str (map str leaves) ",") "]")
                                                    "null")
                                  ",\"reason\":" (if (some? (:reason s)) (num-json-str (str (:reason s))) "null")
                                  "}")))
                         sites)
                    ",")]
    (str "{\"bundle\":" (num-json-str output)
         ",\"counts\":{\"raw\":" raw ",\"checked\":" checked "}"
         ",\"sites\":[" site-json "]}")))

; ─────────────────────────────────────────────────────────────────────────────
; The emitter
;
; `emit` answers {:lines (JS statements, in order) :val "a JS expression"}.
; Every operand is lowered into a `const` first, so nothing is evaluated twice
; and every suspension point becomes a statement — which is also what makes
; `yield` legal there.
; ─────────────────────────────────────────────────────────────────────────────

(declare emit)
(declare emit-args)
(declare emit-pattern-lines)

(defn emit-guard [node ctx]
  (if (nil? node)
    {:lines (list) :val "true"}
    (let [g (emit node (assoc (assoc ctx :tail false) :guard true))
          result (fresh-tmp)]
      {:lines (concat (list (str "let " result " = false; try {"))
                      (:lines g)
                      (list (str result " = (" (:val g) " === true);"))
                      (list "} catch (_) { /* Guard errors mean no match. */ }"))
       :val result})))

(defn src-val [v]
  (cond
    (nil? v) "null"
    (erlang/is_integer v) (str v)
    (erlang/is_binary v) (js-str v)
    :else (js-str (str v))))

(defn call-kind [ctx base]
  "The call KIND a frame records: `:tail` when the step replaces its frame,
   otherwise the base kind. A tail call is a tail call whatever it calls."
  (if (:tail ctx) "tail" base))

(defn src-js
  "A call step's CALL-SITE metadata, as a JavaScript object literal: the
   enclosing function and its arity (the frame the call belongs to), the call
   kind, and the reader's source span for the call node. An UNKNOWN position is
   an explicit null — a frame with no source stays visible rather than
   vanishing."
  [node ctx kind]
  (let [a (if (erlang/is_map (:ann node)) (:ann node) {})]
    (str "{file:" (src-val (:file a))
         ",line:" (src-val (:line a))
         ",col:" (src-val (:col a))
         ",endLine:" (src-val (:end-line a))
         ",endCol:" (src-val (:end-col a))
         ",fn:" (src-val (:cur-fn ctx))
         ",arity:" (src-val (:arity ctx))
         ",call:" (js-str kind)
         ",internal:" (if (= "research/js-actors/runtime.bl" (:file a)) "true" "false")
         "}")))

(defn step-call [ctx callee args-js src]
  (if (:guard ctx)
    (let [t (fresh-tmp)]
      {:lines (list (str "const " t " = " callee "(..." args-js ");")) :val t})
    (if (:tail ctx)
    {:lines (list (str "yield {__step:true, k:'tail', f: " callee ", args: " args-js ", src: " src "};") "return;")
     :val nil}
    (let [t (fresh-tmp)]
      {:lines (list (str "const " t " = yield {__step:true, k:'call', f: " callee
                              ", args: " args-js ", src: " src "};"))
       :val t}))))

(defn arglist-js [vals] (str "[" (join-str vals ", ") "]"))

(defn emit-args-temps
  "Emit `nodes` and answer {:lines … :temps [t…]} — one temp per node, in order."
  [nodes ctx]
  (reduce (fn [acc n]
            (let [r (emit n (assoc ctx :tail false))
                  t (fresh-tmp)]
              {:lines (concat (:lines acc) (:lines r)
                              (list (str "const " t " = " (:val r) ";")))
               :temps (conj (:temps acc) t)}))
          {:lines (list) :temps []}
          nodes))

(defn emit-remote
  "A `:remote` in value position. `RT/invoke` and `RT/apply_to` are the
   dynamic-call forms: both become a call step whose callee is the EVALUATED
   function value and whose arguments come from a BL list."
  [node ctx]
  (let [m (:mod node) f (:fun node) args (:args node)]
    (if (and (:guard ctx) (not (= m mod-erlang)))
      (throw (ex-info "js-actors: guard requires synchronous Erlang leaf operations" {:mod m :fun f}))
      nil)
    (if (or (and (= m mod-rt) (= f :invoke))
            (and (= m mod-rt) (= f :apply_to)))
      (let [fr (emit (first args) (assoc ctx :tail false))
            lr (emit (second args) (assoc ctx :tail false))
            ft (fresh-tmp) lt (fresh-tmp)
            ; A `RT/invoke` of a NAMED target is a direct call; of a computed
            ; value it is dynamic. `RT/apply_to` is dynamic by construction.
            direct (and (= f :invoke) (= :global (:op (first args))))
            sr (src-js node ctx (call-kind ctx (if direct "direct" "dynamic")))
            ; `RT/apply_to`'s argument is any sequence (nil, a list or a
            ; vector — BEAM's seq_to_args); an invoke's is the compiler's list
            st (step-call ctx ft (if (= f :apply_to) (str "H.seqToArray(" lt ")") (str "H.listToArray(" lt ")")) sr)]
        {:lines (concat (:lines fr)
                        (list (str "const " ft " = " (:val fr) ";"))
                        (:lines lr)
                        (list (str "const " lt " = " (:val lr) ";"))
                        (:lines st))
         :val (:val st)})
      (let [ar (emit-args-temps args ctx)
            sr (src-js node ctx (call-kind ctx "direct"))
            st (step-call ctx (callee-js m f) (arglist-js (:temps ar)) sr)]
        {:lines (concat (:lines ar) (:lines st))
         :val (:val st)}))))

(defn emit-arith
  "A `:arith` node. The checked `H.arith` is the DEFAULT; a raw JS operator is
   emitted only where `num-evidence` discharges an integer range, and the emitted
   statement carries the witness so the decision is reviewable in the artifact."
  [node ctx]
  (let [ar (emit-args-temps (:args node) ctx)
        t (fresh-tmp)
        a (nth (:temps ar) 0)
        b (nth (:temps ar) 1)
        ev (num-evidence node (:ranges ctx))]
    (num-record! node ev)
    (if (= :raw (:decision ev))
      {:lines (concat (:lines ar)
                      (list (str "const " t " = (" a " " (get num-fast-ops (:fun node)) " " b ");"
                                 " /* js-actors:num-witness cat=" (str (:cat ev))
                                 " range=[" (first (:range ev)) "," (second (:range ev)) "]"
                                 " ops=[" (join-str (map str (:ops ev)) ",") "]"
                                 " leaves=[" (join-str (map str (:leaves ev)) ",") "] */")))
       :val t}
      {:lines (concat (:lines ar)
                      (list (str "const " t " = H.arith(" (js-str (str (:fun node)))
                                 ", " a ", " b ");")))
       :val t})))

(defn emit-apply [node ctx]
  (let [fr (emit (:fn node) (assoc ctx :tail false))
        ar (emit-args-temps (:args node) ctx)
        ft (fresh-tmp)
        sr (src-js node ctx (call-kind ctx "dynamic"))
        st (step-call ctx ft (arglist-js (:temps ar)) sr)]
    {:lines (concat (:lines fr)
                    (list (str "const " ft " = " (:val fr) ";"))
                    (:lines ar)
                    (:lines st))
     :val (:val st)}))

(defn emit-let [node ctx]
  (let [n (:name node)
        generated-loop (and (>= (count n) 5)
                            (= (subs n 0 5) "loop_")
                            (= :fn (:op (:init node))))
        init-ctx (if generated-loop
                   (assoc (assoc (assoc ctx :tail false)
                                 :loop-name (:cur-fn ctx)) :loop-level 2)
                   (assoc ctx :tail false))
        r (emit (:init node) init-ctx)
        ; A bound name inherits the initializer's WHOLE fold record only when
        ; the gate can discharge it — range plus the literal provenance behind
        ; it. ANF names are fresh per function, so this cannot shadow an
        ; enclosing binding of the same name.
        f (num-fold (:init node) (:ranges ctx))
        ctx2 (if (some? f)
               (assoc ctx :ranges (assoc (or (:ranges ctx) {}) (:name node) f))
               ctx)
        b (emit (:body node) ctx2)]
    {:lines (concat (:lines r)
                    (list (str "const " (jsname (:name node)) " = " (:val r) ";"))
                    (:lines b))
     :val (:val b)}))

(defn emit-if [node ctx]
  (let [tr (emit (:test node) (assoc ctx :tail false))
        th (emit (:then node) ctx)
        el (emit (:else node) ctx)
        t (fresh-tmp) res (fresh-tmp)
        assign (fn [r] (if (nil? (:val r)) (list) (list (str res " = " (:val r) ";"))))]
    {:lines (concat (:lines tr)
                    (list (str "const " t " = " (:val tr) ";"))
                    (list (str "let " res ";"))
                    (list (str "if (H.truthy(" t ")) {"))
                    (:lines th) (assign th)
                    (list "} else {")
                    (:lines el) (assign el)
                    (list "}"))
     :val res}))

(defn emit-do [node ctx]
  (let [stmts (:stmts node) n (count stmts)]
    (loop [i 0 acc {:lines (list) :val "null"}]
      (if (>= i n)
        acc
        (let [r (emit (nth stmts i) (assoc ctx :tail (and (:tail ctx) (= i (dec n)))))]
          (recur (inc i) {:lines (concat (:lines acc) (:lines r)) :val (:val r)}))))))

(defn emit-tuple [node ctx]
  (let [ar (emit-args-temps (:elems node) ctx)]
    {:lines (:lines ar)
     :val (str "H.tup(" (arglist-js (:temps ar)) ")")}))

(def ^:private mod-set-atom (erlang/binary_to_atom "Elixir.BeamLisp.Set"))

(defn- pure-data-node?
  "An ANF node that only BUILDS data from literals (no call can run): a
   literal, or a tuple/map/cons/enil/struct of such, or a hash_key of one."
  [n]
  (let [op (:op n)]
    (cond
      (= op :lit) true
      (= op :enil) true
      (= op :cons) (and (pure-data-node? (:head n)) (pure-data-node? (:tail n)))
      (= op :tuple) (every? pure-data-node? (:elems n))
      (= op :map) (every? (fn [p] (and (pure-data-node? (first p)) (pure-data-node? (second p)))) (:pairs n))
      (= op :struct) (every? (fn [p] (pure-data-node? (second p))) (:fields n))
      (and (= op :remote) (= :hash_key (:fun n))) (every? pure-data-node? (:args n))
      (and (= op :remote) (= :new (:fun n)) (= mod-set-atom (:mod n))) (every? pure-data-node? (:args n))
      :else false)))


(defn- literal-key-text
  "A canonical text for a map pair's key when it is a literal keyword/string/
   number (directly, or wrapped in RT.hash_key), else nil."
  [k]
  (let [k (if (and (= :remote (:op k)) (= :hash_key (:fun k))) (first (:args k)) k)]
    (when (= :lit (:op k)) (pr-str (:val k)))))

(defn emit-map [node ctx]
  ; A map literal a MACRO builds (split/defapp's declaration) reaches here in
  ; the order its keys had in the BEAM map — atom-table order, which differs
  ; between VMs. When every key is a literal AND every value is effect-free
  ; (a literal, or data built only of literals — what a quoted declaration
  ; is), emit in canonical key order, so a bundle's bytes depend only on its
  ; inputs (as 04fbee5b intends). Any value that could run code keeps the
  ; given order: evaluation order is observable.
  (let [pairs (let [ps (:pairs node)
                    ks (map (fn [p] (literal-key-text (first p))) ps)]
                (if (and (every? some? ks) (every? (fn [p] (pure-data-node? (second p))) ps))
                  (map second (sort-by first (map (fn [k p] [k p]) ks ps)))
                  ps))
        ar (reduce (fn [acc pair]
                     (let [kr (emit (first pair) (assoc ctx :tail false))
                           vr (emit (second pair) (assoc ctx :tail false))
                           kt (fresh-tmp) vt (fresh-tmp)]
                       {:lines (concat (:lines acc) (:lines kr)
                                       (list (str "const " kt " = " (:val kr) ";"))
                                       (:lines vr)
                                       (list (str "const " vt " = " (:val vr) ";")))
                        :entries (conj (:entries acc) (str "[" kt "," vt "]"))}))
                   {:lines (list) :entries []}
                   pairs)]
    {:lines (:lines ar)
     :val (str "H.bmap([" (join-str (:entries ar) ", ") "])")}))

(defn emit-cons [node ctx]
  (let [hr (emit (:head node) (assoc ctx :tail false))
        tr (emit (:tail node) (assoc ctx :tail false))
        ht (fresh-tmp) tt (fresh-tmp)]
    {:lines (concat (:lines hr)
                    (list (str "const " ht " = " (:val hr) ";"))
                    (:lines tr)
                    (list (str "const " tt " = " (:val tr) ";")))
     :val (str "H.cons(" ht ", " tt ")")}))

(defn emit-struct [node ctx]
  (let [fields (:fields node)
        ar (reduce (fn [acc pair]
                     (let [fname (lit-key-js (first pair) "struct")
                           vr (emit (second pair) (assoc ctx :tail false))
                           vt (fresh-tmp)]
                       {:lines (concat (:lines acc) (:lines vr)
                                       (list (str "const " vt " = " (:val vr) ";")))
                        :fields (conj (:fields acc) (str (js-str fname) ": " vt))}))
                   {:lines (list) :fields []}
                   fields)]
    {:lines (:lines ar)
     :val (str "H.struct(" (js-str (str (:mod node))) ", {"
               (join-str (:fields ar) ", ") "})")}))

; ── functions ────────────────────────────────────────────────────────────────

(defn emit-fn
  "A `:fn` value: a JS expression building a `blFn` closure. All clauses of one
   `:fn` node share a shape (arity and variadic-ness), so the arity is read off
   the first clause — the compiler's `assemble-fn` already grouped them.

   `:src-name` is stamped by `emit-init` on a top-level def's REAL fn node (the
   body of the compiler's self-application scaffold), and names the function the
   body's call sites are written in. A nested anonymous fn carries no stamp, so
   its calls record an explicit null name."
  [node ctx]
  (let [cls (:clauses node)
        arity (count (:pats (first cls)))
        ; Only the TWO compiler-generated fn layers of a loop inherit the
        ; enclosing BL name. Authored anonymous closures must stay anonymous,
        ; even when their ANF node has no source annotation.
        loop-level (or (:loop-level ctx) 0)
        own (or (:src-name node)
                (if (> loop-level 0) (:loop-name ctx) nil))
        base (assoc (assoc ctx :loop-level (if (> loop-level 0) (dec loop-level) 0))
                    :cur-fn own :arity arity)
        res (fresh-tmp) matched (fresh-tmp)
        clause-lines (fn [c]
                       (let [label (fresh-tmp)
                             cctx (without-binders base (mapcat pat-binder-names (:pats c)))
                             g (:guard c)
                             gl (emit-guard g cctx)
                             bl (emit (:body c) (assoc cctx :tail true))]
                         (concat
                           (list (str "if (!" matched ") { " label ": {"))
                           (mapcat (fn [i]
                                     (emit-pattern-lines (nth (:pats c) i)
                                       (str "args[" i "]") label cctx))
                                   (range (count (:pats c))))
                           (:lines gl)
                           (list (str "if (" (:val gl) " === true) {"))
                           (:lines bl)
                           (if (nil? (:val bl)) (list) (list (str res " = " (:val bl) ";")))
                           (list (str matched " = true;"))
                           (list "} } }"))))
        body (apply str
               (map (fn [c] (apply str (clause-lines c)))
                    cls))]
    (str "H.blFn(\"fn\", new Map([[" arity ", function*(rt, args) {\n"
         "let " res "; let " matched " = false;\n"
         body
         "if (!" matched ") throw new Error('fn: no matching clause');\n"
         "return " res ";\n"
         "}]]), null)")))

; ── case ─────────────────────────────────────────────────────────────────────

(defn emit-pattern-lines [p v label ctx]
  (let [op (:pop p)]
    (cond
      (= op :pvar)
        (if (= (:name p) "_") (list)
          (list (str "const " (jsname (:name p)) " = " v ";")))

      (= op :plit)
        (list (str "if (!H.eq(" v ", " (lit-js (:val p)) ")) break " label ";"))

      (= op :pnil)
        (list (str "if (!H.isEnil(" v ")) break " label ";"))

      (= op :ptuple)
        (let [t (fresh-tmp) n (count (:elems p))]
          (concat
            (list (str "const " t " = " v ";"))
            (list (str "if (!H.isTup(" t ")) break " label ";"))
            (list (str "if (H.tupSize(" t ") !== " n ") break " label ";"))
            (mapcat (fn [i]
                      (emit-pattern-lines (nth (:elems p) i) (str "H.tupEl(" t "," i ")") label ctx))
                    (range n))))

      (= op :pcons)
        (let [t (fresh-tmp)]
          (concat
            (list (str "const " t " = " v ";"))
            (list (str "if (!H.isCons(" t ")) break " label ";"))
            (emit-pattern-lines (:head p) (str "H.consHead(" t ")") label ctx)
            (emit-pattern-lines (:tail p) (str "H.consTail(" t ")") label ctx)))

      (= op :palias)
        (concat (emit-pattern-lines (:b p) v label ctx)
                (emit-pattern-lines (:a p) v label ctx))

      (= op :pmap)
        (let [t (fresh-tmp)]
          (concat
            (list (str "const " t " = " v ";"))
            (list (str "if (!H.isMap(" t ")) break " label ";"))
            (mapcat (fn [pair]
                      (let [keyjs (lit-js (:val (first pair)))]
                        (concat
                          (list (str "if (!H.mapHas(" t ", " keyjs ")) break " label ";"))
                          (emit-pattern-lines (second pair)
                                              (str "H.mapGet(" t ", " keyjs ")") label ctx))))
                    (:pairs p))))

      (= op :pstruct)
        (let [t (fresh-tmp)]
          (concat
            (list (str "const " t " = " v ";"))
            (list (str "if (!H.isStruct(" t ") || H.structMod(" t ") !== "
                       (js-str (str (:mod p))) ") break " label ";"))
            (mapcat (fn [pair]
                      (emit-pattern-lines (second pair)
                                          (str "H.structField(" t ", " (js-str (str (first pair))) ")")
                                          label ctx))
                    (:fields p))))

      :else
        (throw (ex-info (str "js-actors: unknown pattern op " (pr-str op)) {:pattern p})))))

(defn emit-pats-lines [pats vals label ctx]
  (apply concat
    (map (fn [i] (emit-pattern-lines (nth pats i) (nth vals i) label ctx))
         (range (count pats)))))

(defn emit-case [node ctx]
  (let [sr (emit (:subj node) (assoc ctx :tail false))
        st (fresh-tmp)
        res (fresh-tmp) matched (fresh-tmp)
        clauses (:clauses node)
        clines (mapcat (fn [c]
                         (let [label (fresh-tmp)
                               cctx (without-binders ctx (mapcat pat-binder-names (:pats c)))
                               g (:guard c)
                               gl (emit-guard g cctx)
                               bl (emit (:body c) cctx)]
                           (concat
                             (list (str "if (!" matched ") { " label ": {"))
                             (emit-pats-lines (:pats c) (list st) label ctx)
                             (:lines gl)
                             (list (str "if (" (:val gl) " === true) {"))
                             (:lines bl)
                             (if (nil? (:val bl)) (list) (list (str res " = " (:val bl) ";")))
                             (list (str matched " = true;"))
                             (list "} } }"))))
                       clauses)]
    {:lines (concat (:lines sr)
                    (list (str "const " st " = " (:val sr) ";"))
                    (list (str "let " res "; let " matched " = false;"))
                    clines
                    (list (str "if (!" matched ") throw new Error('case: no matching clause');")))
     :val res}))

; ── receive ──────────────────────────────────────────────────────────────────

(defn closure0
  "A zero-arity BL closure from an ANF body node — how a receive clause body
   and the timeout body reach the runtime. Bodies are emitted in tail position:
   the machine replaces the closure's own frame, so a receive loop is
   stack-safe."
  [nm bodynode ctx]
  (let [b (emit bodynode (assoc ctx :tail true))]
    (str "H.blFn(" (js-str nm) ", new Map([[0, function*(rt, args) {\n"
         (apply str (:lines b))
         (if (nil? (:val b)) "" (str "return " (:val b) ";\n"))
         "}]]), null)")))

(defn emit-recv
  "A `:recv`. The compiled probe — one labelled block per clause, each clause
   body wrapped as a closure returned only on a match — is handed to the BL
   runtime's `rt-receive`, which owns mailbox scanning, the scan cursor, wait
   registration and the deadline. The emitter owns only suspension and the
   dispatch of the selected body."
  [node ctx]
  (let [to (if (nil? (:timeout node))
             {:lines (list) :val "null"}
             (emit (:timeout node) (assoc ctx :tail false)))
        after-js (if (nil? (:after node))
                   "null"
                   (closure0 "after" (:after node) ctx))
        scan (fresh-tmp) sel (fresh-tmp) body (fresh-tmp)
        vm (fresh-tmp) res (fresh-tmp) matched (fresh-tmp)
        clauses (:clauses node)
        clines (mapcat
                 (fn [c]
                   (let [label (fresh-tmp)
                         cctx (without-binders ctx (mapcat pat-binder-names (:pats c)))
                         g (:guard c)
                         gl (emit-guard g cctx)]
                     (concat
                       (list (str "if (!" matched ") { " label ": {"))
                       (emit-pats-lines (:pats c) (list vm) label ctx)
                       (:lines gl)
                       (list (str "if (" (:val gl) " === true) {"))
                       (list (str res " = H.vec([H.kw(\"match\"), "
                                  (closure0 "recv-body" (:body c) cctx) "]);"))
                       (list (str matched " = true;"))
                       (list "} } }"))))
                 clauses)
        scan-closure (str "H.blFn(\"scan\", new Map([[1, function*(rt, args) {\n"
                          "const " vm " = args[0];\n"
                          "let " res " = null; let " matched " = false;\n"
                          (apply str clines)
                          "if (" matched ") return " res ";\n"
                          "return H.kw(\"nomatch\");\n"
                          "}]]), null)")
        sel-lines (list (str "const " scan " = " scan-closure ";")
                        (str "const " sel " = yield {__step:true, k:'call', f: H.ref(rt,\"js\",\"rt-receive\"),"
                             " args: [" scan ", " after-js ", " (:val to) "], src: "
                             (src-js node ctx (call-kind ctx "direct")) "};")
                        (str "const " body " = H.vecEl(" sel ", 1);"))
        t (fresh-tmp)
        dispatch (if (:tail ctx)
                   (list (str "yield {__step:true, k:'tail', f: " body ", args: [], src: "
                              (src-js node ctx "tail") "};") "return;")
                   (list (str "const " t " = yield {__step:true, k:'call', f: " body
                              ", args: [], src: " (src-js node ctx "dynamic") "};")))]
    {:lines (concat (:lines to) sel-lines dispatch)
     :val (if (:tail ctx) nil t)}))

; ── try / catch / finally ─────────────────────────────────────────────────
;
; `:try` is emitted as a REAL JavaScript `try`/`catch`/`finally` INSIDE the
; generator, not as a wrapper around one. That is the whole trick, and it is
; what makes the scope survive suspension: the machine hands a thrown value to
; a suspended generator with `gen.throw`, so a JavaScript catch clause in the
; generated function text intercepts it exactly where the language says — after
; any number of calls, receives, parks or bounded scheduler slices. A `try`
; that merely wrapped a generator returning a control step would lose its
; `finally` the moment the step suspended, which is the reason the earlier
; prototype refused `:try` outright.
;
; Two consequences the emitter must honour:
;
;   * the protected body, every catch-clause body and the finalizer are emitted
;     NON-TAIL. A tail call in one of them would REPLACE this generator's frame,
;     and a frame no longer on the stack cannot be thrown into: the scope would
;     be erased silently. Callees still tail-call normally among themselves, so
;     a loop inside a protected body stays bounded.
;
;   * everything else is the engine's job. A finalizer that suspends is safe
;     because JavaScript holds the pending completion in the generator's own
;     frame: resuming the finalizer either re-throws what was unwinding or ends
;     a normal completion, its value is discarded either way, and a raise
;     inside it supersedes whatever was pending. The emitter tracks none of it.

(defn emit-try-clauses
  "Emit the statements of a `:try`'s JavaScript catch block.

   The frontend has already lowered EVERY source clause into ONE ANF catch
   clause whose pattern is `(kind value)` — the class and the reason — and whose
   body binds `__STACKTRACE__`, normalizes through the target's
   `Exception.normalize`, dispatches over the clauses and RERAISES with
   `:erlang/raise` when nothing matched. None of that is re-invented here: this
   binds the three fields of the thrown envelope to the names that body already
   reads, and lets its value become the `try`'s."
  [catches res ctx]
  (if (empty? catches)
    (list)
    (let [stack-name (jsname "__STACKTRACE__")
          matched (fresh-tmp)
          clines (mapcat
                   (fn [c]
                     (let [label (fresh-tmp)
                           gl (emit-guard (:guard c) ctx)
                           bl (emit (:body c) (assoc ctx :tail false))]
                       (concat
                         (list (str "if (!" matched ") { " label ": {"))
                         (emit-pats-lines (:pats c)
                                          (list "H.exKind(TRY_EX)" "H.exReason(TRY_EX)")
                                          label ctx)
                         (:lines gl)
                         (list (str "if (" (:val gl) " === true) {"))
                         (:lines bl)
                         (if (nil? (:val bl)) (list) (list (str res " = " (:val bl) ";")))
                         (list (str matched " = true;"))
                         (list "} } }"))))
                   catches)]
      (concat
        ; the frontend binds the frame list AND the raw catch value (the
        ; reraise reads the raw); a JS exception carries one trace for both
        (list (str "const " stack-name " = H.exTrace(TRY_EX);"))
        (list (str "const " (jsname "__STACKTRACE_RAW__") " = " stack-name ";"))
        (list (str "let " matched " = false;"))
        clines
        (list (str "if (!" matched ") throw new Error('try: no catch clause matched');"))))))

(defn emit-try
  "A `:try` in value position. See the section comment above for why the
   protected regions are non-tail and why nothing is tracked across a
   suspension. A `try` with neither a catch nor a finalizer protects nothing,
   so it passes its body through with the surrounding tail context intact."
  [node ctx]
  (let [catches (:catch node)
        aft (:after node)]
    (if (and (empty? catches) (nil? aft))
      (emit (:body node) ctx)
      (let [res (fresh-tmp)
            body-lines (let [b (emit (:body node) (assoc ctx :tail false))]
                         (concat (:lines b)
                                 (if (nil? (:val b))
                                   (list)
                                   (list (str res " = " (:val b) ";")))))
            after-lines (if (nil? aft)
                          (list)
                          (:lines (emit aft (assoc ctx :tail false))))]
        {:lines (concat
                  (list (str "let " res ";"))
                  (list "try {")
                  body-lines
                  (if (empty? catches) (list) (list "} catch (TRY_EX) {"))
                  (emit-try-clauses catches res ctx)
                  (if (nil? aft) (list) (list "} finally {"))
                  after-lines
                  (list "}"))
         :val res}))))

; ── the dispatcher ───────────────────────────────────────────────────────────

(defn emit
  "Emit one bl-ANF node. `ctx` carries `:tail` — whether the node's value is
   the enclosing function's result, which is where a call becomes a tail step."
  [node ctx]
  (let [op (:op node)]
    (if (and (:guard ctx) (or (= op :apply) (= op :recv) (= op :fn) (= op :try)))
      (throw (ex-info "js-actors: unsupported suspending guard operation" {:op op}))
      nil)
    (cond
      (= op :lit) {:lines (list) :val (lit-js (:val node))}
      (= op :var) {:lines (list) :val (jsname (:name node))}
      (= op :global)
        {:lines (list)
         :val (str "H.ref(rt," (js-str (:ns node)) "," (js-str (:name node)) ")")}
      (= op :remote) (emit-remote node ctx)
      (= op :arith) (emit-arith node ctx)
      (= op :apply) (emit-apply node ctx)
      (= op :let) (emit-let node ctx)
      (= op :if) (emit-if node ctx)
      (= op :do) (emit-do node ctx)
      (= op :tuple) (emit-tuple node ctx)
      (= op :map) (emit-map node ctx)
      (= op :cons) (emit-cons node ctx)
      (= op :enil) {:lines (list) :val "H.ENIL"}
      (= op :struct) (emit-struct node ctx)
      (= op :fn) {:lines (list) :val (emit-fn node ctx)}
      (= op :case) (emit-case node ctx)
      (= op :recv) (emit-recv node ctx)
      (= op :try) (emit-try node ctx)
      :else (throw (ex-info (str "js-actors: unknown ANF op " (pr-str op)) {:op op})))))

; ─────────────────────────────────────────────────────────────────────────────
; Reference audit — the fail-closed half of the ABI
; ─────────────────────────────────────────────────────────────────────────────

(defn walk-refs [x acc]
  (cond
    (erlang/is_map x)
      (let [acc2 (cond
                   (not (contains? x :op)) acc
                   (= (:op x) :remote) (conj acc [:remote (:mod x) (:fun x)])
                   (= (:op x) :global) (conj acc [:global (:ns x) (:name x)])
                   :else acc)]
        ; `maps/get`, never BL `get`: a BL vector IS an Erlang map (a struct
        ; whose `:items` is a tuple), and BL `get` on a vector indexes by
        ; position, so `(get v :items)` is nil. With `get`, every reference
        ; written inside a vector literal — `[:a (anything x)]` — escaped the
        ; audit.
        (reduce (fn [a k] (walk-refs (maps/get k x) a)) acc2 (maps/keys x)))
    (erlang/is_list x) (reduce (fn [a y] (walk-refs y a)) acc x)
    (erlang/is_tuple x) (reduce (fn [a y] (walk-refs y a)) acc (erlang/tuple_to_list x))
    :else acc))

(defn refs-of [nodes]
  (reduce (fn [acc n] (walk-refs n acc)) [] nodes))

(defn remote-ok? [m f]
  (cond
    (= m mod-host) (contains? host-names (str f))
    (= m mod-erlang) (contains? erlang-names (str f))
    ; the two dynamic-call forms are lowered by name, not through the table
    (and (= m mod-rt) (= f :invoke)) true
    (and (= m mod-rt) (= f :apply_to)) true
    :else (contains? remote-map (remote-key m f))))

(defn global-ok? [ns name defined]
  (or (and (= ns "js") (or (contains? defined name) (contains? core-map name)))
      (contains? core-map name)))

(defn audit! [refs defined]
  (let [bad (reduce
              (fn [acc r]
                (let [kind (nth r 0)]
                  (cond
                    (= kind :remote)
                      (if (remote-ok? (nth r 1) (nth r 2))
                        acc
                        (conj acc (str "  unknown remote " (remote-key (nth r 1) (nth r 2))
                                       " — not in the checked ABI")))
                    (= kind :global)
                      (if (global-ok? (nth r 1) (nth r 2) defined)
                        acc
                        (conj acc (str "  unresolved global " (nth r 1) "/" (nth r 2))))
                    :else acc)))
              []
              refs)]
    (if (empty? bad)
      :ok
      (throw (ex-info (str "js-actors: the program reaches outside the checked ABI:\n"
                           (join-str (distinct bad) "\n"))
                      {:references (distinct bad)})))))

; ─────────────────────────────────────────────────────────────────────────────
; The build
; ─────────────────────────────────────────────────────────────────────────────

(defn read-file-forms [path]
  ; POSITION-BEARING read: the reader's `:meta` wrappers are what the compiler
  ; turns into `:ann`, and `:ann` is the emitter's only source channel. `read_all`
  ; deep-unwraps those wrappers, so it is the entry for tools that want bare
  ; shapes — not for a backend that must name where a call was written.
  (BeamLisp.Ns.Reader/read (File/read! path) {:file path}))

; ─────────────────────────────────────────────────────────────────────────────
; `proc/defserver` — one declaration, lowered for this target
;
; `defserver` is the ONE server declaration a bundle writes, and the clause model
; around it (`proc.server/clause-plan`) is what decides what a clause MEANS —
; the state merge, the injected order, the one merged `:DOWN` handler, the
; unknown-clause report. This backend does not re-derive any of it: it hands the
; SAME source clause data to `clause-plan`, with an EXPLICIT target vocabulary,
; and renders the plan it hands back. So a bundle that says
;
;     (proc/defserver counter
;       (init [_] (ok {:n 0}))
;       (handle-call [:bump by] [_from st] (reply (:n st) (assoc st :n (+ (:n st) by))))
;       (handle-cast [:reset] [st] (noreply (assoc st :n 0))))
;
; becomes, here, ONE entry defn (`counter`, taking the init argument) and ONE
; server loop defn (`counter__server_loop`). Both are ordinary BL, so they pass
; through the same reader → ANF → JS pipeline as everything else and nothing in
; the emitter knows what a server is.
;
; WHY ONE RECEIVE LOOP. The target already owns exactly one selective-receive
; primitive (`rt-receive`: scan cursor, fixed deadline, message-major selection)
; and the call protocol rides on it. A server IS a process parked in a receive
; whose arms are its clauses — so the lowering is a SOURCE transformation and
; the ABI stays closed. There is no second public DSL and no interpreter.
;
; THE TARGET VOCABULARY, AND WHAT IT REFUSES:
;   * `init`/`handle-call`/`handle-cast`/`handle-info`/`terminate` are this
;     backend's NATIVE heads — the ones the loop renders;
;   * `(registry …)`, `(bus …)`, `(tick …)` are CONTRIBUTED clauses (their
;     transforms live in a bundle and contribute a state slice, an injected
;     clause list and a `:down` handler). This target contributes NONE yet, so
;     `:vocabulary` below is empty and such a clause is REFUSED, by name. An
;     unknown clause is never silently dropped: its handler would simply never
;     run, which is the one failure mode a server must not have;
;   * `handle-continue` and `invariant` are native-head NAMES this loop does not
;     render, so they are refused the same way rather than accepted and ignored.
;
; THE MESSAGE VOCABULARY IS THE RUNTIME'S. A request is `[:call ref from msg]`,
; a cast `[:cast msg]`, a stop `[:stop reason]`, and a monitor DOWN is the
; runtime's `[:down ref :process pid reason]`. So a clause's `:DOWN` pattern is
; mapped onto `:down` at this one seam, `reply`/`noreply` become real messages
; to the caller that asked, and nothing else about the clause bodies changes.

(def target-server-native-heads
  "The clause heads this backend's server loop renders itself. It is the
   `:native-heads` set `clause-plan` is given, named here so the accepted
   vocabulary is one datum a diagnostic can print instead of a literal buried
   in a call. `handle-continue` and `invariant` are deliberately absent: the
   loop has no arm for them, so they are refused rather than ignored."
  #{"init" "handle-call" "handle-cast" "handle-info" "terminate"})

(def target-server-vocabulary
  "Clause head → transform, for clauses this target CONTRIBUTES a meaning to:
   none, yet. The empty map is explicit — it is what makes the vocabulary a
   decision of THIS backend instead of the native registry's, and what makes
   `(registry (keys :id))` an unknown clause here rather than a silent no-op."
  {})

(defn symbol-for
  "The symbol a reader symbol node spells: a spelling with ONE `/` becomes
   ns/name, so `pr-str` renders it back unchanged. Anything else stays a bare
   name — a reader node carries no separate namespace component."
  [s]
  (let [parts (String/split s "/")]
    (if (and (erlang/is_list parts) (= 2 (erlang/length parts)))
      (symbol (first parts) (second parts))
      (symbol s))))

(defn node->data
  "A reader node as plain source DATA: symbols become symbols, keywords become
   keywords, and lists, vectors, maps and sets recurse. The `:meta` wrapper
   (source position, author metadata) is dropped — the clause model reads the
   DSL, and a position is not part of it."
  [n]
  (let [f (n-unwrap n)]
    (if (erlang/is_tuple f)
      (let [tag (erlang/element 1 f)
            v (erlang/element 2 f)]
        (cond
          (= tag :symbol) (symbol-for v)
          (= tag :keyword) (keyword v)
          (= tag :list) (apply list (map node->data v))
          (= tag :vector) (vec (map node->data v))
          (= tag :set) (set (map node->data v))
          (= tag :map) (reduce (fn [m pair]
                                 (assoc m (node->data (erlang/element 1 pair))
                                          (node->data (erlang/element 2 pair))))
                               {} v)
          :else f))
      f)))

(defn defserver-sym?
  "The spellings of the ONE server declaration this backend accepts: the form's
   own name, and the two qualified names a bundle reaches it by."
  [s]
  (or (= s "defserver") (= s "proc/defserver") (= s "proc.server/defserver")))

(defn defserver-form? [n]
  (and (= :list (n-tag n))
       (let [its (n-items n)]
         (and (not (empty? its)) (defserver-sym? (n-name (first its)))))))

(defn defserver-name [n] (n-name (second (n-items n))))

(defn map-form
  "Rebuild `form` with `f` applied to every LIST node, bottom-up, recursing
   into vectors and into map VALUES. `f` therefore sees a node whose children
   are already rewritten."
  [f form]
  (cond
    (list? form) (f (apply list (map (fn [x] (map-form f x)) form)))
    (vector? form) (vec (map (fn [x] (map-form f x)) form))
    (map? form) (reduce (fn [m k] (assoc m k (map-form f (get form k)))) {} (keys form))
    :else form))

(defn ok-strip
  "Replace a server init's `(ok state)` with `state`. `clause-plan` GUARANTEES
   that marker (it rewrites exactly that position, and refuses an init that does
   not end there); on this target the state it names IS the init's value."
  [form]
  (map-form (fn [x] (if (and (list? x) (= 'ok (first x)) (= 2 (count x)))
                      (second x)
                      x))
            form))

(defn rw-reply
  "Rewrite a clause body into the target's reply vocabulary: `(reply v next)`
   becomes a real reply to the caller that asked, then `next`; `(noreply next)`
   becomes `next`. `from`/`ref` are the arm's caller and request ref; when the
   clause has no caller (cast, info, down) `from` is nil and a `reply` is a
   DECLARATION error with a sentence — rather than an unresolved global found
   later by the ABI audit."
  [form from ref where]
  (map-form
    (fn [x]
      (cond
        (and (list? x) (= 'reply (first x)))
          (cond
            (nil? from)
              (throw (ex-info (str where ": reply is only meaningful inside handle-call —"
                                    " a cast, info or DOWN clause has no caller to answer")
                              {:form x}))
            (= 3 (count x)) (list 'do (list 'rt-reply-to from ref (second x)) (nth x 2))
            :else
              (throw (ex-info (str where ": reply takes a value and the next state")
                              {:form x})))
        (and (list? x) (= 'noreply (first x)))
          (if (= 2 (count x))
            (second x)
            (throw (ex-info (str where ": noreply takes the next state") {:form x})))
        :else x))
    form))

(defn down-pattern
  "This runtime's monitor DOWN message is `[:down ref :process pid reason]`;
   the clause model (and a bundle written for the native backend) spells the
   head `:DOWN`. Translate the head of a DOWN PATTERN only — a body that
   mentions `:DOWN` means it."
  [pat]
  (if (and (vector? pat)
           (not (empty? pat))
           (keyword? (first pat))
           (= "DOWN" (name (first pat))))
    (assoc pat 0 :down)
    pat))

(defn do-form
  "A clause body as ONE form: the form itself, or `(do …)` around several. Nil
   for an empty body — a clause with no body has no next state to hand back."
  [forms]
  (cond
    (empty? forms) nil
    (= 1 (count forms)) (first forms)
    :else (apply list (cons 'do (vec forms)))))

(defn srv-at [v i] (if (< i (count v)) (nth v i) nil))

(defn srv-params
  "A clause's parameter vector, VALIDATED. Each head binds its parameters by
   position — `[from state]` for handle-call, `[state]` for cast and info,
   `[reason state]` for terminate — so a wrong shape is a declaration error with
   a sentence, never an index error from `nth`."
  [params n where clause]
  (if (and (vector? params)
           (= n (count params))
           (every? (fn [x] (symbol? x)) params))
    params
    (throw (ex-info (str where ": " (name (first clause)) " takes " n
                         " parameter(s) in a vector — got " (pr-str params))
                    {:clause clause}))))

(defn lower-arm
  "One plan clause as a `receive` arm of the server loop, or nil when the clause
   is not an arm (init, and anything the vocabulary did not classify)."
  [clause loop-sym st-var ref-var where]
  (let [head (name (first clause))
        parts (vec (rest clause))]
    (cond
      (= head "handle-call")
        (let [params (srv-params (srv-at parts 1) 2 where clause)
              from (nth params 0)
              stx (nth params 1)]
          (list [:call ref-var from (down-pattern (srv-at parts 0))]
                (list loop-sym
                      (list 'let [stx st-var]
                            (rw-reply (do-form (vec (drop 2 parts))) from ref-var where)))))
      (= head "handle-cast")
        (let [stx (nth (srv-params (srv-at parts 1) 1 where clause) 0)]
          (list [:cast (srv-at parts 0)]
                (list loop-sym
                      (list 'let [stx st-var]
                            (rw-reply (do-form (vec (drop 2 parts))) nil ref-var where)))))
      (= head "handle-info")
        (let [stx (nth (srv-params (srv-at parts 1) 1 where clause) 0)]
          (list (down-pattern (srv-at parts 0))
                (list loop-sym
                      (list 'let [stx st-var]
                            (rw-reply (do-form (vec (drop 2 parts))) nil ref-var where)))))
      :else nil)))

(defn lower-defserver
  "Lower `(proc/defserver name clauses…)` to the target's two defn forms, as
   DATA. The plan is `proc.server/clause-plan`'s, run on this source data with
   THIS backend's vocabulary; everything below only renders it."
  [form]
  (let [its (n-items form)
        sname (n-name (second its))
        where (str "defserver " sname)
        clauses (vec (map node->data (drop 2 its)))
        plan (pserver/clause-plan {:name (symbol sname)
                                   :clauses clauses
                                   :vocabulary target-server-vocabulary
                                   :native-heads target-server-native-heads})
        unknown (first (:unknown plan))]
    (when (some? unknown)
      (throw (ex-info (str where ": unknown clause `" (:head unknown)
                           "` — this target's server loop renders: "
                           (join-str (sort (vec target-server-native-heads)) " ")
                           ". The clause model is proc.server/clause-plan, run with THIS"
                           " backend's vocabulary, so a clause no backend contributes is"
                           " reported instead of reaching the codegen — a clause that"
                           " compiled but never ran would be worse than one that did not"
                           " compile.")
                      {:clause (:head unknown) :server sname})))
    (let [loop-sym (symbol (str sname "__server_loop"))
          st-var 'st__server
          ref-var 'ref__server
          why-var 'why__server
          body (vec (:body plan))
          init (first (filter (fn [c] (= "init" (name (first c)))) body))
          terms (vec (filter (fn [c] (= "terminate" (name (first c)))) body))
          arms (vec (keep (fn [c] (lower-arm c loop-sym st-var ref-var where)) body))
          init-parts (if (nil? init) nil (vec (rest init)))
          init-params (if (nil? init) [] (nth init-parts 0))
          init-arg (if (empty? init-params) '_ (first init-params))
          init-body (if (nil? init) {} (ok-strip (do-form (vec (drop 1 init-parts)))))
          stop (list [:stop why-var]
                     (do-form (concat
                                (map (fn [t]
                                       (let [tp (srv-params (srv-at (vec (rest t)) 0) 2 where t)
                                             rp (nth tp 0)
                                             sp (nth tp 1)]
                                         (list 'let [rp why-var sp st-var]
                                               (rw-reply (do-form (vec (drop 1 (vec (rest t)))))
                                                         nil ref-var where))))
                                     terms)
                                (list (list 'erlang/exit why-var)))))
          all (cons stop (to-list arms))
          entry (list 'defn (symbol sname) [init-arg] (list loop-sym init-body))
          flat (reduce (fn [acc pair] (into acc pair)) [] all)
          loop (list 'defn loop-sym [st-var]
                     (apply list (to-list (into ['receive] flat))))]
      (when (empty? arms)
        (throw (ex-info (str where ": the server loop needs at least one"
                             " handle-call, handle-cast or handle-info clause — an"
                             " init alone leaves the target with no loop to run")
                        {:server sname})))
      [entry loop])))

(defn lower-defserver-forms
  "The defn reader nodes a `proc/defserver` declaration lowers to. Printed with
   `pr-str` and read back, so the generated forms go through the SAME reader and
   compiler as hand-written source — the lowering never builds ANF itself."
  [form ns]
  (map (fn [f]
         (with-pos (BeamLisp.Ns.Reader/read_one (pr-str f)) (n-pos form)))
       (lower-defserver form)))

; ─────────────────────────────────────────────────────────────────────────────
; `proc.super/defsupervisor` — one tree declaration, lowered for this target
;
; `defsupervisor` is the ONE supervision-tree declaration a bundle writes. Its
; expansion is `proc.super/supervisor-plan`'s — the SAME pure expander the
; native macro adapter runs — so the strategy, the intensity window, the child
; order, the unique-id check and every declaration diagnostic are decided ONCE,
; for both backends. This file renders the plan it hands back: it never
; re-derives the DSL, and it never calls a native supervisor.
;
; THE RENDERED VALUE, and why it is target-neutral. `defsupervisor` binds its
; name to a ZERO-ARGUMENT CONSTRUCTOR returning a plain spec map — the shape
; runtime.bl section 6 consumes:
;
;   {:name :billing :strategy :one-for-one :intensity [3 5000]
;    :children [{:id :acct :kind :server :target account :args [100]
;                :restart :permanent :shutdown 5000 :type :worker :name nil
;                :order 0} …]}
;
; `:target` is the declared CHILD NAME left as a SYMBOL, so the rendered form
; reaches the same `js/…` global the child's own defn defines — there is no name
; registry and no arity bridge to get wrong. `:args` is the child's init
; argument vector, and the four options are recorded WITH their defaults, so the
; runtime never re-derives one.
;
; WHAT THIS LOWERING REFUSES, and why refusing is the honest answer:
;
;   * an unknown clause head, an invalid strategy, a bad intensity, a duplicate
;     child id, a malformed child — reported through `proc.super`'s OWN
;     diagnostics, the same sentences the native adapter throws, because a
;     declaration that compiled but meant something else is worse than one that
;     did not compile;
;   * a `(pool …)` child. A pool is a sub-supervisor plus a dispatcher on the
;     native path; this target has neither, so a pool is refused BY NAME rather
;     than started as a plain child that would silently lose the pool protocol.

(defn defsupervisor-sym?
  "The spellings of the ONE tree declaration this backend accepts."
  [s]
  (or (= s "defsupervisor")
      (= s "proc.super/defsupervisor")
      (= s "proc/super/defsupervisor")))

(defn defsupervisor-form? [n]
  (and (= :list (n-tag n))
       (let [its (n-items n)]
         (and (not (empty? its)) (defsupervisor-sym? (n-name (first its)))))))

(defn defsupervisor-name [n] (n-name (second (n-items n))))

(defn sup-child-spec
  "One plan child as the spec map this target's supervisor reads. `:target`
   stays the symbol the declaration named."
  [c]
  (let [opts (:options c)]
    {:id (:id c)
     :kind (:kind c)
     :target (:target c)
     :args (vec (:args c))
     :restart (get opts :restart :permanent)
     :shutdown (get opts :shutdown 5000)
     :type (get opts :type :worker)
     :name (get opts :name nil)
     :order (:order c)}))

(defn supervisor-spec-form
  "A plan as the target-neutral BL value `defsupervisor` binds: the tree's
   name, strategy and intensity, and its children in declaration order."
  [p]
  {:name (keyword (:name p))
   :strategy (:strategy p)
   :intensity (:intensity p)
   :children (vec (map sup-child-spec (:children p)))})

(defn lower-defsupervisor
  "Lower `(proc.super/defsupervisor name clauses…)` to ONE defn — the tree's
   zero-argument constructor — as DATA. The plan is
   `proc.super/supervisor-plan`'s, run on this source data; everything below
   only renders it."
  [form]
  (let [its (n-items form)
        name-node (second its)]
    (if (nil? name-node)
      (throw (ex-info "js-actors: defsupervisor needs a tree name" {:form form}))
      (let [sname (n-name name-node)
            where (str "defsupervisor " sname)
            clauses (vec (map node->data (drop 2 its)))
            plan (psuper/supervisor-plan {:name (symbol sname) :clauses clauses})]
        (when (seq (:unknown plan))
          (throw (psuper/unknown-supervisor-clause-error (symbol sname)
                                                         (first (:unknown plan)))))
        (when (seq (:errors plan))
          (throw (psuper/invalid-supervisor-error (symbol sname)
                                                  (first (:errors plan)))))
        (when (some (fn [c] (= :pool (:kind c))) (:children plan))
          (throw (ex-info (str where ": a `pool` child is not implemented on this"
                               " target — the portable subset starts SERVER children,"
                               " so a pool is refused here rather than started as a"
                               " plain child that would lose the pool protocol")
                          {:tree sname :kind :pool})))
        (list (list 'defn (symbol sname) [] (supervisor-spec-form plan)))))))

(defn lower-defsupervisor-forms
  "The defn reader nodes a `proc.super/defsupervisor` declaration lowers to.
   Printed with `pr-str` and read back, exactly like a lowered `defserver`, so
   the generated form goes through the SAME reader and compiler as hand-written
   source."
  [form ns]
  (map (fn [f]
         (with-pos (BeamLisp.Ns.Reader/read_one (pr-str f)) (n-pos form)))
       (lower-defsupervisor form)))

(defn compile-defn-form
  "One `defn` reader form as a compiled definition. Every form this backend
   accepts reaches ANF the same way: through `defn->fn-form`, so a top-level
   definition needs no Env/Link machinery."
  [form ns]
  {:name (defn-name form)
   :node (BeamLisp.Ns.Compiler/compile (defn->fn-form form)
                                       (BeamLisp.Ns.Compiler/new_env ns))})

(defn compile-top-form
  "Compile ONE top-level reader form into the definitions it contributes.

   A `defn` is one definition; a `proc/defserver` DECLARATION is two — its
   entry defn and its server loop — because the clause surface a bundle writes
   is `proc.server`'s and the target only renders it. Anything else is refused:
   this backend has no value-defs, no namespace side effects and no top-level
   expressions, which is the honest scope of the prototype."
  [form ns path]
  (cond
    (defn-form? form) [(compile-defn-form form ns)]
    ; a shared library file names its BEAM namespace; this target has one
    ; namespace per bundle, so the head contributes nothing here
    (ns-form? form) []
    (defserver-form? form) (vec (map (fn [f] (compile-defn-form f ns))
                                     (lower-defserver-forms form ns)))
    (defsupervisor-form? form) (vec (map (fn [f] (compile-defn-form f ns))
                                         (lower-defsupervisor-forms form ns)))
    :else
      (throw (ex-info (str "js-actors: " path ": every top-level form must be a"
                           " defn, a proc/defserver or a proc.super/defsupervisor"
                           " declaration; got a "
                           (str (n-tag form)) " form")
                      {:path path :tag (n-tag form)}))))

(defn compile-source
  "Compile one source file to a vector of {:name name :node node} definitions."
  [path ns]
  (reduce
    (fn [acc form] (into acc (compile-top-form form ns path)))
    []
    (read-file-forms path)))

(defn stamp-def-name
  "Stamp a compiled def node with the SOURCE name of its real function. The
   compiler lowers a named `fn` to a self-application scaffold — `(let [fnself
   (fn [fnself] (fn name [args] body))] (fnself fnself))` — so the def's name
   belongs to the body of the scaffold's fn, not to the scaffold. Stamping the
   real fn is what lets the emitter attribute a call site to `name/arity`; a
   node that is not that shape is returned unchanged."
  [node nm]
  (cond
    (not (erlang/is_map node)) node
    (= :fn (:op node)) (assoc node :src-name nm)
    ; Multi-arity and variadic defs are a $blfn dispatch tuple. Each map value
    ; is its own self-application scaffold and must inherit the ONE source
    ; definition name; the optional variadic slot has the same shape.
    (= :tuple (:op node))
      (let [elems (:elems node)
            head (first elems)
            fixed (second elems)]
        (if (and (= :lit (:op head)) (= "$blfn" (str (:val head)))
                 (= :map (:op fixed)))
          (assoc node :elems
            (list head
              (assoc fixed :pairs
                (map (fn [pair] [(first pair) (stamp-def-name (second pair) nm)])
                     (:pairs fixed)))
              (stamp-def-name (nth elems 2) nm)))
          (if (and (= :lit (:op head)) (erlang/is_integer (:val head))
                   (= :let (:op fixed)))
            (assoc node :elems (list head (stamp-def-name fixed nm)))
            node)))
    (= :let (:op node))
      (let [init (:init node)]
        (if (and (erlang/is_map init) (= :fn (:op init)))
          (let [cl (first (:clauses init))
                b (:body cl)]
            (if (and (erlang/is_map b) (= :fn (:op b)))
              (assoc node :init
                     (assoc init :clauses
                            (cons (assoc cl :body (assoc b :src-name nm))
                                  (rest (:clauses init)))))
              node))
          node))
    :else node))

(defn emit-init
  "The bundle's `__init` generator: one `H.def` per compiled definition. It is
   a generator rather than straight-line code because a single-arity `fn`
   compiles to the compiler's self-application scaffold, whose value needs the
   machine to be applied."
  [defs]
  (let [lines (mapcat
                (fn [d]
                  (let [r (emit (stamp-def-name (:node d) (str (:name d))) {:tail false})
                        t (fresh-tmp)]
                    (concat (:lines r)
                            (list (str "const " t " = " (:val r) ";"))
                            (list (str "H.def(rt, " (js-str (str "js/" (:name d))) ", " t ");")))))
                defs)]
    (str "H.def(rt, \"js/__init\", H.blFn(\"__init\", new Map([[0, function*(rt, args) {\n"
         (apply str lines)
         "return null;\n"
         "}]]), null));")))

(defn alias-lines []
  (concat
    (map (fn [k] (str "H.defAlias(rt, " (js-str k) ", "
                      (js-str (str "js/" (get remote-map k))) ");"))
         (keys remote-map))
    (map (fn [k] (str "H.defAlias(rt, " (js-str (str "core/" k)) ", "
                      (js-str (str "js/" (get core-map k))) ");"))
         (keys core-map))))

(defn compile-one [src]
  (BeamLisp.Ns.Compiler/compile (BeamLisp.Ns.Reader/read_one src)
                                (BeamLisp.Ns.Compiler/new_env "js")))

(defn compile-and-audit [src]
  (let [node (compile-one src)]
    (emit node {:tail false})
    (audit! (refs-of [node]) {})
    node))

(defn expect-refusal [label thunk]
  (let [r (try (do (thunk) :no-throw) (catch e :threw))]
    (if (= r :threw)
      (do (println (str "NEGATIVE OK   " label)) 0)
      (do (println (str "NEGATIVE FAIL " label " — the backend accepted it")) 1))))

(defn expect-diagnostic [src text]
  (let [message (try (do (compile-and-audit src) "accepted")
                    (catch e (ex-message e)))]
    (if (String/contains? message text)
      (do (println (str "DIAGNOSTIC OK " text)) 0)
      (throw (ex-info (str "expected diagnostic " text ", got " message) {})))))

(defn expect-accept [label src]
  (let [r (try (do (compile-and-audit src) :ok) (catch e (ex-message e)))]
    (if (= r :ok)
      (do (println (str "POSITIVE OK   " label)) 0)
      (do (println (str "POSITIVE FAIL " label " — " r)) 1))))

(defn positive-tests
  "The `:try` shapes this backend must LOWER. Refusing `:try` used to be the
   only semantics-preserving answer; now that the scope is a real JavaScript
   try/catch/finally inside the generator, the audit that used to guard the
   whole form guards its INSIDE instead (see negative-tests), and these check
   that the accepted surface really lowers."
  []
  (loop [thunks (list
                  (fn [] (expect-accept "canonical rt/not_ lowers through the actor prelude"
                                        "(fn [x] (not x))"))
                  (fn [] (expect-accept "try with a catch lowers"
                                        "(fn [] (try 1 (catch e e)))"))
                  (fn [] (expect-accept "try with a finalizer lowers"
                                        "(fn [] (try 1 (finally 2)))"))
                  (fn [] (expect-accept "try/catch/finally lowers"
                                        "(fn [] (try (throw {:a 1}) (catch e (:a (ex-data e))) (finally nil)))"))
                  (fn [] (expect-accept "a receive in the body and the finalizer lowers"
                                        "(fn [] (try (receive x x) (finally (receive y y))))"))
                  (fn [] (expect-accept "a typed catch lowers"
                                        "(fn [] (try 1 (catch BeamLisp.ExInfo e (ex-data e))))"))
                  ; exact integers: an unsafe literal is a BigInt, not refused
                  (fn [] (expect-accept "an unsafe integer literal is emitted exact"
                                        "(fn [] (+ 9007199254740992 1))")))
         fails 0]
    (if (empty? thunks)
      fails
      (recur (rest thunks) (+ fails ((first thunks)))))))

(defn negative-tests
  "The other half of the ABI contract: things the backend must REFUSE, checked
   at build time so a regression is a failed build, not a silent widening. The
   `:try` cases here are ABI violations INSIDE a try — the audit walks the
   protected body, the handler and the finalizer like any other node, so a try
   is not a hole in the allowlist."
  []
  (loop [thunks (list
                  (fn [] (compile-and-audit "(fn [] (try (File/read! \"/tmp/x\") (catch e 2)))"))
                  (fn [] (compile-and-audit "(fn [] (try 1 (catch e (erlang/no_such_bif 1 2))))"))
                  (fn [] (compile-and-audit "(fn [] (try 1 (finally (totally-unknown-name 1))))"))
                  (fn [] (compile-and-audit "(fn [] (File/read! \"/tmp/x\"))"))
                  (fn [] (compile-and-audit "(fn [] (totally-unknown-name 1))"))
                  (fn [] (audit! [[:global "js" "not-defined"]] {}))
                  (fn [] (compile-and-audit "(fn [] (case 1 [a b] (+ a b) 0))"))
                  (fn [] (compile-and-audit "(fn [] (erlang/no_such_bif 1 2))"))
                  (fn [] (compile-and-audit "(fn [] (case [1 2] [a b] (+ a b) :no))")))
         labels (list
                  "an unknown remote inside a try body is refused"
                  "an unknown erlang bif inside a catch handler is refused"
                  "an unresolved global inside a finalizer is refused"
                  "an unknown remote module is refused"
                  "an unresolved global is refused"
                  "a hand-built unresolved global ref is refused"
                  "an unresolved global nested in a value is refused"
                  "an unknown erlang bif is refused"
                  "the earlier missed shape (vector subject, vector binder pattern) is refused")
         fails 0]
    (if (empty? thunks)
      fails
      (recur (rest thunks) (rest labels)
             (+ fails (expect-refusal (first labels) (first thunks)))))))

; ─────────────────────────────────────────────────────────────────────────────
; Numeric-gate emission tests
;
; Each check emits one ANF node (or one compiled form) and inspects the emitted
; text for the DECISION: a raw JS operator plus its witness, or the checked
; `H.arith`. The forged-declaration cases are the load-bearing ones: a numeric
; fact the emitter cannot re-derive must never widen the emitted operator.
; ─────────────────────────────────────────────────────────────────────────────

(defn lowering-refuses
  "Compile a `proc/defserver` source that must be REFUSED, and check that the
   diagnostic says why. A clause this target does not render must never
   compile: its handler would simply never run, and a server that silently
   ignores a clause is worse than one that fails to build."
  [label src text]
  (let [message (try (do (compile-top-form (BeamLisp.Ns.Reader/read_one src)
                                           "js" "<lowering-test>")
                         "accepted")
                     (catch e (ex-message e)))]
    (if (String/contains? message text)
      (do (println (str "DIAGNOSTIC OK " label)) 0)
      (do (println (str "DIAGNOSTIC FAIL " label " — " message)) 1))))

(defn lowering-accepts
  "Compile a `proc/defserver` source that must LOWER, and check how many
   definitions it contributes — an entry defn and one server loop."
  [label src n]
  (let [got (try (count (compile-top-form (BeamLisp.Ns.Reader/read_one src)
                                          "js" "<lowering-test>"))
                 (catch e (ex-message e)))]
    (if (= got n)
      (do (println (str "POSITIVE OK   " label)) 0)
      (do (println (str "POSITIVE FAIL " label " — " (pr-str got) " definitions")) 1))))

(defn defserver-tests
  "The lowering's own contract: which declarations build, and why the others do
   not. Every refusal names the reason, because the alternative — a clause that
   compiles and never runs — is the failure mode a server cannot afford."
  []
  (loop [thunks (list
                  (fn [] (lowering-accepts
                           "a defserver lowers to an entry defn plus one loop"
                           (str "(proc/defserver srv"
                                " (init [_] (ok {:n 0}))"
                                " (handle-call :a [_ st] (reply st st))"
                                " (handle-cast :b [st] (noreply st))"
                                " (handle-info :c [st] (noreply st)))")
                           2))
                  (fn [] (lowering-refuses
                           "a clause head this loop has no arm for is refused"
                           (str "(proc/defserver srv"
                                " (init [_] (ok {}))"
                                " (handle-info :c [st] (noreply st))"
                                " (handle-continue :x [st] (noreply st)))")
                           "unknown clause"))
                  (fn [] (lowering-refuses
                           "a contributed clause with no target vocabulary is refused"
                           (str "(proc/defserver srv"
                                " (init [_] (ok {}))"
                                " (registry (keys :id))"
                                " (handle-info :c [st] (noreply st)))")
                           "unknown clause"))
                  (fn [] (lowering-refuses
                           "reply outside handle-call is a declaration error"
                           (str "(proc/defserver srv"
                                " (init [_] (ok {}))"
                                " (handle-info :c [st] (reply 1 st)))")
                           "reply is only meaningful inside handle-call"))
                  (fn [] (lowering-refuses
                           "a server with no arm has no loop to lower"
                           "(proc/defserver srv (init [_] (ok {})))"
                           "at least one")))
         fails 0]
    (if (empty? thunks)
      fails
      (recur (rest thunks) (erlang/+ fails ((first thunks)))))))

(defn defsupervisor-tests
  "The tree lowering's own contract: which declarations build, and why the
   others do not. A POOL is refused BY NAME — the gap is stated, never papered
   over by starting a pool as something it is not."
  []
  (loop [thunks (list
                  (fn [] (lowering-accepts
                           "a defsupervisor lowers to one spec constructor"
                           (str "(proc.super/defsupervisor tree"
                                " (strategy :one-for-one)"
                                " (intensity 3 5000)"
                                " (child :a worker 1)"
                                " (child :b worker 2 {:restart :transient}))")
                           1))
                  (fn [] (lowering-refuses
                           "an unknown tree clause is refused"
                           (str "(proc.super/defsupervisor tree"
                                " (strategy :one-for-one)"
                                " (supervise :x))")
                           "unknown clause"))
                  (fn [] (lowering-refuses
                           "an unknown strategy is refused"
                           "(proc.super/defsupervisor tree (strategy :one-for-none))"
                           "unknown strategy"))
                  (fn [] (lowering-refuses
                           "a zero-second intensity window is refused"
                           "(proc.super/defsupervisor tree (intensity 3 0))"
                           "window-ms"))
                  (fn [] (lowering-refuses
                           "a duplicate child id is refused"
                           (str "(proc.super/defsupervisor tree"
                                " (child :a worker 1) (child :a worker 2))")
                           "declared twice"))
                  (fn [] (lowering-refuses
                           "a pool child is refused by name, not silently lowered"
                           (str "(proc.super/defsupervisor tree"
                                " (child :w (pool worker 4)))")
                           "not implemented on this target")))
         fails 0]
    (if (empty? thunks)
      fails
      (recur (rest thunks) (erlang/+ fails ((first thunks)))))))

(defn emit-text
  "All JS text one `emit` call produced, statements and value — what the test
   asserts against."
  [node ctx]
  (let [r (emit node ctx)
        v (:val r)]
    (apply str (if (nil? v) (:lines r) (concat (:lines r) (list v))))))

(defn an-lit [v] {:op :lit :val v :ann {}})
(defn an-var [n] {:op :var :name n :ann {}})

(defn an-arith
  ([f args] (an-arith f args {}))
  ([f args ann]
   {:op :arith :fun f
    :bif (get {:add :+ :sub :- :mul :* :rem :rem} f)
    :args (to-list args) :ann ann}))

(defn num-gate-check [label ok]
  (if ok
    (do (println (str "GATE OK   " label)) 0)
    (do (println (str "GATE FAIL " label)) 1)))

(defn raw? [t] (String/contains? t "js-actors:num-witness"))
(defn checked? [t] (String/contains? t "H.arith("))

(defn numeric-gate-tests
  "The gate's focused assurance, as emitter output. A `:raw` decision must carry
   a discharged witness; anything unproven must keep the checked host operator."
  []
  (loop [thunks
          (list
            (fn [] (num-gate-check "literal (+ 1 2) folds to a witnessed raw add"
                     (let [t (emit-text (an-arith :add (list (an-lit 1) (an-lit 2))) {:tail false})]
                       (and (raw? t) (String/contains? t "range=[3,3]")
                            (String/contains? t "ops=[add]")
                            (String/contains? t "leaves=[1,2]")
                            (not (checked? t))))))
            (fn [] (num-gate-check "a nested literal product folds with its interval"
                     (let [t (emit-text (an-arith :mul (list (an-arith :add (list (an-lit 1) (an-lit 2)))
                                                            (an-lit 3)))
                                        {:tail false})]
                       (and (raw? t) (String/contains? t "range=[9,9]")
                            (String/contains? t "ops=[add,mul]")
                            (String/contains? t "leaves=[1,2,3]")))))
            (fn [] (num-gate-check "a sum at the safe boundary (+ 9007199254740991 0) folds"
                     (let [t (emit-text (an-arith :add (list (an-lit num-safe-max) (an-lit 0)))
                                        {:tail false})]
                       (and (raw? t) (String/contains? t "range=[9007199254740991,9007199254740991]")))))
            (fn [] (num-gate-check "an overflowing literal sum keeps H.arith"
                     (let [t (emit-text (an-arith :add (list (an-lit num-safe-max) (an-lit 1)))
                                        {:tail false})]
                       (and (checked? t) (not (raw? t))))))
            (fn [] (num-gate-check "an overflowing intermediate keeps H.arith"
                     (let [t (emit-text (an-arith :add
                                                  (list (an-arith :mul (list (an-lit num-safe-max) (an-lit 2)))
                                                        (an-lit 1)))
                                        {:tail false})]
                       (and (checked? t) (not (raw? t))))))
            (fn [] (num-gate-check "a float operand keeps H.arith (1.0 is not an integer)"
                     (let [t (emit-text (an-arith :add (list (an-lit 1) (an-lit 1.0))) {:tail false})]
                       (and (checked? t) (not (raw? t))))))
            (fn [] (num-gate-check "division and comparison stay checked"
                     (let [t1 (emit-text (an-arith :div (list (an-lit 8) (an-lit 2))) {:tail false})
                           t2 (emit-text (an-arith :lt (list (an-lit 1) (an-lit 2))) {:tail false})]
                       (and (String/contains? t1 "H.arith(\"div\"") (not (raw? t1))
                            (String/contains? t2 "H.arith(\"lt\"") (not (raw? t2))))))
            (fn [] (num-gate-check "a literal rem with a nonzero divisor folds"
                     (let [t (emit-text (an-arith :rem (list (an-lit 7) (an-lit 3))) {:tail false})]
                       (and (raw? t) (String/contains? t "range=[-2,2]")
                            (String/contains? t " % ")))))
            (fn [] (num-gate-check "a literal rem by zero keeps H.arith"
                     (let [t (emit-text (an-arith :rem (list (an-lit 7) (an-lit 0))) {:tail false})]
                       (and (checked? t) (not (raw? t))))))
            (fn [] (num-gate-check "a remainder interval spanning zero keeps the outer check"
                     (let [t (emit-text (an-arith :rem
                                          (list (an-lit 7)
                                                (an-arith :rem (list (an-lit 4) (an-lit 2)))))
                                        {:tail false})]
                       (and (String/contains? t "H.arith(\"rem\"")
                            (String/contains? t "js-actors:num-witness")
                            (= :checked (:decision (num-evidence
                                      (an-arith :rem
                                        (list (an-lit 7)
                                              (an-arith :rem (list (an-lit 4) (an-lit 2)))))
                                      {})))))))
            (fn [] (num-gate-check "an unproven variable operand keeps H.arith"
                     (let [t (emit-text (an-arith :add (list (an-var "x_1") (an-lit 1))) {:tail false})]
                       (and (checked? t) (not (raw? t))))))
            (fn [] (num-gate-check "a forged :ann range on an unprovable node keeps H.arith"
                     (let [t (emit-text (an-arith :add (list (an-var "x_1") (an-lit 1))
                                                  {:num {:cat :int :range [0 1]
                                                         :witness {:kind :literals :ops [] :leaves []}}})
                                        {:tail false})]
                       (and (checked? t) (not (raw? t))))))
            (fn [] (num-gate-check "a conflicting :ann range fails closed even on a literal node"
                     (let [t (emit-text (an-arith :add (list (an-lit 1) (an-lit 2))
                                                  {:num {:cat :int :range [0 1]
                                                         :witness {:kind :literals :ops [:add] :leaves [1 2]}}})
                                        {:tail false})]
                       (and (checked? t) (not (raw? t))
                            (String/contains? t "H.arith(\"add\"")))))
            (fn [] (num-gate-check "a discharged :ann fact still authorizes the raw path"
                     (let [t (emit-text (an-arith :add (list (an-lit 1) (an-lit 2))
                                                  {:num {:cat :int :range [3 3]
                                                         :witness {:kind :literals :ops [:add] :leaves [1 2]}}})
                                        {:tail false})]
                       (and (raw? t) (String/contains? t "range=[3,3]")))))
            (fn [] (num-gate-check "real source: a literal sum emits a witnessed raw add"
                     (let [t (emit-text (compile-one "(fn [] (+ 1 2))") {:tail false})]
                       (and (raw? t) (String/contains? t "range=[3,3]")
                            (not (String/contains? t "H.arith(\"add\""))))))
            (fn [] (num-gate-check "real source: a literal let binding carries into the body"
                     (let [t (emit-text (compile-one "(fn [] (let [a 5] (+ a 1)))") {:tail false})]
                       (and (raw? t) (String/contains? t "range=[6,6]")
                            (String/contains? t "leaves=[5,1]")
                            (not (checked? t))))))
            (fn [] (num-gate-check "real source: a let of an unknown var keeps H.arith"
                     (let [t (emit-text (compile-one "(fn [n] (let [a n] (+ a 1)))") {:tail false})]
                       (and (String/contains? t "H.arith(\"add\"") (not (raw? t))))))
            (fn [] (num-gate-check "real source: a branch on an unknown param keeps H.arith"
                     (let [t (emit-text (compile-one "(fn [n] (if (> n 0) (+ n 1) 0))") {:tail false})]
                       (and (String/contains? t "H.arith(\"add\"") (not (raw? t))))))
            (fn [] (num-gate-check "real source: a mixed float sum keeps H.arith"
                     (let [t (emit-text (compile-one "(fn [] (+ 1 1.0))") {:tail false})]
                       (and (checked? t) (not (raw? t))))))
            (fn [] (num-gate-check "real source: nested let bindings chain their proven ranges"
                     (let [t (emit-text (compile-one "(fn [] (let [a 5] (let [b (+ a 1)] (* b 2))))")
                                        {:tail false})]
                       (and (raw? t) (String/contains? t "range=[12,12]")
                            (String/contains? t "leaves=[5,1,2]")))))
            (fn [] (num-gate-check "real source: a loop variable stays checked"
                     (let [t (emit-text (compile-one "(fn [n] (loop [i n] (if (> i 0) (recur (- i 1)) i)))")
                                        {:tail false})]
                       (and (String/contains? t "H.arith(\"sub\"") (not (raw? t))))))
            (fn [] (num-gate-check "a fn param shadowing a proven let name is checked"
                     (let [inner {:op :fn
                                  :clauses [{:pats [{:pop :pvar :name "a_1"}]
                                             :guard nil
                                             :body (an-arith :add (list (an-var "a_1") (an-lit 1)))
                                             :ann {}}]
                                  :ann {}}
                           t (emit-text inner
                                        {:tail false
                                         :ranges {"a_1" {:cat :int :range [5 5]
                                                         :leaves [5] :ops []}}})]
                       (and (checked? t) (not (raw? t))))))
            (fn [] (num-gate-check "a case pattern binder shadowing a proven let name is checked"
                     (let [inner {:op :case
                                  :subj (an-var "s_1")
                                  :clauses [{:pats [{:pop :pvar :name "a_1"}]
                                             :guard nil
                                             :body (an-arith :add (list (an-var "a_1") (an-lit 1)))
                                             :ann {}}]
                                  :ann {}}
                           t (emit-text inner
                                        {:tail false
                                         :ranges {"a_1" {:cat :int :range [5 5]
                                                         :leaves [5] :ops []}}})]
                       (and (checked? t) (not (raw? t)))))))
         fails 0]
    (if (empty? thunks)
      fails
      (recur (rest thunks) (erlang/+ fails ((first thunks)))))))

(defn readable? [path]
  (try (do (File/read! path) true) (catch e false)))

(defn resolve-dir
  "Find the directory holding runtime.bl. The documented invocation runs from
   the worktree root (`bl run research/js-actors/compiler.bl`), but running
   from inside the prototype directory is just as reasonable — so try the
   argument, then the root-relative default, then the current directory, and
   report the argument unchanged if none of them hold the sources."
  [dir]
  (loop [cs (list dir "research/js-actors" ".")]
    (if (empty? cs)
      dir
      (if (readable? (str (first cs) "/runtime.bl"))
        (first cs)
        (recur (rest cs))))))

(defn write-bundle!
  "Audit `defs` against the checked ABI and write them as ONE bundle
   `out/<output>` plus its numeric-gate report. `sources` only labels the
   header. Every bundle — the fixed demos and both halves of a split app — is
   written here, so there is one emitter, one audit and one report shape."
  [dir output sources defs]
   ; JS temporaries are scoped to one bundle: its text then depends only on
   ; its definitions, never on which bundles this run built first.
   (erlang/put :js-actors-tmp 0)
   (let [out-dir (str dir "/out")
        defined (reduce (fn [m d] (assoc m (:name d) true)) {} defs)
        refs (refs-of (map (fn [d] (:node d)) defs))
        _ (audit! refs defined)
        nrem (count (filter (fn [r] (= (nth r 0) :remote)) refs))
        nglob (count (filter (fn [r] (= (nth r 0) :global)) refs))
        _ (num-sites-reset!)
        js (str "// GENERATED by research/js-actors/compiler.bl — do not edit.\n"
                "// Sources: " (join-str sources " ") "\n"
                "import * as H from \"../host.mjs\";\n\n"
                "for (const name of " (arglist-js (map js-str (to-list host-names))) ") {\n"
                "  if (!H.hostNames().includes(name)) throw new Error('missing host leaf: ' + name);\n}\n"
                "for (const name of " (arglist-js (map js-str (to-list erlang-names))) ") {\n"
                "  if (!H.erlangNames().includes(name)) throw new Error('missing erlang leaf: ' + name);\n}\n"
                "const rt = H.newRuntime();\n\n"
                (emit-init defs) "\n"
                "await H.init(rt);\n\n"
                (apply str (map (fn [l] (str l "\n")) (alias-lines)))
                "\nH.def(rt, \"js/entry\", H.ref(rt, \"js\", \"main\"));\n"
                "await H.boot(rt);\n")
        sites (num-sites)
        raw (count (filter (fn [s] (= :raw (:decision s))) sites))
        checked (erlang/- (count sites) raw)]
    (File/mkdir_p! out-dir)
    (File/write! (str out-dir "/" output) js)
    (File/write! (str out-dir "/numeric-gate." output ".json")
                 (num-report-json output sites))
    (println (str "js-actors: compiled " (count defs) " definitions from "
                  (count sources) " sources -> " out-dir "/" output))
    (println (str "js-actors: " (count refs) " host references audited ("
                  nrem " remote, " nglob " global) against the allowlist"))
    (println (str "js-actors: numeric gate — " raw " raw-Number site(s) with witness, "
                  checked " checked H.arith site(s) -> " out-dir "/numeric-gate." output ".json"))
    {:defs (count defs) :bytes (erlang/byte_size js)}))

(defn build-one
  "Compile one bundle from the shared runtime, any EXTRA sources, then the
   bundle's APP. The default arity is the original two-source bundle; the
   four-argument form lets an app share a core — the demo bundle compiles
   `runtime + quoted-view-core + quoted-view`. Every source is read, compiled
   and audited BEFORE anything is emitted, so a definition in a core is
   visible to the app that uses it and the allowlist audit sees the whole
   bundle."
  ([dir app output] (build-one dir app output []))
  ([dir app output extras]
   (let [sources (into [(str dir "/runtime.bl")]
                       (concat (map (fn [extra] (str dir "/" extra)) extras)
                               [(str dir "/" app)]))
         ; one bundle = one compilation unit: ANF local names start over
         _ (BeamLisp.Ns.Compiler/reset-fresh!)
         defs (reduce (fn [acc p] (concat acc (compile-source p "js"))) [] sources)]
     (write-bundle! dir output sources defs))))

; The FIRST build-time auto-placement candidate is deliberately smaller than
; "pure BL": a closed chain of nullary defns whose bodies are a literal string
; or a direct local nullary call. It cannot capture a secret, perform dynamic
; dispatch or consume unproved numeric input. Three existing oracles must agree:
; codebase's qualified dependency cone, system.analyze's all-clause summary,
; and THIS emitter's own lowering + ABI audit. No parallel JS allowlist.
(defn portable-nullary-form? [form reached]
  (let [items (n-items form)]
    (and (= 4 (count items))
         (let [params (nth items 2)
               body (nth items 3)]
           (and (= :vector (n-tag params)) (empty? (n-items params))
                (or (and (erlang/is_binary (n-unwrap body))
                         (<= (erlang/byte_size (n-unwrap body)) 64)
                         (every? (fn [byte] (and (<= 32 byte) (<= byte 126)))
                                 (erlang/binary_to_list (n-unwrap body))))
                    (and (= :list (n-tag body))
                         (= 1 (count (n-items body)))
                         (let [callee (first (n-items body))]
                           (and (= :symbol (n-tag callee))
                                (contains? reached (str "js/" (n-name callee))))))))))))

(defn portable-helper-verdict [path root]
  (try
    (let [src (File/read! path)
          facts (cb/index-source {} "js" src)
          conn (cb/connect-codebase)
          _ (datom/transact! conn (concat (:fn facts) (:calls facts) (:instr facts) (:requires facts)))
          cone (cb/dependency-cone (datom/db conn) (str "js/" root))
          reached (set (:reached cone))
          summaries (an/analyze src)
          forms (read-file-forms path)
          members (filter (fn [f] (and (defn-form? f)
                                        (contains? reached (str "js/" (defn-name f))))) forms)
          defs (compile-source path "js")
          emitted (filter (fn [d] (contains? reached (str "js/" (:name d)))) defs)
          defined (reduce (fn [m d] (assoc m (:name d) true)) {} emitted)]
      (cond
        (> (erlang/byte_size src) 4096)
          {:eligible false :reason :oversized-source}
        (not (:root-defined cone))
          {:eligible false :reason :missing-root}
        (not (:complete cone))
          {:eligible false :reason :unresolved-dependency :calls (:calls cone)}
        (not (= (count reached) (count members)))
          {:eligible false :reason :missing-definition :reached (:reached cone)}
        (not (every? (fn [f] (portable-nullary-form? f reached)) members))
          {:eligible false :reason :unsupported-form :reached (:reached cone)}
        (not (every? (fn [f]
                       (let [s (get summaries (defn-name f))]
                         (and (= {} (:footprint s)) (= true (:terminates s))
                              (= #{:string} (:returns s))))) members))
          {:eligible false :reason :unproved-purity-or-sort :reached (:reached cone)}
        :else
          (try
            (do
              (doseq [d emitted] (emit (:node d) {:tail false}))
              (audit! (refs-of (map :node emitted)) defined)
              {:eligible true :root root :reached (:reached cone)
               :sort :string :input :none :wire :none :evidence [:qualified-cone :all-clauses :js-abi]})
            (catch e {:eligible false :reason :abi-refused :detail (ex-message e)}))))
    (catch e {:eligible false :reason :analysis-failed :detail (ex-message e)})))

(defn portable-helper-tests [dir]
  (let [path (str dir "/portable-helper.bl")
        admitted (portable-helper-verdict path "view-label")
        effect (portable-helper-verdict path "main")
        missing (portable-helper-verdict path "does-not-exist")
        negative (str dir "/portable-helper-refusals.bl")
        secret (portable-helper-verdict negative "secret")
        dynamic (portable-helper-verdict negative "runtime-call")
        later (portable-helper-verdict negative "later")
        unknown (portable-helper-verdict negative "unknown")
        nonascii (portable-helper-verdict negative "nonascii")]
    (when-not (and (= true (:eligible admitted))
                   (= #{"js/view-label" "js/label"} (set (:reached admitted)))
                   (= :string (:sort admitted))
                   (= :none (:input admitted))
                   (= false (:eligible effect))
                   (= false (:eligible missing))
                   (every? (fn [r] (= false (:eligible r)))
                           [secret dynamic later unknown nonascii])
                   (= :unsupported-form (:reason nonascii)))
      (throw (ex-info "portable-helper gate did not fail closed"
                      {:admitted admitted :effect effect :missing missing
                       :secret secret :dynamic dynamic :later later
                       :unknown unknown :nonascii nonascii})))
    (println (str "PORTABLE HELPER PASS " (pr-str admitted)
                  " | effect " (:reason effect) " | missing " (:reason missing)))))

; ═════════════════════════════════════════════════════════════════════════════
; `split/defapp` — ONE BL file, three artifacts
;
; An app file is ordinary `defn`s plus ONE declaration:
;
;   (split/defapp NAME
;     {:wire    {type-name spec …}          ; the closed wire grammar (split-wire.bl)
;      :server  {:init f :snapshot type :private [f …]}
;      :client  {:init f :view f :on f}
;      :intents {op {:params {k spec} :check f :guard f :apply f} …}})
;
; The build DERIVES where every function runs:
;
;   client roots  :client :init/:view/:on and every intent :check
;   server roots  :server :init and every intent :check/:guard/:apply
;
; A function is in a half iff a root of that half reaches it through the
; emitter's own ANF references (calls AND function values). Each half is then
; emitted as its OWN bundle containing only its closure, so a server-only
; function — and every literal inside it — is absent from the browser bundle by
; construction, not by convention.
;
; A function may be in the CLIENT half only if it is PORTABLE, and portability
; needs three independent oracles to agree, per function:
;
;   graph    `codebase/dependency-cone` — no dynamic call, no host/interop
;            call, the defn is indexed (its body is certifiable)
;   effects  `system.analyze` — footprint {} and terminates, over every clause
;   abi      this emitter's ANF — no `host/…` leaf, no process/output verb, no
;            receive, no call of a computed function value, nothing outside
;            the checked ABI — including inside every lambda
;
; plus the app's own word: a `:private` function is server-only data. A
; function that fails any of these is not portable, and neither is anything
; that reaches it. A client root whose closure holds a non-portable function
; REFUSES THE BUILD, naming the path from the root to the offending site.
;
; The server half needs no portability (it is the authority), only the ABI
; audit every bundle gets. Both halves are compiled with the same generated
; glue: the contract as BL data, its digest, and one dispatcher per role, so
; a shell never names an app function and an app never names a shell one.
; ═════════════════════════════════════════════════════════════════════════════

; Shell sources, relative to the research dir. This backend builds the
; BROWSER half only: the server half is the app's own namespace running
; natively on BEAM under priv/lib/split (split.core, split.web). The wire
; grammar is the one library file both halves load (priv/lib/split/wire.bl):
; the authority requires it as `split.wire`, and its defns are compiled into
; the browser half here, so `wire-ok?` has one source.
(def split-wire-source "../../priv/lib/split/wire.bl")
(def split-client-shell [split-wire-source "split-client.bl"])

(def client-pure-core
  "The core-map globals client code may reach: value functions only. The rest
   of `core-map` — output, the process and supervisor verbs — is an effect."
  #{"str" "not" "list" "vector" "hash-map" "nil?" "some?" "not=" "inc" "dec"
    "keyword" "name" "ex-info" "ex-data" "ex-message" "ex-original"
    "boolean?" "assoc" "compare" "<" ">" "<=" ">=" "="
    "identity" "odd?" "even?" "pos?" "neg?" "zero?" "empty?" "count" "first" "+" "*" "-" "max" "min"
    "keyword?" "string?" "int?"})

(defn split-refuse [reason message data]
  (throw (ex-info (str "split: " message) (assoc data :split-refusal reason))))

(defn defapp-form? [n]
  (and (= :list (n-tag n))
       (let [its (n-items n)]
         (and (not (empty? its)) (form-sym? (first its) "split/defapp")))))

(defn form-line [n]
  (let [p (n-pos n)] (if (erlang/is_map p) (get p :line) nil)))

(defn defn-arities
  "The fixed arities a defn form declares (docstring and attr-map skipped)."
  [form]
  (let [its (rest (rest (n-items form)))
        its (if (and (not (empty? its)) (erlang/is_binary (n-unwrap (first its))) (not (empty? (rest its))))
              (rest its) its)
        its (if (and (not (empty? its)) (= :map (n-tag (first its))) (not (empty? (rest its))))
              (rest its) its)]
    (if (= :vector (n-tag (first its)))
      #{(count (n-items (first its)))}
      (set (map (fn [cl] (count (n-items (first (n-items cl))))) its)))))

; ── the declaration ─────────────────────────────────────────────────────────────────

(defn wire-name-ok? [k]
  (and (keyword? k)
       (let [s (name k)]
         (and (<= 1 (count s)) (<= (count s) 32)
              (every? (fn [c] (or (and (<= 97 c) (<= c 122)) (and (<= 48 c) (<= c 57)) (= c 45) (= c 63)))
                      (erlang/binary_to_list s))
              (let [c0 (first (erlang/binary_to_list s))] (and (<= 97 c0) (<= c0 122)))))))

(defn small-int? [v lo hi] (and (int? v) (<= lo v) (<= v hi)))

(defn wire-spec-problem
  "Why `spec` is not a well-formed wire type under `types`, or nil. Closed:
   only the grammar split-wire.bl implements is admitted.

   A named type may be RECURSIVE (an outline item holds a list of items), but
   only through a `[:list max T]`: the empty list ends every such value, so a
   finite value always exists and every value is a finite tree. A cycle with no
   list on it (`:a` is a record whose field is `:a`) has no finite value at
   all and is refused. `seen` maps each named type being expanded to the
   number of lists entered before it; `lists` is the count now.

   A type whose NON-recursive nesting already exceeds `wire-max-depth`
   (split-wire.bl) has no value the wire accepts, so it is refused here rather
   than admitted and then never publishable. `depth` counts the lists and
   records around `spec` on the path being checked."
  ([types spec seen] (wire-spec-problem types spec (reduce (fn [m k] (assoc m k 0)) {} seen) 0 0))
  ([types spec seen lists depth]
  (cond
    (and (vector? spec) (contains? #{:list :record} (first spec)) (< (wire/wire-max-depth) (inc depth)))
      (str "wire type nests deeper than " (wire/wire-max-depth) " lists and records")
    (= spec :bool) nil
    (= spec :exact) nil
    (keyword? spec)
      (cond
        (not (contains? types spec)) (str "unknown wire type " spec)
        (contains? seen spec)
          (if (< (get seen spec) lists) nil
            (str "cyclic wire type " spec " (a recursive type must recur through a [:list max T])"))
        :else (wire-spec-problem types (get types spec) (assoc seen spec lists) lists depth))
    (not (vector? spec)) (str "not a wire type: " (pr-str spec))
    (= (first spec) :text)
      (if (and (= 3 (count spec)) (small-int? (nth spec 1) 0 4096) (small-int? (nth spec 2) (nth spec 1) 4096))
        nil (str "[:text min max] needs 0 <= min <= max <= 4096, got " (pr-str spec)))
    (= (first spec) :int)
      (if (and (= 3 (count spec)) (small-int? (nth spec 1) num-safe-min num-safe-max)
               (small-int? (nth spec 2) (nth spec 1) num-safe-max))
        nil (str "[:int min max] needs safe integers with min <= max, got " (pr-str spec)))
    (= (first spec) :one-of)
      (let [ks (vec (rest spec))]
        (cond
          (empty? ks) "[:one-of k …] needs at least one keyword"
          (< 64 (count ks)) "[:one-of k …] allows at most 64 keywords"
          (not (every? wire-name-ok? ks)) (str "[:one-of k …] needs lower-case keywords, got " (pr-str spec))
          (not (= (count ks) (count (distinct ks)))) (str "[:one-of k …] repeats a keyword: " (pr-str spec))
          :else nil))
    (= (first spec) :list)
      (if (and (= 3 (count spec)) (small-int? (nth spec 1) 0 1024))
        (wire-spec-problem types (nth spec 2) seen (inc lists) (inc depth))
        (str "[:list max T] needs 0 <= max <= 1024, got " (pr-str spec)))
    (= (first spec) :record)
      (let [fields (if (= 2 (count spec)) (nth spec 1) nil)]
        (cond
          (not (map? fields)) (str "[:record {k T}] needs a field map, got " (pr-str spec))
          (< 32 (count fields)) "a record has at most 32 fields"
          :else (reduce (fn [p k] (or p (if (wire-name-ok? k) (wire-spec-problem types (get fields k) seen lists (inc depth))
                                           (str "bad record key " (pr-str k)))))
                        nil (sort-by name (keys fields)))))
    :else (str "unknown wire type tag " (pr-str (first spec))))))

(defn fn-ref
  "Resolve a declaration slot to a defn name, checking it exists and has the
   arity its role calls it with."
  [defns slot sym arity]
  (let [n (if (symbol? sym) (str sym) nil)
        form (get defns n)]
    (cond
      (nil? n) (split-refuse :bad-declaration (str slot " must name a defn, got " (pr-str sym)) {:slot slot})
      (nil? form) (split-refuse :unknown-function (str slot " names " n ", which this file does not define")
                                {:slot slot :name n})
      (not (contains? (defn-arities form) arity))
        (split-refuse :arity-mismatch (str slot " " n " is called with " arity " argument(s)")
                      {:slot slot :name n :arity arity})
      :else n)))

(defn read-defapp
  "The declaration as a normalized plan fragment, or a refusal."
  [form defns]
  (let [its (n-items form)
        _ (when-not (= 3 (count its))
            (split-refuse :bad-declaration "(split/defapp name {…}) takes a name and one map" {}))
        app-name (str (node->data (nth its 1)))
        d (node->data (nth its 2))
        _ (when-not (map? d) (split-refuse :bad-declaration "the defapp body must be a map" {}))
        wire (get d :wire)
        server (get d :server)
        client (get d :client)
        intents (get d :intents)
        _ (when-not (and (map? wire) (map? server) (map? client) (map? intents))
            (split-refuse :bad-declaration "defapp needs :wire, :server, :client and :intents maps" {}))
        _ (doseq [k (keys wire)]
            (when (or (not (wire-name-ok? k)) (contains? #{:bool :exact :text :int :list :record :one-of} k))
              (split-refuse :bad-wire (str "bad wire type name " (pr-str k)) {:type k}))
            (let [p (wire-spec-problem wire (get wire k) #{k})]
              (when p (split-refuse :bad-wire (str "wire type " (name k) ": " p) {:type k}))))
        snapshot (get server :snapshot)
        _ (when-not (and (keyword? snapshot) (contains? wire snapshot))
            (split-refuse :bad-wire ":server :snapshot must name a :wire type" {}))
        private (set (map (fn [s] (let [f (get defns (str s))]
                                    (fn-ref defns ":server :private" s
                                            (if (nil? f) 0 (first (defn-arities f))))))
                          (or (get server :private) [])))
        ops (sort-by name (keys intents))
        norm (mapv (fn [op]
                     (let [i (get intents op)
                           params (get i :params)]
                       (when-not (wire-name-ok? op)
                         (split-refuse :bad-declaration (str "bad intent name " (pr-str op)) {}))
                       (when-not (map? params)
                         (split-refuse :bad-wire (str "intent " (name op) " needs a :params map") {}))
                       (let [p (wire-spec-problem wire [:record params] #{})]
                         (when p (split-refuse :bad-wire (str "intent " (name op) ": " p) {:intent op})))
                       {:op op :params params
                        :check (fn-ref defns (str "intent " (name op) " :check") (get i :check) 2)
                        :guard (if (nil? (get i :guard)) nil
                                 (fn-ref defns (str "intent " (name op) " :guard") (get i :guard) 2))
                        ; :apply may take the signed-in person as a third argument
                        :apply (let [f (get defns (str (get i :apply)))
                                     ar (if (and (some? f) (contains? (defn-arities f) 3)) 3 2)]
                                 (fn-ref defns (str "intent " (name op) " :apply") (get i :apply) ar))
                        :apply-arity (let [f (get defns (str (get i :apply)))]
                                       (if (and (some? f) (contains? (defn-arities f) 3)) 3 2))
                        ; may THIS person do it? [who board args] → nil | reason
                        :allow (if (nil? (get i :allow)) nil
                                 (fn-ref defns (str "intent " (name op) " :allow") (get i :allow) 3))
                        ; one line for the activity feed: [board args] → text
                        :says (if (nil? (get i :says)) nil
                                (fn-ref defns (str "intent " (name op) " :says") (get i :says) 2))
                        ; the board the browser expects, shown before the
                        ; server answers: a CLIENT root, so it must be portable
                        :predict (if (nil? (get i :predict)) nil
                                   (fn-ref defns (str "intent " (name op) " :predict") (get i :predict) 2))
                        ; when the prediction counts as right (default `=`)
                        :agrees (if (nil? (get i :agrees?)) nil
                                  (fn-ref defns (str "intent " (name op) " :agrees?") (get i :agrees?) 2))}))
                   ops)]
    (when (and (some? (get server :history)) (not (small-int? (get server :history) 1 500)))
      (split-refuse :bad-declaration ":server :history keeps 1..500 past states" {}))
    (when (and (some? (get server :history)) (some (fn [op] (contains? #{:undo :redo} op)) ops))
      (split-refuse :reserved-name "an app with :history gets :undo and :redo; it may not declare them" {}))
    (when (and (some? (get server :undo-allow)) (nil? (get server :history)))
      (split-refuse :bad-declaration ":server :undo-allow needs :history" {}))
    {:name app-name :wire wire :snapshot snapshot :private private
     :people (if (nil? (get server :people)) nil (fn-ref defns ":server :people" (get server :people) 0))
     :history (or (get server :history) 0)
     :undo-allow (if (nil? (get server :undo-allow)) nil
                   (fn-ref defns ":server :undo-allow" (get server :undo-allow) 2))
     :server-init (fn-ref defns ":server :init" (get server :init) 0)
     :client-init (fn-ref defns ":client :init" (get client :init) 0)
     :view (fn-ref defns ":client :view" (get client :view) 3)
     :on (fn-ref defns ":client :on" (get client :on) 2)
     :intents norm}))

; ── the three oracles ────────────────────────────────────────────────────────────────

(defn anf-line [x]
  (let [a (get x :ann)] (if (erlang/is_map a) (get a :line) nil)))

(defn anf-facts
  "Every reference an ANF tree makes, with the nearest source line: remotes,
   globals, receives, and calls of a COMPUTED function value (`RT/invoke` of a
   local or `RT/apply_to`). Walks every nested lambda."
  [x line acc]
  (cond
    (erlang/is_map x)
      (let [l (or (anf-line x) line)
            op (get x :op)
            acc2 (cond
                   (= op :remote)
                     (let [m (get x :mod) f (get x :fun) a0 (first (get x :args))]
                       (cond
                         (and (= m mod-rt) (= f :invoke) (erlang/is_map a0) (= :var (get a0 :op)))
                           (conj acc {:kind :dynamic-call :line l})
                         (and (= m mod-rt) (= f :apply_to))
                           (conj acc {:kind :dynamic-call :line l})
                         :else (conj acc {:kind :remote :mod m :fun f :line l})))
                   (= op :global) (conj acc {:kind :global :name (get x :name) :line l})
                   (= op :recv) (conj acc {:kind :receive :line l})
                   :else acc)]
        ; raw `maps/get`: see `walk-refs` — a BL vector is an Erlang map
        (reduce (fn [a k] (anf-facts (maps/get k x) l a)) acc2 (maps/keys x)))
    (erlang/is_list x) (reduce (fn [a y] (anf-facts y line a)) acc x)
    (erlang/is_tuple x) (reduce (fn [a y] (anf-facts y line a)) acc (erlang/tuple_to_list x))
    :else acc))

; ── function values: closure flow ──────────────────────────────────────────────────────
;
; Client code may create, store, compose and call function values freely —
; `(comp not :done)`, `(partial owned-by? me)`, predicates chosen from data, a
; function that returns a function that calls the ones it was given — because
; the build computes WHICH functions every call can reach and refuses the app
; when the resulting call graph has a cycle it cannot prove finite.
;
; The analysis is a whole-app closure-flow analysis (0-CFA):
;
;   abstract values   [:def g]    a named app function
;                     [:lam id]   a `fn` written at one site (every closure it
;                                 creates)
;                     [:rt site]  a closure a runtime combinator (`comp`,
;                                 `partial`, `juxt`, `complement`,
;                                 `constantly`) returned at one call site,
;                                 with the values it captured
;   flows             a set per local, a return set per function, and ONE heap
;                     set H: a function value stored in data (a literal, a
;                     runtime argument that is not called, a rest list) joins
;                     H, and anything read out of data (a lookup, a runtime
;                     result, a destructured part) may be any member of H
;   the shell         calls every root with the board, the local state and the
;                     sync record: a root's parameters may hold anything in H,
;                     and whatever a root returns joins H
;
; The runtime is not analyzed internally. Each runtime function carries a
; model DERIVED from its compiled body (`runtime-value-model`): which argument
; positions it calls, which a closure it returns calls later, and whether it
; calls a function it found inside data (then it may call anything in H). A
; runtime function terminates whenever every function it calls does: its own
; recursion is structural over finite data — the trusted base.
;
; Every call site adds edges from the calling node (a def, a lambda or a
; combinator closure) to every value it may call. With no cycle, every client
; call terminates by induction on the graph (loops carry the analyzer's own
; proof). A cycle is recursion: admitted only when `structural-cycle` proves it
; descends into its own data, else refused as `:recursive`, naming the cycle.

(defn anf-map? [x] (and (erlang/is_map x) (maps/is_key :op x)))
(defn anf-op [x] (if (anf-map? x) (maps/get :op x) nil))
(defn anf-get [x k] (maps/get k x nil))

(defn anf-cons-items [n]
  (loop [n n acc []]
    (if (= :cons (anf-op n)) (recur (anf-get n :tail) (conj acc (anf-get n :head))) acc)))

(defn scaffold-kind
  "`:fn` for the self-application scaffold every `fn` compiles to, `:loop` for a
   loop's, nil for any other node. Its let BODY is the knot `(self self)`."
  [x]
  (if (and (= :let (anf-op x)) (= :fn (anf-op (anf-get x :init))))
    (let [nm (str (anf-get x :name))]
      (cond (String/starts_with? nm "fnself") :fn
            (String/starts_with? nm "loop_") :loop
            :else nil))
    nil))

(defn arg-var
  "The local a node names, or nil (a literal, a global, …)."
  [a]
  (if (= :var (anf-op a)) (anf-get a :name) nil))

(defn blfn-tuple?
  "Is `x` the `$blfn` dispatch tuple a multi-arity or `& rest` fn compiles to?"
  [x]
  (and (= :tuple (anf-op x))
       (let [h (first (anf-get x :elems))]
         (and (= :lit (anf-op h)) (= "$blfn" (str (anf-get h :val)))))))

(defn clause-info [self cl variadic]
  {:self self
   :params (mapv (fn [p] (if (= :pvar (maps/get :pop p nil)) (maps/get :name p) nil)) (anf-get cl :pats))
   ; the binders of a destructuring parameter pattern: parts read out of data
   :binders (vec (mapcat (fn [p] (if (= :pvar (maps/get :pop p nil)) [] (pat-binder-names p))) (anf-get cl :pats)))
   :variadic variadic
   :guard (anf-get cl :guard)
   :body (anf-get cl :body)})

(defn scaffold-clause-infos [sc variadic]
  (let [inner (anf-get (first (anf-get (anf-get sc :init) :clauses)) :body)]
    (mapv (fn [cl] (clause-info (anf-get sc :name) cl variadic)) (anf-get inner :clauses))))

(defn fn-value-clauses
  "The clauses of a function VALUE node — a self scaffold, or every scaffold of
   a `$blfn` tuple (fixed arities, then the `& rest` slot) — or nil when `x` is
   not a function value. A variadic clause's last parameter is its rest list."
  [x]
  (cond
    (= :fn (scaffold-kind x)) (scaffold-clause-infos x false)
    (blfn-tuple? x)
      (let [els (vec (anf-get x :elems))
            var (nth els 2)]
        (vec (concat (mapcat (fn [pair] (scaffold-clause-infos (second pair) false)) (anf-get (nth els 1) :pairs))
                     (if (= :tuple (anf-op var))
                       (scaffold-clause-infos (second (vec (anf-get var :elems))) true)
                       []))))
    :else nil))

; ── the runtime model ─────────────────────────────────────────────────────────────────────

(def rtm-top
  "The model of a runtime function the gate knows nothing about: it may call
   anything, now or later, and return anything it was given."
  {:calls #{} :captures #{} :data-calls true :closure-data-calls true :returns-closure true :returns-all true})

(defn rt-model-at
  "The model of runtime function `nm` called with `n` arguments, or nil."
  [models nm n]
  (let [es (get models nm)]
    (or (first (filter (fn [e] (and (not (:variadic e)) (= n (:arity e)))) es))
        (first (filter (fn [e] (and (:variadic e) (<= (dec (:arity e)) n))) es)))))

(defn rtm-add [m k v] (update m k (fn [s] (conj (or s #{}) v))))

(defn rtm-mark
  "Parameter `pos` is called: now, or — inside a closure the function may
   return — later."
  [m ctx pos]
  (if (:deferred ctx) (assoc (rtm-add m :captures pos) :returns-closure true) (rtm-add m :calls pos)))

(defn rtm-flag
  "A function found inside data is called, now or later."
  [m ctx]
  (if (:deferred ctx) (assoc m :closure-data-calls true :returns-closure true) (assoc m :data-calls true)))

(declare rtm-walk)

(defn rtm-lambda
  "Walk a lambda written in a runtime body. `deferred`: it is not handed
   straight to a position that calls it, so it may outlive the call."
  [x ctx m models deferred]
  (let [c2 (assoc ctx :deferred (or deferred (:deferred ctx)))]
    (reduce (fn [m cl] (rtm-walk (:body cl) c2 m models)) m (fn-value-clauses x))))

(defn rtm-lam-of
  "The lambda node an argument denotes: written inline, or a let-bound local."
  [ctx a]
  (if (some? (fn-value-clauses a)) a (get (:lams ctx) (arg-var a))))

(defn rtm-call
  "Apply callee model `cm` to the actual argument nodes of one call."
  [actuals cm ctx m models]
  (let [m (if (:data-calls cm) (rtm-flag m ctx) m)
        m (if (:closure-data-calls cm) (assoc m :closure-data-calls true :returns-closure true) m)
        m (if (:returns-closure cm) (assoc m :returns-closure true) m)]
    (reduce (fn [m j]
              (let [a (nth actuals j)
                    now (contains? (:calls cm) j)
                    later (contains? (:captures cm) j)
                    p (get (:params ctx) (arg-var a))
                    lam (rtm-lam-of ctx a)]
                (cond
                  (some? p) (let [m (if now (rtm-mark m ctx p) m)]
                              (if later (assoc (rtm-add m :captures p) :returns-closure true) m))
                  (some? lam) (let [m (if now (rtm-lambda lam ctx m models false) m)]
                                (if later (rtm-lambda lam ctx m models true) m))
                  ; a called position fed by anything else: a value out of data
                  (and (or now later) (not (contains? #{:global :lit :enil} (anf-op a))))
                    (rtm-walk a ctx (if later (assoc m :closure-data-calls true :returns-closure true) (rtm-flag m ctx)) models)
                  :else (rtm-walk a ctx m models))))
            m (range (count actuals)))))

(defn rtm-occurrences
  "How local `v` is used under `x`: :callee (called), :arg (handed to a
   runtime function, which its model accounts for), or :escape (anything else:
   returned, stored, passed to a host leaf)."
  [x v acc]
  (cond
    (erlang/is_list x) (reduce (fn [acc y] (rtm-occurrences y v acc)) acc x)
    (vector? x) (reduce (fn [acc y] (rtm-occurrences y v acc)) acc (seq x))
    (erlang/is_tuple x) (reduce (fn [acc y] (rtm-occurrences y v acc)) acc (erlang/tuple_to_list x))
    (not (anf-map? x)) acc
    (= v (arg-var x)) (conj acc :escape)
    (and (= :remote (anf-op x)) (= mod-rt (anf-get x :mod)) (= :invoke (anf-get x :fun)))
      (let [args (vec (anf-get x :args)) callee (first args) actuals (anf-cons-items (second args))]
        (reduce (fn [acc a] (if (= v (arg-var a))
                              (conj acc (if (= :global (anf-op callee)) :arg :escape))
                              (rtm-occurrences a v acc)))
                (if (= v (arg-var callee)) (conj acc :callee) (rtm-occurrences callee v acc))
                actuals))
    :else (reduce (fn [acc k] (if (= k :ann) acc (rtm-occurrences (maps/get k x) v acc))) acc (maps/keys x))))

(def calling-host-leaves
  "Host leaves that CALL a function value they are handed (`make-frames`
   resolves and starts it; `run-turn` runs a frame stack a function started).
   Everything reaching one is modeled as called — now and from data."
  #{"make-frames" "run-turn"})

(def inert-host-leaves
  "Host leaves whose result can never BE or HOLD one of their arguments: they
   test, measure or read a scalar. A value handed to one does not escape."
  #{"is-kw" "is-cons" "is-enil" "is-list" "is-tup" "tup-size" "is-struct" "struct-mod" "is-vec"
    "vec-size" "is-set" "is-map" "map-size" "eq" "identical" "lt" "is-nil" "is-int" "is-float"
    "is-num" "is-str" "is-bool" "is-fn" "to-str" "describe" "arith" "str-cat" "str-size" "str-codepoints"
    "str-slice" "str-cmp" "truthy" "kw-name" "is-table" "map-keys"})

(defn rtm-uses
  "Where parameter `v` goes under `x`: :callee (called), [:arg name n j]
   (handed as argument j of n to runtime function `name`; `:self` for the
   function's own recursion), or :escape (anything else \u2014 returned, stored in
   data, handed to a host leaf that can return it)."
  [x v selfs acc]
  (cond
    (erlang/is_list x) (reduce (fn [acc y] (rtm-uses y v selfs acc)) acc x)
    (vector? x) (reduce (fn [acc y] (rtm-uses y v selfs acc)) acc (seq x))
    (erlang/is_tuple x) (reduce (fn [acc y] (rtm-uses y v selfs acc)) acc (erlang/tuple_to_list x))
    (not (anf-map? x)) acc
    (= v (arg-var x)) (conj acc :escape)
    (and (= :remote (anf-op x)) (= mod-rt (anf-get x :mod)) (= :invoke (anf-get x :fun)))
      (let [args (vec (anf-get x :args)) callee (first args) actuals (anf-cons-items (second args)) n (count actuals)
            self? (and (= :apply (anf-op callee)) (contains? selfs (arg-var (anf-get callee :fn))))]
        (reduce (fn [acc j]
                  (let [a (nth actuals j)]
                    (if (= v (arg-var a))
                      (conj acc (cond self? [:self n j]
                                      (= :global (anf-op callee)) [:arg (str (anf-get callee :name)) n j]
                                      :else :escape))
                      (rtm-uses a v selfs acc))))
                (cond (= v (arg-var callee)) (conj acc :callee)
                      self? acc
                      :else (rtm-uses callee v selfs acc))
                (range n)))
    ; an inert host leaf: its argument cannot come back out
    (and (= :remote (anf-op x)) (= mod-host (anf-get x :mod)) (contains? inert-host-leaves (str (anf-get x :fun))))
      (reduce (fn [acc a] (if (= v (arg-var a)) acc (rtm-uses a v selfs acc))) acc (vec (anf-get x :args)))
    ; a core name the compiler linked
    (and (= :remote (anf-op x)) (contains? remote-map (remote-key (anf-get x :mod) (anf-get x :fun))))
      (let [args (vec (anf-get x :args)) n (count args) nm (get remote-map (remote-key (anf-get x :mod) (anf-get x :fun)))]
        (reduce (fn [acc j] (let [a (nth args j)] (if (= v (arg-var a)) (conj acc [:arg nm n j]) (rtm-uses a v selfs acc))))
                acc (range n)))
    ; an `if` test is consumed, not returned
    (= :if (anf-op x))
      (let [t (anf-get x :test)
            acc (if (= v (arg-var t)) acc (rtm-uses t v selfs acc))]
        (rtm-uses (anf-get x :else) v selfs (rtm-uses (anf-get x :then) v selfs acc)))
    ; a let binding that renames `v` hands everything to the new name
    (and (= :let (anf-op x)) (= v (arg-var (anf-get x :init))))
      (let [inner (rtm-uses (anf-get x :body) (anf-get x :name) selfs #{})]
        (rtm-uses (anf-get x :body) v selfs (into acc inner)))
    ; `do`: only the last statement is the value
    (= :do (anf-op x))
      (let [st (vec (anf-get x :stmts))]
        (reduce (fn [acc i] (let [y (nth st i)]
                              (if (and (< i (dec (count st))) (= v (arg-var y))) acc (rtm-uses y v selfs acc))))
                acc (range (count st))))
    :else (reduce (fn [acc k] (if (= k :ann) acc (rtm-uses (maps/get k x) v selfs acc))) acc (maps/keys x))))

(defn rtm-returns
  "The parameter positions of clause `cl` whose value the call may RETURN (or
   store in the data it returns): a position that escapes, or that is handed
   to a runtime function in a position IT returns. A least fixpoint: a
   runtime function not yet modeled returns nothing so far (`rt-names`); a
   name outside the runtime returns everything."
  [cl models rt-names nm-self]
  (let [ps (:params cl)]
    (set (filter (fn [i]
                   (let [p (nth ps i)]
                     (or (nil? p)
                         (some (fn [u]
                                 (or (= u :escape)
                                     ; the function's own recursion: it returns what its
                                     ; next round returns (a least fixpoint)
                                     (and (vector? u) (= :self (first u))
                                          (contains? (or (:returns (rt-model-at models nm-self (nth u 1))) #{}) (nth u 2)))
                                     (and (vector? u) (= :arg (first u))
                                          (let [nm (if (contains? rt-names (nth u 1)) (nth u 1) (get core-map (nth u 1)))
                                                cm (rt-model-at models nm (nth u 2))]
                                            (cond
                                              (some? cm) (or (:returns-all cm) (contains? (or (:returns cm) #{}) (nth u 3)))
                                              (contains? rt-names nm) false
                                              :else true)))))
                               (rtm-uses (:body cl) p #{(:self cl)} #{})))))
                 (range (count ps))))))

(defn rtm-walk
  "One runtime clause's call behaviour, accumulated into model `m`."
  [x ctx m models]
  (cond
    (erlang/is_list x) (reduce (fn [m y] (rtm-walk y ctx m models)) m x)
    (vector? x) (reduce (fn [m y] (rtm-walk y ctx m models)) m (seq x))
    (erlang/is_tuple x) (reduce (fn [m y] (rtm-walk y ctx m models)) m (erlang/tuple_to_list x))
    (not (anf-map? x)) m
    ; a lambda written in place and not bound: it is returned or stored
    (some? (fn-value-clauses x)) (rtm-lambda x ctx m models true)
    ; a let-bound lambda: accounted where it is called or handed on, and as a
    ; returned closure only if it escapes
    (and (= :let (anf-op x)) (some? (fn-value-clauses (anf-get x :init))))
      (let [v (anf-get x :name) lam (anf-get x :init)
            uses (rtm-occurrences (anf-get x :body) v #{})
            m (rtm-walk (anf-get x :body) (assoc ctx :lams (assoc (:lams ctx) v lam)) m models)]
        (if (contains? uses :escape) (rtm-lambda lam ctx m models true) m))
    (= :remote (anf-op x))
      (let [mo (anf-get x :mod) f (anf-get x :fun) args (vec (anf-get x :args))]
        (cond
          (and (= mo mod-rt) (= f :invoke))
            (let [callee (first args) actuals (anf-cons-items (second args)) cop (anf-op callee)]
              (cond
                (= cop :global) (let [nm (str (anf-get callee :name))
                                      cm (or (rt-model-at models nm (count actuals))
                                             (rt-model-at models (get core-map nm) (count actuals)))]
                                  (if (some? cm) (rtm-call actuals cm ctx m models)
                                    (rtm-call actuals (if (empty? models) {:calls #{} :captures #{}} rtm-top) ctx m models)))
                (= cop :lit) (rtm-walk actuals ctx m models)
                (and (= cop :apply) (contains? (:selfs ctx) (arg-var (anf-get callee :fn))))
                  (rtm-call actuals (or (rt-model-at models (:name ctx) (count actuals)) {:calls #{} :captures #{}}) ctx m models)
                (contains? (:params ctx) (arg-var callee))
                  (rtm-walk actuals ctx (rtm-mark m ctx (get (:params ctx) (arg-var callee))) models)
                (some? (get (:lams ctx) (arg-var callee)))
                  (rtm-walk actuals ctx (rtm-lambda (get (:lams ctx) (arg-var callee)) ctx m models false) models)
                :else (rtm-walk actuals ctx (rtm-walk callee ctx (rtm-flag m ctx) models) models)))
          (and (= mo mod-rt) (contains? #{:apply_to :apply_variadic} f))
            (let [p (get (:params ctx) (arg-var (first args)))
                  lam (get (:lams ctx) (arg-var (first args)))]
              (rtm-walk (vec (rest args)) ctx
                        (cond (some? p) (rtm-mark m ctx p)
                              (some? lam) (rtm-lambda lam ctx m models false)
                              :else (rtm-flag m ctx))
                        models))
          ; a core name the compiler linked: through its runtime model
          (contains? remote-map (remote-key mo f))
            (rtm-call args (or (rt-model-at models (get remote-map (remote-key mo f)) (count args))
                               (if (empty? models) {:calls #{} :captures #{}} rtm-top))
                      ctx m models)
          ; a host leaf that calls what it is handed: fail closed
          (and (= mo mod-host) (contains? calling-host-leaves (str f)))
            (let [m (rtm-flag m ctx)
                  m (reduce (fn [m a] (let [p (get (:params ctx) (arg-var a))] (if (some? p) (rtm-mark m ctx p) m))) m args)]
              (reduce (fn [m a] (let [lam (rtm-lam-of ctx a)] (if (some? lam) (rtm-lambda lam ctx m models false) (rtm-walk a ctx m models))))
                      m args))
          ; a host leaf: a lambda or a function handed to one is stored
          :else (reduce (fn [m a]
                          (let [lam (rtm-lam-of ctx a)]
                            (if (some? lam) (rtm-lambda lam ctx m models true) (rtm-walk a ctx m models))))
                        m args)))
    (= :apply (anf-op x))
      (let [g (anf-get x :fn)]
        (cond
          (= :loop (scaffold-kind g))
            (rtm-walk (anf-get x :args) ctx (reduce (fn [m cl] (rtm-walk (:body cl) ctx m models)) m (scaffold-clause-infos g false)) models)
          ; a recur, or the knot `(self self)`: control
          (or (= :apply (anf-op g)) (contains? (:selfs ctx) (arg-var g))) (rtm-walk (anf-get x :args) ctx m models)
          (contains? (:params ctx) (arg-var g)) (rtm-walk (anf-get x :args) ctx (rtm-mark m ctx (get (:params ctx) (arg-var g))) models)
          (some? (get (:lams ctx) (arg-var g))) (rtm-walk (anf-get x :args) ctx (rtm-lambda (get (:lams ctx) (arg-var g)) ctx m models false) models)
          :else (rtm-walk (anf-get x :args) ctx (rtm-walk g ctx (rtm-flag m ctx) models) models)))
    :else (reduce (fn [m k] (if (= k :ann) m (rtm-walk (maps/get k x) ctx m models))) m (maps/keys x))))

(defn runtime-value-model
  "{rt-name [{:arity :variadic :calls #{pos} :captures #{pos} :data-calls
   :closure-data-calls :returns-closure} …]} for every runtime.bl definition,
   DERIVED from its compiled body — a fixpoint over the runtime's own calls.
   Unconverged, every function is modeled as calling anything (fail closed).
   Memoized per build."
  [dir]
  (let [memo (erlang/get :js-actors-rt-model)]
    (if (map? memo)
      memo
      (let [defs (compile-source (str dir "/runtime.bl") "js")
            clauses (vec (mapcat (fn [d] (map (fn [cl] [(str (:name d)) cl]) (or (fn-value-clauses (:node d)) []))) defs))
            rt-names (set (map (fn [d] (str (:name d))) defs))
            step (fn [models]
                   (reduce (fn [acc [nm cl]]
                             (let [ps (:params cl)
                                   ctx {:params (reduce (fn [m i] (if (some? (nth ps i)) (assoc m (nth ps i) i) m)) {} (range (count ps)))
                                        :deferred false :selfs #{(:self cl)} :name nm :lams {}}
                                   m (rtm-walk (:body cl) ctx
                                               {:arity (count ps) :variadic (:variadic cl) :calls #{} :captures #{}
                                                :data-calls false :closure-data-calls false :returns-closure false
                                                :returns (rtm-returns cl models rt-names nm)}
                                               models)]
                               (assoc acc nm (conj (get acc nm []) m))))
                           {} clauses))
            table (loop [models (step {}) n 0]
                    (let [next (step models)]
                      (cond
                        (= next models) models
                        (> n 40) (reduce (fn [acc k] (assoc acc k (mapv (fn [e] (merge e (dissoc rtm-top :calls :captures) {:returns-all true})) (get next k))))
                                         {} (keys next))
                        :else (recur next (inc n)))))]
        (erlang/put :js-actors-rt-model table)
        table))))

; ── the flow solver ───────────────────────────────────────────────────────────────────────

(defn av-F [st k] (get (:F st) k #{}))
(defn av-R [st k] (get (:R st) k #{}))
(defn av-addF [st k vs] (if (or (nil? k) (empty? vs)) st (assoc st :F (assoc (:F st) k (into (av-F st k) vs)))))
(defn av-addR [st k vs] (if (empty? vs) st (assoc st :R (assoc (:R st) k (into (av-R st k) vs)))))
(defn av-addH [st vs] (if (empty? vs) st (assoc st :H (into (:H st) vs))))
(defn av-join [vs] (reduce (fn [a v] (into a v)) #{} vs))
(defn av-edge
  "Record the call edge from -> to. `cap`: this call reaches `to` only through
   a value the calling closure CAPTURED (see `capture-order`)."
  [st from to cap]
  (let [st (assoc st :edges (assoc (:edges st) from (conj (get (:edges st) from #{}) to)))]
    (if cap st (assoc st :uncaptured (conj (:uncaptured st) [from to])))))

(defn av-clauses [st ctx target]
  (if (= :def (first target))
    (get (:defclauses ctx) (second target))
    (get-in st [:lams (second target) :clauses])))

(defn av-bind
  "Bind `clauses`' parameters for one call. `argfn` answers the value set of
   argument i; `nargs` nil means an unknown arity (every position gets it)."
  [st clauses argfn nargs]
  (reduce (fn [st cl]
            (let [ps (:params cl)
                  fixed (if (:variadic cl) (dec (count ps)) (count ps))
                  fits (or (nil? nargs) (if (:variadic cl) (<= fixed nargs) (= fixed nargs)))]
              (if (not fits)
                st
                (let [st (reduce (fn [st i] (av-addF st (nth ps i) (argfn i))) st (range fixed))
                      ; a rest list is data: what it carries joins H
                      st (if (:variadic cl)
                           (av-addH st (if (nil? nargs) (argfn fixed)
                                         (av-join (map argfn (range fixed (max fixed nargs))))))
                           st)]
                  (reduce (fn [st b] (av-addF st b (:H st))) st (:binders cl))))))
          st clauses))

(declare av-call-all)

(defn av-call
  "Call one abstract value. Answers [returns st]."
  [st ctx target argfn nargs]
  (let [st (av-edge st (:node ctx) target (:cap ctx))]
    (cond
      ; a runtime function called as a value: if its model calls ANYTHING, it
      ; may call any function it was given or finds in data
      (= :core (first target))
        (let [es (get (:models ctx) (get core-map (second target)) [rtm-top])
              calls? (some (fn [e] (or (not (empty? (:calls e))) (not (empty? (:captures e))) (:data-calls e)
                                       (:closure-data-calls e) (:returns-closure e)))
                           es)
              args (if (nil? nargs) (argfn 0) (av-join (map argfn (range nargs))))
              reachable (into args (:H st))
              ; another runtime value it may call is only an edge (the runtime
              ; itself is trusted); app functions and closures are called
              st (if calls? (reduce (fn [st t] (av-edge st target t false)) st (filter (fn [t] (= :core (first t))) reachable)) st)
              [rets st] (if calls?
                          (av-call-all st (assoc ctx :node target :cap false) (set (filter (fn [t] (not (= :core (first t)))) reachable))
                                       (fn [_] reachable) nil)
                          [#{} st])]
          [(-> rets (into args) (into (:H st))) st])
      (= :rt (first target))
      (let [site (second target)
            args (if (nil? nargs) (argfn 0) (av-join (map argfn (range nargs))))]
        [(av-R st target) (assoc-in st [:clo site :args] (into (get-in st [:clo site :args] #{}) args))])
      :else [(av-R st target) (av-bind st (av-clauses st ctx target) argfn nargs)])))

(defn av-call-all [st ctx targets argfn nargs]
  (reduce (fn [[rets st] t] (let [[r st] (av-call st ctx t argfn nargs)] [(into rets r) st]))
          [#{} st] (sort (vec targets))))

(defn av-fact [st ctx m]
  (assoc st :facts (conj (:facts st) (assoc m :from (:node ctx) :g (:g ctx) :measure (:measure ctx)
                                              :subs (:subs ctx) :line (:line ctx)))))

(defn captured-expr?
  "Does `a` denote a value the current CLOSURE captured — a free local of the
   lambda being walked, or a part read out of one? Such a value existed
   before the closure did."
  [ctx a]
  (let [op (anf-op a) args (vec (anf-get a :args))
        rt-name (fn [] (get remote-map (remote-key (anf-get a :mod) (anf-get a :fun))))]
    (cond
      (not (:lambda ctx)) false
      (= op :var) (let [v (anf-get a :name)] (not (or (contains? (:inner ctx) v) (contains? (:selfs ctx) v))))
      (and (= op :remote) (= mod-rt (anf-get a :mod)) (= :invoke (anf-get a :fun)) (= :lit (anf-op (first args))))
        (let [items (anf-cons-items (second args))] (and (= 1 (count items)) (captured-expr? ctx (first items))))
      (and (= op :remote) (contains? #{"rt-get" "rt-nth" "rt-first" "rt-second" "rt-last" "rt-get-in"} (rt-name)))
        (captured-expr? ctx (first args))
      :else false)))

(defn inert-arg?
  "An argument that can hold no function value at all: a literal. (A named
   function is NOT inert: it is not a captured value, so calling one is an
   ordinary edge, and two named functions reaching each other through a
   runtime function are a real cycle.)"
  [a]
  (contains? #{:lit :enil} (anf-op a)))

(defn av-mark-computes [st ctx targets]
  (if (empty? targets) st (assoc st :computes (conj (:computes st) (:owner ctx)))))

(declare av-walk)

(def no-guards {:nonempty #{} :truthy #{}})
(defn guard-join [a b] {:nonempty (into (:nonempty a) (:nonempty b)) :truthy (into (:truthy a) (:truthy b))
                        :exprs (into (or (:exprs a) #{}) (or (:exprs b) #{}))})

(defn av-walk-list
  "Walk nodes in order: [[value-set …] st]."
  [xs ctx st]
  (reduce (fn [[acc st] y] (let [[v st] (av-walk y ctx st)] [(conj acc v) st])) [[] st] xs))

(defn av-invoke
  "A call with known positional arguments of every value in `targets`. `cap`:
   the callee is a captured value (a :computed call only)."
  [st ctx targets vs argnodes kind cap]
  (let [st (if (= kind :computed) (av-mark-computes st ctx targets) st)
        st (av-fact st ctx {:kind kind :to targets :args argnodes})
        [rets st] (av-call-all st (assoc ctx :cap cap) targets (fn [i] (nth vs i #{})) (count vs))]
    ; a computed callee may be DATA (a keyword or map), whose call reads its
    ; argument: the answer may be anything stored in data
    [(if (= kind :computed) (-> rets (into (:H st)) (into (av-join vs))) rets) st]))

(declare element-hofs)

(defn av-runtime
  "A call of runtime function `rtname`, through its derived model."
  [st ctx rtname argnodes]
  (let [[vs st] (av-walk-list argnodes ctx st)
        n (count argnodes)
        model (or (rt-model-at (:models ctx) rtname n) rtm-top)
        ; a variadic runtime function's rest position stands for every
        ; argument from there on
        spread (fn [pos] (if (and (:variadic model) (= pos (dec (:arity model)))) (range pos (max (inc pos) n)) [pos]))
        at (fn [pos] (av-join (map (fn [i] (nth vs i #{})) (filter (fn [i] (< i n)) (mapcat spread (sort (vec pos)))))))
        fnargs (av-join vs)
        active (set (mapcat spread (concat (:calls model) (:captures model))))
        passive (filter (fn [i] (not (contains? active i))) (range n))
        st (av-addH st (at passive))
        called (into (at (:calls model)) (if (:data-calls model) (into (:H st) fnargs) #{}))
        later (into (at (:captures model)) (if (:closure-data-calls model) (into (:H st) fnargs) #{}))
        written (av-join (map (fn [i] (if (or (some? (fn-value-clauses (nth argnodes i))) (= :global (anf-op (nth argnodes i))))
                                         (nth vs i) #{}))
                              (range n)))
        st (av-mark-computes st ctx (set (filter (fn [t] (not (contains? written t))) called)))
        ; what a called function receives: in general anything in data; for a
        ; known element-wise function (mapv, filterv, sort-by, …) exactly
        ; the ELEMENTS of its collection argument, i.e. anything in data unless
        ; the collection was written here without function values
        e (get-in element-hofs [rtname n])
        argset (-> (:H st) (into (at passive)) (into (av-join (map (fn [t] (av-R st t)) called))))
        st (av-fact st ctx {:kind :hof :rt rtname :to called :args argnodes :argvals vs})
        ; captured when every argument the runtime function may call from —
        ; its called positions, and ALL of them if it calls into data — is a
        ; captured value (or holds nothing newer)
        sources (if (:data-calls model) (range n) (filter (fn [i] (< i n)) (mapcat spread (sort (vec (:calls model))))))
        cap (and (:lambda ctx)
                 (every? (fn [i] (or (captured-expr? ctx (nth argnodes i)) (inert-arg? (nth argnodes i)))) sources))
        [rets st] (av-call-all st (assoc ctx :cap cap) called (fn [_] argset) nil)
        site (str (:owner ctx) "#" (:site st))
        st (assoc st :site (inc (:site st)))
        st (if (:returns-closure model)
             (assoc-in st [:clo site] {:called (into (get-in st [:clo site :called] #{}) later)
                                       :cap (not (:closure-data-calls model))
                                       :values (into (get-in st [:clo site :values] #{}) fnargs)
                                       :args (get-in st [:clo site :args] #{})
                                       :owner (:owner ctx) :rt rtname :line (:line ctx)})
             st)]
    [(-> (:H st)
         (into (if (:returns-all model) fnargs (at (or (:returns model) #{}))))
         (into rets)
         (into (if (:returns-closure model) #{[:rt site]} #{})))
     st]))

(defn anf-shape
  "A node without its source annotations: two reads of the same expression
   compare equal."
  [x]
  (cond
    (erlang/is_map x) (reduce (fn [m k] (if (= k :ann) m (assoc m k (anf-shape (maps/get k x))))) {} (maps/keys x))
    (erlang/is_list x) (mapv anf-shape x)
    (vector? x) (mapv anf-shape (seq x))
    :else x))

(defn lookup-expr?
  "A pure read of part of a value: a keyword lookup, get, nth, first, …"
  [x]
  (let [args (vec (anf-get x :args))]
    (and (= :remote (anf-op x))
         (or (and (= mod-rt (anf-get x :mod)) (= :invoke (anf-get x :fun)) (= :lit (anf-op (first args))))
             (contains? #{"rt-get" "rt-nth" "rt-first" "rt-second" "rt-last"}
                        (get remote-map (remote-key (anf-get x :mod) (anf-get x :fun))))))))

(defn guard-facts
  "What an `if` test proves on its `truth` branch: {:nonempty #{locals}
   :truthy #{locals} :exprs #{lookup shapes}}. A non-empty local is also
   truthy; a lookup expression tested truthy is non-nil wherever it is read
   again on that branch (the same pure read of the same, immutable value)."
  [t truth]
  (let [only (fn [x] (let [as (vec (anf-get x :args))] (if (= 1 (count as)) (arg-var (first as)) nil)))
        call? (fn [mo f] (and (= :remote (anf-op t)) (= mo (anf-get t :mod)) (= f (anf-get t :fun))))
        v (only t)
        ne (fn [x] {:nonempty #{x} :truthy #{x}})]
    (cond
      (and truth (= :var (anf-op t))) {:nonempty #{} :truthy #{(anf-get t :name)}}
      (and truth (lookup-expr? t)) {:nonempty #{} :truthy #{} :exprs #{(anf-shape t)}}
      (and (call? mod-core :some?) truth (lookup-expr? (first (anf-get t :args))))
        {:nonempty #{} :truthy #{} :exprs #{(anf-shape (first (anf-get t :args)))}}
      (and (call? mod-rt :seq) truth (some? v)) (ne v)
      (and (call? mod-rt :empty?) (not truth) (some? v)) (ne v)
      (and (call? mod-core :some?) truth (some? v)) {:nonempty #{} :truthy #{v}}
      (and (call? mod-core :nil?) (not truth) (some? v)) {:nonempty #{} :truthy #{v}}
      (and (call? mod-rt :invoke) (= :global (anf-op (first (anf-get t :args))))
           (= "not" (anf-get (first (anf-get t :args)) :name)))
        (let [items (anf-cons-items (second (vec (anf-get t :args))))]
          (if (= 1 (count items)) (guard-facts (first items) (not truth)) {:nonempty #{} :truthy #{}}))
      :else {:nonempty #{} :truthy #{}})))

; Measures. A value's SIZE counts every node of its data: a map entry counts
; as a node plus its key and value, so every read below yields a value no
; larger than its source — `seq` of a map (entry vectors) included. Relations
; of a local to a measure ROOT (a parameter of the node being analyzed):
;   :le    it is the root, or a no-larger view of it
;   :lt    a strict part of it (smaller)
;   :part  a lookup result: a strict part WHEN non-nil, else nil (a lookup
;          misses on anything, so `(:child nil)` is nil again — guarded by a
;          truthiness test it becomes :lt). Either way it is NO LARGER than
;          its source (nil is the smallest value), so around a cycle it counts
;          as :le: `(find-item (:kids it) id)` inside a walk over elements is
;          admitted by the element step, and `(defn f [x] (f (:k x)))`, whose
;          only edge is a :part, is still refused — it never strictly shrinks.

(defn rel-up
  "A read of a value related as `r`: a strict source stays strict, anything
   else becomes a :part."
  [rels]
  (reduce (fn [m k] (assoc m k (if (= :lt (get rels k)) :lt :part))) {} (keys rels)))

(defn rel-all [rels r] (reduce (fn [m k] (assoc m k r)) {} (keys rels)))

(defn sub-rel
  "How the value of `x` relates to the measure roots in scope: {root → rel}.
   `subs` holds what is known of each local; `g` the guard facts on this path.
   Only reads that cannot grow a value count."
  [x subs g]
  (let [op (anf-op x)
        args (vec (anf-get x :args))
        rt-name (fn [] (get remote-map (remote-key (anf-get x :mod) (anf-get x :fun))))
        of (fn [a] (sub-rel a subs g))
        nil-lit? (fn [a] (and (= :lit (anf-op a)) (nil? (anf-get a :val))))
        guarded (fn [r] (if (contains? (or (:exprs g) #{}) (anf-shape x))
                          (reduce (fn [m k] (assoc m k (if (= :part (get r k)) :lt (get r k)))) {} (keys r))
                          r))]
    (cond
      (= op :var)
        (let [v (anf-get x :name) r (get subs v {})]
          ; a lookup known non-nil here is a genuine part
          (if (or (contains? (:truthy g) v) (contains? (:nonempty g) v))
            (reduce (fn [m k] (assoc m k (if (= :part (get r k)) :lt (get r k)))) {} (keys r))
            r))
      (and (= op :remote) (= mod-rt (anf-get x :mod)) (= :invoke (anf-get x :fun))
           (= :lit (anf-op (first args))))
        ; a keyword lookup: a field of the record, or nil
        (let [items (anf-cons-items (second args))] (if (= 1 (count items)) (guarded (rel-up (of (first items)))) {}))
      ; `(nth coll i default)` may answer its default, which is no part of
      ; coll: only the one- and two-argument reads count
      (and (= op :remote) (or (and (contains? #{"rt-nth" "rt-first" "rt-second" "rt-last"} (rt-name))
                                   (<= (count args) 2))
                              (and (= "rt-get" (rt-name)) (or (= 2 (count args)) (nil-lit? (nth args 2 nil))))))
        (guarded (rel-up (of (first args))))
      (and (= op :remote) (contains? #{"rt-rest" "rt-next"} (rt-name)))
        (let [r (of (first args))]
          ; the rest of a NON-EMPTY sequence is strictly shorter; of anything
          ; else it is no longer than a part (`(rest nil)` is `()`)
          (if (contains? (:nonempty g) (arg-var (first args)))
            (rel-all r :lt)
            (reduce (fn [m k] (assoc m k (if (= :lt (get r k)) :lt :le))) {} (keys r))))
      (and (= op :remote) (contains? #{"rt-seq" "rt-vals"} (rt-name))) (of (first args))
      :else {})))

(def element-hofs
  "The runtime functions that call a function argument with ELEMENTS of a
   collection argument — {rt-name {arity {:fn i :coll j :params #{k}}}}: the
   function in position i is called with elements of the collection in
   position j as its parameters k. An element is a strict part of the
   collection that holds it. Checked by verify-flow.mjs against the runtime."
  (let [one (fn [ar fnpos coll ps] {ar {:fn fnpos :coll coll :params ps}})]
    {"rt-mapv" (one 2 0 1 #{0}) "rt-filterv" (one 2 0 1 #{0}) "rt-some" (one 2 0 1 #{0})
     "rt-every?" (one 2 0 1 #{0}) "rt-remove" (one 2 0 1 #{0}) "rt-keep" (one 2 0 1 #{0})
     "rt-mapcat" (one 2 0 1 #{0}) "rt-group-by" (one 2 0 1 #{0}) "core-not-any?" (one 2 0 1 #{0})
     "rt-reduce" (merge (one 2 0 1 #{1}) (one 3 0 2 #{1}))
     "rt-sort-by" (merge (one 2 0 1 #{0}) (one 3 0 2 #{0}))
     "rt-sort" (one 2 0 1 #{0 1})}))

(defn bound-in
  "Every local bound anywhere under `x`: let names, pattern variables, and the
   self names of nested functions and loops."
  [x acc]
  (cond
    (erlang/is_list x) (reduce (fn [a y] (bound-in y a)) acc x)
    (vector? x) (reduce (fn [a y] (bound-in y a)) acc (seq x))
    (erlang/is_tuple x) (reduce (fn [a y] (bound-in y a)) acc (erlang/tuple_to_list x))
    (and (erlang/is_map x) (= :pvar (maps/get :pop x nil))) (conj acc (maps/get :name x))
    (erlang/is_map x)
      (reduce (fn [a k] (if (= k :ann) a (bound-in (maps/get k x) a)))
              (if (= :let (maps/get :op x nil)) (conj acc (maps/get :name x)) acc)
              (maps/keys x))
    :else acc))

(defn av-lambda
  "A `fn` written here: register it, walk its clauses under its own node."
  [x clauses ctx st]
  (let [id (:self (first clauses))
        key [:lam id]
        line (or (anf-line x) (:line ctx))
        st (if (some? (get-in st [:lams id])) st
             (assoc-in st [:lams id] {:clauses clauses :owner (:owner ctx) :line line}))
        selfs (reduce (fn [m cl] (assoc m (:self cl) key)) (:selfs ctx) clauses)
        own (fn [cl] (reduce (fn [m p] (if (some? p) (assoc m p {p :le}) m)) (:subs ctx) (:params cl)))]
    [#{key}
     (reduce (fn [st cl]
               ; free locals keep their relation to the enclosing measure; the
               ; lambda's own parameters are measure candidates of their own
               (let [c2 (assoc ctx :node key :selfs selfs :g no-guards :line line :subs (own cl)
                                   :measure (:params cl) :lambda true
                                   :inner (-> (bound-in (:body cl) #{})
                                              (into (filter some? (:params cl)))
                                              (into (:binders cl))))
                     st (reduce (fn [st b] (av-addF st b (:H st))) st (:binders cl))
                     [_ st] (if (some? (:guard cl)) (av-walk (:guard cl) c2 st) [#{} st])
                     [v st] (av-walk (:body cl) c2 st)]
                 (av-addR st key v)))
             st clauses)]))

(defn av-with-sub
  "`ctx` knowing that let-bound `name` relates to the measure as `init` does."
  [ctx name init]
  (let [r (sub-rel init (:subs ctx) (:g ctx))]
    (if (empty? r) ctx (assoc ctx :subs (assoc (:subs ctx) name r)))))

(defn av-remote [x ctx st]
  (let [m (anf-get x :mod) f (anf-get x :fun) args (vec (anf-get x :args))]
    (cond
      (and (= m mod-rt) (= f :invoke))
        (let [callee (first args) actuals (anf-cons-items (second args)) cop (anf-op callee) g (anf-get callee :name)]
          (cond
            (and (= cop :global) (contains? (:local ctx) g))
              (let [[vs st] (av-walk-list actuals ctx st)] (av-invoke st ctx #{[:def g]} vs actuals :direct false))
            (and (= cop :global) (contains? core-map g)) (av-runtime st ctx (get core-map g) actuals)
            ; a keyword lookup reads data
            (= cop :lit) (let [[vs st] (av-walk-list actuals ctx st)] [(into (:H st) (av-join vs)) st])
            ; a call through the function's own name
            (and (= cop :apply) (contains? (:selfs ctx) (arg-var (anf-get callee :fn))))
              (let [[vs st] (av-walk-list actuals ctx st)]
                (av-invoke st ctx #{(get (:selfs ctx) (arg-var (anf-get callee :fn)))} vs actuals :direct false))
            :else (let [[targets st] (av-walk callee ctx st)
                        [vs st] (av-walk-list actuals ctx st)]
                    (av-invoke st ctx targets vs actuals :computed (captured-expr? ctx callee)))))
      (and (= m mod-rt) (= f :apply_to))
        (let [[targets st] (av-walk (first args) ctx st)
              [lv st] (av-walk (second args) ctx st)
              st (av-mark-computes st ctx targets)
              st (av-fact st ctx {:kind :computed :to targets :args []})]
          (av-call-all st (assoc ctx :cap (captured-expr? ctx (first args))) targets (fn [_] (into (:H st) lv)) nil))
      (contains? remote-map (remote-key m f)) (av-runtime st ctx (get remote-map (remote-key m f)) args)
      :else (let [[vs st] (av-walk-list args ctx st)] [(:H st) (av-addH st (av-join vs))]))))

(defn av-apply [x ctx st]
  (let [g (anf-get x :fn) args (vec (anf-get x :args))]
    (cond
      ; a loop: its body runs here, its vars start at the inits
      (= :loop (scaffold-kind g))
        (let [cl (first (scaffold-clause-infos g false))
              [ivs st] (av-walk-list args ctx st)
              ps (:params cl)
              st (reduce (fn [st i] (av-addF st (nth ps i) (nth ivs i #{}))) st (range (count ps)))]
          (av-walk (:body cl) (assoc ctx :loops (assoc (:loops ctx) (anf-get g :name) ps)) st))
      ; a recur: the loop vars take the new values
      (and (= :apply (anf-op g)) (contains? (:loops ctx) (arg-var (anf-get g :fn))))
        (let [ps (get (:loops ctx) (arg-var (anf-get g :fn)))
              [vs st] (av-walk-list args ctx st)]
          [#{} (reduce (fn [st i] (av-addF st (nth ps i nil) (nth vs i))) st (range (count vs)))])
      ; the knot `(self self)`: the function itself, as a value
      (contains? (:selfs ctx) (arg-var g)) [#{(get (:selfs ctx) (arg-var g))} st]
      :else (let [[targets st] (av-walk g ctx st)
                  [vs st] (av-walk-list args ctx st)]
              (av-invoke st ctx targets vs args :computed (captured-expr? ctx g))))))

(defn av-clause-node
  "A `case`, `try` or `receive`: its pattern binders read data."
  [x ctx st]
  (let [[sv st] (if (some? (anf-get x :subj)) (av-walk (anf-get x :subj) ctx st) [#{} st])
        [bv st] (if (some? (anf-get x :body)) (av-walk (anf-get x :body) ctx st) [#{} st])
        [vs st] (reduce (fn [[acc st] cl]
                          (let [st (reduce (fn [st b] (av-addF st b (into (:H st) sv)))
                                           st (mapcat pat-binder-names (anf-get cl :pats)))
                                [_ st] (if (some? (anf-get cl :guard)) (av-walk (anf-get cl :guard) ctx st) [#{} st])
                                [v st] (av-walk (anf-get cl :body) ctx st)]
                            [(into acc v) st]))
                        [#{} st] (concat (anf-get x :clauses) (anf-get x :catch)))
        [_ st] (av-walk-list (filter some? [(anf-get x :after) (anf-get x :timeout)]) ctx st)]
    [(into bv vs) st]))

(defn av-walk
  "The function values node `x` may evaluate to: [value-set st]."
  [x ctx st]
  (cond
    (erlang/is_list x) (let [[vs st] (av-walk-list x ctx st)] [(av-join vs) st])
    (vector? x) (let [[vs st] (av-walk-list (vec x) ctx st)] [(av-join vs) st])
    (erlang/is_tuple x) (let [[vs st] (av-walk-list (erlang/tuple_to_list x) ctx st)] [(av-join vs) st])
    (not (anf-map? x)) [#{} st]
    :else
    (let [ctx (assoc ctx :line (or (anf-line x) (:line ctx)))
          op (anf-op x)
          clauses (fn-value-clauses x)]
      (cond
        (some? clauses) (av-lambda x clauses ctx st)
        (= op :apply) (av-apply x ctx st)
        (= op :let) (let [[iv st] (av-walk (anf-get x :init) ctx st)]
                      (av-walk (anf-get x :body) (av-with-sub ctx (anf-get x :name) (anf-get x :init))
                               (av-addF st (anf-get x :name) iv)))
        (= op :var) (let [n (anf-get x :name)]
                      [(if (contains? (:selfs ctx) n) #{(get (:selfs ctx) n)} (av-F st n)) st])
        (= op :global) (let [n (anf-get x :name)]
                         (cond
                           (contains? (:local ctx) n) [#{[:def n]} (assoc st :used (conj (:used st) n))]
                           ; a runtime function used as a value (`(mapv inc xs)`)
                           (contains? core-map n) [#{[:core n (:owner ctx)]} st]
                           :else [#{} st]))
        (contains? #{:lit :enil} op) [#{} st]
        (= op :if) (let [t (anf-get x :test)
                         [_ st] (av-walk t ctx st)
                         [a st] (av-walk (anf-get x :then) (assoc ctx :g (guard-join (:g ctx) (guard-facts t true))) st)
                         [b st] (av-walk (anf-get x :else) (assoc ctx :g (guard-join (:g ctx) (guard-facts t false))) st)]
                     [(into a b) st])
        (= op :do) (let [[vs st] (av-walk-list (vec (anf-get x :stmts)) ctx st)]
                     [(if (empty? vs) #{} (last vs)) st])
        (contains? #{:case :try :recv} op) (av-clause-node x ctx st)
        (= op :remote) (av-remote x ctx st)
        ; data — a literal, a struct, arithmetic: function values in it join H
        :else (let [[vs st] (av-walk-list (vec (map (fn [k] (maps/get k x)) (filter (fn [k] (not (= k :ann))) (maps/keys x)))) ctx st)]
                [#{} (av-addH st (av-join vs))])))))

(defn av-def
  "One round over named function `g`: every clause under its own node."
  [st ctx g]
  (let [key [:def g]]
    (reduce (fn [st cl]
              (let [c2 (assoc ctx :node key :owner g :selfs {(:self cl) key} :loops {} :g no-guards
                                  :line nil :measure (:params cl) :lambda false :inner #{} :cap false
                                  :subs (reduce (fn [m p] (if (some? p) (assoc m p {p :le}) m)) {} (:params cl)))
                    st (reduce (fn [st b] (av-addF st b (:H st))) st (:binders cl))
                    [_ st] (if (some? (:guard cl)) (av-walk (:guard cl) c2 st) [#{} st])
                    [v st] (av-walk (:body cl) c2 st)]
                (av-addR st key v)))
            st (get (:defclauses ctx) g))))

(defn av-closures
  "One round over every combinator closure: it calls what it captured, with
   anything in H, what it was called with and what it holds."
  [st ctx]
  (reduce (fn [st site]
            (let [c (get-in st [:clo site])
                  key [:rt site]
                  argset (-> (:H st) (into (:args c)) (into (:values c)))
                  c2 (assoc ctx :node key :owner (:owner c) :line (:line c) :subs {} :g no-guards :measure []
                            :cap (:cap c))
                  st (av-fact st c2 {:kind :closure :rt (:rt c) :to (:called c) :args []})
                  [rets st] (av-call-all st c2 (:called c) (fn [_] argset) nil)]

              (av-addR st key (-> (:H st) (into rets) (into (:values c))))))
          st (sort (keys (:clo st)))))

(defn closure-flow
  "Solve the app's closure flow. `roots` are every function the shell calls."
  [order compiled roots dir]
  (let [defclauses (reduce (fn [m n] (assoc m n (or (fn-value-clauses (:node (get compiled n))) []))) {} order)
        ctx {:models (runtime-value-model dir) :defclauses defclauses :local (set order)
             :selfs {} :loops {} :g no-guards :subs {} :measure []}
        round (fn [st]
                (let [st (assoc st :site 0 :facts [])
                      st (reduce (fn [st r]
                                   (reduce (fn [st cl] (reduce (fn [st p] (av-addF st p (:H st))) st (:params cl)))
                                           st (get defclauses r)))
                                 st roots)
                      st (reduce (fn [st g] (av-def st ctx g)) st order)
                      st (av-closures st ctx)]
                  (reduce (fn [st r] (av-addH st (av-R st [:def r]))) st roots)))
        view (fn [st] [(:F st) (:R st) (:H st) (:edges st) (:uncaptured st) (:clo st)])]
    (loop [st {:F {} :R {} :H #{} :edges {} :uncaptured #{} :clo {} :lams {} :facts [] :site 0 :used #{} :computes #{}} n 0]
      (let [next (round st)]
        (cond
          (= (view next) (view st)) (assoc next :converged true :defclauses defclauses :models (:models ctx))
          (> n 60) (assoc next :converged false :defclauses defclauses :models (:models ctx))
          :else (recur next (inc n)))))))

; ── the call graph: cycles and structural recursion ─────────────────────────────────────

(defn reach
  "Every node reachable from `start` in one or more steps."
  [edges start]
  (loop [frontier (vec (get edges start #{})) seen #{}]
    (cond
      (empty? frontier) seen
      (contains? seen (first frontier)) (recur (vec (rest frontier)) seen)
      :else (recur (into (vec (rest frontier)) (get edges (first frontier) #{})) (conj seen (first frontier))))))

(defn node-owner [st k]
  (cond (= :def (first k)) (second k)
        (= :core (first k)) (nth k 2)
        (= :lam (first k)) (get-in st [:lams (second k) :owner])
        :else (get-in st [:clo (second k) :owner])))

(defn node-label [st k]
  (cond
    (= :def (first k)) (second k)
    (= :lam (first k)) (str "fn@" (get-in st [:lams (second k) :line]))
    (= :core (first k)) (second k)
    :else (let [c (get-in st [:clo (second k)])
                nm (:rt c)
                nm (if (String/starts_with? nm "core-") (subs nm 5) (if (String/starts_with? nm "rt-") (subs nm 3) nm))
                nm (if (String/ends_with? nm "-more") (subs nm 0 (- (count nm) 5)) nm)]
            (str nm "@" (:line c)))))

(defn cycle-path
  "The shortest cycle through `k` inside `scc`, as [k … k]."
  [edges k scc]
  (loop [frontier [[k]] seen #{}]
    (if (empty? frontier)
      [k k]
      (let [path (first frontier)
            x (last path)
            nexts (filter (fn [y] (contains? scc y)) (sort (vec (get edges x #{}))))]
        (if (some (fn [y] (= y k)) nexts)
          (conj path k)
          (recur (into (vec (rest frontier))
                       (map (fn [y] (conj path y)) (filter (fn [y] (not (contains? seen y))) nexts)))
                 (into seen nexts)))))))

(defn edge-rel
  "How call fact `f`, made by a node measured by its parameter `pa`, relates
   the measure of target `t` (its parameter `pb`) to it: :lt, :le, :part or
   nil (no relation)."
  [f pa t pb]
  (let [root (nth (:measure f) pa nil)
        g (:g f)]
    (cond
      (nil? root) nil
      (contains? #{:direct :computed} (:kind f))
        (let [a (nth (:args f) pb nil)] (if (nil? a) nil (get (sub-rel a (:subs f) g) root)))
      (= :hof (:kind f))
        (let [e (get-in element-hofs [(:rt f) (count (:args f))])]
          (if (and (some? e) (contains? (:params e) pb) (contains? (nth (:argvals f) (:fn e) #{}) t))
            ; an element of the collection: strictly smaller than it
            (if (some? (get (sub-rel (nth (:args f) (:coll e)) (:subs f) g) root)) :lt nil)
            nil))
      :else nil)))

(defn node-arity [flow k]
  (let [cls (if (= :def (first k)) (get (:defclauses flow) (second k)) (get-in flow [:lams (second k) :clauses]))]
    (if (empty? cls) 0
      (reduce min (map (fn [cl] (if (:variadic cl) (dec (count (:params cl))) (count (:params cl)))) cls)))))

(defn le-acyclic?
  "No cycle of `pairs` ({[a b] strength}) uses :le edges only."
  [nodes pairs]
  (let [le (reduce (fn [m [[a b] r]] (if (= :le r) (assoc m a (conj (get m a #{}) b)) m)) {} (vec pairs))]
    (every? (fn [k] (not (contains? (reach le k) k))) nodes)))

(defn structural-cycle
  "Is recursion around `scc` provably finite? It is when some parameter of
   every function in it — its MEASURE — never grows along a call inside the
   cycle and strictly shrinks at least once around every cycle: each call
   passes the callee a no-larger view (:le) or a strict part (:lt) of the
   caller's measure, and the :le calls alone form no cycle. Data is finite,
   so the measure cannot shrink forever. Only app functions and lambdas take
   part: a combinator closure or a runtime value in the cycle refuses it."
  [flow scc]
  (let [nodes (sort (vec scc))
        foreign (first (filter (fn [k] (not (contains? #{:def :lam} (first k)))) nodes))]
    (if (some? foreign)
      {:ok false :why (str "the recursion passes through " (node-label flow foreign))}
      (let [facts (filter (fn [f] (and (contains? scc (:from f)) (some (fn [t] (contains? scc t)) (:to f))))
                          (:facts flow))
            assignments (reduce (fn [acc k] (if (> (count acc) 4096) acc
                                              (vec (mapcat (fn [a] (map (fn [p] (assoc a k p)) (range (node-arity flow k)))) acc))))
                                [{}] nodes)
            verdict (fn [asg]
                      (let [pairs (reduce (fn [m f]
                                            (reduce (fn [m t]
                                                      (if (not (contains? scc t)) m
                                                        (let [r0 (edge-rel f (get asg (:from f)) t (get asg t))
                                                              ; a lookup result is no larger: :le (see "Measures")
                                                              r (if (= :part r0) :le r0)
                                                              prev (get m [(:from f) t] :lt)]
                                                          (cond
                                                            (or (= prev :bad) (not (contains? #{:le :lt} r))) (assoc m [(:from f) t] :bad)
                                                            (= r :le) (assoc m [(:from f) t] :le)
                                                            :else (assoc m [(:from f) t] prev)))))
                                                    m (sort (vec (:to f)))))
                                          {} facts)]
                        (and (not (some (fn [[_ r]] (= :bad r)) (vec pairs))) (le-acyclic? nodes pairs))))
            found (first (filter verdict (if (> (count assignments) 4096) [] assignments)))]
        (if (some? found)
          {:ok true :by :structural :measure found}
          {:ok false :why "no argument shrinks on every call around it"})))))

(defn capture-order
  "Is recursion around `scc` finite because every call inside it goes to a
   value the calling closure CAPTURED? A captured value existed before the
   closure that holds it, so each such call reaches a strictly OLDER value:
   an infinite chain of them would need infinitely many older values. This is
   what admits combinators that compose closures of their own kind
   (`(both (both p q) r)`). {:ok true :by :capture-order} or nil."
  [flow scc]
  (let [inner (filter (fn [[a b]] (and (contains? scc a) (contains? scc b))) (vec (:uncaptured flow)))]
    (if (empty? inner) {:ok true :by :capture-order} nil)))

(defn flow-reasons
  "The closure-flow verdict for every local definition: {name → [reason …]}
   plus the evidence the manifest shows."
  [order flow]
  (let [edges (:edges flow)
        nodes (set (concat (keys edges) (mapcat (fn [k] (vec (get edges k))) (keys edges))))
        reaches (reduce (fn [m k] (assoc m k (reach edges k))) {} nodes)
        cyclic (filter (fn [k] (contains? (get reaches k) k)) (sort (vec nodes)))
        scc-of (fn [k] (conj (set (filter (fn [j] (and (contains? (get reaches k) j) (contains? (get reaches j) k))) nodes)) k))
        proofs (reduce (fn [m k] (if (contains? m k) m
                                   (let [scc (scc-of k) verdict (or (capture-order flow scc) (structural-cycle flow scc))]
                                     (reduce (fn [m j] (assoc m j verdict)) m (vec scc)))))
                       {} cyclic)
        refused (filter (fn [k] (not (:ok (get proofs k)))) cyclic)
        reasons (reduce (fn [m k]
                          (let [o (node-owner flow k)]
                            (if (or (nil? o) (not (empty? (get m o []))))
                              m
                              (assoc m o [{:reason :recursive
                                           :detail (str "on a call cycle "
                                                        (join-str (mapv (fn [j] (node-label flow j)) (cycle-path edges k (scc-of k))) " → ")
                                                        (let [why (:why (get proofs k))] (if why (str " (" why ")") "")))}]))))
                        {} refused)
        ; which proof admitted the recursion each function takes part in
        admitted (reduce (fn [m k] (let [o (node-owner flow k)]
                                     (if (nil? o) m (assoc m o (name (:by (get proofs k)))))))
                         {} (filter (fn [k] (:ok (get proofs k))) cyclic))]
    {:reasons (reduce (fn [m n]
                        (assoc m n (if (:converged flow) (get reasons n [])
                                     [{:reason :not-analyzed :detail "the closure-flow analysis did not converge"}])))
                      {} order)
     :own-computes (:computes flow)
     :used-as-value (set (filter (fn [n] (contains? (:used flow) n)) order))
     :recursion admitted}))

(defn abi-reasons
  "Why the emitter would refuse to ship these ANF facts to a browser."
  [facts local]
  (reduce
    (fn [acc f]
      (let [k (:kind f) l (:line f)]
        (cond
          ; a computed call is judged by the value discipline, not refused here
          (= k :dynamic-call) acc
          (= k :receive) (conj acc {:reason :receive :line l :detail "waits for a message"})
          (= k :remote)
            (let [m (:mod f) fun (:fun f)]
              (cond
                (= m mod-host) (conj acc {:reason :host-call :line l :detail (str "host/" fun)})
                (and (= m mod-erlang) (contains? #{"self" "exit"} (str fun)))
                  (conj acc {:reason :process-effect :line l :detail (str "erlang/" fun)})
                (not (remote-ok? m fun))
                  (conj acc {:reason :outside-abi :line l :detail (remote-key m fun)})
                :else acc))
          (= k :global)
            (let [n (:name f)]
              (cond
                (contains? local n) acc
                (contains? client-pure-core n) acc
                (contains? core-map n) (conj acc {:reason :effect :line l :detail n})
                :else (conj acc {:reason :unresolved :line l :detail n})))
          :else acc)))
    [] facts))

(defn graph-reasons
  "Why the source call graph cannot certify `name` on its own."
  [cone name]
  (let [q (str "js/" name)]
    (if (not (:root-defined cone))
      [{:reason :not-indexed :detail "the source graph has no definition for it"}]
      (reduce (fn [acc c]
                (let [callee (:callee c)]
                  (cond
                    (not (= q (:caller c))) acc
                    ; a computed head is the value discipline's to judge
                    (= "<dynamic>" callee) acc
                    (and (some? (index-of callee "/")) (not (= :defined (:status c))))
                      (conj acc {:reason (if (String/starts_with? callee "host/") :host-call :outside-abi)
                                 :line (:line c) :detail callee})
                    :else acc)))
              [] (:calls cone)))))

(defn effect-reasons
  "Why the whole-program analysis cannot call `name` pure — attributed to
   `name` only when none of its local callees is already impure (otherwise the
   impurity is inherited, and the callee carries the reason)."
  [summaries name callees]
  (let [pure? (fn [n] (let [s (get summaries n)]
                        (and (some? s) (= {} (:footprint s)) (= {} (:latent s)) (= true (:terminates s)))))
        s (get summaries name)]
    (cond
      (nil? s) [{:reason :not-analyzed :detail "the analyzer produced no summary"}]
      (pure? name) []
      (some (fn [g] (not (pure? g))) callees) []
      (not (= true (:terminates s))) [{:reason :may-not-terminate :detail "termination is not proven"}]
      (not (= {} (:footprint s))) [{:reason :effect :detail (str "footprint " (pr-str (:footprint s)))}]
      :else [{:reason :effectful-value
              :detail (str "a function value it creates or names has footprint " (pr-str (:latent s)))}])))

; ── closures and portability ──────────────────────────────────────────────────────────────

(defn closure-of
  "Every name `roots` reach over `edges`, with a BFS parent for path reports."
  [roots edges]
  (loop [frontier (vec roots) seen (set roots) parent {}]
    (if (empty? frontier)
      {:members seen :parent parent}
      (let [n (first frontier)
            nexts (filterv (fn [g] (not (contains? seen g))) (get edges n []))]
        (recur (into (vec (rest frontier)) nexts) (into seen nexts)
               (reduce (fn [p g] (assoc p g n)) parent nexts))))))

(defn portable-names
  "The greatest set of names with no own reason whose local callees are all
   in the set: a fixpoint that removes anything reaching a non-portable name."
  [names own edges]
  (loop [ok (set (filter (fn [n] (empty? (get own n))) names))]
    (let [next (set (filter (fn [n] (every? (fn [g] (contains? ok g)) (get edges n []))) ok))]
      (if (= (count next) (count ok)) ok (recur next)))))

(defn why-not-portable [n own edges ok]
  (let [r (get own n)]
    (if (not (empty? r))
      (first r)
      {:reason :reaches :detail (first (filter (fn [g] (not (contains? ok g))) (get edges n [])))})))

(defn refusal-path
  "root → … → offender → … → the function that owns the reason."
  [n parent own edges ok]
  (let [up (loop [x n acc (list n)]
             (let [p (get parent x)] (if (nil? p) acc (recur p (cons p acc)))))
        down (loop [x n acc []]
               (let [w (why-not-portable x own edges ok)]
                 (if (= :reaches (:reason w))
                   (recur (:detail w) (conj acc (:detail w)))
                   {:names acc :why w})))]
    {:path (into (vec up) (:names down)) :why (:why down)}))

; ── canonical JSON (the contract and the manifest) ─────────────────────────────────────────

(defn cjson
  "Canonical JSON: object keys sorted, keywords as their bare names, no
   whitespace. The contract digest is the SHA-256 of exactly these bytes."
  [v]
  (cond
    (nil? v) "null"
    (= v true) "true"
    (= v false) "false"
    (int? v) (str v)
    (string? v) (js-str v)
    (keyword? v) (js-str (name v))
    (symbol? v) (js-str (str v))
    (map? v) (let [ks (sort-by (fn [k] (if (keyword? k) (name k) (str k))) (keys v))]
               (str "{" (join-str (mapv (fn [k] (str (js-str (if (keyword? k) (name k) (str k)))
                                                    ":" (cjson (get v k)))) ks) ",") "}"))
    (or (vector? v) (seq? v) (set? v) (erlang/is_list v))
      (str "[" (join-str (mapv cjson (vec v)) ",") "]")
    :else (throw (ex-info "cjson: unsupported value" {:value v}))))

; ── the plan ──────────────────────────────────────────────────────────────────────

(defn shell-names [dir]
  (set (mapcat (fn [f] (map defn-name (filter defn-form? (read-file-forms (str dir "/" f)))))
               (distinct (concat ["runtime.bl"] split-client-shell)))))

(defn dispatch-src [fname params pairs fallback]
  (str "(defn " fname " [op " params "]\n  (cond\n"
       (apply str (map (fn [[op f]] (str "    (= op " (pr-str op) ") (" f " " params ")\n")) pairs))
       "    :else " fallback "))\n"))

(defn glue-src
  "The generated BL the browser half is compiled with: the contract, its
   digest and one dispatcher per client role. It never names an :apply,
   :guard, :allow or :says — those run only on BEAM (split.core reaches them
   through the app value)."
  [app contract digest]
  (let [ints (:intents app)
        check (dispatch-src "split-check" "board args" (map (fn [i] [(:op i) (:check i)]) ints) ":unknown-intent")]
    (str "(defn split-contract [] " (pr-str contract) ")\n"
         "(defn split-digest [] " (pr-str digest) ")\n"
         (if (< 0 (:history app))
           ; undo and redo are the authority's decision: the browser only proposes them
           (String/replace check "(defn split-check [op board args]\n  (cond\n"
                           "(defn split-check [op board args]\n  (cond\n    (= op :undo) nil\n    (= op :redo) nil\n")
           check)
         "(defn split-client-init [] (" (:client-init app) "))\n"
         "(defn split-client-view [board local sync] (" (:view app) " board local sync))\n"
         "(defn split-client-on [local event] (" (:on app) " local event))\n"
         (dispatch-src "split-predict" "board args"
                       (map (fn [i] [(:op i) (:predict i)]) (filter (fn [i] (some? (:predict i))) ints)) "nil")
         (dispatch-src "split-agrees?" "predicted confirmed"
                       (map (fn [i] [(:op i) (:agrees i)]) (filter (fn [i] (some? (:agrees i))) ints))
                       "(= predicted confirmed)")
         "(defn main [] (split-client-main))\n")))

(defn split-plan
  "Analyze one app source. Answers the whole plan — contract, placement,
   evidence, both halves' definitions — or throws a `:split-refusal` naming why."
  [dir src label]
  (let [forms (BeamLisp.Ns.Reader/read src {:file label})
        apps (filter defapp-form? forms)
        _ (when-not (= 1 (count apps))
            (split-refuse :bad-declaration (str label " needs exactly one (split/defapp …), found " (count apps)) {}))
        ; `(ns app (:require [split]))` heads the file, so the SAME file loads
        ; natively on BEAM (its server half); this target compiles only the
        ; defns, one namespace per bundle
        _ (when (some ns-form? (rest forms))
            (split-refuse :unsupported-form (str label ": an (ns …) form may only open the file") {}))
        forms (if (and (not (empty? forms)) (ns-form? (first forms))) (vec (rest forms)) forms)
        _ (doseq [f forms]
            (when-not (or (defn-form? f) (defapp-form? f))
              (split-refuse :unsupported-form (str label ":" (form-line f)
                                                   ": a split app holds one (ns …), defns and one split/defapp")
                            {:line (form-line f)})))
        dforms (filterv defn-form? forms)
        reserved (shell-names dir)
        defns (reduce (fn [m f]
                        (let [n (defn-name f)]
                          (cond
                            (contains? m n) (split-refuse :duplicate-function (str n " is defined twice") {:name n})
                            ; `entry` is the bundle's own start symbol (js/entry)
                            (or (contains? reserved n) (= n "main") (= n "entry") (String/starts_with? n "split-"))
                              (split-refuse :reserved-name (str n " would shadow the runtime or the split shell") {:name n})
                            :else (assoc m n f))))
                      {} dforms)
        order (mapv defn-name dforms)
        local (set order)
        app (read-defapp (first apps) defns)
        ; the app is its own compilation unit: its ANF names depend on its
        ; source alone, so a split-only and a full build emit identical halves
        _ (BeamLisp.Ns.Compiler/reset-fresh!)
        compiled (reduce (fn [m f]
                           (assoc m (defn-name f)
                                  (try (compile-defn-form f "js")
                                       (catch e (split-refuse :compile-error
                                                              (str (defn-name f) ": " (ex-message e))
                                                              {:name (defn-name f)})))))
                         {} dforms)
        ; where the app's own names stop: the client shell continues from here
        fresh-high (erlang/get (erlang/binary_to_atom "bl_fresh_seq"))
        facts (reduce (fn [m n] (assoc m n (anf-facts (:node (get compiled n)) nil []))) {} order)
        edges (reduce (fn [m n]
                        (assoc m n (vec (sort (distinct (filter (fn [g] (and (contains? local g) (not (= g n))))
                                                                (map :name (filter (fn [f] (= :global (:kind f)))
                                                                                   (get facts n)))))))))
                      {} order)
        idx (cb/index-source {} "js" src)
        conn (cb/connect-codebase)
        _ (datom/transact! conn (concat (:fn idx) (:calls idx) (:instr idx) (:requires idx)))
        db (datom/db conn)
        summaries (an/analyze src)
        graph (reduce (fn [m n] (assoc m n (graph-reasons (cb/dependency-cone db (str "js/" n)) n))) {} order)
        effects (reduce (fn [m n] (assoc m n (effect-reasons summaries n (get edges n)))) {} order)
        abi (reduce (fn [m n] (assoc m n (abi-reasons (get facts n) local))) {} order)
        ints0 (:intents app)
        flow (closure-flow order compiled
                           (vec (distinct (concat [(:client-init app) (:view app) (:on app) (:server-init app)]
                                                  (map :check ints0) (filter some? (map :guard ints0))
                                                  (map :apply ints0) (filter some? (map :predict ints0))
                                                  (filter some? (map :agrees ints0))
                                                  (filter some? (map :allow ints0)) (filter some? (map :says ints0))
                                                  (filter some? [(:people app) (:undo-allow app)]))))
                           dir)
        vd (flow-reasons order flow)
        own (reduce (fn [m n]
                      ; the most specific reason first: the closure flow names the
                      ; call cycle a recursion goes around
                      (assoc m n (vec (concat (if (contains? (:private app) n)
                                                [{:reason :private :detail "declared :private in :server"}] [])
                                              (get abi n) (get (:reasons vd) n)
                                              (get graph n) (get effects n)))))
                    {} order)
        ok (portable-names order own edges)
        ints (:intents app)
        client-roots (vec (distinct (concat [(:client-init app) (:view app) (:on app)] (map :check ints)
                                            (filter some? (map :predict ints)) (filter some? (map :agrees ints)))))
        server-roots (vec (distinct (concat [(:server-init app)] (map :check ints)
                                            (filter some? (map :guard ints)) (map :apply ints)
                                            (filter some? (map :allow ints)) (filter some? (map :says ints))
                                            (filter some? [(:people app) (:undo-allow app)]))))
        cc (closure-of client-roots edges)
        sc (closure-of server-roots edges)
        bad (filter (fn [n] (and (contains? (:members cc) n) (not (contains? ok n)))) order)
        _ (when-not (empty? bad)
            (let [n (first bad)
                  rp (refusal-path n (:parent cc) own edges ok)
                  line-of (fn [x] (form-line (get defns x)))
                  w (:why rp)]
              (split-refuse :not-portable
                            (str (first (:path rp)) " cannot run in the browser: "
                                 (join-str (mapv (fn [x] (str x " (" label ":" (line-of x) ")")) (:path rp)) " → ")
                                 " — " (name (:reason w))
                                 (if (:detail w) (str " " (:detail w)) "")
                                 (if (:line w) (str " at line " (:line w)) ""))
                            {:path (:path rp) :why w})))
        contract {:schema 1 :app (:name app) :wire (:wire app) :snapshot (:snapshot app)
                  ; who may propose: anyone (no roster) or a signed-in person
                  :people (some? (:people app))
                  :history (< 0 (:history app))
                  :intents (reduce (fn [m i] (assoc m (:op i) {:params (:params i)}))
                                   (if (< 0 (:history app)) {:undo {:params {}} :redo {:params {}}} {})
                                   ints)}
        digest (sha256-hex (cjson contract))
        placement (fn [n]
                    (let [c (contains? (:members cc) n) s (contains? (:members sc) n)]
                      (cond (and c s) :shared c :client s :server :else :unused)))
        verdict (fn [rs] (if (empty? rs) "ok" (join-str (mapv (fn [r] (str (name (:reason r))
                                                                          (if (:detail r) (str " " (:detail r)) "")
                                                                          (if (:line r) (str " (line " (:line r) ")") "")))
                                                             rs) "; ")))
        functions (mapv (fn [n]
                          (let [p (contains? ok n)]
                            {:name n :line (form-line (get defns n)) :placement (placement n)
                             :portable p
                             :why (if p nil (let [w (why-not-portable n own edges ok)]
                                              {:reason (:reason w) :detail (:detail w) :line (:line w)}))
                             :calls (get edges n)
                             :evidence {:graph (verdict (get graph n)) :effects (verdict (get effects n))
                                        :abi (verdict (get abi n))
                                        :values (verdict (get (:reasons vd) n))
                                        :calls-values (contains? (:own-computes vd) n)
                                        :used-as-value (contains? (:used-as-value vd) n)
                                        :recursion (get (:recursion vd) n)
                                        :private (contains? (:private app) n)}}))
                        order)]
    {:app app :contract contract :digest digest :label label :fresh-high fresh-high
     :client-defs (mapv (fn [n] (get compiled n)) (filter (fn [n] (contains? (:members cc) n)) order))
     :server-defs (mapv (fn [n] (get compiled n)) (filter (fn [n] (contains? (:members sc) n)) order))
     :manifest {:schema 1 :app (:name app) :source label :digest digest
                :roots {:client client-roots :server server-roots}
                :functions functions
                :excluded-from-client (filterv (fn [n] (not (contains? (:members cc) n))) order)}}))

(defn compile-src-forms [src label]
  (reduce (fn [acc f] (into acc (compile-top-form f "js" label))) []
          (BeamLisp.Ns.Reader/read src {:file label})))

(defn split-emit!
  "Write the browser half, the contract and the placement manifest for
   `plan`. (The server half is the app namespace itself, on BEAM.)"
  [dir plan stem]
  (let [shell-paths (mapv (fn [f] (str dir "/" f)) (concat ["runtime.bl"] split-client-shell))
        ; the shell's generated names must depend on the bundle's inputs alone
        ; (so a one-app build and a full build emit the same bytes) AND must
        ; not collide with the app's, which split-plan numbered from 1: go on
        ; from where the app's own compilation stopped
        _ (erlang/put (erlang/binary_to_atom "bl_fresh_seq") (:fresh-high plan))
        client (write-bundle! dir (str stem "-client.mjs") (conj shell-paths (:label plan))
                              (vec (concat (mapcat (fn [p] (compile-source p "js")) shell-paths)
                                           (compile-src-forms (glue-src (:app plan) (:contract plan) (:digest plan))
                                                              "<split glue: client>")
                                           (:client-defs plan))))
        manifest (assoc (:manifest plan) :bundles
                        {:client {:file (str stem "-client.mjs") :bytes (:bytes client)
                                  :app-functions (count (:client-defs plan))}
                         :server {:runtime "beam" :app-functions (count (:server-defs plan))}})]
    (File/write! (str dir "/out/" stem ".contract.json")
                 (str (cjson (assoc (:contract plan) :digest (:digest plan))) "\n"))
    (File/write! (str dir "/out/" stem ".split.json") (str (cjson manifest) "\n"))
    (println (str "js-actors: split " (:label plan) " → client " (count (:client-defs plan))
                  " app fn(s) in JS, server " (count (:server-defs plan)) " app fn(s) on BEAM, contract "
                  (subs (:digest plan) 0 12)))
    manifest))

(defn expect-split-refusal [dir label src reason needle]
  (let [r (try (do (split-plan dir src label) nil)
               (catch e {:reason (:split-refusal (ex-data e)) :message (ex-message e)}))]
    (if (and (some? r) (= reason (:reason r)) (some? (index-of (:message r) needle)))
      (do (println (str "SPLIT REFUSES " label ": " (:message r))) 0)
      (do (println (str "SPLIT FAIL " label ": expected " reason " mentioning " (pr-str needle)
                        ", got " (pr-str r)))
          1))))

(defn expect-split-accept
  "The app, one edit away, must still build with `name` in the browser."
  [dir label src name]
  (let [r (try (let [plan (split-plan dir src label)
                     f (first (filter (fn [f] (= name (:name f))) (:functions (:manifest plan))))]
                 (if (contains? #{:client :shared} (:placement f)) nil (str name " placed " (:placement f))))
               (catch e (ex-message e)))]
    (if (nil? r)
      (do (println (str "SPLIT ACCEPTS " label)) 0)
      (do (println (str "SPLIT FAIL " label ": expected it admitted, got " r)) 1))))

(defn replace-once [src from to]
  (let [i (index-of src from)]
    (if (nil? i)
      (throw (ex-info (str "split test fixture anchor missing: " from) {}))
      (str (subs src 0 i) to (subs src (+ i (count from)))))))

(defn split-tests
  "Build the showcase, check the placement it derived, then prove the gate
   refuses: each fixture is the REAL app one edit away from a leak."
  [dir]
  (let [path (str dir "/showcase.bl")
        src (File/read! path)
        plan (split-plan dir src "research/js-actors/showcase.bl")
        manifest (split-emit! dir plan "showcase")
        where (reduce (fn [m f] (assoc m (:name f) (:placement f))) {} (:functions manifest))
        expect (fn [n p] (if (= p (get where n)) 0
                           (do (println (str "SPLIT FAIL placement " n ": expected " p ", got " (get where n))) 1)))
        placed (+ (expect "board-view" :client) (expect "on-event" :client)
                  (expect "add-problem" :shared) (expect "done-count" :shared)
                  (expect "find-task" :shared)
                  ; the computed calls: admitted, and in the browser
                  (expect "arrange" :client) (expect "open-first" :client)
                  (expect "by-title" :client)
                  (expect "flagged-title?" :server) (expect "blocked-words" :server)
                  (expect "add-task" :server) (expect "initial-board" :server))
        view "(note-banner (:note sync))"
        leaks (+ (expect-split-refusal dir "leak-private"
                   (replace-once src view (str view " (if (flagged-title? board {:title (:draft local)}) \"!\" \"\")"))
                   :not-portable "blocked-words")
                 (expect-split-refusal dir "leak-effect"
                   (replace-once src "(defn plural [n word] (str n" "(defn plural [n word] (host/write \"x\") (str n")
                   :not-portable "host/write")
                 ; recursion over a number: nothing proves it ends
                 (expect-split-refusal dir "recursive"
                   (replace-once src "(defn plural [n word] (str n"
                                 "(defn plural [n word] (if (= n 0) \"\" (plural (dec n) word)) (str n")
                   :not-portable "recursive on a call cycle plural → plural")
                 ; two functions that reach each other
                 (expect-split-refusal dir "mutual"
                   (str (replace-once src "(defn plural [n word] (str n"
                                      "(defn plural [n word] (ping n) (str n")
                        "\n(defn ping [n] (if (= n 0) 0 (pong n)))\n(defn pong [n] (ping (dec n)))\n")
                   :not-portable "recursive on a call cycle")
                 ; recursion through a lambda handed to mapv that REBUILDS its
                 ; input: `[x]` is no smaller than the list it came from
                 (expect-split-refusal dir "recursive-through-value"
                   (str (replace-once src "(defn plural [n word] (str n"
                                      "(defn plural [n word] (walk-down [n]) (str n")
                        "\n(defn walk-down [xs] (mapv (fn [x] (walk-down [x])) xs))\n")
                   :not-portable "no argument shrinks on every call around it")
                 ; self-application: ((fn [x] (x x)) (fn [x] (x x))) never ends
                 (expect-split-refusal dir "omega"
                   (replace-once src "(defn plural [n word] (str n"
                                 "(defn plural [n word] ((fn [x] (x x)) (fn [x] (x x))) (str n")
                   :not-portable "recursive on a call cycle fn@")
                 ; the same knot tied through combinators
                 (expect-split-refusal dir "self-application-through-comp"
                   (replace-once src "(defn plural [n word] (str n"
                                 "(defn plural [n word] (let [w (fn [f] (f f))] ((comp w identity) w)) (str n")
                   :not-portable "recursive on a call cycle")
                 ; an effect hidden in a lambda the client merely creates
                 (expect-split-refusal dir "effectful-value"
                   (replace-once src "(defn plural [n word] (str n"
                                 "(defn plural [n word] (fn [x] (send x word)) (str n")
                   :not-portable "send")
                 (expect-split-refusal dir "leak-process"
                   (replace-once src "(defn plural [n word] (str n" "(defn plural [n word] (send n word) (str n")
                   :not-portable "send")
                 (expect-split-refusal dir "bad-wire"
                   (replace-once src ":title [:text 1 48]}" ":title [:text 48 1]}")
                   :bad-wire "min <= max")
                 (expect-split-refusal dir "unknown-root"
                   (replace-once src ":view board-view" ":view board-vew")
                   :unknown-function "board-vew")
                 (expect-split-refusal dir "arity"
                   (replace-once src ":on on-event" ":on filter-tab")
                   :arity-mismatch "filter-tab")
                 (expect-split-refusal dir "reserved"
                   (str src "\n(defn rt-mapv [f xs] xs)\n")
                   :reserved-name "rt-mapv"))
        admits (+ ; a lambda that calls the function it RECEIVES (rank two)
                  (expect-split-accept dir "rank-two"
                    (replace-once src "(defn plural [n word] (str n" "(defn plural [n word] ((fn [g] (g n)) inc) (str n")
                    "plural")
                  ; a named function that calls values, itself passed as a value
                  (expect-split-accept dir "computing-value"
                    (replace-once src "(mapv (fn [o] (order-tab (:order local) o)) (orderings))"
                                  "(mapv (fn [o] (order-tab (:order local) o)) (orderings)) (mapv (fn [o] (arrange o [])) [(:order local)])")
                    "arrange")
                  ; comp, partial, juxt, complement and apply, built and called
                  (expect-split-accept dir "combinators"
                    (replace-once src "(defn plural [n word] (str n"
                                  "(defn plural [n word] ((juxt (comp not :x) (partial str \"#\") (complement some?)) {:x 1}) (apply str [1 2]) (str n")
                    "plural")
                  ; a structural tree walk
                  (expect-split-accept dir "tree-walk"
                    (str (replace-once src "(defn plural [n word] (str n" "(defn plural [n word] (depth {:kids []}) (str n")
                         "\n(defn depth [t] (inc (reduce (fn [a b] (if (< a b) b a)) 0 (mapv depth (:kids t)))))\n")
                    "depth"))]
    (if (zero? (+ placed leaks admits))
      (do (println "SPLIT PASS placement derived, 13 refusals named, 4 higher-order fixtures admitted") 0)
      (throw (ex-info "js-actors: split tests failed" {:failures (+ placed leaks admits)})))))

(defn split-app-tests
  "Build one app under apps/, check the placements it must derive and the
   recursion proofs it must carry, then run its refusal fixtures — each the
   REAL app one edit away from a leak or a non-terminating walk."
  [dir stem expect-where expect-recursion refusals]
  (let [label (str "research/js-actors/apps/" stem ".bl")
        src (File/read! (str dir "/apps/" stem ".bl"))
        manifest (split-emit! dir (split-plan dir src label) stem)
        by (reduce (fn [m f] (assoc m (:name f) f)) {} (:functions manifest))
        placed (reduce (fn [n [f p]]
                         (if (= p (:placement (get by f))) n
                           (do (println (str "SPLIT FAIL " stem " placement " f ": expected " p ", got "
                                             (:placement (get by f))))
                               (inc n))))
                       0 expect-where)
        proved (reduce (fn [n [f r]]
                         (if (= r (:recursion (:evidence (get by f)))) n
                           (do (println (str "SPLIT FAIL " stem " recursion " f ": expected " r ", got "
                                             (pr-str (:recursion (:evidence (get by f))))))
                               (inc n))))
                       0 expect-recursion)
        refused (reduce (fn [n [lbl edit reason needle]]
                          (+ n (expect-split-refusal dir (str stem "/" lbl) (edit src) reason needle)))
                        0 refusals)
        fails (+ placed proved refused)]
    (if (zero? fails)
      (do (println (str "SPLIT PASS " stem ": " (count expect-where) " placements, "
                        (count expect-recursion) " recursion proofs, " (count refusals) " refusals named"))
          0)
      fails)))

(defn outline-tests [dir]
  (split-app-tests dir "outline"
    [["plan-view" :client] ["item-row" :client] ["on-event" :client] ["prune" :client] ["tally" :client]
     ["find-item" :shared] ["depth-of" :shared] ["item-count" :shared] ["add-problem" :shared]
     ; ticking and removing are predicted in the browser: shared
     ["set-done" :shared] ["toggle-in" :shared] ["remove-in" :shared]
     ["add-in" :server] ["initial-plan" :server]]
    [["item-row" "structural"] ["tally" "structural"] ["prune" "structural"] ["find-item" "structural"]
     ["depth-of" "structural"] ["item-count" "structural"] ["parent-ids" "structural"]
     ["set-done" "structural"] ["toggle-in" "structural"] ["all-done?" "structural"]
     ["add-in" "structural"] ["remove-in" "structural"]]
    [; a walk that recurses on the item ITSELF, not on a child: never smaller
     ["walk-self"
      (fn [s] (replace-once s "(mapv (fn [k] (item-row k plan local q (inc depth))) kids)"
                            "(mapv (fn [k] (item-row it plan local q (inc depth))) kids)"))
      :not-portable "recursive on a call cycle"]
     ; a roll-up that rebuilds its input from its own children: [it] is no part of it
     ["tally-rewrap"
      (fn [s] (replace-once s "(let [t (tally k)]" "(let [t (tally {:kids [it]})]"))
      :not-portable "recursive on a call cycle"]
     ; recursion through the SEARCH TEXT, which never shrinks
     ["prune-on-query"
      (fn [s] (replace-once s "(mapv (fn [k] (prune k q)) (:kids it))" "(mapv (fn [k] (prune it (str q k))) (:kids it))"))
      :not-portable "recursive on a call cycle"]
     ; a tree type that can never end: an item that must hold an item
     ["endless-type"
      (fn [s] (replace-once s ":kids [:list 16 :item]}]\n          :plan" ":kids :item}]\n          :plan"))
      :bad-wire "cyclic wire type"]
     ; a plain type nested past the wire's depth bound has no sendable value
     ["too-deep-type"
      (fn [s] (replace-once s ":plan [:record {:items [:list 16 :item]}]}"
                            (str ":plan [:record {:items [:list 16 :item]}]\n          :deep "
                                 (reduce (fn [t _] (str "[:list 1 " t "]")) ":bool" (range 25)) "}")))
      :bad-wire "nests deeper than 24"]]))

(defn groceries-tests [dir]
  (split-app-tests dir "groceries"
    [["list-view" :client] ["on-event" :client] ["item-row" :client]
     ; a prediction is a CLIENT root: it runs in the browser, and the server
     ; half reuses the ones its :apply calls
     ["predict-add" :client] ["predict-tick" :shared] ["predict-qty" :shared]
     ["add-problem" :shared] ["tick-problem" :shared] ["find-item" :shared]
     ["add-item" :server] ["initial-list" :server]]
    []
    [; a prediction runs in the browser: one with an effect is refused, named
     ["predict-effect"
      (fn [s] (replace-once s "(defn predict-add [lst args]\n  (assoc lst"
                            "(defn predict-add [lst args]\n  (host/write \"adding\")\n  (assoc lst"))
      :not-portable "host/write"]
     ; a prediction must have the arity the shell calls it with
     ["predict-arity"
      (fn [s] (replace-once s ":predict predict-add" ":predict item-row"))
      :arity-mismatch "item-row"]
     ; an enum must list keywords
     ["one-of-bad"
      (fn [s] (replace-once s "[:one-of :produce :bakery :dairy :pantry :other]" "[:one-of :produce \"bakery\"]"))
      :bad-wire "one-of"]]))

(defn team-tests [dir]
  (split-app-tests dir "team"
    [["board-view" :client] ["card-view" :client] ["on-event" :client]
     ; the permission rule runs in both halves: the view offers only what a
     ; person may do, the server asks again
     ["can?" :shared] ["role-of" :shared] ["find-card" :shared]
     ["allow-move" :server] ["allow-card-op" :server] ["lead-only" :server]
     ["says-move" :server] ["add-card" :server] ["initial-board" :server]
     ; the roster's names label cards in the view, so it is shared — and
     ; the fixture below shows declaring it :private refuses the build
     ["team" :shared]
     ; predicted moves run in the browser and are the server's :apply too
     ["move-card" :shared] ["with-card" :shared]]
    []
    [; an app with history may not declare its own undo
     ["undo-reserved"
      (fn [s] (replace-once s ":intents {:add-card" ":intents {:undo {:params {} :check card-problem :apply delete-card} :add-card"))
      :reserved-name "undo"]
     ; the view may not read the roster's secrets: `team` is server-only data
     ; the moment it is declared :private
     ["roster-private"
      (fn [s] (replace-once s ":history 50 :undo-allow lead-only}" ":history 50 :undo-allow lead-only :private [team]}"))
      :not-portable "team"]
     ; :allow must take [who board args]
     ["allow-arity"
      (fn [s] (replace-once s ":allow allow-add" ":allow add-problem"))
      :arity-mismatch "add-problem"]]))

(defn triage-tests [dir]
  (split-app-tests dir "triage"
    [["inbox-view" :client] ["report-row" :client] ["on-event" :client] ["step-sel" :client] ["parse-id" :client]
     ["move-before" :shared] ["index-of-id" :shared] ["move-problem" :shared] ["initial-inbox" :server]]
    []
    [; the keymap is data the view builds: binding a key to data the server
     ; keeps private pulls that function into the browser, and is refused
     ["key-reaches-private"
      (fn [s] (replace-once (replace-once s ":server {:init initial-inbox :snapshot :inbox}"
                                          ":server {:init initial-inbox :snapshot :inbox :private [initial-inbox]}")
                            "\"?\" [:help]" "\"?\" [:help (count (:reports (initial-inbox)))]"))
      :not-portable "initial-inbox"]
     ; an effect hidden in a key binding is refused like any other
     ["key-effect"
      (fn [s] (replace-once s "\"?\" [:help]" "\"?\" [:help (host/write \"?\")]"))
      :not-portable "host/write"]]))

(defn ledger-tests [dir]
  (split-app-tests dir "ledger"
    [["ledger-view" :client] ["money" :client] ["parse-cents" :client] ["by-category" :client] ["chart" :client]
     ["total" :client] ["predict-add" :client] ["line-item" :shared] ["predict-remove" :shared]
     ["add-entry" :server] ["initial-ledger" :server]]
    []
    [; `entry` names the bundle's start point: an app may not define it
     ["entry-reserved"
      (fn [s] (str s "\n(defn entry [] 1)\n"))
      :reserved-name "entry"]
     ; `:exact` is a primitive type name, never an app's own
     ["exact-reserved"
      (fn [s] (replace-once s ":book [:record" ":exact [:int 0 1]\n          :book [:record"))
      :bad-wire "bad wire type name :exact"]]))

(defn order-parity!
  "Compile order-parity.bl to a bundle AND evaluate its `(parity-lines)` on
   BEAM, writing the answer beside the bundle. verify-order-parity.mjs holds
   the JS run to exactly these lines."
  [dir]
  (let [src (File/read! (str dir "/order-parity.bl"))
        lines (BeamLisp/eval (str src "\n(parity-lines)"))]
    (build-one dir "order-parity.bl" "order-parity.mjs")
    (File/write! (str dir "/out/order-parity.expected.json")
                 (str "[" (join-str (mapv js-str lines) ",\n ") "]\n"))
    (println (str "js-actors: order parity — " (count lines) " BEAM answers -> out/order-parity.expected.json"))))

(defn build [dir]
  (build-one dir "test.bl" "bundle.mjs")
  (order-parity! dir)
  (build-one dir "demo.bl" "demo.mjs")
  (build-one dir "super-demo.bl" "super-demo.mjs")
  (build-one dir "trace-demo.bl" "trace-demo.mjs")
  (build-one dir "quoted-view.bl" "quoted-view.mjs" ["quoted-view-core.bl"])
  (build-one dir "quoted-backend.bl" "quoted-backend.mjs" ["quoted-view-core.bl"])
  (build-one dir "quoted-frontend.bl" "quoted-frontend.mjs" ["quoted-view-core.bl"])
  (build-one dir "quoted-playground.bl" "quoted-playground.mjs" ["quoted-view-core.bl"])
  (build-one dir "portable-helper.bl" "portable-helper.mjs")
  (portable-helper-tests dir)
  (split-tests dir)
  (when-not (zero? (+ (outline-tests dir) (groceries-tests dir) (team-tests dir) (triage-tests dir) (ledger-tests dir)))
    (throw (ex-info "js-actors: app split tests failed" {})))
  (expect-diagnostic "(fn [] (try (File/read! \"/tmp/x\") (catch e 2)))"
                     "not in the checked ABI")
  ; an unsafe integer literal is emitted as an exact BigInt, never a Number
  (let [t (emit-text (an-lit 9007199254740993) {:tail false})]
    (when-not (some? (index-of t "9007199254740993n"))
      (throw (ex-info "js-actors: a big integer literal must be emitted exact" {:emitted t}))))
  ; a reference inside a vector literal is still audited
  (expect-diagnostic "(fn [x] [:a (File/read! x)])" "not in the checked ABI")
  (expect-diagnostic "(fn [x] [:a [(secret-io x)]])" "unresolved global js/secret-io")
  (let [fails (erlang/+ (erlang/+ (negative-tests) (positive-tests))
                        (erlang/+ (defserver-tests)
                                  (erlang/+ (defsupervisor-tests)
                                            (numeric-gate-tests))))]
    (if (zero? fails)
      0
      (throw (ex-info "js-actors: negative compiler tests failed" {:failures fails})))))

(defn main [argv]
  (let [dir (resolve-dir (if (empty? argv) "research/js-actors" (first argv)))]
    (cond
      (= "1" (System/get_env "JS_ACTORS_HELPER_ONLY"))
        (portable-helper-tests dir)
      (= "1" (System/get_env "JS_ACTORS_SPLIT_ONLY"))
        (let [fails (+ (split-tests dir) (outline-tests dir) (groceries-tests dir) (team-tests dir) (triage-tests dir) (ledger-tests dir))]
          (if (zero? fails) 0 (throw (ex-info "js-actors: split tests failed" {:failures fails}))))
      ; one app under apps/ by stem, for iterating on it alone
      (some? (System/get_env "JS_ACTORS_APP"))
        (let [stem (System/get_env "JS_ACTORS_APP")
              run (get {"outline" outline-tests "groceries" groceries-tests "team" team-tests
                        "triage" triage-tests "ledger" ledger-tests} stem)]
          (cond
            (nil? run) (throw (ex-info (str "js-actors: no app tests for " stem) {}))
            (zero? (run dir)) 0
            :else (throw (ex-info (str "js-actors: " stem " split tests failed") {}))))
      (= "1" (System/get_env "JS_ACTORS_ORDER_ONLY"))
        (order-parity! dir)
      :else
      (let [code (build dir)]
        (if (zero? code) code 1)))))

(main (BeamLisp/argv))
