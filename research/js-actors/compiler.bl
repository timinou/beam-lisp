; Build the actor demonstrations through the single production backend.
; The superseded split-placement/number-emitter experiments remain in git at
; db7a3f86. They are not an alternate compiler or an executable acceptance gate.
(ns js-actors-compiler (:require [js.actor :as actor] [bl.js :as js]))
(defn main [argv]
  (let [dir (actor/resolve-dir (if (empty? argv) "research/js-actors" (first argv)))
        graph (str dir "/canonical")
        _ (js/build! "core" {:out graph})
        opts {:native-manifest (str graph "/native-modules.json") :native-base "../canonical"}]
    (doseq [[app output extras]
            [["test.bl" "bundle.mjs" []] ["demo.bl" "demo.mjs" []]
             ["super-demo.bl" "super-demo.mjs" []] ["trace-demo.bl" "trace-demo.mjs" []]
             ["quoted-view.bl" "quoted-view.mjs" ["quoted-view-core.bl"]]
             ["quoted-backend.bl" "quoted-backend.mjs" ["quoted-view-core.bl"]]
             ["quoted-frontend.bl" "quoted-frontend.mjs" ["quoted-view-core.bl"]]
             ["quoted-playground.bl" "quoted-playground.mjs" ["quoted-view-core.bl"]]]]
      (actor/build-one dir app output extras opts))
    (actor/write-runtime! dir "./canonical/rt.mjs")))
(main (BeamLisp/argv))
