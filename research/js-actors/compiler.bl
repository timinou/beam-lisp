; compiler.bl — the bl-ANF → JavaScript backend, written in beam-lisp.
;
; This is the prototype's compiler stage. It runs on the existing BEAM host
; (through `bl run`), reads BL sources with the EXISTING reader, compiles them
; with the EXISTING compiler to canonical bl-ANF, and emits JavaScript from
; that ANF. It never interprets ANF and never re-parses BL: the only input to
; the emitter below is the validated bl-ANF vocabulary of priv/boot/anf.bl.
;
;   test.bl / runtime.bl        (beam-lisp source)
;     → BeamLisp.Ns.Reader      (the existing reader)
;     → BeamLisp.Ns.Compiler    (source → bl-ANF, the one IR)
;     → emit-js (this file)     (bl-ANF → JavaScript)
;     → out/bundle.mjs          (imports host.mjs; runs on Node or a browser)
;
; WHAT THIS FILE REFUSES, AND WHY IT REFUSES IT AT BUILD TIME
;
;   * any `:remote` outside the checked ABI allowlist (`host/…`, `erlang/…`,
;     and a closed map of core names onto the BL prelude).
;   * any `:global` that neither the sources define nor the prelude provides.
;   * unsupported literal values (a literal tuple/list in value position).
;
; The allowlist is deliberately a static table rather than a discovery
; mechanism: a closed set that says NO to everything else is the only version
; of this check that cannot silently widen.

(ns js-actors-compiler
  ; The clause MODEL, not a runtime dependency: `clause-plan` is a pure function
  ; of its arguments, and it is what turns a `proc/defserver` declaration into
  ; the clause list this backend renders. See the compiler's own notes below.
  (:require [proc.server :as pserver]
            [proc.super :as psuper]
            [codebase :as cb]
            [system.analyze :as an]
            [datom]
            ; the wire grammar both halves run; the build checks declarations
            ; against the SAME depth bound the authority enforces
            [split.wire :as wire]))

; ─────────────────────────────────────────────────────────────────────────────
; Reader-node accessors. Self-contained on purpose (no `:require`): a node is
; an Erlang tuple, and these functions are the whole surface this file needs.
; ─────────────────────────────────────────────────────────────────────────────

(defn n-unwrap [n]
  (if (and (erlang/is_tuple n) (= :meta (first (erlang/tuple_to_list n))))
    (second (erlang/tuple_to_list n))
    n))

(defn n-tag [n]
  (let [f (n-unwrap n)]
    (if (erlang/is_tuple f) (first (erlang/tuple_to_list f)) :scalar)))

(defn n-pos
  "The source position the reader recorded on a form, or nil. A reader form is
   `{:meta form pos}`; this reads `pos` off that wrapper only (never a
   position met on a non-list form)."
  [n]
  (if (and (erlang/is_tuple n)
           (>= (erlang/tuple_size n) 3)
           (= :meta (first (erlang/tuple_to_list n))))
    (nth (erlang/tuple_to_list n) 2)
    nil))

(defn with-pos
  "Re-wrap a rebuilt reader form in `pos`. `defn->fn-form` REBUILDS a node, and
   a rebuilt node that drops the reader's span loses the source location the
   compiler stamps onto the ANF (`:ann`). Preserving it is what lets the emitter
   name the source of a call, not just its shape."
  [form pos]
  (if (nil? pos) form (erlang/list_to_tuple (list :meta form pos))))

(defn n-items [n] (second (erlang/tuple_to_list (n-unwrap n))))
(defn n-name [n] (second (erlang/tuple_to_list (n-unwrap n))))
(defn sym-node [s] (erlang/list_to_tuple (list :symbol s)))
(defn list-node [xs] (erlang/list_to_tuple (list :list xs)))

(defn form-sym? [n s]
  (and (= :symbol (n-tag n)) (= s (n-name n))))

(defn defn-form? [n]
  (and (= :list (n-tag n))
       (let [its (n-items n)]
         (and (not (empty? its)) (form-sym? (first its) "defn")))))

(defn defn-name [n] (n-name (second (n-items n))))

(defn ns-form? [n]
  (and (= :list (n-tag n))
       (let [its (n-items n)]
         (and (not (empty? its)) (form-sym? (first its) "ns")))))

(defn defn->fn-form
  "Turn `(defn name [params] body…)` into `(fn name [params] body…)` — the
   named-fn form the existing compiler already understands, so a top-level
   definition needs no Env/Link machinery on this backend. A docstring and an
   attr-map are dropped, exactly as the AOT path drops them from the value."
  [n]
  (let [its (n-items n)
        name (second its)
        body0 (rest (rest its))
        body1 (if (and (not (empty? body0))
                       (erlang/is_binary (n-unwrap (first body0)))
                       (not (empty? (rest body0))))
                (rest body0)
                body0)
        body2 (if (and (not (empty? body1))
                       (= :map (n-tag (first body1)))
                       (not (empty? (rest body1))))
                (rest body1)
                body1)]
    (with-pos (list-node (cons (sym-node "fn") (cons name body2))) (n-pos n))))

; ─────────────────────────────────────────────────────────────────────────────
; JavaScript text helpers
; ─────────────────────────────────────────────────────────────────────────────

(defn js-escape [s]
  (apply str
    (map (fn [c]
           (cond
             (= c 34) "\\\""
             (= c 92) "\\\\"
             (= c 10) "\\n"
             (= c 13) "\\r"
             (= c 9) "\\t"
             (< c 32) (str "\\u00" (if (< c 16) "0" "") (Integer/to_string c 16))
             :else (erlang/list_to_binary (list c))))
         (erlang/binary_to_list s))))

(defn js-str [s] (str "\"" (js-escape s) "\""))

(defn join-str [xs sep]
  (if (empty? xs)
    ""
    (loop [i 1 acc (str (first xs))]
      (if (>= i (count xs))
        acc
        (recur (inc i) (str acc sep (nth xs i)))))))

(defn jsname
  "A JS identifier for a bl-ANF local name. ANF names are already unique per
   function (the compiler's fresh counter), so munging is only about legal
   characters and reserved words — the `v_` prefix settles both."
  [n]
  (str "v_"
       (apply str
         (map (fn [c]
                (if (or (and (>= c 97) (<= c 122))
                        (and (>= c 65) (<= c 90))
                        (and (>= c 48) (<= c 57)))
                  (erlang/list_to_binary (list c))
                  (str "_" c "_")))
              (erlang/binary_to_list n)))))

(defn fresh-tmp []
  (let [cur (erlang/get :js-actors-tmp)
        n (erlang/+ (if (= cur :undefined) 0 cur) 1)]
    (erlang/put :js-actors-tmp n)
    (str "t" n)))

(defn lit-js [v]
  (cond
    (= v nil) "null"
    (= v true) "true"
    (= v false) "false"
    (erlang/is_integer v)
      ; a safe integer is a JS Number; a larger one is a BigInt (the host's
      ; exact integer; host.mjs normalizes every result back to a Number when
      ; it fits). The numeric gate's `num-fold` refuses any unsafe literal, so
      ; no raw-Number fast path can ever see one: it stays on checked H.arith.
      (if (and (>= v -9007199254740991) (<= v 9007199254740991))
        (str v)
        (str "(" v "n)"))
    (erlang/is_float v) (str v)
    (erlang/is_binary v) (js-str v)
    (erlang/is_atom v) (str "H.kw(" (js-str (str v)) ")")
    :else (throw (ex-info (str "js-actors: unsupported literal " (pr-str v)
                               " — the JS backend carries numbers, strings, keywords,"
                               " booleans and nil only")
                          {:value v}))))

(def mod-rt (erlang/binary_to_atom "Elixir.BeamLisp.Ns.Rt"))
(def mod-core (erlang/binary_to_atom "Elixir.BeamLisp.Ns.Core"))
(def mod-transient (erlang/binary_to_atom "Elixir.BeamLisp.Transient"))
(def mod-host :host)
(def mod-erlang :erlang)

; ─────────────────────────────────────────────────────────────────────────────
; The ABI allowlist
; ─────────────────────────────────────────────────────────────────────────────

(def host-names
  "Every `host/…` leaf the JS host implements. MUST mirror host.mjs `PURE` +
   `RT_HOST`; the build fails closed on anything else."
  #{"kw" "kw-name" "is-kw" "cons" "is-cons" "is-enil" "cons-head" "cons-tail"
    "is-list" "empty-list" "list->array" "tup" "is-tup" "tup-el" "tup-size"
    "struct" "is-struct" "struct-mod" "struct-field" "is-vec" "vec-size" "vec-el"
    "vec-append" "vec-remove" "vec-to-list" "vec-from-list" "is-set"
    "set-from-list" "set-put" "set-remove" "set-has" "set-size" "set-to-list"
    "bmap" "empty-map"
    "is-map" "map-get" "map-put" "map-remove" "map-keys" "map-size"
    "eq" "identical" "lt" "is-nil" "is-int" "is-float" "is-num" "is-str"
    "is-bool" "is-fn" "to-str" "describe" "arith" "str-cat" "str-size" "str-codepoints" "str-slice" "str-cmp" "truthy"
    "park" "wait-until" "now" "state" "set-state" "self" "set-self" "run-turn"
    "make-frames" "ref" "write" "emit" "raise" "max-frames" "logical-stack"
    "critical-enter" "critical-leave" "park-release" "record-error"
    "input-size" "take-input" "wait-input"
    ; The mutable-table STORAGE leaves (runtime.bl section 5). They take no
    ; owner, heir, name or mode: ownership, transfer, access, naming and the
    ; atomic counter are BL decisions the table service takes ABOVE them, and
    ; `is-table` is a value predicate that never says whether a handle is alive.
    "table-new" "table-lookup" "table-insert" "table-delete" "table-size"
    "table-destroy" "table-snapshot" "is-table"
    "ex-kind" "ex-reason" "ex-trace"})

(def erlang-names
  "Every `:erlang` bif a guard (or a raw bif call) may reach."
  #{"==" "/=" "=:=" "=/=" "<" ">" "=<" ">=" "+" "-" "*" "rem" "is_integer"
    "is_float" "is_number" "is_binary" "is_tuple" "is_list" "is_pid"
    "is_reference" "is_port" "is_atom" "is_map" "tuple_size" "map_size" "abs"
    "length" "self"
    ; the exception bifs: the class/reason/reraise triple, the element/2 read a
    ; `__STACKTRACE__` binding compiles to, and the two halves of a struct test
    "raise" "throw" "exit" "element" "is_map_key" "map_get"})

(def remote-map
  "Remote references the existing compiler emits for core names, each mapped
   onto the BL prelude function that gives it meaning. Missing from here ⇒ the
   build fails closed, naming the pair."
