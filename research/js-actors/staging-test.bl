(ns js-actors-staging-test (:require [js.build :as build] [js.actor :as actor]))
(let [path "research/js-actors/staging-fixture.bl"
      temp (str (System/tmp_dir!) "/actor-staging-" (System/unique_integer (list :positive)) ".bl")
      source (File/read! path)]
  (try
    (File/write! temp (str source "\n(def never-run (throw (ex-info \"application initializer executed\" {})))\n"))
    (let [compiled (BeamLisp.Env/isolated (fn [] (build/compile-ns temp)))]
      (when-not (= ["plus-form" "twice-form" "main" "message" "never-run"] (mapv :name (:defs compiled)))
        (throw (ex-info "staging changed definition order" {:defs (:defs compiled)})))
      (when (BeamLisp.Env/bound? "js-actors.staging-fixture" "never-run")
        (throw (ex-info "staging leaked an application binding" {}))))
    (actor/build-one "research/js-actors" "staging-fixture.bl" "staging.mjs" [] {:prune true})
    (println "PASS shared namespace staging: transitive macro helpers, forward refs, isolated initialization")
    (finally (File/rm! temp))))
