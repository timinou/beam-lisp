(ns js-actors-native-module-test (:require [js.build :as build] [bl.json :as json]))
(let [dir (or (System/get_env "JS_ACTORS_NATIVE_ROOT") "research/js-actors")]
  (when-not (BeamLisp.Env/bound? "js.actor" "native-manifest-links")
    (let [source (File/read! (str dir "/compiler.bl"))]
      (BeamLisp/eval (subs source 0 (index-of source "\n(main (BeamLisp/argv))")))))
  (let [path (str (System/tmp_dir!) "/actor-native-module-" (System/unique_integer (list :positive)) ".bl")]
    (try
      (File/write! path "(ns ^:js actor.native-metadata)\n(def must-not-run (throw \"application initialization executed\"))\n(defn fixed? ([x] x) ([x y] y))\n(defn variable [x & more] x)\n(defn- hidden [x] x)\n")
      (let [manifest-path (str path ".json")
            metadata (BeamLisp.Env/isolated (fn [] (build/native-module-metadata (build/compile-ns path))))
            from-manifest (BeamLisp.Env/fetch! "js.actor" "native-manifest-links")]
        (try
          (File/write! manifest-path (json/encode {"version" 1 "modules" {"actor.native-metadata" metadata}}))
          (let [links (from-manifest manifest-path "../../../out")]
            (when-not (and (= :bl (:abi (get links "actor.native-metadata/fixed?")))
                           (= "d_fixed$Q" (:export (get links "actor.native-metadata/fixed?")))
                           (= #{1 2} (:arities (get links "actor.native-metadata/fixed?")))
                           (= "../../../out/ns/actor.native-metadata.mjs" (:path (get links "actor.native-metadata/fixed?")))
                           (= 1 (:variadic-min (get links "actor.native-metadata/variable")))
                           (not (contains? links "actor.native-metadata/hidden")))
              (throw (ex-info "Compiler manifest round trip failed" {:metadata metadata :links links}))))
          (println "PASS compiler-produced module manifest round trip, privacy and variadic calls")
          (finally (File/rm! manifest-path))))
      (let [root (str path ".build") target (str root "/actor/native-metadata.bl")]
        (try
          (File/mkdir_p! (Path/dirname target))
          (File/write! target "(ns ^:js actor.native-metadata)\n(defn fixed? ([x] x) ([x y] y))\n(defn variable [x & more] x)\n(defn- hidden [x] x)\n")
          (build/build {:roots [root] :entry "actor.native-metadata" :out (str root "/out") :core [] :host #{} :leaves #{}})
          (let [manifest (json/decode (File/read! (str root "/out/native-modules.json")))
                module (get (get manifest "modules") "actor.native-metadata")]
            (when-not (and (= 1 (get manifest "version")) (= true (get module "native"))
                           (= "d_fixed$Q" (get (get (get module "exports") "fixed?") "export"))
                           (not (contains? (get module "exports") "hidden")))
              (throw (ex-info "Ordinary build omitted checked native contracts" {:manifest manifest}))))
          (println "PASS ordinary build emits its checked native module manifest")
          (finally (File/rm_rf! root))))
      (let [scratch (str path ".scalar") prior (erlang/get :js-actors-native-links)
            compile (BeamLisp.Env/fetch! "js.actor" "compile-source")
            write (BeamLisp.Env/fetch! "js.actor" "write-bundle!")]
        (try
          (File/mkdir_p! scratch)
          (erlang/put :js-actors-native-links
            {"js-actors-native-helper/identity" {:path "../native-helper.mjs" :export "identity" :arities #{1}}
             "js-actors-native-helper/variable" {:path "../native-helper.mjs" :export "variable" :arities #{} :variadic-min 1}
             "js-actors-native-helper/canonical" {:abi :bl :path "../native-helper.mjs" :export "identity" :arities #{1}}
             "js-actors-native-helper/unused" {:path "../must-not-import.mjs" :export "unused" :arities #{0}}})
          (File/write! (str scratch "/scalar.bl") "(ns ^:js actor.native-scalar (:require [js-actors-native-helper :as h]))\n(defn main [] (h/identity 123))\n")
          (BeamLisp.Ns.Compiler/reset-fresh!)
          (write scratch "scalar.mjs" [] (compile (str scratch "/scalar.bl") "js"))
          (let [text (File/read! (str scratch "/out/scalar.mjs"))]
            (when-not (and (includes? text "import * as J") (includes? text "native-helper.mjs")
                           (not (includes? text "must-not-import.mjs")))
              (throw "Native-only call lost boundary helpers or imported unused modules")))
          (println "PASS native-only calls import their boundary; unused native modules are excluded")
          (BeamLisp.Env/isolated (fn []
            (let [link (tuple :Elixir.BeamLisp.Ns.AmbientProvider {1 :identity} nil)]
              (BeamLisp.Env/intern "js-actors-native-helper" "identity" :parent-value)
              (BeamLisp.Env/put_link "js-actors-native-helper" "identity" link)
              (BeamLisp.Ns.Compiler/reset-fresh!)
              (write scratch "warm.mjs" [] (compile (str scratch "/scalar.bl") "js"))
              (when-not (and (= (File/read! (str scratch "/out/scalar.mjs"))
                               (File/read! (str scratch "/out/warm.mjs")))
                             (= :parent-value (BeamLisp.Env/fetch! "js-actors-native-helper" "identity"))
                             (= (tuple :ok link) (BeamLisp.Env/link "js-actors-native-helper" "js-actors-native-helper/identity")))
                (throw (ex-info "Ambient provider changed target output or compilation mutated its parent"
                         {:same-output (= (File/read! (str scratch "/out/scalar.mjs")) (File/read! (str scratch "/out/warm.mjs")))
                          :value (BeamLisp.Env/fetch! "js-actors-native-helper" "identity")
                          :link (BeamLisp.Env/link "js-actors-native-helper" "js-actors-native-helper/identity")}))))))
          (println "PASS warm native linking ignores ambient BEAM providers and preserves parent bindings")
          (File/write! (str scratch "/variadic.bl") "(ns ^:js actor.native-variadic (:require [js-actors-native-helper :as h]))\n(defn main [] (h/variable 1 2 3))\n")
          (write scratch "variadic.mjs" [] (compile (str scratch "/variadic.bl") "js"))
          (println "PASS variadic native imports pass both audit and final emission")
          (File/write! (str scratch "/canonical.bl") "(ns ^:js actor.native-canonical (:require [js-actors-native-helper :as h]))\n(defn main [] (h/canonical {:values [1 2] :decimal 1.50M}))\n")
          (write scratch "canonical.mjs" [] (compile (str scratch "/canonical.bl") "js"))
          (let [text (File/read! (str scratch "/out/canonical.mjs"))]
            (when (or (includes? text "import * as J") (includes? text "J.argument") (includes? text "J.result"))
              (throw "Linked BL values crossed an unnecessary JavaScript conversion boundary")))
          (println "PASS linked BL collections and decimals retain their ABI without native conversion")
          (File/write! (str scratch "/quoted.bl") "(ns actor.quoted-data)\n(defn main [] (quote {:op :global :ns \"missing\" :name \"data-only\"}))\n")
          (write scratch "quoted.mjs" [] (compile (str scratch "/quoted.bl") "js"))
          (println "PASS quoted maps resembling IR remain opaque data")
          (finally (erlang/put :js-actors-native-links prior) (File/rm_rf! scratch))))
      (let [out (str path ".runtime") write (BeamLisp.Env/fetch! "js.actor" "write-runtime!")]
        (try
          (write dir out "../../../out/rt.mjs")
          (let [host (File/read! (str out "/host.mjs"))]
            (when-not (and (includes? host "../../../out/rt.mjs")
                           (not (includes? host "../../priv/lib/js/rt.mjs"))
                           (File/exists? (str out "/native.mjs"))
                           (File/exists? (str out "/native-values.mjs"))
                           (includes? (File/read! (str out "/native.mjs")) "./native-values.mjs"))
              (throw "Actor runtime did not bind the artifact's canonical value module")))
          (println "PASS actor runtime artifact binds one canonical value module URL")
          (finally (File/rm_rf! out))))
      (let [out (str path ".linked") link (BeamLisp.Env/fetch! "js.actor" "link-runtime!")]
        (try
          (link out "../../../out/actor")
          (doseq [name ["host" "native"]]
            (when-not (= (str "export * from \"../../../out/actor/" name ".mjs\";\n")
                         (File/read! (str out "/" name ".mjs")))
              (throw "Package did not link the frontend's canonical actor engine")))
          (println "PASS package runtime links the frontend engine without copying it")
          (finally (File/rm_rf! out))))
      (finally (File/rm! path)))))
