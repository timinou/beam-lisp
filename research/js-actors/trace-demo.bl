; A deliberately failing BL browser application. The generated Worker reports the
; target-defined logical BL source site, not JavaScript's Error.stack as a BL
; frame. It is separate from the healthy inbox and supervisor demos.
(defn trace-demo-leaf []
  (throw (ex-info "deliberate BL source failure" {:code :trace-demo})))

(defn main []
  (host/write "BL trace demo ready — deliberately raising in source")
  (trace-demo-leaf))
