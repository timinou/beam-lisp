; showcase.bl — ONE BL file, three artifacts.
;
; This is an ordinary BL program: a shared launch checklist. Nothing in it says
; "JavaScript", "HTTP" or "browser". The build (`compiler.bl`, `split-build`)
; reads the `split/defapp` declaration at the bottom and derives:
;
;   out/showcase-client.mjs   the browser half: the view, the local-state
;                             reducer and every check the browser can run —
;                             and NOTHING the view does not reach
;   out/showcase-server.mjs   the authority: state, intent handlers, private
;                             data and the server-only moderation rule
;   out/showcase.contract.json
;                             the wire: the snapshot type the server projects
;                             to, each intent's parameter types, and a digest
;                             both halves are stamped with
;
; WHERE A FUNCTION RUNS IS DERIVED, NOT DECLARED. A function lands in the client
; only because a client root (`:view`, `:on`, an intent `:check`) reaches it,
; and only if three independent oracles agree it is safe to ship: the source
; call graph (no dynamic or unresolved call), the whole-program effect analysis
; (no footprint, terminates), and the JS emitter's own ABI audit (no host or
; process leaf). Anything else REFUSES the build and names the path — try
; calling `flagged-title?` from `board-view` and rebuild.
;
; THE SERVER STAYS THE AUTHORITY. A shared `:check` runs in the browser first
; (instant feedback, same code) and again on the server before `:apply`. The
; browser only ever proposes an intent; the server re-checks the wire, the
; check, a server-only `:guard`, and its own snapshot invariant, then commits.

; ─────────────────────────────────────────────────────────────────────────────
; The model the server owns
; ─────────────────────────────────────────────────────────────────────────────

(defn initial-board
  "The server's state. `:next-id` and `:audit` never cross the wire: the
   snapshot type below declares only `:tasks`, so the projection drops them."
  []
  {:tasks [{:id 1 :title "Pick a launch date" :done true}
           {:id 2 :title "Write the release notes" :done false}
           {:id 3 :title "Tell the beta testers" :done false}]
   :next-id 4
   :audit []})

(defn find-task [tasks id]
  (some (fn [t] (if (= id (:id t)) t nil)) tasks))

(defn same-title? [a b] (= a b))

; ─────────────────────────────────────────────────────────────────────────────
; Shared checks — reached by both halves, so they run in the browser AND on the
; server. They read only the projected snapshot, which both sides hold.
; ─────────────────────────────────────────────────────────────────────────────

(defn max-tasks [] 12)

(defn add-problem
  "Why adding `title` would be refused, or nil. Instant in the browser; the
   server asks the same question again before it commits."
  [board args]
  (let [title (:title args)
        tasks (:tasks board)]
    (cond
      (= 0 (count title)) :empty-title
      (<= (max-tasks) (count tasks)) :board-full
      (some? (some (fn [t] (if (same-title? title (:title t)) t nil)) tasks)) :duplicate-title
      :else nil)))

(defn toggle-problem [board args]
  (if (nil? (find-task (:tasks board) (:id args))) :no-such-task nil))

(defn clear-problem [board _args]
  (if (= 0 (done-count (:tasks board))) :nothing-to-clear nil))

; ─────────────────────────────────────────────────────────────────────────────
; Server-only — reached from no client root. `blocked-words` is also declared
; `:private`, so the build refuses outright if the view ever reaches it.
; ─────────────────────────────────────────────────────────────────────────────

(defn blocked-words
  "A moderation list the browser must never download."
  []
  ["password" "secret" "api key"])

(defn contains-word? [text word]
  (let [n (count word)
        m (count text)]
    (loop [i 0]
      (cond
        (< m (+ i n)) false
        (= word (subs text i (+ i n))) true
        :else (recur (inc i))))))

(defn flagged-title?
  "The server-only guard: refuse titles that look like credentials."
  [board args]
  (if (some? (some (fn [w] (if (contains-word? (:title args) w) w nil)) (blocked-words)))
    :looks-like-a-credential
    nil))

(defn log-entry [board line]
  (assoc board :audit (conj (:audit board) line)))

(defn add-task [board args]
  (let [id (:next-id board)]
    (log-entry (assoc board
                      :tasks (conj (:tasks board) {:id id :title (:title args) :done false})
                      :next-id (inc id))
               (str "added " id))))

(defn toggle-task [board args]
  (log-entry (assoc board :tasks
                    (mapv (fn [t] (if (= (:id args) (:id t)) (assoc t :done (not (:done t))) t))
                          (:tasks board)))
             (str "toggled " (:id args))))

(defn clear-done [board _args]
  (log-entry (assoc board :tasks (filterv (fn [t] (not (:done t))) (:tasks board)))
             "cleared done"))

; ─────────────────────────────────────────────────────────────────────────────
; Client-only — the browser's own state. The server never sees `:draft` or
; `:filter`; typing and filtering cost no network round trip.
; ─────────────────────────────────────────────────────────────────────────────

(defn initial-local [] {:draft "" :filter :all})

(defn on-event
  "Reduce one UI event. Returns the next local state and, optionally, ONE
   intent to propose. The client shell runs the intent's shared check before
   sending; a refused intent keeps the old local state (the draft survives)."
  [local event]
  (let [kind (first event)]
    (cond
      (= kind :draft) {:local (assoc local :draft (nth event 1))}
      (= kind :filter) {:local (assoc local :filter (nth event 1))}
      (= kind :submit) {:local (assoc local :draft "")
                        :intent [:add-task {:title (:draft local)}]}
      (= kind :toggle) {:local local :intent [:toggle-task {:id (nth event 1)}]}
      (= kind :clear) {:local local :intent [:clear-done {}]}
      :else {:local local})))

(defn done-count [tasks]
  (count (filterv (fn [t] (:done t)) tasks)))

(defn visible? [filter task]
  (cond
    (= filter :open) (not (:done task))
    (= filter :done) (:done task)
    :else true))

(defn plural [n word] (str n " " word (if (= n 1) "" "s")))

(defn progress-label [tasks]
  (let [total (count tasks)
        done (done-count tasks)]
    (if (= total 0)
      "Nothing on the list yet"
      (str done " of " total " done"))))

(defn pending-op? [pending op id]
  (some? (some (fn [p] (if (and (= op (:op p)) (= id (:id (:args p)))) p nil)) pending)))

(defn task-row [task pending]
  (let [busy (pending-op? pending :toggle-task (:id task))
        done (if busy (not (:done task)) (:done task))]
    [:li {:key (str "t" (:id task))
          :class (str "task" (if done " done" "") (if busy " pending" ""))}
     [:button {:class "check" :aria-pressed done
               :aria-label (str "Toggle " (:title task))
               :on-click [:toggle (:id task)]}
      (if done "✓" "")]
     [:span {:class "title"} (:title task)]
     (if busy [:small {:class "tag"} "saving"] "")]))

(defn ghost-row [p]
  [:li {:key (str "p" (:request p)) :class "task ghost"}
   [:span {:class "check"} ""]
   [:span {:class "title"} (:title (:args p))]
   [:small {:class "tag"} "sending"]])

(defn filter-tab [current value label]
  [:button {:class (if (= current value) "tab on" "tab")
            :aria-pressed (= current value)
            :on-click [:filter value]}
   label])

(defn note-banner [note]
  (if (nil? note)
    ""
    [:p {:class (str "note " (name (:where note)))}
     [:strong {} (cond
                   (= :client (:where note)) "Checked in your browser: "
                   (= :server (:where note)) "Refused by the server: "
                   :else "Not sent: ")]
     (name (:reason note))]))

(defn board-view
  "The whole screen as data. `board` is the last snapshot the server
   confirmed, `local` is this tab's own state, and `sync` is what the client
   shell knows about the link: pending intents, the last refusal, revision."
  [board local sync]
  (let [tasks (:tasks board)
        shown (filterv (fn [t] (visible? (:filter local) t)) tasks)
        adds (filterv (fn [p] (= :add-task (:op p))) (:pending sync))
        open (- (count tasks) (done-count tasks))]
    [:section {:class "board"}
     [:header {:class "head"}
      [:h1 {} "Launch checklist"]
      [:p {:class "sub"} (str (progress-label tasks) " · " (plural open "task") " open")]]
     [:div {:class "composer"}
      [:input {:type "text" :value (:draft local) :maxlength 48
               :placeholder "Add a task and press Enter"
               :aria-label "New task title"
               :on-input [:draft] :on-enter [:submit]}]
      [:button {:class "add" :on-click [:submit]} "Add"]]
     (note-banner (:note sync))
     [:nav {:class "tabs"}
      (filter-tab (:filter local) :all "All")
      (filter-tab (:filter local) :open "Open")
      (filter-tab (:filter local) :done "Done")]
     [:ul {:class "tasks"}
      (mapv (fn [t] (task-row t (:pending sync))) shown)
      (mapv ghost-row adds)]
     [:footer {:class "foot"}
      [:small {} (str "revision " (:revision sync))]
      [:button {:class "clear" :disabled (= 0 (done-count tasks)) :on-click [:clear]}
       "Clear done"]]]))

; ─────────────────────────────────────────────────────────────────────────────
; The declaration the build reads
; ─────────────────────────────────────────────────────────────────────────────

(split/defapp launch-board
  {:wire {:task [:record {:id [:int 1 9999] :title [:text 1 48] :done :bool}]
          :board [:record {:tasks [:list 12 :task]}]}
   :server {:init initial-board :snapshot :board :private [blocked-words]}
   :client {:init initial-local :view board-view :on on-event}
   :intents {:add-task {:params {:title [:text 1 48]}
                        :check add-problem :guard flagged-title? :apply add-task}
             :toggle-task {:params {:id [:int 1 9999]}
                           :check toggle-problem :apply toggle-task}
             :clear-done {:params {}
                          :check clear-problem :apply clear-done}}})
