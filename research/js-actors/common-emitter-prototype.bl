(ns common-emitter.prototype (:require [js.actor :as actor]))
(let [out "/tmp/bl-common-kernel"
      values "file:///tmp/bl-actor-module-prototype/rt.mjs"
      kernel (actor/compile-source (str (actor/runtime-directory) "/runtime.bl") "js")]
 (File/mkdir_p! (str out "/out"))
 (File/write! (str out "/fixture.bl")
  "(ns ^:js common.fixture)\n(defn child [parent] (rt-send parent [:answer 42]))\n(defn main [] (let [me (rt-self) p (rt-spawn-owned child [me])] (receive [:answer n] (when-not (= n 42) (throw (js/Error. \"wrong reply\"))) (after 1000 (throw (js/Error. \"receive timed out\"))))) (.log js/console \"COMMON EMITTER ACTOR PASS\"))")
 (let [app (actor/compile-source (str out "/fixture.bl") "js")
       defs (actor/prune-defs (vec (concat kernel app)) ["main" "bl-main"])]
  (actor/write-runtime! out values)
  (File/write! (str out "/module.mjs")
   (String/replace (File/read! (str (actor/runtime-directory) "/module.mjs")) "'../rt.mjs'" (pr-str values)))
  (File/write! (str out "/out/common.mjs")
   (str "import * as H from '../host.mjs';import * as Control from '../module.mjs';import * as J from '../native.mjs';const rt=H.newRuntime();\n"
    (actor/emit-common-init defs) "\nawait H.init(rt);H.def(rt,'js/entry',H.ref(rt,'js','main'));await H.boot(rt);"))))
