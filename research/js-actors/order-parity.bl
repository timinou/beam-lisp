; order-parity.bl — one portable program, run on BOTH targets.
;
; The build evaluates `(parity-lines)` on BEAM and writes the answer to
; out/order-parity.expected.json; the same source compiles to
; out/order-parity.mjs, whose `main` prints the lines it computes in JS.
; verify-order-parity.mjs runs the bundle and requires the two to be equal,
; line for line. Nothing here is target-specific: the printer is BL too, so
; the comparison never trusts either host's own printer.
;
; What it pins:
;   compare     BL's total order across kinds, strings by code point
;   sort        with no comparator, a boolean one, a numeric one, `<` / `>`
;               (strict: equal keys come out REVERSED), and a comparator that
;               is NOT an order at all — its answer depends on the exact
;               sequence of comparisons, so only a faithful port of
;               lists:sort/2 agrees
;   sort-by     a keyword key, a named comparator, a lambda comparator
;   computed    a function value chosen from data and then called
;   combinators comp / partial / juxt / complement / constantly / identity /
;               apply, and a fold that composes closures of its own kind
;   prelude     every? remove keep mapcat group-by frequencies reverse second
;               get-in assoc-in update-in select-keys take range even?/odd?

; ── a printer both targets share ─────────────────────────────────────────────

(defn pj-items [xs]
  (reduce (fn [acc x] (if (= acc "") (pj x) (str acc " " (pj x)))) "" xs))

(defn pj [x]
  (cond
    (nil? x) "nil"
    (= x true) "true"
    (= x false) "false"
    (int? x) (str x)
    (string? x) (str "\"" x "\"")
    (keyword? x) (str ":" (name x))
    (vector? x) (str "[" (pj-items x) "]")
    (map? x) (str "{" (pj-items (mapv (fn [k] [k (get x k)]) (sort (keys x)))) "}")
    :else (str "(" (pj-items x) ")")))

; ── inputs ───────────────────────────────────────────────────────────────────

(defn lcg-list
  "n pseudo-random ints in [0, m): the same sequence on both targets."
  [n m seed]
  (loop [i 0 s seed acc []]
    (if (< i n)
      (let [s2 (erlang/rem (+ (* s 1103) 12345) 65521)]
        (recur (inc i) s2 (conj acc (erlang/rem s2 m))))
      acc)))

(defn chaos
  "Not an order: whether `a` goes first depends on the pair alone, and the
   relation is neither transitive nor antisymmetric."
  [a b]
  (= 0 (erlang/rem (+ (* a 7) (* b 13)) 3)))

(defn by-length [a b] (- (count a) (count b)))

(defn orderings []
  {:id :id
   :title (fn [t] (:title t))
   :newest (fn [a b] (compare b a))})

(defn tasks []
  [{:id 3 :title "b" :done false} {:id 1 :title "a" :done true}
   {:id 2 :title "b" :done true} {:id 5 :title "É" :done false}
   {:id 4 :title "c" :done false}])

; ── the cases ────────────────────────────────────────────────────────────────

(defn cases []
  [["compare-kinds" (mapv (fn [p] (compare (first p) (nth p 1)))
                          [[nil false] [false true] [true 0] [0 "a"] ["a" :a] [:a (list 1)]
                           [(list 1) [1]] [1 2] [2 1] ["b" "a"] [:b :a] [[1 2] [1 3]]
                           [[1 2] [1]] [(list) (list 1)] ["é" "z"] ["\uff5e" "😀"]
                           [-5 3] [7 7]])]
   ["sort-default" (sort [3 nil "b" :k 1 false [1 2] "a" true (list 1) [1] :a -2])]
   ["sort-strings" (sort ["zeta" "É" "e" "😀" "\uff5e" "" "Z" "é"])]
   ["sort-empty" [(sort []) (sort-by :id []) (sort [7])]]
   ["sort-lt" (sort < (lcg-list 17 9 4))]
   ["sort-gt" (sort > (lcg-list 17 9 5))]
   ["sort-le" (sort <= [3 1 2 1 3])]
   ["sort-numeric-cmp" (sort (fn [a b] (- b a)) (lcg-list 12 50 6))]
   ["sort-not-an-order" (sort chaos (lcg-list 23 40 7))]
   ["sort-not-an-order-2" (sort chaos (lcg-list 9 11 8))]
   ["sort-junk-cmp" (sort (fn [a b] :x) [3 1 2 5 4])]
   ["sort-big" (sort (lcg-list 60 1000 9))]
   ["sort-strict-dupes" (mapv :id (sort-by :title < (tasks)))]
   ["sort-by-kw" (mapv :id (sort-by :title (tasks)))]
   ["sort-by-named-cmp" (sort-by (fn [s] s) by-length ["ccc" "a" "bb" "dd" "e"])]
   ["sort-by-lambda-cmp" (mapv :id (sort-by :id (fn [a b] (compare b a)) (tasks)))]
   ["sort-vectors" (sort [[2 1] [1 2 3] [1 2] [1] [] [2]])]
   ["computed-call" (mapv (fn [k]
                            (let [f (get (orderings) k)]
                              (mapv :id (if (= k :newest)
                                          (sort-by :id f (tasks))
                                          (sort-by f (tasks))))))
                          [:id :title :newest])]])

(defn both [p q] (fn [x] (and (p x) (q x))))
(defn adder [n] (fn [x] (+ x n)))
(defn all-of [preds] (reduce both (constantly true) preds))

(defn hof-cases []
  (let [ts (tasks)]
    [["comp" [((comp inc inc) 1) ((comp) 5) ((comp str :title) (first ts)) ((comp inc inc inc inc) 0)
              ((comp (partial * 2) inc) 3)]]
     ["partial" [((partial + 1) 2) ((partial + 1 2) 3) ((partial + 1 2 3) 4) ((partial + 1 2 3 4) 5)
                 ((partial str "a") "b" "c")]]
     ["juxt" [((juxt :id :title) (first ts)) ((juxt inc dec identity) 5) ((juxt :a :b :c :d) {:a 1 :d 4})]]
     ["complement" [((complement :done) (first ts)) (mapv (complement even?) [1 2 3]) ((complement (fn [] true)))]]
     ["constantly-identity" [((constantly 7) 1 2 3) (identity :x) (mapv identity [1 2])]]
     ["apply" [(apply + [1 2 3]) (apply str "a" ["b" "c"]) (apply max 1 2 [9 3]) (apply (fn [& xs] (count xs)) (range 5))]]
     ["closure-fold" [(mapv (all-of [even? (fn [x] (< 2 x))]) (range 7))
                      (mapv (all-of []) [1 2]) ((both (both even? pos?) (fn [x] (< x 10))) 4)
                      (mapv (adder 10) [1 2]) ((reduce (fn [f g] (comp g f)) identity [inc (adder 5) (partial * 3)]) 1)]]
     ["every-remove-keep" [(every? :done ts) (every? :id ts) (every? odd? []) (mapv :id (remove :done ts))
                           (keep (fn [t] (when (:done t) (:id t))) ts) (not-any? :done [])]]
     ["mapcat-group-freq" [(mapcat (fn [t] [(:id t) (:id t)]) ts)
                           (let [g (group-by :done ts)] [(mapv :id (get g true)) (mapv :id (get g false))])
                           (let [f (frequencies (mapv :title ts))] [(get f "b") (get f "a") (get f "É")])]]
     ["seq-helpers" [(reverse [1 2 3]) (second [7 8 9]) (second []) (take 2 [1 2 3]) (take 5 [1]) (range 4)
                     ; an EMPTY lazy result (keep/mapcat/remove/range) is left out on
                     ; purpose: on BEAM it is `=` to nil yet prints `()` and is truthy,
                     ; which no single JS value is (README, "known divergences")
                     (take 2 []) (reverse [])
                     (mapv even? (range 4)) (mapv odd? [-3 -2])]]
     ["nested-maps" [(get-in {:a {:b 2}} [:a :b]) (get-in nil [:a]) (assoc-in {} [:a :b] 1)
                     (update-in {:a {:n 1}} [:a :n] inc) (update-in {:a {:n 1}} [:a :n] + 10)
                     (select-keys {:a 1 :b 2} [:a :c])]]]))

(defn parity-lines []
  (mapv (fn [c] (str (first c) " " (pj (nth c 1)))) (into (cases) (hof-cases))))

(defn main []
  (let [ls (parity-lines)]
    (loop [i 0]
      (if (< i (count ls))
        (do (println (str "ORDER " (nth ls i))) (recur (inc i)))
        (println "ORDER-DONE")))))
