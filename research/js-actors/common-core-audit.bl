; Read-only migration pressure test: canonical core through the actor front end.
; This inventories linking gaps; it does not claim those calls execute yet.
(ns js-actors-common-core-audit
  (:require [js.actor :as actor] [bl.js :as js] [system.ir :as ir] [bl.json :as json]))
(defn audit-source [path]
  (let [defs (actor/compile-source path "js")
        leaves (js/leaf-names) calls (atom []) globals (atom #{}) ops (atom #{})
        providers #{(BeamLisp.Link/module_for "rt") (BeamLisp.Link/module_for "core")}]
    (doseq [definition defs]
      (ir/rewrite
        (fn [node]
          (swap! ops conj (:op node))
          (when (= :remote (:op node))
            (let [key (str (:mod node) "/" (:fun node) "/" (count (:args node)))
                  kind (cond (actor/remote-ok? (:mod node) (:fun node)) :actor-allowed
                             (contains? leaves key) :canonical-leaf
                             (contains? providers (:mod node)) :compiled-provider
                             :else :unresolved)]
              (swap! calls conj {:key key :kind kind})))
          (when (and (= :global (:op node)) (not= "js" (:ns node)))
            (swap! globals conj (str (:ns node) "/" (:name node))))
          node) (:node definition)))
    {:path path :definitions (count defs) :definition-kinds (frequencies (map :kind defs))
     :ops (vec (sort @ops)) :call-kinds (frequencies (map :kind @calls))
     :remote-contracts (vec (sort-by :key (distinct @calls)))
     :nonlocal-globals (vec (sort @globals))}))
(let [boot (Path/dirname (BeamLisp.Loader/source_path "core"))
      dir (or (System/get_env "JS_ACTORS_NATIVE_ROOT") "research/js-actors")
      result {:schema "beam-lisp.actor-core-audit" :version 1
              :sources (mapv (fn [name] (audit-source (str boot "/" name ".bl"))) ["rt" "core"])}]
  (File/write! (str dir "/out/common-core-audit.json") (str (json/encode result) "\n"))
  (println "PASS canonical core frontend audit; runtime/linking gaps remain explicit"))
