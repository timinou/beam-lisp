; Host callbacks share the actor machine and capture canonical BL values.
(ns ^:js actor.callback-values)
(defn increment [x] (+ x 1))
(defn waiting [x] (receive m m))
(defn main []
  (let [offset 3
        local (fn [x] (+ x offset))
        both (fn ([x] (+ x 1)) ([x y] (+ x y)))
        mixed (fn ([x] x) ([x y] (receive m m)))
        xs #js [1 2 3]]
    (.log js/console
      #js {:global (js/Reflect.apply increment nil #js [2])
           :closure (js/Reflect.apply local nil #js [2])
           :arities (js/Reflect.apply both nil #js [2 4])
           :refused (try (.map xs waiting) false (catch e true))
           :mixedRefused (try (.map xs mixed) false (catch e true))})))
