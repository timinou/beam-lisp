(ns js-actors-native-test (:require [js.actor :as actor] [bl.js :as js] [bl.json :as json]))
(let [source-root (or (System/get_env "JS_ACTORS_NATIVE_ROOT") "research/js-actors")
      dir (str (System/tmp_dir!) "/bl-native-actors-" (System/unique_integer (list :positive)))
      graph "/tmp/bl-actor-module-prototype"
      manifest (str graph "/native-modules.json")
      base (str "file://" graph)]
  (File/mkdir_p! dir)
  (doseq [name ["native-fixture.bl" "numeric-values.bl" "callback-values.bl" "linked-values.bl" "native-helper.mjs" "js-actors-native-helper.bl"]]
    (File/cp! (str source-root "/" name) (str dir "/" name)))
  (BeamLisp.Env/add_search_path dir)
  (actor/write-runtime! dir (str base "/rt.mjs"))
  (println (str "native outputs: " dir))
  (let [build (BeamLisp.Env/fetch! "js.actor" "build-one")]
    (build dir "native-fixture.bl" "native-fixture.mjs" []
      {:native-manifest manifest :native-base base :native-links {"js-actors-native-helper/identity" {:path "../native-helper.mjs" :export "identity" :arities #{1}}}
       :prune (= "1" (System/get_env "JS_ACTORS_NATIVE_PRUNE"))})
    (build dir "numeric-values.bl" "numeric-values.mjs" [] {:prune true :native-manifest manifest :native-base base})
    (build dir "callback-values.bl" "callback-values.mjs" [] {:prune true :native-manifest manifest :native-base base})
    (build dir "linked-values.bl" "linked-values.mjs" []
      {:prune true :native-manifest manifest :native-base base :native-links {"js-actors-native-helper/canonical"
        {:abi :bl :path "../native-helper.mjs" :export "identity" :arities #{1}}}}))
  (let [compile (BeamLisp.Env/fetch! "js.actor" "compile-source")
        emit (BeamLisp.Env/fetch! "js.actor" "emit-common-init")
        canonical {:modules (get (json/decode (File/read! manifest)) "modules")
                   :leaves (js/leaf-names)}
        path (str (System/tmp_dir!) "/native-refusal-" (System/unique_integer (list :positive)) ".bl")
        cases [["(ns actor.unmarked) (defn main [] #js [])" "requires (ns ^:js"]
               ["(ns ^:js actor.missing) (defn main [] (js/JSON.stringify {:x 1}))" "missing #js"]
               ["(ns ^:js actor.receiver) (defn main [] (.push [1] 2))" "known BL value"]
               ["(ns ^:js actor.unknown) (defn main [] (File/read! \"/tmp/no\"))" "unresolved"]
               ["(ns ^:js actor.arity (:require [js-actors-native-helper :as h])) (defn main [] (h/identity 1 2))" "wrong native import arity"]
               ["(ns ^:js actor.importcollection (:require [js-actors-native-helper :as h])) (defn main [] (let [x [1]] (h/identity x)))" "missing #js"]
               ["(ns actor.import (:require [js-actors-native-helper :as h])) (defn main [] (h/identity 1))" "native imports require"]]]
    (erlang/put :js-actors-native-links {"js-actors-native-helper/identity" {:path "../native-helper.mjs" :export "identity" :arities #{1}}})
    (try
      (doseq [[source expected] cases]
        (File/write! path source)
        (let [message (try (let [defs (compile path "js")]
                             (let [missing (atom [])]
                              (emit defs (assoc canonical :used (atom #{}) :missing missing))
                              (when (seq @missing) (throw (ex-info "unresolved links" {}))))
                             "accepted") (catch error (ex-message error)))]
          (when-not (String/contains? message expected)
            (throw (ex-info "native refusal mismatch" {:expected expected :actual message})))
          (println (str "PASS native refusal: " expected))))
      (finally (File/rm! path) (erlang/erase :js-actors-native-links))))
  (let [compile (fn [src]
                  (:node (first (actor/compile-top-form
                   (BeamLisp.Ns.Reader/read_one (str "(def candidate " src ")")) "js" "<native fixture>"))))
        prune (BeamLisp.Env/fetch! "js.actor" "prune-defs")
        defs [{:name "main" :node (compile "(fn [] (rt-spawn child []))")}
              {:name "bl-main" :node (compile "(fn [] nil)")}
              {:name "rt-spawn" :node (compile "(fn [] nil)")}
              {:name "child" :node (compile "(fn [] (receive x x))")}
              {:name "rt-receive" :node (compile "(fn [] nil)")}
              {:name "unused" :node (compile "(fn [] nil)")}]
        kept (set (map :name (prune defs ["main" "bl-main"])))]
    (when-not (= #{"main" "bl-main" "child" "rt-spawn" "rt-receive"} kept)
      (throw (ex-info "pruning lost function value or receive support" {:kept kept})))
    (println "PASS pruning retains function values and hidden receive support")
    (let [dynamic (assoc (first defs) :node (compile "(fn [name] (host/ref \"js\" name))"))
          all (into [dynamic] (rest defs))]
      (when-not (= (count all) (count (prune all ["main" "bl-main"])))
        (throw (ex-info "dynamic registry lookup must retain all definitions" {})))
      (println "PASS pruning retains the whole bundle for dynamic registry lookup")))
)
