; quoted-backend.bl — the SERVER-SIDE half of the quoted-view prototype: a BL
; actor that owns the version, answers one browser intent event at a time, and
; writes one typed result line per request.
;
; THE DECISION IS NOT HERE. The authorization rule — which principal may raise
; which intent, and whether the version the browser sent is the version the
; server holds — lives in `quoted-view-core.bl` (`qv-intent-apply`, reached
; through its browser-wire adapter `qv-intent-apply-wire`). This file is an
; ACTOR: it holds the two state values, forwards one event, and prints what the
; core answered. It re-implements no check, so the actor and the pure core can
; never disagree.
;
; THE BUNDLE IS BUILT FROM THREE SOURCES —
;     runtime.bl + quoted-view-core.bl + quoted-backend.bl
; — the same `runtime + core + app` shape the demo bundle uses, so the evaluator
; has ONE definition shared by every bundle. `compiler.bl`'s `build-one` takes
; the optional extra source list; a bundle that omits it is compiled exactly as
; before.
;
; THE WIRE. `host.mjs` delivers a browser event as `[:browser <topic> <payload>]`
; where `topic` is a keyword (the intent name) and `payload` is a string (the
; canonical decimal version the browser believes is current). The payload is a
; STRING because the checked ABI has no number parser: the core compares it, by
; exact canonical equality, against `(host/to-str expected)`; it never parses a
; digit, so a wire like `"07"`, `"7.0"` or `"7e0"` is refused rather than
; silently rounded.
;
; WHAT THE ACTOR HOLDS, IN ITS OWN STATE:
;
;   * `version`  the version the server believes is current. It advances ONLY
;                when the core answers `[:ok …]`; a refusal leaves it untouched,
;                so the request after a refusal still sees the correct version.
;   * `count`    how many browser events this actor has handled. It advances on
;                EVERY event, accepted or refused, so each result line carries a
;                distinct, monotonic sequence the HTTP host can correlate on.
;
; ONE LINE PER REQUEST, safely parseable: the fixed prefix, the sequence, then
; the typed BL result through `host/describe`. The result is the core's own
; value (`[:ok {:intent … :version …}]` / `[:refused […]]`), never a string this
; actor authored, so the line is exactly the core's answer.

; ─────────────────────────────────────────────────────────────────────────────
; The server-local session values
; ─────────────────────────────────────────────────────────────────────────────

(defn qb-principal
  "The server's OWN session principal. A browser never supplies this and no
   request field can change it; it is a literal argument to the core."
  [] :viewer)

(defn qb-grants
  "The server's OWN principal→intent grant map. The single-user demo grants
   `:viewer` exactly the one intent the view can raise."
  [] {:viewer [:increment]})

(defn qb-version
  "The version the server believes is current before any request."
  [] 7)

; ─────────────────────────────────────────────────────────────────────────────
; One result line
; ─────────────────────────────────────────────────────────────────────────────

(defn qb-result-line
  "`QV-BACKEND RESULT <count> <describe result>`. The prefix and the two spaces
   are literals; the sequence and the typed result are written by `host/describe`,
   which quotes and escapes strings, so a refused wire can never break the frame."
  [n result]
  (host/str-cat "QV-BACKEND RESULT " (host/describe n) " " (host/describe result)))

; ─────────────────────────────────────────────────────────────────────────────
(defn qb-contract-line []
  (let [c (qv-wire-contract)]
    (host/str-cat "QV-BACKEND CONTRACT "
                  (host/describe (:schema c)) " "
                  (host/describe (:op c)) " "
                  (host/describe (:field c)) " "
                  (host/describe (:version-chars c)) " "
                  (host/describe (:payload-chars c)))))

; ─────────────────────────────────────────────────────────────────────────────
; The actor
; ─────────────────────────────────────────────────────────────────────────────

(defn main
  "Register as the host's input sink, announce readiness, then serve one browser
   event at a time forever. A refusal is a VALUE (`[:refused …]`), never a raise,
   so a malformed or unauthorized request cannot kill the actor: the next event
   is answered by the same loop with the same version."
  []
  (rt-register-input!)
  (host/write (qb-contract-line))
  (host/write "QV-BACKEND READY")
  (loop [version (qb-version) count 0]
    (receive
      [:browser topic payload]
        (let [result (qv-intent-apply-wire [:intent topic]
                                           (qb-principal) (qb-grants)
                                           version payload)
              n (inc count)
              next-version (if (host/eq :ok (host/vec-el result 0))
                             (host/map-get (host/vec-el result 1) :version version)
                             version)]
          (do
            (host/write (qb-result-line n result))
            (recur next-version n))))))
