(ns js-actors-pattern-test (:require [js.pattern :as pattern] [js.emit :as emit] [clojure.string :as string]))
(let [dir (or (System/get_env "JS_ACTORS_NATIVE_ROOT") "research/js-actors")
      patterns [["nilField" {:pop :pmap :pairs [[{:op :lit :val :value} {:pop :plit :val nil}]]}]
                ["intLiteral" {:pop :plit :val 1}]
                ["floatLiteral" {:pop :plit :val 1.0}]
                ["tuple" {:pop :ptuple :elems [{:pop :plit :val :pair} {:pop :pvar :name "_"}]}]
                ["recordField" {:pop :pstruct :mod :Example :fields [[:value {:pop :plit :val nil}]]}]
                ["vector" {:pop :pstruct :mod :Elixir.BeamLisp.Vector :fields [[:items {:pop :ptuple :elems [{:pop :plit :val 1}]}]]}]]
      _ (emit/reset-state!)
      text (str "import * as R from '../../../priv/lib/js/rt.mjs';\n"
                (apply str (map (fn [[name p]]
                  (let [counter (atom 0) lines (pattern/lines p "value" "M" {:runtime "R"
                         :temporary (fn [] (str "t" (swap! counter inc))) :local emit/local-name
                         :literal emit/lit-js :string emit/js-str})]
                    (str "export function " name "(value){M:{\n" (string/join "\n" lines) "\nreturn true;}return false;}\n"))) patterns)))]
  (File/write! (str dir "/out/pattern-cases.mjs")
    (str "import * as R from '../../../priv/lib/js/rt.mjs';\n" (string/join "\n" (emit/kw-decls)) "\n"
         (subs text (count "import * as R from '../../../priv/lib/js/rt.mjs';\n"))))
  (println "PASS shared pattern lowering fixture"))
