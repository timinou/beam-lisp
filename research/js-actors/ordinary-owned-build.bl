(ns ordinary-owned-build (:require [js.actor :as actor]))
(BeamLisp.Env/add_search_path "test/js/fixtures")
(actor/build-one "/tmp/bl-ordinary-owned" "ordinary-owned.bl" "ordinary-owned.mjs" []
