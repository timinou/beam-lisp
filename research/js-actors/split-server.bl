; split-server.bl — the AUTHORITY half of every `split/defapp` app.
;
; This file is generic: it names no app function. The build compiles it with
; the app's server closure and a generated glue file that supplies
;
;   (split-contract)          the contract as BL data
;   (split-digest)            its SHA-256, the identity both halves carry
;   (split-server-init)       the app's :server :init
;   (split-check op b a)      the intent's shared :check   (nil = allowed)
;   (split-guard op s a)      the intent's server :guard   (nil = allowed)
;   (split-apply op s a)      the intent's :apply          (the next state)
;
; ONE PROPOSAL AT A TIME, IN ORDER. The transport delivers
; `[:browser :intent {:request n :revision r :digest d :op o :args a}]`, and
; this loop answers every one with exactly one `(host/emit :result …)`:
;
;   1. the digest must be the one this build was stamped with — a tab running
;      an older client build is told to reload instead of being guessed at;
;   2. the op must be declared and its args must satisfy the wire type;
;   3. the revision must be the one the proposal was made against — a stale
;      tab is told the current snapshot instead of silently overwriting;
;   4. the shared :check runs AGAIN, here, on the authoritative snapshot;
;   5. the server-only :guard runs (it may read private data);
;   6. :apply computes the next state, which must still project onto the
;      declared snapshot type — a handler that breaks the wire type is
;      refused, and the state does not move.
;
; Only then does the revision advance and a new snapshot go out with
; `(host/emit :snapshot …)`. A refusal is a value, never a raise, so no
; proposal can kill the authority.

(defn split-refused [req reason revision board]
  {:request req :ok false :reason reason :revision revision :board board})

(defn split-decide
  "The whole decision for one proposal: `[:commit state]` or `[:refuse reason]`."
  [contract state revision proposal]
  (let [op (:op proposal)
        args (:args proposal)
        board (wire-snapshot contract state)]
    (cond
      (not (= (split-digest) (:digest proposal))) [:refuse :client-outdated]
      (nil? (wire-intent contract op)) [:refuse :unknown-intent]
      (not (wire-args-ok? contract op args)) [:refuse :malformed-args]
      (not (= revision (:revision proposal))) [:refuse :stale-revision]
      :else
        (let [problem (split-check op board args)]
          (if (some? problem)
            [:refuse problem]
            (let [guard (split-guard op state args)]
              (if (some? guard)
                [:refuse guard]
                (let [next (split-apply op state args)]
                  (if (and (map? next) (wire-snapshot-ok? contract (wire-snapshot contract next)))
                    [:commit next]
                    [:refuse :handler-broke-contract])))))))))

(defn split-proposal-shape-ok? [p]
  (and (map? p) (int? (:request p)) (int? (:revision p))
       (string? (:digest p)) (keyword? (:op p)) (map? (:args p))))

(defn split-server-main []
  (let [contract (split-contract)
        state0 (split-server-init)]
    (if (not (wire-snapshot-ok? contract (wire-snapshot contract state0)))
      (host/raise "split: the server :init state does not satisfy the snapshot type")
      (do
        (rt-register-input!)
        (host/emit :ready {:digest (split-digest) :revision 0
                           :board (wire-snapshot contract state0)})
        (loop [state state0 revision 0]
          (receive
            [:browser :intent proposal]
              (if (not (split-proposal-shape-ok? proposal))
                (do
                  (host/emit :result (split-refused -1 :malformed-proposal revision
                                                    (wire-snapshot contract state)))
                  (recur state revision))
                (let [verdict (split-decide contract state revision proposal)
                      req (:request proposal)]
                  (if (= :commit (first verdict))
                    (let [next (nth verdict 1)
                          rev (inc revision)
                          board (wire-snapshot contract next)]
                      (do
                        (host/emit :result {:request req :ok true :revision rev :board board})
                        (host/emit :snapshot {:revision rev :board board :op (:op proposal) :request req})
                        (recur next rev)))
                    (do
                      (host/emit :result (split-refused req (nth verdict 1) revision
                                                        (wire-snapshot contract state)))
                      (recur state revision)))))
            [:browser :stop _]
              (host/emit :stopped {:revision revision})
            [:browser _topic _payload]
              (recur state revision)))))))
