; split-server.bl — the AUTHORITY half of every `split/defapp` app.
;
; This file is generic: it names no app function. The build compiles it with
; the app's server closure and a generated glue file that supplies
;
;   (split-contract)          the contract as BL data
;   (split-digest)            its SHA-256, the identity both halves carry
;   (split-server-init)       the app's :server :init
;   (split-check op b a)      the intent's shared :check   (nil = allowed)
;   (split-guard op s a)      the intent's server :guard   (nil = allowed)
;   (split-allow op w b a)    the intent's :allow — may PERSON `w` do this?
;                             (nil = allowed; no :allow = anyone signed in)
;   (split-apply op s a w)    the intent's :apply          (the next state)
;   (split-says op b a)       one line for the activity feed, or nil
;   (split-people)            the app's :people roster, or nil (no identity)
;   (split-undo-allow w b)    may `w` undo/redo? (nil = allowed)
;   (split-history-size)      how many past states undo and "view as of"
;                             keep; 0 = no history
;
; ONE PROPOSAL AT A TIME, IN ORDER. The transport delivers
; `[:browser :intent {:request n :revision r :digest d :nonce s :actor a :op o
; :args x}]` — `:actor` is the signed-in person's id, STAMPED BY THE TRANSPORT
; from a session it verified (a browser cannot send one) — and this loop
; answers every one with exactly one `(host/emit :result …)`:
;
;   1. the digest must be the one this build was stamped with;
;   2. the op must be declared and its args must satisfy the wire type;
;   3. an app with a roster requires a person: `:actor` must name one;
;   4. the revision must be the one the proposal was made against;
;   5. the shared :check runs AGAIN, here, on the authoritative snapshot;
;   6. :allow asks whether THIS person may; the server-only :guard runs;
;   7. :apply computes the next state (given the person), which must still
;      project onto the declared snapshot type.
;
; Only then does the revision advance and a snapshot go out. A refusal is a
; value, never a raise, so no proposal can kill the authority.
;
; AT MOST ONCE. A committed nonce is remembered (the last
; `split-nonce-memory`): the same proposal again is answered `:ok` with
; `:duplicate true` and commits nothing.
;
; HISTORY (when `split-history-size` > 0). Every commit pushes the state
; before it onto PAST and clears FUTURE; the built-in intents `:undo` and
; `:redo` move one state between them — shared by everyone, recorded like any
; other commit. The projected board of each recent revision is kept for
; "view as of" (`:peek`). Every commit also yields an ENTRY — revision,
; person, op, one line — kept in RECENT and handed to the transport, which
; appends it to the durable log it replays through this same loop at boot.
;
; OTHER INPUTS, answered here because they are decisions about app data:
;   :login     {:request n :user id}  → :login {:request n :person p|nil}
;   :presence  {:users [id …]}        → :presence {:people [p …]}
;   :peek      {:request n :revision k} → :peek {:request n :revision k :board b|nil}

(defn split-nonce-memory [] 256)
(defn split-recent-size [] 30)

(defn split-seen? [seen nonce] (some? (some (fn [n] (if (= n nonce) n nil)) seen)))

(defn split-drop-last [xs] (vec (take (dec (count xs)) xs)))

(defn split-cap [xs n] (if (< n (count xs)) (vec (rest xs)) xs))

(defn split-person
  "The roster entry for `id`, projected to its public fields, or nil."
  [id]
  (let [p (some (fn [p] (if (= id (:id p)) p nil)) (or (split-people) []))]
    (if (nil? p) nil {:id (:id p) :name (:name p) :role (:role p)})))

(defn split-public-people []
  (mapv (fn [p] {:id (:id p) :name (:name p) :role (:role p)}) (or (split-people) [])))

(defn split-refused [req reason revision board]
  {:request req :ok false :reason reason :revision revision :board board})

(defn split-history-summary
  "What undo and redo would do next, for the view: the entries on top."
  [h]
  {:undo (if (empty? (:past h)) nil (:entry (last (:past h))))
   :redo (if (empty? (:future h)) nil (:entry (last (:future h))))})

(defn split-decide
  "The whole decision for one proposal: `[:commit state entry-line]` or
   `[:refuse reason]`. `h` is the history record (past/future)."
  [contract state revision proposal who h]
  (let [op (:op proposal)
        args (:args proposal)
        board (wire-snapshot contract state)
        history? (< 0 (split-history-size))]
    (cond
      (not (= (split-digest) (:digest proposal))) [:refuse :client-outdated]
      (and (some? (split-people)) (nil? who)) [:refuse :not-signed-in]
      (and history? (= op :undo))
        (cond
          (not (= revision (:revision proposal))) [:refuse :stale-revision]
          (empty? (:past h)) [:refuse :nothing-to-undo]
          (some? (split-undo-allow who board)) [:refuse (split-undo-allow who board)]
          :else [:commit (:state (last (:past h))) (str "undid " (:says (:entry (last (:past h)))))])
      (and history? (= op :redo))
        (cond
          (not (= revision (:revision proposal))) [:refuse :stale-revision]
          (empty? (:future h)) [:refuse :nothing-to-redo]
          (some? (split-undo-allow who board)) [:refuse (split-undo-allow who board)]
          :else [:commit (:state (last (:future h))) (str "redid " (:says (:entry (last (:future h)))))])
      (nil? (wire-intent contract op)) [:refuse :unknown-intent]
      (not (wire-args-ok? contract op args)) [:refuse :malformed-args]
      (not (= revision (:revision proposal))) [:refuse :stale-revision]
      :else
        (let [problem (split-check op board args)]
          (if (some? problem)
            [:refuse problem]
            (let [denied (split-allow op who board args)
                  guard (if (some? denied) nil (split-guard op state args))]
              (cond
                (some? denied) [:refuse denied]
                (some? guard) [:refuse guard]
                :else
                  (let [next (split-apply op state args who)]
                    (if (and (map? next) (wire-snapshot-ok? contract (wire-snapshot contract next)))
                      [:commit next (or (split-says op board args) (name op))]
                      [:refuse :handler-broke-contract])))))))))

(defn split-next-history
  "The history after committing `op` from `state` (the state before)."
  [h op state entry]
  (let [size (split-history-size)]
    (cond
      (= op :undo) {:past (split-drop-last (:past h))
                    :future (split-cap (conj (:future h) {:state state :entry (:entry (last (:past h)))}) size)}
      (= op :redo) {:past (split-cap (conj (:past h) {:state state :entry (:entry (last (:future h)))}) size)
                    :future (split-drop-last (:future h))}
      :else {:past (split-cap (conj (:past h) {:state state :entry entry}) size) :future []})))

(defn split-proposal-shape-ok? [p]
  (and (map? p) (int? (:request p)) (int? (:revision p))
       (string? (:digest p)) (string? (:nonce p)) (<= 1 (count (:nonce p))) (<= (count (:nonce p)) 64)
       (or (nil? (:actor p)) (and (string? (:actor p)) (<= (count (:actor p)) 32)))
       (keyword? (:op p)) (map? (:args p))))

(defn split-peek [boards k]
  (some (fn [e] (if (= k (first e)) (nth e 1) nil)) boards))

(defn split-server-main []
  (let [contract (split-contract)
        state0 (split-server-init)
        board0 (wire-snapshot contract state0)
        keep (split-history-size)]
    (if (not (wire-snapshot-ok? contract board0))
      (host/raise "split: the server :init state does not satisfy the snapshot type")
      (do
        (rt-register-input!)
        (host/emit :ready {:digest (split-digest) :revision 0 :board board0
                           :people (if (some? (split-people)) (split-public-people) nil)
                           :recent [] :history (split-history-summary {:past [] :future []})})
        (loop [state state0 revision 0 seen [] h {:past [] :future []} recent [] boards [[0 board0]]]
          (receive
            [:browser :intent proposal]
              (if (not (split-proposal-shape-ok? proposal))
                (do
                  (host/emit :result (split-refused -1 :malformed-proposal revision
                                                    (wire-snapshot contract state)))
                  (recur state revision seen h recent boards))
                (let [req (:request proposal)
                      who (split-person (:actor proposal))]
                  (if (split-seen? seen (:nonce proposal))
                    (do
                      (host/emit :result {:request req :ok true :duplicate true :revision revision
                                          :board (wire-snapshot contract state)
                                          :recent recent :history (split-history-summary h)})
                      (recur state revision seen h recent boards))
                    (let [verdict (split-decide contract state revision proposal who h)]
                      (if (= :commit (first verdict))
                        (let [next (nth verdict 1)
                              rev (inc revision)
                              board (wire-snapshot contract next)
                              entry {:revision rev :actor (:actor proposal)
                                     :name (if (nil? who) "" (:name who))
                                     :op (:op proposal) :says (nth verdict 2)}
                              h2 (if (< 0 keep) (split-next-history h (:op proposal) state entry) h)
                              recent2 (split-cap (conj recent entry) (split-recent-size))
                              boards2 (if (< 0 keep) (split-cap (conj boards [rev board]) (inc keep)) boards)
                              summary (split-history-summary h2)]
                          (do
                            (host/emit :result {:request req :ok true :revision rev :board board
                                                :recent recent2 :history summary})
                            (host/emit :snapshot {:revision rev :board board :op (:op proposal) :request req
                                                  :recent recent2 :history summary})
                            (host/emit :commit {:entry entry :nonce (:nonce proposal) :args (:args proposal)})
                            (recur next rev (split-cap (conj seen (:nonce proposal)) (split-nonce-memory))
                                   h2 recent2 boards2)))
                        (do
                          (host/emit :result (split-refused req (nth verdict 1) revision
                                                            (wire-snapshot contract state)))
                          (recur state revision seen h recent boards)))))))
            [:browser :login req]
              (do
                (host/emit :login {:request (:request req) :person (split-person (:user req))})
                (recur state revision seen h recent boards))
            [:browser :presence p]
              (do
                (host/emit :presence {:people (filterv some? (mapv split-person (or (:users p) [])))})
                (recur state revision seen h recent boards))
            [:browser :peek q]
              (do
                (host/emit :peek {:request (:request q) :revision (:revision q)
                                  :board (split-peek boards (:revision q))})
                (recur state revision seen h recent boards))
            [:browser :stop _]
              (host/emit :stopped {:revision revision})
            [:browser _topic _payload]
              (recur state revision seen h recent boards)))))))
