; Linked BL APIs preserve values without JavaScript argument conversion.
(ns ^:js actor.linked-values (:require [js-actors-native-helper :as helper]))
(defn main []
  (let [value {:items [1 2] :decimal 1.50M :float 4.0}
        result (helper/canonical value)
        indirect helper/canonical]
    (.log js/console #js {:same (identical? value result)
                         :indirect (identical? value (indirect value))
                         :vector (= [1 2] (:items result))
                         :decimal (= 1.50M (:decimal result))
                         :float (float? (:float result))})))
