; The visible browser application is BL. JavaScript only transports DOM strings.
; This actor has no timeout: it remains parked until a person sends a message.
(defn demo-timer []
  (receive
    :cancel :cancelled
    (after 200 (host/write "BL timer completed; input actor still waiting"))))

(defn main []
  (rt-register-input!)
  (let [timer (rt-spawn demo-timer [])]
    (host/write "BL actor ready — waiting for browser input")
    (loop [seen 0]
      (receive
        [:browser :send text]
          (do
            (host/write (str "BL actor received #" (inc seen) ": " text))
            (recur (inc seen)))
        [:browser :stop _]
          (do
            (if (nil? (rt-proc-of (host/state) timer)) nil (rt-send timer :cancel))
            (host/write (str "BL actor stopped after " seen " message(s)")))))))
