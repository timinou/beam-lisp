; number_rule_test.bl — the numeric rule's assurance: yes/no/unknown, never a guess.
;
; Focused run:
;   BEAM_LISP_Z3=/usr/bin/z3 ./bin/bl test research/js-actors/number_rule_test.bl -p research/js-actors
;
; The load-bearing claims, each as a deftest:
;   1. `1.0` is NEVER certified as an integer — the host cannot tell `1` from
;      `1.0` (Number.isInteger(1.0) is true), so the rule restores the
;      distinction statically.
;   2. a safe range is PROVEN — by exhaustion on a bounded domain, by z3 on an
;      unbounded one.
;   3. a boundary overflow is REFUTED with a concrete counterexample (the
;      offending assignment and the operator that broke).
;   4. `/`, unknown heads, higher-order calls and unbounded operands are
;      `:unknown` with a runtime guard — never `:yes`.
;   5. a process form's state arithmetic is certified through system.model.

(ns number-rule-test
  (:require [number-rule :as nr]
            [z3]
            [decimal]))

(def port (z3/open))
(def SAFE 9007199254740991)

(defn- reason-of [r] (get (:counterexample r) :reason))

; ═══ 1. host conversion and the type distinction ═══════════════════════════

(deftest integer-literals-are-host-safe
  (is (= :yes (:verdict (nr/certify-literal 0))))
  (is (= :yes (:verdict (nr/certify-literal 1))))
  (is (= :yes (:verdict (nr/certify-literal SAFE))))
  (is (= :yes (:verdict (nr/certify-literal (- 0 SAFE))))))

(deftest float-1-0-is-never-certified-as-an-integer
  ; THE load-bearing case. 1.0 is integral; the host reports it as an integer;
  ; the rule must refuse it and say why.
  (let [r (nr/certify-literal 1.0)]
    (is (= :no (:verdict r)))
    (is (= :float-not-int (reason-of r)))
    (is (= :violated (get (:laws r) :int-literals))))
  (is (= :no (:verdict (nr/certify-literal 2.5))))
  ; and it holds inside an expression, where z3 would otherwise accept a Real
  (is (= :no (:verdict (nr/certify-expr "(+ 1 1.0)" {}))))
  (is (= :no (:verdict (nr/certify-expr "(* a 1.0)" {"a" [0 10]})))))

(deftest bignums-and-decimals-are-refused
  (let [b (nr/certify-literal (+ SAFE 1))]
    (is (= :no (:verdict b)))
    (is (= :bignum-out-of-safe-range (reason-of b))))
  (let [d (nr/certify-literal (decimal/parse "1.5"))]
    (is (= :no (:verdict d)))
    (is (= :exact-decimal (reason-of d)))))

(deftest non-numbers-are-refused
  (is (= :no (:verdict (nr/certify-literal "1"))))
  (is (= :no (:verdict (nr/certify-literal :one)))))

(deftest host-safe-distinguishes-int-from-float
  (is (= true (:ok (nr/host-safe? 1))))
  (is (= false (:ok (nr/host-safe? 1.0)))))

; ═══ 2. positive proofs ════════════════════════════════════════════════════

(deftest small-domain-is-exhaustively-proven
  (let [r (nr/certify-expr port "(+ a 1)" {"a" [0 10]})]
    (is (= :yes (:verdict r)))
    (is (= :proven (:modality r)))
    (is (= :enumerate (:engine r)))))

(deftest unbounded-domain-is-symbolically-proven
  (let [r (nr/certify-expr port "(+ a b)" {"a" [0 1000] "b" [0 1000]})]
    (is (= :yes (:verdict r)))
    (is (= :oracle (:engine r)))
    (is (= :arith (get (:evidence r) :fragment)))))

(deftest nonlinear-product-is-proven
  (let [r (nr/certify-expr port "(* a b)" {"a" [0 1000] "b" [0 1000]})]
    (is (= :yes (:verdict r)))
    (is (= :oracle (:engine r)))))

(deftest rem-with-a-nonzero-divisor-is-proven
  (let [r (nr/certify-expr port "(rem a b)" {"a" [0 100] "b" [1 7]})]
    (is (= :yes (:verdict r)))
    (is (= :proven (:modality r)))))

(deftest nested-arithmetic-is-proven-or-refused-as-a-whole
  (is (= :yes (:verdict (nr/certify-expr port "(* (+ a 1) 2)" {"a" [0 100]}))))
  ; the SAME outer shape, but the inner sum is unbounded at the top of the range
  (is (= :no (:verdict (nr/certify-expr port "(* (+ a 1) 2)" {"a" [0 SAFE]})))))

(deftest evidence-names-the-engine-and-the-bounded-operators
  (let [r (nr/certify-expr port "(+ a b)" {"a" [0 1000] "b" [0 1000]})]
    (is (= ["(+ a b)"] (get (:evidence r) :ops)))
    (is (= {"a" [0 1000] "b" [0 1000]} (get (:evidence r) :vars)))))

; ═══ 3. negative: a definite counterexample ════════════════════════════════

(deftest overflow-at-the-boundary-is-refuted-with-a-counterexample
  (let [r (nr/certify-expr port "(+ a 1)" {"a" [0 SAFE]})]
    (is (= :no (:verdict r)))
    (is (= :refuted (:modality r)))
    (is (= SAFE (get (:assignment (:counterexample r)) "a")))
    (is (= :overflow (get (first (:violations (:counterexample r))) :violation)))))

(deftest divide-by-zero-is-refuted
  (let [r (nr/certify-expr port "(rem a b)" {"a" [0 10] "b" [0 5]})]
    (is (= :no (:verdict r)))
    (is (= :violated (get (:laws r) :divisor-nonzero)))))

(deftest negative-result-overflow-is-refuted
  (let [r (nr/certify-expr port "(- a 1)" {"a" [(- 0 SAFE) 0]})]
    (is (= :no (:verdict r)))
    (is (= :overflow (get (first (:violations (:counterexample r))) :violation)))))

; ═══ 4. the boundary behaviour, both sides ═════════════════════════════════

(deftest boundary-values-decide-correctly
  ; a + 1 is safe exactly up to a = SAFE - 1
  (is (= :yes (:verdict (nr/certify-expr port "(+ a 1)" {"a" [0 (- SAFE 1)]}))))
  (is (= :no  (:verdict (nr/certify-expr port "(+ a 1)" {"a" [0 SAFE]}))))
  ; a - 1 is safe from a = -(SAFE - 1)
  (is (= :yes (:verdict (nr/certify-expr port "(- a 1)" {"a" [(- 0 (- SAFE 1)) 0]}))))
  (is (= :no  (:verdict (nr/certify-expr port "(- a 1)" {"a" [(- 0 SAFE) 0]}))))
  ; a * 1 is safe; a * 2 leaves the safe range
  (is (= :yes (:verdict (nr/certify-expr port "(* a b)" {"a" [0 SAFE] "b" [1 1]}))))
  (is (= :no  (:verdict (nr/certify-expr port "(* a b)" {"a" [0 SAFE] "b" [2 2]}))))
  ; a constant that is itself out of range, with no operands at all
  (let [r (nr/certify-expr port "(+ 9007199254740991 1)" {})]
    (is (= :no (:verdict r)))))

; ═══ 5. unknown — the honest rung, with a guard ════════════════════════════

(deftest unknown-and-higher-order-arithmetic-are-refused
  (let [u (nr/certify-expr port "(/ a 2)" {"a" [0 10]})
        h (nr/certify-expr port "(apply + xs)" {"xs" [0 10]})
        f (nr/certify-expr port "(frob a)" {"a" [0 10]})]
    (is (= :unknown (:verdict u)))
    (is (= :unproven-op (:reason u)))
    (is (= :violated (get (:laws u) :known-integer-ops)))
    (is (= :unknown (:verdict h)))
    (is (= :higher-order-or-unknown-call (:reason h)))
    (is (= :unknown (:verdict f)))
    (is (some? (:guard h)))))

(deftest unbounded-operand-is-unknown-with-a-guard
  (let [r (nr/certify-expr port "(+ a b)" {"a" [0 10]})]
    (is (= :unknown (:verdict r)))
    (is (= :unbounded-variable (:reason r)))
    (is (= :keep-bl-integer (get (:guard r) :fallback)))))

(deftest unknown-is-never-upgraded-to-yes
  (is (not= :yes (:verdict (nr/certify-expr port "(/ a 2)" {"a" [0 10]}))))
  (is (not= :yes (:verdict (nr/certify-expr port "(+ a b)" {"a" [0 10]}))))
  (is (not= :yes (:verdict (nr/certify-expr port "(apply + xs)" {"xs" [0 10]})))))

(deftest unreadable-source-is-unknown
  (is (= :unknown (:verdict (nr/certify-expr port "" {}))))
  (is (= :unknown (:verdict (nr/certify-expr port "(+ 1 2) (+ 3 4)" {})))))

; ═══ 6. the process form: state arithmetic through system.model ════════════

(deftest defn-state-arithmetic-is-certified
  (is (= :yes (:verdict (nr/certify-defn port "(defn bump [n] (+ n 1))" {"n" [0 10]}))))
  (is (= :no  (:verdict (nr/certify-defn port "(defn bump [n] (+ n 1))" {"n" [0 SAFE]})))))

(deftest defserver-state-arithmetic-is-certified
  (let [src "(defserver counter
                (init [] (ok {:n 0}))
                (handle-cast [:inc] [_ n] (noreply {:n (+ n 1)})))"
        r (nr/certify-defn port src {"n" [0 10]})]
    (is (= :yes (:verdict r)))
    (is (= "counter" (:machine r)))
    (is (= 2 (count (:clauses r))))))

(deftest process-proof-includes-codebase-call-provenance
  (let [r (nr/certify-defn port "(defn bump [n] (+ n 1))" {"n" [0 10]})]
    (is (= :yes (:verdict r)))
    (is (= "+" (:callee (first (:codebase-call-sites r)))))))

(deftest unknown-state-call-prevents-sibling-arithmetic-certification
  (let [r (nr/certify-defn port "(defn f [n] {:known (+ n 1) :unknown (mystery n)})" {"n" [0 10]})]
    (is (= :unknown (:verdict r)))
    (is (= :higher-order-or-unknown-call (:reason (first (:clauses r)))))))

(deftest defn-with-a-float-literal-is-refused
  (is (= :no (:verdict (nr/certify-defn port "(defn f [n] (+ n 1.0))" {"n" [0 10]})))))

(deftest defn-with-an-unbounded-operand-is-unknown
  (is (= :unknown (:verdict (nr/certify-defn port "(defn f [n] (+ n 1))" {})))))

(deftest nary-operators-require-intermediate-proofs
  (is (not= :yes (:verdict (nr/certify-expr "(+ a 2 -2)" {"a" [SAFE SAFE]}))))
  (is (not= :yes (:verdict (nr/certify-expr "(* a 2 0)" {"a" [SAFE SAFE]})))))

(deftest process-extraction-cannot-drop-control-branches
  (let [src "(defserver counter
               (init [] (ok 0))
               (handle-cast [:inc] [_ n]
                 (if (= n 0) (noreply 0) (noreply (+ n 9007199254740991)))))"
        result (nr/certify-defn src {"n" [0 1]})]
    (is (= :unknown (:verdict result)))
    (is (= :control-flow-not-modeled (:reason result)))))

(deftest sequential-and-reply-effects-cannot-hide-overflow
  (let [server "(defserver counter
                  (init [] (ok 0))
                  (handle-cast [:inc] [_ n]
                    (do (+ n 9007199254740991) (noreply 0))))"
        replying "(defserver counter
                     (init [] (ok 0))
                     (handle-call [:inc] [_from n]
                       (reply (+ n 9007199254740991) 0)))"]
    (is (not= :yes (:verdict (nr/certify-defn server {"n" [0 1]}))))
    (is (not= :yes (:verdict (nr/certify-defn replying {"n" [0 1]}))))))

(deftest guard-arithmetic-needs-its-own-proof
  (let [src "(defserver counter
               (init [] (ok 0))
               (handle-cast [:inc] [_ n] :when (> (+ n 9007199254740991) 0)
                 (noreply 0)))"
        r (nr/certify-defn src {"n" [0 1]})]
    (is (not= :yes (:verdict r)))))

(run-tests)
