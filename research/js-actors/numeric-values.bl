; Exercise canonical numeric identity through emitted actors and native JS.
(ns ^:js actor.numeric-values)
(defn main []
  (let [answer (/ 8 2)
        keys {4 "integer" 4.0 "float"}]
    (.log js/console
      #js {:divisionIsFloat (float? answer)
           :divisionIsInteger (int? answer)
           :sameFloat (identical? answer 4.0)
           :differentInteger (not (identical? answer 4))
           :floatKey (get keys answer)
           :integerKey (get keys 4)
           :fraction (/ 7 2)
           :decimal (= (+ 1.5M 1) 2.5M)
           :exact (= (+ 9007199254740993 1) 9007199254740994)})))
