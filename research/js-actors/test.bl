; test.bl — the application half of the prototype: the acceptance tests, in
; beam-lisp, running on the actor runtime in runtime.bl.
;
; `main` is spawned as a process by the runtime's `bl-main`, and every test
; below runs inside that process. Nothing here is JavaScript; the `receive`
; forms below are ordinary source `receive`, lowered by compiler.bl into the
; BL `rt-receive`.

; ── the harness ──────────────────────────────────────────────────────────────

(defn check [name actual expected]
  (if (host/eq actual expected)
    (do (host/write (str "PASS " name)) 0)
    (do (host/write (str "FAIL " name " — got " (host/describe actual)
                         ", want " (host/describe expected)))
        1)))

(defn check-all [cases]
  (loop [cs cases fails 0]
    (if (empty? cs)
      fails
      (let [c (first cs)]
        (recur (rest cs) (+ fails (check (nth c 0) (nth c 1) (nth c 2))))))))

; ── arithmetic, collections, truthiness ──────────────────────────────────────

(defn pure-tests []
  (check-all
    (list
      ["add" (+ 1 2) 3]
      ["sub" (- 10 3) 7]
      ["mul" (* 3 4) 12]
      ["div" (/ 8 2) 4]
      ["rem" (rem 7 3) 1]
      ["lt-true" (< 1 2) true]
      ["lt-false" (< 2 1) false]
      ["ge" (>= 3 3) true]
      ["eq-num" (= 2 2) true]
      ["eq-str" (= "a" "a") true]
      ["eq-kw" (= :a :a) true]
      ["neq" (not= 1 2) true]
      ["truthy-nil" (if nil :yes :no) :no]
      ["truthy-false" (if false :yes :no) :no]
      ["truthy-zero" (if 0 :yes :no) :yes]
      ["truthy-empty-str" (if "" :yes :no) :yes]
      ["nil?" (nil? nil) true]
      ["some?" (some? 0) true]
      ["inc" (inc 4) 5]
      ["dec" (dec 4) 3]
      ["vec-nth" (nth [10 20 30] 1) 20]
      ["vec-count" (count [1 2 3]) 3]
      ["vec-conj" (nth (conj [1 2] 3) 2) 3]
      ["vec-empty" (empty? []) true]
      ["list-first" (first (list 1 2 3)) 1]
      ["list-rest-count" (count (rest (list 1 2 3))) 2]
      ["list-cons" (first (cons 9 ())) 9]
      ["list-count" (count (list 4 5 6)) 3]
      ["map-get" (:a {:a 1}) 1]
      ["map-keyword-fn" ({:a 1} :a) 1]
      ["map-assoc" (:b (assoc {:a 1} :b 2)) 2]
      ["map-count" (count {:a 1 :b 2}) 2]
      ["keyword-string-keys" [(get {:a 1 "a" 2} :a) (get {:a 1 "a" 2} "a")] [1 2]]
      ["structural-key-boundaries" (= [(keyword "x,k:y")] [:x :y]) false]
      ["compound-map-keys" (count {[(keyword "x,k:y")] 1 [:x :y] 2}) 2]
      ["str-mixed" (str "a" 1 :b) "a1b"]
      ["keyword" (keyword "bar") :bar]
      ["name" (name :foo) "foo"]
      ["tuple-vec-distinct" (host/is-tup [1 2]) false]
      ["list-not-vec" (host/is-vec (list 1 2)) false])))

; ── closures, higher-order calls, arity dispatch ─────────────────────────────

(defn adder [n] (fn [x] (+ x n)))
(defn twice [f x] (f (f x)))
(defn apply2 [f a b] (f a b))
(defn variadic [a & r] (count r))

(defn closure-tests []
  (check-all
    (list
      ["closure" ((adder 10) 5) 15]
      ["hof" (apply2 (fn [x y] (* x y)) 6 7) 42]
      ["hof-nested" (twice (adder 3) 1) 7]
      ["capture-shadow" (let [n 100] ((adder 1) n)) 101]
      ["variadic-count" (variadic 1 2 3) 2]
      ["variadic-zero" (variadic 1) 0]
      ["multi-arity-1" ((fn ([a] a) ([a b] (+ a b))) 5) 5]
      ["multi-arity-2" ((fn ([a] a) ([a b] (+ a b))) 5 6) 11])))

; ── patterns ────────────────────────────────────────────────────────────────
;
; `case` in this beam-lisp is a core MACRO over `eqv`: it compares against a
; literal, so a pattern like `[a b]` is a VALUE to compare, not a binder. The
; binding-pattern coverage therefore lives on `receive`, whose clauses go
; through the compiler's real pattern compiler (`compile-pattern`) — exactly
; the surface a selective receive needs anyway.

(defn case-tests []
  (check-all
    (list
      ["case-lit" (case 2 1 :one 2 :two :other) :two]
      ["case-vec-lit" (case [1 2] [1 2] :yes :no) :yes]
      ["case-kw" (case :b :a 1 :b 2 :c) 2]
      ["case-fallthrough" (case 9 1 :one :other) :other])))

(defn pattern-tests []
  (do
    (rt-send (rt-self) [:pair 4 5])
    (rt-send (rt-self) [:n 5])
    (rt-send (rt-self) [[:in 3] 4])
    (rt-send (rt-self) [:guard 50])
    (let [a (receive [:pair p q] (+ p q) (after 2000 :timeout))
          b (receive [:n x] :when (< x 10) :small [:n y] :big (after 2000 :timeout))
          c (receive [[:in i] j] (+ i j) (after 2000 :timeout))
          d (receive [:guard g] :when (< g 10) :small (after 2000 :timeout))]
      (tally2 (tally2 (check "recv-tuple-bind" a 9)
                      (check "recv-clause-guard" b :small))
              (tally2 (check "recv-nested-bind" c 7)
                      (check "recv-guard-falls-through" d :timeout))))))

; ── loop/recur stack safety ──────────────────────────────────────────────────

(defn count-down [n]
  (loop [i n acc 0]
    (if (< i 1)
      acc
      (recur (- i 1) (+ acc 1)))))

(defn loop-tests []
  (check-all
    (list
      ["loop-small" (count-down 10) 10]
      ["loop-50000" (count-down 50000) 50000])))

; ── source receive ───────────────────────────────────────────────────────────

(defn recv-basic []
  (do
    (rt-send (rt-self) :hello)
    (check "recv-basic" (receive :hello :got-hello (after 2000 :timeout)) :got-hello)))

; ── skipped messages are retained, in order ──────────────────────────────────

(defn skip-tests []
  (do
    (rt-send (rt-self) [:skip 1])
    (rt-send (rt-self) [:skip 2])
    (rt-send (rt-self) :target)
    (let [first-hit (receive :target :saw-target (after 2000 :timeout))
          a (receive [:skip x] x (after 2000 :timeout))
          b (receive [:skip x] x (after 2000 :timeout))]
      (tally2 (tally2 (check "skip-selective" first-hit :saw-target)
                      (check "skip-retained-1" a 1))
              (check "skip-retained-2" b 2)))))

; ── message-major order ──────────────────────────────────────────────────────
;
; The first message ([:m 1]) is offered to EVERY clause before the second
; message is considered. A clause-major scan would answer [:got-n 2].

(defn order-tests []
  (do
    (rt-send (rt-self) [:m 1])
    (rt-send (rt-self) [:n 2])
    (check "message-major"
           (receive [:n x] [:got-n x] [:m y] [:got-m y] (after 2000 :timeout))
           [:got-m 1])))

; ── after 0 ──────────────────────────────────────────────────────────────────
;
; `after 0` must still SCAN the queue before it can time out, and it must do so
; across a scheduling boundary.

(defn after0-tests []
  (do
    (rt-send (rt-self) :queued)
    (let [hit (receive :queued :matched (after 0 :timed-out))
          miss (receive :never-arrives :matched (after 0 :timed-out))]
      (tally2 (check "after0-scans-queue" hit :matched)
              (check "after0-times-out" miss :timed-out)))))

; ── timed receive and wakeup ─────────────────────────────────────────────────

(defn delayed-sender [to msg ms]
  (do
    (receive (after ms :go))
    (rt-send to msg)
    :sent))

(defn timed-tests []
  (do
    (rt-spawn delayed-sender [(rt-self) :late 40])
    (check "timed-receive-wakeup"
           (receive :late :got-late (after 3000 :timeout))
           :got-late)))

; ── a CPU-bound peer must not starve others ──────────────────────────────────

(defn busy [to n]
  (loop [i 0]
    (if (< i n)
      (recur (+ i 1))
      (do (rt-send to :busy-done) :done))))

(defn pinger [to]
  (do (rt-send to :ping) :ping-done))

; The test asserts eventual peer progress under a 17-step scheduler budget,
; not a throughput SLA: loaded hosts can spend seconds on 60,000 managed turns.
(defn fairness-tests []
  (do
    (rt-spawn busy [(rt-self) 60000])
    (rt-spawn pinger (list (rt-self)))
    (let [r1 (receive :ping :got-ping (after 4000 :no-ping))
          r2 (receive :busy-done :got-busy-done (after 30000 :no-busy))]
      (tally2 (check "peer-progress-under-cpu" r1 :got-ping)
              (check "cpu-peer-completes" r2 :got-busy-done)))))

; ── dynamic receive through a callback ───────────────────────────────────────

(defn recv-via [callback] (callback))

(defn dynamic-tests []
  (do
    (rt-send (rt-self) [:dyn 7])
    (check "dynamic-recv-callback"
           (recv-via (fn [] (receive [:dyn x] x (after 2000 :timeout))))
           7)))

; ── process lifecycle: death, links, monitors, exits ────────────────────────
;
; These regressions crash actors ON PURPOSE, and every crash here is WATCHED. An
; abnormal death with no link and no monitor is recorded as a runtime error and
; fails the whole batch (runtime.bl `rt-terminate!` states that policy); a link
; or a monitor is the observer that turns a deliberate crash into an ordinary
; value. So this suite passing at all is itself part of the check: an OBSERVED
; crash must not fail the run, and no test here may leak a process, a monitor,
; a deadline or an input-sink registration.

(defn life-normal [] :life-ok)

(defn life-crash
  "An actor that dies abnormally with `reason`."
  [reason]
  (erlang/raise :error reason nil))

(defn life-park-long [] (receive :life-never (after 100000 :life-timed-out)))

(defn life-register
  "An actor that becomes the browser-input sink and then stays parked: the
   registration must survive until something kills the actor."
  []
  (do
    (rt-register-input!)
    (receive :life-stop :life-stopped (after 100000 :life-sink-timeout))))

(defn life-normal-death []
  (let [pair (rt-spawn-monitor life-normal [])
        child (nth pair 0)
        mref (nth pair 1)
        down (receive [:down r :process p reason] [r p reason]
                      (after 2000 [:life-timeout :life-none :life-none]))
        again (receive [:down r2] r2 (after 0 :life-no-second-down))]
    (check-all
      (list
        ["life-pid-is-typed" (rt-pid? child) true]
        ["life-ref-is-typed" (rt-ref? mref) true]
        ["life-normal-death-notifies-monitor" down [mref child :normal]]
        ["life-normal-down-exactly-once" again :life-no-second-down]
        ["life-normal-death-leaves-no-proc" (rt-alive? child) false]
        ["life-normal-death-leaves-no-monitor" (rt-monitor-count) 0]))))

(defn life-abnormal-death []
  (let [pair (rt-spawn-monitor life-crash [:life-boom])
        child (nth pair 0)
        mref (nth pair 1)
        down (receive [:down r :process p reason] [r p reason]
                      (after 2000 [:life-timeout :life-none :life-none]))
        again (receive [:down r2] r2 (after 0 :life-no-second-down))]
    (check-all
      (list
        ["life-abnormal-death-reason-typed" down [mref child [:error :life-boom]]]
        ["life-abnormal-down-exactly-once" again :life-no-second-down]
        ["life-abnormal-death-leaves-no-proc" (rt-alive? child) false]
        ["life-abnormal-death-leaves-no-monitor" (rt-monitor-count) 0]
        ["life-observer-survives-its-crash" (rt-alive? (rt-self)) true]))))

(defn life-monitor-race []
  (let [gone (rt-spawn life-normal [])
        settle (receive :life-tick (after 20 :life-waited))
        gone-dead (rt-alive? gone)
        mref (rt-monitor gone)
        immediate (receive [:down r :process p reason] [r p reason]
                           (after 0 [:life-timeout :life-none :life-none]))
        live (rt-spawn life-park-long [])
        live-ref (rt-monitor live)
        _killed (rt-exit live :kill)
        down (receive [:down r :process p reason] [r p reason]
                      (after 2000 [:life-timeout :life-none :life-none]))]
    (check-all
      (list
        ["life-monitor-race-child-settled" settle :life-waited]
        ["life-monitor-race-target-already-dead" gone-dead false]
        ["life-monitor-race-immediate-noproc" immediate [mref gone :noproc]]
        ["life-monitor-race-live-then-killed" down [live-ref live :killed]]
        ["life-monitor-race-no-stale-proc" (rt-alive? live) false]
        ["life-monitor-race-leaves-no-monitor" (rt-monitor-count) 0]
        ["life-monitor-race-no-lingering-timer" (rt-timer-count) 0]))))

(defn life-link-parent
  "Link a child that crashes, then park. This parent does NOT trap exits, so the
   crash must kill it with the same reason before it ever wakes."
  []
  (let [child (rt-spawn-link life-crash [:life-linked])]
    (receive :life-never (after 5000 :life-child-did-not-die))))

(defn life-linked-failure []
  (let [pair (rt-spawn-monitor life-link-parent [])
        parent (nth pair 0)
        mref (nth pair 1)
        down (receive [:down r :process p reason] [r p reason]
                      (after 5000 [:life-timeout :life-none :life-none]))
        child-down (receive [:down r2] r2 (after 0 :life-no-child-down))]
    (check-all
      (list
        ["life-linked-failure-kills-partner" down [mref parent [:error :life-linked]]]
        ["life-linked-failure-child-not-monitored" child-down :life-no-child-down]
        ["life-linked-failure-no-stale-parent" (rt-alive? parent) false]
        ["life-linked-failure-no-lingering-timer" (rt-timer-count) 0]
        ["life-linked-failure-leaves-no-monitor" (rt-monitor-count) 0]))))

(defn life-trap-parent
  "Trap exits, link a child that crashes and another that returns normally, then
   report both messages. A trapping process turns EVERY linked exit into a
   message — the normal one included — and stays alive."
  [to]
  (let [was (rt-trap-exit! true)
        crasher (rt-spawn-link life-crash [:life-trapped])
        crash-msg (receive [:exit from reason] [from reason]
                           (after 3000 [:life-timeout :life-none]))
        normal-child (rt-spawn-link life-normal [])
        normal-msg (receive [:exit from reason] [from reason]
                            (after 3000 [:life-timeout :life-none]))]
    (do
      (rt-trap-exit! was)
      (rt-send to [:life-trap was crasher crash-msg
                   normal-child normal-msg (rt-alive? (rt-self))]))))

(defn life-trap-exit []
  (let [pair (rt-spawn-monitor life-trap-parent [(rt-self)])
        parent (nth pair 0)
        mref (nth pair 1)
        report (receive
                 [:life-trap was crasher crash-msg normal-child normal-msg alive]
                   [was crasher crash-msg normal-child normal-msg alive]
                 (after 4000 [:life-none :life-none :life-none :life-none :life-none :life-none]))
        down (receive [:down r :process p reason] [r p reason]
                      (after 2000 [:life-timeout :life-none :life-none]))]
    (check-all
      (list
        ["life-trap-previous-flag-was-false" (nth report 0) false]
        ["life-trap-crash-becomes-message" (nth report 2)
         [(nth report 1) [:error :life-trapped]]]
        ["life-trap-normal-becomes-message" (nth report 4)
         [(nth report 3) :normal]]
        ["life-trap-parent-survived-its-crasher" (nth report 5) true]
        ["life-trap-parent-dies-normally" down [mref parent :normal]]
        ["life-trap-leaves-no-proc" (rt-alive? parent) false]
        ["life-trap-leaves-no-monitor" (rt-monitor-count) 0]))))

(defn life-double-death []
  (let [pair (rt-spawn-monitor life-park-long [])
        child (nth pair 0)
        mref (nth pair 1)
        _first-kill (rt-exit child :kill)
        down (receive [:down r :process p reason] [r p reason]
                      (after 2000 [:life-timeout :life-none :life-none]))
        _second-kill (rt-exit child :kill)
        _third-kill (rt-exit child :life-boom)
        again (receive [:down r2] r2 (after 0 :life-no-second-down))
        stale-link (try (rt-link child) :life-no-raise
                        (catch e [:life-noproc (ex-original e)]))]
    (check-all
      (list
        ["life-kill-delivers-one-down" down [mref child :killed]]
        ["life-kill-exactly-once" again :life-no-second-down]
        ["life-kill-no-stale-proc" (rt-alive? child) false]
        ["life-link-to-dead-raises-noproc" stale-link [:life-noproc :noproc]]
        ["life-double-death-no-bystanders" (rt-proc-count) 1]))))

(defn life-timer-and-sink-cleanup []
  (let [sink-pair (rt-spawn-monitor life-register [])
        sink-child (nth sink-pair 0)
        sink-ref (nth sink-pair 1)
        settle (receive :life-tick (after 20 :life-waited))
        registered (rt-input-sink)
        parked-pair (rt-spawn-monitor life-park-long [])
        parked (nth parked-pair 0)
        parked-ref (nth parked-pair 1)
        settle2 (receive :life-tick (after 20 :life-waited))
        timers (rt-timer-count)
        parked-alive (rt-alive? parked)
        _sink-kill (rt-exit sink-child :kill)
        sink-down (receive [:down r :process p reason] [r p reason]
                           (after 2000 [:life-timeout :life-none :life-none]))
        sink-released (rt-input-sink)
        _parked-kill (rt-exit parked :kill)
        parked-down (receive [:down r :process p reason] [r p reason]
                             (after 2000 [:life-timeout :life-none :life-none]))
        timers-after (rt-timer-count)]
    (check-all
      (list
        ["life-sink-wait-was-a-timeout" settle :life-waited]
        ["life-sink-wait-was-a-timeout-2" settle2 :life-waited]
        ["life-sink-child-registered" registered sink-child]
        ["life-parked-child-alive-before-kill" parked-alive true]
        ["life-two-parked-deadlines" timers 2]
        ["life-killed-sink-down" sink-down [sink-ref sink-child :killed]]
        ["life-killed-sink-released-registration" sink-released nil]
        ["life-killed-sink-not-alive" (rt-alive? sink-child) false]
        ["life-killed-parked-down" parked-down [parked-ref parked :killed]]
        ["life-killed-parked-child-cleaned-its-timer" timers-after 0]
        ["life-killed-children-leave-no-monitor" (rt-monitor-count) 0]))))

(defn life-runnable-all-alive
  "No entry of the run queue may name a process that no longer exists."
  [runq i]
  (if (host/lt i (host/vec-size runq))
    (if (rt-alive? (host/vec-el runq i))
      (life-runnable-all-alive runq (inc i))
      false)
    true))

(defn life-no-stale-state []
  (do
    (receive :life-settle (after 30 :life-settled))
    (check-all
      (list
        ["life-no-stale-procs" (rt-proc-count) 1]
        ["life-no-stale-monitors" (rt-monitor-count) 0]
        ["life-no-stale-timers" (rt-timer-count) 0]
        ["life-no-stale-sink" (rt-input-sink) nil]
        ["life-no-dead-pid-in-run-queue"
         (life-runnable-all-alive (:runnable (host/state)) 0) true]))))

; ── exit/2 vs exit/1, self-signals, link-carried reasons ────────────────────
;
; exit/2 and exit/1 are NOT the same signal, and a link does not carry an
; EXPLICIT signal. These cases pin the difference; verify-lifecycle.mjs runs the
; SAME cases under native BEAM (OTP 29) and compares the reasons, so the reasons
; are a differential, not a hand-written table:
;
;   exit/2 `:kill`  -> the target dies :killed, untrappable;
;   exit/1 `:kill`  -> the process dies :kill and its links carry :kill;
;   self `:normal`  -> exit/2 to self terminates a non-trapping process with
;                      :normal, while a link-carried :normal to a non-trapping
;                      partner is ignored.

(defn parity-park [] (receive :parity-never (after 100000 :parity-park-timeout)))
(defn parity-normal [] :parity-normal)
(defn parity-exit1-kill [] (erlang/exit :kill))
(defn parity-self-normal [] (rt-exit (rt-self) :normal))

(defn parity-link-nontrap
  "Linked to `child-fn` and parked: a non-trapping partner dies with an abnormal
   reason and survives a normal one."
  [child-fn]
  (do
    (rt-spawn-link child-fn [])
    (receive :parity-never (after 100000 :survived))))

(defn parity-link-trap
  "Linked to `child-fn` while trapping: reports the linked EXIT message's reason
   to `to`. The partner survives as long as it traps."
  [child-fn to]
  (let [was (rt-trap-exit! true)]
    (do
      (rt-spawn-link child-fn [])
      (let [m (receive [:exit from reason] reason (after 3000 :no-exit))]
        (rt-trap-exit! was)
        (rt-send to [:parity-trap m])))))

(defn parity-self-normal-trap
  "Self `:normal` while trapping: the signal becomes a message and the process
   survives, so it reports the message's reason."
  [to]
  (let [was (rt-trap-exit! true)]
    (do
      (rt-exit (rt-self) :normal)
      (let [m (receive [:exit from reason] reason (after 3000 :no-message))]
        (rt-trap-exit! was)
        (rt-send to [:parity-self-normal-trap m])))))

(defn parity-die-with-linked
  "A RUNNING process kills a linked child with :kill. The child's death signal
   reaches the running process through the link, so the running process must end
   with the child's reason: the park below is unreachable once that holds."
  [child-fn]
  (let [child (rt-spawn-link child-fn [])]
    (do
      (rt-exit child :kill)
      (receive :parity-never (after 100000 :survived)))))

(defn parity-link-report-child
  "Spawn a linked child, tell `to` its pid, then park, so the caller can kill the
   child from a THIRD process and observe this partner's fate."
  [child-fn to]
  (let [child (rt-spawn-link child-fn [])]
    (do
      (rt-send to [:parity-child child])
      (receive :parity-never (after 100000 :survived)))))

(defn parity-settle [] (receive :parity-never (after 30 :parity-settled)))

(defn parity-observe
  "Monitor `f` and answer its death reason, or :survived when it outlives the
   window (then killed, so nothing leaks)."
  [f args]
  (let [pair (rt-spawn-monitor f args)
        pid (nth pair 0)]
    (do
      (parity-settle)
      (if (rt-alive? pid)
        (do
          (rt-exit pid :kill)
          (receive [:down r :process p reason] :survived (after 3000 :no-down)))
        (receive [:down r :process p reason] reason (after 3000 :no-down))))))

(defn parity-explicit-kill []
  (let [pair (rt-spawn-monitor parity-park [])
        pid (nth pair 0)]
    (do
      (rt-exit pid :kill)
      (receive [:down r :process p reason] reason (after 3000 :no-down)))))

(defn parity-link-nontrap-reason [child-fn]
  (parity-observe parity-link-nontrap [child-fn]))

(defn parity-link-trap-reason [child-fn]
  (do
    (rt-spawn parity-link-trap [child-fn (rt-self)])
    (receive [:parity-trap reason] reason (after 3000 :no-trap))))

(defn parity-self-normal-trap-reason []
  (do
    (rt-spawn parity-self-normal-trap [(rt-self)])
    (receive [:parity-self-normal-trap reason] reason (after 3000 :no-message))))

(defn parity-other-normal []
  (let [pair (rt-spawn-monitor parity-park [])
        pid (nth pair 0)]
    (do
      (rt-exit pid :normal)
      (parity-settle)
      (if (rt-alive? pid)
        (do
          (rt-exit pid :kill)
          (receive [:down r :process p reason] :survived (after 3000 :no-down)))
        :died))))

(defn parity-kill-linked-child
  "A third process kills a parked process's linked child with :kill: the parked
   partner dies with the link-carried reason."
  [child-fn]
  (let [pair (rt-spawn-monitor parity-link-report-child [child-fn (rt-self)])
        child (receive [:parity-child c] c (after 3000 :no-child))]
    (do
      (rt-exit child :kill)
      (receive [:down r :process p reason] reason (after 3000 :no-down)))))

(defn life-exit-parity
  "The exit-signal reason table, computed on the live runtime. `main` prints
   each pair as `EXIT-PARITY <key> <reason>` for the native-BEAM differential in
   verify-lifecycle.mjs."
  []
  (list
    ["d1-explicit-kill" (parity-explicit-kill)]
    ["d1-exit1-kill" (parity-observe parity-exit1-kill [])]
    ["d1-link-exit1-kill-nontrap" (parity-link-nontrap-reason parity-exit1-kill)]
    ["d1-link-exit1-kill-trap" (parity-link-trap-reason parity-exit1-kill)]
    ["d1-link-explicit-kill-nontrap" (parity-kill-linked-child parity-park)]
    ["d2-self-normal" (parity-observe parity-self-normal [])]
    ["d2-self-normal-trap" (parity-self-normal-trap-reason)]
    ["d2-other-normal-nontrap" (parity-other-normal)]
    ["d2-link-normal-nontrap" (parity-link-nontrap-reason parity-normal)]
    ["d2-link-normal-trap" (parity-link-trap-reason parity-normal)]
    ["f2-linked-kill" (parity-observe parity-die-with-linked [parity-park])]))

(defn life-self-kill-parent
  "Kill a linked child with :kill. The child's death signal reaches this RUNNING
   process through the link, so it must end with the child's reason and its
   registry entry must survive until its frames unwind. The link after the kill
   is unreachable once that holds; it is here so a regression shows up as a
   stale link endpoint at the next scheduler boundary."
  [to]
  (let [child (rt-spawn-link life-park-long [])]
    (do
      (rt-exit child :kill)
      (rt-link (rt-spawn life-park-long []))
      (rt-send to [:life-self-kill-survived])
      :life-self-kill-done)))

(defn life-self-kill []
  (let [pair (rt-spawn-monitor life-self-kill-parent [(rt-self)])
        parent (nth pair 0)
        mref (nth pair 1)
        stray (receive [:life-self-kill-survived] :life-survived (after 200 :life-none))
        down (receive [:down r :process p reason] [r p reason]
                      (after 3000 [:life-timeout :life-none :life-none]))]
    (check-all
      (list
        ["life-self-kill-no-escape" stray :life-none]
        ["life-self-kill-parent-dies-killed" down [mref parent :killed]]
        ["life-self-kill-no-stale-parent" (rt-alive? parent) false]
        ["life-self-kill-leaves-no-monitor" (rt-monitor-count) 0]))))

(defn life-alien-pid
  "A pid from another runtime is well-formed but not LOCAL: the runtime id is an
   allocated identity, never a clock reading, so the next id is provably not
   this runtime's and the send must be refused."
  []
  (let [rt (rt-runtime-of (host/state))
        alien [:pid (host/arith "add" rt 1) 0]]
    (check-all
      (list
        ["life-runtime-id-is-integer" (host/is-int rt) true]
        ["life-alien-pid-is-typed" (rt-pid? alien) true]
        ["life-alien-pid-not-local" (rt-local-pid? (host/state) alien) false]
        ["life-alien-pid-send-refused" (rt-send alien :alien) nil]))))

(defn life-f2-probe
  "The F2 regression: a RUNNING process kills its linked child with :kill, so the
   child's death signal comes back through the link. verify-lifecycle.mjs runs
   this as the whole program with the per-process slice DISABLED, so the code
   below DOES execute on a runtime that deleted this process mid-turn (F2); it
   must NOT: the fixed runtime ends the turn with the link's reason first. The
   marker on stdout is the evidence."
  []
  (let [child (rt-spawn-link life-park-long [])]
    (do
      (rt-exit child :kill)
      (rt-send (rt-self) :f2-marker)
      (host/write "F2-CONTINUED")
      (receive :f2-marker :f2-seen (after 0 :f2-none)))))

(defn life-self-monitored-crash
  "Self-monitor, then die abnormally. A monitor a process holds on ITSELF is not
   an observer, so this death must still fail the batch; verify-lifecycle.mjs
   runs exactly this as its own child process."
  []
  (do
    (rt-monitor (rt-self))
    (erlang/raise :error :life-self-monitored)))


; ── driver ───────────────────────────────────────────────────────────────────

(defn tally2 [a b] (+ a b))

; Regression cases distinguish correct lowering from a merely finishing loop.
(defn emit-effects [to]
  (rt-send to :effect-one)
  (rt-send to :effect-two)
  42)

(defn emitter-regressions []
  (let [value (emit-effects (rt-self))
        one (receive :effect-one :one (after 0 :missing))
        two (receive :effect-two :two (after 0 :missing))]
    (rt-send (rt-self) {:kind :map :answer 17})
    (rt-send (rt-self) [:wild 1 2])
    (rt-send (rt-self) [:guard-error 9])
    (rt-send (rt-self) :body-effects)
    (let [m (receive {:kind :map :answer x} x (after 0 :missing))
          w (receive [:wild _ _] :wild-ok (after 0 :missing))
          g (receive [:guard-error x] :when (> (tuple-size x) 0) :wrong
                     [:guard-error _] :guard-failed (after 0 :missing))
          b (receive :body-effects (do (rt-send (rt-self) :body-side-effect) 23)
                     (after 0 :missing))
          effect (receive :body-side-effect :present (after 0 :missing))]
      (check-all (list ["do-last-value" value 42]
                       ["do-first-effect" one :one]
                       ["do-second-effect" two :two]
                       ["map-pattern-key" m 17]
                       ["repeated-wildcard" w :wild-ok]
                       ["guard-error-falls-through" g :guard-failed]
                       ["receive-do-last-value" b 23]
                       ["receive-do-effect" effect :present]
                       ["munging-distinct-names" (let [a-b 1 a_b 2] (+ a-b a_b)) 3]
                       ["control-shaped-value" {:k :park :__step true} {:k :park :__step true}])))))

(defn spin-until-stop [to]
  (loop []
    (receive :stop (rt-send to :stopped)
             (after 0 (recur)))))

(defn timer-fairness-regression []
  (let [peer (rt-spawn spin-until-stop [(rt-self)])
        timed (receive :never :wrong (after 5 :expired))]
    (rt-send peer :stop)
    (let [stopped (receive :stopped :stopped (after 2000 :missing))]
      (check-all (list ["timeout-under-runnable-peer" timed :expired]
                       ["zero-timeout-loop-peer-stops" stopped :stopped])))))

(defn send-many [to n]
  (loop [i 0]
    (if (< i n)
      (do (rt-send to [:stress i]) (recur (inc i)))
      :done)))

(defn mailbox-mutation-regression []
  (rt-spawn send-many [(rt-self) 30])
  (rt-spawn send-many [(rt-self) 30])
  (loop [n 0 total 0]
    (if (< n 60)
      (let [value (receive [:stress x] x (after 2000 -10000))]
        (recur (inc n) (+ total value)))
      (check "concurrent-mailbox-updates" total 870))))

; A generator must retain its try scope across calls, parks and cleanup.
(defn invoke-zero [f] (f))

(defn exception-tests []
  (let [self (rt-self)
        plain (try 11 (finally (rt-send self :plain-clean)))
        cleanup (receive :plain-clean :seen (after 0 :missing))
        duplicate (receive :plain-clean :duplicate (after 0 :none))
        caught (try (throw (ex-info "boom" {:code 17}))
                    (catch e [(ex-message e) (:code (ex-data e))]))
        map-payload (try (throw {:code 23})
                         (catch e (:code (ex-data e))))
        nested (try (try (throw {:first true})
                         (catch e (throw {:second true})))
                    (catch e (:second (ex-data e))))
        cleanup-override (try (try (throw {:code :body})
                                   (finally (throw {:code :cleanup})))
                              (catch e (:code (ex-data e))))
        finalizer-over-normal (try (try :normal
                                        (finally (throw {:code :cleanup-on-normal})))
                                   (catch e (:code (ex-data e))))
        higher-order (try (invoke-zero (fn [] (throw {:code :callee})))
                          (catch e (:code (ex-data e))))
        typed (try (throw (ex-info "typed" {:code :matched}))
                   (catch ExceptionInfo e (:code (ex-data e))))
        typed-fallthrough (try (try (throw (ex-info "typed" {:code :not-matched}))
                                        (catch ArithmeticException e :wrong))
                                (catch e (:code (ex-data e))))
        nested-normal (try (try :normal (finally (rt-send self :inner-clean)))
                           (finally (rt-send self :outer-clean)))
        inner (receive :inner-clean :inner (after 0 :missing))
        outer (receive :outer-clean :outer (after 0 :missing))]
    (check-all (list ["try-normal-value" plain 11]
                     ["finally-on-normal" cleanup :seen]
                     ["finally-only-once" duplicate :none]
                     ["catch-exinfo-message-data" caught ["boom" 17]]
                     ["throw-map-data" map-payload 23]
                     ["catch-does-not-catch-own-throw" nested true]
                     ["finalizer-error-supersedes-error" cleanup-override :cleanup]
                     ["finalizer-error-supersedes-value" finalizer-over-normal :cleanup-on-normal]
                     ["callee-raise-crosses-call-frame" higher-order :callee]
                     ["typed-catch-matches" typed :matched]
                     ["typed-catch-falls-through" typed-fallthrough :not-matched]
                     ["nested-normal-value" nested-normal :normal]
                     ["nested-finalizer-inner-first" inner :inner]
                     ["nested-finalizer-outer-second" outer :outer]))))

(defn suspended-finalizer-tests []
  (let [self (rt-self)]
    (rt-spawn delayed-sender [self :resume 5])
    (let [returned (try (receive :resume :woke (after 1000 :body-timeout))
                        (finally (receive (after 5 (rt-send self :final-clean)))))
          cleanup (receive :final-clean :seen (after 1000 :missing))
          caught (try (try (throw {:code :original})
                           (finally (receive (after 5 (rt-send self :error-clean)))))
                      (catch e (:code (ex-data e))))
          cleanup2 (receive :error-clean :seen (after 1000 :missing))
          handler (try (throw {:code :handler})
                       (catch e (do (receive (after 5 :handler-awake))
                                    (:code (ex-data e)))))]
      (check-all (list ["receive-in-protected-body" returned :woke]
                       ["finalizer-receive-completed" cleanup :seen]
                       ["original-error-survives-parked-finalizer" caught :original]
                       ["exception-finalizer-effect" cleanup2 :seen]
                       ["parked-catch-handler" handler :handler])))))

(defn protected-tail-tests []
  (let [self (rt-self)
        result (try (count-down 50000)
                    (finally (rt-send self :tail-clean)))
        cleanup (receive :tail-clean :seen (after 0 :missing))]
    (check-all (list ["tail-loop-in-try" result 50000]
                     ["tail-try-runs-finalizer" cleanup :seen]))))

; ── logical source frames (FEAT-048) ─────────────────────────────────────────
;
; The machine keeps one entry per live generator frame — the CALL-SITE metadata
; the emitter stamped off the reader's source span — and `host/logical-stack`
; answers it, innermost first. These tests pin what makes it a STACKTRACE and
; not a decoration: it names the function and line a call was written at, its
; module is the source file, it survives parking and a catch, and 50k tail
; iterations keep the stored stack bounded. Reading the stack INSIDE a receive
; body, a catch handler and a finalizer is the whole point: those are exactly
; the places a suspension or an unwind could lose a frame.

(defn trace-stack [] (host/logical-stack))

(defn trace-g [] (host/logical-stack))
(defn trace-f [] (trace-g))

(defn trace-hof [f]
  (let [x (f)] x))

(defn trace-parked []
  (receive (after 5 :trace-parked-tick))
  (receive :trace-wake (trace-stack) (after 2000 (trace-stack))))

(defn trace-typed []
  (try (throw (ex-info "trace-typed" {:code :trace-typed}))
       (catch ExceptionInfo e [(trace-stack) (:code (ex-data e))])))

(defn trace-fallthrough []
  (try
    (try (throw (ex-info "trace-fallthrough" {:code :trace-body}))
         (catch ArithmeticException e :trace-unmatched))
    (catch ExceptionInfo e [(trace-stack) (:code (ex-data e))])))

(defn trace-finalizer []
  (try
    (try (throw (ex-info "body" {:code :trace-body}))
         (finally (throw (ex-info "cleanup" {:code :trace-cleanup}))))
    (catch ExceptionInfo e [(trace-stack) (:code (ex-data e))])))

(defn trace-countdown [n]
  (loop [i n] (if (< i 1) :trace-done (recur (- i 1)))))

(defn trace-variadic-site [x & xs] (host/logical-stack))
(defn trace-multi-site
  ([x] (host/logical-stack))
  ([x y] (host/logical-stack)))
(defn trace-loop-site []
  (loop [i 1]
    (if (= i 0) (host/logical-stack) (recur (- i 1)))))

(defn trace-tail []
  (let [r (trace-countdown 50000)
        st (host/logical-stack)]
    [r (count st)]))

(defn trace-by-fn [frames name]
  (if (= (count frames) 0)
    nil
    (if (= (:fn (first frames)) name)
      (first frames)
      (trace-by-fn (rest frames) name))))

(defn trace-frame-tests []
  (let [self (rt-self)
        _ (rt-spawn delayed-sender [self :trace-wake 50])
        direct (trace-f)
        hof (trace-hof (fn [] (host/logical-stack)))
        parked (trace-parked)
        typed (trace-typed)
        fell (trace-fallthrough)
        fin (trace-finalizer)
        variadic (trace-variadic-site 1 2 3)
        multi (trace-multi-site 1 2)
        loop-site (trace-loop-site)
        tail (trace-tail)]
    (check-all
      (list
        ;; A native leaf reports its own call site first; the caller frame remains.
        ["trace-direct-file" (:file (first direct)) "research/js-actors/test.bl"]
        ["trace-direct-fn" (:fn (first direct)) "trace-g"]
        ["trace-direct-arity" (:arity (first direct)) 0]
        ["trace-direct-tail-elided" (nil? (trace-by-fn direct "trace-f")) true]
        ["trace-direct-line-int" (host/is-int (:line (first direct))) true]
        ["trace-direct-col-int" (host/is-int (:col (first direct))) true]
        ["trace-direct-deeper" (host/lt 1 (count direct)) true]
        ;; A tail-called anonymous callback replaces the dynamic caller frame.
        ["trace-hof-fn" (:fn (first hof)) nil]
        ["trace-hof-arity" (:arity (first hof)) 0]
        ["trace-hof-call" (:call (first hof)) :tail]
        ["trace-hof-tail-elided" (nil? (trace-by-fn hof "trace-hof")) true]
        ["trace-hof-line-int" (host/is-int (:line (first hof))) true]
        ;; parked receive: the frame selected after the park is still named
        ["trace-park-fn" (:fn (first parked)) "trace-stack"]
        ["trace-park-file" (:file (first parked)) "research/js-actors/test.bl"]
        ["trace-park-line-int" (host/is-int (:line (first parked))) true]
        ;; typed catch, and a typed-catch fallthrough that re-raises
        ["trace-typed-fn" (:fn (first (nth typed 0))) "trace-stack"]
        ["trace-typed-code" (nth typed 1) :trace-typed]
        ["trace-fallthrough-fn" (:fn (trace-by-fn (nth fell 0) "trace-fallthrough")) "trace-fallthrough"]
        ["trace-fallthrough-code" (nth fell 1) :trace-body]
        ;; a finalizer throw supersedes the pending error, frames and all
        ["trace-finalizer-fn" (:fn (first (nth fin 0))) "trace-stack"]
        ["trace-finalizer-code" (nth fin 1) :trace-cleanup]
        ;; A named def remains named after $blfn dispatch and loop lowering.
        ["trace-variadic-named" (:fn (trace-by-fn variadic "trace-variadic-site")) "trace-variadic-site"]
        ["trace-multi-named" (:fn (trace-by-fn multi "trace-multi-site")) "trace-multi-site"]
        ["trace-loop-named" (:fn (trace-by-fn loop-site "trace-loop-site")) "trace-loop-site"]
        ;; a 50k tail loop stores O(depth), not O(iterations)
        ["trace-tail-value" (nth tail 0) :trace-done]
        ["trace-tail-stack-bounded" (host/lt (nth tail 1) 1024) true]
        ["trace-tail-frames-bounded" (host/lt (host/max-frames) 1024) true]))))

; ── uncaught entry points for verify-trace.mjs ───────────────────────────────
;
; Each of these dies uncaught when run as the program entry, so verify-trace.mjs
; can read the RENDERED location off stdout. They pin the trace rules: a raise
; records where it was thrown; a re-raise preserves that; a finalizer throw
; supersedes it.

(defn trace-boom [] (throw (ex-info "trace-boom" {:code :trace-boom-throw})))
(defn trace-cleanup [] (throw (ex-info "trace-cleanup" {:code :trace-cleanup-throw})))

(defn trace-die-direct [] (trace-boom))

(defn trace-die-rethrow []
  (try (trace-boom) (catch ArithmeticException e :trace-unmatched)))

(defn trace-die-finalizer []
  (try (trace-boom) (finally (trace-cleanup))))

; ── FEAT-052: portable tables — identity, ownership, heir, access, atomic ops ─
;
; A table here is a REAL table: created by a process, owned by it, and disposed
; of by that owner's death. These tests are the research sheet's gates run as
; code — owner death disposes (I3.1), a named heir receives the transfer in the
; same atomic step as the death (I3.2), a duplicate name is refused loudly
; (I3.3), concurrent counter updates are exact (I3.4), a read is a snapshot
; (I3.5) — plus the edges that make a table primitive dangerous: a forged,
; foreign or dead handle, a row HOLDING nil, a double delete, and a match spec
; this target does not support, which must fail LOUDLY rather than answer a
; different question quietly.
;
; Every table made here is destroyed, or taken by its owner's death, so the
; section ends with an EMPTY registry — `tbl-no-stale-tables` is that
; assertion, and verify-tables.mjs counts the host-side handles independently.
;
; `TABLE-PARITY` lines are the differential with native ETS: verify-tables.mjs
; runs the same scenarios on BEAM and compares the tokens, so the supported
; subset is MEASURED against the real thing rather than described.

(defn tbl-trap
  "Run `f`, answering :ok or the ORIGINAL reason of a raise — the structured
   value, not its prose, because the reasons are what these tests compare."
  [f]
  (try (do (f) :ok) (catch e (ex-original e))))

(defn tbl-peek
  "The VALUE under `k`, or :missing — so a row that HOLDS nil is distinguishable
   from a key that is not there, which is the whole point of the case."
  [tid k]
  (let [rows (table-lookup tid k)]
    (if (empty? rows) :missing (host/tup-el (first rows) 1))))

(defn tbl-verdict
  "A cross-process verdict as the two tokens the native-BEAM differential
   compares: `ok` when the operation ran, `denied` when it was refused. What was
   refused stays in the check, not in the token."
  [v]
  (if (host/eq v :ok) :ok :denied))

(defn tbl-need
  "A verdict as the NEED that was refused: :ok when the operation ran, the need
   (:read/:write/:own) inside a `[:table-access-denied tid need mode owner]`,
   :none when no verdict arrived at all."
  [v]
  (cond
    (host/eq v :ok) :ok
    (host/is-vec v) (nth v 2)
    :else :none))

(defn tbl-owner
  "Create a table with `opts`, write one row, report `[tid self]`, then park
   until killed — the OWNER of the table it just made."
  [opts to]
  (let [t (table-new opts)]
    (do
      (table-insert t :k 1)
      (rt-send to [:tbl-ready t (rt-self)])
      (receive :die :tbl-owner-done (after 5000 :tbl-owner-timeout)))))

(defn tbl-heir
  "The `proc.table` heir in miniature: file every table handed to it by a death
   transfer, report it, hand a held table back when asked, and hold until told
   to stop. Its whole state is `parent`; the table ids arrive in the messages."
  [parent]
  (receive
    [:ets-transfer tid from data] (do (rt-send parent [:tbl-caught tid from data])
                                      (tbl-heir parent))
    [:tbl-give tid to] (do (table-give-away tid to)
                           (rt-send parent [:tbl-gave tid])
                           (tbl-heir parent))
    :die :tbl-heir-done
    (after 5000 :tbl-heir-timeout)))

(defn tbl-prober
  "Ask a table five questions from ANOTHER process — a read, a write, a size,
   the owner-only give-away and the destroy — and report the raw verdicts,
   unclassified. Which of them are refusals is the caller's question, not this
   process's."
  [tid parent]
  (rt-send parent
            [:tbl-probe
             (tbl-trap (fn [] (table-lookup tid :k)))
             (tbl-trap (fn [] (table-insert tid :p 1)))
             (tbl-trap (fn [] (table-size tid)))
             (tbl-trap (fn [] (table-give-away tid (rt-self))))
             (tbl-trap (fn [] (table-destroy tid)))]))

(defn tbl-run-prober
  "Run the prober to completion and answer its report. The report is received
   BEFORE the DOWN, and both receives are selective, so the order the two
   messages land in cannot matter."
  [tid]
  (let [pair (rt-spawn-monitor tbl-prober [tid (rt-self)])
        report (receive [:tbl-probe a b c d e] [a b c d e]
                        (after 3000 [:tbl-none :tbl-none :tbl-none :tbl-none :tbl-none]))
        _down (receive [:down r :process p reason] reason (after 3000 :tbl-no-prober-down))]
    report))

(defn tbl-bump
  "Increment the counter `n` times from THIS process. An update lost to a slice
   boundary shows up as a total nobody can explain."
  [tid n]
  (loop [i 0]
    (if (< i n)
      (do (table-update-counter tid :sum 1) (recur (+ i 1)))
      :tbl-bumped)))

(defn tbl-mode-case
  "One access mode, seen from its OWNER and from ANOTHER process. Prints the
   four cross-process verdicts as TABLE-PARITY tokens (the BEAM differential)
   and answers the needs for the checks: `[read write size destroy mine-read
   mine-write mine-size survived]`. `survived` is :alive unless the other
   process's `table-destroy` actually landed — which, for `:public`, it does."
  [mode]
  (let [t (table-new {:mode mode})
        _ins (table-insert t :k 1)
        mine-read (tbl-need (tbl-trap (fn [] (table-lookup t :k))))
        mine-write (tbl-need (tbl-trap (fn [] (table-insert t :k 2))))
        mine-size (tbl-need (tbl-trap (fn [] (table-size t))))
        probe (tbl-run-prober t)
        read (tbl-need (nth probe 0))
        write (tbl-need (nth probe 1))
        size (tbl-need (nth probe 2))
        give (tbl-need (nth probe 3))
        own (tbl-need (nth probe 4))
        stale (tbl-trap (fn [] (table-size t)))
        survived (if (host/is-vec stale) :gone :alive)
        _destroy (tbl-trap (fn [] (table-destroy t)))
        tag (name mode)
        read-tok (host/to-str (tbl-verdict read))
        write-tok (host/to-str (tbl-verdict write))
        give-tok (host/to-str (tbl-verdict give))
        own-tok (host/to-str (tbl-verdict own))]
    (do
      (host/write (str "TABLE-PARITY " tag "-read-other " read-tok))
      (host/write (str "TABLE-PARITY " tag "-write-other " write-tok))
      (host/write (str "TABLE-PARITY " tag "-give-away-other " give-tok))
      (host/write (str "TABLE-PARITY " tag "-destroy-other " own-tok))
      [read write size own give mine-read mine-write mine-size survived])))

(defn table-lifecycle-tests
  "An owner that dies takes its unheired table with it: the identity, the name
   and the host storage all go in the same transaction, and every later
   operation names the absence instead of reaching freed storage."
  []
  (let [pair (rt-spawn-monitor tbl-owner [{:name :tbl-doomed} (rt-self)])
        owner (nth pair 0)
        ready (receive [:tbl-ready t p] [t p] (after 2000 [:tbl-timeout :tbl-timeout]))
        tid (nth ready 0)
        named (table-whereis :tbl-doomed)
        owned (table-owner tid)
        _kill (rt-exit owner :kill)
        why (receive [:down r :process p reason] reason (after 2000 :tbl-no-down))
        gone (table-owner tid)
        freed (table-whereis :tbl-doomed)
        read-after (tbl-trap (fn [] (table-size tid)))
        write-after (tbl-trap (fn [] (table-insert tid :x 1)))
        raw (host/table-new)
        _raw (host/table-destroy raw)]
    (check-all
      (list
        ["tbl-owner-is-reporter" (host/eq (nth ready 1) owner) true]
        ["tbl-owner-owns-it" (host/eq owned owner) true]
        ["tbl-owner-name-registered" (host/eq named tid) true]
        ["tbl-owner-death-observed" why :killed]
        ["tbl-unheired-destroyed" gone nil]
        ["tbl-unheired-name-freed" freed nil]
        ["tbl-dead-read-refused" read-after [:no-such-table tid]]
        ["tbl-dead-write-refused" write-after [:no-such-table tid]]))))

(defn table-heir-tests
  "The proc.table pattern, run: the owner names an heir AT CREATION, dies, the
   heir catches the table with its rows and its NAME, holds it under the same
   access rules, and hands it to a new owner that can write to it again."
  []
  (let [hpair (rt-spawn-monitor tbl-heir [(rt-self)])
        heir (nth hpair 0)
        opair (rt-spawn-monitor tbl-owner [{:heir heir :heir-data :gift
                                            :name :tbl-heired}
                                           (rt-self)])
        owner (nth opair 0)
        ready (receive [:tbl-ready t p] [t p] (after 2000 [:tbl-timeout :tbl-timeout]))
        tid (nth ready 0)
        held (table-owner tid)
        _kill (rt-exit owner :kill)
        _odown (receive [:down r :process p reason] reason (after 2000 :tbl-no-down))
        caught (receive [:tbl-caught t2 from data] [t2 from data]
                        (after 2000 [:tbl-none :tbl-none :tbl-none]))
        after-transfer (table-owner tid)
        size-after (table-size tid)
        value-after (tbl-peek tid :k)
        still-guarded (tbl-need (tbl-trap (fn [] (table-insert tid :mine 9))))
        name-after (table-whereis :tbl-heired)
        _give (rt-send heir [:tbl-give tid (rt-self)])
        gave (receive [:tbl-gave g] g (after 2000 :tbl-no-gave))
        owner-now (table-owner tid)
        _mine (table-insert tid :mine 9)
        reclaimed (tbl-peek tid :mine)
        _destroy (table-destroy tid)
        destroyed (tbl-trap (fn [] (table-size tid)))
        freed (table-whereis :tbl-heired)
        _hkill (rt-exit heir :kill)
        hwhy (receive [:down r :process p reason] reason (after 2000 :tbl-no-heir-down))]
    (check-all
      (list
        ["tbl-heir-owner-holds-first" (host/eq held owner) true]
        ["tbl-heir-transfer-identity" (nth caught 0) tid]
        ["tbl-heir-transfer-former-owner" (nth caught 1) owner]
        ["tbl-heir-transfer-data" (nth caught 2) :gift]
        ["tbl-heir-owns-after-death" (host/eq after-transfer heir) true]
        ["tbl-heir-rows-intact" size-after 1]
        ["tbl-heir-value-intact" value-after 1]
        ["tbl-heir-name-outlives-owner" (host/eq name-after tid) true]
        ["tbl-heir-not-a-write-permission" still-guarded :write]
        ["tbl-heir-gave-back" gave tid]
        ["tbl-heir-reclaimed" (host/eq owner-now (rt-self)) true]
        ["tbl-heir-reclaimed-write" reclaimed 9]
        ["tbl-heir-destroyed" destroyed [:no-such-table tid]]
        ["tbl-heir-name-freed-by-destroy" freed nil]
        ["tbl-heir-death-observed" hwhy :killed]))))

(defn table-access-tests
  "The three modes, each from the owner and from another process. `:private`
   refuses both directions, `:protected` refuses only the write, `:public`
   refuses neither — and the owner-only operations (`table-give-away`) refuse
   the other process in EVERY mode, `:public` included. `table-destroy` asks for
   a WRITE, so it is refused in the first two modes and succeeds in the third,
   exactly as `:ets.delete/1` does."
  []
  (let [priv (tbl-mode-case :private)
        prot (tbl-mode-case :protected)
        pub (tbl-mode-case :public)]
    (check-all
      (list
        ["tbl-private-read-other-denied" (nth priv 0) :read]
        ["tbl-private-write-other-denied" (nth priv 1) :write]
        ["tbl-private-size-other-denied" (nth priv 2) :read]
        ["tbl-private-destroy-other-denied" (nth priv 3) :write]
        ["tbl-private-give-away-other-denied" (nth priv 4) :own]
        ["tbl-private-owner-reads" (nth priv 5) :ok]
        ["tbl-private-owner-writes" (nth priv 6) :ok]
        ["tbl-private-owner-sizes" (nth priv 7) :ok]
        ["tbl-private-alive-after-refusal" (nth priv 8) :alive]
        ["tbl-protected-read-other-ok" (nth prot 0) :ok]
        ["tbl-protected-write-other-denied" (nth prot 1) :write]
        ["tbl-protected-size-other-ok" (nth prot 2) :ok]
        ["tbl-protected-destroy-other-denied" (nth prot 3) :write]
        ["tbl-protected-give-away-other-denied" (nth prot 4) :own]
        ["tbl-protected-owner-writes" (nth prot 6) :ok]
        ["tbl-protected-alive-after-refusal" (nth prot 8) :alive]
        ["tbl-public-read-other-ok" (nth pub 0) :ok]
        ["tbl-public-write-other-ok" (nth pub 1) :ok]
        ["tbl-public-size-other-ok" (nth pub 2) :ok]
        ["tbl-public-destroy-other-ok" (nth pub 3) :ok]
        ["tbl-public-give-away-other-denied" (nth pub 4) :own]
        ["tbl-public-owner-writes" (nth pub 6) :ok]
        ["tbl-public-destroyed-by-other" (nth pub 8) :gone]))))

(defn table-name-tests
  "Names are unique, loud, released with the table they name, and a SEPARATE
   address space from process names — `whereis` and `table-whereis` answer about
   two different things, and one map cannot collide the two."
  []
  (let [first-t (table-new {:name :tbl-dup})
        again (tbl-trap (fn [] (table-new {:name :tbl-dup})))
        still (table-whereis :tbl-dup)
        first-writable (table-insert first-t :after 1)
        other (table-new {:name :tbl-other})
        other-named (table-whereis :tbl-other)
        _reg (rt-register-name :tbl-both (rt-self))
        both (tbl-trap (fn [] (table-new {:name :tbl-both})))
        both-tid (table-whereis :tbl-both)
        both-named (host/eq both-tid (table-whereis :tbl-both))
        pid-look (rt-whereis-name :tbl-both)
        _unreg (rt-unregister-name :tbl-both)
        bad-type (tbl-trap (fn [] (table-new {:type :ordered_set})))
        bad-bag (tbl-trap (fn [] (table-new {:type :bag})))
        bad-mode (tbl-trap (fn [] (table-new {:mode :shared})))
        bad-mode-with-type (tbl-trap (fn [] (table-new {:type :set :mode :shared})))
        bad-name (tbl-trap (fn [] (table-new {:name 42})))
        bad-name-with-mode (tbl-trap (fn [] (table-new {:mode :protected :name 42})))
        bad-heir (tbl-trap (fn [] (table-new {:heir :nobody})))
        foreign-heir (tbl-trap (fn [] (table-new {:heir [:pid 999 1]})))
        bad-opts (tbl-trap (fn [] (table-new :not-a-map)))
        d-first (tbl-trap (fn [] (table-destroy first-t)))
        after-destroy (table-whereis :tbl-dup)
        reused (tbl-trap (fn [] (table-new {:name :tbl-dup})))
        reused-tid (table-whereis :tbl-dup)
        d-other (tbl-trap (fn [] (table-destroy other)))
        d-both (tbl-trap (fn [] (table-destroy both-tid)))
        d-reused (tbl-trap (fn [] (table-destroy reused-tid)))]
    (check-all
      (list
        ["tbl-name-duplicate-refused" again [:table-name-taken :tbl-dup]]
        ["tbl-name-first-stands" (host/eq still first-t) true]
        ["tbl-name-first-still-writable" first-writable true]
        ["tbl-name-two-names-two-tables" (host/eq other-named other) true]
        ["tbl-name-separate-from-process-name" (host/eq pid-look (rt-self)) true]
        ["tbl-name-table-space-holds" both-named true]
        ["tbl-name-destroy-first" d-first :ok]
        ["tbl-name-released-by-destroy" after-destroy nil]
        ["tbl-name-reusable-after-destroy" (host/is-vec reused-tid) true]
        ["tbl-name-cleanup-other" d-other :ok]
        ["tbl-name-cleanup-both" d-both :ok]
        ["tbl-name-cleanup-reused" d-reused :ok]
        ["tbl-type-ordered-set-refused" bad-type [:table-unsupported-type :ordered_set]]
        ["tbl-type-bag-refused" bad-bag [:table-unsupported-type :bag]]
        ["tbl-mode-unknown-refused" bad-mode [:table-bad-mode :shared]]
        ["tbl-mode-after-valid-type-refused" bad-mode-with-type [:table-bad-mode :shared]]
        ["tbl-name-not-a-key-refused" bad-name [:table-name-not-a-keyword-or-string 42]]
        ["tbl-name-after-valid-mode-refused" bad-name-with-mode [:table-name-not-a-keyword-or-string 42]]
        ["tbl-heir-not-a-pid-refused" bad-heir [:table-bad-heir :nobody]]
        ["tbl-heir-foreign-pid-refused" foreign-heir [:table-bad-heir [:pid 999 1]]]
        ["tbl-opts-not-a-map-refused" bad-opts [:table-bad-options :not-a-map]]))))

(defn table-op-tests
  "The operations themselves, and the values that make a table primitive
   dangerous: a row holding nil, an absent key, a double delete, a snapshot that
   cannot change under the reader, and a match spec this target does NOT have —
   refused by name instead of silently widened."
  []
  (let [t (table-new {})
        absent (table-lookup t :missing)
        absent-peek (tbl-peek t :missing)
        _nil (table-insert t :n nil)
        nil-row (count (table-lookup t :n))
        nil-peek (tbl-peek t :n)
        size-nil (table-size t)
        del1 (table-delete t :n)
        del2 (table-delete t :n)
        size-after (table-size t)
        miss-del (table-delete t :never)
        _a1 (table-insert t :a 1)
        _b2 (table-insert t :b 2)
        _a3 (table-insert t :a 3)
        replaced (tbl-peek t :a)
        rows (table-size t)
        snap (table-snapshot t)
        _c4 (table-insert t :c 4)
        snap-still (count snap)
        snap-now (table-size t)
        select-all (count (table-select t [[:_ :_]]))
        select-key (count (table-select t [[:a :_]]))
        select-val (count (table-select t [[:_ 2]]))
        select-order (host/tup-el (first (table-select t [[:_ :_]])) 0)
        spec-guards (tbl-trap (fn [] (table-select t [[:a :_ :guards]])))
        spec-clauses (tbl-trap (fn [] (table-select t [[:_ :_] [:_ :_]])))
        spec-empty (tbl-trap (fn [] (table-select t [])))
        spec-atom (tbl-trap (fn [] (table-select t :all)))
        spec-var (tbl-trap (fn [] (table-select t [[(keyword "$1") :_]])))
        spec-cont (tbl-trap (fn [] (table-select t (host/tup (host/list->array (list 1 :cont))))))
        bad-nil (tbl-trap (fn [] (table-size nil)))
        bad-int (tbl-trap (fn [] (table-size 7)))
        bad-pid (tbl-trap (fn [] (table-size (rt-self))))
        foreign (tbl-trap (fn [] (table-size [:table 999 1])))
        unknown (tbl-trap (fn [] (table-size [:table (nth (rt-self) 1) 999999])))
        raw (host/table-new)
        raw-is-table (host/is-table raw)
        raw-is-map (host/is-map raw)
        bad-raw (tbl-trap (fn [] (table-size raw)))
        _raw (host/table-destroy raw)
        alias-map (host/is-map t)
        alias-table (host/is-table t)
        _destroy (table-destroy t)
        after-destroy (tbl-trap (fn [] (table-size t)))]
    (check-all
      (list
        ["tbl-absent-key-is-empty" absent (host/empty-list)]
        ["tbl-absent-key-peek" absent-peek :missing]
        ["tbl-nil-row-is-a-row" nil-row 1]
        ["tbl-nil-row-value" nil-peek nil]
        ["tbl-nil-row-counts" size-nil 1]
        ["tbl-delete-present" del1 true]
        ["tbl-delete-twice-is-harmless" del2 false]
        ["tbl-delete-twice-empty" size-after 0]
        ["tbl-delete-absent" miss-del false]
        ["tbl-insert-replaces" replaced 3]
        ["tbl-set-has-one-row-per-key" rows 2]
        ["tbl-snapshot-is-a-copy" snap-still 2]
        ["tbl-snapshot-does-not-follow" snap-now 3]
        ["tbl-select-all-rows" select-all 3]
        ["tbl-select-by-key" select-key 1]
        ["tbl-select-by-value" select-val 1]
        ["tbl-select-insertion-order" select-order :a]
        ["tbl-select-guards-refused" (nth spec-guards 0) :unsupported-match-spec]
        ["tbl-select-two-clauses-refused" (nth spec-clauses 0) :unsupported-match-spec]
        ["tbl-select-empty-refused" (nth spec-empty 0) :unsupported-match-spec]
        ["tbl-select-atom-refused" (nth spec-atom 0) :unsupported-match-spec]
        ["tbl-select-variable-refused" (nth spec-var 0) :unsupported-match-spec]
        ["tbl-select-continuation-refused" (nth spec-cont 0) :unsupported-continuation]
        ["tbl-handle-nil-refused" bad-nil [:not-a-table nil]]
        ["tbl-handle-number-refused" bad-int [:not-a-table 7]]
        ["tbl-handle-pid-refused" bad-pid [:not-a-table (rt-self)]]
        ["tbl-handle-foreign-runtime-refused" foreign [:not-a-table [:table 999 1]]]
        ["tbl-handle-unknown-serial-refused"
         (nth unknown 0) :no-such-table]
        ["tbl-handle-raw-host-handle-is-a-table" raw-is-table true]
        ["tbl-handle-raw-host-handle-is-not-a-map" raw-is-map false]
        ["tbl-handle-raw-host-handle-refused" (nth bad-raw 0) :not-a-table]
        ["tbl-id-is-not-a-bl-map" alias-map false]
        ["tbl-id-is-not-a-host-handle" alias-table false]
        ["tbl-destroyed-id-refused" after-destroy [:no-such-table t]]))))

(defn table-counter-tests
  "`table-update-counter` under fire: four processes, one hundred increments, an
   exact total — which is what an atomic read-modify-write buys, and what a
   read-then-write across a slice boundary would lose. The counter is `:public`
   so that the other processes may write at all, and it is SEEDED first: a
   missing row is refused, as `:ets.update_counter/3` refuses it."
  []
  (let [t (table-new {:mode :public})
        missing (tbl-trap (fn [] (table-update-counter t :nope 1)))
        _seed (table-insert t :sum 0)
        fresh (table-update-counter t :sum 1)
        _w1 (rt-spawn-monitor tbl-bump [t 25])
        _w2 (rt-spawn-monitor tbl-bump [t 25])
        _w3 (rt-spawn-monitor tbl-bump [t 25])
        _w4 (rt-spawn-monitor tbl-bump [t 25])
        _d1 (receive [:down r :process p reason] reason (after 4000 :tbl-no-bump-down))
        _d2 (receive [:down r :process p reason] reason (after 4000 :tbl-no-bump-down))
        _d3 (receive [:down r :process p reason] reason (after 4000 :tbl-no-bump-down))
        _d4 (receive [:down r :process p reason] reason (after 4000 :tbl-no-bump-down))
        total (tbl-peek t :sum)
        back (table-update-counter t :sum -1)
        _flag (table-insert t :flag :not-a-counter)
        not-int (tbl-trap (fn [] (table-update-counter t :flag 1)))
        bad-delta (tbl-trap (fn [] (table-update-counter t :sum :nan)))
        _destroy (table-destroy t)]
    (check-all
      (list
        ["tbl-counter-missing-key-refused" missing [:table-no-such-row t :nope]]
        ["tbl-counter-first-update" fresh 1]
        ["tbl-counter-total-exact" total 101]
        ["tbl-counter-negative-delta" back 100]
        ["tbl-counter-non-integer-row-refused"
         (nth not-int 0) :table-not-an-integer]
        ["tbl-counter-bad-delta-refused" bad-delta [:table-bad-counter-delta :nan]]))))

(defn table-parity-tests
  "The lifecycle rules the native-BEAM differential compares (verify-tables.mjs
   runs the same scenarios on OTP): what an owner's death does to an unheired
   table and to its name, what an heir receives and holds, and the answers a
   read gives. Ends by asserting the registry is EMPTY — no table outlived the
   process that made it, and no metadata outlived its table."
  []
  (let [pair (rt-spawn-monitor tbl-owner [{:name :tbl-par-doomed} (rt-self)])
        owner (nth pair 0)
        ready (receive [:tbl-ready t p] [t p] (after 2000 [:tbl-timeout :tbl-timeout]))
        tid (nth ready 0)
        _kill (rt-exit owner :kill)
        _down (receive [:down r :process p reason] reason (after 2000 :tbl-no-down))
        destroyed (if (host/is-nil (table-owner tid)) "destroyed" "alive")
        name-free (if (host/is-nil (table-whereis :tbl-par-doomed)) "free" "held")
        hpair (rt-spawn-monitor tbl-heir [(rt-self)])
        heir (nth hpair 0)
        opair (rt-spawn-monitor tbl-owner [{:heir heir :heir-data :gift} (rt-self)])
        o2 (nth opair 0)
        r2 (receive [:tbl-ready t p] t (after 2000 :tbl-timeout))
        _k2 (rt-exit o2 :kill)
        _odown2 (receive [:down r :process p reason] reason (after 2000 :tbl-no-down))
        caught (receive [:tbl-caught t3 from data] [t3 from data]
                        (after 2000 [:tbl-none :tbl-none :tbl-none]))
        transferred (if (host/eq (nth caught 0) r2) "transferred" "lost")
        gift (host/to-str (nth caught 2))
        rows (host/to-str (table-size r2))
        heir-owns (if (host/eq (table-owner r2) heir) "heir" "other")
        _give (rt-send heir [:tbl-give r2 (rt-self)])
        _gave (receive [:tbl-gave g] g (after 2000 :tbl-no-gave))
        reclaimed (if (host/eq (table-owner r2) (rt-self)) "reclaimed" "other")
        _destroy (table-destroy r2)
        _hkill (rt-exit heir :kill)
        _hdown (receive [:down r :process p reason] reason (after 2000 :tbl-no-heir-down))
        kept (table-new {:name :tbl-par-kept})
        dup (tbl-trap (fn [] (table-new {:name :tbl-par-kept})))
        duplicate (if (host/eq (nth dup 0) :table-name-taken) "refused" "accepted")
        _kd (table-destroy kept)
        ct (table-new {})
        _cseed (table-insert ct :n 0)
        _c1 (table-update-counter ct :n 60)
        _c2 (table-update-counter ct :n 40)
        counter (host/to-str (tbl-peek ct :n))
        miss (tbl-trap (fn [] (table-update-counter ct :absent 1)))
        miss-tok (if (host/eq (nth miss 0) :table-no-such-row) "refused" "accepted")
        _ci (table-insert ct :nilrow nil)
        nil-row (if (host/eq (tbl-peek ct :nilrow) :missing) "absent" "present")
        absent-row (if (host/eq (tbl-peek ct :nope) :missing) "empty" "present")
        lookup-shape (host/to-str (count (table-lookup ct :n)))
        _cd (table-destroy ct)]
    (do
      (host/write (str "TABLE-PARITY owner-death-destroys " destroyed))
      (host/write (str "TABLE-PARITY name-freed-on-destroy " name-free))
      (host/write (str "TABLE-PARITY heir-transfer " transferred))
      (host/write (str "TABLE-PARITY heir-data " gift))
      (host/write (str "TABLE-PARITY heir-rows " rows))
      (host/write (str "TABLE-PARITY heir-owner " heir-owns))
      (host/write (str "TABLE-PARITY give-away " reclaimed))
      (host/write (str "TABLE-PARITY duplicate-name " duplicate))
      (host/write (str "TABLE-PARITY update-counter-total " counter))
      (host/write (str "TABLE-PARITY update-counter-missing-key " miss-tok))
      (host/write (str "TABLE-PARITY nil-row-present " nil-row))
      (host/write (str "TABLE-PARITY absent-row-empty " absent-row))
      (host/write (str "TABLE-PARITY lookup-shape-rows " lookup-shape))
      (check-all
      (list
        ["tbl-parity-owner-death-destroys" destroyed "destroyed"]
        ["tbl-parity-name-freed-on-destroy" name-free "free"]
        ["tbl-parity-heir-transfer" transferred "transferred"]
        ["tbl-parity-heir-data" gift "gift"]
        ["tbl-parity-heir-rows" rows "1"]
        ["tbl-parity-heir-owner" heir-owns "heir"]
        ["tbl-parity-give-away" reclaimed "reclaimed"]
        ["tbl-parity-duplicate-name" duplicate "refused"]
        ["tbl-parity-update-counter-total" counter "100"]
        ["tbl-parity-update-counter-missing-key" miss-tok "refused"]
        ["tbl-parity-nil-row-present" nil-row "present"]
        ["tbl-parity-absent-row-empty" absent-row "empty"]
        ["tbl-parity-lookup-shape-rows" lookup-shape "1"]
        ["tbl-no-stale-tables" (rt-table-count) 0])))))

; ── FEAT-050: process names and the correlated call protocol ────────────────
;
; The servers below are `proc/defserver` DECLARATIONS in ordinary source. The
; compiler lowers each one — through `proc.server/clause-plan` and this target's
; own vocabulary — to an entry defn plus one receive loop, so what these tests
; exercise is the DECLARATION surface, the lowering, the name table and the
; correlated call protocol together. Nothing here is a hand-written stand-in for
; a server.
;
; Every abnormal death in this section is OBSERVED (a monitor from the test
; process), which is the runtime's rule: an unobserved abnormal death is a run
; error. Every server spawned here is stopped before the section ends, because
; a process parked in a receive with no deadline and nothing runnable is the
; scheduler's deadlock diagnostic.

(defn srv-trace [tag v]
  (do (host/write (str "SRVTRACE " tag " " (host/describe v))) v))

(proc/defserver counter
  (init [_] (ok {:n 0 :seen []}))
  (handle-call [:bump by] [_from st] (reply (:n st) (assoc st :n (+ (:n st) by))))
  (handle-call [:ask v] [_from st] (reply v st))
  (handle-call [:slow v] [_from st]
    (do (receive (after 60 :tick)) (reply v st)))
  (handle-call [:watch pid] [_from st] (reply (rt-monitor pid) st))
  (handle-call [:state] [_from st] (reply st st))
  (handle-call :echo [_from st] (reply :echoed st))
  (handle-cast [:reset] [st] (noreply (assoc st :n 0)))
  (handle-info :ping [st] (noreply (assoc st :seen (conj (:seen st) :ping))))
  (handle-info [:DOWN _ref :process _pid why] [st]
    (noreply (assoc st :seen (conj (:seen st) why))))
  (terminate [reason _st] (do (srv-trace "terminate" reason) :ok)))

(proc/defserver ping-srv
  (init [_] (ok {:n 0}))
  (handle-call :ping [_from st] (reply (:n st) (assoc st :n (+ (:n st) 1)))))

(proc/defserver crasher
  (init [_] (ok {}))
  (handle-call :boom [_from st] (do (erlang/exit :crasher-exploded)))
  (handle-call :ok [_from st] (reply :ok st)))

; ── names: one name → one live process, retracted by the death transaction ──

(defn named-holder
  "Takes `name`, tells the parent, and parks until told to die."
  [name parent]
  (do
    (rt-register-name name (rt-self))
    (rt-send parent [:named (rt-self)])
    (receive :die :dying (after 5000 :holder-timeout))
    :holder-done))

(defn name-collider
  "Tries to take a name somebody else holds and reports what the register said."
  [name parent]
  (try (do (rt-register-name name (rt-self)) (rt-send parent :collider-won))
       (catch e (rt-send parent [:collider-refused (ex-original e)]))))

(defn name-tests []
  (let [srv (rt-spawn named-holder [:name-srv (rt-self)])
        registered (receive [:named p] p (after 2000 :no-registration))
        first-look (whereis :name-srv)
        _ (rt-spawn name-collider [:name-srv (rt-self)])
        refusal (receive [:collider-refused r] r :collider-won :won (after 2000 :no-answer))
        still (whereis :name-srv)
        listed (rt-registered-names)
        mon (rt-monitor srv)]
    (do
      (rt-send srv :die)
      (let [down (receive [:down _ :process p _] p (after 2000 :no-down))
            retracted (whereis :name-srv)
            reused (do (register :name-srv (rt-self))
                       (let [mine (whereis :name-srv)]
                         (do (unregister :name-srv) mine)))]
        (check-all
          (list
            ["name-registered" first-look registered]
            ["name-unique-refusal" refusal [:name-taken :name-srv]]
            ["name-first-registration-stands" still registered]
            ["name-table-lists-one" [(count listed) (nth listed 0)] [1 :name-srv]]
            ["name-holder-death-observed" down registered]
            ["name-retracted-on-death" retracted nil]
            ["name-absent-answers-nil" (whereis :never-registered) nil]
            ["name-reusable-after-death" reused (rt-self)]
            ["name-released-explicitly" (whereis :name-srv) nil]))))))

; ── the call protocol: refs, overlap, late replies, dead targets ──────────

(defn quick-exit [] :gone)

(defn wait-then-die [parent]
  (do
    (rt-send parent [:child-ready (rt-self)])
    (receive :die :dying (after 5000 :child-timeout))
    :child-done))

(defn call-client
  "One caller: reports the tag WITH the answer, so a crossed reply shows up as
   an answer carrying somebody else's tag."
  [srv tag parent]
  (let [answer (try (rt-call srv tag 2000) (catch e :raised))]
    (rt-send parent [:answer tag answer])))

(defn call-tests
  "Overlapping callers, a forged stale reply, a late reply, and the timeout
   reason. The forged reply is the load-bearing one: it is already in the
   mailbox when the call starts, so a receive that matched by position instead
   of by ref would answer the call with it."
  []
  (let [srv (rt-spawn counter [nil])
        _ (rt-spawn call-client [srv [:ask :a] (rt-self)])
        _ (rt-spawn call-client [srv [:ask :b] (rt-self)])
        a (receive [:answer [:ask :a] v] v (after 2000 :no-a))
        b (receive [:answer [:ask :b] v] v (after 2000 :no-b))
        forged (let [_ (rt-send (rt-self) [:reply [:ref 1 999999] :forged])
                     answer (rt-call srv :echo 2000)
                     left (receive [:reply r v] [r v] (after 0 :none))]
                 [answer left])
        late (let [timed (try (do (rt-call srv [:slow :late] 20) :returned)
                              (catch e :timed-out))
                   nxt (rt-call srv :echo 2000)
                   stale (receive [:reply r v] v (after 500 :none))]
               [timed nxt stale])
        reason (try (do (rt-call srv [:slow :never] 20) :returned)
                    (catch e (if (host/is-tup e) (host/tup-el e 1) :not-an-exit)))
        _ (receive (after 250 :slept))
        drained (loop [n 0]
                  (let [r (receive [:reply _ _] 1 (after 0 :none))]
                    (if (host/eq r :none) n (recur (+ n 1)))))
        stopped (stop srv)]
    (check-all
      (list
        ["overlapping-callers-a" a :a]
        ["overlapping-callers-b" b :b]
        ["stale-reply-not-taken" forged [:echoed [[:ref 1 999999] :forged]]]
        ["call-timeout-caller-survives" (nth late 0) :timed-out]
        ["call-after-timeout-gets-its-own" (nth late 1) :echoed]
        ["late-reply-left-in-mailbox" (nth late 2) :late]
        ["call-timeout-reason" reason [:timeout srv [:slow :never] 20]]
        ["late-replies-drained" drained 1]
        ["call-server-stops" stopped :ok]))))

(defn dead-target-tests []
  (let [p (rt-spawn quick-exit [])
        mon (rt-monitor p)
        dead (receive [:down _ :process _ _] :dead (after 2000 :no-down))
        t0 (host/now)
        pid-call (try (do (rt-call p :x 5000) :returned) (catch e :raised))
        dt (- (host/now) t0)
        name-call (try (do (rt-call :never-registered :x 5000) :returned)
                       (catch e :raised))]
    (check-all
      (list
        ["dead-pid-observed" dead :dead]
        ["call-dead-pid-exits" pid-call :raised]
        ["call-dead-pid-is-immediate" (host/lt dt 1000) true]
        ["call-unheld-name-exits" name-call :raised]))))

(defn crash-client [srv parent]
  (let [t0 (host/now)
        out (try (do (rt-call srv :boom 300) :returned) (catch e :raised))
        dt (- (host/now) t0)]
    (rt-send parent [:crash-call out (not (host/lt dt 250))])))

(defn crash-while-waiting []
  (let [srv (rt-spawn crasher [nil])
        mon (rt-monitor srv)
        _ (rt-spawn crash-client [srv (rt-self)])
        down (receive [:down _ :process _ why] why (after 3000 :no-down))
        out (receive [:crash-call v waited] [v waited] (after 3000 :no-out))]
    (check-all
      (list
        ["server-crash-is-observed" down :crasher-exploded]
        ["call-while-server-dies-times-out" (nth out 0) :raised]
        ["call-waited-its-deadline" (nth out 1) true]))))

; ── cast, info, DOWN and stop through the generic verbs ────────────────

(defn cast-stop-tests []
  (let [srv (rt-spawn counter [nil])
        mon (rt-monitor srv)
        named (register :counter srv)
        before (call srv [:bump 5])
        cast-ok (cast srv [:reset])
        after-reset (call srv [:state])
        _ (rt-send srv :ping)
        seen (:seen (call srv [:state]))
        stop-ok (stop srv)
        down (receive [:down _ :process _ why] why (after 2000 :no-down))]
    (check-all
      (list
        ["register-verb" named true]
        ["call-verb-value" before 0]
        ["cast-verb-answers-ok" cast-ok :ok]
        ["cast-seen-by-next-call" (:n after-reset) 0]
        ["info-verb-delivers" seen [:ping]]
        ["stop-verb-answers-ok" stop-ok :ok]
        ["stop-ends-with-its-reason" down :normal]
        ["stop-retracts-the-name" (whereis :counter) nil]))))

(defn server-side-down-tests []
  (let [srv (rt-spawn counter [nil])
        mon (rt-monitor srv)
        child (rt-spawn wait-then-die [(rt-self)])
        ready (receive [:child-ready p] p (after 2000 :no-child))
        mref (call srv [:watch child])
        _ (rt-send child :die)
        _ (receive (after 60 :slept))
        seen (:seen (call srv [:state]))
        stopped (stop srv)
        down (receive [:down _ :process _ why] why (after 2000 :no-down))]
    (check-all
      (list
        ["watch-verb-returns-a-ref" (rt-ref? mref) true]
        ["server-monitor-records-the-down" seen [:normal]]
        ["down-server-stops" stopped :ok]
        ["down-server-ends-normally" down :normal]))))

; ── the protocol under an adversarial budget, alongside a runnable peer ─────

(defn call-storm [srv n parent]
  (loop [i 0 acc 0]
    (if (< i n)
      (recur (+ i 1) (+ acc (rt-call srv :ping 2000)))
      (rt-send parent [:storm acc]))))

(defn call-fairness []
  (let [srv (rt-spawn ping-srv [nil])
        peer (rt-spawn spin-until-stop [(rt-self)])
        _ (rt-spawn call-storm [srv 5 (rt-self)])
        storm (receive [:storm total] total (after 5000 :no-storm))]
    (do
      (rt-send peer :stop)
      (let [stopped (receive :stopped :stopped (after 2000 :no-stop))
            served (stop srv)]
        (check-all
          (list
            ["calls-progress-under-runnable-peer" storm 10]
            ["peer-stops-after-the-calls" stopped :stopped]
            ["storm-server-stops" served :ok]))))))

; ── the name rules against native BEAM ──────────────────────────────
;
; Four predicates, printed as `NAMES-PARITY <key> <value>`, that a real BEAM
; answers the same way for the same program: a held name resolves, a second
; registration of a held name is REFUSED, a name is gone once its process is,
; and a call that is not answered is BOUNDED (it exits the caller). The SHAPES
; differ and are not claimed equal — BEAM exits with a `{:timeout, {GenServer,
; call, _}}` tuple, this target with a `[:timeout …]` vector — so the
; differential is on the RULE, which is what a portable contract is.

(defn parity-holder [parent]
  (do
    (rt-register-name :parity-srv (rt-self))
    (rt-send parent [:parity-ready (rt-self)])
    (receive :die :dying (after 5000 :parity-holder-timeout))))

(defn parity-silent []
  (receive :die :silent-done (after 5000 :parity-silent-timeout)))

(defn names-parity []
  (let [srv (rt-spawn parity-holder [(rt-self)])
        ready (receive [:parity-ready p] p (after 2000 :no-parity-ready))
        mon (rt-monitor srv)
        live (rt-whereis-name :parity-srv)
        double (try (do (rt-register-name :parity-srv (rt-self)) :accepted)
                    (catch e :refused))
        silent (rt-spawn parity-silent [])
        bounded (try (do (rt-call silent :x 30) :answered) (catch e :bounded))
        _ (rt-send srv :die)
        down (receive [:down _ :process _ _] :down (after 2000 :no-parity-down))
        dead (rt-whereis-name :parity-srv)
        _ (rt-send silent :die)]
    (do
      (host/write (str "NAMES-PARITY whereis-live " (if (nil? live) "nil" "pid")))
      (host/write (str "NAMES-PARITY double-register " double))
      (host/write (str "NAMES-PARITY whereis-dead " (if (nil? dead) "nil" "pid")))
      (host/write (str "NAMES-PARITY call-bounded " (if (host/eq bounded :bounded) "exits" "answered")))
      (check-all
        (list
          ["names-parity-holder" (rt-pid? ready) true]
          ["names-parity-live" (if (nil? live) :nil :pid) :pid]
          ["names-parity-double" double :refused]
          ["names-parity-down" down :down]
          ["names-parity-dead" dead nil]
          ["names-parity-bounded" bounded :bounded])))))

; ── FEAT-051: supervision trees ──────────────────────────────────────────────
;
; A tree is a DECLARATION lowered by compiler.bl — one zero-argument spec
; constructor bound under its declared name — and RAN by runtime.bl's supervisor
; actor. Nothing below reaches into the runtime's internals: a test starts a
; tree, crashes a child, and reads the ledger back, which is exactly what an
; application does. Every wait is a synchronous request, so the suite is
; deterministic at the 17- and 41-step actor budgets too.

; ── the children ─────────────────────────────────────────────────────────────

(defn sup-worker
  "The supervised child the strategy and policy tests crash. An ordinary actor:
   `[:cast :crash]` ends it ABNORMALLY, `[:cast :exit-normal]` returns normally,
   and a `[:stop reason]` ends it with `reason`."
  [tag]
  (receive
    [:cast :crash] (erlang/exit [:worker-crash tag])
    [:cast :exit-normal] :normal
    [:stop reason] (erlang/exit reason)
    [:cast :ping] (sup-worker tag)
    [:call ref from _msg] (do (rt-reply-to from ref [:pong tag]) (sup-worker tag))))

(defn sup-boot-fail
  "A child that fails on its FIRST turn — the startup-failure case."
  [tag]
  (erlang/exit [:boot-failure tag]))

(defn sup-trap-worker
  "A child that TRAPS exits and ignores every exit signal, so only the tree's
   shutdown deadline and its forced kill can end it."
  [tag]
  (do
    (rt-trap-exit! true)
    (sup-trap-loop tag)))

(defn sup-trap-loop [tag]
  (receive
    [:exit _from _reason] (sup-trap-loop tag)
    [:cast :crash] (erlang/exit [:trap-crash tag])
    [:call ref from _msg] (do (rt-reply-to from ref [:alive tag]) (sup-trap-loop tag))))

(defn sup-sink-worker []
  (let [out (try (rt-register-input!) :accepted
                 (catch e (ex-original e)))]
    (rt-send :sup-sink-reporter [:sink-registration out])
    (receive [:stop why] (erlang/exit why)
             (after 2000 :sink-probe-idle))))

; ── the declarations ───────────────────────────────────────────────────────

(proc.super/defsupervisor sup-tree-one-for-one
  (strategy :one-for-one)
  (child :a sup-worker :a)
  (child :b sup-worker :b)
  (child :c sup-worker :c))

(proc.super/defsupervisor sup-tree-rest-for-one
  (strategy :rest-for-one)
  (child :a sup-worker :a)
  (child :b sup-worker :b)
  (child :c sup-worker :c))

(proc.super/defsupervisor sup-tree-one-for-all
  (strategy :one-for-all)
  (child :a sup-worker :a)
  (child :b sup-worker :b)
  (child :c sup-worker :c))

(proc.super/defsupervisor sup-tree-permanent
  (strategy :one-for-one)
  (child :p sup-worker :p))

(proc.super/defsupervisor sup-tree-transient
  (strategy :one-for-one)
  (child :t sup-worker :t {:restart :transient}))

(proc.super/defsupervisor sup-tree-temporary
  (strategy :one-for-one)
  (child :x sup-worker :x {:restart :temporary}))

(proc.super/defsupervisor sup-tree-storm
  (strategy :one-for-one)
  (intensity 2 60000)
  (child :s sup-worker :s))

(proc.super/defsupervisor sup-tree-startup
  (strategy :one-for-one)
  (child :boot sup-boot-fail :boot {:restart :temporary}))

(proc.super/defsupervisor sup-tree-named
  (strategy :one-for-one)
  (child :n sup-worker :n {:name :sup-named-child}))

(proc.super/defsupervisor sup-tree-stop
  (strategy :one-for-one)
  (child :fast sup-worker :fast {:shutdown 80})
  (child :stuck sup-trap-worker :stuck {:shutdown 80}))

(proc.super/defsupervisor sup-tree-brutal
  (strategy :one-for-one)
  (child :stuck sup-trap-worker :stuck {:shutdown :brutal_kill}))

(proc.super/defsupervisor sup-tree-sink
  (strategy :one-for-one)
  (child :sink sup-sink-worker))

(proc.super/defsupervisor sup-tree-options
  (strategy :one-for-all)
  (intensity 5 1000)
  (child :op sup-worker :op {:restart :transient :shutdown 250
                             :type :worker :name :sup-opt-child}))

; ── reading a tree ──────────────────────────────────────────────────────

(defn sup-kid-1 [cs id]
  (cond
    (empty? cs) nil
    (host/eq (:id (first cs)) id) (first cs)
    :else (sup-kid-1 (rest cs) id)))

(defn sup-kid [snap id] (sup-kid-1 (:children snap) id))
(defn sup-kid-pid [snap id] (:pid (sup-kid snap id)))
(defn sup-kid-status [snap id] (:status (sup-kid snap id)))
(defn sup-kid-alive [snap id] (:alive (sup-kid snap id)))
(defn sup-kid-restarts [snap id] (:restarts (sup-kid snap id)))

(defn sup-count-status [children status]
  (cond
    (empty? children) 0
    (host/eq (:status (first children)) status)
      (host/arith "add" 1 (sup-count-status (rest children) status))
    :else (sup-count-status (rest children) status)))

(defn sup-running-count [snap] (sup-count-status (:children snap) :running))

(defn sup-await
  "Poll the tree until `done?` holds for its ledger, at most `n` times, and
   answer that ledger. Each poll is a synchronous request, so the scheduler runs
   the dying child and the supervisor between polls: the wait is driven by the
   TREE's progress, never by where a scheduler slice happens to land."
  [sup done? n]
  (let [s (sup-children sup)]
    (if (host/eq n 0)
      s
      (if (done? s)
        s
        (sup-await sup done? (host/arith "sub" n 1))))))

(defn sup-await-death
  "The ledger once the tree has FINISHED with child `id`'s death: either it
   started a fresh incarnation (the pid differs from `old`) or it decided not to
   and the child is `:stopped`. Nothing here sleeps, and nothing depends on the
   order a death and a request reach the supervisor."
  [sup id old]
  (sup-await sup
             (fn [s]
               (or (not (host/eq (sup-kid-pid s id) old))
                   (host/eq (sup-kid-status s id) :stopped)))
             50))

(defn sup-crash
  "Crash child `id` and answer the ledger once the tree has handled the death."
  [sup id]
  (let [old (sup-kid-pid (sup-children sup) id)]
    (do
      (cast (sup-child sup id) :crash)
      (sup-await-death sup id old))))

; ── strategy ────────────────────────────────────────────────────────────

(defn sup-one-for-one-tests []
  (let [sup (sup-start (sup-tree-one-for-one))
        s0 (sup-children sup)
        a0 (sup-kid-pid s0 :a)
        b0 (sup-kid-pid s0 :b)
        c0 (sup-kid-pid s0 :c)
        s1 (sup-crash sup :b)
        a1 (sup-kid-pid s1 :a)
        b1 (sup-kid-pid s1 :b)
        c1 (sup-kid-pid s1 :c)
        checks (list
                 ["sup-one-for-one-three-running" (sup-running-count s0) 3]
                 ["sup-one-for-one-dead-child-replaced" (host/eq b1 b0) false]
                 ["sup-one-for-one-first-sibling-untouched" (host/eq a1 a0) true]
                 ["sup-one-for-one-last-sibling-untouched" (host/eq c1 c0) true]
                 ["sup-one-for-one-child-ledger-charged" (sup-kid-restarts s1 :b) 1]
                 ["sup-one-for-one-sibling-ledger-clean" (sup-kid-restarts s1 :a) 0]
                 ["sup-one-for-one-three-running-after" (sup-running-count s1) 3]
                 ["sup-one-for-one-window-ledger-charged" (:restarts s1) 1]
                 ["sup-one-for-one-total-ledger-charged" (:restart-total s1) 1])]
    (do
      (stop sup :normal)
      (check-all checks))))

(defn sup-rest-for-one-tests []
  (let [sup (sup-start (sup-tree-rest-for-one))
        s0 (sup-children sup)
        a0 (sup-kid-pid s0 :a)
        b0 (sup-kid-pid s0 :b)
        c0 (sup-kid-pid s0 :c)
        s1 (sup-crash sup :a)
        a1 (sup-kid-pid s1 :a)
        b1 (sup-kid-pid s1 :b)
        c1 (sup-kid-pid s1 :c)
        s2 (sup-crash sup :c)
        a2 (sup-kid-pid s2 :a)
        b2 (sup-kid-pid s2 :b)
        c2 (sup-kid-pid s2 :c)
        checks (list
                 ["sup-rest-for-one-first-restarts-all" (host/eq a1 a0) false]
                 ["sup-rest-for-one-first-reaches-second" (host/eq b1 b0) false]
                 ["sup-rest-for-one-first-reaches-third" (host/eq c1 c0) false]
                 ["sup-rest-for-one-last-leaves-first" (host/eq a2 a1) true]
                 ["sup-rest-for-one-last-leaves-second" (host/eq b2 b1) true]
                 ["sup-rest-for-one-last-restarts-third" (host/eq c2 c1) false])]
    (do
      (stop sup :normal)
      (check-all checks))))

(defn sup-one-for-all-tests []
  (let [sup (sup-start (sup-tree-one-for-all))
        s0 (sup-children sup)
        a0 (sup-kid-pid s0 :a)
        b0 (sup-kid-pid s0 :b)
        c0 (sup-kid-pid s0 :c)
        s1 (sup-crash sup :b)
        a1 (sup-kid-pid s1 :a)
        b1 (sup-kid-pid s1 :b)
        c1 (sup-kid-pid s1 :c)
        checks (list
                 ["sup-one-for-all-dead-restarted" (host/eq b1 b0) false]
                 ["sup-one-for-all-earlier-restarted" (host/eq a1 a0) false]
                 ["sup-one-for-all-later-restarted" (host/eq c1 c0) false]
                 ["sup-one-for-all-all-running" (sup-running-count s1) 3])]
    (do
      (stop sup :normal)
      (check-all checks))))

; ── child policy ────────────────────────────────────────────────────────

(defn sup-policy-tests []
  (let [psup (sup-start (sup-tree-permanent))
        p0 (sup-children psup)
        pp0 (sup-kid-pid p0 :p)
        c1 (cast pp0 :exit-normal)
        p1 (sup-await-death psup :p pp0)
        pp1 (sup-kid-pid p1 :p)
        tsup (sup-start (sup-tree-transient))
        t0 (sup-children tsup)
        tt0 (sup-kid-pid t0 :t)
        s1 (sup-crash tsup :t)
        tt1 (sup-kid-pid s1 :t)
        c2 (cast tt1 :exit-normal)
        t2 (sup-await-death tsup :t tt1)
        tt2 (sup-kid-pid t2 :t)
        tmp (sup-start (sup-tree-temporary))
        x0 (sup-children tmp)
        xx0 (sup-kid-pid x0 :x)
        x1 (sup-crash tmp :x)
        xx1 (sup-kid-pid x1 :x)
        checks (list
                 ["sup-policy-permanent-normal-restarted" (host/eq pp0 pp1) false]
                 ["sup-policy-permanent-normal-running" (sup-kid-status p1 :p) :running]
                 ["sup-policy-transient-crash-restarted" (host/eq tt0 tt1) false]
                 ["sup-policy-transient-normal-kept" (host/eq tt1 tt2) true]
                 ["sup-policy-transient-normal-stopped" (sup-kid-status t2 :t) :stopped]
                 ["sup-policy-temporary-crash-kept" (host/eq xx0 xx1) true]
                 ["sup-policy-temporary-crash-stopped" (sup-kid-status x1 :x) :stopped]
                 ["sup-policy-temporary-crash-dead" (rt-alive? xx1) false])]
    (do
      (stop psup :normal)
      (stop tsup :normal)
      (stop tmp :normal)
      (check-all checks))))

; ── the intensity storm ──────────────────────────────────────────────────

(defn sup-storm-tests []
  (let [sup (sup-start (sup-tree-storm))
        mref (rt-monitor sup)
        s0 (sup-children sup)
        s1 (sup-crash sup :s)
        s2 (sup-crash sup :s)
        c3 (cast (sup-child sup :s) :crash)
        r (receive [:down ref :process _pid reason]
            :when (= ref mref)
            reason
            (after 2000 [:no-escalation]))]
    (check-all
      (list
        ["sup-storm-one-child" (sup-running-count s0) 1]
        ["sup-storm-first-window-charge" (:restarts s1) 1]
        ["sup-storm-second-window-charge" (:restarts s2) 2]
        ["sup-storm-escalation-reason" (first r) :max-restarts-exceeded]
        ["sup-storm-escalation-strategy" (nth r 1) :one-for-one]
        ["sup-storm-escalation-max" (nth r 2) 2]
        ["sup-storm-escalation-window" (nth r 3) 60000]
        ["sup-storm-supervisor-gone" (rt-alive? sup) false]
        ["sup-storm-child-gone" (rt-alive? (sup-kid-pid s2 :s)) false]))))

; ── startup failure and graceful stop ───────────────────────────────────

(defn sup-startup-tests []
  (let [sup (sup-start (sup-tree-startup))
        s1 (sup-await sup
                      (fn [s] (host/eq (sup-kid-status s :boot) :stopped))
                      50)
        checks (list
                 ["sup-startup-child-stopped" (sup-kid-status s1 :boot) :stopped]
                 ["sup-startup-child-no-live-pid" (sup-kid-alive s1 :boot) false]
                 ["sup-startup-supervisor-survives" (rt-alive? sup) true]
                 ["sup-startup-child-set-kept" (count (:children s1)) 1])]
    (do
      (stop sup :normal)
      (check-all checks))))

(defn sup-link-tests []
  (let [sup (sup-start-link (sup-tree-one-for-one))
        mref (rt-monitor sup)
        s0 (sup-children sup)
        a0 (sup-kid-pid s0 :a)
        c1 (stop sup :normal)
        dr (receive [:down ref :process _pid reason]
              :when (= ref mref)
              reason
              (after 2000 [:no-down]))]
    (check-all
      (list
        ["sup-link-linked-tree-starts" (sup-running-count s0) 3]
        ["sup-link-stop-answers-ok" c1 :ok]
        ["sup-link-linked-tree-ends-normally" dr :normal]
        ["sup-link-children-are-stopped" (rt-alive? a0) false]))))

(defn sup-stop-tests []
  (let [sup (sup-start (sup-tree-stop))
        mref (rt-monitor sup)
        s0 (sup-children sup)
        fast0 (sup-kid-pid s0 :fast)
        stuck0 (sup-kid-pid s0 :stuck)
        c1 (stop sup :shutdown)
        dr (receive [:down ref :process _pid reason]
              :when (= ref mref)
              reason
              (after 2000 [:no-down]))]
    (check-all
      (list
        ["sup-stop-reason" dr :shutdown]
        ["sup-stop-ordinary-child-gone" (rt-alive? fast0) false]
        ["sup-stop-trapping-child-killed" (rt-alive? stuck0) false]
        ["sup-stop-supervisor-gone" (rt-alive? sup) false]))))

(defn sup-brutal-tests []
  (let [sup (sup-start (sup-tree-brutal))
        sref (rt-monitor sup)
        kid (sup-child sup :stuck)
        kref (rt-monitor kid)
        _ (stop sup :normal)
        kr (receive [:down r :process _ why] :when (= r kref) why
                    (after 2000 :no-kid-down))
        sr (receive [:down r :process _ why] :when (= r sref) why
                    (after 2000 :no-sup-down))]
    (check-all
      (list
        ["sup-brutal-kills-trapping-child" kr :killed]
        ["sup-brutal-supervisor-normal" sr :normal]
        ["sup-brutal-no-live-child" (rt-alive? kid) false]))))

(defn sup-sink-tests []
  (let [_reg (rt-register-name :sup-sink-reporter (rt-self))
        sup (sup-start (sup-tree-sink))
        sref (rt-monitor sup)
        result (receive [:sink-registration outcome] outcome
                        (after 2000 :no-sink-result))
        sink (:input-sink (host/state))
        _stop (stop sup :normal)
        done (receive [:down r :process _ why] :when (= r sref) why
                      (after 2000 :no-sup-down))
        _unreg (rt-unregister-name :sup-sink-reporter)]
    (check-all
      (list
        ["sup-sink-child-refused-before-input" result :supervised-input-sink-unsupported]
        ["sup-sink-child-did-not-become-sink" sink nil]
        ["sup-sink-tree-stops-normally" done :normal]))))

; ── names and the controlled verbs ──────────────────────────────────────

(defn sup-name-tests []
  (let [sup (sup-start (sup-tree-named))
        mref (rt-monitor sup)
        s0 (sup-children sup)
        n0 (sup-kid-pid s0 :n)
        reg0 (whereis :sup-named-child)
        s1 (sup-crash sup :n)
        n1 (sup-kid-pid s1 :n)
        reg1 (whereis :sup-named-child)
        c1 (stop sup :normal)
        dr (receive [:down ref :process _pid reason]
              :when (= ref mref)
              reason
              (after 2000 [:no-down]))
        reg2 (whereis :sup-named-child)]
    (check-all
      (list
        ["sup-name-resolves-declared" (host/eq reg0 n0) true]
        ["sup-name-reregistered-on-restart" (host/eq reg1 n1) true]
        ["sup-name-new-incarnation" (host/eq reg1 n0) false]
        ["sup-name-stop-normal" dr :normal]
        ["sup-name-retracted-with-child" (host/is-nil reg2) true]))))

(defn sup-verb-tests []
  (let [sup (sup-start (sup-tree-one-for-one))
        s0 (sup-children sup)
        a0 (sup-kid-pid s0 :a)
        b0 (sup-kid-pid s0 :b)
        r1 (sup-restart sup :b)
        s1 (sup-children sup)
        a1 (sup-kid-pid s1 :a)
        b1 (sup-kid-pid s1 :b)
        r2 (sup-terminate sup :c)
        s2 (sup-children sup)
        r3 (sup-restart sup :nope)
        r4 (sup-terminate sup :nope)
        checks (list
                 ["sup-verb-restart-ok" r1 :ok]
                 ["sup-verb-restart-new-incarnation" (host/eq b1 b0) false]
                 ["sup-verb-restart-sibling-untouched" (host/eq a1 a0) true]
                 ["sup-verb-restart-child-ledger" (sup-kid-restarts s1 :b) 1]
                 ["sup-verb-restart-not-window-charged" (:restarts s1) 0]
                 ["sup-verb-restart-total-charged" (:restart-total s1) 1]
                 ["sup-verb-terminate-ok" r2 :ok]
                 ["sup-verb-terminate-stopped" (sup-kid-status s2 :c) :stopped]
                 ["sup-verb-terminate-no-live-pid" (host/is-nil (sup-child sup :c)) true]
                 ["sup-verb-restart-unknown-error" r3 [:error :no-such-child :nope]]
                 ["sup-verb-terminate-unknown-error" r4 [:error :no-such-child :nope]])]
    (do
      (stop sup :normal)
      (check-all checks))))

; ── the lowered spec value ──────────────────────────────────────────────

(defn sup-spec-tests []
  (let [spec (sup-tree-options)
        c (first (:children spec))]
    (check-all
      (list
        ["sup-spec-constructor-is-a-function" (host/is-fn sup-tree-options) true]
        ["sup-spec-strategy" (:strategy spec) :one-for-all]
        ["sup-spec-intensity" (:intensity spec) [5 1000]]
        ["sup-spec-child-order" (:order c) 0]
        ["sup-spec-child-restart" (:restart c) :transient]
        ["sup-spec-child-shutdown" (:shutdown c) 250]
        ["sup-spec-child-name" (:name c) :sup-opt-child]
        ["sup-spec-child-target" (host/eq (:target c) sup-worker) true]
        ["sup-spec-child-args" (:args c) [:op]]))))

(defn run-all []
  (loop [ts (list pure-tests closure-tests case-tests pattern-tests loop-tests
                  recv-basic skip-tests order-tests after0-tests
                  timed-tests fairness-tests dynamic-tests emitter-regressions
                  timer-fairness-regression mailbox-mutation-regression
                  exception-tests suspended-finalizer-tests protected-tail-tests
                  trace-frame-tests
                  name-tests call-tests dead-target-tests crash-while-waiting
                  cast-stop-tests server-side-down-tests call-fairness
                  names-parity
                  table-lifecycle-tests table-heir-tests table-access-tests
                  table-name-tests table-op-tests table-counter-tests
                  table-parity-tests
                  life-normal-death life-abnormal-death life-monitor-race
                  life-linked-failure life-trap-exit life-double-death
                  life-self-kill life-alien-pid
                  life-timer-and-sink-cleanup life-no-stale-state
                  sup-one-for-one-tests sup-rest-for-one-tests sup-one-for-all-tests
                  sup-policy-tests sup-storm-tests sup-startup-tests sup-link-tests
                  sup-stop-tests sup-brutal-tests sup-sink-tests
                  sup-name-tests sup-verb-tests sup-spec-tests)
         fails 0]
    (if (empty? ts)
      fails
      (recur (rest ts) (tally2 fails ((first ts)))))))

(defn sup-parity
  "The supervision RULES the native-BEAM differential compares, re-derived
   from fresh trees. Only the rules are compared — this target's escalation
   reason is a vector, OTP's is `:shutdown` — so the shapes are explicitly not
   claimed equal. verify-supervision.mjs runs OTP itself on the same rules."
  []
  (let [o (sup-start (sup-tree-one-for-one))
        o0 (sup-children o)
        oa0 (sup-kid-pid o0 :a)
        ob0 (sup-kid-pid o0 :b)
        oc0 (sup-kid-pid o0 :c)
        o1 (sup-crash o :b)
        oa1 (sup-kid-pid o1 :a)
        ob1 (sup-kid-pid o1 :b)
        oc1 (sup-kid-pid o1 :c)
        oc (stop o :normal)
        f (sup-start (sup-tree-one-for-all))
        f0 (sup-children f)
        fa0 (sup-kid-pid f0 :a)
        fb0 (sup-kid-pid f0 :b)
        fc0 (sup-kid-pid f0 :c)
        f1 (sup-crash f :b)
        fa1 (sup-kid-pid f1 :a)
        fb1 (sup-kid-pid f1 :b)
        fc1 (sup-kid-pid f1 :c)
        fc (stop f :normal)
        r (sup-start (sup-tree-rest-for-one))
        r0 (sup-children r)
        ra0 (sup-kid-pid r0 :a)
        rb0 (sup-kid-pid r0 :b)
        rc0 (sup-kid-pid r0 :c)
        r1 (sup-crash r :a)
        ra1 (sup-kid-pid r1 :a)
        rb1 (sup-kid-pid r1 :b)
        rc1 (sup-kid-pid r1 :c)
        r2 (sup-crash r :c)
        ra2 (sup-kid-pid r2 :a)
        rb2 (sup-kid-pid r2 :b)
        rc2 (sup-kid-pid r2 :c)
        rc (stop r :normal)
        tr (sup-start (sup-tree-transient))
        t0 (sup-children tr)
        tt0 (sup-kid-pid t0 :t)
        t1 (sup-crash tr :t)
        tt1 (sup-kid-pid t1 :t)
        tc1 (cast tt1 :exit-normal)
        t2 (sup-await-death tr :t tt1)
        tt2 (sup-kid-pid t2 :t)
        tc (stop tr :normal)
        x (sup-start (sup-tree-temporary))
        x0 (sup-children x)
        xx0 (sup-kid-pid x0 :x)
        x1 (sup-crash x :x)
        xx1 (sup-kid-pid x1 :x)
        xc (stop x :normal)
        pr (sup-start (sup-tree-permanent))
        p0 (sup-children pr)
        pp0 (sup-kid-pid p0 :p)
        pc1 (cast pp0 :exit-normal)
        p1 (sup-await-death pr :p pp0)
        pp1 (sup-kid-pid p1 :p)
        pc (stop pr :normal)
        st (sup-start (sup-tree-storm))
        stm (rt-monitor st)
        sc1 (sup-crash st :s)
        sc2 (sup-crash st :s)
        sc3 (cast (sup-child st :s) :crash)
        sr (receive [:down ref :process _pid reason]
              :when (= ref stm)
              reason
              (after 2000 [:no-escalation]))]
    (list
      ["one-for-one-others-stable"
       (and (host/eq oa1 oa0) (host/eq oc1 oc0))]
      ["one-for-one-dead-changed" (not (host/eq ob1 ob0))]
      ["one-for-all-all-changed"
       (and (not (host/eq fa1 fa0)) (not (host/eq fb1 fb0)) (not (host/eq fc1 fc0)))]
      ["rest-for-one-first-all-changed"
       (and (not (host/eq ra1 ra0)) (not (host/eq rb1 rb0)) (not (host/eq rc1 rc0)))]
      ["rest-for-one-last-only-changed"
       (and (host/eq ra2 ra1) (host/eq rb2 rb1) (not (host/eq rc2 rc1)))]
      ["transient-normal-not-restarted" (host/eq tt1 tt2)]
      ["transient-crash-restarted" (not (host/eq tt0 tt1))]
      ["temporary-crash-not-restarted" (host/eq xx0 xx1)]
      ["permanent-normal-restarted" (not (host/eq pp0 pp1))]
      ["max-restarts-escalates" (host/eq (first sr) :max-restarts-exceeded)])))

(defn sup-parity-report
  "Print every tree rule as `SUP-PARITY <key> <value>` for the native-BEAM
   differential, and check it against `true`."
  [pairs fails]
  (if (empty? pairs)
    fails
    (let [p (first pairs)]
      (do
        (host/write (str "SUP-PARITY " (nth p 0) " " (host/describe (nth p 1))))
        (sup-parity-report (rest pairs)
                           (+ fails (check (str "sup-parity-" (nth p 0))
                                           (nth p 1) true)))))))

(defn sup-changed [a b] (not (host/eq a b)))

(defn sup-trace
  "A SELECTED TRACE of the rest-for-one rule: crash the FIRST child, then the
   LAST, and record for each child whether its incarnation CHANGED at that step.
   Two ordered steps, printed as `SUP-TRACE <step> <a> <b> <c>` and diffed
   against OTP's own observation of the same two crashes."
  []
  (let [sup (sup-start (sup-tree-rest-for-one))
        s0 (sup-children sup)
        a0 (sup-kid-pid s0 :a)
        b0 (sup-kid-pid s0 :b)
        c0 (sup-kid-pid s0 :c)
        s1 (sup-crash sup :a)
        a1 (sup-kid-pid s1 :a)
        b1 (sup-kid-pid s1 :b)
        c1 (sup-kid-pid s1 :c)
        s2 (sup-crash sup :c)
        a2 (sup-kid-pid s2 :a)
        b2 (sup-kid-pid s2 :b)
        c2 (sup-kid-pid s2 :c)
        _ (stop sup :normal)]
    (list
      [1 (sup-changed a0 a1) (sup-changed b0 b1) (sup-changed c0 c1)]
      [2 (sup-changed a1 a2) (sup-changed b1 b2) (sup-changed c1 c2)])))

(defn sup-trace-report
  "Print each trace step as `SUP-TRACE <step> <a> <b> <c>` for the native-BEAM
   trace differential."
  [rows]
  (if (empty? rows)
    nil
    (let [r (first rows)]
      (do
        (host/write (str "SUP-TRACE " (nth r 0) " "
                         (if (nth r 1) "changed" "same") " "
                         (if (nth r 2) "changed" "same") " "
                         (if (nth r 3) "changed" "same")))
        (sup-trace-report (rest rows))))))

(defn parity-expected
  "The native-BEAM (OTP 29) reasons for the same cases; verify-lifecycle.mjs
   re-derives them by running BEAM itself, so this table is checked against BEAM
   on every lifecycle run."
  []
  (list
    ["d1-explicit-kill" :killed]
    ["d1-exit1-kill" :kill]
    ["d1-link-exit1-kill-nontrap" :kill]
    ["d1-link-exit1-kill-trap" :kill]
    ["d1-link-explicit-kill-nontrap" :killed]
    ["d2-self-normal" :normal]
    ["d2-self-normal-trap" :normal]
    ["d2-other-normal-nontrap" :survived]
    ["d2-link-normal-nontrap" :survived]
    ["d2-link-normal-trap" :normal]
    ["f2-linked-kill" :killed]))

(defn parity-report
  "Print every reason as `EXIT-PARITY <key> <reason>` for the native-BEAM
   differential, and check it against `expected`."
  [pairs expected fails]
  (if (empty? pairs)
    fails
    (let [pair (first pairs)
          want (nth (first expected) 1)]
      (do
        (host/write (str "EXIT-PARITY " (nth pair 0) " " (host/describe (nth pair 1))))
        (parity-report (rest pairs) (rest expected)
                       (+ fails (check (str "parity-" (nth pair 0))
                                       (nth pair 1) want)))))))

(defn main []
  (let [fails (tally2 (tally2 (run-all)
                             (parity-report (life-exit-parity) (parity-expected) 0))
                      (tally2 (sup-parity-report (sup-parity) 0)
                              (check "bounded-generator-frames"
                                     (host/lt (host/max-frames) 1024) true)))]
    (do
      (sup-trace-report (sup-trace))
      (host/write (str "js-actors: "
                       (if (host/eq fails 0)
                         "ALL PASS"
                         (str fails " FAILURE(S)"))))
      (if (host/eq fails 0) nil (host/raise "acceptance test failures")))))
