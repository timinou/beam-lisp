; quoted-view.bl — the demonstration bundle over the shared quoted-view core.
;
; THE EVALUATOR IS NOT HERE. The closed op grammar, the bounds, the pure
; `qv-render` and the pure `qv-intent-apply` all live in `quoted-view-core.bl`.
; THIS file is only the bundle's application entry — the demonstration harness.
; It builds the view's positive case and every refusal class, runs them, and
; writes the transcript one line per row through `host/write`. Nothing here
; re-implements or forks a rule: every decision the transcript shows is the
; core's, so the transcript stays the core's own answer.
;
; THE BUNDLE IS BUILT FROM THREE SOURCES —
;     runtime.bl + quoted-view-core.bl + quoted-view.bl
; — so the evaluator has ONE definition, shared with the future frontend Worker
; bundle and backend Node bundle, which use the same shape (`runtime + core +
; app`). `compiler.bl`'s `build-one` takes the optional extra source list; a
; bundle that omits it is compiled exactly as before.
;
; The transcript this harness writes is asserted line-for-line by
; `verify-quoted-view.mjs`: one valid rendered view, every view refusal class,
; one accepted intent, and every request refusal class.

; ─────────────────────────────────────────────────────────────────────────────
; 5. The demonstration bundle entry
; ─────────────────────────────────────────────────────────────────────────────

(defn qv-session
  "The demo's server-side session values — the principal, the grant map and the
   version the server believes is current. They live HERE and are passed
   EXPLICITLY into `qv-intent-apply`; nothing in the evaluator reads this."
  [] {:principal :viewer
      :grants {:viewer [:increment]}
      :version 7})

(defn qv-show
  "One labelled line: the label, then the typed result via `host/describe`. The
   result is a BL value (`[:ok …]` / `[:refused …]`), never a string the view
   authored, so the transcript is exactly what the evaluator answered."
  [label result]
  (host/write (host/str-cat label " " (host/describe result))))

(defn qv-deep
  "`n` nested cards around one heading — the excessive-depth probe. `n` = 8 puts
   a card at depth 7, past `qv-max-depth`."
  [n]
  (loop [i 0 acc [:heading {:level 1 :text "deep"}]]
    (if (host/lt i n)
      (recur (inc i) [:card {} acc])
      acc)))

(defn qv-wide
  "A card with `n` text children — the excessive-node probe."
  [n]
  (loop [i 0 acc [:card {:id "wide"}]]
    (if (host/lt i n)
      (recur (inc i) (conj acc [:text "x"]))
      acc)))

(defn qv-pad
  "A string of `n` `x`s — the excessive-text probes' input. Built with
   `host/str-cat` because the ABI has no string fill."
  [n]
  (loop [i 0 acc ""]
    (if (host/lt i n)
      (recur (inc i) (host/str-cat acc "x"))
      acc)))

(defn qv-long-text
  "A card whose three 40-character texts cross the TOTAL-text bound on the third
   child."
  []
  (loop [i 0 acc [:card {:id "long"}]]
    (if (host/lt i 3)
      (recur (inc i) (conj acc [:text (qv-pad 40)]))
      acc)))

(defn qv-view-cases
  "The view's positive case and every refusal class, as `[label result]` rows.
   The valid view exercises nesting (card > heading / field / button), a bounded
   field lookup and a whitelisted intent; each refusal row names one broken rule."
  [env]
  (list
    ["QV-VIEW OK" (qv-render env
                    [:card {:id "main"}
                     [:heading {:level 2 :text "Inbox"}]
                     [:field :unread]
                     [:button {:label "Mark read" :intent [:intent :increment]}]
                     [:text "no new mail"]])]
    ["QV-VIEW REFUSED" (qv-render env [:marquee {:id "x"}])]
    ["QV-VIEW REFUSED" (qv-render env [:field :secret])]
    ["QV-VIEW REFUSED" (qv-render {:title "Inbox" :unread "3"} [:field :owner])]
    ["QV-VIEW REFUSED" (qv-render {:title "Inbox" :unread 3 :owner "ada"}
                                  [:field :unread])]
    ["QV-VIEW REFUSED" (qv-render env [:heading])]
    ["QV-VIEW REFUSED" (qv-render env [:text "a" "b"])]
    ["QV-VIEW REFUSED" (qv-render env [:heading "not-a-map"])]
    ["QV-VIEW REFUSED" (qv-render env [:heading {:level 2 :text "x" :href "/go"}])]
    ["QV-VIEW REFUSED" (qv-render env [:heading {:level 9 :text "x"}])]
    ["QV-VIEW REFUSED" (qv-render env [:button {:label "x" :intent [:intent :delete]}])]
    ["QV-VIEW REFUSED" (qv-render env "just a string")]
    ["QV-VIEW REFUSED" (qv-render env ["card" {:id "x"}])]
    ["QV-VIEW REFUSED" (qv-render env (qv-deep 8))]
    ["QV-VIEW REFUSED" (qv-render env (qv-wide 70))]
    ["QV-VIEW REFUSED" (qv-render env [:text (qv-pad 200)])]
    ["QV-VIEW REFUSED" (qv-render env (qv-long-text))]))

(defn qv-intent-cases
  "The request's positive case and every refusal class. The valid request is the
   ONE data request this view defines, `[:intent :increment]`."
  [s]
  (list
    ["QV-INTENT OK" (qv-intent-apply [:intent :increment]
                                     (:principal s) (:grants s)
                                     (:version s) (:version s))]
    ["QV-INTENT REFUSED" (qv-intent-apply [:intent :delete]
                                          (:principal s) (:grants s)
                                          (:version s) (:version s))]
    ["QV-INTENT REFUSED" (qv-intent-apply [:intent :increment]
                                          :guest (:grants s)
                                          (:version s) (:version s))]
    ["QV-INTENT REFUSED" (qv-intent-apply [:intent :increment]
                                          (:principal s) (:grants s)
                                          (:version s) 6)]
    ["QV-INTENT REFUSED" (qv-intent-apply :increment
                                          (:principal s) (:grants s)
                                          (:version s) (:version s))]
    ["QV-INTENT REFUSED" (qv-intent-apply [:intent]
                                          (:principal s) (:grants s)
                                          (:version s) (:version s))]
    ["QV-INTENT REFUSED" (qv-intent-apply [:cast :increment]
                                          (:principal s) (:grants s)
                                          (:version s) (:version s))]
    ["QV-INTENT REFUSED" (qv-intent-apply [:intent "increment"]
                                          (:principal s) (:grants s)
                                          (:version s) (:version s))]
    ["QV-INTENT REFUSED" (qv-intent-apply [:intent :increment (qv-pad 40)]
                                          (:principal s) (:grants s)
                                          (:version s) (:version s))]
    ["QV-INTENT REFUSED" (qv-intent-apply [:intent :increment]
                                          (:principal s) (:grants s)
                                          (:version s) "7")]
    ["QV-INTENT REFUSED" (qv-intent-apply [:intent :increment]
                                          (:principal s) (:grants s)
                                          9007199254740991 9007199254740991)]))

(defn qv-print-all
  "Print every `[label result]` row, in order, one line each."
  [rows]
  (if (empty? rows)
    nil
    (let [row (first rows)]
      (do
        (qv-show (first row) (nth row 1))
        (qv-print-all (rest rows))))))

(defn main
  "The bundle's application entry. It demonstrates, in the generated bundle: one
   valid rendered view, every view refusal class, one valid accepted intent, and
   every request refusal class. It writes no DOM and reaches no host beyond
   `host/write`."
  []
  (let [env {:title "Inbox" :unread "3" :owner "ada"}
        s (qv-session)]
    (do
      (host/write "quoted-view: data-form view evaluator and intent gate")
      (host/write "quoted-view: no quoted literal, no symbol resolution, no eval, no DOM")
      (qv-print-all (qv-view-cases env))
      (qv-print-all (qv-intent-cases s))
      (host/write "quoted-view: done"))))
