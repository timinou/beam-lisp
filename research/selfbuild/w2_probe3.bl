; research/selfbuild/w2_probe3.bl — the exact shape `read-facts` must destructure.
;
;   mix bl run research/selfbuild/w2_probe3.bl
(ns w2-probe3)

(defn- probe [label f]
  (try
    (println label "→" (f))
    (catch e (println label "✗" (ex-message e)))))

(defn- shapes [label src]
  (probe label
    (fn [] (let [n (first (BeamLisp.Reader/read_string src nil))]
             [(first n) (count n) (second n) (first (second n)) (count (second n))]))))

(shapes "vector node" "[:build/built \"a.bl\" \"k\" [\"M1\" \"M2\"] true]")
(shapes "keyword only" ":build/run")
(shapes "string only" "\"x\"")
(shapes "number" "42")

(probe "nested vector node's second" (fn [] (second (first (second (first (BeamLisp.Reader/read_string "[:a [\"M1\" \"M2\"]]" nil)))))))

(probe "system_time" (fn [] (erlang/system_time :millisecond)))
(probe "unique_integer" (fn [] (erlang/unique_integer (list (list :positive)))))

(probe "vector literal is a vector?" (fn [] [(vector? [:a "b"]) (vector? (list :a "b")) (map? {}) (seq? (list 1))]))
(probe "keyword equality" (fn [] [(= :vector (first [:vector 1])) (= :build/run (first [:build/run 1]))]))
(probe "keyword of a node tag" (fn [] (keyword (first (first (BeamLisp.Reader/read_string "[:a 1]" nil))))))

(probe "building a fact vector then indexing" (fn [] (let [f [:build/built "p" "k" "t" ["M"] true]] [(first f) (second f) (nth f 4) (nth f 5)])))
(probe "mapv over a nested list from a node"
  (fn [] (let [n (first (BeamLisp.Reader/read_string "[\"M1\" \"M2\"]" nil))]
           (mapv (fn [m] (str m)) (second n)))))

(probe "File/write! appends a fact line built by str"
  (fn [] (let [p (Path/join (System/tmp_dir!) "bl_w2_probe3.log")]
           (when (File/exists? p) (File/rm p))
           (File/write! p (str "[:build/built " "\"p\"" " " "\"k\"" " " "[\"M\"]" " " "true" "]\n") (list :append))
           (File/read! p))))
