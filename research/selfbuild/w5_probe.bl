; research/selfbuild/w5_probe.bl — why does `parse-trailer` say nil?
;
;   mix bl run research/selfbuild/w5_probe.bl
(ns w5-probe (:require [drop :as d]))

(def g (second (Base/decode16 "785c0c000000000015db230600000000cbe87a0933e34c2a20ad25e83765a0f6964347d9b6d96d7a25ae7a27d0220c870000010044525031"
                             (list (erlang/list_to_tuple (list :case :mixed))))))

(defn- probe [label f]
  (try (println label "→" (f))
       (catch e (println label "✗" (ex-message e)))))

(probe "count of the golden bytes" (fn [] (count g)))
(probe "drop/magic" (fn [] [(str d/magic) (count d/magic) (string? d/magic)]))
(probe "bytes 52..56" (fn [] (pr-str (binary/part g 52 4))))
(probe "magic = tail4?" (fn [] (= d/magic (binary/part g 52 4))))
(probe "magic literal = tail4?" (fn [] (= "DRP1" (binary/part g 52 4))))
(probe "version bytes" (fn [] (pr-str (binary/part g 50 2))))
(probe "version le" (fn [] (binary/decode_unsigned (binary/part g 50 2) :little)))
(probe "version be" (fn [] (binary/decode_unsigned (binary/part g 50 2) :big)))
(probe "os/arch" (fn [] [(binary/at g 48) (binary/at g 49)]))
(probe "parse" (fn [] (d/parse-trailer g)))
