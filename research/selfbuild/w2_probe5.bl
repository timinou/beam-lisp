; research/selfbuild/w2_probe5.bl — is `lin/param-violations` the same in both trees?
;
;   mix bl run research/selfbuild/w2_probe5.bl
; Run in the W2 worktree AND in the pristine f90293b worktree; the output must
; match, or the toolchain changed what the language decides.
(ns w2-probe5 (:require [system.linear :as lin]))

(def old "(defn- self-apply [self inner-fn]
                 (let [outer-fn (a/fnn (list (a/clause (list (a/pvar self)) nil inner-fn)))]
                   (a/lett self outer-fn inner-fn)))")

(def fixed "(defn- self-apply [self inner-fn]
                   (let [outer-fn (a/fnn (list (a/clause (list (a/pvar self)) nil inner-fn)))]
                     (a/lett self outer-fn (a/app (a/var self) (list (a/var self))))))")

(println "old  violations:" (pr-str (lin/param-violations old)))
(println "fixed violations:" (pr-str (lin/param-violations fixed)))
(println "old  check-source:" (pr-str (lin/check-source old)))
(println "compiler key:" (BeamLisp.AOTCache/compiler_key))
(println "build key:" (try (BeamLisp.AOTCache/build_key) (catch _ "n/a — pre-W1 tree")))
(println "mode:" (if (BeamLisp.AOTCache/enabled?) "aot" "source"))
