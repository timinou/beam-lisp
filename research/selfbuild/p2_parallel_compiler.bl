; research/selfbuild/p2_parallel_compiler.bl — can the drop compile the Elixir
; substrate in-process, with no Mix?
;
; The hypothesis: Elixir's own compiler ships in the payload (it does), so
; `lib/**/*.ex` minus the Mix-task shells and the dev-only server compiles with
; no Mix project, no `_build`, no `MIX_ENV`. If true, `bl release` can build the
; substrate inside the shipped binary.
;
; It runs in the DROP's VM on purpose: the checkout's VM has Mix loaded, so the
; checkout cannot answer the question this probe asks. Invoke it through the
; drop's own CLI:
;
;   BL_TREE=<tree> <drop>/bin/bl eval \
;     'BeamLisp.Ns.Bl.Cli.main(["run","<abs>/p2_parallel_compiler.bl"])'
;
; From this checkout (`BL_TREE=<tree> bin/bl run research/selfbuild/p2_parallel_compiler.bl`)
; it runs too, but reports `mix_loaded=true` and demonstrates nothing about Mix.
;
; Env: BL_TREE = tree to compile (default cwd); BL_W0 = scratch (default /tmp/bl-w0)

(def root (or (System/get_env "BL_TREE") (File/cwd!)))
(def exclude (list "lib/dev" "lib/mix"))
(def out (Path/join (or (System/get_env "BL_W0") "/tmp/bl-w0") "p2-ebin"))

(def files
  (Enum/reject (Path/wildcard (Path/join root "lib/**/*.ex"))
    (fn [f]
      (let [rel (Path/relative_to f root)]
        (Enum/any? exclude (fn [p] (String/starts_with? rel p)))))))

(File/rm_rf! out)
(File/mkdir_p! out)

(println (str "P2  tree=" root))
(println (str "P2  files=" (count files) " out=" out))
(println (str "P2  mix_loaded=" (Code/ensure_loaded? (erlang/binary_to_atom "Elixir.Mix"))
              " parallel_compiler=" (Code/ensure_loaded? (erlang/binary_to_atom "Elixir.Kernel.ParallelCompiler"))))

(Code/compiler_options (list (erlang/list_to_tuple (list :ignore_module_conflict true))))

(def started (System/monotonic_time :millisecond))

; `return_diagnostics: true`: without it the compiler warns, and an error comes
; back as the raw `{file, {line, col}, msg}` tuple the option deprecates.
(def result
  (try
    (Kernel.ParallelCompiler/compile_to_path (Enum/to_list files) out
      (list (erlang/list_to_tuple (list :return_diagnostics true))))
    (catch e (erlang/list_to_tuple (list :raised (str e))))))

(def ms (- (System/monotonic_time :millisecond) started))
(def beams (count (Enum/filter (File/ls! out) (fn [f] (String/ends_with? f ".beam")))))
(def tag (erlang/element 1 result))

(cond
  (= tag :ok)
  (let [mods (erlang/element 2 result) warns (erlang/element 3 result)]
    (println (str "P2  RESULT ok modules=" (count mods) " warnings=" (count warns)
                  " beams=" beams " ms=" ms))
    (println (str "P2  sample: " (pr-str (Enum/take mods 3)))))

  (= tag :error)
  (let [errs (erlang/element 2 result) warns (erlang/element 3 result)]
    (println (str "P2  RESULT error errors=" (count errs) " warnings=" (count warns)
                  " beams=" beams " ms=" ms))
    (if (seq? errs)
      (doseq [e (Enum/take errs 6)]
        (println (str "P2    " (pr-str (erlang/element 1 e)) ": " (pr-str (erlang/element 2 e)))))
      (println (str "P2    " (pr-str errs)))))

  :else
  (println (str "P2  RESULT other=" (pr-str result) " beams=" beams " ms=" ms)))
