; research/selfbuild/gen1.bl — assemble generation 1 with the stock launcher.
; Run: bin/bl run research/selfbuild/gen1.bl
(ns research.selfbuild.gen1
  (:require [release :as release] [drop :as drop]))

(let [tree (or (System/get_env "BL_TREE") "/tmp/beam_lisp_release_tree")
      out (or (System/get_env "BL_OUT") "/tmp/bl-gen1")
      launcher (or (System/get_env "BL_LAUNCHER")
                   "/home/user/.cache/cargo-target/release/drop-launcher")
      assembled (release/assemble (release/value :beam_lisp) tree)]
  (println (str "assemble: ok?=" (:ok? assembled) " apps=" (:apps assembled)
                " errors=" (pr-str (:errors assembled))))
  (when (not (:ok? assembled))
    (erlang/error (str "release assembly failed: " (pr-str (:errors assembled)))))
  (let [packed (drop/pack tree launcher out 0)]
    (println (str "pack:     ok?=" (:ok? packed) " out=" out
                  " offset=" (:offset packed) " len=" (:len packed)))
    (when (not (:ok? packed))
      (erlang/error (str "drop pack failed: " (pr-str (:errors packed)))))
    (let [verified (drop/verify out)]
      (println (str "verify:   ok?=" (:ok? verified)
                    " arithmetic=" (:arithmetic verified)))
      (when (not (:ok? verified))
        (erlang/error (str "drop verification failed: " (pr-str verified))))
      (println (str "gen1:     " (:size (File/stat! out)) " bytes")))))
