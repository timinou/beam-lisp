; research/selfbuild/p1f_trailer_recovery.bl — prove the self-grafting arithmetic
; from INSIDE a running drop.
;
; This is the exact algorithm `bl pack` must implement:
;   drop = launcher ++ payload ++ trailer(56)
;   read the trailer -> offset (== launcher length), len, sha256
;   launcher prefix = bytes [0, offset)
;   verify sha256(payload) == trailer.sha256
;
; It runs in the drop's own VM, so the result is evidence about the SHIPPED
; artifact and not about a dev checkout. Invoke it through the drop's own CLI
; (`run` is the language verb; the drop's `eval` is Elixir and only starts it):
;
;   <drop>/bin/bl eval 'BeamLisp.Ns.Bl.Cli.main(["run","<abs>/p1f_trailer_recovery.bl"])'
;
; From this checkout it also runs, with BL_BIN pointing at a drop file:
;
;   BL_BIN=/path/to/drop bin/bl run research/selfbuild/p1f_trailer_recovery.bl
;
; Env: BL_BIN  — the drop file to parse (required)
;      BL_SELF — optional second drop file to parse for comparison

(def path (or (System/get_env "BL_BIN")
              (erlang/error "BL_BIN not set — launcher predates the change")))
(def data (File/read! path))
(def n (erlang/byte_size data))

(println (str "P1f self=" path))
(println (str "P1f size=" n))

; A binary helps the reader but carries no fields, so the fields are carved out
; of the 56-byte trailer by offset. The LE fields go through
; `binary/decode_unsigned` — a wrong endianness here is a wrong launcher prefix.
(def trailer (binary/part data (- n 56) 56))
(def offset (binary/decode_unsigned (binary/part trailer 0 8) :little))
(def len (binary/decode_unsigned (binary/part trailer 8 8) :little))
(def sha (binary/part trailer 16 32))
(def os (binary/at trailer 48))
(def arch (binary/at trailer 49))
(def ver (binary/decode_unsigned (binary/part trailer 50 2) :little))
(def magic (binary/part trailer 52 4))

(def launcher (binary/part data 0 offset))
(def payload (binary/part data offset len))
(def digest (erlang/apply :crypto :hash (list :sha256 payload)))

(println (str "P1f magic=" magic " version=" ver " os=" os " arch=" arch))
(println (str "P1f offset=" offset " len=" len))
(println (str "P1f arithmetic: offset+len+56=" (+ offset len 56) " == size " (= (+ offset len 56) n)))
(println (str "P1f launcher_bytes=" (erlang/byte_size launcher) " payload_bytes=" (erlang/byte_size payload)))
(println (str "P1f sha256(payload) matches trailer: " (= digest sha)))
(println (str "P1f sha256 hex=" (Base/encode16 digest (list (erlang/list_to_tuple (list :case :lower))))))

; Gzip magic of the payload slice: a drop is launcher ++ GZIP.
(println (str "P1f payload gzip magic: " (pr-str (binary/part payload 0 2))))

; A gzip round-trip sanity check on the same code path `bl pack` will use.
(def slice (binary/part payload 0 4096))
(def gzipped (erlang/apply :zlib :gzip (list slice)))
(println (str "P1f zlib.gzip of a 4 KiB slice -> " (erlang/byte_size gzipped)
              " bytes (deterministic re-gzip: "
              (= (erlang/apply :zlib :gzip (list slice)) gzipped) ")"))

(when (some? (System/get_env "BL_SELF"))
  (let [other (System/get_env "BL_SELF")
        od (File/read! other)
        on (erlang/byte_size od)
        ot (binary/part od (- on 56) 56)
        ooff (binary/decode_unsigned (binary/part ot 0 8) :little)
        olen (binary/decode_unsigned (binary/part ot 8 8) :little)]
    (println (str "P1f other=" other " magic=" (binary/part ot 52 4)
                  " offset=" ooff " len=" olen
                  " consistent=" (= (+ ooff olen 56) on)))))
