; research/selfbuild/w2_probe4.bl — why does `read-facts` come back empty?
;
;   mix bl run research/selfbuild/w2_probe4.bl
; Reads the log a real build just wrote (/tmp/beam_lisp_buildlog_out/build.log)
; and walks `read-facts` one step at a time.
(ns w2-probe4 (:require [build-log :as blog]))

(def p "/tmp/beam_lisp_buildlog_out/build.log")

(defn- probe [label f]
  (try
    (println label "→" (f))
    (catch e (println label "✗" (ex-message e)))))

(probe "exists?" (fn [] (File/exists? p)))
(probe "bytes" (fn [] (count (File/read! p))))
(probe "lines" (fn [] (count (String/split (File/read! p) "\n"))))
(probe "line 1 is a string" (fn [] (let [l (first (String/split (File/read! p) "\n"))]
                                     [(string? l) (count l) (pr-str l)])))
(probe "read_string of line 1" (fn [] (BeamLisp.Reader/read_string (first (String/split (File/read! p) "\n")) nil)))
(probe "forms count" (fn [] (count (BeamLisp.Reader/read_string (first (String/split (File/read! p) "\n")) nil))))
(probe "node" (fn [] (first (BeamLisp.Reader/read_string (first (String/split (File/read! p) "\n")) nil))))
(probe "node is a vector?" (fn [] (vector? (first (BeamLisp.Reader/read_string (first (String/split (File/read! p) "\n")) nil)))))
(probe "node count" (fn [] (count (first (BeamLisp.Reader/read_string (first (String/split (File/read! p) "\n")) nil)))))
(probe "node first" (fn [] (first (first (BeamLisp.Reader/read_string (first (String/split (File/read! p) "\n")) nil)))))
(probe "read-facts count" (fn [] (count (blog/read-facts p))))
(probe "raw keep over lines with a constant" (fn [] (count (keep (fn [l] (when (pos? (count l)) l)) (String/split (File/read! p) "\n")))))
(probe "keep + reader" (fn [] (count (keep (fn [l] (when (pos? (count l)) (first (BeamLisp.Reader/read_string l nil)))) (String/split (File/read! p) "\n")))))
(probe "try/catch value" (fn [] (try (let [x 1] (when (pos? x) x)) (catch _ nil))))
(probe "node->data equivalent inline"
  (fn [] (let [n (first (BeamLisp.Reader/read_string "[:a 1]" nil))]
           (if (and (vector? n) (= :vector (first n)) (= 2 (count n)))
             (mapv (fn [c] c) (second n))
             :nil-branch))))
