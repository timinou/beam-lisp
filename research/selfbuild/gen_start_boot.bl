; research/selfbuild/gen_start_boot.bl — generate `start.script` + `start.boot`
; for a hand-assembled tree.
;
; Runs INSIDE the drop's VM (see p5_handbuilt_release.sh, which calls it). Reads
; the shipped `bl.rel` (the app list is the packaged truth), generates a boot
; script with :systools, then rewrites the lib path to the `$RELEASE_LIB` boot
; variable — which is what the release's `bin/bl` passes as
; `--boot-var RELEASE_LIB <root>/lib`. `make_script` emits `$ROOT/lib/<app>/ebin`
; (measured: no absolute path anywhere), so `$ROOT` is the string to replace;
; `priv/build/release.bl` performs the same rewrite at assemble time.
;
; Standalone invocation (inside a drop):
;
;   BL_PAYLOAD=<drop> BL_OUT=<tree>/releases/<vsn> <drop>/bin/bl eval \
;     'BeamLisp.Ns.Bl.Cli.main(["run","<abs>/gen_start_boot.bl"])'
;
; From this checkout: BL_PAYLOAD=... BL_OUT=... bin/bl run research/selfbuild/gen_start_boot.bl
;
; Env: BL_PAYLOAD = drop root; BL_OUT = tree's releases/<vsn> dir;
;      BL_REL     = the drop's .rel basename (default bl.rel — the mix drop's name;
;                   a post-W4 tree names it beam_lisp.rel). The file is copied
;                   to bl.rel because that is the name :systools is told to read.

(def payload (or (System/get_env "BL_PAYLOAD") (erlang/error "set BL_PAYLOAD")))
(def out (or (System/get_env "BL_OUT") (erlang/error "set BL_OUT")))
(def libdir (Path/join payload "lib"))
(def relname (or (System/get_env "BL_REL") "bl.rel"))
(def relsrc (Path/join (Path/join (Path/join payload "releases") "0.1.0") relname))

(File/mkdir_p! out)
(File/cp! relsrc (Path/join out "bl.rel"))

(def staging (Path/join out ".gen"))
(File/rm_rf! staging)
(File/mkdir_p! staging)
(File/cp! (Path/join out "bl.rel") (Path/join staging "bl.rel"))

(def opts
  (list (erlang/list_to_tuple (list :path (list (String/to_charlist staging) (String/to_charlist libdir))))
        (erlang/list_to_tuple (list :outdir (list (String/to_charlist staging))))
        :silent))

(def r (erlang/apply :systools :make_script (list (String/to_charlist "bl") opts)))

(when (not= :ok (erlang/element 1 r))
  (erlang/error (str "P5a make_script failed: " (pr-str r))))

(println (str "P5a make_script warnings=" (count (erlang/element 3 r))))

; Relocatable paths: replace make_script's lib prefix with the boot variable.
(def text (File/read! (Path/join staging "bl.script")))
(def rewritten (String/replace text "$ROOT/lib" "$RELEASE_LIB"))
(def did-rewrite (not= rewritten text))
(File/write! (Path/join out "start.script") rewritten)

(def boot (erlang/apply :systools :script2boot (list (String/to_charlist (Path/join out "start")))))
(when (not= :ok boot)
  (println (str "P5a script2boot=" (pr-str boot))))

(println (str "P5a rewritten=" did-rewrite
              " start.script=" (:size (File/stat! (Path/join out "start.script")))
              " start.boot=" (:size (File/stat! (Path/join out "start.boot")))))
(println (str "P5a sample: "
              (pr-str (first (Enum/filter (String/split rewritten "\n")
                                          (fn [l] (String/contains? l "RELEASE_LIB")))))))
(File/rm_rf! staging)
