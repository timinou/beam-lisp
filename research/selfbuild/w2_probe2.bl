; research/selfbuild/w2_probe2.bl — the exact primitives `build-log` will use.
;
;   mix bl run research/selfbuild/w2_probe2.bl
;
; Round 1 established: append works, the reader round-trips a fact line, the
; reader returns NODES (strings inside are already binaries), `pr-str` does NOT
; quote strings, and `erlang/<name>` is `:erlang.<name>` only.
(ns w2-probe2)

(defn- probe [label f]
  (try
    (println label "→" (f))
    (catch e (println label "✗" (ex-message e)))))

(probe "join" (fn [] (join " " ["a" "b" "c"])))
(probe "String/join over a vector" (fn [] (String/join ["a" "b"] " ")))
(probe "keyword?" (fn [] (keyword? :build/run)))
(probe "keyword of a string" (fn [] (keyword "build/run")))
(probe "str of a keyword" (fn [] (str :build/run)))
(probe "String/replace" (fn [] (String/replace "a\"b\\c" "\"" "'")))
(probe "seq->vector" (fn [] (vec (map (fn [x] (str x)) ["a" "b"]))))
(probe "count of a lazy seq" (fn [] (count (map (fn [x] (str x)) ["a" "b"]))))
(probe "mapv" (fn [] (mapv (fn [x] (str x)) ["a" "b"])))
(probe "nth" (fn [] (nth [10 20 30] 1)))
(probe "first of a keyword" (fn [] (first [:build/run "x"])))
(probe "cond + numbers" (fn [] (cond (string? "a") "str" (number? 3) "num" :else "other")))
(probe "true?/false?" (fn [] [(true? true) (false? false)]))
(probe "nil?" (fn [] (nil? nil)))
(probe "assoc on a nested map" (fn [] (assoc {"" {:a 1}} "" {:a 2})))
(probe "into {}" (fn [] (into {} (map (fn [p] [p (count p)]) ["a" "bb"]))))
(probe "keys of a map" (fn [] (keys {"a" 1 "b" 2})))
(probe "set/contains?" (fn [] (contains? (set ["a" "b"]) "a")))
(probe "every?/some" (fn [] [(every? (fn [x] (pos? x)) [1 2]) (some (fn [x] (= x 2)) [1 2])]))
(probe "get-in with default" (fn [] (get-in {"a" {"b" 1}} ["a" "c"] :none)))
(probe "update" (fn [] (update {"a" 1} "a" (fn [v] (inc v)))))
(probe "dissoc" (fn [] (dissoc {"a" 1 "b" 2} "a")))
(probe "sort" (fn [] (sort ["b" "a" "c"])))
(probe "reduce over map entries" (fn [] (reduce (fn [acc p] (conj acc (str (first p) "=" (second p)))) [] {"a" 1})))
(probe "merge" (fn [] (merge {"a" 1} {"b" 2})))
(probe "erlang binary_to_atom" (fn [] (erlang/binary_to_atom "Elixir.BeamLisp.Ns.Build")))
(probe "erlang binary_to_existing_atom of a real module"
  (fn [] (erlang/binary_to_existing_atom (erlang/atom_to_binary BeamLisp.AOT) :utf8)))
(probe "File/open + write + close"
  (fn [] (let [p (Path/join (System/tmp_dir!) "bl_w2_probe2.txt")
               {:ok fd} (File/open p (list (list :write)))]
           (File/write fd "hello")
           (File/close fd)
           (File/read! p))))
(probe "String/trim + split on a trailing newline"
  (fn [] (String/split "a\nb\n" "\n")))
(probe "map over a map (entries)" (fn [] (map (fn [p] (first p)) {"a" 1 "b" 2})))
(probe "filter a vector gives a seq" (fn [] (filter (fn [x] (pos? x)) [1 -1 2])))
(probe "(pr-str of a keyword)" (fn [] (pr-str :build/run)))
(probe "read a moved file's ns header via source-graph"
  (fn [] (source-graph/header (File/read! "priv/build/build.bl"))))
(probe "re-find symbols in a header" (fn [] (source-graph/header (File/read! "priv/build/build.bl"))))
