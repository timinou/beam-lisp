; research/selfbuild/w3_probe.bl — the mechanisms `build/substrate` needs.
;
;   mix bl run research/selfbuild/w3_probe.bl
;
; 1. can the language drive Kernel.ParallelCompiler, and what does it return?
; 2. can every compiled module be attributed back to its SOURCE FILE? (the
;    stage records a fact PER FILE, so an unattributed batch would have to
;    recompile all of `lib/` on any edit)
; 3. does a second compile of the same files work under ignore_module_conflict?
(ns w3-probe)

(def tmp (Path/join (System/tmp_dir!) "w3_probe"))
(def out (Path/join tmp "ebin"))

(defn- probe [label f]
  (try
    (println label "→" (f))
    (catch e (println label "✗" (ex-message e)))))

(File/rm_rf! tmp)
(File/mkdir_p! out)

(def one (Path/join tmp "one.ex"))
(def two (Path/join tmp "two.ex"))
(File/write! one "(defmodule W3.One do\n  def v, do: :one\nend)\n")
(File/write! two "(defmodule W3.Two do\n  def v, do: W3.One.v()\nend)\n")

(probe "ignore_module_conflict settable"
  (fn [] (Code/compiler_options (list (erlang/list_to_tuple (list :ignore_module_conflict true))))))

(probe "compile_to_path over two files (two.ex uses one.ex)"
  (fn [] (let [r (Kernel.ParallelCompiler/compile_to_path (list one two) out)]
           {:tag (erlang/element 1 r)
            :mods (vec (map (fn [m] (str m)) (erlang/element 2 r)))
            :warns (count (erlang/element 3 r))})))

(probe "beams written" (fn [] (vec (sort (File/ls! out)))))

; The attribution: every compiled module answers `module_info(:compile)` with a
; `:source` entry naming the file it came from.
(defn- source-of [m]
  (let [info (erlang/apply m :module_info (list :compile))]
    (second (first (filter (fn [e] (= :source (first e))) info)))))

(probe "attribution by module"
  (fn [] (map (fn [m] [(str m) (source-of m)])
              (erlang/element 2 (Kernel.ParallelCompiler/compile_to_path (list one two) out)))))

(probe "recompile is clean and byte-identical"
  (fn [] (let [before (map (fn [f] [f (sha256-hex (File/read! (Path/join out f)))]) (File/ls! out))
               r (Kernel.ParallelCompiler/compile_to_path (list one two) out)]
           {:tag (erlang/element 1 r)
            :same (every? (fn [p] (= (second p) (sha256-hex (File/read! (Path/join out (first p)))))) before)})))

(probe "an error names the file and does not crash the VM"
  (fn [] (let [bad (Path/join tmp "bad.ex")]
           (File/write! bad "(defmodule W3.Bad do\n  def v, do: (\nend)\n")
           (let [r (Kernel.ParallelCompiler/compile_to_path (list bad) out)]
             {:tag (erlang/element 1 r)
              :errs (vec (map (fn [e] [(first e) (count (str (erlang/element 3 e)))]) (erlang/element 2 r)))}))))
