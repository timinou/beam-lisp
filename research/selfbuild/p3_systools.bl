; research/selfbuild/p3_systools.bl — can a hand-assembled release's boot scripts
; come from :systools?
;
; Runs INSIDE the drop's VM. Takes the SHIPPED release's own `bl.rel` and
; regenerates `bl.script` + `bl.boot` from it with `:systools`, using only the
; payload's `lib/` as the app path. Everything except the boot scripts is held
; constant, so a pass isolates the one uncertain piece of release assembly.
;
;   BL_PAYLOAD=<payload> <drop>/bin/bl eval \
;     'BeamLisp.Ns.Bl.Cli.main(["run","<abs>/p3_systools.bl"])'
;
; From this checkout it also runs (BL_PAYLOAD=<payload> bin/bl run research/selfbuild/p3_systools.bl);
; sasl ships with OTP, so `:systools` resolves either way.
;
; Env: BL_PAYLOAD = extracted drop root (required); BL_W0 = scratch (default /tmp/bl-w0);
;      BL_REL     = the release's .rel basename (default bl.rel — the mix drop's name;
;                   a post-W4 tree names it beam_lisp.rel)

(def payload (or (System/get_env "BL_PAYLOAD") (erlang/error "set BL_PAYLOAD")))
(def scratch (Path/join (or (System/get_env "BL_W0") "/tmp/bl-w0") "p3"))
(def libdir (Path/join payload "lib"))
(def relname (or (System/get_env "BL_REL") "bl.rel"))
(def relsrc (Path/join (Path/join (Path/join payload "releases") "0.1.0") relname))

(File/rm_rf! scratch)
(File/mkdir_p! scratch)
; Copied as `bl.rel` whatever its source name: that is the file :systools is told
; to read ("bl" below), and only its CONTENT — the release term — is read.
(File/cp! relsrc (Path/join scratch "bl.rel"))

(println (str "P3  payload=" payload))
(println (str "P3  rel=" relsrc " exists=" (File/exists? relsrc)))
(println (str "P3  systools=" (pr-str (erlang/apply :code :which (list :systools)))))

; systools reads Name.rel from the code path (or `path`) and writes Name.script
; to `outdir`. Names and paths cross to Erlang as CHARLISTS.
(def opts
  (list (erlang/list_to_tuple (list :path (list (String/to_charlist scratch) (String/to_charlist libdir))))
        (erlang/list_to_tuple (list :outdir (list (String/to_charlist scratch))))
        :silent))

(def result
  (try
    (erlang/apply :systools :make_script (list (String/to_charlist "bl") opts))
    (catch e (erlang/list_to_tuple (list :raised (str e))))))

(def tag (erlang/element 1 result))

(cond
  (= tag :ok)
  (let [warns (erlang/element 3 result)]
    (println (str "P3  make_script ok warnings=" (count warns)))
    (doseq [w (Enum/take warns 5)] (println (str "P3    warn " (pr-str w)))))

  (= tag :error)
  ; OTP's error arm is `{error, Module, Error}` with `Error` a TERM, not always a
  ; list: `{:undefined_applications, [:x509]}` is one error, and a bare
  ; `(count errs)` would call it two. Report the list elementwise when it is one.
  (let [errs (erlang/element 3 result)]
    (if (seq? errs)
      (do (println (str "P3  make_script ERROR n=" (count errs)))
          (doseq [e (Enum/take errs 8)] (println (str "P3    err " (pr-str e)))))
      (println (str "P3  make_script ERROR " (pr-str errs)))))

  :else
  (println (str "P3  make_script other=" (pr-str result))))

(def script (Path/join scratch "bl.script"))
(println (str "P3  script=" script " exists=" (File/exists? script)
              " bytes=" (if (File/exists? script) (:size (File/stat! script)) 0)))
(println (str "P3  after make_script dir=" (pr-str (File/ls! scratch))))

; OTP appends ".script": pass the stem, not the filename.
(def boot-result
  (if (File/exists? script)
    (try
      (erlang/apply :systools :script2boot (list (String/to_charlist (Path/rootname script))))
      (catch e (erlang/list_to_tuple (list :raised (str e)))))
    :skipped))

(def boot (Path/join scratch "bl.boot"))
(println (str "P3  script2boot=" (pr-str boot-result) " boot_exists=" (File/exists? boot)
              " boot_bytes=" (if (File/exists? boot) (:size (File/stat! boot)) 0)))

; Compare against the shipped boot script, if both exist.
(def shipped (Path/join (Path/join (Path/join payload "releases") "0.1.0") "start.boot"))
(when (and (File/exists? boot) (File/exists? shipped))
  (println (str "P3  shipped start.boot bytes=" (erlang/byte_size (File/read! shipped))
                " identical=" (= (File/read! boot) (File/read! shipped)))))
