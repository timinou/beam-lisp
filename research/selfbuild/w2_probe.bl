; research/selfbuild/w2_probe.bl — the surface a build FACT LOG needs.
;
;   mix bl run research/selfbuild/w2_probe.bl
;
; Every question is answered by running it, and every one is guarded so a single
; unknown name does not hide the rest. The log format is chosen from what works
; here, not from what the docs claim.
(ns w2-probe (:require [build-plan :as plan]))

(def tmp (Path/join (System/tmp_dir!) "bl_w2_probe"))
(def log-path (Path/join tmp "build.log"))

(File/mkdir_p! tmp)
(when (File/exists? log-path) (File/rm log-path))

(defn- probe [label f]
  (try
    (println label "→" (f))
    (catch e (println label "✗" (ex-message e)))))

(probe "1 namespaced keyword" (fn [] (str :build/run)))

(probe "2a append (list :append)"
  (fn [] (File/write! log-path "[:build/built \"a.bl\" \"hash\"]\n" (list :append))))
(probe "2b append again"
  (fn [] (File/write! log-path "[:build/failed \"b.bl\" \"boom\"]\n" (list :append))))
(probe "2c the file now holds" (fn [] (pr-str (File/read! log-path))))

(probe "3a reader on one line"
  (fn [] (BeamLisp.Reader/read_string "[:build/built \"a.bl\" \"hash\"]" nil)))
(probe "3b String/split"
  (fn [] (String/split (File/read! log-path) "\n")))
(probe "3c read every line"
  (fn [] (map (fn [l] (first (BeamLisp.Reader/read_string l nil)))
              (filter (fn [l] (pos? (count l))) (String/split (File/read! log-path) "\n")))))

(probe "4 module name through text"
  (fn [] (erlang/binary_to_atom (erlang/atom_to_binary BeamLisp.Ns.Build))))

(probe "5 plan :deps direction"
  (fn [] (let [src (BeamLisp.Loader/read_source "priv/boot/sugar.bl")
               n (plan/node-from "priv/boot/sugar.bl" src)
               p (plan/plan (list n))]
           {:deps (:deps p) :key (:key p)})))

(probe "6 hand-built fact line"
  (fn [] (str "[:build/built " (pr-str "priv/std/errors.bl") " "
              (pr-str ["BeamLisp.Ns.Body.Errors"]) "]")))

(probe "7 pr-str escapes"
  (fn [] (pr-str "a \"quoted\" \\ path")))

(probe "8 rename is atomic (tmp+rename)"
  (fn [] (let [t (str log-path ".tmp")]
           (File/write! t "x")
           (File/rename! t (Path/join tmp "renamed.txt"))
           (File/read! (Path/join tmp "renamed.txt")))))

(probe "9 erlang/file open+append"
  (fn [] (let [fd (erlang/element 2 (erlang/file/open log-path (list (list :append))))]
           (erlang/file/write fd "[:build/run 1 2]\n")
           (erlang/file/close fd)
           (count (String/split (File/read! log-path) "\n")))))

(probe "10 mtime of a file"
  (fn [] (first (erlang/element 2 (erlang/file/read_file_info log-path)))))

(println "=== log ===")
(println (File/read! log-path))
