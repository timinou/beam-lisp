; research/p4_multimethods/run.bl — P4 driver: extension invalidation,
; demonstrated end to end.

(ns p4run
  (:require [multis]))

(reset! multis/method-table {})
(reset! typed/warnings [])

; ── world v1: a multi with two int-returning methods ──────────────────
(def v1-src
  "(defmulti area :shape)
   (defmethod area :circle [s] 314)
   (defmethod area :rect [s] 12)")

; the consumer: shout is declared string-taking (annotated, runs below)

(def consumer-src
  "(def consumer (shout (area {:shape :circle})))")

; shout runs for real so its ^ meta reaches the checker via the pipe
(defn ^{:args [string] :ret string} shout [s] (str s "!"))

(println "── P4: open-world invalidation ──")

(def r1 (multis/check-source v1-src "p4run"))
(def r1c (multis/check-source consumer-src "p4run"))
(println (str "v1 fingerprint entries: " (count (:fingerprint r1c))))
(println (str "v1 consumer warnings: " (count (:warnings r1c))))
(doall (map (fn [w] (println (str "  ✗ " (:line w) ":" (:col w) " " (:msg w))))
            (:warnings r1c)))

; ── extension: a string-returning :default method arrives ─────────────
(def ext-src "(defmethod area :default [s] \"n/a\")")
(multis/check-source ext-src "p4run")

(reset! typed/warnings [])
(def r2c (multis/check-source consumer-src "p4run"))
(println (str "v2 fingerprint entries: " (count (:fingerprint r2c))))
(println (str "v2 consumer warnings: " (count (:warnings r2c))))

; ── the rule, asserted ────────────────────────────────────────────────
; v1: area's ret is #{:int}, shout wants string → warning (sound IN v1).
; v2: extension widens ret to int|string → the v1 warning is REVOKED.
; ∴ a warning that consumes a multi's ret is only valid at the
;   method-set fingerprint it was computed under.
(println (str (if (and (= 1 (count (:warnings r1c)))
                       (= 0 (count (:warnings r2c)))
                       (< (count (:fingerprint r1c))
                          (count (:fingerprint r2c))))
                "PASS" "FAIL")
              ": extension revoked the warning; fingerprint grew"))
