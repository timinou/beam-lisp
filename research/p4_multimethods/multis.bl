; research/p4_multimethods/multis.bl — P4: multimethods, sealed vs open.
;
; The question: what does EXTENSION invalidate? A defmulti's call-site
; return type is the union of its methods' returns — over the methods
; KNOWN at check time. A defmethod arriving later widens the union, and
; a warning that depended on the old union can become unsound. This
; spike demonstrates that concretely and derives the rule:
;
;   a check that consumes a multi's return is valid only at the
;   method-set fingerprint it was computed under; adding a method
;   invalidates every dependent check.
;
; The spike keeps its own method table {multi-name → {dispatch-val →
; ret-tagset}}, built by walking defmulti/defmethod forms, and injects
; per-multi sigs into typed/walk. Method bodies are walked with params
; at any (defmethod has no annotation surface today — noted for the
; plan). Runtime truth (methods added dynamically, hot reload) needs a
; Multi method-table reader — implementation-plan item, P7 neighbor.

(ns multis
  (:require [typed]))

; shims for the typed vars this spike uses unqualified
(def any typed/any)
(def never typed/never)
(def t-union typed/t-union)
(def core-sigs typed/core-sigs)
(def sigs-from-env typed/sigs-from-env)

(def method-table (atom {}))

(defn table-fingerprint [t]
  ; the set of (multi, val) pairs IS the fingerprint — extension grows it
  (apply concat
         (map (fn [[m entries]] (map (fn [[v _]] [m v]) entries)) t)))

(defn multi-ret
  "A multi's call-site return: the union of every KNOWN method's ret,
   or any when the method set is empty (unknown → silent)."
  [name]
  (let [entries (get (deref method-table) name {})]
    (if (empty? entries)
      any
      (reduce (fn [acc [_ r]] (t-union acc r)) never entries))))

(defn walk-multi-def
  "Walk a defmulti/defmethod form, updating the table. Returns the
   multi sig to inject, or nil."
  [sigs form]
  (let [f     (typed/node-form form)
        items (typed/node-items f)
        head  (typed/node-name (typed/node-form (first items)))
        name  (typed/node-name (typed/node-form (second items)))]
    (cond
      (= head "defmulti")
        (do (swap! method-table
                   (fn [t] (if (contains? t name) t (assoc t name {}))))
            nil)

      (= head "defmethod")
        (let [val    (nth items 2)
              params (typed/node-items (typed/node-form (nth items 3)))
              body   (rest (rest (rest (rest items))))
              env    (reduce (fn [e p] (typed/bind-pattern e p any))
                             {} params)
              ret    (reduce (fn [_ b] (typed/walk sigs env b))
                             never body)
              valkey (pr-str val)]
          (swap! method-table
                 (fn [t]
                   (assoc t name
                          (assoc (get t name {}) valkey ret))))
          {:args [any] :ret (multi-ret name)})

      :else nil)))

(defn multi-sigs []
  (reduce (fn [acc [name _]]
            (assoc acc name {:args [any] :ret (multi-ret name)}))
          {} (deref method-table)))

(defn check-source
  "Like typed/check-source, but defmulti/defmethod forms feed the
   method table and calls to multis see the union-of-methods ret.
   NOT position-recording (typed/check-source owns that); this spike
   answers the invalidation question only."
  [src ns]
  (let [forms (if (string? src) (BeamLisp.Reader/read_string src) src)
        base  (merge core-sigs (sigs-from-env ns))]
    (doall
      (map (fn [form]
             (let [f (typed/node-form form)
                   is-multi (and (= :list (typed/node-tag f))
                                 (contains? #{"defmulti" "defmethod"}
                                   (typed/node-name
                                     (typed/node-form
                                       (first (typed/node-items f))))))]
               (if is-multi
                 (walk-multi-def (merge base (multi-sigs)) form)
                 (typed/walk (merge base (multi-sigs)) {} form))))
           forms))
    {:warnings (deref typed/warnings)
     :fingerprint (table-fingerprint (deref method-table))}))
