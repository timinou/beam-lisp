; research/p10_scale/run.bl — P10: scale. Check the whole datom closure
; cold; then the cache-hit shape (content-hash skip → ~0).

(ns p10run
  (:require [typed]))

(def bl-files
  (sort (into [] (Path/wildcard "priv/lib/datom/**/*.bl"))))

(println (str "── P10: checking the datom closure (" (count bl-files) " files) ──"))

(defn check-one [path]
  (reset! typed/warnings [])
  (reset! typed/evidence {})
  (let [src (second (File/read path))
        t0  (erlang/monotonic_time :millisecond)
        r   (typed/check-source-with src "datom" (merge typed/core-seeds-v2 typed/host-seeds))
        t1  (erlang/monotonic_time :millisecond)]
    {:path path :ms (- t1 t0) :warnings (count (:warnings r))
     :evidence (count (:evidence r))}))

; ── cold ──────────────────────────────────────────────────────────────
(def t0 (erlang/monotonic_time :millisecond))
(def results (into [] (map check-one bl-files)))
(def t1 (erlang/monotonic_time :millisecond))

(doall (map (fn [r] (println (str "  " (:ms r) " ms  " (:warnings r) "w  "
                                  (:evidence r) "ev  " (:path r))))
            results))
(println (str "TOTAL cold: " (- t1 t0) " ms, "
              (reduce (fn [a r] (+ a (:warnings r))) 0 results) " warnings, "
              (reduce (fn [a r] (+ a (:evidence r))) 0 results) " evidence entries"))

; ── cache-hit shape: content-hash skip (L8: the cache stores ANALYSIS;
;   unchanged file ⇒ reuse, zero re-walk) ──────────────────────────────
(def cache (atom {}))
(defn check-cached [path]
  (let [src (second (File/read path))
        h   (erlang/phash2 src)]
    (if (contains? (deref cache) h)
      :hit
      (do (swap! cache (fn [c] (assoc c h true)))
          (check-one path)
          :miss))))

(doall (map check-cached bl-files))   ; prime
(def t2 (erlang/monotonic_time :millisecond))
(def hits (into [] (map check-cached bl-files)))
(def t3 (erlang/monotonic_time :millisecond))
(println (str "warm (all cache hits): " (- t3 t2) " ms, "
              (count (filter (fn [x] (= x :hit)) hits)) " hits"))

(println (str (if (and (< (- t1 t0) 5000)
                       (< (- t3 t2) 100))
                "PASS" "FAIL")
              ": closure checked cold, cache-hit ~0"))
