(ns play.deepseek-smoke
  (:require [dev.workspace :as ws]
            [play.gen :as gen]
            [play.fixture :as fixture]))

(defn- check! [yes message]
  (when-not yes (throw (ex-info message {})))
  (println (str "  ✓ " message)))

(defn- prove! [w x]
  (let [result (gen/await! x 100000)]
    (check! (= :ready (:status result))
            (str "Provider candidate verifies" (when (:error result) (str ": " (:error result)))))
    (let [p (gen/proposal x) preview (ws/preview p)]
      (check! (= #{"src/app/invoices.bl" "src/billing/rules.bl"}
                 (set (map :path (:changes preview))))
              "Only the intended namespace and caller are proposed")
      (gen/accept! x)
      (ws/make-live! p)
      (check! (= "1250" (ws/eval! w "(app.invoices/total {:subtotal-cents 1000 :late-fee-cents 250})"))
              "The generated namespace is useful through the existing caller")
      (check! (= "true" (ws/eval! w "(= \"Invoice 7\" (app.invoices/label {:number 7}))"))
              "The unrelated definition is preserved")
      (println (str "Workspace: " (:root w)))
      (println (str "Experience: " (:id x)))
      (println (str "Lifecycle: " (pr-str (ws/status p))))
      {:root (:root w) :experience (:id x) :status (ws/status p)})))

(defn run [args]
  (if (= "--saved" (first args))
    (let [w (ws/attach! (second args))]
      (try
        (println "Replaying the saved provider proposal · no network request")
        (let [x (first (filter (fn [h] (= :deepseek (:provider (ws/snapshot h))))
                              (gen/restore! w "src/playground.bl")))]
          (when-not x (throw (ex-info "No saved DeepSeek experience in this workspace." {})))
          (prove! w x))
        (finally (ws/shutdown! w))))
    (let [env-path (or (first args) ".env")]
      (check! (gen/load-key! env-path) "Provider credential loaded (value withheld)")
      (let [w (ws/attach! (fixture/fresh!))]
        (try
          (println "One bounded DeepSeek request · 2400 output tokens maximum · no automatic repair")
          (let [x (gen/ns w "src/playground.bl"
                          "Introduce billing.rules/total to add integer subtotal and late-fee cents. Wire app.invoices/total to it and preserve label."
                          {:provider :deepseek :max-repairs 0 :ns 'billing.rules})]
            (gen/await! x 100000)
            (check! (nil? (:saved (ws/status (gen/proposal x)))) "Generation did not save source")
            (prove! w x))
          (finally (ws/shutdown! w)))))))
