(ns play.fixture)

(def files
  {"src/playground.bl"
   "; Your generation notebook owns .playground.cache.bl.\n(ns playground)\n\n; In the playground REPL:\n; (gen/ns \"Include late fees in invoice totals\")\n"
   "src/app/invoices.bl"
   "; Invoice amounts are integer cents. Keep this comment when editing total.\n(ns app.invoices)\n\n(defn total\n  \"The invoice subtotal, before we teach it about late fees.\"\n  [invoice]\n  (:subtotal-cents invoice))\n\n(defn label [invoice]\n  (str \"Invoice \" (:number invoice)))\n"})

(defn create!
  "Create a fresh disposable fixture. Never overwrite existing project files."
  [root]
  (let [root (Path/expand root)]
    (when (File/exists? root)
      (throw (ex-info "Choose a new directory for the sample; an existing directory is never reset." {:root root})))
    (doseq [[path source] files]
      (let [full (Path/join root path)]
        (File/mkdir_p! (Path/dirname full))
        (File/write! full source)))
    (File/write! (Path/join root "env.bl") "{:paths [\"src\"]}\n")
    root))

(defn fresh!
  "A unique sample directory under the OS temp directory."
  []
  (create! (Path/join (System/tmp_dir!)
                      (str "bl-api-playground-" (erlang/unique_integer (list :positive))
                           "-" (erlang/system_time :millisecond)))))
