(ns play.server
  (:require [dev.workspace :as ws]
            [play.gen :as gen]
            [play.fixture :as fixture]
            [play.ui :as ui]
            [web]
            [vm.session :as session]
            [vm.http :as http]
            [vm.paths :as paths]))

(defn- options [args]
  (loop [args (seq args) opts {:port 7871}]
    (if (nil? args)
      opts
      (let [flag (first args) value (second args)]
        (when (nil? value)
          (throw (ex-info "Flags need values: --port N --root DIR --deepseek-env FILE" {})))
        (recur (seq (drop 2 args))
               (case flag
                 "--port" (assoc opts :port (String/to_integer value))
                 "--root" (assoc opts :root (Path/expand value))
                 "--deepseek-env" (assoc opts :env (Path/expand value))
                 (throw (ex-info "Use --port N, --root DIR, or --deepseek-env FILE." {}))))))))

(defn run
  "Start the disposable API playground beside real project-daemon services.
   A provided root is reused, never reset. Without one, make a fresh fixture."
  [args]
  (let [opts (options args)
        root (or (:root opts) (fixture/fresh!))
        _ (when-not (File/dir? (Path/join root "src"))
            (throw (ex-info "Choose a playground root containing src/, or omit --root for a fresh sample." {})))
        _ (when (:env opts) (gen/load-key! (:env opts)))
        w (ws/attach! root)
        _ (gen/restore! w "src/playground.bl")
        _ (ws/open! w "src/app/invoices.bl")
        _ (ws/eval! w (str "(ns user (:require [dev.workspace :as ws] [play.change :as change] [play.gen :as gen] [play.ui :as ui]))\n"
                            "(def w (ws/attach! " (pr-str root) "))\n"
                            "(gen/use! w \"src/playground.bl\")"))
        listener (session/start root)
        endpoint (:ok (paths/endpoints root))
        token (if (and endpoint (File/regular? (:token endpoint)))
                (File/read! (:token endpoint))
                (Base/encode16 (crypto/strong_rand_bytes 24)))
        http-opts {:root root :tree-id (paths/tree-id root) :token token
                   :started-at (erlang/system_time :second)}
        play (ui/handler w {:token token})
        daemon (http/router http-opts)
        router (fn [conn]
                 (let [path (web/path conn)]
                   (cond
                     (= path "/") (web/html conn "<meta http-equiv=\"refresh\" content=\"0;url=/play\">")
                     (or (= path "/play") (String/starts_with? path "/play/")) (play conn)
                     :else (daemon conn))))
        _ (web/serve {:port (:port opts) :ip (tuple 127 0 0 1) :plug router :log :off})]
    (println "\nBeam Lisp API playground")
    (println (str "  Open:      http://127.0.0.1:" (:port opts) "/play"))
    (println (str "  REPL:      http://127.0.0.1:" (:port opts) "/repl"))
    (println (str "  Workspace: " root))
    (println "  Provider:  demo by default; DeepSeek requires explicit selection")
    (println "  Ctrl+C stops this prototype. Reuse --root to reopen its saved history.\n")
    (try (Process/sleep :infinity)
         (finally (session/stop listener) (ws/shutdown! w)))))
