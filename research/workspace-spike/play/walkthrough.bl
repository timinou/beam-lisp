(ns play.walkthrough
  (:require [dev.workspace :as ws]
            [play.change :as change]
            [play.gen :as gen]
            [play.fixture :as fixture]))

(defn check! [condition label]
  (when-not condition (throw (ex-info (str "Walkthrough stopped: " label) {})))
  (println (str "  ✓ " label)))

(defn run []
  (let [root (fixture/fresh!)
        w (ws/attach! root)]
    (println "\nWelcome to your small Lisp machine.")
    (println (str "Your disposable files live at " root "\n"))
    (try
      (check! (every? (set (ws/files w)) ["src/playground.bl" "src/app/invoices.bl"])
              "The workspace finds the notebook and invoice source")
      (let [b (ws/open! w "src/app/invoices.bl")]
        (check! (String/contains? (:source (ws/snapshot b)) "defn total") "A file is an inspectable buffer")
        (check! (= 2 (count (ws/definitions w 'app.invoices))) "Definitions are ordinary data"))
      (let [draft (ws/new-file! w "src/notes.bl" "(ns notes)\n(def answer 42)\n")]
        (check! (:dirty? (ws/snapshot draft)) "A new buffer is Made, not Saved")
        (ws/save! draft)
        (check! (File/regular? (Path/join root "src/notes.bl")) "Save writes the draft to its guarded path"))
      (ws/eval! w "(ns user (:require [app.invoices :as invoices]))")
      (check! (= "1000" (ws/eval! w "(invoices/total {:subtotal-cents 1000 :late-fee-cents 250})"))
              "The live starting function returns only the subtotal")
      (gen/use! w "src/playground.bl")
      (let [x (gen/ns "Include late fees in invoice totals")
            result (gen/await! x 90000)]
        (check! (= :ready (:status result)) (str "The demo conversation produces a verified candidate: " (:error result)))
        (let [p (gen/proposal x)
              revision (:made (ws/status p))]
          (check! (= 2 (count (:changes (ws/preview p)))) "One proposal carries the new namespace AND its caller change")
          (check! (nil? (:saved (ws/status p))) "Made does not imply Saved")
          (check! (nil? (:live (ws/status p))) "Made does not imply Live")
          (ws/try! p)
          (check! (= "1000" (ws/eval! w "(invoices/total {:subtotal-cents 1000 :late-fee-cents 250})"))
                  "Trying a candidate leaves the live workspace unchanged")
          (gen/accept! x)
          (check! (= revision (:saved (ws/status p))) "Accept saves the proposal before selecting its ledger version")
          (check! (nil? (:live (ws/status p))) "Saved still does not imply Live")
          (ws/make-live! p)
          (check! (= revision (:live (ws/status p))) "Make live advances the independent Live revision")
          (check! (= "1250" (ws/eval! w "(app.invoices/total {:subtotal-cents 1000 :late-fee-cents 250})"))
                  "The generated namespace and companion edit run together")
          (check! (File/regular? (gen/cache-path w "src/playground.bl")) "The owning source has one .cache.bl ledger")))
      (let [p (ws/propose! w (change/bundle "A deliberately stale edit"
                              (change/in-namespace 'app.invoices
                                (change/replace-definition 'label '(defn label [invoice] "new label")))))
            _ (ws/verify! p)
            path (Path/join root "src/app/invoices.bl")
            external (str (File/read! path) "\n; An external editor got here first.\n")]
        (File/write! path external)
        (check! (try (ws/save! p) false (catch _e true)) "A stale basis becomes a conflict, not a lost edit")
        (check! (= external (File/read! path)) "The external edit is preserved"))
      (let [x (gen/ns w "src/playground.bl" "A slow demo for cancellation" {:delay-ms 1500})]
        (gen/cancel! x)
        (Process/sleep 1700)
        (check! (= :cancelled (:status (ws/snapshot x))) "Cancelled work cannot publish a late version")
        (check! (nil? (gen/proposal x)) "Cancellation leaves no accepted candidate"))
      (ws/shutdown! w)
      (let [again (ws/attach! root)
            restored (gen/restore! again "src/playground.bl")]
        (check! (= 2 (count restored)) "Conversation history restores without another provider call")
        (check! (= "1250" (ws/eval! again "(ns user (:require [app.invoices :as invoices])) (invoices/total {:subtotal-cents 1000 :late-fee-cents 250})"))
                "Saved source works after reopening the workspace")
        (ws/shutdown! again))
      (println "\nTour complete. These were the same API operations the browser uses.")
      (println (str "Keep exploring: --root " root))
      {:ok true :root root}
      (finally (try (ws/shutdown! w) (catch _e nil))))))
