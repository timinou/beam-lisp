(ns play.image-test
  (:require [dev.workspace :as ws] [play.change :as change]
            [play.gen :as gen] [play.fixture :as fixture]))

(deftest candidate-shims-never-replace-live-shims
  (let [w1 (ws/attach! (fixture/fresh!))
        w2 (ws/attach! (fixture/fresh!))
        eval-form "(invoices/total {:subtotal-cents 1000 :late-fee-cents 250})"]
    (try
      (ws/eval! w1 "(ns user (:require [app.invoices :as invoices]))")
      (ws/eval! w2 "(ns user (:require [app.invoices :as invoices]))")
      (is (= "1000" (ws/eval! w1 eval-form)))
      (let [x (gen/ns w1 "src/playground.bl" "Include fees" {:delay-ms 1 :max-repairs 0})
            result (gen/await! x 90000)]
        (is (= :ready (:status result)) (:error result))
        (let [p (gen/proposal x)]
          (is (= "1000" (ws/eval! w1 eval-form)))
          (ws/try! p)
          (is (= "1000" (ws/eval! w1 eval-form)))
          (is (= "1000" (ws/eval! w2 eval-form)))
          (ws/make-live! p)
          (is (= "1250" (ws/eval! w1 eval-form)))
          (is (= "1000" (ws/eval! w2 eval-form)))
          (is (nil? (:saved (ws/status p))))
          (is (= "app.invoices" (ws/eval! w1 "'app.invoices")))))
      (finally (ws/shutdown! w1) (ws/shutdown! w2)))))

(deftest save-rechecks-symlinks-after-planning
  (let [root (fixture/fresh!) w (ws/attach! root)
        outside (fixture/fresh!)
        p (ws/propose! w (change/bundle "A file in a new directory"
                           (change/create-file "new/note.bl" "(ns note)\n")))]
    (try
      (ws/verify! p)
      (File/ln_s! outside (Path/join root "new"))
      (is (try (ws/save! p) false (catch _e true)))
      (is (not (File/exists? (Path/join outside "note.bl"))))
      (finally (ws/shutdown! w)))))

(deftest malformed-model-history-is-only-data
  (let [root (fixture/fresh!) w (ws/attach! root)
        source "src/playground.bl"
        marker (Path/join root "never-created.bl")
        text (str "(File/write! " (pr-str marker) " \"bad\")")
        x (gen/ns w source "No arbitrary evaluator" {:max-repairs 0 :ask-fn (fn [_] {:ok text})})]
    (try
      (gen/await! x 30000)
      (gen/restore! w source)
      (is (not (File/exists? marker)))
      (finally (ws/shutdown! w)))))

(deftest file-handles-and-repl-bindings-compose
  (let [w (ws/attach! (fixture/fresh!))]
    (try
      (let [b (ws/open! w "src/app/invoices.bl")
            source (str (:source (ws/snapshot b)) "\n; kept draft\n")]
        (ws/edit! b source)
        (is (= (:id b) (:id (ws/open! w "src/app/invoices.bl"))))
        (is (= source (:source (ws/snapshot b))))
        (is (= b (ws/bind! w 'buffer b)))
        (is (= "true" (ws/eval! w "(= :buffer (:kind buffer))"))))
      (let [draft (ws/new-file! w "src/new-note.bl" "(ns new-note)\n")]
        (is (try (ws/new-file! w "src/new-note.bl" "(ns different)\n") false (catch _e true)))
        (is (= "(ns new-note)\n" (:source (ws/snapshot draft)))))
      (finally (ws/shutdown! w)))))


(deftest structural-plans-refuse-ambiguity-and-compose-created-sources
  (let [root (fixture/fresh!) w (ws/attach! root)]
    (try
      (File/write! (Path/join root "src/app/invoices.bl")
                   "(ns app.invoices)\n(defn total [x] 1)\n(defn total [x] 2)\n")
      (is (try (ws/propose! w (change/bundle "Ambiguous"
                               (change/in-namespace 'app.invoices
                                 (change/replace-definition 'total '(defn total [x] 3)))))
               false (catch _e true)))
      (is (try (change/materialize root {:title "Unknown" :operations [{:op :not-supported}]})
               false (catch _e true)))
      (let [changes (change/materialize root
                      (change/bundle "Create and compose"
                        (change/create-namespace 'demo '(defn identity [x] x))
                        (change/in-namespace 'demo
                          (change/require '[clojure.string :as str])
                          (change/add-definition '(defn shout [x] (str/upper-case x))))))
            source (:after (first changes))]
        (is (= 1 (count changes)))
        (is (String/contains? source "[clojure.string :as str]"))
        (is (String/contains? source "defn shout")))
      (finally (ws/shutdown! w)))))
