; Explicit opt-in: one DeepSeek request, no automatic repair, disposable sources.
(BeamLisp.Env/add_search_path (Path/expand "research/workspace-spike" (BeamLisp/cwd)))
(BeamLisp.Loader/ensure_loaded "play.deepseek-smoke")
(BeamLisp.RT/invoke (BeamLisp.Env/fetch! "play.deepseek-smoke" "run") (list (BeamLisp/argv)))
