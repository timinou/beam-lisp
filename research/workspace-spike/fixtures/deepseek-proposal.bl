; Captured provider output. Decode as data with play.change/decode; do not run it.
(change/bundle "Add billing rules total and delegate invoice total"
  (change/create-namespace 'billing.rules
    '(defn total
       "Adds integer subtotal and late fee cents."
       [subtotal-cents fee-cents]
       (+ subtotal-cents fee-cents)))
  (change/in-namespace 'app.invoices
    (change/require '[billing.rules :as billing])
    (change/replace-definition 'total
      '(defn total
         "The invoice subtotal plus any late fee, in integer cents."
         [invoice]
         (billing/total (:subtotal-cents invoice) (:late-fee-cents invoice))))))
