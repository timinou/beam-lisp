(ns play.provider-test
  (:require [web] [bl.json :as json] [gen.llm :as llm]))

(defn- free-port []
  (let [socket (erlang/element 2 (gen_tcp/listen 0 (list (tuple :active false))))
        address (erlang/element 2 (inet/sockname socket))
        port (erlang/element 2 address)]
    (gen_tcp/close socket)
    port))

(deftest provider-budgets-reach-the-wire
  (let [port (free-port)
        me (erlang/self)
        server (web/serve
                 {:port port :ip (tuple 127 0 0 1) :log :off
                  :plug (fn [conn]
                          (let [[body conn] (web/read-body* conn)]
                            (erlang/send me [:payload (json/decode body)])
                            (web/json conn 200 {"choices" (list {"message" {"content" "candidate"}})})))})
        pid (erlang/element 2 server)]
    (try
      (let [provider (assoc llm/deepseek
                            :base-url (str "http://127.0.0.1:" port)
                            :key-env "BL_PLAY_TEST_NO_KEY"
                            :max-tokens 321 :timeout-ms 5000)
            result (llm/chat provider (list {:role "user" :content "test"}))
            payload (receive [:payload p] p (after 5000 nil))]
        (is (= "candidate" (:ok result)))
        (is (= 321 (get payload "max_tokens")))
        (is (= "test" (get (first (get payload "messages")) "content"))))
      (finally (Supervisor/stop pid)))))
