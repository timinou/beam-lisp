(ns play.gen-test
  (:require [play.gen :as gen]
            [play.change :as change]
            [play.fixture :as fixture]
            [dev.workspace :as ws]
            [clojure.edn :as edn]))

(deftest generation-is-a-proposal-not-a-write
  (let [root (fixture/fresh!) w (ws/attach! root)
        path (Path/join root "src/app/invoices.bl")
        before (File/read! path)]
    (try
      (let [x (gen/ns w "src/playground.bl" "Include the late fee" {:delay-ms 10})
            result (gen/await! x 90000)
            p (gen/proposal x)]
        (is (= :ready (:status result)))
        (is (= 2 (count (:changes (ws/preview p)))))
        (is (= before (File/read! path)))
        (is (nil? (:saved (ws/status p))))
        (is (nil? (:live (ws/status p))))
        (is (some (fn [turn] (= "assistant" (:role turn))) (gen/turns x)))
        (is (= 1 (count (gen/versions x))))
        (gen/accept! x)
        (let [ledger (edn/read-string (File/read! (gen/cache-path w "src/playground.bl")))]
          (is (= p (get-in ledger [:experiences (:id x) :accepted]))))
        (is (some? (:saved (ws/status p))))
        (is (nil? (:live (ws/status p)))))
      (finally (ws/shutdown! w)))))

(deftest cancelled-workers-do-not-publish
  (let [w (ws/attach! (fixture/fresh!))]
    (try
      (let [x (gen/ns w "src/playground.bl" "Slow generation" {:delay-ms 700})]
        (gen/cancel! x)
        (Process/sleep 850)
        (is (= :cancelled (:status (ws/snapshot x))))
        (is (nil? (gen/proposal x)))
        (is (empty? (gen/versions x))))
      (finally (ws/shutdown! w)))))

(deftest arbitrary-model-code-is-rejected-before-execution
  (let [root (fixture/fresh!) w (ws/attach! root)
        marker (Path/join root "executed.txt")
        malicious (str "(File/write! " (pr-str marker) " \"unsafe\")")]
    (try
      (let [x (gen/ns w "src/playground.bl" "Reject executable constructor output"
                      {:max-repairs 0 :ask-fn (fn [_] {:ok malicious})})
            result (gen/await! x 30000)]
        (is (= :failed (:status result)))
        (is (not (File/exists? marker)))
        (is (nil? (gen/proposal x)))
        (is (= #{"env.bl" "src/playground.bl" "src/app/invoices.bl"} (set (ws/files w)))))
      (finally (ws/shutdown! w)))))

(deftest persisted-turns-are-data-after-restart
  (let [root (fixture/fresh!) w (ws/attach! root)
        x (gen/ns w "src/playground.bl" "Keep this conversation" {:delay-ms 10})]
    (gen/await! x 90000)
    (let [original (gen/turns x)]
      (ws/shutdown! w)
      (let [again (ws/attach! root)]
        (try
          (let [restored (gen/restore! again "src/playground.bl")]
            (is (= 1 (count restored)))
            (is (= original (gen/turns (first restored))))
            (is (= :ready (:status (ws/snapshot (first restored))))))
          (finally (ws/shutdown! again)))))))

(deftest owning-source-is-confined
  (let [w (ws/attach! (fixture/fresh!))]
    (try
      (is (try (gen/ns w "../outside.bl" "No") false (catch _e true)))
      (is (try (gen/ns w ".env" "No") false (catch _e true)))
      (is (try (gen/ns w "/tmp/outside.bl" "No") false (catch _e true)))
      (finally (ws/shutdown! w)))))

(deftest quoted-setup-code-is-not-automatically-executed
  (let [root (fixture/fresh!) w (ws/attach! root)
        marker (Path/join root "must-not-exist.bl")
        payload (str "(change/bundle \"setup\" (change/create-namespace 'malicious "
                     "'(File/write! " (pr-str marker) " \"bad\")))")]
    (try
      (let [x (gen/ns w "src/playground.bl" "Reject setup side effects"
                      {:max-repairs 0 :ask-fn (fn [_] {:ok payload})})]
        (is (= :failed (:status (gen/await! x 30000))))
        (is (not (File/exists? marker)))
        (is (nil? (gen/proposal x))))
      (finally (ws/shutdown! w)))))


(deftest captured-deepseek-proposal-remains-replayable
  (let [w (ws/attach! (fixture/fresh!))
        response (File/read! "research/workspace-spike/fixtures/deepseek-proposal.bl")]
    (try
      (let [x (gen/ns w "src/playground.bl" "Replay the captured provider response"
                      {:max-repairs 0 :ask-fn (fn [_] {:ok response})})
            result (gen/await! x 90000)]
        (is (= :ready (:status result)) (:error result))
        (is (= 2 (count (:changes (ws/preview (gen/proposal x))))))
        (gen/accept! x)
        (ws/make-live! (gen/proposal x))
        (is (= "1250" (ws/eval! w "(app.invoices/total {:subtotal-cents 1000 :late-fee-cents 250})")))
        (is (= "true" (ws/eval! w "(= \"Invoice 7\" (app.invoices/label {:number 7}))"))))
      (finally (ws/shutdown! w)))))


(deftest explicit-namespace-controls-generated-source
  (let [w (ws/attach! (fixture/fresh!))]
    (try
      (let [x (gen/ns w "src/playground.bl" "Put arithmetic in billing.fees"
                      {:ns 'billing.fees :delay-ms 1 :max-repairs 0})
            result (gen/await! x 90000)]
        (is (= :ready (:status result)) (:error result))
        (is (= "billing.fees" (:target-ns result)))
        (is (contains? (set (map :path (:changes (ws/preview (gen/proposal x)))))
                       "src/billing/fees.bl")))
      (finally (ws/shutdown! w)))))


(deftest copied-history-rebinds-to-the-current-workspace
  (let [root (fixture/fresh!) w (ws/attach! root)
        x (gen/ns w "src/playground.bl" "A portable proposal" {:delay-ms 1 :max-repairs 0})
        copied (str root "-copy")]
    (try
      (gen/await! x 90000)
      (gen/accept! x)
      (File/cp_r root copied)
      (let [other (ws/attach! copied)]
        (try
          (let [restored (first (gen/restore! other "src/playground.bl"))
                proposal (gen/proposal restored)]
            (is (= copied (:root restored)))
            (is (= copied (:root proposal)))
            (is (= copied (:root (ws/preview proposal))))
            (is (nil? (:live (ws/status proposal))))
            (gen/accept! restored)
            (is (= (:made (ws/status proposal)) (:saved (ws/status proposal))))
            (gen/refine! restored "Refine only this copy")
            (is (= :ready (:status (gen/cancel! x))))
            (is (= :ready (:status (gen/await! restored 90000)))))
          (finally (ws/shutdown! other))))
      (finally (ws/shutdown! w)))))


(deftest generated-function-bodies-support-data-collections
  (let [w (ws/attach! (fixture/fresh!))
        response "(change/bundle \"Report data\" (change/create-namespace 'billing.report '(defn report [invoice] {:amount (:subtotal-cents invoice) :tags #{:paid}})))"]
    (try
      (let [x (gen/ns w "src/playground.bl" "Return a report map"
                      {:max-repairs 0 :ask-fn (fn [_] {:ok response})})
            result (gen/await! x 90000)]
        (is (= :ready (:status result)) (:error result))
        (when (= :ready (:status result))
          (ws/make-live! (gen/proposal x))
          (is (= "true" (ws/eval! w "(= {:amount 1000 :tags #{:paid}} (billing.report/report {:subtotal-cents 1000}))")))))
      (finally (ws/shutdown! w)))))
