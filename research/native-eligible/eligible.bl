; eligible.bl — native-offload eligibility, INTER-PROCEDURAL.
;
; ── The doc-05 gate, and what changed ────────────────────────────────────
;
; docs/memory-policy/05-proof-directed-native-offload.bl.md defines offload
; eligibility as a conjunction of four theorems:
;
;   offloadable(f) ⇐  footprint(f) = ∅          (pure)
;                   ∧ terminates(f)              (a decreasing measure)
;                   ∧ ∀arg. sort(arg) ∈ NifSorts (machine-safe values)
;                   ∧ work(f) ≤ W(size(args))    (bounded work)
;
; The shipped spec computes these PER FUNCTION over the bl source. Its own
; example is honest about the wall:
;
;   "The NIF is opaque to footprint, but it INHERITS footprint = ∅ from the
;    bl source it was derived from, so every proof about a caller is unchanged."
;
; But the *reverse* was the missing win: before whole-program analysis, a
; function that CALLS a helper could not be judged, because the helper was an
; opaque callee — footprint collapsed to :opaque-world, so the caller was
; refused as impure even when the helper was provably pure.
;
; ── The inter-procedural win ─────────────────────────────────────────────
;
; system.analyze computes each function's summary with EVERY callee's summary
; substituted — the footprint closure. So a caller's footprint now GROWS to
; include its callees', and a caller of a pure helper is itself pure. That
; makes whole call-TREES offloadable, not just leaf functions. The MMORPG hot
; path (a spatial-hash step calling a pure distance helper) and the model swarm
; kernel (a softmax calling a pure exp) are exactly this shape.
;
; This module reads the analyze summary and adds the two theorems the summary
; doesn't yet carry — sorts (via system.smt/sort-of-tags over the return/arg
; tags) and a first-cut work bound — to produce the full doc-05 verdict.

(ns eligible
  (:require [system.analyze :as analyze]
            [system.summary :as summary]
            [system.smt :as smt]
            [system.ir :as ir]))

(def nif-sorts #{"Int" "Real" "Bool" "String"})

(defn- sorts-ok?
  "Theorem 3: every value the function returns is a NIF-safe machine sort.
   Reads the summary's :returns tagset through system.smt/sort-of-tags — the
   same sort functor the SMT layer uses. A compound/ambiguous tagset maps to
   :unknown and fails the theorem (honest: we cannot copy it across the NIF
   boundary)."
  [returns]
  (and (seq returns)
       (not (= :unknown (smt/sort-of-tags returns)))))

(defn eligible
  "The full doc-05 verdict for `fn-name` in `src`, computed INTER-PROCEDURALLY.
   Each refusal names the failed theorem — never a silent fallback. The purity
   and termination facts already include callees (analyze's closure), so a
   caller of a pure, terminating helper inherits both.

   {:eligible true  :scheduler :normal|:dirty-cpu}
   | {:eligible false :reason <theorem> :detail …}"
  [src fn-name]
  (let [summaries (analyze/analyze src)
        s (get summaries fn-name)]
    (cond
      (nil? s)                {:eligible false :reason :no-such-fn}
      (seq (:footprint s))    {:eligible false :reason :impure
                               :detail (:footprint s)}
      (not (:terminates s))   {:eligible false :reason :may-diverge}
      (not (sorts-ok? (:returns s))) {:eligible false :reason :sort
                                      :detail {:returns (sort (into [] (:returns s)))
                                               :sort (smt/sort-of-tags (:returns s))}}
      :else                   {:eligible true
                               :sort (smt/sort-of-tags (:returns s))
                               :calls (into [] (:edges s))
                               :note (if (empty? (:edges s))
                                       "leaf kernel — direct native"
                                       "calls only-pure helpers — whole tree offloadable")})))

(defn eligibility-report
  "The offload verdict for EVERY function in `src`, so a tool can green-light a
   whole module at once. Returns {fn-name → verdict}."
  [src]
  (let [summaries (analyze/analyze src)]
    (reduce (fn [m [name _]] (assoc m name (eligible src name)))
            {} (into [] summaries))))
