; lowerers_spike/run.bl — spike driver (single self-contained file).
; Run: BEAM_LISP_PATH=research/lowerers_spike ./bl run research/lowerers_spike/run.bl

(ns spike-run (:require [compiler :as c]))

(def sl-kenv (assoc (c/new-env "spike-run") :ns "spike-run"))

(defn sl-quoted-of [src]
  (c/compile (BeamLisp.Reader/read_one src) sl-kenv))

;; ── node accessors ────────────────────────────────────────────────────────
;; compiler/compile returns bl-DATA: Elixir tuples are wrapped as
;; {:"{}" [] [k m args]}; the OUTERMOST node is a real 3-tuple.
;; parts gives logical [k m args] for both. Literals stay raw — callers
;; must test is_atom/is_number/is_binary before head/args*.

(defn sl-node? [t n] (and (tuple? t) (= n (tuple-size t))))
(defn sl-wrapped? [t]
  (and (sl-node? t 3)
       (erlang/is_atom (elem t 0))
       (= "{}" (erlang/atom_to_binary (elem t 0)))))
(defn sl-parts [t]
  (if (sl-wrapped? t)
    (to-list (elem t 2))
    (if (sl-node? t 3)
      (list (elem t 0) (elem t 1) (to-list (elem t 2)))
      (list nil nil nil))))
(defn sl-head [t] (nth (sl-parts t) 0))
(defn sl-args* [t] (nth (sl-parts t) 2))
(defn sl-var-node? [t]
  "wrapped var {:{}, [] [:name [] ctx]} — name atom, meta list, ctx atom"
  (if (not (sl-node? t 3)) false
    (let [p (sl-parts t)]
      (if (not (erlang/is_atom (nth p 0))) false
        (if (not (erlang/is_list (nth p 1))) false
          (erlang/is_atom (nth p 2)))))))
(defn sl-dot-node? [h]
  (or (and (sl-wrapped? h) (= :. (nth (to-list (elem h 2)) 0)))
      (and (sl-node? h 3) (erlang/is_atom (elem h 0)) (= :. (elem h 0)))))
(defn sl-call-node? [t] (and (sl-node? t 3) (sl-dot-node? (sl-head t))))
(defn sl-form? [t k] (and (sl-node? t 3) (erlang/is_atom (sl-head t)) (= k (sl-head t))))
(defn sl-kw [kvs k] (Keyword/get kvs k))
(defn sl-var-name [t] (sl-head t))

(defn zz1 [] 1)

(defn sl-refuse [check why]
  (throw (ex-info (str "REFUSED " check ": " why) {:check check})))

;; ── generic structural search ─────────────────────────────────────────────

(defn sl-kids [t]
  (cond
    (erlang/is_list t) (to-list t)
    (sl-wrapped? t) (to-list (elem t 2))
    (and (tuple? t) (= 3 (tuple-size t))) (to-list (elem t 2))
    (and (tuple? t) (= 2 (tuple-size t))) (list (elem t 0) (elem t 1))
    :else nil))

(defn zz2 [] 2)

(defn sl-find-first [pred t]
  (if (pred t) t
    (let [ks (sl-kids t)]
      (if (nil? ks) nil
        (reduce (fn [f x] (if (nil? f) (sl-find-first pred x) f)) nil ks)))))

;; ── def extraction ────────────────────────────────────────────────────────

(defn zz3 [] 3)

(defn sl-fixed-of [a]
  (if (and (sl-node? a 3)
           (erlang/is_atom (elem a 0))
           (= "{}" (erlang/atom_to_binary (elem a 0)))
           (erlang/is_list (elem a 2)))
    (let [as (to-list (elem a 2))]
      (if (and (= 4 (count as)) (= :fixed (first as))) (nth as 3) nil))
    nil))

(defn zz4 [] 4)

(defn sl-extract-def [q]
  (let [found
        (reduce (fn [f a]
                  (cond
                    (sl-fixed-of a) (sl-fixed-of a)
                    (erlang/is_list a)
                      (reduce (fn [f2 x] (if (sl-fixed-of x) (sl-fixed-of x) f2))
                              f (to-list a))
                    :else f))
                nil
                (to-list (sl-args* q)))]
    (if (nil? found) (sl-refuse :not-a-defn "no def emitted") nil)
    (let [pair (sl-args* found)
          hd (first (to-list pair))
          kvs (second (to-list pair))
          params (let [a (sl-args* hd)]
                   (if (and (= 1 (count a)) (erlang/is_list (first a)))
                     (to-list (first a))
                     a))]
      {:params (to-list params) :body (sl-kw kvs :do)})))

;; ── the loop recognizer ───────────────────────────────────────────────────

(defn sl-self-applied-loop?
  "a call applying the loop var to itself, directly"
  [t loop-name]
  (and (sl-var-node? (sl-head t)) (= (sl-var-name (sl-head t)) loop-name)))

(defn sl-dot-single-target [h]
  "for a wrapped {. [] [x]} node: the callee x; nil otherwise (total)"
  (if (and (sl-wrapped? h)
           (erlang/is_list (elem h 2))
           (= 3 (count (to-list (elem h 2)))))
    (let [hin (to-list (elem h 2))]
      (if (and (= :. (first hin))
               (erlang/is_list (nth hin 2))
               (= 1 (count (to-list (nth hin 2)))))
        (first (to-list (nth hin 2)))
        nil))
    nil))

(defn sl-partial-app-loop? [t loop-name]
  (and (sl-call-node? t)
       (let [x (sl-dot-single-target (sl-head t))]
         (if (or (nil? x) (not (sl-call-node? x))) false
           (let [h2 (sl-head x)]
             (and (sl-wrapped? h2)
                  (= :. (first (to-list (elem h2 2))))
                  (let [a (to-list (nth (to-list (elem h2 2)) 2))]
                    (and (= 1 (count a)) (sl-var-node? (first a))
                         (= (sl-var-name (first a)) loop-name)))))))))


(defn zz5 [] 5)

(defn sl-loop-of [body]
  (let [fn1 (sl-find-first (fn [t] (sl-form? t :fn)) body)]
    (if (nil? fn1)
      (sl-refuse :not-a-counted-loop "no loop fn")
      nil)
    (let [cl (first (sl-args* fn1))
          loop-pats (to-list (first (sl-args* cl)))
          inner (second (sl-args* cl))]
      (if (or (not= 1 (count loop-pats)) (not (sl-form? inner :fn)))
        (sl-refuse :not-a-counted-loop "scaffold self-arg missing"))
      (let [loop-name (sl-var-name (first loop-pats))
            cl2 (first (sl-args* inner))
            vars (to-list (first (sl-args* cl2)))
            ifx (second (sl-args* cl2))]
        (if (not (sl-form? ifx :if))
          (sl-refuse :not-a-counted-loop "loop body is not an if"))
        (let [test (first (sl-args* ifx))
              kvs (second (sl-args* ifx))
              then (sl-kw kvs :do)
              ret (sl-kw kvs :else)
              recur-pred (fn [t]
                           (try
                             (and (sl-call-node? t)
                                  (> (count (sl-args* t)) 1)
                                  (or (sl-self-applied-loop? t loop-name)
                                      (sl-partial-app-loop? t loop-name)))
                             (catch e false)))
              recur-node (sl-find-first recur-pred then)]
          (if (nil? recur-node)
            (sl-refuse :not-a-counted-loop "no recur re-applying the loop itself"))
          (let [bargs (sl-args* body)
                nvars (count vars)
                inits (map (fn [i] (nth bargs i))
                           (range (- (count bargs) nvars) (count bargs)))]
            (if (< (count bargs) nvars)
              (sl-refuse :not-a-counted-loop "init arity mismatch"))
            {:vars vars
             :inits (to-list inits)
             :test test
             :recur-args (to-list (sl-args* recur-node))
             :ret ret}))))))

;; ── the lowering (ANF fused into the walk) ────────────────────────────────

(def sl-stms (atom nil))
(def sl-nvar (atom 0))

(defn sl-fresh-var [] (let [v @sl-nvar] (swap! sl-nvar inc) v))
(defn sl-emit! [line] (swap! sl-stms conj line))

(defn sl-var-of [env t]
  (let [ix (get (:syms env) (sl-var-name t))]
    (if (nil? ix)
      (sl-refuse :impure (str "unbound symbol " (sl-var-name t)))
      ix)))

(defn zz6 [] 6)

(defn sl-lower-arg! [env e]
  (cond
    (erlang/is_number e)
      (let [v (sl-fresh-var)] (sl-emit! (str "imm " v " " e)) v)
    (sl-var-node? e) (sl-var-of env e)
    (sl-form? e :__block__)
      (reduce (fn [_ s] (sl-lower-arg! env s)) nil (to-list (sl-args* e)))
        (sl-call-node? e)
      (let [tgt (if (sl-wrapped? (sl-head e))
                  (to-list (nth (to-list (elem (sl-head e) 2)) 2))
                  (to-list (elem (sl-head e) 2)))
            m (first tgt)
            f (second tgt)
            as (to-list (sl-args* e))]
        (if (not= :erlang m)
          (sl-refuse :impure "call is outside the fragment (erlang + - * < or binary/at only)"))
        (if (= :+ f)
          (let [a (sl-lower-arg! env (first as))
                v (sl-fresh-var)
                raw-b (second as)]
            (if (erlang/is_number raw-b)
              (sl-emit! (str "addimm " v " " a " " raw-b))
              (let [b (sl-lower-arg! env raw-b)]
                (sl-emit! (str "add " v " " a " " b))))
            v)
          (let [a (sl-lower-arg! env (first as))
                b (sl-lower-arg! env (second as))
                v (sl-fresh-var)]
            (cond
              (= :* f) (sl-emit! (str "mul " v " " a " " b))
              (= :-)   (sl-emit! (str "sub " v " " a " " b))
              :else
                (sl-refuse :impure
                  (str "primop " (erlang/atom_to_binary f) " not in the fragment")))
            v)))

    (sl-form? e :apply)
      (let [call (sl-args* e)
            m (first call)
            f (second call)
            as (to-list (nth call 2))]
        (if (and (= :binary m) (= :at f) (= 2 (count as)))
          (let [base (sl-lower-arg! env (first as))
                off (sl-lower-arg! env (second as))
                v (sl-fresh-var)]
            (sl-emit! (str "load " v " " base " " off))
            v)
          (sl-refuse :impure "module call outside the fragment (only binary/at)")))
    :else (sl-refuse :impure "expression form outside the fragment")))

(defn sl-lower-loop! [env lp]
  (let [vars (:vars lp) inits (:inits lp) test (:test lp)
        recur-args (:recur-args lp) ret (:ret lp)
        n (count vars)
        lvars (to-list (map (fn [_] (sl-fresh-var)) (range n)))
        env (reduce (fn [e i]
                      (assoc-in e [:syms (sl-var-name (nth vars i))] (nth lvars i)))
                    env (range n))]
    (if (not= n (count inits))
      (sl-refuse :not-a-counted-loop "init arity mismatch"))
    (reduce (fn [_ i]
              (let [e (nth inits i)]
                (sl-emit! (str "init " (nth lvars i) " "
                            (if (erlang/is_number e) e (sl-var-of env e)))))
              nil)
            nil (range n))
    (let [targs (to-list (sl-args* test))
          th (to-list (sl-args* (sl-head test)))]
      (if (not (and (sl-call-node? test) (= 2 (count th))
                    (= :erlang (first th)) (= :< (second th))))
        (sl-refuse :not-a-counted-loop "loop test is not a comparison"))
      (let [iv (sl-var-of env (first targs))
            le (second targs)
            limit (if (sl-var-node? le)
                    (sl-var-of env le)
                    (let [v (sl-fresh-var)] (sl-emit! (str "init " v " " le)) v))]
        (if (not= iv (first lvars))
          (sl-refuse :not-shrinking "loop test does not scrutinize the first loop var"))
        (let [i-arg (first recur-args)
              th2 (to-list (sl-args* (sl-head i-arg)))
              ia (to-list (sl-args* i-arg))]
          (if (or (not (and (sl-call-node? i-arg) (= 2 (count th2))
                            (= :erlang (first th2)) (= :+ (second th2))))
                  (not (sl-var-node? (first ia)))
                  (not= iv (sl-var-of env (first ia)))
                  (not (erlang/is_number (second ia))))
            (sl-refuse :not-shrinking
              "recur does not advance the loop var by a literal (+ i k)"))
          (let [step (second ia)]
            (reduce (fn [_ j]
                      (let [lv (nth lvars (inc j))
                            v (sl-lower-arg! env (nth recur-args (inc j)))]
                        (sl-emit! (str "mov " lv " " v)))
                      nil)
                    nil (range (dec n)))
            (let [rv (sl-lower-arg! env ret)]
              (list (str "loop " (first lvars) " " limit " " step)
                    (str "ret " rv)))))))))

(defn sl-lower-defn [src]
  (reset! sl-stms nil)
  (reset! sl-nvar 0)
  (let [d (sl-extract-def (sl-quoted-of src))
        np (count (:params d))
        env {:syms (reduce (fn [m i]
                             (assoc m (sl-var-name (nth (:params d) i)) i))
                           {} (range np))}]
    (swap! sl-nvar (fn [x] (max x np)))
    (let [lp (sl-loop-of (:body d))
          tail (sl-lower-loop! env lp)
          body-lines (reverse (to-list @sl-stms))]
      (concat (to-list body-lines) tail))))

(defn sl-ir-text [name nparams lines]
  (reduce (fn [a l] (str a l "\n"))
          (str "kernel " name " " nparams "\n")
          lines))


(def checksum-src
  "(defn checksum [buf n]
     (loop [i 0 acc 0]
       (if (< i n)
         (recur (+ i 1) (+ (* 31 acc) (binary/at buf i)))
         acc)))")

(def dot-product-src
  "(defn dot-product [xs ys n]
     (loop [i 0 acc 0]
       (if (< i n)
         (recur (+ i 1) (+ acc (* (nth xs i) (nth ys i))))
         acc)))")

(def parse-header-src
  "(defn parse-header [buf]
     (loop [i 0 acc 0]
       (if (< i 16)
         (recur buf (+ acc i))
         acc)))")

(def ackermann-src
  "(defn ackermann [m n]
     (if (= m 0)
       (+ n 1)
       (if (= n 0)
         (ackermann (- m 1) 1)
         (ackermann (- m 1) (ackermann m (- n 1))))))")


(defn try-lower [name src]
  (try
    (let [lines (sl-lower-defn src)]
      (str "ACCEPTED, " (count lines) " IR lines"))
    (catch e
      (str "REFUSED " (:check (ex-data e)) " — " (ex-message e)))))

(defn now-us [] (erlang/monotonic_time :microsecond))

(defn main []
  (println "── 1. L-IR: quoted → j1 IR (real compiler output) ──")
  (let [t0 (now-us)
        lines (sl-lower-defn checksum-src)
        t1 (now-us)
        text (sl-ir-text "checksum" 2 lines)]
    (File/write "/tmp/j1_lowered.ir" text)
    (println (str "  checksum: ACCEPTED, " (count lines) " IR lines, lowered in " (- t1 t0) " µs (on the BEAM)"))
    (println "  IR:")
    (println text))

  (println "── 2. eligibility: each refusal names its decidable check ──")
  (println (str "  dot-product : " (try-lower "dot-product" dot-product-src)))
  (println (str "  parse-header: " (try-lower "parse-header" parse-header-src)))
  (println (str "  ackermann   : " (try-lower "ackermann" ackermann-src)))

  (println "── 3. L-BEAM baseline: measured by beam_baseline.bl — 135 ns/byte over the same")
  (println "    1 MiB LCG bytes, mod-2^59 oracle value 312648956560194084 == Rust exactly)")
)

(main)
