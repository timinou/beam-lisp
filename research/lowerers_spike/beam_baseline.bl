; beam-baseline.bl — L-BEAM: the SAME kernel, compiled by the shipped compiler
; to BEAM bytecode (running on BeamAsm), timed over the same byte buffer the
; JIT probe uses. The compiler compiles this file's defn through the normal
; path; (binary/at ...) resolves to :binary.at/2 like any remote call.

(ns beam-baseline)

; acc bounded to the BEAM smallint range (mod 2^59) so the baseline measures
; per-op machinery, not ever-growing bignums — matching the JIT kernel's u64
; wrapping in spirit; the value oracle is the mod-2^59 variant on the Rust side.
(defn checksum [buf n]
  (loop [i 0 acc 0]
    (if (< i n)
      (recur (+ i 1) (mod (+ (* 31 acc) (binary/at buf i)) 576460752303423488))
      acc)))

(def buf (second (File/read "/tmp/j1_buf_1m.bin")))
(def n (erlang/byte_size buf))

; warm (JIT + caches), then time one full pass
(checksum buf n)
(def t0 (erlang/monotonic_time :microsecond))
(def v (checksum buf n))
(def t1 (erlang/monotonic_time :microsecond))

(println (str "bl-on-BEAM checksum over " n " bytes: " (- t1 t0) " us ("
              (erlang/div (- t1 t0) n) " ns/byte)"))
(println (str "value: " v))
(File/write "/tmp/j1_bl_checksum.txt" (erlang/integer_to_binary v))
