; lowerers_spike/kernels.bl — the fragment kernels, written as ordinary beam-lisp.
;
; The SAME source feeds three lowerers:
;   L-BEAM  the shipped compiler (quoted → BEAM)        — runs in every bl process
;   L-IR    quoted → j1 IR (this spike's new lowerer)   — lower.bl
;   (the JIT that consumes the IR is j1_probe, unchanged)
;
; plus three ineligible defns — each must be REFUSED by a named, decidable check.

(defn checksum [buf n]
  (loop [i 0 acc 0]
    (if (< i n)
      (recur (+ i 1) (+ (* 31 acc) (binary/at buf i)))
      acc)))

; refused — :impure  (println is not a fragment primop)
(defn dot-product [xs ys n]
  (loop [i 0 acc 0]
    (if (< i n)
      (do (println "iter")
          (recur (+ i 1) (+ acc (* (nth xs i) (nth ys i)))))
      acc)))

; refused — :not-shrinking  (recur re-binds i to the whole buffer, no measure)
(defn parse-header [buf]
  (loop [i 0 acc 0]
    (if (< i 16)
      (recur buf (+ acc i))
      acc)))

; refused — :not-a-counted-loop  (two self recursive calls, no counted measure)
(defn ackermann [m n]
  (if (= m 0)
    (+ n 1)
    (if (= n 0)
      (ackermann (- m 1) 1)
      (ackermann (- m 1) (ackermann m (- n 1))))))
