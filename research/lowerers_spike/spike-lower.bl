; lowerers_spike/lower.bl — candidate lowerer L-IR:
;   the REAL compiler's quoted output → j1_probe's counted-loop IR.
;
; The ANF pass is FUSED into the walk: every argument position lowers to a
; fresh single-assignment temp in evaluation order — what bl-ANF would
; materialize as a separate stage. The loop is recognized by a generic
; structural search; every refusal names the decidable check that failed:
;
;   :impure              a call outside the fragment primops
;   :not-shrinking       recur does not advance the loop var by a literal
;   :not-a-counted-loop  no fn/if/self-re-applying-recur shape
;   :not-a-defn          not a defn at all

(ns spike-lower (:require [compiler :as c]))

(def kenv (assoc (c/new-env "user") :ns "user"))

(defn quoted-of [src]
  (c/compile (BeamLisp.Reader/read_one src) kenv))

;; ── node accessors ────────────────────────────────────────────────────────
;; compiler/compile returns bl-DATA: Elixir tuples are wrapped as
;; {:"{}" [] [k m args]}; the OUTERMOST node is a real 3-tuple.
;; parts gives logical [k m args] for both. Literals stay raw — callers
;; must test is_atom/is_number/is_binary before head/args*.

(defn node? [t n] (and (tuple? t) (= n (tuple-size t))))
(defn wrapped? [t]
  (and (node? t 3)
       (erlang/is_atom (elem t 0))
       (= "{}" (erlang/atom_to_binary (elem t 0)))))
(defn parts [t]
  (if (wrapped? t)
    (to-list (elem t 2))
    (if (node? t 3)
      (list (elem t 0) (elem t 1) (to-list (elem t 2)))
      (list nil nil nil))))
(defn head [t] (nth (parts t) 0))
(defn args* [t] (nth (parts t) 2))
(defn var-node? [t]
  (and (node? t 3)
       (let [p (parts t)]
         (and (erlang/is_atom (nth p 0))
              (erlang/is_list (nth p 2))
              (let [a (nth p 2)]
                (and (= 2 (count a)) (erlang/is_atom (second a)))))))
(defn dot-node? [h]
  (or (and (wrapped? h) (= :. (nth (to-list (elem h 2)) 0)))
      (and (node? h 3) (erlang/is_atom (elem h 0)) (= :. (elem h 0)))))
(defn call-node? [t] (and (node? t 3) (dot-node? (head t))))
(defn form? [t k] (and (node? t 3) (erlang/is_atom (head t)) (= k (head t))))
(defn kw [kvs k] (Keyword/get kvs k))
(defn var-name [t] (head t))

(defn zz1 [] 1)

(defn refuse [check why]
  (throw (ex-info (str "REFUSED " check ": " why) {:check check})))

;; ── generic structural search ─────────────────────────────────────────────

(defn kids [t]
  (cond
    (erlang/is_list t) (to-list t)
    (and (tuple? t) (= 3 (tuple-size t))) (to-list (elem t 2))
    :else nil))

(defn zz2 [] 2)

(defn find-first [pred t]
  (if (pred t) t
    (let [ks (kids t)]
      (if (nil? ks) nil
        (reduce (fn [f x] (if (nil? f) (find-first pred x) f)) nil ks)))))

;; ── def extraction ────────────────────────────────────────────────────────

(defn zz3 [] 3)

(defn fixed-of [a]
  (if (and (node? a 3)
           (erlang/is_atom (elem a 0))
           (= "{}" (erlang/atom_to_binary (elem a 0)))
           (erlang/is_list (elem a 2)))
    (let [as (to-list (elem a 2))]
      (if (and (= 4 (count as)) (= :fixed (first as))) (nth as 3) nil))
    nil))

(defn zz4 [] 4)

(defn def-of [q]
  (let [found
        (reduce (fn [f a]
                  (cond
                    (fixed-of a) (fixed-of a)
                    (erlang/is_list a)
                      (reduce (fn [f2 x] (if (fixed-of x) (fixed-of x) f2))
                              f (to-list a))
                    :else f))
                nil
                (to-list (args* q)))]
    (if (nil? found) (refuse :not-a-defn "no def emitted") nil)
    (let [pair (args* found)
          hd (first (to-list pair))
          kvs (second (to-list pair))
          params (first (args* hd))]
      {:params (to-list params) :body (kw kvs :do)})))

;; ── the loop recognizer ───────────────────────────────────────────────────

(defn self-applied-loop?
  "a call applying the loop var to itself, directly"
  [t loop-name]
  (and (var-node? (head t)) (= (var-name (head t)) loop-name)))

(defn partial-app-loop?
  "the callee is {. [. loop [] [loop]]} — the loop var threaded through
   the callee position by the compiler's partial-application scaffold"
  [t loop-name]
  (let [h (head t)]
    (if (not (wrapped? h))
      false
      (let [hin (to-list (elem h 2))]
        (if (not= :. (first hin))
          false
          (let [targs (to-list (nth hin 2))]
            (if (= 1 (count targs))
              (let [v (first targs)]
                (and (var-node? v) (= (var-name v) loop-name)))
              (let [x (first targs)]
                (and (call-node? x)
                     (var-node? (head x))
                     (= (var-name (head x)) loop-name))))))))))

(defn zz5 [] 5)

(defn loop-of [body]
  (let [fn1 (find-first (fn [t] (form? t :fn)) body)]
    (if (nil? fn1)
      (refuse :not-a-counted-loop "no loop fn")
      nil)
    (let [cl (first (args* fn1))
          loop-pats (to-list (first (args* cl)))
          inner (second (args* cl))]
      (if (or (not= 1 (count loop-pats)) (not (form? inner :fn)))
        (refuse :not-a-counted-loop "scaffold self-arg missing"))
      (let [loop-name (var-name (first loop-pats))
            cl2 (first (args* inner))
            vars (to-list (first (args* cl2)))
            ifx (second (args* cl2))]
        (if (not (form? ifx :if))
          (refuse :not-a-counted-loop "loop body is not an if"))
        (let [test (first (args* ifx))
              kvs (second (args* ifx))
              then (kw kvs :do)
              ret (kw kvs :else)
              recur-pred (fn [t]
                           (and (call-node? t)
                                (> (count (args* t)) 1)
                                (or (self-applied-loop? t loop-name)
                                    (partial-app-loop? t loop-name))))
              recur-node (find-first recur-pred then)]
          (if (nil? recur-node)
            (refuse :not-a-counted-loop "no recur re-applying the loop itself"))
          (let [bargs (args* body)
                nvars (count vars)
                inits (map (fn [i] (nth bargs i))
                           (range (- (count bargs) nvars) (count bargs)))]
            (if (< (count bargs) nvars)
              (refuse :not-a-counted-loop "init arity mismatch"))
            {:vars vars
             :inits (to-list inits)
             :test test
             :recur-args (to-list (args* recur-node))
             :ret ret})))))))

;; ── the lowering (ANF fused into the walk) ────────────────────────────────

(def stms (atom nil))
(def nvar (atom 0))

(defn fresh-var [] (let [v @nvar] (swap! nvar inc) v))
(defn emit! [line] (swap! stms conj line))

(defn var-of [env t]
  (let [ix (get (:syms env) (var-name t))]
    (if (nil? ix)
      (refuse :impure (str "unbound symbol " (var-name t)))
      ix)))

(defn zz6 [] 6)

(defn lower-arg! [env e]
  (cond
    (erlang/is_number e)
      (let [v (fresh-var)] (emit! (str "imm " v " " e)) v)
    (var-node? e) (var-of env e)
    (form? e :__block__)
      (reduce (fn [_ s] (lower-arg! env s)) nil (to-list (args* e)))
    (call-node? e)
      (let [tgt (if (wrapped? (head e))
                  (to-list (nth (to-list (elem (head e) 2)) 2))
                  (to-list (elem (head e) 2)))
            m (first tgt)
            f (second tgt)
            as (to-list (args* e))]
        (if (not= :erlang m)
          (refuse :impure "call is outside the fragment (erlang + - * < or binary/at only)"))
        (let [a (lower-arg! env (first as))
              b (lower-arg! env (second as))
              v (fresh-var)]
          (cond
            (= :+ f)
              (if (erlang/is_number b)
                (emit! (str "addimm " v " " a " " b))
                (emit! (str "add " v " " a " " b)))
            (= :* f) (emit! (str "mul " v " " a " " b))
            (= :-)   (emit! (str "sub " v " " a " " b))
            :else
              (refuse :impure
                (str "primop " (erlang/atom_to_binary f) " not in the fragment")))
          v))
    (form? e :apply)
      (let [call (second (to-list (args* e)))
            m (first (to-list call))
            f (second (to-list call))
            as (to-list (nth (to-list call) 2))]
        (if (and (= :binary m) (= :at f) (= 2 (count as)))
          (let [base (lower-arg! env (first as))
                off (lower-arg! env (second as))
                v (fresh-var)]
            (emit! (str "load " v " " base " " off))
            v)
          (refuse :impure "module call outside the fragment (only binary/at)")))
    :else (refuse :impure "expression form outside the fragment")))

(defn lower-loop! [env lp]
  (let [vars (:vars lp) inits (:inits lp) test (:test lp)
        recur-args (:recur-args lp) ret (:ret lp)
        n (count vars)
        lvars (to-list (map (fn [_] (fresh-var)) (range n)))]
    (if (not= n (count inits))
      (refuse :not-a-counted-loop "init arity mismatch"))
    (reduce (fn [_ i]
              (let [e (nth inits i)]
                (emit! (str "init " (nth lvars i) " "
                            (if (erlang/is_number e) e (var-of env e)))))
              nil)
            nil (range n))
    (let [targs (to-list (args* test))
          th (to-list (args* (head test)))]
      (if (not (and (call-node? test) (= 2 (count th))
                    (= :erlang (first th)) (= :< (second th))))
        (refuse :not-a-counted-loop "loop test is not a comparison"))
      (let [iv (var-of env (first targs))
            le (second targs)
            limit (if (var-node? le)
                    (var-of env le)
                    (let [v (fresh-var)] (emit! (str "init " v " " le)) v))]
        (if (not= iv (first lvars))
          (refuse :not-shrinking "loop test does not scrutinize the first loop var"))
        (let [i-arg (first recur-args)
              th2 (to-list (args* (head i-arg)))
              ia (to-list (args* i-arg))]
          (if (or (not (and (call-node? i-arg) (= 2 (count th2))
                            (= :erlang (first th2)) (= :+ (second th2))))
                  (not (var-node? (first ia)))
                  (not= iv (var-of env (first ia)))
                  (not (erlang/is_number (second ia))))
            (refuse :not-shrinking
              "recur does not advance the loop var by a literal (+ i k)"))
          (let [step (second ia)]
            (reduce (fn [_ j]
                      (let [lv (nth lvars (inc j))
                            v (lower-arg! env (nth recur-args (inc j)))]
                        (emit! (str "mov " lv " " v)))
                      nil)
                    nil (range (dec n)))
            (let [rv (lower-arg! env ret)]
              (list (str "loop " (first lvars) " " limit " " step)
                    (str "ret " rv)))))))))

(defn lower-defn [src]
  (reset! stms nil)
  (reset! nvar 0)
  (let [d (def-of (quoted-of src))
        np (count (:params d))
        env {:syms (reduce (fn [m i]
                             (assoc m (var-name (nth (:params d) i)) i))
                           {} (range np))}]
    (swap! nvar (fn [x] (max x np)))
    (let [lp (loop-of (:body d))
          tail (lower-loop! env lp)
          body-lines (reverse (to-list @stms))]
      (concat (to-list body-lines) tail))))

(defn ir-text [name nparams lines]
  (reduce (fn [a l] (str a l "\n"))
          (str "kernel " name " " nparams "\n")
          lines))
