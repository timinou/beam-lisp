; blend_harness.bl — end-to-end value equality for the STORE (pixel) kernel.
;
;   bl source ──lower2──▶ IR ──JIT(cranelift)──▶ native store loop
;        │                                            │
;        └── bl reference (the SAME defn, run on BEAM) ┘
;                        compare BYTES
;
; Proves the frame-rule store-kernel: `(conj out …)` over a fresh buffer lowers
; to an in-place native store whose output is BYTE-IDENTICAL to the BEAM run.

(ns blend-harness (:require [typed] [env]))
(env/eval (second (File/read "priv/lib/system/footprint.bl")))
(env/eval (second (File/read "priv/std/termination.bl")))
(env/eval (second (File/read "research/lowerers_spike/lower2.bl")))

; deterministic test bytes (a small LCG), N bytes
(defn gen-bytes [n seed]
  (loop [i 0 x seed acc []]
    (if (< i n)
      (let [x2 (rem (+ (* x 1103515245) 12345) 256)]
        (recur (+ i 1) x2 (conj acc x2)))
      acc)))

; bl reference blend: fresh out = (a*src + (255-a)*dst)/255, elementwise
(defn blend-ref [dst src n a]
  (loop [i 0 acc []]
    (if (< i n)
      (recur (+ i 1)
             (conj acc (quot (+ (* a (nth src i)) (* (- 255 a) (nth dst i))) 255)))
      acc)))

(defn main []
  (let [n 4096 a 170
        dst-bytes (gen-bytes n 7)
        src-bytes (gen-bytes n 99)
        dst-bin (erlang/list_to_binary (to-list dst-bytes))
        src-bin (erlang/list_to_binary (to-list src-bytes))]
    ; write input buffers for the JIT
    (File/write "/tmp/blend_dst.bin" dst-bin)
    (File/write "/tmp/blend_src.bin" src-bin)
    ; bl reference output bytes
    (let [ref (blend-ref dst-bytes src-bytes n a)
          ref-bin (erlang/list_to_binary (to-list ref))]
      (File/write "/tmp/blend_ref.bin" ref-bin)
      (println (str "bl reference: " n " bytes, first 8 = "
                    (into [] (map (fn [i] (nth ref i)) (range 8)))))
      ; lower the blend kernel to IR
      (let [k (lower2/lower-kernel lower2/blend-src)]
        (File/write "/tmp/blend.ir" (lower2/ir-text k))
        (println (str "lowered blend: [" (:kind k) "] " (count (:lines k)) " IR lines → /tmp/blend.ir"))
        (println (lower2/ir-text k))))))
(main)
