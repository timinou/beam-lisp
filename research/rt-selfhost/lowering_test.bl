(ns krt.lowering-test
  (:require [krt.emit :as emit] [krt.seq :as s]))

(defn- check [label ok]
  (when (not ok) (throw (ex-info (str "lowering assertion: " label) {}))))

(defn run [dir]
  (let [built (emit/install! dir)]
    (check "raw cons" (= (list 1 2) (Krt.Intrinsics/cons 1 (list 2))))
    (check "raw tuple" (= (tuple 1 2) (Krt.Intrinsics/tuple2 1 2)))
    (check "raw callback" (= 3 (Krt.Intrinsics/call2 (fn [a b] (erlang/+ a b)) 1 2)))
    (check "sentinel match" (Krt.Specialized/reduced? (reduced 7)))
    (check "sentinel rejects field lookalike" (not (Krt.Specialized/reduced? {:value 7})))
    (check "small tuple containing trie tag" (= 5 (Krt.Specialized/vector-count [:bl_vec 1 nil nil nil])))
    (check "small tuple with noninteger count" (= 5 (Krt.Specialized/vector-count [:bl_vec :x nil nil nil])))
    (check "empty head" (nil? (Krt.Intrinsics/list-first (list))))
    (check "head" (= 1 (Krt.Intrinsics/list-first (list 1 2))))
    (check "tail" (= (list 2) (Krt.Intrinsics/list-rest (list 1 2))))
    (check "known-vector rejects an unproven shape"
      (try (do (Krt.Specialized/vector-count {:items 2}) false) (catch _e true)))
    (doseq [n [0 1 31 32 33 1024 1025 4096]]
      (let [x (into [] (range n))]
        (check (str "vector count " n) (= n (Krt.Specialized/vector-count x)))
        (check (str "generic count " n) (= (s/k-count x) (Krt.Specialized/count x)))))
    (doseq [x [nil true 1 :kw "abc" (list) (list 1 2) {:a 1} #{1 2}]]
      (check "fallback count" (= (s/k-count x) (Krt.Specialized/count x))))
    (let [imports (:imports (:specialized built))]
      (check "no RT import" (not (some (fn [i] (= :Elixir.BeamLisp.RT (elem i 0))) imports))))
    (println "PASS lowering: raw constructors, shape-directed counts, fallback, deterministic beams")
    built))
