; Inspect saved evidence without rebuilding or rerunning measurements.
; FUSION_EVIDENCE=/tmp/rt-fusion.XXXXXX/summary.edn BL_NO_LOCK=1 bin/bl run .../report.bl
(ns fusion.report)
(def path (System/get_env "FUSION_EVIDENCE"))
(when (nil? path) (throw (ex-info "FUSION_EVIDENCE must name summary.edn" {})))
(def data (BeamLisp.Compiler/read_data (File/read! path)))
(when (not (:passed data)) (throw (ex-info "Evidence did not pass its gates" {})))
(defn median [xs] (let [sorted (into [] (sort xs))] (nth sorted (quot (count sorted) 2))))
(println "bytes | RT median us | BEAM median us [min,max] | port median us [min,max] | native inner us | BEAM/port | separated ranges?")
(doseq [row (:summary data)]
  (let [rt (get-in row [:variants :rt])
        beam (get-in row [:variants :beam])
        port (get-in row [:variants :native])]
    (println (str (:size row) " | " (/ (:median-ns rt) 1000.0)
                  " | " (/ (:median-ns beam) 1000.0) " [" (/ (:min-ns beam) 1000.0) "," (/ (:max-ns beam) 1000.0) "]"
                  " | " (/ (:median-ns port) 1000.0) " [" (/ (:min-ns port) 1000.0) "," (/ (:max-ns port) 1000.0) "]"
                  " | " (/ (:native-inner-median-ns row) 1000.0)
                  " | " (/ (:median-ns beam) (erlang/float (:median-ns port)))
                  " | " (< (:max-ns port) (:min-ns beam))))))
(println (str "startup-ns=" (pr-str (:startup-ns data))))
(println (str "counts=" (pr-str (:counts data)) " wire=" (pr-str (:wire-tests data))))
(println "bytes | adapter median ns | median reductions RT / BEAM / port")
(doseq [row (:summary data)]
  (let [n (:size row)
        adapter (median (map :ns (filter (fn [x] (= n (:size x))) (:adapters data))))
        reductions (mapv
                     (fn [v]
                       (median (map (fn [x] (quot (:reductions x) (:repeats x)))
                                    (filter (fn [x] (and (= n (:size x)) (= v (:variant x)))) (:samples data)))))
                     [:rt :beam :native])]
    (println (str n " | " adapter " | " (pr-str reductions)))))
(let [output (System/get_env "FUSION_REPORT_OUT")]
  (when output
    (File/write! output
      (pr-str (select-keys data [:passed :checks :check-counts :refusals :counts :startup-ns :summary :adapters :wire-tests :pipeline :fixtures])))))
:ok
