; build.bl — the standalone generator entry point.
;
;   FUSION_OUT=/tmp/fusion-out \
;     BL_NO_LOCK=1 bin/bl -p research/rt-selfhost/fusion run research/rt-selfhost/fusion/build.bl
;
; FUSION_OUT is REQUIRED: generation writes artifacts, and an implicit output
; directory is how a stale beam gets measured by mistake.
;
; pipeline.bl is loaded by PATH with `BeamLisp/run_file` (which pushes its own
; directory onto the load path and pops it again), then its `install!` is called.
; The file is loaded — not required by namespace — because its namespace
; (`fusion.pipeline`) lives one directory up from a path that also has to serve
; as the entry point's root; the AOT build resolves it by emitted module name,
; so the on-disk root and the namespace are allowed to differ here.
;
; There is NO top-level install in pipeline.bl on purpose: AOT-compiling that
; file for a driver runtime must not run the generator as a side effect of
; loading it.

(ns fusion.build)

(def output-dir
  (let [d (System/get_env "FUSION_OUT")]
    (when (or (nil? d) (erlang/== d ""))
      (throw (ex-info "FUSION_OUT is required (the directory to write the generated BEAM/Core/native IR into)"
                      {})))
    d))

(BeamLisp/run_file "research/rt-selfhost/fusion/pipeline.bl")

; run_file leaves its own namespace current; put OURS back so the bare
; `output-dir` below resolves to this namespace, not to fusion.pipeline.
(BeamLisp.Env/in_ns "fusion.build")

(def installed (fusion.pipeline/install! output-dir))

(println (str "PASS fusion build"
              " module=" (get installed :module)
              " beam=" (get installed :beam)
              " core=" (get installed :core)
              " ir=" (get installed :ir)
              " bytes=" (get installed :bytes)))
