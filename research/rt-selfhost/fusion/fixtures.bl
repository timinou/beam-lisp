; fixtures.bl — the ONE fixture oracle for the fused byte-fold prototype.
;
; WHERE THIS CAME FROM. The oracle, the deterministic random-byte generator,
; the fixture constructor, the size ladder and the 22-case fixture set were
; defined inside fusion/experiment.bl. They are not experiment-specific: the
; driver, the experiment, and the direct-entry benchmark (invm.bench) all need
; the same specification, so they live here once. experiment.bl keeps its
; original entry point (`BL_NO_LOCK=1 bin/bl run
; research/rt-selfhost/fusion/experiment.bl`) and calls THIS namespace; it no
; longer carries a second, drifting copy of the oracle.
;
; THE FRAGMENT (frozen; the machine-readable copy is
; fusion.pipeline/descriptor, which the generators read):
;
;     for each byte b of one immutable binary (len <= 1 MiB):
;         y = (3*b + 7) mod 256
;         keep y when y < 128
;         acc = (acc + kept y) mod 2^64
;     return acc, starting from the supplied initial accumulator.
;
; THE ORACLE IS INDEPENDENT ON PURPOSE. It computes the WORDS — "select the
; mapped bytes first, then sum with modulo" — with ordinary arithmetic and
; binary:at. It never reads the emitted text IR, the generated Core loop, the
; native kernel, or fusion.pipeline. So agreement between it and a lowering is
; evidence about the lowering; a copy of the lowering would be evidence about
; nothing.
;
; WHAT AGREEMENT IS NOT. Agreement on 22 inputs — empty, the 0/1/16/…/1 MiB
; ladder, all-accepted, all-rejected, all 256 byte values, the <128 threshold,
; u64 overflow, and u64-max initial — is not a safety certificate for arbitrary
; programs. It is the boundary of what was tested, nothing wider.

(ns fusion.fixtures)

;; ── the admitted fragment's own bounds ──────────────────────────────────────
;;
;; These are the fixture domain's constants, and callers (experiment.bl's wire
;; tests, invm.bench's refusal probes) read them FROM HERE rather than restating
;; them, so there is one number for "the cap" in the whole prototype.

(def MAX-BYTES 1048576)

(def U64 18446744073709551615)

(def sizes
  "The measured ladder, ascending: 0 bytes through the full 1 MiB cap, with the
   regular-NIF boundary (4096) and the first size past it (16384) both present."
  [0 1 16 64 256 1024 4096 16384 65536 262144 1048576])

;; ── the oracle ──────────────────────────────────────────────────────────────

(defn oracle
  "Independent specification: select mapped bytes first, then sum with modulo.
   Deliberately uses ordinary arithmetic, not the emitted IR or compiled mapper."
  [bin initial]
  (loop [i 0 total initial]
    (if (erlang/== i (erlang/byte_size bin)) total
      (let [mapped (rem (+ (* 3 (binary/at bin i)) 7) 256)]
        (recur (erlang/+ i 1)
               (if (< mapped 128) (rem (+ total mapped) 18446744073709551616) total))))))

;; ── deterministic fixture bytes ─────────────────────────────────────────────

(defn random-bytes [n]
  ; Fixed LCG: deterministic without relying on VM RNG version or mutable state.
  (erlang/list_to_binary
    (reverse
      (loop [i 0 state 20260921 bytes (list)]
        (if (erlang/== i n) bytes
          (let [next (erlang/band (erlang/+ (erlang/* state 1664525) 1013904223) 4294967295)
                byte (erlang/band (erlang/bsr next 16) 255)]
            (recur (erlang/+ i 1) next (cons byte bytes))))))))

(defn fixture
  "One case: {:tag :mode :binary :initial :expected}. `:expected` is computed by
   this namespace's oracle, so a caller never supplies it."
  [tag mode bin initial]
  {:tag tag :mode mode :binary bin :initial initial :expected (oracle bin initial)})

;; ── the 22 cases ────────────────────────────────────────────────────────────
;;
;; 11 :bench fixtures — the size ladder over one deterministic pseudo-random
;;    byte string, initial 0 — plus 11 :check fixtures that pin the boundaries:
;;    every byte value, all-accepted, all-rejected, the filter threshold, u64
;;    overflow, empty-with-max-initial, and the sub-chunk sizes 31/32/33/1025
;;    with a non-zero initial (17) so a dropped initial is visible.

(defn make
  "The 22 fixture maps, in the original order (bench ladder first, then the
   boundary cases). Returns a vector of
     {:tag string :mode :bench|:check :binary binary :initial u64 :expected u64}."
  []
  (let [bytes (random-bytes MAX-BYTES)
        measured (mapv (fn [n] (fixture (str "random-" n) :bench (binary/part bytes 0 n) 0)) sizes)
        cases [(fixture "all-byte-values" :check (erlang/list_to_binary (to-list (range 256))) 0)
               (fixture "all-rejected" :check (binary/copy (erlang/list_to_binary (list 41)) 4096) 0)
               (fixture "all-accepted" :check (binary/copy (erlang/list_to_binary (list 0)) 4096) 0)
               (fixture "threshold" :check (erlang/list_to_binary (list 40 211)) 0)
               (fixture "overflow" :check (erlang/list_to_binary (list 0 40 255)) (- U64 3))
               (fixture "empty-max-init" :check "" U64)
               (fixture "rejected-max-init" :check (erlang/list_to_binary (list 41 211)) U64)
               (fixture "random-31" :check (binary/part bytes 0 31) 17)
               (fixture "random-32" :check (binary/part bytes 0 32) 17)
               (fixture "random-33" :check (binary/part bytes 0 33) 17)
               (fixture "random-1025" :check (binary/part bytes 0 1025) (- U64 100))]]
    (into measured cases)))

;; ── views a timing matrix needs ─────────────────────────────────────────────

(defn fixture-size [f] (erlang/byte_size (:binary f)))

(defn bench-fixtures
  "The :bench fixtures, ascending by size — the timing matrix's rows."
  []
  (into [] (sort-by fixture-size (filterv (fn [f] (erlang/== :bench (:mode f))) (make)))))

(defn check-fixtures
  "The :check fixtures, in declared order — the correctness matrix's boundary
   rows (the :bench ones are checked too; every fixture is)."
  []
  (into [] (filterv (fn [f] (erlang/== :check (:mode f))) (make))))
