; traversal_test.bl — ASSERTING tests for the sequence/reduction traversal.
;
; Run (intrinsics must be loaded first — the orchestrator's run.bl installs
; `Krt.Intrinsics` via krt.emit before this file):
;
;   BL_NO_LOCK=1 bin/bl -p research/rt-selfhost run research/rt-selfhost/traversal_test.bl
;
; Every check either passes or counts a failure; a failure raises at the end,
; so the process exits nonzero. Nothing here prints a success count and calls
; it done (NATIVE-PLAN §5: the first harness printed rather than asserted).
;
; What is asserted:
;
;   * vector reduction at sizes 0, 1, 31, 32, 33, 1024, 1025 and larger —
;     exact sums, counts, and ordered output, plus differential agreement with
;     `BeamLisp.RT/reduce`;
;   * `reduced` early exit stops the fold with no extra callback (list, vector,
;     and lazy), and the halted value is returned unwrapped;
;   * EXACT lazy cell counts: `nth` forces i+1 cells, `take n` forces n cells,
;     `take 0`/negative-index force ZERO cells — including on an INFINITE lazy
;     seq (the first prototype looped forever on `(nth infinite i)`);
;   * negative and out-of-range indices answer nil without hanging;
;   * list emptiness is O(1) — a scaling check compares `first` on a 1000-element
;     list against a 200000-element list (the old `length`-based test is linear,
;     a ~200x ratio; the O(1) test stays near 1x).
;
; The harness also exports `run`, returning `{:checks n :failures m}`, for an
; in-process caller that has already installed the intrinsics.

(ns krt.traversal-test
  (:require [krt.kind :as k]
            [krt.seq :as s]
            [krt.reduce :as r]
            [krt.eq :as eq]))

;; ── counters (process dictionary: no runtime dependency) ───────────────────
(defn- put0! [key] (erlang/put key 0))
(defn- bump! [key] (erlang/put key (erlang/+ 1 (erlang/get key))))
(defn- cnt [key] (erlang/get key))

;; Counters exist from load, so a `check!` before `run` cannot hit `:undefined`.
(put0! :krt.fail)
(put0! :krt.checks)
(put0! :krt.cells)
(put0! :krt.calls)

(defn- check! [label ok]
  (bump! :krt.checks)
  (cond
    ok nil
    :else (do (bump! :krt.fail)
              (println (str "  FAIL " label)))))

(defn- check-eq! [label expected actual]
  (check! (str label " — expected " expected ", got " actual)
          (erlang/== expected actual)))

;; ── lazy instrumentation ───────────────────────────────────────────────────
; An INFINITE lazy seq, one cell per force, whose element value is the number
; of cells produced so far (1, 2, 3, …). Counting forces is then exact.
(defn- counted []
  (BeamLisp.LazySeq/from_fun
    (fn []
      (bump! :krt.cells)
      (Krt.Intrinsics/cons (cnt :krt.cells) (counted)))))

;; ── small helpers ──────────────────────────────────────────────────────────
(defn- vec [n] (into [] (range n)))
(defn- inc-step [acc _x] (erlang/+ acc 1))
(defn- sum-list
  "The fold result as a list, built by raw cons."
  [v]
  (r/k-reduce (fn [acc x] (Krt.Intrinsics/cons x acc)) (Krt.Intrinsics/empty) v))

(defn- triangular [n] (erlang// (erlang/* n (erlang/- n 1)) 2))

;; ── vector reduction ───────────────────────────────────────────────────────
(def sizes [0 1 31 32 33 1024 1025 4096 32768 100000])

(defn- test-vectors []
  (println "  vectors:")
  (doseq [n sizes]
    (let [v (vec n)
          tag (str "size " n)]
      (check-eq! (str tag " sum") (triangular n)
                 (r/k-reduce (fn [acc x] (erlang/+ acc x)) 0 v))
      (check-eq! (str tag " count") n (r/k-reduce inc-step 0 v))
      ;; Ordered output: a cons-fold yields the elements reversed, which must
      ;; equal the reversed eager list (`(into (list) (range n))` is reversed).
      (check-eq! (str tag " order") (into (list) (range n)) (sum-list v))
      ;; Differential: the representation-directed walk agrees with the
      ;; runtime's cell-based fold on the same step.
      (check-eq! (str tag " vs RT.reduce")
                 (BeamLisp.RT/reduce (fn [acc x] (Krt.Intrinsics/cons x acc))
                                     (Krt.Intrinsics/empty) v)
                 (sum-list v)))))

;; ── list reduction ─────────────────────────────────────────────────────────
(defn- test-lists []
  (println "  lists:")
  (check-eq! "empty list" 0 (r/k-reduce (fn [acc x] (erlang/+ acc x)) 0 (list)))
  (check-eq! "list sum" 6 (r/k-reduce (fn [acc x] (erlang/+ acc x)) 0 (list 1 2 3)))
  (check-eq! "list order" (list 3 2 1) (sum-list (list 1 2 3)))
  (check-eq! "non-collection is init" 42 (r/k-reduce (fn [acc x] (erlang/+ acc x)) 42 7))
  ;; seq API guarantees the rest of krt relies on.
  (check! "empty list is literal []" (erlang/== (Krt.Intrinsics/empty) (s/k-empty-list)))
  (check! "empty-list? true" (erlang/== true (s/k-empty? (list))))
  (check-eq! "k-cons" (list 0 1 2) (s/k-cons 0 (list 1 2)))
  (check-eq! "k-list-star" (list 0 1 2) (s/k-list-star 0 (list 1 2)))
  (check-eq! "k-splice" (list 2 3 4 5) (s/k-splice (list 2 3) (list 4 5)))
  (check-eq! "k-rest" (list 2 3) (s/k-rest (list 1 2 3)))
  (check-eq! "k-take list 2" (list 1 2) (s/k-take 2 (list 1 2 3)))
  (check! "k-take list 0 empty" (erlang/== (Krt.Intrinsics/empty) (s/k-take 0 (list 1 2 3))))
  (check-eq! "k-drop list 1" (list 2 3) (s/k-drop 1 (list 1 2 3)))
  (check-eq! "k-nth list 1" 2 (s/k-nth (list 1 2 3) 1)))

;; ── invalid indices (must not hang) ────────────────────────────────────────
(defn- test-invalid-indices []
  (println "  invalid indices:")
  (check! "nth list -1 -> nil" (erlang/== nil (s/k-nth (list 1 2 3) -1)))
  (check! "nth list 99 -> nil" (erlang/== nil (s/k-nth (list 1 2 3) 99)))
  (check! "nth vector -1 -> nil" (erlang/== nil (s/k-nth (vec 33) -1)))
  (check! "nth vector 33 -> nil" (erlang/== nil (s/k-nth (vec 33) 33)))
  (check! "nth vector 32 -> 32" (erlang/== 32 (s/k-nth (vec 33) 32)))
  (check! "nth vector 1024 -> 1024" (erlang/== 1024 (s/k-nth (vec 1025) 1024)))
  (check! "nth vector 1025 -> nil" (erlang/== nil (s/k-nth (vec 1025) 1025)))
  (check! "nth string 1 -> \"b\"" (erlang/== "b" (s/k-nth "abc" 1)))
  (check! "nth string -1 -> nil" (erlang/== nil (s/k-nth "abc" -1)))
  (check! "nth non-integer -> nil" (erlang/== nil (s/k-nth (list 1) :x)))
  (check! "nth tuple 99 -> nil" (erlang/== nil (s/k-nth (tuple 1 2) 99)))
  (check! "nth tuple 1 -> 2" (erlang/== 2 (s/k-nth (tuple 1 2) 1)))
  ;; Negative index on an INFINITE lazy seq must answer immediately.
  (put0! :krt.cells)
  (check! "nth infinite -3 -> nil" (erlang/== nil (s/k-nth (counted) -3)))
  (check-eq! "nth infinite -3 forces 0 cells" 0 (cnt :krt.cells)))

;; ── lazy: bounded observation, exact force counts ──────────────────────────
(defn- test-lazy []
  (println "  lazy (exact force counts):")
  (put0! :krt.cells)
  (check-eq! "nth infinite 5" 6 (s/k-nth (counted) 5))
  (check-eq! "nth infinite 5 forces i+1 cells" 6 (cnt :krt.cells))

  (put0! :krt.cells)
  (check-eq! "nth infinite 0" 1 (s/k-nth (counted) 0))
  (check-eq! "nth infinite 0 forces 1 cell" 1 (cnt :krt.cells))

  (put0! :krt.cells)
  (check! "take 0 infinite -> empty" (erlang/== (Krt.Intrinsics/empty) (s/k-take 0 (counted))))
  (check-eq! "take 0 forces no cell" 0 (cnt :krt.cells))

  (put0! :krt.cells)
  (check! "take -2 infinite -> empty" (erlang/== (Krt.Intrinsics/empty) (s/k-take -2 (counted))))
  (check-eq! "take -2 forces no cell" 0 (cnt :krt.cells))

  (put0! :krt.cells)
  (check-eq! "take 3 infinite" (list 1 2 3) (s/k-take 3 (counted)))
  (check-eq! "take 3 forces exactly 3 cells" 3 (cnt :krt.cells))

  (put0! :krt.cells)
  (check-eq! "first infinite" 1 (s/k-first (counted)))
  (check-eq! "first forces 1 cell" 1 (cnt :krt.cells))

  (put0! :krt.cells)
  (s/k-rest (counted))
  (check-eq! "rest forces 1 cell" 1 (cnt :krt.cells))

  ;; Finite lazy seq: bounded nth, out-of-range nil, no hang.
  (let [fl (map identity (list 10 20 30))]
    (check-eq! "finite lazy nth 1" 20 (s/k-nth fl 1))
    (check! "finite lazy nth 5 -> nil" (erlang/== nil (s/k-nth fl 5)))
    (check! "finite lazy nth 3 -> nil" (erlang/== nil (s/k-nth fl 3)))
    (check-eq! "finite lazy take 10" (list 10 20 30) (s/k-take 10 fl))
    (check! "finite lazy empty? false" (erlang/== false (s/k-empty? fl))))

  ;; A lazy seq that never produces a head: `first` must answer nil, not loop.
  (let [void (BeamLisp.LazySeq/from_fun (fn [] nil))]
    (check! "empty lazy first -> nil" (erlang/== nil (s/k-first void)))
    (check! "empty lazy nth 3 -> nil" (erlang/== nil (s/k-nth void 3)))
    (check! "empty lazy take 3 -> empty" (erlang/== (Krt.Intrinsics/empty) (s/k-take 3 void)))))

;; ── reduced early termination ──────────────────────────────────────────────
(defn- red-after
  "A raw 2-arity step that counts calls and returns `(reduced n)` at n."
  [n]
  (fn [acc _x]
    (bump! :krt.calls)
    (let [a (erlang/+ acc 1)]
      (cond
        (erlang/>= a n) (BeamLisp.RT/reduced a)
        :else a))))

(defn- test-reduced []
  (println "  reduced early exit:")
  (put0! :krt.calls)
  (let [out (r/k-reduce (red-after 5) 0 (vec 100000))]
    (check-eq! "vector reduced value" 5 out)
    (check-eq! "vector reduced calls (no extra)" 5 (cnt :krt.calls)))

  (put0! :krt.calls)
  (let [out (r/k-reduce (red-after 4) 0 (list 1 2 3 4 5 6 7))]
    (check-eq! "list reduced value" 4 out)
    (check-eq! "list reduced calls" 4 (cnt :krt.calls)))

  (put0! :krt.calls)
  (put0! :krt.cells)
  (let [out (r/k-reduce (red-after 4) 0 (counted))]
    (check-eq! "lazy reduced value" 4 out)
    (check-eq! "lazy reduced calls" 4 (cnt :krt.calls))
    (check-eq! "lazy reduced forces no extra cell" 4 (cnt :krt.cells)))

  ;; reduced on the FIRST element: exactly one callback, no further work.
  (put0! :krt.calls)
  (let [out (r/k-reduce (red-after 1) 0 (vec 100000))]
    (check-eq! "vector first-element reduced value" 1 out)
    (check-eq! "vector first-element reduced calls" 1 (cnt :krt.calls)))

  (put0! :krt.calls)
  (let [out (r/k-reduce (red-after 1) 0 (list 1 2 3 4))]
    (check-eq! "list first-element reduced value" 1 out)
    (check-eq! "list first-element reduced calls" 1 (cnt :krt.calls)))

  (put0! :krt.calls)
  (put0! :krt.cells)
  (let [out (r/k-reduce (red-after 1) 0 (counted))]
    (check-eq! "lazy first-element reduced value" 1 out)
    (check-eq! "lazy first-element reduced calls" 1 (cnt :krt.calls))
    (check-eq! "lazy first-element reduced forces 1 cell" 1 (cnt :krt.cells))))

;; ── map iteration ──────────────────────────────────────────────────────────
(defn- test-map []
  (println "  map:")
  (let [m {:a 1 :b 2 :c 3}]
    (check-eq! "map entry count" 3 (r/k-reduce inc-step 0 m))
    (check-eq! "map value sum" 6
               (r/k-reduce (fn [acc e] (erlang/+ acc (erlang/element 2 (erlang/map_get :items e)))) 0 m))
    ;; Entries are the same [k v] edge vectors the seq protocol yields, and the
    ;; direct iteration visits them in the same order as `k-seq`.
    (check-eq! "map direct order == k-seq order"
               (into (list) (s/k-to-list (s/k-seq m)))
               (sum-list m))
    (check! "map entry is a vector" (erlang/== :vector (k/kind (s/k-first m))))))

;; ── other kinds through the generic path ───────────────────────────────────
(defn- test-others []
  (println "  other kinds:")
  (check-eq! "set count" 3 (r/k-reduce inc-step 0 #{1 2 3}))
  (check-eq! "tuple count" 3 (r/k-reduce inc-step 0 (tuple 1 2 3)))
  (check-eq! "text fold" "abc" (r/k-reduce (fn [acc x] (str acc x)) "" "abc")))

(defrecord TraversalRecord [y x])

(defn- test-cons-record []
  (println "  review regressions: cons tails and record extension fields:")
  (check-eq! "cons nil is singleton" (list 1) (s/k-cons 1 nil))
  (check-eq! "cons vector traverses elements" (list 1 2 3) (s/k-to-list (s/k-cons 1 [2 3])))
  (let [chain (s/k-cons 1 (map identity [2 3]))]
    (check-eq! "cons lazy tail count" 3 (s/k-count chain))
    (check-eq! "generated count preserves lazy tail" 3 (Krt.Specialized/count chain))
    (check-eq! "cons lazy tail nth" 3 (s/k-nth chain 2))
    (check-eq! "cons lazy tail reduce" 6 (r/k-reduce (fn [a x] (erlang/+ a x)) 0 chain)))
  (put0! :krt.cells)
  (let [chain (s/k-cons 0 (counted))]
    (check-eq! "cons does not force" 0 (cnt :krt.cells))
    (check-eq! "cons infinite tail nth" 3 (s/k-nth chain 3))
    (check-eq! "cons infinite tail prefix bound" 3 (cnt :krt.cells)))
  (put0! :krt.cells)
  (check-eq! "unequal infinite comparison terminates" -1
    (eq/k-compare (s/k-cons 0 (counted)) (counted)))
  (check-eq! "unequal infinite comparison forces one cell" 1 (cnt :krt.cells))
  (let [record (assoc (->TraversalRecord 1 2) :z 9)]
    (check-eq! "record includes extension count" 3 (s/k-count record))
    (check-eq! "record seq includes extension" {:x 2 :y 1 :z 9} (into {} (s/k-to-list record)))
    (check-eq! "record reduction includes extension" 3 (r/k-reduce inc-step 0 record))))

;; ── O(1) list emptiness (scaling) ──────────────────────────────────────────
(defn- best-us [reps n f]
  (loop [i 0 best nil]
    (cond
      (erlang/>= i reps) best
      :else
      (let [t0 (erlang/monotonic_time :microsecond)]
        (loop [j 0]
          (cond (erlang/>= j n) nil
                :else (do (f) (recur (erlang/+ j 1)))))
        (let [dt (erlang/- (erlang/monotonic_time :microsecond) t0)]
          (recur (erlang/+ i 1)
                 (cond (erlang/== best nil) dt
                       (erlang/< dt best) dt
                       :else best)))))))

(defn- test-emptiness []
  (println "  list emptiness scaling:")
  (let [small (into (list) (range 1000))
        big (into (list) (range 200000))]
    (check! "big list not empty" (erlang/== false (s/k-empty? big)))
    (check-eq! "big list first" 199999 (s/k-first big))
    (check-eq! "big list rest" (into (list) (range 199999)) (s/k-rest big))
    (let [t-small (best-us 3 500 (fn [] (s/k-first small)))
          t-big (best-us 3 500 (fn [] (s/k-first big)))
          ratio (cond (erlang/== t-small 0) 0
                      :else (erlang// t-big t-small))]
      (println (str "    first(1000)=" t-small "us  first(200000)=" t-big
                    "us  ratio=" ratio))
      ; Timing is diagnostic, not a correctness assertion on a shared host.
      (println "    timing diagnostic only; shape/behavior assertions are the gate"))))

;; ── run ────────────────────────────────────────────────────────────────────
(defn run []
  (put0! :krt.fail)
  (put0! :krt.checks)
  (put0! :krt.cells)
  (put0! :krt.calls)
  (println "== krt.traversal-test: representation-directed traversal ==")
  (test-vectors)
  (test-lists)
  (test-invalid-indices)
  (test-lazy)
  (test-reduced)
  (test-map)
  (test-others)
  (test-cons-record)
  (test-emptiness)
  (let [summary {:checks (cnt :krt.checks) :failures (cnt :krt.fail)}]
    (println (str "checks: " (:checks summary) "  failures: " (:failures summary)))
    summary))

(def summary (run))

(cond
  (erlang/> (erlang/get :krt.fail) 0)
  (erlang/error (str "krt.traversal-test: " (erlang/get :krt.fail) " assertion failure(s)"))
  :else nil)
