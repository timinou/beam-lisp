; Research loader: reuse vm.native/declare, including BL-owned host synthesis.
; A private scratch OTP application supplies priv/native without modifying the
; project's native install directory or introducing a second NIF loader.
(ns invm.host (:require [vm.native :as native]))

(def signatures
  [["kernel-compile" 1] ["kernel-call" 3] ["kernel-call-dirty" 3]
   ["kernel-close" 1] ["kernel-stats" 0]
   ["kernel-noop" 2] ["kernel-noop-dirty" 2]])
(def application-name :fusion_host_probe)
(def namespace-name "fusion.invm")
(def crate-name "j1_nif")

(defn- assert! [label ok]
  (when (not ok) (throw (ex-info (str "NIF loader: " label) {}))))

(defn load! [root shared-library]
  (let [app-root (str root "/fusion_host_probe-0.1.0")
        ebin (str app-root "/ebin")
        natives (str app-root "/priv/native")
        spec (tuple :application application-name
               (list (tuple :description (erlang/binary_to_list "BL direct native experiment"))
                     (tuple :vsn (erlang/binary_to_list "0.1.0"))
                     (tuple :modules (list))
                     (tuple :applications (list :kernel :stdlib))))]
    (File/mkdir_p! ebin)
    (File/mkdir_p! natives)
    (File/cp! shared-library (str natives "/j1_nif.so"))
    (File/write! (str ebin "/fusion_host_probe.app")
      (erlang/iolist_to_binary (io_lib/format (erlang/binary_to_list "~p.~n") (list spec))))
    (assert! "private app ebin path" (erlang/== true (code/add_patha (erlang/binary_to_list ebin))))
    (let [loaded (application/load application-name)]
      (assert! "application load" (or (= :ok loaded) (= (tuple :error (tuple :already_loaded application-name)) loaded))))
    (assert! "existing loader selects private artifact"
      (= (str natives "/j1_nif") (native/lib-path crate-name)))
    (native/declare namespace-name crate-name (to-list signatures))
    (assert! "NIF is available" (native/available? namespace-name))
    {:module (native/host-module namespace-name)
     :library (native/lib-path crate-name) :app-root app-root}))

(defn stats
  "Stable BL diagnostic shape over the native host's counters. Never used as
   an operation in the timed kernel path."
  []
  (erlang/apply (native/host-module namespace-name) :kernel_stats (list)))

(defn probe-reload!
  "Probe ONLY the scratch host module, and only in a disposable VM. Returns
   the loader outcome; this is not an application hot-upgrade policy."
  []
  (assert! "purge is restricted to the dedicated reload child"
           (= "reload" (System/get_env "INVM_MODE")))
  (let [module (native/host-module namespace-name)
        purged (code/soft_purge module)]
    (assert! "old host code must not be executing" purged)
    (let [deleted (code/delete module)]
      (assert! "scratch host module deletion" deleted)
      (assert! "scratch host old-code purge" (code/soft_purge module))
      (try
        (do (native/declare namespace-name crate-name (to-list signatures))
            {:available (native/available? namespace-name) :module module})
        (catch e {:available false :error (ex-message e)})))))
