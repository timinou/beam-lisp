; All experiment policy/orchestration is BL. Child VMs isolate native loading,
; lifecycle and hot-code probes from each other and from the build process.
(ns invm.experiment)
(def root (File/cwd!))
(def work
  (let [r (System/cmd "mktemp" (list "-d" "/tmp/rt-invm.XXXXXX"))]
    (when (not= 0 (elem r 1)) (throw (ex-info "Private scratch directory failed" {})))
    (String/trim (elem r 0))))
(println (str "invm work: " work))

(defn command! [program args filename extra-env allow-failure]
  (let [exe (if (String/contains? program "/") (Path/expand program root) program)
        env (concat (list (tuple "CARGO_TARGET_DIR" (str work "/cargo-target"))
                          (tuple "BL_NO_LOCK" "1")) extra-env)
        started (erlang/monotonic_time :nanosecond)
        _ (println (str "RUN " exe " " (pr-str args)))
        result (System/cmd exe (to-list args)
                 (list (tuple :cd root) (tuple :env (to-list env)) (tuple :stderr_to_stdout true)))
        elapsed (erlang/- (erlang/monotonic_time :nanosecond) started)
        log (str work "/" filename)]
    (File/write! log (str "$ " exe " " (pr-str args) "\nexit=" (elem result 1)
                         " wall_ns=" elapsed "\n" (elem result 0)))
    (when (and (not allow-failure) (not= 0 (elem result 1)))
      (throw (ex-info (str "Command failed; log=" log) {:exit (elem result 1)})))
    {:exit (elem result 1) :wall-ns elapsed :log log}))

(defn child! [mode scheduler-options allow-failure]
  (let [output (str work "/" mode ".edn")
        vars (list (tuple "INVM_WORK" work)
                   (tuple "INVM_SO" (str work "/cargo-target/release/libj1_nif.so"))
                   (tuple "INVM_IR" (str work "/generated/pipeline.ir"))
                   (tuple "INVM_PORT" (str work "/cargo-target/release/j1_probe"))
                   (tuple "INVM_MODE" mode)
                   (tuple "INVM_OUTPUT" output))
        vars (if scheduler-options
               (cons (tuple "ELIXIR_ERL_OPTIONS" scheduler-options) vars) vars)
        result (command! "bin/bl"
                 ["-p" "research/rt-selfhost" "run" "research/rt-selfhost/invm/child.bl"]
                 (str mode ".log") vars allow-failure)]
    (if (= 0 (:exit result))
      (do (when (not (File/exists? output))
            (throw (ex-info "Child exited without its evidence" {:mode mode})))
          (assoc result :result (BeamLisp.Compiler/read_data (File/read! output))))
      (assoc result :result {:completed false :mode mode :reason :child-failed}))))

(BeamLisp/run_file "research/rt-selfhost/fusion/pipeline.bl")
(ns invm.experiment)

(defn main []
  (fusion.pipeline/install! (str work "/generated"))
  (command! "cargo" ["test" "--release" "--manifest-path" "research/j1_probe/Cargo.toml"]
            "kernel-tests.log" (list) false)
  (command! "cargo" ["build" "--release" "--manifest-path" "research/j1_probe/Cargo.toml"]
            "port-build.log" (list) false)
  (command! "cargo" ["test" "--release" "--manifest-path" "research/j1_nif/Cargo.toml"]
            "nif-tests.log" (list) false)
  (command! "cargo" ["build" "--release" "--manifest-path" "research/j1_nif/Cargo.toml"]
            "nif-build.log" (list) false)
  (let [bench (child! "bench" nil false)
        lifecycle (child! "lifecycle" nil false)
        stress (child! "stress" "+S 1:1 +SDcpu 1:1 +SDio 2 +sbwt none +sbwtdcpu none +sbwtdio none" false)
        ; Reload/purge is exploratory, in its own VM. Failure is evidence, not
        ; permission to claim hot-upgrade safety or to abort unrelated receipts.
        versions (child! "versions" nil false)
        reload (child! "reload" nil true)
        result {:work work :bench bench :lifecycle lifecycle :stress stress :versions versions :reload reload
                :native-library (str work "/cargo-target/release/libj1_nif.so")}]
    (File/write! (str work "/summary.edn") (pr-str result))
    (println (str "RESULTS " work "/summary.edn"))
    (println (str "reload-supported=" (get-in result [:reload :result :preserved])))
    :ok))

(main)
