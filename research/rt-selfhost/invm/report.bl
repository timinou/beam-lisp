; Read existing evidence, never rebuild or rerun the timed experiment.
; INVM_EVIDENCE=/tmp/rt-invm.XXXXXX [INVM_SAVE=research/rt-selfhost/invm/evidence]
;   BL_NO_LOCK=1 bin/bl run research/rt-selfhost/invm/report.bl
(ns invm.report)
(def directory (or (System/get_env "INVM_EVIDENCE")
                  (throw (ex-info "INVM_EVIDENCE must name the result directory" {}))))
(defn read-result [name] (BeamLisp.Compiler/read_data (File/read! (str directory "/" name ".edn"))))
(def bench (read-result "bench"))
(def lifecycle (read-result "lifecycle"))
(def stress (read-result "stress"))
(def reload (read-result (if (File/exists? (str directory "/reload-gc.edn")) "reload-gc" "reload")))
(def versions (if (File/exists? (str directory "/versions.edn")) (read-result "versions") nil))
(when (and versions (not (:passed versions)))
  (throw (ex-info "Kernel version isolation did not pass" {})))
(when (not (and (:passed bench) (:passed lifecycle) (:passed stress)))
  (throw (ex-info "A required gate did not pass" {})))

(defn timing [row variant]
  (let [v (get-in row [:variants variant])]
    (if (:median-ns v)
      (str (/ (:median-ns v) 1000.0) " [" (/ (:min-ns v) 1000.0) "," (/ (:max-ns v) 1000.0) "]")
      "refused")))
(println "bytes | BEAM us [min,max] | port us | regular us | dirty us | regular noop us | dirty noop us | BL floor us")
(doseq [row (:summary bench)]
  (println (str (:size row) " | " (timing row :beam) " | " (timing row :port)
                " | " (timing row :nif) " | " (timing row :nif-dirty)
                " | " (timing row :noop) " | " (timing row :noop-dirty)
                " | " (timing row :bl-noop))))
(println (str "cold-compile-ns=" (pr-str (:cold-ns bench))))
(println (str "resource-gates=" (pr-str (:stats-checks bench))))
(println (str "bench-counts=" (pr-str (:counts bench))))
(println (str "lifecycle=" (pr-str lifecycle)))
(println (str "reload=" (pr-str reload)))
(println (str "versions=" (pr-str versions)))
(println (str "stress-environment=" (pr-str (:env stress))))
(println (str "heartbeat-baseline=" (pr-str (:baseline stress))))
(println (str "contention=" (pr-str (:contention stress))))

(let [out (System/get_env "INVM_SAVE")]
  (when out
    (File/mkdir_p! out)
    (doseq [name ["bench.edn" "lifecycle.edn" "stress.edn" "reload.edn"
                 "bench.log" "lifecycle.log" "stress.log" "reload.log"
                 "kernel-tests.log" "nif-tests.log"]]
      (File/cp! (str directory "/" name) (str out "/" name)))
    (when versions
      (File/cp! (str directory "/versions.edn") (str out "/versions.edn")))
    (when (File/exists? (str directory "/reload-gc.edn"))
      (File/cp! (str directory "/reload-gc.edn") (str out "/reload-gc.edn")))
    (File/cp! (str directory "/generated/pipeline.ir") (str out "/pipeline.ir"))
    (File/write! (str out "/compact.edn")
      (pr-str {:bench (select-keys bench [:passed :checks :cold-ns :port-startup :summary :stats-checks :counts :limits])
               :lifecycle lifecycle :stress stress :reload reload :versions versions}))))
:ok
