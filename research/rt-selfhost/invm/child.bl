; Disposable VM entry point. The parent supplies paths and the experiment mode.
; No Elixir wrapper is involved in loading, exercising, or unloading the NIF.
(ns invm.child)
(defn required [name]
  (or (System/get_env name) (throw (ex-info (str "Missing " name) {}))))
(def work (required "INVM_WORK"))
(def shared-library (required "INVM_SO"))
(def ir-path (required "INVM_IR"))
(def port-exe (required "INVM_PORT"))
(def mode (required "INVM_MODE"))
(def output (required "INVM_OUTPUT"))

(BeamLisp/run_file "research/rt-selfhost/invm/host.bl")
(invm.host/load! invm.child/work invm.child/shared-library)
(BeamLisp/run_file "research/rt-selfhost/fusion/pipeline.bl")
(fusion.pipeline/install! (str invm.child/work "/generated"))
(BeamLisp/run_file "research/rt-selfhost/fusion/driver.bl")
(BeamLisp/run_file "research/rt-selfhost/fusion/fixtures.bl")
(ns invm.child)

(defn reload-probe []
  (let [ir (File/read! ir-path)
        handle (fusion.invm/kernel-compile ir)
        bin (erlang/list_to_binary (list 0 40 255))
        before (fusion.invm/kernel-call handle bin 0)
        baseline (invm.host/stats)
        outcome (invm.host/probe-reload!)
        after (try {:value (fusion.invm/kernel-call handle bin 0)}
                   (catch e {:error (ex-message e)}))
        close (try {:value (fusion.invm/kernel-close handle)}
                   (catch e {:error (ex-message e)}))]
    (when (not= 138 before) (throw (ex-info "Reload precondition arithmetic failed" {})))
    {:completed true :before before :stats-before baseline :reload outcome
     :after after :close close
     :preserved (and (:available outcome) (= 138 (:value after)))}))

(defn versions-probe []
  (let [ir (File/read! ir-path)
        changed (String/replace ir "\nimm 5 3\n" "\nimm 5 5\n")
        _ (when (= ir changed) (throw (ex-info "Version probe did not change the IR" {})))
        old (fusion.invm/kernel-compile ir)
        new (fusion.invm/kernel-compile changed)
        bytes (erlang/list_to_binary (list 0 40 255))]
    (try
      (let [a (fusion.invm/kernel-call old bytes 0)
            b (fusion.invm/kernel-call new bytes 0)
            _ (when (not (and (= 138 a) (= 9 b)))
                (throw (ex-info "Independent kernel versions disagree with their references" {:old a :new b})))
            closed-new (fusion.invm/kernel-close new)
            still-old (fusion.invm/kernel-call old bytes 0)
            _ (when (not (and closed-new (= 138 still-old)))
                (throw (ex-info "Closing the replacement affected the old version" {})))]
        {:passed true :old a :new b :old-after-new-close still-old
         :host-module-stayed-loaded true})
      (finally (fusion.invm/kernel-close old) (fusion.invm/kernel-close new)))))

; Load before compiling calls to these namespaces. A run_file inside the same
; def/cond form cannot retroactively change already-resolved call targets.
(BeamLisp/run_file "research/rt-selfhost/invm/bench.bl")
(BeamLisp/run_file "research/rt-selfhost/invm/lifecycle.bl")
(BeamLisp/run_file "research/rt-selfhost/invm/stress.bl")
(ns invm.child)

(def result
  (cond
    (= mode "bench")
    (invm.bench/run port-exe ir-path)
    (= mode "lifecycle")
    (invm.lifecycle/run ir-path)
    (= mode "stress")
    (invm.stress/run ir-path)
    (= mode "versions") (versions-probe)
    (= mode "reload") (reload-probe)
    :else (throw (ex-info "Unknown child mode" {:mode mode}))))

; The old handle is no longer reachable after reload-probe returns. Distinguish
; handle compatibility from eventual cleanup of the pinned old code.
(def final-result
  (if (= "reload" mode)
    (do (erlang/garbage_collect)
        (assoc result :stats-after-gc (invm.host/stats)))
    result))

; run_file changes the current namespace; retain explicit names for the sink.
(File/write! invm.child/output (pr-str invm.child/final-result))
(println (str "PASS child " invm.child/mode " -> " invm.child/output))
:ok
