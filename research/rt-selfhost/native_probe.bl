; native_probe.bl — P3 differential probe: the BEAM (compiled) side.
;
; WHAT THIS IS FOR. The P3 experiment compares ONE kernel, on the SAME bytes,
; between
;
;   (a) the live standalone Cranelift probe run over the lowered IR
;       (research/j1_probe, `--run-ir`), and
;   (b) this file COMPILED AOT TO BEAM and invoked as a real module function
;       with an inspectable emitted module. Current `bl run` also compiles
;       through compiler/eval_form -> lower/eval-anf, not the tree interpreter.
;
; The baseline must be compiled BEAM or the comparison is meaningless: the old
; offload harness measured the JIT against an INTERPRETED loop and reported a
; 440–800x "speedup".
;
; SEMANTICS. acc = (acc*31 + byte) mod 2^64 over bin[0..n), byte for byte the
; Cranelift i64 kernel in j1_probe (`acc*31 + byte` with wrapping i64 mul/add).
; BL integers are arbitrary precision, so the mod-2^64 mask is EXPLICIT and
; load-bearing. The earlier beam_baseline.bl wrapped at 2^59 to "stay in the
; BEAM smallint range" — that is a DIFFERENT value oracle and does not match
; the native kernel; this probe pins the u64 contract and proves it by agreeing
; with the probe's own rust-reference checksum (see NATIVE-EXPERIMENT.md).
;
; This is a research prototype. It is not wired into anything, it is not the
; production equality/numeric policy, and agreeing on these fixtures is not a
; safety certificate.

(ns native_probe)

(defn checksum
  "acc = (acc*31 + byte) mod 2^64 over bin[0..n). u64 semantics, exactly."
  [bin n]
  (loop [i 0 acc 0]
    (if (< i n)
      (recur (+ i 1)
             (erlang/band (+ (* 31 acc) (binary/at bin i)) 18446744073709551615))
      acc)))

(defn now-us [] (erlang/monotonic_time :microsecond))

(defn run-file
  "Read `path`, warm once, then take the best of 3 timed passes. Prints ONE
   machine-parsable line and returns the checksum.

   The mask literal is inlined rather than read from a `def` on purpose: a
   namespace global would compile to `BeamLisp.Env.fetch!/2` inside the timed
   function, adding a runtime-registry lookup per call that has nothing to do
   with the kernel."
  [path]
  (let [bin (File/read! path)
        n (erlang/byte_size bin)]
    (checksum bin n)                       ; warm (caches + first-call effects)
    (loop [r 0 best nil v 0]
      (if (>= r 3)
        (do (println (str "BL-COMPILED path=" path " n=" n
                          " value=" v " best_us=" best))
            v)
        (let [t0 (now-us)
              v2 (checksum bin n)
              t1 (now-us)
              dt (- t1 t0)]
          (recur (+ r 1)
                 (if (nil? best) dt (if (< dt best) dt best))
                 v2))))))

(defn main [paths]
  (reduce (fn [acc p] (do (run-file p) acc)) nil paths))
