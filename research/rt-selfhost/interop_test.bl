; Computed and bound apply argument lists have the same interop semantics.
; maps:from_list requires a list of TUPLES, not a list of two-element lists.
(ns krt.interop-test)

(defn- computed [entries]
  (erlang/apply :maps :from_list (list entries)))

(defn- bound [entries]
  (let [args (list entries)] (erlang/apply :maps :from_list args)))

(defn- check! [label ok]
  (when (not ok) (throw (ex-info (str "interop assertion: " label) {}))))

(let [entries (list (tuple :a 1) (tuple :b 2))
      expected {:a 1 :b 2}]
  (check! "computed args" (= expected (computed entries)))
  (check! "bound args" (= expected (bound entries)))
  (check! "inline nested expression"
    (= expected (erlang/apply :maps :from_list (list (list (tuple :a 1) (tuple :b 2))))))
  (check! "malformed list entries are rejected"
    (try (do (computed (list (erlang/tuple_to_list (tuple :a 1)))) false)
         (catch _ true))))
(println "PASS interop: computed/bound/inline args agree; malformed entries refused")
:ok
