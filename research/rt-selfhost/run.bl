; Run from repository root:
; BL_NO_LOCK=1 bin/bl -p research/rt-selfhost run research/rt-selfhost/run.bl
(ns krt.run (:require [krt.emit :as emit]))
(def output-dir (or (System/get_env "KRT_OUT") "/tmp/rt-selfhost-execution"))
(emit/install! output-dir)
(BeamLisp/run_file "research/rt-selfhost/lowering_test.bl")
(krt.lowering-test/run krt.run/output-dir)
(BeamLisp/run_file "research/rt-selfhost/interop_test.bl")
(BeamLisp/run_file "research/rt-selfhost/semantic_test.bl")
(BeamLisp/run_file "research/rt-selfhost/traversal_test.bl")
(println (str "PASS integrated prototype; generated evidence: " krt.run/output-dir))
