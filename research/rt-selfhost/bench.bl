; Run after correctness gates. Every row is one sample, not a best-of summary.
(ns krt.bench-v2
  (:require [krt.emit :as emit]))

(emit/install! (or (System/get_env "KRT_OUT") "/tmp/rt-selfhost-execution"))
(ns krt.bench-v2 (:require [krt.seq :as s] [krt.reduce :as r]))
(def sample-file (str (or (System/get_env "KRT_OUT") "/tmp/rt-selfhost-execution") "/bench-samples.edn"))
(File/write! sample-file "")

(defn- proc [key] (elem (erlang/process_info (erlang/self) key) 1))
(defn- clock [] (erlang/monotonic_time :nanosecond))
(defn- plus [a b] (erlang/+ a b))

(defn- generic-sum [xs]
  (loop [acc 0 ys (s/k-seq xs)]
    (if (erlang/== ys nil) acc
      (recur (erlang/+ acc (s/k-first ys)) (s/k-next ys)))))

(defn- sample [label n round repeats expected f]
  (erlang/garbage_collect)
  (let [mem0 (proc :memory)
        red0 (proc :reductions)
        gc0 (erlang/statistics :garbage_collection)
        start (clock)
        result (loop [i 0 checksum 0]
                 (if (erlang/== i repeats) checksum
                   (recur (erlang/+ i 1) (erlang/+ checksum (f)))))
        elapsed (erlang/- (clock) start)
        red1 (proc :reductions)
        mem1 (proc :memory)
        gc1 (erlang/statistics :garbage_collection)]
    (when (not= result (erlang/* repeats expected))
      (throw (ex-info "Benchmark result mismatch" {:label label :n n :result result :expected expected})))
    (erlang/garbage_collect)
    (let [row {:operation label :n n :round round :repeats repeats :ns elapsed
                     :checksum result :reductions (erlang/- red1 red0)
                     :memory-before mem0 :memory-after mem1 :memory-after-gc (proc :memory)
                     :vm-gcs (erlang/- (elem gc1 0) (elem gc0 0))
                     :vm-reclaimed-words (erlang/- (elem gc1 1) (elem gc0 1))}]
      (println (pr-str row))
      (File/write! sample-file (str (pr-str row) "\n") (list :append)))))

(println "; GC counters are VM-wide; memory snapshots are not peak-allocation measurements.")
(println "; Samples include callback/loop harness; baseline rows expose that overhead.")
(doseq [n [32 1024 8192 32768]]
  (let [xs (into [] (range n))
        expected (quot (* n (dec n)) 2)
        variants [["harness" (fn [] expected)]
                  ["core-reduce-vector" (fn [] (reduce plus 0 xs))]
                  ["rt-reduce-vector" (fn [] (BeamLisp.RT/reduce plus 0 xs))]
                  ["generic-seq-vector" (fn [] (generic-sum xs))]
                  ["leaf-reduce-vector" (fn [] (r/k-reduce plus 0 xs))]]]
    (doseq [[label f] variants] (f))
    (doseq [round (range 5)]
      (doseq [[label f] (if (even? round) variants (reverse variants))]
        (sample label n round 1 expected f)))))

(let [xs (into [] (range 1025))
      variants [["count-harness" (fn [] 1025)]
                ["count-rt" (fn [] (BeamLisp.RT/count xs))]
                ["count-krt" (fn [] (s/k-count xs))]
                ["count-generated" (fn [] (Krt.Specialized/count xs))]
                ["count-known-vector" (fn [] (Krt.Specialized/vector-count xs))]]]
  (doseq [[label f] variants] (f))
  (doseq [round (range 5)]
    (doseq [[label f] (if (even? round) variants (reverse variants))]
      (sample label 1025 round 100000 1025 f))))
(println "PASS benchmark result checks")
