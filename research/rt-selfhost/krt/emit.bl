; Research-only consumer of the shipped ANF/Core backend. Generated code has
; no runtime dependency on the compiler that constructs its descriptor.
(ns krt.emit
  (:require [anf :as a] [lower :as lower]))

(defn- clause [name params guard body]
  {:op :defn-clause :fname name :params params :guard guard :body body :ann {}})

(defn- v [name] (a/var name))
(defn- p [name] (a/pvar name))
(defn- bif [name args] (a/remote :erlang name args))

(defn intrinsics []
  (a/module :Elixir.Krt.Intrinsics
    [(clause :cons [(p "h") (p "t")] nil (a/cons-cell (v "h") (v "t")))
     (clause :empty [] nil a/enil)
     (clause :call2 [(p "f") (p "a") (p "b")] nil (a/app (v "f") [(v "a") (v "b")]))
     (clause :tuple2 [(p "a") (p "b")] nil (a/tup [(v "a") (v "b")]))
     (clause :tuple3 [(p "a") (p "b") (p "c")] nil (a/tup [(v "a") (v "b") (v "c")]))
     (clause :list-first [a/pnil] nil (a/lit nil))
     (clause :list-first [(a/pcons (p "h") (p "t"))] nil (v "h"))
     (clause :list-rest [a/pnil] nil a/enil)
     (clause :list-rest [(a/pcons (p "h") (p "t"))] nil (v "t"))]
    [[:cons 2] [:empty 0] [:call2 3] [:tuple2 2] [:tuple3 3] [:list-first 1] [:list-rest 1]] []))

(defn- representation-module [kind]
  (BeamLisp.Loader/ensure_loaded "krt.kind")
  (let [representations (BeamLisp.Env/fetch! "krt.kind" "representations")
        descriptor (first (filter (fn [d] (= kind (:kind d))) representations))]
    (when (nil? descriptor) (throw (ex-info "Missing representation" {:kind kind})))
    (:module descriptor)))

(defn- vector-count-body []
  (a/casee (v "items")
    [(a/clause [(a/ptuple [(a/plit :bl_vec) (p "cnt") (p "shift") (p "root") (p "tail")])]
       (bif :and [(bif :is_integer [(v "cnt")]) (bif :> [(v "cnt") (a/lit 32)])]) (v "cnt"))
     (a/clause [(p "small")] (bif :is_tuple [(v "small")]) (bif :tuple_size [(v "small")]))]))

(defn- vector-clause [name]
  (clause name [(a/pstruct (representation-module :vector) [[:items (p "items")]])]
    nil (vector-count-body)))

(defn- fallback [name]
  (clause name [(p "x")] nil (a/remote :Elixir.BeamLisp.Ns.Krt.Seq :k-count [(v "x")])))

(defn specialized
  "Both exports consume the same vector representation description. The known
   path requires a valid vector and contains no classifier or fallback. The generic path directly handles common
   representations and preserves the BL fallback for everything else."
  []
  (a/module :Elixir.Krt.Specialized
    [(clause :reduced? [(a/pstruct (representation-module :reduced) [])] nil (a/lit true))
     (clause :reduced? [(p "x")] nil (a/lit false))
     (vector-clause :vector-count)
     (clause :count [a/pnil] nil (a/lit 0))
     (clause :count [(a/palias (p "xs") (a/pcons (p "h") (p "t")))] nil
       (a/remote :Elixir.BeamLisp.Ns.Krt.Seq :k-count [(v "xs")]))
     (vector-clause :count)
     (clause :count [(p "m")]
       (bif :and [(bif :is_map [(v "m")]) (bif :not [(bif :is_map_key [(a/lit :__struct__) (v "m")])])])
       (bif :map_size [(v "m")]))
     (fallback :count)]
    [[:vector-count 1] [:count 1] [:reduced? 1]] []))

(defn imports [beam]
  (let [result (beam_lib/chunks beam (list :imports))]
    (when (not= :ok (elem result 0)) (throw (ex-info "Cannot inspect imports" {:result result})))
    (elem (first (elem (elem result 1) 1)) 1)))

(defn build!
  "Compile, retain the exact binary, write its Core/descriptor evidence and
   load it. Rebuilding identical descriptors must reproduce the beam."
  [descriptor dir]
  (let [built (try (lower/descriptor->beam descriptor)
                  (catch e (do (println (pr-str (ex-data e))) (throw e))))
        module (elem built 0)
        beam (elem built 1)
        again (elem (lower/descriptor->beam descriptor) 1)
        path (lower/write-beam! dir module beam)]
    (when (not= beam again) (throw (ex-info "Non-deterministic Core generation" {:module module})))
    (File/write! (str path ".core") (erlang/iolist_to_binary (core_pp/format (lower/module->core descriptor))))
    (File/write! (str path ".anf.edn") (pr-str descriptor))
    (File/write! (str path ".imports.edn") (pr-str (imports beam)))
    (let [loaded (code/load_binary module (erlang/binary_to_list path) beam)]
      (when (not= loaded (tuple :module module))
        (throw (ex-info "Core load failed" {:result loaded}))))
    {:module module :beam beam :imports (imports beam) :path path}))

(defn install! [dir]
  (File/mkdir_p! dir)
  (File/write! (str dir "/code-paths.etf") (erlang/term_to_binary (code/get_path)))
  (let [base (build! (intrinsics) dir)
        fast (build! (specialized) dir)]
    (when (some (fn [i] (= :Elixir.BeamLisp.RT (elem i 0))) (:imports base))
      (throw (ex-info "Intrinsic module depends on RT" {:imports (:imports base)})))
    {:intrinsics base :specialized fast}))
