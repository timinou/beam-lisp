; A disposable-process, SUBSET generation experiment. Not a bootstrap of the
; compiler or a claim that all 57 RT imports have been replaced.
(ns krt.bootstrap-probe
  (:require [krt.emit :as emit]))

(def dir (or (System/get_env "KRT_OUT") "/tmp/rt-selfhost-execution"))
(def before (emit/install! (str dir "/generation-a")))
(BeamLisp.Loader/ensure_loaded "krt.seq")

(defn- retarget! [core-name kernel-name]
  (let [link (BeamLisp.Env/link "krt.seq" kernel-name)]
    (when (not= :ok (elem link 0)) (throw (ex-info "Kernel link missing" {:name kernel-name})))
    (BeamLisp.Env/put_link "core" core-name (elem link 1))
    (BeamLisp.Env/intern "core" core-name (BeamLisp.Env/fetch! "krt.seq" kernel-name))))

(doseq [[old new] [["first" "k-first"] ["rest" "k-rest"] ["next" "k-next"]
                   ["seq" "k-seq"] ["count" "k-count"] ["nth" "k-nth"]]]
  (retarget! old new))

; Recompile the generator source after replacing both the static links and
; dynamic var values in this process. Existing compiler beams retain old links.
(BeamLisp/run_file "research/rt-selfhost/krt/emit.bl")
(ns krt.bootstrap-probe (:require [krt.emit :as emit]))
(def after (emit/install! (str dir "/generation-b")))
(doseq [key [:intrinsics :specialized]]
  (when (not= (:beam (get before key)) (:beam (get after key)))
    (throw (ex-info "Subset generation changed" {:module key}))))
(println "PASS subset fixpoint: generator recompiled under six krt core links; two generated beams byte-identical")
(println "NOT a toolchain bootstrap: existing compiler/storage beams retain RT edges; remaining boot surface is not implemented")
