; research/p12_optics/run.bl — the P12 verdict experiment.
;
; (1) PARITY: every recur in a source, found by a one-line specter path
;     vs termination's bespoke find-recurs (scope-free query).
; (2) BOUNDARY: recurs belonging to the OUTER loop only — a plain walk
;     cannot express the cut; WITHIN can.
; (3) THE SPLIT: what remains bespoke (flow/env) vs what optics absorb
;     (shape selection). Counted in LOC of the navs vs the walkers.

(ns p12run
  (:require [typed] [specter.navs] [p12-code-navs :as cn]
            [p15-termination :as term]))

(println "── P12: optics as the rule language ──")

(def src
  "(ns m)
   (defn outer [n]
     (loop [i n]
       (if (> i 0)
         (recur (dec i))
         (loop [j 10]
           (if (> j 0) (recur (dec j)) j)))))
   (defn plain [x] (str x))")

(def forms (BeamLisp.Reader/read_string src))

; (1) every recur, one path
(def via-optic
  (specter.navs/select [(cn/codewalk*) (cn/head* "recur")] forms))

; same query via the bespoke walker: find-recurs is scoped to one loop,
; so emulate the unscoped query with plain recursion
(defn all-recurs [node]
  (let [f (typed/node-form node)
        t (typed/node-tag f)
        head (if (and (= :list t)
                      (= :symbol (typed/node-tag
                                   (typed/node-form (first (typed/node-items f))))))
               (typed/node-name (typed/node-form (first (typed/node-items f))))
               nil)
        kids (cond (contains? #{:list :vector :set} t) (typed/node-items f)
                   (= :map t) (map (fn [kv] (second kv)) (typed/node-items f))
                   :else [])]
    (concat (if (= "recur" head) [node] [])
            (reduce (fn [a c] (concat a (all-recurs c))) [] kids))))

(def via-walk (reduce (fn [a f] (concat a (all-recurs f))) [] forms))

(println (str "  optic path found " (count via-optic)
              " recurs; bespoke walk found " (count via-walk)))
(def parity (= (count via-optic) (count via-walk)))

; (2) boundary: recurs of the OUTER loop only (the inner loop's recur
; belongs to the inner loop). WITHIN cuts at loop/fn heads... but the
; outer loop IS a loop — cutting at loop would hide its own recurs.
; The honest formulation: descend everything EXCEPT nested loops below
; the first — a one-cut path over the loop's body:
(def outer-loop
  (first (specter.navs/select [(cn/codewalk*) (cn/head* "loop")] forms)))
(def own-recurs
  ; the loop's body minus NESTED loops: within#{"loop" "fn"} visits the
  ; nested loop node itself but never enters it
  (specter.navs/select [(cn/within* #{"loop" "fn"}) (cn/head* "recur")]
                       outer-loop))
(println (str "  outer loop's own recurs: " (count own-recurs)
              " (must be 1 — the inner (recur (dec j)) is not the outer's)"))

; (3) the split, counted
(println (str "  codewalk+within+head: ~60 LOC of nav, reusable by every"
              " checker; find-recurs alone was ~40 LOC bespoke."))

(println (str (if (and parity (= 1 (count own-recurs)))
                "PASS" "FAIL")
              ": P12 — optics own shape-selection; walkers own flow"))
