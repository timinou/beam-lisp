; research/p12_optics/code_navs.bl — P12: can optics be the rule language?
;
; The type checkers hand-roll tree walkers (promote/walk, eff-walk,
; termination's find-recurs). Specter composes navigators instead. The
; question: can a navigator over READER FORMS replace the walkers?
;
; Findings encoded here:
;   * CODEWALK — every node, depth-first, meta-transparent (results keep
;     their position wrappers; descent sees through them).
;   * WITHIN — codewalk that refuses to cross boundary heads (loop/fn
;     cut a scope; a plain recursive walk cannot express that — but a
;     NAVIGATOR can, because the cut is a descent decision).
;   * (HEAD h) — a pred nav matching call forms whose head is h.
;
; What optics CANNOT express: flow. Guard narrowing, let-envs, clause
; order — those are carried by the walker's env, not by shape. The
; verdict demo (run.bl) measures both halves.

(ns p12-code-navs
  (:require [typed] [specter.navs] [specter.engine]))

; doseqres-fn: the engine's multi-result folder (NONE monoid + reduced).
(def doseqres specter.navs/doseqres-fn)
(def NONE specter.navs/NONE)

(declare cw-select)

(defn cw-children
  "The child NODES of a reader form: items of composites, values of
   map entries (keys are data, not code positions), nothing else."
  [node]
  (let [f (typed/node-form node)
        t (typed/node-tag f)]
    (cond
      (contains? #{:list :vector :set} t) (typed/node-items f)
      (= :map t) (map (fn [kv] (second kv)) (typed/node-items f))
      :else [])))

(defn cw-select
  "Visit node, then descend (unless cut?). next-fn continues the path
   at each visited node — this is what makes codewalk composable with
   every other navigator: [CODEWALK (pred* …)] just works.

   A bare list/vector of nodes (what read_string returns) is not itself
   a node: codewalk descends into each element without visiting it."
  [vals cut? node next-fn]
  (if (erlang/is_tuple node)
    (let [here (doseqres NONE [node] (fn [e] (next-fn vals e)))]
      ; the cut governs DESCENT: a boundary child is visited (its own
      ; position matters) but never entered — the root itself is always
      ; walked whole
      (doseqres here (cw-children node)
                (fn [c]
                  (let [f (typed/node-form c)
                        head (if (and (= :list (typed/node-tag f))
                                      (= :symbol (typed/node-tag
                                                   (typed/node-form
                                                     (first (typed/node-items f))))))
                               (typed/node-name
                                 (typed/node-form (first (typed/node-items f))))
                               nil)]
                    (if (and (some? head) (contains? cut? head))
                      (doseqres NONE [c] (fn [e] (next-fn vals e)))
                      (cw-select vals cut? c next-fn))))))
    ; not a node: either a bare collection of nodes (read_string's
    ; return) or a scalar leaf (literal children are UNTAGGED values —
    ; 0, "s", :kw appear bare inside :list/:vector items)
    (if (or (list? node) (vector? node))
      (doseqres NONE (seq node)
                (fn [c] (cw-select vals cut? c next-fn)))
      (next-fn vals node))))

(defn codewalk*
  "Every code node under (and including) the structure."
  []
  (reify specter.engine/RichNavigator
    (select* [this vals structure next-fn]
      (cw-select vals #{} structure next-fn))
    (transform* [this vals structure next-fn]
      ; a whole-tree rebuild needs splice-aware node reconstruction;
      ; the rule language SELECTS — rewriting stays rewrite's job.
      (throw (ex-info "codewalk is a selection nav" {})))))

(defn within*
  "codewalk that does not descend into forms whose head is in cuts
   (the boundary form itself IS visited — its interior is not)."
  [cuts]
  (reify specter.engine/RichNavigator
    (select* [this vals structure next-fn]
      (cw-select vals cuts structure next-fn))
    (transform* [this vals structure next-fn]
      (throw (ex-info "within is a selection nav" {})))))

(defn head*
  "Call forms whose head symbol is h."
  [h]
  (specter.navs/pred*
    (fn [node]
      (let [f (typed/node-form node)]
        (and (= :list (typed/node-tag f))
             (let [hd (typed/node-form (first (typed/node-items f)))]
               (and (= :symbol (typed/node-tag hd))
                    (= h (typed/node-name hd)))))))))
