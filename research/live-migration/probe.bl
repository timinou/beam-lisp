(ns research.live-migration.probe (:require [datom :as d] [datom.migrate :as m] [datom.store-fjall :as fjall]))
(def c (d/connect-with (fjall/open (str (System/get_env "LIVE_MIGRATION_ROOT") "/probe"))
 [{:db/ident :item/id :db/valueType :db.type/long :db/unique :db.unique/identity}
  {:db/ident :item/ready :db/valueType :db.type/boolean}]))
(d/transact! c (mapv (fn [n] {:db/id (- 0 (+ n 1)) :item/id n}) (range 500)))
(def query '[:find ?e :where [?e :item/id _] [:not [?e :item/ready true]]])
(def spec {:migration/id :probe/fill :migration/digest (join "" (repeat 64 "a"))})
(doseq [i (range 27)]
 (let [t (erlang/monotonic_time :millisecond) rows (d/q query (d/db c))]
  (println "BEFORE" i "pending" (count rows) "ms" (- (erlang/monotonic_time :millisecond) t))
  (println "STEP" (m/step! c spec (fn [db]
     (let [rows (vec (take 20 (d/q query db)))]
      [(mapv (fn [r] [:db/add (first r) :item/ready true]) rows) (= 20 (count rows))]))))))
(d/close! c)
