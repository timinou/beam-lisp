(ns research.live-migration.baseline
 (:require [reload] [env] [datom :as d] [datom.migrate :as m]))
(let [e (env/fork) old (reload/reload-enabled?)]
 (try
  (reload/set-enabled! true)
  (reload/abort)
  (reload/with-target e
   (fn []
    (reload/stage "(ns live.baseline.fixture) (defn value [] 1)")
    (reload/attach {:id :must-wait :strategy :quiesce :modules ["busy"] :mailbox-count (fn [_] 10)})
    (println (str "BASELINE busy-attached-migration=" (name (:status (reload/commit)))))))
  (finally (reload/abort) (reload/set-enabled! nil) (env/destroy e))))
(let [c (d/connect [{:db/ident :x/id :db/valueType :db.type/string}])
      one {:migration/id :same :migration/grows [] :migration/checks []}
      two (assoc one :migration/fn (fn [_] [{:db/id -1 :x/id "changed"}]))]
 (m/apply! c one)
 (println (str "BASELINE changed-migration-id=" (name (:status (m/apply! c two))))))
