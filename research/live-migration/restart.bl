(ns research.live-migration.restart
 (:require [datom :as d] [datom.migrate :as m] [datom.store-fjall :as fjall]))
(def c (d/connect-with (fjall/open (str (System/get_env "LIVE_MIGRATION_ROOT") "/restart"))
         [{:db/ident :item/id :db/valueType :db.type/long :db/unique :db.unique/identity}]))
(def digest (join "" (repeat 64 "a")))
(def expand {:migration/id :restart/expand :migration/digest digest
             :migration/grows [{:db/ident :item/ready :db/valueType :db.type/boolean}]})
(def fill {:migration/id :restart/fill :migration/digest digest :migration/grows [] :migration/checks []})
(defn done [] (count (d/q '[:find ?e :where [?e :item/ready true]] (d/db c))))
(def mode (first (BeamLisp/argv)))
(when (= mode "crash")
 (d/transact! c (mapv (fn [n] {:db/id (- 0 (+ n 1)) :item/id n}) (range 200))))
(def before (done))
(def expansion (m/apply! c expand))
(when (= mode "resume")
 (let [changed (m/step! c (assoc fill :migration/digest (join "" (repeat 64 "b")))
                       (fn [_] (throw (ex-info "Changed partial implementation ran" {}))))]
  (when-not (= :identity-conflict (:status changed))
   (throw (ex-info "Partial restart identity failed" changed)))))
(def result
 (m/apply-batched! c fill
  (fn [db]
   (when (and (= mode "crash") (= 60 (done)))
    (println "CRASH after 60 durable backfill rows; completion ledger absent")
    (erlang/halt 137))
   (let [rows (vec (take 20 (d/q '[:find ?e :where [?e :item/id _] [:not [?e :item/ready true]]] db)))]
    [(mapv (fn [r] [:db/add (first r) :item/ready true]) rows) (= 20 (count rows))]))))
(when-not (and (= before 60) (= :already-applied (:status expansion))
              (= :applied (:status result)) (= 200 (done)))
 (throw (ex-info "Restart invariants failed" {:before before :expanded (:status expansion) :after (done)})))
(def repeated (m/apply-batched! c fill (fn [_] (throw (ex-info "already finished" {})))))
(def conflict (m/apply! c (assoc fill :migration/digest (join "" (repeat 64 "b")))))
(when-not (and (= :already-applied (:status repeated)) (= :identity-conflict (:status conflict)))
 (throw (ex-info "Restart ledger identity failed" {})))
(println (Jason/encode! {"resumedFromRows" before "completedRows" (done)
                        "expansionReplayed" true "completionReplayed" true "changedDigestRefused" true}))
