; research/p13c_datalog_checker/checker.bl — the codebase as a database.
;
; Question under test: can structural type-checker rules be expressed as
; datom datalog over facts extracted from beam-lisp source — concise,
; declarative, and goal-directed — rather than as a procedural pass?
;
; The fact model, one entity per top-level form and per call site:
;
;   [?d :fn/name "double"]   [?d :fn/arity 2]      ; a defn
;   [?c :call/caller "main"] [?c :call/callee "double"] [?c :call/arity 1]
;
; Facts are extracted by WALKING quoted forms (the reader's output shape).
; Checker rules are then QUERIES. Negation (`:not` clauses, stratified)
; does the "no matching definition exists" half; recursive rules do the
; call-graph half.
;
; Run: mix beam_lisp.run --path priv --path research/p13c_datalog_checker \
;        research/p13c_datalog_checker/checker.bl

(ns p13c.checker
  (:require [datom]))

; ── a tiny codebase, as reader-output-shaped data ─────────────────────
; (The bridge from Reader/read_string is mechanical — FormMeta unwrap +
; this same walk. Quoted literals here ARE the reader's output shape.)

(def SOURCE
  '((defn double [x] (* 2 x))
    (defn add2 [a b] (+ a b))
    (defn greet [name] (str "hi " name))
    (defn main []
      (println (double 5))            ; arity ok
      (println (double 5 6))          ; WRONG ARITY — 2 given, 1 defined
      (println (add2 1 2))            ; ok
      (println (greet))               ; WRONG ARITY — 0 given, 1 defined
      (println (watzit 3)))))         ; UNKNOWN CALLEE

; ── fact extraction: forms → datom tx-data ────────────────────────────
; Defns get entity ids 1..; call sites get 1000+ (nested calls included).

(def CORE-FNS
  "Callees to treat as always-defined for this spike (a real checker
   resolves these against the core env)."
  #{"println" "str" "+" "-" "*" "/" "not" "get" "first" "rest" "cons"})

(defn walk-calls
  "Every (sym …) call form in `form`, as {:caller :callee :arity}."
  [caller form acc]
  (if (list? form)
    (let [head (first form)]
      (if (symbol? head)
        (reduce (fn [a sub] (walk-calls caller sub a))
                (conj acc {:caller (str caller)
                           :callee (str head)
                           :arity (count (rest form))})
                (rest form))
        (reduce (fn [a sub] (walk-calls caller sub a)) acc (rest form))))
    acc))

(defn extract-facts [forms]
  (loop [forms forms, d 1, c 1000, acc []]
    (if (empty? forms)
      acc
      (let [form (first forms)]
        (if (and (list? form) (= (first form) 'defn))
          (let [name (second form)
                arity (count (nth form 2))
                calls (reduce (fn [a body] (walk-calls name body a))
                              [] (drop 3 form))
                call-facts (map-indexed
                             (fn [i call]
                               {:db/id (+ c i)
                                :call/caller (:caller call)
                                :call/callee (:callee call)
                                :call/arity (:arity call)})
                             calls)]
            (recur (rest forms) (+ d 1) (+ c (count calls))
                   (into (conj acc {:db/id d :fn/name (str name)
                                    :fn/arity arity})
                         call-facts)))
          (recur (rest forms) d c acc))))))

; ── load the codebase into datom ──────────────────────────────────────

(def SCHEMA
  [{:db/ident :fn/name     :db/valueType :db.type/string}
   {:db/ident :fn/arity    :db/valueType :db.type/long}
   {:db/ident :call/caller :db/valueType :db.type/string}
   {:db/ident :call/callee :db/valueType :db.type/string}
   {:db/ident :call/arity  :db/valueType :db.type/long}])

(def conn (datom/connect SCHEMA))
(datom/transact! conn (extract-facts SOURCE))
(def db (datom/db conn))

(defn show [l v] (println (str "  " l ": " (pr-str v))))

(println "── P13c: the codebase as a database ──")

; ── check 1: arity mismatch — a call whose callee is defined, but at no
; matching arity. :not-join names the vars bound OUTSIDE (?callee, ?n);
; ?d2 is existentially quantified inside: "no defn has BOTH". ────────────

(println "\ncheck 1: arity mismatches")
(show "calls"
  (sort (into []
    (datom/q '[:find ?caller ?callee ?n
               :where
               [?c :call/caller ?caller]
               [?c :call/callee ?callee]
               [?c :call/arity ?n]
               [?d :fn/name ?callee]
               [:not-join [?callee ?n] [?d2 :fn/name ?callee] [?d2 :fn/arity ?n]]]
             db))))

; ── check 2: unknown callees — never defn'd, not core ─────────────────

(println "\ncheck 2: unknown callees")
(show "calls"
  (sort (into []
    (datom/q '[:find ?caller ?callee
               :in $ ?core
               :where
               [?c :call/caller ?caller]
               [?c :call/callee ?callee]
               [:not-join [?callee] [?d :fn/name ?callee]]
               [(not (contains? ?core ?callee))]]
             db CORE-FNS))))

; ── check 3: call-graph reachability from main — the recursive rule ────

(println "\ncheck 3: fns transitively reachable from main")

(def REACH
  '[[(calls ?from ?to) [?c :call/caller ?from] [?c :call/callee ?to]]
    [(reaches ?a ?b) (calls ?a ?b)]
    [(reaches ?a ?b) (calls ?a ?x) (reaches ?x ?b)]])

(show "reachable"
  (sort (into []
    (datom/q '[:find ?to :in $ % :where (reaches "main" ?to)]
             db REACH))))
