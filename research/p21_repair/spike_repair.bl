; research/p21_repair/spike_repair.bl
; ══════════════════════════════════════════════════════════════════════════
; P21 SYNTHESIS/REPAIR — the checker run backwards.
;
; The inference phase built a RELATION, not a one-way checker. abduce already
; SYNTHESIZES a sufficient precondition that closes the Hoare triple
;   Inv ∧ G ∧ (s2 = next) ⊢ Inv(s2)
; Point it at a BROKEN transition and the sufficient G it returns IS the repair.
; This spike takes a bank withdraw with NO balance guard — which verify-process
; would reject — and synthesizes the guard that fixes it, then CHECKS the fix by
; re-running the forward obligation.
; ══════════════════════════════════════════════════════════════════════════

(ns p21.spike-repair
  (:require [system.core :as sys] [z3]))

(def port (z3/open))

; the broken machine's essentials (state var balance, invariant balance ≥ 0):
;   withdraw amt  →  next (- balance amt)   with NO guard   ← the bug
(def svar "balance")
(def inv (fn [v] (str "(>= " v " 0)")))
(def decls (str "(declare-const balance Int)\n(declare-const amt Int)\n"))
(def next-expr "(- balance amt)")
(def domain (list "balance" "amt" "0"))

(println "── P21: repair — synthesize the guard a broken transition needs ──\n")

; is the UNGUARDED transition broken? (sufficient? with guard=nil)
(def broken? (not (sys/sufficient? port inv svar decls nil next-expr "true")))
(println "unguarded withdraw preserves (>= balance 0)?" (not broken?)
         "  ← false = broken, needs repair")

; SYNTHESIZE: abduce the sufficient + fireable guards, shortest (weakest) first.
(def repairs (sys/abduce port inv svar decls nil next-expr domain))
(println "\nsynthesized guards (weakest first):")
(doseq [g (take 4 repairs)] (println "   " g))

; the repair:
(def fix (first repairs))
(println "\nchosen repair:" fix)

; CHECK the fix forward: with the synthesized guard, is the transition preserved?
(def fixed? (sys/sufficient? port inv svar decls fix next-expr "true"))
(println "with the repair, withdraw preserves the invariant?" fixed?
         "  ← the backward-synthesized guard, checked forward")

; and it is FIREABLE (doesn't trivially forbid the transition):
(println "the repair is fireable (not vacuous)?"
         (sys/fireable? port inv svar decls fix "true"))

(println "\n── the point ──")
(println "abduce runs the preservation query BACKWARDS: instead of 'does this")
(println "guard work?' it asks 'what guard would?'. The weakest sufficient +")
(println "fireable candidate is the repair — (>= balance amt) — and the FORWARD")
(println "checker confirms it. Synthesize backward, verify forward: program")
(println "repair for free, because the checker was always a relation.")
:ok
