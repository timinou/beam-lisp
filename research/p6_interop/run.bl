; research/p6_interop/run.bl — P6: does a ~50-entry seed table recover
; the 90% case? Measure: evidence entries whose type is still `any`,
; with and without the seed tables, over real interop-heavy source.

(ns p6run
  (:require [typed]))

(def files
  [["/home/user/code/undefine/beam-lisp--type-inference/examples/interop.bl" "interop"]
   ["/home/user/code/undefine/spell/apps/interface/src/interface/seam.bl" "interface.seam"]])

(defn measure [path ns seeds]
  (reset! typed/warnings [])
  (reset! typed/evidence {})
  (let [src (second (File/read path))
        r   (typed/check-source-with src ns seeds)
        ev  (:evidence r)
        n   (count ev)
        n-any (count (filter (fn [[_ ty]] (= ty typed/all-tags)) ev))]
    {:any n-any :total n :warnings (:warnings r)}))

(println "── P6: seed-table coverage ──")
(doall
  (map (fn [[path ns]]
         (let [bare (measure path ns {})
               full (measure path ns (merge typed/core-seeds-v2 typed/host-seeds))]
           (println (str "  " ns))
           (println (str "    bare:  " (:any bare) "/" (:total bare)
                         " evidence entries still any, "
                         (count (:warnings bare)) " warnings"))
           (println (str "    seeds: " (:any full) "/" (:total full)
                         " still any, "
                         (count (:warnings full)) " warnings"))))
       files))

(def seam-bare (measure "/home/user/code/undefine/spell/apps/interface/src/interface/seam.bl" "interface.seam" {}))
(def seam-full (measure "/home/user/code/undefine/spell/apps/interface/src/interface/seam.bl" "interface.seam" (merge typed/core-seeds-v2 typed/host-seeds)))

(println (str (if (and (< (:any seam-full) (:any seam-bare))
                       (= 0 (count (:warnings seam-full))))
                "PASS" "FAIL")
              ": seeds shrink any-propagation, zero new warnings on clean code"))
