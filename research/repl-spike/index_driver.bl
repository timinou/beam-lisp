; index_driver.bl — hermetic lifecycle check for vm.repl's completion index.
;
; The daemon keeps getting SIGTERM'd on this loaded host, so this drives the
; WS handler map IN-PROCESS: the driver IS the socket pid (handlers just
; erlang/send {:push msg} to it). Everything except the Bandit transport is
; exercised for real: session mint, eval, invalidation, dirty re-kick, swap,
; indexed completion.
;
;   ./bin/bl run research/repl-spike/index_driver.bl

(ns index-driver
  (:require [vm.repl :as repl] [vm.manager :as mgr]))

(def me (erlang/self))

(defn- drain
  "Collect {:push msg} frames for `ms`, returning the list of decoded payloads."
  [ms]
  (let [deadline (+ (System/monotonic_time :millisecond) ms)]
    (loop [acc (list)]
      (let [left (- deadline (System/monotonic_time :millisecond))]
        (if (<= left 0)
          (vec acc)
          (receive
            [:push payload] (recur (conj acc payload))
            (after left (vec acc))))))))

(defn- op->frames [handlers sid op-map wait-ms]
  ((:handle-in handlers) [:text (bl.json/encode op-map)] sid)
  (drain wait-ms))

(mgr/start)
(let [handlers (repl/ws-handlers {:root (BeamLisp/cwd)})
      init-r ((:init handlers) nil)
      sid (nth init-r 2)]
  (println "minted sid:" sid)

  ;; let the mint-primed build land
  (println "waiting for mint build…")
  (drain 8000)

  ;; eval a def — invalidates + kicks rebuild
  (let [frames (op->frames handlers sid {"op" "eval" "id" 1 "src" "(def my-driver-check 42)"} 15000)
        kinds (map (fn [f] (get f "kind")) frames)]
    (println "eval frames:" (join "," kinds)))

  ;; wait for the rebuild swap (dirty re-kick included), then complete
  (Thread/sleep 12000)
  (let [frames (op->frames handlers sid {"op" "complete" "id" 2 "prefix" "my-driver"} 30000)
        comp (first (filter (fn [f] (= "completions" (get f "kind"))) frames))
        items (if (map? comp) (get comp "items") (list))
        hits (map (fn [i] (str (get i "ns") "/" (get i "label"))) items)]
    (println "completion ms:" (get comp "ms") " building:" (get comp "building" false))
    (println "hits:" (join ", " hits))
    (if (some (fn [h] (= "user/my-driver-check" h)) hits)
      (println "INDEX-LIFECYCLE-OK")
      (println "INDEX-LIFECYCLE-FAIL")))

  ;; interrupt path still sane after the index rework
  (op->frames handlers sid {"op" "eval" "id" 3 "src" "(loop [] (recur))"} 500)
  (op->frames handlers sid {"op" "interrupt" "id" 4} 3000)
  (let [frames (drain 3000)
        interrupted (some (fn [f] (= true (get f "interrupted"))) frames)]
    (println "interrupt frame seen:" interrupted))
  (let [frames (op->frames handlers sid {"op" "eval" "id" 5 "src" "(+ 1 2)"} 10000)
        val (some (fn [f] (if (= "value" (get f "kind")) (get f "text") nil)) frames)]
    (println "session survives, (+ 1 2) =>" val))

  (System/halt 0))
