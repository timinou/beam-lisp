; daemon_driver.bl — boot the tree's daemon session under a UNIQUE cmdline.
;
; `bl daemon start` processes keep dying on this loaded host (SIGTERM at a
; few minutes, no oomd log): the working theory is another session's broad
; pkill pattern matching "daemon start". This driver boots the same
; vm.session/start but its cmdline is "bl run …/daemon_driver.bl" — matched
; by nothing generic. Stop with: pkill -f daemon_driver.bl
;
;   setsid nohup env BEAM_LISP_AOT_CACHE_DIR=$PWD/.bl-spike-aot \
;     ./bin/bl run research/repl-spike/daemon_driver.bl >>/tmp/bl-repl-daemon.log 2>&1 &

(ns daemon-driver)

(BeamLisp.Loader/ensure_loaded "vm.session")
(let [start (BeamLisp.Env/fetch! "vm.session" "start")]
  (BeamLisp.RT/invoke start (to-list [(BeamLisp/cwd)])))
(println "daemon-driver: vm.session started (ui on the tree's :ui port)")

;; vm.session/start's servers are start_link'd to THIS process — stay alive.
(loop [] (receive [:stop] :ok (after 600000 :ok)) (recur))
