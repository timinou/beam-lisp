; session.bl — the compiler AS the IDE.
;
; Not a JSON-RPC transport (that shim is dumb by design). This renders an
; editor-like view of a source file with the compiler's proofs painted in
; place: a native-eligibility gutter, inline type+effect hints, diagnostics
; with carets, and a proof panel. It shows what no editor+LSP can — because the
; intelligence is the compiler's own, not a syntax server's guess.
;
; Run:  BEAM_LISP_PATH=research/lsp:research/native-eligible \
;         mix beam_lisp.run --path priv research/lsp/session.bl

(ns session
  (:require [lsp]
            [eligible]
            [system.analyze :as analyze]
            [errors]))

(def demo-src
  (str "(defn dist2 [dx dy] (erlang/+ (erlang/* dx dx) (erlang/* dy dy)))\n"
       "(defn step [x y] (dist2 (erlang/- x 1) (erlang/- y 1)))\n"
       "(defn mk [] :kw)\n"
       "(defn use-it [n] (erlang/+ 1 (mk)))\n"
       "(defn log-it [v] (io/format \"~p~n\" [v]))\n"
       "(defn dead [] 42)"))

; ── the gutter: one glyph per function, its native verdict ────────────────

(defn- gutter-glyph [verdict]
  (cond
    (:eligible verdict) "◆"      ; native-eligible (pure ∧ terminates ∧ sort)
    (= (:reason verdict) :impure) "≈"   ; effectful — stays on BEAM
    (= (:reason verdict) :sort)   "○"   ; value not machine-sorted
    (= (:reason verdict) :may-diverge) "∞"
    :else " "))

(defn- pad [s n]
  (let [s (str s)]
    (if (>= (String/length s) n) s (str s (String/slice "                                        " 0 (- n (String/length s)))))))

(defn- reason-name [kw] (if (nil? kw) "?" (str kw)))

; ── the rendered view ─────────────────────────────────────────────────────

(defn render-session
  "An annotated editor view of `src`: each defn line prefixed with its native
   -eligibility gutter glyph and suffixed with an inlay hint (inferred return
   type + effect marker), then a diagnostics block, then a proof panel."
  [src ns]
  (let [a-summaries (analyze/analyze src)
        elig (eligible/eligibility-report src)
        inlays (into {} (map (fn [h] [(:fn h) (:hint h)]) (lsp/inlay-hints src)))
        lines (String/split src "\n")
        ; map each line to the fn defined on it: the summary names, matched
        ; against the line's "(defn <name> " prefix (no regex needed).
        names (into [] (map first (into [] a-summaries)))
        line->fn (fn [ln]
                   (some (fn [nm] (when (starts-with? ln (str "(defn " nm " ")) nm))
                         names))]
    (str
      "  ╭─ " ns ".bl " (String/slice "──────────────────────────────────────" 0 40) "\n"
      (join "\n"
        (map (fn [ln]
               (let [fname (line->fn ln)
                     v (when fname (get elig fname))
                     glyph (if v (gutter-glyph v) " ")
                     hint (when fname (get inlays fname))]
                 (str "  " glyph " │ " (pad ln 58)
                      (if hint (str "  " hint) ""))))
             lines))
      "\n  ╰" (String/slice "────────────────────────────────────────────" 0 44) "\n"
      "\n  gutter: ◆ native-eligible   ≈ effectful   ○ non-machine-sort   ∞ may-diverge\n"
      ; ── diagnostics ──
      (let [diags (lsp/diagnostics src ns)]
        (if (empty? diags)
          "\n  ✓ no diagnostics\n"
          (str "\n  diagnostics:\n"
               (join "\n" (map (fn [d] (str "    " (errors/render (str ns ".bl") src d))) diags))
               "\n")))
      ; ── proof panel: the native call-tree win ──
      "\n  proof panel — native offload:\n"
      (join "\n"
        (map (fn [[fname v]]
               (str "    " (pad fname 10) " "
                    (if (:eligible v)
                      (str "◆ eligible — " (:note v))
                      (str "· refused (" (reason-name (:reason v)) ")"))))
             (sort-by first (into [] elig)))))))

; ── run it ─────────────────────────────────────────────────────────────────

(println (render-session demo-src "world"))
