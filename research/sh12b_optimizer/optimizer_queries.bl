(ns p12bopt (:require [codebase :as cb] [typed :as t] [datom :as d]))
(def sigs (merge t/core-sigs t/core-seeds-v2 t/host-seeds))
(def conn (cb/connect-codebase))
(cb/transact-source! conn sigs "compiler" (File/read! "priv/boot/compiler.bl"))
(def db (d/db conn))

; OPTIMIZATION AS DATALOG QUERIES over the program-as-facts:

; 1. Inline candidates: functions called from exactly ONE call site.
(defn call-count [callee]
  (count (d/q '[:find ?c :in $ ?callee :where [?c :call/callee ?callee]] db callee)))
(def all-fns (sort (into [] (map first (d/q '[:find ?n :where [?d :fn/name ?n]] db)))))
(def inline-candidates
  (filter (fn [f] (= 1 (call-count f))) all-fns))
(println "INLINE CANDIDATES (called exactly once) — a datalog query:")
(doseq [f (take 12 inline-candidates)] (println "  " f "(1 caller)"))
(println "  ... " (count inline-candidates) "total")
(println)

; 2. Dead code: a private helper that NOTHING calls.
(def called (into #{} (map first (d/q '[:find ?callee :where [?c :call/callee ?callee]] db))))
(def dead (filter (fn [f] (not (contains? called f))) all-fns))
(println "POTENTIALLY DEAD (defined, never called internally) — a datalog query:")
(doseq [f (take 10 dead)] (println "  " f))
(println "  ... " (count dead) "total (some are the public entry points)")
