(ns p5destr (:require [compiler :as c] [self.oracle :as o]))
(def env (BeamLisp.Compiler/new_env "user"))
(def kenv (c/new-env "user"))
(def pass (atom 0)) (def fail (atom 0))
(defn check [src]
  (try
    (let [form (BeamLisp.Reader/read_one src)
          want (o/oracle-compile form env)
          got  (c/compile form kenv)]
      (if (o/ast-equal? want got) (swap! pass inc)
        (do (swap! fail inc) (println "FAIL ::" src))))
    (catch e (do (swap! fail inc) (println "ERR  ::" src)))))
(doseq [s (list
  "(let [[a b] xs] a)"
  "(let [[a b c] xs] (+ a (+ b c)))"
  "(let [{:keys [x y]} m] x)"
  "(let [{:keys [x y]} m] (+ x y))"
  "(let [[a & rest] xs] rest)"
  "(let [[a b :as all] xs] all)"
  "(let [{:keys [x] :or {x 0}} m] x)"
  "(let [{a :alpha b :beta} m] (+ a b))"
  "(let [[[a b] c] xs] a)"
  "(let [{:keys [x]} m [a b] ys] (+ x a))")]
  (check s))
(println "PASS:" (deref pass) "FAIL:" (deref fail))
