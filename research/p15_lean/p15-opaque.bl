; research/p15_lean/opaque.bl — P15f: ^:opaque, the reducibility knob (L9).
;
; Lean's reducibility controls what the elaborator may unfold. Ours: an
; ALIAS (or any def) marked ^:opaque is trusted at its DECLARED
; signature — the checker never unfolds its body. A transparent def is
; re-analyzed from source every time.
;
; Why it matters: (a) speed — opaque boundaries cap re-analysis;
; (b) honesty — a def whose body is deliberately uncheckable (interop
; glue) declares its contract and is trusted; (c) the DANGER is the
; point of the demo: an opaque def whose body LIES produces no warning
; (trust is trust), while the same lie in a transparent def is caught.

(ns p15-opaque
  (:require [typed]))

(defn name-meta
  "The MERGED ^ map on a def/defn's name node. Stacked ^ wraps produce
   nested {:meta {:meta sym m1} m2}; reader POSITION maps carry :line
   and are not annotations. Returns nil when no ^ is present."
  [name-node]
  (loop [n name-node acc nil]
    (if (= :meta (typed/node-tag n))
      (let [m (nth (erlang/tuple_to_list n) 2)
            inner (second (erlang/tuple_to_list n))
            annot? (and (map? m) (not (contains? m :line)))]
        (recur inner
               (if annot? (merge (if (nil? acc) {} acc) m) acc)))
      acc)))

(defn analyze-defs
  "Walk top-level defs. Transparent defs are re-analyzed (their bodies
   walk and warn). Opaque defs contribute ONLY their declared meta —
   the body is never walked. Returns {:sigs … :warnings …}."
  [src]
  (let [forms (BeamLisp.Reader/read_string src)]
    (reduce
      (fn [acc form]
        (let [f (typed/node-form form)]
          (if (and (= :list (typed/node-tag f))
                   (= :symbol (typed/node-tag (typed/node-form (first (typed/node-items f)))))
                   (= "def" (typed/node-name (typed/node-form (first (typed/node-items f))))))
            (let [items (typed/node-items f)
                  m (name-meta (second items))
                  opaque? (and (map? m) (= true (:opaque m)))
                  name (node-name-of (second items))
                  declared-ret (if (and (map? m) (contains? m :ret))
                                 (typed/type-expr (:ret m))
                                 nil)]
              (if opaque?
                ; trusted: declared sig only, body NEVER walked
                (assoc-in acc [:sigs name]
                          {:opaque true
                           :args (if (and (map? m) (contains? m :args))
                                   (into [] (map typed/type-expr
                                                 (typed/node-items
                                                   (typed/node-form (:args m)))))
                                   nil)
                           :ret (if (some? declared-ret)
                                  declared-ret
                                  typed/any)})
                ; transparent: the body walks; a declared :ret the body
                ; provably contradicts is a LIE, and lies are warnings
                (let [body-ty (typed/walk (merge typed/core-sigs
                                                 typed/core-seeds-v2
                                                 (:sigs acc))
                                          {} (nth items 2))]
                  (if (and (some? declared-ret)
                           (not (= typed/any body-ty))
                           (empty? (typed/t-meet body-ty declared-ret)))
                    (swap! typed/warnings
                           (fn [ws]
                             (conj ws {:msg (str name
                                                 ": declared "
                                                 (pr-str (sort (into [] declared-ret)))
                                                 " but body returns "
                                                 (pr-str (sort (into [] body-ty))))
                                       :line (:line (typed/node-pos form))
                                       :col 0 :form ""})))
                    nil)
                  acc)))
            acc)))
      {:sigs {} :warnings nil}
      forms)))

(defn node-name-of [n]
  (typed/node-name (typed/node-form n)))
