; research/p15_lean/run.bl — P15 demos c, d, e, f.

(ns p15run
  (:require [typed]
            [p15-effects :as fx]
            [p15-termination :as term]
            [p15-deferred :as defer]
            [p15-opaque :as opq]))

(println "── P15: the Lean tier ──")

; ══ (c) effect lattice ═════════════════════════════════════════════════
(println "(c) effect lattice:")
(def fx-src
  "(defn bump [a] (swap! a inc))
   (defn step [a] (bump a))
   (defn ^:pure run-it [a] (step a))
   (defn ^:pure clean [x] (str x))")
(def fx-table (fx/infer-effects fx-src))
(println (str "  effects: " (pr-str fx-table)))
(def fx-w (fx/check-purity-claims fx-src))
(doall (map (fn [w] (println (str "  ✗ " (:name w) " claims ^:pure but has :"
                                 (name (:effect w)) " effect (line "
                                 (:line w) ")")))
            fx-w))
(def c-pass (and (= :atom (get fx-table "run-it"))
                 (= 1 (count fx-w))
                 (= "run-it" (:name (first fx-w)))))
(println (str "  " (if c-pass "PASS" "FAIL")
              ": the 3-fn chain ending in swap! rejects the purity claim"))

; ══ (d) termination ════════════════════════════════════════════════════
(println "(d) termination:")
(def term-src
  "(defn countdown [n] (loop [i n] (if (> i 0) (recur (dec i)) i)))
   (defn badcount [n] (loop [i n] (if (> i 0) (recur (inc i)) i)))
   (defn walk-down [xs] (loop [ys xs] (if (empty? ys) ys (recur (rest ys)))))
   (defn trusted [f xs] (loop ^{:decreasing (count xs)} [acc 0] (recur (f acc))))")
(def term-v (term/check-source term-src))
(doall (map (fn [v] (println (str "  " (name (:status v)) ": " (:detail v))))
            term-v))
(def d-pass (and (= :accepted (:status (nth term-v 0)))
                 (= :rejected (:status (nth term-v 1)))
                 (= :accepted (:status (nth term-v 2)))
                 (= :trusted  (:status (nth term-v 3)))))
(println (str "  " (if d-pass "PASS" "FAIL")
              ": dec accepted, inc rejected, rest accepted, measure trusted"))

; ══ (e) deferred constraints ═══════════════════════════════════════════
(println "(e) deferred constraints:")
(reset! defer/deferred [])
(reset! typed/warnings [])
(def file-a "(ns file-a) (defn use-it [] (helper \"s\") (never-defined 1))")
(def ra (defer/check-file-deferring file-a "file-a"))
(println (str "  phase 1 — A alone: " (count (:warnings ra))
              " warnings, " (count (:deferred ra)) " deferred"))

; later: file B defines helper with a signature
(defn ^{:args [int] :ret int} helper [x] (* x 2))
(def rw (defer/retry-deferred! "p15run"))
(doall (map (fn [w] (println (str "  ✗ line " (:line w) ": " (:msg w)))) rw))
(println (str "  phase 2 — after helper loads: " (count rw) " warning(s)"))
(println (str "  phase 3 — DAG end, still deferred: "
              (pr-str (map (fn [d] (:callee d)) (defer/dag-end-report)))))
(def e-pass (and (= 0 (count (:warnings ra)))
                 (= 2 (count (:deferred ra)))
                 (= 1 (count rw))))
(println (str "  " (if e-pass "PASS" "FAIL")
              ": deferred, retried on load, silent at DAG end"))

; ══ (f) ^:opaque ═══════════════════════════════════════════════════════
(println "(f) opacity:")
(reset! typed/warnings [])
(def opq-src
  "(def ^{:ret int} lying-transparent \"not an int\")
   (def ^:opaque ^{:args [int] :ret int} trusted-int-fn \"lies too\")")
(def or_ (opq/analyze-defs opq-src))
(def opq-warnings (deref typed/warnings))
(println (str "  transparent lie: " (count opq-warnings) " warning(s)"))
(println (str "  opaque lie: trusted at "
              (pr-str (get-in or_ [:sigs "trusted-int-fn" :ret]))
              ", body never walked"))
(def f-pass (and (= 1 (count opq-warnings))
                 (= #{:int} (get-in or_ [:sigs "trusted-int-fn" :ret]))))
(println (str "  " (if f-pass "PASS" "FAIL")
              ": transparent caught, opaque trusted (trust is auditable)"))

(println (str (if (and c-pass d-pass e-pass f-pass) "PASS" "FAIL")
              ": P15 c–f"))
