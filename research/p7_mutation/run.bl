; research/p7_mutation/run.bl — P7 driver.

(ns p7run
  (:require [muts]))

(reset! muts/atom-table {})
(reset! typed/warnings [])

(println "── P7: mutation typing ──")

; ── 1. clean atom use: silent ─────────────────────────────────────────
(def clean
  "(def counter (atom 0))
   (swap! counter inc)
   (def snap @counter)
   (def later (atom nil))
   (reset! later 42)")
(def w1 (muts/check-source clean "p7run"))
(println (str "clean: " (count w1) " warnings"))

; ── 2. invariant violations: warn ─────────────────────────────────────
(def bad
  "(def counter2 (atom 0))
   (swap! counter2 str)
   (reset! counter2 \"nope\")")
(def w2 (muts/check-source bad "p7run"))
(println (str "violations: " (count w2) " warnings"))
(doall (map (fn [w] (println (str "  ✗ " (:line w) ":" (:col w) " " (:msg w)))) w2))

; ── 3. RELOAD: the same def re-derived with a new inner type ──────────
;    v1 (atom 0) warned under int; the reload redefines with a string —
;    the table entry is REPLACED, and the same swap! now checks against
;    string.
(reset! typed/warnings [])
(def reload-v2
  "(def counter2 (atom \"s\"))
   (swap! counter2 str)")
(def w3 (muts/check-source reload-v2 "p7run"))
(println (str "after reload: " (count w3) " warnings (v1's are gone)"))

; ── 4. defserver: state positions checked ─────────────────────────────
(reset! typed/warnings [])
(def server
  "(defserver q-server
     (init [db] {:db db})
     (handle-call [:query q] [_from db]
       (reply [] db))
     (handle-cast [:refresh c] [_db]
       (noreply \"not-a-map\")))")
(def w4 (muts/check-source server "p7run"))
(println (str "defserver: " (count w4) " warning(s)"))
(doall (map (fn [w] (println (str "  ✗ " (:line w) ":" (:col w) " " (:msg w)))) w4))

(println (str (if (and (= 0 (count w1))
                       (= 2 (count w2))
                       (= 0 (count w3))
                       (= 1 (count w4)))
                "PASS" "FAIL")
              ": invariants hold, violations caught, reload replaces, defserver checked"))
