; research/p7_mutation/muts.bl — P7: mutation, per-swap! invariants,
; reload semantics.
;
; The questions: (a) can atoms carry per-var inner-tag invariants that
; swap!/reset!/deref respect? (b) what does RELOAD do to type tables?
; (c) does defserver state typing work at tag tier?
;
; Answers encoded here:
;   - atom-table {sym → inner-tagset}, built from (def a (atom init)).
;     nil-init → any (the "set later" idiom; warning there would be a
;     false positive factory).
;   - (swap! a f …): f's ret must MEET inner; (reset! a v): v must meet
;     inner; (deref a) / @a: inner. Disjoint meet → warning.
;   - RELOAD = re-derivation: the table entry is rebuilt from the def,
;     replacing the old one. No stale state, because the table is
;     scoped exactly like Env's re-intern.
;   - defserver: clause bodies walk with the state param bound to the
;     init clause's state type; reply/noreply state positions must meet
;     it.

(ns muts
  (:require [typed]))

(def any typed/any)
(def never typed/never)
(def t-meet typed/t-meet)
(def core-sigs typed/core-sigs)

(def atom-table (atom {}))

(defn warn! [msg form]
  (swap! typed/warnings
         (fn [ws] (conj ws {:msg msg
                            :line (:line (typed/node-pos form))
                            :col  (:col (typed/node-pos form))
                            :form ""}))))

(declare check-top)

(defn atom-call
  "swap!/reset!/deref against the atom table. Returns ret type or nil
   when the head isn't one of ours."
  [sigs head items whole]
  (cond
    (= head "swap!")
      (let [a    (second items)
            f    (nth items 2)
            aname (if (= :symbol (typed/node-tag (typed/node-form a)))
                    (typed/node-name (typed/node-form a)) nil)
            inner (if (nil? aname) nil (get (deref atom-table) aname nil))]
        (if (nil? inner)
          any
          (let [ft (typed/walk sigs {} f)
                fsig (if (= :symbol (typed/node-tag (typed/node-form f)))
                       (get sigs (typed/node-name (typed/node-form f)) nil)
                       nil)]
            (if (and (some? fsig)
                     (empty? (t-meet (:ret fsig) inner)))
              (warn! (str "swap! on " aname ": " (typed/node-name (typed/node-form f))
                          " returns " (pr-str (sort (into [] (:ret fsig))))
                          ", atom holds " (pr-str (sort (into [] inner))))
                     whole)
              nil)
            inner)))
    (= head "reset!")
      (let [a (second items)
            aname (if (= :symbol (typed/node-tag (typed/node-form a)))
                    (typed/node-name (typed/node-form a)) nil)
            inner (if (nil? aname) nil (get (deref atom-table) aname nil))]
        (if (nil? inner)
          any
          (let [vt (typed/walk sigs {} (nth items 2))]
            (if (empty? (t-meet vt inner))
              (warn! (str "reset! " aname ": new value "
                          (pr-str (sort (into [] vt))) " vs atom holding "
                          (pr-str (sort (into [] inner))))
                     whole)
              nil)
            inner)))
    (= head "deref")
      (let [a (second items)
            aname (if (= :symbol (typed/node-tag (typed/node-form a)))
                    (typed/node-name (typed/node-form a)) nil)]
        (get (deref atom-table) aname any))
    :else nil))

; --- defserver ------------------------------------------------------------------
;
; (defserver name
;   (init [state…] body)                       → state type = body's
;   (handle-call msg :when? g [from state] body…)  → (reply v new-state)
;   (handle-cast msg [state] body…)                → (noreply new-state))

(defn last-binder
  "The state param is the LAST element of the handler's second vector."
  [handler-items]
  (let [vecs (filter (fn [x] (= :vector (typed/node-tag (typed/node-form x))))
                     handler-items)]
    (if (empty? vecs)
      nil
      (let [ps (typed/node-items (typed/node-form (first (reverse (into [] vecs)))))]
        (if (empty? ps)
          nil
          (let [p (first (reverse (into [] ps)))]
            (if (= :symbol (typed/node-tag (typed/node-form p)))
              (typed/node-name (typed/node-form p))
              nil)))))))

(defn check-state-positions
  "Every (reply v st) / (noreply st) in the body: st must meet state-ty."
  [sigs env body state-ty]
  (doall
    (map (fn [b]
           (let [f (typed/node-form b)]
             (if (and (= :list (typed/node-tag f))
                      (contains? #{"reply" "noreply"}
                        (typed/node-name (typed/node-form (first (typed/node-items f))))))
               (let [its (typed/node-items f)
                     st  (first (reverse (into [] its)))
                     stt (typed/walk sigs env st)]
                 (if (empty? (t-meet stt state-ty))
                   (warn! (str (typed/node-name (typed/node-form (first its)))
                               ": new state " (pr-str (sort (into [] stt)))
                               " vs server state "
                               (pr-str (sort (into [] state-ty))))
                          b)
                   nil))
               (typed/walk sigs env b))))
         body)))

(defn walk-defserver [sigs form]
  (let [items   (typed/node-items (typed/node-form form))
        clauses (rest (rest items))
        inits   (filter (fn [c]
                          (and (= :list (typed/node-tag (typed/node-form c)))
                               (= "init"
                                  (typed/node-name
                                    (typed/node-form
                                      (first (typed/node-items c)))))))
                        clauses)
        state-ty (if (empty? inits)
                   any
                   (let [ic (first inits)
                         ibody (rest (rest (typed/node-items ic)))]
                     (reduce (fn [_ b] (typed/walk sigs {} b)) never ibody)))]
    (doall
      (map (fn [c]
             (let [f  (typed/node-form c)
                   ci (typed/node-items f)
                   h  (typed/node-name (typed/node-form (first ci)))]
               (if (contains? #{"handle-call" "handle-cast" "handle-info"} h)
                 (let [sname (last-binder (rest ci))
                       env   (if (nil? sname) {} {sname state-ty})
                       ; body = everything after the LAST vector in the
                       ; clause head (robust to a :when guard between
                       ; the message pattern and the params vector)
                       ci-vec (into [] ci)
                       vec-idxs (filter (fn [i] (= :vector (typed/node-tag (typed/node-form (nth ci-vec i)))))
                                        (range (count ci-vec)))
                       last-vec (if (empty? vec-idxs) 0 (first (reverse (into [] vec-idxs))))
                       body  (drop (+ last-vec 1) ci-vec)]
                   (check-state-positions sigs env body state-ty))
                 nil)))
           clauses))
    nil))

; --- driver ----------------------------------------------------------------------

(defn check-top
  "Top-level pre-pass: (def a (atom init)) feeds the table; swap!/reset!/
   deref and defserver get the mutation rules; everything else is typed's."
  [sigs form]
  (let [f (typed/node-form form)]
    (if (= :list (typed/node-tag f))
      (let [items (typed/node-items f)
            head  (typed/node-name (typed/node-form (first items)))]
        (cond
          (= head "defserver") (walk-defserver sigs form)

          (= head "def")
            (let [name (typed/node-name (typed/node-form (second items)))
                  init (nth items 2)
                  iform (typed/node-form init)]
              (if (and (= :list (typed/node-tag iform))
                       (= "atom"
                          (typed/node-name
                            (typed/node-form (first (typed/node-items iform))))))
                (let [vt (typed/walk sigs {} (second (typed/node-items iform)))]
                  ; nil-init → any: the "set later" idiom
                  (swap! atom-table
                         (fn [t] (assoc t name
                                        (if (= vt #{:nil}) any vt))))
                  nil)
                (typed/walk sigs {} form)))

          :else
            (let [r (atom-call sigs head items form)]
              (if (nil? r) (typed/walk sigs {} form) r))))
      (typed/walk sigs {} form))))

(defn check-source [src ns]
  (let [forms (if (string? src) (BeamLisp.Reader/read_string src) src)
        sigs  (merge core-sigs typed/core-seeds-v2 typed/host-seeds
                     (typed/sigs-from-env ns))]
    (doall (map (fn [f] (check-top sigs f)) forms))
    (deref typed/warnings)))
