; research/p9_schema/bridge.bl — P9: the schema bridge.
;
; The questions: are schemas statically available? What is the boundary
; rule for runtime-built ones? Can we infer one query's result type?
;
; Answers encoded here:
;   1. Schemas in this ecosystem ARE literal data — installed by
;      transactions like (datom/install-schema! conn [{:db/ident …} …])
;      or bound by (def schema …). Both are statically readable. The
;      spike extracts both.
;   2. Queries are QUOTED DATA — fully static. Column types = the
;      :where clause's attr → :db/valueType → lattice tag.
;   3. BOUNDARY RULE: an attr absent from the statically-known schema
;      types its var as any AND records a deferred constraint (L7) —
;      a runtime-installed attr could resolve it at DAG-end.
;   4. valueType→tag: string→string, long→int, boolean→bool,
;      keyword→kw, ref→int (entity ids are longs), instant/term→any,
;      vector→vec. (The enum has no float — longs carry numbers.)

(ns bridge
  (:require [typed]))

(def any typed/any)
(def never typed/never)

(def value-type-tags
  {:db.type/string  #{:string}
   :db.type/long    #{:int}
   :db.type/boolean #{:bool}
   :db.type/keyword #{:kw}
   :db.type/ref     #{:int}
   :db.type/instant any
   :db.type/term    any
   :db.type/vector  #{:vec}})

; --- 1. static schema extraction ----------------------------------------------
;
; From reader data forms (read_all_data): find
;   (datom/install-schema! _ [{:db/ident … :db/valueType …} …])
;   (def schema [{…} …])
; and build {attr-kw → tagset}.

(defn attr-map-entry [m]
  "A literal map with :db/ident and :db/valueType → [attr tags] or nil."
  (if (map? m)
    (let [id (get m :db/ident nil)
          vt (get m :db/valueType nil)]
      (if (and (keyword? id) (keyword? vt))
        [id (get value-type-tags vt any)]
        nil))
    nil))

(defn schema-from-data
  "data is a (possibly quoted) vector of attr maps, or nil."
  [data]
  (reduce (fn [acc m]
            (let [e (attr-map-entry m)]
              (if (nil? e) acc (assoc acc (first e) (second e)))))
          {} (if (nil? data) [] data)))

(defn extract-schemas
  "Walk top-level forms (as DATA, via read_all_data); collect every
   statically-visible schema. Returns {attr → tagset}."
  [forms]
  (reduce
    (fn [acc form]
      (if (list? form)
        (let [head (first form)]
          (cond
            ; (datom/install-schema! conn […]) — or any */install-schema!
            (and (symbol? head)
                 (> (count form) 2)
                 (let [n (str head)]
                   (or (= n "install-schema!")
                       (= n "datom/install-schema!"))))
              (merge acc (schema-from-data (unquote-data (nth form 2))))

            ; (def schema […]) / (def schema {…}) — literal data defs
            (and (symbol? head) (= (str head) "def") (> (count form) 2))
              (merge acc (schema-from-data (unquote-data (nth form 2))))

            :else acc))
        acc))
    {} forms))

(defn unquote-data
  "('… reader data) — a (quote d) list hands back d."
  [x]
  (if (and (list? x) (= (str (first x)) "quote"))
    (second x)
    x))

; --- 2. query column inference ---------------------------------------------------
;
; '[:find ?a ?b … :where [?e :attr ?a] …] → {:cols {?a tags …}
;                                           :deferred [attr …]}

(defn idx-of [v x]
  (first (filter (fn [i] (= (nth v i) x)) (range (count v)))))

(defn query-columns
  "Infer find-var types from a query datum + a static schema.
   Handles the flat :find ?a ?b … form (not :find (pull …))."
  [query schema]
  (let [q      (into [] query)
        fi     (idx-of q :find)
        wi     (idx-of q :where)
        finds  (into [] (take (- wi (+ fi 1)) (drop (+ fi 1) q)))
        clauses (drop (+ wi 1) q)
        ; {var → attr} from [?e :attr ?v] clauses
        bindings (reduce
                   (fn [acc clause]
                     (let [c (into [] clause)]
                       (if (and (= 3 (count c))
                                (keyword? (second c))
                                (symbol? (nth c 2))
                                (> (count (str (nth c 2))) 0)
                                (= "?" (subs (str (nth c 2)) 0 1)))
                         (assoc acc (str (nth c 2)) (second c))
                         acc)))
                   {} clauses)]
    (reduce
      (fn [acc f]
        (if (symbol? f)
          (let [v (str f)
                attr (get bindings v nil)]
            (cond
              (nil? attr)
                (assoc-in acc [:cols v] any)      ; unbound find var
              (contains? schema attr)
                (assoc-in acc [:cols v] (get schema attr))
              :else
                (-> acc
                    (assoc-in [:cols v] any)
                    (assoc-in [:deferred attr] v))))
          acc))
      {:cols {} :deferred {}} finds)))

; --- 3. the boundary rule, as data -----------------------------------------------

(defn boundary-report
  "What the checker can and cannot see. cols with tags are proven;
   deferred attrs await a runtime-installed schema (L7: retry at
   require-DAG end; silent if never resolved — unknown stays any)."
  [inferred]
  {:proven  (reduce (fn [m [k v]] (if (= v any) m (assoc m k v))) {} (:cols inferred))
   :unknown (reduce (fn [m [k v]] (if (= v any) (assoc m k v) m)) {} (:cols inferred))
   :deferred (:deferred inferred)})
