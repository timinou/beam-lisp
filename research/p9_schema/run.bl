; research/p9_schema/run.bl — P9 driver.

(ns p9run
  (:require [bridge] [typed]))

(println "── P9: schema bridge ──")

; ── a module that installs a schema from literal data ─────────────────
(def app-src
  "(ns app)
   (def schema
     [{:db/ident :person/name :db/valueType :db.type/string}
      {:db/ident :person/age  :db/valueType :db.type/long}])
   (datom/install-schema! conn
     [{:db/ident :audit/by :db/valueType :db.type/string}])
   (def rows
     (datom/q '[:find ?name ?age :where
                [?e :person/name ?name]
                [?e :person/age ?age]]
              db))
   (def risky
     (datom/q '[:find ?who :where [?e :person/mood ?who]] db))")

(def forms (BeamLisp.Compiler/read_all_data app-src))
(def schema (bridge/extract-schemas forms))
(println (str "statically extracted attrs: "
              (pr-str (sort (into [] (keys schema))))))

; ── query 1: both attrs known ──────────────────────────────────────────
(def q1 '[:find ?name ?age :where
          [?e :person/name ?name]
          [?e :person/age ?age]])
(def r1 (bridge/query-columns q1 schema))
(println (str "q1 cols: " (pr-str (:cols r1)) " deferred: " (pr-str (:deferred r1))))

; ── query 2: unknown attr → boundary ──────────────────────────────────
(def q2 '[:find ?who :where [?e :person/mood ?who]])
(def r2 (bridge/query-columns q2 schema))
(def rep (bridge/boundary-report r2))
(println (str "q2 boundary: proven=" (pr-str (:proven rep))
              " unknown=" (pr-str (into [] (keys (:unknown rep))))
              " deferred=" (pr-str (into [] (keys (:deferred rep))))))

; ── the inferred env actually catches misuse downstream ───────────────
; hand the columns to typed/walk as a binding env: (+ ?age 1) is fine,
; (double name) — a string into an int-declared fn — is not.
(defn ^{:args [int] :ret int} double [x] (* x 2))
(reset! typed/warnings [])
(def sigs (merge typed/core-sigs typed/host-seeds (typed/sigs-from-env "p9run")))
(def env1 {(str "name") (get-in r1 [:cols "?name"])
           (str "age")  (get-in r1 [:cols "?age"])})
; typed env keys are plain names (the walker binds by node-name string)
(def body-ok   (first (BeamLisp.Reader/read_string "(+ age 1)")))
(def body-bad  (first (BeamLisp.Reader/read_string "(double name)")))
(typed/walk sigs {"age" (get-in r1 [:cols "?age"]) "name" (get-in r1 [:cols "?name"])} body-ok)
(typed/walk sigs {"age" (get-in r1 [:cols "?age"]) "name" (get-in r1 [:cols "?name"])} body-bad)
(def misuse (deref typed/warnings))
(println (str "downstream misuse warnings: " (count misuse)))
(doall (map (fn [w] (println (str "  ✗ " (:msg w)))) misuse))

(println (str (if (and (= #{:string} (get-in r1 [:cols "?name"]))
                       (= #{:int}    (get-in r1 [:cols "?age"]))
                       (contains? (:deferred r2) :person/mood)
                       (= 1 (count misuse)))
                "PASS" "FAIL")
              ": literal schemas extracted, columns inferred, boundary deferred, misuse caught"))
