{
  "name": "tree-sitter-beamlisp",
  "version": "0.1.0",
  "description": "tree-sitter grammar for Beam Lisp (.bl) — a Clojure-reader dialect on the BEAM",
  "main": "bindings/node",
  "keywords": ["parser", "tree-sitter", "beamlisp", "clojure", "beam", "erlang"],
  "license": "CC0-1.0",
  "dependencies": {
    "node-addon-api": "^8.0.0",
    "node-gyp-build": "^4.8.0"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.25.0"
  },
  "tree-sitter": [
    {
      "scope": "source.bl",
      "injection-regex": "^(bl|beamlisp)$",
      "file-types": ["bl"]
    }
  ]
}
