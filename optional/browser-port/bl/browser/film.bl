(ns browser.film
  (:require [browser.page :as page] [interop]))

(defn action! [p term]
  (case (first term)
    :navigate (page/navigate! p (nth term 1))
    :click (page/click! p (nth term 1))
    :hover (page/hover! p (nth term 1))
    :key (page/key! p (nth term 1))
    :fill (page/fill! p (nth term 1) (nth term 2))
    :drag (page/drag! p (nth term 1) (nth term 2) (nth term 3 1500))
    :eval (page/evaluate! p (nth term 1))
    :wait (page/wait! p (nth term 1))
    :pause (Process/sleep (nth term 1))
    (throw (ex-info "Unsupported native browser film action" {:term term}))))

(defn world
  "Scenario Runner world for an already-owned native page and one actor.
   Every step retains a real PNG and the last real click position. Claims
   receive (page, ctx); false claims remain refuted. Close the page in finally."
  [p actor directory]
  (let [index (atom 0)]
    {:kind :browser :open (fn [_] p)
     :step! (fn [_ event]
       (let [who (nth event 1) term (nth event 2)]
       (when (not= who actor) (throw (ex-info "No native page for this actor" {})))
       (action! p term) :ok))
     :claim! (fn [_ _ claim ctx] (claim p ctx))
     :observe (fn [_ _ lens] (lens p))
     :liveness (fn [_] nil)
     :basis (fn [_]
       (let [i (swap! index inc) path (str directory "/frame-" i ".png")]
         (page/screenshot! p path)
         {:frame path :gesture (last @(:gestures p))}))
     :close! (fn [_] {})
     :views-fn (fn [basis _] basis)}))

(defn owned-world
  "Lazy single-actor browser world for scenario.demo. Opens when the scenario
   starts; closes on completion and via :dispose! after any failed action.
   opts are browser.page/open! options; directory receives actual PNGs.
   Missing profile/runtime paths use owned short temporary directories."
  [actor opts directory]
  (let [scratch (str "/tmp/bl-demo-page-" (erlang/unique_integer (list :positive)))
        opts (assoc opts :launch (merge {"profile" (str scratch "/profile")
                                        "runtime" (str scratch "/runtime")} (:launch opts)))
        owned (atom nil)
        delegate (atom nil)
        dispose (fn []
                  (try (when @owned (page/close! @owned))
                       (finally (reset! owned nil) (File/rm_rf! scratch))))]
    {:kind :browser
     :open (fn [_]
             (when @owned (throw (ex-info "Browser world is already open" {})))
             (let [p (page/open! opts)]
               (reset! owned p)
               (reset! delegate (world p actor directory))
               p))
     :step! (fn [p event] ((:step! @delegate) p event))
     :claim! (fn [p who claim ctx] ((:claim! @delegate) p who claim ctx))
     :observe (fn [p who lens] ((:observe @delegate) p who lens))
     :liveness (fn [_] nil)
     :basis (fn [p] ((:basis @delegate) p))
     :views-fn (fn [basis _] basis)
     :close! (fn [_] (dispose) {})
     :dispose! dispose}))

(defn owned-worlds
  "Independent native pages for several actors. Continuously records each
   page from :open through :close!, including waits and other actors' actions.
   Reference PNGs remain separate evidence. The aligned horizontal video is
   derived only from native frame streams, never from reference screenshots.
   actors is an ordered vector of [actor page-options]; opts accepts :ffmpeg,
   :fps and :cursor? (default true). All ports stay with the scenario owner."
  [actors directory opts]
  (when (or (empty? actors) (not= (count actors) (count (set (map first actors))))
            (not (apply = (map #(get-in % [1 :height] 900) actors))))
    (throw (ex-info "Recorded actors require unique names and equal viewport heights" {})))
  (let [owned (atom {}) starts (atom {}) epoch (atom nil) active (atom (first (first actors)))
        index (atom 0) last-basis (atom {}) finished (atom false)
        scratch (str "/tmp/bl-multiscreen-" (erlang/unique_integer (list :positive)))
        root (Path/expand directory)
        movie (str root "/continuous.mp4")
        clock (fn [] (erlang/monotonic_time :millisecond))
        ffmpeg (or (:ffmpeg opts) (System/find_executable "ffmpeg"))
        release (fn []
                  (doseq [[_ p] @owned] (try (page/close! p) (catch _ nil)))
                  (reset! owned {}) (File/rm_rf! scratch))
        finish (fn []
                 (when (and (not @finished) @epoch)
                   (reset! finished true)
                   (let [recordings (mapv (fn [[actor _]] (assoc (page/stop-recording! (get @owned actor))
                                                               :actor actor :trim (get @starts actor))) actors)
                         inputs (mapcat (fn [r] ["-ss" (str (:trim r)) "-i" (get r "path")]) recordings)
                         filters (str (apply str (map-indexed (fn [i _]
                                       (str "[" i ":v]setpts=PTS-STARTPTS[v" i "];")) actors))
                                      (apply str (map-indexed (fn [i _] (str "[v" i "]")) actors))
                                      (if (= 1 (count actors)) "null[out]"
                                          (str "hstack=inputs=" (count actors) ":shortest=1[out]")))
                         result (System/cmd ffmpeg (to-list (concat ["-hide_banner" "-loglevel" "error" "-nostdin" "-n"] inputs
                                  ["-filter_complex" filters "-map" "[out]" "-an" "-c:v" "libx264"
                                   "-preset" "veryfast" "-crf" "18" "-pix_fmt" "yuv420p" "-movflags" "+faststart" movie])))]
                     (when (not= 0 (elem result 1))
                       (throw (ex-info "Native multiscreen composition failed" {:diagnostic (elem result 0)})))
                     (File/write! (str root "/recordings.json")
                       (interop/->json {:kind :native-screencast :layout :horizontal :source movie
                                        :actors (mapv first actors) :recordings recordings})))))]
    {:kind :browser
     :open (fn [_]
             (when (seq @owned) (throw (ex-info "Browser world already open" {})))
             (try
               (doseq [[actor options] actors]
                 (let [options (assoc options :launch (merge {"profile" (str scratch "/" (name actor) "/profile")
                                                             "runtime" (str scratch "/" (name actor) "/runtime")} (:launch options)))
                       p (page/open! options)]
                   (swap! owned assoc actor p)
                   (when (get options :cursor? (get opts :cursor? true)) (page/show-cursor! p))
                   (page/record! p (str root "/" (name actor) ".mp4") opts)))
               (reset! epoch (clock))
               (doseq [[actor _] actors]
                 ;; Capture each recorder's age at the common world epoch.
                 (swap! starts assoc actor (- (get (page/recording (get @owned actor)) "at")
                                              (/ (- (clock) @epoch) 1000.0))))
               @owned
               (catch error (release) (throw error))))
     :step! (fn [_ event]
              (let [who (nth event 1) p (get @owned who)]
                (when-not p (throw (ex-info "No native page for actor" {:actor who})))
                (reset! active who) (action! p (nth event 2)) :ok))
     :claim! (fn [_ who claim ctx] (reset! active who) (claim (get @owned who) ctx))
     :observe (fn [_ who lens] (reset! active who) (lens (get @owned who)))
     :liveness (fn [_] nil)
     :basis (fn [_]
              (let [i (swap! index inc)
                    frames (into {} (map (fn [[actor _]]
                             [actor (page/screenshot! (get @owned actor) (str root "/" (name actor) "-reference-" i ".png"))]) actors))
                    basis {:frame (get frames @active) :frames frames
                           :video {:source movie :at (/ (- (clock) @epoch) 1000.0)
                                   :kind :native-screencast :actors (mapv first actors)}}]
                (reset! last-basis basis) basis))
     :close! (fn [_] (try (finish) @last-basis (finally (release))))
     :views-fn (fn [basis actor] (assoc basis :frame (get-in basis [:frames actor])))
     :dispose! (fn [] (try (finish) (finally (release))))}))
