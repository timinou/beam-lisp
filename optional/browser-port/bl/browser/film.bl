(ns browser.film
  (:require [browser.page :as page]))

(defn world
  "Scenario Runner world for an already-owned native page and one actor.
   Every step retains a real PNG and the last real click position. Claims
   receive (page, ctx); false claims remain refuted. Close the page in finally."
  [p actor directory]
  (let [index (atom 0)]
    {:kind :browser :open (fn [_] p)
     :step! (fn [_ event]
       (let [who (nth event 1) term (nth event 2)]
       (when (not= who actor) (throw (ex-info "No native page for this actor" {})))
       (case (first term)
         :navigate (page/navigate! p (nth term 1))
         :click (page/click! p (nth term 1))
         :fill (page/fill! p (nth term 1) (nth term 2))
         :eval (page/evaluate! p (nth term 1))
         :wait (page/wait! p (nth term 1))
         (throw (ex-info "Unsupported native browser film action" {:term term}))) :ok))
     :claim! (fn [_ _ claim ctx] (claim p ctx))
     :observe (fn [_ _ lens] (lens p))
     :liveness (fn [_] nil)
     :basis (fn [_]
       (let [i (swap! index inc) path (str directory "/frame-" i ".png")]
         (page/screenshot! p path)
         {:frame path :gesture (last @(:gestures p))}))
     :close! (fn [_] {})
     :views-fn (fn [basis _] basis)}))

(defn owned-world
  "Lazy single-actor browser world for scenario.demo. Opens when the scenario
   starts; closes on completion and via :dispose! after any failed action.
   opts are browser.page/open! options; directory receives actual PNGs."
  [actor opts directory]
  (let [owned (atom nil)
        delegate (atom nil)
        dispose (fn []
                  (when @owned
                    (try (page/close! @owned) (finally (reset! owned nil)))))]
    {:kind :browser
     :open (fn [_]
             (when @owned (throw (ex-info "Browser world is already open" {})))
             (let [p (page/open! opts)]
               (reset! owned p)
               (reset! delegate (world p actor directory))
               p))
     :step! (fn [p event] ((:step! @delegate) p event))
     :claim! (fn [p who claim ctx] ((:claim! @delegate) p who claim ctx))
     :observe (fn [p who lens] ((:observe @delegate) p who lens))
     :liveness (fn [_] nil)
     :basis (fn [p] ((:basis @delegate) p))
     :views-fn (fn [basis _] basis)
     :close! (fn [_] (dispose) {})
     :dispose! dispose}))
