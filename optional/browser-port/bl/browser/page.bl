(ns browser.page
  (:require [browser.port :as port] [interop]))

(defn cdp! [page method params]
  (port/request (:port page) {"op" "cdp" "sessionId" (:session page)
                             "method" method "params" params}))

(defn open!
  "Opt-in isolated native page. :launch is the browser.port launch map;
   :executable names its helper, :width/:height set the content viewport.
   The caller owns the returned page and must close it in finally."
  [opts]
  (let [p (if (:executable opts) (port/open (:executable opts)) (port/open))]
    (try
      (port/request p (assoc (:launch opts) "op" "launch"))
      (let [target (port/request p {"op" "cdp" "method" "Target.createTarget" "params" {"url" "about:blank"}})
            attached (port/request p {"op" "cdp" "method" "Target.attachToTarget"
                                     "params" {"targetId" (get target "targetId") "flatten" true}})
            page {:port p :session (get attached "sessionId")
                  :target (get target "targetId")
                  :width (or (:width opts) 1440) :height (or (:height opts) 900)
                  :started (erlang/monotonic_time :millisecond) :gestures (atom [])
                  :pointer (atom {"x" 0 "y" 0})}]
        (cdp! page "Page.enable" {})
        (cdp! page "Emulation.setDeviceMetricsOverride"
              {"width" (:width page) "height" (:height page) "deviceScaleFactor" 1 "mobile" false})
        page)
      (catch error (port/close p) (throw error)))))

(defn close! [page] (port/close (:port page)))

(defn record!
  "Stream native compositor frames to an MP4 independently of screenshots and
   scenario steps. The helper owns encoding; waits retain real elapsed time."
  [page path opts]
  (port/request (:port page) {"op" "record-start" "targetId" (:target page)
                             "width" (:width page) "height" (:height page)
                             "path" (Path/expand path) "fps" (or (:fps opts) 30)
                             "ffmpeg" (or (:ffmpeg opts) (System/find_executable "ffmpeg"))}))
(defn recording [page] (port/request (:port page) {"op" "record-info"}))
(defn stop-recording! [page] (port/request (:port page) {"op" "record-stop"}))

(defn show-cursor!
  "Capture a visible pointer bound to actual browser input, including native
   dragover coordinates. CDP screencasts omit the OS cursor. This opt-in overlay
   never drives the app, intercepts input, or substitutes an editorial path."
  [page]
  (let [script "(()=>{if(window.__blInputCursor)return;window.__blInputCursor=true;let e;const mount=()=>{if(!document.documentElement)return;e=document.createElement('div');e.dataset.browserInputCursor='true';e.setAttribute('aria-hidden','true');e.style.cssText='position:fixed;left:0;top:0;width:24px;height:30px;z-index:2147483647;pointer-events:none;display:none;filter:drop-shadow(0 1px 2px #0008)';e.innerHTML='<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 30\"><path d=\"M2 2 L2 24 L8 18 L13 28 L17 26 L12 16 L21 16 Z\" fill=\"white\" stroke=\"#151515\" stroke-width=\"2\"/></svg>';document.documentElement.appendChild(e)};const move=v=>{if(!v.isTrusted)return;if(!e||!e.isConnected)mount();if(e){e.style.display='block';e.style.transform='translate('+v.clientX+'px,'+v.clientY+'px)';e.style.opacity=v.buttons?'0.72':'1'}};for(const n of ['pointermove','pointerdown','pointerup','dragover'])document.addEventListener(n,move,true);if(document.documentElement)mount();else document.addEventListener('DOMContentLoaded',mount,{once:true});})()"]
    (cdp! page "Page.addScriptToEvaluateOnNewDocument" {"source" script})
    (evaluate! page script)))

(defn evaluate! [page script]
  (let [response (cdp! page "Runtime.evaluate" {"expression" script "returnByValue" true "awaitPromise" true})]
    (when (get response "exceptionDetails")
      (throw (ex-info "Browser evaluation raised" {:exception (get response "exceptionDetails")})))
    (get-in response ["result" "value"])))

(defn navigate! [page url]
  (let [result (cdp! page "Page.navigate" {"url" url})]
    (when (get result "errorText") (throw (ex-info "Browser navigation failed" {})))
    result))

(defn wait!
  "Wait for a JavaScript predicate, bounded by timeout-ms. A timeout is an
   execution failure, never a witness. Calls stay with the page's port owner."
  ([page script] (wait! page script 30000))
  ([page script timeout-ms]
   (let [deadline (+ (erlang/monotonic_time :millisecond) timeout-ms)]
     (loop []
       (if (= true (evaluate! page script)) true
         (if (>= (erlang/monotonic_time :millisecond) deadline)
           (throw (ex-info "Browser condition timed out" {}))
           (do (Process/sleep 50) (recur))))))))

(defn click!
  "Click a visible CSS target through real CDP input. Return normalized source
   coordinates for a film cursor keyframe; retain the gesture in :gestures."
  [page selector]
  (let [point (evaluate! page (str "(()=>{const e=document.querySelector(" (interop/->json selector)
       ");if(!e||e.disabled)throw Error('Target unavailable');e.scrollIntoView({block:'nearest'});const r=e.getBoundingClientRect();return {x:r.x+r.width/2,y:r.y+r.height/2}})()"))
        x (get point "x") y (get point "y")]
    (move-pointer! page @(:pointer page) point 600 0)
    (Process/sleep 120)
    (doseq [kind ["mousePressed" "mouseReleased"]]
      (cdp! page "Input.dispatchMouseEvent" {"type" kind "x" x "y" y
            "button" (if (= kind "mouseMoved") "none" "left") "clickCount" (if (= kind "mouseMoved") 0 1)}))
    (let [gesture {:at (/ (- (erlang/monotonic_time :millisecond) (:started page)) 1000.0)
                   :x (/ x (:width page)) :y (/ y (:height page)) :click true :selector selector}]
      (swap! (:gestures page) conj gesture)
      gesture)))

(defn fill! [page selector text]
  (evaluate! page (str "(()=>{const e=document.querySelector(" (interop/->json selector)
    ");if(!e)throw Error('Target unavailable');e.focus();e.select();return true})()"))
  (cdp! page "Input.insertText" {"text" text}))

(defn point [page selector]
  (evaluate! page (str "(()=>{const e=document.querySelector(" (interop/->json selector)
    ");if(!e||e.disabled)throw Error('Target unavailable');e.scrollIntoView({block:'nearest'});const r=e.getBoundingClientRect();if(!r.width||!r.height)throw Error('Target invisible');return {x:r.x+r.width/2,y:r.y+r.height/2}})()")))

(defn move-pointer!
  "Move trusted input from the retained position over real elapsed time. The
   smoothstep path has continuous endpoints; every dispatched point is retained."
  [page from to duration-ms buttons]
  (let [steps (max 2 (quot duration-ms 25))]
    (doseq [i (range 1 (inc steps))]
      (let [t (/ i steps) ratio (* t t (- 3 (* 2 t)))
            point {"x" (+ (get from "x") (* ratio (- (get to "x") (get from "x"))))
                   "y" (+ (get from "y") (* ratio (- (get to "y") (get from "y"))))}]
        (cdp! page "Input.dispatchMouseEvent"
          (merge point {"type" "mouseMoved" "button" (if (= 1 buttons) "left" "none") "buttons" buttons}))
        (reset! (:pointer page) point)
        (Process/sleep (quot duration-ms steps))))))

(defn hover! [page selector]
  (move-pointer! page @(:pointer page) (point page selector) 600 0))

(defn key! [page key]
  (doseq [kind ["keyDown" "keyUp"]]
    (cdp! page "Input.dispatchKeyEvent" {"type" kind "key" key
      "code" (if (= key " ") "Space" key)
      "windowsVirtualKeyCode" (get {"Enter" 13 "Escape" 27 "Tab" 9 " " 32} key 0)})))

(defn drag!
  "Drag between visible CSS targets with trusted pointer input. Its motion and
   hover feedback are captured by the independent native frame stream."
  ([page source target] (drag! page source target 1500))
  ([page source target duration-ms]
   (let [a (point page source) b (point page target)]
     (move-pointer! page @(:pointer page) a 600 0)
     (Process/sleep 180)
     (cdp! page "Input.dispatchMouseEvent" {"type" "mousePressed" "x" (get a "x") "y" (get a "y") "button" "left" "buttons" 1 "clickCount" 1})
     (try
       (Process/sleep 120)
       (move-pointer! page a b duration-ms 1)
       (finally
         (cdp! page "Input.dispatchMouseEvent" {"type" "mouseReleased" "x" (get b "x") "y" (get b "y") "button" "left" "buttons" 0 "clickCount" 1})))
     (let [gesture {:kind :drag :source source :target target :duration-ms duration-ms
                    :at (/ (- (erlang/monotonic_time :millisecond) (:started page)) 1000.0)}]
       (swap! (:gestures page) conj gesture) gesture))))

(defn screenshot!
  "Capture the actual content viewport to a PNG file, after two paint frames."
  [page path]
  (evaluate! page "new Promise(r=>requestAnimationFrame(()=>requestAnimationFrame(()=>r(true))))")
  (let [response (cdp! page "Page.captureScreenshot" {"format" "png" "captureBeyondViewport" false})]
    (File/mkdir_p! (Path/dirname path))
    (File/write! path (Base/decode64! (get response "data")))
    path))
