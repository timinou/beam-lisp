(ns browser.port
  (:require [interop]))

;; A port belongs to the process opening it. Keep the handle in an OTP worker
;; (one owner per browser); callers serialize requests through that worker.
;; The executable owns Chromium, display and stream processes, never BEAM.
(defn open
  "Open the compiled bl-browser-port executable with bounded packet-4 framing.
   This process owns the port. BL_BROWSER_PORT may name an installed artifact."
  ([] (open (or (System/get_env "BL_BROWSER_PORT")
                (System/find_executable "bl-browser-port")
                (throw (ex-info "Set BL_BROWSER_PORT to the compiled native browser helper" {})))))
  ([executable]
   (erlang/open_port (tuple :spawn_executable executable)
     (list :binary :use_stdio :exit_status (tuple :packet 4)))))

(defn request
  "Send one JSON command and await one response. Call from the owning process.
   Timeout closes the port: an uncertain operation must not be silently retried."
  ([port command] (request port command 60000))
  ([port command timeout-ms]
   (Port/command port (interop/->json command))
   (receive
     [observed [:data bytes]] :when (= port observed)
     (let [response (interop/json-> bytes)]
       (if (get response "ok") (get response "result")
         (throw (ex-info (get response "error") {:operation (get command "op")}))))
     [observed [:exit_status status]] :when (= port observed)
     (throw (ex-info "Native browser helper exited" {:status status}))
     (after timeout-ms
       (do (Port/close port)
           (throw (ex-info "Native browser request timed out; port closed" {})))))))

(defn close
  "Request a clean browser stop, then close the port. Does not delete its profile.
   Closing an unlaunched or already-exited helper is safe. Owner death is abrupt
   recovery, not an acknowledged save."
  [port]
  (try (request port {"op" "stop"} 30000)
       (catch _ nil)
       (finally (try (Port/close port) (catch _ nil)))))
