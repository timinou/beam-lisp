(ns browser.demo-test
  (:require [scenario :as s] [scenario.demo :as demo] [browser.film :as browser]
            [browser.page :as page] [interop]))

(def root (str "/tmp/bl-owned-demo-" (erlang/unique_integer (list :positive))))
(defn world [context]
  (browser/owned-world :viewer
    {:width 800 :height 600
     :launch {"chromium" (System/get_env "CHROMIUM") "compositor" (System/get_env "SWAY")
              "vnc" (System/get_env "WAYVNC") "width" 800 "height" 700}}
    (:frames context)))

(deftest one-inline-test-captures-exports-and-serves-its-film
  (File/mkdir_p! root)
  (let [audio (str root "/audio.wav")
        command (System/cmd "python3" (list "-c"
          "import wave,sys; w=wave.open(sys.argv[1],'wb'); w.setparams((1,2,48000,0,'NONE','not compressed')); w.writeframes(b'\\0\\0'*24000); w.close()" audio))
        _ (assert (= 0 (elem command 1)))
        result (demo/run! {:id "native" :output (str root "/native") :world world :export? true
                          :film {:width 640 :height 480 :fps 10}}
          (s/scenario "Un clic réel" {:viewer {}}
            [(s/does :viewer [:navigate "data:text/html;charset=utf-8,<h1>Votre dossier</h1><button id='save' onclick='this.textContent=\"Enregistré\"'>Enregistrer</button>"])
             (s/does :viewer [:wait "!!document.querySelector('#save')"])
             (demo/scene :save {:title "Enregistrer" :say "Votre dossier est enregistré." :audio audio}
               (s/does :viewer [:click "#save"])
               (s/sees :viewer (fn [p _] (= "Enregistré" (page/evaluate! p "document.querySelector('#save').textContent"))) "Saved"))]))
        scene (get-in result [:film :scenes 0])
        manifest (:manifest result)
        measured (first (get manifest "scenes"))
        handle (demo/serve! root {:port 4197})]
    (try
      (is (:ok result))
      (is (= :witnessed (get-in result [:run :verdict])))
      (is (= true (get-in scene [:cursor 0 :click])))
      (is (< (abs (- 0.45 (get-in scene [:cursor 0 :at]))) 0.000001))
      (is (= (get-in result [:run :steps 1 :basis :frame]) (get-in scene [:shots 0 :source])))
      (is (>= (get measured "subtitle_end") (get measured "audio_end")))
      (is (= (get-in result [:run :claims]) (get-in result [:presentation :claims])))
      (let [response (System/cmd "curl" (list "-fsS" "-r" "0-15" "http://127.0.0.1:4197/demo-assets/native/film/demo.mp4"))]
        (is (= 0 (elem response 1)))
        (is (= 16 (erlang/byte_size (elem response 0)))))
      (is (= 0 (elem (System/cmd "curl" (list "-fsS" "http://127.0.0.1:4197/run/native")) 1)))
      (finally (demo/stop! handle)))))

(deftest an-action-exception-closes-the-owned-native-port
  (let [opened (atom nil) context {:output (str root "/exception") :frames (str root "/exception/frames")}
        base (world context)
        wrapped (assoc base :open (fn [scen] (let [p ((:open base) scen)] (reset! opened p) p)))]
    (is (thrown-with-msg? "Browser evaluation raised"
          (demo/run! {:id "exception" :output (:output context) :world wrapped :export? false}
            (s/scenario "Failed input" {:viewer {}}
              [(demo/scene :fail {:say "Échec."} (s/does :viewer [:click "#missing"]))]))))
    (is (nil? (Port/info (:port @opened)))))
  (File/rm_rf! root))
