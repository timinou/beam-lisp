(ns browser.multiscreen-test
  (:require [scenario :as s] [scenario.demo :as demo] [browser.film :as browser]
            [browser.page :as page] [interop]))

(defn options []
  {:width 800 :height 600
   :launch {"chromium" (System/get_env "CHROMIUM") "compositor" (System/get_env "SWAY")
            "vnc" (System/get_env "WAYVNC") "width" 800 "height" 700}})

(deftest independent-pages-share-a-continuous-clock-and-retain-reference-points
  (let [root (str "/tmp/bl-multiscreen-test-" (erlang/unique_integer (list :positive)))
        opened (atom nil)
        base (browser/owned-worlds [[:writer (options)] [:viewer (options)]] (str root "/frames") {})
        world (assoc base :open (fn [scen] (let [pages ((:open base) scen)] (reset! opened pages) pages)))
        url "data:text/html,<button id='save' onclick='this.textContent=42'>Save</button>"
        result (demo/run! {:id "two-screens" :output root :world world :export? false}
          (s/scenario "Deux écrans" {:writer {} :viewer {}}
            [(s/does :writer [:navigate url]) (s/does :viewer [:navigate url])
             (s/does :writer [:wait "!!document.querySelector('#save')"])
             (s/does :viewer [:wait "!!document.querySelector('#save')"])
             (demo/scene :save {:say "Deux sessions indépendantes." :capture :video}
               (s/does :writer [:pause 500])
               (s/does :writer [:click "#save"])
               (s/sees :writer (fn [p _] (= "42" (page/evaluate! p "document.querySelector('#save').textContent"))) "Writer changes")
               (s/sees :viewer (fn [p _] (= "Save" (page/evaluate! p "document.querySelector('#save').textContent"))) "Viewer session independent"))]))
        scene (first (get-in result [:film :scenes]))
        metadata (interop/json-> (elem (System/cmd "ffprobe" (list "-v" "error" "-show_streams" "-of" "json" (:source scene))) 0))]
    (try
      (is (:ok result))
      (is (= :witnessed (get-in result [:run :verdict])))
      (is (= 1600 (get-in metadata ["streams" 0 "width"])))
      (is (= 600 (get-in metadata ["streams" 0 "height"])))
      (is (pos? (:source_start scene)))
      (is (> (:source_end scene) (:source_start scene)))
      (is (nil? (:shots scene)))
      (is (= 2 (count (get-in result [:run :steps 0 :basis :frames]))))
      (doseq [[_ p] @opened] (is (nil? (Port/info (:port p)))))
      (finally (File/rm_rf! root)))))
