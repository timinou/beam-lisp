(ns browser.port.off-test (:require [browser.port :as port]))

(deftest runtime-off-refuses-before-opening-an-executable
  (let [before (System/get_env "BL_BROWSER_ENABLED")]
    (try
      (System/put_env "BL_BROWSER_ENABLED" "0")
      (is (= "Native browser is disabled (BL_BROWSER_ENABLED=0)"
            (try (port/open "/no-browser-executable") "unexpected open"
                 (catch e (ex-message e)))))
      (finally (if before (System/put_env "BL_BROWSER_ENABLED" before)
                         (System/delete_env "BL_BROWSER_ENABLED"))))))
