(ns browser.port.test (:require [browser.port :as port]))

(deftest native-packet-protocol-and-errors
  (let [p (port/open)]
    (try
      (is (= 1 (get (port/request p {"op" "ping"}) "protocol")))
      (is (= "native" (get (port/request p {"op" "ping"}) "backend")))
      (is (try (port/request p {"op" "unknown"}) false (catch _ true)))
      ;; An application error does not corrupt framing or consume the next reply.
      (is (= 1 (get (port/request p {"op" "ping"}) "protocol")))
      (finally (port/close p)))))
