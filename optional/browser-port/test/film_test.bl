;; Opt-in headed integration. Set native runtime vars as in native_browser_test.bl.
(ns browser.film-test
 (:require [browser.page :as page] [browser.port :as port] [browser.film :as film] [scenario :as s]))

(deftest native-page-actions-and-scenario-verdicts
  (let [root (str "/tmp/bl-film-test-" (erlang/unique_integer (list :positive)))
        p (page/open! {:width 800 :height 600
             :launch {"profile" (str root "/profile") "runtime" (str root "/runtime")
                      "chromium" (System/get_env "CHROMIUM") "compositor" (System/get_env "SWAY")
                      "vnc" (System/get_env "WAYVNC") "width" 800 "height" 700}})]
    (try
      (page/navigate! p "data:text/html,<title>Demo</title><button id='go' onclick='this.textContent=42'>Click</button><input id='name'>")
      (page/wait! p "!!document.querySelector('#go')")
      (page/fill! p "#name" "Bonjour")
      (is (= "Bonjour" (page/evaluate! p "document.querySelector('#name').value")))
      (let [gesture (page/click! p "#go")]
        (is (= true (:click gesture)))
        (is (< 0 (:x gesture) 1)))
      (is (= "42" (page/evaluate! p "document.querySelector('#go').textContent")))
      (let [scenario (s/scenario "Honest film evidence" {:viewer {}}
                       [(s/sees :viewer (fn [p _] (= "42" (page/evaluate! p "document.querySelector('#go').textContent"))) "Clicked")
                        (s/sees :viewer (fn [_ _] false) "Deliberately false")])
            result (s/run-world scenario (film/world p :viewer (str root "/shots")))]
        (is (= false (:ok result)))
        (is (= [:witnessed :refuted] (mapv :verdict (:verdicts result))))
        (is (= (get-in result [:bases 0 :frame]) (get-in (s/bisect result 1) [:views :viewer :frame])))
        (is (File/exists? (get-in result [:bases 0 :frame]))))
      (is (= true (get (port/request (:port p) {"op" "stop"}) "saved")))
      (finally (page/close! p) (File/rm_rf! root)))))
