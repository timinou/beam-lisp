(ns browser.port.native-test (:require [browser.port :as port]))

(deftest actual-headed-browser-through-a-beam-port
  (let [root (str (System/tmp_dir!) "/bl-native-browser-" (erlang/unique_integer (list :positive)))
        p (port/open)]
    (try
      (let [info (port/request p {"op" "launch" "profile" (str root "/profile")
                                 "runtime" (str root "/runtime")
                                 "chromium" (System/get_env "CHROMIUM")
                                 "xvfb" (System/get_env "XVFB") "displayBackend" (or (System/get_env "BROWSER_DISPLAY_BACKEND") "wayland")
                                 "compositor" (System/get_env "SWAY")
                                 "vnc" (if (= "x11" (System/get_env "BROWSER_DISPLAY_BACKEND")) (System/get_env "X11VNC") (System/get_env "WAYVNC"))})
            created (port/request p {"op" "cdp" "method" "Target.createTarget"
                                     "params" {"url" "about:blank"}})
            attached (port/request p {"op" "cdp" "method" "Target.attachToTarget"
                                      "params" {"targetId" (get created "targetId") "flatten" true}})
            value (port/request p {"op" "cdp" "method" "Runtime.evaluate"
                                   "sessionId" (get attached "sessionId")
                                   "params" {"expression" "40 + 2" "returnByValue" true}})]
        (is (= 42 (get-in value ["result" "value"])))
        (is (File/exists? (get info "vncSocket")))
        (is (= true (get (port/request p {"op" "stop"}) "saved")))
        (is (File/exists? (str root "/profile/.bl-saved"))))
      (finally (port/close p) (File/rm_rf! root)))))
