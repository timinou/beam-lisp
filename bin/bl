#!/bin/sh
# bl — the beam-lisp CLI from a checkout, with no Mix anywhere in the path.
#
# `mix bl` existed to start the application, put the project's beams on the code
# path, and call `bl.cli/run-argv`. This does exactly those three things with
# `elixir`, so the CLI survives the day `mix.exs` is deleted — and so CI can run
# `bl` on a tree that never had Mix.
#
# Two paths, because a checkout has two states:
#
#   built      `_build/…/ebin` (or `build/` after `bl build`) holds the Elixir
#              beams; the CLI AOT-compiles its `.bl` sources on demand.
#   cold       nothing is built yet. The Elixir half is compiled straight with
#              `elixirc` — no Mix, no project file, no dependency resolution —
#              and then the CLI does the rest. This is the bootstrap: something
#              has to turn `lib/*.ex` into beams before `bl` can run, and
#              `elixirc` is the smallest thing that can.
#
# `BEAM_LISP_EBIN` overrides where the beams are looked for, which is how CI
# points a fresh checkout at an artifact another job built.
set -e

ROOT=$(CDPATH='' cd "$(dirname "$0")/.." && pwd -P)
EBIN=${BEAM_LISP_EBIN:-$ROOT/_build/dev/lib/beam_lisp/ebin}

# THE CODE PATH, computed BEFORE anything below uses it — including the cold
# bootstrap. Every beam the app depends on, not just the app's own: `mix bl`
# inherited Mix's pruning, while with no Mix these have to be found where they
# are — `_build/<env>/lib/*/ebin` for a built tree, `deps/*/ebin` for one whose
# dependencies were compiled in place, and the content-addressed cache `bl deps
# compile` writes. Without them the app cannot even load: its `.app` names its
# dependencies, and a missing one is a hard stop.
#
# ORDER IS THE BUILD'S OWN BEAMS LAST, and that is load-bearing: `-pa` PREPENDS,
# so the last one named wins. This tree has both `_build/dev` and `_build/test`;
# naming the test ebin second made it shadow the build under test, and the
# symptom was a `bl doctor --deep` that reported a function "undefined or
# private" while the beam it needed was sitting in the directory the launcher had
# just been told to prefer. Dependencies first, the tree's own image last.
PA=""
for d in "$ROOT"/deps/*/ebin "$ROOT"/_build/*/lib/*/ebin; do
  [ "$d" = "$EBIN" ] || { [ -d "$d" ] && PA="$PA -pa $d"; }
done
# FUP-050's search-path rule, shell side: the libraries `bl deps compile` built
# live in a content-addressed cache, tagged with the RUNTIME that compiled them
# (`<name>-<vsn>-<sha8>-erts<ert>-elixir<elixir>`, the same address
# `deps-compile` computes), because a beam compiled by another ERTS is not one
# this VM may load.
#
# The tag is computed in the SAME TERMS `deps-compile/runtime-tag` uses. That is
# the point of writing it out here too, rather than globbing `*`: a bare glob is a
# second, weaker rule for one question, and it would put a foreign runtime's beams
# where this one's belong. One short VM start, paid only when the cache holds
# anything at all — which is the only case where the answer changes the path.
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/beam_lisp/ebin
if [ -d "$CACHE" ] && [ -n "$(ls -A "$CACHE" 2>/dev/null || true)" ]; then
  TAG=$(elixir -e 'IO.write("erts#{:erlang.system_info(:version)}-elixir#{System.version()}")' 2>/dev/null || true)
  if [ -n "$TAG" ]; then
    for d in "$CACHE"/*-"$TAG"/ebin; do
      [ -d "$d" ] && PA="$PA -pa $d"
    done
  fi
fi

if [ ! -f "$EBIN/Elixir.BeamLisp.Application.beam" ]; then
  if [ -f "$ROOT/build/Elixir.BeamLisp.Application.beam" ]; then
    EBIN=$ROOT/build
  else
    echo "bl: no beams at $EBIN — compiling lib/ with elixirc (no Mix)" >&2
    mkdir -p "$ROOT/build"
    # `lib/dev` is deliberately absent: it is the mix-env's dev-only server, and
    # a checkout that has no Mix has no use for it either.
    find "$ROOT/lib" -name '*.ex' -not -path '*/lib/dev/*' -print > /tmp/bl-elixirc-list.$$
    # `$PA` is passed, and it is not optional: `lib/beam_lisp/daemon/http.ex` names
    # `Plug.Conn` at COMPILE time, so a cold bootstrap with no dependencies on the
    # path died with "module Plug.Conn is not loaded and could not be found" —
    # on a fresh CI checkout, where `_build/dev` does not exist because CI sets
    # MIX_ENV=test. Locally it never showed: a dev tree always has beams at
    # `_build/dev`, so this branch is not reached.
    elixirc $PA -o "$ROOT/build" --ignore-module-conflict $(cat /tmp/bl-elixirc-list.$$)
    rm -f /tmp/bl-elixirc-list.$$
    EBIN=$ROOT/build
  fi
fi

# A checkout is a development image. `env.bl` says so too (its `:env` reaches the
# real environment through the CLI), but the launcher must not depend on a file
# it is about to help read.
: "${BEAM_LISP_DEV:=1}"
export BEAM_LISP_DEV

PA="$PA -pa $EBIN"

# The boot sequence, and the one thing it was missing.
#
# `Bootstrap.install!/1` put the committed compiler floor in an ebin; until now
# its only caller was `BeamLisp.BuildTask` — the MIX build. So a checkout with no
# Mix compiled 109 Elixir modules, put them on the code path, and then died
# loading the compiler (or, on a tree whose `_build` was rebuilt, fell through to
# a source path that needs the reader to read the reader). The floor is exactly
# what a tree that has never been built needs, and installing it is a no-op when
# the ebin already holds beams stamped with this toolchain's key: `install!/1` is
# a floor, never a ceiling.
#
# Order matters in one direction only: the floor is installed BEFORE
# `ensure_all_started`, because the application's boot interns the toolchain.
export BL_EBIN="$EBIN"

exec elixir $PA -e '
  ebin = System.get_env("BL_EBIN") || Path.expand("build")

  if BeamLisp.Bootstrap.manifest() != nil do
    case BeamLisp.Bootstrap.install!(ebin) do
      {:staged, why} ->
        IO.puts(:stderr, "bl: the committed compiler floor was built by another toolchain (#{why}); using it to rebuild")

      _ ->
        :ok
    end
  end

  {:ok, _} = Application.ensure_all_started(:beam_lisp)
  BeamLisp.Loader.ensure_loaded("bl.cli")
  run = BeamLisp.Env.fetch!("bl.cli", "run-argv")
  System.halt(BeamLisp.RT.invoke(run, [System.argv()]))
' -- "$@"
