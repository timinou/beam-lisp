#!/bin/sh
# bl — the beam-lisp CLI from a checkout, with no Mix anywhere in the path.
#
# `mix bl` existed to start the application, put the project's beams on the code
# path, and call `bl.cli/run-argv`. This does exactly those three things with
# `elixir`, so the CLI survives the day `mix.exs` is deleted — and so CI can run
# `bl` on a tree that never had Mix.
#
# Two paths, because a checkout has two states:
#
#   built      `_build/…/ebin` (or `build/` after `bl build`) holds the Elixir
#              beams; the CLI AOT-compiles its `.bl` sources on demand.
#   cold       nothing is built yet. The Elixir half is compiled straight with
#              `elixirc` — no Mix, no project file, no dependency resolution —
#              and then the CLI does the rest. This is the bootstrap: something
#              has to turn `lib/*.ex` into beams before `bl` can run, and
#              `elixirc` is the smallest thing that can.
#
# `BEAM_LISP_EBIN` overrides where the beams are looked for, which is how CI
# points a fresh checkout at an artifact another job built.
set -e

ROOT=$(CDPATH='' cd "$(dirname "$0")/.." && pwd -P)

# WHERE THE BEAMS ARE. `build/` first: that is the tree's declared `:build :out`,
# it is where `bl build` writes, and it is where this script's own cold
# `elixirc` writes. `_build/…` is MIX RESIDUE, consulted only when the tree has
# never been built by `bl` — the one case where the old Mix build's beams are the
# only ones that exist. Preferring `_build` (as this script did while Mix was
# still here) meant a tree that had both booted the MIX-ERA image while
# `bl build` wrote `build/`, which is how a `bl doctor --deep` came to report a
# function "undefined or private" while the needed beam sat in the directory the
# launcher had just been told to ignore.
if [ -n "${BEAM_LISP_EBIN:-}" ]; then
  EBIN=$BEAM_LISP_EBIN
elif [ -f "$ROOT/build/Elixir.BeamLisp.Application.beam" ]; then
  EBIN=$ROOT/build
else
  EBIN=$ROOT/_build/dev/lib/beam_lisp/ebin
fi

# THE IMAGE DIRECTORY is built LOWER DOWN, once `$EBIN` is final — after the
# cold path has decided whether it had to compile anything. It has to be there
# and not here: on a tree that has never been built, `$EBIN` at this point is a
# `_build/` path that does not exist, and a link to it would be created and never
# repaired (`[ -L ] || ln` sees the dangling link as present).

# THE CODE PATH, computed BEFORE anything below uses it — including the cold
# bootstrap. Every beam the app depends on, not just the app's own: the LIBRARIES
# now live where `bl deps compile` put them (the content-addressed cache below),
# and a tree that still carries a `deps/` or a `_build/` from a Mix build is read
# from there. Without them the app cannot even load: its `.app` names its
# dependencies, and a missing one is a hard stop.
#
# ORDER IS THE BUILD'S OWN BEAMS LAST, and that is load-bearing: `-pa` PREPENDS,
# so the last one named wins. This tree has both `_build/dev` and `_build/test`;
# naming the test ebin second made it shadow the build under test, and the
# symptom was a `bl doctor --deep` that reported a function "undefined or
# private" while the beam it needed was sitting in the directory the launcher had
# just been told to prefer. Dependencies first, the tree's own image last.
PA=""
# `HAVE_LIBS` is not bookkeeping: it decides whether the substrate's DAEMON half
# can be compiled at all (see the compile step below). The machine with no
# libraries is the machine that has to run `bl deps fetch` to get them.
HAVE_LIBS=""
for d in "$ROOT"/deps/*/ebin "$ROOT"/_build/*/lib/*/ebin; do
  [ "$d" = "$EBIN" ] || { if [ -d "$d" ]; then PA="$PA -pa $d"; HAVE_LIBS=1; fi; }
done
# FUP-050's search-path rule, shell side: the libraries `bl deps compile` built
# live in a content-addressed cache, tagged with the RUNTIME that compiled them
# (`<name>-<vsn>-<sha8>-erts<ert>-elixir<elixir>`, the same address
# `deps-compile` computes), because a beam compiled by another ERTS is not one
# this VM may load.
#
# The tag is computed in the SAME TERMS `deps-compile/runtime-tag` uses. That is
# the point of writing it out here too, rather than globbing `*`: a bare glob is a
# second, weaker rule for one question, and it would put a foreign runtime's beams
# where this one's belong. One short VM start, paid only when the cache holds
# anything at all — which is the only case where the answer changes the path.
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/beam_lisp/ebin
if [ -d "$CACHE" ] && [ -n "$(ls -A "$CACHE" 2>/dev/null || true)" ]; then
  TAG=$(elixir -e 'IO.write("erts#{:erlang.system_info(:version)}-elixir#{System.version()}")' 2>/dev/null || true)
  if [ -n "$TAG" ]; then
    for d in "$CACHE"/*-"$TAG"/ebin; do
      [ -d "$d" ] && { PA="$PA -pa $d"; HAVE_LIBS=1; }
    done
  fi
fi

# THE SUBSTRATE IS RECOMPILED WHEN IT IS ABSENT **OR STALE**, and the stale half
# is not a nicety: it fired. `bin/bl` used to ask only whether
# `Elixir.BeamLisp.Application.beam` existed, so a tree that had ever booted kept
# running the beams compiled BEFORE an edit under `lib/` — no warning, no
# diagnostic. Measured: the loader fix for BUG-057 was pulled into a clone and
# appeared not to work at all; the clone's `build/` predated it and nothing
# recompiled it. (Whether a source is newer than its beam is the same question
# the build driver asks of its own tiers; here it is a `find -newer`.)
substrate_stale() {
  app="$EBIN/Elixir.BeamLisp.Application.beam"
  [ -f "$app" ] || return 0
  # A PARTIAL substrate — the core compiled on a machine that had no libraries —
  # is stale the moment those libraries arrive, and NOT before: without this the
  # daemon half would never be compiled, and with a looser rule every boot on a
  # bare machine would re-elixirc the same core.
  if [ -f "$ROOT/build/.substrate-partial" ] && [ -n "$HAVE_LIBS" ]; then return 0; fi
  [ -n "$(find "$ROOT/lib" -name '*.ex' -not -path '*/lib/dev/*' -newer "$app" -print -quit)" ]
}

if substrate_stale; then
  # `build/` current? then the question was only WHICH ebin to use (a tree that
  # also carries a Mix-era `_build/`), and there is nothing to compile.
  if [ -f "$ROOT/build/Elixir.BeamLisp.Application.beam" ] &&
     [ -z "$(find "$ROOT/lib" -name '*.ex' -not -path '*/lib/dev/*' -newer "$ROOT/build/Elixir.BeamLisp.Application.beam" -print -quit)" ]; then
    EBIN=$ROOT/build
  else
    echo "bl: compiling lib/ with elixirc (the substrate is absent, or older than its sources)" >&2
    mkdir -p "$ROOT/build"
    # `lib/dev` is deliberately absent: it is the mix-env's dev-only server, and
    # a checkout that has no Mix has no use for it either.
    find "$ROOT/lib" -name '*.ex' -not -path '*/lib/dev/*' -print > /tmp/bl-elixirc-list.$$
    # `$PA` is passed, and it is not optional: `lib/beam_lisp/daemon/http.ex` names
    # `Plug.Conn` at COMPILE time, so a cold bootstrap with no dependencies on the
    # path died with "module Plug.Conn is not loaded and could not be found" —
    # on a fresh CI checkout, where `_build/dev` does not exist because CI sets
    # MIX_ENV=test. Locally it never showed: a dev tree always has beams at
    # `_build/dev`, so this branch is not reached.
    if [ -n "$HAVE_LIBS" ]; then
      elixirc $PA -o "$ROOT/build" --ignore-module-conflict $(cat /tmp/bl-elixirc-list.$$) || exit 1
      rm -f "$ROOT/build/.substrate-partial"
    else
      # THE DAEMON HALF NEEDS THE LIBRARIES, and the machine that has none is the
      # machine that has to run `bl deps fetch`. `lib/beam_lisp/daemon/http.ex`
      # imports `Plug.Conn` at COMPILE time, so on an empty library cache the
      # whole cold bootstrap died right here —
      #
      #     error: module Plug.Conn is not loaded and could not be found
      #     == Compilation error in file lib/beam_lisp/daemon/http.ex ==
      #
      # measured on a fresh CI runner, which is the only place it can happen (a
      # dev machine always has the cache). That verb boots the LANGUAGE without
      # the application, so the daemon can be ABSENT and the core alone is enough
      # to FETCH and COMPILE the libraries. Compile the core, record what is
      # owed, and let the next boot after `bl deps compile` finish the job (the
      # `.substrate-partial` rule in `substrate_stale`).
      echo "bl: no libraries on the code path yet — compiling the core substrate only" >&2
      grep -v '^.*/lib/beam_lisp/daemon/' /tmp/bl-elixirc-list.$$ > /tmp/bl-elixirc-core.$$
      elixirc $PA -o "$ROOT/build" --ignore-module-conflict $(cat /tmp/bl-elixirc-core.$$) || exit 1
      rm -f /tmp/bl-elixirc-core.$$
      echo "daemon" > "$ROOT/build/.substrate-partial"
    fi
    rm -f /tmp/bl-elixirc-list.$$
    EBIN=$ROOT/build
  fi
fi

# A checkout is a development image. `env.bl` says so too (its `:env` reaches the
# real environment through the CLI), but the launcher must not depend on a file
# it is about to help read.
: "${BEAM_LISP_DEV:=1}"
export BEAM_LISP_DEV

# THE IMAGE DIRECTORY, now that `$EBIN` is FINAL (the cold path below may have
# just compiled into `build/` and changed it).
#
# OTP answers three questions from the SHAPE of the path a beam was loaded from —
# `code:lib_dir/1`, `code:priv_dir/1`, and therefore where a release assembly
# looks for an app's `ebin` — and it answers them by finding a path ending
# `<...>/<app>[-<vsn>]/ebin`. A checkout's beams live in `build/`, which is not
# that shape, so before this every one of those answers came from a MIX-ERA
# `_build/<env>/lib/beam_lisp/…` — the one directory on the path that WAS
# well-formed. Measured consequence: `bl self-build` from a checkout assembled a
# drop whose host beams were the mix-era copies, so the compound computed a
# toolchain key its own beams were not stamped with, and the drop died at boot
# with `undefined var: reader/delimiters` (BUG-048).
#
# The shape is built out of two symlinks: the ebin IS the build output, the priv
# IS the tree's `priv/`. Nothing is copied. `-e` rather than `-L` is load-bearing:
# a link left DANGLING by an earlier boot (the `_build` branch, on a tree that had
# none) must be repaired, and `-L` calls a dangling link present.
if [ -z "${BEAM_LISP_EBIN:-}" ]; then
  IMAGE=$ROOT/.bl/lib/beam_lisp-0.1.0
  mkdir -p "$IMAGE"
  [ -e "$IMAGE/ebin" ] || ln -sfn "$EBIN" "$IMAGE/ebin"
  [ -e "$IMAGE/priv" ] || ln -sfn "$ROOT/priv" "$IMAGE/priv"
  EBIN=$IMAGE/ebin
fi

PA="$PA -pa $EBIN"

# THE ELIXIR HALF DOES NOT RECOMPILE ITSELF. Everything else in this tree does:
# a `.bl` namespace is AOT-compiled from source on demand, so editing one is
# visible on the next command. `lib/*.ex` is not — only `bl build`'s `:ex` stage
# compiles it (env.bl `:build {:ex {:root "lib"}}`), and nothing tells the
# launcher that the beams in `$EBIN` predate the sources beside them.
#
# Measured cost of that silence (2026-09-18): a fix in `lib/beam_lisp/*.ex` was
# applied, re-run, and appeared to do nothing — three times — because the image
# was still the previous compile. "My change did nothing" and "my change did not
# compile" are indistinguishable, which is the worst property a toolchain can
# have (BUG-048's family: the tier key moved and the beams did not).
#
# So the launcher says it, once, on stderr, and gets out of the way.
if [ -z "${BL_NO_STALE_CHECK:-}" ] && [ -d "$ROOT/lib" ] && [ -d "$EBIN" ]; then
  NEWEST_BEAM=$(ls -t "$EBIN"/Elixir.BeamLisp*.beam 2>/dev/null | head -1 || true)
  if [ -n "$NEWEST_BEAM" ]; then
    STALE_SRC=$(find "$ROOT/lib" -name '*.ex' -newer "$NEWEST_BEAM" 2>/dev/null | head -1 || true)
    if [ -n "$STALE_SRC" ]; then
      echo "bl: the Elixir half is STALE — ${STALE_SRC#"$ROOT"/} is newer than $(basename "$NEWEST_BEAM")" >&2
      echo "bl: run \`bl build\` (its :ex stage compiles lib/*.ex), or BL_NO_STALE_CHECK=1 to silence this" >&2
    fi
  fi
fi

# The boot sequence, and the one thing it was missing.
#
# `Bootstrap.install!/1` put the committed compiler floor in an ebin; until now
# its only caller was `BeamLisp.BuildTask` — the MIX build. So a checkout with no
# Mix compiled 109 Elixir modules, put them on the code path, and then died
# loading the compiler (or, on a tree whose `_build` was rebuilt, fell through to
# a source path that needs the reader to read the reader). The floor is exactly
# what a tree that has never been built needs, and installing it is a no-op when
# the ebin already holds beams stamped with this toolchain's key: `install!/1` is
# a floor, never a ceiling.
#
# Order matters in one direction only: the floor is installed BEFORE
# `ensure_all_started`, because the application's boot interns the toolchain.
export BL_EBIN="$EBIN"
# The boot-tier rebuild needs the TREE root, not the ebin's parent: under Mix the
# ebin is `_build/dev/lib/beam_lisp/ebin`, whose parent holds no `priv/`.
export BL_ROOT="$ROOT"

# THE BOOT PROGRAM GOES IN A QUOTED HEREDOC, never in `-e '…'`.
#
# It used to be `exec elixir $PA -e '<program>' -- "$@"`, and that is a trap
# that fired: the program is a shell single-quoted string, so ANY apostrophe in
# it — including one inside a COMMENT — ends the quote. A comment of mine reading
# "the fetcher needs OTPs' TLS" truncated the program at that character, which
# meant the application was never started and the CLI was never dispatched: every
# command exited 0 and printed NOTHING (measured: `bl version`, `bl deps verify`,
# `bl eval` all silent for the rest of a session, with the cache blamed first).
#
# `<<'BL_BOOT'` quotes the delimiter, so the program is bytes, comments and all.
SNIPPET=$(mktemp "${TMPDIR:-/tmp}/bl-boot.XXXXXXXX")
trap 'rm -f "$SNIPPET"' EXIT INT TERM
cat > "$SNIPPET" <<'BL_BOOT'
  # NATIVES FIRST — the one thing that must exist before the language can boot
  # at all. The core LazySeq runtime loads `lazy_memo` while the prelude is being
  # interned, so a checkout that has never been built dies with "BeamLisp LazySeq
  # requires the lazy_memo native runtime" (measured on a fresh clone). Under Mix
  # that was `mix compile.beam_lisp_native`, which ran before anything else.
  #
  # NATIVES: the committed .so artefacts in priv/native are present (lazy_memo
  # included), so the application boots. Rebuilding a changed crate is a
  # LANGUAGE-level concern handled after the app is up (see below) — it cannot
  # run here because a bl namespace needs Env, which ensure_all_started starts.

  ebin = System.get_env("BL_EBIN") || Path.expand("build")

  manifest = BeamLisp.Bootstrap.manifest()

  # IS THE TIER IN `build/` THIS TREE'S? Ask the DESTINATION, not the floor: the
  # committed floor is a previous generation by design, so comparing it to the
  # current key would rebuild on every single run. What matters is whether the
  # beams this VM is about to intern are all one generation.
  key_now = BeamLisp.AOTCache.current_compiler_key()

  # `AOT.beam_provenance/1` became PUBLIC at 20:07 today; before that it exists
  # as a private fn. The launcher runs on a previous generation's beams BY
  # DESIGN, so it cannot assume any given release of the API is there — and an
  # unanswerable question is not a yes. If the API is absent the tier cannot be
  # judged, so rebuild: that is always the safe direction.
  can_judge? = Code.ensure_loaded?(BeamLisp.AOT) and function_exported?(BeamLisp.AOT, :beam_provenance, 1)

  current? =
    manifest == nil or
      (can_judge? and
         Enum.all?(BeamLisp.Tiers.boot_namespaces(), fn ns ->
        case BeamLisp.AOT.beam_provenance(BeamLisp.Link.module_for(ns)) do
          %{key: k} -> k == key_now
          {_hash, k} when is_binary(k) -> k == key_now
          _ -> false
        end
      end))

  if not current? do
        # THE TIER IS STALE OR MIXED GENERATIONS, and the floor can only COMPILE
        # tier — it must never RUN it. Serving it is how this tree produced its
        # worst failure: a VM assembled from two generations, its `reader` from
        # the floor and its `reader-node` freshly compiled, dying inside a file
        # nobody had edited (`undefined var: reader/delimiters`, or
        # `:erlang.tuple_to_list` naming reader-node.bl). So do what the sentence
        # below always said and rebuild the tier AS A UNIT, before the
        # application starts and interns it.
        #
        # This is `bl build --source-dir priv/boot`. It lives here because the
        # verb that would do it cannot START on the image this very state
        # produces — `bl build` loads `priv/build/*.bl` through the mixed loader
        # and dies in the reader (measured: BUG-090). The launcher is the only
        # layer below that failure.
        #
        # Self-limiting: the rebuild writes `build/`, so the next run's
        # `install!` finds a current destination and answers `:ok` — this costs a
        # tier rebuild once per boot-source edit, and nothing on a warm tree.
        IO.puts(:stderr, "bl: the boot tier in build/ is not this tree's generation; rebuilding it as a unit")

        root = System.get_env("BL_ROOT") || Path.dirname(ebin)

        # Run it in a CHILD VM. This process must not boot the language itself:
        # `ensure_all_started` below starts `BeamLisp.Env`, and a pre-booted Env
        # makes the application fail to start (measured: `failed_to_start_child
        # BeamLisp.Env, {:already_started, #PID<0.99.0>}`). The child builds the
        # tier and exits; this VM then starts the application on a consistent one.
        #
        # The program is passed as ARGV, never through a shell, so no quote in it
        # can truncate the boot program — the trap this file's heredoc comment
        # records.
        program = """
        ebin = hd(System.argv())
        root = System.get_env("BL_ROOT") || Path.dirname(ebin)

        # THE FLOOR IS INSTALLED HERE, IN THE CHILD. Installing it loads the
        # seed's init beams and starts `BeamLisp.Env` — harmless in a VM that is
        # only going to build and exit, and fatal in the parent (see above). A
        # tree with no `build/` has no compiler of its own, so this is also what
        # makes the rebuild possible at all.
        BeamLisp.Bootstrap.install!(ebin)
        BeamLisp.AOT.boot()
        BeamLisp.Env.add_search_path(Path.join(root, "priv/boot"))
        BeamLisp.Env.add_search_path(Path.join(root, "priv/std"))
        BeamLisp.Loader.ensure_loaded("build")
        run = BeamLisp.Env.fetch!("build", "run")

        sources =
          Path.wildcard(Path.join(root, "priv/boot/*.bl")) ++
            Path.wildcard(Path.join(root, "priv/std/multi.bl")) ++
            Path.wildcard(Path.join(root, "priv/boot/*.bl.md")) ++
            Path.wildcard(Path.join(root, "priv/boot/*.bl.org"))

        _ =
          BeamLisp.RT.invoke(run, [
            %{
              sources: sources,
              out: ebin,
              manifest: Path.join(ebin, ".beam_lisp/compile.beam_lisp"),
              force?: false,
              jobs: nil,
              log: fn msg -> IO.puts(:stderr, msg) end
            }
          ])
        """

        pa = Enum.flat_map(:code.get_path(), fn p -> ["-pa", List.to_string(p)] end)

        {_, status} =
          System.cmd(System.find_executable("elixir"), pa ++ ["-e", program, "--", ebin],
            stderr_to_stdout: true,
            into: IO.stream(:stderr, :line)
          )

        # A tier that will not compile from source is a REAL error with a real
        # subject: the source that fails, named by the child. Say so and let the
        # command fail where it actually fails — `bl seed --check` needs no tier
        # at all, and turning every verb into a boot crash is what we are fixing.
        # A tier that will not build ends the road for EVERY verb: this image has
        # no compiler of its own and the floor cannot be one. Say what failed and
        # stop, rather than starting an application whose tier is a mix of two
        # generations — the failure this whole path exists to prevent.
        if status != 0 do
          IO.puts(:stderr, "bl: the boot tier does not rebuild from source (exit #{status}); this image is unusable")
          System.halt(70)
        end
  end

  # A MACHINE WITH NO LIBRARIES CANNOT START THE APPLICATION, and one command has
  # to work on exactly such a machine. `beam_lisp.app` names its dependencies, so
  # `ensure_all_started` is a hard stop when one is absent — measured on an empty
  # library cache:
  #
  #     {:error, {:x509, {~c"no such file or directory", ~c"x509.app"}}}
  #
  # and the command that failed was `bl deps fetch`: the one that PUTS them there.
  # It cannot require what it installs. So the provisioning verb boots the
  # LANGUAGE without the application — the fetcher needs OTP's TLS, the store and
  # the reader, none of which is a hex library — while every other verb keeps the
  # strict start, where a missing dependency is a real error worth stopping for.
  argv = System.argv()

  # A FAILED START MUST BE LOUD. `{:ok, _} = Application.ensure_all_started(…)`
  # is what this used to be, and it turned the worst possible state — the
  # application's boot crashing (measured: BUG-048's deadlock, `undefined var:
  # reader/delimiters`, raised inside `BeamLisp.Application.start/2`) — into
  # SILENCE: the supervisor's exit is asynchronous, so the call answered and the
  # pattern matched, and every command then produced no output and exit 0. An
  # hour went into reading that as "the toolchain is mute" instead of "the boot
  # failed".
  #
  # `deps` is allowed to boot WITHOUT the application, because it is the verb
  # that installs the libraries the application needs (measured on an empty
  # cache: `{:error, {:x509, {…"x509.app"}}}`); everything else refuses to run
  # on a half-started image and SAYS SO, with the reason.
  provisioning? = Enum.take(argv, 1) == ["deps"]

  case Application.ensure_all_started(:beam_lisp) do
    {:ok, _} ->
      # NATIVE CRATES: the app is up (Env + loader running), so ensure every
      # defnative crate's cdylib is current via the beam-lisp builder. Fresh-
      # skipping (~1ms when all current); cargo absent → reports and continues.
      # The committed .so served the app-boot's own LazySeq; this rebuilds only
      # a crate whose Rust source changed.
      BeamLisp.Loader.ensure_loaded("vm.native")
      _ = BeamLisp.RT.invoke(BeamLisp.Env.fetch!("vm.native", "build-all!"), [])
      :ok

    other ->
      if provisioning? do
        Application.load(:beam_lisp)
        IO.puts(:stderr, "bl: the application did not start (#{inspect(other)}); running #{hd(argv)} anyway, because it installs what the application needs")
        # ... AND START THE LANGUAGE. The application is not the only way to do
        # that: `AOT.boot/0` starts `Env` and `Loader.Server` and seeds core —
        # the same bootstrap the build task runs (measured, on a bare machine:
        # without it the loader's first question, `Env.loaded_ns?`, is a
        # `GenServer.call` to a process that does not exist, and the tolerant
        # path ended in a `no process` exit 5000 ms later instead of running the
        # command it promised to run).
        BeamLisp.AOT.boot()
      else
        IO.puts(:stderr, "bl: the application did not start: #{inspect(other)}")
        IO.puts(:stderr, "bl: this image is not usable as-is; `bl build --force` rebuilds it, and `bl doctor` says what it is")
        System.halt(70)
      end
  end

  BeamLisp.Loader.ensure_loaded("bl.cli")
  run = BeamLisp.Env.fetch!("bl.cli", "run-argv")
  System.halt(BeamLisp.RT.invoke(run, [argv]))
BL_BOOT

# ── no lock: the writers are ATOMIC, which is what the lock stood in for.
#
# BUG-083's corruption was `lower.bl`'s `write-beam!` writing a beam IN PLACE at a
# path that `AOTCache.link_beams` had hardlinked to the cache's own inode, so a
# rebuild rewrote the cache under every other VM reading it. Measured without a
# boot: 20 in-place writes over a hardlinked path gave 641 torn-or-missing reads
# out of 668 in a concurrent reader; the same writes as sibling temp + rename
# gave 0. It now publishes atomically, like every other write in the tree, so a
# reader sees the old beam or the new one and no inode is ever mutated in place.
#
# The lock that used to serialize every short-lived verb on the cache root — and
# could hang one run behind another for BL_LOCK_WAIT seconds — was a stopgap for
# that, and the daemon/serve exemption it needed existed only because of the
# stopgap. Both are gone, because the reason they existed is gone. If a shared
# writer is ever added here again, make IT atomic rather than restoring the lock:
# serializing every command is what made one process able to stop all of bl.

exec elixir $PA "$SNIPPET" "$@"

