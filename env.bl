;; env.bl — this repository's project file.
;;
;; The file the tooling in this repository reads about itself: the library roots
;; its own corpus needs, the tasks worth having a name (`bl tasks` lists them,
;; `bl demo` runs one, the session's dashboard offers them as buttons), what this
;; tree IS as an application, how it builds, what to assemble, and what it
;; requires.
;;
;; `:paths` are the roots `bl` searches when it loads a namespace. The test
;; corpus under test/bl reaches into examples/ (a shape declaration, a schema, a
;; live app), so `examples` belongs here: without it `bl test test/bl/` cannot
;; resolve those names and the run fails on a missing namespace rather than on a
;; failing test.
;;
;; `:env` is put into the real environment before a command runs, which is how
;; this tree says `BEAM_LISP_DEV=1` in a way that outlives Mix: reload's mutation
;; policy used to be decided by asking whether `Elixir.Mix` was loaded, and
;; deleting Mix would have flipped every development image to production and
;; refused mutating reloads everywhere. A declaration does not disappear when a
;; dependency does.
;;
;; The three `:build`/`:release`/`:app` keys are DECLARATIONS, not state: nothing
;; here records what has been built. The build's facts live in its log outside
;; the tree, so this file can be read by any tool without side effects.
{:name "beam-lisp"
 :paths ["examples" "priv/lib"]
 :tasks
 {:demo   {:run "examples/live/11-pulse-app.bl"
           :doc "the Pulse walkthrough: one app, backend and frontend"}
  :runner {:run "examples/reload/10-ward-warm-runner.bl"
           :doc "the isolated test runner, running four adversarial files"}}
 :app
 {:name "beam_lisp"
  :vsn "0.1.0"
  :applications [:kernel :stdlib :elixir :logger :ssh
                 ;; the runtime libraries this application starts with, and
                 ;; the reason they are named HERE rather than left to a
                 ;; build tool to infer: `applications` in `beam_lisp.app` is
                 ;; what `Application.ensure_all_started(:beam_lisp)` walks,
                 ;; and the file is now written from this value (see
                 ;; `app-resource`). Measured: with x509 missing from it, a
                 ;; fresh clone died at boot with
                 ;; `{:error, {:x509, {~c"no such file or directory", ~c"x509.app"}}}`.
                 :x509 :bandit :websock_adapter :file_system :explorer :req :aws_signature
                 ;; `jason` is called from `.bl` source — `interop`, `bl.util`'s
                 ;; `--json`, `bl.install`, `vm.http` — and no Elixir manifest can
                 ;; see a `.bl` call. Naming it here is what puts it in the
                 ;; release's app closure, and so in the release itself.
                 :jason]
  :mod {:name "BeamLisp.Application" :start [:normal []]}}
 :build
 {:paths ["priv/boot" "priv/std" "priv/lib" "priv/compat" "priv/build"]
  :seed "priv/boot"
  :out "build"
  :jobs 6
  :native ["native/*"]
  :ex {:root "lib" :exclude ["dev" "mix"]}}
 :release
 {:name "bl"
  :vsn "0.1.0"
  :output "release"
  :permanent [:kernel :stdlib :elixir :beam_lisp]
  :cookie :inherit}
 :deps
 [{:name "tidewave" :vsn "0.8.2"}
  {:name "jason" :vsn "1.4.5"}
  {:name "x509" :vsn "0.9.2"}
  {:name "bandit" :vsn "1.12.4"}
  {:name "websock_adapter" :vsn "0.6.0"}
  {:name "file_system" :vsn "1.1.1"}
  {:name "phoenix_pubsub" :vsn "2.2.0"}
  {:name "rustler" :vsn "0.38.0"}
  {:name "explorer" :vsn "0.12.0"}
  {:name "req" :vsn "0.7.3"}
  {:name "aws_signature" :vsn "0.4.3"}] :env {"BEAM_LISP_DEV" "1"}}
