; tooling/test-dashboard.bl — a live test dashboard devs point at every day.
;
; Run:  BL_SERVE=1 mix beam_lisp.run --path priv tooling/test-dashboard.bl
;   (watches BL_WARD_DIR, default test/bl)
; Open: http://127.0.0.1:4042
;
; ── What it is ────────────────────────────────────────────────────────
;
; The whole ward story, watchable: point it at a directory of `.bl` test files
; and it runs them through `ward/run-sandboxed` — warm, isolated, coherence-
; guarded, always-latest, and concurrency-sound — pushing a fresh tile to the
; browser AS EACH FILE FINISHES. A file lights green when it passes, red with its
; expected-vs-actual when it fails, amber when it is CONTAINED (a crash or
; dangling ref caught in its fork). One misbehaving file never darkens another.
;
; Not a demo tucked in examples/ — tooling: the everyday view of a suite that
; cannot be contaminated by a sibling and always runs the latest source. The body
; (`reload.monitor/render-ward-view`) is the same read-model the reload monitor
; uses, so terminal and browser never disagree.

(ns tooling.test-dashboard
  (:require [reload.ward :as ward]
            [reload.monitor :as mon]
            [live.hiccup :as h]
            [web]
            [interop]))

;; ── the suite to watch (BL_WARD_DIR or a default) ────────────────────────
;;
;; WARD-ISOLATION CAVEAT. ward runs each file in an env/isolated fork, isolating
;; the var registry from :global. A test that deliberately mutates GLOBAL reload
;; state (test/bl/reload/*: reconcile/migrate drive reload/commit, which interns
;; into :global and reads it back via cross-ns caller detection) sees a DIFFERENT
;; result under ward than under `mix beam_lisp.test` — cross-ns-removal reports
;; :applied instead of :held, because the fork cannot see the caller interned in
;; :global. Such tests are NOT ward-isolation-safe; the dashboard would show a
;; FALSE failure. The default is test/bl (pure unit suites — prelude, optics,
;; core), which ARE isolation-safe.

(def test-dir
  (let [d (System/get_env "BL_WARD_DIR")]
    (if (and d (not (= d ""))) d "test/bl")))

(defn- bl-files
  "Every `.bl` file under `dir`, as source strings, read fresh on each run —
   always-latest, no compiled beam in the loop."
  [dir]
  (let [names (filter (fn [p] (String/ends_with? p ".bl"))
                      (sort (File/ls! dir)))]
    (map (fn [p] (File/read! (str dir "/" p))) names)))

;; ── the page ──────────────────────────────────────────────────────────────

(def page-style
  (str "*{box-sizing:border-box;margin:0}"
       "body{background:#0d1117;color:#e6edf3;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;padding:24px;line-height:1.5}"
       "h1{font-size:20px;margin-bottom:4px}.sub{color:#7d8590;font-size:13px;margin-bottom:20px}"
       ".dashboard{max-width:1100px;margin:0 auto}"
       ".banner{padding:12px 16px;border-radius:10px;font-weight:600;margin-bottom:18px}"
       ".banner-applied{background:#132e1a;color:#4ac26b;border:1px solid #2ea04326}"
       ".banner-held{background:#2d1416;color:#f77;border:1px solid #f8514926}"
       ".grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px}"
       ".tile{background:#161b22;border:1px solid #30363d;border-radius:10px;padding:12px;border-left:4px solid #30363d}"
       ".tile-passed{border-left-color:#2ea043}.tile-failed{border-left-color:#f85149}.tile-incoherent{border-left-color:#d29922}"
       ".tile-head{display:flex;align-items:center;gap:8px;margin-bottom:6px}"
       ".tile-glyph{font-weight:700;width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center;border-radius:4px;font-size:11px}"
       ".tile-passed .tile-glyph{background:#132e1a;color:#4ac26b}.tile-failed .tile-glyph{background:#2d1416;color:#f77}.tile-incoherent .tile-glyph{background:#2b2410;color:#d29922}"
       ".tile-ns{font-weight:600;color:#79c0ff}"
       ".tile-body{font-size:12px;color:#adbac7}.tile-test{font-weight:600;margin-bottom:2px}"
       ".tile-diff{display:flex;flex-direction:column;gap:1px}.exp{color:#7d8590}.act{color:#f77}"
       ".tile-reason{color:#d29922}"
       ;; a running tile pulses — pure CSS, no JS timer; the runner's :file-start
       ;; event is what puts a tile here.
       ".tile-running{border-left-color:#58a6ff;animation:pulse 1s ease-in-out infinite}"
       ".tile-running .tile-glyph{background:#0d2847;color:#58a6ff}"
       "@keyframes pulse{0%,100%{opacity:1}50%{opacity:.45}}"
       ".empty{color:#7d8590;padding:16px;text-align:center;grid-column:1/-1}"))

(defn- dashboard-html
  ([result] (h/hiccup->html (mon/render-ward-view result)))
  ([result running] (h/hiccup->html (mon/render-ward-view result running))))

(defn- empty-result [] {:files [] :passed 0 :failed 0 :incoherent 0 :ok? true})

(defn- page []
  (str "<!doctype html><html><head><meta charset=\"utf-8\">"
       "<title>ward - live test dashboard</title>"
       "<style>" page-style "</style></head><body>"
       "<h1>ward - live test dashboard</h1>"
       "<div class=\"sub\">" test-dir " - warm, isolated, always-latest. tiles fill in as each file finishes.</div>"
       "<div id=\"root\">" (dashboard-html (empty-result)) "</div>"
       "<script>"
       "var ws=new WebSocket((location.protocol==='https:'?'wss://':'ws://')+location.host+'/ws');"
       "ws.onmessage=function(e){document.getElementById('root').innerHTML=e.data};"
       "</script>"
       "</body></html>"))

;; ── the WebSocket: on connect, run the suite, push a frame per file ───────

(defn- partial-result
  "The file results seen SO FAR, folded into the aggregate render-ward-view
   expects — so a live push renders like the final frame, with fewer tiles."
  [seen]
  (let [passed (count (filter (fn [r] (= :passed (:status r))) seen))
        failed (count (filter (fn [r] (= :failed (:status r))) seen))
        incoh  (count (filter (fn [r] (= :incoherent (:status r))) seen))]
    {:files (vec seen) :passed passed :failed failed :incoherent incoh
     :ok? (and (= 0 failed) (= 0 incoh))}))

(defn- ws-init [_p]
  ;; Run the suite in a background process so init returns promptly. The runner
  ;; emits two events per file: :file-start (add the ns to `running`) and
  ;; :file-done (drop it from `running`, append its result to `seen`). Each event
  ;; pushes a fresh frame — so a tile appears as RUNNING, then resolves to
  ;; pass/fail/contained. run-sandboxed ⇒ multiple open dashboards never collide.
  (let [sock (erlang/self)]
    (erlang/spawn
      (fn []
        (let [seen (atom []) running (atom [])]
          (ward/run-sandboxed
            (bl-files test-dir)
            (fn [ev]
              (if (= :file-start (:phase ev))
                (swap! running (fn [s] (conj s (:ns ev))))
                (do
                  (swap! running (fn [s] (vec (filter (fn [n] (not (= n (:ns ev)))) s))))
                  (swap! seen (fn [s] (conj s (:result ev))))))
              (erlang/send sock
                [:ward-frame (dashboard-html (partial-result (deref seen))
                                             (deref running))]))))))
    [:push (list (list :text (dashboard-html (empty-result)))) {}]))

(defn- ws-handle-in [_frame state] [:ok state])
(defn- ws-handle-info [msg state]
  (if (and (sequential? msg) (= :ward-frame (first msg)))
    [:push (list (list :text (second msg))) state]
    [:ok state]))

(def ws-handlers
  {:init ws-init :handle-in ws-handle-in :handle-info ws-handle-info})

;; ── HTTP ─────────────────────────────────────────────────────────────────

(defn router [conn]
  (web/route conn
    [:get "/ws"] (web/upgrade conn ws-handlers nil)
    [:get "/"]   (web/html conn (page))
    :else        (web/text conn 404 "not found")))

(web/serve {:port 4042 :plug router})

(println (str "\n-- ward live test dashboard --"))
(println (str "  suite:  " test-dir))
(println (str "  open:   http://127.0.0.1:4042"))
(println "")

(if (contains? #{"1" "true"} (System/get_env "BL_SERVE"))
  (Process/sleep 86400000)
  (println "  (set BL_SERVE=1 to keep the dashboard running; returning now)"))
