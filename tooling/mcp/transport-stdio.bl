;; mcp/transport_stdio.bl — JSON-RPC transport over newline-delimited stdin/stdout.
;;
;; Reads lines from stdin, decodes JSON-RPC requests, dispatches to mcp.server/request,
;; encodes responses, and writes to stdout. All protocol frames go to stdout only.
;; Diagnostics and errors go to stderr. Never uses println (fatal for framing).
;;
;; Usage: (require [mcp.transport-stdio :as transport])
;;        (transport/run server)

(ns mcp.transport-stdio
  (:require [mcp.server :as server]))

;; ─────────────────────────────────────────────────────────────────────
;; Diagnostics (stderr only)
;; ─────────────────────────────────────────────────────────────────────

(defn- log-stderr
  "Write a diagnostic message to stderr."
  [msg]
  (IO/puts :stderr msg))

;; ─────────────────────────────────────────────────────────────────────
;; Read stdin loop
;; ─────────────────────────────────────────────────────────────────────

(defn- read-line-safe
  "Read a line from stdin. Returns the line string, or :eof on end-of-file."
  []
  (let [line (try
               (IO/read :stdio :line)
               (catch _error
                 (log-stderr "Read error")
                 :eof))]
    (if (or (= line :eof) (nil? line)) :eof line)))

(defn- parse-json-request
  "Decode a JSON string into a map. On failure, write error to stderr and return nil."
  [line]
  (try
    (Jason/decode! line)
    (catch _error
      (log-stderr "JSON decode error")
      nil)))

(defn- format-response
  "Encode a response map to JSON string for output."
  [response]
  (try
    (Jason/encode! response)
    (catch _error
      (log-stderr "JSON encode error")
      nil)))

(defn- process-request
  "Dispatch a request to the server, get the response, and format it.
   Returns the JSON string to write, or nil if encoding fails."
  [server request]
  (try
    (let [response (server/request server request)]
      (format-response response))
    (catch _error
      (log-stderr "Request processing error")
      nil)))

;; ─────────────────────────────────────────────────────────────────────
;; Main loop
;; ─────────────────────────────────────────────────────────────────────

(defn- main-loop
  "Read requests from stdin in a loop. Dispatch each to the server.
   Stop on EOF."
  [server]
  (loop []
    (let [line (read-line-safe)]
      (cond
        (= line :eof)
        (do
          (log-stderr "EOF on stdin, shutting down")
          :done)

        (empty? line)
        ;; Skip empty lines (continuation)
        (recur)

        :else
        ;; Parse and dispatch
        (let [request (parse-json-request line)]
          (if (some? request)
            (let [response (process-request server request)]
              (when (some? response)
                (IO/puts :stdio response))
              (recur))
            ;; Parse failed, skip this line and continue
            (recur)))))))

;; ─────────────────────────────────────────────────────────────────────
;; Public API
;; ─────────────────────────────────────────────────────────────────────

(defn run
  "Start the stdio transport with an MCP server.
   Reads newline-delimited JSON-RPC requests from stdin,
   dispatches to the server, writes responses to stdout.
   Diagnostics go to stderr. Blocks until EOF."
  [server]
  (main-loop server))

(defn main
  "Entry point when run as a script.
   Starts an MCP server and runs the stdio transport."
  []
  (let [server (server/start)]
    (try
      (run server)
      (finally
        (server/stop server)))))
