;; mcp/stdio_main.bl — the stdio MCP server entry point.
;;
;; Frames: newline-delimited JSON-RPC on stdout. Diagnostics: stderr.
;; This is the process an MCP client spawns.
;;
;; Pipe a request in to smoke-test:
;;   printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"server/discover",
;;     "_meta":{"io.modelcontextprotocol/protocolVersion":"2026-07-28"}}' \
;;     | run-bl.sh .../stdio_main.bl

(ns mcp.stdio-main
  (:require [mcp.transport-stdio :as transport]))

(transport/main)
