#!/bin/sh
# The bootstrap floor is committed state that must match the boot tier.
#
# `priv/bootstrap/seed/` is the pre-compiled compiler every unbooted tree starts
# from. When `priv/boot/` moves and the floor does not, the floor goes on
# answering for the old sources: the VM assembles a MIXED generation and the
# first failure names a variable in a file that was never at fault —
# `undefined var: vm.catalog/defonce` (BUG-089), from a `defonce` that existed
# in `priv/boot/core.bl` and did not exist in the floor. Nothing else in the
# toolchain catches that, because nothing else knows the floor is supposed to
# track the boot tier.
#
# So when a commit touches the floor's own sources, `bl seed` is the gate:
#
#   * current floor, current build  -> it republishes nothing, and passes;
#   * current build, stale floor    -> it republishes the floor, and the hook
#                                      stages the refreshed floor into the SAME
#                                      commit, which is the whole point;
#   * stale build                   -> it only WARNS. See below.
#
# A STALE FLOOR IS NO LONGER A CORRECTNESS GATE. `bin/bl` rebuilds the boot tier
# AS A UNIT whenever `build/` is not this tree's generation (launcher, aa97c576),
# so a tree that has ever built cannot assemble a mixed VM from a stale floor —
# a stale floor costs the NEXT unbooted tree one rebuild, which is a service to
# cold clones rather than a soundness condition. A hook that refuses a commit
# over it is a hook people learn to bypass, and the refusal names a repair
# (`bl build`) that cannot run in exactly the state that triggers it.
#
# `priv/std/multi.bl` is in the list because the floor's closure includes it:
# `multi` is not a tier file, but the compiler needs it, so `seed.bl` seeds it.
#
# Deliberately NOT run for every commit. A change to `lib/*.ex` moves the
# toolchain key but leaves the floor a valid PREVIOUS generation — that is the
# staging path, by design, and `Bootstrap.install!` handles it. Gating on that
# would make this hook fire constantly and train everyone to skip it.
set -e

staged=$(git diff --cached --name-only --diff-filter=ACMR)

case "$staged" in
  *priv/boot/*|*priv/std/multi.bl*)
    if ./bin/bl seed; then
      git add priv/bootstrap/seed
    else
      echo "pre-commit: WARNING — the bootstrap floor could not be republished." >&2
      echo "pre-commit: the commit proceeds; the launcher rebuilds a stale tier as a unit." >&2
      echo "pre-commit: refresh it for cold clones later with:  ./bin/bl build && ./bin/bl seed" >&2
    fi
    ;;
esac

exit 0
