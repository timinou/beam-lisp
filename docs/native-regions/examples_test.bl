; Validate the guide's runnable BL and native-IR examples from their source.
; Run with the ordinary BL test runner. NATIVE_PROBE enables native IR checks.
(ns native-regions-guide.test)

(defn- code-blocks [path language]
  (let [parts (rest (String/split (File/read! path) (str "```" language "\n")))]
    (mapv (fn [part] (String/trim (first (String/split part "```")))) parts)))

; The first chapter contains two complete BL definitions, not copied fixtures.
(doseq [source (code-blocks "docs/native-regions/01-meaning-and-execution.typ" "clojure")]
  (BeamLisp.Compiler/eval_string source))

(doseq [source (filter (fn [s] (or (String/contains? s "(defn scale")
                                   (String/contains? s "(defn guarded-scale")))
                       (code-blocks "docs/native-regions/02-from-source-to-regions.typ" "clojure"))]
  (BeamLisp.Compiler/eval_string source))

(deftest purity-does-not-imply-totality
  (is (= 0 (guarded-scale 3)))
  (is (= 50 (guarded-scale 5)))
  (is (thrown? (scale 3))))

(deftest executable-pipeline-examples
  (let [bytes (erlang/list_to_binary (list 0 40 255))]
    (is (= 138 (map-filter-sum bytes 0)))
    (is (= 138 (fused-reference bytes 0)))
    (is (= 134 (map-filter-sum bytes 18446744073709551612)))
    (is (= 134 (fused-reference bytes 18446744073709551612)))
    (is (= 7 (map-filter-sum "" 7)))
    (is (= 7 (fused-reference "" 7))))
  (let [all (erlang/list_to_binary (to-list (range 256)))]
    (is (= 8128 (map-filter-sum all 0)))
    (is (= 8128 (fused-reference all 0)))))

(deftest grouping-is-observable
  (is (= 1.0 (BeamLisp.Compiler/eval_string "(+ (+ 1e16 -1e16) 1)")))
  (is (= 0.0 (BeamLisp.Compiler/eval_string "(+ 1e16 (+ -1e16 1))"))))

(defn- minimum-ir []
  (first (filter (fn [s] (String/starts_with? s "kernel fused-min"))
                 (code-blocks "docs/native-regions/06-building-and-checking.typ" "text"))))

(defn- count-ir []
  (let [base (minimum-ir)
        snippet (first (filter (fn [s] (String/starts_with? s "lt  "))
                               (code-blocks "docs/native-regions/06-building-and-checking.typ" "text")))
        start (first (String/split base "lt 13 11 12"))
        tail (second (String/split base "loop 3 1 1"))]
    (when (or (nil? snippet) (nil? tail))
      (throw (ex-info "Count recipe markers changed; update its assembly check" {})))
    (String/replace (str start snippet "\nloop 3 1 1" tail) "fused-min" "fused-count")))

(defn- port-read [port]
  (receive
    [p [:data payload]] :when (= p port) payload
    [p [:exit_status status]] :when (= p port)
      (throw (ex-info "Guide native example exited" {:status status}))
    (after 30000 (throw (ex-info "Guide native example timed out" {})))))

(defn- u64 [n]
  (erlang/list_to_binary (to-list (map (fn [i] (erlang/band (erlang/bsr n (* 8 i)) 255))
                                      [7 6 5 4 3 2 1 0]))))

(defn- read-u64 [bytes]
  (reduce (fn [n b] (+ (* 256 n) b)) 0 (binary/bin_to_list (binary/part bytes 0 8))))

(defn- native-example [executable path cases]
  (let [port (erlang/open_port (tuple :spawn_executable (erlang/binary_to_list executable))
                 (list :binary (tuple :packet 4) :exit_status
                       (tuple :args (list "--serve-fold" path))))]
    (try
      (is (= "READY" (port-read port)))
      (doseq [[bytes init expected] cases]
        (erlang/port_command port (list (u64 init) bytes))
        (let [reply (port-read port)]
          (is (= 16 (erlang/byte_size reply)))
          (is (= expected (read-u64 reply)))))
      (finally
        (when (not= :undefined (erlang/port_info port)) (Port/close port))))))

(deftest native-extension-recipes
  (let [probe (System/get_env "NATIVE_PROBE")]
    (if probe
      (let [made (System/cmd "mktemp" (list "-d" "/tmp/native-guide.XXXXXX"))
            _ (is (= 0 (elem made 1)))
            work (String/trim (elem made 0))
            min-path (str work "/min.ir")
            count-path (str work "/count.ir")
            all (erlang/list_to_binary (to-list (range 256)))
            edge (erlang/list_to_binary (list 40 211))]
        (File/write! min-path (minimum-ir))
        (File/write! count-path (count-ir))
        (native-example probe min-path
          [["" 4294967295 4294967295] [all 4294967295 0] [edge 4294967295 127]])
        (native-example probe count-path [["" 0 0] [all 0 128] [edge 0 1]]))
      (println "SKIP native IR execution: set NATIVE_PROBE to a built j1_probe"))))

(run-tests)
