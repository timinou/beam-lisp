(ns engineering.support-probe)
(let [root "/home/user/tmp/engineering-followups/support-projection"
      module :Elixir.BeamLisp.NativeSupportProbe
      source "/home/user/code/undefine/beam-lisp--async-code-ownership/priv/host/aot.bl"
      result (BeamLisp.AOT/compile_host_file source
               (list (tuple :module module) (tuple :output_dir root) (tuple :load? false)))]
 (println "COMPILED" result)
 (code/load_binary module (erlang/binary_to_list (elem result 1)) (File/read! (elem result 1)))
 (doseq [n ["sugar" "compiler" "lower" "anf" "core" "rt" "reader-node" "diag" "reader"]]
  (println "BODY" n (Code/ensure_loaded? (Module/concat (list :Elixir.BeamLisp.Ns.Body (Macro/camelize n))))))
 (try
  (let [names (list "core" "sugar" "rt" "compiler" "lower" "anf" "reader-node" "diag" "reader")
        start (System/monotonic_time :microsecond)
        support (erlang/apply module :package_support_projection
                  (list (list "sugar" "compiler" "lower" "anf") names 100000))
        elapsed (- (System/monotonic_time :microsecond) start)]
   (println "SUPPORT_OK" elapsed (pr-str support)))
  (catch e (println "SUPPORT_ERROR" (pr-str e))))
 (let [baseline (erlang/apply module :local_package_authority (list))
       original (BeamLisp.Env/fetch! "core" "list")
       declaration (BeamLisp.Env/lookup (tuple :refer "compiler" "list"))]
  (println "BASELINE" baseline)
  (assert (string? baseline))
  (File/write! (str root "/authority.txt") baseline)
  (try
   (BeamLisp.Env/intern "core" "list" :invalid_list_callable)
   (assert (not= baseline (erlang/apply module :local_package_authority (list))))
   (println "LIST_OVERRIDE_OK")
   (finally (BeamLisp.Env/intern "core" "list" original)))
  (assert (= baseline (erlang/apply module :local_package_authority (list))))
  (try
   (BeamLisp.Env/add_refer "compiler" "list" "core")
   (assert (not= baseline (erlang/apply module :local_package_authority (list))))
   (println "REFER_REDIRECT_OK")
   (finally (if (= :error declaration)
              (BeamLisp.Env/delete_key (tuple :refer "compiler" "list"))
              (BeamLisp.Env/put_key (tuple :refer "compiler" "list") (elem declaration 1)))))
  (assert (= baseline (erlang/apply module :local_package_authority (list))))))
