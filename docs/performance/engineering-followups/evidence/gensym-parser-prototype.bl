(ns engineering.gensym-prototype)
(BeamLisp.Compiler/eval_string "(ns engineering.gensym-parser)\n(defn- gensym-digits? [digits]\n  (loop [offset 0]\n    (if (= offset (erlang/byte_size digits)) true\n      (let [digit (binary/at digits offset)]\n        (if (and (>= digit 48) (<= digit 57)) (recur (inc offset)) false)))))\n\n(defn- gensym-base\n  \"`base` of a BAKED template gensym `base__N__auto`, or nil when `name` is\n   not one. A canonical `base__N__c` is deliberately NOT matched.\n   Binary recognition carries no node-local regular-expression resource.\"\n  [name]\n  (let [size (erlang/byte_size name)\n        ;; The anchored pattern accepts exactly one terminal LF; its dot\n        ;; excludes LF inside the nonempty base. All offsets count bytes.\n        end (if (and (> size 0) (= 10 (binary/at name (dec size)))) (dec size) size)]\n    (when (and (>= end 10) (= \"__auto\" (binary/part name (- end 6) 6)))\n      (let [body (binary/part name 0 (- end 6))\n            matches (binary/matches body \"__\")]\n        (when (seq matches)\n          (let [last-position (elem (lists/last matches) 0)\n                ;; matches is non-overlapping. An odd underscore run leaves\n                ;; one overlapping delimiter to the right of its last match.\n                position (if (and (< (+ last-position 2) (erlang/byte_size body))\n                                  (= 95 (binary/at body (+ last-position 2))))\n                           (inc last-position) last-position)\n                digits-offset (+ position 2)\n                digits-size (- (erlang/byte_size body) digits-offset)]\n            (when (and (> position 0) (> digits-size 0)\n                       (= :nomatch (binary/match (binary/part body 0 position) \"\\n\"))\n                       (gensym-digits? (binary/part body digits-offset digits-size)))\n              (binary/part body 0 position))))))))\n\n")
(BeamLisp.Compiler/eval_string "(ns engineering.gensym-candidates)\n(defn candidates []\n  (let [alphabet [\"x\" \"_\" \"1\" \"é\" \"💡\" \"\\u0000\" \"\\n\" \"\\r\"]\n        bases (concat [\"\" \"xy\" \"___\" \"x___\" \"x______\" \"\\t\" \"a\\r\\nb\"\n                       (erlang/list_to_binary (list 255 0 120))]\n                alphabet\n                (for [a alphabet b alphabet] (str a b))\n                (for [a alphabet b alphabet c alphabet] (str a b c)))]\n    (vec (for [base bases digits [\"0\" \"01\" \"99\" \"\" \"a\" \"١\" \"1_\" \"1\\n\"]\n               suffix [\"__auto\" \"__auto\\n\" \"__auto\\n\\n\" \"__c\"]]\n           (str base \"__\" digits suffix)))))\n\n")

(defn sample [action names]
 (let [started (erlang/monotonic_time :microsecond)
       before (elem (erlang/process_info (erlang/self) :reductions) 1)
       checksum (reduce (fn [sum name] (let [answer (action name)] (+ sum (if answer (erlang/byte_size answer) 0)))) 0 names)]
  {:wall-us (- (erlang/monotonic_time :microsecond) started)
   :reductions (- (elem (erlang/process_info (erlang/self) :reductions) 1) before)
   :calls (count names) :checksum checksum}))
(defn run []
 (let [parsed (BeamLisp.Env/fetch_exact! "engineering.gensym-parser" "gensym-base")
       parser (fn [name] (BeamLisp.Ns.Rt/invoke parsed (list name)))
       regex (Regex/compile! "^(.+)__[0-9]+__auto$")
       oracle (fn [name] (let [match (Regex/run regex name)] (when match (second match))))
       names (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! "engineering.gensym-candidates" "candidates") (list))]
  (doseq [name names]
   (assert (= (oracle name) (parser name)) (str "PARSER_MISMATCH " (Kernel/inspect (erlang/binary_to_list name)))))
  (println "GENSYM_PARITY_OK" (count names))
  (let [ordinary (vec (map (fn [n] (str "normal-symbol-" n)) (range 1000)))
        baked (vec (map (fn [n] (str "é__base___" n "__auto")) (range 1000)))
        edge (vec (take 1000 names))]
   (doseq [input [ordinary baked edge]] (sample oracle input) (sample parser input))
   (doseq [round (range 8)]
    (doseq [[label input] [[:ordinary ordinary] [:baked baked] [:edge edge]]]
     (doseq [[mode action] (if (even? round) [[:regex oracle] [:binary parser]] [[:binary parser] [:regex oracle]])]
      (println "GENSYM_SAMPLE" round label mode (pr-str (sample action input)))))))
  (println "GENSYM_BENCH_OK")
  (let [module :Elixir.BeamLisp.GensymAuthorityProbe
        output "/home/user/tmp/engineering-followups/gensym-authority-probe"
        saved (BeamLisp.Env/lookup (tuple "compiler" "gensym-re"))]
   (File/mkdir_p! output)
   (BeamLisp.AOT/compile_host_file "/home/user/code/undefine/beam-lisp--engineering-followups/priv/host/aot.bl"
    (list (tuple :module module) (tuple :output_dir output) (tuple :load? true)))
   (try
    (BeamLisp.Env/delete_key (tuple "compiler" "gensym-re"))
    (doseq [n ["sugar" "compiler" "lower" "anf"]]
     (assert (Code/ensure_loaded? (Module/concat (list :Elixir.BeamLisp.Ns.Body (Macro/camelize n))))))
    (let [authority (erlang/apply module :local_package_authority (list))]
     (println "GENSYM_AUTHORITY" authority)
     (assert (string? authority)))
    (println "GENSYM_AUTHORITY_OK")
    (finally (when (= :ok (elem saved 0))
               (BeamLisp.Env/put_key (tuple "compiler" "gensym-re") (elem saved 1))))))))
(run)
