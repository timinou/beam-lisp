(ns engineering.support-fresh)
(let [root "/home/user/tmp/engineering-followups/support-projection"
      module :Elixir.BeamLisp.NativeSupportProbe
      path (str root "/Elixir.BeamLisp.NativeSupportProbe.beam")]
 (code/load_binary module (erlang/binary_to_list path) (File/read! path))
 (doseq [n ["sugar" "compiler" "lower" "anf" "core" "rt" "reader-node" "diag" "reader"]]
  (assert (Code/ensure_loaded? (Module/concat (list :Elixir.BeamLisp.Ns.Body (Macro/camelize n))))))
 (let [actual (erlang/apply module :local_package_authority (list))]
  (println "FRESH_AUTHORITY" actual)
  (assert (= (File/read! (str root "/authority.txt")) actual))
  (println "FRESH_SUPPORT_OK")
  (try
   (BeamLisp.Env/intern "core" "support-probe-unrelated" :unrelated)
   (assert (= actual (erlang/apply module :local_package_authority (list))))
   (println "UNRELATED_CORE_VALUE_OK")
   (finally (BeamLisp.Env/delete_key (tuple "core" "support-probe-unrelated"))))
  (doseq [trial (range 20)]
   (doseq [candidate (if (even? trial) [:Elixir.BeamLisp.AOT module] [module :Elixir.BeamLisp.AOT])]
    (let [start (System/monotonic_time :microsecond)
          stamp (erlang/apply candidate :local_package_authority (list))
          elapsed (- (System/monotonic_time :microsecond) start)]
     (assert (string? stamp))
     (println "AUTHORITY_SAMPLE" trial candidate elapsed))))))
