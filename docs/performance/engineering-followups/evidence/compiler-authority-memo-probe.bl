(ns engineering.support-probe)
(let [result (BeamLisp.AOT/compile_host_file
               "/home/user/code/undefine/beam-lisp--async-code-ownership/priv/host/env.bl"
               (list (tuple :module :Elixir.BeamLisp.Env)
                     (tuple :output_dir "/home/user/tmp/engineering-followups/support-projection")
                     (tuple :load? false)))]
 (code/load_binary :Elixir.BeamLisp.Env (erlang/binary_to_list (elem result 1)) (File/read! (elem result 1)))
 (println "ENV_LIFETIME_FIX_LOADED"))
(let [root "/home/user/tmp/engineering-followups/support-projection"
      module :Elixir.BeamLisp.NativeSupportProbe
      source "/home/user/code/undefine/beam-lisp--async-code-ownership/priv/host/aot.bl"
      result (BeamLisp.AOT/compile_host_file source
               (list (tuple :module module) (tuple :output_dir root) (tuple :load? false)))]
 (println "COMPILED" result)
 (code/load_binary module (erlang/binary_to_list (elem result 1)) (File/read! (elem result 1)))
 (doseq [n ["sugar" "compiler" "lower" "anf" "core" "rt" "reader-node" "diag" "reader"]]
  (println "BODY" n (Code/ensure_loaded? (Module/concat (list :Elixir.BeamLisp.Ns.Body (Macro/camelize n))))))
 (try
  (let [names (list "core" "sugar" "rt" "compiler" "lower" "anf" "reader-node" "diag" "reader")
        start (System/monotonic_time :microsecond)
        support (erlang/apply module :package_support_projection
                  (list (list "sugar" "compiler" "lower" "anf") names 100000))
        elapsed (- (System/monotonic_time :microsecond) start)]
   (println "SUPPORT_OK" elapsed (pr-str support)))
  (catch e (println "SUPPORT_ERROR" (pr-str e))))
 (let [baseline (erlang/apply module :local_package_authority (list))
       original (BeamLisp.Env/fetch! "core" "list")
       declaration (BeamLisp.Env/lookup (tuple :refer "compiler" "list"))]
  (println "BASELINE" baseline)
  (assert (string? baseline))
  (File/write! (str root "/authority.txt") baseline)
  (try
   (BeamLisp.Env/intern "core" "list" :invalid_list_callable)
   (assert (not= baseline (erlang/apply module :local_package_authority (list))))
   (println "LIST_OVERRIDE_OK")
   (finally (BeamLisp.Env/intern "core" "list" original)))
  (assert (= baseline (erlang/apply module :local_package_authority (list))))
  (try
   (BeamLisp.Env/add_refer "compiler" "list" "core")
   (assert (not= baseline (erlang/apply module :local_package_authority (list))))
   (println "REFER_REDIRECT_OK")
   (finally (if (= :error declaration)
              (BeamLisp.Env/delete_key (tuple :refer "compiler" "list"))
              (BeamLisp.Env/put_key (tuple :refer "compiler" "list") (elem declaration 1)))))
  (assert (= baseline (erlang/apply module :local_package_authority (list))))))
(let [module :Elixir.BeamLisp.NativeSupportProbe
      key (tuple module :package_authority_memo)
      baseline (erlang/apply module :local_package_authority (list))
      memo (Process/get key)
      original (BeamLisp.Env/fetch! "compiler" "mod-num")
      alias (BeamLisp.Env/lookup (tuple :alias "compiler" "list"))]
 (assert (= baseline (erlang/apply module :local_package_authority (list))))
 (assert (= memo (Process/get key)))
 (try
  (BeamLisp.Env/intern "authority.unrelated" "initialized" true)
  (assert (= baseline (erlang/apply module :local_package_authority (list))))
  (assert (= (:projection_epoch memo) (:projection_epoch (Process/get key))))
  (println "UNRELATED_INIT_CACHE_HIT_OK")
  (finally (BeamLisp.Env/delete_key (tuple "authority.unrelated" "initialized"))))
 (try
  (BeamLisp.Env/intern "compiler" "mod-num" :invalid_numeric_provider)
  (assert (not= baseline (erlang/apply module :local_package_authority (list))))
  (println "LITERAL_INVALIDATION_OK")
  (finally (BeamLisp.Env/intern "compiler" "mod-num" original)))
 (assert (= baseline (erlang/apply module :local_package_authority (list))))
 (try
  (BeamLisp.Env/add_alias "compiler" "list" "core")
  (assert (not= baseline (erlang/apply module :local_package_authority (list))))
  (println "ALIAS_INVALIDATION_OK")
  (finally (if (= :error alias)
             (BeamLisp.Env/delete_key (tuple :alias "compiler" "list"))
             (BeamLisp.Env/put_key (tuple :alias "compiler" "list") (elem alias 1)))))
 (assert (= baseline (erlang/apply module :local_package_authority (list))))
 (let [environment (BeamLisp.Env/fork :global)]
  (BeamLisp.Env/with_env environment
   (fn []
    (assert (= baseline (erlang/apply module :local_package_authority (list))))
    (assert (= environment (:env (Process/get key))))))
  (BeamLisp.Env/destroy environment)
  (assert (nil? (BeamLisp.Env/with_env environment (fn [] (erlang/apply module :local_package_authority (list))))))
  (assert (nil? (Process/get key)))
  (println "DESTROYED_ENV_DECLINES_OK"))
 (assert (= baseline (erlang/apply module :local_package_authority (list))))
 (let [body :"Elixir.BeamLisp.Ns.Body.Reader-node"
       object (code/get_object_code body)
       forms (list (tuple :attribute 1 :module body)
                   (tuple :attribute 1 :export (list (tuple :support_marker 0)))
                   (tuple :function 1 :support_marker 0
                     (list (tuple :clause 1 (list) (list) (list (tuple :atom 1 :changed))))))
       compiled (compile/forms forms (list :binary :return))]
  (assert (= body (elem object 0)))
  (assert (= :ok (elem compiled 0)))
  (try
   (BeamLisp.Env/publish_binaries! (list (tuple body (elem compiled 2))) (str "/home/user/tmp/engineering-followups/support-projection/changed-body.beam"))
   (assert (not= baseline (erlang/apply module :local_package_authority (list))))
   (println "BACKING_MODULE_INVALIDATION_OK")
   (finally (BeamLisp.Env/publish_binaries! (list (tuple body (elem object 1))) (erlang/list_to_binary (elem object 2)))))
  (assert (= baseline (erlang/apply module :local_package_authority (list)))))
 (doseq [trial (range 20)]
  (let [start (System/monotonic_time :microsecond)
        stamp (erlang/apply module :local_package_authority (list))
        elapsed (- (System/monotonic_time :microsecond) start)]
   (assert (= baseline stamp))
   (println "MEMO_SAMPLE" trial elapsed)))
 (println "MEMO_ENTRIES" (erlang/map_size (Process/get key))
          (count (:names (Process/get key))) (count (:fingerprints (Process/get key)))))
