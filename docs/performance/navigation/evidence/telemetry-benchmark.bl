(ns navigation-observability-benchmark
 (:require [live.measure :as measure] [diagnostics :as diag]))
(defn workload []
 (measure/navigation
  (measure/phase :view (measure/phase :screen :screen))
  (measure/phase :realize :tree)
  (measure/phase :diff :patch)
  (measure/phase :styles :css)))
(defn trial [mode]
 (let [records (atom 0)]
  (diag/with-options {:sink (when (not= mode :disabled) (fn [_] (swap! records inc)))
                      :min-level (if (= mode :debug) :debug :info)}
   (doseq [_ (range 20)] (workload))
   (reset! records 0)
   (let [started (erlang/monotonic_time :microsecond)
         reductions (elem (erlang/process_info (erlang/self) :reductions) 1)]
    (doseq [_ (range 200)] (workload))
    {:mode mode :us-per-navigation (/ (- (erlang/monotonic_time :microsecond) started) 200.0)
     :reductions-per-navigation (/ (- (elem (erlang/process_info (erlang/self) :reductions) 1) reductions) 200.0)
     :records @records}))))
(println (pr-str {:fixture "empty phase bodies; telemetry overhead only"
 :trials (vec (mapcat (fn [round] (mapv trial (if (even? round) [:disabled :info :debug] [:debug :info :disabled]))) (range 8)))}))
