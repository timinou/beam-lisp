; Measure first use after optional warming; warming relocates work, not removes it.
; ready-us covers policy/hook scheduling, excluding VM and entry startup.
(ns startup-six.async-bench (:require [bl.loading :as loading]))
(defn now [] (erlang/monotonic_time :microsecond))
(defn run [mode]
 (let [id (str (System/pid) "x" (erlang/unique_integer (list :positive)))
       ns (str "startup.async.p" id)
       root (Path/join (System/tmp_dir) (str "async-bench-" id))
       file (Path/join root (str (String/replace ns "." "/") ".bl"))
       entry (Path/join root "entry.bl")
       policy {:loading {:environment-env "STARTUP_ASYNC_BENCH" :development mode}}]
  (File/mkdir_p! (Path/dirname file))
  (File/write! file (str "(ns " ns ")\n"
    (join "\n" (mapv (fn [i] (str "(defn f" i " [x] (+ x " i "))")) (range 64)))))
  (File/write! entry (str "(ns startup.async.entry (:require [" ns "]))"))
  (try
   (BeamLisp.Loader/with_ambient_dirs (list root)
    (fn []
     (let [start (now) _ (loading/prepare! policy entry)
           pid (loading/start-background! policy entry) ready (now)
           _ (when pid
               (let [ref (erlang/monitor :process pid)]
                (receive [:DOWN ref :process pid reason]
                         (when (not= :normal reason) (throw {:worker-exit reason}))
                         (after 60000 (throw :warm-timeout)))))
           warm (now)
           _ (when (and pid (not (BeamLisp.Env/loaded_ns? ns))) (throw :warming-did-not-load))
           before (elem (erlang/statistics :reductions) 0)
           _ (BeamLisp.Loader/ensure_loaded ns)]
      {:mode mode :ready-us (- ready start) :background-us (- warm ready)
       :first-use-us (- (now) warm)
       :request-reductions (- (elem (erlang/statistics :reductions) 0) before)})))
   (finally (File/rm_rf! root)))))
(let [prior (System/get_env "STARTUP_ASYNC_BENCH")]
 (try
  (System/put_env "STARTUP_ASYNC_BENCH" "development")
  (doseq [round (range 2) mode [:lazy :async :async :lazy]]
   (println (pr-str (assoc (run mode) :round round))))
  (finally (if prior (System/put_env "STARTUP_ASYNC_BENCH" prior)
              (System/delete_env "STARTUP_ASYNC_BENCH")))))
