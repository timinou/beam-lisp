; Same script on baseline/candidate SDK; source preparation excluded from build.
(ns startup-six.rank-bench
 (:require [env] [datom :as d] [datom.conn :as conn] [datom.db :as db]
           [datom.store-fjall :as fjall] [datom.query.rank-plan :as plan]
           [datom.query.rank-index :as rank]))
(def S [{:db/ident :item/scope :db/valueType :db.type/ref}
        {:db/ident :item/order :db/valueType :db.type/long}
        {:db/ident :item/name :db/valueType :db.type/string}])
(def Q '[:find ?e ?at ?name :in $ ?scope :where [?e :item/scope ?scope]
         [?e :item/order ?at] [?e :item/name ?name]])
(defn writer-reductions [c]
 (Agent/get (:writer c) (fn [_] (elem (erlang/process_info (erlang/self) :reductions) 1))))
(defn run [mode]
 (let [root (Path/join (System/tmp_dir) (str "startup-rank-" (erlang/unique_integer (list :positive))))
       s (fjall/open root) c (d/connect-with s S)]
  (try
   (d/transact! c (mapv (fn [eid] {:db/id eid :item/scope 7 :item/order eid :item/name (str eid)}) (range 1 1001)))
   (d/q Q (d/db c) 7)
   (let [database (d/db c) p (plan/descriptor Q (db/schema-of database) [7] ['?at :asc])
         id (conn/ensure-query-rank! c p)
         before (writer-reductions c) start (erlang/monotonic_time :microsecond)]
    (loop [steps 0 max-us 0]
     (when (> steps 500) (throw :rank-bench-timeout))
     (let [t (erlang/monotonic_time :microsecond)
           h (conn/advance-query-rank! c id)
           max-us (max max-us (- (erlang/monotonic_time :microsecond) t))]
      (if (= :building (:status h)) (recur (inc steps) max-us)
       (do
        (when (not= :complete (:status h)) (throw {:header h}))
        {:steps (inc steps) :members (:members h)
         :elapsed-us (- (erlang/monotonic_time :microsecond) start)
         :writer-reductions (- (writer-reductions c) before)
         :max-step-us max-us
         :deep-page-count (count (:rows (rank/read-page (d/db c) id p 950 50)))})))))
   (finally (d/close! c) (File/rm_rf! root)))))
(let [mode (or (System/get_env "STARTUP_RANK_LABEL") "candidate")]
 (doseq [round (range 2)]
  (let [result (run mode)]
   (when (not= 50 (:deep-page-count result)) (throw {:incorrect-page result}))
   (println (pr-str (assoc result :round round :mode mode)))))
