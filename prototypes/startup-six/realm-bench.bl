; Same-image source vs cache comparison. Each load gets a new Env; init must replay.
(ns startup-six.realm-bench)
(def root (Path/join (System/tmp_dir) (str "startup-realm-bench-" (erlang/unique_integer (list :positive)))))
(def ns "startup.realm.bench")
(def file (Path/join root "startup/realm/bench.bl"))
(def realm-key (str "Bench" (erlang/unique_integer (list :positive))))
(File/mkdir_p! (Path/dirname file))
(File/write! file (str "(ns startup.realm.bench) (def setting (System/get_env \"STARTUP_REALM_VALUE\"))\n"
 (join "\n" (mapv (fn [i] (str "(defn f" i " [x] (+ x " i "))")) (range 64)))
 "\n(defn answer [] setting)\n"))
(defn run [mode]
 (let [e (BeamLisp.Env/fork :global)
       value (str (erlang/unique_integer (list :positive)))]
  (System/put_env "STARTUP_REALM_VALUE" value)
  (System/put_env "BEAM_LISP_AOT_REPAIR" (if (= mode :source) "off" "on"))
  (try
   (BeamLisp.Env/with_env e
    (fn []
      (BeamLisp.Env/put_key (tuple :realm_key) realm-key)
      (BeamLisp.Env/put_key (tuple :realm_decl) {:shadow [] :uses {}})
      (BeamLisp.Loader/with_search_dir root
       (fn []
        (let [start (erlang/monotonic_time :microsecond)
              before (elem (erlang/statistics :reductions) 0)]
         (BeamLisp.Loader/ensure_loaded ns)
         (when (not= value (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! ns "answer") (list)))
          (throw :stale-initializer))
         {:elapsed-us (- (erlang/monotonic_time :microsecond) start)
          :whole-vm-reductions (- (elem (erlang/statistics :reductions) 0) before)
          :aot? (erlang/function_exported (BeamLisp.Emit/module_for ns) :__bl_init__ 0)})))))
   (finally (BeamLisp.Env/destroy e)))))
(try
 (println (pr-str {:warm-up (run :cache)}))
 (doseq [round (range 2) mode [:source :cache :cache :source]]
  (println (pr-str (assoc (run mode) :round round :mode mode))))
 (finally (System/delete_env "BEAM_LISP_AOT_REPAIR")
          (System/delete_env "STARTUP_REALM_VALUE") (File/rm_rf! root)))
