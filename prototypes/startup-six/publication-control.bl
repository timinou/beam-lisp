(ns startup.baseline.control
 (:require [env] [system.publication-closure :as closure] [datom.query.rank-build :as build]))
(defn control []
 (build/prepare!)
 (env/eval "(ns baseline.dependency) (def answer 1) (defn helper [x] answer) (defn root [x] (helper x))")
 (let [proof (closure/certificate "baseline.dependency" "root") stamp (build/code-stamp)]
  (when (not (closure/valid? proof)) (throw :invalid-initial-proof))
  (println (pr-str {:initial-certificate-valid true}))
  (env/eval "(ns baseline.unrelated) (defn other [x] x)")
  (println (pr-str {:certificate-after-unrelated (closure/valid? proof)
                    :rank-stamp-after-unrelated (= stamp (build/code-stamp))}))))
(control)
