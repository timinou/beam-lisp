; Controlled algorithm-boundary benchmarks, ABBA order in one VM. Not a page ratio.
(ns startup-six.bench (:require [bl.loading :as loading] [env] [system.publication-closure :as closure]))
(defn measure [label action]
 (let [before (elem (erlang/process_info (erlang/self) :reductions) 1)
       start (erlang/monotonic_time :microsecond) result (action)]
  (println (pr-str {:label label :elapsed-us (- (erlang/monotonic_time :microsecond) start)
                    :reductions (- (elem (erlang/process_info (erlang/self) :reductions) 1) before)
                    :result result}))))
(def root (Path/join (System/tmp_dir) (str "startup-bench-" (erlang/unique_integer (list :positive)))))
(File/mkdir_p! (Path/join root "bench"))
(doseq [i (range 40)]
 (File/write! (Path/join root (str "bench/n" i ".bl"))
  (str "(ns bench.n" i (if (< i 10) (if (= i 0) "" (str " (:require [bench.n" (dec i) "])"))
                        " (:require [bench.n9])") ")\n(defn answer [] 1)\n")))
(try
 (BeamLisp.Loader/with_search_dir root
  (fn []
   (BeamLisp.Loader/ensure_loaded "build-plan")
   (let [roots (mapv (fn [i] (str "bench.n" i)) (range 10 40))
         legacy (fn []
                  (BeamLisp.Loader.Server/run
                   (fn [] (BeamLisp.Loader/with_search_dir root
                    (fn [] (doseq [n roots]
                      (BeamLisp.AOT/with_source_snapshot (fn [] (BeamLisp.AOT/ns_closure_hash n))))
                      (count roots))))))
         shared (fn []
                  (BeamLisp.Loader/with_loading_session
                   (fn [] (doseq [n roots] (BeamLisp.AOT/ns_closure_hash n)) (count roots))))]
    ;; Measure where the work executes, not a caller waiting on the server.
    (doseq [round (range 4) mode [:legacy :shared :shared :legacy]]
     (BeamLisp.Loader.Server/run
      (fn [] (BeamLisp.Loader/with_search_dir root
       (fn [] (measure [:source-pass round mode] (if (= mode :legacy) legacy shared))))))))))
 (finally (File/rm_rf! root)))

(let [ns "startup.metadata.bench" e (BeamLisp.Env/fork :global)]
 (try
  (BeamLisp.Env/with_env e
   (fn []
    (BeamLisp.Env/put_ns_defs ns
      (into {} (map (fn [i] [(str i) (vec (repeat 64 {:payload (String/duplicate "x" 64)}))]) (range 1024))))
    (doseq [round (range 4) mode [:legacy :selected :selected :legacy]]
     (measure [:metadata round mode]
       (fn [] (doseq [_ (range 100)]
                (if (= mode :legacy) (select-keys (BeamLisp.Env/ns_defs ns) ["500"])
                  (BeamLisp.Env/selected_ns_definitions ns ["500"]))) 100)))))
  (finally (BeamLisp.Env/destroy e))))

(env/eval "(ns startup.certificate.bench) (def answer 7) (defn helper [x] answer) (defn root [x] (helper x))")
(ns startup-six.bench (:require [system.publication-closure]))
(system.publication-closure/certificate "startup.certificate.bench" "root")
(doseq [round (range 4) mode [:fresh :cached :cached :fresh]]
 (measure [:certificate round mode]
  (fn [] (doseq [_ (range 50)]
          (if (= mode :fresh) (system.publication-closure/certificate-uncached "startup.certificate.bench" "root")
            (system.publication-closure/certificate "startup.certificate.bench" "root"))) 50)))
