(ns runtime.loader-scan-bench)
(def probe :Elixir.BeamLisp.LoaderScanBench)
(def scratch (str (System/tmp_dir!) "/loader-scan-bench-" (erlang/unique_integer (list :positive))))
(File/mkdir_p! scratch)
(def compiled (BeamLisp.AOT/compile_host_file
  (Path/join (BeamLisp/cwd) "priv/host/loader.bl")
  (list (tuple :module probe) (tuple :output_dir scratch) (tuple :load? false))))
(code/load_binary probe (String/to_charlist (elem compiled 1)) (File/read! (elem compiled 1)))
(defn old-declares? [content namespace]
  (let [lines (String/split content "\n")]
    (Enum/any? (Enum/with_index lines 0)
      (fn [pair]
        (let [trimmed (String/trim_leading (elem pair 0))
              head? (or (= trimmed "(ns") (String/starts_with? trimmed "(ns ")))
              tail (Enum/join (Enum/drop lines (elem pair 1)) "\n")]
          (if head? (= namespace (BeamLisp.Loader/declared_ns tail)) false))))))
(def content (str (Enum/join (Enum/map (Enum/to_list (Range/new 1 1000))
  (fn [_] "; An ordinary source line without a namespace declaration.")) "\n")
  "\n(ns benchmark.target)\n(def value 1)\n"))
(defn sample [which namespace]
  (let [before (elem (erlang/statistics :reductions) 0)
        start (erlang/monotonic_time :microsecond)
        result (if (= which :old) (old-declares? content namespace)
                 (erlang/apply probe :declares? (list content namespace)))
        elapsed (- (erlang/monotonic_time :microsecond) start)
        reductions (- (elem (erlang/statistics :reductions) 0) before)]
    (println (pr-str {:algorithm which :namespace namespace :result result
                     :microseconds elapsed :reductions reductions :bytes (erlang/byte_size content)}))))
(try
  (doseq [namespace ["benchmark.target" "benchmark.absent"]]
    (doseq [which [:old :new :new :old :old :new :new :old]] (sample which namespace)))
  (finally (code/purge probe) (code/delete probe) (File/rm_rf! scratch)))
