(ns runtime-opportunities.snapshot-bench
  (:require [datom.conn :as conn] [datom.store-ets :as ets]))
(defn measure [c iterations]
  (let [start (erlang/monotonic_time :microsecond)
        reductions (elem (erlang/process_info (erlang/self) :reductions) 1)
        checksum (loop [n iterations total 0]
                   (if (= n 0) total
                     (recur (dec n) (+ total (:basis-t (conn/db c))))))]
    {:us (- (erlang/monotonic_time :microsecond) start)
     :reductions (- (elem (erlang/process_info (erlang/self) :reductions) 1) reductions)
     :checksum checksum}))
(let [s (ets/open) c (conn/connect-with s) legacy (dissoc c :snapshot)]
  (try
    (measure c 1000) (measure legacy 1000)
    (doseq [variant [:legacy :canonical :canonical :legacy :legacy :canonical :canonical :legacy]]
      (println (pr-str {:variant variant :iterations 100000
                        :result (measure (if (= variant :legacy) legacy c) 100000)})))
    (finally (conn/release! c) (ets/close s))))
