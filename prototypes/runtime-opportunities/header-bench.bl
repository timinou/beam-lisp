(ns runtime-opportunities.header-bench
  (:require [bl.loading :as loading] [source-graph :as graph]
            [build-plan :as plan]))

(defn parsed-header [n source]
  (first (filter (fn [header] (= n (first header)))
    (map (fn [form] (graph/header-forms (list form))) (graph/forms source)))))

(defn measured [variant corpus]
  ;; Model a fresh VM's memo table while retaining existing on-disk parts.
  ;; Common input reading and table clearing are outside both measurements.
  (plan/clear-memo)
  (let [f (if (= variant :parsed) parsed-header loading/header-for)
        start (erlang/monotonic_time :microsecond)
        before (elem (erlang/process_info (erlang/self) :reductions) 1)
        headers (mapv (fn [[n source]] (f n source)) corpus)
        checksum (Base/encode16 (crypto/hash :sha256 (erlang/term_to_binary headers)))]
    {:variant variant :sources (count corpus) :checksum checksum
     :us (- (erlang/monotonic_time :microsecond) start)
     :reductions (- (elem (erlang/process_info (erlang/self) :reductions) 1) before)}))

(let [root (or (System/get_env "KNOWLEDGER_BENCH_ROOT")
               "/home/user/code/products/knowledger--runtime-opportunities")
      entry (File/read! (str root "/apps/knowledger/src/knowledger/main.bl"))
      roots (second (graph/header entry))
      dependencies (fn [n]
                     (let [source (BeamLisp.Loader/source_content n)
                           header (when source (loading/header-for n source))]
                       (when-not header (throw (ex-info "Missing benchmark dependency" {:namespace n})))
                       (second header)))
      names (sort (loading/discover roots dependencies))
      corpus (mapv (fn [n] [n (BeamLisp.Loader/source_content n)]) names)
      expected (mapv (fn [[n source]] (parsed-header n source)) corpus)]
  (assert (= expected (mapv (fn [[n source]] (loading/header-for n source)) corpus)))
  (println (pr-str {:corpus (count corpus) :bytes (reduce + (map (fn [[_ s]] (erlang/byte_size s)) corpus))
                    :cache :warm-disk-cold-memo :schedule :abba-abba}))
  (doseq [variant [:parsed :parts :parts :parsed :parsed :parts :parts :parsed]]
    (println (pr-str (measured variant corpus)))))
