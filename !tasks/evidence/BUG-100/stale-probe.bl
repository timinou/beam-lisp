; probe: the STALE query — an applied item whose file is no longer under the
; mount root (or is trashed). Uses a recursive rule INSIDE a not-join.
(ns probe.stale (:require [datom]))

(def conn (datom/connect
  [{:db/ident :f/key :db/valueType :db.type/string :db/unique :db.unique/identity}
   {:db/ident :f/parent :db/valueType :db.type/ref :db/cardinality :db.cardinality/many}
   {:db/ident :f/trashed :db/valueType :db.type/boolean}
   {:db/ident :m/root :db/valueType :db.type/ref}
   {:db/ident :s/mount :db/valueType :db.type/ref}
   {:db/ident :s/file :db/valueType :db.type/ref}
   {:db/ident :s/state :db/valueType :db.type/keyword}]))

(def UNDER '[[(under ?f ?r) [?f :f/parent ?r]]
             [(under ?f ?r) [?f :f/parent ?p] (under ?p ?r)]])

(def STALE '[:find ?a :in $ %
             :where [?a :s/state :applied] [?a :s/mount ?m] [?a :s/file ?f]
                    [:not-join [?m ?f] [?m :m/root ?r] (under ?f ?r)
                                       [:not [?f :f/trashed true]]]])

(defn eid [k] (get (first (into [] (datom/q '[:find ?e :in $ ?k :where [?e :f/key ?k]] (datom/db conn) k))) 0))

(defn main []
  (try
    (datom/transact! conn [{:db/id -1 :f/key "root"} {:db/id -9 :f/key "outside"}])
    (datom/transact! conn [{:db/id -1 :f/key "sub" :f/parent (eid "root")}])
    (datom/transact! conn [{:db/id -1 :f/key "a" :f/parent (eid "sub")}
                           {:db/id -2 :f/key "b" :f/parent (eid "sub")}
                           {:db/id -3 :f/key "c" :f/parent (eid "root")}
                           {:db/id -4 :m/root (eid "root")}])
    (let [m (get (first (into [] (datom/q '[:find ?m :where [?m :m/root _]] (datom/db conn)))) 0)]
      (datom/transact! conn (mapv (fn [k i] {:db/id i :s/mount m :s/file (eid k) :s/state :applied}) ["a" "b" "c"] [-1 -2 -3]))
      (println "stale@0 (expect [])            " (into [] (datom/q STALE (datom/db conn) UNDER)))
      ; b moved out: parent sub -> outside
      (datom/transact! conn [[:db/retract (eid "b") :f/parent (eid "sub")] [:db/add (eid "b") :f/parent (eid "outside")]])
      ; c trashed
      (datom/transact! conn [[:db/add (eid "c") :f/trashed true]])
      (let [rows (into [] (datom/q STALE (datom/db conn) UNDER))
            files (mapv (fn [r] (get (datom/pull (datom/db conn) [:s/file] (get r 0)) :s/file)) rows)]
        (println "stale after move+trash (expect b c) "
                 (sort (mapv (fn [f] (get (datom/pull (datom/db conn) [:f/key] (if (map? f) (:db/id f) f)) :f/key)) files)))))
    (catch e (println "ERR" e))))
(main)
