; probe: does a T2a watch fire for an owed-set query that uses a recursive rule
; and a not-join? The owed query's only TOP-LEVEL pattern is the mount root.
(ns probe.owed (:require [datom] [datom.watch]))

(def conn (datom/connect
  [{:db/ident :f/key :db/valueType :db.type/string :db/unique :db.unique/identity}
   {:db/ident :f/parent :db/valueType :db.type/ref :db/cardinality :db.cardinality/many}
   {:db/ident :f/rev :db/valueType :db.type/string}
   {:db/ident :m/root :db/valueType :db.type/ref}
   {:db/ident :j/origin :db/valueType :db.type/ref}
   {:db/ident :j/rev :db/valueType :db.type/string}]))

(def UNDER '[[(under ?f ?r) [?f :f/parent ?r]]
             [(under ?f ?r) [?f :f/parent ?p] (under ?p ?r)]])

(def OWED '[:find ?f ?rev :in $ % ?m
            :where [?m :m/root ?r] (under ?f ?r) [?f :f/rev ?rev]
                   [:not-join [?f ?rev] [?j :j/origin ?f] [?j :j/rev ?rev]]])

(datom/transact! conn [{:db/id -1 :f/key "root"} {:db/id -2 :m/root -1}
                       {:db/id -3 :f/key "sub" :f/parent -1}])
(def m (get (first (into [] (datom/q '[:find ?m :where [?m :m/root _]] (datom/db conn)))) 0))
(def root (get (first (into [] (datom/q '[:find ?e :where [?e :f/key "root"]] (datom/db conn)))) 0))

(println "owed@0" (into [] (datom/q OWED (datom/db conn) UNDER m)))

(defn main []
(try
(let [me (erlang/self)
      w (datom.watch/watch conn OWED [UNDER m] (fn [d] (erlang/send me [:cb d])))
      fired (fn [] (receive [:cb d] d (after 800 :silent)))]
(Process/sleep 50)

(datom/transact! conn [{:db/id -1 :f/key "a" :f/rev "r1"
  :f/parent (get (first (into [] (datom/q '[:find ?e :where [?e :f/key "sub"]] (datom/db conn)))) 0)}])
(println "file added under sub  →" (fired))
(let [a (get (first (into [] (datom/q '[:find ?e :where [?e :f/key "a"]] (datom/db conn)))) 0)]
  (datom/transact! conn [{:db/id -1 :j/origin a :j/rev "r1"}])
  (println "job recorded (not-join) →" (fired))
  (datom/transact! conn [[:db/add a :f/rev "r2"]])
  (println "rev bumped             →" (fired))
  (datom/transact! conn [{:db/id -1 :f/key "b"}])
  (let [b (get (first (into [] (datom/q '[:find ?e :where [?e :f/key "b"]] (datom/db conn)))) 0)]
    (datom/transact! conn [{:db/id -1 :f/key "elsewhere"}])
    (datom/transact! conn [[:db/add b :f/rev "x"]])
    (println "rev on unrooted file   →" (fired))
    (datom/transact! conn [[:db/add b :f/parent root]])
    (println "moved INTO root (parent only) →" (fired))
    (println "truth after move       →" (into [] (datom/q OWED (datom/db conn) UNDER m)))))
(datom.watch/unwatch w))
(catch e (println "ERR" e))))
(main)
