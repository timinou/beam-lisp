(ns measure (:require [vm.manager :as mgr] [vm.owner :as owner] [vm.scope :as scope] [vm.osenv :as osenv]))
(mgr/start)
(defn- sleep [ms] (erlang/apply :timer :sleep (list ms)))
(defn- now [] (System/monotonic_time :millisecond))

;; M1 concurrency: slow-A latency does not bleed into B
(doseq [i (range 10)] (mgr/ensure {:id (str "m-" i) :root (str "/tmp/m" i) :caps ["Elixir.String"]}))
(def parent (erlang/self))
(def t0 (now))
(spawn (fn [] (mgr/run "m-0" (fn [] (sleep 300) :slow)) (erlang/send parent [:a (- (now) t0)])))
(spawn (fn [] (sleep 10) (mgr/run "m-1" (fn [] :fast)) (erlang/send parent [:b (- (now) t0)])))
(def m1 (loop [k 0 acc {}] (if (= k 2) acc (receive [w t] (recur (inc k) (assoc acc w t))))))

;; M1b throughput: 200 concurrent commands
(def tc0 (now))
(doseq [i (range 200)] (spawn (fn [] (mgr/run (str "m-" (rem i 10)) (fn [] :ok)) (erlang/send parent :done))))
(def n200 (loop [k 0] (if (= k 200) k (receive :done (recur (inc k))))))
(def m1b (- (now) tc0))

;; M2 halt scoping
(doseq [_ (range 3)] (mgr/serve "m-2" :w (fn [] (receive (after 60000 :ok)))))
(doseq [_ (range 2)] (mgr/serve "m-3" :w (fn [] (receive (after 60000 :ok)))))
(def m2-b-before (owner/count "m-3"))
(def m2 (mgr/run "m-2" (fn [] (scope/halt 0))))
(sleep 60)
(def m2-a-after (owner/count "m-2"))
(def m2-b-after (owner/count "m-3"))

;; M3 no-growth across 1000 spawn/drain
(mgr/ensure {:id "m-cyc" :root "/tmp/mcyc" :caps ["Elixir.String"]})
(def procs0 (erlang/length (erlang/processes)))
(doseq [_ (range 100)]
  (let [pids (doall (map (fn [_] (mgr/serve "m-cyc" :w (fn [] (receive (after 60000 :ok))))) (range 10)))]
    (doseq [p pids] (erlang/exit p :kill))
    (sleep 1)))
(sleep 100)
(def m3-owned (owner/count "m-cyc"))
(def procs1 (erlang/length (erlang/processes)))

;; M5 process-local env under concurrency
(def m5 (let [n 50]
  (doseq [i (range n)] (spawn (fn [] (let [w (str "v" i) g (osenv/with-env {"FOO" w} (fn [] (sleep 1) (osenv/get "FOO")))] (erlang/send parent [:e (= w g)])))))
  (loop [seen 0 ok 0] (if (= seen n) ok (receive [:e good] (recur (inc seen) (if good (inc ok) ok)))))))

(println (str "M1_slow_A_ms="   (:a m1)))
(println (str "M1_fast_B_ms="   (:b m1)))
(println (str "M1b_200cmds_ms=" m1b " count=" n200))
(println (str "M2_halted="      (:halted m2) " a_after=" m2-a-after " b_before=" m2-b-before " b_after=" m2-b-after))
(println (str "M3_owned_after_1000_cycles=" m3-owned " procs_delta=" (- procs1 procs0)))
(println (str "M5_env_correct=" m5 "/50"))
(println (str "NODE_ALIVE="     (erlang/is_process_alive parent)))
