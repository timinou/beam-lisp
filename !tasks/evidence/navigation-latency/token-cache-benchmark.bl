(ns kn.token-bench (:require [loom.token :as t] [loom.token-original :as old]))
(def styles [{:display "flex" :gap "12px" :padding "8px" :color "#123456"}
             {:display "grid" :grid-template-columns "1fr 1fr" :align-items "center"}])
(defn measure [label f]
 (let [r (erlang/element 2 (erlang/process_info (erlang/self) :reductions))
       start (erlang/monotonic_time :microsecond)]
  (doseq [_ (range 1000)] (doseq [style styles] (f style)))
  (println (pr-str {:label label :us (- (erlang/monotonic_time :microsecond) start)
                   :reductions (- (erlang/element 2 (erlang/process_info (erlang/self) :reductions)) r)}))))
(doseq [style styles] (t/sx style) (old/sx style))
(doseq [_ (range 3)] (measure :original old/sx) (measure :cached t/sx))
