(ns runtime.release.authority-refresh
  (:require [build :as b] [build-plan :as bp] [drop :as d]
            [provenance :as prov] [claim :as claim]))
(def scratch "/home/user/tmp/runtime-opportunities/release/sdk-build")
(def stage "/home/user/tmp/runtime-opportunities/release/bl-selfbuild-src")
(def tree (str scratch "/tree"))
(def priv (str tree "/lib/beam_lisp-0.1.0/priv"))
(def ebin (str tree "/lib/beam_lisp-0.1.0/ebin"))
(def launcher "/home/user/code/products/knowledger/.tmp/rigorous-navigation/completion-sdk-build/launcher")
(def out "/home/user/tmp/runtime-opportunities/release/bl-sdk-authority")
;; One-off namespace-authority repair, from a clean committed checkout.
;; Strict AOT validation is required after packaging: functional gates alone
;; previously accepted a digest-valid Env beam with the wrong source stamp.
;; Before running:
;; (1) regenerate/check and commit its native seed; (2) restage every current
;; library tier and all release priv assets; (3) copy refreshed native seed
;; beams into release ebin. Preserve outputs and validate source/closure keys.
;; Changed codegen rejects old facts; do not suppress invalidation or force a
;; stale output fresh. Dependency applications must match the existing tree.
(claim/acquire! stage launcher)
(try
  (let [r (b/run {:sources (vec (BeamLisp.Tiers/sources stage))
                  :root stage :out ebin :manifest (str scratch "/manifest")
                  :log-path (str scratch "/build.log") :force? false :jobs 2
                  :log (fn [s] (println s))})]
    (println "RESUME-COMPILE" (pr-str r))
    (when (seq (:errors r)) (throw (ex-info "SDK compilation failed" r)))
    ;; Independent offline check against every stamped artifact, before pack.
    (let [audit (System/cmd "python3"
                  (list "/home/user/code/undefine/beam-lisp--runtime-opportunities/prototypes/runtime-opportunities/audit-beam-authority.py"
                        (str scratch "/build.log") ebin))]
      (when-not (= 0 (elem audit 1)) (throw (ex-info "SDK authority audit failed" {:output (elem audit 0)})))
      (let [result (Jason/decode! (elem audit 0))]
        (println "RESUME-AUTHORITY" (elem audit 0))
        (when (or (not (= (count (:manifest r)) (get result "source_facts")))
                  (zero? (get result "checked")) (seq (get result "mismatches")))
          (throw (ex-info "SDK artifact/build authority mismatch" result)))))
    ;; Prove the repaired artifacts really are fresh under the new predicate.
    (let [again (b/run {:sources (vec (BeamLisp.Tiers/sources stage))
                       :root stage :out ebin :manifest (str scratch "/manifest")
                       :log-path (str scratch "/build.log") :force? false :jobs 2})]
      (println "RESUME-NOOP" (pr-str {:built (:built again) :errors (:errors again)}))
      (when (or (pos? (:built again)) (seq (:errors again)))
        (throw (ex-info "SDK refresh did not reach a fresh fixed point" again))))
    (println "RESUME-PRIMED" (bp/prime! priv (vec (BeamLisp.Tiers/sources priv))))
    (prov/write! tree (prov/collect "/home/user/code/undefine/beam-lisp--runtime-opportunities"))
    (let [packed (d/pack tree launcher out 0)]
      (println "RESUME-PACK" (pr-str packed))
      (when-not (:ok? packed) (throw (ex-info "SDK packing failed" packed))))
    (let [verified (d/verify out)]
      (println "RESUME-VERIFY" (pr-str verified))
      (when-not (:ok? verified) (throw (ex-info "SDK verification failed" verified)))))
  (finally (claim/release! stage)))
