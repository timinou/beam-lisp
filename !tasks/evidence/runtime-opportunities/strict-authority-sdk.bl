(println "strict-sdk-entry")
(ns runtime.release.strict-authority-sdk
  (:require [bl.loading :as loading] [bl.env :as env] [datom] [errors] [interop] [mcp.server] [mcp.skill] [harness.mcp]))
(assert (= :lazy (loading/mode (loading/validate nil) "development")))
(assert (empty? (:errors (env/normalize
  {:foundry {:application {:version 1 :data-version 1 :requirements ["datom"]
                           :entrypoints {:main "src/main.bl"}}}} "/home/user/example" nil))))
(println "strict-sdk-loaded" (BeamLisp.AOTCache/compiler_key))
