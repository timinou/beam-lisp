; Warm VM scenario measurements, not a controlled before/after speedup claim.
(ns live-upgrade.queue-benchmark
 (:require [proc :as proc] [proc.queue :as q] [datom :as d]))
(proc/defserver bench-plain-q
 (queue {:of :bench/plain :concurrency 8})
 (perform [job] (:bench/value job)))
(proc/defserver bench-adapt-q
 (queue {:of :bench/adapt :protocol 2 :concurrency 8
         :contract {:accept? (fn [p] (contains? p :bench/value))
                    :adapters {1 {:to 2 :upcast (fn [p] {:bench/value (:bench/old p)})
                                  :accept? (fn [p] (contains? p :bench/value))}}}})
 (perform [job] (:bench/value job)))
(defn percentile [samples fraction]
 (let [values (vec (sort samples))]
  (nth values (min (dec (count values)) (erlang/trunc (* fraction (count values)))))))
(defn scenario [server srv payload opts]
 (let [pid (start server nil {}) count-jobs 100 begun (erlang/monotonic_time :microsecond)]
  (try
   (let [samples (mapv (fn [n]
                   (let [at (erlang/monotonic_time :microsecond)]
                    (q/enqueue! srv (payload n) opts)
                    (- (erlang/monotonic_time :microsecond) at))) (range count-jobs))]
    (loop [attempt 0]
     (let [stats (q/stats srv)]
      (cond
       (= count-jobs (:done stats))
        (let [elapsed (- (erlang/monotonic_time :microsecond) begun)]
         {:jobs count-jobs :done (:done stats) :failed (:failed stats) :held (:held stats)
          :elapsed-ms (/ elapsed 1000.0) :jobs-per-second (/ (* count-jobs 1000000.0) elapsed)
          :enqueue-p50-ms (/ (percentile samples 0.5) 1000.0)
          :enqueue-p95-ms (/ (percentile samples 0.95) 1000.0)})
       (> attempt 2000) (throw (ex-info "Queue benchmark deadline" stats))
       :else (do (Process/sleep 10) (recur (inc attempt)))))))
   (finally (stop pid)))))
(deftest native-queue-throughput-scenarios
 (let [plain (scenario bench-plain-q :bench-plain-q (fn [n] {:bench/value n}) {})
       adapted (scenario bench-adapt-q :bench-adapt-q (fn [n] {:bench/old n}) {:protocol 1})]
  (println {:benchmark :live-upgrade-queue :plain plain :adapted adapted})
  (is (= 100 (:done plain))) (is (= 100 (:done adapted)))
  (is (= 0 (:failed plain))) (is (= 0 (:failed adapted)))
  (is (= 0 (:held plain))) (is (= 0 (:held adapted)))))
