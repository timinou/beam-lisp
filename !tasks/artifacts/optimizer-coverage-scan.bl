; Diagnostic inspection only: use the central pass, never publish descriptors.
(ns optimizer.coverage.scan
  (:require [optimize :as o] [bl.json :as json]))

(defn- frequencies [entries key]
  (reduce (fn [out entry] (update out (key entry) (fn [n] (inc (or n 0))))) {} entries))

(defn- scan [ns]
  (BeamLisp.Loader/ensure_loaded ns)
  ; One table read: AOT definitions are shared literals; overlays remain snapshots.
  (let [defs (BeamLisp.Env/ns_defs ns)
        rows (ets/lookup :beam_lisp_vars (tuple (BeamLisp.Env/env_id) :ns_defs ns))
        stored (when (seq rows) (elem (first rows) 1))
        reference? (and (erlang/is_tuple stored) (= 2 (erlang/tuple_size stored))
                        (= :"$beam" (elem stored 0)))
        entries (mapcat second (to-list defs))
        groups (group-by (fn [entry] (elem entry 4)) entries)
        reports (map (fn [[mod rows]]
                       (o/explain (BeamLisp.Emit/descriptor_for mod (to-list (map (fn [entry] (elem entry 3)) rows)))
                                  {:max-nodes 100000})) groups)
        evidence (mapcat :evidence reports)
        refusals (mapcat :refusals reports)]
    (println (json/encode {"namespace" ns "definitions" (count defs)
                          "table_storage" (cond reference? "beam-reference" (map? stored) "map" :else "inherited")
                          "row_flat_bytes" (when (some? stored) (* 8 (erts_debug/flat_size stored)))
                          "table_flat_bytes" (* 8 (erts_debug/flat_size defs))
                          "body_modules" (count groups)
                          "visited" (reduce + 0 (map (fn [r] (:visited (:stats r))) reports))
                          "limited" (boolean (some (fn [r] (:limited? (:stats r))) reports))
                          "rules" (frequencies evidence :rule)
                          "refusals" (frequencies refusals :reason)}))))

(doseq [ns ["compiler" "core" "rt" "build" "system.analyze" "datom.index"]]
  (scan ns))
