; Matched baseline/:normalized k-reduce measurement (PROTOTYPE, P2 gate).
; Run (staged image, no global toggles; mode is an explicit per-call argument):
;   bin/bl run '!tasks/artifacts/optimizer-mode-measure.bl' > mode-measure.jsonl
; Emits JSON lines: {"type":"time",case,collection,mode,policy,n,repeat,us,reductions,answer}.
; Answers are checked against closed-form values; any mismatch raises.
; Interleaved order per repeat: baseline,normalized,normalized,baseline (ABBA)
; to cancel drift. Allocation is deliberately not claimed (uncalibrated).
; Cross-image comparison: run the same file under two isolated staged images
; (production seed untouched) and diff medians; the 5-arity needs the candidate image.

(ns optimizer.mode.measure
  (:require [bl.json :as json]))

(def adder (fn [a x] (erlang/+ a x)))               ; native 2-arity
(def valplus (fn ([] 0) ([a] a) ([a b] (erlang/+ a b)))) ; tagged multi-arity "tagged-adder"
(def callables
  {"native" adder "tagged-adder" valplus "public-plus" +})

(defn sum-to [n] (quot (* n (dec n)) 2))
(def sources
  {"list" (fn [n] (lists/seq 0 (dec n)))
   "vector" (fn [n] (vec (range n)))
   "lazy" (fn [n] (map identity (range n)))
   "map" (fn [n] (zipmap (range n) (range n)))})
(defn expected [coll n] (if (= coll "map") (* 2 (sum-to n)) (sum-to n)))

(defn run1 [cname f coll n policy mode]
  ; fresh source per sample; built before the measured window
  (let [src ((get sources coll) n)
        step (if (= coll "map") (fn [a e] (erlang/+ a (erlang/+ (first e) (second e)))) f)
        r0 (elem (erlang/process_info (erlang/self) :reductions) 1)
        t (timer/tc (fn []
                      (if (= "previous-floor" (System/get_env "BL_MODE_IMAGE"))
                        (BeamLisp.Ns.Rt/k-reduce step 0 src policy)
                        (BeamLisp.Ns.Rt/k-reduce step 0 src policy mode))))
        r1 (elem (erlang/process_info (erlang/self) :reductions) 1)]
    [(elem t 0) (elem t 1) (- r1 r0)]))

(defn sample [cname coll n policy mode repeat]
  (let [f (get callables cname)
        [us ans reds] (run1 cname f coll n policy mode)]
    (when (not= ans (expected coll n)) (erlang/error (tuple :mode-measure-wrong-answer cname coll n mode ans)))
    (println (json/encode {"type" "time" "image" (System/get_env "BL_MODE_IMAGE") "callable" cname "collection" coll
                           "policy" (name policy) "mode" (name mode) "n" n
                           "repeat" repeat "us" us "reductions" reds "answer" ans}))))

(def grid
  (for [cname ["native" "tagged-adder" "public-plus"]
        coll ["list" "vector" "lazy" "map"]
        policy [:kernel :compat]
        :when (or (not= coll "map") (= cname "native"))]
    [cname coll policy]))

(doseq [[c k p] grid] (run1 c (get callables c) k 1000 p :baseline) (run1 c (get callables c) k 1000 p :normalized))
(doseq [n [1000 16000 64000] repeat (range 5) [c k p] grid
        mode [:baseline :normalized :normalized :baseline]]
  (sample c k n p mode repeat))
