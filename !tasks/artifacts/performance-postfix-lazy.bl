; Same integer-answer workload as the performance review; raw Erlang is a
; diagnostic lower bound, not a semantics-equivalent lazy implementation.
(ns performance.postfix-lazy)

(defn measured [label n f]
  (let [t (System/monotonic_time :microsecond)
        r0 (elem (Process/info (erlang/self) :reductions) 1)
        before (BeamLisp.LazyMemo/stats)
        result (f)
        elapsed (- (System/monotonic_time :microsecond) t)
        reductions (- (elem (Process/info (erlang/self) :reductions) 1) r0)
        after (BeamLisp.LazyMemo/stats)
        expected (* n (- n 1))]
    (when (not= result expected) (erlang/error (str label " wrong result " result)))
    (println "POSTFIX-LAZY" {:label label :n n :us elapsed :reductions reductions
               :result result :native-before before :native-after after})
    result))

(doseq [n [1000 4000 16000]]
  (doseq [sample [0 1 2]]
    (measured (str "lazy-" sample) n
      (fn [] (reduce + 0 (take n (map-indexed (fn [i x] (+ i x)) (range))))))
    (measured (str "eager-" sample) n
      (fn [] (reduce + 0 (map-indexed (fn [i x] (+ i x)) (range n)))))
    (measured (str "raw-erlang-" sample) n
      (fn [] (lists/foldl (fn [x acc] (erlang/+ acc (erlang/* 2 x))) 0
                         (lists/seq 0 (erlang/- n 1)))))))

(let [held (map inc (range 16000))
      t (System/monotonic_time :microsecond)
      first-count (count held)
      first-us (- (System/monotonic_time :microsecond) t)
      state (BeamLisp.LazySeq/memo_state held)
      bytes (BeamLisp.LazyMemo/estimate_bytes state)
      peek (BeamLisp.LazyMemo/peek (:resource held))
      before (BeamLisp.LazyMemo/stats)
      t2 (System/monotonic_time :microsecond)
      second-count (count held)
      second-us (- (System/monotonic_time :microsecond) t2)]
  (when (not= [16000 16000] [first-count second-count]) (erlang/error :bad-held-count))
  (println "POSTFIX-HELD" {:n 16000 :first-us first-us :second-us second-us
              :memo-bytes bytes :peek peek :native-before-second before
              :native-after-second (BeamLisp.LazyMemo/stats)}))
