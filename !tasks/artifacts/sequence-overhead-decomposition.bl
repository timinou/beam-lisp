; Current published-runtime decomposition. No production changes.
; All cases return n*(n-1). Same-list cases exclude input construction.
(ns performance.sequence-overhead
  (:require [bl.json :as json]))

(defn integer-loop [xs]
  (loop [ys xs acc 0]
    (if (erlang/== ys (quote ()))
      acc
      (recur (erlang/tl ys)
             (erlang/+ acc (erlang/* 2 (erlang/hd ys)))))))

(defn emit [x] (println (json/encode x)))

(defn trial [label sample expected f]
  (let [before (elem (Process/info (erlang/self) :reductions) 1)
        start (System/monotonic_time :microsecond)
        answer (erlang/apply f (quote ()))
        us (erlang/- (System/monotonic_time :microsecond) start)
        work (erlang/- (elem (Process/info (erlang/self) :reductions) 1) before)]
    (when (not= expected answer) (erlang/error (tuple :wrong-answer label answer)))
    (emit {"kind" "time" "case" label "sample" sample "us" us
           "reductions" work "answer" answer})))

(defn native-delta [before after]
  (into {} (map (fn [key]
    [(name key) (erlang/- (get after key 0) (get before key 0))])
    [:op_new :op_new_fast :op_read :op_read_fast :op_peek :op_cas
     :op_cas_fast :op_reroute :op_cursor :op_cursor_chunk_fast :op_id
     :op_dep_resource :op_budget :retained_bytes :reserved_bytes])))

(defn profile [label expected f]
  (let [before (BeamLisp.LazyMemo/stats)]
    (cprof/start)
    (let [answer (erlang/apply f (quote ()))]
      (cprof/pause)
      (when (not= expected answer) (erlang/error (tuple :wrong-profile-answer label answer)))
      (let [after (BeamLisp.LazyMemo/stats)
            rows (elem (cprof/analyse) 1)]
        (emit {"kind" "profile" "case" label
               "native" (native-delta before after)
               "modules" (into [] (map (fn [row]
                 {"module" (str (elem row 0)) "calls" (elem row 1)
                  "functions" (into [] (map (fn [entry]
                    {"mfa" (str (elem entry 0)) "calls" (elem entry 1)})
                    (take 20 (elem row 2))))}) (take 12 rows)))})))
    (cprof/stop)))

(let [n 16000
      expected (erlang/* n (erlang/- n 1))
      xs (lists/seq 0 (erlang/- n 1))
      doubled (lists/map (fn [x] (erlang/* 2 x)) xs)
      add-bif (fn [acc x] (erlang/+ acc x))
      index-bif (fn [i x] (erlang/+ i x))
      cases [["raw-erlang-fold" (fn [] (lists/foldl
                  (fn [x acc] (erlang/+ acc (erlang/* 2 x))) 0 xs))]
             ["raw-sum-doubled-list" (fn [] (lists/foldl
                  (fn [x acc] (erlang/+ acc x)) 0 doubled))]
             ["rt-reduce-bif-list" (fn [] (BeamLisp.Ns.Rt/k-reduce add-bif 0 doubled))]
             ["rt-reduce-plus-list" (fn [] (BeamLisp.Ns.Rt/k-reduce + 0 doubled))]
             ["bl-integer-loop" (fn [] (integer-loop xs))]
             ["raw-fold-bl-arithmetic" (fn [] (lists/foldl
                  (fn [x acc] (+ acc (* 2 x))) 0 xs))]
             ["bl-reduce-bif-list" (fn [] (reduce add-bif 0 doubled))]
             ["bl-reduce-plus-list" (fn [] (reduce + 0 doubled))]
             ["finite-pipeline-bif" (fn [] (reduce add-bif 0
                  (map-indexed index-bif (range n))))]
             ["finite-pipeline-bl" (fn [] (reduce + 0
                  (map-indexed (fn [i x] (+ i x)) (range n))))]
             ["lazy-pipeline-bif" (fn [] (reduce add-bif 0
                  (take n (map-indexed index-bif (range)))))]
             ["lazy-pipeline-bl" (fn [] (reduce + 0
                  (take n (map-indexed (fn [i x] (+ i x)) (range)))))]]]
  (emit {"kind" "environment" "n" n "otp" (erlang/system_info :otp_release)
         "schedulers" (erlang/system_info :schedulers_online)
         "dirty_io" (erlang/system_info :dirty_io_schedulers)})
  ; Warm all paths before taking the unprofiled samples.
  (doseq [entry cases]
    (let [answer (erlang/apply (get entry 1) (quote ()))]
      (when (not= expected answer) (erlang/error (tuple :bad-warmup entry answer)))))
  ; Interleave cases so one case does not exclusively get a different load epoch.
  (doseq [sample [1 2 3 4 5]]
    (doseq [entry cases] (trial (get entry 0) sample expected (get entry 1))))
  ; Call-count profiling is deliberately separate from the timing series.
  (doseq [entry cases] (profile (get entry 0) expected (get entry 1))))
