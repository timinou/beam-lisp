== corrections compose: one pass cleans a whole nesting ==
  before: (defn handler [req] (if (not (map? req)) (when (not (nil? (first (rest (get req :items))))) (if (= (count req) 0) (+ i 1) (> n 0))) nil))
  after:  (defn handler [req] (when-not (map? req) (when (some? (second (get req :items))) (if (zero? (count req)) (inc i) (pos? n)))))

