; Isolated generation cutover. The shell wrapper stages the verified previous
; floor using Bootstrap.install!, never an RT compatibility alias or fake key.
; BL_STAGE_PHASE=hosts compiles changed pinned hosts using that existing floor.
; BL_STAGE_PHASE=build runs the authoritative native build in a fresh VM.
; BL_STAGE_PHASE=seed writes an isolated candidate with the official seed writer.
(ns incremental-foundation-stage)

(def out (System/get_env "BL_EBIN"))
(def root (System/get_env "BL_ROOT"))
(def phase (System/get_env "BL_STAGE_PHASE"))

(defn invoke-ns [ns name args]
  (BeamLisp.Loader/ensure_loaded ns)
  (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! ns name) (to-list args)))

(cond
  (= phase "hosts")
  (do
    ; New AOT hosts may call additive key/cache helpers. Install the pure build
    ; kernels while the previous AOT/compiler can still bootstrap them.
    (doseq [[path ns] [["priv/build/ns-interface.bl" "ns-interface"]
                      ["priv/build/build-plan.bl" "build-plan"]]]
      (println "STAGE-KERNEL" path)
      (BeamLisp.AOT/compile_file path (list (tuple :output_dir out)))
      (BeamLisp.Env/mark_loaded ns))
    (doseq [[path module]
            [["priv/host/tiers.bl" :Elixir.BeamLisp.Tiers]
             ["priv/host/loader.bl" :Elixir.BeamLisp.Loader]
             ["priv/host/env.bl" :Elixir.BeamLisp.Env]
             ["priv/host/link.bl" :Elixir.BeamLisp.Link]
             ["priv/host/emit.bl" :Elixir.BeamLisp.Emit]
             ["priv/host/aot_cache.bl" :Elixir.BeamLisp.AOTCache]
             ["priv/host/aot.bl" :Elixir.BeamLisp.AOT]
             ["priv/host/launcher.bl" :Elixir.BeamLisp.Launcher]]]
      (println "STAGE-HOST" path)
      (BeamLisp.AOT/compile_host_file path
        (list (tuple :module module) (tuple :output_dir out)
              (tuple :source_hash (Base/encode16 (crypto/hash :sha256 (File/read! path))
                                                (list (tuple :case :lower)))))))
    ; Emit new NIF-facing hosts for the NEXT VM. The current VM still has
    ; the verified prior NIF loaded; replacing its calling module here would
    ; require an unsupported live NIF upgrade.
    (doseq [[path module fields]
            [["priv/host/lazy_memo.bl" :Elixir.BeamLisp.LazyMemo nil]
             ["priv/host/lazy_seq.bl" :Elixir.BeamLisp.LazySeq
              (list (tuple :resource nil) (tuple :metadata nil))]
             ["priv/host/seq_cursor.bl" :Elixir.BeamLisp.SeqCursor
              (list (tuple :chunk ()) (tuple :tail nil) (tuple :dirty false))]]]
      (println "STAGE-NEXT-HOST" path)
      (let [opts (list (tuple :module module) (tuple :output_dir out)
                       (tuple :load? false)
                       (tuple :source_hash (Base/encode16 (crypto/hash :sha256 (File/read! path))
                                                         (list (tuple :case :lower)))))]
        (BeamLisp.AOT/compile_host_file path
          (if (nil? fields) opts (erlang/++ opts (list (tuple :struct_fields fields)))))))
    (println "STAGE-HOSTS-DONE"))

  (= phase "build")
  (let [result (invoke-ns "build" "run"
                 [{:sources (BeamLisp.Tiers/sources) :out out :root root
                   :jobs 2 :force? (= "1" (System/get_env "BL_STAGE_FORCE")) :log (fn [line] (println line))}])]
    (println "STAGE-BUILD-RESULT" result)
    (when (seq (:errors result)) (erlang/error (str "stage build failed: " (:errors result)))))

  (= phase "patch-compiler")
  (do
    (BeamLisp.AOT/compile_file "priv/boot/compiler.bl" (list (tuple :output_dir out)))
    (BeamLisp.Env/mark_loaded "compiler")
    (println "STAGE-COMPILER-DONE"))

  (= phase "patch-loader")
  (do
    (BeamLisp.AOT/compile_host_file "priv/host/loader.bl"
      (list (tuple :module :Elixir.BeamLisp.Loader) (tuple :output_dir out)
            (tuple :source_hash (Base/encode16 (crypto/hash :sha256 (File/read! "priv/host/loader.bl"))
                                              (list (tuple :case :lower))))))
    (println "STAGE-LOADER-DONE"))

  (= phase "probe")
  (println "STAGE-PROBE" (BeamLisp.AOT/compile_file (System/get_env "BL_STAGE_SOURCE")
                           (list (tuple :output_dir out))))

  (= phase "eval")
  (println "STAGE-EVAL" (BeamLisp/eval (System/get_env "BL_STAGE_EVAL")))

  (= phase "test")
  (let [files (String/split (System/get_env "BL_STAGE_TESTS") ",")
        result (BeamLisp.TestRT/run_suite files (list))]
    (println "STAGE-TEST-RESULT" result)
    (when (or (> (:fail result) 0) (> (:error result) 0)) (System/halt 1)))

  (= phase "seed")
  (let [candidate (System/get_env "BL_STAGE_SEED")
        app (:app (BeamLisp/eval (File/read! (Path/join root "env.bl"))))
        result (invoke-ns "seed" "run" [{:ebin out :out candidate :app app}])]
    (println "STAGE-SEED-RESULT" result)
    (when (not (:ok? result)) (erlang/error (str "candidate seed failed: " result))))

  :else (erlang/error (str "unknown BL_STAGE_PHASE " phase)))
