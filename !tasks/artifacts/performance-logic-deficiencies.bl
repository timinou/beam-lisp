; Native logic checks of the review's structural boundaries.
; Explicitly demonstrates analyzer limits; no production edit or rebuild.
(ns performance-logic-deficiencies
  (:require [codebase :as cb] [source-graph :as sg]
            [system.analyze :as an] [typed :as tt] [veritas :as v] [z3]))

(let [cache (atom {})
      reqs (fn [ns]
             (if (contains? @cache ns)
               (get @cache ns)
               (let [found (BeamLisp.Loader/find_file ns)
                     edges (if (= :ok (erlang/element 1 found))
                             (into [] (map :ns/requires
                               (cb/requires-facts ns (erlang/element 3 found)))) [])]
                 (swap! cache assoc ns edges)
                 edges)))
      reachable (sg/closure "bl.cli" reqs)]
  (println "CODEBASE CLI STATIC REQUIRE CLOSURE"
    {:count (count reachable) :direct (reqs "bl.cli") :names reachable}))

(let [source "(defn overloaded ([x] x) ([x y] (File/read! x)))"]
  (println "SYSTEM MULTI-ARITY LIMIT" (an/analyze source))
  (println "TYPED UNANNOTATED LIMIT" (tt/check-source source "core")))

(defn refuses-count [n]
  (let [old (Application/get_env :beam_lisp :lazy_cache_budget_bytes 536870912)]
    (try
      (Application/put_env :beam_lisp :lazy_cache_budget_bytes 0)
      (try (do (count (map inc (range n))) false) (catch _ true))
      (finally (Application/put_env :beam_lisp :lazy_cache_budget_bytes old)))))

(let [port (z3/open)]
  ; Set budget only inside the tested operation: the logic engine itself needs
  ; normal admission while enumerating its generators and building verdicts.
  (println "VERITAS ZERO-BUDGET FOLD MUST REFUSE"
    (v/for-all port "n" (v/one-of 1 31 32 33)
      '(performance-logic-deficiencies/refuses-count n))))

(defn measured [label f]
  (let [start (erlang/monotonic_time :microsecond) r (f)]
    (println label {:us (- (erlang/monotonic_time :microsecond) start) :result r})))
(doseq [i [1 2 3]]
  (measured (str "CORE-REDUCER " i)
    (fn [] (reduce + 0 (take 16000 (map-indexed (fn [i x] (+ i x)) (range))))))
  (measured (str "BIF-REDUCER " i)
    (fn [] (reduce (fn [a x] (erlang/+ a x)) 0
                   (take 16000 (map-indexed (fn [i x] (erlang/+ i x)) (range))))))
  (measured (str "RAW-LISTS " i)
    (fn [] (lists/foldl (fn [x acc] (erlang/+ acc (erlang/* 2 x))) 0
                       (lists/seq 0 15999)))))
