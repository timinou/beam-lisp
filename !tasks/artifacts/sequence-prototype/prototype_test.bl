(ns performance.sequence-prototype-test
  (:require [performance.sequence-prototype :as p]
            [performance.sequence-proof :as proof]))

(defn- expected [n] (erlang/* n (erlang/- n 1)))

(deftest representation-cutover-agrees-on-supported-collections
  (doseq [xs [(quote ()) (quote (1)) (quote (1 2 3)) [1 2 3]
             (set [1 2 3]) nil]]
    (is (= (reduce + 0 xs) (p/representation-reduce + 0 xs)))))

(deftest direct-and-specialized-list-paths-match-the-existing-kernel
  (doseq [n [0 1 2 31 32 33 63 64 65 1000]]
    (let [xs (if (= n 0) (quote ()) (lists/seq 0 (erlang/- n 1))) f (p/adder)]
      (is (= (p/representation-reduce f 0 xs) (p/direct-reduce f 0 xs)))
      (is (= (p/representation-reduce f 0 xs) (p/arithmetic-reduce f 0 xs))))))

(deftest unknown-callables-and-other-representations-fall-back
  (let [multiply (fn [a x] (erlang/* a x)) multi (fn ([a] a) ([a x] (+ a x)))]
    (is (= 24 (p/direct-reduce multiply 1 (quote (2 3 4)))))
    (is (= 24 (p/arithmetic-reduce multiply 1 (quote (2 3 4)))))
    (is (= 6 (p/direct-reduce multi 0 (quote (1 2 3)))))
    (is (= 6 (p/arithmetic-reduce multi 0 (quote (1 2 3)))))
    (is (= 6 (p/direct-reduce (p/adder) 0 [1 2 3])))
    (is (= 6 (p/direct-reduce (p/adder) 0 (map inc (range 3)))))))

(deftest integer-guards-resume-at-the-first-noninteger
  (doseq [xs [(quote (1 2.5 3)) (quote (1.5 2 3)) (quote (1 2 3.5))]]
    (is (= (p/representation-reduce (p/adder) 0 xs)
           (p/arithmetic-reduce (p/adder) 0 xs))))
  (is (= 6.5 (p/arithmetic-reduce (p/adder) 0.5 (quote (1 2 3)))))
  (is (thrown? (p/arithmetic-reduce (p/adder) 0 (quote (1 :bad 3)))))
  (is (= 200000000000000000000000000000000000000
         (p/arithmetic-reduce (p/adder) 0
           (quote (100000000000000000000000000000000000000
                   100000000000000000000000000000000000000))))))

(deftest effects-order-and-early-reduced-are-preserved
  (doseq [runner [p/representation-reduce p/direct-reduce p/arithmetic-reduce]]
    (Process/put :seqproto-visits [])
    (let [f (fn [a x]
              (Process/put :seqproto-visits (conj (Process/get :seqproto-visits) x))
              (if (= x 2) (reduced (+ a x)) (+ a x)))]
      (is (= 3 (runner f 0 (quote (1 2 3 4)))))
      (is (= [1 2] (Process/get :seqproto-visits))))))

(deftest sentinel-is-peeled-once-including-empty-and-nested-values
  (let [inner (reduced 7) outer (reduced inner) f (fn [_ _] outer)]
    (is (= inner (p/direct-reduce f 0 (quote (1 2)))))
    (is (= inner (p/direct-reduce f outer (quote ()))))
    (is (= inner (p/representation-reduce f outer (quote ()))))))

(deftest callable-arity-and-failure-reasons-are-not-hidden
  (let [one (fn [x] x) fail (fn [_ _] (erlang/error :seqproto-error))]
    (is (= 9 (p/direct-reduce one 9 (quote ()))))
    (is (thrown? (p/direct-reduce one 9 (quote (1)))))
    (is (= [:error :seqproto-error] (try (p/direct-reduce fail 0 (quote (1)))
                              (catch-raw [kind reason stack] [kind reason]))))
    (is (= [:throw :seqproto-throw] (try (p/direct-reduce (fn [_ _] (erlang/throw :seqproto-throw)) 0 (quote (1)))
                              (catch-raw [kind reason stack] [kind reason]))))))

(deftest improper-list-tail-does-not-replay-prefix-effects
  (let [xs (erlang/++ (quote (1 2)) :tail) f (p/adder)]
    (is (= (p/representation-reduce f 0 xs) (p/direct-reduce f 0 xs)))
    (is (= (p/representation-reduce f 0 xs) (p/arithmetic-reduce f 0 xs)))))

(deftest induction-is-proven-and-a-wrong-mapper-is-refuted
  (is (= {:verified true :statuses [:unsat :unsat :unsat] :factor 2}
         (proof/check 2)))
  (let [wrong (proof/check 3)]
    (is (= false (:verified wrong)))
    (is (= :sat (get (:statuses wrong) 1)))))

(deftest compiled-fusion-and-formula-match-the-unfused-program
  (let [fused (p/compile-plan p/pipeline :fused)
        formula (p/compile-plan p/pipeline :formula)]
    (is (= :compiled (:status fused)))
    (is (= :compiled (:status formula)))
    (is (= true (:verified (:proof fused))))
    (doseq [n [0 1 2 31 32 33 63 64 65 1000]]
      (is (= (expected n) (p/unfused n)))
      (is (= (p/unfused n) (erlang/apply (:run fused) (list n))))
      (is (= (expected n) (erlang/apply (:run formula) (list n)))))
    (is (= 9999999999999999999900000000000000000000
           (erlang/apply (:run formula) (list 100000000000000000000))))
    (doseq [bad [-1 1.5 nil :bad]]
      (is (thrown? (erlang/apply (:run fused) (list bad))))
      (is (thrown? (erlang/apply (:run formula) (list bad)))))))

(deftest custom-effects-shared-sources-and-forged-proof-flags-refuse
  (Process/put :seqproto-unwanted 0)
  (let [effect (fn [i x] (Process/put :seqproto-unwanted 1) (+ i x))]
    (doseq [spec [(assoc p/pipeline :map effect)
                 (assoc p/pipeline :source :external)
                 (assoc p/pipeline :source :shared)
                 (assoc p/pipeline :pure true)
                 (assoc p/pipeline :proof {:verified true})
                 (assoc p/pipeline :init 1)
                 (assoc p/pipeline :map [:int-add :index 1])]]
      (is (= :refused (:status (p/compile-plan spec :fused))))))
  (is (= 0 (Process/get :seqproto-unwanted)))
  (is (= :refused (:status (p/compile-plan p/pipeline :unknown)))))

(deftest immutable-callback-identity-does-not-authorize-other-functions
  (let [fake (fn [a x] (erlang/+ 100 (erlang/+ a x)))]
    (is (= 203 (p/arithmetic-reduce fake 0 (quote (1 2)))))
    (is (erlang/=:= (p/adder) (p/adder)))))

(deftest generated-kernel-has-direct-fun-application
  (let [assembly (beam_disasm/file (:beam (p/image-info)))
        functions (elem assembly 5)
        plain (first (filter (fn [row] (= :plain (elem row 1))) functions))
        instructions (elem plain 4)]
    (is (some (fn [op] (contains? #{:call_fun :call_fun2} (elem op 0))) instructions))
    (is (not (some (fn [op] (String/contains? (pr-str op) "invoke")) instructions)))))

(deftest lazy-improper-tail-preserves-effects-and-single-sentinel-peeling
  (doseq [runner [p/representation-reduce p/direct-reduce p/arithmetic-reduce]]
    (Process/put :seqproto-tail-forces 0)
    (let [tail (BeamLisp.LazySeq/new (fn []
                 (Process/put :seqproto-tail-forces (inc (Process/get :seqproto-tail-forces)))
                 (quote (3 4))))
          xs (erlang/++ (quote (1 2)) tail)
          inner (reduced 7)
          f (fn [a x] (if (= x 3) (reduced inner) (+ a x)))]
      (is (= inner (runner f 0 xs)))
      (is (= 1 (Process/get :seqproto-tail-forces)))))
  (Process/put :seqproto-tail-forces 0)
  (let [tail (BeamLisp.LazySeq/new (fn [] (Process/put :seqproto-tail-forces 1) (quote (3))))
        xs (erlang/++ (quote (1 2)) tail)]
    (is (= 1 (p/direct-reduce (fn [_ x] (reduced x)) 0 xs)))
    (is (= 0 (Process/get :seqproto-tail-forces)))))

(deftest maps-and-native-tuples-use-the-representation-fallback
  (let [entries {:a 1 :b 2} f (fn [a entry] (+ a (second entry)))]
    (is (= (reduce f 0 entries) (p/representation-reduce f 0 entries)))
    (is (= 3 (p/direct-reduce f 0 entries))))
  (let [xs (tuple 1 2 3)]
    (is (= 6 (p/direct-reduce (p/adder) 0 xs)))
    (is (= 6 (p/arithmetic-reduce (p/adder) 0 xs)))))
