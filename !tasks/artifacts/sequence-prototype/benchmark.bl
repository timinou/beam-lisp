(ns performance.sequence-prototype-benchmark
  (:require [performance.sequence-prototype :as p] [bl.json :as json]))

(defn emit [data] (println (json/encode data)))
(defn expected [n] (erlang/* n (erlang/- n 1)))
(defn checked [f n]
  (let [answer (erlang/apply f (quote ()))]
    (when (not= answer (expected n)) (erlang/error (tuple :wrong-answer n answer)))
    answer))
(defn timed [label sample n f]
  (let [before (elem (Process/info (erlang/self) :reductions) 1)
        start (System/monotonic_time :microsecond)
        answer (checked f n)
        us (- (System/monotonic_time :microsecond) start)
        work (- (elem (Process/info (erlang/self) :reductions) 1) before)]
    (emit {"kind" "time" "case" label "n" n "sample" sample "us" us
           "reductions" work "answer" answer})))

(defn- trace-sink [] (receive :stop nil _ (trace-sink)))
(defn allocated [label n f]
  ; Only this outer thunk is memory-traced: its count includes untraced callees.
  ; Local fun implementation arity includes captured environment terms.
  (let [mod (elem (erlang/fun_info f :module) 1)
        name (elem (erlang/fun_info f :name) 1)
        arity (erlang/+ (elem (erlang/fun_info f :arity) 1)
                        (erlang/length (elem (erlang/fun_info f :env) 1)))
        mfa (tuple mod name arity)
        sink (erlang/spawn (fn [] (trace-sink)))
        session (trace/session_create :sequence-prototype-memory sink (list))
        before (BeamLisp.LazyMemo/stats)]
    (try
      (let [matches (trace/function session mfa true (list :call_memory))]
        (when (not= 1 matches) (erlang/error (tuple :uncalibrated-memory-pattern mfa matches))))
      (trace/process session (erlang/self) true (list :call))
      (checked f n)
      (trace/process session (erlang/self) false (list :call))
      (let [after (BeamLisp.LazyMemo/stats)
            entry (elem (trace/info session mfa :call_memory) 1)
            own (first (filter (fn [row] (erlang/=:= (erlang/self) (elem row 0))) entry))]
        (when (or (nil? own) (not= 1 (elem own 1)))
          (erlang/error (tuple :uncalibrated-memory-result mfa entry)))
        (emit {"kind" "allocation" "case" label "n" n
               "outer_calls" (elem own 1) "heap_words" (elem own 2)
               "heap_bytes" (erlang/* (erlang/system_info :wordsize) (elem own 2))
               "native_new_fast" (- (:op_new_fast after) (:op_new_fast before))
               "native_reads_fast" (- (:op_read_fast after) (:op_read_fast before))}))
      (finally (trace/session_destroy session) (erlang/send sink :stop)))))

(defn profiled [label n f]
  (cprof/start)
  (checked f n)
  (cprof/pause)
  (emit {"kind" "profile" "case" label "n" n
         "modules" (into [] (map (fn [row]
           {"module" (str (elem row 0)) "calls" (elem row 1)
            "functions" (into [] (map (fn [entry]
              {"mfa" (str (elem entry 0)) "calls" (elem entry 1)})
              (take 16 (elem row 2))))})
           (take 10 (elem (cprof/analyse) 1))))})
  (cprof/stop))

(let [fused (p/compile-plan p/pipeline :fused)
      formula (p/compile-plan p/pipeline :formula)
      add (p/adder)]
  (when (or (not= :compiled (:status fused)) (not= :compiled (:status formula)))
    (erlang/error (tuple :unproved-plan fused formula)))
  (emit {"kind" "setup" "otp" (erlang/system_info :otp_release)
         "schedulers" (erlang/system_info :schedulers_online)
         "kernel_compile_us" (:compile-us (p/image-info))
         "fusion_compile_us" (:compile-us fused) "formula_compile_us" (:compile-us formula)
         "proof_statuses" (into [] (map name (:statuses (:proof fused))))})
  (doseq [n [1000 16000 64000]]
    (let [xs (lists/map (fn [i] (erlang/* 2 i)) (lists/seq 0 (erlang/- n 1)))
          cases [["raw-list" (fn [] (lists/foldl (fn [x a] (erlang/+ a x)) 0 xs))]
                 ["public-reduce-value-plus" (fn [] (reduce + 0 xs))]
                 ["p1-representation-value-plus" (fn [] (p/representation-reduce + 0 xs))]
                 ["p1-representation-known-adder" (fn [] (p/representation-reduce add 0 xs))]
                 ["p2-direct-known-adder" (fn [] (p/direct-reduce add 0 xs))]
                 ["p3-specialized-known-adder" (fn [] (p/arithmetic-reduce add 0 xs))]
                 ["raw-range-loop" (fn [] (lists/foldl (fn [i a] (erlang/+ a (erlang/* 2 i)))
                                                     0 (lists/seq 0 (erlang/- n 1))))]
                 ["unfused-known-pipeline" (fn [] (p/unfused n))]
                 ["p4-proof-fused-loop" (fn [] (erlang/apply (:run fused) (list n)))]
                 ["bonus-proof-formula" (fn [] (erlang/apply (:run formula) (list n)))]]]
      (doseq [entry cases] (checked (get entry 1) n))
      (doseq [sample [1 2 3 4 5]]
        (doseq [entry cases] (timed (get entry 0) sample n (get entry 1))))
      (doseq [entry cases] (allocated (get entry 0) n (get entry 1)))
      (when (= n 16000)
        (doseq [entry cases] (profiled (get entry 0) n (get entry 1)))))))
