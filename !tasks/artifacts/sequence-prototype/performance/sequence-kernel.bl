; Experimental native BEAM lowering. No production module or seed changes.
(ns performance.sequence-kernel)

(defn- lit [x] (cerl/abstract x))
(defn- v [x] (cerl/c_var x))
(defn- call [m f args] (cerl/c_call (lit m) (lit f) args))
(defn- local [f arity args] (cerl/c_apply (cerl/c_fname f arity) args))
(defn- clause [patterns body] (cerl/c_clause patterns (lit true) body))
(defn- choose [test yes no]
  (cerl/c_case test (list (clause (list (lit true)) yes)
                         (clause (list (lit false)) no))))
(defn- bif [f args] (call :erlang f args))

(defn- sentinel? [r]
  (choose (bif :is_map (list r))
    (bif :=:= (list (call :maps :get (list (lit :__struct__) r (lit nil)))
                    (lit :"Elixir.BeamLisp.Reduced")))
    (lit false)))

(defn- tail-fallback [f a xs]
  ; Match RT.reduce-list's improper/lazy-tail contract, without restarting f.
  (choose (bif :== (list (call :"Elixir.BeamLisp.Ns.Rt" :kind-kind (list xs))
                         (lit :lazy)))
    (call :"Elixir.BeamLisp.Ns.Rt" :k-fold (list f a xs)) a))

(defn- plain-body []
  (let [f (v :F) a (v :A) xs (v :Xs) x (v :X) tail (v :Tail) r (v :R)]
    (cerl/c_case xs
      (list (clause (list (cerl/c_nil)) a)
            (clause (list (cerl/c_cons x tail))
              (cerl/c_let (list r)
                ; c_apply becomes a direct BEAM fun call: no RT.invoke or arg list.
                (cerl/c_apply f (list a x))
                (choose (sentinel? r) r (local :plain 3 (list f r tail)))))
            (clause (list (v :Other)) (tail-fallback f a xs))))))

(defn- integer-body []
  (let [f (v :F) a (v :A) xs (v :Xs) x (v :X) tail (v :Tail)]
    (cerl/c_case xs
      (list (clause (list (cerl/c_nil)) a)
            (clause (list (cerl/c_cons x tail))
              (choose (bif :is_integer (list x))
                (local :integer 3 (list f (bif :+ (list a x)) tail))
                ; A failed per-element type guard resumes at this suffix.
                (local :plain 3 (list f a xs))))
            (clause (list (v :Other)) (tail-fallback f a xs))))))

(defn- fused-body []
  (let [i (v :I) a (v :A) n (v :N)]
    (choose (bif :< (list i n))
      (local :walk 3 (list (bif :+ (list i (lit 1)))
                           (bif :+ (list a (bif :+ (list i i)))) n)) a)))

(defn build
  "Build one private experimental image with immutable callback captures."
  []
  (let [mod (erlang/binary_to_atom
              (str "Elixir.SequencePrototype.K" (erlang/unique_integer (list :positive))))
        f (v :F) a (v :A) xs (v :Xs) n (v :N)
        exports (list (cerl/c_fname :plain 3) (cerl/c_fname :integer 3)
                      (cerl/c_fname :adder 0) (cerl/c_fname :fused 1)
                      (cerl/c_fname :formula 1) (cerl/c_fname :module_info 0)
                      (cerl/c_fname :module_info 1))
        defs (list
          (tuple (cerl/c_fname :module_info 0)
            (cerl/c_fun (list) (bif :get_module_info (list (lit mod)))))
          (tuple (cerl/c_fname :module_info 1)
            (cerl/c_fun (list (v :What)) (bif :get_module_info (list (lit mod) (v :What)))))
          (tuple (cerl/c_fname :plain 3) (cerl/c_fun (list f a xs) (plain-body)))
          (tuple (cerl/c_fname :integer 3) (cerl/c_fun (list f a xs) (integer-body)))
          (tuple (cerl/c_fname :adder 0)
            (cerl/c_fun (list)
              (cerl/c_fun (list a n) (bif :+ (list a n)))))
          (tuple (cerl/c_fname :fused 1)
            (cerl/c_fun (list n) (local :walk 3 (list (lit 0) (lit 0) n))))
          (tuple (cerl/c_fname :walk 3)
            (cerl/c_fun (list (v :I) a n) (fused-body)))
          (tuple (cerl/c_fname :formula 1)
            (cerl/c_fun (list n) (bif :* (list n (bif :- (list n (lit 1))))))))
        tree (cerl/c_module (lit mod) exports (list) defs)
        started (System/monotonic_time :microsecond)
        compiled (compile/forms tree (list :from_core :binary :return_errors :return_warnings))]
    (when (not= :ok (elem compiled 0)) (erlang/error (tuple :kernel-compile compiled)))
    (let [beam (elem compiled 2)
          loaded (code/load_binary mod (erlang/binary_to_list "sequence-prototype.core") beam)]
      (when (not= :module (elem loaded 0)) (erlang/error (tuple :kernel-load loaded)))
      {:module mod :beam beam :compile-us (- (System/monotonic_time :microsecond) started)
       :plain (erlang/make_fun mod :plain 3)
       :integer (erlang/make_fun mod :integer 3)
       :fused (erlang/make_fun mod :fused 1)
       :formula (erlang/make_fun mod :formula 1)
       :adder (erlang/apply mod :adder (quote ()))})))
