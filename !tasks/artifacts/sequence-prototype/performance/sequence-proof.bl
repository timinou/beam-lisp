; Finite integer range + indexed-add + sum. Unknown is never authorization.
(ns performance.sequence-proof
  (:require [z3] [oracle]))

(defn check
  "Prove the base, transition and terminal equations. factor=2 is the emitted
   mapper; other factors are useful negative controls, not compiler options."
  [factor]
  (when (not (erlang/is_integer factor)) (erlang/error :invalid-proof-factor))
  (let [port (z3/open)
        decl "(declare-const i Int) (declare-const a Int) (declare-const n Int) "
        obligations
        [(z3/check port "(assert (not (= 0 (* 0 (- 0 1)))))")
         (z3/check port
           (str decl "(assert (>= n 0)) (assert (>= i 0)) (assert (< i n)) "
                "(assert (= a (* i (- i 1)))) "
                "(assert (not (and (= (+ a (* " factor " i)) (* (+ i 1) i)) "
                "(<= (+ i 1) n) (>= (+ i 1) 0))))"))
         (z3/check port
           (str decl "(assert (>= n 0)) (assert (= i n)) "
                "(assert (= a (* i (- i 1)))) "
                "(assert (not (= a (* n (- n 1)))))"))]]
    {:verified (every? oracle/proven? obligations)
     :statuses (into [] (map :status obligations))
     :factor factor}))
