; Experimental APIs only. Generated kernels do not alter production code.
(ns performance.sequence-prototype
  (:require [performance.sequence-kernel :as kernel]
            [performance.sequence-proof :as proof]))

(def ^:private image (kernel/build))

(defn image-info [] (select-keys image [:module :beam :compile-us]))
(defn adder "A known immutable callback, NOT a snapshot of reloadable core/+" [] (:adder image))

(defn representation-reduce [f init coll]
  (BeamLisp.Ns.Rt/k-reduce f init coll))

(defn- finish [x]
  (if (BeamLisp.Ns.Rt/reduce-reduced? x) (erlang/map_get :value x) x))

(defn direct-reduce
  "Known arity-2 fun + list selects direct BEAM application. Other callables
   and representations retain the existing RT kernel. Sentinel peeled once."
  [f init coll]
  (if (and (erlang/is_function f 2) (erlang/is_list coll))
    (finish (erlang/apply (:plain image) (list f init coll)))
    (representation-reduce f init coll)))

(defn arithmetic-reduce
  "Only the generated immutable adder is specialized. Integer guard failure
   resumes the unchanged suffix through direct application of that same f."
  [f init coll]
  (if (and (erlang/=:= f (:adder image)) (erlang/is_integer init) (erlang/is_list coll))
    (finish (erlang/apply (:integer image) (list f init coll)))
    (direct-reduce f init coll)))

(def pipeline
  ; A closed program, not a caller-supplied purity or ownership claim. The
  ; compiler creates all producers internally and only returns the scalar sum.
  {:source :range-zero :map [:int-add :index :value] :reduce :int-add :init 0})

(defn- valid-bound! [n]
  (when (not (and (erlang/is_integer n) (erlang/>= n 0)))
    (erlang/error (tuple :unsupported-bound n))))

(defn unfused
  "Same closed program executed by today's sequence library, no fusion."
  [n]
  (valid-bound! n)
  (reduce (adder) 0
    (take n (map-indexed (fn [i x] (erlang/+ i x)) (range)))))

(defn compile-plan
  "Accept only the exact closed integer program. Effects/custom callbacks,
   external/shared sources and extra self-asserted proof flags are refused.
   Solver authorization happens at compilation, never inside the hot loop."
  [program mode]
  (cond
    (not= program {:source :range-zero :map [:int-add :index :value] :reduce :int-add :init 0}) {:status :refused :reason :unsupported-program}
    (not (contains? #{:fused :formula} mode)) {:status :refused :reason :unsupported-mode}
    :else
    (let [started (System/monotonic_time :microsecond)
          evidence (proof/check 2)]
      (if (:verified evidence)
        (let [worker (if (= mode :fused) (:fused image) (:formula image))]
          {:status :compiled :mode mode :proof evidence
           :compile-us (- (System/monotonic_time :microsecond) started)
           :run (fn [n] (valid-bound! n) (erlang/apply worker (list n)))})
        {:status :refused :reason :unproved :proof evidence}))))
