; Run only against a coherently regenerated current image. Each build checks
; structural reuse; wall time is evidence, never a pass/fail latency threshold.
(ns performance.postfix-incremental
  (:require [build :as b] [build-plan :as bp]))

(defn checked [ok message]
  (when (not ok) (erlang/error message)))

(let [dir (Path/join (System/tmp_dir!)
            (str "bl_postfix_incremental_" (System/unique_integer (list :positive))))
      src (Path/join dir "src")
      out (Path/join dir "ebin")
      leaf (Path/join src "postfixleaf.bl")
      consumer (Path/join src "postfixconsumer.bl")
      unrelated (Path/join src "postfixunrelated.bl")
      paths [leaf consumer unrelated]]
  (File/mkdir_p! src)
  (File/mkdir_p! out)
  (try
    (File/write! leaf "(ns postfixleaf) (defn value [] 1)\n")
    (File/write! consumer
      "(ns postfixconsumer (:require [postfixleaf :as p])) (defn read-value [] (p/value))\n")
    (File/write! unrelated "(ns postfixunrelated) (defn value [] 9)\n")
    (BeamLisp.Loader/with_search_dir src
      (fn []
        (let [run (fn [label]
                    (let [t (System/monotonic_time :microsecond)
                          before (elem (Process/info (erlang/self) :reductions) 1)
                          result (b/run {:sources paths :root dir :out out :jobs 1 :scope :full})
                          elapsed (- (System/monotonic_time :microsecond) t)
                          reductions (- (elem (Process/info (erlang/self) :reductions) 1) before)]
                      (println "POSTFIX-INCREMENTAL" {:phase label :us elapsed
                                 :reductions reductions :built (:built result)
                                 :errors (:errors result)})
                      (checked (empty? (:errors result)) (str label " failed " (:errors result)))
                      result))]
          (checked (= 3 (:built (run :initial))) "initial inventory must build three units")
          (checked (= 0 (:built (run :unchanged))) "unchanged inventory must reuse every unit")
          (let [before (bp/key-for "postfixconsumer" (fn [ns] (BeamLisp.Loader/source_content ns)) nil bp/memo-node)]
            ; Same-length bytes: no mtime/size-only freshness assumption.
            (File/write! leaf "(ns postfixleaf) (defn value [] 2)\n")
            (checked (= before (bp/key-for "postfixconsumer" (fn [ns] (BeamLisp.Loader/source_content ns)) nil bp/memo-node)) "ordinary body edit must preserve the consumer key")
            (checked (= 1 (:built (run :provider-body-edit))) "body edit must rebuild only its provider"))
          (File/write! leaf "(ns postfixleaf) (defn value ([] 2) ([x] x))\n")
          (checked (= 2 (:built (run :provider-interface-edit))) "interface edit must rebuild provider and consumer")
          (checked (= 0 (:built (run :unchanged-after-edit))) "post-edit inventory must reach a fixed point"))))
    (finally (File/rm_rf! dir))))
