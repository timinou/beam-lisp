; Observe emitted step instructions and every cursor/recipe ingress separately.
(ns optimizer.mode.audit (:require [bl.json :as json]))
(let [path (Path/join (System/fetch_env! "BL_EBIN") "Elixir.BeamLisp.Ns.Body.Rt.beam")
      image (beam_disasm/file (String/to_charlist path))
      fs (elem image 5)]
  (doseq [f fs :when (or (and (= :step (elem f 1)) (= 3 (elem f 2)))
                         (String/contains? (str (elem f 1)) "reduce-callback"))]
    (println (json/encode {"type" "bytecode" "image" (System/get_env "BL_MODE_IMAGE")
                          "function" (str (elem f 1) "/" (elem f 2)) "instructions" (pr-str (elem f 4))}))))
(doseq [n [0 1 31 32 33 63 64 65]]
  (let [xs (lists/seq 0 (dec n))
        cursor (BeamLisp.SeqCursor/new xs)
        expected (quot (* n (dec n)) 2)
        actual (BeamLisp.Ns.Rt/lazy-reduce-source + 0 cursor)
        s (map identity xs)
        counted (BeamLisp.Ns.Rt/k-count s)
        s2 (map identity xs)
        materialized (BeamLisp.Ns.Rt/k-to-list s2)]
    (when (or (not= expected actual) (not= n counted) (not= xs materialized))
      (erlang/error (tuple :mode-recipe-ingress-mismatch n actual counted materialized)))
    (println (json/encode {"type" "recipe-ingress" "image" (System/get_env "BL_MODE_IMAGE")
                          "n" n "cursor_answer" actual "count_answer" counted
                          "materialized_count" (erlang/length materialized)}))))
