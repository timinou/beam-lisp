; Normal compiler/descriptor API, not hand-built machine kernels.
(ns optimizer.measure
  (:require [anf :as anf] [compiler :as compiler] [lower :as lower]
            [optimize :as opt] [bl.json :as json]))

(defn image [source enabled]
  (compiler/reset-fresh!)
  (let [mod (erlang/binary_to_atom (str "Elixir.OptimizerMeasure.M" (erlang/unique_integer (list :positive))))
        desc (anf/module mod
               (list {:op :defn-clause :fname :run :params '() :guard nil
                      :body (compiler/compile-node (BeamLisp.Reader/read_one source)
                                                   (compiler/new-env "user")) :ann {}})
               (list [:run 0]) '())
        pair (lower/descriptor->beam desc {:enabled? enabled})]
    (code/load_binary mod '() (elem pair 1))
    {:f (erlang/apply mod :run '()) :rules (map :rule (:evidence (opt/explain desc)))}))

(def cases
  [{:name "guarded-callback"
    :source "(fn [f n] (if (erlang/is_function f 2) (loop [i 0 acc 0] (if (< i n) (recur (+ i 1) (f acc i)) acc)) :unsupported))"
    :factor 1 :callback true}
   {:name "integer-fold"
    :source "(fn [n] (if (erlang/is_integer n) (lists/foldl (fn [x acc] (+ acc x)) 0 (lists/seq 0 (- n 1))) :unsupported))"
    :factor 1 :callback false}
   {:name "strict-map-fold"
    :source "(fn [n] (if (erlang/is_integer n) (lists/foldl (fn [x acc] (+ acc x)) 0 (lists/map (fn [x] (* x 2)) (lists/seq 0 (- n 1)))) :unsupported))"
    :factor 2 :callback false}])

(def adder (fn [a x] (erlang/+ a x)))
(def images
  (mapv (fn [c] (assoc c :baseline (image (:source c) false) :optimized (image (:source c) true))) cases))

(defn invoke [c mode n]
  (erlang/apply (:f (get c mode)) (if (:callback c) (list adder n) (list n))))

(defn sample [c mode n repeat]
  (let [before (elem (erlang/process_info (erlang/self) :reductions) 1)
        timed (timer/tc (fn [] (invoke c mode n)))
        after (elem (erlang/process_info (erlang/self) :reductions) 1)
        expected (quot (* (:factor c) n (dec n)) 2)]
    (when (not= expected (elem timed 1)) (erlang/error :optimizer-measure-wrong-answer))
    (println (json/encode {"type" "time" "case" (:name c) "mode" (name mode)
                          "n" n "repeat" repeat "us" (elem timed 0)
                          "reductions" (- after before) "answer" (elem timed 1)}))))

(doseq [c images]
  (println (json/encode {"type" "setup" "case" (:name c) "rules" (:rules (:optimized c))}))
  (invoke c :baseline 1000) (invoke c :optimized 1000))
(doseq [n [1000 16000 64000] repeat (range 5) c images mode [:baseline :optimized]]
  (sample c mode n repeat))
