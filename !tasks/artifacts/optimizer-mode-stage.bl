; Compile an isolated whole-RT experiment from the one authoritative source.
; No walker copy or published seed mutation. Exact anchors fail closed on drift.
; Run through optimizer-stage.sh's eval phase with BL_MODE_SOURCE_DIR set.
(ns optimizer.mode.stage)

(defn- replace-once [source old new]
  (let [parts (String/split source old)]
    (when (not= 2 (count parts)) (erlang/error (tuple :mode-prototype-anchor-drift old)))
    (str (first parts) new (second parts))))

(defn- hoisted-source [source]
  (when (or (not= 2 (dec (count (String/split source "(lazy-fold-claimed "))))
            (not= 2 (dec (count (String/split source "(lazy-fold-claimed x claim (fn [a _] a) nil)")))))
    (erlang/error :mode-prototype-unproven-recipe-ingress))
  (let [s (replace-once source
            "(cond\n    (erlang/is_function f 2) (f acc x)\n    :else (call-invoke f `(~acc ~x))))"
            (if (= "1" (System/get_env "BL_MODE_PACKED"))
              "(erlang/apply f `(~acc ~x)))"
              "(erlang/apply f (reduce-two acc x)))"))
        s (replace-once s "(let [kd (kind-kind coll)]\n     (cond\n       (erlang/== kd :list) (reduce-list f init coll policy)"
                         "(let [f (reduce-callback f) kd (kind-kind coll)]\n     (cond\n       (erlang/== kd :list) (reduce-list f init coll policy)")
        s (replace-once s "(let [cb (cond (erlang/== mode :normalized) (reduce-callback f) :else f)]"
                         "(let [cb (reduce-callback f)]")
        s (replace-once s
            "(struct-of? source :\"Elixir.BeamLisp.SeqCursor\") (reduce-cursor rf init source)"
            "(struct-of? source :\"Elixir.BeamLisp.SeqCursor\") (reduce-cursor (reduce-callback rf) init source)")]
    s))

(let [source (File/read! "priv/boot/rt.bl")
      dir (System/fetch_env! "BL_MODE_SOURCE_DIR")
      path (Path/join dir "rt.bl")]
  (when (or (String/starts_with? (Path/expand dir) (str (Path/expand (BeamLisp/cwd)) "/"))
            (String/starts_with? (Path/expand (System/fetch_env! "BL_EBIN"))
                                 (str (Path/expand (BeamLisp/cwd)) "/")))
    (erlang/error :mode-prototype-requires-external-staging-directories))
  (File/mkdir_p! dir)
  (let [generated (hoisted-source source)]
    (File/write! path generated)
    (println "MODE-SOURCE-SHA256"
      (Base/encode16 (crypto/hash :sha256 source) (list (tuple :case :lower)))
      (Base/encode16 (crypto/hash :sha256 generated) (list (tuple :case :lower)))))
  ; The two lazy-fold-claimed callers pass literal arity-2 callbacks. All
  ; remaining private walks enter through k-fold or lazy-fold-source above.
  (println "MODE-HOISTED-SOURCE" path)
  (println "MODE-HOISTED-COMPILE"
    (BeamLisp.AOT/compile_file path
      (list (tuple :output_dir (System/fetch_env! "BL_EBIN"))))))
