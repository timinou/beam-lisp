; docs-gate.bl — the document gate: run every tracked livebook, then prove its
; replay. Port of the removed !tasks/artifacts/docs-gate.exs.
;
; `bl.doc/run-and-write!` runs a document's cells in document order and writes
; the result spans back into the file; a cell error fails the gate. The two
; change-session documents are then re-run and must come back byte-identical —
; a document's stored results are a fixed point of a fresh run.
;
; THIS GATE WRITES THE DOCUMENTS IT RUNS — that is its job. To check a tree
; without touching it, copy the documents to a scratch tree and run there.
;
; Reached from canonical-upgrade-gate.exs as `CANONICAL_ACTION=docs`, after the
; canonical floor is staged. It halts 0 on success, so the canonical harness's
; ExUnit phase does not run in action mode.
(ns docs-gate)
(BeamLisp.Loader/ensure_loaded "bl.doc")

;; Bound under the callee's own name, never a bare `run!`: a 1-arity global
;; called with a mismatched arity falls back to the linked core global of the
;; same name (`core/run!`), which silently answers `nil`. One name, one owner.
(def run-and-write! (BeamLisp.Env/fetch! "bl.doc" "run-and-write!"))

(def paths
  ["docs/memory-policy/shared-lazy-values.bl.md"
   "docs/compiler/finite-data.bl.org"
   "docs/compiler/generation.bl.org"
   "docs/from-source-to-silicon/03-one-ir.bl.org"
   "docs/dev/executable-changes.bl.org"
   "examples/dev/change-session.bl.org"])

(doseq [path paths]
  (let [result (run-and-write! path)]
    (println "DOC_RESULT" (pr-str result))
    (when (not (empty? (:errors result)))
      (throw (ex-info (str "document failed: " path) {})))))

(def replay-paths ["docs/dev/executable-changes.bl.org" "examples/dev/change-session.bl.org"])

(doseq [path replay-paths]
  (let [before (File/read! path)
        result (run-and-write! path)]
    (when (not (empty? (:errors result)))
      (throw (ex-info (str "replay failed: " path) {})))
    (when (not= (File/read! path) before)
      (throw (ex-info (str "non-idempotent document replay: " path) {})))
    (println (str "DOC_REPLAY_IDENTICAL: " path))))

;; The canonical harness stages a candidate floor in a temp dir and registers it
;; for cleanup under this process-dict key; a postlude that halts must run that
;; cleanup itself, because `System/halt` skips the harness's `System.at_exit`.
(doseq [dir (let [v (erlang/get :canonical_upgrade_cleanup)] (if (= :undefined v) [] v))]
  (File/rm_rf! dir))

(System/halt 0)
