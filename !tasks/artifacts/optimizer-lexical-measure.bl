; Compile ordinary source once per variant; no synthetic Core kernels.
(ns optimizer.lexical.measure
  (:require [anf :as a] [compiler :as c] [lower :as l]
            [optimize :as o] [bl.json :as json]))

(def cases
  [{:name "callback-alias" :factor 1
    :body "(let [f (fn [x a] (+ a x)) g f] (lists/foldl g 0 (lists/seq 0 (- n 1))))"}
   {:name "private-map" :factor 2
    :body "(let [xs (lists/map (fn [x] (* x 2)) (lists/seq 0 (- n 1)))] (lists/foldl (fn [x a] (+ a x)) 0 xs))"}
   {:name "alias-private-map" :factor 2
    :body "(let [f (fn [x a] (+ a x)) g f h g m (fn [x] (* x 2)) k m xs (lists/map k (lists/seq 0 (- n 1)))] (lists/foldl h 0 xs))"}])
(def modes [["disabled" {:enabled? false}] ["current" {:lexical? false}] ["lexical" {:lexical? true}]])

(defn instructions [beam]
  (let [image (beam_disasm/file beam)]
    (mapcat (fn [f] (nth (erlang/tuple_to_list f) 4)) (nth (erlang/tuple_to_list image) 5))))
(defn has-map? [beam]
  (some (fn [ins]
          (and (erlang/is_tuple ins)
               (some (fn [v] (= v (tuple :extfunc :lists :map 2))) (erlang/tuple_to_list ins))))
        (instructions beam)))

(defn image [case mode opts]
  (c/reset-fresh!)
  (let [mod (erlang/binary_to_atom (str "Elixir.OptimizerLexicalMeasure.M" (erlang/unique_integer (list :positive))))
        source (str "(fn [n] (if (erlang/is_integer n) " (:body case) " :unsupported))")
        m (a/module mod (list {:op :defn-clause :fname :run :params '() :guard nil
                              :body (c/compile-node (BeamLisp.Reader/read_one source) (c/new-env "user")) :ann {}})
                    (list [:run 0]) '())
        proof (timer/tc (fn [] (o/explain m opts)))
        compilation (timer/tc (fn [] (l/descriptor->beam m opts)))
        pair (elem compilation 1)]
    (when (not= (tuple :module mod) (code/load_binary mod '() (elem pair 1)))
      (erlang/error :lexical-measure-load-failed))
    (println (json/encode {"type" "setup" "case" (:name case) "mode" mode
                          "optimizer_us" (elem proof 0) "compile_us" (elem compilation 0)
                          "beam_bytes" (erlang/byte_size (elem pair 1)) "has_map" (boolean (has-map? (elem pair 1)))
                          "stats" (:stats (elem proof 1)) "rules" (map :rule (:evidence (elem proof 1)))}))
    {:case (:name case) :factor (:factor case) :mode mode :f (erlang/apply mod :run '())}))

(def images (vec (for [case cases [mode opts] modes] (image case mode opts))))
(defn sample [image n repeat]
  (let [before (elem (erlang/process_info (erlang/self) :reductions) 1)
        t (timer/tc (fn [] (erlang/apply (:f image) (list n))))
        after (elem (erlang/process_info (erlang/self) :reductions) 1)
        expected (quot (* (:factor image) n (dec n)) 2)]
    (when (not= expected (elem t 1)) (erlang/error :lexical-measure-answer-mismatch))
    (println (json/encode {"type" "time" "case" (:case image) "mode" (:mode image)
                          "n" n "repeat" repeat "us" (elem t 0)
                          "reductions" (- after before) "answer" (elem t 1)}))))
(doseq [image images] (erlang/apply (:f image) (list 1000)))
(doseq [n [1000 16000 64000] repeat (range 5)
        image (if (even? repeat) images (reverse images))]
  (sample image n repeat))
