; research-gate.bl — the research oracle gate. Port of the removed
; !tasks/artifacts/research-gate.exs.
;
; Loads the three research scripts in order — compile/emit latency (`bench`),
; corpus census (`census`), and the value oracle that runs six canonical test
; files through the eval-form path (`oracle`) — then fails unless every oracle
; suite total has no failures or errors.
;
; Reached from canonical-upgrade-gate.exs as `CANONICAL_ACTION=research`. It
; halts 0 on success, so the canonical harness's ExUnit phase does not run in
; action mode.
(ns research-gate)

(BeamLisp/run_file "research/ce1_core_erlang/bench.bl")
(BeamLisp/run_file "research/ce1_core_erlang/census.bl")
(BeamLisp/run_file "research/ce1_core_erlang/oracle.bl")

(def totals (to-list (BeamLisp.Env/fetch! "oracle" "totals")))
(println "RESEARCH_ORACLE_RESULTS" (pr-str totals))
(when (not (every? BeamLisp.TestRT/passed? totals))
  (throw (ex-info "research value oracle failed" {})))

;; The canonical harness stages a candidate floor in a temp dir and registers it
;; for cleanup under this process-dict key; a postlude that halts must run that
;; cleanup itself, because `System/halt` skips the harness's `System.at_exit`.
(doseq [dir (let [v (erlang/get :canonical_upgrade_cleanup)] (if (= :undefined v) [] v))]
  (File/rm_rf! dir))

(System/halt 0)
