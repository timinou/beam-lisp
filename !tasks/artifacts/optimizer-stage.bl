; Previous verified floor -> pinned optimizer -> canonical lowerer -> kernels.
; Narrow phases avoid repeating completed compiler/runtime stage work.
(ns optimizer-stage)
(def phase (System/get_env "BL_STAGE_PHASE"))
(def out (System/get_env "BL_EBIN"))
(defn pin-optimizer []
  (println "OPTIMIZER-STAGE" "priv/host/optimize.bl")
  (BeamLisp.AOT/compile_host_file "priv/host/optimize.bl"
    (list (tuple :module :Elixir.BeamLisp.Optimize) (tuple :output_dir out)
          (tuple :source_hash (Base/encode16 (crypto/hash :sha256 (File/read! "priv/host/optimize.bl"))
                                            (list (tuple :case :lower)))))))
(cond
  (= phase "pin-optimizer") (do (pin-optimizer) (println "OPTIMIZER-PIN-DONE"))
  (= phase "optimizer")
    (do
      (pin-optimizer)
      (doseq [[path ns] [["priv/boot/optimize.bl" "optimize"]
                        ["priv/boot/lower.bl" "lower"]
                        ["priv/boot/rt.bl" "rt"]
                        ["priv/boot/core.bl" "core"]]]
        (println "OPTIMIZER-STAGE" path)
        (BeamLisp.AOT/compile_file path (list (tuple :output_dir out)))
        (BeamLisp.Env/mark_loaded ns))
      (println "OPTIMIZER-STAGE-DONE"))
  (= phase "seed")
    (let [project (BeamLisp/eval (File/read! (str (BeamLisp/cwd) "/env.bl")))
          _ (BeamLisp.Loader/ensure_loaded "app-resource")
          app (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! "app-resource" "of-project") (list project))
          _ (when (not (:ok? app)) (erlang/error (str "invalid app declaration: " app)))
          _ (BeamLisp.Loader/ensure_loaded "seed")
          result (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! "seed" "run")
                   (list {:ebin out :out (System/get_env "BL_STAGE_SEED") :app app}))]
      (println "STAGE-SEED-RESULT" result)
      (when (not (:ok? result)) (erlang/error (str "candidate seed failed: " result))))
  :else (BeamLisp/eval (File/read! (str (BeamLisp/cwd) "/!tasks/artifacts/incremental-foundation-stage.bl"))))
