; Performance review probes. Run with bounded systemd scope:
; bin/bl run !tasks/artifacts/performance-review-probes.bl
; Source analyses are advisory: unknown interop is not evidence of a bug.
; The chunk invariant is an explicit model, not a proof of emitted code.
(ns performance-review-probes
  (:require [codebase :as cb] [typed :as tt]
            [system.analyze :as an] [system.core :as sys]
            [veritas :as v] [z3]))

(defn measured [label f]
  (let [t (erlang/monotonic_time :microsecond)
        r (f)]
    (println label {:us (- (erlang/monotonic_time :microsecond) t) :result r})
    r))

(println "VM" {:otp (erlang/system_info :otp_release)
                :schedulers (erlang/system_info :schedulers_online)
                :dirty-io (erlang/system_info :dirty_io_schedulers)})

(doseq [path ["priv/host/aot_cache.bl" "priv/host/launcher.bl"
              "priv/host/seq_cursor.bl" "priv/host/lazy_memo.bl"]]
  (let [src (File/read! path)]
    (try
      (measured (str "CODEBASE " path)
        (fn []
          (let [facts (cb/index-source {} "review" src)
                calls (:calls facts)
                io (filter (fn [c]
                             (contains? #{"File/read" "File/read!" "File/stat"
                                          "File/stat!" "File/ls!" "crypto/hash"
                                          "BeamLisp.AOTCache/toolchain_key"}
                                        (:call/callee c))) calls)]
            {:definitions (count (:fn facts)) :calls (count calls)
             :io-sites (into [] (map #(select-keys % [:call/caller :call/callee
                                                       :call/line :call/loop-depth]) io))})))
      (catch e (println "CODEBASE-ERROR" path (str e))))
    (try
      (measured (str "TYPED " path)
        (fn []
          (let [r (tt/check-source src "core")]
            {:warnings (count (:warnings r)) :examples (into [] (take 4 (:warnings r)))
             :positions (count (:evidence r))})))
      (catch e (println "TYPED-ERROR" path (str e))))
    (try
      (measured (str "SYSTEM " path)
        (fn []
          (let [r (an/analyze src)]
            {:functions (count r)
             :summaries (into {} (take 8 r))})))
      (catch e (println "SYSTEM-ERROR" path (str e))))))

(let [port (z3/open)]
  (try
    (measured "VERITAS chunk-boundary output parity"
      (fn []
        (v/for-all port "n" (v/one-of 0 1 31 32 33 63 64 65)
          '(= (to-list (take n (map-indexed (fn [i x] (+ i x)) (range))))
              (to-list (map (fn [i] (* 2 i)) (range n)))))))
    (measured "SYSTEM chunk occupancy model"
      (fn []
        (sys/prove-box port
          (fn [x] (str "(and (>= " x " 0) (<= " x " 32))"))
          "c" "(declare-const c Int)" "0"
          [{:label :emit :guard "(< c 32)" :next "(+ c 1)"}
           {:label :flush :guard "(= c 32)" :next "0"}])))
    (finally nil))) ; The supervised solver pool belongs to this VM.

(doseq [n [1000 4000 16000]]
  (measured (str "LAZY map-indexed " n)
    (fn [] (reduce + 0 (take n (map-indexed (fn [i x] (+ i x)) (range))))))
  (measured (str "EAGER map-indexed " n)
    (fn [] (reduce + 0 (map-indexed (fn [i x] (+ i x)) (range n)))))
  (measured (str "RAW Erlang reduce " n)
    (fn [] (lists/foldl (fn [x acc] (erlang/+ acc (erlang/* 2 x))) 0
                       (lists/seq 0 (erlang/- n 1))))))
