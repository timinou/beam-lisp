; Native acceptance fixtures for root's serialized staged SDK. Not run yet.
(ns reload.collection-constructor-test
 (:require [reload.collection-constructor :as constructor]
           [reload.generation :as generation] [env]))
; Only the test runner seam changes. Proof implementation and fixture bodies
; are copied verbatim; direct assertions retain source line/expression labels.
(def ^:private direct-results (atom {:assertions 0 :pass 0 :failures []}))
(defn- direct-check! [source thunk]
 (swap! direct-results update :assertions inc)
 (try
  (let [value (thunk)]
   (if value (swap! direct-results update :pass inc)
    (swap! direct-results update :failures conj {:source source :actual (pr-str value)})))
  (catch error
   (swap! direct-results update :failures conj
          {:source source :error (ex-message error) :kind (:kind (ex-data error))})))
 true)
(defn direct-report [] @direct-results)

(defn- lit [value] {:op :lit :val value})
(defn- route [targets operation]
 (or (first (keep (fn [[target op]] (when (= operation op) target)) targets))
     (throw (ex-info "SDK constructor route missing" {:operation operation}))))
(defn- call [target args]
 {:op :remote :mod (first target) :fun (second target) :args args})
(defn- refusal [f] (try (f) nil (catch e (:kind (ex-data e)))))

(defn finite-projection-can-only-escape-after-materialization []
 (let [targets (constructor/sdk-targets) vals-route (route targets :values)
       set-route (route targets :set) conj-route (route targets :conj)
       projection (call vals-route [(lit {"read" :read "write" :write})])
       value (call conj-route [(call set-route [projection]) (lit :unknown)])]
  (direct-check! "collection-constructor-test.bl:18: (= :set (:kind (constructor/shape! value targets #{})))" (fn [] (= :set (:kind (constructor/shape! value targets #{})))))
  (direct-check! "collection-constructor-test.bl:19: (= :unproved-collection-constructor (refusal #(constructor/shape! projection targets #{})))" (fn [] (= :unproved-collection-constructor (refusal #(constructor/shape! projection targets #{})))))
  (direct-check! "collection-constructor-test.bl:20: (= false (constructor/proved? (call set-route [{:op :fn :clauses []}]) targets #{}))" (fn [] (= false (constructor/proved? (call set-route [{:op :fn :clauses []}]) targets #{}))))
  (direct-check! "collection-constructor-test.bl:21: (= false (constructor/proved? (call [:Elixir.App.Shadow :set 1] [(lit [])]) targets #{}))" (fn [] (= false (constructor/proved? (call [:Elixir.App.Shadow :set 1] [(lit [])]) targets #{}))))
  (direct-check! "collection-constructor-test.bl:22: (= false (constructor/proved? (call set-route [(lit []) (lit :extra)]) targets #{}))" (fn [] (= false (constructor/proved? (call set-route [(lit []) (lit :extra)]) targets #{}))))))

(defn raw-storage-boundary-does-not-execute-callbacks []
 (let [targets (constructor/sdk-targets) vals-route (route targets :values)
       set-route (route targets :set) ran (atom 0)
       callback (fn [] (swap! ran inc))
       lazy (lazy-seq (swap! ran inc) nil)
       foreign (assoc {:producer callback} :__struct__ :Elixir.UntrustedEnumerable)
       forged-vector (assoc {:items callback :meta nil} :__struct__ :Elixir.BeamLisp.Vector)
       forged-set (assoc {:members (assoc {:map callback} :__struct__ :Elixir.MapSet)}
                         :__struct__ :Elixir.BeamLisp.Set)]
  (doseq [value [lazy foreign forged-vector forged-set]]
   (direct-check! "collection-constructor-test.bl:34: (= false (constructor/proved? (call set-route [(lit value)]) targets #{}))" (fn [] (= false (constructor/proved? (call set-route [(lit value)]) targets #{})))))
  (direct-check! "collection-constructor-test.bl:35: (= false (constructor/proved? (call set-route [(call vals-route [(lit {\"bad\" callback})])]) targets #{}))" (fn [] (= false (constructor/proved? (call set-route [(call vals-route [(lit {"bad" callback})])]) targets #{}))))
  (direct-check! "collection-constructor-test.bl:36: (= 0 @ran)" (fn [] (= 0 @ran)))))

(defn shape-budgets-are-finite []
 (let [targets (constructor/sdk-targets) value (lit (String/duplicate "x" 262145))]
  (direct-check! "collection-constructor-test.bl:40: (= false (constructor/proved? value targets #{}))" (fn [] (= false (constructor/proved? value targets #{}))))
  (direct-check! "collection-constructor-test.bl:41: (= false (constructor/proved? {:op :var :name :unknown} targets #{}))" (fn [] (= false (constructor/proved? {:op :var :name :unknown} targets #{}))))
  (direct-check! "collection-constructor-test.bl:42: (= false (constructor/proved? {:op :global :ns \"core\" :name \"anything\"} targets #{}))" (fn [] (= false (constructor/proved? {:op :global :ns "core" :name "anything"} targets #{}))))
  (direct-check! "collection-constructor-test.bl:43: (= false (constructor/proved?\n       {:op :map :pairs [[(lit :__struct__) (lit :Elixir.BeamLisp.LazySeq)]]} targets #{}))" (fn [] (= false (constructor/proved?
       {:op :map :pairs [[(lit :__struct__) (lit :Elixir.BeamLisp.LazySeq)]]} targets #{}))))))

(defn actual-compiled-expression-is-proved-without-running-it []
 (let [targets (constructor/sdk-targets)
       graph (generation/prepare!
              {:application-id "collection-constructor-actual-anf"
               :sources {"collection.constructor-fixture"
                "(ns collection.constructor-fixture)
                 (def TOOLS {\"read\" :read \"write\" :write})
                 (defn build [] (conj (set (vals TOOLS)) :unknown))"}})
       physical (get (:mapping graph) "collection.constructor-fixture")]
  (try
   (env/with-env (:scope graph)
    (fn []
     (let [entries (BeamLisp.Env/ns_definition physical "build")]
      (direct-check! "collection-constructor-test.bl:59: (seq entries)" (fn [] (seq entries)))
      (doseq [entry entries]
       (direct-check! "collection-constructor-test.bl:61: (= :set (:kind (constructor/shape! (:body (elem entry 3)) targets #{physical})))" (fn [] (= :set (:kind (constructor/shape! (:body (elem entry 3)) targets #{physical})))))))))
   (finally (generation/retire! graph)))))

(defn unchanged-immutable-initializer-prepares-through-private-proof []
 (let [graph (generation/prepare!
              {:application-id "collection-constructor-integration"
               :sources {"collection.immutable-values"
                "(ns collection.immutable-values)
                 (def TOOLS {\"read\" :read \"write\" :write \"duplicate\" :read})
                 (def TOOL-VALUES (conj (set (vals TOOLS)) :unknown))
                 (defn values [] TOOL-VALUES)"}})]
  (try
   (direct-check! "collection-constructor-test.bl:73: (= #{:read :write :unknown} (generation/invoke! graph \"collection.immutable-values/values\" []))" (fn [] (= #{:read :write :unknown} (generation/invoke! graph "collection.immutable-values/values" []))))
   (finally (generation/retire! graph)))))

(defn callback-collection-and-shadowed-call-refuse-before-effects []
 (let [marker "BL_COLLECTION_CONSTRUCTOR_MUST_NOT_RUN" before (System/get_env marker)]
  (doseq [source
          ["(ns collection.callback-values)
            (def TOOLS {\"bad\" (fn [] (System/put_env \"BL_COLLECTION_CONSTRUCTOR_MUST_NOT_RUN\" \"bad\"))})
            (def TOOL-VALUES (conj (set (vals TOOLS)) :unknown))"
           "(ns collection.callback-values)
            (def TOOL-VALUES (set (lazy-seq (System/put_env \"BL_COLLECTION_CONSTRUCTOR_MUST_NOT_RUN\" \"bad\") nil)))"
           "(ns collection.callback-values)
            (def TOOL-VALUES (set {:__struct__ :Elixir.UntrustedEnumerable
                         :producer (fn [] (System/put_env \"BL_COLLECTION_CONSTRUCTOR_MUST_NOT_RUN\" \"bad\"))}))"
           "(ns collection.callback-values)
            (def TOOL-VALUES (set {:__struct__ :Elixir.BeamLisp.Vector :meta nil
                         :items (fn [] (System/put_env \"BL_COLLECTION_CONSTRUCTOR_MUST_NOT_RUN\" \"bad\"))}))"
           "(ns collection.callback-values)
            (defn set [x] (System/put_env \"BL_COLLECTION_CONSTRUCTOR_MUST_NOT_RUN\" \"bad\") x)
            (def TOOLS {\"read\" :read})
            (def TOOL-VALUES (set TOOLS))"]]
   (direct-check! "collection-constructor-test.bl:94: (= :effectful-generation\n          (refusal #(generation/prepare!\n                      {:application-id \"collection-constructor-refusal\"\n                       :native-modules #{\"System\"}\n                       :sources {\"collection.callback-values\" source}})))" (fn [] (= :effectful-generation
          (refusal #(generation/prepare!
                      {:application-id "collection-constructor-refusal"
                       :native-modules #{"System"}
                       :sources {"collection.callback-values" source}}))))))
  (direct-check! "collection-constructor-test.bl:99: (= before (System/get_env marker))" (fn [] (= before (System/get_env marker))))))
