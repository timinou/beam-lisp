; Bounded runtime review: representation, fold retention, budget, and call counts.
; Run with bin/bl run in a systemd scope; no production source mutation.
(ns performance-runtime-probes)

(defn brief [] (select-keys (BeamLisp.LazyMemo/stats)
  [:live_cells :retained_bytes :op_new_fast :op_read :op_read_fast :op_cas
   :op_cas_fast :op_reroute :op_cursor :op_cursor_chunk_fast :op_id
   :op_dep_resource :cycle_enabled :cycle_runs]))
(defn measured [label f]
  (let [t (erlang/monotonic_time :microsecond) out (f)]
    (println label {:us (- (erlang/monotonic_time :microsecond) t) :result out}) out))

(let [tail (BeamLisp.LazySeq/new (fn [] nil))
      cons (BeamLisp.Ns.Rt/raw-cons 1 tail)]
  (println "IMPROPER-CONS" {:is-list (erlang/is_list cons)
                             :dependency-count (count (BeamLisp.LazyMemo/dependencies cons))}))

(doseq [n [1000 4000 16000]]
  (let [s (map inc (range n))]
    (Process/put :performance_review_hold s)
    (println "BEFORE COUNT" n (brief))
    (measured (str "FIRST COUNT " n) (fn [] (count s)))
    (println "AFTER FIRST" n (brief))
    (measured (str "SECOND COUNT " n) (fn [] (count s)))
    (println "AFTER SECOND" n (brief))
    (println "ACTUAL-MEMO-BYTES" n
      (BeamLisp.LazyMemo/estimate_bytes (BeamLisp.LazySeq/memo_state s)))
    (println "COMPLETED-LIST-BYTES" n
      (BeamLisp.LazyMemo/estimate_bytes (tuple :completed (lists/seq 1 n))))
    (Process/delete :performance_review_hold)))

(let [old (Application/get_env :beam_lisp :lazy_cache_budget_bytes 536870912)]
  (try
    (Application/put_env :beam_lisp :lazy_cache_budget_bytes 0)
    (println "ZERO-BUDGET-COUNT"
      (try (count (map inc (range 40))) (catch e (str e))))
    (println "ZERO-BUDGET-FORCE"
      (try (first (map inc (range 40))) (catch e (str e))))
    (finally (Application/put_env :beam_lisp :lazy_cache_budget_bytes old))))

(cprof/start)
(measured "PROFILE-LAZY-REDUCE-16000"
  (fn [] (reduce + 0 (take 16000 (map-indexed (fn [i x] (+ i x)) (range))))))
(cprof/pause)
(println "CALL-COUNTS"
  (into [] (map (fn [row]
                 [(erlang/element 1 row) (erlang/element 2 row)
                  (into [] (take 8 (erlang/element 3 row)))])
               (take 12 (erlang/element 2 (cprof/analyse))))))
(cprof/stop)
