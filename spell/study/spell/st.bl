; spell.st — the automatic connector between a beam-lisp atom and a
; Spacetime Live interface (PLAN-148 W6b, verse `docs/edn-spacetime/SPEC.md` §11).
;
; The point of this cluster is that ORDINARY `swap!` DRIVES THE BROWSER.
; No UI code at the mutation site, no manual push, no bespoke event plumbing:
;
;   (def state (atom {:messages [] :status "idle"}))
;   (st/connect! state {:messages '$messages :status '$status})
;   (swap! state assoc :status "thinking")   ; ← the browser updates
;
; That works because `connect!` installs an `add-watch` (added in W6a — atoms
; had deref/swap!/reset! but nothing could OBSERVE a change) which diffs the
; declared keys old→new and pushes ONLY what changed.
;
; ── Why the signal names are quoted symbols ─────────────────────────────────
;
; `$messages` is a Spacetime BINDING, and `$`-prefixed symbols read verbatim in
; both clojure-reader and beam-lisp's reader (measured: `Symbol("$messages")` /
; `{:symbol,"$messages"}`). They are quoted here because they name a binding in
; the Spacetime program, not a variable in this one.
;
; ── Why `@` means deref and never a directive ───────────────────────────────
;
; The EDN wire keys forms by MACRO NAME (`data-inline`), never by `@directive`.
; That is what frees `@` to mean exactly what a Lisp programmer expects, so
; `@state` derefs an atom in the same file that talks to Spacetime. Had the wire
; used `@data`, `@state` would have been ambiguous — measured before the design
; was fixed: `@data` reads as `(deref data)` here.

(ns spell.st)

;; ── the push seam ───────────────────────────────────────────────────────────
;;
;; Every outbound value goes through ONE function, so a test can tap it and a
;; transport change lands in a single place. The default records into a named
;; ring buffer (the wire-tap discipline from spell.store: "tests assert at the
;; wire", not on internals) and is replaced by the live MCP sender in a session.

(def ^:private pushes (atom []))

(defn push!
  "Send one signal update browser-ward. Returns the pushed pair."
  [signal value]
  (swap! pushes conj [signal value])
  [signal value])

(defn pushed
  "Every push so far — the wire tap. Tests assert HERE, not on internals."
  []
  @pushes)

(defn clear-pushes!
  "Reset the wire tap. Returns nil."
  []
  (reset! pushes [])
  nil)

;; ── the connector ───────────────────────────────────────────────────────────

(defn- changed-keys
  "The declared keys whose value differs between `old` and `new`.

  Only DECLARED keys are considered: an atom may hold plenty of state that no
  signal is bound to, and that state must not generate traffic."
  [bindings old new]
  (reduce (fn [acc k]
            (if (= (get old k) (get new k))
              acc
              (conj acc k)))
          []
          (keys bindings)))

(defn connect!
  "Bind atom keys to Spacetime signals: `(connect! state {:messages '$messages})`.

  Installs a watch that diffs the declared keys on every change and pushes only
  those that actually changed. Returns the atom, so it threads.

  A key whose value did not change produces NO push — an atom carrying twenty
  fields where one moved sends one update, not twenty. That is the whole reason
  the diff is here rather than at the call site."
  [ref bindings]
  (add-watch ref ::connect
             (fn [_k _r old new]
               (reduce (fn [_ k] (push! (get bindings k) (get new k)))
                       nil
                       (changed-keys bindings old new))))
  ref)

(defn disconnect!
  "Remove the connector's watch. Returns the atom."
  [ref]
  (remove-watch ref ::connect)
  ref)

;; ── inbound ─────────────────────────────────────────────────────────────────
;;
;; The mirror of `connect!`: a browser signal arrives and mutates the atom, which
;; (via the same watch) pushes whatever that mutation changed. The cycle closes
;; with no UI code anywhere in the handler.

(def ^:private handlers (atom {}))

(defn on
  "Register `f` for an inbound signal. `f` receives the payload."
  [signal f]
  (swap! handlers assoc signal f)
  signal)

(defn dispatch!
  "Deliver an inbound payload to its handler. Returns true when one ran."
  [signal payload]
  (if-let [f (get @handlers signal)]
    (do (f payload) true)
    false))
