; spell.ui — the VIEW cluster: UI as pure data.
;
; Cluster contract: construct, transform, and edit a *description* of
; the UI. The renderer is a dumb terminal for that description; nothing
; in this namespace knows a renderer exists. Everything here is a pure
; fn over data, so this file transliterates from spell.jank's ui.jank
; almost literally — the one place the port is a copy, and that is the
; point: the model was already right.
;
; What changed vs ui.jank, and why it is a strict improvement:
;   * text editing is by GRAPHEME, not by UTF-8 codepoint. jank's
;     u8_count/u8_sub counted codepoints and disclosed an off-by-one on
;     grapheme clusters (flag emoji, combining marks). Elixir's String
;     is grapheme-aware, so the disclosed tradeoff closes for free.
;   * realize derefs beam-lisp refs (atom/volatile/promise) instead of
;     testing jank's atom type by name string.

(ns spell.ui)

;; ── Element constructors ────────────────────────────────────────────
;; The clay API as literal data. A tree of these maps is the complete
;; input to any renderer — clayd, a terminal backend, a future Odin or
;; Zig process. The wire is the contract; constructors are sugar.

(defn el
  "A clay element. Nil children dropped. Props: :id :sizing :dir
   :padding :gap :bg :corner :border :scroll :stick :align :offset."
  [props & children]
  (let [kids (vec (filter some? (if (seq children) children (:children props))))]
    (if (seq kids)
      (assoc props :type :el :children kids)
      (dissoc (assoc props :type :el) :children))))

(defn text
  "A clay text node. Opts: :size :color :font (:sans|:mono) :spacing
   :caret :caret-color :caret-base."
  ([s] (text s {}))
  ([s opts] (merge {:type :text :text (str s) :size 16} opts)))

;; Named wire shapes.

(defn scroll-y ([] (scroll-y {})) ([opts] (merge {:scroll :vertical} opts)))
(defn scroll-x ([] (scroll-x {})) ([opts] (merge {:scroll :horizontal} opts)))
(defn follow-tail [] (scroll-y {:stick :bottom}))
(defn border ([color] (border 1 color)) ([width color] {:width width :color color}))

;; Sizing — [width-rule height-rule] pairs, as on the wire.

(def grow [:grow :grow])
(def fit  [:fit :fit])
(defn grow-w [h] [:grow h])
(defn fixed [w h] [{:fixed w} {:fixed h}])

;; Palette — floats 0..1 RGBA, as on the wire.

(def palette
  {:bg [0.10 0.10 0.12 1] :panel [0.16 0.16 0.20 1] :border [0.30 0.30 0.35 1]
   :text [0.90 0.90 0.95 1] :dim [0.55 0.55 0.60 1]
   :accent [0.25 0.45 0.95 1] :accent-down [0.18 0.33 0.72 1]
   :disabled [0.21 0.21 0.25 1] :selection [0.20 0.32 0.55 1]
   :green [0.60 0.90 0.60 1] :tool [0.95 0.75 0.35 1] :result [0.55 0.75 0.95 1]})

;; ── Realization ─────────────────────────────────────────────────────
;; A view fn may return thunks (defer work) or refs (defer reads).
;; realize forces both into pure EDN data, recursively. What crosses
;; the wire must already be realized — the renderer cannot call back.

(defn realize
  "Deref + force a (possibly deferred) UI tree into pure data."
  [node]
  (cond
    (fn? node)       (realize (node))
    (map? node)      (if (:children node)
                       (assoc node :children (vec (map realize (:children node))))
                       node)
    (vector? node)   (vec (map realize node))
    (ref-type? node) (realize (deref node))
    :else            node))

;; ── Text editing — grapheme-correct by construction ─────────────────
;; The editing layer operates on *grapheme indices* end to end: caret
;; positions, selection bounds, and string surgery share one unit, so
;; there is nothing to be off-by-one against. (ui.jank mixed codepoint
;; units with byte offsets and documented the seams.)

(defn graphemes [s] (String/graphemes (str s)))

(defn gcount [s] (count (graphemes s)))

(defn ginsert
  "s with t inserted before grapheme index i."
  [s i t]
  (let [gs (graphemes s)]
    (apply str (concat (take i gs) (graphemes t) (drop i gs)))))

(defn gdelete
  "s with graphemes [i, j) removed."
  [s i j]
  (let [gs (graphemes s)]
    (apply str (concat (take i gs) (drop j gs)))))

(defn gslice
  "The graphemes [i, j) of s, as a string."
  [s i j]
  (apply str (take (- j i) (drop i (graphemes s)))))

;; ── Error surface ───────────────────────────────────────────────────
;; A frame that reports a failed live swap *in the window*, not on
;; stdout. In spell.jank this existed because a broken render fn
;; otherwise fails silently. Here the same need is served — but the
;; caller is a server holding last-good state (see spell.app), not a
;; pair of defonce atoms.

(defn error-tree
  "Frame displaying a live-swap failure."
  [msg]
  {:type :el :id "render-error" :sizing grow :dir :top-to-bottom
   :padding 20 :gap 10 :bg (:bg palette)
   :children [{:type :text :text "live render failed - previous view kept"
               :size 18 :color [0.95 0.45 0.45 1]}
              {:type :text :text (str msg) :size 14 :font :mono
               :color [0.95 0.75 0.35 1]}]})
