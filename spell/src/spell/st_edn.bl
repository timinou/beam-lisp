; spell.st-edn — read and write the EDN⟷Spacetime wire, on the BEAM
; (verse PLAN-148 W6b; the format is normative in verse
; `docs/edn-spacetime/SPEC.md` §3–§4).
;
; ── There is exactly one codec, and it is not this file ─────────────────────
;
; verse owns the translation. Two implementations of a bijection DRIFT, and the
; drift is silent — you find it when a program compiles to different bytes on
; one side. So this module deliberately does NOT parse `%form` patterns, resolve
; macro names, or validate captures: it reads the wire as DATA and builds it as
; DATA, and every question about what a form MEANS is answered by verse.
;
; What lives here is the part that must live here: turning the wire into
; ordinary beam-lisp values that `map`/`filter`/`reduce` and the Specter optics
; in `priv/specter/` can transform. That is the whole reason to have EDN at all
; — an interface becomes a value you can compute with before it becomes pixels.
;
; ── The wire, in one line ───────────────────────────────────────────────────
;
;   (<macro-name> :<capture> <value> …)
;
; keyed by the registry's own macro name. Literals (`inline`, `from`, `:`, `;`)
; are NOT written — they live in the `%form` pattern and verse recovers them
; when printing. A document adds the sibling fields:
;
;   {:st/imports ["stdlib/__mcp__"]
;    :st/forms   [(data-inline :name $mcpPrompt :value [:st/expr "\"\""])]
;    :st/scopes  [{:selector ".kit-prompt" :decls {"text" "$mcpPrompt"}}]}
;
; ── Why these spellings and no others ───────────────────────────────────────
;
; Measured in BOTH readers (clojure-reader and this one) before the format was
; fixed:
;
;   $binding &element   read verbatim as symbols in both      → written bare
;   @directive          reads as (deref directive) HERE       → never used;
;                                                               forms are keyed
;                                                               by macro name,
;                                                               which is what
;                                                               frees `@` to
;                                                               mean deref
;   ~preset             reads as (unquote preset) HERE        → [:st/preset :k]
;   #st/time 500        NO tagged literals in this reader     → [:st/time 500]
;                       (reads as TWO forms)
;   Message[]           reads as Symbol + empty Vector, with
;                       NO error — silent corruption          → "Message[]"

(ns spell.st-edn)

;; ── reading ─────────────────────────────────────────────────────────────────
;;
;; The reader yields tagged pairs (`{:keyword "st/forms"}`, `{:vector [...]}`,
;; `{:list [...]}`), so these helpers unwrap them into plain values.

(defn- kw-name
  "The name of a keyword, or nil for anything else.

  Two representations reach here and both are legitimate: an EVALUATED keyword
  (`:name` in beam-lisp code, where `keyword?` is true) and a READER keyword
  (`{:keyword \"name\"}`, what the reader produces for unevaluated text).
  Handling only the reader shape made `form-captures` return an empty map for
  every quoted form — silently: no error, just nothing."
  [x]
  (cond
    (keyword? x) (name x)
    (and (vector? x) (= (first x) :keyword)) (second x)
    :else nil))

(defn form-macro
  "The macro name of a wire form: `(data-inline :name $x)` → \"data-inline\"."
  [form]
  (let [head (first form)]
    (if (and (vector? head) (= (first head) :symbol))
      (second head)
      (str head))))

(defn form-captures
  "The `:capture value` pairs of a wire form, as a map of name → value.

  Positional arguments are NOT expanded here: their meaning is the `%form`
  pattern's capture ORDER, which only verse knows. A form written positionally
  round-trips through verse; this reader reports its captures as empty rather
  than guessing an order and being silently wrong."
  [form]
  (loop [rest (drop 1 form)
         acc {}]
    (if (< (count rest) 2)
      acc
      (let [k (kw-name (first rest))
            v (second rest)]
        (recur (drop 2 rest)
               (if k (assoc acc k v) acc))))))

;; ── writing ─────────────────────────────────────────────────────────────────
;;
;; Emitting the wire is a pure string build: no registry, no validation. An
;; unknown macro name is verse's error to raise when it reads this back, and
;; raising it here too would be a second authority that can disagree.

(defn- join-with
  "Join `xs` with `sep`. This dialect has `interpose` but no `clojure.string/join`."
  [sep xs]
  (apply str (interpose sep xs)))

(defn- emit-value
  "One capture value as EDN text."
  [v]
  ;; `pr-str` is the READABLE printer, and it already recurses through
  ;; collections: it quotes strings and keeps a keyword's leading `:` at EVERY
  ;; depth. Hand-rolling the vector case with `str`/`map pr-str` dropped both —
  ;; emitting `[st/expr 0]` where the wire needs `[:st/expr "0"]`, which reads
  ;; back as a symbol and a number rather than a tagged expression. So: do not
  ;; reimplement the printer, use it.
  (pr-str v))

(defn emit-form
  "Build one wire form: `(macro-name :capture value …)`.

  `captures` is a map of capture-name → value. Order follows the map, which is
  fine for the WIRE (EDN maps are unordered and verse re-derives positional
  order from the pattern) but means output is not byte-stable across runs —
  compare parsed forms, not strings."
  [macro-name captures]
  (str "(" macro-name
       (reduce (fn [acc k]
                 (str acc " :" k " " (emit-value (get captures k))))
               ""
               (keys captures))
       ")"))

(defn emit-document
  "Build a document map from `:imports` / `:forms` / `:scopes`.

  `forms` are already-emitted strings (from `emit-form`), so a caller can build
  them however it likes — including by generating them with ordinary Lisp, which
  is the point of having EDN at all."
  [{:keys [imports forms]}]
  (str "{"
       (if (seq imports)
         ;; `map pr-str` over a collection loses the per-element quoting in this
         ;; dialect (measured), so print the vector as ONE value — same lesson
         ;; as `emit-value`: use the printer, do not reimplement it.
         (str ":st/imports " (pr-str (vec imports)) "\n ")
         "")
       ":st/forms [" (join-with "\n            " forms) "]}"))
