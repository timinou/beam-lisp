; spell/src/spell/seed.bl — the chat interface, as ONE term.
;
; The SEED: the definition the machine starts with. Everything the LLM adds
; later arrives the same way this does — as a contract and a view registered
; into `spell.machine` — so this file is an example of the machine's own
; vocabulary, not a privileged first citizen.
;
; This is the deliverable: a `defcontract` declaring the seam and a `defview`
; declaring the page, from which BOTH halves are emitted. The two cannot
; disagree, because there is one source.
;
; ── reading it ──────────────────────────────────────────────────────────────
;
; `@name` crosses the seam. It is one name resolved per runtime —
; `socket.assigns.name` on the BEAM, `$name` in Spacetime — and which is which
; is the framework's problem, never the author's.
;
; A binding NOT declared in the contract is page-local: `@draft` lives only in
; the browser and the server never hears about it. That is the definition of
; "shared", not a separate annotation to keep in sync.
;
; `(ok …)` / `(err …)` are the correlated one-shot reply, kept distinct from the
; broadcast assign diff that `set!` implies. They are also literals in a tree,
; which is what lets `reply-tags` enumerate them and verse reject a page missing
; an arm — the check FUP-143 records as impossible from Elixir.

(ns spell.seed
  (:require [spell.contract :refer [parse parse-view contract-json-with-replies
                                    edn-document view-document module-name]]))

;; ── the seam ────────────────────────────────────────────────────────────────

(def contract-term
  (parse :chat-live
         {:bundle "/spacetime/chat/spacetime.js" :root ".chat"}
         (list
           ;; Server-owned state. `messages` is the transcript; `status` tells
           ;; the page whether a turn is in flight so it can show the indicator
           ;; without inferring it from message counts.
           (quote (assign @messages :list))
           (quote (assign @status :atom))

           ;; The answer AS IT ARRIVES. Server-owned because the assembly is a
           ;; server concern: tokens are transient pushes, and the only place
           ;; that sees all of them in order is the process receiving them.
           ;;
           ;; Its absence was a real hole, and the file said so two lines from
           ;; here — "the finished text joins `@messages` when the turn ends" —
           ;; while no clause did that. Nothing executed a handler body until
           ;; `spell.server` existed, so the promise could sit next to the code
           ;; that failed to keep it.
           (quote (assign @partial :string))

           ;; The last failure, or "" when the last turn was fine. Server-owned
           ;; like every other assign: the page cannot know a provider returned
           ;; 401. It is a STRING rather than a flag because "HTTP 401" and
           ;; "transport: nxdomain" send a reader to completely different
           ;; places, and collapsing them to "something went wrong" throws away
           ;; the only part that shortens the debugging.
           (quote (assign @error :string))

           ;; NO `push` declarations.
           ;;
           ;; There were two — `@token` and `@failed` — and verse refused the
           ;; page over them for as long as they existed: `W0201: Data source
           ;; 'fx' is defined but never used`. Both rode the page's one effect
           ;; stream, and no bind consumed it, so every pushed token and every
           ;; pushed failure arrived in the browser and rendered nothing.
           ;;
           ;; The fix is not a subscriber, it is deleting the declaration: the
           ;; work each push was meant to do is now done by an ASSIGN that the
           ;; page actually renders. `@partial` accumulates the streaming answer
           ;; (`&streaming` shows it word by word) and `@error` carries a
           ;; failure's reason (`&error` shows it). An assign survives on the
           ;; page; a push is a transient the page must be listening for at the
           ;; instant it lands.
           ;;
           ;; This is the defect recorded in PLAN-025, closed by removal rather
           ;; than by exemption. If a future page wants per-token effects (a
           ;; sound, an animation) the push comes back WITH the bind that
           ;; consumes it — which is what verse was asking for all along.

           ;; The one intent the page fires. `text` is a PARAMETER, not a
           ;; page-local read: a review found the handler reading `@draft`,
           ;; which the server has no way to see — every message arrived empty
           ;; at the boundary. What the user typed must CROSS the seam.
           (quote (on :send [text]
                    (if (blank? text)
                      (err "Say something first")
                      (do (set! @messages (append @messages {:role "user" :text text}))
                          (set! @status :thinking)
                          ;; A new turn clears the last one's failure. Without
                          ;; this the notice outlives the problem and reports a
                          ;; 401 above a conversation that is working.
                          (set! @error "")
                          (ask! text)
                          (ok "accepted")))))

           ;; Provider outcomes arrive as ordinary BEAM messages, which is why
           ;; streaming needs no second transport.
           ;;
           ;; A token does TWO things: it is pushed to the page (so a streaming
           ;; view can show the answer arriving) and it is appended to
           ;; `@partial` (so the finished answer exists somewhere when the turn
           ;; ends). Pushing alone was the old behaviour, and it meant a
           ;; completed answer existed only as a sequence of transient effects
           ;; the transcript never saw.
           ;; A token appends to `@partial`, which is what the page renders.
           ;; Pushing it as an effect as well was the old behaviour and it
           ;; rendered nothing — see the note on the missing `push`
           ;; declarations above.
           (quote (on-info [:delta id chunk]
                    (set! @partial (str @partial chunk))))

           ;; The turn ENDS by joining the assembled answer to the transcript.
           ;; `@messages` is what the page renders, so this is the line that
           ;; makes a reply visible; clearing `@partial` afterwards keeps the
           ;; next turn from inheriting this one's text.
           (quote (on-info [:done id]
                    (do (set! @messages (append @messages {:role "model" :text @partial}))
                        (set! @partial "")
                        (set! @status :idle))))

           (quote (on-info [:failed id why]
                    (do (set! @status :idle)
                        (set! @partial "")
                        ;; The USER must learn the turn failed. A `push!` did
                        ;; not tell them: the page had no subscriber for the
                        ;; effect stream, so an auth failure, an exhausted quota
                        ;; and a dropped connection were all indistinguishable
                        ;; from nothing happening — the indicator simply
                        ;; stopped. Found while wiring GLM, whose most likely
                        ;; first-run outcome is exactly this (a 401 from a key
                        ;; pasted against the wrong one of Z.ai's two
                        ;; endpoints).
                        ;;
                        ;; An ASSIGN, because the message must survive on the
                        ;; page until the next turn replaces it.
                        (set! @error why)))))))

;; ── the page ────────────────────────────────────────────────────────────────

(def view-term
  (parse-view
    :chat-view
    (list
      ;; markup NESTS: a DOM is a tree.
      ;;
      ;; `&shell` is the page itself. A review found the earlier version
      ;; declaring only `bubble`/`thinking` while STYLING `.log`, `.composer`
      ;; and `.composer__send` — CSS does not create DOM, so the page had no
      ;; input, no button and no transcript container. Styling an element that
      ;; does not exist is the quietest possible failure.
      ;;
      ;; The composer is a `<div>`, NOT a `<form>`, and that is load-bearing.
      ;; As a form it looked right and behaved catastrophically: pressing Enter
      ;; in the input triggered the browser's IMPLICIT SUBMISSION — a native GET
      ;; to the same URL. The event fired and the server handled it correctly
      ;; (the log shows `HANDLE EVENT "send"`, replied in 17ms) and THEN the
      ;; page navigated: fresh document, fresh LiveView mount, assigns back to
      ;; their seeds. The user saw their message vanish into an empty page,
      ;; which reads as "send is broken" when send was the one part that worked.
      ;; The `?` the browser leaves on the URL is the fingerprint.
      ;;
      ;; `type='button'` on the button already prevented ITS half of this; what
      ;; it cannot prevent is the INPUT's implicit submission, which is a
      ;; property of being inside a form at all. There is no `action` and no
      ;; non-JS fallback to preserve — the seam IS the submission — so the form
      ;; element was pure liability. Enter is bound explicitly below instead.
      (quote
        (markup
          (template &shell []
            "<main class='chat'><div class='log' data-log></div><div class='composer'><input class='composer__input' placeholder='Say something…'><button class='composer__send' type='button'>Send</button></div></main>")

          (template &bubble [$m]
            "<article class='bubble' data-role={@m.role}><p class='bubble__text'>{@m.text}</p></article>")

          (template &thinking []
            "<div class='thinking'><span></span><span></span><span></span></div>")

          ;; The empty arm of the `@partial` dispatch is not needed — see the
          ;; bind below — because `&streaming` renders empty text as an empty
          ;; bubble, which the style plane hides.

          ;; The streaming bubble. A token arrives as a PUSH (`@token`), not an
          ;; assign: re-sending the whole transcript per word would send the
          ;; conversation once per token. So the partial answer accumulates
          ;; here, in its own element, and the finished text joins `@messages`
          ;; when the turn ends.
          ;;
          ;; Its absence was a real defect, found by a reviewer through the
          ;; verse rung: the contract pushed `@token`, the server sent tokens,
          ;; and NO bind consumed the stream — so every streamed token arrived
          ;; in the browser and rendered nothing. verse said so (W0201 on `$fx`)
          ;; and an over-broad exemption in the check was hiding it.
          ;; The streaming bubble renders `@partial` — the answer the server has
          ;; assembled so far. It takes no parameter: a `@view` arm mounts a
          ;; template with no arguments, and the text it shows is a subscribed
          ;; assign like any other.
          (template &streaming []
            "<article class='bubble bubble--streaming' data-role='model'><p class='bubble__text'>{$partial}</p></article>")

          ;; The failure notice. Deliberately NOT a bubble: a provider error is
          ;; not something the model said, and dressing it as a message in the
          ;; transcript would be a lie about who is speaking.
          (template &error []
            "<p class='notice notice--error' role='alert'>{$error}</p>")))

      ;; style is FLAT and keyed by selector: one rule may hit many templates.
      (quote
        (style
          [".chat" {:display "grid"
                    :grid-template-rows "1fr auto"
                    :height "100dvh"
                    :max-width "48rem"
                    :margin "0 auto"
                    :background "#0b0d14"
                    :color "#e8eaf2"
                    :font-family "Inter, ui-sans-serif, system-ui, sans-serif"}]
          [".log" {:overflow-y "auto"
                   :display "flex"
                   :flex-direction "column"
                   :gap "0.75rem"
                   :padding "1.5rem"}]
          [".bubble" {:padding "0.75rem 1rem"
                      :border-radius "1rem"
                      :max-width "80%"
                      :white-space "pre-wrap"
                      :line-height "1.5"}]
          [".bubble[data-role='user']" {:align-self "flex-end"
                                        :background "#2b4c8c"}]
          [".bubble[data-role='model']" {:align-self "flex-start"
                                         :background "#1b2030"}]
          [".composer" {:display "flex"
                        :gap "0.5rem"
                        :padding "1rem"
                        :border-top "1px solid rgba(255,255,255,0.08)"}]
          [".composer__input" {:flex "1"
                               :padding "0.75rem 1rem"
                               :border-radius "0.75rem"
                               :border "1px solid rgba(255,255,255,0.12)"
                               :background "#141824"
                               :color "#e8eaf2"}]
          [".composer__send" {:padding "0.75rem 1.25rem"
                              :border-radius "0.75rem"
                              :border "0"
                              :background "#3b6fd4"
                              :color "#fff"
                              :cursor "pointer"}]
          [".thinking" {:align-self "flex-start"
                        :display "flex"
                        :gap "0.25rem"
                        :padding "0.75rem 1rem"}]
          ;; The streaming bubble is a bubble that has not finished arriving:
          ;; same shape, dimmed, so the eye can tell a partial answer from a
          ;; complete one without reading it.
          ;; A streaming bubble with no text yet must not draw. `:empty` does
          ;; NOT do it: the arm stays mounted and the article always contains a
          ;; `<p>`, so the element is never childless — it rendered as a small
          ;; empty pill under the transcript between turns (seen in the first
          ;; screenshot of the working loop). Sizing it from its CONTENT is what
          ;; actually collapses it: no text, no box.
          [".bubble--streaming" {:opacity "0.75"
                                 :padding "0"
                                 :background "transparent"}]
          [".bubble--streaming .bubble__text:not(:empty)" {:padding "0.75rem 1rem"
                                                          :background "#141824"
                                                          :border-radius "1rem"}]

          ;; The failure notice, sized from its CONTENT for the same reason the
          ;; streaming bubble is: `@error` is "" between failures, so the
          ;; element is always present and must collapse to nothing when it has
          ;; no text. `:empty` alone would not do it here either — the notice
          ;; renders its own interpolation, so an empty error is an element
          ;; containing an empty string, not a childless one.
          ;;
          ;; The text is near-white, not the dusty pink the first draft used:
          ;; verse refused that at W201 (3.60:1, against a 4.5:1 minimum) and
          ;; was right to. It computes contrast against the OPAQUE background
          ;; colour, ignoring the 0.16 alpha — the worst case, and the honest
          ;; one to design against, since a failure notice is the last thing
          ;; that should be hard to read.
          [".notice" {:margin "0" :align-self "center"}]
          [".notice--error:not(:empty)" {:padding "0.6rem 0.9rem"
                                        :border-radius "0.75rem"
                                        :background "rgba(180,50,60,0.16)"
                                        :border "1px solid rgba(220,90,100,0.35)"
                                        :color "#ffe9ea"
                                        :font-size "0.85rem"}]))

      ;; binds is FLAT too: behaviour attaches BY SELECTOR, which is why
      ;; `.composer__send` appears here AND in `style`.
      (quote
        (binds
          ;; RENDER the subscribed transcript. Without this the page receives
          ;; assign diffs and discards them.
          [".log" (st/each @messages :as @m :template &bubble)]

          ;; carry what the user typed into a page-local signal…
          [".composer__input" (st/on :input (st/value @draft))]

          ;; …and send it. The draft crosses the seam as the event's argument.
          [".composer__send" (st/on :click (fire :send @draft))]

          ;; ENTER SENDS. Two ways to send, one action, because a chat box that
          ;; only responds to a mouse is broken for the way people actually
          ;; type.
          ;;
          ;; This is a real bind rather than a `<form>`'s free behaviour on
          ;; purpose. The composer WAS a form, and Enter's implicit submission
          ;; navigated the page: the send succeeded, then the document reloaded
          ;; and the LiveView remounted with seeded assigns, so the reply landed
          ;; in a process the browser had already abandoned.
          ;;
          ;; The key is a driver PARAM, not a `:Enter` qualifier. The qualifier
          ;; spelling reads better and does not work: verse's `driver_expr` has
          ;; no slot for it, so it was parsed and DISCARDED and the binding
          ;; fired on EVERY key — sending a message per character. Found here,
          ;; fixed upstream as verse BUG-375, which also added the param this
          ;; line uses.
          [".composer__input" (st/on :keydown (fire :send @draft) :key "Enter")]

          ;; RENDER the thinking indicator when the server says a turn is in
          ;; flight. `@status` was declared, `&thinking` was declared AND styled,
          ;; and nothing connected them — so the indicator was a template
          ;; preview, a state the running page could not reach. The machine
          ;; check reports exactly that pair (`unrendered-assign status` +
          ;; `dead-template thinking`), which is what sent me looking for the
          ;; affordance rather than hand-rolling a class toggle.
          ;;
          ;; `@view` (stdlib/enum/dispatch) is REACTIVE dispatch: it re-mounts
          ;; the matching arm on every signal change. `@match` is the same
          ;; grammar but mounts once, which would show the indicator forever.
          [".log" (st/view @status ["thinking" &thinking])]

          ;; RENDER the answer as it arrives, from `@partial` — the text the
          ;; server has assembled so far. A `_` arm matches any value, and
          ;; `@partial` is "" between turns, so the empty arm mounts nothing.
          ;;
          ;; NOT `(st/each @fx …)`, which is what stood here and rendered
          ;; NOTHING: `@data stream $fx` decodes to the LATEST decoded variant
          ;; — `{variant: "Token", value: {…}}` — not a list, so `@each` had no
          ;; collection to iterate. Observed in the browser once the server half
          ;; existed to push tokens at all: every token arrived, the page's own
          ;; stream consumer ran for each one, and no element appeared. verse
          ;; cannot catch that — a bind exists, a template exists, and only the
          ;; SHAPE disagrees, which is the one thing a static check of two
          ;; documents cannot compare.
          ;; ONE arm, `_`: the partial answer renders whenever there is one.
          ;;
          ;; An `""` arm was the first attempt — an explicit "nothing to show"
          ;; state — and verse refused the page: an empty literal pattern emits
          ;; as `{ => &blank; _ => &streaming; }`, and the dispatch grammar has
          ;; no production for a pattern with no tokens (E0946, twice). The rung
          ;; caught it before a browser ever loaded the bundle, which is the
          ;; whole reason emitting through the compiler beats hand-writing the
          ;; page.
          ;;
          ;; The empty case needs no arm anyway: `&streaming` renders
          ;; `{$partial}`, so between turns it renders an empty bubble — styled
          ;; away by `.bubble--streaming:empty`.
          [".log" (st/view @partial ["_" &streaming])]

          ;; RENDER the failure. Same shape as the `@partial` bind and for the
          ;; same reason: one `_` arm, and `@error` is "" between failures, so
          ;; the empty notice is hidden by the style plane rather than by a
          ;; second dispatch arm.
          [".log" (st/view @error ["_" &error])])))))

;; ── emission ────────────────────────────────────────────────────────────────

;; The module the page's `@host` names — and, since PLAN/FEAT-002, a module
;; that EXISTS: `spell.contract/elixir-module` generates it from this contract
;; and the app compiles it at boot. It was `SpacetimeLvWeb.ChatLive`, a module
;; in verse's demo Phoenix app that nobody had written (that app has
;; Counter/Board/Signup and no chat), so the page's every signal rejected with
;; "live bridge unavailable" — a seam pointing at a server that did not exist.
(def module "SpellWeb.ChatLive")

(defn server-contract
  "The sidecar verse reads: the contract plus the reply tags Elixir cannot
   enumerate."
  []
  (contract-json-with-replies contract-term module))

(defn page-document
  "The page's `@data` declarations \u2014 the seam, from the client side."
  []
  (edn-document contract-term "chat" ["stdlib/macros/data-kind" "stdlib/macros/handle"]))

(defn view-page
  "The page's three planes: markup, style, binds."
  []
  ;; `stdlib/enum/dispatch` supplies `@view`. An unimported macro is not a
  ;; silent no-op — the EDN reader refuses a form it cannot resolve — but it is
  ;; worth naming here: this import is what makes the status binding legal.
  (view-document view-term ["stdlib/macros/data-kind" "stdlib/enum/dispatch"]))
