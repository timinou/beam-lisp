; spell/src/spell/machine.bl — the machine as a subject it can reason about.
;
; `spell/src/spell/seam.bl` asks whether ONE contract agrees with ONE page supplied by the
; caller. This file removes the caller: contracts and views are REGISTERED, and
; the questions become set-differences over everything registered so far.
;
; ── why accumulation changes the questions ──────────────────────────────────
;
; With one contract and one hand-written page, "does the page fire an event the
; server handles?" needs the page's `:fires` list handed in. Nobody checks that
; the list matches the page. It is a checker fed by hand.
;
; Once views are registered as terms, `:fires` is DERIVED — walked out of the
; binds plane — and new questions appear that no single pair can ask:
;
;   * a view binds `@x`, no registered contract declares it   → orphan
;   * a contract declares `@x`, no registered view renders it → dead state
;   * a style rule names `.foo`, no markup renders `.foo`     → ghost selector
;   * a template is declared and never invoked                → dead markup
;
; ── the asymmetry is deliberate ─────────────────────────────────────────────
;
; Orphan binding is an ERROR: the page reads a name nobody publishes, so it is
; broken NOW. Dead state is a WARNING: a server may legitimately publish before
; a view consumes it, and a machine that refuses to hold that state cannot be
; built up one definition at a time — which is the entire point of growing it.
;
; ── what this file must NOT do ──────────────────────────────────────────────
;
; It must not decide, from our own template strings, which CSS classes exist.
; That is the emitter grading its own homework: a regex over the markup we
; generated agrees with the markup we generated by construction, and would have
; passed while the page had no `.log` at all. `rendered-classes` is here for the
; ONE case where verse cannot be consulted (a term never emitted); the
; authoritative check lives in `machine_check.exs`, which asks the COMPILER what
; it rendered, via `inspect --layer emit`. When they disagree, verse is right.

(ns spell.machine
  (:require [rewrite :refer [postwalk]]
            [spell.seam :refer [events assigns pushes handles?]]))

;; ── HTML class extraction (fallback only — see header) ──────────────────────

(defn- attr-values
  "Every value of attribute `attr` in `html`, as a list of strings.

   A hand-rolled scan rather than a regex because beam-lisp has no regex and,
   more importantly, because this is deliberately the WEAK path: the strong one
   asks verse what it compiled. Handles single and double quotes; anything else
   is simply not found, which is the safe direction for a fallback — it can miss
   a class, and missing one makes this check quieter, never wronger."
  [html attr]
  (let [needle (str attr "=")]
    (loop [s html acc []]
      (let [i (index-of s needle)]
        (if (nil? i)
          acc
          (let [rest-s (subs s (+ i (count needle)))
                q (if (> (count rest-s) 0) (subs rest-s 0 1) "")]
            (if (or (= q "'") (= q "\""))
              (let [body (subs rest-s 1)
                    j (index-of body q)]
                (if (nil? j)
                  acc
                  (recur (subs body (+ j 1)) (conj acc (subs body 0 j)))))
              (recur rest-s acc))))))))

(defn class-tokens
  "The whitespace-separated class tokens in `html`."
  [html]
  (vec (mapcat (fn [v] (filterv (fn [t] (not (= t ""))) (split v " ")))
          (attr-values html "class"))))

;; ── the registry ────────────────────────────────────────────────────────────
;; An atom, not a global def: registering is a mutation, and making it look like
;; one keeps `empty-machine`/`register` honest about being stateful.

(defn empty-machine
  "A machine with nothing in it. Contracts and views are keyed by name so a
   redefinition REPLACES rather than duplicates — the loop redefines constantly."
  []
  {:contracts {} :views {}})

(defn register-contract [m c]
  (assoc-in m [:contracts (get c :name)] c))

(defn register-view [m v]
  (assoc-in m [:views (get v :name)] v))

(defn contracts [m] (vals (get m :contracts {})))
(defn views [m] (vals (get m :views {})))

;; ── projections over the whole machine ──────────────────────────────────────

(defn all-assigns
  "Every assign name any registered contract declares."
  [m]
  (vec (sort (distinct (mapcat assigns (contracts m))))))

(defn all-events
  "Every event name any registered contract declares."
  [m]
  (vec (sort (distinct (mapcat events (contracts m))))))

(defn all-pushes
  [m]
  (vec (sort (distinct (mapcat pushes (contracts m))))))

;; ── reading a view's planes as data ─────────────────────────────────────────
;;
;; These walk the QUOTED forms the view term holds. A binding is `@name`, which
;; the reader gives us as a symbol whose name starts with "@"; a template ref is
;; `&name`. Both are syntax we chose precisely so they are greppable in a tree.

(defn- sym-name
  "The printable name of a symbol/keyword/string, or nil for anything else."
  [x]
  (cond
    (symbol? x) (name x)
    (keyword? x) (name x)
    (string? x) x
    :else nil))

(defn- starts-with-char?
  [s c]
  (and (string? s) (> (count s) 1) (= (subs s 0 1) c)))

(defn- collect
  "Every node in `form` for which `(f node)` returns non-nil, as a vector of
   those results. Uses the same descend-everything discipline as `reply-tags`:
   an unrecognised node is walked INTO, never skipped, because a missed name
   turns a check into a tautology that passes while the page is broken."
  [f form]
  (let [acc (atom [])]
    (postwalk (fn [node]
                (let [hit (f node)]
                  (when (not (nil? hit))
                    (swap! acc conj hit))
                  node))
              form)
    (distinct @acc)))

(defn view-bindings
  "Every `@name` the view references, in ANY plane. These are the names the page
   expects to read from the seam.

   ── the representation, because guessing it cost a silent empty result ──

   `@messages` is READER SYNTAX, not a symbol whose name starts with `@`. The
   reader expands it to `(deref messages)` before this code ever sees it — so a
   scan for `@`-prefixed symbols finds NOTHING and the check passes vacuously on
   a view full of bindings. Exactly the failure mode this project keeps meeting:
   a green check measuring a shape that does not exist.

   So match the expansion: a two-element form `(deref name)`."
  [v]
  (vec (sort
    (collect (fn [node]
               (if (and (seq? node)
                        (= (sym-name (first node)) "deref")
                        (= (count node) 2))
                 (sym-name (second node))
                 nil))
             [(get v :markup) (get v :binds)]))))

(defn view-template-refs
  "Every `&name` the view INVOKES (binds plane) — i.e. templates it renders."
  [v]
  (vec (sort
    (collect (fn [node]
               (let [s (sym-name node)]
                 (if (starts-with-char? s "&") (subs s 1) nil)))
             (get v :binds)))))

(defn view-templates
  "Every template the view DECLARES, by name, from the markup plane."
  [v]
  (vec (sort
    (collect (fn [node]
               (if (and (seq? node)
                        (= (sym-name (first node)) "template"))
                 (let [s (sym-name (second node))]
                   (if (starts-with-char? s "&") (subs s 1) s))
                 nil))
             (get v :markup)))))

(defn view-fires
  "Every event the view fires: `(fire :ev …)` in the binds plane.

   Anchored on the `fire` head rather than collecting every keyword, because a
   keyword appears in a dozen positions (`:input`, `:click`, `:as`) and treating
   all of them as events would report noise as breakage."
  [v]
  (vec (sort
    (collect (fn [node]
               (if (and (seq? node) (= (sym-name (first node)) "fire"))
                 (sym-name (second node))
                 nil))
             (get v :binds)))))

(defn view-selectors
  "Every selector the STYLE plane names."
  [v]
  (vec (sort (distinct (map (fn [rule] (get rule 0)) (get v :style []))))))

(defn view-bind-selectors
  "Every selector the BINDS plane attaches behaviour to."
  [v]
  (vec (sort (distinct (map (fn [b] (get b 0)) (get v :binds []))))))

(defn rendered-classes
  "Class tokens appearing in this view's template HTML.

   ── read the file header before trusting this ──
   It reads OUR strings, so it agrees with our emitter by construction. It is a
   fallback for terms that were never compiled. The authoritative ghost-selector
   check asks verse what it actually rendered."
  [v]
  (vec (sort
    (distinct
      (mapcat (fn [html] (class-tokens html))
              (collect (fn [node] (if (string? node) node nil))
                       (get v :markup)))))))

;; ── the machine-level checks ────────────────────────────────────────────────
;;
;; Every one is a set difference, and every one returns DATA naming what is
;; missing. A check that returns `false` sends the reader back to the source to
;; work out why; a check that returns `{:kind … :name …}` tells them.

(defn orphan-bindings
  "Bindings a view reads that NO registered contract declares.

   ERROR: the page is reading a name nobody publishes. Page-locals are exempt —
   they are declared by USE, and are exactly the names a contract must not have."
  [m locals]
  (let [declared (set (all-assigns m))
        local (set (or locals []))]
    (vec
      (mapcat (fn [v]
                (mapv (fn [b] {:kind :orphan-binding :view (get v :name) :binding b})
                      (filterv (fn [b] (and (not (contains? declared b))
                                            (not (contains? local b))))
                               (view-bindings v))))
              (views m)))))

(defn unrendered-assigns
  "Assigns declared by a contract that no registered view reads.

   WARNING, not error: a contract may legitimately land before its view. This is
   the check that tells you what is left to build."
  [m]
  (let [read (set (mapcat view-bindings (views m)))]
    (vec
      (mapv (fn [a] {:kind :unrendered-assign :assign a})
            (filterv (fn [a] (not (contains? read a))) (all-assigns m))))))

(defn unhandled-fires
  "Events a view fires that no contract routes to a handler. ERROR."
  [m]
  (vec
    (mapcat (fn [v]
              (mapv (fn [ev] {:kind :unhandled-fire :view (get v :name) :event ev})
                    (filterv (fn [ev]
                               (not (some (fn [c] (handles? c ev)) (contracts m))))
                             (view-fires v))))
            (views m))))

(defn dead-templates
  "Templates declared but never invoked. WARNING — a template may be staged for
   a binding that has not been written yet, which is a normal state for a
   machine being grown."
  [m]
  (vec
    (mapcat (fn [v]
              (let [invoked (set (view-template-refs v))]
                (mapv (fn [t] {:kind :dead-template :view (get v :name) :template t})
                      (filterv (fn [t] (not (contains? invoked t)))
                               (view-templates v)))))
            (views m))))

(defn unbound-assign-templates
  "An assign is declared and a template exists for it, but no bind connects them.

   This is the `@status`/`&thinking` shape: everything present, nothing wired.
   Reported as a WARNING naming both halves, because the fix is one bind and the
   reader should not have to find the pair themselves."
  [m]
  (let [bound (set (mapcat view-bindings (views m)))]
    (vec
      (mapcat (fn [v]
                (let [refs (set (view-template-refs v))]
                  (mapv (fn [t] {:kind :template-not-bound :view (get v :name) :template t})
                        (filterv (fn [t] (not (contains? refs t)))
                                 (view-templates v)))))
              (views m)))))

;; ── the roll-up ─────────────────────────────────────────────────────────────

(defn errors
  "Findings that mean the machine is BROKEN NOW."
  [m locals]
  (vec (concat (orphan-bindings m locals)
               (unhandled-fires m))))

(defn warnings
  "Findings that mean the machine is INCOMPLETE — expected while growing."
  [m]
  (vec (concat (unrendered-assigns m)
               (dead-templates m))))

(defn valid?
  "True when nothing is broken. Warnings do not block: a machine that refuses
   an incomplete definition cannot be grown one definition at a time."
  [m locals]
  (empty? (errors m locals)))

(defn report
  "Everything known about the machine, as data — for the tool result and for the
   chat bubble that shows the model why its proposal was refused."
  [m locals]
  {:contracts (vec (sort (map (fn [c] (name (get c :name))) (contracts m))))
   :views (vec (sort (map (fn [v] (name (get v :name))) (views m))))
   :assigns (all-assigns m)
   :events (all-events m)
   :pushes (all-pushes m)
   :errors (errors m locals)
   :warnings (warnings m)})
