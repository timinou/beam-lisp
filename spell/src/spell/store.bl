; spell.store — the STORE cluster: state that survives code reload.
;
; Cluster contract: a named cell that (a) outlives replacement of the
; module that created it, (b) is inspectable from outside (:observer,
; :sys), (c) is created once no matter how many times the creating code
; re-runs.
;
; spell.jank used `defonce` atoms for this (app, convo, known-good,
; registry, …). defonce is the wrong primitive to port: it survives
; reload but not a crash, and it is invisible to the platform. A named
; Agent survives BOTH — verified: an Agent named :live_state kept
; {:count 7} and its pid across a full re-eval of the module that
; started it. State keyed by NAME, not by var identity, is what
; "the code changed, the state stayed" means on the BEAM.
;
; The wire-tap discipline from spell.jank (frame-log, clipboard-writes
; — "tests assert at the wire") maps here too: a tap is just a named
; ring buffer, readable without disturbing the app.

(ns spell.store)

(def tap-max
  "Default ring size for taps (frame-log was 20 in spell.jank)."
  20)

(defn- name-opt [name]
  ; Agent.start_link/2 wants a keyword list [{:name, name}] — a list of
  ; tuples. beam-lisp has no tuple literal yet (see PLAN-017 blocker 3),
  ; so build it through erlang primitives: (list a b) is an Erlang list,
  ; list_to_tuple makes the tuple, the outer list wraps it.
  (list (erlang/list_to_tuple (list :name name))))

(defn state-ensure
  "Start a named cell holding init, or return the live one.
   Idempotent by construction — this is the honest defonce:
   re-running the code that creates state finds the state already there.
   Returns {:ok name} (name doubles as the address for get/swap)."
  [name init]
  (let [r (Agent/start_link (fn [] init) (name-opt name))]
    (if (= :ok (erlang/element 1 r))
      {:ok name}
      ; {:error, {:already_started, pid}} — the state outlived the code.
      {:ok name})))

(defn state-get [name]
  (Agent/get name (fn [s] s)))

(defn state-swap!
  "(state-swap! :convo (fn [s] (conj s entry))) — named, reload-proof."
  [name f]
  (Agent/update name f))

(defn tap!
  "Append to a named ring buffer of at most tap-max entries.
   The wire-tap: frame-log/clipboard-writes as one mechanism."
  ([name v] (tap! name v tap-max))
  ([name v max-n]
   (state-ensure name [])
   (state-swap! name (fn [s]
                       (let [s* (conj s v)]
                         (if (> (count s*) max-n)
                           (vec (drop (- (count s*) max-n) s*))
                           s*))))))

(defn tap-contains?
  "Did any tapped value contain needle when printed? The assertion
   surface of spell.jank's frames-contain? — tests read the wire, not
   the app's internals."
  [name needle]
  (boolean (some (fn [v] (String/contains? (pr-str v) needle))
                 (state-get name))))
