; spell/src/spell/provider.bl — the AGENT cluster: the LLM call, bounded.
;
; One provider is a map of {:base-url :model :key}, so switching models is DATA,
; not a code path. The call itself is deliberately small: build a request, send
; it, decode the reply. Everything that can hang or crash is somebody else's
; problem — specifically `spell.fence`'s, which runs the call in an unlinked,
; monitored process with a deadline.
;
; ── why the call is not made here directly ───────────────────────────────────
;
; A provider is the least trustworthy thing in the system: it is a network call
; to a machine we do not control, with no upper bound on how long it can take to
; not answer. Calling it inline means a slow provider wedges the LiveView that
; called it. `fence` makes the failure local: the callee owns its heap, a
; timeout kills it outright, and the caller gets `{:timeout ms}` like any other
; value.
;
; ── streaming ────────────────────────────────────────────────────────────────
;
; The chat UI wants tokens as they arrive, not one block at the end. The
; provider therefore has two entry points with the same shape:
;
;   ask     — one request, one reply. Used for tests and for the fallback path.
;   stream  — one request, many `[:delta id chunk]` messages to a target pid,
;             then `[:done id]` or `[:failed id reason]`.
;
; Both are ordinary sends, which is why the LiveView needs no special mechanism:
; a streamed token arrives as a message like anything else on the BEAM.

(ns spell.provider)

;; ── configuration ───────────────────────────────────────────────────────────

(defn providers
  "Every provider, as DATA. The key is what `PROVIDER` selects.

   This was an if/else chain until GLM became the third entry, at which point
   the file's own opening claim — that switching models is data, not a code
   path — stopped being true. A table keeps `select` trivial and makes the
   fourth provider an edit to one map rather than another branch.

   Each entry is read lazily through `System/get_env` at selection time, so a
   key exported after boot still works."
  []
  {"kimi"
   ;; Kimi's base path is `/coding/v1`, NOT `/v1` — `api.kimi.com/v1/*` returns
   ;; an nginx 404 while `/coding/v1/models` returns 200, and Moonshot's
   ;; endpoints reject the same key with 401. Verified 2026-08-13.
   ;;
   ;; NB kimi is a REASONING model: completion tokens go to `reasoning_content`
   ;; BEFORE any `content`. A small `max_tokens` returns finish_reason=length
   ;; with an EMPTY content string, which reads as a broken provider when it is
   ;; only a small budget. Hence the generous default.
   {:base-url (or (System/get_env "KIMI_BASE_URL") "https://api.kimi.com/coding/v1")
    :model (or (System/get_env "KIMI_MODEL") "k3-256k")
    :key (System/get_env "KIMI_API_KEY")
    :max-tokens 1024}

   "deepseek"
   {:base-url (or (System/get_env "DEEPSEEK_BASE_URL") "https://api.deepseek.com")
    :model (or (System/get_env "DEEPSEEK_MODEL") "deepseek-chat")
    :key (System/get_env "DEEPSEEK_API_KEY")
    :max-tokens 1024}

   "glm"
   ;; Z.ai (Zhipu). OpenAI-compatible, so it needs no code beyond this entry —
   ;; same `/chat/completions`, same SSE deltas, same `tool_calls` shape.
   ;;
   ;; The base URL carries the SAME trap kimi does, and it is worth stating
   ;; twice because it costs an afternoon each time: there are two endpoints and
   ;; they are NOT interchangeable. A Coding Plan key works ONLY against
   ;; `/api/coding/paas/v4`; a general pay-as-you-go key works ONLY against
   ;; `/api/paas/v4`. Using the wrong one with a valid key answers 401/404,
   ;; which reads as a bad key and sends you to regenerate a key that was fine.
   ;;
   ;; The default is the CODING endpoint because glm-5.3 is a coding-plan model;
   ;; a general-API user overrides both variables together:
   ;;   GLM_BASE_URL=https://api.z.ai/api/paas/v4  GLM_MODEL=glm-5.2
   {:base-url (or (System/get_env "GLM_BASE_URL") "https://api.z.ai/api/coding/paas/v4")
    :model (or (System/get_env "GLM_MODEL") "glm-5.3")
    ;; ZAI_API_KEY is the name Z.ai's own docs and most tools use; GLM_API_KEY
    ;; is accepted too so the variable matches the PROVIDER value that selects
    ;; it. Neither is more correct — accepting both costs one `or`.
    :key (or (System/get_env "GLM_API_KEY") (System/get_env "ZAI_API_KEY"))
    :max-tokens 1024}})

(defn from-env
  "The provider config selected by `PROVIDER`, defaulting to kimi.

   More than one provider is configured because one of them WILL be
   unavailable: a quota wall answers with HTTP 403 and an
   `access_terminated_error` body, which surfaces here as
   `[:failed id \"HTTP 403\"]` and looks exactly like a broken integration.
   Switching with one variable is what turns that from a debugging session into
   a re-run — observed 2026-08-15, when kimi's cycle quota ran out mid-verification
   and deepseek answered `Insufficient Balance` an hour later.

   An UNKNOWN `PROVIDER` falls back to kimi rather than raising. Reviewed and
   kept deliberately: `PROVIDER=fake` is handled in `stream-async`, not here,
   so a name this table does not know is not necessarily a mistake."
  []
  (let [name (System/get_env "PROVIDER")
        table (providers)]
    (or (get table name) (get table "kimi"))))

(defn configured?
  "Is there a key to call with? Checked explicitly so a missing credential is a
   clear message rather than a 401 from the far side."
  [cfg]
  (let [k (get cfg :key)]
    (and (not (nil? k)) (not (= "" k)))))

;; ── request ─────────────────────────────────────────────────────────────────

(defn json-escape
  "A string as JSON-escaped text.

   Public because `spell.cassette` needs the same escaping to render a recorded
   body, and two implementations of one escape table drift silently — the
   drift only shows up as a body that decodes wrong."
  [s]
  (-> (str s)
      (replace-str "\\" "\\\\")
      (replace-str "\"" "\\\"")
      (replace-str "\n" "\\n")
      (replace-str "\r" "\\r")
      (replace-str "\t" "\\t")))

(defn- message-json [m]
  ;; Three message shapes cross this boundary and they are NOT symmetric:
  ;;
  ;;   user/assistant  role + content
  ;;   assistant w/ tool_calls  content "" + the calls it made
  ;;   tool            role "tool" + tool_call_id + the result as content
  ;;
  ;; The assistant's own tool_calls must be echoed back on the next request or
  ;; the provider rejects the following `tool` message as unsolicited — it has
  ;; no other way to correlate a result with the call that asked for it.
  (let [role (get m :role)
        content (json-str-value (get m :content ""))
        calls (get m :tool-calls [])
        call-id (get m :tool-call-id)]
    (str "{\"role\":\"" role "\""
         ",\"content\":" content
         (if (nil? call-id) "" (str ",\"tool_call_id\":\"" (json-escape call-id) "\""))
         (if (empty? calls)
           ""
           (str ",\"tool_calls\":["
                (join "," (map tool-call-json calls))
                "]"))
         "}")))

(defn- json-str-value
  "A string as a quoted, escaped JSON value."
  [s]
  (str "\"" (json-escape s) "\""))

(defn- tool-call-json
  "One assistant tool call, echoed back in the shape the provider sent it."
  [c]
  (str "{\"id\":\"" (json-escape (get c :id "")) "\""
       ",\"type\":\"function\""
       ",\"function\":{\"name\":\"" (json-escape (get c :name "")) "\""
       ",\"arguments\":" (json-str-value (get c :arguments "{}")) "}}"))

(defn- tool-decl-json
  "One tool DECLARATION, as the chat-completions API wants it.

   `parameters` is a pre-built JSON-schema STRING and is embedded raw. Quoting
   it as a string value is the mistake worth naming: the provider answers 400,
   which in this codebase's failure history reads as an auth or endpoint
   problem and sends you looking in the wrong place entirely."
  [t]
  (str "{\"type\":\"function\",\"function\":{"
       "\"name\":\"" (json-escape (get t :name)) "\""
       ",\"description\":" (json-str-value (get t :description ""))
       ",\"parameters\":" (get t :parameters "{\"type\":\"object\"}")
       "}}"))

(defn request-body
  "The chat-completions payload. `messages` is a vector of
   {:role \"user\"|\"assistant\"|\"tool\" :content \"…\"}, optionally carrying
   `:tool-calls` (assistant) or `:tool-call-id` (tool).

   `cfg`'s `:tools` — when present and non-empty — declares the functions the
   model may call. An EMPTY `tools` array is deliberately not the same as no
   key: some providers reject `\"tools\":[]`, and an offered-but-empty tool list
   is a claim we do not mean to make."
  [cfg messages stream?]
  (let [tools (get cfg :tools [])]
    (str "{\"model\":\"" (get cfg :model) "\""
         ",\"messages\":[" (join "," (map message-json messages)) "]"
         (if (empty? tools)
           ""
           (str ",\"tools\":[" (join "," (map tool-decl-json tools)) "]"))
         ",\"max_tokens\":" (get cfg :max-tokens 1024)
         ",\"stream\":" (if stream? "true" "false")
         "}")))

;; ── the call ────────────────────────────────────────────────────────────────

(defn- headers
  "httpc wants a LIST OF TUPLES of charlists. A list of vectors type-checks in
   beam-lisp and then dies inside `:httpc.header_parse/1`, which is a confusing
   place to learn about a shape mismatch."
  [cfg]
  (list (tuple (String/to_charlist "authorization")
               (String/to_charlist (str "Bearer " (get cfg :key))))))

;; ── the transport seam ──────────────────────────────────────────────────
;;
;; Every request in this file went through the same eight lines — url, headers,
;; body, opts, `httpc/request`, then a `cond` on the response tuple — written
;; out three times (`ask`, `ask-turn`, `stream`). Three copies of one seam is
;; three places to change when a provider needs a header, and three places for
;; them to disagree.
;;
;; It is now ONE function, and the thing it does is chosen by DATA:
;;
;;   :httpc            a real request        (the default)
;;   {:cassette name}  replay a recording    (tests, CI, offline work)
;;   :fake             a canned answer       (no recording needed)
;;
;; ── why a cfg key and not an env var ──────────────────────────────────────
;;
;; `PROVIDER=fake` was read deep inside `stream-async`, which made the choice
;; invisible at the call site and impossible to vary per request: a test could
;; not replay a tool-call turn and a content turn in the same run, and a script
;; that wanted one fake turn had to mutate the global environment. Worse, the
;; branch meant the fake path and the real path were DIFFERENT CODE — so a bug
;; in request building was exactly the kind of bug the offline path could not
;; catch.
;;
;; As a cfg key the same code runs either way: the request is built, and only
;; the last step — "send these bytes and give me back a response" — differs.

(defn transport
  "The transport `cfg` selects. `:httpc` unless it says otherwise.

   `PROVIDER=fake` is still honoured, because scripts and muscle memory use it
   and it means exactly `{:transport :fake}`."
  [cfg]
  (let [t (get cfg :transport)]
    (cond
      (not (nil? t)) t
      (= "fake" (System/get_env "PROVIDER")) :fake
      :else :httpc)))

(defn- httpc-send
  "POST `body` to the provider's completions endpoint; the raw response tuple."
  [cfg body]
  (let [url (String/to_charlist (str (get cfg :base-url) "/chat/completions"))
        req (tuple url
                   (headers cfg)
                   (String/to_charlist "application/json")
                   body)
        ;; 120s: a real answer from a reasoning model can take a minute. The
        ;; OUTER deadline is `fence`'s, and it is deliberately shorter — see
        ;; `ask`.
        opts (list (tuple :timeout 120000))]
    ;; `httpc/request`, NOT `:httpc/request`: the leading colon makes the reader
    ;; see a keyword, and the call then resolves as a map lookup.
    (httpc/request :post req opts (list))))

(defn- response-status
  "[status body] from an httpc response tuple, or nil when it is not one."
  [resp]
  (if (and (tuple? resp) (= :ok (elem resp 0)))
    (let [r (elem resp 1)]
      [(elem (elem r 0) 1) (to-string (elem r 2))])
    nil))

(defn send-request
  "Perform one completion request through `cfg`'s transport.

   Answers `{:status 200 :body \"…\"}` or `{:error reason}` — one shape, whatever
   the transport, so every decoder above works against a recording exactly as it
   does against a provider. That equivalence is the whole point: a test that
   replays a cassette is exercising the SAME code a live turn runs, minus the
   socket."
  [cfg messages stream?]
  (let [body (request-body cfg messages stream?)]
    (cond
      (map? (transport cfg))
      (spell.cassette/replay (get (transport cfg) :cassette) body stream?)

      (= :fake (transport cfg))
      ;; The canned answer, in the provider's own JSON/SSE shape. Not a
      ;; separate code path: the same decoders run over it, which is the point
      ;; — `stream-fake` used to imitate the message protocol without ever
      ;; building a request or parsing a frame, so every bug in those was
      ;; invisible to the offline path that existed to catch bugs.
      {:status 200 :body (spell.cassette/canned messages stream?)}

      :else
      (let [resp (httpc-send cfg body)
            hit (response-status resp)]
        (if (nil? hit)
          {:error {:transport (pr-str resp)}}
          {:status (get hit 0) :body (get hit 1)})))))

(defn ask
  "One request, one reply. Returns {:ok text} | {:error reason}.

   Call this THROUGH `fence`: it performs a network request with no bound of its
   own beyond httpc's timeout, and a provider that accepts a connection then
   stalls is the failure this system must survive.

   NB the two deadlines are deliberately different. httpc's is 120s — a real
   answer from a reasoning model can take a minute — while `fence`'s DEFAULT is
   5s. The outer one wins: fence kills the child and returns `{:timeout 5000}`,
   so a caller wanting the full budget must pass it (`(fence ask args 120000)`),
   which the chat flow does. Reviewed and kept: the tight default is right for
   a caller who has not thought about it."
  [cfg messages]
  (decode-response (send-request cfg messages false)))

(defn- decode-response
  "One `send-request` answer as {:ok text} | {:error reason}."
  [r]
  (cond
    (not (nil? (get r :error)))
    {:error (get r :error)}

    (= 200 (get r :status))
    ;; A 200 whose body carries no assistant content is a FAILURE, not an empty
    ;; success: `{:ok nil}` reads as "the model said nothing", and the caller
    ;; renders a blank bubble instead of reporting the problem.
    (let [body (get r :body)
          text (extract-content body)]
      (if (nil? text)
        {:error {:undecodable body}}
        {:ok text}))

    :else
    {:error {:status (get r :status) :body (get r :body)}}))

(defn- to-string
  "An httpc body as a proper UTF-8 string.

   `erlang/list_to_binary`, NOT `List/to_string`: httpc hands back a charlist of
   BYTES, and `List.to_string` treats each byte as a CODEPOINT — so every
   multi-byte character is re-encoded twice. An em-dash came back as `â` in a
   live reply, which reads as a provider or font problem rather than a decoding
   one. `list_to_binary` concatenates the bytes as-is, which is what they
   already are."
  [charlist]
  (if (string? charlist)
    charlist
    (erlang/list_to_binary charlist)))

(defn extract-content
  "The assistant text from a chat-completions response, or nil.

   Deliberately a targeted scan rather than a JSON parse: the only field needed
   is the assistant's `content`, and a full parser is a dependency plus a
   surface for a malformed-response crash.

   But `content` is not a unique key. A review found this returning
   `\"upstream detail\"` for

     {\"error\":{\"content\":\"upstream detail\"},\"choices\":[{\"message\":{\"content\":\"answer\"}}]}

   — the FIRST match anywhere, which is the error's text presented to the user as
   the model's reply. So the scan is anchored: it looks for `content` inside the
   `message` object of `choices`, and returns nil when that anchor is absent
   rather than settling for any `content` in the document."
  [json]
  (let [anchor (index-of json "\"choices\"")]
    (if (nil? anchor)
      nil
      (let [tail (subs json anchor)
            marker "\"content\":\""
            i (index-of tail marker)]
        (if (nil? i)
          nil
          (take-until-unescaped-quote (subs tail (+ i (count marker)))))))))

(defn take-until-unescaped-quote
  "The run up to the first UNESCAPED quote, unescaped; nil when the string never
   terminates.

   Public for `spell.cassette`, which reads a recorded body back out of a file
   written in exactly this shape. Reimplementing the scan there would be a
   second answer to \"where does this string end\", and the two would disagree
   on precisely the inputs that motivated it: escaped quotes.

   nil rather than the partial run: a truncated body (a dropped connection
   mid-answer) otherwise renders as a COMPLETE short answer, and neither the
   caller nor the user can tell. A naive split on the next quote is also wrong —
   prose contains quotation marks constantly — hence the walk."
  [s]
  (loop [i 0
         out ""]
    (cond
      (>= i (count s)) nil
      :else
      (let [c (subs s i (+ i 1))]
        (cond
          ;; an escape consumes the NEXT character whatever it is, so a
          ;; `\\\"` inside the string does not terminate it
          (= c "\\") (recur (+ i 2) (str out (unescape-pair (subs s (+ i 1) (+ i 2)))))
          (= c "\"") out
          :else (recur (+ i 1) (str out c)))))))

(defn- unescape-pair
  "The character an escape sequence denotes.

   Decoded HERE, one escape at a time, rather than by rewriting the finished
   string. Sequential `replace-str` passes decode their own output: a literal
   backslash-n (written `\\\\n` in JSON) had its second backslash paired with the
   `n` and became a NEWLINE, silently corrupting any text containing a Windows
   path or a regex."
  [c]
  (cond
    (= c "n") "\n"
    (= c "r") "\r"
    (= c "t") "\t"
    (= c "b") "\b"
    (= c "f") "\f"
    (= c "\"") "\""
    (= c "\\") "\\"
    (= c "/") "/"
    :else c))

; `unescape-json` is gone: sequential replace-str passes decode their own
; output, so a literal backslash-n became a newline. `take-until-unescaped-quote`
; now decodes escape-by-escape as it walks, which cannot double-decode.

;; ── decoding a turn ─────────────────────────────────────────────────────────
;;
;; `extract-content` answers one question — "what did the model SAY?" — and a
;; tool-calling loop needs a second: "what did it want to DO?". On a tool turn
;; Kimi sends `content: ""` and puts the request in `tool_calls`, so a caller
;; using only extract-content sees an empty answer, renders a blank bubble, and
;; never learns a tool was requested. Nothing raises; the machine simply never
;; grows. (Shape captured from a live k3-256k probe — PLAN-023.)
;;
;; extract-turn is therefore the decoder the LOOP uses, and it always returns
;; one of three kinds:
;;
;;   {:kind :content     :content "…"  :tool-calls []}
;;   {:kind :tool-calls  :content ""   :tool-calls [{:id :name :arguments}…]}
;;   {:kind :error       :reason …}
;;
;; `:error` covers the case a 200 can still be a failure: no content AND no
;; tool call. Returning `{:kind :content :content ""}` there would render as
;; the model choosing to say nothing.

(defn- find-after
  "Index of `needle` in `s` at or after `from`, or nil."
  [s needle from]
  (if (>= from (count s))
    nil
    (let [i (index-of (subs s from) needle)]
      (if (nil? i) nil (+ from i)))))

(defn- json-string-after
  "The decoded JSON string value that follows `key` at or after `from`, plus the
   index just past it: [value end] — or nil when the key is absent.

   Returns the END index as well as the value because the tool-call scan walks
   FORWARD through an array: without it, each field lookup would restart from
   the top of the document and the second call's `name` would find the first
   call's."
  [s key from]
  (let [marker (str "\"" key "\":\"")
        i (find-after s marker from)]
    (if (nil? i)
      nil
      (let [start (+ i (count marker))
            v (take-until-unescaped-quote (subs s start))]
        (if (nil? v)
          nil
          ;; The decoded value can be SHORTER than its source (escapes are two
          ;; source characters, one decoded), so the end index is computed by
          ;; re-scanning the raw text rather than by adding the value's length.
          [v (+ start (raw-string-length (subs s start)))])))))

(defn- raw-string-length
  "How many characters of `s` the JSON string starting at index 0 occupies, up
   to but excluding its closing quote."
  [s]
  (loop [i 0]
    (cond
      (>= i (count s)) i
      :else
      (let [c (subs s i (+ i 1))]
        (cond
          (= c "\\") (recur (+ i 2))
          (= c "\"") i
          :else (recur (+ i 1)))))))

(defn tool-calls
  "Every tool call in a chat-completions body, in order, as
   [{:id … :name … :arguments …}]. Empty when the turn requested none.

   `arguments` is returned DECODED (the provider sends it as a JSON string, so
   its quotes arrive escaped) but NOT parsed: parsing belongs to whoever knows
   the tool's schema. Decoding here rather than at each call site keeps one
   unescaping implementation instead of one per tool.

   Anchored inside `choices` for the same reason `extract-content` is: an
   `error` object is free to contain anything, and a document-wide scan would
   happily read a tool call out of it."
  [json]
  (let [anchor (index-of json "\"choices\"")]
    (if (nil? anchor)
      []
      (loop [pos anchor
             acc []]
        (let [i (find-after json "\"function\"" pos)]
          (if (nil? i)
            acc
            ;; `id` belongs to the CALL object, which precedes `function` — so
            ;; it is searched from the previous position, not from `function`.
            (let [id-hit (json-string-after json "id" pos)
                  name-hit (json-string-after json "name" i)
                  args-hit (json-string-after json "arguments" i)]
              (if (or (nil? name-hit) (nil? args-hit))
                acc
                (recur (get args-hit 1)
                       (conj acc {:id (if (nil? id-hit) "" (get id-hit 0))
                                  :name (get name-hit 0)
                                  :arguments (get args-hit 0)}))))))))))

(defn extract-turn
  "Decode one chat-completions response into what the loop must do next.

   See the block comment above for the three kinds. This is additive:
   `extract-content` keeps its contract and its callers."
  [json]
  (let [calls (tool-calls json)]
    (cond
      (not (empty? calls))
      {:kind :tool-calls :content "" :tool-calls calls}

      :else
      (let [text (extract-content json)]
        (cond
          ;; nil  — no `choices` anchor at all, or an unterminated string
          ;; ""   — an assistant message with genuinely nothing in it
          ;; Both mean the same thing to a caller: this turn carried no answer
          ;; and no work. Distinguishing them would invite a caller to render
          ;; one of them.
          (nil? text) {:kind :error :reason {:undecodable json}}
          (= "" text) {:kind :error :reason {:empty-turn json}}
          :else {:kind :content :content text :tool-calls []})))))

(defn ask-turn
  "One request, one DECODED turn: {:kind :content|:tool-calls|:error …}.

   The tool-aware sibling of `ask`. Same request, same deadline discipline —
   the difference is that the reply is read with `extract-turn`, so a turn that
   requests a tool arrives as work to do rather than as an empty answer.

   `ask` is kept, unchanged, for the callers that genuinely only want text
   (the non-tool path, the tests, the fallback). Two entry points rather than
   a flag because the RESULT SHAPES differ: a caller of `ask` handles
   {:ok text}, a caller of this handles three kinds, and collapsing them would
   push a cond into every call site."
  [cfg messages]
  (let [r (send-request cfg messages false)]
    (cond
      (not (nil? (get r :error)))
      {:kind :error :reason (get r :error)}

      (= 200 (get r :status))
      (extract-turn (get r :body))

      :else
      {:kind :error :reason {:status (get r :status) :body (get r :body)}})))

;; ── streaming ───────────────────────────────────────────────────────────────

(defn parse-sse-deltas
  "Content deltas from an SSE body, in order.

   Each event is a `data: {json}` line; `data: [DONE]` terminates. Only
   `content` deltas are collected \u2014 `reasoning_content` is the model thinking
   aloud and is NOT the answer, so streaming it to the page would show the user
   working notes as if they were the reply."
  [body]
  (let [lines (split body "\n")]
    (filterv (fn [x] (not (nil? x)))
             (mapv (fn [line]
                     (let [l (trim line)]
                       (if (and (starts-with? l "data: ")
                                (not (= l "data: [DONE]")))
                         (delta-content (subs l 6))
                         nil)))
                   lines))))

(defn- delta-content
  "The `content` field of one SSE delta, or nil when the delta carries only
   reasoning or a role marker."
  [json]
  (let [marker "\"content\":\""
        i (index-of json marker)]
    (if (nil? i)
      nil
      (let [after (subs json (+ i (count marker)))
            text (take-until-unescaped-quote after)]
        ;; nil (unterminated) and "" (an empty delta) are both "nothing to
        ;; append" here: a partial SSE line is dropped rather than shown.
        (if (or (nil? text) (= "" text)) nil text)))))

(defn stream-tool-calls
  "The tool calls an SSE body requested, assembled across its deltas.

   Streaming splits ONE tool call over many frames: the first carries `id`,
   `name` and the opening of `arguments`; later frames carry more `arguments`
   text and nothing else. So this is a JOIN — the pieces must be glued back
   together before the JSON inside `arguments` is even syntactically whole.

   It works by REASSEMBLING the frames into the single-turn document shape and
   handing that to `tool-calls`, the decoder the non-streaming path already
   uses. Writing a second decoder here was the alternative and is the mistake
   this file's header warns about: two implementations of one wire format
   drift, and the drift is silent because both keep producing plausible output.
   Reassembly costs one string build per turn and keeps the count at one.

   Empty when the turn requested no tools — the common case, so callers test it
   first and stream content when it is empty.

   ── why this exists ──────────────────────────────────────────────────────

   `parse-sse-deltas` keeps only `content` fields, so a streamed tool call
   decoded to nil and was filtered away: the page showed an empty answer and
   the machine never grew. That was the recorded gap between the two loops —
   the one with tools could not stream, the one that streamed had no tools."
  [body]
  (let [calls (assemble-tool-calls (sse-frames body))]
    (if (empty? calls)
      []
      (tool-calls (assembled-document calls)))))

(defn- sse-frames
  "The JSON payload of each `data:` frame, `[DONE]` excluded."
  [body]
  (filterv (fn [x] (not (nil? x)))
           (mapv (fn [line]
                   (let [l (trim line)]
                     (if (and (starts-with? l "data: ") (not (= l "data: [DONE]")))
                       (subs l 6)
                       nil)))
                 (split body "\n"))))

(defn- raw-field
  "One `\"key\":\"value\"` field of a frame, still ESCAPED; nil when absent.

   Raw rather than decoded because the pieces are going straight back into a
   JSON document: decoding here and re-escaping there would be two conversions
   that have to agree, and `arguments` is itself JSON-in-a-string, which is
   exactly where such a pair goes wrong."
  [frame key]
  (let [marker (str "\"" key "\":\"")
        i (index-of frame marker)]
    (if (nil? i)
      nil
      (let [after (subs frame (+ i (count marker)))
            n (raw-string-length after)]
        (subs after 0 n)))))

(defn- assemble-tool-calls
  "Frames folded into [{:id :name :arguments}…], every field still escaped.

   A frame carrying a `name` OPENS a call; every `arguments` fragment after it
   belongs to THAT call until the next `name` appears. Concatenating every
   fragment regardless would produce one call whose arguments are two JSON
   documents jammed together, which parses as neither."
  [frames]
  (let [acc (atom [])]
    (doseq [f frames]
      (let [nm (raw-field f "name")
            arg (raw-field f "arguments")]
        (when (not (nil? nm))
          (swap! acc (fn [cs] (conj cs {:id (or (raw-field f "id") "")
                                       :name nm
                                       :arguments ""}))))
        (when (not (nil? arg))
          (swap! acc (fn [cs]
                       (let [n (count cs)]
                         (if (= 0 n)
                           cs
                           (let [c (nth cs (- n 1))]
                             (assoc cs (- n 1)
                                    (assoc c :arguments
                                           (str (get c :arguments) arg)))))))))))
    (deref acc)))

(defn- assembled-document
  "The assembled calls as the single-turn document `tool-calls` reads.

   The point of the round trip: whatever `tool-calls` learns about the wire —
   a new field, a provider quirk, an anchoring rule — applies to streamed turns
   for free, because they arrive at it in the same shape."
  [calls]
  (str "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":["
       (join ","
             (map (fn [c]
                    (str "{\"id\":\"" (get c :id) "\",\"type\":\"function\","
                         "\"function\":{\"name\":\"" (get c :name) "\","
                         "\"arguments\":\"" (get c :arguments) "\"}}"))
                  calls))
       "]},\"finish_reason\":\"tool_calls\"}]}"))

(defn stream
  "Stream a completion to `target`, one message per token.

     [:delta id chunk]     … many, as content arrives
     [:tool-calls id calls] … once, when the turn requested tools instead
     [:done id]            … on success
     [:failed id why]      … on any failure

   Sends rather than returns, because that is what makes streaming free on this
   runtime: the LiveView receives a token the same way it receives any other
   message, so there is no second transport to build.

   Spawned UNLINKED by the caller (see `stream-async`), so a provider that dies
   mid-answer cannot take the page with it.

   ── why [:tool-calls …] exists ────────────────────────────────────────────

   A streamed turn can request a tool, and this function used to be incapable
   of noticing: `parse-sse-deltas` keeps only `content` fields, so `tool_calls`
   deltas decoded to nil and were filtered out. The page then showed an empty
   answer and the machine never grew. That was the recorded gap between the two
   loops — the one with tools could not stream, the one that streamed had no
   tools — and it is closed here rather than by a second code path."
  [cfg messages target id]
  (let [r (send-request cfg messages true)]
    (cond
      (not (nil? (get r :error)))
      (erlang/send target (tuple :failed id (str "transport: " (pr-str (get r :error)))))

      (= 200 (get r :status))
      (let [payload (get r :body)
            calls (stream-tool-calls payload)]
        (if (empty? calls)
          (do
            ;; Deltas are sent in order, then a single :done. The page appends
            ;; each one; nothing needs to know the total length in advance.
            ;;
            ;; `:pace` sleeps between deltas. A real provider paces the stream
            ;; itself — the frames arrive as the model writes them — but a
            ;; cassette and the canned answer arrive as one complete body, so
            ;; every delta would be sent in the same instant and the page would
            ;; render the finished answer in a single frame. The thing being
            ;; verified is that INTERMEDIATE states render, so an offline turn
            ;; that cannot show one is not exercising the property. The old
            ;; `stream-fake` slept 60ms per word for exactly this reason; the
            ;; sleep survives it, the parallel implementation does not.
            (let [pace (get cfg :pace 0)]
              (doseq [d (parse-sse-deltas payload)]
                (when (> pace 0) (Process/sleep pace))
                (erlang/send target (tuple :delta id d))))
            (erlang/send target (tuple :done id)))
          ;; A tool turn carries no prose worth rendering — the assistant's
          ;; content is "" by construction. Sending the calls INSTEAD of deltas
          ;; keeps the page from flashing an empty bubble before the machine
          ;; changes under it.
          (do
            (erlang/send target (tuple :tool-calls id calls))
            (erlang/send target (tuple :done id)))))

      :else
      (erlang/send target (tuple :failed id (str "HTTP " (get r :status)))))
    :sent))

(defn- offline?
  "Does this transport deliver a whole body at once?"
  [cfg]
  (not (= :httpc (transport cfg))))

(defn stream-async
  "Spawn `stream` in an UNLINKED process and return its pid.

   Unlinked deliberately: a linked provider process that crashes takes its
   caller down, which for a LiveView means every connected user loses the page
   because one answer failed. The same reasoning as `fence`'s spawn+monitor,
   and the same lesson learned the hard way there.

   There is no longer a `stream-fake` beside this. It existed because the fake
   path had to be different CODE — a hand-rolled word-by-word sender that
   imitated the message protocol. Imitation is the problem: a bug in request
   building, in SSE parsing or in tool-call assembly was invisible to it,
   because it never built a request or parsed a frame. `cfg`'s `:transport`
   now decides only where the BYTES come from, so `PROVIDER=fake` runs the same
   parser over a synthetic SSE body and a cassette runs it over a recorded one."
  [cfg messages target id]
  ;; An offline transport hands back a complete body, so its deltas would all
  ;; be sent in one instant. Default it to a visible pace; a caller wanting the
  ;; raw speed (a unit test asserting the messages, not the timing) sets
  ;; `:pace 0` explicitly.
  (let [cfg (if (and (offline? cfg) (nil? (get cfg :pace)))
              (assoc cfg :pace 60)
              cfg)]
    (erlang/spawn (fn [] (stream cfg messages target id)))))
