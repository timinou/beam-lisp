; spell/src/spell/live.bl — the machine as ONE page.
;
; `spell.contract` emits ONE contract and ONE view. A machine holds many of
; each, and the page a browser loads is all of them at once — so this file's
; job is the merge, and the merge is where a wrong answer is easy and quiet.
;
; ── why merging is not concatenation ────────────────────────────────────────
;
; An EDN document is `{:st/imports [...] :st/forms [...] :st/scopes [...]
; :st/constructs [...]}`. Two documents concatenated as text produce a file
; with two `:st/imports` keys, which the reader will happily take one of. The
; merge therefore happens per KEY, and imports are deduplicated: a duplicate
; import is not an error in verse, but a page whose import list grows with
; every definition is a page whose diff nobody can read.
;
; ── page-locals ─────────────────────────────────────────────────────────────
;
; A local (`@draft`) is written by the browser, crosses no seam, and is
; therefore declared by no contract. The page still has to declare it or it
; references an undeclared signal. `machine-locals` derives them with the SAME
; function rung 2 uses to exempt them from orphan checks, so the page cannot
; compile with a local the checker did not know about — one derivation, two
; consumers, no way for them to disagree.

(ns spell.live
  (:require [spell.contract :refer [edn-parts view-parts module-name emit-html hole-name]]
            [spell.st-edn]
            [spell.machine :refer [contracts views view-signals]]
            [rewrite :refer [postwalk]]))

;; ── imports ─────────────────────────────────────────────────────────────────

(def seam-imports
  ["stdlib/macros/data-kind" "stdlib/macros/handle"])

(def view-imports
  ;; `stdlib/enum/dispatch` supplies `@view`, the reactive dispatch a `st/view`
  ;; bind emits. Importing it unconditionally rather than only when some view
  ;; uses one: an unused import costs a line, while a missing one is an EDN
  ;; reader error at the moment a model first proposes a status indicator.
  ["stdlib/macros/data-kind" "stdlib/enum/dispatch"])

;; ── merging documents ────────────────────────────────────────────────────────
;;
;; There is no merge code here any more, and that is the change.
;;
;; It used to print each contract and each view as TEXT and then parse the text
;; back to find its sections: `doc-section` and `find-key`, ~90 lines of
;; scanning with hand-rolled string- and escape-state tracking. They were
;; written because a template containing `]` truncated a document mid-form, and
;; then hardened again because a bind whose selector contained the literal text
;; `:st/scopes [` could be mistaken for a section header. Their own docstring
;; conceded the scan was "safe HERE and would not be in general".
;;
;; The reason for all of it was that documents became text too early.
;; `spell.contract` now answers with PARTS (`edn-parts`, `view-parts`), those
;; concatenate (`spell.st-edn/merge-parts`), and text is produced once at the
;; end (`spell.st-edn/print-document`). Nothing parses our own output, so
;; nothing can parse it wrongly.

;; ── the machine's two documents ─────────────────────────────────────────────

(defn machine-host-name
  "The name of the machine's ONE host: the first contract registered.

   A machine's contracts render into ONE page with ONE LiveView socket, and
   the bridge routes assign diffs by module name — a diff naming any other
   module is rejected by the page's own hook. So every contract's subscribes
   and signals point at a single `@host`, named after the first contract:
   the one the served module is named for, and the one whose name keeps the
   seeded machine's page stable as the machine grows."
  [m]
  (name (get (first (contracts m)) :name)))

(defn machine-seam-parts
  "Every registered contract's merged seam parts, all pointing at the machine's
   ONE host (see `machine-host-name`)."
  [m]
  (spell.st-edn/merge-parts
    (mapv (fn [c] (edn-parts c (machine-host-name m))) (contracts m))
    seam-imports))

(defn machine-seam-edn
  "Every registered contract's seam, as one EDN document."
  [m]
  (spell.st-edn/print-document (machine-seam-parts m)))

(defn machine-view-parts
  "Every registered view's merged document parts."
  [m]
  (spell.st-edn/merge-parts (mapv view-parts (views m)) view-imports))

(defn machine-view-edn
  "Every registered view's three planes, as one EDN document."
  [m]
  (spell.st-edn/print-document (machine-view-parts m)))

(defn machine-hosts
  "The machine's one host, as a singleton list — the shape `machine-page-edn`
   maps over. See `machine-host-name` for why there is exactly one."
  [m]
  [(machine-host-name m)])

(defn machine-locals
  "Every page-local SIGNAL across every registered view — the names a page must
   declare as `@data inline`.

   `view-signals`, not `view-locals`: the latter also carries `@each` loop
   variables, which exist only inside the loop that binds them. Declaring one as
   a page signal would create a second, permanently empty name that a template's
   `{@row.field}` could resolve to instead — a page that compiles, renders, and
   shows blank rows.

   Sorted and de-duplicated: two views may each write `@draft`, and declaring it
   twice is a duplicate signal."
  [m]
  (vec (sort (distinct (mapcat view-signals (views m))))))

(defn- template-named
  "The body HTML of the `&name` template in one view's markup plane, or nil.

   Markup forms are `(template &shell [] [:main …])` — the body is hiccup
   DATA (PLAN-029), so the answer is the body forms printed by
   `spell.contract/emit-html`, the same printer the construct scope uses: one
   printer, so the shell the LiveView renders and the markup the bundle
   hydrates cannot be two spellings. The name is a SYMBOL, so it is compared
   by `name` rather than by identity — the reader may hand back `&shell` from
   either the source or a re-read EDN document and the two must match."
  [v nm]
  (let [hit (first (filter (fn [f]
                             (and (seq? f)
                                  (= (first f) (quote template))
                                  (= (name (second f)) nm)))
                           (get v :markup [])))]
    (if (nil? hit) nil (join "" (map emit-html (drop 3 hit))))))

(defn machine-shell-holes
  "Every hole in the machine's `&shell` template, spelled as the author wrote
   it (`@partial` or `$partial`).

   A hole in the shell never interpolates: the shell is rendered by the
   LiveView, SERVER-side, before the bundle hydrates — only the bundle's
   templates interpolate holes. One written into the shell ships as the
   literal characters the emitter produced (`` `$partial` ``), in the page
   forever. Observed live: a model put `{@partial}` in the shell AND bound it
   correctly in the view; every rung passed and the served page showed the
   literal text.

   The check is STRUCTURAL — a walk of the shell's markup tree asking
   `spell.contract/hole-name` — because the hiccup era (PLAN-029) ended the
   string one: a regex over emitted HTML is a scanner grading the emitter's
   spelling, and it died quietly the day holes stopped being `{@name}` text.
   One recogniser for 'hole', shared with the emitter, is what cannot drift.

   Publish-time (`Spell.Loop.regenerate_host`) rather than a rung: a hole in
   the shell is a fact about how the shell is HOSTED, which is what publish
   knows and the rungs do not."
  [m]
  (let [shell-tpl (first (filter (fn [f] (not (nil? f)))
                                 (mapv (fn [v]
                                         (first (filter (fn [f]
                                                          (and (seq? f)
                                                               (= (first f) (quote template))
                                                               (= (name (second f)) "&shell")))
                                                        (get v :markup []))))
                                       (views m))))]
    (if (nil? shell-tpl)
      []
      (let [acc (atom [])]
        (postwalk (fn [node]
                    (let [h (hole-name node)]
                      (when (not (nil? h))
                        (swap! acc conj (str "@" (subs h 1))))
                      node))
                  (vec (drop 3 shell-tpl)))
        (vec (sort (distinct @acc)))))))

(defn machine-shell
  "The host markup a LiveView must render for the bundle to hydrate into: the
   `&shell` template of the first view that declares one.

   LIFTED, never retyped. `scripts/serve_chat.sh` learned this the hard way and
   says so in its own comments — a hand-written host page drifted from the
   emitter's output and a proof screenshot showed a page the emitter had never
   produced. `spacetime_lv`'s bridge carries the same defect structurally: its
   `render_host/1` hand-mirrors one DOM skeleton per page in a `cond`, which its
   own comment calls literal evidence for the follow-up that will delete it.
   Deriving it from the view term means a page cannot host markup its own
   template does not describe.

   nil when no view declares `&shell`: the caller decides whether that is fatal.
   It is for the LiveView (there would be nothing to hydrate), which is exactly
   why this returns rather than throws — the emitter names the machine in its
   error, and this function does not know the machine's name."
  [m]
  (first (filter (fn [s] (not (nil? s)))
                 (mapv (fn [v] (template-named v "&shell")) (views m)))))

(defn machine-report
  "The machine's report with page-locals derived, exactly as rung 2 derives them.

   `spell.machine/report` takes locals as an ARGUMENT because the machine layer
   has no opinion about what a page-local is. Every caller in the loop was
   passing `[]`, so the published report listed `draft`, `m` and `t` as
   orphan-binding ERRORS — on a machine the ladder had just accepted. A report
   that contradicts the check beside it is worse than no report: a reader has to
   decide which one is lying.

   One derivation, one answer. `machine-findings` already computes locals for
   the check; this reuses it so the two cannot drift."
  [m]
  (let [locals (vec (distinct (mapcat spell.machine/view-locals (views m))))]
    (assoc (spell.machine/report m locals)
           :locals locals)))

;; ── there is no `:unmounted` here, and that is the point ────────────────────
;;
;; The report used to carry `spell.machine/unmounted-binds` — a scan of the
;; HTML strings this system generated, looking for bind selectors nothing
;; renders. Two things were wrong with it:
;;
;;   1. It agrees with our emitter BY CONSTRUCTION. It reads our own strings,
;;      so it can only find what our own printer already knew. Its own
;;      docstring called it the weak path and said the authoritative answer
;;      comes from asking verse what it actually rendered.
;;   2. Nothing consumed it. Not the ladder (rung 4 asks verse), not the
;;      browser, not `peek.sh`. It was a field in a JSON file, computed on
;;      every publish, that no reader ever read.
;;
;; A second answer to "what renders" that nobody asks is not a safety net — it
;; is a thing that can disagree with the real check and be believed when it
;; does. `BeamLisp.Spell.Verse.ghosts/2` is the one answer: it joins against
;; the compiler's OWN emit layer, which is independent ground truth.
;;
;; The demo's clock case is what proves the surviving check has teeth: a view
;; binding `.clock` that no markup renders is refused at rung 4, and
;; `loop_test.exs` plus `served_loop_test.exs` both pin it.

(defn machine-briefing
  "What the model must know about the machine it is editing, as a system message.

   WHY THIS EXISTS, in the model's own words. Asked to improve the chat view,
   glm-5.3 reasoned:

     \"I don't know what the existing chat contract looks like — the machine is
      running and presumably has a chat contract defined. Since I can't inspect
      the machine, I should define a view that binds to a standard chat contract
      shape… Risk: if my guess of names doesn't match the actual contract, the
      compiler will reject with diagnostics.\"

   It then invented `chat.send`, `@online`, `@user` and `@at` — none of which
   exist — and its proposal was refused by the ladder for orphan bindings. The
   refusal was CORRECT and the failure was ours: we handed a model a tool for
   editing a machine and told it nothing about the machine.

   Every name here is READ FROM THE MACHINE rather than restated, so a briefing
   cannot describe a system that has changed underneath it — the same rule the
   tool schema follows for its key whitelist. A view defined at runtime appears
   in the next turn's briefing without anyone editing this function.

   Kept SHORT deliberately. This rides on every turn, including plain
   conversation, so it is the vocabulary and the rules that decide whether a
   proposal survives the ladder — not a tutorial."
  [m]
  (let [rep (machine-report m)
        names (fn [k] (let [xs (get rep k [])]
                        (if (empty? xs) "(none)" (join ", " (map str xs)))))]
    (str
      "You are editing a LIVE machine by calling the `run` tool with SOURCE — "
      "the same text a human author writes: `(defcontract name (assign @x "
      ":type init) (on :ev [param] (ok …)) …)` for server state and events, "
      "`(defview name (markup (template &shell [] \"html\") …) (style "
      "[selector {rules}] …) (binds [selector (st/each @xs :as @x :template "
      "&row)] …))` for markup, style and bindings. The page a user is looking "
      "at is generated from the machine, and an accepted definition rebuilds "
      "that page immediately. Handler bodies are read for their (ok …)/(err …) "
      "reply tags only — what a handler DOES is server code, not something "
      "this tool writes.\n\n"

      "THE MACHINE RIGHT NOW\n"
      "  contracts: " (names :contracts) "\n"
      "  views:     " (names :views) "\n"
      "  assigns:   " (names :assigns)
      "      ← server state; read in markup as {@name}\n"
      "  events:    " (names :events)
      "      ← the ONLY signals a bind may fire\n"
      "  pushes:    " (names :pushes) "\n"
      "  locals:    " (names :locals)
      "      ← page-local bindings ($draft, and each-item names)\n\n"

      "RULES THE CHECKER ENFORCES — a definition breaking one is refused:\n"
      "  * Every {@name} in a template must be an assign, a declared param of "
      "that template, or a page-local. Inventing a name fails.\n"
      "  * Every signal a bind fires must be an event listed above. Inventing "
      "an event fails; there is no way to add one from here.\n"
      "  * Every selector you bind or style must exist in markup you also "
      "write in the same definition. A rule for a class nothing renders fails.\n"
      "  * A view REPLACES the view of the same name. To change the page, "
      "redefine the existing view rather than adding a second one.\n"
      "  * The template that renders the WHOLE PAGE must be named `shell`. "
      "It is what the browser hydrates into; any other name and there is no "
      "page. Give it the outermost element, and let the other templates be "
      "the parts it hosts.\n"
      "  * A rule that sets `background` MUST also set `color`. The page is "
      "dark by default, so a light background with no foreground leaves the "
      "text at the inherited light grey — invisible on its own box. Verse "
      "only compares the two when they appear in the SAME rule, so nothing "
      "will warn you.\n"
      "  * `shell` must contain NO {@name} holes. It is rendered by the "
      "server before the page hydrates, where holes are not interpolated — a "
      "{@name} written there reaches the browser as the literal text "
      "\"{@name}\". Put an EMPTY element in the shell and let a bind fill "
      "it: the shell holds `<p class=\"note\"></p>`, and a view bind on "
      "`.note` renders a template that reads {@name}.\n\n"

      "Prefer redefining what is there over inventing a parallel surface. If "
      "you need a name that does not exist, say so instead of guessing it.")))

(defn machine-bind-selectors
  "Every selector the registered views attach behaviour to.

   Handed to the verse rung so its \"bound but nothing renders it\" join takes
   its left side from OUR definitions. Scanning the emitted bundle instead was
   tried and is wrong: verse's runtime ships its own `querySelector` calls, so
   the seeded machine reported `.ad-form` and three siblings — library code we
   did not write and cannot judge."
  [m]
  (vec (sort (distinct (mapcat spell.machine/view-bind-selectors (views m))))))

;; ── the style plane ─────────────────────────────────────────────────────
;;
;; `spacetime st` prints a document's `:st/forms` — which for a view means its
;; templates and its BIND scopes — but not its `:st/scopes`, the style plane.
;; Verified by printing the seed's own view document: four `.selector {…}`
;; blocks come back and every one of them is a bind, while `.chat`, `.bubble`
;; and the rest are absent.
;;
;; That is why `serve_chat.sh` supplies presentation from a separate hand-
;; written file, and it is exactly the split this whole project exists to
;; remove: a page whose styles are not emitted from the term cannot be checked
;; against the term. Rung 4 would then be asking whether hand-written CSS
;; matches generated markup — a real question, but not the one the machine can
;; answer, and it would report every styled class as a ghost.
;;
;; So the style plane is emitted HERE, from `(get v :style)`, which is our own
;; data in the shape `[selector {prop value …}]`. This is not a second source of
;; truth: it is the SAME source, printed by us because verse's printer does not
;; print it. If `st` learns to, this function deletes.

(defn css-prop
  "A CSS property name, with camelCase folded to kebab-case.

   `textTransform` → `text-transform`. Models write the JS spelling constantly
   — it is the one they see in every `element.style.x` example — and CSS does
   not accept it: the browser drops the declaration SILENTLY, with no console
   message and no visual clue beyond the effect not happening.

   Observed live and end to end. Asked for an uppercase role label, a model
   emitted a correct template, a correct bind and this style map:

     {:color \"#6b7280\" :display \"block\" :fontSize \"11px\"
      :fontWeight \"600\" :letterSpacing \"0.08em\" :margin \"0 0 4px\"
      :textTransform \"uppercase\"}

   Four of those seven properties do not exist. Every rung passed — the class
   is rendered, the selector is bound, verse compiles a stylesheet containing
   `textTransform: uppercase;` without complaint — and the browser reported
   `text-transform: none`. The label rendered, in the wrong case, and the only
   way to find out was `getComputedStyle`.

   NORMALISED rather than refused, unlike the shell-hole rule. The two
   spellings mean exactly the same thing and the mapping is total and
   reversible, so refusing would punish a model for a difference that carries
   no information. A hole in the shell, by contrast, cannot be repaired without
   knowing where the author wanted the value to appear.

   Only the ASCII letters are folded; a leading `--` custom property is left
   alone, since `--myVar` and `--my-var` are genuinely different names."
  [k]
  (let [s (name k)]
    (if (starts-with? s "--")
      s
      (join "" (map (fn [ch]
                      (if (and (>= (compare ch "A") 0) (<= (compare ch "Z") 0))
                        (str "-" (lower-case ch))
                        ch))
                    (split s ""))))))

(defn- css-decl
  "One declaration — `prop: value;`, or `prop <- $signal;` for an injection.

   The arrow is a DIFFERENT surface, not a formatting choice: `:` sets a CSS
   property, `<-` binds a DOM property reactively, and verse routes them
   through `style.setProperty` and `setAttribute` respectively (BUG-091 there).
   `spell.contract/css-value` already distinguishes them when emitting
   `:st/scopes` for the checker; this is the same distinction for the CSS text
   the BROWSER loads, and without it the two planes disagreed — the checker saw
   a reactive binding and the stylesheet carried the literal text
   `value: (inject (deref draft));`."
  [k v]
  (if (and (seq? v) (= (first v) (quote inject)))
    (str "  " (css-prop k) " <- " (signal-ref (second v)) ";")
    (str "  " (css-prop k) ": " (str v) ";")))

(defn- signal-ref
  "An `@name` seam binding as its `$name` signal on the Spacetime side."
  [v]
  (if (and (seq? v) (= (first v) (quote deref)))
    (str "$" (name (second v)))
    (str v)))

(defn- css-rule
  "One `selector { … }` block from a `[selector {…}]` style entry.

   Declarations are sorted BY NAME, and that is load-bearing rather than tidy.

   ── what unsorted actually did ────────────────────────────────────────────

   `(keys m)` on a small Erlang map answers in TERM order, and the term order of
   atoms is their ATOM-TABLE CREATION order — not their spelling. So the order
   depended on what the VM had interned before this map was built, which varies
   between runs of the same code: a golden test captured `.chat` as
   `… color, grid-template-rows, height …` in one run and
   `… color, height, grid-template-rows …` in the next, with nothing changed.

   CSS cascades, so declaration order is MEANING: two declarations touching the
   same property resolve by position. A page whose styles reorder per emit is a
   page that can render differently for no reason its diff can explain, and
   whose bundle hash moves on every rebuild.

   ── why by NAME and not by insertion ─────────────────────────────────────

   Insertion order is not available: a map does not keep it. Sorting by name is
   what `spell.contract/edn-scope` already does for the SAME declarations when
   it emits `:st/scopes`, so this makes the two agree — the style plane verse
   checks and the style plane the browser loads are now in one order, which is
   the property this file's header claims and did not have."
  [rule]
  (let [sel (get rule 0)
        decls (get rule 1 {})]
    (str sel " {\n"
         (join "\n" (map (fn [k] (css-decl k (get decls k)))
                         (sort-by name (keys decls))))
         "\n}")))

(defn machine-css
  "Every registered view's style plane, as CSS text.

   Order follows registration, then declaration name within a view: CSS
   cascades, so a stable order is the difference between a page that looks the
   same on every emit and one that changes when a map iterates differently.
   See `css-rule` for why the second half of that sentence was a claim rather
   than a fact until the golden caught it."
  [m]
  (join "\n" (mapcat (fn [v] (map css-rule (get v :style []))) (views m))))

(defn machine-page-edn
  "The complete machine as one EDN document, declarations before their uses."
  [m module-prefix]
  (let [seam (machine-seam-parts m)
        view (machine-view-parts m)
        merged (spell.st-edn/merge-parts
                 [seam view]
                 (concat (get seam :imports [])
                         (get view :imports [])
                         ["stdlib/macros/host" "stdlib/macros/on"
                          "stdlib/macros/each"]))
        host-forms
        (mapv (fn [h]
                (let [contract (first (filter (fn [c] (= h (name (get c :name))))
                                              (contracts m)))]
                  (spell.st-edn/emit-form
                    "host-live"
                    {:name (symbol (str "$" h))
                     :module [:st/expr (str "\"" (module-name contract module-prefix) "\"")]})))
              (machine-hosts m))
        local-forms
        (mapv (fn [l]
                (spell.st-edn/emit-form
                  "data-inline"
                  {:name (symbol (str "$" l))
                   :value [:st/expr "\"\""]}))
              (machine-locals m))
        css (machine-css m)]
    (spell.st-edn/print-document
      (assoc merged
             :forms (vec (concat host-forms local-forms
                                 (get seam :forms []) (get view :forms [])))
             :css (if (empty? css) [] [css])))))

;; ── the seeded machine ──────────────────────────────────────────────────────

(defn seeded
  "A machine holding the seed definitions — where every session starts.

   `defs` is a VECTOR of `[contract-term view-term]` pairs, registered in the
   order given: the default shell is the chat definition and the live-state
   definition, and the order matters — the first contract names the page's
   one host (`machine-host-name`) and the first view with an `&shell`
   supplies the page's skeleton (`machine-shell`).

   A vector rather than variadic `& defs`: a variadic beam-lisp fn compiles
   to a `$blfn` dispatcher, which Elixir callers (`Spell.Loop`, the test
   case) reach with plain `apply` — so the arity Elixir sees must be exact.

   Taking the definitions as ARGUMENTS rather than requiring particular
   namespaces keeps this file free of a dependency on one particular
   application: the live loop is machinery, and what it starts with is a
   choice its caller makes."
  [m defs]
  (reduce (fn [acc d]
            (spell.machine/register-view (spell.machine/register-contract acc (first d))
                                         (second d)))
          m defs))
