; spell/src/spell/contract.bl — `defcontract`: one term, two runtimes.
;
; A contract declares the SEAM between a server half (BEAM) and a client half
; (a Spacetime page). Both halves are emitted from this one term, so they cannot
; disagree — the check that verse performs at build time (E0928) becomes a
; tautology rather than a net that might catch drift.
;
; ── the surface ──────────────────────────────────────────────────────────────
;
;   (defcontract counter-live
;     {:bundle "/spacetime/counter/spacetime.js" :root ".counter"}
;
;     (assign @count :integer 0)
;     (push   @flash {:message :string :kind :atom})
;
;     (on :inc
;       (set! @count (inc @count))
;       (ok @count))
;
;     (on :dec
;       (if (zero? @count)
;         (err "Count cannot go below zero")
;         (do (set! @count (dec @count))
;             (ok @count)))))
;
; `@name` marks a binding that CROSSES THE SEAM. How it resolves is this file's
; problem, never the author's: on the BEAM it reads `socket.assigns.name`, in
; Spacetime it is the `$name` signal. A page-local binding is simply one that is
; NOT declared here — the definition of "shared", not a separate annotation.
;
; `(ok …)` / `(err …)` are the correlated one-shot reply, kept DISTINCT from the
; broadcast assign diff that `set!` implies. Collapsing them would repeat
; BUG-091 in verse, where merging `:` and `<-` silently rerouted a reactive
; binding between style.setProperty and setAttribute — two routes that look
; alike and are not.
;
; ── why the handler body is data ─────────────────────────────────────────────
;
; FUP-143 (verse) records a hole that cannot be closed from Elixir: reply tags
; live in handler bodies and can be runtime values, so `@on_definition` cannot
; enumerate them. Here the body is a quoted form, so `seam/reply-tags` walks it.
; That is the whole reason the source of truth moves up a level.

(ns spell.contract
  (:require [spell.seam :refer [reply-tags events assigns pushes assert-enumerable!]]
            ;; The ONE document printer. Required rather than assumed loaded:
            ;; a namespace that calls another and does not declare it works
            ;; only while something else happens to have loaded it first, and
            ;; the failure when that stops being true is an undefined-function
            ;; error far from the missing line.
            [spell.st-edn]))

;; ── parsing the surface into a term ─────────────────────────────────────────
;; Each clause is a plain list; we read its head. Unknown heads FAIL rather than
;; being ignored, because a silently-dropped clause is a seam hole that no later
;; check can see.

(defn- binding-name
  "The name a clause declares. Accepts `@count` (which reads as `(deref count)`)
   or a bare `count`, so the author may write either and the emitter does not
   care which the reader produced."
  [form]
  (cond
    ; `@count` → (deref count)
    (and (seq? form) (= (first form) (quote deref)))
    (name (second form))

    (symbol? form) (name form)
    (keyword? form) (name form)
    (string? form) form
    :else (throw (ex-info "contract: cannot read a binding name" {:form form}))))

(defn- parse-clause [acc clause]
  (let [head (first clause)]
    (cond
      (= head (quote assign))
      ;; (assign @count :integer 0)
      (let [nm (binding-name (second clause))
            ty (nth clause 2 :any)
            init (nth clause 3 nil)]
        (assoc-in acc [:assigns (keyword nm)] {:type ty :initial init}))

      (= head (quote push))
      ;; (push @flash {:message :string})
      (let [nm (binding-name (second clause))
            fields (nth clause 2 {})]
        (assoc-in acc [:pushes (keyword nm)] {:fields fields}))

      (= head (quote on))
      ;; (on :inc body…) or (on :send [text] body…)
      (let [ev (keyword (binding-name (second clause)))
            tail (rest (rest clause))
            ;; A leading VECTOR is the parameter list. It has to be pulled out
            ;; here or it is not recorded anywhere: `(on :send [text] …)` used
            ;; to fold `[text]` into the body, where it evaluated as a literal
            ;; and the NAMES were lost — invisible while nothing executed a
            ;; body, fatal the moment `spell.server` did, because the wire is
            ;; positional and the binder has nothing to bind against.
            params (if (vector? (first tail)) (mapv name (first tail)) [])
            body (if (vector? (first tail)) (rest tail) tail)
            whole (if (= 1 (count body)) (first body) (cons (quote do) body))]
        ;; Refuse at PARSE time a body whose replies cannot be enumerated.
        ;; A contract that silently under-reports its tags produces a page
        ;; checked against an incomplete set — the seam check passes and the
        ;; browser drops a reply. Better to fail here, where the author can see
        ;; it, than there, where nobody can.
        (assert-enumerable! ev whole)
        (assoc-in acc [:events ev] {:params params :body whole}))

      (= head (quote on-info))
      ;; (on-info [:delta id chunk] body…) — a server-internal message, NOT part
      ;; of the page-facing surface, so it is kept separately and excluded from
      ;; the fingerprint.
      (let [pattern (second clause)
            body (rest (rest clause))]
        (update acc :infos
                (fn [v] (conj (or v [])
                              {:pattern pattern
                               :body (if (= 1 (count body))
                                       (first body)
                                       (cons (quote do) body))}))))

      :else
      (throw (ex-info "contract: unknown clause" {:head head :clause clause})))))

(defn parse
  "Read a contract's clauses into a term. `opts` is the {:bundle :root} map."
  [nm opts clauses]
  (reduce parse-clause
          {:name nm :opts opts :events {} :assigns {} :pushes {} :infos []}
          clauses))

;; ── the BEAM half ───────────────────────────────────────────────────────────

(defn module-name
  "The Elixir module a contract emits, e.g. counter-live → CounterLive.
   Matches the `SpacetimeLvWeb.<Name>Live` convention already in the repo."
  [c prefix]
  (str prefix "."
       (join "" (map (fn [part]
                       (str (upper-case (subs part 0 1)) (subs part 1)))
                     (split (name (get c :name)) "-")))))

;; ── contract.json ───────────────────────────────────────────────────────────
;; This is the interop surface: verse's src/analysis/liveview_contract.rs reads
;; it, and the fingerprint must agree BYTE FOR BYTE with what the Elixir DSL
;; produces, or the two toolchains silently disagree about identity.
;;
;; Two things are load-bearing and easy to get wrong:
;;   1. entries are sorted BY NAME (contract_entries/2 does `Enum.sort_by(&.name)`)
;;   2. a metadata field is OMITTED when empty, not emitted as {} or ""
;; Both are pinned by tests against the real CounterLive fingerprint.

(defn- json-escape
  "Escape a string the way `Jason.encode!` does.

   Backslash/quote/newline are the obvious three; the CONTROL characters are the
   ones that bite. Jason escapes every U+0000..U+001F, so a name containing a
   carriage return or tab emitted raw here produced INVALID JSON that verse
   could not parse — and a different fingerprint besides. Found by review."
  [s]
  (-> s
      (replace-str "\\" "\\\\")
      (replace-str "\"" "\\\"")
      (replace-str "\b" "\\b")
      (replace-str "\f" "\\f")
      (replace-str "\n" "\\n")
      (replace-str "\r" "\\r")
      (replace-str "\t" "\\t")
      (escape-remaining-controls)))

(defn- escape-remaining-controls
  "Any U+0000..U+001F left after the named escapes becomes \\u00XX, matching
   Jason. Rare, but a raw control byte is invalid JSON, not merely ugly."
  [s]
  (join ""
        (map (fn [ch]
               (let [c (first (String/to_charlist ch))]
                 (if (< c 32)
                   (str "\\u00" (String/downcase (Base/encode16 (:binary/encode_unsigned c))))
                   ch)))
             (String/graphemes s))))

(defn- json-str [s] (str "\"" (json-escape (str s)) "\""))

(defn- entry-name
  "A declaration's name as the wire spells it.

   NOT `name`: beam-lisp's `name` strips a namespace prefix, so a declared
   `event(\"ns/a\")` — which Elixir's `to_string` keeps whole — came out as
   `\"a\"`. Silent truncation of a legal name, and a different fingerprint.
   Found by review."
  [k]
  (let [s (str k)]
    ;; a keyword prints as `:ns/a`; drop only the leading colon
    (if (starts-with? s ":") (subs s 1) s)))

(defn- json-fields
  "A fields map as JSON, keys sorted — Jason encodes an Elixir map in the erlang
   term order of its keys, which for these small atom-keyed maps is
   alphabetical. Sorting explicitly makes that a property rather than a
   coincidence of map size.

   NB the sort is over the KEYS THEMSELVES, not over their printed names: a
   first version sorted `(map name (keys m))` and then looked the value up with
   the resulting STRING, which missed every keyword key and emitted
   `{\"kind\":\"\",\"message\":\"\"}` — structurally perfect JSON with every value
   silently blank, and a fingerprint that differed from Elixir's."
  [m]
  (str "{"
       (join ","
             (map (fn [k] (str (json-str (entry-name k)) ":" (json-str (entry-name (get m k)))))
                  (sort-by entry-name (keys m))))
       "}"))

(defn- json-tags
  "A reply-tag list as a JSON array of strings."
  [tags]
  (str "[" (join "," (map (fn [t] (json-str t)) tags)) "]"))

(defn- json-event-entry
  "An event entry, carrying the reply tags its handler can produce.

   This is FUP-143 hole #2 closed at the source. Elixir cannot write this field:
   its handler bodies are opaque, so `@on_definition` cannot enumerate the tags.
   A beam-lisp body is data, so they fall out of a walk — and verse's
   `compare_replies` then rejects a page that fails to decode one.

   Emitted ONLY when the handler can actually reply. An event with no `(ok …)`
   or `(err …)` is fire-and-forget, and writing `\"replies\":[]` would assert
   something stronger than intended about a contract that simply predates the
   field."
  [nm tags]
  (if (empty? tags)
    (str "{\"name\":" (json-str nm) "}")
    (str "{\"name\":" (json-str nm) ",\"replies\":" (json-tags tags) "}")))

(defn- json-entry
  "One contract entry. `meta-key` is :fields or :type; omitted when empty."
  [nm meta meta-key]
  (cond
    (nil? meta) (str "{\"name\":" (json-str nm) "}")

    (= meta-key :type)
    (if (or (nil? meta) (= "" (str meta)))
      (str "{\"name\":" (json-str nm) "}")
      (str "{\"name\":" (json-str nm) ",\"type\":" (json-str (entry-name meta)) "}"))

    :else
    (if (empty? meta)
      (str "{\"name\":" (json-str nm) "}")
      (str "{\"name\":" (json-str nm) ",\"fields\":" (json-fields meta) "}"))))

(defn- json-array [entries] (str "[" (join "," entries) "]"))

(defn contract-json
  "The contract as JSON, in the EXACT key order Jason produces for the Elixir
   DSL's map — module, events, assigns, pushes. Key order changes the bytes and
   therefore the fingerprint, so it is fixed here rather than derived."
  [c module]
  (let [ev (map (fn [k] (json-entry (entry-name k) nil :fields))
                (sort-by entry-name (keys (get c :events))))
        as (map (fn [k] (json-entry (entry-name k)
                                    (get-in c [:assigns k :type])
                                    :type))
                (sort-by entry-name (keys (get c :assigns))))
        pu (map (fn [k] (json-entry (entry-name k)
                                    (get-in c [:pushes k :fields])
                                    :fields))
                (sort-by entry-name (keys (get c :pushes))))]
    (str "{\"module\":" (json-str module)
         ",\"events\":" (json-array ev)
         ",\"assigns\":" (json-array as)
         ",\"pushes\":" (json-array pu)
         "}")))

(defn fingerprint
  "SHA-256 of the contract JSON — the same bytes, hashed the same way, as
   `Spacetime.LiveView.__before_compile__`. Byte equality with the Elixir DSL is
   the acceptance test for this whole emitter."
  [c module]
  (sha256-hex (contract-json c module)))

(defn contract-json-with-fingerprint
  "The sidecar file's content: the contract plus its fingerprint."
  [c module]
  (let [bare (contract-json c module)
        fp (sha256-hex bare)]
    (str (subs bare 0 (- (count bare) 1))
         ",\"fingerprint\":" (json-str fp) "}")))

;; ── the Spacetime (EDN) half ────────────────────────────────────────────────
;;
;; The SAME term emits the page's `@data` declarations. Because both halves come
;; from one source, verse's E0928 check (page intents vs contract.json) becomes a
;; tautology instead of a net that might catch drift.
;;
;; Shapes are taken from real printer output for a page that compiles today
;; (`spacetime edn elixir/spacetime_lv/frontend/counter.st`), not from the
;; grammar read by eye:
;;
;;   (data-subscribe :name $count :host $counter :assign count)
;;   (data-inline    :name $error :type [:st/type "string"] :value [:st/expr "\"\""])
;;   (data-signal    :name $inc :params [:st/paramlist] :host $counter
;;                   :arms [...] :mode latest :sum IncResult :target "inc" :verb emit)
;;
;; `$name` is a Binding and prints BARE (SPEC §4: symbol, $-prefixed) — quoting
;; it would make it a string and change its meaning.

(defn- edn-str
  "A string literal for the EDN wire.

   NOT `json-str`: that escapes for JSON, and its `\\uXXXX` control forms are
   not what the EDN reader expects. Only quote and backslash need escaping
   here — using the JSON escaper double-escaped every attribute quote in a
   template body, so `class=\"bubble\"` arrived at verse as `class=\\\"bubble\\\"`."
  [s]
  (str "\"" (-> (str s)
                (replace-str "\\" "\\\\")
                (replace-str "\"" "\\\""))
       "\""))

(defn- edn-binding [nm] (str "$" nm))

(defn- edn-sum-name
  "The receive-sum type for an event: `inc` → `IncResult`. A page needs a name
   to decode replies into; deriving it keeps the two halves from disagreeing
   about what that name is."
  [ev]
  (str (upper-case (subs ev 0 1)) (subs ev 1) "Result"))

(defn- edn-arm
  "One receive arm: a literal tag pattern mapped to a constructor.
   `_` (the catch-all) prints as a NAME pattern, not a literal — the printer
   distinguishes {\"lit\" \"ok\"} from {\"name\" _} and so must this."
  [tag ctor payload]
  (let [pat (if (= tag "_")
              "[:st/named {\"name\" _}]"
              (str "[:st/named {\"lit\" \"" tag "\"}]"))]
    (str "[:st/named {\"cons\" [:st/named {\"variant\" [:st/named {\"ctor\" "
         ctor " \"payload\" [:st/expr \"" payload "\"]}]}] \"final\" \"\" \"pat\" "
         pat "}]")))

(defn- edn-signal
  "One `@data signal` form: the page's half of an event.

   The arms are DERIVED from the handler's reply tags — the capability that
   makes this whole design work. A page cannot be missing an arm for a tag the
   server can produce, because the arms ARE the tags."
  [c ev host]
  (let [tags (reply-tags (get-in c [:events (keyword ev) :body]))
        sum (edn-sum-name ev)
        arms (map (fn [t]
                    (if (= t "ok")
                      (edn-arm "ok" "Ok" "$.reply")
                      (edn-arm "_" "Failed" "$.reply")))
                  tags)]
    (str "(data-signal :name " (edn-binding ev)
         " :params [:st/paramlist]"
         " :host " (edn-binding host)
         " :arms [:st/array " (join " " arms) "]"
         " :ephemeral \"\" :mode latest"
         " :sum " sum
         " :target \"" ev "\""
         " :verb emit)")))

(defn- edn-subscribe [a host]
  (str "(data-subscribe :name " (edn-binding a)
       " :host " (edn-binding host)
       " :assign " a ")"))

(defn- edn-stream
  "The transient-effect channel. Every declared push arrives here, so the page
   decodes them through the SAME receive-arm vocabulary as replies — bridge
   principle 4, one decode vocabulary, no parallel protocol."
  [c host]
  (let [arms (map (fn [p]
                    (edn-arm p
                             (str (upper-case (subs p 0 1)) (subs p 1))
                             "$.payload"))
                  (pushes c))]
    (if (empty? arms)
      nil
      (str "(data-live-stream :name $fx"
           " :host " (edn-binding host)
           " :arms [:st/array " (join " " arms) "]"
           " :sum Effect)"))))

(defn edn-forms
  "Every `@data` form the page needs, as EDN text, in declaration-stable order."
  [c host]
  (let [subs (map (fn [a] (edn-subscribe a host)) (assigns c))
        sigs (map (fn [ev] (edn-signal c ev host)) (events c))
        stream (edn-stream c host)]
    (vec (filter (fn [x] (not (nil? x)))
                 (concat subs sigs (list stream))))))

(defn edn-parts
  "The seam's document as DATA: `{:imports […] :forms […]}`.

   Each value is a vector of already-printed EDN strings; what is NOT done here
   is assembling them into a document. That is `spell.st-edn/print-document`'s
   job, and the split is the point:

   A machine holds many contracts and many views, and the page a browser loads
   is all of them at once. Merging TEXT meant printing each document and then
   PARSING IT BACK to find its sections — `spell.live` carried ~90 lines of
   string scanning with hand-rolled escape and string-state tracking to do it,
   whose own docstring conceded it was \"safe HERE and would not be in general\".
   It was written after a template containing `]` truncated a document
   mid-form.

   Parts compose by `concat`. There is nothing to parse, so there is nothing to
   parse wrongly."
  [c host]
  {:imports []
   :forms (edn-forms c host)})

(defn edn-document
  "The page half as an EDN document — the exact shape `to_st_file` ingests, so
   it is checked by every validator a hand-written `.st` page is checked by.
   The generated half CANNOT be less checked than the hand-written one.

   Kept as the single-contract entry point (the contract suite and
   `render_emitted.exs` both print one contract); it is `edn-parts` printed."
  [c host imports]
  (spell.st-edn/print-document (assoc (edn-parts c host) :imports imports)))

;; ── the extended sidecar: contract + reply tags ─────────────────────────────
;;
;; `contract-json` stays BYTE-IDENTICAL to what the Elixir DSL emits, because
;; that equality is the acceptance test proving the two toolchains agree about a
;; contract's identity. Adding a field there would silently move every
;; fingerprint and make the comparison meaningless.
;;
;; So reply tags ride in a SEPARATE projection. verse's `compare_replies` reads
;; `replies` when present and is silent when absent — a contract that predates
;; the field must not fail every page — which is exactly the additive shape this
;; split produces.

(defn contract-json-with-replies
  "The contract JSON, plus each event's reply tags (FUP-143 hole #2).

   Elixir cannot write this: handler bodies are opaque there, so
   `@on_definition` cannot enumerate the tags. A beam-lisp body is data, so they
   fall out of a walk — and verse then rejects a page that fails to decode one.

   An event with no `(ok …)`/`(err …)` is fire-and-forget and carries NO
   `replies` key, rather than an empty list: empty asserts 'this handler never
   replies', which is a stronger claim than 'not declared'."
  [c module]
  (let [ev (map (fn [k]
                  (let [nm (entry-name k)
                        tags (reply-tags (get-in c [:events k :body]))]
                    (if (empty? tags)
                      (str "{\"name\":" (json-str nm) "}")
                      (str "{\"name\":" (json-str nm)
                           ",\"replies\":" (json-tags tags) "}"))))
                (sort-by entry-name (keys (get c :events))))
        as (map (fn [k] (json-entry (entry-name k) (get-in c [:assigns k :type]) :type))
                (sort-by entry-name (keys (get c :assigns))))
        pu (map (fn [k] (json-entry (entry-name k) (get-in c [:pushes k :fields]) :fields))
                (sort-by entry-name (keys (get c :pushes))))
        bare (str "{\"module\":" (json-str module)
                  ",\"events\":" (json-array ev)
                  ",\"assigns\":" (json-array as)
                  ",\"pushes\":" (json-array pu)
                  "}")]
    ;; The fingerprint remains the one over the ELIXIR-SHAPED contract, so a
    ;; sidecar with reply tags still identifies the same contract as one without.
    (str (subs bare 0 (- (count bare) 1))
         ",\"fingerprint\":" (json-str (fingerprint c module)) "}")))

;; ── the BEAM half, as a module ──────────────────────────────────────────────
;;
;; The projection that closes the loop. Every other emitter here describes the
;; seam to somebody else — the page's `@data` forms to verse, the sidecar to the
;; contract checker — while the server the seam names was left for a human to
;; write by hand, in another language, in another repo. That is the drift this
;; whole design exists to remove: `spacetime_lv` hand-writes a LiveView and
;; DERIVES contract.json from it; here the contract is the source and the
;; LiveView is derived, so the two cannot disagree about events, assigns,
;; pushes, or which module the page's `@host` names.
;;
;; What is generated is PLUMBING, deliberately:
;;
;;   * the `use Spacetime.LiveView` head (bundle, root, and the host shell)
;;   * the `events`/`assigns`/`pushes` declarations — the same three lists the
;;     sidecar carries, so the bridge's own E0928 check sees them too
;;   * one LITERAL `handle_event/3` head per declared event — literal because
;;     that is what proves to `Spacetime.LiveView.__before_compile__` that a
;;     declared event actually reaches the server; a catch-all only warns
;;   * one `handle_info/2` head per `on-info` pattern
;;
;; and each head delegates straight to `spell.server`, because the BEHAVIOUR is
;; already written — in the contract, as data. Generating Elixir that re-states
;; the body would create a second copy of the logic that could rot; generating
;; Elixir that CALLS the body keeps exactly one.

(defn- ex-str
  "An Elixir double-quoted string literal.

   `#{` is escaped as well as quote and backslash: an un-escaped `#{` in Elixir
   source is INTERPOLATION, so a shell containing one would either fail to
   compile or — far worse — evaluate whatever followed it at module-compile
   time, in the generated file, from markup the model may have written."
  [s]
  (str "\"" (-> (str s)
                (replace-str "\\" "\\\\")
                (replace-str "\"" "\\\"")
                (replace-str "#{" "\\#{"))
       "\""))

(defn- ex-fields
  "A push's field map as an Elixir keyword list: `id: :string, text: :string`."
  [fields]
  (join ", " (map (fn [k] (str (entry-name k) ": :" (entry-name (get fields k))))
                  (sort-by entry-name (keys (or fields {}))))))

(defn- ex-info-head
  "A `handle_info/2` head for one `on-info` pattern.

   `[:delta id chunk]` → `{:delta, _, _}`. The tag is matched and the arity is
   fixed; the values are ignored here because the CONTRACT binds them — this
   head exists to route, not to destructure. Matching arity matters: a pattern
   that ignored it would swallow a longer message from a later protocol and
   hand `spell.server` something its clause cannot bind."
  [pattern]
  (let [tag (entry-name (first pattern))
        holes (join ", " (map (fn [_] "_") (rest pattern)))]
    (if (empty? (rest pattern))
      (str "{:" tag "}")
      (str "{:" tag ", " holes "}"))))

(defn elixir-module
  "The contract's BEAM half as Elixir source: a `Spacetime.LiveView` whose every
   declaration comes from the contract and whose every callback delegates to
   `spell.server`.

   `shell` is the host markup the bundle hydrates — lifted from the view's own
   `&shell` template, never retyped. `module` is the fully-qualified name the
   page's `@host` declares, so the string that appears here and the string that
   appears in the emitted `.st` have one source."
  [c module shell]
  (let [nm (name (get c :name))
        opts (get c :opts {})
        ev-decls (map (fn [e] (str "    event(:" e ")")) (events c))
        as-decls (map (fn [a] (str "    assign(:" a ", :"
                                   (entry-name (get-in c [:assigns (keyword a) :type]))
                                   ")"))
                      (assigns c))
        pu-decls (map (fn [p]
                        (let [f (get-in c [:pushes (keyword p) :fields])]
                          (if (empty? f)
                            (str "    push(:" p ")")
                            (str "    push(:" p ", " (ex-fields f) ")"))))
                      (pushes c))
        ev-heads (map (fn [e]
                        (str "  @impl true\n"
                             "  def handle_event(\"" e "\", payload, socket),\n"
                             "    do: BeamLisp.Spell.Server.event(socket, @contract, \"" e "\", payload)"))
                      (events c))
        info-heads (map (fn [cl]
                          (str "  @impl true\n"
                               "  def handle_info(" (ex-info-head (get cl :pattern)) " = message, socket),\n"
                               "    do: BeamLisp.Spell.Server.info(socket, @contract, message)"))
                        (get c :infos []))]
    (str "# GENERATED by spell.contract/elixir-module from the `" nm "` contract.\n"
         "# Do not edit: the contract is the source, this file is a projection of it.\n"
         "# fingerprint: " (fingerprint c module) "\n"
         "defmodule " module " do\n"
         "  @moduledoc \"\"\"\n"
         "  The `" nm "` contract's server half.\n\n"
         "  Generated from the contract term: the declarations below ARE the\n"
         "  contract's events, assigns and pushes, and every callback delegates to\n"
         "  `spell.server`, which walks the handler body the contract carries. The\n"
         "  behaviour lives in the contract; this module is the plumbing that lets\n"
         "  Phoenix reach it.\n"
         "  \"\"\"\n\n"
         "  use Spacetime.LiveView,\n"
         "    bundle: " (ex-str (get opts :bundle)) ",\n"
         "    root: " (ex-str (get opts :root)) ",\n"
         "    shell: " (ex-str shell) "\n\n"
         "  @contract " (ex-str nm) "\n\n"
         "  events do\n" (join "\n" ev-decls) "\n  end\n\n"
         "  assigns do\n" (join "\n" as-decls) "\n  end\n\n"
         (if (empty? pu-decls)
           ""
           (str "  pushes do\n" (join "\n" pu-decls) "\n  end\n\n"))
         "  @impl true\n"
         "  def mount(_params, _session, socket),\n"
         "    do: BeamLisp.Spell.Server.mount(socket, @contract)\n\n"
         (join "\n\n" ev-heads) "\n\n"
         (join "\n\n" info-heads) "\n"
         "end\n")))

;; ── defview: the page, as three planes ──────────────────────────────────────
;;
;; `StFile` has three planes and they are bound by SELECTOR, not by nesting:
;;
;;   markup  — `@template &card($c) { <article>…</article> }`, a DOM tree
;;   style   — `.card { border-radius: 0.75rem; }`, CSS regions
;;   binds   — `.card { @flip $items(…) @drag(…) { … } }`, behaviour attached
;;
;; That is why `.card` legitimately appears in more than one: a template can be
;; styled by many rules and a rule can hit many templates. An earlier design of
;; mine collapsed them into "one element, one place", which would have destroyed
;; the many-to-many the language is built on.
;;
;; `binds` is Spacetime's own word (`%binds`), and spells the same in UK and US
;; English — a small thing that matters for a keyword a reader types.
;;
;; markup NESTS (a DOM is a tree); style and binds are FLAT selector lists
;; (attachment is many-to-many). The file's shape mirrors the MODEL, not the DOM.

(defn- view-clause [acc clause]
  (let [head (first clause)]
    (cond
      (= head (quote markup)) (assoc acc :markup (vec (rest clause)))
      (= head (quote style)) (assoc acc :style (vec (rest clause)))
      (= head (quote binds)) (assoc acc :binds (vec (rest clause)))
      :else (throw (ex-info "defview: unknown plane" {:head head})))))

(defn parse-view
  "Read a view's planes into a term. Unknown planes FAIL rather than being
   ignored: a silently-dropped plane is a page missing its styles."
  [nm clauses]
  (reduce view-clause {:name nm :markup [] :style [] :binds []} clauses))

;; ── style ───────────────────────────────────────────────────────────────────

(defn- css-value
  "A declaration value. `(inject @x)` emits the `<-` arrow (DOM injection);
   anything else is the `:` CSS surface. Collapsing the two would reroute a
   reactive binding between setAttribute and style.setProperty — BUG-091 in
   verse, and the reason the arrow is carried as DATA rather than inferred."
  [v]
  (if (and (seq? v) (= (first v) (quote inject)))
    {:inject true :value (binding-ref (second v))}
    {:inject false :value (if (string? v) v (binding-ref v))}))

(defn- binding-ref
  "A value that may be an `@name` seam binding. `@count` reads as
   `(deref count)`, and on the Spacetime side a seam binding IS the `$count`
   signal — the whole point of `@` meaning one thing in two runtimes."
  [v]
  (cond
    (and (seq? v) (= (first v) (quote deref))) (str "$" (name (second v)))
    (string? v) v
    :else (str v)))

(defn- edn-scope
  "One `:st/scopes` entry: a selector and its declarations."
  [rule]
  (let [sel (first rule)
        decls (second rule)]
    (str "{:selector " (edn-str sel) " :decls {"
         (join " "
               (map (fn [k]
                      (let [v (css-value (get decls k))]
                        (str (edn-str (entry-name k)) " "
                             (if (get v :inject)
                               (str "[:st/inject " (edn-str (get v :value)) "]")
                               (edn-str (get v :value))))))
                    (sort-by entry-name (keys decls))))
         "}}")))

;; ── markup ──────────────────────────────────────────────────────────────────

(defn- hole-markers
  "Rewrite `{@c.tag}` JSX-style holes into `[:st/hole N]` markers, returning
   `[skeleton holes]`.

   Braces rather than Spacetime's backticks: backtick is beam-lisp's
   `syntax-quote`, so `` `$c.id` `` inside a defview would read as a quoted form
   before the emitter ever saw it. A different sigil between the two languages
   is worth an easier reader."
  [markup]
  (loop [rest-s markup
         acc ""
         holes []
         n 0]
    (let [i (index-of rest-s "{")]
      (if (nil? i)
        [(str acc rest-s) holes]
        (let [before (subs rest-s 0 i)
              after (subs rest-s (+ i 1))
              j (index-of after "}")]
          (if (nil? j)
            ;; an unclosed brace is markup we cannot split — carry it verbatim
            ;; rather than truncate (the BUG-368 lesson: never silently lose text)
            [(str acc before "{" after) holes]
            (recur (subs after (+ j 1))
                   (str acc before "[:st/hole " n "]")
                   (conj holes (binding-ref-text (subs after 0 j)))
                   (+ n 1))))))))

(defn- binding-ref-text
  "A hole's expression as Spacetime spells it: `@c.tag` → `$c.tag`."
  [e]
  (let [t (trim e)]
    (if (starts-with? t "@") (str "$" (subs t 1)) t)))

(defn- template-param
  "One entry of a `:st/paramlist`.

   Shape taken from the printer's own output for `@template &bubble($m)`:
   `[\"m\" :binding false nil nil false]` — name WITHOUT the `$`, the capture
   kind, then variadic/default/type/optional slots. Copied from real output
   rather than guessed, because a paramlist the parser cannot read makes the
   whole template silently unparseable."
  [p]
  (let [raw (str p)
        nm (if (starts-with? raw "$") (subs raw 1) raw)]
    (str (edn-str nm) " :binding false nil nil false")))

(defn- template-form
  "The `(template …)` form that DECLARES a template.

   A template is two things in an `StFile`, and both are required: a form in
   `:st/forms` that declares it, and a `Construct(\"template\")` scope carrying
   its body. Emitting only the scope produced a document that read back with the
   body present and the declaration missing — so nothing referenced it, `each`
   invoked a template the file never declared, and the page rendered empty. The
   reviewers caught this by comparing the emitted document against a real one:
   hand-written `.st` yields BOTH (`matches=7 scopes=13`), the emitted document
   yielded only the scope.

   `:body [:st/component-body]` is the presence-marker the printer expects; the
   markup itself lives in the sibling scope (`edn-template`)."
  [tpl]
  (let [raw (str (second tpl))
        nm (if (starts-with? raw "&") (subs raw 1) raw)
        params (nth tpl 2 [])]
    (str "(template :name " nm
         " :params [:st/paramlist "
         (if (empty? params)
           ""
           (join " " (mapv (fn [p] (str "[" (template-param p) "]")) (to-list params))))
         "] :body [:st/component-body])")))

(defn- template-html
  "A template body's markup, spelled the way a template body spells it.

   A `@template` body carries its holes INLINE as backtick expressions
   (`data-role=\"`$m.role`\"`) — confirmed by parsing a real `.st` file and
   reading the scope's html back. That is NOT the `:st/html` plane's spelling,
   where a hole is a `[:st/hole N]` marker paired with an ordered expression
   list; the two planes differ because a top-level HTML block is addressable
   (BUG-369) while a template body is reconstructed as source text.

   Emitting hole MARKERS here produced `data-role=[:st/hole 0]` in the printed
   `.st` — a literal, unparseable attribute value where an interpolation
   belonged. So `{@m.role}` becomes `` `$m.role` ``: the same hole, in the
   spelling this plane actually uses."
  [markup]
  (loop [rest-s markup
         acc ""]
    (let [i (index-of rest-s "{")]
      (if (nil? i)
        (str acc rest-s)
        (let [before (subs rest-s 0 i)
              after (subs rest-s (+ i 1))
              j (index-of after "}")]
          (if (nil? j)
            ;; an unclosed brace is markup we cannot split — carry it verbatim
            ;; rather than truncate (the BUG-368 lesson: never silently lose text)
            (str acc before "{" after)
            (let [expr (binding-ref-text (subs after 0 j))
                  ;; An ATTRIBUTE hole needs quotes around it. JSX writes
                  ;; `data-role={@m.role}` bare, but HTML wants
                  ;; `data-role="`$m.role`"` — and an unquoted backtick run is
                  ;; parsed by the HTML tokenizer as a literal attribute value,
                  ;; so the DOM came out carrying the six characters `$m.role`
                  ;; instead of "user". The page rendered, the bubbles appeared,
                  ;; and every `[data-role='user']` style silently missed.
                  ;;
                  ;; A hole is in ATTRIBUTE position when it follows an `=`
                  ;; that is itself inside a tag. Testing only for a trailing
                  ;; `=` is not enough: `<p>x={@m.v}</p>` also ends with `=`,
                  ;; and quoting there produced `x='`$m.v`'` — visible quote
                  ;; characters in the rendered text (found by review).
                  ;;
                  ;; "Inside a tag" is decided the way the HTML tokenizer
                  ;; decides it: the nearest angle bracket behind us is a `<`
                  ;; rather than a `>`.
                  attr? (and (ends-with? before "=")
                             (let [lt (last-index-of before "<")
                                   gt (last-index-of before ">")]
                               (and (not (nil? lt))
                                    (or (nil? gt) (> lt gt)))))
                  ;; DOUBLE quotes, because verse's template runtime only
                  ;; interpolates an attribute hole spelled that way. Its two
                  ;; passes are:
                  ;;
                  ;;   attribute:  /(\w+)=\x22([^\x22]*\$[\w.]+[^\x22]*)\x22/
                  ;;   text:       />([^<]*\$[\w.]+[^<]*)</
                  ;;
                  ;; The first matches `\x22` — the DOUBLE quote — only. The
                  ;; second matches only between `>` and `<`. A single-quoted
                  ;; attribute value falls between them and is interpolated by
                  ;; NEITHER, so `data-role='`$m.role`'` reached the DOM with
                  ;; the literal characters `$m.role` as its value, every
                  ;; `[data-role='model']` rule missed, and the model's answer
                  ;; rendered unstyled — the console's only complaint being
                  ;;
                  ;;   [ST Template] bubble - Uninterpolated variables: ["$m.role"]
                  ;;
                  ;; from a debug branch that fires AFTER both passes give up.
                  ;; `$m.text`, sitting in text position, interpolated fine —
                  ;; which is why the bug looked like "only some holes work".
                  ;;
                  ;; This was single-quoted on the belief that a double quote
                  ;; could not survive `edn-str` — true of the JSON escaper it
                  ;; briefly used (which double-escaped to `class=\\\"bubble\\\"`)
                  ;; and NOT true of `edn-str`, whose `\\\"` the EDN reader
                  ;; unescapes back to a bare quote. Verified by round-tripping
                  ;; a double-quoted body through `edn-str` → reader → printer
                  ;; → `spacetime build`, then reading the compiled template
                  ;; out of the bundle.
                  quoted (if attr?
                           (str "\"`" expr "`\"")
                           (str "`" expr "`"))]
              (recur (subs after (+ j 1))
                     (str acc before quoted)))))))))

(defn- edn-template
  "One `:st/constructs` entry: a template's body, carried so the document is
   self-contained. Without it `print_file` cannot reconstruct the markup and an
   EDN-authored template is unrenderable (BUG-370)."
  [tpl]
  (let [raw (str (second tpl))
        ;; `&bubble` is an element ref; the scope selector uses the BARE name,
        ;; matching `@template:card` in the parser's construct scopes.
        nm (if (starts-with? raw "&") (subs raw 1) raw)
        markup (last tpl)]
    (str "{:kind \"template\" :selector " (edn-str (str "@template:" nm))
         " :html " (edn-str (template-html markup))
         " :decls {}}")))

;; ── binds ───────────────────────────────────────────────────────────────────
;;
;; Behaviour attached BY SELECTOR, which is why a selector may appear in `style`
;; and `binds` both: one template is styled by many rules and one rule hits many
;; templates. `st/name` invokes a registered `%form` — the wire already spells a
;; form invocation as `(macro-name :key value …)`, so there is no mapping table
;; to rot.

(defn- bind-form
  "One `%form` invocation from a binds clause.

   `(st/on :click (fire :inc))` emits `on-driver-body`, the REGISTERED macro
   name — not `on`, which is only how the directive is spelled in `.st` source.
   The EDN reader checks names against the registry and refuses to invent
   syntax, so an emitter that guesses the name is caught immediately:

     unknown macro \"on\" — no `%macro` of that name is registered

   Shape taken from real printer output, not from reading the grammar."
  [call]
  (let [head (str (first call))
        nm (if (starts-with? head "st/") (subs head 3) head)
        args (rest call)]
    (cond
      (= nm "on") (on-driver-body-form args)
      (= nm "each") (each-form args)
      (= nm "value") (value-inject-form args)
      :else
      (str "(" nm (join "" (map (fn [a] (str " " (bind-arg a))) args)) ")"))))

(defn- each-form
  "`(st/each @messages :as $m :template &bubble)` → an `@each` invocation.

   This is what RENDERS a subscribed list. Without it a page can subscribe to
   `@messages` and still show nothing — a review found exactly that: the chat
   page declared the subscription, styled a `.bubble`, and never instantiated
   the template, so assign diffs arrived and were discarded."
  [args]
  (let [src (first args)
        opts (apply hash-map (to-list (rest args)))
        item (get opts :as)
        tpl (get opts :template)]
    ;; `name` and `args` are STRINGS on the wire, and `:key` is required.
    ;; Taken from the printer's own output for the same construct:
    ;;   {"args" [:st/array "$m"] "name" "bubble"}   with  :key [:st/expr "null"]
    ;; Emitting bare symbols instead printed `@each(…) { [$m] bubble }` — the
    ;; invocation inverted and unparseable, where `&bubble("$m");` belonged.
    (str "(each :source " (edn-binding (deref-name src))
         " :key [:st/expr \"null\"]"
         " :item " (edn-binding (deref-name item))
         " :invocations [:st/array [:st/named {\"name\" "
         (edn-str (strip-amp (str tpl)))
         " \"args\" [:st/array " (edn-str (edn-binding (deref-name item))) "]}]])")))

(defn- view-arm
  "One `@view` arm: `[\"thinking\" &thinking]` → a pattern/invocation pair.

   Two pattern spellings, and the difference is load-bearing (it mirrors
   verse's own `DecodedArm`, and `seam/arm-decodes?` already models it):

     a string   → {\"lit\" \"thinking\"}  — matches that tag exactly
     `_`        → {\"wild\" _}           — the catch-all

   Collapsing them emits a page that either matches nothing or matches
   everything. Shape taken from `spacetime edn` output, not from reading the
   grammar."
  [arm]
  (let [pat (get arm 0)
        tpl (strip-amp (str (get arm 1)))
        pat-edn (if (= (str pat) "_")
                  "[:st/named {\"wild\" _}]"
                  (str "[:st/named {\"lit\" " (edn-str (str pat)) "}]"))]
    (str "[:st/named {\"inv\" [:st/named {\"args\" [:st/array] \"name\" "
         (edn-str tpl) "}] \"pat\" " pat-edn "}]")))

(defn view-form
  "`@view $subject { pat => &tpl(); }` — REACTIVE template dispatch.

   This is what binds a scalar assign to a template: `dispatch-mount` with
   `reactive: true` re-mounts whenever the signal changes. It is the affordance
   that was missing when `@status` was declared, `&thinking` was declared and
   styled, and nothing connected them — a template preview rather than a state
   the page could reach.

   NB the SELECTOR matters and is supplied by the caller (`edn-bind-scope`
   wraps this in `(sel …)`). `dispatch-mount` mounts the matching arm as a CHILD
   of `&self`, so a `@view` emitted bare sits at file level with nowhere to put
   the template: verse accepts the document, `check` passes, and the indicator
   never appears. I emitted it unscoped first and saw exactly that."
  [subject arms]
  (str "(view :subject " (edn-binding (deref-name subject))
       " :arms [:st/array "
       (join " " (map view-arm arms))
       "])"))

(defn- value-inject-form
  "`(st/value @draft)` → the `value <- $draft` DOM injection on an input.

   An input with no value binding cannot carry what the user typed anywhere."
  [args]
  (str "(mutation :target " (deref-name (first args)) " :expr [:st/expr \"$.value\"])"))

(defn- deref-name
  "The name inside `@x` (which reads as `(deref x)`), or the bare symbol."
  [v]
  (if (and (seq? v) (= (first v) (quote deref)))
    (name (second v))
    (name v)))

(defn- strip-amp [s]
  (if (starts-with? s "&") (subs s 1) s))

(defn- on-driver-body-form
  "`(st/on :click (fire :send @draft))` → an `on-driver-body` whose body performs
   the action.

   `&.click` is an element-ref driver: subject empty, member the event name.
   The BODY is a motion-body array, and each entry must already be a decoded
   capture — a nested `(st/value …)` left as a raw list is rejected by the
   reader (\"cannot decode List(…) as a captured value\"), which is the check
   doing its job.

   Trailing key/value pairs after the action are DRIVER PARAMS:

     (st/on :keydown (fire :send @draft) :key \"Enter\")

   emits `&.keydown(key: \"Enter\")` — the one key the binding answers to. The
   qualifier spelling (`:keydown:Enter`) reads better and does not work: verse
   has no grammar slot for it, so it was parsed and DISCARDED and the binding
   fired on every keystroke (verse BUG-375, found from this page sending a
   message per character)."
  [args]
  (let [ev (name (first args))
        action (second args)
        params (apply hash-map (to-list (rest (rest args))))
        ;; ONE action or SEVERAL. `@on`'s body is a motion-body ARRAY, so a
        ;; sequence of actions is its natural shape — what a page needs when an
        ;; event both crosses the seam and resets page-local state, e.g. send
        ;; the draft AND clear the composer.
        actions (if (vector? action) (to-list action) (list action))]
    (str "(on-driver-body"
         " :driver [:st/named {\"member\" " ev " \"subject\" \"\""
         (driver-params-field params)
         "}]"
         " :body [:st/array " (join " " (map motion-entry actions)) "])")))

(defn- driver-params-field
  "The `driver_params` capture for a driver's call-args, or \"\" when there are
   none.

   Shape read off the printer for `&.keydown(key: \"Enter\")`: an array of
   `call_arg` captures, each a named map of `name` and `value`. Emitting the
   field at all when the map is empty produces `driver_params []`, which the
   reader accepts and the pipeline then treats as an EMPTY arg list rather than
   as absent — so the key is omitted entirely instead."
  [params]
  (if (empty? params)
    ""
    (str " \"driver_params\" [:st/array "
         (join " "
               (map (fn [k]
                      ;; The value goes through `edn-str`, the same printer
                      ;; every other capture uses.
                      ;;
                      ;; It was written as `\"\" (get params k) \"\"` — quotes
                      ;; added by hand, contents unescaped — which is correct
                      ;; for `"Enter"` and malformed for any value containing a
                      ;; quote, a backslash or a control character. `:key "\""`
                      ;; is a legal filter (the quote key) and emitted EDN that
                      ;; does not parse, so the whole page stopped compiling
                      ;; for one keystroke. Reaching for the printer instead of
                      ;; reimplementing it is the lesson `emit-value` in
                      ;; spell.st-edn already records.
                      ;;
                      ;; NB the value is a STRING capture and `edn-str` quotes
                      ;; it exactly once. An even earlier version double-quoted
                      ;; it (`key: \"\\\"Enter\\\"\"`), which reached the browser
                      ;; as a key literally spelled with quote marks — matching
                      ;; no keystroke, and dead in a new way.
                      (str "[:st/named {\"name\" " (entry-name k)
                           " \"value\" " (edn-str (get params k)) "}]"))
                    ;; Sorted, for the reason `machine-css` is: `(keys m)` on a
                    ;; small map answers in TERM order, and atom term order is
                    ;; atom-table CREATION order — so two params
                    ;; (`:key "Enter" :code "Enter"`) could serialise in either
                    ;; order between VM runs, moving the emitted document and
                    ;; every downstream bundle byte with nothing changed.
                    (sort-by entry-name (keys params))))
         "]")))

(defn- motion-entry
  "One entry of an `on_motion_body`.

     (fire :send @draft) → a signal call
     (st/value @draft)   → a mutation writing the event's value into a signal"
  [action]
  (cond
    ;; `{"stmt" {"args" … "signal" name}}` — the shape `on_signal_call` actually
    ;; produces, read off the printer for `@on &.click { $send($draft); }`. An
    ;; earlier version invented `"call"`/`"target"`: keys no capture type
    ;; declares, so the walk fell through to the generic compound join and
    ;; printed `$.($draft,)` — a call with no callee. The document still parsed,
    ;; which is exactly why this needed the printer to catch it.
    (and (seq? action) (= (first action) (quote fire)))
    (let [target (name (second action))
          args (rest (rest action))]
      (str "[:st/named {\"stmt\" [:st/named {\"args\" [:st/array "
           (join " " (map (fn [a] (str "[:st/named {\"value\" [:st/expr "
                                       (edn-str (str "$" (deref-name a))) "]}]"))
                          args))
           "] \"signal\" " target "}]}]"))

    (and (seq? action) (= (first action) (quote st/value)))
    (str "[:st/named {\"mut\" [:st/named {\"expr\" [:st/expr \"$.value\"]"
         " \"target\" " (deref-name (second action)) "}]}]")

    ;; `(st/set @draft "")` — write a LITERAL into a signal.
    ;;
    ;; What clears the composer after a send. Without it the draft persisted
    ;; and the next message was CONCATENATED onto the last one, which is what
    ;; the page did: pressing Enter twice sent "first messagesecond message".
    ;; A page-local reset belongs on the page — the server never sees `@draft`,
    ;; so a reply cannot clear it.
    (and (seq? action) (= (first action) (quote st/set)))
    ;; The expr is SOURCE TEXT, and a string literal's quotes are part of that
    ;; text: the expr for `@draft <- ""` is the two characters `""`. `edn-str`
    ;; quotes AND escapes for the wire, so it is applied to the already-quoted
    ;; literal exactly once.
    ;;
    ;; Hand-rolling the escaping instead emitted `$draft <- \\\"\\\"` and the
    ;; browser assigned a literal backslash-quote pair — the composer "cleared"
    ;; to visible garbage. Confirmed in the compiled bundle, where the handler
    ;; body read `"$send($draft); $draft <- \\\"\\\""`.
    (str "[:st/named {\"mut\" [:st/named {\"expr\" [:st/expr "
         (edn-str (str "\"" (nth action 2) "\""))
         "]"
         " \"target\" " (deref-name (second action)) "}]}]")

    :else
    (throw (ex-info "binds: unknown action in an @on body" {:action action}))))

(defn- bind-arg
  "An argument to a bound form. `(fire :inc)` names the signal the page fires,
   which is how a bind reaches the seam the contract declares."
  [a]
  (cond
    (and (seq? a) (= (first a) (quote fire)))
    (str ":target " (edn-str (name (second a))))

    (and (seq? a) (= (first a) (quote deref)))
    (str (edn-binding (name (second a))))

    (keyword? a) (str ":" (name a))
    (string? a) (edn-str a)
    (map? a) (join " " (map (fn [k] (str ":" (entry-name k) " "
                                        (let [v (get a k)]
                                          (if (string? v) (edn-str v) (str v)))))
                            (sort-by entry-name (keys a))))
    :else (str a)))

(defn- view-call?
  "Is this bind clause an `(st/view @subject [arm …] …)`?

   It needs its own path because `@view` does NOT nest inside `(sel …)`: it is a
   file-level form whose host element travels as `&self`. Wrapping it in a
   selector scope yields a document that reads back with the view missing — no
   error, just an absent behaviour, which is the failure mode this project keeps
   meeting."
  [call]
  (let [head (str (first call))]
    (or (= head "st/view") (= head "view"))))

(defn- edn-bind-scope
  "A binds rule wrapped in its SELECTOR.

   `(sel \"…\" form…)` is the reader's scope wrapper: `selector` is a FormMatch
   FIELD, not a capture, so a bare form carries no attachment at all. A first
   version read `sel` and then dropped it, emitting the click handler as a
   top-level form — the button's behaviour was simply unattached, and the page
   compiled clean while doing nothing (found by review)."
  [rule]
  (let [sel (first rule)
        calls (rest rule)
        scoped (filterv (fn [c] (not (view-call? c))) calls)
        views (filterv view-call? calls)
        scope-part (if (empty? scoped)
                     ""
                     (str "(sel " (edn-str sel) " "
                          (join " " (map bind-form scoped))
                          ")"))
        ;; `@view` is scoped like any other bind — it mounts its arm INTO the
        ;; selector's element (`&self`). Emitting it bare put the indicator at
        ;; file level, attached to nothing: verse accepted the document and the
        ;; template had nowhere to appear. That is BUG-374 seen from the other
        ;; side, so it gets the same `(sel …)` wrapper every other bind gets.
        view-part (if (empty? views)
                    ""
                    (str "(sel " (edn-str sel) " "
                         (join " "
                               (map (fn [c] (view-form (second c) (to-list (rest (rest c)))))
                                    views))
                         ")"))]
    (cond
      (= "" scope-part) view-part
      (= "" view-part) scope-part
      :else (str scope-part " " view-part))))

(defn view-parts
  "The view's three planes as DATA: `{:imports :forms :scopes :constructs}`.

   Each value is a vector of already-printed EDN strings; assembling them into
   a document is `spell.st-edn/print-document`'s job. See `edn-parts` on why
   the two are separate — in short, a machine's page is many views at once, and
   merging TEXT meant parsing our own printer's output back."
  [v]
  (let [constructs (map edn-template (get v :markup))
        ;; A template needs its DECLARING form as well as its body scope. The
        ;; declarations come first: a `.log` bind invoking `&bubble` refers to a
        ;; template the file must already declare, and the printer emits forms in
        ;; order.
        decls (map template-form (get v :markup))
        binds (filter (fn [x] (not (= "" x)))
                      (map edn-bind-scope (get v :binds)))]
    {:imports []
     :forms (vec (concat decls binds))
     :scopes (mapv edn-scope (get v :style))
     :constructs (vec constructs)}))

(defn view-document
  "One view as an EDN document. `view-parts` printed — see `edn-parts` on why
   the two are separate."
  [v imports]
  (spell.st-edn/print-document (assoc (view-parts v) :imports imports)))
