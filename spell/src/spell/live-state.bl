; spell/src/spell/live_state.bl — the live environment, as ONE term.
;
; The SECOND definition the default shell holds: a `live-state` contract and a
; `live-state-view` view that render the vars loaded in the BeamLisp live
; environment (`BeamLisp.Env`) as a panel beside the chat. Everything the loop
; accepts later arrives exactly the way this does — a contract and a view
; registered into `spell.machine` — so this file is also the proof that the
; default shell is two ordinary definitions, not one privileged one.
;
; ── why the data comes from a special form ──────────────────────────────────
;
; The handler body is walked by `spell.server`, whose vocabulary is CLOSED and
; pure. Reading the live environment is the one ambient capability the walker
; grants — the special form `(live-vars)` — because "what is loaded right now"
; cannot be a parameter: it changes as the machine grows, and the only honest
; source is the registry itself, read at the moment the answer is rendered.
;
; ── when the panel refreshes ────────────────────────────────────────────────
;
; Two triggers, both landing on the SAME handler:
;
;   * mount. The contract opts carry `:mount-event :refresh`, and the
;     generated LiveView runs that event after seeding. The browser reloads
;     itself when the machine grows (report.json's version moves), so a remount
;     IS the growth notification — no second channel.
;   * the panel's refresh button, for everything else (a REPL-driven load does
;     not reload the page).
;
; ── what this file is NOT ───────────────────────────────────────────────────
;
; It is not a second page. The shell is one page with one LiveView
; (`spell.contract/machine-module` merges every contract into that one host);
; this contract's `:root`/`:bundle` opts are carried for symmetry with
; `spell.seed` and are not what the page is served from.

(ns spell.live-state
  (:require [spell.contract :refer [parse parse-view]]))

;; ── the seam ────────────────────────────────────────────────────────────────

(def contract-term
  (parse :live-state
         {:bundle (Elixir.BeamLisp.Spell.Build/bundle_url)
          :root ".chat"
          :mount-event :refresh}
         (list
           ;; The loaded vars, one entry each:
           ;; {:ns "spell.server" :name "handle" :kind "fn"}.
           (quote (assign @vars :list))

           ;; How many vars are loaded, shown in the panel's head. A separate
           ;; assign rather than a template computation because templates read
           ;; names, they do not compute: the count is derived HERE, at the one
           ;; moment the truth changes.
           (quote (assign @vars_count :integer 0))

           ;; Re-read the environment. `(live-vars)` is the walker's single
           ;; ambient read; everything else in this body is ordinary state
           ;; transition. The count is computed from the assign JUST set —
           ;; `@vars` after `set!` reads the new value, so the two cannot
           ;; disagree.
           (quote (on :refresh
                    (do (set! @vars (live-vars))
                        (set! @vars_count (count @vars))
                        (ok "refreshed")))))))

;; ── the view ────────────────────────────────────────────────────────────────
;
; The panel's SKELETON (`.state`, `.state__list`, the head) lives in the seed
; view's `&shell` — binds attach to rendered DOM, and the shell is the markup
; that is always rendered. What lives HERE is everything that fills it: the row
; template, the count, the refresh button's behaviour, and the panel's styles.

(def view-term
  (parse-view
    :live-state-view
    (list
      (quote
        (markup
          ;; One loaded var. `$v` is the `@each` loop variable, so its fields
          ;; are `@v.name` / `@v.ns` / `@v.kind` — the param carries them, no
          ;; assign is read here.
          (template &var-row [$v]
            [:li {:class "var"}
             [:span {:class "var__name"} @v.name]
             [:span {:class "var__ns"} @v.ns]
             [:span {:class "var__kind"} @v.kind]])

          ;; The count in the panel head. No parameter: the count is a
          ;; subscribed assign, read as `$vars_count` like any page signal.
          (template &state-count []
            [:span {:class "state__count-value"} $vars_count])))

      (quote
        (style
          ;; The panel itself. `.chat` (the shell) owns the grid that places
          ;; it; these rules own what is inside.
          [".state" {:display "flex"
                     :flex-direction "column"
                     :min-height "0"
                     :border-left "1px solid rgba(255,255,255,0.08)"
                     :background "#0e1119"
                     :color "#e8eaf2"}]
          [".state__head" {:display "flex"
                           :align-items "center"
                           :gap "0.5rem"
                           :padding "0.75rem 1rem"
                           :border-bottom "1px solid rgba(255,255,255,0.08)"}]
          [".state__title" {:margin "0"
                            :font-size "0.8rem"
                            :font-weight "600"
                            :letter-spacing "0.08em"
                            :text-transform "uppercase"
                            :color "#9aa3b8"
                            :flex "1"}]
          [".state__count" {:font-size "0.75rem"
                            :color "#9aa3b8"}]
          ;; The refresh button. `background` and `color` in the SAME rule —
          ;; the machine warns on a painted background with inherited text, and
          ;; is right to: this panel sits on the dark shell.
          [".state__refresh" {:padding "0.2rem 0.6rem"
                              :border-radius "0.5rem"
                              :border "1px solid rgba(255,255,255,0.12)"
                              :background "#141824"
                              :color "#e8eaf2"
                              :cursor "pointer"
                              :font-size "0.75rem"}]
          [".state__list" {:flex "1"
                           :overflow-y "auto"
                           :margin "0"
                           :padding "0.5rem 1rem"
                           :list-style "none"
                           :font-family "ui-monospace, SFMono-Regular, Menlo, monospace"
                           :font-size "0.75rem"}]
          [".var" {:display "flex"
                   :gap "0.5rem"
                   :padding "0.15rem 0"
                   :line-height "1.4"}]
          [".var__name" {:color "#e8eaf2"}]
          [".var__ns" {:color "#6b7280"
                       :overflow "hidden"
                       :text-overflow "ellipsis"}]
          ;; The kind tag is painted, so it sets its foreground too.
          [".var__kind" {:margin-left "auto"
                         :padding "0 0.4rem"
                         :border-radius "0.4rem"
                         :background "#1b2030"
                         :color "#9aa3b8"
                         :font-size "0.7rem"}]))

      (quote
        (binds
          ;; The vars, one row each.
          [".state__list" (st/each @vars :as @v :template &var-row)]

          ;; The count in the head. `@view` is reactive dispatch: the arm
          ;; re-mounts when the count changes. One `_` arm — there is always a
          ;; count to show, and 0 is a count.
          [".state__count" (st/view @vars_count ["_" &state-count])]

          ;; The manual refresh. Mount already runs `:refresh` once (see the
          ;; contract's `:mount-event`); this is for loads the page cannot
          ;; see, like a REPL-driven one.
          [".state__refresh" (st/on :click (fire :refresh))])))))
