; spell/src/spell/cassette.bl — recorded provider turns, replayed byte for byte.
;
; A cassette is one real HTTP exchange, written to disk, replayed later through
; the SAME decoders a live turn uses. It exists because the most interesting
; half of this system — a model asking for a tool, the ladder answering, the
; page rebuilding — was only observable when a paid API answered, and both
; configured providers hit their billing wall on 2026-08-15 (kimi: HTTP 403
; quota; deepseek: Insufficient Balance). A verification that can only run when
; someone's card works is not a verification.
;
; ── what a cassette contains, and why the REQUEST is in it ──────────────────
;
;   {:name "clock-tool-call"
;    :recorded "2026-08-16T…"
;    :provider "glm"
;    :stream false
;    :request {:model "…" :messages [{:role … :content …}…] :tools ["define"]}
;    :status 200
;    :body "…the provider's response, verbatim…"}
;
; The response alone would be enough to replay. The REQUEST is recorded because
; of a specific defect this project already shipped: the served page offered the
; model NO tools, so it was structurally incapable of proposing anything, and
; every test passed because every test only ever looked at responses. A cassette
; that carries the request lets a test assert what we SENT — `tools` present,
; the transcript in the right order, `stream` true — which is the half that was
; never checked.
;
; ── replay is deliberately not strict ───────────────────────────────────────
;
; A cassette answers whatever request arrives. Matching the request and failing
; on a mismatch was the other candidate and it is worse HERE: the whole point
; of the loop is that a model's exact words vary, so a strict matcher would turn
; every prompt edit into a re-recording session, and the pressure would be to
; stop using cassettes. What a test wants is "given this recorded ANSWER, does
; the machine do the right thing", plus — separately, explicitly — assertions
; about the request it sent. Both are available; neither is forced.
;
; The mismatch that DOES matter is the streaming one: replaying a non-streaming
; body to a caller expecting SSE deltas produces silence, which reads as a
; broken stream. That one is checked, and it is checked loudly.
;
; ── recording is a privileged act ───────────────────────────────────────────
;
; `scripts/record_cassette.exs` performs one real call and writes the file. It
; is never run by a test: replay is the default, recording is something a human
; does deliberately with a key. A test that could record would silently reach
; the network on a cache miss, which is how a "hermetic" suite starts failing in
; CI for reasons nobody can reproduce.

(ns spell.cassette)

(def dir
  "Where cassettes live. `SPELL_CASSETTE_DIR` overrides, so a test can point at
   a fixture tree without writing to the repository's."
  (or (System/get_env "SPELL_CASSETTE_DIR") "test/cassettes"))

(defn path
  "The file backing cassette `name`."
  [name]
  (str dir "/" name ".edn"))

(defn exists?
  [name]
  (File/exists? (path name)))

;; ── reading ─────────────────────────────────────────────────────────────────

(defn- read-field
  "The value of `key` in a cassette's EDN text.

   A scan rather than a reader call, and the reason is the one this project
   keeps relearning: beam-lisp's reader yields TAGGED FORMS, not data, so
   reading a document back gives `{:keyword \"body\"}` pairs that then need
   unwrapping — a second parser. What is needed here is two strings out of a
   file we wrote ourselves, in a shape we control.

   The body is the only field that can contain anything, so it is stored LAST
   and read as \"everything after the marker\", which no escaping can break."
  [text key]
  (let [marker (str key " ")
        i (index-of text marker)]
    (if (nil? i) nil (+ i (count marker)))))

(defn read-cassette
  "A cassette as a map: {:status :body :stream :request-body}.

   nil when the file is absent — the caller decides whether that is fatal. It
   is fatal in `replay` and merely a fallback in a script that offers to
   record."
  [name]
  (if (not (exists? name))
    nil
    (let [text (File/read! (path name))]
      {:status (cassette-int text ":status")
       :stream (= "true" (cassette-token text ":stream"))
       :request-body (cassette-string text ":request")
       :body (cassette-string text ":body")})))

(defn- cassette-token
  "The bare token following `key`, up to the next whitespace."
  [text key]
  (let [i (read-field text key)]
    (if (nil? i)
      nil
      (let [rest (subs text i)
            j (index-of rest "\n")]
        (trim (if (nil? j) rest (subs rest 0 j)))))))

(defn- cassette-int
  [text key]
  (let [t (cassette-token text key)]
    (if (nil? t) nil (String/to_integer (trim t)))))

(defn- cassette-string
  "The quoted string following `key`, unescaped.

   Both long fields (the request body and the response body) are stored as one
   JSON-escaped string on a single line, so a scan for the closing quote that
   honours backslash escapes reads them exactly. That is the same rule
   `spell.provider/take-until-unescaped-quote` implements for provider bodies —
   and it is deliberately NOT reimplemented here."
  [text key]
  (let [i (read-field text key)]
    (if (nil? i)
      nil
      (let [after (subs text i)]
        (if (not (starts-with? after "\""))
          nil
          (unescape (up-to-unescaped-quote (subs after 1))))))))

(defn- up-to-unescaped-quote
  "The RAW run up to the first unescaped quote \u2014 escapes intact.

   `spell.provider` has the same walk, and reusing it was tried first. It makes
   provider and cassette require each other, and the load order of a cycle is
   not something a manifest can state \u2014 it is a runtime error the first time a
   fresh VM loads them in the wrong order.

   So the dependency points ONE way: cassette knows about provider (it replays
   provider responses), provider knows nothing about cassette beyond a call
   through the seam. Twelve lines of duplicated walk is the price, and it buys
   an acyclic graph. Kept deliberately, and noted so nobody re-merges them.

   NB this returns the run STILL ESCAPED, where the provider's version decodes
   as it goes. Different jobs: this feeds `unescape`, which is the exact
   inverse of `escape` below, so the round trip is one pair of functions rather
   than two halves of different pairs."
  [s]
  (loop [i 0]
    (cond
      (>= i (count s)) nil
      :else
      (let [c (subs s i (+ i 1))]
        (cond
          (= c "\\") (recur (+ i 2))
          (= c "\"") (subs s 0 i)
          :else (recur (+ i 1)))))))

(defn- unescape
  "JSON string escapes, decoded. The inverse of `escape`."
  [s]
  (if (nil? s)
    nil
    (-> s
        (replace-str "\\n" "\n")
        (replace-str "\\r" "\r")
        (replace-str "\\t" "\t")
        (replace-str "\\\"" "\"")
        (replace-str "\\\\" "\\"))))

(defn escape
  "A string as one escaped line. Order matters: backslashes FIRST, or the
   escapes this function introduces would themselves be escaped."
  [s]
  (-> (str s)
      (replace-str "\\" "\\\\")
      (replace-str "\"" "\\\"")
      (replace-str "\n" "\\n")
      (replace-str "\r" "\\r")
      (replace-str "\t" "\\t")))

;; ── writing ─────────────────────────────────────────────────────────────────

(defn render
  "A cassette as EDN text.

   Field order is fixed and the two long strings come last, so a human opening
   the file sees what it IS (name, provider, when, streaming) before the wall of
   recorded bytes."
  [{:keys [name provider stream request body status]}]
  (str "{:name \"" (escape name) "\"\n"
       " :provider \"" (escape (or provider "unknown")) "\"\n"
       " :recorded \"" (DateTime/to_iso8601 (DateTime/utc_now)) "\"\n"
       " :stream " (if stream "true" "false") "\n"
       " :status " (str status) "\n"
       " :request \"" (escape request) "\"\n"
       " :body \"" (escape body) "\"}\n"))

(defn write!
  "Write a cassette to disk; returns its path."
  [entry]
  (File/mkdir_p! dir)
  (let [p (path (get entry :name))]
    (File/write! p (render entry))
    p))

;; ── replaying ───────────────────────────────────────────────────────────────

(defn replay
  "The recorded response for `name`, in `send-request`'s shape.

   `request` is accepted and ignored on purpose — see the header on why
   matching is not strict. The STREAMING shape is checked, because replaying a
   non-streaming body to a caller expecting SSE deltas produces silence, and
   silence reads as a broken provider rather than as a wrong cassette."
  [name request stream?]
  (let [c (read-cassette name)]
    (cond
      (nil? c)
      {:error {:no-cassette name :looked-in (path name)}}

      (not (= stream? (get c :stream)))
      {:error {:cassette-shape name
               :recorded (if (get c :stream) "stream" "single")
               :wanted (if stream? "stream" "single")
               :note "re-record with the same streaming mode, or ask for the other one"}}

      :else
      {:status (get c :status) :body (get c :body)})))

(defn recorded-request
  "The request BODY a cassette recorded, as text.

   Exposed so a test can assert what we SENT — the half that had no coverage
   when the served page silently offered the model no tools."
  [name]
  (let [c (read-cassette name)]
    (if (nil? c) nil (get c :request-body))))

;; ── the canned answer ───────────────────────────────────────────────────────

(defn canned
  "A synthetic response body, for `:fake`.

   Not a cassette: no file, no recording, no fidelity claim. It exists so a
   check can run with no fixtures at all, and it answers in the provider's own
   JSON shape so the same decoders run.

   `stream?` produces SSE frames, because a caller that asked to stream must
   receive deltas — answering it with a single JSON object is the exact
   mismatch `replay` refuses."
  [messages stream?]
  (let [prompt (get (last messages) :content "")
        answer (str "A contract is one term that says what the server owns "
                    "and what the page may ask of it — you asked: \""
                    ;; This module's OWN escaper, not `spell.provider`'s. They
                    ;; escape the same table, and reaching across would make
                    ;; the two namespaces require each other — a cycle whose
                    ;; load order no manifest can state. See
                    ;; `up-to-unescaped-quote` for the same decision.
                    (escape prompt) "\"")]
    (if stream?
      (str (join "" (map (fn [w] (str "data: {\"choices\":[{\"delta\":{\"content\":\""
                                      w " \"}}]}\n"))
                         (split answer " ")))
           "data: [DONE]\n")
      (str "{\"id\":\"fake\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\""
           ",\"content\":\"" answer "\"},\"finish_reason\":\"stop\"}]}"))))
