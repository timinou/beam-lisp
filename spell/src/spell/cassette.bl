; spell/src/spell/cassette.bl — recorded provider turns, replayed byte for byte.
;
; A cassette is one real HTTP exchange, written to disk, replayed later through
; the SAME decoders a live turn uses. It exists because the most interesting
; half of this system — a model asking for a tool, the ladder answering, the
; page rebuilding — was only observable when a paid API answered, and both
; configured providers hit their billing wall on 2026-08-15 (kimi: HTTP 403
; quota; deepseek: Insufficient Balance). A verification that can only run when
; someone's card works is not a verification.
;
; ── what a cassette contains, and why the REQUEST is in it ──────────────────
;
;   {:name "clock-tool-call"
;    :recorded "2026-08-16T…"
;    :provider "glm"
;    :stream false
;    :request {:model "…" :messages [{:role … :content …}…] :tools ["define"]}
;    :status 200
;    :body "…the provider's response, verbatim…"}
;
; The response alone would be enough to replay. The REQUEST is recorded because
; of a specific defect this project already shipped: the served page offered the
; model NO tools, so it was structurally incapable of proposing anything, and
; every test passed because every test only ever looked at responses. A cassette
; that carries the request lets a test assert what we SENT — `tools` present,
; the transcript in the right order, `stream` true — which is the half that was
; never checked.
;
; ── replay is deliberately not strict ───────────────────────────────────────
;
; A cassette answers whatever request arrives. Matching the request and failing
; on a mismatch was the other candidate and it is worse HERE: the whole point
; of the loop is that a model's exact words vary, so a strict matcher would turn
; every prompt edit into a re-recording session, and the pressure would be to
; stop using cassettes. What a test wants is "given this recorded ANSWER, does
; the machine do the right thing", plus — separately, explicitly — assertions
; about the request it sent. Both are available; neither is forced.
;
; The mismatch that DOES matter is the streaming one: replaying a non-streaming
; body to a caller expecting SSE deltas produces silence, which reads as a
; broken stream. That one is checked, and it is checked loudly.
;
; ── recording is a privileged act ───────────────────────────────────────────
;
; `scripts/record_cassette.exs` performs one real call and writes the file. It
; is never run by a test: replay is the default, recording is something a human
; does deliberately with a key. A test that could record would silently reach
; the network on a cache miss, which is how a "hermetic" suite starts failing in
; CI for reasons nobody can reproduce.

(ns spell.cassette)

(def dir
  "Where cassettes live. `SPELL_CASSETTE_DIR` overrides, so a test can point at
   a fixture tree without writing to the repository's."
  (or (System/get_env "SPELL_CASSETTE_DIR") "test/cassettes"))

(defn path
  "The file backing cassette `name`, under `dir` (defaults to `spell.cassette/dir`)."
  ([name] (path dir name))
  ([dir name] (str dir "/" name ".edn")))

(defn exists?
  ([name] (exists? dir name))
  ([dir name] (File/exists? (path dir name))))

;; ── reading ─────────────────────────────────────────────────────────────────

(defn- read-field
  "The value of `key` in a cassette's EDN text.

   A scan rather than a reader call, and the reason is the one this project
   keeps relearning: beam-lisp's reader yields TAGGED FORMS, not data, so
   reading a document back gives `{:keyword \"body\"}` pairs that then need
   unwrapping — a second parser. What is needed here is two strings out of a
   file we wrote ourselves, in a shape we control.

   The body is the only field that can contain anything, so it is stored LAST
   and read as \"everything after the marker\", which no escaping can break."
  [text key]
  ;; Anchored to the START OF A LINE, because `render` writes one field per
  ;; line and every field but the first is preceded by "\n ".
  ;;
  ;; A bare `index-of` took the first occurrence ANYWHERE, including inside an
  ;; earlier field's quoted value — and the earlier fields include `:name` and
  ;; `:request`, both of which carry text this system does not choose. A
  ;; cassette named `probe :body ` renders as a perfectly valid file whose
  ;; first ` :body ` sits inside `:name`; the scan then read the name's closing
  ;; quote as the body's opening one and replayed a DIFFERENT body with status
  ;; 200. A wrong answer that looks like a right one.
  ;;
  ;; Line-anchoring closes it because `escape` turns every real newline into
  ;; `\\n`: a recorded value cannot contain a line break, so it cannot forge a
  ;; line start.
  (let [marker (str "\n " key " ")
        i (index-of text marker)]
    (if (nil? i)
      ;; The first field has no leading newline — it follows the opening brace.
      (let [head (str "{" key " ")]
        (if (starts-with? text head) (count head) nil))
      (+ i (count marker)))))

(defn read-cassette
  "A cassette as a map: {:status :body :stream :request-body}.

   nil when the file is absent — the caller decides whether that is fatal. It
   is fatal in `replay` and merely a fallback in a script that offers to
   record."
  ([name] (read-cassette dir name))
  ([dir name]
  (if (not (exists? dir name))
    nil
    (let [text (File/read! (path dir name))]
      {:status (cassette-int text ":status")
       :stream (= "true" (cassette-token text ":stream"))
       :request-body (cassette-string text ":request")
       :body (cassette-string text ":body")}))))

(defn- cassette-token
  "The bare token following `key`, up to the next whitespace."
  [text key]
  (let [i (read-field text key)]
    (if (nil? i)
      nil
      (let [rest (subs text i)
            j (index-of rest "\n")]
        (trim (if (nil? j) rest (subs rest 0 j)))))))

(defn- cassette-int
  "An integer field, or nil when it is absent or not a number.

   nil rather than a raise: a malformed cassette is DATA that arrived wrong,
   and `replay` turns it into a named error. Raising here instead killed the
   unlinked provider process, so the collector saw nothing at all and the page
   waited the full 180s before reporting a generic timeout — a hand-edited file
   presenting as a slow model."
  [text key]
  (let [t (cassette-token text key)]
    (if (nil? t)
      nil
      (let [n (Integer/parse (trim t))]
        ;; `Integer.parse` answers `:error` or `{int, rest}`; a trailing rest
        ;; means the token was not purely a number.
        (if (and (tuple? n) (= "" (elem n 1))) (elem n 0) nil)))))

(defn- cassette-string
  "The quoted string following `key`, unescaped.

   Both long fields (the request body and the response body) are stored as one
   JSON-escaped string on a single line, so a scan for the closing quote that
   honours backslash escapes reads them exactly. That is the same rule
   `spell.provider/take-until-unescaped-quote` implements for provider bodies —
   and it is deliberately NOT reimplemented here."
  [text key]
  (let [i (read-field text key)]
    (if (nil? i)
      nil
      (let [after (subs text i)]
        (if (not (starts-with? after "\""))
          nil
          (unescape (up-to-unescaped-quote (subs after 1))))))))

(defn- up-to-unescaped-quote
  "The RAW run up to the first unescaped quote \u2014 escapes intact.

   `spell.provider` has the same walk, and reusing it was tried first. It makes
   provider and cassette require each other, and the load order of a cycle is
   not something a manifest can state \u2014 it is a runtime error the first time a
   fresh VM loads them in the wrong order.

   So the dependency points ONE way: cassette knows about provider (it replays
   provider responses), provider knows nothing about cassette beyond a call
   through the seam. Twelve lines of duplicated walk is the price, and it buys
   an acyclic graph. Kept deliberately, and noted so nobody re-merges them.

   NB this returns the run STILL ESCAPED, where the provider's version decodes
   as it goes. Different jobs: this feeds `unescape`, which is the exact
   inverse of `escape` below, so the round trip is one pair of functions rather
   than two halves of different pairs."
  [s]
  ;; Scans by BYTE OFFSET, jumping straight to the next interesting byte.
  ;;
  ;; The obvious form — `(subs s i (+ i 1))` in a loop against `(count s)` — is
  ;; QUADRATIC here, and the cassettes are 100KB: `count` is `String.length`
  ;; (walks the whole string) and `subs` walks to the offset, both called per
  ;; character. Reading one recorded stream cost on the order of 10^10 steps.
  ;;
  ;; `:binary.match` finds the next `\\` or `\"` in one pass of optimised C, so
  ;; the whole scan is linear in the body and skips everything between escapes.
  ;;
  ;; Byte offsets, not character offsets, and that distinction is load-bearing:
  ;; the two bytes being sought are ASCII, and no byte of a multi-byte UTF-8
  ;; sequence can collide with them (continuation bytes are all >= 0x80). So a
  ;; byte scan cannot land inside a character, and `binary/part` — which is
  ;; itself byte-based — slices exactly what was measured. Mixing a codepoint
  ;; index into a byte slice is the bug this comment exists to prevent.
  ;; ONE `:binary.match` per escape, over a SUFFIX of the string — never a
  ;; re-scoped scan of the whole thing.
  ;;
  ;; Three shapes were measured against a real 100KB cassette:
  ;;
  ;;   (subs s i (+ i 1)) per character   quadratic — minutes
  ;;   match with a :scope starting at N  43s — `:scope` still walks from 0
  ;;   match on a suffix binary (below)   3ms
  ;;
  ;; A suffix produced by `binary/part` is a SUB-BINARY: the BEAM shares the
  ;; original's bytes instead of copying them, so taking one per escape is O(1)
  ;; and the whole scan is linear in the body.
  ;;
  ;; Byte offsets, not character offsets, and that distinction is load-bearing:
  ;; the two bytes sought are ASCII, and no byte of a multi-byte UTF-8 sequence
  ;; can collide with them (continuation bytes are all >= 0x80). So the scan
  ;; cannot land inside a character, and `binary/part` — itself byte-based —
  ;; slices exactly what was measured. Mixing a codepoint index into a byte
  ;; slice is the bug this comment exists to prevent.
  (loop [rest s at 0]
    (let [hit (binary/match rest (list "\\" "\""))]
      (cond
        (= :nomatch hit) nil

        ;; A backslash consumes the next byte whatever it is, so an escaped
        ;; quote cannot terminate the string.
        (= "\\" (binary/part rest (elem hit 0) 1))
        (let [skip (+ (elem hit 0) 2)]
          (recur (binary/part rest skip (- (erlang/byte_size rest) skip)) (+ at skip)))

        :else (binary/part s 0 (+ at (elem hit 0)))))))

(defn unescape
  "JSON string escapes, decoded. The exact inverse of `escape`.

   Public because it is one HALF of a pair whose inverseness is the property
   worth testing, and a pair tested only through a file round trip hides which
   half is wrong.

   ONE left-to-right walk, consuming each escape PAIR atomically.

   ── why not a chain of replacements ───────────────────────────────────────

   It was five sequential `replace-str` calls, and no ORDER of them is correct:
   each one rewrites text the previous ones produced. Take a body containing a
   literal backslash, the letter n, then a real newline — which every provider
   response with an embedded `\\n` in its JSON actually contains:

     raw       \\ n <LF>
     escaped   \\ \\ n \\ n      (correct: backslash doubled, newline as \\n)
     decoded   \\ <LF> <LF>     (WRONG: the `\\n` rule fired on bytes the
                                 backslash rule had not yet collapsed)

   So replay was not byte-exact, and the corruption INSERTS A NEWLINE — which
   in an SSE body splits a frame, and `parse-sse-deltas` then drops or mangles
   the token. A cassette that reads back subtly wrong is worse than one that
   fails to read: the test still runs, against bytes no provider ever sent.

   A walk cannot have this bug: it consumes `\\` plus one character and moves
   past both, so nothing it emits is ever re-examined."
  [s]
  (if (nil? s)
    nil
    ;; SPLIT on the escape character, then fold the pieces with one bit of
    ;; state. Linear, and atomic where it matters.
    ;;
    ;; The per-character walk this replaces was correct and unusably slow: it
    ;; called `count` (which is `String.length`, a full walk) and `subs` (which
    ;; walks to the offset) on EVERY character, so decoding a real 100KB
    ;; cassette took 46 SECONDS — paid by every test that replays one.
    ;;
    ;; A chain of `replace-str` calls is the fast wrong answer: each rewrites
    ;; text the previous ones produced, which is how a literal backslash-n
    ;; followed by a real newline decoded to two newlines.
    ;;
    ;; ── why the fold carries a flag ────────────────────────────────────────
    ;;
    ;; Splitting alone is not enough, and the counterexample is the same input
    ;; that broke the replacement chain. `\\ n <LF>` escapes to `\\\\ n \\ n`,
    ;; which splits into `["" "" "n" "n"]`. The EMPTY piece is two backslashes
    ;; meeting — an escaped backslash — and the piece after it therefore begins
    ;; with ordinary text, NOT with an escape character. Decoding it as one
    ;; turns the literal `n` into a newline.
    ;;
    ;; So: an empty piece emits a backslash and marks the next piece literal.
    ;; That single bit is exactly the atomicity the character walk had.
    (let [pieces (vec (binary/split s "\\" (list :global)))
          folded (reduce (fn [acc piece]
                           (cond
                             (get acc :literal)
                             {:out (conj (get acc :out) piece) :literal false}

                             (= "" piece)
                             {:out (conj (get acc :out) "\\") :literal true}

                             :else
                             {:out (conj (get acc :out) (decode-escape piece))
                              :literal false}))
                         {:out [(first pieces)] :literal false}
                         (drop 1 pieces))]
      (join "" (get folded :out)))))

(defn- decode-escape
  "One piece of a backslash-split string whose first character was escaped.

   An escape this table does not know keeps its backslash rather than losing it
   silently: a field written by a newer version should read back as itself, not
   as its payload with the marker eaten."
  [piece]
  (let [e (binary/part piece 0 1)
        tail (binary/part piece 1 (- (erlang/byte_size piece) 1))]
    (str (cond
           (= e "n") "\n"
           (= e "r") "\r"
           (= e "t") "\t"
           (= e "\"") "\""
           :else (str "\\" e))
         tail)))

(defn escape
  "A string as one escaped line. Order matters: backslashes FIRST, or the
   escapes this function introduces would themselves be escaped."
  [s]
  (-> (str s)
      (replace-str "\\" "\\\\")
      (replace-str "\"" "\\\"")
      (replace-str "\n" "\\n")
      (replace-str "\r" "\\r")
      (replace-str "\t" "\\t")))

;; ── writing ─────────────────────────────────────────────────────────────────

(defn render
  "A cassette as EDN text.

   Field order is fixed and the two long strings come last, so a human opening
   the file sees what it IS (name, provider, when, streaming) before the wall of
   recorded bytes."
  [{:keys [name provider stream request body status]}]
  (str "{:name \"" (escape name) "\"\n"
       " :provider \"" (escape (or provider "unknown")) "\"\n"
       " :recorded \"" (DateTime/to_iso8601 (DateTime/utc_now)) "\"\n"
       " :stream " (if stream "true" "false") "\n"
       " :status " (str status) "\n"
       " :request \"" (escape request) "\"\n"
       " :body \"" (escape body) "\"}\n"))

(defn write!
  "Write a cassette to disk; returns its path."
  [entry]
  (File/mkdir_p! dir)
  (let [p (path (get entry :name))]
    (File/write! p (render entry))
    p))

;; ── replaying ───────────────────────────────────────────────────────────────

(defn replay
  "The recorded response for `name`, in `send-request`'s shape.

   `request` is accepted and ignored on purpose — see the header on why
   matching is not strict. Two things ARE checked, and both because their
   failure mode is silence:

     * the cassette must be WELL-FORMED. A truncated or hand-edited file whose
       `:status` is not a number or whose `:body` never terminates used to read
       back as `{:status nil :body nil}` — which `send-request` passed on as a
       200 with an empty body, decoding to \"the model said nothing\".
     * the STREAMING shape must match. Replaying a single body to a caller
       expecting SSE deltas produces no deltas at all, which reads as a broken
       provider rather than as a wrong cassette."
  ([name request stream?] (replay dir name request stream?))
  ([dir name request stream?]
  (let [c (read-cassette dir name)]
    (cond
      (nil? c)
      {:error {:no-cassette name :looked-in (path dir name)}}

      (not (empty? (malformed c)))
      {:error {:malformed-cassette name
               :missing (malformed c)
               :looked-in (path dir name)
               :note "re-record it: a partially readable cassette replays as an empty answer"}}

      (not (= stream? (get c :stream)))
      {:error {:cassette-shape name
               :recorded (if (get c :stream) "stream" "single")
               :wanted (if stream? "stream" "single")
               :note "re-record with the same streaming mode, or ask for the other one"}}

      :else
      {:status (get c :status) :body (get c :body)}))))

(defn- malformed
  "The required fields a parsed cassette is missing, as strings.

   `:stream` is deliberately NOT here: it defaults to false, and a cassette
   that omits it is an old one recorded before the field existed, which
   replays correctly as a single turn."
  [c]
  (filterv (fn [f] (not (nil? f)))
           [(if (nil? (get c :status)) "status" nil)
            (if (nil? (get c :body)) "body" nil)]))

(defn recorded-request
  "The request BODY a cassette recorded, as text.

   Exposed so a test can assert what we SENT — the half that had no coverage
   when the served page silently offered the model no tools."
  [name]
  (let [c (read-cassette name)]
    (if (nil? c) nil (get c :request-body))))

;; ── the canned answer ───────────────────────────────────────────────────────

(defn canned
  "A synthetic response body, for `:fake`.

   Not a cassette: no file, no recording, no fidelity claim. It exists so a
   check can run with no fixtures at all, and it answers in the provider's own
   JSON shape so the same decoders run.

   `stream?` produces SSE frames, because a caller that asked to stream must
   receive deltas — answering it with a single JSON object is the exact
   mismatch `replay` refuses."
  [messages stream?]
  (let [prompt (get (last messages) :content "")
        answer (str "A contract is one term that says what the server owns "
                    "and what the page may ask of it — you asked: \""
                    ;; This module's OWN escaper, not `spell.provider`'s. They
                    ;; escape the same table, and reaching across would make
                    ;; the two namespaces require each other — a cycle whose
                    ;; load order no manifest can state. See
                    ;; `up-to-unescaped-quote` for the same decision.
                    (escape prompt) "\"")]
    (if stream?
      (str (join "" (map (fn [w] (str "data: {\"choices\":[{\"delta\":{\"content\":\""
                                      w " \"}}]}\n"))
                         (split answer " ")))
           "data: [DONE]\n")
      (str "{\"id\":\"fake\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\""
           ",\"content\":\"" answer "\"},\"finish_reason\":\"stop\"}]}"))))
