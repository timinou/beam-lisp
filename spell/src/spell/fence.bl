; spell.fence — the FENCE cluster: run code you do not trust, with a
; bounded blast radius.
;
; Cluster contract: invoke a fn that may throw or wedge; receive
; {:ok v} | {:error …} | {:timeout …}; the caller is never blocked past
; the deadline, and nothing the callee did can tear the caller's state.
;
; spell.jank built this with siglongjmp out of running C++ frames and
; disclosed the lie: "leaves C++ frames without running their
; destructors … after a timeout, treat the image as SUSPECT rather than
; merely 'that call failed'". On the BEAM the callee is a separate
; process with its own heap — killing it releases everything it held.
; There is no suspect-image caveat to carry.
;
; The second jank asymmetry also deletes: safe-on-event deliberately
; had NO deadline, because on a single thread a render deadline would
; abort a healthy 6.2s HTTP call mid-flight. Here every handler runs in
; its own process, so the deadline applies uniformly — the documented
; exception was a scheduling artifact, not a principle.
;
; Stdlib candidacy: this is language-worthy (any app needs it). It is
; written here in pure beam-lisp to prove the language can express it;
; if it proves hot, it can move to priv/fence.bl or an rt.ex prim
; without changing the contract.
;
; Implementation note, earned the hard way in this repo: Task.async is
; the WRONG primitive for a fence. It links the callee to the caller,
; so a callee that crashes before the caller enters Task.yield's trap
; window takes the caller down with it — the exact failure a fence
; exists to prevent (observed: EXIT propagated into the demo runner).
; spawn + monitor is the honest shape: no link, the callee's death
; arrives as a plain message you pattern-match like any other.

(ns spell.fence)

(defn fence
  "Run (apply f args) in a separate, unlinked, monitored process with
   a deadline. Returns {:ok v} | {:error e} | {:timeout ms}.
   On :timeout the runaway process is brutally killed — per-process
   heap, no destructors to skip, nothing leaks."
  ([f args] (fence f args 5000))
  ([f args timeout-ms]
   (let [tag (erlang/make_ref)
         me  (erlang/self)
         pid (erlang/spawn
               (fn []
                 (let [r (try {:ok (apply f (Enum/to_list args))}
                           (catch e {:error e}))]
                   ; {tag, result} — no tuple literal yet (blocker 3)
                   (erlang/send me (erlang/list_to_tuple (list tag r))))))
         mon (erlang/monitor :process pid)]
     (loop []
       (receive
         ; callee replied: [tag r] — a stale reply from an earlier,
         ; timed-out fence is skipped by recurring on tag mismatch.
         ; NB: a monitor fires DOWN on EVERY exit, :normal included,
         ; so the reply path must demonitor+flush — otherwise the DOWN
         ; outlives this fence in the mailbox and the NEXT fence's
         ; receive matches it (observed: fence N+1 reported fence N's
         ; :normal exit as its own error).
         [t r] (if (= t tag)
                 (do (erlang/demonitor mon (list :flush)) r)
                 (recur))
         ; callee died before replying (exit signals are not catchable
         ; by the callee's own try — e.g. it called erlang/exit)
         [:DOWN _ :process _ reason] {:error {:exit reason}}
         (after timeout-ms
           (do (erlang/exit pid :brutal_kill)
               (erlang/demonitor mon (list :flush))
               {:timeout timeout-ms})))))))

(defn fence-value
  "fence + a keep-last-good policy: return the fresh value on success,
   `fallback` on any failure. This is safe-render's 'keep the last good
   tree' rule, factored off the UI so any cluster can use it."
  ([f args fallback] (fence-value f args 5000 fallback))
  ([f args timeout-ms fallback]
   (let [r (fence f args timeout-ms)]
     (if (:ok r) (:ok r) fallback))))
