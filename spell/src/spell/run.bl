; spell/src/spell/run.bl — the ONE verb that grows the machine.
;
; The model writes the SAME source a human author writes — a `(defcontract …)`
; or `(defview …)` — and this file walks the validation ladder's pure rungs:
;
;   1. read      — does the source parse as exactly one definition form?
;                  (reader only; `defn`/`def` are classified but never
;                  evaluated HERE — code gets the fence rung, in Elixir)
;   2. machine   — does it AGREE with everything registered so far?
;   3. compile   — verse's own diagnostics          (Elixir: Spell.Verse, W1)
;   4. ghosts    — styled selectors nothing renders (Elixir: Spell.Verse, W1)
;   5. fence     — CODE only: compile+load bounded, unlinked, with a
;                  deadline                               (Elixir: Spell.Loop, W4)
;
; ── why source, when the boundary used to be JSON ───────────────────────────
;
; The JSON proposal existed to keep model text away from the evaluator, and it
; cost the model the very notation the system is written in: a parallel
; vocabulary (kind/name/assigns/binds…) that this file then translated BACK
; into the terms an author writes by hand — two spellings of one idea, and the
; translation layer was where the defects lived (an invented key here is
; self-consistent everywhere downstream).
;
; Source removes the translation. The safety property is kept by construction:
; the reader is not the evaluator, handler BODIES are sanitized to their reply
; tags before the term is built (a contract declares an event's SHAPE — what
; the handler DOES is server code, and a rendering tool is not the path that
; writes it), and the atom guard (PLAN-009) bounds what reading can intern.
;
; ── the asymmetry, kept ─────────────────────────────────────────────────────
;
; Orphan binding and unhandled fire are ERRORS: the page reads or fires a name
; nobody publishes or handles, so it is broken NOW. Unrendered assign and dead
; template are WARNINGS: a machine grown one definition at a time is supposed
; to pass through incomplete states, and a tool that refuses them cannot be
; used for the thing it exists to do.

(ns spell.run
  (:require [spell.machine :refer [register-contract register-view
                                   views view-signals view-locals report errors warnings]]
            [spell.contract :refer [parse parse-view]]
            [spell.seam :refer [reply-tags assert-enumerable!]]))

;; ── rung 1: read + classify ─────────────────────────────────────────────────

(defn- read-one-form
  "The source as ONE data form, or the refusal reason.

   `read-data` is the reader, not the evaluator: what comes back is inert
   data, and the atom guard has already bounded what reading it could intern."
  [source]
  (try {:ok (read-data source)}
       (catch e {:error (str "the source does not read: " (ex-message e))})))

(defn- classify
  "What the form claims to be: `{:contract name :clauses clauses}` | `{:view
   name :clauses clauses}` | `{:error message}`.

   Classification is by HEAD SYMBOL — the two forms are the whole vocabulary,
   and anything else is not a definition this ladder can grow the machine
   with. The NAME is checked to be a symbol or keyword before it is touched:
   `(defcontract {:bundle …})` used to reach `(name nm)` with a map and throw
   OUTSIDE any refusal path — crashing the GenServer that owns the machine
   instead of answering with a rung-1 refusal."
  [form]
  (if (not (seq? form))
    {:error "a definition is a `(defcontract …)` or `(defview …)` form"}
    (let [head (first form)
          args (rest form)]
      (cond
        (and (= head (quote defcontract)) (>= (count args) 1))
        (let [nm (first args)
              clauses (rest args)]
          (cond
            (not (or (symbol? nm) (keyword? nm)))
            {:error "a definition's name is a symbol or keyword, not a map or literal"}

            ;; A model-proposed contract may not set :bundle/:root — the page's
            ;; host is the MACHINE's, and accepting an opts map here would let
            ;; a definition claim a host it cannot have. Refused rather than
            ;; dropped: silently ignoring it would let the source LIE about
            ;; what the machine does with it.
            (and (seq clauses) (map? (first clauses)))
            {:error "a proposed contract declares no opts — the page's bundle and root belong to the machine, not to a definition"}

            :else
            {:contract (keyword (name nm)) :clauses clauses}))

        (and (= head (quote defview)) (>= (count args) 1))
        (let [nm (first args)]
          (if (or (symbol? nm) (keyword? nm))
            {:view (keyword (name nm)) :clauses (rest args)}
            {:error "a definition's name is a symbol or keyword, not a map or literal"}))

        ;; ── CODE: a fn or a value, into `spell.vars` ──────────────────────
        ;;
        ;; Contracts and views declare SHAPE; this head writes CODE. The
        ;; safety difference is honest and total: a defn body runs when
        ;; called, and nothing in this file can make that inert. What the
        ;; ladder does instead (Elixir side, the fence rung): compile and
        ;; load it in a bounded, unlinked process FIRST — a syntax error, a
        ;; wedging `(def x (loop …))` initializer, or a crashing macro
        ;; expansion dies there — and journal the source only after.
        ;;
        ;; `defmacro` is REFUSED: a macro expands inside OTHER definitions'
        ;; compile, which is code-running-at-check-time — the one shape the
        ;; fence cannot bound after the fact. `defserver` likewise: it
        ;; spawns processes with handlers, not a value. Both are authoring
        ;; tools, and the person at the keyboard has `vars/` files for them.
        (and (contains? #{(quote defn) (quote defn-) (quote def)} head)
             (>= (count args) 1))
        (let [nm (first args)]
          (if (symbol? nm)
            {:code (name nm)}
            {:error "a defn/def name is a symbol"}))

        (contains? #{(quote defmacro) (quote defserver) (quote ns) (quote defmulti)
                     (quote defprotocol) (quote defrecord) (quote deftype)}
                   head)
        {:error (str "`" head "` is not something the run tool writes — "
                     "it reaches compile time or process lifetimes, which the "
                     "fence cannot bound. defn and def are the code heads.")}

        :else
        {:error (str "a definition is `(defcontract name clause…)`, "
                     "`(defview name (markup …) (style …) (binds …))`, or a "
                     "code head `(defn name [args] body…)` / `(def name value)` "
                     "— got "
                     (pr-str head))}))))

;; ── sanitizing: handler bodies are SHAPE, not behaviour ────────────────────

(defn- inert-body
  "The stub a sanitized `(on …)` carries: EXACTLY the reply tags the written
   body declared, and nothing else.

   `reply-tags` is a syntactic walk (seam.bl), so the arms a model's body
   answers with survive exactly; the COMPUTATION does not. The tag set is
   preserved rather than widened because tags determine the receive arms the
   generated page carries: a body that can only `err` must not grow an `ok`
   arm it never answers, and a fire-and-forget body declares NO reply —
   inventing one would have the page wait on a reply that never comes."
  [tags]
  (cond
    (empty? tags) :noop
    (= ["err"] tags) (list (quote err) "refused")
    (= ["ok"] tags) (list (quote ok) "accepted")
    :else (list (quote if) true
                (list (quote ok) "accepted")
                (list (quote err) "refused"))))

(defn- sanitize-contract
  "Contract clauses with every `(on …)` body replaced by its inert shape.

   Two things happen to an `(on …)` BEFORE the stub is built, and the order is
   load-bearing:

   1. `assert-enumerable!` runs on the ORIGINAL body — a body whose reply
      path the syntactic walk cannot see is refused HERE, as it is for an
      author. Checking after stubbing would check the invented stub and let a
      dynamic constructor (`((if p ok err) v)`) sail through with a declared
      reply surface the source never had.
   2. `reply-tags` measures the body, and the stub carries exactly that set.

   `(on-info …)` is REFUSED, not sanitized: those handlers are the machine's
   server-internal plumbing (deltas, verdicts, turn ends) and the walker in
   `spell.server` EXECUTES their bodies. The JSON boundary never exposed them;
   the source boundary must not either. `(assign …)` and `(push …)` are
   already pure data. An unknown head is left for `parse` to refuse — its
   error names the clause, which is the message the model needs."
  [clauses]
  (mapv (fn [clause]
          (cond
            (and (seq? clause) (= (first clause) (quote on)))
            (let [nm (nth clause 1)
                  ;; Params only when the third element is a VECTOR —
                  ;; `(on :inc (ok …))` has none, and treating its first body
                  ;; form as a param list would both lose the form and
                  ;; corrupt the stub.
                  maybe-params (nth clause 2 nil)
                  params (if (vector? maybe-params) maybe-params [])
                  body (if (vector? maybe-params) (drop 3 clause) (drop 2 clause))
                  whole (if (= 1 (count body)) (first body)
                          (cons (quote do) body))]
              (assert-enumerable! nm whole)
              ;; `reply-tags` returns a SEQ; the exact-set comparisons in
              ;; `inert-body` are against vectors, and `(= ["err"] '("err"))`
              ;; is false — which is how an err-only body grew an ok arm.
              (concat (list (quote on) nm params)
                      (list (inert-body (vec (reply-tags (vec body)))))))

            (and (seq? clause) (= (first clause) (quote on-info)))
            (throw "a definition may not carry (on-info …) — server-internal message handling is the host's plumbing, and this tool is not a path that writes server behaviour")

            :else clause))
        clauses))

(defn- check-templates!
  "Refuse a markup plane whose `(template …)` carries no markup TREE.

   `parse-view` collects the plane's FORMS without judging them — an author
   writing `.bl` gets verse's diagnostics at compile time, but a definition
   entering through `run` deserves the refusal HERE: an empty template
   compiles to an element that renders nothing, which passes every downstream
   check while showing the user a blank box. (The proposal era checked this in
   `proposal->view`; the check must not die with the proposal format.)

   The body is one or more hiccup trees — `[:tag {:attr v} …]` vectors. A
   STRING body is the old spelling, refused with the new one named: the
   string era's brace-scanning (BUG-368) is not coming back."
  [clauses]
  (mapv (fn [clause]
          (when (= (first clause) (quote markup))
            (mapv (fn [form]
                    (when (and (seq? form) (= (first form) (quote template)))
                      (let [body (drop 3 form)]
                        (when (or (empty? body)
                                  (not (every? vector? (to-list body))))
                          (throw (str "template " (nth form 1)
                                      " has no markup tree — write it as data: "
                                      "(template &x [] [:div {:class \"x\"} @status])"))))))
                  (rest clause)))
          clause)
        clauses)
  clauses)

;; ── building the term ───────────────────────────────────────────────────────
;;
;; Both paths end at the SAME `parse`/`parse-view` an author's source takes, so
;; everything downstream — the machine joins, the EDN emitters, verse — cannot
;; tell a model's definition from a hand-written one. That is the point: one
;; representation, one set of checks.

(defn- build-term
  "The classified form as a machine term, or the build error."
  [classified]
  (try
    {:ok
     (cond
       (contains? classified :contract)
       {:kind "contract"
        :name (get classified :contract)
        :term (parse (get classified :contract) {} (sanitize-contract (get classified :clauses)))}

       (contains? classified :view)
       {:kind "view"
        :name (get classified :view)
        :term (parse-view (get classified :view)
                          (check-templates! (get classified :clauses)))})}
    (catch e {:error (str (ex-message e))})))

;; ── rung 2: the machine joins ───────────────────────────────────────────────

(defn machine-findings
  "Errors and warnings for `m`, with this view's page-locals exempted.

   Locals are collected across EVERY registered view, not just the incoming
   one: a machine holding two views must not report the first view's local as
   an orphan while checking the second."
  [m]
  (let [locals (vec (distinct (mapcat view-locals (views m))))]
    {:errors (errors m locals)
     :warnings (warnings m)}))

;; ── the ladder ──────────────────────────────────────────────────────────────

(defn- rejected [rung reason m]
  {:status :rejected :rung rung :reason reason :machine m :report (report m [])})

(defn- tentative
  "`m` with the definition registered — the state to CHECK, not to keep.

   Checking a definition in isolation would miss the questions that only exist
   once it joins the others, which is the entire reason the machine
   accumulates. So it is registered first and rolled back on refusal; because
   the registry is keyed by name, rollback is simply not keeping the result."
  [m built]
  (if (= "contract" (get built :kind))
    (register-contract m (get built :term))
    (register-view m (get built :term))))

(defn validate
  "Walk the pure rungs over a definition's SOURCE. Returns {:status
   :ok|:rejected :rung … :reason … :warnings … :machine … :kind … :name …}
   where `:machine` is the state that WOULD be committed (rungs 1–2 only; the
   verse rungs live in Elixir, `Spell.Verse`)."
  [m source]
  (let [read (read-one-form source)]
    (if (contains? read :error)
      (rejected :schema {:message (get read :error)} m)
      (let [classified (classify (get read :ok))]
        (if (contains? classified :error)
          (rejected :schema {:message (get classified :error)} m)
          (if (contains? classified :code)
            ;; CODE does not touch the machine: there is nothing to join,
            ;; nothing to warn about. The fence rung (Elixir) decides.
            {:status :ok
             :kind "code"
             :name (get classified :code)
             :machine m
             :warnings []
             :report (report m [])}
            (let [built (build-term classified)]
            (if (contains? built :error)
              ;; A malformed clause throws while being built — a template with
              ;; no html, say. That is a schema fault discovered late, so it
              ;; is reported as one rather than crashing the loop.
              (rejected :schema {:message (get built :error)} m)
              (let [term (get built :ok)
                    m2 (tentative m term)
                    found (machine-findings m2)]
                (if (not (empty? (get found :errors)))
                  (rejected :machine (get found :errors) m)
                  {:status :ok
                   :kind (get term :kind)
                   :name (get term :name)
                   :machine m2
                   :warnings (get found :warnings)
                   :report (report m2 [])}))))))))))

(defn run
  "Add a contract or a view to the machine, from SOURCE.

   Returns the same map `validate` does. On refusal `:machine` is the ORIGINAL,
   unchanged — a machine that half-accepts a broken definition is worse than
   one that refuses it, because every later definition is then checked against
   a state no author ever approved."
  [m source]
  (validate m source))
