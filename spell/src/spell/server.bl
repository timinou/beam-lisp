; spell/src/spell/server.bl — the contract's BEAM half, executed.
;
; A contract declares its server behaviour AS DATA:
;
;   (on :send [text]
;     (if (blank? text)
;       (err "Say something first")
;       (do (set! @messages (append @messages {:role "user" :text text}))
;           (set! @status :thinking)
;           (ask! text)
;           (ok "accepted"))))
;
; Every other projection of that term already existed — the page's `@data`
; declarations, the contract.json sidecar, the reply tags verse checks a page
; against. The one thing missing was the projection that RUNS it, so the whole
; system could describe a server nothing executed. This namespace is that
; projection: given a contract, an event and the current assigns, it walks the
; body and answers with the reply, the new assigns, and the effects requested.
;
; ── why a walker and not `eval` ─────────────────────────────────────────────
;
; A body is data that arrives from a contract, and a contract can be proposed by
; a model (`spell.run`). Handing such a form to `eval` would give it the
; whole runtime — every module, every prim, `System/halt` included — at which
; point the four-rung ladder is checking the page while the server half is
; unguarded. So the vocabulary is CLOSED and enumerated below: the special forms
; the seam needs, plus a whitelist of pure functions. An unknown head is refused
; by name rather than resolved, because a walker that falls back to `apply` is an
; evaluator wearing a costume.
;
; The cost of that choice is honest: a body may use only what is listed here.
; When a contract needs more, the list grows deliberately — one reviewable line
; per capability — rather than by accident.
;
; ── effects, not mutation ───────────────────────────────────────────────────
;
; `set!` does not write anything global: it updates a value in the walk's own
; state, and `handle` returns the resulting assigns to its caller (the generated
; LiveView), which owns them. `push!` and `ask!` likewise only RECORD what the
; caller should do. The interpreter therefore has no ambient authority at all —
; it is a pure function of (contract, event, params, assigns) despite using an
; atom internally to accumulate, and that is what makes it testable without a
; socket, a provider or a browser.

(ns spell.server
  (:require [spell.seam :refer [handler-for]]))

;; ── the whitelist ───────────────────────────────────────────────────────────
;;
;; Pure functions a handler body may call. Deliberately small: this is the list
;; the seed contract needs plus the obvious neighbours a second contract will
;; reach for. Everything here is total on the values that cross the seam
;; (strings, numbers, keywords, maps, vectors) and none of it touches process
;; state, the filesystem or the network — those are `ask!`/`push!`, which are
;; special forms precisely so they are visible in this file rather than hidden
;; behind a function value.

(defn- bl-append
  "Append one item to the END of a sequence.

   `conj` PREPENDS on a list and appends on a vector, so a transcript built with
   `conj` on the value the browser last sent (a JSON array, read as a list)
   would silently reverse itself. `append` is the operation a contract author
   means — and it did not exist: the seed contract has called it since it was
   written, and nothing ever executed that call until this namespace did."
  [xs x]
  (conj (vec (or xs [])) x))

(def ^:private pure-fns
  {"append" bl-append
   "str" str
   "count" count
   "get" get
   "get-in" get-in
   "nth" nth
   "name" name
   "keyword" keyword
   "empty?" empty?
   "blank?" blank?
   "not" not
   "nil?" nil?
   "string?" string?
   "first" first
   "last" last
   "rest" rest
   "reverse" reverse
   "conj" conj
   "assoc" assoc
   "merge" merge
   "take" take
   "drop" drop
   "inc" inc
   "dec" dec
   "+" +
   "-" -
   "=" =
   "not=" not=
   "<" <
   ">" >})

;; ── the ONE ambient read ────────────────────────────────────────────────────
;;
;; Everything above is pure: a handler body computes over what crossed the
;; seam. `(live-vars)` is the single deliberate exception, and it is a special
;; form rather than a whitelist entry precisely so the exception is VISIBLE —
;; a reader scanning the walk sees every way a body can touch the world, and
;; this is the only one.
;;
;; It answers what is LOADED, not what is running: the names interned in
;; `BeamLisp.Env` — the environment the chat loop itself grows when it accepts
;; a definition. That is the read a live-environment panel exists to make, and
;; it is a read only: nothing here can intern, redefine or unload.

(defn- loaded-vars
  "Every loaded var in the BeamLisp environment, flat and sorted.

   One entry per var: `{:ns \"spell.server\" :name \"handle\" :kind \"fn\"}`.
   `kind` is `\"fn\"` when the name backs a `ns_defs` entry (a compiled
   definition) and `\"var\"` otherwise. Names are the namespace's public vars
   UNION its `ns_defs` keys — the union catches private `defn`s, which a panel
   about the live environment has no business hiding; a private plain `def`
   (no `ns_defs` entry, not public) does not appear, and this docstring is the
   place that limitation is recorded rather than a silent gap.

   Sorted by `ns/name` so the rendered list is stable between refreshes: ETS
   match order is term order, and a panel that reshuffles on every mount reads
   as churn that did not happen.

   The values are all strings — the result crosses the seam as an assign and
   is JSON-encoded by the bridge, so nothing here may be an atom, a tuple or
   a fn."
  []
  (sort-by (fn [v] (str (get v :ns) "/" (get v :name)))
           (mapcat
             (fn [ns]
               (let [defs (Elixir.BeamLisp.Env/ns_defs ns)
                     fn-names (set (keys defs))
                     names (distinct (concat (Elixir.BeamLisp.Env/public_names ns)
                                             (keys defs)))]
                 (map (fn [nm]
                        {:ns ns
                         :name nm
                         :kind (if (contains? fn-names nm) "fn" "var")})
                      names)))
             (Elixir.BeamLisp.Env/namespaces))))

;; ── the walk ────────────────────────────────────────────────────────────────

(defn- assign-name
  "The assign a `@name` form reads. `@name` reads as `(deref name)`, so the head
   is checked by the caller and this only takes the symbol apart."
  [form]
  (cond
    (and (seq? form) (= (first form) (quote deref))) (name (second form))
    (symbol? form) (name form)
    :else (throw (ex-info "spell.server: not an assign reference" {:form form}))))

(defn- lookup
  "A symbol's value from the walk env (handler params, on-info bindings).

   An unbound symbol THROWS rather than resolving to nil: a body that reads a
   parameter the wire never sent is a seam defect, and nil would turn it into a
   quiet empty message — exactly the failure this contract's own comment records
   having been caught in review once already."
  [sym env]
  (let [k (name sym)]
    (if (contains? env k)
      (get env k)
      (throw (ex-info "spell.server: unbound name in handler body"
                      {:name k :bound (vec (sort (keys env)))})))))

(defn- walk
  "Evaluate one form of a handler body. `st` is an atom holding
   {:assigns :pushes :ask :reply}; `env` binds the handler's parameters."
  [form env st]
  (cond
    (seq? form)
    (let [head (first form)
          hd (if (symbol? head) (name head) nil)]
      (cond
        ;; ── special forms ──────────────────────────────────────────────────
        (= hd "quote") (second form)

        (= hd "if")
        (if (walk (second form) env st)
          (walk (nth form 2 nil) env st)
          (walk (nth form 3 nil) env st))

        (= hd "do")
        (reduce (fn [_ f] (walk f env st)) nil (rest form))

        ;; `and`/`or` must SHORT-CIRCUIT, so they cannot be whitelist entries:
        ;; a function call evaluates every argument first, which for
        ;; `(and (map? m) (get m :k))` is merely wasteful but for
        ;; `(and text (blank? text))` changes the answer.
        (= hd "and")
        (reduce (fn [acc f] (if acc (walk f env st) acc)) true (rest form))

        (= hd "or")
        (reduce (fn [acc f] (if acc acc (walk f env st))) nil (rest form))

        ;; `@name` — read a server-owned assign.
        (= hd "deref")
        (get (get (deref st) :assigns {}) (assign-name form))

        ;; `(set! @name value)` — the ONLY way a body changes state, and it
        ;; changes only the walk's copy. The caller receives the result.
        (= hd "set!")
        (let [nm (assign-name (second form))
              v (walk (nth form 2 nil) env st)]
          (swap! st (fn [s] (assoc s :assigns (assoc (get s :assigns {}) nm v))))
          v)

        ;; `(push! @name payload)` — a transient effect. Recorded in order;
        ;; the caller pushes them after the reply, so a push cannot overtake
        ;; the reply that explains it.
        (= hd "push!")
        (let [nm (assign-name (second form))
              payload (walk (nth form 2 nil) env st)]
          (swap! st (fn [s] (assoc s :pushes (conj (get s :pushes []) {:name nm :payload payload}))))
          nil)

        ;; `(ask! text)` — the provider turn. Recorded, never performed here:
        ;; the interpreter must stay free of ambient authority, and the caller
        ;; is the process that owns the mailbox the answer streams back to.
        (= hd "ask!")
        (let [text (walk (second form) env st)]
          (swap! st (fn [s] (assoc s :ask text)))
          nil)

        ;; `(live-vars)` — read the loaded vars of the BeamLisp environment.
        ;; The walker's one ambient capability; see `loaded-vars` above for why
        ;; it is a special form and not a whitelist entry.
        (= hd "live-vars")
        (if (empty? (rest form))
          (loaded-vars)
          (throw (ex-info "spell.server: live-vars takes no arguments" {:form form})))

        ;; `(ok v)` / `(err v)` — the correlated reply. These are the tags
        ;; `spell.seam/reply-tags` enumerates and the page's receive arms
        ;; decode; the two cannot disagree because both read this same form.
        (or (= hd "ok") (= hd "err"))
        (let [v (walk (second form) env st)
              reply {:tag hd :value v}]
          (swap! st (fn [s] (assoc s :reply reply)))
          reply)

        ;; ── everything else: a whitelisted pure call ───────────────────────
        :else
        (let [f (get pure-fns hd)]
          (if (nil? f)
            (throw (ex-info "spell.server: call not permitted in a handler body"
                            {:head hd
                             :permitted (vec (sort (keys pure-fns)))
                             :note "special forms: if do and or quote set! push! ask! ok err live-vars"}))
            (apply f (vec (map (fn [a] (walk a env st)) (rest form))))))))

    (vector? form) (mapv (fn [f] (walk f env st)) form)

    (map? form)
    (reduce (fn [m k] (assoc m k (walk (get form k) env st))) {} (keys form))

    (symbol? form) (lookup form env)

    :else form))

;; ── the API ─────────────────────────────────────────────────────────────────

(defn- initial-assigns
  "The assigns a fresh connection starts from: each declared assign's `:initial`,
   which is nil when the contract did not give one."
  [c]
  (reduce (fn [m k] (assoc m (name k) (get-in c [:assigns k :initial])))
          {}
          (keys (get c :assigns {}))))

(defn seed-assigns
  "The mount seed: declared initials, overridden by anything the caller already
   holds. Exposed because a LiveView's `mount/3` needs exactly this and should
   not re-derive it from the contract by hand."
  [c held]
  (merge (initial-assigns c) (or held {})))

(defn mount-event
  "The event a contract wants run once at mount, or nil.

   Declared in the contract's opts as `:mount-event :refresh`. The generated
   LiveView runs it after seeding, through the SAME `handle` walk a page event
   takes — so the state a page should open with is computed by the contract's
   own handler, not by a seeding path that could disagree with it. This is how
   `@vars` is populated before the first render, and again on every remount
   (the browser reloads when the machine grows, so the growth path and the
   first-load path are one)."
  [c]
  (get-in c [:opts :mount-event]))

(defn params-for
  "The parameter names event `ev` declares, in order.

   Needed because the wire is POSITIONAL: `fire :send @draft` compiles to
   `pushEvent(\"send\", <the draft string>)` — the emitted signal carries
   `:params [:st/paramlist]` and no body template, so the runtime sends the raw
   argument. Names live only here, which is why binding them is the caller's
   job and this is how it asks."
  [c ev]
  (vec (get-in c [:events (keyword ev) :params] [])))

(defn bind-params
  "Bind a wire payload to an event's declared parameter names.

   Three shapes, because three shapes actually arrive:
     * a map keyed by the parameter names   — a `send emit` with a body template
     * a vector/list of positional values   — a multi-argument fire
     * a bare value with exactly one param  — `fire :send @draft` (the seed's)

   A payload that fits none of them is refused by name rather than bound to
   something plausible: a handler reading an empty `text` because the binder
   guessed is the defect this contract's history already records."
  [c ev payload]
  (let [ps (params-for c ev)]
    (cond
      (empty? ps) {}

      (map? payload)
      (reduce (fn [m p] (assoc m p (or (get payload p) (get payload (keyword p))))) {} ps)

      (vector? payload)
      (reduce (fn [m i] (assoc m (nth ps i) (nth payload i nil)))
              {}
              (range (count ps)))

      (= 1 (count ps)) {(first ps) payload}

      :else
      (throw (ex-info "spell.server: cannot bind wire payload to declared params"
                      {:event (name ev) :params ps :payload payload})))))

(defn handle
  "Run event `ev` against `assigns` with the wire `payload`.

   Answers a map — never a mutation:

     {:status \"ok\"            ; or \"no-handler\"
      :reply {:tag \"ok\" :value \"accepted\"}   ; nil when the body never replied
      :assigns {…}             ; the caller's new state
      :pushes [{:name \"token\" :payload {…}}]
      :ask \"…\"}               ; a provider turn the caller should start

   `:status \"no-handler\"` is a real answer, not an error: `spell.seam/handler-for`
   documents that a page may fire an event reaching nothing, and the caller
   (which owns the socket) is the layer that decides whether that is a bug or a
   404."
  [c ev payload assigns]
  (let [body (handler-for c ev)]
    (if (nil? body)
      {:status "no-handler" :reply nil :assigns assigns :pushes [] :ask nil}
      (let [st (atom {:assigns (or assigns {}) :pushes [] :ask nil :reply nil})
            env (bind-params c ev payload)]
        (walk body env st)
        (let [s (deref st)]
          {:status "ok"
           :reply (get s :reply)
           :assigns (get s :assigns)
           :pushes (get s :pushes)
           :ask (get s :ask)})))))

;; ── server-internal messages ────────────────────────────────────────────────

(defn- info-clauses [c] (get c :infos []))

(defn- pattern-match
  "Bind `pattern` against `message`, or nil when they do not match.

   A pattern is a vector whose head is a literal tag: `[:delta id chunk]`
   matches `[:delta \"m1\" \"hello\"]`, binding id and chunk. Only the head is
   matched — the rest are binders — which is the whole grammar `on-info` uses
   and no more. Arity must agree: `[:done id]` must not swallow
   `[:done id extra]`, or a protocol change would arrive as a silent truncation."
  [pattern message]
  (if (or (not (vector? pattern))
          (not (= (count pattern) (count message)))
          (not (= (first pattern) (first message))))
    nil
    (reduce (fn [m i]
              (let [p (nth pattern i)]
                (if (symbol? p)
                  (assoc m (name p) (nth message i))
                  m)))
            {}
            (range 1 (count pattern)))))

(defn handle-info
  "Run the `on-info` clause matching `message` (a vector like `[:delta id text]`).

   Provider streaming needs no second transport precisely because of this: the
   tokens arrive as ordinary BEAM messages and are decoded by the same contract
   that decodes the page's events. `:status \"unmatched\"` when no clause matches
   — the caller keeps its assigns and can log; a message the contract does not
   describe must not silently change state."
  [c message assigns]
  (let [clauses (info-clauses c)
        hit (first (filter (fn [cl] (not (nil? (pattern-match (get cl :pattern) message))))
                           clauses))]
    (if (nil? hit)
      {:status "unmatched" :assigns assigns :pushes [] :ask nil}
      (let [st (atom {:assigns (or assigns {}) :pushes [] :ask nil :reply nil})
            env (pattern-match (get hit :pattern) message)]
        (walk (get hit :body) env st)
        (let [s (deref st)]
          {:status "ok"
           :assigns (get s :assigns)
           :pushes (get s :pushes)
           :ask (get s :ask)})))))
