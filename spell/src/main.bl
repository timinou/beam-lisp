; main — composition root for the spell study.
;
; Today this runs HEADLESS and proves the three clusters that need no
; new language substrate: VIEW (pure data), FENCE (bounded failure),
; STORE (reload-proof named state). The clusters that need language
; work — BOUNDARY (EDN data reader), PROCESS (port wrapper), SELF
; (hotswap API) — are specified in spell/README.md and stubbed where
; they will live.
;
; Run:  mix beam_lisp.run spell/src/main.bl

(ns main (:require [core] [spell.ui] [spell.fence] [spell.store]))

(defn banner [s] (IO/puts (str "\n══ " s " ══")))

(banner "VIEW — a UI tree is pure data, realization forces thunks+refs")

(def counter (atom 41))

(def tree
  (spell.ui/el {:id "root" :sizing spell.ui/grow :dir :top-to-bottom
                :padding 20 :gap 10 :bg (:bg spell.ui/palette)}
    (spell.ui/text "spell.beam — harness study" {:size 22 :color (:text spell.ui/palette)})
    ; a thunk: deferred construction
    (fn [] (spell.ui/text (str "counter via thunk: " @counter) {:color (:dim spell.ui/palette)}))
    ; a ref: deferred read
    counter
    nil)) ; nil children drop

(let [realized (spell.ui/realize tree)]
  (IO/puts (str "children realized: " (count (:children realized))))
  (IO/puts (str "thunk became:      " (:text (nth (:children realized) 1))))
  (IO/puts (str "ref became:        " (nth (:children realized) 2))))

(banner "VIEW — grapheme-correct editing (jank disclosed off-by-one here)")

(let [s "ab🚩cd"]
  (IO/puts (str "s = \"" s "\"  graphemes: " (spell.ui/gcount s)))
  (IO/puts (str "insert X at 3:  " (spell.ui/ginsert s 3 "X")))
  (IO/puts (str "delete [2,3):   " (spell.ui/gdelete s 2 3)))
  (IO/puts (str "slice  [0,3):   " (spell.ui/gslice s 0 3))))

(banner "FENCE — ok / error / timeout, caller never torn")

(IO/puts (str "success:  " (pr-str (spell.fence/fence (fn [a b] (+ a b)) [1 2]))))
(let [r (spell.fence/fence (fn [] (throw "boom")) [])]
  (IO/puts (str "thrown:   {:error " (pr-str (ex-message (:error r))) "}")))
(IO/puts (str "timeout:  " (pr-str (spell.fence/fence (fn [] (loop [] (recur))) [] 300))))
(IO/puts "— the wedged loop was brutally killed; the VM did not notice")
(IO/puts (str "keep-last-good: " (pr-str (spell.fence/fence-value (fn [] (throw "bad swap")) [] :last-good))))

(banner "STORE — named state, idempotent creation (the honest defonce)")

(IO/puts (str "ensure:   " (pr-str (spell.store/state-ensure :convo []))))
(IO/puts (str "ensure×2: " (pr-str (spell.store/state-ensure :convo [:this-is-ignored]))))
(spell.store/state-swap! :convo (fn [s] (conj s {:role :user :text "hello"})))
(IO/puts (str "after swap: " (pr-str (spell.store/state-get :convo))))

(banner "STORE — wire tap (tests assert at the wire, not at internals)")

(spell.store/tap! :frame-log {:cmd :frame :tree (spell.ui/text "frame one")})
(spell.store/tap! :frame-log {:cmd :frame :tree (spell.ui/text "frame two")})
(IO/puts (str "tap holds:          " (count (spell.store/state-get :frame-log)) " frames"))
(IO/puts (str "tap saw 'frame two': " (pr-str (spell.store/tap-contains? :frame-log "frame two"))))
(IO/puts (str "tap saw 'frame zzz': " (pr-str (spell.store/tap-contains? :frame-log "frame zzz"))))

(banner "done")
(IO/puts "clusters verified: VIEW, FENCE, STORE. Blocked clusters: see spell/README.md")
