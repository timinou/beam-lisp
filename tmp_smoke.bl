(ns tmp.smoke
  (:require [proc.pipeline :as pipeline]))

(println "loaded pipeline")

(let [c (pipeline/pipeline-clause
          '(pipeline
             (from (range 3))
             (stage :a (fn [e] e) {:concurrency 2})
             (batch :pan 2 {:timeout 50})
             (on-lag :block)
             (on-error :requeue))
          {:name 'x})]
  (println (Kernel/inspect (keys c)))
  (println (Kernel/inspect (:init c)))
  (println (Kernel/inspect (first (:prelude c)))))

(defn- refusal [form]
  (try (pipeline/pipeline-clause form {:name 'x}) (catch e (str (get e :message)))))

(println "unknown entry:" (refusal '(pipeline (nope 1) (from (range 3)))))
(println "no from:     " (refusal '(pipeline (stage :a f))))
(println "concurrency0:" (refusal '(pipeline (from (range 3)) (stage :a f {:concurrency 0}))))
(println "no fn:       " (refusal '(pipeline (from (range 3)) (stage :a))))
(println "bad lag:     " (refusal '(pipeline (from (range 3)) (stage :a f) (on-lag :nope))))
