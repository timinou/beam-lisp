; Opt-in native lifecycle regression; run on a private display, never a user's.
; Default: programmatic close. WRY_CLOSE_BY_WM=1: ask the private WM to close
; the window after READY, exercising the GTK close-request path too.
(ns wry.closed-test (:require [wry]))
(defn ensure! [value message]
  (when-not value (throw (ex-info message {}))))
(ensure! (wry/available?) "Wry backend required for lifecycle regression")
(let [window (wry/open {:title "Wry lifecycle regression" :html "<h1>Close regression</h1>"})]
  (try
    (ensure! (= true (wry/eval window "void 0")) "live eval must queue")
    (println "WRY_READY")
    (if (= "1" (System/get_env "WRY_CLOSE_BY_WM"))
      (loop [remaining 100]
        (when (try (wry/eval window "void 0") true (catch _ false))
          (ensure! (> remaining 0) "OS close was not observed within ten seconds")
          (Process/sleep 100)
          (recur (dec remaining))))
      (wry/close window))
    (ensure! (try (wry/eval window "void 0") false (catch _ true))
             "closed eval must raise, not return an error value")
    (ensure! (try (wry/resize window 200 200) false (catch _ true))
             "closed resize must raise")
    (wry/close window)
    (println "WRY_CLOSED_OK")
    (finally (wry/close window))))
