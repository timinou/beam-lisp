(ns browser.port.owner-close-test (:require [browser.port :as port]))

(deftest close-explicitly-acknowledges-a-profile-save
  (let [root (str (System/tmp_dir!) "/bl-native-close-" (erlang/unique_integer (list :positive)))
        p (port/open)]
    (try
      (port/request p {"op" "launch" "profile" (str root "/profile") "runtime" (str root "/runtime")
                       "chromium" (System/get_env "CHROMIUM") "xvfb" (System/get_env "XVFB") "vnc" (System/get_env "X11VNC")})
      (port/close p)
      (is (File/exists? (str root "/profile/.bl-saved")))
      (finally (port/close p) (File/rm_rf! root)))))
