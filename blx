#!/usr/bin/env bash
# blx — run bl against THIS worktree's stdlib (real proc.sched, reload, vm.*)
# with this checkout run from source and a z3 for the verifier tiers.
W="$(cd "$(dirname "$0")" && pwd)"
export BEAM_LISP_PATH="$W/priv/std:$W/priv/lib${BEAM_LISP_PATH:+:$BEAM_LISP_PATH}"
export BEAM_LISP_Z3="${BEAM_LISP_Z3:-/usr/bin/z3}"
export BL_DAEMON="${BL_DAEMON:-off}"
# bin/bl runs THIS checkout from source (staged floor + this tree's priv), so the
# binary always matches the stdlib above. It used to exec a prebuilt
# bl-v2026.4 in the main worktree; that file is gone, and any prebuilt drop is
# a generation behind the tree it is asked to run.
export BL_AUTOBUILD="${BL_AUTOBUILD:-off}"
exec "$W/bin/bl" "$@"
