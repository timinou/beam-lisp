#!/usr/bin/env bash
# bltest — run beam-lisp (.bl) test files through the warm isolated ward runner.
#
# usage: .local/bltest [DIR|FILE ...]     (each DIR contributes its *-test.bl)
#
# Delegates to `mix beam_lisp.ward`: every file's SOURCE runs in its own
# coherence-gated isolated fork off a warm base — no cross-file contamination,
# no stale beams. Exits non-zero unless every file is green.
set -uo pipefail
cd "$(dirname "$0")/.."
if [[ "${BLRUN_COMPILE:-1}" == "1" ]]; then
  if ! mix compile >/dev/null 2>&1; then
    echo "bltest: mix compile failed" >&2
    mix compile 2>&1 | tail -20 >&2
    exit 1
  fi
fi
args=()
for arg in "$@"; do
  if [[ -d "$arg" ]]; then
    while IFS= read -r f; do args+=("$f"); done < <(find "$arg" \( -name '*-test.bl' -o -name '*_test.bl' \) | sort)
  else
    args+=("$arg")
  fi
done
if [[ ${#args[@]} -eq 0 ]]; then
  echo "bltest: no test files (*-test.bl) in the given paths" >&2
  exit 1
fi
exec mix beam_lisp.ward "${args[@]}"
