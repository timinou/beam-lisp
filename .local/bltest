#!/usr/bin/env bash
# bltest — run beam-lisp (.bl) test files through the warm isolated runner.
#
# usage: .local/bltest [FLAGS] [DIR|FILE ...]   (each DIR contributes its *-test.bl)
#
# Delegates to `mix bl test`: the CLI inside a Mix project, so every file's SOURCE
# runs in its own coherence-gated isolated fork off a warm base — no cross-file
# contamination, no stale beams. Exits non-zero unless every file is green.
#
# `mix bl test`, NOT `./bl test`: the `bl` at the repo root is a built DROP and
# runs the stdlib it was packed with, so in a checkout it exercises the
# last-built language, not this tree's sources.
#
# BL_ASYNC=1 runs the concurrent runner. Files then share one process, so a file
# that sets an environment variable (BLANALYSIS_DIR) is visible to its
# neighbours; the default isolated runner restores the environment per file.
set -uo pipefail
cd "$(dirname "$0")/.."
if [[ "${BLRUN_COMPILE:-1}" == "1" ]]; then
  if ! mix compile >/dev/null 2>&1; then
    echo "bltest: mix compile failed" >&2
    mix compile 2>&1 | tail -20 >&2
    exit 1
  fi
fi
flags=()
if [[ "${BL_ASYNC:-0}" == "1" ]]; then flags+=(--async); fi
args=()
for arg in "$@"; do
  case "$arg" in
    -*) flags+=("$arg") ;;
    *)
      if [[ -d "$arg" ]]; then
        while IFS= read -r f; do args+=("$f"); done < <(find "$arg" \( -name '*-test.bl' -o -name '*_test.bl' \) | sort)
      else
        args+=("$arg")
      fi
      ;;
  esac
done
if [[ ${#args[@]} -eq 0 ]]; then
  echo "bltest: no test files (*-test.bl) in the given paths" >&2
  exit 1
fi
exec mix bl test "${flags[@]}" "${args[@]}"
