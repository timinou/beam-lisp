; Merge-readiness probe: annotation must not certify a partial executable BIF.
(ns merge.annotation-probe
  (:require [anf :as a] [lower :as l] [optimize :as o]))

(defn image [body enabled]
  (let [m (a/module
            (erlang/binary_to_atom
              (str "Elixir.MergeAnnotationProbe.Image" (erlang/unique_integer '(:positive))))
            (list {:op :defn-clause :fname :run :params (list) :guard nil
                   :body body :ann {}})
            (list [:run 0]) (list))
        report (o/explain m {:enabled? enabled})
        pair (l/descriptor->beam m {:enabled? enabled})]
    (code/load_binary (elem pair 0) '() (elem pair 1))
    {:report report
     :outcome (try [:ok (erlang/apply (elem pair 0) :run '())]
                   (catch-raw [kind reason stack] [kind reason]))}))

(let [predicate {:op :fn :ann {}
                 :clauses (list {:pats (list (a/pvar "x")) :guard nil
                                 :body {:op :arith :fun :gt :bif :div
                                        :args (list (a/lit 1) (a/var "x")) :ann {}}})}
      body (a/remote :Elixir.BeamLisp.Ns.Rt :first
             (list (a/remote :Elixir.BeamLisp.Ns.Rt :filter
                     (list predicate (a/lit '(1 0))))))
      reference (image body false)
      optimized (image body true)]
  (println "ANNOTATION-PROBE"
    {:reference (:outcome reference) :optimized (:outcome optimized)
     :same? (= (:outcome reference) (:outcome optimized))
     :evidence (:evidence (:report optimized))
     :refusals (:refusals (:report optimized))}))
