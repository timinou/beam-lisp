; effects.bl — the effect lattice (P15c, graduated from research/p15_lean).
;
; pure < atom-mutation < spawn/send < io. A fn's effect is the JOIN of
; what its body can do; seeds give core/interop fns their effects;
; unknown callees are :unknown (joins to the top for PURITY claims:
; you cannot claim pure over code you cannot see — sound).
;
; The demo question: a 3-fn chain ending in swap! must REJECT a ^:pure
; claim on the top fn — and the claim must NAME the offending effect
; and where it entered.

(ns effects
  (:require [typed] [footprint]))

; the lattice order
(def effect-rank {:pure 0 :atom 1 :process 2 :io 3 :unknown 4})

(defn eff-join [a b] (if (>= (get effect-rank a) (get effect-rank b)) a b))

; Leaf effects now come from the FOOTPRINT model (footprint/op-rung) — one
; effect model, not two. The old per-op effect-seeds table lived here; it was
; a parallel copy of footprint's op-mode/pure-ops classification and has been
; unified away (retrofit, P16b graduation). A user fn's effect still propagates
; through the `effects` table below; a truly unknown callee is :unknown.

; --- effect inference over reader forms ---------------------------------------

(declare eff-walk)

(defn eff-of-head [effects hname]
  ; unified: the leaf rung comes from the FOOTPRINT model (footprint/op-rung),
  ; so effects and footprint are ONE model. A user fn in the effects table
  ; keeps its inferred effect; a truly unknown callee is :unknown (sound for
  ; purity — you cannot claim pure over code you cannot see).
  (or (footprint/op-rung hname)
      (get effects hname)
      :unknown))

(defn eff-walk
  "The effect of a form: the join over all calls under it. Special
   forms contribute their subforms; let/fn bind locally."
  [effects env node]
  (let [tag (typed/node-tag node)]
    (cond
      (= tag :meta)
        (eff-walk effects env (second (erlang/tuple_to_list node)))

      (contains? #{:vector :set} tag)
        (reduce (fn [e x] (eff-join e (eff-walk effects env x))) :pure
                (typed/node-items node))

      (= tag :map)
        (reduce (fn [e p]
                  (eff-join e (eff-walk effects env
                                        (second (erlang/tuple_to_list p)))))
                :pure (typed/node-items node))

      (= tag :list)
        (let [items (typed/node-items node)
              head  (typed/node-form (first items))]
          (if (not (= :symbol (typed/node-tag head)))
            (reduce (fn [e x] (eff-join e (eff-walk effects env x))) :pure items)
            (let [hname (typed/node-name head)]
              (cond
                (= hname "quote") :pure

                (= hname "if")
                  (reduce (fn [e x] (eff-join e (eff-walk effects env x)))
                          :pure (rest items))

                (= hname "let")
                  (reduce (fn [e x] (eff-join e (eff-walk effects env x)))
                          :pure (rest items))

                (= hname "do")
                  (reduce (fn [e x] (eff-join e (eff-walk effects env x)))
                          :pure (rest items))

                (= hname "loop")
                  (reduce (fn [e x] (eff-join e (eff-walk effects env x)))
                          :pure (rest items))

                (= hname "fn") :pure   ; the BODY's effect belongs to the fn value

                :else
                  (eff-join (eff-of-head effects hname)
                            (reduce (fn [e x] (eff-join e (eff-walk effects env x)))
                                    :pure (rest items)))))))

      :else :pure)))

(defn infer-effects
  "Walk top-level defns in order; each fn's effect lands in the table
   (later fns see earlier fns' effects — the chain propagates)."
  [src]
  (let [forms (BeamLisp.Reader/read_string src)]
    (reduce
      (fn [effects form]
        (let [f (typed/node-form form)]
          (if (and (= :list (typed/node-tag f))
                   (= :symbol (typed/node-tag (typed/node-form (first (typed/node-items f)))))
                   (contains? #{"defn" "defn-"}
                              (typed/node-name (typed/node-form (first (typed/node-items f))))))
            (let [items (typed/node-items f)
                  name  (typed/node-name (typed/node-form (second items)))
                  [_ _ clauses] (typed/defn-clauses items)
                  eff (reduce (fn [e c]
                                (reduce (fn [e2 b] (eff-join e2 (eff-walk effects {} b)))
                                        e (:body c)))
                              :pure clauses)]
              (assoc effects name eff))
            effects)))
      {} forms)))

(defn check-purity-claims
  "Every ^:pure defn whose inferred effect is not :pure is a REJECTED
   claim, naming the effect. Returns warnings."
  [src]
  (let [forms (BeamLisp.Reader/read_string src)
        effects (infer-effects src)]
    (reduce
      (fn [ws form]
        (let [f (typed/node-form form)]
          (if (and (= :list (typed/node-tag f))
                   (= :symbol (typed/node-tag (typed/node-form (first (typed/node-items f)))))
                   (contains? #{"defn" "defn-"}
                              (typed/node-name (typed/node-form (first (typed/node-items f))))))
            (let [items (typed/node-items f)
                  name-node (second items)
                  name  (typed/node-name (typed/node-form name-node))
                  meta  (if (= :meta (typed/node-tag name-node))
                          (nth (erlang/tuple_to_list name-node) 2)
                          nil)
                  claims-pure (and (map? meta) (= true (:pure meta)))
                  eff (get effects name :unknown)]
              (if (and claims-pure (not (= :pure eff)))
                (conj ws {:name name :effect eff
                          :line (:line (typed/node-pos form))})
                ws))
            ws)))
      [] forms)))
