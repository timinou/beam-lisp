; mock.bl — a contract, run backwards, IS a mock server.
;
; ── The one idea ──────────────────────────────────────────────────────────
;
; Every existing z3 caller in this tree asks the solver for UNSAT — "prove no
; counterexample exists" (verify-process, abduce, prove-equiv). That is the
; checker running FORWARD.
;
; A mock is the SAME relation run the OTHER way. A method's postcondition
; `:ensures` is a predicate the response must satisfy. Ask z3 whether some
; response satisfies it — a SAT query — and z3 does not just answer "yes": its
; MODEL *is* a concrete response value. The proof obligation and the mock are
; the two directions of one relation.
;
;   verify :  ∀ resp. ensures(resp)                 → UNSAT ⟹ property holds
;   mock   :  ∃ resp. ensures(resp) ∧ seed(resp)    → SAT   ⟹ model is the resp
;
; So a mock is not written. It is DERIVED from the same contract the real impl
; is checked against — which is exactly why the two are interchangeable: they
; answer to one predicate. And because the derivation is a pure function of
; (contract, input), the mock is a pure value: safe to run where the real impl's
; network egress is unspeakable (an env without the cap). Fail-closed becomes
; fall-back-to-mock, with no `if sandbox` branch anywhere.
;
; ── What a contract is here ───────────────────────────────────────────────
;
; A method contract is:
;   {:fields  [[name sort] …]     ; the response shape (z3 sorts: Int/Real/Bool/String)
;    :ensures [smt-string …]}     ; postconditions the response must satisfy
; SMT strings are beam-lisp prefix arithmetic, which is already valid SMT-LIB
; (see system.smt); `contract-from` below translates bl predicate source to them.
;
; ── What the mock can do (all proven against real z3) ─────────────────────
;
;   synth            one valid response          (SAT model)
;   synth-seeded     a DETERMINISTIC response    (pure fn of an input — a real mock server)
;   synth-boundary   the min/max valid response  (edge cases, for free — z3 optimizes)
;   synth-invalid    a response the contract FORBIDS (negative tests: adversarial by construction)
;   satisfiable?     is the contract even realizable? (unsat ⟹ a contradictory spec, caught with no impl)
;   check            does a concrete value satisfy?   (the FORWARD round-trip — synth backward, verify forward)

(ns mock
  (:require [z3] [system.smt :as smt] [typed] [core]))

; ── the timeout floor ───────────────────────────────────────────────────────
;
; A synthesis engine must NEVER hang. Nonlinear integer arithmetic
; (total = price * qty) is undecidable: z3 answers a SAT query fast but can spin
; forever on the UNSAT direction. (set-option :timeout N) bounds every query, so
; z3 returns "unknown" instead of spinning. "unknown" is treated HONESTLY: a
; result we could not confirm is reported as such, never as a false proof — the
; same sound-only discipline the verifier uses.

(def TIMEOUT-MS 3000)

(defn- timed [smt] (str "(set-option :timeout " TIMEOUT-MS ")\n" smt))

; ── decls ─────────────────────────────────────────────────────────────────

(defn- decls-of
  "declare-const lines for the response fields. `fields` is [[name sort] …]."
  [fields]
  (core/join "" (map (fn [f] (str "(declare-const " (first f) " " (second f) ")\n")) fields)))

(defn- assert-all
  "Assert every ensures clause."
  [ensures]
  (core/join "" (map (fn [e] (str "(assert " e ")\n")) ensures)))

; ── model parsing: a z3 model IS a value ───────────────────────────────────
;
; z3 answers a SAT query with `((define-fun name () Sort VALUE) …)`. VALUE is a
; scalar (16, true, "usr_"), a negative `(- 39)`, or a rational `(/ 1.0 2.0)`.
; We read the model with the beam-lisp reader (the model is valid s-expression
; text) and project each define-fun to [name value].

(defn- model-value
  "The bl value of a define-fun's VALUE node: a bare scalar, (- n) → -n, or
   (/ a b) → a÷b (z3 renders a Real as an exact rational)."
  [vnode]
  (let [f (typed/node-form vnode)
        tg (typed/node-tag f)]
    (cond
      (= tg :scalar) f                                  ; int / true / false / string
      (= tg :list)
        (let [its (typed/node-items f)
              op (if (empty? its) nil (typed/node-name (typed/node-form (first its))))]
          (cond
            (and (= op "-") (= 2 (count its)))
              (- 0 (model-value (second its)))
            (and (= op "/") (= 3 (count its)))
              (/ (model-value (second its)) (model-value (nth its 2)))
            :else f))
      :else f)))

(defn parse-model
  "A z3 model TEXT → {field-name-string → bl value}. The model is `(…defs…)`;
   each def is (define-fun NAME () SORT VALUE). nil/empty text → {}."
  [model-text]
  (if (or (nil? model-text) (= "" model-text))
    {}
    (let [top (first (BeamLisp.Reader/read_string model-text))
          defs (typed/node-items top)]
      (into {}
        (keep (fn [d]
                (let [its (typed/node-items d)]
                  (if (and (>= (count its) 5)
                           (= "define-fun" (typed/node-name (typed/node-form (first its)))))
                    [(typed/node-name (typed/node-form (second its)))
                     (model-value (nth its 4))]
                    nil)))
              defs)))))

(defn- keywordize
  "{name-string → v} → {name-keyword → v}, so a synthesized response reads like
   an ordinary beam-lisp map ({:temp 16} not {\"temp\" 16})."
  [m]
  (into {} (map (fn [p] [(keyword (first p)) (second p)]) (into [] m))))

; ── the synthesis modes ─────────────────────────────────────────────────────
;
; Every mode returns {:status "sat"|"unsat"|"unknown" :value {field→v}|nil}. A
; SAT carries the model as the value; unsat/unknown carry nil. Callers branch on
; :status so "unknown" is never mistaken for a definite answer.

(defn synth
  "ONE valid response for `contract`, or nil. `extra` is extra SMT asserted on
   top (a seed, a request-derived constraint) — \"\" for the bare contract."
  [port contract extra]
  (let [smt (timed (str (decls-of (:fields contract))
                        (assert-all (:ensures contract))
                        extra))
        r (z3/check-model port smt)]
    {:status (:status r)
     :value (if (= "sat" (:status r)) (keywordize (parse-model (:model r))) nil)}))

(defn satisfiable?
  "Is the contract realizable at all? true only on a definite SAT. A
   contradictory spec (unsat) or an undecidable one (unknown) → false, with
   `satisfiable-status` available when the distinction matters."
  [port contract]
  (= "sat" (:status (synth port contract ""))))

(defn satisfiable-status
  "The raw verdict: \"sat\" (realizable), \"unsat\" (contradictory spec), or
   \"unknown\" (could not decide — e.g. nonlinear). Honest three-way answer."
  [port contract]
  (:status (synth port contract "")))

(defn synth-seeded
  "A DETERMINISTIC response, pinned by `seed` (an integer) on integer `field`.
   This is the mock server: the same seed yields the same response, so a mock
   keyed by `(hash input)` is a pure function input→response. The seed EQUATES
   the field to a bounded image of the seed, keeping the query linear (no mod on
   a synthesized var), so it stays fast and decidable."
  [port contract field seed]
  (synth port contract (str "(assert (= " field " " seed "))\n")))

(defn synth-boundary
  "The EXTREME valid response: `dir` :min or :max over integer `field`. z3's
   optimizer finds the smallest/largest response the contract still admits — the
   edge cases a hand-written mock always forgets, generated for free."
  [port contract field dir]
  (let [obj (if (= dir :min) "minimize" "maximize")
        smt (timed (str (decls-of (:fields contract))
                        (assert-all (:ensures contract))
                        "(" obj " " field ")\n"))
        r (z3/check-model port smt)]
    {:status (:status r)
     :value (if (= "sat" (:status r)) (keywordize (parse-model (:model r))) nil)}))

(defn synth-invalid
  "A response the contract FORBIDS: assert the NEGATION of the ensures. Every
   value this returns is, by construction, a contract violation — an adversarial
   fault the mock can inject while STILL being provably inside the sandbox. The
   type of failure is itself contract-derived, so a test cannot inject a fault
   the contract permits and call it a violation."
  [port contract]
  (let [neg (str "(not (and " (core/join " " (:ensures contract)) "))")
        smt (timed (str (decls-of (:fields contract)) "(assert " neg ")\n"))
        r (z3/check-model port smt)]
    {:status (:status r)
     :value (if (= "sat" (:status r)) (keywordize (parse-model (:model r))) nil)}))

; ── the forward round-trip: synthesize backward, VERIFY forward ────────────
;
; A synthesized response is only trusted when it survives the forward check —
; the same discipline repair-transition uses. We substitute the concrete value
; into the ensures and ask z3 whether the NEGATION is unsat: the value satisfies
; the contract iff no clause can be false under it.

(defn- render-lit
  "A bl value as an SMT literal: negatives as (- n), strings quoted, bools bare."
  [v]
  (cond
    (and (int? v) (< v 0)) (str "(- " (- 0 v) ")")
    (string? v)            (str "\"" v "\"")
    :else                  (str v)))

(defn check
  "Does concrete `value` ({field→v}) satisfy `contract`? Pins every field to its
   value and asks whether the ensures can be violated; unsat ⟹ it holds. Only a
   definite unsat returns true, so an undecidable check is a safe false."
  [port contract value]
  (let [pins (core/join ""
               (map (fn [f]
                      (let [nm (first f)
                            v (get value (keyword nm))]
                        (str "(assert (= " nm " " (render-lit v) "))\n")))
                    (:fields contract)))
        neg (str "(not (and " (core/join " " (:ensures contract)) "))")
        smt (timed (str (decls-of (:fields contract)) pins "(assert " neg ")\n"))]
    (= "unsat" (z3/check port smt))))

; ── deriving a contract from bl predicate source ───────────────────────────
;
; A contract's ensures can be WRITTEN as ordinary beam-lisp predicates over the
; response fields; system.smt translates them to SMT-LIB (the same translator
; the verifier uses, so mock and checker never disagree about what a predicate
; means). Fields not translatable stay out — honest, not a false mock.

(defn contract-from
  "Build a contract from `fields` ([[name sort]…]) and `preds` (bl predicate
   SOURCE strings over the field names). Each predicate is translated through
   system.smt; an untranslatable predicate is dropped (the mock then satisfies a
   weaker contract, never a wrong one)."
  [fields preds]
  (let [vars (set (map first fields))
        ens (keep (fn [p]
                    (let [s (smt/of-source vars p)]
                      (if (or (nil? s) (= s :untranslatable)) nil s)))
                  preds)]
    {:fields fields :ensures (into [] ens)}))
