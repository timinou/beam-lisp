; loom/token.bl — the scale: design decisions as values, atomic CSS from a map.
;
; ── The idea ──────────────────────────────────────────────────────────
;
; A design system is a small set of DECISIONS — a spacing scale, a colour
; ramp, type sizes, breakpoints — applied consistently. When the decisions
; are DATA, the machine enforces the consistency: a `(space :4)` is the same
; pixels everywhere, and an off-scale token fails loud.
;
; But a scale must never be a CEILING. Every resolver here takes a token
; keyword OR a raw value: `(len :4)` → the scale, `(len "13px")` / `(len 20)`
; → passed straight through. And `sx` merges a raw `:style` map LAST, so an
; app can always say something the vocabulary did not anticipate. The system
; is the happy path, not a fence.
;
; Three layers:
;   1. TOKENS   — colour/space/radius/type/shadow/motion/screen, one source
;                 of truth, deep-mergeable per process (a brand is a value).
;   2. sx / sx* — a style map → a stable hashed class. `sx*` also carries
;                 responsive (`:at`) and stateful (`:on`) variants, so a
;                 single class can hold media queries and `:hover` rules.
;   3. collect  — every class a render used, as one <style> block.
;
; Deterministic: same style anywhere ⇒ same class ⇒ one rule.

(ns loom.token)

;; ════════════════════════════════════════════════════════════════════
;; 1. TOKENS
;; ════════════════════════════════════════════════════════════════════

(def tokens
  {:color
   {:bg        "#0b0c0e"
    :surface   "#151719"
    :surface-2 "#1e2124"
    :surface-3 "#282c31"
    :border    "#2a2e33"
    :border-2  "#3a3f45"
    :text      "#e8eaed"
    :muted     "#9aa0a6"
    :faint     "#5f656b"
    :accent    "#5b8def"
    :accent-2  "#7c5cff"
    :accent-fg "#ffffff"
    :danger    "#e5534b"
    :warning   "#d29922"
    :success   "#3fb950"}

   :space
   {:0 "0"      :px "1px"  :1 "4px"   :2 "8px"   :3 "12px"  :4 "16px"
    :5 "24px"   :6 "32px"  :7 "48px"  :8 "64px"  :9 "96px"  :10 "128px"}

   :radius
   {:none "0"   :sm "4px"  :md "8px"  :lg "14px" :xl "22px" :full "9999px"}

   :font
   {:sans "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
    :mono "'SF Mono', 'JetBrains Mono', Menlo, monospace"}
   :text
   {:xs "12px"  :sm "14px"  :md "16px"  :lg "20px"
    :xl "26px"  :2xl "34px" :3xl "46px" :4xl "60px"}
   :weight
   {:normal "400" :medium "500" :semibold "600" :bold "700"}
   :leading
   {:tight "1.15" :normal "1.5" :relaxed "1.7"}

   :shadow
   {:none "none"
    :sm "0 1px 2px rgba(0,0,0,.3)"
    :md "0 4px 12px rgba(0,0,0,.35)"
    :lg "0 12px 32px rgba(0,0,0,.45)"
    :xl "0 24px 60px rgba(0,0,0,.55)"}

   :motion
   {:fast "120ms" :base "200ms" :slow "320ms"
    :ease "cubic-bezier(.2,.8,.2,1)"
    :spring "cubic-bezier(.34,1.56,.64,1)"}

   ;; breakpoints — min-widths for the responsive `:at` variants
   :screen
   {:sm "480px" :md "768px" :lg "1024px" :xl "1280px" :2xl "1536px"}})

;; ── theming: a brand is a VALUE installed per process ───────────────

(def ^:private theme-key :loom.token/theme)

(defn- deep-merge [a b]
  (reduce (fn [acc kv]
            (let [k (first kv) v (second kv) cur (get acc k)]
              (if (and (map? cur) (map? v))
                (assoc acc k (deep-merge cur v))
                (assoc acc k v))))
          a (seq b)))

(defn install-theme!
  "Install a brand: a partial map deep-merged over the defaults for this
   process. Call at socket mount so every component paints in the brand."
  [brand]
  (let [effective (deep-merge tokens brand)]
    (Process/put theme-key effective)
    effective))

(defn theme [] (or (Process/get theme-key) tokens))

(defn tok
  "Resolve a token, failing loud on a typo (a design bug, not a dropped style)."
  [category key]
  (let [cat (get (theme) category)]
    (when (nil? cat) (throw (str "loom: no token category " (pr-str category))))
    (let [v (get cat key)]
      (when (nil? v)
        (throw (str "loom: no token " (pr-str category) " / " (pr-str key)
                    " — one of " (pr-str (keys cat)))))
      v)))

(defn color   [k] (tok :color k))
(defn space   [k] (tok :space k))
(defn radius  [k] (tok :radius k))
(defn text    [k] (tok :text k))
(defn weight  [k] (tok :weight k))
(defn shadow  [k] (tok :shadow k))
(defn screen  [k] (tok :screen k))

;; ── scale-or-raw resolvers: the escape hatch ────────────────────────
;;
;; A length is a token keyword, a bare number (→ px), or any raw string
;; ("13px", "1rem", "clamp(...)"). This is what keeps the scale from being
;; a ceiling: the common case is a token, the uncommon case is anything.

(defn len
  "A length: a :space token, a number (→px), or a raw CSS string."
  [v]
  (cond (keyword? v) (space v)
        (number? v)  (str v "px")
        :else        (str v)))

(defn hue
  "A colour: a :color token, or a raw CSS colour string."
  [v]
  (cond (keyword? v) (color v)
        :else        (str v)))

;; ════════════════════════════════════════════════════════════════════
;; 2. sx / sx* — a style map → a stable, hashed, deduped class
;; ════════════════════════════════════════════════════════════════════

(defn- css-value [v] (cond (keyword? v) (name v) :else (str v)))
(defn- prop->decl [kv] (str (name (first kv)) ":" (css-value (second kv))))

(defn style->css
  "A style map → a canonical (key-sorted) CSS declaration string, so the same
   declarations always serialise identically ⇒ same hash ⇒ same class."
  [m]
  (join ";" (map prop->decl (sort-by (fn [kv] (name (first kv))) (seq m)))))

;; the per-render sheet: class → its FULL rendered rule block, in the process
;; dict. Storing the whole block (not just a body) is what lets one class carry
;; a base rule plus `:hover` and `@media` rules.
(def ^:private sheet-key :loom.token/sheet)

(defn- class-for [canon] (str "s" (Integer/to_string (erlang/phash2 canon) 36)))

(defn- record! [cls block]
  (let [sheet (or (Process/get sheet-key) {})]
    (Process/put sheet-key (assoc sheet cls block))
    cls))

(defn sx
  "Register a flat style map (or several, merged left-to-right — later wins)
   and return its class name."
  [& maps]
  (let [m (apply merge maps)
        css (style->css m)
        cls (class-for css)]
    (record! cls (str "." cls "{" css "}"))))

;; screen-order so media blocks always cascade small→large regardless of
;; authoring order (later, wider rules win the cascade).
(def ^:private screen-rank {:sm 1 :md 2 :lg 3 :xl 4 :2xl 5})

(defn- min-width [bp]
  (cond (keyword? bp) (screen bp)
        (number? bp)  (str bp "px")
        :else         (str bp)))

(defn sx*
  "Register a COMPOSITE style and return one class carrying all of it:
     {:base {css…}                     the default rule
      :on   {:hover {css…} :focus {…}} pseudo-state rules
      :at   {:md {css…} :lg {css…}}}   min-width media overrides
   Identical composites collapse to one class, exactly like `sx`."
  [spec]
  (let [base   (get spec :base {})
        on     (get spec :on {})
        at     (get spec :at {})
        on-seq (sort-by (fn [kv] (name (first kv))) (seq on))
        at-seq (sort-by (fn [kv] (let [bp (first kv)]
                                   (or (get screen-rank bp) 99)))
                        (seq at))
        canon  (str (style->css base)
                    "|" (join ";" (map (fn [kv] (str (name (first kv)) "{" (style->css (second kv)) "}")) on-seq))
                    "|" (join ";" (map (fn [kv] (str (min-width (first kv)) "{" (style->css (second kv)) "}")) at-seq)))
        cls    (class-for canon)
        base-rule (str "." cls "{" (style->css base) "}")
        on-rules  (map (fn [kv] (str "." cls ":" (name (first kv)) "{" (style->css (second kv)) "}")) on-seq)
        at-rules  (map (fn [kv] (str "@media (min-width:" (min-width (first kv)) "){."
                                     cls "{" (style->css (second kv)) "}}")) at-seq)
        block  (join "\n" (concat [base-rule] on-rules at-rules))]
    (record! cls block)))

;; ════════════════════════════════════════════════════════════════════
;; 3. collect — every used class, as one <style> block
;; ════════════════════════════════════════════════════════════════════

(defn reset-sheet! [] (Process/put sheet-key {}) nil)

(defn sheet-css
  "Every class registered so far this render, one block per class, in
   insertion order (stable for diffing and caching)."
  []
  (let [sheet (or (Process/get sheet-key) {})]
    (join "\n" (map (fn [kv] (second kv)) (seq sheet)))))

(defn base-css
  "The document base: reset + token-driven body defaults + the a11y floor
   (reduced-motion, a visible keyboard focus ring)."
  []
  (str
    "*,*::before,*::after{box-sizing:border-box;margin:0}"
    "html{-webkit-text-size-adjust:100%}"
    "body{"
      "background:" (color :bg) ";"
      "color:" (color :text) ";"
      "font-family:" (tok :font :sans) ";"
      "font-size:" (text :md) ";"
      "line-height:" (tok :leading :normal) ";"
      "-webkit-font-smoothing:antialiased"
    "}"
    "a{color:" (color :accent) ";text-decoration:none}"
    "a:hover{text-decoration:underline}"
    "@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}"
    ":focus-visible{outline:2px solid " (color :accent) ";outline-offset:2px}"))

(defn style-tag
  "A complete <style> element (base + collected classes). Call AFTER render."
  []
  [:style (str (base-css) "\n" (sheet-css))])

;; A hiccup tree may contain LAZY children (a `for` produces an unrealized
;; seq). Every `sx` inside such a child only fires when the seq is walked — so
;; if we captured the stylesheet before walking, those classes would be MISSING
;; from it. `realize` forces the whole tree eagerly so `with-sheet` can capture
;; a COMPLETE sheet, whatever laziness the view used. This is the one place the
;; ordering trap is closed, for every consumer.
(defn- realize
  [node]
  (cond
    ;; a hiccup element / vector: realize each position, stays a vector
    (vector? node) (mapv realize node)
    ;; an attrs map: realize values
    (map? node)    (reduce (fn [m kv] (assoc m (first kv) (realize (second kv)))) {} (seq node))
    ;; a lazy/seq or list child-group: realize each element but STAY A SEQ
    ;; (hiccup requires a bare list of children to be a seq, never a vector)
    (or (seq? node) (list? node)) (apply list (map realize node))
    :else node))

(defn with-sheet
  "Run a 0-arg render fn with a fresh sheet; return {:tree … :style [:style …]}.
   The tree is fully REALIZED before the stylesheet is captured, so a view built
   with lazy `for` children still yields a complete <style> block."
  [render-fn]
  (reset-sheet!)
  (let [tree (realize (render-fn))]
    {:tree tree :style (style-tag)}))
