; priv/loom/bar/text.bl — pixels for strings, one pure function + one cache.
;
; == THE ATLAS IS DATA (v0) ==============================================
;
; The atlas is the kbd package's default8x16 (a PSF2 font), glyphs for ASCII
; 32..126 extracted verbatim — 95 glyphs x 16 rows, 1 byte per row, MSB =
; leftmost pixel — shipped here as base64. No font file is read at runtime,
; no rasterizer runs at boot; the "font" is 1520 bytes that decode once into
; a persistent_term. The pure-lisp TTF rasterizer (v1.5) slots in behind the
; same render signature: data in, pixels out, still memoized.
;
; == THE CACHE IS THE POINT =============================================
;
; render is pure — (string, fg, bg, scale) -> a run of row-binaries — and
; memoized in a persistent_term. The bar repaints by ASSEMBLING cached runs
; (iodata concat, canvas.bl), never by re-rasterizing: per-frame text cost is
; a map lookup and a memcpy. bg4 is baked into the rows: an opaque run pastes
; over the bar's fill, so the flat executor never alpha-blends per pixel.
; True compositing is executor :shape's business.

(ns loom.bar.text)

(def ^:private ATLAS-B64
  "")

(def ^:private W 8)          ; glyph width in the atlas
(def ^:private H 16)         ; glyph height
(def ^:private FIRST 32)     ; atlas starts at ASCII space
(def ^:private BITS [128 64 32 16 8 4 2 1])  ; MSB = leftmost pixel

(defn- atlas
  "The 95x16 glyph bytes, decoded once, cached forever."
  []
  (let [cur (erlang/apply :persistent_term :get (list :loom.bar.text/atlas nil))]
    (if (nil? cur)
      (let [a (Base/decode64 ATLAS-B64)]
        (erlang/apply :persistent_term :put (list :loom.bar.text/atlas a))
        a)
      cur)))

(defn- px4
  "One pixel colour repeated `scale` times horizontally, as a binary."
  [c4 scale]
  (wire/bytes-of (repeat scale c4)))

(defn- render*
  "The pure raster: (string fg bg scale) -> {:w :h :rows [row-binary …]}.
   Rows are opaque; the run pastes over the bar's fill."
  [s fg4 bg4 scale]
  (let [codes (erlang/binary_to_list s)
        n (count codes)
        adv (* (+ W 1) scale)
        w (- (* adv n) scale)
        h (* H scale)
        a (atlas)
        fg-px (px4 fg4 scale)
        bg-px (px4 bg4 scale)
        gap (wire/bytes-of (repeat scale bg4))
        char-row (fn [code src-row]
                   (let [off (* (- code FIRST) H)
                         byte (nth a (+ off src-row))
                         bits (loop [b 0 acc []]
                                (if (= b W)
                                  acc
                                  (let [px (if (= 1 (rem (quot byte (nth BITS b)) 2)) fg-px bg-px)]
                                    (recur (inc b) (concat acc (repeat scale px))))))]
                     (wire/bytes-of (concat bits (repeat scale bg4)))))
        rows (loop [y 0 acc []]
               (if (= y h)
                 acc
                 (let [sr (quot y scale)
                       row (wire/bytes-of
                             (loop [cs codes acc2 []]
                               (if (empty? cs)
                                 acc2
                                 (recur (rest cs)
                                        (concat acc2 [(char-row (first cs) sr)])))))]
                   (recur (inc y) (conj acc row)))))]
    {:w w :h h :rows rows}))

(defn render
  "A string as a pasteable run of pixel rows — memoized. This is the only
   text entry point the bar uses; the cache IS the performance model."
  [s fg4 bg4 scale]
  (let [key [s fg4 bg4 scale]
        cache (erlang/apply :persistent_term :get (list :loom.bar.text/cache {}))
        hit (get cache key nil)]
    (if (nil? hit)
      (let [r (render* s fg4 bg4 scale)]
        (erlang/apply :persistent_term :put
                      (list :loom.bar.text/cache (assoc cache key r)))
        r)
      hit)))

(defn measure
  "The width render would give — layout asks this before it renders."
  [s scale]
  (- (* (+ W 1) scale (erlang/byte_size s)) scale))
