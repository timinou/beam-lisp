; priv/loom/bar/canvas.bl — the canvas CONTRACT and the :flat executor.
;
; ══ THE CONTRACT (the hiccup of pixels) ═══════════════════════════════════
;
; A frame is a vector of ops over one background colour:
;
;   [:glyphs {:x x :y y :run run}]   ; a cached text run (loom.bar.text)
;
; Executor :flat paints each op by OVERWRITING the background: a run carries
; its own bg pixels (text.bl bakes them in), so painting is iodata assembly —
; dup the fill, splice the row, dup the fill. No per-pixel blending anywhere;
; a frame is one iolist_to_binary of 44 row-parts. The cost model: runs are
; cached (text.bl), rows are memcpy'd, and the executor is deterministic —
; same ops, same canvas, byte-identical frame (golden-hash testable).
;
; :flat REJECTS depth (:shadow, :gradient) by omission — the lint surface for
; executor :shape is "these ops start decoding"; nothing here falls back
; silently. Runs must not overlap each other (v0 assumption; the loom view's
; box algebra guarantees it for bar layouts).

(ns loom.bar.canvas
  (:require [wayland.wire :as wire]))

(defn frame
  "ops × background × canvas → one ARGB binary, :flat executor.
   ops: [[:glyphs {:x :y :run}] …] over a solid `bg` (ARGB u32)."
  [ops bg w h]
  (let [bg4 (wire/bytes-of (wire/u32-le bg))
        runs (map (fn [op]
                    (let [o (nth op 1)]
                      {:x (:x o) :y (:y o) :run (:run o)}))
                  (to-list ops))
        row-parts (fn [y]
                    (let [here (filter (fn [s]
                                         (and (>= y (:y s))
                                              (< y (+ (:y s) (:h (:run s))))))
                                       runs)]
                      (loop [ss here cur 0 acc []]
                        (if (empty? ss)
                          (concat acc (List/duplicate bg4 (- w cur)))
                          (let [s (first ss)
                                row (nth (:rows (:run s)) (- y (:y s)))]
                            (recur (rest ss)
                                   (+ (:x s) (:w (:run s)))
                                   (concat acc
                                           (List/duplicate bg4 (- (:x s) cur))
                                           [row])))))))]
    (loop [y 0 acc []]
      (if (= y h)
        (wire/bytes-of acc)
        (recur (inc y) (conj acc (row-parts y)))))))
