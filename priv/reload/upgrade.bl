; reload/upgrade.bl — every test run can be an upgrade-safety proof.
;
; ── The idea ──────────────────────────────────────────────────────────
;
; A passing test says "the assertions held for the inputs I tried". An UPGRADE-
; SAFETY proof says something stronger and different: "the new version of this
; process preserves the invariant it claims, for EVERY reachable state" — a
; property no finite set of example inputs can establish. Because ward already
; sits on the verification tier (the same checker that gates a live migration),
; it can answer that as a test result.
;
; `verify-upgrade` takes the OLD and NEW source of an annotated process and asks:
; does the NEW version's declared invariant actually hold under every transition?
; It rides `repair-process` — the checker run backwards: if the invariant holds,
; the upgrade is safe; if a transition breaks it, the check returns the
; synthesized guard that WOULD restore it (the fix, not just a rejection). The
; OLD version is verified too, so a "was it safe before?" baseline is explicit —
; an upgrade that was already broken is reported differently from one the change
; introduced.
;
; ── Honesty ───────────────────────────────────────────────────────────
;
; Three outcomes, and we never fake a proof:
;   :safe        — the new invariant holds under every transition (checked true).
;   :unsafe      — a transition breaks it; carries the per-transition repair.
;   :unknown     — the checker could not model this shape (:checked false), OR z3
;                  is not available (:no-z3), OR the source is not a process
;                  (:not-a-process). A proof we could not run is NOT a pass.
;
; A test verb built on this (`assert-safe-upgrade`) FAILS on :unsafe, PASSES on
; :safe, and — deliberately — treats :unknown as a soft skip the caller can see,
; not a silent green.

(ns reload.upgrade
  (:require [system.core :as sys] [z3]))

;; ── read a single process form from source ────────────────────────────────

(defn- process-node
  "The first top-level `defserver` form in `src` as a read node, or nil when the
   source declares no process."
  [src]
  (try
    (let [forms (BeamLisp.Reader/read_string src)]
      (some (fn [f]
              (let [nf (typed/node-form f)]
                (if (and (= :list (typed/node-tag nf))
                         (= "defserver" (typed/node-name (first (typed/node-items nf)))))
                  f nil)))
            forms))
    (catch _ nil)))

;; ── verify one version in isolation ───────────────────────────────────────

(defn- verify-node
  "Run the checker's repair over one process node with an open `port`. Returns
   {:holds bool :checked bool :repairs [...]}. `:checked` false ⇒ the shape was
   not modellable (no invariant, untranslatable) — honestly unknown, not safe."
  [port node]
  (let [r (sys/repair-process port node)]
    {:holds (:holds r) :checked (:checked r) :repairs (:repairs r)}))

;; ── the upgrade-safety verdict ────────────────────────────────────────────

(defn verify-upgrade
  "Is `new-src` a safe upgrade of `old-src`? Both are process SOURCES (a
   `defserver` with an `^{:invariant …}` annotation). Returns:

     {:verdict :safe    :new {…} :old {…}}
     {:verdict :unsafe  :new {…} :old {…} :repairs [{:label :guard} …]}
     {:verdict :unknown :reason :no-z3|:not-a-process|:unmodellable :old? :new?}

   Rides `repair-process`: the new version's declared invariant must HOLD under
   every transition (`:holds` true). When it does not, the returned repairs are
   the synthesized guards that would restore it — the fix, surfaced as part of
   the verdict. The old version is verified too, so a baseline is explicit.
   Never throws: a check that cannot run is :unknown with a reason."
  [old-src new-src]
  (let [new-node (process-node new-src)
        old-node (process-node old-src)]
    (if (nil? new-node)
      {:verdict :unknown :reason :not-a-process}
      (try
        (let [port (z3/open)                        ; raises if z3 is absent
              nv (verify-node port new-node)
              ov (if old-node (verify-node port old-node) nil)]
          (cond
            ; the checker could not model the new version's shape → honest unknown
            (not (:checked nv))
            {:verdict :unknown :reason :unmodellable :new nv :old ov}

            ; the new invariant holds under every transition → safe
            (:holds nv)
            {:verdict :safe :new nv :old ov}

            ; a transition breaks it → unsafe, with the repair that would fix it
            :else
            {:verdict :unsafe :new nv :old ov :repairs (:repairs nv)}))
        (catch _
          {:verdict :unknown :reason :no-z3})))))

(defn safe-upgrade?
  "True iff `verify-upgrade` returns :safe. A convenience predicate; the full
   `verify-upgrade` verdict carries the repair and baseline a report wants."
  [old-src new-src]
  (= :safe (:verdict (verify-upgrade old-src new-src))))

;; ── the test verb ─────────────────────────────────────────────────────────

(defn assert-safe-upgrade
  "A test assertion: the upgrade from `old-src` to `new-src` is verified safe.
   Usable inside a `deftest` — it records a pass/fail through the same test
   machinery `is` uses, so it shows in the suite totals and ward's report.

     :safe    → records a PASS.
     :unsafe  → records a FAIL, whose `actual` is the synthesized repair (the
                guard that would make the upgrade safe) — the fix in the failure.
     :unknown → records an ERROR carrying the reason (:no-z3 / :not-a-process /
                :unmodellable), because a proof we could not RUN is not a proof
                we passed. A caller that wants to tolerate unknowns can check
                `verify-upgrade` directly instead."
  [old-src new-src]
  (let [ns (BeamLisp.Env/current_ns)
        v  (verify-upgrade old-src new-src)
        verdict (:verdict v)
        form (list (quote assert-safe-upgrade) verdict)]
    (cond
      (= :safe verdict)
      (do (BeamLisp.TestRT/record ns :pass form nil :safe :safe) true)

      (= :unsafe verdict)
      (do (BeamLisp.TestRT/record ns :fail form nil :safe
                                  {:unsafe true :repairs (:repairs v)})
          false)

      :else
      (do (BeamLisp.TestRT/record ns :error form nil :safe
                                  {:unknown (:reason v)})
          false))))
