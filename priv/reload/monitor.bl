; reload/monitor.bl — render the live reload image for a human to watch.
;
; ── The one idea ────────────────────────────────────────────────────────
;
; `reload/inspect` is the read-model: the running image plus the event journal.
; A MONITOR turns that snapshot into something a person can watch change. This
; namespace holds the SHARED rendering — the CLI prints `render-text`, the web
; view pushes `render-view` (hiccup) over a socket. One read-model, two skins,
; so the terminal and the browser can never drift out of agreement about what
; the running system is doing.

(ns reload.monitor
  (:require [reload]))

;; ── shared helpers ───────────────────────────────────────────────────────

(defn- take-last
  "The last `n` elements of `coll` (fewer if shorter) — newest-window for the
   journal feed. Local because the prelude has `drop`/`take` but not `take-last`."
  [n coll]
  (let [c (count coll)]
    (if (> c n) (vec (drop (- c n) coll)) (vec coll))))

(defn- status-glyph
  "A single-char status marker so a whole image scans at a glance."
  [status]
  (cond
    (= status :applied) "✓"
    (= status :held)    "✗"
    (= status :blocked) "⊘"
    (= status :staged)  "…"
    :else               "·"))

(defn- event-line
  "One journal event as a terminal line: outcome, the namespaces it touched, and
   — for a hold — the first reason (the rest are one query away)."
  [ev]
  (let [glyph (status-glyph (:event ev))
        nses  (join ", " (:nses ev))
        why   (if (= :held (:event ev))
                (str "  — " (:msg (first (:errors ev))))
                "")]
    (str "  " glyph " " (name (:event ev)) "  " nses why)))

;; ── CLI: a text snapshot of the live image ───────────────────────────────

(defn render-text
  "The reload image as text, for a terminal monitor. Header line = current
   bundle status; then every application namespace with its var count; then the
   most recent journal events, newest last. `snap` is a `reload/inspect` map."
  [snap]
  (let [status (:status snap)
        nses   (:namespaces snap)
        recent (take-last 8 (:journal snap))]
    (join "\n"
      (concat
        [(str "── live image  [" (status-glyph status) " " (name status) "] ──")
         ""
         (str "  namespaces (" (count nses) "):")]
        (map (fn [e] (str "    " (:ns e) "  (" (:count e) " vars)")) nses)
        [""
         "  recent reloads:"]
        (if (empty? recent)
          ["    (none yet)"]
          (map event-line recent))))))

(defn print-snapshot
  "Print the current live image once — the CLI monitor's frame. Pulls a fresh
   `reload/inspect` and renders it."
  []
  (println (render-text (reload/inspect))))

;; ── Web: a hiccup view of the same read-model (final boss) ────────────────

(defn- ns-row
  "One namespace as a hiccup row: name, var count, and the var names as chips."
  [e]
  [:div {:class "ns-row"}
   [:span {:class "ns-name"} (:ns e)]
   [:span {:class "ns-count"} (str (:count e) " vars")]
   [:div {:class "ns-vars"}
    (map (fn [v] [:code {:class "var-chip"} v]) (:vars e))]])

(defn- event-row
  "One journal event as a hiccup row, classed by outcome so the CSS can colour a
   hold red and an applied green — a migration is visible the instant it lands."
  [ev]
  [:div {:class (str "ev ev-" (name (:event ev)))}
   [:span {:class "ev-kind"} (str (status-glyph (:event ev)) " " (name (:event ev)))]
   [:span {:class "ev-nses"} (join ", " (:nses ev))]
   (if (= :held (:event ev))
     [:span {:class "ev-why"} (:msg (first (:errors ev)))]
     [:span {:class "ev-ok"} (if (:migration ev) "with migration" "")])])

(defn render-view
  "The reload image as a hiccup document — the web monitor's body. Same snapshot
   as `render-text`, rendered for the browser: a status banner, the live
   namespace list, and the reload journal newest-FIRST (a feed reads top-down)."
  [snap]
  (let [status (:status snap)
        nses   (:namespaces snap)
        feed   (reverse (:journal snap))]
    [:div {:class "monitor"}
     [:div {:class (str "banner banner-" (name status))}
      [:span {:class "banner-glyph"} (status-glyph status)]
      [:span {:class "banner-text"} (str "live image — " (name status))]]
     [:div {:class "columns"}
      [:section {:class "col-nses"}
       [:h2 {} (str "namespaces (" (count nses) ")")]
       (map ns-row nses)]
      [:section {:class "col-feed"}
       [:h2 {} "reload journal"]
       (if (empty? feed)
         [:div {:class "empty"} "no reloads yet — edit a .bl file"]
         (map event-row feed))]]]))
