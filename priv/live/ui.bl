; live/ui.bl — an accessible component vocabulary, as functions.
;
; ── The idea ──────────────────────────────────────────────────────────
;
; A component is a function that returns hiccup, styled from tokens
; (live.style) and carrying the accessibility semantics most hand-written
; UIs forget: real labels, ARIA roles and states, keyboard affordances,
; visible focus, disabled handling. Because these are baked into the
; primitive, every button in the app is accessible by default — you cannot
; ship the broken version by accident.
;
; Every component is a pure function of its inputs, so it renders in SSG and
; drives the live socket unchanged. Events are the closed vocabulary the
; socket understands (live.socket): :on-click carries an [:intent …] or
; [:assign …] term, never a closure.
;
; The vocabulary here is deliberately small — the primitives a real product
; needs on day one. They compose into everything else.

(ns live.ui
  (:require [live.style :as s]))

;; ── helper: merge an author's :class/extra attrs onto a component ────
;;
;; Every component takes an optional leading attrs map so a caller can add a
;; test id, an event, or one more style without the component enumerating
;; every passthrough. `opts+` splits the component's own options from the
;; raw HTML attrs to forward.
(defn- attrs-of [args]
  (if (and (seq args) (map? (first args))) (first args) {}))
(defn- body-of [args]
  (if (and (seq args) (map? (first args))) (rest args) args))
(defn- forward [opts]
  ;; keys a component consumes itself, not forwarded to the DOM node
  (apply dissoc opts [:variant :size :tone :label :error :hint :name
                      :value :checked :open :title :style]))

;; ════════════════════════════════════════════════════════════════════
;; Button — the workhorse action
;; ════════════════════════════════════════════════════════════════════
;;
;; (ui/button {:variant :primary :on-click [:intent :save {}]} "Save")
;;
;; variants: :primary (accent) · :ghost (quiet) · :danger (destructive)
;; sizes:    :sm :md :lg
;; A disabled button sets the real `disabled` attr AND aria-disabled, and
;; drops its handler — you cannot fire a disabled action.

(defn- button-style [variant size]
  (let [pad (case size :sm [(s/space :1) (s/space :3)]
                       :lg [(s/space :3) (s/space :5)]
                       [(s/space :2) (s/space :4)])
        base {:display "inline-flex" :align-items "center" :gap (s/space :2)
              :padding (str (first pad) " " (second pad))
              :font-size (case size :sm (s/text :sm) :lg (s/text :lg) (s/text :md))
              :font-weight (s/weight :semibold)
              :line-height "1"
              :border "1px solid transparent"
              :border-radius (s/radius :md)
              :cursor "pointer"
              :transition (str "background " (s/tok :motion :fast) " " (s/tok :motion :ease)
                               ",transform " (s/tok :motion :fast) " " (s/tok :motion :ease))
              :user-select "none"}
        skin (case variant
               :primary {:background (s/color :accent) :color (s/color :accent-fg)}
               :danger  {:background (s/color :danger)  :color (s/color :accent-fg)}
               :ghost   {:background "transparent" :color (s/color :text)
                         :border-color (s/color :border)}
               {:background (s/color :surface-2) :color (s/color :text)
                :border-color (s/color :border)})]
    (merge base skin)))

(defn button
  [& args]
  (let [opts (attrs-of args)
        body (body-of args)
        variant (get opts :variant :default)
        size (get opts :size :md)
        disabled (get opts :disabled false)
        cls (s/sx (button-style variant size)
                  (if disabled {:opacity "0.5" :cursor "not-allowed"} {}))]
    (into [:button (merge {:class cls :type "button"}
                          (when disabled {:disabled true :aria-disabled "true"})
                          ;; a disabled button carries no handler at all
                          (if disabled (dissoc (forward opts) :on-click) (forward opts)))]
          body)))

;; ════════════════════════════════════════════════════════════════════
;; Field — a labelled text input, done right
;; ════════════════════════════════════════════════════════════════════
;;
;; (ui/field {:name :email :label "Email" :value v
;;            :on-input [:assign :email [:from :value]]
;;            :error "Not a valid address"})
;;
;; The label is a real <label for=…> tied to the input's id, so clicking it
;; focuses the field and a screen reader announces it. An error is wired via
;; aria-invalid + aria-describedby, so assistive tech reads the message.

(defn field
  [opts]
  (let [name (get opts :name)
        id (str "f-" (if (keyword? name) (clojure.core/name name) name))
        label (get opts :label)
        value (get opts :value "")
        error (get opts :error)
        hint (get opts :hint)
        err-id (str id "-err")
        hint-id (str id "-hint")
        described (join " " (filterv some? [(when hint hint-id) (when error err-id)]))
        wrap-cls (s/sx {:display "flex" :flex-direction "column" :gap (s/space :1)
                        :margin-bottom (s/space :4)})
        label-cls (s/sx {:font-size (s/text :sm) :font-weight (s/weight :medium)
                         :color (s/color :muted)})
        input-cls (s/sx {:padding (str (s/space :2) " " (s/space :3))
                         :font-size (s/text :md)
                         :color (s/color :text)
                         :background (s/color :surface)
                         :border (str "1px solid " (if error (s/color :danger) (s/color :border)))
                         :border-radius (s/radius :md)
                         :transition (str "border-color " (s/tok :motion :fast) " " (s/tok :motion :ease))})
        err-cls (s/sx {:font-size (s/text :sm) :color (s/color :danger)})
        hint-cls (s/sx {:font-size (s/text :sm) :color (s/color :faint)})]
    [:div {:class wrap-cls}
     (when label [:label {:class label-cls :for id} label])
     [:input (merge {:class input-cls :id id :value value :type (get opts :type "text")}
                    (when (not= described "") {:aria-describedby described})
                    (when error {:aria-invalid "true"})
                    (forward (dissoc opts :label :hint :error :name :value :type)))]
     (when hint [:div {:class hint-cls :id hint-id} hint])
     (when error [:div {:class err-cls :id err-id :role "alert"} error])]))

;; ════════════════════════════════════════════════════════════════════
;; Card — a surface for grouping
;; ════════════════════════════════════════════════════════════════════

(defn card
  [& args]
  (let [opts (attrs-of args)
        body (body-of args)
        cls (s/sx {:background (s/color :surface)
                   :border (str "1px solid " (s/color :border))
                   :border-radius (s/radius :lg)
                   :padding (s/space :5)
                   :box-shadow (s/shadow :sm)}
                  (get opts :style {}))]
    (into [:div (merge {:class cls} (forward opts))] body)))

;; ════════════════════════════════════════════════════════════════════
;; Stack / Row — layout primitives (no more margin guessing)
;; ════════════════════════════════════════════════════════════════════
;;
;; A Stack lays children out vertically with a token gap; a Row horizontally.
;; Consistent spacing everywhere, from the scale, by name.

(defn stack
  [& args]
  (let [opts (attrs-of args) body (body-of args)
        gap (get opts :gap :4)
        cls (s/sx {:display "flex" :flex-direction "column" :gap (s/space gap)}
                  (get opts :style {}))]
    (into [:div (merge {:class cls} (forward opts))] body)))

(defn row
  [& args]
  (let [opts (attrs-of args) body (body-of args)
        gap (get opts :gap :3)
        cls (s/sx {:display "flex" :flex-direction "row" :align-items (get opts :align "center")
                   :gap (s/space gap)}
                  (get opts :style {}))]
    (into [:div (merge {:class cls} (forward opts))] body)))

;; ════════════════════════════════════════════════════════════════════
;; Text — typographic roles, from the scale
;; ════════════════════════════════════════════════════════════════════
;;
;; (ui/heading 1 "Title")  ·  (ui/text {:tone :muted} "subtitle")

(defn heading
  [level & body]
  (let [sz (case level 1 :2xl 2 :xl 3 :lg :md)
        cls (s/sx {:font-size (s/text sz) :font-weight (s/weight :bold)
                   :line-height (s/tok :leading :tight) :color (s/color :text)})]
    (into [(keyword (str "h" level)) {:class cls}] body)))

(defn prose
  [& args]
  (let [opts (attrs-of args) body (body-of args)
        tone (get opts :tone :default)
        cls (s/sx {:font-size (s/text :md) :line-height (s/tok :leading :relaxed)
                   :color (case tone :muted (s/color :muted) :faint (s/color :faint)
                                     (s/color :text))})]
    (into [:p (merge {:class cls} (forward opts))] body)))

;; ════════════════════════════════════════════════════════════════════
;; Badge — a small status pill
;; ════════════════════════════════════════════════════════════════════

(defn badge
  [& args]
  (let [opts (attrs-of args) body (body-of args)
        tone (get opts :tone :default)
        bg (case tone :success (s/color :success) :danger (s/color :danger)
                      :accent (s/color :accent) (s/color :surface-2))
        cls (s/sx {:display "inline-flex" :align-items "center"
                   :padding (str (s/space :0) " " (s/space :2))
                   :height (s/space :5)
                   :font-size (s/text :xs) :font-weight (s/weight :semibold)
                   :color (s/color :accent-fg) :background bg
                   :border-radius (s/radius :full)})]
    (into [:span (merge {:class cls} (forward opts))] body)))
