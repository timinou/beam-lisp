; live/style.bl — a design language, expressed as values.
;
; ── The idea ──────────────────────────────────────────────────────────
;
; World-class UX is not a CSS file. It is a small, coherent set of DECISIONS
; — a spacing scale, a type scale, a colour system, motion timings — applied
; consistently everywhere. When those decisions are DATA, the machine can
; enforce the consistency: you cannot pick an off-scale value by accident,
; and every place that wants "medium space" gets the exact same pixels.
;
; This module has three layers:
;
;   1. TOKENS   — the design decisions, as data. One source of truth for
;                 colour, space, radius, type, shadow, motion.
;   2. `sx`     — turn a style MAP into a stable, hashed CSS class. Identical
;                 styles collapse to one class (atomic CSS from a value). No
;                 CSS files, no class-naming, no collisions.
;   3. `collect`— gather every class a page used into one <style> block for
;                 the document head (SSG) or the socket mount (live).
;
; The whole thing is deterministic: same style map anywhere ⇒ same class ⇒
; one rule. That is what makes a design SYSTEM instead of a pile of styles.

(ns live.style)

;; ════════════════════════════════════════════════════════════════════
;; 1. TOKENS — the design decisions, as data
;; ════════════════════════════════════════════════════════════════════
;;
;; These are opinionated defaults chosen for balance and rhythm. An app may
;; override any of them by rebinding `tokens` (they are a plain map). The
;; point is not these exact numbers — it is that there IS one scale, and
;; everything refers to it by name.

(def tokens
  {;; ── colour: a neutral ramp + a single accent, with semantic roles ──
   :color
   {:bg        "#0b0c0e"      ; page background (dark, calm)
    :surface   "#151719"      ; raised surfaces (cards, dialogs)
    :surface-2 "#1e2124"      ; a second elevation
    :border    "#2a2e33"      ; hairline separators
    :text      "#e8eaed"      ; primary text (high contrast, not pure white)
    :muted     "#9aa0a6"      ; secondary text
    :faint     "#5f656b"      ; disabled / placeholder
    :accent    "#5b8def"      ; the one brand colour — actions, focus
    :accent-fg "#ffffff"      ; text ON the accent
    :danger    "#e5534b"      ; destructive
    :success   "#3fb950"}     ; positive

   ;; ── space: a 4px base, geometric-ish — never guess a margin again ──
   :space
   {:0 "0"      :1 "4px"   :2 "8px"   :3 "12px"  :4 "16px"
    :5 "24px"   :6 "32px"  :7 "48px"  :8 "64px"  :9 "96px"}

   ;; ── radius: soft, consistent corners ──
   :radius
   {:none "0"   :sm "4px"  :md "8px"  :lg "14px" :full "9999px"}

   ;; ── type: a modular scale + weights + a real font stack ──
   :font
   {:sans "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
    :mono "'SF Mono', 'JetBrains Mono', Menlo, monospace"}
   :text
   {:xs "12px"  :sm "14px"  :md "16px"  :lg "20px"
    :xl "26px"  :2xl "34px" :3xl "46px"}
   :weight
   {:normal "400" :medium "500" :semibold "600" :bold "700"}
   :leading
   {:tight "1.15" :normal "1.5" :relaxed "1.7"}

   ;; ── elevation: shadows that imply height, not decoration ──
   :shadow
   {:none "none"
    :sm "0 1px 2px rgba(0,0,0,.3)"
    :md "0 4px 12px rgba(0,0,0,.35)"
    :lg "0 12px 32px rgba(0,0,0,.45)"}

   ;; ── motion: timings + easings that feel intentional, not laggy ──
   :motion
   {:fast "120ms" :base "200ms" :slow "320ms"
    :ease "cubic-bezier(.2,.8,.2,1)"        ; a confident ease-out
    :spring "cubic-bezier(.34,1.56,.64,1)"}}) ; a subtle overshoot

;; ── token lookup: `(tok :space :4)` → "16px" ──────────────────────
;;
;; Fails LOUD on an unknown token. A typo'd scale value is a design bug you
; want to catch, not a silently-dropped style.
(defn tok
  [category key]
  (let [cat (get tokens category)]
    (when (nil? cat) (throw (str "style: no token category " (pr-str category))))
    (let [v (get cat key)]
      (when (nil? v)
        (throw (str "style: no token " (pr-str category) " / " (pr-str key)
                    " — must be one of " (pr-str (keys cat)))))
      v)))

;; convenience shorthands for the categories used constantly
(defn color   [k] (tok :color k))
(defn space   [k] (tok :space k))
(defn radius  [k] (tok :radius k))
(defn text    [k] (tok :text k))
(defn weight  [k] (tok :weight k))
(defn shadow  [k] (tok :shadow k))

;; ════════════════════════════════════════════════════════════════════
;; 2. sx — a style map → a stable, hashed, deduped CSS class
;; ════════════════════════════════════════════════════════════════════
;;
;; `sx` takes a map of CSS properties and returns a class NAME. It also
;; RECORDS the rule so `collect` can emit it later. Two identical style maps
;; anywhere in the app produce the same class and one rule — atomic CSS,
;; generated from a value, with zero naming and zero collisions.
;;
;; The recording uses a process dictionary keyed per render, so a single
;; page render collects exactly the classes it used. (A live socket calls
;; `with-sheet` around each render; see below.)

(defn- css-value [v]
  (cond (keyword? v) (name v)
        :else (str v)))

(defn- prop->decl [kv]
  (str (name (first kv)) ":" (css-value (second kv))))

(defn style->css
  "A style map → a canonical CSS declaration string. Keys are SORTED, so the
   same set of declarations always serialises identically ⇒ same hash ⇒ same
   class, regardless of authoring order."
  [m]
  (join ";" (map prop->decl (sort-by (fn [kv] (name (first kv))) (seq m)))))

(defn- class-for [css]
  ;; a short, stable, collision-resistant name from the rule's content
  (str "s" (Integer/to_string (erlang/phash2 css) 36)))

;; the per-render sheet: an ordered map of class → css, in the process dict
(def ^:private sheet-key :live.style/sheet)

(defn- record! [cls css]
  (let [sheet (or (Process/get sheet-key) {})]
    (Process/put sheet-key (assoc sheet cls css))
    cls))

(defn sx
  "Register a style map and return its class name. Merges multiple maps
   left-to-right first (later keys win), so you can compose:
     (sx base-card {:padding (space :5)})
   returns e.g. \"sX7q2\"; the rule is recorded for `collect`."
  [& maps]
  (let [m (apply merge maps)
        css (style->css m)
        cls (class-for css)]
    (record! cls css)))

;; ════════════════════════════════════════════════════════════════════
;; 3. collect — every used class, as one <style> block
;; ════════════════════════════════════════════════════════════════════

(defn reset-sheet! []
  (Process/put sheet-key {})
  nil)

(defn sheet-css
  "The CSS text for every class registered so far this render: one rule per
   line, in insertion order (stable output for diffing and caching)."
  []
  (let [sheet (or (Process/get sheet-key) {})]
    (join "\n" (map (fn [kv] (str "." (first kv) "{" (second kv) "}")) (seq sheet)))))

(defn base-css
  "The document-level base: the reset and the token-driven body defaults.
   Emitted once per page, before the atomic classes. This is where the
   design language sets the room's lighting — background, text colour, font,
   rhythm — so every page starts coherent."
  []
  (str
    "*,*::before,*::after{box-sizing:border-box;margin:0}"
    "html{-webkit-text-size-adjust:100%}"
    "body{"
      "background:" (color :bg) ";"
      "color:" (color :text) ";"
      "font-family:" (tok :font :sans) ";"
      "font-size:" (text :md) ";"
      "line-height:" (tok :leading :normal) ";"
      "-webkit-font-smoothing:antialiased"
    "}"
    "a{color:" (color :accent) ";text-decoration:none}"
    "a:hover{text-decoration:underline}"
    ;; respect the user's motion preference — an accessibility MUST
    "@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}"
    ;; a visible, on-brand focus ring for keyboard users everywhere
    ":focus-visible{outline:2px solid " (color :accent) ";outline-offset:2px}"))

(defn style-tag
  "A complete <style> element (base + all collected atomic classes) for the
   document head. Call AFTER rendering the body, so every `sx` used has been
   recorded."
  []
  [:style (str (base-css) "\n" (sheet-css))])

;; ── with-sheet: scope a render so its classes are collected cleanly ─
;;
;; Runs `render-fn` (a 0-arg fn returning hiccup) with a fresh sheet, and
;; returns {:tree hiccup :style [:style …]}. SSG uses this to build a full
;; page; the live socket uses it per render so each patch carries only the
;; classes it needs.
(defn with-sheet
  [render-fn]
  (reset-sheet!)
  (let [tree (render-fn)]
    {:tree tree :style (style-tag)}))
