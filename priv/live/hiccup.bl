; live/hiccup.bl — a hiccup tree → HTML string. The view's output side.
;
; ── What this is ──────────────────────────────────────────────────────
;
; A view in this system is a PURE function `db → hiccup` (see PLAN-052). A
; hiccup tree is ordinary beam-lisp data:
;
;   [:tag attrs? child*]   an element   (attrs is an optional leading map)
;   "text"                 a text node  (HTML-escaped)
;   a number               a text node
;   a SEQ in child slot    spliced      (so `(for …)` yields many children)
;   nil                    dropped
;
; The tag keyword carries Clojure/hiccup shorthand: `:div#id.a.b` is a
; `<div>` with id `id` and classes `a b`. The reader already tokenises that
; as ONE keyword (`#` and `.` are not reader delimiters), so the split is
; done HERE, at render time, and nowhere else.
;
; ── Two reserved attribute kinds ──────────────────────────────────────
;
;   :key      identity for the differ (live/diff). STRIPPED from HTML — it
;             is a diff concern, never a DOM attribute. (It also rides as
;             vector metadata via `^{:key …}`; both are read by the differ.)
;   :on-EVENT a wire binding (an event term). STRIPPED from the HTML body
;             and re-emitted as a `data-ev-EVENT` marker the client hook
;             binds. The VALUE (an [:intent …]/[:assign …] term) never
;             reaches the browser as an attribute; the client learns the
;             binding out of band. Here we only mark WHICH events a node
;             wants, so the shell is inert-but-annotated before JS.
;
; ── Why a string, not a DOM ───────────────────────────────────────────
;
; First paint is server-rendered HTML: a real page before any JS, the
; progressive-enhancement floor. After connect, live/diff computes patches
; against the hiccup VALUE (not the string), so this renderer is only ever
; called for the initial mount and for a subtree `:replace`. That is why it
; is allowed to be the simple, obvious thing.

(ns live.hiccup)

;; ── void elements: no closing tag, no children ──────────────────────
;;
;; The HTML spec's void elements. A child on one of these is a bug in the
;; view; we render the open tag only (the child is silently unreachable in
;; a browser regardless, so raising here would be stricter than the DOM).

(def ^:private void-tags
  #{"area" "base" "br" "col" "embed" "hr" "img" "input"
    "link" "meta" "param" "source" "track" "wbr"})

;; ── HTML escaping ───────────────────────────────────────────────────
;;
;; Text and attribute values are escaped. The five characters that can
;; break out of text or a double-quoted attribute context. `&` first, or a
;; later replacement's `&` would be double-escaped.

(defn escape
  "HTML-escape a string for text and double-quoted attribute contexts."
  [s]
  (-> (str s)
      (replace-str "&" "&amp;")
      (replace-str "<" "&lt;")
      (replace-str ">" "&gt;")
      (replace-str "\"" "&quot;")
      (replace-str "'" "&#39;")))

;; ── tag-keyword shorthand: :div#id.a.b → {:tag :id :classes} ────────

(defn parse-tag
  "Split a hiccup tag keyword into {:tag :id :classes}.

   `:div#main.card.wide` → {:tag \"div\" :id \"main\" :classes [\"card\" \"wide\"]}
   `:section.panel`       → {:tag \"section\" :id nil :classes [\"panel\"]}
   `:h1`                  → {:tag \"h1\" :id nil :classes []}

   The id is the `#`-segment (at most one); classes are the `.`-segments.
   Order between `#` and `.` does not matter — an id is found wherever the
   `#` is, and every `.`-segment that is not part of the id is a class."
  [kw]
  (let [s (name kw)
        ;; the tag is everything up to the first '#' or '.'
        hash-i (index-of s "#")
        dot-i (index-of s ".")
        cut (cond
              (and (nil? hash-i) (nil? dot-i)) (count s)
              (nil? hash-i) dot-i
              (nil? dot-i) hash-i
              :else (min hash-i dot-i))
        tag (subs s 0 cut)
        rest-str (subs s cut (count s))
        ;; walk the remainder: '#seg' sets id, '.seg' adds a class
        segs (filterv (fn [x] (not= x ""))
                      (split (replace-str rest-str "#" ".#") "."))
        id (reduce (fn [acc seg]
                     (if (starts-with? seg "#") (subs seg 1 (count seg)) acc))
                   nil segs)
        classes (filterv (fn [seg] (not (starts-with? seg "#"))) segs)]
    {:tag tag :id id :classes classes}))

;; ── attribute rendering ─────────────────────────────────────────────

(defn- event-attr?
  "Whether an attribute key is a wire event binding (`:on-click`, …)."
  [k]
  (starts-with? (name k) "on-"))

(defn- render-attr
  "One attribute as a string fragment (with a leading space), or \"\" when
   it contributes nothing. `:key`/`:id`/`:class` are handled by the caller
   (merged with the tag shorthand), so they are skipped here.

     true          → a bare boolean attribute (` disabled`)
     false / nil   → omitted entirely (carries no information)
     :on-EVENT     → `data-ev-EVENT` marker (the value stays server-side)
     otherwise     → `k=\"escaped-value\"`"
  [k v]
  (let [kn (name k)]
    (cond
      (contains? #{"id" "class"} kn) ""
      ;; :key becomes data-key: the DOM needs it so the client can address
      ;; keyed children for insert/remove/move, exactly as the differ does.
      (= kn "key") (str " data-key=\"" (escape v) "\"")
      (event-attr? k) (str " data-ev-" (subs kn 3 (count kn)))
      (= v true) (str " " kn)
      (or (= v false) (nil? v)) ""
      :else (str " " kn "=\"" (escape v) "\""))))

(defn- render-attrs
  "The full attribute string for an element, merging the tag shorthand's
   id/classes with the attrs map. Explicit `:id` wins over the shorthand's;
   classes CONCATENATE (shorthand first, then `:class`)."
  [shorthand attrs]
  (let [id (or (get attrs :id) (:id shorthand))
        cls-list (concat (:classes shorthand)
                         (let [c (get attrs :class)] (if (nil? c) [] [c])))
        cls (join " " cls-list)]
    (str (if (nil? id) "" (str " id=\"" (escape id) "\""))
         (if (= cls "") "" (str " class=\"" (escape cls) "\""))
         (join "" (map (fn [kv] (render-attr (first kv) (second kv))) (seq attrs))))))

;; ── the renderer ────────────────────────────────────────────────────

(defn- element?
  "A hiccup element: a vector whose head is a keyword."
  [node]
  (and (vector? node) (> (count node) 0) (keyword? (first node))))

(defn hiccup->html
  "Render a hiccup tree to an HTML string.

   Elements are `[:tag attrs? child*]`; a leading map is attributes. A seq
   in child position splices (so `(for …)` produces adjacent children). A
   string/number is escaped text. nil is dropped. A vector whose head is
   not a keyword is an error (a common shape mistake — a list of children
   handed where an element was expected)."
  [node]
  (cond
    (nil? node) ""
    (string? node) (escape node)
    (number? node) (str node)
    (element? node)
      (let [has-attrs (and (> (count node) 1) (map? (nth node 1)))
            attrs (if has-attrs (nth node 1) {})
            children (if has-attrs (drop 2 node) (rest node))
            sh (parse-tag (first node))
            tag (:tag sh)
            open (str "<" tag (render-attrs sh attrs) ">")]
        (if (contains? void-tags tag)
          open
          (str open
               (join "" (map hiccup->html children))
               "</" tag ">")))
    ;; a seq in child position: splice its rendered children
    (seq? node) (join "" (map hiccup->html node))
    (vector? node)
      (throw (str "hiccup: a vector child must be an element [:tag …], got "
                  (pr-str node)
                  " — a bare list of children should be a seq, not a vector"))
    :else (escape node)))
