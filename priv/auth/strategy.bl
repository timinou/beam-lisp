; auth/strategy.bl — identity strategies as functions, not behaviours.
;
; ── What this is ──────────────────────────────────────────────────────
;
; Ash models each login method (password, oauth, api-key) as a BEHAVIOUR —
; a module with callbacks, opaque and un-introspectable. The beam-lisp
; inversion: a strategy is a FUNCTION `params → authority-facts`. Password
; verification, an OAuth claim map, an API key — each is just a function
; that, given credentials, returns the facts a token will carry (or nil
; when the credentials are bad).
;
; That is the whole abstraction. It is a value you can register, list,
; print, and test in isolation with a literal params map — no framework,
; no generated module, no `Info` reflection. The registry is a plain map
; from name to function.
;
; ── Scope boundary ────────────────────────────────────────────────────
;
; A strategy turns VERIFIED credentials into facts. It does NOT run the
; OAuth provider dance (exchanging a code for a token with GitHub/Google)
; — that transport belongs elsewhere (req_llm). `auth` begins where the
; identity is already established and mints a capability from it. So the
; `:github` strategy takes already-verified claims; it never speaks OAuth.

(ns auth.strategy)

;; ── the registry ────────────────────────────────────────────────────
;;
;; A registry is `{name fn}`; a strategy fn is `(params) → [tuple…] | nil`.
;; nil means "these credentials did not authenticate" — distinct from `[]`
;; which would be "authenticated, but grants no facts". Keeping the
;; registry a plain map means composing two apps' strategies is `merge`.

(defn registry
  "An empty strategy registry."
  []
  {})

(defn register
  "Add strategy `name` (a keyword) with resolver `f` to `reg`.

   `f` is `(params) → authority-fact-tuples | nil`. Registration is pure —
   it returns a new registry — so an app assembles its strategies as a
   value rather than mutating global state."
  [reg name f]
  (assoc reg name f))

(defn run
  "Run strategy `name` in `reg` against `params`.

   Returns the authority-fact tuples the strategy produced, or nil if the
   credentials failed. An unknown strategy is a programming error (the app
   asked for a method it never registered) and fails loud, distinct from a
   credential failure which returns nil."
  [reg name params]
  (let [f (get reg name)]
    (if (nil? f)
      (throw (ex-info "unknown strategy" {:name name :known (keys reg)}))
      (f params))))

;; ── built-in strategy builders ──────────────────────────────────────
;;
;; These are FUNCTIONS THAT RETURN strategy functions, configured for a
;; resource's field layout. They are conveniences over the raw `(params)
;; → facts` shape, not a privileged mechanism — an app can always register
;; a bare function instead.

(defn password-strategy
  "A password strategy: verify a credential, emit identity facts.

   `verify-fn` is `(identity, password) → bool` — the app supplies it
   because password HASHING is the app's concern (it owns the hash store
   and the algorithm). `identity-key`/`password-key` name the params. On
   success the strategy emits `[(user <identity>)]`; the app can attenuate
   or enrich from there. On failure it returns nil.

   Keeping verification injected means this builder never touches a
   password hash itself — it orchestrates, the app cryptographically
   verifies, and the seam between them is one boolean."
  [identity-key password-key verify-fn]
  (fn [params]
    (let [identity (get params identity-key)
          password (get params password-key)]
      (if (and (some? identity) (some? password) (verify-fn identity password))
        [["user" identity]]
        nil))))

(defn claims-strategy
  "A strategy over already-verified external claims (OAuth/OIDC/SAML).

   `claims->facts` is `(claims) → fact-tuples`; the transport that
   PRODUCED the verified claims (a provider dance, a SAML assertion) ran
   elsewhere, so this strategy only maps a trusted claim map to authority
   facts. `claims-key` names where the claims sit in params.

   This is the single shape every federated method reduces to — the reason
   §SSO in the design is 'a trust anchor + an attribute map + a
   claims→facts function' and nothing more."
  [claims-key claims->facts]
  (fn [params]
    (let [claims (get params claims-key)]
      (if (nil? claims)
        nil
        (claims->facts claims)))))

(defn api-key-strategy
  "An API-key strategy: look the key up, emit the service's facts.

   `lookup-fn` is `(key) → fact-tuples | nil` — the app resolves a
   presented key to the facts it grants (or nil if unknown/revoked). An
   API key is the long-lived analogue of a login: same shape, `params →
   facts`, so it needs no separate machinery. `key-key` names the param."
  [key-key lookup-fn]
  (fn [params]
    (let [key (get params key-key)]
      (if (nil? key) nil (lookup-fn key)))))
