; auth/password.bl — password verification as a value.
;
; ── The one idea ────────────────────────────────────────────────────
;
; auth.strategy already says "a login is a function params → facts". The
; PASSWORD login needs one thing that function cannot make up: a way to
; check a presented password against a stored secret WITHOUT the app
; hand-rolling a KDF. That is this file — and nothing more.
;
; A password is never stored. What is stored is a self-describing
; VERIFIER string:
;
;     pbkdf2$sha256$<iterations>$<salt-b64>$<hash-b64>
;
; It carries its own algorithm, iteration count, and salt, so `verify`
; needs no config to check it and a future cost bump is a per-record
; migration, not a flag day. This is the PHC-string shape (argon2/bcrypt
; use the same idea); we use PBKDF2-HMAC-SHA256 because it is an OTP
; crypto BIF — no native dependency, present on every BEAM.
;
; ── Why it lives in `auth`, not the app ─────────────────────────────
;
; Every app that has passwords needs exactly this pair, written exactly
; once, correctly (random per-password salt, constant-time compare). A
; product re-deriving it is how timing leaks and reused salts happen. The
; strategy layer stays a pure `params → facts` function; this is the one
; boolean it calls out to (`auth.strategy/password-strategy` takes a
; `verify-fn` for precisely this reason).

(ns auth.password)

;; ── parameters ──────────────────────────────────────────────────────
;;
;; Iterations: OWASP's floor for PBKDF2-HMAC-SHA256 is high because the
;; KDF is meant to be slow for an attacker; but this is a native C BIF, so
;; even a large count is milliseconds. 210_000 is a current, defensible
;; default. It is STORED in every verifier, so raising it here only affects
;; NEW passwords — old ones still verify at their own recorded cost.

(def ^:private ALG "pbkdf2")
(def ^:private DIGEST "sha256")
(def ^:private ITERATIONS 210000)
(def ^:private SALT-BYTES 16)
(def ^:private KEY-BYTES 32)

;; ── the KDF call ────────────────────────────────────────────────────

(defn- derive
  "PBKDF2-HMAC-SHA256 of `plain` (a binary) with `salt` at `iters`,
   yielding a `KEY-BYTES`-long binary. A thin, single-call wrapper so the
   exact BIF arguments live in one place."
  [plain salt iters]
  (erlang/apply :crypto :pbkdf2_hmac
                (list (String/to_atom DIGEST) plain salt iters KEY-BYTES)))

;; ── hashing ─────────────────────────────────────────────────────────

(defn hash-password
  "A verifier string for `plain` — never the password itself.

   Generates a fresh random salt (so two identical passwords hash
   differently, defeating precomputation), derives the key, and returns
   the self-describing `pbkdf2$sha256$<iters>$<salt64>$<hash64>` string to
   store in `:principal/password-hash`. Standard base64 is safe between the
   `$` separators (its alphabet has no `$`)."
  [plain]
  (let [salt (erlang/apply :crypto :strong_rand_bytes (list SALT-BYTES))
        dk (derive plain salt ITERATIONS)]
    (str ALG "$" DIGEST "$" ITERATIONS "$"
         (Base/encode64 salt) "$" (Base/encode64 dk))))

;; ── verifying ───────────────────────────────────────────────────────

(defn- constant-time=?
  "Whether two binaries are equal, in time independent of WHERE they
   first differ — the property a naive `=` on secret-derived bytes lacks,
   and the reason a byte-by-byte password check leaks length/prefix. Uses
   the crypto BIF built for exactly this."
  [a b]
  (erlang/apply :crypto :hash_equals (list a b)))

(defn verify-password
  "Whether `plain` matches the stored verifier `stored`.

   Re-derives with the salt and iteration count PARSED FROM `stored` (so a
   verifier written at any past cost still checks), then compares in
   constant time. A malformed or non-pbkdf2 verifier returns false rather
   than throwing — an unreadable secret authenticates no one. nil-safe on
   both arguments."
  [plain stored]
  (if (or (nil? plain) (nil? stored))
    false
    (let [parts (String/split stored "$")]
      (if (not= 5 (count parts))
        false
        (let [alg (nth parts 0)
              iters (nth parts 2)
              salt-b64 (nth parts 3)
              hash-b64 (nth parts 4)]
          (if (not= alg ALG)
            false
            ;; a verifier whose salt/hash/iters no longer parse (tampered,
            ;; truncated, bad padding) authenticates no one — false, not a throw.
            (try
              (let [salt (Base/decode64! salt-b64)
                    expected (Base/decode64! hash-b64)
                    iters-n (erlang/binary_to_integer iters)
                    actual (derive plain salt iters-n)]
                (constant-time=? actual expected))
              (catch _e false))))))))

;; ── the strategy resolver ───────────────────────────────────────────
;;
;; The shape `auth.strategy/password-strategy` wants: a `(identity,
;; password) → bool` closure that looks the identity up via `lookup-fn`
;; (the app owns the store) and verifies against the stored verifier. The
;; app registers `(auth/password-strategy :email :password (verifier
;; lookup))` and never touches a hash itself.

(defn verifier
  "A `(identity, password) → bool` fn for `auth/password-strategy`, backed
   by `lookup-fn` (`identity → stored-verifier | nil`). An unknown identity
   verifies as false — same shape as a wrong password, so the strategy
   leaks nothing about which of the two failed."
  [lookup-fn]
  (fn [identity password]
    (verify-password password (lookup-fn identity))))
