; auth/sandbox.bl — tokens → environment capabilities.
;
; ── The one idea ────────────────────────────────────────────────────
;
; The capability gate (Env.fork's `:caps`) takes a set of modules. The
; auth package mints/attenuates/verifies RIGHTS as Biscuit datalog. This
; namespace is the seam: authorize the token — full Biscuit semantics:
; signature chain, block-scoped checks, deny-overrides policies, the
; revocation oracle — and on :allow, PROJECT the authority block's
; `right($module, $op)` facts into the module set the gate consumes.
;
;     (auth/caps-for root-pub token ctx)
;       → {:ok ["Elixir.String" "Elixir.File"]}   ; fork with these
;       → {:error {:verdict :deny :reason …}}     ; do not fork
;
; ── Why the authority block is the whole projection ─────────────────
;
; Biscuit block scoping (auth.engine/origin) says facts in APPENDED blocks
; are invisible to authority-origin queries — an appended block can add
; checks (which fail closed) but can never add a RIGHT the authorizer-side
; rules would consume. So the authority block's rights are exactly the
; ceiling; attenuation expresses itself through authorize's VERDICT (time
; checks, revocation, ambient deny policies), not through a mutated right
; set. Narrowing per delegation is the runtime's ambient policy plus
; Env.fork's structural intersection — token-derived set ∩ parent caps.
;
; ── The atom discipline, again ──────────────────────────────────────
;
; Module names come from token symbol tables: attacker-controlled strings.
; They pass through `env/module-atom` (binary_to_existing_atom): a name no
; loaded module owns drops out of the set, and no junk atom is ever
; interned. Fail closed, by the same rule datalog.bl states.

(ns auth.sandbox
  (:require [auth.authorizer :as authorizer]
            [auth.biscuit.datalog :as dl]
            [env]))

(defn- right-facts
  "The `right` fact tuples a DECODED block asserts: `[\"right\" module op]`."
  [decoded-block]
  (filter (fn [t] (= (first t) "right"))
          (map dl/predicate->tuple (:facts decoded-block))))

(defn- rights->caps
  "Project `right(module, op)` facts into caps entries: the `call` op is
   the generic grant — a bare module, every op; any other op becomes a
   [module op] pair the gate checks against Env's op table."
  [facts]
  (distinct
    (map (fn [t]
           (let [m (nth t 1) op (nth t 2)]
             (if (= op "call") m [m op])))
         facts)))

(defn caps-for
  "Authorize `token` against `ctx` (a full authorizer context — facts,
   policies, optional revocation oracle) under `root-pub`; on :allow,
   return {:ok modules} — the authority block's granted modules as a
   vector of name strings, ready for `env/fork`'s `:caps` opt. On :deny,
   return {:error verdict}: the caller must NOT fork, and the verdict's
   :reason (:invalid-signature / :revoked / :failed-check / :deny-policy /
   :no-matching-policy) is the audit trail.

   Pure: same token, same ctx, same root ⇒ same decision, always."
  [root-pub token ctx]
  (let [verdict (authorizer/authorize root-pub token ctx)]
    (if (= (:verdict verdict) :allow)
      (let [authority (dl/decode-block (:data (:authority token)))
            entries (rights->caps (right-facts authority))]
        {:ok (vec (filter some? (map env/caps-entry entries)))})
      {:error verdict})))

(defn sandbox-fork
  "Authorize `token`, and on :allow fork `parent` with exactly the granted
   caps — the one-call shape of 'enter this entity's sandbox'. Returns
   {:ok env-id} | {:error verdict}. The caller binds with env/with-env
   or env/isolated."
  [root-pub token ctx parent]
  (let [r (caps-for root-pub token ctx)]
    (if (contains? r :ok)
      {:ok (env/fork parent {:caps (:ok r)})}
      r)))

(defn sandbox-fork*
  "sandbox-fork over a PRE-COMPUTED verdict — for callers (audit) that
   must authorize once and act on the decision themselves. Same fork,
   no second authorization."
  [token verdict parent]
  (if (= (:verdict verdict) :allow)
    (let [authority (dl/decode-block (:data (:authority token)))
          entries (rights->caps (right-facts authority))
          caps (vec (filter some? (map env/caps-entry entries)))]
      {:ok (env/fork parent {:caps caps})})
    {:error verdict}))
