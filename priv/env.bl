; priv/env.bl — the environment API, as a namespace.
;
; ── Why this exists ─────────────────────────────────────────────────
;
; PLAN-046 made environments first-class: a test, a tenant, an agent
; each runs in a private fork of the runtime. But reaching that API from
; beam-lisp meant raw host interop — `(BeamLisp.Env/fork …)` — which is
; two smells at once: it reads like Elixir leaking through, and under the
; capability gate it would require granting the `BeamLisp.Env` MODULE to
; every sandbox that merely wants to manage its own scope. The sandbox
; API should not itself be a capability.
;
; So this namespace is the surface: `(:require [env])`, then plain
; namespaced fns — `(env/fork)`, `(env/with-env e f)` — compiled once, at
; `:global`, as trusted substrate (the same doctrine as `core` and
; `interop`): the wrapper's interop is the app's deliberate grant; what a
; sandbox can DO with the API is what caps govern.
;
; ── The vocabulary ──────────────────────────────────────────────────
;
;   (env/current)             → this process's env id (:global or {:env ref})
;   (env/fork)                → a fresh env, parent = current
;   (env/fork parent {:caps ["Elixir.String"]})   → a NARROWER env
;   (env/with-env e (fn [] …))  → run a thunk with e bound
;   (env/isolated (fn [] …))    → fork + bind + destroy around one thunk
;   (env/capture) / (env/bind token)            → cross a process boundary
;   (env/caps) / (env/allowed? "Elixir.File")   → what may I call?
;   (env/eval src)              → compile+run source in the CURRENT env
;   (env/destroy e)             → drop an env's rows
;
; Caps specs take module names as STRINGS ("Elixir.File", ":os" for the
; Erlang module :os) and intern them through `interop/module` —
; binary_to_existing_atom, so a name no loaded module owns simply drops
; OUT of the set (fail closed) and a hostile string never grows the atom
; table. This is the same discipline auth.biscuit.datalog applies to
; attacker-controlled token symbols.

(ns env
  (:require [interop]))

;; ── caps specs -------------------------------------------------------

(defn module-atom
  "The atom for a caps-spec module name string, or nil if no such loaded
   module exists. Nil entries are dropped by `fork` — an ungrantable name
   fails CLOSED (absent from the set), never open."
  [name]
  (try
    (interop/module name)
    (catch _ nil)))

(defn- caps-spec
  "Normalize a `:caps` opt (`:all` or a seq of name strings) into the
   shape BeamLisp.Env/fork expects."
  [spec]
  (if (= spec :all)
    :all
    (vec (filter some? (map module-atom spec)))))

(defn- fork-opts [opts]
  ; a keyword LIST, literally: bl vectors are structs, Keyword.get wants []
  (let [caps (:caps opts)]
    (if (nil? caps)
      (list)
      (list (tuple :caps (caps-spec caps))))))

;; ── environments ------------------------------------------------------

(defn current
  "This process's env id — `:global` when unbound."
  []
  (BeamLisp.Env/env_id))

(defn fork
  "A fresh env whose reads fall through to `parent` (default: the current
   env). `opts {:caps [...]}` narrows host-interop rights; the child's
   effective caps are parent ∩ spec — narrowing only, structurally."
  ([] (BeamLisp.Env/fork))
  ([parent] (BeamLisp.Env/fork parent))
  ([parent opts] (BeamLisp.Env/fork parent (fork-opts opts))))

(defn with-env
  "Run thunk `f` with env `e` bound in this process; restores the previous
   binding afterwards. `f` is an ordinary bl fn."
  [e f]
  (BeamLisp.Env/with_env e f))

(defn isolated
  "Fork (parent: current, or explicit), bind for `f`, destroy after."
  ([f] (BeamLisp.Env/isolated f))
  ([parent f] (BeamLisp.Env/isolated parent f)))

(defn destroy
  "Drop every row belonging to env `e` and forget its bookkeeping."
  [e]
  (BeamLisp.Env/destroy e))

;; ── process boundaries -------------------------------------------------

(defn capture
  "This process's env binding as an opaque token, for `bind` in a process
   you are about to spawn. Env bindings do NOT cross spawn/Task.async by
   themselves — this pair is how they cross deliberately."
  []
  (BeamLisp.Env/capture))

(defn bind
  "Install a `capture` token in this process. Caps are re-derived from
   the env registry, never taken from the token: a stale (destroyed) or
   smuggled token cannot carry rights — fail closed."
  [token]
  (BeamLisp.Env/bind token))

(defn convey
  "Wrap a fn so it runs under THIS process's env no matter whose process
   performs it. For Agent/2-style APIs whose action fn executes in the
   agent's process: without conveyance the action resolves its vars (and
   its interop caps) in the agent's `:global` env; with it, the action
   resolves exactly as if the caller had run it. datom's conn registry is
   the canonical user (FUP-009)."
  [f]
  (BeamLisp.Env/convey f))

;; ── capabilities --------------------------------------------------------

(defn convey
  "Wrap a one-argument fn `f` as a host arity-1 fn that first binds THIS
   process's env, then runs `f`. The shape Agent actions need: Agent
   validates is_function (a raw bl fn fails that), and unbound the action
   would resolve vars — and interop rights — at `:global`. Conveyance
   makes the boundary invisible; a capped caller's caps ride along."
  [f]
  (BeamLisp.Env/convey f))

(defn caps
  "This process's effective capability set: `:all`, or a set of module
   atoms."
  []
  (BeamLisp.Env/caps))

(defn allowed?
  "Whether this process's env grants host interop to the named module."
  [name]
  (let [m (module-atom name)]
    (if (nil? m) false (BeamLisp.Env/caps_allowed? m))))

;; ── eval ------------------------------------------------------------------

(defn eval
  "Compile and run `src` in the CURRENT env — the way to compile new code
   inside a fork (the capability gate applies to this compilation)."
  [src]
  (BeamLisp/eval src))
