; beam-lisp prelude — jank-flavored Clojure, self-hosted on the BEAM.
;
; These defs compile through the same pipeline as user code; the only
; primitives they lean on are the Elixir fns seeded by BeamLisp.RT.
; Long-term this file converges on jank's own core.jank — same
; language, same names, same semantics.

(defn identity "Returns its argument unchanged." [x] x)

(defn inc [x] (+ x 1))
(defn dec [x] (- x 1))

(defn nil? [x] (= x nil))
(defn not= [a b] (not (= a b)))
(defn some? [x] (not (nil? x)))

; --- sequences (RT prims) ---
; map/filter/range/take/drop & friends are seeded Elixir prims (see
; BeamLisp.RT), not defs here: they are *hybrid* — a realized input
; (list/vector) flows through the strict Enum path, a LazySeq input
; composes lazily, so `(take 5 (map f (range)))` never realizes more
; than it needs. `reduce`/`every?`/`second`/`zipmap` stay self-hosted.

(defn reduce
  ([f xs]
    ; fold without an initial accumulator: `(reduce f [x y z])` ≡ `(f (f x y) z)`;
    ; empty coll calls `(f)` — this is what comp's `(reduce comp (list* f g fs))` needs.
    (if (empty? xs)
      (f)
      (reduce f (first xs) (rest xs))))
  ( [f acc xs]
    (loop [acc acc xs xs]
      (if (empty? xs)
        acc
        (recur (f acc (first xs)) (rest xs))))))

(defn second [xs] (let [[_ b] xs] b))

; key/val read a `[k v]` map entry (as seq/find yield); `some` returns
; the first logical-true result of a predicate. These mirror jank's
; core.jank (slices 12/08) so upstream fns like merge-with that call
; them resolve from `core` at call time.
(defn key [e] (first e))
(defn val [e] (second e))

(defn some
  "Returns the first logical true value of (selector x) for any x in coll,
   else nil."
  [selector coll]
  (loop [s (seq coll)]
    (if s
      (let [x (selector (first s))]
        (if x x (recur (next s))))
      nil)))

(defn complement
  "Takes a fn f and returns a fn that takes the same arguments as f and
   returns the opposite truth value."
  [f]
  (fn
    ([] (not (f)))
    ([x] (not (f x)))
    ([x y] (not (f x y)))
    ([x y & zs] (not (apply f x y zs)))))

(defn list [& xs] xs)

(defn zipmap "Builds a map from parallel keys and values."
  ( [ks vs]
    (loop [ks ks vs vs acc {}]
      (if (empty? ks)
        acc
        (recur (rest ks) (rest vs) (Map/put acc (first ks) (first vs)))))))

(defn every?
  ( [f xs]
    (if (empty? xs)
      true
      (if (f (first xs))
        (every? f (rest xs))
        false))))

; --- lazy sequences ---
; `lazy-seq` wraps its body in a thunk; BeamLisp.LazySeq realizes it at
; most once and caches the result. The body should return nil (empty)
; or a cons whose tail is again a lazy seq.
(defmacro lazy-seq [& body]
  `(BeamLisp.LazySeq/from_fun (fn [] ~@body)))

; --- control flow, as macros ---
; The macro system earns its keep here: cond/case/when/and/or are
; not compiler features, they're beam-lisp code that writes
; beam-lisp code. Auto-gensym (`x#` inside a backquote, `(gensym)`) is
; what keeps their temporaries from capturing user locals.

(defmacro cond [& clauses]
  (if (empty? clauses)
    nil
    (if (= (first clauses) :else)
      (second clauses)
      `(if ~(first clauses)
         ~(second clauses)
         (cond ~@(rest (rest clauses)))))))

(defmacro when [test & body]
  `(if ~test (do ~@body) nil))

(defmacro when-not [test & body]
  `(if ~test nil (do ~@body)))

(defmacro and [& xs]
  (if (empty? xs)
    true
    (if (empty? (rest xs))
      (first xs)
      ; bind once: short-circuit yields the falsy value itself
      `(let [and-tmp# ~(first xs)]
         (if and-tmp# (and ~@(rest xs)) and-tmp#)))))

(defmacro or [& xs]
  (if (empty? xs)
    nil
    (if (empty? (rest xs))
      (first xs)
      ; bind once so the first form is not evaluated twice
      `(let [or-tmp# ~(first xs)]
         (if or-tmp# or-tmp# (or ~@(rest xs)))))))

(defn case-pairs [g clauses]
  (loop [cs clauses acc ()]
    (cond
      (empty? cs) (lists/reverse acc)
      (empty? (rest cs)) (lists/reverse (cons (first cs) (cons :else acc)))
      :else (recur (rest (rest cs))
                   (cons (first (rest cs))
                         (cons (list (quote =) g (first cs)) acc))))))

(defmacro case [e & clauses]
  ; The condition and the case-pairs built below must share the same
  ; temp, so make it an explicit gensym instead of a `#` symbol.
  (let [g (gensym "case-val")]
    `(let [~g ~e]
       (cond ~@(case-pairs g clauses)))))

; --- error handling, as interop wrappers ---
; throw/try raise exceptions via BeamLisp.ExInfo; these recover the
; payload (ex-data/ex-message) exactly as Clojure's counterparts do.
(defn ex-info [msg data] (BeamLisp.ExInfo/ex_info msg data))
(defn ex-data [e] (BeamLisp.ExInfo/ex_data e))
(defn ex-message [e] (BeamLisp.ExInfo/ex_message e))

; --- docstrings ---
; `doc` prints a var's docstring in roughly Clojure's shape. It
; resolves through the same alias/refer/core rules the compiler uses
; (BeamLisp.Env/doc_string/2) and accepts the quoted-symbol datum
; `(doc 'name)` hands over.
(defn doc [sym]
  (let [res (BeamLisp.Env/doc_string (BeamLisp.Env/current_ns) sym)]
    (if (nil? res)
      (println "No doc found")
      (do
        (println "-------------------------")
        (println (str (get res :ns nil) "/" (get res :name nil)))
        (println (str "  " (get res :doc nil)))))))

; --- reader sugar & concurrency ---
; `@x` reads as a call to whatever the reader-macro table maps `@`
; to. The mapping is registered here — in beam-lisp, rebindably —
; not wired into the reader (Clojure's @ is likewise reader sugar
; over deref).
(reader-macro! "@" (quote deref))

(defmacro future
  "Run body on a new process; (deref f) or @f waits for the result."
  [& body]
  `(BeamLisp.Refs/future_exec (fn [] ~@body)))

; --- form metadata ---
; meta/with-meta on FORM DATA (what a macro receives). Runtime value
; metadata lives in BeamLisp.Meta (lazy seqs, documented no-op on plain
; values); forms get a compiler-controlled {:meta, form, m} wrapper that
; the compiler strips before codegen, so a meta-carrying form compiles
; identically. This is the surface jank's threading macros and doto use:
; `(with-meta <new-form> (meta form))` carries source info across the
; macro boundary.
(defn meta [form] (BeamLisp.FormMeta/meta form))
(defn with-meta [form m] (BeamLisp.FormMeta/with_meta form m))
(defn vary-meta [form f] (BeamLisp.FormMeta/vary_meta form f))

; --- macro authoring ---
; Same as (next (next x)), used by the macro-authoring surface and doseq.
(defn nnext [x] (next (next x)))

; `name` extracts a symbol's name string (Clojure's name). str/1 does not
; yet render symbol tuples (a BeamLisp.RT gap), so macro tooling that
; must stringify a symbol uses name first.
(defn name [x] (if (symbol? x) (erlang/element 2 x) (str x)))

; assert-macro-args: validates a macro's argument shape, throwing naming
; the failing macro. A beam-lisp equivalent of jank's core.jank
; definition (upstream uses ^:private and reader-level metadata, which
; the reader does not read yet — so this is beam-lisp-side text, not a
; vendored fixture). `&form` is the enclosing macro's call form, bound by
; the compiler to every macro; `(first &form)` is the failing macro's name.
(defmacro assert-macro-args [& pairs]
  (if (empty? pairs)
    nil
    (let [more (nnext pairs)]
      (list 'do
            (list 'when-not (first pairs)
                  (list 'throw
                        (list 'ex-info
                              (list 'str (list 'name (list 'first '&form)) " requires "
                                    (second pairs) " in " (list 'BeamLisp.Env/current_ns) ":")
                              {})))
            (if (empty? more)
              nil
              (list* 'assert-macro-args more))))))

; if-let / when-let / if-not — the same shapes as jank's core.jank.
; Defined here (not only as vendored fixtures) so user code and the
; memoize/doseq slices resolve them through the core fallback.
(defmacro if-let
  ([bindings then]
   `(if-let ~bindings ~then nil))
  ([bindings then else & oldform]
   (assert-macro-args
     (vector? bindings) "a vector for its binding"
     (nil? oldform) "1 or 2 forms after binding vector"
     (= 2 (count bindings)) "exactly 2 forms in binding vector")
   (let [form (get bindings 0)
         tst (get bindings 1)]
     `(let [temp# ~tst]
        (if temp#
          (let [~form temp#]
            ~then)
          ~else)))))

(defmacro when-let [bindings & body]
  (assert-macro-args
    (vector? bindings) "a vector for its binding"
    (= 2 (count bindings)) "exactly 2 forms in binding vector")
  (let [form (get bindings 0)
        tst (get bindings 1)]
    `(let [temp# ~tst]
       (when temp#
         (let [~form temp#]
           ~@body)))))

(defmacro when-first
  "Evaluates body with x bound to the first element of coll, when coll
   has a first element. Unlike when-let, the test is (seq coll) rather
   than the element itself, so a leading nil or false in the collection
   still runs the body — the question asked is 'is there an element?',
   not 'is the element truthy?'."
  [bindings & body]
  (assert-macro-args
    (vector? bindings) "a vector for its binding"
    (= 2 (count bindings)) "exactly 2 forms in binding vector")
  (let [x (get bindings 0)
        coll (get bindings 1)]
    `(let [xs# (seq ~coll)]
       (when xs#
         (let [~x (first xs#)]
           ~@body)))))

(defmacro if-not
  ([test then] `(if-not ~test ~then nil))
  ([test then else]
   `(if (not ~test) ~then ~else)))

; --- doseq's chunking deps ---
; jank implements these over its seq protocol and cpp/ runtime; beam-lisp
; has immutable, unchunked seqs, so each is the honest beam-lisp
; equivalent. chunked-seq? is always false, so doseq always takes the
; non-chunked path; the chunk prims exist only so its emitted form
; resolves.
(defn int [x] (erlang/trunc x))
(defn unchecked-inc [x] (+ x 1))
(defn fresh-seq [o] o)
(defn next-in-place [o] (next o))
(defn chunked-seq? [o] false)
(defn chunk-first [s] (first s))
(defn chunk-rest [s] (rest s))

; --- seq helpers & threading (jank core.jank, self-hosted) ---
; The building blocks upstream's conditional-threading macros are written
; on: butlast/nthrest/last (the seq cuts), partition and interleave (the
; pair-builder the macro bodies splice), the thread macros ->/->> their
; expansions emit, and the assert/*assert* pair that guards argument
; checks. Each is the upstream core.jank definition, so the vendored
; slices 41/53..57/64 load and behave unmodified.

(defn reverse
  "Return a seq of the items in coll, in reverse order. Always a list,
  as in Clojure — (reverse [1 2]) is (2 1), not [2 1]."
  [coll]
  (reduce (fn [acc x] (cons x acc)) (list) coll))

(defn last
  "Return the last item in coll, in linear time."
  [s]
  (loop [s s]
    (if (next s)
      (recur (next s))
      (first s))))

(defn butlast
  "Return a seq of all but the last item in coll, in linear time."
  [s]
  ; nil (not an empty seq) for 0- or 1-element colls, like Clojure.
  ; The accumulator is a list built in reverse, so the result is a seq
  ; even when the input was a vector — (butlast [1 2 3]) is (1 2), not
  ; [1 2], and beam-lisp keeps those distinct.
  (loop [ret (list) s s]
    (if (next s)
      (recur (cons (first s) ret) (next s))
      (seq (reverse ret)))))

(defn nthrest
  "Returns the nth rest of coll, coll when n is 0."
  [coll n]
  (loop [coll coll n n]
    (if (pos? n)
      (if (seq coll)
        (recur (rest coll) (dec n))
        (or (seq coll) ()))
      coll)))

(defn interleave
  "Returns a lazy seq of the first item in each coll, then the second etc."
  ([] ())
  ([c1] (lazy-seq c1))
  ([c1 c2]
   (lazy-seq
     (let [s1 (seq c1) s2 (seq c2)]
       (when (and s1 s2)
         (cons (first s1) (cons (first s2)
                                (interleave (rest s1) (rest s2))))))))
  ([c1 c2 & colls]
   (lazy-seq
     (let [ss (map seq (conj colls c2 c1))]
       (when (every? identity ss)
         (concat (map first ss) (apply interleave (map rest ss))))))))

(defn partition
  "Returns a lazy sequence of lists of n items each, at offsets step
   apart. If step is not supplied, defaults to n, i.e. the partitions
   do not overlap. If a pad collection is supplied, use its elements as
   necessary to complete last partition upto n items. In case there are
   not enough padding elements, return a partition with less than n items."
  ([n coll]
   (partition n n coll))
  ([n step coll]
   (lazy-seq
     (when-let [s (seq coll)]
       (let [p (doall (take n s))]
         (when (= n (count p))
           (cons p (partition n step (nthrest s step))))))))
  ([n step pad coll]
   (lazy-seq
     (when-let [s (seq coll)]
       (let [p (doall (take n s))]
         (if (= n (count p))
           (cons p (partition n step pad (nthrest s step)))
           (list (take n (concat p pad)))))))))

(defmacro ->
  "Threads the expr through the forms. Inserts x as the
   second item in the first form, making a list of it if it is not a
   list already. If there are more forms, inserts the first form as the
   second item in second form, etc."
  [x & forms]
  (loop [x x
         forms forms]
    (if (empty? forms)
      x
      (let [form (first forms)
            threaded (if (seq? form)
                       (with-meta `(~(first form) ~x ~@(next form)) (meta form))
                       (list form x))]
        (recur threaded (rest forms))))))

(defmacro ->>
  "Threads the expr through the forms. Inserts x as the
   last item in the first form, making a list of it if it is not a
   list already. If there are more forms, inserts the first form as the
   last item in second form, etc."
  [x & forms]
  (loop [x x
         forms forms]
    (if (empty? forms)
      x
      (let [form (first forms)
            threaded (if (seq? form)
                       (with-meta `(~(first form) ~@(next form) ~x) (meta form))
                       (list form x))]
        (recur threaded (rest forms))))))

; --- assertion ---
; *assert* is a plain var defaulting to true. beam-lisp has no `binding`
; form yet, so re-defining it would shadow, not dynamically rebind —
; this is the honest minimum, and it is enough for the assert macro
; below, which reads *assert* at expansion time. A future binding form
; would upgrade it to true dynamic semantics.
(def *assert* true)

(defmacro assert
  "Evaluates expr and throws an exception if it does not evaluate to
   logical true."
  ([x]
   (when *assert*
     (list `when-not x
           (list 'throw (list `ex-info
                              "assertion failed"
                              {:assertion (pr-str x)})))))
  ([x message]
   (when *assert*
     (list `when-not x
           (list 'throw (list `ex-info
                              "assertion failed"
                              {:assertion (pr-str x)
                               :message message}))))))

; --- sequence & collection gaps that real use has exposed ---
; These are the core fns ordinary programs reach for that neither the
; RT prims above nor the defs so far cover. Each is written in beam-lisp
; — this file exists so the language feeds itself — and each follows the
; hybrid seq convention the neighbours use: lazy when it composes (built
; on lazy-seq), strict-but-honest when an immutable array forces it.
; `distinct` was the trigger: a real program died on it, which is how the
; rest of this batch earns its place.

(defn distinct
  "Returns a lazy seq of the elements of coll with duplicates removed.
   First occurrence wins: order is preserved, so this is dedup by
   position, never a set abstraction leaking out. Accepts a keyfn that
   decides equality between elements."
  ([coll] (distinct identity coll))
  ([keyfn coll]
   (let [step (fn step [seen s]
                (lazy-seq
                  ; the skip branch recurs inside the thunk: a lazy-seq
                  ; thunk must return nil or a cons cell, never a bare
                  ; LazySeq, or the walk loops lose their footing.
                  (loop [seen seen s s]
                    (when-let [s (seq s)]
                      (let [x (first s)
                            k (keyfn x)]
                        (if (contains? seen k)
                          (recur seen (rest s))
                          (cons x (step (conj seen k) (rest s)))))))))]
     (step (set []) coll))))

(defn dedupe
  "Returns a lazy seq with consecutive duplicate elements removed:
   (dedupe [1 1 2 2 3]) is (1 2 3). Unlike distinct it only collapses a
   run, so 1s separated by 2s both survive."
  [coll]
  (lazy-seq
    (when-let [s (seq coll)]
      (let [x (first s)]
        (cons x (dedupe (drop-while (fn [y] (= y x)) (rest s))))))))

(defn split-at
  "Returns a vector [(take n coll) (drop n coll)]."
  [n coll]
  [(take n coll) (drop n coll)])

(defn split-with
  "Returns a vector [(take-while pred coll) (drop-while pred coll)]."
  [pred coll]
  [(take-while pred coll) (drop-while pred coll)])

(defn interpose
  "Returns a lazy seq of coll with sep inserted between each element:
   (interpose :x [1 2 3]) is (1 :x 2 :x 3).
   Not Clojure's `(drop 1 (interleave (repeat sep) coll))` idiom: beam-lisp's
   drop unwraps a lazy seq into a partially-realized `[h | LazySeq]` list that
   neither doall nor the printer can fully realize, so this builds the seq
   directly."
  [sep coll]
  (let [sep-step (fn sep-step [s]
                   (lazy-seq
                     (when-let [s (seq s)]
                       (cons sep (cons (first s) (sep-step (rest s)))))))]
    (lazy-seq
      (when-let [s (seq coll)]
        (cons (first s) (sep-step (rest s)))))))

(defn flatten
  "Takes any nested combination of seqable things and returns their
   contents as a single flat seq. The root itself is dropped, exactly as
   Clojure's does: (flatten 5) is empty."
  [x]
  (filter (complement sequential?) (rest (tree-seq sequential? seq x))))

(defn repeatedly
  "Takes a fn of no args, presumably with side effects, and returns a lazy
   seq of its results. (take n (repeatedly f)) is what bounds it."
  [f]
  (lazy-seq (cons (f) (repeatedly f))))

(defn max-key
  "Returns the x for which (k x) is greatest. Ties resolve to the first."
  ([k x] x)
  ([k x y] (if (pos? (compare (k y) (k x))) y x))
  ([k x y & more]
   (reduce (fn [mx z] (max-key k mx z)) (max-key k x y) more)))

(defn min-key
  "Returns the x for which (k x) is least. Ties resolve to the first."
  ([k x] x)
  ([k x y] (if (neg? (compare (k y) (k x))) y x))
  ([k x y & more]
   (reduce (fn [mn z] (min-key k mn z)) (min-key k x y) more)))

; --- map utilities ---
; beam-lisp maps are plain Elixir maps; these walk them through the
; seq-of-entries view (each entry a [k v] vector) that key/val above
; already read, so map code never touches Erlang internals.

(defn update-keys
  "Returns a map with f applied to each key."
  [m f]
  (reduce (fn [acc e] (assoc acc (f (key e)) (val e))) {} (seq m)))

(defn update-vals
  "Returns a map with f applied to each value."
  [m f]
  (reduce (fn [acc e] (assoc acc (key e) (f (val e)))) {} (seq m)))

(defn select-keys
  "Returns a map containing only the entries whose key is in ks."
  [m ks]
  (reduce (fn [acc k]
            (if (contains? m k) (assoc acc k (get m k)) acc))
          {} ks))

(defn merge-with
  "Returns a map that consists of the rest of the maps conj-ed onto the
   first, with (f val-in-result val-in-later) resolving keys that appear
   in more than one map. Later maps win the merge when f is not called."
  [f & maps]
  (reduce (fn [acc m]
            (reduce (fn [a e]
                      (let [k (key e) v (val e)]
                        (if (contains? a k)
                          (assoc a k (f (get a k) v))
                          (assoc a k v))))
                    acc (seq m)))
          {} maps))

(defn mapcat
  "Returns the concatenation of (f x) for each x in coll. Only a single
   collection is supported: beam-lisp's map is 2-arity, so the multi-coll
   form Clojure allows has nothing to stand on here."
  [f & colls]
  (if (= 1 (count colls))
    (apply concat (apply map f colls))
    (throw (ex-info "mapcat: only a single collection is supported" {}))))

(defn keep
  "Returns a lazy seq of the non-nil results of (f x) for x in coll —
   filter and map in one pass."
  [f coll]
  (lazy-seq
    (loop [s coll]
      (when-let [s (seq s)]
        (let [x (f (first s))]
          (if (nil? x)
            (recur (rest s))
            (cons x (keep f (rest s)))))))))

(defn keep-indexed
  "Returns a lazy seq of the non-nil results of (f i x), where i is the
   zero-based index of x in coll."
  [f coll]
  (let [step (fn step [i s]
               (lazy-seq
                 (loop [i i s s]
                   (when-let [s (seq s)]
                     (let [x (f i (first s))]
                       (if (nil? x)
                         (recur (inc i) (rest s))
                         (cons x (step (inc i) (rest s)))))))))]
    (step 0 coll)))

(defn partition-by
  "Applies f to each value in coll, splitting it each time f returns a new
   value. Returns a lazy seq of partitions, each a seq of consecutive
   elements sharing one f-result. f is re-evaluated per element, as in
   Clojure."
  [f coll]
  (lazy-seq
    (when-let [s (seq coll)]
      (let [fv (f (first s))]
        (cons (take-while (fn [x] (= (f x) fv)) s)
              (partition-by f (drop-while (fn [x] (= (f x) fv)) s)))))))

(defn frequencies
  "Returns a map from distinct items in coll to the number of times each
   appears."
  [coll]
  (reduce (fn [counts x] (assoc counts x (inc (get counts x 0)))) {} coll))

(defn not-empty
  "Returns coll if it is non-empty, else nil."
  [coll]
  (when (seq coll) coll))

; peek/pop treat the stack-like end of a collection: a vector's last
; element, a list's first. beam-lisp has no O(1) tail view on a vector,
; so pop rebuilds — O(n), the honest cost of an immutable array without
; a shared tail.
(defn peek
  "Returns the last item in a vector, or the first item in a list."
  [coll]
  (if (vector? coll) (last coll) (first coll)))

(defn pop
  "Returns a collection with the last item of a vector (or the first of a
   list) removed. Popping an empty collection throws, as in Clojure."
  [coll]
  (cond
    (empty? coll)
    (throw (ex-info (if (vector? coll) "Can't pop empty vector" "Can't pop empty list") {}))

    (vector? coll)
    (reduce (fn [v x] (conj v x)) [] (butlast coll))

    :else (rest coll)))

(defn subvec
  "Returns a vector of the items in v from start (inclusive) to end
   (exclusive). Copies element-wise: beam-lisp vectors are immutable
   arrays with no shared tail, so this is O(end-start), not the O(1)
   Clojure slice."
  ([v start] (subvec v start (count v)))
  ([v start end]
   (loop [i start acc []]
     (if (< i end)
       (recur (inc i) (conj acc (nth v i)))
       acc))))
