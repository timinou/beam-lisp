; beam-lisp prelude — jank-flavored Clojure, self-hosted on the BEAM.
;
; These defs compile through the same pipeline as user code; the only
; primitives they lean on are the Elixir fns seeded by BeamLisp.RT.
; Long-term this file converges on jank's own core.jank — same
; language, same names, same semantics.

(defn identity "Returns its argument unchanged." [x] x)

(defn inc [x] (+ x 1))
(defn dec [x] (- x 1))

(defn nil? [x] (= x nil))
(defn not= [a b] (not (= a b)))
(defn some? [x] (not (nil? x)))

; --- sequences (RT prims) ---
; map/filter/range/take/drop & friends are seeded Elixir prims (see
; BeamLisp.RT), not defs here: they are *hybrid* — a realized input
; (list/vector) flows through the strict Enum path, a LazySeq input
; composes lazily, so `(take 5 (map f (range)))` never realizes more
; than it needs. `reduce`/`every?`/`second`/`zipmap` stay self-hosted.

(defn reduce
  ([f xs]
    ; fold without an initial accumulator: `(reduce f [x y z])` ≡ `(f (f x y) z)`;
    ; empty coll calls `(f)` — this is what comp's `(reduce comp (list* f g fs))` needs.
    (if (empty? xs)
      (f)
      (reduce f (first xs) (rest xs))))
  ([f acc xs]
    ; respect `reduced`: a step fn that returns a Reduced halts the fold
    ; immediately and its *unwrapped* value is the result (Clojure peels
    ; the sentinel at the halting point), so transducers that stop early
    ; — take-while, take-nth, cat — fold correctly on core's reduce too,
    ; not just on the vendored cpp-backed one.
    (loop [acc acc xs xs]
      (if (empty? xs)
        (if (reduced? acc) (deref acc) acc)
        (let [acc (f acc (first xs))]
          (if (reduced? acc)
            (deref acc)
            (recur acc (rest xs))))))))

(defn second [xs] (let [[_ b] xs] b))

; key/val read a `[k v]` map entry (as seq/find yield); `some` returns
; the first logical-true result of a predicate. These mirror jank's
; core.jank (slices 12/08) so upstream fns like merge-with that call
; them resolve from `core` at call time.
(defn key [e] (first e))
(defn val [e] (second e))

(defn some
  "Returns the first logical true value of (selector x) for any x in coll,
   else nil."
  [selector coll]
  (loop [s (seq coll)]
    (if s
      (let [x (selector (first s))]
        (if x x (recur (next s))))
      nil)))

(defn complement
  "Takes a fn f and returns a fn that takes the same arguments as f and
   returns the opposite truth value."
  [f]
  (fn
    ([] (not (f)))
    ([x] (not (f x)))
    ([x y] (not (f x y)))
    ([x y & zs] (not (apply f x y zs)))))

(defn list [& xs] xs)

(defn zipmap
  "Builds a map from parallel keys and values.

   Uses `assoc` rather than a raw `Map/put`: keys must be normalized for
   hashing (metadata is invisible to `=`, so it must be invisible to
   lookup), and `assoc` is where that happens."
  ( [ks vs]
    (loop [ks ks vs vs acc {}]
      (if (empty? ks)
        acc
        (recur (rest ks) (rest vs) (assoc acc (first ks) (first vs)))))))

(defn every?
  ( [f xs]
    (if (empty? xs)
      true
      (if (f (first xs))
        (every? f (rest xs))
        false))))

; --- lazy sequences ---
; `lazy-seq` wraps its body in a thunk; BeamLisp.LazySeq realizes it at
; most once and caches the result. The body should return nil (empty)
; or a cons whose tail is again a lazy seq.
(defmacro lazy-seq [& body]
  `(BeamLisp.LazySeq/from_fun (fn [] ~@body)))

; --- control flow, as macros ---
; The macro system earns its keep here: cond/case/when/and/or are
; not compiler features, they're beam-lisp code that writes
; beam-lisp code. Auto-gensym (`x#` inside a backquote, `(gensym)`) is
; what keeps their temporaries from capturing user locals.

(defmacro cond [& clauses]
  (if (empty? clauses)
    nil
    (if (= (first clauses) :else)
      (second clauses)
      `(if ~(first clauses)
         ~(second clauses)
         (cond ~@(rest (rest clauses)))))))

(defmacro when [test & body]
  `(if ~test (do ~@body) nil))

(defmacro when-not [test & body]
  `(if ~test nil (do ~@body)))

(defmacro declare
  "Defines each name as an unbound var, so a function may refer to another
   defined later in the file. Clojure marks these ^:declared; here the point
   is simply that the var EXISTS at compile time — mutually recursive
   definitions and forward references (which navigator libraries lean on
   heavily) need the name to resolve before its value is known."
  [& names]
  `(do ~@(map (fn [n] `(def ~n nil)) names)))

(defmacro and [& xs]
  (if (empty? xs)
    true
    (if (empty? (rest xs))
      (first xs)
      ; bind once: short-circuit yields the falsy value itself
      `(let [and-tmp# ~(first xs)]
         (if and-tmp# (and ~@(rest xs)) and-tmp#)))))

(defmacro or [& xs]
  (if (empty? xs)
    nil
    (if (empty? (rest xs))
      (first xs)
      ; bind once so the first form is not evaluated twice
      `(let [or-tmp# ~(first xs)]
         (if or-tmp# or-tmp# (or ~@(rest xs)))))))

(defn mod
  "Modulus of num and div. Truncates toward negative infinity. Defined
   in terms of rem and corrected to the divisor's sign — the two differ
   on mixed-sign operands, rem keeping the dividend's sign. Placed here,
   after `or`, because it compiles the `or` macro above it."
  [num div]
  (let [m (rem num div)]
    (if (or (zero? m) (= (pos? num) (pos? div)))
      m
      (+ m div))))

(defn case-pairs [g clauses]
  (loop [cs clauses acc ()]
    (cond
      (empty? cs) (lists/reverse acc)
      (empty? (rest cs)) (lists/reverse (cons (first cs) (cons :else acc)))
      :else (recur (rest (rest cs))
                   (cons (first (rest cs))
                         (cons (list (quote =) g (first cs)) acc))))))

(defmacro case [e & clauses]
  ; The condition and the case-pairs built below must share the same
  ; temp, so make it an explicit gensym instead of a `#` symbol.
  (let [g (gensym "case-val")]
    `(let [~g ~e]
       (cond ~@(case-pairs g clauses)))))

; --- error handling, as interop wrappers ---
; throw/try raise exceptions via BeamLisp.ExInfo; these recover the
; payload (ex-data/ex-message) exactly as Clojure's counterparts do.
(defn ex-info [msg data] (BeamLisp.ExInfo/ex_info msg data))
(defn ex-data [e] (BeamLisp.ExInfo/ex_data e))
(defn ex-message [e] (BeamLisp.ExInfo/ex_message e))

; --- docstrings ---
; `doc` prints a var's docstring in roughly Clojure's shape. It
; resolves through the same alias/refer/core rules the compiler uses
; (BeamLisp.Env/doc_string/2) and accepts the quoted-symbol datum
; `(doc 'name)` hands over.
(defn doc [sym]
  (let [res (BeamLisp.Env/doc_string (BeamLisp.Env/current_ns) sym)]
    (if (nil? res)
      (println "No doc found")
      (do
        (println "-------------------------")
        (println (str (get res :ns nil) "/" (get res :name nil)))
        (println (str "  " (get res :doc nil)))))))

; --- reader sugar & concurrency ---
; `@x` reads as a call to whatever the reader-macro table maps `@`
; to. The mapping is registered here — in beam-lisp, rebindably —
; not wired into the reader (Clojure's @ is likewise reader sugar
; over deref).
(reader-macro! "@" (quote deref))

(defmacro future
  "Run body on a new process; (deref f) or @f waits for the result."
  [& body]
  `(BeamLisp.Refs/future_exec (fn [] ~@body)))

; --- form metadata ---
; meta/with-meta on FORM DATA (what a macro receives). Runtime value
; metadata lives in BeamLisp.Meta (lazy seqs, documented no-op on plain
; values); forms get a compiler-controlled {:meta, form, m} wrapper that
; the compiler strips before codegen, so a meta-carrying form compiles
; identically. This is the surface jank's threading macros and doto use:
; `(with-meta <new-form> (meta form))` carries source info across the
; macro boundary.
(defn meta [form] (BeamLisp.FormMeta/meta form))
(defn with-meta [form m] (BeamLisp.FormMeta/with_meta form m))
(defn vary-meta
  "vary-meta obj f & args: returns obj with metadata replaced by
   (apply f (meta obj) args). The 2-arity delegates to
   BeamLisp.FormMeta/vary_meta unchanged (existing callers depend on
   it); the variadic form is Clojure's — it builds the new metadata
   itself and hands it to the same underlying setter, so
   (vary-meta x assoc :k v) works."
  ([form f] (BeamLisp.FormMeta/vary_meta form f))
  ([form f & args] (with-meta form (apply f (meta form) args))))

; --- macro authoring ---
; Same as (next (next x)), used by the macro-authoring surface and doseq.
(defn nnext [x] (next (next x)))

; A qualified name is one string with a single `/` in it: `a/b` names
; `b` in `a`. Both halves of the split are wanted often enough --- and
; are easy enough to get subtly wrong --- that the rule lives in one
; place and `name`/`namespace` are the two views of it.
;
; The `/` var is the one name that is NOT a qualification: `(name '/)`
; is "/", not an empty name in an empty namespace. Guarding on a length
; of 1 keeps that case out of the split rather than special-casing it
; afterwards.
(defn- qualified-parts [s]
  (let [parts (binary/split s "/")]
    (if (and (= (count parts) 2) (> (count (first parts)) 0))
      parts
      nil)))

; `name` is the unqualified name of a keyword, symbol or string ---
; Clojure's name, which drops the namespace. str/1 does not yet render
; symbol tuples (a BeamLisp.RT gap), so macro tooling that must
; stringify a symbol goes through here.
(defn name [x]
  (let [s (if (symbol? x) (erlang/element 2 x) (str x))
        parts (qualified-parts s)]
    (if parts (second parts) s)))

; `namespace` is the other half: the qualifier, or nil when there is
; none. Returning nil rather than "" is the contract callers branch on.
(defn namespace [x]
  (let [s (if (symbol? x) (erlang/element 2 x) (str x))
        parts (qualified-parts s)]
    (if parts (first parts) nil)))

; `keyword` builds a keyword from a name, or from a namespace and a
; name. It is the constructor half of `name`/`namespace`, and the
; roundtrip is the contract: (keyword (namespace k) (name k)) is k for
; every keyword k.
;
; Passing a keyword through returns it unchanged, as Clojure does, so
; (keyword (keyword "a")) is stable rather than doubly-prefixed.
; Both arities go through cpp/jank.runtime.keyword, which routes the
; intern through the atom guard --- a keyword built at runtime comes
; from data, and a loop interning one atom per input row is exactly how
; the atom table fills. A full table aborts the VM uncatchably, so this
; must never reach a bare String.to_atom.
(defn keyword
  ([x] (if (keyword? x)
         x
         (cpp/jank.runtime.keyword nil (if (symbol? x) (erlang/element 2 x) (str x)))))
  ([ns n] (cpp/jank.runtime.keyword (name ns) (name n))))

; assert-macro-args: validates a macro's argument shape, throwing naming
; the failing macro. A beam-lisp equivalent of jank's core.jank
; definition (upstream uses ^:private and reader-level metadata, which
; the reader does not read yet — so this is beam-lisp-side text, not a
; vendored fixture). `&form` is the enclosing macro's call form, bound by
; the compiler to every macro; `(first &form)` is the failing macro's name.
(defmacro assert-macro-args [& pairs]
  (if (empty? pairs)
    nil
    (let [more (nnext pairs)]
      (list 'do
            (list 'when-not (first pairs)
                  (list 'throw
                        (list 'ex-info
                              (list 'str (list 'name (list 'first '&form)) " requires "
                                    (second pairs) " in " (list 'BeamLisp.Env/current_ns) ":")
                              {})))
            (if (empty? more)
              nil
              (list* 'assert-macro-args more))))))

; if-let / when-let / if-not — the same shapes as jank's core.jank.
; Defined here (not only as vendored fixtures) so user code and the
; memoize/doseq slices resolve them through the core fallback.
(defmacro if-let
  ([bindings then]
   `(if-let ~bindings ~then nil))
  ([bindings then else & oldform]
   (assert-macro-args
     (vector? bindings) "a vector for its binding"
     (nil? oldform) "1 or 2 forms after binding vector"
     (= 2 (count bindings)) "exactly 2 forms in binding vector")
   (let [form (get bindings 0)
         tst (get bindings 1)]
     `(let [temp# ~tst]
        (if temp#
          (let [~form temp#]
            ~then)
          ~else)))))

(defmacro when-let [bindings & body]
  (assert-macro-args
    (vector? bindings) "a vector for its binding"
    (= 2 (count bindings)) "exactly 2 forms in binding vector")
  (let [form (get bindings 0)
        tst (get bindings 1)]
    `(let [temp# ~tst]
       (when temp#
         (let [~form temp#]
           ~@body)))))

(defmacro when-first
  "Evaluates body with x bound to the first element of coll, when coll
   has a first element. Unlike when-let, the test is (seq coll) rather
   than the element itself, so a leading nil or false in the collection
   still runs the body — the question asked is 'is there an element?',
   not 'is the element truthy?'."
  [bindings & body]
  (assert-macro-args
    (vector? bindings) "a vector for its binding"
    (= 2 (count bindings)) "exactly 2 forms in binding vector")
  (let [x (get bindings 0)
        coll (get bindings 1)]
    `(let [xs# (seq ~coll)]
       (when xs#
         (let [~x (first xs#)]
           ~@body)))))

(defmacro if-not
  ([test then] `(if-not ~test ~then nil))
  ([test then else]
   `(if (not ~test) ~then ~else)))

; --- doseq's chunking deps ---
; jank implements these over its seq protocol and cpp/ runtime; beam-lisp
; has immutable, unchunked seqs, so each is the honest beam-lisp
; equivalent. chunked-seq? is always false, so doseq always takes the
; non-chunked path; the chunk prims exist only so its emitted form
; resolves.
(defn int [x] (erlang/trunc x))
(defn unchecked-inc [x] (+ x 1))
(defn fresh-seq [o] o)
(defn next-in-place [o] (next o))
(defn chunked-seq? [o] false)
(defn chunk-first [s] (first s))
(defn chunk-rest [s] (rest s))
; `for`'s inner-most loop also emits the chunk-buffer chunk-append
; chunk chunk-cons quartet for its chunked branch — same story as
; above: chunked-seq? is always false, so the branch is dead and these
; are never called, but the emitted form must resolve. Honest no-op
; stubs: build, fill, seal, and chain a "chunk" that is just its own
; sequence.
(defn chunk-buffer [n] [])
(defn chunk-append [b x] (conj b x))
(defn chunk [b] b)
(defn chunk-cons [c s] (cons c s))

; --- seq helpers & threading (jank core.jank, self-hosted) ---
; The building blocks upstream's conditional-threading macros are written
; on: butlast/nthrest/last (the seq cuts), partition and interleave (the
; pair-builder the macro bodies splice), the thread macros ->/->> their
; expansions emit, and the assert/*assert* pair that guards argument
; checks. Each is the upstream core.jank definition, so the vendored
; slices 41/53..57/64 load and behave unmodified.

(defn reverse
  "Return a seq of the items in coll, in reverse order. Always a list,
  as in Clojure — (reverse [1 2]) is (2 1), not [2 1]."
  [coll]
  (reduce (fn [acc x] (cons x acc)) (list) coll))

(defn last
  "Return the last item in coll, in linear time."
  [s]
  (loop [s s]
    (if (next s)
      (recur (next s))
      (first s))))

(defn butlast
  "Return a seq of all but the last item in coll, in linear time."
  [s]
  ; nil (not an empty seq) for 0- or 1-element colls, like Clojure.
  ; The accumulator is a list built in reverse, so the result is a seq
  ; even when the input was a vector — (butlast [1 2 3]) is (1 2), not
  ; [1 2], and beam-lisp keeps those distinct.
  (loop [ret (list) s s]
    (if (next s)
      (recur (cons (first s) ret) (next s))
      (seq (reverse ret)))))

(defn nthrest
  "Returns the nth rest of coll, coll when n is 0."
  [coll n]
  (loop [coll coll n n]
    (if (pos? n)
      (if (seq coll)
        (recur (rest coll) (dec n))
        (or (seq coll) ()))
      coll)))

(defn interleave
  "Returns a lazy seq of the first item in each coll, then the second etc."
  ([] ())
  ([c1] (lazy-seq c1))
  ([c1 c2]
   (lazy-seq
     (let [s1 (seq c1) s2 (seq c2)]
       (when (and s1 s2)
         (cons (first s1) (cons (first s2)
                                (interleave (rest s1) (rest s2))))))))
  ([c1 c2 & colls]
   (lazy-seq
     (let [ss (map seq (conj colls c2 c1))]
       (when (every? identity ss)
         (concat (map first ss) (apply interleave (map rest ss))))))))

(defn partition
  "Returns a lazy sequence of lists of n items each, at offsets step
   apart. If step is not supplied, defaults to n, i.e. the partitions
   do not overlap. If a pad collection is supplied, use its elements as
   necessary to complete last partition upto n items. In case there are
   not enough padding elements, return a partition with less than n items."
  ([n coll]
   (partition n n coll))
  ([n step coll]
   (lazy-seq
     (when-let [s (seq coll)]
       (let [p (doall (take n s))]
         (when (= n (count p))
           (cons p (partition n step (nthrest s step))))))))
  ([n step pad coll]
   (lazy-seq
     (when-let [s (seq coll)]
       (let [p (doall (take n s))]
         (if (= n (count p))
           (cons p (partition n step pad (nthrest s step)))
           (list (take n (concat p pad)))))))))

(defmacro ->
  "Threads the expr through the forms. Inserts x as the
   second item in the first form, making a list of it if it is not a
   list already. If there are more forms, inserts the first form as the
   second item in second form, etc."
  [x & forms]
  (loop [x x
         forms forms]
    (if (empty? forms)
      x
      (let [form (first forms)
            threaded (if (seq? form)
                       (with-meta `(~(first form) ~x ~@(next form)) (meta form))
                       (list form x))]
        (recur threaded (rest forms))))))

(defmacro ->>
  "Threads the expr through the forms. Inserts x as the
   last item in the first form, making a list of it if it is not a
   list already. If there are more forms, inserts the first form as the
   last item in second form, etc."
  [x & forms]
  (loop [x x
         forms forms]
    (if (empty? forms)
      x
      (let [form (first forms)
            threaded (if (seq? form)
                       (with-meta `(~(first form) ~@(next form) ~x) (meta form))
                       (list form x))]
        (recur threaded (rest forms))))))

; --- assertion ---
; *assert* is a plain var defaulting to true. beam-lisp has no `binding`
; form yet, so re-defining it would shadow, not dynamically rebind —
; this is the honest minimum, and it is enough for the assert macro
; below, which reads *assert* at expansion time. A future binding form
; would upgrade it to true dynamic semantics.
(def *assert* true)

(defmacro assert
  "Evaluates expr and throws an exception if it does not evaluate to
   logical true."
  ([x]
   (when *assert*
     (list `when-not x
           (list 'throw (list `ex-info
                              "assertion failed"
                              {:assertion (pr-str x)})))))
  ([x message]
   (when *assert*
     (list `when-not x
           (list 'throw (list `ex-info
                              "assertion failed"
                              {:assertion (pr-str x)
                               :message message}))))))

; --- sequence & collection gaps that real use has exposed ---
; These are the core fns ordinary programs reach for that neither the
; RT prims above nor the defs so far cover. Each is written in beam-lisp
; — this file exists so the language feeds itself — and each follows the
; hybrid seq convention the neighbours use: lazy when it composes (built
; on lazy-seq), strict-but-honest when an immutable array forces it.
; `distinct` was the trigger: a real program died on it, which is how the
; rest of this batch earns its place.

(defn distinct
  "Returns a lazy seq of the elements of coll with duplicates removed.
   First occurrence wins: order is preserved, so this is dedup by
   position, never a set abstraction leaking out. Accepts a keyfn that
   decides equality between elements."
  ([coll] (distinct identity coll))
  ([keyfn coll]
   (let [step (fn step [seen s]
                (lazy-seq
                  ; the skip branch recurs inside the thunk: a lazy-seq
                  ; thunk must return nil or a cons cell, never a bare
                  ; LazySeq, or the walk loops lose their footing.
                  (loop [seen seen s s]
                    (when-let [s (seq s)]
                      (let [x (first s)
                            k (keyfn x)]
                        (if (contains? seen k)
                          (recur seen (rest s))
                          (cons x (step (conj seen k) (rest s)))))))))]
     (step (set []) coll))))

(defn dedupe
  "Returns a lazy seq with consecutive duplicate elements removed:
   (dedupe [1 1 2 2 3]) is (1 2 3). Unlike distinct it only collapses a
   run, so 1s separated by 2s both survive."
  [coll]
  (lazy-seq
    (when-let [s (seq coll)]
      (let [x (first s)]
        (cons x (dedupe (drop-while (fn [y] (= y x)) (rest s))))))))

(defn split-at
  "Returns a vector [(take n coll) (drop n coll)]."
  [n coll]
  [(take n coll) (drop n coll)])

(defn split-with
  "Returns a vector [(take-while pred coll) (drop-while pred coll)]."
  [pred coll]
  [(take-while pred coll) (drop-while pred coll)])

(defn interpose
  "Returns a lazy seq of coll with sep inserted between each element:
   (interpose :x [1 2 3]) is (1 :x 2 :x 3).
   Not Clojure's `(drop 1 (interleave (repeat sep) coll))` idiom: it builds
   the seq directly so it stays one lazy-seq node (the Clojure form yields a
   partially-realized improper list, which beam-lisp's doall/printer now
   handle but which is heavier than necessary here)."
  [sep coll]
  (let [sep-step (fn sep-step [s]
                   (lazy-seq
                     (when-let [s (seq s)]
                       (cons sep (cons (first s) (sep-step (rest s)))))))]
    (lazy-seq
      (when-let [s (seq coll)]
        (cons (first s) (sep-step (rest s)))))))

(defn flatten
  "Takes any nested combination of seqable things and returns their
   contents as a single flat seq. The root itself is dropped, exactly as
   Clojure's does: (flatten 5) is empty."
  [x]
  (filter (complement sequential?) (rest (tree-seq sequential? seq x))))

(defn repeatedly
  "Takes a fn of no args, presumably with side effects, and returns a lazy
   seq of its results. (take n (repeatedly f)) is what bounds it."
  [f]
  (lazy-seq (cons (f) (repeatedly f))))

(defn max-key
  "Returns the x for which (k x) is greatest. Ties resolve to the first."
  ([k x] x)
  ([k x y] (if (pos? (compare (k y) (k x))) y x))
  ([k x y & more]
   (reduce (fn [mx z] (max-key k mx z)) (max-key k x y) more)))

(defn min-key
  "Returns the x for which (k x) is least. Ties resolve to the first."
  ([k x] x)
  ([k x y] (if (neg? (compare (k y) (k x))) y x))
  ([k x y & more]
   (reduce (fn [mn z] (min-key k mn z)) (min-key k x y) more)))

; --- map utilities ---
; beam-lisp maps are plain Elixir maps; these walk them through the
; seq-of-entries view (each entry a [k v] vector) that key/val above
; already read, so map code never touches Erlang internals.

(defn reduce-kv
  "Applies (f acc k v) over every key/value pair in coll. For a map k is
   each key and v its value; for a vector the keys are the indices, so
   (reduce-kv (fn [acc i x] ...) init [a b]) folds over i=0,1 — matching
   Clojure's contract, which upstream's update-keys/update-vals build on.
   A plain left fold: unlike reduce it does not honor `reduced`."
  [f init coll]
  (if (vector? coll)
    (loop [acc init i 0]
      (if (< i (count coll))
        (recur (f acc i (nth coll i)) (inc i))
        acc))
    (reduce (fn [acc e] (f acc (key e) (val e))) init (seq coll))))

; --- transducers & into ---
; `transduce` and `into` are the collection layer's confluence point: the
; 3-arity `into` pipes an xform through `transduce`, and both respect the
; transientable?/transient/conj!/persistent! fast path for collections that
; can take one (the vendored slice_99 into defines the same shape — this is
; core's copy so user code and splitv-at/mapv resolve `into` from core).

(defn transduce
  "reduce with a transformation of rf (xf). If init is not supplied, (rf)
   is called to produce it. Returns the result of applying the transformed
   xf to init and the first item in coll, then the rest."
  ([xform rf coll]
   (transduce xform rf (rf) coll))
  ([xform rf init coll]
   (let [f (xform rf)
         ret (reduce f init coll)]
     (f ret))))

(def TRANSIENT-THRESHOLD
  "Above this many items, `into` switches to a transient accumulator.

   Measured, not guessed. `transient`/`persistent!` pay a FIXED cost per
   call — a `make_ref`, a list round trip, and a full trie rebuild — and
   `conj!` pays `Process.get`/`Process.put` per element, which the
   transient module's own docs measure at ~2.7x slower than plain `conj`.
   The transient only repays that overhead on genuinely large inputs:

     from size      1      5     20    100    500   2000   10000
     transient  10089us 1217   3440   9333  55093 125790  546260
     plain        210us  653   1760   8695  44742  78085  645377

   So the old unconditional transient path made the COMMON case — adding
   a few items — up to 88x slower, and quadratically so when `into` was
   called per element in a reduce. Choosing by the size of `from` (what
   is being added) rather than the type of `to` puts the fast path where
   the calls actually are."
  8192)

(defn into
  "Returns a new coll consisting of to-coll with all of the items of
   from-coll conjoined. A transducer may be supplied."
  ([]
   [])
  ([to]
   to)
  ([to from]
   ; `vector?`/`map?`/`set?` guard the `count`: counting a LAZY seq would
   ; force it, which `into` must not do just to pick an accumulator.
   (if (and (transientable? to)
            (or (vector? from) (map? from) (set? from))
            (>= (count from) TRANSIENT-THRESHOLD))
     (with-meta (persistent! (reduce conj! (transient to) from)) (meta to))
     (reduce conj to from)))
  ([to xform from]
   (if (transientable? to)
     (with-meta (persistent! (transduce xform conj! (transient to) from)) (meta to))
     (transduce xform conj to from))))

(defn update-keys
  "Returns a map with f applied to each key."
  [m f]
  (reduce (fn [acc e] (assoc acc (f (key e)) (val e))) {} (seq m)))

(defn update-vals
  "Returns a map with f applied to each value."
  [m f]
  (reduce (fn [acc e] (assoc acc (key e) (f (val e)))) {} (seq m)))

(defn select-keys
  "Returns a map containing only the entries whose key is in ks."
  [m ks]
  (reduce (fn [acc k]
            (if (contains? m k) (assoc acc k (get m k)) acc))
          {} ks))

(defn empty-like
  "An empty collection of the same KIND as `coll`.

   Used where a fn rebuilds a map and must not silently change its type
   (`merge`, and anything else that folds entries into a fresh accumulator).
   Unknown kinds fall back to `{}`, which is the historical behaviour."
  [coll]
  (cond
    (sorted-map? coll) (sorted-map)
    (sorted-set? coll) (sorted-set)
    (set? coll) (set [])
    (vector? coll) []
    :else {}))

(defn merge
  "Returns a map with the rest of the maps conj-ed onto the first; a later
   key wins. nil maps are skipped, so (merge nil {:a 1}) is {:a 1}, and
   merging nothing at all is nil rather than {} — Clojure's contract, which
   lets (apply merge maps) work on an empty seq. A record merges as the map
   it is, yielding a plain map: the result carries keys the record's type
   never declared, so it cannot stay that type."
  [& maps]
  (reduce (fn [acc m]
            (cond
              (nil? m) acc
              ; Seed the accumulator with an EMPTY COLLECTION OF THE SAME
              ; KIND rather than a literal {}: merging into a sorted map
              ; must stay sorted, or `(merge sorted-cfg overrides)` would
              ; silently lose the ordering the caller chose it for.
              (nil? acc) (reduce (fn [a e] (assoc a (key e) (val e))) (empty-like m) (seq m))
              :else (reduce (fn [a e] (assoc a (key e) (val e))) acc (seq m))))
          nil maps))

(defn merge-with
  "Returns a map that consists of the rest of the maps conj-ed onto the
   first, with (f val-in-result val-in-later) resolving keys that appear
   in more than one map. Later maps win the merge when f is not called."
  [f & maps]
  (reduce (fn [acc m]
            (reduce (fn [a e]
                      (let [k (key e) v (val e)]
                        (if (contains? a k)
                          (assoc a k (f (get a k) v))
                          (assoc a k v))))
                    acc (seq m)))
          {} maps))

(defn mapcat
  "Returns the concatenation of (f x) for each x in coll. Only a single
   collection is supported: beam-lisp's map is 2-arity, so the multi-coll
   form Clojure allows has nothing to stand on here."
  [f & colls]
  (if (= 1 (count colls))
    (apply concat (apply map f colls))
    (throw (ex-info "mapcat: only a single collection is supported" {}))))

(defn keep
  "Returns a lazy seq of the non-nil results of (f x) for x in coll —
   filter and map in one pass."
  [f coll]
  (lazy-seq
    (loop [s coll]
      (when-let [s (seq s)]
        (let [x (f (first s))]
          (if (nil? x)
            (recur (rest s))
            (cons x (keep f (rest s)))))))))

(defn keep-indexed
  "Returns a lazy seq of the non-nil results of (f i x), where i is the
   zero-based index of x in coll."
  [f coll]
  (let [step (fn step [i s]
               (lazy-seq
                 (loop [i i s s]
                   (when-let [s (seq s)]
                     (let [x (f i (first s))]
                       (if (nil? x)
                         (recur (inc i) (rest s))
                         (cons x (step (inc i) (rest s)))))))))]
    (step 0 coll)))

(defn map-indexed
  "Returns a lazy seq of (f i x), where i is the zero-based index of x in
   coll.

   The counterpart of `keep-indexed`, which kept only the non-nil
   results; this keeps every one. Both belong here — having only the
   filtering half meant reaching for a hand-rolled index fold whenever a
   position mattered and nil was a legitimate result."
  [f coll]
  (let [step (fn step [i s]
               (lazy-seq
                 (when-let [s (seq s)]
                   (cons (f i (first s)) (step (inc i) (rest s))))))]
    (step 0 coll)))

(defn partition-by
  "Applies f to each value in coll, splitting it each time f returns a new
   value. Returns a lazy seq of partitions, each a seq of consecutive
   elements sharing one f-result. f is re-evaluated per element, as in
   Clojure."
  [f coll]
  (lazy-seq
    (when-let [s (seq coll)]
      (let [fv (f (first s))]
        (cons (take-while (fn [x] (= (f x) fv)) s)
              (partition-by f (drop-while (fn [x] (= (f x) fv)) s)))))))

(defn frequencies
  "Returns a map from distinct items in coll to the number of times each
   appears."
  [coll]
  (reduce (fn [counts x] (assoc counts x (inc (get counts x 0)))) {} coll))

(defn not-empty
  "Returns coll if it is non-empty, else nil."
  [coll]
  (when (seq coll) coll))

; peek/pop treat the stack-like end of a collection: a vector's last
; element, a list's first. beam-lisp has no O(1) tail view on a vector,
; so pop rebuilds — O(n), the honest cost of an immutable array without
; a shared tail.
(defn peek
  "Returns the last item in a vector, or the first item in a list.

   An ORDERED collection is not a stack — Clojure defines peek/pop on
   list, queue and vector only, and raises otherwise. Without the guard
   the fallback answers `first`, which looks like a feature (the smallest
   member!) while being a different operation wearing the same name."
  [coll]
  (cond
    (sorted? coll)
      (throw (ex-info (str "peek: a " (if (sorted-map? coll) "sorted map" "sorted set")
                           " is not a stack (use first / last-key)")
                      {:coll coll}))
    (vector? coll) (last coll)
    :else (first coll)))

(defn pop
  "Returns a collection with the last item of a vector (or the first of a
   list) removed. Popping an empty collection throws, as in Clojure."
  [coll]
  (cond
    ; See `peek`: not a stack. `pop` was the worse of the two — it
    ; returned a plain LIST, silently changing the collection's type as
    ; well as its meaning.
    (sorted? coll)
    (throw (ex-info (str "pop: a " (if (sorted-map? coll) "sorted map" "sorted set")
                         " is not a stack (use " (if (sorted-map? coll) "dissoc" "disj") ")")
                    {:coll coll}))

    (empty? coll)
    (throw (ex-info (if (vector? coll) "Can't pop empty vector" "Can't pop empty list") {}))

    (vector? coll)
    (reduce (fn [v x] (conj v x)) [] (butlast coll))

    :else (rest coll)))

(defn subvec
  "Returns a vector of the items in v from start (inclusive) to end
   (exclusive). Copies element-wise: beam-lisp vectors are immutable
   arrays with no shared tail, so this is O(end-start), not the O(1)
   Clojure slice."
  ([v start] (subvec v start (count v)))
  ([v start end]
   (loop [i start acc []]
     (if (< i end)
       (recur (inc i) (conj acc (nth v i)))
       acc))))

; --- for: list comprehension (adapted from jank core.jank) ---
; Clojure's `for` — the single most-reached-for macro in the language,
; and the glaring gap in the prelude before this. This is upstream
; jank's definition, adapted verbatim from the vendored fidelity
; fixture test/fixtures/jank/slice_44_for.bl (itself byte-for-byte
; core.jank@3028594, EPL-1.0); the only difference is this beam-lisp
; header comment. The fixture already proves the expansion compiles and
; runs under this compiler — shipping the same text into `core` is the
; language feeding itself, the project principle. It depends on
; assert-macro-args, gensym, partition, peek/pop, concat (all in the
; prelude/RT), and the chunk quartet stubs defined in the doseq-chunk
; section above; beam-lisp seqs are unchunked (chunked-seq? is false)
; so `for` stays uniformly lazy and the chunked branch never runs.
; Macro-expansion time uses partition/peek/pop; the emitted code calls
; the chunk stubs, when-first, when-let, lazy-seq, seq, nth, int, and
; unchecked-inc — all resolved from `core`.
(defmacro for
  "List comprehension. Takes a vector of one or more
   binding-form/collection-expr pairs, each followed by zero or more
   modifiers, and yields a lazy sequence of evaluations of expr.
   Collections are iterated in a nested fashion, rightmost fastest,
   and nested coll-exprs can refer to bindings created in prior
   binding-forms.  Supported modifiers are: :let [binding-form expr ...],
   :while test, :when test.

   (take 100 (for [x (range 100000000) y (range 1000000) :while (< y x)] [x y]))"
  [seq-exprs body-expr]
  (assert-macro-args
    (vector? seq-exprs) "a vector for its binding"
    (even? (count seq-exprs)) "an even number of forms in binding vector")
  (let [to-groups (fn [seq-exprs]
                    (reduce (fn [groups [k v]]
                              (if (keyword? k)
                                (conj (pop groups) (conj (peek groups) [k v]))
                                (conj groups [k v])))
                            [] (partition 2 seq-exprs)))
        err (fn [& msg] (throw (apply str msg)))
        emit-bind (fn emit-bind [[[bind expr & mod-pairs]
                                  & [[_ next-expr] :as next-groups]]]
                    (let [giter (gensym "iter__")
                          gxs (gensym "s__")
                          do-mod (fn do-mod [[[k v :as pair] & etc]]
                                   (cond
                                     (= k :let) `(let ~v ~(do-mod etc))
                                     (= k :while) `(when ~v ~(do-mod etc))
                                     (= k :when) `(if ~v
                                                    ~(do-mod etc)
                                                    (recur (rest ~gxs)))
                                     (keyword? k) (err "Invalid 'for' keyword " k)
                                     next-groups
                                     `(let [iterys# ~(emit-bind next-groups)
                                            fs# (seq (iterys# ~next-expr))]
                                        (if fs#
                                          (concat fs# (~giter (rest ~gxs)))
                                          (recur (rest ~gxs))))
                                     :else (do
                                             `(cons ~body-expr
                                                    (~giter (rest ~gxs))))))]
                      (if next-groups
                        ; not the inner-most loop
                        `(fn ~giter [~gxs]
                           (lazy-seq
                             (loop [~gxs ~gxs]
                               (when-first [~bind ~gxs]
                                 ~(do-mod mod-pairs)))))
                        ; inner-most loop
                        (let [gi (gensym "i__")
                              gb (gensym "b__")
                              do-cmod (fn do-cmod [[[k v :as pair] & etc]]
                                        (cond
                                          (= k :let) `(let ~v ~(do-cmod etc))
                                          (= k :while) `(when ~v ~(do-cmod etc))
                                          (= k :when) `(if ~v
                                                         ~(do-cmod etc)
                                                         (recur
                                                           (unchecked-inc ~gi)))
                                          (keyword? k)
                                          (err "Invalid 'for' keyword " k)
                                          :else
                                          `(do (chunk-append ~gb ~body-expr)
                                               (recur (unchecked-inc ~gi)))))]
                          `(fn ~giter [~gxs]
                             (lazy-seq
                               (loop [~gxs ~gxs]
                                 (when-let [~gxs (seq ~gxs)]
                                   (if (chunked-seq? ~gxs)
                                     (let [c# (chunk-first ~gxs)
                                           size# (int (count c#))
                                           ~gb (chunk-buffer size#)]
                                       (if (loop [~gi (int 0)]
                                             (if (< ~gi size#)
                                               (let [~bind (nth c# ~gi)]
                                                 ~(do-cmod mod-pairs))
                                               true))
                                         (chunk-cons
                                           (chunk ~gb)
                                           (~giter (chunk-rest ~gxs)))
                                         (chunk-cons (chunk ~gb) nil)))
                                     (let [~bind (first ~gxs)]
                                       ~(do-mod mod-pairs)))))))))))]
    `(let [iter# ~(emit-bind (to-groups seq-exprs))]
       (iter# ~(second seq-exprs)))))

; --- wave 27: the prims Specter and faithful programs reach for ---
; Ten small gaps that gate the Specter slices: type/instance? (type
; identity), symbol (reader-faithful construction), sequence (seq that
; is () on empty), keys/vals (map projection in seq order), and
; vec/subs/dissoc/unreduced (collection & string edges). Each is
; written in beam-lisp, on the same RT prims the neighbours use — the
; file feeds itself, and none needs a runtime primitive.

(defn type
  "The type identity of x: the record/deftype module for a user type,
   else the keyword tag BeamLisp.Multi.type_of dispatches protocols on
   (:integer :float :binary :boolean :nil :keyword :list :vector :seq
   :map :fn :tuple :pid :reference). This is the ONE vocabulary — the
   same tags extend-type/extend-protocol key on — so (type o) answers
   exactly what protocol dispatch would ask. Clojure's (:type (meta x))
   first branch has no beam-lisp analogue: runtime values carry no
   :type metadata (meta/with-meta are form-level), so type is type_of."
  [x]
  (BeamLisp.Multi/type_of x))

(defn instance?
  "True when x is an instance of type t. t is a type identity from the
   type vocabulary: a record/deftype module, or one of the builtin
   keyword tags type returns — the check is (= (type x) t), exactly the
   equality a protocol dispatch performs. Builtins are named by their
   keyword tag: (instance? :vector v), (instance? :map m),
   (instance? :integer 5). User types by their module: (instance? Pt r)."
  [t x]
  (= (type x) t))

(defn symbol
  "Builds a symbol whose datum is exactly what the reader yields for a
   quoted symbol — the tagged tuple {:symbol, name} — so a symbol built
   at runtime is indistinguishable from one read from source. The
   2-arity (symbol ns name) yields a namespaced symbol (name string
   \"ns/name\", as the reader reads foo/bar); a nil or empty ns yields
   the bare name symbol, matching Clojure's (symbol nil \"x\")."
  ([x]
   (erlang/list_to_tuple (list :symbol (name x))))
  ([ns x]
   (if (or (nil? ns) (= (str ns) ""))
     (symbol x)
     (erlang/list_to_tuple (list :symbol (str (name ns) "/" (name x)))))))

(defn sequence
  "Like seq, but returns () on an empty coll where seq returns nil —
   the whole reason Clojure keeps them apart. Always an actual seq (a
   lazy seq over the coll), never the coll itself — Clojure's sequence
   is a LazySeq, not the vector it wraps. The 2-arity applies a
   transducer to coll and seqs the result, () when it yields nothing."
  ([coll]
   (map identity (or (seq coll) ())))
  ([xform coll]
   (map identity (or (seq (transduce xform conj [] coll)) ()))))

(defn keys
  "The keys of a map, in the same order seq yields its entries — nil for
   an empty or nil map, as in Clojure. A record's seq iterates its
   public fields, so (keys some-record) reads the field names. Order is
   consistent with vals: (zipmap (keys m) (vals m)) round-trips m."
  [m]
  (when (seq m) (map key (seq m))))

(defn vals
  "The values of a map, in the same order seq yields its entries — nil
   for an empty or nil map. Pairs with keys: (zipmap (keys m) (vals m))
   round-trips m."
  [m]
  (when (seq m) (map val (seq m))))

(defn vec
  "Creates a new vector of coll's contents: nil → [], a lazy seq →
   realized (the seq layer is chunked at 32), a set → its members, a
   map → its [k v] entries.

   Builds the vector in ONE pass rather than conj-ing element by element.
   Each `conj` returns a fresh struct and, past 32 elements, walks the
   trie — so the incremental route cost 3-7x more and scaled worse:

     N          500    1000    2000    4000
     conj-wise 3081us 10261   31935   62741
     one-pass   637us  1732    7195    9342

   This matters more than it looks: `mapv` and `filterv` are `(vec (map
   …))` and `(vec (filter …))`, so every eager collection traversal in
   the language paid it."
  [coll]
  (if (vector? coll)
    coll
    (BeamLisp.Vector/new (to-list coll))))

(defn subs
  "The substring of s from start (inclusive) to end (default (count s))
   exclusive. Indices are char-based, matching count (so multi-byte
   characters are not split). An out-of-range or inverted index raises,
   as in Clojure's StringIndexOutOfBounds."
  ([s start] (subs s start (count s)))
  ([s start end]
   (if (or (neg? start) (> end (count s)) (< end start))
     (throw (ex-info (str "subs: index out of range " start " " end
                          " for length " (count s)) {}))
     (String/slice s start (- end start)))))

(defn unreduced
  "If x is a Reduced — reduce's early-exit sentinel — returns its
   wrapped value; otherwise returns x unchanged."
  [x]
  (if (reduced? x) (deref x) x))

;; A reference struct is a struct-is-a-map hazard: it passes no plain-
;; map check yet Map/delete would silently peel its fields. Collection
;; fns RAISE on references (wave-1 rule); dissoc, which edits a value
;; directly, needs the same guard instead of reopening the hole.
(defn ref-type?
  "True when x is one of the reference structs (Atom, Volatile, Promise,
   Future, Reduced) — a value behind an indirection, never a collection.
   The module atoms are reached by name (String/to_atom) because a
   qualified symbol in a set literal resolves as a var, not a module."
  [x]
  (contains? #{(String/to_atom "Elixir.BeamLisp.Atom")
              (String/to_atom "Elixir.BeamLisp.Volatile")
              (String/to_atom "Elixir.BeamLisp.Promise")
              (String/to_atom "Elixir.BeamLisp.Future")
              (String/to_atom "Elixir.BeamLisp.Reduced")}
             (type x)))

(defn dissoc
  "Returns a map without the given keys (variadic). nil → nil, as in
   Clojure. On a record, dissoc'ing a declared field yields a PLAIN map
   — Clojure's contract — and the struct's __struct__ marker is dropped
   too, so the result is a real map, never a half-broken struct.
   Dissoc'ing a non-declared key (an assoc'd extra) keeps it a record.
   A reference struct raises, like the other collection fns. Any other
   non-map value is returned unchanged (Clojure's identity behaviour)."
  ([m] m)
  ([m k]
   (cond
     (nil? m) nil
     (ref-type? m)
       (throw (ex-info (str "dissoc: " (type m) " is a reference, not a collection") {}))
     ; An ordered map's entries live in a tree, not in struct fields:
     ; Map/delete would edit the STRUCT (leaving the key present), so
     ; sorted maps dispatch to a tree-aware delete. This clause must
     ; precede the record and map? clauses — a sorted map answers true
     ; to map?, and is a struct besides.
     (sorted-map? m) (sorted-dissoc m k)
     (BeamLisp.Record/record? m)
       (if (contains? (set (BeamLisp.Record/fields_of (type m))) k)
         (Map/delete (Map/delete m k) :__struct__)
         (Map/delete m k))
     (map? m) (Map/delete m k)
     :else m))
  ([m k & ks] (reduce (fn [acc x] (dissoc acc x)) (dissoc m k) ks)))

;; ============================================================================
;; Nested access, higher-order composition, and the string namespace.
;;
;; These are core Clojure vocabulary that beam-lisp was missing. Audited by
;; probing the live runtime (see PLAN-021): of 66 everyday fns, 22 were absent
;; — get-in/assoc-in/update-in/update, mapv/filterv, group-by/sort-by/remove,
;; comp/partial/constantly/juxt, letfn, and the whole `str` surface.
;;
;; Written HERE, in beam-lisp, rather than as rt.ex primitives: each one is a
;; few lines over existing primitives, and a core written in the language is
;; the flagship argument for the language. Anything genuinely hot can move to
;; rt.ex later WITHOUT changing these contracts.
;; ============================================================================

(defn to-list
  "A plain Erlang list from any beam-lisp collection: vector, list, lazy seq,
   set, or nil. The normalizing step every Elixir `Enum/*` call needs, since
   Enum does not know BeamLisp.Vector.

   Exists in `optics` too (deliberately duplicated there so that namespace
   stays standalone); this is the core copy every other fn uses."
  [c]
  (cond
    (nil? c) (list)
    (vector? c) (BeamLisp.Vector/to_list c)
    ; Direct rather than via Enum: the members are already a MapSet, so
    ; this answers without a protocol dispatch.
    (set? c) (BeamLisp.Set/to_list c)
    (BeamLisp.LazySeq/lazy? c) (Enum/to_list (doall c))
    ; Via `seq`, not `Enum/to_list`: a map entry must come back as a
    ; beam-lisp VECTOR `[k v]`, which is what `seq` produces and what
    ; every consumer expects. `Enum/to_list` yields raw Erlang 2-tuples,
    ; so `to-list` and `seq` disagreed about the same map — and `vec`
    ; leaked tuples into user data.
    (map? c) (BeamLisp.RT/seq c)
    ; A string is a collection of single-character strings, matching what
    ; `count` and `subs` already assume. Falling through to `:else`
    ; returned the string itself, so `(into [] "ab")` answered `[nil]` —
    ; silently wrong, which is worse than the crash it replaced.
    (string? c) (String/graphemes c)
    :else c))

;; ── nested access ───────────────────────────────────────────────────────────
;; The `not-found` arities matter: `(get-in m ks)` returning nil is ambiguous
;; between "absent" and "present but nil", and callers that need to tell the
;; difference otherwise reach for `contains?` at every level.

(defn get-in
  "The value at path `ks` in a nested associative structure, or `not-found`
   (default nil) when any level is absent. An empty path returns `m` itself."
  ([m ks] (get-in m ks nil))
  ([m ks not-found]
   (loop [cur m
          path (seq ks)]
     (cond
       (nil? path) cur
       (nil? cur) not-found
       :else
       (let [k (first path)]
         (if (contains? cur k)
           (recur (get cur k) (next path))
           not-found))))))

(defn assoc-in
  "Associate `v` at path `ks`, creating intermediate MAPS as needed.
   `(assoc-in {} [:a :b] 1)` → `{:a {:b 1}}`."
  [m ks v]
  (let [k (first ks)
        rest-ks (next ks)]
    (if (nil? rest-ks)
      (assoc m k v)
      (assoc m k (assoc-in (get m k {}) rest-ks v)))))

(defn update
  "Apply `f` to the value at key `k`, with any extra args. The key may be
   absent: `f` then receives nil, as in Clojure."
  ([m k f] (assoc m k (f (get m k))))
  ([m k f a] (assoc m k (f (get m k) a)))
  ([m k f a b] (assoc m k (f (get m k) a b)))
  ([m k f a b & more] (assoc m k (apply f (get m k) a b more))))

(defn update-in
  "Apply `f` to the value at path `ks`, creating intermediate maps as needed."
  ([m ks f]
   (let [k (first ks) rest-ks (next ks)]
     (if (nil? rest-ks)
       (assoc m k (f (get m k)))
       (assoc m k (update-in (get m k {}) rest-ks f)))))
  ([m ks f & args]
   (update-in m ks (fn [x] (apply f x args)))))

;; ── eager collection variants ───────────────────────────────────────────────
;; map/filter are LAZY here (wave 10). `mapv`/`filterv` force to a vector,
;; which is what you want when the result is about to be indexed or counted.

(defn mapv
  "Like `map`, but returns a VECTOR (eager)."
  ([f coll] (vec (map f coll)))
  ([f c1 c2] (vec (map f c1 c2))))

(defn filterv
  "Like `filter`, but returns a VECTOR (eager)."
  [pred coll]
  (vec (filter pred coll)))

(defn remove
  "The complement of `filter`: elements for which `(pred x)` is falsey."
  [pred coll]
  (filter (fn [x] (not (pred x))) coll))

(defn group-by
  "A map of `(f x)` → vector of the x's yielding it. Insertion order within
   each group is preserved."
  [f coll]
  (reduce (fn [acc x]
            (let [k (f x)]
              (assoc acc k (conj (get acc k []) x))))
          {}
          coll))

(defn sort-by
  "A sorted SEQUENCE of `coll`, ordered by `(keyfn item)`. The 3-arity takes a
   comparator `(cmp a b)` over the KEYS returning a NEGATIVE number, zero, or
   a positive number — the three-way shape `sort` and `compare` use, NOT a
   boolean predicate. Passing `<` here silently mis-sorts: `sort` tests the
   result with `<= 0`, and `true` fails that, so every pair compares as
   greater-than and the input comes back in an arbitrary order (observed).

   Built on `sort` rather than on `Enum/sort_by` so the return type is a plain
   list, matching both `sort` and Clojure. Returning a vector here broke two
   tests that pin jank's own vendored `sort-by` (`test/fixtures/jank/`), which
   delegates to `sort` and is byte-for-byte upstream: the fixture is the
   SPECIFICATION, so core bends to it, never the reverse."
  ([keyfn coll] (sort-by keyfn compare coll))
  ([keyfn cmp coll]
   (sort (fn [x y] (cmp (keyfn x) (keyfn y))) coll)))

;; ── function composition ────────────────────────────────────────────────────

(defn comp
  "Compose fns right-to-left: `((comp f g) x)` = `(f (g x))`.
   Zero args yields `identity`, matching Clojure."
  ([] identity)
  ([f] f)
  ([f g] (fn [& args] (f (apply g args))))
  ([f g h] (fn [& args] (f (g (apply h args)))))
  ([f g h & fs]
   (let [all (concat (list f g h) fs)]
     (fn [& args]
       (let [rf (reverse all)]
         (reduce (fn [acc fun] (fun acc))
                 (apply (first rf) args)
                 (rest rf)))))))

(defn partial
  "Partially apply `f` to the leading `args`."
  ([f] f)
  ([f a] (fn [& more] (apply f a more)))
  ([f a b] (fn [& more] (apply f a b more)))
  ([f a b c] (fn [& more] (apply f a b c more)))
  ([f a b c & more] (fn [& later] (apply f (concat (list a b c) more later)))))

(defn constantly
  "A fn of any arity that always returns `x`."
  [x]
  (fn [& _] x))

(defn juxt
  "A fn returning a VECTOR of each supplied fn applied to the args:
   `((juxt a b) x)` → `[(a x) (b x)]`."
  ([f] (fn [& args] [(apply f args)]))
  ([f g] (fn [& args] [(apply f args) (apply g args)]))
  ([f g h] (fn [& args] [(apply f args) (apply g args) (apply h args)]))
  ([f g h & fs]
   (let [all (concat (list f g h) fs)]
     (fn [& args] (vec (map (fn [fun] (apply fun args)) all))))))

;; ── strings ─────────────────────────────────────────────────────────────────
;; Named without a `str/` prefix because beam-lisp has no namespace aliasing
;; for core; these live alongside `str` itself. Every one delegates to Elixir's
;; String module, so they are GRAPHEME-correct — the same property that made
;; spell.ui's editing honest where the jank original counted codepoints.

(defn join
  "Join `coll` into a string. The 1-arity concatenates; the 2-arity puts
   `sep` between elements. Arg order is Clojure's (sep first), NOT Elixir's."
  ([coll] (Enum/join (to-list coll) ""))
  ([sep coll] (Enum/join (to-list coll) sep)))

(defn split
  "Split `s` on `re-or-str`, returning a vector of parts."
  [s sep]
  (vec (String/split s sep)))

(defn trim
  "Trim leading and trailing whitespace."
  [s]
  (String/trim s))

(defn triml [s] (String/trim_leading s))
(defn trimr [s] (String/trim_trailing s))

(defn starts-with?
  "Does `s` begin with `prefix`?"
  [s prefix]
  (String/starts_with? s prefix))

(defn ends-with?
  "Does `s` end with `suffix`?"
  [s suffix]
  (String/ends_with? s suffix))

(defn includes?
  "Does `s` contain `sub`?"
  [s sub]
  (String/contains? s sub))

(defn upper-case [s] (String/upcase s))
(defn lower-case [s] (String/downcase s))

(defn blank?
  "True for nil, \"\", or a string of only whitespace. The check a form
   validator actually wants — `(empty? \"  \")` is false and misleads."
  [s]
  (cond
    (nil? s) true
    (not (string? s)) false
    :else (= "" (String/trim s))))

(defn replace-str
  "Replace EVERY occurrence of `match` in `s` with `replacement`.
   Named `replace-str` because Clojure's `replace` is the collection fn."
  [s match replacement]
  (String/replace s match replacement))

;; ── hashing ─────────────────────────────────────────────────────────────────

(defn sha256-hex
  "Lowercase hex SHA-256 of a string. The stable identity used for contract
   fingerprints, so it must agree byte-for-byte with other runtimes' SHA-256."
  [s]
  (String/downcase (Base/encode16 (crypto/hash :sha256 s))))

(defmacro letfn
  "Bind local functions, MUTUALLY RECURSIVE, then evaluate body:

     (letfn [(even2? [n] (if (= n 0) true  (odd2? (dec n))))
             (odd2?  [n] (if (= n 0) false (even2? (dec n))))]
       (even2? 10))

   Why not `let` + `fn`: a `let` binding cannot see its own name, let alone a
   sibling declared later, so a recursive local written with `let` fails with
   an unbound-var error at call time. Each fn is therefore bound to a
   placeholder first and REBOUND to a closure that resolves its siblings
   through the same scope — the standard letrec construction.

   Implemented with an atom holding the function table: every body resolves a
   sibling by NAME at call time, so declaration order does not matter and a
   cycle of any length works."
  [bindings & body]
  (assert-macro-args
    (vector? bindings) "a vector of (name [args] body) forms")
  (let [specs (map (fn [spec]
                     {:name (first spec)
                      :argv (second spec)
                      :body (rest (rest spec))})
                   bindings)
        tbl (gensym "letfn-tbl")]
    `(let [~tbl (atom {})]
       ;; each entry closes over the TABLE, not over its siblings directly,
       ;; so a call resolves the current definition of any sibling.
       ~@(map (fn [s]
                `(swap! ~tbl assoc
                        ~(keyword (str (get s :name)))
                        (fn ~(get s :argv)
                          ;; rebind every sibling name inside the body
                          (let [~@(mapcat (fn [o]
                                            [(get o :name)
                                             `(get (deref ~tbl)
                                                   ~(keyword (str (get o :name))))])
                                          specs)]
                            ~@(get s :body)))))
              specs)
       (let [~@(mapcat (fn [s]
                         [(get s :name)
                          `(get (deref ~tbl) ~(keyword (str (get s :name))))])
                       specs)]
         ~@body))))

(defn index-of
  "The index of the first occurrence of `sub` in `s`, or nil when absent.

   nil rather than -1: a sentinel index is a number that arithmetic will happily
   consume, so `(subs s (index-of s x))` on a miss silently reads from the end
   instead of failing. nil forces the caller to decide, and `if-let`/`when-let`
   make that ergonomic.

   Character indices, not bytes — `String/split` and `subs` are grapheme-aware
   here, so mixing a byte offset into them would corrupt any non-ASCII string."
  [s sub]
  ;; NB `String/split` wants a keyword LIST for options, not a map: a map
  ;; raises FunctionClauseError rather than being coerced.
  (let [parts (String/split s sub (list [:parts 2]))]
    (if (= 1 (count parts))
      nil
      (count (first parts)))))

(defn last-index-of
  "The index of the LAST occurrence of `sub` in `s`, or nil when absent."
  [s sub]
  (let [parts (String/split s sub)]
    (if (= 1 (count parts))
      nil
      (- (count s) (count (last parts)) (count sub)))))

;; ── tuples ──────────────────────────────────────────────────────────────────
;; beam-lisp has no tuple LITERAL, but the BEAM is made of tuples: every OTP
;; reply, every `:httpc` response, every `{:ok, v}` from Elixir arrives as one.
;; Without these, interop means reaching for `erlang/element` with 1-based
;; indices in the middle of otherwise 0-based code — which is exactly the kind
;; of off-by-one that survives review.

(defn tuple?
  "True for an Erlang tuple."
  [x]
  (erlang/is_tuple x))

(defn elem
  "The element at 0-based index `i` of tuple `t`.

   ZERO-based, matching Elixir's `elem/2` and every other accessor here, NOT
   Erlang's 1-based `element/2`. Mixing the two conventions in one codebase is a
   reliable source of off-by-one bugs, so the boundary is converted once, here."
  [t i]
  (erlang/element (+ i 1) t))

(defn tuple-size
  "The number of elements in a tuple."
  [t]
  (erlang/tuple_size t))

(defn tuple
  "Build a tuple from the given values: `(tuple :ok 1)` → `{:ok, 1}`."
  [& xs]
  (erlang/list_to_tuple (to-list xs)))

(defn tuple->vec
  "A tuple as a vector, for when it is more convenient to index or map over."
  [t]
  (vec (erlang/tuple_to_list t)))

;; ── side-effecting iteration ────────────────────────────────────────────────
;; `map` is LAZY here, so `(map send! xs)` sends NOTHING until something forces
;; the seq — a silent no-op that looks like working code. These force.

(defn run!
  "Apply `f` to every element for side effects, eagerly. Returns nil.
   The eager counterpart to `map` when the result is not wanted."
  [f coll]
  (reduce (fn [_ x] (f x) nil) nil coll)
  nil)

(defmacro doseq
  "Bind each element of `coll` to `binding` and evaluate `body` for effect:

     (doseq [d deltas] (send! target d))

   Returns nil. Exists because `(map f xs)` is lazy: without forcing, a loop
   written with map performs NO side effects, which reads as a bug in whatever
   was supposed to receive them rather than in the loop."
  [bindings & body]
  (assert-macro-args
    (vector? bindings) "a vector binding"
    (= 2 (count bindings)) "exactly 2 forms in the binding vector")
  (let [sym (get bindings 0)
        coll (get bindings 1)]
    `(run! (fn [~sym] ~@body) ~coll)))

;; ── ordered collections ─────────────────────────────────────────────────────
;;
;; `sorted-map` / `sorted-set` are the ORDERED siblings of `{}` / `set`. A
;; hashed collection answers "is x present?"; an ordered one also answers
;; "everything between A and B, in order" — which is the whole basis of an
;; index range scan, and why these exist (PLAN-033).
;;
;; The substrate is `:gb_trees` (BeamLisp.Sorted): O(log n) ops and an
;; iterator that STARTS at an arbitrary key, so `subseq` over a narrow range
;; never walks the keys below it. The vocabulary lives here; Elixir keeps
;; only what genuinely needs the tree.

(defn sorted-map
  "An ordered map from flat key/value args: `(sorted-map :b 2 :a 1)`.

   Iteration, `seq`, `first`, `keys` and printing are all in KEY ORDER — a
   plain `{}` is insertion-ordered by accident of the BEAM's map
   implementation, which is not a contract to rely on. Reach for this
   whenever the order is part of the meaning rather than a coincidence."
  [& kvs]
  (sorted-map-of (partition 2 (or kvs '()))))

(defn sorted-set
  "An ordered set: `(sorted-set 3 1 2)` → `#{1 2 3}`.

   `first` is the SMALLEST member and `last-key` the largest, both O(log n)
   rather than a full scan — the property that makes range work cheap."
  [& xs]
  (sorted-set-of (or xs '())))

(defn into-sorted-map
  "A sorted map built from a collection of `[k v]` entries.
   The collection-taking counterpart to the variadic `sorted-map`."
  [entries]
  (sorted-map-of entries))

(defn into-sorted-set
  "A sorted set of a collection's distinct elements.
   The collection-taking counterpart to the variadic `sorted-set`."
  [coll]
  (sorted-set-of coll))

(defn range-of
  "Ascending elements of a sorted collection between INCLUSIVE bounds.

   `nil` means unbounded on that side, so `(range-of s 10 nil)` is
   everything from 10 up. A sorted set yields members; a sorted map yields
   `[k v]` entries.

   The scan begins AT the lower bound rather than filtering from the start,
   so cost is proportional to the RESULT, not the collection. This is the
   primitive an EAV index scan is built from — `[?e :person/age ?a]` with
   `?a` bounded becomes exactly this call."
  [coll start stop]
  (subseq coll start stop))

(defn reverse-range-of
  "As `range-of`, descending. Bounds stay `[start stop]` in ASCENDING terms —
   `(reverse-range-of s 1 3)` yields 3, 2, 1 — so swapping `range-of` for
   this one never changes WHICH elements come back, only their order."
  [coll start stop]
  (rsubseq coll start stop))

;; ── numeric core ────────────────────────────────────────────────────────────
;;
;; `max-key` and `min-key` shipped without the simpler fns they are named
;; after, and `mod`/`rem` shipped without `quot` (FEAT-006). Each is a
;; one-liner over existing primitives; none needs Elixir.

(defn max
  "The greatest of its arguments.

   Variadic, as in Clojure. Comparison is numeric, so `(max 1.5 2)` is 2
   across int and float."
  ([x] x)
  ([x y] (if (> x y) x y))
  ([x y & more] (reduce (fn [a b] (if (> a b) a b)) (if (> x y) x y) more)))

(defn min
  "The least of its arguments. Variadic, as in Clojure."
  ([x] x)
  ([x y] (if (< x y) x y))
  ([x y & more] (reduce (fn [a b] (if (< a b) a b)) (if (< x y) x y) more)))

(defn abs
  "Absolute value, preserving int/float type."
  [x]
  (if (< x 0) (- x) x))

(defn quot
  "Truncating integer division — the companion to `mod` and `rem`.

   Truncates TOWARD ZERO, so `(quot -7 2)` is -3 where `mod` would floor
   to -4. That difference is the reason both exist."
  [n d]
  (erlang/div n d))
