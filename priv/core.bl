; beam-lisp prelude — jank-flavored Clojure, self-hosted on the BEAM.
;
; These defs compile through the same pipeline as user code; the only
; primitives they lean on are the Elixir fns seeded by BeamLisp.RT.
; Long-term this file converges on jank's own core.jank — same
; language, same names, same semantics.

(defn identity [x] x)

(defn inc [x] (+ x 1))
(defn dec [x] (- x 1))

(defn nil? [x] (= x nil))
(defn not= [a b] (not (= a b)))
(defn some? [x] (not (nil? x)))

(defn map
  ( [f xs]
    (if (empty? xs)
      []
      (cons (f (first xs)) (map f (rest xs))))))

(defn filter
  ( [f xs]
    (if (empty? xs)
      []
      (let [x (first xs)]
        (if (f x)
          (cons x (filter f (rest xs)))
          (filter f (rest xs)))))))

(defn reduce
  ( [f acc xs]
    (loop [acc acc xs xs]
      (if (empty? xs)
        acc
        (recur (f acc (first xs)) (rest xs))))))

(defn range
  ( [n] (range 0 n))
  ( [start end]
    (loop [i start acc ()]
      (if (>= i end)
        (lists/reverse acc)
        (recur (inc i) (cons i acc))))))

(defn second [xs] (let [[_ b] xs] b))

(defn list [& xs] xs)

(defn zipmap
  ( [ks vs]
    (loop [ks ks vs vs acc {}]
      (if (empty? ks)
        acc
        (recur (rest ks) (rest vs) (Map/put acc (first ks) (first vs)))))))

(defn take
  ( [n xs]
    (if (= n 0)
      []
      (if (empty? xs)
        []
        (cons (first xs) (take (dec n) (rest xs)))))))

(defn every?
  ( [f xs]
    (if (empty? xs)
      true
      (if (f (first xs))
        (every? f (rest xs))
        false))))
