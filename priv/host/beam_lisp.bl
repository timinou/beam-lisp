; Exact pinned host for Elixir.BeamLisp. Application.start/2 calls init/0 before
; any self-hosted namespace is available. Keep this leaf independent of core
; vars until the prelude and reader/compiler have been interned in order.
(ns host.beam-lisp)

(defn argv []
  (let [bound (Process/get :bl_argv)]
    (if (nil? bound) (System/argv) bound)))

(defn with_argv [args f]
  (when-not (erlang/is_list args)
    (erlang/error (Elixir.FunctionClauseError/exception
      (list (erlang/list_to_tuple (list :module :Elixir.BeamLisp))
            (erlang/list_to_tuple (list :function :with_argv))
            (erlang/list_to_tuple (list :arity 2))))))
  (let [prev (Process/get :bl_argv)]
    (Process/put :bl_argv args)
    (try (BeamLisp.Ns.Rt/invoke f (list))
      (finally (if (nil? prev) (Process/delete :bl_argv)
                 (Process/put :bl_argv prev))))))

(defn cwd []
  (let [bound (Process/get :bl_cwd)]
    (if (nil? bound) (File/cwd!) bound)))

(defn with_cwd [dir f]
  (when-not (erlang/is_binary dir)
    (erlang/error (Elixir.FunctionClauseError/exception
      (list (erlang/list_to_tuple (list :module :Elixir.BeamLisp))
            (erlang/list_to_tuple (list :function :with_cwd))
            (erlang/list_to_tuple (list :arity 2))))))
  (let [prev (Process/get :bl_cwd)]
    (Process/put :bl_cwd dir)
    (try (BeamLisp.Ns.Rt/invoke f (list))
      (finally (if (nil? prev) (Process/delete :bl_cwd)
                 (Process/put :bl_cwd prev))))))

(defn init []
  ; Flat BEAM deployments have no project priv path. Keep the side-effecting
  ; tagged-reader registrations embedded, exactly as the former @data_readers
  ; external_resource did; seed_test checks this against the source file.
  (when-not (Process/whereis :Elixir.BeamLisp.Env)
    (let [started (BeamLisp.Env/start_link (list))]
      (when-not (or (erlang/== :ok (erlang/element 1 started))
                    (and (erlang/== :error (erlang/element 1 started))
                         (erlang/is_tuple (erlang/element 2 started))
                         (erlang/== :already_started
                                   (erlang/element 1 (erlang/element 2 started)))))
        (erlang/error (Elixir.RuntimeError/exception
          (str "failed to start BeamLisp.Env: " (Elixir.Kernel/inspect started)))))))
  (when-not (BeamLisp.Env/seeded?)
    (BeamLisp.AOT/ensure_loaded "rt")
    (BeamLisp.Ns.Rt/seed_core)
    (BeamLisp.AOT/ensure_loaded "core")
    (BeamLisp.Reader/enable_bl_reader)
    (BeamLisp.Compiler/enable_bl_backend)
    (BeamLisp.AOT/ensure_loaded "multi")
    (BeamLisp.AOT/ensure_loaded "sugar")
    (BeamLisp.Compiler/eval_string
      "(ns data-readers)\n(data-reader! \"d\" (quote datom/read-query))\n(data-reader! \"time\" (quote datom.time/read-iso8601))\n"
      (BeamLisp.Compiler/new_env "core"))
    (BeamLisp.Env/mark_seeded)
    (BeamLisp.Env/in_ns "user"))
  :ok)

(defn eval [source]
  (when (erlang/function_exported :Elixir.BeamLisp.Env :assert_native_framework_execution! 0)
    (BeamLisp.Env/assert_native_framework_execution!))
  (when-not (erlang/is_binary source)
    (erlang/error (Elixir.FunctionClauseError/exception
      (list (erlang/list_to_tuple (list :module :Elixir.BeamLisp))
            (erlang/list_to_tuple (list :function :eval))
            (erlang/list_to_tuple (list :arity 1))))))
  (init)
  (BeamLisp.Compiler/eval_string source))

(defn run_file [path]
  (when (erlang/function_exported :Elixir.BeamLisp.Env :assert_native_framework_execution! 0)
    (BeamLisp.Env/assert_native_framework_execution!))
  (init)
  (BeamLisp.Loader/with_load_path (Path/dirname path)
    (fn []
      (let [source (BeamLisp.Loader/read_source path)]
        (BeamLisp.Env/intern "core" "*command-line-args*" (argv))
        (BeamLisp.Compiler/eval_string source (BeamLisp.Compiler/new_env) path)))))

(defn repl []
  (init)
  (BeamLisp.Loader/ensure_loaded "bl.repl")
  (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! "bl.repl" "run")
                         (list (list) {})))
