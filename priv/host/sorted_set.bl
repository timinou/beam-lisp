; host/sorted_set.bl — the pinned HOST MODULE for
; `Elixir.BeamLisp.Sorted.SortedSet`.
;
; The twin of `priv/host/sorted_map.bl`: `lib/beam_lisp/sorted.ex` lays
; `SortedMap` and `SortedSet` side by side as bare `defstruct [:tree]` modules —
; the same tag-plus-one-field shape under two atoms, which is why one source
; would serve both (the `reader_exception.bl` pattern). They are kept as two
; files so the seed's `host-sources` table stays 1:1 source → module for the
; sorted family, as it is for every entry but the reader's two exceptions. If
; the two ever diverge in shape, the split is already paid for.
;
; WHAT THE MODULE OWES, and why the surface is written BY HAND rather than
; synthesized by `:struct_fields`: a bare `defstruct` has no functions at all,
; `compile_host_file` refuses a source with no top-level `defn` (measured:
; "pinned host module source defines no functions in any namespace"), and
; `:struct_fields` may not be combined with a hand-written `__struct__`/
; `__info__` (it refuses the collision). Spelling the generated surface out is
; the one shape that leaves the emitted beam with the live module's exports
; DATUM FOR DATUM: `__struct__/0,1` and `__info__/1`, and nothing else. No
; helper functions, so nothing else is exported.
;
;     __struct__/0 →  %{__struct__: __MODULE__, tree: nil}
;     __struct__/1 →  Enum.reduce(kv, __struct__/0, fn {k, v}, m ->
;                       :maps.update(k, v, m)          ; unknown key → KeyError
;                     _ -> :erlang.error(:function_clause) end)
;     __info__/1   →  :module / :functions / :macros / :deprecated / :struct,
;                     the last in DECLARATION ORDER, `required: false`
;
; The tag is read from a fun literal compiled into THIS file
; (`erlang:fun_info(F, :module)`), so the same bytes compiled at the production
; atom build a production-tagged value and the same bytes compiled at a probe
; atom build a probe-tagged one.
;
; Run: bin/bl test test/bl/host_sorted_test.bl

(ns host.sorted-set)

(defn __struct__
  "The `defstruct [:tree]` constructor pair. `__struct__/0` is the tag plus the
   one default; `__struct__/1` folds an enumerable of `{k, v}` over it with
   `:maps.update/3`, which refuses an undeclared key with `:error {:badkey, k}`
   — the SAME refusal the generated clause raised (`rescue` normalises it to
   `KeyError`) — and a non-pair element with `FunctionClauseError`, as the
   generated reducer did."
  ([]
   (maps/put :tree nil
     (maps/put :__struct__
       (erlang/element 2 (erlang/fun_info (fn [] nil) :module))
       (maps/new))))
  ([kv]
   (Enum/reduce kv
     (maps/put :tree nil
       (maps/put :__struct__
         (erlang/element 2 (erlang/fun_info (fn [] nil) :module))
         (maps/new)))
     (fn [pair m]
       (if (and (erlang/is_tuple pair) (erlang/== 2 (erlang/tuple_size pair)))
         (erlang/apply :maps :update
           (list (erlang/element 1 pair) (erlang/element 2 pair) m))
         (erlang/error :function_clause))))))

(defn __info__
  "The introspection `Inspect.Any` and `Kernel.struct!/2` read. `:struct` is the
   exact field metadata in DECLARATION ORDER; `:functions` is the constructor
   pair, which is the whole surface. An unknown key misses every clause —
   `FunctionClauseError`, exactly as the generated `__info__/1` refuses it."
  ([key] :when (= key :module)
   (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))
  ([key] :when (= key :functions)
   (list (tuple :__struct__ 0) (tuple :__struct__ 1)))
  ([key] :when (= key :macros) ())
  ([key] :when (= key :deprecated) ())
  ([key] :when (= key :struct)
   (list (maps/put :required false
           (maps/put :default nil
             (maps/put :field :tree (maps/new)))))))
