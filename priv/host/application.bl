; host/application.bl — the pinned HOST MODULE for `Elixir.BeamLisp.Application`.
;
; `BeamLisp.Application` is the OTP application callback `env.bl` names in its
; `:mod` entry, so `beam_lisp.app` carries `{mod, {'Elixir.BeamLisp.Application',
; []}}` and `Application.ensure_all_started(:beam_lisp)` calls
; `start(:normal, [])` on it. This file is the `.bl` port of
; `lib/beam_lisp/application.ex`, compiled FUNCTIONS-ONLY by
; `BeamLisp.AOT/compile_host_file` into `Elixir.BeamLisp.Application.beam` — no
; `use Application`, no Elixir source.
;
; WHAT THE CALLBACK MUST REPRODUCE, EXACTLY
;
;   * `start/2` starts the ONE supervisor the runtime runs under — children
;     `[BeamLisp.Env, BeamLisp.Loader.Server]`, strategy `:one_for_one`,
;     registered as `BeamLisp.Supervisor` — and returns its `{:ok, pid}` (a
;     start failure returns `{:error, reason}`, which OTP turns into a failed
;     application start; this callback does not swallow it).
;
;     The children are MODULE ATOMS, never MFA tuples. That is the `child_spec`
;     expectation and it is load-bearing: OTP asks each atom for its OWN
;     generated `child_spec/1` (`use Agent` for Env, `use GenServer` for
;     Loader.Server), so the child ids, restart types and `start_link/1`
;     arguments stay the live modules' — an MFA tuple would silently replace
;     all three with a default spec.
;
;   * `BeamLisp.init/0` runs AFTER the supervisor is up, once per app start.
;     The ORDER is the whole point: `init/0` interns the toolchain (the
;     self-hosted reader/compiler and the prelude) into `BeamLisp.Env`'s var
;     table, so the Env process MUST already be supervised when it runs —
;     otherwise an unsupervised Env is started on demand and the runtime is
;     left outside the tree that is supposed to own it. The call is CONDITIONAL
;     in the sense that matters: it belongs to this callback's success path and
;     to no other (nothing at module load, nothing before the children exist),
;     Then load and supervise the native owner registry, whose source helpers
;     require a seeded language. Env owns its index; collector restarts preserve
;     entries and rebuild monitors. The callback only returns success after this
;     third child is ready. `init/0` is itself idempotent (guarded by `Env.seeded?/0`), so a
;     second app start in an already-seeded VM is a cheap no-op — never a
;     second seeding.
;
;   * `stop/1` is the OTP `stop` callback, answering `:ok`. `use Application`
;     GENERATES this one (`def stop(_state), do: :ok`, overridable) and the live
;     module does not override it, so it is ported rather than dropped: a
;     callback module missing `stop/1` is not what `beam_lisp.app` ships.
;
;   * `config_change/3` is an OPTIONAL `Application` callback that the live
;     module does NOT define (`Application.behaviour_info(:optional_callbacks)`
;     lists it beside `prep_stop/1` and `start_phase/3`). It is therefore NOT
;     added here — this module's export surface IS the port's contract, and a
;     "helpful" extra callback would be a surface the live module never had.
;
;   * the `-behaviour Application` attribute IS carried — `compile_host_file`'s
;     `:behaviour` option is how a pinned host records it, so `env.bl`'s `:mod`
;     still names a module OTP and every behaviour reader can see is an
;     `Application` callback module. One shape difference, carried by the whole
;     pinned-host family and not by this file: Elixir's `@behaviour` records a
;     ONE-ELEMENT LIST (`behaviour: [Application]`), while the pinned emitter
;     records the bare module atom (`behaviour: Application`) — the same shape
;     `priv/host/web_socket.bl` ships for `-behaviour WebSock`. Nothing reads
;     the container: OTP dispatches on the exported callbacks.
;
; PRE-BOOT DISCIPLINE. This callback runs BEFORE the language exists: it is what
; starts the process `BeamLisp.init/0` then interns into. So it calls HOST code
; only until `BeamLisp.init/0` completes. Before then, never `BeamLisp.Ns.Rt` or
; another `.bl` helper: those resolve their siblings through the var table this
; callback's own `init/0` call is what fills, so a call into them here is
; `undefined var` at the exact moment nothing can answer it. The pinned beam is
; functions-only for the same reason — it is loadable, and its callbacks run,
; with no `__bl_init__/0` and no interned var.
;
; Run: bin/bl test test/bl/host_application_test.bl

(ns host.application)

(defn start
  "The OTP `start/2` callback: supervise Env + Loader.Server, then boot the
   language on top of them. Returns the supervisor's own `{:ok, pid}`, or its
   `{:error, reason}` — passed through unchanged, so a failed start stays a
   failed start."
  [_type _args]
  (let [children (list :"Elixir.BeamLisp.Env" :"Elixir.BeamLisp.Loader.Server")
        result (Supervisor/start_link
                 children
                 (list (tuple :strategy :one_for_one)
                       (tuple :name :"Elixir.BeamLisp.Supervisor")))]
    (when (and (erlang/is_tuple result) (erlang/== :ok (erlang/element 1 result)))
      (try
        (BeamLisp/init)
        ; Language helpers are safe only AFTER boot. Physical owner discovery
        ; is shared runtime infrastructure, never an application opt-in.
        (BeamLisp.Loader/ensure_loaded "proc.owner-registry")
        (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! "proc.owner-registry" "start-child!") (list))
        (catch e
          ; Stop only the supervisor this call started, never an existing tree.
          (Supervisor/stop (erlang/element 2 result))
          ; Preserve the original exception kind and failing frame. Re-raising
          ; with error/1 hid the loader/compiler failure behind start/2.
          (erlang/raise __EXCEPTION_KIND__ e __STACKTRACE__))))
    result))

(defn stop
  "The OTP `stop/1` callback: what `use Application` generates for the live
   module. The argument is the supervisor's pid (or `:undefined` when the
   application never started); the generated callback ignores it and answers
   `:ok`, so this one does too."
  [_state]
  :ok)
