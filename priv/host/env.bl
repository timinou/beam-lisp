; host/env.bl — the pinned HOST MODULE for `Elixir.BeamLisp.Env`.
;
; `lib/beam_lisp/env.ex` is the VAR REGISTRY: process-scoped environments with a
; read-through chain, an ETS table every compiled var deref reads lock-free, and
; an Agent owning the small namespace/bootstrap state and the table itself. This
; file is the `.bl` port of that module, compiled by
; `BeamLisp.AOT/compile_host_file` into ONE exact-named beam
; (`Elixir.BeamLisp.Env.beam`) whose top-level `defn`s are plain exported
; functions — the exact call surface every caller already names at
; `Elixir.BeamLisp.Env`, so no caller is renamed.
;
; WHY A PINNED MODULE AND NOT A NAMESPACE. `Env` is the first child of the
; runtime's supervisor and the table every later boot step interns into. The
; pinned beam must RUN before the language exists, so it can never itself be an
; AOT-rebuilt `BeamLisp.Ns.*` namespace. It is a pinned host beam instead.
;
; ── THE PREBOOT CONSTRAINT ──────────────────────────────────────────────────
;
; `start_link/1` (and the Agent init closure it runs, and `child_spec/1`) are
; called BEFORE `BeamLisp.Ns.Rt/seed_core` — by `BeamLisp/init`, by
; `BeamLisp.AOT/boot`, and by OTP starting the supervisor. So those functions
; are written in the surface that needs NO namespace var and NO `BeamLisp.Ns.Rt`:
;
;   * `(list …)` / `(tuple …)` compile to `BeamLisp.Ns.Core.list__bl_v` /
;     `tuple__bl_v` — the PRELUDE's raw constructors, already a committed AOT
;     beam on the code path (this is exactly what `priv/host/application.bl`
;     relies on pre-boot). They are used freely.
;
;   * `(maps/new)`, `(maps/put k v m)`, `(MapSet/new)`, `(Agent/…)`,
;     `(Process/…)`, `(:ets/…)`, `(:persistent_term/…)`, `(:atomics/…)` are
;     calls to `:erlang`/`:maps`/Elixir/OTP modules — always available.
;
;   * a MAP LITERAL `{…}` compiles through `BeamLisp.Ns.Rt.hash_key`, and a
;     VECTOR literal `[…]` builds a `BeamLisp.Vector`; a bare `str` is
;     `BeamLisp.Ns.Rt`s — so NONE of those three is used here. Maps are built
;     with `(maps/new)`/`(maps/put)` and strings with `erlang/iolist_to_binary`
;     over `Kernel/inspect`, the discipline `priv/host/refs.bl` documents.
;
; Functions called only AFTER boot (the whole hash table of registry helpers,
; `fork`/`destroy`, the loader path stack, …) may call `BeamLisp.Ns.Rt/invoke`
; to run a beam-lisp thunk — the call sits in the body, not on the init path.
;
; ── ABI PARITY IS THE CONTRACT ──────────────────────────────────────────────
;
; Every function reproduces its Elixir counterpart: the same chain walk, the same
; evaluation order, the same return shapes (`{:ok, value}` / `:error`, `:ok`,
; the value), the same exception CLASS, and the same ARITY DEFAULTS — `fork/0`
; and `fork/1` delegate to `fork/2`, `caps_allowed?/1` to `caps_allowed?/2`, the
; `isolated/1` to `isolated/2`, and `fresh_env_state/1,2` to `fresh_env_state/3`.
;
; ── GUARDS THAT BECOME BODY CHECKS ──────────────────────────────────────────
;
; Beam-lisp's guard vocabulary (`priv/boot/compiler.bl`'s `guard-bifs`) has no
; atom predicate, no `is_function/2`, and `map?` EXCLUDES structs. So every
; `is_atom` / `is_function(f, 0)` / `is_map` / `is_list` clause head in the
; Elixir module becomes a BODY check that, on failure, raises the SAME
; `%FunctionClauseError{}` the guard would have carried — module, function and
; arity named — through `erlang/error` (the `priv/host/sandbox.bl` technique).
; `is_binary` has a guard (`string?`), but the checks are written uniformly in
; the body for one idiom.
;
; ── THE `^:per-env` DESCRIPTOR IS A TAGGED MAP ──────────────────────────────
;
; The Elixir module's nested `BeamLisp.Env.PerEnvDef` struct is only ever read
; by `Env` itself (`fetch/2`, `explain/2`, `resolve_per_env/3`); the compiler
; probes a per-env var with `peek/2` and treats any non-atom, non-macro value as
; "a descriptor, do not materialize" WITHOUT naming its type. So the descriptor
; is built here as the SAME tagged map `defstruct [:generation, :init]` would
; produce — `%{__struct__: :"Elixir.BeamLisp.Env.PerEnvDef", generation: ref,
; init: thunk}` — and recognised by that tag. A pinned one-module beam cannot
; declare a sibling struct module, and none is needed: a struct is a tagged map.
;
; Run: bin/bl test test/bl/env_host_test.bl

(ns host.env)

; ── small internals ────────────────────────────────────────────────────────
;
; A pinned module has NO private surface: the emitter exports every top-level
; `defn`, so these ride along as exports the way `priv/host/refs.bl`'s helpers
; do. Nothing outside calls them.

(defn- own-module
  "This module's own atom, read from a fun literal compiled into THIS file — the
   same source serves the production atom in the seed and a probe atom under
   test without naming either."
  []
  (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))

(defn- fce!
  "Raise the `%FunctionClauseError{}` a guard clause head would have raised:
   module, function and arity named, exactly as the BEAM builds it."
  [fname arity]
  (erlang/error
    (Elixir.FunctionClauseError/exception
      (list (tuple :module (own-module))
            (tuple :function fname)
            (tuple :arity arity)))))

(defn- per_env_def?
  "Whether a value is a `^:per-env` descriptor: a map carrying the
   `BeamLisp.Env.PerEnvDef` struct tag."
  [x]
  (and (erlang/is_map x)
       (erlang/== :"Elixir.BeamLisp.Env.PerEnvDef" (maps/get :__struct__ x nil))))

(defn- make_per_env_def [generation init]
  (maps/put :__struct__ :"Elixir.BeamLisp.Env.PerEnvDef"
    (maps/put :generation generation
      (maps/put :init init (maps/new)))))

(defn- per_env_instance_key [resolved_ns resolved_name]
  (tuple :per_env_instance resolved_ns resolved_name))

(defn- restore_pdict [key value]
  (if (erlang/== nil value) (Process/delete key) (Process/put key value)))

; ── the Agent + ETS table ──────────────────────────────────────────────────

(defn start_link
  "The OTP `start_link/1`: start the registry Agent under this module's own
   atom and create the public `:beam_lisp_vars` table it owns. The argument is
   ignored (the live module ignores it too); the child spec hands it `[]`."
  [_opts]
  (Agent/start_link
    (fn []
      (ets/new :beam_lisp_vars
        (list :named_table :public (erlang/list_to_tuple (list :read_concurrency true))))
      (maps/put :ns "user"
        (maps/put :seeded false
          (maps/put :loaded (MapSet/new)
            (maps/put :load_paths (list)
              (maps/put :search_paths (list)
                (maps/put :envs (maps/new) (maps/new))))))))
    (list (erlang/list_to_tuple (list :name (own-module))))))

(defn child_spec
  "The `child_spec/1` `use Agent` generates, clause for clause: a map whose
   `id` is this module and whose `start` is `{this module, :start_link,
   [init_arg]}`, normalized by `Supervisor.child_spec/2` with the macro's empty
   option list. `BeamLisp.Application.start/2` passes the MODULE ATOM in the
   child list, so OTP asks THIS module for its own spec."
  [init_arg]
  (Supervisor/child_spec
    (maps/put :id (own-module)
      (maps/put :start (erlang/list_to_tuple (list (own-module) :start_link (list init_arg)))
        (maps/new)))
    (list)))

; ── Environments ───────────────────────────────────────────────────────────

(defn env_id
  "The current process's env id (`:global` when unbound)."
  []
  (Process/get :bl_env :global))

(defn chain
  "The read-through chain for the current process, innermost first."
  []
  (Process/get :bl_env_chain (list :global)))

(defn fork
  "Create a new env whose reads fall through to `parent` (default: the current
   env). Returns the env id; does NOT bind it — see `with_env/2`.

   `:caps` attenuates the child's host-interop set (parent ∩ spec, monotonic
   weakening); `:max_heap_words` narrows the heap the same way (a child never
   gets MORE than its parent). `:global` holds `:all` and `nil` (= unbounded)."
  ([] (fork (env_id) (list)))
  ([parent] (fork parent (list)))
  ([parent opts]
   (let [id (tuple :env (erlang/make_ref))
         caps (intersect_caps (caps_of parent) (Keyword/get opts :caps :all))
         heap (min_heap (heap_of parent) (Keyword/get opts :max_heap_words))]
     (Agent/update (own-module)
       (fn [s]
         (let [envs (Map/get s :envs (maps/new))]
           (Map/put s :envs (Map/put envs id (fresh_env_state parent caps heap))))))
     id)))

(defn- fresh_env_state
  ([parent] (fresh_env_state parent :all nil))
  ([parent caps] (fresh_env_state parent caps nil))
  ([parent caps heap]
   (maps/put :parent parent
     (maps/put :loaded (MapSet/new)
       (maps/put :search_paths (list)
         (maps/put :caps caps
           (maps/put :max_heap heap (maps/new))))))))

(defn- min_heap [parent spec]
  (cond
    (erlang/== nil parent) spec
    (erlang/== nil spec) parent
    :else (erlang/min parent spec)))

(defn heap_of
  "The env's max-heap bound in words (nil = unbounded)."
  [env]
  (if (erlang/== :global env)
    nil
    (Agent/get (own-module)
      (fn [s]
        (let [st (Map/get (Map/get s :envs (maps/new)) env)]
          (if (erlang/== nil st) nil (Map/get st :max_heap)))))))

(defn max_heap
  "This process's max-heap bound in words (nil = unbounded)."
  []
  (Process/get :bl_max_heap))

(defn- intersect_caps [a b]
  (cond
    (and (erlang/== :all a) (erlang/== :all b)) :all
    (erlang/== :all a) (MapSet/new b)
    (erlang/== :all b) a
    :else (MapSet/intersection a (MapSet/new b))))

; ── Capabilities ───────────────────────────────────────────────────────────

(defn caps_of
  "The effective capability set of `env`: `:all` or a `MapSet` of allowed
   modules. `:global` holds `:all`; a forked env's caps were intersected at
   fork time, so this lookup never walks the chain."
  [env]
  (if (erlang/== :global env)
    :all
    (Agent/get (own-module)
      (fn [s]
        (let [st (Map/get (Map/get s :envs (maps/new)) env)]
          ; Absent from the registry = never forked or already destroyed.
          ; Caps are a security boundary: fail CLOSED (no host interop),
          ; unlike reads, which degrade past dead envs.
          (if (erlang/== nil st) (MapSet/new) (Map/get st :caps)))))))

(defn caps
  "The current process's capability set (`:all` when unbound)."
  []
  (Process/get :bl_caps :all))

(defn caps_allowed?
  "Whether the current process's env grants interop to `module`, optionally
   narrowed to `op`: a bare-module grant covers every op, a `{module, op}` grant
   only the matching one. The hot path of the capability gate: one pdict read
   plus set membership."
  ([module] (caps_allowed? module nil))
  ([module op]
   (let [c (caps)]
     (if (erlang/== :all c)
       true
       (or (MapSet/member? c module)
           (and (not (erlang/== nil op)) (MapSet/member? c (tuple module op))))))))

(defn reachable?
  "Whether this env can touch `module` for AT LEAST ONE op — the reflective
   question, distinct from `caps_allowed?/2`'s per-fn one."
  [module]
  (let [c (caps)]
    (if (erlang/== :all c)
      true
      (or (MapSet/member? c module)
          (Enum/any? c
            (fn [x]
              (and (erlang/is_tuple x) (erlang/== 2 (erlang/tuple_size x))
                   (erlang/== module (erlang/element 1 x)))))))))

(defn op_of
  "The op a module's fn performs, per the op table — or nil when the table
   doesn't say."
  [module fun]
  (ensure_op_table)
  (let [r (ets/lookup :beam_lisp_ops (tuple module fun))]
    (if (erlang/== 0 (erlang/length r))
      nil
      (erlang/element 2 (erlang/hd r)))))

(defn register_op
  "Add `{module, fn} → op` to the op table (app-specific modules)."
  [module fun op]
  (if (erlang/is_atom op)
    (do
      (ensure_op_table)
      (ets/insert :beam_lisp_ops (tuple (tuple module fun) op))
      :ok)
    (fce! :register_op 3)))

(defn- default_ops
  "The default table: the dangerous-shape modules, read/write/env/exec split.
   Data, not code — the module atoms are spelled as `:Elixir.X`/`:os`/`:erlang`
   keywords so a bare `File` is never resolved as a namespace variable."
  []
  (list (tuple :Elixir.File :read :read) (tuple :Elixir.File :read! :read)
        (tuple :Elixir.File :exists? :read) (tuple :Elixir.File :ls :read)
        (tuple :Elixir.File :ls! :read) (tuple :Elixir.File :stat :read)
        (tuple :Elixir.File :cwd :read) (tuple :Elixir.File :cwd! :read)
        (tuple :Elixir.File :write :write) (tuple :Elixir.File :write! :write)
        (tuple :Elixir.File :rm :write) (tuple :Elixir.File :rm! :write)
        (tuple :Elixir.File :rm_rf :write) (tuple :Elixir.File :mkdir :write)
        (tuple :Elixir.File :mkdir_p :write) (tuple :Elixir.File :cp :write)
        (tuple :Elixir.File :rename :write)
        (tuple :Elixir.System :get_env :env_read) (tuple :Elixir.System :fetch_env :env_read)
        (tuple :Elixir.System :put_env :env_write) (tuple :Elixir.System :delete_env :env_write)
        (tuple :Elixir.System :cmd :exec) (tuple :Elixir.System :shell :exec)
        (tuple :os :cmd :exec) (tuple :os :getenv :env_read) (tuple :os :putenv :env_write)
        (tuple :Elixir.Code :eval_string :eval) (tuple :Elixir.Code :eval_quoted :eval)
        (tuple :Elixir.Code :compile_string :eval) (tuple :erlang :apply :eval)))

(defn- ensure_op_table []
  (if (erlang/== :undefined (ets/whereis :beam_lisp_ops))
    (do
      (BeamLisp.Loader.Server/run
        (fn []
          (try
            (ets/new :beam_lisp_ops (list :named_table :public :set (tuple :read_concurrency true)))
            (catch e
              (if (and (erlang/is_map e)
                       (erlang/== :"Elixir.ArgumentError" (maps/get :__struct__ e nil)))
                :ok
                (erlang/error e))))))
      (Enum/each (default_ops)
        (fn [t]
          (ets/insert :beam_lisp_ops
            (tuple (tuple (erlang/element 1 t) (erlang/element 2 t)) (erlang/element 3 t)))))
      :ok)
    :ok))

(defn with_env
  "Run `fun` with `env` bound in the calling process; restores the previous
   binding (and process-local current-ns) afterwards."
  [env fun]
  (let [thunk (as_thunk fun)
        prev_env (Process/get :bl_env)
        prev_chain (Process/get :bl_env_chain)
        prev_ns (Process/get :bl_ns)
        prev_caps (Process/get :bl_caps)
        prev_heap (Process/get :bl_max_heap)]
    (Process/put :bl_env env)
    (Process/put :bl_env_chain (compute_chain env))
    (Process/put :bl_caps (caps_of env))
    (restore_pdict :bl_max_heap (heap_of env))
    ; A fresh env means a fresh `*ns*`: Clojure thread-local semantics.
    (Process/delete :bl_ns)
    (try
      (thunk)
      (finally
        (restore_pdict :bl_env prev_env)
        (restore_pdict :bl_env_chain prev_chain)
        (restore_pdict :bl_ns prev_ns)
        (restore_pdict :bl_caps prev_caps)
        (restore_pdict :bl_max_heap prev_heap)))))

(defn isolated
  "Fork an env (parent: the current env), bind it for `fun`, and destroy it
   afterwards. The one-call shape of \"run this in a clean room\"."
  ([fun] (isolated (env_id) fun))
  ([parent fun]
   (let [env (fork parent)]
     (try
       (with_env env fun)
       (finally
         (destroy env))))))

(defn- as_thunk
  "bl fns are tagged structs, not Elixir fns — normalize any invocable thunk to
   a zero-arity invocable so `with_env` works from bl source without the caller
   hand-wrapping through `rt/invoke`."
  [fun]
  (if (erlang/is_function fun 0)
    fun
    (fn [] (BeamLisp.Ns.Rt/invoke fun (list)))))

(defn convey
  "Wrap a one-argument invocable as an arity-1 fn that first binds the CALLER's
   env, then invokes. Conveyance keeps Clojure-dynamic semantics across the
   process boundary; caps re-derive in `bind/1`, so a capped caller's rights
   ride along."
  [fun]
  (let [token (capture)
        inner (fn [arg] (BeamLisp.Ns.Rt/invoke fun (list arg)))]
    (fn [arg] (bind token) (inner arg))))

(defn destroy
  "Drop every row belonging to `env` and forget its bookkeeping. One
   `select_delete` scan guarded on the key's first element, so it works for
   every key shape without enumerating them."
  [env]
  (let [spec (list (tuple (tuple :"$1" :_)
                          (list (tuple :andalso
                                       (tuple :is_tuple :"$1")
                                       (tuple :== (tuple :element 1 :"$1") (tuple :const env))))
                          (list true)))]
    (ets/select_delete :beam_lisp_vars spec)
    (bump_epoch)
    (Agent/update (own-module)
      (fn [s] (Map/update s :envs (maps/new) (fn [envs] (Map/delete envs env)))))
    :ok))

(defn attach
  "Bind `env` in the calling process without a block form — the harness
   primitive behind `Sandbox.checkout/1`."
  [env]
  (Process/put :bl_env env)
  (Process/put :bl_env_chain (compute_chain env))
  (Process/put :bl_caps (caps_of env))
  (restore_pdict :bl_max_heap (heap_of env))
  (Process/delete :bl_ns)
  :ok)

(defn capture
  "Capture the current env binding (id + chain + process-local ns) as an opaque
   token for `bind/1`."
  []
  (maps/put :env (Process/get :bl_env)
    (maps/put :chain (Process/get :bl_env_chain)
      (maps/put :ns (Process/get :bl_ns)
        (maps/put :caps (Process/get :bl_caps)
          (maps/put :max_heap (Process/get :bl_max_heap) (maps/new)))))))

(defn bind
  "Install a token from `capture/0` in the calling process.

   Caps are RE-DERIVED from `caps_of(env)`, never taken from the token: a token
   is a value and can be stale (env destroyed → fail closed) or smuggled across
   a boundary — the registry is the only source of truth."
  [token]
  (if (and (erlang/is_map token)
           (maps/is_key :env token) (maps/is_key :chain token) (maps/is_key :ns token))
    (let [env (maps/get :env token)
          chain (maps/get :chain token)
          ns (maps/get :ns token)]
      (restore_pdict :bl_env env)
      (restore_pdict :bl_env_chain chain)
      (restore_pdict :bl_ns ns)
      (restore_pdict :bl_caps (if (erlang/== nil env) nil (caps_of env)))
      (restore_pdict :bl_max_heap (Map/get token :max_heap))
      :ok)
    (fce! :bind 1)))

(defn explain
  "Debug aid: for each env in the chain and each resolution candidate, show
   whether the var is present."
  [ns name]
  (Enum/flat_map (chain)
    (fn [env]
      (Enum/map (candidates ns name)
        (fn [pair]
          (let [cns (erlang/element 1 pair)
                cname (erlang/element 2 pair)
                instance? (ets/member :beam_lisp_vars (pfx env (per_env_instance_key cns cname)))
                row (ets/lookup :beam_lisp_vars (pfx env (tuple cns cname)))
                kind0 (cond
                        (erlang/== 0 (erlang/length row))
                        (if instance? :per_env_materialized_here :absent)

                        (per_env_def? (erlang/element 2 (erlang/hd row)))
                        :per_env_definition

                        :else :normal)
                kind (if (and (erlang/== :per_env_definition kind0) instance?)
                       :per_env_materialized_here
                       kind0)]
            (maps/put :env env
              (maps/put :ns cns
                (maps/put :name cname
                  (maps/put :found (not (erlang/== :absent kind))
                    (maps/put :kind kind (maps/new))))))))))))

(defn- compute_chain
  "Walk the env metadata to build the read-through chain. Cold: runs once per
   bind, not per lookup. Degrades past unknown (destroyed) envs."
  ([env] (compute_chain env 8 (list)))
  ([env depth acc]
   (cond
     (erlang/== :global env) (Enum/reverse (erlang/++ (list :global) acc))
     (erlang/== 0 depth) (Enum/reverse (erlang/++ (list :global) acc))
     :else
     (let [st (env_state env)]
       (cond
         (erlang/== nil st) (Enum/reverse (erlang/++ (list :global) acc))
         (erlang/== :global (Map/get st :parent))
         (Enum/reverse (erlang/++ (list :global env) acc))
         :else
         (compute_chain (Map/get st :parent) (- depth 1) (erlang/++ (list env) acc)))))))

(defn- env_state [env]
  (Agent/get (own-module)
    (fn [s] (Map/get (Map/get s :envs (maps/new)) env))))

(defn- update_env_state [env fun]
  (Agent/update (own-module)
    (fn [s]
      (let [envs (Map/get s :envs (maps/new))
            state (Map/get envs env (fresh_env_state :global))]
        (Map/put s :envs (Map/put envs env (fun state)))))))

; ── Key plumbing (shared by the registry modules) ──────────────────────────

(defn pfx
  "Prefix an old-shape key with an env id. Atoms become `{env, atom}`; tuples
   gain env as element 0."
  [env k]
  (cond
    (erlang/is_tuple k) (Tuple/insert_at k 0 env)
    (erlang/is_atom k) (tuple env k)
    :else (fce! :pfx 2)))

(defn key [k] (pfx (env_id) k))

(defn lookup
  "Chain-walking lookup of an old-shape key: `{:ok, value}` or `:error`."
  [k]
  (Enum/find_value (chain) :error
    (fn [env]
      (let [row (ets/lookup :beam_lisp_vars (pfx env k))]
        (if (erlang/== 0 (erlang/length row))
          nil
          (tuple :ok (erlang/element 2 (erlang/hd row))))))))

(defn member?
  "Chain-walking membership test of an old-shape key."
  [k]
  (Enum/any? (chain) (fn [env] (ets/member :beam_lisp_vars (pfx env k)))))

(defn put_key
  "Insert `{key, value}` into the CURRENT env (writes never cross envs)."
  [k value]
  (ets/insert :beam_lisp_vars (tuple (key k) value))
  (bump_epoch))

(defn delete_key
  "Delete an old-shape key from the CURRENT env only."
  [k]
  (ets/delete :beam_lisp_vars (key k))
  (bump_epoch))

; --- fetch memo: epoch + per-process cache -------------------------------
;
; Every var deref is an :ets.lookup, and an ETS read COPIES the term into the
; caller's heap. Writes are rare and ALL flow through put_key/delete_key/
; destroy, so: one global atomics epoch, bumped by every mutation, and a
; per-process memo keyed by {chain, ns, name}. The epoch is read BEFORE the
; ETS walk and the result cached under THAT epoch: a writer racing the walk
; bumps after its mutation, so a walk that saw old rows is cached under the
; old epoch and the next deref refetches — never the reverse.

(defn- epoch_ref []
  (let [k (tuple (own-module) :epoch_ref)
        ref (persistent_term/get k nil)]
    (if (erlang/== nil ref)
      (let [r (atomics/new 1 (list (tuple :signed false)))]
        (persistent_term/put k r)
        r)
      ref)))

(defn- current_epoch [] (atomics/get (epoch_ref) 1))

(defn- bump_epoch []
  (atomics/add (epoch_ref) 1 1)
  :ok)

(defn match
  "Chain-walking `:ets.match/2`: the whole-row pattern's key half gets the env
   prefix per chain link, results concatenated innermost-first."
  [pair]
  (if (and (erlang/is_tuple pair) (erlang/== 2 (erlang/tuple_size pair)))
    (let [kp (erlang/element 1 pair)
          vp (erlang/element 2 pair)]
      (Enum/flat_map (chain)
        (fn [env] (ets/match :beam_lisp_vars (tuple (pfx env kp) vp)))))
    (fce! :match 1)))

(defn lookup_own
  "Exact-env `:ets.lookup`: the current env only, no read-through."
  [k]
  (let [row (ets/lookup :beam_lisp_vars (key k))]
    (if (erlang/== 0 (erlang/length row))
      :error
      (tuple :ok (erlang/element 2 (erlang/hd row))))))

(defn match_own [pair]
  (if (and (erlang/is_tuple pair) (erlang/== 2 (erlang/tuple_size pair)))
    (ets/match :beam_lisp_vars
      (tuple (key (erlang/element 1 pair)) (erlang/element 2 pair)))
    (fce! :match_own 1)))

(defn match_delete_own [pair]
  (if (and (erlang/is_tuple pair) (erlang/== 2 (erlang/tuple_size pair)))
    (ets/match_delete :beam_lisp_vars
      (tuple (key (erlang/element 1 pair)) (erlang/element 2 pair)))
    (fce! :match_delete_own 1)))

; ── Namespaces and vars ────────────────────────────────────────────────────

(defn current_ns
  "The namespace new defs land in. pdict FIRST, at every env — `*ns*` is
   thread-local (Clojure's model); the Agent value is the ambient default for
   processes that never set one."
  []
  (let [v (Process/get :bl_ns)]
    (if (erlang/== nil v)
      (if (erlang/== :global (env_id))
        (Agent/get (own-module) (fn [s] (Map/get s :ns)))
        "user")
      v)))

(defn in_ns
  "Bind the process-local current namespace and declare it. Idempotent."
  [ns]
  (if (erlang/is_binary ns)
    (do
      (Process/put :bl_ns ns)
      (declare_ns ns)
      (if (erlang/== :global (env_id))
        (Agent/update (own-module) (fn [s] (Map/put s :ns ns)))
        nil)
      :ok)
    (fce! :in_ns 1)))

(defn with_ns
  "Run `fun` with `current_ns` bound to `ns`, restoring the previous value
   afterwards — even on raise."
  [ns fun]
  (if (and (erlang/is_binary ns) (erlang/is_function fun 0))
    (let [prev (current_ns)]
      (in_ns ns)
      (try
        (fun)
        (finally
          (in_ns prev))))
    (fce! :with_ns 2)))

(defn intern
  "Bind `name` to `value` in `ns`. Returns the value, like Clojure's def."
  [ns name value]
  (put_key (tuple ns name) value)
  value)

(defn define_per_env
  "Register a `^:per-env` def: intern a descriptor (a re-runnable `init` thunk)
   into the CURRENT env's `{ns, name}` slot instead of a value. Returns `:ok`."
  [ns name init]
  (if (erlang/is_function init 0)
    (do
      (put_key (tuple ns name) (make_per_env_def (erlang/make_ref) init))
      :ok)
    (fce! :define_per_env 3)))

(defn- resolve_per_env
  "Resolve a descriptor hit to a concrete value for the CURRENT env: a cached
   instance if its generation matches, else materialize once (pinned) and cache."
  [desc resolved_ns resolved_name]
  (let [env (env_id)
        ikey (per_env_instance_key resolved_ns resolved_name)
        row (ets/lookup :beam_lisp_vars (pfx env ikey))]
    (if (and (erlang/== 1 (erlang/length row))
             (let [v (erlang/element 2 (erlang/hd row))]
               (and (erlang/is_tuple v) (erlang/== 2 (erlang/tuple_size v))
                    (erlang/== (maps/get :generation desc) (erlang/element 1 v)))))
      (tuple :ok (erlang/element 2 (erlang/element 2 (erlang/hd row))))
      (materialize_per_env desc env resolved_ns resolved_name ikey))))

(defn- materialize_per_env
  "Run a per-env init thunk once, pinned in the loader process, bound to the
   TARGET env + defining ns, and cache under the exact-env instance key. A
   cyclic per-env init is caught deterministically."
  [desc env resolved_ns resolved_name ikey]
  (let [gen (maps/get :generation desc)
        init (maps/get :init desc)]
    (BeamLisp.Loader.Server/run
      (fn []
        (let [row (ets/lookup :beam_lisp_vars (pfx env ikey))]
          (if (and (erlang/== 1 (erlang/length row))
                   (let [v (erlang/element 2 (erlang/hd row))]
                     (and (erlang/is_tuple v) (erlang/== 2 (erlang/tuple_size v))
                          (erlang/== gen (erlang/element 1 v)))))
            (tuple :ok (erlang/element 2 (erlang/element 2 (erlang/hd row))))
            (do
              (guard_per_env_cycle! env resolved_ns resolved_name)
              (try
                (with_env env
                  (fn []
                    (with_ns resolved_ns
                      (fn []
                        ; The env may have been destroyed while queued — fail
                        ; closed rather than resurrect an instance row.
                        (if (and (not (erlang/== :global env)) (erlang/== nil (env_state env)))
                          :error
                          (let [value (init)]
                            (ets/insert :beam_lisp_vars
                              (tuple (pfx env ikey) (tuple gen value)))
                            (tuple :ok value)))))))
                (finally
                  (unguard_per_env_cycle env resolved_ns resolved_name))))))))))

(defn- guard_per_env_cycle! [env ns name]
  (let [key (tuple env ns name)
        stack (Process/get :bl_per_env_init_stack (list))]
    (if (Enum/member? stack key)
      (erlang/error
        (Elixir.RuntimeError/exception
          (erlang/iolist_to_binary
            (list "cyclic per-env initialization: "
                  (Enum/map_join (erlang/++ (list key) stack) " <- "
                    (fn [t]
                      (erlang/iolist_to_binary
                        (list (Kernel/inspect (erlang/element 1 t)) " "
                              (erlang/element 2 t) "/" (erlang/element 3 t)))))))))
      (Process/put :bl_per_env_init_stack (erlang/++ (list key) stack)))))

(defn- unguard_per_env_cycle [env ns name]
  (let [key (tuple env ns name)
        stack (Process/get :bl_per_env_init_stack (list))]
    (if (and (erlang/is_list stack)
             (not (erlang/== 0 (erlang/length stack)))
             (erlang/== key (erlang/hd stack)))
      (Process/put :bl_per_env_init_stack (erlang/tl stack))
      (Process/put :bl_per_env_init_stack (List/delete stack key)))))

(defn fetch
  "Resolve `name`, looking in `ns` first, then referred vars, then `core`
   (and `sugar`). Each candidate pair is tried across the whole env chain
   before moving to the next candidate."
  [ns name]
  (let [memo_key (tuple :env_fetch_memo (chain) ns name)
        cached (Process/get memo_key)]
    (cond
      (erlang/== nil cached) (fetch_fresh ns name memo_key)
      (and (erlang/is_tuple cached) (erlang/== 2 (erlang/tuple_size cached)))
      (if (erlang/== (erlang/element 1 cached) (current_epoch))
        (erlang/element 2 cached)
        (fetch_fresh ns name memo_key))
      :else (erlang/error (Elixir.CaseClauseError/exception (list (tuple :term cached)))))))

(defn- fetch_fresh [ns name memo_key]
  ; Resolve declared providers before falling through to core. An unloaded
  ; referred `map` must not silently resolve to core/map. The loader ignores
  ; undeclared candidates, and the epoch is sampled AFTER any initialization.
  (BeamLisp.Loader/load_candidates (candidates ns name))
  (let [epoch (current_epoch)
        result (fetch_uncached ns name)]
    (Process/put memo_key (tuple epoch result))
    result))

(defn- fetch_uncached [ns name]
  (let [cands (candidates ns name)]
    (Enum/find_value (chain) :error
      (fn [env]
        (Enum/find_value cands nil
          (fn [k]
            (let [cns (erlang/element 1 k)
                  cname (erlang/element 2 k)
                  row (ets/lookup :beam_lisp_vars (pfx env k))]
              (cond
                (erlang/== 0 (erlang/length row)) nil
                (per_env_def? (erlang/element 2 (erlang/hd row)))
                (resolve_per_env (erlang/element 2 (erlang/hd row)) cns cname)
                :else (tuple :ok (erlang/element 2 (erlang/hd row)))))))))))

(defn peek
  "Like `fetch/2` but NON-materializing: a `^:per-env` var resolves to its
   descriptor, never a value."
  [ns name]
  (let [cands (candidates ns name)]
    (Enum/find_value (chain) :error
      (fn [env]
        (Enum/find_value cands nil
          (fn [k]
            (let [row (ets/lookup :beam_lisp_vars (pfx env k))]
              (if (erlang/== 0 (erlang/length row))
                nil
                (tuple :ok (erlang/element 2 (erlang/hd row)))))))))))

(defn bound?
  "Whether `ns/name` binds at all (per-env descriptor counts), without
   materializing."
  [ns name]
  (let [r (peek ns name)]
    (and (erlang/is_tuple r) (erlang/== 2 (erlang/tuple_size r))
         (erlang/== :ok (erlang/element 1 r)))))

(defn- candidates
  "The candidate `{ns, name}` pairs a lookup should try, in order."
  [ns name]
  (let [parts (String/split name "/" (list (tuple :parts 2)))
        p0 (erlang/hd parts)]
    (cond
      (erlang/== "" p0)
      (erlang/++ (list (tuple ns name))
        (erlang/++ (refer_candidate ns name)
          (list (tuple "core" name) (tuple "sugar" name))))

      (erlang/== 2 (erlang/length parts))
      (let [at (alias_target ns p0)]
        (list (tuple (if (erlang/== nil at) p0 at) (erlang/hd (erlang/tl parts)))))

      :else
      (let [plain p0]
        (erlang/++ (list (tuple ns plain))
          (erlang/++ (refer_candidate ns plain)
            (list (tuple "core" plain) (tuple "sugar" plain))))))))
(defn add_alias
  "Record `alias` as shorthand for `target` inside `ns`."
  [ns alias_ target]
  (put_key (tuple :alias ns alias_) target)
  :ok)

(defn add_import
  "Record that `(:import [pkg Class])` in `ns` names the host class `qualified`
   by its short name. A class import is a DECLARATION, not a load."
  [ns short qualified]
  (put_key (tuple :import ns short) qualified)
  :ok)

(defn import_target
  "The fully-qualified class `short` was imported as inside `ns`, or nil."
  [ns short]
  (let [r (lookup (tuple :import ns short))]
    (if (and (erlang/is_tuple r) (erlang/== 2 (erlang/tuple_size r))
             (erlang/== :ok (erlang/element 1 r)))
      (erlang/element 2 r)
      nil)))

(defn add_core_excludes
  "The core names `ns` declared it shadows with `(:refer-clojure :exclude [...])`."
  [ns names]
  (if (erlang/is_list names)
    (do
      (put_key (tuple :refer_clojure_exclude ns) names)
      :ok)
    (fce! :add_core_excludes 2)))

(defn core_excludes [ns]
  (let [r (lookup (tuple :refer_clojure_exclude ns))]
    (if (and (erlang/is_tuple r) (erlang/== 2 (erlang/tuple_size r))
             (erlang/== :ok (erlang/element 1 r)))
      (erlang/element 2 r)
      (list))))

(defn alias_target
  "The namespace `alias` points to inside `ns`, if any."
  [ns alias_]
  (let [r (lookup (tuple :alias ns alias_))]
    (if (and (erlang/is_tuple r) (erlang/== 2 (erlang/tuple_size r))
             (erlang/== :ok (erlang/element 1 r)))
      (erlang/element 2 r)
      nil)))

(defn public_names
  "Every public var name interned in `ns` — the UNION over the env chain.
   Private vars are filtered here, so `:refer :all` can never smuggle in a name
   the explicit form would have refused."
  [ns]
  (let [names (Enum/uniq (List/flatten (match (tuple (tuple ns :"$1") :_))))]
    (Enum/reject names
      (fn [name]
        (let [m (meta ns name)]
          (and (erlang/is_tuple m) (erlang/== 2 (erlang/tuple_size m))
               (erlang/== :ok (erlang/element 1 m))
               (erlang/is_map (erlang/element 2 m))
               (erlang/== true (maps/get :private (erlang/element 2 m) nil))))))))

(defn add_refer
  "Refer `name` into `ns` so it resolves bare, as if defined there."
  [ns name source_ns]
  (put_key (tuple :refer ns name) source_ns)
  :ok)

(defn add_refer_all
  "Refer every public var of `source_ns` into `ns` — a snapshot taken when the
   `(ns …)` form runs."
  [ns source_ns]
  (Enum/each (public_names source_ns) (fn [name] (add_refer ns name source_ns)))
  :ok)

(defn local_var?
  "True when `name` is interned in `ns` itself, ancestors counting (read-through)."
  [ns name]
  (member? (tuple ns name)))

(defn refer_source
  "The namespace `name` was referred into `ns` from, or nil."
  [ns name]
  (let [r (lookup (tuple :refer ns name))]
    (if (and (erlang/is_tuple r) (erlang/== 2 (erlang/tuple_size r))
             (erlang/== :ok (erlang/element 1 r)))
      (erlang/element 2 r)
      nil)))

(defn- refer_candidate [ns name]
  (let [s (refer_source ns name)]
    (if (erlang/== nil s) (list) (list (tuple s name)))))

(defn declare_ns
  "Record that `ns` exists, independently of whether anything is interned in it
   yet."
  [ns]
  (if (erlang/is_binary ns)
    (do
      (put_key (tuple :ns ns) true)
      :ok)
    (fce! :declare_ns 1)))

(defn ns_exists?
  "True when `ns` has been declared by an `(ns …)` form, or has any var
   interned in it, anywhere in the env chain."
  [ns]
  (Enum/any? (chain)
    (fn [env]
      (let [row (ets/lookup :beam_lisp_vars (pfx env (tuple :ns ns)))]
        (cond
          (and (erlang/== 1 (erlang/length row))
               (erlang/== true (erlang/element 2 (erlang/hd row)))) true

          (erlang/== 0 (erlang/length row))
          (let [m (ets/match :beam_lisp_vars (tuple (pfx env (tuple ns :_)) :_) 1)]
            (and (erlang/is_tuple m) (erlang/== 2 (erlang/tuple_size m))
                 (erlang/is_list (erlang/element 1 m))
                 (erlang/== 1 (erlang/length (erlang/element 1 m))))))))))

; ── readiness: the cheap mirror the emitted guard reads ──────────────────
;
; `loaded_ns?/1` is the authority on whether a namespace's top-level init has
; run, but it answers through the Agent for `:global` — too expensive to ask on
; a call path. `mark_ready/1` therefore writes a one-row ETS MIRROR of the same
; decision (it is called from `mark_loaded/1`, never independently), and
; `ns_ready?/1` reads that mirror. A `false` from the mirror means only
; "cannot prove it is ready": the caller takes the loader path, which
; re-decides from the authority.

(defn mark_ready
  "Record `ns`'s top-level init as done in the CURRENT env — the cheap mirror
   `ns_ready?/1` reads. `mark_loaded/1` calls it, so there is ONE readiness
   decision in the system, made in one place, whether the namespace came from
   source or from an AOT `__bl_init__` replay."
  [ns]
  (if (erlang/is_binary ns)
    (do
      (ets/insert :beam_lisp_vars (tuple (key (tuple :ns_ready ns)) true))
      (bump_epoch)
      :ok)
    (fce! :mark_ready 1)))

(defn ns_ready?
  "The cheap POSITIVE readiness test the emitted cross-namespace guard asks:
   has `ns`'s top-level init already run in an env on this chain?

   This runs AHEAD OF EVERY DIRECT CROSS-NAMESPACE CALL, so its cost is a tax
   on the whole language: built through the variadic `(tuple …)` prelude
   constructor and `pfx`'s Tuple/insert_at, one guard measured ~600
   reductions — `datom.index/-tx`, a one-field read, cost 633 reductions per
   call against 6 for a core call, and a render made millions of them. The key
   is the 3-tuple `{env, :ns_ready, ns}` (what `pfx` builds from `{:ns_ready,
   ns}`), built here with the BIF directly, and the chain is walked with a
   direct self-recursion instead of an Enum closure."
  [ns]
  (if (erlang/is_binary ns)
    (ns_ready_in? (chain) ns)
    false))

(defn ns_ready_in?
  "INTERNAL: is `ns` marked ready in any env of `envs`?"
  [envs ns]
  (cond
    (erlang/== envs ()) false
    (ets/member :beam_lisp_vars
                (erlang/list_to_tuple (erlang/++ (erlang/++ (erlang/++ () (list (erlang/hd envs))) (list :ns_ready)) (list ns))))
    true
    :else (ns_ready_in? (erlang/tl envs) ns)))

(defn loaded_ns? [ns]
  (Enum/any? (chain)
    (fn [env]
      (if (erlang/== :global env)
        (Agent/get (own-module) (fn [s] (MapSet/member? (Map/get s :loaded) ns)))
        (let [st (env_state env)]
          (if (erlang/== nil st)
            false
            (let [l (Map/get st :loaded)]
              (if (erlang/== nil l) false (MapSet/member? l ns)))))))))

(defn mark_loaded [ns]
  (if (erlang/== :global (env_id))
    (do
      (Agent/update (own-module)
        (fn [s] (Map/put s :loaded (MapSet/put (Map/get s :loaded) ns))))
      (mark_ready ns))
    (do
      (update_env_state (env_id)
        (fn [st] (Map/put st :loaded (MapSet/put (Map/get st :loaded) ns))))
      (mark_ready ns))))

; ── ns_defs: a map in ETS, or a reference to the beam that already holds it ──
;
; An AOT-compiled namespace's shim beam carries its whole def table as a LITERAL
; (`__bl_ns_defs__/0`): the VM keeps one shared copy of a literal and returns it
; without copying. Storing a second copy in ETS cost the compiler's own
; namespaces ~70 MB on a long-lived server, and every ETS read re-copied a whole
; namespace's ASTs onto the caller's heap (33-39 ms for `compiler`/`rt`). So the
; init replay stores `{:"$beam", Mod}` here, and `ns_defs/1` asks the beam.
;
; A MAP in the row is an overlay: what `put_ns_defs/2` wrote (a live `defvar`, an
; `undefine_var`, a source-loaded namespace with no beam). It wins over a beam
; because it is newer. The key shape is unchanged, so `namespaces/0` (which
; matches on the key alone), `destroy/1` and the env chain need no change.

(defn- resolve_ns_defs
  "The def map a stored `ns_defs` value stands for. A reference to a module that
   is not loaded, or no longer exports the table, resolves to the empty map — the
   answer for a namespace that has not been initialised. `Link/defvar`
   materialises every reference BEFORE it replaces a shim, so that state is
   unreachable from a live reload."
  [v]
  (cond
    (erlang/is_map v) v
    (and (erlang/is_tuple v) (erlang/== 2 (erlang/tuple_size v))
         (erlang/== :"$beam" (erlang/element 1 v))
         (erlang/function_exported (erlang/element 2 v) :__bl_ns_defs__ 0))
    (erlang/apply (erlang/element 2 v) :__bl_ns_defs__ (list))
    :else (maps/new)))

(defn ns_defs
  "The def entries `{name => [{kind, arity, fname, def_ast}]}` backing ns's
   module."
  [ns]
  (let [r (lookup (tuple :ns_defs ns))]
    (if (and (erlang/is_tuple r) (erlang/== 2 (erlang/tuple_size r))
             (erlang/== :ok (erlang/element 1 r)))
      (resolve_ns_defs (erlang/element 2 r))
      (maps/new))))

(defn put_ns_defs [ns defs] (put_key (tuple :ns_defs ns) defs))

(defn link_ns_defs
  "Record that `ns`'s def table is the one `mod`'s `__bl_ns_defs__/0` returns,
   instead of copying it into ETS. What an AOT shim's `__bl_init__/0` calls."
  [ns mod]
  (put_key (tuple :ns_defs ns) (tuple :"$beam" mod)))

(defn unlink_ns_defs
  "Replace every env's reference for `ns` with the map it resolves to, so the
   table survives the shim being replaced (a regenerated shim has no
   `__bl_ns_defs__/0`). Called by `Link/defvar` before it loads a new shim."
  [ns]
  (Enum/each
    (ets/match_object :beam_lisp_vars
      (tuple (tuple :_ :ns_defs ns) (tuple :"$beam" :_)))
    (fn [row]
      (ets/insert :beam_lisp_vars
        (tuple (erlang/element 1 row) (resolve_ns_defs (erlang/element 2 row))))))
  (bump_epoch)
  :ok)

(defn undefine_var
  "Remove `name` from `ns` entirely: its value binding, its link-info, its
   per-env instance row and its entry in the ns_defs registry. The primitive
   behind namespace-level reload."
  [ns name]
  (if (and (erlang/is_binary ns) (erlang/is_binary name))
    (do
      (delete_key (tuple ns name))
      (delete_key (tuple :link ns name))
      (delete_key (per_env_instance_key ns name))
      (put_ns_defs ns (Map/delete (ns_defs ns) name))
      :ok)
    (fce! :undefine_var 2)))

(defn own_names
  "Names interned directly in `ns` in the CURRENT env only (no read-through,
   no refers, no core)."
  [ns]
  (if (erlang/is_binary ns)
    (Enum/uniq (List/flatten (ets/match :beam_lisp_vars (tuple (key (tuple ns :"$1")) :_))))
    (fce! :own_names 1)))

(defn callers_of
  "Every live var, across ALL namespaces, that statically calls `target_ns/name`
   as a qualified remote call — returned as `[{caller_ns, caller_name} …]`,
   excluding the target's own namespace."
  [target_ns name]
  (if (and (erlang/is_binary target_ns) (erlang/is_binary name))
    (let [target_mod (BeamLisp.Emit/module_for target_ns)
          fname (String/to_atom name)
          target (tuple target_ns name target_mod fname)
          hits (Enum/flat_map (namespaces)
                 (fn [caller_ns]
                   (if (erlang/== caller_ns target_ns)
                     (list)
                     (Enum/flat_map (ns_defs caller_ns)
                       (fn [pair]
                         (let [vname (erlang/element 1 pair)
                               entries (erlang/element 2 pair)]
                           (if (ast_calls_remote? entries target)
                             (list (tuple caller_ns vname))
                             (list))))))))]
      (Enum/uniq hits))
    (fce! :callers_of 2)))

(defn- ast_calls_remote? [entries target]
  (if (erlang/is_list entries)
    (Enum/any? entries (fn [entry] (node_calls_remote? (erlang/element 4 entry) target)))
    false))

(defn- elixir_dot_parts
  "The `{mod, f}` pair when `x` is the Elixir-AST remote node `{:., _, [mod, f]}`,
   else nil."
  [x]
  (if (and (erlang/is_tuple x) (erlang/== 3 (erlang/tuple_size x))
           (erlang/== (String/to_atom ".") (erlang/element 1 x))
           (erlang/is_list (erlang/element 3 x))
           (erlang/== 2 (erlang/length (erlang/element 3 x))))
    (let [l (erlang/element 3 x)]
      (tuple (erlang/hd l) (erlang/hd (erlang/tl l))))
    nil))
(defn- node_calls_remote?
  "A depth-first walk of a compiled def for a reference to the target var.
   Matches the bl-ANF shapes first (`:remote` static, `:global`), then the
   legacy Elixir-AST shapes."
  [node target]
  (let [tns (erlang/element 1 target)
        name (erlang/element 2 target)
        tmod (erlang/element 3 target)
        fname (erlang/element 4 target)]
    (cond
      ; ANF static  — `%{op: :remote, mod: TargetModule, fun: :fname}`
      (and (erlang/is_map node)
           (maps/is_key :op node) (maps/is_key :mod node) (maps/is_key :fun node)
           (erlang/== :remote (maps/get :op node)))
      (or (and (erlang/== tmod (maps/get :mod node))
               (erlang/== fname (maps/get :fun node)))
          (node_calls_remote? (maps/values (maps/remove :op node)) target))

      ; ANF global  — `%{op: :global, ns: "target.ns", name: "name"}`
      (and (erlang/is_map node)
           (maps/is_key :op node) (maps/is_key :ns node) (maps/is_key :name node)
           (erlang/== :global (maps/get :op node)))
      (and (erlang/== tns (maps/get :ns node)) (erlang/== name (maps/get :name node)))

      ; any other map: walk its values
      (erlang/is_map node)
      (node_calls_remote? (maps/values (maps/remove :ann node)) target)

      ; AST static/dynamic — a 3-tuple whose head is `{:., _, [mod, f]}`
      (and (erlang/is_tuple node) (erlang/== 3 (erlang/tuple_size node))
           (not (erlang/== nil (elixir_dot_parts (erlang/element 1 node)))))
      (let [parts (elixir_dot_parts (erlang/element 1 node))
            mod (erlang/element 1 parts)
            f (erlang/element 2 parts)
            args (erlang/element 3 node)]
        (cond
          ; AST static  — `{:., _, [TargetModule, :fname]}`
          (and (erlang/== tmod mod) (erlang/== fname f)) true

          ; AST dynamic — `BeamLisp.Env.fetch!("target.ns", "name")`
          (and (erlang/is_tuple mod) (erlang/== 3 (erlang/tuple_size mod))
               (erlang/== :__aliases__ (erlang/element 1 mod))
               (erlang/is_list (erlang/element 3 mod))
               (erlang/== 2 (erlang/length (erlang/element 3 mod)))
               (erlang/== :BeamLisp (erlang/hd (erlang/element 3 mod)))
               (erlang/== :Env (erlang/hd (erlang/tl (erlang/element 3 mod))))
               (or (erlang/== :fetch! f) (erlang/== :fetch f))
               (erlang/is_list args)
               (erlang/>= (erlang/length args) 2)
               (erlang/== tns (erlang/hd args))
               (erlang/== name (erlang/hd (erlang/tl args))))
          true

          :else false))

      ; AST `{_a, _meta, args}` — walk the args
      (and (erlang/is_tuple node) (erlang/== 3 (erlang/tuple_size node)))
      (node_calls_remote? (erlang/element 3 node) target)

      (erlang/is_list node)
      (let [n (erlang/length node)]
        (if (erlang/== 0 n)
          false
          (or (node_calls_remote? (erlang/hd node) target)
              (node_calls_remote? (erlang/tl node) target))))

      (and (erlang/is_tuple node) (erlang/== 2 (erlang/tuple_size node)))
      (or (node_calls_remote? (erlang/element 1 node) target)
          (node_calls_remote? (erlang/element 2 node) target))

      (erlang/is_tuple node)
      (node_calls_remote? (erlang/tuple_to_list node) target)

      :else false)))

(defn namespaces
  "Every namespace that exists: defined something OR declared by `(ns …)`."
  []
  (let [from_defs (Enum/flat_map (chain)
                    (fn [env]
                      (ets/select :beam_lisp_vars
                        (list (tuple (tuple (pfx env (tuple :ns_defs :"$1")) :_)
                                     (list)
                                     (list :"$1"))))))
        from_decl (Enum/flat_map (chain)
                    (fn [env]
                      (ets/select :beam_lisp_vars
                        (list (tuple (tuple (pfx env (tuple :ns :"$1")) :_)
                                     (list)
                                     (list :"$1"))))))]
    (Enum/uniq (erlang/++ from_defs from_decl))))

(defn put_link
  "Register link metadata `{module, %{arity => fname}, {min, vfname} | nil}` for
   a fn var."
  [ns name info]
  (put_key (tuple :link ns name) info))

(defn link
  "Resolve link metadata with the same alias/refer/core rules as fetch/2."
  [ns name]
  (let [cands (candidates ns name)]
    (Enum/find_value (chain) :error
      (fn [env]
        (Enum/find_value cands nil
          (fn [pair]
            (let [cns (erlang/element 1 pair)
                  cname (erlang/element 2 pair)
                  row (ets/lookup :beam_lisp_vars (pfx env (tuple :link cns cname)))]
              (if (erlang/== 0 (erlang/length row))
                nil
                (tuple :ok (erlang/element 2 (erlang/hd row)))))))))))

(defn link_owner
  "`link/2`'s answer together with the namespace that SUPPLIED it:
   `{:ok, provider-ns, info}` or `:error`. The compiler needs the provider, not
   just the module, to decide whether a direct call must be guarded by that
   namespace's readiness."
  [ns name]
  (let [cands (candidates ns name)]
    (Enum/find_value (chain) :error
      (fn [env]
        (Enum/find_value cands nil
          (fn [pair]
            (let [cns (erlang/element 1 pair)
                  cname (erlang/element 2 pair)
                  row (ets/lookup :beam_lisp_vars (pfx env (tuple :link cns cname)))]
              (if (erlang/== 0 (erlang/length row))
                (if (or (ets/member :beam_lisp_vars (pfx env pair))
                        (and (erlang/not (erlang/== cns ns))
                             (erlang/not (erlang/== nil (deferred_dirs cns)))
                             (erlang/not (ns_ready? cns))))
                  :error ; Do not bake a core fallback behind an explicit refer.
                  nil)
                (tuple :ok cns (erlang/element 2 (erlang/hd row)))))))))))

(defn put_meta
  "Record `meta` (a map) for `name` in `ns`. Writes MERGE onto the
   chain-visible copy; the latest value wins per key. Returns `:ok`."
  [ns name meta]
  (if (erlang/is_map meta)
    (let [merged (let [r (lookup (tuple :meta ns name))]
                   (if (and (erlang/is_tuple r) (erlang/== 2 (erlang/tuple_size r))
                            (erlang/== :ok (erlang/element 1 r))
                            (erlang/is_map (erlang/element 2 r)))
                     (Map/merge (erlang/element 2 r) meta)
                     meta))]
      (put_key (tuple :meta ns name) merged)
      :ok)
    (fce! :put_meta 3)))

(defn meta
  "Read the metadata map recorded by `put_meta/3` for `name` in `ns` (no
   resolution)."
  [ns name]
  (lookup (tuple :meta ns name)))

; ── deferred requires ──────────────────────────────────────────────
;
; A `:require` with an alias or an explicit refer list DECLARES its target
; instead of initializing it (`BeamLisp.Loader/declare_require/3`): the target's
; existence (a `:ns` row) and the search dirs the declaration was made under are
; recorded here, so a later lookup can initialize it under its ORIGINAL search
; context rather than the caller's. `fetch/2`'s miss hook and `Loader`'s
; readiness guard read these rows; `destroy/1` removes them with the env, so a
; dropped env can never leave a stale declaration behind.

(defn deferred_dirs
  "The search dirs `target` was declared under, or nil when it was never
   declared deferred — an eager (bare) require, an explicit load, or no require
   at all."
  [target]
  (let [r (lookup (tuple :deferred target))]
    (if (and (erlang/is_tuple r) (erlang/== 2 (erlang/tuple_size r))
             (erlang/== :ok (erlang/element 1 r)))
      (erlang/element 2 r)
      nil)))

(defn note_deferred
  "Record that `target` may be initialized on demand, under `dirs` — the search
   dirs its `:require` was declared with. First declaration wins: a second
   reference cannot silently re-root a namespace another namespace already
   pinned, which also makes the write idempotent."
  [target dirs]
  (if (and (erlang/is_binary target) (erlang/is_list dirs))
    (if (erlang/== nil (deferred_dirs target))
      (do (put_key (tuple :deferred target) dirs) :ok)
      :ok)
    (fce! :note_deferred 2)))

(defn doc_string
  "Resolve `name` through the same alias/refer/core rules as `fetch/2` and
   return its docstring metadata as `%{ns:, name:, doc:}`, else nil."
  [ns name]
  (let [uname (unwrap_doc_name name)
        cands (candidates ns uname)
        found (Enum/find_value (chain)
                (fn [env]
                  (Enum/find_value cands
                    (fn [pair]
                      (let [cns (erlang/element 1 pair)
                            cname (erlang/element 2 pair)
                            row (ets/lookup :beam_lisp_vars (pfx env (tuple :meta cns cname)))]
                        (if (and (erlang/== 1 (erlang/length row))
                                 (erlang/is_map (erlang/element 2 (erlang/hd row)))
                                 (not (erlang/== nil (maps/get :doc (erlang/element 2 (erlang/hd row)) nil))))
                          (tuple cns cname (maps/get :doc (erlang/element 2 (erlang/hd row))))
                          nil))))))]
    (if (erlang/== nil found)
      nil
      (maps/put :ns (erlang/element 1 found)
        (maps/put :name (erlang/element 2 found)
          (maps/put :doc (erlang/element 3 found) (maps/new)))))))

(defn- unwrap_doc_name [name]
  (cond
    (and (erlang/is_tuple name) (erlang/== 2 (erlang/tuple_size name))
         (erlang/== :symbol (erlang/element 1 name)))
    (erlang/element 2 name)

    (erlang/is_binary name) name

    :else (fce! :unwrap_doc_name 1)))

; ── Load paths and search paths ────────────────────────────────────────────

(defn load_paths
  "Directories the loader searches for `<ns>.bl` files, innermost first. At
   `:global` it lives in the Agent; in a fork it is process-local."
  []
  (if (erlang/== :global (env_id))
    (Agent/get (own-module) (fn [s] (Map/get s :load_paths)))
    (Process/get :bl_load_paths (list))))

(defn push_load_path [dir]
  (if (erlang/== :global (env_id))
    (Agent/update (own-module)
      (fn [s] (Map/put s :load_paths (erlang/++ (list dir) (Map/get s :load_paths)))))
    (Process/put :bl_load_paths (erlang/++ (list dir) (load_paths))))
  :ok)

(defn pop_load_path []
  (if (erlang/== :global (env_id))
    (Agent/update (own-module)
      (fn [s] (Map/put s :load_paths (erlang/tl (Map/get s :load_paths)))))
    (Process/put :bl_load_paths (erlang/tl (load_paths))))
  :ok)

(defn search_paths
  "Configured search paths — library roots the loader consults after cwd.
   Reads walk the chain (own env's roots first, then ancestors')."
  []
  (Enum/uniq
    (Enum/flat_map (chain)
      (fn [env]
        (if (erlang/== :global env)
          (Agent/get (own-module) (fn [s] (Map/get s :search_paths (list))))
          (let [st (env_state env)]
            (if (erlang/== nil st) (list) (Map/get st :search_paths))))))))

(defn add_search_path
  "Append a search path (idempotent, order-preserving)."
  [dir]
  (let [d (Path/expand dir)]
    (if (erlang/== :global (env_id))
      (Agent/update (own-module)
        (fn [s]
          (let [paths (Map/get s :search_paths (list))]
            (if (Enum/member? paths d) s (Map/put s :search_paths (erlang/++ paths (list d)))))))
      (update_env_state (env_id)
        (fn [st]
          (let [paths (Map/get st :search_paths)]
            (if (Enum/member? paths d) st (Map/put st :search_paths (erlang/++ paths (list d))))))))))

(defn remove_search_path
  "Remove one configured search path from the current env (no-op if absent)."
  [dir]
  (let [d (Path/expand dir)]
    (if (erlang/== :global (env_id))
      (Agent/update (own-module)
        (fn [s] (Map/put s :search_paths (List/delete (Map/get s :search_paths (list)) d))))
      (update_env_state (env_id)
        (fn [st] (Map/put st :search_paths (List/delete (Map/get st :search_paths) d)))))))

(defn clear_search_paths
  "Drop the current env's configured search paths (test isolation)."
  []
  (if (erlang/== :global (env_id))
    (Agent/update (own-module) (fn [s] (Map/put s :search_paths (list))))
    (update_env_state (env_id) (fn [st] (Map/put st :search_paths (list))))))

(defn fetch!
  "Like `fetch/2`, but raises a `%RuntimeError{}` naming the var on a miss."
  [ns name]
  (let [r (fetch ns name)]
    (if (and (erlang/is_tuple r) (erlang/== 2 (erlang/tuple_size r))
             (erlang/== :ok (erlang/element 1 r)))
      (erlang/element 2 r)
      (erlang/error
        (Elixir.RuntimeError/exception
          (erlang/iolist_to_binary (list "undefined var: " ns "/" name)))))))

(defn seeded?
  []
  (Enum/any? (chain)
    (fn [env]
      (if (erlang/== :global env)
        (Agent/get (own-module) (fn [s] (Map/get s :seeded)))
        false))))

(defn mark_seeded []
  (if (erlang/== :global (env_id))
    (Agent/update (own-module) (fn [s] (Map/put s :seeded true)))
    :ok))
