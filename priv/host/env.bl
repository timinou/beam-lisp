; host/env.bl — the pinned HOST MODULE for `Elixir.BeamLisp.Env`.
;
; `lib/beam_lisp/env.ex` is the VAR REGISTRY: process-scoped environments with a
; read-through chain, an ETS table every compiled var deref reads lock-free, and
; an Agent owning the small namespace/bootstrap state and the table itself. This
; file is the `.bl` port of that module, compiled by
; `BeamLisp.AOT/compile_host_file` into ONE exact-named beam
; (`Elixir.BeamLisp.Env.beam`) whose top-level `defn`s are plain exported
; functions — the exact call surface every caller already names at
; `Elixir.BeamLisp.Env`, so no caller is renamed.
;
; WHY A PINNED MODULE AND NOT A NAMESPACE. `Env` is the first child of the
; runtime's supervisor and the table every later boot step interns into. The
; pinned beam must RUN before the language exists, so it can never itself be an
; AOT-rebuilt `BeamLisp.Ns.*` namespace. It is a pinned host beam instead.
;
; ── THE PREBOOT CONSTRAINT ──────────────────────────────────────────────────
;
; `start_link/1` (and the Agent init closure it runs, and `child_spec/1`) are
; called BEFORE `BeamLisp.Ns.Rt/seed_core` — by `BeamLisp/init`, by
; `BeamLisp.AOT/boot`, and by OTP starting the supervisor. So those functions
; are written in the surface that needs NO namespace var and NO `BeamLisp.Ns.Rt`:
;
;   * `(list …)` / `(tuple …)` compile to `BeamLisp.Ns.Core.list__bl_v` /
;     `tuple__bl_v` — the PRELUDE's raw constructors, already a committed AOT
;     beam on the code path (this is exactly what `priv/host/application.bl`
;     relies on pre-boot). They are used freely.
;
;   * `(maps/new)`, `(maps/put k v m)`, `(MapSet/new)`, `(Agent/…)`,
;     `(Process/…)`, `(:ets/…)`, `(:persistent_term/…)`, `(:atomics/…)` are
;     calls to `:erlang`/`:maps`/Elixir/OTP modules — always available.
;
;   * a MAP LITERAL `{…}` compiles through `BeamLisp.Ns.Rt.hash_key`, and a
;     VECTOR literal `[…]` builds a `BeamLisp.Vector`; a bare `str` is
;     `BeamLisp.Ns.Rt`s — so NONE of those three is used here. Maps are built
;     with `(maps/new)`/`(maps/put)` and strings with `erlang/iolist_to_binary`
;     over `Kernel/inspect`, the discipline `priv/host/refs.bl` documents.
;
; Functions called only AFTER boot (the whole hash table of registry helpers,
; `fork`/`destroy`, the loader path stack, …) may call `BeamLisp.Ns.Rt/invoke`
; to run a beam-lisp thunk — the call sits in the body, not on the init path.
;
; ── ABI PARITY IS THE CONTRACT ──────────────────────────────────────────────
;
; Every function reproduces its Elixir counterpart: the same chain walk, the same
; evaluation order, the same return shapes (`{:ok, value}` / `:error`, `:ok`,
; the value), the same exception CLASS, and the same ARITY DEFAULTS — `fork/0`
; and `fork/1` delegate to `fork/2`, `caps_allowed?/1` to `caps_allowed?/2`, the
; `isolated/1` to `isolated/2`, and `fresh_env_state/1,2` to `fresh_env_state/3`.
;
; ── GUARDS THAT BECOME BODY CHECKS ──────────────────────────────────────────
;
; Beam-lisp's guard vocabulary (`priv/boot/compiler.bl`'s `guard-bifs`) has no
; atom predicate, no `is_function/2`, and `map?` EXCLUDES structs. So every
; `is_atom` / `is_function(f, 0)` / `is_map` / `is_list` clause head in the
; Elixir module becomes a BODY check that, on failure, raises the SAME
; `%FunctionClauseError{}` the guard would have carried — module, function and
; arity named — through `erlang/error` (the `priv/host/sandbox.bl` technique).
; `is_binary` has a guard (`string?`), but the checks are written uniformly in
; the body for one idiom.
;
; ── THE `^:per-env` DESCRIPTOR IS A TAGGED MAP ──────────────────────────────
;
; The Elixir module's nested `BeamLisp.Env.PerEnvDef` struct is only ever read
; by `Env` itself (`fetch/2`, `explain/2`, `resolve_per_env/3`); the compiler
; probes a per-env var with `peek/2` and treats any non-atom, non-macro value as
; "a descriptor, do not materialize" WITHOUT naming its type. So the descriptor
; is built here as the SAME tagged map `defstruct [:generation, :init]` would
; produce — `%{__struct__: :"Elixir.BeamLisp.Env.PerEnvDef", generation: ref,
; init: thunk}` — and recognised by that tag. A pinned one-module beam cannot
; declare a sibling struct module, and none is needed: a struct is a tagged map.
;
; Run: bin/bl test test/bl/env_host_test.bl

(ns host.env)

; ── small internals ────────────────────────────────────────────────────────
;
; A pinned module has NO private surface: the emitter exports every top-level
; `defn`, so these ride along as exports the way `priv/host/refs.bl`'s helpers
; do. Nothing outside calls them.

(defn- own-module
  "This module's own atom, read from a fun literal compiled into THIS file — the
   same source serves the production atom in the seed and a probe atom under
   test without naming either."
  []
  (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))

(defn- fce!
  "Raise the `%FunctionClauseError{}` a guard clause head would have raised:
   module, function and arity named, exactly as the BEAM builds it."
  [fname arity]
  (erlang/error
    (Elixir.FunctionClauseError/exception
      (list (tuple :module (own-module))
            (tuple :function fname)
            (tuple :arity arity)))))

(defn- per_env_def?
  "Whether a value is a `^:per-env` descriptor: a map carrying the
   `BeamLisp.Env.PerEnvDef` struct tag."
  [x]
  (and (erlang/is_map x)
       (erlang/== :"Elixir.BeamLisp.Env.PerEnvDef" (maps/get :__struct__ x nil))))

(defn- make_per_env_def [generation init]
  (maps/put :__struct__ :"Elixir.BeamLisp.Env.PerEnvDef"
    (maps/put :generation generation
      (maps/put :init init (maps/new)))))

(defn- per_env_instance_key [resolved_ns resolved_name]
  (tuple :per_env_instance resolved_ns resolved_name))

(defn- restore_pdict [key value]
  (if (erlang/== nil value) (Process/delete key) (Process/put key value)))

; ── the Agent + ETS table ──────────────────────────────────────────────────

(defn start_link
  "The OTP `start_link/1`: start the registry Agent under this module's own
   atom and create the public `:beam_lisp_vars` table it owns. The argument is
   ignored (the live module ignores it too); the child spec hands it `[]`."
  [_opts]
  (Agent/start_link
    (fn []
      (ets/new :beam_lisp_vars
        (list :named_table :public (erlang/list_to_tuple (list :read_concurrency true))))
      (ets/new :beam_lisp_code_leases
        (list :named_table :public :ordered_set (tuple :read_concurrency true)))
      (ets/new :beam_lisp_owner_index
        (list :named_table :public :ordered_set (tuple :read_concurrency true)))
      (ets/new :beam_lisp_owner_revisions
        (list :named_table :public :set (tuple :read_concurrency true)))
      ;; Startup capabilities/captured context stay private to Env. Public
      ;; owner receipts contain only immutable non-authorizing attribution.
      (ets/new :beam_lisp_source_extents (list :named_table :private :set))
      (ets/new :beam_lisp_source_lease_domains (list :named_table :private :set))
      (ets/new :beam_lisp_source_extent_heads (list :named_table :protected :set))
      (ets/new :beam_lisp_native_commands (list :named_table :private :set))
      (ets/new :beam_lisp_native_command_frames (list :named_table :private :set))
      (ets/new :beam_lisp_native_command_effects (list :named_table :private :set))
      ;; Fresh actual Env callback only: publish the denial summary once.
      ;; No-policy/compiler Ref operations then use protected ETS, no Agent RPC.
      (Enum/each (list :beam_lisp_native_commands :beam_lisp_native_command_frames
                      :beam_lisp_native_command_effects)
       (fn [table]
        (when-not (and (erlang/== (erlang/self) (ets/info table :owner))
                       (erlang/== :private (ets/info table :protection))
                       (erlang/== :set (ets/info table :type)) (erlang/== 0 (ets/info table :size)))
         (erlang/error :native_command_fresh_summary_custody))))
      (when-not (and (erlang/== (erlang/self) (ets/info :beam_lisp_source_extent_heads :owner))
                     (erlang/== :protected (ets/info :beam_lisp_source_extent_heads :protection))
                     (erlang/== :set (ets/info :beam_lisp_source_extent_heads :type)))
       (erlang/error :native_command_fresh_summary_custody))
      (ets/insert :beam_lisp_source_extent_heads (tuple :native_command_critical_cells_active false))
      (ets/new :beam_lisp_server_starts (list :named_table :private :set))
      (ets/new :beam_lisp_owner_transitions (list :named_table :private :set))
      (ets/new :beam_lisp_owner_transition_heads (list :named_table :private :set))
      (ets/new :beam_lisp_server_initializers (list :named_table :private :set))
      (maps/put :ns "user"
        (maps/put :seeded false
          (maps/put :loaded (MapSet/new)
            (maps/put :load_paths (list)
              (maps/put :search_paths (list)
                (maps/put :envs (maps/new) (maps/new))))))))
    (list (erlang/list_to_tuple (list :name (own-module))))))

(defn child_spec
  "The `child_spec/1` `use Agent` generates, clause for clause: a map whose
   `id` is this module and whose `start` is `{this module, :start_link,
   [init_arg]}`, normalized by `Supervisor.child_spec/2` with the macro's empty
   option list. `BeamLisp.Application.start/2` passes the MODULE ATOM in the
   child list, so OTP asks THIS module for its own spec."
  [init_arg]
  (Supervisor/child_spec
    (maps/put :id (own-module)
      (maps/put :start (erlang/list_to_tuple (list (own-module) :start_link (list init_arg)))
        (maps/new)))
    (list)))

; ── Environments ───────────────────────────────────────────────────────────

(defn env_id
  "The current process's env id (`:global` when unbound)."
  []
  (Process/get :bl_env :global))

(defn chain
  "The read-through chain for the current process, innermost first."
  []
  (Process/get :bl_env_chain (list :global)))

(defn fork
  "Create a new env whose reads fall through to `parent` (default: the current
   env). Returns the env id; does NOT bind it — see `with_env/2`.

   `:caps` attenuates the child's host-interop set (parent ∩ spec, monotonic
   weakening); `:max_heap_words` narrows the heap the same way (a child never
   gets MORE than its parent). `:global` holds `:all` and `nil` (= unbounded)."
  ([] (fork (env_id) (list)))
  ([parent] (fork parent (list)))
  ([parent opts]
   (let [id (tuple :env (erlang/make_ref))
         caps (intersect_caps (caps_of parent) (Keyword/get opts :caps :all))
         heap (min_heap (heap_of parent) (Keyword/get opts :max_heap_words))]
     (with_scope_lock id (fn []
       (Agent/update (own-module)
         (fn [s]
           (let [envs (Map/get s :envs (maps/new))]
             (Map/put s :envs (Map/put envs id (fresh_env_state parent caps heap))))))
       ;; Creation and destruction share the same fence, including the interval
       ;; where registry enumeration could expose this newly allocated scope.
       (ets/insert :beam_lisp_vars (tuple (tuple id :definition_lifetime) true :lifetime))
       id)))))

(defn- fresh_env_state
  ([parent] (fresh_env_state parent :all nil))
  ([parent caps] (fresh_env_state parent caps nil))
  ([parent caps heap]
   (maps/put :parent parent
     (maps/put :loaded (MapSet/new)
       (maps/put :search_paths (list)
         (maps/put :caps caps
           (maps/put :max_heap heap (maps/new))))))))

(defn- min_heap [parent spec]
  (cond
    (erlang/== nil parent) spec
    (erlang/== nil spec) parent
    :else (erlang/min parent spec)))

(defn heap_of
  "The env's max-heap bound in words (nil = unbounded)."
  [env]
  (if (erlang/== :global env)
    nil
    (Agent/get (own-module)
      (fn [s]
        (let [st (Map/get (Map/get s :envs (maps/new)) env)]
          (if (erlang/== nil st) nil (Map/get st :max_heap)))))))

(defn max_heap
  "This process's max-heap bound in words (nil = unbounded)."
  []
  (Process/get :bl_max_heap))

(defn- intersect_caps [a b]
  (cond
    (and (erlang/== :all a) (erlang/== :all b)) :all
    (erlang/== :all a) (MapSet/new b)
    (erlang/== :all b) a
    :else (MapSet/intersection a (MapSet/new b))))

; ── Capabilities ───────────────────────────────────────────────────────────

(defn caps_of
  "The effective capability set of `env`: `:all` or a `MapSet` of allowed
   modules. `:global` holds `:all`; a forked env's caps were intersected at
   fork time, so this lookup never walks the chain."
  [env]
  (if (erlang/== :global env)
    :all
    (Agent/get (own-module)
      (fn [s]
        (let [st (Map/get (Map/get s :envs (maps/new)) env)]
          ; Absent from the registry = never forked or already destroyed.
          ; Caps are a security boundary: fail CLOSED (no host interop),
          ; unlike reads, which degrade past dead envs.
          (if (erlang/== nil st) (MapSet/new) (Map/get st :caps)))))))

(defn caps
  "The current process's capability set (`:all` when unbound)."
  []
  (Process/get :bl_caps :all))

(defn caps_allowed?
  "Whether the current process's env grants interop to `module`, optionally
   narrowed to `op`: a bare-module grant covers every op, a `{module, op}` grant
   only the matching one. The hot path of the capability gate: one pdict read
   plus set membership."
  ([module] (caps_allowed? module nil))
  ([module op]
   (let [c (caps)]
     (if (erlang/== :all c)
       true
       (or (MapSet/member? c module)
           (and (not (erlang/== nil op)) (MapSet/member? c (tuple module op))))))))

(defn reachable?
  "Whether this env can touch `module` for AT LEAST ONE op — the reflective
   question, distinct from `caps_allowed?/2`'s per-fn one."
  [module]
  (let [c (caps)]
    (if (erlang/== :all c)
      true
      (or (MapSet/member? c module)
          (Enum/any? c
            (fn [x]
              (and (erlang/is_tuple x) (erlang/== 2 (erlang/tuple_size x))
                   (erlang/== module (erlang/element 1 x)))))))))

(defn op_of
  "The op a module's fn performs, per the op table — or nil when the table
   doesn't say."
  [module fun]
  (ensure_op_table)
  (let [r (ets/lookup :beam_lisp_ops (tuple module fun))]
    (if (erlang/== 0 (erlang/length r))
      nil
      (erlang/element 2 (erlang/hd r)))))

(defn register_op
  "Add `{module, fn} → op` to the op table (app-specific modules)."
  [module fun op]
  (if (erlang/is_atom op)
    (do
      (ensure_op_table)
      (ets/insert :beam_lisp_ops (tuple (tuple module fun) op))
      :ok)
    (fce! :register_op 3)))

(defn- default_ops
  "The default table: the dangerous-shape modules, read/write/env/exec split.
   Data, not code — the module atoms are spelled as `:Elixir.X`/`:os`/`:erlang`
   keywords so a bare `File` is never resolved as a namespace variable."
  []
  (list (tuple :Elixir.File :read :read) (tuple :Elixir.File :read! :read)
        (tuple :Elixir.File :exists? :read) (tuple :Elixir.File :ls :read)
        (tuple :Elixir.File :ls! :read) (tuple :Elixir.File :stat :read)
        (tuple :Elixir.File :cwd :read) (tuple :Elixir.File :cwd! :read)
        (tuple :Elixir.File :write :write) (tuple :Elixir.File :write! :write)
        (tuple :Elixir.File :rm :write) (tuple :Elixir.File :rm! :write)
        (tuple :Elixir.File :rm_rf :write) (tuple :Elixir.File :mkdir :write)
        (tuple :Elixir.File :mkdir_p :write) (tuple :Elixir.File :cp :write)
        (tuple :Elixir.File :rename :write)
        (tuple :Elixir.System :get_env :env_read) (tuple :Elixir.System :fetch_env :env_read)
        (tuple :Elixir.System :fetch_env! :env_read)
        (tuple :Elixir.System :put_env :env_write) (tuple :Elixir.System :delete_env :env_write)
        (tuple :Elixir.System :cmd :exec) (tuple :Elixir.System :shell :exec)
        (tuple :os :cmd :exec) (tuple :os :getenv :env_read) (tuple :os :putenv :env_write)
        (tuple :Elixir.Code :eval_string :eval) (tuple :Elixir.Code :eval_quoted :eval)
        (tuple :Elixir.Code :compile_string :eval) (tuple :erlang :apply :eval)))

(defn- ensure_op_table []
  (if (erlang/== :undefined (ets/whereis :beam_lisp_ops))
    (do
      (BeamLisp.Loader.Server/run
        (fn []
          (try
            (ets/new :beam_lisp_ops (list :named_table :public :set (tuple :read_concurrency true)))
            (catch e
              (if (and (erlang/is_map e)
                       (erlang/== :"Elixir.ArgumentError" (maps/get :__struct__ e nil)))
                :ok
                (erlang/error e))))))
      (Enum/each (default_ops)
        (fn [t]
          (ets/insert :beam_lisp_ops
            (tuple (tuple (erlang/element 1 t) (erlang/element 2 t)) (erlang/element 3 t)))))
      :ok)
    :ok))

(defn with_env
  "Run `fun` with `env` bound in the calling process; restores the previous
   binding (and process-local current-ns) afterwards."
  [env fun]
  (let [thunk (as_thunk fun)
        prev_env (Process/get :bl_env)
        prev_chain (Process/get :bl_env_chain)
        prev_ns (Process/get :bl_ns)
        prev_caps (Process/get :bl_caps)
        prev_heap (Process/get :bl_max_heap)]
    (Process/put :bl_env env)
    (Process/put :bl_env_chain (compute_chain env))
    (Process/put :bl_caps (caps_of env))
    (restore_pdict :bl_max_heap (heap_of env))
    ; A fresh env means a fresh `*ns*`: Clojure thread-local semantics.
    (Process/delete :bl_ns)
    (try
      (erlang/apply thunk (list))
      (finally
        (restore_pdict :bl_env prev_env)
        (restore_pdict :bl_env_chain prev_chain)
        (restore_pdict :bl_ns prev_ns)
        (restore_pdict :bl_caps prev_caps)
        (restore_pdict :bl_max_heap prev_heap)))))

(defn isolated
  "Fork an env (parent: the current env), bind it for `fun`, and destroy it
   afterwards. The one-call shape of \"run this in a clean room\"."
  ([fun] (isolated (env_id) fun))
  ([parent fun]
   (let [env (fork parent)]
     (try
       (with_env env fun)
       (finally
         (destroy env))))))

(defn- as_thunk
  "bl fns are tagged structs, not Elixir fns — normalize any invocable thunk to
   a zero-arity invocable so `with_env` works from bl source without the caller
   hand-wrapping through `rt/invoke`."
  [fun]
  (if (erlang/is_function fun 0)
    fun
    (fn [] (BeamLisp.Ns.Rt/invoke fun (list)))))

(defn- invoke_action [action]
 ;; Preserve the original invocable ABI. Only genuine native arity-0 actions
 ;; bypass the Source carrier dispatcher; other callables keep Rt semantics.
 (if (erlang/is_function action 0) (erlang/apply action (list))
  (BeamLisp.Ns.Rt/invoke action (list))))

(defn convey
  "Wrap an invocable as a fn of the SAME arity that first binds the CALLER's
   env, then invokes. Conveyance keeps Clojure-dynamic semantics across the
   process boundary; caps re-derive in `bind/1`, so a capped caller's rights
   ride along. The worker's registered scopes are restored in finally, so a
   reusable Agent never retains its last caller's diagnostic sink or project.

   A 0-arity BEAM fun conveys as 0-arity: `(delegate (fn [] ...))` used to come
   back as an arity-1 fn, which silently failed a later `(is_function f 0)`
   check. Every other invocable keeps the historical arity-1 shape."
  [fun]
  (let [token (capture)
        enter (fn [previous]
                (bind token)
                ;; Query authority is monotone on callback entry. Capturing an
                ;; unrestricted callback must not revoke the querying caller's
                ;; restriction; restoration below reinstalls its exact old scope.
                (let [caller (Map/get previous :query-functions)
                      captured (Map/get token :query-functions)]
                  (when (erlang/is_map caller)
                    (Process/put :datom.query.functions/closed
                      (if (erlang/is_map captured)
                        (Enum/reduce (Map/to_list captured) (maps/new)
                          (fn [entry narrowed]
                            (let [key (erlang/element 1 entry) value (erlang/element 2 entry)]
                              (if (erlang/== (tuple :ok value) (maps/find key caller))
                                (maps/put key value narrowed) narrowed))))
                        caller)))))
        leave (fn [previous]
                (bind previous)
                (restore_pdict :bl_loader_initialization_blocked
                  (Map/get previous :loader-initialization-blocked)))]
    (if (erlang/is_function fun 0)
      (fn []
        (let [previous (capture)]
          (try
            (enter previous)
            (erlang/apply fun (list))
            (finally (leave previous)))))
      (let [inner (fn [arg]
                    ;; Native worker callbacks must also convey before Rt boots.
                    (if (erlang/is_function fun 1)
                      (erlang/apply fun (list arg))
                      (BeamLisp.Ns.Rt/invoke fun (list arg))))]
        (fn [arg]
          (let [previous (capture)]
            (try
              (enter previous)
              (inner arg)
              (finally (leave previous)))))))))

(defn- wait_for_local_lock_retry
  "Only contended acquisitions allocate a timer. A uniquely tagged mailbox
   event survives suspension/resumption; receive-after timers can remain stuck
   on the tested OTP 29 runtime. Never consume unrelated caller messages."
  []
  (let [ticket (erlang/start_timer 1 (erlang/self) :bl_local_lock_retry)]
    (receive
      [:timeout received :bl_local_lock_retry] :when (== received ticket) :ok)))

(defn- acquire_local_lock
  "Node-local ETS ownership with exact-ticket dead-owner recovery. A stale
   waiter must never delete by key: another owner may already hold that key."
  [row]
  (loop []
    (if (ets/insert_new :beam_lisp_vars row)
      :acquired
      (let [current (ets/lookup :beam_lisp_vars (erlang/element 1 row))]
        (when (erlang/not (erlang/== (list) current))
          (let [owner (erlang/element 2 (erlang/hd current))]
            (if (erlang/is_process_alive owner)
              (wait_for_local_lock_retry)
              (ets/delete_object :beam_lisp_vars (erlang/hd current)))))
        (recur)))))

(defn- with_local_lock [held lock-key action]
  (if (Process/get held)
    (invoke_action action)
    (let [row (tuple lock-key (erlang/self) (erlang/make_ref))]
      (acquire_local_lock row)
      (Process/put held true)
      (try (invoke_action action)
        (finally (Process/delete held) (ets/delete_object :beam_lisp_vars row))))))

(defn with_generation_lock
  "Node-local reentrant admission fence for immutable runtime generations.
   Serving slots and graph state live on this node, so their hot path must not
   inherit distributed global-lock retry backoff. Exact ETS ownership tickets
   recover dead holders without erasing a newer owner's row. Ownership is
   private process state and is never conveyed by capture/bind. Callers preserve
   slot -> generation -> sorted physical-module lock ordering; callbacks execute
   outside admission fences. Preparation may hold its distinct candidate key."
  [key action]
  (with_local_lock (tuple :bl_generation_lock_held (own-module) key)
                   (tuple :bl_generation_lock (own-module) key) action))

(defn- with_scope_lock
  "Short node-local reentrant commit/destruction lock. Uncontended operations
   use ETS without lock-server round trips. Reserved keys are outside environment
   prefixes. Never convey ownership or acquire a module/namespace/other scope
   while holding this lock. Contended waiters yield; no FIFO guarantee."
  [env action]
  (with_local_lock (tuple :bl_scope_commit_held (own-module) env)
                   (tuple :bl_scope_commit_lock (own-module) env) action))

(defn- with_module_locks
  "Prepared native batches acquire their sorted unique physical module names
   before any scope lock. Never acquire a namespace or run user callbacks here."
  [modules action]
  (if (erlang/== (list) modules)
    (invoke_action action)
    (let [mod (erlang/hd modules)]
      (with_local_lock (tuple :bl_native_publication_held (own-module) mod)
                       (tuple :bl_native_publication_lock (own-module) mod)
        (fn [] (with_module_locks (erlang/tl modules) action))))))

(defn- live_code_leases? [mod]
  (let [rows (ets/match_object :beam_lisp_code_leases
                (tuple (tuple mod :_ :_) true))]
    (Enum/reduce rows false
      (fn [row live?]
        (let [owner (erlang/element 2 (erlang/element 1 row))]
          (if (erlang/is_process_alive owner) true
            (do (ets/delete_object :beam_lisp_code_leases row) live?)))))))

(defn with_code_lease
  "Keep physical modules available for an owned callback/queued closure. Acquire
   before enqueue, retain through execution, release in finally. Owner death is
   reclaimed under the same module fence used by publication and retirement."
  [modules action]
  ;; Pre-application Loader.Server probes have no Env publication/retirement
  ;; registry yet. They can run normally; a partially initialized registry
  ;; instead fails closed in the guarded path.
  (if (and (erlang/== :undefined (ets/whereis :beam_lisp_vars))
           (erlang/== :undefined (ets/whereis :beam_lisp_code_leases)))
    (invoke_action action)
    (with_registered_code_lease modules action)))

(defn- code_lease_rows [handle]
  (let [modules (erlang/element 1 handle) owner (erlang/element 2 handle)
        ticket (erlang/element 3 handle)]
    (Enum/map modules (fn [mod] (tuple (tuple mod owner ticket) true)))))

(defn- code_lease_physical_live? [handle]
  (and (erlang/is_process_alive (erlang/element 2 handle))
       (Enum/all? (code_lease_rows handle)
         (fn [row] (erlang/== (list row)
                     (ets/lookup :beam_lisp_code_leases (erlang/element 1 row)))))))

(defn- code_lease_live? [handle]
  (and (code_lease_physical_live? handle)
       (erlang/not (ets/member :beam_lisp_vars (server_release_key handle)))))

(defn- insert_code_lease! [handle]
  ;; Module fences precede the capacity fence everywhere. Disjoint module
  ;; admissions must not each observe one remaining slot and exceed the bound.
  (with_local_lock :bl_code_lease_capacity_held :bl_code_lease_capacity_lock
    (fn []
      (let [rows (code_lease_rows handle)]
        (when (erlang/> (erlang/+ (ets/info :beam_lisp_code_leases :size)
                                 (erlang/length rows)) 65536)
          (Enum/each (ets/tab2list :beam_lisp_code_leases)
            (fn [row]
              (when (not (erlang/is_process_alive (erlang/element 2 (erlang/element 1 row))))
                (ets/delete_object :beam_lisp_code_leases row)))))
        (when (erlang/> (erlang/+ (ets/info :beam_lisp_code_leases :size)
                                 (erlang/length rows)) 65536)
          (erlang/error :code_lease_capacity))
        (ets/insert :beam_lisp_code_leases rows)))))

(defn callback_modules
  "Physical modules of a native callback or the language's explicit callable
   descriptor. Only callable arms are inspected, never arbitrary captured data."
  [callback]
  (cond
    (erlang/is_function callback)
    (list (erlang/element 2 (erlang/fun_info callback :module)))
    (and (erlang/is_tuple callback) (erlang/== 3 (erlang/tuple_size callback))
         (erlang/== :"$blfn" (erlang/element 1 callback))
         (erlang/is_map (erlang/element 2 callback))
         (erlang/=< (erlang/map_size (erlang/element 2 callback)) 64))
    (let [fixed (maps/values (erlang/element 2 callback))
          variadic (erlang/element 3 callback)
          arms (if (erlang/== nil variadic) fixed
                 (if (and (erlang/is_tuple variadic)
                          (erlang/== 2 (erlang/tuple_size variadic)))
                   (erlang/++ fixed (list (erlang/element 2 variadic)))
                   (erlang/error :invalid_callback_descriptor)))]
      (Enum/sort (Enum/uniq (Enum/map arms
        (fn [arm]
          (if (erlang/is_function arm)
            (erlang/element 2 (erlang/fun_info arm :module))
            (erlang/error :invalid_callback_descriptor)))))))
    :else (erlang/error :unsupported_executable_callback)))

(defn retain_code!
  "Acquire an opaque executable registration owned by this local process.
   Publish only after acquisition. Explicitly list physical modules, including
   captured callbacks from other modules: this does not trace arbitrary values.
   Release on unregister, or transfer before acknowledging worker acceptance."
  [modules]
  (let [modules (Enum/sort (Enum/uniq modules))
        handle (tuple modules (erlang/self) (erlang/make_ref))
        source? (and (source_head) (source_execution_active?))]
    (when (erlang/== (list) modules) (erlang/error :empty_code_lease))
    (with_module_locks modules (fn []
      (Enum/each modules (fn [mod]
        (when (not (code/is_loaded mod)) (erlang/error (tuple :code_unavailable mod)))
        (live_code_leases? mod)))
      (insert_code_lease! handle)
      (try (source_stamp! handle source?)
       (catch error
        (Enum/each (code_lease_rows handle) (fn [row] (ets/delete_object :beam_lisp_code_leases row)))
        (erlang/raise __EXCEPTION_KIND__ error __STACKTRACE__)))))
    handle))

(defn transfer_code!
  "Atomically replace a live registration's owner under publication fences.
   The old handle becomes invalid. Dead/released queued work returns cancelled;
   once accepted, the new owner survives the submitter's death."
  [handle owner]
  (when (not (and (erlang/is_pid owner)
                 (erlang/== (erlang/node owner) (erlang/node))))
    (erlang/error :invalid_code_lease_owner))
  (with_module_locks (erlang/element 1 handle) (fn []
    (assert_server_ticket_unmoved! handle)
    (if (and (erlang/is_process_alive owner) (code_lease_live? handle))
      (let [next (tuple (erlang/element 1 handle) owner (erlang/make_ref))]
        ;; Serialize the equal-sized replacement with admissions on disjoint
        ;; modules: they must not reserve the temporarily vacant transfer rows.
        (with_local_lock :bl_code_lease_capacity_held :bl_code_lease_capacity_lock
          (fn []
            ;; Restriction copied BEFORE the old physical ticket disappears.
            (source_copy! handle next)
            (ets/insert :beam_lisp_code_leases (code_lease_rows next))
            (Enum/each (code_lease_rows handle)
              (fn [row] (ets/delete_object :beam_lisp_code_leases row)))
            (source_forget! handle)))
        next)
      :cancelled))))

(defn code_lease_active?
  "Observe an exact ticket under its physical fences without admitting an
   invocation or allocating an executing lease. This is recovery evidence,
   never permission to invoke executable code outside run_code!."
  [handle]
  (with_module_locks (erlang/element 1 handle) (fn [] (code_lease_live? handle))))

(defn handoff_code!
  "Activate a predeclared exact target handle. The caller indexes that handle
   in its lifetime owner's pending slot BEFORE calling this function, so owner
   death on either side of handoff is observable without an unindexed lease.
   Existing transfer_code! keeps its original fresh-ticket API.

   Optional admission is checked inside the physical module fence. Its owner
   must be the source lease owner; expired/dead queued requests never transfer.
   A repeated call returns cancelled without releasing the accepted target."
  ([handle next] (handoff_code! handle next nil))
  ([handle next admission]
   (when (not
     (and (erlang/is_tuple handle) (erlang/== 3 (erlang/tuple_size handle))
          (erlang/is_tuple next) (erlang/== 3 (erlang/tuple_size next))
          (erlang/is_list (erlang/element 1 handle))
          (erlang/> (erlang/length (erlang/element 1 handle)) 0)
          (erlang/== (erlang/element 1 handle) (erlang/element 1 next))
          (erlang/is_pid (erlang/element 2 next))
          (erlang/== (erlang/node (erlang/element 2 next)) (erlang/node))
          (erlang/is_reference (erlang/element 3 next))
          (erlang/not (erlang/== (erlang/element 3 handle) (erlang/element 3 next)))
          (or (erlang/== nil admission)
              (and (erlang/is_map admission)
                   (erlang/== (maps/get :owner admission nil) (erlang/element 2 handle))
                   (erlang/is_integer (maps/get :deadline-ms admission nil))))))
    (erlang/error :invalid_code_handoff))
   (with_module_locks (erlang/element 1 handle)
    (fn []
     (assert_server_ticket_unmoved! handle)
     (if (and (erlang/is_process_alive (erlang/element 2 next))
              (code_lease_live? handle)
              (or (erlang/== nil admission)
                  (erlang/< (erlang/monotonic_time :millisecond) (maps/get :deadline-ms admission))))
      (let [target-rows (code_lease_rows next)]
       (when (Enum/any? target-rows
               (fn [row] (ets/member :beam_lisp_code_leases (erlang/element 1 row))))
        (erlang/error :duplicate_code_handoff_ticket))
       ;; Publish the complete target atomically BEFORE deleting any source
       ;; row. A killed mover cannot leave a deleted source without its already
       ;; indexed target. The bounded capacity check includes both sets during
       ;; this brief overlap; lack of scratch capacity refuses before acceptance.
       (insert_code_lease! next)
       (try (source_copy! handle next)
        (catch error
         (Enum/each target-rows (fn [row] (ets/delete_object :beam_lisp_code_leases row)))
         (erlang/raise __EXCEPTION_KIND__ error __STACKTRACE__)))
       (Enum/each (code_lease_rows handle)
         (fn [row] (ets/delete_object :beam_lisp_code_leases row)))
       (source_forget! handle)
       next)
      :cancelled)))))

(defn release_code!
  "Unregister an exact handle. Idempotent; stale transferred handles cannot
   release the accepted owner's ticket. Concurrent accepted invocations drain."
  [handle]
  (with_module_locks (erlang/element 1 handle) (fn []
    ;; Closing admission and releasing physical code are distinct. A native
    ;; actor callback already accepted on this same full ticket drains first.
    ;; Every entry/release serializes through the common module anchor.
    (if (and (code_lease_physical_live? handle)
             (or (server_retention_holds? handle) (server_extent_holds? handle)))
      (ets/insert :beam_lisp_vars (tuple (server_release_key handle) true))
      (do
        (Enum/each (code_lease_rows handle)
          (fn [row] (ets/delete_object :beam_lisp_code_leases row)))
        (ets/delete :beam_lisp_vars (server_release_key handle))
        (ets/delete :beam_lisp_vars (server_ticket_key handle))
        (source_forget! handle)))
    :ok)))

; Authenticated managed callback domain. Private native state, never Env tokens.
(defn- source_ensure_private! []
 ;; Recovery may native-create empty state only before SDK/application custody.
 ;; Missing tables during a live managed lifetime are corruption, never a reset.
 (when-not (erlang/== (erlang/self) (Process/whereis (own-module)))
  (erlang/error :source_extent_tables_require_env_owner))
 (let [specs (list (tuple :beam_lisp_source_extents :private)
                   (tuple :beam_lisp_source_lease_domains :private)
                   (tuple :beam_lisp_source_extent_heads :protected))
       missing? (Enum/any? specs (fn [spec] (erlang/== :undefined (ets/whereis (elem spec 0)))))]
  (Enum/each specs
   (fn [spec]
    (let [table (elem spec 0)]
     (when (erlang/not (erlang/== :undefined (ets/whereis table)))
      (when-not (and (erlang/== (ets/info table :owner) (erlang/self))
                     (erlang/== (ets/info table :protection) (elem spec 1))
                     (erlang/== (ets/info table :type) :set))
       (erlang/error :source_extent_table_owner_mismatch))))))
  (when missing?
   (when-not (and (erlang/not (ets/member :beam_lisp_vars :bl_sdk_runtime_lease))
                  (erlang/== 0 (ets/info :beam_lisp_owner_index :size))
                  (Enum/all? (erlang/++ (Enum/map specs (fn [spec] (elem spec 0)))
                                (list :beam_lisp_native_commands :beam_lisp_native_command_frames
                                      :beam_lisp_native_command_effects))
                   (fn [table] (or (erlang/== :undefined (ets/whereis table))
                                   (erlang/== 0 (ets/info table :size))))))
    (erlang/error :source_extent_recovery_requires_fresh_native_runtime))
   (Enum/each specs
    (fn [spec] (when (erlang/== :undefined (ets/whereis (elem spec 0)))
                 (ets/new (elem spec 0) (list :named_table (elem spec 1) :set))))))) :ok)
(defn- source_private [action]
 (if (erlang/== (erlang/self) (Process/whereis (own-module)))
  (do (source_ensure_private!) (invoke_action action))
  (let [result (Agent/get (own-module)
                (fn [_]
                 (try (source_ensure_private!) (tuple :ok (invoke_action action))
                  (catch error (tuple :error __EXCEPTION_KIND__ error __STACKTRACE__)))) :infinity)]
   (if (erlang/== :ok (elem result 0)) (elem result 1)
    (erlang/raise (elem result 1) (elem result 2) (elem result 3))))))
(defn initialize_source_execution!
 "Native coherent recovery initialization; no execution or write authority."
 [] (source_private (fn [] :ok)))
(defn source_seed_metadata [sha]
 ;; Compiler-only metadata cache. It is keyed by bytes already authenticated
 ;; by the current native manifest walk, never a PD marker or caller authority.
 (source_private
  (fn [] (let [rows (ets/lookup :beam_lisp_source_lease_domains (tuple :seed_metadata sha))]
           (when-not (erlang/== rows (list)) (elem (erlang/hd rows) 1))))))
(defn cache_source_seed_metadata! [sha value]
 (when-not (and (erlang/is_binary sha) (erlang/== 32 (erlang/byte_size sha)) (erlang/is_map value))
  (erlang/error :invalid_seed_metadata_cache))
 (source_private
  (fn []
   (let [key (tuple :seed_metadata sha) prior (ets/lookup :beam_lisp_source_lease_domains key)]
    (when (and (erlang/== prior (list))
               (erlang/>= (ets/info :beam_lisp_source_lease_domains :size) 65536))
     (erlang/error :source_lease_capacity))
    (when (and (erlang/not (erlang/== prior (list)))
               (erlang/not (erlang/== value (elem (erlang/hd prior) 1))))
     (erlang/error :seed_metadata_cache_changed))
    (ets/insert :beam_lisp_source_lease_domains (tuple key value))))) value)
(defn- source_lease_key [handle] (tuple (elem handle 1) (elem handle 2)))
(defn- source_lease? [handle]
 (source_private (fn [] (ets/member :beam_lisp_source_lease_domains (source_lease_key handle)))))
(defn- source_lease_profile [handle]
 (source_private
  (fn [] (let [rows (ets/lookup :beam_lisp_source_lease_domains (source_lease_key handle))]
           (when-not (= rows (list)) (elem (erlang/hd rows) 1))))))
(defn- source_prepared_identity! [generation]
 ;; Original private SDK preparation identity, not a public scope/digest flag.
 ;; Fixed checked constructor routing is obtained at native admission only.
 (when-not (and (erlang/is_map generation) (= 1 (Map/get generation :source-ingress-version)))
  (erlang/error :unclassified_managed_source_graph))
 (let [mfa (source_policy_row :source_prepared_identity)
       metadata (when (and (erlang/is_tuple mfa) (= 3 (erlang/tuple_size mfa)))
                  (source_policy_row (tuple :source_sdk_module (elem mfa 0))))]
  (when-not (and metadata (= :attested-prepared! (elem mfa 1)) (= 2 (elem mfa 2))
                 (source_exact_module? (elem mfa 0) (Map/get metadata :md5)))
   (erlang/error :source_prepared_identity_required))
  (when-not (erlang/== generation (erlang/apply (elem mfa 0) (elem mfa 1) (list generation true)))
   (erlang/error :unattested_source_generation))) generation)
(defn register_source_profile!
 "Native preparation-time freeze of original managed code and explicit grants.
  Public G edits can neither install a profile nor change an existing profile."
 [generation]
 (assert_native_framework_execution!)
 (source_prepared_identity! generation)
  (let [scope (Map/get generation :scope)
        modules (Map/new (Enum/map (BeamLisp.Vector/to_list (Map/get generation :modules))
                   (fn [module] (tuple module (erlang/apply module :module_info (list :md5))))))
        native (Map/new (Enum/flat_map (BeamLisp.Set/to_list (Map/get generation :native-modules))
                 (fn [name]
                  (let [raw (try (erlang/binary_to_existing_atom name :utf8) (catch _ nil))
                        module (if (and raw (erlang/module_loaded raw)) raw
                                 (try (erlang/binary_to_existing_atom
                                        (erlang/iolist_to_binary (list "Elixir." name)) :utf8) (catch _ nil)))]
                   (if (and module (erlang/module_loaded module))
                    (list (tuple module (erlang/apply module :module_info (list :md5)))) (list))))))
        profile {:modules modules :native native}]
   (source_private
    (fn []
     (let [key (tuple :source_profile scope) rows (ets/lookup :beam_lisp_source_lease_domains key)]
      (if (not= rows (list))
       (when-not (= profile (elem (erlang/hd rows) 1)) (erlang/error :source_execution_context_mismatch))
       (do
        (when (> (+ (ets/info :beam_lisp_source_extent_heads :size)
                    (erlang/map_size modules) (erlang/map_size native)) 262144)
         (erlang/error :source_execution_capacity))
        (ets/insert :beam_lisp_source_lease_domains (tuple key profile))
        (ets/insert :beam_lisp_source_extent_heads (tuple (tuple :source_registered_profile scope) 1))
        (Enum/each (Map/values (Map/get generation :mapping))
         (fn [namespace] (ets/insert :beam_lisp_source_extent_heads
           (tuple (tuple :source_owned_namespace scope namespace) true))))
        (Enum/each modules (fn [row] (ets/insert :beam_lisp_source_extent_heads
           (tuple (tuple :source_owned_module scope (elem row 0)) (elem row 1)))))
        (Enum/each native (fn [row] (ets/insert :beam_lisp_source_extent_heads
           (tuple (tuple :source_native_module scope (elem row 0)) (elem row 1)))))))))) scope))

(defn- source_execution_profile_key [pid handle]
 (tuple :source_execution_profile pid (elem handle 2)))
(defn- source_execution_profile_publish! [generation handle]
 (when-let [head (source_head)]
  (source_execution_active?)
  (when (and generation (not= (elem head 4) (Map/get generation :scope)))
   (erlang/error :source_execution_context_mismatch)))
 (when generation
  (let [scope (Map/get generation :scope) pid (erlang/self)
        key (source_execution_profile_key pid handle)]
   (when-not (= 1 (source_policy_row (tuple :source_registered_profile scope)))
    (erlang/error :unregistered_source_profile))
   (source_private (fn []
     (source_owner! pid)
     (let [previous (ets/lookup :beam_lisp_source_extent_heads key)]
      (ets/insert :beam_lisp_source_extent_heads (tuple key scope))
      (tuple key previous)))))))
(defn- source_execution_profile_enter! [generation handle]
 ;; One private identity check at generic native invocation admission. Actual
 ;; servers use their already-once-validated original private owner snapshot.
 (when generation (source_prepared_identity! generation))
 (source_execution_profile_publish! generation handle))
(defn- source_execution_profile_leave! [selector]
 (when selector
  (source_private (fn []
    (let [key (elem selector 0) prior (elem selector 1)]
     (if (= prior (list)) (ets/delete :beam_lisp_source_extent_heads key)
      (ets/insert :beam_lisp_source_extent_heads prior)))))) :ok)
(defn- source_admitted_generation! []
 ;; Original nonconveyed snapshot +private-owner published ticket selector.
 ;; No graph module/grant traversal, hashing, or whole profile copy on ingress.
 (let [pid (erlang/self) handle (Process/get :bl_executing_code_lease)
       proof (Process/get :bl_executing_generation)
       generation (when (and (erlang/is_tuple proof) (= 3 (erlang/tuple_size proof))) (elem proof 0))
       scope (when (erlang/is_map generation) (Map/get generation :scope))]
  (when-not (and generation (erlang/is_tuple handle) (= 3 (erlang/tuple_size handle))
                 (= pid (elem handle 1)) (= handle (elem proof 2)) (= scope (elem proof 1))
                 (= scope (env_id)) (= generation (Process/get :bl_generation))
                 (= scope (source_policy_row (source_execution_profile_key pid handle))))
   (erlang/error :source_execution_context_mismatch)) generation))
(defn- source_profile! [generation handle]
 (if (nil? generation)
  (or (let [head (source_head)] (when head (elem head 4)))
      (source_lease_profile handle)
      (erlang/error :unadmitted_source_callback))
  (let [original (source_admitted_generation!)]
   (when-not (= generation original) (erlang/error :source_execution_context_mismatch))
   (Map/get original :scope))))
(defn- source_owner_row [pid]
 (let [rows (ets/lookup :beam_lisp_source_extents pid)]
  (when-not (erlang/== rows (list)) (elem (erlang/hd rows) 1))))
(defn- source_stack [pid]
 (source_private (fn [] (let [row (source_owner_row pid)]
                        (if row (Map/get row :stack) (list))))))
(defn- source_owner_departed! [pid ticket]
 (source_private
  (fn []
   (when-not (and (erlang/is_pid pid) (erlang/== (erlang/node pid) (erlang/node))
                 (erlang/not (erlang/is_process_alive pid)))
    (erlang/error :source_owner_still_alive))
   (let [row (source_owner_row pid)]
    (when (and row (erlang/== ticket (Map/get row :ticket)))
     (ets/delete :beam_lisp_source_extents pid)
     (ets/delete :beam_lisp_source_extent_heads pid)
     (ets/delete :beam_lisp_source_extent_heads (tuple :native_command_source_barrier pid))
     (ets/match_delete :beam_lisp_source_extent_heads
       (tuple (tuple :source_execution_profile pid :_) :_))
     (Enum/each (ets/tab2list :beam_lisp_source_lease_domains)
      (fn [entry] (when (and (erlang/is_tuple (elem entry 0))
                    (= 2 (erlang/tuple_size (elem entry 0)))
                    (erlang/== pid (elem (elem entry 0) 0)))
                    (ets/delete :beam_lisp_source_lease_domains (elem entry 0))))))))) :ok)
(defn- source_owner_guardian [pid ticket]
 ;; Same native DOWN provenance pattern as existing server/owner guardians.
 (let [monitor (erlang/monitor :process pid)]
  (receive
   [:DOWN seen :process owner _] :when (and (= seen monitor) (= owner pid))
    (source_owner_departed! pid ticket))))
(defn- source_owner! [pid]
 (or (source_owner_row pid)
  (do
   (when (erlang/>= (ets/info :beam_lisp_source_extents :size) 4096)
    (erlang/error :source_execution_capacity))
   (let [ticket (erlang/make_ref)
         guardian (erlang/spawn (fn [] (source_owner_guardian pid ticket)))
         row {:ticket ticket :guardian guardian :stack (list)}]
    (ets/insert :beam_lisp_source_extents (tuple pid row)) row))))
(defn- source_push! [generation handle]
 (let [pid (erlang/self) token (erlang/make_ref) profile (source_profile! generation handle)]
  (source_private
   (fn []
    (let [row (source_owner! pid) stack (Map/get row :stack)]
     (when (erlang/>= (erlang/length stack) 256) (erlang/error :source_execution_depth))
     (ets/insert :beam_lisp_source_extents
      (tuple pid (Map/put row :stack (cons (tuple token generation handle profile) stack))))
     ;; Nonsecret scope/lease identity only; never a Source end/SDK window token.
     (ets/insert :beam_lisp_source_extent_heads
      (tuple pid (when generation (Map/get generation :scope)) handle (erlang/+ 1 (erlang/length stack)) profile))))) token))
(defn- source_enter! [generation handle]
 (when-not (and generation (erlang/== generation (source_admitted_generation!))
                (erlang/== (erlang/self) (elem handle 1))
                (or (code_lease_active? handle)
                    (server_origin_live? generation (Map/get generation :scope) handle)))
  (erlang/error :unadmitted_source_execution))
 (source_push! generation handle))
(defn- source_callback_enter! [handle]
 ;; Source-derived executable custody remains restrictive even without public
 ;; G/context. This frame adds no generation authority and contains no thunk.
 (when-not (and (source_lease? handle) (erlang/== (erlang/self) (elem handle 1))
                (erlang/== handle (Process/get :bl_executing_code_lease))
                (or (code_lease_active? handle)
                    (and (server_extent_holds? handle) (code_lease_physical_live? handle))))
  (erlang/error :unadmitted_source_callback))
 (source_push! nil handle))
(defn- source_leave! [token]
 (let [pid (erlang/self)]
  (source_private
   (fn []
    (let [row (source_owner_row pid) stack (when row (Map/get row :stack))]
     (when (or (erlang/== stack nil) (erlang/== stack (list))
               (erlang/not (erlang/== token (elem (erlang/hd stack) 0))))
      (erlang/error :source_execution_stack_mismatch))
     (let [next (erlang/tl stack)]
      (ets/insert :beam_lisp_source_extents (tuple pid (Map/put row :stack next)))
      (if (erlang/== next (list)) (ets/delete :beam_lisp_source_extent_heads pid)
       (let [top (erlang/hd next)]
        (ets/insert :beam_lisp_source_extent_heads
         (tuple pid (when (elem top 1) (Map/get (elem top 1) :scope)) (elem top 2) (erlang/length next) (elem top 3))))))))) :ok))
(defn- source_head []
 ;; O(1), actual native owner and protected table, never a caller PD marker.
 ;; Called on EVERY source invocation (measured 6-11% of compiling the boot
 ;; tier). The owner/protection proof is a property of the TABLE: a protected
 ;; table with no heir dies with its owner, so a new owner means a new table id.
 ;; Prove it once per table id and remember that id; a different id re-proves.
 (let [tid (ets/whereis :beam_lisp_source_extent_heads)]
  (if (erlang/== :undefined tid) nil
   (do
    (when-not (erlang/== tid (persistent_term/get :bl_source_extent_heads_proven nil))
     (when-not (and (erlang/== (ets/info tid :owner) (Process/whereis (own-module)))
                    (erlang/== (ets/info tid :protection) :protected))
      (erlang/error :source_extent_table_owner_mismatch))
     (persistent_term/put :bl_source_extent_heads_proven tid))
    (let [rows (ets/lookup tid (erlang/self))]
     (when-not (erlang/== rows (list)) (erlang/hd rows)))))))
(defn source_execution_active?
 "Reuse only the exact native-admitted extent. A borrowed callback adds a
  restriction even with no public G; a Source body also requires its snapshot."
 []
 (let [head (source_head)]
  (if (erlang/== head nil) false
   (let [proof (Process/get :bl_executing_generation)
         handle (Process/get :bl_executing_code_lease)]
    (when-not (and (erlang/== (elem head 2) handle)
                   (or (erlang/== nil (elem head 1))
                    (and (erlang/is_tuple proof) (erlang/== 3 (erlang/tuple_size proof))
                         (erlang/is_map (elem proof 0))
                         (erlang/== (elem head 1) (elem proof 1))
                         (erlang/== (elem head 1) (Map/get (elem proof 0) :scope))
                         (erlang/== (elem head 1) (env_id))
                         (erlang/== (elem proof 0) (Process/get :bl_generation))
                         (erlang/== handle (elem proof 2)))))
     (erlang/error :source_execution_context_mismatch)) true))))
(defn- source_body_active? []
 (let [head (source_head)]
  (and head (erlang/not (erlang/== nil (elem head 1))) (source_execution_active?)
   ;; A command turn adds no native privilege. Its nonsecret base depth forces
   ;; the first actual Source callback to add a restriction; recursion deeper
   ;; than that admitted callback remains a direct tail call.
   (let [rows (ets/lookup :beam_lisp_source_extent_heads
                (tuple :native_command_source_barrier (erlang/self)))]
    (or (erlang/== rows (list))
        (erlang/> (elem head 3) (elem (erlang/hd rows) 1)))))))
(defn source_execution_observation!
 "Native command observation from actual owner state, never caller-supplied depth."
 []
 (let [pid (erlang/self) generation (assert_execution_context!)
       handle (Process/get :bl_executing_code_lease) head (source_head)
       active? (source_execution_active?)]
  (when (and handle
             (erlang/not (and (erlang/is_tuple handle) (erlang/== 3 (erlang/tuple_size handle))
                             (erlang/== pid (elem handle 1))
                             (or (code_lease_active? handle)
                                 (and (server_extent_holds? handle) (code_lease_physical_live? handle))))))
   (erlang/error :source_execution_context_mismatch))
  (let [depth (source_private
               (fn []
                (let [row (source_owner_row pid) stack (if row (Map/get row :stack) (list))
                      depth (erlang/length stack) top (when (erlang/> depth 0) (erlang/hd stack))]
                 (when-not (if active?
                             (and head top (erlang/== depth (elem head 3))
                                  (erlang/== handle (elem top 2))
                                  (erlang/== (elem head 1) (when (elem top 1) (Map/get (elem top 1) :scope))))
                             (erlang/== depth 0))
                  (erlang/error :source_execution_context_mismatch)) depth)))]
   {:caller pid :source-depth depth :lease handle :generation generation :scope (env_id)})))
(defn- with_source_callback! [handle action]
 (if (source_lease? handle)
  (let [token (source_callback_enter! handle)]
   (try (invoke_action action) (finally (source_leave! token))))
  (invoke_action action)))
(defn- with_source_domain! [action]
 ;; Same authenticated generation AND physical lease: no token allocation or
 ;; finally frame per recur. This branch must remain a direct tail call.
 (if (source_body_active?) (invoke_action action)
  (let [generation (source_admitted_generation!) handle (Process/get :bl_executing_code_lease)
        token (source_enter! generation handle)]
   (try (invoke_action action) (finally (source_leave! token))))))
(defn with_source_execution!
 "Compiler-owned actual G body ingress. This only adds a Source restriction."
 [action]
 (if (source_body_active?) (erlang/apply action (list))
  (let [generation (source_admitted_generation!)
        module (when (erlang/is_function action 0) (elem (erlang/fun_info action :module) 1))
        md5 (when module (source_policy_row (tuple :source_owned_module (Map/get generation :scope) module)))]
   (when-not (and generation module md5 (source_exact_module? module md5))
    (erlang/error :unadmitted_source_body))
   (with_source_domain! action))))
(defn assert_native_framework_execution!
 "Deny Source callbacks; allow genuine framework work inside a retained G.
  No resource/store custody or write authorization is issued by this check."
 []
 (let [generation (assert_execution_context!)
       handle (Process/get :bl_executing_code_lease)]
  (when (and generation (erlang/not (erlang/== 1 (Map/get generation :source-ingress-version))))
   (erlang/error :unclassified_managed_source_graph))
  (when (or (source_execution_active?)
            (and (erlang/is_tuple handle) (source_lease? handle)))
   (erlang/error :native_framework_execution_required)) generation))
(defn- source_stamp_profile! [handle profile]
 (when profile
  (source_private
   (fn []
    (when (and (not (ets/member :beam_lisp_source_lease_domains (source_lease_key handle)))
               (>= (ets/info :beam_lisp_source_lease_domains :size) 65536))
     (erlang/error :source_lease_capacity))
    (source_owner! (elem handle 1))
    (ets/insert :beam_lisp_source_lease_domains (tuple (source_lease_key handle) profile))))) :ok)
(defn- source_stamp! [handle source?]
 (when source?
  ;; source_execution_active? validates the original physical context before
  ;; this label is attached. A stale nonnil head cannot stamp a native callback.
  (source_execution_active?)
  (source_stamp_profile! handle (elem (source_head) 4))) :ok)
(defn- source_copy! [handle next]
 (source_stamp_profile! next (source_lease_profile handle)))
(defn- source_forget! [handle]
 (source_private (fn [] (ets/delete :beam_lisp_source_lease_domains (source_lease_key handle)))) :ok)
; One exact native policy shared by preparation and runtime callback carriers.
; Restricted to protecting the native execution/custody machinery in this batch.
(defn source_critical_target? [module function]
 ;; One native ABI classification for direct IR and runtime carriers. These
 ;; classify actual module/function atoms; no Source spelling grants authority.
 (or
  (Enum/member? (list :Elixir.BeamLisp.AOT :Elixir.BeamLisp.AOTCache
                     :Elixir.BeamLisp.Compiler :Elixir.BeamLisp.Emit :Elixir.BeamLisp.Link
                     :Elixir.BeamLisp.Bootstrap :persistent_term :ets :sys) module)
  (and (= module :Elixir.BeamLisp.Env) (not= function :decode_data_term!))
  (erlang/== function :__bl_callable_values__)
  (erlang/== module :Elixir.BeamLisp.LazyMemo)
  (and (= module :Elixir.BeamLisp.Ns.Rt)
       (Enum/member? (list :reader_macro! :data_reader! :read-reader-macro! :read-data-reader!) function))
  (and (erlang/== module :Elixir.Function) (erlang/== function :capture))
  (and (erlang/== module :Elixir.BeamLisp.Refs)
       (Enum/member? (list :task_exec :future_exec :spawn_owned :spawn_exec) function))
  ;; Raw backend entry, including legacy decoding reads, never belongs to
  ;; Source. Genuine SDK static wrappers select closed decoding and protected
  ;; effect admission from the actual native context; a native grant cannot
  ;; expose an older decoder or skip the fixed command sink.
  (erlang/== module :Elixir.BeamLisp.Native.Datom.StoreFjall)
  (and (erlang/== module :Elixir.BeamLisp.Record)
       (Enum/member? (list :define :define_type :register :create_module
                           :publish_declaration! :replay_declaration! :publish_class!) function))
  (and (erlang/== module :Elixir.BeamLisp.Multi) (erlang/== function :extend_type))
  (and (erlang/== module :Elixir.BeamLisp)
       (Enum/member? (list :eval :eval_string :load_file) function))
  (and (erlang/== module :Elixir.BeamLisp.Supervisor)
       (Enum/member? (list :init :start_server :start_named_sup :start_native_link :start_managed_tree :managed_children) function))
  (and (erlang/== module :Elixir.BeamLisp.Server)
       (Enum/member? (list :native_start :bind_init) function))
  (and (erlang/== module :code)
       (Enum/member? (list :load_binary :load_file :delete :purge :soft_purge) function))
  (and (erlang/== module :Elixir.Agent)
       (Enum/member? (list :get :get_and_update :update :cast :stop) function))
  (and (Enum/member? (list :gen_server :gen_statem :gen_event :supervisor :Elixir.GenServer) module)
       (Enum/member? (list :call :cast :send_request :abcast :multi_call :start :start_link :start_monitor :start_child) function))
  (and (erlang/== module :erlang)
       (or (String/starts_with? (erlang/atom_to_binary function :utf8) "spawn")
           (Enum/member? (list :apply :make_fun :put :erase :process_info :fun_info :send :! :send_nosuspend
                              :send_after :start_timer :binary_to_term) function)))
  (and (erlang/== module :Elixir.Process)
       (Enum/member? (list :put :delete :info :spawn :send_after) function))
  (and (erlang/== module :Elixir.Kernel) (erlang/== function :send))
  (and (erlang/== module :timer)
       (or (String/starts_with? (erlang/atom_to_binary function :utf8) "apply_")
           (Enum/member? (list :send_after :send_interval :exit_after :kill_after) function)))
  (and (Enum/member? (list :Elixir.Task :Elixir.Agent :Elixir.GenServer
                         :Elixir.Supervisor :Elixir.DynamicSupervisor) module)
       (let [name (erlang/atom_to_binary function :utf8)]
        (or (String/starts_with? name "start") (String/starts_with? name "async"))))))
(defn source_sdk_binding_refused? [namespace binding]
 ;; Fixed managed-Source ABI restrictions joined to ACTUAL checked SDK owner
 ;; and binding metadata. These names only deny; they never attest ownership.
 (or
  (and (= "env" namespace)
       (not (Enum/member? (list "current" "id" "caps" "allowed?" "require-cap!"
                               "module-atom" "caps-entry" "implicit-names"
                               "capture" "bind" "with-env") binding)))
  (and (Enum/member? (list "core" "rt" "clojure.core" "clojure.core-more") namespace)
       (Enum/member? (list "eval" "load-file" "load-string" "resolve" "ns-resolve"
                          "find-var" "var-get" "ns-interns" "ns-publics" "ns-map" "ns-refers"
                          "intern" "alter-var-root" "with-redefs" "with-redefs-fn"
                          "reader-macro!" "data-reader!" "reader_macro!" "data_reader!") binding))
  (and (= "reload.generation" namespace)
       (Enum/member? (list "prepare!" "prepare-project!") binding))
  (Enum/member? (list "compiler" "lower" "anf") namespace)))
(defn source_native_route [module function]
 ;; The HTTP route is rewritten by checked Source production. A dynamically
 ;; supplied raw handle never receives the before-effect adapter's proof.
 (cond (source_critical_target? module function) :refuse
       (and (= :httpc module) (= :request function)) :managed-http
       :else :ordinary))
(defn- source_policy_row [key]
 ;; Exact protected native-owned row, O(1) in SDK closure size. No whole-unit
 ;; hashing, declaration walk, or inventory copy at each callback invocation.
 (let [rows (ets/lookup :beam_lisp_source_extent_heads key)]
  (when-not (= rows (list)) (elem (erlang/hd rows) 1))))
(defn- source_policy_ready! []
 (when-not (= 1 (source_policy_row :source_sdk_targets))
  (erlang/error :source_sdk_target_inventory_required)))
(defn source_target_declaration! [module function arity]
 ;; Preparation joins the SAME exact native-owned target index used at runtime.
 ;; This read never grants invocation, native plugin rights, or Source custody.
 (source_policy_ready!)
 (cond (not= :ordinary (source_native_route module function)) :refuse
       (source_policy_row (tuple :source_sdk_module module))
        (if (= :public (source_policy_row (tuple :source_sdk_target module function arity))) :public :refuse)
       :else :external))
(defn- source_profile_module [kind module]
 (let [head (source_head)]
  (when-not (and head (source_execution_active?)) (erlang/error :unadmitted_source_callback))
  (let [rows (ets/lookup :beam_lisp_source_extent_heads (tuple kind (elem head 4) module))]
   (when-not (= rows (list)) (elem (erlang/hd rows) 1)))))
(defn- source_exact_module? [module md5]
 (and md5 (erlang/module_loaded module) (= md5 (erlang/apply module :module_info (list :md5)))))
(defn- source_named_target! [module function arity]
 (when-not (and (erlang/is_atom module) (erlang/is_atom function)
                (erlang/is_integer arity) (<= 0 arity 255))
  (erlang/error :source_native_target_refused))
 (when (not= :ordinary (source_native_route module function)) (erlang/error :source_native_target_refused))
 (source_policy_ready!)
 (let [owned (source_profile_module :source_owned_module module)
       sdk (source_policy_row (tuple :source_sdk_module module))]
  (cond
   owned (when-not (and (source_exact_module? module owned) (erlang/function_exported module function arity))
           (erlang/error :source_native_target_refused))
   sdk (when-not (and (= :public (source_policy_row (tuple :source_sdk_target module function arity)))
                      (source_exact_module? module (Map/get sdk :md5))
                      (erlang/function_exported module function arity))
         (erlang/error :source_native_target_refused))
   :else
    ;; An explicit planned grant authenticates a real external dependency.
    ;; Inherited caps :all are irrelevant; an SDK/Host inventory member cannot
    ;; fall through here merely because its declaration metadata is absent.
    (let [native (source_profile_module :source_native_module module)]
     (when-not (and (source_exact_module? module native) (erlang/function_exported module function arity)
                    (not= (tuple :ok :beam_lisp) (application/get_application module)))
      (erlang/error :source_native_target_refused))))))
(defn- source_record_constructor! [value module sdk]
 (when (= :Elixir.BeamLisp.Record module)
  (let [slot (elem (erlang/fun_info value :new_index) 1)
        factory (source_policy_row (tuple :source_sdk_ctor_lambda module slot))
        captured (elem (erlang/fun_info value :env) 1)
        classes (Enum/filter captured
                  (fn [v] (and (erlang/is_atom v)
                     (or (source_policy_row (tuple :source_sdk_class v))
                         (source_profile_module :source_owned_module v)))))]
   (when factory
    (when-not (= 1 (erlang/length classes)) (erlang/error :source_native_target_refused))
    (let [class (first classes) proof (source_policy_row (tuple :source_sdk_class class))]
     (when (and proof
                (not (and (source_exact_module? class (Map/get proof :md5))
                          (Map/get proof (if (= :map_ctor factory) :map :positional)))))
      (erlang/error :source_native_target_refused)))))))
(defn- source_local_target! [value module function arity]
 (when (not= :ordinary (source_native_route module function)) (erlang/error :source_native_target_refused))
 (let [owned (source_profile_module :source_owned_module module)
       sdk (source_policy_row (tuple :source_sdk_module module))
       native (source_profile_module :source_native_module module)
       md5 (or owned (when sdk (Map/get sdk :md5)) native)]
  (when-not (and (source_exact_module? module md5)
                 (= md5 (elem (erlang/fun_info value :new_uniq) 1))
                 (or owned
                     (and sdk (Map/get sdk :local?)
                       (= (tuple function arity (erlang/length (elem (erlang/fun_info value :env) 1)))
                          (source_policy_row (tuple :source_sdk_lambda module (elem (erlang/fun_info value :new_index) 1)))))
                     (and (nil? sdk) native
                          (not= (tuple :ok :beam_lisp) (application/get_application module)))))
   (erlang/error :source_native_target_refused))
  (source_record_constructor! value module sdk)))
(defn- source_remote_target! [module function]
 ;; A remote value has no arity yet. Its exact invocation is checked again with
 ;; the actual proper argument list; private/unknown values cannot be passed to
 ;; external higher-order APIs simply because one export exists.
 (when (not= :ordinary (source_native_route module function)) (erlang/error :source_native_target_refused))
 (let [sdk (source_policy_row (tuple :source_sdk_module module))]
  (when sdk
   (when-not (= :public (source_policy_row (tuple :source_sdk_name module function)))
    (erlang/error :source_native_target_refused)))))
(defn- source_walk_list [items depth left seen]
 (loop [tail items remaining left known seen]
  (if (erlang/== tail (list)) (tuple remaining known)
   (do
    (when-not (erlang/is_list tail) (erlang/error :invalid_source_callable_capture))
    (let [state (source_walk_value (erlang/hd tail) depth remaining known)]
     (recur (erlang/tl tail) (elem state 0) (elem state 1)))))))
(defn- source_walk_map [iterator depth left seen]
 (let [item (maps/next iterator)]
  (if (erlang/== item :none) (tuple left seen)
   (let [key (source_walk_value (elem item 0) depth left seen)
         value (source_walk_value (elem item 1) depth (elem key 0) (elem key 1))]
    (source_walk_map (elem item 2) depth (elem value 0) (elem value 1))))))
(defn- source_walk_value [v depth left seen]
 (when (or (erlang/> depth 64) (erlang/=< left 0)) (erlang/error :source_callable_budget))
 (let [remaining (erlang/- left 1) next-depth (erlang/+ depth 1)]
  (cond
   (erlang/is_function v)
    (if (MapSet/member? seen v) (tuple remaining seen)
     (do
      (let [module (elem (erlang/fun_info v :module) 1)
            function (elem (erlang/fun_info v :name) 1)
            arity (elem (erlang/fun_info v :arity) 1)]
       (if (= :local (elem (erlang/fun_info v :type) 1))
        (source_local_target! v module function arity)
        (source_named_target! module function arity)))
      (source_walk_list (elem (erlang/fun_info v :env) 1) next-depth remaining (MapSet/put seen v))))
   (erlang/is_tuple v)
    (do
     ;; A macro carrier is compiler capability, including aliases/nesting; its
     ;; payload cannot be admitted as ordinary runtime callback capture.
     (when (and (erlang/> (erlang/tuple_size v) 0) (erlang/== :$macro (elem v 0)))
      (erlang/error :source_macro_value_refused))
     (when (and (erlang/== 3 (erlang/tuple_size v)) (erlang/== :$remote (elem v 0)))
      (source_remote_target! (elem v 1) (elem v 2)))
     (source_walk_list (erlang/tuple_to_list v) next-depth remaining seen))
   (erlang/is_list v) (source_walk_list v next-depth remaining seen)
   (erlang/is_map v) (source_walk_map (maps/iterator v) next-depth remaining seen)
   :else (tuple remaining seen))))
(defn check_source_callable!
 "Bounded raw callable/capture check protecting native extent internals.
  Pure native traversal; no protocol callback or mutable scratch reference.
  Trusted external native plugins are outside this supported callback boundary."
 [value]
 (when (source_head)
  (source_execution_active?)
  (source_walk_value value 0 16384 (MapSet/new))) :ok)


(defn- source_inert_argument? [value arguments]
 ;; Called only AFTER the original full callable admission. A captured/local
 ;; wrapper, a $blfn/Remote descriptor, wrong arity or any rebound predicate
 ;; retains the ordinary actual-argument walk. No caller metadata is consulted.
 (and (erlang/is_function value 1)
      (= :external (elem (erlang/fun_info value :type) 1))
      (= (list) (elem (erlang/fun_info value :env) 1))
      (erlang/is_list arguments) (not= (list) arguments) (= (list) (erlang/tl arguments))
      (let [module (elem (erlang/fun_info value :module) 1)
            function (elem (erlang/fun_info value :name) 1)
            mfa (tuple module function 1)
            proof (source_policy_row (tuple :source_inert_argument mfa))
            sdk (source_policy_row (tuple :source_sdk_module module))]
       (and (= (tuple :Elixir.BeamLisp.Ns.Rt :reduced? 1) mfa)
            proof sdk (= 1 (Map/get proof :version)) (= :raw-reduced-sentinel (Map/get proof :kind))
            (= :public (source_policy_row (tuple :source_sdk_target module function 1)))
            (= (Map/get proof :md5) (Map/get sdk :md5))
            ;; Full callable admission already checked this same SDK MD5
            ;; against the actual loaded native function before reaching here.
            (= (Map/get proof :md5) (erlang/apply module :module_info (list :md5)))))))

(defn check_source_invocation! [value arguments]
 (when (source_head)
  (check_source_callable! value)
  (when (and (erlang/is_tuple value) (= 3 (erlang/tuple_size value)) (= :$remote (elem value 0)))
   (source_named_target! (elem value 1) (elem value 2) (erlang/length arguments)))
  (let [owned? (and (erlang/is_function value)
                   (source_profile_module :source_owned_module (elem (erlang/fun_info value :module) 1)))]
   (when-not (or owned? (source_inert_argument? value arguments))
    (source_walk_value arguments 0 16384 (MapSet/new))))) :ok)

(defn check_source_invocation1!
 "Check the actual unary invocation. Native calls construct no argument list;
  only an actual private Source extent selects the full invocation policy."
 [value argument]
 (when (source_head)
  (check_source_invocation! value (list argument))) :ok)
(defn check_source_invocation2!
 "Check actual binary invocation arguments before a prepared native callback.
  The protected native Source head is tested before allocating its argument list."
 [value left right]
 (when (source_head)
  (check_source_invocation! value (list left right))) :ok)

(defn source_data_decode_required?
 "Actual private managed Source context selects the closed pre-BIF data grammar.
  A Source-labelled unadmitted callback refuses; public G alone selects nothing."
 []
 (let [head (source_head) handle (Process/get :bl_executing_code_lease)]
  (cond
   head (do (source_execution_active?) true)
   (and (erlang/is_tuple handle) (= 3 (erlang/tuple_size handle)) (source_lease? handle))
    ;; A conveyed Source-labelled ticket without actual accepted ingress may
    ;; never fall back to the native decoder merely because public G is nil.
    (erlang/error :unadmitted_source_callback)
   :else false)))
(defn- source_context_state! []
 ;; The public context value is never authority. Reauthenticate the physical
 ;; owner, original generation and actual registry at each context operation.
 (source_execution_observation!)
 (let [head (source_head)
       ;; A borrowed SDK callback has a real Source-labelled physical lease and
       ;; original private profile, but intentionally no selected/private G.
       ;; Using that profile's scope adds no Source-body admission or G proof.
       scope (if (erlang/== nil (elem head 1))
               (let [handle (Process/get :bl_executing_code_lease) original (elem head 4)]
                (when-not (and (erlang/== original (source_lease_profile handle))
                               (erlang/== 1 (source_policy_row (tuple :source_registered_profile original))))
                 (erlang/error :source_context_scope_refused)) original)
               (Map/get (source_admitted_generation!) :scope))
       registry (env_state scope) actual-chain (compute_chain scope)
       actual-caps (intersect_caps (caps_of scope) (caps))
       actual-heap (min_heap (heap_of scope) (max_heap))]
  (when-not (and registry (erlang/is_list actual-chain)
                 (erlang/not (erlang/== actual-chain (list)))
                 (erlang/== scope (erlang/hd actual-chain)))
   (erlang/error :source_context_scope_refused))
  {:scope scope :chain actual-chain :caps actual-caps :max_heap actual-heap}))

(defn source_capture_context!
 "Native capture ABI is unchanged. Source receives only nonauthorizing context
  data; no original G, admission, executing lease or private stack token escapes."
 []
 (if-not (source_data_decode_required?) (capture)
  (let [state (source_context_state!)]
   {:source-context-version 1 :source-scope (Map/get state :scope)
    :env (Map/get state :scope) :chain (Map/get state :chain)
    :caps (Map/get state :caps) :max_heap (Map/get state :max_heap)
    :ns (Process/get :bl_ns)})))

(defn source_bind_context!
 "Bind only inside an already admitted same-generation Source extent. Context
  data cannot create or convey an execution domain, callback lease or grant."
 [token]
 (if-not (source_data_decode_required?) (bind token)
  (let [state (source_context_state!) current (capture)
        allowed (list :source-context-version :source-scope :env :chain :caps :max_heap :ns)]
   (when-not (and (erlang/is_map token) (erlang/== 7 (erlang/map_size token))
                  (Enum/all? (Map/keys token) (fn [key] (Enum/member? allowed key)))
                  (erlang/== 1 (Map/get token :source-context-version))
                  (erlang/== (Map/get state :scope) (Map/get token :source-scope))
                  (erlang/== (Map/get state :scope) (Map/get token :env))
                  (or (erlang/== nil (Map/get token :ns)) (erlang/is_binary (Map/get token :ns))))
    (erlang/error :source_context_scope_refused))
   (when-not (erlang/== (Map/get state :chain) (Map/get token :chain))
    (erlang/error :source_context_chain_refused))
   (when-not (and (erlang/== (Map/get state :caps) (Map/get token :caps))
                  (erlang/== (Map/get state :max_heap) (Map/get token :max_heap)))
    (erlang/error :source_context_capability_refused))
   ;; Preserve current native authority fields; none is accepted from the public
   ;; token. The registry-derived chain closes the original bind's chain trust.
   (bind (Map/merge current {:env (Map/get state :scope) :chain (Map/get state :chain)
                             :ns (Map/get token :ns) :max_heap (Map/get state :max_heap)}))
   (restore_pdict :bl_caps (Map/get state :caps))
   (source_execution_active?) :ok)))

(defn source_with_env!
 "Source may re-enter only its actual original scope. Ordinary native env
  switching is unchanged; no child scope or trusted callback domain is minted."
 [environment action]
 (if-not (source_data_decode_required?) (with_env environment action)
  (let [state (source_context_state!)]
   (when-not (erlang/== environment (Map/get state :scope))
    (erlang/error :source_context_scope_refused))
   (check_source_invocation! action (list))
   (with_env environment
    (fn []
     (restore_pdict :bl_caps (Map/get state :caps))
     (restore_pdict :bl_max_heap (Map/get state :max_heap))
     (source_execution_active?)
     (invoke_action action))))))

(defn decode_data_term!
 "Preserve native storage ABI; actual managed Source decodes bounded closed
  ETF data before the BIF. No runtime handle/function is allocated then masked."
 ([bytes]
  (if (source_data_decode_required?)
   (do
    (erlang/apply :Elixir.BeamLisp.CompilerData :check_closed_etf! (list bytes))
    (erlang/binary_to_term bytes))
   (erlang/binary_to_term bytes)))
 ([bytes options]
  (if (source_data_decode_required?)
   (do
    ;; Preserve each existing decoder's atom/options ABI AFTER opaque/runtime
    ;; tags, compression, trailing bytes and data budgets have been checked.
    (erlang/apply :Elixir.BeamLisp.CompilerData :check_closed_etf! (list bytes))
    (erlang/binary_to_term bytes options))
   (erlang/binary_to_term bytes options))))
(defn- source_public_binding_allowed? [environment namespace binding]
 (let [head (source_head) profile (when head (elem head 4))
       sdk (source_policy_row (tuple :source_sdk_binding namespace binding))]
  (or (and (= environment profile)
           (= true (source_policy_row (tuple :source_owned_namespace profile namespace))))
      (and sdk (= :public (elem sdk 0))
           (contains? #{:function :value :class} (elem sdk 1))))))
(defn source_public_fetch
 "Generic SDK reflection boundary. Actual Source resolves only initialized
  own sealed app bindings or explicitly public SDK declarations. Never loads
  a provider, invokes a macro, or materializes an uninitialized per-env value.
  Genuine native callers retain the ordinary fetch/2 ABI."
 [namespace binding]
 (if-not (source_data_decode_required?) (fetch namespace binding)
  (do
   (when-not (and (erlang/is_binary namespace) (<= (erlang/byte_size namespace) 512)
                  (erlang/is_binary binding) (<= (erlang/byte_size binding) 512))
    (erlang/error :source_public_binding_refused))
   (let [pairs (candidates namespace binding)
         names (Enum/uniq (Enum/map pairs (fn [pair] (elem pair 0))))
         before (namespace_generations names)
         _ (when-not before (erlang/error :source_public_binding_unavailable))
         _ (Enum/each pairs (fn [pair]
              (when (and (deferred_dirs (elem pair 0)) (not (ns_ready? (elem pair 0))))
               (when-not (source_public_binding_allowed? :global (elem pair 0) (elem pair 1))
                (erlang/error :source_public_binding_refused))
               (erlang/error :source_public_binding_unavailable))))
         selected (Enum/find_value (chain) nil
                    (fn [environment]
                     (Enum/find_value pairs nil
                      (fn [pair]
                       (let [raw (ets/lookup :beam_lisp_vars (pfx environment pair))]
                        (when-not (= raw (list)) (tuple environment pair (elem (first raw) 1))))))))]
    (if (nil? selected) :error
     (let [environment (elem selected 0) pair (elem selected 1) raw (elem selected 2)
           provider (elem pair 0) name (elem pair 1)]
      ;; Check the actual chain/alias/refer-selected provider BEFORE looking
      ;; into a per-env descriptor or allowing any callback/value factory.
      (when-not (source_public_binding_allowed? environment provider name)
       (erlang/error :source_public_binding_refused))
      (when (and (erlang/is_tuple raw) (> (erlang/tuple_size raw) 0) (= :$macro (elem raw 0)))
       (erlang/error :source_public_binding_refused))
      (let [result (peek_initialized provider name)]
       (when-not (and (= before (namespace_generations names))
                      (erlang/is_tuple result) (= 2 (erlang/tuple_size result)) (= :ok (elem result 0)))
        (erlang/error :source_public_binding_unavailable))
       (check_source_callable! (elem result 1)) result)))))))

(defn invoke_source_native! [module function arguments]
 ;; Emitted only at checked managed Source native call sites. This is a
 ;; denial-only dynamic boundary; native SDK static calls retain their ABI.
 (when-not (source_head) (erlang/error :unadmitted_source_callback))
 (source_execution_active?)
 (source_named_target! module function (erlang/length arguments))
 (source_walk_value arguments 0 16384 (MapSet/new))
 (erlang/apply module function arguments))

; Native private execution proof. NEVER part of Env.capture/bind/convey.
; Native private actor execution attestation. Never captured/conveyed/bound.
(defn- server_release_key [handle]
  (tuple :bl_server_execution_release (erlang/element 2 handle) (erlang/element 3 handle)))
(defn- server_private_field [owner key]
  (if (erlang/== owner (erlang/self)) (Process/get key)
    (let [info (Process/info owner :dictionary)]
      (when (erlang/is_tuple info)
        (Keyword/get (erlang/element 2 info) key)))))
(defn- server_ticket_key [handle]
  (tuple :bl_server_execution_ticket (erlang/element 2 handle) (erlang/element 3 handle)))
(defn- server_extent_holds? [handle]
  ;; Ordinary callback/task tickets never copy a remote process dictionary.
  ;; This marker is a selector only: the exact private attestation/extent below
  ;; supplies authority, and remains required even if a marker is copied.
  (and (ets/member :beam_lisp_vars (server_ticket_key handle))
    (let [extent (server_private_field (erlang/element 2 handle) :bl_server_execution_extent)]
      (and (erlang/is_tuple extent) (erlang/== 2 (erlang/tuple_size extent))
           (erlang/== handle (erlang/element 1 extent))
           (erlang/is_integer (erlang/element 2 extent)) (erlang/> (erlang/element 2 extent) 0)))))
(defn- server_retention_holds? [handle]
  ;; An authenticated source owner retains its ticket through actual DOWN,
  ;; including idle logical close and the subsequent native terminate callback.
  (and (ets/member :beam_lisp_vars (server_ticket_key handle))
    (let [owner (or (server_private_field (erlang/element 2 handle) :bl_server_execution_owner)
                     (server_private_field (erlang/element 2 handle) :bl_supervisor_execution_owner))]
      (and (erlang/is_tuple owner) (erlang/== 6 (erlang/tuple_size owner))
           (erlang/== handle (erlang/element 4 owner))))))
(defn- assert_server_ticket_unmoved! [handle]
  (when (or (server_retention_holds? handle) (server_extent_holds? handle))
    (erlang/error :server_execution_lease_not_transferable)))
(defn- server_membership_live? [native membership]
  (let [rows (ets/lookup :beam_lisp_owner_index (Map/get membership :key))
        entry (when (erlang/== 1 (erlang/length rows)) (erlang/element 2 (erlang/hd rows)))
        proof (when entry (Map/get entry :native-evidence))]
    (and entry (erlang/== :server (Map/get entry :kind))
         (erlang/== (erlang/self) (Map/get entry :pid))
         (erlang/== membership (Map/take entry (list :key :ticket :pid :application-id :kind :proof-id)))
         (erlang/not (ets/member :beam_lisp_owner_revisions (tuple :closed (Map/get membership :ticket))))
         (erlang/== (Map/get native :lease) (Map/get proof :lease))
         (erlang/== (Map/get native :module) (Map/get proof :module))
         (erlang/== (Map/get native :generation) (Map/get proof :generation))
         (erlang/== (Map/get native :application-id) (Map/get proof :application-id)))))
(defn install_server_execution!
  "Compiler/runtime internal: cache full-graph native proof once, inside the
   actual generated init AFTER monitored registration. No caller graph/flag."
  [module lease]
  (verify_server_start! module)
  (register_server_init! module lease)
  (let [generation (Process/get :bl_generation) scope (env_id)
        rows (ets/lookup :beam_lisp_vars (tuple :bl_generation_owner (erlang/self)))
        native (when (erlang/== 1 (erlang/length rows)) (erlang/element 2 (erlang/hd rows)))
        membership (when native (Map/get native :membership))]
    (when-not (and (erlang/is_map generation) (erlang/is_map native)
                  (erlang/is_map membership)
                  (erlang/is_tuple lease) (erlang/== 3 (erlang/tuple_size lease))
                  (erlang/is_list (erlang/element 1 lease))
                  (erlang/> (erlang/length (erlang/element 1 lease)) 0)
                  (erlang/is_reference (erlang/element 3 lease))
                  (erlang/== :server (Map/get native :kind))
                  (erlang/== scope (Map/get generation :scope))
                  (erlang/== module (Map/get native :module))
                  (erlang/== lease (Map/get native :lease))
                  (erlang/== (erlang/self) (erlang/element 2 lease))
                  (erlang/== (Map/get generation :digest) (Map/get native :generation))
                  (erlang/== (Map/get generation :application-id) (Map/get native :application-id))
                  (server_membership_live? native membership))
      (erlang/error :invalid_server_execution_owner))
    (source_prepared_identity! generation)
    (with_module_locks (erlang/element 1 lease)
      (fn []
        (when-not (and (code_lease_live? lease)
                       (erlang/== (erlang/element 1 lease)
                         (Enum/sort (Enum/uniq (Enum/to_list (Map/get generation :modules))))))
          (erlang/error :incomplete_server_execution_lease))
        (Process/put :bl_server_execution_owner
          (tuple generation scope module lease membership (erlang/hd (erlang/element 1 lease))))
        ;; Native-only original context: public Env.bind cannot replace it.
        ;; Only terminate may restore it after a poisoned public binding.
        (Process/put :bl_server_execution_context (capture))
        ;; Published under all ticket fences. SDK adoption revokes source
        ;; attestation but keeps this selector through its accepted init extent;
        ;; only physical ticket cleanup removes it.
        (ets/insert :beam_lisp_vars (tuple (server_ticket_key lease) true))))
    :ok))
(defn with_server_execution!
  "Compiler-owned callback entry. Reuse the exact existing native owner ticket;
   no second whole graph ticket or graph-sized ETS insert per message."
  [module callback action]
  (when-not (and (erlang/is_function action 0)
                (Enum/member? (list :init :handle_call :handle_cast :handle_info :handle_continue :terminate) callback))
    (erlang/error :invalid_server_execution_action))
  (if (and (erlang/== nil (Process/get :bl_generation))
           (erlang/== nil (Process/get :bl_server_execution_owner)))
    (do (assert_execution_context!) (invoke_action action))
    (let [owner (Process/get :bl_server_execution_owner)]
      (when-not (and (erlang/is_tuple owner) (erlang/== 6 (erlang/tuple_size owner))
                    (erlang/== module (erlang/element 3 owner))
                    (erlang/== module (erlang/element 2 (erlang/fun_info action :module)))
                    (or (erlang/== :terminate callback)
                        (and (erlang/== (Process/get :bl_generation) (erlang/element 1 owner))
                             (erlang/== (env_id) (erlang/element 2 owner)))))
        (erlang/error :unadmitted_server_execution))
      (let [lease (erlang/element 4 owner) anchor (erlang/element 6 owner)
            previous-extent (Process/get :bl_server_execution_extent)
            previous-code (Process/get :bl_executing_code_lease)
            previous-generation (Process/get :bl_executing_generation)
            previous-context (when (erlang/== :terminate callback) (capture))
            original-context (Process/get :bl_server_execution_context)]
        (when (and (erlang/== :terminate callback)
                   (erlang/not (and (erlang/is_map original-context)
                     (erlang/== (Map/get original-context :generation) (erlang/element 1 owner))
                     (erlang/== (Map/get original-context :env) (erlang/element 2 owner)))))
          (erlang/error :invalid_server_cleanup_context))
        (when (erlang/== :init callback) (server_init_enter! module lease))
        (try
        ;; Every complete-ticket mutation holds this same anchor. Its row plus
        ;; the private once-validated full ticket is O(1) admission evidence.
        (with_module_locks (list anchor)
          (fn []
            (let [rows (ets/lookup :beam_lisp_vars (tuple :bl_generation_owner (erlang/self)))
                  native (when (erlang/== 1 (erlang/length rows)) (erlang/element 2 (erlang/hd rows)))
                  expected (tuple (tuple anchor (erlang/self) (erlang/element 3 lease)) true)]
              (when-not (and
                     (erlang/== (list expected) (ets/lookup :beam_lisp_code_leases (erlang/element 1 expected)))
                     ;; Cleanup is allowed after logical close on the original
                     ;; privately attested physical ticket. No new business
                     ;; callback receives this exception; owner DOWN drains it.
                     (or (erlang/== :terminate callback)
                         (and native (erlang/== lease (Map/get native :lease))
                              (server_membership_live? native (erlang/element 5 owner))
                              (erlang/not (ets/member :beam_lisp_vars (server_release_key lease))))))
                (erlang/error :released_server_execution_owner))
              (Process/put :bl_server_execution_extent
                (tuple lease (if (and (erlang/is_tuple previous-extent)
                                      (erlang/== lease (erlang/element 1 previous-extent)))
                               (erlang/+ 1 (erlang/element 2 previous-extent)) 1)))
              (Process/put :bl_executing_code_lease lease)
              (Process/put :bl_executing_generation
                (tuple (erlang/element 1 owner) (erlang/element 2 owner) lease)))))
          (when previous-context (bind original-context))
          (let [selector (source_execution_profile_publish! (elem owner 0) lease)]
           (try (with_source_callback! lease action)
            (finally (source_execution_profile_leave! selector))))
          (finally
            (try
              (when (erlang/== :init callback) (server_init_complete! module lease))
              (finally
            (when previous-context (bind previous-context))
            (restore_pdict :bl_executing_generation previous-generation)
            (restore_pdict :bl_executing_code_lease previous-code)
            (restore_pdict :bl_server_execution_extent previous-extent)
            (when (and (erlang/not (server_extent_holds? lease))
                       (ets/member :beam_lisp_vars (server_release_key lease)))
              (release_code! lease))))))))))

(defn with_owned_code_execution
  "Internal native primitive after an admitted borrow or an exact native owned
   task handoff. Requires the actual active SELF-owned ticket. No new retention
   is allocated and this helper never releases its caller's execution ticket."
  [handle action]
  (when-not (and (erlang/is_tuple handle) (erlang/== 3 (erlang/tuple_size handle))
                (erlang/== (erlang/self) (elem handle 1)) (code_lease_active? handle))
    (erlang/error :unadmitted_code_execution))
  (let [previous (Process/get :bl_executing_code_lease)
        prior-generation (Process/get :bl_executing_generation)]
    (Process/put :bl_executing_code_lease handle)
    (Process/delete :bl_executing_generation)
    (try (with_source_callback! handle action)
      (finally
        (restore_pdict :bl_executing_generation prior-generation)
        (restore_pdict :bl_executing_code_lease previous)))))

(defn with_owned_generation_execution
  "Internal exact user-entry boundary INSIDE native invocation admission.
   Callback callers use it after conveying their captured context; native tasks
   use it after their exact start ticket and context bind. Ordinary bind/convey
   never writes this private snapshot. It is not part of a transferable token."
  [action]
  (let [handle (Process/get :bl_executing_code_lease)
        previous (Process/get :bl_executing_generation)]
    (when-not (and (erlang/is_tuple handle) (erlang/== 3 (erlang/tuple_size handle))
                  (erlang/== (erlang/self) (elem handle 1)) (code_lease_active? handle))
      (erlang/error :unadmitted_generation_execution))
    (let [selector (source_execution_profile_enter! (Process/get :bl_generation) handle)]
     (Process/put :bl_executing_generation
       (tuple (Process/get :bl_generation) (env_id) handle))
     (try
       (if (source_lease? handle)
        (if (and (nil? (Process/get :bl_generation)) (source_execution_active?))
         (invoke_action action) (with_source_domain! action))
        (invoke_action action))
       (finally
        (restore_pdict :bl_executing_generation previous)
        (source_execution_profile_leave! selector))))))

(defn- server_origin_live? [generation scope handle]
  ;; Accepted physical extent survives logical close, independently of public
  ;; bindings. This is not a captured token or a marker-only authority grant.
  (let [owner (Process/get :bl_server_execution_owner)]
    (and (erlang/is_tuple owner) (erlang/== 6 (erlang/tuple_size owner))
         (erlang/== generation (erlang/element 1 owner))
         (erlang/== scope (erlang/element 2 owner))
         (erlang/== handle (erlang/element 4 owner))
         (server_extent_holds? handle) (code_lease_physical_live? handle))))

(defn execution_origin
  "Read-only original graph INSIDE actual native invocation admission. Public
   Env.bind cannot erase or replace this nonconveyed snapshot. No lease escapes."
  []
  (try
    (let [handle (Process/get :bl_executing_code_lease)
          proof (Process/get :bl_executing_generation)
          generation (when (and (erlang/is_tuple proof) (erlang/== 3 (erlang/tuple_size proof)))
                       (erlang/element 1 proof))
          scope (when generation (erlang/element 2 proof))
          modules (when (erlang/is_map generation) (Map/get generation :modules))]
      (when (and (erlang/is_map generation)
           (erlang/== scope (Map/get generation :scope))
           (erlang/== handle (erlang/element 3 proof))
           (erlang/is_tuple handle) (erlang/== 3 (erlang/tuple_size handle))
           (erlang/== (erlang/self) (erlang/element 2 handle))
           (erlang/is_reference (erlang/element 3 handle))
           (erlang/is_list (erlang/element 1 handle))
           (erlang/=< (erlang/length (erlang/element 1 handle)) 65536)
           (erlang/is_map modules)
           (erlang/== :Elixir.BeamLisp.Vector (Map/get modules :__struct__))
           (let [n (BeamLisp.Vector/count modules)]
             (and (erlang/is_integer n) (erlang/> n 0) (erlang/=< n 65536)
                  (let [owned (MapSet/new (erlang/element 1 handle))
                        values (BeamLisp.Vector/to_list modules)]
                    (and (erlang/== n (erlang/length values))
                         (Enum/all? values (fn [module]
                           (and (erlang/is_atom module) (MapSet/member? owned module))))
                         (or (code_lease_active? handle)
                             (server_origin_live? generation scope handle))))))) generation))
    (catch _ nil)))

(defn executing_generation?
  "An actual native origin AND its unchanged public generation/scope. Retention
   or a captured context alone cannot create managed producer/start authority."
  [generation]
  (and generation (erlang/== generation (Process/get :bl_generation))
       (erlang/== (env_id) (Map/get generation :scope))
       (erlang/== generation (execution_origin))))

(defn check_server_inputs!
  "Fixed compiler input entry inside actual native server admission. SDK actors
   retain ordinary callbacks without importing the application body analyzer."
  [module key bindings]
  (let [generation (Process/get :bl_generation)]
    (if (erlang/== nil generation)
      ;; No creator/adoption authority is granted by an unmanaged no-op. A
      ;; cleared public context inside Source execution still refuses here.
      (do (assert_execution_context!) :ok)
      (let [owner (Process/get :bl_server_execution_owner)]
        (when-not (and (executing_generation? generation)
                      (erlang/is_tuple owner) (erlang/== 6 (erlang/tuple_size owner))
                      (erlang/== module (erlang/element 3 owner))
                      (erlang/== generation (erlang/element 1 owner))
                      (erlang/== (env_id) (erlang/element 2 owner))
                      (erlang/== (Process/get :bl_executing_code_lease) (erlang/element 4 owner))
                      (server_extent_holds? (erlang/element 4 owner)))
          (erlang/error :unadmitted_actor_input_check))
        (when (and (Map/get generation :server-classes)
                   (BeamLisp.Set/member? (Map/get generation :server-classes) module))
          ;; Fixed native MFA only. No Loader initialization, mutable Env
          ;; binding/callback, module argument or caller certificate selects it.
          ;; Actual app preparation already owns/loads the SDK contract code.
          (erlang/apply :Elixir.BeamLisp.Ns.Proc.Contract :check-entry!
                        (list module key bindings)))
        :ok))))

(defn assert_execution_context!
  "Shared producer/start preflight BEFORE allocation or OTP effects. A public
   bind may change context, but cannot turn actual Source execution unmanaged.
   Returns the selected graph, or nil for genuinely unmanaged development."
  []
  (let [origin (execution_origin) selected (Process/get :bl_generation)
        proof (Process/get :bl_executing_generation)
        source-snapshot? (and (erlang/is_tuple proof) (erlang/== 3 (erlang/tuple_size proof))
                              (erlang/not (erlang/== nil (erlang/element 1 proof))))]
    (when (and origin (erlang/not (and (erlang/== selected origin)
                                      (erlang/== (env_id) (Map/get origin :scope)))))
      (erlang/error :execution_origin_context_mismatch))
    (when (and (or selected source-snapshot?
                         (Process/get :bl_server_execution_owner)
                         (Process/get :bl_supervisor_execution_owner))
               (erlang/== nil origin))
      (erlang/error :unadmitted_execution_origin))
    selected))

(defn run_code!
  "Accept one invocation of a retained registration, or return cancelled.
   Acquire a separate executing lease before unregister can release its ticket;
   execute outside the fence and release even when the callback raises."
  [handle action]
  (let [accepted (with_module_locks (erlang/element 1 handle) (fn []
                   (if (code_lease_live? handle)
                     (retain_code! (erlang/element 1 handle)) :cancelled)))]
    (if (erlang/== :cancelled accepted) :cancelled
      (try
       (source_copy! handle accepted)
       (with_owned_code_execution accepted action)
       (finally (release_code! accepted))))))

(defn- with_registered_code_lease [modules action]
  (let [handle (retain_code! modules)]
    (try (with_owned_code_execution handle (fn [] (with_owned_generation_execution action))) (finally (release_code! handle)))))

(defn code_evidence_generation
  "Native generated-code/receipt publication generation, or nil while any
   publisher is active. Constant-size invalidation for pass-local readers."
  []
  (let [rows (ets/lookup :beam_lisp_vars :bl_code_evidence_generation)]
    (if (erlang/== rows (list)) 0
      (let [row (erlang/hd rows)]
        (when (erlang/== 0 (erlang/element 3 row)) (erlang/element 2 row))))))

(defn with_code_evidence_publication
  "Fence native code/receipt evidence changes. This never grants execution
   authority or widens the caller's scope; overlapping writers decline memos."
  [action]
  (ets/update_counter :beam_lisp_vars :bl_code_evidence_generation
    (list (tuple 2 1) (tuple 3 1)) (tuple :bl_code_evidence_generation 0 0))
  (try (invoke_action action)
    (finally
      (ets/update_counter :beam_lisp_vars :bl_code_evidence_generation
        (list (tuple 2 1) (tuple 3 -1))))))

(defn retire_modules!
  "Preflight a complete physical graph under sorted native admission locks.
   A retained member prevents deleting ANY member. Soft purge never kills a
   process. Callers must retain the complete graph for every executable user."
  [modules]
  (let [modules (Enum/sort (Enum/uniq modules))]
    (with_module_locks modules
      (fn []
        (if (Enum/any? modules (fn [mod] (live_code_leases? mod))) false
          (with_code_evidence_publication
            (fn []
              (if (Enum/all? modules (fn [mod] (code/soft_purge mod)))
                (do (Enum/each modules (fn [mod] (code/delete mod)))
                    (Enum/all? modules (fn [mod] (code/soft_purge mod)))) false))))))))

(defn retire_module!
  "Soft retirement serialized with leases and native publication."
  [mod] (retire_modules! (list mod)))

(defn- detach_provider_tables
  "Caller owns the physical module. Freeze every scope's old literal reference
   before replacing it, including sibling namespaces in a multi-namespace unit.
   Scope locks make replacement atomic; acquiring namespace locks here would
   invert namespace -> module -> scope ordering. Missing providers are frozen
   empty when registered, so only loaded AOT providers need a table scan."
  [mod]
  (when (erlang/function_exported mod :__bl_ns_defs__ 0)
    (Enum/each
      (ets/match_object :beam_lisp_vars
        (tuple (tuple :_ :ns_defs :_) (tuple :"$beam" mod)))
      (fn [row]
        (let [k (erlang/element 1 row) env (erlang/element 1 k) ns (erlang/element 3 k)]
          (with_scope_commit env (fn []
            (when (erlang/== (list row) (ets/lookup :beam_lisp_vars k))
              (replace_namespace_table env ns (resolve_ns_defs (erlang/element 2 row)))))))))))

(defn with_scope_commit
  "Commit only while the target scope is alive. Destruction shares this lock;
   a delayed publisher cannot insert rows after destruction. This is a short
   mutation fence, not revocation or cancellation of already executing work."
  [env action]
  (with_scope_lock env
    (fn []
      (if (if (erlang/== :global env)
            (not (persistent_term/get (tuple (own-module) :global_destroyed) false))
            (ets/member :beam_lisp_vars (tuple env :definition_lifetime)))
        (invoke_action action)
        :retired))))

(defn- installed_binary? [beam]
  ;; Compare executable code under its physical module fence. Compiler-generated
  ;; modules have no on_load side effects. An identical replay needs no third
  ;; generation and must not evict callbacks holding the old generation.
  (let [mod (erlang/element 1 beam) bytes (erlang/element 2 beam)]
    (and (erlang/module_loaded mod)
         (try
           (let [result (beam_lib/md5 bytes)]
             (and (erlang/is_tuple result) (erlang/== 2 (erlang/tuple_size result))
                  (erlang/== :ok (erlang/element 1 result))
                  (let [identity (erlang/element 2 result)]
                    (and (erlang/is_tuple identity) (erlang/== 2 (erlang/tuple_size identity))
                         (erlang/== mod (erlang/element 1 identity))
                         (erlang/== (erlang/apply mod :module_info (list :md5))
                                    (erlang/element 2 identity))))))
           (catch _ false)))))

(defn- generated_class_metadata [attrs]
  (let [raw (Keyword/get attrs :bl_generated_class)]
    (if (and (erlang/is_list raw) (erlang/== 1 (erlang/length raw))) (erlang/hd raw) raw)))

(defn- assert_class_schema_publication! [beam]
  ;; Executable MD5 deliberately excludes class metadata. Deftype fields can
  ;; therefore change while code remains identical; the no-op path must share
  ;; the same immutable-schema fence as a physical code replacement.
  (let [mod (erlang/element 1 beam)]
    (when (erlang/module_loaded mod)
      (let [old (generated_class_metadata (erlang/apply mod :module_info (list :attributes)))
            chunks (beam_lib/chunks (erlang/element 2 beam) (list :attributes))
            attrs (Keyword/get (erlang/element 2 (erlang/element 2 chunks)) :attributes)
            next (generated_class_metadata attrs)]
        (when (and (or old next) (live_code_leases? mod) (erlang/not (erlang/== old next)))
          ;; Adding compiler stamps to a legacy registered class is safe only
          ;; when its already-known immutable runtime schema agrees exactly.
          (let [info (when (and (erlang/== nil old) next) (BeamLisp.Record/info mod))
                known (when (and (erlang/is_tuple info) (erlang/== 4 (erlang/tuple_size info)))
                        (tuple 1 (erlang/element 2 info) (erlang/element 3 info)
                          (erlang/element 1 info)
                          (Enum/map (erlang/element 4 info) (fn [field] (Atom/to_string field)))))]
            (when-not (and known (erlang/== known next))
              (erlang/error (tuple :class_schema_leased mod)))))))))

(defn publish_binaries!
  "Publish prepared compiler-generated bytes under physical module ownership
   and the current scope's retirement fence. One argument is {beam, filename}
   pairs; two arguments share a filename. Detach all old literal providers before
   taking the current scope lock. Compilation, I/O and user initializers stay
   outside. Identical executable bytes are a no-op under the same fences, so
   repeated per-environment initialization does not consume code generations.
   A no-op keeps the installed filename. Error/owner death does not roll back
   already loaded code. Raw host/on_load interop is outside this generated-code API."
  ([beams filename]
   (publish_binaries! (Enum/map beams (fn [beam] (tuple beam filename)))))
  ([prepared]
   (let [modules (Enum/sort (Enum/uniq (Enum/map prepared
                    (fn [pair] (erlang/element 1 (erlang/element 1 pair))))))]
     (when (erlang/not (erlang/== (erlang/length modules) (erlang/length prepared)))
       (erlang/error :duplicate_code_publication_module))
     (with_module_locks modules
       (fn []
         (Enum/each prepared (fn [pair] (assert_class_schema_publication! (erlang/element 1 pair))))
         (let [changed (Enum/reject prepared
                         (fn [pair] (installed_binary? (erlang/element 1 pair))))
               changed_modules (Enum/uniq (Enum/map changed
                                 (fn [pair] (erlang/element 1 (erlang/element 1 pair)))))]
           ;; Forwarder export additions may change shim bytes, but never the
           ;; attested SDK functions those surfaces route into. Verify actual
           ;; instructions before any publication effect.
           (let [rows (ets/lookup :beam_lisp_vars :bl_sdk_runtime_lease)
                 sdk (when (erlang/not (erlang/== rows (list))) (erlang/element 2 (erlang/hd rows)))]
             (when sdk
               (Enum/each changed
                 (fn [pair]
                   (let [beam (erlang/element 1 pair) mod (erlang/element 1 beam)
                         stable (Map/get (Map/get sdk :modules) mod)
                         proof (Map/get (Map/get sdk :forwarders {}) mod)]
                     (when (and stable
                                (erlang/not (erlang/== stable
                                  (erlang/element 2 (erlang/element 2 (beam_lib/md5 (erlang/element 2 beam)))))))
                       (erlang/error :sdk_runtime_replacement_requires_handover))
                     (when proof
                       (BeamLisp.AOT/verify_sdk_forwarder! beam (Map/get proof :namespace) (Map/get proof :routes))))))))
           (Enum/each changed_modules (fn [mod]
             (when (native_start_class_held? mod)
               (erlang/error (tuple :native_start_class_code_held mod)))))
           (Enum/each changed_modules (fn [mod]
             (when (and (erlang/check_old_code mod) (live_code_leases? mod))
               (erlang/error (tuple :code_leased mod)))))
           ;; Loading a third generation implicitly hard-purges old code.
           ;; A compiler/request may execute it without an explicit callback
           ;; lease, so refuse instead of allowing the code server to kill it.
           (Enum/each changed_modules (fn [mod]
             (when (and (erlang/check_old_code mod) (erlang/not (code/soft_purge mod)))
               (erlang/error (tuple :code_in_use mod)))))
           (Enum/each changed_modules (fn [mod] (detach_provider_tables mod)))
           ;; Even a fully identical batch must fail in a retired scope.
           (let [result (with_scope_commit (env_id)
                          (fn []
                            (when (erlang/not (erlang/== changed (list)))
                              (with_code_evidence_publication
                                (fn []
                                  (Enum/each changed
                                    (fn [pair]
                                      (let [beam (erlang/element 1 pair) mod (erlang/element 1 beam)
                                            rows (ets/lookup :beam_lisp_vars :bl_sdk_runtime_lease)
                                            sdk (when (erlang/not (erlang/== rows (list))) (erlang/element 2 (erlang/hd rows)))
                                            proof (when sdk (Map/get (Map/get sdk :forwarders {}) mod))]
                                        (BeamLisp.Emit/load_binary! beam (erlang/element 2 pair))
                                        (when proof
                                          (ets/insert :beam_lisp_vars
                                            (tuple (tuple :bl_sdk_forwarder_current mod)
                                              {:md5 (erlang/apply mod :module_info (list :md5)) :routes (Map/get proof :routes)})))))))))
                            :ok))]
             (if (erlang/== :retired result) (erlang/error :scope_retired) result))))))))

(defn destroy
  "Drop every row belonging to `env` and forget its bookkeeping. One
   `select_delete` scan guarded on the key's first element, so it works for
   every key shape without enumerating them."
  [env]
  (with_scope_lock env (fn []
  (let [guards (list (tuple :andalso
                              (tuple :is_tuple :"$1")
                              (tuple :== (tuple :element 1 :"$1") (tuple :const env))))
        spec (list (tuple (tuple :"$1" :_) guards (list true))
                   (tuple (tuple :"$1" :_ :_) guards (list true)))]
    ;; Global destruction can erase generation evidence. Poison certification
    ;; before deletion so a concurrent reader never mistakes missing rows for
    ;; a never-published namespace. Global teardown is intentionally terminal.
    (when (erlang/== :global env)
      (persistent_term/put (tuple (own-module) :global_destroyed) true))
    (ets/select_delete :beam_lisp_vars spec)
    (bump_epoch)
    (Agent/update (own-module)
      (fn [s] (Map/update s :envs (maps/new) (fn [envs] (Map/delete envs env)))))
    :ok))))

(defn attach
  "Bind `env` in the calling process without a block form — the harness
   primitive behind `Sandbox.checkout/1`."
  [env]
  (Process/put :bl_env env)
  (Process/put :bl_env_chain (compute_chain env))
  (Process/put :bl_caps (caps_of env))
  (restore_pdict :bl_max_heap (heap_of env))
  (Process/delete :bl_ns)
  :ok)

; Standard System environment APIs honor a command's process-local view.
; The raw bridge uses erlang.apply so compiling this host cannot redirect itself.
(defn- osenv_args [& args] args)
(defn- osenv_tuple [& args] (erlang/list_to_tuple args))
(defn- raw_osenv [fun args] (erlang/apply :Elixir.System fun args))
(defn os_get_env
  ([]
   (let [base (raw_osenv :get_env (osenv_args)) ov (Process/get :bl-osenv-overlay)]
    (if (erlang/is_map ov)
     (Enum/reduce ov base (fn [entry acc]
       (let [k (erlang/element 1 entry) v (erlang/element 2 entry)]
        (if (erlang/== nil v) (Map/delete acc k) (Map/put acc k v))))) base)))
  ([key] (os_get_env key nil))
  ([key default]
   (if (and (erlang/is_binary key) (or (erlang/is_binary default) (erlang/== nil default)))
    (let [ov (Process/get :bl-osenv-overlay)]
     (if (and (erlang/is_map ov) (Map/has_key? ov key))
      (or (Map/get ov key) default)
      (raw_osenv :get_env (osenv_args key default))))
    (raw_osenv :get_env (osenv_args key default)))))
(defn os_fetch_env [key]
 (if (erlang/is_binary key)
  (let [v (os_get_env key)] (if (erlang/== nil v) :error (osenv_tuple :ok v)))
  (raw_osenv :fetch_env (osenv_args key))))
(defn os_fetch_env! [key]
 (if (erlang/is_binary key)
  (let [v (os_get_env key)]
   (if (erlang/== nil v)
    (erlang/error (Elixir.System.EnvError/exception (osenv_args (osenv_tuple :env key)))) v))
  (raw_osenv :fetch_env! (osenv_args key))))
(defn- local_osenv_key! [key arity]
 (when (erlang/not (erlang/== :nomatch (binary/match key "=")))
  (erlang/error (Elixir.ArgumentError/exception
   (erlang/iolist_to_binary (osenv_args "cannot execute System.put_env/" (erlang/integer_to_binary arity)
     " for key with \"=\", got: " (Kernel/inspect key))))))
 (when (or (erlang/== 0 (erlang/byte_size key))
           (erlang/not (erlang/== :nomatch (binary/match key (erlang/list_to_binary (osenv_args 0))))))
  (erlang/error :badarg)) key)
(defn- local_osenv_value! [value]
 (when (erlang/not (erlang/== :nomatch (binary/match value (erlang/list_to_binary (osenv_args 0)))))
  (erlang/error :badarg)) value)
(defn os_put_env
 ([entries]
  (if (erlang/is_map (Process/get :bl-osenv-overlay))
   (Enum/each entries (fn [entry]
    (let [key (IO/chardata_to_string (List.Chars/to_charlist (erlang/element 1 entry)))
          value (erlang/element 2 entry)]
     (local_osenv_key! key 1)
     (Process/put :bl-osenv-overlay
      (Map/put (Process/get :bl-osenv-overlay) key
       (if (erlang/== nil value) nil (local_osenv_value! (IO/chardata_to_string (List.Chars/to_charlist value)))))))))
   (raw_osenv :put_env (osenv_args entries))))
 ([key value]
  (if (and (erlang/is_map (Process/get :bl-osenv-overlay))
           (erlang/is_binary key) (erlang/is_binary value))
   (do (local_osenv_key! key 2)
       (Process/put :bl-osenv-overlay (Map/put (Process/get :bl-osenv-overlay) key (local_osenv_value! value))) :ok)
   (raw_osenv :put_env (osenv_args key value)))))
(defn os_delete_env [key]
 (if (erlang/is_map (Process/get :bl-osenv-overlay))
  (let [key (IO/chardata_to_string (String/to_charlist key))]
   (local_osenv_key! key 1)
   (Process/put :bl-osenv-overlay (Map/put (Process/get :bl-osenv-overlay) key nil)) :ok)
  (raw_osenv :delete_env (osenv_args key))))
(defn- command_env_opts [opts]
 (let [ov (Process/get :bl-osenv-overlay)]
  (if (erlang/is_map ov)
   (Keyword/put opts :env (Map/to_list (Map/merge ov (Map/new (Keyword/get opts :env (osenv_args)))))) opts)))
(defn os_cmd
 ([command args] (os_cmd command args (osenv_args)))
 ([command args opts] (raw_osenv :cmd (osenv_args command args (command_env_opts opts)))))
(defn os_shell
 ([command] (os_shell command (osenv_args)))
 ([command opts] (raw_osenv :shell (osenv_args command (command_env_opts opts)))))
(defn os_env_call [fun args]
 ;; Called only AFTER RT has checked the original System capability.
 (let [target (case fun :get_env :os_get_env :fetch_env :os_fetch_env
                        :fetch_env! :os_fetch_env! :put_env :os_put_env :delete_env :os_delete_env
                        :cmd :os_cmd :shell :os_shell)]
  (erlang/apply (own-module) target args)))

(defn capture
  "Capture env bindings and explicitly registered process-local scopes as an
   opaque token for `bind/1`. No arbitrary process dictionary is conveyed."
  []
  (maps/put :loader-initialization-blocked (Process/get :bl_loader_initialization_blocked)
  (maps/put :generation (Process/get :bl_generation)
  (maps/put :application-identity (Process/get :bl_application_identity)
  (maps/put :query-functions (Process/get :datom.query.functions/closed)
  (maps/put :loader-ambient (Process/get :bl_ambient_dirs)
  (maps/put :admission (Process/get :bl_admission)
  (maps/put :loader-resolution
    (tuple (Process/get :bl_search_dirs) (Process/get :bl_fixed_dirs) (Process/get :bl_load_paths))
  (maps/put :diagnostics (Process/get :bl_diagnostics)
   (maps/put :osenv (Process/get :bl-osenv-overlay)
   (maps/put :project (Process/get :bl-cli-project)
    (maps/put :env (Process/get :bl_env)
    (maps/put :chain (Process/get :bl_env_chain)
      (maps/put :ns (Process/get :bl_ns)
        (maps/put :caps (Process/get :bl_caps)
          (maps/put :max_heap (Process/get :bl_max_heap) (maps/new)))))))))))))))))

(defn bind
  "Install a token from `capture/0` in the calling process.

   Caps are RE-DERIVED from `caps_of(env)`, never taken from the token: a token
   is a value and can be stale (env destroyed → fail closed) or smuggled across
   a boundary — the registry is the only source of truth."
  [token]
  ;; A Source context is restriction-preserving data for an already admitted
  ;; extent, never a token that native workers can import as execution custody.
  (when (and (erlang/is_map token) (Map/has_key? token :source-context-version))
    (erlang/error :unadmitted_source_context))
  (if (and (erlang/is_map token)
           (maps/is_key :env token) (maps/is_key :chain token) (maps/is_key :ns token)
           (Enum/member? (list nil false true) (Map/get token :loader-initialization-blocked)))
    (let [env (maps/get :env token)
          chain (maps/get :chain token)
          ns (maps/get :ns token)]
      (restore_pdict :bl_env env)
      (restore_pdict :bl_env_chain chain)
      (restore_pdict :bl_ns ns)
      (restore_pdict :bl_caps (if (erlang/== nil env) nil (caps_of env)))
      (restore_pdict :bl_max_heap (Map/get token :max_heap))
      (restore_pdict :bl-osenv-overlay (Map/get token :osenv))
      (restore_pdict :bl-cli-project (Map/get token :project))
      (restore_pdict :bl_generation (Map/get token :generation))
      ;; Ordinary context binding may narrow a restriction, never clear it.
      (restore_pdict :bl_loader_initialization_blocked
        (if (erlang/== true (Process/get :bl_loader_initialization_blocked))
          true (Map/get token :loader-initialization-blocked)))
      (restore_pdict :bl_application_identity (Map/get token :application-identity))
      ;; Closed query authority must follow accepted SDK work just as caps do.
      ;; This is a fixed registered scope, not arbitrary PDict conveyance.
      (restore_pdict :datom.query.functions/closed (Map/get token :query-functions))
      ;; Missing legacy-token fields clear stale worker scopes too.
      (restore_pdict :bl_diagnostics (Map/get token :diagnostics))
      (restore_pdict :bl_admission (Map/get token :admission))
      (restore_pdict :bl_ambient_dirs (Map/get token :loader-ambient))
      (let [roots (Map/get token :loader-resolution)]
        (if (and (erlang/is_tuple roots) (erlang/== 3 (erlang/tuple_size roots)))
          (do (restore_pdict :bl_search_dirs (erlang/element 1 roots))
              (restore_pdict :bl_fixed_dirs (erlang/element 2 roots))
              (restore_pdict :bl_load_paths (erlang/element 3 roots)))
          (do (Process/delete :bl_search_dirs) (Process/delete :bl_fixed_dirs)
              (Process/delete :bl_load_paths))))
      :ok)
    (fce! :bind 1)))

; Fixed SDK ownership is a runtime boundary, separate from an application code
; generation. Only a physically attested generated SDK init can adopt it.
(defn- framework_init_module [pid]
  (let [info (Process/info pid :current_stacktrace)
        frames (when (erlang/is_tuple info) (erlang/element 2 info))
        found (when frames
                (Enum/reduce_while frames nil
                  (fn [frame previous]
                    ;; Skip client GenServer.call frames during collector-side
                    ;; authentication. Only the actual OTP init boundary counts.
                    (if (and (erlang/== :gen_server (erlang/element 1 frame))
                             (Enum/member? (list :init_it :try_init_it) (erlang/element 2 frame)))
                      (tuple :halt previous) (tuple :cont frame)))))]
    (when-not (and (erlang/is_tuple found) (erlang/== 4 (erlang/tuple_size found))
                  (erlang/== :init (erlang/element 2 found))
                  (erlang/== 1 (erlang/element 3 found)))
      (erlang/error :framework_adoption_requires_generated_init))
    (erlang/element 1 found)))

(defn assert_server_init_envelope!
  "Refusal-only native preflight. Actual reserved sealed Source init frames
   require the managed one-shot envelope; raw/nil-G development cannot run that
   class. Prefixes never grant authority: claim_server_start! still authenticates
   the exact native frame and private starter. Ordinary direct/dev calls pass."
  [argument]
  (let [info (Process/info (erlang/self) :current_stacktrace)
        frames (when (and (erlang/is_tuple info) (erlang/== 2 (erlang/tuple_size info)))
                 (erlang/element 2 info))]
    (when-not (erlang/is_list frames) (erlang/error :server_init_frame_unavailable))
    (let [reserved? (fn [module]
                     (and (erlang/is_atom module)
                          (String/starts_with? (erlang/atom_to_binary module :utf8)
                                               "Elixir.BeamLisp.Server.Sealed.")))
          sealed-frame? (Enum/any? frames
            (fn [frame]
              (and (erlang/is_tuple frame) (erlang/== 4 (erlang/tuple_size frame))
                   (reserved? (erlang/element 1 frame))
                   (erlang/== :init (erlang/element 2 frame))
                   (erlang/== 1 (erlang/element 3 frame)))))]
      (when sealed-frame?
        ;; Reflection failure with a known sealed init is refusal, never the
        ;; ordinary unmanaged passthrough path. No caller supplies the module.
        (let [module (try (framework_init_module (erlang/self)) (catch _ nil))]
          (when-not (and (reserved? module)
                        (erlang/is_tuple argument) (erlang/== 5 (erlang/tuple_size argument))
                        (erlang/== :"$bl_conveyed_generation" (erlang/element 1 argument))
                        (erlang/== module (erlang/element 3 argument)))
            (erlang/error :unadmitted_server_starter)))))) :ok)

(defn verify_supervisor_init! [pid]
  (let [info (Process/info pid :current_stacktrace)
        frames (when (erlang/is_tuple info) (erlang/element 2 info))
        found (when frames (Enum/reduce_while frames nil
                (fn [frame previous]
                  (if (and (erlang/== :supervisor (erlang/element 1 frame))
                           (erlang/== :init (erlang/element 2 frame)))
                    (tuple :halt previous) (tuple :cont frame)))))]
    (when-not (and found (erlang/== :Elixir.BeamLisp.Supervisor (erlang/element 1 found))
                  (erlang/== :init (erlang/element 2 found)) (erlang/== 1 (erlang/element 3 found)))
      (erlang/error :unattested_supervisor_init)) true))

; Native starter receipts: Env owns pending physical custody. Guardian death
; cannot release it. A captured Env token contains NONE of these capabilities.
(defn- server_start_key [ticket] (tuple :bl_server_start ticket))
(defn- server_start_row [ticket]
  (if (erlang/== (erlang/self) (Process/whereis (own-module)))
    (let [rows (ets/lookup :beam_lisp_server_starts (server_start_key ticket))]
      (when (erlang/== 1 (erlang/length rows)) (erlang/element 2 (erlang/hd rows))))
    (server_start_turn (fn [] (server_start_row ticket)))))
(defn- server_start_turn [action]
  (let [result (Agent/get (own-module)
                 (fn [_] (try (tuple :ok (invoke_action action))
                           (catch error (tuple :error __EXCEPTION_KIND__ error __STACKTRACE__)))) :infinity)]
    (if (erlang/== :ok (erlang/element 1 result)) (erlang/element 2 result)
      (erlang/raise (erlang/element 2 result) (erlang/element 3 result) (erlang/element 4 result)))))
(defn- server_start_forget! [row]
  ;; Only Env's serialized decision calls this. Never forget an unknown launch
  ;; because its creator or guardian died. This releases CODE custody only.
  (release_code! (Map/get row :custody))
  (ets/delete :beam_lisp_server_starts (server_start_key (Map/get row :ticket))) :ok)
(defn- server_start_departed! [ticket pid]
  (server_start_turn (fn []
    ;; Even an internal guardian notification is not a caller-supplied death
    ;; boolean. Recheck native local process state before releasing any code.
    (when-not (and (erlang/is_pid pid) (erlang/== (erlang/node pid) (erlang/node))
                  (erlang/not (erlang/is_process_alive pid)))
      (erlang/error :server_start_owner_still_alive))
    (let [row (server_start_row ticket)]
      (when row
        (cond
          (and (erlang/== pid (Map/get row :creator))
               (erlang/== :pending (Map/get row :phase))) (server_start_forget! row)
          (erlang/== pid (Map/get row :child)) (server_start_forget! row)
          (and (erlang/== pid (Map/get row :creator)) (erlang/== nil (Map/get row :child)))
            (ets/insert :beam_lisp_server_starts
              (tuple (server_start_key ticket) (Map/put row :phase :uncertain)))))))))
(defn- server_start_guardian [ticket creator]
  (let [parent-ref (erlang/monitor :process creator)]
    (erlang/send creator (tuple :bl_server_start_ready ticket (erlang/self)))
    (server_start_watch ticket creator parent-ref nil nil)))
(defn- server_start_watch [ticket creator parent-ref child child-ref]
  (receive
    [:bl_server_start_claimed seen pid] :when (= seen ticket)
      (if (erlang/== nil child)
        (server_start_watch ticket creator parent-ref pid (erlang/monitor :process pid))
        (server_start_watch ticket creator parent-ref child child-ref))
    [:bl_server_start_finished seen] :when (= seen ticket) :ok
    [:DOWN seen :process pid _]
      (cond
        (and (erlang/== seen parent-ref) (erlang/== pid creator))
          (do (server_start_departed! ticket creator)
              ;; Launching may still produce a genuine child after caller death.
              (if (or (server_start_row ticket) (server_init_exists? ticket))
                (server_start_watch ticket creator parent-ref child child-ref) :ok))
        (and (erlang/== seen child-ref) (erlang/== pid child))
          (do (server_start_departed! ticket child) (server_init_departed! ticket child))
        :else (server_start_watch ticket creator parent-ref child child-ref))))
(defn assert_managed_server_class! [generation module]
  ;; Shared preflight and admission: graph membership alone is not a class.
  (when-not (executing_generation? generation) (erlang/error :unadmitted_server_starter))
  (if (Enum/member? (Map/get generation :modules) module)
    (when-not (and (Map/get generation :server-classes)
                  (BeamLisp.Set/member? (Map/get generation :server-classes) module))
      (erlang/error :unattested_server_class))
    (BeamLisp.AOT/sdk_class_evidence! module)) true)
(defn- begin_native_start!
  "Internal native start admission. Exact current executing G, immutable
   starter/attempt, one-shot capability and Env-owned full graph custody BEFORE
   OTP start. The caller still performs start_link itself, preserving links."
  [module kind]
  (let [generation (Process/get :bl_generation)]
    (when-not (executing_generation? generation) (erlang/error :unadmitted_server_starter))
    (when-not (Enum/member? (list :server :supervisor) kind) (erlang/error :invalid_native_start_kind))
    (if (erlang/== :supervisor kind)
      (do
        (when-not (erlang/== :Elixir.BeamLisp.Supervisor module) (erlang/error :unattested_supervisor_class))
        (BeamLisp.AOT/sdk_callable_evidence! (erlang/make_fun module :init 1)))
      (assert_managed_server_class! generation module))
    (let [creator (erlang/self) ticket (erlang/make_ref) context (capture)
          guardian (erlang/spawn (fn [] (server_start_guardian ticket creator)))]
      (receive
        [:bl_server_start_ready seen pid] :when (and (= seen ticket) (= pid guardian)) :ready
        (after 5000 (do (erlang/send guardian (tuple :bl_server_start_finished ticket))
                        (erlang/error :server_start_guardian_unavailable))))
      (try
        (server_start_turn (fn []
          (let [size (ets/info :beam_lisp_server_starts :size)]
            (when-not (and (erlang/is_integer size) (erlang/>= size 0) (erlang/< size 4096))
              (erlang/error :server_start_capacity)))
          (when-not (and (erlang/is_process_alive creator) (erlang/is_process_alive guardian))
            (erlang/error :server_start_creator_unavailable))
          (let [custody (retain_code! (BeamLisp.Vector/to_list (Map/get generation :modules)))
                row {:ticket ticket :guardian guardian :creator creator :attempt (erlang/make_ref)
                     :module module :kind kind :generation generation :context context :custody custody
                     :phase :pending :child nil :creator-chain (owned_start_creator_chain creator)}]
            (ets/insert :beam_lisp_server_starts (tuple (server_start_key ticket) row)))))
        (tuple :bl_server_start guardian ticket)
        (catch error
          (erlang/send guardian (tuple :bl_server_start_finished ticket))
          (erlang/raise __EXCEPTION_KIND__ error __STACKTRACE__))))))
(defn begin_server_start! [module] (begin_native_start! module :server))
(defn begin_supervisor_start! [] (begin_native_start! :Elixir.BeamLisp.Supervisor :supervisor))

(defn- server_start_cap_row! [capability]
  (when-not (and (erlang/is_tuple capability) (erlang/== 3 (erlang/tuple_size capability))
                (erlang/== :bl_server_start (erlang/element 1 capability))
                (erlang/is_pid (erlang/element 2 capability))
                (erlang/is_reference (erlang/element 3 capability)))
    (erlang/error :invalid_server_start_ticket))
  (let [row (server_start_row (erlang/element 3 capability))]
    (when-not (and row (erlang/== (Map/get row :guardian) (erlang/element 2 capability)))
      (erlang/error :invalid_server_start_ticket)) row))
(defn launch_server_start! [capability]
  (let [creator (erlang/self) generation (Process/get :bl_generation)]
    (when-not (executing_generation? generation) (erlang/error :unadmitted_server_starter))
    (server_start_turn (fn []
      (let [row (server_start_cap_row! capability)]
        (when-not (and (erlang/== creator (Map/get row :creator))
                      (erlang/== generation (Map/get row :generation))
                      (erlang/== :pending (Map/get row :phase)))
          (erlang/error :invalid_server_start_ticket))
        (ets/insert :beam_lisp_server_starts
          (tuple (server_start_key (Map/get row :ticket)) (Map/put row :phase :launching))))))))
(defn- claim_native_start!
  "One-shot generated-init prelude, BEFORE binding context or user code.
   A copied old envelope, scope, graph, or genuine class is not this ticket."
  [capability module kind]
  (let [child (erlang/self)
        result (server_start_turn (fn []
          (let [row (server_start_cap_row! capability)]
            (when-not (and (erlang/== module (Map/get row :module))
                          (erlang/== kind (Map/get row :kind))
                          (erlang/== nil (Map/get row :child))
                          (Enum/member? (list :launching :uncertain) (Map/get row :phase))
                          (code_lease_active? (Map/get row :custody)))
              (erlang/error :invalid_server_start_ticket))
            (let [claimed (Map/put (Map/put row :child child) :phase :claimed)]
              (ets/insert :beam_lisp_server_starts (tuple (server_start_key (Map/get row :ticket)) claimed))
              claimed))))]
    (Process/put :bl_server_start_receipt
      (Map/take result (list :ticket :creator :attempt :module :child :kind)))
    (erlang/send (Map/get result :guardian)
      (tuple :bl_server_start_claimed (Map/get result :ticket) child))
    (Map/get result :context)))
(defn claim_server_start! [capability module]
  (verify_server_start! module) (claim_native_start! capability module :server))
(defn claim_supervisor_start! [capability]
  (verify_supervisor_init! (erlang/self))
  (claim_native_start! capability :Elixir.BeamLisp.Supervisor :supervisor))

(defn- native_start_receipt!
  "Read-only exact pending starter evidence for native owner admission. No
   transferable startup capability is returned or included in Env capture."
  [module kind]
  (let [receipt (Process/get :bl_server_start_receipt)
        row (when receipt (server_start_row (Map/get receipt :ticket)))]
    (when-not (and row (erlang/== :claimed (Map/get row :phase))
                  (erlang/== kind (Map/get row :kind))
                  (erlang/== (erlang/self) (Map/get row :child))
                  (erlang/== module (Map/get row :module))
                  (erlang/== receipt (Map/take row (list :ticket :creator :attempt :module :child :kind)))
                  (erlang/== (Process/get :bl_generation) (Map/get row :generation))
                  (code_lease_active? (Map/get row :custody)))
      (erlang/error :invalid_server_starter_receipt)) receipt))
(defn server_start_receipt! [module]
  (verify_server_start! module) (native_start_receipt! module :server))
(defn supervisor_start_receipt! []
  (verify_supervisor_init! (erlang/self))
  (native_start_receipt! :Elixir.BeamLisp.Supervisor :supervisor))

(defn- verify_native_starter! [child module receipt generation kind]
  (let [row (when (erlang/is_map receipt) (server_start_row (Map/get receipt :ticket)))]
    (when-not (and row (erlang/== :claimed (Map/get row :phase))
                  (erlang/== kind (Map/get row :kind))
                  (erlang/== child (Map/get row :child)) (erlang/== module (Map/get row :module))
                  (erlang/== receipt (Map/take row (list :ticket :creator :attempt :module :child :kind)))
                  (erlang/== generation (Map/get row :generation))
                  (code_lease_active? (Map/get row :custody)))
      (erlang/error :invalid_server_starter_receipt)) true))
(defn verify_server_starter! [child module receipt generation]
  (verify_native_starter! child module receipt generation :server))

(defn- complete_native_start!
  "Handoff pending Env custody only AFTER actual monitored native membership
   and the child's exact whole-G lease exist. Lost acknowledgements retain code."
  [module kind]
  (let [receipt (native_start_receipt! module kind) child (erlang/self)]
    (server_start_turn (fn []
      (let [row (server_start_row (Map/get receipt :ticket))
            entries (ets/lookup :beam_lisp_vars (tuple :bl_generation_owner child))
            native (when (erlang/== 1 (erlang/length entries)) (erlang/element 2 (erlang/hd entries)))
            lease (when native (Map/get native :lease))]
        (when-not (and row native (erlang/== kind (Map/get native :kind))
                      (erlang/== receipt (Map/get native :starter))
                      (erlang/== module (Map/get native :module))
                      (erlang/== child (erlang/element 2 lease)) (code_lease_active? lease)
                      (erlang/== (Enum/sort (BeamLisp.Vector/to_list
                                            (Map/get (Map/get row :generation) :modules)))
                                 (erlang/element 1 lease)))
          (erlang/error :server_start_handoff_unconfirmed))
        (retained_server_start! row native)
        (server_start_forget! row)
        (when (or (erlang/not (erlang/== :server kind))
                  (erlang/== nil (server_init_row (Map/get row :ticket))))
          (erlang/send (Map/get row :guardian) (tuple :bl_server_start_finished (Map/get row :ticket)))))))))
(defn complete_server_start! [module]
  (verify_server_start! module) (complete_native_start! module :server))
(defn complete_supervisor_start! []
  (verify_supervisor_init! (erlang/self))
  (complete_native_start! :Elixir.BeamLisp.Supervisor :supervisor))

(defn finish_server_start!
  "Internal OTP result observation. A native duplicate-name response creates
   no child. Other unclaimed results/exceptions retain unknown physical custody;
   a claimed child is released only on exact lease handoff or actual DOWN."
  [capability result]
  (let [creator (erlang/self)]
    (server_start_turn (fn []
      (let [row (server_start_row (erlang/element 3 capability))]
        (when row
          (when-not (erlang/== creator (Map/get row :creator))
            (erlang/error :invalid_server_start_ticket))
          (if (and (erlang/== nil (Map/get row :child))
                   (erlang/is_tuple result) (erlang/== 2 (erlang/tuple_size result))
                   (erlang/== :error (erlang/element 1 result))
                   (erlang/is_tuple (erlang/element 2 result))
                   (erlang/== 2 (erlang/tuple_size (erlang/element 2 result)))
                   (erlang/== :already_started (erlang/element 1 (erlang/element 2 result)))
                   (erlang/is_pid (erlang/element 2 (erlang/element 2 result))))
            (do (server_start_forget! row)
                (erlang/send (Map/get row :guardian)
                  (tuple :bl_server_start_finished (Map/get row :ticket))))
            (when (erlang/== nil (Map/get row :child))
              (ets/insert :beam_lisp_server_starts
                (tuple (server_start_key (Map/get row :ticket)) (Map/put row :phase :uncertain)))))))))))

(defn server_start_observation
  "Bounded read-only pending observation. No token, context, generation value
   or native lease handle is returned. Absence is not effect-completion proof."
  [ticket]
  (server_start_turn (fn []
    (let [row (server_start_row ticket)]
      (when row
        (Map/merge (Map/take row (list :phase :creator :child :module :attempt))
          {:custody-owner (erlang/element 2 (Map/get row :custody))
           :retained (code_lease_active? (Map/get row :custody))}))))))

(defn verify_server_start!
  "Reject a forged conveyed module before binding any supplied context."
  [module]
  (when-not (erlang/== module (framework_init_module (erlang/self)))
    (erlang/error :conveyed_server_class_mismatch))
  true)

(defn verify_native_registration!
  "Authenticate native server/supervisor admission from the actual waiting
   creator, its selected generation and exact live lease. A claimed map alone
   cannot publish native ownership evidence."
  [caller entry]
  (let [native (Map/get entry :native-evidence) pid (Map/get entry :pid)
        lease (Map/get native :lease) kind (Map/get entry :kind)
        dictionary-info (Process/info caller :dictionary)
        dictionary (when (erlang/is_tuple dictionary-info) (erlang/element 2 dictionary-info))
        generation (when dictionary (Keyword/get dictionary :bl_generation))]
    (when-not (and native generation (erlang/== caller (Map/get native :registrar))
                  (Enum/member? (list :server :supervisor) kind)
                  (erlang/== kind (Map/get native :kind))
                  (erlang/== (Map/get generation :digest) (Map/get native :generation))
                  (erlang/== (Map/get generation :application-id) (Map/get entry :application-id))
                  (erlang/== (Map/get entry :application-id) (Map/get native :application-id))
                  (erlang/is_tuple lease) (erlang/== 3 (erlang/tuple_size lease))
                  (erlang/== pid (erlang/element 2 lease))
                  (erlang/== (Map/get entry :proof-id) (erlang/element 3 lease))
                  (code_lease_active? lease)
                  (Enum/all? (Map/get generation :modules)
                    (fn [module] (Enum/member? (erlang/element 1 lease) module))))
      (erlang/error :invalid_native_owner_registration))
    (if (erlang/== :server kind)
      (let [module (Map/get native :module)]
        (verify_server_starter! caller module (Map/get native :starter) generation)
        (when-not (and (erlang/== caller pid) (erlang/== module (framework_init_module caller)))
          (erlang/error :invalid_server_registration))
        (when-not (Enum/member? (Map/get generation :modules) module)
          (BeamLisp.AOT/sdk_class_evidence! module)))
      (do
        (when-not (and (erlang/== caller pid)
                      (erlang/== :Elixir.BeamLisp.Supervisor (Map/get native :module)))
          (erlang/error :invalid_supervisor_registration))
        (verify_supervisor_init! caller)
        (verify_native_starter! caller :Elixir.BeamLisp.Supervisor
          (Map/get native :starter) generation :supervisor)
        (BeamLisp.AOT/sdk_callable_evidence!
          (erlang/make_fun :Elixir.BeamLisp.Supervisor :init 1))))
    true))

(defn- supervisor_membership_live? [native membership]
  (let [rows (ets/lookup :beam_lisp_owner_index (Map/get membership :key))
        entry (when (erlang/== 1 (erlang/length rows)) (erlang/element 2 (erlang/hd rows)))
        evidence (when entry (Map/get entry :native-evidence))]
    (and entry (erlang/== :supervisor (Map/get entry :kind))
         (erlang/== (erlang/self) (Map/get entry :pid))
         (erlang/== membership (Map/take entry (list :key :ticket :pid :application-id :kind :proof-id)))
         (erlang/not (ets/member :beam_lisp_owner_revisions (tuple :closed (Map/get membership :ticket))))
         (erlang/== (Map/get native :lease) (Map/get evidence :lease))
         (erlang/== (Map/get native :starter) (Map/get evidence :starter))
         (erlang/== (Map/get native :generation) (Map/get evidence :generation)))))
(defn install_supervisor_execution! [lease]
  (verify_supervisor_init! (erlang/self))
  (let [generation (Process/get :bl_generation) scope (env_id)
        rows (ets/lookup :beam_lisp_vars (tuple :bl_generation_owner (erlang/self)))
        native (when (erlang/== 1 (erlang/length rows)) (erlang/element 2 (erlang/hd rows)))
        membership (when native (Map/get native :membership))]
    (when-not (and native (erlang/== :supervisor (Map/get native :kind))
                  (erlang/== scope (Map/get generation :scope))
                  (erlang/== lease (Map/get native :lease))
                  (erlang/== (erlang/self) (erlang/element 2 lease))
                  (erlang/== (Enum/sort (BeamLisp.Vector/to_list (Map/get generation :modules)))
                             (erlang/element 1 lease))
                  (supervisor_membership_live? native membership))
      (erlang/error :unattested_supervisor_execution))
    (Process/put :bl_supervisor_execution_owner
      (tuple generation scope :Elixir.BeamLisp.Supervisor lease membership (erlang/hd (erlang/element 1 lease))))
    (ets/insert :beam_lisp_vars (tuple (server_ticket_key lease) true)) :ok))
(defn with_supervisor_execution!
  "Only the actual native indexed supervisor owner can start/restart children.
   Reuse its exact full graph ticket; captured child-spec context is not proof."
  [action]
  (let [owner (Process/get :bl_supervisor_execution_owner)
        generation (Process/get :bl_generation)]
    (when-not (and (erlang/is_tuple owner) (erlang/== 6 (erlang/tuple_size owner))
                  (erlang/== generation (erlang/element 1 owner))
                  (erlang/== (env_id) (erlang/element 2 owner)))
      (erlang/error :unattested_supervisor_execution))
    (let [lease (erlang/element 4 owner)
          rows (ets/lookup :beam_lisp_vars (tuple :bl_generation_owner (erlang/self)))
          native (when (erlang/== 1 (erlang/length rows)) (erlang/element 2 (erlang/hd rows)))]
      (when-not (and native (erlang/== lease (Map/get native :lease))
                    (supervisor_membership_live? native (erlang/element 5 owner))
                    (sdk_runtime_retained_modules? (list :Elixir.BeamLisp.Supervisor)))
        (erlang/error :released_supervisor_execution))
      (with_owned_code_execution lease (fn [] (with_owned_generation_execution action))))))

(defn verify_framework_registration!
  "Collector-side authentication. A public first-order evidence map is not a
   credential: inspect the actual waiting init process and the fixed SDK bytes."
  [pid evidence]
  (let [module (Map/get evidence :module) declaration (Map/get evidence :declaration)
        lease (Map/get evidence :lease) info (Process/info pid :dictionary)
        dictionary (when (erlang/is_tuple info) (erlang/element 2 info))
        generation (when dictionary (Keyword/get dictionary :bl_generation))
        app (when generation (Map/get generation :application-id))
        initializer (Map/get evidence :initializer)
        monitors (Process/info pid :monitors)]
    (when-not (and (erlang/is_map evidence)
                  (erlang/== (Enum/sort (Map/keys evidence))
                    (Enum/sort (list :kind :application-id :origin-generation :module :declaration
                                     :artifact :initializer :monitor :lease)))
                  (erlang/== :framework (Map/get evidence :kind))
                  (erlang/is_reference (Map/get evidence :monitor))
                  (erlang/is_pid initializer) (erlang/is_process_alive initializer)
                  (erlang/is_tuple monitors)
                  (Enum/member? (erlang/element 2 monitors) (tuple :process initializer))
                  (or (erlang/== nil (Map/get evidence :origin-generation))
                      (erlang/is_binary (Map/get evidence :origin-generation)))
                  (erlang/is_pid pid) (erlang/== (erlang/node pid) (erlang/node))
                  (erlang/is_process_alive pid) (erlang/== module (framework_init_module pid))
                  (erlang/is_tuple declaration) (erlang/== 2 (erlang/tuple_size declaration))
                  (erlang/== app (Map/get evidence :application-id))
                  (erlang/is_tuple lease) (erlang/== 3 (erlang/tuple_size lease))
                  (erlang/== (list module) (erlang/element 1 lease))
                  (erlang/== pid (erlang/element 2 lease)) (code_lease_active? lease))
      (erlang/error :unattested_framework_registration))
    (let [proof (BeamLisp.AOT/sdk_declaration_evidence!
                  (erlang/element 1 declaration) (erlang/element 2 declaration) module)
          owner (Map/fetch! (Map/fetch! proof :artifact) :definition-env)
          binding (ets/lookup :beam_lisp_vars (pfx owner declaration))]
      (when-not (and (erlang/== (Map/get evidence :artifact) (Map/get proof :artifact))
                    (erlang/== :global owner)
                    (erlang/== 1 (erlang/length binding))
                    (erlang/== module (erlang/element 2 (erlang/hd binding))))
        (erlang/error :invalid_framework_declaration_owner)))
    true))

(defn sdk_forwarder_current?
  "Read-only proof that the installed mutable surface preserves the protected
   SDK routes. Proofs are published only after the generated-code fence checked
   actual BEAM instructions, and never expose executable callbacks/capabilities."
  [mod routes]
  (let [rows (ets/lookup :beam_lisp_vars (tuple :bl_sdk_forwarder_current mod))
        proof (when (erlang/not (erlang/== rows (list))) (erlang/element 2 (erlang/hd rows)))]
    (and proof (erlang/module_loaded mod)
         (erlang/== (Map/get proof :md5) (erlang/apply mod :module_info (list :md5)))
         (Enum/all? routes
           (fn [entry] (erlang/== (erlang/element 2 entry)
                         (Map/get (Map/get proof :routes) (erlang/element 1 entry))))))))

; One private, bounded cache of canonical discovery. A hit still checks current
; source bytes, code MD5s, native libraries, producer inputs and receipt rows.
; No caller supplies cached evidence or a discovery callback.
(defn- sdk_inventory_file_digests
 "(seed-manifest sha256, sdk-code.term read result) for `root`, re-read only
  when either file's size or mtime moved. Both files are immutable for an
  installed image; re-reading and hashing them twice per library load was a
  measurable share of every cold namespace load."
 [root]
 (let [seed-path (Path/join (BeamLisp.Bootstrap/seed_dir) "manifest.term")
       image-path (Path/join root "sdk-code.term")
       stamp (fn [p] (let [r (file/read_file_info p (list (tuple :time :posix)))]
                       (when (erlang/== :ok (elem r 0)) (tuple (elem (elem r 1) 1) (elem (elem r 1) 5)))))
       key (tuple root (stamp seed-path) (stamp image-path))
       hit (persistent_term/get :bl_sdk_inventory_files nil)]
  (if (and hit (= key (elem hit 0))) (elem hit 1)
   (let [value (tuple (crypto/hash :sha256 (File/read! seed-path)) (File/read image-path))]
    (persistent_term/put :bl_sdk_inventory_files (tuple key value))
    value))))

;; SDK receipt rows (`{:bl_sdk_emission m}`, `{:bl_sdk_native_host m}`) are
;; insert-only and published in exactly two places, which bump this revision
;; AFTER inserting. `beam_lisp_vars` is the large shared table, so a
;; match_object over it scans every row; the certificate used to do two such
;; scans per check, twice per library load. Rows read under revision r are
;; reused while the revision is still r. A writer that inserts without bumping
;; would make this stale, so the bump lives next to the only two inserts.
(defn- toolchain_input_stamp
 "phash2 of (path, size, mtime) for every file that can feed the compiler or
  build key: .bl under priv/boot, priv/self, priv/host and priv/build, and .ex
  under the checkout's lib/. Stamping ~250 files is far cheaper than reading
  and hashing their contents."
 []
 (let [priv (BeamLisp.Tiers/priv_root)
       anchor (or (System/get_env "BL_ROOT") (System/cwd))
       paths (Enum/sort (erlang/++ (Path/wildcard (Path/join priv "{boot,self,build}/**/*.bl"))
                          (erlang/++ (Path/wildcard (Path/join priv "host/*.bl"))
                                     (Path/wildcard (Path/join anchor "lib/**/*.ex")))))]
  (erlang/phash2 (Enum/map paths
    (fn [p] (let [r (prim_file/read_file_info p (list (tuple :time :posix)))]
              (if (erlang/== :ok (elem r 0))
                (tuple p (elem (elem r 1) 1) (elem (elem r 1) 5)) (tuple p nil))))))))

(defn live_toolchain_keys
 "{live compiler key, live build key}: `AOTCache/current_compiler_key` and
  `current_build_key` (which re-read and hash every toolchain source),
  recomputed only when `toolchain_input_stamp` moves. Library loading asks for
  these several times per namespace; a toolchain edit changes a stamp."
 []
 (let [stamp (toolchain_input_stamp)
       hit (persistent_term/get :bl_live_toolchain_keys nil)]
  (if (and hit (erlang/== stamp (elem hit 0))) (elem hit 1)
   (let [keys (tuple (BeamLisp.AOTCache/current_compiler_key) (BeamLisp.AOTCache/current_build_key))]
    (persistent_term/put :bl_live_toolchain_keys (tuple stamp keys))
    keys))))

(defn- live_compiler_key [] (elem (live_toolchain_keys) 0))

(defn bump_sdk_receipt_revision! []
 (ets/update_counter :beam_lisp_vars :bl_sdk_receipt_revision (tuple 2 1)
   (tuple :bl_sdk_receipt_revision 0)))

(defn- sdk_receipt_revision []
 (let [rows (ets/lookup :beam_lisp_vars :bl_sdk_receipt_revision)]
  (if (erlang/== rows (list)) 0 (elem (erlang/hd rows) 1))))

(defn sdk_receipt_rows
 "Every SDK emission and native-host receipt row, sorted. Rescanned only when
  a receipt was published since the last read."
 []
 (let [revision (sdk_receipt_revision)
       hit (persistent_term/get :bl_sdk_receipt_rows nil)]
  (if (and hit (erlang/== revision (elem hit 0))) (elem hit 1)
   (let [rows (Enum/sort (erlang/++
                (ets/match_object :beam_lisp_vars (tuple (tuple :bl_sdk_emission :_) :_))
                (ets/match_object :beam_lisp_vars (tuple (tuple :bl_sdk_native_host :_) :_))))]
    ;; Only remember rows if no publication raced the scan.
    (when (erlang/== revision (sdk_receipt_revision))
     (persistent_term/put :bl_sdk_receipt_rows (tuple revision rows)))
    rows))))

(defn- sdk_inventory_certificate []
 (try
  (let [generation (code_evidence_generation)
        root (BeamLisp.AOT/physical_sdk_path (BeamLisp.Tiers/priv_root))
        files (sdk_inventory_file_digests root)
        image (elem files 1)
        loaded (Enum/sort (Enum/map (code/all_loaded)
                  (fn [entry]
                   (let [module (elem entry 0)]
                    (tuple module (erlang/apply module :module_info (list :md5)))))))
        receipts (sdk_receipt_rows)]
   (when (and generation (= generation (code_evidence_generation)))
    (tuple root (live_compiler_key) (elem files 0)
           image generation loaded receipts)))
  (catch _ nil)))

(defn- sdk_inventory_sources_current? [root inventory]
 (try
  (and
   (Enum/all? (elem inventory 1)
    (fn [entry]
     (= (elem entry 1) (crypto/hash :sha256
                         (BeamLisp.Loader/read_source (Path/join root (elem entry 0)))))))
   (do
    (Enum/each
     (ets/match_object :beam_lisp_vars (tuple (tuple :bl_sdk_native_host :_) :_))
     (fn [row] (BeamLisp.AOT/sdk_native_dependency! (elem (elem row 0) 1))))
    true))
  (catch _ false)))

(defn sdk_runtime_inventory_cached!
 "Native canonical discovery cache. Current bytes/code/receipts are checked
  on every use; changed inputs take the original complete verifier."
 []
 (let [before (sdk_inventory_certificate)
       cached (source_private (fn []
                (let [rows (ets/lookup :beam_lisp_source_lease_domains :sdk_inventory_cache)]
                 (when-not (= rows (list)) (elem (erlang/hd rows) 1)))))
       hit (and before cached (= before (elem cached 0))
                (sdk_inventory_sources_current? (elem before 0) (elem cached 1))
                (= before (sdk_inventory_certificate)))]
  (if hit (elem cached 1)
   (let [inventory (BeamLisp.AOT/sdk_runtime_inventory! true)
         after (sdk_inventory_certificate)]
    (when (and before (= before after))
     (source_private (fn []
      (ets/insert :beam_lisp_source_lease_domains
       (tuple :sdk_inventory_cache (tuple after inventory))))))
    inventory))))

(defn- retain_sdk_runtime! []
  ;; Verification stays outside Env's Agent: source/cache resolution reads Env.
  ;; Only the bounded lease/index mutation executes in the stable runtime owner.
  (when-not (ets/member :beam_lisp_vars :bl_sdk_runtime_lease)
    (with_env :global (fn [] (BeamLisp.AOT/bootstrap_sdk_native_hosts!))))
  (let [inventory (with_env :global (fn [] (sdk_runtime_inventory_cached!))) current (erlang/element 1 inventory)
        current_sources (erlang/element 2 inventory)
        current_forwarders (erlang/element 3 inventory)
        current_targets (erlang/element 4 inventory)
        result (Agent/get (own-module)
      (fn [_state]
        (try
         (tuple :ok
          (let [key :bl_sdk_runtime_lease prior_row (ets/lookup :beam_lisp_vars key)
                prior (when (erlang/not (erlang/== (list) prior_row)) (erlang/element 2 (erlang/hd prior_row)))
                _ (when (and prior (erlang/not (erlang/is_map (Map/get prior :sources))))
                    (erlang/error :sdk_runtime_replacement_requires_handover))
                sources (Map/merge (if prior (Map/get prior :sources) {}) current_sources
                          (fn [_ old new]
                            (when (erlang/not (erlang/== old new))
                              (erlang/error :sdk_runtime_replacement_requires_handover)) old))
                modules (Map/merge (if prior (Map/get prior :modules) {}) current
                          (fn [_ old new]
                            (when (erlang/not (erlang/== old new)) (erlang/error :sdk_runtime_replacement_requires_handover)) old))
                forwarders (Map/merge (if prior (Map/get prior :forwarders {}) {}) current_forwarders
                             (fn [_ old new]
                               (when (erlang/not (erlang/== (Map/get old :namespace) (Map/get new :namespace)))
                                 (erlang/error :sdk_forwarder_owner_changed))
                               (Map/put old :routes (Map/merge (Map/get old :routes) (Map/get new :routes)
                                 (fn [_ old_target new_target]
                                   (when (erlang/not (erlang/== old_target new_target))
                                     (erlang/error :sdk_forwarder_route_changed)) old_target)))))]
            (with_module_locks (Enum/sort (Enum/uniq (erlang/++ (Map/keys modules) (Map/keys forwarders))))
              (fn []
                (Enum/each modules
                  (fn [entry]
                    (when-not (and (erlang/module_loaded (erlang/element 1 entry))
                                  (erlang/== (erlang/element 2 entry)
                                    (erlang/apply (erlang/element 1 entry) :module_info (list :md5))))
                      (erlang/error :sdk_runtime_loaded_code_changed))))
                (Enum/each forwarders
                  (fn [entry]
                    (let [mod (erlang/element 1 entry) proof (erlang/element 2 entry)]
                      (when-not (and (erlang/module_loaded mod)
                                    (or (erlang/== (Map/get proof :md5) (erlang/apply mod :module_info (list :md5)))
                                      (sdk_forwarder_current? mod (Map/get proof :routes))))
                        (erlang/error :sdk_runtime_forwarder_changed)))))
                (let [unchanged (and prior (erlang/== modules (Map/get prior :modules))
                                     (code_lease_active? (Map/get prior :lease)))
                      next (if unchanged (Map/get prior :lease) (retain_code! (Map/keys modules)))]
                  ;; These rows are bounded by the authoritative SDK inventory.
                  ;; They are first-order code evidence, never PID owner state.
                  (ets/insert :beam_lisp_vars
                    (Enum/map forwarders
                      (fn [entry]
                        (let [mod (erlang/element 1 entry) proof (erlang/element 2 entry)]
                          (tuple (tuple :bl_sdk_forwarder_current mod)
                            {:md5 (erlang/apply mod :module_info (list :md5)) :routes (Map/get proof :routes)})))))
                  (source_ensure_private!)
                  ;; Publication is already inside actual Env ownership and
                  ;; the checked code fences. New rows only extend the exact
                  ;; inventory; collisions can narrow public access, never widen.
                  (Enum/each (Map/get current_targets :modules)
                    (fn [entry]
                      (let [mod (elem entry 0) metadata (elem entry 1)]
                        (ets/insert :beam_lisp_source_extent_heads
                          (tuple (tuple :source_sdk_module mod) (Map/drop metadata (list :lambda-routes))))
                        (Enum/each (Map/get metadata :ctor-lambda-origins {})
                          (fn [ctor] (ets/insert :beam_lisp_source_extent_heads
                            (tuple (tuple :source_sdk_ctor_lambda mod (elem ctor 0)) (elem ctor 1)))))
                        (Enum/each (Map/get metadata :lambda-routes {})
                          (fn [lambda]
                            (ets/insert :beam_lisp_source_extent_heads
                              (tuple (tuple :source_sdk_lambda mod (elem lambda 0)) (elem lambda 1))))))))
                  (Enum/each (Map/get current_targets :bindings)
                   (fn [entry]
                    (ets/insert :beam_lisp_source_extent_heads
                     (tuple (tuple :source_sdk_binding (elem (elem entry 0) 0) (elem (elem entry 0) 1)) (elem entry 1)))))
                  (Enum/each (Map/get current_targets :classes)
                    (fn [entry] (ets/insert :beam_lisp_source_extent_heads
                       (tuple (tuple :source_sdk_class (elem entry 0)) (elem entry 1)))))
                  (Enum/each (Map/get current_targets :targets)
                    (fn [entry]
                      (let [mfa (elem entry 0) id (tuple :source_sdk_target (elem mfa 0) (elem mfa 1) (elem mfa 2))
                            old (source_policy_row id) kind (elem entry 1)]
                        (ets/insert :beam_lisp_source_extent_heads
                          (tuple id (if (and old (not= :public old)) :private kind))))))
                  (Enum/each (Map/get current_targets :names)
                    (fn [entry]
                      (let [name (elem entry 0) id (tuple :source_sdk_name (elem name 0) (elem name 1))
                            old (source_policy_row id) kind (elem entry 1)]
                        (ets/insert :beam_lisp_source_extent_heads
                          (tuple id (if (and old (not= :public old)) :private kind))))))
                  ;; Replace this fixed contract on every authenticated SDK
                  ;; publication; an old receipt cannot leave a stale exemption.
                  (ets/delete :beam_lisp_source_extent_heads
                    (tuple :source_inert_argument (tuple :Elixir.BeamLisp.Ns.Rt :reduced? 1)))
                  (Enum/each (Map/get current_targets :inert-arguments {})
                    (fn [entry] (ets/insert :beam_lisp_source_extent_heads
                      (tuple (tuple :source_inert_argument (elem entry 0)) (elem entry 1)))))
                  (when-let [identity (Map/get current_targets :prepared-identity)]
                   (let [previous (source_policy_row :source_prepared_identity)]
                    (when (and previous (not= previous identity))
                     (erlang/error :sdk_prepared_identity_changed))
                    (ets/insert :beam_lisp_source_extent_heads (tuple :source_prepared_identity identity))))
                  (ets/insert :beam_lisp_source_extent_heads (tuple :source_sdk_targets 1))
                  (ets/insert :beam_lisp_vars
                    (tuple key {:owner (erlang/self) :modules modules :sources sources
                                :forwarders forwarders :lease next}))
                  (when (and prior (erlang/not unchanged)) (release_code! (Map/get prior :lease)))
                  next)))))
         (catch error (tuple :error __EXCEPTION_KIND__ error __STACKTRACE__))))
      :infinity)]
    (if (erlang/== :ok (erlang/element 1 result)) (erlang/element 2 result)
      (erlang/raise (erlang/element 2 result) (erlang/element 3 result) (erlang/element 4 result)))))

(defn ensure_sdk_runtime!
  "Automatic immutable SDK boundary before application graph preparation.
   Genuinely unmanaged native callers may establish the existing fixed issuer.
   Actual Source must ALREADY have the native SDK lifetime; a missing boundary
   is never repaired by rebinding/flags/class names or replaying an initializer.
   Only loaded SDK roots/imports are attested. Native host bootstrap does not
   run application/provider initializers. This grants no application custody."
  []
  (assert_execution_context!)
  (let [origin (execution_origin)
        rows (ets/lookup :beam_lisp_vars :bl_sdk_runtime_lease)
        prior (when (erlang/== 1 (erlang/length rows))
                (erlang/element 2 (erlang/hd rows)))]
    (when (and origin
               (erlang/not
                 (and prior (erlang/is_map prior)
                      (code_lease_active? (Map/get prior :lease)))))
      (erlang/error :unretained_sdk_runtime_before_source))
    ;; Existing private issuer authenticates actual Source digests, compiler
    ;; inventory, loaded object MD5, and original forwarder routes BEFORE
    ;; updating the lease. No caller callback/receipt influences the grant.
    (retain_sdk_runtime!)
    :sdk-runtime-retained))

(defn refresh_sdk_runtime!
  "Compiler callback: extend an existing SDK runtime lease after successful
   emission. Before first attested framework adoption, no lease is created."
  []
  (when (ets/member :beam_lisp_vars :bl_sdk_runtime_lease) (retain_sdk_runtime!)))

(defn sdk_runtime_retained_modules?
  "Read-only SDK lifetime proof for native adapters. This exposes no release or
   transfer capability. Framework closure entry modules must belong to the
   established immutable runtime lease; application graph ownership is separate."
  [modules]
  (let [rows (ets/lookup :beam_lisp_vars :bl_sdk_runtime_lease)
        proof (when (erlang/not (erlang/== rows (list))) (erlang/element 2 (erlang/hd rows)))]
    (and proof (code_lease_active? (Map/get proof :lease))
         (Enum/all? modules
           (fn [mod]
             (and (Map/has_key? (Map/get proof :modules) mod) (erlang/module_loaded mod)
                  (erlang/== (Map/get (Map/get proof :modules) mod)
                             (erlang/apply mod :module_info (list :md5)))))))))

(defn framework_owner_evidence
  "Read the one indexed native framework record through this actor's private
   lifetime locator. Dynamic handler/SDK contexts cannot hide membership. The
   locator is never conveyed and grants no authority without the exact live
   indexed PID/app/class/ticket/lease. There is no duplicate global PID map."
  [pid]
  (when (and (erlang/is_pid pid) (erlang/== (erlang/node pid) (erlang/node))
             (erlang/is_process_alive pid))
    (let [info (Process/info pid :dictionary)
          dictionary (when (erlang/is_tuple info) (erlang/element 2 info))
          locator (when dictionary (Keyword/get dictionary :bl_framework_owner_locator))
          app (when (erlang/is_map locator) (Map/get locator :application-id))
          key (when (erlang/is_map locator) (Map/get locator :key))
          rows (when (and (erlang/is_binary app)
                          (erlang/== key (tuple app pid :framework)))
                 (ets/lookup :beam_lisp_owner_index key))
          entry (when (and rows (erlang/not (erlang/== rows (list)))) (erlang/element 2 (erlang/hd rows)))
          evidence (when entry (Map/get entry :framework-evidence))
          lease (when evidence (Map/get evidence :lease))
          module (when entry (Map/get entry :module))]
      (when (and evidence (erlang/== :framework (Map/get entry :kind))
                 (erlang/== pid (Map/get entry :pid))
                 (erlang/== app (Map/get entry :application-id))
                 (erlang/== app (Map/get evidence :application-id))
                 (erlang/== locator (Map/take entry (list :key :ticket :pid :application-id :kind :proof-id)))
                 (erlang/not (ets/member :beam_lisp_owner_revisions (tuple :closed (Map/get entry :ticket))))
                 (erlang/is_tuple lease) (erlang/== 3 (erlang/tuple_size lease))
                 (erlang/== pid (erlang/element 2 lease))
                 (erlang/== (Map/get entry :proof-id) (erlang/element 3 lease))
                 (erlang/is_atom module) (erlang/== module (Map/get evidence :module))
                 (Enum/member? (erlang/element 1 lease) module)
                 (code_lease_active? lease))
        (Map/put evidence :membership locator)))))

(defn- server_init_row [ticket]
 (let [rows (ets/lookup :beam_lisp_server_initializers ticket)]
  (when (erlang/== 1 (erlang/length rows)) (erlang/element 2 (erlang/hd rows)))))
(defn- register_server_init! [module lease]
 ;; Called before complete_server_start!, when the exact one-shot starter
 ;; remains claimed. Repeated install after init cannot create a fresh row.
 (let [receipt (server_start_receipt! module) child (erlang/self)
       selector (Map/take receipt (list :ticket :child :module :attempt))]
  (server_start_turn (fn []
   (let [start (server_start_row (Map/get receipt :ticket))
         size (ets/info :beam_lisp_server_initializers :size)]
    (when-not (and start (erlang/== :claimed (Map/get start :phase))
                  (erlang/== child (Map/get start :child))
                  (erlang/== receipt (Map/take start (list :ticket :creator :attempt :module :child :kind)))
                  (erlang/is_integer size) (erlang/< size 4096))
      (erlang/error :invalid_server_initializer_admission))
    (when-not (ets/insert_new :beam_lisp_server_initializers
                (tuple (Map/get receipt :ticket)
                  {:selector selector :starter receipt :guardian (Map/get start :guardian)
                   :lease lease :phase :pending}))
      (erlang/error :server_initializer_already_registered)))))
  (Process/put :bl_server_init_gate selector) :ok))
(defn- server_init_enter! [module lease]
 (let [selector (Process/get :bl_server_init_gate) child (erlang/self)]
  (server_start_turn (fn []
   (let [row (when (erlang/is_map selector) (server_init_row (Map/get selector :ticket)))]
    (when-not (and row (erlang/== selector (Map/get row :selector))
                  (erlang/== child (Map/get selector :child))
                  (erlang/== module (Map/get selector :module))
                  (erlang/== lease (Map/get row :lease)) (erlang/== :pending (Map/get row :phase)))
      (erlang/error :server_init_already_entered))
    (ets/insert :beam_lisp_server_initializers
      (tuple (Map/get selector :ticket) (Map/put row :phase :active))))))))
(defn- server_init_complete! [module lease]
 (let [selector (Process/get :bl_server_init_gate) child (erlang/self)]
  (server_start_turn (fn []
   (let [row (when (erlang/is_map selector) (server_init_row (Map/get selector :ticket)))]
    (when-not (and row (erlang/== selector (Map/get row :selector))
                  (erlang/== child (Map/get selector :child))
                  (erlang/== module (Map/get selector :module))
                  (erlang/== lease (Map/get row :lease)) (erlang/== :active (Map/get row :phase)))
      (erlang/error :invalid_server_initializer_completion))
    (ets/delete :beam_lisp_server_initializers (Map/get selector :ticket))
    (erlang/send (Map/get row :guardian) (tuple :bl_server_start_finished (Map/get selector :ticket))))))
  (Process/delete :bl_server_init_gate) :ok))
(defn- server_init_departed! [ticket pid]
 ;; Only verified physical child death disposes an unfinished init row.
 (server_start_turn (fn []
  (when-not (and (erlang/is_pid pid) (erlang/not (erlang/is_process_alive pid)))
   (erlang/error :server_initializer_still_alive))
  (let [row (server_init_row ticket)]
   (when (and row (erlang/== pid (Map/get (Map/get row :selector) :child)))
    (ets/delete :beam_lisp_server_initializers ticket))))))
(defn- server_init_exists? [ticket]
 (server_start_turn (fn [] (erlang/not (erlang/== nil (server_init_row ticket))))))

; Native owner-transition admissions. This private table holds at most 128
; pending/prepared outcomes. References are capabilities, never journal data.
(defn- owner_transition_key [ticket] (tuple :bl_owner_transition ticket))
(defn- owner_transition_row [ticket]
  (let [rows (ets/lookup :beam_lisp_owner_transitions (owner_transition_key ticket))]
    (when (erlang/== 1 (erlang/length rows)) (erlang/element 2 (erlang/hd rows)))))
(defn- transition_handle [entry]
  (Map/take entry (list :key :ticket :pid :application-id :kind :proof-id)))
(defn- transition_index_entry [handle]
  (when (erlang/is_map handle)
    (let [rows (ets/lookup :beam_lisp_owner_index (Map/get handle :key))
          entry (when (erlang/== 1 (erlang/length rows)) (erlang/element 2 (erlang/hd rows)))]
      (when (and entry (erlang/== handle (transition_handle entry))
                 (erlang/not (ets/member :beam_lisp_owner_revisions (tuple :closed (Map/get entry :ticket))))) entry))))
(defn- owner_transition_target! [pid app]
  (when-not (and (erlang/is_pid pid) (erlang/== (erlang/node pid) (erlang/node))
                (erlang/is_process_alive pid)) (erlang/error :owner_transition_target_unavailable))
  (let [native (or (framework_owner_evidence pid)
                  (let [rows (ets/lookup :beam_lisp_vars (tuple :bl_generation_owner pid))
                        native (when (erlang/== 1 (erlang/length rows)) (erlang/element 2 (erlang/hd rows)))
                        proof (server_private_field pid :bl_server_execution_owner)]
                    (when (and native (erlang/is_tuple proof) (erlang/== 6 (erlang/tuple_size proof))
                               (erlang/== (Map/get native :lease) (erlang/element 4 proof))
                               (erlang/== (Map/get native :membership) (erlang/element 5 proof))
                               (erlang/== (Map/get native :module) (erlang/element 3 proof))
                               (erlang/== (Map/get native :generation) (Map/get (erlang/element 1 proof) :digest))) native)))
        parent (when native (transition_index_entry (Map/get native :membership)))
        lease (when native (Map/get native :lease)) module (when native (Map/get native :module))
        roles (ets/lookup :beam_lisp_owner_index (tuple app pid :evolve))
        role (when (erlang/== 1 (erlang/length roles)) (erlang/element 2 (erlang/hd roles)))]
    (when-not (and parent role (erlang/== app (Map/get native :application-id))
                  (erlang/== pid (Map/get parent :pid))
                  (erlang/== (Map/get native :membership) (Map/get role :owner-parent))
                  (erlang/== true (Map/get role :managed))
                  (transition_index_entry (transition_handle role))
                  (erlang/is_tuple lease) (erlang/== 3 (erlang/tuple_size lease))
                  (erlang/== pid (erlang/element 2 lease))
                  (erlang/== (Map/get role :proof-id) (erlang/element 3 lease))
                  (code_lease_active? lease) (erlang/is_atom module) (erlang/module_loaded module))
      (erlang/error :owner_transition_authority_required))
    {:pid pid :application-id app :parent (Map/get native :membership)
     :role (transition_handle role) :lease lease :module module
     :md5 (erlang/apply module :module_info (list :md5))}))
(defn- owner_transition_same_target? [a b]
  (erlang/== a b))
(defn- owner_transition_forget! [row]
  (when (Map/get row :custody) (release_code! (Map/get row :custody)))
  (ets/delete :beam_lisp_owner_transitions (owner_transition_key (Map/get row :ticket)))
  (ets/delete_object :beam_lisp_owner_transition_heads
    (tuple (Map/get row :head) (Map/get row :ticket)))
  (erlang/send (Map/get row :guardian) (tuple :bl_owner_transition_finished (Map/get row :ticket))) :ok)
(defn- owner_transition_departed! [ticket pid]
  (server_start_turn (fn []
    (when-not (and (erlang/is_pid pid) (erlang/not (erlang/is_process_alive pid)))
      (erlang/error :owner_transition_owner_still_alive))
    (when-let [row (owner_transition_row ticket)]
      (when (or (erlang/== pid (Map/get row :creator))
                (erlang/== pid (Map/get (Map/get row :target) :pid)))
        (if (or (erlang/== :pending (Map/get row :phase))
                (and (erlang/== :completed (Map/get row :phase))
                     (erlang/== pid (Map/get (Map/get row :target) :pid))))
          (owner_transition_forget! row)
          (when (or (erlang/== pid (Map/get (Map/get row :target) :pid))
                    (erlang/== :claimed (Map/get row :phase)))
            ;; Prepared/committing/cancelling receiver turns have already
            ;; established completion/admission. Creator death cannot revoke
            ;; them. Target death still leaves unknown accepted work held.
            (ets/insert :beam_lisp_owner_transitions
              (tuple (owner_transition_key ticket)
                (Map/merge row {:phase :uncertain :accepted-phase (Map/get row :phase)}))))))))))
(defn- owner_transition_watch [ticket creator target creator-ref target-ref]
  (receive
    [:bl_owner_transition_finished seen] :when (= seen ticket) :ok
    [:DOWN seen :process pid _]
      (if (or (and (= seen creator-ref) (= pid creator))
              (and (= seen target-ref) (= pid target)))
        (do (owner_transition_departed! ticket pid)
            (when (server_start_turn (fn [] (owner_transition_row ticket)))
              (owner_transition_watch ticket creator target creator-ref target-ref)))
        (owner_transition_watch ticket creator target creator-ref target-ref))))
(defn- owner_transition_guardian [ticket creator target]
  (let [creator-ref (erlang/monitor :process creator) target-ref (erlang/monitor :process target)]
    (erlang/send creator (tuple :bl_owner_transition_ready ticket (erlang/self)))
    (owner_transition_watch ticket creator target creator-ref target-ref)))
(defn- transition_candidate_identity [generation]
 {:application-id (Map/get generation :application-id) :digest (Map/get generation :digest)
  :scope (Map/get generation :scope)
  :modules (Enum/map (BeamLisp.Vector/to_list (Map/get generation :modules))
             (fn [module] (tuple module (erlang/apply module :module_info (list :md5)))))})
(defn- owner_transition_existing! [head target identity]
  (let [heads (ets/lookup :beam_lisp_owner_transition_heads head)
        ticket (when (erlang/== 1 (erlang/length heads)) (erlang/element 2 (erlang/hd heads)))
        row (when ticket (owner_transition_row ticket))]
    (when row
      (when-not (and (owner_transition_same_target? target (Map/get row :target))
                    (erlang/== identity (Map/get row :candidate)))
        (erlang/error :owner_transition_candidate_changed))
      (when-not (Enum/member? (list :prepared :committing :completed) (Map/get row :phase))
        (erlang/error :owner_transition_outcome_pending))
      (tuple :bl_owner_transition (Map/get row :guardian) ticket))))
(defn- prune_completed_owner_transitions! [pid except-head]
 ;; Bounded administrative sweep only. Completed rows contain no G/context/Fn.
 (Enum/each (ets/tab2list :beam_lisp_owner_transitions)
   (fn [pair]
     (let [row (erlang/element 2 pair)]
       (when (and (erlang/== :completed (Map/get row :phase))
                  (erlang/== pid (Map/get (Map/get row :target) :pid))
                  (erlang/not (erlang/== except-head (Map/get row :head))))
         (owner_transition_forget! row))))))

(defn server_initializing? [module]
  ;; Child dictionary contains only a selector. Phase/custody is Env-private.
  (let [selector (Process/get :bl_server_init_gate) child (erlang/self)
        row (when (erlang/is_map selector)
              (server_start_turn (fn [] (server_init_row (Map/get selector :ticket)))))
        lease (when row (Map/get row :lease))
        source (Process/get :bl_server_execution_owner)
        native (if source
                 (let [rows (ets/lookup :beam_lisp_vars (tuple :bl_generation_owner child))]
                   (when (erlang/== 1 (erlang/length rows)) (erlang/element 2 (erlang/hd rows))))
                 (framework_owner_evidence child))]
    (and row (erlang/== :active (Map/get row :phase))
         (erlang/== selector (Map/get row :selector)) (erlang/== child (Map/get selector :child))
         (erlang/== module (Map/get selector :module)) (erlang/== module (Map/get native :module))
         (erlang/== (Map/get row :starter) (Map/get native :starter))
         (server_extent_holds? lease) (code_lease_physical_live? lease)
         (or (and source (server_membership_live? native (Map/get native :membership)))
             (and (erlang/not source) (framework_owner_evidence child))))))

(defn begin_owner_transition! [pid]
  (let [generation (Process/get :bl_generation)]
    (when-not (executing_generation? generation) (erlang/error :unadmitted_owner_transition))
    (let [target (owner_transition_target! pid (Map/get generation :application-id))
          creator (erlang/self) context (capture) ticket (erlang/make_ref)
          candidate (transition_candidate_identity generation)
          head (tuple (Map/get target :application-id) pid
                      (Map/get (Map/get target :role) :ticket) (Map/get generation :digest))
          existing (server_start_turn (fn [] (owner_transition_existing! head target candidate)))
          guardian (when (erlang/== nil existing)
                     (erlang/spawn (fn [] (owner_transition_guardian ticket creator pid))))]
      (if existing existing
      (do (receive
        [:bl_owner_transition_ready seen owner] :when (and (= seen ticket) (= owner guardian)) :ready
        (after 5000 (do (erlang/send guardian (tuple :bl_owner_transition_finished ticket))
                       (erlang/error :owner_transition_guardian_unavailable))))
      (try
        (server_start_turn (fn []
          (prune_completed_owner_transitions! pid head)
          (when (owner_transition_existing! head target candidate)
            (erlang/error :owner_transition_already_reserved))
          (let [size (ets/info :beam_lisp_owner_transitions :size)]
            (when-not (and (erlang/is_integer size) (erlang/< size 128))
              (erlang/error :owner_transition_capacity)))
          (when-not (and (erlang/is_process_alive creator) (erlang/is_process_alive guardian)
                        (owner_transition_same_target? target
                          (owner_transition_target! pid (Map/get generation :application-id))))
            (erlang/error :owner_transition_target_changed))
          (let [custody (retain_code! (BeamLisp.Vector/to_list (Map/get generation :modules)))]
            (when-not (erlang/== (Process/whereis (own-module)) (erlang/element 2 custody))
              (erlang/error :owner_transition_custody_not_native_owned))
            (ets/insert :beam_lisp_owner_transitions
              (tuple (owner_transition_key ticket)
                {:ticket ticket :guardian guardian :creator creator :target target
                 :generation generation :context context :candidate candidate :head head
                 :custody custody :phase :pending})))
            (ets/insert :beam_lisp_owner_transition_heads (tuple head ticket))))
        (tuple :bl_owner_transition guardian ticket)
        (catch error
          (erlang/send guardian (tuple :bl_owner_transition_finished ticket))
          (erlang/raise __EXCEPTION_KIND__ error __STACKTRACE__))))))))
(defn- owner_transition_cap_row! [capability]
  (when-not (and (erlang/is_tuple capability) (erlang/== 3 (erlang/tuple_size capability))
                (erlang/== :bl_owner_transition (erlang/element 1 capability))
                (erlang/is_pid (erlang/element 2 capability))
                (erlang/is_reference (erlang/element 3 capability)))
    (erlang/error :invalid_owner_transition_ticket))
  (let [row (owner_transition_row (erlang/element 3 capability))]
    (when-not (and row (erlang/== (Map/get row :guardian) (erlang/element 2 capability)))
      (erlang/error :invalid_owner_transition_ticket)) row))
(defn with_owner_transition! [capability phase action]
  ;; SDK receiver code supplies this action, never a message-controlled Fn.
  (when-not (and (erlang/is_function action 0)
                (Enum/member? (list :prepare :commit :cancel :observe) phase))
    (erlang/error :invalid_owner_transition_action))
  (BeamLisp.AOT/sdk_callable_evidence! action)
  (let [pid (erlang/self)
        row (server_start_turn (fn []
          (let [row (owner_transition_cap_row! capability)
                target (Map/get row :target)]
            (when-not (and (erlang/== pid (Map/get target :pid))
                          (owner_transition_same_target? target
                            (owner_transition_target! pid (Map/get target :application-id)))
                          (if (erlang/== :prepare phase) (erlang/== :pending (Map/get row :phase))
                            (erlang/== :prepared (Map/get row :phase))))
              (erlang/error :invalid_owner_transition_ticket))
            (when (Enum/member? (list :prepare :commit :cancel) phase)
              (ets/insert :beam_lisp_owner_transitions
                (tuple (owner_transition_key (Map/get row :ticket))
                  (Map/put row :phase (case phase :prepare :claimed :commit :committing :cancel :cancelling)))))
            row)))
        previous (capture) prior (Process/get :bl_owner_transition_execution)]
    (try
      (bind (Map/get row :context))
      (Process/put :bl_owner_transition_execution capability)
      (let [result (run_code! (Map/get row :custody)
                     (fn [] (with_owned_generation_execution action)))]
        (when (erlang/== :cancelled result) (erlang/error :expired_owner_transition_ticket)) result)
      (catch error
        (server_start_turn (fn []
          (when-let [current (owner_transition_row (Map/get row :ticket))]
            (ets/insert :beam_lisp_owner_transitions
              (tuple (owner_transition_key (Map/get row :ticket)) (Map/put current :phase :uncertain))))))
        (erlang/raise __EXCEPTION_KIND__ error __STACKTRACE__))
      (finally (restore_pdict :bl_owner_transition_execution prior) (bind previous)))))
(defn owner_transition_prepared! [capability preparation]
  (when-not (and (erlang/is_reference preparation)
                (erlang/== capability (Process/get :bl_owner_transition_execution)))
    (erlang/error :invalid_owner_transition_completion))
  (let [pid (erlang/self)]
    (server_start_turn (fn []
      (let [row (owner_transition_cap_row! capability)]
        (when-not (and (erlang/== pid (Map/get (Map/get row :target) :pid))
                      (or (erlang/== :claimed (Map/get row :phase))
                          (and (erlang/== :uncertain (Map/get row :phase))
                               (erlang/== :claimed (Map/get row :accepted-phase)))))
          (erlang/error :invalid_owner_transition_completion))
        (ets/insert :beam_lisp_owner_transitions
          (tuple (owner_transition_key (Map/get row :ticket))
                 (Map/merge row {:phase :prepared :preparation preparation})))))) :ok))
(defn finish_owner_transition! [capability preparation outcome]
  (when-not (and (erlang/== capability (Process/get :bl_owner_transition_execution))
                (Enum/member? (list :applied :cancelled :refused) outcome))
    (erlang/error :invalid_owner_transition_completion))
  (let [pid (erlang/self)]
    (server_start_turn (fn []
      (let [row (owner_transition_cap_row! capability)]
        (when-not (and (erlang/== pid (Map/get (Map/get row :target) :pid))
                      (or (and (erlang/== :claimed (Map/get row :phase)) (erlang/== nil preparation))
                          (and (Enum/member? (list :committing :cancelling) (Map/get row :phase))
                               (erlang/== preparation (Map/get row :preparation)))))
          (erlang/error :invalid_owner_transition_completion))
        (if (and (erlang/== :committing (Map/get row :phase)) (erlang/== :applied outcome))
          (do
            (release_code! (Map/get row :custody))
            (ets/insert :beam_lisp_owner_transitions
              (tuple (owner_transition_key (Map/get row :ticket))
                (Map/put (Map/take row (list :ticket :guardian :creator :target :candidate :head :preparation))
                         :phase :completed))))
          (owner_transition_forget! row)))))) :ok)

(defn abandon_owner_transition! [capability]
  (let [creator (erlang/self)]
    (server_start_turn (fn []
      (let [row (owner_transition_cap_row! capability)]
        (when-not (and (erlang/== creator (Map/get row :creator))
                      (erlang/== :pending (Map/get row :phase)))
          (erlang/error :accepted_owner_transition_cannot_be_abandoned))
        (owner_transition_forget! row))))) :ok)

(defn owner_transition_status [capability]
 (let [pid (erlang/self)]
  (server_start_turn (fn []
   (let [row (owner_transition_cap_row! capability) target (Map/get row :target)]
    (when-not (and (erlang/== pid (Map/get target :pid))
                  (owner_transition_same_target? target
                    (owner_transition_target! pid (Map/get target :application-id))))
      (erlang/error :invalid_owner_transition_ticket))
    (Map/get row :phase))))))
(defn owner_transition_observation [capability]
  ;; Capability lookup yields bounded NON-AUTHORIZING phase/custody flags only.
  ;; This can observe a module-fenced accepted receiver without taking that
  ;; graph's module locks. No G/context/lease/creator/target value is returned.
  (server_start_turn (fn []
    (let [row (owner_transition_cap_row! capability)]
      {:phase (Map/get row :phase)
       :native-custody (when (Map/get row :custody)
         (erlang/== (Process/whereis (own-module)) (erlang/element 2 (Map/get row :custody))))}))))

(defn framework_owner_evidence! []
  (or (framework_owner_evidence (erlang/self)) (erlang/error :unattested_framework_owner)))

(defn ensure_sdk_owner_registry!
  "Load the fixed SDK owner index outside application scope before actors start.
   This is not a generic detach API; no caller callback or namespace is accepted."
  []
  (let [previous (capture) attempt (Process/get :bl_initializer_attempt)
        dirs (BeamLisp.Tiers/dirs)]
    (try
      (with_env :global
        (fn []
          (bind (Map/merge (capture)
            {:generation nil :application-identity nil :admission nil
             :loader-ambient dirs :loader-resolution (tuple dirs dirs (list))}))
          (Process/delete :bl_initializer_attempt)
          (BeamLisp.Loader/ensure_loaded "proc.owner-registry")
          ;; A stale mixed SDK ABI fails clearly; never run an application
          ;; overlay or synthesize an alternate unmonitored owner collector.
          (fetch_exact! "proc.owner-registry" "register-server!")
          (fetch_exact! "proc.owner-registry" "register-supervisor!")
          :ok))
      (finally
        (bind previous)
        (restore_pdict :bl_initializer_attempt attempt)))))

(defn prepare_sdk_class!
  "Authenticate an off-graph class before its init can run. This permits fixed
   SDK code, never globally loaded application code. Ordinary managed actors
   still retain their whole application generation until explicit adoption."
  [module]
  (let [proof (with_env :global (fn [] (BeamLisp.AOT/sdk_class_evidence! module)))
        artifact (Map/get proof :artifact) owner (Map/get artifact :definition-env)
        declaration (Map/get artifact :declaration-owner)
        binding (ets/lookup :beam_lisp_vars (pfx owner declaration))]
    (when-not (and (erlang/== :global owner) (erlang/== 1 (erlang/length binding))
                  (erlang/== module (erlang/element 2 (erlang/hd binding))))
      (erlang/error :invalid_framework_declaration_owner))
    (when-not (sdk_runtime_retained_modules? (list module)) (retain_sdk_runtime!))
    proof))

(defn assert_managed_callback!
  "Validate every executable capture before a managed deferred factory runs.
   App code belongs to the selected exact graph; SDK exports must be protected
   original routes or stable compiler bodies. Captured data grants no authority."
  [generation callback]
  (when generation
    (loop [pending (list callback) remaining 16384]
      (when (erlang/=< remaining 0) (erlang/error :callback_capture_too_large))
      (when (erlang/not (erlang/== pending (list)))
        (let [value (erlang/hd pending) rest (erlang/tl pending)
              children
                (cond
                  (erlang/is_function value)
                    (let [module (erlang/element 2 (erlang/fun_info value :module))]
                      (when-not (Enum/member? (Map/get generation :modules) module)
                        (with_env :global (fn [] (BeamLisp.AOT/sdk_callable_evidence! value))))
                      (erlang/element 2 (erlang/fun_info value :env)))
                  (erlang/is_tuple value) (Tuple/to_list value)
                  (erlang/is_map value) (erlang/++ (maps/keys value) (maps/values value))
                  (erlang/is_list value) value
                  :else (list))]
          (recur (erlang/++ children rest) (erlang/- remaining 1))))))
  true)

(defn- dispose_generation_server! []
  (let [key (tuple :bl_generation_owner (erlang/self)) rows (ets/lookup :beam_lisp_vars key)
        row (when (erlang/not (erlang/== rows (list))) (erlang/hd rows))
        prior (when row (erlang/element 2 row)) lease (when prior (Map/get prior :lease))]
    (when (and prior (erlang/== :server (Map/get prior :kind)))
      (when-not (and (erlang/is_tuple lease) (erlang/== (erlang/self) (erlang/element 2 lease)))
        (erlang/error :invalid_prior_server_owner))
      ;; Exact close receipt is durable in the existing owner index protocol,
      ;; including lost replies. The new framework row is already published.
      (let [result (BeamLisp.Ns.Rt/invoke (fetch_exact! "proc.owner-registry" "unregister!")
                     (list (Map/get prior :membership)))]
        (when-not (Enum/member? (list :removed :absent) (Map/get result :status))
          (erlang/error :prior_server_disposal_pending)))
      ;; Framework adoption clears source authority immediately. The private
      ;; accepted init extent still pins physical helpers until its finally.
      (Process/delete :bl_server_execution_owner)
      (Process/delete :bl_server_execution_context)
      (Process/delete :bl_executing_generation)
      (ets/delete_object :beam_lisp_vars row)
      (release_code! lease))))

(defn adopt_framework!
  "Adopt the actual fixed-SDK generated actor into an application's logical
   lifetime. App-owned generated classes retain their normal generation path.
   Authentication finishes before Env mutation or owner publication."
  [initializer]
  (let [generation (Process/get :bl_generation)]
    (when generation
      (let [module (framework_init_module (erlang/self))]
        (when-not (Enum/member? (Map/get generation :modules) module)
          (let [class-proof (BeamLisp.AOT/sdk_class_evidence! module)
                declaration (Map/get (Map/get class-proof :artifact) :declaration-owner)]
            (when-not (and (erlang/is_tuple declaration) (erlang/== 2 (erlang/tuple_size declaration)))
              (erlang/error :unattested_framework_declaration))
            (let [ns (erlang/element 1 declaration) name (erlang/element 2 declaration)
                  proof class-proof
                  owner (Map/fetch! (Map/fetch! proof :artifact) :definition-env)
                  binding (ets/lookup :beam_lisp_vars (pfx owner (tuple ns name)))
                  app (Map/get generation :application-id)]
              (when-not (and (erlang/== :global owner) (erlang/is_binary app) (erlang/> (erlang/byte_size app) 0)
                            (erlang/=< (erlang/byte_size app) 128)
                            (erlang/is_pid initializer) (erlang/== (erlang/node initializer) (erlang/node))
                            (erlang/is_process_alive initializer)
                            (erlang/== 1 (erlang/length binding))
                            (erlang/== module (erlang/element 2 (erlang/hd binding))))
                (erlang/error :invalid_framework_declaration_owner))
              (when-not (sdk_runtime_retained_modules? (list module)) (retain_sdk_runtime!))
              ;; Pending start custody was ALREADY handed off by bind_init.
              ;; Preserve the exact authenticated indexed source-owner receipt;
              ;; initializer is lifetime custody, not proof of actual starter.
              (let [rows (ets/lookup :beam_lisp_vars (tuple :bl_generation_owner (erlang/self)))
                    source-owner (when (erlang/== 1 (erlang/length rows)) (erlang/element 2 (erlang/hd rows)))
                    source-lease (when source-owner (Map/get source-owner :lease))
                    source-membership (when source-owner (Map/get source-owner :membership))
                    source-proof (Process/get :bl_server_execution_owner)
                    starter (when source-owner (Map/get source-owner :starter))
                    _ (when-not (and source-owner (erlang/== :server (Map/get source-owner :kind))
                           (erlang/== module (Map/get source-owner :module))
                           (erlang/== app (Map/get source-owner :application-id))
                           (erlang/== (Map/get generation :digest) (Map/get source-owner :generation))
                           (erlang/is_tuple source-proof) (erlang/== 6 (erlang/tuple_size source-proof))
                           (erlang/== generation (erlang/element 1 source-proof))
                           (erlang/== (env_id) (erlang/element 2 source-proof))
                           (erlang/== module (erlang/element 3 source-proof))
                           (erlang/== source-lease (erlang/element 4 source-proof))
                           (erlang/== source-membership (erlang/element 5 source-proof))
                           (code_lease_active? source-lease)
                           (server_membership_live? source-owner source-membership)
                           (erlang/is_map starter) (erlang/== :server (Map/get starter :kind))
                           (erlang/== module (Map/get starter :module))
                           (erlang/== (erlang/self) (Map/get starter :child))
                           (erlang/is_pid (Map/get starter :creator))
                           (erlang/is_reference (Map/get starter :attempt))
                           (erlang/is_reference (Map/get starter :ticket)))
                        (erlang/error :unattested_framework_starter))
                    monitor (Process/monitor initializer) lease (retain_code! (list module))
                    token (with_env owner
                            (fn []
                              (Map/merge (capture)
                                {:generation nil :application-identity app :ns ns
                                 :admission nil :query-functions nil :loader-ambient nil
                                 :loader-resolution nil :osenv nil :project nil :diagnostics nil})))
                    previous (capture) membership-key (tuple :bl_framework_pending_membership (erlang/make_ref))
                    evidence {:kind :framework :application-id app :origin-generation (Map/get generation :digest)
                              :module module :declaration declaration :artifact (Map/get proof :artifact)
                              :initializer initializer :monitor monitor :lease lease :starter starter}]
                (let [adopted (try
                  (do
                    (when-not (erlang/is_process_alive initializer) (erlang/error :framework_initializer_exited))
                    (let [registered (with_env owner
                                       (fn []
                                         (BeamLisp.Ns.Rt/invoke
                                           (fetch_exact! "proc.owner-registry" "register-framework!")
                                           (list evidence))))]
                      (Process/put membership-key registered)
                      (bind token)
                      (Process/delete membership-key)
                      (Map/put evidence :membership registered)))
                  (catch error
                    ;; Restoration is unconditional even if the collector is
                    ;; unavailable while disposing the indexed registration.
                    ;; Its existing monitor still owns crash reclamation.
                    (try
                      (when (Process/get membership-key)
                        (with_env owner
                          (fn [] (BeamLisp.Ns.Rt/invoke (fetch_exact! "proc.owner-registry" "unregister!")
                                   (list (Process/get membership-key))))))
                      (finally
                        (Process/delete membership-key)
                        (Process/demonitor monitor (list :flush))
                        (try (release_code! lease) (finally (bind previous)))))
                    (erlang/error error)))]
                  (dispose_generation_server!)
                  ;; This immutable actor-local locator is installed ONLY after
                  ;; authenticated adoption and prior-owner disposal succeed.
                  ;; capture/bind/convey deliberately never read or write it.
                  (Process/put :bl_framework_owner_locator (Map/get adopted :membership))
                  adopted)))))))))

(defn adopt_sdk_runtime!
  "Explicit fixed-SDK init contract for data-only VM resources. Authentication
   requires this process's real SDK init frame. There is no action/closure to
   detach, and an application class or direct caller cannot claim the contract."
  []
  (when (Process/get :bl_generation)
    (let [module (framework_init_module (erlang/self))
          proof (prepare_sdk_class! module)
          namespace (Map/get proof :namespace)
          token (with_env :global
                  (fn []
                    (Map/merge (capture)
                      {:generation nil :application-identity nil :ns namespace
                       :admission nil :query-functions nil :loader-ambient nil
                       :loader-resolution nil :osenv nil :project nil :diagnostics nil})))]
      ;; Once the new runtime context binds, cleanup failure must surface in
      ;; that safe context, never restore an application pointer after release.
      (bind token)
      (dispose_generation_server!)
      :sdk-runtime)))

(defn release_framework!
  "Release this actor's self-owned class capability after exact index disposal.
   The SDK-wide lease remains with Env until the runtime handover boundary."
  [evidence]
  (let [lease (Map/get evidence :lease) monitor (Map/get evidence :monitor)]
    (when-not (and (erlang/is_tuple lease) (erlang/== 3 (erlang/tuple_size lease))
                  (erlang/== (erlang/self) (erlang/element 2 lease)))
      (erlang/error :wrong_framework_owner_ticket))
    (when (erlang/is_reference monitor) (Process/demonitor monitor (list :flush)))
    (release_code! lease)
    (when (erlang/== (Process/get :bl_framework_owner_locator) (Map/get evidence :membership))
      (Process/delete :bl_framework_owner_locator))
    :ok))

(defn explain
  "Debug aid: for each env in the chain and each resolution candidate, show
   whether the var is present."
  [ns name]
  (Enum/flat_map (chain)
    (fn [env]
      (Enum/map (candidates ns name)
        (fn [pair]
          (let [cns (erlang/element 1 pair)
                cname (erlang/element 2 pair)
                instance? (ets/member :beam_lisp_vars (pfx env (per_env_instance_key cns cname)))
                row (ets/lookup :beam_lisp_vars (pfx env (tuple cns cname)))
                kind0 (cond
                        (erlang/== 0 (erlang/length row))
                        (if instance? :per_env_materialized_here :absent)

                        (per_env_def? (erlang/element 2 (erlang/hd row)))
                        :per_env_definition

                        :else :normal)
                kind (if (and (erlang/== :per_env_definition kind0) instance?)
                       :per_env_materialized_here
                       kind0)]
            (maps/put :env env
              (maps/put :ns cns
                (maps/put :name cname
                  (maps/put :found (not (erlang/== :absent kind))
                    (maps/put :kind kind (maps/new))))))))))))

(defn- compute_chain
  "Walk the env metadata to build the read-through chain. Cold: runs once per
   bind, not per lookup. Degrades past unknown (destroyed) envs."
  ([env] (compute_chain env 8 (list)))
  ([env depth acc]
   (cond
     (erlang/== :global env) (Enum/reverse (erlang/++ (list :global) acc))
     (erlang/== 0 depth) (Enum/reverse (erlang/++ (list :global) acc))
     :else
     (let [st (env_state env)]
       (cond
         (erlang/== nil st) (Enum/reverse (erlang/++ (list :global) acc))
         (erlang/== :global (Map/get st :parent))
         (Enum/reverse (erlang/++ (list :global env) acc))
         :else
         (compute_chain (Map/get st :parent) (- depth 1) (erlang/++ (list env) acc)))))))

(defn- env_state [env]
  (Agent/get (own-module)
    (fn [s] (Map/get (Map/get s :envs (maps/new)) env))))

(defn- update_env_state [env fun]
  (Agent/update (own-module)
    (fn [s]
      (let [envs (Map/get s :envs (maps/new))
            state (Map/get envs env)]
        ;; Only fork registers scopes. A stale loader/search-path update must
        ;; not recreate a retired scope with the root's default capabilities.
        (if (erlang/== nil state) s
          (Map/put s :envs (Map/put envs env (fun state))))))))

; ── Key plumbing (shared by the registry modules) ──────────────────────────

(defn pfx
  "Prefix an old-shape key with an env id. Atoms become `{env, atom}`; tuples
   gain env as element 0."
  [env k]
  (cond
    (erlang/is_tuple k) (Tuple/insert_at k 0 env)
    (erlang/is_atom k) (tuple env k)
    :else (fce! :pfx 2)))

(defn key [k] (pfx (env_id) k))

(defn lookup
  "Chain-walking lookup of an old-shape key: `{:ok, value}` or `:error`."
  [k]
  (Enum/find_value (chain) :error
    (fn [env]
      (let [row (ets/lookup :beam_lisp_vars (pfx env k))]
        (if (erlang/== 0 (erlang/length row))
          nil
          (tuple :ok (erlang/element 2 (erlang/hd row))))))))

(defn member?
  "Chain-walking membership test of an old-shape key."
  [k]
  (Enum/any? (chain) (fn [env] (ets/member :beam_lisp_vars (pfx env k)))))

(defn- publication_key [k]
  (let [ns (when (erlang/is_tuple k)
             (cond
               (erlang/< 1 (erlang/tuple_size k))
                 (let [a (erlang/element 1 k) b (erlang/element 2 k)]
                   (cond (erlang/is_binary a) a
                         (erlang/== a :per_env_instance) nil
                         (erlang/is_binary b) b
                         :else nil))
               :else nil))]
    (when ns (key (tuple :definition_generation ns)))))

(defn- begin_publication [k]
  (with_scope_commit (env_id) (fn []
    (let [pk (publication_key k)]
      (when pk
        (ets/update_counter :beam_lisp_vars pk (list (tuple 2 1) (tuple 3 1)) (tuple pk 0 0))
        pk)))))

(defn- end_publication [pk]
  (when (and pk (not (erlang/== :retired pk)))
    (with_scope_commit (erlang/element 1 pk) (fn []
    ;; A bulk deletion that removed its own evidence cannot reset a generation
    ;; and certify an old answer. A negative active count permanently declines.
    (ets/update_counter :beam_lisp_vars pk (list (tuple 2 1) (tuple 3 -1)) (tuple pk 0 -1))))))

(defn put_key
  "Insert `{key, value}` into the CURRENT env (writes never cross envs)."
  [k value]
  (with_scope_commit (env_id) (fn []
    (let [pk (begin_publication k)]
      (try
        (ets/insert :beam_lisp_vars (tuple (key k) value))
        (when (and (erlang/is_tuple k) (erlang/== 2 (erlang/tuple_size k))
                   (erlang/is_binary (erlang/element 1 k)) (erlang/is_binary (erlang/element 2 k)))
          (invalidate_normal_declaration (env_id) (erlang/element 1 k) (erlang/element 2 k)))
        (bump_epoch)
        (finally (end_publication pk)))))))

(defn with_namespace_lock
  "Serialize namespace publication, retaining the outer lock across nested
   Env/Link/AOT calls. OTP global locks are not acquisition-counted. The local
   guard is private execution state and must never be captured by convey."
  [ns action]
  (let [held (tuple :bl_namespace_lock_held ns)]
    (if (Process/get held)
      (invoke_action action)
      (global/trans (tuple (tuple :bl_namespace_publication ns) (erlang/self))
        (fn []
          (Process/put held true)
          (try (invoke_action action) (finally (Process/delete held))))))))

(defn with_publication
  "Fence a complete compile/load/publication operation. Readers decline while
   any nested publisher is active; failure also advances the generation."
  [ns action]
  (let [pk (begin_publication (tuple ns :publication))]
    (if (erlang/== :retired pk) :retired
      (try (invoke_action action) (finally (end_publication pk))))))

(defn- emitted_definition [entries]
  (let [bodies (Enum/uniq (Enum/flat_map entries
                  (fn [e]
                    (if (and (erlang/is_tuple e) (erlang/== 5 (erlang/tuple_size e))
                             (erlang/is_atom (erlang/element 5 e)))
                      (list (erlang/element 5 e)) (list)))))
        hashes (Enum/reduce bodies (Map/new)
                  (fn [body acc]
                    (Map/put acc body (erlang/apply body :module_info (list :md5)))))]
    {:version 1 :entries entries :bodies hashes}))

(defn mark_emitted
  "Publish constant-size shim identity and separate immutable definition rows.
   Incremental publication copies only changed clauses into ETS. Full AOT/settle
   replaces all rows under the same fence; no retired body ASTs accumulate."
  ([ns mod] (mark_emitted ns mod nil 0 nil))
  ([ns mod changed definition_count] (mark_emitted ns mod changed definition_count nil))
  ([ns mod changed definition_count changed_defs]
   (with_publication ns
    (fn []
     (let [full? (erlang/== nil changed_defs)
           definitions (if full? (ns_defs ns) changed_defs)]
       (when full?
         (match_delete_own (tuple (tuple :emitted_definition ns :_) :_)))
       (Enum/each definitions
         (fn [pair]
           (put_key (tuple :emitted_definition ns (erlang/element 1 pair))
                    (emitted_definition (erlang/element 2 pair)))))
       (put_key (tuple :emitted_publication ns)
         {:version 4 :module mod :md5 (erlang/apply mod :module_info (list :md5))}))))))

(defn delete_key
  "Delete an old-shape key from the CURRENT env only."
  [k]
  (with_scope_commit (env_id) (fn []
    (let [pk (begin_publication k)]
      (try (ets/delete :beam_lisp_vars (key k)) (bump_epoch)
           (finally (end_publication pk)))))))

; --- fetch memo: epoch + per-process cache -------------------------------
;
; Every var deref is an :ets.lookup, and an ETS read COPIES the term into the
; caller's heap. Successful writes, deletes, bulk deletes and destruction
; publish through one global epoch, paired with a
; per-process memo keyed by {chain, ns, name}. The epoch is read BEFORE the
; ETS walk and the result cached under THAT epoch: a writer racing the walk
; bumps after its mutation, so a walk that saw old rows is cached under the
; old epoch and the next deref refetches — never the reverse.

(defn- epoch_ref []
  (let [k (tuple (own-module) :epoch_ref)
        ref (persistent_term/get k nil)]
    (if (erlang/== nil ref)
      (global/trans (tuple k (erlang/self))
        (fn []
          (let [existing (persistent_term/get k nil)]
            (if (erlang/== nil existing)
              (let [r (atomics/new 1 (list (tuple :signed false)))]
                (persistent_term/put k r)
                r)
              existing))))
      ref)))

(defn- current_epoch [] (atomics/get (epoch_ref) 1))

(defn publication_epoch
  "Monotone generation of the published definition environment. Derived
   answers bind this generation so hot replacement cannot reuse old code's
   answers. Initialization publishes exactly one shared counter."
  []
  (current_epoch))

(defn namespace_generations
  "Read-only code evidence for a closed namespace dependency set. Per-env
   instance initialization is not a new definition. Unknown bulk publication,
   dead environments and in-flight writes decline a certificate."
  [namespaces]
  (let [envs (chain)
        ;; A freshly rebound destroyed scope can have a global-only computed
        ;; chain. Its current identity must still be live independently.
        current (env_id)
        alive (and (or (erlang/== :global current)
                       (ets/member :beam_lisp_vars (tuple current :definition_lifetime)))
                   (Enum/all? envs (fn [e] (if (erlang/== :global e)
                     (erlang/not (persistent_term/get (tuple (own-module) :global_destroyed) false))
                     (ets/member :beam_lisp_vars (tuple e :definition_lifetime))))))
        pairs (Enum/flat_map envs
                (fn [e] (Enum/map (erlang/++ (list :wide) namespaces)
                          (fn [ns]
                            (let [k (pfx e (if (erlang/== :wide ns) :definition_wide (tuple :definition_generation ns)))
                                  hit (ets/lookup :beam_lisp_vars k)]
                              (if (erlang/== (list) hit) (tuple e ns 0 0)
                                (let [v (erlang/hd hit)]
                                  (tuple e ns (erlang/element 2 v) (erlang/element 3 v)))))))))]
    (when (and alive (Enum/all? pairs (fn [p] (erlang/== 0 (erlang/element 4 p))))) pairs)))

(defn- bump_epoch []
  (atomics/add (epoch_ref) 1 1)
  :ok)

(defn match
  "Chain-walking `:ets.match/2`: the whole-row pattern's key half gets the env
   prefix per chain link, results concatenated innermost-first."
  [pair]
  (if (and (erlang/is_tuple pair) (erlang/== 2 (erlang/tuple_size pair)))
    (let [kp (erlang/element 1 pair)
          vp (erlang/element 2 pair)]
      (Enum/flat_map (chain)
        (fn [env] (ets/match :beam_lisp_vars (tuple (pfx env kp) vp)))))
    (fce! :match 1)))

(defn lookup_own
  "Exact-env `:ets.lookup`: the current env only, no read-through."
  [k]
  (let [row (ets/lookup :beam_lisp_vars (key k))]
    (if (erlang/== 0 (erlang/length row))
      :error
      (tuple :ok (erlang/element 2 (erlang/hd row))))))

(defn match_own [pair]
  (if (and (erlang/is_tuple pair) (erlang/== 2 (erlang/tuple_size pair)))
    (ets/match :beam_lisp_vars
      (tuple (key (erlang/element 1 pair)) (erlang/element 2 pair)))
    (fce! :match_own 1)))

(defn match_delete_own [pair]
  (if (and (erlang/is_tuple pair) (erlang/== 2 (erlang/tuple_size pair)))
    (with_scope_commit (env_id) (fn []
    (let [pk (or (publication_key (erlang/element 1 pair)) (key :definition_wide))]
      (ets/update_counter :beam_lisp_vars pk (list (tuple 2 1) (tuple 3 1)) (tuple pk 0 0))
      (try
        (let [result (ets/match_delete :beam_lisp_vars
                       (tuple (key (erlang/element 1 pair)) (erlang/element 2 pair)))]
          (bump_epoch)
          result)
        (finally (end_publication pk))))))
    (fce! :match_delete_own 1)))

; ── Namespaces and vars ────────────────────────────────────────────────────

(defn current_ns
  "The namespace new defs land in. pdict FIRST, at every env — `*ns*` is
   thread-local (Clojure's model); the Agent value is the ambient default for
   processes that never set one."
  []
  (let [v (Process/get :bl_ns)]
    (if (erlang/== nil v)
      (if (erlang/== :global (env_id))
        (Agent/get (own-module) (fn [s] (Map/get s :ns)))
        "user")
      v)))

(defn in_ns
  "Bind the process-local current namespace and declare it. Idempotent."
  [ns]
  (if (erlang/is_binary ns)
    (do
      (Process/put :bl_ns ns)
      (declare_ns ns)
      (if (erlang/== :global (env_id))
        (Agent/update (own-module) (fn [s] (Map/put s :ns ns)))
        nil)
      :ok)
    (fce! :in_ns 1)))

(defn with_ns
  "Run `fun` with `current_ns` bound to `ns`, restoring the previous value
   afterwards — even on raise."
  [ns fun]
  (if (and (erlang/is_binary ns) (erlang/is_function fun 0))
    (let [prev (current_ns)]
      (in_ns ns)
      (try
        (fun)
        (finally
          (in_ns prev))))
    (fce! :with_ns 2)))

(defn intern
  "Bind `name` to `value` in `ns`. Returns the value, like Clojure's def."
  [ns name value]
  (put_key (tuple ns name) value)
  value)

(defn define_per_env
  "Register a `^:per-env` def: intern a descriptor (a re-runnable `init` thunk)
   into the CURRENT env's `{ns, name}` slot instead of a value. Returns `:ok`."
  [ns name init]
  (if (erlang/is_function init 0)
    (do
      (put_key (tuple ns name) (make_per_env_def (erlang/make_ref) init))
      :ok)
    (fce! :define_per_env 3)))

(defn- resolve_per_env
  "Resolve a descriptor hit to a concrete value for the CURRENT env: a cached
   instance if its generation matches, else materialize once (pinned) and cache."
  [desc resolved_ns resolved_name]
  (let [env (env_id)
        ikey (per_env_instance_key resolved_ns resolved_name)
        row (ets/lookup :beam_lisp_vars (pfx env ikey))]
    (if (and (erlang/== 1 (erlang/length row))
             (let [v (erlang/element 2 (erlang/hd row))]
               (and (erlang/is_tuple v) (erlang/== 2 (erlang/tuple_size v))
                    (erlang/== (maps/get :generation desc) (erlang/element 1 v)))))
      (tuple :ok (erlang/element 2 (erlang/element 2 (erlang/hd row))))
      (materialize_per_env desc env resolved_ns resolved_name ikey))))

(defn- materialize_per_env
  "Run a per-env init thunk once, pinned in the loader process, bound to the
   TARGET env + defining ns, and cache under the exact-env instance key. A
   cyclic per-env init is caught deterministically."
  [desc env resolved_ns resolved_name ikey]
  (let [gen (maps/get :generation desc)
        init (maps/get :init desc)]
    (BeamLisp.Loader.Server/run
      (fn []
        (let [row (ets/lookup :beam_lisp_vars (pfx env ikey))]
          (if (and (erlang/== 1 (erlang/length row))
                   (let [v (erlang/element 2 (erlang/hd row))]
                     (and (erlang/is_tuple v) (erlang/== 2 (erlang/tuple_size v))
                          (erlang/== gen (erlang/element 1 v)))))
            (tuple :ok (erlang/element 2 (erlang/element 2 (erlang/hd row))))
            (do
              (guard_per_env_cycle! env resolved_ns resolved_name)
              (try
                (with_env env
                  (fn []
                    (with_ns resolved_ns
                      (fn []
                        ; The env may have been destroyed while queued — fail
                        ; closed rather than resurrect an instance row.
                        (if (and (not (erlang/== :global env)) (erlang/== nil (env_state env)))
                          :error
                          (let [value (init)]
                            ; The thunk may attach another env; publication remains
                            ; pinned to the requested target, just like its instance key.
                            (with_env env (fn [] (put_key ikey (tuple gen value))))
                            (tuple :ok value)))))))
                (finally
                  (unguard_per_env_cycle env resolved_ns resolved_name))))))))))

(defn- guard_per_env_cycle! [env ns name]
  (let [key (tuple env ns name)
        stack (Process/get :bl_per_env_init_stack (list))]
    (if (Enum/member? stack key)
      (erlang/error
        (Elixir.RuntimeError/exception
          (erlang/iolist_to_binary
            (list "cyclic per-env initialization: "
                  (Enum/map_join (erlang/++ (list key) stack) " <- "
                    (fn [t]
                      (erlang/iolist_to_binary
                        (list (Kernel/inspect (erlang/element 1 t)) " "
                              (erlang/element 2 t) "/" (erlang/element 3 t)))))))))
      (Process/put :bl_per_env_init_stack (erlang/++ (list key) stack)))))

(defn- unguard_per_env_cycle [env ns name]
  (let [key (tuple env ns name)
        stack (Process/get :bl_per_env_init_stack (list))]
    (if (and (erlang/is_list stack)
             (not (erlang/== 0 (erlang/length stack)))
             (erlang/== key (erlang/hd stack)))
      (Process/put :bl_per_env_init_stack (erlang/tl stack))
      (Process/put :bl_per_env_init_stack (List/delete stack key)))))

(defn fetch
  "Resolve `name`, looking in `ns` first, then referred vars, then `core`
   (and `sugar`). Each candidate pair is tried across the whole env chain
   before moving to the next candidate."
  [ns name]
  (let [memo_key (tuple :env_fetch_memo (chain) ns name)
        cached (Process/get memo_key)]
    (cond
      (erlang/== nil cached) (fetch_fresh ns name memo_key)
      (and (erlang/is_tuple cached) (erlang/== 2 (erlang/tuple_size cached)))
      (if (erlang/== (erlang/element 1 cached) (current_epoch))
        (erlang/element 2 cached)
        (fetch_fresh ns name memo_key))
      :else (erlang/error (Elixir.CaseClauseError/exception (list (tuple :term cached)))))))

(defn- fetch_fresh [ns name memo_key]
  ; Resolve declared providers before falling through to core. An unloaded
  ; referred `map` must not silently resolve to core/map. The loader ignores
  ; undeclared candidates, and the epoch is sampled AFTER any initialization.
  (BeamLisp.Loader/load_candidates (candidates ns name))
  (let [epoch (current_epoch)
        result (fetch_uncached ns name)]
    (Process/put memo_key (tuple epoch result))
    result))

(defn- fetch_uncached [ns name]
  (fetch_candidates_uncached (candidates ns name)))

(defn- fetch_candidates_uncached [cands]
  (do
    (Enum/find_value (chain) :error
      (fn [env]
        (Enum/find_value cands nil
          (fn [k]
            (let [cns (erlang/element 1 k)
                  cname (erlang/element 2 k)
                  row (ets/lookup :beam_lisp_vars (pfx env k))]
              (cond
                (erlang/== 0 (erlang/length row)) nil
                (per_env_def? (erlang/element 2 (erlang/hd row)))
                (resolve_per_env (erlang/element 2 (erlang/hd row)) cns cname)
                :else (tuple :ok (erlang/element 2 (erlang/hd row)))))))))))

(defn- exact_candidates [ns name seen]
  (if (Enum/member? seen ns) (list)
    (do
      (BeamLisp.Loader/load_candidates (list (tuple ns name)))
      (let [source (refer_source ns name)]
        (erlang/++ (list (tuple ns name))
          (if (erlang/== nil source) (list)
            (exact_candidates source name (erlang/++ (list ns) seen))))))))

(defn- fetch_exact_fresh [ns name memo_key]
  (let [pairs (exact_candidates ns name (list))]
    (let [epoch (current_epoch) result (fetch_candidates_uncached pairs)]
      (Process/put memo_key (tuple epoch result))
      result)))

(defn fetch_exact
  "Resolve an already-qualified namespace member, including explicit re-exports.
   No aliases or implicit core fallback. Shares per-env materialization and epoch validity with fetch."
  [ns name]
  (let [memo_key (tuple :env_fetch_exact_memo (chain) ns name)
        cached (Process/get memo_key)]
    (cond
      (erlang/== nil cached) (fetch_exact_fresh ns name memo_key)
      (and (erlang/is_tuple cached) (erlang/== 2 (erlang/tuple_size cached)))
      (if (erlang/== (erlang/element 1 cached) (current_epoch))
        (erlang/element 2 cached)
        (fetch_exact_fresh ns name memo_key))
      :else (erlang/error (Elixir.CaseClauseError/exception (list (tuple :term cached)))))))

(defn fetch_exact!
  "Exact provider lookup, raising the canonical qualified name on a miss."
  [ns name]
  (let [r (fetch_exact ns name)]
    (if (and (erlang/is_tuple r) (erlang/== 2 (erlang/tuple_size r))
             (erlang/== :ok (erlang/element 1 r)))
      (erlang/element 2 r)
      (erlang/error
        (Elixir.RuntimeError/exception
          (erlang/iolist_to_binary (list "undefined var: " ns "/" name)))))))

(defn peek_initialized
  "Observe an already-bound qualified var without loading a namespace or
   running a per-env initializer. Returns {:ok, value} (including nil/false),
   or :error for absent/uninitialized/stale/in-flight bindings. No alias,
   refer or core fallback. A per-env value belongs to the CURRENT scope only."
  [ns name]
  :when (and (string? ns) (string? name))
  (let [names (list ns) before (namespace_generations names)]
    (if (erlang/== nil before) :error
      (let [raw (lookup (tuple ns name))
            result
            (if (and (erlang/is_tuple raw) (erlang/== 2 (erlang/tuple_size raw))
                     (erlang/== :ok (erlang/element 1 raw)))
              (let [value (erlang/element 2 raw)]
                (if (per_env_def? value)
                  (let [instance (lookup_own (per_env_instance_key ns name))]
                    (if (and (erlang/is_tuple instance) (erlang/== :ok (erlang/element 1 instance))
                             (let [cached (erlang/element 2 instance)]
                               (and (erlang/is_tuple cached) (erlang/== 2 (erlang/tuple_size cached))
                                    (erlang/== (maps/get :generation value) (erlang/element 1 cached)))))
                      (tuple :ok (erlang/element 2 (erlang/element 2 instance))) :error))
                  raw)) :error)]
        (if (erlang/== before (namespace_generations names)) result :error)))))

(defn peek
  "Like `fetch/2` but NON-materializing: a `^:per-env` var resolves to its
   descriptor, never a value."
  [ns name]
  (let [cands (candidates ns name)]
    (Enum/find_value (chain) :error
      (fn [env]
        (Enum/find_value cands nil
          (fn [k]
            (let [row (ets/lookup :beam_lisp_vars (pfx env k))]
              (if (erlang/== 0 (erlang/length row))
                nil
                (tuple :ok (erlang/element 2 (erlang/hd row)))))))))))

(defn bound?
  "Whether `ns/name` binds at all (per-env descriptor counts), without
   materializing."
  [ns name]
  (let [r (peek ns name)]
    (and (erlang/is_tuple r) (erlang/== 2 (erlang/tuple_size r))
         (erlang/== :ok (erlang/element 1 r)))))

(defn- candidates
  "The candidate `{ns, name}` pairs a lookup should try, in order."
  [ns name]
  (let [parts (String/split name "/" (list (tuple :parts 2)))
        p0 (erlang/hd parts)]
    (cond
      (erlang/== "" p0)
      (erlang/++ (list (tuple ns name))
        (erlang/++ (refer_candidate ns name)
          (list (tuple "core" name) (tuple "sugar" name))))

      (erlang/== 2 (erlang/length parts))
      (let [at (alias_target ns p0)]
        (list (tuple (if (erlang/== nil at) p0 at) (erlang/hd (erlang/tl parts)))))

      :else
      (let [plain p0]
        (erlang/++ (list (tuple ns plain))
          (erlang/++ (refer_candidate ns plain)
            (list (tuple "core" plain) (tuple "sugar" plain))))))))
(defn add_alias
  "Record `alias` as shorthand for `target` inside `ns`."
  [ns alias_ target]
  (put_key (tuple :alias ns alias_) target)
  :ok)

(defn add_import
  "Record that `(:import [pkg Class])` in `ns` names the host class `qualified`
   by its short name. A class import is a DECLARATION, not a load."
  [ns short qualified]
  (put_key (tuple :import ns short) qualified)
  :ok)

(defn import_target
  "The fully-qualified class `short` was imported as inside `ns`, or nil."
  [ns short]
  (let [r (lookup (tuple :import ns short))]
    (if (and (erlang/is_tuple r) (erlang/== 2 (erlang/tuple_size r))
             (erlang/== :ok (erlang/element 1 r)))
      (erlang/element 2 r)
      nil)))

(defn add_core_excludes
  "The core names `ns` declared it shadows with `(:refer-clojure :exclude [...])`."
  [ns names]
  (if (erlang/is_list names)
    (do
      (put_key (tuple :refer_clojure_exclude ns) names)
      :ok)
    (fce! :add_core_excludes 2)))

(defn core_excludes [ns]
  (let [r (lookup (tuple :refer_clojure_exclude ns))]
    (if (and (erlang/is_tuple r) (erlang/== 2 (erlang/tuple_size r))
             (erlang/== :ok (erlang/element 1 r)))
      (erlang/element 2 r)
      (list))))

(defn alias_target
  "The namespace `alias` points to inside `ns`, if any."
  [ns alias_]
  (let [r (lookup (tuple :alias ns alias_))]
    (if (and (erlang/is_tuple r) (erlang/== 2 (erlang/tuple_size r))
             (erlang/== :ok (erlang/element 1 r)))
      (erlang/element 2 r)
      nil)))

(defn public_names
  "Every public var name interned in `ns` — the UNION over the env chain.
   Private vars are filtered here, so `:refer :all` can never smuggle in a name
   the explicit form would have refused."
  [ns]
  (let [names (Enum/uniq (List/flatten (match (tuple (tuple ns :"$1") :_))))]
    (Enum/reject names
      (fn [name]
        (let [m (meta ns name)]
          (and (erlang/is_tuple m) (erlang/== 2 (erlang/tuple_size m))
               (erlang/== :ok (erlang/element 1 m))
               (erlang/is_map (erlang/element 2 m))
               (erlang/== true (maps/get :private (erlang/element 2 m) nil))))))))

(defn add_refer
  "Refer `name` into `ns` so it resolves bare, as if defined there."
  [ns name source_ns]
  (put_key (tuple :refer ns name) source_ns)
  :ok)

(defn add_refer_all
  "Refer every public var of `source_ns` into `ns` — a snapshot taken when the
   `(ns …)` form runs."
  [ns source_ns]
  (Enum/each (public_names source_ns) (fn [name] (add_refer ns name source_ns)))
  :ok)

(defn local_var?
  "True when `name` is interned in `ns` itself, ancestors counting (read-through)."
  [ns name]
  (member? (tuple ns name)))

(defn refer_source
  "The namespace `name` was referred into `ns` from, or nil."
  [ns name]
  (let [r (lookup (tuple :refer ns name))]
    (if (and (erlang/is_tuple r) (erlang/== 2 (erlang/tuple_size r))
             (erlang/== :ok (erlang/element 1 r)))
      (erlang/element 2 r)
      nil)))

(defn- refer_candidate [ns name]
  (let [s (refer_source ns name)]
    (if (erlang/== nil s) (list) (list (tuple s name)))))

(defn declare_ns
  "Record that `ns` exists, independently of whether anything is interned in it
   yet."
  [ns]
  (if (erlang/is_binary ns)
    (do
      (put_key (tuple :ns ns) true)
      :ok)
    (fce! :declare_ns 1)))

(defn- ns_exists_uncached?
  "True when `ns` has been declared by an `(ns …)` form, or has any var
   interned in it, anywhere in the env chain."
  [ns]
  (Enum/any? (chain)
    (fn [env]
      (let [row (ets/lookup :beam_lisp_vars (pfx env (tuple :ns ns)))]
        (cond
          (and (erlang/== 1 (erlang/length row))
               (erlang/== true (erlang/element 2 (erlang/hd row)))) true

          (erlang/== 0 (erlang/length row))
          (let [m (ets/match :beam_lisp_vars (tuple (pfx env (tuple ns :_)) :_) 1)]
            (and (erlang/is_tuple m) (erlang/== 2 (erlang/tuple_size m))
                 (erlang/is_list (erlang/element 1 m))
                 (erlang/== 1 (erlang/length (erlang/element 1 m))))))))))

(defn ns_exists?
  "Namespace membership with a bounded process-local publication certificate.
   Both positive and negative answers invalidate on namespace/bulk publication,
   env chain/lifetime changes, or an in-flight writer. No guessed negative TTL."
  [ns]
  (if (erlang/not (and (erlang/is_binary ns)
                       (erlang/=< (erlang/byte_size ns) 512)
                       (erlang/=< (erlang/length (chain)) 32)))
    (ns_exists_uncached? ns)
    (let [certificate (namespace_generations (list ns))
          k (tuple (own-module) :ns_exists_cache)
          cache (Process/get k {})
          hit (maps/get ns cache nil)]
      (if (and certificate (erlang/is_tuple hit)
               (erlang/== certificate (erlang/element 1 hit)))
        (erlang/element 2 hit)
        (let [answer (ns_exists_uncached? ns)]
          (when (and certificate (erlang/== certificate (namespace_generations (list ns))))
            (Process/put k (maps/put ns (tuple certificate answer)
                            (if (erlang/< (erlang/map_size cache) 128) cache {}))))
          answer)))))

; ── readiness: the cheap mirror the emitted guard reads ──────────────────
;
; `loaded_ns?/1` is the authority on whether a namespace's top-level init has
; run, but it answers through the Agent for `:global` — too expensive to ask on
; a call path. `mark_ready/1` therefore writes a one-row ETS MIRROR of the same
; decision (it is called from `mark_loaded/1`, never independently), and
; `ns_ready?/1` reads that mirror. A `false` from the mirror means only
; "cannot prove it is ready": the caller takes the loader path, which
; re-decides from the authority.

(defn mark_ready
  "Record `ns`'s top-level init as done in the CURRENT env — the cheap mirror
   `ns_ready?/1` reads. `mark_loaded/1` calls it, so there is ONE readiness
   decision in the system, made in one place, whether the namespace came from
   source or from an AOT `__bl_init__` replay."
  [ns]
  (if (erlang/is_binary ns)
    (with_scope_commit (env_id) (fn []
      (ets/insert :beam_lisp_vars (tuple (key (tuple :ns_ready ns)) true))
      ;; A GLOBAL readiness is permanent for the VM (readiness is never
      ;; retracted), so it is also published where the guard reads it in O(1)
      ;; without walking the env chain: one persistent_term key per namespace.
      ;; Written once per namespace, so the global GC it triggers is paid once.
      (when (erlang/== :global (env_id))
        (persistent_term/put (tuple :beam_lisp_ns_ready ns) true))
      (bump_epoch)
      :ok))
    (fce! :mark_ready 1)))

(defn ns_ready?
  "The cheap POSITIVE readiness test the emitted cross-namespace guard asks:
   has `ns`'s top-level init already run in an env on this chain?

   This runs AHEAD OF EVERY DIRECT CROSS-NAMESPACE CALL, so its cost is a tax
   on the whole language: built through the variadic `(tuple …)` prelude
   constructor and `pfx`'s Tuple/insert_at, one guard measured ~600
   reductions — `datom.index/-tx`, a one-field read, cost 633 reductions per
   call against 6 for a core call, and a render made millions of them. The key
   is the 3-tuple `{env, :ns_ready, ns}` (what `pfx` builds from `{:ns_ready,
   ns}`), built here with the BIF directly, and the chain is walked with a
   direct self-recursion instead of an Enum closure."
  [ns]
  (cond
    ;; Fast path: ready in the global env — every chain ends in :global, so a
    ;; global readiness answers yes for any env. No chain walk, no ETS key.
    ;; (Global teardown is terminal and poisons this VM's certification, so a
    ;; destroyed global env never answers from a fact written before it.)
    (and (erlang/== true (persistent_term/get (tuple :beam_lisp_ns_ready ns) false))
         (erlang/not (persistent_term/get (tuple (own-module) :global_destroyed) false))) true
    ;; No vars table means no running Env: nothing is ready yet. A packaged
    ;; launcher can apply a shim before the app starts; its guard must then
    ;; reach the boot path, not crash on the missing table.
    (erlang/== :undefined (ets/whereis :beam_lisp_vars)) false
    (erlang/is_binary ns) (ns_ready_in? (chain) ns)
    :else false))

(defn ns_ready_in?
  "INTERNAL: is `ns` marked ready in any env of `envs`?"
  [envs ns]
  (cond
    (erlang/== envs ()) false
    (ets/member :beam_lisp_vars
                (erlang/list_to_tuple (erlang/++ (erlang/++ (erlang/++ () (list (erlang/hd envs))) (list :ns_ready)) (list ns))))
    true
    :else (ns_ready_in? (erlang/tl envs) ns)))

(defn loaded_ns? [ns]
  (Enum/any? (chain)
    (fn [env]
      (if (erlang/== :global env)
        (Agent/get (own-module) (fn [s] (MapSet/member? (Map/get s :loaded) ns)))
        (let [st (env_state env)]
          (if (erlang/== nil st)
            false
            (let [l (Map/get st :loaded)]
              (if (erlang/== nil l) false (MapSet/member? l ns)))))))))

(defn mark_loaded [ns]
  (if (erlang/== :global (env_id))
    (do
      (Agent/update (own-module)
        (fn [s] (Map/put s :loaded (MapSet/put (Map/get s :loaded) ns))))
      (mark_ready ns))
    (do
      (update_env_state (env_id)
        (fn [st] (Map/put st :loaded (MapSet/put (Map/get st :loaded) ns))))
      (mark_ready ns))))

; ── ns_defs: a map in ETS, or a reference to the beam that already holds it ──
;
; An AOT-compiled namespace's shim beam carries its whole def table as a LITERAL
; (`__bl_ns_defs__/0`): the VM keeps one shared copy of a literal and returns it
; without copying. Storing a second copy in ETS cost the compiler's own
; namespaces ~70 MB on a long-lived server, and every ETS read re-copied a whole
; namespace's ASTs onto the caller's heap (33-39 ms for `compiler`/`rt`). So the
; init replay stores `{:"$beam", Mod}` here, and `ns_defs/1` asks the beam.
;
; Live writes use {$definitions, generation, count, pending_tombstone} and
; separately keyed wrapped entries. Descriptor plus entries publish atomically.
; Incremental writes touch only the changed entry/count; full APIs materialize
; deliberately. Legacy map rows remain readable during migration. The namespace
; root key is unchanged, preserving whole-table shadowing and namespaces/0.
; Every row starts with its owning env, so destruction reclaims all generations.

(defn- resolve_ns_defs
  "The def map a stored `ns_defs` value stands for. A reference to a module that
   is not loaded, or no longer exports the table, resolves to the empty map — the
   answer for a namespace that has not been initialised. `Link/defvar`
   materialises every reference BEFORE it replaces a shim, so that state is
   unreachable from a live reload. Legacy map values remain readable."
  [v]
  (cond
    (erlang/is_map v) v
    (and (erlang/is_tuple v) (erlang/== 2 (erlang/tuple_size v))
         (erlang/== :"$beam" (erlang/element 1 v))
         (erlang/function_exported (erlang/element 2 v) :__bl_ns_defs__ 0))
    (erlang/apply (erlang/element 2 v) :__bl_ns_defs__ (list))
    :else (maps/new)))

(defn- entries_descriptor? [v]
  (and (erlang/is_tuple v) (erlang/== 4 (erlang/tuple_size v))
       (erlang/== :"$definitions" (erlang/element 1 v))))

(defn- definition_entry_key [env ns generation name]
  (tuple env :ns_definition ns generation name))

(defn- namespace_table_row [ns]
  (Enum/find_value (chain) nil (fn [env]
    (let [rows (ets/lookup :beam_lisp_vars (pfx env (tuple :ns_defs ns)))]
      (when (erlang/not (erlang/== (list) rows))
        (tuple env (erlang/element 2 (erlang/hd rows))))))))

(defn- materialize_table [env ns v]
  (if (entries_descriptor? v)
    (Enum/reduce
      (ets/match_object :beam_lisp_vars
        (tuple (definition_entry_key env ns (erlang/element 2 v) :_) :_))
      (maps/new)
      (fn [row out]
        (let [value (erlang/element 2 row)]
          (if (and (erlang/is_tuple value) (erlang/== 2 (erlang/tuple_size value))
                   (erlang/== :definition (erlang/element 1 value)))
            (Map/put out (erlang/element 5 (erlang/element 1 row)) (erlang/element 2 value))
            out))))
    (resolve_ns_defs v)))

(defn- cleanup_definition_generations [env ns visible]
  (ets/select_delete :beam_lisp_vars
    (list (tuple
      (tuple (tuple env :ns_definition ns :"$1" :_) :_)
      (list (tuple :/= :"$1" (tuple :const visible))) (list true)))))

(defn- cleanup_definition_tombstone [env ns v]
  (when (and (entries_descriptor? v) (erlang/not (erlang/== nil (erlang/element 4 v))))
    (ets/delete :beam_lisp_vars
      (definition_entry_key env ns (erlang/element 2 v) (erlang/element 4 v)))))

(defn- replace_namespace_table [env ns defs]
  ;; Caller holds namespace then scope lock. Cleanup never touches the currently
  ;; visible generation, even if a writer dies before/after the atomic batch.
  (let [k (pfx env (tuple :ns_defs ns)) rows (ets/lookup :beam_lisp_vars k)
        old (when (erlang/not (erlang/== (list) rows)) (erlang/element 2 (erlang/hd rows)))
        visible (when (entries_descriptor? old) (erlang/element 2 old))]
    (cleanup_definition_generations env ns visible)
    (if (erlang/is_map defs)
      (let [generation (erlang/unique_integer (list :positive))
            descriptor (tuple :"$definitions" generation (erlang/map_size defs) nil)
            entries (Enum/map defs (fn [pair]
                      (tuple (definition_entry_key env ns generation (erlang/element 1 pair))
                             (tuple :definition (erlang/element 2 pair)))))]
        (ets/insert :beam_lisp_vars (erlang/++ (list (tuple k descriptor)) entries))
        (cleanup_definition_generations env ns generation))
      (do
        ;; Lazy AOT literals stay lazy and shared; no second AST copy in ETS.
        (ets/insert :beam_lisp_vars (tuple k defs))
        (cleanup_definition_generations env ns nil)))
    (bump_epoch)
    :ok))

(defn- current_namespace_table [env ns]
  (let [rows (ets/lookup :beam_lisp_vars (pfx env (tuple :ns_defs ns)))]
    (when (erlang/not (erlang/== (list) rows)) (erlang/element 2 (erlang/hd rows)))))

(defn ns_defs
  "Materialize the first namespace table. Re-read its descriptor inside the
   owner scope lock: physical provider detachment can change a lazy root while
   a reader waits for that lock, without taking the reader's namespace lock."
  [ns]
  (with_namespace_lock ns (fn []
    (let [row (namespace_table_row ns)]
      (if row
        (let [env (erlang/element 1 row)
              result (with_scope_commit env
                       (fn [] (materialize_table env ns (current_namespace_table env ns))))]
          (if (erlang/== :retired result) (maps/new) result))
        (maps/new))))))

(defn selected_ns_definitions
  "Coherent projection of named definitions. Never materialize unrelated ASTs."
  [ns names]
  (with_namespace_lock ns
    (fn []
      (Enum/reduce names (maps/new)
        (fn [name acc]
          (let [entries (ns_definition ns name)]
            (if (erlang/== nil entries) acc (maps/put name entries acc))))))))

(defn ns_definition_count
  "Count live descriptors without copying ASTs. Lazy providers recheck their
   root under the owner fence before dereferencing native literal code."
  [ns]
  (with_namespace_lock ns (fn []
    (let [row (namespace_table_row ns)]
      (if row
        (let [v (erlang/element 2 row)]
          (cond
            (entries_descriptor? v) (erlang/element 3 v)
            (erlang/is_map v) (erlang/map_size v)
            :else
            (let [env (erlang/element 1 row)
                  result (with_scope_commit env
                           (fn []
                             (let [current (current_namespace_table env ns)]
                               (if (entries_descriptor? current) (erlang/element 3 current)
                                 (erlang/map_size (resolve_ns_defs current))))))]
              (if (erlang/== :retired result) 0 result))))
        0)))))

(defn- invalidate_normal_declaration [env ns name]
  ;; An untracked runtime overwrite cannot preserve an earlier public fact.
  ;; This only denies previously recorded names; it never infers declarations
  ;; or publicity from a value, body table, alias or publication occurrence.
  (let [collector (Process/get :bl_definition_collector)
        declarations (when collector (Map/get collector :declarations {}))
        names (when declarations (Map/get declarations ns {}))]
    (when (and collector (erlang/== env (Map/get collector :env))
               (Map/get collector :declaration-token) (Map/has_key? names name))
      (Process/put :bl_definition_collector
        (Map/put collector :declarations
          (Map/put (Map/put declarations ns (Map/put names name :unavailable))
            :callable-kinds (Map/put (Map/get declarations :callable-kinds {}) ns
                              (Map/put (Map/get (Map/get declarations :callable-kinds {}) ns {}) name :unavailable))))))))

(defn- record_definition [env ns name]
  ;; Execution-local compilation bookkeeping, never conveyed to another worker.
  ;; Nested compilation masks/restores its parent collector. No AST copies.
  (invalidate_normal_declaration env ns name)
  (let [collector (Process/get :bl_definition_collector)]
    (when (and collector (erlang/== env (Map/get collector :env)))
      (let [names (Map/get collector :names {})]
        (Process/put :bl_definition_collector
          (Map/put collector :names
            (Map/update names ns (MapSet/new (list name))
              (fn [previous] (MapSet/put previous name)))))))))

(defn put_ns_definition
  "Publish one live entry/count atomically; inherited or lazy tables transition
   once. Ordinary incremental definitions never read unrelated AST rows."
  [ns name entries]
  (with_namespace_lock ns (fn []
    (let [env (env_id) k (pfx env (tuple :ns_defs ns)) rows (ets/lookup :beam_lisp_vars k)
          own (when (erlang/not (erlang/== (list) rows)) (erlang/element 2 (erlang/hd rows)))]
      (if (entries_descriptor? own)
        (with_scope_commit env (fn []
          (with_publication ns (fn []
            (cleanup_definition_tombstone env ns own)
            (let [entry-key (definition_entry_key env ns (erlang/element 2 own) name)
                  count (erlang/+ (erlang/element 3 own)
                          (if (ets/member :beam_lisp_vars entry-key) 0 1))]
              (ets/insert :beam_lisp_vars
                (list (tuple entry-key (tuple :definition entries))
                      (tuple k (tuple :"$definitions" (erlang/element 2 own) count nil))))
              (bump_epoch)
              (record_definition env ns name)
              :ok)))))
        ;; Read inherited metadata before acquiring the child's commit lock.
        (let [defs (Map/put (ns_defs ns) name entries)]
          (with_scope_commit env (fn []
            (with_publication ns (fn []
              (replace_namespace_table env ns defs)
              (record_definition env ns name) :ok))))))))))

(defn delete_ns_definition
  "Atomic metadata deletion/count with one recoverable tombstone. An own empty
   table continues to shadow the whole parent table."
  [ns name]
  (with_namespace_lock ns (fn []
    (let [env (env_id) k (pfx env (tuple :ns_defs ns)) rows (ets/lookup :beam_lisp_vars k)
          own (when (erlang/not (erlang/== (list) rows)) (erlang/element 2 (erlang/hd rows)))]
      (if (entries_descriptor? own)
        (with_scope_commit env (fn []
          (with_publication ns (fn []
            (cleanup_definition_tombstone env ns own)
            (let [entry-key (definition_entry_key env ns (erlang/element 2 own) name)
                  count (erlang/- (erlang/element 3 own)
                          (if (ets/member :beam_lisp_vars entry-key) 1 0))]
              (ets/insert :beam_lisp_vars
                (list (tuple entry-key :"$deleted")
                      (tuple k (tuple :"$definitions" (erlang/element 2 own) count name))))
              (ets/delete :beam_lisp_vars entry-key)
              (bump_epoch)
              :ok)))))
        (let [defs (Map/delete (ns_defs ns) name)]
          (with_scope_commit env (fn []
            (with_publication ns (fn [] (replace_namespace_table env ns defs)))))))))))

(defn ns_definition
  "One definition from the first namespace table in the current env chain.
   Live descriptors read only the selected row; legacy maps are projected in
   ETS. No unrelated AST is copied. Own tables shadow the entire parent table,
   even on a miss. Lazy AOT tables resolve through their shared module literal."
  [ns name]
  :when (and (string? ns) (string? name))
  (with_namespace_lock ns (fn []
  (let [row (Enum/find_value (chain) :error
               (fn [env]
                 (let [k (pfx env (tuple :ns_defs ns))
                       found (ets/select :beam_lisp_vars
                         (list
                           (tuple (tuple k :"$1")
                             (list (tuple :is_map :"$1")
                                   (tuple :is_map_key (tuple :const name) :"$1"))
                             (list (tuple (tuple :ok (tuple :map_get (tuple :const name) :"$1")))))
                           (tuple (tuple k :"$1") (list (tuple :is_map :"$1"))
                             (list (tuple (tuple :ok nil))))
                           (tuple (tuple k :"$1") (list)
                             (list (tuple (tuple :descriptor (tuple :const env) :"$1"))))))]
                   (if (erlang/== (list) found) nil (erlang/hd found)))))]
    (cond
      (erlang/== :error row) nil
      (erlang/== :ok (erlang/element 1 row)) (erlang/element 2 row)
      :else
      (let [env (erlang/element 2 row)
            result (with_scope_commit env (fn []
                     (let [v (current_namespace_table env ns)]
                       (if (entries_descriptor? v)
                         (let [rows (ets/lookup :beam_lisp_vars
                                      (definition_entry_key env ns (erlang/element 2 v) name))]
                           (when (erlang/not (erlang/== (list) rows))
                             (let [entry (erlang/element 2 (erlang/hd rows))]
                               (when (erlang/is_tuple entry) (erlang/element 2 entry)))))
                         (Map/get (resolve_ns_defs v) name)))))]
        (if (erlang/== :retired result) nil result)))))))

(defn put_ns_defs [ns defs]
  (with_namespace_lock ns (fn []
    (let [commit (fn [value]
                   (with_scope_commit (env_id) (fn []
                     (with_publication ns (fn []
                       (replace_namespace_table (env_id) ns value)
                       (let [collector (Process/get :bl_definition_collector)]
                        (when (and collector (erlang/== (env_id) (Map/get collector :env)))
                         (Enum/each (Map/keys (resolve_ns_defs value))
                           (fn [name] (record_definition (env_id) ns name))))) :ok)))))]
      (if (and (erlang/is_tuple defs) (erlang/== 2 (erlang/tuple_size defs))
               (erlang/== :"$beam" (erlang/element 1 defs)))
        (with_module_locks (list (erlang/element 2 defs))
          (fn []
            (commit (if (erlang/function_exported (erlang/element 2 defs) :__bl_ns_defs__ 0)
                      defs (maps/new)))))
        (commit defs))))))

(defn link_ns_defs
  "Register a loaded AOT literal under physical provider ownership. An absent
   provider becomes an own empty table, never a pointer that silently changes
   when somebody later loads that module."
  [ns mod]
  (with_namespace_lock ns (fn []
    (with_publication ns
      (fn []
        (with_module_locks (list mod)
          (fn []
            (put_ns_defs ns (tuple :"$beam" mod))
            (if (erlang/function_exported mod :__bl_ns_defs__ 0)
              (mark_emitted ns mod)
              (do
                (match_delete_own (tuple (tuple :emitted_definition ns :_) :_))
                (delete_key (tuple :emitted_publication ns)))))))))))

(defn unlink_ns_defs
  "Detach every live env's AOT table before replacing its shim. Serialize with
   namespace publishers and recheck each scope inside the destruction fence."
  [ns]
  (with_namespace_lock ns (fn []
    (Enum/each
      (ets/match_object :beam_lisp_vars
        (tuple (tuple :_ :ns_defs ns) (tuple :"$beam" :_)))
      (fn [row]
        (let [k (erlang/element 1 row) env (erlang/element 1 k)]
          (with_scope_commit env (fn []
            ;; A general key writer may have replaced the table since the scan.
            (when (erlang/== (list row) (ets/lookup :beam_lisp_vars k))
              (replace_namespace_table env ns (resolve_ns_defs (erlang/element 2 row)))))))))
    (bump_epoch)
    :ok)))

(defn undefine_var
  "Remove `name` from `ns` entirely: its value binding, its link-info, its
   per-env instance row and its entry in the ns_defs registry. The primitive
   behind namespace-level reload."
  [ns name]
  (if (and (erlang/is_binary ns) (erlang/is_binary name))
    (with_namespace_lock ns (fn []
     (with_publication ns (fn []
      (delete_key (tuple ns name))
      (delete_key (tuple :link ns name))
      (delete_key (tuple :emitted_definition ns name))
      (delete_key (per_env_instance_key ns name))
      (delete_ns_definition ns name)
      :ok))))
    (fce! :undefine_var 2)))

(defn own_names
  "Names interned directly in `ns` in the CURRENT env only (no read-through,
   no refers, no core)."
  [ns]
  (if (erlang/is_binary ns)
    (Enum/uniq (List/flatten (ets/match :beam_lisp_vars (tuple (key (tuple ns :"$1")) :_))))
    (fce! :own_names 1)))

(defn callers_of
  "Every live var, across ALL namespaces, that statically calls `target_ns/name`
   as a qualified remote call — returned as `[{caller_ns, caller_name} …]`,
   excluding the target's own namespace."
  [target_ns name]
  (if (and (erlang/is_binary target_ns) (erlang/is_binary name))
    (let [target_mod (BeamLisp.Emit/module_for target_ns)
          fname (String/to_atom name)
          target (tuple target_ns name target_mod fname)
          hits (Enum/flat_map (namespaces)
                 (fn [caller_ns]
                   (if (erlang/== caller_ns target_ns)
                     (list)
                     (Enum/flat_map (ns_defs caller_ns)
                       (fn [pair]
                         (let [vname (erlang/element 1 pair)
                               entries (erlang/element 2 pair)]
                           (if (ast_calls_remote? entries target)
                             (list (tuple caller_ns vname))
                             (list))))))))]
      (Enum/uniq hits))
    (fce! :callers_of 2)))

(defn- ast_calls_remote? [entries target]
  (if (erlang/is_list entries)
    (Enum/any? entries (fn [entry] (node_calls_remote? (erlang/element 4 entry) target)))
    false))

(defn- elixir_dot_parts
  "The `{mod, f}` pair when `x` is the Elixir-AST remote node `{:., _, [mod, f]}`,
   else nil."
  [x]
  (if (and (erlang/is_tuple x) (erlang/== 3 (erlang/tuple_size x))
           (erlang/== (String/to_atom ".") (erlang/element 1 x))
           (erlang/is_list (erlang/element 3 x))
           (erlang/== 2 (erlang/length (erlang/element 3 x))))
    (let [l (erlang/element 3 x)]
      (tuple (erlang/hd l) (erlang/hd (erlang/tl l))))
    nil))
(defn- node_calls_remote?
  "A depth-first walk of a compiled def for a reference to the target var.
   Matches the bl-ANF shapes first (`:remote` static, `:global`), then the
   legacy Elixir-AST shapes."
  [node target]
  (let [tns (erlang/element 1 target)
        name (erlang/element 2 target)
        tmod (erlang/element 3 target)
        fname (erlang/element 4 target)]
    (cond
      ; ANF static  — `%{op: :remote, mod: TargetModule, fun: :fname}`
      (and (erlang/is_map node)
           (maps/is_key :op node) (maps/is_key :mod node) (maps/is_key :fun node)
           (erlang/== :remote (maps/get :op node)))
      (or (and (erlang/== tmod (maps/get :mod node))
               (erlang/== fname (maps/get :fun node)))
          (node_calls_remote? (maps/values (maps/remove :op node)) target))

      ; ANF global  — `%{op: :global, ns: "target.ns", name: "name"}`
      (and (erlang/is_map node)
           (maps/is_key :op node) (maps/is_key :ns node) (maps/is_key :name node)
           (erlang/== :global (maps/get :op node)))
      (and (erlang/== tns (maps/get :ns node)) (erlang/== name (maps/get :name node)))

      ; any other map: walk its values
      (erlang/is_map node)
      (node_calls_remote? (maps/values (maps/remove :ann node)) target)

      ; AST static/dynamic — a 3-tuple whose head is `{:., _, [mod, f]}`
      (and (erlang/is_tuple node) (erlang/== 3 (erlang/tuple_size node))
           (not (erlang/== nil (elixir_dot_parts (erlang/element 1 node)))))
      (let [parts (elixir_dot_parts (erlang/element 1 node))
            mod (erlang/element 1 parts)
            f (erlang/element 2 parts)
            args (erlang/element 3 node)]
        (cond
          ; AST static  — `{:., _, [TargetModule, :fname]}`
          (and (erlang/== tmod mod) (erlang/== fname f)) true

          ; AST dynamic — `BeamLisp.Env.fetch!("target.ns", "name")`
          (and (erlang/is_tuple mod) (erlang/== 3 (erlang/tuple_size mod))
               (erlang/== :__aliases__ (erlang/element 1 mod))
               (erlang/is_list (erlang/element 3 mod))
               (erlang/== 2 (erlang/length (erlang/element 3 mod)))
               (erlang/== :BeamLisp (erlang/hd (erlang/element 3 mod)))
               (erlang/== :Env (erlang/hd (erlang/tl (erlang/element 3 mod))))
               (or (erlang/== :fetch! f) (erlang/== :fetch f))
               (erlang/is_list args)
               (erlang/>= (erlang/length args) 2)
               (erlang/== tns (erlang/hd args))
               (erlang/== name (erlang/hd (erlang/tl args))))
          true

          :else false))

      ; AST `{_a, _meta, args}` — walk the args
      (and (erlang/is_tuple node) (erlang/== 3 (erlang/tuple_size node)))
      (node_calls_remote? (erlang/element 3 node) target)

      (erlang/is_list node)
      (let [n (erlang/length node)]
        (if (erlang/== 0 n)
          false
          (or (node_calls_remote? (erlang/hd node) target)
              (node_calls_remote? (erlang/tl node) target))))

      (and (erlang/is_tuple node) (erlang/== 2 (erlang/tuple_size node)))
      (or (node_calls_remote? (erlang/element 1 node) target)
          (node_calls_remote? (erlang/element 2 node) target))

      (erlang/is_tuple node)
      (node_calls_remote? (erlang/tuple_to_list node) target)

      :else false)))

(defn namespaces
  "Every namespace that exists: defined something OR declared by `(ns …)`."
  []
  (let [from_defs (Enum/flat_map (chain)
                    (fn [env]
                      (ets/select :beam_lisp_vars
                        (list (tuple (tuple (pfx env (tuple :ns_defs :"$1")) :_)
                                     (list)
                                     (list :"$1"))))))
        from_decl (Enum/flat_map (chain)
                    (fn [env]
                      (ets/select :beam_lisp_vars
                        (list (tuple (tuple (pfx env (tuple :ns :"$1")) :_)
                                     (list)
                                     (list :"$1"))))))]
    (Enum/uniq (erlang/++ from_defs from_decl))))

(defn put_link
  "Register link metadata `{module, %{arity => fname}, {min, vfname} | nil}` for
   a fn var."
  [ns name info]
  (put_key (tuple :link ns name) info))

(defn link
  "Resolve link metadata with the same alias/refer/core rules as fetch/2."
  [ns name]
  (let [cands (candidates ns name)]
    (Enum/find_value (chain) :error
      (fn [env]
        (Enum/find_value cands nil
          (fn [pair]
            (let [cns (erlang/element 1 pair)
                  cname (erlang/element 2 pair)
                  row (ets/lookup :beam_lisp_vars (pfx env (tuple :link cns cname)))]
              (if (erlang/== 0 (erlang/length row))
                nil
                (tuple :ok (erlang/element 2 (erlang/hd row)))))))))))

(defn link_owner
  "`link/2`'s answer together with the namespace that SUPPLIED it:
   `{:ok, provider-ns, info}` or `:error`. The compiler needs the provider, not
   just the module, to decide whether a direct call must be guarded by that
   namespace's readiness."
  [ns name]
  (let [cands (candidates ns name)]
    (Enum/find_value (chain) :error
      (fn [env]
        (Enum/find_value cands nil
          (fn [pair]
            (let [cns (erlang/element 1 pair)
                  cname (erlang/element 2 pair)
                  row (ets/lookup :beam_lisp_vars (pfx env (tuple :link cns cname)))]
              (if (erlang/== 0 (erlang/length row))
                (if (or (ets/member :beam_lisp_vars (pfx env pair))
                        (and (erlang/not (erlang/== cns ns))
                             (erlang/not (erlang/== nil (deferred_dirs cns)))
                             (erlang/not (ns_ready? cns))))
                  :error ; Do not bake a core fallback behind an explicit refer.
                  nil)
                (tuple :ok cns (erlang/element 2 (erlang/hd row)))))))))))

(defn put_meta
  "Record `meta` (a map) for `name` in `ns`. Writes MERGE onto the
   chain-visible copy; the latest value wins per key. Returns `:ok`."
  [ns name meta]
  (if (erlang/is_map meta)
    (let [merged (let [r (lookup (tuple :meta ns name))]
                   (if (and (erlang/is_tuple r) (erlang/== 2 (erlang/tuple_size r))
                            (erlang/== :ok (erlang/element 1 r))
                            (erlang/is_map (erlang/element 2 r)))
                     (Map/merge (erlang/element 2 r) meta)
                     meta))]
      (put_key (tuple :meta ns name) merged)
      (when (maps/is_key :private meta) (invalidate_normal_declaration (env_id) ns name))
      :ok)
    (fce! :put_meta 3)))

(defn meta
  "Read the metadata map recorded by `put_meta/3` for `name` in `ns` (no
   resolution)."
  [ns name]
  (lookup (tuple :meta ns name)))

; ── deferred requires ──────────────────────────────────────────────
;
; A `:require` with an alias or an explicit refer list DECLARES its target
; instead of initializing it (`BeamLisp.Loader/declare_require/3`): the target's
; existence (a `:ns` row) and the search dirs the declaration was made under are
; recorded here, so a later lookup can initialize it under its ORIGINAL search
; context rather than the caller's. `fetch/2`'s miss hook and `Loader`'s
; readiness guard read these rows; `destroy/1` removes them with the env, so a
; dropped env can never leave a stale declaration behind.

(defn deferred_dirs
  "The search dirs `target` was declared under, or nil when it was never
   declared deferred — an eager (bare) require, an explicit load, or no require
   at all."
  [target]
  (let [r (lookup (tuple :deferred target))]
    (if (and (erlang/is_tuple r) (erlang/== 2 (erlang/tuple_size r))
             (erlang/== :ok (erlang/element 1 r)))
      (erlang/element 2 r)
      nil)))

(defn note_deferred
  "Record that `target` may be initialized on demand, under `dirs` — the search
   dirs its `:require` was declared with. First declaration wins: a second
   reference cannot silently re-root a namespace another namespace already
   pinned, which also makes the write idempotent."
  [target dirs]
  (if (and (erlang/is_binary target) (erlang/is_list dirs))
    (if (erlang/== nil (deferred_dirs target))
      (do (put_key (tuple :deferred target) dirs) :ok)
      :ok)
    (fce! :note_deferred 2)))

(defn doc_string
  "Resolve `name` through the same alias/refer/core rules as `fetch/2` and
   return its docstring metadata as `%{ns:, name:, doc:}`, else nil."
  [ns name]
  (let [uname (unwrap_doc_name name)
        cands (candidates ns uname)
        found (Enum/find_value (chain)
                (fn [env]
                  (Enum/find_value cands
                    (fn [pair]
                      (let [cns (erlang/element 1 pair)
                            cname (erlang/element 2 pair)
                            row (ets/lookup :beam_lisp_vars (pfx env (tuple :meta cns cname)))]
                        (if (and (erlang/== 1 (erlang/length row))
                                 (erlang/is_map (erlang/element 2 (erlang/hd row)))
                                 (not (erlang/== nil (maps/get :doc (erlang/element 2 (erlang/hd row)) nil))))
                          (tuple cns cname (maps/get :doc (erlang/element 2 (erlang/hd row))))
                          nil))))))]
    (if (erlang/== nil found)
      nil
      (maps/put :ns (erlang/element 1 found)
        (maps/put :name (erlang/element 2 found)
          (maps/put :doc (erlang/element 3 found) (maps/new)))))))

(defn- unwrap_doc_name [name]
  (cond
    (and (erlang/is_tuple name) (erlang/== 2 (erlang/tuple_size name))
         (erlang/== :symbol (erlang/element 1 name)))
    (erlang/element 2 name)

    (erlang/is_binary name) name

    :else (fce! :unwrap_doc_name 1)))

; ── Load paths and search paths ────────────────────────────────────────────

(defn load_paths
  "Directories the loader searches for `<ns>.bl` files, innermost first. At
   `:global` it lives in the Agent; in a fork it is process-local."
  []
  (if (erlang/== :global (env_id))
    (Agent/get (own-module) (fn [s] (Map/get s :load_paths)))
    (Process/get :bl_load_paths (list))))

(defn push_load_path [dir]
  (if (erlang/== :global (env_id))
    (Agent/update (own-module)
      (fn [s] (Map/put s :load_paths (erlang/++ (list dir) (Map/get s :load_paths)))))
    (Process/put :bl_load_paths (erlang/++ (list dir) (load_paths))))
  :ok)

(defn pop_load_path []
  (if (erlang/== :global (env_id))
    (Agent/update (own-module)
      (fn [s] (Map/put s :load_paths (erlang/tl (Map/get s :load_paths)))))
    (Process/put :bl_load_paths (erlang/tl (load_paths))))
  :ok)

(defn search_paths
  "Configured search paths — library roots the loader consults after cwd.
   Reads walk the chain (own env's roots first, then ancestors')."
  []
  (Enum/uniq
    (Enum/flat_map (chain)
      (fn [env]
        (if (erlang/== :global env)
          (Agent/get (own-module) (fn [s] (Map/get s :search_paths (list))))
          (let [st (env_state env)]
            (if (erlang/== nil st) (list) (Map/get st :search_paths))))))))

(defn add_search_path
  "Append a search path (idempotent, order-preserving)."
  [dir]
  (let [d (Path/expand dir)]
    (if (erlang/== :global (env_id))
      (Agent/update (own-module)
        (fn [s]
          (let [paths (Map/get s :search_paths (list))]
            (if (Enum/member? paths d) s (Map/put s :search_paths (erlang/++ paths (list d)))))))
      (update_env_state (env_id)
        (fn [st]
          (let [paths (Map/get st :search_paths)]
            (if (Enum/member? paths d) st (Map/put st :search_paths (erlang/++ paths (list d))))))))))

(defn remove_search_path
  "Remove one configured search path from the current env (no-op if absent)."
  [dir]
  (let [d (Path/expand dir)]
    (if (erlang/== :global (env_id))
      (Agent/update (own-module)
        (fn [s] (Map/put s :search_paths (List/delete (Map/get s :search_paths (list)) d))))
      (update_env_state (env_id)
        (fn [st] (Map/put st :search_paths (List/delete (Map/get st :search_paths) d)))))))

(defn clear_search_paths
  "Drop the current env's configured search paths (test isolation)."
  []
  (if (erlang/== :global (env_id))
    (Agent/update (own-module) (fn [s] (Map/put s :search_paths (list))))
    (update_env_state (env_id) (fn [st] (Map/put st :search_paths (list))))))

(defn fetch!
  "Like `fetch/2`, but raises a `%RuntimeError{}` naming the var on a miss."
  [ns name]
  (let [r (fetch ns name)]
    (if (and (erlang/is_tuple r) (erlang/== 2 (erlang/tuple_size r))
             (erlang/== :ok (erlang/element 1 r)))
      (erlang/element 2 r)
      (erlang/error
        (Elixir.RuntimeError/exception
          (erlang/iolist_to_binary (list "undefined var: " ns "/" name)))))))

(defn seeded?
  []
  (Enum/any? (chain)
    (fn [env]
      (if (erlang/== :global env)
        (Agent/get (own-module) (fn [s] (Map/get s :seeded)))
        false))))

(defn mark_seeded []
  (if (erlang/== :global (env_id))
    (Agent/update (own-module) (fn [s] (Map/put s :seeded true)))
    :ok))

;; Original native start provenance ONLY; this grants no G, Root, app or effect.
(defn- ensure_native_start_tables! []
 ;; Runs ONLY in the actual native Env Agent callback. This also supports an
 ;; official seed build whose Env process predates these new host tables.
 (when-not (erlang/== (erlang/self) (Process/whereis (own-module)))
  (erlang/error :native_start_tables_require_env_owner))
 (Enum/each (list (tuple :beam_lisp_native_owned_starts :private)
                   (tuple :beam_lisp_native_launches :private)
                   (tuple :beam_lisp_native_start_code :protected))
  (fn [item]
   (let [table (erlang/element 1 item) protection (erlang/element 2 item)]
   (if (erlang/== :undefined (ets/whereis table))
    (ets/new table (list :named_table protection :set))
    (when-not (and (erlang/== (erlang/self) (ets/info table :owner))
                  (erlang/== protection (ets/info table :protection))
                  (erlang/== :set (ets/info table :type)))
     (erlang/error :native_start_table_custody_mismatch)))))) :ok)
(defn native_start_table_evidence! []
 (server_start_turn
  (fn []
   (ensure_native_start_tables!)
   (Enum/map (list :beam_lisp_native_owned_starts :beam_lisp_native_launches :beam_lisp_native_start_code)
    (fn [table] {:table table :owner (ets/info table :owner)
                 :protection (ets/info table :protection) :type (ets/info table :type)})))))
(defn- native_boundary_stack! [pid mod function arity]
 (let [info (Process/info pid :current_stacktrace)
       frames (when (erlang/is_tuple info) (erlang/element 2 info))]
  (BeamLisp.AOT/sdk_callable_evidence! (erlang/make_fun mod function arity))
  (when-not (and frames (Enum/any? frames
    (fn [frame] (and (erlang/== mod (erlang/element 1 frame))
                    (erlang/== function (erlang/element 2 frame))
                    (erlang/== arity (erlang/element 3 frame))))))
   (erlang/error :native_original_start_boundary_required))))
(defn- native_module_md5! [module]
 (when-not (and (erlang/is_atom module) (erlang/module_loaded module)
               (erlang/function_exported module :init 1))
  (erlang/error :native_original_start_module_required))
 (erlang/apply module :module_info (list :md5)))
(defn- owned_start_identity [row]
 (Map/put (Map/take row (list :kind :child :creator :ticket :attempt :module :module-md5 :custody-kind))
  :lease-id (when (Map/get row :lease) (erlang/element 3 (Map/get row :lease)))))
(defn- owned_start_lookup [pid]
 (ensure_native_start_tables!)
 (let [rows (ets/lookup :beam_lisp_native_owned_starts pid)]
  (when (erlang/== 1 (erlang/length rows)) (erlang/element 2 (erlang/hd rows)))))
(defn- native_launch_row! [capability]
 (ensure_native_start_tables!)
 (when-not (and (erlang/is_tuple capability) (erlang/== 2 (erlang/tuple_size capability))
               (erlang/== :bl_native_launch (erlang/element 1 capability))
               (erlang/is_reference (erlang/element 2 capability)))
  (erlang/error :invalid_native_original_start_ticket))
 (let [rows (ets/lookup :beam_lisp_native_launches (erlang/element 2 capability))]
  (when-not (erlang/== 1 (erlang/length rows)) (erlang/error :invalid_native_original_start_ticket))
  (erlang/element 2 (erlang/hd rows))))
(defn- owned_start_live! [row require-finish]
 (let [pid (Map/get row :child) lease (Map/get row :lease) kind (Map/get row :custody-kind)]
  (when-not (and row (erlang/is_pid pid) (erlang/is_process_alive pid)
                (erlang/is_process_alive (Map/get row :creator))
                (erlang/module_loaded (Map/get row :module))
                (erlang/== (Map/get row :module-md5)
                  (erlang/apply (Map/get row :module) :module_info (list :md5))))
   (erlang/error :native_original_start_evidence_required))
  (cond
   (erlang/== :unmanaged-native-class kind)
    (let [launch (native_launch_row! (tuple :bl_native_launch (Map/get row :ticket)))]
     (when-not (and (erlang/is_tuple lease) (erlang/== 3 (erlang/tuple_size lease))
                   (erlang/== pid (erlang/element 2 lease)) (code_lease_active? lease)
                   (erlang/== (owned_start_identity row) (owned_start_identity launch))
                   (Enum/member? (if require-finish (list :finished) (list :claimed :finished))
                     (Map/get launch :phase)))
      (erlang/error :native_original_start_evidence_required)))
   (Enum/member? (list :owned-proc :managed) kind)
    (when-not (and (erlang/is_tuple lease) (erlang/== 3 (erlang/tuple_size lease))
                  (erlang/== pid (erlang/element 2 lease)) (code_lease_active? lease))
     (erlang/error :native_original_start_evidence_required))
   :else (erlang/error :native_original_start_evidence_required)) row))
(defn- owned_start_creator_chain [creator]
 ;; Snapshot ORIGINAL receipts at the actual parent's start barrier. Never
 ;; reconstruct ancestry later from PID metadata, names or process dictionaries.
 (let [row (owned_start_lookup creator)]
  (if row
   (do (owned_start_live! row false)
       (Enum/take (erlang/++ (list (owned_start_identity row)) (Map/get row :creator-chain (list))) 2))
   (list))))
(defn- owned_start_prune! []
 ;; Reclaim a bounded batch in the Env owner. With thousands of LIVE children,
 ;; a full-table prune per insertion is quadratic even when it frees nothing.
 ;; The private cursor advances through at most 64 rows per new start.
 (let [cursor (Process/get :bl_owned_start_prune_cursor nil)
       batch (if (and cursor (not= :"$end_of_table" cursor)) (ets/select cursor)
               (ets/select :beam_lisp_native_owned_starts
                 (list (tuple (tuple :"$1" :_) (list) (list :"$1"))) 64))]
  (if (= :"$end_of_table" batch)
   (Process/delete :bl_owned_start_prune_cursor)
   (do
    (Process/put :bl_owned_start_prune_cursor (elem batch 1))
    (Enum/each (elem batch 0)
     (fn [child]
      (when-not (erlang/is_process_alive child)
       (ets/delete :beam_lisp_native_owned_starts child))))))))

(defn- owned_start_insert! [row]
 (ensure_native_start_tables!)
 (when (erlang/>= (ets/info :beam_lisp_native_owned_starts :size) 2048)
  (owned_start_prune!))
 (when (erlang/>= (ets/info :beam_lisp_native_owned_starts :size) 4096)
  ;; At the hard cap, finish a sweep before refusing so dead rows beyond this
  ;; batch cannot produce a false capacity error. Ordinary starts stay bounded.
  (Enum/each (ets/select :beam_lisp_native_owned_starts
               (list (tuple (tuple :"$1" :_) (list) (list :"$1"))))
   (fn [child]
    (when-not (erlang/is_process_alive child)
     (ets/delete :beam_lisp_native_owned_starts child)))))
 (when (erlang/>= (ets/info :beam_lisp_native_owned_starts :size) 4096)
  (erlang/error :native_owned_start_capacity))
 (when-not (ets/insert_new :beam_lisp_native_owned_starts (tuple (Map/get row :child) row))
  (erlang/error :native_owned_start_already_recorded)) :ok)
(defn record_owned_start! [child ticket lease]
 (let [creator (erlang/self) mod :Elixir.BeamLisp.Refs]
  (assert_execution_context!)
  (native_boundary_stack! creator mod :publish_owned_start 3)
  (native_boundary_stack! child mod :await_owned_start 4)
  (when-not (and (erlang/is_reference ticket) (erlang/is_tuple lease)
                (erlang/== 3 (erlang/tuple_size lease))
                (erlang/== child (erlang/element 2 lease))
                (erlang/is_process_alive creator) (erlang/is_process_alive child)
                (code_lease_active? lease))
   (erlang/error :native_owned_start_custody_required))
  (server_start_turn
   (fn []
    (when-not (and (erlang/is_process_alive creator) (erlang/is_process_alive child)
                  (code_lease_active? lease))
     (erlang/error :native_owned_start_custody_required))
    (owned_start_insert! {:kind :owned-proc :custody-kind :owned-proc
                         :child child :creator creator :module mod
                         :module-md5 (erlang/apply mod :module_info (list :md5))
                         :ticket ticket :attempt (erlang/make_ref) :lease lease
                         :creator-chain (owned_start_creator_chain creator)})))))
(defn- retained_server_start! [row native]
 ;; Preserve the already validated genuine managed receipt, original chain and
 ;; actual native owner lease. Never fabricate graph/SDK custody for unmanaged.
 (owned_start_insert!
  (Map/merge (Map/take row (list :kind :child :creator :ticket :attempt :module :creator-chain))
    {:custody-kind :managed :module-md5 (native_module_md5! (Map/get row :module))
     :lease (Map/get native :lease)})))
(defn- unmanaged_start_boundary! [kind]
 (when (or (assert_execution_context!) (execution_origin))
  (erlang/error :native_original_start_requires_native_origin))
 (cond
  (erlang/== :server kind)
   (native_boundary_stack! (erlang/self) :Elixir.BeamLisp.Server :native_start 5)
  (erlang/== :supervisor kind)
   (native_boundary_stack! (erlang/self) :Elixir.BeamLisp.Supervisor :start_native_link 2)
  :else (erlang/error :invalid_native_original_start_kind)))
(defn- native_launch_prune! []
 (ensure_native_start_tables!)
 ;; Proven dead provenance can be dropped. No Root grant/phase/reservation is
 ;; stored here; deleting receipt metadata NEVER authorizes effect completion.
 (Enum/each (ets/tab2list :beam_lisp_native_launches)
  (fn [pair]
   (let [row (erlang/element 2 pair) child (Map/get row :child)]
    (when (or (erlang/== :refused (Map/get row :phase))
              (and child (erlang/not (erlang/is_process_alive child)))
              (and (erlang/== nil child) (erlang/not (erlang/is_process_alive (Map/get row :creator)))))
     (when (Map/get row :lease) (release_code! (Map/get row :lease)))
     (ets/delete :beam_lisp_native_start_code (tuple (Map/get row :module) (Map/get row :ticket)))
     (ets/delete :beam_lisp_native_launches (erlang/element 1 pair)))))))
(defn begin_unmanaged_start!
 "Internal genuine unmanaged Server/Supervisor barrier. No selected graph or
  SDK class exemption. Attest actual pinned starter and loaded target bytes."
 [module kind]
 (unmanaged_start_boundary! kind)
 (when (and (erlang/== :supervisor kind) (erlang/not (erlang/== :Elixir.BeamLisp.Supervisor module)))
  (erlang/error :invalid_native_original_start_module))
 (let [creator (erlang/self) md5 (native_module_md5! module) ticket (erlang/make_ref) context (capture)]
  (server_start_turn
   (fn []
    (native_launch_prune!)
    (when (erlang/>= (ets/info :beam_lisp_native_launches :size) 4096)
     (erlang/error :native_original_start_capacity))
    (when-not (and (erlang/is_process_alive creator)
                  (erlang/== md5 (native_module_md5! module)))
     (erlang/error :native_original_start_evidence_required))
    (with_module_locks (list module)
     (fn []
      (when-not (erlang/== md5 (native_module_md5! module))
       (erlang/error :native_original_start_module_changed))
      (let [lease (retain_code! (list module))]
       (try
        (ets/insert :beam_lisp_native_launches
         (tuple ticket {:kind kind :custody-kind :unmanaged-native-class :module module :module-md5 md5
                        :creator creator :ticket ticket :attempt (erlang/make_ref)
                        :creator-chain (owned_start_creator_chain creator)
                        :child nil :lease lease :phase :launching :context context}))
        (ets/insert :beam_lisp_native_start_code (tuple (tuple module ticket) lease))
        (catch error (release_code! lease)
         (erlang/raise __EXCEPTION_KIND__ error __STACKTRACE__))))))))
  (tuple :bl_native_launch ticket)))
(defn claim_unmanaged_start!
 "Actual generated native init only, BEFORE binding context or user init.
  A copied/old envelope or same class does not claim another launch."
 [capability module kind]
 (if (erlang/== :server kind) (verify_server_start! module)
  (do (when-not (erlang/== :supervisor kind) (erlang/error :invalid_native_original_start_kind))
      (verify_supervisor_init! (erlang/self))))
 (let [child (erlang/self)]
  (server_start_turn
   (fn []
    (let [row (native_launch_row! capability)]
     (when-not (and (erlang/== :launching (Map/get row :phase))
                   (erlang/== nil (Map/get row :child))
                   (erlang/== kind (Map/get row :kind)) (erlang/== module (Map/get row :module))
                   (erlang/is_process_alive (Map/get row :creator))
                   (erlang/== (Map/get row :module-md5) (native_module_md5! module)))
      (erlang/error :invalid_native_original_start_ticket))
     (with_module_locks (list module)
      (fn []
       (let [lease (transfer_code! (Map/get row :lease) child)]
        (when (erlang/== :cancelled lease) (erlang/error :native_original_start_child_unavailable))
        (let [claimed (Map/merge row {:child child :phase :claimed :lease lease})]
         (owned_start_insert! claimed)
         (ets/insert :beam_lisp_native_start_code (tuple (tuple module (Map/get row :ticket)) lease))
         (ets/insert :beam_lisp_native_launches (tuple (Map/get row :ticket) claimed))
         (Map/get row :context))))))))))
(defn finish_unmanaged_start!
 "Actual native parent observes actual OTP result. Claim/parent result must
  agree; unknown/error/dead child gives no start authority and no Root release."
 [capability result]
 (let [creator (erlang/self)
       pair (server_start_turn (fn [] (native_launch_row! capability)))]
  (unmanaged_start_boundary! (Map/get pair :kind))
  (server_start_turn
   (fn []
    (let [row (native_launch_row! capability)
          success (and (erlang/is_tuple result) (erlang/== 2 (erlang/tuple_size result))
                       (erlang/== :ok (erlang/element 1 result)))
          child (when success (erlang/element 2 result))]
     (when-not (and (erlang/== creator (Map/get row :creator))
                   (Enum/member? (list :launching :claimed :unknown) (Map/get row :phase)))
      (erlang/error :invalid_native_original_start_ticket))
     (if success
      (do
       (when-not (and (erlang/== :claimed (Map/get row :phase))
                     (erlang/== child (Map/get row :child)) (erlang/is_process_alive child)
                     (erlang/== (Map/get row :module-md5) (native_module_md5! (Map/get row :module))))
        (erlang/error :native_original_start_completion_mismatch))
       (ets/insert :beam_lisp_native_launches (tuple (Map/get row :ticket) (Map/put row :phase :finished)))
       :finished)
      (do
       ;; Even a thrown native initializer may have performed accepted work.
       ;; Only no-child duplicate-name/ignore is a known unaccepted provenance.
       (let [unclaimed (erlang/== nil (Map/get row :child))
             duplicate (and (erlang/is_tuple result) (erlang/== 2 (erlang/tuple_size result))
                            (erlang/== :error (erlang/element 1 result))
                            (erlang/is_tuple (erlang/element 2 result))
                            (erlang/== 2 (erlang/tuple_size (erlang/element 2 result)))
                            (erlang/== :already_started (erlang/element 1 (erlang/element 2 result))))]
        (ets/insert :beam_lisp_native_launches
         (tuple (Map/get row :ticket) (Map/put row :phase
          (if (and unclaimed (or duplicate (erlang/== :ignore result))) :refused :unknown)))))
       :unconfirmed)))))))
(defn- native_original_evidence!
 "Read immutable captured original receipts only. All actual children/creators
  must remain alive, current code/custody exact, and actual parent finish known."
 [child original-creator]
 (when-not (and (erlang/is_pid child) (erlang/is_pid original-creator)
                (erlang/== (erlang/node child) (erlang/node))
                (erlang/== (erlang/node original-creator) (erlang/node))
                (erlang/is_process_alive original-creator))
  (erlang/error :native_original_start_evidence_required))
 (let [row (owned_start_lookup child)]
    (when-not row (erlang/error :native_original_start_evidence_required))
    (loop [todo (erlang/++ (list (owned_start_identity row)) (Map/get row :creator-chain (list)))
           expected child left 3 receipts (list)]
     (when (or (erlang/== 0 left) (erlang/== (list) todo))
      (erlang/error :native_original_start_chain_gap))
     (let [receipt (erlang/hd todo) actual (owned_start_lookup expected)]
      (when-not (and actual (erlang/== expected (Map/get receipt :child))
                    (erlang/== receipt (owned_start_identity actual)))
       (erlang/error :native_original_start_chain_changed))
      (owned_start_live! actual true)
      (let [parent (Map/get receipt :creator) next (erlang/++ receipts (list receipt))]
       (if (erlang/== parent original-creator)
        {:child child :original-creator original-creator :receipts next}
        (recur (erlang/tl todo) parent (erlang/- left 1) next)))))))

(defn native_process_start_evidence! [child original-creator]
 (server_start_turn (fn [] (native_original_evidence! child original-creator))))
(defn- native_start_class_held? [module]
 ;; Read-only protected refusal index, queried UNDER existing module fences.
 ;; Avoid an Env Agent call here: native starts acquire module locks in Env.
 (if (erlang/== :undefined (ets/whereis :beam_lisp_native_start_code)) false
  (do
   (when-not (and (erlang/== (Process/whereis (own-module)) (ets/info :beam_lisp_native_start_code :owner))
                 (erlang/== :protected (ets/info :beam_lisp_native_start_code :protection))
                 (erlang/== :set (ets/info :beam_lisp_native_start_code :type)))
    (erlang/error :native_start_table_custody_mismatch))
   (Enum/any? (ets/match_object :beam_lisp_native_start_code (tuple (tuple module :_) :_))
    (fn [pair] (code_lease_active? (erlang/element 2 pair)))))))


;; Fixed canonical native mutation command. Coupled only to authenticated
;; Source observation/barrier hooks; it NEVER changes Source callback domain.
(defn- native_command_ensure_tables! []
 (when-not (erlang/== (erlang/self) (Process/whereis (own-module)))
  (erlang/error :native_command_tables_require_env_owner))
 (let [tables (list :beam_lisp_native_commands :beam_lisp_native_command_frames :beam_lisp_native_command_effects)
       missing? (Enum/any? tables (fn [table] (erlang/== :undefined (ets/whereis table))))]
  (when missing?
   ;; Official fresh recovery may hot-load this module into the original Env
   ;; process. Never retrofit command authority into a running SDK/application.
   (when (or (ets/member :beam_lisp_vars :bl_sdk_runtime_lease)
             (erlang/> (ets/info :beam_lisp_owner_index :size) 0)
             (Enum/any? (erlang/++ tables
                         (list :beam_lisp_server_starts :beam_lisp_owner_transitions
                               :beam_lisp_owner_transition_heads :beam_lisp_server_initializers
                               :beam_lisp_native_owned_starts :beam_lisp_native_launches
                               :beam_lisp_source_extents :beam_lisp_source_lease_domains))
              (fn [table] (and (erlang/not (erlang/== :undefined (ets/whereis table)))
                               (erlang/> (ets/info table :size) 0)))))
    (erlang/error :native_command_initialization_requires_fresh_env))))
 (source_ensure_private!)
 (Enum/each (list :beam_lisp_native_commands :beam_lisp_native_command_frames :beam_lisp_native_command_effects)
  (fn [table]
   (when (erlang/== :undefined (ets/whereis table))
    (ets/new table (list :named_table :private :set)))
   (when-not (and (erlang/== (erlang/self) (ets/info table :owner))
                  (erlang/== :private (ets/info table :protection))
                  (erlang/== :set (ets/info table :type)))
    (erlang/error :native_command_table_custody_mismatch))))
 (when-not (ets/member :beam_lisp_source_extent_heads :native_command_critical_cells_active)
  (when (Enum/any? (list :beam_lisp_native_commands :beam_lisp_native_command_frames
                         :beam_lisp_native_command_effects)
         (fn [table] (erlang/> (ets/info table :size) 0)))
   (erlang/error :native_command_critical_summary_missing))
  (ets/insert :beam_lisp_source_extent_heads (tuple :native_command_critical_cells_active false))) :ok)
(defn- native_command_private [action]
 (if (erlang/== (erlang/self) (Process/whereis (own-module)))
  (do (native_command_ensure_tables!) (invoke_action action))
  (server_start_turn (fn [] (native_command_ensure_tables!) (invoke_action action)))))
(defn initialize_native_commands!
 "Fresh coherent recovery only. Actual Env owns every new private/protected
  table; no Source/application row, prior VM reference or Root ETS is adopted."
 []
 (assert_native_framework_execution!)
 (when (assert_execution_context!) (erlang/error :native_command_initialization_outside_generation_required))
 (native_command_private (fn [] :initialized)))
(defn assert_fresh_native_recovery!
 "Judge actual custody before bootstrap replacement. Authenticated compiler
  metadata may be warm; SDK/application leases, Source profiles and commands
  must be absent. Read private tables only in their real native owner."
 []
 (assert_native_framework_execution!)
 (when (assert_execution_context!) (erlang/error :native_recovery_outside_generation_required))
 (native_command_private
  (fn []
   (when (or (ets/member :beam_lisp_vars :bl_sdk_runtime_lease)
             (erlang/> (ets/info :beam_lisp_owner_index :size) 0)
             (native_command_critical_active?))
    (erlang/error :native_recovery_has_live_custody))
   (Enum/each (list :beam_lisp_native_commands :beam_lisp_native_command_frames
                   :beam_lisp_native_command_effects :beam_lisp_source_extents
                   :beam_lisp_native_owned_starts :beam_lisp_native_launches
                   :beam_lisp_native_start_code)
    (fn [table]
     (when-not (erlang/== 0 (ets/info table :size))
      (erlang/error (tuple :native_recovery_table_live table)))))
   ;; This private table also holds non-authorizing compiler caches. Their
   ;; presence is independent of an SDK lease or a managed Source lifetime.
   ;; Unknown keys, registered Source profiles and actual lease handles refuse.
   (Enum/each (ets/tab2list :beam_lisp_source_lease_domains)
    (fn [row]
     (let [key (elem row 0)]
      (when-not (or (erlang/== :sdk_inventory_cache key)
                    (and (erlang/is_tuple key) (erlang/== 2 (erlang/tuple_size key))
                         (erlang/== :seed_metadata (elem key 0))
                         (erlang/is_binary (elem key 1)) (erlang/== 32 (erlang/byte_size (elem key 1)))))
       (erlang/error :native_recovery_source_custody_live)))))
   :fresh)))
(defn- native_command_lookup [table key]
 (let [rows (ets/lookup table key)]
  (when-not (erlang/== rows (list)) (elem (erlang/hd rows) 1))))
(defn- native_command_registration! [credential]
 (let [row (native_command_lookup :beam_lisp_native_commands credential)]
  (when-not (and row (erlang/== 1 (Map/get row :version))
                 (erlang/== :active (Map/get row :state))
                 (erlang/is_process_alive (Map/get row :owner))
                 (erlang/== :open (BeamLisp.Refs/deref (Map/get (Map/get row :root) :lifetime))))
   (erlang/error :native_command_registration_unconfirmed)) row))
(defn- native_command_unknown? [credential]
 (let [registration (native_command_lookup :beam_lisp_native_commands credential)]
  (or (erlang/== nil registration) (erlang/not (erlang/== :active (Map/get registration :state)))
      (erlang/not (erlang/is_process_alive (Map/get registration :owner)))
      (Enum/any? (Map/values (Map/get registration :censuses (maps/new)))
       (fn [census] (erlang/not (erlang/is_process_alive (Map/get census :caller)))))
      (Enum/any? (ets/tab2list :beam_lisp_native_command_effects)
       (fn [entry]
        (let [effect (elem entry 1)]
         (and (erlang/== credential (Map/get effect :credential))
              (or (erlang/== :unknown (Map/get effect :state))
                  (erlang/not (erlang/is_process_alive (Map/get effect :caller))))))))
      (Enum/any? (ets/tab2list :beam_lisp_native_command_frames)
       (fn [entry]
        (and (erlang/not (erlang/is_process_alive (elem entry 0)))
             (Enum/any? (Map/get (elem entry 1) :stack)
              (fn [frame] (erlang/== credential (Map/get frame :credential))))))))))
(defn native_command_unknown! [credential]
 (native_command_private (fn [] (native_command_unknown? credential))))
(defn native_command_retirement_blocker! [credential]
 (native_command_private
  (fn []
   (when (or (native_command_unknown? credential)
             (erlang/> (erlang/map_size (Map/get (native_command_lookup :beam_lisp_native_commands credential)
                                               :censuses (maps/new))) 0)
             (Enum/any? (ets/tab2list :beam_lisp_native_command_effects)
              (fn [entry] (erlang/== credential (Map/get (elem entry 1) :credential))))
             (Enum/any? (ets/tab2list :beam_lisp_native_command_frames)
              (fn [entry] (Enum/any? (Map/get (elem entry 1) :stack)
                            (fn [frame] (erlang/== credential (Map/get frame :credential)))))))
    :native-command-outcome-unconfirmed))))
(defn- native_command_code! [registration]
 ;; Complete SDK proof is established once before registration. Actual frozen
 ;; callable/NIF bodies remain covered by the native SDK lifetime lease.
 (let [code (Map/get registration :code) modules (Map/keys code)]
  (when-not (and (sdk_runtime_retained_modules? modules)
                 (Enum/all? code (fn [entry]
                  (and (erlang/module_loaded (elem entry 0))
                       (erlang/== (elem entry 1) (erlang/apply (elem entry 0) :module_info (list :md5)))))))
   (erlang/error :native_command_sdk_code_changed))) :ok)
(defn- native_command_fixed [name arity]
 (with_env :global (fn [] (BeamLisp.AOT/sdk_named_constructor! "datom.conn" name arity))))
(defn- native_command_mfa [callable]
 (tuple (elem (erlang/fun_info callable :module) 1)
        (elem (erlang/fun_info callable :name) 1)
        (elem (erlang/fun_info callable :arity) 1)))
(defn- native_command_call [mfa arguments]
 (erlang/apply (elem mfa 0) (elem mfa 1) arguments))
(defn- native_command_sdk_entry! [mfa]
 ;; Original SDK bootstrap must still be on the actual native caller stack;
 ;; name/module assertions or a caller-provided MFA cannot issue credentials.
 (let [frames (elem (Process/info (erlang/self) :current_stacktrace) 1)]
  (when-not (Enum/any? frames (fn [frame]
              (and (erlang/== (elem mfa 0) (elem frame 0))
                   (erlang/== (elem mfa 1) (elem frame 1))
                   (erlang/== (elem mfa 2) (elem frame 2)))))
   (erlang/error :native_command_original_sdk_entry_required))) :ok)
(defn- native_command_bootstrap_root! [root owner]
 (let [resource (when (erlang/is_map root) (Map/get root :resource))
       lifetime (when (erlang/is_map root) (Map/get root :lifetime))
       custody (when (erlang/is_map root) (Map/get root :custody))]
  (when-not (and (erlang/is_map root) (erlang/== 8 (erlang/map_size root))
                 (erlang/== owner (Map/get root :owner))
                 (erlang/is_binary (Map/get root :application-id))
                 (erlang/is_binary (Map/get root :root)) (erlang/is_binary (Map/get root :path))
                 (erlang/== (Map/get root :root) (Path/expand (Map/get root :root)))
                 (String/starts_with? (Map/get root :path) (erlang/iolist_to_binary (list (Map/get root :root) "/")))
                 (erlang/is_map resource) (Map/has_key? resource :handle)
                 (erlang/== (Map/get root :path) (Map/get resource :path))
                 (erlang/is_map lifetime) (erlang/== :Elixir.BeamLisp.Atom (Map/get lifetime :__struct__))
                 (erlang/== :open (BeamLisp.Refs/deref lifetime))
                 (erlang/is_map custody) (erlang/== 3 (erlang/map_size custody))
                 (erlang/== owner (Map/get custody :owner)) (erlang/is_reference (Map/get custody :ticket))
                 (erlang/== nil (Map/get custody :origin)))
   (erlang/error :native_command_original_root_required))) root)
(defn assert_native_command_bootstrap_context! [context]
 (let [observed (source_execution_observation!) pid (erlang/self)]
  (native_command_private
   (fn []
    (let [matches (Enum/filter (ets/tab2list :beam_lisp_native_commands)
                   (fn [entry] (erlang/== context (Map/get (elem entry 1) :bootstrap-context))))
          row (when (erlang/== 1 (erlang/length matches)) (elem (erlang/hd matches) 1))]
     (when-not (and (erlang/is_reference context) row
                    (erlang/== :registering (Map/get row :state)) (erlang/== pid (Map/get row :owner))
                    (erlang/== observed (Map/get row :observation))
                    (erlang/== 0 (Map/get observed :source-depth)) (erlang/== nil (Map/get observed :generation)))
      (erlang/error :native_command_bootstrap_context_required)) observed)))))
(defn register_native_command! [namespace binding version]
 (assert_native_framework_execution!) (assert_native_command_callback_inactive!)
 (let [observed (source_execution_observation!)]
  (when-not (and (erlang/== "datom.conn" namespace) (erlang/== "native-mutation-plan!" binding)
                 (erlang/== 1 version) (erlang/== nil (assert_execution_context!))
                 (erlang/== nil (Map/get observed :generation))
                 (erlang/== 0 (Map/get observed :source-depth)))
   (erlang/error :native_command_registration_requires_native_bootstrap))
  (let [planner (native_command_fixed "native-mutation-plan!" 2)
        validator (native_command_fixed "native-mutation-witness!" 2)
        outcome (native_command_fixed "native-mutation-outcome!" 3)
        bootstrap (native_command_fixed "native-command-bootstrap!" 1)
        census (native_command_fixed "native-command-cell-census!" 1)
        cell-validator (native_command_fixed "native-cell-mutation-witness!" 2)
        retirement (native_command_fixed "native-command-retirement!" 2)
        installer (native_command_fixed "install-native-mutation-root!" 1)
        native :Elixir.BeamLisp.Native.Datom.StoreFjall
        sinks (list (tuple :fjall-put :fjall_put 3) (tuple :fjall-delete :fjall_delete 2)
                    (tuple :fjall-cas :fjall_cas 4) (tuple :fjall-commit :fjall_commit 2)
                    (tuple :fjall-sync :fjall_sync 1))
        callables (erlang/++ (list planner validator outcome bootstrap installer census cell-validator retirement)
                    (Enum/map sinks (fn [sink] (erlang/make_fun native (elem sink 1) (elem sink 2)))))
        _ (Enum/each callables (fn [callable]
             (when-not (erlang/function_exported (elem (erlang/fun_info callable :module) 1)
                           (elem (erlang/fun_info callable :name) 1) (elem (erlang/fun_info callable :arity) 1))
              (erlang/error :native_command_fixed_callable_unavailable))))
        _ (Enum/each (Map/values (Map/new (Enum/map callables
                    (fn [callable] (tuple (elem (erlang/fun_info callable :module) 1) callable)))))
             (fn [callable] (BeamLisp.AOT/sdk_callable_evidence! callable)))
        _ (native_command_sdk_entry! (native_command_mfa installer))
        code (Map/new (Enum/map callables (fn [callable]
                (let [module (elem (erlang/fun_info callable :module) 1)]
                 (tuple module (erlang/apply module :module_info (list :md5)))))))
        credential (erlang/make_ref) owner (erlang/self) context (erlang/make_ref)
        row {:version 1 :owner owner :state :registering :planner (native_command_mfa planner)
             :validator (native_command_mfa validator) :outcome (native_command_mfa outcome)
             :census (native_command_mfa census) :cell-validator (native_command_mfa cell-validator)
             :retirement (native_command_mfa retirement)
             :censuses (maps/new) :critical-cells (maps/new)
             :native native :code code :consumed (list) :bootstrap-context context :observation observed}]
   (native_command_code! row)
   (native_command_private
    (fn []
     (when (erlang/>= (ets/info :beam_lisp_native_commands :size) 128)
      (erlang/error :native_command_registration_capacity))
     (ets/insert :beam_lisp_native_commands (tuple credential row))
     ;; Active means a Root may have protected cells, including an accepted
     ;; bootstrap/census whose acknowledgement is not yet confirmed.
     (ets/insert :beam_lisp_source_extent_heads (tuple :native_command_critical_cells_active true))))
   (try
    (let [root (native_command_bootstrap_root! (erlang/apply bootstrap (list context)) owner)]
     (when-not (erlang/== observed (source_execution_observation!))
      (erlang/error :native_command_bootstrap_context_changed))
     (native_command_private
      (fn []
       (when-not (erlang/== row (native_command_lookup :beam_lisp_native_commands credential))
        (erlang/error :native_command_registration_unconfirmed))
       (ets/insert :beam_lisp_native_commands
        (tuple credential (Map/put (Map/put row :state :active) :root root))))) credential)
    (catch error
     (let [kind __EXCEPTION_KIND__ trace __STACKTRACE__]
      (native_command_private
       (fn []
        (when-let [current (native_command_lookup :beam_lisp_native_commands credential)]
         (ets/insert :beam_lisp_native_commands (tuple credential (Map/put current :state :held))))))
      (erlang/raise kind error trace)))))))
(defn- native_command_owner_departed! [pid ticket]
 (native_command_private
  (fn []
   (when-not (and (erlang/is_pid pid) (erlang/== (erlang/node pid) (erlang/node))
                  (erlang/not (erlang/is_process_alive pid)))
    (erlang/error :native_command_owner_still_alive))
   (let [owner (native_command_lookup :beam_lisp_native_command_frames pid)]
    (when (and owner (erlang/== ticket (Map/get owner :ticket)))
     ;; Retain accepted turn/effect rows. Death before effect issuance is also
     ;; an unconsumed native command, never authority to replace its writer.
     (Enum/each (Map/get owner :stack)
      (fn [frame]
       (let [credential (Map/get frame :credential)
             registration (native_command_lookup :beam_lisp_native_commands credential)]
        (when registration
         (ets/insert :beam_lisp_native_commands (tuple credential (Map/put registration :state :held)))))))
     (Enum/each (ets/tab2list :beam_lisp_native_command_effects)
      (fn [entry]
       (let [effect (elem entry 1)]
        (when (erlang/== pid (Map/get effect :caller))
         (let [credential (Map/get effect :credential)
               registration (native_command_lookup :beam_lisp_native_commands credential)]
          (when registration
           (ets/insert :beam_lisp_native_commands
            (tuple credential (Map/put registration :state :held))))
          (ets/insert :beam_lisp_native_command_effects
           (tuple (elem entry 0) (Map/put effect :state :unknown))))))))
     (ets/delete :beam_lisp_source_extent_heads (tuple :native_command_source_barrier pid))
     (if (erlang/== (Map/get owner :stack) (list))
      (ets/delete :beam_lisp_native_command_frames pid)
      (ets/insert :beam_lisp_native_command_frames (tuple pid (Map/put owner :state :dead)))))))) :ok)
(defn- native_command_guardian [pid ticket]
 (let [monitor (erlang/monitor :process pid)]
  (receive [:DOWN seen :process departed _] :when (and (= seen monitor) (= departed pid))
   (native_command_owner_departed! pid ticket))))
(defn- native_command_owner! [pid]
 (or (native_command_lookup :beam_lisp_native_command_frames pid)
  (do
   (when (erlang/>= (ets/info :beam_lisp_native_command_frames :size) 4096)
    (erlang/error :native_command_owner_capacity))
   (let [ticket (erlang/make_ref) guardian (erlang/spawn (fn [] (native_command_guardian pid ticket)))
         row {:ticket ticket :guardian guardian :state :live :stack (list)}]
    (ets/insert :beam_lisp_native_command_frames (tuple pid row)) row))))
(defn- native_command_context_row! [context observed]
 ;; Called only in actual Env owner. The caller/depth come from native Source
 ;; observation before crossing this Agent; context carries only a private key.
 (when-not (and (erlang/is_tuple context) (erlang/== 2 (erlang/tuple_size context))
                (erlang/== :bl_native_command_context (elem context 0)) (erlang/is_reference (elem context 1)))
  (erlang/error :native_command_context_required))
 (let [pid (Map/get observed :caller) owner (native_command_lookup :beam_lisp_native_command_frames pid)
       stack (when owner (Map/get owner :stack)) frame (when (and stack (erlang/not (erlang/== stack (list)))) (erlang/hd stack))]
  (when-not (and frame (erlang/== :live (Map/get owner :state))
                 (erlang/== context (Map/get frame :context))
                 (erlang/not (erlang/== :callback (Map/get frame :state)))
                 (erlang/== observed (Map/get frame :observation)))
   (erlang/error :native_command_context_mismatch)) frame))
(defn begin_native_command_boundary! [credential]
 (assert_native_command_callback_inactive!)
 (let [observed (source_execution_observation!) pid (erlang/self)
       boundary (erlang/make_ref) context (tuple :bl_native_command_context (erlang/make_ref))]
  (native_command_private
   (fn []
    (native_command_registration! credential)
    (let [owner (native_command_owner! pid) stack (Map/get owner :stack)
          prior (when-not (erlang/== stack (list)) (erlang/hd stack))
