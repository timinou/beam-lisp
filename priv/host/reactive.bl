; host/reactive.bl — the pinned HOST MODULE for `Elixir.BeamLisp.Reactive`.
;
; `derive` / `deref` / `derived?`, over the memo cell and the atoms of W3. This
; is the `.bl` port of `lib/beam_lisp/reactive.ex`'s `BeamLisp.Reactive` half;
; compiled FUNCTIONS-ONLY by `BeamLisp.AOT/compile_host_file` into
; `Elixir.BeamLisp.Reactive.beam` — no struct, no `__info__`, no namespace of
; its own.
;
; Incremental computation without a reverse-dependency graph: a derived
; remembers the exact dependency values it last computed from. On `deref` it
; reads the dependencies' CURRENT values and recomputes only if one differs.
; Because reading a derived dependency recurses, staleness propagates through a
; chain of deriveds on demand. `swap!` on an atom pays nothing for this — the
; cost is on the derived's `deref`, where it belongs.
;
; ABI PARITY IS THE CONTRACT: the same answers, the same value shapes, the same
; exception class as the Elixir module it stands in for, and the SAME EXPORTS
; and nothing else. That last clause is why `value`/`dep-value` are local
; closures, not top-level `defn`s: the pinned emitter exports every top-level
; function it compiles, so a helper written as a `defn` (or even a `defn-`,
; which the pinned path does not privatize) would become public API the
; recalled module never had. `test/bl/host_reactive_test.bl` pins the export set.
;
; Run: bin/bl test test/bl/host_reactive_test.bl

(ns host.reactive)

(defn derive
  "Build a derived over `deps` (a vector or Erlang list of atoms and/or
   deriveds) and a zero-arity `thunk` that reads them. The thunk runs on the
   first `deref` and again only after a dependency's value changes.

   `deps` arrives as a bl vector from the `derived` macro, or a plain Erlang
   list from a caller that built it by hand; both normalize to an Erlang list of
   refs. Any other shape is the `CaseClauseError` the recalled `case` raised.

   The `Derived` tag is the PUBLIC type atom, spelled literally (never minted
   from a string), exactly as `Deferred.delay` spells the `Delay` tag. It is not
   the module this file compiled into: a probe compile under another atom must
   still build the one `BeamLisp.Derived` value shape every caller and
   `BeamLisp.Refs.deref/1` recognizes here."
  [deps thunk]
  (if (and (erlang/is_function thunk)
           (erlang/== 0 (erlang/element 2 (erlang/fun_info thunk :arity))))
    (let [dep-list
          (if (and (erlang/is_map deps)
                   (erlang/is_map_key :__struct__ deps)
                   (erlang/== :"Elixir.BeamLisp.Vector" (erlang/map_get :__struct__ deps)))
            (BeamLisp.Vector/to_list deps)
            (if (erlang/is_list deps)
              deps
              (erlang/error (Elixir.CaseClauseError/exception (list (tuple :term deps))))))]
      (maps/put :__struct__ :"Elixir.BeamLisp.Derived"
        (maps/put :cell (BeamLisp.LazyMemo/create_ref :stale)
          (maps/put :deps dep-list
            (maps/put :thunk thunk (maps/new))))))
    (erlang/error
      (Elixir.FunctionClauseError/exception
        (list (tuple :module (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))
              (tuple :function :derive)
              (tuple :arity 2))))))

(defn deref
  "Current value of a derived, recomputing iff a dependency changed. A
   non-derived is refused with the `FunctionClauseError` the recalled
   `%Derived{}` head raised."
  [d]
  (if (derived? d)
    ; `value` is a named fn, so its body can re-enter itself twice over: the
    ; `value` name inside the body IS the self-application, and `dep-value`
    ; (created per call, nested so it closes over `value`) calls it for a
    ; derived dependency. Both are LOCAL — neither is a top-level export.
    (let [value
          (fn value [dv]
            (let [dep-value
                  (fn dep-value [x]
                    (cond
                      ; a derived dep recurses, bringing it current and
                      ; yielding its up-to-date value
                      (derived? x) (value x)
                      ; an atom reads its value cell
                      (and (erlang/is_map x)
                           (erlang/is_map_key :__struct__ x)
                           (erlang/== :"Elixir.BeamLisp.Atom" (erlang/map_get :__struct__ x)))
                        (BeamLisp.Refs/deref x)
                      ; anything else is a constant dependency, returned as-is
                      :else x))
                  current (Enum/map (erlang/map_get :deps dv) dep-value)
                  cell (erlang/map_get :cell dv)
                  thunk (erlang/map_get :thunk dv)
                  other (BeamLisp.LazyMemo/read cell)]
              ; Freshness is EXACT-TERM equality (`==`), not bl `=`: the recall
              ; compared `recorded == current` with Elixir `==`, so `1` and
              ; `1.0` are the same dependency value, while bl `=` would call
              ; them different and recompute. Same numbers, same answer.
              (if (and (erlang/is_tuple other)
                       (erlang/== 3 (erlang/tuple_size other))
                       (erlang/== :fresh (erlang/element 1 other))
                       (erlang/== (erlang/element 3 other) current))
                (erlang/element 2 other)
                (let [nv (BeamLisp.Ns.Rt/invoke thunk (list))
                      outcome (BeamLisp.LazyMemo/exchange_ref cell other (tuple :fresh nv current))]
                  (cond
                    (erlang/== :ok outcome) nv
                    ; A concurrent writer moved the cell; re-evaluate freshness.
                    ; The thunk is assumed pure, so converging on a recomputed
                    ; value is safe.
                    (erlang/== :retry outcome) (value dv)
                    ; :cycle (or any other answer): keep the value we computed.
                    :else nv)))))]
      (value d))
    (erlang/error
      (Elixir.FunctionClauseError/exception
        (list (tuple :module (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))
              (tuple :function :deref)
              (tuple :arity 1))))))

(defn derived?
  "True for a derived — a map tagged with the `BeamLisp.Derived` struct."
  [x]
  (and (erlang/is_map x)
       (erlang/is_map_key :__struct__ x)
       (erlang/== :"Elixir.BeamLisp.Derived" (erlang/map_get :__struct__ x))))
