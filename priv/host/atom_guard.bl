; host/atom_guard.bl — the pinned HOST MODULE for `Elixir.BeamLisp.AtomGuard`.
;
; `lib/beam_lisp/atom_guard.ex` is the one place beam-lisp decides it is unsafe
; to intern another atom: Erlang atoms are never collected, and a full table
; does not raise — it ABORTS THE WHOLE VM, uncatchably, with a crash dump. Every
; layer that turns source text into atoms (the reader, the compiler, the RT's
; keyword intern) samples the table through this module before the VM would die,
; converting an unrecoverable abort into an ordinary catchable error naming the
; token that tipped it over.
;
; This file is the `.bl` port of that module, compiled FUNCTIONS-ONLY by
; `BeamLisp.AOT/compile_host_file` into `Elixir.BeamLisp.AtomGuard.beam` — no
; struct, no `__info__`, no namespace of its own. The nested
; `BeamLisp.AtomGuard.LimitError` is a `defexception [:message]` and cannot live
; in this file: a pinned source carries functions in exactly ONE namespace and
; compiles to exactly ONE module. It is ported by the pinned exception source
; beside this one, `priv/host/atom_guard_limit_error.bl`, and `check!/1` reaches
; it by its exact atom — the same atom the live `check!` raised.
;
; WHAT THE MODULE OWES, and what each line preserves:
;
;   * the process counter key `{__MODULE__, :count}`. THIS file names no module:
;     the key is `{self_module, :count}` read from a fun literal compiled into
;     this file (`erlang/fun_info(F, :module)`), so at production it IS
;     `{BeamLisp.AtomGuard, :count}` — byte-identical to the live
;     `{@count_key …}` — and at a probe it is the probe's own atom, so a
;     differential test never shares counter state between probe and live.
;
;   * the application-env reads and their clamps. `high_water_fraction/0` reads
;     `:beam_lisp, :atom_high_water_fraction` (default `0.9`) and clamps with
;     `min(max(f, 0.0), 1.0)` — `erlang/min`/`erlang/max` preserve the operand's
;     integer/float TYPE exactly as Elixir's do, so an integer fraction stays an
;     integer. `check_interval/0` reads `:beam_lisp, :atom_check_interval`
;     (default `256`) and answers `max(trunc(i), 1)`; a non-number falls back to
;     the default. Both are `Application.get_env/3`, the live calls.
;
;   * `to_atom/1` tries `String.to_existing_atom/1` FIRST: a name the VM already
;     holds costs nothing and cannot grow the table, so the guard only has to
;     think about genuinely new names — the rescue is the only path that samples.
;     The `:when (string? name)` guard reproduces the live `when is_binary(name)`
;     clause head, so a non-binary is the same `FunctionClauseError`.
;
;   * `check!/1` reads `:erlang.system_info(:atom_count)` and `:atom_limit`,
;     raises past `round(limit * fraction)`, and otherwise answers `:ok`. The
;     message is reproduced BYTE FOR BYTE: `erlang/iolist_to_binary` over
;     `String.Chars/to_string` for the wired numbers and `Kernel/inspect` for the
;     token. It is NOT `str`: `(str …)` resolves through the language's var
;     registry (`BeamLisp.Env`), so a pinned beam that concatenates with it
;     answers only in a VM that booted the host namespace — the cold child here
;     loads this beam with NO application boot. `iolist_to_binary` is a raw
;     `erlang` call and every piece is already a binary, so it is the exact join
;     with no Env in the path. Do not "simplify" it to `str`.
;
;   * HELPERS ARE CALLED DIRECTLY. A pinned module's sibling call compiles to the
;     namespace shim module and is re-pointed at the pinned atom by the emitter,
;     so `(check_interval)` is a direct call to this module's own
;     `check_interval/0` at whatever atom the file was compiled into. A helper in
;     VALUE position (passed as an argument, captured) is a different lowering —
;     a var lookup that cannot be re-pointed — so every helper appears only in
;     call position, never as a bare name.
;
; The raise is `erlang/error` of `LimitError.exception/1` — the class `:error`
; and reason the live `raise LimitError, message: …` ends in. It must never be a
; 3-arity `erlang:raise/3` call, which the lowerer rewrites to the
; SEGFAULT-prone `raw_raise` primop (`reader.bl`'s header); `erlang/error/1` is
; an ordinary BIF and needs no frame list.
;
; (This wave owns source and tests only; the seed entry that points a real atom
; at this file is written by the wave that deletes `atom_guard.ex`.)
;
; Run: bin/bl test test/bl/host_atom_guard_test.bl

(ns host.atom-guard)

(defn- self_module
  "The atom THIS source was compiled into, read from a fun literal compiled into
   this file — module-exact, so the same bytes serve production and probe
   without naming either."
  []
  (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))

(defn- count_key
  "The per-process intern counter key `{Module, :count}` — the live
   `{@count_key …}` (`{__MODULE__, :count}`), from THIS file's own atom so a
   probe keeps its own counter."
  []
  (erlang/list_to_tuple (list (self_module) :count)))

(defn high_water_fraction
  "The configured high-water fraction, clamped to 0.0..1.0. A non-number (or an
   absent key) answers the default `0.9`."
  []
  (let [configured (Application/get_env :beam_lisp :atom_high_water_fraction 0.9)]
    (if (erlang/is_number configured)
      (erlang/min (erlang/max configured 0.0) 1.0)
      0.9)))

(defn check_interval
  "How many interned names pass between table samples (at least 1). A non-number
   (or an absent key) answers the default `256`."
  []
  (let [configured (Application/get_env :beam_lisp :atom_check_interval 256)]
    (if (erlang/is_number configured)
      (erlang/max (erlang/trunc configured) 1)
      256)))

(defn check!
  "Raise unless the atom table is below its high-water mark. Call directly when
   a single operation is about to intern many names at once, where per-name
   sampling would look at the table too late."
  [token]
  (let [count (erlang/system_info :atom_count)
        limit (erlang/system_info :atom_limit)
        fraction (high_water_fraction)]
    (if (erlang/>= count (erlang/round (erlang/* limit fraction)))
      (erlang/error
        (BeamLisp.AtomGuard.LimitError/exception
          (list (erlang/list_to_tuple
                  (list :message
                        (erlang/iolist_to_binary
                          (list "refusing to intern "
                                (Kernel/inspect token)
                                ": the VM atom table holds "
                                (String.Chars/to_string count)
                                " of "
                                (String.Chars/to_string limit)
                                " atoms, at or past the configured high-water fraction "
                                (String.Chars/to_string fraction)
                                ". Atoms are never collected, the table only grows, and filling it aborts the whole VM rather than raising — so beam-lisp stops here instead. Adjust :beam_lisp, :atom_high_water_fraction to change the ceiling.")))))))
      :ok)))

(defn account!
  "Account for one about-to-be-interned name, sampling the atom table every
   `:atom_check_interval` calls. The counter lives in the process dictionary, so
   there is no shared cell to contend on and no cross-process race."
  [token]
  (let [key (count_key)
        ; `Process.get/2`, NOT `:erlang.get/2`: the default-carrying read is an
        ; Elixir helper (`:erlang.get/2` does not exist), the very call the live
        ; module made.
        count (erlang/+ (Process/get key 0) 1)]
    (erlang/put key count)
    (if (erlang/== 0 (erlang/rem count (check_interval)))
      (check! token))
    :ok))

(defn to_atom
  "Intern `name` as an atom, refusing if the table is at its high-water mark. The
   safe replacement for a bare `String.to_atom/1` on any name that came from
   source text.

   Tries `String.to_existing_atom/1` first: a name the VM already holds costs
   nothing and cannot grow the table, so only a genuinely new name is accounted."
  ([name] :when (string? name)
   (try
     (String/to_existing_atom name)
     (catch Elixir.ArgumentError _e
       (account! name)
       (String/to_atom name)))))

(defn reset
  "Reset the per-process intern counter. Called at the start of a read."
  []
  (erlang/put (count_key) 0))
