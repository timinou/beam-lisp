; host/lazy_seq_enumerable.bl — the pinned PROTOCOL IMPL for `BeamLisp.LazySeq`.
;
; `defimpl Enumerable, for: BeamLisp.LazySeq` is its own module,
; `Enumerable.BeamLisp.LazySeq`, compiled beside the type it serves. This file
; is the `.bl` port of that impl, compiled by `BeamLisp.AOT/compile_host_file`
; into `Elixir.Enumerable.BeamLisp.LazySeq.beam`.
;
; THE MODULE ATOM IS OUTSIDE `Elixir.BeamLisp.*`, and that is the whole reason
; the seed's host inventory is an explicit list of `{:module, :source}` entries
; rather than a name-prefix rule: a prefix cannot name this beam, so the table
; carries the list as data (`priv/build/seed.bl`, `host-names`).
;
; ABI PARITY IS THE CONTRACT. `count/1` answers the tagged `{:ok, …}` a protocol
; impl returns; `member?/2` and `slice/1` report `{:error, <impl module>}` so the
; caller falls back to `reduce` (a lazy seq has neither a size nor a
; constant-time slice); `reduce/3` is the tagged accumulator protocol —
; `{:cont, acc}` pulls one cell at a time through `BeamLisp.LazySeq.cell/1`,
; `{:halt, acc}` stops, and `{:suspend, acc}` answers a continuation that
; resumes the SAME walk, so `Enum`/`Stream` behave identically; and
; `__impl__/1` answers `:for` (the type) and `:protocol` (the protocol). An
; unknown `__impl__` key raises `FunctionClauseError`, exactly as the generated
; two-clause function did.
;
; FUNCTIONS-ONLY: no `:struct_fields`, so this beam gains no `__struct__` or
; `__info__` export. `member?`/`slice` name their own module from a fun literal
; compiled into THIS file, so at a probe atom they answer that atom —
; module-exact, never a hard-coded `Enumerable.BeamLisp.LazySeq`. The call to
; the TYPE module (`BeamLisp.LazySeq/count`, `BeamLisp.LazySeq/cell`) IS the
; production atom by construction: the impl dispatches BY the value's tag, and
; the values this impl is reached with are production-tagged lazy nodes.
;
; `do-reduce` IS A LOCAL CLOSURE, never a top-level `defn`: the pinned emitter
; exports every top-level function, so a helper written as a defn would become
; public API the generated impl never had. The suspension continuations close
; over it lexically.
;
; Run: bin/bl test test/bl/host_lazy_seq_test.bl

(ns host.lazy-seq-enumerable)

(defn __impl__
  "The `defimpl`-generated introspection: `:for` is the type, `:protocol` the
   protocol. An unknown key is the `FunctionClauseError` the generated
   two-clause function raised."
  [k]
  (cond
    (= :for k) :"Elixir.BeamLisp.LazySeq"
    (= :protocol k) :"Elixir.Enumerable"
    :else
      (erlang/error
        (Elixir.FunctionClauseError/exception
          (list (tuple :module (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))
                (tuple :function :__impl__)
                (tuple :arity 1))))))

(defn count
  "`Enumerable.count/1`: the element count, tagged `{:ok, n}`. Never a cheap
   answer — it forces the whole seq through the type module."
  [lazy]
  (tuple :ok (BeamLisp.LazySeq/count lazy)))

(defn member?
  "`Enumerable.member?/2`: refuse, so the caller falls back to `reduce`. The
   error names THIS impl module, as `__MODULE__` did."
  [_lazy _x]
  (tuple :error (erlang/element 2 (erlang/fun_info (fn [] nil) :module))))

(defn reduce
  "`Enumerable.reduce/3`: fold the realized cells through the tagged
   accumulator protocol, suspension included."
  [lazy acc fun]
  (let [do-reduce
        (fn do-reduce [acc lazy fun]
          (let [atag (if (erlang/is_tuple acc) (erlang/element 1 acc) nil)]
            (cond
              (erlang/== atag :halt)
                (tuple :halted (erlang/element 2 acc))

              (erlang/== atag :suspend)
                (tuple :suspended (erlang/element 2 acc)
                       (fn [next] (do-reduce next lazy fun)))

              (erlang/== atag :cont)
                (let [c (BeamLisp.LazySeq/cell lazy)]
                  (if (erlang/== c nil)
                    (tuple :done (erlang/element 2 acc))
                    (let [r (erlang/apply fun (list (erlang/hd c) (erlang/element 2 acc)))
                          rtag (if (erlang/is_tuple r) (erlang/element 1 r) nil)]
                      (cond
                        (erlang/== rtag :cont)
                          (do-reduce (tuple :cont (erlang/element 2 r)) (erlang/tl c) fun)

                        (erlang/== rtag :halt)
                          (tuple :halted (erlang/element 2 r))

                        (erlang/== rtag :suspend)
                          (tuple :suspended (erlang/element 2 r)
                                 (fn [next] (do-reduce next (erlang/tl c) fun)))

                        :else
                          (erlang/error
                            (Elixir.CaseClauseError/exception (list (tuple :term r))))))))

              :else
                (erlang/error
                  (Elixir.FunctionClauseError/exception
                    (list (tuple :module (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))
                          (tuple :function :do_reduce)
                          (tuple :arity 3)))))))]
    (do-reduce acc lazy fun)))

(defn slice
  "No constant-time slice for a lazy seq; the caller falls back to `reduce`.
   The error names THIS impl module, as `__MODULE__` did."
  [_lazy]
  (tuple :error (erlang/element 2 (erlang/fun_info (fn [] nil) :module))))
