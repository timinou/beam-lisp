; host/deferred.bl — the pinned HOST MODULE for `Elixir.BeamLisp.Deferred`.
;
; The value-shaped face of the lazy memo cell: `delay` wraps a zero-arity thunk
; in a `BeamLisp.Delay`, `force` forces it (returning a non-delay unchanged),
; `realized?` reports whether the body has produced its value, and `delay?`
; recognizes a delay. This is the `.bl` port of `lib/beam_lisp/deferred.ex`'s
; `BeamLisp.Deferred` half; compiled FUNCTIONS-ONLY by
; `BeamLisp.AOT/compile_host_file` into `Elixir.BeamLisp.Deferred.beam`.
;
; ABI parity is the contract: the same answers, the same value shapes, and the
; same exception class as the Elixir module it stands in for. All force
; semantics (run-once, retryable failure, herd protection under concurrent
; force, a value returned as-is rather than normalized to a cons cell) are
; inherited from the shared `BeamLisp.LazySeq` cell, not reimplemented here.
;
; Run: bin/bl test test/bl/host_deferred_test.bl

(ns host.deferred)

(defn delay
  "Wrap a zero-arity thunk in a `Delay`. A non-function, or a function of any
   other arity, is refused with `FunctionClauseError` — the same refusal the
   Elixir guard `is_function(thunk, 0)` produced."
  [thunk]
  (if (and (erlang/is_function thunk)
           (erlang/== 0 (erlang/element 2 (erlang/fun_info thunk :arity))))
    {:__struct__ :"Elixir.BeamLisp.Delay" :seq (BeamLisp.LazySeq/new thunk)}
    (erlang/error
      (Elixir.FunctionClauseError/exception
        (list (tuple :module (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))
              (tuple :function :delay)
              (tuple :arity 1))))))

(defn force
  "Force a delay to its value, remembered thereafter. `force` of a non-delay
   returns it unchanged, so `force` is safe to apply to a value that may or may
   not be a delay."
  [x]
  (if (delay? x)
    (BeamLisp.LazySeq/force (erlang/map_get :seq x))
    x))

(defn realized?
  "Whether a delay has already produced its value. A non-delay is trivially
   realized."
  [x]
  (if (delay? x)
    (let [state (BeamLisp.LazySeq/memo_state (erlang/map_get :seq x))]
      (and (erlang/is_tuple state)
           (erlang/== :completed (erlang/element 1 state))))
    true))

(defn delay?
  "True for a `Delay` — a map tagged with the `BeamLisp.Delay` struct."
  [x]
  (and (erlang/is_map x)
       (erlang/is_map_key :__struct__ x)
       (erlang/== :"Elixir.BeamLisp.Delay" (erlang/map_get :__struct__ x))))
