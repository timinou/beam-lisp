; host/set_enumerable.bl — the pinned PROTOCOL IMPL for `BeamLisp.Set`.
;
; `defimpl Enumerable, for: BeamLisp.Set` is its own module,
; `Enumerable.BeamLisp.Set`, compiled beside the type it serves. This file is
; the `.bl` port of that impl, compiled by `BeamLisp.AOT/compile_host_file`
; into `Elixir.Enumerable.BeamLisp.Set.beam`.
;
; THE MODULE ATOM IS OUTSIDE `Elixir.BeamLisp.*`, and that is the whole reason
; the seed's host inventory is an explicit list of `{:module, :source}` entries
; rather than a name-prefix rule: a prefix cannot name this beam, so the table
; carries the list as data (`priv/build/seed.bl`, `host-names`).
;
; ABI PARITY IS THE CONTRACT. `count`/`member?` answer the tagged `{:ok, …}` a
; protocol impl returns; `reduce` delegates to `Enumerable.List.reduce` over
; `BeamLisp.Set.to_list/1` — the same call the Elixir impl made, so `Enum.*`
; and `Stream.*` behave identically; `slice` reports `{:error, <impl module>}`
; so the caller falls back to `reduce` (a set has no constant-time slice); and
; `__impl__/1` answers `:for` (the type) and `:protocol` (the protocol). An
; unknown `__impl__` key raises `FunctionClauseError`, exactly as the generated
; two-clause function did.
;
; FUNCTIONS-ONLY: no `:struct_fields`, so this beam gains no `__struct__` or
; `__info__` export. `slice` and `__impl__`'s error name their own module from a
; fun literal compiled into THIS file, so at a probe atom they answer that atom
; — module-exact, never a hard-coded `Enumerable.BeamLisp.Set`.
;
; Run: bin/bl test test/bl/host_set_test.bl

(ns host.set-enumerable)

(defn __impl__
  "The `defimpl`-generated introspection: `:for` is the type, `:protocol` the
   protocol. An unknown key is the `FunctionClauseError` the generated
   two-clause function raised."
  [k]
  (cond
    (= :for k) :"Elixir.BeamLisp.Set"
    (= :protocol k) :"Elixir.Enumerable"
    :else (erlang/error
            (Elixir.FunctionClauseError/exception
              (list (tuple :module (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))
                    (tuple :function :__impl__)
                    (tuple :arity 1))))))

(defn count
  "`Enumerable.count/1`: the cardinality, tagged `{:ok, n}`."
  [s]
  (tuple :ok (BeamLisp.Set/count s)))

(defn member?
  "`Enumerable.member?/2`: membership, tagged `{:ok, bool}`."
  [s x]
  (tuple :ok (BeamLisp.Set/member? s x)))

(defn reduce
  "`Enumerable.reduce/3`: fold the members through `Enumerable.List.reduce`,
   thenables and suspension included."
  [s acc fun]
  (Enumerable.List/reduce (BeamLisp.Set/to_list s) acc fun))

(defn slice
  "No constant-time slice for a set; the caller falls back to `reduce`. The
   error names THIS impl module, as `__MODULE__` did."
  [_s]
  (tuple :error (erlang/element 2 (erlang/fun_info (fn [] nil) :module))))
