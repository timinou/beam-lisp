; host/compile_error.bl — the pinned HOST MODULE for the compiler's
; `Elixir.BeamLisp.CompileError`.
;
; `lib/beam_lisp/errors.ex` declares it as a Hand-written `defexception` whose
; `exception/1` is OVERRIDDEN (the two explicit clauses REPLACE the generated
; pair, so the generated list clause never runs — an `[]` opts raises the
; `Keyword.fetch!` KeyError, not the generated `struct!`):
;
;     defexception [:message, :file, :line, :form]
;
;     def exception(opts) when is_list(opts) do
;       message = Keyword.fetch!(opts, :message)
;       file = Keyword.get(opts, :file)
;       line = Keyword.get(opts, :line)
;       form = Keyword.get(opts, :form)
;       %__MODULE__{message: build_message(message, file, line, form),
;                   file: file, line: line, form: form}
;     end
;
;     def exception(message) when is_binary(message), do: %__MODULE__{message: message}
;
;     defp build_message(message, file, line, form) do
;       location = cond do
;         file && line -> "#{file}:#{line}"
;         file -> file
;         line -> "line #{line}"
;         true -> nil
;       end
;       prefix = if location, do: "#{location}: ", else: ""
;       form_suffix =
;         if form, do: "\n  offending form: #{inspect(form, printable_limit: 240, limit: 12)}", else: ""
;       "#{prefix}#{message}#{form_suffix}"
;     end
;
; A pinned host source carries functions in exactly ONE namespace and compiles
; to exactly ONE module. This file NAMES no module: the tag its `exception/1`
; builds is read from a fun literal compiled into this file
; (`erlang/fun_info(F, :module)`, the `delay.bl`/`reader_exception.bl` idiom), so
; the SAME bytes compiled at `Elixir.BeamLisp.CompileError` build a CompileError
; and the same bytes compiled at a probe atom build that probe.
;
; The seed will map it with the `defexception [:message, :file, :line, :form]`
; struct shape and the `Exception` behaviour:
;
;     :struct_fields [{:__exception__ true} {:message nil} {:file nil} {:line nil} {:form nil}]
;     :behaviour     :"Elixir.Exception"
;
; (This wave owns source and tests only; the seed entry is written by the wave
; that deletes `errors.ex`.)
;
; WHAT THE MODULE OWES. The synthesized `:struct_fields` half gives
; `__struct__/0,1` + `__info__/1`. The only other functions the LIVE module
; exports are `exception/1` and `message/1` — `build_message/4` was `defp`, and
; `defexception`'s generated `exception/1` was replaced — so this file defines
; ONLY those two, and its export surface is the live module's, datum for datum:
;
;     __info__(:functions) = [__struct__: 0, __struct__: 1, exception: 1, message: 1]
;
; The struct map is built with `maps/put` over `(maps/new)`, NEVER by calling the
; generated `__struct__/1`: a pinned file's sibling call compiles to the
; namespace shim (`BeamLisp.Ns.Host.CompileError`) and `__struct__` is emitted
; as module clauses only — never interned as a namespace var — so
; `(__struct__ kv)` compiles to `undefined var: …/__struct__` (MEASURED;
; `reader_exception.bl`'s header).
;
; `exception/1`'s list clause reads its keys through `Keyword/fetch!` and
; `Keyword/get` — the very functions the live clause calls — so a missing
; `:message` is the live `KeyError` (with `key` and `term` set), an undeclared
; key is simply ignored, and any non-list/non-binary argument misses both clauses
; and is the live `FunctionClauseError`. `build_message` reproduces the live
; `file:line`/`line N` prefix and the `printable_limit: 240, limit: 12` form
; inspect byte for byte, interpolating through `String.Chars/to_string` — the
; `"#{…}"` the live module uses.
;
; `message/1` is `defexception`'s generated clause: a map carrying `:message`
; answers it directly (nil stays nil — a non-string message is
; `Exception.message/1`'s to refuse, not this one's), and every other shape takes
; the compiler's dynamic-field fallback (`:elixir_erl_pass.no_parens_remote/2`,
; the helper the live beam itself calls) — `BadMapError` for a non-map, `KeyError`
; for a map without `:message`, `UndefinedFunctionError` for a bare atom.
;
; CONCATENATION IS `erlang/iolist_to_binary`, NOT `str`, and that is
; LOAD-BEARING: `(str …)` resolves through the language's var registry
; (`BeamLisp.Env`), so a pinned beam that concatenates with it answers only in
; a VM that has booted the host namespace — the cold child loads this beam with
; NO application boot, so a `str` there is an `:ets.lookup(:beam_lisp_vars, …)`
; on a table nobody created (MEASURED: "the table identifier does not refer to
; an existing ETS table"). `iolist_to_binary` is a raw `erlang` call, and every
; piece is already a binary (`String.Chars/to_string` for the wired values), so
; it is the exact join with no Env in the path. Do not "simplify" it to `str`.
;
; Run: bin/bl test test/bl/host_compile_error_test.bl

(ns host.compile-error)

(defn exception
  "The `Exception` callback. Clause for clause the live `defexception` override:
   the binary clause first (forwarding through the list one, as the live binary
   clause builds `%__MODULE__{message: message}` — which is
   `build_message(message, nil, nil, nil)`), then the list clause that fetches
   `:message` (raising the live `Keyword.fetch!` KeyError) and reads the three
   optional positions."
  ([message] :when (string? message)
   (exception (list (erlang/list_to_tuple (list :message message)))))
  ([opts] :when (list? opts)
   (let [message (Keyword/fetch! opts :message)
         file (Keyword/get opts :file)
         line (Keyword/get opts :line)
         form (Keyword/get opts :form)
         ; `"#{file}:#{line}"` (truthy `&&`, `file`/`line` through to_string).
         location (cond
                    (and file line)
                    (erlang/iolist_to_binary
                      (list (String.Chars/to_string file) ":" (String.Chars/to_string line)))

                    file file
                    line (erlang/iolist_to_binary (list "line " (String.Chars/to_string line)))
                    :else nil)
         ; `"#{location}: "` — `location` may be a raw `file` (any term), so the
         ; interpolation goes through `String.Chars/to_string`, never straight
         ; into an iolist.
         prefix (if location (erlang/iolist_to_binary (list (String.Chars/to_string location) ": ")) "")
         form-suffix (if form
                       (erlang/iolist_to_binary
                         (list "\n  offending form: "
                               (Kernel/inspect form (list (erlang/list_to_tuple (list :printable_limit 240))
                                                          (erlang/list_to_tuple (list :limit 12))))))
                       "")]
     (maps/put :form form
       (maps/put :line line
         (maps/put :file file
           (maps/put :message (erlang/iolist_to_binary (list prefix (String.Chars/to_string message) form-suffix))
             (maps/put :__exception__ true
               (maps/put :__struct__
                 (erlang/element 2 (erlang/fun_info (fn [] nil) :module))
                 (maps/new))))))))))

(defn message
  "The `Exception` callback: this struct's `:message`, read as `e.message` reads
   it. The map clause answers directly (`nil` stays `nil`); every other shape
   takes the compiler's own dynamic-field fallback,
   `:elixir_erl_pass.no_parens_remote/2` — the very helper the live generated
   beam calls — so a non-map is `BadMapError`, a map without `:message` is
   `KeyError`, and a bare atom is the `UndefinedFunctionError` the dot syntax
   raised. Class for class with the live module."
  [exception]
  (if (and (erlang/is_map exception) (erlang/is_map_key :message exception))
    (erlang/map_get :message exception)
    (let [r (erlang/apply :elixir_erl_pass :no_parens_remote (list exception :message))]
      (if (erlang/== :ok (erlang/element 1 r))
        (erlang/element 2 r)
        (erlang/error (erlang/element 2 r))))))
