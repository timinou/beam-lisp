; host/form_meta.bl — the pinned HOST MODULE for `Elixir.BeamLisp.FormMeta`.
;
; `meta/1`, `with_meta/2`, `vary_meta/2` over FORM DATA — the data a macro
; receives. This is the `.bl` port of `lib/beam_lisp/form_meta.ex`, compiled
; FUNCTIONS-ONLY by `BeamLisp.AOT/compile_host_file` into
; `Elixir.BeamLisp.FormMeta.beam` — no struct, no `__info__`, no namespace of
; its own.
;
; WHY FORMS CAN CARRY METADATA WHERE VALUES CANNOT. `BeamLisp.Meta` is
; deliberately bounded (only lazy seqs are identity-bearing on the BEAM). Form
; data is different: it is COMPILER-OWNED — an Elixir list / vector / map /
; `{:symbol, name}` produced by `datum/1` and consumed by `data->form/1` — so
; the compiler owns the whole lifecycle and metadata on forms is genuinely
; implementable. The mechanism is a `{:meta, form, m}` wrapper node, mirroring
; how the reader and compiler already tag symbols and keyword forms; the
; compiler strips the wrapper before codegen, so a form with metadata compiles
; identically to the same form without it. `=` and printing of the resulting
; VALUE are therefore never affected.
;
; THE RUNTIME SEAM IS THE PRODUCTION MODULE. Lazy seqs are real runtime values,
; and this module DELEGATES them to `BeamLisp.Meta` — the production atom, never
; a probe one. A pinned probe compile under another atom must still reach the
; one Meta the live VM runs, or the two modules would answer different questions
; about the same value. Likewise a `%BeamLisp.Vector{}` carries metadata in its
; own `:meta` struct field (not in a wrapper node), so it remains usable by
; every collection function — `conj`, `count`, `get`, `vector?` all still match
; it (BUG-009).
;
; ABI PARITY IS THE CONTRACT: same answers, same value shapes, same exception
; class AND message as the Elixir module, and the SAME EXPORTS and nothing else.
; The pinned emitter exports every top-level `defn` it compiles (even a
; `defn-`), and a pinned module's functions are NOT interned as namespace vars —
; so a helper reached by NAME through `BeamLisp.Env` would answer in the compile
; VM and fail on a fresh boot. There is no top-level helper here; `form-shape?`
; and friends are local closures.
;
; Run: bin/bl test test/bl/host_meta_test.bl

(ns host.form-meta)

(defn meta
  "The metadata map attached to a form datum, or `nil` when it has none.

   `{:meta, form, m}` reads `m`; a lazy seq delegates to `BeamLisp.Meta` (the
   one runtime value type that carries metadata); a vector reads its own struct
   field; anything else is `nil` — always safe, matching Clojure's `(meta x)`."
  [form]
  (cond
    (and (erlang/is_tuple form)
         (erlang/== 3 (erlang/tuple_size form))
         (erlang/== :meta (erlang/element 1 form)))
    (erlang/element 3 form)

    (and (erlang/is_map form)
         (erlang/is_map_key :__struct__ form)
         (erlang/== :"Elixir.BeamLisp.LazySeq" (erlang/map_get :__struct__ form)))
    (BeamLisp.Meta/meta form)

    (and (erlang/is_map form)
         (erlang/is_map_key :__struct__ form)
         (erlang/== :"Elixir.BeamLisp.Vector" (erlang/map_get :__struct__ form)))
    (erlang/map_get :meta form)

    :else nil))

(defn with_meta
  "Attach `m` (any map, structs included) to a form datum, returning a form
   that compiles identically and reads back via `meta`. `nil` clears: an
   existing `{:meta, form, _}` unwraps to its bare form, and any other value is
   returned unchanged.

   Form-shaped data — the reader tuples (`{:symbol, _}`, `{:list, _}`,
   `{:vector, _}`, `{:map, _}`, `{:set, _}`), a raw list, a vector, a map —
   wraps in `{:meta, form, m}`, which the compiler strips before codegen. A
   lazy seq delegates to `BeamLisp.Meta` (real runtime metadata), and a vector
   stores metadata in its own field so it stays usable. Every other value is
   returned unchanged (a documented no-op, matching `BeamLisp.Meta`). A
   non-map, non-nil `m` raises `ArgumentError`."
  [form m]
  (let [lazy-seq? (fn [v]
                    (and (erlang/is_map v)
                         (erlang/is_map_key :__struct__ v)
                         (erlang/== :"Elixir.BeamLisp.LazySeq" (erlang/map_get :__struct__ v))))
        vector-struct? (fn [v]
                         (and (erlang/is_map v)
                              (erlang/is_map_key :__struct__ v)
                              (erlang/== :"Elixir.BeamLisp.Vector" (erlang/map_get :__struct__ v))))
        wrapper? (fn [v]
                   (and (erlang/is_tuple v)
                        (erlang/== 3 (erlang/tuple_size v))
                        (erlang/== :meta (erlang/element 1 v))))
        ; The datum shapes the compiler produces for forms, plus the tuple
        ; shapes the reader emits before datum conversion (`{:list, items}`
        ; etc.) so source positions attach at read time. A bare atom is
        ; ambiguous (keyword datum vs `true`/`false`/`nil`), so keywords are
        ; not wrapped; form metadata on a bare keyword is a rare edge.
        form-shape? (fn [v]
                      (or (and (erlang/is_tuple v)
                               (erlang/== 2 (erlang/tuple_size v))
                               (or (erlang/== :symbol (erlang/element 1 v))
                                   (erlang/== :list (erlang/element 1 v))
                                   (erlang/== :vector (erlang/element 1 v))
                                   (erlang/== :map (erlang/element 1 v))
                                   (erlang/== :set (erlang/element 1 v))))
                          (erlang/is_list v)
                          (vector-struct? v)
                          ; a plain map is form-shaped, and so is a struct form
                          ; — this decides whether metadata attaches, never a
                          ; collection operation.
                          (erlang/is_map v)))
        ; `erlang/iolist_to_binary`, not `str`: a pinned host module must not
        ; reach a BL namespace var (not even `core`'s `str`) — its beam then
        ; imports nothing from `BeamLisp.Env` at all, so it answers even before
        ; the prelude exists. Same bytes, no registry.
        bad! (fn []
               (erlang/error
                 (Elixir.ArgumentError/exception
                   (erlang/iolist_to_binary
                     (list "metadata must be a map or nil, got: "
                           (Elixir.Kernel/inspect m))))))]
    (cond
      (lazy-seq? form)
      (BeamLisp.Meta/with_meta form m)

      (vector-struct? form)
      (cond
        (erlang/== nil m) (maps/put :meta nil form)
        (erlang/is_map m) (maps/put :meta m form)
        :else (bad!))

      ; nil clears: unwrap a metadata-carrying form back to its bare form.
      (erlang/== nil m)
      (if (wrapper? form) (erlang/element 2 form) form)

      (erlang/is_map m)
      (if (form-shape? form)
        (erlang/list_to_tuple (list :meta form m))
        form)

      :else (bad!))))

(defn vary_meta
  "`(vary-meta form f)`: reattach `(f (meta form))` to `form`. `f` is a bare
   Elixir function, a beam-lisp fn value, or any other invocable the runtime
   accepts; it always receives the current metadata map (or `nil` when absent)."
  [form f]
  (if (erlang/is_function f)
    (with_meta form (f (meta form)))
    (with_meta form (BeamLisp.Ns.Rt/invoke f (list (meta form))))))
