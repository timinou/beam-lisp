; host/link.bl — the pinned HOST MODULE for `Elixir.BeamLisp.Link`.
;
; This file is not a namespace. It is a `.bl` SOURCE that the bootstrap seed
; compiles with `BeamLisp.AOT/compile-host-file` into ONE exact-named beam
; (`Elixir.BeamLisp.Link.beam`) whose top-level `defn`s are plain exported
; functions — the exact call surface the compiler already names at
; `Elixir.BeamLisp.Link`, so no caller is renamed. It is the second pinned host
; leaf after `priv/host/compiler_data.bl`, and the same rules apply: functions
; only, compiled `load? false` into a scratch ebin, committed into the floor,
; installed by `Bootstrap.install!/1`, and judged by `bl seed --check` on the
; `bl_source_hash` of the source beside it.
;
; WHY A PINNED MODULE AND NOT A NAMESPACE. The boot compiler is pinned on `Link`
; (`mod-link` in `priv/boot/compiler.bl`): every runtime `defn` compiles to a
; `Link/defvar` call, and prelinks through `Link/module_for`. A module on the
; compiler's own critical path can never itself be an AOT-rebuilt
; `BeamLisp.Ns.*` namespace — that is the bootstrap circle again — so it is a
; pinned host beam instead.
;
; ── STAGING: THE Emit DEPENDENCY ────────────────────────────────────────────
;
; `Link` owns no codegen. It records canonical clauses and publishes them, and
; every descriptor, body module, shim clause, fn value and binary load is built
; by `Elixir.BeamLisp.Emit` — the same divided responsibility the recalled
; `lib/beam_lisp/link.ex` had (`defdelegate` for the three pass-throughs, plain
; `Emit.…` calls inside `defvar`). This port REPRODUCES that seam rather than
; inlining Emit's logic: `Emit` is the sibling half of the pinned pair, and one
; need must have one implementation. Until that half is seeded this beam calls
; the Elixir `BeamLisp.Emit`, exactly as the Elixir `BeamLisp.Link` did; the
; orchestrator seeds the two together so the pair never straddles the boundary.
;
; ── ABI PARITY IS THE CONTRACT ──────────────────────────────────────────────
;
; Every exported function reproduces its Elixir counterpart clause for clause:
;
;   module_for/1     ns string → `BeamLisp.Ns.<Camelized>` — `Emit`'s, delegated.
;   shim_clauses/1   ns_defs → the deduplicated forwarding clauses — `Emit`'s.
;   body_modules/1   ns_defs → `%{body_mod => [clause]}` — `Emit`'s.
;   defvar/3,4       build the immutable body module and the stable namespace
;                    shim, load BOTH before publishing either (atomic
;                    compile-before-publish), then record ns_defs, the link
;                    registry entry and the interned value. `defvar/3` is
;                    `defvar/4` with a nil location, so the two arities cannot
;                    drift.
;
; The ABI is exactly those five exports — no extra ones. The one non-trivial
; helper (`publication_filename`) is a local closure inside `defvar` rather than
; a top-level `defn-`, because the pinned emitter exports every top-level
; function it compiles while the recalled module kept that helper private.
;
; Guards are the guard dialect the compiler permits (`string?` for `is_binary/1`),
; so a non-binary ns or name raises `FunctionClauseError` exactly as it did.
; `location` is the `[{:file path} {:line n}]` the compiler emits; a nil location
; and any other shape keep the recalled `to_string/1` behaviour, read through
; `String.Chars/to_string` (which IS `to_string/1`, not a re-implementation).
;
; Answer for answer, not byte for byte, is what let a pinned beam stand in for
; the Elixir module: the Core backend writes different bytes from `elixirc` for
; the same source. `test/bl/link_test.bl` compares a fresh compile of this file
; at a probe atom against the live Elixir `BeamLisp.Link` over representative
; inputs, and pins the exported ABI.

(ns host.link)

; ── the three pass-throughs (`defdelegate` in the recalled module) ───────────

(defn module_for
  "The stable namespace module for `ns`: `Emit.module_for/1`'s answer."
  [ns]
  (BeamLisp.Emit/module_for ns))

(defn shim_clauses
  "The forwarding clauses a namespace shim exports for `ns_defs` — one per
   distinct `{fname, arity}`, each calling the body module that owns it."
  [ns_defs]
  (BeamLisp.Emit/shim_clauses ns_defs))

(defn body_modules
  "`ns_defs` grouped by owning body module: `%{body_mod => [clause]}`."
  [ns_defs]
  (BeamLisp.Emit/body_modules ns_defs))

; ── the publishing path ─────────────────────────────────────────────────────

(defn defvar
  "Install `new_defs` as `name` in `ns`: compile a fresh immutable body module
   and the regenerated namespace shim, LOAD BOTH, and only then publish the
   ns_defs entry, the link registry row and the interned value — so a descriptor
   that fails to compile changes nothing. Returns the interned fn value."
  ([ns name new_defs]
   :when (and (string? ns) (string? name))
   (defvar ns name new_defs nil))
  ([ns name new_defs location]
   :when (and (string? ns) (string? name))
   (let [mod (BeamLisp.Emit/module_for ns)
         body_mod (BeamLisp.Emit/fresh_body_module)
         body_defs (BeamLisp.Emit/attach_body_module new_defs body_mod)
         all_defs (Map/put (BeamLisp.Env/ns_defs ns) name body_defs)
         body_clauses (Enum/map body_defs (fn [entry] (erlang/element 4 entry)))
         body_beam (BeamLisp.Emit/compile_descriptor (BeamLisp.Emit/descriptor_for body_mod body_clauses))
         shim_beam (BeamLisp.Emit/compile_descriptor (BeamLisp.Emit/descriptor_for mod (BeamLisp.Emit/shim_clauses all_defs)))
         ; `publication_filename/1` inlined: nil → the live default; a keyword
         ; list → its `:file` value (or the default when absent/false); anything
         ; else → `to_string/1` of it. `Access/get/2` is exactly the `location[:file]`
         ; the recalled module wrote, malformed lists and all — so even the
         ; refusal on a non-keyword location is preserved. A local closure, so
         ; the pinned beam exports no sixth name.
         filename (cond
                    (nil? location) "beam_lisp_live"
                    (list? location)
                    (String.Chars/to_string (or (Access/get location :file) "beam_lisp_live"))
                    :else (String.Chars/to_string location))]
     (BeamLisp.Emit/load_binary! body_beam filename)
     (BeamLisp.Emit/load_binary! shim_beam filename)
     (BeamLisp.Env/put_ns_defs ns all_defs)
     (let [shapes (BeamLisp.Emit/fixed_variadic new_defs)
           fixed (first shapes)
           variadic (second shapes)
           value (BeamLisp.Emit/fn_value mod fixed variadic)]
       (BeamLisp.Env/put_key (tuple :link ns name) (tuple mod (Map/new fixed) variadic))
       (BeamLisp.Env/intern ns name value)))))
