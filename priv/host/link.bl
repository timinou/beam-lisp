; host/link.bl — the pinned HOST MODULE for `Elixir.BeamLisp.Link`.
;
; This file is not a namespace. It is a `.bl` SOURCE that the bootstrap seed
; compiles with `BeamLisp.AOT/compile-host-file` into ONE exact-named beam
; (`Elixir.BeamLisp.Link.beam`) whose top-level `defn`s are plain exported
; functions — the exact call surface the compiler already names at
; `Elixir.BeamLisp.Link`, so no caller is renamed. It is the second pinned host
; leaf after `priv/host/compiler_data.bl`, and the same rules apply: functions
; only, compiled `load? false` into a scratch ebin, committed into the floor,
; installed by `Bootstrap.install!/1`, and judged by `bl seed --check` on the
; `bl_source_hash` of the source beside it.
;
; WHY A PINNED MODULE AND NOT A NAMESPACE. The boot compiler is pinned on `Link`
; (`mod-link` in `priv/boot/compiler.bl`): every runtime `defn` compiles to a
; `Link/defvar` call, and prelinks through `Link/module_for`. A module on the
; compiler's own critical path can never itself be an AOT-rebuilt
; `BeamLisp.Ns.*` namespace — that is the bootstrap circle again — so it is a
; pinned host beam instead.
;
; ── STAGING: THE Emit DEPENDENCY ────────────────────────────────────────────
;
; `Link` owns no codegen. It records canonical clauses and publishes them, and
; every descriptor, body module, shim clause, fn value and binary load is built
; by `Elixir.BeamLisp.Emit` — the same divided responsibility the recalled
; `lib/beam_lisp/link.ex` had (`defdelegate` for the three pass-throughs, plain
; `Emit.…` calls inside `defvar`). This port REPRODUCES that seam rather than
; inlining Emit's logic: `Emit` is the sibling half of the pinned pair, and one
; need must have one implementation. Until that half is seeded this beam calls
; the Elixir `BeamLisp.Emit`, exactly as the Elixir `BeamLisp.Link` did; the
; orchestrator seeds the two together so the pair never straddles the boundary.
;
; ── ABI PARITY IS THE CONTRACT ──────────────────────────────────────────────
;
; Every exported function reproduces its Elixir counterpart clause for clause:
;
;   module_for/1     ns string → `BeamLisp.Ns.<Camelized>` — `Emit`'s, delegated.
;   shim_clauses/1   ns_defs → the deduplicated forwarding clauses — `Emit`'s.
;   body_modules/1   ns_defs → `%{body_mod => [clause]}` — `Emit`'s.
;   defvar/3,4       build the immutable body module and the stable namespace
;                    shim, load BOTH before publishing either (atomic
;                    compile-before-publish), then record ns_defs, the link
;                    registry entry and the interned value. `defvar/3` is
;                    `defvar/4` with a nil location, so the two arities cannot
;                    drift.
;
; The ABI is exactly those five exports — no extra ones. The one non-trivial
; helper (`publication_filename`) is a local closure inside `defvar` rather than
; a top-level `defn-`, because the pinned emitter exports every top-level
; function it compiles while the recalled module kept that helper private.
;
; Guards are the guard dialect the compiler permits (`string?` for `is_binary/1`),
; so a non-binary ns or name raises `FunctionClauseError` exactly as it did.
; `location` is the `[{:file path} {:line n}]` the compiler emits; a nil location
; and any other shape keep the recalled `to_string/1` behaviour, read through
; `String.Chars/to_string` (which IS `to_string/1`, not a re-implementation).
;
; Answer for answer, not byte for byte, is what let a pinned beam stand in for
; the Elixir module: the Core backend writes different bytes from `elixirc` for
; the same source. `test/bl/link_test.bl` compares a fresh compile of this file
; at a probe atom against the live Elixir `BeamLisp.Link` over representative
; inputs, and pins the exported ABI.

(ns host.link)

; ── the three pass-throughs (`defdelegate` in the recalled module) ───────────

(defn module_for
  "The stable namespace module for `ns`: `Emit.module_for/1`'s answer."
  [ns]
  (BeamLisp.Emit/module_for ns))

(defn shim_clauses
  "The forwarding clauses a namespace shim exports for `ns_defs` — one per
   distinct `{fname, arity}`, each calling the body module that owns it."
  [ns_defs]
  (BeamLisp.Emit/shim_clauses ns_defs))

(defn body_modules
  "`ns_defs` grouped by owning body module: `%{body_mod => [clause]}`."
  [ns_defs]
  (BeamLisp.Emit/body_modules ns_defs))

; ── the publishing path ─────────────────────────────────────────────────────

(defn defvar
  "Install `new_defs` as `name` in `ns`: compile a fresh immutable body module
   and the regenerated namespace shim, LOAD BOTH, and only then publish the
   ns_defs entry, the link registry row and the interned value — so a descriptor
   that fails to compile changes nothing. Returns the interned fn value."
  ([ns name new_defs]
   :when (and (string? ns) (string? name))
   (defvar ns name new_defs nil))
  ([ns name new_defs location]
   :when (and (string? ns) (string? name))
   (BeamLisp.Env/with_namespace_lock ns
    (fn []
      (BeamLisp.Env/with_publication ns
        (fn []
  (let [mod (BeamLisp.Emit/module_for ns)
         body_mod (BeamLisp.Emit/fresh_body_module ns)
         body_defs (BeamLisp.Emit/attach_body_module new_defs body_mod)
         body_clauses (Enum/map body_defs (fn [entry] (erlang/element 4 entry)))
         body_beam (BeamLisp.Emit/compile_descriptor (BeamLisp.Emit/descriptor_for body_mod body_clauses))
         ; {fname, arity} the shim must answer for this def
         keys (Enum/uniq (Enum/map body_defs
                           (fn [e] (tuple (erlang/element 3 e)
                                          (erlang/length (erlang/map_get :params (erlang/element 4 e)))))))
         state (let [r (BeamLisp.Env/lookup (tuple :shim_state ns))]
                 (if (erlang/is_tuple r) (if (erlang/== :ok (erlang/element 1 r)) (erlang/element 2 r) nil) nil))
         size (if (erlang/is_tuple state) (erlang/element 1 state) 0)
         pending (if (erlang/is_tuple state) (erlang/element 2 state) 0)
         ; FORWARD instead of recompiling the shim when the live shim can
         ; route an unknown name (it carries the forwarding handler) and this
         ; def adds only names it does not export yet. Recompiling the whole
         ; shim per def made a source load O(N²) in its defs (BUG-112); with
         ; a rebuild only when the pending names outgrow the compiled ones,
         ; the shims compiled over a load sum to O(N). A REdefinition of an
         ; exported name always rebuilds: the old shim calls the old body.
         forward? (and (erlang/function_exported mod :"$handle_undefined_function" 2)
                       (Enum/all? keys (fn [k] (erlang/not (erlang/function_exported mod (erlang/element 1 k) (erlang/element 2 k)))))
                       (erlang/< (erlang/+ pending 1) (erlang/max 8 size)))
         all_defs (if forward? nil (Map/put (BeamLisp.Env/ns_defs ns) name body_defs))
         shim_beam (if forward? nil (compile_shim mod all_defs ns))
         ; `publication_filename/1` inlined: nil → the live default; a keyword
         ; list → its `:file` value (or the default when absent/false); anything
         ; else → `to_string/1` of it. `Access/get/2` is exactly the `location[:file]`
         ; the recalled module wrote, malformed lists and all — so even the
         ; refusal on a non-keyword location is preserved. A local closure, so
         ; the pinned beam exports no sixth name.
         filename (cond
                    (nil? location) "beam_lisp_live"
                    (list? location)
                    (String.Chars/to_string (or (Access/get location :file) "beam_lisp_live"))
                    :else (String.Chars/to_string location))]
     ; Physical provider admission detaches every old literal reference before
     ; taking this scope's native/destruction fence.
     (BeamLisp.Env/publish_binaries!
       (if forward? (list body_beam) (list body_beam shim_beam)) filename)
     (if forward?
       (do (Enum/each keys (fn [k] (BeamLisp.Env/put_key (tuple :fwd ns (erlang/element 1 k) (erlang/element 2 k)) body_mod)))
           (BeamLisp.Env/put_key (tuple :shim_state ns) (tuple size (erlang/+ pending 1) filename)))
       (do
         ; The regenerated shim has no `__bl_ns_defs__/0`: turn every env's
         ; reference to the OLD shim's table into the map it stands for first.
         (BeamLisp.Env/put_key (tuple :shim_state ns) (tuple (erlang/map_size all_defs) 0 filename))))
     (BeamLisp.Env/put_ns_definition ns name body_defs)
     (let [shapes (BeamLisp.Emit/fixed_variadic new_defs)
           fixed (first shapes)
           variadic (second shapes)
           value (BeamLisp.Emit/fn_value mod fixed variadic)]
       (BeamLisp.Env/put_key (tuple :link ns name) (tuple mod (Map/new fixed) variadic))
       (BeamLisp.Env/intern ns name value)
       (BeamLisp.Env/mark_emitted ns mod (list body_mod) (BeamLisp.Env/ns_definition_count ns)
         (Map/new (list (tuple name body_defs))))
       value))))))))

; ── the forwarding shim (BUG-112) ─────────────────────────────────────────────────────
;
; A live shim carries one extra clause, `$handle_undefined_function/2`: the VM
; calls it for any name the shim does not export. It forwards to the body
; module recorded for that `{fname, arity}` (`defvar` writes the row when it
; skips a rebuild), so a def is callable — by direct call, capture or apply —
; the moment `defvar` returns, before the shim is rebuilt to export it.
; `settle/1` rebuilds once at the end of a load, so steady-state calls are
; plain exported calls again.

(defn compile_shim
  "The `{module, beam}` of `ns`'s shim over `all_defs`: one forwarding clause
   per {fname, arity}, plus the undefined-function handler."
  [mod all_defs ns]
  (BeamLisp.Emit/compile_descriptor
    (BeamLisp.Emit/descriptor_for mod
      (erlang/++ (BeamLisp.Emit/shim_clauses all_defs)
                 (list (BeamLisp.Emit/function_clause :"$handle_undefined_function"
                         (BeamLisp.Emit/remote :Elixir.BeamLisp.Link :forward
                           (list (BeamLisp.Emit/lit ns) (BeamLisp.Emit/var "f") (BeamLisp.Emit/var "args")))
                         (list {:pop :pvar :name "f"} {:pop :pvar :name "args"})))))))

(defn forward
  "Route a call of `fname` with `args` on `ns`'s shim to the body module that
   defines it, or raise the VM's own `undef` when nothing does.

   The row is looked up through the caller's env first, then in ANY env: the
   shim module is node-wide, so a process that carries no env (a raw `spawn`,
   a manager process) or a sibling env still reaches a def whose row another
   env wrote. Without the second step a private helper called from such a
   process was `undefined or private` until the shim was rebuilt (BUG-113)."
  [ns fname args]
  (let [arity (erlang/length args)
        own (BeamLisp.Env/lookup (tuple :fwd ns fname arity))
        rows (if (and (erlang/is_tuple own) (erlang/== :ok (erlang/element 1 own)))
               (list)
               (ets/match_object :beam_lisp_vars (tuple (tuple :_ :fwd ns fname arity) :_)))
        target (cond
                 (and (erlang/is_tuple own) (erlang/== :ok (erlang/element 1 own))) (erlang/element 2 own)
                 (erlang/== 0 (erlang/length rows)) nil
                 :else (erlang/element 2 (erlang/hd rows)))]
    (if (erlang/== nil target)
      (error_handler/raise_undef_exception (BeamLisp.Emit/module_for ns) fname args)
      (erlang/apply target fname args))))

(defn settle
  "Rebuild every namespace shim THIS env has defs waiting behind the forwarding
   handler, so each def is an exported function again — the one rebuild a
   whole source load pays. A no-op when nothing is pending. Returns :ok.

   Only the calling env's own rows are settled. A shim's pending state, its
   forwarding routes and the def table it is rebuilt from all live in the env
   that loaded it; rebuilding another env's shim from THIS env's chain compiled
   it over an empty table and made even its public defs undefined (BUG-113).
   An env that never settles keeps working through its routes."
  []
  (let [env (BeamLisp.Env/env_id)]
    (Enum/each
      (ets/match_object :beam_lisp_vars (tuple (tuple env :shim_state :_) :_))
      (fn [row]
        (let [ns (erlang/element 3 (erlang/element 1 row))
              st (erlang/element 2 row)]
          (when (and (erlang/is_tuple st) (erlang/< 0 (erlang/element 2 st)))
            (BeamLisp.Env/with_namespace_lock ns
              (fn []
                (BeamLisp.Env/with_publication ns
                  (fn []
                    ; Resolve pending state again under the same lock used by
                    ; defvar: a concurrent loader may already have settled it.
                    (let [current (BeamLisp.Env/lookup (tuple :shim_state ns))
                          st (if (and (erlang/is_tuple current)
                                      (erlang/== :ok (erlang/element 1 current)))
                               (erlang/element 2 current) nil)]
                      (when (and (erlang/is_tuple st) (erlang/< 0 (erlang/element 2 st)))
                        (let [mod (BeamLisp.Emit/module_for ns)
                              all_defs (BeamLisp.Env/ns_defs ns)
                              beam (compile_shim mod all_defs ns)]
                          (BeamLisp.Env/publish_binaries! (list beam) (erlang/element 3 st))
                          (ets/match_delete :beam_lisp_vars (tuple (tuple env :fwd ns :_ :_) :_))
                          (BeamLisp.Env/put_key (tuple :shim_state ns)
                            (tuple (erlang/map_size all_defs) 0 (erlang/element 3 st)))
                          (BeamLisp.Env/mark_emitted ns mod)))))))))))))
  :ok)
