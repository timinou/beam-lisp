; host/lazy_seq_inspect.bl — the pinned PROTOCOL IMPL for `BeamLisp.LazySeq`'s
; `Inspect` protocol.
;
; `defimpl Inspect, for: BeamLisp.LazySeq` is its own module,
; `Inspect.BeamLisp.LazySeq`, compiled beside the type it serves. This file is
; the `.bl` port of that impl, compiled by `BeamLisp.AOT/compile_host_file`
; into `Elixir.Inspect.BeamLisp.LazySeq.beam`.
;
; THE MODULE ATOM IS OUTSIDE `Elixir.BeamLisp.*` — `Inspect.<Type>` — the second
; pinned leaf a name-prefix rule could not reach (the first is
; `Elixir.Enumerable.BeamLisp.Set`), so the seed's host inventory carries the
; mapping as data (`priv/build/seed.bl`, `host-names`).
;
; ABI PARITY IS THE CONTRACT, and it is why this impl is PORTED rather than
; dropped: without it a lazy node falls back to `Inspect.Any` and renders as an
; opaque struct map, losing the `(1 2 3…)` list face a human reads — including
; inside a test failure message. `inspect/2` answers the same `Inspect.Algebra`
; doc the live impl answered; `__impl__/1` answers `:for` (the type) and
; `:protocol` (the protocol), and an unknown key raises the `FunctionClauseError`
; the generated two-clause function raised. The module exports exactly the live
; pair — `inspect/2` and `__impl__/1` — nothing more.
;
; THE LIMIT IS POSITIVE-INT-OR-20. `opts.limit` is honored only when it is an
; integer greater than zero — the one `limit` the human asked for — and any
; other value (zero, negative, absent, non-integer) falls back to 20, exactly as
; the live `if is_integer(opts.limit) and opts.limit > 0, do: opts.limit, else:
; 20`. `BeamLisp.LazySeq/sample/2` then realizes at most `limit + 2` cells — the
; sample peeks one cell past the bound to learn truncation, and `prefix`'s final
; step realizes one more — so an infinite seq realizes a bounded prefix and
; never the whole tail.
;
; CONCAT WANTS A FLAT LIST. `Inspect.Algebra.concat/1` folds a FLAT list of
; docs — a nested list is not a doc and crashes the algebra formatter. Each
; element becomes a doc with `Inspect.Algebra/to_doc/2`, the docs are
; interspersed with a literal `" "` doc, an ellipsis `"…"` is appended when the
; sample was truncated, and the whole is wrapped in `"("` / `")"`. The flat
; list is assembled with `Enum/concat/1` — one level of flattening, the pinned
; `vector.bl` `cat2` idiom — over RAW Erlang lists (`(list …)`), so the argument
; is an Erlang list of doc terms, never a `BeamLisp.Vector` (or a nested list)
; the algebra formatter cannot read.
;
; FUNCTIONS-ONLY: no `:struct_fields`, so this beam gains no `__struct__` or
; `__info__` export. `__impl__`'s error names its own module from a fun literal
; compiled into THIS file, so at a probe atom it answers that atom —
; module-exact, never a hard-coded `Inspect.BeamLisp.LazySeq`. The call to the
; TYPE module (`BeamLisp.LazySeq/sample`) IS the production atom by
; construction: the impl dispatches BY the value's tag, and the values it is
; reached with are production-tagged lazy nodes.
;
; NO OWN BARE HELPER CAPTURES. A top-level helper written as a defn would become
; public API the generated impl never had, and a bare own-fn symbol in value
; position is not a call — it would compile to `Env/fetch!` in a namespace the
; pinned beam does not carry. `inspect/2` therefore builds its per-element doc
; with a local `fn` and names no top-level helper.
;
; Run: bin/bl test test/bl/host_lazy_seq_test.bl

(ns host.lazy-seq-inspect)

(defn __impl__
  "The `defimpl`-generated introspection: `:for` is the type, `:protocol` the
   protocol. An unknown key is the `FunctionClauseError` the generated
   two-clause function raised."
  [k]
  (cond
    (= :for k) :"Elixir.BeamLisp.LazySeq"
    (= :protocol k) :"Elixir.Inspect"
    :else
      (erlang/error
        (Elixir.FunctionClauseError/exception
          (list (tuple :module (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))
                (tuple :function :__impl__)
                (tuple :arity 1))))))

(defn inspect
  "`Inspect.inspect/2`: render a lazy node as its list face — `(1 2 3…)`, the
   ellipsis flagging that more elements remain. `opts.limit` is honored only
   when it is a positive integer; anything else samples 20. Each element is
   rendered with the SAME `opts`, and the docs are concatenated FLAT."
  [lazy opts]
  (let [limit (let [n (maps/get :limit opts)]
                (if (and (erlang/is_integer n) (erlang/> n 0)) n 20))
        cell (BeamLisp.LazySeq/cell lazy)
        scalar? (and (not= nil cell) (not (erlang/is_list cell)))
        sampled (if scalar? (tuple (list cell) false)
                    (BeamLisp.LazySeq/sample lazy limit))
        elems (erlang/element 1 sampled)
        truncated (erlang/element 2 sampled)
        docs (Enum/map elems (fn [e] (Inspect.Algebra/to_doc e opts)))
        spaced (Enum/intersperse docs " ")
        body (if truncated (Enum/concat (list spaced (list "…"))) spaced)]
    (Inspect.Algebra/concat
      (Enum/concat (list (list (if scalar? "#LazySeq<" "(")) body
                         (list (if scalar? ">" ")")))))))
