; The public test-support helper must remain callable from Elixir ExUnit suites
; after test/support/beam_lisp_test.ex is removed. Never force an ordinary
; proper list; an improper tail that is a LazySeq is realized exactly once.
(ns host.test-helper)

(defn realize [value]
  (cond
    (and (erlang/is_map value)
         (erlang/== (maps/get :__struct__ value nil) :Elixir.BeamLisp.LazySeq))
      (BeamLisp.LazySeq/to_list value)
    (erlang/is_list value)
      (let [improper?
            (if (empty? value)
              false
              (loop [tail (erlang/tl value)]
                (cond
                  (or (nil? tail) (erlang/== tail (list))) false
                  (and (erlang/is_map tail)
                       (erlang/== (maps/get :__struct__ tail nil) :Elixir.BeamLisp.LazySeq)) true
                  (erlang/is_list tail) (recur (erlang/tl tail))
                  :else false)))]
        (if improper? (BeamLisp.LazySeq/to_list value) value))
    :else value))
