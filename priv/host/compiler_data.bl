; host/compiler_data.bl — the pinned HOST MODULE for `Elixir.BeamLisp.CompilerData`.
;
; This file is not a namespace. It is a `.bl` SOURCE that the bootstrap seed
; compiles with `BeamLisp.AOT/compile-host-file` into ONE exact-named beam
; (`Elixir.BeamLisp.CompilerData.beam`) whose top-level `defn`s are plain
; exported functions — the exact call surface every caller already names at
; `Elixir.BeamLisp.CompilerData`, so no caller is renamed. The pinned beam is
; committed into the floor (`priv/bootstrap/seed/`) and installed by
; `Bootstrap.install!/1`; the recalled `lib/beam_lisp/compiler_data.ex` is gone,
; and the beam is now the only implementation of the atom.
;
; WHY A PINNED MODULE AND NOT A NAMESPACE. `CompilerData` is the eager,
; finite-data traversal leaf the boot tier's own compiler calls on every
; compile. It must be loadable BEFORE the compiler is rebuilt, so it can never
; itself be an AOT-rebuilt `BeamLisp.Ns.*` namespace (that would be the
; bootstrap circle again). A pinned host beam is a fixed artifact named by the
; seed manifest, built by one generation and used by the next.
;
; ABI PARITY IS THE CONTRACT. Every function below reproduces its Elixir
; counterpart clause for clause — the same Enum primitives, the same evaluation
; order, the same return types, the same exception class — so the pinned beam
; stands in for the module every caller already names, and the port is a no-op
; at every call site. The tests pin BOTH halves: `test/bl/compiler_data_test.bl`
; asserts the INSTALLED module's answers as concrete expected values (and that
; its beam IS the committed seed's bytes, source stamp and codegen key), while
; `test/bl/host_module_test.bl` compiles this file at a probe atom and compares
; it to the committed seed over a corpus that includes vectors, raw maps, an
; improper list, and the no-op clauses. `invoke1`/`proper-listing` are private
; helpers, not new API.
;
; Vector traversal delegates to Vector/to_list so source transforms remain
; correct when immutable vectors move from flat tuples to persistent tries.
; The small-vector ABI remains unchanged; larger-vector behavior is guarded
; by compiler_vector_source_test.bl before a coherent seed is published.

(ns host.compiler-data)

(defn- invoke1
  "Call the callable `f` with one argument through the runtime's invocation
   contract — a beam-lisp fn, an Elixir fun, or a callable collection all work."
  [f x]
  (BeamLisp.Ns.Rt/invoke f (list x)))

(defn- invalid-input! []
  (erlang/error
    (Elixir.ArgumentError/exception
      "compiler collection must be finite data (proper list, vector, map or nil), not LazySeq")))

(defn- proper-listing
  "The list `xs` if it is a proper list, else `invalid-input!`. `length/1` is the
   validation: it is O(n) on the spine (so it catches a cycle too, not just a
   non-list tail) and it raises `ArgumentError` on an improper cons — which is
   exactly `is_list/1`'s blind spot. `length/1` was the recalled Elixir
   module's validation too."
  [xs]
  (try
    (erlang/length xs)
    xs
    (catch _e (invalid-input!))))

(defn eager_to_list
  "A plain Erlang list from a finite compiler collection: a proper list, a
   Vector, a raw map (as `[k v]` vector pairs), or nil. Anything else — a
   LazySeq, a struct other than Vector, a number — is REFUSED rather than
   partially realized, so a callback is never invoked on malformed input."
  [x]
  (cond
    (nil? x) (list)
    (vector? x) (BeamLisp.Vector/to_list x)
    (erlang/is_list x) (proper-listing x)
    (and (erlang/is_map x) (not (erlang/is_map_key :__struct__ x)))
      (Enum/map (maps/to_list x)
                (fn [pair] (BeamLisp.Vector/new (list (erlang/element 1 pair) (erlang/element 2 pair)))))
    :else (invalid-input!)))

(defn eager_map
  "`(eager_map f coll)` is `Enum.map` with `f` invoked through the runtime;
   `(eager_map f left right)` zips (to the shorter) and invokes `f` pairwise."
  ([f coll]
   (Enum/map (eager_to_list coll) (fn [x] (invoke1 f x))))
  ([f left right]
   (Enum/map (Enum/zip (eager_to_list left) (eager_to_list right))
             (fn [pair] (BeamLisp.Ns.Rt/invoke f (list (erlang/element 1 pair) (erlang/element 2 pair)))))))

(defn eager_filter [f coll]
  (Enum/filter (eager_to_list coll) (fn [x] (invoke1 f x))))

(defn eager_concat [colls]
  (Enum/flat_map (eager_to_list colls) (fn [c] (eager_to_list c))))

(defn eager_mapcat [f coll]
  (Enum/flat_map (eager_to_list coll) (fn [item] (eager_to_list (invoke1 f item)))))

(defn eager_map_indexed [f coll]
  (Enum/map (Enum/with_index (eager_to_list coll))
            (fn [pair] (BeamLisp.Ns.Rt/invoke f (list (erlang/element 2 pair) (erlang/element 1 pair))))))

(defn eager_sort_by [f coll]
  (Enum/sort_by (eager_to_list coll) (fn [x] (invoke1 f x))))

(defn eager_group_by
  "Keys in source order, values in source order. Prepend-then-reverse per group,
   with a name vector in the map — the same shape and the same key-function
   call order the recalled Elixir module produced (including its `Map.new/2`
   final pass)."
  [f coll]
  (Map/new
    (Enum/reduce (eager_to_list coll) {}
      (fn [item groups]
        (let [k (invoke1 f item)]
          (Map/update groups k (list item) (fn [vs] (cons item vs))))))
    (fn [pair]
      (erlang/list_to_tuple (list (erlang/element 1 pair) (Enum/reverse (erlang/element 2 pair)))))))

(defn eager_distinct [coll]
  (Enum/uniq (eager_to_list coll)))

(defn eager_range
  "Exclusive `stop`, empty when `start >= stop` — `(start, stop)`."
  ([stop] (eager_range 0 stop))
  ([start stop]
   (cond
     (and (erlang/is_integer start) (erlang/is_integer stop))
     (if (erlang/< start stop) (lists/seq start (erlang/- stop 1)) (list))

     :else (erlang/error (Elixir.ArgumentError/exception "eager_range expects integers")))))

;; First-order raw data is a compiler kernel boundary as well as an SDK API.
;; Keep one implementation here so cold staging need not initialize std to
;; validate the data it is compiling. SDK data.first-order delegates unchanged.
(defn- first_order_refuse! [reason]
 (throw (ex-info "Expected bounded first-order data" {:kind :unsafe-first-order-data :reason reason})))

(defn- raw_data_remaining!
 "Return remaining structural budgets after bounded raw validation. Admit scalar data,
  proper lists, plain maps, BL symbol descriptors, canonical native vectors
  and sets. Thread counters purely; allocate no atom/NIF resource per check.
  Validate opaque/forged structs and vector storage before protocol dispatch."
 [value options constructor-proof]
  (when-not (and (erlang/is_map options) (not (erlang/is_map_key :__struct__ options)))
   (first_order_refuse! :invalid-limits))
  (let [max-nodes (get options :max-nodes 16384) max-bytes (get options :max-bytes 1048576)
        max-depth (get options :max-depth 64)]
   (when-not (and (int? max-nodes) (<= 1 max-nodes 1000000)
                  (int? max-bytes) (<= 1 max-bytes 67108864)
                  (int? max-depth) (<= 1 max-depth 128)) (first_order_refuse! :invalid-limits))
   (letfn [(spend [budget depth amount]
             (when (> depth max-depth) (first_order_refuse! :depth-limit))
             (let [nodes (dec (elem budget 0)) bytes (- (elem budget 1) amount)]
              (when (neg? nodes) (first_order_refuse! :node-limit))
              (when (neg? bytes) (first_order_refuse! :byte-limit))
              (tuple nodes bytes)))
           (dense [items budget depth]
             (when-not (and (erlang/is_tuple items) (<= (erlang/tuple_size items) 32))
              (first_order_refuse! :vector-storage))
             (loop [index 1 remaining budget]
              (if (> index (erlang/tuple_size items)) remaining
               (recur (inc index) (walk (erlang/element index items) remaining (inc depth))))))
           (trie [node level expected budget depth]
             (let [budget (spend budget depth 0)]
              (when-not (and (erlang/is_tuple node) (= 32 (erlang/tuple_size node)))
               (first_order_refuse! :vector-trie))
              (if (= 0 level)
               (do (when-not (= 32 expected) (first_order_refuse! :vector-count)) (dense node budget depth))
               (let [capacity (erlang/bsl 1 level)]
                (loop [index 1 left expected remaining budget]
                 (if (> index 32)
                  (do (when-not (= 0 left) (first_order_refuse! :vector-count)) remaining)
                  (let [child (erlang/element index node) amount (min left capacity)]
                   (if (= 0 amount)
                    (do (when-not (erlang/== nil child) (first_order_refuse! :vector-placement))
                        (recur (inc index) left (spend remaining (inc depth) 0)))
                    (do (when (erlang/== nil child) (first_order_refuse! :vector-placement))
                        (recur (inc index) (- left amount)
                          (trie child (- level 5) amount remaining (inc depth))))))))))))
           (vector-data [v budget depth]
             (when-not (and (= 3 (erlang/map_size v)) (erlang/is_map_key :items v)
                            (erlang/is_map_key :meta v)) (first_order_refuse! :vector-fields))
             (let [budget (walk (erlang/map_get :meta v) budget (inc depth))
                   items (erlang/map_get :items v)]
              (when-not (erlang/is_tuple items) (first_order_refuse! :vector-storage))
              (if (and (= 5 (erlang/tuple_size items)) (erlang/== :bl_vec (erlang/element 1 items))
                       (erlang/is_integer (erlang/element 2 items)) (> (erlang/element 2 items) 32))
               (let [count (erlang/element 2 items) shift (erlang/element 3 items)
                     root (erlang/element 4 items) tail (erlang/element 5 items)]
                (when (> count max-nodes) (first_order_refuse! :node-limit))
                (when-not (and (erlang/is_integer shift)
                               (<= 5 shift 30) (= 0 (erlang/rem shift 5))
                               (erlang/is_tuple tail) (<= 1 (erlang/tuple_size tail) 32))
                 (first_order_refuse! :vector-trie))
                (let [tree-count (- count (erlang/tuple_size tail))]
                 (when-not (and (= 0 (erlang/rem tree-count 32))
                                (= (erlang/tuple_size tail) (inc (erlang/rem (dec count) 32)))
                                (or (= 5 shift) (> tree-count (erlang/bsl 1 shift))))
                  (first_order_refuse! :vector-count))
                 (dense tail (trie root shift tree-count budget (inc depth)) (inc depth))))
               (dense items budget (inc depth)))))
           (plain-map [v budget depth]
             (loop [iterator (maps/iterator v) remaining budget]
              (let [entry (maps/next iterator)]
               (if (erlang/== :none entry) remaining
                (let [after-key (walk (erlang/element 1 entry) remaining (inc depth))
                      after-value (walk (erlang/element 2 entry) after-key (inc depth))]
                 (recur (erlang/element 3 entry) after-value))))))
           (set-data [v budget depth]
             (when-not (and (= 2 (erlang/map_size v)) (erlang/is_map_key :members v))
              (first_order_refuse! :set-fields))
             (let [members (erlang/map_get :members v)]
              (when-not (and (erlang/is_map members) (= 2 (erlang/map_size members))
                             (erlang/is_map_key :__struct__ members)
                             (erlang/== :Elixir.MapSet (erlang/map_get :__struct__ members))
                             (erlang/is_map_key :map members)) (first_order_refuse! :set-storage))
              (let [entries (erlang/map_get :map members)]
               (when-not (and (erlang/is_map entries) (not (erlang/is_map_key :__struct__ entries)))
                (first_order_refuse! :set-storage))
               (plain-map entries (spend budget (inc depth) 0) (inc depth)))))
           (walk [v budget depth]
             (let [budget (spend budget depth
                            (cond (erlang/is_binary v) (erlang/byte_size v)
                                  (erlang/is_atom v) (erlang/byte_size (erlang/atom_to_binary v :utf8))
                                  (erlang/is_number v) (erlang/external_size v) :else 0))]
              (cond
               (or (erlang/is_atom v) (erlang/is_number v) (erlang/is_binary v)) budget
               (and constructor-proof
                    (or (erlang/is_function v)
                        (and (erlang/is_tuple v) (= 3 (erlang/tuple_size v))
                             (erlang/== :"$blfn" (erlang/element 1 v))))
                    (erlang/is_map_key v (erlang/map_get :callables constructor-proof))) budget
               (and constructor-proof
                    (not (erlang/== nil (erlang/map_get :recipe-frame constructor-proof)))
                    (erlang/is_map v) (= 3 (erlang/map_size v))
                    (erlang/is_map_key :__struct__ v)
                    (erlang/== :Elixir.BeamLisp.LazySeq (erlang/map_get :__struct__ v))
                    (erlang/is_map_key :constructor-frame v)
                    (erlang/== (erlang/map_get :recipe-frame constructor-proof)
                               (erlang/map_get :constructor-frame v))
                    (erlang/is_map_key :constructor-id v)
                    (erlang/is_integer (erlang/map_get :constructor-id v))
                    (erlang/is_map_key (erlang/map_get :constructor-id v)
                                      (erlang/map_get :recipes constructor-proof))) budget
               (erlang/is_list v)
                (loop [remaining v current budget]
                 (if (erlang/== (list) remaining) current
                  (do (when-not (erlang/is_list remaining) (first_order_refuse! :improper-list))
                      (recur (erlang/tl remaining) (walk (erlang/hd remaining) current (inc depth))))))
               (erlang/is_tuple v)
                (if (and (= 2 (erlang/tuple_size v)) (erlang/== :symbol (erlang/element 1 v))
                         (erlang/is_binary (erlang/element 2 v)))
                 (walk (erlang/element 2 v) budget (inc depth))
                 (if constructor-proof
                  (loop [index 1 remaining budget]
                   (if (> index (erlang/tuple_size v)) remaining
                    (recur (inc index) (walk (erlang/element index v) remaining (inc depth)))))
                  (first_order_refuse! :native-tuple)))
               (erlang/is_map v)
                (if (erlang/is_map_key :__struct__ v)
                 (let [tag (erlang/map_get :__struct__ v)]
                  (cond (erlang/== :Elixir.BeamLisp.Vector tag) (vector-data v budget depth)
                        (erlang/== :Elixir.BeamLisp.Set tag) (set-data v budget depth)
                        :else (first_order_refuse! :foreign-struct)))
                 (plain-map v budget depth))
               :else (first_order_refuse! :opaque-value))))]
    (walk value (tuple max-nodes max-bytes) 0))))

(defn- first_order_remaining!
 ([value] (first_order_remaining! value {}))
 ([value options] (raw_data_remaining! value options nil)))

(defn check_first_order!
 "Pure raw-term validator shared by the SDK and compile-only kernel staging.
  No namespace loading, protocol dispatch or opaque callback invocation."
 ([value] (check_first_order! value {}))
 ([value options] (first_order_remaining! value options) value))

(defn first_order_cost!
 "Validate once and report exact raw traversal nodes/bytes for aggregate
  constructor quotas. These are structural budgets, not serialized heap sizes."
 ([value] (first_order_cost! value {}))
 ([value options]
  (let [remaining (first_order_remaining! value options)]
   {:nodes (- (get options :max-nodes 16384) (elem remaining 0))
    :bytes (- (get options :max-bytes 1048576) (elem remaining 1))})))


(defn constructor_data_cost!
 "Raw, effect-free INTERNAL constructor data domain. Public first-order data
  remains unchanged. Tuples are finite data here; native Fn/BLFn and private
  capsules require exact caller-owned leaf witnesses. Witnesses authorize only
  validation, never invocation. No protocols, namespace lookup or callback runs."
 [value proof]
 (when-not (and (erlang/is_map proof) (= 3 (erlang/map_size proof))
                (erlang/is_map_key :callables proof) (erlang/is_map (erlang/map_get :callables proof))
                (<= (erlang/map_size (erlang/map_get :callables proof)) 16384)
                (erlang/is_map_key :recipes proof) (erlang/is_map (erlang/map_get :recipes proof))
                (<= (erlang/map_size (erlang/map_get :recipes proof)) 4096)
                (erlang/is_map_key :recipe-frame proof))
  (first_order_refuse! :invalid-constructor-witness))
 (let [remaining (raw_data_remaining! value
                  {:max-nodes 65536 :max-bytes 1048576 :max-depth 128} proof)]
  {:nodes (- 65536 (elem remaining 0)) :bytes (- 1048576 (elem remaining 1))}))
