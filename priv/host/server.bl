; host/server.bl — the pinned HOST MODULE for `Elixir.BeamLisp.Server`.
;
; `lib/beam_lisp/server.ex` is the runtime side of the `defserver` special form.
; `priv/boot/compiler.bl`'s `compile-defserver` lowers `(defserver name …)` into a
; REAL `:gen_server` behaviour module and leans on this module for three things:
; the module NAME the generated beam gets (`module_for/2`), the OTP callback
; NAMES and clause SHAPES the generated callbacks must carry (`callback/1`,
; `callback_order/0`), and the return constructors bound as locals in every
; callback body (`return_constructors/0`). Everything else here is the CLIENT
; side: `start`/`start_link`/`call`/`cast`/`stop`, which wrap `:gen_server`
; rather than reimplement it.
;
; This file is the `.bl` port of that module, compiled by
; `BeamLisp.AOT/compile_host_file` into ONE exact-named beam whose export
; surface is the live module's, datum for datum.
;
;   (This wave owns source and tests only; the seed entry that points the real
;   atom at this file is written by the wave that deletes `server.ex`. That
;   entry needs NO compile option — the module is FUNCTIONS-ONLY: no struct to
;   synthesize, no behaviour to record, no macro to export — and it needs NO
;   `AOTCache.@pinned_host_sources` row either: that table exists so a CODEGEN
;   module's source keeps feeding the codegen key after its `.ex` is deleted,
;   and `BeamLisp.Server` is not a `@codegen_modules` member — the compiler
;   CALLS it, it does not compile it.)
;
; WHAT THE MODULE OWES, clause for clause:
;
;   * `module_for/2` — `(ns <> "." <> name)`, split on `.`, each segment
;     `Macro.camelize/1`d, `Module.concat([BeamLisp.Server | segments])`. The
;     concat is built by FOLDING the segments onto the prefix atom, which is
;     the same `Enum.reduce` `priv/host/emit.bl` uses and answers the identical
;     module for every input `Module.concat/1` does — including the empty
;     segment list, where the fold's accumulator IS the answer. The binary
;     concatenation is NOT `:erlang.iolist_to_binary/1`: the live `<>` builds a
;     bitstring, so a non-binary operand raises `ArgumentError` naming the
;     SEGMENT and the offending value ("construction of binary failed: segment
;     1 of type 'binary': expected a binary but got: …"), while `iolist_to_binary`
;     would accept a bare byte and silently build a different name. The two
;     segment numbers (1 for `ns`, 3 for `name` — the "." is segment 2) are the
;     live compiler's, measured, and are what a caller's rescue sees.
;
;   * `return_constructors/0` — a map keyed by the STRING name the compiler
;     looks up (`Map.fetch!(ctors, "reply")`), each value a real beam-lisp
;     multi-arity fn (`{:"$blfn", %{arity => fun}, nil}`) so `rt/invoke` can
;     reach it with the callback's arguments. Every OTP return shape is
;     expressible: `ok`/`reply`/`noreply`/`stop`, plus the arity-0 `ignore` and
;     `hibernate` and the arity-1 `continue` that fill the TIMEOUT slot. The
;     map is written with `:maps.put` chains rather than a literal because a
;     beam-lisp map literal keys on atoms, and these keys are binaries.
;
;   * `callback/1` — the clause dispatch from a `defserver` callback keyword
;     (`"handle-call"`) to `{otp_name, arity, shape}`, and `nil` for anything
;     else. `:pattern` means the clauses carry a message pattern plus a param
;     vector; `:vector` means only a param vector.
;
;   * the CLIENT verbs. `start_link`/`start` differ in ONE call
;     (`:gen_server.start_link` vs `:gen_server.start`); both convey the
;     caller's env across the OTP start boundary, both translate the beam-lisp
;     option map, and both UNWRAP. `call`/`cast`/`stop` route every server
;     through `resolve/1` first.
;
;   * `{:name :counter}` registers LOCALLY. Explicit standard OTP names also
;     work: `{:local atom}`, `{:global term}`, `{:via module term}`. These
;     preserve application-instance term identities without allocating atoms.
;     Malformed names retain CaseClauseError instead of silently starting an
;     anonymous owner where the caller requested registration.
;
;   * `%{__supervisor__: true}` as the first argument is the `defsupervisor`
;     dispatch: `start_link/1,2` and `start/1,2` reach the `start_link/3` /
;     `start/3` clause whose head is a map carrying that key AND `nil` AND
;     `opts == %{}`, and delegate to `BeamLisp.Supervisor.start_link/1`. Extra
;     args (an init arg, opts) do not apply to a tree, so they are refused by
;     NOT MATCHING that clause rather than dropped.
;
;   * `unwrap/1` — `{:ok, pid}` is the pid, `:ignore` is `nil`, and
;     `{:error, reason}` RAISES: a beam-lisp caller wants the pid, and a tuple
;     that fails at the next call site is worse than a start that says why. The
;     fourth shape does not exist (`:gen_server` answers the first three), so
;     the live `case` has no catch-all — the port raises the same
;     `FunctionClauseError` in place of one.
;
;   * `resolve/1` — A NAME IS A VALUE. A two-element `BeamLisp.Vector` whose
;     `items` is a 2-tuple and whose first element is an ATOM names a
;     defregistry server and a key; resolution calls that registry ONCE and
;     answers the pid registered under the key. Anything else — every other
;     vector, every non-vector, a vector whose first element is not an atom —
;     passes through untouched, exactly as the live second clause does. A
;     registry that is not running, and a key with no process under it, are the
;     two live `ArgumentError`s, message for message.
;
;   * `bind_init/1` — the other half of the conveyance: the server process
;     begins with an empty process dictionary, so it resolves names at
;     `:global`, not in the fork that started it. `start`/`start_link` tuck the
;     captured token beside the user's init arg as a private 3-tuple whose head
;     is `:"$bl_conveyed_env"`, and the generated `init/1` calls this on its
;     argument before running the user body. A plain (non-wrapped) arg passes
;     through untouched — a server started through raw OTP still works, just
;     without conveyance.
;
; GUARDS AND CLAUSE HEADS BECOME BODY CHECKS. A pinned `.bl` parameter pattern
; compiles to a body-level match, not a clause head, so every guard
; (`is_map(opts)`, `is_atom(name)`) and every clause head is written as an
; explicit boolean, and every clause refusal raises the SAME error the BEAM
; raised — `CaseClauseError` with the live `term`, and `FunctionClauseError`
; (module, function, arity) for the arity-3 functions, named with THIS beam's
; own atom (read from a fun literal compiled into this file, the
; `seq_cursor.bl`/`supervisor.bl` idiom) so a probe compile names the probe
; atom.
;
; NO TOP-LEVEL HELPERS. A pinned module's export surface IS the file's
; top-level defns (`defn-` is NOT privatized on this path), and the live
; module's private helpers are not exports — the surface test pins that. Every
; helper (`convey_arg`, `unwrap`, `server_name`, `gen_opts`, `resolve`) is
; therefore a LOCAL closure, rebuilt inside the public fn that needs it, so
; `module_info(:exports)` of this beam is the live module's minus the
; Elixir-generated `__info__/1`.
;
; RUNTIME-TIER, NOT BOOT-TIER. Every caller is language, library or compiler
; code that runs after `BeamLisp.init/0` has interned the prelude, so the
; `(defn …)` bodies may call host modules (`:gen_server`, `BeamLisp.Env`,
; `BeamLisp.Supervisor`, `Process`, `String`, `Macro`, `Module`, `Enum`,
; `Kernel`). No `str` var and no beam-lisp var lookup is used anywhere: every
; binary is built from `erlang/iolist_to_binary`, which needs no var table —
; the `priv/host/supervisor.bl` rule, kept here because this beam is a host
; leaf a genesis-less boot may install.
;
; Run: bin/bl test test/bl/host_server_test.bl

(ns host.server)

; ── module naming ────────────────────────────────────────────────────────────

(defn module_for
  "The generated module backing `(defserver name …)` in namespace `ns`, the
   value bound by the `defserver` form itself.

   `(ns <> \".\" <> name)` split on `.`, every segment camelized, concatenated
   onto the `BeamLisp.Server` prefix — so `(\"user\", \"counter\")` is
   `BeamLisp.Server.User.Counter` and the scheme is predictable enough for a
   supervisor to reference a server by name."
  [ns name]
  (let [cat (fn [a b]
              (cond
                (not (erlang/is_binary a))
                (erlang/error
                  (Elixir.ArgumentError/exception
                    (erlang/iolist_to_binary
                      (list "construction of binary failed: segment 1 of type 'binary': expected a binary but got: "
                            (Kernel/inspect a)))))

                (not (erlang/is_binary b))
                (erlang/error
                  (Elixir.ArgumentError/exception
                    (erlang/iolist_to_binary
                      (list "construction of binary failed: segment 3 of type 'binary': expected a binary but got: "
                            (Kernel/inspect b)))))

                :else (erlang/iolist_to_binary (list a "." b))))]
    (Enum/reduce
      (String/split (cat ns name) ".")
      (BeamLisp.Emit/realm_base ns :"Elixir.BeamLisp.Server")
      (fn [segment mod] (Module/concat mod (Macro/camelize segment))))))

; ── return constructors ──────────────────────────────────────────────────────

(defn return_constructors
  "The return constructors bound as locals in every server callback body. Each
   value is a beam-lisp `$blfn` dispatching on arity, so the compiler's
   `rt/invoke` call path can invoke it with the callback's arguments and get
   back the exact OTP return tuple:

       ok      → {:ok, s}            {:ok, s, t}          (init)
       reply   → {:reply, r, s}      {:reply, r, s, t}    (handle_call)
       noreply → {:noreply, s}       {:noreply, s, t}     (call/cast/info)
       stop    → {:stop, r}          (init)
                 {:stop, r, s}       (cast/info)
                 {:stop, r, reply, s}(handle_call)
       ignore      → :ignore         (init)
       hibernate   → :hibernate      (timeout slot)
       continue    → {:continue, t}  (timeout slot)"
  []
  (maps/put "ok"
    (tuple :"$blfn"
      (maps/put 1 (fn [s] (tuple :ok s))
        (maps/put 2 (fn [s t] (tuple :ok s t)) (maps/new)))
      nil)
    (maps/put "reply"
      (tuple :"$blfn"
        (maps/put 2 (fn [r s] (tuple :reply r s))
          (maps/put 3 (fn [r s t] (tuple :reply r s t)) (maps/new)))
        nil)
      (maps/put "noreply"
        (tuple :"$blfn"
          (maps/put 1 (fn [s] (tuple :noreply s))
            (maps/put 2 (fn [s t] (tuple :noreply s t)) (maps/new)))
          nil)
        (maps/put "stop"
          (tuple :"$blfn"
            (maps/put 1 (fn [r] (tuple :stop r))
              (maps/put 2 (fn [r s] (tuple :stop r s))
                (maps/put 3 (fn [r reply s] (tuple :stop r reply s)) (maps/new))))
            nil)
          (maps/put "ignore"
            (tuple :"$blfn" (maps/put 0 (fn [] :ignore) (maps/new)) nil)
            (maps/put "hibernate"
              (tuple :"$blfn" (maps/put 0 (fn [] :hibernate) (maps/new)) nil)
              (maps/put "continue"
                (tuple :"$blfn" (maps/put 1 (fn [t] (tuple :continue t)) (maps/new)) nil)
                (maps/new)))))))))

; ── the callback vocabulary ──────────────────────────────────────────────────

(defn callback
  "Map a defserver callback keyword (`\"handle-call\"`) to the OTP callback
   function name and arity (`{:handle_call, 3}`), together with the SHAPE of its
   clause: `:pattern` (a message pattern plus a param vector) or `:vector` (only
   a param vector). `nil` for a name that is not a server callback — the boot
   codegen reads that `nil` as \"not a callback\" rather than guessing."
  [name]
  (cond
    (erlang/== name "init")            (tuple :init 1 :vector)
    (erlang/== name "handle-call")     (tuple :handle_call 3 :pattern)
    (erlang/== name "handle-cast")     (tuple :handle_cast 2 :pattern)
    (erlang/== name "handle-info")     (tuple :handle_info 2 :pattern)
    (erlang/== name "handle-continue") (tuple :handle_continue 2 :vector)
    (erlang/== name "terminate")       (tuple :terminate 2 :vector)
    :else nil))

(defn callback_order
  "Canonical emission order for generated callbacks (drives adjacency)."
  []
  (list :init :handle_call :handle_cast :handle_info :handle_continue :terminate :code_change))

; ── the env conveyed across the OTP start boundary ───────────────────────────

(defn bind_init
  "Restore the start boundary's Env. App-owned sealed modules also register a
   native whole-graph lease held by the actor until its death. Framework shared
   owners keep their own explicit callback transition protocol."
  [arg]
  (cond
    (and (erlang/is_tuple arg) (erlang/== 4 (erlang/tuple_size arg))
         (erlang/== :"$bl_conveyed_generation" (erlang/element 1 arg)))
    (do
      (BeamLisp.Env/bind (erlang/element 2 arg))
      (let [generation (Process/get :bl_generation)
            module (erlang/element 3 arg)]
        (when (or (erlang/== nil generation)
                  (erlang/not (Enum/member? (Map/get generation :modules) module)))
          (erlang/error :unowned_generation_server))
        (let [lease (BeamLisp.Env/retain_code! (Map/get generation :modules))]
          (ets/insert :beam_lisp_vars
            (tuple (tuple :bl_generation_owner (erlang/self))
              {:kind :server :generation (Map/get generation :digest)
               :application-id (Map/get generation :application-id) :lease lease})))
        (erlang/element 4 arg)))
    (and (erlang/is_tuple arg) (erlang/== 3 (erlang/tuple_size arg))
         (erlang/== :"$bl_conveyed_env" (erlang/element 1 arg)))
    (do (BeamLisp.Env/bind (erlang/element 2 arg)) (erlang/element 3 arg))
    :else arg))

; ── client side ──────────────────────────────────────────────────────────────

(defn start_link
  "Start a supervised server. `mod` is the value bound by `defserver`; a
   `defsupervisor` spec (a map carrying `:__supervisor__`) with no init arg and
   no opts delegates to `BeamLisp.Supervisor.start_link/1` instead."
  ([mod] (start_link mod nil (maps/new)))
  ([mod arg] (start_link mod arg (maps/new)))
  ([mod arg opts]
   (let [unwrap
         (fn [result]
           (cond
             (and (erlang/is_tuple result)
                  (erlang/== 2 (erlang/tuple_size result))
                  (erlang/== :ok (erlang/element 1 result)))
             (erlang/element 2 result)

             (erlang/== :ignore result)
             nil

             (and (erlang/is_tuple result)
                  (erlang/== 2 (erlang/tuple_size result))
                  (erlang/== :error (erlang/element 1 result)))
             (erlang/error
               (Elixir.RuntimeError/exception
                 (erlang/iolist_to_binary
                   (list "server failed to start: " (Kernel/inspect (erlang/element 2 result))))))

             :else
             (let [own (erlang/element 2 (erlang/fun_info (fn [] nil) :module))]
               (erlang/error
                 (Elixir.FunctionClauseError/exception
                   (list (tuple :module own)
                         (tuple :function :unwrap)
                         (tuple :arity 1)))))))]
     (if (and (erlang/is_map mod)
              (erlang/is_map_key :__supervisor__ mod)
              (erlang/== true (erlang/map_get :__supervisor__ mod))
              (erlang/== nil arg)
              (erlang/== opts (maps/new)))
       (BeamLisp.Supervisor/start_link mod)
       (let [generation (Process/get :bl_generation)
             _ (when (and (erlang/is_atom mod)
                     (String/starts_with? (erlang/atom_to_binary mod :utf8) "Elixir.BeamLisp.Server.Sealed.")
                     (or (erlang/== nil generation)
                         (erlang/not (Enum/member? (Map/get generation :modules) mod))))
                 (erlang/error :generation_context_required))
             conveyed (if (and generation (Enum/member? (Map/get generation :modules) mod))
                        (tuple :"$bl_conveyed_generation" (BeamLisp.Env/capture) mod arg)
                        (tuple :"$bl_conveyed_env" (BeamLisp.Env/capture) arg))
             ; Preserve standard OTP naming values; nil alone is anonymous.
             ; The native server owns registration and duplicate refusal.
             name (if (erlang/is_map opts)
                    (let [n (Map/get opts :name)]
                      (cond
                        (erlang/== nil n) nil
                        (erlang/is_atom n) (tuple :local n)
                        (and (erlang/is_tuple n) (erlang/== 2 (erlang/tuple_size n))
                             (erlang/== :local (erlang/element 1 n))
                             (erlang/is_atom (erlang/element 2 n))) n
                        (and (erlang/is_tuple n) (erlang/== 2 (erlang/tuple_size n))
                             (erlang/== :global (erlang/element 1 n))) n
                        (and (erlang/is_tuple n) (erlang/== 3 (erlang/tuple_size n))
                             (erlang/== :via (erlang/element 1 n))
                             (erlang/is_atom (erlang/element 2 n))) n
                        :else
                        (erlang/error
                          (Elixir.CaseClauseError/exception (list (tuple :term n))))))
                    nil)
             gopts (if (erlang/is_map opts)
                     (let [t (Map/get opts :timeout)]
                       (if (erlang/== nil t) (list) (list (tuple :timeout t))))
                     (list))]
         (unwrap
           (if (erlang/== nil name)
             (erlang/apply :gen_server :start_link (list mod conveyed gopts))
             (erlang/apply :gen_server :start_link (list name mod conveyed gopts)))))))))

(defn start
  "Start an unsupervised server. Same contract as `start_link` — including the
   `defsupervisor` delegation — over `:gen_server.start/3,4`."
  ([mod] (start mod nil (maps/new)))
  ([mod arg] (start mod arg (maps/new)))
  ([mod arg opts]
   (let [unwrap
         (fn [result]
           (cond
             (and (erlang/is_tuple result)
                  (erlang/== 2 (erlang/tuple_size result))
                  (erlang/== :ok (erlang/element 1 result)))
             (erlang/element 2 result)

             (erlang/== :ignore result)
             nil

             (and (erlang/is_tuple result)
                  (erlang/== 2 (erlang/tuple_size result))
                  (erlang/== :error (erlang/element 1 result)))
             (erlang/error
               (Elixir.RuntimeError/exception
                 (erlang/iolist_to_binary
                   (list "server failed to start: " (Kernel/inspect (erlang/element 2 result))))))

             :else
             (let [own (erlang/element 2 (erlang/fun_info (fn [] nil) :module))]
               (erlang/error
                 (Elixir.FunctionClauseError/exception
                   (list (tuple :module own)
                         (tuple :function :unwrap)
                         (tuple :arity 1)))))))]
     (if (and (erlang/is_map mod)
              (erlang/is_map_key :__supervisor__ mod)
              (erlang/== true (erlang/map_get :__supervisor__ mod))
              (erlang/== nil arg)
              (erlang/== opts (maps/new)))
       (BeamLisp.Supervisor/start_link mod)
       (let [generation (Process/get :bl_generation)
             _ (when (and (erlang/is_atom mod)
                     (String/starts_with? (erlang/atom_to_binary mod :utf8) "Elixir.BeamLisp.Server.Sealed.")
                     (or (erlang/== nil generation)
                         (erlang/not (Enum/member? (Map/get generation :modules) mod))))
                 (erlang/error :generation_context_required))
             conveyed (if (and generation (Enum/member? (Map/get generation :modules) mod))
                        (tuple :"$bl_conveyed_generation" (BeamLisp.Env/capture) mod arg)
                        (tuple :"$bl_conveyed_env" (BeamLisp.Env/capture) arg))
             name (if (erlang/is_map opts)
                    (let [n (Map/get opts :name)]
                      (cond
                        (erlang/== nil n) nil
                        (erlang/is_atom n) (tuple :local n)
                        (and (erlang/is_tuple n) (erlang/== 2 (erlang/tuple_size n))
                             (erlang/== :local (erlang/element 1 n))
                             (erlang/is_atom (erlang/element 2 n))) n
                        (and (erlang/is_tuple n) (erlang/== 2 (erlang/tuple_size n))
                             (erlang/== :global (erlang/element 1 n))) n
                        (and (erlang/is_tuple n) (erlang/== 3 (erlang/tuple_size n))
                             (erlang/== :via (erlang/element 1 n))
                             (erlang/is_atom (erlang/element 2 n))) n
                        :else
                        (erlang/error
                          (Elixir.CaseClauseError/exception (list (tuple :term n))))))
                    nil)
             gopts (if (erlang/is_map opts)
                     (let [t (Map/get opts :timeout)]
                       (if (erlang/== nil t) (list) (list (tuple :timeout t))))
                     (list))]
         (unwrap
           (if (erlang/== nil name)
             (erlang/apply :gen_server :start (list mod conveyed gopts))
             (erlang/apply :gen_server :start (list name mod conveyed gopts)))))))))

; ── the verbs, and the registry resolution they share ────────────────────────

(defn call
  "Synchronous call. Default timeout matches OTP's 5s."
  ([server msg]
   (let [resolve
         (fn [server]
           (if (and (erlang/is_map server)
                    (erlang/is_map_key :__struct__ server)
                    (erlang/== :"Elixir.BeamLisp.Vector" (erlang/map_get :__struct__ server)))
             (let [items (erlang/map_get :items server)]
               (if (and (erlang/is_tuple items)
                        (erlang/== 2 (erlang/tuple_size items))
                        (erlang/is_atom (erlang/element 1 items)))
                 (let [reg (erlang/element 1 items) key (erlang/element 2 items)]
                   (if (erlang/== nil (Process/whereis reg))
                     (erlang/error
                       (Elixir.ArgumentError/exception
                         (erlang/iolist_to_binary
                           (list "no registry named " (Kernel/inspect reg) " is running"))))
                     (let [pid (erlang/apply :gen_server :call
                                 (list reg
                                       (maps/put :items (tuple :whereis key)
                                         (maps/put :__struct__ :"Elixir.BeamLisp.Vector"
                                           (maps/put :meta nil (maps/new))))))]
                       (cond
                         (erlang/== nil pid)
                         (erlang/error
                           (Elixir.ArgumentError/exception
                             (erlang/iolist_to_binary
                               (list "no process registered as " (Kernel/inspect (list reg key))))))

                         (erlang/is_pid pid) pid

                         :else
                         (erlang/error
                           (Elixir.CaseClauseError/exception (list (tuple :term pid))))))))
                 server))
             server))]
     (erlang/apply :gen_server :call (list (resolve server) msg))))
  ([server msg timeout]
   (let [resolve
         (fn [server]
           (if (and (erlang/is_map server)
                    (erlang/is_map_key :__struct__ server)
                    (erlang/== :"Elixir.BeamLisp.Vector" (erlang/map_get :__struct__ server)))
             (let [items (erlang/map_get :items server)]
               (if (and (erlang/is_tuple items)
                        (erlang/== 2 (erlang/tuple_size items))
                        (erlang/is_atom (erlang/element 1 items)))
                 (let [reg (erlang/element 1 items) key (erlang/element 2 items)]
                   (if (erlang/== nil (Process/whereis reg))
                     (erlang/error
                       (Elixir.ArgumentError/exception
                         (erlang/iolist_to_binary
                           (list "no registry named " (Kernel/inspect reg) " is running"))))
                     (let [pid (erlang/apply :gen_server :call
                                 (list reg
                                       (maps/put :items (tuple :whereis key)
                                         (maps/put :__struct__ :"Elixir.BeamLisp.Vector"
                                           (maps/put :meta nil (maps/new))))))]
                       (cond
                         (erlang/== nil pid)
                         (erlang/error
                           (Elixir.ArgumentError/exception
                             (erlang/iolist_to_binary
                               (list "no process registered as " (Kernel/inspect (list reg key))))))

                         (erlang/is_pid pid) pid

                         :else
                         (erlang/error
                           (Elixir.CaseClauseError/exception (list (tuple :term pid))))))))
                 server))
             server))]
     (erlang/apply :gen_server :call (list (resolve server) msg timeout)))))

(defn cast
  "Fire-and-forget cast. Always returns nil, as the reply is the absence of
   one."
  [server msg]
  (let [resolve
        (fn [server]
          (if (and (erlang/is_map server)
                   (erlang/is_map_key :__struct__ server)
                   (erlang/== :"Elixir.BeamLisp.Vector" (erlang/map_get :__struct__ server)))
            (let [items (erlang/map_get :items server)]
              (if (and (erlang/is_tuple items)
                       (erlang/== 2 (erlang/tuple_size items))
                       (erlang/is_atom (erlang/element 1 items)))
                (let [reg (erlang/element 1 items) key (erlang/element 2 items)]
                  (if (erlang/== nil (Process/whereis reg))
                    (erlang/error
                      (Elixir.ArgumentError/exception
                        (erlang/iolist_to_binary
                          (list "no registry named " (Kernel/inspect reg) " is running"))))
                    (let [pid (erlang/apply :gen_server :call
                                (list reg
                                      (maps/put :items (tuple :whereis key)
                                        (maps/put :__struct__ :"Elixir.BeamLisp.Vector"
                                          (maps/put :meta nil (maps/new))))))]
                      (cond
                        (erlang/== nil pid)
                        (erlang/error
                          (Elixir.ArgumentError/exception
                            (erlang/iolist_to_binary
                              (list "no process registered as " (Kernel/inspect (list reg key))))))

                        (erlang/is_pid pid) pid

                        :else
                        (erlang/error
                          (Elixir.CaseClauseError/exception (list (tuple :term pid))))))))
                server))
            server))]
    (erlang/apply :gen_server :cast (list (resolve server) msg))
    nil))

(defn stop
  "Stop a server, defaulting to a normal exit."
  ([server] (stop server :normal))
  ([server reason]
   (let [resolve
         (fn [server]
           (if (and (erlang/is_map server)
                    (erlang/is_map_key :__struct__ server)
                    (erlang/== :"Elixir.BeamLisp.Vector" (erlang/map_get :__struct__ server)))
             (let [items (erlang/map_get :items server)]
               (if (and (erlang/is_tuple items)
                        (erlang/== 2 (erlang/tuple_size items))
                        (erlang/is_atom (erlang/element 1 items)))
                 (let [reg (erlang/element 1 items) key (erlang/element 2 items)]
                   (if (erlang/== nil (Process/whereis reg))
                     (erlang/error
                       (Elixir.ArgumentError/exception
                         (erlang/iolist_to_binary
                           (list "no registry named " (Kernel/inspect reg) " is running"))))
                     (let [pid (erlang/apply :gen_server :call
                                 (list reg
                                       (maps/put :items (tuple :whereis key)
                                         (maps/put :__struct__ :"Elixir.BeamLisp.Vector"
                                           (maps/put :meta nil (maps/new))))))]
                       (cond
                         (erlang/== nil pid)
                         (erlang/error
                           (Elixir.ArgumentError/exception
                             (erlang/iolist_to_binary
                               (list "no process registered as " (Kernel/inspect (list reg key))))))

                         (erlang/is_pid pid) pid

                         :else
                         (erlang/error
                           (Elixir.CaseClauseError/exception (list (tuple :term pid))))))))
                 server))
             server))]
     (erlang/apply :gen_server :stop (list (resolve server) reason :infinity))
     nil)))
