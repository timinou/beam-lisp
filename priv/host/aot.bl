; host/aot.bl — the pinned HOST MODULE for `Elixir.BeamLisp.AOT`.
;
; This file is not a namespace. It is a `.bl` SOURCE that the bootstrap seed
; compiles with `BeamLisp.AOT/compile-host-file` into ONE exact-named beam
; (`Elixir.BeamLisp.AOT.beam`) whose top-level `defn`s are plain exported
; functions — the exact call surface every caller already names at
; `Elixir.BeamLisp.AOT`, so no caller is renamed. The pinned beam is committed
; into the floor (`priv/bootstrap/seed/`) and installed by
; `Bootstrap.install!/1`.
;
; WHY A PINNED MODULE AND NOT A NAMESPACE. `AOT` is the module that TURNS a
; `.bl` source into a beam, so it cannot itself be an AOT-rebuilt
; `BeamLisp.Ns.*` namespace: that would be the bootstrap circle. It is also
; asked a question BEFORE the language exists — `bin/bl`'s generated bootstrap
; reads `AOT.beam_provenance/1` for every boot namespace to decide whether
; `build/` holds one generation, and that read happens before
; `ensure_all_started`. A pinned host beam is a fixed artifact named by the
; seed manifest, built by one generation and used by the next.
;
; ── THE PREBOOT CONSTRAINT: NO Rt, NO core ──────────────────────────────────
;
; The functions on the launcher's path MUST run with nothing on the code path
; but Elixir/OTP, the other pinned host leaves, and this beam. That set is
; `ensure_loaded/1` → `stale?/2` → `stale_by_provenance?/2`/`tier_key_moved?/2`,
; `staging_namespaces/0`, `note_mixed_generation/0`, `beam_provenance/1`,
; `strict_aot?/0`, `stale_beam_error/4`, `short/1`. (The `:library` branch of
; `stale_by_provenance?` reaches `ns_closure_hash/2`, which the language drives
; and which is only reached once `core` is interned; it may use the runtime.)
; Those functions are written in the surface the BEAM itself provides:
;
;   * `erlang/==`, `erlang/=/=`, `erlang/is_binary`, `erlang/is_tuple`,
;     `erlang/is_list`, `erlang/is_map`, `erlang/is_atom`, `erlang/element`,
;     `erlang/tuple_size`, `erlang/apply`, `erlang/function_exported` are BIFs.
;     `=`, `nil?`, `some?`, `str`, `first`… would each compile to an
;     `BeamLisp.Ns.Rt` call or a core var fetch.
;   * `and`/`or`/`cond`/`when`/`if`/`try` are macros — they expand at compile
;     time into `if`/`let`, which emit nothing at runtime.
;   * `Enum`, `String`, `Code`, `Process`, `Application` and the pinned
;     `Tiers`/`Bootstrap` modules are host modules, on the path in any `elixir`
;     VM, and the same modules the Elixir twin called.
;
; ── ABI PARITY IS THE CONTRACT ──────────────────────────────────────────────
;
; Every function below reproduces its Elixir counterpart clause for clause —
; the same traversal, the same evaluation order, the same return types, the
; same exception class. The shapes that are easy to get subtly wrong and are
; therefore deliberate:
;
;   * `[]`/`%{}` in the Elixir source are a LIST and a MAP, never a bl vector
;     or a struct. In this file they are written `(list)` and `{}`. A `[]`
;     literal would be a `BeamLisp.Vector` and would change the emitted term.
;
;   * a multi-clause Elixir head with a guard is one `defn` with clause arrows;
;     the guard vocabulary is the BEAM's, so `is_map`/`is_binary` become `map?`
;     / `string?` when a guard can carry them and a body test otherwise.
;
;   * `case` IS NOT A PATTERN MATCH in beam-lisp — it expands to `cond` over
;     `=` and cannot bind. Every destructuring `case` in the Elixir twin is
;     spelled here as a `cond`/`if` over `erlang/is_tuple` + `erlang/element`,
;     with the same clause ORDER, so an unmatched clause still fails the same
;     way (a `FunctionClauseError` where the Elixir clause raised, or the same
;     `argument error`).
;
;   * `raise ArgumentError, msg` is `erlang/error(ArgumentError.exception(msg))`
;     — the same `:error`-class exception struct a caller's `rescue` reads.
;
;   * a sibling defn is only ever called DIRECTLY. Passing one as a VALUE
;     compiles to a var fetch whose value is a capture of the NAMESPACE shim,
;     not of the pinned atom, so the emitted beam would keep leaning on the
;     shim the pinned path exists to avoid. Callbacks wrap the direct call.
;
; The exports are the recalled public surface PLUS the private helpers the
; pinned emitter does not privatize — the same one deliberate divergence
; `priv/host/dev_change.bl`, `priv/host/decimal.bl` and `priv/host/vector.bl`
; carry. The public ABI is exact; the lowercase helpers are extra exports.
;
; Run: bin/bl test test/bl/host_aot_test.bl

(ns host.aot)

; ── reader-form predicates (positional, never struct patterns) ───────────────
;
; A reader form is a tagged tuple: `{:meta, inner, m}`, `{:list, [...]}`,
; `{:symbol, name}`, `{:keyword, name}`, `{:vector, [...]}`. The Elixir twin
; matched those shapes in its clause HEADS; a bl clause head cannot destructure
; a tuple, so each matcher is a positional test on `erlang/element`. Both
; helpers are exported by the pinned emitter, which is harmless — they add to
; the ABI, they never remove from it.

(defn- reg3?
  "Whether `x` is a 3-tuple whose tag (element 1) is `tag`."
  [x tag]
  (and (erlang/is_tuple x) (erlang/== 3 (erlang/tuple_size x)) (erlang/== tag (erlang/element 1 x))))

(defn- reg2?
  "Whether `x` is a 2-tuple whose tag (element 1) is `tag`."
  [x tag]
  (and (erlang/is_tuple x) (erlang/== 2 (erlang/tuple_size x)) (erlang/== tag (erlang/element 1 x))))

(defn- struct?
  "Whether `x` is an Elixir struct: a map carrying `:__struct__`. The Elixir
   twin spelled this `%_{}`; a bl clause head has no such pattern, so the test
   is positional and the tag is read back to rebuild the struct."
  [x]
  (and (erlang/is_map x) (erlang/is_map_key :__struct__ x)))

; ── pinned-host entry: compile_file / compile_source / compile_host_file ────

(defn compile_file
  "Compile a `.bl` file into BEAM modules, one per namespace it defines.
   Returns `[{module, beam_path}]`."
  ([path] (compile_file path (list)))
  ([path opts]
   (boot)
   (BeamLisp.Loader/with_load_path (Path/dirname path)
     (fn []
       (compile_source (BeamLisp.Loader/read_source path)
                       (Keyword/put_new opts :file path))))))

(defn- isolated_definition_collection [action]
  ;; Emission itself links canonical tables. It must not contribute publications
  ;; to an outer unit's collector after load_unit has finished collecting names.
  (let [previous (Process/get :bl_definition_collector)]
    (Process/delete :bl_definition_collector)
    (try (action)
      (finally (if previous (Process/put :bl_definition_collector previous)
                 (Process/delete :bl_definition_collector))))))

(defn compile_source
  "Like `compile_file/2` but for an in-memory source string."
  ([source] (compile_source source (list)))
  ([source opts]
   (isolated_definition_collection (fn [] (compile_source_unit source opts)))))

(defn- compile_source_unit [source opts]
  ;; Even an already initialized namespace cannot evaluate source while an
  ;; enclosing declaration compilation holds the no-initialization restriction.
  (when (and (erlang/== true (Process/get :bl_loader_initialization_blocked))
             (erlang/not (Keyword/get opts :stage-sdk? false)))
    (erlang/error :sdk_declaration_stage_source_evaluation_refused))
  (if (Keyword/get opts :stage-sdk? false)
    (if (constructor_sdk_input? source opts)
      (constructor_compile_sdk_unit! source opts)
      (BeamLisp.Loader/without_initialization
        (fn [] (compile_source_unit_impl source opts))))
    (compile_source_unit_impl source opts)))

(defn- compile_source_unit_impl [source opts]
   (when (and (Keyword/get opts :stage-sdk? false) (Keyword/get opts :mark_loaded? false))
     (erlang/error :sdk_declaration_stage_cannot_mark_ready))
   (let [output_dir (or (Keyword/get opts :output_dir nil) (default_output_dir))
         unit (if (Keyword/get opts :stage-sdk? false)
                (BeamLisp.Loader/with_declaration_snapshot (fn [] (stage-sdk-unit! source opts)))
                (load_unit source opts))
         defined (elem unit 0)
         value_defs (elem unit 1)
         touched (elem unit 2)
         ns_meta (elem unit 3)
         file (elem unit 4)
         declarations (elem unit 5)
         _ (when (constructor_context) (constructor_check_sources!))
         beams
         (Enum/flat_map
           (Enum/sort
             (Enum/filter touched
               (fn [ns]
                 ; Emission belongs to this unit, never an inherited table.
                 ; Declaration-only facades still need their initializer.
                 (or (Map/has_key? ns_meta ns)
                     (Map/has_key? value_defs ns)
                     (Map/has_key? defined ns)))))
           (fn [ns]
             (emit_module ns (Map/get value_defs ns (list)) (Map/get ns_meta ns {})
                          output_dir file (Map/get defined ns nil) (crypto/hash :sha256 source) declarations)))]
     (if (Keyword/get opts :mark_loaded? false)
       (Enum/each
         (Enum/uniq (erlang/++ (Map/keys ns_meta)
                     (erlang/++ (Map/keys defined) (Map/keys value_defs))))
         (fn [ns] (BeamLisp.Env/mark_loaded ns)))
       nil)
     (register_sdk_emission! source file beams)
     beams))

(defn compile_host_file
  "Compile ONE `.bl` file into ONE BEAM module at an EXACT caller-given atom.
   The PINNED-MODULE (host ABI) path. Returns `{module, beam_path}`."
  ([path] (compile_host_file path (list)))
  ([path opts]
   (isolated_definition_collection (fn [] (compile_host_file_unit path opts)))))

(defn- pinned_declaration_walk! [raw root? quoted file]
 ;; Pinned helpers are emitted from the unit's top-level definition inventory.
 ;; A balanced but accidentally nested defn would instead install a namespace
 ;; var when its enclosing function runs, leaving sibling native calls unlinked.
 ;; Reject that host-only shape before source evaluation or any publication.
 (let [node (unmeta raw)]
  (cond
   (reg2? node :list)
    (let [items (elem node 1) head (when (seq items) (unmeta (first items)))
          name (when (reg2? head :symbol) (elem head 1))]
     (cond
      (= "quote" name) nil
      (= "syntax-quote" name)
       (doseq [child (rest items)] (pinned_declaration_walk! child false (inc quoted) file))
      (and (> quoted 0) (contains? #{"unquote" "unquote-splicing"} name))
       (doseq [child (rest items)] (pinned_declaration_walk! child false (dec quoted) file))
      :else
       (do
        (when (and (= 0 quoted) (not root?) (contains? #{"defn" "defn-" "ns"} name))
         (throw (ex-info "Pinned host declarations must be top-level"
                         {:kind :nested-pinned-host-declaration :head name :file file})))
        (doseq [child items] (pinned_declaration_walk! child false quoted file)))))
   (or (reg2? node :vector) (reg2? node :set))
    (doseq [child (elem node 1)] (pinned_declaration_walk! child false quoted file))
   (reg2? node :map)
    (doseq [pair (elem node 1)]
     (pinned_declaration_walk! (elem pair 0) false quoted file)
     (pinned_declaration_walk! (elem pair 1) false quoted file))
   :else nil)))

(defn- validate_pinned_declarations! [source file]
 (doseq [form (BeamLisp.Reader/read_string source file)]
  (pinned_declaration_walk! form true 0 file)))

(defn- compile_host_file_unit [path opts]
   (let [module (Keyword/fetch! opts :module)]
     (validate_host_module! module)
     (let [output_dir (Keyword/fetch! opts :output_dir)
           file (Keyword/get opts :file path)
           load? (Keyword/get opts :load? true)
           struct_fields (validate_struct_fields! (Keyword/get opts :struct_fields nil))]
       (BeamLisp.Loader/with_load_path (Path/dirname path)
         (fn []
           (let [source (BeamLisp.Loader/read_source path)
                 _ (validate_pinned_declarations! source file)
                 unit (load_unit source (Keyword/put opts :file file))
                 defined (elem unit 0)
                 value_defs (elem unit 1)]
             (let [ns (pinned_namespace! defined)
                   shim (BeamLisp.Emit/module_for ns)]
               (if (erlang/not (erlang/== (list) (Map/get value_defs ns (list))))
                 (erlang/error
                   (Elixir.ArgumentError/exception
                     (erlang/iolist_to_binary
                       (list "pinned host module " (Kernel/inspect module)
                             " cannot yet carry value definitions (" ns
                             "); only top-level `defn`s are emitted"))))
                 (let [clauses
                       (Enum/map
                         (Enum/flat_map
                           (BeamLisp.Env/selected_ns_definitions ns
                                     (MapSet/to_list (Map/fetch! defined ns)))
                           (fn [pair] (elem pair 1)))
                         (fn [d] (retarget_host (elem d 3) shim module ns (Map/fetch! defined ns))))]
                   (if (erlang/== (list) clauses)
                     (erlang/error
                       (Elixir.ArgumentError/exception
                         (erlang/iolist_to_binary
                           (list "pinned host module " (Kernel/inspect module)
                                 " would export no functions (" path ")"))))
                     (let [macro_exports
                           (validate_macro_exports! (Keyword/get opts :macro_exports (list)) clauses)
                           collision
                           (if (and (nil? struct_fields) (erlang/== (list) macro_exports))
                             nil
                             (Enum/find clauses
                               (fn [c]
                                 (or (erlang/== :__struct__ (get c :fname))
                                     (erlang/== :__info__ (get c :fname))))))]
                       (if (erlang/not (nil? collision))
                         (erlang/error
                           (Elixir.ArgumentError/exception
                             (erlang/iolist_to_binary
                               (list "pinned host module " (Kernel/inspect module) " defines "
                                     (get collision :fname) " itself; "
                                     ":struct_fields/:macro_exports would duplicate it"))))
                         (let [clauses2 (erlang/++ clauses
                                          (struct_clauses module struct_fields clauses macro_exports))
                               descriptor (BeamLisp.Emit/descriptor_for
                                            module clauses2 (host_attrs opts) {:file file})
                               compiled (BeamLisp.Emit/compile_descriptor descriptor)
                               mod (elem compiled 0)
                               beam (elem compiled 1)]
                           (do
                             (if load?
                               (BeamLisp.Emit/load_binary! compiled (or file "beam_lisp_host"))
                               nil)
                             (write_beam mod beam output_dir)))))))))))))))

; `nil`/`true`/`false` are atoms but not modules, and `module_info` is the
; introspection pair every module already carries.
(defn- validate_host_module!
  "Refuse a module name the pinned emitter cannot honestly honour. There is no
   `String.to_atom` anywhere on this path — the caller supplies an atom — so
   the rejections are about SHAPE and COLLISION, not leakage."
  [module]
  (cond
    (erlang/not (erlang/is_atom module))
      (erlang/error
        (Elixir.ArgumentError/exception
          (erlang/iolist_to_binary
            (list "pinned host module name must be an atom, got: " (Kernel/inspect module)))))

    (lists/member module (list nil true false :undefined :module_info))
      (erlang/error
        (Elixir.ArgumentError/exception
          (erlang/iolist_to_binary
            (list "pinned host module name " (Kernel/inspect module) " is reserved"))))

    (String/starts_with? (Atom/to_string module) "Elixir.BeamLisp.Ns.")
      (erlang/error
        (Elixir.ArgumentError/exception
          (erlang/iolist_to_binary
            (list "pinned host module " (Kernel/inspect module)
                  " collides with the namespace emitter's "
                  "BeamLisp.Ns.* scheme; name it outside that prefix"))))

    :else module))

(defn- pinned_namespace!
  "The single namespace a pinned file's functions belong to, from the defn names
   the UNIT itself spelled. A pinned module IS one module, so a file that
   defines functions in two namespaces has no single honest home: refuse rather
   than merge."
  [defined]
  (let [namespaces (Enum/sort
                     (Enum/map
                       (Enum/filter defined (fn [pair] (erlang/> (MapSet/size (elem pair 1)) 0)))
                       (fn [pair] (elem pair 0))))]
    (cond
      (erlang/== 1 (erlang/length namespaces)) (first namespaces)

      (erlang/== 0 (erlang/length namespaces))
        (erlang/error
          (Elixir.ArgumentError/exception
            "pinned host module source defines no functions in any namespace"))

      :else
        (erlang/error
          (Elixir.ArgumentError/exception
            (erlang/iolist_to_binary
              (list "pinned host module source must define functions in exactly one namespace, got: "
                    (Kernel/inspect namespaces))))))))

(defn- host_attrs
  "The module attributes a pinned descriptor carries: `-behaviour` and, when the
   caller supplies it, the provenance pair `-bl_source_hash` /
   `-bl_compiler_key`."
  [opts]
  (let [behaviour
        (let [b (Keyword/get opts :behaviour nil)]
          (cond
            (nil? b) (list)
            (erlang/is_atom b) (list (list :behaviour b))
            :else
              (erlang/error
                (Elixir.ArgumentError/exception
                  (erlang/iolist_to_binary
                    (list ":behaviour must be a module atom, got: " (Kernel/inspect b)))))))
        provenance
        (let [h (Keyword/get opts :source_hash nil)]
          (cond
            (nil? h) (list)
            (erlang/is_binary h)
              (list (list :bl_source_hash h)
                    (list :bl_compiler_key (BeamLisp.AOTCache/compiler_key)))
            :else
              (erlang/error
                (Elixir.ArgumentError/exception
                  (erlang/iolist_to_binary
                    (list ":source_hash must be a binary digest, got: " (Kernel/inspect h)))))))]
    (erlang/++ behaviour provenance)))

; ── ANF node retargeting for the pinned emitter ─────────────────────────────

(defn- retarget_host
  "Re-point every direct call the compiler linked to the namespace's SHIM
   (`BeamLisp.Ns.<Ns>`) at the PINNED module atom. The walk is over the closed
   bl-ANF vocabulary and NEVER enters a literal (`:lit` / `:plit`): an atom
   literal that happens to equal the shim's name is data, not a call target.
   Structs are rebuilt rather than flattened to plain maps."
  [x from to namespace local-definitions]
  (cond
    (struct? x)
      (Kernel/struct (erlang/map_get :__struct__ x)
        (Map/new (Map/from_struct x)
          (fn [pair] (tuple (elem pair 0) (retarget_host (elem pair 1) from to namespace local-definitions)))))

    (and (erlang/is_map x) (erlang/is_map_key :op x) (erlang/== :lit (get x :op)))
      x

    (and (erlang/is_map x) (erlang/is_map_key :pop x) (erlang/== :plit (get x :pop)))
      x

    (and (erlang/is_map x) (= :global (:op x)) (= namespace (:ns x))
         (MapSet/member? local-definitions (:name x)))
      (throw (ex-info "Pinned host cannot depend on a temporary namespace binding"
                      {:kind :unbound-pinned-host-global :namespace namespace :name (:name x)}))

    (and (erlang/is_map x) (erlang/is_map_key :op x) (erlang/is_map_key :mod x)
         (erlang/== :remote (get x :op)))
      (let [x2 (if (erlang/== from (get x :mod)) (Map/put x :mod to) x)]
        (Map/put x2 :args (Enum/map (get x2 :args) (fn [a] (retarget_host a from to namespace local-definitions)))))

    (erlang/is_map x)
      (Map/new x (fn [pair] (tuple (elem pair 0) (retarget_host (elem pair 1) from to namespace local-definitions))))

    (erlang/is_list x)
      (Enum/map x (fn [a] (retarget_host a from to namespace local-definitions)))

    (erlang/is_tuple x)
      (List/to_tuple (Enum/map (Tuple/to_list x) (fn [a] (retarget_host a from to namespace local-definitions))))

    :else x))

; ── struct surface (`:struct_fields`) and macro surface (`:macro_exports`) ───

(defn- struct_clauses
  "The constructor pair a pinned struct module needs, plus the `__info__/1`
   clause `Inspect.Any` reads. Synthesized as bl-ANF data, never as Elixir
   source."
  [module fields clauses macro_exports]
  (let [constructors
        (if (nil? fields)
          (list)
          (let [default (struct_default_node module fields)]
            (list
              {:op :"defn-clause" :fname :__struct__ :params (list) :guard nil :body default :ann {}}
              {:op :"defn-clause" :fname :__struct__
               :params (list (anf_pvar "kv"))
               :guard nil
               :body {:op :remote :mod :Elixir.Enum :fun :reduce
                      :args (list (anf_var "kv") default (struct_reducer_node)) :ann {}}
               :ann {}})))]
    (erlang/++ (host_info_clauses module fields clauses macro_exports) constructors)))

(defn- host_info_clauses
  "`__info__/1` — the introspection every Elixir module answers and `Inspect.Any`
   reads. Synthesized when the caller asks for the struct surface OR for macros,
   and never for a functions-only module."
  [module fields clauses macro_exports]
  (if (and (nil? fields) (erlang/== (list) macro_exports))
    (list)
    (let [struct (if (nil? fields)
                   nil
                   (Enum/map fields (fn [pair]
                                      {:field (elem pair 0) :default (elem pair 1) :required false})))
          functions (Enum/uniq
                      (erlang/++
                        (Enum/map
                          (Enum/reject clauses (fn [c] (macro_clause? c)))
                          (fn [c] (tuple (get c :fname) (erlang/length (get c :params)))))
                        (if (nil? fields)
                          (list)
                          (list (tuple :__struct__ 0) (tuple :__struct__ 1)))))]
      (list
        (info_clause :module module)
        (info_clause :functions functions)
        (info_clause :macros (Enum/uniq (Enum/sort macro_exports)))
        (info_clause :deprecated (list))
        (info_clause :struct struct)))))

(defn- macro_clause?
  "Whether a clause is a macro's beam artifact (`MACRO-<name>`), which
   `__info__(:functions)` must NOT report."
  [clause]
  (String/starts_with? (Atom/to_string (get clause :fname)) "MACRO-"))

(defn- info_clause
  "A `__info__/1` clause for one literal key."
  [key value]
  {:op :"defn-clause" :fname :__info__
   :params (list {:pop :plit :val key})
   :guard nil
   :body (anf_lit value)
   :ann {}})

(defn- struct_default_node
  "`%{__struct__: module, field: default, …}` as an ANF `:map` whose keys and
   values are literals."
  [module fields]
  (let [pairs (Enum/map
                (cons (tuple :__struct__ module) fields)
                (fn [pair] (list (anf_lit (elem pair 0)) (anf_lit (elem pair 1)))))]
    {:op :map :pairs pairs :ann {}}))

(defn- struct_reducer_node
  "The reducer the generated `%{map | key => val}` compiles to, with the
   reference fun's single-clause refusal spelled out."
  []
  {:op :fn
   :clauses
   (list
     {:pats (list {:pop :ptuple :elems (list (anf_pvar "key") (anf_pvar "val"))}
                  (anf_pvar "map"))
      :guard nil
      :body {:op :remote :mod :maps :fun :update
             :args (list (anf_var "key") (anf_var "val") (anf_var "map")) :ann {}}}
     {:pats (list (anf_pvar "_") (anf_pvar "_"))
      :guard nil
      :body {:op :remote :mod :erlang :fun :error
             :args (list (anf_lit :function_clause)) :ann {}}})
   :ann {}})

(defn- anf_lit [value] {:op :lit :val value :ann {}})

(defn- anf_var [name] {:op :var :name name :ann {}})

(defn- anf_pvar [name] {:pop :pvar :name name})

(defn- validate_struct_fields!
  "The struct surface is METADATA from the caller: a field is an atom the caller
   already holds, its default must be literal data, and the two shapes Elixir
   refuses are refused here."
  [fields]
  (cond
    (nil? fields) nil

    (erlang/is_list fields)
      (Enum/reduce fields (list)
        (fn [entry acc]
          (if (and (erlang/is_tuple entry) (erlang/== 2 (erlang/tuple_size entry)))
            (let [key (elem entry 0)
                  default (elem entry 1)]
              (cond
                (erlang/== :__struct__ key)
                  (erlang/error (Elixir.ArgumentError/exception "cannot set :__struct__ in struct definition"))

                (erlang/is_atom key)
                  (cond
                    (lists/keymember key 1 acc)
                      (erlang/error (Elixir.ArgumentError/exception (erlang/iolist_to_binary (list "duplicate struct field " (Kernel/inspect key)))))
                    (literal_data? default)
                      (erlang/++ acc (list (tuple key default)))
                    :else
                      (erlang/error (Elixir.ArgumentError/exception (erlang/iolist_to_binary (list "struct field " (Kernel/inspect key) " default must be literal data, got: " (Kernel/inspect default (list (tuple :limit 5))))))))

                :else
                  (erlang/error (Elixir.ArgumentError/exception (erlang/iolist_to_binary (list "struct field names must be atoms, got: " (Kernel/inspect key)))))))

            (erlang/error (Elixir.ArgumentError/exception (erlang/iolist_to_binary (list ":struct_fields entries must be {name, default} pairs, got: " (Kernel/inspect entry))))))))

    :else
      (erlang/error (Elixir.ArgumentError/exception (erlang/iolist_to_binary (list ":struct_fields must be a list of {name, default} pairs, got: " (Kernel/inspect fields)))))))

(defn- validate_macro_exports!
  "`:macro_exports` is METADATA from the caller, exactly like `:struct_fields`:
   `{name, arity}` pairs naming the macros this module OFFERS. The implementer
   must already be a top-level `MACRO-<name>` clause of arity `arity + 1`."
  [specs clauses]
  (cond
    (erlang/== (list) specs) (list)

    (erlang/is_list specs)
      (Enum/map specs
        (fn [spec]
          (if (and (erlang/is_tuple spec)
                   (erlang/== 2 (erlang/tuple_size spec))
                   (erlang/is_atom (elem spec 0))
                   (erlang/is_integer (elem spec 1))
                   (erlang/>= (elem spec 1) 0))
            (let [name (elem spec 0)
                  arity (elem spec 1)
                  impl (erlang/binary_to_atom
                         (erlang/iolist_to_binary (list "MACRO-" (Atom/to_string name)))
                         :utf8)]
              (if (Enum/any? clauses
                    (fn [c]
                      (and (erlang/== impl (get c :fname))
                           (erlang/== (erlang/+ arity 1) (erlang/length (get c :params))))))
                (tuple name arity)
                (erlang/error
                  (Elixir.ArgumentError/exception
                    (erlang/iolist_to_binary
                      (list ":macro_exports names " (Atom/to_string name) "/"
                            (Integer/to_string arity) ", but no "
                            (Kernel/inspect impl) "/" (Integer/to_string (erlang/+ arity 1))
                            " clause is defined; a macro's artifact is its implementer with one extra "
                            "(caller) argument"))))))
            (erlang/error
              (Elixir.ArgumentError/exception
                (erlang/iolist_to_binary
                  (list ":macro_exports entries must be {name, arity} pairs, got: "
                        (Kernel/inspect spec))))))))

    :else
      (erlang/error
        (Elixir.ArgumentError/exception
          (erlang/iolist_to_binary
            (list ":macro_exports must be a list of {name, arity} pairs, got: "
                  (Kernel/inspect specs)))))))

(defn- literal_data?
  "What `BeamLisp.Ns.Anf`'s `literal-data?` accepts, minus anything with a
   runtime identity."
  [value]
  (cond
    (erlang/is_function value) false
    (erlang/is_tuple value) (Enum/all? (Tuple/to_list value) (fn [v] (literal_data? v)))
    (erlang/is_list value) (Enum/all? value (fn [v] (literal_data? v)))
    (erlang/is_map value) (Enum/all? value (fn [pair]
                                              (and (literal_data? (elem pair 0))
                                                   (literal_data? (elem pair 1)))))
    :else (or (erlang/is_atom value) (erlang/is_number value) (erlang/is_bitstring value))))

; ── the compilation unit: read, prelink, evaluate ───────────────────────────

(defn- load_unit [source opts]
  (when (erlang/== true (Process/get :bl_loader_initialization_blocked))
    (erlang/error :sdk_declaration_stage_source_evaluation_refused))
  (BeamLisp.Loader/with_declaration_snapshot (fn [] (load_unit_in_snapshot source opts))))

(defn- load_unit_in_snapshot
  "Run one compilation unit through the ordinary reader/compiler pipeline and
   return everything the emitters need: `{defined, value_defs, touched, ns_meta,
   file}`."
  [source opts]
  (when (erlang/== true (Process/get :bl_loader_initialization_blocked))
    (erlang/error :sdk_declaration_stage_source_evaluation_refused))
  (boot)
  (BeamLisp.Env/in_ns "user")
  (BeamLisp.Compiler/reset_fresh!)
  (let [file (Keyword/get opts :file nil)
        forms (BeamLisp.Reader/read_string source file)
        defined (unit_defns forms)]
    (Enum/reduce forms "user"
      (fn [form ns]
        (let [declared (ns_decl form)]
          (if (nil? declared)
            (do (BeamLisp.Compiler/prelink_defn form ns) ns)
            declared))))
    (let [previous (Process/get :bl_definition_collector)
          ;; A coherent older recovery Compiler may still be installed while
          ;; current hosts are rebuilt. It emits ordinary compatible units,
          ;; never an apparently collected declaration descriptor.
          declaration-token (when (erlang/function_exported :Elixir.BeamLisp.Ns.Compiler :normal-declaration-node 4)
                              (System/unique_integer (list :positive)))]
      (Process/put :bl_definition_collector
        {:env (BeamLisp.Env/env_id) :names {} :declarations (when declaration-token {})
         :declaration-token declaration-token
         :declaration-namespaces (MapSet/new (cons "user" (Enum/filter (Enum/map forms (fn [form] (ns_decl form)))
                                                   (fn [ns] (erlang/is_binary ns)))))})
      (try
       (let [acc (Enum/reduce forms (tuple {} (MapSet/new) {})
                (fn [form a]
                  (let [vdefs (elem a 0)
                        nss (elem a 1)
                        nsmeta (elem a 2)
                        ns (BeamLisp.Env/current_ns)
                        vdefs2 (capture_value_def vdefs form ns)
                        nsmeta2 (capture_ns_decl nsmeta form)
                        env (Map/put (BeamLisp.Compiler/new_env) :ns (BeamLisp.Env/current_ns))]
                    ;; The private compile token enters only this actual
                    ;; normal producer form, never ordinary Source graph plans.
                    (BeamLisp.Compiler/eval_form form
                      (Map/put (Map/put env :file file) :aot-normal-declaration-token
                        (Map/get (Process/get :bl_definition_collector) :declaration-token)))
                    (tuple vdefs2 (MapSet/put nss (or (ns_decl form) ns)) nsmeta2))))]
      ; export every def the unit left behind its shim's forwarding handler
      ; (BUG-112): one shim rebuild per namespace for the whole unit
      (when (erlang/function_exported :Elixir.BeamLisp.Link :settle 0)
        (BeamLisp.Link/settle))
      (let [executed (Map/get (Process/get :bl_definition_collector) :names {})
            owned (MapSet/union (elem acc 1) (MapSet/new (Map/keys (elem acc 2))))
            names (Map/merge defined (Map/take executed (MapSet/to_list owned))
                    (fn [_ lexical observed] (MapSet/union lexical observed)))]
        (tuple names (elem acc 0) (elem acc 1) (elem acc 2) file
          (Map/get (Process/get :bl_definition_collector) :declarations))))
       (finally
        (if previous (Process/put :bl_definition_collector previous)
          (Process/delete :bl_definition_collector)))))))

(defn- unit_defns
  "The fn definitions THIS UNIT made, per namespace: the names a top-level
   `defn`/`defn-` form in the source binds."
  [forms]
  (elem
    (Enum/reduce forms (tuple "user" {})
      (fn [form acc]
        (let [ns (elem acc 0)
              m (elem acc 1)
              declared (ns_decl form)]
          (if (nil? declared)
            (let [name (defn_name form)]
              (if (nil? name)
                (tuple ns m)
                (tuple ns (Map/update m ns (MapSet/new (list name))
                                      (fn [s] (MapSet/put s name))))))
            (tuple declared m)))))
    1))

(defn- defn_name
  "The name a `defn`/`defn-` form binds, else nil. The Elixir twin had four
   clauses; the meta-peel of the HEAD is clause 2 and comes before the symbol
   match, so the order is preserved."
  [form]
  (cond
    (reg3? form :meta)
      (defn_name (elem form 1))

    (reg2? form :list)
      (let [items (elem form 1)]
        (if (erlang/== 0 (erlang/length items))
          nil
          (let [h (first items)]
            (if (reg3? h :meta)
              (defn_name (tuple :list (cons (elem h 1) (rest items))))
              (if (and (reg2? h :symbol) (erlang/>= (erlang/length items) 2))
                (let [head (elem h 1)
                      name_form (second items)]
                  (if (or (erlang/== "defn" head) (erlang/== "defn-" head))
                    (let [u (unmeta name_form)]
                      (if (reg2? u :symbol) (elem u 1) nil))
                    nil))
                nil)))))

    :else nil))

(defn- ns_decl
  "The namespace a top-level `(ns NAME …)` form declares, else nil."
  [form]
  (cond
    (reg3? form :meta) (ns_decl (elem form 1))

    (and (reg2? form :list)
         (erlang/>= (erlang/length (elem form 1)) 2)
         (reg2? (first (elem form 1)) :symbol)
         (erlang/== "ns" (elem (first (elem form 1)) 1)))
      (let [name_form (second (elem form 1))]
        (cond
          (reg3? name_form :meta)
            (let [inner (elem name_form 1)]
              (if (reg2? inner :symbol) (elem inner 1) nil))
          (reg2? name_form :symbol) (elem name_form 1)
          :else nil))

    :else nil))

(defn- unmeta
  "Strip one layer of reader position metadata."
  [form]
  (if (reg3? form :meta) (elem form 1) form))

(defn- bare_name
  "A definition's name, with or without metadata on it."
  [form]
  (cond
    (reg3? form :meta) (bare_name (elem form 1))
    (reg2? form :symbol) (elem form 1)
    :else (Kernel/inspect form)))

(defn- key_suffix
  "`\" name\"` for each name form — a composite key's ordered,
   space-separated tail."
  [forms]
  (Enum/map forms (fn [f] (erlang/iolist_to_binary (list " " (bare_name f))))))

(defn- definition_name
  "The key a replayed form is stored under.

   AN EXTENSION KEY NAMES BOTH SIDES. One type extended with two different
   protocols is two top-level forms — `veritas`'s `Gen` rungs and the
   `GenShrink` rungs added beside them — and a key carrying only the TYPE keeps
   the LAST and silently drops the earlier extension from `__bl_init__/0`. The
   first VM compiled and EVALUATED the source, so it installed both; a cache-hit
   VM only replays the artifact, so with a type-only key it installs one and
   dispatch then fails with \"No implementation of method … for type …\".
   Protocol and type both belong in the key: `extend-type` names the type second
   and the protocol third, `extend-protocol` names the protocol second and each
   type after it."
  [head items]
  (cond
    (erlang/== "extend-type" head)
      (erlang/iolist_to_binary
        (erlang/++ (list head " " (bare_name (second items)))
                   (key_suffix (Enum/take (Enum/drop items 2) 1))))

    (erlang/== "extend-protocol" head)
      (erlang/iolist_to_binary
        (erlang/++ (list head " " (bare_name (second items)))
                   (key_suffix
                     (Enum/reject (Enum/drop items 2)
                       (fn [x] (reg2? (unmeta x) :list))))))

    :else (bare_name (second items))))

(defn- require_target
  "The namespace a require spec names, in either accepted shape."
  [spec]
  (let [u (unmeta spec)]
    (cond
      (reg2? u :symbol) (elem u 1)

      (reg2? u :vector)
        (if (erlang/== 0 (erlang/length (elem u 1)))
          nil
          (let [head (unmeta (first (elem u 1)))]
            (if (reg2? head :symbol) (elem head 1) nil)))

      :else nil)))

(defn- capture_require_spec
  "Like `Compiler.parse_require_spec/1`: `[target :as a :refer [x y]]` or a bare
   `target`. Answers the running `{aliases, refers, refer_alls}` accumulator."
  [spec acc]
  (cond
    (reg3? spec :meta)
      (capture_require_spec (elem spec 1) acc)

    (reg2? spec :symbol)
      acc

    (and (reg2? spec :vector)
         (erlang/> (erlang/length (elem spec 1)) 0)
         (reg3? (first (elem spec 1)) :meta))
      (capture_require_spec
        (tuple :vector (cons (elem (first (elem spec 1)) 1) (rest (elem spec 1))))
        acc)

    (and (reg2? spec :vector)
         (erlang/> (erlang/length (elem spec 1)) 0)
         (reg2? (first (elem spec 1)) :symbol))
      (let [items (elem spec 1)
            target (elem (first items) 1)
            flags (rest items)
            parsed
            (Enum/reduce (Enum/map flags (fn [f] (unmeta f)))
              (tuple nil (list) false)
              (fn [flag a]
                (let [al (elem a 0)
                      rf (elem a 1)
                      ra (elem a 2)]
                  (cond
                    (and (reg2? flag :keyword) (erlang/== "as" (elem flag 1)))
                      (tuple (tuple :expecting "as") rf ra)

                    (and (reg2? flag :keyword) (erlang/== "refer" (elem flag 1)))
                      (tuple al (tuple :expecting "refer") ra)

                    (and (reg2? flag :symbol) (erlang/== (tuple :expecting "as") al))
                      (tuple (elem flag 1) rf ra)

                    (and (reg2? flag :keyword) (erlang/== "all" (elem flag 1))
                         (erlang/== (tuple :expecting "refer") rf))
                      (tuple al (list) true)

                    (and (reg2? flag :vector) (erlang/== (tuple :expecting "refer") rf))
                      (tuple al (Enum/map (elem flag 1) (fn [s] (bare_name s))) ra)

                    :else a))))
            as_alias (let [a0 (elem parsed 0)] (if (erlang/is_binary a0) a0 nil))
            refer_syms (let [r1 (elem parsed 1)] (if (erlang/is_list r1) r1 (list)))
            refer_all? (elem parsed 2)
            aliases (elem acc 0)
            refers (elem acc 1)
            refer_alls (elem acc 2)
            aliases2 (if as_alias (erlang/++ aliases (list (tuple as_alias target))) aliases)
            refers2 (erlang/++ refers (Enum/map refer_syms (fn [s] (tuple s target))))
            refer_alls2 (if refer_all? (erlang/++ refer_alls (list target)) refer_alls)]
        (tuple aliases2 refers2 refer_alls2))

    :else acc))

(defn- require_declaration
  "The original require spec as {target, alias, refers}, preserving bare and
   refer-all intent independently of another spec naming the same target."
  [spec]
  (let [target (require_target spec)
        parts (capture_require_spec spec (tuple (list) (list) (list)))
        aliases (elem parts 0)
        refers (elem parts 1)
        alls (elem parts 2)]
    (if (nil? target)
      nil
      (tuple target
             (if (erlang/== aliases (list)) nil (elem (first aliases) 0))
             (if (erlang/== alls (list))
               (Enum/map refers (fn [p] (elem p 0)))
               :all)))))

(defn- capture_ns_decl
  "Capture the alias/refer side effects of an `(ns name (:require ...))`
   declaration so `__bl_init__/0` can re-run them in a fresh VM."
  [ns_meta form]
  (cond
    (reg3? form :meta)
      (capture_ns_decl ns_meta (elem form 1))

    (and (reg2? form :list)
         (erlang/>= (erlang/length (elem form 1)) 2)
         (reg2? (first (elem form 1)) :symbol)
         (erlang/== "ns" (elem (first (elem form 1)) 1))
         (reg2? (second (elem form 1)) :symbol))
      (let [ns (elem (second (elem form 1)) 1)
            clauses (Enum/map (rest (rest (elem form 1))) (fn [c] (unmeta c)))
            is-require? (fn [c] (and (reg2? c :list)
                                     (erlang/> (erlang/length (elem c 1)) 0)
                                     (reg2? (first (elem c 1)) :keyword)
                                     (erlang/== "require" (elem (first (elem c 1)) 1))))
            acc (Enum/reduce clauses (tuple (list) (list) (list))
                  (fn [c a]
                    (if (is-require? c)
                      (Enum/reduce (rest (elem c 1)) a
                        (fn [s aa] (capture_require_spec s aa)))
                      a)))
            requires (Enum/uniq
                       (Enum/reject
                         (Enum/flat_map clauses
                           (fn [c]
                             (if (is-require? c)
                               (Enum/map (rest (elem c 1)) (fn [s] (require_target s)))
                               (list))))
                         (fn [t] (nil? t))))
            require_specs
            (Enum/reject
              (Enum/flat_map clauses
                (fn [c]
                  (if (is-require? c)
                    (Enum/map (rest (elem c 1)) (fn [s] (require_declaration s)))
                    (list))))
              (fn [s] (nil? s)))
            meta {:aliases (elem acc 0) :refers (elem acc 1)
                  :refer_alls (elem acc 2) :requires requires
                  :require_specs require_specs}]
        (Map/update ns_meta ns meta (fn [_prev] meta)))

    :else ns_meta))

(defn- put_value_def
  "Capture a value `def`'s initializer (and optional docstring) so the namespace
   module can re-run it in `__bl_init__/0`. Latest def wins, first-definition
   order preserved."
  ([vdefs ns name doc init]
   (put_value_def vdefs ns name doc init (list)))
  ([vdefs ns name doc init opts]
   (let [per_env? (erlang/== true (Keyword/get opts :per_env false))
         entries (Enum/reject (Map/get vdefs ns (list))
                   (fn [e] (erlang/== name (elem e 0))))]
     (Map/put vdefs ns (erlang/++ entries (list (tuple name doc init per_env?)))))))

; The define-by-interning forms, replayed whole by `__bl_init__/0`.
(defn- replayed_form?
  [head]
  (lists/member head
    (list "defmacro" "defserver" "defrecord" "deftype" "defprotocol"
          "defmulti" "extend-type" "extend-protocol")))

(defn- capture_value_def
  "Capture a value `def`'s initializer. The Elixir twin had six clauses; each is
   preserved in order, positionally matched."
  [vdefs form ns]
  (cond
    (reg3? form :meta)
      (capture_value_def vdefs (elem form 1) ns)

    ; `(def ^:private …)` / `(def ^:per-env …)`: the NAME carries metadata.
    (and (reg2? form :list)
         (erlang/>= (erlang/length (elem form 1)) 2)
         (reg2? (first (elem form 1)) :symbol)
         (erlang/== "def" (elem (first (elem form 1)) 1))
         (reg3? (second (elem form 1)) :meta))
      (let [name_meta (second (elem form 1))
            inner (elem name_meta 1)
            m (elem name_meta 2)
            remaining (rest (rest (elem form 1)))]
        (if (and (erlang/is_map m) (erlang/== true (get m :"per-env")))
          (cond
            (erlang/== 1 (erlang/length remaining))
              (put_value_def vdefs ns (bare_name inner) nil (first remaining)
                             (list (tuple :per_env true)))
            (and (erlang/== 2 (erlang/length remaining))
                 (erlang/is_binary (first remaining)))
              (put_value_def vdefs ns (bare_name inner) (first remaining) (second remaining)
                             (list (tuple :per_env true)))
            :else vdefs)
          (capture_value_def vdefs
            (tuple :list (cons (tuple :symbol "def") (cons inner remaining))) ns)))

    ; the define-by-interning forms, matched on the head symbol
    (and (reg2? form :list)
         (erlang/>= (erlang/length (elem form 1)) 2)
         (reg2? (first (elem form 1)) :symbol)
         (replayed_form? (elem (first (elem form 1)) 1)))
      (put_value_def vdefs ns
        (definition_name (elem (first (elem form 1)) 1) (elem form 1))
        nil form)

    ; `(def name init)` / `(def name doc init)`
    (and (reg2? form :list)
         (erlang/>= (erlang/length (elem form 1)) 2)
         (reg2? (first (elem form 1)) :symbol)
         (erlang/== "def" (elem (first (elem form 1)) 1))
         (reg2? (second (elem form 1)) :symbol))
      (let [name (elem (second (elem form 1)) 1)
            remaining (rest (rest (elem form 1)))]
        (cond
          (erlang/== 1 (erlang/length remaining))
            (put_value_def vdefs ns name nil (first remaining))
          (and (erlang/== 2 (erlang/length remaining))
               (erlang/is_binary (first remaining)))
            (put_value_def vdefs ns name (first remaining) (second remaining))
          :else vdefs))

    ; see through defining macros: capture the EXPANSION
    (and (reg2? form :list)
         (erlang/> (erlang/length (elem form 1)) 0)
         (reg2? (first (elem form 1)) :symbol)
         (erlang/is_binary (elem (first (elem form 1)) 1)))
      (let [expanded (BeamLisp.Compiler/macroexpand_1 form ns)]
        (if (erlang/== expanded form) vdefs (capture_value_def vdefs expanded ns)))

    :else vdefs))

; ── emission ────────────────────────────────────────────────────────────────

(defn- sdk_callable_arm [definition local?]
 (let [function (elem definition 2) provider (elem definition 4)
       arity (erlang/length (Map/get (elem definition 3) :params))]
  (if-not local?
   (BeamLisp.Emit/remote :erlang :make_fun
    (Enum/map (list provider function arity) (fn [value] (BeamLisp.Emit/lit value))))
   (let [names (if (= 0 arity) (list)
                 (Enum/map (Enum/to_list (Range/new 0 (dec arity)))
                  (fn [index] (erlang/iolist_to_binary (list "$sdk_arg" (Integer/to_string index))))))]
    {:op :fn :clauses (list {:pats (Enum/map names (fn [name] {:pop :pvar :name name}))
                            :guard nil :body (BeamLisp.Emit/remote provider function
                                              (Enum/map names (fn [name] {:op :var :name name :ann {}})))}) :ann {}}))))
(defn- sdk_callable_value [definitions local?]
 (let [fixed (Enum/filter definitions (fn [definition] (= :fixed (elem definition 0))))
       variadic (Enum/find definitions (fn [definition] (= :variadic (elem definition 0))))]
  (if (and (= 1 (erlang/length fixed)) (nil? variadic)) (sdk_callable_arm (first fixed) local?)
   {:op :tuple :elems (list (BeamLisp.Emit/lit :$blfn)
      {:op :map :pairs (Enum/map fixed
        (fn [definition] (list (BeamLisp.Emit/lit (elem definition 1)) (sdk_callable_arm definition local?)))) :ann {}}
      (if variadic {:op :tuple :elems (list (BeamLisp.Emit/lit (elem variadic 1)) (sdk_callable_arm variadic local?)) :ann {}}
        (BeamLisp.Emit/lit nil))) :ann {}})))
(defn- sdk_callable_factory [ns ns_defs declarations]
 ;; Compiler-emitted, zero-effect callable construction. Its exported factory
 ;; is intentionally NOT a public declaration route. Checked private values
 ;; use genuine local bridges. Public and recovery/unknown representations keep
 ;; external issuer ABI; an unknown descriptor NEVER grants public target access.
 (BeamLisp.Emit/function_clause :__bl_callable_values__
  {:op :map :pairs (Enum/map ns_defs
    (fn [binding]
     (let [name (elem binding 0) kind (Map/get (if (erlang/is_map declarations) (Map/get declarations ns {}) {}) name)]
      (list (BeamLisp.Emit/lit name) (sdk_callable_value (elem binding 1) (and kind (not= :public kind))))))) :ann {}}))
(defn- sdk_callable_arm_matches? [value definition shim]
 ;; Match the actual previous checked link, never just a function/name prefix.
 (and (erlang/is_function value)
      (= :external (elem (erlang/fun_info value :type) 1))
      (= (elem definition 2) (elem (erlang/fun_info value :name) 1))
      (= (erlang/length (Map/get (elem definition 3) :params))
         (elem (erlang/fun_info value :arity) 1))
      (or (= shim (elem (erlang/fun_info value :module) 1))
          (= (elem definition 4) (elem (erlang/fun_info value :module) 1)))))

(defn- sdk_callable_matches? [value definitions shim]
 (let [fixed (Enum/filter definitions (fn [definition] (= :fixed (elem definition 0))))
       variadic (Enum/find definitions (fn [definition] (= :variadic (elem definition 0))))]
  (if (and (= 1 (erlang/length fixed)) (nil? variadic))
   (sdk_callable_arm_matches? value (first fixed) shim)
   (and (erlang/is_tuple value) (= 3 (erlang/tuple_size value)) (= :$blfn (elem value 0))
        (erlang/is_map (elem value 1))
        (= (erlang/map_size (elem value 1)) (erlang/map_size (Map/new (Enum/map fixed (fn [d] (tuple (elem d 1) true))))))
        (Enum/all? fixed (fn [d] (sdk_callable_arm_matches? (Map/get (elem value 1) (elem d 1)) d shim)))
        (if variadic
         (let [rest (elem value 2)]
          (and (erlang/is_tuple rest) (= 2 (erlang/tuple_size rest)) (= (elem variadic 1) (elem rest 0))
               (sdk_callable_arm_matches? (elem rest 1) variadic shim)))
         (nil? (elem value 2)))))))

(defn- sdk_final_function? [declarations ns name]
 ;; Privacy alone is insufficient: a private/per-env def can store EXACTLY
 ;; the old linked function. Only the final expanded declaration kind permits
 ;; normalization. Recovery nil/old descriptors never authorize rebinding.
 (and (erlang/is_map declarations)
      (= :function (Map/get (Map/get (Map/get declarations :callable-kinds {}) ns {}) name))))
(defn- sdk_callable_rebindings [ns definitions declarations]
 ;; Final non-callable/value/macro overwrites and arbitrary callable def state
 ;; survive. Only actual prior linked function values are normalized. Missing
 ;; recovery descriptors affect representation only, never target authority.
 (let [shim (BeamLisp.Emit/module_for ns) kinds (if (erlang/is_map declarations) (Map/get declarations ns {}) {})]
  (Enum/reduce definitions {}
   (fn [binding output]
    (let [name (elem binding 0) kind (Map/get kinds name)
          current (BeamLisp.Env/lookup (tuple ns name))]
     (if (and (and (contains? #{:public :private} kind) (sdk_final_function? declarations ns name))
              (erlang/is_tuple current) (= :ok (elem current 0))
              (sdk_callable_matches? (elem current 1) (elem binding 1) shim))
      (Map/put output name current) output))))))

(defn assert_bootstrap_callable_materialization!
  "Read-only compatibility check before costly bootstrap-unit compilation.
   Construct checked callable IR; never execute a generated factory/initializer
   or publish SDK evidence. Absent declaration metadata grants no authority."
  []
  (let [definitions (BeamLisp.Env/ns_defs "core")]
    (when-not (and (erlang/is_map definitions)
                   (erlang/> (erlang/map_size definitions) 0)
                   (erlang/=< (erlang/map_size definitions) 8192))
      (erlang/error :bootstrap_callable_definitions_missing))
    (let [bindings-before (Map/new definitions
                           (fn [entry] (tuple (elem entry 0)
                             (BeamLisp.Env/lookup (tuple "core" (elem entry 0))))))
          lease-before (ets/lookup :beam_lisp_vars :bl_sdk_runtime_lease)
          factory-nil (sdk_callable_factory "core" definitions nil)
          factory-empty (sdk_callable_factory "core" definitions {})
          rebindings-nil (sdk_callable_rebindings "core" definitions nil)
          rebindings-empty (sdk_callable_rebindings "core" definitions {})
          bindings-after (Map/new definitions
                          (fn [entry] (tuple (elem entry 0)
                            (BeamLisp.Env/lookup (tuple "core" (elem entry 0))))))
          checks (list
                   (and (erlang/== :defn-clause (Map/get factory-nil :op))
                        (erlang/== :__bl_callable_values__ (Map/get factory-nil :fname))
                        (erlang/== (list) (Map/get factory-nil :params))
                        (erlang/== :map (Map/get (Map/get factory-nil :body) :op))
                        (erlang/== (erlang/map_size definitions)
                          (erlang/length (Map/get (Map/get factory-nil :body) :pairs))))
                   (erlang/== factory-nil factory-empty)
                   (erlang/== rebindings-nil rebindings-empty)
                   (erlang/== bindings-before bindings-after)
                   (erlang/== lease-before (ets/lookup :beam_lisp_vars :bl_sdk_runtime_lease))
                   (erlang/== false (sdk_declaration_descriptor? nil "core")))]
      (when-not (Enum/all? checks (fn [value] (erlang/== true value)))
        (erlang/error (tuple :bootstrap_callable_materialization_failed checks)))
      {:kind :bootstrap-callable-materialization :passed 6 :failed 0
       :core-definitions (erlang/map_size definitions) :factory-executions 0})))

(defn- materialize_unit_callables! [ns shim previous]
 ;; Native compiler/install path only. Do not replay initializers, change
 ;; readiness, adopt stale references, or overwrite an unrelated current value.
 (when (> (erlang/map_size previous) 0)
  (let [definitions (erlang/apply shim :__bl_ns_defs__ (list))
        values (erlang/apply (ns_body_module ns) :__bl_callable_values__ (list))]
   (when-not (and (erlang/is_map values) (= (erlang/map_size definitions) (erlang/map_size values))
                  (<= (erlang/map_size values) 8192))
    (erlang/error :invalid_emitted_callable_values))
   (Enum/each previous
    (fn [binding]
     (let [name (elem binding 0) expected (elem binding 1)]
      (when (= expected (BeamLisp.Env/lookup (tuple ns name)))
       (BeamLisp.Env/intern ns name (Map/fetch! values name)))))))) :ok)

(defn- emit_module
  "Emit a namespace as the SAME shim/body split the runtime uses, so an
   AOT-loaded namespace is byte-for-byte the source-loaded one. Returns every
   emitted `{mod, path}`."
  [ns value_defs ns_meta output_dir file unit_names input_digest declarations]
  (BeamLisp.Env/with_namespace_lock ns
    (fn [] (BeamLisp.Env/with_publication ns
      (fn [] (emit_module_unfenced ns value_defs ns_meta output_dir file unit_names input_digest declarations))))))

(defn- emit_module_unfenced
  [ns value_defs ns_meta output_dir file unit_names input_digest declarations]
  (let [mod (BeamLisp.Emit/module_for ns)
        filename (or file (erlang/iolist_to_binary (list "beam_lisp_aot/" ns ".bl")))
        raw_defs (unit_defs ns unit_names)
        previous (sdk_callable_rebindings ns raw_defs declarations)
        ns_defs (stabilise_body_modules ns raw_defs)
        source_hash (if file (ns_closure_hash ns file) nil)
        stamp_key (BeamLisp.AOTCache/key_for_ns ns)
        unit_attrs (list (tuple :bl_source_hash source_hash) (tuple :bl_compiler_key stamp_key)
                         (tuple :bl_unit_source_digest input_digest)
                         (tuple :bl_aot_artifact_version 1)
                         (tuple :bl_unit_namespace ns))
        init_pair (build_init_ast ns mod ns_defs value_defs ns_meta unit_attrs declarations)
        init_clause (elem init_pair 0)
        companion_descriptor (elem init_pair 1)
        provenance_clause (BeamLisp.Emit/function_clause :__bl_provenance__
                            {:op :tuple :elems (list (BeamLisp.Emit/lit source_hash)
                                                     (BeamLisp.Emit/lit stamp_key)) :ann {}})
        namespace_clauses
        (Enum/map
          (erlang/++ (BeamLisp.Emit/shim_clauses ns ns_defs)
                     ; `__bl_ns_defs__/0` IS the namespace's def table: a literal the VM
                     ; shares, which `Env/ns_defs` reads instead of an ETS copy.
                     (list provenance_clause
                           (BeamLisp.Emit/function_clause :__bl_ns_defs__ (BeamLisp.Emit/lit ns_defs))
                           init_clause))
          (fn [clause]
            (let [ann (Map/merge {:file filename :line 1}
                                 (Map/get (get clause :body) :ann {}))]
              (Map/put clause :body (Map/put (get clause :body) :ann ann)))))
        namespace_descriptor
        (BeamLisp.Emit/descriptor_for mod namespace_clauses
          (list (tuple :bl_source_hash source_hash) (tuple :bl_compiler_key stamp_key)
                ;; A previous pinned emitter can stamp new live source keys.
                ;; Verify the actual replay format independently of that key.
                (tuple :bl_aot_replay_version 1)
                (tuple :bl_unit_source_digest input_digest)
                (tuple :bl_aot_artifact_version 1)
                (tuple :bl_aot_artifact_role :mutable-forwarder)
                (tuple :bl_unit_namespace ns)
                (tuple :bl_aot_forwarder_namespace ns)
                (tuple :bl_sdk_declarations (when declarations (tuple 1 ns (Map/get declarations ns {}))))
                (tuple :bl_sdk_callable_kinds
                  (when (and (erlang/is_map declarations) (Map/has_key? declarations :callable-kinds))
                    (tuple 1 ns (Map/get (Map/get declarations :callable-kinds) ns {}))))
                (tuple :bl_aot_unit_members
                  (tuple :members (Enum/uniq (erlang/++
                    (Enum/map (elem init_pair 2) (fn [beam] (elem beam 0)))
                    (erlang/++ (Enum/map (Map/to_list (BeamLisp.Emit/body_modules ns_defs)) (fn [entry] (elem entry 0)))
                      (List/wrap (when companion_descriptor (Map/get companion_descriptor :name))))))))
                (tuple :bl_aot_forwarder_routes
                  (Map/new (Enum/flat_map ns_defs
                    (fn [entry] (Enum/map (elem entry 1)
                      (fn [d] (tuple (tuple (elem d 2) (erlang/length (Map/get (elem d 3) :params)))
                                     (elem d 4)))))))))
          {:file filename})
        body_descriptors
        (Enum/map (BeamLisp.Emit/body_modules ns_defs)
          (fn [pair] (BeamLisp.Emit/descriptor_for (elem pair 0)
                       (if (= (elem pair 0) (ns_body_module ns))
                        (erlang/++ (elem pair 1) (list (sdk_callable_factory ns ns_defs declarations)))
                        (elem pair 1))
                       (erlang/++ unit_attrs (list (tuple :bl_aot_artifact_role :stable-body)))
                       {:file filename})))
        companion_descriptor
        (if companion_descriptor
          (Map/put companion_descriptor :ann {:file filename})
          nil)
        generated_beams (elem init_pair 2)
        beams (erlang/++ generated_beams
                (Enum/map
                  (erlang/++ (erlang/++ body_descriptors (List/wrap companion_descriptor))
                             (list namespace_descriptor))
                  (fn [d] (BeamLisp.Emit/compile_descriptor d))))
        body_mods (MapSet/new body_descriptors (fn [d] (get d :name)))
        split (Enum/split_with beams (fn [b] (MapSet/member? body_mods (elem b 0))))
        body_beams (elem split 0)
        public_beams (elem split 1)]
    (try
      (BeamLisp.Env/publish_binaries! (erlang/++ body_beams public_beams) filename)
      (catch e
        (erlang/error
          (Elixir.RuntimeError/exception
            (erlang/iolist_to_binary
              (list "AOT publication failed for "
                    (Kernel/inspect (Enum/map public_beams (fn [b] (elem b 0))))
                    ": "
                    (Elixir.Exception/message e)))))))
    (let [written (Enum/map
      (Enum/sort_by beams (fn [b] (if (erlang/== mod (elem b 0)) 0 1)))
      (fn [b] (write_beam (elem b 0) (elem b 1) output_dir)))]
      ;; Metadata names the table the loaded shim actually executes, including
      ;; stabilized AOT body identities, before readers may obtain evidence.
      (BeamLisp.Env/link_ns_defs ns mod)
      (materialize_unit_callables! ns mod previous)
      written)))

(defn- write_beam
  "Compile-to-disk for one module; replacement preserves cache-linked inodes."
  [mod beam output_dir]
  (let [path (Path/join output_dir (erlang/iolist_to_binary (list (Atom/to_string mod) ".beam")))
        tmp (erlang/iolist_to_binary
              (list path ".tmp-" (os/getpid) "-"
                    (Integer/to_string (System/unique_integer (list :positive)))))]
    (File/mkdir_p! output_dir)
    (try
      (do
        (File/write! tmp beam)
        (File/rename! tmp path)
        (tuple mod path))
      (finally (File/rm tmp)))))

(defn- init_module_for
  "The initializer companion module: `BeamLisp.Ns.Init.<Ns>`."
  [ns]
  (Module/concat
    (erlang/++ (list (BeamLisp.Emit/realm_base ns :Elixir.BeamLisp.Ns.Init))
               (Enum/map (String/split ns ".") (fn [s] (Macro/camelize s))))))

(defn- ns_body_module
  "The single shared body module for a namespace: `BeamLisp.Ns.Body.<Ns>`."
  [ns]
  (Module/concat
    (erlang/++ (list (BeamLisp.Emit/realm_base ns :Elixir.BeamLisp.Ns.Body))
               (Enum/map (String/split ns ".") (fn [s] (Macro/camelize s))))))

(defn- unit_defs
  "Project this unit's published names, including macro-generated definitions.
   Never scan inherited tables or infer ownership from body module naming."
  [ns names]
  (BeamLisp.Env/selected_ns_definitions ns
    (if names (MapSet/to_list names) (list))))

(defn- stabilise_body_modules
  "Rewrite every var's body module to a SINGLE deterministic body module shared
   by the whole namespace."
  [ns ns_defs]
  (let [body_mod (ns_body_module ns)]
    (Map/new ns_defs
      (fn [pair]
        (tuple (elem pair 0)
               (Enum/map (elem pair 1) (fn [d] (erlang/setelement 5 d body_mod))))))))

(defn- native_declaration
  "The native declaration for `ns` straight from vm.native's VM-wide ETS table,
   or nil."
  [ns]
  (if (erlang/== :undefined (ets/whereis :beam_lisp_native_declarations))
    nil
    (let [r (ets/lookup :beam_lisp_native_declarations (tuple :native ns))]
      (if (and (erlang/is_list r)
               (erlang/== 1 (erlang/length r))
               (erlang/is_tuple (first r))
               (erlang/== 2 (erlang/tuple_size (first r)))
               (erlang/is_tuple (elem (first r) 1))
               (erlang/== 2 (erlang/tuple_size (elem (first r) 1))))
        (tuple (elem (elem (first r) 1) 0) (elem (elem (first r) 1) 1))
        nil))))

(defn- compile_initializer
  [form env]
  (if (and (Code/ensure_loaded? :Elixir.BeamLisp.Ns.Compiler)
           (erlang/function_exported :Elixir.BeamLisp.Ns.Compiler :"compile-node" 2))
    (erlang/apply :Elixir.BeamLisp.Ns.Compiler :"compile-node" (list form env))
    (erlang/error
      (Elixir.RuntimeError/exception
        "initializer compiler unavailable: BeamLisp.Ns.Compiler.compile-node/2 is not ready"))))

(defn- runtime_dependency_walk
  "Namespaces the compiled executable ANF actually reaches. Literals and source
   annotations are data; macro names that disappeared during expansion are not
   runtime dependencies. Direct calls carry the compiler's ensure_ready owner."
  [node acc]
  (cond
    (and (erlang/is_map node)
         (or (erlang/== :lit (maps/get :op node nil))
             (erlang/== :plit (maps/get :pop node nil)))) acc
    (erlang/is_map node)
    (let [op (maps/get :op node nil)
          args (maps/get :args node (list))
          owner (cond
                  (erlang/== :global op) (maps/get :ns node nil)
                  (and (erlang/== :remote op)
                       (erlang/== :Elixir.BeamLisp.Loader (maps/get :mod node nil))
                       (erlang/== :ensure_ready (maps/get :fun node nil))
                       (erlang/is_list args) (erlang/== 1 (erlang/length args))
                       (erlang/is_map (erlang/hd args))
                       (erlang/== :lit (maps/get :op (erlang/hd args) nil)))
                    (maps/get :val (erlang/hd args) nil)
                  :else nil)
          next (if (erlang/is_binary owner) (MapSet/put acc owner) acc)]
      (Enum/reduce (maps/values (maps/remove :ann node)) next
        (fn [child out] (runtime_dependency_walk child out))))
    (erlang/is_list node)
      (Enum/reduce node acc (fn [child out] (runtime_dependency_walk child out)))
    (erlang/is_tuple node)
      (runtime_dependency_walk (erlang/tuple_to_list node) acc)
    :else acc))

(defn- implicit_require_ops [ns ns_defs value_ops explicit]
  (let [bodies (Enum/flat_map ns_defs
                 (fn [pair] (Enum/map (elem pair 1) (fn [entry] (elem entry 3)))))
        owners (runtime_dependency_walk (erlang/++ bodies value_ops) (MapSet/new))
        skip (MapSet/new (erlang/++ (list ns "core" "sugar" "rt") explicit))]
    (Enum/map (Enum/sort (MapSet/to_list (MapSet/difference owners skip)))
      (fn [target]
        ;; A non-nil alias marks a declaration as lazy. No alias is installed:
        ;; this internal edge exists only for runtime readiness and exact fetch.
        (BeamLisp.Emit/remote :Elixir.BeamLisp.Loader :declare_require
          (list (BeamLisp.Emit/lit target) (BeamLisp.Emit/lit target)
                (BeamLisp.Emit/lit (list))))))))

(defn- physical_sdk_path [path]
  ;; Resolve every component. An SDK-shaped path escaping through a symlink is
  ;; not compiler evidence of SDK ownership.
  (when (and (erlang/is_binary path) (File/exists? path))
    (loop [parts (erlang/tl (Path/split (Path/expand path))) current "/" links 0 steps 0]
      (when (and (erlang/=< links 32) (erlang/< steps 512))
        (if (erlang/== parts (list)) current
          (let [next (Path/join current (erlang/hd parts)) link (File/read_link next)]
            (if (erlang/== :ok (elem link 0))
              (recur (erlang/++ (erlang/tl (Path/split (Path/expand (elem link 1) current)))
                               (erlang/tl parts)) "/" (erlang/+ links 1) (erlang/+ steps 1))
              (recur (erlang/tl parts) next links (erlang/+ steps 1)))))))))

(defn- normalized_attribute [attrs key]
  (let [value (Keyword/get attrs key)]
    (if (and (erlang/is_list value) (erlang/== 1 (erlang/length value)))
      (erlang/hd value) value)))

;; Validate only compiler-produced straight-line namespace forwarders. Unknown
;; VM instructions fail closed. Labels/line metadata carry no executable power.
(defn- sdk-register-value [regs operand]
  (if (and (erlang/is_tuple operand) (erlang/== 2 (erlang/tuple_size operand)))
    (cond
      (Enum/member? (list :x :y) (elem operand 0)) (Map/get regs operand :unknown)
      (Enum/member? (list :literal :atom) (elem operand 0)) (tuple :constant (elem operand 1))
      :else :unknown)
    :unknown))

(defn- sdk-forwarder-instructions? [instructions module name arity target ns]
  (loop [left instructions
         regs (Map/new (Enum/map (Enum/to_list (if (erlang/== 0 arity) (list) (Range/new 0 (erlang/- arity 1))))
                         (fn [i] (tuple (tuple :x i) (tuple :argument i)))))
         finished false]
    (if (erlang/== (list) left) finished
      (let [i (erlang/hd left) op (when (erlang/is_tuple i) (elem i 0))
            size (if (erlang/is_tuple i) (erlang/tuple_size i) 0)]
        (cond
          (and (erlang/not finished) (Enum/member? (list :label :line) op))
            (recur (erlang/tl left) regs false)
          (and (erlang/not finished) (erlang/== :func_info op) (erlang/== 4 size)
               (erlang/== (tuple :atom module) (elem i 1))
               (erlang/== (tuple :atom name) (elem i 2)) (erlang/== arity (elem i 3)))
            (recur (erlang/tl left) regs false)
          (and (erlang/not finished) (Enum/member? (list :allocate :allocate_zero) op)
               (erlang/== 3 size) (erlang/is_integer (elem i 1)) (erlang/>= (elem i 1) 0))
            (recur (erlang/tl left) regs false)
          (and (erlang/not finished) (erlang/== :move op) (erlang/== 3 size)
               (erlang/is_tuple (elem i 2)) (erlang/== 2 (erlang/tuple_size (elem i 2)))
               (Enum/member? (list :x :y) (elem (elem i 2) 0))
               (erlang/not (erlang/== :unknown (sdk-register-value regs (elem i 1)))))
            (recur (erlang/tl left) (Map/put regs (elem i 2) (sdk-register-value regs (elem i 1))) false)
          (and (erlang/not finished) (erlang/== :call_ext op) (erlang/== 3 size)
               (erlang/== 1 (elem i 1))
               (erlang/== (tuple :extfunc :Elixir.BeamLisp.Loader :ensure_ready 1) (elem i 2))
               (erlang/== (tuple :constant ns) (Map/get regs (tuple :x 0))))
            ;; External calls invalidate caller registers; only saved arguments
            ;; can authorize the eventual body call.
            (recur (erlang/tl left)
              (Map/new (Enum/filter regs (fn [entry] (erlang/== :y (elem (elem entry 0) 0))))) false)
          (and (erlang/not finished) (Enum/member? (list :call_ext_only :call_ext_last) op)
               (erlang/== (if (erlang/== :call_ext_only op) 3 4) size)
               (erlang/== arity (elem i 1))
               (erlang/== (tuple :extfunc target name arity) (elem i 2))
               (Enum/all? (Enum/to_list (if (erlang/== 0 arity) (list) (Range/new 0 (erlang/- arity 1))))
                 (fn [n] (erlang/== (tuple :argument n) (Map/get regs (tuple :x n))))))
            (recur (erlang/tl left) regs true)
          :else false)))))

(defn verify_sdk_forwarder!
  "Verify actual executable routes, allowing unrelated extra exports. Neither
   BEAM attributes nor a caller-supplied route claim authorize the function body.
   Protected routes come only from the attested compiler artifact inventory."
  [beam ns routes]
  (let [mod (elem beam 0) bytes (elem beam 1) result (beam_disasm/file bytes)]
    (when-not (and (erlang/is_tuple result) (erlang/== 6 (erlang/tuple_size result))
                  (erlang/== :beam_file (elem result 0)) (erlang/== mod (elem result 1))
                  (erlang/is_map routes) (erlang/is_binary ns))
      (erlang/error :invalid_sdk_forwarder_proof))
    (let [functions (Map/new (Enum/map (elem result 5)
                       (fn [f] (tuple (tuple (elem f 1) (elem f 2)) (elem f 4)))))]
      (Enum/each routes
        (fn [route]
          (let [key (elem route 0) target (elem route 1) instructions (Map/get functions key)]
            (when-not (and instructions
                          (Enum/member? (elem result 2)
                            (Enum/find (elem result 2)
                              (fn [e] (and (erlang/== (elem key 0) (elem e 0))
                                           (erlang/== (elem key 1) (elem e 1))))))
                          (sdk-forwarder-instructions? instructions mod (elem key 0) (elem key 1) target ns))
              (erlang/error :sdk_forwarder_route_changed)))))
      true)))

(defn- sdk_class_source_metadata! [source owner]
  (let [forms (BeamLisp.Reader/read_string (BeamLisp.Loader/read_source source) source)
        ns (elem owner 0) name (elem owner 1)
        found (Enum/reduce forms (tuple nil (list))
          (fn [form acc]
            (let [declared (ns_decl form) node (unmeta form)]
              (cond
                declared (tuple declared (elem acc 1))
                (and (erlang/== ns (elem acc 0)) (reg2? node :list)
                     (erlang/=< 3 (erlang/length (elem node 1))))
                  (let [items (elem node 1) head (unmeta (erlang/hd items))
                        declared-name (bare_name (erlang/hd (erlang/tl items)))
                        fields (unmeta (erlang/hd (erlang/tl (erlang/tl items))))]
                    (if (and (reg2? head :symbol) (Enum/member? (list "defrecord" "deftype") (elem head 1))
                             (erlang/== name declared-name) (reg2? fields :vector))
                      (let [names (Enum/map (elem fields 1) (fn [field] (bare_name field)))
                            kind (if (erlang/== "defrecord" (elem head 1)) :record :deftype)]
                        (when-not (Enum/all? names (fn [field] (erlang/is_binary field)))
                          (erlang/error :sdk_class_source_fields_invalid))
                        (tuple ns (cons (tuple 1 ns name kind names) (elem acc 1)))) acc))
                :else acc))))]
    (when-not (erlang/== 1 (erlang/length (elem found 1)))
      (erlang/error :sdk_class_source_declaration_missing_or_ambiguous))
    (erlang/hd (elem found 1))))

(defn- sdk_binding_routes! [mod bytes routes]
 ;; Literal checked compiler definitions identify exact emitted routes only.
 ;; They NEVER supply privacy: callers join explicit declaration metadata.
 (let [definitions (sdk_stage_literal_definitions! mod bytes)]
  (when definitions
   (when-not (and (erlang/is_map definitions) (<= (erlang/map_size definitions) 8192))
    (erlang/error :invalid_sdk_binding_routes))
   (Map/new (Enum/map definitions
    (fn [binding]
     (let [name (elem binding 0) definitions (elem binding 1)]
      (when-not (and (erlang/is_binary name) (erlang/is_list definitions)
                     (<= (erlang/length definitions) 256))
       (erlang/error :invalid_sdk_binding_routes))
      (tuple name (Enum/uniq (Enum/flat_map definitions
       (fn [definition]
        (when-not (and (erlang/is_tuple definition) (= 5 (erlang/tuple_size definition))
                       (contains? #{:fixed :variadic} (elem definition 0))
                       (erlang/is_integer (elem definition 1)) (<= 0 (elem definition 1) 255)
                       (erlang/is_atom (elem definition 2)) (erlang/is_map (elem definition 3))
                       (= :defn-clause (Map/get (elem definition 3) :op))
                       (erlang/is_list (Map/get (elem definition 3) :params))
                       (erlang/is_atom (elem definition 4)))
         (erlang/error :invalid_sdk_binding_routes))
        (let [function (elem definition 2) body (elem definition 4)
              arity (erlang/length (Map/get (elem definition 3) :params))]
         (when-not (and (<= arity 255)
                        (= arity (if (= :variadic (elem definition 0)) (inc (elem definition 1)) (elem definition 1)))
                        (= body (Map/get routes (tuple function arity))))
          (erlang/error :invalid_sdk_binding_routes))
         (list (tuple mod function arity) (tuple body function arity))))))))))))))

(defn- sdk_lambda_routes! [bytes]
 ;; Decode only the finite native BEAM lambda/atom tables, never ETF function
 ;; values or source syntax. Every row is bound to these authenticated bytes.
 (let [chunks (beam_lib/all_chunks bytes)]
  (when-not (= :ok (elem chunks 0)) (erlang/error :invalid_sdk_lambda_table))
  (let [table (List/keyfind (elem chunks 2) (String/to_charlist "FunT") 0)]
   (if (nil? table) {}
    (let [table-bytes (elem table 1)
          _ (when (< (erlang/byte_size table-bytes) 4) (erlang/error :invalid_sdk_lambda_table))
          count (binary/decode_unsigned (binary/part table-bytes 0 4))
          atoms (Map/new (Keyword/get (elem (elem (beam_lib/chunks bytes (list :atoms)) 1) 1) :atoms))]
     (when-not (and (<= count 65536) (= (erlang/byte_size table-bytes) (+ 4 (* count 24))))
      (erlang/error :invalid_sdk_lambda_table))
     (loop [index 0 output {}]
      (if (= index count) output
       (let [offset (+ 4 (* index 24))
             function (Map/get atoms (binary/decode_unsigned (binary/part table-bytes offset 4)))
             arity (binary/decode_unsigned (binary/part table-bytes (+ offset 4) 4))
             slot (binary/decode_unsigned (binary/part table-bytes (+ offset 12) 4))
             free (binary/decode_unsigned (binary/part table-bytes (+ offset 16) 4))]
        (when-not (and (erlang/is_atom function) (<= free arity 255)
                       (not (Map/has_key? output slot))) (erlang/error :invalid_sdk_lambda_table))
        (recur (inc index) (Map/put output slot (tuple function (- arity free) free)))))))))))

(defn- sdk_record_ctor_origins! [mod bytes]
 ;; Exact native constructor factory instruction references identify their
 ;; lambda slots. Never infer constructor authority from a lambda name prefix.
 (if (not= mod :Elixir.BeamLisp.Record) {}
  (let [functions (elem (beam_disasm/file bytes) 5)]
   (Enum/reduce functions {}
    (fn [function out]
     (let [name (elem function 1) arity (elem function 2)]
      (if-not (and (= 1 arity) (contains? #{:positional_ctor :map_ctor} name)) out
       (Enum/reduce (elem function 4) out
        (fn [instruction out]
         (if (and (erlang/is_tuple instruction) (>= (erlang/tuple_size instruction) 5)
                   (contains? #{:make_fun2 :make_fun3} (elem instruction 0)))
          (Map/put out (elem instruction 2) name) out))))))))))

(defn- sdk_kernel_primitive_routes! [entries]
 ;; The exact bootstrap ABI literal is an explicit public primitive table,
 ;; separately authenticated by native seed bytes. A generic body never grants
 ;; public access. Core declaration-private metadata can only narrow it later.
 (let [shim :Elixir.BeamLisp.Ns.Rt proof (Map/get entries shim)
       definitions (when proof (erlang/apply shim :__bl_ns_defs__ (list)))
       bindings (when definitions (Map/get definitions "seed-rows"))
       definition (when (and (erlang/is_list bindings) (= 1 (erlang/length bindings))) (first bindings))
       node (when definition (elem definition 3)) body (when node (Map/get node :body))
       provider (when definition (elem definition 4))]
  (when-not (and proof definition (= :fixed (elem definition 0)) (= 0 (elem definition 1))
                 (erlang/is_map node) (= :defn-clause (Map/get node :op))
                 (= (list) (Map/get node :params)) (nil? (Map/get node :guard))
                 (erlang/is_map body) (= :lit (Map/get body :op))
                 (Map/has_key? entries provider) (erlang/is_list (Map/get body :val))
                 (<= (erlang/length (Map/get body :val)) 2048))
   (erlang/error :unattested_source_kernel_abi))
  (Enum/reduce (Map/get body :val) {}
   (fn [row output]
    (when-not (and (erlang/is_list row) (= 5 (erlang/length row)))
     (erlang/error :invalid_source_kernel_abi))
    (let [name (nth row 0) module (if (= :rt (nth row 1)) shim (nth row 1))
          fixed (nth row 2) variadic (nth row 3)]
     (when-not (and (erlang/is_binary name) (erlang/is_atom module) (Map/has_key? entries module)
                    (erlang/is_map fixed) (<= (erlang/map_size fixed) 256)
                    (contains? #{:both :value :link} (nth row 4)))
      (erlang/error :invalid_source_kernel_abi))
     (let [routes (Enum/map fixed
                   (fn [arm]
                    (when-not (and (erlang/is_integer (elem arm 0)) (<= 0 (elem arm 0) 255)
                                   (erlang/is_atom (elem arm 1))) (erlang/error :invalid_source_kernel_abi))
                    (tuple module (elem arm 1) (elem arm 0))))
           routes (if (nil? variadic) routes
                    (do
                     (when-not (and (erlang/is_list variadic) (= 2 (erlang/length variadic))
                                    (erlang/is_integer (first variadic)) (<= 0 (first variadic) 254)
                                    (erlang/is_atom (second variadic))) (erlang/error :invalid_source_kernel_abi))
                     (cons (tuple module (second variadic) (inc (first variadic))) routes)))]
      (Map/put output name routes)))))))

(defn- sdk_merge_target_kind [left right]
 ;; A collision can only narrow access; macro/non-runtime declarations refuse.
 (if (and (= :public left) (= :public right)) :public :private))
(defn- sdk_source_target_inventory! [entries]
 (let [modules (Map/new (Enum/map entries
                  (fn [entry] (tuple (elem entry 0)
                    {:md5 (erlang/apply (elem entry 0) :module_info (list :md5)) :role (Map/get (elem entry 1) :role)
                     :lambda-routes (Map/get (elem entry 1) :lambda-routes {})
                     :ctor-lambda-origins (Map/get (elem entry 1) :ctor-lambda-origins {})
                     :local? (contains? #{:stable-body :stable-seed} (Map/get (elem entry 1) :role))}))))
       primitive-routes (sdk_kernel_primitive_routes! entries)
       core-row (Map/get entries :Elixir.BeamLisp.Ns.Core)
       core-declarations (when core-row (Map/get core-row :declarations))
       core-callables (when core-row (Map/get core-row :callable-kinds))
       _ (when-not (and (sdk_declaration_descriptor? core-declarations "core")
                        (sdk_callable_descriptor? core-callables "core"))
           (erlang/error :source_core_declaration_metadata_required))
       primitive-targets (Enum/reduce primitive-routes {}
                          (fn [binding output]
                           (Enum/reduce (elem binding 1) output (fn [mfa output]
                            (let [name (elem binding 0) declared (Map/get (elem core-declarations 2) name)
                                  callable (Map/get (elem core-callables 2) name)
                                  kind (if (or (nil? declared)
                                               (and (= :public declared) (= :function callable))) :public :private)]
                             (Map/update output mfa kind (fn [old] (sdk_merge_target_kind old kind))))))))
       primitive-targets
        (Enum/reduce (list (tuple :Elixir.BeamLisp.Env :decode_data_term! 1)
                          (tuple :Elixir.BeamLisp.Env :decode_data_term! 2)
                          (tuple :Elixir.BeamLisp.CompilerData :check_closed_etf! 1)
                          (tuple :Elixir.BeamLisp.CompilerData :check_closed_etf! 2)
                          (tuple :Elixir.BeamLisp.CompilerData :decode_closed_etf! 1)
                          (tuple :Elixir.BeamLisp.CompilerData :decode_closed_etf! 2)) primitive-targets
          (fn [mfa output]
            ;; Fixed data-only ABI, authenticated by actual seed/SDK bytes.
            ;; Function export membership alone never grants a Host route.
            (when-not (and (Map/has_key? modules (elem mfa 0))
                           (erlang/function_exported (elem mfa 0) (elem mfa 1) (elem mfa 2)))
              (erlang/error :source_data_decoder_abi_required))
            (Map/put output mfa :public)))
       targets (Enum/reduce entries primitive-targets
        (fn [entry output]
         (let [row (elem entry 1) ns (Map/get row :forwarder-namespace)
               descriptor (Map/get row :declarations) callable (Map/get row :callable-kinds)]
          (if-not (and (= :mutable-forwarder (Map/get row :role))
                       (sdk_declaration_descriptor? descriptor ns) (sdk_callable_descriptor? callable ns)) output
           (Enum/reduce (Map/get row :binding-routes {}) output
            (fn [binding output]
             (let [declared (Map/get (elem descriptor 2) (elem binding 0))
                   kind (if (= :public declared) :public :private)]
              (if (or (nil? declared) (not= :function (Map/get (elem callable 2) (elem binding 0)))) output
               (Enum/reduce (elem binding 1) output
                (fn [mfa output]
                 (when-not (Map/has_key? modules (elem mfa 0)) (erlang/error :incomplete_sdk_binding_route))
                 (Map/update output mfa kind (fn [prior] (sdk_merge_target_kind prior kind)))))))))))))
       classes (Enum/reduce entries {}
        (fn [entry out]
         (let [row (elem entry 1) owner (Map/get row :declaration-owner)
               metadata (Map/get row :generated-class)]
          (if-not (and (= :generated-class (Map/get row :role)) owner metadata) out
           (let [ns (elem owner 0) name (elem owner 1)
                 namespace (Map/get entries (BeamLisp.Emit/module_for ns))
                 declarations (when namespace (Map/get namespace :declarations))
                 callables (when namespace (Map/get namespace :callable-kinds))
                 public? (fn [binding]
                          (and (sdk_declaration_descriptor? declarations ns)
                               (sdk_callable_descriptor? callables ns)
                               (= :public (Map/get (elem declarations 2) binding))
                               (= :class (Map/get (elem callables 2) binding))))]
            (Map/put out (elem entry 0)
             {:md5 (Map/get row :md5) :positional (public? (erlang/iolist_to_binary (list "->" name)))
              :map (and (= :record (elem metadata 3))
                        (public? (erlang/iolist_to_binary (list "map->" name))))}))))))]
  {:version 1 :modules modules :targets targets :classes classes
   :names (Enum/reduce targets {} (fn [entry out]
            (let [mfa (elem entry 0) key (tuple (elem mfa 0) (elem mfa 1)) kind (elem entry 1)]
             (Map/update out key kind (fn [old] (sdk_merge_target_kind old kind))))))}))

(defn sdk_artifact_entry!
  "Compiler/build-owned inventory row for one emitted BEAM. Includes the exact
   input bytes and executable identity; a filename or namespace prefix alone
   grants no SDK ownership. Source paths are relative so drops reproduce."
  [root source mod path]
  (sdk_artifact_bytes_entry! root source mod (File/read! path)))

(defn- sdk_artifact_bytes_entry! [root source mod bytes]
  ;; Bind every inventory fact to the exact bytes that will be published; cache
  ;; validation never blesses a later re-read of a replaceable pathname.
  (let [root (physical_sdk_path root) source (physical_sdk_path source)
        _ (when-not (and root source (String/starts_with? source (erlang/iolist_to_binary (list root "/"))))
            (erlang/error :sdk_inventory_source_outside_root))
        chunks (beam_lib/chunks bytes (list :attributes))
        _ (when-not (and (erlang/== :ok (elem chunks 0)) (erlang/== mod (elem (elem chunks 1) 0)))
            (erlang/error :sdk_inventory_module_mismatch))
        attrs (Keyword/get (elem (elem chunks 1) 1) :attributes)
        input_digest (crypto/hash :sha256 (BeamLisp.Loader/read_source source))
        stamped (normalized_attribute attrs :bl_unit_source_digest)
        owner (normalized_attribute attrs :bl_declaration_owner)
        role (normalized_attribute attrs :bl_aot_artifact_role)
        declarations (normalized_attribute attrs :bl_sdk_declarations)
        callable (normalized_attribute attrs :bl_sdk_callable_kinds)]
    (when (and (not (nil? callable))
               (not (and (= :mutable-forwarder role)
                         (sdk_callable_descriptor? callable (normalized_attribute attrs :bl_aot_forwarder_namespace))
                         (sdk_declaration_descriptor? declarations (normalized_attribute attrs :bl_aot_forwarder_namespace))
                         (= (MapSet/new (Map/keys (elem callable 2))) (MapSet/new (Map/keys (elem declarations 2)))))))
      (erlang/error :sdk_inventory_invalid_callable_metadata))
    (when-not (and (erlang/== 1 (normalized_attribute attrs :bl_aot_artifact_version))
                   (Enum/member? (list :stable-body :initializer :actor :generated-class :mutable-forwarder) role)
                   (erlang/== (Enum/member? (list :actor :generated-class) role)
                              (erlang/not (erlang/== nil owner))))
      (erlang/error :sdk_inventory_missing_or_invalid_artifact_role))
    (when (and stamped (erlang/not (erlang/== stamped input_digest)))
      (erlang/error :sdk_inventory_source_changed))
    (when (and owner (or (erlang/not (erlang/is_tuple owner))
                         (erlang/not (erlang/== 2 (erlang/tuple_size owner)))
                         (erlang/not (erlang/is_binary (elem owner 0)))
                         (erlang/not (erlang/is_binary (elem owner 1)))
                         (erlang/not (erlang/== mod
                           (if (erlang/== role :generated-class)
                             (BeamLisp.Record/module_name (elem owner 0) (elem owner 1))
                             (BeamLisp.Server/module_for (elem owner 0) (elem owner 1)))))))
      (erlang/error :sdk_inventory_declaration_mismatch))
    ;; A server's source-input stamp is mandatory. Body/companion modules are
    ;; bound to their source by the authoritative emitting unit/manifest.
    (when (and owner (or (erlang/== nil stamped)
                        (erlang/not (erlang/== (normalized_attribute attrs :bl_compiler_key)
                                               (BeamLisp.AOTCache/key_for_source source root)))
                        (erlang/not (erlang/== 1 (normalized_attribute attrs
                          (if (erlang/== role :generated-class) :bl_generated_class_version :bl_generated_actor_version))))))
      (erlang/error :sdk_inventory_missing_or_stale_actor_stamp))
    (when (erlang/== :generated-class role)
      (let [metadata (normalized_attribute attrs :bl_generated_class)]
        (when-not (and (erlang/is_tuple metadata) (erlang/== 5 (erlang/tuple_size metadata))
                       (erlang/== 1 (elem metadata 0))
                       (erlang/== owner (tuple (elem metadata 1) (elem metadata 2)))
                       (erlang/== metadata (sdk_class_source_metadata! source owner)))
          (erlang/error :sdk_inventory_invalid_class_metadata))
        (let [canonical (BeamLisp.Record/declaration_descriptor (elem metadata 1) (elem metadata 2)
                           (elem metadata 3) (elem metadata 4))
              expected (BeamLisp.Emit/compile_descriptor canonical)]
          (when-not (and (erlang/== mod (elem expected 0))
                         (erlang/== (elem (elem (beam_lib/md5 bytes) 1) 1)
                                    (elem (elem (beam_lib/md5 (elem expected 1)) 1) 1)))
            (erlang/error :sdk_inventory_noncanonical_class_body)))))
    (when (erlang/== :mutable-forwarder role)
      ;; This descriptor shares the trusted HOST-cache boundary with the
      ;; executable unit. Attributes on partial/stale/arbitrary modules never
      ;; grant authority: the complete unit, input/compiler provenance and exact
      ;; executable identities are checked before publication and every query.
      ;; Ordinary SDK builds legitimately emit no staged declaration metadata.
      ;; Such rows retain executable ownership but cannot answer privacy queries.
      ;; A present descriptor must be well formed and bound to this actual unit.
      (when (and (not (nil? declarations))
             (not (and (sdk_declaration_descriptor? declarations
                         (normalized_attribute attrs :bl_aot_forwarder_namespace))
                       (erlang/== input_digest stamped)
                       (erlang/== (normalized_attribute attrs :bl_unit_namespace) (elem declarations 1))
                       (erlang/== (normalized_attribute attrs :bl_compiler_key)
                                  (BeamLisp.AOTCache/key_for_source source root)))))
        (erlang/error :sdk_inventory_invalid_declaration_metadata))
      (verify_sdk_forwarder! (tuple mod bytes)
        (normalized_attribute attrs :bl_aot_forwarder_namespace)
        (normalized_attribute attrs :bl_aot_forwarder_routes)))
    {:source (Path/relative_to source root) :source-digest input_digest
     :sha256 (crypto/hash :sha256 bytes) :md5 (elem (elem (beam_lib/md5 bytes) 1) 1)
     :imports (Enum/uniq (Enum/map (Keyword/get (elem (elem (beam_lib/chunks bytes (list :imports)) 1) 1) :imports)
                            (fn [entry] (elem entry 0))))
     :role role :declarations declarations
     :lambda-routes (when (= :stable-body role) (sdk_lambda_routes! bytes))
     :callable-kinds callable
     :binding-routes (when (= :mutable-forwarder role)
                       (sdk_binding_routes! mod bytes (normalized_attribute attrs :bl_aot_forwarder_routes)))
     :forwarder-namespace (normalized_attribute attrs :bl_aot_forwarder_namespace)
     :forwarder-routes (normalized_attribute attrs :bl_aot_forwarder_routes)
     :unit-references
       (let [members (normalized_attribute attrs :bl_aot_unit_members)]
         (when (and (erlang/is_tuple members) (erlang/== 2 (erlang/tuple_size members))
                    (erlang/== :members (elem members 0))) (elem members 1)))
     :generated-class (when (erlang/== role :generated-class) (normalized_attribute attrs :bl_generated_class))
     :declaration-owner owner :definition-env :global :compiler-key (BeamLisp.AOTCache/compiler_key)}))

(defn- verify_complete_sdk_units! [entries]
  ;; The shim records every generated actor and value companion belonging to
  ;; its compiler unit. Omitted digest-valid members must not become a partial
  ;; ownership receipt, even when their executable code is not a direct import.
  (Enum/each entries
    (fn [entry]
      (let [row (elem entry 1)]
        (when (erlang/== :mutable-forwarder (Map/get row :role))
          (let [references (Map/get row :unit-references)]
            (when-not (and (erlang/is_list references) (erlang/=< (erlang/length references) 8192)
                          (Enum/all? references (fn [mod] (erlang/is_atom mod)))
                          (Enum/all? (Map/values (Map/get row :forwarder-routes))
                            (fn [mod] (Enum/member? references mod))))
              (erlang/error :invalid_sdk_compiler_unit_members))
            (Enum/each references
              (fn [mod]
                (let [proof (Map/get entries mod)]
                  (when-not (and proof (erlang/== (Map/get row :source) (Map/get proof :source)))
                    (erlang/error :incomplete_sdk_compiler_unit))))))))))
  true)

(defn- sdk_emission_entries! [root path beams]
  (let [entries (Enum/map beams
                  (fn [beam]
                    (tuple (tuple :bl_sdk_emission (elem beam 0))
                      (sdk_artifact_bytes_entry! root path (elem beam 0) (elem beam 1)))))]
    (verify_complete_sdk_units! (Map/new (Enum/map entries
      (fn [entry] (tuple (elem (elem entry 0) 1) (elem entry 1))))))
    entries))

(defn- publish_sdk_emission_entries! [entries]
  ;; Atomic inventory publication happens only after every captured object was
  ;; validated and actually loaded. This function never runs an initializer.
  (BeamLisp.Env/with_code_evidence_publication
    (fn [] (ets/insert :beam_lisp_vars entries)))
  (when (and (erlang/not (erlang/== true (Process/get :bl_loader_initialization_blocked)))
             (erlang/function_exported :Elixir.BeamLisp.Env :refresh_sdk_runtime! 0))
    (BeamLisp.Env/refresh_sdk_runtime!)))

(defn- register_sdk_emission! [source file beams]
  ;; Source mode needs no hand-maintained inventory. Only actual physical SDK
  ;; inputs and a complete emitting unit can publish compiler ownership rows.
  (let [root (physical_sdk_path (BeamLisp.Tiers/priv_root)) path (physical_sdk_path file)]
    (when (and (erlang/== :global (BeamLisp.Env/env_id)) root path
               (String/starts_with? path (erlang/iolist_to_binary (list root "/")))
               (erlang/== source (BeamLisp.Loader/read_source path)))
      (publish_sdk_emission_entries!
        (sdk_emission_entries! root path
          (Enum/map beams (fn [beam] (tuple (elem beam 0) (File/read! (elem beam 1))))))))))

(defn- portable_sdk_routes [routes]
  (when routes
    (Map/new (Enum/map routes
      (fn [entry]
        (let [key (elem entry 0)]
          (tuple (tuple (Atom/to_string (elem key 0)) (elem key 1))
                 (Atom/to_string (elem entry 1)))))))))

(defn- portable_sdk_row [row]
  ;; ALL identities are binaries, including route function names and own-unit
  ;; members. Safe decoding must not depend on eagerly interned SDK atoms.
  (Map/merge row
    {:imports (Enum/map (Map/get row :imports (list)) (fn [mod] (Atom/to_string mod)))
     :forwarder-routes (portable_sdk_routes (Map/get row :forwarder-routes))
     :unit-references (when (Map/get row :unit-references)
                        (Enum/map (Map/get row :unit-references) (fn [mod] (Atom/to_string mod))))}))

(defn- image_sdk_routes! [bytes row]
  ;; Called only after the artifact SHA verifies. Verified BEAM parsing, never
  ;; unsafe term decoding or string-to-atom on untrusted inventory identities,
  ;; introduces the ordinary executable module/function atoms.
  (let [attrs (Keyword/get (elem (elem (beam_lib/chunks bytes (list :attributes)) 1) 1) :attributes)
        routes (normalized_attribute attrs :bl_aot_forwarder_routes)
        ns (normalized_attribute attrs :bl_aot_forwarder_namespace)]
    (when-not (and (erlang/== ns (Map/get row :forwarder-namespace))
                  (erlang/== (portable_sdk_routes routes) (Map/get row :forwarder-routes)))
      (erlang/error :sdk_image_forwarder_metadata_changed))
    routes))

(defn write_sdk_inventory!
  "Seal the SDK build manifest's emitted modules into the image. This consumes
   the normal compiler result, never scans arbitrary loaded modules or blesses
   classes by name. Any missing/stale/mismatched output fails the build."
  [root manifest ebin destination]
  (let [modules (Enum/reduce manifest (Map/new)
                  (fn [source_entry out]
                    (Enum/reduce (Map/fetch! (elem source_entry 1) :modules) out
                      (fn [module out]
                        (let [mod (if (erlang/is_atom module) module (String/to_existing_atom module))
                              path (Path/join ebin (erlang/iolist_to_binary (list (Atom/to_string mod) ".beam")))
                              entry (sdk_artifact_entry! root (elem source_entry 0) mod path)
                              prior (Map/get out (Atom/to_string mod))]
                          (when (and prior (erlang/not (erlang/== prior entry)))
                            (erlang/error :sdk_inventory_duplicate_module_owner))
                          (Map/put out (Atom/to_string mod) entry))))))
        _ (verify_complete_sdk_units! (Map/new (Enum/map modules
              (fn [entry] (tuple (String/to_existing_atom (elem entry 0)) (elem entry 1))))))
        inventory {:version 2 :identities :binary
                   :compiler-key (BeamLisp.AOTCache/compiler_key)
                   :modules (Map/new (Enum/map modules (fn [entry] (tuple (elem entry 0) (portable_sdk_row (elem entry 1))))))}
        tmp (erlang/iolist_to_binary (list destination ".tmp-" (os/getpid) "-"
                                     (Integer/to_string (System/unique_integer (list :positive)))))]
    (File/mkdir_p! (Path/dirname destination))
    (try
      (do (File/write! tmp (erlang/term_to_binary inventory (list :deterministic)))
          (File/rename! tmp destination))
      (finally (File/rm tmp)))
    (erlang/map_size modules)))

(defn- inventory_term [path]
  (let [bytes (File/read! path)]
    (when (erlang/> (erlang/byte_size bytes) 16777216) (erlang/error :sdk_inventory_too_large))
    (let [inventory (erlang/binary_to_term bytes (list :safe))]
      (when-not (and (erlang/is_map inventory) (erlang/== 2 (Map/get inventory :version))
                    (erlang/== :binary (Map/get inventory :identities))
                    (erlang/== (BeamLisp.AOTCache/compiler_key) (Map/get inventory :compiler-key))
                    (erlang/is_map (Map/get inventory :modules))
                    (erlang/=< (erlang/map_size (Map/get inventory :modules)) 32768))
        (erlang/error :invalid_sdk_code_inventory))
      (Map/get inventory :modules))))

(defn- register_cached_sdk_unit! [ns modules directory]
  (let [path (BeamLisp.Loader/source_path ns)]
    (when path
      (register_sdk_emission! (BeamLisp.Loader/read_source path) path
        (Enum/map modules
          (fn [mod] (tuple mod (Path/join directory
                       (erlang/iolist_to_binary (list (Atom/to_string mod) ".beam"))))))))))

(defn- ensure_source_sdk_evidence! [ns mod]
  ;; Cache hits and ordinary build outputs are compiler-owned too. Recover their
  ;; complete unit inventory automatically; never re-evaluate source to obtain
  ;; proof. Missing evidence refuses adoption rather than blessing loaded code.
  (when (erlang/== (list) (ets/lookup :beam_lisp_vars (tuple :bl_sdk_emission mod)))
    (let [source (physical_sdk_path (BeamLisp.Loader/source_path ns))
          root (physical_sdk_path (BeamLisp.Tiers/priv_root))]
      (when-not (and source root (String/starts_with? source (erlang/iolist_to_binary (list root "/"))))
        (erlang/error :framework_declaration_outside_sdk))
      (let [key (ns_closure_hash ns) compiler (BeamLisp.AOTCache/compiler_key)
            cache (BeamLisp.AOTCache/entry_dir compiler key)
            modules (BeamLisp.AOTCache/valid_keyed_entry cache compiler key)]
        (if (and modules (Enum/member? modules mod)
                 (Enum/member? modules (BeamLisp.Emit/module_for ns)))
          (register_cached_sdk_unit! ns modules cache)
          (let [shim (BeamLisp.Emit/module_for ns) file (code/which shim)
                directory (when (erlang/is_list file) (Path/dirname (List/to_string file)))
                manifest (when directory (File/read (Path/join directory "compile.beam_lisp")))
                projection (when (and manifest (erlang/== :ok (elem manifest 0)))
                             (erlang/binary_to_term (elem manifest 1) (list :safe)))
                entry (when (erlang/is_map projection)
                        (Enum/find projection
                          (fn [pair] (erlang/== source (physical_sdk_path (elem pair 0))))))
                record (when entry (elem entry 1))
                modules (when (erlang/is_map record) (Map/get record :modules))]
            (when-not (and directory modules (Enum/member? modules mod)
                          (Enum/member? modules (BeamLisp.Emit/module_for ns))
                          (erlang/== (BeamLisp.AOTCache/key_for_source source) (Map/get record :key))
                          (BeamLisp.AOTCache/beam_provenance_matches?
                            (Path/join directory (erlang/iolist_to_binary (list (Atom/to_string shim) ".beam")))
                            (BeamLisp.AOTCache/key_for_ns ns) key))
              (erlang/error :missing_sdk_compiler_inventory))
            (register_cached_sdk_unit! ns modules directory)))))))

(defn- seed_forwarder_metadata [mod bytes]
  ;; The seed manifest authenticates the bytes; derive their role from the
  ;; actual emitted executable surface rather than a namespace naming rule.
  (let [sha (crypto/hash :sha256 bytes)
        cached (when (erlang/function_exported :Elixir.BeamLisp.Env :source_seed_metadata 1)
                 (BeamLisp.Env/source_seed_metadata sha))]
   (or cached
    (let [disassembly (beam_disasm/file bytes) exports (elem disassembly 2)
        ns (Enum/find (BeamLisp.Tiers/boot_namespaces)
             (fn [candidate] (erlang/== mod (BeamLisp.Emit/base_module_for candidate))))]
    (when (and ns (Enum/any? exports
                    (fn [entry] (and (erlang/== :__bl_ns_defs__ (elem entry 0))
                                     (erlang/== 0 (elem entry 1))))))
      (let [functions (Enum/reject (elem disassembly 5)
                        (fn [f] (Enum/member? (list :module_info :__bl_ns_defs__ :__bl_init__ :__bl_provenance__) (elem f 1))))
            routes (Map/new (Enum/map functions
                       (fn [f]
                         (let [tail (List/last (elem f 4))
                               external (when (and (erlang/is_tuple tail)
                                                  (Enum/member? (list :call_ext_only :call_ext_last) (elem tail 0)))
                                          (elem tail 2))]
                           (when-not (and (erlang/is_tuple external) (erlang/== 4 (erlang/tuple_size external))
                                           (erlang/== :extfunc (elem external 0))
                                           (erlang/== (elem f 1) (elem external 2))
                                           (erlang/== (elem f 2) (elem external 3)))
                             (erlang/error :invalid_seed_forwarder))
                           (tuple (tuple (elem f 1) (elem f 2)) (elem external 1))))))]
        (verify_sdk_forwarder! (tuple mod bytes) ns routes)
        (let [attrs (Keyword/get (elem (elem (beam_lib/chunks bytes (list :attributes)) 1) 1) :attributes)
              declarations (normalized_attribute attrs :bl_sdk_declarations)
              callable (normalized_attribute attrs :bl_sdk_callable_kinds)]
         (when (and (not (nil? callable))
                    (not (and (sdk_callable_descriptor? callable ns)
                              (sdk_declaration_descriptor? declarations ns)
                              (= (MapSet/new (Map/keys (elem callable 2))) (MapSet/new (Map/keys (elem declarations 2)))))))
          (erlang/error :invalid_seed_callable_metadata))
         (when (and declarations (not (sdk_declaration_descriptor? declarations ns)))
          (erlang/error :invalid_seed_declaration_metadata))
         (let [metadata {:role :mutable-forwarder :forwarder-namespace ns :forwarder-routes routes
                          :declarations declarations :callable-kinds callable
                          :binding-routes (sdk_binding_routes! mod bytes routes)}]
          (if (erlang/function_exported :Elixir.BeamLisp.Env :cache_source_seed_metadata! 2)
           (BeamLisp.Env/cache_source_seed_metadata! sha metadata) metadata)))))))))

(defn- source_seed_inventory! []
  ;; Checkout startup already verifies this authoritative floor. Re-use its
  ;; exact bytes for boot/native dependencies, never demand a whole-SDK image
  ;; build merely to start one source-owned actor. Loaded std units are supplied
  ;; separately by their complete compiler-owned emission receipts.
  (let [manifest (BeamLisp.Bootstrap/manifest)
        directory (BeamLisp.Bootstrap/seed_dir)]
    (when-not (and manifest
                   (erlang/== (BeamLisp.AOTCache/compiler_key) (Map/get manifest "compiler_key")))
      (erlang/error :stale_sdk_bootstrap_inventory))
    (Enum/reduce (Map/fetch! manifest "modules") (Map/new)
      (fn [entry acc]
        (let [file (elem entry 0) path (Path/join directory file)
              ;; Existing atoms only; no arbitrary manifest names are interned.
              mod (try (String/to_existing_atom (Path/basename file ".beam")) (catch _ nil))]
          (if (or (erlang/== nil mod) (erlang/not (erlang/module_loaded mod))) acc
            (let [bytes (File/read! path) sha (crypto/hash :sha256 bytes)
                  md5 (elem (elem (beam_lib/md5 bytes) 1) 1)]
              (when-not (erlang/== (String/downcase (Base/encode16 sha)) (elem entry 1))
                (erlang/error :sdk_bootstrap_artifact_changed))
              ;; A newly source-compiled unit may legitimately supersede this
              ;; seed. Its compiler receipt must supply replacement evidence.
              (if (erlang/not (erlang/== md5 (erlang/apply mod :module_info (list :md5)))) acc
                (Map/put acc mod
                  (Map/merge {:role :stable-seed :lambda-routes (sdk_lambda_routes! bytes) :ctor-lambda-origins (sdk_record_ctor_origins! mod bytes) :md5 md5 :sha256 sha
                              :seed? true :compiler-key (BeamLisp.AOTCache/compiler_key)
                              :imports (Enum/uniq (Enum/map
                                (Keyword/get (elem (elem (beam_lib/chunks bytes (list :imports)) 1) 1) :imports)
                                (fn [import] (elem import 0))))}
                    (or (seed_forwarder_metadata mod bytes) {})))))))))))

(defn- source_sdk_receipts []
  (Map/new (Enum/map
    (ets/match_object :beam_lisp_vars (tuple (tuple :bl_sdk_emission :_) :_))
    (fn [row] (tuple (elem (elem row 0) 1) (elem row 1))))))

(defn- source_sdk_receipt [mod]
  (let [rows (ets/lookup :beam_lisp_vars (tuple :bl_sdk_emission mod))]
    (when (erlang/not (erlang/== (list) rows)) (elem (erlang/hd rows) 1))))

(defn- seed_dependency! [mod]
  (seed_dependency_from_manifest! mod (BeamLisp.Bootstrap/manifest)))

(defn- seed_dependency_from_manifest! [mod manifest]
  ;; The closure walker supplies its own captured native manifest, not a
  ;; caller/provider grant. Every selected artifact still passes byte and live
  ;; module checks; missing ordinary OTP imports are a constant-time lookup.
  (let [name (erlang/iolist_to_binary (list (Atom/to_string mod) ".beam"))
        expected (when manifest (Map/get (Map/get manifest "modules") name))]
    (when expected
      (when-not (erlang/== (BeamLisp.AOTCache/compiler_key) (Map/get manifest "compiler_key"))
        (erlang/error :stale_sdk_bootstrap_inventory))
      (let [bytes (File/read! (Path/join (BeamLisp.Bootstrap/seed_dir) name))
            sha (crypto/hash :sha256 bytes) md5 (elem (elem (beam_lib/md5 bytes) 1) 1)]
        (when-not (and (erlang/== expected (String/downcase (Base/encode16 sha)))
                      (Code/ensure_loaded? mod)
                      (erlang/== md5 (erlang/apply mod :module_info (list :md5))))
          (erlang/error :unproved_sdk_bootstrap_dependency))
        (Map/merge {:role :stable-seed :seed? true :lambda-routes (sdk_lambda_routes! bytes) :ctor-lambda-origins (sdk_record_ctor_origins! mod bytes) :md5 md5 :sha256 sha
                    :compiler-key (BeamLisp.AOTCache/compiler_key)
                    :imports (Enum/uniq (Enum/map
                      (Keyword/get (elem (elem (beam_lib/chunks bytes (list :imports)) 1) 1) :imports)
                      (fn [import] (elem import 0))))}
          (or (seed_forwarder_metadata mod bytes) {}))))))

(defn- assert_sdk_seed_snapshot! [manifest]
  ;; Denial-only check of this walk's captured native input, never a cache grant.
  (when-not (erlang/== manifest (BeamLisp.Bootstrap/manifest))
    (erlang/error :sdk_bootstrap_inventory_changed))
  :ok)

(defn- sdk_native_source_path [ns]
  (let [selected (BeamLisp.Loader/find_file ns (BeamLisp.Tiers/dirs))]
    (when (and (erlang/is_tuple selected) (erlang/== 3 (erlang/tuple_size selected))
               (erlang/== :ok (elem selected 0))) (elem selected 1))))

;; HOME draft only. Existing same-VM SDK native host recovery, no code loading.
;; The complete current-input vm.native unit authenticates its pure descriptor
;; API before any global callable is invoked. Claimed registry rows only select
;; physical SDK source discovery; they never grant native executable authority.
(defn- sdk_compiler_row [mod]
  (let [root (physical_sdk_path (BeamLisp.Tiers/priv_root)) image (Path/join root "sdk-code.term")]
    (if (File/exists? image)
      (let [identity (Atom/to_string mod) row (Map/get (inventory_term image) identity)]
        (when row (image_sdk_entry! root identity row)))
      (source_sdk_receipt mod))))

(defn- exact_sdk_function! [ns name arity]
 (when-not (sdk_unit_compiled? ns) (erlang/error (tuple :sdk_native_producer_not_compiled ns)))
 (let [value (BeamLisp.Env/fetch_exact! ns name)
       arm (cond
             (erlang/is_function value arity) value
             (and (erlang/is_tuple value) (erlang/== 3 (erlang/tuple_size value))
                  (erlang/== :"$blfn" (elem value 0)) (erlang/is_map (elem value 1))
                  (erlang/== 1 (erlang/map_size (elem value 1))) (nil? (elem value 2)))
               (Map/get (elem value 1) arity)
             :else nil)
       module (when (erlang/is_function arm arity) (elem (erlang/fun_info arm :module) 1))
       row (when module (sdk_compiler_row module))
       source (physical_sdk_path (sdk_native_source_path ns))
       root (physical_sdk_path (BeamLisp.Tiers/priv_root))]
  (when-not (and module row (erlang/== :external (elem (erlang/fun_info arm :type) 1))
                 (erlang/== name (Atom/to_string (elem (erlang/fun_info arm :name) 1)))
                 (erlang/== (Path/relative_to source root) (Map/get row :source))
                 (erlang/== (Map/get row :md5) (erlang/apply module :module_info (list :md5))))
   (erlang/error (tuple :unattested_sdk_native_producer ns name)))
  arm))

(defn- sdk_native_source_declaration [ns source]
 (let [content (BeamLisp.Loader/read_source source)]
  (when (erlang/> (erlang/byte_size content) 1048576) (erlang/error :sdk_native_source_bound))
  (let [forms (BeamLisp.Reader/read_string content source)]
   (when (erlang/> (erlang/length forms) 2048) (erlang/error :sdk_native_source_bound))
   (let [found (Enum/reduce forms (tuple nil (list))
                (fn [form state]
                 (let [declared (ns_decl form) node (unmeta form)]
                  (cond
                   declared (tuple declared (elem state 1))
                   (and (reg2? node :list) (erlang/not (erlang/== (elem node 1) (list)))
                        (reg2? (erlang/hd (elem node 1)) :symbol)
                        (erlang/== "in-ns" (elem (erlang/hd (elem node 1)) 1)))
                    (tuple nil (elem state 1))
                   (and (erlang/== ns (elem state 0)) (reg2? node :list)
                        (erlang/not (erlang/== (elem node 1) (list)))
                        (reg2? (erlang/hd (elem node 1)) :symbol)
                        (erlang/== "defnative" (elem (erlang/hd (elem node 1)) 1)))
                    (tuple ns (cons (stage-native form) (elem state 1)))
                   :else state))))]
    (when (erlang/== 1 (erlang/length (elem found 1))) (erlang/hd (elem found 1)))))))

(defn- native_registry_rows []
 (if (erlang/== :undefined (ets/whereis :beam_lisp_native_declarations)) (list)
  (let [selected (ets/select :beam_lisp_native_declarations
                   (list (tuple (tuple (tuple :native :"$1") :"$2") (list) (list :"$_"))) 512)]
   (when-not (or (erlang/== :"$end_of_table" selected)
                 (and (erlang/is_tuple selected) (erlang/== 2 (erlang/tuple_size selected))
                      (erlang/== :"$end_of_table" (elem selected 1))))
    (erlang/error :sdk_native_registry_bound))
   (if (erlang/== :"$end_of_table" selected) (list) (elem selected 0)))))

(defn- sdk_native_input [ns]
  (let [root (physical_sdk_path (BeamLisp.Tiers/priv_root))
        source (physical_sdk_path (sdk_native_source_path ns))]
    (when (and source (String/starts_with? source (erlang/iolist_to_binary (list root "/"))))
      (let [declaration (sdk_native_source_declaration ns source)]
        (when declaration (tuple root source declaration))))))

(defn assert_sdk_native_start!
  "A new on_load host may not execute after SDK lifetime publication. Existing
   exact hosts can replay links; SDK/NIF replacement is a separate VM boundary."
  [ns mod]
  (when (and (sdk_native_input ns) (ets/member :beam_lisp_vars :bl_sdk_runtime_lease)
             (erlang/not (erlang/module_loaded mod)))
    (erlang/error (tuple :sdk_native_late_initialization_requires_prepared_host ns mod)))
  :ok)

(defn- sdk_native_library_identity! [root crate lib]
  ;; A missing SDK library preserves the existing capability/stub behavior.
  ;; Its parent must still be the exact physical SDK native directory. Neither
  ;; an ambient project file nor a same-named relative path grants authority.
  (let [sdk (Path/join (Path/join root "native") (erlang/iolist_to_binary (list crate ".so")))
        selected (erlang/iolist_to_binary (list lib ".so"))
        physical (physical_sdk_path selected) target (physical_sdk_path sdk)]
    (cond
      (and physical target (erlang/== physical target)) physical
      (and (erlang/== nil physical) (erlang/== nil target)
           (erlang/== (Path/basename selected) (Path/basename sdk))
           (erlang/== (physical_sdk_path (Path/dirname selected))
                      (physical_sdk_path (Path/dirname sdk)))
           (physical_sdk_path (Path/dirname sdk))) (Path/expand sdk)
      :else (erlang/error (tuple :sdk_native_library_outside_selected_sdk lib)))))

(defn- native_host_emission_row! [ns crate signatures lib beam]
  (when-let [input (sdk_native_input ns)]
    (let [root (elem input 0) source (elem input 1) declaration (elem input 2)
          mod (elem beam 0) bytes (elem beam 1)
          descriptor-for (exact_sdk_function! "vm.native" "host-descriptor" 4)
          expected (BeamLisp.Emit/compile_descriptor
                     (erlang/apply descriptor-for (list ns crate signatures lib)))
          md5 (elem (elem (beam_lib/md5 bytes) 1) 1)
          physical (sdk_native_library_identity! root crate lib)]
      (when-not (and (erlang/== declaration (tuple crate signatures)) physical (erlang/== mod (elem expected 0))
                     (erlang/== md5 (elem (elem (beam_lib/md5 (elem expected 1)) 1) 1)))
        (erlang/error (tuple :unattested_sdk_native_host ns mod)))
      (let [row {:role :native-host :source (Path/relative_to source root)
                 :source-digest (crypto/hash :sha256 (BeamLisp.Loader/read_source source))
                 :compiler-key (BeamLisp.AOTCache/compiler_key) :md5 md5
                 :sha256 (crypto/hash :sha256 bytes) :native-owner (tuple ns crate signatures)
                 :selected-library lib :physical-library physical :runtime-boundary :fixed-vm
                 :historical-library-digest nil
                 :imports (Enum/uniq (Enum/map
                   (Keyword/get (elem (elem (beam_lib/chunks bytes (list :imports)) 1) 1) :imports)
                   (fn [entry] (elem entry 0))))}]
        row))))

(defn prepare_native_host_emission!
  "Validate the exact SDK source, canonical executable and selected physical
   library BEFORE on_load publication. A new post-lease host still refuses."
  [ns crate signatures lib beam]
  (when (native_host_emission_row! ns crate signatures lib beam)
    (assert_sdk_native_start! ns (elem beam 0))
    ;; A non-authorizing exact-module candidate exists before publication. A
    ;; killed producer cannot leave its newly loaded host silently external.
    (ets/insert :beam_lisp_vars (tuple (tuple :bl_sdk_native_expected (elem beam 0)) ns)))
  :ok)

(defn register_native_host_emission!
  "Record actual published SDK native producer identity for this fixed VM."
  [ns crate signatures lib beam]
  (when-let [row (native_host_emission_row! ns crate signatures lib beam)]
    (let [mod (elem beam 0)]
      (when-not (and (erlang/module_loaded mod)
                     (erlang/== (Map/get row :md5) (erlang/apply mod :module_info (list :md5))))
        (erlang/error (tuple :sdk_native_publication_incomplete ns mod)))
      (ets/insert :beam_lisp_vars (tuple (tuple :bl_sdk_native_host mod) row))))
  :ok)

(defn bootstrap_sdk_native_hosts!
  "Before the first SDK kernel lease, publish only canonical SDK NIF host
   stubs. Provider namespaces and application initializers remain unloaded.
   This bounded bootstrap tradeoff avoids executing a new on_load under an
   already published SDK lifetime; later NIF/SDK replacement requires handover."
  []
  (global/trans (tuple :bl_sdk_native_bootstrap (erlang/self))
    (fn []
      (when-not (ets/member :beam_lisp_vars :bl_sdk_native_bootstrap)
        (when (ets/member :beam_lisp_vars :bl_sdk_runtime_lease)
          (erlang/error :sdk_native_bootstrap_after_runtime_publication))
        (let [started (erlang/monotonic_time :microsecond)
              root (physical_sdk_path (BeamLisp.Tiers/priv_root))
              files (Enum/uniq (Enum/flat_map (BeamLisp.Tiers/dirs root)
                      (fn [dir] (Enum/flat_map (BeamLisp.Tiers/source_extensions)
                        (fn [ext] (Path/wildcard (erlang/iolist_to_binary (list dir "/**/*" ext))))))))]
          (when (erlang/> (erlang/length files) 8192) (erlang/error :sdk_native_source_inventory_bound))
          ;; The policy unit is ordinary SDK bootstrap support. No native
          ;; provider unit __bl_init__, def value or business callback runs.
          (BeamLisp.Loader/ensure_loaded "vm.native")
          (let [host (exact_sdk_function! "vm.native" "bootstrap-sdk-host!" 4)
                declarations (Enum/flat_map files
                  (fn [file]
                    (let [source (physical_sdk_path file) content (BeamLisp.Loader/read_source file)]
                      (when (erlang/> (erlang/byte_size content) 16777216)
                        (erlang/error :sdk_native_source_inventory_bound))
                      (if (String/contains? content "defnative")
                        (let [ns (BeamLisp.Loader/declared_ns content)
                              input (when ns (sdk_native_input ns))]
                          (if (and input (erlang/== source (elem input 1)))
                            (list (tuple ns (elem input 2))) (list))) (list)))))]
            (when (erlang/> (erlang/length declarations) 512) (erlang/error :sdk_native_registry_bound))
            (Enum/each declarations
              (fn [entry]
                (let [declaration (elem entry 1) crate (elem declaration 0)]
                  (erlang/apply host (list (elem entry 0) crate (elem declaration 1)
                                     (Path/join (Path/join root "native") crate))))))
            (ets/insert :beam_lisp_vars
              (tuple :bl_sdk_native_bootstrap
                {:count (erlang/length declarations)
                 :elapsed-us (erlang/- (erlang/monotonic_time :microsecond) started)
                 :boundary :before-sdk-kernel-lease :provider-initializers 0})))))
      :ok)))

(defn- sdk_native_receipts []
  (let [rows (ets/match_object :beam_lisp_vars (tuple (tuple :bl_sdk_native_host :_) :_))]
    (when (erlang/> (erlang/length rows) 512) (erlang/error :sdk_native_registry_bound))
    (Map/new (Enum/map rows (fn [row] (tuple (elem (elem row 0) 1) (elem row 1)))))))

(defn- sdk_native_dependency! [mod]
  (let [receipt (Map/get (sdk_native_receipts) mod)]
    (if receipt
      (let [owner (Map/get receipt :native-owner) ns (elem owner 0) input (sdk_native_input ns)
            physical (when input (sdk_native_library_identity! (elem input 0) (elem owner 1)
                                   (Map/get receipt :selected-library)))]
        (when-not (and input (erlang/== (elem input 2) (tuple (elem owner 1) (elem owner 2)))
                       (erlang/== (Map/get receipt :source-digest)
                          (crypto/hash :sha256 (BeamLisp.Loader/read_source (elem input 1))))
                       (erlang/== physical (Map/get receipt :physical-library))
                       (erlang/module_loaded mod)
                       (erlang/== (Map/get receipt :md5) (erlang/apply mod :module_info (list :md5))))
          (erlang/error (tuple :sdk_native_host_changed mod))) receipt)
      ;; Exact compiler-validated candidates are indexed before publication.
      ;; This only detects missing proof; a candidate row grants no authority.
      (let [expected (ets/lookup :beam_lisp_vars (tuple :bl_sdk_native_expected mod))]
        (when (erlang/not (erlang/== expected (list)))
          (erlang/error (tuple :missing_sdk_native_host_emission (elem (erlang/hd expected) 1) mod)))
        nil))))

(defn sdk_native_source? [ns] (erlang/not (erlang/== nil (sdk_native_input ns))))

(defn selected_sdk_native_library!
  "Reuse the actual already-published literal when aliases resolve to the same
   SDK artifact. Never reload a NIF merely to normalize its path spelling."
  [ns mod fallback]
  (if (erlang/module_loaded mod)
    (let [row (sdk_native_dependency! mod)]
      (when-not (and row (erlang/== ns (elem (Map/get row :native-owner) 0)))
        (erlang/error (tuple :missing_sdk_native_host_emission ns mod)))
      (Map/get row :selected-library)) fallback))

(defn- sdk_source_dependency! [mod]
  (or (sdk_native_dependency! mod)
  (let [object (code/get_object_code mod)]
    (if (and (erlang/is_tuple object) (erlang/== 3 (erlang/tuple_size object))
             (erlang/== mod (elem object 0)))
      (let [bytes (elem object 1)
            attrs (Keyword/get (elem (elem (beam_lib/chunks bytes (list :attributes)) 1) 1) :attributes)
            info (Keyword/get (elem (elem (beam_lib/chunks bytes (list :compile_info)) 1) 1) :compile_info)
            selected (sdk_dependency_source! mod attrs info)]
        (when selected
          (let [ns (elem selected 0) source (elem selected 1)]
            (when-not (sdk_unit_compiled? ns)
              (stage_sdk_dependency! ns source mod))
            (let [row (source_sdk_receipt mod)]
              (when-not (and row (erlang/module_loaded mod)
                            (erlang/== (Map/get row :md5) (erlang/apply mod :module_info (list :md5))))
                (erlang/error (tuple :unproved_sdk_source_dependency mod ns source))) row))))
      (let [compile (when (erlang/module_loaded mod) (erlang/apply mod :module_info (list :compile)))
            selected (when compile (sdk_dependency_source! mod (list) compile))]
        (when selected (stage_sdk_dependency! (elem selected 0) (elem selected 1) mod)))))))

(defn- complete_source_sdk_closure! [entries]
  ;; Follow actual emitted imports. Global lazy SDK requires add their complete
  ;; compiler receipt before initializer execution, then refresh this shared
  ;; proof. No module name prefix or caller callback can declare SDK authority.
  (let [manifest (BeamLisp.Bootstrap/manifest)
        result
  (loop [pending (Map/keys entries) seen (MapSet/new) out entries]
    (when (erlang/> (erlang/map_size out) 8192) (erlang/error :sdk_dependency_closure_too_large))
    (if (erlang/== pending (list)) out
      (let [mod (erlang/hd pending)]
        (if (MapSet/member? seen mod) (recur (erlang/tl pending) seen out)
          (let [row (Map/fetch! out mod)
                expanded (Enum/reduce (Map/get row :imports (list)) (tuple (erlang/tl pending) out)
                  (fn [dependency acc]
                    (if (Map/has_key? (elem acc 1) dependency)
                      (tuple (cons dependency (elem acc 0)) (elem acc 1))
                      (let [proof (or (source_sdk_receipt dependency)
                                      (seed_dependency_from_manifest! dependency manifest)
                                      (sdk_source_dependency! dependency))]
                        (if proof
                          (tuple (cons dependency (elem acc 0)) (Map/put (elem acc 1) dependency proof)) acc)))))]
            (recur (elem expanded 0) (MapSet/put seen mod) (elem expanded 1)))))))]
    ;; No public mutable memo or caller process-dictionary authority. A change
    ;; during discovery refuses the whole result, rather than accepting a
    ;; snapshot from another bootstrap publication.
    (assert_sdk_seed_snapshot! manifest)
    result))

(defn- image_sdk_entry! [root identity row]
  ;; Only a selected root/import is loaded. The full image manifest remains
  ;; provenance for unrelated units; it is never an eager execution schedule.
  (when-not (and (erlang/is_binary identity) (erlang/=< 1 (erlang/byte_size identity))
                (erlang/=< (erlang/byte_size identity) 512)
                (erlang/== identity (Path/basename identity))
                (erlang/not (String/contains? identity "\\")))
    (erlang/error :invalid_sdk_inventory_module_name))
  (let [bytes (File/read! (Path/join (Path/dirname root)
                (erlang/iolist_to_binary (list "ebin/" identity ".beam"))))
        _ (when-not (erlang/== (crypto/hash :sha256 bytes) (Map/get row :sha256))
            (erlang/error :sdk_runtime_artifact_changed))
        mod (elem (elem (beam_lib/md5 bytes) 1) 0)
        imports (Enum/uniq (Enum/map
                  (Keyword/get (elem (elem (beam_lib/chunks bytes (list :imports)) 1) 1) :imports)
                  (fn [entry] (elem entry 0))))
        forwarder? (erlang/== :mutable-forwarder (Map/get row :role))
        routes (when forwarder? (image_sdk_routes! bytes row))
        attrs (Keyword/get (elem (elem (beam_lib/chunks bytes (list :attributes)) 1) 1) :attributes)
        callable (normalized_attribute attrs :bl_sdk_callable_kinds)]
    (when-not (and (erlang/== identity (Atom/to_string mod))
                  (erlang/== (Enum/sort (Map/get row :imports))
                    (Enum/sort (Enum/map imports (fn [dependency] (Atom/to_string dependency)))))
                  (Code/ensure_loaded? mod))
      (erlang/error :sdk_image_imports_changed))
    (when (and (not (nil? callable))
               (not (and forwarder? (sdk_callable_descriptor? callable (Map/get row :forwarder-namespace))
                         (sdk_declaration_descriptor? (Map/get row :declarations) (Map/get row :forwarder-namespace))
                         (= (MapSet/new (Map/keys (elem callable 2))) (MapSet/new (Map/keys (elem (Map/get row :declarations) 2)))))))
      (erlang/error :sdk_image_callable_metadata_changed))
    (when (and (Map/has_key? row :callable-kinds) (not= callable (Map/get row :callable-kinds)))
      (erlang/error :sdk_image_callable_metadata_changed))
    (when forwarder?
      (let [declarations (normalized_attribute attrs :bl_sdk_declarations)]
        (when-not (and (or (nil? declarations)
                          (sdk_declaration_descriptor? declarations (Map/get row :forwarder-namespace)))
                       (erlang/== declarations (Map/get row :declarations)))
          (erlang/error :sdk_image_declaration_metadata_changed)))
      (verify_sdk_forwarder! (tuple mod bytes) (Map/get row :forwarder-namespace) routes))
    (Map/merge row {:imports imports :forwarder-routes routes :callable-kinds callable
                    :lambda-routes (when (= :stable-body (Map/get row :role)) (sdk_lambda_routes! bytes))
                    :binding-routes (when forwarder? (sdk_binding_routes! mod bytes routes))})))

(defn- complete_image_sdk_closure! [root inventory]
  (let [manifest (BeamLisp.Bootstrap/manifest)
        seed (source_seed_inventory!)
        roots (Enum/reduce (code/all_loaded) (Map/keys seed)
                (fn [loaded out]
                  (let [mod (elem loaded 0)]
                    (if (Map/has_key? inventory (Atom/to_string mod)) (cons mod out) out))))
        result
    (loop [pending (erlang/++ (Map/keys (sdk_native_receipts)) roots)
           seen (MapSet/new) out (Map/merge seed (sdk_native_receipts))]
      (when (erlang/> (erlang/map_size out) 8192) (erlang/error :sdk_dependency_closure_too_large))
      (if (erlang/== pending (list)) out
        (let [mod (erlang/hd pending) rest (erlang/tl pending)]
          (if (MapSet/member? seen mod) (recur rest seen out)
            (let [row (or (Map/get out mod)
                        (let [identity (Atom/to_string mod) raw (Map/get inventory identity)]
                          (when raw (image_sdk_entry! root identity raw)))
                        (seed_dependency_from_manifest! mod manifest)
                        (sdk_source_dependency! mod))]
              (if-not row (recur rest (MapSet/put seen mod) out)
                (let [dependencies (Enum/uniq (erlang/++ (Map/get row :imports (list))
                                      (Map/values (Map/get row :forwarder-routes {}))))]
                  (recur (erlang/++ dependencies rest) (MapSet/put seen mod)
                         (Map/put out mod row)))))))))]
    (assert_sdk_seed_snapshot! manifest)
    result))

(defn sdk_runtime_inventory!
  "Attest only loaded SDK roots and their actual executable import closure.
   The image's complete provenance does not force unrelated units to load in
   development. Lazy SDK init refreshes the shared lease before effects."
  ([] (sdk_runtime_inventory! false))
  ([source-targets?]
  (let [root (physical_sdk_path (BeamLisp.Tiers/priv_root)) path (Path/join root "sdk-code.term")
        entries (if (File/exists? path) (complete_image_sdk_closure! root (inventory_term path))
                  (complete_source_sdk_closure!
                    (Map/merge (Map/merge (source_seed_inventory!) (source_sdk_receipts))
                               (sdk_native_receipts))))]
    (when (or (erlang/== 0 (erlang/map_size entries)) (erlang/> (erlang/map_size entries) 8192))
      (erlang/error :invalid_sdk_runtime_inventory_size))
    (Enum/each entries
      (fn [entry]
        (let [row (elem entry 1)]
          (when (erlang/== :native-host (Map/get row :role)) (sdk_native_dependency! (elem entry 0)))
          (when (erlang/== :mutable-forwarder (Map/get row :role))
            (Enum/each (Map/get row :forwarder-routes)
              (fn [route]
                (let [proof (Map/get entries (elem route 1))]
                  (when-not (and proof (Enum/member? (list :stable-body :stable-seed) (Map/get proof :role)))
                    (erlang/error :unproved_sdk_forwarder_target)))))))))
    (let [proof (Enum/reduce entries (tuple (Map/new) (Map/new) (Map/new))
      (fn [entry acc]
        (let [mod (elem entry 0) row (elem entry 1) source_name (Map/get row :source)
              seen (elem acc 1) source (when source_name (physical_sdk_path (Path/join root source_name)))
              forwarder? (erlang/== :mutable-forwarder (Map/get row :role))
              routes (Map/get row :forwarder-routes)]
          (when-not (and (erlang/is_atom mod)
                        (erlang/== (BeamLisp.AOTCache/compiler_key) (Map/get row :compiler-key))
                        (or (Map/get row :seed?)
                          (and source (String/starts_with? source (erlang/iolist_to_binary (list root "/")))
                            (erlang/== (Map/get row :source-digest)
                              (if (Map/has_key? seen source_name) (Map/get seen source_name)
                                (crypto/hash :sha256 (BeamLisp.Loader/read_source source)))))))
            (erlang/error :stale_sdk_runtime_inventory))
          (when-not (and (erlang/module_loaded mod)
                        (or (erlang/== (erlang/apply mod :module_info (list :md5)) (Map/get row :md5))
                          (and forwarder? (BeamLisp.Env/sdk_forwarder_current? mod routes))))
            (erlang/error :sdk_runtime_loaded_code_changed))
          (tuple (if forwarder? (elem acc 0) (Map/put (elem acc 0) mod (Map/get row :md5)))
                 (if source_name (Map/put seen source_name (Map/get row :source-digest)) seen)
                 (if forwarder?
                   (Map/put (elem acc 2) mod
                     {:namespace (Map/get row :forwarder-namespace) :routes routes :md5 (Map/get row :md5)})
                   (elem acc 2))))))]
     (if source-targets?
      (tuple (elem proof 0) (elem proof 1) (elem proof 2) (sdk_source_target_inventory! entries))
      proof)))))

(defn sdk_callable_evidence! [callback]
  (let [mod (erlang/element 2 (erlang/fun_info callback :module))
        name (erlang/element 2 (erlang/fun_info callback :name))
        arity (erlang/element 2 (erlang/fun_info callback :arity))
        proof (sdk_runtime_inventory!)
        stable (elem proof 0) forwarder (Map/get (elem proof 2) mod)]
    (when-not (or (Map/has_key? stable mod)
                 (and forwarder (Map/has_key? (Map/get forwarder :routes) (tuple name arity))))
      (erlang/error :unattested_sdk_callback))
    true))

(defn sdk_declaration_evidence!
  "Authenticate one SDK declaration against the running image inventory or
   compiler-owned source/cache emission evidence, including loaded executable
   bytes and exact namespace/name owner. Returns first-order evidence only.
   This neither binds an environment nor registers a process owner."
  [ns name mod]
  (when-not (and (erlang/is_binary ns) (erlang/is_binary name) (erlang/is_atom mod)
                (erlang/== mod (BeamLisp.Env/with_env :global
                                  (fn [] (BeamLisp.Server/module_for ns name)))))
    (erlang/error :invalid_sdk_declaration))
  (let [root (physical_sdk_path (BeamLisp.Tiers/priv_root))
        inventory_path (Path/join root "sdk-code.term") image? (File/exists? inventory_path)
        _ (when-not image? (ensure_source_sdk_evidence! ns mod))
        row (if image? (Map/get (inventory_term inventory_path) (Atom/to_string mod))
                (source_sdk_receipt mod))]
    (when-not (and row (erlang/== (tuple ns name) (Map/get row :declaration-owner))
                  (erlang/== (BeamLisp.AOTCache/compiler_key) (Map/get row :compiler-key)))
      (erlang/error :unattested_framework_declaration))
    (let [source (physical_sdk_path (Path/join root (Map/fetch! row :source)))]
      (when-not (and source (String/starts_with? source (erlang/iolist_to_binary (list root "/")))
                    (erlang/== (crypto/hash :sha256 (BeamLisp.Loader/read_source source))
                               (Map/get row :source-digest)))
        (erlang/error :stale_framework_source_evidence)))
    (when image?
      (let [path (Path/join (Path/dirname root)
                   (erlang/iolist_to_binary (list "ebin/" (Atom/to_string mod) ".beam")))]
        (when-not (erlang/== (crypto/hash :sha256 (File/read! path)) (Map/get row :sha256))
          (erlang/error :framework_artifact_changed))))
    (when-not (and (erlang/module_loaded mod)
                  (erlang/== (erlang/apply mod :module_info (list :md5)) (Map/get row :md5)))
      (erlang/error :framework_loaded_code_changed))
    {:module mod :namespace ns :name name :artifact row :image? image?}))

(defn sdk_class_evidence!
  "Resolve declaration ownership from compiler evidence for the actual init
   module. Loaded attributes are not evidence: an identical-executable replay
   may deliberately preserve older metadata while keeping the same BEAM MD5."
  [mod]
  (let [root (physical_sdk_path (BeamLisp.Tiers/priv_root)) path (Path/join root "sdk-code.term")
        row (if (File/exists? path) (Map/get (inventory_term path) (Atom/to_string mod))
                (source_sdk_receipt mod))
        owner (when row (Map/get row :declaration-owner))]
    (when-not (and (erlang/is_atom mod) (erlang/is_tuple owner)
                  (erlang/== 2 (erlang/tuple_size owner)) (erlang/== :actor (Map/get row :role)))
      (erlang/error :unattested_framework_declaration))
    (sdk_declaration_evidence! (elem owner 0) (elem owner 1) mod)))

(defn- generated_module_call? [node ns name]
  ;; Only the canonical compiler output that defines this EXACT server binding
  ;; is an actor declaration. A descriptor occurring in arbitrary literal data
  ;; is not executable provenance and must never become an inventory entry.
  (and (erlang/is_binary ns) (erlang/is_binary name)
       (erlang/is_map node) (erlang/== :remote (Map/get node :op))
       (erlang/== :Elixir.BeamLisp.Ns.Body.Lower (Map/get node :mod))
       (erlang/== :reload-descriptor! (Map/get node :fun))
       (let [args (Map/get node :args)]
         (and (erlang/is_list args) (erlang/== 1 (erlang/length args))
              (erlang/is_map (erlang/hd args))
              (erlang/== :lit (Map/get (erlang/hd args) :op))
              (let [descriptor (Map/get (erlang/hd args) :val)]
                (and (erlang/is_map descriptor)
                     (erlang/== :module (Map/get descriptor :op))
                     (erlang/== (BeamLisp.Server/module_for ns name)
                                (Map/get descriptor :name))))))))

(defn- generated_class_call? [node ns name]
  (and (erlang/is_map node) (erlang/== :remote (Map/get node :op))
       (erlang/== :Elixir.BeamLisp.Record (Map/get node :mod))
       (erlang/== :publish_declaration! (Map/get node :fun))
       (let [args (Map/get node :args)]
         (and (erlang/is_list args) (erlang/== 1 (erlang/length args))
              (erlang/is_map (erlang/hd args)) (erlang/== :lit (Map/get (erlang/hd args) :op))
              (BeamLisp.Record/declaration_kind (Map/get (erlang/hd args) :val) ns name)))))

(defn- generated_actor_create? [node]
 (and (erlang/is_map node) (erlang/== :remote (Map/get node :op))
      (erlang/== :Elixir.BeamLisp.Ns.Body.Lower (Map/get node :mod))
      (erlang/== :reload-descriptor! (Map/get node :fun))
      (let [arguments (Map/get node :args)]
       (and (erlang/is_list arguments) (erlang/== 1 (erlang/length arguments))
            (erlang/is_map (erlang/hd arguments))
            (erlang/== :lit (Map/get (erlang/hd arguments) :op))
            (let [descriptor (Map/get (erlang/hd arguments) :val)]
             (and (erlang/is_map descriptor) (erlang/== :module (Map/get descriptor :op))
                  (Enum/member? (Map/get descriptor :attrs (list)) [:behaviour (list :gen_server)])))))))

(defn- generated_server_owner [node ns]
 ;; Only this ENTIRE compiler-produced executable scaffold carries actor owner
 ;; provenance. The caller's value binding may be nil or merely an alias.
 (when (and (erlang/is_map node) (erlang/== :do (Map/get node :op))
            (erlang/is_list (Map/get node :stmts)) (erlang/> (erlang/length (Map/get node :stmts)) 0)
            (generated_actor_create? (erlang/hd (Map/get node :stmts))))
  (let [statements (Map/get node :stmts) intern (Enum/at statements 1) result (Enum/at statements 2)
        arguments (when (erlang/is_map intern) (Map/get intern :args))]
   (when-not (and (erlang/== 3 (erlang/length statements)) (erlang/is_map intern)
                  (erlang/== :remote (Map/get intern :op))
                  (erlang/== :Elixir.BeamLisp.Env (Map/get intern :mod))
                  (erlang/== :intern (Map/get intern :fun))
                  (erlang/is_list arguments) (erlang/== 3 (erlang/length arguments))
                  (Enum/all? arguments (fn [argument]
                    (and (erlang/is_map argument) (erlang/== :lit (Map/get argument :op))))))
    (erlang/error :invalid_generated_server_scaffold))
   (let [target (Map/get (Enum/at arguments 0) :val)
         name (Map/get (Enum/at arguments 1) :val)
         module (Map/get (Enum/at arguments 2) :val)]
    (when-not (and (erlang/== ns target) (erlang/is_binary name) (erlang/is_atom module)
                   (generated_module_call? (erlang/hd statements) ns name)
                   (erlang/== module (BeamLisp.Server/module_for ns name))
                   (erlang/is_map result) (erlang/== :lit (Map/get result :op))
                   (erlang/== module (Map/get result :val)))
     (erlang/error :invalid_generated_server_scaffold))
    name))))

(defn- generated_class_owner [node ns]
 (when (and (erlang/is_map node) (erlang/== :remote (Map/get node :op))
            (erlang/== :Elixir.BeamLisp.Record (Map/get node :mod))
            (erlang/== :publish_declaration! (Map/get node :fun)))
  (let [arguments (Map/get node :args)
        descriptor (when (and (erlang/is_list arguments) (erlang/== 1 (erlang/length arguments))
                              (erlang/is_map (erlang/hd arguments))
                              (erlang/== :lit (Map/get (erlang/hd arguments) :op)))
                     (Map/get (erlang/hd arguments) :val))
        metadata (when (erlang/is_map descriptor) (BeamLisp.Record/declaration_metadata descriptor))]
   (when-not (and (erlang/is_tuple metadata) (erlang/== 5 (erlang/tuple_size metadata))
                  (erlang/== ns (elem metadata 1)) (erlang/is_binary (elem metadata 2))
                  (generated_class_call? node ns (elem metadata 2)))
    (erlang/error :invalid_generated_class_owner))
   (elem metadata 2))))

(defn- prepare_generated_modules [node ns name attrs generated]
  (let [server-owner (generated_server_owner node ns)
        name (or (generated_class_owner node ns) name)]
  (cond
    server-owner
    (let [prepared (Enum/map_reduce (Map/get node :stmts) generated
                     (fn [child out] (prepare_generated_modules child ns server-owner attrs out)))]
      (tuple (Map/put node :stmts (elem prepared 0)) (elem prepared 1)))
    (or (generated_module_call? node ns name) (generated_class_call? node ns name))
    (let [class? (generated_class_call? node ns name)
          descriptor (Map/get (erlang/hd (Map/get node :args)) :val)
          descriptor (Map/update! descriptor :attrs
                       (fn [current]
                         (erlang/++ current
                           (Enum/map (erlang/++ attrs
                             (list (tuple :bl_declaration_owner (tuple ns name))
                                   (tuple (if class? :bl_generated_class_version :bl_generated_actor_version) 1)
                                   (tuple :bl_aot_artifact_role (if class? :generated-class :actor))))
                             (fn [entry] (BeamLisp.Vector/new (Tuple/to_list entry)))))))
          beam (BeamLisp.Emit/compile_descriptor descriptor)
          mod (elem beam 0) digest (elem (elem (beam_lib/md5 (elem beam 1)) 1) 1)
          prior (Map/get generated mod)]
      (when (and prior (erlang/not (erlang/== prior beam)))
        (erlang/error :conflicting_generated_declaration))
      (tuple
        (BeamLisp.Emit/remote (if class? :Elixir.BeamLisp.Record :Elixir.BeamLisp.AOT)
          (if class? :replay_declaration! :replay_generated_module!)
          (list (BeamLisp.Emit/lit descriptor) (BeamLisp.Emit/lit digest)))
        (Map/put generated mod beam)))
    (generated_actor_create? node) (erlang/error :unowned_generated_actor_scaffold)
    (and (erlang/is_map node)
         (or (erlang/== :lit (Map/get node :op)) (erlang/== :plit (Map/get node :pop))))
      (tuple node generated)
    (and (erlang/is_map node) (erlang/== :Elixir.BeamLisp.Vector (Map/get node :__struct__)))
      (let [prepared (Enum/map_reduce node generated
                       (fn [child out] (prepare_generated_modules child ns name attrs out)))]
        (tuple (BeamLisp.Vector/new (elem prepared 0)) (elem prepared 1)))
    (erlang/is_map node)
      (let [prepared (Enum/map_reduce node generated
                       (fn [entry out]
                         (let [child (if (erlang/== :ann (elem entry 0)) (tuple (elem entry 1) out)
                                      (prepare_generated_modules (elem entry 1) ns name attrs out))]
                           (tuple (tuple (elem entry 0) (elem child 0)) (elem child 1)))))]
        (tuple (Map/new (elem prepared 0)) (elem prepared 1)))
    (erlang/is_list node)
      (Enum/map_reduce node generated
        (fn [child out] (prepare_generated_modules child ns name attrs out)))
    (erlang/is_tuple node)
      (let [prepared (prepare_generated_modules (Tuple/to_list node) ns name attrs generated)]
        (tuple (List/to_tuple (elem prepared 0)) (elem prepared 1)))
    :else (tuple node generated))))

(defn replay_generated_module!
  "Replay an emitted actor declaration without code generation when its exact
   executable bytes are already loaded or available on the ordinary code path.
   A stale/missing artifact is rebuilt only from this companion's canonical
   descriptor; publication still uses the normal physical-module fences."
  [descriptor expected_md5]
  (let [mod (Map/fetch! descriptor :name)
        matches? (fn []
                   (and (erlang/module_loaded mod)
                        (erlang/== expected_md5 (erlang/apply mod :module_info (list :md5)))))]
    (when-not (matches?)
      (let [object (code/get_object_code mod)
            beam (if (and (erlang/is_tuple object) (erlang/== 3 (erlang/tuple_size object))
                          (erlang/== mod (elem object 0))
                          (erlang/== expected_md5 (elem (elem (beam_lib/md5 (elem object 1)) 1) 1)))
                   (tuple mod (elem object 1))
                   (BeamLisp.Emit/compile_descriptor descriptor))]
        (when-not (erlang/== expected_md5 (elem (elem (beam_lib/md5 (elem beam 1)) 1) 1))
          (erlang/error :generated_declaration_identity_changed))
        (BeamLisp.Env/publish_binaries! (list beam) "beam_lisp_aot/generated")))
    mod))

(defn- build_init_ast
  "`__bl_init__/0`'s clause and its value-initializer companion descriptor, as
   bl-ANF data."
  [ns mod ns_defs value_defs ns_meta unit_attrs declarations]
  (let [aliases (Map/get ns_meta :aliases (list))
        refers (Map/get ns_meta :refers (list))
        refer_alls (Map/get ns_meta :refer_alls (list))
        requires (Map/get ns_meta :requires (list))
        require_specs (Map/get ns_meta :require_specs nil)
        require_ops
        (if (nil? require_specs)
          (Enum/map requires
            (fn [t] (BeamLisp.Emit/remote :Elixir.BeamLisp.Loader :ensure_loaded
                      (list (BeamLisp.Emit/lit t)))))
          (Enum/map require_specs
            (fn [spec]
              (BeamLisp.Emit/remote :Elixir.BeamLisp.Loader :declare_require
                (Enum/map (Tuple/to_list spec) (fn [v] (BeamLisp.Emit/lit v)))))))
        ns_ops
        (erlang/++
          (erlang/++
            require_ops
            (Enum/map aliases
              (fn [pair]
                (BeamLisp.Emit/remote :Elixir.BeamLisp.Env :add_alias
                  (Enum/map (list ns (elem pair 0) (elem pair 1))
                            (fn [v] (BeamLisp.Emit/lit v)))))))
          (erlang/++
            (Enum/map refers
              (fn [pair]
                (BeamLisp.Emit/remote :Elixir.BeamLisp.Env :add_refer
                  (Enum/map (list ns (elem pair 0) (elem pair 1))
                            (fn [v] (BeamLisp.Emit/lit v))))))
            (Enum/map refer_alls
              (fn [t]
                (BeamLisp.Emit/remote :Elixir.BeamLisp.Env :add_refer_all
                  (list (BeamLisp.Emit/lit ns) (BeamLisp.Emit/lit t)))))))
        native_ops
        (let [d (or (Map/get ns_meta :native-declaration) (native_declaration ns))]
          (if (nil? d)
            (list)
            (list
              (BeamLisp.Emit/remote :Elixir.BeamLisp.Loader :ensure_loaded
                (list (BeamLisp.Emit/lit "vm.native")))
              (BeamLisp.Emit/remote :Elixir.BeamLisp.Ns.Vm.Native :declare
                (Enum/map (list ns (elem d 0) (elem d 1))
                          (fn [v] (BeamLisp.Emit/lit v)))))))
        fn_ops
        (Enum/flat_map ns_defs
          (fn [pair]
            (let [name (elem pair 0)
                  defs (elem pair 1)
                  fixed (Enum/map
                          (Enum/filter defs (fn [d] (erlang/== :fixed (elem d 0))))
                          (fn [d] (tuple (elem d 1) (elem d 2))))
                  variadic (Enum/find_value defs
                             (fn [d]
                               (if (erlang/== :variadic (elem d 0))
                                 (tuple (elem d 1) (elem d 2))
                                 nil)))
                  ops
                  (list
                    (BeamLisp.Emit/remote :Elixir.BeamLisp.Env :intern
                      (list (BeamLisp.Emit/lit ns) (BeamLisp.Emit/lit name)
                            (if (sdk_final_function? declarations ns name)
                             (BeamLisp.Emit/remote :maps :get
                               (list (BeamLisp.Emit/lit name)
                                     {:op :var :name "$sdk_callables" :ann {}}))
                             ;; Preserve the original preceding defn value for
                             ;; explicit final callable state such as (def f f).
                             ;; Value initializers then replay in source order.
                             (BeamLisp.Emit/remote :Elixir.BeamLisp.Emit :fn_value
                               (Enum/map (list mod fixed variadic) (fn [value] (BeamLisp.Emit/lit value)))))))
                    (BeamLisp.Emit/remote :Elixir.BeamLisp.Env :put_link
                      (Enum/map (list ns name (tuple mod (Map/new fixed) variadic))
                                (fn [v] (BeamLisp.Emit/lit v)))))
                  m (BeamLisp.Env/meta ns name)]
              (if (and (erlang/is_tuple m)
                       (erlang/== :ok (elem m 0))
                       (erlang/is_map (elem m 1))
                       (erlang/> (erlang/map_size (elem m 1)) 0))
                (erlang/++ ops
                  (list (BeamLisp.Emit/remote :Elixir.BeamLisp.Env :put_meta
                          (Enum/map (list ns name (elem m 1))
                                    (fn [v] (BeamLisp.Emit/lit v))))))
                ops))))
        compiler_env (BeamLisp.Compiler/new_env ns)
        generated (Map/new)
        values
        (Enum/map_reduce value_defs generated
          (fn [e generated]
            (let [name (elem e 0)
                  doc (elem e 1)
                  init_form (elem e 2)
                  per_env? (elem e 3)
                  ;; An unnamed operation is already-compiled initializer ANF
                  ;; emitted only by the compile-only SDK declaration collector.
                  ;; It replays in source order without inventing a var binding.
                  compiled (if (nil? name) init_form (compile_initializer init_form compiler_env))
                  prepared (prepare_generated_modules compiled ns name unit_attrs generated)
                  init_node (elem prepared 0)
                  register (cond
                             (nil? name) init_node
                             per_env? (BeamLisp.Emit/remote :Elixir.BeamLisp.Env :define_per_env
                               (list (BeamLisp.Emit/lit ns) (BeamLisp.Emit/lit name)
                                     (BeamLisp.Emit/closure init_node)))
                             :else (BeamLisp.Emit/remote :Elixir.BeamLisp.Env :intern
                               (list (BeamLisp.Emit/lit ns) (BeamLisp.Emit/lit name) init_node)))]
              (tuple
                (if doc
                  (list register
                        (BeamLisp.Emit/remote :Elixir.BeamLisp.Env :put_meta
                          (list (BeamLisp.Emit/lit ns) (BeamLisp.Emit/lit name)
                                (BeamLisp.Emit/lit {:doc doc}))))
                  (list register))
                (elem prepared 1)))))
        value_ops (Enum/flat_map (elem values 0) (fn [ops] ops))
        generated_beams (Enum/map (Enum/sort (Map/to_list (elem values 1)))
                          (fn [entry] (elem entry 1)))
        implicit_ops (implicit_require_ops ns ns_defs value_ops requires)
        init_mod (init_module_for ns)
        companion_descriptor
        (if (erlang/== (list) value_ops)
          nil
          (BeamLisp.Emit/descriptor_for init_mod
            (list (BeamLisp.Emit/function_clause :__bl_init_values__
                    (BeamLisp.Emit/sequence (erlang/++ value_ops (list (BeamLisp.Emit/lit :ok))))))
            (erlang/++ unit_attrs (list (tuple :bl_aot_artifact_role :initializer)))))
        value_call_ops (if companion_descriptor
                         (list (BeamLisp.Emit/remote init_mod :__bl_init_values__ (list)))
                         (list))
        ; Value initializers can define functions in this namespace. Their
        ; Link publication needs the canonical declarations before it replaces
        ; the shim; its resulting overlay must never be relinked afterward.
        table_ops (list (BeamLisp.Emit/remote :Elixir.BeamLisp.Env :link_ns_defs
                          (list (BeamLisp.Emit/lit ns) (BeamLisp.Emit/lit mod))))
        body (BeamLisp.Emit/sequence
               (erlang/++
                 (list (BeamLisp.Emit/remote :Elixir.BeamLisp.Loader :assert_initializer_execution_allowed!
                         (list (BeamLisp.Emit/lit ns))))
               (erlang/++
                 (erlang/++ (erlang/++ (erlang/++ (erlang/++ ns_ops implicit_ops) native_ops) fn_ops) table_ops)
                 (erlang/++ value_call_ops
                   (list (BeamLisp.Emit/remote :Elixir.BeamLisp.Env :mark_loaded
                           (list (BeamLisp.Emit/lit ns)))
                         (BeamLisp.Emit/lit :ok))))))]
    (tuple (BeamLisp.Emit/function_clause :__bl_init__
             (if (= 0 (erlang/map_size ns_defs)) body
              (BeamLisp.Emit/sequence
               (list (BeamLisp.Emit/remote :Elixir.BeamLisp.Loader :assert_initializer_execution_allowed!
                      (list (BeamLisp.Emit/lit ns)))
                 {:op :let :name "$sdk_callables"
                  :init (BeamLisp.Emit/remote (ns_body_module ns) :__bl_callable_values__ (list))
                  :body body :ann {}})))) companion_descriptor generated_beams)))

; ── the runtime-side hook and boot ──────────────────────────────────────────

(defn- init_loaded_module
  "Load a compatible AOT module into this VM: run its `__bl_init__/0` under the
   pinned `Loader.Server` and the `:global` env, then mark the namespace loaded.
   The `__bl_init__` replay is the ONLY source of a namespace's top-level
   effects on this path — the source was never evaluated — so it must run here."
  [ns mod]
  (BeamLisp.Loader/assert_initializer_execution_allowed! ns)
  (global/trans (tuple (tuple :bl_load mod) (erlang/self))
    (fn []
      (if (BeamLisp.Env/loaded_ns? ns)
        :loaded
        (do
          (BeamLisp.Loader.Server/run
            (fn []
              (BeamLisp.Env/with_env :global
                (fn []
                  (do
                    ;; Before the first SDK lifetime is admitted, core boot
                    ;; must initialize before source-closure tooling can use its
                    ;; definitions. First class preparation validates completed
                    ;; boot/compiler receipts before publishing the shared lease.
                    (when (ets/member :beam_lisp_vars :bl_sdk_runtime_lease)
                      (let [root (physical_sdk_path (BeamLisp.Tiers/priv_root))
                            source (physical_sdk_path (BeamLisp.Loader/source_path ns))]
                        (when (and root source
                                   (String/starts_with? source (erlang/iolist_to_binary (list root "/"))))
                          (if (File/exists? (Path/join root "sdk-code.term"))
                            ;; Existing SDK lifetime: extend BEFORE initializer
                            ;; effects, for image and ordinary cached source alike.
                            (BeamLisp.Env/refresh_sdk_runtime!)
                            (do (ensure_source_sdk_evidence! ns mod)
                                (BeamLisp.Env/refresh_sdk_runtime!))))))
                    (erlang/apply mod :__bl_init__ (list))
                    (BeamLisp.Env/mark_loaded ns))))))
          :loaded)))))

(defn ensure_loaded
  "Ensure namespace `ns` is usable in this VM: load its AOT module if a `.beam`
   exists on the code path, and run its `__bl_init__/0`. Idempotent.

   Two outcomes, unchanged: `:loaded` when the namespace is (now) usable, and
   `:no_module` when nothing can be served — the loader then falls back to
   interpreting the source. What CHANGED is what happens to a stale or missing
   `:library` artifact: it is repaired INSIDE this boundary (see
   `repair_library/1`) — compiled once from live source, published to the AOT
   cache under the live closure key, and loaded — so neither this VM nor the
   next interprets the same source again. Boot- and build-tier namespaces (the
   gating kernel among them) are never repaired; neither is anything while
   `AOTCache.enabled?` is false or `BEAM_LISP_AOT_REPAIR` is off; and strict
   mode refuses before any repair is attempted."
  [ns]
  :when (string? ns)
  (let [mod (BeamLisp.Link/module_for ns)]
    (if (and (Code/ensure_loaded? mod)
             (erlang/function_exported mod :__bl_init__ 0))
      (cond
        (BeamLisp.Env/loaded_ns? ns)
          :loaded

        (stale? ns mod)
          (repair_or_no_module ns)

        :else
          (init_loaded_module ns mod))
      (repair_or_no_module ns))))

; ── repairing a stale or missing library artifact ──────────────────────────
;
; A checkout whose `build/` image is a PREVIOUS toolchain's generation looks
; exactly like a healthy one to a boot-only health check: the ten boot
; namespaces are codegen and are re-stamped with the toolchain, but the library
; tier is not, so every library beam is judged stale and the loader interprets
; its source — on EVERY boot, forever, with no message. The measured shape of
; that degrade is ~144 interpreted namespaces and 16.9s of drift-gate closure
; hashing in one `bl version`, on a tree that has beams for all of them.
;
; The repair is deliberately the SAME three primitives the build uses —
; `AOT.compile_source`, `AOTCache.store/fetch`, `AOTCache.run_init_modules` — so
; a repaired artifact and a built one are interchangeable, and the cache
; address (`<compiler-key>/<closure-key>`) is the build's own. The two paths
; differ in one thing and it is the thing that must not be got wrong:
;
;   * a user with no artifact but no SOURCE (a packaged drop) is trusted, not
;     repaired — a nil closure hash means "nothing to compile from";
;   * a MISS takes the compiling path: `AOT.compile_source` EVALUATES the
;     source (that is what compiling means here), so the namespace is loaded by
;     that evaluation and `__bl_init__` must NOT be replayed afterwards — the
;     initializers already ran. Effects happen once;
;   * a HIT takes the linking path: the published beams are loaded from the
;     cache's own bytes and their `__bl_init__/0` IS replayed, because on this
;     path nothing evaluated the source. Effects still happen once per VM.
;
; The gate namespaces (`build-plan`, `source-graph`, `ns-interface`, the
; `priv/build/*` driver and `priv/boot/*` codegen) are `:build`/`:boot` tier and
; are therefore never repaired: computing a closure hash in order to compile
; the thing that computes closure hashes is the bootstrap circle. They fall
; back to source exactly as before, and `ns_closure_hash` can always finish.
;
; An unavailable repair falls back before evaluation. Once compiling or
; initializer replay starts, errors propagate; evaluating the source again
; would duplicate effects already performed by the failed attempt.

(defn- repair_enabled?
  "Whether the drift gate may repair a stale or missing library artifact. On by
   default; `AOTCache.enabled?` must ALSO be true, because a repair that cannot
   be published would be paid again on the next boot and its whole point is
   that it is paid once."
  []
  (if (BeamLisp.AOTCache/enabled?)
    (erlang/not (lists/member (System/get_env "BEAM_LISP_AOT_REPAIR") (list "off" "0" "false")))
    false))

(defn- library_tier?
  "Whether `ns` is an ordinary library namespace — the ONLY tier the repair
   touches. `:boot` is codegen and `:build` is the driver; both are needed to
   compute the verdict itself."
  [ns]
  (erlang/== :library (BeamLisp.Tiers/tier_of_ns ns)))

(defn- note_library_generation
  "ONE note, once per VM, the first time a LIBRARY beam is found to be another
   generation. Silence here was the actual defect: a 144-namespace source
   interpretation looked like a slow program, not a stale image."
  [ns]
  (let [key (tuple :Elixir.BeamLisp.AOT :library_generation_noted)]
    (if (erlang/== false (persistent_term/get key false))
      (do
        (persistent_term/put key true)
        (IO/puts :stderr
          (erlang/iolist_to_binary
            (list "bl: this image's library beams are a previous toolchain's generation (first seen: " ns ").")))
        (IO/puts :stderr
          "bl: stale libraries are compiled once and cached on first use; run `bl build` to rebuild the whole image."))
      nil)))

(defn- note_repair_failed
  "ONE note per namespace, naming the reason a repair degraded to source
   interpretation. Best-effort and never fatal."
  [ns reason]
  (let [key (tuple :Elixir.BeamLisp.AOT :repair_failed ns)]
    (if (erlang/== false (persistent_term/get key false))
      (do
        (persistent_term/put key true)
        (IO/puts :stderr
          (erlang/iolist_to_binary
            (list "bl: could not repair the artifact for " ns ": " (Kernel/inspect reason)
                  " — interpreting its source."))))
      nil)))

(defn- repair_link_dir
  "Where a cache FETCH links an entry's beams for this VM. Under the cache root
   (the entry's own generation directory's parent), so the link is a hardlink
   whenever the filesystem allows it, and cross-filesystem copies stay the
   fallback."
  [ns]
  (Path/join (Path/join (BeamLisp.AOTCache/dir) "repair")
             (erlang/iolist_to_binary (list (BeamLisp.AOTCache/compiler_key) "-" ns))))

(defn- load_cached_entry
  "Publish a fetched entry's beams into THIS VM and replay their initializers.
   The beams are loaded from the ENTRY's own bytes — not from the freshly linked
   copy, which a concurrent VM in this generation may be relinking, and not
   re-resolved from the code path, which still holds the STALE generation and
   would be served back by `Code.ensure_loaded/1`. An entry is immutable once
   published (`store/4` replaces it wholesale), so it is the stable source.
   Then `AOTCache.run_init_modules/2` replays each module's `__bl_init__/0`: this
   path never evaluated source, so the replay IS the namespace's top-level
   effect."
  [ns modules entry_dir link_dir]
  (let [beams (Enum/map modules
                (fn [m]
                  (let [name (erlang/iolist_to_binary (list (erlang/atom_to_binary m :utf8) ".beam"))]
                    (tuple (tuple m (File/read! (Path/join entry_dir name)))
                           (Path/join link_dir name)))))]
    (let [result (BeamLisp.Env/with_namespace_lock ns
                   (fn [] (BeamLisp.Env/with_publication ns
                     (fn []
                       (BeamLisp.Env/publish_binaries! beams)))))]
      (when (erlang/== :retired result) (erlang/error :scope_retired))))
  ; Initializers may execute accepted user effects. They remain outside the
  ; short native fence and are not cancellation-authorized by this admission.
  (register_cached_sdk_unit! ns modules entry_dir)
  (BeamLisp.AOTCache/run_init_modules modules link_dir))

(defn- compile_and_publish
  "Compile `ns` from `content` ONCE, publish the beams to the AOT cache under
   `closure_key`, and answer the module list. `AOT.compile_source` evaluates the
   source as it compiles it, so the caller must NOT replay `__bl_init__`
   afterwards."
  ([ns content closure_key path]
   (compile_and_publish ns content closure_key path closure_key))
  ([ns content closure_key path source_key]
  (if (staged_sdk_source? ns path)
    (do (compile_sdk_source! ns content path)
        (Map/get (source_sdk_receipt (BeamLisp.Emit/module_for ns)) :unit-references))
  (let [out (Path/join (Path/join (BeamLisp.AOTCache/dir) "repair")
                       (erlang/iolist_to_binary
                         (list (BeamLisp.AOTCache/compiler_key) "-" ns "-out-" (os/getpid) "-"
                               (Integer/to_string (System/unique_integer (list :positive))))))]
    (File/mkdir_p! out)
    (try
      (let [beams (compile_source content (list (tuple :file path) (tuple :output_dir out)
                                              (tuple :mark_loaded? true)))
            modules (Enum/map beams (fn [b] (elem b 0)))]
        ; Everything below is best-effort on purpose. `compile_source` has
        ; ALREADY evaluated the source, so the namespace is loaded whatever
        ; happens next, and a failure here must not send the loader down the
        ; source path to evaluate it a second time. `AOTCache.store/4` swallows
        ; its own failures, so a read-only or racing cache costs reuse, never
        ; correctness.
        (if (erlang/== modules (list))
          nil ; An action-only source has no initializer artifact to replay.
          (BeamLisp.AOTCache/store (BeamLisp.AOTCache/compiler_key) closure_key out modules source_key))
        modules)
      (finally (File/rm_rf out)))))))

(defn- repair_library
  "Repair a stale or missing LIBRARY artifact. Returns `:loaded` when the
   namespace is now usable, `:no_module` when no repair is possible (another
   tier, the cache off, or no source). Evaluation/replay failures propagate
   rather than re-running partially evaluated source."
  [ns]
  (cond
    (erlang/not (library_tier? ns)) :no_module
    (erlang/not (repair_enabled?)) :no_module
    :else
      (let [content (BeamLisp.Loader/source_content ns)]
        (if (erlang/== nil content)
          :no_module
          (let [path (BeamLisp.Loader/source_path ns)]
            (if (erlang/== nil path)
              :no_module
              (let [closure_key (ns_closure_hash ns)]
                (if (erlang/== nil closure_key)
                  :no_module
                  (let [link_dir (repair_link_dir ns)]
                    (global/trans (tuple (tuple :bl_aot_repair ns) (erlang/self))
                      (fn []
                        (if (BeamLisp.Env/loaded_ns? ns)
                          :loaded
                          (BeamLisp.Loader.Server/run
                            (fn []
                              (BeamLisp.Env/with_env :global
                                (fn []
                                  (let [r (let [hit (BeamLisp.AOTCache/fetch
                                                        (BeamLisp.AOTCache/compiler_key)
                                                        closure_key link_dir)]
                                              (if (erlang/== :miss hit)
                                                (do (compile_and_publish ns content closure_key path) :compiled)
                                                (do (load_cached_entry ns (elem hit 1)
                                                                       (BeamLisp.AOTCache/entry_dir
                                                                         (BeamLisp.AOTCache/compiler_key) closure_key)
                                                                       link_dir)
                                                    :reused)))]
                                    ; Once evaluation starts, failures propagate. Falling
                                    ; back to interpretation would repeat earlier effects.
                                    (do (BeamLisp.Env/mark_loaded ns) :loaded))))))))))))))))))

(defn- local_expression? [node names]
  (let [f (unmeta node)]
    (cond
      (reg2? f :list)
      (let [items (elem f 1) head (if (erlang/== (list) items) nil (bare_name (first items)))]
        (and head
             (or (lists/member head names)
                 (lists/member head (list "if" "do" "let" "fn" "quote" "+" "-" "*" "/" "=" "<" ">" "<=" ">="))
                 (String/contains? head "/"))
             ;; Only direct host calls have '/' admission; namespace aliases,
             ;; custom defining/body macros and computed calls keep source loading.
             (or (erlang/not (String/contains? head "/"))
                 (let [prefix (first (String/split head "/"))]
                   (or (Regex/match? (Regex/compile! "^[A-Z]") prefix)
                       (lists/member prefix (list "erlang" "maps" "lists" "crypto" "binary")))))
             (Enum/all? (erlang/tl items) (fn [x] (local_expression? x names)))))
      (or (reg2? f :vector) (reg2? f :map) (reg2? f :set))
      (Enum/all? (elem f 1) (fn [x] (local_expression? x names)))
      :else true)))

(defn- local_namespace_tree? [node]
  (let [f (unmeta node)]
    (cond
      (or (reg2? f :list) (reg2? f :vector) (reg2? f :map) (reg2? f :set))
        (Enum/all? (elem f 1) (fn [x] (local_namespace_tree? x)))
      (reg2? f :keyword)
        (erlang/not (lists/member (elem f 1) (list "refer" "refer-clojure" "use" "import")))
      (reg2? f :symbol)
        (erlang/not (Regex/match? (Regex/compile! "^[A-Z]") (elem f 1)))
      :else true)))

(defn- admission_head [node]
  (let [f (unmeta node)]
    (when (and (reg2? f :list) (erlang/not (erlang/== (list) (elem f 1))))
      (bare_name (first (elem f 1))))))

(defn- static_local_definers
  "Recognize literal zero-argument defining macros without executing expansion.
   Only a quoted single defn/def is admitted, only at top level. Unknown macro
   bodies/calls remain source-only; ordinary body macros are never guessed pure."
  [forms]
  (let [reserved (list "ns" "def" "defn" "defn-" "defmacro" "if" "do" "let" "fn" "quote"
                       "+" "-" "*" "/" "=" "<" ">" "<=" ">=")
        definitions (Enum/filter forms (fn [f] (erlang/== "defmacro" (admission_head (unmeta f)))))
        macros (Enum/reduce definitions (maps/new)
          (fn [node acc]
            (let [items (elem (unmeta node) 1) name (when (erlang/== 4 (erlang/length items))
                                                              (bare_name (second items)))
                  params (when name (unmeta (Enum/at items 2)))
                  body (when name (unmeta (Enum/at items 3)))
                  quoted (when (and (reg2? body :list) (erlang/== 2 (erlang/length (elem body 1)))
                                    (erlang/== "quote" (bare_name (first (elem body 1)))))
                           (second (elem body 1)))
                  head (when quoted (admission_head (unmeta quoted)))]
              (if (and name (erlang/not (lists/member name reserved))
                       (erlang/not (String/contains? name "/")) (erlang/not (maps/is_key name acc))
                       (reg2? params :vector) (erlang/== (list) (elem params 1))
                       (lists/member head (list "defn" "defn-" "def")))
                (maps/put name quoted acc)
                (erlang/error :unsupported_static_definer))))) ]
    (Enum/flat_map forms
      (fn [node]
        (let [f (unmeta node) head (admission_head f)]
          (cond
            (erlang/== head "defmacro") (list)
            (maps/is_key head macros)
              (if (erlang/== 1 (erlang/length (elem f 1))) (list (maps/get head macros))
                (erlang/error :unsupported_static_definer_call))
            :else (list node)))))))

(defn local_cacheable_source?
  "Automatic finite admission for lexical functions and replayable def values.
   Literal local zero-argument defining macros are structurally certified.
   Other macros, defining forms, aliases and arbitrary top-level effects retain
   source loading. This is intentionally smaller than the language."
  [source]
  (try
    (let [forms (static_local_definers (BeamLisp.Reader/read_all source))
          names (Enum/flat_map forms
                  (fn [node]
                    (let [f (unmeta node)]
                      (if (and (reg2? f :list) (erlang/>= (erlang/length (elem f 1)) 2)
                               (lists/member (bare_name (first (elem f 1))) (list "defn" "defn-")))
                        (list (bare_name (second (elem f 1)))) (list)))))]
      (and (erlang/not (erlang/== (list) names))
        (erlang/== 1 (Enum/count forms (fn [f] (erlang/not (erlang/== nil (ns_decl f))))))
        (Enum/all? forms
          (fn [node]
            (let [f (unmeta node)]
              (and (reg2? f :list) (erlang/>= (erlang/length (elem f 1)) 2)
                (let [items (elem f 1) head (bare_name (first items))]
                  (cond
                    (erlang/== head "ns") (local_namespace_tree? f)
                    (lists/member head (list "defn" "defn-" "def"))
                    (Enum/all? (Enum/drop items 2) (fn [x] (local_expression? x names)))
                    :else false))))))))
    (catch _ false)))

(defn- package_module_identity [module]
  (when (erlang/not (erlang/module_loaded module))
    (erlang/error (tuple :unloaded_package_compiler module)))
  (tuple module (erlang/apply module :module_info (list :md5))))

(defn- package_callable_module [module]
  ;; Core/Rt generated shims add exports as applications define functions.
  ;; Their fixed compiler-support captures target canonical body functions;
  ;; bind that implementation rather than unrelated shim export additions.
  ;; Arbitrary raw code:load_binary shim overrides are outside this contract.
  (cond
    (erlang/== module :Elixir.BeamLisp.Ns.Core) :Elixir.BeamLisp.Ns.Body.Core
    (erlang/== module :Elixir.BeamLisp.Ns.Rt) :Elixir.BeamLisp.Ns.Body.Rt
    :else module))

(defn- portable_package_terms
  ([values depth budget] (portable_package_terms values depth budget false))
  ([values depth budget rt-operator?]
  (let [result (Enum/reduce values (tuple (list) budget)
                 (fn [value acc]
                   (let [one (portable_package_value value depth (elem acc 1) rt-operator?)]
                     (tuple (erlang/++ (list (elem one 0)) (elem acc 0)) (elem one 1)))))]
    (tuple (Enum/reverse (elem result 0)) (elem result 1)))))

(defn- portable_package_value
  "Finite, unambiguous portable compiler evidence. Stage/user local closures,
   process identities and reference-backed values never become release authority.
   Only seeded Core operator evidence admits exact canonical RT local lambdas.
   Regex structs retain their exact compiled literal as well as source/options;
   source-only normalization could conceal a changed executable pattern."
  [value depth budget rt-operator?]
  (when (or (erlang/> depth 64) (erlang/=< budget 0))
    (erlang/error :package_compiler_value_bound))
  (let [remaining (erlang/- budget 1)]
    (cond
      (or (erlang/is_atom value) (erlang/is_integer value) (erlang/is_float value))
      (tuple (tuple :literal value) remaining)
      (erlang/is_binary value)
      (do (when (erlang/> (erlang/byte_size value) 1048576)
            (erlang/error :package_compiler_binary_bound))
          (tuple (tuple :literal value) remaining))
      (erlang/is_function value)
      (let [type (elem (erlang/fun_info value :type) 1)
            module (elem (erlang/fun_info value :module) 1)
            name (elem (erlang/fun_info value :name) 1)
            arity (elem (erlang/fun_info value :arity) 1)]
        (if (erlang/== :external type)
          (tuple (tuple :external_function (package_module_identity (package_callable_module module)) name arity) remaining)
          ;; RT seeds variadic arithmetic/comparison operators as local
          ;; closures, sometimes capturing another RT operator. This narrow
          ;; context binds their actual compiled lambda identity and recursively
          ;; portable environment; stage/user/local closures remain refused.
          (if (and rt-operator? (erlang/== :local type)
                   (erlang/== :Elixir.BeamLisp.Ns.Body.Rt module))
            (let [environment (elem (erlang/fun_info value :env) 1)
                  unique (elem (erlang/fun_info value :new_uniq) 1)
                  index (elem (erlang/fun_info value :new_index) 1)
                  normalized (portable_package_terms environment (erlang/+ depth 1) remaining true)]
              (when (erlang/not (and (erlang/is_binary unique) (erlang/== 16 (erlang/byte_size unique))
                                    (erlang/is_integer index) (erlang/>= index 0)))
                (erlang/error :invalid_rt_operator_identity))
              (tuple (tuple :rt_operator_closure (package_module_identity module)
                            name arity unique index (elem normalized 0)) (elem normalized 1)))
            (erlang/error :nonportable_package_compiler_closure))))
      (erlang/is_tuple value)
      (do (when (erlang/> (erlang/tuple_size value) 8192)
            (erlang/error :package_compiler_tuple_bound))
          (let [result (portable_package_terms (erlang/tuple_to_list value) (erlang/+ depth 1) remaining rt-operator?)]
            (tuple (tuple :tuple (elem result 0)) (elem result 1))))
      (erlang/is_list value)
      (let [result (portable_package_terms value (erlang/+ depth 1) remaining rt-operator?)]
        (tuple (tuple :list (elem result 0)) (elem result 1)))
      (erlang/is_map value)
      (do (when (erlang/> (erlang/map_size value) 8192)
            (erlang/error :package_compiler_map_bound))
          (let [result (portable_package_terms (maps/to_list value) (erlang/+ depth 1) remaining rt-operator?)
                ;; Binary term ordering distinguishes equal-valued integer/float
                ;; keys and does not depend on map traversal/insertion order.
                ordered (Enum/sort_by (elem result 0) (fn [pair] (erlang/term_to_binary pair)))]
            (tuple (tuple :map ordered) (elem result 1))))
      :else (erlang/error :nonportable_package_compiler_value))))

(defn- package_macro_value? [value]
  (and (erlang/is_tuple value) (erlang/== 2 (erlang/tuple_size value))
       (erlang/== :"$macro" (elem value 0))))

(defn- package_namespace_bindings [ns budget]
  (let [canonical (maps/keys (BeamLisp.Env/ns_defs ns))
        ;; Exact namespace value rows also include literal def constants, which
        ;; can alter code generation without rebuilding a forwarding shim.
        rows (BeamLisp.Env/match (tuple (tuple ns :"$1") :"$2"))
        _ (when (or (erlang/> (erlang/length canonical) 2048)
                    (erlang/> (erlang/length rows) 4096))
            (erlang/error :package_compiler_binding_bound))
        names (Enum/sort (Enum/uniq (erlang/++ canonical
                  (Enum/flat_map rows (fn [row]
                    (let [name (first row) value (second row)]
                      ;; Ordinary body macros are syntactically outside local
                      ;; AOT admission. Exclude only non-function-table macro
                      ;; bindings, never a replaced canonical function.
                      (if (and (erlang/is_binary name)
                               (or (erlang/not (package_macro_value? value))
                                   (lists/member name canonical)))
                        (list name) (list))))))))]
    (let [values (Enum/map names (fn [name]
                    (let [found (BeamLisp.Env/lookup (tuple ns name))]
                      (when (erlang/== :error found)
                        (erlang/error (tuple :missing_package_compiler_binding ns name)))
                      (tuple name (elem found 1)))))
          result (portable_package_terms values 0 budget)]
      (tuple (tuple ns (elem result 0)) (elem result 1)))))

(defn- package_body_module [ns]
  ;; Namespace dots delimit alias segments; camelizing the whole dotted string
  ;; changes the case of its final segment (notably clojure.core-ext).
  (Enum/reduce (String/split ns ".") :Elixir.BeamLisp.Ns.Body
    (fn [segment module] (Module/concat module (Macro/camelize segment)))))

(defn- package_support_index [names]
  ;; Only canonical boot namespaces are compiler support. Index function
  ;; identities, not complete Core/Rt tables or mutable shim export lists.
  (Enum/reduce names {:functions {} :definitions {} :modules {}}
    (fn [ns acc]
      (let [defs (BeamLisp.Env/ns_defs ns)
            body (package_body_module ns)
            shim (BeamLisp.Emit/base_module_for ns)]
        (when (erlang/> (erlang/map_size defs) 2048)
          (erlang/error :package_support_definition_bound))
        (Enum/reduce defs
          (assoc acc :modules (maps/put body ns (maps/put shim ns (:modules acc))))
          (fn [pair out]
            (let [name (elem pair 0) entries (elem pair 1) key (tuple ns name)]
              (when (erlang/not (erlang/is_list entries))
                (erlang/error :unsupported_package_support_definition))
              (Enum/reduce entries
                (assoc out :definitions (maps/put key entries (:definitions out)))
                (fn [entry result]
                  (when (erlang/not (and (erlang/is_tuple entry) (erlang/>= (erlang/tuple_size entry) 4)
                                        (erlang/is_map (elem entry 3))
                                        (erlang/== :defn-clause (maps/get :op (elem entry 3) nil))))
                    (erlang/error :unsupported_package_support_entry))
                  (let [fname (elem entry 2)]
                    (assoc result :functions
                      (maps/put (tuple body fname) key
                        (maps/put (tuple shim fname) key (:functions result))))))))))))))

(defn- package_support_enqueue [state key]
  (if (maps/is_key key (:seen state)) state
    (do
      (when (erlang/>= (erlang/map_size (:seen state)) 4096)
        (erlang/error :package_support_work_bound))
      (assoc state :seen (maps/put key true (:seen state))
                   :todo (erlang/++ (list key) (:todo state))))))

(defn- package_support_callable [state index module name]
  (let [key (maps/get (tuple module name) (:functions index) nil)
        ns (maps/get module (:modules index) nil)]
    (cond
      key (package_support_enqueue state key)
      ns (erlang/error (tuple :unknown_package_support_function ns name))
      ;; Unknown compiled namespace closures may hide arbitrary Env fetches.
      (String/starts_with? (Atom/to_string module) "Elixir.BeamLisp.Ns.")
        (erlang/error (tuple :unknown_package_support_namespace module name))
      :else state)))

(defn- package_support_captures [value state index depth]
  (when (or (erlang/> depth 64) (erlang/=< (:nodes state) 0))
    (erlang/error :package_support_walk_bound))
  (let [next (assoc state :nodes (erlang/- (:nodes state) 1))]
    (cond
      (erlang/is_function value)
        (let [module (elem (erlang/fun_info value :module) 1)
              name (elem (erlang/fun_info value :name) 1)
              type (elem (erlang/fun_info value :type) 1)]
          (if (erlang/== type :external)
            (package_support_callable next index module name)
            ;; Normalization has already restricted local closures to RT.
            (Enum/reduce (elem (erlang/fun_info value :env) 1)
              (package_support_enqueue
                (package_support_enqueue next (tuple "rt" "seed-closures"))
                (tuple "rt" "chain-of"))
              (fn [v acc] (package_support_captures v acc index (erlang/+ depth 1))))))
      (erlang/is_tuple value)
        (Enum/reduce (erlang/tuple_to_list value) next
          (fn [v acc] (package_support_captures v acc index (erlang/+ depth 1))))
      (erlang/is_list value)
        (Enum/reduce value next
          (fn [v acc] (package_support_captures v acc index (erlang/+ depth 1))))
      (erlang/is_map value)
        (Enum/reduce (maps/to_list value) next
          (fn [v acc] (package_support_captures v acc index (erlang/+ depth 1))))
      :else next)))

(defn- package_support_exact_candidates [ns name seen]
  (when (erlang/> (erlang/length seen) 64)
    (erlang/error :package_support_resolution_bound))
  (if (lists/member ns seen) {:pairs (list) :declarations (list) :names (list)}
    (let [declaration (BeamLisp.Env/lookup (tuple :refer ns name))
          source (if (erlang/== :error declaration) nil (elem declaration 1))
          tail (if source (package_support_exact_candidates source name (erlang/++ (list ns) seen))
                 {:pairs (list) :declarations (list) :names (list)})]
      {:pairs (erlang/++ (list (tuple ns name)) (:pairs tail))
       :declarations (erlang/++ (list (tuple ns name declaration)) (:declarations tail))
       :names (erlang/++ (list ns) (:names tail))})))

(defn- package_support_candidate_value [pairs]
  ;; Match fetch's env-first candidate precedence without materializing a
  ;; per-env descriptor or demand-loading an undeclared compiler dependency.
  (Enum/find_value (BeamLisp.Env/chain) :error
    (fn [env]
      (Enum/find_value pairs nil
        (fn [pair]
          (let [row (ets/lookup :beam_lisp_vars (BeamLisp.Env/pfx env pair))]
            (when (erlang/not (erlang/== (list) row))
              (tuple :ok (elem (erlang/hd row) 1)))))))))

(defn- package_support_resolution [ns name exact?]
  (if exact?
    (let [result (package_support_exact_candidates ns name (list))]
      (assoc result :found (package_support_candidate_value (:pairs result))))
    (let [parts (String/split name "/" (list (tuple :parts 2)))
          prefix (erlang/hd parts)
          alias (BeamLisp.Env/lookup (tuple :alias ns prefix))
          refer (BeamLisp.Env/lookup (tuple :refer ns name))
          names (if (and (erlang/== 2 (erlang/length parts)) (erlang/=/= "" prefix))
                  (list (if (erlang/== :error alias) prefix (elem alias 1)))
                  (erlang/++ (list ns "core" "sugar")
                    (if (erlang/== :error refer) (list) (list (elem refer 1)))))]
      {:found (BeamLisp.Env/peek ns name)
       :names (erlang/++ (list ns) names)
       :declarations (list alias refer)})))

(defn- package_support_global [node state index]
  (let [ns (maps/get :ns node) name (maps/get :name node)
        exact? (erlang/== :exact (maps/get :lookup node nil))
        key (tuple ns name exact?)]
    (if (maps/is_key key (:fetches state)) state
      (let [resolution (package_support_resolution ns name exact?)
            declarations (:declarations resolution)
            found (:found resolution)
            names (Enum/reduce (:names resolution) (:names state)
                    (fn [candidate acc]
                      (when (erlang/not (and (erlang/is_binary candidate)
                                            (erlang/=< (erlang/byte_size candidate) 512)))
                        (erlang/error :unsupported_package_support_namespace))
                      (when (erlang/>= (erlang/map_size acc) 128)
                        (erlang/error :package_support_namespace_bound))
                      (maps/put candidate true acc)))]
        (when (erlang/== :error found)
          (erlang/error (tuple :missing_package_support_value ns name)))
        (when (erlang/>= (erlang/map_size (:fetches state)) 8192)
          (erlang/error :package_support_fetch_bound))
        (let [evidence (portable_package_terms (list declarations found) 0 (:values state) true)
              next (assoc state :values (elem evidence 1) :names names
                         :fetches (maps/put key (elem evidence 0) (:fetches state)))]
          (package_support_captures (elem found 1) next index 0))))))

(defn- package_support_walk [node state index depth]
  (when (or (erlang/> depth 256) (erlang/=< (:nodes state) 0))
    (erlang/error :package_support_walk_bound))
  (let [next (assoc state :nodes (erlang/- (:nodes state) 1))]
    (cond
      ;; Quoted payloads and source annotations are data, not executable nodes.
      (and (erlang/is_map node)
        (or (erlang/== :lit (maps/get :op node nil))
            (erlang/== :plit (maps/get :pop node nil)))) next
      (erlang/is_map node)
        (let [with-global (if (erlang/== :global (maps/get :op node nil))
                            (package_support_global node next index) next)
              with-call (if (erlang/== :remote (maps/get :op node nil))
                          (package_support_callable with-global index (maps/get :mod node) (maps/get :fun node))
                          with-global)]
          (Enum/reduce (maps/values (maps/remove :ann node)) with-call
            (fn [v acc] (package_support_walk v acc index (erlang/+ depth 1)))))
      (erlang/is_list node)
        (Enum/reduce node next
          (fn [v acc] (package_support_walk v acc index (erlang/+ depth 1))))
      (erlang/is_tuple node)
        (Enum/reduce (erlang/tuple_to_list node) next
          (fn [v acc] (package_support_walk v acc index (erlang/+ depth 1))))
      :else next)))

(defn- package_support_drain [state index]
  (if (erlang/== (list) (:todo state)) state
    (let [key (erlang/hd (:todo state))
          entries (maps/get key (:definitions index) nil)]
      (when (erlang/== nil entries)
        (erlang/error :missing_package_support_definition))
      (let [ns (elem key 0)
            body (package_body_module ns)
            next (assoc state :todo (erlang/tl (:todo state))
                         :code (maps/put body (package_module_identity body) (:code state)))
            walked (Enum/reduce entries next
                     (fn [entry acc] (package_support_walk (elem entry 3) acc index 0)))]
        (package_support_drain walked index)))))

(defn- package_support_projection [stages names budget]
  (let [index (package_support_index names)
        initial {:todo (list) :seen {} :fetches {} :code {} :nodes 1000000 :values budget
                 :names (Map/new names (fn [ns] (tuple ns true)))}
        seeded (Enum/reduce stages initial
                 (fn [ns state]
                   (Enum/reduce (maps/keys (BeamLisp.Env/ns_defs ns)) state
                     (fn [name acc] (package_support_enqueue acc (tuple ns name))))))
        result (package_support_drain seeded index)]
    (tuple (tuple :compiler_support
                   (Enum/sort (maps/to_list (:fetches result)))
                   (Enum/sort (maps/to_list (:code result)))) (:values result)
           (Enum/sort (maps/keys (:names result))))))

(defn- package_authority_add_fingerprint [row acc]
  (let [module (elem row 0) md5 (elem row 1) old (maps/get module acc nil)]
    (when (and old (erlang/=/= old md5))
      (erlang/error :incoherent_package_compiler_code))
    (when (erlang/>= (erlang/map_size acc) 256)
      (erlang/error :package_compiler_module_bound))
    (maps/put module md5 acc)))

(defn- package_authority_capture_fingerprints [node acc]
  ;; Input is already normalized and bounded. Callable tags are generated by
  ;; the normalizer; literal tuples have a distinct :tuple wrapper.
  (cond
    (erlang/is_tuple node)
      (if (and (erlang/> (erlang/tuple_size node) 1)
               (or (erlang/== :external_function (elem node 0))
                   (erlang/== :rt_operator_closure (elem node 0))))
        (Enum/reduce (erlang/tuple_to_list node)
          (package_authority_add_fingerprint (elem node 1) acc)
          (fn [v out] (package_authority_capture_fingerprints v out)))
        (Enum/reduce (erlang/tuple_to_list node) acc
          (fn [v out] (package_authority_capture_fingerprints v out))))
    (erlang/is_list node)
      (Enum/reduce node acc (fn [v out] (package_authority_capture_fingerprints v out)))
    :else acc))

(defn- package_authority_fingerprints [code bindings operators support]
  (let [base (Enum/reduce code {} (fn [row out] (package_authority_add_fingerprint row out)))
        body (Enum/reduce (elem (elem support 0) 2) base
               (fn [row out] (package_authority_add_fingerprint (elem row 1) out)))
        all (package_authority_capture_fingerprints
              (tuple (elem bindings 0) (elem operators 0) (elem support 0)) body)]
    (Enum/sort (maps/to_list all))))

(defn- package_generation_projection [rows]
  ;; A live, empty fork adds no compiler definitions. Keep every global row
  ;; and every nonzero scoped generation; namespace_generations has already
  ;; refused dead scopes and in-flight publications before normalization.
  (when rows
    (Enum/filter rows (fn [row] (or (erlang/== :global (elem row 0))
                                  (erlang/not (erlang/== 0 (elem row 2))))))))

(defn- package_authority_memo_valid? [memo]
  (let [before (BeamLisp.Env/namespace_generations (:names memo))
             first-code (Enum/map (:fingerprints memo)
                          (fn [row] (package_module_identity (elem row 0))))
             after (BeamLisp.Env/namespace_generations (:names memo))
             last-code (Enum/map (:fingerprints memo)
                         (fn [row] (package_module_identity (elem row 0))))]
         (and before (erlang/== (package_generation_projection before) (:generations memo))
              (erlang/== before after)
              (erlang/== first-code (:fingerprints memo))
              (erlang/== first-code last-code))))

(defn local_package_authority
  "Portable compiler certificate with one bounded last-entry process memo.
   Hits bind exact closed namespace/lifetime and actual executable evidence;
   unrelated application initialization does not traverse compiler metadata."
  []
  (let [key (tuple (elem (erlang/fun_info (fn [] nil) :module) 1) :package_authority_memo)]
    (Process/delete :bl_package_authority_failure)
    (try
      (let [memo (Process/get key nil)
            hit (when memo
                  (BeamLisp.Env/with_module_locks
                    (Enum/map (:fingerprints memo) (fn [row] (elem row 0)))
                    (fn [] (when (package_authority_memo_valid? memo) (:authority memo)))))]
        (if hit (do (Process/put key (assoc memo :env (BeamLisp.Env/env_id))) hit)
          (do (Process/delete key)
            (let [fresh (uncached_package_authority)]
              (when fresh (Process/put key fresh) (:authority fresh))))))
      (catch _ (Process/delete key) nil))))

(defn local_package_authority_report
 "Explain a declined certificate without changing the admission contract."
 []
 (let [authority (local_package_authority)]
  (if authority {:authority authority}
    {:reason (Process/get :bl_package_authority_failure "unsupported scoped compiler context")})))

(defn- uncached_package_authority
  "Portable closed compiler authority for realm release artifacts. Bind actual
   callable/value definitions and installed code, not generation counters or
   mutable Core shim exports. Unsupported live overrides decline."
  []
  (try
    (let [names (list "core" "sugar" "rt" "compiler" "lower" "anf" "reader-node" "diag" "reader" "clojure.core-ext")
          epoch (BeamLisp.Env/publication_epoch)
          before (BeamLisp.Env/namespace_generations names)]
      (when (and before (Enum/all? before (fn [row]
                        (or (erlang/== :global (elem row 0)) (erlang/== 0 (elem row 2))))))
        (let [stages (list "sugar" "compiler" "lower" "anf")
              modules (Enum/flat_map stages (fn [n]
                        (list (BeamLisp.Emit/base_module_for n)
                              (package_body_module n))))
              pinned (erlang/++ (BeamLisp.AOTCache/codegen_modules)
                       (list :Elixir.BeamLisp.Compiler :Elixir.BeamLisp.Reader))
              code (Enum/map (Enum/sort (Enum/uniq (erlang/++ modules pinned)))
                     (fn [module] (package_module_identity module)))
              bindings (Enum/reduce stages (tuple (list) 100000)
                         (fn [n acc]
                           (let [result (package_namespace_bindings n (elem acc 1))]
                             (tuple (erlang/++ (elem acc 0) (list (elem result 0))) (elem result 1)))))
              operators (Enum/map (list "+" "-" "*" "/" "=" "<" ">" "<=" ">=")
                          (fn [n]
                            (let [found (BeamLisp.Env/lookup (tuple "core" n))
                                  link (BeamLisp.Env/link "core" n)]
                              (when (or (erlang/== :error found) (erlang/== :error link))
                                (erlang/error :missing_package_core_operator))
                              (tuple n (elem found 1) (elem link 1)))))
              normalized_ops (portable_package_terms operators 0 (elem bindings 1) true)
              support (package_support_projection stages names (elem normalized_ops 1))]
          (when (and (erlang/== epoch (BeamLisp.Env/publication_epoch))
                     (erlang/== before (BeamLisp.Env/namespace_generations names)))
            (let [authority (Base/encode16 (crypto/hash :sha256 (erlang/term_to_binary
                                (tuple :realm_package_compiler_v3 code (elem bindings 0) (elem normalized_ops 0) (elem support 0))))
                              (list (tuple :case :lower)))
                  fingerprints (package_authority_fingerprints code bindings normalized_ops support)
                  closed-names (elem support 2)
                  generations (BeamLisp.Env/namespace_generations closed-names)
                  memo {:env (BeamLisp.Env/env_id) :names closed-names :generations (package_generation_projection generations)
                        :projection_epoch epoch
                        :fingerprints fingerprints :authority authority}]
              ;; Metadata traversal takes namespace locks, so it stays outside
              ;; physical fences. Under fences only reread finite evidence.
              (BeamLisp.Env/with_module_locks (Enum/map fingerprints (fn [row] (elem row 0)))
                (fn []
                  (when (and generations (erlang/== epoch (BeamLisp.Env/publication_epoch))
                             (package_authority_memo_valid? memo))
                    memo))))))))
    (catch error
      (Process/put :bl_package_authority_failure (Elixir.Exception/message error)) nil)))

(defn- load_package_local
  [ns provider content]
  (when (or (erlang/not (local_cacheable_source? content))
            (erlang/not (erlang/== (maps/get :compiler-authority provider) (local_package_authority)))
            (erlang/not (erlang/== (maps/get :closure provider) (ns_closure_hash ns)))
            (erlang/not (erlang/== (maps/get :context provider) (BeamLisp.Loader/namespace_context ns))))
    (erlang/error (tuple :application_package_authority_changed ns)))
  (let [root (maps/get :ebin provider)
        modules (Enum/map (maps/get :modules provider) (fn [name] (String/to_atom name)))
        hashes (maps/get :beam-hashes provider)]
    ;; Publish exactly the bytes whose hashes were checked, without reopening
    ;; the filesystem between verification and physical module publication.
    (let [beams (Enum/map modules
      (fn [module]
        (let [name (erlang/iolist_to_binary (list (erlang/atom_to_binary module :utf8) ".beam"))
              path (Path/join root name) bytes (File/read! path)
              hash (Base/encode16 (crypto/hash :sha256 bytes) (list (tuple :case :lower)))]
          (when (erlang/not (erlang/== hash (maps/get name hashes)))
            (erlang/error (tuple :application_package_artifact_changed ns)))
          (tuple (tuple module bytes) path))))
          result (BeamLisp.Env/with_namespace_lock ns
                   (fn [] (BeamLisp.Env/with_publication ns
                     (fn [] (BeamLisp.Env/publish_binaries! beams)))))]
      (when (erlang/== :retired result) (erlang/error :scope_retired)))
    (BeamLisp.AOTCache/run_init_modules modules root)
    (BeamLisp.Env/mark_loaded ns)
    :loaded))

(defn ensure_loaded_local
  "Realm-local AOT fast path. Code bytes are keyed by compiler, closure and
   module home. Values/namespace bindings are replayed in TARGET, never global.
   Unsupported syntax or declared tier shadows decline BEFORE source effects."
  [ns target realm content path]
  (let [provider (BeamLisp.Loader/package_provider ns)]
   (if (and provider (maps/get :modules provider nil))
    (load_package_local ns provider content)
  (if (and (repair_enabled?) (local_cacheable_source? content)
           (Enum/empty? (maps/get :shadow (or (maps/get :decl realm nil) (maps/new)) (list))))
    (let [closure (ns_closure_hash ns)
          context (BeamLisp.Env/namespace_generations
                    (list "core" "sugar" "rt" "compiler" "lower" "anf"))
          context (if (and context
                         (Enum/all? context (fn [row]
                           (or (erlang/== :global (elem row 0)) (erlang/== 0 (elem row 2))))))
                    (Enum/filter context (fn [row] (erlang/== :global (elem row 0)))) nil)]
      (if (or (erlang/== nil closure) (erlang/== nil context)) :no_module
        (let [;; Own compiler overrides decline; global compiler generations and
              ;; the immutable realm identity participate in artifact selection.
              key (Base/encode16 (crypto/hash :sha256 (erlang/term_to_binary
                    (tuple :realm_aot_v1 (BeamLisp.Emit/module_for ns) realm context closure)))
                     (list (tuple :case :lower)))
              link_dir (Path/join (repair_link_dir ns) key)
              hit (BeamLisp.AOTCache/fetch (BeamLisp.AOTCache/compiler_key) key link_dir closure)]
          (if (erlang/== :miss hit)
            (compile_and_publish ns content key path closure)
            (load_cached_entry ns (elem hit 1)
              (BeamLisp.AOTCache/entry_dir (BeamLisp.AOTCache/compiler_key) key) link_dir))
          (BeamLisp.Env/mark_loaded ns)
          :loaded)))
    :no_module))))

(defn- repair_or_no_module
  "The gate's repair gatekeeper: try to repair a library artifact, else answer
   `:no_module` (the caller then interprets source, exactly as before)."
  [ns]
  (repair_library ns))

(defn boot
  "Start `BeamLisp.Env` if needed and seed `core` (idempotent).

   ONE DELIBERATE DIFFERENCE: the Elixir twin opened each start with a
   `{:ok, _} =` match, so a refused start raised a `MatchError` naming no
   process; this port raises a `RuntimeError` that NAMES the refusal. Both
   raise on the same condition, and neither path is reachable on a healthy
   boot (the process is started once, by the application, before any caller
   arrives) — but the class a `rescue` would read differs, so it is written
   down rather than hidden."
  []
  (if (erlang/== nil (Process/whereis :Elixir.BeamLisp.Env))
    (let [started (BeamLisp.Env/start_link (list))]
      (if (and (erlang/is_tuple started) (erlang/== :ok (elem started 0)))
        :ok
        (erlang/error
          (Elixir.RuntimeError/exception
            (erlang/iolist_to_binary
              (list "failed to start BeamLisp.Env: " (Kernel/inspect started)))))))
    :ok)
  (if (erlang/== nil (Process/whereis :Elixir.BeamLisp.Loader.Server))
    (do (BeamLisp.Loader.Server/start_link (list)) :ok)
    :ok)
  (BeamLisp/init)
  (maybe_load_core_backend)
  :ok)

(defn- maybe_load_core_backend
  "Canonical AOT has one backend. Loading `lower` also loads its `anf`
   dependency."
  []
  (BeamLisp.Loader/ensure_loaded "lower")
  :ok)

; ── source/emit key computation (the language's own `key-for`) ──────────────

(defn with_source_snapshot
  "Run `fun` with ONE source-content snapshot shared by every `ns_closure_hash`
   call inside it, so a pass that validates many namespaces reads and hashes
   each shared closure member ONCE instead of once per namespace. A snapshot IS
   a validation pass: an edit that lands mid-pass is not observed by that pass,
   and the next pass re-reads. Entries are keyed by RESOLUTION CONTEXT (the
   ambient search dirs the loader binds for the load) as well as by name, so a
   pass spanning two roots can never serve one project's bytes to the other's
   namespace.

   Without an open pass the cache is per CALL — one `ns_closure_hash` already
   dedups its own closure — and no correctness property depends on a caller
   taking a pass."
  [fun]
  (if (erlang/== nil (Process/get :bl_source_snapshot))
    (do
      (Process/put :bl_source_snapshot {})
      (let [previous (Process/get :bl_source_info_cache)
            previous-parts (Process/get :bl_source_parts_cache)]
        (Process/put :bl_source_parts_cache {})
        (try (fun)
          (finally
            (Process/delete :bl_source_snapshot)
            (if (erlang/== nil previous) (Process/delete :bl_source_info_cache)
              (Process/put :bl_source_info_cache previous))
            (if (erlang/== nil previous-parts) (Process/delete :bl_source_parts_cache)
              (Process/put :bl_source_parts_cache previous-parts))))))
    (fun)))

(defn ns_closure_hash
  "The per-namespace freshness hash (FEAT-030, tier-2): a digest over `ns` and
   the content of its transitive `:require` closure, resolved against the LIVE
   source path. `with_source_snapshot` shares the resolution across a pass;
   otherwise each call gets its own per-call cache."
  ([ns] :when (string? ns) (ns_closure_hash ns nil))
  ([ns file] :when (string? ns)
   (let [shared (Process/get :bl_source_snapshot)]
     (if (erlang/== nil shared)
       (let [previous-parts (Process/get :bl_source_parts_cache)]
         (Process/put :bl_source_info_cache {})
         (Process/put :bl_source_parts_cache {})
         (try (closure_hash_of ns file)
              (finally
               (Process/delete :bl_source_info_cache)
               (if (nil? previous-parts) (Process/delete :bl_source_parts_cache)
                (Process/put :bl_source_parts_cache previous-parts)))))
       (do
         ; A pass is open: ITS cache is this call's cache. Write the merged
         ; map back to the pass afterwards so the next member is shared.
         (Process/put :bl_source_info_cache shared)
         (try (closure_hash_of ns file)
              (finally (Process/put :bl_source_snapshot (Process/get :bl_source_info_cache {})))))))))

(defn- closure_hash_of
  "`ns_closure_hash`'s body, folded against whatever `:bl_source_info_cache`
   currently holds."
  [ns file]
  (let [seed (if (and file (File/exists? file))
               (list ns (BeamLisp.Loader/read_source file))
               nil)]
    ; Packaged runtimes carry beams without source. Answer before loading the
    ; planner: its own closure vetting would recurse into this gate.
    (if (and (nil? seed) (nil? (source_content_cached ns)))
      nil
      (BeamLisp.BuildPlan/key_for ns (fn [n] (source_content_cached n)) seed
        (fn [n content] (source_node_cached n content))))))

(defn- source_node_cached
 "Pure content-derived parsing memo scoped to this freshness validation pass.
  No mutable namespace Fn, planner initializer, ETS owner or disk cache exists
  on this path. Both memoized and uncached paths use the same pinned parser."
 [namespace content]
 (let [hash (crypto/hash :sha256 content)
       cache (Process/get :bl_source_parts_cache {})
       existing (Map/get cache hash)
       parts (or existing (BeamLisp.BuildPlan/content-parts content))]
  ;; Saturating this optimization only stops insertion, never changes the key.
  (when (and (nil? existing) (< (erlang/map_size cache) 8192))
   (Process/put :bl_source_parts_cache (Map/put cache hash parts)))
  (BeamLisp.BuildPlan/assemble namespace parts)))

(defn- source_content_cached
  "Resolve a namespace's source CONTENT at most once per key computation —
   and, inside a validation pass, at most once for the whole pass per
   RESOLUTION CONTEXT. The context is the ambient search dirs the loader has
   bound, together with the current environment and package provider. The same
   name cannot reuse an absent/live result after provider installation, or use
   another environment's immutable source fallback."
  [ns]
  (let [key (tuple (BeamLisp.Env/env_id) (Process/get :bl_search_dirs nil) ns
                   (BeamLisp.Loader/package_provider ns))
        cache (Process/get :bl_source_info_cache {})]
    (if (erlang/is_map_key key cache)
      (Map/get cache key)
      (let [v (BeamLisp.Loader/source_content ns)]
        (Process/put :bl_source_info_cache (Map/put cache key v))
        v))))

; ── the drift gate ──────────────────────────────────────────────────────────

(defn- stale?
  "Whether a compiled beam no longer matches the source it was built from."
  [ns mod]
  (if (lists/member ns (staging_namespaces))
    (do (note_mixed_generation) false)
    (stale_by_provenance? ns mod)))

(defn- staging_namespaces
  "The namespaces the committed seed installed as a previous-generation
   bootstrap stage."
  []
  (let [v (Application/get_env :beam_lisp :bootstrap_staging nil)]
    (if (erlang/is_list v) v (list))))

(defn- note_mixed_generation
  "ONE note, once per VM, and only when the staged floor really is another
   generation."
  []
  (let [key (tuple :Elixir.BeamLisp.AOT :mixed_generation_noted)]
    (if (and (erlang/== false (persistent_term/get key false))
             (erlang/not (erlang/== (list) (BeamLisp.Tiers/boot_namespaces)))
             (erlang/not (erlang/== nil (BeamLisp.Bootstrap/manifest)))
             (erlang/not (BeamLisp.Bootstrap/key_matches? (BeamLisp.Bootstrap/manifest))))
      (do
        (persistent_term/put key true)
        (IO/puts :stderr "bl: the boot tier has MOVED; this VM is running it from the committed floor.")
        (IO/puts :stderr "bl: that floor is a previous generation of priv/boot/, so a primitive")
        (IO/puts :stderr "bl: added since then fails with an undefined var naming a file not at fault.")
        (IO/puts :stderr "bl: rebuild the tier as a unit:  bl build && bl seed"))
      nil)))

(defn- tier_key_moved?
  "Has the namespace's TIER key moved since its beam was stamped?"
  [tier beam_key]
  (cond
    (erlang/== :boot tier)
      (and (erlang/not (erlang/== (list) (BeamLisp.Tiers/boot_namespaces)))
           (erlang/=/= beam_key (BeamLisp.AOTCache/compiler_key)))

    (erlang/== :build tier)
      (and (erlang/not (erlang/== (list) (BeamLisp.Tiers/build_namespaces)))
           (erlang/=/= beam_key (BeamLisp.AOTCache/build_key)))

    :else
      (erlang/error
        (Elixir.FunctionClauseError/exception
          (list (erlang/list_to_tuple (list :module :Elixir.BeamLisp.AOT))
                (erlang/list_to_tuple (list :function :tier_key_moved?))
                (erlang/list_to_tuple (list :arity 2)))))))

(defn- stale_by_provenance?
  "Compare a beam's `__bl_provenance__/0` stamp against the LIVE source.

   GENERATION FIRST. The tier key is a memoized read; the source hash walks and
   hashes the namespace's WHOLE require-closure. So the cheap comparison decides
   first: a beam whose generation is not this VM's is stale whatever its source
   hashes say, and the closure hash is never computed for it — the gate stops
   paying its closure-hashing cost to answer a question the key already
   answered. A compatible generation keeps live source drift detection, and
   with it the dependency correctness that was always the point of the hash."
  [ns mod]
  (let [p (beam_provenance mod)]
    (if (erlang/== nil p)
      ;; A stamped namespace without the current replay-format witness may
      ;; have been emitted by an old pinned host under today's live key.
      ;; Source-present images can repair it; legacy unstamped host modules
      ;; retain their existing contract.
      (and (erlang/function_exported mod :__bl_provenance__ 0)
           (erlang/function_exported mod :__bl_ns_defs__ 0)
           (erlang/not (erlang/== nil (BeamLisp.Loader/source_path ns))))
      (let [beam_hash (elem p 0)
            beam_key (elem p 1)
            tier (BeamLisp.Tiers/tier_of_ns ns)]
        (if (erlang/== :library tier)
          (let [live_key (BeamLisp.AOTCache/compiler_key)]
            (if (erlang/=/= beam_key live_key)
              (if (nil? (BeamLisp.Loader/source_path ns))
                false ; A sourceless image cannot repair; preserve packaged trust.
                (if (strict_aot?)
                  (erlang/error (Elixir.RuntimeError/exception
                                  (generation_stale_error ns mod beam_key live_key)))
                  (do (note_library_generation ns) true)))
              (let [src_hash (ns_closure_hash ns)]
                (cond
                  (erlang/== nil src_hash) false
                  (erlang/== beam_hash src_hash) false
                  (strict_aot?) (erlang/error (Elixir.RuntimeError/exception
                                                (stale_beam_error ns mod beam_hash src_hash)))
                  :else true))))
          (tier_key_moved? tier beam_key))))))

(defn beam_provenance
  "The `{hash, key}` provenance of a module's beam, or nil when it carries none.
   PUBLIC because the LAUNCHER asks it of every boot namespace, on a previous
   generation's beams, before the language exists."
  [mod]
  (if (and (Code/ensure_loaded? mod)
           (erlang/function_exported mod :__bl_provenance__ 0)
           (or (erlang/not (erlang/function_exported mod :__bl_ns_defs__ 0))
               (let [version (Keyword/get (erlang/apply mod :module_info (list :attributes))
                                           :bl_aot_replay_version)]
                 (or (erlang/== version 1) (erlang/== version (list 1))))))
    (let [p (erlang/apply mod :__bl_provenance__ (list))]
      (cond
        (and (erlang/is_tuple p)
             (erlang/== 2 (erlang/tuple_size p))
             (erlang/== nil (erlang/element 1 p))) nil
        (and (erlang/is_tuple p) (erlang/== 2 (erlang/tuple_size p))) p
        :else nil))
    nil))

(defn- strict_aot?
  "Whether the drift gate must REFUSE LOUD instead of falling back to source."
  []
  (lists/member (System/get_env "BEAM_LISP_AOT_STRICT") (list "1" "true")))

(defn- generation_stale_error
  "The message a STRICT gate raises for a compiler-generation mismatch. It is
   its own message because the old wording was actively misleading: the source
   hashes can be IDENTICAL (the source did not move — the toolchain did), and
   the recovery named a Mix task this tree no longer has. The live recovery is
   the build."
  [ns mod beam_key live_key]
  (erlang/iolist_to_binary
    (list "stale AOT beam for " ns " (" (Kernel/inspect mod) "): compiled by toolchain "
          (short beam_key) ", this VM runs " (short live_key) ". "
          "The source may be unchanged — the TOOLCHAIN moved, so the beam cannot be "
          "linked into this VM. Rebuild the image: `bl build`.")))

(defn- stale_beam_error
  "The message a STRICT gate raises for SOURCE drift: the beam's bytes are older
   than the live source's, so the two hashes are what actually differ."
  [ns mod beam_hash src_hash]
  (erlang/iolist_to_binary
    (list "stale AOT beam for " ns " (" (Kernel/inspect mod) "): compiled from source "
          (short beam_hash) ", the current source hashes " (short src_hash) ". "
          "Rebuild the image: `bl build`.")))

(defn- short
  "The first twelve characters of a digest, or `<none>`."
  [h]
  (if (nil? h) "<none>" (String/slice h 0 12)))

(defn default_output_dir
  "The output directory a build defaults to: the Mix project's compile path when
   a Mix project is loaded, else an error naming what to pass instead."
  []
  (if (and (Code/ensure_loaded? :Elixir.Mix)
           (erlang/function_exported :Elixir.Mix.Project :compile_path 0))
    (erlang/apply :Elixir.Mix.Project :compile_path (list))
    (erlang/error
      (Elixir.ArgumentError/exception
        "BeamLisp.AOT needs an :output_dir (no Mix project loaded to default to compile_path)"))))


(defn sdk_unit_compiled? [ns]
  (let [root (physical_sdk_path (BeamLisp.Tiers/priv_root))
        source (physical_sdk_path (BeamLisp.Loader/source_path ns))
        shim (BeamLisp.Emit/module_for ns) row (sdk_compiler_row shim)
        members (when row
                  (Enum/map (Map/get row :unit-references (list))
                    (fn [member]
                      (if (erlang/is_binary member) (String/to_existing_atom member) member))))]
    (and root source row (erlang/is_list members) (erlang/=< 0 (erlang/length members))
         (erlang/=< (erlang/length members) 8192)
         (String/starts_with? source (erlang/iolist_to_binary (list root "/")))
         (erlang/== ns (BeamLisp.Loader/declared_ns (BeamLisp.Loader/read_source source)))
         (erlang/== :mutable-forwarder (Map/get row :role))
         (erlang/== ns (Map/get row :forwarder-namespace))
         (erlang/== (Path/relative_to source root) (Map/get row :source))
         (erlang/== (crypto/hash :sha256 (BeamLisp.Loader/read_source source)) (Map/get row :source-digest))
         (erlang/== (BeamLisp.AOTCache/compiler_key) (Map/get row :compiler-key))
         (Enum/all? (cons shim members)
           (fn [mod]
             (let [member (sdk_compiler_row mod)]
               (and member (erlang/module_loaded mod)
                    (erlang/== (Map/get row :source) (Map/get member :source))
                    (erlang/== (Map/get row :source-digest) (Map/get member :source-digest))
                    (erlang/== (Map/get row :compiler-key) (Map/get member :compiler-key))
                    (erlang/== (Map/get member :md5) (erlang/apply mod :module_info (list :md5))))))))))

(defn- sdk_declaration_descriptor? [descriptor ns]
  (and (erlang/is_binary ns) (<= 1 (erlang/byte_size ns)) (<= (erlang/byte_size ns) 512)
       (erlang/is_tuple descriptor) (= 3 (erlang/tuple_size descriptor))
       (= 1 (elem descriptor 0)) (= ns (elem descriptor 1))
       (erlang/is_map (elem descriptor 2)) (<= (erlang/map_size (elem descriptor 2)) 8192)
       (Enum/all? (elem descriptor 2)
         (fn [entry] (and (erlang/is_binary (elem entry 0))
                          (<= 1 (erlang/byte_size (elem entry 0)))
                          (<= (erlang/byte_size (elem entry 0)) 512)
                          (contains? #{:public :private :value :macro :unavailable} (elem entry 1)))))))

(defn- sdk_callable_descriptor? [descriptor ns]
 (and (erlang/is_tuple descriptor) (= 3 (erlang/tuple_size descriptor))
      (= 1 (elem descriptor 0)) (= ns (elem descriptor 1))
      (erlang/is_map (elem descriptor 2)) (<= (erlang/map_size (elem descriptor 2)) 8192)
      (Enum/all? (elem descriptor 2)
       (fn [entry] (and (erlang/is_binary (elem entry 0)) (<= 1 (erlang/byte_size (elem entry 0)) 512)
                        (contains? #{:function :value :macro :class :unavailable} (elem entry 1)))))))

(defn sdk_declaration_kind
  "Privacy from an actual complete, current compiler-owned SDK unit. A body
   table, alias spelling, missing descriptor or arbitrary cache attribute is
   never evidence that a generated binding is public. Does not initialize."
  [ns binding]
  (let [pass (Process/get :bl_declaration_snapshot_id)
        context (when pass (BeamLisp.Loader/declaration_source_context ns))
        before (sdk_declaration_query_certificate ns pass context)
        cache (Process/get :bl_sdk_declaration_query_memo {})
        hit (Map/get cache ns)
        reusable? (and pass before hit (= before (elem hit 0))
                       (or (nil? (elem hit 1))
                           (= (elem hit 1) (BeamLisp.Loader/declaration_source_identity ns))))
        descriptor (if reusable? (elem hit 2) (sdk_checked_declaration_table ns))
        source (when (and pass (erlang/is_tuple descriptor))
                 (BeamLisp.Loader/declaration_source_identity ns))
        after (sdk_declaration_query_certificate ns pass context)]
    (if (and before (= before after))
      (do
        (when pass
          (Process/put :bl_sdk_declaration_query_memo
            (Map/put (if (< (erlang/map_size cache) 256) cache {}) ns (tuple before source descriptor))))
        (cond (= :unavailable descriptor) :unavailable
              descriptor (Map/get (elem descriptor 2) binding)
              :else nil))
      ;; This is denial-only status, never public/private declaration authority.
      ;; An in-flight or changed staged unit cannot fall through to an interned
      ;; server value whose historical runtime metadata omits ^:private.
      (when descriptor :unavailable))))

(defn- sdk_declaration_query_certificate [ns pass context]
  ;; Constant-size native publication evidence and actual resolver context.
  ;; A positive memo separately retains/rechecks its Source snapshot identity.
  ;; Raw host code-server interop remains outside generated-code publication.
  (let [code (BeamLisp.Env/code_evidence_generation)
        definitions (BeamLisp.Env/namespace_generations (list ns))]
    (when (and code definitions)
      (tuple pass context (BeamLisp.Env/env_id) code definitions))))

(defn- sdk_checked_declaration_table [ns]
  (let [row (sdk_compiler_row (BeamLisp.Emit/module_for ns))
        descriptor (when row (Map/get row :declarations))]
    ;; Ordinary/application providers with no staged descriptor do not require
    ;; source parsing, byte hashing or a full unit walk merely for this query.
    (when (sdk_declaration_descriptor? descriptor ns)
      (let [source (when (Process/get :bl_declaration_snapshot_id)
                     (BeamLisp.Loader/declaration_source_identity ns))
            root (physical_sdk_path (BeamLisp.Tiers/priv_root))]
        (if (and (or (nil? (Process/get :bl_declaration_snapshot_id))
                     (and source (= (Map/get row :source-digest) (elem source 1))
                          (= (Map/get row :source)
                             (Path/relative_to (physical_sdk_path (elem source 0)) root))))
                 (sdk_unit_compiled? ns)) descriptor :unavailable)))))

(defn- sdk_callable_kind [head]
 (cond (contains? #{"defn" "defn-"} head) :function
       (= "defmacro" head) :macro (= "def" head) :value
       (contains? #{"defrecord" "deftype" "defserver"} head) :class
       :else :unavailable))
(defn record_normal_declaration!
 "Bookkeeping from an actually committed checked normal-producer declaration."
 ([token ns bindings kind] (record_normal_declaration! token ns bindings kind nil))
 ([token ns bindings kind head]
  (let [collector (Process/get :bl_definition_collector)]
   (when (and (erlang/is_integer token) collector (= token (Map/get collector :declaration-token))
              (= (BeamLisp.Env/env_id) (Map/get collector :env))
              (= ns (BeamLisp.Env/current_ns))
              (MapSet/member? (Map/get collector :declaration-namespaces (MapSet/new)) ns))
    (let [declarations (Map/get collector :declarations {}) previous (Map/get declarations ns {})
          kinds (Map/get declarations :callable-kinds {}) prior-kinds (Map/get kinds ns {})]
     (Process/put :bl_definition_collector
      (Map/put collector :declarations
       (Map/put (Map/put declarations ns
                  (Enum/reduce bindings previous (fn [binding out] (Map/put out binding kind))))
        :callable-kinds (Map/put kinds ns (Enum/reduce bindings prior-kinds
          (fn [binding out] (Map/put out binding (sdk_callable_kind head))))))))))) :ok))

(defn compile_sdk_source! [ns content path]
  ;; Ordinary source-mode loading under a retained fixed SDK uses exactly the
  ;; same staged producer as import-closure discovery, then ordinary replay.
  (let [root (physical_sdk_path (BeamLisp.Tiers/priv_root)) source (physical_sdk_path path)]
    (when-not (and (erlang/== :global (BeamLisp.Env/env_id)) root source
                   (String/starts_with? source (erlang/iolist_to_binary (list root "/")))
                   (erlang/== content (BeamLisp.Loader/read_source source))
                   (erlang/== ns (BeamLisp.Loader/declared_ns content)))
      (erlang/error (tuple :sdk_source_stage_input_mismatch ns path)))
    (when-not (sdk_unit_compiled? ns)
      (stage_sdk_dependency! ns source (BeamLisp.Emit/module_for ns)))
    (BeamLisp.Env/refresh_sdk_runtime!)
    (init_loaded_module ns (BeamLisp.Emit/module_for ns))))

(defn staged_sdk_source? [ns path]
  (let [root (physical_sdk_path (BeamLisp.Tiers/priv_root)) source (physical_sdk_path path)]
    (and (ets/member :beam_lisp_vars :bl_sdk_runtime_lease)
         (erlang/== :global (BeamLisp.Env/env_id)) root source
         (String/starts_with? source (erlang/iolist_to_binary (list root "/")))
         (erlang/== ns (BeamLisp.Loader/declared_ns (BeamLisp.Loader/read_source source))))))

(defn- stage-refuse [kind] (throw (ex-info "SDK declaration staging refused" {:kind kind})))
(defn- stage-tag? [node tag size]
 (and (erlang/is_tuple node) (= size (erlang/tuple_size node)) (= tag (elem node 0))))
(defn- stage-unmeta [node]
 (if (stage-tag? node :meta 3) (stage-unmeta (elem node 1)) node))
(defn- stage-symbol [node]
 (let [node (stage-unmeta node)]
  (when-not (stage-tag? node :symbol 2) (stage-refuse :unsupported-sdk-stage-symbol))
  (elem node 1)))
(defn- stage-items [node tag]
 (let [node (stage-unmeta node)]
  (when-not (stage-tag? node tag 2) (stage-refuse :unsupported-sdk-stage-form))
  (elem node 1)))
(defn- stage-scalar? [node]
 (let [node (stage-unmeta node)]
  (or (nil? node) (= true node) (= false node) (erlang/is_integer node)
      (erlang/is_float node) (erlang/is_binary node) (stage-tag? node :keyword 2))))
(defn- stage-head [node]
 (stage-symbol (first (stage-items node :list))))
(defn- stage-requires [form]
 (let [items (stage-items form :list)]
  (when-not (= "ns" (stage-symbol (first items))) (stage-refuse :sdk-stage-namespace-required))
  (let [ns (stage-symbol (second items))
        metadata (Map/get (capture_ns_decl {} form) ns)
        clauses (rest (rest items))]
   ;; Reuse the ordinary compiler's complete require metadata. Validation below
   ;; rejects unknown clauses/options rather than silently skipping their effects.
   (doseq [clause clauses]
    (when-not (erlang/is_binary (stage-unmeta clause))
     (let [parts (stage-items clause :list) head (stage-unmeta (first parts))]
      (when-not (and (stage-tag? head :keyword 2) (= "require" (elem head 1)))
       (stage-refuse :unsupported-sdk-stage-namespace-clause))
      (doseq [spec (rest parts)]
       (let [spec (stage-unmeta spec)]
        (if (stage-tag? spec :symbol 2) (stage-symbol spec)
         (let [parts (stage-items spec :vector)]
          (stage-symbol (first parts))
          (loop [flags (rest parts) seen #{}]
           (when (seq flags)
            (let [key (stage-unmeta (first flags)) value (second flags)]
             (when-not (and (stage-tag? key :keyword 2) (contains? #{"as" "refer"} (elem key 1))
                            (not (contains? seen (elem key 1))) (seq (rest flags)))
              (stage-refuse :unsupported-sdk-stage-require))
             (if (= "as" (elem key 1)) (stage-symbol value)
              (if (= (tuple :keyword "all") (stage-unmeta value)) nil
               (doseq [symbol (stage-items value :vector)] (stage-symbol symbol))))
             (recur (rest (rest flags)) (conj seen (elem key 1)))))))))))))
   {:ns ns :requires (Map/get metadata :requires (list)) :metadata metadata})))
(defn- stage-native [form]
 (let [items (stage-items form :list) crate (stage-unmeta (second items))
       signatures (mapv (fn [signature]
                         (let [items (stage-items signature :list)
                               name (stage-symbol (first items)) arity (stage-unmeta (second items))]
                          (when-not (and (= 2 (count items))
                                         (Regex/match? (Regex/compile! "^[a-z][a-z0-9!?_-]*$") name)
                                         (erlang/is_integer arity) (<= 0 arity 255))
                           (stage-refuse :unsupported-sdk-stage-native))
                          (tuple name arity))) (rest (rest items)))]
  (when-not (and (string? crate) (<= (erlang/byte_size crate) 128)
                 (Regex/match? (Regex/compile! "^[a-z][a-z0-9_]*$") crate)
                 (<= 1 (count signatures) 256)
                 (= (count signatures) (count (distinct signatures))))
   (stage-refuse :unsupported-sdk-stage-native))
  (tuple crate (to-list signatures))))
(defn- stage-local-macro-use! [node names]
 (let [node (stage-unmeta node)]
  (when (erlang/is_tuple node)
   (case (elem node 0)
    :list (let [items (elem node 1) head (when (seq items) (stage-unmeta (first items)))
                symbol (when (stage-tag? head :symbol 2) (elem head 1))]
            (when (contains? names symbol) (stage-refuse :sdk-stage-local-macro-not-initialized))
            (when-not (contains? #{"quote" "syntax-quote"} symbol)
             (doseq [item items] (stage-local-macro-use! item names))))
    :vector (doseq [item (elem node 1)] (stage-local-macro-use! item names))
    :set (doseq [item (elem node 1)] (stage-local-macro-use! item names))
    :map (doseq [entry (elem node 1)]
           (stage-local-macro-use! (elem entry 0) names)
           (stage-local-macro-use! (elem entry 1) names))
    nil))))
(defn- stage-preflight! [forms]
 (when-not (and (seq forms) (<= (count forms) 2048)) (stage-refuse :sdk-stage-source-bound))
 (let [header (stage-requires (first forms))]
  ;; Every require must already have an initialized unit or an AOT-owned,
  ;; complete current-input emission receipt. A caller flag is never proof.
  ;; Loader.declare_require is deliberately NOT called: it can run source.
  (doseq [target (:requires header)]
   (when-not (or (BeamLisp.Env/loaded_ns? target) (sdk_unit_compiled? target))
    (stage-refuse :sdk-stage-dependency-not-ready)))
  (doseq [form (rest forms)]
   (let [items (stage-items form :list) head (stage-symbol (first items))]
    (cond
     (contains? #{"defn" "defn-" "defmacro" "defprotocol" "defserver" "defrecord" "deftype"} head)
      (let [name (stage-symbol (second items))]
       (when (String/contains? name "/") (stage-refuse :unsupported-sdk-stage-symbol)))
     (contains? #{"extend-type" "extend-protocol"} head)
      (when (< (count items) 3) (stage-refuse :unsupported-sdk-stage-protocol-declaration))
     (= "defnative" head) (stage-native form)
     (= "declare" head) (doseq [name (rest items)] (stage-symbol name))
     (= "def" head)
      (let [arguments (rest (rest items))]
       (stage-symbol (second items))
       (when-not (or (= 1 (count arguments))
                     (and (= 2 (count arguments)) (erlang/is_binary (first arguments))))
        (stage-refuse :unsupported-sdk-stage-initializer)))
     ;; Ordinary top-level calls are compiled, never evaluated, and replay
     ;; after proof in the same ordered stream as value definitions. Loaded
     ;; arbitrary macros receive a separate refusal before expansion.
     :else nil)))
  (when-not (constructor_context)
  (let [macros (set (map #(stage-symbol (second (stage-items % :list)))
                         (filter #(= "defmacro" (stage-head %)) (rest forms))))]
   (doseq [form (rest forms)]
    (if (contains? #{"defn" "defn-" "defmacro" "def" "defprotocol" "defserver" "defrecord" "deftype"}
                   (stage-head form))
     (doseq [body (rest (rest (stage-items form :list)))]
      (stage-local-macro-use! body macros))
     (stage-local-macro-use! form macros)))))
  (when (> (count (filter #(= "defnative" (stage-head %)) (rest forms))) 1)
   (stage-refuse :duplicate-sdk-stage-native))
  header))
(defn- stage-literal [node]
 (when-not (and (erlang/is_map node) (= :lit (:op node)))
  (stage-refuse :unsupported-sdk-stage-declaration-argument))
 (:val node))
(defn- stage-scaffold [node locals]
 ;; Classify the ENTIRE actual compiler scaffold before publishing any of its
 ;; declarations. Quoted clause bodies inside literal entries are not executed.
 (when-not (erlang/is_map node) (stage-refuse :unsupported-sdk-stage-scaffold))
 (case (:op node)
  :lit []
  :var (do (when-not (contains? locals (:name node)) (stage-refuse :unsupported-sdk-stage-scaffold)) [])
  :let (vec (concat (stage-scaffold (:init node) locals)
                    (stage-scaffold (:body node) (conj locals (:name node)))))
  :do (vec (mapcat #(stage-scaffold % locals) (:stmts node)))
  :remote
   (let [arguments (mapv (fn [argument] (stage-literal argument)) (:args node))]
    (cond
     (and (= :Elixir.BeamLisp.Link (:mod node)) (= :defvar (:fun node)) (= 4 (count arguments)))
      [[:definition (nth arguments 0) (nth arguments 1) (nth arguments 2)]]
     (and (= :Elixir.BeamLisp.Env (:mod node)) (= :put_meta (:fun node)) (= 3 (count arguments)))
      [[:metadata (nth arguments 0) (nth arguments 1) (nth arguments 2)]]
     :else (stage-refuse :unsupported-sdk-stage-declaration-call)))
  (stage-refuse :unsupported-sdk-stage-scaffold)))
(defn- stage-function! [form ns file]
 (let [name (stage-symbol (second (stage-items form :list)))
       env (Map/put (BeamLisp.Compiler/new_env ns) :file file)
       compiled (BeamLisp.Compiler/compile form env)
       operations (stage-scaffold compiled #{})
       definitions (filter #(= :definition (first %)) operations)]
  (when-not (and (= 1 (count definitions))
                 (every? #(and (= ns (nth % 1)) (= name (nth % 2))) operations))
   (stage-refuse :unsupported-sdk-stage-declaration))
  (doseq [[kind target symbol value] operations]
   (case kind
    :definition
     (do
      (when-not (and (erlang/is_list value) (seq value)
                     (every? (fn [entry] (and (erlang/is_tuple entry) (= 4 (erlang/tuple_size entry))
                                             (contains? #{:fixed :variadic} (elem entry 0))
                                             (erlang/is_integer (elem entry 1)) (erlang/is_atom (elem entry 2))
                                             (erlang/is_map (elem entry 3)))) value))
       (stage-refuse :unsupported-sdk-stage-entries))
      (BeamLisp.Env/put_ns_definition target symbol
       (BeamLisp.Emit/attach_body_module value (BeamLisp.Link/module_for ns))))
    :metadata (BeamLisp.Env/put_meta target symbol value)))))
(defn- stage-server! [form ns file]
 (let [name (stage-symbol (second (stage-items form :list)))
       mod (BeamLisp.Server/module_for ns name)
       compiled (BeamLisp.Compiler/compile form (Map/put (BeamLisp.Compiler/new_env ns) :file file))
       statements (Map/get compiled :stmts)
       create (first statements) intern (second statements) result (nth statements 2 nil)]
  (when-not (and (= :do (Map/get compiled :op)) (erlang/is_list statements) (= 3 (count statements))
                 (generated_module_call? create ns name)
                 (= :remote (Map/get intern :op)) (= :Elixir.BeamLisp.Env (Map/get intern :mod))
                 (= :intern (Map/get intern :fun))
                 (= (list ns name mod) (Enum/map (Map/get intern :args) (fn [argument] (stage-literal argument))))
                 (= :lit (Map/get result :op)) (= mod (Map/get result :val)))
   (stage-refuse :unsupported-sdk-stage-server-scaffold))
  ;; Pure compiler symbol publication only. Class bytecode is emitted by the
  ;; canonical AOT generated-module pass; no class load/init is performed here.
  (BeamLisp.Env/intern ns name mod)
  (sdk_record_declaration! form ns (list name) :public)))
(defn- stage-class! [form ns file]
 (let [name (stage-symbol (second (stage-items form :list)))
       compiled (BeamLisp.Compiler/compile form (Map/put (BeamLisp.Compiler/new_env ns) :file file))
       initializer (Map/get compiled :init)]
  (when-not (and (erlang/== :let (Map/get compiled :op)) (erlang/== "mod" (Map/get compiled :name))
                 (generated_class_call? initializer ns name)
                 (erlang/== :do (Map/get (Map/get compiled :body) :op)))
   (stage-refuse :unsupported-sdk-stage-class-scaffold))
  ;; Verify the compiler's exact binding publication prefix, including the
  ;; constructor factories. Protocol clauses after it remain deferred code.
  (let [statements (Map/get (Map/get compiled :body) :stmts)
        record? (= "defrecord" (stage-head form))
        names (if record? (list name (str "->" name) (str "map->" name))
                           (list name (str "->" name)))
        factories (if record? (list nil :positional_ctor :map_ctor) (list nil :positional_ctor))]
    (when-not (and (erlang/is_list statements) (>= (count statements) (inc (count names))))
      (stage-refuse :unsupported-sdk-stage-class-bindings))
    (doseq [pair (Enum/with_index names)]
      (let [binding (elem pair 0) index (elem pair 1) factory (nth factories index)
            statement (nth statements index)
            arguments (Map/get statement :args)
            value (nth arguments 2 nil)
            variable (if factory (first (Map/get value :args)) value)]
        (when-not (and (= :remote (Map/get statement :op))
                       (= :Elixir.BeamLisp.Env (Map/get statement :mod)) (= :intern (Map/get statement :fun))
                       (= 3 (count arguments)) (= ns (stage-literal (first arguments)))
                       (= binding (stage-literal (second arguments)))
                       (= :var (Map/get variable :op)) (= "mod" (Map/get variable :name))
                       (or (nil? factory)
                           (and (= :remote (Map/get value :op)) (= :Elixir.BeamLisp.Record (Map/get value :mod))
                                (= factory (Map/get value :fun)) (= 1 (count (Map/get value :args))))))
          (stage-refuse :unsupported-sdk-stage-class-bindings))))
    (sdk_record_declaration! form ns names :public))
  ;; No class/constructor interning, runtime schema or protocol execution.
  true))
(defn- sdk_named_constructor! [ns name arity]
 ;; A compiled-but-uninitialized SDK provider has no runtime Fn binding yet.
 ;; Read only its compiler-emitted literal definition table and exact body
 ;; receipt. Never initialize a provider merely to compile a declaration.
 (when-not (sdk_unit_compiled? ns) (stage-refuse :sdk-stage-constructor-not-compiled))
 (let [shim (BeamLisp.Emit/module_for ns)
       definitions (erlang/apply shim :__bl_ns_defs__ (list))
       entries (Map/get definitions name (list))
       matching (Enum/filter entries (fn [entry]
                  (and (= :fixed (elem entry 0)) (= arity (elem entry 1)))))
       entry (when (= 1 (count matching)) (first matching))
       module (when entry (elem entry 4)) function (when entry (elem entry 2))
       row (when module (sdk_compiler_row module))
       root (physical_sdk_path (BeamLisp.Tiers/priv_root))
       source (physical_sdk_path (BeamLisp.Loader/source_path ns))]
  (when-not (and row source (= :stable-body (Map/get row :role))
                 (= (Path/relative_to source root) (Map/get row :source))
                 (= name (Atom/to_string function))
                 (= (Map/get row :md5) (erlang/apply module :module_info (list :md5)))
                 (erlang/function_exported module function arity))
   (stage-refuse :unattested-sdk-stage-constructor))
  (erlang/make_fun module function arity)))
(defn- stage-clause-extension [form ns]
 (let [items (stage-items form :list) head (stage-symbol (first items))
       local? (and (not (String/contains? head "/"))
                   (Map/has_key? (BeamLisp.Env/ns_defs ns) head))
       resolved (when-not local?
                  (loop [candidates (BeamLisp.Env/candidates ns head)]
                   (when (seq candidates)
                    (let [pair (first candidates)]
                     (cond (= (tuple "proc.server" "extend-clause!") pair) pair
                           (not= :error (BeamLisp.Env/lookup pair)) nil
                           :else (recur (rest candidates)))))))]
  (when resolved
   (when-not (= 3 (count items)) (stage-refuse :unsupported-sdk-stage-clause-extension))
   (let [constructor (sdk_named_constructor! "proc.server" "clause-extension-form" 2)
         arguments (Enum/map (rest items)
                     (fn [item] (erlang/apply :Elixir.BeamLisp.Ns.Compiler :datum (list item))))
         data (erlang/apply constructor arguments)]
    ;; The canonical compiler conversion is also what ordinary macro expansion
    ;; uses. This invokes no mutable macro binding or transform body.
    (erlang/apply :Elixir.BeamLisp.Ns.Compiler :"data->form" (list data))))))

(defn- stage-action-macros! [form ns]
 ;; Compile-only is not permission to execute a loaded arbitrary macro. New
 ;; ordered action forms admit ordinary calls and compiler special forms;
 ;; unknown macro constructors must gain a separately reviewed pure producer.
 (when-not (constructor_context)
 (let [node (stage-unmeta form)]
  (when (erlang/is_tuple node)
   (case (elem node 0)
    :list
     (let [items (elem node 1) head (when (seq items) (stage-unmeta (first items)))
           name (when (stage-tag? head :symbol 2) (elem head 1))]
      (when-not (contains? #{"quote" "syntax-quote"} name)
       (when name
        (let [found (BeamLisp.Env/peek ns name)
              value (when (and (erlang/is_tuple found) (= 2 (erlang/tuple_size found))
                               (= :ok (elem found 0))) (elem found 1))]
         (when (and (erlang/is_tuple value) (>= (erlang/tuple_size value) 2)
                    (= :"$macro" (elem value 0)))
          (stage-refuse :unsupported-sdk-stage-action-macro))))
       (doseq [item items] (stage-action-macros! item ns))))
    :vector (doseq [item (elem node 1)] (stage-action-macros! item ns))
    :set (doseq [item (elem node 1)] (stage-action-macros! item ns))
    :map (doseq [entry (elem node 1)]
           (stage-action-macros! (elem entry 0) ns) (stage-action-macros! (elem entry 1) ns))
    nil)))))
(defn- append-staged-value [values form ns]
 ;; Ordinary AOT retains its historical final-definition projection. SDK
 ;; deferred actions need every occurrence, including repeated value defs.
 (Map/put values ns
  (erlang/++ (Map/get values ns (list)) (Map/get (capture_value_def {} form ns) ns (list)))))
(defn- stage-declaration-macros! [forms ns]
 ;; Legacy compile-only callers do not have authenticated SDK macro metadata.
 ;; Check every deferred executable body before compiling any declaration:
 ;; ordinary Compiler.compile can expand a loaded foreign macro even when its
 ;; enclosing function or class initializer will not run until later.
 (when-not (constructor_context)
  (doseq [form forms]
   (when (contains? #{"defn" "defn-" "defmacro" "def" "defprotocol" "defserver"
                      "defrecord" "deftype" "extend-type" "extend-protocol"} (stage-head form))
    (doseq [body (rest (rest (stage-items form :list)))]
     (stage-action-macros! body ns))))))
(defn- append-staged-action [values form ns file]
 (stage-action-macros! form ns)
 (let [compiled (BeamLisp.Compiler/compile form (Map/put (BeamLisp.Compiler/new_env ns) :file file))]
  (Map/put values ns
    (erlang/++ (Map/get values ns (list)) (list (tuple nil nil compiled false))))))

(defn stage-sdk-unit!
 "Compile-only SDK declarations with ordered deferred values/actions; result is AOT.load_unit's exact tuple.
  This helper neither emits binaries nor registers trust. Caller must prohibit
  hidden Loader initialization during compiler execution. Loaded arbitrary
  macros in deferred bodies/actions refuse before expansion; authenticated SDK
  source constructors use the bounded metadata interpreter instead."
 [source opts]
 (when-not (and (erlang/is_binary source) (<= (erlang/byte_size source) 1048576))
  (stage-refuse :sdk-stage-source-bound))
 (let [file (Keyword/get opts :file nil)
       forms (BeamLisp.Reader/read_string source file)
       header (stage-preflight! forms) ns (:ns header)
       previous (BeamLisp.Env/current_ns)]
  (try
   (BeamLisp.Env/declare_ns ns) (BeamLisp.Env/in_ns ns)
   (doseq [pair (Map/get (:metadata header) :aliases)]
    (BeamLisp.Env/add_alias ns (elem pair 0) (elem pair 1)))
   (doseq [pair (Map/get (:metadata header) :refers)]
    (BeamLisp.Env/add_refer ns (elem pair 0) (elem pair 1)))
   (doseq [target (Map/get (:metadata header) :refer_alls)] (BeamLisp.Env/add_refer_all ns target))
   (stage-declaration-macros! (rest forms) ns)
   (BeamLisp.Compiler/reset_fresh!)
   (doseq [form (rest forms)]
    (BeamLisp.Compiler/prelink_defn form ns)
    (BeamLisp.Compiler/prelink_type form ns))
   (let [staged (stage-sdk-forms! (rest forms) ns file {} {})
         values (elem staged 0) defined (elem staged 1)]
    (tuple defined values (MapSet/new (list ns))
           (let [metadata (capture_ns_decl {} (first forms))
                 declaration (first (filter #(= "defnative" (stage-head %)) (rest forms)))]
            (if declaration (assoc-in metadata [ns :native-declaration] (stage-native declaration)) metadata)) file
           (when (constructor_context) (Map/get (constructor_context!) :declarations {}))))
   (finally (BeamLisp.Env/in_ns previous)))))

;; HOME integration draft. The object path selects current source discovery;
;; only new compiler output can subsequently supply executable authority.
(defn- sdk_dependency_source! [mod attrs compile-info]
  (let [root (physical_sdk_path (BeamLisp.Tiers/priv_root))
        stamped (normalized_attribute attrs :bl_unit_namespace)
        filename (Keyword/get compile-info :source)
        hinted (when filename
                 (physical_sdk_path (if (erlang/is_list filename) (List/to_string filename) filename)))
        inside? (and hinted (String/starts_with? hinted (erlang/iolist_to_binary (list root "/"))))
        declared (when inside? (BeamLisp.Loader/declared_ns (BeamLisp.Loader/read_source hinted)))
        namespace (or stamped declared)
        selected (when (erlang/is_binary namespace)
                   (physical_sdk_path (BeamLisp.Loader/source_path namespace)))]
    (when (or stamped inside? (erlang/== (tuple :ok :beam_lisp) (application/get_application mod)))
      (when-not (and (erlang/is_binary namespace) selected
                     (String/starts_with? selected (erlang/iolist_to_binary (list root "/")))
                     (or (erlang/not inside?) (erlang/== selected hinted))
                     (erlang/== namespace (BeamLisp.Loader/declared_ns (BeamLisp.Loader/read_source selected))))
        (erlang/error (tuple :missing_sdk_dependency_unit_owner mod namespace selected hinted)))
      (tuple namespace selected))))

; Exact existing v2 manifest subset. Never decode arbitrary ETF or intern names.
(defn- sdk_cache_read_bounded! [path limit]
  (when-not (and (erlang/is_integer limit) (erlang/> limit 0))
    (erlang/error :sdk_stage_cached_read_bound))
  (let [opened (file/open (String/to_charlist path) (list :read :binary :raw))]
    (when-not (erlang/== :ok (elem opened 0)) (erlang/error :sdk_stage_cached_read_failed))
    (let [descriptor (elem opened 1)]
      (try
        (let [read (file/read descriptor (erlang/+ limit 1))]
          (when-not (and (erlang/is_tuple read) (erlang/== :ok (elem read 0))
                         (erlang/is_binary (elem read 1)) (erlang/=< (erlang/byte_size (elem read 1)) limit)
                         (erlang/== :eof (file/read descriptor 1)))
            (erlang/error :sdk_stage_cached_read_bound))
          (elem read 1))
        (finally (file/close descriptor))))))

(defn- sdk_manifest_byte! [bytes offset]
  (when-not (and (erlang/is_integer offset) (erlang/>= offset 0)
                 (erlang/< offset (erlang/byte_size bytes)))
    (erlang/error :invalid_sdk_stage_cached_manifest))
  (binary/at bytes offset))
(defn- sdk_manifest_u32! [bytes offset]
  (erlang/+ (erlang/+ (erlang/bsl (sdk_manifest_byte! bytes offset) 24)
                       (erlang/bsl (sdk_manifest_byte! bytes (erlang/+ offset 1)) 16))
             (erlang/+ (erlang/bsl (sdk_manifest_byte! bytes (erlang/+ offset 2)) 8)
                       (sdk_manifest_byte! bytes (erlang/+ offset 3)))))
(defn- sdk_manifest_slice! [bytes offset length]
  (when-not (and (erlang/is_integer length) (erlang/>= length 0)
                 (erlang/=< (erlang/+ offset length) (erlang/byte_size bytes)))
    (erlang/error :invalid_sdk_stage_cached_manifest))
  (binary/part bytes offset length))
(defn- sdk_manifest_atom! [bytes offset]
  ;; Native atoms remain binaries until an independently parsed actual BEAM
  ;; supplies its matching module identity. These four tags are emitted by OTP;
  ;; atom-cache references and all executable/capability tags refuse.
  (let [tag (sdk_manifest_byte! bytes offset)
        small? (or (erlang/== tag 119) (erlang/== tag 115))
        utf8? (or (erlang/== tag 119) (erlang/== tag 118))
        _ (when-not (or small? (erlang/== tag 118) (erlang/== tag 100))
            (erlang/error :invalid_sdk_stage_cached_manifest))
        length (if small? (sdk_manifest_byte! bytes (erlang/+ offset 1))
                 (erlang/+ (erlang/bsl (sdk_manifest_byte! bytes (erlang/+ offset 1)) 8)
                           (sdk_manifest_byte! bytes (erlang/+ offset 2))))
        start (erlang/+ offset (if small? 2 3))
        _ (when (erlang/> length 1024) (erlang/error :invalid_sdk_stage_cached_manifest))
        encoded (sdk_manifest_slice! bytes start length)
        name (if utf8? (unicode/characters_to_binary encoded :utf8 :utf8)
                      (unicode/characters_to_binary encoded :latin1 :utf8))]
    (when-not (erlang/is_binary name) (erlang/error :invalid_sdk_stage_cached_manifest))
    (tuple name (erlang/+ start length))))
(defn- sdk_manifest_module! [bytes offset]
  (let [parsed (sdk_manifest_atom! bytes offset) name (elem parsed 0)]
    (when-not (and (String/starts_with? name "Elixir.BeamLisp.")
                   (erlang/not (String/contains? name "/")) (erlang/not (String/contains? name "\\"))
                   (erlang/not (String/contains? name (erlang/list_to_binary (list 0)))))
      (erlang/error :invalid_sdk_stage_cached_module_name))
    parsed))
(defn- sdk_manifest_modules! [bytes offset]
  (when-not (erlang/== 108 (sdk_manifest_byte! bytes offset))
    (erlang/error :invalid_sdk_stage_cached_manifest))
  (let [count (sdk_manifest_u32! bytes (erlang/+ offset 1))]
    (when-not (and (erlang/> count 0) (erlang/=< count 8192))
      (erlang/error :invalid_sdk_stage_cached_manifest))
    (loop [remaining count position (erlang/+ offset 5) names (list) seen {}]
      (if (erlang/== remaining 0)
        (do
          (when-not (erlang/== 106 (sdk_manifest_byte! bytes position))
            (erlang/error :invalid_sdk_stage_cached_manifest))
          (tuple (Enum/reverse names) (erlang/+ position 1)))
        (let [parsed (sdk_manifest_module! bytes position) name (elem parsed 0)]
          (when (Map/has_key? seen name) (erlang/error :invalid_sdk_stage_cached_manifest))
          (recur (erlang/- remaining 1) (elem parsed 1) (cons name names) (Map/put seen name true)))))))
(defn- sdk_manifest_digests! [bytes offset]
  (when-not (erlang/== 116 (sdk_manifest_byte! bytes offset))
    (erlang/error :invalid_sdk_stage_cached_manifest))
  (let [count (sdk_manifest_u32! bytes (erlang/+ offset 1))]
    (when-not (and (erlang/> count 0) (erlang/=< count 8192))
      (erlang/error :invalid_sdk_stage_cached_manifest))
    (loop [remaining count position (erlang/+ offset 5) digests {}]
      (if (erlang/== remaining 0) (tuple digests position)
        (let [parsed (sdk_manifest_module! bytes position) name (elem parsed 0) next (elem parsed 1)]
          (when-not (and (erlang/not (Map/has_key? digests name))
                         (erlang/== 109 (sdk_manifest_byte! bytes next))
                         (erlang/== 32 (sdk_manifest_u32! bytes (erlang/+ next 1))))
            (erlang/error :invalid_sdk_stage_cached_manifest))
          (recur (erlang/- remaining 1) (erlang/+ next 37)
                 (Map/put digests name (sdk_manifest_slice! bytes (erlang/+ next 5) 32))))))))
(defn- sdk_stage_manifest! [bytes]
  ;; Store's ordinary v2 format is sufficient; compressed ETF, executable terms,
  ;; arbitrary maps and unknown fields are not needed to restore declarations.
  (when-not (and (erlang/is_binary bytes) (erlang/=< (erlang/byte_size bytes) 1048576)
                 (erlang/== 131 (sdk_manifest_byte! bytes 0))
                 (erlang/== 116 (sdk_manifest_byte! bytes 1))
                 (erlang/== 3 (sdk_manifest_u32! bytes 2)))
    (erlang/error :invalid_sdk_stage_cached_manifest))
  (let [parsed
        (loop [remaining 3 position 6 record {}]
          (if (erlang/== remaining 0)
            (do (when-not (erlang/== position (erlang/byte_size bytes))
                  (erlang/error :invalid_sdk_stage_cached_manifest)) record)
            (let [key (sdk_manifest_atom! bytes position) name (elem key 0) next (elem key 1)
                  field (cond (erlang/== name "version") :version
                              (erlang/== name "modules") :modules
                              (erlang/== name "digests") :digests
                              :else (erlang/error :invalid_sdk_stage_cached_manifest))]
              (when (Map/has_key? record field) (erlang/error :invalid_sdk_stage_cached_manifest))
              (let [value (cond
                            (erlang/== field :modules) (sdk_manifest_modules! bytes next)
                            (erlang/== field :digests) (sdk_manifest_digests! bytes next)
                            :else
                              (do (when-not (and (erlang/== 97 (sdk_manifest_byte! bytes next))
                                                (erlang/== 2 (sdk_manifest_byte! bytes (erlang/+ next 1))))
                                    (erlang/error :invalid_sdk_stage_cached_manifest))
                                  (tuple 2 (erlang/+ next 2))))]
                (recur (erlang/- remaining 1) (elem value 1) (Map/put record field (elem value 0)))))))]
    (when-not (and (erlang/== 3 (erlang/map_size parsed))
                   (erlang/== (Enum/sort (Map/get parsed :modules))
                               (Enum/sort (Map/keys (Map/get parsed :digests)))))
      (erlang/error :invalid_sdk_stage_cached_manifest))
    parsed))

; Compile-only cache admission. No ordinary cached loader or initializer API.
(defn- sdk_stage_literal_definitions! [mod bytes]
  (let [disassembly (beam_disasm/file bytes)
        _ (when-not (and (erlang/is_tuple disassembly) (erlang/== 6 (erlang/tuple_size disassembly))
                         (erlang/== :beam_file (elem disassembly 0)) (erlang/== mod (elem disassembly 1)))
            (erlang/error :invalid_sdk_stage_cached_disassembly))
        functions (elem disassembly 5)]
    ;; Native code loading itself can execute on_load. Defer/init names are not
    ;; sufficient: OTP removes the on_load attribute and emits an instruction.
    (when (Enum/any? functions
            (fn [function] (Enum/any? (elem function 4)
              (fn [instruction]
                (or (erlang/== :on_load instruction)
                    (and (erlang/is_tuple instruction) (erlang/> (erlang/tuple_size instruction) 0)
                         (erlang/== :on_load (elem instruction 0))))))))
      (erlang/error :sdk_stage_cached_on_load_refused))
    (let [definition (Enum/find functions
                       (fn [function] (and (erlang/== :__bl_ns_defs__ (elem function 1))
                                           (erlang/== 0 (elem function 2)))))]
      (when definition
        (let [instructions (Enum/reject (elem definition 4)
                            (fn [instruction]
                              (and (erlang/is_tuple instruction)
                                   (Enum/member? (list :label :line :func_info) (elem instruction 0)))))
              move (when (erlang/== 2 (erlang/length instructions)) (erlang/hd instructions))
              operand (when (and (erlang/is_tuple move) (erlang/== 3 (erlang/tuple_size move)))
                        (elem move 1))]
          (when-not (and move (erlang/== :move (elem move 0))
                         (erlang/== (tuple :x 0) (elem move 2))
                         (erlang/== :return (List/last instructions))
                         (erlang/is_tuple operand) (erlang/== 2 (erlang/tuple_size operand))
                         (erlang/== :literal (elem operand 0)) (erlang/is_map (elem operand 1)))
            (erlang/error :sdk_stage_cached_definition_not_literal))
          (elem operand 1))))))

(defn- sdk_stage_cached_unit [ns source content requested key closure out]
  ;; Existing v2 cache format and provenance contract, without generic fetch's
  ;; arbitrary ETF decoder. Names remain data until actual BEAM parsing proves
  ;; module identity. Each native read consumes the shared remaining budget.
  (try
    (let [entry (BeamLisp.AOTCache/entry_dir key closure)
          manifest (sdk_stage_manifest!
                     (sdk_cache_read_bounded! (Path/join entry "manifest.term") 1048576))
          shim (BeamLisp.Emit/module_for ns)
          captured
          (loop [names (Map/get manifest :modules) remaining 268435456 beams (list)]
            (if (erlang/== names (list)) (Enum/reverse beams)
              (let [name (erlang/hd names)
                    bytes (sdk_cache_read_bounded! (Path/join entry (erlang/iolist_to_binary (list name ".beam")))
                              (erlang/min remaining 33554432))
                    _ (when-not (erlang/== (crypto/hash :sha256 bytes)
                                            (Map/get (Map/get manifest :digests) name))
                        (erlang/error :sdk_stage_cached_bytes_changed))
                    chunks (beam_lib/chunks bytes (list :attributes))
                    _ (when-not (and (erlang/is_tuple chunks) (erlang/== :ok (elem chunks 0)))
                        (erlang/error :sdk_stage_cached_module_invalid))
                    mod (elem (elem chunks 1) 0)
                    attrs (Keyword/get (elem (elem chunks 1) 1) :attributes)]
                (when-not (and (erlang/== name (Atom/to_string mod))
                               (erlang/== ns (normalized_attribute attrs :bl_unit_namespace))
                               (erlang/== key (normalized_attribute attrs :bl_compiler_key))
                               (erlang/== closure (normalized_attribute attrs :bl_source_hash))
                               (erlang/== (crypto/hash :sha256 content)
                                           (normalized_attribute attrs :bl_unit_source_digest)))
                  (erlang/error :sdk_stage_cached_source_changed))
                ;; A current-key cached stable body must carry the common
                ;; pure factory before any bytes are published. Missing factory
                ;; is a cache miss followed by real compile-only production.
                (when (erlang/== mod (ns_body_module ns))
                  (let [export-chunks (beam_lib/chunks bytes (list :exports))]
                    (when-not (and (erlang/== :ok (elem export-chunks 0))
                                   (Enum/member? (Keyword/get (elem (elem export-chunks 1) 1) :exports)
                                                 (tuple :__bl_callable_values__ 0)))
                      (erlang/error :sdk_stage_cached_callable_factory_missing))))
                (let [definitions (sdk_stage_literal_definitions! mod bytes)]
                  (when (erlang/== mod shim)
                    (when-not (and definitions
                                   (BeamLisp.AOTCache/provenance_attributes_match? attrs key closure))
                      (erlang/error :sdk_stage_cached_definitions_missing))))
                (recur (erlang/tl names) (erlang/- remaining (erlang/byte_size bytes))
                       (cons (tuple mod bytes) beams)))))
          modules (Enum/map captured (fn [beam] (elem beam 0)))
          _ (when-not (and (Enum/member? modules shim) (Enum/member? modules requested))
              (erlang/error :invalid_sdk_stage_cached_members))
          root (physical_sdk_path (BeamLisp.Tiers/priv_root))
          entries (sdk_emission_entries! root source captured)
          indexed (Map/new (Enum/map entries
                    (fn [entry] (tuple (elem (elem entry 0) 1) (elem entry 1)))))
          row (Map/get indexed shim)]
      ;; One complete real emitting unit: omitted and extra modules both refuse.
      (when-not (and row (erlang/== :mutable-forwarder (Map/get row :role))
                     (erlang/== ns (Map/get row :forwarder-namespace))
                     ;; Unlike ordinary/image inventory, compile-only cache
                     ;; admission needs actual expanded declaration metadata.
                     ;; Missing metadata is a miss followed by real staging.
                     (sdk_declaration_descriptor? (Map/get row :declarations) ns)
                     (sdk_callable_descriptor? (Map/get row :callable-kinds) ns)
                     (erlang/== (Enum/sort modules)
                       (Enum/sort (cons shim (Map/get row :unit-references)))))
        (erlang/error :sdk_stage_cached_unit_mismatch))
      (constructor_source_input! ns source content)
      (when-not (and (erlang/== key (BeamLisp.AOTCache/key_for_ns ns))
                     (erlang/== closure (ns_closure_hash ns)))
        (erlang/error :sdk_stage_cached_closure_changed))
      {:beams captured :entries entries :requested (Map/get indexed requested)
       :content content :key key :closure closure :declarations (Map/get row :declarations)})
    (catch _error nil)))

(defn- restore_sdk_staged_unit! [ns source prepared]
  ;; Only the captured, fully validated batch reaches native publication. A
  ;; publication refusal propagates; it is not a cache miss followed by effects.
  ;; Preserve constructor staging's exact global/no-application-authority extent.
  (let [previous (BeamLisp.Env/capture)
        previous-attempt (Process/get :bl_initializer_attempt)
        dirs (BeamLisp.Tiers/dirs)]
    (BeamLisp.Loader/without_initialization
      (fn [] (BeamLisp.Env/with_env :global
        (fn []
          (try
            (BeamLisp.Env/bind (Map/merge (BeamLisp.Env/capture)
                               {:generation nil :application-identity nil :admission nil :query-functions nil
                                :loader-ambient dirs :loader-resolution (tuple dirs dirs (list))}))
            (Process/delete :bl_initializer_attempt)
            (let [result (BeamLisp.Env/with_namespace_lock ns
                          (fn [] (BeamLisp.Env/with_publication ns
                            (fn []
                              (constructor_source_input! ns source (:content prepared))
                              (when-not (and (erlang/== (:key prepared) (BeamLisp.AOTCache/key_for_ns ns))
                                             (erlang/== (:closure prepared) (ns_closure_hash ns)))
                                (erlang/error :sdk_stage_cached_closure_changed))
                              (let [previous (sdk_callable_rebindings ns (BeamLisp.Env/ns_defs ns)
                                               {ns (elem (:declarations prepared) 2)})]
                                (BeamLisp.Env/publish_binaries! (:beams prepared) source)
                                (BeamLisp.Env/link_ns_defs ns (BeamLisp.Emit/module_for ns))
                                (materialize_unit_callables! ns (BeamLisp.Emit/module_for ns) previous))
                              (publish_sdk_emission_entries! (:entries prepared))))))]
              (when (erlang/== :retired result) (erlang/error :scope_retired)))
            (:requested prepared)
            (finally
              (BeamLisp.Env/bind previous)
              (if previous-attempt (Process/put :bl_initializer_attempt previous-attempt)
                (Process/delete :bl_initializer_attempt))))))))))

(defn- stage_sdk_dependency! [ns source requested]
  ;; Never call repair_library here: its source path evaluates initializers.
  ;; Staging only materializes compiler declarations and a deferred initializer.
  ;; The completed unit receipt must exist and match the actual requested module
  ;; before any normal loader path may invoke that initializer.
  (let [active (Process/get :bl_sdk_staging_units (MapSet/new))]
   (when (MapSet/member? active ns) (erlang/error (tuple :cyclic_sdk_staging_dependency ns)))
   (Process/put :bl_sdk_staging_units (MapSet/put active ns))
   (try
    (let [content (BeamLisp.Loader/read_source source)
        out (Path/join (Path/join (BeamLisp.AOTCache/dir) "sdk-proof-stage")
              (erlang/iolist_to_binary (list (BeamLisp.AOTCache/compiler_key) "-" ns "-"
                (Integer/to_string (System/unique_integer (list :positive))))))]
    (File/mkdir_p! out)
    (try
      (let [forms (BeamLisp.Reader/read_string content source)
            metadata (Map/get (capture_ns_decl {} (first forms)) ns)]
        (Enum/each (Map/get metadata :requires (list))
          (fn [target]
            (when-not (or (BeamLisp.Env/loaded_ns? target) (sdk_unit_compiled? target))
              (let [path (physical_sdk_path (BeamLisp.Loader/source_path target))
                    root (physical_sdk_path (BeamLisp.Tiers/priv_root))]
                (when-not (and path root (String/starts_with? path (erlang/iolist_to_binary (list root "/"))))
                  (erlang/error (tuple :sdk_stage_dependency_outside_sdk target)))
                (stage_sdk_dependency! target path (BeamLisp.Emit/module_for target)))))))
      (let [key (BeamLisp.AOTCache/key_for_ns ns)
            closure (ns_closure_hash ns)
            cached (sdk_stage_cached_unit ns source content requested key closure out)]
       (if cached
        (restore_sdk_staged_unit! ns source cached)
        (let [beams (compile_source content (list (tuple :file source) (tuple :output_dir out)
                                               (tuple :stage-sdk? true)))
            modules (Enum/map beams (fn [beam] (elem beam 0)))
            row (source_sdk_receipt requested)]
        (when-not (and (Enum/member? modules requested) row
                       (erlang/== (Map/get row :source-digest) (crypto/hash :sha256 content)))
          (erlang/error (tuple :sdk_staged_dependency_not_produced ns requested)))
        ;; Cache publication is only an optimization; emitted code and receipts
        ;; remain authoritative. Namespace readiness is deliberately not marked.
        (BeamLisp.AOTCache/store key closure out modules closure)
        row)))
      (finally (File/rm_rf out))))
    (finally (Process/put :bl_sdk_staging_units active)))))


(defn sdk_generated_class?
  "Non-authorizing data-class evidence. This never grants actor adoption."
  [mod]
  (try
    (let [root (physical_sdk_path (BeamLisp.Tiers/priv_root)) image (Path/join root "sdk-code.term")
          row (if (File/exists? image) (Map/get (inventory_term image) (Atom/to_string mod))
                  (source_sdk_receipt mod))
          metadata (when row (Map/get row :generated-class))
          source (when row (physical_sdk_path (Path/join root (Map/get row :source))))]
      (and (erlang/is_atom mod) row (erlang/== :generated-class (Map/get row :role))
           (erlang/is_tuple metadata) (erlang/== 5 (erlang/tuple_size metadata))
           (erlang/== 1 (elem metadata 0)) source
           (String/starts_with? source (erlang/iolist_to_binary (list root "/")))
           (erlang/== (crypto/hash :sha256 (BeamLisp.Loader/read_source source)) (Map/get row :source-digest))
           (erlang/== (BeamLisp.AOTCache/compiler_key) (Map/get row :compiler-key))
           (erlang/== (tuple (elem metadata 1) (elem metadata 2)) (Map/get row :declaration-owner))
           (erlang/== mod (BeamLisp.Record/module_name (elem metadata 1) (elem metadata 2)))
           (erlang/== (tuple (elem metadata 3) (elem metadata 1) (elem metadata 2)
                         (Enum/map (elem metadata 4) (fn [field] (erlang/binary_to_existing_atom field :utf8))))
                      (BeamLisp.Record/info mod))
           (erlang/module_loaded mod) (erlang/== (Map/get row :md5) (erlang/apply mod :module_info (list :md5)))
           (BeamLisp.Env/sdk_runtime_retained_modules? (list mod))))
    (catch _ false)))


; ── bounded compiler-constructor interpretation ───────────────────────────
; This is a data-only engine. SDK source ownership is authenticated separately
; by declaration staging; supplying ANF does not grant native execution authority.

(defn- constructor_refuse [detail]
 (throw (ex-info "Bounded constructor interpretation refused"
                 {:kind :constructor-machine-refused :detail detail})))
(defn- constructor_counter! [state field delta]
 (let [key (:counter-frame state) counters (erlang/get key)]
  (when-not (and (erlang/is_map counters) (erlang/is_map_key field counters))
   (constructor_refuse :missing-counter-frame))
  (let [next (+ (erlang/map_get field counters) delta)]
   (erlang/put key (maps/put field next counters)) next)))
(defn- constructor_step! [state]
 (when (neg? (constructor_counter! state :remaining -1)) (constructor_refuse :step-budget)))

(defn- constructor_container_cost! [value state]
 (let [frame (erlang/get (:counter-frame state))]
  (BeamLisp.CompilerData/constructor_data_cost! value
   {:callables (Map/get frame :callables {}) :recipe-frame (:counter-frame state)
    :recipes (Map/get frame :recipes {})})))

(defn- constructor_map_shape! [value state]
 ;; A plain map may contain machine-owned callables. Struct-backed containers
 ;; can dispatch protocols, force deferred work or use forged storage, so use
 ;; the shared raw checker before any primitive can observe such a container.
 ;; Canonical internal Vector/Set storage may carry private machine callbacks;
 ;; validate the same exact storage using this frame's actual leaf witness.
 (when (and (erlang/is_map value) (erlang/is_map_key :__struct__ value))
  (constructor_container_cost! value state))
 value)

; Private finite recipes model only interpreted sequence construction. They are
; not native LazySeq resources and cannot cross the first-order API boundary.
(defn- constructor_recipe? [value state]
 (and (erlang/is_map value) (= 3 (erlang/map_size value))
      (= :Elixir.BeamLisp.LazySeq (Map/get value :__struct__))
      (= (:counter-frame state) (Map/get value :constructor-frame))
      (int? (Map/get value :constructor-id))
      (let [frame (erlang/get (:counter-frame state))]
       (and (erlang/is_map frame)
            (Map/has_key? (Map/get frame :recipes {}) (Map/get value :constructor-id))))))

(defn- constructor_recipe_present! [value state]
 ;; An authenticated recipe must be a member of this current private frame.
 ;; With an exact empty recipe table, no subtree can contain such a member.
 ;; Keep counter-frame validation and one bounded observation step; all raw
 ;; input/result validation still runs independently at primitive boundaries.
 (let [frame (erlang/get (:counter-frame state))
       recipes (when (erlang/is_map frame) (Map/get frame :recipes))]
  (if (and (erlang/is_map recipes) (erlang/== 0 (erlang/map_size recipes)))
   (do (constructor_step! state) false)
   (loop [pending (list value)]
  (if (= (list) pending) false
   (let [value (erlang/hd pending) remaining (erlang/tl pending)]
    (constructor_step! state)
    (cond
     (constructor_recipe? value state) true
     (erlang/is_list value)
      (if (= (list) value) (recur remaining)
       (recur (cons (erlang/hd value) (cons (erlang/tl value) remaining))))
     (erlang/is_tuple value) (recur (erlang/++ (erlang/tuple_to_list value) remaining))
     (erlang/is_map value)
      (recur (Enum/reduce (maps/to_list value) remaining
               (fn [entry rest] (cons (elem entry 0) (cons (elem entry 1) rest)))))
     :else (recur remaining)))))) ))

(defn- constructor_register_callable! [function state]
 (let [key (:counter-frame state) frame (erlang/get key)
       callables (Map/get frame :callables {})]
  (when (>= (erlang/map_size callables) 16384) (constructor_refuse :callable-budget))
  (erlang/put key (Map/put frame :callables (Map/put callables function true)))
 function))

(defn- constructor_recipe_callable! [function state]
 (let [function (if (and (erlang/is_tuple function) (= 3 (erlang/tuple_size function))
                         (= :"$blfn" (elem function 0)))
                  (Map/get (elem function 1) 0) function)
       frame (erlang/get (:counter-frame state))]
  (when-not (and (erlang/is_function function 0)
                 (Map/has_key? (Map/get frame :callables {}) function))
   (constructor_refuse :non-interpreted-recipe-thunk))
  function))

(defn- constructor_recipe_row! [recipe state]
 (when-not (constructor_recipe? recipe state) (constructor_refuse :unowned-finite-recipe))
 (Map/fetch! (Map/get (erlang/get (:counter-frame state)) :recipes)
             (:constructor-id recipe)))

(defn- constructor_recipe_put! [recipe row state]
 (let [key (:counter-frame state) frame (erlang/get key)]
  (erlang/put key (Map/put frame :recipes
                   (Map/put (Map/get frame :recipes) (:constructor-id recipe) row))))
 row)

(defn- constructor_recipe_new! [kind thunk prefix state]
 (let [thunk (when-not (= :input kind) (constructor_recipe_callable! thunk state))
       serial (constructor_counter! state :recipe-serial 1)]
  (when (> serial 4096) (constructor_refuse :finite-recipe-budget))
  (constructor_charge! prefix state)
  (constructor_allocation! 16 0 state)
  (let [recipe {:__struct__ :Elixir.BeamLisp.LazySeq :constructor-frame (:counter-frame state)
                :constructor-id serial}
        row {:kind kind :status (if (= :input kind) :ready :pending)
             :thunk thunk :prefix prefix :value (when (= :input kind) prefix)}]
   (constructor_recipe_put! recipe row state) recipe)))

(defn- constructor_recipe_value! [recipe state]
 (let [row (constructor_recipe_row! recipe state)]
  (case (:status row)
   :ready (:value row)
   :running (constructor_refuse :recursive-finite-recipe)
   :failed (constructor_refuse :failed-finite-recipe)
   :pending
    (do
     (constructor_recipe_put! recipe (assoc row :status :running) state)
     (try
      (let [value (constructor_invoke (:thunk row) (list) state)]
       (constructor_internal_cost! value state)
       (constructor_recipe_put! recipe (assoc row :status :ready :value value :thunk nil) state)
       value)
      (catch error
       (constructor_recipe_put! recipe (assoc row :status :failed :thunk nil) state)
       (erlang/raise __EXCEPTION_KIND__ error __STACKTRACE__))))
   (constructor_refuse :invalid-finite-recipe-state))))

(defn- constructor_recipe_sequence! [recipe state]
 (constructor_stream_all! recipe :fold state))

(defn- constructor_recipe_cell! [value state]
 ;; A cursor/chain cell exposes an improper tail in the real runtime. Whole
 ;; finite sequence consumption is supported; opaque physical cell views refuse
 ;; until a faithful model exists, rather than silently changing their shape.
 (if (constructor_recipe? value state)
  (let [row (constructor_recipe_row! value state)]
   (when (contains? #{:chain :input} (:kind row))
    (constructor_refuse :opaque-finite-recipe-cell-observation))
   (when (> (constructor_counter! state :recipe-depth 1) 64)
    (constructor_refuse :finite-recipe-depth))
   (try (constructor_recipe_cell! (constructor_recipe_value! value state) state)
    (finally (constructor_counter! state :recipe-depth -1))))
  (let [_ (constructor_eager_sequence_bound! value state)
        cell (cond
               (or (nil? value) (erlang/is_list value)) value
               (vector? value) (BeamLisp.Vector/to_list value)
               (set? value) (BeamLisp.Set/to_list value)
               (erlang/is_binary value) (String/graphemes value)
               (and (erlang/is_map value) (not (erlang/is_map_key :__struct__ value))) (maps/to_list value)
               :else value)]
   (if (= (list) cell) nil cell))))

(defn- constructor_compat_reduced! []
 ;; The ordinary Source wrapper consults a live binding. No arbitrary predicate
 ;; may execute inside compile-only staging. Refuse changed/missing authority.
 (when-not (= (tuple :ok (erlang/make_fun :Elixir.BeamLisp.Ns.Rt :reduced? 1))
               (BeamLisp.Env/lookup (tuple "core" "reduced?")))
  (constructor_refuse :mutable-reduced-predicate)))

(defn- constructor_stream_mapv! [f values]
 (BeamLisp.Vector/new (Enum/map (if (vector? values) (BeamLisp.Vector/to_list values) values) f)))

; HOME prototype: same-process, frame-authenticated finite stream graph.
; Cells cache in native chunk order before arbitrary callbacks; only trusted
; nonhalting materialization consumes source recipes. No native resource is produced.
(defn- constructor_stream_cursor! [value state]
 (if (constructor_recipe? value state)
  (let [row (constructor_recipe_row! value state)]
   (case (:kind row)
    :derived {:node value :index 0}
    :view (:cursor row)
    :cons {:prefix (list (:head row)) :rest-source (:tail row)}
    :thunk {:thunk value}
    :chain {:prefix (:prefix row) :tail value}
    :input {:list (:value row)}
    (constructor_refuse :opaque-sequence)))
  {:list (constructor_sequence! value state)}))





(defn- constructor_stream_callback! [callback state]
 (cond
  (erlang/is_function callback)
   (when-not (Map/has_key? (Map/get (erlang/get (:counter-frame state)) :callables {}) callback)
    (constructor_refuse :non-interpreted-stream-callback))
  (and (erlang/is_tuple callback) (= 3 (erlang/tuple_size callback))
       (= :"$blfn" (elem callback 0)))
   (when-not (Map/has_key? (Map/get (erlang/get (:counter-frame state)) :callables {}) callback)
    (Enum/each (Map/values (elem callback 1)) #(constructor_stream_callback! % state))
    (when (elem callback 2) (constructor_stream_callback! (elem (elem callback 2) 1) state)))
  (or (keyword? callback) (vector? callback) (map? callback))
   (BeamLisp.CompilerData/check_first_order! callback)
  :else (constructor_refuse :non-interpreted-stream-callback)))

(defn- constructor_stream_new! [operation callback sources state]
 (when-not (contains? #{:map :filter :remove :concat} operation)
  (constructor_refuse :unsupported-stream-operation))
 (when callback (constructor_stream_callback! callback state))
 (constructor_internal_cost! sources state)
 (when (> (count sources) 16) (constructor_refuse :stream-source-budget))
 ;; Bound/charge input copies before retaining a callback graph. Conversion
 ;; inspects eager raw storage only; a deferred source is never forced here.
 (constructor_allocation! (+ 16 (* 8 (count sources))) 0 state)
 (let [recipe (constructor_recipe_new! :input nil nil state)
       cursors (constructor_stream_mapv! #(constructor_stream_cursor! % state) sources)
       row {:kind :derived :operator operation :callback callback
            :sources cursors :outer (when (= :concat operation) {:list sources})
            :inner nil :stream-cache [] :stream-nodes 0 :stream-bytes 0
            :stream-done false :stream-mode nil :stream-running false
            :stream-failed false :stream-tails #{}}]
  (constructor_recipe_put! recipe row state) recipe))

(defn- constructor_stream_pull! [cursor mode state]
 (constructor_step! state)
 (when (> (constructor_counter! state :recipe-depth 1) 64)
  (constructor_refuse :finite-recipe-depth))
 (try
  (cond
   (Map/has_key? cursor :list)
    (let [items (:list cursor)]
     (when (seq items) (tuple (first items) {:list (rest items)})))
   (Map/has_key? cursor :prefix)
    (if (seq (:prefix cursor))
     (tuple (first (:prefix cursor)) (assoc cursor :prefix (rest (:prefix cursor))))
     (if (Map/has_key? cursor :rest-source)
      (constructor_stream_pull! (constructor_stream_cursor! (:rest-source cursor) state) mode state)
      (constructor_stream_pull!
       (constructor_stream_cursor! (constructor_recipe_value! (:tail cursor) state) state) :cell state)))
   (Map/has_key? cursor :thunk)
    (constructor_stream_pull!
     (constructor_stream_cursor! (constructor_recipe_value! (:thunk cursor) state) state) :cell state)
   (Map/has_key? cursor :node)
    (when-let [item (constructor_stream_at! (:node cursor) (:index cursor) mode state)]
     (tuple (elem item 0) (assoc cursor :index (inc (:index cursor)))))
   :else (constructor_refuse :invalid-stream-cursor))
  (finally (constructor_counter! state :recipe-depth -1))))

(defn- constructor_stream_step! [recipe mode state]
 (let [row (constructor_recipe_row! recipe state) operation (:operator row)
       source-mode (if (and (= :map operation) (> (count (:sources row)) 1)) :cell mode)]
  (case operation
   :map
    (let [pulled (constructor_stream_mapv! #(constructor_stream_pull! % source-mode state) (:sources row))]
     (constructor_recipe_put! recipe
      (assoc row :sources (constructor_stream_mapv! #(when % (elem % 1)) pulled)) state)
     (if (Enum/any? (BeamLisp.Vector/to_list pulled) (fn [v] (nil? v))) {:end true}
      {:value (constructor_invoke (:callback row) (to-list (constructor_stream_mapv! #(elem % 0) pulled)) state)}))
   :filter
    (if-let [item (constructor_stream_pull! (first (:sources row)) mode state)]
     (do
      (constructor_recipe_put! recipe (assoc row :sources [(elem item 1)]) state)
      (if (constructor_truthy? (constructor_invoke (:callback row) (list (elem item 0)) state))
       {:value (elem item 0)} {:skip true}))
     {:end true})
   :remove
    (if-let [item (constructor_stream_pull! (first (:sources row)) mode state)]
     (do
      (constructor_recipe_put! recipe (assoc row :sources [(elem item 1)]) state)
      (if (constructor_truthy? (constructor_invoke (:callback row) (list (elem item 0)) state))
       {:skip true} {:value (elem item 0)}))
     {:end true})
   :concat
    (if (:inner row)
     (if-let [item (constructor_stream_pull! (:inner row) mode state)]
      (do (constructor_recipe_put! recipe (assoc row :inner (elem item 1)) state)
          {:value (elem item 0)})
      (do (constructor_recipe_put! recipe (assoc row :inner nil) state) {:boundary true}))
     (if-let [item (constructor_stream_pull! (:outer row) mode state)]
      (do (constructor_recipe_put! recipe
            (assoc row :outer (elem item 1)
                       :inner (constructor_stream_cursor! (elem item 0) state)) state)
          {:skip true})
      {:end true}))
   (constructor_refuse :unsupported-stream-operation))))

(defn- constructor_stream_append! [recipe value state]
 (let [row (constructor_recipe_row! recipe state)
       cost (constructor_internal_cost! value state)
       nodes (+ (:stream-nodes row) (:nodes cost) 1)
       bytes (+ (:stream-bytes row) (:bytes cost))]
  (when (>= (count (:stream-cache row)) (:max-collection state))
   (constructor_refuse :collection-budget))
  (when (> nodes 65536) (constructor_refuse :aggregate-node-budget))
  (when (> bytes 1048576) (constructor_refuse :aggregate-byte-budget))
  (constructor_allocation! (+ 1 (:nodes cost)) (:bytes cost) state)
  (constructor_recipe_put! recipe
   (assoc row :stream-cache (conj (:stream-cache row) value)
              :stream-nodes nodes :stream-bytes bytes) state)))



(defn- constructor_stream_fill! [recipe mode state]
 (let [row (constructor_recipe_row! recipe state)
       mode (or (:stream-mode row) mode)
       multi? (and (= :map (:operator row)) (> (count (:sources row)) 1))
       limit (if (or (= :fold mode) multi?) 1 32)]
  (when (:stream-running row) (constructor_refuse :recursive-finite-recipe))
  (constructor_recipe_put! recipe (assoc row :stream-running true :stream-mode mode) state)
  (try
   (loop [visited 0 produced 0]
    (let [step (constructor_stream_step! recipe mode state)
          current (constructor_recipe_row! recipe state)]
     (cond
      (:end step) (do (constructor_recipe_put! recipe (assoc current :stream-done true :callback nil
                                                           :sources [] :outer nil :inner nil) state)
                      nil)
      (and (:boundary step) (> produced 0) (= :cell mode))
       (constructor_recipe_put! recipe
        (assoc current :stream-tails (conj (:stream-tails current) (count (:stream-cache current)))) state)
      :else
       (let [value? (Map/has_key? step :value)
             _ (when value? (constructor_stream_append! recipe (:value step) state))
             visited (if (or value? (and (:skip step) (contains? #{:filter :remove} (:operator current)))) (inc visited) visited)
             produced (if value? (inc produced) produced)]
        ;; filter scans32INPUTS and repeats an empty chunk. A fold asks for
        ;; one admitted output only. Concat stops at an input boundary.
        (if (and (> produced 0) (>= visited limit))
         (when (= :cell mode)
          (let [row (constructor_recipe_row! recipe state)]
           (constructor_recipe_put! recipe
            (assoc row :stream-tails (conj (:stream-tails row) (count (:stream-cache row)))) state)))
         (recur (if (>= visited limit) 0 visited) produced))))))
   (catch error
    (let [row (constructor_recipe_row! recipe state)]
     (constructor_recipe_put! recipe (assoc row :stream-failed true :callback nil) state))
    (erlang/raise __EXCEPTION_KIND__ error __STACKTRACE__))
   (finally
    (let [row (constructor_recipe_row! recipe state)]
     (constructor_recipe_put! recipe (assoc row :stream-running false) state))))))

(defn- constructor_stream_at! [recipe index mode state]
 (let [row (constructor_recipe_row! recipe state)]
  (cond
   (:stream-running row) (constructor_refuse :recursive-finite-recipe)
   (< index (count (:stream-cache row))) (tuple (nth (:stream-cache row) index))
   (:stream-failed row) (constructor_refuse :failed-finite-recipe)
   (:stream-done row) nil
   :else (do (constructor_stream_fill! recipe mode state)
             (constructor_stream_at! recipe index mode state)))))

(defn- constructor_stream_all! [value mode state]
 (loop [cursor (constructor_stream_cursor! value state) out (list) size 0]
  (if-let [item (constructor_stream_pull! cursor mode state)]
   (do
    (when (>= size (:max-collection state)) (constructor_refuse :collection-budget))
    (constructor_allocation! 2 0 state)
    (recur (elem item 1) (cons (elem item 0) out) (inc size)))
   (Enum/reverse out))))

(defn- constructor_stream_head! [value state]
 (when-let [item (constructor_stream_pull! (constructor_stream_cursor! value state) :cell state)]
  (elem item 0)))

(defn- constructor_stream_cursor_lazy? [cursor state]
 (cond
  (Map/has_key? cursor :thunk) true
  (Map/has_key? cursor :node)
   (let [row (constructor_recipe_row! (:node cursor) state)]
    (or (= 0 (:index cursor)) (contains? (:stream-tails row) (:index cursor))))
  :else false))

(defn- constructor_stream_view! [cursor lazy? state]
 (let [view (constructor_recipe_new! :input nil nil state)]
  (constructor_recipe_put! view {:kind :view :cursor cursor :native-lazy? lazy? :status :ready} state)
  view))

(defn- constructor_stream_rest! [value next? state]
 (let [cursor (constructor_stream_cursor! value state)
       first-item (constructor_stream_pull! cursor :cell state)]
  (if-not first-item (when-not next? (list))
   (let [tail (elem first-item 1)]
    (cond
     (and next? (nil? (constructor_stream_pull! tail :cell state))) nil
     (or (and (Map/has_key? tail :list) (= (list) (:list tail)))
         (and (Map/has_key? tail :node)
              (let [row (constructor_recipe_row! (:node tail) state)]
               (and (:stream-done row) (>= (:index tail) (count (:stream-cache row))))))) (list)
     :else (constructor_stream_view! tail (constructor_stream_cursor_lazy? tail state) state))))))

(defn- constructor_stream_seq! [value state]
 (let [cursor (constructor_stream_cursor! value state)]
  (when (constructor_stream_pull! cursor :cell state)
   ;; seq returns the realized cell's cons, not its root lazy node.
   (constructor_stream_view! cursor false state))))

(defn- constructor_stream_nth! [value index default state]
 (if-not (and (int? index) (>= index 0)) default
 (loop [cursor (constructor_stream_cursor! value state) i index]
  (if-let [item (constructor_stream_pull! cursor :cell state)]
   (if (= 0 i) (elem item 0) (recur (elem item 1) (dec i))) default))))



(defn- constructor_stream_halt? [value state]
 (and (constructor_recipe? value state)
      (= :halt (:kind (constructor_recipe_row! value state)))))

(defn- constructor_stream_halt! [value state]
 (constructor_internal_cost! value state)
 (let [halt (constructor_recipe_new! :input nil nil state)]
  (constructor_recipe_put! halt {:kind :halt :status :ready :value value} state) halt))

(defn- constructor_stream_unwrap! [value state]
 (when-not (constructor_stream_halt? value state)
  (constructor_refuse :non-interpreted-halt))
 (:value (constructor_recipe_row! value state)))







(defn- constructor_stream_fold! [callback init collection policy state]
 ;; Rt.lazy-fold intentionally publishes memo cells BEFORE arbitrary callbacks.
 ;; A callback can halt: replaying a pending recipe would repeat producer work.
 ;; Only trusted count/materialization consumers use the :fold source recipe.
 (when-not (contains? #{:kernel :compat} policy)
  (constructor_refuse :unsupported-reduce-policy))
 (constructor_internal_cost! init state)
 (when (= :compat policy) (constructor_compat_reduced!))
 (loop [cursor (constructor_stream_cursor! collection state) accumulator init]
  (if-let [item (constructor_stream_pull! cursor :cell state)]
   (do
    (when (= :compat policy) (constructor_compat_reduced!))
    (let [value (constructor_invoke callback (list accumulator (elem item 0)) state)]
     (constructor_internal_cost! value state)
     (when (= :compat policy) (constructor_compat_reduced!))
     (if (constructor_stream_halt? value state)
      (constructor_stream_unwrap! value state)
      (recur (elem item 1) value))))
   (if (constructor_stream_halt? accumulator state)
    (constructor_stream_unwrap! accumulator state) accumulator))))

(defn- constructor_stream_short! [callback collection every? state]
 (loop [cursor (constructor_stream_cursor! collection state)]
  (if-let [item (constructor_stream_pull! cursor :cell state)]
   (let [value (constructor_invoke callback (list (elem item 0)) state)]
    (if (if every? (not (constructor_truthy? value)) (constructor_truthy? value))
     (if every? false value)
     (recur (elem item 1))))
   (when every? true))))

(defn- constructor_stream_take! [n value state]
 (when-not (int? n) (constructor_refuse :stream-take-count))
 (when (> n (:max-collection state)) (constructor_refuse :collection-budget))
 (if (<= n 0) (list)
  (loop [cursor (constructor_stream_cursor! value state) remaining n out (list)]
   (if-let [item (constructor_stream_pull! cursor :cell state)]
    (do
     (constructor_allocation! 2 0 state)
     (let [out (cons (elem item 0) out)]
      (if (= remaining 1) (Enum/reverse out)
       (recur (elem item 1) (dec remaining) out))))
    (Enum/reverse out)))))

(defn- constructor_stream_drop! [n value state]
 (when-not (int? n) (constructor_refuse :stream-drop-count))
 (if (<= n 0) value
  (loop [cursor (constructor_stream_cursor! value state) remaining n]
   ;; Native positive drop also asks for the retained cell at remaining0.
   (if-let [item (constructor_stream_pull! cursor :cell state)]
    (if (= remaining 0) (constructor_stream_view! cursor false state)
     (recur (elem item 1) (dec remaining))) (list)))))

(defn- constructor_stream_cons! [head tail state]
 (constructor_internal_cost! head state)
 (constructor_allocation! 4 0 state)
 (let [value (constructor_recipe_new! :input nil nil state)]
  (constructor_recipe_put! value {:kind :cons :status :ready :head head :tail tail} state) value))

(defn- constructor_stream_reduce! [args state]
 (let [callback (first args) collection (last args)
       lazy? (fn [value]
               (and (constructor_recipe? value state)
                    (let [row (constructor_recipe_row! value state)]
                     (or (contains? #{:thunk :derived} (:kind row))
                         (and (= :view (:kind row)) (:native-lazy? row))))))]
  (if (= 3 (count args))
   (constructor_stream_fold! callback (second args) collection
                             (if (lazy? collection) :kernel :compat) state)
   ;; The Source two-arity wrapper reads the head cell before reducing its tail.
   (if-let [item (constructor_stream_pull! (constructor_stream_cursor! collection state) :cell state)]
    (let [tail (if (constructor_recipe? collection state)
                 (constructor_stream_rest! collection false state) (BeamLisp.Ns.Rt/rest collection))]
     (constructor_stream_fold! callback (elem item 0) tail
                              (if (lazy? tail) :kernel :compat) state))
    (constructor_invoke callback (list) state)))))


(defn- constructor_finite_fold! [callback init collection policy state]
 (constructor_stream_fold! callback init collection policy state))

(defn- constructor_recipe_observation! [target function args state]
 (when (constructor_recipe_present! args state)
  (let [module (first target)
        core? (contains? #{:Elixir.BeamLisp.Ns.Core :Elixir.BeamLisp.Ns.Rt} module)
        allowed? (or
                   (and core? (contains? #{"reduce" "map" "mapv" "mapcat" "filter" "remove"
                                           "run!" "some" "every?" "into" "concat" "apply"
                                           "first" "second" "rest" "next" "last" "nth" "count" "empty?" "seq" "to-list" "vec"
                                           "nil?" "some?" "not" "invoke" "splice" "k-reduce" "k-to-list" "vector?" "set?" "map?" "apply_variadic" "apply-variadic" "apply_to" "apply-to"} function))
                   (and (= target [:Elixir.BeamLisp.Refs :deref 1])
                        (constructor_stream_halt? (first args) state))
                   (and (= :Elixir.BeamLisp.LazySeq module)
                        (contains? #{"new" "from_fun" "chain" "input" "cell" "lazy?"} function))
                   (and (= :Elixir.Enum module) (= "join" function))
                   (and (= target [:erlang :is_tuple 1]) (constructor_recipe? (first args) state))
                   (and (= :erlang module) (contains? #{"==" "=:=" "/=" "=/="} function)
                        (or (nil? (first args)) (nil? (second args)))))]
   (when-not allowed?
    (throw (ex-info "Bounded constructor interpretation refused"
                    {:kind :constructor-machine-refused
                     :detail :opaque-finite-recipe-observation :operation target}))))))

(defn- constructor_internal_cost! [value state]
 ;; No protocol/Enumerable/callback inspection. Fn values are interpreter-owned
 ;; internal capabilities; source literal/input endpoints reject them. Captured
 ;; environments are charged independently when each capability is constructed.
 (loop [pending (list (tuple value 0)) nodes 0 bytes 0]
  (if (= (list) pending) {:nodes nodes :bytes bytes}
   (let [task (erlang/hd pending) v (elem task 0) depth (elem task 1)
         rest-tasks (erlang/tl pending) nodes (inc nodes)
         bytes (+ bytes (cond (erlang/is_binary v) (erlang/byte_size v)
                               (erlang/is_number v) (erlang/external_size v)
                               (erlang/is_atom v) (erlang/byte_size (erlang/atom_to_binary v :utf8))
                               :else 0))]
    (constructor_step! state)
    (when (> depth 128) (constructor_refuse :data-depth-budget))
    (when (> nodes 65536) (constructor_refuse :aggregate-node-budget))
    (when (> bytes 1048576) (constructor_refuse :aggregate-byte-budget))
    (cond
     (or (erlang/is_atom v) (erlang/is_number v) (erlang/is_binary v) (erlang/is_function v))
      (recur rest-tasks nodes bytes)
     (erlang/is_list v)
      (if (= (list) v) (recur rest-tasks nodes bytes)
       (recur (cons (tuple (erlang/hd v) (inc depth))
                    (cons (tuple (erlang/tl v) depth) rest-tasks)) nodes bytes))
     (erlang/is_tuple v)
      (do (when (> (erlang/tuple_size v) 65536) (constructor_refuse :aggregate-node-budget))
          (recur (Enum/reduce (erlang/tuple_to_list v) rest-tasks
                   (fn [item acc] (cons (tuple item (inc depth)) acc))) nodes bytes))
     (constructor_recipe? v state) (recur rest-tasks nodes bytes)
     (and (erlang/is_map v) (erlang/is_map_key :__struct__ v))
      ;; Validate the canonical container ONCE through its storage-aware raw
      ;; checker. Its private MapSet/trie storage is not an independent public
      ;; datum and must not be reclassified as a foreign input container.
      (let [cost (constructor_container_cost! v state)
            extra (dec (:nodes cost)) nodes (+ nodes extra) bytes (+ bytes (:bytes cost))]
       (when (> nodes 65536) (constructor_refuse :aggregate-node-budget))
       (when (> bytes 1048576) (constructor_refuse :aggregate-byte-budget))
       (when (neg? (constructor_counter! state :remaining (- extra)))
        (constructor_refuse :step-budget))
       (recur rest-tasks nodes bytes))
     (erlang/is_map v)
      (do (constructor_map_shape! v state)
          (when (> (erlang/map_size v) 65536) (constructor_refuse :aggregate-node-budget))
          (recur (Enum/reduce (maps/to_list v) rest-tasks
                   (fn [pair acc]
                    (cons (tuple (elem pair 0) (inc depth))
                          (cons (tuple (elem pair 1) (inc depth)) acc)))) nodes bytes))
     :else (constructor_refuse :opaque-internal-value))))))

(defn- constructor_charge! [value state]
 (let [cost (constructor_internal_cost! value state)]
  (when (neg? (constructor_counter! state :allocation-nodes (- (:nodes cost)))) (constructor_refuse :allocation-node-budget))
  (when (neg? (constructor_counter! state :allocation-bytes (- (:bytes cost)))) (constructor_refuse :allocation-byte-budget))))

(defn- constructor_allocation! [nodes bytes state]
 (when (neg? (constructor_counter! state :allocation-nodes (- nodes))) (constructor_refuse :allocation-node-budget))
 (when (neg? (constructor_counter! state :allocation-bytes (- bytes))) (constructor_refuse :allocation-byte-budget)))

(defn- constructor_atom! [token state]
 ;; Exact binary admission shared by keyword and String.to_atom. No native
 ;; conversion can intern a new name before both local and VM budgets pass.
 (when-not (erlang/is_binary token) (constructor_refuse :atom-string-domain))
 (when (> (erlang/byte_size token) 255) (constructor_refuse :atom-name-budget))
 (try (String/to_existing_atom token)
  (catch Elixir.ArgumentError _
   (when (neg? (constructor_counter! state :new-atoms -1)) (constructor_refuse :new-atom-budget))
   (when-let [context (constructor_context)]
    (let [remaining (dec (:new-atoms context))]
     (when (neg? remaining) (constructor_refuse :unit-new-atom-budget))
     (constructor_context_put! :new-atoms remaining)))
   (BeamLisp.AtomGuard/check! token)
   (BeamLisp.AtomGuard/to_atom token))))

(defn- constructor_keyword! [args state]
 (when-not (contains? #{1 2} (count args)) (constructor_refuse :keyword-arity))
 (if (and (= 1 (count args)) (keyword? (first args))) (first args)
  (let [namespace (when (= 2 (count args)) (name (first args)))
        value (if (= 2 (count args)) (name (second args))
                (str (first args)))
        token (if namespace (str namespace "/" value) value)]
   (when-not (and (erlang/is_binary token) (<= (erlang/byte_size token) 255))
    (constructor_refuse :keyword-name-budget))
   (constructor_atom! token state))))

(defn- constructor_readable! [value state]
 ;; The runtime printer may force deferred objects or invoke Inspect for foreign
 ;; types. Only the shared raw first-order domain is admitted here; no internal
 ;; callback/capsule or protocol-backed object reaches the printer.
 (BeamLisp.CompilerData/check_first_order! value)
 (let [cost (BeamLisp.CompilerData/first_order_cost! value)
       bound (+ 16 (* 8 (:bytes cost)) (* 8 (:nodes cost)))]
  ;; Covers binary escaping/invalid UTF-8, decimal integer digits, keyword and
  ;; container punctuation conservatively BEFORE any output allocation.
  (when (> bound 1048576) (constructor_refuse :readable-byte-budget))
  (constructor_allocation! 1 bound state)
  (let [result (BeamLisp.Ns.Rt/print_readably value)]
   (when (> (erlang/byte_size result) bound) (constructor_refuse :readable-bound-mismatch))
   result)))

(defn- constructor_bounded_map! [f sources state]
 (let [rows (Enum/zip sources)]
  (loop [remaining rows output (list) nodes 1 bytes 0]
   (if (= (list) remaining) (Enum/reverse output)
    (let [value (f (erlang/tuple_to_list (erlang/hd remaining)))
          cost (constructor_internal_cost! value state) nodes (+ nodes (:nodes cost) 1) bytes (+ bytes (:bytes cost))]
     ;; Check the next prefix before retaining it; at most one individually
     ;; bounded callback result exists outside the bounded prefix.
     (when (> nodes 65536) (constructor_refuse :aggregate-node-budget))
     (when (> bytes 1048576) (constructor_refuse :aggregate-byte-budget))
     (recur (erlang/tl remaining) (cons value output) nodes bytes))))))
(defn- constructor_sequence! [value state]
 (constructor_eager_sequence_bound! value state)
 (cond (constructor_recipe? value state) (constructor_recipe_sequence! value state)
       (nil? value) (list) (erlang/is_list value) value
       (erlang/is_binary value) (String/graphemes value)
       (vector? value) (BeamLisp.Vector/to_list value)
       (set? value) (BeamLisp.Set/to_list value)
       (and (map? value) (not (contains? value :__struct__)))
        (Enum/map (Map/to_list value) (fn [pair] [(elem pair 0) (elem pair 1)]))
       :else (constructor_refuse :opaque-sequence)))
(defn- constructor_eager_sequence_bound! [value state]
 ;; Rt's eager paths can materialize graphemes/map entries. Bound their input
 ;; BEFORE calling the runtime; approved Vector/Set storage was already checked
 ;; by the shared raw-data gate. Deferred/foreign structs never reach this point.
 (let [size (cond (constructor_recipe? value state) 0
                  (erlang/is_binary value) (erlang/byte_size value)
                  (erlang/is_list value) (erlang/length value)
                  (erlang/is_tuple value) (erlang/tuple_size value)
                  (vector? value) (BeamLisp.Vector/count value)
                  (set? value) (BeamLisp.Set/count value)
                  (erlang/is_map value) (erlang/map_size value)
                  :else 0)]
  (when (> size (:max-collection state)) (constructor_refuse :collection-budget))
  (cond
   (erlang/is_binary value) (constructor_allocation! (* 4 size) size state)
   (or (erlang/is_tuple value) (vector? value) (set? value))
    (constructor_allocation! (* 2 size) 0 state)
   (erlang/is_map value) (constructor_allocation! (* 16 size) 0 state)
   :else nil)))
(defn- constructor_eager_last [value]
 (loop [remaining value]
  (let [tail (BeamLisp.Ns.Rt/next remaining)]
   (if tail (recur tail) (BeamLisp.Ns.Rt/first remaining)))))
(defn- constructor_diagnostic_error [error target]
 ;; This is error reporting only. Never inspect arguments, rejected values,
 ;; ANF, private frame state, captured callbacks or Source paths. Preserve the
 ;; first exact operation and the existing bounded physical declaration trace.
 (let [data (BeamLisp.ExInfo/ex_data error) kind (when (erlang/is_map data) (Map/get data :kind))]
  (if (or (= :constructor-machine-refused kind) (= :unsafe-first-order-data kind))
   (let [context (constructor_context)
         namespace (when context (:namespace (:input context)))
         safe-namespace? (and (erlang/is_binary namespace) (<= (erlang/byte_size namespace) 256))
         data (if (and safe-namespace? (not (Map/has_key? data :constructor-namespace)))
                (Map/put data :constructor-namespace namespace) data)
         macro (when context (Map/get context :diagnostic-macro))
         macro-items (when (and (erlang/is_map macro)
                                (= :Elixir.BeamLisp.Vector (Map/get macro :__struct__)))
                       (Map/get macro :items))
         safe-macro? (and (erlang/is_tuple macro-items) (= 2 (erlang/tuple_size macro-items))
                          (erlang/is_binary (elem macro-items 0)) (<= (erlang/byte_size (elem macro-items 0)) 256)
                          (erlang/is_binary (elem macro-items 1)) (<= (erlang/byte_size (elem macro-items 1)) 256))
         data (if (and safe-macro? (not (Map/has_key? data :constructor-macro)))
                (Map/put data :constructor-macro macro) data)
         data (if (and target (not (Map/has_key? data :constructor-operation)))
                (Map/put data :constructor-operation target) data)
         operation (Map/get data :constructor-operation)
         items (when (and (erlang/is_map operation)
                          (= :Elixir.BeamLisp.Vector (Map/get operation :__struct__)))
                 (Map/get operation :items))
         safe-operation? (and (erlang/is_tuple items) (= 3 (erlang/tuple_size items))
                               (erlang/is_atom (elem items 0)) (erlang/is_atom (elem items 1))
                               (erlang/is_integer (elem items 2))
                               (>= (elem items 2) 0) (<= (elem items 2) 255))
         stack (Map/get data :constructor-call-stack)
         binding (when (and (erlang/is_list stack) (not (= (list) stack))) (erlang/hd stack))
         names (when (and (erlang/is_map binding)
                          (= :Elixir.BeamLisp.Vector (Map/get binding :__struct__)))
                 (Map/get binding :items))
         safe-binding? (and (erlang/is_tuple names) (= 2 (erlang/tuple_size names))
                             (erlang/is_binary (elem names 0)) (<= (erlang/byte_size (elem names 0)) 256)
                             (erlang/is_binary (elem names 1)) (<= (erlang/byte_size (elem names 1)) 256))
         detail (Map/get data :detail (Map/get data :reason))
         reason (if (erlang/is_atom detail) (erlang/atom_to_binary detail :utf8) "unsupported-operation")
         message (erlang/iolist_to_binary
                   (list "Bounded constructor interpretation refused: " reason
                     (if safe-operation?
                      (list " [" (erlang/atom_to_binary (elem items 0) :utf8) ":"
                            (erlang/atom_to_binary (elem items 1) :utf8) "/"
                            (erlang/integer_to_binary (elem items 2)) "]") (list))
                     (if safe-binding? (list " SDK " (elem names 0) "/" (elem names 1)) (list))))]
    (BeamLisp.ExInfo/ex_info message data)) error)))

(defn- constructor_bounded_result! [state target value]
 (try
  (when (and (or (erlang/is_number value) (erlang/is_binary value))
              (> (erlang/external_size value) 1048576)) (constructor_refuse :scalar-size-budget))
  (when (and (not (constructor_recipe? value state))
              (or (erlang/is_list value) (vector? value) (map? value))
              (> (count value) (:max-collection state))) (constructor_refuse :collection-budget))
  (constructor_internal_cost! value state) value
  (catch error
   (let [data (ex-data error)]
    (if (= :unsafe-first-order-data (:kind data))
     ;; The operation is an already-reviewed fixed MFA. Never report the
     ;; rejected value, its fields, Source text or private constructor frame.
     (throw (ex-info "Constructor operation returned unsupported first-order data"
                     (Map/put data :constructor-operation target)))
     (erlang/raise __EXCEPTION_KIND__ error __STACKTRACE__))))))


;; ── actual ANF, with a closed effect-denying primitive boundary ───────────
;; Named source callbacks are interpreted from compiler metadata. Only the
;; reviewed pure adapters below may call native functions; arbitrary host Fn
;; values are rejected at the data boundary and never fetched from a registry.

(declare constructor_interpret)
(declare constructor_primitive)

(defn- constructor_truthy? [v] (and (not (nil? v)) (not (= false v))))

(defn- constructor_pmatch
  "Match value `v` against pattern `p`, extending bindings `b` (a map) or
   returning :nomatch. Mirrors Core/Erlang clause semantics."
  [p v b state]
  (cond
    (= :nomatch b) :nomatch
    :else
      (let [_ (constructor_step! state) op (:pop p)]
        (when (and (constructor_recipe? v state) (not= :pvar op))
         (constructor_refuse :opaque-finite-recipe-observation))
        (cond
          (= op :pvar) (if (contains? b (:name p))
                            (if (erlang/=:= (get b (:name p)) v) b :nomatch)
                            (assoc b (:name p) v))
          (= op :plit) (if (erlang/=:= (:val p) v) b :nomatch)
          (= op :pnil) (if (and (erlang/is_list v) (= (list) v)) b :nomatch)
          (= op :palias) (constructor_pmatch (:b p) v (constructor_pmatch (:a p) v b state) state)
          (= op :ptuple)
            (if (and (tuple? v) (= (count (:elems p)) (tuple-size v)))
              (Enum/reduce (Enum/with_index (:elems p)) b
               (fn [pair acc] (constructor_pmatch (elem pair 0) (elem v (elem pair 1)) acc state)))
              :nomatch)
          (= op :pcons)
            (if (and (erlang/is_list v) (not (empty? v)))
              (constructor_pmatch (:tail p) (rest v) (constructor_pmatch (:head p) (first v) b state) state)
              :nomatch)
          (= op :pmap)
            (if (map? v)
              (Enum/reduce (:pairs p) b
               (fn [pair acc]
                (let [k (first pair) pe (second pair)]
                 (if (= :nomatch acc) :nomatch
                  (if (Map/has_key? v k) (constructor_pmatch pe (Map/get v k) acc state) :nomatch)))))
              :nomatch)
          (= op :pstruct)
            (if (and (map? v) (= (:mod p) (get v :__struct__)))
              (Enum/reduce (:fields p) b
               (fn [pair acc] (constructor_pmatch (second pair) (Map/get v (first pair)) acc state)))
              :nomatch)
          :else :nomatch))))

(defn- constructor_match_clauses
  "Try each clause against args (a list of values); run the first whose
   patterns match AND whose guard is truthy. `on-fail` is called with no args."
  [clauses args env on-fail state]
  (let [hit (Enum/find_value clauses
              (fn [cl]
               (let [bound (if (= (count (:pats cl)) (count args))
                             (Enum/reduce (Enum/zip (:pats cl) args) {}
                               (fn [pair acc] (constructor_pmatch (elem pair 0) (elem pair 1) acc state))) :nomatch)
                     b (when-not (= :nomatch bound) (Map/merge env bound))]
                (when (and b (or (nil? (:guard cl)) (constructor_truthy? (constructor_interpret (:guard cl) b state))))
                 [cl b]))))]
    (if (nil? hit) (on-fail) (constructor_interpret (:body (first hit)) (second hit) state))))

(defn- constructor_invoke [function args state]
 (when (and (not (erlang/is_function function))
             (not (and (erlang/is_tuple function) (= 3 (erlang/tuple_size function))
                       (= :"$blfn" (elem function 0))))
             (constructor_recipe_present! (list function args) state))
  (constructor_refuse :opaque-finite-recipe-observation))
 (cond (erlang/is_function function) (erlang/apply function args)
       (and (erlang/is_tuple function) (= 3 (erlang/tuple_size function))
            (= :"$blfn" (elem function 0)))
        (if-let [fixed (get (elem function 1) (count args))]
         (constructor_invoke fixed args state)
         (let [variadic (elem function 2)]
          (when-not (and (erlang/is_tuple variadic) (= 2 (erlang/tuple_size variadic))
                         (int? (elem variadic 0)) (>= (count args) (elem variadic 0)))
           (constructor_refuse :callable-arity))
          (constructor_invoke (elem variadic 1)
           (erlang/++ (Enum/take args (elem variadic 0))
                      (list (Enum/drop args (elem variadic 0)))) state)))
       (keyword? function) (if (contains? #{1 2} (count args))
                             (BeamLisp.Ns.Rt/get (first args) function (second args))
                             (constructor_refuse :keyword-arity))
       (map? function) (if (contains? #{1 2} (count args))
                         (BeamLisp.Ns.Rt/get function (first args) (second args))
                         (constructor_refuse :map-arity))
       (vector? function) (if (= 1 (count args)) (BeamLisp.Vector/nth function (first args))
                             (constructor_refuse :vector-arity))
       :else (constructor_refuse :not-interpreted-callable)))

(defn- constructor_gensym! [args state]
 ;; Use the actual VM-wide unique counter, never a resettable interpreter-local
 ;; name sequence. Symbol names remain binary data; no atom is interned here.
 (when (neg? (constructor_counter! state :fresh-symbols -1))
  (constructor_refuse :fresh-symbol-budget))
 (constructor_charge! args state)
 (let [prefix (if (= (list) args) "G" (first args))
       bytes (cond (erlang/is_binary prefix) (erlang/byte_size prefix)
                   (erlang/is_atom prefix) (erlang/byte_size (erlang/atom_to_binary prefix :utf8))
                   :else 0)]
  (constructor_allocation! 3 (+ bytes 64) state)
  (if (= (list) args) (BeamLisp.Ns.Rt/gensym) (BeamLisp.Ns.Rt/gensym prefix))))

(defn- constructor_primitive [module function args state]
 (let [target [module function (count args)]
       pure-bifs #{[:erlang :== 2] [:erlang :=:= 2] [:erlang :/= 2] [:erlang :=/= 2]
         [:erlang :< 2] [:erlang :> 2] [:erlang :=< 2] [:erlang :>= 2]
         [:erlang :+ 2] [:erlang :- 2] [:erlang :* 2] [:erlang :div 2] [:erlang :rem 2]
         [:erlang :is_atom 1] [:erlang :is_binary 1] [:erlang :is_integer 1]
         [:erlang :is_number 1] [:erlang :is_list 1] [:erlang :is_map 1] [:erlang :is_tuple 1]
         [:erlang :tuple_size 1] [:erlang :map_size 1] [:erlang :length 1]
         [:erlang :element 2] [:erlang :hd 1] [:erlang :tl 1]
         [:erlang :tuple_to_list 1] [:erlang :list_to_tuple 1]}
       primitive-name (Atom/to_string function) rest? (String/ends_with? primitive-name "__bl_v")
       primitive-name (if rest? (String/replace_suffix primitive-name "__bl_v" "") primitive-name)
       args (if rest? (let [fixed (Enum/drop args -1) tail (last args)]
                        (erlang/++ fixed (constructor_sequence! tail state))) args)]
  (try
  (constructor_step! state)
  (when (= module :Elixir.BeamLisp.Ns.Core)
   (constructor_core_arity! primitive-name (count args)))
  ;; Refuse excessive combined inputs before any native allocation primitive.
  (constructor_internal_cost! args state)
  (constructor_recipe_observation! target primitive-name args state)
  (when (and (= module :Elixir.BeamLisp.Ns.Core)
             (contains? #{"first" "second" "rest" "next" "last" "nth" "count" "empty?"
                          "seq" "take" "drop" "to-list" "vec"} primitive-name))
   (Enum/each args (fn [value] (constructor_eager_sequence_bound! value state)))
   (constructor_charge! args state))
  (when (and (= module :Elixir.BeamLisp.Ns.Core)
             (contains? #{"concat" "map" "mapv" "mapcat" "vec" "vector" "list" "into"
                          "assoc" "dissoc" "conj" "hash-map" "merge" "set" "str" "join"}
                        primitive-name))
   (constructor_charge! args state))
  (constructor_bounded_result! state target
  (cond
   (and (constructor_recipe_present! args state)
        (contains? #{[:erlang :== 2] [:erlang :=:= 2] [:erlang :/= 2] [:erlang :=/= 2]} target)
        (or (nil? (first args)) (nil? (second args))))
    (erlang/apply module function args)
   (contains? pure-bifs target) (erlang/apply module function args)
   (= module :Elixir.BeamLisp.Ns.Core)
    (case primitive-name
     "identity" (first args) "not" (not (constructor_truthy? (first args)))
     "nil?" (nil? (first args)) "some?" (some? (first args))
     "list?" (erlang/is_list (first args))
     "seq?" (and (erlang/is_list (first args)) (not (= (list) (first args))))
     "vector?" (if (constructor_recipe? (first args) state) false (vector? (first args)))
     "map?" (if (constructor_recipe? (first args) state)
               (do
                (when-not (contains? #{:thunk :chain :input :derived :view :cons :halt :transient}
                             (:kind (constructor_recipe_row! (first args) state)))
                 (constructor_refuse :unmodeled-recipe-map-predicate))
                false)
               (map? (first args))) "set?" (if (constructor_recipe? (first args) state) false (set? (first args)))
     "symbol?" (symbol? (first args)) "keyword?" (keyword? (first args))
     "string?" (string? (first args)) "int?" (int? (first args))
     "=" (apply = args) "not=" (apply not= args)
     "inc" (inc (first args)) "dec" (dec (first args))
     "even?" (BeamLisp.Ns.Rt/even? (first args))
     "odd?" (BeamLisp.Ns.Rt/odd? (first args))
     "zero?" (BeamLisp.Ns.Rt/zero? (first args))
     "pos?" (BeamLisp.Ns.Rt/pos? (first args))
     "neg?" (BeamLisp.Ns.Rt/neg? (first args))
     "number?" (BeamLisp.Ns.Rt/number? (first args))
     "float?" (BeamLisp.Ns.Rt/float? (first args))
     "sorted?" (BeamLisp.Ns.Rt/sorted? (first args))
     "reduced?" (if (constructor_recipe? (first args) state)
                   (constructor_stream_halt? (first args) state)
                   (BeamLisp.Ns.Rt/reduced? (first args)))
     "reduced" (constructor_stream_halt! (first args) state)
     "deref" (constructor_stream_unwrap! (first args) state)
     "gensym" (constructor_gensym! args state)
     "first" (if (constructor_recipe? (first args) state)
                 (constructor_stream_head! (first args) state) (BeamLisp.Ns.Rt/first (first args)))
     "second" (if (constructor_recipe? (first args) state)
                  (constructor_stream_nth! (first args) 1 nil state) (BeamLisp.Ns.Rt/nth (first args) 1))
     "rest" (if (constructor_recipe? (first args) state)
                (constructor_stream_rest! (first args) false state) (BeamLisp.Ns.Rt/rest (first args)))
     "next" (if (constructor_recipe? (first args) state)
                (constructor_stream_rest! (first args) true state) (BeamLisp.Ns.Rt/next (first args)))
     "last" (if (constructor_recipe? (first args) state)
                (constructor_eager_last (constructor_stream_all! (first args) :cell state))
                (constructor_eager_last (first args)))
     "nth" (if (constructor_recipe? (first args) state)
               (constructor_stream_nth! (first args) (second args) (nth args 2 nil) state)
               (if (= 2 (count args)) (BeamLisp.Ns.Rt/nth (first args) (second args))
                (BeamLisp.Ns.Rt/nth (first args) (second args) (nth args 2))))
     "count" (BeamLisp.Ns.Rt/count (if (constructor_recipe? (first args) state)
                                        (constructor_recipe_sequence! (first args) state) (first args))) "empty?" (if (constructor_recipe? (first args) state)
                   (nil? (constructor_stream_pull! (constructor_stream_cursor! (first args) state) :cell state))
                   (BeamLisp.Ns.Rt/empty? (first args)))
     "seq" (if (constructor_recipe? (first args) state)
              (constructor_stream_seq! (first args) state)
              (BeamLisp.Ns.Rt/seq (first args))) "vec" (vec (constructor_sequence! (first args) state))
     "to-list" (constructor_sequence! (first args) state) "list" args "vector" (vec args)
     "cons" (if (constructor_recipe? (second args) state) (constructor_stream_cons! (first args) (second args) state) (cons (first args) (constructor_sequence! (second args) state)))
     "concat" (constructor_stream_new! :concat nil args state)
     "take" (if (constructor_recipe? (second args) state) (constructor_stream_take! (first args) (second args) state) (BeamLisp.Ns.Rt/take (first args) (second args)))
     "drop" (if (constructor_recipe? (second args) state) (constructor_stream_drop! (first args) (second args) state) (BeamLisp.Ns.Rt/drop_clj (first args) (second args)))
     "get" (BeamLisp.Ns.Rt/get (first args) (second args) (nth args 2 nil))
     "contains?" (contains? (first args) (second args))
     "keys" (Map/keys (first args)) "vals" (Map/values (first args))
     "assoc" (apply assoc args) "dissoc" (apply dissoc args)
     "conj" (apply conj args) "hash-map" (apply hash-map args)
     "merge" (Enum/reduce args nil (fn [item acc]
                (if (nil? item) acc (Map/merge (or acc {}) item))))
     "str" (do (BeamLisp.CompilerData/check_first_order! args) (apply str args))
     "name" (name (first args)) "symbol" (apply symbol args) "keyword" (constructor_keyword! args state)
     "fn?" (or (erlang/is_function (first args))
                (and (erlang/is_tuple (first args)) (= 3 (erlang/tuple_size (first args)))
                     (= :"$blfn" (elem (first args) 0))))
     "into" (case (count args) 0 [] 1 (first args)
                2 (constructor_stream_fold! (fn [acc item] (BeamLisp.Ns.Rt/conj acc item))
                    (first args) (second args) :kernel state))
     "set" (BeamLisp.Set/new (constructor_sequence! (first args) state))
     "mapcat" (let [mapped (constructor_stream_new! :map (first args) (rest args) state)
                      values (constructor_stream_all! mapped :fold state)]
                 (constructor_stream_new! :concat nil values state))
     "map" (constructor_stream_new! :map (first args) (rest args) state)
     "mapv" (BeamLisp.Vector/new
               (constructor_stream_all! (constructor_stream_new! :map (first args) (rest args) state) :fold state))
     "filter" (constructor_stream_new! :filter (first args) (list (second args)) state)
     "remove" (constructor_stream_new! :remove (first args) (list (second args)) state)
     "run!" (do
               (constructor_stream_fold!
                (fn [_ item] (constructor_invoke (first args) (list item) state) nil)
                nil (second args) :kernel state) nil)
     "join" (let [separator (first args) items (constructor_sequence! (second args) state)]
               ;; A repeated separator can allocate far more than the aggregate
               ;; input. Prove the exact supported string output before join.
               (when-not (and (erlang/is_binary separator)
                              (Enum/all? items (fn [item] (erlang/is_binary item))))
                (constructor_refuse :join-string-domain))
               (let [size (+ (Enum/reduce items 0 (fn [item n] (+ n (erlang/byte_size item))))
                             (* (erlang/max 0 (dec (count items))) (erlang/byte_size separator)))]
                (when (> size 1048576) (constructor_refuse :aggregate-byte-budget))
                (constructor_allocation! 1 size state)
                (Enum/join items separator)))
     "some" (constructor_stream_short! (first args) (second args) false state)
     "every?" (constructor_stream_short! (first args) (second args) true state)
     "reduce" (constructor_stream_reduce! args state)
     "apply" (constructor_invoke (first args)
               (erlang/++ (Enum/drop (rest args) -1) (constructor_sequence! (last args) state)) state)
     (constructor_refuse {:primitive target}))
   (and (= module :Elixir.BeamLisp.Ns.Rt)
        (contains? #{:first :rest :next :nth :count :take :drop_clj :seq :empty? :list? :seq?
                     :eqv :not_ :assoc :conj :contains? :map :filter :set :vector? :symbol?
                     :str_v :fn? :keyword? :map? :set? :cons :even? :odd? :zero? :pos? :neg?
                     :number? :float? :int? :string? :sorted? :reduced? :gensym} function))
    (let [renamed (get {:drop_clj :drop :eqv := :not_ :not :str_v :str__bl_v} function function)]
     (constructor_primitive :Elixir.BeamLisp.Ns.Core renamed args state))
   (contains? #{[:Elixir.BeamLisp.LazySeq :new 1] [:Elixir.BeamLisp.LazySeq :from_fun 1]} target)
    (constructor_recipe_new! :thunk (first args) nil state)
   (= target [:Elixir.BeamLisp.LazySeq :chain 2])
    (do
     (when-not (erlang/is_list (first args)) (constructor_refuse :finite-chain-prefix))
     (if (= (list) (first args)) nil
      (constructor_recipe_new! :chain (second args) (first args) state)))
   (= target [:Elixir.BeamLisp.LazySeq :input 1])
    (let [value (first args)
          input (if (vector? value) (constructor_sequence! value state) value)]
     (if (and (erlang/is_list input) (> (erlang/length input) 32))
      (constructor_recipe_new! :input nil input state) input))
   (= target [:Elixir.BeamLisp.LazySeq :lazy? 1])
    ;; A modeled thunk has the real lazy-node identity. A modeled input cursor
    ;; or chain is not a native LazySeq struct. No capsule fields are exposed.
    (and (constructor_recipe? (first args) state)
         (let [row (constructor_recipe_row! (first args) state)]
          (or (contains? #{:thunk :derived} (:kind row))
              (and (= :view (:kind row)) (:native-lazy? row)))))
   (= target [:Elixir.String :to_atom 1])
    (constructor_atom! (first args) state)
   (= target [:Elixir.BeamLisp.Ns.Rt :keyword_of 2])
    ;; cpp/jank.runtime.keyword is a proved seed alias. Keep the SAME bounded
    ;; pre-intern guard as the public Core adapter; never invoke native intern.
    (constructor_keyword! (if (nil? (first args)) (list (second args)) args) state)
   (contains? #{[:Elixir.BeamLisp.Ns.Rt :map_multi 3] [:Elixir.BeamLisp.Ns.Rt :map-multi 3]} target)
    (do
     (when-not (erlang/is_list (nth args 2)) (constructor_refuse :map-multi-rest-list))
     (constructor_stream_new! :map (first args) (cons (second args) (nth args 2)) state))
   (= target [:Elixir.BeamLisp.Ns.Rt :concat 1])
    (constructor_stream_new! :concat nil (constructor_sequence! (first args) state) state)
   (= target [:Elixir.BeamLisp.Ns.Rt :reduced 1])
    (constructor_stream_halt! (first args) state)
   (= target [:Elixir.BeamLisp.Refs :deref 1])
    (constructor_stream_unwrap! (first args) state)
   (= target [:Elixir.BeamLisp.Ns.Rt :k-to-list 1])
    (constructor_sequence! (first args) state)
   (contains? #{[:Elixir.BeamLisp.Ns.Rt :k-reduce 3] [:Elixir.BeamLisp.Ns.Rt :k-reduce 4]} target)
    (constructor_finite_fold! (first args) (second args) (nth args 2)
      (if (= 4 (count args)) (nth args 3) :kernel) state)
   (= target [:Elixir.BeamLisp.LazySeq :chunk_size 0]) 32
   (= target [:Elixir.BeamLisp.LazySeq :cell 1])
    (constructor_recipe_cell! (first args) state)
   (contains? #{[:lists :reverse 1] [:lists :reverse 2]} target)
    (do
     (constructor_charge! args state)
     (Enum/each args (fn [value] (constructor_eager_sequence_bound! value state)))
     (constructor_allocation! (* 2 (if (erlang/is_list (first args))
                                    (erlang/length (first args)) 0)) 0 state)
     (erlang/apply :lists :reverse args))
   (= target [:Elixir.BeamLisp.FormMeta :meta 1])
    (do (constructor_charge! args state) (BeamLisp.FormMeta/meta (first args)))
   (= target [:Elixir.BeamLisp.FormMeta :with_meta 2])
    (do (constructor_charge! args state)
        (BeamLisp.FormMeta/with_meta (first args) (second args)))
   (= target [:Elixir.BeamLisp.FormMeta :vary_meta 2])
    ;; Never pass an internal callable to the native vary_meta/invoke boundary.
    (let [form (first args)
          metadata (constructor_invoke (second args) (list (BeamLisp.FormMeta/meta form)) state)]
     (constructor_charge! (list form metadata) state)
     (BeamLisp.FormMeta/with_meta form metadata))
   (= target [:Elixir.BeamLisp.Ns.Rt :list_star_0 0]) nil
   (= target [:Elixir.BeamLisp.Ns.Rt :list_star 2])
    ;; The second argument is the variadic argument list, not the spread itself.
    ;; Native list_star preserves the exact final seqability/type semantics.
    (let [head (first args) tail (second args)]
     (constructor_charge! args state)
     (constructor_eager_sequence_bound! tail state)
     (if (= (list) tail)
      (constructor_eager_sequence_bound! head state)
      (when (erlang/is_list tail)
       (constructor_eager_sequence_bound! (lists/last tail) state)))
     (constructor_allocation! (* 2 (if (erlang/is_list tail) (erlang/length tail) 0)) 0 state)
     (BeamLisp.Ns.Rt/list_star head tail))
   (= target [:Elixir.BeamLisp.Ns.Rt :drop 2])
    (constructor_primitive :Elixir.BeamLisp.Ns.Core :drop (list (second args) (first args)) state)
   (= target [:Elixir.BeamLisp.Server :callback 1])
    (BeamLisp.Server/callback (first args))
   (and (constructor_context) (= target [:Elixir.BeamLisp.AOT :constructor_selected_clause! 1]))
    (constructor_selected_clause! (first args) state)
   (and (constructor_context) (= target [:Elixir.BeamLisp.Env :current_ns 0]))
    (BeamLisp.Env/current_ns)
   (and (constructor_context) (= target [:Elixir.BeamLisp.Env :env_id 0]))
    :sdk-declaration-scope
   (and (constructor_context) (= target [:Elixir.Process :get 1])
        (= :reload.declaration/preparation (first args))) nil
   (= target [:Elixir.BeamLisp.Ns.Rt :name_of 1]) (BeamLisp.Ns.Rt/name_of (first args))
   (= target [:Elixir.BeamLisp.Ns.Rt :namespace_of 1]) (BeamLisp.Ns.Rt/namespace_of (first args))
   (= target [:Elixir.Enum :join 2])
    (constructor_primitive :Elixir.BeamLisp.Ns.Core :join (list (second args) (first args)) state)
   (contains? #{[:Elixir.BeamLisp.Ns.Rt :invoke 2]
                 [:Elixir.BeamLisp.Ns.Rt :apply_to 2]
                 [:Elixir.BeamLisp.Ns.Rt :apply-to 2]} target)
    (constructor_invoke (first args) (constructor_sequence! (second args) state) state)
   (contains? #{[:Elixir.BeamLisp.Ns.Rt :apply_variadic 3]
                 [:Elixir.BeamLisp.Ns.Rt :apply-variadic 3]} target)
    (do
     (when-not (erlang/is_list (nth args 2)) (constructor_refuse :variadic-apply-rest-list))
     (let [arguments (cons (second args) (nth args 2))
           leading (Enum/drop arguments -1)
           trailing (constructor_sequence! (last arguments) state)]
      (constructor_allocation! (* 2 (erlang/length leading)) 0 state)
      (constructor_invoke (first args) (erlang/++ leading trailing) state)))
   (= target [:binary :split 2])
    (do
     (BeamLisp.CompilerData/check_first_order! args)
     (when-not (and (erlang/is_binary (first args))
                    (or (erlang/is_binary (second args))
                        (and (erlang/is_list (second args))
                             (Enum/all? (second args) (fn [pattern] (erlang/is_binary pattern))))))
      (constructor_refuse :binary-split-domain))
     ;; Two-arity split returns at most2parts, whose total bytes never exceed
     ;; the input. No compiled-pattern reference or native protocol is admitted.
     (constructor_allocation! 8 (erlang/byte_size (first args)) state)
     (binary/split (first args) (second args)))
   (contains? #{[:Elixir.BeamLisp.Multi :type_of 1]
                 [:Elixir.BeamLisp.Ns.Rt :sorted_map? 1]
                 [:Elixir.BeamLisp.Record :record? 1]} target)
    ;; These exact predicates inspect raw shapes/registered identity only.
    ;; Private recipes/callables and foreign/native values never cross here.
    (do (BeamLisp.CompilerData/check_first_order! (first args))
        (erlang/apply module function args))
   (= target [:Elixir.Map :delete 2])
    (do
     (BeamLisp.CompilerData/check_first_order! args)
     (when-not (and (erlang/is_map (first args))
                    (not (maps/is_key :__struct__ (first args))))
      (constructor_refuse :plain-map-delete-domain))
     (Map/delete (first args) (second args)))
   (= target [:Elixir.BeamLisp.Ns.Rt :transientable? 1])
    (do (BeamLisp.CompilerData/check_first_order! (first args))
        (BeamLisp.Ns.Rt/transientable? (first args)))
   (= target [:Elixir.BeamLisp.Ns.Rt :print_readably 1])
    (constructor_readable! (first args) state)
   (= target [:Elixir.BeamLisp.Ns.Rt :hash_key 1]) (BeamLisp.Ns.Rt/hash_key (first args))
   (contains? #{[:Elixir.BeamLisp.Ns.Rt :get 2] [:Elixir.BeamLisp.Ns.Rt :get 3]} target)
    (BeamLisp.Ns.Rt/get (first args) (second args) (nth args 2 nil))
   (= target [:Elixir.BeamLisp.Ns.Rt :splice 2])
    (erlang/++ (constructor_sequence! (first args) state) (constructor_sequence! (second args) state))
   (= target [:Elixir.BeamLisp.Vector :new 1]) (vec (constructor_sequence! (first args) state))
   (= target [:Elixir.BeamLisp.Set :new 1]) (BeamLisp.Set/new (constructor_sequence! (first args) state))
   :else (constructor_refuse {:remote target})))
  (catch error
   (erlang/raise __EXCEPTION_KIND__ (constructor_diagnostic_error error target) __STACKTRACE__)))))

(defn- constructor_pure_core_names []
 #{"identity" "not" "nil?" "some?" "list?" "seq?" "vector?" "map?" "set?"
   "symbol?" "keyword?" "string?" "int?" "even?" "odd?" "zero?" "pos?" "neg?"
   "number?" "float?" "sorted?" "reduced?" "reduced" "deref" "gensym" "=" "not=" "inc" "dec" "first"
   "second" "rest" "next" "last" "nth" "count" "empty?" "seq" "vec" "to-list"
   "list" "vector" "cons" "concat" "take" "drop" "get" "contains?" "keys"
   "vals" "assoc" "dissoc" "conj" "hash-map" "merge" "str" "name" "symbol"
   "keyword" "fn?" "into" "set" "mapcat" "map" "mapv" "filter" "remove"
   "some" "every?" "reduce" "apply" "run!" "join"})

(defn- constructor_core_arity! [name arity]
 (let [fixed {"identity" #{1} "not" #{1} "nil?" #{1} "some?" #{1} "list?" #{1}
              "vector?" #{1} "map?" #{1} "set?" #{1} "symbol?" #{1} "keyword?" #{1} "seq?" #{1}
              "string?" #{1} "int?" #{1} "even?" #{1} "odd?" #{1} "zero?" #{1}
              "pos?" #{1} "neg?" #{1} "number?" #{1} "float?" #{1} "sorted?" #{1} "reduced?" #{1} "reduced" #{1} "deref" #{1} "gensym" #{0 1} "not=" #{2} "inc" #{1} "dec" #{1}
              "first" #{1} "second" #{1} "rest" #{1} "next" #{1} "last" #{1} "nth" #{2 3}
              "count" #{1} "empty?" #{1} "seq" #{1} "vec" #{1} "to-list" #{1}
              "cons" #{2} "take" #{2} "drop" #{2} "get" #{2 3} "contains?" #{2}
              "keys" #{1} "vals" #{1} "name" #{1} "symbol" #{1 2} "keyword" #{1 2}
              "fn?" #{1} "into" #{0 1 2} "set" #{1} "mapcat" #{2} "mapv" #{2 3}
              "filter" #{2} "remove" #{2} "some" #{2} "every?" #{2} "reduce" #{2 3}
              "run!" #{2} "join" #{2}}
       accepted (if-let [choices (get fixed name)] (contains? choices arity)
                  (case name
                   "=" (>= arity 1)
                   "map" (>= arity 2)
                   "assoc" (and (>= arity 3) (= 1 (rem arity 2)))
                   "dissoc" (>= arity 1)
                   "conj" (>= arity 1)
                   "hash-map" (= 0 (rem arity 2))
                   "apply" (>= arity 2)
                   (contains? #{"list" "vector" "concat" "merge" "str"} name)))]
  (when-not accepted (constructor_refuse {:unsupported-primitive-arity [name arity]}))))

(defn constructor_interpret
 "Effect-denying, bounded actual-ANF interpreter. Caller
  supplies only compiler metadata; it supplies no runtime callback/host grant.
  Native execution is restricted to the closed pure primitive dispatch above."
 [n env state]
 (constructor_step! state)
 (when (> (constructor_counter! state :depth 1) 512) (constructor_refuse :depth-budget))
 (try
 (let [value
  (case (:op n)
   :lit (do (BeamLisp.CompilerData/check_first_order! (:val n)) (:val n))
   :var (if (contains? env (:name n)) (get env (:name n)) (constructor_refuse :unbound-local))
   :global (let [key [(:ns n) (:name n)]
                 alias (when-not (= :exact (:lookup n)) (get (:global-aliases state) key))
                 source (when (constructor_context)
                          (constructor_global_source (:ns n) (:name n)))]
             (cond
              source (constructor_interpret source {} state)
              (contains? (:globals state) key) (constructor_interpret (get (:globals state) key) {} state)
              alias (constructor_interpret {:op :global :ns (first alias) :name (second alias) :lookup :exact} {} state)
              (and (constructor_context) (= "cpp" (:ns n))
                   (nil? (BeamLisp.Loader/source_path "cpp")))
               (constructor_kernel_alias! "cpp" (:name n) state)
              (and (or (= "core" (:ns n))
                       (and (constructor_context) (not= :exact (:lookup n))))
                   (contains? (constructor_pure_core_names) (:name n))
                   (or (not (constructor_context))
                       (and (constructor_core_owner? (:ns n) (:name n) (:lookup n))
                            (constructor_core_primitive! (:name n)))))
               (constructor_register_callable!
                (fn [& arguments]
                 (constructor_primitive :Elixir.BeamLisp.Ns.Core (erlang/binary_to_atom (:name n))
                            (to-list arguments) state)) state)
              :else (constructor_refuse {:global key})))
   :remote (let [args (Enum/map (:args n) #(constructor_interpret % env state))
                 target [(:mod n) (:fun n) (count args)]
                 entry (or (get (:remotes state) target)
                           (when (constructor_context)
                            (constructor_remote_source (:mod n) (:fun n) (count args))))]
             (if entry
              (constructor_invoke (constructor_interpret {:op :fn :clauses (:clauses entry) :constructor-binding (:constructor-binding entry)} {} state) args state)
              (constructor_primitive (:mod n) (:fun n) args state)))
   :arith (let [args (Enum/map (:args n) #(constructor_interpret % env state))]
            (when-not (Enum/all? args (fn [item] (erlang/is_number item))) (constructor_refuse :non-numeric-arithmetic))
            (constructor_primitive :erlang (:bif n) args state))
   :apply (constructor_invoke (constructor_interpret (:fn n) env state) (Enum/map (:args n) #(constructor_interpret % env state)) state)
   :let (constructor_interpret (:body n) (assoc env (:name n) (constructor_interpret (:init n) env state)) state)
   :if (constructor_interpret (if (constructor_truthy? (constructor_interpret (:test n) env state)) (:then n) (:else n)) env state)
   :do (Enum/reduce (:stmts n) nil (fn [item _] (constructor_interpret item env state)))
   :tuple (do (constructor_allocation! (inc (count (:elems n))) 0 state)
              (erlang/list_to_tuple (Enum/map (:elems n) #(constructor_interpret % env state))))
   :map (do (constructor_allocation! (+ 8 (* 8 (count (:pairs n)))) 0 state)
         (constructor_map_shape!
          (Enum/reduce (:pairs n) {}
           (fn [[k v] acc] (Map/put acc (constructor_interpret k env state) (constructor_interpret v env state)))) state))
   :enil (list)
   :cons (let [head (constructor_interpret (:head n) env state)
               tail (constructor_interpret (:tail n) env state)]
           (constructor_allocation! 2 0 state)
           (if (constructor_recipe? tail state) (constructor_stream_cons! head tail state)
            (cons head (constructor_sequence! tail state))))
   :struct (if (and (= :Elixir.BeamLisp.Vector (:mod n)) (= 1 (count (:fields n))))
             (let [[k v] (first (:fields n)) key (constructor_interpret k env state) value (constructor_interpret v env state)]
              (when-not (and (= :items key) (erlang/is_tuple value)) (constructor_refuse :vector-scaffold))
              (BeamLisp.Vector/new (erlang/tuple_to_list value)))
             (constructor_refuse :opaque-struct))
   :case (constructor_match_clauses (:clauses n) (list (constructor_interpret (:subj n) env state)) env
            (fn [] (constructor_refuse :case-clause)) state)
   :fn (let [_ (constructor_charge! env state) clauses (:clauses n) arity (count (:pats (first clauses)))
             run (fn [args]
              (try (constructor_match_clauses clauses args env (fn [] (constructor_refuse :function-clause)) state)
               (catch error
                (let [data (ex-data error) binding (:constructor-binding n)
                      context (constructor_context)
                      unit (when (and context (vector? binding) (= 2 (count binding)))
                             (Map/get (:units context) (first binding)))]
                 (if (and (contains? #{:unsafe-first-order-data :constructor-machine-refused} (:kind data))
                          unit (Map/has_key? (:definitions unit) (second binding))
                          (erlang/is_binary (first binding)) (<= (erlang/byte_size (first binding)) 256)
                          (erlang/is_binary (second binding)) (<= (erlang/byte_size (second binding)) 256))
                  ;; Only physical selected SDK declaration names are reported;
                  ;; never captured arguments, ANF, paths or runtime values.
                  (erlang/raise __EXCEPTION_KIND__
                   (constructor_diagnostic_error
                    (BeamLisp.ExInfo/ex_info "Source constructor refused"
                     (Map/put data :constructor-call-stack
                      (Enum/take (cons binding (Map/get data :constructor-call-stack (list))) 16))) nil)
                   __STACKTRACE__)
                  (erlang/raise __EXCEPTION_KIND__ error __STACKTRACE__))))))]
         (let [value (case arity
          0 (fn [] (run (list))) 1 (fn [a] (run (list a)))
          2 (fn [a b] (run (list a b))) 3 (fn [a b c] (run (list a b c)))
          4 (fn [a b c d] (run (list a b c d)))
          5 (fn [a b c d e] (run (list a b c d e)))
          6 (fn [a b c d e f] (run (list a b c d e f)))
          7 (fn [a b c d e f g] (run (list a b c d e f g)))
          8 (fn [a b c d e f g h] (run (list a b c d e f g h)))
          9 (fn [a b c d e f g h i] (run (list a b c d e f g h i)))
          10 (fn [a b c d e f g h i j] (run (list a b c d e f g h i j)))
          11 (fn [a b c d e f g h i j k] (run (list a b c d e f g h i j k)))
          12 (fn [a b c d e f g h i j k l] (run (list a b c d e f g h i j k l)))
          13 (fn [a b c d e f g h i j k l m] (run (list a b c d e f g h i j k l m)))
          14 (fn [a b c d e f g h i j k l m n] (run (list a b c d e f g h i j k l m n)))
          15 (fn [a b c d e f g h i j k l m n o] (run (list a b c d e f g h i j k l m n o)))
          16 (fn [a b c d e f g h i j k l m n o p] (run (list a b c d e f g h i j k l m n o p)))
          (constructor_refuse :function-arity))]
          (constructor_register_callable! value state) value))
   (constructor_refuse {:operation (:op n)}))]
  ;; An intermediate list tail or borrowed variable is already accounted for
  ;; by its allocation site. Rewalking every growing cons prefix is quadratic
  ;; and consumes the fuel before the actual aggregate admission boundary.
  ;; Full raw shape/cost checks remain at primitive inputs/results, closure
  ;; capture and final first-order output. Scalar operations are bounded here.
  (when (and (or (erlang/is_number value) (erlang/is_binary value))
             (> (erlang/external_size value) 1048576)) (constructor_refuse :scalar-size-budget))
  value)
 (finally (constructor_counter! state :depth -1))))

(defn interpret_constructor!
 [expression locals metadata]
 (BeamLisp.CompilerData/check_first_order! locals)
 (let [key (tuple :constructor-machine-frame (erlang/make_ref))
       state (Map/merge metadata {:counter-frame key :max-collection 16384})]
  (erlang/put key {:remaining 1000000 :depth 0 :allocation-nodes 1000000 :allocation-bytes 16777216 :new-atoms 64 :fresh-symbols 4096 :recipe-serial 0 :recipe-depth 0 :recipes {} :callables {}})
  (try
   (let [result (constructor_interpret expression locals state)]
    (when (constructor_recipe_present! result state) (constructor_refuse :finite-recipe-escape))
    (BeamLisp.CompilerData/check_first_order! result) result)
   (catch error
    (erlang/raise __EXCEPTION_KIND__ (constructor_diagnostic_error error nil) __STACKTRACE__))
   (finally (erlang/erase key)))))

(defn constructor_metadata [definitions values]
 ;; Compiler implementation walks use native eager collection operations, never
 ;; late-bound public Core reduce/group-by/merge or an application predicate.
 (Enum/reduce (maps/to_list definitions) {:remotes {} :globals values}
  (fn [namespace-entry metadata]
   (let [namespace (elem namespace-entry 0) bindings (elem namespace-entry 1)]
    (Enum/reduce (maps/to_list bindings) metadata
     (fn [binding-entry metadata]
      (let [binding (elem binding-entry 0) entries (elem binding-entry 1)
            grouped (Enum/group_by entries
                      (fn [entry] [(elem entry 2) (count (:params (elem entry 3)))]))
            groups (maps/to_list grouped)
            clauses (fn [items]
                      (Enum/map items (fn [entry]
                        (let [node (elem entry 3)]
                         {:pats (:params node) :guard (:guard node) :body (:body node)}))))
            remotes (Enum/reduce groups (:remotes metadata)
                      (fn [group out]
                       (let [key (elem group 0) items (elem group 1)
                             fname (first key) arity (second key)
                             value {:clauses (clauses items)}
                             shim (BeamLisp.Emit/module_for namespace)
                             body (elem (first items) 4)]
                        (Map/put (Map/put out [shim fname arity] value) [body fname arity] value))))
            fixed (Enum/reverse
                    (Enum/reduce groups (list)
                     (fn [group out]
                      (let [items (elem group 1) entry (first items)]
                       (if (= :fixed (elem entry 0))
                        (cons (list {:op :lit :val (elem entry 1)}
                                    {:op :fn :clauses (clauses items)}) out) out)))))
            variadic (Enum/find groups
                       (fn [group] (= :variadic (elem (first (elem group 1)) 0))))
            rest-node (if variadic
                        {:op :tuple :elems [{:op :lit :val (elem (first (elem variadic 1)) 1)}
                                           {:op :fn :clauses (clauses (elem variadic 1))}]}
                        {:op :lit :val nil})
            value {:op :tuple :elems [{:op :lit :val :"$blfn"}
                                     {:op :map :pairs fixed} rest-node]}]
       (assoc metadata :remotes remotes
              :globals (Map/put (:globals metadata) [namespace binding] value)))))))))

(defn constructor_call!
 ([definitions values namespace binding arguments]
  (constructor_call! definitions values {} namespace binding arguments))
 ([definitions values aliases namespace binding arguments]
 (BeamLisp.CompilerData/check_first_order! arguments)
 (interpret_constructor! {:op :apply :fn {:op :global :ns namespace :name binding}
        :args (Enum/map (BeamLisp.Ns.Rt/k-to-list arguments)
                (fn [value] {:op :lit :val value}))}
       {} (assoc (constructor_metadata definitions values) :global-aliases aliases))))


; ── authenticated compile-only SDK macro/source context ───────────────────
; AOT-owned compiler context: source data only, no runtime macro Fn values.
(defn- constructor_source_input! [namespace path content]
 (let [root (physical_sdk_path (BeamLisp.Tiers/priv_root))
       selected (physical_sdk_path (BeamLisp.Loader/source_path namespace))
       actual (physical_sdk_path path)]
  (when-not (and root actual selected (= actual selected)
                 (String/starts_with? actual (str root "/"))
                 (= content (BeamLisp.Loader/read_source actual))
                 (= namespace (BeamLisp.Loader/declared_ns content)))
   (throw (ex-info "SDK declaration staging refused"
                   {:kind :unattested-sdk-constructor-source :namespace namespace})))
  {:namespace namespace :file actual :source content :digest (crypto/hash :sha256 content)
   :compiler-key (BeamLisp.AOTCache/compiler_key)}))

(defn- constructor_context []
 (when-let [context (Process/get :bl_sdk_constructor_context)]
  (let [token (BeamLisp.Env/capture) scope (BeamLisp.Env/env_id)]
   (when-not (and (nil? (:generation token)) (nil? (:application-identity token))
                  (= true (Process/get :bl_loader_initialization_blocked))
                  (or (= :global scope) (= scope (:compiler-env context))))
    (stage-refuse :unowned-sdk-constructor-context))
   context)))
(defn- constructor_context! []
 (or (constructor_context) (stage-refuse :missing-sdk-constructor-context)))
(defn constructor_metadata_compiling?
 "True only for the actual source binding currently compiled in the private
  SDK metadata scope. It suppresses generated readiness calls, never explicit
  source calls or guards in emitted runtime code. No caller flag is accepted."
 []
 (when-let [context (constructor_context)]
  (and (= (BeamLisp.Env/env_id) (:compiler-env context))
       (Enum/any? (:compiling context)
        (fn [key]
         (and (= (first key) (BeamLisp.Env/current_ns))
              (Map/has_key? (:definitions (Map/get (:units context) (first key))) (second key))))))))
(defn- constructor_context_put! [key value]
 (Process/put :bl_sdk_constructor_context (Map/put (constructor_context!) key value)))

(defn- constructor_source_definitions [forms]
 (Enum/reduce (rest forms) {}
  (fn [form out]
   (let [head (stage-head form)]
    (if (contains? #{"defn" "defn-" "defmacro" "def"} head)
     (Map/put out (stage-symbol (second (stage-items form :list))) {:head head :form form})
     out)))))

(defn- constructor_visible! [caller owner]
 (when owner
  (let [[target _ declaration] owner
        raw-name (second (stage-items (:form declaration) :list))
        metadata (when (stage-tag? raw-name :meta 3) (elem raw-name 2))]
   (when (and (not= caller target)
               (or (= "defn-" (:head declaration))
                   (and (erlang/is_map metadata) (= true (Map/get metadata :private)))))
    (stage-refuse :private-sdk-constructor)))
  owner))

(defn- constructor_source_path! [namespace]
 ;; Context-local cache is an acceleration, never new inspection authority.
 (let [context (constructor_context) cache (if context (Map/get context :source-paths {}) {})]
  (if (and context (Map/has_key? cache namespace)) (Map/get cache namespace)
   (let [path (physical_sdk_path (BeamLisp.Loader/source_path namespace))]
    (when context (constructor_context_put! :source-paths (Map/put cache namespace path)))
    path))))

(defn- constructor_binding_metadata! [namespace binding compiled]
 ;; This stores actual ANF DATA, never a runtime binding, Fn or frame capability.
 (let [context (constructor_context!) key [namespace binding]
       cache (Map/get context :binding-metadata {})]
  (if-let [metadata (Map/get cache key)] metadata
   (let [metadata (constructor_metadata {namespace {binding (:entries compiled)}} {})]
    (constructor_context_put! :binding-metadata (Map/put cache key metadata))
    metadata))))

(defn- constructor_unit! [namespace]
 (let [context (constructor_context!)]
  (or (Map/get (:units context) namespace)
   (let [path (constructor_source_path! namespace)
         content (when path (BeamLisp.Loader/read_source path))
         source (constructor_source_input! namespace path content)
         forms (BeamLisp.Reader/read_string content path)
         header (stage-requires (first forms))
         unit (Map/merge source {:forms forms :header header
                                :definitions (constructor_source_definitions forms)})]
    (when (>= (erlang/map_size (:units context)) 256) (stage-refuse :sdk-constructor-unit-budget))
    (constructor_context_put! :units (Map/put (:units (constructor_context!)) namespace unit))
    (constructor_context_put! :remote-entries {})
    ;; Compiler metadata is isolated from both the application and inherited
    ;; mutable SDK definition tables. No source initializer is evaluated.
    (BeamLisp.Env/with_env (:compiler-env context)
     (fn []
      (BeamLisp.Env/declare_ns namespace)
      (BeamLisp.Env/put_ns_defs namespace {})
      ;; Mask inherited mutable bindings and fallback links before prelinking
      ;; the actual source. Native/protocol/generated declarations also shadow
      ;; Core, even when they have no ordinary defn body to interpret.
      (let [module (BeamLisp.Emit/module_for namespace)
            kernel (:kernel-values (constructor_context!))]
       (Enum/each (Map/keys (BeamLisp.Loader/source_decls namespace))
        (fn [binding]
         ;; Compiled Compiler helpers keep canonical attested Core callables;
         ;; Source ownership never reads them. Never blank the iterator's own
         ;; Core runtime halfway through this metadata transition.
         (BeamLisp.Env/intern namespace binding
           (when (= "core" namespace) (Map/get kernel binding)))
         (BeamLisp.Env/put_link namespace binding (tuple module {} nil)))))
      (doseq [kind [:alias :refer]
              row (BeamLisp.Env/match (tuple (tuple kind namespace :"$1") :_))]
       (BeamLisp.Env/put_key (tuple kind namespace (first row)) nil))
      (BeamLisp.Env/add_core_excludes namespace (list))
      (doseq [pair (Map/get (:metadata header) :aliases)]
       (BeamLisp.Env/add_alias namespace (elem pair 0) (elem pair 1)))
      (doseq [target (:requires header)] (constructor_unit! target))
      (doseq [pair (Map/get (:metadata header) :refers)]
       (BeamLisp.Env/add_refer namespace (elem pair 0) (elem pair 1)))
      (doseq [target (Map/get (:metadata header) :refer_alls)]
       (constructor_unit! target)
       (doseq [declaration (Map/to_list (BeamLisp.Loader/source_decls target))]
        (when-not (= :private (elem declaration 1))
         (BeamLisp.Env/add_refer namespace (elem declaration 0) target))))
      (doseq [form (rest forms)]
       (BeamLisp.Compiler/prelink_defn form namespace)
       (BeamLisp.Compiler/prelink_type form namespace))))
    unit))))

(defn- constructor_source_owner_uncached [namespace name]
 ;; Source ownership exists only for an actual selected Source file. Native
 ;; kernel aliases have no Source unit; they are resolved independently below.
 (when (constructor_source_path! namespace)
 (let [unit (constructor_unit! namespace) metadata (:metadata (:header unit))
       aliases (Map/new (Map/get metadata :aliases (list)))
       refers (Map/new (Map/get metadata :refers (list)))
       parts (String/split name "/")
       maybe-definition
        (fn [target binding]
         (let [path (constructor_source_path! target)
               root (physical_sdk_path (BeamLisp.Tiers/priv_root))]
          ;; Ordinary native interop names have no SDK source declaration. They
          ;; remain ordinary calls and must pass the closed machine adapter.
          (when (and root path (String/starts_with? path (str root "/")))
           (Map/get (:definitions (constructor_unit! target)) binding))))]
  (if (= 2 (count parts))
   (let [prefix (first parts) target (Map/get aliases prefix)
         target (or target (when (= "clojure.core" prefix) "core")
                          (when-not (Regex/match? (Regex/compile! "^[A-Z]") prefix) prefix))]
    (when target
     (when-let [definition (maybe-definition target (second parts))]
      (constructor_visible! namespace [target (second parts) definition]))))
   (let [local (Map/get (:definitions unit) name)
         referred (Map/get refers name)
         local-declaration (BeamLisp.Loader/source_decl namespace name)]
    (cond local [namespace name local]
          ;; An opaque source-owned native/protocol declaration still owns its
          ;; lexical name. It may not fall through to a Core source helper.
          (some? local-declaration) nil
          referred (when-let [definition (maybe-definition referred name)]
                     (constructor_visible! namespace [referred name definition]))
          :else
           (loop [providers (erlang/++ (Map/get metadata :refer_alls (list)) (list "core" "sugar"))]
            (when (seq providers)
             (let [provider (first providers)
                   declaration (BeamLisp.Loader/source_decl provider name)
                   definition (maybe-definition provider name)]
              (cond
               (= :private declaration) (recur (rest providers))
               definition (constructor_visible! namespace [provider name definition])
               (some? declaration) nil
               :else (recur (rest providers)))))))))))
)

(defn- constructor_source_owner [namespace name]
 (if-let [context (constructor_context)]
  (let [key [namespace name] cache (Map/get context :source-owners {})]
   (if (Map/has_key? cache key) (Map/get cache key)
    (let [owner (constructor_source_owner_uncached namespace name)]
     (constructor_context_put! :source-owners
      (Map/put (Map/get (constructor_context!) :source-owners {}) key owner))
     owner)))
  (constructor_source_owner_uncached namespace name)))

(defn- constructor_initializer! [compiled namespace binding]
 (let [node (if (= :let (:op compiled)) (:init compiled) compiled)
       args (:args node)]
  (when-not (and (= :remote (:op node)) (= :Elixir.BeamLisp.Env (:mod node))
                 (= :intern (:fun node)) (= 3 (count args))
                 (= namespace (:val (first args))) (= binding (:val (second args))))
   (stage-refuse :unsupported-sdk-constructor-initializer))
  (nth args 2)))

(defn- constructor_compile_binding! [namespace binding]
 (let [context (constructor_context!) key [namespace binding]]
  (if-let [cached (Map/get (:compiled context) key)] cached
   (let [unit (constructor_unit! namespace) declaration (Map/get (:definitions unit) binding)]
    (when-not declaration (stage-refuse :missing-sdk-constructor-definition))
    (when (contains? (:compiling (constructor_context!)) key)
     (stage-refuse :cyclic-sdk-constructor-compilation))
    (constructor_context_put! :compiling (conj (:compiling (constructor_context!)) key))
    (try
     (let [compiled
           (BeamLisp.Env/with_env (:compiler-env context)
            (fn []
             (let [previous (BeamLisp.Env/current_ns)]
              (try
               (BeamLisp.Env/in_ns namespace)
               (let [env (Map/put (BeamLisp.Compiler/new_env namespace) :file (:file unit))]
                (case (:head declaration)
                 "defn" (do (stage-function! (:form declaration) namespace (:file unit))
                             {:kind :function :entries (BeamLisp.Env/ns_definition namespace binding)})
                 "defn-" (do (stage-function! (:form declaration) namespace (:file unit))
                              {:kind :function :entries (BeamLisp.Env/ns_definition namespace binding)})
                 "defmacro" {:kind :macro
                              :expression (constructor_initializer!
                                            (BeamLisp.Compiler/compile (:form declaration) env) namespace binding)}
                 "def" (let [values (Map/get (capture_value_def {} (:form declaration) namespace) namespace)
                             entry (first values)]
                          (when-not (and entry (= binding (elem entry 0)))
                           (stage-refuse :unsupported-sdk-constructor-value))
                          {:kind :value :expression (compile_initializer (elem entry 2) env)})
                 (stage-refuse :unsupported-sdk-constructor-binding)))
               (finally (BeamLisp.Env/in_ns previous))))))]
      (constructor_context_put! :compiled (Map/put (:compiled (constructor_context!)) key compiled))
      compiled)
     (finally (constructor_context_put! :compiling (disj (:compiling (constructor_context!)) key))))))))

(defn- constructor_function_expression [namespace binding compiled]
 (Map/put (Map/get (:globals (constructor_binding_metadata! namespace binding compiled)) [namespace binding])
          :constructor-binding [namespace binding]))

(defn- constructor_global_source [namespace name]
 (when-let [owner (constructor_source_owner namespace name)]
  (let [[target binding _] owner contextual (constructor_contextual_expression target binding)
        compiled (when-not contextual (constructor_compile_binding! target binding))]
   (if contextual contextual
   (case (:kind compiled)
    :function (constructor_function_expression target binding compiled)
    :value (:expression compiled)
    :macro (stage-refuse :sdk-macro-used-as-runtime-value)
    (stage-refuse :unsupported-sdk-constructor-binding))))))

(defn- constructor_remote_source_uncached [module function arity]
 (let [units (:units (constructor_context!))
       candidates (Enum/uniq (erlang/++ (Map/keys units)
                     (Enum/flat_map (Map/values units) (fn [unit] (:requires (:header unit))))))
       namespace (Enum/find candidates (fn [ns] (= module (BeamLisp.Emit/module_for ns))))
       raw (Atom/to_string function)
       binding (if (String/ends_with? raw "__bl_v") (String/replace_suffix raw "__bl_v" "") raw)]
  (when namespace
   (when-not (Map/has_key? (:definitions (constructor_unit! namespace)) binding)
    (stage-refuse :missing-sdk-constructor-definition))
   (if-let [contextual (constructor_contextual_expression namespace binding)]
    {:clauses (:clauses contextual)}
    (let [compiled (constructor_compile_binding! namespace binding)]
    (when-not (= :function (:kind compiled)) (stage-refuse :non-function-sdk-constructor-call))
    (let [entry (Map/get (:remotes (constructor_binding_metadata! namespace binding compiled))
                         [module function arity])]
     (if entry (Map/put entry :constructor-binding [namespace binding])
      (stage-refuse :sdk-constructor-call-arity))))))))

(defn- constructor_remote_source [module function arity]
 (let [context (constructor_context!) key [module function arity]
       cache (Map/get context :remote-entries {})]
  (if (Map/has_key? cache key) (Map/get cache key)
   (let [entry (constructor_remote_source_uncached module function arity)]
    (constructor_context_put! :remote-entries
     (Map/put (Map/get (constructor_context!) :remote-entries {}) key entry))
    entry))))

(defn staged_macro_kind
 "Inspect authenticated Source declaration metadata without compiling or
  invoking a macro. Syntax-quote name classification must not compile itself."
 [namespace name]
 (if-not (constructor_context) :inactive
  (let [owner (constructor_source_owner namespace name)]
   (if (and owner (= "defmacro" (:head (nth owner 2)))) :macro :not-macro))))

(defn staged_macro_lookup
 "Compiler-only source macro resolution. :inactive preserves ordinary dev
  lookup; an active result never fetches or invokes a mutable macro binding."
 [namespace name]
 (if-not (constructor_context) :inactive
  (let [owner (constructor_source_owner namespace name)]
   (tuple :active
    (when (and owner (= "defmacro" (:head (nth owner 2))))
     (let [[target binding _] owner
           _ (when (and (= target (:namespace (:input (constructor_context!))))
                         (not (contains? (:seen-macros (constructor_context!)) [target binding])))
               (stage-refuse :sdk-stage-local-macro-not-initialized))
           compiled (constructor_compile_binding! target binding)
           initializer (:expression compiled)]
      (when-not (and (= :tuple (:op initializer)) (= 2 (count (:elems initializer)))
                     (= :"$macro" (:val (first (:elems initializer)))))
       (stage-refuse :unsupported-sdk-constructor-macro))
      (fn [& arguments]
       (let [context (constructor_context!) remaining (dec (:macro-steps context))]
        (when (neg? remaining) (stage-refuse :sdk-constructor-macro-budget))
        (constructor_context_put! :macro-steps remaining))
       (let [previous (Map/get (constructor_context!) :diagnostic-macro)]
        (try
         (constructor_context_put! :diagnostic-macro [target binding])
         (interpret_constructor!
          {:op :apply :fn (second (:elems initializer))
           :args (Enum/map (to-list arguments) (fn [value] {:op :lit :val value}))} {} {})
         (finally (constructor_context_put! :diagnostic-macro previous)))))))))))

(defn- constructor_core_seed_rows! []
 ;; Read a zero-arg literal from the actual manifest-authenticated boot unit.
 ;; No mutable Core macro/function value is executed to discover this ABI.
 (or (:core-rows (constructor_context!))
 (let [shim :Elixir.BeamLisp.Ns.Rt
       proof (seed_dependency! shim)
       definitions (when proof (erlang/apply shim :__bl_ns_defs__ (list)))
       entries (Map/get definitions "seed-rows")
       entry (when (= 1 (count entries)) (first entries))
       node (when entry (elem entry 3)) body (when node (:body node))
       provider (when entry (elem entry 4))]
  (when-not (and proof entry (= :fixed (elem entry 0)) (= 0 (elem entry 1))
                 (empty? (:params node)) (nil? (:guard node)) (= :lit (:op body))
                 (seed_dependency! provider))
   (stage-refuse :unattested-core-constructor-abi))
  (constructor_context_put! :core-provider provider)
  (constructor_context_put! :core-rows (:val body))
  (:val body))))

(defn- constructor_kernel_alias_rows! []
 (let [context (constructor_context)]
  (or (when context (:cpp-rows context))
 (let [context (constructor_context)
       shim :Elixir.BeamLisp.Ns.Rt
       proof (if context (do (constructor_kernel_module! shim) true) (seed_dependency! shim))
       definitions (when proof (erlang/apply shim :__bl_ns_defs__ (list)))
       entries (Map/get definitions "seed-cpp-rows")
       entry (when (= 1 (count entries)) (first entries))
       node (when entry (elem entry 3)) body (when node (:body node))
       provider (when entry (elem entry 4))]
  (when-not (and proof entry (= :fixed (elem entry 0)) (= 0 (elem entry 1))
                 (empty? (:params node)) (nil? (:guard node)) (= :lit (:op body))
                 (if context (do (constructor_kernel_module! provider) true) (seed_dependency! provider)))
   (stage-refuse :unattested-kernel-alias))
   (when context (constructor_context_put! :cpp-rows (:val body)))
   (:val body)))))

(defn- constructor_kernel_alias! [namespace name state]
 ;; Exact literal seed metadata, authenticated by the canonical boot manifest
 ;; and actual loaded code. No runtime Env alias value/callback is borrowed.
 (when-not (= "cpp" namespace) (stage-refuse :unattested-kernel-alias))
 (let [rows (constructor_kernel_alias_rows!)]
  (let [matches (Enum/filter rows (fn [row] (= name (first row))))]
   (when-not (= 1 (count matches)) (stage-refuse :unsupported-kernel-alias))
   (let [row (first matches) module (second row) fixed (nth row 2) variadic (nth row 3)]
    (when-not (and (erlang/is_map fixed) (nil? variadic))
     (stage-refuse :unsupported-kernel-alias-signature))
    (constructor_register_callable! (fn [& arguments]
     (let [arguments (to-list arguments) function (Map/get fixed (count arguments))
           module (if (= :rt module) :Elixir.BeamLisp.Ns.Rt module)]
      (when-not (and (Map/has_key? fixed (count arguments)) (erlang/is_atom function))
       (constructor_refuse :kernel-alias-arity))
      ;; An authenticated seed route is NOT a permission to call it. Every
      ;; invocation still crosses the existing exact closed primitive boundary.
      (constructor_primitive module function arguments state))) state)))))

(defn- constructor_kernel_module! [module]
 (when-not (contains? (:kernel-modules (constructor_context!)) module)
  ;; Retain before the authoritative byte check; no captured native helper may
  ;; execute between successful attestation and a concurrent code replacement.
  (when-not (seed_dependency! module) (stage-refuse :unattested-compiler-kernel))
  (let [handle (BeamLisp.Env/retain_code! (list module))]
   (constructor_context_put! :kernel-leases
     (cons handle (:kernel-leases (constructor_context!))))
   (when-not (seed_dependency! module) (stage-refuse :unattested-compiler-kernel))
   (constructor_context_put! :kernel-modules
     (conj (:kernel-modules (constructor_context!)) module)))))

(defn- constructor_kernel_definitions! []
 (let [module :Elixir.BeamLisp.Ns.Core
       _ (constructor_kernel_module! module)
       definitions (erlang/apply module :__bl_ns_defs__ (list))]
  (when-not (erlang/is_map definitions) (stage-refuse :invalid-compiler-kernel-definitions))
  (Enum/reduce (Map/to_list definitions) {}
   (fn [binding output]
    (let [name (elem binding 0)
          signature
           (Enum/reduce (elem binding 1) {:fixed {} :rest nil}
            (fn [entry signature]
             (when-not (and (erlang/is_tuple entry) (= 5 (erlang/tuple_size entry)))
              (stage-refuse :invalid-compiler-kernel-entry))
             (let [kind (elem entry 0) arity (elem entry 1) function (elem entry 2)
                   node (elem entry 3) body (elem entry 4)
                   native-arity (if (= :variadic kind) (inc arity) arity)]
              (when-not (and (contains? #{:fixed :variadic} kind)
                             (erlang/is_integer arity) (<= 0 arity 255)
                             (erlang/is_atom function) (erlang/is_atom body)
                             (= :defn-clause (:op node)) (= function (:fname node))
                             (= native-arity (count (:params node))))
               (stage-refuse :unattested-compiler-kernel-entry))
              (constructor_kernel_module! body)
              (when-not (erlang/function_exported body function native-arity)
               (stage-refuse :unattested-compiler-kernel-entry))
              (let [capture (erlang/make_fun body function native-arity)]
               (if (= :fixed kind)
                (let [previous (Map/get (:fixed signature) arity)]
                 (when (and previous (not= previous capture))
                  (stage-refuse :ambiguous-compiler-kernel-entry))
                 (assoc signature :fixed (Map/put (:fixed signature) arity capture)))
                (let [value (tuple arity capture) previous (:rest signature)]
                 (when (and previous (not= previous value))
                  (stage-refuse :ambiguous-compiler-kernel-entry))
                 (assoc signature :rest value)))))))
          fixed (:fixed signature) variadic (:rest signature)
          value (if (and (= 1 (erlang/map_size fixed)) (nil? variadic))
                  (elem (first (Map/to_list fixed)) 1)
                  (tuple :"$blfn" fixed variadic))]
     (Map/put output name value))))))

(defn- constructor_install_kernel! []
 ;; Only compiler-owned seed construction executes here, into this disposable
 ;; private Env. Rt.seed_core creates callable/link tables and closures; it
 ;; invokes no provider initializer, process operation or supplied callback.
 (constructor_kernel_module! :Elixir.BeamLisp.Ns.Rt)
 (constructor_kernel_module! :Elixir.BeamLisp.Ns.Core)
 (constructor_core_seed_rows!)
 (constructor_kernel_module! (:core-provider (constructor_context!)))
 (let [definitions (constructor_kernel_definitions!)]
  (erlang/apply :Elixir.BeamLisp.Ns.Rt :seed_core (list))
  (Enum/each (Map/to_list definitions)
   (fn [binding] (BeamLisp.Env/intern "core" (elem binding 0) (elem binding 1))))
  (let [values (Map/new (Enum/map (BeamLisp.Env/match_own (tuple (tuple "core" :"$1") :"$2"))
                         (fn [binding] (tuple (first binding) (second binding)))))]
   ;; Publish only attested values into the private kernel. Native iteration
   ;; never depends on a mutable/temporarily absent Core/run! or reduced?.
   (Enum/each (BeamLisp.Env/match (tuple (tuple "core" :"$1") :_))
    (fn [binding]
     (let [name (first binding)]
      (when-not (Map/has_key? values name)
       (BeamLisp.Env/intern "core" name nil)
       (BeamLisp.Env/put_link "core" name (tuple :Elixir.BeamLisp.Ns.Core {} nil))))))
   (constructor_context_put! :kernel-values values))))

(defn- constructor_core_primitive! [name]
 (let [rows (constructor_core_seed_rows!)
       row (Enum/find rows (fn [row]
                             (and (= name (first row)) (not= :link (nth row 4)))))
       expected (when row
                  (let [module (if (= :rt (second row)) :Elixir.BeamLisp.Ns.Rt (second row))
                        fixed (nth row 2) rest (nth row 3)
                        capture (fn [arity function] (erlang/make_fun module function arity))]
                   (if (and (= 1 (erlang/map_size fixed)) (nil? rest))
                    (let [pair (first (Map/to_list fixed))] (capture (elem pair 0) (elem pair 1)))
                    (tuple :"$blfn" (Map/new (Enum/map (Map/to_list fixed)
                                             (fn [pair] (tuple (elem pair 0) (capture (elem pair 0) (elem pair 1))))))
                           (when rest (tuple (first rest) (capture (inc (first rest)) (second rest))))))))
       ;; Source metadata masks may be active. ABI authority is the actual
       ;; global kernel binding, never a private compiler reconstruction.
       actual (BeamLisp.Env/with_env :global
                (fn [] (BeamLisp.Env/lookup (tuple "core" name))))]
  (and expected (contains? (constructor_pure_core_names) name)
       (= (tuple :ok expected) actual))))

(defn- constructor_contextual_expression [namespace binding]
 ;; These are compiler phase projections, never runtime permissions. SDK source
 ;; is not an application owner; provider callbacks are still interpreted from
 ;; actual selected source. No mutable declaration registry or native Fn escapes.
 (when (= "reload.declaration" namespace)
  (case binding
   "preparing?" {:op :fn :clauses (list {:pats (list) :guard nil :body {:op :lit :val true}})}
   "managed?" {:op :fn :clauses (list {:pats (list) :guard nil :body {:op :lit :val false}})}
   "compilation-clause"
    {:op :fn :clauses (list {:pats (list {:pop :pvar :name "clause"}) :guard nil
                             :body {:op :remote :mod :Elixir.BeamLisp.AOT :fun :constructor_selected_clause!
                                    :args (list {:op :var :name "clause"})}})}
   nil)))

(defn- constructor_selected_clause! [ident state]
 (let [context (constructor_context!)
       local (Map/get (:clauses context) ident)
       descriptors (constructor_interpret
                     (constructor_global_source "proc.server" "CLAUSE-DESCRIPTORS") {} state)
       descriptor (or local (Map/get descriptors (name ident)))]
  (when descriptor
   (let [[namespace binding] descriptor]
    (constructor_interpret (constructor_global_source namespace binding) {} state)))))

(defn- constructor_check_sources! []
 (when-not (= (:compiler-key (:input (constructor_context!))) (BeamLisp.AOTCache/current_compiler_key))
  (stage-refuse :sdk-constructor-compiler-changed))
 (Enum/each (Map/to_list (Map/get (constructor_context!) :source-paths {}))
  (fn [selection]
   (when-not (= (elem selection 1) (physical_sdk_path (BeamLisp.Loader/source_path (elem selection 0))))
    (stage-refuse :sdk-constructor-source-selection-changed))))
 (doseq [unit (Map/values (:units (constructor_context!)))]
  (constructor_source_input! (:namespace unit) (:file unit) (:source unit))
  (when-not (= (:compiler-key unit) (BeamLisp.AOTCache/compiler_key))
   (stage-refuse :sdk-constructor-compiler-changed)))
 (when-let [provider (:core-provider (constructor_context!))]
  (when-not (seed_dependency! :Elixir.BeamLisp.Ns.Rt) (stage-refuse :unattested-compiler-kernel))
  (when-not (seed_dependency! provider) (stage-refuse :unattested-compiler-kernel)))
 (doseq [module (:kernel-modules (constructor_context!))]
  (when-not (seed_dependency! module) (stage-refuse :unattested-compiler-kernel))))

(defn- constructor_compile_sdk_unit! [source opts]
 ;; Only authenticated source data enters this boundary; no caller callback can
 ;; execute after detaching application authority. Clear it before even the
 ;; temporary compiler Env is allocated, and restore it on every exit.
 (let [file (Keyword/get opts :file)
       namespace (BeamLisp.Loader/declared_ns source)
       proof (constructor_source_input! namespace file source)
       previous (BeamLisp.Env/capture)
       previous-context (Process/get :bl_sdk_constructor_context)
       previous-attempt (Process/get :bl_initializer_attempt)
       dirs (BeamLisp.Tiers/dirs)]
  (BeamLisp.Loader/without_initialization
   (fn []
    (BeamLisp.Env/with_env :global
     (fn []
      (try
       (BeamLisp.Env/bind (Map/merge (BeamLisp.Env/capture)
                           {:generation nil :application-identity nil :admission nil :query-functions nil
                            :loader-ambient dirs :loader-resolution (tuple dirs dirs (list))}))
       (Process/delete :bl_initializer_attempt)
       (let [view (BeamLisp.Env/fork :global)]
        (try
         (Process/put :bl_sdk_constructor_context
           {:input proof :compiler-env view :units {} :compiled {} :compiling #{} :clauses {} :seen-macros #{}
            :kernel-modules #{} :kernel-leases (list)
            :macro-steps 16384 :new-atoms 128 :expanded 0})
         (BeamLisp.Env/with_env view (fn [] (constructor_install_kernel!)))
         (constructor_unit! namespace)
         (let [result (BeamLisp.Env/with_env view
                        (fn [] (compile_source_unit_impl source opts)))]
          (constructor_check_sources!)
          ;; Compilation/emission borrowed only the disposable canonical
          ;; compiler kernel. Complete artifact authority is published from
          ;; the actual global SDK scope; no initializer ran in either scope.
          (register_sdk_emission! source file result)
          result)
         (finally
          (try
           (doseq [handle (:kernel-leases (Process/get :bl_sdk_constructor_context))]
            (BeamLisp.Env/release_code! handle))
           (finally (BeamLisp.Env/destroy view))))))
       (finally
        (if previous-context (Process/put :bl_sdk_constructor_context previous-context)
          (Process/delete :bl_sdk_constructor_context))
        (BeamLisp.Env/bind previous)
        (if previous-attempt (Process/put :bl_initializer_attempt previous-attempt)
          (Process/delete :bl_initializer_attempt))))))))))

(defn- constructor_sdk_input? [source opts]
 (let [root (physical_sdk_path (BeamLisp.Tiers/priv_root))
       file (physical_sdk_path (Keyword/get opts :file))]
  (and root file (String/starts_with? file (str root "/")))))

(defn- sdk_checked_private? [form]
  ;; These exact metadata-lowering helpers also exist in the coherent recovery
  ;; Compiler. Do not call a newly added Compiler ABI before boot regeneration.
  ;; The caller has already accepted the expanded special-form declaration.
  (let [head (stage-head form)
        args (rest (stage-items form :list))
        author (erlang/apply :Elixir.BeamLisp.Ns.Compiler :name-author-meta (list (first args)))
        remaining (rest args)
        remaining (if (and (seq remaining) (erlang/is_binary (stage-unmeta (first remaining)))
                           (seq (rest remaining))) (rest remaining) remaining)
        attrs (if (and (contains? #{"defn" "defn-"} head) (seq remaining)
                       (stage-tag? (stage-unmeta (first remaining)) :map 2))
                (erlang/apply :Elixir.BeamLisp.Ns.Compiler :attr-kvs->map
                  (list (stage-unmeta (first remaining)))) {})
        metadata (erlang/apply :Elixir.BeamLisp.Ns.Compiler :var-meta-map
                   (list nil (= "defn-" head) (maps/merge author attrs)))]
    (and (erlang/is_map metadata) (= true (maps/get :private metadata false)))))

(defn- sdk_record_declaration! [form namespace bindings kind]
  (when (constructor_context)
    (let [private? (sdk_checked_private? form)
          declarations (Map/get (constructor_context!) :declarations {})
          names (Map/get declarations namespace {})
          kinds (Map/get declarations :callable-kinds {})
          prior-kinds (Map/get kinds namespace {})]
      (constructor_context_put! :declarations
        (Map/put (Map/put declarations namespace
          (Enum/reduce bindings names
            (fn [binding out] (Map/put out binding (if private? :private kind)))))
         :callable-kinds (Map/put kinds namespace (Enum/reduce bindings prior-kinds
           (fn [binding out] (Map/put out binding (sdk_callable_kind (stage-head form)))))))))))

(defn- constructor_record_definition! [form namespace]
 (when-let [context (constructor_context)]
  (let [head (stage-head form)]
   (when (contains? #{"defn" "defn-" "defmacro" "def"} head)
    (let [binding (stage-symbol (second (stage-items form :list)))
          unit (constructor_unit! namespace)
          declaration {:head head :form form}
          unit (Map/put unit :definitions (Map/put (:definitions unit) binding declaration))]
     (constructor_context_put! :units (Map/put (:units (constructor_context!)) namespace unit))
     (when (= "defmacro" head)
      (constructor_context_put! :seen-macros (conj (:seen-macros (constructor_context!)) [namespace binding])))
     (constructor_context_put! :compiled (Map/delete (:compiled (constructor_context!)) [namespace binding]))
     (constructor_context_put! :binding-metadata
      (Map/delete (Map/get (constructor_context!) :binding-metadata {}) [namespace binding]))
     (constructor_context_put! :source-owners {})
     (constructor_context_put! :remote-entries {}))))))

(defn- constructor_record_clause! [form namespace]
 (when (constructor_context)
  (let [items (stage-items form :list) ident-node (stage-unmeta (second items))
        transform-node (stage-unmeta (nth items 2 nil))]
   (when-not (and (= 3 (count items)) (stage-tag? ident-node :keyword 2)
                  (stage-tag? transform-node :symbol 2))
    (stage-refuse :unsupported-sdk-constructor-clause))
   (let [ident (erlang/apply :Elixir.BeamLisp.Ns.Compiler :datum (list ident-node))
         owner (constructor_source_owner namespace (elem transform-node 1))]
    (when-not (and owner (contains? #{"defn" "defn-"} (:head (nth owner 2))))
     (stage-refuse :unowned-sdk-constructor-clause))
    (constructor_context_put! :clauses
      (Map/put (:clauses (constructor_context!)) ident [(first owner) (second owner)]))))))

(defn- stage-sdk-forms! [forms namespace file values defined]
 (if (empty? forms) (tuple values defined)
  (let [form (first forms)
        _ (constructor_record_definition! form namespace)
        _ (when (constructor_context)
            (let [owner (constructor_source_owner namespace (stage-head form))]
             (when (and owner (= "proc.server" (first owner)) (= "extend-clause!" (second owner)))
              (constructor_record_clause! form namespace))))
        expanded (if (constructor_context) (BeamLisp.Compiler/macroexpand_1 form namespace) form)]
   (if (not= expanded form)
    (let [context (constructor_context!) size (inc (:expanded context))
          node (stage-unmeta expanded)
          parts (when (and (stage-tag? node :list 2)
                           (= "do" (stage-symbol (first (elem node 1))))) (rest (elem node 1)))]
     (when (> size 16384) (stage-refuse :sdk-constructor-expansion-budget))
     (constructor_context_put! :expanded size)
     (stage-sdk-forms! (erlang/++ (or parts (list expanded)) (rest forms)) namespace file values defined))
    (let [head (stage-head form)
          _ (do (BeamLisp.Compiler/prelink_defn form namespace)
                (BeamLisp.Compiler/prelink_type form namespace))
          value
           (case head
            "defn" (do (stage-function! form namespace file) values)
            "defn-" (do (stage-function! form namespace file) values)
            "defnative" values
            "defmacro" (do (BeamLisp.Compiler/compile form (Map/put (BeamLisp.Compiler/new_env namespace) :file file))
                           (append-staged-value values form namespace))
            "defprotocol" (do (BeamLisp.Compiler/compile form (Map/put (BeamLisp.Compiler/new_env namespace) :file file))
                              (append-staged-value values form namespace))
            "extend-type" (do (BeamLisp.Compiler/compile form (Map/put (BeamLisp.Compiler/new_env namespace) :file file))
                              (append-staged-value values form namespace))
            "extend-protocol" (do (BeamLisp.Compiler/compile form (Map/put (BeamLisp.Compiler/new_env namespace) :file file))
                                  (append-staged-value values form namespace))
            "defserver" (do (stage-server! form namespace file) (append-staged-value values form namespace))
            "defrecord" (do (stage-class! form namespace file) (append-staged-value values form namespace))
            "deftype" (do (stage-class! form namespace file) (append-staged-value values form namespace))
            "declare" (do (doseq [name (rest (stage-items form :list))]
                            (let [name (stage-symbol name)]
                             (when-not (BeamLisp.Env/local_var? namespace name) (BeamLisp.Env/intern namespace name nil)))) values)
            "def" (append-staged-value values form namespace)
            (if-let [extension (stage-clause-extension form namespace)]
             (do (constructor_record_clause! form namespace) (append-staged-value values extension namespace))
             (append-staged-action values form namespace file)))
          _ (when (contains? #{"defn" "defn-" "defmacro" "def"} head)
              (sdk_record_declaration! form namespace (list (stage-symbol (second (stage-items form :list))))
                (case head "defmacro" :macro
                  "def" (let [raw (second (stage-items form :list))]
                          (if (and (stage-tag? raw :meta 3) (erlang/is_map (elem raw 2))
                                   (= true (Map/get (elem raw 2) :per-env))) :public :value))
                  :public)))
          names (if (contains? #{"defn" "defn-"} head)
                  (Map/put defined namespace
                    (MapSet/put (Map/get defined namespace (MapSet/new))
                                (stage-symbol (second (stage-items form :list))))) defined)]
     (stage-sdk-forms! (rest forms) namespace file value names))))))

(defn- constructor_core_owner? [namespace name lookup]
 ;; A missing exact/qualified or explicitly referred binding may not silently
 ;; become a same-named Core primitive. Source declarations, not live values,
 ;; decide the lexical shadow before the kernel ABI is checked.
 (let [parts (String/split name "/")]
  (cond
   (= 2 (count parts))
    (let [unit (constructor_unit! namespace)
          aliases (Map/new (Map/get (:metadata (:header unit)) :aliases (list)))
          target (or (Map/get aliases (first parts)) (first parts))]
     (contains? #{"core" "clojure.core"} target))
   (= "core" namespace) true
   (= :exact lookup) false
   :else
    (let [unit (constructor_unit! namespace) metadata (:metadata (:header unit))
          refers (Map/new (Map/get metadata :refers (list)))]
     (and (not (Map/has_key? refers name))
          (nil? (BeamLisp.Loader/source_decl namespace name))
          (not (Enum/any? (Map/get metadata :refer_alls (list))
                 (fn [target] (some? (BeamLisp.Loader/source_decl target name))))))))))
