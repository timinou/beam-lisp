; host/aot.bl — the pinned HOST MODULE for `Elixir.BeamLisp.AOT`.
;
; This file is not a namespace. It is a `.bl` SOURCE that the bootstrap seed
; compiles with `BeamLisp.AOT/compile-host-file` into ONE exact-named beam
; (`Elixir.BeamLisp.AOT.beam`) whose top-level `defn`s are plain exported
; functions — the exact call surface every caller already names at
; `Elixir.BeamLisp.AOT`, so no caller is renamed. The pinned beam is committed
; into the floor (`priv/bootstrap/seed/`) and installed by
; `Bootstrap.install!/1`.
;
; WHY A PINNED MODULE AND NOT A NAMESPACE. `AOT` is the module that TURNS a
; `.bl` source into a beam, so it cannot itself be an AOT-rebuilt
; `BeamLisp.Ns.*` namespace: that would be the bootstrap circle. It is also
; asked a question BEFORE the language exists — `bin/bl`'s generated bootstrap
; reads `AOT.beam_provenance/1` for every boot namespace to decide whether
; `build/` holds one generation, and that read happens before
; `ensure_all_started`. A pinned host beam is a fixed artifact named by the
; seed manifest, built by one generation and used by the next.
;
; ── THE PREBOOT CONSTRAINT: NO Rt, NO core ──────────────────────────────────
;
; The functions on the launcher's path MUST run with nothing on the code path
; but Elixir/OTP, the other pinned host leaves, and this beam. That set is
; `ensure_loaded/1` → `stale?/2` → `stale_by_provenance?/2`/`tier_key_moved?/2`,
; `staging_namespaces/0`, `note_mixed_generation/0`, `beam_provenance/1`,
; `strict_aot?/0`, `stale_beam_error/4`, `short/1`. (The `:library` branch of
; `stale_by_provenance?` reaches `ns_closure_hash/2`, which the language drives
; and which is only reached once `core` is interned; it may use the runtime.)
; Those functions are written in the surface the BEAM itself provides:
;
;   * `erlang/==`, `erlang/=/=`, `erlang/is_binary`, `erlang/is_tuple`,
;     `erlang/is_list`, `erlang/is_map`, `erlang/is_atom`, `erlang/element`,
;     `erlang/tuple_size`, `erlang/apply`, `erlang/function_exported` are BIFs.
;     `=`, `nil?`, `some?`, `str`, `first`… would each compile to an
;     `BeamLisp.Ns.Rt` call or a core var fetch.
;   * `and`/`or`/`cond`/`when`/`if`/`try` are macros — they expand at compile
;     time into `if`/`let`, which emit nothing at runtime.
;   * `Enum`, `String`, `Code`, `Process`, `Application` and the pinned
;     `Tiers`/`Bootstrap` modules are host modules, on the path in any `elixir`
;     VM, and the same modules the Elixir twin called.
;
; ── ABI PARITY IS THE CONTRACT ──────────────────────────────────────────────
;
; Every function below reproduces its Elixir counterpart clause for clause —
; the same traversal, the same evaluation order, the same return types, the
; same exception class. The shapes that are easy to get subtly wrong and are
; therefore deliberate:
;
;   * `[]`/`%{}` in the Elixir source are a LIST and a MAP, never a bl vector
;     or a struct. In this file they are written `(list)` and `{}`. A `[]`
;     literal would be a `BeamLisp.Vector` and would change the emitted term.
;
;   * a multi-clause Elixir head with a guard is one `defn` with clause arrows;
;     the guard vocabulary is the BEAM's, so `is_map`/`is_binary` become `map?`
;     / `string?` when a guard can carry them and a body test otherwise.
;
;   * `case` IS NOT A PATTERN MATCH in beam-lisp — it expands to `cond` over
;     `=` and cannot bind. Every destructuring `case` in the Elixir twin is
;     spelled here as a `cond`/`if` over `erlang/is_tuple` + `erlang/element`,
;     with the same clause ORDER, so an unmatched clause still fails the same
;     way (a `FunctionClauseError` where the Elixir clause raised, or the same
;     `argument error`).
;
;   * `raise ArgumentError, msg` is `erlang/error(ArgumentError.exception(msg))`
;     — the same `:error`-class exception struct a caller's `rescue` reads.
;
;   * a sibling defn is only ever called DIRECTLY. Passing one as a VALUE
;     compiles to a var fetch whose value is a capture of the NAMESPACE shim,
;     not of the pinned atom, so the emitted beam would keep leaning on the
;     shim the pinned path exists to avoid. Callbacks wrap the direct call.
;
; The exports are the recalled public surface PLUS the private helpers the
; pinned emitter does not privatize — the same one deliberate divergence
; `priv/host/dev_change.bl`, `priv/host/decimal.bl` and `priv/host/vector.bl`
; carry. The public ABI is exact; the lowercase helpers are extra exports.
;
; Run: bin/bl test test/bl/host_aot_test.bl

(ns host.aot)

; ── reader-form predicates (positional, never struct patterns) ───────────────
;
; A reader form is a tagged tuple: `{:meta, inner, m}`, `{:list, [...]}`,
; `{:symbol, name}`, `{:keyword, name}`, `{:vector, [...]}`. The Elixir twin
; matched those shapes in its clause HEADS; a bl clause head cannot destructure
; a tuple, so each matcher is a positional test on `erlang/element`. Both
; helpers are exported by the pinned emitter, which is harmless — they add to
; the ABI, they never remove from it.

(defn- reg3?
  "Whether `x` is a 3-tuple whose tag (element 1) is `tag`."
  [x tag]
  (and (erlang/is_tuple x) (erlang/== 3 (erlang/tuple_size x)) (erlang/== tag (erlang/element 1 x))))

(defn- reg2?
  "Whether `x` is a 2-tuple whose tag (element 1) is `tag`."
  [x tag]
  (and (erlang/is_tuple x) (erlang/== 2 (erlang/tuple_size x)) (erlang/== tag (erlang/element 1 x))))

(defn- struct?
  "Whether `x` is an Elixir struct: a map carrying `:__struct__`. The Elixir
   twin spelled this `%_{}`; a bl clause head has no such pattern, so the test
   is positional and the tag is read back to rebuild the struct."
  [x]
  (and (erlang/is_map x) (erlang/is_map_key :__struct__ x)))

; ── pinned-host entry: compile_file / compile_source / compile_host_file ────

(defn compile_file
  "Compile a `.bl` file into BEAM modules, one per namespace it defines.
   Returns `[{module, beam_path}]`."
  ([path] (compile_file path (list)))
  ([path opts]
   (boot)
   (BeamLisp.Loader/with_load_path (Path/dirname path)
     (fn []
       (compile_source (BeamLisp.Loader/read_source path)
                       (Keyword/put_new opts :file path))))))

(defn compile_source
  "Like `compile_file/2` but for an in-memory source string."
  ([source] (compile_source source (list)))
  ([source opts]
   (let [output_dir (or (Keyword/get opts :output_dir nil) (default_output_dir))
         unit (load_unit source opts)
         defined (elem unit 0)
         value_defs (elem unit 1)
         touched (elem unit 2)
         ns_meta (elem unit 3)
         file (elem unit 4)
         beams
         (Enum/flat_map
           (Enum/sort
             (Enum/filter touched
               (fn [ns]
                 (or (Map/has_key? value_defs ns)
                     (erlang/not (erlang/== {} (BeamLisp.Env/ns_defs ns)))))))
           (fn [ns]
             (emit_module ns (Map/get value_defs ns (list)) (Map/get ns_meta ns {})
                          output_dir file (Map/get defined ns nil))))]
     (if (Keyword/get opts :mark_loaded? false)
       (Enum/each
         (Enum/uniq (erlang/++ (Map/keys ns_meta)
                     (erlang/++ (Map/keys defined) (Map/keys value_defs))))
         (fn [ns] (BeamLisp.Env/mark_loaded ns)))
       nil)
     beams)))

(defn compile_host_file
  "Compile ONE `.bl` file into ONE BEAM module at an EXACT caller-given atom.
   The PINNED-MODULE (host ABI) path. Returns `{module, beam_path}`."
  ([path] (compile_host_file path (list)))
  ([path opts]
   (let [module (Keyword/fetch! opts :module)]
     (validate_host_module! module)
     (let [output_dir (Keyword/fetch! opts :output_dir)
           file (Keyword/get opts :file path)
           load? (Keyword/get opts :load? true)
           struct_fields (validate_struct_fields! (Keyword/get opts :struct_fields nil))]
       (BeamLisp.Loader/with_load_path (Path/dirname path)
         (fn []
           (let [source (BeamLisp.Loader/read_source path)
                 unit (load_unit source (Keyword/put opts :file file))
                 defined (elem unit 0)
                 value_defs (elem unit 1)]
             (let [ns (pinned_namespace! defined)
                   shim (BeamLisp.Emit/module_for ns)]
               (if (erlang/not (erlang/== (list) (Map/get value_defs ns (list))))
                 (erlang/error
                   (Elixir.ArgumentError/exception
                     (erlang/iolist_to_binary
                       (list "pinned host module " (Kernel/inspect module)
                             " cannot yet carry value definitions (" ns
                             "); only top-level `defn`s are emitted"))))
                 (let [clauses
                       (Enum/map
                         (Enum/flat_map
                           (Map/take (BeamLisp.Env/ns_defs ns)
                                     (MapSet/to_list (Map/fetch! defined ns)))
                           (fn [pair] (elem pair 1)))
                         (fn [d] (retarget_host (elem d 3) shim module)))]
                   (if (erlang/== (list) clauses)
                     (erlang/error
                       (Elixir.ArgumentError/exception
                         (erlang/iolist_to_binary
                           (list "pinned host module " (Kernel/inspect module)
                                 " would export no functions (" path ")"))))
                     (let [macro_exports
                           (validate_macro_exports! (Keyword/get opts :macro_exports (list)) clauses)
                           collision
                           (if (and (nil? struct_fields) (erlang/== (list) macro_exports))
                             nil
                             (Enum/find clauses
                               (fn [c]
                                 (or (erlang/== :__struct__ (get c :fname))
                                     (erlang/== :__info__ (get c :fname))))))]
                       (if (erlang/not (nil? collision))
                         (erlang/error
                           (Elixir.ArgumentError/exception
                             (erlang/iolist_to_binary
                               (list "pinned host module " (Kernel/inspect module) " defines "
                                     (get collision :fname) " itself; "
                                     ":struct_fields/:macro_exports would duplicate it"))))
                         (let [clauses2 (erlang/++ clauses
                                          (struct_clauses module struct_fields clauses macro_exports))
                               descriptor (BeamLisp.Emit/descriptor_for
                                            module clauses2 (host_attrs opts) {:file file})
                               compiled (BeamLisp.Emit/compile_descriptor descriptor)
                               mod (elem compiled 0)
                               beam (elem compiled 1)]
                           (do
                             (if load?
                               (BeamLisp.Emit/load_binary! compiled (or file "beam_lisp_host"))
                               nil)
                             (write_beam mod beam output_dir))))))))))))))))

; `nil`/`true`/`false` are atoms but not modules, and `module_info` is the
; introspection pair every module already carries.
(defn- validate_host_module!
  "Refuse a module name the pinned emitter cannot honestly honour. There is no
   `String.to_atom` anywhere on this path — the caller supplies an atom — so
   the rejections are about SHAPE and COLLISION, not leakage."
  [module]
  (cond
    (erlang/not (erlang/is_atom module))
      (erlang/error
        (Elixir.ArgumentError/exception
          (erlang/iolist_to_binary
            (list "pinned host module name must be an atom, got: " (Kernel/inspect module)))))

    (lists/member module (list nil true false :undefined :module_info))
      (erlang/error
        (Elixir.ArgumentError/exception
          (erlang/iolist_to_binary
            (list "pinned host module name " (Kernel/inspect module) " is reserved"))))

    (String/starts_with? (Atom/to_string module) "Elixir.BeamLisp.Ns.")
      (erlang/error
        (Elixir.ArgumentError/exception
          (erlang/iolist_to_binary
            (list "pinned host module " (Kernel/inspect module)
                  " collides with the namespace emitter's "
                  "BeamLisp.Ns.* scheme; name it outside that prefix"))))

    :else module))

(defn- pinned_namespace!
  "The single namespace a pinned file's functions belong to, from the defn names
   the UNIT itself spelled. A pinned module IS one module, so a file that
   defines functions in two namespaces has no single honest home: refuse rather
   than merge."
  [defined]
  (let [namespaces (Enum/sort
                     (Enum/map
                       (Enum/filter defined (fn [pair] (erlang/> (MapSet/size (elem pair 1)) 0)))
                       (fn [pair] (elem pair 0))))]
    (cond
      (erlang/== 1 (erlang/length namespaces)) (first namespaces)

      (erlang/== 0 (erlang/length namespaces))
        (erlang/error
          (Elixir.ArgumentError/exception
            "pinned host module source defines no functions in any namespace"))

      :else
        (erlang/error
          (Elixir.ArgumentError/exception
            (erlang/iolist_to_binary
              (list "pinned host module source must define functions in exactly one namespace, got: "
                    (Kernel/inspect namespaces))))))))

(defn- host_attrs
  "The module attributes a pinned descriptor carries: `-behaviour` and, when the
   caller supplies it, the provenance pair `-bl_source_hash` /
   `-bl_compiler_key`."
  [opts]
  (let [behaviour
        (let [b (Keyword/get opts :behaviour nil)]
          (cond
            (nil? b) (list)
            (erlang/is_atom b) (list (list :behaviour b))
            :else
              (erlang/error
                (Elixir.ArgumentError/exception
                  (erlang/iolist_to_binary
                    (list ":behaviour must be a module atom, got: " (Kernel/inspect b)))))))
        provenance
        (let [h (Keyword/get opts :source_hash nil)]
          (cond
            (nil? h) (list)
            (erlang/is_binary h)
              (list (list :bl_source_hash h)
                    (list :bl_compiler_key (BeamLisp.AOTCache/compiler_key)))
            :else
              (erlang/error
                (Elixir.ArgumentError/exception
                  (erlang/iolist_to_binary
                    (list ":source_hash must be a binary digest, got: " (Kernel/inspect h)))))))]
    (erlang/++ behaviour provenance)))

; ── ANF node retargeting for the pinned emitter ─────────────────────────────

(defn- retarget_host
  "Re-point every direct call the compiler linked to the namespace's SHIM
   (`BeamLisp.Ns.<Ns>`) at the PINNED module atom. The walk is over the closed
   bl-ANF vocabulary and NEVER enters a literal (`:lit` / `:plit`): an atom
   literal that happens to equal the shim's name is data, not a call target.
   Structs are rebuilt rather than flattened to plain maps."
  [x from to]
  (cond
    (struct? x)
      (Kernel/struct (erlang/map_get :__struct__ x)
        (Map/new (Map/from_struct x)
          (fn [pair] (tuple (elem pair 0) (retarget_host (elem pair 1) from to)))))

    (and (erlang/is_map x) (erlang/is_map_key :op x) (erlang/== :lit (get x :op)))
      x

    (and (erlang/is_map x) (erlang/is_map_key :pop x) (erlang/== :plit (get x :pop)))
      x

    (and (erlang/is_map x) (erlang/is_map_key :op x) (erlang/is_map_key :mod x)
         (erlang/== :remote (get x :op)))
      (let [x2 (if (erlang/== from (get x :mod)) (Map/put x :mod to) x)]
        (Map/put x2 :args (Enum/map (get x2 :args) (fn [a] (retarget_host a from to)))))

    (erlang/is_map x)
      (Map/new x (fn [pair] (tuple (elem pair 0) (retarget_host (elem pair 1) from to))))

    (erlang/is_list x)
      (Enum/map x (fn [a] (retarget_host a from to)))

    (erlang/is_tuple x)
      (List/to_tuple (Enum/map (Tuple/to_list x) (fn [a] (retarget_host a from to))))

    :else x))

; ── struct surface (`:struct_fields`) and macro surface (`:macro_exports`) ───

(defn- struct_clauses
  "The constructor pair a pinned struct module needs, plus the `__info__/1`
   clause `Inspect.Any` reads. Synthesized as bl-ANF data, never as Elixir
   source."
  [module fields clauses macro_exports]
  (let [constructors
        (if (nil? fields)
          (list)
          (let [default (struct_default_node module fields)]
            (list
              {:op :"defn-clause" :fname :__struct__ :params (list) :guard nil :body default :ann {}}
              {:op :"defn-clause" :fname :__struct__
               :params (list (anf_pvar "kv"))
               :guard nil
               :body {:op :remote :mod :Elixir.Enum :fun :reduce
                      :args (list (anf_var "kv") default (struct_reducer_node)) :ann {}}
               :ann {}})))]
    (erlang/++ (host_info_clauses module fields clauses macro_exports) constructors)))

(defn- host_info_clauses
  "`__info__/1` — the introspection every Elixir module answers and `Inspect.Any`
   reads. Synthesized when the caller asks for the struct surface OR for macros,
   and never for a functions-only module."
  [module fields clauses macro_exports]
  (if (and (nil? fields) (erlang/== (list) macro_exports))
    (list)
    (let [struct (if (nil? fields)
                   nil
                   (Enum/map fields (fn [pair]
                                      {:field (elem pair 0) :default (elem pair 1) :required false})))
          functions (Enum/uniq
                      (erlang/++
                        (Enum/map
                          (Enum/reject clauses (fn [c] (macro_clause? c)))
                          (fn [c] (tuple (get c :fname) (erlang/length (get c :params)))))
                        (if (nil? fields)
                          (list)
                          (list (tuple :__struct__ 0) (tuple :__struct__ 1)))))]
      (list
        (info_clause :module module)
        (info_clause :functions functions)
        (info_clause :macros (Enum/uniq (Enum/sort macro_exports)))
        (info_clause :deprecated (list))
        (info_clause :struct struct)))))

(defn- macro_clause?
  "Whether a clause is a macro's beam artifact (`MACRO-<name>`), which
   `__info__(:functions)` must NOT report."
  [clause]
  (String/starts_with? (Atom/to_string (get clause :fname)) "MACRO-"))

(defn- info_clause
  "A `__info__/1` clause for one literal key."
  [key value]
  {:op :"defn-clause" :fname :__info__
   :params (list {:pop :plit :val key})
   :guard nil
   :body (anf_lit value)
   :ann {}})

(defn- struct_default_node
  "`%{__struct__: module, field: default, …}` as an ANF `:map` whose keys and
   values are literals."
  [module fields]
  (let [pairs (Enum/map
                (cons (tuple :__struct__ module) fields)
                (fn [pair] (list (anf_lit (elem pair 0)) (anf_lit (elem pair 1)))))]
    {:op :map :pairs pairs :ann {}}))

(defn- struct_reducer_node
  "The reducer the generated `%{map | key => val}` compiles to, with the
   reference fun's single-clause refusal spelled out."
  []
  {:op :fn
   :clauses
   (list
     {:pats (list {:pop :ptuple :elems (list (anf_pvar "key") (anf_pvar "val"))}
                  (anf_pvar "map"))
      :guard nil
      :body {:op :remote :mod :maps :fun :update
             :args (list (anf_var "key") (anf_var "val") (anf_var "map")) :ann {}}}
     {:pats (list (anf_pvar "_") (anf_pvar "_"))
      :guard nil
      :body {:op :remote :mod :erlang :fun :error
             :args (list (anf_lit :function_clause)) :ann {}}})
   :ann {}})

(defn- anf_lit [value] {:op :lit :val value :ann {}})

(defn- anf_var [name] {:op :var :name name :ann {}})

(defn- anf_pvar [name] {:pop :pvar :name name})

(defn- validate_struct_fields!
  "The struct surface is METADATA from the caller: a field is an atom the caller
   already holds, its default must be literal data, and the two shapes Elixir
   refuses are refused here."
  [fields]
  (cond
    (nil? fields) nil

    (erlang/is_list fields)
      (Enum/reduce fields (list)
        (fn [entry acc]
          (if (and (erlang/is_tuple entry) (erlang/== 2 (erlang/tuple_size entry)))
            (let [key (elem entry 0)
                  default (elem entry 1)]
              (cond
                (erlang/== :__struct__ key)
                  (erlang/error (Elixir.ArgumentError/exception "cannot set :__struct__ in struct definition"))

                (erlang/is_atom key)
                  (cond
                    (lists/keymember key 1 acc)
                      (erlang/error (Elixir.ArgumentError/exception (erlang/iolist_to_binary (list "duplicate struct field " (Kernel/inspect key)))))
                    (literal_data? default)
                      (erlang/++ acc (list (tuple key default)))
                    :else
                      (erlang/error (Elixir.ArgumentError/exception (erlang/iolist_to_binary (list "struct field " (Kernel/inspect key) " default must be literal data, got: " (Kernel/inspect default (list (tuple :limit 5))))))))

                :else
                  (erlang/error (Elixir.ArgumentError/exception (erlang/iolist_to_binary (list "struct field names must be atoms, got: " (Kernel/inspect key)))))))

            (erlang/error (Elixir.ArgumentError/exception (erlang/iolist_to_binary (list ":struct_fields entries must be {name, default} pairs, got: " (Kernel/inspect entry))))))))

    :else
      (erlang/error (Elixir.ArgumentError/exception (erlang/iolist_to_binary (list ":struct_fields must be a list of {name, default} pairs, got: " (Kernel/inspect fields)))))))

(defn- validate_macro_exports!
  "`:macro_exports` is METADATA from the caller, exactly like `:struct_fields`:
   `{name, arity}` pairs naming the macros this module OFFERS. The implementer
   must already be a top-level `MACRO-<name>` clause of arity `arity + 1`."
  [specs clauses]
  (cond
    (erlang/== (list) specs) (list)

    (erlang/is_list specs)
      (Enum/map specs
        (fn [spec]
          (if (and (erlang/is_tuple spec)
                   (erlang/== 2 (erlang/tuple_size spec))
                   (erlang/is_atom (elem spec 0))
                   (erlang/is_integer (elem spec 1))
                   (erlang/>= (elem spec 1) 0))
            (let [name (elem spec 0)
                  arity (elem spec 1)
                  impl (erlang/binary_to_atom
                         (erlang/iolist_to_binary (list "MACRO-" (Atom/to_string name)))
                         :utf8)]
              (if (Enum/any? clauses
                    (fn [c]
                      (and (erlang/== impl (get c :fname))
                           (erlang/== (erlang/+ arity 1) (erlang/length (get c :params))))))
                (tuple name arity)
                (erlang/error
                  (Elixir.ArgumentError/exception
                    (erlang/iolist_to_binary
                      (list ":macro_exports names " (Atom/to_string name) "/"
                            (Integer/to_string arity) ", but no "
                            (Kernel/inspect impl) "/" (Integer/to_string (erlang/+ arity 1))
                            " clause is defined; a macro's artifact is its implementer with one extra "
                            "(caller) argument"))))))
            (erlang/error
              (Elixir.ArgumentError/exception
                (erlang/iolist_to_binary
                  (list ":macro_exports entries must be {name, arity} pairs, got: "
                        (Kernel/inspect spec))))))))

    :else
      (erlang/error
        (Elixir.ArgumentError/exception
          (erlang/iolist_to_binary
            (list ":macro_exports must be a list of {name, arity} pairs, got: "
                  (Kernel/inspect specs)))))))

(defn- literal_data?
  "What `BeamLisp.Ns.Anf`'s `literal-data?` accepts, minus anything with a
   runtime identity."
  [value]
  (cond
    (erlang/is_function value) false
    (erlang/is_tuple value) (Enum/all? (Tuple/to_list value) (fn [v] (literal_data? v)))
    (erlang/is_list value) (Enum/all? value (fn [v] (literal_data? v)))
    (erlang/is_map value) (Enum/all? value (fn [pair]
                                              (and (literal_data? (elem pair 0))
                                                   (literal_data? (elem pair 1)))))
    :else (or (erlang/is_atom value) (erlang/is_number value) (erlang/is_bitstring value))))

; ── the compilation unit: read, prelink, evaluate ───────────────────────────

(defn- load_unit [source opts]
  (BeamLisp.Loader/with_declaration_snapshot (fn [] (load_unit_in_snapshot source opts))))

(defn- load_unit_in_snapshot
  "Run one compilation unit through the ordinary reader/compiler pipeline and
   return everything the emitters need: `{defined, value_defs, touched, ns_meta,
   file}`."
  [source opts]
  (boot)
  (BeamLisp.Env/in_ns "user")
  (BeamLisp.Compiler/reset_fresh!)
  (let [file (Keyword/get opts :file nil)
        forms (BeamLisp.Reader/read_string source file)
        defined (unit_defns forms)]
    (Enum/reduce forms "user"
      (fn [form ns]
        (let [declared (ns_decl form)]
          (if (nil? declared)
            (do (BeamLisp.Compiler/prelink_defn form ns) ns)
            declared))))
    (let [acc (Enum/reduce forms (tuple {} (MapSet/new) {})
                (fn [form a]
                  (let [vdefs (elem a 0)
                        nss (elem a 1)
                        nsmeta (elem a 2)
                        ns (BeamLisp.Env/current_ns)
                        vdefs2 (capture_value_def vdefs form ns)
                        nsmeta2 (capture_ns_decl nsmeta form)
                        env (Map/put (BeamLisp.Compiler/new_env) :ns (BeamLisp.Env/current_ns))]
                    (BeamLisp.Compiler/eval_form form (Map/put env :file file))
                    (tuple vdefs2 (MapSet/put nss ns) nsmeta2))))]
      ; export every def the unit left behind its shim's forwarding handler
      ; (BUG-112): one shim rebuild per namespace for the whole unit
      (when (erlang/function_exported :Elixir.BeamLisp.Link :settle 0)
        (BeamLisp.Link/settle))
      (tuple defined (elem acc 0) (elem acc 1) (elem acc 2) file))))

(defn- unit_defns
  "The fn definitions THIS UNIT made, per namespace: the names a top-level
   `defn`/`defn-` form in the source binds."
  [forms]
  (elem
    (Enum/reduce forms (tuple "user" {})
      (fn [form acc]
        (let [ns (elem acc 0)
              m (elem acc 1)
              declared (ns_decl form)]
          (if (nil? declared)
            (let [name (defn_name form)]
              (if (nil? name)
                (tuple ns m)
                (tuple ns (Map/update m ns (MapSet/new (list name))
                                      (fn [s] (MapSet/put s name))))))
            (tuple declared m)))))
    1))

(defn- defn_name
  "The name a `defn`/`defn-` form binds, else nil. The Elixir twin had four
   clauses; the meta-peel of the HEAD is clause 2 and comes before the symbol
   match, so the order is preserved."
  [form]
  (cond
    (reg3? form :meta)
      (defn_name (elem form 1))

    (reg2? form :list)
      (let [items (elem form 1)]
        (if (erlang/== 0 (erlang/length items))
          nil
          (let [h (first items)]
            (if (reg3? h :meta)
              (defn_name (tuple :list (cons (elem h 1) (rest items))))
              (if (and (reg2? h :symbol) (erlang/>= (erlang/length items) 2))
                (let [head (elem h 1)
                      name_form (second items)]
                  (if (or (erlang/== "defn" head) (erlang/== "defn-" head))
                    (let [u (unmeta name_form)]
                      (if (reg2? u :symbol) (elem u 1) nil))
                    nil))
                nil)))))

    :else nil))

(defn- ns_decl
  "The namespace a top-level `(ns NAME …)` form declares, else nil."
  [form]
  (cond
    (reg3? form :meta) (ns_decl (elem form 1))

    (and (reg2? form :list)
         (erlang/>= (erlang/length (elem form 1)) 2)
         (reg2? (first (elem form 1)) :symbol)
         (erlang/== "ns" (elem (first (elem form 1)) 1)))
      (let [name_form (second (elem form 1))]
        (cond
          (reg3? name_form :meta)
            (let [inner (elem name_form 1)]
              (if (reg2? inner :symbol) (elem inner 1) nil))
          (reg2? name_form :symbol) (elem name_form 1)
          :else nil))

    :else nil))

(defn- unmeta
  "Strip one layer of reader position metadata."
  [form]
  (if (reg3? form :meta) (elem form 1) form))

(defn- bare_name
  "A definition's name, with or without metadata on it."
  [form]
  (cond
    (reg3? form :meta) (bare_name (elem form 1))
    (reg2? form :symbol) (elem form 1)
    :else (Kernel/inspect form)))

(defn- key_suffix
  "`\" name\"` for each name form — a composite key's ordered,
   space-separated tail."
  [forms]
  (Enum/map forms (fn [f] (erlang/iolist_to_binary (list " " (bare_name f))))))

(defn- definition_name
  "The key a replayed form is stored under.

   AN EXTENSION KEY NAMES BOTH SIDES. One type extended with two different
   protocols is two top-level forms — `veritas`'s `Gen` rungs and the
   `GenShrink` rungs added beside them — and a key carrying only the TYPE keeps
   the LAST and silently drops the earlier extension from `__bl_init__/0`. The
   first VM compiled and EVALUATED the source, so it installed both; a cache-hit
   VM only replays the artifact, so with a type-only key it installs one and
   dispatch then fails with \"No implementation of method … for type …\".
   Protocol and type both belong in the key: `extend-type` names the type second
   and the protocol third, `extend-protocol` names the protocol second and each
   type after it."
  [head items]
  (cond
    (erlang/== "extend-type" head)
      (erlang/iolist_to_binary
        (erlang/++ (list head " " (bare_name (second items)))
                   (key_suffix (Enum/take (Enum/drop items 2) 1))))

    (erlang/== "extend-protocol" head)
      (erlang/iolist_to_binary
        (erlang/++ (list head " " (bare_name (second items)))
                   (key_suffix
                     (Enum/reject (Enum/drop items 2)
                       (fn [x] (reg2? (unmeta x) :list))))))

    :else (bare_name (second items))))

(defn- require_target
  "The namespace a require spec names, in either accepted shape."
  [spec]
  (let [u (unmeta spec)]
    (cond
      (reg2? u :symbol) (elem u 1)

      (reg2? u :vector)
        (if (erlang/== 0 (erlang/length (elem u 1)))
          nil
          (let [head (unmeta (first (elem u 1)))]
            (if (reg2? head :symbol) (elem head 1) nil)))

      :else nil)))

(defn- capture_require_spec
  "Like `Compiler.parse_require_spec/1`: `[target :as a :refer [x y]]` or a bare
   `target`. Answers the running `{aliases, refers, refer_alls}` accumulator."
  [spec acc]
  (cond
    (reg3? spec :meta)
      (capture_require_spec (elem spec 1) acc)

    (reg2? spec :symbol)
      acc

    (and (reg2? spec :vector)
         (erlang/> (erlang/length (elem spec 1)) 0)
         (reg3? (first (elem spec 1)) :meta))
      (capture_require_spec
        (tuple :vector (cons (elem (first (elem spec 1)) 1) (rest (elem spec 1))))
        acc)

    (and (reg2? spec :vector)
         (erlang/> (erlang/length (elem spec 1)) 0)
         (reg2? (first (elem spec 1)) :symbol))
      (let [items (elem spec 1)
            target (elem (first items) 1)
            flags (rest items)
            parsed
            (Enum/reduce (Enum/map flags (fn [f] (unmeta f)))
              (tuple nil (list) false)
              (fn [flag a]
                (let [al (elem a 0)
                      rf (elem a 1)
                      ra (elem a 2)]
                  (cond
                    (and (reg2? flag :keyword) (erlang/== "as" (elem flag 1)))
                      (tuple (tuple :expecting "as") rf ra)

                    (and (reg2? flag :keyword) (erlang/== "refer" (elem flag 1)))
                      (tuple al (tuple :expecting "refer") ra)

                    (and (reg2? flag :symbol) (erlang/== (tuple :expecting "as") al))
                      (tuple (elem flag 1) rf ra)

                    (and (reg2? flag :keyword) (erlang/== "all" (elem flag 1))
                         (erlang/== (tuple :expecting "refer") rf))
                      (tuple al (list) true)

                    (and (reg2? flag :vector) (erlang/== (tuple :expecting "refer") rf))
                      (tuple al (Enum/map (elem flag 1) (fn [s] (bare_name s))) ra)

                    :else a))))
            as_alias (let [a0 (elem parsed 0)] (if (erlang/is_binary a0) a0 nil))
            refer_syms (let [r1 (elem parsed 1)] (if (erlang/is_list r1) r1 (list)))
            refer_all? (elem parsed 2)
            aliases (elem acc 0)
            refers (elem acc 1)
            refer_alls (elem acc 2)
            aliases2 (if as_alias (erlang/++ aliases (list (tuple as_alias target))) aliases)
            refers2 (erlang/++ refers (Enum/map refer_syms (fn [s] (tuple s target))))
            refer_alls2 (if refer_all? (erlang/++ refer_alls (list target)) refer_alls)]
        (tuple aliases2 refers2 refer_alls2))

    :else acc))

(defn- require_declaration
  "The original require spec as {target, alias, refers}, preserving bare and
   refer-all intent independently of another spec naming the same target."
  [spec]
  (let [target (require_target spec)
        parts (capture_require_spec spec (tuple (list) (list) (list)))
        aliases (elem parts 0)
        refers (elem parts 1)
        alls (elem parts 2)]
    (if (nil? target)
      nil
      (tuple target
             (if (erlang/== aliases (list)) nil (elem (first aliases) 0))
             (if (erlang/== alls (list))
               (Enum/map refers (fn [p] (elem p 0)))
               :all)))))

(defn- capture_ns_decl
  "Capture the alias/refer side effects of an `(ns name (:require ...))`
   declaration so `__bl_init__/0` can re-run them in a fresh VM."
  [ns_meta form]
  (cond
    (reg3? form :meta)
      (capture_ns_decl ns_meta (elem form 1))

    (and (reg2? form :list)
         (erlang/>= (erlang/length (elem form 1)) 2)
         (reg2? (first (elem form 1)) :symbol)
         (erlang/== "ns" (elem (first (elem form 1)) 1))
         (reg2? (second (elem form 1)) :symbol))
      (let [ns (elem (second (elem form 1)) 1)
            clauses (Enum/map (rest (rest (elem form 1))) (fn [c] (unmeta c)))
            is-require? (fn [c] (and (reg2? c :list)
                                     (erlang/> (erlang/length (elem c 1)) 0)
                                     (reg2? (first (elem c 1)) :keyword)
                                     (erlang/== "require" (elem (first (elem c 1)) 1))))
            acc (Enum/reduce clauses (tuple (list) (list) (list))
                  (fn [c a]
                    (if (is-require? c)
                      (Enum/reduce (rest (elem c 1)) a
                        (fn [s aa] (capture_require_spec s aa)))
                      a)))
            requires (Enum/uniq
                       (Enum/reject
                         (Enum/flat_map clauses
                           (fn [c]
                             (if (is-require? c)
                               (Enum/map (rest (elem c 1)) (fn [s] (require_target s)))
                               (list))))
                         (fn [t] (nil? t))))
            require_specs
            (Enum/reject
              (Enum/flat_map clauses
                (fn [c]
                  (if (is-require? c)
                    (Enum/map (rest (elem c 1)) (fn [s] (require_declaration s)))
                    (list))))
              (fn [s] (nil? s)))
            meta {:aliases (elem acc 0) :refers (elem acc 1)
                  :refer_alls (elem acc 2) :requires requires
                  :require_specs require_specs}]
        (Map/update ns_meta ns meta (fn [_prev] meta)))

    :else ns_meta))

(defn- put_value_def
  "Capture a value `def`'s initializer (and optional docstring) so the namespace
   module can re-run it in `__bl_init__/0`. Latest def wins, first-definition
   order preserved."
  ([vdefs ns name doc init]
   (put_value_def vdefs ns name doc init (list)))
  ([vdefs ns name doc init opts]
   (let [per_env? (erlang/== true (Keyword/get opts :per_env false))
         entries (Enum/reject (Map/get vdefs ns (list))
                   (fn [e] (erlang/== name (elem e 0))))]
     (Map/put vdefs ns (erlang/++ entries (list (tuple name doc init per_env?)))))))

; The define-by-interning forms, replayed whole by `__bl_init__/0`.
(defn- replayed_form?
  [head]
  (lists/member head
    (list "defmacro" "defserver" "defrecord" "deftype" "defprotocol"
          "defmulti" "extend-type" "extend-protocol")))

(defn- capture_value_def
  "Capture a value `def`'s initializer. The Elixir twin had six clauses; each is
   preserved in order, positionally matched."
  [vdefs form ns]
  (cond
    (reg3? form :meta)
      (capture_value_def vdefs (elem form 1) ns)

    ; `(def ^:private …)` / `(def ^:per-env …)`: the NAME carries metadata.
    (and (reg2? form :list)
         (erlang/>= (erlang/length (elem form 1)) 2)
         (reg2? (first (elem form 1)) :symbol)
         (erlang/== "def" (elem (first (elem form 1)) 1))
         (reg3? (second (elem form 1)) :meta))
      (let [name_meta (second (elem form 1))
            inner (elem name_meta 1)
            m (elem name_meta 2)
            remaining (rest (rest (elem form 1)))]
        (if (and (erlang/is_map m) (erlang/== true (get m :"per-env")))
          (cond
            (erlang/== 1 (erlang/length remaining))
              (put_value_def vdefs ns (bare_name inner) nil (first remaining)
                             (list (tuple :per_env true)))
            (and (erlang/== 2 (erlang/length remaining))
                 (erlang/is_binary (first remaining)))
              (put_value_def vdefs ns (bare_name inner) (first remaining) (second remaining)
                             (list (tuple :per_env true)))
            :else vdefs)
          (capture_value_def vdefs
            (tuple :list (cons (tuple :symbol "def") (cons inner remaining))) ns)))

    ; the define-by-interning forms, matched on the head symbol
    (and (reg2? form :list)
         (erlang/>= (erlang/length (elem form 1)) 2)
         (reg2? (first (elem form 1)) :symbol)
         (replayed_form? (elem (first (elem form 1)) 1)))
      (put_value_def vdefs ns
        (definition_name (elem (first (elem form 1)) 1) (elem form 1))
        nil form)

    ; `(def name init)` / `(def name doc init)`
    (and (reg2? form :list)
         (erlang/>= (erlang/length (elem form 1)) 2)
         (reg2? (first (elem form 1)) :symbol)
         (erlang/== "def" (elem (first (elem form 1)) 1))
         (reg2? (second (elem form 1)) :symbol))
      (let [name (elem (second (elem form 1)) 1)
            remaining (rest (rest (elem form 1)))]
        (cond
          (erlang/== 1 (erlang/length remaining))
            (put_value_def vdefs ns name nil (first remaining))
          (and (erlang/== 2 (erlang/length remaining))
               (erlang/is_binary (first remaining)))
            (put_value_def vdefs ns name (first remaining) (second remaining))
          :else vdefs))

    ; see through defining macros: capture the EXPANSION
    (and (reg2? form :list)
         (erlang/> (erlang/length (elem form 1)) 0)
         (reg2? (first (elem form 1)) :symbol)
         (erlang/is_binary (elem (first (elem form 1)) 1)))
      (let [expanded (BeamLisp.Compiler/macroexpand_1 form ns)]
        (if (erlang/== expanded form) vdefs (capture_value_def vdefs expanded ns)))

    :else vdefs))

; ── emission ────────────────────────────────────────────────────────────────

(defn- emit_module
  "Emit a namespace as the SAME shim/body split the runtime uses, so an
   AOT-loaded namespace is byte-for-byte the source-loaded one. Returns every
   emitted `{mod, path}`."
  [ns value_defs ns_meta output_dir file unit_names]
  (BeamLisp.Env/with_namespace_lock ns
    (fn [] (BeamLisp.Env/with_publication ns
      (fn [] (emit_module_unfenced ns value_defs ns_meta output_dir file unit_names))))))

(defn- emit_module_unfenced
  [ns value_defs ns_meta output_dir file unit_names]
  (let [mod (BeamLisp.Emit/module_for ns)
        filename (or file (erlang/iolist_to_binary (list "beam_lisp_aot/" ns ".bl")))
        ns_defs (stabilise_body_modules ns (unit_defs ns unit_names))
        source_hash (if file (ns_closure_hash ns file) nil)
        stamp_key (BeamLisp.AOTCache/key_for_ns ns)
        init_pair (build_init_ast ns mod ns_defs value_defs ns_meta)
        init_clause (elem init_pair 0)
        companion_descriptor (elem init_pair 1)
        provenance_clause (BeamLisp.Emit/function_clause :__bl_provenance__
                            {:op :tuple :elems (list (BeamLisp.Emit/lit source_hash)
                                                     (BeamLisp.Emit/lit stamp_key)) :ann {}})
        namespace_clauses
        (Enum/map
          (erlang/++ (BeamLisp.Emit/shim_clauses ns ns_defs)
                     ; `__bl_ns_defs__/0` IS the namespace's def table: a literal the VM
                     ; shares, which `Env/ns_defs` reads instead of an ETS copy.
                     (list provenance_clause
                           (BeamLisp.Emit/function_clause :__bl_ns_defs__ (BeamLisp.Emit/lit ns_defs))
                           init_clause))
          (fn [clause]
            (let [ann (Map/merge {:file filename :line 1}
                                 (Map/get (get clause :body) :ann {}))]
              (Map/put clause :body (Map/put (get clause :body) :ann ann)))))
        namespace_descriptor
        (BeamLisp.Emit/descriptor_for mod namespace_clauses
          (list (tuple :bl_source_hash source_hash) (tuple :bl_compiler_key stamp_key))
          {:file filename})
        body_descriptors
        (Enum/map (BeamLisp.Emit/body_modules ns_defs)
          (fn [pair] (BeamLisp.Emit/descriptor_for (elem pair 0) (elem pair 1) (list) {:file filename})))
        companion_descriptor
        (if companion_descriptor
          (Map/put companion_descriptor :ann {:file filename})
          nil)
        beams (Enum/map
                (erlang/++ (erlang/++ body_descriptors (List/wrap companion_descriptor))
                           (list namespace_descriptor))
                (fn [d] (BeamLisp.Emit/compile_descriptor d)))
        body_mods (MapSet/new body_descriptors (fn [d] (get d :name)))
        split (Enum/split_with beams (fn [b] (MapSet/member? body_mods (elem b 0))))
        body_beams (elem split 0)
        public_beams (elem split 1)]
    (try
      (BeamLisp.Env/publish_binaries! (erlang/++ body_beams public_beams) filename)
      (catch e
        (erlang/error
          (Elixir.RuntimeError/exception
            (erlang/iolist_to_binary
              (list "AOT publication failed for "
                    (Kernel/inspect (Enum/map public_beams (fn [b] (elem b 0))))
                    ": "
                    (Elixir.Exception/message e)))))))
    (let [written (Enum/map
      (Enum/sort_by beams (fn [b] (if (erlang/== mod (elem b 0)) 0 1)))
      (fn [b] (write_beam (elem b 0) (elem b 1) output_dir)))]
      ;; Metadata names the table the loaded shim actually executes, including
      ;; stabilized AOT body identities, before readers may obtain evidence.
      (BeamLisp.Env/link_ns_defs ns mod)
      written)))

(defn- write_beam
  "Compile-to-disk for one module; replacement preserves cache-linked inodes."
  [mod beam output_dir]
  (let [path (Path/join output_dir (erlang/iolist_to_binary (list (Atom/to_string mod) ".beam")))
        tmp (erlang/iolist_to_binary
              (list path ".tmp-" (os/getpid) "-"
                    (Integer/to_string (System/unique_integer (list :positive)))))]
    (File/mkdir_p! output_dir)
    (try
      (do
        (File/write! tmp beam)
        (File/rename! tmp path)
        (tuple mod path))
      (finally (File/rm tmp)))))

(defn- init_module_for
  "The initializer companion module: `BeamLisp.Ns.Init.<Ns>`."
  [ns]
  (Module/concat
    (erlang/++ (list :Elixir.BeamLisp.Ns "Init")
               (Enum/map (String/split ns ".") (fn [s] (Macro/camelize s))))))

(defn- ns_body_module
  "The single shared body module for a namespace: `BeamLisp.Ns.Body.<Ns>`."
  [ns]
  (Module/concat
    (erlang/++ (list :Elixir.BeamLisp.Ns "Body")
               (Enum/map (String/split ns ".") (fn [s] (Macro/camelize s))))))

(defn- unit_defs
  "This unit's defs, told apart from the VM registry's by their body module: a
   defn this unit evaluated was installed into a FRESH body module; one
   inherited from a loaded beam still names that beam's shared body."
  [ns names]
  (let [shared (ns_body_module ns)]
    (Map/new
      (Enum/filter (BeamLisp.Env/ns_defs ns)
        (fn [pair]
          (or (and (erlang/not (erlang/== nil names)) (MapSet/member? names (elem pair 0)))
              (Enum/any? (elem pair 1) (fn [d] (erlang/=/= shared (elem d 4))))))))))

(defn- stabilise_body_modules
  "Rewrite every var's body module to a SINGLE deterministic body module shared
   by the whole namespace."
  [ns ns_defs]
  (let [body_mod (ns_body_module ns)]
    (Map/new ns_defs
      (fn [pair]
        (tuple (elem pair 0)
               (Enum/map (elem pair 1) (fn [d] (erlang/setelement 5 d body_mod))))))))

(defn- native_declaration
  "The native declaration for `ns` straight from vm.native's VM-wide ETS table,
   or nil."
  [ns]
  (if (erlang/== :undefined (ets/whereis :beam_lisp_native_declarations))
    nil
    (let [r (ets/lookup :beam_lisp_native_declarations (tuple :native ns))]
      (if (and (erlang/is_list r)
               (erlang/== 1 (erlang/length r))
               (erlang/is_tuple (first r))
               (erlang/== 2 (erlang/tuple_size (first r)))
               (erlang/is_tuple (elem (first r) 1))
               (erlang/== 2 (erlang/tuple_size (elem (first r) 1))))
        (tuple (elem (elem (first r) 1) 0) (elem (elem (first r) 1) 1))
        nil))))

(defn- compile_initializer
  [form env]
  (if (and (Code/ensure_loaded? :Elixir.BeamLisp.Ns.Compiler)
           (erlang/function_exported :Elixir.BeamLisp.Ns.Compiler :"compile-node" 2))
    (erlang/apply :Elixir.BeamLisp.Ns.Compiler :"compile-node" (list form env))
    (erlang/error
      (Elixir.RuntimeError/exception
        "initializer compiler unavailable: BeamLisp.Ns.Compiler.compile-node/2 is not ready"))))

(defn- build_init_ast
  "`__bl_init__/0`'s clause and its value-initializer companion descriptor, as
   bl-ANF data."
  [ns mod ns_defs value_defs ns_meta]
  (let [aliases (Map/get ns_meta :aliases (list))
        refers (Map/get ns_meta :refers (list))
        refer_alls (Map/get ns_meta :refer_alls (list))
        requires (Map/get ns_meta :requires (list))
        require_specs (Map/get ns_meta :require_specs nil)
        require_ops
        (if (nil? require_specs)
          (Enum/map requires
            (fn [t] (BeamLisp.Emit/remote :Elixir.BeamLisp.Loader :ensure_loaded
                      (list (BeamLisp.Emit/lit t)))))
          (Enum/map require_specs
            (fn [spec]
              (BeamLisp.Emit/remote :Elixir.BeamLisp.Loader :declare_require
                (Enum/map (Tuple/to_list spec) (fn [v] (BeamLisp.Emit/lit v)))))))
        ns_ops
        (erlang/++
          (erlang/++
            require_ops
            (Enum/map aliases
              (fn [pair]
                (BeamLisp.Emit/remote :Elixir.BeamLisp.Env :add_alias
                  (Enum/map (list ns (elem pair 0) (elem pair 1))
                            (fn [v] (BeamLisp.Emit/lit v)))))))
          (erlang/++
            (Enum/map refers
              (fn [pair]
                (BeamLisp.Emit/remote :Elixir.BeamLisp.Env :add_refer
                  (Enum/map (list ns (elem pair 0) (elem pair 1))
                            (fn [v] (BeamLisp.Emit/lit v))))))
            (Enum/map refer_alls
              (fn [t]
                (BeamLisp.Emit/remote :Elixir.BeamLisp.Env :add_refer_all
                  (list (BeamLisp.Emit/lit ns) (BeamLisp.Emit/lit t)))))))
        native_ops
        (let [d (native_declaration ns)]
          (if (nil? d)
            (list)
            (list
              (BeamLisp.Emit/remote :Elixir.BeamLisp.Loader :ensure_loaded
                (list (BeamLisp.Emit/lit "vm.native")))
              (BeamLisp.Emit/remote :Elixir.BeamLisp.Ns.Vm.Native :declare
                (Enum/map (list ns (elem d 0) (elem d 1))
                          (fn [v] (BeamLisp.Emit/lit v)))))))
        fn_ops
        (Enum/flat_map ns_defs
          (fn [pair]
            (let [name (elem pair 0)
                  defs (elem pair 1)
                  fixed (Enum/map
                          (Enum/filter defs (fn [d] (erlang/== :fixed (elem d 0))))
                          (fn [d] (tuple (elem d 1) (elem d 2))))
                  variadic (Enum/find_value defs
                             (fn [d]
                               (if (erlang/== :variadic (elem d 0))
                                 (tuple (elem d 1) (elem d 2))
                                 nil)))
                  ops
                  (list
                    (BeamLisp.Emit/remote :Elixir.BeamLisp.Env :intern
                      (list (BeamLisp.Emit/lit ns) (BeamLisp.Emit/lit name)
                            (BeamLisp.Emit/remote :Elixir.BeamLisp.Emit :fn_value
                              (Enum/map (list mod fixed variadic)
                                        (fn [v] (BeamLisp.Emit/lit v))))))
                    (BeamLisp.Emit/remote :Elixir.BeamLisp.Env :put_link
                      (Enum/map (list ns name (tuple mod (Map/new fixed) variadic))
                                (fn [v] (BeamLisp.Emit/lit v)))))
                  m (BeamLisp.Env/meta ns name)]
              (if (and (erlang/is_tuple m)
                       (erlang/== :ok (elem m 0))
                       (erlang/is_map (elem m 1))
                       (erlang/> (erlang/map_size (elem m 1)) 0))
                (erlang/++ ops
                  (list (BeamLisp.Emit/remote :Elixir.BeamLisp.Env :put_meta
                          (Enum/map (list ns name (elem m 1))
                                    (fn [v] (BeamLisp.Emit/lit v))))))
                ops))))
        compiler_env (BeamLisp.Compiler/new_env ns)
        value_ops
        (Enum/flat_map value_defs
          (fn [e]
            (let [name (elem e 0)
                  doc (elem e 1)
                  init_form (elem e 2)
                  per_env? (elem e 3)
                  init_node (compile_initializer init_form compiler_env)
                  register (if per_env?
                             (BeamLisp.Emit/remote :Elixir.BeamLisp.Env :define_per_env
                               (list (BeamLisp.Emit/lit ns) (BeamLisp.Emit/lit name)
                                     (BeamLisp.Emit/closure init_node)))
                             (BeamLisp.Emit/remote :Elixir.BeamLisp.Env :intern
                               (list (BeamLisp.Emit/lit ns) (BeamLisp.Emit/lit name) init_node)))]
              (if doc
                (list register
                      (BeamLisp.Emit/remote :Elixir.BeamLisp.Env :put_meta
                        (list (BeamLisp.Emit/lit ns) (BeamLisp.Emit/lit name)
                              (BeamLisp.Emit/lit {:doc doc}))))
                (list register)))))
        init_mod (init_module_for ns)
        companion_descriptor
        (if (erlang/== (list) value_ops)
          nil
          (BeamLisp.Emit/descriptor_for init_mod
            (list (BeamLisp.Emit/function_clause :__bl_init_values__
                    (BeamLisp.Emit/sequence (erlang/++ value_ops (list (BeamLisp.Emit/lit :ok))))))))
        value_call_ops (if companion_descriptor
                         (list (BeamLisp.Emit/remote init_mod :__bl_init_values__ (list)))
                         (list))
        ; Value initializers can define functions in this namespace. Their
        ; Link publication needs the canonical declarations before it replaces
        ; the shim; its resulting overlay must never be relinked afterward.
        table_ops (list (BeamLisp.Emit/remote :Elixir.BeamLisp.Env :link_ns_defs
                          (list (BeamLisp.Emit/lit ns) (BeamLisp.Emit/lit mod))))
        body (BeamLisp.Emit/sequence
               (erlang/++
                 (erlang/++ (erlang/++ (erlang/++ ns_ops native_ops) fn_ops) table_ops)
                 (erlang/++ value_call_ops
                   (list (BeamLisp.Emit/remote :Elixir.BeamLisp.Env :mark_loaded
                           (list (BeamLisp.Emit/lit ns)))
                         (BeamLisp.Emit/lit :ok)))))]
    (tuple (BeamLisp.Emit/function_clause :__bl_init__ body) companion_descriptor)))

; ── the runtime-side hook and boot ──────────────────────────────────────────

(defn- init_loaded_module
  "Load a compatible AOT module into this VM: run its `__bl_init__/0` under the
   pinned `Loader.Server` and the `:global` env, then mark the namespace loaded.
   The `__bl_init__` replay is the ONLY source of a namespace's top-level
   effects on this path — the source was never evaluated — so it must run here."
  [ns mod]
  (global/trans (tuple (tuple :bl_load mod) (erlang/self))
    (fn []
      (if (BeamLisp.Env/loaded_ns? ns)
        :loaded
        (do
          (BeamLisp.Loader.Server/run
            (fn []
              (BeamLisp.Env/with_env :global
                (fn []
                  (do
                    (erlang/apply mod :__bl_init__ (list))
                    (BeamLisp.Env/mark_loaded ns))))))
          :loaded)))))

(defn ensure_loaded
  "Ensure namespace `ns` is usable in this VM: load its AOT module if a `.beam`
   exists on the code path, and run its `__bl_init__/0`. Idempotent.

   Two outcomes, unchanged: `:loaded` when the namespace is (now) usable, and
   `:no_module` when nothing can be served — the loader then falls back to
   interpreting the source. What CHANGED is what happens to a stale or missing
   `:library` artifact: it is repaired INSIDE this boundary (see
   `repair_library/1`) — compiled once from live source, published to the AOT
   cache under the live closure key, and loaded — so neither this VM nor the
   next interprets the same source again. Boot- and build-tier namespaces (the
   gating kernel among them) are never repaired; neither is anything while
   `AOTCache.enabled?` is false or `BEAM_LISP_AOT_REPAIR` is off; and strict
   mode refuses before any repair is attempted."
  [ns]
  :when (string? ns)
  (let [mod (BeamLisp.Link/module_for ns)]
    (if (and (Code/ensure_loaded? mod)
             (erlang/function_exported mod :__bl_init__ 0))
      (cond
        (BeamLisp.Env/loaded_ns? ns)
          :loaded

        (stale? ns mod)
          (repair_or_no_module ns)

        :else
          (init_loaded_module ns mod))
      (repair_or_no_module ns))))

; ── repairing a stale or missing library artifact ──────────────────────────
;
; A checkout whose `build/` image is a PREVIOUS toolchain's generation looks
; exactly like a healthy one to a boot-only health check: the ten boot
; namespaces are codegen and are re-stamped with the toolchain, but the library
; tier is not, so every library beam is judged stale and the loader interprets
; its source — on EVERY boot, forever, with no message. The measured shape of
; that degrade is ~144 interpreted namespaces and 16.9s of drift-gate closure
; hashing in one `bl version`, on a tree that has beams for all of them.
;
; The repair is deliberately the SAME three primitives the build uses —
; `AOT.compile_source`, `AOTCache.store/fetch`, `AOTCache.run_init_modules` — so
; a repaired artifact and a built one are interchangeable, and the cache
; address (`<compiler-key>/<closure-key>`) is the build's own. The two paths
; differ in one thing and it is the thing that must not be got wrong:
;
;   * a user with no artifact but no SOURCE (a packaged drop) is trusted, not
;     repaired — a nil closure hash means "nothing to compile from";
;   * a MISS takes the compiling path: `AOT.compile_source` EVALUATES the
;     source (that is what compiling means here), so the namespace is loaded by
;     that evaluation and `__bl_init__` must NOT be replayed afterwards — the
;     initializers already ran. Effects happen once;
;   * a HIT takes the linking path: the published beams are loaded from the
;     cache's own bytes and their `__bl_init__/0` IS replayed, because on this
;     path nothing evaluated the source. Effects still happen once per VM.
;
; The gate namespaces (`build-plan`, `source-graph`, `ns-interface`, the
; `priv/build/*` driver and `priv/boot/*` codegen) are `:build`/`:boot` tier and
; are therefore never repaired: computing a closure hash in order to compile
; the thing that computes closure hashes is the bootstrap circle. They fall
; back to source exactly as before, and `ns_closure_hash` can always finish.
;
; An unavailable repair falls back before evaluation. Once compiling or
; initializer replay starts, errors propagate; evaluating the source again
; would duplicate effects already performed by the failed attempt.

(defn- repair_enabled?
  "Whether the drift gate may repair a stale or missing library artifact. On by
   default; `AOTCache.enabled?` must ALSO be true, because a repair that cannot
   be published would be paid again on the next boot and its whole point is
   that it is paid once."
  []
  (if (BeamLisp.AOTCache/enabled?)
    (erlang/not (lists/member (System/get_env "BEAM_LISP_AOT_REPAIR") (list "off" "0" "false")))
    false))

(defn- library_tier?
  "Whether `ns` is an ordinary library namespace — the ONLY tier the repair
   touches. `:boot` is codegen and `:build` is the driver; both are needed to
   compute the verdict itself."
  [ns]
  (erlang/== :library (BeamLisp.Tiers/tier_of_ns ns)))

(defn- note_library_generation
  "ONE note, once per VM, the first time a LIBRARY beam is found to be another
   generation. Silence here was the actual defect: a 144-namespace source
   interpretation looked like a slow program, not a stale image."
  [ns]
  (let [key (tuple :Elixir.BeamLisp.AOT :library_generation_noted)]
    (if (erlang/== false (persistent_term/get key false))
      (do
        (persistent_term/put key true)
        (IO/puts :stderr
          (erlang/iolist_to_binary
            (list "bl: this image's library beams are a previous toolchain's generation (first seen: " ns ").")))
        (IO/puts :stderr
          "bl: stale libraries are compiled once and cached on first use; run `bl build` to rebuild the whole image."))
      nil)))

(defn- note_repair_failed
  "ONE note per namespace, naming the reason a repair degraded to source
   interpretation. Best-effort and never fatal."
  [ns reason]
  (let [key (tuple :Elixir.BeamLisp.AOT :repair_failed ns)]
    (if (erlang/== false (persistent_term/get key false))
      (do
        (persistent_term/put key true)
        (IO/puts :stderr
          (erlang/iolist_to_binary
            (list "bl: could not repair the artifact for " ns ": " (Kernel/inspect reason)
                  " — interpreting its source."))))
      nil)))

(defn- repair_link_dir
  "Where a cache FETCH links an entry's beams for this VM. Under the cache root
   (the entry's own generation directory's parent), so the link is a hardlink
   whenever the filesystem allows it, and cross-filesystem copies stay the
   fallback."
  [ns]
  (Path/join (Path/join (BeamLisp.AOTCache/dir) "repair")
             (erlang/iolist_to_binary (list (BeamLisp.AOTCache/compiler_key) "-" ns))))

(defn- load_cached_entry
  "Publish a fetched entry's beams into THIS VM and replay their initializers.
   The beams are loaded from the ENTRY's own bytes — not from the freshly linked
   copy, which a concurrent VM in this generation may be relinking, and not
   re-resolved from the code path, which still holds the STALE generation and
   would be served back by `Code.ensure_loaded/1`. An entry is immutable once
   published (`store/4` replaces it wholesale), so it is the stable source.
   Then `AOTCache.run_init_modules/2` replays each module's `__bl_init__/0`: this
   path never evaluated source, so the replay IS the namespace's top-level
   effect."
  [ns modules entry_dir link_dir]
  (let [beams (Enum/map modules
                (fn [m]
                  (let [name (erlang/iolist_to_binary (list (erlang/atom_to_binary m :utf8) ".beam"))]
                    (tuple (tuple m (File/read! (Path/join entry_dir name)))
                           (Path/join link_dir name)))))]
    (let [result (BeamLisp.Env/with_namespace_lock ns
                   (fn [] (BeamLisp.Env/with_publication ns
                     (fn []
                       (BeamLisp.Env/publish_binaries! beams)))))]
      (when (erlang/== :retired result) (erlang/error :scope_retired))))
  ; Initializers may execute accepted user effects. They remain outside the
  ; short native fence and are not cancellation-authorized by this admission.
  (BeamLisp.AOTCache/run_init_modules modules link_dir))

(defn- compile_and_publish
  "Compile `ns` from `content` ONCE, publish the beams to the AOT cache under
   `closure_key`, and answer the module list. `AOT.compile_source` evaluates the
   source as it compiles it, so the caller must NOT replay `__bl_init__`
   afterwards."
  [ns content closure_key path]
  (let [out (Path/join (Path/join (BeamLisp.AOTCache/dir) "repair")
                       (erlang/iolist_to_binary
                         (list (BeamLisp.AOTCache/compiler_key) "-" ns "-out-"
                               (Integer/to_string (System/unique_integer (list :positive))))))]
    (File/mkdir_p! out)
    (try
      (let [beams (compile_source content (list (tuple :file path) (tuple :output_dir out)
                                              (tuple :mark_loaded? true)))
            modules (Enum/map beams (fn [b] (elem b 0)))]
        ; Everything below is best-effort on purpose. `compile_source` has
        ; ALREADY evaluated the source, so the namespace is loaded whatever
        ; happens next, and a failure here must not send the loader down the
        ; source path to evaluate it a second time. `AOTCache.store/4` swallows
        ; its own failures, so a read-only or racing cache costs reuse, never
        ; correctness.
        (if (erlang/== modules (list))
          nil ; An action-only source has no initializer artifact to replay.
          (BeamLisp.AOTCache/store (BeamLisp.AOTCache/compiler_key) closure_key out modules))
        modules)
      (finally (File/rm_rf out)))))

(defn- repair_library
  "Repair a stale or missing LIBRARY artifact. Returns `:loaded` when the
   namespace is now usable, `:no_module` when no repair is possible (another
   tier, the cache off, or no source). Evaluation/replay failures propagate
   rather than re-running partially evaluated source."
  [ns]
  (cond
    (erlang/not (library_tier? ns)) :no_module
    (erlang/not (repair_enabled?)) :no_module
    :else
      (let [content (BeamLisp.Loader/source_content ns)]
        (if (erlang/== nil content)
          :no_module
          (let [path (BeamLisp.Loader/source_path ns)]
            (if (erlang/== nil path)
              :no_module
              (let [closure_key (ns_closure_hash ns)]
                (if (erlang/== nil closure_key)
                  :no_module
                  (let [link_dir (repair_link_dir ns)]
                    (global/trans (tuple (tuple :bl_aot_repair ns) (erlang/self))
                      (fn []
                        (if (BeamLisp.Env/loaded_ns? ns)
                          :loaded
                          (BeamLisp.Loader.Server/run
                            (fn []
                              (BeamLisp.Env/with_env :global
                                (fn []
                                  (let [r (let [hit (BeamLisp.AOTCache/fetch
                                                        (BeamLisp.AOTCache/compiler_key)
                                                        closure_key link_dir)]
                                              (if (erlang/== :miss hit)
                                                (do (compile_and_publish ns content closure_key path) :compiled)
                                                (do (load_cached_entry ns (elem hit 1)
                                                                       (BeamLisp.AOTCache/entry_dir
                                                                         (BeamLisp.AOTCache/compiler_key) closure_key)
                                                                       link_dir)
                                                    :reused)))]
                                    ; Once evaluation starts, failures propagate. Falling
                                    ; back to interpretation would repeat earlier effects.
                                    (do (BeamLisp.Env/mark_loaded ns) :loaded))))))))))))))))))

(defn- repair_or_no_module
  "The gate's repair gatekeeper: try to repair a library artifact, else answer
   `:no_module` (the caller then interprets source, exactly as before)."
  [ns]
  (repair_library ns))

(defn boot
  "Start `BeamLisp.Env` if needed and seed `core` (idempotent).

   ONE DELIBERATE DIFFERENCE: the Elixir twin opened each start with a
   `{:ok, _} =` match, so a refused start raised a `MatchError` naming no
   process; this port raises a `RuntimeError` that NAMES the refusal. Both
   raise on the same condition, and neither path is reachable on a healthy
   boot (the process is started once, by the application, before any caller
   arrives) — but the class a `rescue` would read differs, so it is written
   down rather than hidden."
  []
  (if (erlang/== nil (Process/whereis :Elixir.BeamLisp.Env))
    (let [started (BeamLisp.Env/start_link (list))]
      (if (and (erlang/is_tuple started) (erlang/== :ok (elem started 0)))
        :ok
        (erlang/error
          (Elixir.RuntimeError/exception
            (erlang/iolist_to_binary
              (list "failed to start BeamLisp.Env: " (Kernel/inspect started)))))))
    :ok)
  (if (erlang/== nil (Process/whereis :Elixir.BeamLisp.Loader.Server))
    (do (BeamLisp.Loader.Server/start_link (list)) :ok)
    :ok)
  (BeamLisp/init)
  (maybe_load_core_backend)
  :ok)

(defn- maybe_load_core_backend
  "Canonical AOT has one backend. Loading `lower` also loads its `anf`
   dependency."
  []
  (BeamLisp.Loader/ensure_loaded "lower")
  :ok)

; ── source/emit key computation (the language's own `key-for`) ──────────────

(defn with_source_snapshot
  "Run `fun` with ONE source-content snapshot shared by every `ns_closure_hash`
   call inside it, so a pass that validates many namespaces reads and hashes
   each shared closure member ONCE instead of once per namespace. A snapshot IS
   a validation pass: an edit that lands mid-pass is not observed by that pass,
   and the next pass re-reads. Entries are keyed by RESOLUTION CONTEXT (the
   ambient search dirs the loader binds for the load) as well as by name, so a
   pass spanning two roots can never serve one project's bytes to the other's
   namespace.

   Without an open pass the cache is per CALL — one `ns_closure_hash` already
   dedups its own closure — and no correctness property depends on a caller
   taking a pass."
  [fun]
  (if (erlang/== nil (Process/get :bl_source_snapshot))
    (do
      (Process/put :bl_source_snapshot {})
      (try (fun) (finally (Process/delete :bl_source_snapshot))))
    (fun)))

(defn ns_closure_hash
  "The per-namespace freshness hash (FEAT-030, tier-2): a digest over `ns` and
   the content of its transitive `:require` closure, resolved against the LIVE
   source path. `with_source_snapshot` shares the resolution across a pass;
   otherwise each call gets its own per-call cache."
  ([ns] :when (string? ns) (ns_closure_hash ns nil))
  ([ns file] :when (string? ns)
   (let [shared (Process/get :bl_source_snapshot)]
     (if (erlang/== nil shared)
       (do
         (Process/put :bl_source_info_cache {})
         (try (closure_hash_of ns file)
              (finally (Process/delete :bl_source_info_cache))))
       (do
         ; A pass is open: ITS cache is this call's cache. Write the merged
         ; map back to the pass afterwards so the next member is shared.
         (Process/put :bl_source_info_cache shared)
         (try (closure_hash_of ns file)
              (finally (Process/put :bl_source_snapshot (Process/get :bl_source_info_cache {})))))))))

(defn- closure_hash_of
  "`ns_closure_hash`'s body, folded against whatever `:bl_source_info_cache`
   currently holds."
  [ns file]
  (let [seed (if (and file (File/exists? file))
               (list ns (BeamLisp.Loader/read_source file))
               nil)]
    ; Packaged runtimes carry beams without source. Answer before loading the
    ; planner: its own closure vetting would recurse into this gate.
    (if (and (nil? seed) (nil? (source_content_cached ns)))
      nil
      (do
        (BeamLisp.Loader/ensure_loaded "build-plan")
        (let [key_for (BeamLisp.Env/fetch! "build-plan" "key-for")]
          (if (BeamLisp.Ns.Rt/invocable? key_for 4)
            (let [memo (BeamLisp.Env/fetch! "build-plan" "memo-node")]
              (BeamLisp.Ns.Rt/invoke key_for
                (list ns (fn [n] (source_content_cached n)) seed memo)))
            (BeamLisp.Ns.Rt/invoke key_for
              (list ns (fn [n] (source_content_cached n)) seed))))))))

(defn- source_content_cached
  "Resolve a namespace's source CONTENT at most once per key computation —
   and, inside a validation pass, at most once for the whole pass per
   RESOLUTION CONTEXT. The context is the ambient search dirs the loader has
   bound, so the same NAME resolving to a different file under another root is
   never answered from this context's bytes."
  [ns]
  (let [key (tuple (Process/get :bl_search_dirs nil) ns)
        cache (Process/get :bl_source_info_cache {})]
    (if (erlang/is_map_key key cache)
      (Map/get cache key)
      (let [v (BeamLisp.Loader/source_content ns)]
        (Process/put :bl_source_info_cache (Map/put cache key v))
        v))))

; ── the drift gate ──────────────────────────────────────────────────────────

(defn- stale?
  "Whether a compiled beam no longer matches the source it was built from."
  [ns mod]
  (if (lists/member ns (staging_namespaces))
    (do (note_mixed_generation) false)
    (stale_by_provenance? ns mod)))

(defn- staging_namespaces
  "The namespaces the committed seed installed as a previous-generation
   bootstrap stage."
  []
  (let [v (Application/get_env :beam_lisp :bootstrap_staging nil)]
    (if (erlang/is_list v) v (list))))

(defn- note_mixed_generation
  "ONE note, once per VM, and only when the staged floor really is another
   generation."
  []
  (let [key (tuple :Elixir.BeamLisp.AOT :mixed_generation_noted)]
    (if (and (erlang/== false (persistent_term/get key false))
             (erlang/not (erlang/== (list) (BeamLisp.Tiers/boot_namespaces)))
             (erlang/not (erlang/== nil (BeamLisp.Bootstrap/manifest)))
             (erlang/not (BeamLisp.Bootstrap/key_matches? (BeamLisp.Bootstrap/manifest))))
      (do
        (persistent_term/put key true)
        (IO/puts :stderr "bl: the boot tier has MOVED; this VM is running it from the committed floor.")
        (IO/puts :stderr "bl: that floor is a previous generation of priv/boot/, so a primitive")
        (IO/puts :stderr "bl: added since then fails with an undefined var naming a file not at fault.")
        (IO/puts :stderr "bl: rebuild the tier as a unit:  bl build && bl seed"))
      nil)))

(defn- tier_key_moved?
  "Has the namespace's TIER key moved since its beam was stamped?"
  [tier beam_key]
  (cond
    (erlang/== :boot tier)
      (and (erlang/not (erlang/== (list) (BeamLisp.Tiers/boot_namespaces)))
           (erlang/=/= beam_key (BeamLisp.AOTCache/compiler_key)))

    (erlang/== :build tier)
      (and (erlang/not (erlang/== (list) (BeamLisp.Tiers/build_namespaces)))
           (erlang/=/= beam_key (BeamLisp.AOTCache/build_key)))

    :else
      (erlang/error
        (Elixir.FunctionClauseError/exception
          (list (erlang/list_to_tuple (list :module :Elixir.BeamLisp.AOT))
                (erlang/list_to_tuple (list :function :tier_key_moved?))
                (erlang/list_to_tuple (list :arity 2)))))))

(defn- stale_by_provenance?
  "Compare a beam's `__bl_provenance__/0` stamp against the LIVE source.

   GENERATION FIRST. The tier key is a memoized read; the source hash walks and
   hashes the namespace's WHOLE require-closure. So the cheap comparison decides
   first: a beam whose generation is not this VM's is stale whatever its source
   hashes say, and the closure hash is never computed for it — the gate stops
   paying its closure-hashing cost to answer a question the key already
   answered. A compatible generation keeps live source drift detection, and
   with it the dependency correctness that was always the point of the hash."
  [ns mod]
  (let [p (beam_provenance mod)]
    (if (erlang/== nil p)
      false
      (let [beam_hash (elem p 0)
            beam_key (elem p 1)
            tier (BeamLisp.Tiers/tier_of_ns ns)]
        (if (erlang/== :library tier)
          (let [live_key (BeamLisp.AOTCache/compiler_key)]
            (if (erlang/=/= beam_key live_key)
              (if (nil? (BeamLisp.Loader/source_path ns))
                false ; A sourceless image cannot repair; preserve packaged trust.
                (if (strict_aot?)
                  (erlang/error (Elixir.RuntimeError/exception
                                  (generation_stale_error ns mod beam_key live_key)))
                  (do (note_library_generation ns) true)))
              (let [src_hash (ns_closure_hash ns)]
                (cond
                  (erlang/== nil src_hash) false
                  (erlang/== beam_hash src_hash) false
                  (strict_aot?) (erlang/error (Elixir.RuntimeError/exception
                                                (stale_beam_error ns mod beam_hash src_hash)))
                  :else true))))
          (tier_key_moved? tier beam_key))))))

(defn beam_provenance
  "The `{hash, key}` provenance of a module's beam, or nil when it carries none.
   PUBLIC because the LAUNCHER asks it of every boot namespace, on a previous
   generation's beams, before the language exists."
  [mod]
  (if (and (Code/ensure_loaded? mod)
           (erlang/function_exported mod :__bl_provenance__ 0))
    (let [p (erlang/apply mod :__bl_provenance__ (list))]
      (cond
        (and (erlang/is_tuple p)
             (erlang/== 2 (erlang/tuple_size p))
             (erlang/== nil (erlang/element 1 p))) nil
        (and (erlang/is_tuple p) (erlang/== 2 (erlang/tuple_size p))) p
        :else nil))
    nil))

(defn- strict_aot?
  "Whether the drift gate must REFUSE LOUD instead of falling back to source."
  []
  (lists/member (System/get_env "BEAM_LISP_AOT_STRICT") (list "1" "true")))

(defn- generation_stale_error
  "The message a STRICT gate raises for a compiler-generation mismatch. It is
   its own message because the old wording was actively misleading: the source
   hashes can be IDENTICAL (the source did not move — the toolchain did), and
   the recovery named a Mix task this tree no longer has. The live recovery is
   the build."
  [ns mod beam_key live_key]
  (erlang/iolist_to_binary
    (list "stale AOT beam for " ns " (" (Kernel/inspect mod) "): compiled by toolchain "
          (short beam_key) ", this VM runs " (short live_key) ". "
          "The source may be unchanged — the TOOLCHAIN moved, so the beam cannot be "
          "linked into this VM. Rebuild the image: `bl build`.")))

(defn- stale_beam_error
  "The message a STRICT gate raises for SOURCE drift: the beam's bytes are older
   than the live source's, so the two hashes are what actually differ."
  [ns mod beam_hash src_hash]
  (erlang/iolist_to_binary
    (list "stale AOT beam for " ns " (" (Kernel/inspect mod) "): compiled from source "
          (short beam_hash) ", the current source hashes " (short src_hash) ". "
          "Rebuild the image: `bl build`.")))

(defn- short
  "The first twelve characters of a digest, or `<none>`."
  [h]
  (if (nil? h) "<none>" (String/slice h 0 12)))

(defn default_output_dir
  "The output directory a build defaults to: the Mix project's compile path when
   a Mix project is loaded, else an error naming what to pass instead."
  []
  (if (and (Code/ensure_loaded? :Elixir.Mix)
           (erlang/function_exported :Elixir.Mix.Project :compile_path 0))
    (erlang/apply :Elixir.Mix.Project :compile_path (list))
    (erlang/error
      (Elixir.ArgumentError/exception
        "BeamLisp.AOT needs an :output_dir (no Mix project loaded to default to compile_path)"))))
