; host/sandbox.bl — the pinned HOST MODULE for `Elixir.BeamLisp.Sandbox`.
;
; `lib/beam_lisp/sandbox.ex` is the test-harness surface for beam-lisp envs
; (PLAN-046 L3): a BASE IMAGE is an env holding evaluated namespaces, `warm!/2`
; builds one once per VM, `checkout/1` forks a zero-copy child of it and binds
; it in the calling process, `checkin/1` destroys the fork. This file is the
; `.bl` port of that module, compiled by `BeamLisp.AOT/compile_host_file` into
; ONE exact-named beam whose export surface is the live module's.
;
;   (This wave owns source and tests only; the seed entry that points the real
;   atom at this file is written by the wave that deletes `sandbox.ex`. That
;   entry carries no `:struct_fields`, no `:behaviour` and no `:macro_exports`
;   — the module is functions-only, its whole surface the file's top-level
;   `defn`s.)
;
; WHAT THE MODULE OWES, clause for clause:
;
;   * `warm!/2` is IDEMPOTENT BY NAME through `:persistent_term`, keyed
;     `{__MODULE__, name}` — the module atom is read from a fun literal
;     compiled into THIS file, so the same source serves the production atom in
;     the seed and a probe atom under test without naming either. A miss warms;
;     a hit returns the SAME base. The `src/` library-root convention is
;     applied INSIDE the base env, so forks see it through the chain, exactly
;     as the live module does.
;
;   * THE SOURCE DISPATCH. A source is a namespace name (`"my.app"` — through
;     the loader), a file path (anything that exists on disk — evaluated like a
;     test file, its directory pushed as a load path), or a zero-arg function
;     (called inside the base env). `load_source/1` is PRIVATE in the live
;     module and a pinned file's top-level `defn`s ARE its exports, so it is a
;     LOCAL closure inside `warm!/2` — the surface stays the live one.
;
;   * THE `is_atom` GUARDS BECOME BODY CHECKS, and that is a measured
;     divergence in form, never in behavior. Beam-lisp's guard vocabulary
;     (`priv/boot/compiler.bl`'s `guard-bifs`) has no atom predicate — an atom
;     is expressed only as `nil?`/`true?`/`keyword?`, and the negation of the
;     other type tests cannot be used (`map?` EXCLUDES the wrapper structs, so
;     a Vector would be mistaken for an atom). So `warm!/2` and `base!/1` test
;     `erlang/is_atom` in the BODY and, on failure, raise the SAME
;     `%FunctionClauseError{}` the live clause head would have:
;     `FunctionClauseError/exception` with the module, function and arity the
;     guard would have carried, through `erlang/error`. `checkout/1` needs no
;     such raise — its generic clause accepts any term — so the atom test only
;     chooses the `base!` route, as the live clause order does. `load_ns/1` and
;     `eval/1` keep a real `:when (string? …)` guard, which is exactly live's
;     `is_binary/1`. (`resolve_base/1`, in `priv/host/ex_unit_case.bl`, is the
;     third such body check.)
;
;   * `checkout/0,1`, `checkin/1`, `load_file/1`, `load_ns/1` and `eval/1` are
;     the live bodies, one call per call.
;
;   * `base!/1` RAISES THE LIVE `%RuntimeError{}`, message included, because a
;     caller's `rescue` reads it: `erlang/error` of `RuntimeError/exception`, the
;     same class and value a live `raise` produces. The message is built with
;     `erlang/iolist_to_binary` over `Kernel.inspect`, never `str` — `str` is a
;     namespace VAR, and a pinned beam resolves it through the language's
;     registry, which is the one dependency a message builder need not take.
;
; RUNTIME-TIER, NOT BOOT-TIER. Every caller is test tooling that runs after
; `BeamLisp.init/0`, and `warm!/2` calls `BeamLisp.init/0` itself before forking.
; Unlike a boot leaf (`priv/host/guards.bl`) this file builds its few tuples and
; lists with the language's own `(tuple …)`/`(list …)` — i.e. `BeamLisp.Ns.Core`,
; interned during the boot — the same runtime-tier trade
; `priv/host/reload_watcher.bl` makes; the pinned test PINS the whole remote set.
; The one construction that precedes `warm!/2`'s OWN `init/0` call is its
; `:persistent_term` KEY, so `warm!/2` presumes a booted VM — which every real
; caller already is (an ExUnit `setup_all`, which calls `BeamLisp.init/0` first,
; and every `.bl` test). Everything else is a plain call to a live module
; (`BeamLisp.Env`, `BeamLisp.Loader`, `BeamLisp.Compiler`, `Path`, `File`,
; `Enum`, `Kernel`).
;
; Run: bin/bl test test/bl/host_sandbox_test.bl

(ns host.sandbox)

(defn warm!
  "Evaluate `sources` into a fresh base env named `name`, once per VM.
   Idempotent by `name`: a second call returns the existing base."
  [name sources]
  (let [own (erlang/element 2 (erlang/fun_info (fn [] nil) :module))
        fce (fn [fun arity]
              (erlang/error
                (FunctionClauseError/exception
                  (list (erlang/list_to_tuple (list :module own))
                        (erlang/list_to_tuple (list :function fun))
                        (erlang/list_to_tuple (list :arity arity))))))
        key (erlang/list_to_tuple (list own name))
        load-source (fn [source]
                      (if (erlang/is_function source 0)
                        (erlang/apply source (list))
                        (if (File/exists? source)
                          (load_file source)
                          (load_ns source))))]
    (if (and (erlang/is_atom name) (erlang/is_list sources))
      (let [cached (erlang/apply :persistent_term :get (list key :undefined))]
        (if (erlang/== :undefined cached)
          (do
            (BeamLisp/init)
            (let [base (BeamLisp.Env/fork :global)]
              (BeamLisp.Env/with_env base
                (fn []
                  (let [src (Path/join (File/cwd!) "src")]
                    (if (File/dir? src) (BeamLisp.Env/add_search_path src) nil))
                  (Enum/each sources load-source)))
              (erlang/apply :persistent_term :put (list key base))
              base))
          cached))
      (fce :warm! 2))))

(defn base!
  "The base env previously warmed under `name`; raises if absent."
  [name]
  (let [own (erlang/element 2 (erlang/fun_info (fn [] nil) :module))
        fce (fn [fun arity]
              (erlang/error
                (FunctionClauseError/exception
                  (list (erlang/list_to_tuple (list :module own))
                        (erlang/list_to_tuple (list :function fun))
                        (erlang/list_to_tuple (list :arity arity))))))]
    (if (erlang/is_atom name)
      (let [v (erlang/apply :persistent_term :get
                            (list (erlang/list_to_tuple (list own name)) :undefined))]
        (if (erlang/== :undefined v)
          (erlang/error
            (RuntimeError/exception
              (erlang/iolist_to_binary
                (list "no warm base " (Kernel/inspect name)
                      " — warm it with BeamLisp.Sandbox.warm!/2 first"))))
          v))
      (fce :base! 1))))

(defn checkout
  "Fork a child of `base` (an env id, a warmed name, or `:global`) and bind it
   in the CALLING process. Returns the env id for `checkin/1`."
  ([] (checkout :global))
  ([base]
   (if (and (erlang/is_atom base) (erlang/=/= base :global))
     (checkout (base! base))
     (let [env (BeamLisp.Env/fork base)]
       (BeamLisp.Env/attach env)
       env))))

(defn checkin
  "Destroy a checked-out env. Call from `on_exit`."
  [env]
  (BeamLisp.Env/destroy env))

(defn load_file
  "Evaluate a file into the current env (its directory becomes a load path)."
  [path]
  (BeamLisp.Loader/with_load_path (Path/dirname path)
    (fn [] (BeamLisp.Compiler/eval_string (File/read! path))))
  :ok)

(defn load_ns
  "Load a namespace into the current env through the loader."
  [ns]
  :when (string? ns)
  (BeamLisp.Loader/ensure_loaded ns)
  :ok)

(defn eval
  "Evaluate a string of source into the current env."
  [source]
  :when (string? source)
  (BeamLisp.Compiler/eval_string source)
  :ok)
