; One canonical pure graph/interface freshness planner. No ETS, disk memo or
; namespace initialization. Runtime and compile-only AOT use the same algorithms.
(ns host.build-plan)

(defn- index-by
  "A map from (f x) to x over `xs`; a later x wins."
  [f xs]
  (lists/foldl (fn [x acc] (maps/put (f x) x acc)) (maps/new) xs))

(defn- as-list [xs]
  (if (erlang/=:= xs nil) (list) (if (erlang/is_list xs) xs (Enum/to_list xs))))

(defn- visit
  "Finish `ns` and everything below it. Returns the new state. `on-path` is
   the set of nodes on the current DFS path (cycle guard); a node found there
   is skipped as if done, with an empty contribution."
  [ns by-ns st on-path]
  (if (maps/is_key ns (maps/get :done st))
    st
    (if (maps/is_key ns on-path)
      st
      (let [node (maps/get ns by-ns nil)]
        (if (erlang/=:= node nil)
          ; an unresolvable require: nothing to compile, nothing below it. It
          ; still appears in closures (the caller adds the name itself).
          st
          (let [on-path (maps/put ns true on-path)
                reqs (as-list (maps/get :reqs node))
                st (lists/foldl (fn [r acc] (visit r by-ns acc on-path)) st reqs)
                done (maps/get :done st)
                ; the closure is this ns + the union of each require's closure
                ; (an unresolvable require contributes just its own name);
                ; the wave is 1 + the deepest resolvable require's wave
                ; the closure is this ns ∪ each require's closure; an
                ; unresolvable require contributes just its own name. Closures
                ; are kept as MAPS (name → true) so the union is a merge, never
                ; a sort: O(|closure|) per node, Σ|closure| overall — the same
                ; work the hash below must do anyway, so nothing here is above
                ; the floor. The wave is 1 + the deepest resolvable require's.
                step (fn [r acc]
                       (let [d (maps/get r done nil)]
                         (if (erlang/=:= d nil)
                           (erlang/list_to_tuple (list (maps/put r true (erlang/element 1 acc)) (erlang/element 2 acc)))
                           (erlang/list_to_tuple (list (maps/merge (erlang/element 1 acc) (maps/get :closure d))
                                                       (erlang/max (erlang/element 2 acc) (maps/get :wave d)))))))
                acc (lists/foldl step (erlang/list_to_tuple (list (maps/put ns true (maps/new)) 0)) reqs)
                closure (erlang/element 1 acc)
                wave (erlang/element 2 acc)
                entry (maps/put :closure closure (maps/put :wave (erlang/+ wave 1) (maps/new)))]
            (maps/put :order (lists/append (list node) (maps/get :order st))
                      (maps/put :done (maps/put ns entry done) st))))))))

(defn- edge_covered? [d xn x]
  (if (erlang/== xn nil) false
    (if (erlang/not (maps/is_key :iface xn)) false
      (let [refs (as-list (maps/get x (maps/get :refs d (maps/new)) (list)))
            inames (maps/get :inames xn (list))]
        (if (or (lists/member :all refs)
                (erlang/not (erlang/== (maps/get :macros d (list)) (list)))
                (lists/any (fn [r] (lists/member r (maps/get :macros xn (list)))) refs))
          false
          (lists/all (fn [r] (lists/member r inames)) refs))))))

(defn plan
  "Build the plan for `nodes` (see the header). Deterministic: nodes are
   visited in sorted path order, so the same inputs always give the same
   `:order` and `:waves`."
  ([nodes] (plan nodes nil))
  ([nodes requested]
  (let [nodes (as-list nodes)
        named (lists/filter (fn [n] (erlang/=/= nil (maps/get :ns n))) nodes)
        anon (lists/filter (fn [n] (erlang/=:= nil (maps/get :ns n))) nodes)
        by-ns (index-by (fn [n] (maps/get :ns n)) named)
        by-path (index-by (fn [n] (maps/get :path n)) nodes)
        ; Cycle knowledge, from the one owner: named paths over the SAME
        ; edges the walk below reads. The plan stays total; the consumer
        ; (the driver) decides a cycle is fatal.
        cycles (BeamLisp.SourceGraph/cycles (maps/keys by-ns)
                          (fn [n] (let [d (maps/get n by-ns nil)]
                                    (if (erlang/=:= d nil) (list) (as-list (maps/get :reqs d))))))
        st0 (maps/put :done (maps/new) (maps/put :order (list) (maps/new)))
        st (lists/foldl (fn [n acc] (visit (maps/get :ns n) by-ns acc (maps/new)))
                        st0
                        (lists/sort (fn [a b] (erlang/=< (maps/get :path a) (maps/get :path b))) named))
        done (maps/get :done st)
        ; anonymous files (no ns) compile last, in path order, in their own wave
        order (lists/append (lists/reverse (maps/get :order st))
                            (lists/sort (fn [a b] (erlang/=< (maps/get :path a) (maps/get :path b))) anon))
        node-of (fn [n] (maps/get n by-ns nil))
        ; Is D's edge to X covered — every name D references in X accounted
        ; for by X's interface? Only meaningful when both sides carry the
        ; interface fields; a `:refer :all` (names not attributable) or a
        ; missing field means "not covered".
        covered? (fn [d x] (edge_covered? d (node-of x) x))
        ; Who requires X, across the whole graph — computed ONCE (a reverse
        ; edge map), so asking it per closure member stays O(deg), keeping the
        ; plan O(V + E + Σ|closure|).
        requirers (lists/foldl (fn [n acc]
                                 (lists/foldl (fn [r a] (maps/put r (cons (maps/get :ns n) (maps/get r a (list))) a))
                                              acc (as-list (maps/get :reqs n))))
                               (maps/new) named)
        ; A covered-edge map: {X → set of nodes whose edge to X is covered},
        ; so `line-of` answers "is every observer of X inside D's closure
        ; covered?" with O(deg) membership tests. Observers OUTSIDE D's
        ; closure cannot reach D's bytes and rightly do not veto: `u` with
        ; `:refer :all` on x costs u a rebuild, never d.
        covered-map (lists/foldl (fn [x acc]
                                   (maps/put x (lists/foldl (fn [m a] (if (covered? (node-of m) x) (maps/put m true a) a))
                                                            (maps/new) (maps/get x requirers (list)))
                                             acc))
                                 (maps/new) (maps/keys by-ns))
        ; The line a closure member X contributes to D's key: D itself its
        ; content (its own edit must rebuild it); another X its INTERFACE iff
        ; every requirer of X that lies in D's closure has a covered edge to
        ; X — then no beam D's bytes depend on bakes more of X than its
        ; interface — else X's content; an unresolvable X `x:?`.
        line-of (fn [d x d-closure]
                  (let [xn (node-of x)]
                    (cond
                      (erlang/=:= xn nil) (erlang/iolist_to_binary (list x ":?"))
                      (erlang/=:= x (maps/get :ns d)) (erlang/iolist_to_binary (list x ":" (maps/get :hash xn)))
                      :else
                        (let [cov (maps/get x covered-map (maps/new))
                              observers (lists/filter (fn [m] (maps/is_key m d-closure)) (maps/get x requirers (list)))]
                          (if (lists/all (fn [m] (maps/is_key m cov)) observers)
                            (erlang/iolist_to_binary (list x ":" (maps/get :iface xn)))
                            (erlang/iolist_to_binary (list x ":" (maps/get :hash xn))))))))
        key-of (fn [node]
                 (let [ns (maps/get :ns node)]
                   (if (erlang/=:= ns nil)
                     (maps/get :hash node)
                     (let [d-closure (maps/get :closure (maps/get ns done))]
                       (BeamLisp.SourceGraph/hash-lines
                         (lists/map (fn [m] (line-of node m d-closure))
                                    (lists/sort (maps/keys d-closure))))))))
        ; A runtime gate asks for ONE root's key. Folding every dependency's
        ; key again computes unused transitive closures on every such query.
        ; Use the exact same key-of semantics, selecting only requested roots.
        keyed (if (erlang/== nil requested) order
                  (lists/filter (fn [node] (lists/member (maps/get :path node) requested)) order))
        keys (lists/foldl (fn [node acc] (maps/put (maps/get :path node) (key-of node) acc)) (maps/new) keyed)
        deps (lists/foldl (fn [node acc]
                            (maps/put (maps/get :path node)
                                      (lists/filtermap (fn [r] (let [d (maps/get r by-ns nil)]
                                                                 (if (erlang/=:= d nil) false
                                                                   (erlang/list_to_tuple (list true (maps/get :path d))))))
                                                       (as-list (maps/get :reqs node)))
                                      acc))
                          (maps/new) order)
        max-wave (lists/foldl (fn [n m] (erlang/max m (maps/get :wave (maps/get (maps/get :ns n) done)))) 0 named)
        wave-of (fn [node] (let [ns (maps/get :ns node)]
                             (if (erlang/=:= ns nil) (erlang/+ max-wave 1) (maps/get :wave (maps/get ns done)))))
        waves (lists/map (fn [k] (lists/filter (fn [node] (erlang/=:= k (wave-of node))) order))
                         (lists/seq 1 (if (erlang/=:= anon (list)) max-wave (erlang/+ max-wave 1))))
        closure (maps/map (fn [_ v] (lists/sort (maps/keys (maps/get :closure v)))) done)]
    (maps/put :order order
      (maps/put :waves (lists/filter (fn [w] (erlang/=/= w (list))) waves)
        (maps/put :closure closure
          (maps/put :key keys
            (maps/put :cycles cycles
              (maps/put :deps deps (maps/new))))))))))

(defn- ns-form?
  "Is this bare reader node an `(ns …)` list?"
  [form]
  (if (erlang/=:= :list (BeamLisp.Ns.Reader-node/node-tag form))
    (let [items (BeamLisp.Ns.Reader-node/node-items form)]
      (if (erlang/=:= items (list))
        false
        (let [h (erlang/hd items)]
          (if (erlang/=:= :symbol (BeamLisp.Ns.Reader-node/node-tag h))
            (erlang/=:= "ns" (BeamLisp.Ns.Reader-node/node-name h))
            false))))
    false))

(defn- header-of
  "The `[ns reqs]` ONE `(ns …)` form declares, through source-graph's own
   header reader — so a multi-namespace file answers each of its namespaces
   with the requires THAT form declares, not the first form's."
  [form]
  (let [h (Enum/to_list (BeamLisp.SourceGraph/header-forms (list form)))]
    (list (erlang/hd h) (erlang/hd (erlang/tl h)))))

(defn javascript-forms?
  "Read the target from the already parsed namespace headers. No source is
   evaluated; comments and unrelated :js values cannot change the target."
  [forms]
  (lists/any
    (fn [form]
      (let [bare (BeamLisp.Ns.Reader-node/node-form form)
            items (when (erlang/== :list (BeamLisp.Ns.Reader-node/node-tag bare))
                    (BeamLisp.Ns.Reader-node/node-items bare))
            head (when (and (erlang/is_list items) (erlang/not (erlang/== (list) items)))
                   (BeamLisp.Ns.Reader-node/node-form (erlang/hd items)))]
      (if (and (erlang/== :symbol (BeamLisp.Ns.Reader-node/node-tag head))
               (erlang/== "ns" (BeamLisp.Ns.Reader-node/node-name head)))
        (let [items (BeamLisp.Ns.Reader-node/node-items (BeamLisp.Ns.Reader-node/node-form form))
              name (lists/nth 2 items)
              raw (BeamLisp.Ns.Reader-node/node-pos name)
              metadata (if (erlang/is_map raw) raw (maps/new))
              interop (maps/get :interop metadata nil)]
          (or (erlang/== true (maps/get :js metadata nil))
              (erlang/== :javascript interop)
              (and (erlang/== :keyword (BeamLisp.Ns.Reader-node/node-tag interop))
                   (erlang/== "javascript" (BeamLisp.Ns.Reader-node/node-name interop)))))
        false)))
    forms))

(defn- content-parts
  "What a source's bytes ALONE determine about its node: `:hash`, `:iface`,
   `:inames`, `:refs`, and `:headers` — every `[ns reqs]` the file declares, in
   source order. Pure in `content`, so it is memoizable by content hash and
   never by path or mtime."
  [content]
  (let [fs (BeamLisp.SourceGraph/forms content)
        macros (lists/filtermap
                 (fn [line]
                   (if (String/starts_with? line "macro ")
                     (tuple true (lists/nth 2 (String/split line " ")))
                     false))
                 (BeamLisp.NamespaceInterface/lines-forms fs))
        headers (lists/foldl
                  (fn [f acc]
                    (if (ns-form? f) (lists/append acc (list (header-of f))) acc))
                  (list) fs)]
    (maps/put :macros macros
    (maps/put :hash (binary/encode_hex (crypto/hash :sha256 content))
      (maps/put :iface (BeamLisp.NamespaceInterface/hash-forms fs)
        (maps/put :inames (BeamLisp.NamespaceInterface/names-forms fs)
          (maps/put :refs (BeamLisp.SourceGraph/references-forms fs)
            (maps/put :headers headers (maps/new)))))))))

(defn build-content-parts
  "Build-only target classification accompanies the persistent parts memo.
   Runtime provenance keeps the ordinary bare-form parse; it does not need
   target metadata and must not pay for a position-bearing parse as well."
  [content]
  (maps/put :javascript? (javascript-forms? (BeamLisp.Reader/read_string content nil))
            (content-parts content)))

(defn- assemble
  "Assemble the node for `label` from content parts: the header whose ns is
   `label`, else the first (a file with no `(ns …)` declares none). The build
   passes the FILE PATH as `label` — it plans one node per file — and the gate
   the NAMESPACE, so each of a multi-namespace file's namespaces resolves its
   own header."
  [label parts]
  (let [hdrs (maps/get :headers parts)
        found (lists/foldl
                (fn [hr acc]
                  (if (erlang/=:= acc nil)
                    (if (erlang/=:= label (erlang/hd (Enum/to_list hr))) hr nil)
                    acc))
                nil hdrs)
        h (if (erlang/=:= found nil)
            (if (erlang/=:= hdrs (list)) (list nil (list)) (erlang/hd hdrs))
            found)
        hl (Enum/to_list h)]
    (maps/put :javascript? (maps/get :javascript? parts false)
    (maps/put :macros (maps/get :macros parts (list))
    (maps/put :path label
      (maps/put :ns (erlang/hd hl)
        (maps/put :reqs (erlang/hd (erlang/tl hl))
          (maps/put :hash (maps/get :hash parts)
            (maps/put :iface (maps/get :iface parts)
              (maps/put :inames (maps/get :inames parts)
                (maps/put :refs (maps/get :refs parts) (maps/new))))))))))))

(defn node-from
  "The plan node for a source: `{:path :ns :reqs :hash :iface :inames :refs}`,
   with the interface fields. `path` is whatever the caller wants in the
   node (the build uses the file path; the gate the ns name). A file declaring
   several namespaces answers with its FIRST header here; the gate, which asks
   by name, uses `memo-node` and gets that name's header."
  [path content]
  (assemble path (content-parts content)))

(defn- node-signature
  "A digest of the node SET a key was folded from: each node's path, content
   hash and interface hash, sorted. Two validations over the SAME bytes produce
   the same signature; an edit to ANY member of the closure — the root or a
   dependency the root never mentions — changes it. Interface-keyed plans are
   covered because a body-only edit to a covered dependency leaves `:iface`
   alone and therefore leaves the signature (and the key) alone, which is
   exactly what makes an intermediate artifact reusable."
  [nodes]
  (BeamLisp.SourceGraph/hash-lines
    (lists/sort
      (lists/map (fn [n]
                   (erlang/iolist_to_binary
                     (list (if (erlang/== nil (maps/get :path n nil)) "-" (maps/get :path n))
                           ":"
                           (if (erlang/== nil (maps/get :hash n nil)) "-" (maps/get :hash n))
                           ":"
                           (if (erlang/== nil (maps/get :iface n nil)) "-" (maps/get :iface n)))))
                 nodes))))

(defn nodes_from_resolver
  "Discover a root graph once from context-resolved nodes. The resolver may
   memoize source/node facts within a validation snapshot; this walk is pure."
  [ns resolve]
  (let [root (resolve ns)]
    (if (erlang/== root nil) nil
      (loop [todo (list ns) seen (maps/new) acc (list)]
        (if (erlang/== todo (list)) acc
          (let [name (erlang/hd todo) more (erlang/tl todo)]
            (if (maps/is_key name seen) (recur more seen acc)
              (let [node (if (erlang/== name ns) root (resolve name))]
                (recur (if (erlang/== node nil) more
                         (lists/append (as-list (maps/get :reqs node)) more))
                       (maps/put name true seen)
                       (if (erlang/== node nil) acc (cons node acc)))))))))))

(defn nodes_for [ns resolve seed node-of]
  (let [seed-ns (if (erlang/== seed nil) nil (erlang/hd (Enum/to_list seed)))]
    (nodes_from_resolver ns
      (fn [name]
        (let [content (if (erlang/== name seed-ns)
                        (erlang/hd (erlang/tl (Enum/to_list seed))) (resolve name))]
          (if (erlang/== content nil) nil (node-of name content)))))))

(defn key_from_nodes
  "One reachable root graph, one key. Fold its edges once to decide interface
   coverage; never construct every dependency's transitive closure. Cyclic
   graphs retain the total planner's historical back-edge semantics."
  [ns nodes]
  (let [by-ns (index-by (fn [n] (maps/get :ns n)) nodes)
        root (lists/keyfind ns 1 (lists/map (fn [node] (tuple (maps/get :path node) node)) nodes))
        ordinary-root (and (erlang/not (erlang/== false root))
                           (erlang/== ns (maps/get :ns (erlang/element 2 root))))
        cycles (BeamLisp.SourceGraph/cycles (maps/keys by-ns)
                 (fn [n] (let [node (maps/get n by-ns nil)]
                           (if (erlang/== nil node) (list) (as-list (maps/get :reqs node)))))) ]
    (if (or (erlang/not ordinary-root) (erlang/not (erlang/== (list) cycles)))
      (maps/get ns (maps/get :key (plan nodes (list ns))))
      (let [edges (lists/foldl
                    (fn [d acc]
                      (lists/foldl
                        (fn [x a]
                          (let [covered (edge_covered? d (maps/get x by-ns nil) x)]
                            (maps/put x (and covered (maps/get x a true)) a)))
                        acc (as-list (maps/get :reqs d))))
                    (maps/new) nodes)
            names (lists/usort (lists/append (maps/keys by-ns) (maps/keys edges)))]
        (BeamLisp.SourceGraph/hash-lines
          (lists/map (fn [x]
                       (let [node (maps/get x by-ns nil)]
                         (erlang/iolist_to_binary
                           (list x ":" (if (erlang/== nil node) "?"
                             (if (and (erlang/not (erlang/== x ns)) (maps/get x edges false))
                               (maps/get :iface node) (maps/get :hash node))))))) names))))))

(defn key_for
 ([ns resolve seed] (key_for ns resolve seed (fn [name content] (node-from name content))))
 ([ns resolve seed node-of]
  (let [nodes (nodes_for ns resolve seed node-of)]
    (if (erlang/== nodes nil) nil (key_from_nodes ns nodes)))))
