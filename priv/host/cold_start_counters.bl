; Opt-in native launcher profiling. This module runs before language boot;
; every table is literal native data and no namespace initialization is needed.
(ns host.cold-start-counters)
(defn- lst [& xs] xs)
(defn- tup [& xs] (erlang/list_to_tuple xs))
(defn- patterns []
 (lst (tup :Elixir.BeamLisp.Env :prepare_sdk_class! 1)
       (tup :Elixir.BeamLisp.AOT :sdk_class_evidence! 1)
       (tup :Elixir.BeamLisp.Env :retain_sdk_runtime! 0)
       (tup :Elixir.BeamLisp.AOT :bootstrap_sdk_native_hosts! 0)
       (tup :Elixir.BeamLisp.Env :sdk_runtime_inventory_cached! 0)
       (tup :Elixir.BeamLisp.AOT :sdk_runtime_inventory! 1)
       (tup :Elixir.BeamLisp.AOT :inventory_term 1)
       (tup :Elixir.BeamLisp.Env :sdk_runtime_retained_modules? 1)
       (tup :Elixir.BeamLisp.AOT :complete_source_sdk_closure! 1)
       (tup :Elixir.BeamLisp.AOT :sdk_source_target_inventory! 1)
       (tup :Elixir.BeamLisp.AOT :source_seed_inventory! 0)
       (tup :Elixir.BeamLisp.AOT :source_sdk_receipts 0)
       (tup :Elixir.BeamLisp.AOT :sdk_source_dependency! 1)
       (tup :Elixir.BeamLisp.AOT :stage_sdk_dependency! 3)
       (tup :Elixir.BeamLisp.AOT :sdk_native_source_declaration 2)
       (tup :Elixir.BeamLisp.Tiers :dirs 1)))
(defn- now [] (erlang/monotonic_time :millisecond))
(defn- line [parts] (IO/puts :stderr (IO/iodata_to_binary parts)))
(defn- integer [x] (erlang/integer_to_binary x))
(defn- fresh []
 (maps/from_list (lst (tup :file 0) (tup :reads 0) (tup :stats 0)
                     (tup :opens 0) (tup :lists 0) (tup :compile 0) (tup :ports 0))))
(defn- bump [counts function]
 (let [counts (Map/update! counts :file (fn [n] (erlang/+ n 1)))
       field (cond
               (or (erlang/== function :read) (erlang/== function :read_file)) :reads
               (or (erlang/== function :get_file_info) (erlang/== function :read_link_info)
                   (erlang/== function :read_file_info)) :stats
               (erlang/== function :open) :opens
               (erlang/== function :list_dir) :lists
               :else nil)]
  (if field (Map/update! counts field (fn [n] (erlang/+ n 1))) counts)))
(defn- counted [counts message]
 (if (and (erlang/is_tuple message) (erlang/== 4 (erlang/tuple_size message))
          (erlang/== :trace (erlang/element 1 message)) (erlang/== :call (erlang/element 3 message)))
  (let [mfa (erlang/element 4 message)]
   (if (and (erlang/is_tuple mfa) (erlang/== 3 (erlang/tuple_size mfa)))
    (let [module (erlang/element 1 mfa) function (erlang/element 2 mfa)]
     (cond
      (erlang/== :prim_file module) (bump counts function)
      (and (erlang/== :compile module)
           (or (erlang/== function :forms) (erlang/== function :noenv_forms)))
       (Map/update! counts :compile (fn [n] (erlang/+ n 1)))
      (and (erlang/== :erlang module) (erlang/== :open_port function))
       (Map/update! counts :ports (fn [n] (erlang/+ n 1)))
      :else counts)) counts)) counts))
(defn- flush [counts]
 (receive message (recur (counted counts message)) (after 0 counts)))
(defn- delivered [ref counts deadline]
 ;; Count messages while waiting for the delivery barrier. The old utility
 ;; discarded these calls, so its final counts depended on mailbox timing.
 (let [left (erlang/max 0 (erlang/- deadline (now)))]
  (receive
   [:trace_delivered :all seen] :when (== ref seen) counts
   message (recur ref (counted counts message) deadline)
   (after left counts))))
(defn- accumulate [counts]
 (let [previous (Process/get :bl_profile_totals (fresh))
       total (Map/merge previous counts (fn [_ a b] (erlang/+ a b)))]
  (Process/put :bl_profile_totals total) total))
(defn- emit [name started]
 (let [counts (flush (fresh))]
  (accumulate counts)
  (line (lst "bl-profile phase=" name " ms=" (integer (erlang/- (now) started))
              " file=" (integer (Map/get counts :file)) " reads=" (integer (Map/get counts :reads))
              " stats=" (integer (Map/get counts :stats)) " lists=" (integer (Map/get counts :lists))
              " compile=" (integer (Map/get counts :compile))))))
(defn- timed0 [name f]
 (fn [] (let [started (now) value (erlang/apply f (lst))] (emit name started) value)))
(defn- timed1 [name f]
 (fn [a] (let [started (now) value (erlang/apply f (lst a))] (emit name started) value)))
(defn- timed2 [name f]
 (fn [a b] (let [started (now) value (erlang/apply f (lst a b))] (emit name started) value)))
(defn- emit-seams [profile elapsed]
 (when (and (erlang/is_tuple profile) (erlang/== 2 (erlang/tuple_size profile))
            (erlang/== :call_time (erlang/element 1 profile)))
  (Enum/each (erlang/element 2 profile)
   (fn [entry]
    (let [module (erlang/element 1 entry) function (erlang/element 2 entry)
          arity (erlang/element 3 entry) rows (erlang/element 4 entry)
          calls (Enum/reduce rows 0 (fn [row n] (erlang/+ n (erlang/element 2 row))))
          us (Enum/reduce rows 0 (fn [row n] (erlang/+ n (erlang/element 3 row))))
          share (if (erlang/> elapsed 0) (Float/round (erlang// (erlang/* us 100) (erlang/* elapsed 1000)) 2) 0.0)]
     (line (lst "bl-seam mfa=" (Kernel/inspect module) "." (erlang/atom_to_binary function :utf8)
                 "/" (integer arity) " calls=" (integer calls) " us=" (integer us)
                 " ms=" (Kernel/inspect (Float/round (erlang// us 1000) 3))
                 " share=" (Kernel/inspect share) "%")))))))
(defn- timed-app-start []
 (let [started (now)
       profile (if (erlang/== "0" (System/get_env "BL_PROFILE_SEAMS"))
                 (tup (Application/ensure_all_started :beam_lisp) :none)
                 (tprof/profile (fn [] (Application/ensure_all_started :beam_lisp))
                  (maps/from_list (lst (tup :type :call_time) (tup :pattern (patterns))
                    (tup :report :return)
                    (tup :rootset (Enum/reject (lst (Process/whereis :application_controller))
                                   (fn [x] (erlang/== nil x))))))))]
  (emit-seams (erlang/element 2 profile) (erlang/- (now) started))
  (emit "app_start" started)
  (erlang/element 1 profile)))
(defn- trace-on []
 (let [enabled (erlang/not (erlang/== "0" (System/get_env "BL_PROFILE_TRACE")))]
  (persistent_term/put :bl_profile_trace enabled)
  (when enabled
   (erlang/trace_pattern (tup :prim_file :_ :_) true (lst :local))
   (erlang/trace_pattern (tup :compile :forms :_) true (lst))
   (erlang/trace_pattern (tup :compile :noenv_forms :_) true (lst))
   (erlang/trace_pattern (tup :erlang :open_port 2) true (lst))
   (erlang/trace :all true (lst :call (tup :tracer (erlang/self)))))))
(defn- dump []
 (let [counts (flush (fresh))
       counts (if (persistent_term/get :bl_profile_trace false)
                (let [_ (erlang/trace :all false (lst :call))
                      ref (erlang/trace_delivered :all)]
                 (flush (delivered ref counts (erlang/+ (now) 2000)))) counts)
       total (accumulate counts)]
  (line (lst "bl-count modules=" (integer (erlang/length (code/all_loaded)))
              " apps=" (integer (erlang/length (application/which_applications)))
              " pt=" (integer (Map/get (persistent_term/info) :count))
              " ets=" (integer (erlang/length (ets/all)))
              " ports=" (integer (Map/get total :ports))
              " file_calls=" (integer (Map/get total :file))
              " file_reads=" (integer (Map/get total :reads))
              " file_stats=" (integer (Map/get total :stats))
              " file_opens=" (integer (Map/get total :opens))
              " file_lists=" (integer (Map/get total :lists))
              " compile_forms=" (integer (Map/get total :compile))))))
(defn- finish [status]
 (line (lst "bl-profile phase=total ms="
             (integer (erlang/- (now) (persistent_term/get :bl_profile_t0 (now))))))
 (dump) (System/halt status))
(defn- seams []
 (maps/from_list (lst
  (tup :install_hosts (timed1 "install_hosts" (erlang/make_fun :Elixir.BeamLisp.Bootstrap :install_hosts! 1)))
  (tup :manifest (timed0 "manifest" (erlang/make_fun :Elixir.BeamLisp.Bootstrap :manifest 0)))
  (tup :key_now (timed0 "key_now" (erlang/make_fun :Elixir.BeamLisp.AOTCache :current_compiler_key 0)))
  (tup :boot_namespaces (timed0 "boot_namespaces" (erlang/make_fun :Elixir.BeamLisp.Tiers :boot_namespaces 0)))
  (tup :provenance (timed1 "provenance" (erlang/make_fun :Elixir.BeamLisp.AOT :beam_provenance 1)))
  (tup :start_app (fn [] (timed-app-start)))
  (tup :ensure_loaded (timed1 "ensure_loaded" (erlang/make_fun :Elixir.BeamLisp.Loader :ensure_loaded 1)))
  (tup :fetch (timed2 "fetch" (erlang/make_fun :Elixir.BeamLisp.Env :fetch! 2)))
  (tup :invoke (timed2 "invoke" (erlang/make_fun :Elixir.BeamLisp.Ns.Rt :invoke 2)))
  (tup :stderr (fn [message] (IO/puts :stderr message)))
  (tup :halt (fn [status] (finish status)))
 )))
(defn main []
 (trace-on)
 (Process/put :bl_profile_totals (fresh))
 (persistent_term/put :bl_profile_t0 (now))
 (BeamLisp.Launcher/boot (System/argv) (seams)))
