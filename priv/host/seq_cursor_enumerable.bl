; host/seq_cursor_enumerable.bl — the pinned PROTOCOL IMPL for `BeamLisp.SeqCursor`.
;
; `defimpl Enumerable, for: BeamLisp.SeqCursor` is its own module,
; `Enumerable.BeamLisp.SeqCursor`, compiled beside the type it serves. This file
; is the `.bl` port of that impl, compiled by `BeamLisp.AOT/compile_host_file`
; into `Elixir.Enumerable.BeamLisp.SeqCursor.beam`.
;
; THE MODULE ATOM IS OUTSIDE `Elixir.BeamLisp.*`, for the same reason its Set
; sibling is: the seed's host inventory is an explicit list of `{:module,
; :source}` entries rather than a name-prefix rule, because a prefix cannot name
; this beam.
;
; ABI PARITY IS THE CONTRACT, and here the shape is NOT the Set impl's. A cursor
; has no size and no constant-time member test, so `count`/`member?`/`slice` all
; answer `{:error, <this impl module>}` (NOT `{:ok, …}`) and the caller falls
; back to `reduce`. `reduce` streams: `{:halt, acc}` stops (`{:halted, acc}`);
; `{:suspend, acc}` answers `{:suspended, acc, k}` where `k` resumes the SAME
; cursor, so a suspended walk pays for nothing it has not read; `{:cont, acc}`
; pulls ONE cell and passes the caller's fun result straight back in as the next
; accumulator — which is how a `fun` that itself answers `{:halt, _}` or
; `{:suspend, _}` steers the walk without a second match here.
;
; `count`/`member?`/`slice` name their own module from a fun literal compiled
; into THIS file, so at a probe atom they answer that atom — module-exact, never
; a hard-coded `Enumerable.BeamLisp.SeqCursor`. `reduce` re-enters ITSELF for
; the cont step and the suspend continuation through the same fun-literal
; module read, never the bare symbol `reduce`: a pinned module's own namespace
; vars are absent from a fresh VM.
;
; `BeamLisp.SeqCursor/cell` is called at its PRODUCTION atom on purpose: the
; impl serves exactly one type, so a value reaching `reduce` carries that type's
; tag and the direct call is the live dispatch. Nothing here mints a type atom
; from a string, and no `:struct_fields` is requested, so this beam is
; FUNCTIONS-ONLY.
;
; Run: bin/bl test test/bl/host_seq_cursor_test.bl

(ns host.seq-cursor-enumerable)

(defn __impl__
  "The `defimpl`-generated introspection: `:for` is the type, `:protocol` the
   protocol. An unknown key is the `FunctionClauseError` the generated
   two-clause function raised."
  [k]
  (cond
    (= :for k) :"Elixir.BeamLisp.SeqCursor"
    (= :protocol k) :"Elixir.Enumerable"
    :else (erlang/error
            (Elixir.FunctionClauseError/exception
              (list (tuple :module (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))
                    (tuple :function :__impl__)
                    (tuple :arity 1))))))

(defn count
  "`Enumerable.count/1`: a cursor is a folded stream, not a sized collection —
   there is no count without draining it, so the caller falls back to `reduce`."
  [_cursor]
  (tuple :error (erlang/element 2 (erlang/fun_info (fn [] nil) :module))))

(defn member?
  "`Enumerable.member?/2`: no membership test short of a walk; fall back to
   `reduce`."
  [_cursor _value]
  (tuple :error (erlang/element 2 (erlang/fun_info (fn [] nil) :module))))

(defn slice
  "`Enumerable.slice/1`: no constant-time slice for a stream; fall back to
   `reduce`. The error names THIS impl module, as `__MODULE__` did."
  [_cursor]
  (tuple :error (erlang/element 2 (erlang/fun_info (fn [] nil) :module))))

(defn reduce
  "`Enumerable.reduce/3`. Only the three tagged accumulators the protocol
   defines are accepted; any other shape is the `FunctionClauseError` the live
   clauses raised."
  [cursor acc fun]
  (cond
    (and (erlang/is_tuple acc) (erlang/== :halt (erlang/element 1 acc)))
    (tuple :halted (erlang/element 2 acc))

    (and (erlang/is_tuple acc) (erlang/== :suspend (erlang/element 1 acc)))
    (tuple :suspended (erlang/element 2 acc)
      (fn [next]
        (erlang/apply
          (erlang/element 2 (erlang/fun_info (fn [] nil) :module))
          :reduce
          (list cursor next fun))))

    (and (erlang/is_tuple acc) (erlang/== :cont (erlang/element 1 acc)))
    (let [c (BeamLisp.SeqCursor/cell cursor)]
      (if (nil? c)
        (tuple :done (erlang/element 2 acc))
        (erlang/apply
          (erlang/element 2 (erlang/fun_info (fn [] nil) :module))
          :reduce
          ;; Enumerable's reducer is an arity-2 native fun. A language call
          ;; would re-admit Enum's internal reducer and captured accumulator
          ;; as an application callback at every element of this native fold.
          (list (erlang/tl c)
                (erlang/apply fun (list (erlang/hd c) (erlang/element 2 acc))) fun))))

    :else
    (erlang/error
      (Elixir.FunctionClauseError/exception
        (list (tuple :module (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))
              (tuple :function :reduce)
              (tuple :arity 3))))))
