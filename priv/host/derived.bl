; host/derived.bl — the pinned HOST MODULE for `Elixir.BeamLisp.Derived`.
;
; `BeamLisp.Derived` is the value a `derived` computation produces: the
; `LazyMemo` memo `cell` that holds `:stale` or `{:fresh, value,
; recorded_dep_values}`, the normalized `deps`, and the zero-arity `thunk`. It
; carries its own struct so a derived is never mistaken for an atom, a delay,
; or a plain map. This file is the `.bl` port of `lib/beam_lisp/reactive.ex`'s
; `BeamLisp.Derived` half, compiled by `BeamLisp.AOT/compile_host_file` into
; ONE exact-named beam (`Elixir.BeamLisp.Derived.beam`) whose `__struct__/0,1`
; pair and `__info__/1` are SYNTHESIZED by the `:struct_fields` option — no
; `defstruct`, no Elixir source.
;
; A pinned module is FUNCTIONS-only, so the source must spell at least one
; `defn`; `new/3` is that public constructor. It returns exactly the map
; `__struct__/1` builds — tagged with whatever module the file was compiled
; into — so `(new cell deps thunk)` and `(__struct__ (list (tuple :cell cell)
; (tuple :deps deps) (tuple :thunk thunk)))` are the same value at every atom,
; production or probe.
;
; Run: bin/bl test test/bl/host_reactive_test.bl

(ns host.derived)

; WHY NOT `(__struct__ …)`. `__struct__/1` is synthesized by the pinned emitter
; from `:struct_fields`, and a pinned file cannot call it by name: an
; unqualified `__struct__` is not a unit defn, so the compiler lowers it to a
; var lookup ("undefined var: host.derived/__struct__") rather than the direct
; call the pinned retarget step could fix. The tag that emitter bakes into
; `__struct__/0` is the module this file's own code occupies; the module a fun
; literal compiled into this file occupies is the same atom, and
; `erlang:fun_info(F, module)` answers exactly it. So `new` is module-exact: at
; `BeamLisp.Derived` it builds `%BeamLisp.Derived{}`, and a probe compile under
; any other atom builds that atom's struct — matching that beam's
; `__struct__/1`.
(defn new
  "The `%Derived{cell: cell, deps: deps, thunk: thunk}` constructor:
   `__struct__/1` fed the three fields in declaration order."
  [cell deps thunk]
  (let [mod (erlang/element 2 (erlang/fun_info (fn [] nil) :module))]
    (maps/put :__struct__ mod
      (maps/put :cell cell
        (maps/put :deps deps
          (maps/put :thunk thunk (maps/new)))))))
