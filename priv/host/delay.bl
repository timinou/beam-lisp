; host/delay.bl — the pinned HOST MODULE for `Elixir.BeamLisp.Delay`.
;
; `BeamLisp.Delay` is the deferred-computation value: a body that runs at most
; once, on first force, backed by one `BeamLisp.LazySeq` cell. It carries its
; own struct so a delay is never mistaken for a sequence. This file is the
; `.bl` port of `lib/beam_lisp/deferred.ex`'s `BeamLisp.Delay` half, compiled
; by `BeamLisp.AOT/compile_host_file` into ONE exact-named beam
; (`Elixir.BeamLisp.Delay.beam`) whose `__struct__` pair is SYNTHESIZED by the
; `:struct_fields` option — no `defstruct`, no Elixir source.
;
; A pinned module is FUNCTIONS-only, so the source must spell at least one
; `defn`; `new/1` is that public constructor. It returns exactly the map
; `__struct__/1` builds — tagged with whatever module the file was compiled
; into — so `(new seq)` and `(__struct__ (list (tuple :seq seq)))` are the same
; value at every atom, production or probe.
;
; Run: bin/bl test test/bl/host_deferred_test.bl

(ns host.delay)

; WHY NOT `(__struct__ …)`. `__struct__/1` is synthesized by the pinned emitter
; from `:struct_fields`, and a pinned file cannot call it by name: an
; unqualified `__struct__` is not a unit defn, so the compiler lowers it to a
; var lookup ("undefined var: host.delay/__struct__") rather than the direct
; call the pinned retarget step could fix. The tag that emitter bakes into
; `__struct__/0` is the module this file's own code occupies; the module a fun
; literal compiled into this file occupies is the same atom, and
; `erlang:fun_info(F, module)` answers exactly it. So `new` is module-exact: at
; `BeamLisp.Delay` it builds `%BeamLisp.Delay{}`, and a probe compile under any
; other atom builds that atom's struct — matching that beam's `__struct__/1`.
(defn new
  "The `%Delay{seq: seq}` constructor: `__struct__/1` fed `{:seq, seq}`."
  [seq]
  (let [mod (erlang/element 2 (erlang/fun_info (fn [] nil) :module))]
    (maps/put :seq seq (maps/put :__struct__ mod (maps/new)))))
