; host/meta.bl — the pinned HOST MODULE for `Elixir.BeamLisp.Meta`.
;
; `meta/1`, `with_meta/2`, `vary_meta/2` — Clojure metadata on the BEAM, over
; the ONE runtime value type that can honestly carry it. This is the `.bl` port
; of `lib/beam_lisp/meta.ex`'s `BeamLisp.Meta` half, compiled FUNCTIONS-ONLY by
; `BeamLisp.AOT/compile_host_file` into `Elixir.BeamLisp.Meta.beam` — no struct,
; no `__info__`, no namespace of its own.
;
; WHY THE HONEST SURFACE IS THIS SMALL. Erlang terms are immutable and
; value-typed: `=` is structural, so no per-value slot exists that `=` and
; printing can be told to skip, and keying a side table by structural equality
; would leak metadata across every equal term in the program. A
; `%BeamLisp.LazySeq{}` is the exception — it owns a per-instance `:resource`
; reference and an immutable `:metadata` field — so it is the one value type
; whose metadata is real. For every other type `with_meta/2` is a documented
; NO-OP and `meta/1` is `nil`, which is exactly what jank's threading / `doto`
; macros need to round-trip source-location metadata without changing the shape
; of the threaded value.
;
; ABI PARITY IS THE CONTRACT: the same answers, the same value shapes, the same
; exception class AND message as the Elixir module it stands in for, and the
; SAME EXPORTS and nothing else. That last clause is why there is no top-level
; helper here — the pinned emitter exports every top-level `defn` it compiles
; (even a `defn-`), so a helper would become public API the recalled module
; never had. It would also be a LIVE HAZARD: a pinned module's functions are
; not interned as namespace vars, so a helper reached by NAME through
; `BeamLisp.Env` would answer in the compile VM and fail on a fresh boot.
; Everything therefore stays inline, in local closures.
;
; THE LAZY SEQ SEAM IS MODULE-EXACT. A `%BeamLisp.LazySeq{}` is recognized by
; its `:__struct__` atom (`Elixir.BeamLisp.LazySeq`), never by a hard-coded
; probe tag, and its metadata lives in the struct's own `:metadata` field.
; `with_meta/2` is therefore an immutable struct update that SHARES the
; source's native memo `:resource`: successful realization is shared, and
; changing metadata never repeats an effect. `nil` clears it (and is a no-op
; for every type that cannot carry it).
;
; Run: bin/bl test test/bl/host_meta_test.bl

(ns host.meta)

(defn meta
  "The metadata map attached to `x`, or `nil` when it has none.

   Only a lazy seq carries metadata; every other value type answers `nil`, so
   the Clojure idiom `(meta x)` is always safe."
  [x]
  (if (and (erlang/is_map x)
           (erlang/is_map_key :__struct__ x)
           (erlang/== :"Elixir.BeamLisp.LazySeq" (erlang/map_get :__struct__ x)))
    (maps/get :metadata x)
    nil))

(defn with_meta
  "Attach `m` (any map, structs included) to `x`, returning a value equal to
   `x` that carries it. `nil` clears metadata — and is a no-op for types that
   cannot carry it. A non-map, non-nil `m` raises `ArgumentError`, matching
   Clojure's \"Metadata must be … a Map\".

   On a lazy seq the returned value is an immutable struct update: the original
   keeps its own metadata, while BOTH values retain the exact same native memo
   resource and therefore share realization. On every other type `x` is
   returned unchanged (the identical term)."
  [x m]
  (let [lazy-seq? (fn [v]
                    (and (erlang/is_map v)
                         (erlang/is_map_key :__struct__ v)
                         (erlang/== :"Elixir.BeamLisp.LazySeq" (erlang/map_get :__struct__ v))))
        ; `erlang/iolist_to_binary`, not `str`: a pinned host module must not
        ; reach a BL namespace var (not even `core`'s `str`) — its beam then
        ; imports nothing from `BeamLisp.Env` at all, so it answers even before
        ; the prelude exists. Same bytes, no registry.
        bad! (fn []
               (erlang/error
                 (Elixir.ArgumentError/exception
                   (erlang/iolist_to_binary
                     (list "metadata must be a map or nil, got: "
                           (Elixir.Kernel/inspect m))))))]
    (if (lazy-seq? x)
      (cond
        (erlang/== nil m) (maps/put :metadata nil x)
        (erlang/is_map m) (maps/put :metadata m x)
        :else (bad!))
      (cond
        (erlang/== nil m) x
        (erlang/is_map m) x
        :else (bad!)))))

(defn vary_meta
  "`(vary-meta x f)`: reattach `(f (meta x))` to `x`. `f` is a bare Elixir
   function, a beam-lisp fn value, or any other invocable the runtime accepts;
   it always receives the current metadata map (or `nil` when absent), like
   Clojure."
  [x f]
  (if (erlang/is_function f)
    (with_meta x (f (meta x)))
    (with_meta x (BeamLisp.Ns.Rt/invoke f (list (meta x))))))
