; host/test_rt.bl — the pinned HOST MODULE for `Elixir.BeamLisp.TestRT`.
;
; `lib/beam_lisp/test_rt.ex` is the registry and run engine behind the
; self-hosted suite (`priv/std/test.bl`): `deftest`/`is`/`testing`/`are` register
; test fns here, `run-tests` drives them, and `bl test` reaches the whole thing
; through `run_suite/2`. This file is the `.bl` port of that module, compiled by
; `BeamLisp.AOT/compile_host_file` into ONE exact-named beam whose export surface
; is the live module's.
;
;   (This wave owns source and tests only; the seed entry that points the real
;   atom at this file is written by the wave that deletes `test_rt.ex`. That
;   entry carries no `:struct_fields`, no `:behaviour` and no `:macro_exports` —
;   the module is functions-only, its whole surface the file's top-level
;   `defn`s.)
;
; WHAT THE MODULE OWES, clause for clause:
;
;   * THE REGISTRY IS ENV-SCOPED, THE RUN STATE IS PROCESS-LOCAL, and the split
;     is load-bearing. Registrations live in the shared vars table
;     (`Env/lookup_own`, `Env/put_key`, `Env/match_own`, `Env/match_delete_own`)
;     so a forked suite runs only ITS tests. Counters and the current-test
;     context live in the PROCESS dictionary (`Process/get`, `Process/put`),
;     because a test body that asserts inside `(env/with-env fork …)` writes its
;     record under the FORK's env while the summary is read under the suite's —
;     the FAIL printed and the total said 0. Both homes are reproduced exactly.
;
;   * EVERY PRIVATE HELPER IS A LOCAL CLOSURE. A pinned module exports its
;     file's top-level `defn`s, so a `defn-` helper WOULD leak into the ABI.
;     `print-report`/`suffix`/`fmt` live inside `record/6`, `unwrap`/`walk`/
;     `vector?` inside `subst/3`, and `eval-file`/`run-file-isolated`/the two run
;     modes inside `run_suite/2` — so the surface is the live module's, exactly.
;
;   * TRY/CATCH IS RECONSTRUCTED, NOT TRANSLATED. The live `run_ns/1` is
;     `rescue e -> …; catch kind, value -> …`. beam-lisp folds a raise to the
;     normalized exception, a `:throw` to its raw value and an `:exit` to
;     `{:exit, v}`, and binds the raw catch kind as `__EXCEPTION_KIND__`. So the
;     recorded `actual` is rebuilt to the same three values the live clauses
;     store: the exception for `:error`, `(tuple :throw v)` for a throw, and the
;     already-folded `{:exit, v}` for an exit.
;
;   * `test_lib_source/0` CARRIES `priv/std/test.bl` INSIDE THE BEAM, exactly as
;     the live `@test_lib` does — an escript or a flat `.beam` deployment has no
;     priv tree, and `run_suite/2` compiles the embedded copy, so the copy IS the
;     run's library. The literal below is GENERATED from the file (see the
;     `@@EMBED-TEST-LIB@@` markers and the regeneration recipe in the focused
;     test); the focused test also asserts it equals `priv/std/test.bl` byte for
;     byte, which is the drift gate `@external_resource` used to provide.
;
; RUNTIME-TIER, NOT BOOT-TIER. Every caller runs after `BeamLisp.init/0` —
; `run_suite/2` calls it itself — and the file builds its few tuples and lists
; with the language's own `(tuple …)`/`(list …)`, the same runtime-tier trade
; `priv/host/sandbox.bl` and `priv/host/reload_watcher.bl` make. The pinned test
; PINS the whole remote set, so an accidental new coupling is a test failure.
;
; Run: bin/bl test test/bl/host_test_rt_test.bl

(ns host.test_rt)

; ── symbol datum helpers (used at macro-expansion time) ──────────────────

(defn sym_name
  "The name of a symbol datum `{:symbol, name}`, or nil."
  [x]
  (if (and (erlang/is_tuple x)
           (erlang/== 2 (erlang/tuple_size x))
           (erlang/== :symbol (erlang/element 1 x)))
    (erlang/element 2 x)
    nil))

(defn eq_form?
  "True when `form` is a three-element `(= a b)` datum."
  [form]
  (if (and (erlang/is_list form) (erlang/== 3 (erlang/length form)))
    (let [h (erlang/hd form)]
      (and (erlang/is_tuple h)
           (erlang/== 2 (erlang/tuple_size h))
           (erlang/== :symbol (erlang/element 1 h))
           (erlang/== "=" (erlang/element 2 h))))
    false))

; ── the registry (ENV-scoped: a fork runs only its own registrations) ────

(defn register_test
  "Register a zero-arg test fn by ns+name; redefinition replaces."
  [ns name f]
  (let [key (tuple :test_registry ns)
        prev (BeamLisp.Env/lookup_own key)
        tests (if (erlang/== :error prev)
                (list)
                (Enum/reject (erlang/element 2 prev)
                             (fn [pair] (erlang/== name (erlang/element 1 pair)))))]
    (BeamLisp.Env/put_key key (erlang/++ tests (list (tuple name f))))
    :ok))

(defn registered_tests
  "Registered `[{name, fn}]` for `ns`, in definition order."
  [ns]
  (let [r (BeamLisp.Env/lookup_own (tuple :test_registry ns))]
    (if (erlang/== :error r) (list) (erlang/element 2 r))))

(defn subst
  "Substitute argv symbol datums with their row value datums throughout `expr`
   (for `are`). Walks tuples, lists, vectors and maps, and leaves everything
   else alone."
  [argv row expr]
  (let [vector? (fn [v]
                  (and (erlang/is_map v)
                       (erlang/is_map_key :__struct__ v)
                       (erlang/== :"Elixir.BeamLisp.Vector" (maps/get :__struct__ v))))
        unwrap (fn [v] (if (vector? v) (BeamLisp.Vector/to_list v) v))
        walk (fn walk [x m]
               (cond
                 (and (erlang/is_tuple x)
                      (erlang/== 2 (erlang/tuple_size x))
                      (erlang/== :symbol (erlang/element 1 x)))
                 (Map/get m x x)

                 (erlang/is_list x)
                 (Enum/map x (fn [e] (walk e m)))

                 (vector? x)
                 (BeamLisp.Vector/new (Enum/map (BeamLisp.Vector/to_list x)
                                                (fn [e] (walk e m))))

                 (erlang/is_map x)
                 (Map/new (Enum/map x (fn [kv] (tuple (walk (erlang/element 1 kv) m)
                                                      (walk (erlang/element 2 kv) m)))))

                 :else x))]
    (walk expr (Map/new (Enum/zip (unwrap argv) (unwrap row))))))

(defn clear_registry
  "Drop every registered test (used to isolate ExUnit runs of run_suite/1)."
  []
  (BeamLisp.Env/match_delete_own (tuple (tuple :test_registry :_) :_))
  :ok)

(defn test_namespaces
  "Namespaces that have registered tests, in first-registration order."
  []
  (Enum/map (BeamLisp.Env/match_own (tuple (tuple :test_registry :"$1") :_))
            (fn [row] (erlang/hd row))))

; ── run state (PROCESS-local: serial is one process, async forks one) ────

(defn reset_run
  "Clear `ns`'s counters and reports before a run."
  [ns]
  (Process/put (tuple :test_run ns)
               {:tests 0 :pass 0 :fail 0 :error 0 :reports (list)})
  :ok)

(defn begin_test
  "Mark `name` (of `ns`) as the test currently executing; increments the test count."
  [ns name]
  (let [key (tuple :test_run ns)
        cur (Process/get key)
        run (if (erlang/== nil cur)
              {:tests 0 :pass 0 :fail 0 :error 0 :reports (list)}
              cur)]
    (Process/put key (Map/put run :tests (erlang/+ (Map/get run :tests 0) 1)))
    (Process/put :test_ctx {:ns ns :test name :context (list)})
    :ok))

(defn end_test
  "End the current test and clear the context slot."
  [ns]
  (Process/put :test_ctx {:ns ns :test nil :context (list)})
  :ok)

(defn with_context
  "Run `f` with `str` pushed onto the current `testing` context."
  [str f]
  (let [cur (Process/get :test_ctx)
        ctx (if (erlang/== nil cur) {:ns nil :test nil :context (list)} cur)]
    (Process/put :test_ctx
                 (Map/put ctx :context (erlang/++ (Map/get ctx :context) (list str))))
    (try
      (BeamLisp.Ns.Rt/invoke f (list))
      (finally
        (let [c (Process/get :test_ctx)
              cs (Map/get c :context)]
          (Process/put :test_ctx
                       (Map/put c :context
                                (if (empty? cs)
                                  cs
                                  (Enum/take cs (erlang/- (count cs) 1))))))))))

(defn record
  "Record one assertion result: bump the counter, store a report, and print
   failure/error detail immediately. Returns the `type`."
  [ns type form msg expected actual]
  (let [cur (Process/get :test_ctx)
        ctx (if (erlang/== nil cur) {:ns nil :test nil :context (list)} cur)
        report {:type type
                :ns ns
                :test (Map/get ctx :test)
                :context (Enum/join (Map/get ctx :context) "\n")
                :form form
                :msg msg
                :expected expected
                :actual actual}
        fmt (fn [x] (BeamLisp.Ns.Rt/print_str x))
        suffix (fn [r]
                 (let [raw (list (or (Map/get r :msg nil) "") (Map/get r :context nil))
                       lines (Enum/reject raw (fn [x] (or (erlang/== "" x)
                                                          (erlang/== nil x))))]
                   (if (empty? lines)
                     ""
                     (erlang/iolist_to_binary
                       (list "\n"
                             (Enum/join
                               (Enum/map lines
                                         (fn [l] (erlang/iolist_to_binary (list "  " l))))
                               "\n"))))))
        print-report
        (fn [r]
          (let [t (Map/get r :type)
                head (if (erlang/== t :fail) "FAIL" "ERROR")
                actual-str (if (erlang/== t :fail)
                             (fmt (Map/get r :actual))
                             (BeamLisp.ExInfo/ex_message (Map/get r :actual)))]
            (IO/puts "")
            (IO/puts (erlang/iolist_to_binary (list head " in (" (Map/get r :ns) ")")))
            (IO/puts (erlang/iolist_to_binary (list "  " (Map/get r :test) (suffix r))))
            (IO/puts "")
            (IO/puts (erlang/iolist_to_binary (list "expected: " (fmt (Map/get r :expected)))))
            (IO/puts (erlang/iolist_to_binary (list "  actual: " actual-str)))))
        rkey (tuple :test_run ns)
        prev (Process/get rkey)
        run0 (if (erlang/== nil prev)
               {:tests 0 :pass 0 :fail 0 :error 0 :reports (list)}
               prev)
        run1 (Map/put run0 type (erlang/+ (Map/get run0 type 0) 1))]
    (Process/put rkey (Map/put run1 :reports (erlang/++ (Map/get run1 :reports)
                                                        (list report))))
    (if (or (erlang/== type :fail) (erlang/== type :error)) (print-report report) nil)
    type))

(defn run_ns
  "Run all registered tests in `ns`, printing the ns header. Returns the results map."
  [ns]
  (reset_run ns)
  (IO/puts (erlang/iolist_to_binary (list "\nTesting " ns)))
  ; Each test thunk belongs to `ns`: run the batch with current_ns bound to it,
  ; so anything that consults the executing namespace (the query engine's
  ; predicate resolution) sees the test's own ns, not whatever file loaded last.
  (BeamLisp.Env/with_ns (Elixir.String.Chars/to_string ns)
    (fn []
      (Enum/each (registered_tests ns)
        (fn [pair]
          (let [name (erlang/element 1 pair)
                f (erlang/element 2 pair)]
            (begin_test ns name)
            (let [t0 (System/monotonic_time :millisecond)]
              (try
                (BeamLisp.Ns.Rt/invoke f (list))
                (catch e
                  ; The live module's `rescue`/`catch` pair, folded back: the
                  ; normalized exception for a raise, `{:throw, v}` for a throw,
                  ; and the already-folded `{:exit, v}` for an exit.
                  (let [kind __EXCEPTION_KIND__
                        actual (cond
                                 (erlang/== kind :error) e
                                 (erlang/== kind :throw) (tuple :throw e)
                                 :else e)]
                    (record ns :error name nil name actual)))
                (finally
                  (end_test ns)
                  ; `BL_TEST_TIMES=1` prints one line per test with its wall time.
                  ; Off by default: the summary line is the contract.
                  (if (or (erlang/== "1" (System/get_env "BL_TEST_TIMES"))
                          (erlang/== "true" (System/get_env "BL_TEST_TIMES")))
                    (IO/puts (erlang/iolist_to_binary
                               (list "  " name "  "
                                     (erlang/integer_to_binary
                                       (erlang/- (System/monotonic_time :millisecond) t0))
                                     "ms")))
                    nil)))))))))
  (Map/put (Process/get (tuple :test_run ns)) :ns ns))

; ── totals ───────────────────────────────────────────────────────────────

(defn merge_totals
  "Sum two suite totals maps — the shape multi-pass runners need."
  [a b]
  (Map/merge a b (fn [k x y]
                   (if (or (erlang/== k :tests) (erlang/== k :pass)
                           (erlang/== k :fail) (erlang/== k :error))
                     (erlang/+ x y)
                     x))))

(defn aggregate
  "Sum a list of per-ns results into one totals map."
  [results]
  (Enum/reduce results {:tests 0 :pass 0 :fail 0 :error 0}
    (fn [r acc]
      {:tests (erlang/+ (Map/get acc :tests) (Map/get r :tests))
       :pass (erlang/+ (Map/get acc :pass) (Map/get r :pass))
       :fail (erlang/+ (Map/get acc :fail) (Map/get r :fail))
       :error (erlang/+ (Map/get acc :error) (Map/get r :error))})))

(defn print_summary
  "Print the clojure.test-shaped summary line."
  [totals]
  (let [assertions (erlang/+ (erlang/+ (Map/get totals :pass) (Map/get totals :fail))
                             (Map/get totals :error))]
    (IO/puts (erlang/iolist_to_binary
               (list "\nRan " (erlang/integer_to_binary (Map/get totals :tests))
                     " tests containing " (erlang/integer_to_binary assertions)
                     " assertions.")))
    (IO/puts (erlang/iolist_to_binary
               (list (erlang/integer_to_binary (Map/get totals :fail))
                     " failures, "
                     (erlang/integer_to_binary (Map/get totals :error))
                     " errors.")))))

(defn passed?
  "True when a totals map has no failures or errors."
  [totals]
  (and (erlang/== 0 (Map/get totals :fail))
       (erlang/== 0 (Map/get totals :error))))

; Suite loading declares tests; only the owning runner executes them.
; This process-local scope never crosses an Env token into unrelated work.
(defn declaring? [] (erlang/== true (Process/get :bl-test-declarations)))

(defn declarations
  "Evaluate a suite source without executing its inline run-tests trailer."
  [f]
  (let [previous (Process/get :bl-test-declarations)]
    (Process/put :bl-test-declarations true)
    (try
      (BeamLisp.Ns.Rt/invoke f (list))
      (finally
        (if (erlang/== nil previous)
          (Process/delete :bl-test-declarations)
          (Process/put :bl-test-declarations previous))))))

; ── the suite runner ─────────────────────────────────────────────────────

(defn run_suite
  "Load and run a beam-lisp test suite: prelude, the `priv/std/test.bl` library,
   then each `path`, then every registered namespace via `run-tests`. Returns the
   grand totals map.

   With `async: true` the test library loads once into a warm base env and each
   FILE runs in its own fork of it, concurrently (capped at
   `System.schedulers_online/0`): per-env registries mean a fork's `run-tests`
   runs only that file's tests, and per-file output is buffered through a
   StringIO group leader so concurrent runs never interleave a FAIL report with
   another file's header. Namespaces within one file stay sequential — the
   `testing` context stack is a per-ns single slot by design."
  ([paths] (run_suite paths (list)))
  ([paths opts]
   (let [own (erlang/element 2 (erlang/fun_info (fn [] nil) :module))
         ; One suite file's SOURCE, evaluated into the env that is current,
         ; under the file's own directory on the load path. `read_source` is the
         ; loader's OWN read — the one `bl run`, `bl build` and a `require` use —
         ; so a literate `.bl.md`/`.bl.org` file contributes its code cells and a
         ; shebang is stripped.
         eval-file (fn [path]
                     (BeamLisp.Loader/with_load_path (Path/dirname path)
                       (fn [] (declarations
                                (fn [] (BeamLisp.Compiler/eval_string
                                         (BeamLisp.Loader/read_source path)))))))
         ; One file in its own fork of the base: eval its source, run ITS tests
         ; (the registry is exact-env, so the base's registrations never re-run),
         ; and capture all printed output for ordered replay by the caller.
         run-file-isolated
         (fn [base path]
           (BeamLisp.Env/isolated base
             (fn []
               (let [io (erlang/element 2 (StringIO/open ""))
                     prev-gl (Process/group_leader)]
                 (erlang/group_leader io (erlang/self))
                 (try
                   (do (BeamLisp.Env/in_ns "user")
                       (eval-file path)
                       (let [totals (BeamLisp.Ns.Rt/invoke
                                      (BeamLisp.Env/fetch! "core" "run-tests") (list :all))]
                         (tuple totals (erlang/element 2 (StringIO/contents io)))))
                   (finally
                     (erlang/group_leader prev-gl (erlang/self))
                     (StringIO/close io)))))))
         ; The shared run: every named file in ONE image, forked from the
         ; caller's — so `run-tests :all` means "all the tests these files
         ; registered", never the caller's already-warm registry.
         run-serial
         (fn []
           (BeamLisp/init)
           (let [base (BeamLisp.Env/fork :global)]
             (try (BeamLisp.Env/with_env base
               (fn []
                 (BeamLisp.Compiler/eval_string (test_lib_source)
                                                (BeamLisp.Compiler/new_env "core"))
                 (Enum/each paths
                   (fn [path]
                     (BeamLisp.Env/in_ns "user")
                     (eval-file path)))
                 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! "core" "run-tests")
                                        (list :all))))
              (finally (BeamLisp.Env/destroy base)))))
         run-async
         (fn []
           (BeamLisp/init)
           (let [base (BeamLisp.Env/fork :global)]
             (try
              (BeamLisp.Env/with_env base
               (fn []
                 (BeamLisp.Compiler/eval_string (test_lib_source)
                                                (BeamLisp.Compiler/new_env "core"))))
             ; Streams in the ORIGINAL path order so output reads like the
             ; serial run's; concurrency happens inside, ordered output outside.
             (let [results (Enum/map
                             (Task/async_stream
                               paths
                               (fn [path]
                                 ;; Return loading failures to the owning frame.
                                 ;; A linked task exit would skip its cleanup.
                                 (try (tuple path (run-file-isolated base path))
                                      (catch error (tuple :suite-worker-error error))))
                               (list (tuple :max_concurrency (System/schedulers_online))
                                     (tuple :ordered true)
                                     (tuple :timeout :infinity)))
                             ; Loading failures retain the existing FunctionClauseError
                             ; refusal, raised by the owning frame so its finally
                             ; cleanup runs before returning to a warm caller.
                             (fn [t]
                               (if (and (erlang/== :ok (erlang/element 1 t))
                                        (erlang/is_tuple (erlang/element 2 t))
                                        (erlang/is_binary (erlang/element 1 (erlang/element 2 t))))
                                 (erlang/element 2 t)
                                 (erlang/error
                                   (FunctionClauseError/exception
                                     (list (erlang/list_to_tuple (list :module own))
                                           (erlang/list_to_tuple (list :function :run_suite))
                                           (erlang/list_to_tuple (list :arity 2))))))))]
               (Enum/each results
                 (fn [pair]
                   (IO/write (erlang/element 2 (erlang/element 2 pair)))))
               (let [totals (aggregate
                              (Enum/map results
                                        (fn [pair]
                                          (erlang/element 1 (erlang/element 2 pair)))))]
                 (print_summary totals)
                 totals))
              (finally (BeamLisp.Env/destroy base)))))]
     (if (Keyword/get opts :async false) (run-async) (run-serial)))))

(defn cli
  "The mix task entry: run the suite and exit non-zero on any failure/error."
  ([paths] (cli paths (list)))
  ([paths opts]
   (let [totals (run_suite paths opts)]
     (if (passed? totals) nil (System/halt 1)))))

; ── the embedded test library ────────────────────────────────────────────
;
; The test library ships INSIDE the compiled module, not as a runtime priv file
; — the same rule as the prelude in beam_lisp.ex: escripts (and flat .beam
; deployments) have no `:code.priv_dir/1`, so a runtime `File.read!` would crash
; `bl test`. The literal is generated from `priv/std/test.bl` between the two
; markers below; `test/bl/host_test_rt_test.bl` asserts it equals the file, which
; is the drift gate the live module's `@external_resource` used to provide.

(defn test_lib_source
  "The embedded test-library source — for in-language loaders (reload/ward.bl)
   that must work where `:code.priv_dir/1` does not (escripts)."
  []
  ;; @@EMBED-TEST-LIB@@
"; priv/test.bl — clojure.test, ported. beam-lisp carries its own test\n; suite: deftest/is/testing/are register tests whose storage lives in\n; BeamLisp.TestRT (ETS), so they survive across files and runs.\n;\n; Loaded into the `core` namespace (before any test file) so its macros\n; resolve from every namespace via the usual core fallback — the same\n; trick that puts cond/case/when in core.bl. `run-tests` drives the\n; run and prints the clojure.test-shaped summary.\n\n; --- assertion runtime ---\n; A failing `is` must not halt the run: it records and returns. The\n; form is passed both as its datum (for failure detail) and as a thunk\n; (for evaluation), so exceptions inside it are caught here, not raised.\n\n(defn test-record [ns type form msg expected actual]\n  (BeamLisp.TestRT/record ns type form msg expected actual))\n\n(defn is-report [ns form msg f]\n  (try\n    (let [v (f)]\n      (if v\n        (do (test-record ns :pass form msg nil v) true)\n        (do (test-record ns :fail form msg form v) false)))\n    (catch e\n      (test-record ns :error form msg form e)\n      false)))\n\n; The `=` case reports expected/actual separately, as clojure.test does — as\n; VALUES. `expected` is what the LEFT operand EVALUATED to, the one place that\n; value exists: a report carrying the FORMS instead makes every renderer print a\n; symbol where a value belongs (`expected: serial` for a var holding rows). The\n; whole form is carried in `form`, so the operand that produced the value is\n; still there to be seen.\n(defn is-eq-report [ns form msg fa fb]\n  (try\n    (let [av (fa) bv (fb)]\n      (if (= av bv)\n        (do (test-record ns :pass form msg nil bv) true)\n        (do (test-record ns :fail form msg av bv) false)))\n    (catch e\n      (test-record ns :error form msg form e)\n      false)))\n\n; --- the macros ---\n; Each captures the current namespace at expansion time (the test file's\n; `(ns …)` is already in effect), so records land in the right namespace\n; even after later files have switched it.\n\n(defmacro deftest [name & body]\n  `(do\n     (BeamLisp.TestRT/register_test ~(BeamLisp.Env/current_ns)\n                                    ~(BeamLisp.TestRT/sym_name name)\n                                    (fn [] (do ~@body)))\n     nil))\n\n(defmacro is\n  ([form] `(is ~form nil))\n  ([form msg]\n    (if (BeamLisp.TestRT/eq_form? form)\n      (let [[_ a b] form]\n        `(is-eq-report ~(BeamLisp.Env/current_ns)\n                       (quote ~form) ~msg\n                       (fn [] (do ~a)) (fn [] (do ~b))))\n      `(is-report ~(BeamLisp.Env/current_ns) (quote ~form) ~msg (fn [] (do ~form))))))\n\n(defmacro thrown?\n  \"True when evaluating `body` raises — ANY raise, of any kind.\n\n   clojure.test spells this `(is (thrown? ExceptionType expr))`. beam-lisp\n   DOES discriminate on exception types: `(catch Module.Name e …)` matches\n   one Elixir exception struct, so a type-narrowing assertion is writable\n   as `(is (try expr false (catch ArgumentError e true) (catch e false)))`.\n\n   This macro stays untyped on purpose. Most of its uses assert that a\n   function REFUSES, where the contract is 'this must not succeed' rather\n   than 'this must fail with precisely that struct' — and pinning the type\n   there couples every test to which internal error a validation happens to\n   raise today. Reach for the typed `catch` when the type IS the contract.\n\n   Needed because the alternative — asserting on a function's return value —\n   cannot express the contract of a fn whose job is to REFUSE. `parse` failing\n   loud on an unknown clause is a feature (a silently-dropped clause is a seam\n   hole no later check can see), and a feature with no way to assert it is a\n   feature that rots.\"\n  [& body]\n  `(try\n     (do ~@body false)\n     (catch e# true)))\n\n(defmacro thrown-with-msg?\n  \"Like `thrown?`, but also requires the error message to contain `needle`.\n   Use when several failure modes share a call site and the test would\n   otherwise pass on the WRONG error.\"\n  [needle & body]\n  `(try\n     (do ~@body false)\n     (catch e# (includes? (str (ex-message e#)) ~needle))))\n\n(defmacro testing [str & body]\n  `(BeamLisp.TestRT/with_context ~str (fn [] ~@body)))\n\n; are: table-driven is. Each full row binds argv onto the template and\n; becomes one (is template). A trailing partial row is ignored.\n(defmacro are [argv expr & rows]\n  (if (empty? rows)\n    `(do)\n    (let [n (count argv)]\n      (if (= n 0)\n        (let [forms (map (fn [_] (list (quote is) expr)) rows)]\n          (cons (quote do) forms))\n        (loop [i 0 acc ()]\n          (if (< (- (count rows) i) n)\n            (cons (quote do) (lists/reverse acc))\n            (recur (+ i n)\n                   (cons (list (quote is)\n                               (BeamLisp.TestRT/subst argv (take n (drop i rows)) expr))\n                         acc))))))))\n\n; --- running ---\n; run-tests is a runtime fn (nothing to expand); it runs each namespace's\n; tests through BeamLisp.TestRT and returns the grand totals map.\n\n(defn run-tests\n  \"Run registered tests for the current ns, one ns, or :all. Prints\n  per-failure detail and a summary; returns a totals map.\"\n  ([] (run-tests (BeamLisp.Env/current_ns)))\n  ([ns-or-all]\n   (if (BeamLisp.TestRT/declaring?)\n     {:tests 0 :pass 0 :fail 0 :error 0}\n     (let [nss (if (= ns-or-all :all)\n               (BeamLisp.TestRT/test_namespaces)\n               [ns-or-all])\n         results (map (fn [ns] (BeamLisp.TestRT/run_ns ns)) nss)\n         totals (BeamLisp.TestRT/aggregate results)]\n     (BeamLisp.TestRT/print_summary totals)\n     totals))))\n"
  ;; @@/EMBED-TEST-LIB@@
)
