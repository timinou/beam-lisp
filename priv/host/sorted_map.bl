; host/sorted_map.bl — the pinned HOST MODULE for
; `Elixir.BeamLisp.Sorted.SortedMap`.
;
; `lib/beam_lisp/sorted.ex` declares this type beside `BeamLisp.Sorted` as a
; bare `defmodule SortedMap do defstruct [:tree] end`: a tag, ONE declared
; field, and the constructor/introspection surface `defstruct` generates —
; nothing else. `BeamLisp.Sorted` is the module that OPERATES on it
; (`priv/host/sorted.bl`); this file pins the TYPE. Its twin is
; `priv/host/sorted_set.bl`, which pins `SortedSet` — the SAME shape, a
; different atom.
;
; WHY THIS FILE WRITES `__struct__` AND `__info__` BY HAND. Every other pinned
; struct port (`set.bl`, `vector.bl`, `delay.bl`, the exception types) carries
; real functions beside its data, so `:struct_fields` can synthesize the
; constructor pair INTO a module that already has an export surface. A bare
; `defstruct` has NO functions at all — and `compile_host_file` REFUSES a source
; with no top-level `defn` (measured: "pinned host module source defines no
; functions in any namespace"), while `:struct_fields` may not be combined with
; a hand-written `__struct__`/`__info__` (it refuses the collision). The two
; rules leave exactly one honest shape: spell the generated surface out, so the
; emitted beam carries the live module's exports DATUM FOR DATUM —
; `__struct__/0,1` and `__info__/1`, and nothing else. A helper function here
; would be a fourth export, so there are none: `self-mod` is inlined.
;
; What `defstruct [:tree]` generates, and what each clause below reproduces:
;
;     __struct__/0 →  %{__struct__: __MODULE__, tree: nil}
;     __struct__/1 →  Enum.reduce(kv, __struct__/0, fn {k, v}, m ->
;                       :maps.update(k, v, m)          ; unknown key → KeyError
;                     _ -> :erlang.error(:function_clause) end)
;     __info__/1   →  :module / :functions / :macros / :deprecated / :struct,
;                     the last in DECLARATION ORDER, `required: false`
;
; The tag is read from a fun literal compiled into THIS file
; (`erlang:fun_info(F, :module)`) — the `set.bl`/`delay.bl` idiom — so the same
; bytes compiled at the production atom build a production-tagged value and the
; same bytes compiled at a probe atom build a probe-tagged one, and the test can
; diff the probe against the live beam without either hard-coding the other.
;
; Run: bin/bl test test/bl/host_sorted_test.bl

(ns host.sorted-map)

(defn __struct__
  "The `defstruct [:tree]` constructor pair. `__struct__/0` is the tag plus the
   one default; `__struct__/1` folds an enumerable of `{k, v}` over it with
   `:maps.update/3`, which refuses an undeclared key with `:error {:badkey, k}`
   — the SAME refusal the generated clause raised (`rescue` normalises it to
   `KeyError`) — and a non-pair element with `FunctionClauseError`, as the
   generated reducer did."
  ([]
   (maps/put :tree nil
     (maps/put :__struct__
       (erlang/element 2 (erlang/fun_info (fn [] nil) :module))
       (maps/new))))
  ([kv]
   (Enum/reduce kv
     (maps/put :tree nil
       (maps/put :__struct__
         (erlang/element 2 (erlang/fun_info (fn [] nil) :module))
         (maps/new)))
     (fn [pair m]
       (if (and (erlang/is_tuple pair) (erlang/== 2 (erlang/tuple_size pair)))
         (erlang/apply :maps :update
           (list (erlang/element 1 pair) (erlang/element 2 pair) m))
         (erlang/error :function_clause))))))

(defn __info__
  "The introspection `Inspect.Any` and `Kernel.struct!/2` read. `:struct` is the
   exact field metadata in DECLARATION ORDER; `:functions` is the constructor
   pair, which is the whole surface. An unknown key misses every clause —
   `FunctionClauseError`, exactly as the generated `__info__/1` refuses it."
  ([key] :when (= key :module)
   (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))
  ([key] :when (= key :functions)
   (list (tuple :__struct__ 0) (tuple :__struct__ 1)))
  ([key] :when (= key :macros) ())
  ([key] :when (= key :deprecated) ())
  ([key] :when (= key :struct)
   (list (maps/put :required false
           (maps/put :default nil
             (maps/put :field :tree (maps/new)))))))
