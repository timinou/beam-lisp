; host/seq_cursor.bl — the pinned HOST MODULE for `Elixir.BeamLisp.SeqCursor`.
;
; `BeamLisp.SeqCursor` is the walker over a FINITE eager input that has been
; copied ONCE into native storage: a `{chunk, tail, dirty}` value whose `tail`
; is a native cursor resource and whose `chunk` is the one small piece of the
; source that lives on the BEAM heap. This file is the `.bl` port of
; `lib/beam_lisp/seq_cursor.ex`'s struct half, compiled by
; `BeamLisp.AOT/compile_host_file` into ONE exact-named beam whose
; `__struct__/0,1` pair and `__info__/1` are SYNTHESIZED by the
; `:struct_fields` option — no `defstruct`, no Elixir source.
;
; THE STRUCT IS BUILT BY HAND, never by calling the synthesized `__struct__/1`.
; A pinned file cannot name it: an unqualified `__struct__` is not a unit defn,
; so the compiler lowers it to a var lookup. And the tag must be whatever module
; the file was compiled INTO — at `BeamLisp.SeqCursor` it builds
; `%BeamLisp.SeqCursor{}`, at a probe atom that atom's struct. `new` reads its
; own module from a fun literal compiled into this file
; (`erlang:fun_info(F, module)`), the same module-exact idiom `priv/host/set.bl`
; and `priv/host/delay.bl` use, so a probe compile answers that beam's own
; `__struct__/1` with no hard-coded atom. `cell` reads `:chunk`/`:tail`/`:dirty`
; out of the value it is handed, BY KEY, and re-enters itself for a tail pull
; through the same fun-literal module read — never a bare symbol — so the whole
; beam carries no reference to this namespace's vars, which a fresh VM never
; interns.
;
; READ THE BACKING FIELDS BY KEY, NEVER BY TAG. `maps/get` needs no struct head,
; so `cell` walks a cursor tagged for the production module and a cursor tagged
; for a probe atom identically — and, critically, never dispatches through the
; tag it is reading. Keyword invocation on a tagged collection would route the
; read back through this module's own lookup, which is the recursion the Set
; port had to avoid; the same rule holds here.
;
; `chunk` HOLDS A RAW ERLANG LIST, never a bl vector. The native `cursor_chunk`
; NIF hands back an Erlang list and the struct default is the Erlang empty list;
; a bl `[]` would be a `BeamLisp.Vector` and every `[head | rest]` step below
; would be wrong. Likewise `cell` answers a RAW CONS built by
; `BeamLisp.Ns.Rt/raw-cons` — the live module returned `[head | %{cursor | …}]`,
; a list whose TAIL is the sub-cursor struct, and bl `cons/2` refuses a struct
; tail (it accepts only nil, a list, a vector or a lazy seq). `raw-cons` is the
; BIF-level constructor and shares the tail, exactly as `[h | t]` did.
;
; There is NO helper function here. A pinned module's export surface is exactly
; the file's defns plus the synthesized constructor pair, so a private-looking
; helper would still be an export and would drift from the live module's.
;
; Run: bin/bl test test/bl/host_seq_cursor_test.bl

(ns host.seq-cursor)

(defn new
  "The cursor over the eager Erlang list `list`: the native resource in `:tail`
   and the source's lane decision, read ONCE at creation, copied into `:dirty`.
   `:chunk` starts empty, so the FIRST `cell` is what pulls the first chunk —
   creating a cursor copies nothing onto the BEAM heap."
  [list]
  (let [mod (erlang/element 2 (erlang/fun_info (fn [] nil) :module))
        resource (BeamLisp.LazyMemo/cursor list)]
    (maps/put :dirty (BeamLisp.LazyMemo/cursor_dirty_chunks? resource)
      (maps/put :tail resource
        (maps/put :chunk ()
          (maps/put :__struct__ mod (maps/new)))))))

(defn cell
  "Normalize the cursor to its next realized cell: `nil` at the end, else
   `[head | cursor']` — a RAW cons whose tail is the sub-cursor, never a bl
   list. A non-empty `:chunk` answers WITHOUT touching the native resource, so a
   walk copies one chunk, not one cell; only when the chunk empties is the next
   chunk pulled from `:tail` (on the lane `:dirty` names), and the pull is
   RE-ENTERED through a module-exact self call — `erlang/apply` on the atom
   read from a fun literal in THIS file — never the bare symbol `cell`: a
   pinned module's own namespace vars are absent from a fresh VM, so only the
   module read answers the probe atom under test and the production atom in
   the seed. A chunk that came back empty with a resource still ahead cannot
   short-circuit the walk. Anything whose `:chunk` is not a list is the
   `FunctionClauseError` the live struct head raised."
  [cursor]
  (let [chunk (maps/get :chunk cursor nil)
        tail (maps/get :tail cursor nil)]
    (cond
      (and (erlang/is_list chunk) (erlang/=/= chunk ()))
      (BeamLisp.Ns.Rt/raw-cons (erlang/hd chunk)
        (maps/put :chunk (erlang/tl chunk) cursor))

      (and (erlang/is_list chunk) (nil? tail)) nil

      (erlang/is_list chunk)
      (let [pair (BeamLisp.LazyMemo/cursor_chunk tail (maps/get :dirty cursor nil))]
        (erlang/apply
          (erlang/element 2 (erlang/fun_info (fn [] nil) :module))
          :cell
          (list (maps/put :tail (erlang/element 2 pair)
                  (maps/put :chunk (erlang/element 1 pair) cursor)))))

      :else
      (erlang/error
        (Elixir.FunctionClauseError/exception
          (list (tuple :module (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))
                (tuple :function :cell)
                (tuple :arity 1)))))))
