; host/ex_unit_case.bl — the pinned HOST MODULE for `Elixir.BeamLisp.ExUnitCase`.
;
; `lib/beam_lisp/ex_unit_case.ex` is the one-line `use` for async beam-lisp
; tests (PLAN-046 L3): `use BeamLisp.ExUnitCase, warm: {name, sources}` turns
; the calling module into an `ExUnit.Case`, resolves a base image once per VM in
; `setup_all`, and forks it per test in `setup`, checking it back in `on_exit`.
; This file is the `.bl` port of that module, compiled by
; `BeamLisp.AOT/compile_host_file` into ONE exact-named beam whose export
; surface is the live module's.
;
;   (This wave owns source and tests only; the seed entry that points the real
;   atom at this file is written by the wave that deletes `ex_unit_case.ex`.
;   That entry carries `:macro_exports [{:__using__ 1}]` — without the
;   `__info__(:macros)` entry a caller's `use` refuses to expand at all — and
;   nothing else: the module has no struct and no behaviour.)
;
; THE MACRO IS THE POINT, AND IT IS PORTED AS DATA.
;
; `use BeamLisp.ExUnitCase, opts` is `BeamLisp.ExUnitCase.__using__(opts)`: the
; implementer `MACRO-__using__/2` — Elixir applies it to `(caller-env, opts)` and
; compiles ITS RETURN VALUE — plus the `__info__(:macros)` entry `{__using__, 1}`.
; A pinned file has no `quote`, so the expansion is BUILT node by node out of
; `:erlang` primitives: `node/3` is one `{form, meta, args}` triple, `aliases/1`
; is `{:__aliases__, [alias: false], …}`, `rcall/3` is `{{:., [], [mod, fun]},
; [], args}`. Every piece the live `quote` emits is reproduced:
;
;   * `use ExUnit.Case, async: <bool>` — meta `[context: <this module>, imports:
;     [{1, Kernel}, {2, Kernel}]]`, the hygiene `quote` stamps on a `use` inside
;     a macro body; the `async?` value is spliced, exactly as `unquote` splices
;     it.
;   * `setup_all` — resolves the base ONCE per module: `BeamLisp.init()` then
;     `{:ok, bl_base: BeamLisp.ExUnitCase.resolve_base(<warm>)}`. The `warm` term
;     is spliced as the caller's own AST, exactly as `unquote(warm)` splices it.
;   * `setup %{bl_base: bl_base}` — forks `BeamLisp.Sandbox.checkout(bl_base)`,
;     registers `on_exit(fn -> BeamLisp.Sandbox.checkin(env) end)`, and answers
;     `{:ok, bl_env: env}`.
;
; HYGIENE. `bl_base` and `env` carry the module atom as their context — the same
; `{name, meta, context}` variable node Elixir's `quote` emits — so the `bl_base`
; bound in `setup_all`'s context key and the `bl_base` matched in `setup`'s
; pattern are THE SAME variable. That is why the expansion is byte-comparable to
; the live one rather than merely equivalent: the differential test asserts
; term equality, not a normalised shadow of it.
;
; THE EXPORT SURFACE IS THE LIVE ONE PLUS THIS FILE'S HELPERS. A pinned module
; exports exactly its file's top-level `defn`s, so the AST builders below are
; exports here — the same ONE deliberate divergence `priv/host/guards.bl`
; carries. The PUBLIC ABI (`resolve_base/1` plus `MACRO-__using__/2`, advertised
; through `__info__(:macros)`) is exact.
;
; BOOT SAFETY. Every body is written against `:erlang`, `Keyword` and the live
; `BeamLisp.Sandbox` — no beam-lisp namespace var, no `BeamLisp.Ns.*` target — and
; the AST is built with `make_tuple`/`setelement`/`tuple_to_list`, NOT with
; `(tuple …)`/`(list …)`, so the beam resolves against the live modules alone. The
; macro implementer runs only when an Elixir compiler expands a `use`, never on a
; boot path.
;
; Run: bin/bl test test/bl/host_sandbox_test.bl

(ns host.ex_unit_case)

; ── AST construction out of `:erlang` primitives only ─────────────────────

(defn- tup2 [a b]
  (erlang/setelement 2 (erlang/setelement 1 (erlang/make_tuple 2 :undefined) a) b))

(defn- tup3 [a b c]
  (erlang/setelement 3
    (erlang/setelement 2
      (erlang/setelement 1 (erlang/make_tuple 3 :undefined) a) b) c))

(defn- lst0 [] (erlang/tuple_to_list (erlang/make_tuple 0 :undefined)))
(defn- lst1 [a] (erlang/tuple_to_list (erlang/setelement 1 (erlang/make_tuple 1 :undefined) a)))
(defn- lst2 [a b] (erlang/tuple_to_list (tup2 a b)))
(defn- lst3 [a b c] (erlang/tuple_to_list (tup3 a b c)))

(defn- node
  "One Elixir AST node: `{form, meta, args}`."
  [form meta args]
  (erlang/list_to_tuple (lst3 form meta args)))

(defn- aliases
  "The AST for the alias `A.B.C`: `{:__aliases__, [alias: false], [:A, :B, :C]}`."
  [path]
  (node :__aliases__ (lst1 (tup2 :alias false)) path))

(defn- rcall
  "The AST for the remote call `A.B.fun(args)`:
   `{{:., [], [alias-ast, fun]}, [], args}`."
  [mod fun args]
  (node (node :"." (lst0) (lst2 (aliases mod) fun)) (lst0) args))

; ── the public ABI ───────────────────────────────────────────────────────

(defn resolve_base
  "Answer the env a `use`d module's tests fork from. `nil` is `:global`, an atom
   is a warmed base NAME (raising if absent), and a 2-tuple is a `{name, sources}`
   pair to warm. Exactly the live clauses, in the live order; the atom test is a
   BODY check because beam-lisp's guard vocabulary has no atom predicate (see
   `priv/host/sandbox.bl`), and its failure raises the same `%FunctionClauseError{}`
   the live clause head would have."
  [x]
  (let [own (erlang/element 2 (erlang/fun_info (fn [] nil) :module))]
    (cond
      (erlang/== x nil) :global
      (erlang/is_atom x) (BeamLisp.Sandbox/base! x)
      (and (erlang/is_tuple x) (erlang/== 2 (erlang/tuple_size x)))
      (BeamLisp.Sandbox/warm! (erlang/element 1 x) (erlang/element 2 x))
      :else
      (erlang/error
        (FunctionClauseError/exception
          (lst3 (tup2 :module own)
                (tup2 :function :resolve_base)
                (tup2 :arity 1)))))))

(defn MACRO-__using__
  "The `use BeamLisp.ExUnitCase, opts` expansion: `use ExUnit.Case, async: …`,
   one `setup_all` resolving the base, one `setup` forking and checking it in.
   The AST is DATA — every node the live `quote` emits, hygiene contexts and
   the `use` node's `context`/`imports` meta included."
  [_env opts]
  (let [own (erlang/element 2 (erlang/fun_info (fn [] nil) :module))
        warm (Keyword/get opts :warm)
        async? (Keyword/get opts :async true)
        use-node (node :use
                       (lst2 (tup2 :context own)
                             (tup2 :imports (lst2 (tup2 1 :"Elixir.Kernel")
                                                  (tup2 2 :"Elixir.Kernel"))))
                       (lst2 (aliases (lst2 :ExUnit :Case))
                             (lst1 (tup2 :async async?))))
        bl-base (node :bl_base (lst0) own)
        bl-env (node :env (lst0) own)
        setup-all-body
        (node :__block__ (lst0)
              (lst2 (rcall (lst1 :BeamLisp) :init (lst0))
                    (tup2 :ok
                          (lst1 (tup2 :bl_base
                                      (rcall (lst2 :BeamLisp :ExUnitCase)
                                             :resolve_base (lst1 warm)))))))
        setup-all (node :setup_all (lst0) (lst1 (lst1 (tup2 :do setup-all-body))))
        assign (node := (lst0)
                        (lst2 bl-env
                              (rcall (lst2 :BeamLisp :Sandbox) :checkout
                                     (lst1 bl-base))))
        on-exit (node :on_exit (lst0)
                      (lst1 (node :fn (lst0)
                                  (lst1 (node :"->"
                                              (lst0)
                                              (lst2 (lst0)
                                                    (rcall (lst2 :BeamLisp :Sandbox)
                                                           :checkin (lst1 bl-env))))))))
        setup-body (node :__block__ (lst0)
                         (lst3 assign on-exit
                               (tup2 :ok (lst1 (tup2 :bl_env bl-env)))))
        setup (node :setup (lst0)
                    (lst2 (node :"%{}" (lst0) (lst1 (tup2 :bl_base bl-base)))
                          (lst1 (tup2 :do setup-body))))]
    (node :__block__ (lst0) (lst3 use-node setup-all setup))))
