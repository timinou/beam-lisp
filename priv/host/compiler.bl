; host/compiler.bl — the pinned HOST MODULE for `Elixir.BeamLisp.Compiler`.
;
; `BeamLisp.Compiler` is the host-facing FRONT DOOR to the self-hosted
; beam-lisp compiler: every caller in `lib/`, the tests and the tooling types
; `BeamLisp.Compiler.eval_string/…`, and `BeamLisp.init/0` drives the whole boot
; through it (`Compiler.enable_bl_backend/0`, then `Compiler.eval_string/3`).
; Its implementation has lived in `.bl` (`priv/boot/compiler.bl`, interned as
; `BeamLisp.Ns.Compiler`) since the genesis Elixir compiler was deleted; this
; file is the `.bl` port of the FACADE in `lib/beam_lisp/compiler.ex`, compiled
; by `BeamLisp.AOT/compile_host_file` into ONE exact-named beam whose top-level
; `defn`s are plain exported functions — no `defmodule`, no Elixir source.
;
; WHY A PINNED MODULE. The facade must be loadable and callable BEFORE the
; language exists: `BeamLisp.Application.start/2` runs `BeamLisp/init`, whose
; step 2 is `BeamLisp.Compiler.enable_bl_backend/0` — the call that interns the
; compiler namespace. Nothing behind that call may itself need an interned var,
; so the facade cannot be an AOT-rebuilt `BeamLisp.Ns.*` namespace (that is the
; bootstrap circle). It is a pinned host beam instead: a fixed artifact named by
; the seed manifest, built by one generation, loaded by the next.
;
; ABI PARITY IS THE CONTRACT, fallback for fallback.
;
;   * every public export of the recalled module is reproduced at its exact
;     name and arity, so no caller is renamed. Two of them carry Elixir DEFAULT
;     arguments, and a `.bl` defn has no `\\` — so the defaults are written as
;     explicit extra clauses whose bodies make the SAME call the default would:
;     `new_env/0` passes `BeamLisp.Env/current_ns`, `eval_string/1` and `-2`
;     pass a fresh `new_env/0` and a `nil` file. `env \\ new_env()` in the live
;     module is evaluated in the CALLER's process at call time; the extra
;     clause here does exactly that.
;
;   * delegation is by `apply/3` over the literal atom `BeamLisp.Ns.Compiler`,
;     never a compile-time reference to it. The target module is generated at
;     runtime from `.bl` and does not exist at this file's compile time, so a
;     direct call would be an `undefined function` warning there anyway; more
;     importantly the live module chose `apply` deliberately, and reproducing
;     it keeps the callee resolved at RUN time, when the ns is interned.
;
;   * `compile/2` KEEPS ITS GUARD. The live function consults
;     `Env.loaded_ns?("compiler")` and raises a `RuntimeError` naming the four
;     ways boot can be out of order when the ns is absent. That branch is the
;     only statement the facade makes about the self-hosted toolchain being
;     present, and its class (`RuntimeError`) and message are part of the ABI a
;     caller's `rescue` reads — so they are reproduced VERBATIM, byte for byte.
;
;   * `read_data/1` / `read_all_data/1` keep their `is_binary/1` guards, so a
;     non-binary argument is still the `FunctionClauseError` the live clause
;     head raised, not a delegation into the ns with a value it never saw.
;
; NO IMPLICIT HELPER VAR CAPTURE. A pinned host module makes no `Env.fetch!`
; call — the test disassembles the emitted beam and proves it. Nothing here
; names a helper; every body is either a direct sibling call (re-pointed at the
; pinned atom by the emitter) or an `apply` on a literal atom, and the one
; constant it needs (`BeamLisp.Ns.Compiler`) is written inline rather than held
; in a module attribute. So the module runs in a VM that has interned NOTHING of
; its own namespace, which is exactly the state `enable_bl_backend/0` is called
; in.
;
; Run: bin/bl test test/bl/host_compiler_test.bl

(ns host.compiler)

(defn new_env
  "A fresh top-level compile-time environment for namespace `ns`."
  ([] (erlang/apply :Elixir.BeamLisp.Ns.Compiler :new_env (list (BeamLisp.Env/current_ns))))
  ([ns] (erlang/apply :Elixir.BeamLisp.Ns.Compiler :new_env (list ns))))

(defn- assert_native_evaluation! []
 (when (erlang/function_exported :Elixir.BeamLisp.Env :assert_native_framework_execution! 0)
  (BeamLisp.Env/assert_native_framework_execution!)))

(defn eval_string
  "Read, compile and evaluate every form in `source`. Returns the last value.

   `env` defaults to a fresh `new_env/0` and `file` to `nil`, exactly as the
   live module's default arguments."
  ([source] (eval_string source (new_env) nil))
  ([source env] (eval_string source env nil))
  ([source env file]
   (assert_native_evaluation!)
   (erlang/apply :Elixir.BeamLisp.Ns.Compiler :eval_string (list source env file))))

(defn eval_form
  "Compile one reader form to a value and evaluate it."
  [form env]
  (assert_native_evaluation!)
  (erlang/apply :Elixir.BeamLisp.Ns.Compiler :eval_form (list form env)))

(defn macroexpand_1
  "Expand `form` once as a macro call in namespace `ns`."
  [form ns]
  (erlang/apply :Elixir.BeamLisp.Ns.Compiler :macroexpand_1 (list form ns)))

(defn prelink_defn
  "Prelink a `defn`'s call surface for namespace `ns`."
  [form ns]
  (erlang/apply :Elixir.BeamLisp.Ns.Compiler :prelink_defn (list form ns)))

(defn prelink_type
  "Prelink a canonical named class without executing its initializer."
  [form ns]
  (erlang/apply :Elixir.BeamLisp.Ns.Compiler :prelink_type (list form ns)))

(defn reset_fresh!
  "Restart this process's fresh-name counter."
  []
  (erlang/apply :Elixir.BeamLisp.Ns.Compiler :reset_fresh! (list)))

(defn read_data
  "Read ONE top-level form of `source` as runtime data."
  ([source] :when (string? source)
   (erlang/apply :Elixir.BeamLisp.Ns.Compiler :read_data (list source))))

(defn read_all_data
  "Read EVERY top-level form of `source` as runtime data."
  ([source] :when (string? source)
   (erlang/apply :Elixir.BeamLisp.Ns.Compiler :read_all_data (list source))))

(defn compile
  "Compile one reader form to its canonical bl-ANF node.

   Delegates to `BeamLisp.Ns.Compiler` when the `compiler` namespace is
   interned — the normal state on any tree. When it is not, the compiler is
   simply not loaded, which can only mean boot ran out of order or the seed is
   missing/corrupt; the raise below is reproduced VERBATIM from the live module,
   message included, because a caller's `rescue` reads it."
  [form env]
  (if (BeamLisp.Env/loaded_ns? "compiler")
    (erlang/apply :Elixir.BeamLisp.Ns.Compiler :compile (list form env))
    ; The message is reproduced BYTE FOR BYTE, trailing newline included: an
    ; Elixir heredoc keeps the newline before its closing delimiter, and the
    ; live beam's literal carries it (the differential test reads both beams'
    ; literals and compares them). The 3-arity `erlang/error` is the shape
    ; Elixir's `raise` emits — reason, `:none`, and the `error_info` that names
    ; the exception module — so the raise is the same `:error`-class
    ; `%RuntimeError{}` a caller's `rescue` reads, with the same stacktrace
    ; metadata. `error/1` would carry the same class and value but a different
    ; error_info.
    (erlang/error
      (RuntimeError/exception
        "beam-lisp compiler not loaded: BeamLisp.Ns.Compiler is not interned, and\nthe Elixir genesis compiler has been removed. The self-hosted compiler\nboots from the committed seed (priv/bootstrap/seed/) via\nBeamLisp.Bootstrap.install!/1 + BeamLisp.Compiler.enable_bl_backend/0.\nThis usually means boot ran out of order (enable the backend before the\nfirst compile) or the seed is missing/corrupt.\n")
      :none
      (list (tuple :error_info (maps/put :module :Elixir.Exception (maps/new)))))))

(defn enable_bl_backend
  "Ensure the self-hosted compiler is ready to serve `compile/2`. Idempotent.
   Returns `:bl` when it is now active, `:not_loaded` when interning failed."
  []
  (if (BeamLisp.Env/loaded_ns? "compiler")
    nil
    (BeamLisp.Loader/ensure_loaded "compiler"))
  (if (BeamLisp.Env/loaded_ns? "compiler") :bl :not_loaded))
