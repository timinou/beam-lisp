; host/vector_enumerable.bl — the pinned PROTOCOL IMPL for `BeamLisp.Vector`.
;
; `defimpl Enumerable, for: BeamLisp.Vector` is its own module,
; `Enumerable.BeamLisp.Vector`, compiled beside the type it serves. This file is
; the `.bl` port of that impl, compiled by `BeamLisp.AOT/compile_host_file`
; into `Elixir.Enumerable.BeamLisp.Vector.beam`.
;
; THE MODULE ATOM IS OUTSIDE `Elixir.BeamLisp.*`, and that is the whole reason
; the seed's host inventory is an explicit list of `{:module, :source}` entries
; rather than a name-prefix rule: a prefix cannot name this beam, so the table
; carries the list as data.
;
; ABI PARITY IS THE CONTRACT. `count`/`member?` answer the tagged `{:ok, …}` a
; protocol impl returns; `reduce` delegates to `Enumerable.List.reduce` over
; `BeamLisp.Vector.to_list/1` — the same call the Elixir impl made, so `Enum.*`
; and `Stream.*` behave identically, suspension and all; `slice` reports
; `{:error, <impl module>}` so the caller falls back to `reduce` (a vector has
; no constant-time slice); and `__impl__/1` answers `:for` (the type) and
; `:protocol` (the protocol). An unknown `__impl__` key raises
; `FunctionClauseError`, exactly as the generated two-clause function did.
;
; DEPENDENCY SHAPE — THIS ONE IS NOT ON THE BOOT PATH. The TYPE
; (`priv/host/vector.bl`) must be namespace-free: the compiler and `rt.bl` reach
; it while `core` is being interned. A protocol impl is not — it is reached only
; through `Enum.*`/`Enumerable.*` — so this file uses the ordinary beam-lisp
; surface (`(tuple …)`, `(list …)`, `=`), exactly as `priv/host/set_enumerable.bl`
; and `priv/host/seq_cursor_enumerable.bl` do. Its only beam-lisp namespace deps
; are `BeamLisp.Ns.Core` and `BeamLisp.Ns.Rt`; its own namespace's vars are never
; fetched, so the beam is still loadable in a fresh VM.
;
; FUNCTIONS-ONLY: no `:struct_fields`, so this beam gains no `__struct__` or
; `__info__` export — the same divergence `priv/host/set_enumerable.bl` and
; `priv/host/seq_cursor_enumerable.bl` carry, and for the same reason: the
; generated `__info__/1` a live `defimpl` module answers is `module_info`
; pass-through metadata (`:attributes`/`:compile`/`:md5`), which the pinned
; emitter deliberately does not synthesize. `slice` and `__impl__`'s error name
; their own module from a fun literal compiled into THIS file, so at a probe
; atom they answer that atom — module-exact, never a hard-coded
; `Enumerable.BeamLisp.Vector`.
;
; `BeamLisp.Vector/count` and `BeamLisp.Vector/to_list` are called at their
; PRODUCTION atom on purpose: the impl serves exactly one type, so a value
; reaching `count`/`member?`/`reduce` carries that type's tag and the direct
; call is the live dispatch. Nothing here mints a type atom from a string, and
; no helper is captured by value.
;
; Run: bin/bl test test/bl/host_vector_test.bl

(ns host.vector-enumerable)

(defn- self-mod
  "The atom THIS source was compiled into, read from a fun literal compiled into
   this file — module-exact, so `slice` and the `__impl__` refusal can name the
   probe atom under test and the production atom in the seed alike."
  []
  (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))

(defn __impl__
  "The `defimpl`-generated introspection: `:for` is the type, `:protocol` the
   protocol. An unknown key is the `FunctionClauseError` the generated
   two-clause function raised."
  [k]
  (cond
    (= :for k) :"Elixir.BeamLisp.Vector"
    (= :protocol k) :"Elixir.Enumerable"
    :else (erlang/error
            (Elixir.FunctionClauseError/exception
              (list (tuple :module (self-mod))
                    (tuple :function :__impl__)
                    (tuple :arity 1))))))

(defn count
  "`Enumerable.count/1`: the cardinality, tagged `{:ok, n}`."
  [v]
  (tuple :ok (BeamLisp.Vector/count v)))

(defn member?
  "`Enumerable.member?/2`: membership by `Enum.member?` over the elements, tagged
   `{:ok, bool}` — the same structural `==` the live impl used."
  [v x]
  (tuple :ok (Enum/member? (BeamLisp.Vector/to_list v) x)))

(defn reduce
  "`Enumerable.reduce/3`: fold the elements through `Enumerable.List.reduce`,
   thenables and suspension included."
  [v acc fun]
  (Enumerable.List/reduce (BeamLisp.Vector/to_list v) acc fun))

(defn slice
  "No constant-time slice for a vector; the caller falls back to `reduce`. The
   error names THIS impl module, as `__MODULE__` did."
  [_v]
  (tuple :error (self-mod)))
