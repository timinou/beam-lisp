; host/ex_info.bl — the pinned HOST MODULE for `Elixir.BeamLisp.ExInfo`, the
; exception `throw` compiles to and `try`'s untyped catch binds.
;
; `lib/beam_lisp/ex_info.ex` declares it as
;
;     defexception [:message, :data]
;
; and hangs five helpers off it — `ex_info/2`, `ex_data/1`, `ex_message/1`,
; `ex_original/1`, `raise_payload/1` — the Clojure-shaped payload surface the
; language's `throw`/`ex-info`/`ex-data`/`ex-message`/`ex-original` ride on.
; A pinned host source carries functions in exactly ONE namespace and compiles
; to exactly ONE module, so THIS file is the whole exception — struct surface
; and payload helpers both — compiled by `BeamLisp.AOT/compile_host_file` with
;
;     :struct_fields [{:__exception__ true} {:message nil} {:data nil}]
;     :behaviour     :"Elixir.Exception"
;
; (This wave owns source and tests only; the seed entry that points a real atom
; at this file is written by the wave that deletes `ex_info.ex`.)
;
; This file names NO module. The tag its `exception/1` and `ex_info/2` build is
; read from a fun literal compiled into this file (`erlang/fun_info(F, :module)`,
; the `reader_exception.bl` / `num.bl` idiom), so the same bytes compiled at
; `BeamLisp.ExInfo` build an ExInfo and the same bytes at `<Probe>` build a
; Probe. A pinned file cannot call the synthesized `__struct__/1` either — a
; sibling call compiles to the namespace shim and `__struct__` is never interned
; as a namespace var — so the struct map is built with `maps/put` over
; `(maps/new)`, tagged with this file's own module.
;
; WHAT THE MODULE OWES.
;
;   * `exception/1` — `defexception`'s generated constructor, clause for clause:
;     a bare message binary forwards through the keyword list; a keyword list
;     folds with the LIVE `Kernel.struct!/2` refusal. An undeclared key is a
;     `KeyError` carrying `key` and `term: nil` (the synthesized `__struct__/1`'s
;     `:maps.update/3` fold raises differently, so this fold is written by hand);
;     an `{:__struct__, tag}` pair that CHANGES the tag is the live
;     `ArgumentError`, never a silently-retagged struct.
;
;   * `message/1` — the generated clause pair: a map carrying `:message` answers
;     it directly (nil stays nil), every other shape takes the compiler's dynamic
;     field fallback `:elixir_erl_pass.no_parens_remote/2` (`BadMapError` for a
;     non-map, `KeyError` for a map without `:message`, `UndefinedFunctionError`
;     for a bare atom) — class for class with the live generated beam.
;
;   * `ex_info/2`, `ex_data/1`, `ex_message/1`, `ex_original/1` — the payload
;     accessors, clause for clause. `ex_data` reads `:data` only off THIS
;     module's structs (`is_struct(e, __MODULE__)`); `ex_message` answers
;     `Exception.message/1` for anything `is_exception/1` accepts and `inspect`
;     otherwise; `ex_original` reads `:original` off an `ErlangError`.
;
;   * `raise_payload/1` — what `throw` lowers to: an SDK exception is re-raised
;     AS-IS, a map becomes an ExInfo carrying it as `data` and its printed form
;     as `message`, anything else an ExInfo with `inspect`'s text and no data.
;     The raise is `erlang/error/1` — the class `:error` and the reason the very
;     struct `Kernel.raise/1` ends in. It is NOT `erlang:raise/3`: the lowerer
;     rewrites a 3-arity `erlang:raise/3` call to the `raw_raise` primop, which
;     SEGFAULTS the VM given a frame list (MEASURED, `reader.bl`'s header). A
;     bare `erlang/error` needs no stack and cannot reach that path.
;
; Run: bin/bl test test/bl/host_ex_info_test.bl

(ns host.ex-info)

(defn- kv
  "A 2-tuple; the shape a keyword list is folded through."
  [k v]
  (erlang/list_to_tuple (list k v)))

(defn- self_module
  "The atom THIS source was compiled into, read from a fun literal compiled into
   this file — module-exact, so the same source serves production and probe
   without naming either."
  []
  (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))

(defn- struct_like?
  "True when `x` is a map carrying an atom `:__struct__` tag — the shape `%_{…}`
   matches, and the first half of `is_exception/1`. A binary tag is NOT a struct
   (`%{__struct__: \"s\"}` is no `%_{}`), and neither is a bare map."
  [x]
  (and (erlang/is_map x)
       (erlang/is_map_key :__struct__ x)
       (erlang/is_atom (erlang/map_get :__struct__ x))))

(defn- exception_value?
  "`is_exception/1`: a struct whose map carries `:__exception__`. A plain struct
   (`%BeamLisp.Decimal{}`) answers false, as it does to the Kernel guard."
  [x]
  (and (struct_like? x) (erlang/is_map_key :__exception__ x)))

(defn- tags?
  "`is_struct(x, tag)`: `x` is a struct whose `:__struct__` is exactly `tag`."
  [x tag]
  (and (struct_like? x) (erlang/== (erlang/map_get :__struct__ x) tag)))

(defn- struct_map
  "The `%Mod{__exception__: true, message: m, data: d}` map — the tag from this
   file's own fun literal, so it names whichever atom this beam occupies."
  [message data]
  (maps/put :data data
    (maps/put :message message
      (maps/put :__exception__ true
        (maps/put :__struct__ (self_module) (maps/new))))))

(defn- struct_default
  "The `%Mod{__exception__: true, message: nil, data: nil}` map `__struct__/0`
   returns."
  []
  (struct_map nil nil))

(defn- build_struct!
  "Fold `pairs` over the default map and validate the tag, exactly as
   `Kernel.struct!/2` does for an atom module. An undeclared key is the live
   `KeyError` (`key`, `term: nil`); an `{:__struct__, tag}` pair that CHANGES the
   tag is the `ArgumentError` the live `validate_struct!/3` raised, never a
   silently-retagged struct."
  [mod pairs]
  (let [result (Enum/reduce pairs (struct_default)
                 (fn [[k v] map]
                   (if (erlang/is_map_key k map)
                     (maps/put k v map)
                     (erlang/error (Elixir.KeyError/exception (list (kv :key k)))))))
        tag (erlang/map_get :__struct__ result)]
    (cond
      (erlang/== mod tag) result

      (erlang/is_atom tag)
      (erlang/error
        (Elixir.ArgumentError/exception
          (str "expected struct name returned by " (Kernel/inspect mod)
               ".__struct__/1 to be " (Kernel/inspect mod)
               ", got: " (Kernel/inspect tag))))

      :else
      (erlang/error
        (Elixir.ArgumentError/exception
          (str "expected " (Kernel/inspect mod)
               ".__struct__/1 to return a map with a :__struct__ key that holds"
               " the name of the struct (atom), got: " (Kernel/inspect result)))))))

(defn exception
  "The `Exception` callback: build this module's struct from a keyword list, or
   from a bare message binary. `defexception [:message, :data]`'s generated
   `exception/1`, clause for clause — the binary clause first, forwarding through
   the list one."
  ([message] :when (string? message)
   (exception (list (kv :message message))))
  ([args] :when (list? args)
   (build_struct! (self_module) args)))

(defn message
  "The `Exception` callback: this struct's `:message`, read as `e.message` reads
   it. The map clause answers directly (`nil` stays `nil`); every other shape
   takes the compiler's own dynamic-field fallback,
   `:elixir_erl_pass.no_parens_remote/2` — the very helper the live generated
   beam calls — so a non-map is `BadMapError`, a map without `:message` is
   `KeyError`, and a bare atom is the `UndefinedFunctionError` the dot syntax
   raised. Class for class with the live module."
  [exception]
  (if (and (erlang/is_map exception) (erlang/is_map_key :message exception))
    (erlang/map_get :message exception)
    (let [r (erlang/apply :elixir_erl_pass :no_parens_remote (list exception :message))]
      (if (erlang/== :ok (erlang/element 1 r))
        (erlang/element 2 r)
        (erlang/error (erlang/element 2 r))))))

(defn ex_info
  "Build an exception carrying arbitrary data."
  [msg data]
  (struct_map msg data))

(defn ex_data
  "The `data` of an ExInfo exception; nil for any other value."
  [e]
  (if (tags? e (self_module)) (erlang/map_get :data e) nil))

(defn ex_message
  "A readable message for any value: exceptions via Exception.message, else
   inspect."
  [e]
  (if (exception_value? e) (Elixir.Exception/message e) (Kernel/inspect e)))

(defn ex_original
  "The Erlang ORIGINAL of an ErlangError — `:terminated`, `:epipe`, `:badarg`,
   … — or nil for any other value."
  [e]
  (if (tags? e :Elixir.ErlangError) (erlang/map_get :original e) nil))

(defn raise_payload
  "Raise a value as an exception, so `try` can catch it. An existing exception is
   re-raised as-is; a map becomes an ExInfo carrying it as `data`; anything else
   becomes an ExInfo with a printed message and no data.

   The raise is `erlang/error/1` — the same class `:error` and reason
   `Kernel.raise/1` ends in. It must never be a 3-arity `erlang:raise/3` call,
   which the lowerer rewrites to the SEGFAULT-prone `raw_raise` primop."
  [x]
  (cond
    (exception_value? x)
    (erlang/error x)

    (erlang/is_map x)
    (erlang/error (struct_map (BeamLisp.Ns.Rt/print_str x) x))

    :else
    (erlang/error (struct_map (Kernel/inspect x) nil))))
