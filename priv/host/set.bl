; host/set.bl — the pinned HOST MODULE for `Elixir.BeamLisp.Set`.
;
; `BeamLisp.Set` is beam-lisp's Clojure set: the DISTINCT elements of a
; collection, backed by Elixir's `MapSet` for hash membership and structural
; sharing. This file is the `.bl` port of `lib/beam_lisp/set.ex`'s
; `BeamLisp.Set` half, compiled by `BeamLisp.AOT/compile_host_file` into ONE
; exact-named beam whose `__struct__/0,1` pair and `__info__/1` are SYNTHESIZED
; by the `:struct_fields` option — no `defstruct`, no Elixir source.
;
; KEYING. Every element is stored through `BeamLisp.Ns.Rt.hash_key/1`, exactly
; as the Elixir module did. Metadata is invisible to `=`, so it must be
; invisible to set membership too — otherwise a value and its metadata-bearing
; twin both live in the set while comparing equal. `add`/`del`/`member?` are the
; three hash boundaries and all three normalize.
;
; THE STRUCT IS BUILT BY HAND, never by calling the synthesized `__struct__/1`.
; A pinned file cannot name it: an unqualified `__struct__` is not a unit defn,
; so the compiler lowers it to a var lookup. And the tag must be whatever module
; the file was compiled INTO — at `BeamLisp.Set` it builds `%BeamLisp.Set{}`, at
; a probe atom that atom's struct. `new` reads its own module from a fun literal
; compiled into this file (`erlang:fun_info(F, module)`), the same module-exact
; idiom `priv/host/delay.bl` uses, so a probe compile answers that beam's own
; `__struct__/1` with no hard-coded atom. `add`/`del`/`member?`/`count`/`to_list`
; never need the atom: they read `:members` out of the value they are handed.
;
; There is NO helper function here. A pinned module's export surface is exactly
; the file's defns plus the synthesized constructor pair, so a private-looking
; helper would still be an export and would drift from the live module's.
;
; Run: bin/bl test test/bl/host_set_test.bl

(ns host.set)

(defn new
  "The empty set, or the set of `enum`'s distinct elements. The `:members`
   store is a `MapSet`, so a bl vector or any Enumerable seq is accepted."
  ([] (let [mod (erlang/element 2 (erlang/fun_info (fn [] nil) :module))]
        (maps/put :members (MapSet/new) (maps/put :__struct__ mod (maps/new)))))
  ([enum] (let [mod (erlang/element 2 (erlang/fun_info (fn [] nil) :module))]
            (maps/put :members (MapSet/new enum) (maps/put :__struct__ mod (maps/new))))))

(defn add
  "Set with `x` added (idempotent). `x` is keyed by `Rt.hash_key`, so a value
   and its metadata-bearing twin are ONE member."
  [s x]
  (maps/put :members (MapSet/put (maps/get :members s) (BeamLisp.Ns.Rt/hash_key x)) s))

(defn del
  "Set with `x` removed (idempotent), by `Rt.hash_key`."
  [s x]
  (maps/put :members (MapSet/delete (maps/get :members s) (BeamLisp.Ns.Rt/hash_key x)) s))

(defn member?
  "Membership by `Rt.hash_key`."
  [s x]
  (MapSet/member? (maps/get :members s) (BeamLisp.Ns.Rt/hash_key x)))

(defn count
  "Cardinality."
  [s]
  (MapSet/size (maps/get :members s)))

(defn to_list
  "The members as a list. Iteration order is set-internal, as in Clojure —
   never sorted, and never promised stable across builds."
  [s]
  (MapSet/to_list (maps/get :members s)))
