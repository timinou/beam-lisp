; host/num.bl — the pinned HOST MODULE for `Elixir.BeamLisp.Num`.
;
; `BeamLisp.Num` is the numeric tower's seam: every core arithmetic and
; ordering primitive routes its 2-arity through it, and the language links
; `+ - * / < > <= >= ==` straight into this module (rt.bl's operator table) and
; lowers a 2-arity `Elixir.BeamLisp.Num` call to one `:arith` node whose fast
; path is the Erlang BIF. This file is the `.bl` port of `lib/beam_lisp/num.ex`,
; compiled by `BeamLisp.AOT/compile_host_file` into ONE exact-named beam with
; the file's `defn`s as plain exported functions — no shim, no Elixir source.
;
; THREE things about this port are not free, and each is why a line below reads
; the way it does.
;
; 1. ERLANG BIFs, never the language operators. Almost every body here exists to
;    serve a NON-number operand — a decimal, or a value the BIF would refuse. If
;    a body spelled `(+ a b)`, the BL compiler would lower it to the same
;    `:arith` node a caller's `(+ a b)` gets, and lowering dispatches to the
;    tower the moment either operand is a map — that is, straight back into
;    `Num.add/2` for the very operands this function was entered to handle.
;    So the arithmetic and comparison BIFs are spelled as remote calls
;    (`erlang/+`, `erlang//`, `erlang/==`, …): a direct call, no re-entry, and
;    the same `:badarith` the old `a + b` raised. (`erlang//` is the division
;    BIF; BL's `/` may go through the tower, so the native BIF is named.)
;
; 2. HELPERS ARE CALLED DIRECTLY. A pinned module's sibling call compiles to the
;    namespace shim module and is re-pointed at the pinned atom by the emitter,
;    so `(promote a b)` is a direct call to this module's own `promote/2` at
;    whatever atom the file was compiled into (production or probe). A helper in
;    VALUE position (passed as an argument, captured) is a different lowering —
;    a var lookup that cannot be re-pointed — so helpers appear only in call
;    position. A pinned module carries FUNCTIONS, and `defn-` here is still an
;    exported function (the pinned emitter has no private surface); the public
;    `defn`s below are the live module's exactly, and the helpers ride along.
;
; 3. MODULE-EXACT INTROSPECTION. A pinned file cannot hard-code the atom it is
;    compiled into — the same source becomes `Elixir.BeamLisp.Num` in the seed
;    and `<Probe>` in a differential test. `no-clause!` therefore reads its own
;    module from a fun literal compiled into this file
;    (`erlang:fun_info(F, module)`), the module-exact idiom `priv/host/delay.bl`
;    uses, so the `FunctionClauseError` it raises names the module that is
;    actually raising — production or probe — even though `neg/1`'s decimal
;    clause cannot be a guard (a decimal is a map and no guard can read its
;    `:__struct__`).
;
; SEMANTICS PRESERVED, clause for clause:
;   * integer/float pairs take the BIF (the guard is a type test the BEAM
;     compiles inline);
;   * a Decimal beside an integer lifts exactly (scale 0); beside a FLOAT it is
;     REFUSED (`:decimal/inexact-operand`) — the binary float is not the number
;     that was written, so it must not enter exact arithmetic;
;   * anything else raises the ordinary `:badarith`, as before;
;   * `==`/ordering are NUMERIC (`1 == 1.0`, `1.0M == 1.00M`) while decimal
;     `=`/scale are untouched — `cmp/2` is the tower's three-way answer;
;   * ordering and sign predicates stay TOTAL over Erlang term order for a
;     non-decimal (`(< "A" "B")`, `(pos? :x)`) — only a decimal operand takes
;     the tower, so the compiler's guard expansion and the function form agree.
;
; Run: bin/bl test test/bl/host_num_test.bl

(ns host.num)

; ── helpers ──────────────────────────────────────────────────────────

(defn- pair
  "A 2-tuple; the shape `Exception` reads a keyword list in."
  [k v]
  (erlang/list_to_tuple (list k v)))

(defn- decimal?
  "True when `x` is a `BeamLisp.Decimal`. `map_get` is guarded by
   `is_map_key`, so a map without the key answers false rather than raising."
  [x]
  (and (erlang/is_map x)
       (erlang/is_map_key :__struct__ x)
       (erlang/== (erlang/map_get :__struct__ x) :Elixir.BeamLisp.Decimal)))

(defn- no-clause!
  "Raise the `FunctionClauseError` a clause head would have raised. The module
   is read from this file's own fun literal, so it names whichever atom the
   source was compiled into — the live module at production, the probe atom in
   a differential test."
  [fname arity]
  (erlang/error
    (Elixir.FunctionClauseError/exception
      (list (pair :module (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))
            (pair :function fname)
            (pair :arity arity)))))

(defn- promote
  "`x` as the representation the pair computes in. An integer beside a decimal
   lifts (scale 0, exact); a float beside a decimal is REFUSED; two
   non-decimals fall through to the BIF's own `:badarith`, so the error text,
   class and argument list a plain `(+ 1 :a)` raises are unchanged."
  [x other]
  (cond
    (decimal? x) x

    (decimal? other)
    (cond
      (erlang/is_integer x) (BeamLisp.Decimal/new x)

      (erlang/is_float x)
      (erlang/error
        (BeamLisp.ExInfo/exception
          (list (pair :message
                      (str "a float cannot enter decimal arithmetic: "
                           (Kernel/inspect x)
                           " (use decimal/from-float to approximate on purpose)"))
                (pair :data
                      (maps/put :type :"decimal/inexact-operand"
                                (maps/put :value x (maps/new)))))))

      :else (erlang/error :badarith (list x other)))

    :else (erlang/error :badarith (list x other))))

(defn- decimal_pair?
  "Whether the tower must answer for this pair."
  [a b]
  (or (decimal? a) (decimal? b)))

; ── arithmetic ───────────────────────────────────────────────────────

(defn add
  "Sum, exact over the tower's members."
  ([a b] :when (and (number? a) (number? b)) (erlang/+ a b))
  ([a b] (BeamLisp.Decimal/add (promote a b) (promote b a))))

(defn sub
  "Difference, exact over the tower's members."
  ([a b] :when (and (number? a) (number? b)) (erlang/- a b))
  ([a b] (BeamLisp.Decimal/sub (promote a b) (promote b a))))

(defn mul
  "Product, exact over the tower's members."
  ([a b] :when (and (number? a) (number? b)) (erlang/* a b))
  ([a b] (BeamLisp.Decimal/mul (promote a b) (promote b a))))

(defn div
  "`/` on two decimals is EXACT division (`:decimal/non-terminating` when it is
   not), never a float: `(/ 1M 3M)` refusing is the right answer for money.
   Between ints/floats it is the native division BIF."
  ([a b] :when (and (number? a) (number? b)) (erlang// a b))
  ([a b] (BeamLisp.Decimal/div (promote a b) (promote b a))))

(defn neg
  "Negation. A non-number, non-decimal is the live module's
   `FunctionClauseError` — `neg/1` has no clause for it."
  ([a] :when (number? a) (erlang/- a))
  ([d] (if (decimal? d) (BeamLisp.Decimal/neg d) (no-clause! :neg 1))))

; ── ordering ─────────────────────────────────────────────────────────

; The ordering ops are, and stay, TOTAL over Erlang term order — `(< "A" "B")`
; and `(> :b :a)` answer as they always did; only a decimal operand takes the
; tower. (The tower paths raise `:badarith` for a decimal beside a value that
; can be neither lifted nor converted, exactly as the live module does.)

(defn lt
  "Numeric `<`; total term order for a non-decimal pair."
  ([a b] :when (and (number? a) (number? b)) (erlang/< a b))
  ([a b] (if (decimal_pair? a b) (erlang/< (cmp a b) 0) (erlang/< a b))))

(defn gt
  "Numeric `>`; total term order for a non-decimal pair."
  ([a b] :when (and (number? a) (number? b)) (erlang/> a b))
  ([a b] (if (decimal_pair? a b) (erlang/> (cmp a b) 0) (erlang/> a b))))

(defn le
  "Numeric `<=`; total term order for a non-decimal pair."
  ([a b] :when (and (number? a) (number? b)) (erlang/=< a b))
  ([a b] (if (decimal_pair? a b) (erlang/=< (cmp a b) 0) (erlang/=< a b))))

(defn ge
  "Numeric `>=`; total term order for a non-decimal pair."
  ([a b] :when (and (number? a) (number? b)) (erlang/>= a b))
  ([a b] (if (decimal_pair? a b) (erlang/>= (cmp a b) 0) (erlang/>= a b))))

(defn num_eq
  "Numeric equality: `(== 1 1.0)` and `(== 1.0M 1.00M)` are true."
  ([a b] :when (and (number? a) (number? b)) (erlang/== a b))
  ([a b] (if (decimal_pair? a b) (erlang/== (cmp a b) 0) (erlang/== a b))))

(defn cmp
  "Three-way numeric comparison for the tower's members."
  ([a b] :when (and (number? a) (number? b))
   (cond
     (erlang/< a b) -1
     (erlang/> a b) 1
     :else 0))
  ([a b] (BeamLisp.Decimal/compare (promote a b) (promote b a))))

; ── sign and zero ────────────────────────────────────────────────────

; Total, and for a non-number exactly the Erlang term comparison it was before
; — so `:when (pos? x)` (compiler.bl guard-special, which cannot call into the
; tower) and the function form keep agreeing.

(defn zero?
  "Numerically zero."
  ([x] :when (number? x) (erlang/== x 0))
  ([d] (if (decimal? d) (erlang/== (BeamLisp.Decimal/signum d) 0) (erlang/== d 0))))

(defn pos?
  "Numerically positive."
  ([x] :when (number? x) (erlang/> x 0))
  ([d] (if (decimal? d) (erlang/> (BeamLisp.Decimal/signum d) 0) (erlang/> d 0))))

(defn neg?
  "Numerically negative."
  ([x] :when (number? x) (erlang/< x 0))
  ([d] (if (decimal? d) (erlang/< (BeamLisp.Decimal/signum d) 0) (erlang/< d 0))))

(defn number?
  "A member of the numeric tower, of any representation."
  ([x] :when (number? x) true)
  ([x] (decimal? x)))
