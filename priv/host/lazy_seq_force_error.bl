; host/lazy_seq_force_error.bl — the pinned HOST MODULE for
; `Elixir.BeamLisp.LazySeq.ForceError`, the exception `BeamLisp.LazySeq.force/1`
; raises when a force is terminal (a recursive force, a lost owner, a cycle) or
; when a memo budget refuses a new attempt.
;
; `lib/beam_lisp/lazy_seq.ex` declares it NESTED inside `BeamLisp.LazySeq`:
;
;     defmodule BeamLisp.LazySeq do
;       defmodule ForceError do
;         defexception [:reason, :message]
;         def exception(reason),
;           do: %__MODULE__{reason: reason, message: "LazySeq force failed: #{inspect(reason)}"}
;       end
;       …
;     end
;
; A pinned host source carries functions in exactly ONE namespace and compiles
; to exactly ONE module, so the nested exception gets its OWN source — the
; functions-only `priv/host/lazy_seq.bl` cannot carry a second module beside
; `BeamLisp.LazySeq`'s defns, and `force/1` reaches this module by that exact
; nested atom (`BeamLisp.LazySeq.ForceError/exception`), exactly as the reader
; facade reaches `priv/host/reader_exception.bl`'s two atoms.
;
; WHAT THE MODULE OWES. `defexception [:reason, :message]` with a USER-WRITTEN
; `exception/1` generates:
;
;     defstruct [__exception__: true, reason: nil, message: nil]
;     def message(e), do: e.message
;
; and the author's own `exception/1` REPLACES the generated clause pair
; entirely — there is no binary clause and no keyword-list clause: `reason` is
; whatever the caller passed (an atom such as `:cyclic_memo`, a tuple such as
; `{:force_owner_lost, pid, ref}`, or a bare list), and the message is the
; interpolation of `inspect(reason)`.
;
; `:struct_fields` synthesizes the `__struct__/0,1` + `__info__/1` half. The two
; EXCEPTION callbacks are the defns below, and they build their struct map
; THEMSELVES, never by calling the generated `__struct__/1`: a pinned file's
; sibling call compiles to the namespace shim
; (`BeamLisp.Ns.Host.LazySeqForceError`) and `__struct__` is emitted as module
; clauses only — never interned as a namespace var — so `(__struct__ …)`
; compiles to `undefined var: …/__struct__` (MEASURED; `reader.bl`'s header).
; The map is therefore built with `maps/put` over `(maps/new)`, tagged with this
; file's own module from a fun literal
; (`erlang/fun_info(F, :module)`, the `reader_exception.bl` / `delay.bl` idiom),
; so the SAME bytes compiled at `BeamLisp.LazySeq.ForceError` build a ForceError
; and the same bytes at a probe atom build that probe.
;
; The message is assembled with `erlang/iolist_to_binary` over
; `Kernel/inspect/1`, never BL `str`: a pinned module must not reach a BL
; runtime helper to render its own exception (the same reason
; `priv/host/atom_guard_limit_error.bl` spells its message this way).
;
; `message/1` mirrors the generated clause: a map carrying `:message` answers it
; directly (`nil` stays `nil` — a non-string message is `Exception.message/1`'s
; to refuse, not this one's), and every other shape takes the compiler's
; dynamic-field fallback (`:elixir_erl_pass.no_parens_remote/2`, the helper the
; live beam itself calls) — `BadMapError` for a non-map, `KeyError` for a map
; without `:message`, `UndefinedFunctionError` for a bare atom.
;
; (This wave owns source and tests only; the seed entry that points this file at
; `Elixir.BeamLisp.LazySeq.ForceError` is written by the wave that deletes
; `lazy_seq.ex`, the family convention `atom_guard_limit_error.bl` follows.)
;
; Run: bin/bl test test/bl/host_lazy_seq_test.bl

(ns host.lazy-seq-force-error)

(defn- self_module
  "The atom THIS source was compiled into, read from a fun literal compiled into
   this file — module-exact, so the same source serves production and probe
   without naming either."
  []
  (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))

(defn- build_message
  "The author's message for `reason`: `\"LazySeq force failed: \" <> inspect(reason)`,
   built with `iolist_to_binary` so no BL runtime helper is reached."
  [reason]
  (erlang/iolist_to_binary (list "LazySeq force failed: " (Kernel/inspect reason))))

(defn exception
  "The author's `exception/1`: build this module's struct from `reason`, the
   custom clause that REPLACED `defexception`'s generated pair. Any term is a
   valid reason, so there is no guard and no binary/keyword clause."
  [reason]
  (let [mod (self_module)]
    (maps/put :message (build_message reason)
      (maps/put :reason reason
        (maps/put :__exception__ true
          (maps/put :__struct__ mod (maps/new)))))))

(defn message
  "The generated `message/1`: this struct's `:message`, read as `e.message`
   reads it. The map clause answers directly (`nil` stays `nil`); every other
   shape takes the compiler's own dynamic-field fallback,
   `:elixir_erl_pass.no_parens_remote/2` — the very helper the live generated
   beam calls — so a non-map is `BadMapError`, a map without `:message` is
   `KeyError`, and a bare atom is the `UndefinedFunctionError` the dot syntax
   raised. Class for class with the live module."
  [exception]
  (if (and (erlang/is_map exception) (erlang/is_map_key :message exception))
    (erlang/map_get :message exception)
    (let [r (erlang/apply :elixir_erl_pass :no_parens_remote (list exception :message))]
      (if (erlang/== :ok (erlang/element 1 r))
        (erlang/element 2 r)
        (erlang/error (erlang/element 2 r))))))
