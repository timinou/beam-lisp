; host/reader_exception.bl — the pinned HOST MODULE for the reader's two
; exception types: `Elixir.BeamLisp.Reader.SyntaxError` and
; `Elixir.BeamLisp.Reader.AtomLimitError`.
;
; `lib/beam_lisp/reader.ex` declares both as bare `defexception [:message]`
; beside its `BeamLisp.Reader` facade:
;
;     defmodule BeamLisp.Reader.SyntaxError do defexception [:message] end
;     defmodule BeamLisp.Reader.AtomLimitError do defexception [:message] end
;
; A pinned host source carries functions in exactly ONE namespace and compiles
; to exactly ONE module, and the seed's `host-sources` maps one source to one
; module. The two exception types are SHAPE-IDENTICAL, so ONE source serves
; both: the seed points THIS file at two module atoms, once per exception, each
; entry carrying the same pair of compile options:
;
;     :struct_fields [{:__exception__ true} {:message nil}]
;     :behaviour     :"Elixir.Exception"
;
; This file names NO module. The tag its `exception/1` builds is read from a fun
; literal compiled into this file (`erlang/fun_info(F, :module)`, the `delay.bl`
; / `num.bl` idiom), so the SAME bytes compiled at `BeamLisp.Reader.SyntaxError`
; build a SyntaxError and the same bytes at `BeamLisp.Reader.AtomLimitError`
; build an AtomLimitError. (This wave owns source and tests only; the seed
; entries are written by the wave that deletes `reader.ex`.)
;
; WHAT THE MODULE OWES. `defexception [:message]` generates:
;
;     defstruct [__exception__: true, message: nil]
;     def exception(msg) when is_binary(msg), do: exception([message: msg])
;     def exception(kw)  when is_list(kw),   do: struct!(__MODULE__, kw)
;     def message(e), do: e.message
;
; `:struct_fields` synthesizes the `__struct__/0,1` + `__info__/1` half. The
; two EXCEPTION callbacks are the defns below, and they must build their struct
; map THEMSELVES, never call the generated `__struct__/1`: a pinned file's
; sibling call compiles to the namespace shim (`BeamLisp.Ns.Host.ReaderException`)
; and `__struct__` is emitted as module clauses only — never interned as a
; namespace var — so `(__struct__ kv)` compiles to `undefined var: …/__struct__`
; (MEASURED; `reader.bl`'s header). The map is therefore built with `maps/put`
; over `(maps/new)`, tagged with this file's own module from the fun literal.
;
; `exception/1`'s keyword fold reproduces the LIVE `Kernel.struct!/2` refusal,
; not merely the pinned `__struct__/1`'s. An undeclared key is a `KeyError`
; carrying `key` and `term: nil` — the shape `%KeyError{key: k, term: nil}` the
; live module raises (`Exception.normalize` leaves it alone; `KeyError.message/1`
; renders "key :k not found"). The synthesized `__struct__/1` folds with
; `:maps.update/3`, whose raise is recovered from the stacktrace into a KeyError
; WITH `term` set and a different message — so this fold is deliberately written
; by hand rather than delegated. The fold also VALIDATES the tag, as
; `Kernel.struct!/2` does: an `{:__struct__, tag}` pair that changes the tag is
; the live `ArgumentError`, never a silently-retagged struct.
;
; `message/1` mirrors the generated clause pair: a map carrying `:message`
; answers it directly (nil stays nil — a non-string message is
; `Exception.message/1`'s to refuse, not this one's), and every other shape takes
; the compiler's dynamic-field fallback (`:elixir_erl_pass.no_parens_remote/2`,
; the helper the live beam itself calls) — `BadMapError` for a non-map, `KeyError`
; for a map without `:message`, `UndefinedFunctionError` for a bare atom.
;
; Run: bin/bl test test/bl/host_reader_exception_test.bl

(ns host.reader-exception)

(defn- kv
  "A 2-tuple; the shape a keyword list is folded through."
  [k v]
  (erlang/list_to_tuple (list k v)))

(defn- self_module
  "The atom THIS source was compiled into, read from a fun literal compiled into
   this file — module-exact, so the same source serves both exception atoms
   without naming either."
  []
  (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))

(defn- struct_default
  "The `%Mod{__exception__: true, message: nil}` map `__struct__/0` returns: the
   tag from `self_module`, so it names whichever atom this beam occupies."
  []
  (maps/put :message nil
    (maps/put :__exception__ true
      (maps/put :__struct__ (self_module) (maps/new)))))

(defn- build_struct!
  "Fold `pairs` over the default map and validate the tag, exactly as
   `Kernel.struct!/2` does for an atom module. An undeclared key is the live
   `KeyError` (`key`, `term: nil`); an `{:__struct__, tag}` pair that CHANGES
   the tag is the `ArgumentError` the live `validate_struct!/3` raised, never a
   silently-retagged struct."
  [mod pairs]
  (let [result (Enum/reduce pairs (struct_default)
                 (fn [[k v] map]
                   (if (erlang/is_map_key k map)
                     (maps/put k v map)
                     (erlang/error (Elixir.KeyError/exception (list (kv :key k)))))))
        tag (erlang/map_get :__struct__ result)]
    (cond
      (erlang/== mod tag) result

      (erlang/is_atom tag)
      (erlang/error
        (Elixir.ArgumentError/exception
          (str "expected struct name returned by " (Kernel/inspect mod)
               ".__struct__/1 to be " (Kernel/inspect mod)
               ", got: " (Kernel/inspect tag))))

      :else
      (erlang/error
        (Elixir.ArgumentError/exception
          (str "expected " (Kernel/inspect mod)
               ".__struct__/1 to return a map with a :__struct__ key that holds"
               " the name of the struct (atom), got: " (Kernel/inspect result)))))))

(defn exception
  "The `Exception` callback: build this module's struct from a keyword list, or
   from a bare message binary. `defexception [:message]`'s generated `exception/1`,
   clause for clause — the binary clause first, forwarding through the list one."
  ([message] :when (string? message)
   (exception (list (kv :message message))))
  ([args] :when (list? args)
   (build_struct! (self_module) args)))

(defn message
  "The `Exception` callback: this struct's `:message`, read as `e.message` reads
   it. The map clause answers directly (`nil` stays `nil`); every other shape
   takes the compiler's own dynamic-field fallback,
   `:elixir_erl_pass.no_parens_remote/2` — the very helper the live generated
   beam calls — so a non-map is `BadMapError`, a map without `:message` is
   `KeyError`, and a bare atom is the `UndefinedFunctionError` the dot syntax
   raised. Class for class with the live module."
  [exception]
  (if (and (erlang/is_map exception) (erlang/is_map_key :message exception))
    (erlang/map_get :message exception)
    (let [r (erlang/apply :elixir_erl_pass :no_parens_remote (list exception :message))]
      (if (erlang/== :ok (erlang/element 1 r))
        (erlang/element 2 r)
        (erlang/error (erlang/element 2 r))))))
