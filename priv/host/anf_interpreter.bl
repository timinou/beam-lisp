; host/anf_interpreter.bl — the pinned HOST MODULE for
; `Elixir.BeamLisp.AnfInterpreter`.
;
; `priv/self/anf.bl` is the bl-ANF reference interpreter — the oracle that gives
; bl-ANF a meaning independent of any backend. It does not model `raise` itself:
; a canonical `:try` node's catch body is run by asking this module to CAPTURE a
; thunk once, and to RERAISE an unmatched class/reason/stack through the public
; `erlang:raise/3` path. Both halves are here, and they are the two functions the
; Elixir module had:
;
;   capture/1 — invoke a thunk with NO arguments. Success is `{:ok, value}`.
;               A raise is `{:raised, kind, reason, {:interpreted_trace, frames}}`
;               where `kind` is the RAW Erlang catch class (`:throw`/`:error`/
;               `:exit`), `reason` is the RAW reason, and `frames` is the frame
;               LIST. This tagged trace is an INTERPRETER model: it must never
;               be handed to the VM's raw-raise primop (see `reraise/3`).
;
;   reraise/3 — re-raise a captured `{:interpreted_trace, frames}` through the
;               public API, preserving class, reason and frames.
;
; WHY THE RAW REASON NEEDS RECOVERING. The language's compiled `try` does not
; give a handler the raw Erlang reason: it binds ONE normalized `e` (a `:throw`
; keeps its value; an `:error` becomes `Exception.normalize(:error, value, …)`;
; an `:exit` becomes the tuple `{:exit, value}`) and two extra locals around
; every catch clause —
;
;     __EXCEPTION_KIND__  the RAW class, exactly the catch clause's pattern
;     __STACKTRACE__      the BUILT frame list
;
; (`priv/boot/compiler.bl`'s `catch-handler-node` / `compile-try`). The class is
; therefore exact, and the raw reason is reversed from the fold:
;
;   * `:throw`  — `e` IS the raw reason, unchanged;
;   * `:exit`   — `e` is `{:exit, value}`, so the reason is `element(2, e)`;
;   * `:error`  — `Exception.normalize/3` returns an exception struct as-is, so
;                 an ordinary `(raise SomeError)` keeps its exact struct. A raw
;                 Erlang reason (`:badarith`, a bare tuple) is wrapped in an
;                 `%ErlangError{}`, whose `:original` field is that reason. So
;                 `:error` is `ErlangError.original(e)` for an ErlangError and
;                 `e` otherwise.
;
; The one shape this cannot invert is a raw `%ErlangError{}` raised AS a value:
; it normalizes to itself and reads back as its `:original`. That ambiguity is
; inherent to normalize, and the interpreter never produces it.
;
; WHY `reraise/3` IS A DYNAMIC `apply`. A direct `(erlang/raise class reason
; stack)` call is REWRITTEN by `priv/boot/lower.bl` into the `raw_raise` primop,
; which takes the RAW stack value — a frame list there SEGFAULTS the VM (MEASURED,
; `priv/host/reader.bl`'s header, and lower.bl's `craise` docstring). Capture
; hands out the BUILT frame list, so the re-raise must reach the real
; `erlang:raise/3` BIF, which is the one that takes a frame list. `erlang/apply`
; makes that call DYNAMIC, so the lowerer's direct-call rewrite never fires.
;
; This file is the `.bl` port of `lib/beam_lisp/anf_interpreter.ex`, compiled by
; `BeamLisp.AOT/compile_host_file` into ONE exact-named beam. Its export surface
; is exactly the live module's — `capture/1` and `reraise/3`, no helper — so the
; namespace shim beside it is dropped and the pinned beam answers alone.
;
; (This wave owns source and tests only; the seed entry that points a real atom
; at this file is written by the wave that deletes `anf_interpreter.ex`.)
;
; Run: bin/bl test test/bl/host_anf_interpreter_test.bl

(ns host.anf-interpreter)

(defn capture
  "Invoke `fun` with no arguments, returning `{:ok, value}`, or a raise as
   `{:raised, kind, reason, {:interpreted_trace, frames}}` — the raw Erlang
   catch class, the RAW reason, and the frame list."
  [fun]
  (try
    (tuple :ok (BeamLisp.Ns.Rt/invoke fun (list)))
    (catch e
      ; `__EXCEPTION_KIND__` is the raw class and `__STACKTRACE__` the built
      ; frame list; both are bound by the compiler around every catch clause.
      (let [kind __EXCEPTION_KIND__
            reason (cond
                     (= kind :throw) e
                     (= kind :exit) (erlang/element 2 e)
                     (and (erlang/is_map e)
                          (erlang/is_map_key :__struct__ e)
                          (= :Elixir.ErlangError (erlang/map_get :__struct__ e)))
                       (erlang/map_get :original e)
                     :else e)]
        (tuple :raised kind reason (tuple :interpreted_trace __STACKTRACE__))))))

(defn reraise
  "Re-raise a captured `{:interpreted_trace, frames}` with its class and reason.
   The frames ride through `erlang:apply/3` so the call stays dynamic and the
   lowerer's `raw_raise` rewrite — which takes the raw stack and SEGFAULTS on a
   frame list — is never reached.

   Only the tagged trace is accepted, exactly as the live `reraise/3` clause
   matched. Anything else is the same `FunctionClauseError` a head mismatch
   raised, named with this beam's own module so production and probe each name
   themselves."
  [kind reason trace]
  (if (and (erlang/is_tuple trace)
           (erlang/== 2 (erlang/tuple_size trace))
           (erlang/== :interpreted_trace (erlang/element 1 trace)))
    (erlang/apply :erlang :raise (list kind reason (erlang/element 2 trace)))
    (erlang/error
      (Elixir.FunctionClauseError/exception
        (list (tuple :module (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))
              (tuple :function :reraise)
              (tuple :arity 3))))))
