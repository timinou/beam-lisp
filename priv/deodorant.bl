; priv/deodorant.bl — smell detection and mechanical correction for
; beam-lisp source, built on the `rewrite` engine.
;
; The problem it solves: an agent (or a person in a hurry) writes the
; *long* spelling of something the language already has a short, exact
; word for — `(if (not p) a b)` where `if-not` exists, `(Map/get m :k)`
; where `(:k m)` exists. None of these are wrong; all of them are noise.
; Deodorant removes the noise.
;
; The honest contract — the same one `rewrite` makes — is that every
; correction is a RULE you can read below: `{:name :tier :pattern
; :replacement :when?}`. There is no model guessing at a fix: the after
; is exactly the sum of the registered rules, and a reviewer checks each
; by eye.
;
; THREE TIERS, because not every rewrite is equal:
;
;   SAFE        — value-identical for all inputs. Apply blind.
;   IDIOMATIC   — value-identical under a mild, near-universal assumption
;                 (numeric argument, keyword-literal key). In the default
;                 `deodorize` ruleset.
;   REINVENTION — a hand-rolled stdlib function (count, sum). Exact, but
;                 restructures more of the form; opt-in via `every-rule`.
;
; A rule may carry `:when`, a GUARD fn receiving the match's bindings
; (keyed by pattern variable) that can veto the rewrite — this is what
; confines the map-access smells to keyword-literal keys: `(Map/get m k)`
; with a variable key is left alone, because the key might not be a
; keyword at runtime.
;
; The registry is OPEN: a project declares its house idioms in its own
; file with `defsmell`, no library edit.
(ns deodorant
  (:require [rewrite]))

; --- the registry --------------------------------------------------------

(def registry
  "Every declared smell, in declaration order. An atom because `defsmell`
   extends it at runtime — a project's own file adds its own idioms."
  (atom (list)))

(defn register-smell!
  "Append `smell` to the registry, replacing any same-named smell
   (redefinition replaces, like a var); returns it. Called from the
   INITIALIZER of the var `defsmell` defines — value-def initializers
   are replayed by `__bl_init__` at module load, which is what makes a
   registered smell survive AOT compilation."
  [smell]
  (swap! registry
         (fn [rs] (concat (filter (fn [s] (not (= (:name s) (:name smell)))) rs)
                          (list smell))))
  smell)

(defmacro defsmell
  "Declare a smell: (defsmell name :tier (pattern) => (replacement)
   [:when guard]). Pattern and replacement are quoted for you — the `?`
   vars survive as pattern variables; the optional :when guard is CODE,
   evaluated here and stored as the veto fn.

   The expansion is a `def`: the smell is an ordinary VAR (inspectable,
   meta-able, visible to the codebase-as-database), and the registration
   call rides its initializer so it replays at AOT module load."
  [name tier pattern _arrow replacement & opts]
  ; `concat` is LAZY — a LazySeq inside the expansion crashes the
  ; compiler's form walker (no data_to_form clause for it). `apply list`
  ; realizes the args into a proper list.
  (list 'def name
        (list 'deodorant/register-smell!
              (cons 'hash-map
                    (apply list
                           (concat (list :name (list 'quote name)
                                         :tier tier
                                         :pattern (list 'quote pattern)
                                         :replacement (list 'quote replacement))
                                   opts))))))

; --- SAFE: value-identical, apply blind ----------------------------------
;
; Ordering matters where patterns overlap: `(if (not ?p) ?a nil)` matches
; both when-not and if-not; try-smells is first-match-wins, so the more
; specific `nil`-tailed forms come FIRST.

(defsmell if→when-not :safe (if (not ?p) ?a nil) => (when-not ?p ?a))
(defsmell if→when     :safe (if ?p ?a nil)       => (when ?p ?a))
(defsmell if→if-not   :safe (if (not ?p) ?a ?b)  => (if-not ?p ?a ?b))

(defsmell not-nil?→some? :safe (not (nil? ?x)) => (some? ?x))
(defsmell not-=→not=     :safe (not (= ?a ?b)) => (not= ?a ?b))

; `(= x nil)` and `(= nil x)` both mean `(nil? x)`; the matcher is
; positional and both spellings occur in the wild.
(defsmell =-nil→nil?  :safe (= ?x nil) => (nil? ?x))
(defsmell =-nil→nil?* :safe (= nil ?x) => (nil? ?x))

(defsmell not-not→boolean :safe (not (not ?x)) => (boolean ?x))

; `(if p true false)` is `(boolean p)` — the "coerce to bool by hand" tic.
; The literals match positionally, so this never fires on `(if p true x)`.
(defsmell if-true-false→boolean :safe (if ?p true false) => (boolean ?p))

; --- IDIOMATIC: value-identical under a mild assumption ------------------
;
; NUMERIC: `(= x 0)` is `(zero? x)` when x is a number — which, at a
; comparison against 0, it always is.
(defsmell =-0→zero?  :idiomatic (= ?x 0) => (zero? ?x))
(defsmell =-0→zero?* :idiomatic (= 0 ?x) => (zero? ?x))
(defsmell >-0→pos?   :idiomatic (> ?x 0) => (pos? ?x))
(defsmell <-0→neg?   :idiomatic (< ?x 0) => (neg? ?x))
(defsmell +1→inc     :idiomatic (+ ?x 1) => (inc ?x))
(defsmell +1→inc*    :idiomatic (+ 1 ?x) => (inc ?x))
(defsmell -1→dec     :idiomatic (- ?x 1) => (dec ?x))

; COLLECTION: `(first (rest x))` is `(second x)`. Structural and exact.
; NB: `(first (first x))`→`ffirst` is deliberately NOT a smell — `ffirst`
; is not defined in this runtime, and a rule may only rewrite to a word
; that actually resolves.
(defsmell first-rest→second :idiomatic (first (rest ?x)) => (second ?x))

; MAP ACCESS: `(Map/get m :k)` is Elixir spelled out. With a keyword
; LITERAL key the language's own words are exact: `(:k m)`,
; `(get m :k default)`, `(get-in m [:a :b])`. The guards confine every
; one of these to keyword literals — a variable or string key stays
; untouched, because it might not be a keyword at runtime. The ONE
; divergence (pinned in the test): keyword-as-fn on nil returns nil where
; Map/get on nil would raise.
(defsmell map-get->kw-access :idiomatic
  (Map/get ?m ?k) => (?k ?m)
  :when (fn [b] (keyword? (get b '?k))))

(defsmell map-get-default->get :idiomatic
  (Map/get ?m ?k ?d) => (get ?m ?k ?d)
  :when (fn [b] (keyword? (get b '?k))))

(defsmell nested-kw->get-in :idiomatic
  (?k2 (?k1 ?m)) => (get-in ?m [?k1 ?k2])
  :when (fn [b] (and (keyword? (get b '?k1)) (keyword? (get b '?k2)))))

(defsmell kw-of-get-default->get-in :idiomatic
  (?k2 (get ?m ?k1 {})) => (get-in ?m [?k1 ?k2])
  :when (fn [b] (and (keyword? (get b '?k1)) (keyword? (get b '?k2)))))

; --- REINVENTION: a hand-rolled stdlib fn, opt-in ------------------------

(defsmell reduce->count :reinvention
  (reduce (fn [?a ?x] (+ ?a 1)) 0 ?xs) => (count ?xs))

(defsmell reduce->sum :reinvention
  (reduce (fn [?a ?x] (+ ?a ?x)) 0 ?xs) => (apply + ?xs))

(defsmell reduce-map->sum :reinvention
  (reduce (fn [?a ?x] (+ ?a (?f ?x))) 0 ?xs) => (apply + (map ?f ?xs)))

; nil-punning in Elixir term order makes (>= nil 0) TRUE — comparing an
; index-of result against a number without a nil check is inverted when
; the substring is absent. Found the hard way in codebase/interop-name?
; (MVP-B): every name looked "interop" and unknown-callee queries went
; silently empty. Some?/nil? say what was meant.
(defsmell index-of-ge-zero :idiomatic
  (>= (index-of ?s ?sub) 0) => (some? (index-of ?s ?sub)))
(defsmell index-of-lt-zero :idiomatic
  (< (index-of ?s ?sub) 0) => (nil? (index-of ?s ?sub)))

; --- tier queries ---------------------------------------------------------

(defn all-smells
  "Every registered smell map, declaration order."
  []
  (deref registry))

(defn rules-of-tier
  "The registered smells of one tier (`:safe`, `:idiomatic`,
   `:reinvention`)."
  [tier]
  (filter (fn [s] (= (:tier s) tier)) (all-smells)))

(defn safe-rules  [] (rules-of-tier :safe))
(defn every-rule  [] (all-smells))

(defn all-rules
  "The default `deodorize` ruleset: safe + idiomatic. Reinvention is
   opt-in only — a caller who wants it takes `every-rule`."
  []
  (concat (rules-of-tier :safe) (rules-of-tier :idiomatic)))

; --- matching: pattern + guard -------------------------------------------

(defn smell-match
  "The bindings map if `smell`'s pattern matches `form` AND its `:when`
   guard (if any) accepts the bindings, else nil. Bindings are keyed by
   the pattern VARIABLE — a guard reads `(get b '?k)`."
  [smell form]
  (let [binds (rewrite/match? (:pattern smell) form)]
    (if (and (some? binds)
             (let [g (get smell :when nil)]
               (if (nil? g) true (g binds))))
      binds
      nil)))

; --- DETECT: find smells without changing anything ------------------------

(defn subforms
  "Every node of `form`, itself included, depth-first. A code form is a
   tree of lists/vectors; this is the flat view the scanner folds over."
  [form]
  (cons form
        (if (or (list? form) (vector? form))
          (reduce (fn [acc x] (concat acc (subforms x))) (list) (seq form))
          (list))))

(defn matches
  "The smells in `rules` that fire on `form` at its root (no descent),
   guards included."
  [rules form]
  (filter (fn [r] (some? (smell-match r form))) rules))

(defn scan
  "Detect: every smell in `form`, as a list of `{:rule name :at subform}`.
   Walks every node and reports each smell that fires there. Pure — it
   changes nothing, so it is the half a linter or a pre-commit check
   wants: tell me what is here, let me decide."
  [rules form]
  (reduce
    (fn [acc sub]
      (concat acc (map (fn [r] {:rule (:name r) :at sub}) (matches rules sub))))
    (list)
    (subforms form)))

(defn report
  "A `{smell-name → count}` summary of `form` under `rules`. The one-line
   answer to \"how noisy is this?\"."
  [rules form]
  (-> (group-by :rule (scan rules form))
      (update-vals count)))

; --- CORRECT: rewrite the smells away -------------------------------------

(defn- try-smells
  "Apply the first smell in `rules` whose pattern matches `form` and whose
   guard accepts, or `form` unchanged. First match wins; earlier rules
   take precedence."
  [rules form]
  (loop [rules rules]
    (if (empty? rules)
      form
      (let [s (first rules)
            binds (smell-match s form)]
        (if (some? binds)
          (rewrite/subst binds (:replacement s))
          (recur (rest rules)))))))

(defn deodorize-with
  "Correct `form` with an explicit ruleset, to a fixed point (children
   before parents each pass). Guards ride along — a vetoed match is not
   applied. Like `rewrite/apply-rules`, raises rather than hanging if the
   ruleset cycles."
  ([rules form] (deodorize-with rules form 1000))
  ([rules form cap]
   (loop [form form passes 0]
     (let [next (rewrite/postwalk (fn [x] (try-smells rules x)) form)]
       (if (= next form)
         form
         (if (>= passes cap)
           (throw (ex-info "deodorize did not reach a fixed point — the ruleset appears to cycle"
                           {:non-terminating true :passes passes :cap cap}))
           (recur next (inc passes))))))))

(defn deodorize
  "Correct `form` with the default ruleset (safe + idiomatic)."
  [form]
  (deodorize-with (all-rules) form))

; --- the fixer: span-preserving source rewrite ----------------------------
;
; The form-level fns above work on parsed data; the fixer works on TEXT,
; splicing each smelled top-level span and leaving everything else —
; comments, formatting, untouched siblings — byte-for-byte. (A read→print
; codemod would normalize formatting and drop comments; that is inherent
; to form-level work and why the fixer stays at the text level.)

(defn all-spans
  "The `[start end)` codepoint spans of EVERY list form in `src`, nested
   included, ordered by closing paren (inner before outer, left before
   right); `fix-source` reverses them so splicing runs rightmost-first
   and earlier offsets stay valid. A scanner, not a parse: parens inside
   string literals and comments do not count. Codepoint offsets compose
   with String/slice (grapheme-safe for source text, ASCII in practice)."
  [src]
  (let [chars (into [] (String/codepoints src))
        n (count chars)]
    (loop [i 0 stack (list) in-str false in-comment false spans []]
      (if (>= i n)
        spans
        (let [c (get chars i)]
          (cond
            in-comment
              (recur (inc i) stack in-str (not (= c "\n")) spans)

            in-str
              (cond
                (= c "\\") (recur (+ i 2) stack true false spans)
                (= c "\"") (recur (inc i) stack false false spans)
                :else      (recur (inc i) stack true false spans))

            (= c ";")  (recur (inc i) stack false true spans)
            (= c "\"") (recur (inc i) stack true false spans)
            (= c "(")  (recur (inc i) (cons i stack) false false spans)
            (= c ")")  (recur (inc i) (rest stack) false false
                               (conj spans [(first stack) (inc i)]))
            :else      (recur (inc i) stack false false spans)))))))

(defn overlaps?
  "Do [a b) and [x y) intersect? Spans are properly nested or disjoint,
   so any intersection means one contains the other — and the outer's
   text is stale once the inner changed (and vice versa)."
  [a b [x y]]
  (and (< a y) (> b x)))

(defn read-forms
  "Parse source text into a list of top-level forms (native, `list?`-true,
   ready for the matcher). Uses the compiler's data reader, which never
   evaluates."
  [src]
  (BeamLisp.Compiler/read_all_data src))

(defn fix-source
  "Rewrite every smelled subform in source text `src`, returning
   `{:source new-text :changed n}`. Splices at the SMELL's own span, so
   everything else — comments, formatting, the surrounding defn,
   non-smell siblings — survives byte-for-byte. Passes run to a fixed
   point (a rewrite can expose a new smell one level up), and the result
   is re-parsed before returning: the fixer never produces broken
   source."
  [rules src]
  (loop [out src changed 0 passes 0]
    (let [spans (reverse (all-spans out))
          step (fn [acc span]
                 (let [start (first span)
                       end (second span)]
                   (if (some (fn [r] (overlaps? start end r)) (:regions acc))
                     acc
                     (let [text (String/slice (:source acc) start (- end start))
                           form (first (read-forms text))
                           ; splice only a span whose ROOT is a smell —
                           ; never one that merely CONTAINS one, or the
                           ; enclosing defn's text (and its comments)
                           ; would be normalized away.
                           fixed (try-smells rules form)]
                       (if (= fixed form)
                         acc
                         {:source (str (String/slice (:source acc) 0 start)
                                       (pr-str fixed)
                                       (String/slice (:source acc) end
                                                     (- (String/length (:source acc)) end)))
                          :changed (inc (:changed acc))
                          :regions (conj (:regions acc) [start end])})))))
          pass (reduce step {:source out :changed 0 :regions []} spans)]
      (cond
        (= (:changed pass) 0)
          (do (doall (read-forms out))
              {:source out :changed changed})
        (>= passes 100)
          (throw (ex-info "fix-source did not reach a fixed point" {:passes passes}))
        :else
          (recur (:source pass) (+ changed (:changed pass)) (inc passes))))))

(defn fix-file!
  "`fix-source` over a file, writing only when something changed."
  [rules path]
  (let [src (second (File/read path))
        res (fix-source rules src)]
    (when (> (:changed res) 0)
      (File/write path (:source res)))
    res))

; --- SOURCE drivers: form-level batch passes -------------------------------

(defn print-forms
  "Render forms back to source, one top-level form per line."
  [forms]
  (join "\n" (map pr-str forms)))

(defn deodorize-source
  "Correct every top-level form in source text `src`, returning new
   source. NB: form-level — formatting normalizes and comments drop; for
   text-faithful fixing use `fix-source`."
  [rules src]
  (print-forms (map (fn [f] (deodorize-with rules f)) (read-forms src))))

(defn report-source
  "Detect smells across all top-level forms of `src`, merged into one
   `{smell-name → count}` summary."
  [rules src]
  (-> (group-by :rule
                (reduce (fn [acc f] (concat acc (scan rules f)))
                        (list) (read-forms src)))
      (update-vals count)))
