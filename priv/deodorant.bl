; priv/deodorant.bl — smell detection and mechanical correction for
; beam-lisp source, built on the `rewrite` engine.
;
; The problem it solves: an agent (or a person in a hurry) writes the
; *long* spelling of something the language already has a short, exact
; word for — `(if (not p) a b)` where `if-not` exists, `(not (nil? x))`
; where `some?` exists, `(= x 0)` where `zero?` exists. None of these
; are wrong; all of them are noise. Deodorant removes the noise.
;
; The honest contract — the same one `rewrite` makes — is that every
; correction is a `{pattern, replacement}` RULE you can read below. There
; is no model guessing at a fix: the after is exactly the sum of the
; rules, and a reviewer checks each by eye. Deodorant adds nothing to
; `rewrite` except (1) a curated, TIERED ruleset and (2) a detect/report
; half, so a caller can *find* smells without changing anything.
;
; Two tiers, because not every rewrite is equal:
;
;   SAFE      — value-identical for all inputs. `(not (= a b))` is `(not=
;               a b)` no matter what a and b are. Apply blind.
;   IDIOMATIC — value-identical under a mild, near-universal assumption
;               (numeric argument, boolean context). Opt-in, so a caller
;               who rewrites machine-generated numeric code can take them
;               and a caller who cannot guarantee the assumption skips
;               them. This is why the ruleset is data you `concat`, not a
;               switch you flip.
;
; A rule is a plain map — `{:name … :pattern … :replacement …}` — quoted
; so the `?`-vars survive as pattern variables. `:name` is the only thing
; deodorant adds to `rewrite`'s rule shape, and it exists solely so the
; report can say *which* smell it found.
(ns deodorant
  (:require [rewrite]))

; --- SAFE rules: value-identical, apply blind ---------------------------
;
; Ordering matters where patterns overlap. `(if (not ?p) ?a nil)` matches
; both when-not and if-not; `try-rules` is first-match-wins, so the more
; specific `nil`-tailed forms come FIRST and collapse to when/when-not,
; and the general two-branch forms follow. rewrite runs to a fixed point,
; so a form the first pass leaves as `(if-not p a nil)` is not reachable —
; the specific rule already claimed it.

(def when-not-rule
  {:name 'if→when-not :pattern '(if (not ?p) ?a nil) :replacement '(when-not ?p ?a)})
(def when-rule
  {:name 'if→when      :pattern '(if ?p ?a nil)       :replacement '(when ?p ?a)})
(def if-not-rule
  {:name 'if→if-not    :pattern '(if (not ?p) ?a ?b)  :replacement '(if-not ?p ?a ?b)})

(def some-rule
  {:name 'not-nil?→some? :pattern '(not (nil? ?x)) :replacement '(some? ?x)})
(def not-eq-rule
  {:name 'not-=→not=     :pattern '(not (= ?a ?b))  :replacement '(not= ?a ?b)})

; `(= x nil)` and `(= nil x)` both mean `(nil? x)`. Two rules, because the
; matcher is positional and both spellings occur in the wild.
(def nil-eq-rule
  {:name '=-nil→nil?  :pattern '(= ?x nil) :replacement '(nil? ?x)})
(def nil-eq-rule*
  {:name '=-nil→nil?  :pattern '(= nil ?x) :replacement '(nil? ?x)})

; Double-negation and its friends.
(def not-not-rule
  {:name 'not-not→id  :pattern '(not (not ?x)) :replacement '(boolean ?x)})

; `(if p true false)` is `(boolean p)` — the classic "coerce to bool by
; hand" tic. The `true`/`false` literals are matched positionally, so this
; fires only on that exact shape, never on `(if p true x)`.
(def if-bool-rule
  {:name 'if-true-false→boolean :pattern '(if ?p true false) :replacement '(boolean ?p)})

(def safe-rules
  (list when-not-rule when-rule if-not-rule
        some-rule not-eq-rule
        nil-eq-rule nil-eq-rule*
        not-not-rule if-bool-rule))

; --- IDIOMATIC rules: value-identical under a mild assumption -----------
;
; NUMERIC: `(= x 0)` is `(zero? x)` when x is a number — which, at a
; comparison against 0, it always is. Likewise pos?/neg?, inc/dec.
(def zero-rule {:name '=-0→zero?  :pattern '(= ?x 0) :replacement '(zero? ?x)})
(def zero-rule* {:name '=-0→zero? :pattern '(= 0 ?x) :replacement '(zero? ?x)})
(def pos-rule  {:name '>-0→pos?   :pattern '(> ?x 0) :replacement '(pos? ?x)})
(def neg-rule  {:name '<-0→neg?   :pattern '(< ?x 0) :replacement '(neg? ?x)})
(def inc-rule  {:name '+1→inc     :pattern '(+ ?x 1) :replacement '(inc ?x)})
(def inc-rule* {:name '+1→inc     :pattern '(+ 1 ?x) :replacement '(inc ?x)})
(def dec-rule  {:name '-1→dec     :pattern '(- ?x 1) :replacement '(dec ?x)})

; COLLECTION: `(first (rest x))` is `(second x)`. Structural and exact.
; NB: `(first (first x))`→`ffirst` is deliberately NOT a rule — `ffirst`
; is not defined in this runtime, and a rule may only rewrite to a word
; that actually resolves. Every replacement below was runtime-verified.
(def second-rule {:name 'first-rest→second  :pattern '(first (rest ?x))  :replacement '(second ?x)})

(def numeric-rules (list zero-rule zero-rule* pos-rule neg-rule
                         inc-rule inc-rule* dec-rule))
(def collection-rules (list second-rule))
(def idiomatic-rules (concat numeric-rules collection-rules))

; The default ruleset a caller gets from `deodorize`: safe + idiomatic.
; A stricter caller passes `safe-rules` explicitly.
(def all-rules (concat safe-rules idiomatic-rules))

; --- DETECT: find smells without changing anything ----------------------

(defn subforms
  "Every node of `form`, itself included, depth-first. A code form is a
   tree of lists/vectors; this is the flat view the scanner folds over."
  [form]
  (cons form
        (if (or (list? form) (vector? form))
          (reduce (fn [acc x] (concat acc (subforms x))) (list) (seq form))
          (list))))

(defn matches
  "The rules in `rules` whose pattern matches `form` at its root (no
   descent). `rewrite/match?` returns bindings on a hit, nil otherwise."
  [rules form]
  (filter (fn [r] (some? (rewrite/match? (:pattern r) form))) rules))

(defn scan
  "Detect: every smell in `form`, as a list of `{:rule name :at subform}`.
   Walks every node and reports each rule that fires there. Pure — it
   changes nothing, so it is the half a linter or a pre-commit check
   wants: tell me what is here, let me decide."
  [rules form]
  (reduce
    (fn [acc sub]
      (concat acc (map (fn [r] {:rule (:name r) :at sub}) (matches rules sub))))
    (list)
    (subforms form)))

(defn report
  "A `{smell-name → count}` summary of `form` under `rules`. The one-line
   answer to \"how noisy is this?\"."
  [rules form]
  (-> (group-by :rule (scan rules form))
      (update-vals count)))

; --- CORRECT: rewrite the smells away -----------------------------------

(defn deodorize-with
  "Correct `form` with an explicit ruleset, to a fixed point. Thin alias
   over the rewrite engine — the value is the curated ruleset, not this
   fn."
  [rules form]
  (rewrite/apply-rules rules form))

(defn deodorize
  "Correct `form` with the default ruleset (safe + idiomatic)."
  [form]
  (deodorize-with all-rules form))

; --- SOURCE drivers: text in, text out ----------------------------------
;
; The form-level fns above are the realistic agent path: an agent emits a
; form, deodorant cleans it before it lands. These drivers extend that to
; a whole file, for a batch pass or a report. NB: a read→print codemod
; normalizes formatting and DROPS COMMENTS — that is inherent to working
; at the form level, not a bug, and the reason the primary API is per-form.

(defn read-forms
  "Parse source text into a list of top-level forms (native, `list?`-true,
   ready for the matcher). Uses the compiler's data reader, which never
   evaluates."
  [src]
  (BeamLisp.Compiler/read_all_data src))

(defn print-forms
  "Render forms back to source, one top-level form per line."
  [forms]
  (join "\n" (map pr-str forms)))

(defn deodorize-source
  "Correct every top-level form in source text `src`, returning new source.
   `rules` is the ruleset to apply."
  [rules src]
  (print-forms (map (fn [f] (deodorize-with rules f)) (read-forms src))))

(defn report-source
  "Detect smells across all top-level forms of `src`, merged into one
   `{smell-name → count}` summary."
  [rules src]
  (-> (group-by :rule
                (reduce (fn [acc f] (concat acc (scan rules f)))
                        (list) (read-forms src)))
      (update-vals count)))
