; errors.bl — P11: error rendering. The L12 criterion, made code.
;
; Every warning the checker emits — wherever it came from (type
; mismatch, dead branch, deferred constraint, termination, smell
; promotion, purity claim) — renders the same way:
;
;   path/to/file.bl:12:5: argument 1 provably wrong
;     12 │ (greet 42)
;        │        ^^ expects (:string), got (:int)
;
; L12: the user NEVER sees the machine's representations — no
; {:list, …} tuples, no #{:int} sets, no raw tag names. Types print as
; sorted parenthesized lists; positions are the user's own; the
; excerpt is the user's own line with a caret under the offending
; form.

(ns errors
  (:require [typed]))

(defn delaborate
  "A reader node as the SOURCE the user wrote: symbols by name, forms
   re-parenthesized, literals by pr-str. Never a raw tuple. (Widths are
   not preserved — this is a message, not a pretty-printer.)"
  [node]
  (let [f (typed/node-form node)
        t (typed/node-tag f)]
    (cond
      (= t :list)
        (str "(" (join " " (map delaborate (typed/node-items f))) ")")
      (= t :vector)
        (str "[" (join " " (map delaborate (typed/node-items f))) "]")
      (= t :set)
        (str "#{" (join " " (map delaborate (typed/node-items f))) "}")
      (= t :map)
        (str "{" (join " "
                     (map (fn [pair]
                            (let [k (first (erlang/tuple_to_list pair))
                                  v (second (erlang/tuple_to_list pair))]
                              (str (delaborate k) " " (delaborate v))))
                          (typed/node-items f)))
             "}")
      (= t :symbol) (typed/node-name f)
      (= t :keyword) (str ":" (typed/node-name f))
      :else (pr-str f))))

(defn source-line
  "The 1-indexed line of src, or nil."
  [src line]
  (let [ls (split src "\n")]
    (if (and (>= line 1) (<= line (count ls)))
      (nth ls (- line 1))
      nil)))

(defn caret-width
  "How wide the offending form is: from col to the next delimiter on
   the line (positions are starts; ends are not tracked — the token
   boundary is the honest approximation)."
  [text col]
  (let [rest-text (if (<= col (count text)) (subs text col) "")
        delims #{" " "(" ")" "[" "]" "{" "}" "\t"}
        idx (first (filter (fn [i] (contains? delims (subs rest-text i (+ i 1))))
                           (range 0 (count rest-text))))]
    (if (nil? idx) (max 1 (count rest-text)) (max 1 idx))))

(defn render
  "Render warning w {:msg :line :col} against src under file.
   Returns the multi-line string."
  [file src w]
  (let [line (:line w)
        col  (:col w)
        text (source-line src line)]
    (if (nil? text)
      (str file ":" line ":" col ": " (:msg w))
      (let [gutter (str line)
            pad (apply str (repeat (count gutter) " "))
            w0 (max 0 (- col 1))
            width (caret-width text w0)
            carets (apply str (repeat width "^"))]
        (str file ":" line ":" col ": " (:msg w) "\n"
             "  " gutter " │ " text "\n"
             "  " pad " │ " (apply str (repeat w0 " ")) carets)))))

(defn delaborated?
  "L12 as a predicate over RENDERED output: no raw repr markers may
   survive to the user. Returns the first offending marker, or nil."
  [rendered]
  (reduce (fn [_ m] (if (some? (index-of rendered m)) m nil))
          nil ["{:list" "{:symbol" "{:meta" "#{" "tuple"]))

(defn render-all
  "Every warning of a check, rendered in order."
  [file src warnings]
  (apply str (map (fn [w] (str (render file src w) "\n")) warnings)))
