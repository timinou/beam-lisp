; priv/wayland/protocols.bl — the Wayland protocol, as DATA.
;
; ══ WHY TABLES AND NOT CODE ═══════════════════════════════════════════════
;
; Every Wayland binding in the wild code-generates from the protocol XML into
; a language. beam-lisp does not need the generation step: the protocol IS a
; table, a request IS a value, and the conn walks the table. "The request is a
; value" — the same move relay made on HTTP — applied one layer down. A new
; protocol is rows here, not a new binding.
;
; Shape of the table:
;
;   {"interface" {:version  N            ; the version WE bind (spike: minimal)
;                 :requests {op [spec…]}  ; a request's argument specs, in order
;                 :events   {op [spec…]}}}; an event's payload specs
;
; Argument specs: [:u] [:i] [:s] [:fixed] [:obj] [:new-id] [:fd]
;   :new-id — the CALLER passes the :alloc sentinel; conn allocates the id.
;   :fd     — carried by SCM_RIGHTS on the socket, never in the payload.
;   :obj    — object id; 0 is the null object (e.g. "no output").
;
; Only what the bar speaks is tabled. Events whose op is absent from an
; interface's :events are SKIPPED by size (wire's header carries :size), which
; is how wl_output's chatter and wl_shm's format spam cost nothing.

(ns wayland.protocols)

(def ^:private wl-display
  {"wl_display"
   {:requests {0 [[:new-id]]                 ; sync → callback
               1 [[:new-id]]}                ; get_registry → registry
    :events   {0 [[:u]]}}})                  ; delete_id

(def ^:private wl-registry
  {"wl_registry"
   {:requests {0 [[:u] [:s] [:u] [:new-id]]} ; bind name interface version id
    :events   {0 [[:u] [:s] [:u]]             ; global name interface version
               1 [[:u]]}}})                   ; global_remove

(def ^:private wl-callback
  {"wl_callback"
   {:events {0 [[:u]]}}})                    ; done

(def ^:private wl-compositor
  {"wl_compositor"
   {:requests {0 [[:new-id]]}}})             ; create_surface

(def ^:private wl-surface
  {"wl_surface"
   {:requests {0 []                          ; destroy
               1 [[:obj] [:i] [:i]]          ; attach buffer x y
               2 [[:i] [:i] [:i] [:i]]       ; damage x y w h (surface coords)
               3 [[:new-id]]                 ; frame → callback
               6 []                          ; commit
               8 [[:i] [:i] [:i] [:i]]}      ; damage_buffer (v4+; harmless here)
    :events   {0 [[:obj]]                     ; enter
               1 [[:obj]]}}})                 ; leave

(def ^:private wl-shm
  {"wl_shm"
   {:requests {0 [[:new-id] [:fd] [:i]]}     ; create_pool id fd size
    :events   {0 [[:u]]}}})                  ; format

(def ^:private wl-shm-pool
  {"wl_shm_pool"
   {:requests {0 [[:new-id] [:i] [:i] [:i] [:u]] ; create_buffer id off w stride fmt
               1 []}}})                          ; destroy

(def ^:private wl-buffer
  {"wl_buffer"
   {:requests {0 []}                          ; destroy
    :events   {0 []}}})                       ; release (safe to reuse the buffer)

(def ^:private wl-seat
  {"wl_seat"
   {:requests {0 [[:new-id]]}                 ; get_pointer (bind v1)
    :events   {0 [[:u]]}}})                   ; capabilities

(def ^:private wl-pointer
  {"wl_pointer"
   {:events {0 [[:u] [:obj] [:fixed] [:fixed]] ; enter serial surface sx sy
             1 [[:u] [:obj]]                   ; leave
             2 [[:u] [:fixed] [:fixed]]        ; motion
             3 [[:u] [:u] [:u] [:u]]}}})       ; button serial time button state

(def ^:private wl-output
  {"wl_output"
   {:events {}}})                             ; geometry/mode/done — skipped by size

(def ^:private layer-shell
  {"zwlr_layer_shell_v1"
   {:requests {0 [[:new-id] [:obj] [:obj] [:u] [:s]]}}}) ; get_layer_surface
     ; (id surface output layer namespace) — layer: 0 bg, 1 bottom, 2 top, 3 overlay

(def ^:private layer-surface
  {"zwlr_layer_surface_v1"
   {:requests {0 [[:u] [:u]]                  ; set_size w h (0 = use anchors)
               1 [[:u]]                       ; set_anchor (top=1 bottom=2 left=4 right=8)
               2 [[:i]]                       ; set_exclusive_zone
               3 [[:i] [:i] [:i] [:i]]        ; set_margin t b l r
               4 [[:u]]                       ; set_keyboard_interactivity
               6 [[:u]]                       ; ack_configure — MANDATORY pre-commit
               7 []}                          ; destroy
    :events   {0 [[:u] [:i] [:i]]             ; configure serial w h
               1 []}}})                       ; closed

(def table
  (merge wl-display wl-registry wl-callback wl-compositor wl-surface
         wl-shm wl-shm-pool wl-buffer wl-seat wl-pointer wl-output
         layer-shell layer-surface))

(defn interface
  "The interface table for `name`, or nil (an interface we did not mount)."
  [name]
  (get table name))

(defn request-args
  "The arg-spec list for a request, or nil when unknown (the conn then
   refuses to send — fail loud, not wire-garbage)."
  [iface op]
  (get-in (interface iface) [:requests op]))

(defn event-args
  "The arg-spec list for an event, or nil when the event is skipped by size."
  [iface op]
  (get-in (interface iface) [:events op]))

;; ── constants the bar needs (the enums worth naming) ─────────────────

(def layer-top 2)
(def anchor-top 1)
(def anchor-bottom 2)
(def anchor-left 4)
(def anchor-right 8)
(def format-argb8888 0)
(def keyboard-none 0)
(def pointer-btn-state-pressed 1)
