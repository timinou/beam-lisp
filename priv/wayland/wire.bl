; priv/wayland/wire.bl — the Wayland wire codec, as pure functions over bytes.
;
; ══ THE SHAPE OF THE WIRE (verified against live niri, 2026-09-01) ═════════
;
; Every word is LITTLE-ENDIAN. A message is a header word plus a body:
;
;   u32 object-id   u32 (op | (size << 16))   body…
;
; The size counts the WHOLE message (header included), which is why the
; decoder can skip an unknown event without understanding its body — the
; property the conn relies on to ignore protocols it did not mount.
;
; The codec is byte-LIST based: a body is built as a list of ints and
; `iolist_to_binary`'d once at the edge. At bar rates (a few messages per
; frame, frames a few times a second) the list overhead is noise; the win is
; that every function here is total, pure, and `=`-testable against golden
; bytes with no socket at all.
;
; NB one beam-lisp/BEAM shape rule lives here: beam-lisp vectors and lists are
; NOT iodata (a `[…]` is a Vector struct, a `(…)` is a cons). `bytes-of` deep-
; converts with the interop.bl boundary idiom before crossing to Erlang.

(ns wayland.wire)

;; ── encoding: ints → little-endian byte lists ────────────────────────

(defn u16-le
  "A 16-bit word as a 2-byte little-endian list."
  [n]
  [(rem n 256) (rem (quot n 256) 256)])

(defn u32-le
  "A 32-bit word as a 4-byte little-endian list."
  [n]
  [(rem n 256)
   (rem (quot n 256) 256)
   (rem (quot n 65536) 256)
   (rem (quot n 16777216) 256)])

(defn i32-le
  "A signed 32-bit word, two's complement, as a 4-byte little-endian list."
  [n]
  (u32-le (if (< n 0) (+ n 4294967296) n)))

(defn fixed-le
  "A Wayland `fixed` (signed 24.8) as a 4-byte little-endian list."
  [x]
  (i32-le (erlang/trunc (* x 256))))

(defn string-le
  "A Wayland string: u32 length (INCLUDING the NUL), bytes, NUL, pad to 4."
  [s]
  (let [bytes (if (erlang/is_binary s)
                (erlang/binary_to_list s)
                (to-list s))
        len   (inc (count bytes))
        pad   (rem (- 4 (rem len 4)) 4)]
    (concat (u32-le len) bytes [0] (repeat pad 0))))

(defn message
  "Header + body → one byte list. `op` in the LOW half, size in the HIGH half."
  [obj op body-bytes]
  (concat (u32-le obj)
          (u16-le op)
          (u16-le (+ 8 (count body-bytes)))
          body-bytes))

;; ── decoding: byte list + offset → value (and next offset) ───────────
;;
;; Decoders return `[value next-offset]` so a spec-walker composes them
;; without slicing the list at every step.

(defn read-u16 [b i]
  [(+ (nth b i) (* 256 (nth b (inc i)))) (+ i 2)])

(defn read-u32 [b i]
  [(+ (nth b i)
      (* 256 (nth b (inc i)))
      (* 65536 (nth b (+ i 2)))
      (* 16777216 (nth b (+ i 3))))
   (+ i 4)])

(defn read-i32
  "A signed 32-bit word — two's complement folded back to negative."
  [b i]
  (let [[raw next] (read-u32 b i)]
    [(if (>= raw 2147483648) (- raw 4294967296) raw) next]))

(defn read-fixed
  "A Wayland `fixed` (signed 24.8) → a float."
  [b i]
  (let [[raw next] (read-i32 b i)]
    [(/ raw 256.0) next]))

(defn read-string
  "A Wayland string → the binary (NUL and padding dropped)."
  [b i]
  (let [[len next] (read-u32 b i)
        text-len   (dec len)
        text       (erlang/list_to_binary
                     (map (fn [k] (nth b (+ i 4 k))) (range text-len)))
        pad        (rem (- 4 (rem len 4)) 4)]
    [text (+ next (+ len pad))]))

(defn read-header
  "An 8-byte message header → {:obj … :op … :size …}."
  [b]
  (let [[obj i1] (read-u32 b 0)
        [half i2] (read-u16 b i1)
        [size _i3] (read-u16 b i2)]
    {:obj obj :op half :size size}))

(defn- ->iolist
  "beam-lisp vectors AND lists are NOT iodata — a `[…]` is a Vector struct,
   a `(…)` may be a cons or a LAZY seq; iolist_to_binary accepts proper
   ERLANG lists and binaries only. Total deep-convert: binaries and ints
   pass, everything seqable recurses through Enum/to_list (the interop.bl
   boundary idiom), atoms fail loud at the Erlang edge."
  [x]
  (cond
    (erlang/is_binary x) x
    (erlang/is_integer x) x
    :else (Enum/to_list (Enum/map (Enum/to_list x) ->iolist))))

(defn bytes-of
  "A byte list (or iolist of lists, vectors and binaries) → one binary."
  [parts]
  (erlang/apply :erlang :iolist_to_binary (list (->iolist parts))))

(defn bin->bytes
  "A binary → a list of ints (the decoder's preferred input shape)."
  [b]
  (erlang/binary_to_list b))

(defn argb
  "Pack a premultiplied ARGB colour into one u32 — the pixel format of
   every frame this stack writes (WL_SHM_FORMAT_ARGB8888)."
  [a r g b]
  (+ (* a 16777216) (* r 65536) (* g 256) b))
