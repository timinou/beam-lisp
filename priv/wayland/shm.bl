; priv/wayland/shm.bl — the one native seam of the whole bar.
;
; The BEAM can pass an fd over the Wayland socket (:socket.sendmsg +
; SCM_RIGHTS, verified OTP 29) and can build megabyte frames as iodata — but
; it can neither create an anonymous memfd nor pwrite at an offset into an
; integer fd. Those two syscalls are the ENTIRE native surface of a
; pure-beam-lisp Wayland client; everything else above them is .bl.
;
; One crate, one namespace (native.ex's rule): wayland_shm hosts here, its
; rustler::init! names Elixir.BeamLisp.Native.Wayland.Shm. The same seam
; shape datom's Rust backends use — "what the VM cannot say", wrapped in the
; thinnest possible crate.

(ns wayland.shm)

(defnative "wayland_shm"
  (pool-new 1)      ; (bytes)                  -> fd      memfd_create + ftruncate
  (pool-write 3)    ; (fd offset binary)       -> :ok     pwrite, partial-write loop
  (pool-close 1))   ; (fd)                     -> :ok
