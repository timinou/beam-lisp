; priv/wayland/conn.bl — the connection: one socket, the protocol as data,
; events projected into the conn map (the spike's "database").
;
; ══ THE SHAPE ═════════════════════════════════════════════════════════════
;
; A conn is an IMMUTABLE map threaded through every call:
;
;   {:socket     the :socket NIF handle
;    :next-id    the client-side object-id allocator
;    :objects    {id → interface-name}                 what we bound
;    :handlers   {id → (fn [conn op args] conn')}      per-object event fns
;    :globals    ({:name :interface :version} …)       from the registry
;    :db         whatever the bar stores (the facts the view projects)}
;
; There is no gen_server, no mailbox, no state-machine library: the conn map
; IS the state, `pump` is the event loop, handlers are pure conn -> conn
; functions. That makes the whole client trivially replayable — the client-
; side twin of live's "the click does not render the screen": here the
; Wayland event does not mutate anything either; it lands in the conn map and
; the render fn projects from it.
;
; Requests are values: (request c obj op args) looks the arg spec up in
; protocols.bl, encodes, allocates :new-id slots (the :alloc sentinel), and —
; for the ONE message kind that needs it (wl_shm.create_pool) — passes the fd
; over SCM_RIGHTS with :socket.sendmsg. Verified on this host, OTP 29: the
; compositor receives the fd.
;
; Failures to send are crashes on purpose (let it crash; the supervisor is
; the restart strategy). `pump` reports :timeout/:closed as VALUES — those
; are expected states of the loop, not errors.

(ns wayland.conn
  (:require [wayland.wire :as wire]
            [wayland.protocols :as proto]))

(def ^:private CTRL-LEVEL-SOL-SOCKET 1)
(def ^:private CTRL-TYPE-SCM-RIGHTS 1)

;; ── the display socket ───────────────────────────────────────────────

(defn- env
  "An environment variable as a binary, or nil. Elixir's System/get_env
   returns nil — which can surface here as nil OR the :nil atom, so both
   spellings of absence close."
  [k]
  (let [v (System/get_env k)]
    (if (or (nil? v) (= v :nil)) nil v)))

(defn socket-path
  "The Wayland display socket: $WAYLAND_DISPLAY is either an absolute path
   (used as-is) or a name joined onto $XDG_RUNTIME_DIR. nil = no session."
  []
  (let [wd (env "WAYLAND_DISPLAY")
        xdg (env "XDG_RUNTIME_DIR")]
    (cond
      (nil? wd) nil
      (String/starts_with? wd "/") wd
      (nil? xdg) nil
      :else (Path/join xdg wd))))

(defn connect!
  "Open the display socket → {:ok conn} | {:error msg}. The conn carries the
   object table, the id allocator, and an empty :db for the bar's facts."
  []
  (let [path (socket-path)]
    (if (nil? path)
      {:error "no WAYLAND_DISPLAY — not a Wayland session"}
      (let [op (erlang/apply :socket :open (list :local :stream))]
        (if (not= :ok (erlang/element 1 op))
          {:error (str "socket open failed: " (pr-str (erlang/element 2 op)))}
          (let [s (erlang/element 2 op)
                oc (erlang/apply :socket :connect
                                 (list s {:family :local :path path}))]
            (if (not= :ok oc)
              {:error (str "connect failed: " (pr-str oc))}
              {:ok {:socket s :next-id 2
                    :objects {1 "wl_display"}
                    :handlers {}
                    :globals []
                    :db {}}})))))))

;; ── object bookkeeping ───────────────────────────────────────────────

(defn- alloc-id
  "Allocate the next client-side object id → [id conn']."
  [c]
  (let [id (:next-id c)]
    [id (assoc c :next-id (inc id))]))

(defn mount!
  "Track a bound object and attach its event handler. The handler is a pure
   (conn, op, args) → conn function — the projection of the object's events
   into the conn map."
  [c id iface handler]
  (-> c
      (assoc-in [:objects id] iface)
      (assoc-in [:handlers id] handler)))

(defn track!
  "Track a bound object with no handler (its events are skipped by size)."
  [c id iface]
  (assoc-in c [:objects id] iface))

;; ── requests: encode + send ──────────────────────────────────────────

(defn- encode-args
  "Walk the arg spec and the caller's values together → [payload fd]. A
   :new-id slot reads its id from `id`; an :fd slot routes the value to the
   SCM_RIGHTS control data instead of the payload."
  [spec vs id]
  (let [sp (to-list spec)
        vv (to-list vs)]
    (loop [sp sp vv vv acc [] fd nil]
      (if (empty? sp)
        [acc fd]
        (let [kind (first (first sp))
              v (first vv)
              acc2 (cond
                     (= v :alloc) (concat acc (wire/u32-le id))
                     (= kind :u) (concat acc (wire/u32-le v))
                     (= kind :i) (concat acc (wire/i32-le v))
                     (= kind :obj) (concat acc (wire/u32-le v))
                     (= kind :fixed) (concat acc (wire/fixed-le v))
                     (= kind :s) (concat acc (wire/string-le v))
                     (= kind :fd) acc
                     :else (concat acc (wire/u32-le v)))
              fd2 (if (= kind :fd) v fd)]
          (recur (rest sp) (rest vv) acc2 fd2))))))

(defn- transmit
  "Bytes + optional fd → the socket. The fd rides SCM_RIGHTS control data
   (numeric level/type — the socket NIF rejects the atom spellings)."
  [sock bytes fd]
  (let [bin (wire/bytes-of bytes)]
    (if (nil? fd)
      (erlang/apply :socket :send (list sock bin))
      (erlang/apply :socket :sendmsg
                    (list sock
                          {:iov (list bin)
                           :ctrl (list {:level CTRL-LEVEL-SOL-SOCKET
                                        :type CTRL-TYPE-SCM-RIGHTS
                                        ; OTP carries the fd ONLY when :data is a
                                        ; native-endian 32-bit BINARY — a [fd] list
                                        ; sends the cmsg but drops the fd (verified
                                        ; via recvmsg round-trip). u32-le = native on x86.
                                        :data (wire/bytes-of (wire/u32-le fd))})})))))

(defn request
  "Send a request → [conn' new-id-or-nil]. `args` aligns with the spec from
   protocols.bl; the :alloc sentinel claims a fresh object id. Unknown
   request = crash (a typo in a table is a bug, not a condition)."
  [c obj op args]
  (let [iface (get (:objects c) obj)
        spec (proto/request-args iface op)]
    (if (nil? spec)
      (erlang/error (str "no request spec for " iface " op " op))
      (let [allocs? (some (fn [v] (= v :alloc)) (to-list args))
            [id c1] (if allocs? (alloc-id c) [nil c])
            [payload fd] (encode-args spec args id)
            body (wire/message obj op payload)
            r (transmit (:socket c1) body fd)]
        (if (not= :ok r)
          (erlang/error (str "send failed: " (pr-str r)))
          [c1 id])))))

;; ── events: decode + dispatch ────────────────────────────────────────

(defn- decode-args
  "Walk an event's arg spec over the payload bytes → a vector of values."
  [spec bytes]
  (loop [sp (to-list spec) i 0 acc []]
    (if (empty? sp)
      acc
      (let [kind (first (first sp))
            step (cond
                   (= kind :u) (wire/read-u32 bytes i)
                   (= kind :i) (wire/read-i32 bytes i)
                   (= kind :s) (wire/read-string bytes i)
                   (= kind :fixed) (wire/read-fixed bytes i)
                   (= kind :obj) (wire/read-u32 bytes i)
                   (= kind :new-id) (wire/read-u32 bytes i)
                   :else [(nth bytes i) (inc i)])
            val (nth step 0)
            nxt (nth step 1)]
        (recur (rest sp) nxt (conj acc val))))))

(defn pump
  "Read ONE message from the socket → [:event conn] | [:timeout conn] |
   [:closed conn]. Known events dispatch to their object's handler; unknown
   events (an interface or op we did not mount) are skipped by size — the
   header's :size is all the skip needs."
  [c timeout-ms]
  (let [r (erlang/apply :socket :recv (list (:socket c) 8 timeout-ms))]
    (if (not= :ok (erlang/element 1 r))
      (if (= :timeout (erlang/element 2 r))
        [:timeout c]
        [:closed c])
      (let [hdr (wire/read-header (wire/bin->bytes (erlang/element 2 r)))
            body-len (- (:size hdr) 8)
            bytes (if (> body-len 0)
                    (let [rb (erlang/apply :socket :recv (list (:socket c) body-len timeout-ms))]
                      (if (= :ok (erlang/element 1 rb))
                        (let [v (erlang/element 2 rb)]
                          (if (erlang/is_binary v) (wire/bin->bytes v) v))
                        []))
                    [])
            obj (:obj hdr)
            iface (get (:objects c) obj)
            spec (if iface (proto/event-args iface (:op hdr)) nil)
            c2 (if (and iface spec)
                 (let [h (get (:handlers c) obj)
                       args (decode-args spec bytes)]
                   (if h (h c (:op hdr) args) c))
                 c)]
        [:event c2]))))

;; ── the registry ─────────────────────────────────────────────────────

(defn get-registry!
  "Send get_registry and mount the collector. Globals land in :globals as
   {:name :interface :version} maps — call `roundtrip` to drain them."
  [c]
  (let [[c1 reg] (request c 1 1 [:alloc])
        c2 (mount! c1 reg "wl_registry"
                   (fn [c op args]
                     (if (= op 0)
                       (let [vs (to-list args)
                             g {:name (nth vs 0) :interface (nth vs 1) :version (nth vs 2)}]
                         (assoc c :globals (cons g (:globals c))))
                       c)))]
    [c2 reg]))

(defn roundtrip
  "wl_display.sync + drain until the callback fires — the barrier that makes
   the registry (and any prior request) visible to the compositor's replies."
  [c]
  (let [[c1 cb] (request c 1 0 [:alloc])
        c2 (mount! c1 cb "wl_callback"
                   (fn [c _op _args] (assoc c :sync-done true)))]
    (loop [c3 c2]
      (if (:sync-done c3)
        (dissoc c3 :sync-done)
        (let [[kind c4] (pump c3 1000)]
          (if (= kind :event)
            (recur c4)
            (erlang/error (str "roundtrip stalled: " kind))))))))

(defn bind!
  "Bind a global by interface name at the table's version (or the global's,
   whichever is lower) → [conn' object-id]. Crash when absent: a bar on a
   compositor without layer-shell is not a degraded bar, it is no bar."
  [c iface-name]
  (let [g (first (filter (fn [g] (= (:interface g) iface-name)) (:globals c)))
        tab (proto/interface iface-name)]
    (if (nil? g)
      (erlang/error (str "compositor does not advertise " iface-name))
      (let [want (if (map? tab) (get tab :version 1) 1)
            ver (if (> (:version g) want) want (:version g))
            [c1 id] (request c 2 0 [(:name g) iface-name ver :alloc])]
        [(track! c1 id iface-name) id]))))

;; ── the display's own bookkeeping (delete_id keeps the table honest) ─

(defn- display-handler
  "wl_display events: op 0 error(object,code,message) — a protocol fault the
   compositor is about to disconnect on; surface it loudly. op 1 delete_id —
   the compositor retires an id; drop it so the object map stays honest."
  [c op args]
  (cond
    (= op 0)
    (let [vs (to-list args)
          obj (nth vs 0)
          code (nth vs 1)
          msg (nth vs 2)]
      (println (str "✗ wl_display.error obj=" obj " code=" code " — " msg))
      (assoc c :protocol-error {:object obj :code code :message msg} :closed true))
    (= op 1)
    (let [id (nth (to-list args) 0)]
      (-> c
          (update-in [:objects] dissoc id)
          (update-in [:handlers] dissoc id)))
    :else c))

(defn prime!
  "Register the display handler and collect the registry. Call once after
   connect!: → [conn' registry-id]."
  [c]
  (let [c1 (mount! c 1 "wl_display" display-handler)
        [c2 reg] (get-registry! c1)]
    [c2 reg]))
