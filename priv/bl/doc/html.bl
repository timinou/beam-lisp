; bl/doc/html.bl — a livebook, rendered to a static HTML page.
;
; The build verb: `bl doc build docs/ --out site/`. Each document becomes one
; .html file whose bytes are the SAME hiccup the live layer renders — prose
; as sections, cells as anchored code blocks, results embedded where they
; belong. No JavaScript, no server: the progressive-enhancement floor,
; standing alone.
;
; The prose renderer is deliberately a SUBSET, in both dialects: markdown
; gets headings, paragraphs, lists, quotes, rules, tables, fenced code and
; inline code/bold/italic/links; org gets headings, lists, literal lines,
; example blocks and paragraphs. Unknown syntax renders as plain text, never
; swallowed — a subset that degrades honestly beats a parser that lies.

(ns bl.doc.html
  (:require [live.hiccup :as h]
            [bl.doc :as doc]))

;; ── line helpers ──────────────────────────────────────────────────────

(defn- slice-rng
  "lines i..(end-1), forward, as a list."
  [lines i end]
  (loop [k (dec end), acc (list)]
    (if (< k i)
      acc
      (recur (dec k) (cons (nth lines k) acc)))))

(defn- leading-runs
  "How many `ch` characters start the trimmed line."
  [t ch]
  (loop [i 0]
    (cond
      (>= i (count t)) i
      (= (subs t i (inc i)) ch) (recur (inc i))
      :else i)))

(defn- md-heading?
  [t]
  (let [k (leading-runs t "#")]
    (and (>= k 1)
         (<= k 6)
         (or (= (count t) k) (= (subs t k (inc k)) " ")))))

(defn- org-heading?
  [t]
  (let [k (leading-runs t "*")]
    (and (>= k 1)
         (<= k 8)
         (or (= (count t) k) (= (subs t k (inc k)) " ")))))

(defn- digit-start?
  [t]
  (and (not (blank? t))
       (not (nil? (index-of "0123456789" (subs t 0 1))))))

(defn- digit-list?
  [t]
  (and (digit-start? t) (includes? t ". ")))

(defn- para-breaks?
  "True when a line opens a block (ends a markdown paragraph)."
  [t]
  (or (blank? t)
      (md-heading? t)
      (starts-with? t "- ")
      (starts-with? t "* ")
      (starts-with? t ">")
      (starts-with? t "|")
      (digit-list? t)
      (= t "---")
      (= t "***")))

;; ── inline markdown → hiccup nodes ───────────────────────────────────

(defn- token-at
  "The inline token opening at index `at`, as a map with :kind, :content
   and :resume, or nil when unterminated."
  [s at]
  (let [c (subs s at (inc at))]
    (cond
      (= c "`")
      (let [close (index-of (subs s (inc at) (count s)) "`")]
        (if (nil? close)
          nil
          {:kind :code :content (subs s (inc at) (+ (inc at) close))
           :resume (+ at close 2)}))

      (= c "*")
      (if (and (< (inc at) (count s)) (= (subs s (+ at 1) (+ at 2)) "*"))
        (let [from (+ at 2)
              close (index-of (subs s from (count s)) "**")]
          (if (nil? close)
            nil
            {:kind :bold :content (subs s from (+ from close))
             :resume (+ from close 2)}))
        (let [close (index-of (subs s (inc at) (count s)) "*")]
          (if (nil? close)
            nil
            {:kind :em :content (subs s (inc at) (+ (inc at) close))
             :resume (+ at close 2)})))

      (= c "[")
      (let [close-br (index-of (subs s at (count s)) "]")]
        (if (nil? close-br)
          nil
          (let [after (subs s (+ at close-br) (count s))
                close-par (index-of after ")")]
            (if (or (not (starts-with? after "](")) (nil? close-par))
              nil
              {:kind :link
               :label (subs s (inc at) (+ at close-br))
               :url (subs after 2 close-par)
               :resume (+ at close-br close-par 1)}))))

      :else nil)))

(defn- token-node
  [tok]
  (cond
    (= :code (:kind tok)) [:code (:content tok)]
    (= :bold (:kind tok)) [:strong (:content tok)]
    (= :em (:kind tok)) [:em (:content tok)]
    :else [:a {:href (:url tok)} (:label tok)]))

(defn- inline-nodes
  "One line's inline markup as a VECTOR of hiccup nodes."
  [s]
  (loop [i 0, out (list)]
    (cond
      (>= i (count s))
      (reverse out)

      (not (contains? #{"`" "[" "*"} (subs s i (inc i))))
      (recur (inc i) (cons (subs s i (inc i)) out))

      :else
      (let [tok (token-at s i)]
        (if (nil? tok)
          (recur (inc i) (cons (subs s i (inc i)) out))
          (recur (get-in tok [:resume])
                 (cons (token-node tok) out)))))))

;; ── org blocks → hiccup ──────────────────────────────────────────────

(defn- org-list-end
  [lines i n]
  (loop [k i]
    (if (or (>= k n) (not (starts-with? (trim (nth lines k)) "- ")))
      k
      (recur (inc k)))))

(defn- literal-end
  [lines i n]
  (loop [k i]
    (if (or (>= k n) (not (starts-with? (trim (nth lines k)) ": ")))
      k
      (recur (inc k)))))

(defn- example-end
  [lines i n]
  (loop [k i]
    (if (or (>= k n) (starts-with? (trim (nth lines k)) "#+end_example"))
      k
      (recur (inc k)))))

(defn- org-para-end
  [lines i n]
  (loop [k i]
    (if (or (>= k n)
            (let [tk (trim (nth lines k))]
              (or (blank? tk)
                  (org-heading? tk)
                  (starts-with? tk "- ")
                  (starts-with? tk ": ")
                  (starts-with? tk "#+"))))
      k
      (recur (inc k)))))

(defn- org-list
  [lines i end]
  [:ul (map (fn [l]
              (let [tk (trim l)]
                [:li (inline-nodes (subs tk 2 (count tk)))]))
            (slice-rng lines i end))])

(defn- org-literal
  [lines i end]
  [:pre [:code (join "\n" (map (fn [l]
                                 (let [tk (trim l)]
                                   (subs tk 2 (count tk))))
                               (slice-rng lines i end)))]])

(defn- org-example
  [lines i end]
  [:pre [:code (join "\n" (slice-rng lines (inc i) end))]])

(defn- org-blocks
  "Prose lines (org) → a vector of hiccup blocks."
  [lines]
  (let [n (count lines)]
    (loop [i 0, out []]
      (if (>= i n)
        out
        (let [line (nth lines i)
              t (trim line)]
          (cond
            (blank? t)
            (recur (inc i) out)

            (org-heading? t)
            (recur (inc i)
                   (conj out [(keyword (str "h" (min 6 (leading-runs t "*"))))
                              (inline-nodes (trim (subs t (leading-runs t "*") (count t))))]))

            (starts-with? t "- ")
            (let [end (org-list-end lines i n)]
              (recur end (conj out (org-list lines i end))))

            (starts-with? t ": ")
            (let [end (literal-end lines i n)]
              (recur end (conj out (org-literal lines i end))))

            (starts-with? t "#+begin_example")
            (let [end (example-end lines i n)]
              (recur (inc end) (conj out (org-example lines i end))))

            :else
            (let [end (org-para-end lines i n)]
              (recur end (conj out [:p (inline-nodes (join " " (map trim (slice-rng lines i end))))])))))))))

;; ── markdown blocks → hiccup ─────────────────────────────────────────

(defn- md-table
  "A | table's lines → a table node. The |---| separator row is dropped."
  [rows]
  (let [cells (fn [line]
                (let [t (trim line)
                      t (if (starts-with? t "|") (subs t 1 (count t)) t)
                      t (if (ends-with? t "|") (subs t 0 (dec (count t))) t)]
                  (map trim (split t "|"))))
        parsed (map cells rows)
        body (filter (fn [r] (not (includes? (join "|" r) "---"))) parsed)
        header (first body)
        rest (rest body)]
    [:table
     [:thead (map (fn [c] [:th (inline-nodes c)]) header)]
     [:tbody
      (map (fn [r] [:tr (map (fn [c] [:td (inline-nodes c)]) r)]) rest)]]))

(defn- md-quote-end
  [lines i n]
  (loop [k i]
    (if (or (>= k n) (not (starts-with? (trim (nth lines k)) ">")))
      k
      (recur (inc k)))))

(defn- md-quote
  [lines i end]
  (let [texts (map (fn [l]
                     (let [q (trim l)]
                       (trim (subs q 1 (count q)))))
                   (slice-rng lines i end))]
    [:blockquote [:p (inline-nodes (join " " texts))]]))

(defn- md-list-end
  [lines i n]
  (loop [k i]
    (if (or (>= k n)
            (let [tk (trim (nth lines k))]
              (not (or (starts-with? tk "- ")
                       (starts-with? tk "* ")
                       (digit-list? tk)))))
      k
      (recur (inc k)))))

(defn- md-item-text
  [l]
  (let [tk (trim l)]
    (cond
      (starts-with? tk "- ") (subs tk 2 (count tk))
      (starts-with? tk "* ") (subs tk 2 (count tk))
      :else
      (let [dot (index-of tk ". ")]
        (if (nil? dot)
          tk
          (subs tk (+ dot 2) (count tk)))))))

(defn- md-list
  [lines i end ordered?]
  (let [items (map (fn [l] [:li (inline-nodes (md-item-text l))])
                   (slice-rng lines i end))]
    (if ordered?
      [:ol items]
      [:ul items])))

(defn- md-table-end
  [lines i n]
  (loop [k i]
    (if (or (>= k n) (not (starts-with? (trim (nth lines k)) "|")))
      k
      (recur (inc k)))))

(defn- md-para-end
  [lines i n]
  (loop [k i]
    (if (or (>= k n) (para-breaks? (trim (nth lines k))))
      k
      (recur (inc k)))))

(defn- md-blocks
  "Prose lines (markdown) → a vector of hiccup blocks."
  [lines]
  (let [n (count lines)]
    (loop [i 0, out []]
      (if (>= i n)
        out
        (let [line (nth lines i)
              t (trim line)]
          (cond
            (blank? t)
            (recur (inc i) out)

            (md-heading? t)
            (recur (inc i)
                   (conj out [(keyword (str "h" (leading-runs t "#")))
                              (inline-nodes (trim (subs t (leading-runs t "#") (count t))))]))

            (or (= t "---") (= t "***"))
            (recur (inc i) (conj out [:hr]))

            (starts-with? t ">")
            (let [end (md-quote-end lines i n)]
              (recur end (conj out (md-quote lines i end))))

            (or (starts-with? t "- ") (starts-with? t "* ") (digit-list? t))
            (let [end (md-list-end lines i n)
                  ordered? (not (or (starts-with? t "- ") (starts-with? t "* ")))]
              (recur end (conj out (md-list lines i end ordered?))))

            (starts-with? t "|")
            (let [end (md-table-end lines i n)]
              (recur end (conj out (md-table (slice-rng lines i end)))))

            :else
            (let [end (md-para-end lines i n)]
              (recur end (conj out [:p (inline-nodes (join " " (map trim (slice-rng lines i end))))])))))))))

(defn- cell-block
  [cell]
  [:section {:id (str "cell-" (:id cell)) :class "bl-cell"}
   [:pre [:code {:class "language-beam-lisp"}
          (doc/cell-source cell)]]])

(defn- result-text
  "A stored result span's text, per dialect."
  [span]
  (if (= :org (:format span))
    (join "\n" (map (fn [l]
                       (let [t (trim l)]
                         (if (starts-with? t ": ")
                           (subs t 2 (count t))
                           t)))
                     (rest (:lines span))))
    (join "\n" (rest (butlast (:lines span))))))

(defn- code-block
  [lang body]
  [:pre [:code {:class (str "language-" lang)} body]])

(defn- prose-block
  "A :prose span → its dialect's hiccup blocks (a vector)."
  [span]
  (if (= :org (:format span))
    (org-blocks (:lines span))
    (md-blocks (:lines span))))

(def stylesheet
  "The page CSS: one style block, no build step, no dependencies."
  "body{font:16px/1.65 Georgia,serif;margin:0;color:#1a1a1a} main{max-width:44rem;margin:0 auto;padding:2rem 1rem 6rem} h1,h2,h3,h4{font-family:Helvetica,Arial,sans-serif;line-height:1.25;margin:2.2rem 0 .7rem} h1{font-size:1.9rem} h2{font-size:1.45rem} h3{font-size:1.15rem} pre{background:#f6f4ef;border:1px solid #e5e1d8;border-radius:6px;padding:.8rem 1rem;overflow-x:auto;font-size:.85rem;line-height:1.5} code{font-family:ui-monospace,Menlo,monospace} p code,li code,td code,th code{background:#f6f4ef;border:1px solid #e5e1d8;border-radius:3px;padding:0 .25em;font-size:.85em} .bl-cell{margin:1rem 0} .bl-result pre{background:#eef7ee;border-color:#cde8cd} blockquote{border-left:3px solid #e5e1d8;margin:1rem 0;padding:.1rem 1rem;color:#555} table{border-collapse:collapse;margin:1rem 0;font-size:.92rem} th,td{border:1px solid #e5e1d8;padding:.35rem .7rem;text-align:left} th{background:#f6f4ef} hr{border:none;border-top:1px solid #e5e1d8;margin:2rem 0} a{color:#0a5}")

(defn- doc-title
  [doc]
  (loop [spans (:spans doc)]
    (if (empty? spans)
      nil
      (let [sp (first spans)]
        (if (not= :prose (:kind sp))
          (recur (rest spans))
          (loop [ls (:lines sp)]
            (cond
              (empty? ls) nil
              (md-heading? (trim (first ls)))
              (let [t (trim (first ls))]
                (trim (subs t (leading-runs t "#") (count t))))
              (org-heading? (trim (first ls)))
              (let [t (trim (first ls))]
                (trim (subs t (leading-runs t "*") (count t))))
              :else (recur (rest ls)))))))))

(defn page
  "The document plus fresh {id → result-string} → full HTML. A cell shows
   its stored result span when it has one (frozen cells always do), else
   the fresh run result, else nothing."
  [doc results]
  (let [title (or (:ns doc) (doc-title doc) "beam-lisp livebook")
        blocks (loop [spans (:spans doc), acc []]
                 (if (empty? spans)
                   acc
                   (let [sp (first spans)
                         k (:kind sp)]
                     (cond
                       (= k :prose)
                       (recur (rest spans) (into acc (prose-block sp)))

                       (= k :prose-code)
                       (recur (rest spans)
                              (conj acc (code-block (:lang sp)
                                                    (join "\n" (rest (butlast (:lines sp)))))))

                       (= k :cell)
                       (let [nxt (first (rest spans))
                             stored (if (and (= :result (:kind nxt)) (= (:id nxt) (:id sp)))
                                      nxt
                                      nil)
                             rest-spans (if (nil? stored) (rest spans) (rest (rest spans)))
                             value (if (nil? stored)
                                     (get results (:id sp))
                                     (result-text stored))
                             acc2 (conj acc (cell-block sp))
                             acc3 (if (nil? value)
                                    acc2
                                    (conj acc2 [:div {:class "bl-result"} [:pre value]]))]
                         (recur rest-spans acc3))

                       (= k :result)
                       (recur (rest spans)
                              (conj acc [:div {:class "bl-result"} [:pre (result-text sp)]]))

                       :else
                       (recur (rest spans) acc)))))]
    (h/hiccup->html
      [:html {:lang "en"}
       [:head
        [:meta {:charset "utf-8"}]
        [:title title]
        [:style stylesheet]]
       [:body [:main blocks]]])))

(defn- stem
  [path]
  (loop [b (last (split path "/"))]
    (cond
      (ends-with? b ".md") (recur (subs b 0 (- (count b) 3)))
      (ends-with? b ".org") (recur (subs b 0 (- (count b) 4)))
      (ends-with? b ".bl") (recur (subs b 0 (- (count b) 3)))
      :else b)))

(defn build-file
  "Slice a document, run its live cells, render the page, write
   <out-dir>/<stem>.html. Returns a summary map."
  [path out-dir]
  (let [sr (doc/slice-doc path)]
    (if (contains? sr :error)
      {:path path :error (:error sr)}
      (let [d (:ok sr)
            r (doc/run-doc d)
            out (Path/join out-dir (str (stem path) ".html"))]
        (File/mkdir_p out-dir)
        (File/write out (page d (:results r)))
        {:path out :source path :cells (count (doc/cells d)) :errors (:errors r)}))))

(defn collect-docs
  "Every .bl.md / .bl.org under a file-or-dir target, as a list of paths."
  [target]
  (cond
    (File/regular? target)
    (if (or (ends-with? target ".bl.md") (ends-with? target ".bl.org"))
      [target]
      [])

    (File/dir? target)
    (->> (File/ls! target)
         (filter (fn [nm] (not (starts-with? nm "."))))
         (sort-by identity)
         (map (fn [nm] (str target "/" nm)))
         (mapcat collect-docs))

    :else []))
