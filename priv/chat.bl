; priv/chat.bl — the chat interface, as ONE term.
;
; This is the deliverable: a `defcontract` declaring the seam and a `defview`
; declaring the page, from which BOTH halves are emitted. The two cannot
; disagree, because there is one source.
;
; ── reading it ──────────────────────────────────────────────────────────────
;
; `@name` crosses the seam. It is one name resolved per runtime —
; `socket.assigns.name` on the BEAM, `$name` in Spacetime — and which is which
; is the framework's problem, never the author's.
;
; A binding NOT declared in the contract is page-local: `@draft` lives only in
; the browser and the server never hears about it. That is the definition of
; "shared", not a separate annotation to keep in sync.
;
; `(ok …)` / `(err …)` are the correlated one-shot reply, kept distinct from the
; broadcast assign diff that `set!` implies. They are also literals in a tree,
; which is what lets `reply-tags` enumerate them and verse reject a page missing
; an arm — the check FUP-143 records as impossible from Elixir.

(ns chat
  (:require [contract :refer [parse parse-view contract-json-with-replies
                              edn-document view-document module-name]]))

;; ── the seam ────────────────────────────────────────────────────────────────

(def contract-term
  (parse :chat-live
         {:bundle "/spacetime/chat/spacetime.js" :root ".chat"}
         (list
           ;; Server-owned state. `messages` is the transcript; `status` tells
           ;; the page whether a turn is in flight so it can show the indicator
           ;; without guessing from message counts.
           (quote (assign @messages :list))
           (quote (assign @status :atom))

           ;; Transient effects. A token is NOT an assign: pushing the whole
           ;; transcript on every token would send the conversation once per
           ;; word. The page appends deltas locally and the assign carries the
           ;; settled message.
           (quote (push @token {:id :string :text :string}))
           (quote (push @failed {:id :string :reason :string}))

           ;; The one intent the page fires. Both reply paths are LITERAL, so
           ;; the emitted page necessarily decodes both.
           (quote (on :send
                    (if (blank? @draft)
                      (err "Say something first")
                      (do (set! @status :thinking)
                          (ok "accepted"))))))))

;; ── the page ────────────────────────────────────────────────────────────────

(def view-term
  (parse-view
    :chat-view
    (list
      ;; markup NESTS: a DOM is a tree.
      (quote
        (markup
          (template &bubble [$m]
            "<article class='bubble' data-role={@m.role}><p class='bubble__text'>{@m.text}</p></article>")
          (template &thinking []
            "<div class='thinking'><span></span><span></span><span></span></div>")))

      ;; style is FLAT and keyed by selector: one rule may hit many templates.
      (quote
        (style
          [".chat" {:display "grid"
                    :grid-template-rows "1fr auto"
                    :height "100dvh"
                    :max-width "48rem"
                    :margin "0 auto"
                    :background "#0b0d14"
                    :color "#e8eaf2"
                    :font-family "Inter, ui-sans-serif, system-ui, sans-serif"}]
          [".log" {:overflow-y "auto"
                   :display "flex"
                   :flex-direction "column"
                   :gap "0.75rem"
                   :padding "1.5rem"}]
          [".bubble" {:padding "0.75rem 1rem"
                      :border-radius "1rem"
                      :max-width "80%"
                      :white-space "pre-wrap"
                      :line-height "1.5"}]
          [".bubble[data-role='user']" {:align-self "flex-end"
                                        :background "#2b4c8c"}]
          [".bubble[data-role='model']" {:align-self "flex-start"
                                         :background "#1b2030"}]
          [".composer" {:display "flex"
                        :gap "0.5rem"
                        :padding "1rem"
                        :border-top "1px solid rgba(255,255,255,0.08)"}]
          [".composer__input" {:flex "1"
                               :padding "0.75rem 1rem"
                               :border-radius "0.75rem"
                               :border "1px solid rgba(255,255,255,0.12)"
                               :background "#141824"
                               :color "#e8eaf2"}]
          [".composer__send" {:padding "0.75rem 1.25rem"
                              :border-radius "0.75rem"
                              :border "0"
                              :background "#3b6fd4"
                              :color "#fff"
                              :cursor "pointer"}]
          [".thinking" {:align-self "flex-start"
                        :display "flex"
                        :gap "0.25rem"
                        :padding "0.75rem 1rem"}]))

      ;; binds is FLAT too: behaviour attaches BY SELECTOR, which is why
      ;; `.composer__send` may appear here and in `style` both.
      (quote
        (binds
          [".composer__send" (st/on :click (fire :send))])))))

;; ── emission ────────────────────────────────────────────────────────────────

(def module "SpacetimeLvWeb.ChatLive")

(defn server-contract
  "The sidecar verse reads: the contract plus the reply tags Elixir cannot
   enumerate."
  []
  (contract-json-with-replies contract-term module))

(defn page-document
  "The page's `@data` declarations \u2014 the seam, from the client side."
  []
  (edn-document contract-term "chat" ["stdlib/macros/data-kind" "stdlib/macros/handle"]))

(defn view-page
  "The page's three planes: markup, style, binds."
  []
  (view-document view-term ["stdlib/macros/data-kind"]))
