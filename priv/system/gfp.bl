; gfp.bl — the GREATEST-fixpoint driver: seed full, shrink to stable.
;
; datom's recursive rules compute a LEAST fixpoint: seed the base facts and ADD
; what the rules force until nothing new appears (reachability, transitive
; closure, connected components). A whole family of VERIFICATION problems is the
; dual — seed EVERYTHING and REMOVE what fails until nothing else falls:
;   · invariant discovery (Houdini): seed every candidate promise, drop each one
;     a transition breaks; the survivors are a proven invariant.
;   · safe-region model checking (CTL AG): seed every state, drop any that is
;     bad or steps to a dropped one; the survivors are the invariant region.
;   · bisimulation / state minimization: seed every state pair, drop any pair a
;     step can tell apart; the survivors are the coarsest behavioural equivalence.
;
; All three are ONE move: a MONOTONE shrink to the greatest stable set. The
; per-step DECISION (does this survive, given the current survivors?) is supplied
; by whichever engine owns it — z3 for Houdini, a pure relation for CTL/bisim.
; This module is the driver; the decision is the caller's.
;
; SOUNDNESS OBLIGATION on `survives?`: it must be MONOTONE in the survivor set —
; growing the set can only turn a tuple from falling to surviving, never the
; reverse. Houdini's "holds under the conjunction of survivors" and CTL's "all
; successors survive" both satisfy this; the driver does not check it.

(ns system.gfp)

(defn gfp
  "The greatest fixpoint of `survives?` below `seed`: the largest S ⊆ seed with
   S = { t ∈ S | survives? t S }. `survives?` is (fn [t S] → bool), monotone in
   S. Returns {:fixpoint S* :rounds N}. Terminates: S only shrinks and is finite."
  [seed survives?]
  (loop [s seed round 0]
    (let [s2 (into #{} (filter (fn [t] (survives? t s)) (into [] s)))]
      (if (= (count s2) (count s))
        {:fixpoint s2 :rounds round}
        (recur s2 (+ round 1))))))

(defn gfp-delta
  "gfp with the SEMI-NAIVE optimization: a tuple can NEWLY fall only if one of
   its dependencies fell last round. `depends-on?` is (fn [t fell-set] → bool) —
   the dual of datom's semi-naive delta. `:checks` counts survives? calls, so a
   caller can measure that it did strictly less work than the naive scan. Same
   fixpoint as `gfp` when `depends-on?` is a sound over-approximation of the real
   dependency (every tuple that could fall because of `fell` is included)."
  [seed survives? depends-on?]
  (loop [s seed to-check (into [] seed) round 0 checks 0]
    (let [fell   (into #{} (filter (fn [t] (not (survives? t s))) to-check))
          checks (+ checks (count to-check))]
      (if (empty? fell)
        {:fixpoint s :rounds round :checks checks}
        (let [s2  (into #{} (filter (fn [t] (not (contains? fell t))) (into [] s)))
              nxt (into [] (filter (fn [t] (depends-on? t fell)) (into [] s2)))]
          (recur s2 nxt (+ round 1) checks))))))

(defn gfp-explained
  "gfp with PROVENANCE: `falls-why` is (fn [t S] → nil | witness) — nil when t
   survives, else a witness of why it fell (which transition, which successor).
   Returns {:fixpoint S* :rounds N :log [{:tuple :round :witness} …]} — the
   derivation an opaque loop throws away. The fixpoint equals `gfp`'s when
   `falls-why` returns a witness exactly when `survives?` would return false."
  [seed falls-why]
  (loop [s seed round 0 log []]
    (let [checked (map (fn [t] [t (falls-why t s)]) (into [] s))
          fallen  (filter (fn [p] (some? (second p))) checked)
          s2      (into #{} (map first (filter (fn [p] (nil? (second p))) checked)))]
      (if (empty? fallen)
        {:fixpoint s2 :rounds round :log log}
        (recur s2 (+ round 1)
               (into log (map (fn [p] {:tuple (first p) :round round :witness (second p)})
                              fallen)))))))

; ── ready-made shrinks over a finite labelled transition system ─────────────
;
; A transition system here is {:states [..] :edges [[from label to] ..]}. These
; wrap gfp with the two pure-relational decisions that recur in model checking.

(defn safe-region
  "CTL AG¬bad: the largest set of states none of which is bad and all of whose
   successors stay in the set. `succ` is (fn [state] → [states]); `bad?` is
   (fn [state] → bool). Returns the invariant region (a set)."
  [states succ bad?]
  (:fixpoint
    (gfp (into #{} states)
         (fn [s S] (and (not (bad? s))
                        (every? (fn [n] (contains? S n)) (into [] (succ s))))))))

(defn bisimulation
  "The coarsest bisimulation over `states`: the largest set of state PAIRS
   [a b] that enable the same labels and whose same-label successors are again
   related. `labels` is (fn [state] → #{label}); `step` is (fn [state label] →
   state). Returns the set of related pairs (an equivalence, reflexive+symmetric)."
  [states labels step]
  (:fixpoint
    (gfp (into #{} (mapcat (fn [a] (map (fn [b] [a b]) states)) states))
         (fn [pr S]
           (let [a (first pr) b (second pr)]
             (and (= (labels a) (labels b))
                  (every? (fn [l] (contains? S [(step a l) (step b l)]))
                          (into [] (labels a)))))))))

; ── the LEAST-fixpoint dual: liveness (◇, eventually) ──────────────────────
;
; safe-region is AG (always-globally, safety) — a GREATEST fixpoint. Its dual is
; AF (always-finally, liveness): "on EVERY path, `goal` is eventually reached".
; That is a LEAST fixpoint — seed with the goal states, then add any state ALL of
; whose successors already eventually-reach, until stable:
;   AF = μZ. goal ∨ (has-successors ∧ ∀ successor ∈ Z)
; A deadlock that is not a goal, or a cycle that avoids the goal, is never added
; — correctly, since it has a future that never reaches `goal`.

(defn af
  "The states from which `goal?` is UNAVOIDABLE — every path eventually reaches a
   goal state. `succ` is (state → [states]); `goal?` is (state → bool). A state
   with no successors satisfies AF only if it is itself a goal. Returns the set."
  [states succ goal?]
  (loop [reached (into #{} (filter goal? states))]
    (let [reached2 (into #{} (concat (into [] reached)
                    (filter (fn [s]
                              (let [outs (succ s)]
                                (and (not (empty? outs))
                                     (every? (fn [n] (contains? reached n)) outs))))
                            states)))]
      (if (= (count reached2) (count reached))
        reached
        (recur reached2)))))

(defn af-holds?
  "Does liveness hold from `start` — is `goal?` unavoidable from it? True ⇔
   start ∈ AF goal. A start outside AF has a path (a deadlock or a goal-avoiding
   cycle) that never reaches the goal — a starvation counterexample."
  [states succ goal? start]
  (contains? (af states succ goal?) start))
