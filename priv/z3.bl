; z3.bl — MVP-C: solver-backed proofs, as a native call.
;
; Graduated from research/p13a_smt (encoding + port timings: p50 2ms,
; no NIF needed) and research/p13d_rule_proofs (2 rules proven, one
; counterexample-derived assumption boundary). The solver owns
; DECISIONS in the engine division: the tag lattice owns structure,
; miniKanren owns relations, z3 owns provability.
;
; The value model (P13a): a beam-lisp value is (tag : Int, payload).
; Tags: nil=0, int=1, string=3, bool=5. Soundness of a rewrite
; lhs → rhs means: same RESULT and same RAISED-NESS for every input —
; the raises half is what makes the idiomatic tier real (zero? raises
; on non-numbers; = never does).
;
; Usage:
;   (def port (z3/open))
;   (z3/prove-equiv port lhs rhs "")
;   => {:verdict "unsat"}                      ; PROVEN for all inputs
;   => {:verdict "sat" :model "…"}             ; counterexample
;
; Assumptions (a discharged type predicate, e.g. tag_x = 1 for int) are
; extra declarations — the deodorant×types promotion path (MVP-E).

(ns z3)

(def tags {:nil 0 :int 1 :string 3 :bool 5})

(def value-decls
  "(declare-const tag_x Int)\n(declare-const x_i Int)\n(assert (or (= tag_x 0) (= tag_x 1) (= tag_x 3) (= tag_x 5)))\n")

(defn open
  "A z3 process reading SMT-LIB on stdin. Raises if z3 is absent."
  []
  (BeamLisp.Z3Port/open))

(defn check
  "Reset + assert + check-sat. → \"sat\" | \"unsat\" | \"unknown\"."
  [port smt]
  (:status (BeamLisp.Z3Port/check port smt false)))

(defn check-model
  "check + (get-model) on sat. → {:status s :model text-or-nil}."
  [port smt]
  (BeamLisp.Z3Port/check port smt true))

(defn prove-equiv
  "Prove lhs ≡ rhs over the value model: same result, same raised-ness,
   for every input. lhs/rhs are {:result smt :raises smt}.
   `assumptions` is extra SMT text (e.g. \"(assert (= tag_x 1))\").
   Returns {:verdict v} with :model on sat (the counterexample)."
  [port lhs rhs assumptions]
  (let [smt (str value-decls assumptions
                 "(assert (not (and (= " (:result lhs) " " (:result rhs)
                 ") (= " (:raises lhs) " " (:raises rhs) "))))\n")
        r (check-model port smt)]
    {:verdict (:status r) :model (:model r)}))

(defn prove-equiv?
  "Boolean convenience: proven?"
  [port lhs rhs assumptions]
  (= "unsat" (:verdict (prove-equiv port lhs rhs assumptions))))

; --- the value-model expression helpers -----------------------------------------
;
; These are the vocabulary P13d's rules are written in. They exist so a
; rule's encoding is READABLE bl data, not raw strings.

(defn tag-is [t] (str "(= tag_x " (get tags t) ")"))
(defn not-tag [t] (str "(not " (tag-is t) ")"))
(defn payload-is [n] (str "(= x_i " n ")"))

(defn eq-const-expr
  "The (= x n) form: total — result is (tag ∧ payload), never raises."
  [tag n]
  {:result (str "(and " (tag-is tag) " " (payload-is n) ")")
   :raises "false"})

(defn pred-expr
  "A partial predicate like (zero? x): raises off-tag, compares payload
   on-tag."
  [tag n]
  {:result (payload-is n)
   :raises (not-tag tag)})
