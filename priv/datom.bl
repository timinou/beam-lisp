; datom.bl — the whole database, one namespace.
;
; ── What this is ──────────────────────────────────────────────────────
;
; An immutable, temporal, datalog database in the shape of Datomic,
; written in beam-lisp. Facts are never updated or deleted: a change
; APPENDS a retraction of the old value and an assertion of the new one,
; both stamped with the transaction that made them. Nothing is lost, so
; the past is not archived anywhere — it is simply still here.
;
; Five ideas, and everything else follows from them:
;
;   1. A fact is a DATOM: [entity attribute value transaction added?]
;      Five fields, no schema-shaped rows. Adding an attribute to one
;      entity does not touch any other.
;
;   2. A database is a VALUE. `(db conn)` is O(1) and returns something
;      immutable that will answer the same question the same way forever,
;      no matter what the connection does next. Queries are functions of
;      that value, not requests to a server.
;
;   3. Time travel is a FILTER, not a feature. Because nothing is
;      deleted, `as-of` is a predicate over data that never went
;      anywhere. It costs nothing to construct and copies nothing.
;
;   4. Queries are DATA. A query is a vector you can build, store, and
;      generate — not a string you assemble and hope parses.
;
;   5. The store is a PORT. Everything above `datom.store` is pure logic
;      over an ordered key/value space; the substrate is swappable.
;
; ── This namespace ────────────────────────────────────────────────────
;
; Every function an application needs, re-exported here so a caller
; requires ONE namespace instead of six. The implementation namespaces
; (`datom.conn`, `datom.db`, `datom.query.engine`, `datom.pull`,
; `datom.time`, `datom.index`) remain available for anything unusual —
; this is a facade, not a wall.
;
; ── A complete program ────────────────────────────────────────────────
;
;   (ns my.app (:require [datom]))
;
;   (def conn (datom/connect
;               [{:db/ident :person/name  :db/valueType :db.type/string}
;                {:db/ident :person/email :db/valueType :db.type/string
;                                         :db/unique :db.unique/identity}
;                {:db/ident :person/friend :db/valueType :db.type/ref
;                                          :db/cardinality :db.cardinality/many}]))
;
;   (def report (datom/transact! conn [{:db/id -1 :person/name "Ada"
;                                       :person/email "ada@example.com"}]))
;
;   (datom/q '[:find ?name
;              :where [?e :person/name ?name]]
;            (datom/db conn))
;   ;; => #{["Ada"]}
;
;   (datom/pull (datom/db conn) [:person/name] (get (:tempids report) -1))
;   ;; => {:db/id 1 :person/name "Ada"}
;
;   ;; and the same query, against the past
;   (datom/q '[:find ?name :where [?e :person/name ?name]]
;            (datom/as-of (datom/db conn) (:tx report)))

(ns datom
  (:require [datom.conn] [datom.db] [datom.index] [datom.pull]
            [datom.query.agg] [datom.query.engine] [datom.query.parse]
            [datom.schema] [datom.store] [datom.store-ets] [datom.time]
            [datom.tx] [datom.migrate]
            [datom.frame] [datom.broadcast] [datom.watch]))

;; ── connecting ──────────────────────────────────────────────────────

(defn connect
  "Open a connection over a fresh in-memory store.

   `schema-defs` are attribute definitions, installed before any data so
   the first transaction already knows its cardinalities:

     (connect [{:db/ident :person/name :db/valueType :db.type/string}])

   A connection is the only mutable thing here. Everything it hands out
   is a value."
  ([] (datom.conn/connect))
  ([schema-defs] (datom.conn/connect schema-defs)))

(defn connect-with
  "Open a connection over an EXISTING store.

   The seam a different substrate arrives through: anything implementing
   `datom.store/Store` works, and no layer above can tell the
   difference."
  ([store] (datom.conn/connect-with store))
  ([store schema-defs] (datom.conn/connect-with store schema-defs)))

(defn release!
  "Forget the process-wide registry entry for this connection's store.

   The counterpart to `connect-with`, needed when a connection's life is
   shorter than the VM's.

   Two connections over one store share a writer and a basis, and the
   registry that makes that true is a named, process-wide Agent — so
   until this is called, every store ever opened stays reachable from
   it. Over ETS that is a slow leak. Over a DURABLE store it is a file
   lock: a durable backend's handle is freed by garbage collection, and a registry
   entry is a live reference, so a database file stays locked against
   reopening long after the process that opened it has died.

   Call it when a connection is finished with. Idempotent, and safe on a
   store that was never registered."
  [conn]
  (datom.conn/release! conn))

(defn install-schema!
  "Add attribute definitions to a live connection. Schema evolves like
   data, because it IS data."
  [conn defs]
  (datom.conn/install-schema! conn defs))

(defn schema
  "The connection's schema map."
  [conn]
  (datom.conn/schema conn))

(defn sync-schema!
  "Bring the connection's in-memory schema map in line with `defs` that
   were ALREADY written as datoms (as `migrate/apply!` does). Updates the
   read path and any newly-demanded index without writing new datoms."
  [conn defs]
  (datom.conn/sync-schema! conn defs))

;; ── writing ─────────────────────────────────────────────────────────

(defn transact!
  "Record `tx-data`, returning a transaction report.

   Transaction data is DATA \u2014 maps, or `[:db/add e a v]` vectors, mixed
   freely:

     [{:db/id -1 :person/name \"Ada\"}          ; a map is many assertions
      [:db/add ada :person/age 36]             ; an explicit assertion
      [:db/retract ada :person/nickname \"A\"]  ; a retraction
      [:db/retractEntity old-id]               ; forget an entity entirely
      [:db/cas ada :person/age 36 37]          ; only if it is still 36
      {:db/id :db/current-tx :audit/by \"me\"}] ; annotate the change

   A NEGATIVE `:db/id` is a tempid: it becomes a real id, and the report
   says which. A tempid asserting a `:db.unique/identity` value UPSERTS
   onto whatever entity already holds it, which is what makes a
   transaction idempotent.

   The report carries:

     :db-before   the value before this transaction
     :db-after    the value after it
     :tx          the transaction id (also an entity \u2014 see `as-of`)
     :tempids     tempid -> real entity id
     :tx-datoms   exactly the datoms recorded

   Raises on a schema violation, listing EVERY problem rather than the
   first \u2014 a partially-valid transaction is never applied."
  [conn tx-data]
  (datom.conn/transact! conn tx-data))

(defn with
  "Speculatively apply `tx-data` and return the report that WOULD result,
   WITHOUT committing. `:db-after` is a full database value — query it,
   pull from it, feed it to another `with`. The connection is untouched.

   The basis of the migration dry-run: preview a whole change against a
   database (including a production replica) and see what it does before
   committing to it."
  [conn tx-data]
  (datom.conn/with conn tx-data))

;; ── transaction functions ───────────────────────────────────────────

(defn register-tx-fn!
  "Register a transaction function under `name`, callable from tx-data as
   `[:db/fn name & args]`. A tx-fn is `(fn [db & args] -> tx-data)`; it
   runs against the transaction's before-value and its output is spliced
   in and committed atomically with the rest of the transaction."
  [name f]
  (datom.tx/register-fn! name f))

;; ── migrations ──────────────────────────────────────────────────────
;;
;; Schema evolution you can trust against real data. A migration is one
;; value carrying its schema deltas, the invariants it tightens, and the
;; remediation that makes those invariants true. See `datom.migrate` for
;; the full vocabulary; these are the everyday entry points.

(defn plan-migration
  "Walk `db` (a value — a local db or a production replica) and report how
   `migration` would behave against the data present, committing nothing.
   Returns `{:id :status :breaking :remediated :would-tx}` where status is
   `:clean`, `:breaking` or `:already-applied`."
  [db migration]
  (datom.migrate/plan db migration))

(defn apply-migration!
  "Apply `migration` to `conn`: remediate, re-check, then grow the schema
   and record the migration as ONE atomic transaction. Gated (refuses if
   remediation leaves an invariant broken) and idempotent. Returns a
   report `{:id :status …}`."
  [conn migration]
  (datom.migrate/apply! conn migration))

(defn apply-migrations!
  "Apply `migrations` to `conn` in order, stopping at the first blocked.
   Returns per-migration reports."
  [conn migrations]
  (datom.migrate/apply-all! conn migrations))

;; ── the database value ──────────────────────────────────────────────

(defn db
  "The current database VALUE.

   O(1): it captures a basis, not data. Hold it as long as you like \u2014 it
   will answer the same question the same way forever, however many
   transactions the connection accepts meanwhile. This is the property
   every other one here rests on."
  [conn]
  (datom.conn/db conn))

(defn entity
  "Entity `e` as a map of attribute to value.

   A cardinality-many attribute collects into a vector; `:db/id` is
   included so the result round-trips as transaction data. Returns nil
   when the entity has no datoms."
  [db e]
  (datom.db/entity db e))

(defn datoms
  "Raw datoms from `index` matching `components`, filtered by this db
   value's basis.

   The low-level read. `index` is `:eavt`, `:aevt`, `:avet` or `:vaet`;
   components bind a prefix of that index's sort order."
  [db index & components]
  (apply datom.db/datoms db index components))

(defn basis-t
  "The transaction this value reads as of."
  [db]
  (datom.db/basis-t db))

;; ── live subscriptions (L2: the transaction-report broadcast) ────────
;;
;; datom keeps a durable, totally-ordered log; these make it OBSERVABLE.
;; After every commit the writer broadcasts a report, in commit order, to
;; every subscribed process. The default payload is the DELTA
;; (`[:datom/tx basis tx-datoms]`) — query-free: the reader filters the
;; datoms in hand with no store access. See
;; docs/datom-as-a-broadcast-substrate.md.
;;
;;   (datom/listen! conn)                            ; all commits, delta payload
;;   (datom/listen! conn {:attrs #{:order/status}})  ; only commits touching these
;;   (datom/listen! conn {:payload :basis})          ; basis-only (reader re-derives)
;;   (datom/unlisten! conn)
;;
;; and in the receiving process:
;;
;;   (receive
;;     [:datom/tx _basis tx-datoms]
;;       (doseq [d tx-datoms]
;;         (when (= :order/status (datom/datom-a d))
;;           (handle (datom/datom-e d) (datom/datom-v d))))
;;     (after 5000 :idle))
;;
;; A dropped message is never a lost event: every payload carries the new
;; basis, so a subscriber that detects a jump replays `(datom/since db t)`
;; from the log. The broadcast is an accelerator; the log is the truth.

(defn listen!
  "Subscribe the calling process to `conn`'s commit stream.

   `opts` (optional):
     :attrs   #{…}   — wake only on commits touching one of these attributes
     :payload :basis — receive `[:datom/changed basis attrs]` instead of the
                       default delta `[:datom/tx basis tx-datoms]`

   Returns the subscriber pid. Idempotent per process."
  ([conn] (datom.conn/listen! conn))
  ([conn opts] (datom.conn/listen! conn opts)))

(defn unlisten!
  "Unsubscribe the calling process (or an explicit `pid`) from `conn`."
  ([conn] (datom.conn/unlisten! conn))
  ([conn pid] (datom.conn/unlisten! conn pid)))

(defn subscribers
  "The pids currently subscribed to `conn`."
  [conn]
  (datom.conn/subscribers conn))

;; ── filtered live queries (L3: watch) ────────────────────────────
;;
;; L2 (`listen!`) is the raw commit stream. `watch` is the FILTER: it fires
;; a callback only when a commit affects a declared interest, which is one
;; of three shapes — and all three are the SAME datalog the query engine
;; already speaks, so there is no second matcher to keep in agreement.
;;
;;   ;; T1 — a bare pattern: the callback gets the matching datoms
;;   (datom/watch conn '[?e :order/status :shipped]
;;     (fn [changes] (doseq [c changes] (ship! (:e c)))))
;;
;;   ;; T2a — a guarded per-principal live query: the callback gets a diff
;;   (def feed (auth/guard '[:find ?id :where [?e :doc/id ?id]]
;;                         [(auth/owner-filter '?e :doc/owner principal)]))
;;   (datom/watch conn feed (fn [d] (push! principal d)))   ; {:added :removed}
;;
;;   ;; semantic — similar-to as a filter (bound ?e); time-travels via basis
;;   (datom/watch conn
;;     '[:find ?e ?score :in $ ?q
;;       :where [?e :doc/embedding _]
;;              [(similar-to :doc/embedding ?q 0.85) [?e ?score]]]
;;     [query-vec] (fn [d] …))
;;
;;   (datom/unwatch watch-ref)
;;
;; A watch runs in its own process (isolation + backpressure), and the
;; callback receives DATOMS or result ROWS — never a projection the writer
;; computed (FEAT-016 holds at L3 too).

(defn watch
  "Fire `callback` whenever a commit on `conn` affects `interest`.

   `interest` is either a bare PATTERN `[?e :a v]` (T1 — callback gets a
   vector of change maps) or a full QUERY, plain or `auth/guard`'d (T2a —
   callback gets a `{:added :removed}` diff). `inputs` are the query's `:in`
   arguments (e.g. a query vector for `similar-to`).

   Returns a watch reference for `unwatch`. Runs in its own process."
  ([conn interest callback] (datom.watch/watch conn interest callback))
  ([conn interest inputs callback] (datom.watch/watch conn interest inputs callback)))

(defn unwatch
  "Stop a watch started by `watch`. Idempotent."
  [watch-ref]
  (datom.watch/unwatch watch-ref))

;; ── querying ────────────────────────────────────────────────────────

(defn q
  "Run a datalog `query` against `db`, with optional inputs.

   A query is DATA:

     [:find  ?name ?age
      :in    $ [?city ...]
      :where [?e :person/city ?city]
             [?e :person/name ?name]
             [?e :person/age ?age]
             [(> ?age 21)]]

   `:find`  what to return \u2014 variables, or an aggregate like
            `(count ?e)`, `(sum ?x)`, `(avg ?x)`, `(min ?x)`, `(max ?x)`,
            `(count-distinct ?e)`.
   `:in`    what the caller supplies: `?x` one value, `[?x ...]` many
            (this is how you write `IN`), `[?x ?y]` a tuple, `[[?x ?y]]`
            a whole TABLE to join against.
   `:where` clauses: patterns `[?e :attr ?v]` (a fourth term binds the
            transaction), predicates `[(> ?a 21)]`, functions
            `[(* ?a 2) ?d]`, and `[:and ...]` `[:or ...]` `[:not ...]`
            `[:or-join [?e] ...]` `[:not-join [?e] ...]`.

   Returns a SET of tuples \u2014 the semantics ARE set semantics: the same
   answer arriving by two derivations is one answer."
  [query db & inputs]
  (apply datom.query.engine/q query db (or inputs '())))

;; ── the `from` pipeline ───────────────────────────────────
;;
;; The analytical majority of datalog queries have one shape: take the
;; entities that have some attribute, GATHER a few of their attributes
;; onto one row, optionally FILTER, GROUP, and AGGREGATE. Written as raw
;; `:where` clauses that is one `[?e :attr ?var]` line per column plus a
;; hand-threaded join variable — the join that, as the datom model shows,
;; was never really a join but a gather of one entity's attributes.
;;
;; `from` is sugar for exactly that shape. It reads top-to-bottom and
;; compiles to an ordinary `q` call — the query is still data, still runs
;; on the same engine; only the authoring tax is removed.
;;
;;   (datom/from db :spend/model
;;     (gather [:spend/model :spend/cost-cents :spend/provider])
;;     (where  [= :spend/provider "anthropic"])
;;     (group-by :spend/model)
;;     (agg     {:total (sum :spend/cost-cents) :n (count)}))
;;
;; A step is one of:
;;   (gather [:a :b …])          bind each attribute to a var named ?a etc.
;;   (where [op :attr value])    a predicate over a gathered attribute
;;   (group-by :attr)            group the result by this attribute
;;   (agg {:alias (fn :attr)})   aggregate expressions; (count) counts ?e
;;
;; Every attribute keyword `:ns/name` becomes the variable `?name`, so the
;; columns and the query variables line up by construction.

(defn- attr->var
  "The query variable for an attribute keyword: `:spend/cost-cents` →
   `?cost-cents` (namespace dropped)."
  [attr]
  (symbol (str "?" (name attr))))

(defn build-from-query
  "Build a datalog query vector from a `from` pipeline's `entity-attr` and
   `steps` (already-evaluated step data). Public so the macro can call it
   and so it is testable without macroexpansion.

   `steps` is a vector of step vectors: `[:gather [attrs]]`,
   `[:where [op attr val]]`, `[:group-by attr]`, `[:agg {alias expr}]`."
  [entity-attr steps]
  (let [e (quote ?e)
        gathered (into [] (distinct
                            (reduce (fn [acc step]
                                      (if (= (first step) :gather)
                                        (reduce conj acc (get step 1))
                                        acc))
                                    [entity-attr]
                                    steps)))
        patterns (mapv (fn [a] [e a (attr->var a)]) gathered)
        preds (reduce (fn [acc step]
                        (if (= (first step) :where)
                          (let [w (get step 1)]
                            (conj acc [(list (get w 0) (attr->var (get w 1)) (get w 2))]))
                          acc))
                      []
                      steps)
        where (reduce conj patterns preds)
        group-attrs (reduce (fn [acc step]
                              (if (= (first step) :group-by) (conj acc (get step 1)) acc))
                            []
                            steps)
        agg-map (reduce (fn [acc step]
                          (if (= (first step) :agg) (merge acc (get step 1)) acc))
                        {}
                        steps)
        find-groups (mapv attr->var group-attrs)
        find-aggs (mapv (fn [entry]
                          (let [expr (val entry)
                                op (first expr)
                                arg (if (> (count expr) 1) (attr->var (second expr)) e)]
                            (list op arg)))
                        (seq agg-map))
        find (let [f (reduce conj find-groups find-aggs)]
               (if (empty? f) (mapv attr->var gathered) f))]
    ; assemble [:find <find…> :where <where…>]
    (reduce conj
            (reduce conj [:find] find)
            (reduce conj [:where] where))))

;; ── the `#d[…]` query literal ─────────────────────────────
;;
;; `#d[:find ?x :where [?x :spend/model _]]` reads as
;; `(datom/read-query [:find ?x :where [?x :spend/model _]])`. The literal
;; self-documents a value as a datalog query and VALIDATES it at read time
;; — a malformed query is a read-time error, not a runtime surprise deep in
;; a join. The tag is registered as a data-reader (see the bottom of this
;; file), the same rebindable mechanism `@`→`deref` uses.

(defmacro read-query
  "Validate `query` as a datalog query at READ/compile time and yield it
   unchanged. A macro rather than a function so the validation runs when
   the `#d[…]` form is compiled and the query vector itself is emitted as
   a literal — `#d[…]` is a value equal to the plain vector, only checked."
  [query]
  (let [parsed (datom.query.parse/parse query)
        problems (into (datom.query.parse/validate parsed)
                       (datom.query.agg/validate-find (:find parsed)))]
    (if (seq problems)
      (throw (ex-info "invalid #d[…] query literal"
                      {:problems problems :query query}))
      `(quote ~query))))

(defmacro from
  "The analytical pipeline sugar over `q`. Expands to
   `(q (build-from-query entity 'step-data) db)` — see `build-from-query`
   for the shape. `db` is evaluated; the entity attribute and step forms
   are DATA the macro lifts, unevaluated, into the query. So `sum`, `=`
   and the like inside steps are symbols in the query, not vars to call."
  [db & steps]
  (let [entity-attr (first steps)
        pipeline (rest steps)
        ; each step `(op arg…)` becomes the data vector `[:op arg…]`,
        ; kept entirely as data (quoted below) so aggregate/predicate
        ; operators are not evaluated at the call site.
        step-data (mapv (fn [s]
                          (reduce conj [(keyword (name (first s)))] (rest s)))
                        pipeline)]
    `(datom/q (datom/build-from-query (quote ~entity-attr) (quote ~step-data)) ~db)))

(defn pull
  "Read a SHAPE out of the graph.

   Datalog returns tuples of scalars; an application usually wants a
   tree. A pull pattern describes one:

     [:person/name
      :person/age
      {:person/friend [:person/name]}       ; nest through a ref
      {:person/manager ...}                 ; recurse to any depth
      {:person/report 3}                    ; or to a bounded depth
      :person/_friend                       ; REVERSE: who refers to me
      (default :person/nickname \"none\")     ; a value when absent
      (limit :person/friend 10)             ; bound an unbounded read
      (:person/name :as :name)]             ; rename for the consumer

   `[*]` takes every attribute the entity has, unexpanded. `e` may be an
   entity id or a lookup ref."
  [db pattern e]
  (datom.pull/pull db pattern e))

(defn pull-many
  "Pull the same pattern from several entities, in order."
  [db pattern entities]
  (datom.pull/pull-many db pattern entities))

;; ── DataFrames (the analytical surface) ─────────────────────────────
;;
;; `q` and `pull` answer questions and return logic-shaped values — a set of
;; tuples, a tree. `q-df` and `pull->df` return the SAME answers COLUMN-shaped,
;; as an Explorer (Polars) DataFrame, for the analytical majority: group, sum,
;; percentile, join, plot at column-engine speed. Explorer is an OPTIONAL dep —
;; these raise a clear "add :explorer" error when it is absent, and the rest of
;; datom never needs it. See datom/frame.bl.

(defn q-df
  "Run a datalog `query` and return an Explorer.DataFrame — one column per
   `:find` element, in `:find` order. The analytical sibling of `q`: same
   query, same engine, same answer, reshaped into columns. Requires Explorer."
  [query db & inputs]
  (apply datom.frame/q-df query db inputs))

(defn pull->df
  "Pull `attrs` for each id in `eids` into an Explorer.DataFrame — one row per
   entity, a leading `db/id` column then one column per attribute (absent → a
   null cell). The tabular face of `pull`. Requires Explorer."
  [db eids attrs]
  (datom.frame/pull->df db eids attrs))

(defn lookup-ref
  "Resolve `[:attr value]` to an entity id, naming an entity by a UNIQUE
   value rather than by id. Requires a `:db/unique` attribute."
  [db ref]
  (datom.pull/lookup-ref db ref))

;; ── time ────────────────────────────────────────────────────────────

(defn as-of
  "The database as it stood at transaction `t`.

   O(1) and copies nothing: the historical value shares the same store
   and differs only in its basis. Every query and every pull works
   against it unchanged \u2014 no special syntax, no audit table. The query
   does not know it is looking at the past."
  [db t]
  (datom.time/as-of db t))

(defn since
  "Only what changed AFTER `t` \u2014 the delta, exclusive of `t` itself.

   Together with `as-of` (which is inclusive) this partitions history
   exactly: every datom falls in one half or the other."
  [db t]
  (datom.time/since db t))

(defn history
  "Every datom ever recorded, assertions and retractions alike.

   The other views answer `what is true?`. This one answers `what
   CHANGED, and when?` \u2014 a different question, and the reason retractions
   are kept rather than deleted.

   NOT a database state: an entity may appear to hold several values for
   a cardinality-one attribute, because it held each at some point.
   `entity` and `pull` refuse a history view for that reason; ask
   `changes` instead."
  [db]
  (datom.time/history db))

(defn changes
  "Every change to `[e a]`, oldest first, as maps of
   `{:value :t :added}`.

   The actionable form of history: what a field has been, and when it
   became so."
  [db e a]
  (datom.time/changes db e a))

(defn value-at
  "The value of `[e a]` at transaction `t`."
  [db t e a]
  (datom.time/value-at db t e a))

(defn tx-of
  "The transaction at which `[e a v]` became true, or nil.

   `when did this become the case?` \u2014 the question that makes a history
   view actionable rather than merely interesting."
  [db e a v]
  (datom.time/tx-of db e a v))

(defn current?
  "Whether `db` is an ordinary present-tense view."
  [db]
  (datom.time/current? db))

(defn history?
  "Whether `db` is a history view."
  [db]
  (datom.time/history? db))

;; ── datoms, for when you want the facts themselves ──────────────────

(defn datom-e "The entity of a datom." [d] (datom.index/-e d))
(defn datom-a "The attribute of a datom." [d] (datom.index/-a d))
(defn datom-v "The value of a datom." [d] (datom.index/-v d))
(defn datom-tx "The transaction that recorded a datom." [d] (datom.index/-tx d))
(defn datom-added?
  "Whether a datom asserts (rather than retracts) its fact."
  [d]
  (datom.index/assertion? d))

;; ── register the `#d[…]` query literal ──────────────────────────────
;;
;; `#d[…]` reads as `(datom/read-query […])` — registered here, from
;; source, the same rebindable way `priv/core.bl` registers `@`→`deref`.
;; A query literal that validates itself at read time.
(data-reader! "d" (quote datom/read-query))
