; priv/test.bl — clojure.test, ported. beam-lisp carries its own test
; suite: deftest/is/testing/are register tests whose storage lives in
; BeamLisp.TestRT (ETS), so they survive across files and runs.
;
; Loaded into the `core` namespace (before any test file) so its macros
; resolve from every namespace via the usual core fallback — the same
; trick that puts cond/case/when in core.bl. `run-tests` drives the
; run and prints the clojure.test-shaped summary.

; --- assertion runtime ---
; A failing `is` must not halt the run: it records and returns. The
; form is passed both as its datum (for failure detail) and as a thunk
; (for evaluation), so exceptions inside it are caught here, not raised.

(defn test-record [ns type form msg expected actual]
  (BeamLisp.TestRT/record ns type form msg expected actual))

(defn is-report [ns form msg f]
  (try
    (let [v (f)]
      (if v
        (do (test-record ns :pass form msg nil v) true)
        (do (test-record ns :fail form msg form v) false)))
    (catch e
      (test-record ns :error form msg form e)
      false)))

; The `=` case reports expected/actual separately, as clojure.test does.
(defn is-eq-report [ns form a b msg fa fb]
  (try
    (let [av (fa) bv (fb)]
      (if (= av bv)
        (do (test-record ns :pass form msg nil bv) true)
        (do (test-record ns :fail form msg a bv) false)))
    (catch e
      (test-record ns :error form msg form e)
      false)))

; --- the macros ---
; Each captures the current namespace at expansion time (the test file's
; `(ns …)` is already in effect), so records land in the right namespace
; even after later files have switched it.

(defmacro deftest [name & body]
  `(do
     (BeamLisp.TestRT/register_test ~(BeamLisp.Env/current_ns)
                                    ~(BeamLisp.TestRT/sym_name name)
                                    (fn [] ~@body))
     nil))

(defmacro is
  ([form] `(is ~form nil))
  ([form msg]
    (if (BeamLisp.TestRT/eq_form? form)
      (let [[_ a b] form]
        `(is-eq-report ~(BeamLisp.Env/current_ns)
                       (quote ~form) (quote ~a) (quote ~b) ~msg
                       (fn [] ~a) (fn [] ~b)))
      `(is-report ~(BeamLisp.Env/current_ns) (quote ~form) ~msg (fn [] ~form)))))

(defmacro testing [str & body]
  `(BeamLisp.TestRT/with_context ~str (fn [] ~@body)))

; are: table-driven is. Each full row binds argv onto the template and
; becomes one (is template). A trailing partial row is ignored.
(defmacro are [argv expr & rows]
  (if (empty? rows)
    `(do)
    (let [n (count argv)]
      (if (= n 0)
        (let [forms (map (fn [_] (list (quote is) expr)) rows)]
          (cons (quote do) forms))
        (loop [i 0 acc ()]
          (if (< (- (count rows) i) n)
            (cons (quote do) (lists/reverse acc))
            (recur (+ i n)
                   (cons (list (quote is)
                               (BeamLisp.TestRT/subst argv (take n (drop i rows)) expr))
                         acc))))))))

; --- running ---
; run-tests is a runtime fn (nothing to expand); it runs each namespace's
; tests through BeamLisp.TestRT and returns the grand totals map.

(defn run-tests
  "Run registered tests for the current ns, one ns, or :all. Prints
  per-failure detail and a summary; returns a totals map."
  ([] (run-tests (BeamLisp.Env/current_ns)))
  ([ns-or-all]
   (let [nss (if (= ns-or-all :all)
               (BeamLisp.TestRT/test_namespaces)
               [ns-or-all])
         results (map (fn [ns] (BeamLisp.TestRT/run_ns ns)) nss)
         totals (BeamLisp.TestRT/aggregate results)]
     (BeamLisp.TestRT/print_summary totals)
     totals)))
