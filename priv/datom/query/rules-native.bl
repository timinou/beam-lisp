; datom/query/rules-native.bl — the ONE-TRUTH driver.
;
; ── What this is, and why it is not a "second engine" ─────────────────
;
; There is exactly ONE place that decides what recursion MEANS: the native
; fixpoint in `native/datom_datalog` (unify, novelty, termination, the
; semi-naive delta). This file does NOT re-implement any of that. It is the
; COMPILER + MARSHALLER that lets beam-lisp drive that one fixpoint:
;
;   1. beam-lisp evaluates the non-recursive body clauses (patterns,
;      predicates) using its OWN engine \u2014 the single authority on what a
;      pattern means, including retraction and `as-of`. Those become BASE
;      RELATIONS (sets of integer tuples). This is bl's existing job; no new
;      semantics are invented here.
;   2. The recursive rules are translated to the native IR (atoms + computed
;      items for arithmetic). No evaluation happens in bl.
;   3. The native fixpoint runs ONCE (one boundary crossing) and returns the
;      closure as integer tuples.
;   4. bl decodes the tuples back to values.
;
; So bl owns: value\u2194integer, pattern meaning, decode. Native owns: the whole
; fixpoint. The responsibilities are DISJOINT \u2014 there is no join loop in bl to
; disagree with the join loop in Rust, because bl has none. The bl `derive-*`
; loops in `rules.bl` are what this REPLACES (see the cutover doc).
;
; ── Scope of the prototype ────────────────────────────────────────────
;
; The native kernel works over i64 tuples. Graph programs \u2014 reachability,
; connected components, shortest path, same-generation \u2014 are already integer
; valued (entity ids, weights), so they pass through directly. The full-spec
; generalisation (interning arbitrary values to integers and back) is
; described in the cutover doc; the mechanism here is identical, only the
; value\u2194integer step widens.

(ns datom.query.rules-native
  (:require [datom.query.parse] [datom.datalog :as nd]))

;; ── shape helpers (shared vocabulary with rules.bl) ─────────────────

(defn- rule-name [d] (first (get d 0)))
(defn- rule-head-args [d] (into [] (rest (get d 0))))
(defn- rule-body [d] (into [] (rest d)))

(defn- call-form? [c] (list? c))
(defn- invocation? [c names] (and (list? c) (contains? names (first c))))

;; arithmetic/comparison operators the native kernel understands
(def COMPUTED-OPS
  #{'+ '- '* 'min 'max '< '<= '> '>= '== '!=})
(def OP->KW
  {'+ :+ '- :- '* :* 'min :min 'max :max
   '< :< '<= :<= '> :> '>= :>= '== :== '!= :!=})

(defn- computed-clause?
  "A `[(op arg… ) out]` clause whose op is a native-computable primitive,
   or a bare `[(cmp a b)]` comparison guard."
  [c]
  (and (vector? c)
       (> (count c) 0)
       (list? (get c 0))
       (contains? COMPUTED-OPS (first (get c 0)))))

;; ── interning: symbols/keywords → dense integer ids ─────────────────
;;
;; Predicate names and variables become small ints for the IR. VALUES that
;; are already integers pass through unchanged (so arithmetic is real). A
;; value that is NOT an integer would need a value-intern table; the
;; prototype asserts integer values and points at the generalisation.

(defn- interner []
  ; a mutable-ish intern via an atom-like closure over a map in process dict
  (let [key (erlang/make_ref)]
    (erlang/put key {:fwd {} :next 0})
    key))

(defn- intern! [tbl sym]
  (let [st (erlang/get tbl)
        fwd (get st :fwd)]
    (if (contains? fwd sym)
      (get fwd sym)
      (let [id (get st :next)]
        (erlang/put tbl (assoc (assoc st :fwd (assoc fwd sym id)) :next (+ id 1)))
        id))))

;; ── translate a body clause to IR items ─────────────────────────────

(defn- term->ir
  "A rule argument → IR term. A variable → {0 slot}; an integer constant →
   {1 int}. `vslot` interns variables to slots."
  [vslot arg]
  (if (datom.query.parse/variable? arg)
    (nd/var-term (intern! vslot arg))
    (if (erlang/is_integer arg)
      (nd/const-term arg)
      (throw (ex-info "non-integer constant in a native rule (needs value interning)"
                      {:arg arg})))))

(defn- invocation->atom-item
  "A rule-invocation clause `(name a b)` → an atom body item."
  [pred-id vslot call]
  (nd/atom-item (nd/atom pred-id (mapv (fn [a] (term->ir vslot a)) (into [] (rest call))))))

(defn- computed->item
  "A `[(op args…) out]` computed clause → a computed body item. A bare
   comparison `[(< a b)]` (no out) is a guard."
  [vslot clause]
  (let [call (get clause 0)
        op (get OP->KW (first call))
        args (mapv (fn [a] (term->ir vslot a)) (into [] (rest call)))]
    (if (> (count clause) 1)
      (nd/computed-item op args (term->ir vslot (get clause 1)))
      ;; comparison guard: out is a dummy const 1 (kernel ignores out for cmp)
      (nd/computed-item op args (nd/const-term 1)))))

;; ── base relations from pattern/plain clauses (bl's authority) ──────
;;
;; A plain (non-recursive) body clause is evaluated by bl's OWN engine into
;; a set of value tuples, then interned to an integer relation the kernel
;; joins. This is where retraction / as-of / pattern semantics live \u2014 in
;; the one bl engine, computed once, not re-decided natively.

(defn- plain-clause-relation
  "Evaluate a plain clause via `eval-plain` over the whole db, projecting
   the clause's variables in a fixed order. Returns [pred-id var-order
   tuples] where tuples are integer rows."
  [db eval-plain vslot clause]
  ; the clause's variables, in first-appearance order = the base relation's columns
  (let [vars (filterv datom.query.parse/variable?
                      (cond
                        (vector? clause) (into [] clause)
                        :else []))
        ; run the clause against an empty binding: yields binding rows
        rows (eval-plain db {} clause)
        tuples (mapv (fn [b]
                       (mapv (fn [v]
                               (let [val (get b v)]
                                 (if (erlang/is_integer val)
                                   val
                                   (throw (ex-info "non-integer value in base relation (needs interning)"
                                                   {:var v :val val})))))
                             vars))
                     (into [] rows))]
    [vars tuples]))

;; ── the boundary: what the native kernel can and cannot evaluate ────
;;
;; The native path is complete for programs whose body clauses are one of:
;;   * a rule invocation             (the recursion)
;;   * a native computed primitive   (+ - * min max, comparisons)
;;   * a PLAIN pattern/predicate     bl pre-evaluates to a fixed base relation
;; The one thing it CANNOT do is an ARBITRARY bl function whose argument is a
;; RECURSIVE variable — e.g. `[(similar-to …)]` inside a recursive rule —
;; because that value only exists mid-fixpoint and its meaning lives in bl.
;; Such a program is not rejected outright; it runs on the ALL-BL fixpoint
;; (datom.query.rules), which is the single evaluator for that class. The
;; dispatch below is disjoint: a program is either fully native-evaluable or
;; fully bl-evaluated, so no input is ever evaluated two ways.

(defn- recursive-vars
  "Variables bound by a rule-invocation clause in `body` (the ones whose
   values only exist during the fixpoint)."
  [body names]
  (set (reduce (fn [acc c]
                 (if (invocation? c names)
                   (into acc (filterv datom.query.parse/variable? (into [] (rest c))))
                   acc))
               []
               (to-list body))))

(defn- non-native-predicate?
  "Whether `clause` is a CALL-form predicate/function that the native kernel
   does NOT understand — i.e. a `[(op …)]`/`[(op …) out]` whose op is not one
   of the native primitives. `similar-to` and arbitrary bl functions are
   here; `+`/`<`/etc are not."
  [clause names]
  (and (vector? clause)
       (> (count clause) 0)
       (list? (get clause 0))
       (not (invocation? clause names))
       (not (contains? COMPUTED-OPS (first (get clause 0))))))

(defn- native-compatible-clause?
  "Whether one body clause is native-evaluable.

   The ONLY incompatible shape is an ARBITRARY (non-primitive) call-form
   predicate/function — `[(similar-to …)]`, a bl fn — because bl must
   evaluate it and, if its input is a recursive variable, it cannot be
   pre-baked into a base relation. A pattern is always fine: even a pattern
   mentioning a recursive variable (`[?e :attr ?x]` after `(rule ?x)`)
   becomes a base RELATION that the kernel joins the recursive tuples
   against — the join is the kernel's job, and the relation is fixed.
   Rule invocations and native primitives are fine by construction."
  [clause names rec-vars]
  (cond
    (invocation? clause names) true
    (computed-clause? clause) true
    ;; an arbitrary bl predicate consuming a recursive var is the one
    ;; genuinely incompatible case — bl-only fixpoint handles it.
    (non-native-predicate? clause names)
      (let [vars (filterv datom.query.parse/variable?
                          (into [] (rest (get clause 0))))]
        (not (some (fn [v] (contains? rec-vars v)) vars)))
    ;; a plain pattern (vector, not a call form) is always a base relation
    (vector? clause) true
    :else false))

(defn native-compatible?
  "Whether an entire rule set can be evaluated by the native kernel. False
   ⇒ the caller must use the all-bl fixpoint for this program."
  [rules]
  (let [defs (to-list rules)
        names (set (mapv rule-name defs))]
    (every?
      (fn [d]
        (let [body (rule-body d)
              rec-vars (recursive-vars body names)
              ;; every constant in head/body must be an integer, else interning
              ;; is required (out of prototype scope)
              all-int? (every? (fn [c]
                                 (cond
                                   (invocation? c names)
                                     (every? (fn [a] (or (datom.query.parse/variable? a)
                                                         (erlang/is_integer a)))
                                             (into [] (rest c)))
                                   :else true))
                               (to-list body))]
          (and all-int?
               (every? (fn [c] (native-compatible-clause? c names rec-vars))
                       (to-list body)))))
      defs)))

;; ── the driver ──────────────────────────────────────────────────────

(defn materialise-native
  "Least fixpoint of `rules` over `db`, via the native kernel. Same signature
   and output shape as datom.query.rules/materialise: returns `{name
   tuple-set}` with value tuples.

   `strategy` (optional) picks the join: :indexed (default) or :nested.

   The program must be integer-valued (graph programs are). A non-integer
   value raises with a pointer to the interning generalisation."
  [db rules eval-plain]
  (let [defs (to-list rules)
        names (set (mapv rule-name defs))
        ;; intern predicate names (rule heads + invocations) and plain-clause
        ;; source predicates to dense ids
        pred-tbl (interner)
        ;; assign each rule-name a predicate id
        name->id (reduce (fn [m nm] (assoc m nm (intern! pred-tbl nm))) {} (into [] names))
        id->name (reduce (fn [m nm] (assoc m (get name->id nm) nm)) {} (into [] names))]
    ;; ── collect base relations from every distinct plain clause ──
    ;; Each plain clause becomes a fresh EDB predicate; its atom in the rule
    ;; references that predicate over the clause's variables.
    (let [edb-acc (erlang/make_ref)
          _ (erlang/put edb-acc {:rels [] :next-pred 1000000})   ; base preds start high
          ir-rules
          (reduce
            (fn [acc d]
              (let [head-id (get name->id (rule-name d))
                    vslot (interner)
                    ;; head atom
                    head-atom (nd/atom head-id
                                       (mapv (fn [a] (term->ir vslot a)) (rule-head-args d)))
                    ;; body items
                    body-items
                    (mapv
                      (fn [clause]
                        (cond
                          ;; recursive/rule invocation → atom over the rule pred id
                          (invocation? clause names)
                            (invocation->atom-item (get name->id (first clause)) vslot clause)
                          ;; computed arithmetic/comparison → computed item
                          (computed-clause? clause)
                            (computed->item vslot clause)
                          ;; plain clause (pattern/predicate) → evaluate to a base
                          ;; relation, allocate a fresh pred, reference it as an atom
                          :else
                            (let [rel (plain-clause-relation db eval-plain vslot clause)
                                  vars (get rel 0)
                                  tuples (get rel 1)
                                  st (erlang/get edb-acc)
                                  pid (get st :next-pred)]
                              (erlang/put edb-acc
                                          (assoc (assoc st :next-pred (+ pid 1))
                                                 :rels (conj (get st :rels)
                                                             (nd/edb-relation pid (count vars) tuples))))
                              (nd/atom-item (nd/atom pid (mapv (fn [v] (term->ir vslot v)) vars)))))
                        )
                      (rule-body d))]
                (conj acc (nd/rule head-atom body-items))))
            []
            defs)
          edb (get (erlang/get edb-acc) :rels)
          idb-ids (mapv (fn [nm] (get name->id nm)) (into [] names))]
      ;; ── run the native fixpoint, once ──
      ;; We materialise ALL idb predicates: call per rule-name, decode.
      (reduce
        (fn [out nm]
          (let [pid (get name->id nm)
                result (nd/eval ir-rules (to-list idb-ids) (to-list edb) pid 2)
                tuples (nd/tuples result)]
            (assoc out nm (set (into [] tuples)))))
        {}
        (into [] names)))))
