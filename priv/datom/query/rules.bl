; datom/query/rules.bl — user-defined recursive rules (Datalog's `%`).
;
; ── What this adds, and why it is the missing half ────────────────────
;
; Until now the engine could JOIN and FILTER and NEGATE, but it could not
; RECURSE: there was no way to say "reachable is an edge, OR an edge
; followed by something reachable". That single missing primitive is what
; separates a query language from a Datalog: transitive closure, connected
; components, shortest paths, PageRank, same-generation — the whole family
; of graph and fixpoint computations — are all *recursion over a relation
; until nothing new appears*. This file is that primitive.
;
; A RULE is a named relation defined by one or more implications:
;
;   [(reachable ?a ?b) [?a :edge ?b]]                    ; base case
;   [(reachable ?a ?b) [?a :edge ?x] (reachable ?x ?b)]  ; recursive case
;
; Read each as "the head holds when the body holds". The head is a call
; form `(name arg…)`; the body is ordinary `:where` clauses, and a body
; clause that is itself a `(name arg…)` call is a RULE INVOCATION — the
; recursion. A query supplies rules through `:in` with the `%` symbol
; (Datomic's spelling) and invokes them like any clause:
;
;   [:find ?b :in $ % ?start
;    :where [(reachable ?start ?b)]]
;
; ── How it evaluates: ONE fixpoint, native by default ─────────────────
;
; Rules are materialised BOTTOM-UP: start from the facts the base rules
; derive, then repeatedly apply the recursive rules to what is known,
; adding whatever is new, until a round adds nothing — the least fixpoint.
; The engine's existing top-down `run-clauses` then reads the finished
; relation like any other source. Bottom-up is what guarantees termination
; on cyclic graphs (a set of derived tuples cannot grow forever) where a
; naive top-down expansion would loop.
;
; ── One source of truth for the fixpoint ──────────────────────────────
;
; The fixpoint itself — unify, novelty, termination, the semi-naive delta —
; lives in exactly ONE place: the native kernel in `native/datom_datalog`,
; driven from `datom.query.fixpoint`. `materialise` DISPATCHES to it for
; every program the kernel can serve (which, with value interning, is every
; program whose recursion does not call an arbitrary bl function on a
; recursive variable). bl owns value↔integer, pattern meaning, and decode;
; native owns the whole join loop. There is no bl join loop to disagree with
; the Rust one.
;
; The one exception is a program whose recursion invokes an arbitrary bl
; predicate on a recursive variable (`[(similar-to ?x ?b)]` inside a
; recursive rule): that value only exists mid-fixpoint and its meaning lives
; in bl, so it cannot be pre-baked into a base relation. `derive-semi-naive`
; below is the SOLE evaluator for that disjoint program class — it is not a
; duplicate of the native kernel, it is the evaluator for the inputs the
; native kernel provably cannot take. `compatible?` picks between the
; two; a program is fully native OR fully bl, never evaluated both ways.

(ns datom.query.rules
  (:require [datom.query.parse] [datom.query.fixpoint]))

;; `flat-into` — map a function returning a vector over a collection and
;; concatenate the results (the engine's own helper, local here so this
;; namespace does not depend on the engine's private surface).
(defn- flat-into
  [f coll]
  (reduce (fn [acc x] (into acc (f x))) [] coll))

;; ── shape ───────────────────────────────────────────────────────────

(defn rule-definition?
  "Whether `x` is a rule DEFINITION: `[(name arg…) body-clause…]` — a
   vector whose first element is a call form (a list)."
  [x]
  (and (vector? x)
       (> (count x) 0)
       (list? (get x 0))))

(defn rules?
  "Whether `x` is a rule SET: a vector of rule definitions. This is what a
   query's `%` input carries."
  [x]
  (and (vector? x)
       (> (count x) 0)
       (every? rule-definition? (to-list x))))

(defn- rule-name [definition] (first (get definition 0)))
(defn- rule-head-args [definition] (into [] (rest (get definition 0))))
(defn- rule-body [definition] (into [] (rest definition)))

(defn- invocation?
  "Whether a body clause is a RULE INVOCATION of one of `names`: a call
   form `(name arg…)` whose operator is a defined rule (not a predicate or
   an analytic op). It is the recursion site."
  [clause names]
  (and (list? clause)
       (contains? names (first clause))))

(defn rule-names
  "The set of names a rule set defines."
  [rules]
  (set (mapv rule-name (to-list rules))))

;; ── grouping ────────────────────────────────────────────────────────

(defn- rules-by-name
  "Group definitions by head name: `{name [definition …]}`. A rule may
   have several definitions (base + recursive cases), all contributing to
   the one relation."
  [rules]
  (reduce (fn [m d]
            (let [n (rule-name d)]
              (assoc m n (conj (or (get m n) []) d))))
          {}
          (to-list rules)))

;; ── one rule application over a known relation state ─────────────────
;;
;; `state` maps each rule name to the SET of tuples derived for it so far
;; (each tuple a vector of values, positionally matching the head args).
;; `eval-body` is supplied by the engine: it evaluates a NON-recursive
;; clause list against the db and an initial binding set, returning
;; extended bindings. That keeps this file free of the join engine — it
;; only orchestrates the fixpoint and delegates ordinary evaluation.

(defn- relation->rows
  "Turn a relation (set of value tuples) for a rule into binding rows over
   the invocation's argument variables. `[[1 2] [3 4]]` invoked as
   `(reach ?x ?y)` becomes `[{?x 1 ?y 2} {?x 3 ?y 4}]`, but only tuples
   consistent with what `binding` already fixes survive (that is the join
   on a bound argument)."
  [relation call-args binding]
  (filterv some?
           (mapv (fn [tuple]
                   (reduce (fn [b i]
                             (if (nil? b)
                               nil
                               (let [arg (get call-args i)
                                     val (get tuple i)]
                                 (cond
                                   ; a variable: bind it (or check it agrees)
                                   (datom.query.parse/variable? arg)
                                     (if (contains? b arg)
                                       (if (= (get b arg) val) b nil)
                                       (assoc b arg val))
                                   ; a constant argument: must equal the tuple
                                   (= arg val) b
                                   :else nil))))
                           binding
                           (range (count call-args))))
                 (to-list relation))))

(defn- eval-body-with-relations
  "Evaluate one rule body against the db, treating rule-invocation clauses
   as reads from `state` (the relations known so far) and everything else
   as ordinary clauses via `eval-plain`.

   Returns the set of value tuples the body derives for `head-args`.
   `use-delta` names ONE rule whose invocation should read `delta` instead
   of its full relation — the semi-naive restriction. When nil, every
   invocation reads the full relation (the naive step).

   `seed-rows` are initial bindings over THIS definition's head vars,
   computed from the call sites (FEAT-025): a rule invoked with a bound
   argument evaluates its body with that constant in scope, so predicates
   over head args (in-force on ?date) fire instead of silently deriving
   nothing. Empty/nil seed-rows = the classic [{}] start (full relation)."
  [db body head-args names state delta use-delta eval-plain seed-rows]
  ; Split the body into rule invocations and plain clauses. Plain clauses
  ; go to the engine as a block; invocations are expanded here, each
  ; multiplying the binding set by its relation's matching tuples.
  (let [step (fn [rows clause]
               (if (invocation? clause names)
                 (let [nm (first clause)
                       call-args (into [] (rest clause))
                       ; the relation this invocation reads: the delta for
                       ; the designated recursive predicate, else its full
                       ; set. This single choice is the whole naive /
                       ; semi-naive difference.
                       relation (if (and (some? use-delta) (= nm use-delta))
                                  (or (get delta nm) #{})
                                  (or (get state nm) #{}))]
                   (flat-into (fn [b] (relation->rows relation call-args b)) rows))
                 ; a plain clause block: hand this single clause to the
                 ; engine, per current row.
                 (flat-into (fn [b] (eval-plain db b clause)) rows)))
        start (if (seq seed-rows) seed-rows [{}])
        final (reduce step start (to-list body))]
    (set (mapv (fn [b] (mapv (fn [a]
                               (if (datom.query.parse/variable? a) (get b a) a))
                             head-args))
               final))))

(defn- apply-rules-once
  "One round of applying every definition. Returns the map of NEW tuples
   per rule name (those not already in `state`). `use-delta` selects
   naive (nil) vs semi-naive (read deltas for recursive self-reference).
   `seeds` maps rule name → positional seed maps `{position value}` from
   the call sites; each definition maps positions onto its own head vars."
  [db grouped names state delta use-delta eval-plain seeds]
  (reduce
    (fn [new-map nm]
      (let [defs (get grouped nm)
            derived (reduce
                      (fn [acc d]
                        (into acc
                              (eval-body-with-relations
                                db (rule-body d) (rule-head-args d)
                                names state delta use-delta eval-plain
                                (seed-rows-for d (get seeds nm)))))
                      #{}
                      defs)
            known (or (get state nm) #{})
            fresh (into #{} (filterv (fn [t] (not (contains? known t)))
                                     (into [] derived)))]
        (assoc new-map nm fresh)))
    {}
    (into [] names)))

;; ── call-site seeds (FEAT-025) ──────────────────────────────────────
;;
;; Bottom-up materialisation computes each rule's relation with an EMPTY
;; initial binding — so a body predicate over a HEAD argument
;; ([(<= ?from ?date)] with ?date bound only at the call site) never fires.
;; The answer is ADORNMENT (magic sets' little sibling): find the rule
;; invocations, take positions bound by constants or query inputs at EVERY
;; call site, and evaluate bodies with those constants in the initial rows.
;; Constants then PROPAGATE: a seeded head var passed to another rule's
;; invocation seeds that rule too (fixpoint below) — so a precondition rule
;; invoking a temporal rule carries its date down.
;;
;; Soundness: a position free in ANY invocation (query or rule body) is
;; never seeded — a free call site must see the full relation. Seeds carry
;; only constants drawn from the query, so the lattice is finite and the
;; fixpoint terminates.

(def ^:private composite-ops #{:or :and :not :or-join :not-join})

(defn- composite-clause? [c]
  (and (vector? c) (contains? composite-ops (get c 0))))

(defn- scan-invocations
  "Every rule-invocation clause in a where/body tree, descending into
   :or/:and/:not composites. Anything not an invocation is ignored — a
   MISSED invocation would under-seed, so the walker favours recall."
  [clauses names]
  (flat-into
    (fn [c]
      (cond
        (invocation? c names) [c]
        (composite-clause? c)
          (scan-invocations
            (filterv (fn [x] (or (list? x) (composite-clause? x)))
                     (into [] (rest c)))
            names)
        :else []))
    clauses))

(defn- seed-rows-for
  "Initial binding rows for one DEFINITION, mapping positional seeds onto
   the definition's own head vars (different defs may name them
   differently)."
  [definition posmaps]
  (let [hargs (rule-head-args definition)]
    (into []
          (mapv (fn [pm]
                  (reduce (fn [row kv]
                            (assoc row (get hargs (key kv)) (val kv)))
                          {}
                          (to-list pm)))
                (to-list posmaps)))))

(defn- invocation-posmap
  "The positional seeds one invocation contributes: constant args directly,
   variable args through `bound-map` (query inputs, or the enclosing rule's
   seeded head vars during propagation)."
  [call-args head-arity bound-map]
  (reduce
    (fn [m i]
      (let [arg (get call-args i)]
        (cond
          (not (datom.query.parse/variable? arg))
            (assoc m i arg)
          (contains? bound-map arg)
            (assoc m i (get bound-map arg))
          :else m)))
    {}
    (range (min head-arity (count call-args)))))

(defn- intersect-positions
  "Positions present in EVERY posmap; values kept per posmap."
  [posmaps]
  (if (empty? posmaps)
    []
    (let [common (reduce
                   (fn [ks m] (filterv (fn [k] (contains? m k)) ks))
                   (into [] (mapv (fn [kv] (key kv))
                                  (to-list (get posmaps 0))))
                   posmaps)]
      (into []
            (distinct
              (mapv (fn [m]
                      (reduce (fn [r k] (assoc r k (get m k))) {} common))
                    posmaps))))))

(defn- normalize-seeds [m]
  (reduce (fn [a kv]
            (assoc a (key kv) (into [] (distinct (to-list (val kv))))))
          {}
          (to-list m)))

(defn invocation-seeds
  "Per-rule seed positions for a query: `{rule-name [{position value} …]}`.
   Computed from the where tree, then propagated through rule bodies to a
   fixpoint. `input-binding` is the query's :in row (single-row only — the
   caller passes {} when inputs are multi-row)."
  [rules where-clauses input-binding]
  (let [grouped (rules-by-name rules)
        names (rule-names rules)
        arity-of (fn [nm] (count (rule-head-args (get (get grouped nm) 0))))
        query-maps
        (reduce
          (fn [acc c]
            (let [nm (first c)
                  call-args (into [] (rest c))
                  pm (invocation-posmap call-args (arity-of nm) input-binding)]
              (assoc acc nm (conj (or (get acc nm) []) pm))))
          {}
          (scan-invocations where-clauses names))]
    (loop [seeds query-maps]
      (let [grown
            (reduce
              (fn [acc d]
                (let [nm (rule-name d)
                      hargs (rule-head-args d)
                      sub-invs (scan-invocations (rule-body d) names)]
                  (reduce
                    (fn [acc2 pm]
                      (let [var-vals
                            (reduce (fn [m kv]
                                      (assoc m (get hargs (key kv)) (val kv)))
                                    {}
                                    (to-list pm))]
                        (reduce
                          (fn [acc3 sub]
                            (let [snm (first sub)
                                  sargs (into [] (rest sub))
                                  spm (invocation-posmap sargs (arity-of snm)
                                                         var-vals)]
                              (assoc acc3 snm
                                     (conj (or (get acc3 snm) []) spm))))
                          acc2
                          sub-invs)))
                    acc
                    (or (get acc nm) []))))
              seeds
              (to-list rules))]
        (if (= (normalize-seeds grown) (normalize-seeds seeds))
          (reduce (fn [a kv]
                    (assoc a (key kv) (intersect-positions (val kv))))
                  {}
                  (to-list seeds))
          (recur grown))))))

;; ── the two fixpoint evaluators ─────────────────────────────────────

;; The SOLE evaluator for the one program class the native kernel cannot
;; serve: recursion that calls an arbitrary bl predicate on a recursive
;; variable. For every other program `materialise` dispatches to the native
;; kernel, so this loop never runs on native-compatible input. It is not a
;; duplicate of the native fixpoint — it is the evaluator for a disjoint set
;; of inputs the native kernel provably cannot take.
(defn derive-semi-naive
  "Least fixpoint by SEMI-NAIVE evaluation — the bl fallback path.

   The insight: a fact is newly derivable this round only if its
   derivation used a fact that was newly derived LAST round. So instead of
   re-joining the whole relation each round, join only the DELTA (last
   round's new tuples) against the base relations. Each derivation happens
   about once rather than once per remaining round \u2014 the asymptotic win the
   profiling example measures.

   Round 0 seeds the deltas from the base (non-recursive) derivations; each
   later round applies rules with self-invocations reading the delta, then
   the new tuples become the next delta."
  ([db rules eval-plain]
   (derive-semi-naive db rules eval-plain {}))
  ([db rules eval-plain seeds]
   (let [grouped (rules-by-name rules)
         names (rule-names rules)
         empty-state (reduce (fn [m n] (assoc m n #{})) {} (into [] names))]
    ; seed: one naive round from empty state derives the base facts.
    (let [seed (apply-rules-once db grouped names empty-state {} nil eval-plain seeds)
          state0 (reduce (fn [m n] (assoc m n (get seed n))) empty-state (into [] names))]
      (loop [state state0 delta seed rounds 1]
        (let [any-delta (some (fn [n] (seq (get delta n))) (into [] names))]
          (if (not any-delta)
            [state rounds]
            ; apply rules with self-invocations reading the delta. For each
            ; rule we run once per recursive predicate that could feed it,
            ; restricting THAT invocation to the delta; here we take the
            ; simple, correct form: read the delta for the rule's own name
            ; (direct recursion), full state for any other invocation.
            (let [new-map (reduce
                            (fn [acc nm]
                              (assoc acc nm
                                     (get (apply-rules-once
                                            db grouped names state delta nm eval-plain seeds)
                                          nm)))
                            {}
                            (into [] names))
                  ; keep only genuinely-new tuples (not already in state)
                  fresh (reduce (fn [m n]
                                  (let [known (get state n)
                                        cand (get new-map n)]
                                    (assoc m n (into #{} (filterv (fn [t] (not (contains? known t)))
                                                                  (into [] cand))))))
                                {}
                                (into [] names))
                  any-fresh (some (fn [n] (seq (get fresh n))) (into [] names))]
              (if (not any-fresh)
                [state rounds]
                (recur (reduce (fn [m n] (assoc m n (into (get m n) (get fresh n))))
                               state (into [] names))
                       fresh
                       (+ rounds 1)))))))))))

;; ── public: materialise a rule set to relations ─────────────────────

(defn- effective-seeds?
  "Whether a seed map actually CONSTRAINS the recursion — the true test for
   'should this fall off the native path'.

   `invocation-seeds` returns a map `{rule-name [posmap ...]}` where each posmap
   pins argument positions to constant/bound values. But a call site that binds
   NOTHING still contributes an EMPTY posmap `{}`, so the map is structurally
   non-empty (`{reaches [{}] calls [{}]}`) while carrying no demand at all. The
   old dispatch tested `(empty? seeds)` and thus mis-routed EVERY recursive
   query — seeded or not — onto the slow bl semi-naive path, because the map was
   never literally empty. This tests what matters: seeds are effective iff some
   posmap pins at least one position. All-empty posmaps mean 'no demand' — the
   program is native-eligible and must take the fast kernel."
  [seeds]
  (some (fn [kv] (some (fn [pm] (not (empty? pm))) (val kv)))
        (to-list seeds)))

(defn materialise
  "Evaluate `rules` against `db` to their least fixpoint, returning
   `{name relation}` where each relation is a set of value tuples.

   THE ONE SEAM. Dispatches on `compatible?`: a compatible
   program goes to the native kernel (datom.query.fixpoint) — the one place the
   fixpoint lives, and, with value interning, that is every program whose
   recursion does not call an arbitrary bl fn on a recursive variable.
   Otherwise it takes the bl fallback `derive-semi-naive`, the sole evaluator
   for that disjoint class. Dispatch is total and disjoint: one path per
   program, no input evaluated two ways. `eval-plain` is the engine callback
   for ordinary clauses (base relations on the native path; direct evaluation
   on the bl path).
   `seeds` (FEAT-025) maps rule name → positional seed maps from the call
   sites. The native kernel does not know seeds: any seeded program takes
   the bl fixpoint. Correctness first — an unseeded program's dispatch is
   unchanged."
  ([db rules eval-plain]
   (materialise db rules eval-plain {}))
  ([db rules eval-plain seeds]
   (if (and (not (effective-seeds? seeds)) (datom.query.fixpoint/compatible? rules))
    ;; structurally native. Try the kernel; if the DATA is beyond i64 (a float
    ;; in an arithmetic column), the driver raises a tagged fallback signal —
    ;; catch exactly that and re-run on the bl fixpoint (the program is still
    ;; computable, just not by the i64 kernel). Any other error propagates.
    (try (datom.query.fixpoint/materialise db rules eval-plain)
         (catch e (if (datom.query.fixpoint/fallback-signal? e)
                    (get (derive-semi-naive db rules eval-plain seeds) 0)
                    (throw e))))
    (get (derive-semi-naive db rules eval-plain seeds) 0))))


(defn relation-for
  "The materialised relation for a rule `name`, as binding rows over an
   invocation's `call-args` consistent with `binding`. This is what the
   engine calls when it meets a rule-invocation clause in `:where`."
  [relations name call-args binding]
  (relation->rows (or (get relations name) #{}) call-args binding))

; ══ the GREATEST-fixpoint dual (P23) ══════════════════════════════════════
;
; derive-semi-naive computes a LEAST fixpoint: seed empty, ADD what the rules
; force, stop when nothing new is added. A dual family of problems — CTL safe
; regions, bisimulation, Houdini invariant discovery — is the opposite shape:
; seed FULL, REMOVE what a monotone rule condemns, stop when nothing else falls.
;
; derive-gfp is that dual, IN the engine, with the same semi-naive delta win: a
; tuple can NEWLY fall only if one of its dependencies fell last round, so each
; round re-checks only the frontier, not the whole relation. `survives?` is
; (tuple current-set → bool), monotone in the set (growing the set can only keep
; more — the caller's obligation). `depends-on?` is (tuple fell-set → bool): a
; sound over-approximation of 'this tuple's survival could change because those
; fell'. Returns {:relation S* :rounds N :checks M} — M counts survives? calls so
; the delta's economy is measurable. This is the native-engine form of
; system.gfp/gfp-delta: the result is a RELATION, and the same optimiser that
; serves the least fixpoint serves this one.

(defn derive-gfp
  [seed survives? depends-on?]
  (loop [s seed to-check (into [] seed) rounds 0 checks 0]
    (let [fell   (into #{} (filterv (fn [t] (not (survives? t s))) to-check))
          checks (+ checks (count to-check))]
      (if (empty? fell)
        {:relation s :rounds rounds :checks checks}
        (let [s2  (into #{} (filterv (fn [t] (not (contains? fell t))) (into [] s)))
              nxt (into [] (filterv (fn [t] (depends-on? t fell)) (into [] s2)))]
          (recur s2 nxt (+ rounds 1) checks))))))

(defn materialise-gfp
  "Public greatest-fixpoint entry: the largest subset of `seed` closed under
   `survives?`. `depends-on?` defaults to 'anything could change' (a full
   re-scan, always sound) when the caller has no dependency information.
   Returns just the relation (a set) — the gfp analogue of materialise."
  ([seed survives?]
   (materialise-gfp seed survives? (fn [t fell] true)))
  ([seed survives? depends-on?]
   (:relation (derive-gfp seed survives? depends-on?))))
