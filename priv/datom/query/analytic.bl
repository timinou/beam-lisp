; datom/query/analytic.bl — generating clauses that read the store.
;
; ── What sets these apart from predicates ─────────────────────────────
;
; A predicate clause `[(> ?a 40)]` is a pure function of a row: it reads
; variables already bound and either keeps the row or drops it. It never
; touches the database and never invents a row.
;
; An analytic clause does both. `[(similar-to :doc/embedding ?q 10) [?e ?score]]`
; READS the store (every embedding in that column) and GENERATES rows (one
; per near neighbour), binding `?e` and `?score` that nothing bound before.
; It is, in datalog terms, closer to a pattern than a predicate — a source
; of bindings — which is why it gets its own evaluator rather than riding
; the function-resolution path.
;
; ── The two modes, and why the second is the whole point ──────────────
;
; `similar-to` behaves differently depending on whether its output entity
; is already bound, and this falls straight out of unification:
;
;   FREE ?e   — generate: emit the k nearest as new rows. Ordinary kNN.
;   BOUND ?e  — filter: score only the entities upstream clauses already
;               selected, keep those that are genuine neighbours.
;
; The bound case is the one a bolted-on vector database cannot do. When a
; query says "notes tagged :work AND semantically near ?q", the tag clause
; runs first and binds ?e to a handful of entities; `similar-to` then scores
; exactly those, in the same engine, transactionally consistent with the
; facts it just joined against. No copying a candidate set out to a separate
; system and back. The similarity is a JOIN KEY like any other.
;
; ── Where the DB semantics live ───────────────────────────────────────
;
; This layer reads CURRENT datoms through `datom.db/attr-datoms`, so
; retraction and time-travel filtering have already happened — a
; similarity search `as-of` last week sees last week's corpus for free,
; because it reads the same filtered datoms every other query reads. The
; vector MATH is in Rust (`datom.vector/search`); the choice of WHICH
; vectors to compare is datalog's, here, basis-aware.

(ns datom.query.analytic
  (:require [datom.db] [datom.index] [datom.query.parse] [datom.vector]))

(defn- resolve-arg
  "A clause argument's value: looked up in `bindings` when it is a
   variable, taken literally otherwise. The same resolution a predicate's
   arguments get."
  [bindings term]
  (if (datom.query.parse/variable? term)
    (get bindings term)
    term))

(defn- as-embedding
  "Coerce a query argument to a `DVec`.

   Accepts a `DVec` directly (the usual case: an embedding computed
   outside and passed via `:in`), or a sequence of numbers (convenience
   for a literal query vector written inline). Anything else is a caller
   error worth failing on rather than scoring as garbage."
  [v]
  (cond
    (datom.vector/vec? v) v
    (or (vector? v) (seq? v)) (datom.vector/embedding v)
    :else (throw (ex-info "similar-to: query is not an embedding or number sequence"
                          {:value v}))))

(defn- similar-to
  "Evaluate `(similar-to attr query k [rerank])`, returning `[[e score] …]`.

   `attr` is the embedding column, `query` an embedding (or numbers), `k`
   how many neighbours. Optional `rerank` overrides the binary-quantisation
   candidate width (see datom.vector); omitted, it scales with k, and `0`
   forces an exact flat scan.

   The corpus is every CURRENT datom of `attr` (basis-filtered upstream),
   paired as `[entity embedding]`. A datom whose value is not a `DVec`
   (a mis-typed column) is skipped rather than crashing the query."
  [db args bound-entities]
  (let [attr (get args 0)
        query (as-embedding (get args 1))
        k (get args 2)
        rerank (if (> (count args) 3) (get args 3) (datom.vector/default-rerank k))
        ; The full corpus for this column, `[entity dvec]` per current datom.
        all (filterv some?
                     (mapv (fn [d]
                             (let [e (datom.index/-e d)
                                   v (datom.index/-v d)]
                               (if (datom.vector/vec? v) [e v] nil)))
                           (datom.db/attr-datoms db attr)))
        ; If upstream clauses already bound the output entity, PREFILTER the
        ; corpus to those entities before searching — so the k nearest are the
        ; k nearest OF THE CANDIDATE SET, not the k nearest globally that then
        ; happen to survive a filter. This is what lets `[?e :tag :x]
        ; [(similar-to …) [?e ?score]]` return the best-matching tagged entity
        ; even when it is far down the global ranking. When the entity is free,
        ; `bound-entities` is nil and the whole corpus is searched (ordinary
        ; kNN).
        candidates (if (nil? bound-entities)
                     all
                     (filterv (fn [c] (contains? bound-entities (get c 0))) all))]
    (datom.vector/search query candidates k rerank)))

;; ── the corpus of an embedding column ───────────────────────────────

(defn- embedding-corpus
  "Every `[entity dvec]` for a `:db.type/vector` attribute, current-basis.
   The input to clustering and projection, exactly as for search."
  [db attr]
  (filterv some?
           (mapv (fn [d]
                   (let [e (datom.index/-e d) v (datom.index/-v d)]
                     (if (datom.vector/vec? v) [e v] nil)))
                 (datom.db/attr-datoms db attr))))

;; ── clustering by embedding ─────────────────────────────────────────

(defn- cluster-op
  "`(cluster attr opts)` → `[[e cluster-id] …]`.

   `opts` is a map: `{:method :k-means :k 5}` (only k-means in this wave;
   the verb is named generically so density methods can join later without
   a syntax change). `:iters` and `:seed` are optional refinement controls."
  [db args]
  (let [attr (get args 0)
        opts (or (get args 1) {})
        k (or (get opts :k) 5)
        iters (or (get opts :iters) 20)
        seed (or (get opts :seed) 42)]
    (datom.vector/cluster (embedding-corpus db attr) k iters seed)))

;; ── dimensionality reduction ────────────────────────────────────────

(defn- project-2d-op
  "`(project-2d attr)` → `[[e x y] …]`, PCA coordinates per entity."
  [db args]
  (datom.vector/project-2d (embedding-corpus db (get args 0))))

;; ── community detection over the reference graph ─────────────────────
;;
;; These do NOT use embeddings. They read the GRAPH the ref attributes
;; already form — `[?a :person/friend ?b]` is an edge — and group entities
;; by CONNECTION rather than by content. This is datalog's home turf: the
;; canonical recursive-datalog examples (connected components, label
;; propagation) are exactly these, and here they run over the same datoms.

(defn- edges-of
  "Undirected edges of a ref attribute, as `[[a b] …]`. Each ref datom
   `[a attr b]` contributes the pair; reverse is added so reachability is
   symmetric (a friendship graph is undirected even when stored one way)."
  [db attr]
  (reduce (fn [acc d]
            (let [a (datom.index/-e d) b (datom.index/-v d)]
              (conj acc [a b])))
          []
          (datom.db/attr-datoms db attr)))

(defn- nodes-of
  "Every entity that appears as either endpoint of `edges`."
  [edges]
  (into [] (distinct (reduce (fn [acc e] (conj (conj acc (get e 0)) (get e 1))) [] edges))))

(defn- components-op
  "`(components attr)` → `[[e component-id] …]`, connected components of the
   ref graph by union-find. Two entities share a component id iff a path of
   references connects them. The simplest community structure: who is
   reachable from whom.

   NB: this is a HOST-LANGUAGE (union-find) implementation, kept because it
   is a single near-linear pass. The SAME result is now expressible as pure
   recursive Datalog — `[(cc ?a ?b) (link ?a ?b)] [(cc ?a ?b) (link ?a ?x)
   (cc ?x ?b)]` with a `min` label in an outer stratum (see
   examples/datom/12-recursive-rules.bl); the two induce the identical
   partition. This verb is a performance specialisation of that rule, not a
   substitute for a missing primitive."
  [db args]
  (let [edges (edges-of db (get args 0))
        nodes (nodes-of edges)
        ; Union-find over a plain parent map. `root` walks the chain
        ; ITERATIVELY (a recursive walk would overflow the stack on a long
        ; `(a b)(b c)…` chain), and unions attach the larger root under the
        ; smaller — deterministic, and a consistent direction that keeps the
        ; chains from growing without bound (the unbalanced version was O(n²)).
        parent (reduce (fn [m n] (assoc m n n)) {} nodes)]
    (letfn [(root [p x]
              (loop [cur x]
                (if (= (get p cur) cur) cur (recur (get p cur)))))]
      (let [merged (reduce (fn [p edge]
                             (let [ra (root p (get edge 0))
                                   rb (root p (get edge 1))]
                               (cond
                                 (= ra rb) p
                                 (< ra rb) (assoc p rb ra)
                                 :else (assoc p ra rb))))
                           parent
                           edges)]
        (mapv (fn [n] [n (root merged n)]) nodes)))))

(defn- community-op
  "`(community attr opts)` → `[[e community-id] …]` by LABEL PROPAGATION.

   Each node starts as its own community; repeatedly, every node adopts the
   community that most of its neighbours hold, until labels stop changing
   (a fixpoint). This finds finer structure than connected components — two
   densely-linked groups joined by a single edge stay separate. Label
   propagation is a HOST-LANGUAGE fixpoint loop here (a non-monotonic
   heuristic — majority vote — that is NOT a pure monotone Datalog rule, so
   unlike `components` it does not reduce to a simple recursive rule). The
   engine's recursive rules (examples/datom/12-recursive-rules.bl) express
   the MONOTONE graph algorithms — reachability, connected components,
   shortest paths; label propagation stays here because its majority step is
   inherently non-monotone. `opts` may set `:iters` (default 10)."
  [db args]
  (let [attr (get args 0)
        opts (or (get args 1) {})
        iters (or (get opts :iters) 10)
        edges (edges-of db attr)
        nodes (nodes-of edges)
        ; adjacency: node -> vector of neighbours (both directions)
        adj (reduce (fn [m edge]
                      (let [a (get edge 0) b (get edge 1)]
                        (assoc (assoc m a (conj (or (get m a) []) b))
                               b (conj (or (get m b) []) a))))
                    {}
                    edges)
        ; the most frequent label among a node's neighbours (ties: smallest
        ; label, so the result is deterministic)
        majority (fn [labels node]
                   (let [neigh (or (get adj node) [])]
                     (if (empty? neigh)
                       (get labels node)
                       (let [counts (reduce (fn [c nb]
                                              (let [l (get labels nb)]
                                                (assoc c l (+ 1 (or (get c l) 0)))))
                                            {}
                                            neigh)
                             best (reduce (fn [acc entry]
                                            (let [l (key entry) n (val entry)]
                                              (cond
                                                (nil? acc) [l n]
                                                (> n (get acc 1)) [l n]
                                                (and (= n (get acc 1)) (< l (get acc 0))) [l n]
                                                :else acc)))
                                          nil
                                          (seq counts))]
                         (get best 0)))))
        init (reduce (fn [m n] (assoc m n n)) {} nodes)]
    ; ASYNCHRONOUS propagation: within a sweep, fold over the nodes updating
    ; the label map IN PLACE, so a node sees the labels its already-processed
    ; neighbours took THIS pass. Synchronous (all-at-once) updates oscillate on
    ; a bipartite graph — two nodes joined by one edge would swap labels every
    ; sweep and never converge; the asynchronous rule settles them. A sweep
    ; that changes nothing is the fixpoint. `nodes` is walked in a stable order
    ; so the result is deterministic.
    (loop [labels init attempt 0]
      (if (>= attempt iters)
        (mapv (fn [n] [n (get labels n)]) nodes)
        (let [swept (reduce (fn [m n] (assoc m n (majority m n))) labels nodes)]
          (if (= swept labels)
            (mapv (fn [n] [n (get labels n)]) nodes)
            (recur swept (+ attempt 1))))))))

(defn eval-op
  "Dispatch an analytic operator to its implementation, returning a
   sequence of OUTPUT TUPLES the engine unifies against the clause's
   output terms.

   `similar-to` searches an embedding column; `cluster` and `project-2d`
   partition/plot it; `community` and `components` group the REFERENCE
   graph by connection. Each returns `[entity value…]` tuples the engine
   unifies against the clause's output terms."
  [db bindings op arg-terms out-terms]
  (let [args (mapv (fn [t] (resolve-arg bindings t)) arg-terms)
        ; The first output term is the ENTITY. If it is a variable already
        ; bound in this row, the clause is a prefiltered search: restrict the
        ; corpus to that entity. A free (or wildcard) entity leaves it nil,
        ; meaning "search everything". Only `similar-to` consults this; the
        ; other verbs partition/plot the whole column regardless.
        entity-term (if (and (some? out-terms) (> (count out-terms) 0))
                      (get out-terms 0)
                      nil)
        bound-entities (if (and (some? entity-term)
                                (datom.query.parse/variable? entity-term)
                                (contains? bindings entity-term))
                         #{(get bindings entity-term)}
                         nil)]
    (cond
      (= op 'similar-to) (similar-to db args bound-entities)
      (= op 'cluster) (cluster-op db args)
      (= op 'project-2d) (project-2d-op db args)
      (= op 'community) (community-op db args)
      (= op 'components) (components-op db args)
      :else (throw (ex-info (str "unknown analytic operator: " op) {:op op})))))
