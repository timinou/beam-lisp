; datom/query/parse.bl — a query is DATA, not a string.
;
; ── Why that matters more than it sounds ──────────────────────────────
;
; SQL is a string. To build one you concatenate, which is why injection
; exists, why query builders exist, and why composing two queries means
; string surgery.
;
; A datalog query is a VECTOR:
;
;   [:find ?name ?age
;    :in $ ?min-age
;    :where
;    [?e :person/name ?name]
;    [?e :person/age ?age]
;    [(>= ?age ?min-age)]]
;
; So a program can BUILD one with `conj`, inspect one with `get`, store
; one in a database, or generate clauses in a loop — using the collection
; functions it already has. There is no query language to parse, because
; the query is already the data structure the parser would have produced.
;
; In beam-lisp this is even more direct than in Clojure-on-Datomic: the
; reader produces vectors and keywords, and `?name` is just a symbol.
; Nothing crosses a boundary.
;
; ── What this file does ───────────────────────────────────────────────
;
; Turns that flat vector into a map the planner and engine can work with:
;
;   {:find [?name ?age] :in [$ ?min-age] :where [clause …]}
;
; Plus the vocabulary for asking about clause and term SHAPES, which is
; what the planner dispatches on.

(ns datom.query.parse)

;; ── variables ───────────────────────────────────────────────────────
;;
;; A logic variable is a symbol whose name starts with `?`. That is the
;; whole rule — the same one Datomic uses.

(defn variable?
  "Whether `x` is a logic variable (`?name`)."
  [x]
  (and (symbol? x)
       (let [n (name x)]
         (and (> (count n) 1) (= "?" (subs n 0 1))))))

(defn blank?
  "Whether `x` is the wildcard `_`, which matches anything and binds
   nothing.

   Distinct from a variable: two `_` in one clause are INDEPENDENT, while
   two occurrences of `?x` must agree. Treating `_` as a variable named
   `_` would silently join unrelated positions."
  [x]
  (and (symbol? x) (= "_" (name x))))

(defn source?
  "Whether `x` names a data source (`$`, `$other`).

   Only the default `$` is supported; the shape is recognised so a query
   written for multiple sources fails with a clear message rather than
   being silently misread."
  [x]
  (and (symbol? x)
       (let [n (name x)]
         (and (> (count n) 0) (= "$" (subs n 0 1))))))

(defn constant?
  "Whether `x` is a literal value rather than a variable or wildcard."
  [x]
  (not (or (variable? x) (blank? x) (source? x))))

;; ── clause shapes ───────────────────────────────────────────────────

(defn pattern-clause?
  "A data pattern: `[?e :person/name ?name]`.

   Distinguished from a predicate by its FIRST element: a pattern begins
   with an entity term, a predicate begins with a nested call form."
  [clause]
  (and (vector? clause)
       (> (count clause) 0)
       (not (list? (get clause 0)))
       (not (keyword? (get clause 0)))))

(defn predicate-clause?
  "A predicate or function call: `[(>= ?age 21)]` or `[(inc ?x) ?y]`.

   The nested list is the giveaway — `(>= ?age 21)` is a call form, not
   a datom pattern."
  [clause]
  (and (vector? clause)
       (> (count clause) 0)
       (list? (get clause 0))))

(defn rule-clause?
  "A logical combinator: `[:or …]`, `[:not …]`, `[:and …]`.

   Datomic spells these `(or …)` / `(not …)` as lists. beam-lisp uses a
   leading KEYWORD instead, because a bare list in clause position is
   already how predicates are spelled, and distinguishing `(or …)` from
   `(>= …)` would mean special-casing operator names — a keyword says
   what it is."
  [clause]
  (and (vector? clause)
       (> (count clause) 0)
       (keyword? (get clause 0))))

;; ── the query map ───────────────────────────────────────────────────

(defn- section-keyword?
  [x]
  (contains? #{:find :in :where :with} x))

(defn parse
  "Split a flat query vector into its sections.

   Returns `{:find […] :in […] :where […]}`. Sections may appear in any
   order, and `:in` defaults to `[$]` — the implicit database argument,
   as in Datomic.

   Also accepts the MAP form (`{:find […] :where […]}`), which is what
   Datomic's own `q` takes when a query is built programmatically: the
   flat vector is friendlier to write, the map is friendlier to
   assemble."
  [query]
  (if (map? query)
    {:find (or (:find query) [])
     :in (or (:in query) ['$])
     :where (or (:where query) [])}
    (let [sections (reduce (fn [acc term]
                             (if (section-keyword? term)
                               (assoc acc :current term)
                               (let [k (:current acc)]
                                 (if (nil? k)
                                   (throw (ex-info "a query must begin with a section keyword"
                                                   {:term term :query query}))
                                   (assoc acc k (conj (or (get acc k) []) term))))))
                           {:current nil}
                           query)]
      {:find (or (:find sections) [])
       :in (or (:in sections) ['$])
       :where (or (:where sections) [])})))

(defn find-variables
  "The variables a query returns, in order."
  [parsed]
  (filterv variable? (:find parsed)))

(defn input-variables
  "The `:in` variables, excluding data sources.

   Only the SCALAR form. `binding-forms` below describes the full set;
   this stays scalar-only because it answers `which variables does the
   caller supply one value for?`, which is what arity checking needs."
  [parsed]
  (filterv variable? (:in parsed)))

;; ── :in binding forms ────────────────────────────────────────
;;
;; Datomic has four, and they are not sugar for one another — each says
;; something different about the SHAPE of the value being passed in:
;;
;;   ?x           scalar     one value
;;   [?x ...]     collection many values, one variable  -> one row each
;;   [?x ?y]      tuple      one value per variable     -> one row
;;   [[?x ?y]]    relation   many rows of several vars  -> a table
;;
;; The collection form is what makes `IN (...)` queries expressible, and
;; the relation form is how you join against data the database does not
;; hold — a list of ids from another service, say. Without them every
;; such query has to be built by string manipulation or run N times.

(defn collection-binding?
  "`[?x ...]` — many values for one variable."
  [form]
  (and (vector? form)
       (= 2 (count form))
       (variable? (get form 0))
       (= (quote ...) (get form 1))))

(defn relation-binding?
  "`[[?x ?y]]` — a table of rows."
  [form]
  (and (vector? form)
       (= 1 (count form))
       (vector? (get form 0))
       (every? variable? (get form 0))))

(defn tuple-binding?
  "`[?x ?y]` — one value per variable, destructured from one tuple."
  [form]
  (and (vector? form)
       (> (count form) 0)
       (every? variable? form)
       (not (collection-binding? form))))

(defn binding-form-variables
  "Every variable an `:in` form binds, whatever its shape."
  [form]
  (cond
    (variable? form) [form]
    (collection-binding? form) [(get form 0)]
    (relation-binding? form) (into [] (get form 0))
    (tuple-binding? form) (into [] form)
    :else []))

(defn binding-forms
  "The `:in` forms that BIND, in order — data sources excluded.

   These are what `q`'s arguments correspond to, positionally."
  [parsed]
  (filterv (fn [f] (seq (binding-form-variables f))) (:in parsed)))

(defn all-input-variables
  "Every variable bound by `:in`, across all four forms."
  [parsed]
  (into [] (mapcat binding-form-variables (binding-forms parsed))))

(defn all-variables
  "Every variable mentioned anywhere in `clause`, however deeply nested.

   Patterns hold theirs at the top level; a predicate's live inside its
   call form; a rule's inside its sub-clauses."
  [clause]
  (cond
    (variable? clause) [clause]
    (or (vector? clause) (list? clause))
      (into [] (distinct (into [] (mapcat all-variables clause))))
    :else []))

(defn binding-variables
  "The variables a clause BINDS, as opposed to those it merely reads.

     [?e :p/age ?a]      binds ?e and ?a
     [(* ?a 2) ?d]       binds ?d only — ?a is an INPUT
     [(> ?a 40)]         binds nothing — a predicate only filters
     [:or …] [:and …]    binds through its sub-clauses
     [:not …]            binds nothing — its variables are local

   The distinction is what lets validation catch a predicate over a
   variable NOTHING binds. Counting every mentioned variable as bound
   made `[(> ?typo 40)]` look satisfiable, and the query then answered
   with every row instead of failing."
  [clause]
  (cond
    (pattern-clause? clause) (all-variables clause)
    (predicate-clause? clause)
      ; the function form's output term, if present
      (if (> (count clause) 1) (all-variables (get clause 1)) [])
    (rule-clause? clause)
      (if (= :not (get clause 0))
        []
        (into [] (mapcat binding-variables (into [] (rest clause)))))
    :else []))

(defn predicate-inputs
  "The variables a predicate clause READS.

   For `[(> ?a 40)]` that is `?a`. For the function form
   `[(* ?a 2) ?d]` it is `?a` only — `?d` is the clause's OUTPUT, bound
   by the call rather than required by it.

   Patterns and rules contribute nothing here: a pattern BINDS its
   variables, and a rule's sub-clauses bind theirs."
  [clause]
  (if (predicate-clause? clause)
    (all-variables (get clause 0))
    []))

(def RULE-OPERATORS #{:or :not :and :or-join :not-join})

(defn- branches-agree?
  "Whether every branch of an `:or` binds the same set of variables."
  [clause]
  (let [branch-vars (mapv (fn [sub] (set (binding-variables sub))) (into [] (rest clause)))]
    (every? (fn [vs] (= vs (first branch-vars))) branch-vars)))

(defn- syntax-problems
  "Malformed-syntax problems in one clause, as data.

   Every case here previously ANSWERED instead of failing, which is the
   worst way for a query to be wrong: the caller gets rows and no reason
   to doubt them."
  [clause]
  (cond
    (rule-clause? clause)
      (cond
        (not (contains? RULE-OPERATORS (get clause 0)))
          [{:error :unknown-rule-operator :operator (get clause 0) :clause clause}]
        ; `[:and]` succeeded unconditionally, `[:or]` matched nothing,
        ; `[:not]` failed always — three different silent answers to a
        ; clause that means nothing.
        (< (count clause) 2)
          [{:error :empty-rule :operator (get clause 0) :clause clause}]
        ; Every `:or` branch must bind the SAME variables. Otherwise a
        ; row's shape depends on which branch matched, and projection
        ; fills the gaps with nil — `#{[36 nil] [nil "London"]}`, which
        ; is not an answer to any question the caller asked. Datomic
        ; rejects this for the same reason.
        (and (= :or (get clause 0)) (not (branches-agree? clause)))
          [{:error :or-branches-bind-different-variables :clause clause}]
        :else (into [] (mapcat syntax-problems (into [] (rest clause)))))

    (pattern-clause? clause)
      ; A datom has FOUR addressable positions: e, a, v and the tx that
      ; recorded it. A fifth term is meaningless, and used to be silently
      ; IGNORED — `[?e :p/name ?n ?tx :extra]` matched as if the extra
      ; term were not written.
      ; Four terms: `[?e ?a ?v ?tx]` binds the TRANSACTION that recorded
      ; the datom. That is the payoff of reifying transactions — it is
      ; what lets a query reach from a fact to the change that made it
      ; true, and from there to who made it and when.
      (if (> (count clause) 4)
        [{:error :pattern-too-long :clause clause}]
        [])

    :else []))

(defn validate
  "Problems with a parsed query, as data.

   Catching these here means a malformed query fails with a message about
   the QUERY rather than with a confusing failure from deep inside the
   join engine — or, worse, with plausible-looking ROWS. Every check
   below guards a case that previously ANSWERED instead of failing.

   Returns a vector of problem maps; empty means the query is well
   formed."
  [parsed]
  (let [find-vars (find-variables parsed)
        ; What the query BINDS, which is not the same as what it
        ; mentions: a predicate READS its variables, and a `:not`
        ; introduces locals. Counting mentions as bindings made
        ; `[(> ?typo 40)]` look satisfiable.
        ; ALL input forms bind, not just scalars: a variable bound by
        ; `[?x ...]` or `[[?x ?y]]` is as bound as one bound by `?x`.
        ; Counting only scalars made a predicate over a
        ; collection-bound variable look like a predicate over nothing,
        ; and the query was rejected as malformed.
        bound (into (set (all-input-variables parsed))
                    (mapcat binding-variables (:where parsed)))

        structure [(if (empty? (:find parsed)) {:error :empty-find} nil)
                   (if (empty? (:where parsed)) {:error :empty-where} nil)]

        ; A non-variable in `:find` was silently DROPPED, so
        ; `[:find ?n "literal"]` returned one-element tuples — a shape
        ; the caller never asked for.
        ;
        ; An aggregate CALL (`(count ?e)`) is legitimate here; its own
        ; well-formedness is checked by `datom.query.agg/validate-find`,
        ; which owns that vocabulary. This check only rejects elements
        ; that are neither.
        find-elements (mapv (fn [t]
                              (if (or (variable? t) (list? t))
                                nil
                                {:error :unsupported-find-element :element t}))
                            (:find parsed))

        ; Only the default source `$` exists. `$other` was recognised and
        ; then FILTERED OUT, so a query naming another database silently
        ; ran against this one.
        sources (mapv (fn [t]
                        (if (and (source? t) (not (= (symbol "$") t)))
                          {:error :unsupported-source :source t}
                          nil))
                      (:in parsed))

        ; A find variable nothing binds can never be bound, so the query
        ; would return nils with no indication why.
        unbound-finds (mapv (fn [v]
                              (if (contains? bound v)
                                nil
                                {:error :unbound-find-variable :variable v}))
                            find-vars)

        ; A predicate over a variable nothing binds is the same mistake
        ; and worse in effect: the comparison saw nil, returned truthy,
        ; and the filter did NOTHING — so the query answered with every
        ; row rather than none, which reads like success.
        unbindable (mapv (fn [v]
                           (if (contains? bound v)
                             nil
                             {:error :unbindable-clause-variable :variable v}))
                         (into [] (distinct (into [] (mapcat predicate-inputs
                                                             (:where parsed))))))

        syntax (into [] (mapcat syntax-problems (:where parsed)))]
    (filterv some?
             (into (into (into (into (into structure find-elements) sources)
                               unbound-finds)
                         unbindable)
                   syntax))))
