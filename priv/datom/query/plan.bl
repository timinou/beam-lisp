; datom/query/plan.bl — which index serves a pattern, and in what order.
;
; ── The planner's whole job ───────────────────────────────────────────
;
; A pattern `[?e :person/name "Ada"]` has three positions. At the moment
; it is evaluated, each position is either BOUND (a literal, or a variable
; already bound by an earlier clause) or FREE.
;
; Which positions are bound decides which index can answer it with a
; PREFIX SCAN rather than a full scan. That is the entire reason wave 2
; built four orderings of the same datoms:
;
;   e bound          → EAVT   prefix [e]        "facts about this entity"
;   a + v bound      → AVET   prefix [a v]      "who has this value?"
;   a bound          → AEVT   prefix [a]        "every value of this attr"
;   v bound (ref)    → VAET   prefix [v]        "what points here?"
;   nothing bound    → EAVT   full scan         (unavoidable)
;
; Get this wrong and queries still return CORRECT answers — they just
; read the whole database to do it. That is the failure mode to fear: it
; is invisible until the dataset grows.
;
; ── Clause ordering ───────────────────────────────────────────────────
;
; Bindings flow left to right, so clause ORDER decides how much is bound
; when each clause runs. `[?e :person/age 36]` first, then
; `[?e :person/name ?n]`, is fast: the second clause has `?e` bound.
; Reversed, the first clause scans every name in the database.
;
; So the planner reorders clauses to run the most selective first. The
; heuristic is deliberately simple and explained below — a cost model
; based on real statistics is a later wave's problem, and a WRONG cost
; model is worse than an honest heuristic.

(ns datom.query.plan
  (:require [datom.query.parse] [datom.schema]))

;; ── binding state ───────────────────────────────────────────────────

(defn bound?
  "Whether `term` is known at evaluation time: a constant, or a variable
   already in `bindings`."
  [bindings term]
  (cond
    (datom.query.parse/blank? term) false
    (datom.query.parse/variable? term) (contains? bindings term)
    :else true))

(defn pattern-terms
  "The `[e a v tx]` terms of a pattern, padded with wildcards.

   A pattern may be shorter: `[?e :person/name]` asks for every value of
   that attribute on that entity. A FOURTH term binds the transaction
   that recorded the datom, which is how a query reaches from a fact to
   the change that made it true."
  [clause]
  [(if (> (count clause) 0) (get clause 0) '_)
   (if (> (count clause) 1) (get clause 1) '_)
   (if (> (count clause) 2) (get clause 2) '_)
   (if (> (count clause) 3) (get clause 3) '_)])

;; ── index selection ─────────────────────────────────────────────────

(def RANGE-OPS
  "Comparison predicates that can become index BOUNDS.

   Each maps to `[which-bound inclusive?]`: `>` gives a lower bound
   exclusive, `<=` an upper bound inclusive, and so on."
  {(quote >) [:lower false]
   (quote >=) [:lower true]
   (quote <) [:upper false]
   (quote <=) [:upper true]})

(defn range-predicate
  "`[variable bound-kind inclusive? value]` when `clause` is a
   comparison against a constant, else nil.

   `[(> ?age 30)]` bounds `?age` from below. The reversed spelling
   `[(< 30 ?age)]` says the same thing, so both are recognised \u2014 a
   query language that only understood one would be quietly demanding
   the author guess which."
  [clause]
  (if (not (datom.query.parse/predicate-clause? clause))
    nil
    (let [form (get clause 0)
          op (first form)
          args (into [] (rest form))
          spec (get RANGE-OPS op)]
      (if (or (nil? spec) (not (= 2 (count args))))
        nil
        (let [a (get args 0)
              b (get args 1)
              kind (get spec 0)
              inclusive (get spec 1)
              flip (fn [k] (if (= k :lower) :upper :lower))]
          (cond
            ; [(> ?age 30)] — variable first
            (and (datom.query.parse/variable? a) (not (datom.query.parse/variable? b)))
              [a kind inclusive b]
            ; [(> 30 ?age)] — constant first, so the bound reverses
            (and (datom.query.parse/variable? b) (not (datom.query.parse/variable? a)))
              [b (flip kind) inclusive a]
            :else nil))))))

(defn range-bounds-for
  "The `[low high]` bounds that `clauses` place on `variable`, or nil.

   Both may be present (`[(> ?a 20)] [(< ?a 30)]` is one window), and
   each is `[value inclusive?]`. Returns nil when nothing bounds it."
  [variable clauses]
  (let [specs (filterv (fn [r] (and (some? r) (= variable (get r 0))))
                       (mapv range-predicate clauses))]
    (if (empty? specs)
      nil
      (reduce (fn [acc spec]
                (let [kind (get spec 1)
                      inclusive (get spec 2)
                      value (get spec 3)]
                  (if (= kind :lower)
                    (assoc acc 0 [value inclusive])
                    (assoc acc 1 [value inclusive]))))
              [nil nil]
              specs))))

(defn index-for
  "The index that best serves `clause` given `bindings`, and the leading
   components to bind the scan with.

   Returns `[index components]`. The components are VALUES, resolved from
   bindings where the term is a bound variable.

   Selection follows from which positions are bound — there is no cost
   model here, because for a single pattern the choice is forced: an
   index can only prefix-scan on its LEADING components, so the bound
   positions determine which orderings are usable at all."
  [schema bindings clause]
  (let [terms (pattern-terms clause)
        e (get terms 0)
        a (get terms 1)
        v (get terms 2)
        resolve (fn [t] (if (datom.query.parse/variable? t) (get bindings t) t))
        e? (bound? bindings e)
        a? (bound? bindings a)
        v? (bound? bindings v)]
    (cond
      ; Entity known: EAVT, narrowed by attribute when that is known too.
      (and e? a?) [:eavt [(resolve e) (resolve a)]]
      e? [:eavt [(resolve e)]]

      ; Attribute and value known: AVET answers `who has this value?` in
      ; one prefix scan. This is the lookup that makes `:db/unique`
      ; enforcement and lookup refs cheap.
      (and a? v? (datom.schema/indexed? schema (resolve a)))
        [:avet [(resolve a) (resolve v)]]

      ; Value known and it is a REFERENCE: VAET is the reverse-navigation
      ; index — `what points AT this entity?`
      ;
      ; The int? check is load-bearing. VAET is only WRITTEN for
      ; `:db.type/ref` attributes (see `indexes-for`), so routing an
      ; arbitrary bound value here scanned an index holding no entries
      ; for it and returned EMPTY — a WRONG answer, not a slow one.
      ; `[?e _ "London"]` found nothing at all.
      ;
      ; With the attribute unbound there is no schema to consult, so the
      ; test is whether the value COULD be a reference: only an entity id
      ; (an integer) can be. Anything else falls through to the full scan
      ; below — slow, but correct.
      (and v? (not a?) (int? (resolve v))) [:vaet [(resolve v)]]

      ; Attribute known: scan that attribute's column. If the value is
      ; also known but the attribute is not AVET-indexed, this is the
      ; best available — the value becomes a filter rather than a bound.
      a? [:aevt [(resolve a)]]

      ; Nothing bound: a full scan, honestly.
      :else [:eavt []])))

;; ── clause ordering ─────────────────────────────────────────────────

(defn clause-cost
  "A rough selectivity score for `clause` given `bindings` — LOWER runs
   earlier.

   The heuristic, in order of confidence:
     0  every position bound        — an existence check
     1  entity bound                — one entity's facts, always small
     2  attribute + value bound     — an indexed lookup
     3  value bound only            — reverse-ref navigation
     4  attribute bound only        — a whole column
     5  nothing bound               — the whole database

   Deliberately NOT a statistics-based cost model. A model that estimates
   cardinality from real data would beat this, but a model estimating it
   WRONG is worse than a heuristic everyone can predict: a query planner
   that reorders unpredictably is one nobody can reason about."
  [bindings clause]
  (let [terms (pattern-terms clause)
        e? (bound? bindings (get terms 0))
        a? (bound? bindings (get terms 1))
        v? (bound? bindings (get terms 2))]
    (cond
      (and e? a? v?) 0
      e? 1
      (and a? v?) 2
      v? 3
      a? 4
      :else 5)))

(defn clause-variables
  "Every variable mentioned anywhere in `clause`, however deeply nested.

   Delegates to the parser, which owns the notion of what a variable is.
   Keeping a second copy here would let the two drift — and this exact
   logic already had one bug: a top-level-only scan found NO variables in
   a predicate, so the planner judged `[(> ?a 40)]` ready immediately and
   emitted it FIRST. `?a` was unbound, the comparison saw nil, every row
   survived, and the filter silently did nothing."
  [clause]
  (datom.query.parse/all-variables clause))

(defn- remove-first
  "`coll` without the FIRST element equal to `x`.

   Removing by value with `filterv` deleted EVERY equal clause, so a
   query repeating a clause came back with one fewer. Harmless when the
   clauses are identical, but it silently broke the planner's own
   no-clause-loss invariant — and a reordering that can lose a clause
   can widen a result."
  [coll x]
  (let [i (reduce (fn [found idx]
                    (if (some? found)
                      found
                      (if (= (get coll idx) x) idx nil)))
                  nil
                  (range (count coll)))]
    (if (nil? i)
      coll
      (into (into [] (take i coll)) (drop (inc i) coll)))))

(defn- negation-inputs
  "The variables a `:not` clause shares with the rest of the query.

   Variables appearing ONLY inside the negation are its own locals: in
   `[:not [?e :p/friend ?f]]` the question is `does ?e have any friend`,
   and `?f` is bound by that question, not required by it. Requiring it
   would make the clause unrunnable; ignoring the sharing rule entirely
   would let the clause run before `?e` is bound, asking a question with
   no subject."
  [clause outer-variables]
  (filterv (fn [v] (contains? (set outer-variables) v)) (clause-variables clause)))

(defn order-clauses
  "Order `clauses` so each runs with as much bound as possible.

   Greedy: repeatedly take the cheapest clause given what is bound so
   far, then add its variables to the bound set. Greedy is the right
   shape here because binding is monotonic — running a clause never
   UNBINDS anything, so a locally cheapest choice cannot make a later
   clause more expensive than it would otherwise have been.

   Predicate and rule clauses are NOT reordered ahead of the patterns
   that bind their variables; they are emitted as soon as their inputs
   are available, which is as early as they can legally run."
  [initial-bindings clauses]
  (let [outer (into [] (mapcat (fn [c]
                                 (if (and (datom.query.parse/rule-clause? c)
                                          (= :not (get c 0)))
                                   []
                                   (clause-variables c)))
                               clauses))]
  (loop [remaining (into [] clauses)
         bound (set initial-bindings)
         ordered []]
    (if (empty? remaining)
      ordered
      (let [patterns (filterv datom.query.parse/pattern-clause? remaining)
            others (filterv (fn [c] (not (datom.query.parse/pattern-clause? c))) remaining)
            ; A non-pattern whose variables are all bound can run NOW,
            ; and running it early shrinks the rows every later clause
            ; sees — the cheapest possible filter placement.
            ; The entities a SELECTIVE remaining pattern can bind. A pattern is
            ; selective when it has a constant value slot (`[?e :tag :pick]`) —
            ; it narrows to a strict subset, unlike `[?e :title ?t]` which
            ; merely projects a free attribute over every entity. An analytic
            ; generating clause sharing its output entity with a SELECTIVE
            ; pattern must WAIT for it: running first would search the whole
            ; column and then filter, turning the bound-?e prefilter into a
            ; post-filter (an entity ranked below the global k would be lost
            ; from its own candidate set). Deferring only behind SELECTIVE
            ; patterns leaves ordinary kNN — `[(similar-to …) [?e ?s]]` then a
            ; bare `[?e :title ?t]` projection — running as a generator, so k
            ; still means k.
            selective-pattern? (fn [c]
                                 (and (datom.query.parse/pattern-clause? c)
                                      (> (count c) 2)
                                      (datom.query.parse/constant? (get c 2))))
            pattern-bound (set (into [] (mapcat datom.query.parse/binding-variables
                                               (filterv selective-pattern? patterns))))
            ready (filterv (fn [c]
                             (and
                               (every? (fn [v] (contains? bound v))
                                     (cond
                                       ; A negation's variables are local
                                       ; except those it shares with the
                                       ; outer query.
                                       (and (datom.query.parse/rule-clause? c)
                                            (= :not (get c 0)))
                                         (negation-inputs c outer)

                                       ; A predicate or function is ready
                                       ; when its INPUTS are bound. Its
                                       ; OUTPUT is by definition not: the
                                       ; clause is what binds it.
                                       ; Requiring every mentioned
                                       ; variable meant `[(* ?a 2) ?d]`
                                       ; was never ready, so it fell to
                                       ; the source-order fallback below
                                       ; and any clause reading ?d ran
                                       ; FIRST, against an unbound ?d,
                                       ; discarding every row. A valid
                                       ; query answered #{} — and answered
                                       ; correctly once the clauses were
                                       ; written in a different order,
                                       ; which is precisely the coupling
                                       ; a planner exists to remove.
                                       (datom.query.parse/predicate-clause? c)
                                         (datom.query.parse/predicate-inputs c)

                                       :else (clause-variables c)))
                               ; defer an analytic clause while a pattern can
                               ; still bind its output entity.
                               (not (and (datom.query.parse/analytic-clause? c)
                                         (some (fn [v] (contains? pattern-bound v))
                                               (datom.query.parse/binding-variables c))))))
                           others)]
        (if (seq ready)
          (recur (remove-first remaining (first ready))
                 ; A function clause BINDS its output, so later clauses
                 ; can depend on it.
                 (into bound (datom.query.parse/binding-variables (first ready)))
                 (conj ordered (first ready)))
          (if (empty? patterns)
            ; Only non-ready predicates left: emit them in order and let
            ; the engine report the unbound variable.
            (into ordered remaining)
            ; A pattern whose ATTRIBUTE is an unbound variable cannot run yet:
            ; `[?a ?rel ?b]` needs `?rel` bound first (it may name a computed
            ; relation, and even for a stored scan an unbound attribute is the
            ; whole database). Defer such patterns behind ones whose attribute
            ; is known; only if EVERY remaining pattern is attr-deferred do we
            ; emit one and let evaluation bind it (a genuinely unresolvable
            ; query then fails with a clear message).
            (let [attr-ready? (fn [c]
                                (let [a (get (pattern-terms c) 1)]
                                  (or (not (datom.query.parse/variable? a))
                                      (contains? bound a))))
                  runnable (filterv attr-ready? patterns)
                  pick-from (if (seq runnable) runnable patterns)
                  best (first (sort-by (fn [c] (clause-cost bound c)) pick-from))]
              (recur (remove-first remaining best)
                     (into bound (clause-variables best))
                     (conj ordered best))))))))))

(defn plan
  "A parsed query with its `:where` clauses ordered for evaluation."
  [parsed]
  (assoc parsed
         :where
         (order-clauses (datom.query.parse/input-variables parsed) (:where parsed))))
