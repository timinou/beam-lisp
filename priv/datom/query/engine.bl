; datom/query/engine.bl — the join.
;
; ── How datalog actually evaluates ────────────────────────────────────
;
; A query is a set of clauses that must ALL hold. Evaluation carries a
; set of BINDING MAPS — each one a candidate answer, mapping variables to
; values:
;
;   [{?e 1 ?n "Ada"} {?e 2 ?n "Grace"}]
;
; Start with one empty binding (`[{}]` — no commitments, one candidate).
; Each clause then transforms the set: for every binding so far, find the
; datoms matching the clause under that binding, and emit one EXTENDED
; binding per match.
;
; Two things fall out of that, and they are the whole of datalog:
;
;   - a clause with a FREE variable multiplies the rows (each match is a
;     separate candidate) — that is the cartesian part
;   - a clause with an ALREADY-BOUND variable filters them (only datoms
;     agreeing with the existing binding survive) — that is the JOIN
;
; So there is no separate join operator. Two clauses sharing `?e` join on
; `?e` because the second clause's `?e` is already bound when it runs.
; Unification is just "does this datom agree with what we already know?"
;
; ── Why this is a nested-loop join, and when that matters ─────────────
;
; Each clause scans per binding, so cost is (rows so far) x (scan cost).
; The planner's job is to make `rows so far` small early — which is why
; clause ordering is a correctness-adjacent concern rather than a nicety.
;
; A hash join would beat this on large intermediate results. It is not
; here yet because the honest bottleneck at this stage is the per-scan
; cost, and a hash join over the same scans would not change the shape.
; Recorded rather than pretended away.

(ns datom.query.engine
  (:require [datom.db] [datom.index] [datom.query.agg] [datom.query.parse]
            [datom.query.plan] [datom.schema]))

;; ── unification ─────────────────────────────────────────────────────

(defn unify-term
  "Extend `bindings` so `term` matches `value`, or nil if it cannot.

   Three cases, and the third is the join:
     - a wildcard matches anything and binds nothing
     - an unbound variable binds to the value
     - a BOUND variable (or a constant) must EQUAL the value, else no match

   nil means `no match`, distinct from `{}` which means `matched, bound
   nothing`."
  [bindings term value]
  (cond
    (datom.query.parse/blank? term) bindings
    (datom.query.parse/variable? term)
      (if (contains? bindings term)
        (if (= (get bindings term) value) bindings nil)
        (assoc bindings term value))
    :else (if (= term value) bindings nil)))

(defn unify-pattern
  "Extend `bindings` so `clause` matches `datom`, or nil.

   Terms unify left to right, and a failure anywhere aborts — so
   `[?e :person/name ?e]` correctly matches only datoms whose entity and
   value are equal, without any special handling for the repeated
   variable."
  [bindings clause datom]
  (let [terms (datom.query.plan/pattern-terms clause)
        values [(datom.index/-e datom) (datom.index/-a datom) (datom.index/-v datom)
                (datom.index/-tx datom)]]
    (reduce (fn [acc i]
              (if (nil? acc)
                nil
                (unify-term acc (get terms i) (get values i))))
            bindings
            [0 1 2 3])))

;; ── clause evaluation ───────────────────────────────────────────────

(defn- resolve-term
  "A term's value under `bindings`, or the term itself when it is a
   constant."
  [bindings term]
  (if (datom.query.parse/variable? term) (get bindings term) term))

(defn eval-pattern
  "Every extension of `bindings` under which `clause` holds.

   The scan is chosen by the planner and bounded by whatever is already
   known, so a clause with `?e` bound reads one entity's datoms rather
   than the database."
  [db bindings clause]
  (let [selection (datom.query.plan/index-for (datom.db/schema-of db) bindings clause)
        index (get selection 0)
        components (get selection 1)
        candidates (apply datom.db/datoms db index components)]
    (filterv some? (mapv (fn [d] (unify-pattern bindings clause d)) candidates))))

(defn- call-form
  "The `(f arg …)` inside a predicate clause."
  [clause]
  (get clause 0))

(defn eval-predicate
  "`bindings` if the predicate holds, else nothing.

   A predicate clause is `[(op arg …)]`: the op is resolved in the
   calling namespace's scope, and its arguments are terms resolved
   against the bindings. Predicates FILTER — they never bind.

   The two-element form `[(f arg …) ?out]` is a FUNCTION clause: it
   binds `?out` to the call's result, which is how computed values enter
   a query."
  [bindings clause resolve-fn]
  (let [form (call-form clause)
        op (first form)
        args (mapv (fn [t] (resolve-term bindings t)) (into [] (rest form)))
        f (resolve-fn op)]
    (if (nil? f)
      (throw (ex-info (str "unknown predicate: " op) {:clause clause}))
      (let [result (apply f args)]
        (if (> (count clause) 1)
          ; function clause: bind the output term to the result
          (let [out (get clause 1)
                extended (unify-term bindings out result)]
            (if (nil? extended) [] [extended]))
          ; predicate clause: keep the binding only when truthy
          (if result [bindings] []))))))

;; ── the driver ──────────────────────────────────────────────────────

(defn eval-clause
  "Apply one clause to one binding, yielding zero or more bindings."
  [db bindings clause resolve-fn]
  (cond
    (datom.query.parse/pattern-clause? clause)
      (eval-pattern db bindings clause)
    (datom.query.parse/predicate-clause? clause)
      (eval-predicate bindings clause resolve-fn)
    (datom.query.parse/rule-clause? clause)
      (eval-rule db bindings clause resolve-fn)
    :else (throw (ex-info "unrecognised clause" {:clause clause}))))

(defn eval-rule
  "`:or`, `:not` and `:and` over sub-clauses.

   `:not` is the interesting one: it succeeds when the sub-clauses yield
   NOTHING, and it binds nothing — negation-as-failure. It must therefore
   run with its variables already bound, or it asks a question with no
   answer (`is there no ?x` over an unbound `?x` is either trivially true
   or meaningless). The planner emits it once its inputs are ready."
  [db bindings clause resolve-fn]
  (let [op (get clause 0)
        subs (into [] (rest clause))]
    (cond
      (= op :and)
        ; Sub-clauses are ORDERED before evaluation, exactly as top-level
        ; clauses are. Without it, `[:and [(> ?a 40)] [?e :p/age ?a]]`
        ; ran the predicate first against an unbound `?a` — nil compared
        ; against 40, no filtering, every row survived.
        (reduce (fn [acc sub]
                  (into [] (mapcat (fn [b] (eval-clause db b sub resolve-fn)) acc)))
                [bindings]
                (datom.query.plan/order-clauses (keys bindings) subs))

      (= op :or)
        ; Any sub-clause succeeding keeps the binding. Distinct, because
        ; two branches matching the same way must not double a row.
        (into [] (distinct (into [] (mapcat (fn [sub] (eval-clause db bindings sub resolve-fn))
                                            subs))))

      (= op :not)
        (let [matches (reduce (fn [acc sub]
                                (into [] (mapcat (fn [b] (eval-clause db b sub resolve-fn)) acc)))
                              [bindings]
                              (datom.query.plan/order-clauses (keys bindings) subs))]
          (if (empty? matches) [bindings] []))

      ; ── the -join forms ──────────────────────────────────────
      ;
      ; `[:or-join [?e] ...]` and `[:not-join [?e] ...]` name the
      ; variables that connect the sub-query to the outer one. Every
      ; OTHER variable inside is local.
      ;
      ; This is what makes the plain forms usable at all. `:or` requires
      ; its branches to bind identical variables, because a row that
      ; exists in one branch and not another has no meaning; that rules
      ; out the common case of two branches reaching the same entity by
      ; different routes:
      ;
      ;   [:or-join [?person]
      ;     [?person :via/email ?x]
      ;     [?person :via/phone ?y]]
      ;
      ; Here `?x` and `?y` are local, only `?person` escapes, and the
      ; branches agree on what they contribute. Without `or-join` this
      ; query cannot be written.
      (= op :or-join)
        (let [shared (into [] (first subs))
              branches (into [] (rest subs))
              ; Keep only the shared variables' bindings on the way OUT,
              ; so a branch's local variables do not leak into the outer
              ; binding set and accidentally constrain later clauses.
              project (fn [b] (select-keys b (into (into [] (keys bindings)) shared)))]
          (into [] (distinct
                     (mapv project
                           (into [] (mapcat (fn [sub] (eval-clause db bindings sub resolve-fn))
                                            branches))))))

      ; `not-join` is negation with an explicit scope: it asks whether
      ; the sub-query has any answer for the SHARED variables, ignoring
      ; whatever else it binds internally. Plain `:not` requires every
      ; variable inside to be pre-bound; this one does not, which is what
      ; lets you say `no order exists for this customer` without naming
      ; the order.
      (= op :not-join)
        (let [shared (into [] (first subs))
              body (into [] (rest subs))
              scoped (select-keys bindings shared)
              matches (reduce (fn [acc sub]
                                (into [] (mapcat (fn [b] (eval-clause db b sub resolve-fn)) acc)))
                              [scoped]
                              (datom.query.plan/order-clauses shared body))]
          (if (empty? matches) [bindings] []))

      :else (throw (ex-info (str "unknown rule operator: " op) {:clause clause})))))

(defn- range-scan-or-full
  "A BOUNDED scan when a later comparison predicate constrains this
   pattern's value on an indexed attribute, else the ordinary full scan.

   `[?e :person/age ?a] [(> ?a 30)]` reads only the ages above 30 rather
   than the whole column and filtering afterwards. The predicate still
   runs \u2014 the bound narrows what is read, it does not replace the test \u2014
   so an off-by-one in the bounds cannot produce a wrong answer, only a
   slower one. That is the property that makes this optimisation safe to
   have.

   Only for AVET-indexed attributes: the bound is a byte range over the
   value's encoding, and an unindexed attribute is not sorted by value.
   Only for integers, for the same reason the codec refuses to order
   unknown types."
  [db index components clause remaining common]
  (let [terms (datom.query.plan/pattern-terms clause)
        a (get terms 1)
        v (get terms 2)
        schema (datom.db/schema-of db)
        bounds (if (and (datom.query.parse/variable? v)
                        (not (datom.query.parse/variable? a))
                        (datom.schema/indexed? schema a)
                        (nil? (get (or common {}) v)))
                 (datom.query.plan/range-bounds-for v remaining)
                 nil)
        low (if (nil? bounds) nil (get bounds 0))
        high (if (nil? bounds) nil (get bounds 1))
        usable? (and (some? bounds)
                     (or (nil? low) (int? (get low 0)))
                     (or (nil? high) (int? (get high 0)))
                     (= index :aevt))]
    (if usable?
      ; AVET orders by [attribute value ...], so a value window is a
      ; prefix-bounded scan there \u2014 not in AEVT, whose next component is
      ; the entity.
      (datom.db/range-datoms db :avet [a]
                             (if (nil? low) nil (get low 0))
                             (if (nil? high) nil (get high 0)))
      (apply datom.db/datoms db index components))))

(defn- pattern-scan-once
  "Every extension of EVERY binding in `bindings` under `clause`, using a
   SINGLE store scan.

   The nested-loop form asked the store once per binding row, so a
   two-clause join over N entities issued N+1 range reads \u2014 measured
   exactly, with a counting store: 11 ranges at N=10, 41 at N=40.
   Against ETS a range is a local call and that is merely wasteful.
   Against a NETWORKED store it is N+1 round trips, which is the
   difference between a query that fits in one packet and half a second
   of latency.

   Here the clause is scanned ONCE, bounded only by what is common to
   every row, and the rows are matched against the result in memory. The
   scan is chosen from the terms already bound in ALL bindings, so it
   stays as narrow as the nested version whenever the bound positions
   agree \u2014 which is the usual case, since the planner orders clauses so
   the join variable is bound first.

   Answers are identical either way; only the number of store operations
   changes."
  [db bindings clause remaining]
  (let [; Bind only what every row agrees on: a term bound to the SAME
        ; value across all rows can narrow the scan, one that varies
        ; cannot.
        common (reduce (fn [acc b]
                         (if (nil? acc)
                           b
                           (reduce (fn [m k]
                                     (if (= (get b k) (get acc k)) m (dissoc m k)))
                                   acc
                                   (into [] (keys acc)))))
                       nil
                       bindings)
        selection (datom.query.plan/index-for (datom.db/schema-of db) (or common {}) clause)
        index (get selection 0)
        components (get selection 1)
        candidates (range-scan-or-full db index components clause remaining common)]
    (into [] (mapcat (fn [b]
                       (filterv some?
                                (mapv (fn [d] (unify-pattern b clause d)) candidates)))
                     bindings))))

(defn run-clauses
  "Fold every clause over the binding set.

   A PATTERN clause is evaluated with one scan for the whole binding set
   (see `pattern-scan-once`); everything else \u2014 predicates, functions,
   rules \u2014 is per-binding, because those are pure computation over a row
   and cost the store nothing."
  [db initial clauses resolve-fn]
  (get (reduce (fn [state clause]
                 (let [bindings (get state 0)
                       ; The clauses still to come. A pattern can use a
                       ; LATER comparison predicate as a scan bound — the
                       ; planner puts predicates after the pattern that
                       ; binds their input, so the bound is always ahead.
                       later (into [] (rest (get state 1)))
                       next-bindings
                         (if (and (datom.query.parse/pattern-clause? clause) (seq bindings))
                           (pattern-scan-once db bindings clause later)
                           (into [] (mapcat (fn [b] (eval-clause db b clause resolve-fn))
                                            bindings)))]
                   [next-bindings later]))
               [initial (into [] clauses)]
               clauses)
       0))

;; ── the public entry ────────────────────────────────────────────────

(defn- default-resolve
  "Resolve a predicate symbol to a function.

   Looks in `core`, so the arithmetic and comparison vocabulary a query
   would reach for is available without ceremony."
  [op]
  (try (BeamLisp.Env/fetch! "core" (name op)) (catch e nil)))

(defn- bind-inputs
  "The initial binding ROWS implied by `:in` and the supplied arguments.

   Each form contributes differently, and the difference is the point:

     ?x        scalar     -> one row, one variable bound
     [?x ...]  collection -> ONE ROW PER VALUE
     [?x ?y]   tuple      -> one row, several variables
     [[?x ?y]] relation   -> one row per input row

   A collection or relation MULTIPLIES the rows, which is exactly how
   `IN (...)` and `join against this external table` are expressed
   without building query text or running the query N times.

   Rows multiply across forms, so two collections give the cartesian
   product \u2014 the same semantics as two patterns that share no variable."
  [forms supplied]
  (reduce
    (fn [rows pair]
      (let [form (get pair 0)
            value (get pair 1)
            extend (fn [row m] (merge row m))]
        (cond
          (datom.query.parse/variable? form)
            (mapv (fn [row] (extend row {form value})) rows)

          (datom.query.parse/collection-binding? form)
            (let [v (get form 0)]
              (into [] (mapcat (fn [row]
                                 (mapv (fn [x] (extend row {v x})) (into [] value)))
                               rows)))

          (datom.query.parse/relation-binding? form)
            (let [vars (into [] (get form 0))]
              (into [] (mapcat (fn [row]
                                 (mapv (fn [tuple] (extend row (zipmap vars (into [] tuple))))
                                       (into [] value)))
                               rows)))

          (datom.query.parse/tuple-binding? form)
            (let [vars (into [] form)
                  vals (into [] value)]
              (if (= (count vars) (count vals))
                (mapv (fn [row] (extend row (zipmap vars vals))) rows)
                (throw (ex-info "tuple input does not match its binding form"
                                {:form form :value value
                                 :expected (count vars) :given (count vals)}))))

          :else (throw (ex-info "unrecognised :in binding form" {:form form})))))
    [{}]
    (mapv (fn [i] [(get forms i) (get supplied i)])
          (loop [i 0 acc []]
            (if (>= i (count forms)) acc (recur (+ i 1) (conj acc i)))))))

(defn q
  "Run `query` against `db` with optional `inputs`.

   Returns a SET of result tuples — a set because datalog answers a
   question about what is true, and the same answer arriving by two
   derivations is one answer. This is also why `q` returns a beam-lisp
   set rather than a vector: the semantics ARE set semantics, and the
   language already has the type."
  [query db & inputs]
  (let [parsed (datom.query.parse/parse query)
        problems (into (datom.query.parse/validate parsed)
                       (datom.query.agg/validate-find (:find parsed)))]
    (if (seq problems)
      (throw (ex-info "invalid query" {:problems problems}))
      (let [forms (datom.query.parse/binding-forms parsed)
            supplied (into [] (or inputs '()))
            initial (if (= (count forms) (count supplied))
                      (bind-inputs forms supplied)
                      (throw (ex-info "wrong number of query inputs"
                                      {:expected (count forms)
                                       :given (count supplied)
                                       :forms forms})))
            planned (datom.query.plan/plan parsed)
            bindings (run-clauses db initial (:where planned) default-resolve)
            find-elements (:find parsed)]
        ; With an aggregate present, the fold runs over the raw BINDINGS
        ; rather than over projected tuples — projecting first would
        ; collapse rows that differ only in an aggregated variable, and
        ; `[:find ?city (count ?e)]` would count one person per city.
        (if (datom.query.agg/has-aggregates? find-elements)
          (datom.query.agg/aggregate find-elements bindings)
          (set (mapv (fn [b]
                       (mapv (fn [v] (get b v))
                             (datom.query.parse/find-variables parsed)))
                     bindings)))))))
