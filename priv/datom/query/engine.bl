; datom/query/engine.bl — the join.
;
; ── How datalog actually evaluates ────────────────────────────────────
;
; A query is a set of clauses that must ALL hold. Evaluation carries a
; set of BINDING MAPS — each one a candidate answer, mapping variables to
; values:
;
;   [{?e 1 ?n "Ada"} {?e 2 ?n "Grace"}]
;
; Start with one empty binding (`[{}]` — no commitments, one candidate).
; Each clause then transforms the set: for every binding so far, find the
; datoms matching the clause under that binding, and emit one EXTENDED
; binding per match.
;
; Two things fall out of that, and they are the whole of datalog:
;
;   - a clause with a FREE variable multiplies the rows (each match is a
;     separate candidate) — that is the cartesian part
;   - a clause with an ALREADY-BOUND variable filters them (only datoms
;     agreeing with the existing binding survive) — that is the JOIN
;
; So there is no separate join operator. Two clauses sharing `?e` join on
; `?e` because the second clause's `?e` is already bound when it runs.
; Unification is just "does this datom agree with what we already know?"
;
; ── Why this is a nested-loop join, and when that matters ─────────────
;
; Each clause scans per binding, so cost is (rows so far) x (scan cost).
; The planner's job is to make `rows so far` small early — which is why
; clause ordering is a correctness-adjacent concern rather than a nicety.
;
; A hash join would beat this on large intermediate results. It is not
; here yet because the honest bottleneck at this stage is the per-scan
; cost, and a hash join over the same scans would not change the shape.
; Recorded rather than pretended away.

(ns datom.query.engine
  (:require [datom.db] [datom.index] [datom.query.agg] [datom.query.parse]
            [datom.query.plan] [datom.schema] [datom.query.analytic]
            [datom.query.rules]))

;; ── unification ─────────────────────────────────────────────────────

(defn- flat-into
  "Flatten `(f x)` over `coll` into one vector, in O(total) — the
   non-quadratic form of `(into [] (mapcat f coll))`.

   `(into [] (mapcat f coll))` is QUADRATIC here, and measurably so: a
   micro-benchmark clocked it at 7.7s for 10k elements and 50s for 20k,
   against 8ms and 17ms for this form. `mapcat` yields a lazy seq per
   element and `into` copies its accumulator as it consumes them, so the
   per-clause fold over a binding set — the engine's inner loop — paid an
   O(n²) tax that dwarfed everything else (a two-pattern join over 4000
   rows spent 3.3s here). `datom.index/write-datoms` records the same trap
   and the same fix: `reduce` over the outer collection, `reduce conj` each
   element's rows onto ONE growing vector — no lazy seq, no recopy."
  [f coll]
  (reduce (fn [acc x] (reduce conj acc (f x))) [] coll))

(defn unify-term
  "Extend `bindings` so `term` matches `value`, or nil if it cannot.

   Three cases, and the third is the join:
     - a wildcard matches anything and binds nothing
     - an unbound variable binds to the value
     - a BOUND variable (or a constant) must EQUAL the value, else no match

   nil means `no match`, distinct from `{}` which means `matched, bound
   nothing`."
  [bindings term value]
  (cond
    (datom.query.parse/blank? term) bindings
    (datom.query.parse/variable? term)
      (if (contains? bindings term)
        (if (= (get bindings term) value) bindings nil)
        (assoc bindings term value))
    :else (if (= term value) bindings nil)))

(defn unify-pattern
  "Extend `bindings` so `clause` matches `datom`, or nil.

   Terms unify left to right, and a failure anywhere aborts — so
   `[?e :person/name ?e]` correctly matches only datoms whose entity and
   value are equal, without any special handling for the repeated
   variable."
  [bindings clause datom]
  (let [terms (datom.query.plan/pattern-terms clause)
        values [(datom.index/-e datom) (datom.index/-a datom) (datom.index/-v datom)
                (datom.index/-tx datom)]]
    (reduce (fn [acc i]
              (if (nil? acc)
                nil
                (unify-term acc (get terms i) (get values i))))
            bindings
            [0 1 2 3])))

;; ── clause evaluation ───────────────────────────────────────────────

(defn- resolve-term
  "A term's value under `bindings`, or the term itself when it is a
   constant."
  [bindings term]
  (if (datom.query.parse/variable? term) (get bindings term) term))

;; ── computed-relation patterns ──────────────────────────────────────
;;
;; A pattern whose ATTRIBUTE is a registered computed relation
;; (`[?a :~similar ?b]`) is not a datom scan — its tuples are produced by the
;; relation's provider. This is what makes a computed relation join and
;; recurse in the ATTRIBUTE spelling, indistinguishable from a stored edge:
;; `[?a :cites ?b]` and `[?a :~similar ?b]` sit side by side in a `:where`.
;;
;; The pattern `[?e :~rel ?v ?more…]` maps to the provider's output tuple
;; `[?e ?v ?more…]` (the attribute keyword is dropped — it named the relation,
;; not a column). A bound `?e` upstream drives the prefilter set, giving the
;; :bb / :fb access modes for free, exactly as in the call spelling.

(defn- resolved-attr
  "The attribute of `clause` under `bindings`: the keyword written literally,
   or the value a variable attribute is bound to. This is what makes a
   relation-POLYMORPHIC pattern `[?a ?rel ?b]` work — `?rel` bound to a
   relation ident (from `:in`, a catalog query, or an upstream clause) is
   resolved here, so recursion can traverse whatever relation the query
   selected."
  [bindings clause]
  (let [a (get clause 1)]
    (cond
      (keyword? a) a
      (and (datom.query.parse/variable? a) (contains? bindings a)) (get bindings a)
      :else nil)))

(defn- computed-pattern?
  "Whether `clause`'s attribute — literal or resolved through `bindings` —
   names a registered computed relation."
  [bindings clause]
  (and (vector? clause)
       (> (count clause) 1)
       (let [a (resolved-attr bindings clause)]
         (and (keyword? a) (datom.query.relation/computed? a)))))

(defn- eval-computed-pattern
  "Evaluate `[?e :~rel ?v …]` via the relation provider, unifying each output
   tuple against the pattern's non-attribute terms `[?e ?v …]`.

   An attribute-spelled relation carries NO operator arguments in the clause
   (`[?a :~similar ?b]` names only the relation). Its arguments — which
   embedding column, k, threshold — are fixed at `defrelation` time in the
   spec's `:args`. This is exactly why an adjacency relation reads as a plain
   edge: the parameters are part of the relation's identity, not the query."
  [db bindings clause]
  (let [ident (resolved-attr bindings clause)
        spec (datom.query.relation/relation ident)
        ; the value terms are the pattern minus the attribute slot
        out-terms (into [] (concat [(get clause 0)] (into [] (drop 2 clause))))
        entity-term (get clause 0)
        bound-entities (if (and (datom.query.parse/variable? entity-term)
                                (contains? bindings entity-term))
                         #{(get bindings entity-term)}
                         nil)
        mode (datom.query.relation/mode-of [(some? bound-entities) false])
        args (or (get spec :args) [])
        rows (datom.query.relation/eval-relation db ident args bound-entities mode)]
    (flat-into (fn [row]
                 (let [b (unify-tuple bindings out-terms row)]
                   (if (nil? b) [] [b])))
               rows)))

(defn eval-pattern
  "Every extension of `bindings` under which `clause` holds.

   The scan is chosen by the planner and bounded by whatever is already
   known, so a clause with `?e` bound reads one entity's datoms rather
   than the database. A pattern whose attribute is a COMPUTED relation is
   routed to its provider instead of a datom scan."
  [db bindings clause]
  (if (computed-pattern? bindings clause)
    (eval-computed-pattern db bindings clause)
    (let [selection (datom.query.plan/index-for (datom.db/schema-of db) bindings clause)
          index (get selection 0)
          components (get selection 1)
          candidates (apply datom.db/datoms db index components)]
      (filterv some? (mapv (fn [d] (unify-pattern bindings clause d)) candidates)))))

(defn- call-form
  "The `(f arg …)` inside a predicate clause."
  [clause]
  (get clause 0))

(defn- eval-expr
  "A term's value under `bindings`: a variable reads its binding; a LIST
   is a nested CALL — a predicate clause is an expression, so
   `[(not (contains? ?xs ?x))]` composes the way ordinary code does;
   `(quote …)` is data; anything else is a literal.

   Historically a nested list passed through as a LITERAL, which made
   `[(not (contains? …))]` hand `not` a truthy list and silently filter
   every row — the worst failure mode, a wrong answer with no signal."
  [bindings term resolve-fn]
  (cond
    (datom.query.parse/variable? term) (get bindings term)
    (and (list? term) (= (first term) 'quote)) (second term)
    (list? term)
      (let [op (first term)
            f (resolve-fn op)]
        (if (nil? f)
          (throw (ex-info (str "unknown predicate: " op) {:form term}))
          (apply f (mapv (fn [t] (eval-expr bindings t resolve-fn))
                         (into [] (rest term))))))
    :else term))

(defn eval-predicate
  "`bindings` if the predicate holds, else nothing.

   A predicate clause is `[(op arg …)]`: the op is resolved in the
   calling namespace's scope, and its arguments are terms resolved
   against the bindings. Predicates FILTER — they never bind.

   The two-element form `[(f arg …) ?out]` is a FUNCTION clause: it
   binds `?out` to the call's result, which is how computed values enter
   a query."
  [bindings clause resolve-fn]
  (let [form (call-form clause)
        op (first form)
        args (mapv (fn [t] (eval-expr bindings t resolve-fn)) (into [] (rest form)))
        f (resolve-fn op)]
    (if (nil? f)
      (throw (ex-info (str "unknown predicate: " op) {:clause clause}))
      (let [result (apply f args)]
        (if (> (count clause) 1)
          ; function clause: bind the output term to the result
          (let [out (get clause 1)
                extended (unify-term bindings out result)]
            (if (nil? extended) [] [extended]))
          ; predicate clause: keep the binding only when truthy
          (if result [bindings] []))))))

;; ── the driver ──────────────────────────────────────────────────────

(defn- unify-tuple
  "Unify an OUTPUT TUPLE `[?a ?b …]` against a value vector element-wise.

   The generating analytic clauses bind a tuple — `similar-to` binds
   `[?e ?score]` — so the single-term `unify-term` is not enough. Each
   position unifies independently and a mismatch anywhere fails the whole
   row, which is what makes a PRE-BOUND `?e` filter (the entity must both
   be a near neighbour AND already agree with what upstream clauses bound)."
  [bindings out-terms values]
  (if (not (= (count out-terms) (count values)))
    nil
    (reduce (fn [acc i]
              (if (nil? acc)
                nil
                (unify-term acc (get out-terms i) (get values i))))
            bindings
            (range (count out-terms)))))

(defn eval-analytic
  "Evaluate a generating analytic clause — `similar-to` (and, in later
   waves, `cluster`/`community`/`project-2d`).

   Shape: `[(op arg…) [out…]]`. The op reads the store and yields a
   sequence of output tuples; each tuple is unified against the output
   terms, extending `bindings` into zero or more rows. A free output
   variable is BOUND by the result (the generating case, multiplying
   rows); an already-bound one FILTERS (the pre-filtered case — score only
   the entities upstream already selected, which is the join a bolt-on
   vector store cannot do)."
  [db bindings clause resolve-fn]
  (let [form (get clause 0)
        op (first form)
        out (get clause 1)
        out-terms (if (vector? out) out [out])
        ; The output terms travel WITH the call: when the first output (the
        ; entity) is already bound, `similar-to` restricts its corpus to that
        ; entity so a bound-?e clause SCORES the candidate set rather than
        ; running a global top-k and filtering afterwards — the difference
        ; between a true prefilter and a post-filter (an entity ranked below
        ; the global k would otherwise be dropped from its own bound set).
        rows (datom.query.analytic/eval-op db bindings op (into [] (rest form)) out-terms)]
    (flat-into (fn [row]
                 (let [b (unify-tuple bindings out-terms row)]
                   (if (nil? b) [] [b])))
               rows)))

(defn eval-clause
  "Apply one clause to one binding, yielding zero or more bindings.

   `rules-rel` maps each user-defined rule NAME to its materialised
   relation (a set of value tuples), or is empty when the query uses no
   rules. A clause invoking a rule reads that relation — the rules were
   evaluated to a fixpoint before the main query began (see `q`), so a
   recursive query becomes an ordinary relation read here."
  [db bindings clause resolve-fn rules-rel]
  (cond
    (datom.query.parse/pattern-clause? clause)
      (eval-pattern db bindings clause)
    ; analytic BEFORE predicate: an analytic clause is structurally a
    ; function clause, so it must be claimed here or the plain function
    ; path would try to resolve `similar-to` as an ordinary function.
    (datom.query.parse/analytic-clause? clause)
      (eval-analytic db bindings clause resolve-fn)
    ; a rule INVOCATION — also a call form, so it must be claimed before the
    ; plain predicate path, and only when its name is a defined rule.
    (and (seq rules-rel)
         (datom.query.parse/rule-invocation? clause (set (keys rules-rel))))
      (let [call (datom.query.parse/rule-invocation-call clause)]
        (datom.query.rules/relation-for rules-rel
                                        (first call)
                                        (into [] (rest call))
                                        bindings))
    (datom.query.parse/predicate-clause? clause)
      (eval-predicate bindings clause resolve-fn)
    (datom.query.parse/rule-clause? clause)
      (eval-rule db bindings clause resolve-fn rules-rel)
    :else (throw (ex-info "unrecognised clause" {:clause clause}))))

(defn eval-rule
  "`:or`, `:not` and `:and` over sub-clauses.

   `:not` is the interesting one: it succeeds when the sub-clauses yield
   NOTHING, and it binds nothing — negation-as-failure. It must therefore
   run with its variables already bound, or it asks a question with no
   answer (`is there no ?x` over an unbound `?x` is either trivially true
   or meaningless). The planner emits it once its inputs are ready."
  [db bindings clause resolve-fn rules-rel]
  (let [op (get clause 0)
        subs (into [] (rest clause))]
    (cond
      (= op :and)
        ; Sub-clauses are ORDERED before evaluation, exactly as top-level
        ; clauses are. Without it, `[:and [(> ?a 40)] [?e :p/age ?a]]`
        ; ran the predicate first against an unbound `?a` — nil compared
        ; against 40, no filtering, every row survived.
        (reduce (fn [acc sub]
                  (flat-into (fn [b] (eval-clause db b sub resolve-fn rules-rel)) acc))
                [bindings]
                (datom.query.plan/order-clauses (keys bindings) subs))

      (= op :or)
        ; Any sub-clause succeeding keeps the binding. Distinct, because
        ; two branches matching the same way must not double a row.
        (into [] (distinct (flat-into (fn [sub] (eval-clause db bindings sub resolve-fn rules-rel))
                                      subs)))

      (= op :not)
        (let [matches (reduce (fn [acc sub]
                                (flat-into (fn [b] (eval-clause db b sub resolve-fn rules-rel)) acc))
                              [bindings]
                              (datom.query.plan/order-clauses (keys bindings) subs))]
          (if (empty? matches) [bindings] []))

      ; ── the -join forms ──────────────────────────────────────
      ;
      ; `[:or-join [?e] ...]` and `[:not-join [?e] ...]` name the
      ; variables that connect the sub-query to the outer one. Every
      ; OTHER variable inside is local.
      ;
      ; This is what makes the plain forms usable at all. `:or` requires
      ; its branches to bind identical variables, because a row that
      ; exists in one branch and not another has no meaning; that rules
      ; out the common case of two branches reaching the same entity by
      ; different routes:
      ;
      ;   [:or-join [?person]
      ;     [?person :via/email ?x]
      ;     [?person :via/phone ?y]]
      ;
      ; Here `?x` and `?y` are local, only `?person` escapes, and the
      ; branches agree on what they contribute. Without `or-join` this
      ; query cannot be written.
      (= op :or-join)
        (let [shared (into [] (first subs))
              branches (into [] (rest subs))
              ; Keep only the shared variables' bindings on the way OUT,
              ; so a branch's local variables do not leak into the outer
              ; binding set and accidentally constrain later clauses.
              project (fn [b] (select-keys b (into (into [] (keys bindings)) shared)))]
          (into [] (distinct
                     (mapv project
                           (flat-into (fn [sub] (eval-clause db bindings sub resolve-fn rules-rel))
                                      branches)))))

      ; `not-join` is negation with an explicit scope: it asks whether
      ; the sub-query has any answer for the SHARED variables, ignoring
      ; whatever else it binds internally. Plain `:not` requires every
      ; variable inside to be pre-bound; this one does not, which is what
      ; lets you say `no order exists for this customer` without naming
      ; the order.
      (= op :not-join)
        (let [shared (into [] (first subs))
              body (into [] (rest subs))
              scoped (select-keys bindings shared)
              matches (reduce (fn [acc sub]
                                (flat-into (fn [b] (eval-clause db b sub resolve-fn rules-rel)) acc))
                              [scoped]
                              (datom.query.plan/order-clauses shared body))]
          (if (empty? matches) [bindings] []))

      :else (throw (ex-info (str "unknown rule operator: " op) {:clause clause})))))

(defn- range-scan-or-full
  "A BOUNDED scan when a later comparison predicate constrains this
   pattern's value on an indexed attribute, else the ordinary full scan.

   `[?e :person/age ?a] [(> ?a 30)]` reads only the ages above 30 rather
   than the whole column and filtering afterwards. The predicate still
   runs \u2014 the bound narrows what is read, it does not replace the test \u2014
   so an off-by-one in the bounds cannot produce a wrong answer, only a
   slower one. That is the property that makes this optimisation safe to
   have.

   Only for AVET-indexed attributes: the bound is a byte range over the
   value's encoding, and an unindexed attribute is not sorted by value.
   Only for integers, for the same reason the codec refuses to order
   unknown types."
  [db index components clause remaining common]
  (let [terms (datom.query.plan/pattern-terms clause)
        a (get terms 1)
        v (get terms 2)
        schema (datom.db/schema-of db)
        bounds (if (and (datom.query.parse/variable? v)
                        (not (datom.query.parse/variable? a))
                        (datom.schema/indexed? schema a)
                        (nil? (get (or common {}) v)))
                 (datom.query.plan/range-bounds-for v remaining)
                 nil)
        low (if (nil? bounds) nil (get bounds 0))
        high (if (nil? bounds) nil (get bounds 1))
        usable? (and (some? bounds)
                     (or (nil? low) (int? (get low 0)))
                     (or (nil? high) (int? (get high 0)))
                     (= index :aevt))]
    (if usable?
      ; AVET orders by [attribute value ...], so a value window is a
      ; prefix-bounded scan there \u2014 not in AEVT, whose next component is
      ; the entity.
      (datom.db/range-datoms db :avet [a]
                             (if (nil? low) nil (get low 0))
                             (if (nil? high) nil (get high 0)))
      (apply datom.db/datoms db index components))))

(defn- pattern-scan-once
  "Every extension of EVERY binding in `bindings` under `clause`, using a
   SINGLE store scan.

   The nested-loop form asked the store once per binding row, so a
   two-clause join over N entities issued N+1 range reads \u2014 measured
   exactly, with a counting store: 11 ranges at N=10, 41 at N=40.
   Against ETS a range is a local call and that is merely wasteful.
   Against a NETWORKED store it is N+1 round trips, which is the
   difference between a query that fits in one packet and half a second
   of latency.

   Here the clause is scanned ONCE, bounded only by what is common to
   every row, and the rows are matched against the result in memory. The
   scan is chosen from the terms already bound in ALL bindings, so it
   stays as narrow as the nested version whenever the bound positions
   agree \u2014 which is the usual case, since the planner orders clauses so
   the join variable is bound first.

   Answers are identical either way; only the number of store operations
   changes."
  [db bindings clause remaining]
  (let [; Bind only what every row agrees on: a term bound to the SAME
        ; value across all rows can narrow the scan, one that varies
        ; cannot.
        common (reduce (fn [acc b]
                         (if (nil? acc)
                           b
                           (reduce (fn [m k]
                                     (if (= (get b k) (get acc k)) m (dissoc m k)))
                                   acc
                                   (into [] (keys acc)))))
                       nil
                       bindings)
        selection (datom.query.plan/index-for (datom.db/schema-of db) (or common {}) clause)
        index (get selection 0)
        components (get selection 1)
        candidates (range-scan-or-full db index components clause remaining common)
        terms (datom.query.plan/pattern-terms clause)
        ; The variable this clause SHARES with the rows already bound.
        ; It is the join key, and indexing candidates by it turns the
        ; match from a scan into a lookup.
        join-var (first (filterv (fn [v] (and (datom.query.parse/variable? v)
                                              (contains? (first bindings) v)))
                                 terms))]
    (if (nil? join-var)
      ; Nothing shared: this is a cartesian product, and every candidate
      ; must be tried against every row. Rare, and inherently quadratic
      ; in the SIZE OF THE ANSWER rather than in wasted work.
      (flat-into (fn [b]
                   (filterv some?
                            (mapv (fn [d] (unify-pattern b clause d)) candidates)))
                 bindings)
      ; A real HASH JOIN. One scan produced the candidates; now bucket
      ; them by the join key ONCE, and each binding row consults its own
      ; bucket instead of the whole set.
      ;
      ; Without this the join was one scan and then N x M unification
      ; attempts — 250,000 of them for 500 entities, of which 499,500
      ; failed. Reducing the store operations to a constant had made the
      ; I/O honest while leaving the CPU quadratic, which is why a join
      ; that reads 2 ranges still took 5 seconds.
      (let [position (loop [i 0]
                       (if (>= i (count terms))
                         nil
                         (if (= (get terms i) join-var) i (recur (+ i 1)))))
            value-at (fn [d]
                       (cond (= position 0) (datom.index/-e d)
                             (= position 1) (datom.index/-a d)
                             (= position 2) (datom.index/-v d)
                             :else (datom.index/-tx d)))
            buckets (reduce (fn [acc d]
                              (let [k (value-at d)]
                                (assoc acc k (conj (or (get acc k) []) d))))
                            {}
                            candidates)]
        (flat-into (fn [b]
                     (filterv some?
                              (mapv (fn [d] (unify-pattern b clause d))
                                    (or (get buckets (get b join-var)) []))))
                   bindings)))))

(defn run-clauses
  "Fold every clause over the binding set.

   A PATTERN clause is evaluated with one scan for the whole binding set
   (see `pattern-scan-once`); everything else \u2014 predicates, functions,
   rules \u2014 is per-binding, because those are pure computation over a row
   and cost the store nothing."
  [db initial clauses resolve-fn rules-rel]
  (get (reduce (fn [state clause]
                 (let [bindings (get state 0)
                       ; The clauses still to come. A pattern can use a
                       ; LATER comparison predicate as a scan bound — the
                       ; planner puts predicates after the pattern that
                       ; binds their input, so the bound is always ahead.
                       later (into [] (rest (get state 1)))
                       next-bindings
                         ; A COMPUTED-relation pattern (`[?a :~similar ?b]`)
                         ; is a pattern shape but not a datom scan, so it does
                         ; NOT take the hash-join fast path — it routes through
                         ; eval-clause -> eval-pattern -> its provider.
                         (if (and (datom.query.parse/pattern-clause? clause)
                                  (not (computed-pattern? (first bindings) clause))
                                  (seq bindings))
                           (pattern-scan-once db bindings clause later)
                           (flat-into (fn [b] (eval-clause db b clause resolve-fn rules-rel))
                                      bindings))]
                   [next-bindings later]))
               [initial (into [] clauses)]
               clauses)
       0))

;; ── the public entry ────────────────────────────────────────────────

(defn- ns-resolve
  "Resolve a predicate op the way ordinary code in `source-ns` would:
   the querying namespace first, then refers, aliases, and finally
   `core` — `Env.fetch`'s candidate order, the same resolution the
   compiler applies to the code the query sits inside. A predicate is
   part of the caller's program; resolving it anywhere else made a
   helper defn'd next to the query an \"unknown predicate\".

   `str` rather than `name`: a qualified op `their.ns/f` keeps its
   qualifier so alias resolution can see it."
  [source-ns op]
  (let [r (BeamLisp.Env/fetch source-ns (str op))]
    (if (= r :error) nil (second r))))

(defn- bind-inputs
  "The initial binding ROWS implied by `:in` and the supplied arguments.

   Each form contributes differently, and the difference is the point:

     ?x        scalar     -> one row, one variable bound
     [?x ...]  collection -> ONE ROW PER VALUE
     [?x ?y]   tuple      -> one row, several variables
     [[?x ?y]] relation   -> one row per input row

   A collection or relation MULTIPLIES the rows, which is exactly how
   `IN (...)` and `join against this external table` are expressed
   without building query text or running the query N times.

   Rows multiply across forms, so two collections give the cartesian
   product \u2014 the same semantics as two patterns that share no variable."
  [forms supplied]
  (reduce
    (fn [rows pair]
      (let [form (get pair 0)
            value (get pair 1)
            extend (fn [row m] (merge row m))]
        (cond
          (datom.query.parse/variable? form)
            (mapv (fn [row] (extend row {form value})) rows)

          (datom.query.parse/collection-binding? form)
            (let [v (get form 0)]
              (flat-into (fn [row]
                           (mapv (fn [x] (extend row {v x})) (into [] value)))
                         rows))

          (datom.query.parse/relation-binding? form)
            (let [vars (into [] (get form 0))]
              (flat-into (fn [row]
                                 (mapv (fn [tuple]
                                         ; EVERY row must match the binding
                                         ; width. A short row bound its
                                         ; missing variables to nil, which
                                         ; then matched nothing and quietly
                                         ; dropped out \u2014 a malformed input
                                         ; silently reducing the answer set
                                         ; rather than being reported.
                                         (let [vals (into [] tuple)]
                                           (if (= (count vars) (count vals))
                                             (extend row (zipmap vars vals))
                                             (throw (ex-info "relation input row does not match its binding form"
                                                             {:form form :row tuple
                                                              :expected (count vars)
                                                              :given (count vals)})))))
                                       (into [] value)))
                               rows))

          (datom.query.parse/tuple-binding? form)
            (let [vars (into [] form)
                  vals (into [] value)]
              (if (= (count vars) (count vals))
                (mapv (fn [row] (extend row (zipmap vars vals))) rows)
                (throw (ex-info "tuple input does not match its binding form"
                                {:form form :value value
                                 :expected (count vars) :given (count vals)}))))

          :else (throw (ex-info "unrecognised :in binding form" {:form form})))))
    [{}]
    (mapv (fn [i] [(get forms i) (get supplied i)])
          (loop [i 0 acc []]
            (if (>= i (count forms)) acc (recur (+ i 1) (conj acc i)))))))

(defn q
  "Run `query` against `db` with optional `inputs`.

   Returns a SET of result tuples — a set because datalog answers a
   question about what is true, and the same answer arriving by two
   derivations is one answer. This is also why `q` returns a beam-lisp
   set rather than a vector: the semantics ARE set semantics, and the
   language already has the type."
  [query db & inputs]
  ; Populate the relation catalog before ANY clause is classified. Namespace
  ; bodies load lazily, so the built-in computed relations (similar-to,
  ; community, …) are not registered merely because engine :requires analytic;
  ; this forces analytic's body to run once. Idempotent and cheap.
  (datom.query.analytic/ensure-registered!)
  (let [parsed (datom.query.parse/parse query)
        problems (into (datom.query.parse/validate parsed)
                       (datom.query.agg/validate-find (:find parsed)))]
    (if (seq problems)
      (throw (ex-info "invalid query" {:problems problems}))
      (let [; `input-forms` includes the `%` rules source, so arguments line
            ; up positionally; `binding-forms` (variables only) is what
            ; `bind-inputs` consumes. When a `%` form is present we split its
            ; argument off, materialise the rules to a fixpoint, and thread
            ; the resulting relations into evaluation.
            in-forms (datom.query.parse/input-forms parsed)
            supplied (into [] (or inputs '()))
            _ (when (not (= (count in-forms) (count supplied)))
                (throw (ex-info "wrong number of query inputs"
                                {:expected (count in-forms)
                                 :given (count supplied)
                                 :forms in-forms})))
            ; pair each input form with its argument, then separate the rules
            ; argument (the one whose form is `%`) from the binding arguments.
            rules-arg (loop [i 0]
                        (cond
                          (>= i (count in-forms)) nil
                          (datom.query.parse/rules-var? (get in-forms i)) (get supplied i)
                          :else (recur (+ i 1))))
            binding-forms (filterv (fn [f] (not (datom.query.parse/rules-var? f))) in-forms)
            binding-args (filterv some?
                                  (mapv (fn [i]
                                          (if (datom.query.parse/rules-var? (get in-forms i))
                                            nil
                                            [(get supplied i)]))
                                        (range (count in-forms))))
            binding-args (mapv (fn [w] (get w 0)) binding-args)
            initial (bind-inputs binding-forms binding-args)
            ; FEAT-025: call-site adornment. Find every rule invocation in
            ; the where tree; positions bound by a constant or an :in input
            ; at EVERY call site become seeds, so body predicates over head
            ; args evaluate during materialisation instead of never firing.
            ; Multi-row inputs (tuple sources) skip seeding — conservative,
            ; never under-compute a call site.
            seeds (if (and (some? rules-arg) (= 1 (count initial)))
                    (datom.query.rules/invocation-seeds
                      rules-arg (:where parsed) (get (into [] initial) 0))
                    {})
            ; materialise the rules (if any) to their least fixpoint BEFORE
            ; the main query runs. `eval-plain` is the callback the rules
            ; engine uses for ordinary (non-invocation) clauses — an
            ; `eval-clause` with no rules, since invocations are expanded by
            ; the rules engine itself against the in-progress relations.
            ; Predicates resolve in the QUERYING namespace — the same
            ; scope the query text sits in — captured here at entry.
            source-ns (BeamLisp.Env/current_ns)
            resolve-fn (fn [op] (ns-resolve source-ns op))
            rules-rel (if (some? rules-arg)
                        (datom.query.rules/materialise
                          db rules-arg
                          (fn [d b clause] (eval-clause d b clause resolve-fn {}))
                          seeds)
                        {})
            planned (datom.query.plan/plan parsed)
            bindings (run-clauses db initial (:where planned) resolve-fn rules-rel)
            find-elements (:find parsed)]
        ; With an aggregate present, the fold runs over the raw BINDINGS
        ; rather than over projected tuples — projecting first would
        ; collapse rows that differ only in an aggregated variable, and
        ; `[:find ?city (count ?e)]` would count one person per city.
        (if (datom.query.agg/has-aggregates? find-elements)
          (datom.query.agg/aggregate find-elements bindings)
          (set (mapv (fn [b]
                       (mapv (fn [v] (get b v))
                             (datom.query.parse/find-variables parsed)))
                     bindings)))))))
