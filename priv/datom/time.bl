; datom/time.bl — the database remembers.
;
; ── The feature everything else was built for ─────────────────────────
;
; Nothing in this database is ever updated or deleted. Changing an
; attribute APPENDS a retraction of the old value and an assertion of the
; new one, both stamped with the transaction that made the change.
;
; So the past is not archived somewhere — it is simply still here, and
; every datom carries the `t` at which it became true. Time travel is
; therefore not a feature bolted on top; it is a FILTER over data that
; never went anywhere:
;
;   as-of t    ignore everything after t          -> the world as it was
;   since t    only what changed after t          -> the recent delta
;   history    every datom, assertions AND        -> the full record of
;              retractions alike                     what changed, when
;
; That is why `as-of` costs O(1) to construct and why an hour-old db
; value still answers queries about an hour ago. A place-oriented
; database cannot do this at any price, because it overwrote the answer.
;
; ── Why this file is so short ─────────────────────────────────────────
;
; Because wave 2 did the work. `datom.db` already filters every read by
; basis and by retraction; these functions just hand it different
; parameters. If this file were long, the design would be wrong.

(ns datom.time
  (:require [datom.db] [datom.index]))

(defn as-of
  "The database as it was at transaction `t`.

   Every datom recorded after `t` becomes invisible \u2014 including the
   retractions that superseded older values, which is what makes the old
   values reappear. No copying: the value holds the same store with a
   different basis.

   `(as-of db t)` answers `what did we believe then?`, which is the
   question audit logs exist to approximate and usually cannot."
  [db t]
  (assoc db :basis-t t :filter-mode :current :since-t nil))

(defn since
  "Only what changed AFTER transaction `t`.

   The complement of `as-of`: rather than hiding the recent past, this
   hides everything BUT it. Useful for `what happened while I was away?`
   without diffing two snapshots by hand.

   Note the asymmetry, which is Datomic's and worth keeping: `as-of` is
   inclusive of `t` and `since` is exclusive, so `(as-of db t)` and
   `(since db t)` partition the database's history with no datom in both
   and none missing."
  [db t]
  (assoc db :since-t t :filter-mode :current))

(defn history
  "Every datom ever recorded, assertions and retractions alike.

   The other two views answer `what is true?` at some point. This one
   answers `what CHANGED, and when?` — a different question, and the
   reason retraction datoms are kept rather than deleted.

   PRESERVES any `as-of` or `since` bound already on `db`, so the views
   COMPOSE: `(history (as-of db t))` is every datom recorded up to `t`,
   and `(history (since db t))` every datom recorded after it. Those two
   partition the log exactly — which is the property that makes `since`
   meaningful at all. Clearing the bound here made both views return
   everything, so the partition silently double-counted.

   A history view is NOT a database state: an entity may appear to hold
   several values for a cardinality-one attribute, because it held each
   of them at some point. Reading it as current would be a category
   error, so `datom.db/entity` refuses."
  [db]
  (assoc db :filter-mode :history))

(defn current?
  "Whether `db` is an ordinary current-state view."
  [db]
  (and (= (:filter-mode db) :current) (nil? (:since-t db))))

(defn history?
  [db]
  (= (:filter-mode db) :history))

;; ── reading history ─────────────────────────────────────────────────

(defn changes
  "Every datom about `[e a]` in transaction order, with its `t` and
   whether it was an assertion.

   The shape a `what happened to this field?` view wants: one row per
   change, oldest first."
  [db e a]
  (let [h (history db)
        ; Within ONE transaction a retraction always precedes the
        ; assertion that supersedes it: that is the causal order, and it
        ; is what a reader expects to see. Sorting by `tx` alone left
        ; same-tx datoms in INDEX order — which is by value — so a
        ; history could read `175 began, then 250 ended`, describing the
        ; change backwards.
        ;
        ; The key is `[tx (if assertion? 1 0)]`: same transaction,
        ; retractions first.
        ordered (sort-by (fn [d] [(datom.index/-tx d)
                                  (if (datom.index/assertion? d) 1 0)])
                         (datom.db/datoms h :eavt e a))]
    (mapv (fn [d]
            {:t (datom.index/-tx d)
             :value (datom.index/-v d)
             :added (datom.index/assertion? d)})
          ordered)))

(defn value-at
  "The value `[e a]` held at transaction `t`.

   Sugar over `as-of`, for the common case of asking about one field
   rather than a whole database."
  [db t e a]
  (datom.db/attr-value (as-of db t) e a))

(defn tx-of
  "The transaction that most recently asserted `value` for `[e a]`, or
   nil.

   Answers `when did this become true?` \u2014 the question that makes a
   history view actionable rather than merely interesting."
  [db e a value]
  (let [matching (filterv (fn [c] (and (= (:value c) value) (:added c)))
                          (changes db e a))]
    (if (empty? matching) nil (:t (last matching)))))
