; datom/schema.bl — what an attribute means.
;
; ── Schema is data, and it lives in the database ───────────────────
;
; An attribute is an ENTITY whose own attributes describe it. `:person/name`
; is a thing in the database with a `:db/valueType` and a
; `:db/cardinality`, written as ordinary datoms by an ordinary
; transaction. So:
;
;   [?a :db/ident ?name]        a program can ask what attributes exist
;   (pull db [*] attr-entity)   an attribute is pullable like any entity
;   (as-of db t)                a schema CHANGE appears in history, with
;                               a transaction and a timestamp
;
; That last one is why this matters rather than being a curiosity: a
; database whose premise is "everything is a fact in one uniform store"
; should not keep its own vocabulary somewhere else.
;
; ── The bootstrap ───────────────────────────────────────────
;
; Schema datoms need a schema to be validated against — the circularity
; every self-describing system meets somewhere. `BUILT-IN` is the answer:
; a small fixed set of primordial attributes (`:db/ident`,
; `:db/valueType`, `:db/cardinality`, `:db/unique`, `:db/index`,
; `:db/doc`, `:db/txInstant`) installed into every schema. Everything
; else is ordinary data.
;
; ── Why the map still exists ─────────────────────────────────
;
; Reads consult a schema MAP carried on the Db value, not the datoms.
; The map is touched on every datom filter — cardinality decides whether
; a value collapses, `indexes-for` decides where a datom is written — so
; deriving it per read would be a serious regression.
;
; The datoms are the RECORD; the map is an index of them. When they can
; disagree (a schema change mid-history), the map is the one that is
; current, and that is a known limitation rather than a design: a
; historical view reads old data through today's schema.
;
; This file holds the vocabulary and the RULES.
;
; ── What an attribute declares ────────────────────────────────────────
;
;   :db/ident        the keyword it is known by            (required)
;   :db/valueType    :db.type/{string,long,boolean,keyword,ref,instant}
;   :db/cardinality  :db.cardinality/{one,many}            (default one)
;   :db/unique       :db.unique/{identity,value}           (optional)
;   :db/index        maintain AVET for this attribute      (optional)
;   :db/doc          human documentation                   (optional)
;
; ── Why cardinality is the sharpest of these ──────────────────────────
;
; `:db.cardinality/one` means asserting a new value RETRACTS the old one.
; `:db.cardinality/many` means it does not — the attribute accumulates.
;
; That single flag decides whether `(transact conn [{:db/id 1 :person/name
; "Ada"}])` replaces a name or adds a second one. Getting it wrong does not
; error; it silently produces a database where an entity has two names, or
; loses a value that should have accumulated. It is the most consequential
; thing schema says.

(ns datom.schema)

;; ── value types ─────────────────────────────────────────────────────

(def VALUE-TYPES
  #{:db.type/string
    :db.type/long
    :db.type/boolean
    :db.type/keyword
    :db.type/ref
    :db.type/instant})

(def CARDINALITIES #{:db.cardinality/one :db.cardinality/many})

(def UNIQUENESS
  ; :db.unique/identity — the value IDENTIFIES the entity, so asserting it
  ;   for a new tempid UPSERTS onto the existing entity instead of failing.
  ;   This is what makes `{:person/email "a@b.c" :person/age 37}` idempotent.
  ; :db.unique/value — the value must not already exist. Asserting a
  ;   duplicate is an ERROR, not an upsert.
  #{:db.unique/identity :db.unique/value})

;; ── the schema value ────────────────────────────────────────────────
;;
;; A plain map from attribute keyword to its definition map. Plain because
;; schema is data: it can be printed, diffed, merged and asserted on in a
;; test without any accessor ceremony.

(def BUILT-IN
  "Attributes the database defines about ITSELF.

   `:db/txInstant` is the one every transaction carries: the wall-clock
   moment it was recorded. It is what turns a transaction id \u2014 an opaque
   increasing integer \u2014 into something a person can reason about, and it
   is why `as-of` can take a TIME rather than only a `t`.

   These are installed into every schema, so a database is never without
   them and a caller cannot redefine them into something else."
  {:db/txInstant {:db/ident :db/txInstant
                  :db/valueType :db.type/long
                  :db/cardinality :db.cardinality/one}
   :db/ident {:db/ident :db/ident
              :db/valueType :db.type/keyword
              :db/cardinality :db.cardinality/one
              :db/unique :db.unique/identity}
   :db/doc {:db/ident :db/doc
            :db/valueType :db.type/string
            :db/cardinality :db.cardinality/one}
   ; The attributes that describe an ATTRIBUTE. They must be built in,
   ; because schema is written as datoms and those datoms need a schema
   ; to be validated against \u2014 the bootstrap every self-describing system
   ; has to solve somewhere. Solving it with a fixed set of primordial
   ; attributes is the smallest answer: everything ELSE is ordinary data.
   :db/valueType {:db/ident :db/valueType
                  :db/valueType :db.type/keyword
                  :db/cardinality :db.cardinality/one}
   :db/cardinality {:db/ident :db/cardinality
                    :db/valueType :db.type/keyword
                    :db/cardinality :db.cardinality/one}
   :db/unique {:db/ident :db/unique
               :db/valueType :db.type/keyword
               :db/cardinality :db.cardinality/one}
   :db/index {:db/ident :db/index
              :db/valueType :db.type/boolean
              :db/cardinality :db.cardinality/one}})

(defn empty-schema
  "A schema holding only the attributes the database defines about
   itself."
  []
  BUILT-IN)

(defn attr-def
  "The definition map for `attr`, or nil when the attribute is unknown."
  [schema attr]
  (get schema attr))

(defn known?
  "Whether `attr` has been declared."
  [schema attr]
  (some? (attr-def schema attr)))

(defn value-type
  "The declared `:db/valueType`, or nil."
  [schema attr]
  (get (attr-def schema attr) :db/valueType))

(defn cardinality
  "The declared cardinality, defaulting to `:db.cardinality/one` — the
   same default Datomic applies, and the safer one: replacing a value is
   recoverable, silently accumulating duplicates is not."
  [schema attr]
  (or (get (attr-def schema attr) :db/cardinality) :db.cardinality/one))

(defn many?
  "Whether asserting a new value ADDS to this attribute rather than
   replacing its previous value."
  [schema attr]
  (= :db.cardinality/many (cardinality schema attr)))

(defn unique
  "The declared `:db/unique` mode, or nil."
  [schema attr]
  (get (attr-def schema attr) :db/unique))

(defn unique?
  [schema attr]
  (some? (unique schema attr)))

(defn identity-attr?
  "Whether asserting this attribute's value UPSERTS onto an existing
   entity (`:db.unique/identity`) rather than erroring on a duplicate."
  [schema attr]
  (= :db.unique/identity (unique schema attr)))

(defn ref?
  "Whether this attribute's values are references to other entities.
   Reference attributes get the VAET index, which is what makes reverse
   navigation (`:person/_friend`) possible."
  [schema attr]
  (= :db.type/ref (value-type schema attr)))

(defn indexed?
  "Whether AVET is maintained for this attribute.

   Uniqueness IMPLIES indexing: enforcing `:db/unique` requires looking a
   value up, which is exactly what AVET provides. Datomic makes the same
   implication rather than requiring both flags."
  [schema attr]
  (or (get (attr-def schema attr) :db/index) (unique? schema attr) (ref? schema attr)))

;; ── validation ──────────────────────────────────────────────────────

(defn- type-ok?
  "Whether `v` inhabits `t`.

   `:db.type/instant` accepts an integer (epoch milliseconds) rather than
   introducing a date type the language does not have — stated plainly so
   nobody assumes a richer instant exists.
   `:db.type/ref` accepts an integer entity id; resolving a lookup-ref or
   tempid to an id happens BEFORE validation, in the transaction."
  [t v]
  (cond
    (= t :db.type/string) (string? v)
    (= t :db.type/long) (int? v)
    (= t :db.type/boolean) (or (= v true) (= v false))
    (= t :db.type/keyword) (keyword? v)
    (= t :db.type/ref) (int? v)
    (= t :db.type/instant) (int? v)
    :else false))

(defn validate-value
  "Check `v` against `attr`'s declared type. Returns nil when valid, or a
   map describing the violation.

   Returns DATA rather than throwing so a transaction can collect every
   problem in one pass and report them together — four bad fields in one
   map should not require four round trips to discover."
  [schema attr v]
  (let [t (value-type schema attr)]
    (cond
      (not (known? schema attr))
        {:error :unknown-attribute :attr attr}
      (nil? t)
        nil
      (not (type-ok? t v))
        {:error :wrong-type :attr attr :expected t :value v}
      :else nil)))

(defn validate-attr-def
  "Check a schema definition itself, before it is installed.

   Schema errors are the worst kind to discover late: a mistyped
   cardinality silently changes what every future transaction MEANS, and
   by the time it is noticed the database holds facts recorded under the
   wrong rule."
  [definition]
  (let [ident (get definition :db/ident)
        t (get definition :db/valueType)
        c (get definition :db/cardinality)
        u (get definition :db/unique)]
    (cond
      (nil? ident)
        {:error :missing-ident :definition definition}
      (not (keyword? ident))
        {:error :ident-not-a-keyword :ident ident}
      (and (some? t) (not (contains? VALUE-TYPES t)))
        {:error :unknown-value-type :attr ident :value-type t}
      (and (some? c) (not (contains? CARDINALITIES c)))
        {:error :unknown-cardinality :attr ident :cardinality c}
      (and (some? u) (not (contains? UNIQUENESS u)))
        {:error :unknown-uniqueness :attr ident :unique u}
      (and (some? (get definition :db/index))
           (not (contains? #{true false} (get definition :db/index))))
        {:error :index-not-a-boolean :attr ident :index (get definition :db/index)}
      ; An attribute whose values go into AVET must be looked up BY
      ; VALUE, and a value that cannot be ordered cannot be looked up
      ; reliably: codec.bl falls back to encoding unknown types by
      ; serialized shape, which does not preserve their logical order, so
      ; a range scan returns the wrong window rather than an error.
      ;
      ; This applies to `:db/unique` and to an explicit `:db/index` alike
      ; \u2014 both are AVET-backed, so both need a declared type. Checking
      ; only uniqueness let `{:db/ident :x :db/index true}` through, and
      ; `validate-value` then accepted values of ANY shape into an index
      ; whose ordering they break.
      (and (or (some? u) (= true (get definition :db/index))) (nil? t))
        {:error :indexed-attribute-requires-value-type :attr ident}
      :else nil)))

(defn install
  "Add an attribute definition to `schema`. Raises on an invalid one —
   installing bad schema is not recoverable later."
  [schema definition]
  (let [problem (validate-attr-def definition)]
    (if (some? problem)
      (throw (ex-info (str "invalid schema: " (get problem :error)) problem))
      (assoc schema (get definition :db/ident) definition))))

(defn install-all
  "Install many definitions, left to right."
  [schema definitions]
  (reduce install schema definitions))

(def SCHEMA-ATTRS
  "The attributes of an attribute \u2014 what gets written as datoms.

   `:db/ident` comes first because it identifies the attribute entity;
   the rest describe it."
  [:db/ident :db/valueType :db/cardinality :db/unique :db/index :db/doc])

(defn schema-from-datoms
  "Rebuild the schema map from the schema DATOMS in a store.

   The inverse of `definition-datoms`. It exists because a durable store
   outlives its connection: reopening one must recover the vocabulary
   installed before, or reads consult a schema that has forgotten its
   own attributes \u2014 a cardinality-many value would start collapsing to
   a scalar, and an indexed attribute would silently stop being indexed.

   `triples` are `[e a v]` vectors of CURRENT assertions about attribute
   entities. Each entity is one attribute definition; the one carrying
   `:db/ident` names it."
  [triples]
  (reduce (fn [acc entry]
            (let [definition (reduce (fn [m t] (assoc m (get t 1) (get t 2)))
                                     {}
                                     (val entry))
                  ident (get definition :db/ident)]
              (if (nil? ident)
                acc
                (assoc acc ident definition))))
          {}
          (seq (group-by (fn [t] (get t 0)) triples))))

(defn definition-datoms
  "An attribute definition as `[:db/add e a v]` operations.

   Schema is DATA about data, so it belongs in the database as datoms
   rather than beside it in a map only the connection can see. Written
   this way, `[?a :db/ident ?name]` answers, `pull` works on an
   attribute, and a schema change appears in history with a transaction
   and a timestamp like any other change.

   The schema MAP is still what reads consult \u2014 it is touched on every
   datom filter, so deriving it per read would be a serious regression.
   The datoms are the record; the map is the index of it."
  [e definition]
  (filterv some?
           (mapv (fn [a]
                   (let [v (get definition a)]
                     (if (nil? v) nil [:db/add e a v])))
                 SCHEMA-ATTRS)))
