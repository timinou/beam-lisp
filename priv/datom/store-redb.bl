; datom/store-redb.bl — the port, over a real disk.
;
; ── The third implementation ──────────────────────────────────────────
;
; `store-ets` is the development substrate. `store-map` exists to prove
; the port is a port. This one is the answer to the question both of
; them dodge: what happens when the database has to survive the process
; that made it.
;
; It is forty lines of beam-lisp over a Rust NIF, and that ratio is the
; point. Durability, crash recovery, B-tree maintenance and fsync are
; somebody else's solved problems; what this file contributes is the
; translation between our key encoding and theirs, which is nothing,
; because our keys are already binaries.
;
; ── Why redb ──────────────────────────────────────────────────────────
;
; Three of the four requirements are common to every ordered store.
; The fourth is not:
;
;   ATOMIC MULTI-KEY COMMIT
;
; A transaction writes one datom into two to four index orderings. If
; three land and one does not, a query through AEVT reports the fact
; absent while a query through EAVT reports it present. That is not a
; slow database, it is a corrupt one, and no amount of care above L1 can
; repair it after the fact.
;
; redb's `WriteTransaction` gives it directly, so `-commit` here does not
; IMPLEMENT atomicity — it DELEGATES it. That delegation is the entire
; argument for using a storage engine instead of a file.
;
; Rejected, with reasons, in FEAT-014: sled (unmaintained since 2021),
; dets/disk_log (no ordered disk storage in OTP at all), mnesia (wrong
; abstraction, and `ordered_set` is unsupported for disc_only_copies),
; Hobbes (pre-alpha; exclusive range bounds, no CAS, no fsync yet).
;
; ── The one thing to be careful about ─────────────────────────────────
;
; `Durability::Immediate` is set on every write in the NIF and cannot be
; changed from here. redb also offers `Durability::None`, which returns
; from commit without the data reaching disk — a fine mode for a cache
; and a catastrophic default for a database, because a commit that
; returns is a commit the caller believes.

(ns datom.store-redb
  (:require [datom.store] [datom.value-codec]))

;; ── the native backend, declared here rather than in Elixir ─────────
;;
;; `defnative` makes THIS namespace the NIF's host module. Before it,
;; reaching Rust meant hand-writing an Elixir module of stubs whose
;; bodies all read `:erlang.nif_error(:nif_not_loaded)` — a file with no
;; logic in it, existing only to declare that some names are native, and
;; forcing every native capability to enter through Elixir.
;;
;; A NIF is substrate. The declaration that one exists is not, and it
;; belongs beside the code that uses it.
;;
;; Names are kebab here and snake in Rust, the same translation
;; `priv/core.bl` already applies to its primitives.

(defnative "datom_redb"
  (redb-open 1)
  (redb-get 2)
  (redb-range 3)
  (redb-put 3)
  (redb-delete 2)
  (redb-cas 4)
  (redb-commit 2)
  ; Fix A: scan a datom index range and return TYPED COLUMNS, decoding
  ; the packed value slot in Rust. (handle lo hi) -> {e-list v-list tx-list}
  ; where each v is a lane-tagged tuple the codec rebuilds. Retraction
  ; filter applied in Rust.
  (datom-resolve 3))

(defrecord RedbStore [handle])

;; ── values ───────────────────────────────────────────────────
;;
;; KEYS are order-preserving binaries — that encoding is the database's
;; own, and it is what every index depends on, so the store must never
;; reinterpret it.
;;
;; VALUES are not. They are whatever the layer above stored: a datom
;; record, an integer counter. Their bytes are never compared, only
;; returned, so any faithful round trip will do and `term_to_binary` is
;; the obvious one.
;;
;; This asymmetry is worth stating because it is the opposite of what a
;; reader expects: the SORTABLE side is hand-rolled and the opaque side
;; uses the built-in serializer, precisely because sorting is the thing
;; the built-in serializer cannot promise.

; ── scheme C: the datom value slot is a packed typed record ──────────
;;
;; A datom `[e a v tx op]` no longer round-trips through `term_to_binary`.
;; Instead its value slot is a PACKED RECORD the `datom_resolve` NIF reads
;; by fixed offsets, with the value `v` in a schema-free typed lane
;; (`datom.value-codec`). The read path's ~40% ETF-decode tax on this,
;; the durable, backend is what that removes.
;;
;;   datom record layout (value slot):
;;     [ TAG-DATOM(1B) | e:8B LE i64 | tx:8B LE i64 | op:1B
;;       | a-len:2B LE | a-payload… | v-payload… ]
;;
;; `e` and `tx` are integers by construction; `op` is a bool; `a` and `v`
;; are `datom.value-codec` payloads (each lane-tagged), with `a` length-
;; prefixed so both variable-width fields are delimited. Storing `a`
;; (rather than recovering it from the key) keeps the store a black box:
;; `-range`/`-get` return a COMPLETE `[e a v tx op]` datom exactly as
;; before, so nothing above L1 changes. The NIF reads only this slot and
;; never touches the sortable key. (Dropping `a` — it is redundant with
;; the key — is a future size optimization the resolve NIF can add once it
;; parses keys; out of scope here.)
;;
;; NON-datom values also live in this store — the entity/tx COUNTERS are
;; bare integers written through `-update`. They take the ESC path
;; (`TAG-OPAQUE` + `term_to_binary`), so the counter machinery is
;; unchanged and the discriminator is the leading tag byte.

(def TAG-DATOM 1)     ; a packed [e|tx|op|v] datom record
(def TAG-OPAQUE 2)    ; any non-datom value (counters): term_to_binary

(defn- i64-le
  "A signed i64 as 8 little-endian bytes (a list)."
  [n]
  (let [u (if (< n 0) (+ n 18446744073709551616) n)]
    (mapv (fn [i] (rem (erlang/bsr u (* 8 i)) 256)) [0 1 2 3 4 5 6 7])))

(defn- le->i64
  "Recover a signed i64 from a bl vector of 8 little-endian bytes."
  [bytes]
  (let [u (reduce (fn [acc i] (+ acc (* (get bytes i) (erlang/bsl 1 (* 8 i)))))
                  0 [0 1 2 3 4 5 6 7])]
    (if (>= u 9223372036854775808) (- u 18446744073709551616) u)))

(defn- datom?
  "A datom is a 5-element vector `[e a v tx op]`."
  [v]
  (and (vector? v) (= (count v) 5)))

(defn- u16-le
  "An unsigned 16-bit length as 2 little-endian bytes (a list)."
  [n]
  [(rem n 256) (rem (erlang/bsr n 8) 256)])

(defn- encode-value
  [v]
  (if (datom? v)
    (let [e (get v 0) a (get v 1) vv (get v 2) tx (get v 3) op (get v 4)
          a-pay (datom.value-codec/encode a)
          a-bytes (erlang/binary_to_list a-pay)
          v-bytes (erlang/binary_to_list (datom.value-codec/encode vv))]
      (erlang/list_to_binary
        (to-list (concat [TAG-DATOM]
                         (i64-le e)
                         (i64-le tx)
                         [(if op 1 0)]
                         (u16-le (erlang/byte_size a-pay))
                         a-bytes
                         v-bytes))))
    ; a counter or any other opaque value
    (erlang/list_to_binary
      (to-list (concat [TAG-OPAQUE]
                       (erlang/binary_to_list (erlang/term_to_binary v)))))))

(defn- decode-value
  [b]
  (if (nil? b)
    nil
    (let [size (erlang/byte_size b)
          tag (erlang/hd (erlang/binary_to_list (erlang/binary_part b 0 1)))]
      (if (= tag TAG-OPAQUE)
        (erlang/binary_to_term (erlang/binary_part b 1 (- size 1)))
        ; TAG-DATOM: a full [e a v tx op] — the slot carries everything.
        (let [e (le->i64 (into [] (erlang/binary_to_list (erlang/binary_part b 1 8))))
              tx (le->i64 (into [] (erlang/binary_to_list (erlang/binary_part b 9 8))))
              op (= 1 (erlang/hd (erlang/binary_to_list (erlang/binary_part b 17 1))))
              a-len (let [lo (erlang/hd (erlang/binary_to_list (erlang/binary_part b 18 1)))
                          hi (erlang/hd (erlang/binary_to_list (erlang/binary_part b 19 1)))]
                      (+ lo (* hi 256)))
              a-pay (erlang/binary_part b 20 a-len)
              v-off (+ 20 a-len)
              v-pay (erlang/binary_part b v-off (- size v-off))
              a (datom.value-codec/decode a-pay)
              v (datom.value-codec/decode v-pay)]
          [e a v tx op])))))

(defn open
  "Open (or create) a database at `path`.

   The file persists after the process exits — which is the whole point,
   and also the thing to remember when a test leaves one behind."
  [path]
  (->RedbStore (redb-open path)))

(defn available?
  "Whether the native backend loaded.

   The database runs perfectly well without it on `store-ets`, so this is
   a capability question rather than a health check. A persistent
   backend that fails to load should read as ABSENT, never as present
   but not actually durable."
  []
  (BeamLisp.Native/available? "datom.store-redb"))

(extend-type RedbStore
  datom.store/Store

  (-get [store k]
    (decode-value (redb-get (:handle store) k)))

  (-range [store lo hi]
    ; Bounds are INCLUSIVE on both sides, as the port specifies. The NIF
    ; uses `Bound::Included` for each; a half-open upper bound would drop
    ; exactly one datom from the end of every scan, which reads as
    ; sporadically missing data rather than as an error. The conformance
    ; suite asserts this directly, and it caught precisely this mistake
    ; in `store-map` on its first run.
    (mapv (fn [pair] [(erlang/element 1 pair) (decode-value (erlang/element 2 pair))])
          (to-list (redb-range (:handle store) lo hi))))

  (-put [store k v]
    (redb-put (:handle store) k (encode-value v))
    store)

  (-delete [store k]
    (redb-delete (:handle store) k)
    store)

  (-update [store k f]
    ; A compare-and-swap LOOP, because the port promises atomicity and
    ; `-get` then `-put` does not provide it: two writers both read
    ; `t=41`, both write `t=42`, and the database has two transactions
    ; claiming one basis.
    ;
    ; The NIF performs its read and its write inside ONE redb write
    ; transaction, so a losing attempt is DETECTED rather than lost. `f`
    ; must be pure — the port says so precisely because it may run more
    ; than once here.
    ;
    ; No attempt ceiling. A bounded loop looks prudent and is not: under
    ; ten concurrent writers the bound was reached and the caller got an
    ; exception instead of a slower answer. A CAS loop that gives up has
    ; not made the operation safe, it has made it unreliable — and the
    ; loop cannot spin forever anyway, because every iteration that
    ; fails does so BECAUSE another writer succeeded. The system makes
    ; progress even when this caller does not.
    ;
    ; The yield matters under contention: without it a losing process
    ; re-reads immediately and collides again, and ten of them can
    ; livelock each other while the store is perfectly available.
    (loop [attempt 0]
      (let [raw (redb-get (:handle store) k)
            next (f (decode-value raw))
            encoded (encode-value next)
            ; `{swapped?, value}` — the flag is not redundant. Judging
            ; success by comparing the returned value against `new`
            ; reported a WIN whenever the key already held `new`, which
            ; is exactly the case a retry loop exists to detect: two
            ; writers converging on one value by different paths, one of
            ; whom must lose and re-read.
            result (redb-cas (:handle store) k raw encoded)]
        (if (erlang/element 1 result)
          [store next]
          (do (if (> attempt 8) (erlang/yield) nil)
              (recur (+ attempt 1)))))))

  (-commit [store ops]
    ; THE method this backend exists for. The whole batch reaches disk
    ; together or not at all, and the operations apply IN ORDER —
    ; `[[:delete k] [:put k v]]` is what a transaction emits when it
    ; retracts and re-asserts a datom, so a backend that grouped puts
    ; ahead of deletes would end with the key absent.
    (redb-commit
      (:handle store)
      (to-list (mapv (fn [op]
                       (if (= (get op 0) :put)
                         (erlang/list_to_tuple
                           (to-list [:put (get op 1) (encode-value (get op 2))]))
                         (erlang/list_to_tuple (to-list [:delete (get op 1)]))))
                     ops)))
    store))

;; ── Fix A: the typed columnar read path ─────────────────────────────
;;
;; `resolve` is what the datalog engine calls instead of a scan that hands
;; back a list of datom vectors decoded one ETF blob at a time. The NIF
;; scans the redb range, decodes each packed value record in Rust, applies
;; the retraction filter, and returns three parallel columns — entities,
;; typed values, transactions — in ONE crossing. `a` is constant per scan
;; (the caller fixes one attribute via the key range) and is not returned.
;;
;; Each value comes back as a lane-tagged tuple that mirrors
;; `datom.value-codec`; `rebuild-value` turns it into the BEAM value. The
;; ESC lane carries raw ETF bytes, reconstituted here by `binary_to_term`
;; — the any-term lane that keeps datom's "store any structure" promise.

(defn- rebuild-value
  "Turn a `{lane, body}` tuple from the NIF back into a BEAM value."
  [tagged]
  (let [lane (erlang/element 1 tagged)
        body (erlang/element 2 tagged)]
    (cond
      (= lane :long) body
      (= lane :boolean) body
      (= lane :float) body
      (= lane :string) body
      (= lane :keyword) (keyword body)
      (= lane :esc) (erlang/binary_to_term body)
      :else (throw (ex-info (str "unknown resolve lane: " lane) {:lane lane})))))

(defn resolve
  "Scan the datom index range `[lo, hi]` and return DATOMS `[e a v tx op]`,
   decoding each packed value record in Rust rather than one ETF blob per
   datom on the BEAM. This is the fast, durable-path counterpart to
   `index/scan`: same datoms, same order, no per-datom ETF decode, and it
   never touches the sortable key.

   It returns RAW datoms — no retraction or time-travel filtering. That is
   deliberate: `datom.db/filter-datoms` is the system's single, basis-aware
   filter, and it runs over these datoms exactly as it runs over a scan's,
   so every backend shares one filter semantics."
  [store lo hi]
  (let [cols (datom-resolve (:handle store) lo hi)
        es (erlang/element 1 cols)
        as (mapv rebuild-value (into [] (erlang/element 2 cols)))
        vs (mapv rebuild-value (into [] (erlang/element 3 cols)))
        txs (into [] (erlang/element 4 cols))
        ops (into [] (erlang/element 5 cols))
        n (count es)
        es-v (into [] es)]
    (mapv (fn [i] [(get es-v i) (get as i) (get vs i) (get txs i) (get ops i)])
          (range n))))

;; The Scan capability: RedbStore reads a datom range in one native
;; crossing, decoding the packed records in Rust. This is the override
;; `store/scan-datoms` dispatches to; every other backend uses the
;; range-read default (its values are already live datoms).
;;
;; `extend-protocol` (not a second `extend-type RedbStore`): the AOT
;; compiler keys replayed type extensions by "extend-type <Type>", so two
;; `extend-type RedbStore` blocks would collide and only the last would
;; survive an AOT build — dropping the Store impl. Extending from the
;; PROTOCOL side keys differently and composes cleanly.
(extend-protocol datom.store/Scan
  RedbStore
  (-scan-datoms [store lo hi] (resolve store lo hi)))

;; redb is a single FILE; `.redb` is its natural suffix. Extending from the
;; protocol side for the same AOT reason as Scan above.
(extend-protocol datom.store/FileBacked
  RedbStore
  (-path-suffix [store] ".redb"))

(defn open-fresh
  "Open a redb store at a fresh unique path — the durable analogue of a
   throwaway in-memory store, for tests and one-off durable work. The engine
   owns its own naming convention, so a caller never hardcodes `.redb`."
  []
  (open (datom.store/fresh-path ".redb")))
