; datom/store-sqlite.bl — the storage port, over SQLite (a B-tree engine).
;
; A durable substrate under datom.store/Store, beside the fjall LSM backend and
; the in-memory ETS and map stores. SQLite is a B-tree; fjall is an LSM tree.
; Both fill the SAME six-method protocol, so everything above L1 cannot tell
; them apart — which is the whole point of having two: a like-for-like
; comparison of the two durable engines on the identical datom workload (see
; bench/store_backend_bench.bl).
;
; ── Why SQLite maps onto the port directly ────────────────────────────
;
; The port needs an ORDERED key space and an ATOMIC multi-key commit. SQLite
; gives both from one table:
;
;   CREATE TABLE datoms (k BLOB PRIMARY KEY, v BLOB NOT NULL) WITHOUT ROWID;
;
; `WITHOUT ROWID` makes the table itself a B-tree keyed by `k`, and a BLOB
; primary key compares by memcmp — byte-lexicographic, EXACTLY the ordering the
; datom key codec produces. So a prefix scan of the AEVT range is a native
; B-tree range scan with no reinterpretation of the key. `-commit` opens one
; SQL transaction and applies every op in order: all-or-nothing, the property a
; torn index would violate.
;
; Values round-trip through term_to_binary (the store only requires a faithful
; value round trip; only KEYS must be order-preserving, and those are passed
; through untouched). The columnar `Scan` fast path fjall's redb ancestor
; explored is not implemented here — the generic -range scan is correct and is
; what everything above uses today.

(ns datom.store-sqlite
  (:require [datom.store]))

;; ── the native backend, declared here (defnative makes this ns the host) ──

(defnative "datom_sqlite"
  (sqlite-open 1)
  (sqlite-get 2)
  (sqlite-range 3)
  (sqlite-put 3)
  (sqlite-delete 2)
  (sqlite-cas 4)
  (sqlite-commit 2)
  (sqlite-sync 1))

(defrecord SqliteStore [handle])

;; ── values: faithful round trip, nothing more ───────────────────────
;; KEYS are the database's own order-preserving binaries — never reinterpreted.
;; VALUES are whatever the layer above stored; their bytes are only returned,
;; never compared, so term_to_binary is the obvious faithful codec.

(defn- encode-value [v] (erlang/term_to_binary v))
(defn- decode-value [b] (if (nil? b) nil (erlang/binary_to_term b)))

(defn open
  "Open (or create) a SQLite-backed store at `path`. The database file persists
   after the process exits — which is the whole point: reopening recovers every
   datom."
  [path]
  (->SqliteStore (sqlite-open path)))

(defn available?
  "Whether the native SQLite backend loaded. A persistent backend that fails to
   load should read as ABSENT, never as present-but-not-durable."
  []
  (BeamLisp.Native/available? "datom.store-sqlite"))

(extend-type SqliteStore
  datom.store/Store

  (-get [store k]
    (decode-value (sqlite-get (:handle store) k)))

  (-range [store lo hi]
    ; Bounds INCLUSIVE on both sides, as the port specifies (the NIF builds
    ; `k >= lo AND k <= hi`); a half-open upper bound silently drops one datom
    ; per scan. The conformance suite asserts this.
    (mapv (fn [pair] [(erlang/element 1 pair) (decode-value (erlang/element 2 pair))])
          (to-list (sqlite-range (:handle store) lo hi))))

  (-put [store k v]
    (sqlite-put (:handle store) k (encode-value v))
    store)

  (-delete [store k]
    (sqlite-delete (:handle store) k)
    store)

  (-update [store k f]
    ; A compare-and-swap LOOP: -get then -put is not atomic, so two writers can
    ; both read t=41 and both write t=42. The NIF does its read+write inside one
    ; IMMEDIATE transaction, so a losing attempt is DETECTED (the {swapped?,
    ; value} flag), and the loop re-reads. `f` must be pure — it may run more
    ; than once. No attempt ceiling: every failed iteration failed BECAUSE
    ; another writer won, so the system always makes progress; yield after a few
    ; spins to avoid a livelock under heavy contention.
    (loop [attempt 0]
      (let [raw (sqlite-get (:handle store) k)
            next (f (decode-value raw))
            encoded (encode-value next)
            result (sqlite-cas (:handle store) k raw encoded)]
        (if (erlang/element 1 result)
          [store next]
          (do (if (> attempt 8) (erlang/yield) nil)
              (recur (+ attempt 1)))))))

  (-commit [store ops]
    ; THE method this backend exists for: the whole batch lands together or not
    ; at all, applied IN ORDER — [[:delete k] [:put k v]] is a retract-then-
    ; reassert, so grouping puts ahead of deletes would lose the value.
    (sqlite-commit
      (:handle store)
      (to-list (mapv (fn [op]
                       (if (= (get op 0) :put)
                         (erlang/list_to_tuple
                           (to-list [:put (get op 1) (encode-value (get op 2))]))
                         (erlang/list_to_tuple (to-list [:delete (get op 1)]))))
                     ops)))
    store))

;; SQLite is a SINGLE FILE (plus its -wal/-shm sidecars); `.sqlite` names that.
;; Extending from the protocol side, the same AOT-safe way the fjall store does
;; (two `extend-type <Type>` blocks would collide under AOT).
(extend-protocol datom.store/FileBacked
  SqliteStore
  (-path-suffix [store] ".sqlite"))

(defn open-fresh
  "Open a SQLite store at a fresh unique path. The engine owns its naming
   convention (a single file), so a caller never hardcodes a suffix."
  []
  (open (datom.store/fresh-path ".sqlite")))

(defn sync!
  "Force everything written so far to disk via a full WAL checkpoint (fsync).
   Writes journal (crash-recoverable) on each put/commit but do NOT fsync per
   call — fsyncing per datom-group is the dominant bulk-load cost. Call this
   once at a durability boundary (end of a transaction or a bulk load) to turn N
   per-group fsyncs into one."
  [store]
  (sqlite-sync (:handle store))
  store)
