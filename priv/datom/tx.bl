; datom/tx.bl — turning transaction data into datoms.
;
; ── What a transaction is ─────────────────────────────────────────────
;
; A request to record facts. The caller writes DATA — maps and vectors —
; and this layer resolves it into datoms, which are then written to every
; index in one atomic commit.
;
;   [{:db/id -1 :person/name "Ada" :person/age 36}]   a map form
;   [[:db/add 1 :person/age 37]]                       an explicit assert
;   [[:db/retract 1 :person/age 36]]                   an explicit retract
;
; Map form is sugar: it expands to one `:db/add` per attribute-value pair,
; all sharing the entity id. `:db/id` names the entity; a NEGATIVE id is a
; tempid, resolved here to a real one.
;
; ── The three jobs, in order ──────────────────────────────────────────
;
; 1. EXPAND    map forms into individual assertions
; 2. RESOLVE   tempids to real entity ids (and upsert onto existing
;              entities when a `:db.unique/identity` value already exists)
; 3. REALIZE   assertions into datoms, adding retractions where
;              cardinality-one demands them
;
; Step 3 is the one that surprises people. Asserting `:person/age 37` on
; an entity that already has `:person/age 36` produces TWO datoms: a
; retraction of 36 and an assertion of 37. The old value is not deleted —
; nothing is ever deleted — it is superseded, with both facts remaining in
; the log at different transaction ids. That is precisely why `as-of` can
; show the database as it was: the past is still there.
;
; ── Tempids ───────────────────────────────────────────────────────────
;
; A tempid is a negative integer, meaningful only WITHIN one transaction.
; The same tempid used twice refers to the same new entity, which is how
; a transaction builds a graph:
;
;   [{:db/id -1 :person/name "Ada"}
;    {:db/id -2 :person/name "Grace" :person/friend -1}]
;
; Both entities are created and -2's `:person/friend` points at whatever
; real id -1 became.

(ns datom.tx
  (:require [datom.index] [datom.schema] [datom.store]))

;; ── expansion ───────────────────────────────────────────────────────

(defn- map-form->ops
  "Expand `{:db/id e :attr v …}` into `[:db/add e :attr v]` operations.

   A cardinality-many attribute may carry a VECTOR of values, each
   becoming its own assertion — `{:person/friend [-1 -2]}` asserts two
   facts rather than one fact whose value is a vector."
  [schema m]
  (let [e (get m :db/id)]
    (if (nil? e)
      (throw (ex-info "a transaction map needs a :db/id" {:map m}))
      (reduce (fn [acc entry]
                (let [a (key entry)
                      v (val entry)]
                  (if (= a :db/id)
                    acc
                    (if (and (datom.schema/many? schema a) (vector? v))
                      (into acc (mapv (fn [each] [:db/add e a each]) v))
                      (conj acc [:db/add e a v])))))
              []
              (seq m)))))

(def TX-SELF
  "The tempid a transaction uses to refer to ITSELF.

   `{:db/id :db/current-tx :audit/by \"ada\"}` annotates the transaction
   rather than any entity in it \u2014 who made this change, from which
   request, under what authorization. That is the metadata an audit log
   is made of, and it belongs ON the transaction because it describes the
   change rather than the data.

   A keyword rather than a negative integer, because it is not a tempid
   to be allocated: it resolves to the transaction's own id, which the
   transaction already knows."
  :db/current-tx)

(defn expand
  "Normalize transaction data into a flat vector of `[:db/add e a v]` and
   `[:db/retract e a v]` operations."
  [schema tx-data]
  (reduce (fn [acc form]
            (cond
              (map? form) (into acc (map-form->ops schema form))
              (vector? form) (conj acc form)
              :else (throw (ex-info "unrecognised transaction form" {:form form}))))
          []
          tx-data))

(defn- entity-retraction-ops
  "`[:db/retractEntity e]` as the retractions it stands for.

   Every datom the entity currently holds, PLUS every reference TO it.
   The incoming refs are the half that is easy to forget and impossible
   to repair later: retracting a person but leaving `:person/friend`
   pointing at them leaves dangling references that every reader has to
   defend against, and `pull` would happily follow one into an entity
   with no datoms.

   Values are read from the CURRENT database, so retracting an entity
   twice is a no-op the second time rather than a pile of retractions of
   facts that already stopped being true."
  [store schema e]
  (let [own (mapv (fn [d] [:db/retract (datom.index/-e d) (datom.index/-a d) (datom.index/-v d)])
                  (filterv datom.index/assertion? (datom.index/scan store :eavt e)))
        incoming (mapv (fn [d] [:db/retract (datom.index/-e d) (datom.index/-a d) (datom.index/-v d)])
                       (filterv datom.index/assertion? (datom.index/scan store :vaet e)))]
    (into own incoming)))

(defn- cas-ops
  "`[:db/cas e a old new]` as the assertion it authorizes, or a failure.

   Compare-and-swap is the primitive that makes a read-modify-write SAFE
   without holding a lock: the caller states the value they read, and the
   transaction refuses if the world moved underneath them. Without it,
   `(transact! conn [[:db/add e :count (inc current)]])` silently loses
   the other writer's increment.

   `old` of nil asserts the attribute is currently EMPTY, which is how
   you say `create this exactly once`."
  [store schema e a old new]
  (let [held (current-values store e a [])
        matches? (if (nil? old) (empty? held) (contains? (set held) old))]
    (if matches?
      [[:db/add e a new]]
      (throw (ex-info "compare-and-swap failed: the value changed"
                      {:entity e :attr a :expected old :actual held})))))

(defn expand-store-ops
  "Expand operations that need to READ the database to know what they
   mean: `:db/retractEntity` and `:db/cas`.

   Kept separate from `expand` because `expand` is a pure syntactic
   normalization over transaction data, while these two are questions
   about current state. Running them here \u2014 after tempid resolution, so
   `e` is a real id \u2014 means they compose with everything else: a
   retracted entity's datoms go through the same validation, uniqueness
   and net-effect passes as any other retraction."
  [store schema ops]
  (reduce (fn [acc op]
            (let [kind (get op 0)]
              (cond
                (= kind :db/retractEntity)
                  (into acc (entity-retraction-ops store schema (get op 1)))

                (= kind :db/cas)
                  (into acc (cas-ops store schema (get op 1) (get op 2) (get op 3) (get op 4)))

                :else (conj acc op))))
          []
          ops))

;; ── tempid resolution ───────────────────────────────────────────────

(defn tempid?
  "Whether `e` is a tempid: a negative integer, scoped to one transaction."
  [e]
  (and (int? e) (< e 0)))

(defn current-holder
  "The entity that currently holds `[a v]`, or nil.

   Goes through `current-values` rather than a raw AVET scan, so a
   RETRACTED value is not treated as still held. The raw scan version
   silently upserted new data onto an entity whose identity had been
   retracted long ago."
  [store a v]
  (let [hits (datom.index/scan store :avet a v)]
    (reduce (fn [found d]
              (if (some? found)
                found
                (let [e (datom.index/-e d)]
                  (if (contains? (set (current-values store e a [])) v) e nil))))
            nil
            hits)))

(defn- identity-claims
  "The `[attr value]` pairs by which `tempid` claims an identity."
  [schema ops tempid]
  (filterv some?
           (mapv (fn [op]
                   (let [e (get op 1) a (get op 2) v (get op 3)]
                     (if (and (= e tempid)
                              (= (get op 0) :db/add)
                              (datom.schema/identity-attr? schema a))
                       [a v]
                       nil)))
                 ops)))

(defn- claims-index
  "Every tempid's identity claims, built in ONE pass over `ops`.

   `identity-claims` walks all of `ops` for ONE tempid, so calling it per
   tempid is O(ops x tempids) \u2014 and `resolve-tempids` called it inside a
   nested loop, making it worse still. A bulk transaction is exactly the
   case where that bites: 400 entities took over two minutes, and the
   cost is quadratic in the size of the transaction rather than in the
   database.

   This is a map from tempid to its `[attr value]` claims, so the callers
   below index instead of scanning."
  [schema ops]
  (reduce (fn [acc op]
            (let [e (get op 1) a (get op 2) v (get op 3)]
              (if (and (tempid? e)
                       (= (get op 0) :db/add)
                       (datom.schema/identity-attr? schema a))
                (assoc acc e (conj (or (get acc e) []) [a v]))
                acc)))
          {}
          ops))

(defn- upsert-target
  "The existing entity a tempid's `:db.unique/identity` values resolve to,
   or nil.

   This is what makes a transaction IDEMPOTENT: asserting a person's
   unique email twice updates one entity rather than creating a second.

   Raises when one tempid claims identities belonging to DIFFERENT
   existing entities — that transaction has no correct outcome, and
   silently picking the first would merge two people."
  [store claims]
  (let [targets (into [] (distinct (filterv some?
                                            (mapv (fn [claim]
                                                    (current-holder store (get claim 0) (get claim 1)))
                                                  claims))))]
    (cond
      (empty? targets) nil
      (= 1 (count targets)) (first targets)
      :else (throw (ex-info "one tempid claims identities held by different entities"
                            {:tempid tempid :entities targets})))))

;; ── realization ─────────────────────────────────────────────────────

(defn resolve-tempids
  "Map every tempid in `ops` to a real entity id.

   Returns `[resolved-ops tempid->id]`. The mapping is returned because
   the CALLER needs it: after transacting, `{-1 4711}` is how you learn
   which entity your tempid became — the `:tempids` a Datomic transaction
   report carries.

   Two tempids claiming the SAME identity resolve to the SAME id, even
   when neither exists yet. Without that, transacting

     [{:db/id -1 :person/email \"a@b.c\"}
      {:db/id -2 :person/email \"a@b.c\" :person/age 5}]

   created two entities sharing a value declared unique — a database that
   violates its own schema, with no error."
  [store schema ops next-id-fn]
  (let [; Tempids come from the entity slot AND from the value slot of a
        ; ref attribute. A tempid appearing ONLY as a ref value is how you
        ; say `link to the entity this transaction is about to create`
        ; without giving it a map of its own. Collecting from the entity
        ; slot alone left such a tempid unmapped, so the resolver passed
        ; it through and the raw NEGATIVE id was persisted as the ref
        ; value: a transaction-scoped placeholder leaked into durable
        ; data, pointing at an entity that never existed.
        tempids (into [] (distinct
                           (filterv tempid?
                                    (into (mapv (fn [op] (get op 1)) ops)
                                          (mapv (fn [op]
                                                  (if (datom.schema/ref? schema (get op 2))
                                                    (get op 3)
                                                    nil))
                                                ops)))))
        ; Every tempid's identity claims, in one pass rather than one
        ; pass PER TEMPID.
        claims-by-tempid (claims-index schema ops)
        ; First pass: existing entities an identity claim points at.
        existing (reduce (fn [acc t]
                           (let [target (upsert-target store (or (get claims-by-tempid t) []))]
                             (if (some? target) (assoc acc t target) acc)))
                         {}
                         tempids)
        ; Second pass: tempids with no existing target get a fresh id —
        ; but tempids sharing an identity claim share that id. Indexing
        ; claim -> tempid makes finding a twin a LOOKUP; scanning every
        ; other tempid (and recomputing its claims) was the third nested
        ; walk over the transaction.
        mapping (reduce (fn [acc t]
                          (if (contains? acc t)
                            acc
                            (let [claims (or (get claims-by-tempid t) [])
                                  twin (reduce (fn [found c]
                                                 (if (some? found)
                                                   found
                                                   (get (get acc :by-claim) c)))
                                               nil
                                               claims)
                                  id (or twin (next-id-fn))]
                              (assoc (reduce (fn [a c]
                                               (assoc a :by-claim
                                                      (assoc (or (get a :by-claim) {}) c id)))
                                             acc
                                             claims)
                                     t id))))
                        (assoc existing :by-claim
                               (reduce (fn [a t]
                                         (reduce (fn [b c] (assoc b c (get existing t)))
                                                 a
                                                 (or (get claims-by-tempid t) [])))
                                       {}
                                       (filterv (fn [t] (contains? existing t)) tempids)))
                        tempids)
        ; the claim index is scaffolding, not part of the answer
        mapping (dissoc mapping :by-claim)
        resolve (fn [x] (if (and (tempid? x) (contains? mapping x)) (get mapping x) x))]
    [(mapv (fn [op]
             ; Resolve the entity position AND the value position: a ref
             ; attribute's value may itself be a tempid, which is what
             ; lets one transaction build a graph of new entities.
             ;
             ; Rebuilds the op IN PLACE rather than to a fixed shape.
             ; Emitting exactly four elements silently truncated the
             ; five-element `[:db/cas e a old new]`, so the new value
             ; vanished and the op then failed validation complaining
             ; about a nil it had itself created \u2014 an error message
             ; pointing at the wrong thing entirely.
             (let [a (get op 2)
                   resolved-e (resolve (get op 1))
                   resolve-value (fn [x] (if (datom.schema/ref? schema a) (resolve x) x))]
               (into [(get op 0) resolved-e]
                     (mapv (fn [i] (resolve-value (get op i)))
                           (loop [i 2 acc []]
                             (if (>= i (count op)) acc (recur (+ i 1) (conj acc i))))))))
           ops)
     mapping]))

(defn current-values
  "The values `[e a]` currently holds — values, not datoms.

   CURRENT means asserted and NOT retracted since, which is exactly what
   `datom.db` computes for reads. An earlier version filtered a raw index
   scan by `assertion?` alone, which answers a different question: it
   treats every historical assertion as if it still held. Two silent bugs
   followed — a superseded value could not be restored (re-asserting it
   looked like a no-op), and identity upsert matched values retracted
   long ago.

   `pending` is the transaction's own datoms so far. Realization must see
   them, or two assertions of one cardinality-one attribute in a SINGLE
   transaction both read the pre-transaction store and both assert,
   leaving the entity with two current values for an attribute declared
   to hold one."
  [store e a pending]
  (let [relevant (into (datom.index/scan store :eavt e a)
                       ; `pending` is either a raw vector of datoms or an
                       ; index of [e a] -> datoms. The index matters
                       ; because realization calls this once PER
                       ; OPERATION: filtering the whole pending list each
                       ; time is O(ops^2) within a single transaction,
                       ; which made a 400-entity transaction take minutes
                       ; while the same data in 400 transactions was
                       ; fast.
                       (if (map? pending)
                         (or (get pending [e a]) [])
                         (filterv (fn [d] (and (= (datom.index/-e d) e)
                                               (= (datom.index/-a d) a)))
                                  pending)))]
    ; Replay in tx order: an assertion adds a value, a retraction removes
    ; it. What survives the fold is what currently holds.
    (reduce (fn [acc d]
              (let [v (datom.index/-v d)]
                (if (datom.index/assertion? d)
                  (if (contains? (set acc) v) acc (conj acc v))
                  (filterv (fn [x] (not (= x v))) acc))))
            []
            (sort-by datom.index/-tx relevant))))

(defn- realize-op
  "One operation as the datoms it implies, given the transaction's datoms
   so far.

   An assertion on a cardinality-ONE attribute first RETRACTS whatever
   that attribute currently holds. Without that retraction the entity
   ends up with two values for an attribute declared to have one, and
   every read has to guess which is current."
  [store schema tx op pending]
  (let [kind (get op 0)
        e (get op 1)
        a (get op 2)
        v (get op 3)
        held (current-values store e a pending)
        holds-v? (contains? (set held) v)]
    (cond
      ; Retracting a value the entity does not hold is a NO-OP, as in
      ; Datomic. Recording it anyway wrote a datom for a fact that never
      ; existed, polluting history and the transaction report.
      (= kind :db/retract)
        (if holds-v? [(datom.index/datom e a v tx false)] [])

      (= kind :db/add)
        (cond
          ; A datom is a FACT: asserting one that already HOLDS is a
          ; no-op at every cardinality. `holds-v?` asks about the CURRENT
          ; value, not about history — re-asserting a value that was
          ; superseded must genuinely restore it.
          holds-v?
            []

          ; Cardinality-many accumulates: no supersession.
          (datom.schema/many? schema a)
            [(datom.index/datom e a v tx true)]

          ; Cardinality-one holds ONE value, so asserting a new one
          ; retracts what is currently there. Both datoms carry the same
          ; tx, which makes the change atomic and keeps the superseded
          ; value readable through `history`.
          :else
            (conj (mapv (fn [old] (datom.index/datom e a old tx false)) held)
                  (datom.index/datom e a v tx true)))

      :else (throw (ex-info (str "unknown operation: " kind) {:op op})))))

(defn- fact-key
  "The identity of the FACT a datom is about: `[e a v]`.

   Assertion and retraction of one fact share this key; `op` is what
   distinguishes them."
  [d]
  [(datom.index/-e d) (datom.index/-a d) (datom.index/-v d)])

(defn- net-datoms
  "Reduce a transaction's datoms to its NET effect.

   A transaction is ATOMIC, so its intermediate states never existed to
   any observer. Recording them is not merely wasteful, it is false: it
   writes history describing moments that never happened, and it leaves
   contradictory datoms that a reader then has to adjudicate.

   Two operations on one fact within a transaction collapse to whichever
   came LAST, and that survivor is dropped when it agrees with the state
   before the transaction. So:

     [[:db/add e :age 37] [:db/add e :age 38]]
       naively: assert 37, retract 36, retract 37, assert 38
       net:     retract 36, assert 38        (37 never existed)

     [[:db/retract e :n 7] [:db/add e :n 7]]
       naively: retract 7, assert 7
       net:     nothing                      (nothing changed)

   Without this, a same-tx retract-then-re-add left BOTH datoms at one
   tx, and no reader could tell which came last: `tx` alone cannot order
   two operations inside a single transaction. Reading it one way made
   the re-added value vanish; the other way made a superseded value
   linger. The fix is not a better tiebreak \u2014 it is to never write the
   contradiction."
  [store datoms]
  (let [last-index (reduce (fn [acc pair]
                             (assoc acc (fact-key (get pair 1)) (get pair 0)))
                           {}
                           (map-indexed (fn [i d] [i d]) datoms))
        ; The pre-transaction value set for each [e a] touched, scanned
        ; ONCE. `held-before?` scans per FACT, and a cardinality-many
        ; attribute with k values would scan k times for the same [e a].
        held-by-ea (reduce (fn [acc d]
                             (let [k [(datom.index/-e d) (datom.index/-a d)]]
                               (if (contains? acc k)
                                 acc
                                 (assoc acc k (set (current-values store (get k 0) (get k 1) []))))))
                           {}
                           datoms)]
    (filterv some?
             (map-indexed
               (fn [i d]
                 (let [k (fact-key d)]
                   (if (not (= i (get last-index k)))
                     ; superseded within this transaction
                     nil
                     (let [held (contains? (get held-by-ea [(datom.index/-e d) (datom.index/-a d)])
                                           (datom.index/-v d))]
                       (if (= (datom.index/assertion? d) held)
                         ; agrees with the pre-transaction state: no change
                         nil
                         d)))))
               datoms))))

(defn realize
  "Every datom implied by `ops`, in order.

   Threads the datoms produced so far into each step, so an operation
   sees the transaction's own earlier effects, then reduces the result to
   the transaction's NET effect (see `net-datoms`)."
  [store schema tx ops]
  (let [result (reduce
                 (fn [acc op]
                   (let [produced (realize-op store schema tx op (get acc :index))]
                     {:datoms (into (get acc :datoms) produced)
                      ; Keep the pending datoms indexed by [e a] as we
                      ; go, so each operation looks up only the facts it
                      ; is about rather than re-scanning everything the
                      ; transaction has produced so far.
                      :index (reduce (fn [idx d]
                                       (let [k [(datom.index/-e d) (datom.index/-a d)]]
                                         (assoc idx k (conj (or (get idx k) []) d))))
                                     (get acc :index)
                                     produced)}))
                 {:datoms [] :index {}}
                 ops)]
    (net-datoms store (get result :datoms))))

;; ── validation ──────────────────────────────────────────────────────

(defn- uniqueness-violation
  "A `:db.unique/value` conflict for `op`, or nil.

   `:db.unique/value` promises the value appears at most once in the
   database, and asserting a duplicate is an ERROR — that is the whole
   difference from `:db.unique/identity`, which UPSERTS instead. The
   schema declared the distinction from the start but nothing enforced
   it, so two entities could hold the same unique value with no
   complaint: a database violating its own schema, silently."
  [store schema op]
  (let [e (get op 1)
        a (get op 2)
        v (get op 3)]
    (if (and (= (get op 0) :db/add)
             (= :db.unique/value (datom.schema/unique schema a)))
      (let [holder (current-holder store a v)]
        ; A tempid has no id yet, so any existing holder is a conflict.
        ; For a real id, re-asserting the entity's OWN value is fine.
        (if (and (some? holder) (not (= holder e)))
          {:error :unique-value-conflict :attr a :value v :held-by holder}
          nil))
      nil)))

(defn- entity-id-problem
  "An unusable entity id in `op`, or nil.

   An entity id is an INTEGER \u2014 that is what `:db.type/ref` values are,
   and it is what the codec encodes. Nothing checked the entity slot, so
   `{:db/id \u0022abc\u0022 ...}` and `{:db/id :named ...}` were accepted and became
   readable entities that no ref could ever point at: the database
   happily stored a graph node unreachable by its own reference type.

   Tempids (negative integers) are legal here; they are resolved to real
   ids before this runs. A lookup ref is not accepted in the entity slot
   yet, so it is named explicitly rather than falling into the generic
   message."
  [op]
  (let [e (get op 1)]
    (cond
      (int? e) nil
      ; `:db/current-tx` is resolved to the transaction's own id before
      ; the datoms are written, so it is a legal entity position here.
      (= e TX-SELF) nil
      (vector? e) {:error :lookup-ref-in-entity-position :entity e}
      :else {:error :invalid-entity-id :entity e})))

(defn validate
  "Every schema violation in `ops`, as data.

   Collected rather than thrown one at a time so a caller learns about
   all four bad fields at once instead of fixing them one round trip
   apiece.

   Takes the store because uniqueness is not a property of a value in
   isolation — it is a question about the rest of the database."
  [store schema ops]
  (into []
        (filterv some?
                 (into (into (mapv (fn [op] (datom.schema/validate-value schema (get op 2) (get op 3)))
                                   ops)
                             (mapv entity-id-problem ops))
                       (mapv (fn [op] (uniqueness-violation store schema op)) ops)))))
