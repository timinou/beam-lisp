; datom/codec.bl — order-preserving key encoding.
;
; ── The one job ───────────────────────────────────────────────────────
;
; Turn a datom's components into a BINARY whose BYTE order equals the
; logical order of the values it encodes. Everything the index layer does
; rests on that single property:
;
;   sort(encode(a), encode(b))  ==  sort(a, b)
;
; Given it, an index is just "write the components in the right order and
; range-scan the result". Without it, an index is a lie.
;
; ── Why binaries, and not the obvious tuple ───────────────────────────
;
; The natural spelling of an index key is a tuple: `[:eavt e a v tx]`.
; It does not work, and the way it fails is instructive (BUG-005).
;
; Erlang compares tuples by ARITY FIRST, then element-wise. So a short
; "prefix" key does not sort adjacent to the longer keys sharing its
; prefix — it sorts before ALL of them:
;
;   {:eavt} < {:aevt, 1, :age}   → true
;
; A prefix scan bounded by `[:eavt] .. [:eavt 999]` therefore brackets
; the WRONG window: both bounds are lower-arity than any real key, so the
; window closes before it opens and the scan returns NOTHING. An index
; built on tuple keys would silently report an empty database.
;
; Binaries have no such rule: Erlang compares them byte by byte, and a
; proper prefix sorts immediately before its extensions — exactly the
; property a prefix scan needs. This is also what FoundationDB's tuple
; layer does, and therefore what Hobbes's `lib/enc/` does, so wave 6
; aligns with the substrate instead of translating at the seam.
;
; ── The encoding ──────────────────────────────────────────────────────
;
; Each value becomes: <type-tag byte> <payload bytes>
;
; The TAG orders types (so cross-type comparison is total and matches the
; language's own order); the PAYLOAD orders values within a type. Tags
; mirror `BeamLisp.RT.compare/2`'s ranks so the codec agrees with `sort`
; and `compare` rather than inventing a second order — the mistake wave 1
; made in `sorted.ex` and had to correct.
;
; Integers are the subtle case. A plain big-endian encoding breaks for
; negatives (two's complement makes -1 look larger than 1) and for mixed
; widths. The fix is an OFFSET: shift the signed range into an unsigned
; one, then encode fixed-width big-endian. 8 bytes covers the entity-id
; and transaction range with room to spare.

(ns datom.codec)

;; ── type tags ───────────────────────────────────────────────────────
;;
;; Mirrors RT.compare's rank order: nil < false < true < number < string
;; < keyword < ref. Tags are spaced so a type can be inserted later
;; without renumbering (which would invalidate every stored key).

; Decimal because the reader has no hex literals yet (FEAT-004); the hex
; value is the meaningful one for a byte tag, so it is named alongside.
(def TAG-NIL 16)        ; 0x10
(def TAG-FALSE 32)      ; 0x20
(def TAG-TRUE 33)       ; 0x21
; ONE tag for all numbers. `(= 0 0.0)` is true in this language, so `0`
; and `0.0` must encode identically or an index holds two keys for one
; value; and `(compare 1 3.14)` is -1, so integers and floats must
; interleave rather than occupying separate ranges.
(def TAG-NUM 48)        ; 0x30
; Integers too large for a float's 53-bit mantissa keep an exact
; encoding, and sort ABOVE every float — numerically correct, since any
; such integer exceeds every float it could be confused with.
; Integers beyond 64 bits. The BEAM has arbitrary-precision integers, so
; a database that refuses them is less capable than the language it is
; written in \u2014 and `(* big big)` reaching an attribute is not exotic.
;
; NEGBIG sorts BELOW every float/int (tag 48), POSBIG above: a bignum is
; by definition outside the range where confusion with a float is
; possible, so the tag boundary is also the numeric boundary.
(def TAG-NEGBIG 44)     ; 0x2C \u2014 below TAG-NUM
(def TAG-BIGINT 50)     ; 0x32 \u2014 64-bit ints past float precision
(def TAG-POSBIG 52)     ; 0x34 \u2014 above TAG-BIGINT
(def MAX-EXACT-INT 9007199254740992)   ; 2^53
(def TAG-STR 64)        ; 0x40
(def TAG-KEYWORD 80)    ; 0x50
(def TAG-REF 96)        ; 0x60

;; ── composite and opaque BEAM terms ──────────────────────────────
;;
;; A datom value may be ANY BEAM term. These tags continue the ranking
;; above, and their order is Erlang's own term order for these types:
;;
;;   number < atom < reference < fun < port < pid < tuple < map < list
;;                                                            < bitstring
;;
;; The database's own tags (nil/false/true/int/float/str/keyword) sit
;; below, because those are the types it understands well enough to give
;; a value-preserving encoding. Everything from here on is encoded
;; faithfully but ordered by BEAM rules rather than by any
;; domain meaning — which is exactly what the BEAM itself does.
(def TAG-PID 100)       ; 0x64
(def TAG-PORT 101)      ; 0x65
(def TAG-ERLREF 102)    ; 0x66 — an erlang reference, not a datom :db.type/ref
(def TAG-FUN 103)       ; 0x67
; Tag order follows `RT.compare`'s RANKS, not Erlang's term order, for
; the same reason the scalar tags do: the codec's job is to PROJECT the
; language's order into bytes, never to invent a second one. Where the
; two disagree — Erlang puts tuple < map < list; compare puts sequential
; < set < map — compare wins, because that is what `sort`, `sorted-set`
; and every query predicate use.
(def TAG-LIST 112)      ; 0x70  a cons list / lazy seq
; A VECTOR gets its own tag because this language keeps `[]` and `()`
; DISTINCT — wave 3's deliberate split, pinned in wave26_laziness_test.
; `(= [1 2] '(1 2))` is false here, so encoding them identically would
; put two `=`-distinct values at one key: a caller could store `[1 2]`
; and fail to find it, or find it under a value they never wrote.
;
; The codec follows `=` rather than arguing with it. Both tags sit
; adjacent so the two still sort together, which is what `compare`'s
; shared rank asks for.
(def TAG-VECTOR 113)    ; 0x71
(def TAG-SET 114)       ; 0x72
(def TAG-MAP 116)       ; 0x74
(def TAG-TUPLE 120)     ; 0x78  past the collections, as compare ranks it
(def TAG-BITSTRING 124) ; 0x7C

; Signed 64-bit values are shifted into unsigned space so byte order
; matches numeric order across the sign boundary.
(def INT-OFFSET 9223372036854775808)

(defn- byte-at
  "The `i`-th byte (0 = most significant) of a 64-bit unsigned value."
  [n i]
  (rem (erlang/bsr n (* 8 (- 7 i))) 256))

(def INT-MAX 9223372036854775807)
(def INT-MIN -9223372036854775808)

(defn encode-int
  "A signed integer as 8 order-preserving bytes.

   The offset is what makes negatives work: -1 encodes below 0, which a
   raw two's-complement byte pattern would not. Fixed width is what makes
   9 sort before 10 — a variable-width encoding would compare `9` against
   `1` and stop there.

   RANGE IS CHECKED, loudly. beam-lisp integers are BEAM bignums, so a
   value outside signed 64-bit silently wrapped in the 8-byte window:
   `2^63` and `-2^63` encoded to the SAME eight zero bytes, which means
   one datom overwriting another in the index. Below the range it was
   worse in a different way — `byte-at` produced negative bytes and
   `list_to_binary` raised a bare `badarg` from deep inside a write.

   A range error at the boundary is recoverable; a silent key collision
   is data loss."
  [n]
  (if (or (> n INT-MAX) (< n INT-MIN))
    (throw (ex-info "integer out of the encodable 64-bit range"
                    {:value n :min INT-MIN :max INT-MAX}))
    (let [shifted (+ n INT-OFFSET)]
      (erlang/list_to_binary
        (to-list (mapv (fn [i] (byte-at shifted i)) [0 1 2 3 4 5 6 7]))))))

(defn decode-int
  "Recover a signed integer from its 8-byte encoding.

   Bytes come from `binary_to_list` rather than `binary_part`: the latter
   returns a one-byte BINARY, which arithmetic then rejects."
  [bin]
  (- (reduce (fn [acc b] (+ (* acc 256) b))
             0
             (erlang/binary_to_list bin))
     INT-OFFSET))

(defn- bits-of-float
  "The raw IEEE-754 double bits of `f` as an unsigned 64-bit integer."
  [f]
  (let [bin (erlang/term_to_binary f)]
    ; `term_to_binary` on a float yields a tagged envelope; the 8 payload
    ; bytes are the IEEE double. Reading them back as an unsigned integer
    ; is the portable way to reach the bits without a bitstring literal,
    ; which the reader does not support yet.
    (reduce (fn [acc b] (+ (* acc 256) b))
            0
            (drop (- (count (erlang/binary_to_list bin)) 8)
                  (erlang/binary_to_list bin)))))

(defn- encode-uint64
  "An unsigned 64-bit integer as 8 big-endian bytes."
  [n]
  (erlang/list_to_binary
    (to-list (mapv (fn [i] (rem (erlang/bsr n (* 8 (- 7 i))) 256)) [0 1 2 3 4 5 6 7]))))

(defn encode-float
  "A float as 8 order-preserving bytes.

   IEEE-754 bit patterns nearly sort correctly already: for POSITIVE
   values the bit pattern order matches numeric order exactly. Two things
   break it — the sign bit makes negatives look large, and negatives run
   BACKWARDS. The standard fix, applied here: set the high bit for
   positives, invert every bit for negatives."
  [f]
  (let [bits (bits-of-float f)]
    (encode-uint64 (if (>= f 0.0)
                     (erlang/bor bits 9223372036854775808)
                     (erlang/bxor bits 18446744073709551615)))))

(defn- tag-byte
  "A one-byte binary holding `t`."
  [t]
  (erlang/list_to_binary (to-list [t])))

(def NUL-BIN (erlang/list_to_binary (to-list [0])))
(def NUL-ESCAPED (erlang/list_to_binary (to-list [0 255])))

(defn escape-nul
  "Replace every 0x00 byte in `bin` with the two bytes 0x00 0xFF.

   Variable-length components are terminated by a single 0x00, so a value
   CONTAINING 0x00 could forge a component boundary: the string
   `a<NUL>Pfoo` encoded byte-for-byte identically to the two components
   `a` followed by `:foo`. Two different keys, same bytes — one datom
   silently overwriting another in the index.

   Escaping to 0x00 0xFF is FoundationDB's tuple-layer solution, and it
   preserves order: the escape byte 0xFF sorts above every byte a real
   continuation can start with, so an escaped NUL still compares as
   greater than a true terminator."
  [bin]
  ; Done with binary BIFs rather than a per-byte map. Byte-level work is
  ; substrate work: the map allocated a fresh binary PER BYTE, and since
  ; every string in every index key passes through here, that cost fell
  ; on every write rather than only on unusually large values. Encoding
  ; 800 datoms took 3.1 seconds, against 5ms for the ETS inserts they
  ; turned into \u2014 the codec was ~99% of write time and quadratic in
  ; transaction size.
  ;
  ; `match` first, because the overwhelmingly common case is a value with
  ; NO nul byte, and answering that in native code costs one scan and
  ; zero allocation.
  (if (= :nomatch (binary/match bin NUL-BIN))
    bin
    (binary/replace bin NUL-BIN NUL-ESCAPED (to-list [:global]))))

(defn- big-magnitude-bytes
  "The base-256 digits of a non-negative integer, most significant first."
  [n]
  (if (= n 0)
    []
    (loop [v n acc []]
      (if (= v 0)
        acc
        (recur (erlang/bsr v 8) (into [(rem v 256)] acc))))))

(defn- encode-bignum
  "An integer of ANY magnitude, order-preserving.

   LENGTH FIRST, then magnitude. For positives that is exactly right:
   more digits means a larger number, and equal digit counts compare
   byte-wise. For negatives BOTH are inverted \u2014 a longer negative is
   SMALLER, and within one length the ordering runs backwards \u2014 so the
   length is complemented and every magnitude byte is flipped.

   Four length bytes, so the encoding covers integers up to 2^(8*2^32),
   which is past anything the BEAM will hold in memory."
  [n]
  (if (>= n 0)
    (let [digits (big-magnitude-bytes n)]
      (erlang/iolist_to_binary
        (to-list [(tag-byte TAG-POSBIG)
                  (encode-count (count digits))
                  (erlang/list_to_binary (to-list digits))])))
    (let [digits (big-magnitude-bytes (- 0 n))
          flipped (mapv (fn [b] (- 255 b)) digits)]
      (erlang/iolist_to_binary
        (to-list [(tag-byte TAG-NEGBIG)
                  ; complemented length: a longer negative is smaller
                  (encode-count (- 4294967295 (count digits)))
                  (erlang/list_to_binary (to-list flipped))])))))

(defn- tagged-opaque
  "A term with no value order: its tag, then its escaped serialization.

   `escape-nul` matters even here. Without it a serialized term
   containing a 0x00 byte could end its own component early and let the
   NEXT component be read as more of this one \u2014 the same forgery the
   string encoding guards against."
  [tag v]
  (erlang/iolist_to_binary
    (to-list [(tag-byte tag) (escape-nul (erlang/term_to_binary v)) (tag-byte 0)])))

(defn- encode-count
  "A collection's size, fixed-width, so it sorts numerically.

   Four bytes, big-endian. Fixed width matters: a variable-length count
   would sort `10` before `2`, which is the same mistake `term_to_binary`
   makes with strings."
  [n]
  (erlang/list_to_binary
    (to-list [(rem (erlang/bsr n 24) 256)
              (rem (erlang/bsr n 16) 256)
              (rem (erlang/bsr n 8) 256)
              (rem n 256)])))

(declare encode-value)

(defn- encode-seq
  "Encode elements in order, each already self-delimiting."
  [xs]
  (erlang/iolist_to_binary (to-list (mapv encode-value xs))))

(defn encode-value
  "Encode any datom value as a tagged, order-preserving binary.

   Strings encode as their own UTF-8 bytes: byte order IS lexicographic
   order for UTF-8, so no transformation is needed. Keywords encode as
   their name — the same treatment `RT.compare` gives them.

   A trailing 0x00 terminates variable-length payloads so that a string
   which is a PREFIX of another sorts before it (\"ab\" < \"abc\"), and so
   that a following component cannot be confused with more of this one."
  [v]
  (cond
    (nil? v) (tag-byte TAG-NIL)
    (= v false) (tag-byte TAG-FALSE)
    (= v true) (tag-byte TAG-TRUE)
    ; ── numbers ───────────────────────────────────────────
    ;
    ; Integers and floats share ONE tag and one representation, because
    ; the language considers them one type for both equality and order:
    ; `(= 0 0.0)` is true and `(compare 1 3.14)` is -1.
    ;
    ; Separate tags broke that in both directions at once. `0` and `0.0`
    ; are EQUAL yet encoded differently, so an index held them as two
    ; keys for one value; and every integer sorted below every float
    ; regardless of magnitude, so `(> ?n 0)` over a mixed column silently
    ; returned the wrong rows. A property test over 1849 pairs found 272
    ; disagreements, all of this shape.
    ;
    ; The float encoding is already order-preserving across the whole
    ; real line, so an integer is encoded as the float it equals. The
    ; cost is 53 bits of mantissa: an integer beyond 2^53 cannot be
    ; represented exactly, so those keep the integer path and sort ABOVE
    ; every float — which is where they belong numerically, since any
    ; such integer exceeds the floats that could be confused with it.
    (int? v)
      (cond
        ; Exactly representable as a float: share the numeric tag so
        ; ints and floats interleave.
        (and (<= v MAX-EXACT-INT) (>= v (- 0 MAX-EXACT-INT)))
          (erlang/iolist_to_binary
            (to-list [(tag-byte TAG-NUM) (encode-float (erlang/float v))]))
        ; Past float precision but inside 64 bits: exact, fixed-width.
        (and (<= v INT-MAX) (>= v INT-MIN))
          (erlang/iolist_to_binary
            (to-list [(tag-byte TAG-BIGINT) (encode-int v)]))
        ; Arbitrary precision. The BEAM has it, so this database has it.
        :else (encode-bignum v))
    ; A float reaches here whenever an attribute is declared WITHOUT a
    ; `:db/valueType` (validation then accepts any value). Left to the
    ; `:else` branch it got `term_to_binary`, which orders by serialized
    ; SHAPE — so 10.0 sorted before 2.0 and a range predicate over such
    ; an attribute returned the wrong rows, silently.
    ;
    ; Encoded as the IEEE-754 bits with the sign convention flipped:
    ; positives get their high bit set, negatives are fully inverted.
    ; That is the standard transform making float bit patterns compare
    ; as numbers do — and it puts them in their own tag, adjacent to
    ; integers rather than interleaved (comparing across int and float
    ; would need a shared representation, which no ordered store gives
    ; for free).
    (float? v) (erlang/iolist_to_binary
                 (to-list [(tag-byte TAG-NUM) (encode-float v)]))
    ; The string's OWN bytes, never `term_to_binary`: that wraps a value
    ; in a tagged envelope carrying a LENGTH PREFIX, so encoded strings
    ; sort by length before content (`z` < `aa`, `abc` > `b`). A first
    ; probe using only same-length pairs missed it entirely.
    ; UTF-8 byte order IS lexicographic order, so raw bytes need no
    ; transformation — only ESCAPING (see `escape-nul`).
    (string? v) (erlang/iolist_to_binary
                  (to-list [(tag-byte TAG-STR) (escape-nul v) (tag-byte 0)]))
    (keyword? v) (erlang/iolist_to_binary
                   (to-list [(tag-byte TAG-KEYWORD)
                             (escape-nul (erlang/atom_to_binary v :utf8))
                             (tag-byte 0)]))
    ; ── composites ───────────────────────────────────────
    ;
    ; A tuple encodes its ARITY FIRST, then its elements. That is not a
    ; stylistic choice — it is Erlang's own rule (`{9}` < `{1,1}`), and
    ; an encoding that compared elements first would disagree with every
    ; `<` in the language it lives in.
    ;
    ; The elements are encoded recursively, so a tuple of tuples sorts
    ; correctly all the way down.
    (erlang/is_tuple v)
      (let [elements (to-list (erlang/tuple_to_list v))]
        (erlang/iolist_to_binary
          (to-list [(tag-byte TAG-TUPLE)
                    (encode-count (count elements))
                    (encode-seq elements)])))

    ; A LIST compares element-wise with no leading arity — `[1]` < `[1 2]`
    ; because the shorter runs out first, not because it is shorter. The
    ; 0x00 terminator produces exactly that: a proper prefix ends before
    ; its extensions continue.
    ;
    ; Beam-lisp vectors are lists to the layers above, so they take this
    ; path and sort with them.
    (vector? v)
      (erlang/iolist_to_binary
        (to-list [(tag-byte TAG-VECTOR) (encode-seq (to-list v)) (tag-byte 0)]))

    (erlang/is_list v)
      (erlang/iolist_to_binary
        (to-list [(tag-byte TAG-LIST) (encode-seq (to-list v)) (tag-byte 0)]))

    ; A SET encodes its members in sorted order, so two equal sets built
    ; by different insertion orders encode identically — the property
    ; that makes a set usable as an indexed value.
    (set? v)
      (let [ms (sort (to-list v))]
        (erlang/iolist_to_binary
          (to-list [(tag-byte TAG-SET) (encode-count (count ms)) (encode-seq ms)])))

    ; A MAP sorts by size, then keys, then values — Erlang's rule. Keys
    ; are sorted before encoding so that two equal maps built in
    ; different insertion orders encode IDENTICALLY, which is what makes
    ; a map usable as an index value at all.
    (map? v)
      (let [ks (sort (to-list (keys v)))]
        (erlang/iolist_to_binary
          (to-list [(tag-byte TAG-MAP)
                    (encode-count (count ks))
                    (encode-seq ks)
                    (encode-seq (mapv (fn [k] (get v k)) ks))])))

    ; ── opaque runtime terms ─────────────────────────────────
    ;
    ; A pid, port, reference or fun has no meaningful VALUE order — even
    ; the BEAM only promises a consistent one. They are encoded
    ; faithfully so they round-trip and compare EQUAL to themselves,
    ; which is what an index needs; their relative order is arbitrary but
    ; stable, and each type gets its own tag so at least the type
    ; boundary is respected.
    ;
    ; Storing a pid is rarely a good idea — it does not survive a node
    ; restart — but refusing it would mean the database is less capable
    ; than the language it is written in, and that is a worse failure.
    (erlang/is_pid v) (tagged-opaque TAG-PID v)
    (erlang/is_port v) (tagged-opaque TAG-PORT v)
    (erlang/is_reference v) (tagged-opaque TAG-ERLREF v)
    (erlang/is_function v) (tagged-opaque TAG-FUN v)

    ; A bitstring that is not a valid binary string (a partial byte).
    (erlang/is_bitstring v) (tagged-opaque TAG-BITSTRING v)

    ; Anything still unrecognised: encoded faithfully, ordered by
    ; serialized shape. Reaching here means a type the codec has not been
    ; taught, so `datom.schema` refuses `:db/index` on such an attribute
    ; rather than letting a range scan be silently wrong.
    :else (erlang/iolist_to_binary
            (to-list [(tag-byte TAG-REF) (escape-nul (erlang/term_to_binary v)) (tag-byte 0)]))))

(defn concat-bins
  "Concatenate encoded components into one key."
  [bins]
  (erlang/iolist_to_binary (to-list bins)))
