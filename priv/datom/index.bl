; datom/index.bl — datoms and the covering indexes over them.
;
; ── A datom ───────────────────────────────────────────────────────────
;
; `[e a v tx op]` — entity, attribute, value, transaction, and whether the
; fact was asserted or retracted. Five values in a vector, no wrapper type:
; a datom IS data, and the language already has the right shape for it.
; That is the whole reason this layer reads as plain code.
;
; Datoms are never updated and never deleted. "Changing" an attribute
; appends a retraction of the old value and an assertion of the new one.
; The database is the accumulated log; the indexes are just orderings of
; it. Time travel then costs nothing extra — it is a bound on `tx`, which
; is why `as-of` in wave 5 is a filter rather than a copy.
;
; ── The four indexes ──────────────────────────────────────────────────
;
; The same datoms, ordered four ways. Which one serves a query is decided
; by WHICH POSITIONS ARE BOUND — that is the planner's whole job (wave 3).
;
;   EAVT  e a v tx op   "everything about entity 42"     → pull, entity
;   AEVT  a e v tx op   "every :person/name in the db"   → attribute scan
;   AVET  a v e tx op   "who is named Ada?"              → lookup, ranges
;   VAET  v a e tx op   "what points AT entity 42?"      → reverse refs
;
; `op` terminates every key, and it is there for IDENTITY rather than for
; ordering. A datom is identified by all five of its fields: within one
; transaction a fact can be retracted and re-asserted, and those are two
; different datoms agreeing on e, a, v and tx. Keys that stopped at `tx`
; were byte-equal for that pair, so the store — keyed — kept whichever
; was written second and silently dropped the other. Anyone implementing
; a replacement backend must preserve this: the key is the datom.
;
; AVET and VAET are not free — each is another write per datom — so
; Datomic only maintains them for attributes that ask (`:db/index`,
; `:db.type/ref`), and `indexes-for` applies that selectivity here.
;
; ── Keys are BINARIES, not tuples ─────────────────────────────────────
;
; See datom/codec.bl. Erlang orders tuples by ARITY before content, so a
; tuple key cannot support prefix range bounds (BUG-005). Binary keys
; compare byte-wise, so a proper prefix sorts immediately before its
; extensions — which is exactly what an index scan needs.
;
; A key is: <index tag> <component> <component> …
;
; Because components are self-delimiting, a PARTIAL key is a valid prefix
; bound: `(key-prefix :eavt 42)` brackets every datom about entity 42,
; regardless of attribute or value.

(ns datom.index
  (:require [datom.codec] [datom.schema] [datom.store]))

;; ── datom construction and access ───────────────────────────────────
;;
;; Positional accessors rather than a record: a datom is a vector, and
;; naming the positions is clearer at every call site than `(get d 2)`.

(defn datom
  "A datom: entity, attribute, value, transaction, assert/retract.

   `op` is true for an assertion, false for a retraction — the same
   convention Datomic's `:db/add` / `:db/retract` lower to."
  [e a v tx op]
  [e a v tx op])

(defn -e "The entity id." [d] (get d 0))
(defn -a "The attribute (a keyword)." [d] (get d 1))
(defn -v "The value." [d] (get d 2))
(defn -tx "The transaction id that recorded this datom." [d] (get d 3))
(defn -op "True when asserted, false when retracted." [d] (get d 4))

(defn assertion?
  "Whether this datom asserts (rather than retracts) its fact."
  [d]
  (= true (-op d)))

;; ── index tags ──────────────────────────────────────────────────────
;;
;; One leading byte partitions the keyspace, so every index lives in one
;; store yet each scans independently. Distinct from the codec's VALUE
;; tags: these name an index, not a type.

(def IDX-EAVT 1)
(def IDX-AEVT 2)
(def IDX-AVET 3)
(def IDX-VAET 4)

(defn- idx-byte [t] (erlang/list_to_binary (to-list [t])))

(defn index-components
  "The datom components, in the order the named index sorts them.

   This function IS the difference between the four indexes; everything
   else about them is shared.

   `op` is the LAST component of every index, and it is there for
   identity rather than for ordering. A datom is identified by all five
   of its fields: within one transaction a fact can be retracted and
   re-asserted, and those are two different datoms that happen to agree
   on `e`, `a`, `v` and `tx`. Omitting `op` made their keys byte-equal,
   so the store — an ordered_set, keyed — kept only whichever was
   written second and silently dropped the other. That is unrecoverable
   loss in a database whose whole premise is that nothing is ever lost.

   Trailing position matters: `op` must not disturb the sort within a
   transaction, only separate two otherwise-identical keys."
  [index d]
  (cond
    (= index :eavt) [(-e d) (-a d) (-v d) (-tx d) (-op d)]
    (= index :aevt) [(-a d) (-e d) (-v d) (-tx d) (-op d)]
    (= index :avet) [(-a d) (-v d) (-e d) (-tx d) (-op d)]
    (= index :vaet) [(-v d) (-a d) (-e d) (-tx d) (-op d)]
    :else (throw (ex-info (str "unknown index: " index) {:index index}))))

(defn- index-tag
  [index]
  (cond
    (= index :eavt) IDX-EAVT
    (= index :aevt) IDX-AEVT
    (= index :avet) IDX-AVET
    (= index :vaet) IDX-VAET
    :else (throw (ex-info (str "unknown index: " index) {:index index}))))

(defn key-for
  "The full store key for `d` in `index`."
  [index d]
  ; `iolist_to_binary` over a plain list, not `cons` onto a vector.
  ;
  ; `cons` of a byte onto a VECTOR produces a lazy seq, so every key
  ; built one — and a key is built 2-4 times per datom, for every datom
  ; in every transaction. Measured at 800 datoms: 522ms in key
  ; construction against 25ms for the value encoding it wraps, and
  ; superlinear at ~3.3x per doubling.
  ;
  ; The BEAM flattens an iolist natively, so the intermediate list never
  ; needs to be a beam-lisp collection at all.
  ;; `iolist_to_binary` over a plain list, not `cons` onto a vector: cons-onto-
  ;; vector makes a lazy seq, and a key is built 2-4x per datom per transaction
  ;; — 522ms for 800 datoms' keys, superlinear. The BEAM flattens an iolist
  ;; natively.
  ;;
  ;; NB: a native per-key path was TRIED and REVERTED — crossing the BEAM↔Rust
  ;; boundary once PER KEY (44k crossings for the compiler's 11k datoms) plus a
  ;; classify tuple per component cost MORE than it saved (15.7s vs 6.4s). The
  ;; native keycodec is byte-identical and stays (keycodec.rs + its tests) for
  ;; the BATCHED fan-out path, which crosses once per TRANSACTION. See FUP.
  (erlang/iolist_to_binary
    (to-list [(idx-byte (index-tag index))
              (erlang/iolist_to_binary
                (to-list (mapv datom.codec/encode-value (index-components index d))))])))

(defn key-prefix
  "A partial key: the index tag followed by `components`.

   This is what makes a range scan an index lookup. `(key-prefix :eavt 42)`
   is a proper byte-prefix of every EAVT key for entity 42, so it is a
   valid LOWER bound; `prefix-end` gives the matching upper bound."
  [index & components]
  (datom.codec/concat-bins
    (cons (idx-byte (index-tag index))
          (mapv datom.codec/encode-value (or components '())))))

(defn prefix-end
  "The exclusive-ish upper bound for a prefix scan.

   Appending a 0xFF byte yields a key that sorts after every key sharing
   the prefix but before the next prefix — because every real component
   that follows begins with a type tag well below 0xFF. This is the
   standard trick for prefix scans over an ordered byte keyspace, and it
   is why the codec reserves the top of the tag space."
  [prefix]
  (datom.codec/concat-bins [prefix (erlang/list_to_binary (to-list [255]))]))

;; ── writing ─────────────────────────────────────────────────────────

(def BASE-INDEXES
  ; Every datom lands in these two: EAVT serves `what about this entity?`
  ; and AEVT serves `every value of this attribute`. No query can work
  ; without them.
  [:eavt :aevt])

(defn indexes-for
  "Which indexes maintain `attr`.

   AVET and VAET are SELECTIVE, exactly as in Datomic: each is another
   write per datom, so they are maintained only where they earn it —
   AVET for attributes that get looked up or ranged BY VALUE (`:db/index`,
   `:db/unique`), VAET for references, which is what makes reverse
   navigation possible.

   Uniqueness in particular is not optional: enforcing `:db.unique/identity`
   means asking whether the value already exists, which IS an AVET lookup.
   Wave 2 learned this the hard way — upsert scanned AVET while nothing
   wrote it, so it silently never matched and every upsert created a
   duplicate entity instead."
  [schema attr]
  (let [avet (if (datom.schema/indexed? schema attr) [:avet] [])
        vaet (if (datom.schema/ref? schema attr) [:vaet] [])]
    (into (into BASE-INDEXES avet) vaet)))

(defn put-ops
  "Store operations that write `d` into every index maintaining its
   attribute.

   Returns ops rather than performing them, so a whole transaction's
   datoms commit as ONE atomic batch. A datom present in EAVT but missing
   from AEVT is a corrupt database, not a slow one."
  [schema d]
  (mapv (fn [index] [:put (key-for index d) d]) (indexes-for schema (-a d))))

(def ^:private keycodec-batch-available?
  (BeamLisp.Native/available? "datom.store-fjall"))

(defn- datom->tuple
  "A datom as the erlang 5-tuple {e a v tx op} the batch key NIF reads."
  [d]
  (erlang/list_to_tuple (to-list [(-e d) (-a d) (-v d) (-tx d) (-op d)])))

(defn- native-put-ops
  "All `[:put key d]` ops for `datoms`, keys built in ONE native crossing — or
   nil to fall back to the per-datom bl path.

   Builds each datom's index-tag list once (per attribute, via the same
   `indexes-for`/`index-tag` the bl path uses), hands the datoms + tag-lists to
   the batch NIF, and zips the returned flat key list back with the datoms in
   the identical datom-major, index order. Returns nil when the NIF is absent OR
   any component is out of a native lane (the NIF returns nil), so correctness
   never depends on it — only speed. Measured ~630x on the key work (44k keys:
   ~46s bl vs ~72ms native), because classification and encoding happen entirely
   in Rust with a single BEAM crossing instead of one per key."
  [schema datoms]
  (if (not keycodec-batch-available?)
    nil
    (let [; per-datom index list, caching indexes-for per attribute
          idx-result (reduce
                       (fn [acc d]
                         (let [a (-a d)
                               cached (get (get acc 1) a)
                               indexes (if (some? cached) cached (indexes-for schema a))
                               tags (mapv index-tag indexes)]
                           [(conj (get acc 0) tags)
                            (if (some? cached) (get acc 1) (assoc (get acc 1) a indexes))]))
                       [[] {}]
                       datoms)
          tag-lists (get idx-result 0)
          tuples (mapv datom->tuple datoms)
          keys (BeamLisp.Native.Datom.StoreFjall/keycodec_batch
                 (to-list tuples) (to-list (mapv to-list tag-lists)))]
      (if (nil? keys)
        nil
        ; zip the flat key list back to [:put key d] ops, datom-major,
        ; index-order — the exact order the NIF produced them.
        (let [kv (into [] keys)]
          (get (reduce
                 (fn [acc i]
                   (let [d (get datoms i)
                         tags (get tag-lists i)
                         base (get acc 1)]
                     [(reduce (fn [ops j] (conj ops [:put (get kv (+ base j)) d]))
                              (get acc 0)
                              (range (count tags)))
                      (+ base (count tags))]))
                 [[] 0]
                 (range (count datoms)))
               0))))))

(defn write-datoms
  "Commit `datoms` to `store`, writing every index they belong in,
   atomically."
  [store schema datoms]
  ; A `reduce` with `conj`, not `into` over a `mapcat`.
  ;
  ; `mapcat` builds a lazy seq per datom and `into` copies the
  ; accumulator each time it consumes one, so the batch cost grew
  ; superlinearly: 67ms, 176ms, 510ms for 200, 400 and 800 datoms, while
  ; the `key-for` work it wraps stayed LINEAR at 15ms, 34ms, 65ms. Nearly
  ; all of it was accumulation rather than encoding.
  ;
  ; `indexes-for` is hoisted per ATTRIBUTE rather than per datom: a
  ; transaction usually touches a handful of attributes across hundreds
  ; of datoms, so the schema lookup was repeated once per datom for no
  ; new information.
  ;; Fast path: build every key for the whole transaction in ONE native
  ;; crossing (native-put-ops), ~630x the per-datom bl codec on the key work.
  ;; It returns nil (fall back) when the NIF is absent or any value is out of a
  ;; native lane, so the bl path below is always the correctness floor.
  (let [ops (or (native-put-ops schema (into [] datoms))
                (get (reduce
                       (fn [acc d]
                         (let [a (-a d)
                               cached (get (get acc 1) a)
                               indexes (if (some? cached) cached (indexes-for schema a))]
                           [(reduce (fn [ops index] (conj ops [:put (key-for index d) d]))
                                    (get acc 0)
                                    indexes)
                            (if (some? cached) (get acc 1) (assoc (get acc 1) a indexes))]))
                       [[] {}]
                       datoms)
                     0))]
    (datom.store/-commit store ops)))

;; ── reading ─────────────────────────────────────────────────────────

(defn scan
  "Every datom in `index` whose leading components equal `components`.

   The bounded scan the whole system rests on:

     (scan store :eavt 42)              every fact about entity 42
     (scan store :eavt 42 :person/name) that entity's name datoms
     (scan store :aevt :person/name)    every name in the database

   Cost is proportional to the RESULT, not the database — the scan starts
   at the prefix rather than filtering from the beginning."
  [store index & components]
  (let [prefix (apply key-prefix index (or components '()))]
    ; `scan-datoms` returns datoms directly, using the substrate's fast
    ; path (redb decodes the whole range in Rust; in-memory stores return
    ; their live datoms). The index layer no longer decodes a value blob
    ; per row — that was the durable-path read tax Fix A removes.
    (datom.store/scan-datoms store prefix (prefix-end prefix))))

(defn scan-range
  "Datoms in `index` between two INCLUSIVE value bounds on the component
   following `components`.

   This is a range predicate — `[?e :person/age ?a]` with `20 <= ?a <= 30`
   becomes `(scan-range store :avet [:person/age] 20 30)`. It needs an
   index whose next component is the value being bounded, which is what
   AVET exists for.

   The query engine lowers a comparison predicate into these bounds when
   the attribute is AVET-indexed: `[?e :person/age ?a] [(> ?a 95)]` reads
   only the ages above 95 rather than the whole column. Measured over 100
   entities, that is 5 datoms instead of 100.

   The predicate STILL RUNS afterwards. The bound narrows what is read;
   it does not replace the test. So an off-by-one here can only make a
   query slower, never wrong \u2014 which is the property that makes the
   optimisation safe to have at all.

   `nil` on either bound means unbounded on that side."
  [store index components low high]
  (let [base (apply key-prefix index components)
        lo (if (nil? low)
             base
             (datom.codec/concat-bins [base (datom.codec/encode-value low)]))
        hi (if (nil? high)
             (prefix-end base)
             (prefix-end (datom.codec/concat-bins
                           [base (datom.codec/encode-value high)])))]
    (datom.store/scan-datoms store lo hi)))
