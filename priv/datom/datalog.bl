; datom/query/native-datalog.bl — the measured spike (native fixpoint).
;
; ── What this is, and what the critique says about it ─────────────────
;
; This is a SPIKE, kept deliberately at arm's length from the query engine.
; It compiles a small Datalog program (rules over integer-interned predicates
; and constants) to a flat wire format and runs the fixpoint in the Rust
; crate `datom_datalog`, purely to answer ONE question with a number:
;
;   Does running semi-naive evaluation natively beat the beam-lisp engine by
;   enough to justify a second representation?
;
; The prior architecture decision (PLAN-042, and the auth NIF decision) is
; that a full rules-IR in Rust is the "second engine that must agree"
; anti-pattern: it duplicates unify/fixpoint semantics, is blind to the rest
; of the language (analytic clauses, bl predicates, as-of), and needs a
; lowering pass maintained forever. So this bridge is NOT wired into `q`. It
; exists to MEASURE, so the keep-or-discard call is made on evidence.
;
; The asymptotic axes (magic sets, PreM) do NOT live here — they are rule
; rewrites over rule DATA and belong in beam-lisp (priv/datom/query/magic.bl,
; prem.bl), composing with the real engine. Only the constant-factor question
; (native vs interpreted fixpoint) is a native matter, and only this file.

(ns datom.datalog)

(defnative "datom_datalog"
  (dl-eval 5)            ; (rules idb edb query strategy) -> {arity flat}
  (dl-eval-magic 5)      ; (rules idb edb query seed) -> {arity flat}
  (dl-eval-incremental 5)) ; (rules idb edb-before new-edb query) -> {arity flat}

;; ── the wire encoding ───────────────────────────────────────────────
;;
;; A term is {0 slot} (variable) or {1 const} (constant). An atom is
;; {pred [terms...]}. A rule is {head [body-atoms...]}. Predicates and
;; constants are integers the CALLER interns; this file never sees a symbol.

(defn var-term [slot] (erlang/list_to_tuple (to-list [0 slot])))
(defn const-term [c] (erlang/list_to_tuple (to-list [1 c])))

(defn atom
  "An atom {pred [terms]}."
  [pred terms]
  (erlang/list_to_tuple (to-list [pred (to-list terms)])))

(defn rule
  "A rule {head [body]}."
  [head body]
  (erlang/list_to_tuple (to-list [head (to-list body)])))

(defn edb-relation
  "An EDB entry {pred arity flat-tuples}. `tuples` is a seq of int vectors;
   they are flattened row-major."
  [pred arity tuples]
  (let [flat (reduce (fn [acc t] (into acc (to-list t))) [] (to-list tuples))]
    (erlang/list_to_tuple (to-list [pred arity (to-list flat)]))))

;; ── strategies ──────────────────────────────────────────────────────
;; 0 = naive, 1 = semi-naive nested-loop, 2 = semi-naive indexed

(defn eval
  "Run `rules` (a seq of rule tuples) with `idb` predicate ids over `edb`
   (a seq of edb-relation tuples), returning the `query-pred` relation as
   `[arity flat-tuples]`. `strategy` selects the evaluator."
  [rules idb edb query-pred strategy]
  (let [result (dl-eval (to-list rules) (to-list idb) (to-list edb) query-pred strategy)]
    [(erlang/element 1 result) (into [] (erlang/element 2 result))]))

(defn eval-magic
  "Demand-driven evaluation for a query whose first argument is `seed`."
  [rules idb edb query-pred seed]
  (let [result (dl-eval-magic (to-list rules) (to-list idb) (to-list edb) query-pred seed)]
    [(erlang/element 1 result) (into [] (erlang/element 2 result))]))

(defn eval-incremental
  "Maintain the fixpoint under `new-edb` new base facts."
  [rules idb edb-before new-edb query-pred]
  (let [result (dl-eval-incremental (to-list rules) (to-list idb)
                                    (to-list edb-before) (to-list new-edb) query-pred)]
    [(erlang/element 1 result) (into [] (erlang/element 2 result))]))

(defn tuples
  "Decode an `[arity flat]` result into a vector of int tuples."
  [result]
  (let [arity (get result 0)
        flat (into [] (get result 1))
        n (if (= arity 0) 0 (erlang/div (count flat) arity))]
    (mapv (fn [i]
            (mapv (fn [j] (get flat (+ (* i arity) j))) (range arity)))
          (range n))))
