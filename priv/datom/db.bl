; datom/db.bl — the database as a VALUE.
;
; ── The idea Datomic is built on ──────────────────────────────────────
;
; A database is not a place you query. It is a VALUE you hold: an
; immutable snapshot, cheap to pass around, that never changes underneath
; you. Two queries against the same db value see exactly the same facts,
; forever, regardless of what anyone else transacts meanwhile.
;
; That is the difference from every place-oriented database, and almost
; everything pleasant about Datomic follows from it:
;
;   - a query needs no transaction or isolation level; the snapshot IS
;     the isolation
;   - `as-of` is not a special mode, just a different value
;   - a function taking a db is referentially transparent, so it can be
;     tested with a literal db rather than a live connection
;
; ── How a snapshot can be cheap ───────────────────────────────────────
;
; The db does NOT copy any data. It holds the store plus a BASIS: the
; transaction id it was taken at. Since datoms are never mutated or
; deleted — a "change" appends a retraction and an assertion at a NEW tx
; — every datom carries the tx that recorded it, and a snapshot is simply
; "ignore everything after basis-t".
;
; So `(db conn)` is O(1), and the db value from an hour ago still answers
; queries about the world as it was an hour ago. Wave 5's `as-of` is the
; same mechanism with a different number.
;
; ── Current vs historical ─────────────────────────────────────────────
;
; `:current` filtering — the default — answers "what is true NOW (at
; basis-t)": a datom counts only if it was asserted at or before the
; basis and not retracted since.
;
; `:history` keeps every datom, assertions and retractions alike. That is
; what makes "when did this value change, and to what?" answerable, and
; it is the mode wave 5's `history` selects.

(ns datom.db
  (:require [datom.index] [datom.schema] [datom.store]))

(defrecord Db [store schema basis-t filter-mode since-t])

(defn db-value
  "A database value over `store` as of `basis-t`."
  [store schema basis-t]
  (->Db store schema basis-t :current nil))

(defn basis-t
  "The transaction id this value was taken at. Every datom recorded after
   it is invisible here."
  [db]
  (:basis-t db))

(defn schema-of [db] (:schema db))
(defn store-of [db] (:store db))

;; ── visibility ──────────────────────────────────────────────────────

(defn- within-basis?
  "Whether a datom was recorded at or before this value's basis."
  [db d]
  (<= (datom.index/-tx d) (basis-t db)))

(defn- after-since?
  "Whether a datom was recorded after this value's `since` bound.

   Only `:since` values set one. It selects facts added in a WINDOW,
   which is how you answer 'what changed lately?' without diffing two
   snapshots by hand."
  [db d]
  (let [s (:since-t db)]
    (or (nil? s) (> (datom.index/-tx d) s))))

(defn- visible?
  [db d]
  (and (within-basis? db d) (after-since? db d)))

(defn- retraction-key
  "The identity of the FACT a datom is about: `[e a v]`.

   Assertions and retractions of the same fact share this key, which is
   what lets a single pass pair them up."
  [d]
  [(datom.index/-e d) (datom.index/-a d) (datom.index/-v d)])

(defn- retraction-index
  "A map from fact key to the LATEST tx at which that fact was retracted,
   built from `candidates` in one pass.

   Replaces a per-datom store scan. `retracted-later?` used to ask the
   store `is this fact retracted?` for EVERY datom it filtered, so
   reading N datoms cost N scans — quadratic, and measurably so: 300
   entities took 57ms to filter against 5ms to scan raw, and a reviewer
   measured 45 SECONDS at 1000 values.

   Wave 3's join engine calls `datoms` in a loop, so a quadratic read
   path would have made every join quadratic too."
  [db candidates]
  (reduce (fn [acc d]
            (if (and (not (datom.index/assertion? d)) (within-basis? db d))
              (let [k (retraction-key d)
                    tx (datom.index/-tx d)
                    known (get acc k)]
                (if (and (some? known) (>= known tx)) acc (assoc acc k tx)))
              acc))
          {}
          candidates))

(defn- current-in?
  "Whether `d` is a fact that HOLDS at the basis, given a prebuilt
   retraction index.

   A retraction at the SAME tx as the assertion WINS — hence `<` rather
   than `<=`. Within one transaction a value can be asserted and then
   superseded (`[[:db/add e :age 37] [:db/add e :age 38]]` retracts 37 at
   the very tx that asserted it), and the retraction is the later word on
   it. Reading `<=` left both 37 and 38 current, giving a
   cardinality-one attribute two values.

   This was invisible until datom keys included `op`: before that, the
   assertion and the retraction of 37 collided at one key and the store
   silently kept one. Fixing the key exposed a reader bug the corrupted
   writer had been masking — two defects that cancelled to a passing
   test."
  [db retractions d]
  (and (visible? db d)
       (datom.index/assertion? d)
       (let [r (get retractions (retraction-key d))]
         (or (nil? r) (< r (datom.index/-tx d))))))

(defn filter-datoms
  "Apply this value's filter to a scan result, in ONE pass.

   `:history` keeps every visible datom — including retractions, which
   are the record of what STOPPED being true and when. `:current` keeps
   only what holds at the basis."
  [db candidates]
  (if (= (:filter-mode db) :history)
    (filterv (fn [d] (visible? db d)) candidates)
    (let [retractions (retraction-index db candidates)]
      (filterv (fn [d] (current-in? db retractions d)) candidates))))

;; ── reading ─────────────────────────────────────────────────────────

(defn datoms
  "Datoms from `index` matching `components`, filtered by this value.

   The single read path: every higher-level read (`entity`, `pull`, and
   wave 3's query engine) goes through here, so the time-travel filter
   cannot be bypassed by accident."
  [db index & components]
  (filter-datoms db (apply datom.index/scan (store-of db) index (or components '()))))

(defn entity-datoms
  "Every current datom about `e`."
  [db e]
  (datoms db :eavt e))

(defn attr-datoms
  "Every current datom for attribute `a` across all entities."
  [db a]
  (datoms db :aevt a))

(defn entity
  "Entity `e` as a map of attribute to value.

   A cardinality-many attribute collects into a VECTOR; a cardinality-one
   attribute holds its single value. `:db/id` is included so the result
   round-trips as transaction data.

   REFUSES on a history view. A history db holds every value an attribute
   ever had, so folding it into a map would report an entity with three
   simultaneous ages — a value that never existed at any point in time.
   That is a category error rather than a rare edge, so it fails loudly:
   ask `datom.time/changes` for the history of a field."
  [db e]
  (if (= (:filter-mode db) :history)
    (throw (ex-info "entity is not meaningful on a history view (use datom.time/changes)"
                    {:entity e}))
  (let [ds (entity-datoms db e)]
    (if (empty? ds)
      nil
      (reduce (fn [acc d]
                (let [a (datom.index/-a d)
                      v (datom.index/-v d)]
                  (if (datom.schema/many? (schema-of db) a)
                    (assoc acc a (conj (or (get acc a) []) v))
                    (assoc acc a v))))
              {:db/id e}
              ds)))))

(defn attr-value
  "The value of `[e a]`, or nil.

   For a cardinality-many attribute this is the FIRST value, which is
   rarely what a caller wants — use `entity` or `datoms` there."
  [db e a]
  (let [ds (datoms db :eavt e a)]
    (if (empty? ds) nil (datom.index/-v (first ds)))))
