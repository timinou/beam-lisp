; model.bl — where the static code model's weights live, and WHICH copy to read.
;
; ── Three roots, and the reason each exists ────────────────────────────────
;
; A vector space is identified by its weights, so "which copy" is a real
; question with a real answer: `dir` returns the first root below that holds a
; COMPLETE fetched copy.
;
;   1. `$BEAM_LISP_MODEL_DIR` — an explicit pin. SET MEANS ANSWER: nothing falls
;      through from it, so a test (or a CI job) that points it at an empty
;      directory is testing absence, not whatever else the machine holds.
;   2. `priv/embed/<name>` — the BUNDLED copy. `bl build` fetches the weights in
;      before it packs (`--no-embed` opts out), so a shipped `bl` answers
;      semantic queries with no network, no Mix and no cache on the box. The
;      drop is the default distribution; the weights ship inside it.
;   3. `$XDG_CACHE_HOME/beam_lisp/models/<name>` — the AMBIENT cache
;      `bl install embed` fills by default. Shared across checkouts, worktrees
;      and branches, which is the arithmetic that keeps 33 MB out of every tree:
;      the model is the same bytes for every checkout and is cached rather than
;      built.
;
; So a source tree works from tier 3 and a drop works from tier 2, and both name
; the same pinned bytes: the sha256 contract lives in the fetch
; (`embed-asset.bl`), and the DIGEST file each tier carries is what makes a copy
; identifiable as those bytes.
;
; ── One rule, two callers ──────────────────────────────────────────────────
;
; The reader (`code.embed`) and the fetch (`embed-asset`) both need this answer,
; and they must agree — weights fetched into one root and read from another is a
; capability that silently reads as absent. So the READ rule lives here once and
; both name it; the fetch owns the WRITE side (`embed-asset/dest-for`).
;
; This is the port of `BeamLisp.Model` to a beam-lisp namespace: nothing pins
; its ABI, and a rule about beam-lisp's own cache belongs beside the code that
; reads it, not in a host module the reader reaches across the boundary for.

(ns model)

(def ^:private env-dir "BEAM_LISP_MODEL_DIR")

;; ── the roots ──────────────────────────────────────────────────────────────

(defn- cache-root
  "The host cache root: `$XDG_CACHE_HOME/beam_lisp` (else `~/.cache/beam_lisp`).
   OTP's own answer — the same one `vm.paths/cache-root` asks for — read PER
   CALL, because `:filename.basedir/2` reads the variable then and a test (or a
   fetch pointed elsewhere) must be obeyed, not overruled by a load-time value."
  []
  (erlang/list_to_binary
    (erlang/apply :filename :basedir
      (list :user_cache (erlang/binary_to_list "beam_lisp")))))

(defn root
  "The AMBIENT root: `$BEAM_LISP_MODEL_DIR`, else
   `$XDG_CACHE_HOME/beam_lisp/models` — the `models` subdirectory of the host
   cache root, the one answer to \"where does this machine keep beam-lisp's
   derived state\".

   This is where a fetch writes by DEFAULT. Readers ask `dir`, which prefers a
   bundled copy when one is present.

   Resolved PER CALL, never memoised: a test (or a fetch with `--dir`) sets the
   variable and expects the next call to see it. A load-time `def` here would
   fix the directory for every later caller in the VM."
  []
  (let [pin (System/get_env env-dir)]
    (if (some? pin)
      (Path/expand pin)
      (Path/join (cache-root) "models"))))

(defn bundled-root
  "The BUNDLED root, `<priv>/embed/`: what `bl build` ships, and what a drop
   reads.

   Resolved through `BeamLisp.Tiers.priv_root` and not `:code.priv_dir`, for the
   reason `BeamLisp.Z3.Port` gives: inside an escript `priv_dir` answers with a
   pseudo-path inside the archive, which is not a directory on disk."
  []
  (Path/join (BeamLisp.Tiers/priv_root) "embed"))

(defn ambient-dir
  "The ambient directory for `name` — where a plain fetch writes."
  [name]
  (Path/join (root) name))

(defn bundled-dir
  "The bundled directory for `name` — where a `bl build` (or `--bundle` fetch)
   writes."
  [name]
  (Path/join (bundled-root) name))

;; ── the read rule ──────────────────────────────────────────────────────────

(defn files
  "The files the reader opens, in the order the fetch writes them: what makes a
   directory a model at all.

   Here and not in the fetch or in `code.embed` because it is the SHAPE of a
   model, which is this namespace's business: the fetch owns the pin (these
   names → sha256), the reader owns what to do with the bytes, and \"is this copy
   complete?\" must be the same question in all three. It was three lists once,
   and a `DIGEST` with no weights beside it read as a complete model."
  []
  ["config.json" "tokenizer.json" "model.safetensors"])

(defn fetched?
  "Whether `dir` holds a COMPLETE fetched copy: the `DIGEST` file the fetch
   writes LAST, after every weight has verified against its pinned sha256, AND
   the files that digest stands for.

   The digest is the identity — it is what every stored embedding records, so a
   copy without one has no provenance — and the files are the substance: a
   `DIGEST` alone is not a model, it is a claim about weights that are not there.
   Both halves are required, because a directory that passes this and cannot be
   read is worse than an absent one: the caller stops looking, and the failure
   surfaces later as a parse error instead of as \"not on disk\"."
  [dir]
  (and (File/regular? (Path/join dir "DIGEST"))
       (every? (fn [f] (File/regular? (Path/join dir f))) (files))))

(defn dir
  "The directory to READ `name` from: the first tier that holds a complete copy
   (see the header for the order and why each tier earns its place).

   Falls back to the ambient directory when NOTHING is fetched, so a caller's
   error message can name where a fetch was expected to land."
  [name]
  (let [pin (System/get_env env-dir)]
    (if (some? pin)
      (Path/join (Path/expand pin) name)
      (or (first (filter (fn [d] (fetched? d)) [(bundled-dir name) (ambient-dir name)]))
          (ambient-dir name)))))

(defn tier
  "Which tier answers `dir` for `name`: `:env`, `:bundled`, `:ambient`, or
   `:absent` when no tier holds a complete copy.

   A diagnostic, so a person or a test names the copy in use instead of inferring
   it from whichever directory happened to come back."
  [name]
  (let [pin (System/get_env env-dir)]
    (if (some? pin)
      (if (fetched? (Path/join (Path/expand pin) name)) :env :absent)
      (cond
        (fetched? (bundled-dir name)) :bundled
        (fetched? (ambient-dir name)) :ambient
        :else :absent))))

(defn searched-dirs
  "The directories `dir` consults, in order — for a message that must not lie
   about where the weights were looked for."
  [name]
  (vec (distinct [(bundled-dir name) (ambient-dir name)])))

(defn dir-env
  "The env var that overrides `root` — SET MEANS ANSWER."
  []
  env-dir)
