; priv/lib/scenario.bl — multi-actor scenarios as decidable histories.
;
; ══ WHAT THIS IS ════════════════════════════════════════════════════════════
;
; The owner's requirement: scenarios must be MULTI-USER, because the
; whole point of a plant is that several actors (commercial, prepress, chef,
; operator) act CONCURRENTLY on one shared system and CONVERGE — the operator
; logs an incident and the commercial's promised date moves, with no one
; coordinating (the datom log is the coordinator; 05-two-tabs.bl thesis).
;
; A scenario is a VALUE — and it is decoupled from HOW it runs:
;
;   SPECIFICATION  the scenario value: actors + events (timeless)
;   CAPABILITY     a WORLD: a runner that can be the timeline
;                  (:model = datom trace | :local = chromium+CDP | :kernel =
;                   kernel.sh sessions — research/40-scenario/00-scenario-kernel.md)
;   PROCESS        the RUN: trace + witnesses + verdicts (how it unfolded)
;   PLAN/FLOW      the FILM/DEMO: a presentation of a run
;
; ══ PRIMITIVES — four events, one composition ═══════════════════════════════
;
;   (beat ms)                    time passes
;   (does actor term)            actor does term to the world
;   (sees actor claim msg)       the actor's view satisfies claim — NOW
;   (witness actor lens name)    capture an observation, bind it for later claims
;
; claims are (fn [db ctx] bool); ctx carries {:witnesses …} so claims can be
; COMPARATIVE (moved by exactly delta; unchanged) — not just point-in-time.
; Composition v1 is sequence: a faithful replay of a proven interleaving is
; the honest default. `par` (admissible interleavings) is a FUP.
;
; ══ PATTERNS — named properties that expand to primitives ═══════════════════
;
;   (converges writer term observer claim because)   A acts; B SEES it (two-tabs)
;   (isolated writer term bystander lens because)    A acts; bystander UNCHANGED
;   (shifts writer term observer lens measure Δ b/c) A acts; value moves EXACTLY Δ
;   (stays actor lens msg)        after the LAST act, the value never moves again
;                                 (honest resolution: unblocked, time still lost)
;   (lively actors…)              no liveness drop across the whole stretch
;
; A pattern carries its `because` — the narration IS the property, so the
; film's captions generate themselves and `say` never pollutes this language.
;
; ══ VERDICTS — the run is a proof certificate ═══════════════════════════════
;
;   :proven    the model world decided it          :refuted  + the witness
;   :witnessed observed on a live world            :unknown  the world cannot
;                                                            decide it (first-class)
;
; :model → :kernel is the honesty chain: the model PROVES, the browser WITNESSES,
; the film SHOWS the witness.

(ns scenario
  (:require [datom]))

;; ── primitives ──────────────────────────────────────────────────────

(defn does [actor term] [:act actor term])

(defn sees
  "The actor's view of the world satisfies `claim` at this point in the history.
   claim is (fn [db ctx] bool); ctx = {:witnesses {name value}}."
  [actor claim msg] [:expect actor claim msg])

(defn witness
  "Observe now, bind for later: (lens db) is bound to `name` in every later
   claim's ctx — the primitive that makes claims comparative."
  [actor lens name] [:witness actor lens name])

(defn beat [ms] [:beat ms])

;; FEAT-027 — the offline/replay story as scenario acts. A world that models
;; the kiosk outbox interprets these; a plain world treats offline/online as
;; no-ops and a replay-fixture as a fold of its recorded acts.
(defn offline
  "From here, the actor's acts route through the LOCAL outbox, not the shared
   world (a dropped-wifi span). A modelling world queues them; a plain world
   applies them as usual."
  [actor] [:offline actor])

(defn online
  "Reconnect: the actor's queued acts REPLAY against the shared world, in
   order, exactly once (the outbox dedups by idempotency key)."
  [actor] [:online actor])

(defn replay-fixture
  "Fold a recorded list of acts (each [actor term]) into the scenario — a
   captured session replayed as a fixture (the 20-orders week, an offline
   burst)."
  [acts] (into [:replay-fixture] acts))

(defn refused
  "The actor TRIES `term` and the world must REFUSE it: the perform outcome
   carries :denied (a policy said no) — or, when `noop-ok?` is true, either
   :denied or a declined write ({:ok false}). A refusal that does not happen
   is a refuted claim, exactly like a false `sees`. The step is an :act AND an
   :expect in one — it counts as an act for `stays`."
  ([actor term msg] (refused actor term msg false))
  ([actor term msg noop-ok?] [:refused actor term msg noop-ok?]))

;; v1 surface: an action TERM builder and an anonymous point assertion.
;; Kept because they read well; both normalize into the primitive events.

(defn act [kind & args] (into [kind] args))

(defn expect [pred msg] [:expect pred msg])

;; ── patterns ────────────────────────────────────────────────────────
;;
;; Each expands to primitive events (or a run-level check for stays/lively)
;; and carries its `because` — the caption the film will burn in.

(defmacro converges
  "THE property: `writer` acts, `observer` SEES it — through the shared log,
   with no direct message. The two-tabs convergence."
  [writer term observer claim because]
  `[(does ~writer ~term)
    (sees ~observer ~claim ~because)])

(defmacro isolated
  "`writer` acts; the bystander's observation is UNCHANGED. One incident does
   not contaminate the rest of the plant."
  [writer term bystander lens because]
  `[(witness ~bystander ~lens :before)
    (does ~writer ~term)
    (sees ~bystander (fn [db ctx] (= (get-in ctx [:witnesses :before]) (~lens db)))
          ~because)])

(defmacro shifts
  "`writer` acts; the observer's value moves by EXACTLY `delta`, as measured by
   `measure` (fn [after before] diff). Computed, not guessed."
  [writer term observer lens measure delta because]
  `[(witness ~observer ~lens :before)
    (does ~writer ~term)
    (sees ~observer
          (fn [db ctx] (= ~delta (~measure (~lens db) (get-in ctx [:witnesses :before]))))
          ~because)])

(defn stays
  "Run-level: from the first basis AFTER the scenario's last act, the lens value
   is identical at every subsequent basis — resolving un-blocks, but the lost
   time stays lost. Checked at close over the whole stretch."
  [actor lens msg]
  {:kind :stays :actor actor :lens lens :msg msg})

(defn lively
  "Run-level: no actor's liveness signal drops anywhere in the stretch.
   The model world cannot decide this (:unknown); live worlds witness it."
  [& actors]
  {:kind :lively :actors (vec actors)})

;; ── the scenario value ──────────────────────────────────────────────
;;
;; Accepts BOTH surfaces: v1 pairs [actor action] and anonymous [:expect pred
;; msg], and the v2 primitive events — and splices pattern expansions (a
;; vector of events) one level. Normalized form is uniform: [:tag …].

(def ^:private event-tags #{:act :expect :witness :beat :refused})

(defn- norm-claim [pred] (fn [db ctx] (pred db)))

(defn- ev-coll? [s] (or (list? s) (vector? s)))

(defn- norm-step [s]
  (let [v (if (list? s) (into [] s) s)]   ; macro-expanded events arrive as lists
    (cond
      (and (vector? v) (contains? event-tags (first v)))
      (if (and (= :expect (first v)) (= 3 (count v)))   ; v1 anonymous expect
        [:expect nil (norm-claim (nth v 1)) (nth v 2)]
        v)
      (and (vector? v) (= 2 (count v)))                 ; v1 pair [actor action]
      [:act (nth v 0) (nth v 1)]
      :else
      (throw (str "scenario: not an event or [actor action]: " (pr-str s))))))

(defn- splice-patterns [steps]
  (mapcat (fn [s] (if (and (ev-coll? s) (ev-coll? (first s))) s [s])) steps))

(defn scenario
  "A scenario VALUE: {:name :actors :steps :patterns}. `patterns` (optional)
   holds the run-level checks (stays / lively) evaluated at close."
  [name actors steps & [patterns]]
  {:name name
   :actors actors
   :steps (vec (map norm-step (splice-patterns steps)))
   :patterns (vec (or patterns []))})

;; ── worlds — the interpreter seam ───────────────────────────────────
;;
;; A world is a map: {:open :step! :claim! :observe :liveness :close! :views-fn}.
;; :model runs the history against a datom conn — decidable, milliseconds,
;; no browser. Claims PROVE here; on live worlds they are WITNESSED.

(defn model-world
  "conn      the shared plant store (all actors act on THIS)
   perform  (conn actor term) → outcome — how a term becomes datoms/queries
   project  (db actor) → the actor's view (pure projection), for :views"
  [conn perform project]
  {:kind :model
   :open (fn [_scen] {:conn conn})
   :step! (fn [h ev] (perform (:conn h) (nth ev 1) (nth ev 2)))
   :claim! (fn [h _actor claim ctx] (claim (datom/db (:conn h)) ctx))
   :observe (fn [h _actor lens] (lens (datom/db (:conn h))))
   :liveness (fn [_h] nil)                 ; no live plane to drop — :unknown
   :basis (fn [h] (datom/db (:conn h)))    ; the world as it exactly was — per step
   :close! (fn [h] (datom/db (:conn h)))
   :views-fn (fn [db actor] (project db actor))})

;; ── the runner ──────────────────────────────────────────────────────

(defn- last-act-n [steps]
  (let [acts (filter (fn [i] (contains? #{:act :refused} (first (nth steps i)))) (range (count steps)))]
    (if (empty? acts) -1 (apply max acts))))

(defn- stays-held?
  "stays pattern: every snapshot after the last act equals the first one."
  [after-n snapshots]
  (let [after (map :value (filter (fn [e] (> (:n e) after-n)) snapshots))]
    (or (empty? after)
        (every? (fn [v] (= v (first after))) after))))

(defn run-world
  "Replay a scenario VALUE in `world`. Each step records the basis AFTER it, so
   the history is inspectable and convergence between actors is visible in the
   trace; every claim resolves to a VERDICT (:proven/:witnessed/:refuted/:unknown).
   Returns {:ok :trace :views :witnesses :verdicts :stretches}."
  [scen world]
  (let [handle ((:open world) scen)
        steps (:steps scen)
        after-last-act (last-act-n steps)
        stays-ps (filter (fn [p] (= :stays (:kind p))) (:patterns scen))
        result
        (reduce
          (fn [acc i]
            (let [n (inc i)
                  ev (nth steps i)
                  tag (first ev)
                  ctx {:witnesses (:witnesses acc)}
                  [outcome verdict witnesses evidence]
                  (cond
                    (= :witness tag)
                    (let [v ((:observe world) handle (nth ev 1) (nth ev 2))]
                      [:ok :witnessed (assoc (:witnesses acc) (nth ev 3) v) nil])
                    (= :expect tag)
                    (let [held? ((:claim! world) handle (nth ev 1) (nth ev 2) ctx)]
                      [(if held? :ok :fail) (if held? :proven :refuted) (:witnesses acc)
                       (when (and (not held?) (:basis world))
                         ;; refuted-with-witness: the world as it exactly was,
                         ;; at the step where the claim was false
                         ((:basis world) handle))])
                    (= :refused tag)
                    ;; act, then judge the OUTCOME: refused ⇒ proven
                    (let [out ((:step! world) handle [:act (nth ev 1) (nth ev 2)])
                          noop-ok? (nth ev 4 false)
                          refused? (or (and (map? out) (contains? out :denied))
                                       (and noop-ok? (map? out) (= false (:ok out))))]
                      [(if refused? :ok :fail) (if refused? :proven :refuted) (:witnesses acc)
                       (when (and (not refused?) (:basis world)) ((:basis world) handle))])
                    :else                                       ; :act / :beat
                    [((:step! world) handle ev) :n/a (:witnesses acc) nil])
                  entry {:step n
                         :actor (when (not= :beat tag) (nth ev 1 nil))
                         :action ev
                         :outcome outcome
                         :verdict verdict
                         :because (when (contains? #{:expect :refused} tag) (nth ev 3 nil))
                         :evidence evidence}]
              {:n n
               :ok (and (:ok acc) (not= :fail outcome))
               :trace (conj (:trace acc) entry)
               :witnesses witnesses
               :bases (conj (:bases acc) (when (:basis world) ((:basis world) handle)))
               :stays-snapshots
               (into (:stays-snapshots acc)
                     (map (fn [p] {:pattern p :n n
                                   :value ((:observe world) handle (:actor p) (:lens p))}))
                     stays-ps)}))
          {:n 0 :ok true :trace [] :witnesses {} :bases [] :stays-snapshots []}
          (range (count steps)))
        final-db ((:close! world) handle)
        verdicts (mapv (fn [t] {:msg (:because t) :verdict (:verdict t)
                                :step (:step t) :actor (:actor t)
                                :evidence (:evidence t)})
                       (filter (fn [t] (contains? #{:expect :refused} (first (:action t)))) (:trace result)))
        stretches
        (vec (concat
               (map (fn [p]
                      {:kind :stays :msg (:msg p)
                       :held (stays-held? after-last-act
                                          (filter (fn [s] (= p (:pattern s)))
                                                  (:stays-snapshots result)))
                       :verdict (if (stays-held? after-last-act
                                                 (filter (fn [s] (= p (:pattern s)))
                                                         (:stays-snapshots result)))
                                  :proven :refuted)})
                    stays-ps)
               (map (fn [p]
                      (let [drops ((:liveness world) handle)]
                        {:kind :lively :actors (:actors p)
                         :verdict (cond (nil? drops) :unknown
                                        (empty? drops) :witnessed
                                        :else :refuted)
                         :drops (or drops [])}))
                    (filter (fn [p] (= :lively (:kind p))) (:patterns scen)))))
        views (when (:views-fn world)
                (into {} (map (fn [entry]
                                [(first entry) ((:views-fn world) final-db (first entry))])
                              (seq (:actors scen)))))]
    {:ok (and (:ok result)
              (empty? (filter (fn [v] (= :refuted (:verdict v))) verdicts))
              (empty? (filter (fn [s] (= :refuted (:verdict s))) stretches)))
     :trace (:trace result)
     :views views
     :witnesses (:witnesses result)
     :verdicts verdicts
     :stretches stretches
     :bases (:bases result)
     :projector (:views-fn world)
     :world (:kind world)
     :name (:name scen)
     :final-db final-db}))

;; ── the v1 driver — model world, same signature and result shape ────

(defn run
  "v1 arity: (run scen conn perform project) = run-world in the model world."
  [scen conn perform project]
  (run-world (scenario (:name scen) (:actors scen) (:steps scen))
             (model-world conn perform project)))

;; ── reading a run ───────────────────────────────────────────────────

(defn converged?
  "Did `observer`'s projection reflect the fact? The two-tabs property: one
   actor writes, another SEES it, through the log — with no direct message."
  [result observer pred]
  (pred (get (:views result) observer)))

(defn all-expects-passed?
  "Every :expect step in the trace returned :ok — the embedded assertions all
   held as the history unfolded."
  [result]
  (every? (fn [t] (or (not= :expect (first (:action t))) (= :ok (:outcome t))))
          (:trace result)))

(defn bisect
  "Rewind the run to step `n`: the world as it EXACTLY was after that step
   (a real basis value, not a copy), and every actor's projected view of it.
   The witness a refuted claim deserves — and, at W3, the exact second of
   video the replay frame docks into."
  [result n]
  (let [basis (nth (:bases result) (dec n) nil)
        projector (:projector result)
        actors (keys (:views result))
        views (if (or (nil? basis) (nil? projector))
                {}
                (into {} (map (fn [a] [a (projector basis a)]) actors)))]
    {:step n
     :entry (nth (:trace result) (dec n) nil)
     :basis basis
     :views views}))

(defn all-proven?
  "No refuted verdicts anywhere — every claim proven or witnessed, every
   stretch held. The certificate reads green."
  [result]
  (and (:ok result)
       (empty? (filter (fn [v] (= :refuted (:verdict v))) (:verdicts result)))
       (empty? (filter (fn [s] (= :refuted (:verdict s))) (:stretches result)))))

(defn refuted
  "The refuted claims WITH their witnesses — what to bisect in the film."
  [result]
  (filter (fn [v] (= :refuted (:verdict v))) (:verdicts result)))
