;; mcp/jsonrpc.bl — JSON-RPC 2.0 protocol helpers for MCP 2026-07-28.
;;
;; Pure data in/out: message validation, result/error envelopes, _meta handling.
;; All functions are stateless. JSON keys are strings (from Jason/decode!).

(ns mcp.jsonrpc)

;; ─────────────────────────────────────────────────────────────────────
;; Protocol Versioning
;; ─────────────────────────────────────────────────────────────────────

(def ^:private PROTOCOL-VERSION "2026-07-28")
(def ^:private SUPPORTED-VERSIONS ["2026-07-28"])

(defn protocol-version
  "Return the supported MCP protocol version as a string."
  []
  PROTOCOL-VERSION)

(defn supported-versions
  "Return list of supported protocol versions."
  []
  SUPPORTED-VERSIONS)

;; ─────────────────────────────────────────────────────────────────────
;; Server Info and Metadata
;; ─────────────────────────────────────────────────────────────────────

(defn server-info
  "Return the server info map with name and version.
   Used to populate _meta.serverInfo in responses."
  []
  {"name" "beam-lisp-mcp-server"
   "version" "0.1.0"})

(defn server-meta
  "Return the server metadata object for inclusion in result _meta.
   Contains serverInfo and protocolVersion."
  []
  {"io.modelcontextprotocol/serverInfo" (server-info)})

;; ─────────────────────────────────────────────────────────────────────
;; Request Validation
;; ─────────────────────────────────────────────────────────────────────

(defn request-version
  "Extract and return the protocolVersion from a request's _meta.
   Returns nil if _meta or protocolVersion is absent."
  [request]
  (let [meta (get request "_meta")]
    (when (some? meta)
      (get meta "io.modelcontextprotocol/protocolVersion"))))

(defn version-supported?
  "Check if a given protocol version is in the supported list."
  [version]
  (some? (some #(= % version) SUPPORTED-VERSIONS)))

(defn request-valid?
  "Validate a request map has required JSON-RPC fields:
   - jsonrpc: must be \"2.0\"
   - method: must be present (string)
   - params: optional
   - id: optional (can be string, number, nil)
   
   Returns true if valid, false otherwise."
  [request]
  (let [jsonrpc (get request "jsonrpc")
        method (get request "method")]
    (and (= jsonrpc "2.0")
         (string? method)
         (not (empty? method)))))

(defn request-has-version?
  "Check if a request carries protocolVersion in _meta."
  [request]
  (some? (request-version request)))

;; ─────────────────────────────────────────────────────────────────────
;; Result Envelopes
;; ─────────────────────────────────────────────────────────────────────

(defn complete-result
  "Wrap a result value in the MCP 2026-07-28 envelope: resultType lives
   INSIDE the result object (SEP-2322: every result carries resultType)."
  [value id & [opts]]
  (let [meta (merge (server-meta)
                    (when (some? opts)
                      (dissoc opts :client-info :client-capabilities)))
        result-obj (if (map? value)
                     (assoc value "resultType" "complete")
                     {"resultType" "complete" "value" value})]
    {"jsonrpc" "2.0"
     "id" id
     "result" result-obj
     "_meta" meta}))

(defn input-required-result
  "MRTR interim result (SEP-2322): result carries resultType
   input_required AND the inputRequests, both inside the result object."
  [input-requests id & [opts]]
  (let [meta (merge (server-meta)
                    (when (some? opts)
                      (dissoc opts :input-requests)))]
    {"jsonrpc" "2.0"
     "id" id
     "result" {"resultType" "input_required"
               "inputRequests" input-requests}
     "_meta" meta}))

(defn error-envelope
  "Wrap an error in a JSON-RPC 2.0 error response.
   
   Args:
   - code: JSON-RPC error code (integer)
   - message: error message string
   - id: the request id (can be nil)
   - data: optional additional error data
   
   Returns a map with:
   - jsonrpc: \"2.0\"
   - error: {code, message, [data]}
   - id: preserved (including nil)"
  [code message id & [data]]
  (let [error-obj (cond-> {"code" code "message" message}
                    (some? data) (assoc "data" data))]
    {"jsonrpc" "2.0"
     "id" id
     "error" error-obj}))

(defn unsupported-version-error
  "Return an error for unsupported protocol version.
   
   Args:
   - id: the request id (can be nil)
   - version: the version string that was requested (or nil)
   
   JSON-RPC error code: -32022 (for UnsupportedProtocolVersionError)
   
   Returns error envelope with supported versions in data."
  [id version]
  (let [data {"requestedVersion" version
              "supportedVersions" SUPPORTED-VERSIONS}]
    (error-envelope -32022
                    "Unsupported protocol version"
                    id
                    data)))

(defn invalid-request-error
  "Return an error for an invalid JSON-RPC request.
   
   Args:
   - id: the request id (can be nil)
   - reason: optional string describing what is invalid
   
   JSON-RPC error code: -32600 (InvalidRequest)"
  [id & [reason]]
  (let [data (when (some? reason) {"reason" reason})]
    (error-envelope -32600 "Invalid Request" id data)))

(defn method-not-found-error
  "Return an error for a method not found.
   
   Args:
   - id: the request id
   - method: the method name string that was not found
   
   JSON-RPC error code: -32601"
  [id method]
  (error-envelope -32601
                  "Method not found"
                  id
                  {"method" method}))

(defn invalid-params-error
  "Return an error for invalid parameters.
   
   Args:
   - id: the request id
   - reason: optional string describing the issue
   
   JSON-RPC error code: -32602"
  [id & [reason]]
  (let [data (when (some? reason) {"reason" reason})]
    (error-envelope -32602 "Invalid params" id data)))

