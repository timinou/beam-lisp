; priv/lib/mcp/tools.bl — the codebase tools: code-as-facts behind an MCP surface.
;
; The codebase is a FACT DATABASE: a model asks precise questions over it and
; only ANSWERS (rows) cross the wire, never whole files. The tools are
;
;     code/list  ·  code/query  ·  code/ask  ·  code/verify
;     code/subscribe  ·  code/poll
;
; code/query is the datalog escape hatch (max power); code/ask is the ergonomic
; layer of NAMED questions a coding agent actually asks ("who breaks if X
; changes", "who calls X", "what does X reach"). A question that needs a target
; and gets none returns input_required (MRTR) — the same elicitation a client
; already understands.
;
; code/verify proves a defserver's ^{:invariant} with z3 and, on failure,
; synthesizes the weakest repairing guard. code/subscribe + code/poll expose
; live fact changes through datom's watch: "tell me when my function gains or
; loses a caller".
;
; The tools serve TWO mounts, in order: beam-lisp's own engine (priv/std/
; codebase.bl + priv/std/typed.bl — the very code answering these questions),
; and, when the command runs inside a project, that tree's own namespaces read
; from env.bl's `:paths`. The datom conn is built on first use, so requiring
; this namespace reads no files and transacts nothing.
;
; Design principle (Anthropic's code-execution-with-MCP; CodeRLM; LogicLoc,
; arXiv 2604.16021): only answers cross the wire.
;
; NB on correctness: priv/std/codebase.bl ships `impact`/`reachable` whose datalog
; leaves the target var unbound — `(reaches ?who ?name)` with ?name free means
; "?who reaches SOME callee", i.e. every caller, not the callees of a NAMED fn.
; bl.ask binds the target via :in (the "filter at the call site" discipline), so
; `impact of X` is genuinely X's callers. This server delegates every named
; question to bl.ask, so the fix lives in one place and `bl ask` shares it.

(ns mcp.tools
  (:require [bl.ask :as ask]
            [bl.env :as env]
            [bl.util :as u]
            [codebase]
            [typed]
            [datom]
            [datom.watch]
            [mcp.instructions :as instr]
            [system.core :as sys]
            [z3]))

;; ── what gets mounted: the engine, then the tree you are standing in ──
;;
;; The engine indexes ITSELF — priv/std/codebase.bl and priv/std/typed.bl, the
;; very code answering these questions ("the checker as a database",
;; examples/typing/02_codebase_demo.bl act 2) — and that is always mounted:
;; every answer about the language needs it, and it is two namespaces.
;;
;; On top of it, when the command runs inside a PROJECT (an env.bl, found by
;; walking up from the client's cwd), the tree's OWN namespaces are mounted,
;; read from env.bl's `:paths`. Those are the same roots `bl` hands the loader,
;; so "what this server serves" and "what a require resolves" cannot drift
;; apart — and `bl mcp` in a checkout answers questions about the code the
;; caller is editing, not only about the language it is written in. With no
;; project file (or nothing loadable under its roots) the engine alone is the
;; honest answer, which is what a bare `bl mcp` from /tmp gets.
;;
;; A namespace's SOURCE is read the way the loader reads it
;; (`BeamLisp.Loader/read_source`: the bytes for a plain `.bl`, the concatenated
;; code cells for a literate `.bl.md`), and its NAME is the one the file
;; DECLARES (`bl.util/ns-of`), never the one its path would suggest: the loader
;; itself skips a candidate whose declared ns differs, so a project file may be
;; named after the tool it is (`tooling/catalog.bl` declaring
;; `tooling.catalog-app`) without hijacking a shipped namespace.

(def sigs (merge typed/core-sigs typed/core-seeds-v2 typed/host-seeds))

(def engine-mount
  ;; The language's own two namespaces, spelled as a mount group like any other.
  ;; They have no file of their own to read, so a source of nil means "resolve
  ;; this one BY NAME through the load path" (see mount-source): a name is what
  ;; resolves in a release installed anywhere, while a path only ever resolved
  ;; from the checkout that wrote it.
  {:name "beam-lisp"
   :title "beam-lisp self-index (codebase.bl + typed.bl)"
   :description "The code-as-facts engine indexed over itself: fn/call facts, return types, call graph."
   :sources (to-list (map (fn [ns-str] [ns-str nil]) ["codebase" "typed"]))})

(defn- project-mount
  "The tree's own namespaces as a mount group — from env.bl's `:paths`, which
   are absolute, already discovered by walking up from the client's cwd — or nil
   when there is no project file, no roots, or nothing loadable under them.
   `exclude` names namespaces another group already mounts, so one source is
   never indexed twice."
  [exclude]
  (let [p (env/project (BeamLisp/cwd))
        roots (to-list (:paths p))]
    (when (seq roots)
      (let [sources (reduce
                      (fn [acc f]
                        (let [src (BeamLisp.Loader/read_source f)
                              ns-str (u/ns-of src)]
                          (if (or (= "user" ns-str)
                                  (contains? exclude ns-str)
                                  (some (fn [pr] (= ns-str (first pr))) acc))
                            acc
                            (conj acc [ns-str src]))))
                      []
                      (mapcat u/expand-targets roots))
            name (or (:name p) "project")]
        (when (seq sources)
          {:name name
           :title (str name " — " (count sources) " namespaces under " (join " " roots))
           :description "The project's own namespaces, read from env.bl's :paths: fn/call facts, return types, call graph."
           :roots (to-list roots)
           :sources sources})))))

(defn- mount-groups
  "The mounts, in order: the engine, then this tree."
  []
  (let [tree (project-mount (set (map first (:sources engine-mount))))]
    (if (some? tree) [engine-mount tree] [engine-mount])))

(defn- offset-facts
  "Shift every :db/id by delta so multiple files never collide. codebase.bl
   uses fixed id bases per index-source, so two mounts into one conn would
   otherwise overwrite each other. Entities join by :fn/name / call strings,
   never by :db/id, so shifting ids is semantically free."
  [facts delta]
  (to-list (map (fn [f] (assoc f :db/id (+ (get f :db/id) delta))) facts)))

(defn- mount-source
  "The mountable source of `ns-str`: exactly the text the loader would compile
   for that namespace, found on the load path. priv ships beam-lisp's own
   libraries, so this resolves in a checkout and in a release alike.

   Raises rather than returning a read FAILURE as if it were source: a mount
   that cannot find its file must say which namespace is missing, not fail
   later inside the reader on `:enoent`."
  [ns-str]
  (if-let [src (BeamLisp.Loader/source_content ns-str)]
    src
    (throw (ex-info (str "mcp.tools: no source for " ns-str " on the load path")
                    {:ns ns-str :searched (BeamLisp.Tiers/dirs)}))))

(defn- mount!
  "Index every mount group into one fresh datom conn, id-offsetting each source
   so two files never collide, and tally what each group contributed. Returns
   {:conn … :groups […] :core-names #{…}} — the groups are what code/list
   reports and core-names is what `unknown-callees` measures against, so both
   are read OFF THE MOUNT instead of asked of the runtime later."
  []
  (let [conn (codebase/connect-codebase)
        groups (mount-groups)
        rows (reduce
               (fn [acc [g [ns-str src]]]
                 (let [facts (codebase/index-source sigs ns-str (or src (mount-source ns-str)))
                       delta (* (:i acc) 1000000)
                       all (concat (offset-facts (:fn facts) delta)
                                   (offset-facts (:calls facts) delta)
                                   (offset-facts (:instr facts) delta))]
                   (datom/transact! conn all)
                   {:i (+ (:i acc) 1)
                    :rows (conj (:rows acc)
                                {:group (:name g) :ns ns-str
                                 :functions (count (:fn facts))
                                 :calls (count (:calls facts))
                                 :names (map (fn [f] (get f :fn/name)) (:fn facts))})}))
               {:i 0 :rows []}
               (mapcat (fn [g] (map (fn [s] [g s]) (:sources g))) groups))
        of-group (fn [gname] (filter (fn [r] (= gname (:group r))) (:rows rows)))]
    ;; The instruction corpus mounts beside the code facts: one conn, so
    ;; code/query reaches the :instr/* facts with the same datalog.
    (instr/mount! conn)
    {:conn conn
     :groups (to-list
               (map (fn [g]
                      (let [rs (of-group (:name g))
                            m {:name (:name g)
                               :title (:title g)
                               :description (:description g)
                               :sources (to-list (map first (:sources g)))
                               :entities {:namespaces (to-list (sort (map :ns rs)))
                                          :functions (reduce (fn [n r] (+ n (:functions r))) 0 rs)
                                          :calls (reduce (fn [n r] (+ n (:calls r))) 0 rs)}
                               :uri (str "code://" (:name g) "/schema")}]
                        (if (some? (:roots g)) (assoc m :roots (to-list (:roots g))) m)))
                    groups))
     ;; core + every name the mount indexed. Asked of the FACTS, not of
     ;; `Env/public_names`: that call LOADS the namespace, and loading a
     ;; forty-file plant to answer a question about its call graph is the cost
     ;; this server exists to avoid. The set is a superset of the public names
     ;; (a private def is defined too), which is the safe direction for
     ;; `unknown-callees`: it flags a callee with no definition anywhere, and
     ;; every name here is one we just indexed.
     :core-names (into (set (BeamLisp.Env/public_names "core"))
                       (mapcat :names (:rows rows)))}))

; Built once, on first use — requiring this namespace reads no files and
; transacts nothing; the mount happens the first time a tool asks for it.
;
; "Once" means once while the memo is USABLE. A conn's store and blob store are
; ETS tables owned by the process that mounted them, so this atom — VM-global,
; written by whichever process asked first — can outlive what it names. In the
; daemon that is the normal case, not an edge: commands run in one worker, and
; a worker that dies (a linked crash, a staleness restart) takes the tables
; with it while the memo keeps handing the dead conn out. Every later request
; then dies inside `:ets.lookup` with "the table identifier does not refer to an
; existing ETS table", which reads like a corrupt store rather than what it is:
; a memo outliving its owner. So ask before trusting one.
;
; The mount is held as ONE value — conn, groups and core-names together — so a
; re-mount cannot hand out a conn from one build and counts from another.
(def ^:private the-mount (atom nil))

(defn- mounted []
  (let [m @the-mount]
    (if (and (some? m) (datom/alive? (:conn m)))
      m
      (let [_ (when (some? m) (datom/release! (:conn m)))
            fresh (mount!)]
        (if (compare-and-set! the-mount m fresh) fresh @the-mount)))))

(defn conn
  "The self-indexed codebase: one datom conn over every mounted source."
  []
  (:conn (mounted)))

(defn mounts
  "What this server serves, in order: the engine, then — when the command runs
   inside a project — this tree's own namespaces, read from env.bl's `:paths`.
   Each entry is a `code/list` row: name, title, description, its namespaces,
   the fn/call counts it contributed, and (for a tree) the roots it came from."
  []
  (:groups (mounted)))

(defn core-names
  "The always-defined set `unknown-callees` measures against: the public core
   names plus every function this mount indexed (see mount!'s note)."
  []
  (:core-names (mounted)))

;; ── tool 1: code/list ───────────────────────────────────────────────

(def code-list-descriptor
  {:type "object" :properties {} :required []})

(defn code-list-handler [_args]
  ;; Straight off the mount: what was indexed, from where, and how much of it.
  ;; A client that asks "what are you serving?" gets the same list the server
  ;; built its facts from, not a re-derivation from the store.
  {:codebases (to-list (mounts))})

;; ── tool 2: code/query (the datalog escape hatch) ───────────────────
;;
;; Same in-count discipline as the legal prototype: the query declares its
;; own :in inputs; we pass exactly what it declares. Rules (%) available for
;; recursive walks (reaches); a trailing scalar (?target) is threaded from
;; the `bindings` arg in declaration order.

(def code-query-descriptor
  {:type "object"
   :properties
   {:codebase {:type "string" :description "Codebase name (e.g. beam-lisp)"}
    :query {:type "array" :description "Datalog query (EDN vector) over fn/call facts"
            :items {}}
    :bindings {:type "array"
               :description "Scalar :in inputs after $ and % (in declaration order)"
               :items {}}}
   :required ["query"]})

(defn- edn-term
  "JSON carries no keywords and no symbols, so a query that crossed the wire
   arrives as plain strings and datalog rejects it at the first section. Put
   the two tokens datalog dispatches on back: \":find\" → :find and \"?name\"
   → ?name (with $, % and _ for the rules and the blank). Every other string
   is a data value and stays one — [?c :call/callee \"walk-calls\"] still
   matches a name. A query built in-process already holds real terms, and
   those are not strings, so it passes through untouched."
  [x]
  (cond
    (string? x)
    (cond
      (starts-with? x ":") (keyword (subs x 1))
      (starts-with? x "?") (symbol x)
      (or (= x "$") (= x "%") (= x "_")) (symbol x)
      :else x)

    (sequential? x) (into [] (map edn-term (to-list x)))

    :else x))

(defn- in-tokens
  "The flat symbols the query declares between :in and the next clause
   keyword — e.g. [$ % ?today]. Empty when :in is absent (implicit [$])."
  [query-vec]
  (let [xs (to-list query-vec)]
    (if (some? (some (fn [x] (= x :in)) xs))
      (take-while (fn [x] (not (keyword? x)))
                  (rest (drop-while (fn [x] (not (= x :in))) xs)))
      [])))

(defn code-query-handler [args]
  (let [query-raw (get args "query")
        query-vec (cond
                    (vector? query-raw) (edn-term query-raw)
                    (sequential? query-raw) (edn-term (into [] query-raw))
                    :else (throw (ex-info "query must be sequential" {})))
        db (datom/db (conn))
        ;; Inputs are positional: $ → the db, % → the REACH rules, every
        ;; other declared symbol (?target …) is filled from `bindings` in
        ;; order. This reads the :in clause instead of guessing by arity,
        ;; so `:in $ ?wanted` binds ?wanted to a scalar and `:in $ % ?t`
        ;; correctly slots the rules into the % position.
        toks (in-tokens query-vec)
        raw-binds (or (get args "bindings") [])
        user-binds (to-list (if (sequential? raw-binds) raw-binds []))
        [inputs _]
        (reduce (fn [[acc rest-binds] tok]
                  (cond
                    (= tok '$) [(conj acc db) rest-binds]
                    (= tok '%) [(conj acc codebase/REACH) rest-binds]
                    :else [(conj acc (first rest-binds)) (rest rest-binds)]))
                [[] user-binds]
                (if (empty? toks) ['$] toks))
        result (apply datom/q query-vec inputs)]
    {:codebase (or (get args "codebase")
                   (:name (first (mounts))))
     :rows (to-list (map to-list result))}))

;; ── tool 3: code/ask (named questions; MRTR for missing target) ─────
;;
;; The ergonomic layer. A coding agent does not think in datalog — it asks
;; "who breaks if I change X", "who calls X", "what does X reach", "which fns
;; return string", "any arity mismatches", "any unknown callees". Each maps
;; to one canned, target-bound query. Questions that NEED a target but got
;; none return input_required (MRTR) — the identical elicitation the legal
;; prototype used for document params, here asking "which function?".

(def code-ask-descriptor
  {:type "object"
   :properties
   {:question {:type "string"
               :description (str "One of: " (join ", " (ask/db-questions)))}
    :target {:type "string"
             :description "The function name (or type tag for returns-type) the question is about"}}
   :required ["question"]})

;; The answers live in bl.ask — the CLI and this server read the same question
;; table and call the same `answer`, so a question has ONE implementation. The
;; MRTR envelope below stays here: it is this surface's protocol shape, not
;; the question's.

(defn code-ask-handler [args]
  (let [question (get args "question")
        target (get args "target")]
    (cond
      ;; a target question with no target: elicit it (MRTR). Which questions
      ;; take a target is bl.ask's table — one definition, both interfaces.
      (and (ask/needs-target? question) (nil? target))
      {:resultType "input_required"
       :inputRequests
       [{"method" "elicitation/create"
         "params" {"message" (str "The '" question "' question needs a target function name.")
                   "requestedSchema"
                   {"type" "object"
                    "properties" {"target" {"type" "string"
                                            "description" "Function name (or type tag for returns-type)"}}
                    "required" ["target"]}}}]}

      ;; not a question this surface answers: name the ones that are.
      (not (ask/db-question? question))
      {:resultType "complete"
       :isError true
       :content [{"type" "text"
                  "text" (str "Unknown question: " (pr-str question)
                              ". Try one of: " (join " " (ask/db-questions)))}]}

      :else
      {:resultType "complete"
       :question question
       :target target
       :rows (ask/answer (datom/db (conn)) question target (core-names))})))

;; ── tool 4: code/verify (the PROVER as a tool) ──────────────────────
;;
;; "Is this change safe?" answered by a proof, not a vibe. The client sends
;; the SOURCE of a defserver carrying ^{:invariant …}; system.core proves the
;; invariant holds for every state and input (z3), and when it does NOT,
;; synthesizes the weakest guard that repairs it (the checker run backwards).
;; This is the single-most differentiated coding-agent tool: no other MCP can
;; return a machine-checked safety verdict + an auto-repair for a state machine.
;;
;; The z3 port is opened lazily and memoized in an atom — z3 is a real OS
;; process, so we pay for it only when the first verify arrives. The memo must
;; ASK before reusing it: a port dies with the process that opened it, and the
;; first verify of a server's life is owned by that server — so the memo
;; outlives its owner the moment the server stops. Reusing a dead port raises
;; badarg, which a client reads as "Invalid params". Same rule as the codebase
;; conn above: ask, do not assume.

(def ^:private z3-port (atom nil))

(defn- port! []
  (let [p @z3-port]
    (if (and (not (nil? p)) (z3/alive? p))
      p
      (let [np (z3/open)] (reset! z3-port np) np))))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))

(def code-verify-descriptor
  {:type "object"
   :properties
   {:source {:type "string"
             :description "Source of a defserver carrying ^{:invariant …} to prove safe"}
    :repair {:type "boolean"
             :description "When the invariant fails, synthesize the weakest repairing guard"}}
   :required ["source"]})

(defn code-verify-handler [args]
  (let [source (get args "source")
        want-repair (get args "repair")
        port (port!)
        node (read1 source)
        r (sys/verify-process port node)]
    (cond
      ;; nothing to prove (no ^{:invariant} or not translatable) — say so honestly.
      (not (get r :checked))
      {:resultType "complete"
       :verdict "unchecked"
       :reason (or (get r :reason) "no ^{:invariant} annotation to prove")}

      ;; proven safe.
      (get r :holds)
      {:resultType "complete"
       :verdict "holds"
       :machine (str (get r :name))}

      ;; invariant violated — return the warnings, and a repair if asked.
      :else
      (let [base {:resultType "complete"
                  :verdict "violated"
                  :machine (str (get r :name))
                  :warnings (to-list (map (fn [w]
                                            {:message (get w :msg)
                                             :line (get w :line)
                                             :col (get w :col)})
                                          (get r :warnings)))}]
        (if (not (= want-repair true))
          base
          (let [rp (sys/repair-process port node)]
            (assoc base :repairs
                   ;; The synthesized guard is an AST — a list of symbols. It
                   ;; goes out as SOURCE, both because a raw {:symbol "<="} is
                   ;; not JSON-encodable (the frame dies on the way out and the
                   ;; client waits forever for a line that never comes) and
                   ;; because "(<= amt balance)" is the form the agent pastes
                   ;; straight into that transition's :when.
                   (to-list (map (fn [x] {:transition (name (get x :label))
                                          :guard (pr-str (get x :guard))})
                                 (get rp :repairs))))))))))

;; ── tool 5: code/subscribe + code/poll (LIVE fact changes via datom/watch) ─
;;
;; MCP 2026-07-28 has subscriptions/listen for live resources. datom's L3
;; `datom/watch` IS that mechanism, one layer down: give it a pattern of
;; interest over the fact space and it fires only when a commit matches. The
;; canonical coding-agent use: "tell me if the function I am editing gains or
;; loses a caller" — [?c :call/callee <fn>]. This prototype exposes it as a
;; poll pair (subscribe returns a handle; poll drains what fired) because the
;; in-process demo has no long-lived listen stream; a real transport wires the
;; callback straight to subscriptions/listen frames.

(def ^:private subscriptions (atom {}))   ; id → {:watch pid :buf atom}
(def ^:private sub-counter (atom 0))

(def code-subscribe-descriptor
  {:type "object"
   :properties
   {:callee {:type "string"
             :description "Fire when a call TO this function is asserted/retracted"}}
   :required ["callee"]})

(defn code-subscribe-handler [args]
  (let [callee (get args "callee")
        buf (atom [])
        w (datom.watch/watch (conn) [(quote ?c) :call/callee callee]
            (fn [changes] (swap! buf concat changes)))
        id (str "sub-" (swap! sub-counter (fn [n] (+ n 1))))]
    (swap! subscriptions assoc id {:watch w :buf buf :callee callee})
    {:resultType "complete"
     :subscription id
     :interest (str "[?c :call/callee \"" callee "\"]")
     :note "Fires on a new/removed caller of this fn. Drain with code/poll."}))

(def code-poll-descriptor
  {:type "object"
   :properties
   {:subscription {:type "string" :description "The subscription id from code/subscribe"}}
   :required ["subscription"]})

(defn code-poll-handler [args]
  (let [id (get args "subscription")
        sub (get @subscriptions id)]
    (if (nil? sub)
      {:resultType "complete" :isError true
       :content [{"type" "text" "text" (str "Unknown subscription: " (pr-str id))}]}
      (let [buf (get sub :buf)
            drained @buf
            db (datom/db (conn))
            ;; The matched datom is [?e :call/callee <callee>]; its :v is the
            ;; CALLEE, not the caller. The caller is a sibling datom on the same
            ;; call entity :e — resolve it so the event names who added the call.
            caller-of (fn [e]
                        (let [r (into [] (datom/q '[:find ?caller :in $ ?e
                                                    :where [?e :call/caller ?caller]]
                                                  db e))]
                          (if (empty? r) nil (first (first r)))))]
        (reset! buf [])
        {:resultType "complete"
         :subscription id
         :events (to-list (map (fn [c] {:caller (caller-of (get c :e))
                                        :callee (str (get c :v))
                                        :added (get c :added)})
                               drained))}))))

;; A test seam: assert a call fact into the live conn so the demo can show a
;; subscription firing. Real callers commit through their own edits; this is
;; the in-process equivalent of "someone added a call to your fn".
(defn assert-call! [caller callee arity line]
  (datom/transact! (conn)
    [{:db/id (+ 9000000 (swap! sub-counter (fn [n] (+ n 1))))
      :call/caller caller :call/callee callee
      :call/arity arity :call/line line}]))

;; ── registry (identical shape to the legal prototype) ───────────────

(def tools
  [["code/list"
    "List mounted codebases and their manifests (namespaces, fn/call counts)"
    code-list-descriptor
    code-list-handler]
   ["code/query"
    "Datalog over a codebase's fn/call facts (rules available for reachability)"
    code-query-descriptor
    code-query-handler]
   ["code/ask"
    "Ask a named question about the code; elicits the target fn if missing (MRTR)"
    code-ask-descriptor
    code-ask-handler]
   ["code/verify"
    "Prove a defserver's ^{:invariant} holds (z3); synthesize a repair if it fails"
    code-verify-descriptor
    code-verify-handler]
   ["code/subscribe"
    "Watch the fact space: fire when a fn gains/loses a caller (datom L3 watch)"
    code-subscribe-descriptor
    code-subscribe-handler]
   ["code/poll"
    "Drain the events a subscription has accumulated since the last poll"
    code-poll-descriptor
    code-poll-handler]])

(defn tool-by-name [name]
  (first (filter (fn [t] (= name (first t))) tools)))

(defn tools-list []
  (to-list
    (map (fn [t]
           (let [[name desc schema _] t]
             {:name name :description desc :inputSchema schema}))
         tools)))
