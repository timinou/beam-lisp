;; priv/lib/mcp/server.bl — the MCP 2026-07-28 request server over the code fact space.
;;
;; A single stateless server for the discover / tools/list / tools/call /
;; resources/* methods, with MRTR (input_required) elicitation and JSON-safe
;; stringify. The protocol envelopes are pure data (mcp.jsonrpc); the tools are
;; the codebase questions in mcp.tools. The same dispatch answers the in-process
;; demo and the stdio transport.
;;
;; Demo:  bl run examples/mcp-demo.bl
;; Serve: bl mcp   (stdio)

(ns mcp.server
  (:require [mcp.jsonrpc :as jsonrpc]
            [mcp.instructions :as instr]
            [mcp.tools :as tools]
            [bl.ask :as ask]
            [datom]))

(defn- stringify
  "Convert handler data to JSON-safe maps with string keys. A beam-lisp vector
   or set becomes an Erlang list — `mapv` would hand Jason a BeamLisp.Vector,
   which it refuses to encode."
  [value]
  (cond
    (map? value)
    (reduce (fn [out k]
              (assoc out (if (keyword? k) (name k) (str k))
                     (stringify (get value k))))
            {} (keys value))
    (vector? value) (to-list (map stringify value))
    (list? value) (to-list (map stringify value))
    (set? value) (to-list (map stringify (to-list value)))
    (BeamLisp.LazySeq/lazy? value) (to-list (map stringify (doall value)))
    (keyword? value) (name value)
    ;; A symbol is code, and Jason has no encoder for one. Rendering it is not
    ;; cosmetic: one unencodable member kills the WHOLE frame, and a frame that
    ;; never gets written is a client that never gets an answer. Any handler
    ;; returning a fragment of AST — a synthesized guard, a form — crosses the
    ;; wire as the source it reads as.
    (symbol? value) (str value)
    :else value))

(defn- resource-descriptors []
  [{"uri" "code://beam-lisp/schema"
    "name" "beam-lisp codebase schema"
    "description" "Fact schema: fn/name, fn/arity, fn/ret-tag, call/caller, call/callee …"
    "mimeType" "application/json"}
   {"uri" "code://beam-lisp/namespaces"
    "name" "beam-lisp indexed namespaces"
    "description" "The namespaces currently indexed into the fact database"
    "mimeType" "application/json"}])

(defn- state-conn
  "The state's conn, ASKED WHETHER IT IS STILL THERE before it is read.

   A state outlives the process that built it BY DESIGN in one caller: the
   daemon's HTTP MCP builds it once and keeps it in a persistent_term for the
   session (lib/beam_lisp/daemon/http.ex, `mcp_state/1`), while a conn's ETS
   tables are owned by the process that mounted them — the first request's
   Bandit connection, which exits when that connection closes. The next client
   then reads a state whose tables are gone and gets `-32603 Internal error: …
   the table identifier does not refer to an existing ETS table` on
   `server/discover` (FUP-014), which a user reads as a corrupt database.

   Measured: a state built in a process that then exits throws ArgumentError
   from BOTH `server/discover` and `prompts/get`; the tools are unaffected
   because they go through `live-mount`'s check. The engine conn re-mounts
   whenever its own memo is stale, so it answers when the cached one is gone —
   the handshake costs a re-mount only in the case that used to cost the client
   the handshake entirely."
  [state]
  (let [c (get state :conn)]
    (cond
      ;; Alive: use it.
      (and (some? c) (datom/alive? c)) c
      ;; A registry that SHIPS a conn (the codebase one) expects it to be
      ;; re-mountable, because an ETS table's owner may have exited.
      (contains? state :conn) (tools/engine-conn)
      ;; A caller-supplied registry that named no conn has none to lose: the
      ;; handshake stays a pure data question, and nothing mounts a codebase
      ;; the caller never asked for.
      :else nil)))

(defn registry-state
  "A server state over a CALLER-SUPPLIED registry — the seam that lets an app
   serve its OWN tools through this protocol core instead of forking it.

   A registry is a plain map, so an app can build one at runtime, from a
   database, a config or a tenant, and this module never learns the app's nouns:

     :tools         [[name description inputSchema handler] …]
     :resources     [descriptor …]                 (resources/list)
     :resource-read (fn [state uri] → result|nil)  (resources/read)
     :prompts       [descriptor …]                 (prompts/list)
     :prompt-get    (fn [state name] → {:description :text}|nil)
     :instructions  string | (fn [state] → string) (discover, initialize)
     :root          the cwd handler calls run under (optional)
     :conn          a datom conn for liveness checks (optional)

   Anything omitted is EMPTY rather than wrong: a server with no prompts
   answers prompts/list with an empty list, and a registry that names no conn
   mounts no codebase. `:conn` is deliberately absent from the defaults —
   `state-conn` uses its presence to tell 'this registry's conn died, re-mount'
   from 'this registry never had one'."
  [registry]
  (merge {:tools []
          :resources []
          :resource-read (fn [_state _uri] nil)
          :prompts []
          :prompt-get (fn [_state _name] nil)
          :instructions ""
          :root (BeamLisp/cwd)}
         registry))

(defn- codebase-instructions [state]
  (if-let [c (state-conn state)]
    (str (get (instr/prompt "beam-lisp/onboarding" (datom/db c) nil) :text)
         (if (tools/mounted?)
           ""
           (str "\n\n*Your tree is not indexed yet — it mounts on the first "
                "code question: " (tools/plan-line) ".*")))
    ""))

(defn- codebase-registry []
  ;; The ENGINE, not the full mount: a handshake has to answer in seconds, and
  ;; the tree's sources are minutes (43 sources in a real shop, 327 in
  ;; beam-lisp's own :paths). `tools/conn` — the full mount — is what a code
  ;; question pays for, on first use; `tools/plan-line` is what the corpus says
  ;; about a tree that has not been indexed yet.
  ;;
  ;; `:root` is the tree this server answers about, decided HERE — in the process
  ;; that holds the caller's cwd binding — because a spawned process does NOT
  ;; inherit the process dictionary (measured: `erlang/spawn` + `(BeamLisp/cwd)`
  ;; in the child answers the OS cwd, not the parent's `:bl_cwd`). Every request
  ;; is dispatched under it (see handle-call), so the mount follows the CLIENT's
  ;; tree rather than whatever tree started the server.
  (registry-state
   {:tools tools/tools
    :resources (resource-descriptors)
    :resource-read codebase-resource-read
    :prompts instr/prompt-descriptors
    :prompt-get (fn [state name]
                  (instr/prompt name (datom/db (state-conn state))
                                (live-usage-section state)))
    :instructions codebase-instructions
    :root (tools/tree-key)
    :conn (tools/engine-conn)}))

(defn- server-state [] (codebase-registry))

(defn- find-tool [state name]
  (first (filter (fn [entry] (= name (first entry)))
                (get state :tools))))

(defn live-usage-section
  "The live registry, as markdown: what is mounted, then every tool, named
   question, resource and prompt AS REGISTERED RIGHT NOW. The freshest
   statement of the surface is the surface itself — this section is computed,
   never authored."
  [state]
  (let [db (datom/db (state-conn state))
        ;; The tree is indexed on the first code question, so before that the
        ;; honest thing to report is the PLAN — a count of fn facts that do not
        ;; exist yet would read as "your code has no functions". Once it IS
        ;; mounted the counts come from the full mount, not the engine alone.
        manifest (if (tools/mounted?)
                   (instr/manifest-line (datom/db (tools/conn)))
                   (str (instr/manifest-line db) "\n"
                        "*Your tree mounts on the first code question: "
                        (tools/plan-line) ".*"))
        tool-lines (map (fn [t] (str "- `" (get t :name) "` — " (get t :description)))
                        (tools/tools-list))]
    (join "\n"
          (concat
           ["## Right now — the live registry" ""
            manifest ""
            "### Tools"]
           tool-lines
           [""
            (str "### Named questions for code/ask\n\n" (join " · " (ask/db-questions)))
            ""
            "### Resources\n\ncode://beam-lisp/schema · code://beam-lisp/namespaces"
            ""
            "### Prompts\n\nbeam-lisp/onboarding · beam-lisp/usage · beam-lisp/protocol"]))))

(defn- instructions-for
  "What a server says about itself at `discover` / `initialize`. A registry
   supplies either a string or a function of state — the codebase one computes
   its text by querying the instruction corpus, an app that has no corpus says
   nothing and is not made to look like it has one."
  [state]
  (let [i (get state :instructions)]
    (cond
      (string? i) i
      (some? i) (i state)
      :else "")))

(defn- discover
  "The handshake analog. Beyond capabilities and serverInfo, the result
   carries `instructions` — the ONBOARDING prompt, assembled from the
   instruction facts in the mounted database, so even a client that never
   calls prompts/get is told how to hold this server."
  [state]
  (let [base {"protocolVersion" (jsonrpc/protocol-version)
              "supportedProtocolVersions" (to-list (jsonrpc/supported-versions))
              "capabilities" {"tools" {}
                               "prompts" {"listChanged" false}
                               "resources" {"subscribe" false "listChanged" false}}
              "serverInfo" (jsonrpc/server-info)}]
    (let [text (instructions-for state)]
      (if (= "" text) base (assoc base "instructions" text)))))

(defn- initialize-result
  "The classic handshake's answer. Same capabilities, serverInfo and
   instructions `discover` returns — the two methods differ only in their name
   and in where the version travels (params here, `_meta` there)."
  [state requested]
  (assoc (dissoc (discover state) "supportedProtocolVersions")
         "protocolVersion" (jsonrpc/negotiate-version requested)))

(defn- legacy? [state]
  (= :legacy (get state :lifecycle)))

(defn- legacy-tool-result
  "MCP 2025-06-18 CallToolResult: the rows as JSON text in `content`, with the
   same map repeated in `structuredContent` for clients that read it. A modern
   result is bare rows; a classic client renders NOTHING without `content`, so
   connecting without this envelope buys a handshake and no usable tool."
  [value]
  (let [text (try (Jason/encode! value)
                  (catch error (pr-str value)))]
    {"content" [{"type" "text" "text" text}]
     "structuredContent" value
     "isError" false}))

(defn- tool-envelope
  "Shape a tool result for the lifecycle the client opened with."
  [state value]
  (if (legacy? state) (legacy-tool-result value) value))

(defn- classic-frame
  "JSON-RPC 2.0 gives a response object exactly `jsonrpc`, `id` and one of
   `result`/`error`. The modern revision hangs `_meta` beside them; a classic
   client validates the envelope strictly and DROPS the whole message, which
   reaches the user as a hang rather than an error. Fold it inside `result`,
   where `Result._meta` is legal in every revision."
  [response]
  (if (and (map? response) (some? (get response "_meta")))
    (let [m (get response "_meta")
          bare (dissoc response "_meta")]
      (if (some? (get bare "result"))
        (assoc bare "result" (assoc (get bare "result") "_meta" m))
        bare))
    response))

(defn- tools-list [state]
  ;; Raw data: `request-response` normalizes what it returns. The descriptors
  ;; are projected from the STATE's registry, which is what lets a caller
  ;; supply its own tools: this used to call tools/tools-list directly, and a
  ;; projection hard-wired to one registry makes every other registry
  ;; impossible. For the codebase registry the result is identical, because
  ;; tools/tools-list is this same projection over tools/tools.
  {"tools" (to-list
            (map (fn [t]
                   (let [[name desc schema _] t]
                     {:name name :description desc :inputSchema schema}))
                 (get state :tools)))
   "ttlMs" 60000
   "cacheScope" "public"})

(defn- codebase-resource-read [state uri]
  (cond
    (= uri "code://beam-lisp/schema")
    {"contents" [{"uri" uri
                    "mimeType" "application/json"
                    "text" (str "{\"entities\":[\"fn\",\"call\"],"
                                "\"fn\":[\"name\",\"ns\",\"arity\",\"line\",\"variadic\",\"ret-tag\",\"ret-source\"],"
                                "\"call\":[\"caller\",\"callee\",\"arity\",\"line\"]}")}]}

    ;; the vocabulary above is static; THIS is a fact read, so it is the call
    ;; that mounts the tree when a client asks what is in the database
    (= uri "code://beam-lisp/namespaces")
    (let [db (datom/db (tools/conn))
          nss (sort (into [] (datom/q '[:find ?ns :where [?d :fn/ns ?ns]] db)))
          joined (join ", " (map (fn [r] (str "\"" (first r) "\"")) nss))]
      {"contents" [{"uri" uri
                      "mimeType" "application/json"
                      "text" (str "{\"namespaces\":[" joined "]}")}]})

    :else nil))

(defn- resource-read
  "Read a resource through the registry. A registry that lists no resources
   answers nil for every URI, which `request-response` turns into the same
   \"Unknown resource URI\" error an unlisted URI gets from the codebase one."
  [state uri]
  ((get state :resource-read) state uri))

(defn- call-tool [state id params]
  (let [name (get params "name")
        entry (find-tool state name)]
    (if (nil? entry)
      (jsonrpc/invalid-params-error id "Unknown tool")
      (let [handler (nth entry 3)
            supplied (or (get params "arguments") {})
            retry (get params "inputResponses")
            ;; MRTR retry: inputResponses fold back into the ORIGINAL args.
            ;; For code/ask the elicited field is `target`.
            args (if (and (some? retry) (nil? (get supplied "target")))
                   (merge supplied retry)
                   supplied)]
        (try
          (let [raw (stringify (handler args))
                result-kind (get raw "resultType")]
            (cond
              (= result-kind "input_required")
              (jsonrpc/input-required-result (get raw "inputRequests") id)

              (= result-kind "complete")
              (jsonrpc/complete-result
               (tool-envelope state (dissoc raw "resultType")) id)

              ;; A handler that stamps no resultType still produces a TOOL
              ;; result, so it crosses the same envelope boundary — `code/list`
              ;; is one, and skipping it here handed a classic client bare rows
              ;; it cannot render.
              :else
              (jsonrpc/complete-result (tool-envelope state raw) id)))
          (catch error
            (IO/puts :stderr (str "tool handler error: " (pr-str error)))
            (jsonrpc/invalid-params-error id "Tool arguments or query are invalid")))))))

(defserver mcp-server
  (init [initial] (ok (or initial (server-state))))

  ;; Payload-carrying vector dispatch preserves the request in OTP's message.
  ;; The classic lifecycle IS stateful — that is what `initialize` means. A
  ;; client that opens with it gets classic envelopes for the rest of the
  ;; connection; a modern client never sets the flag and is untouched.
  (handle-call [:request value] [_from state]
    ;; Dispatched under the tree the CLIENT stands in. The mount a code question
    ;; triggers happens inside THIS process, and this process was spawned — so
    ;; without this binding it would index the cwd of whatever started the
    ;; server (a daemon's root, say) instead of the caller's tree.
    (reply (BeamLisp/with_cwd (get state :root)
             (fn [] (request-response state value)))
           (if (= "initialize" (get value "method"))
             (assoc state :lifecycle :legacy)
             state)))

  (handle-info _msg [state] (noreply state)))

(defn- classic-for
  "Shape the outgoing frame for the lifecycle this request belongs to. The
   handshake itself counts: `initialize` is answered before the connection is
   marked classic, and that very first frame is the one a strict client drops."
  [state method response]
  (if (or (= method "initialize") (legacy? state))
    (classic-frame response)
    response))

(defn request-response [state request]
  (let [id (get request "id")
        method (get request "method")
        version (jsonrpc/request-version request)]
    ;; ONE normalization boundary for the whole surface. Every branch below
    ;; answers in beam-lisp data — maps, vectors, keyword keys — and the
    ;; transport hands the result straight to Jason, which encodes none of
    ;; those. Converting here rather than in each branch is what makes every
    ;; method safe: the two branches that forgot (resources/list,
    ;; resources/read) produced a `JSON encode error` in the transport that
    ;; named neither the method nor the value.
    (classic-for
     state method
     (stringify
      (cond
      ;; A notification (no `id`) gets NO line back — not a result, not an
      ;; error. Answering one makes a strict client read the reply as an
      ;; unsolicited error, and `id: null` is not a valid correlation either.
      (jsonrpc/notification? request)
      nil

      (not (jsonrpc/request-valid? request))
      (jsonrpc/invalid-request-error id)

      ;; The classic handshake carries its version in `params`, never in
      ;; `_meta` — so it must be answered ABOVE the `_meta` version gate, or
      ;; every client in the wild is refused before it can say hello.
      (= method "initialize")
      (jsonrpc/complete-result
       (initialize-result state (get (or (get request "params") {}) "protocolVersion"))
       id)

      ;; A classic client never sends `_meta` — its revision was settled at
      ;; `initialize`. Gating it on a header its lifecycle does not have would
      ;; refuse every call AFTER a successful handshake. End to end the stdio
      ;; transport injects a version, which is exactly what hid this: the
      ;; server must be correct on its own, not only behind that transport.
      (if (legacy? state)
        (and (some? version) (not (jsonrpc/known-version? version)))
        (not (jsonrpc/version-supported? version)))
      (jsonrpc/unsupported-version-error id version)

      (= method "server/discover")
      (jsonrpc/complete-result (discover state) id)

      (= method "tools/list")
      (jsonrpc/complete-result (tools-list state) id)

      (= method "tools/call")
      (call-tool state id (or (get request "params") {}))

      (= method "resources/list")
      (jsonrpc/complete-result {"resources" (get state :resources)} id)

      (= method "resources/read")
      (let [uri (get (get request "params") "uri")
            result (resource-read state uri)]
        (if (nil? result)
          (jsonrpc/invalid-params-error id "Unknown resource URI")
          (jsonrpc/complete-result result id)))

      ;; The prompts surface: the instruction corpus (mcp.instructions) as
      ;; MCP prompts. Onboarding, usage and protocol are QUERY RESULTS over
      ;; the same conn that holds the code facts — a prompt is assembled,
      ;; never stored as a file.
      (= method "prompts/list")
      (jsonrpc/complete-result {"prompts" (to-list (get state :prompts))} id)

      (= method "prompts/get")
      (let [name (get (get request "params") "name")
            p ((get state :prompt-get) state name)]
        (if (nil? p)
          (jsonrpc/invalid-params-error id "Unknown prompt")
          (jsonrpc/complete-result
           {"description" (get p :description)
            "messages" [{"role" "user"
                          "content" {"type" "text" "text" (get p :text)}}]}
           id)))

      :else
      (jsonrpc/method-not-found-error id method))))))

(defn start []
  (start-link mcp-server (server-state)))

(defn stop [server]
  (core/stop server))

(defn request [server value]
  ;; No ceiling on a request. The DEFAULT is five seconds — shorter than one
  ;; file's type inference — so the first code question about a tree answered
  ;; `{:exit, {:timeout, {:gen_server, :call, …}}}` to stderr and no frame to the
  ;; client at all (reproduced: `cd ~/code/ora/blueprint && ./bl mcp`, one
  ;; tools/call for code/list, 43 sources ≈ 70 s). `code/verify` is the same
  ;; shape of wait: the proof is z3's answer, not ours to time.
  ;;
  ;; The transport reads ONE request at a time from stdin, so nothing queues
  ;; behind this, and a client that runs out of patience first closes the pipe —
  ;; which is the client's timeout doing its job, rather than ours doing it
  ;; wrong.
  (call server [:request value] :infinity))

(defn state []
  (server-state))
