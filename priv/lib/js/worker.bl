; Structured-data workers. BL namespaces keep their ordinary functions; only
; their owner chooses a realm. Conversion and request lifetime live here.
(ns ^:js js.worker)

(defn client
  "An owned module worker with bounded requests, timeouts and deterministic
   disposal. request accepts BL or JS data and resolves to plain JS data."
  [url]
  (let [worker (js/Worker. url #js {:type "module"})
        pending (js/Map.) state #js {:next 0 :closed false}
        fail (fn [error]
               (when-not (.-closed state)
                 (set! (.-closed state) true)
                 (.terminate worker)
                 (.forEach pending (fn [row _key _map]
                                     (js/clearTimeout (.-timer row))
                                     ((.-reject row) error)))
                 (.clear pending)))]
    (.addEventListener worker "message"
      (fn [event]
        (let [data (.-data event) row (.get pending (.-id data))]
          (when row
            (if (.-fatal data)
              (fail (js/Error. (.-error data)))
              (do
                (.delete pending (.-id data))
                (js/clearTimeout (.-timer row))
                (if (.-error data)
                  ((.-reject row) (js/Error. (.-error data)))
                  ((.-resolve row) (.-value data)))))))))
    (.addEventListener worker "error"
      (fn [event] (fail (js/Error. (or (.-message event) "Worker failed")))))
    (.addEventListener worker "messageerror"
      (fn [_] (fail (js/Error. "Worker message could not be decoded"))))
    #js {:request
         (fn [value]
           (js/Promise.
             (fn [resolve reject]
               (cond
                 (.-closed state) (reject (js/Error. "Worker is closed"))
                 (>= (.-size pending) 32) (reject (js/Error. "Worker request limit reached"))
                 :else
                 (let [id (inc (.-next state))
                       timer (js/setTimeout (fn [] (fail (js/Error. "Worker evaluation timed out"))) 15000)]
                   (set! (.-next state) id)
                   (.set pending id #js {:resolve resolve :reject reject :timer timer})
                   (try (.postMessage worker #js {:id id :value (bl->js value)})
                     (catch error
                       (.delete pending id) (js/clearTimeout timer) (reject error))))))))
         :dispose (fn [] (fail (js/Error. "Worker was disposed")))
         :closed (fn [] (.-closed state))}))

(defn serve
  "Handle requests serially after ready resolves. The handler consumes and
   returns BL values; the transport owns conversion and error messages."
  [ready handler]
  (let [queue #js {:tail nil :failure nil}]
    (set! (.-tail queue) (.catch ready (fn [error] (set! (.-failure queue) error))))
    (.addEventListener js/self "message"
      (fn [event]
        (let [data (.-data event)
              work (fn [_]
                     (try
                       (when (.-failure queue) (throw (.-failure queue)))
                       (let [value (handler (js->bl (.-value data) :keywordize-keys true))]
                         (.postMessage js/self #js {:id (.-id data) :value (bl->js value)}))
                       (catch error
                         (.postMessage js/self
                           #js {:id (.-id data) :fatal (boolean (.-failure queue))
                                :error (or (.-message error) (str error))}))))]
          (set! (.-tail queue) (.then (.-tail queue) work)))))))
