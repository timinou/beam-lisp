; Display pacing with a bounded timer fallback for a blocked document/RAF owner.
; The first callback wins; cancelling the opaque handle cancels both clocks.
; Callback dispatch uses the canonical callable ABI and its initialized prelude.
(ns ^:js js.frame (:require [core]))
(defn cancel [handle]
  (when handle
    (.abort handle)
    (when js/cancelAnimationFrame (js/cancelAnimationFrame (.-raf handle)))
    (js/clearTimeout (.-timer handle))))
(defn request [f]
  (let [handle (js/AbortController.)
        finish (fn []
          (when-not (.-aborted (.-signal handle))
            (cancel handle)
            (f (.now js/performance))))]
    (when js/requestAnimationFrame
      (set! (.-raf handle) (js/requestAnimationFrame (fn [_] (finish)))))
    (set! (.-timer handle) (js/setTimeout finish (/ 1000 60)))
    handle))
