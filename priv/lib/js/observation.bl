; Optional browser observations. Resource handles are owned registrations;
; actor lifecycle stays in the actor runtime, never reconstructed here.
(ns ^:js js.observation)
(def state (atom nil))
(defn- identifier []
 (if (and js/globalThis.crypto (.-randomUUID js/globalThis.crypto))
  (.randomUUID js/globalThis.crypto)
  (str (.now js/Date) "-" (.random js/Math))))
(defn- report-row [entry id]
 (try
  (let [row #js {:id id :name (.-name entry) :data ((.-read entry))}]
   (if (<= (.-byteLength (.encode (js/TextEncoder.) (.stringify js/JSON row))) 3072)
    row #js {:id id :name (.-name entry) :error "Observation exceeds resource byte limit"}))
  (catch _ #js {:id id :name (.-name entry) :error "Observation failed"})))
(defn hub
 "Create an isolated observation scope. Limits: 32 resources/peers, 128 KiB
  reports, 6s peer expiry. Observations never grant remote action authority."
 []
 (let [entries (js/Map.) peers (js/Map.)
       s #js {:session (identifier) :sequence 0 :readers 0 :channel nil :lastReply 0}
       snapshot (fn []
         (let [rows #js []]
          (.forEach entries (fn [entry id _] (.push rows (report-row entry id))))
          (set! (.-sequence s) (inc (.-sequence s)))
          #js {:schema "bl.runtime.observation.v1" :target "javascript" :session (.-session s)
               :sequence (.-sequence s) :at (.now js/Date) :resources rows}))
       connect (fn []
        (when (and (nil? (.-channel s)) (not (js/undefined? js/BroadcastChannel)))
         (let [channel (js/BroadcastChannel. "bl.runtime.observations.v1")]
          (set! (.-channel s) channel)
          (set! (.-onmessage channel)
           (fn [event]
            (let [data (.-data event) value (when data (.-value data)) now (.now js/performance)]
             (when (and data (= "request" (.-type data)) (> (- now (.-lastReply s)) 400))
              (set! (.-lastReply s) now)
              (let [value (snapshot)]
               (when (<= (.-byteLength (.encode (js/TextEncoder.) (.stringify js/JSON value))) 131072)
                (.postMessage channel #js {:type "snapshot" :value value}))))
             (when (and data (= "snapshot" (.-type data)) (> (.-readers s) 0) value
                        (= "bl.runtime.observation.v1" (.-schema value))
                        (string? (.-session value)) (<= (.-length (.-session value)) 128)
                        (not= (.-session value) (.-session s))
                        (.isArray js/Array (.-resources value)) (<= (.-length (.-resources value)) 32))
              (try
               (when (and (<= (.-byteLength (.encode (js/TextEncoder.) (.stringify js/JSON value))) 131072)
                          (or (< (.-size peers) 32) (.has peers (.-session value))))
                (.set peers (.-session value) #js {:value value :received now}))
               (catch _ nil)))))))))
       release (fn []
        (when (and (= 0 (.-size entries)) (= 0 (.-readers s)))
         (when (.-channel s) (.close (.-channel s)))
         (set! (.-channel s) nil) (.clear peers)))]
  #js {:register
       (fn [name read actions]
        (when (>= (.-size entries) 32) (throw (js/Error. "Observation resource limit reached")))
        (let [id (str (.-session s) "/" (identifier)) active #js {:value true}]
         (.set entries id #js {:name (.slice (str name) 0 128) :read read :actions actions}) (connect)
         #js {:id id :dispose (fn [] (when (.-value active)
                            (set! (.-value active) false) (.delete entries id) (release)))}))
       :reader
       (fn []
        (when (>= (.-readers s) 32) (throw (js/Error. "Observation reader limit reached")))
        (set! (.-readers s) (inc (.-readers s))) (connect)
        (let [closed #js {:value false}]
         #js {:sample
              (fn []
               (if (.-value closed) #js []
                (let [rows #js [(snapshot)] now (.now js/performance)]
                 (.forEach peers (fn [peer id _]
                  (if (> (- now (.-received peer)) 6000) (.delete peers id)
                   (.push rows (.assign js/Object #js {} (.-value peer) #js {:remote true :received (.-received peer)})))))
                 (when (.-channel s) (.postMessage (.-channel s) #js {:type "request"})) rows)))
              :invoke
              (fn [id action]
               (let [entry (when-not (.-value closed) (.get entries id))
                     f (when entry (aget (.-actions entry) action))]
                (when-not (fn? f) (throw (js/Error. "Action requires a live owned local resource")))
                (f)))
              :dispose
              (fn [] (when-not (.-value closed)
                      (set! (.-value closed) true)
                      (set! (.-readers s) (dec (.-readers s))) (release)))}))}))
(defn- shared [] (or @state (let [value (hub)] (reset! state value) value)))
(defn observe-package [name read actions]
 (let [registration (.register (shared) name read actions)] (.-dispose registration)))
(defn observations [] (.reader (shared)))

(defn subscribe
 "Own a coalescing timer and reader. dispose retracts both. A bounded interval
  and optional active predicate keep hidden/unmounted views from sampling."
 ([notify] (subscribe notify #js {}))
 ([notify options]
  (let [interval (or (.-interval options) 1000)
        active (or (.-active options) (fn [] true))]
   (when-not (and (int? interval) (<= 250 interval 60000))
    (throw (js/Error. "Observation interval must be 250..60000 ms")))
   (let [reader (observations) closed #js {:value false}
         tick (fn [] (when (and (not (.-value closed)) (active)) (notify (.sample reader))))
         timer (js/setInterval tick interval)]
    (js/queueMicrotask tick)
    (fn [] (when-not (.-value closed)
             (set! (.-value closed) true) (js/clearInterval timer) (.dispose reader)))))))
