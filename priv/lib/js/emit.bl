; priv/lib/js/emit.bl — Beam Lisp → JavaScript, the SYNC profile.
;
; One BL namespace becomes one ES module. Every top-level `defn` becomes a JS
; function, every call a JS call, every `loop`/`recur` a labelled `for(;;)`.
; There is no scheduler, no mailbox and no step machine: this profile is for
; code that RUNS TO COMPLETION in response to an event — an editor's command,
; a view, a parser — which is most UI code. (The actor profile in
; research/js-actors keeps the generator machine for code that must be
; preempted; PLAN-161 D2.)
;
; ── Pipeline ──────────────────────────────────────────────────────────────
;
;   source → BeamLisp reader (positioned) → the BEAM compiler → bl-ANF
;          → THIS emitter → JS text → (js.build links names) → ES module
;
; The emitter consumes the SAME canonical bl-ANF the BEAM backend lowers
; (priv/boot/anf.bl). It never re-parses, re-expands or re-desugars.
;
; ── Destinations ─────────────────────────────────────────────────────────
;
; Every node is emitted toward a DESTINATION, the one place its value goes:
;
;   nil                       produce a JS expression (the caller binds it)
;   [:return]                 `return v;`            — function tail
;   [:assign var label]       `var = v; break label;` — a case/if/try arm
;   [:loop res label]         `res = v; break label;` — leaving a loop
;
; Expression-shaped nodes (literals, calls, collections) build a value and
; hand it to `finish`, which delivers it. Statement-shaped nodes (if, case,
; let, do, loop, try) push the SAME destination into their branches. So a
; branch never guesses what its parent wanted: there is exactly one rule, and
; recur — which delivers to no destination at all — is the only exception.
;
; Emission returns {:lines [stmt…] :val expr}; :val is nil iff the value was
; delivered. Temporaries come from a per-module counter (`reset-state!`), so a
; module's text is a pure function of its source.

(ns js.emit
  (:require [system.ir :as ir] [js.pattern :as pattern]))

(defn- codepoints
  "The Unicode codepoints of string `s`, as a list of integers."
  [s]
  (unicode/characters_to_list s))

; ─── names ──────────────────────────────────────────────────────────────────

(def ^:private reserved
  #{"break" "case" "catch" "class" "const" "continue" "debugger" "default" "delete"
    "do" "else" "export" "extends" "finally" "for" "function" "if" "import" "in"
    "instanceof" "new" "return" "super" "switch" "this" "throw" "try" "typeof" "var"
    "void" "while" "with" "yield" "let" "static" "enum" "await" "implements" "package"
    "protected" "interface" "private" "public" "null" "true" "false" "arguments" "eval"})

(defn mangle
  "A legal JS identifier for a BL name, INJECTIVE: two names never share one.
   Letters and digits pass through; `-` becomes `_` and a literal `_` becomes
   `$U`, so `read-string` and `read_string` (both in the reader) stay apart;
   other punctuation becomes a readable `$`-escape (`empty?` → `empty$Q`).
   A reserved word gains `$R` (an escape no character produces), and a
   leading digit gains `$N`; `_` alone never starts a name, so neither
   prefix can collide with a mangled name."
  [s]
  (let [out (apply str
              (map (fn [c]
                     (if (or (and (>= c 97) (<= c 122)) (and (>= c 65) (<= c 90))
                             (and (>= c 48) (<= c 57)))
                       (unicode/characters_to_binary (list c))
                       (cond (= c 45) "_" (= c 95) "$U" (= c 63) "$Q" (= c 33) "$B" (= c 42) "$S"
                             (= c 62) "$G" (= c 60) "$L" (= c 61) "$E" (= c 43) "$P"
                             (= c 47) "$D" (= c 46) "$O" (= c 39) "$T" :else (str "$" c "$"))))
                   (codepoints s)))
        out (if (and (> (count out) 0)
                     (let [c (first (codepoints out))] (and (>= c 48) (<= c 57))))
              (str "$N" out) out)]
    (if (contains? reserved out) (str out "$R") out)))

(defn local-name [n] (str "v_" (mangle n)))

(defn atom-text
  "An atom's whole text. NOT `name`: `name` splits a keyword at its last `/`
   (`(name :=/=)` is \"=\"), right for `:ns/kw` and wrong for a module or
   function atom — `erlang:'=/='`, `erlang:'/='` must keep every character."
  [a]
  (erlang/atom_to_binary a))

(defn js-escape
  "A JS double-quoted string literal body. Every non-ASCII codepoint is passed
   through as itself (the module is UTF-8); control characters are escaped."
  [s]
  (apply str
    (map (fn [c]
           (cond
             (= c 34) "\\\"" (= c 92) "\\\\" (= c 10) "\\n" (= c 13) "\\r" (= c 9) "\\t"
             (= c 8232) "\\u2028" (= c 8233) "\\u2029"
             (< c 32) (str "\\u00" (if (< c 16) "0" "") (lower-case (Integer/to_string c 16)))
             :else (unicode/characters_to_binary (list c))))
         (codepoints s))))

(defn js-str [s] (str "\"" (js-escape s) "\""))

(defn- call-expr
  "A call of an unknown callee `f` with argument expressions `args`: a JS fn
   is called directly, anything else through the `invoke` fallback. 0–3
   arguments take rt.mjs's fixed-arity `R.callN` (no rest array, no spread)."
  [f invoke args]
  (let [n (count args)
        tail (apply str (map (fn [a] (str ", " a)) args))]
    (if (< n 4)
      (str "R.call" n "(" f ", " invoke tail ")")
      (str "R.call(" f ", " invoke tail ")"))))

; ─── emission state (per module) ────────────────────────────────────────────

(def ^:private st-key :js_emit_state)

(defn reset-state! []
  (erlang/put st-key {:n 0 :kws {} :kw-order []}))

(defn- st [] (erlang/get st-key))
(defn- st! [m] (erlang/put st-key m))

(defn- tmp []
  (let [s (st) n (inc (:n s))]
    (st! (assoc s :n n))
    (str "t" n)))

(defn- label [prefix] (str prefix (subs (tmp) 1)))

(defn- kw-ref
  "A module-level const for keyword `k` — interned once per module, so a
   keyword literal in a hot path is a variable read, not a table lookup."
  [k]
  (let [fq (if (some? (namespace k)) (str (namespace k) "/" (name k)) (name k))
        s (st)]
    (if (contains? (:kws s) fq)
      (get (:kws s) fq)
      (let [id (str "K_" (count (:kws s)))]
        (st! (assoc s :kws (assoc (:kws s) fq id) :kw-order (conj (:kw-order s) [id fq])))
        id))))

(defn kw-decls
  "The const declarations for every keyword the module interned, in first-use order."
  []
  (map (fn [[id fq]] (str "const " id " = R.kw(" (js-str fq) ");")) (:kw-order (st))))

; ─── literals ───────────────────────────────────────────────────────────────

(def ^:private safe-max 9007199254740991)

(defn lit-js
  "Canonical literal lowering. A caller supplies only its runtime identifier
   and interned-keyword expression; numeric and collection semantics stay here."
  ([v] (lit-js v {:runtime "R" :keyword kw-ref}))
  ([v opts]
   (let [r (:runtime opts) kw-js (:keyword opts) lit (fn [x] (lit-js x opts))]
    (cond
      (nil? v) "null"
      (= v true) "true"
      (= v false) "false"
      (erlang/is_integer v) (if (and (<= v safe-max) (>= v (- 0 safe-max))) (str v) (str v "n"))
      (erlang/is_float v) (str r ".flt(" (erlang/float_to_binary v (list :short)) ")")
      (= (type v) :Elixir.BeamLisp.Decimal)
        (str r ".dec(" (BeamLisp.Decimal/unscaled v) "n, " (BeamLisp.Decimal/scale v) ")")
      (erlang/is_binary v) (js-str v)
      (keyword? v) (kw-js v)
      (erlang/is_atom v) (kw-js (keyword (erlang/atom_to_binary v)))
      (symbol? v) (str r ".sym(" (js-str (erlang/element 2 v)) ")")
      (vector? v) (str r ".vec(" (join ", " (map lit v)) ")")
      (or (list? v) (seq? v)) (if (empty? v) (str r ".EMPTY") (str r ".list(" (join ", " (map lit v)) ")"))
      (set? v) (str r ".hashSet(" (join ", " (map lit v)) ")")
      (map? v) (str r ".hashMap(" (join ", " (mapcat (fn [[k x]] [(lit k) (lit x)]) v)) ")")
      (erlang/is_tuple v) (str r ".tup([" (join ", " (map lit (erlang/tuple_to_list v))) "])")
      :else (throw (ex-info (str "js.emit: no JS literal for " (pr-str v)) {:value v}))))))

; ─── the context ────────────────────────────────────────────────────────────
;
;   :ns       the namespace being compiled (string)
;   :resolve  (fn [ns name arity?] → js-expr) — the linker's global resolver
;   :remote   (fn [mod fun arity] → js-expr | nil) — the core/host op resolver
;   :dest     where this node's value goes (see Destinations)
;   :loop     {:self "loop_N" :vars [js-names] :label "L3"} inside a loop body
;   :selves   {scaffold-self-name → js function name} for self-calls

(defn- to [ctx dest] (assoc ctx :dest dest))
(defn- expr-ctx [ctx] (assoc ctx :dest nil))

(defn- finish
  "Deliver an expression value to the destination."
  [r ctx]
  (let [d (:dest ctx) v (:val r)]
    (cond
      (nil? d) r
      (nil? v) r
      (= :return (first d)) {:lines (concat (:lines r) (list (str "return " v ";"))) :val nil}
      (= :assign (first d)) {:lines (concat (:lines r) (list (str (nth d 1) " = " v "; break " (nth d 2) ";"))) :val nil}
      (= :loop (first d)) {:lines (concat (:lines r) (list (str (nth d 1) " = " v "; break " (nth d 2) ";"))) :val nil}
      :else (throw (ex-info "js.emit: bad destination" {:dest d})))))

(defn- open-dest
  "For a statement-shaped node in VALUE position (dest nil): make a result
   variable and a label so its branches can deliver, then hand the variable
   back as the value. {:pre [stmts] :dest d :val res :close [stmts]}."
  [ctx]
  (if (nil? (:dest ctx))
    (let [res (tmp) lbl (label "B")]
      {:pre (list (str "let " res ";") (str lbl ": {")) :dest [:assign res lbl] :val res :close (list "}")})
    {:pre (list) :dest (:dest ctx) :val nil :close (list)}))

(declare emit)

(defn- simple-val?
  "A value expression that is safe to reuse without re-evaluation: a local,
   a module const, a number or a string literal."
  [v]
  (and (some? v)
       (nil? (index-of v "("))
       (let [c (first (codepoints v))]
         (or (and (>= c 48) (<= c 57)) (= c 34) (= c 45) (and (>= c 97) (<= c 122)) (= c 75)))))

(defn- emit-all
  "Emit `nodes` as values, in order. Each non-trivial value is bound to a
   temp so evaluation order is source order. {:lines :vals}."
  [nodes ctx]
  (reduce (fn [acc n]
            (let [r (emit n (expr-ctx ctx))]
              (if (simple-val? (:val r))
                {:lines (concat (:lines acc) (:lines r)) :vals (conj (:vals acc) (:val r))}
                (let [t (tmp)]
                  {:lines (concat (:lines acc) (:lines r) (list (str "const " t " = " (:val r) ";")))
                   :vals (conj (:vals acc) t)}))))
          {:lines (list) :vals []}
          nodes))

; ─── calls ──────────────────────────────────────────────────────────────────

(def ^:private rt-mod :Elixir.BeamLisp.Ns.Rt)

(defn- global-js [node ctx arity]
  (let [resolver (if (= :exact (:lookup node)) (:resolve-exact ctx) (:resolve ctx))]
    (when (nil? resolver) (throw (ex-info "exact global resolver required" {:node node})))
    (resolver (:ns node) (:name node) arity)))

(defn- call-js
  "A call expression: `callee(args…)` after the argument statements."
  [callee-js args ctx]
  (finish {:lines (:lines args) :val (str callee-js "(" (join ", " (:vals args)) ")")} ctx))

(defn- call-source [ctx]
  (let [a (:call-source ctx)
        scalar (fn [value] (if (nil? value) "null" (str value)))
        string (fn [value] (if (nil? value) "null" (js-str value)))]
    (str "{file:" (string (:file a)) ",line:" (scalar (:line a)) ",col:" (scalar (:col a))
         ",endLine:" (scalar (:end-line a)) ",endCol:" (scalar (:end-col a))
         ",fn:" (string (:source-fn ctx)) ",arity:" (scalar (:source-arity ctx))
         ",call:" (js-str (if (= [:return] (:dest ctx)) "tail" "direct"))
         ",internal:" (if (and (:file a) (ends-with? (:file a) "/actor/runtime.bl")) "true" "false") "}")))
(defn- call-evidence [ctx]
  (str ", " (call-source ctx) (if (= [:return] (:dest ctx)) ", true" "")))

(defn- call-callable [callee args ctx]
  (if (:actor ctx)
    (finish {:lines (:lines args)
             :val (str "(yield* C.call(" callee ", [" (join ", " (:vals args)) "], " (:invoke ctx) (call-evidence ctx) "))")} ctx)
    (call-js callee args ctx)))

(defn- self-of
  "If `n` is a self-scaffold knot `(s s)` for a known self, its JS name."
  [n ctx]
  (let [selves (or (:selves ctx) {})]
    (cond
      (and (= :var (:op n)) (contains? selves (:name n))) (get selves (:name n))
      (and (= :apply (:op n)) (= :var (:op (:fn n))) (contains? selves (:name (:fn n)))) (get selves (:name (:fn n)))
      :else nil)))

(defn- emit-invoke
  "RT.invoke(f, CONS): the callable ABI. A named global or a self-call
   becomes a direct call; anything else goes through the ONE fallback — rt's
   compiled `call-invoke` (`(:invoke ctx)`), which handles keywords, maps,
   sets and vectors as functions by the language's rule."
  [node ctx]
  (let [cs (ir/call-site node)
        callee (:callee cs)
        self (self-of callee ctx)]
    (cond
      ; a COMPUTED argument list: pass it as ONE list through R.callList
      ; (`R.call*` only spreads a JS fn; anything else is rt's own invoke,
      ; with the argument LIST, exactly the BEAM's Rt.invoke(f, args))
      (contains? cs :rest)
        (let [all (emit-all (cons callee (:args cs)) ctx)
              vals (:vals all)
              heads (butlast (rest vals))]
          (finish {:lines (:lines all)
                   :val (str (if (:actor ctx) "(yield* C.callList(" "R.callList(") (first vals) ", R.listStar([" (join ", " heads) "], " (last vals) "), " (:invoke ctx) (if (:actor ctx) (str (call-evidence ctx) "))") ")"))}
                  ctx))
      (= :global (:op callee)) (call-callable (global-js callee ctx (count (:args cs))) (emit-all (:args cs) ctx) ctx)
      (some? self) (call-callable self (emit-all (:args cs) ctx) ctx)
      :else
        (let [all (emit-all (cons callee (:args cs)) ctx)
              [f & args] (:vals all)]
          (finish {:lines (:lines all)
                   :val (if (:actor ctx) (str "(yield* C.call(" f ", [" (join ", " args) "], " (:invoke ctx) (call-evidence ctx) "))") (call-expr f (:invoke ctx) args))}
                  ctx)))))

; ─── BIF intrinsics ─────────────────────────────────────────────────────────
; A pure Erlang BIF the runtime calls in its hottest loops (rt.bl walks lists
; and tuples with hd/tl/element on every step) is emitted INLINE — a JS
; expression over rt.mjs — not as a leaf-table property call. Same semantics as
; the leaf, badarg included (rt.mjs hd/tl/element/tupleSize raise exactly as
; leaves.mjs did). {[mod fun arity] (fn [arg-js…] → js)}.
(def ^:private intrinsics
  {[:erlang :hd 1] (fn [[x]] (str "R.hd(" x ")"))
   [:erlang :tl 1] (fn [[x]] (str "R.tl(" x ")"))
   [:erlang :element 2] (fn [[i t]] (str "R.element(" i ", " t ")"))
   [:erlang :tuple_size 1] (fn [[t]] (str "R.tupleSize(" t ")"))
   [:erlang :is_list 1] (fn [[x]] (str "R.isList(" x ")"))
   [:erlang :is_tuple 1] (fn [[x]] (str "(" x " instanceof R.Tup)"))
   [:erlang :is_atom 1] (fn [[x]] (str "R.isAtom(" x ")"))
   [:erlang :is_boolean 1] (fn [[x]] (str "R.isBool(" x ")"))
   [:erlang :is_map 1] (fn [[x]] (str "R.isMapI(" x ")"))
   [:erlang :is_map_key 2] (fn [[k m]] (str "R.hasKeyI(" k ", " m ")"))
   [:erlang :map_get 2] (fn [[k m]] (str "R.mapGetI(" k ", " m ")"))
   [:maps :get 3] (fn [[k m d]] (str "R.mapsGet3I(" k ", " m ", " d ")"))
   [:erlang :is_number 1] (fn [[x]] (str "R.isNumber(" x ")"))
   [:erlang :is_float 1] (fn [[x]] (str "(" x " instanceof R.Flt)"))
   [:erlang :length 1] (fn [[x]] (str "R.length(" x ")"))
   ; `erlang:apply(F, Args)` with a FUN F (rt's dispatch after classifying)
   [:erlang :apply 2] (fn [[f args]] (str "R.applyList(" f ", " args ")"))
   [:erlang :is_binary 1] (fn [[x]] (str "(typeof " x " === \"string\")"))
   [:erlang :is_integer 1] (fn [[x]] (str "R.isInt(" x ")"))
   [:erlang :is_function 1] (fn [[x]] (str "(typeof " x " === \"function\")"))
   [:erlang :is_function 2] (fn [[x n]] (str "R.isFnN(" x ", " n ")"))
   [:erlang :< 2] (fn [[a b]] (str "R.ltI(" a ", " b ")"))
   [:erlang :> 2] (fn [[a b]] (str "R.gtI(" a ", " b ")"))
   [:erlang :=< 2] (fn [[a b]] (str "R.leI(" a ", " b ")"))
   [:erlang :>= 2] (fn [[a b]] (str "R.geI(" a ", " b ")"))
   [:erlang :+ 2] (fn [[a b]] (str "R.addI(" a ", " b ")"))
   [:erlang :- 2] (fn [[a b]] (str "R.subI(" a ", " b ")"))
   [:erlang :list_to_tuple 1] (fn [[l]] (str "R.listToTupleI(" l ")"))
   [:lists :reverse 1] (fn [[l]] (str "R.reverseI(" l ")"))
   [:lists :reverse 2] (fn [[l t]] (str "R.reverseI(" l ", " t ")"))
   [:erlang :== 2] (fn [[a b]] (str "R.erlEq(" a ", " b ")"))
   [:erlang :/= 2] (fn [[a b]] (str "!R.erlEq(" a ", " b ")"))
   [:erlang :=:= 2] (fn [[a b]] (str "R.keyEq(" a ", " b ")"))
   [:erlang :=/= 2] (fn [[a b]] (str "!R.keyEq(" a ", " b ")"))})

(defn- intrinsic-js
  "The inline JS for remote [m f] over argument expressions `vals`, or nil."
  [m f vals]
  (let [g (get intrinsics [m f (count vals)])]
    (when (some? g) (g vals))))

(defn- atom-lit?
  "A literal atom node (keyword, nil, true/false) — interned on JS, so Erlang
   `==`/`=:=` against it IS identity (an atom equals only itself)."
  [n]
  (and (= :lit (:op n)) (let [v (:val n)] (or (nil? v) (boolean? v) (keyword? v)))))

(defn- identity-lit?
  "A literal whose only equal is itself on JS: an atom, or the empty list."
  [n]
  (or (atom-lit? n)
      (= :enil (:op n))
      (and (= :lit (:op n)) (let [v (:val n)] (and (or (list? v) (seq? v)) (empty? v))))))

(defn- static-arg-list
  "The argument nodes of an ANF list built from a fixed number of conses —
   `(raw-cons a (raw-cons b ()))`, a `(list a b)` remote, or the literal `()` —
   or nil when its length is not known at compile time."
  [n]
  (cond
    (= :enil (:op n)) []
    (and (= :lit (:op n)) (= () (:val n))) []
    (and (= :remote (:op n)) (= 2 (count (:args n)))
         (or (and (= rt-mod (:mod n)) (= :raw-cons (:fun n)))))
      (let [tail (static-arg-list (second (:args n)))]
        (when (some? tail) (vec (cons (first (:args n)) tail))))
    :else nil))

(declare emit-remote)

(defn- emit-remote [node ctx]
  (let [m (:mod node) f (:fun node) args (:args node)]
    (cond
      ; `(erlang/== kd :nil)` — rt.bl's classifier chains are hundreds of these
      ; per comparison: identity, no call
      ; the empty list is the one frozen `R.EMPTY`, so `(erlang/== xs ())` is
      ; identity too
      (and (= m :erlang) (contains? #{:== :=:= :/= :=/=} f) (= 2 (count args))
           (or (identity-lit? (first args)) (identity-lit? (second args))))
        (let [all (emit-all args ctx)
              [a b] (:vals all)
              op (if (contains? #{:== :=:=} f) " === " " !== ")]
          (finish {:lines (:lines all) :val (str "(" a op b ")")} ctx))
      (and (:actor ctx) (= m :erlang) (= f :apply) (= 2 (count args)))
        (let [all (emit-all args ctx) [fv av] (:vals all)]
          (finish {:lines (:lines all) :val (str "(yield* C.callList(" fv ", " av ", " (:invoke ctx) (call-evidence ctx) "))")} ctx))
      (some? (get intrinsics [m f (count args)]))
        (let [all (emit-all args ctx)]
          (finish {:lines (:lines all) :val (intrinsic-js m f (:vals all))} ctx))
      ; `(erlang/apply :lists :reverse (raw-cons xs ()))`: a LITERAL module and
      ; function with a literal-length argument list is a static call — link
      ; it now (the same resolver a direct `lists/reverse` call uses) instead
      ; of resolving `mod/fun/arity` per call at run time
      (and (= m :erlang) (= f :apply) (= 3 (count args))
           (atom-lit? (first args)) (atom-lit? (second args))
           (some? (static-arg-list (nth args 2))))
        (emit-remote {:op :remote :mod (:val (first args)) :fun (:val (second args))
                      :args (static-arg-list (nth args 2)) :ann (:ann node)} ctx)
      ; `(invocable? self n)`: the compiler's local-vs-linked-global guard on a
      ; self-call. The self is the JS function being emitted, whose arities
      ; are known (`:self-arities`: one fn's arity, or a dispatcher's arms),
      ; so the guard is decided here rather than asked per call
      (and (= m rt-mod) (= f :invocable?) (= 2 (count args))
           (some? (self-of (first args) ctx))
           (= :lit (:op (second args)))
           (contains? (or (:self-arities ctx) #{}) (:val (second args)))
           (= (self-of (first args) ctx) (:self-js ctx)))
        (finish {:lines (list) :val "true"} ctx)
      (and (= m rt-mod) (= f :invoke)) (emit-invoke node ctx)
      ; `(apply f seq)`: spread the seq with rt's `seq-to-args`, then call
      ; through the ONE fallback ABI (compiled rt's `call-invoke`)
      (and (= m rt-mod) (= f :apply_to) (some? (:seq-to-args ctx)))
        (let [all (emit-all args ctx) [fv lst] (:vals all)]
          (finish {:lines (:lines all) :val (if (:actor ctx)
            (str "(yield* C.callList(" fv ", (yield* C.call(" (:seq-to-args ctx) ", [" lst "], " (:invoke ctx) ")), " (:invoke ctx) (call-evidence ctx) "))")
            (str "R.callList(" fv ", " (:seq-to-args ctx) "(" lst "), " (:invoke ctx) ")"))} ctx))
      :else
        (let [target ((:remote ctx) m f (count args))]
          (if (nil? target)
            (throw (ex-info (str "js.emit: " (:ns ctx) ": no JS implementation for "
                                 m "/" (atom-text f) "/" (count args)
                                 (let [a (:ann node)] (if (some? (get a :line)) (str " at line " (get a :line)) "")))
                            {:mod m :fun f :arity (count args)}))
            ; the callee is a compiled BL function or a BEAM-shaped leaf, and
            ; BOTH take their rest args as ONE trailing list, exactly as on the
            ; BEAM (the compiler already packed it) — nothing is spread
            (call-callable target (emit-all args ctx) ctx))))))

(defn set-rest-fns!
  "Declare #{[mod-name fname arity]} — the core link table's variadic
   functions at their rest-list arity — for this emit process. The static
   emitter passes the rest list through unchanged; the declaration is kept so
   the eval/boot path (js.eval set-rest-fns!) shares the ONE rule, exported as
   core-links.mjs REST_FNS."
  [s]
  (erlang/put :js_emit_rest_fns s))

(def ^:private arith-js
  {:add "R.add" :sub "R.sub" :mul "R.mul" :div "R.div"
   :lt "R.lt" :gt "R.gt" :le "R.le" :ge "R.ge" :num_eq "R.numEq"})

(defn- emit-arith [node ctx]
  (let [f (get arith-js (:fun node))]
    (when (nil? f) (throw (ex-info (str "js.emit: unknown arith op " (:fun node)) {:node node})))
    (call-js f (emit-all (:args node) ctx) ctx)))

(defn- emit-apply
  "A native :apply. The scaffold knot `(s s)` IS the function `s` names; a
   call of it with args is a direct self-call."
  [node ctx]
  (let [f (:fn node) args (:args node)
        selves (or (:selves ctx) {})]
    (cond
      ; (apply (var s) [(var s)]) — the knot itself: the function value
      (and (= :var (:op f)) (contains? selves (:name f)) (= 1 (count args))
           (= :var (:op (first args))) (= (:name f) (:name (first args))))
        (finish {:lines (list) :val (get selves (:name f))} ctx)
      (some? (self-of f ctx)) (call-callable (self-of f ctx) (emit-all args ctx) ctx)
      :else
        (let [all (emit-all (cons f args) ctx) [fv & avs] (:vals all)]
          (finish {:lines (:lines all) :val (if (:actor ctx) (str "(yield* C.call(" fv ", [" (join ", " avs) "], " (:invoke ctx) (call-evidence ctx) "))") (call-expr fv (:invoke ctx) avs))} ctx)))))

; ─── patterns ───────────────────────────────────────────────────────────────

(defn- pattern-lines [p v lbl]
  (pattern/lines p v lbl {:runtime "R" :temporary tmp :local local-name
                          :literal lit-js :string js-str}))

(defn- guard-lines [guard label]
  (when guard
    (concat ["try{"] (:lines guard)
      [(str "if(!R.truthy(" (:val guard) "))break " label ";")
       (str "}catch(_guardError){break " label ";}")])))

(defn- clause-lines
  "One clause: pattern tests, guard, body delivered to ctx's destination.
   Falls through (to the next clause) on a mismatch."
  [cl vals ctx]
  (let [lbl (label "C")
        pats (:pats cl)
        binds (mapcat (fn [i] (pattern-lines (nth pats i) (nth vals i) lbl)) (range (count pats)))
        g (if (nil? (:guard cl)) nil (emit (:guard cl) (assoc (expr-ctx ctx) :actor false)))
        body (emit (:body cl) ctx)]
    (concat (list (str lbl ": {"))
            binds
            (guard-lines g lbl)
            (:lines body)
            (list "}"))))

; ─── functions ──────────────────────────────────────────────────────────────
;
; The BEAM compiler emits every fn through the self-application scaffold
;   (let s (fn [s] INNER) (s s))
; so INNER can call itself through `s`. Here INNER becomes a NAMED JS function
; and `s` names it: `(s s)` is the function itself, and a call of `(s s)` with
; arguments is a direct self-call.

(defn- fn-js
  "A JS function expression for a :fn node of one arity. `self` is the
   scaffold's self name; inside one arity of a multi-arity fn the self name
   reaches the whole fn (`:self-target`, the dispatcher)."
  [fnode self jsname ctx]
  (let [cls (:clauses fnode)
        arity (count (:pats (first cls)))
        params (vec (map (fn [i] (str "a" i)) (range arity)))
        target (or (:self-target ctx) jsname)
        ctx2 (assoc ctx :source-fn (:fn-label ctx) :source-arity arity :fn-label nil
                    :actor (:actor-profile ctx) :dest [:return] :loop nil :self-target nil
                    :self-arities (if (some? (:self-target ctx)) (:self-arities ctx) #{arity})
                    :self-js target
                    :selves (if (nil? self) (:selves ctx) (assoc (or (:selves ctx) {}) self target)))
        body (concat (mapcat (fn [cl] (clause-lines cl params ctx2)) cls)
                     (list (str "throw new R.BLError(\"no matching clause for " (js-escape (or (:fn-label ctx) jsname))
                                " with \" + [" (join ", " (map (fn [p] (str "R.printStr(" p ")")) params)) "].join(\" \"));")))]
    (if (:actor-profile ctx)
      (str "(()=>{const " jsname " = C.fn(" (js-str (or (:fn-label ctx) jsname)) ", " arity
           ", function*(rt, args){" (join "" (map (fn [i] (str "const " (nth params i) "=args[" i "];")) (range arity)))
           (join "\n" body) "});return " jsname ";})()")
      (str "function " jsname "(" (join ", " params) ") {\n" (join "\n" body) "\n}"))))

(defn- fn-value
  "A bare fn value (a scaffold or a raw :fn): {:lines :val} where :val names
   or IS the function."
  [node ctx]
  (cond
    (ir/self-scaffold? node)
      (let [self (:name node)
            jsname (str "f_" (mangle self))]
        {:lines (list) :val (str "(" (fn-js (ir/scaffold-inner node) self jsname ctx) ")")})
    (= :fn (:op node))
      {:lines (list) :val (str "(" (fn-js node nil (label "anon") ctx) ")")}
    :else (throw (ex-info "js.emit: not a fn" {:node node}))))


(defn- emit-blfn
  "A multi-arity / variadic fn: one JS function dispatching on arguments.length.
   The variadic slot receives the extra args as a BL list, nil when there are
   none (Clojure's `& rest`)."
  [node ctx]
  (let [[_ fixed variadic] (:elems node)
        nm (label "multi")
        ; the dispatcher's own arities: `(invocable? self n)` on it is decided
        ; when n has an arm (a variadic arm answers any n ≥ its minimum; the
        ; dispatcher is a 0-length JS fn, which `is_function/2` accepts too)
        actx (assoc ctx :self-target nm :dest nil
                    :self-arities (set (map (fn [pr] (:val (first pr))) (:pairs fixed))))
        arms (map (fn [pr] [(:val (first pr)) (fn-value (second pr) actx)]) (:pairs fixed))
        v (if (and (some? variadic) (= :tuple (:op variadic)))
            (let [[mn f] (:elems variadic)] [(:val mn) (fn-value f actx)])
            nil)
        lines (concat
                (map (fn [[n r]] (str "const " nm "_" n " = " (:val r) ";")) arms)
                (if (nil? v) (list) (list (str "const " nm "_v = " (:val (second v)) ";"))))
        dispatch (str "function " nm "(...args) {\n"
                      (join "\n" (map (fn [[n _]] (str "if (args.length === " n ") return " nm "_" n "(...args);")) arms))
                      "\n"
                      (if (nil? v) ""
                        (str "if (args.length >= " (first v) ") return " nm "_v(...args.slice(0, " (first v) "), args.length > " (first v) " ? R.listFromArray(args, " (first v) ") : R.EMPTY);\n"))
                      "throw new R.BLError(\"wrong number of args (\" + args.length + \")\");\n}")]
    ; the variadic clause rides on the dispatcher as `.v`: a BEAM-ABI caller
    ; (`ns/f__bl_v`, the rest args already ONE list) calls it directly
    (finish {:lines (concat lines
              (if (:actor-profile ctx)
                [(str "const " nm " = C.multi(" (js-str nm) ", new Map(["
                  (join "," (map (fn [[n _]] (str "[" n "," nm "_" n "]")) arms)) "]), "
                  (if v (str (first v) ", " nm "_v") "null, null") ");")]
                (concat [dispatch] (if (nil? v) [] [(str nm ".v = " nm "_v;")]))))
             :val nm} ctx)))

; ─── loops ──────────────────────────────────────────────────────────────────

(defn- emit-loop
  "(apply SCAFFOLD inits): `for(;;)` with the loop vars as `let`s. A recur
   reassigns them (parallel assignment) and continues; any other value leaves
   the loop toward the loop's own destination. In a function tail the body
   simply returns; in value position it stores and breaks."
  [node ctx]
  (let [{:keys [self vars body inits]} (ir/loop-parts node)
        r (emit-all inits ctx)
        lbl (label "L")
        jsvars (vec (map local-name vars))
        o (if (= :return (first (:dest ctx)))
            {:pre (list) :dest [:return] :val nil :close (list)}
            (let [res (tmp)] {:pre (list (str "let " res ";")) :dest [:loop res lbl] :val res :close (list)}))
        lctx (assoc ctx :loop {:self self :vars jsvars :label lbl} :dest (:dest o))
        b (emit body lctx)
        deliver-out (if (or (nil? (:dest ctx)) (= :return (first (:dest ctx)))) nil (:dest ctx))]
    {:lines (concat (:lines r)
                    (map (fn [i] (str "let " (nth jsvars i) " = " (nth (:vals r) i) ";")) (range (count jsvars)))
                    (:pre o)
                    (list (str lbl ": for (;;) {"))
                    (if (:actor ctx) ["yield null;"] [])
                    (:lines b)
                    (list "}")
                    (if (some? deliver-out) (:lines (finish {:lines (list) :val (:val o)} ctx)) (list)))
     :val (if (some? deliver-out) nil (:val o))}))

(defn- emit-recur [node ctx]
  (let [lp (:loop ctx)]
    (when (nil? lp) (throw (ex-info "js.emit: recur outside a loop" {:node node})))
    (let [r (emit-all (ir/recur-vals node) ctx)
          ts (map (fn [_] (tmp)) (:vars lp))]
      {:lines (concat (:lines r)
                      (map (fn [t v] (str "const " t " = " v ";")) ts (:vals r))
                      (map (fn [var t] (str var " = " t ";")) (:vars lp) ts)
                      (list (str "continue " (:label lp) ";")))
       :val nil})))

; ─── control ────────────────────────────────────────────────────────────────

(defn- emit-let [node ctx]
  (if (ir/self-scaffold? node)
    (finish (fn-value node ctx) ctx)
    (let [init (emit (:init node) (expr-ctx ctx))
          body (emit (:body node) ctx)]
      {:lines (concat (:lines init) (list (str "const " (local-name (:name node)) " = " (:val init) ";")) (:lines body))
       :val (:val body)})))

(defn- emit-if [node ctx]
  (let [t (emit (:test node) (expr-ctx ctx))]
    (if (nil? (:dest ctx))
      ; value position: a ternary when both arms are pure expressions
      (let [th (emit (:then node) ctx) el (emit (:else node) ctx)]
        (if (and (empty? (:lines th)) (empty? (:lines el)))
          {:lines (:lines t) :val (str "(R.truthy(" (:val t) ") ? " (:val th) " : " (:val el) ")")}
          (let [o (open-dest ctx)
                c2 (to ctx (:dest o))
                th (emit (:then node) c2) el (emit (:else node) c2)]
            {:lines (concat (:lines t) (:pre o)
                            (list (str "if (R.truthy(" (:val t) ")) {")) (:lines th) (list "} else {") (:lines el) (list "}")
                            (:close o))
             :val (:val o)})))
      (let [th (emit (:then node) ctx) el (emit (:else node) ctx)]
        {:lines (concat (:lines t)
                        (list (str "if (R.truthy(" (:val t) ")) {")) (:lines th) (list "} else {") (:lines el) (list "}"))
         :val nil}))))

(defn- emit-do [node ctx]
  (let [stmts (:stmts node) n (count stmts)
        pre (reduce (fn [acc s]
                      (let [r (emit s (expr-ctx ctx))]
                        (concat acc (:lines r) (if (or (nil? (:val r)) (simple-val? (:val r))) (list) (list (str (:val r) ";"))))))
                    (list) (take (dec n) stmts))
        last-r (emit (last stmts) ctx)]
    {:lines (concat pre (:lines last-r)) :val (:val last-r)}))

(defn- emit-case [node ctx]
  (let [s (emit (:subj node) (expr-ctx ctx))
        sv (tmp)
        o (open-dest ctx)
        arms (mapcat (fn [cl] (clause-lines cl [sv] (to ctx (:dest o)))) (:clauses node))]
    {:lines (concat (:lines s) (list (str "const " sv " = " (:val s) ";"))
                    (:pre o)
                    arms
                    (list (str "throw new R.BLError(\"no case clause matched \" + R.printStr(" sv "));"))
                    (:close o))
     :val (:val o)}))

(defn- emit-try
  "A JS try/catch/finally. The protected body and the catch arms deliver to a
   result variable (never `return` from inside `try`: a `finally` must still
   run, and JS would run it — but a uniform shape keeps the emitter simple);
   the try's value then goes to the destination."
  [node ctx]
  (let [res (tmp)
        done (label "T")
        dest [:assign res done]
        b (emit (:body node) (to ctx dest))
        catches (:catch node)
        cv (tmp)
        arms (mapcat (fn [c] (clause-lines c (if (:actor ctx) [(str "C.exceptionKind(" cv ")") (str "C.exceptionValue(" cv ")")] ["A.K_error" cv]) (to ctx dest))) catches)
        af (if (nil? (:after node)) nil (emit (:after node) (expr-ctx ctx)))]
    (finish
      {:lines (concat (list (str "let " res ";") "try {" (str done ": {"))
                      (:lines b)
                      (list "}")
                      (if (empty? catches) (list)
                        (concat (list (str "} catch (" cv ") {")
                                      (str "const " (local-name "__STACKTRACE__") " = " (if (:actor ctx) (str "C.exceptionTrace(" cv ")") "null") ";")
                                      (str "const " (local-name "__STACKTRACE_RAW__") " = " (local-name "__STACKTRACE__") ";")
                                      (str done ": {"))
                                arms
                                (list (str "throw " cv ";") "}")))
                      (if (nil? af) (list) (concat (list "} finally {") (:lines af)
                                                   (if (or (nil? (:val af)) (simple-val? (:val af))) (list) (list (str (:val af) ";")))))
                      (list "}"))
       :val res}
      ctx)))

(defn- emit-js-args [nodes ctx]
  ; Snapshot even globals and locals: later arguments can mutate their values.
  (reduce (fn [acc n]
            (let [r (emit n (expr-ctx ctx)) t (tmp)]
              {:lines (concat (:lines acc) (:lines r) (list (str "const " t " = " (:val r) ";")))
               :vals (conj (:vals acc) t)}))
          {:lines (list) :vals []} nodes))

(defn emit-native
  "Native ANF expressions shared by sync and actor profiles. The caller supplies
   argument emission and fresh names; JS evaluation order stays in one emitter."
  [node ctx]
  (let [emit-js-args (or (:native-args ctx) emit-js-args)
        tmp (or (:native-tmp ctx) tmp)
        argument (or (:native-argument ctx) (fn [v node] (str "J.argument(" v ")")))
        result (or (:native-result ctx) (fn [v] (str "J.result(" v ")")))
        kind (:kind node) args (:args node) property (:property node)
        path (when (:path node)
               (str "globalThis" (join "" (map (fn [p] (str "[" (js-str p) "]")) (split (:path node) ".")))))
        ; Capture callees before argument side effects, preserving JS order.
        recv (when (= kind :method) (emit-js-args (list (first args)) ctx))
        call-receiver (when (= kind :call) (tmp))
        path-parts (when (:path node) (split (:path node) "."))
        receiver-path (when (= kind :call)
                        (str "globalThis" (join "" (map (fn [p] (str "[" (js-str p) "]")) (butlast path-parts)))))
        callee (when (contains? #{:method :call :new} kind) (tmp))
        prefix (cond
                 (= kind :method) (concat (:lines recv) (list (str "const " callee " = " (argument (first (:vals recv)) (first args)) "[" (js-str property) "];")))
                 (= kind :call) (list (str "const " call-receiver " = " receiver-path ";")
                                         (str "const " callee " = " call-receiver "[" (js-str (last path-parts)) "];"))
                 (= kind :new) (list (str "const " callee " = " path ";"))
                 :else (list))
        assignment-prefix (when (= kind :set) (emit-js-args (butlast args) ctx))
        assignment-key (when (and (= kind :set) (nil? property)) (tmp))
        assignment-lines (when (= kind :set)
                           (concat (:lines assignment-prefix)
                             (when assignment-key
                               (list (str "const " assignment-key " = J.propertyKey(" (second (:vals assignment-prefix)) ");")))))
        all (emit-js-args (cond (= kind :method) (rest args)
                                (= kind :set) (list (last args)) :else args) ctx)
        vs (:vals all)
        value-nodes (cond (= kind :method) (rest args)
                          (= kind :set) (list (last args)) :else args)
        argv (join ", " (map (fn [v n] (argument v n)) vs value-nodes))
        raw (cond
              (= kind :helper) (if (= "bl->js" (:helper node)) "J.convertToJS" "J.convertToBL")
              (= kind :global) path
              (= kind :new) (str "new " callee "(" argv ")")
              (= kind :call) (str "Reflect.apply(" callee ", " call-receiver ", [" argv "])")
              (= kind :method) (str "Reflect.apply(" callee ", " (argument (first (:vals recv)) (first args)) ", [" argv "])")
              (= kind :get) (str (argument (first vs) (first args)) "[" (js-str property) "]")
              (= kind :index) (str (argument (first vs) (first args)) "[" (argument (second vs) (second args)) "]")
              (= kind :set) (str "(" (argument (first (:vals assignment-prefix)) (first args)) "["
                                (if property (js-str property) assignment-key)
                                "] = " (argument (last vs) (last args)) ")")
              (= kind :array) (str "[" argv "]")
              (= kind :object) (str "({" (join ", " (map (fn [k v n] (str "[" (js-str k) "]: " (argument v n))) (:keys node) vs args)) "})")
              (= kind :to-js) (str "J.blToJS(" (first vs) ")")
              (= kind :to-bl) (str "J.jsToBL(" (join ", " vs) ")")
              (= kind :undefined?) (str "(" (first vs) " === undefined)")
              :else (throw (ex-info "unknown native JS operation" {:node node})))]
    (finish {:lines (concat prefix assignment-lines (:lines all)) :val (if (= kind :helper) raw (result raw))} ctx)))

(defn- emit-coll [node ctx]
  (let [op (:op node)]
    (cond
      (= op :tuple)
        (if (ir/blfn-value? node) (emit-blfn node ctx)
          (let [r (emit-all (:elems node) ctx)] (finish {:lines (:lines r) :val (str "R.tup([" (join ", " (:vals r)) "])")} ctx)))
      (= op :map)
        (call-js "R.hashMap" (emit-all (mapcat (fn [p] [(first p) (second p)]) (:pairs node)) ctx) ctx)
      (= op :cons)
        (let [items (ir/cons-args node)
              tail (loop [n node] (if (= :cons (:op n)) (recur (:tail n)) n))]
          (if (= :enil (:op tail))
            (call-js "R.list" (emit-all items ctx) ctx)
            (call-js "R.cons" (emit-all (list (:head node) (:tail node)) ctx) ctx)))
      (= op :enil) (finish {:lines (list) :val "R.EMPTY"} ctx)
      (= op :struct)
        (if (= :Elixir.BeamLisp.Vector (:mod node))
          (call-js "R.vec" (emit-all (:elems (second (first (:fields node)))) ctx) ctx)
          (throw (ex-info (str "js.emit: struct " (:mod node) " is not in the sync profile") {:node node}))))))

; Selection returns only a branch index and its bindings. Execute the body in
; the receiving generator, so recur and try/finally retain their lexical scope.
(defn- emit-receive [node ctx]
  (when-not (and (:actor ctx) (:receive ctx))
    (throw (ex-info "receive requires an actor function and the canonical kernel" {:node node})))
  (let [message (tmp) scan (tmp) selected (tmp)
        timeout (if (:timeout node) (emit (:timeout node) (expr-ctx ctx)) {:lines [] :val "null"})
        o (open-dest ctx) branch-ctx (to ctx (:dest o))
        clauses (vec (:clauses node))
        scan-lines (mapcat (fn [index]
          (let [cl (nth clauses index) lbl (label "Receive")
                bindings (vec (filter (fn [name] (not= name "_")) (distinct (ir/clause-pattern-vars cl))))
                guard (when (:guard cl) (emit (:guard cl) (assoc ctx :dest nil :actor false)))]
            (concat [(str lbl ":{")]
              (mapcat (fn [p] (pattern-lines p message lbl)) (:pats cl))
              (guard-lines guard lbl)
              [(str "return R.vec(R.kw(\"match\"), " index ", R.vec(" (join "," (map local-name bindings)) "));") "}"])))
          (range (count clauses)))
        bodies (mapcat (fn [index]
          (let [cl (nth clauses index) bindings (vec (filter (fn [name] (not= name "_")) (distinct (ir/clause-pattern-vars cl))))]
            (concat [(str "case " index ":{")]
              (map-indexed (fn [i name] (str "const " (local-name name) "=" selected ".nth(2).nth(" i ");")) bindings)
              (:lines (emit (:body cl) branch-ctx)) ["break;} "]))) (range (count clauses)))
        after (if (:after node) (emit (:after node) branch-ctx)
                  {:lines ["throw new R.BLError('receive selected an absent timeout');"]})]
    {:lines (concat (:lines timeout) (:pre o)
      [(str "const " scan " = C.fn(\"receive-scan\", 1, function*(rt,args){const " message "=args[0];")]
      scan-lines ["return R.kw(\"nomatch\");});"
       (str "const " selected " = yield* C.call(" (:receive ctx) ", [" scan ", null, " (:val timeout) "], " (:invoke ctx) ", " (call-source ctx) ");")
       (str "if(" selected ".nth(0)===R.kw(\"timeout\")){")]
      (:lines after) [(str "}else{switch(" selected ".nth(1)){")] bodies ["}}"] (:close o))
     :val (:val o)}))

; ─── the dispatcher ─────────────────────────────────────────────────────────

(defn emit
  "Emit one bl-ANF node toward `(:dest ctx)`. {:lines [js-stmt…] :val expr|nil};
   :val is nil exactly when the value was delivered to a destination."
  [node ctx]
  (let [op (:op node) ctx (assoc ctx :call-source (:ann node))]
    (cond
      (= op :lit) (finish {:lines (list) :val (lit-js (:val node))} ctx)
      (= op :var)
        (finish {:lines (list) :val (let [selves (or (:selves ctx) {})]
                                      (if (contains? selves (:name node)) (get selves (:name node)) (local-name (:name node))))}
                ctx)
      (= op :global) (finish {:lines (list) :val (global-js node ctx nil)} ctx)
      (= op :js) (emit-native node ctx)
      (= op :remote) (emit-remote node ctx)
      (= op :arith) (emit-arith node ctx)
      (ir/anf-loop? node) (emit-loop node ctx)
      (and (= op :apply) (some? (:loop ctx)) (ir/recur? node (:self (:loop ctx)))) (emit-recur node ctx)
      (= op :apply) (emit-apply node ctx)
      (= op :let) (emit-let node ctx)
      (= op :if) (emit-if node ctx)
      (= op :do) (emit-do node ctx)
      (= op :case) (emit-case node ctx)
      (= op :fn) (finish (fn-value node ctx) ctx)
      (= op :try) (emit-try node ctx)
      (= op :recv) (emit-receive node ctx)
      (contains? #{:tuple :map :cons :enil :struct} op) (emit-coll node ctx)
      :else (throw (ex-info (str "js.emit: unknown ANF op " op) {:node node})))))
