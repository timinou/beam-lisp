; Text-binary primitives needed by the BL compiler, lowered through native JS.
; Offsets and lengths are UTF-8 bytes, never UTF-16 string positions.
(ns ^:js js.binary)
(def encoder (js/TextEncoder.))
(def decoder (js/TextDecoder. "utf-8" #js {:fatal true}))
(defn- invalid [] (throw "badarg: invalid text binary operation"))
(defn- bytes [text]
 (when-not (string? text) (invalid))
 (.encode encoder text))
(defn at [text offset]
 (let [data (bytes text)]
  (when-not (and (.isSafeInteger js/Number offset) (<= 0 offset) (< offset (.-length data))) (invalid))
  (aget data offset)))
(defn part [text start length]
 (let [data (bytes text) begin (if (< length 0) (+ start length) start)
       end (if (< length 0) start (+ start length))]
  (when-not (and (.isSafeInteger js/Number start) (.isSafeInteger js/Number length)
                (<= 0 begin end (.-length data))) (invalid))
  ; Arbitrary non-UTF8 binaries are outside the JS value model. Refuse a split
  ; codepoint rather than silently replacing bytes and returning false text.
  (.decode decoder (.subarray data begin end))))
(defn- equal-at? [data pattern start]
 (loop [i 0]
  (cond (= i (.-length pattern)) true
        (= (aget data (+ start i)) (aget pattern i)) (recur (inc i))
        :else false)))
(defn- find-pattern [data pattern offset]
 (loop [start (.indexOf data (aget pattern 0) offset)]
  (cond (< start 0) nil
        (> (+ start (.-length pattern)) (.-length data)) nil
        (equal-at? data pattern start) (tuple start (.-length pattern))
        :else (recur (.indexOf data (aget pattern 0) (inc start))))))
(defn- patterns [pattern]
 (let [values (cond (string? pattern) [pattern] (list? pattern) pattern :else (invalid))]
  (when (empty? values) (invalid))
  (mapv (fn [value] (let [data (bytes value)] (when (= 0 (.-length data)) (invalid)) data)) values)))
(defn- first-match [data needles offset]
 (reduce (fn [best pattern]
   (let [found (find-pattern data pattern offset)]
    (if (and found (or (nil? best) (< (elem found 0) (elem best 0))
                      (and (= (elem found 0) (elem best 0)) (> (elem found 1) (elem best 1)))))
      found best))) nil needles))
(defn match [text pattern]
 (or (first-match (bytes text) (patterns pattern) 0) :nomatch))
(defn matches [text pattern]
 (let [data (bytes text) needles (patterns pattern)]
  (loop [offset 0 found []]
   (if-let [next (first-match data needles offset)]
    (recur (+ (elem next 0) (elem next 1)) (conj found next))
    (to-list found)))))
