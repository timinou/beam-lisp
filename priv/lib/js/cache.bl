; Checked ANF reuse for the certified finite lexical profile. Full linking and
; actor/native audits still run; arbitrary macros retain the ordinary compiler.
; Experimental opt-in: measured disk validation currently costs more than direct
; compilation for the finite lexical profile. Do not tax normal builds.
(ns js.cache (:require [vm.shared :as shared]))
(def FORMAT "bl-js-checked-anf-1")
(defn- digest [value]
 (Base/encode16 (crypto/hash :sha256 value) (list (tuple :case :lower))))
(defn- portable? [value depth]
 (and (< depth 128)
  (cond
   (erlang/is_tuple value) (every? (fn [v] (portable? v (inc depth))) (erlang/tuple_to_list value))
   (erlang/is_list value) (every? (fn [v] (portable? v (inc depth))) value)
   (erlang/is_map value) (every? (fn [pair] (and (portable? (elem pair 0) (inc depth)) (portable? (elem pair 1) (inc depth)))) (maps/to_list value))
   :else (or (number? value) (string? value) (erlang/is_atom value)))))
(defn key-for [prepared options]
 (when (and (:cache-eligible? prepared) (not (:check-node options))
            (= "on" (System/get_env "BL_JS_CACHE")))
  (let [source (:source prepared)]
   (when (shared/shareable-source? source)
    (when-let [authority (BeamLisp.AOT/local_package_authority)]
     (digest (erlang/term_to_binary [FORMAT (:path prepared) source authority
               (BeamLisp.AOTCache/compiler_key)
               (BeamLisp.Loader/namespace_context (:ns prepared))])))))))
(defn- path-for [key]
 (str (or (System/get_env "XDG_CACHE_HOME") (str (System/get_env "HOME") "/.cache"))
      "/beam_lisp/js-anf/" FORMAT "/" key ".term"))
(defn reset-stats! [] (Process/put :bl_js_anf_cache {:hits 0 :misses 0 :declined 0}) :ok)
(defn stats [] (or (Process/get :bl_js_anf_cache) {:hits 0 :misses 0 :declined 0}))
(defn note! [kind] (Process/put :bl_js_anf_cache (update (stats) kind inc)) :ok)
(defn fetch [key]
 (when key
  (try
   (let [path (path-for key) size (:size (File/stat! path))]
    (when (and (> size 2) (< size 8388608))
     (let [bytes (File/read! path)]
      ;; Our writer never compresses; decline compressed external-term bombs.
      (when (and (< (erlang/byte_size bytes) 8388608) (not= 80 (binary/at bytes 1)))
       (let [envelope (erlang/binary_to_term bytes (list :safe)) product (:product envelope)]
        (when (and (= FORMAT (:format envelope)) (= key (:key envelope))
                   (map? product) (vector? (:defs product)) (string? (:ns product))
                   (portable? product 0)
                   (= (:sha256 envelope) (digest (erlang/term_to_binary product)))) product))))))
   (catch _ nil))))
(defn store! [key product]
 (when (and key (portable? product 0))
  (let [path (path-for key) stage (str path "." (System/pid) "-" (System/unique_integer (list :positive)))
        bytes (erlang/term_to_binary {:format FORMAT :key key :product product
                                     :sha256 (digest (erlang/term_to_binary product))})]
   (when (< (erlang/byte_size bytes) 8388608)
    (try
     (File/mkdir_p! (Path/dirname path))
     (File/write! stage bytes)
     (File/rename! stage path)
     (catch _ nil)
     (finally (File/rm stage))))))
 product)
