; One checked-ANF pattern traversal for frame bodies and direct specializations.
; The caller supplies naming/literal state; all value operations are canonical.
(ns js.pattern)
(defn lines [pattern value label options]
  (let [op (:pop pattern) r (:runtime options)
        tmp (:temporary options) local (:local options) literal (:literal options)
        recur-pattern (fn [p v] (lines p v label options))
        mismatch (fn [test] (str "if (!(" test ")) break " label ";"))]
    (cond
      (= op :pvar) (if (= "_" (:name pattern)) (list)
                    (list (str "const " (local (:name pattern)) " = " value ";")))
      (= op :plit) (list (mismatch (str r ".keyEq(" value ", " (literal (:val pattern)) ")")))
      (= op :pnil) (list (mismatch (str value " === " r ".EMPTY")))
      (= op :ptuple)
        (let [t (tmp) n (count (:elems pattern))]
          (concat (list (str "const " t " = " value ";")
                        (mismatch (str t " instanceof " r ".Tup && " t ".items.length === " n)))
                  (mapcat (fn [i] (recur-pattern (nth (:elems pattern) i) (str t ".items[" i "]"))) (range n))))
      (= op :pcons)
        (let [t (tmp)]
          (concat (list (str "const " t " = " value ";") (mismatch (str t " instanceof " r ".Cons")))
                  (recur-pattern (:head pattern) (str t ".h"))
                  (recur-pattern (:tail pattern) (str t ".t"))))
      (= op :palias) (concat (recur-pattern (:b pattern) value) (recur-pattern (:a pattern) value))
      (= op :pmap)
        (let [t (tmp)]
          (concat (list (str "const " t " = " value ";") (mismatch (str t " instanceof " r ".HMap")))
                  (mapcat (fn [[key pattern]]
                            (let [u (tmp)]
                              (concat (list (str "const " u " = " t ".get(" (literal (:val key)) ", " r ".PATTERN_MISSING);")
                                            (mismatch (str u " !== " r ".PATTERN_MISSING")))
                                      (recur-pattern pattern u)))) (:pairs pattern))))
      (= op :pstruct)
        (let [t (tmp)]
          (concat (list (str "const " t " = " value ";")
                        (mismatch (str r ".structMod(" t ") === " ((:string options) (str (:mod pattern))))))
                  (mapcat (fn [[field pattern]]
                            (let [key ((:string options) (str field))]
                              (concat (list (mismatch (str r ".structHasField(" t ", " key ")")))
                                      (recur-pattern pattern (str r ".structField(" t ", " key ")")))))
                          (:fields pattern))))
      :else (throw (ex-info "js.pattern: unsupported checked pattern" {:pattern pattern})))))
