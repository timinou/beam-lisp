; priv/lib/js/build.bl — namespaces → ES modules, linked at build time.
;
; `(build {:roots ["apps/bl-ed"] :entry "ed.main" :out "out/bl-ed"})` reads the
; entry namespace, follows its `(:require …)` graph through the roots, compiles
; every namespace with the BEAM compiler to bl-ANF, emits each as one ES module
; (js.emit), and writes them plus the runtime (rt.mjs, core.mjs) to `:out`.
;
; LINKING. Every `:global {ns name}` is resolved HERE, not at run time:
;   1. a top-level def of THAT namespace           → its local JS binding
;   2. a def of a namespace it requires (by alias)  → an import
;   3. a core name (core.mjs `CORE` registry)       → C.<impl>
;   4. otherwise                                    → a BUILD ERROR naming the
;                                                     namespace, name and line
; Rule 3 mirrors Env.fetch!'s ns→core fallback (FUP-141 records that the IR
; does not state it; this is where the JS target states it).
;
; HOST FFI. `(js/name args…)` — a :remote with module `js` — calls the host
; function `name` that the page registers (`H.<name>`). The set of host
; functions is declared by the app (`:host` in its build config), so an
; unknown one is a build error too. That keeps the closed-world audit the
; actor target has, without its allowlist file.

(ns js.build
  (:require [js.emit :as e]
            [reader-node :as rn]
            [system.ir :as ir]))

; ─── reading a namespace ────────────────────────────────────────────────────

(defn- rn-tag [n] (rn/node-tag (rn/node-form n)))
(defn- rn-items [n] (rn/node-items n))
(defn- rn-name [n] (rn/node-name (rn/node-form n)))
(defn- unwrap [n] (rn/node-form n))
(defn- sym? [n s] (and (= :symbol (rn-tag n)) (or (nil? s) (= s (rn-name n)))))
(defn- kw-node? [n s] (and (= :keyword (rn-tag n)) (= s (rn-name n))))

(defn ns-path
  "The `.bl` file for namespace `ns` under one of `roots`, by the loader's own
   rule (`Loader/source_relatives`): the dotted spelling first, then Clojure's
   dash→underscore munging — `reader-node` is `reader-node.bl`, `ed.text` is
   `ed/text.bl`."
  [roots ns]
  (let [rels (filter (fn [r] (ends-with? r ".bl")) (BeamLisp.Loader/source_relatives ns))]
    (first (for [r roots rel rels :let [p (str r "/" rel)] :when (File/regular? p)] p))))

(defn read-forms [path]
  (BeamLisp.Ns.Reader/read (File/read! path) {:file path}))

(defn- ns-head
  "{:ns name :requires [[ns alias]…]} from a file's `(ns …)` form."
  [forms]
  (let [h (first forms)]
    (if (and (= :list (rn-tag h)) (sym? (first (rn-items h)) "ns"))
      (let [items (rn-items h)
            name (rn-name (second items))
            clauses (filter (fn [c] (= :list (rn-tag c))) (rest (rest items)))
            reqs (mapcat (fn [c]
                           (let [its (rn-items c)]
                             (if (kw-node? (first its) "require")
                               (map (fn [spec]
                                      (let [s (rn-items spec)
                                            target (rn-name (first s))
                                            as-i (index-where s (fn [x] (kw-node? x "as")))]
                                        [target (if (nil? as-i) target (rn-name (nth s (inc as-i))))]))
                                    (filter (fn [s] (= :vector (rn-tag s))) (rest its)))
                               [])))
                         clauses)]
        {:ns name :requires (vec reqs)})
      (throw (ex-info "js.build: a namespace file must start with (ns …)" {:form h})))))

(defn- index-where [xs pred]
  (loop [i 0 s (seq xs)] (cond (empty? s) nil (pred (first s)) i :else (recur (inc i) (rest s)))))

; ─── top-level forms → definitions ──────────────────────────────────────────

(defn- defn-like? [f] (and (= :list (rn-tag f)) (let [h (first (rn-items f))] (or (sym? h "defn") (sym? h "defn-")))))
(defn- def-like? [f] (and (= :list (rn-tag f)) (sym? (first (rn-items f)) "def")))
(defn defmacro? [f] (and (= :list (rn-tag f)) (sym? (first (rn-items f)) "defmacro")))
(defn- comment-form? [f] (and (= :list (rn-tag f)) (sym? (first (rn-items f)) "comment")))
(defn- declare-form? [f] (and (= :list (rn-tag f)) (sym? (first (rn-items f)) "declare")))

(defn- strip-doc+attrs
  "The clause part of `(defn name doc? attrs? clauses…)`."
  [items]
  (let [b0 (rest (rest items))
        b1 (if (and (> (count b0) 1) (erlang/is_binary (unwrap (first b0)))) (rest b0) b0)
        b2 (if (and (> (count b1) 1) (= :map (rn-tag (first b1)))) (rest b1) b1)]
    b2))

(defn- wrap-pos [form like]
  (let [m (rn/node-pos like)]
    (if (nil? m) form (rn/meta-node form m))))

(defn- last-wins
  "A name defined twice keeps its LAST definition, at that position: the BEAM
   interns both and the later `intern` wins (rt.bl defines `sorted-set?` and
   `sorted-map?` twice). An ES module may export a name only once."
  [defs]
  (let [last-at (reduce (fn [m [i d]] (if (some? (:name d)) (assoc m (:name d) i) m))
                        {} (map-indexed (fn [i d] [i d]) defs))]
    (vec (keep (fn [[i d]] (when (or (nil? (:name d)) (= i (get last-at (:name d)))) d))
               (map-indexed (fn [i d] [i d]) defs)))))

(defn- top-defs
  "Definitions a file contributes, in order: {:name :private? :form :kind}.
   `defn` → `(fn name clauses…)`; `def` → its init form. Macros run in the
   BEAM compiler only (they shaped this ANF already), so they emit nothing."
  [forms]
  (last-wins
    (keep (fn [f]
            (cond
              (defn-like? f)
                (let [its (rn-items f)
                      nm (rn-name (second its))]
                  {:name nm :kind :fn :private? (sym? (first its) "defn-")
                   :form (wrap-pos (rn/list-node (cons (rn/sym-node "fn") (cons (second its) (strip-doc+attrs its)))) f)})
              (def-like? f)
                (let [its (rn-items f)
                      nm (rn-name (second its))
                      body (rest (rest its))
                      init (if (and (> (count body) 1) (erlang/is_binary (unwrap (first body)))) (second body) (first body))]
                  {:name nm :kind :val :private? false :form init})
              (or (defmacro? f) (comment-form? f) (declare-form? f)) nil
              (and (= :list (rn-tag f)) (sym? (first (rn-items f)) "ns")) nil
              :else {:name nil :kind :expr :form f}))
          forms)))

; ─── one namespace ──────────────────────────────────────────────────────────

(defn form-text
  "The exact source text of top-level reader node `f` from `path`: from its
   start to the start of the NEXT top-level form (or the end of the file),
   trailing comments and blank space included — harmless to `eval_string`.
   Not the node's own end position: a form read through syntax-quote reports
   a shrunken end, while every top-level START (line/col) is exact."
  [path f]
  (let [forms (read-forms path)
        src-lines (vec (split (File/read! path) "\n"))
        start (fn [n] (let [p (rn/node-pos n)] [(get p :line) (get p :col)]))
        [l1 c1] (start f)
        nxt (second (drop-while (fn [n] (not= (start n) [l1 c1])) forms))
        [l2 c2] (if (some? nxt) (start nxt) [(inc (count src-lines)) 1])
        cps (fn [s] (unicode/characters_to_list s))
        cut (fn [s a b] (unicode/characters_to_binary (lists/sublist (cps s) a (max 0 (- b a)))))
        line (fn [i] (if (<= i (count src-lines)) (nth src-lines (dec i)) ""))]
    (if (= l1 l2)
      (cut (line l1) c1 c2)
      (join "\n" (concat [(cut (line l1) c1 (inc (count (cps (line l1)))))]
                         (map line (range (inc l1) l2))
                         [(cut (line l2) 1 c2)])))))

(defn- first-form-text [path] (form-text path (first (read-forms path))))

(defn compile-ns
  "Compile namespace file `path` to {:ns :requires :defs [{:name :kind :node}]}.
   The BEAM compiler is given the real namespace, so macros, aliases and
   refers resolve exactly as they would on BEAM. Each def is interned as a
   placeholder FIRST so later forms' references to earlier (and forward)
   names resolve to `:global` of this namespace."
  [path]
  (let [forms (read-forms path)
        head (ns-head forms)
        ns (:ns head)
        ; evaluate the ns form on BEAM so aliases/requires exist for the compiler
        _ (BeamLisp.Compiler/eval_string (first-form-text path) (BeamLisp.Compiler/new_env "user") path)
        defs (top-defs (rest forms))
        ; a placeholder only where the name is unbound: interning nil over a LIVE
        ; definition (compiling `core` itself, or any ns this VM already runs)
        ; would break the very compiler doing the compiling
        _ (doseq [d defs]
            (when (and (some? (:name d)) (not (BeamLisp.Env/bound? ns (:name d))))
              (BeamLisp.Env/intern ns (:name d) nil)))
        ; the namespace's OWN macros define its compile-time language: each
        ; `defmacro` is defined on the BEAM (its source span, in this ns)
        ; before the forms that use it compile. Not D3's "evaluate the ns":
        ; a defmacro runs nothing but its own definition. A macro whose body
        ; CALLS a fn of this ns (rare) still needs that fn on the BEAM.
        _ (doseq [f (filter defmacro? (rest forms))]
            (BeamLisp.Compiler/eval_string (form-text path f) (BeamLisp.Compiler/new_env ns) path))
        env (BeamLisp.Ns.Compiler/new_env ns)]
    {:ns ns :path path :requires (:requires head)
     :defs (vec (map (fn [d]
                       (assoc d :node
                         (try (BeamLisp.Ns.Compiler/compile (:form d) env)
                              (catch ex
                                (throw (ex-info (str path ": " (or (:name d) "top-level form") ": " (ex-message ex))
                                                {:path path :name (:name d)}))))))
                     defs))}))

; ─── linking ────────────────────────────────────────────────────────────────

(def ^:private rt-mod :Elixir.BeamLisp.Ns.Rt)
(def ^:private core-mod :Elixir.BeamLisp.Ns.Core)
(def ^:private set-mod :Elixir.BeamLisp.Set)
(def ^:private refs-mod :Elixir.BeamLisp.Refs)
(def ^:private exinfo-mod :Elixir.BeamLisp.ExInfo)

(def ^:private rt-specific
  "Runtime functions the compiler calls DIRECTLY in an argument order of their
   own (priv/boot/rt.bl documents each). They resolve to `rt:<fun>` entries in
   core.mjs, never to the BL core name that happens to share the word."
  #{"drop" "drop_clj" "apply_variadic" "apply_to" "map_multi"})

(defn rt-aliases
  "{[mod fun] → BL core name} for every runtime function the BEAM core table
   seeds under a different name (`:print_readably` is `pr-str`, `:not_` is
   `not`, `:drop_clj` is `drop`, …). Read from the LIVE link table, so the
   JS target never keeps its own copy of BEAM's naming: `(BeamLisp.Env/link
   \"core\" name)` is the one place a BL name meets its BEAM function."
  [names]
  (reduce (fn [m nm]
            (let [l (try (BeamLisp.Env/link "core" nm) (catch e :error))]
              (if (and (erlang/is_tuple l) (= :ok (erlang/element 1 l)))
                (let [info (erlang/element 2 l)
                      mod (erlang/element 1 info)
                      fixed (erlang/element 2 info)
                      var (erlang/element 3 info)
                      fs (concat (map second fixed) (if (nil? var) [] [(erlang/element 2 var)]))]
                  (reduce (fn [m2 f] (if (contains? m2 [mod f]) m2 (assoc m2 [mod f] nm))) m fs))
                m)))
          {} names))

(defn rest-fns
  "#{[mod-name fname arity]}: every VARIADIC function the core link table
   names, at its rest-list arity (min + 1) — called with the rest packed as
   one trailing list, like a `__bl_v` clause."
  [core]
  (set (keep (fn [nm]
               (let [l (try (BeamLisp.Env/link "core" nm) (catch e :error))]
                 (when (and (erlang/is_tuple l) (= :ok (erlang/element 1 l)))
                   (let [info (erlang/element 2 l) var (erlang/element 3 info)
                         vf (when (erlang/is_tuple var) (e/atom-text (erlang/element 2 var)))]
                     ; an `rt:` entry (rt-specific) already takes the rest LIST
                     ; as its own last parameter: never spread it
                     (when (and (some? vf) (not (and (= rt-mod (erlang/element 1 info)) (contains? rt-specific vf))))
                       [(e/atom-text (erlang/element 1 info)) vf (inc (erlang/element 1 var))])))))
             (concat core ["+" "-" "*" "/" "<" ">" "<=" ">=" "==" "="]))))

(defn core-links-module
  "ES-module text that seeds a JS page's registry with BEAM's core LINK table
   (`{:link \"core\" name}` rows, read from this VM's live table), so the
   compiler running in JS emits the same linked calls the BEAM compiler does
   (`(+ 1 2)` → :arith), and the map `mod/fun/arity` → CORE key the run-time
   linker resolves those calls with. Generated per build: one source, BEAM's."
  [core]
  (let [aliases (rt-aliases (vec core))
        rows (keep (fn [nm]
                     (let [l (try (BeamLisp.Env/link "core" nm) (catch e :error))]
                       (when (and (erlang/is_tuple l) (= :ok (erlang/element 1 l)))
                         [nm (erlang/element 2 l)])))
                   (sort (concat core ["+" "-" "*" "/" "<" ">" "<=" ">=" "==" "="])))
        triple (fn [info]
                 (let [mod (erlang/element 1 info) fixed (erlang/element 2 info) var (erlang/element 3 info)]
                   (str "R.tup([R.kw(" (e/js-str (e/atom-text mod)) "), R.hashMap("
                        (join ", " (map (fn [[a f]] (str a ", R.kw(" (e/js-str (e/atom-text f)) ")")) (sort-by first fixed)))
                        "), "
                        (if (nil? var) "null"
                          (str "R.tup([" (erlang/element 1 var) ", R.kw(" (e/js-str (e/atom-text (erlang/element 2 var))) ")])"))
                        "])")))
        op-keys (distinct
                  (for [[_ info] rows
                        :let [mod (erlang/element 1 info) fixed (erlang/element 2 info) var (erlang/element 3 info)]
                        [a f] (concat (map (fn [[a f]] [a f]) fixed)
                                      (if (nil? var) [] [[(inc (erlang/element 1 var)) (erlang/element 2 var)]]))
                        :let [k (core-name mod f a aliases)]
                        :when (and (some? k) (contains? core k))]
                    [(str (e/atom-text mod) "/" (e/atom-text f) "/" a) k]))
        ; plus the fixed ops core-name maps by rule (not by link row): the
        ; compiler emits these directly (RT/hash_key, Exception/normalize,
        ; erlang comparisons, ExInfo, Refs, Set/new, the Rt calling-convention
        ; variants) — the SAME rule the build links with
        fixed (for [[mod fs] [[rt-mod (concat (vec rt-specific) ["hash_key" "invoke" "apply_to" "apply_variadic"])]
                              [:Elixir.Exception ["normalize"]]
                              [:erlang ["raise" "+" "-" "*" "==" "=:=" "/=" "=/=" "<" ">" "=<" ">=" "not" "rem" "div" "abs"
                                        "is_integer" "is_binary" "is_map" "is_function" "error" "throw"]]
                              [refs-mod ["swap!" "reset!" "deref" "atom"]]
                              [exinfo-mod ["ex_info" "ex_message" "ex_data" "raise_payload"]]
                              [set-mod ["new"]]]
                     f fs
                     a (range 0 5)
                     :let [k (core-name mod (erlang/binary_to_atom f) a aliases)]
                     :when (and (some? k) (contains? core k))]
                 [(str (e/atom-text mod) "/" f "/" a) k])
        op-keys (distinct (concat op-keys fixed))]
    (str "// GENERATED by priv/lib/js/build.bl (core-links-module) from this VM's core link table — do not edit.\n"
         "import * as R from \"./rt.mjs\";\n"
         "export const LINKS = [\n"
         (join ",\n" (map (fn [[nm info]] (str "  [" (e/js-str nm) ", " (triple info) "]")) rows))
         "\n];\n"
         "export const OPS = {\n"
         (join ",\n" (map (fn [[k v]] (str "  " (e/js-str k) ": " (e/js-str v))) op-keys))
         "\n};\n"
         ; variadic link fns at their rest-list arity (see `rest-fns`)
         "export const REST_FNS = [\n"
         (join ",\n" (map (fn [[m f a]] (str "  [" (e/js-str m) ", " (e/js-str f) ", " a "]")) (sort-by str (rest-fns core))))
         "\n];\n")))

(defn- core-name
  "The CORE registry key a compiler-emitted runtime op maps to, or nil.
   `aliases` is `rt-aliases` (BEAM function → BL name)."
  [m f arity aliases]
  (let [fname (e/atom-text f)
        fname (if (ends-with? fname "__bl_v") (subs fname 0 (- (count fname) 6)) fname)]
    (cond
      ; a runtime function whose CALL convention differs from the BL name
      ; it shares a word with (Rt/drop is (coll, n); core drop is (n, coll))
      (and (= m rt-mod) (contains? rt-specific fname)) (str "rt:" fname)
      (contains? aliases [m f]) (get aliases [m f])
      (or (= m rt-mod) (= m core-mod)) fname
      (and (= m set-mod) (= f :new)) "set"
      (and (= m :Elixir.Exception) (= f :normalize)) "Exception/normalize"
      (and (= m :erlang) (= f :raise)) "erlang/raise"
      (= m refs-mod) (get {"swap!" "swap!" "reset!" "reset!" "deref" "deref" "atom" "atom"} fname)
      ; `(throw x)` lowers to ExInfo.raise_payload(x)
      (= m exinfo-mod) (get {"ex_info" "ex-info" "ex_message" "ex-message" "ex_data" "ex-data"
                             "raise_payload" "throw"} fname)
      ; Erlang comparison is TERM comparison: `==` is equality with numeric
      ; coercion (1 == 1.0, [1] == [1.0], :a == :a) = BL `eqv`; `=:=` is exact
      ; (1 =:= 1.0 is false) = map-key equality. Neither is number-only.
      ; and `<` `>` `=<` `>=` are TERM order (any two terms: :a < "s"), not BL's
      ; number-only `<`: `erlang/<` compares keywords in compiler code
      (= m :erlang) (get {"+" "+" "-" "-" "*" "*" "==" "eqv" "=:=" "erlang/=:=" "/=" "erlang//=" "=/=" "erlang/=/="
                          "<" "erlang/<" ">" "erlang/>" "=<" "erlang/=<" ">=" "erlang/>="
                          "not" "not" "rem" "rem" "div" "quot" "abs" "abs" "is_integer" "int?" "is_binary" "string?"
                          "is_map" "map?" "is_function" "fn?" "error" "throw"} fname)
      :else nil)))

(defn- seed-ref
  "A seeded core value, read once per NAME per module (`SEEDS`, a lazily
   filled cache): the registry lookup builds a key string, and a seeded fn
   (`+`, `str`, `even?`) sits in the hottest loops."
  [ns nm]
  (str "SEED(" (e/js-str ns) ", " (e/js-str nm) ")"))

(def ^:private raw-ctors
  "rt.bl's raw constructors, as the JS expression of the same value. Each is a
   FUNCTION value (a call site emits `f(args)`; a value use passes it)."
  {"raw-cons" "R.consRaw" "tuple2" "R.tuple2" "tuple3" "R.tuple3"
   "empty-list" "R.emptyList" "k-empty-list" "R.emptyList"})

(defn link-ctx
  "The emitter context for namespace `cns`: resolvers for globals and remotes.
   `table` maps ns → set of def names; `core` is the set of CORE keys;
   `host` the set of declared host fns. `missing` collects unresolved names."
  [cns table core host missing rt-alias leaves stubs self-host? used]
  (let [aliases (into {} (map (fn [[t a]] [a t]) (:requires cns)))
        own (get table (:ns cns))
        resolve (fn [ns nm arity]
                  (let [ns* (get aliases ns ns)]
                    (cond
                      ; rt's raw constructors (rt.bl rt.raw: `raw-cons`, `tuple2`,
                      ; `tuple3`) are spelled with BIF dances because rt.bl may not
                      ; write a literal; on JS each IS one constructor (PLAN-163 U3)
                      (and self-host? (= ns* "rt") (contains? raw-ctors nm)) (get raw-ctors nm)
                      (and (= ns* (:ns cns)) (contains? own nm)) (str "d_" (e/mangle nm))
                      (contains? (get table ns* #{}) nm) (do (swap! used conj ns*) (str "N_" (e/mangle ns*) ".d_" (e/mangle nm)))
                      ; SELF-HOST: core's own defn (`inc`, `update`) or rt's (`first`) — the
                      ; compiled namespaces, never core.mjs
                      (and self-host? (contains? (get table "core" #{}) nm)) (do (swap! used conj "core") (str "N_core.d_" (e/mangle nm)))
                      (and (not self-host?) (contains? core nm)) (str "C.CORE[" (e/js-str nm) "]")
                      ; SELF-HOST: a core name that is a SEED row (rt.bl
                      ; seed-rows/seed-closures: `str`, `map`, `+` …), not a
                      ; defn — read from the registry compiled rt filled
                      ; (rt/seed-core runs when the build loads), exactly as
                      ; Env.fetch! reads it on the BEAM
                      (and self-host? (contains? #{"core" "cpp"} ns*)) (seed-ref ns* nm)
                      ; …and a bare name nothing defines falls back to `core`,
                      ; Env.fetch!'s candidate order (ns, refer, core, sugar):
                      ; a seed-row name (`+`, `str`, `even?`) used in a user ns
                      (and self-host? (= ns* (:ns cns)) (not (contains? own nm))) (seed-ref "core" nm)
                      ; a namespace the build deliberately leaves out (:stub):
                      ; reaching it at run time is a named error, not a build error
                      (contains? stubs ns*) (str "STUB(" (e/js-str (str ns* "/" nm)) ")")
                      :else (do (swap! missing conj [(:ns cns) ns nm]) (str "MISSING(" (e/js-str (str ns "/" nm)) ")")))))
        ; a namespace the VM already runs is linked by MODULE: the compiler
        ; emits `Ns.Foo.Bar/f` for its defs instead of a global. Map each
        ; built namespace's module back to its own JS defs.
        ; (a `__bl_v` call still passes its rest list; the emitter spreads it)
        by-mod (into {} (map (fn [ns] [(BeamLisp.Link/module_for ns) ns]) (keys table)))
        stub-mods (into {} (map (fn [ns] [(BeamLisp.Link/module_for ns) ns]) stubs))
        base-name (fn [f] (let [n (e/atom-text f)] (if (ends-with? n "__bl_v") (subs n 0 (- (count n) 6)) n)))
        remote (fn [m f arity]
                 (cond
                   (and self-host? (= "rt" (get by-mod m)) (contains? raw-ctors (base-name f)))
                     (get raw-ctors (base-name f))
                   (and (contains? by-mod m) (contains? (get table (get by-mod m)) (base-name f)))
                     (let [ns* (get by-mod m) n (e/mangle (base-name f))
                           target (if (= ns* (:ns cns)) (str "d_" n) (do (swap! used conj ns*) (str "N_" (e/mangle ns*) ".d_" n)))]
                       ; SELF-HOST: `f__bl_v` is the variadic CLAUSE, called
                       ; with its rest args as one list (the BEAM ABI) — the
                       ; dispatcher's `.v`, not the dispatcher (which would
                       ; wrap that list in another)
                       (if (and self-host? (ends-with? (e/atom-text f) "__bl_v")) (str target ".v") target))
                   (contains? stub-mods m) (str "STUB(" (e/js-str (str (get stub-mods m) "/" (e/atom-text f))) ")")
                   (= m :js) (let [nm (e/atom-text f)]
                               (if (contains? host nm) (str "H[" (e/js-str nm) "]")
                                 (do (swap! missing conj [(:ns cns) "js" nm]) (str "MISSING(" (e/js-str (str "js/" nm)) ")"))))
                   :else (let [k (core-name m f arity rt-alias)
                               lk (str (e/atom-text m) "/" (e/atom-text f) "/" arity)]
                           (cond
                             (and (not self-host?) (some? k) (contains? core k)) (str "C.CORE[" (e/js-str k) "]")
                             ; a host leaf (priv/lib/js/leaves.mjs), keyed by its BEAM name
                             (contains? leaves lk) (str "L.LEAVES[" (e/js-str lk) "]")
                             ; collected like an unresolved global, so ONE build
                             ; lists every missing leaf instead of stopping at the first
                             :else (do (swap! missing conj [(:ns cns) "leaf" lk])
                                       (str "MISSING(" (e/js-str lk) ")"))))))]
    {:ns (:ns cns) :resolve resolve :remote remote :dest nil :self-host? self-host?}))

(defn ns-file
  "The file a compiled namespace is written to, relative to the out dir.
   A self-host build (core and rt are compiled namespaces too) puts every
   namespace under ns/, so `rt` the NAMESPACE never overwrites rt.mjs the
   runtime."
  [self-host? ns]
  (if self-host? (str "ns/" ns ".mjs") (str ns ".mjs")))

(defn- ns-file-from
  "The import specifier for namespace `ns` from a sibling compiled module."
  [self-host? ns]
  (str "./" ns ".mjs"))

(defn emit-ns
  "One compiled namespace → ES module text. `order` is the build's load order
   (dependencies first)."
  [cns table core host missing rt-alias leaves stubs self-host? order]
  (e/reset-state!)
  (let [used (atom #{})
        entry? (= (:ns cns) (last order))
        ctx (link-ctx cns table core host missing rt-alias leaves stubs self-host? used)
        ; a self-host build's namespaces live in ns/ (ns/rt.mjs, ns/core.mjs):
        ; the runtime's own rt.mjs/core.mjs keep their names one level up
        up (if self-host? "../" "./")
        body (mapcat (fn [d]
                       (let [r (e/emit (:node d) ctx)]
                         (cond
                           (= :fn (:kind d))
                             (concat (:lines r) (list (str "export const d_" (e/mangle (:name d)) " = " (:val r) ";")))
                           (= :val (:kind d))
                             (concat (:lines r) (list (str "export const d_" (e/mangle (:name d)) " = " (:val r) ";")))
                           :else (concat (:lines r) (if (nil? (:val r)) (list) (list (str (:val r) ";")))))))
                     (:defs cns))
        ; `function` declarations hoist; consts do not. A def that refers to a
        ; LATER def must not run before it: emit fn defs as hoisted functions.
        kws (e/kw-decls)
        ; exactly the built namespaces this one REFERENCES — by :require or by
        ; MODULE name (`BeamLisp.Ns.Rt/x`: core calls rt without requiring
        ; it), recorded while linking the body above. Importing only those
        ; keeps the module graph the namespace graph: no artificial cycle.
        ; a namespace that comes LATER in load order (it depends on this one:
        ; rt is loaded before core, yet rt calls core/tuple) is reached
        ; through the late-bound module table, not a static import — an ES
        ; import cycle would let the later module's top-level code run
        ; against this one's uninitialized bindings (rt ⇄ core)
        later (set (drop-while (fn [t] (not= t (:ns cns))) order))
        imports (map (fn [t]
                       (if (contains? later t)
                         (str "const N_" (e/mangle t) " = L.lateModule(" (e/js-str t) ");")
                         (str "import * as N_" (e/mangle t) " from \"" (ns-file-from self-host? t) "\";")))
                     (sort @used))]
    (str "// GENERATED by priv/lib/js/build.bl from " (:path cns) " — do not edit.\n"
         "import * as R from \"" up "rt.mjs\";\n"
         "import * as C from \"" up "core.mjs\";\n"
         "import { H } from \"" up "host.mjs\";\n"
         "import * as L from \"" up "leaves.mjs\";\n"
         (join "\n" imports) "\n"
         "const MISSING = (n) => { throw new R.BLError(\"unresolved \" + n); };\n"
         (if self-host? (str "import { ENV as E_ } from \"" up "env.mjs\";\n"
                               ; a seeded value may be a `{:$blfn …}` multi-fn tuple: calls go through invoke
                               "const SEEDS = new Map();\n"
                               "const SEED = (ns, n) => { const k = ns + \"/\" + n; let f = SEEDS.get(k); if (f === undefined) { const v = E_[\"fetch!\"](ns, n); f = typeof v === \"function\" ? v : (...a) => C.invoke(v, ...a); SEEDS.set(k, f); } return f; };\n") "")
         ; SELF-HOST: `core`'s top level calls seeded names (`str`, `map` …):
         ; rt/seed-core must have filled the registry first, as the BEAM boot
         ; does before the prelude loads. ns/seeded.mjs is that step.
         (if (and self-host? (= "core" (:ns cns))) "import \"./seeded.mjs\";\n" "")
         (if (and self-host? (= entry? true)) "import \"./base.mjs\";\n" "")
         "const STUB = (n) => (...a) => { throw new R.BLError(n + \" is not part of this JS build (a :stub namespace)\"); };\n"
         (join "\n" kws) "\n\n"
         (join "\n" body) "\n"
         ; register this module by namespace AND by BEAM module name, so a
         ; late-bound reference (above) and `erlang/apply` of a module atom
         ; (`fun M:F/A`, rt's seed) both find its exports
         "import * as SELF_ from \"./" (str (:ns cns) ".mjs") "\";\n"
         "L.registerNamespace(" (e/js-str (:ns cns)) ", " (e/js-str (name (BeamLisp.Link/module_for (:ns cns)))) ", SELF_);\n")))

; ─── the build ──────────────────────────────────────────────────────────────


(defn- load-order
  "Namespaces reachable from `entry` (within `roots`), dependencies first."
  [roots entries stubs]
  (loop [todo (vec entries) seen #{} order [] compiled {}]
    (if (empty? todo)
      {:order order :compiled compiled}
      (let [ns (first todo)]
        (if (contains? seen ns)
          (recur (rest todo) seen order compiled)
          (let [path (if (contains? stubs ns) nil (ns-path roots ns))]
            (if (nil? path)
              (recur (rest todo) (conj seen ns) order compiled)   ; not ours: core or BEAM-only
              (let [head (ns-head (read-forms path))
                    deps (vec (filter (fn [d] (and (not (contains? seen d)) (not (contains? stubs d)) (some? (ns-path roots d))))
                                      (map first (:requires head))))]
                (if (empty? (filter (fn [d] (not (contains? (set order) d))) deps))
                  (let [c (compile-ns path)]
                    (recur (rest todo) (conj seen ns) (conj order ns) (assoc compiled ns c)))
                  (recur (concat deps todo) seen order compiled))))))))))

(def ^:private toolchain
  "The compiler's own namespaces. A library that calls into them by module
   (clojure.core-ext's `macroexpand-1` → `BeamLisp.Ns.Compiler`) does not pull
   the whole compiler into a page; a build that WANTS it names it (`--with`,
   as js.eval does), and otherwise the call is a named unresolved leaf."
  #{"compiler" "lower" "anf" "reader" "reader-node" "diag" "system.ir" "optimize"})

(defn- module-ns
  "The namespace a BEAM module atom's text names (`Elixir.BeamLisp.Ns.Clojure.String`
   → `clojure.string`), or nil when it is not a namespace. `module_for` is
   lossy in reverse (it only capitalises segments), so the candidate is the
   lower-cased segment path, CHECKED by mapping it forward again."
  [mod]
  (when (starts-with? mod "Elixir.BeamLisp.Ns.")
    (let [ns (lower-case (subs mod (count "Elixir.BeamLisp.Ns.")))]
      (when (= mod (erlang/atom_to_binary (BeamLisp.Link/module_for ns))) ns))))

(defn build
  "Build `entry` and every namespace it requires under `roots` into `out`.
   opts: {:roots [dirs] :entry ns :out dir :core #{names} :host #{names}}.
   Returns {:modules [ns…] :bytes n :sources [path…]}; throws listing EVERY
   unresolved name."
  [opts]
  (let [{:keys [roots entry out core host]} opts
        leaves (or (:leaves opts) #{})
        stubs (set (or (:stub opts) []))
        ; `:with` adds namespaces reached only by MODULE name (no :require):
        ; the compiler calls `BeamLisp.Ns.Reader/read_string` directly
        ; :with namespaces load BEFORE the entry: they are what the entry
        ; reaches by module name (rt, core), i.e. its dependencies
        self-host? (= true (:self-host opts))
        rt-alias (rt-aliases (vec core))
        _ (e/set-rest-fns! (rest-fns (vec core)))
        ; Link, and in a SELF-HOST build follow module-name references: a call
        ; `BeamLisp.Ns.Clojure.String/upper-case` names a NAMESPACE (one whose
        ; source is under `roots`), which is compiled in like a :require —
        ; the BEAM would load it on that call. Repeat until nothing new.
        attempt (fn [entries]
                  (let [{:keys [order compiled]} (load-order roots entries stubs)
                        table (into {} (map (fn [ns] [ns (set (keep :name (:defs (get compiled ns))))]) order))
                        missing (atom [])
                        texts (into {} (map (fn [ns] [ns (emit-ns (get compiled ns) table core host missing rt-alias leaves stubs self-host? order)]) order))]
                    {:order order :compiled compiled :texts texts :missing @missing}))
        first-try (attempt (concat (or (:with opts) []) [entry]))
        {:keys [order compiled texts missing]}
          (loop [r first-try entries (concat (or (:with opts) []) [entry]) n 0]
            (let [extra (when self-host?
                          (distinct (keep (fn [[_ kind nm]]
                                            (when (= kind "leaf")
                                              (let [ns (module-ns (first (split nm "/")))]
                                                (when (and (some? ns) (not (contains? (set (:order r)) ns))
                                                           (not (contains? toolchain ns))
                                                           (some? (ns-path roots ns)))
                                                  ns))))
                                          (:missing r))))]
              (if (or (empty? extra) (> n 8)) r
                ; a discovered namespace loads BEFORE the entry (it is called by it)
                (let [entries2 (concat (butlast entries) extra [(last entries)])]
                  (recur (attempt entries2) entries2 (inc n))))))
        missing (atom missing)]
    (when (seq @missing)
      (throw (ex-info (str "js.build: " (count @missing) " unresolved name(s):\n"
                           (join "\n" (map (fn [[in ns nm]] (str "  in " in ": " ns "/" nm)) (sort-by str (distinct @missing)))))
                      {:missing @missing})))
    (File/mkdir_p! out)
    (when self-host?
      (File/mkdir_p! (str out "/ns"))
      (File/write! (str out "/ns/seeded.mjs")
                   (str "// GENERATED by priv/lib/js/build.bl — rt's seed-core, before core loads.\n"
                        "import * as N_rt from \"./rt.mjs\";\n"
                        "N_rt.d_seed_core();\n"))
      ; the base namespaces (`:with`: core, the clojure prelude …) are LOADED
      ; for their effects, as the BEAM boot loads them: clojure.core-ext
      ; interns `vector` into core when it loads. The entry imports this first.
      (File/write! (str out "/ns/base.mjs")
                   (str "// GENERATED by priv/lib/js/build.bl — the base namespaces, loaded in order.\n"
                        (join "" (map (fn [ns] (str "import \"./" ns ".mjs\";\n"))
                                      (filter (fn [ns] (contains? (set order) ns)) (or (:with opts) [])))))))
    (doseq [ns order] (File/write! (str out "/" (ns-file self-host? ns)) (get texts ns)))
    {:modules order :bytes (reduce + 0 (map count (vals texts)))
     :sources (vec (map (fn [ns] (:path (get compiled ns))) order))}))
