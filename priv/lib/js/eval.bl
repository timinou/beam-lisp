; priv/lib/js/eval.bl — `eval` for Beam Lisp compiled to JS: read, compile,
; emit and RUN source in the same JS realm (a page, a Worker, node).
;
; Every stage is the ordinary self-hosted pipeline, compiled to JS by
; `bl js build js.eval -p priv/lib -p priv/boot --stub lower --with reader`:
;
;   text ──reader──▶ forms ──compiler──▶ bl-ANF ──js.emit──▶ JS text ──js/run──▶ value
;
; The one thing that differs from a build is LINKING. A build links every name
; at build time to an ES-module import; here a form links at RUN time against
; the live registry (env.mjs): a global names the value interned under
; {ns, name} (then the core table), a host op names its leaf. So a `defn`
; evaluated now is callable by the next form, a `defmacro` is expanded by the
; next form's compile (the compiler finds its `{:$macro fn}` value in the
; registry and calls it), and a redefinition takes effect at once — the REPL's
; semantics, on the JS target.
;
; `defn` and `def` are evaluated the way the JS build treats them: the defn
; becomes `(fn name clauses…)`, the def its init, and the VALUE is interned
; under {ns, name}. (On the BEAM a defn goes through Link/defvar, which builds
; a module; a JS function is already the callable value.)

(ns js.eval
  (:require [compiler :as c]
            [reader :as rd]
            [reader-node :as rn]
            [js.emit :as e]
            [clojure.string]))

(defn- run-ctx
  "The emitter context for a form evaluated in `ns`: names resolve at RUN
   time through the host's `G` (global) and `X` (remote) lookups. A VALUE
   reference is the raw registry value (`G`); a CALL reference (`arity`
   numeric) wraps it in `A.blfnFn` — one dispatcher per raw value — so a
   multi-fn/`$blfn` value is directly callable. The ONE fallback ABI is
   compiled rt's `call-invoke`, which the ABI exposes as `A.invokeList`
   (the same compiled-rt callable the static build links)."
  [ns]
  {:ns ns
   :resolve (fn [gns nm arity]
              (let [g (str "G(" (e/js-str gns) ", " (e/js-str nm) ")")]
                (if (nil? arity) g (str "A.blfnFn(" g ")"))))
   :resolve-exact (fn [gns nm arity]
                    (let [g (str "GX(" (e/js-str gns) ", " (e/js-str nm) ")")]
                      (if (nil? arity) g (str "A.blfnFn(" g ")"))))
   :remote (fn [m f arity]
             (str "X(" (e/js-str (str (e/atom-text m) "/" (e/atom-text f) "/" arity)) ")"))
   :invoke "A.invokeList"
   :dest nil})

(defn emit-node
  "The JS source of one bl-ANF node: a function body ending in
   `return <value>;`, its keyword constants declared first."
  [node ns]
  (let [r (e/emit node (run-ctx ns))]
    (str (join "\n" (e/kw-decls)) "\n"
         (join "\n" (:lines r)) "\n"
         (if (nil? (:val r)) "return null;" (str "return " (:val r) ";")))))

(defn- head-sym [form]
  (let [f (rn/node-form form)]
    (when (= :list (rn/node-tag f))
      (let [items (rn/node-items f)]
        (when (and (not (empty? items)) (= :symbol (rn/node-tag (rn/node-form (first items)))))
          (rn/node-name (rn/node-form (first items))))))))

(defn- def-parts
  "For `(defn name …)` / `(def name …)`: [name init-form]; else nil. A
   docstring and attribute map are skipped, as the compiler does."
  [form]
  (let [h (head-sym form)
        items (when (some? h) (rn/node-items (rn/node-form form)))]
    (cond
      (contains? #{"defn" "defn-"} h)
        (let [nm (rn/node-name (rn/node-form (second items)))
              body (drop 2 items)
              body (if (string? (rn/node-form (first body))) (rest body) body)
              body (if (= :map (rn/node-tag (rn/node-form (first body)))) (rest body) body)]
          [nm (rn/list-node (cons (rn/sym-node "fn") (cons (second items) body)))])
      (= "def" h)
        (let [nm (rn/node-name (rn/node-form (second items)))
              body (drop 2 items)
              init (if (and (> (count body) 1) (string? (rn/node-form (first body)))) (second body) (first body))]
          [nm init])
      :else nil)))

(defn set-rest-fns!
  "Declare the core link table's variadic fns (core-links.mjs REST_FNS) to
   the emitter, once, before the first eval. The eval emitter passes a rest
   list through unchanged, exactly as the static emitter does."
  [triples]
  (e/set-rest-fns! (set (map (fn [t] [(nth t 0) (nth t 1) (nth t 2)]) triples))))

(defn eval-form
  "Compile and run one reader `form` in the current namespace; its value."
  [form]
  (let [ns (BeamLisp.Env/current_ns)
        parts (def-parts form)]
    (e/reset-state!)
    (c/reset-fresh!)
    (if (some? parts)
      (let [[nm init] parts]
        ; bind first, so a recursive defn's own name resolves while compiling
        (when-not (BeamLisp.Env/bound? ns nm) (BeamLisp.Env/intern ns nm nil))
        (let [v (js/run (emit-node (c/compile init (c/new-env ns)) ns))]
          (BeamLisp.Env/intern ns nm v)
          v))
      (js/run (emit-node (c/compile form (c/new-env ns)) ns)))))

(defn eval-string
  "Read every form of `src` and evaluate each in order (an `ns` form switches
   the namespace for the forms after it); the last value."
  [src]
  (reduce (fn [_ f] (eval-form f)) nil (rd/read-string src "eval")))
