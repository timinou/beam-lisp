; Actor package staging and linking. The only ANF-to-JS emitter is js.emit;
; the only value semantics are the ordinary compiled core/rt graph. This module
; expands proc declarations, checks host/import contracts and packages one kernel.

(ns js.actor
  ; The clause MODEL, not a runtime dependency: `clause-plan` is a pure function
  ; of its arguments, and it is what turns a `proc/defserver` declaration into
  ; the clause list this backend renders. See the compiler's own notes below.
  (:require [proc.server :as pserver]
            [proc.super :as psuper]
            [system.js :as native]
            [system.ir :as ir]
            [js.emit :as sync] [reader-node :as rn]
            [js.build :as jsbuild] [bl.js :as facade]
            [bl.json :as json] [clojure.re :as regex] [clojure.string :as string]))

; ─────────────────────────────────────────────────────────────────────────────
; Reader shape and source positions belong to the canonical reader vocabulary.
; These names remain compatibility aliases for compiler fixtures.
(defn n-unwrap [n] (rn/node-form n))
(defn n-tag [n] (rn/node-tag (rn/node-form n)))
(defn n-pos [n] (rn/node-pos n))
(defn with-pos [form pos] (if (nil? pos) form (rn/meta-node form pos)))
(defn n-items [n] (rn/node-items n))
(defn n-name [n] (rn/node-name (rn/node-form n)))
(defn sym-node [s] (rn/sym-node s))
(defn list-node [xs] (rn/list-node xs))

(defn form-sym? [n s]
  (and (= :symbol (n-tag n)) (= s (n-name n))))

(defn defn-form? [n]
  (and (= :list (n-tag n))
       (let [its (n-items n)]
         (and (not (empty? its)) (or (form-sym? (first its) "defn") (form-sym? (first its) "defn-"))))))

(defn defn-name [n] (n-name (second (n-items n))))

(defn ns-form? [n]
  (and (= :list (n-tag n))
       (let [its (n-items n)]
         (and (not (empty? its)) (form-sym? (first its) "ns")))))

(defn defn->fn-form [form] (jsbuild/defn-value-form form))

; ─────────────────────────────────────────────────────────────────────────────
; JavaScript text helpers
; ─────────────────────────────────────────────────────────────────────────────

(defn js-escape [s] (sync/js-escape s))
(defn js-str [s] (sync/js-str s))
(defn join-str [xs sep] (string/join sep xs))
(defn jsname [n] (sync/local-name n))

(defn fresh-tmp []
  (let [cur (erlang/get :js-actors-tmp)
        n (erlang/+ (if (= cur :undefined) 0 cur) 1)]
    (erlang/put :js-actors-tmp n)
    (str "t" n)))

(defn lit-js [v]
  (sync/lit-js v {:runtime "H.values"
                  :keyword (fn [k] (str "H.kw(" (js-str (str k)) ")"))}))

(def mod-rt (erlang/binary_to_atom "Elixir.BeamLisp.Ns.Rt"))
(def mod-core (erlang/binary_to_atom "Elixir.BeamLisp.Ns.Core"))
(def mod-transient (erlang/binary_to_atom "Elixir.BeamLisp.Transient"))
(def mod-host :host)
(def mod-erlang :erlang)

; ─────────────────────────────────────────────────────────────────────────────
; The ABI allowlist
; ─────────────────────────────────────────────────────────────────────────────

(def host-names
  "Every `host/…` leaf the JS host implements. MUST mirror host.mjs `PURE` +
   `RT_HOST`; the build fails closed on anything else."
  #{"kw" "kw-name" "is-kw" "cons" "is-cons" "is-enil" "cons-head" "cons-tail"
    "is-list" "empty-list" "list->array" "tup" "is-tup" "tup-el" "tup-size"
    "struct" "is-struct" "struct-mod" "struct-field" "is-vec" "vec-size" "vec-el"
    "vec-append" "vec-remove" "vec-to-list" "vec-from-list" "is-set"
    "set-from-list" "set-put" "set-remove" "set-has" "set-size" "set-to-list"
    "bmap" "empty-map"
    "is-map" "map-get" "map-put" "map-remove" "map-keys" "map-size"
    "eq" "identical" "lt" "is-nil" "is-int" "is-float" "is-num" "is-str"
    "is-bool" "is-fn" "to-str" "describe" "arith" "str-cat" "str-size" "str-codepoints" "str-slice" "str-cmp" "truthy"
    "park" "wait-until" "now" "state" "set-state" "self" "set-self" "run-turn"
    "make-frames" "ref" "write" "emit" "raise" "max-frames" "logical-stack"
    "critical-enter" "critical-leave" "park-release" "record-error"
    "input-size" "take-input" "wait-input"
    ; The mutable-table STORAGE leaves (runtime.bl section 5). They take no
    ; owner, heir, name or mode: ownership, transfer, access, naming and the
    ; atomic counter are BL decisions the table service takes ABOVE them, and
    ; `is-table` is a value predicate that never says whether a handle is alive.
    "table-new" "table-lookup" "table-insert" "table-delete" "table-size"
    "table-destroy" "table-snapshot" "is-table"
    "ex-kind" "ex-reason" "ex-trace"})

(def erlang-names
  "Every `:erlang` bif a guard (or a raw bif call) may reach."
  #{"==" "/=" "=:=" "=/=" "<" ">" "=<" ">=" "+" "-" "*" "rem" "is_integer"
    "is_float" "is_number" "is_binary" "is_tuple" "is_list" "is_pid"
    "is_reference" "is_port" "is_atom" "is_map" "tuple_size" "map_size" "abs"
    "length" "self"
    ; the exception bifs: the class/reason/reraise triple, the element/2 read a
    ; `__STACKTRACE__` binding compiles to, and the two halves of a struct test
    "raise" "throw" "exit" "element" "is_map_key" "map_get"})

(def core-map
 {"send" "core-send" "call" "core-call" "cast" "core-cast" "stop" "core-stop"
  "whereis" "core-whereis" "register" "core-register" "unregister" "core-unregister"
  "sup-start" "core-sup-start" "sup-start-link" "core-sup-start-link"
  "sup-children" "core-sup-children" "sup-child" "core-sup-child"
  "sup-restart" "core-sup-restart" "sup-terminate" "core-sup-terminate"})

(defn remote-key [m f] (str (str m) "/" (str f)))

(defn native-links [] (let [v (erlang/get :js-actors-native-links)] (if (= v :undefined) {} v)))
(defn native-link [node]
  (when (= :global (:op node)) (get (native-links) (str (:ns node) "/" (:name node)))))
(defn native-name [key] (str "N_" (jsname key)))

; ─────────────────────────────────────────────────────────────────────────────
; Reference audit — the fail-closed half of the ABI
; ─────────────────────────────────────────────────────────────────────────────

(defn walk-refs [node acc]
  (if (not (ir/node? node)) acc
    (let [own (cond
                (= :remote (:op node)) (conj acc [:remote (:mod node) (:fun node)])
                (= :global (:op node)) (conj acc [:global (:ns node) (:name node)])
                :else acc)]
      (reduce (fn [refs child] (walk-refs child refs)) own (ir/child-nodes node)))))

(defn refs-of [nodes]
  (reduce (fn [acc n] (walk-refs n acc)) [] nodes))

; ─────────────────────────────────────────────────────────────────────────────
; The build
; ─────────────────────────────────────────────────────────────────────────────

(defn read-file-forms [path]
  ; POSITION-BEARING read: the reader's `:meta` wrappers are what the compiler
  ; turns into `:ann`, and `:ann` is the emitter's only source channel. `read_all`
  ; deep-unwraps those wrappers, so it is the entry for tools that want bare
  ; shapes — not for a backend that must name where a call was written.
  (BeamLisp.Ns.Reader/read (File/read! path) {:file path}))

; ─────────────────────────────────────────────────────────────────────────────
; `proc/defserver` — one declaration, lowered for this target
;
; `defserver` is the ONE server declaration a bundle writes, and the clause model
; around it (`proc.server/clause-plan`) is what decides what a clause MEANS —
; the state merge, the injected order, the one merged `:DOWN` handler, the
; unknown-clause report. This backend does not re-derive any of it: it hands the
; SAME source clause data to `clause-plan`, with an EXPLICIT target vocabulary,
; and renders the plan it hands back. So a bundle that says
;
;     (proc/defserver counter
;       (init [_] (ok {:n 0}))
;       (handle-call [:bump by] [_from st] (reply (:n st) (assoc st :n (+ (:n st) by))))
;       (handle-cast [:reset] [st] (noreply (assoc st :n 0))))
;
; becomes, here, ONE entry defn (`counter`, taking the init argument) and ONE
; server loop defn (`counter__server_loop`). Both are ordinary BL, so they pass
; through the same reader → ANF → JS pipeline as everything else and nothing in
; the emitter knows what a server is.
;
; WHY ONE RECEIVE LOOP. The target already owns exactly one selective-receive
; primitive (`rt-receive`: scan cursor, fixed deadline, message-major selection)
; and the call protocol rides on it. A server IS a process parked in a receive
; whose arms are its clauses — so the lowering is a SOURCE transformation and
; the ABI stays closed. There is no second public DSL and no interpreter.
;
; THE TARGET VOCABULARY, AND WHAT IT REFUSES:
;   * `init`/`handle-call`/`handle-cast`/`handle-info`/`terminate` are this
;     backend's NATIVE heads — the ones the loop renders;
;   * `(registry …)`, `(bus …)`, `(tick …)` are CONTRIBUTED clauses (their
;     transforms live in a bundle and contribute a state slice, an injected
;     clause list and a `:down` handler). This target contributes NONE yet, so
;     `:vocabulary` below is empty and such a clause is REFUSED, by name. An
;     unknown clause is never silently dropped: its handler would simply never
;     run, which is the one failure mode a server must not have;
;   * `handle-continue` and `invariant` are native-head NAMES this loop does not
;     render, so they are refused the same way rather than accepted and ignored.
;
; THE MESSAGE VOCABULARY IS THE RUNTIME'S. A request is `[:call ref from msg]`,
; a cast `[:cast msg]`, a stop `[:stop reason]`, and a monitor DOWN is the
; runtime's `[:down ref :process pid reason]`. So a clause's `:DOWN` pattern is
; mapped onto `:down` at this one seam, `reply`/`noreply` become real messages
; to the caller that asked, and nothing else about the clause bodies changes.

(def target-server-native-heads
  "The clause heads this backend's server loop renders itself. It is the
   `:native-heads` set `clause-plan` is given, named here so the accepted
   vocabulary is one datum a diagnostic can print instead of a literal buried
   in a call. `handle-continue` and `invariant` are deliberately absent: the
   loop has no arm for them, so they are refused rather than ignored."
  #{"init" "handle-call" "handle-cast" "handle-info" "terminate"})

(def target-server-vocabulary
  "Clause head → transform, for clauses this target CONTRIBUTES a meaning to:
   none, yet. The empty map is explicit — it is what makes the vocabulary a
   decision of THIS backend instead of the native registry's, and what makes
   `(registry (keys :id))` an unknown clause here rather than a silent no-op."
  {})

(defn symbol-for
  "The symbol a reader symbol node spells: a spelling with ONE `/` becomes
   ns/name, so `pr-str` renders it back unchanged. Anything else stays a bare
   name — a reader node carries no separate namespace component."
  [s]
  (let [parts (String/split s "/")]
    (if (and (erlang/is_list parts) (= 2 (erlang/length parts)))
      (symbol (first parts) (second parts))
      (symbol s))))

(defn node->data
  "A reader node as plain source DATA: symbols become symbols, keywords become
   keywords, and lists, vectors, maps and sets recurse. The `:meta` wrapper
   (source position, author metadata) is dropped — the clause model reads the
   DSL, and a position is not part of it."
  [n]
  (let [f (n-unwrap n)]
    (if (erlang/is_tuple f)
      (let [tag (erlang/element 1 f)
            v (erlang/element 2 f)]
        (cond
          (= tag :symbol) (symbol-for v)
          (= tag :keyword) (keyword v)
          (= tag :list) (apply list (map node->data v))
          (= tag :vector) (vec (map node->data v))
          (= tag :set) (set (map node->data v))
          (= tag :map) (reduce (fn [m pair]
                                 (assoc m (node->data (erlang/element 1 pair))
                                          (node->data (erlang/element 2 pair))))
                               {} v)
          :else f))
      f)))

(defn defserver-sym?
  "The spellings of the ONE server declaration this backend accepts: the form's
   own name, and the two qualified names a bundle reaches it by."
  [s]
  (or (= s "defserver") (= s "proc/defserver") (= s "proc.server/defserver")))

(defn defserver-form? [n]
  (and (= :list (n-tag n))
       (let [its (n-items n)]
         (and (not (empty? its)) (defserver-sym? (n-name (first its)))))))

(defn defserver-name [n] (n-name (second (n-items n))))

(defn map-form
  "Rebuild `form` with `f` applied to every LIST node, bottom-up, recursing
   into vectors and into map VALUES. `f` therefore sees a node whose children
   are already rewritten."
  [f form]
  (cond
    (list? form) (f (apply list (map (fn [x] (map-form f x)) form)))
    (vector? form) (vec (map (fn [x] (map-form f x)) form))
    (map? form) (reduce (fn [m k] (assoc m k (map-form f (get form k)))) {} (keys form))
    :else form))

(defn ok-strip
  "Replace a server init's `(ok state)` with `state`. `clause-plan` GUARANTEES
   that marker (it rewrites exactly that position, and refuses an init that does
   not end there); on this target the state it names IS the init's value."
  [form]
  (map-form (fn [x] (if (and (list? x) (= 'ok (first x)) (= 2 (count x)))
                      (second x)
                      x))
            form))

(defn rw-reply
  "Rewrite a clause body into the target's reply vocabulary: `(reply v next)`
   becomes a real reply to the caller that asked, then `next`; `(noreply next)`
   becomes `next`. `from`/`ref` are the arm's caller and request ref; when the
   clause has no caller (cast, info, down) `from` is nil and a `reply` is a
   DECLARATION error with a sentence — rather than an unresolved global found
   later by the ABI audit."
  [form from ref where]
  (map-form
    (fn [x]
      (cond
        (and (list? x) (= 'reply (first x)))
          (cond
            (nil? from)
              (throw (ex-info (str where ": reply is only meaningful inside handle-call —"
                                    " a cast, info or DOWN clause has no caller to answer")
                              {:form x}))
            (= 3 (count x)) (list 'do (list 'rt-reply-to from ref (second x)) (nth x 2))
            :else
              (throw (ex-info (str where ": reply takes a value and the next state")
                              {:form x})))
        (and (list? x) (= 'noreply (first x)))
          (if (= 2 (count x))
            (second x)
            (throw (ex-info (str where ": noreply takes the next state") {:form x})))
        :else x))
    form))

(defn down-pattern
  "This runtime's monitor DOWN message is `[:down ref :process pid reason]`;
   the clause model (and a bundle written for the native backend) spells the
   head `:DOWN`. Translate the head of a DOWN PATTERN only — a body that
   mentions `:DOWN` means it."
  [pat]
  (if (and (vector? pat)
           (not (empty? pat))
           (keyword? (first pat))
           (= "DOWN" (name (first pat))))
    (assoc pat 0 :down)
    pat))

(defn do-form
  "A clause body as ONE form: the form itself, or `(do …)` around several. Nil
   for an empty body — a clause with no body has no next state to hand back."
  [forms]
  (cond
    (empty? forms) nil
    (= 1 (count forms)) (first forms)
    :else (apply list (cons 'do (vec forms)))))

(defn srv-at [v i] (if (< i (count v)) (nth v i) nil))

(defn srv-params
  "A clause's parameter vector, VALIDATED. Each head binds its parameters by
   position — `[from state]` for handle-call, `[state]` for cast and info,
   `[reason state]` for terminate — so a wrong shape is a declaration error with
   a sentence, never an index error from `nth`."
  [params n where clause]
  (if (and (vector? params)
           (= n (count params))
           (every? (fn [x] (symbol? x)) params))
    params
    (throw (ex-info (str where ": " (name (first clause)) " takes " n
                         " parameter(s) in a vector — got " (pr-str params))
                    {:clause clause}))))

(defn lower-arm
  "One plan clause as a `receive` arm of the server loop, or nil when the clause
   is not an arm (init, and anything the vocabulary did not classify)."
  [clause loop-sym st-var ref-var where]
  (let [head (name (first clause))
        parts (vec (rest clause))]
    (cond
      (= head "handle-call")
        (let [params (srv-params (srv-at parts 1) 2 where clause)
              from (nth params 0)
              stx (nth params 1)]
          (list [:call ref-var from (down-pattern (srv-at parts 0))]
                (list loop-sym
                      (list 'let [stx st-var]
                            (rw-reply (do-form (vec (drop 2 parts))) from ref-var where)))))
      (= head "handle-cast")
        (let [stx (nth (srv-params (srv-at parts 1) 1 where clause) 0)]
          (list [:cast (srv-at parts 0)]
                (list loop-sym
                      (list 'let [stx st-var]
                            (rw-reply (do-form (vec (drop 2 parts))) nil ref-var where)))))
      (= head "handle-info")
        (let [stx (nth (srv-params (srv-at parts 1) 1 where clause) 0)]
          (list (down-pattern (srv-at parts 0))
                (list loop-sym
                      (list 'let [stx st-var]
                            (rw-reply (do-form (vec (drop 2 parts))) nil ref-var where)))))
      :else nil)))

(defn lower-defserver
  "Lower `(proc/defserver name clauses…)` to the target's two defn forms, as
   DATA. The plan is `proc.server/clause-plan`'s, run on this source data with
   THIS backend's vocabulary; everything below only renders it."
  [form]
  (let [its (n-items form)
        sname (n-name (second its))
        where (str "defserver " sname)
        clauses (vec (map node->data (drop 2 its)))
        plan (pserver/clause-plan {:name (symbol sname)
                                   :clauses clauses
                                   :vocabulary target-server-vocabulary
                                   :native-heads target-server-native-heads})
        unknown (first (:unknown plan))]
    (when (some? unknown)
      (throw (ex-info (str where ": unknown clause `" (:head unknown)
                           "` — this target's server loop renders: "
                           (join-str (sort (vec target-server-native-heads)) " ")
                           ". The clause model is proc.server/clause-plan, run with THIS"
                           " backend's vocabulary, so a clause no backend contributes is"
                           " reported instead of reaching the codegen — a clause that"
                           " compiled but never ran would be worse than one that did not"
                           " compile.")
                      {:clause (:head unknown) :server sname})))
    (let [loop-sym (symbol (str sname "__server_loop"))
          st-var 'st__server
          ref-var 'ref__server
          why-var 'why__server
          body (vec (:body plan))
          init (first (filter (fn [c] (= "init" (name (first c)))) body))
          terms (vec (filter (fn [c] (= "terminate" (name (first c)))) body))
          arms (vec (keep (fn [c] (lower-arm c loop-sym st-var ref-var where)) body))
          init-parts (if (nil? init) nil (vec (rest init)))
          init-params (if (nil? init) [] (nth init-parts 0))
          init-arg (if (empty? init-params) '_ (first init-params))
          init-body (if (nil? init) {} (ok-strip (do-form (vec (drop 1 init-parts)))))
          stop (list [:stop why-var]
                     (do-form (concat
                                (map (fn [t]
                                       (let [tp (srv-params (srv-at (vec (rest t)) 0) 2 where t)
                                             rp (nth tp 0)
                                             sp (nth tp 1)]
                                         (list 'let [rp why-var sp st-var]
                                               (rw-reply (do-form (vec (drop 1 (vec (rest t)))))
                                                         nil ref-var where))))
                                     terms)
                                (list (list 'erlang/exit why-var)))))
          all (cons stop (to-list arms))
          entry (list 'defn (symbol sname) [init-arg] (list loop-sym init-body))
          flat (reduce (fn [acc pair] (into acc pair)) [] all)
          loop (list 'defn loop-sym [st-var]
                     (apply list (to-list (into ['receive] flat))))]
      (when (empty? arms)
        (throw (ex-info (str where ": the server loop needs at least one"
                             " handle-call, handle-cast or handle-info clause — an"
                             " init alone leaves the target with no loop to run")
                        {:server sname})))
      [entry loop])))

(defn lower-defserver-forms
  "The defn reader nodes a `proc/defserver` declaration lowers to. Printed with
   `pr-str` and read back, so the generated forms go through the SAME reader and
   compiler as hand-written source — the lowering never builds ANF itself."
  [form ns]
  (map (fn [f]
         (with-pos (BeamLisp.Ns.Reader/read_one (pr-str f)) (n-pos form)))
       (lower-defserver form)))

; ─────────────────────────────────────────────────────────────────────────────
; `proc.super/defsupervisor` — one tree declaration, lowered for this target
;
; `defsupervisor` is the ONE supervision-tree declaration a bundle writes. Its
; expansion is `proc.super/supervisor-plan`'s — the SAME pure expander the
; native macro adapter runs — so the strategy, the intensity window, the child
; order, the unique-id check and every declaration diagnostic are decided ONCE,
; for both backends. This file renders the plan it hands back: it never
; re-derives the DSL, and it never calls a native supervisor.
;
; THE RENDERED VALUE, and why it is target-neutral. `defsupervisor` binds its
; name to a ZERO-ARGUMENT CONSTRUCTOR returning a plain spec map — the shape
; runtime.bl section 6 consumes:
;
;   {:name :billing :strategy :one-for-one :intensity [3 5000]
;    :children [{:id :acct :kind :server :target account :args [100]
;                :restart :permanent :shutdown 5000 :type :worker :name nil
;                :order 0} …]}
;
; `:target` is the declared CHILD NAME left as a SYMBOL, so the rendered form
; reaches the same `js/…` global the child's own defn defines — there is no name
; registry and no arity bridge to get wrong. `:args` is the child's init
; argument vector, and the four options are recorded WITH their defaults, so the
; runtime never re-derives one.
;
; WHAT THIS LOWERING REFUSES, and why refusing is the honest answer:
;
;   * an unknown clause head, an invalid strategy, a bad intensity, a duplicate
;     child id, a malformed child — reported through `proc.super`'s OWN
;     diagnostics, the same sentences the native adapter throws, because a
;     declaration that compiled but meant something else is worse than one that
;     did not compile;
;   * a `(pool …)` child. A pool is a sub-supervisor plus a dispatcher on the
;     native path; this target has neither, so a pool is refused BY NAME rather
;     than started as a plain child that would silently lose the pool protocol.

(defn defsupervisor-sym?
  "The spellings of the ONE tree declaration this backend accepts."
  [s]
  (or (= s "defsupervisor")
      (= s "proc.super/defsupervisor")
      (= s "proc/super/defsupervisor")))

(defn defsupervisor-form? [n]
  (and (= :list (n-tag n))
       (let [its (n-items n)]
         (and (not (empty? its)) (defsupervisor-sym? (n-name (first its)))))))

(defn defsupervisor-name [n] (n-name (second (n-items n))))

(defn sup-child-spec
  "One plan child as the spec map this target's supervisor reads. `:target`
   stays the symbol the declaration named."
  [c]
  (let [opts (:options c)]
    {:id (:id c)
     :kind (:kind c)
     :target (:target c)
     :args (vec (:args c))
     :restart (get opts :restart :permanent)
     :shutdown (get opts :shutdown 5000)
     :type (get opts :type :worker)
     :name (get opts :name nil)
     :order (:order c)}))

(defn supervisor-spec-form
  "A plan as the target-neutral BL value `defsupervisor` binds: the tree's
   name, strategy and intensity, and its children in declaration order."
  [p]
  {:name (keyword (:name p))
   :strategy (:strategy p)
   :intensity (:intensity p)
   :children (vec (map sup-child-spec (:children p)))})

(defn lower-defsupervisor
  "Lower `(proc.super/defsupervisor name clauses…)` to ONE defn — the tree's
   zero-argument constructor — as DATA. The plan is
   `proc.super/supervisor-plan`'s, run on this source data; everything below
   only renders it."
  [form]
  (let [its (n-items form)
        name-node (second its)]
    (if (nil? name-node)
      (throw (ex-info "js-actors: defsupervisor needs a tree name" {:form form}))
      (let [sname (n-name name-node)
            where (str "defsupervisor " sname)
            clauses (vec (map node->data (drop 2 its)))
            plan (psuper/supervisor-plan {:name (symbol sname) :clauses clauses})]
        (when (seq (:unknown plan))
          (throw (psuper/unknown-supervisor-clause-error (symbol sname)
                                                         (first (:unknown plan)))))
        (when (seq (:errors plan))
          (throw (psuper/invalid-supervisor-error (symbol sname)
                                                  (first (:errors plan)))))
        (when (some (fn [c] (= :pool (:kind c))) (:children plan))
          (throw (ex-info (str where ": a `pool` child is not implemented on this"
                               " target — the portable subset starts SERVER children,"
                               " so a pool is refused here rather than started as a"
                               " plain child that would lose the pool protocol")
                          {:tree sname :kind :pool})))
        (list (list 'defn (symbol sname) [] (supervisor-spec-form plan)))))))

(defn lower-defsupervisor-forms
  "The defn reader nodes a `proc.super/defsupervisor` declaration lowers to.
   Printed with `pr-str` and read back, exactly like a lowered `defserver`, so
   the generated form goes through the SAME reader and compiler as hand-written
   source."
  [form ns]
  (map (fn [f]
         (with-pos (BeamLisp.Ns.Reader/read_one (pr-str f)) (n-pos form)))
       (lower-defsupervisor form)))

(defn runtime-forms
  "Expand actor declarations into ordinary definition forms. All other source
   forms use the common namespace definition compiler, including value defs."
  [forms ns path]
  (vec (mapcat (fn [form]
                (cond
                  (defserver-form? form) (lower-defserver-forms form ns)
                  (defsupervisor-form? form) (lower-defsupervisor-forms form ns)
                  :else [form])) forms)))

(defn compile-top-form
  "Compatibility entrypoint for declaration fixtures, using common lowering."
  [form ns path]
  (:defs (jsbuild/compile-prepared
    {:path path :ns ns :env (assoc (BeamLisp.Ns.Compiler/new_env ns) :target :js)
     :defs (jsbuild/definition-values (runtime-forms [form] ns path))}
    {:check-node identity})))

(defn compile-defn-form [form ns] (first (compile-top-form form ns "<definition>")))

(defn native-import-call?
  "The native logic module asks the target which statically linked calls use
   its native ABI. Arity checks run before pruning, even for dead definitions."
  [node]
  (when (and (= :remote (:op node)) (= mod-rt (:mod node)) (= :invoke (:fun node)))
    (when-let [link (native-link (first (:args node)))]
      (let [args (second (:args node))]
        (when (or (ir/cons-tail args) (not (ir/accepts-arity? link (count (ir/cons-args args)))))
          (throw (ex-info "js-actors: wrong native import arity" {:node node})))
        (not= :bl (:abi link))))))

(defn compile-source
  "Compile one source file to a vector of {:name name :node node} definitions."
  [path ns]
  (BeamLisp.Env/isolated (fn []
  (let [_ (println (str "js-actors: compiling " path))
        prepared (jsbuild/prepare-ns path
                   {:fallback-ns ns :expand-top runtime-forms
                    :after-ns (fn [_]
                      ; A provider's ns declaration may populate this fork.
                      ; Mask afterward, never changing the parent bindings.
                      (doseq [[key _] (native-links)]
                        (let [parts (string/split key #"/") provider (first parts) name (second parts)]
                          (BeamLisp.Env/put_link provider name (tuple :erlang {} nil))
                          (BeamLisp.Env/intern provider name nil))))
                    :after-staging (fn [staged]
                      ; Macro helper implementations are needed for expansion,
                      ; but their BEAM links are not JavaScript runtime links.
                      (doseq [definition (:defs staged) :when (:name definition)]
                        (BeamLisp.Env/put_link (:ns staged) (:name definition) (tuple :erlang {} nil))))})
        source-ns (:ns prepared) env (:env prepared)
        normalize (fn [node]
                    (ir/rewrite (fn [n]
                                  (if (and (= :global (:op n)) (= source-ns (:ns n)))
                                    (assoc n :ns ns) n)) node))
        defs (:defs (jsbuild/compile-prepared prepared {:check-node identity}))]
    (vec (map (fn [d]
                (let [node (:node d) refs (refs-of [node])]
                  (when (and (not (:js-interop env))
                             (some (fn [r] (and (= :global (first r))
                                               (contains? (native-links) (str (nth r 1) "/" (nth r 2))))) refs))
                    (throw (ex-info "js-actors: native imports require (ns ^:js ...)" {:path path})))
                  (assoc d :node (let [checked (if (:js-interop env) (native/check! node {:native-call? native-import-call?}) node)]
                                   (if (= source-ns ns) checked (normalize checked)))))) defs))))))

(defn canonical-link-context [defs modules leaves used missing]
  (let [own (set (keep :name defs))
        table (assoc (into {} (map (fn [[ns spec]] [ns (set (keys (get spec "exports")))]) modules)) "js" own)
        base (jsbuild/link-ctx {:ns "js" :requires []} table #{} missing leaves #{} used)
        resolve (fn [ns name arity exact]
          (cond
            (get (native-links) (str ns "/" name)) (native-name (str ns "/" name))
            (and (= ns "js") (contains? own name)) (str "H.ref(rt, \"js\", " (js-str name) ")")
            (contains? own (get core-map name)) (str "H.ref(rt, \"js\", " (js-str (get core-map name)) ")")
            :else ((if exact (:resolve-exact base) (:resolve base)) ns name arity)))
        remote (fn [m f arity]
          (cond
            (= m mod-host) (if (contains? host-names (str f))
                              (str "H.hostRef(rt, " (js-str (str f)) ")")
                              (throw (ex-info "Unknown actor host leaf" {:name f})))
            (and (= m mod-erlang) (= f :self)) "H.ref(rt, \"js\", \"rt-self\")"
            (and (= m mod-erlang) (contains? erlang-names (str f))) (str "H.erlangRef(" (js-str (str f)) ")")
            :else ((:remote base) m f arity)))]
    (assoc base :actor true :resolve (fn [ns name arity] (resolve ns name arity false))
           :resolve-exact (fn [ns name arity] (resolve ns name arity true))
           :remote remote :receive "H.ref(rt, \"js\", \"rt-receive\")")))

(defn emit-common-init
  "Initialize the checked kernel and application with the common emitter."
  [defs canonical]
  (sync/reset-state!)
  (let [ctx (canonical-link-context defs (:modules canonical) (:leaves canonical) (:used canonical) (:missing canonical))
        definition (fn [d]
          (let [r (sync/emit (:node d) (assoc ctx :fn-label (:name d))) t (fresh-tmp)]
            (concat (:lines r) [(str "const " t " = " (:val r) ";")]
              (when (:name d) [(str "H.def(rt, " (js-str (str "js/" (:name d))) ", " t ");")]))))
        body (apply str (concat (mapcat definition (filter (fn [d] (= :fn (:kind d))) defs))
                               (mapcat definition (filter (fn [d] (not= :fn (:kind d))) defs))))]
    (str "const R=H.values;const C=Control.bind(rt);"
         (apply str (sync/kw-decls))
         "H.def(rt, \"js/__init\", H.blFn(\"__init\", new Map([[0,function*(rt,args){"
         body "return null;}]]),null));")))

(defn readable? [path]
  (try (do (File/read! path) true) (catch e false)))

(defn resolve-dir
  "Find the directory holding runtime.bl. The documented invocation runs from
   the worktree root (`bl run research/js-actors/compiler.bl`), but running
   from inside the prototype directory is just as reasonable — so try the
   argument, then the root-relative default, then the current directory, and
   report the argument unchanged if none of them hold the sources."
  [dir]
  (loop [cs (list dir "research/js-actors" ".")]
    (if (empty? cs)
      dir
      (if (readable? (str (first cs) "/runtime.bl"))
        (first cs)
        (recur (rest cs))))))

(defn runtime-directory
  "The shipped actor policy and host leaves beside this compiler module."
  []
  (str (Path/dirname (BeamLisp.Loader/source_path "js.actor")) "/actor"))

(defn link-runtime!
  "Link a package to the ordinary build's actor engine, without copying it."
  [output-dir module-base]
  (when-not (and (string? module-base) (seq module-base))
    (throw (ex-info "Actor runtime requires an engine module URL" {})))
  (File/mkdir_p! output-dir)
  (doseq [name ["host" "native" "module"]]
    (File/write! (str output-dir "/" name ".mjs")
      (str "export * from " (json/encode (str module-base "/" name ".mjs")) ";\n"))))

(defn write-runtime!
  "Link actor control to the artifact's canonical value-module URL. The
   compatibility three-arity delegates to this shipped runtime, never a copy."
  ([output-dir value-module]
   (when-not (and (string? value-module) (seq value-module))
     (throw (ex-info "Actor runtime requires a canonical value-module URL" {})))
   (let [source-dir (runtime-directory)]
     (File/mkdir_p! output-dir)
     (File/write! (str output-dir "/host.mjs")
       (String/replace (File/read! (str source-dir "/host.mjs"))
         "'../rt.mjs'" (json/encode value-module)))
     (File/write! (str output-dir "/module.mjs")
       (String/replace (File/read! (str source-dir "/module.mjs"))
         "'../rt.mjs'" (json/encode value-module)))
     (File/write! (str output-dir "/native.mjs")
       (String/replace (File/read! (str source-dir "/native.mjs"))
         "'../native-values.mjs'" "'./native-values.mjs'"))
     (File/cp! (str source-dir "/../native-values.mjs")
               (str output-dir "/native-values.mjs"))))
  ([_source-dir output-dir value-module] (write-runtime! output-dir value-module)))

(defn write-bundle!
  "Link the canonical namespace graph and emit kernel/application frames once."
  [dir output sources defs]
  (erlang/put :js-actors-tmp 0)
  (let [canonical (erlang/get :js-actors-canonical)
        _ (when-not (map? canonical) (throw (ex-info "Actor bundle requires the checked canonical module graph" {})))
        used (atom #{}) missing (atom [])
        body (emit-common-init defs (assoc canonical :used used :missing missing))
        _ (when (seq @missing) (throw (ex-info (str "Actor bundle has unresolved links: " (pr-str @missing)) {:missing @missing})))
        refs (refs-of (map :node defs))
        native-keys (set (keep (fn [r] (when (= :global (first r)) (str (nth r 1) "/" (nth r 2)))) refs))
        native-imports (filter (fn [[key _]] (contains? native-keys key)) (native-links))
        base (:base canonical)
        path (fn [suffix] (json/encode (str base "/" suffix)))
        js (str "// GENERATED by the common js.emit backend.\n"
          "import * as H from '../host.mjs';import * as Control from '../module.mjs';\n"
          "import * as J from " (path "interop.mjs") ";import * as A from " (path "abi.mjs") ";"
          "import * as E_ from " (path "env.mjs") ";import * as L from " (path "leaves.mjs") ";"
          "import " (path "ns/base.mjs") ";\n"
          (apply str (map (fn [ns] (str "import * as N_" (sync/mangle ns) " from " (path (str "ns/" ns ".mjs")) ";\n")) (sort @used)))
          (apply str (map (fn [[key spec]] (let [id (native-name key)]
            (if (= :bl (:abi spec))
              (str "import {" (:export spec) " as " id "} from " (json/encode (:path spec)) ";\n")
              (str "import {" (:export spec) " as " id "_raw} from " (json/encode (:path spec)) ";\n"
                   "const " id "=(...args)=>J.result(" id "_raw(...args.map(J.argument)));\n")))) (sort (vec native-imports))))
          "const rt=H.newRuntime();\n" body "\nawait H.init(rt);\n"
          "export function observationSnapshot(limit=128){return H.ref(rt,'js','rt-observation')(limit); }\n"
          "H.def(rt,'js/entry',H.ref(rt,'js','main'));await H.boot(rt);\n")]
    (File/mkdir_p! (str dir "/out"))
    (File/write! (str dir "/out/" output) js)
    {:defs (count defs) :bytes (erlang/byte_size js)}))

(defn prune-defs
  "Closed ANF reference reachability. Includes function VALUES and hidden receive
   support. A reachable host/ref can name arbitrary globals, so its opaque edge
   retains the entire bundle. No effect inference or suspension rewrite."
  [defs roots]
  (if (some (fn [d] (contains? #{:val :expr} (:kind d))) defs)
    defs
  (let [table (into {} (map (fn [d] [(:name d) d]) defs))
        edge (fn [r]
               (if (= :remote (first r))
                 (if (and (= mod-host (nth r 1)) (= :ref (nth r 2))) :dynamic-registry
                   nil)
                 (when (= :global (first r))
                   (let [ns (nth r 1) name (nth r 2)]
                     (cond (contains? (native-links) (str ns "/" name)) nil
                           (and (= ns "js") (contains? table name)) name
                           (contains? table (get core-map name)) (get core-map name)
                           :else nil)))))
        edges (into {} (map (fn [d]
                              [(:name d)
                               (set (concat (keep edge (refs-of [(:node d)]))
                                      (when (some (fn walk [n] (or (= :recv (:op n)) (some walk (ir/child-nodes n)))) [(:node d)])
                                        ["rt-receive"])))]) defs))]
    (loop [todo (vec roots) seen #{}]
      (if (empty? todo)
        (vec (filter (fn [d] (contains? seen (:name d))) defs))
        (let [name (first todo)]
          (cond (= name :dynamic-registry) defs
                (contains? seen name) (recur (vec (rest todo)) seen)
                :else (do (when-not (contains? table name)
                  (throw (ex-info "js-actors: missing pruning root/dependency" {:name name})))
                (recur (into (vec (rest todo)) (get edges name #{})) (conj seen name))))))))))

(defn native-manifest-links
  "Read compiler-produced module contracts. Relative paths are rooted at the
   normal build output; names, privacy and arities belong to that compilation."
  [path base]
  (when-not (and (string? base) (not (empty? base)))
    (throw (ex-info "js-actors: native manifest needs a module base path" {:path path})))
  (let [manifest (json/decode (File/read! path))]
    (when-not (= 1 (get manifest "version"))
      (throw (ex-info "js-actors: unsupported native module manifest" {:path path})))
    (reduce (fn [links [ns module]]
              (if-not (= true (get module "native")) links
                (reduce (fn [out [name shape]]
                          (assoc out (str ns "/" name)
                            (merge {:abi :bl :path (str base "/ns/" ns ".mjs")
                                    :export (get shape "export") :arities (set (get shape "arities"))}
                                   (when (some? (get shape "variadic-min"))
                                     {:variadic-min (get shape "variadic-min")}))))
                        links (get module "exports"))))
            {} (get manifest "modules"))))

(defn build-one
  "Compile one bundle from the shared runtime, any EXTRA sources, then the
   bundle's APP. The default arity is the original two-source bundle; the
   four-argument form lets an app share a core — the demo bundle compiles
   `runtime + quoted-view-core + quoted-view`. Every source is read, compiled
   and audited BEFORE anything is emitted, so a definition in a core is
   visible to the app that uses it and the allowlist audit sees the whole
   bundle."
  ([dir app output] (build-one dir app output []))
  ([dir app output extras] (build-one dir app output extras {}))
  ([dir app output extras opts]
   (let [prior (erlang/get :js-actors-native-links)
         prior-canonical (erlang/get :js-actors-canonical)
         module-dir (if (:native-manifest opts) (Path/dirname (:native-manifest opts))
                      (do (facade/build! "core" {:out (str dir "/canonical")}) (str dir "/canonical")))
         canonical {:modules (get (json/decode (File/read! (str module-dir "/native-modules.json"))) "modules")
                    :base (or (:native-base opts) "../canonical") :leaves (facade/leaf-names)}
         discovered (when (:native-manifest opts)
                      (native-manifest-links (:native-manifest opts) (:native-base opts)))
         explicit (or (:native-links opts) {})
         _ (when (some (fn [k] (contains? discovered k)) (keys explicit))
             (throw (ex-info "js-actors: native export cannot override compiler metadata" {})))
         links (merge discovered explicit)]
     (doseq [[key spec] links]
       (when-not (contains? #{nil :bl :js} (:abi spec))
         (throw (ex-info "js-actors: unsupported linked callable ABI" {:key key :abi (:abi spec)})))
       (when-not (and (string? key) (string? (:path spec))
                      (regex/re-matches #"[A-Za-z_$][A-Za-z0-9_$]*" (:export spec))
                      (set? (:arities spec))
                      (or (not (empty? (:arities spec)))
                          (and (erlang/is_integer (:variadic-min spec)) (>= (:variadic-min spec) 0)))
                      (every? (fn [n] (and (erlang/is_integer n) (>= n 0))) (:arities spec)))
         (throw (ex-info "js-actors: invalid native link manifest" {:key key}))))
     (erlang/put :js-actors-native-links links)
     (erlang/put :js-actors-canonical canonical)
     (try
   (let [sources (into [(str (runtime-directory) "/runtime.bl")]
                       (concat (map (fn [extra] (str (or (:source-root opts) dir) "/" extra)) extras)
                               [(str (or (:source-root opts) dir) "/" app)]))
         ; one bundle = one compilation unit: ANF local names start over
         _ (BeamLisp.Ns.Compiler/reset-fresh!)
         defs (reduce (fn [acc p] (concat acc (compile-source p "js"))) [] sources)
         ; Emit/audit the entire source before reachability can remove a bad link.
         _ (let [missing (atom [])]
             (emit-common-init defs (assoc canonical :used (atom #{}) :missing missing))
             (when (seq @missing) (throw (ex-info "Actor source has unresolved links" {:missing @missing}))))
         retained (if (:prune opts) (prune-defs defs (into ["main" "bl-main" "rt-observation"] (or (:roots opts) []))) defs)]
     (when (:prune opts) (println (str "js-actors: retained " (count retained) "/" (count defs) " definitions")))
     (write-bundle! dir output sources retained))
       (finally (erlang/put :js-actors-native-links prior) (erlang/put :js-actors-canonical prior-canonical))))))

