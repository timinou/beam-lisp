   "Elixir.BeamLisp.Ns.Rt/not_" "core-not"
   "Elixir.BeamLisp.Ns.Rt/identical?" "rt-identical?"
   "Elixir.BeamLisp.Ns.Rt/hash_key" "rt-hash-key"
   "Elixir.BeamLisp.Ns.Rt/first" "rt-first"
   "Elixir.BeamLisp.Ns.Rt/rest" "rt-rest"
   "Elixir.BeamLisp.Ns.Rt/nth" "rt-nth"
   "Elixir.BeamLisp.Ns.Rt/count" "rt-count"
   ; a string's Unicode codepoints as a list: the one text length both targets
   ; agree on (split/wire.bl `wire-text-length`)
   "unicode/characters_to_list" "rt-codepoints"
   "Elixir.BeamLisp.Ns.Rt/cons" "rt-cons"
   "Elixir.BeamLisp.Ns.Rt/conj" "rt-conj"
   "Elixir.BeamLisp.Ns.Rt/get" "rt-get"
