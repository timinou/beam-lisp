   ; the collection prelude (runtime.bl): value functions app code reaches.
   ; Each maps onto ONE BL definition; a higher-order one calls its argument
   ; through the ordinary call step.
   "Elixir.BeamLisp.Ns.Core/mapv" "rt-mapv"
   "Elixir.BeamLisp.Ns.Core/filterv" "rt-filterv"
