; Conservative compiler facts, derived from checked ANF rather than annotations.
(ns js.evidence (:require [system.ir :as ir] [system.suspension :as suspension]))
(def nonblocking-bifs
  #{:+ :- :* :/ :div :rem :abs :round :trunc :float :is_atom :is_binary
    :is_boolean :is_float :is_function :is_integer :is_list :is_map :is_number
    :is_tuple :tuple_size :element :map_size :byte_size :length :hd :tl
    :== :=== :/= :=/= :< :> :=< :>= :not :and :or :xor})
(defn analyze
  "Infer non-suspension within one checked namespace. Foreign/dynamic/native
   calls remain unknown; this proves neither purity, termination nor a deadline."
  [namespace definitions]
  (let [nodes (into {} (keep (fn [d] (when (= :fn (:kind d)) [(:name d) (:node d)])) definitions))]
    (suspension/analyze nodes
      (fn [proofs]
        (fn [site]
          (if (= :remote (:mode site))
            (and (= :erlang (:mod site)) (contains? nonblocking-bifs (:fun site)))
            (let [callee (:callee site)]
              (and (= namespace (:ns callee)) (get proofs (:name callee) false)))))))))
(defn provenance [unit report]
  {:schema "bl.js.evidence" :version 1 :source (:path unit)
   :source-sha256 (:source-sha256 unit) :rounds (:rounds report)
   :converged (:converged report)
   :definitions (into {} (map (fn [d] [(:name d)
      {:non-suspending (get (:proofs report) (:name d) false)
       :purity "unknown" :termination "unknown" :deadline "unknown"}])
      (filter :name (:defs unit))))})
