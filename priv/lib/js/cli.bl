; priv/lib/js/cli.bl — build a BL namespace graph to ES modules.
;
;   JS_ENTRY=ed.main JS_OUT=out/bl-ed JS_ROOTS=apps/bl-ed[:more] \
;   JS_HOST_FNS=now,measure bl run priv/lib/js/cli.bl
;
; Builds the entry namespace and its requires to ES modules under JS_OUT,
; copying the runtime (rt.mjs, core.mjs) beside them. (Arguments come from
; the environment: `(BeamLisp/argv)` is empty while a script file loads.)
(ns js.cli (:require [js.build :as b]))

(def here (Path/dirname (Path/expand (or (System/get_env "JS_RUNTIME_DIR") "priv/lib/js/build.bl"))))

(defn core-names []
  ; the CORE registry keys, read from core.mjs so the JS file is the one source
  (let [src (File/read! (str here "/core.mjs"))
        i (or (index-of src "export const CORE = {") 0)
        body (subs src i)]
    (set (map second (re-seq #"\"([^\"]+)\": " body)))))

(defn- env! [k]
  (let [v (System/get_env k)]
    (if (blank? v) (throw (ex-info (str "js.cli: set " k) {:var k})) v)))

(defn main []
  (let [entry (env! "JS_ENTRY") out (env! "JS_OUT")
        roots (split (env! "JS_ROOTS") ":")
        t0 (erlang/monotonic_time :millisecond)
        host (set (filter (fn [s] (not (blank? s))) (split (or (System/get_env "JS_HOST_FNS") "") ",")))
        r (b/build {:roots (vec roots) :entry entry :out out :core (core-names) :host host})]
    (doseq [f ["rt.mjs" "core.mjs"]] (File/cp! (str here "/" f) (str out "/" f)))
    (when-not (File/exists? (str out "/host.mjs"))
      (File/write! (str out "/host.mjs") "export const H = globalThis.BL_HOST || {};\n"))
    (println (str "js: " (count (:modules r)) " module(s) " (pr-str (:modules r)) ", "
                  (:bytes r) " bytes, " (- (erlang/monotonic_time :millisecond) t0) " ms -> " out))))

(main)
