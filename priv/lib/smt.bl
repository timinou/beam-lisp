; lib/smt.bl — SMT-LIB as DATA. The one printer between the language and z3.
;
; ── The rule ────────────────────────────────────────────────────────────────
;
; Mathematical content — sorts, declarations, assertions, terms — is written
; in the language as QUOTED FORMS, never as strings. beam-lisp's prefix
; notation IS SMT-LIB's, so a constraint is just a form:
;
;   `(assert (and (>= ~x 0) (<= ~x ~hi)))
;   `(declare-const ~x Int)
;   '(declare-datatype Phase ((Phase-open) (Phase-closed)))
;
; and the ONLY place a form becomes SMT-LIB text is `emit` here, at the z3
; port's edge. Everything upstream — `system.smt`'s translator, the checker,
; `veritas`' generators, an example, a doc — composes forms. Why:
;
;   * a form is inspectable: `(assert (= x2 (+ x 1)))` can be walked, matched,
;     rewritten, printed, and tested as data. A string can be grep'd.
;   * splicing is hygienic: `~x` inserts a symbol; there is no way to forget
;     a space or a paren, and no `(str "(assert " …)` to get subtly wrong.
;   * one printer means one place to be right about SMT-LIB syntax (string
;     escaping, real literals, the `|quoted symbol|` form), instead of 68.
;
; ── The data ────────────────────────────────────────────────────────────────
;
; An SMT term is one of:
;   symbol       `x`, `Int`, `+`, `Phase-open`   → printed as its name
;   integer      42                             → `42`   (negatives as `(- 42)`)
;   float        1.5                            → `1.5`  (Real theory)
;   true / false                                → `true` / `false`
;   string       "hi"                           → `"hi"` (String theory, escaped)
;   keyword      :Int                           → `Int`  (a sort or ctor by name)
;   list/vector  (op a b …)                     → `(op a b …)`
;
; A SCRIPT is a list of commands. `emit` prints a term; `script` prints
; commands one per line, which is what the port sends.

(ns smt)

(defn- escape-string
  "SMT-LIB string literal body: `\"` doubles, everything else verbatim."
  [s]
  (String/replace s "\"" "\"\""))

(defn emit
  "One SMT term (a reader datum or plain data) → its SMT-LIB text."
  [t]
  (cond
    (symbol? t)  (name t)
    (keyword? t) (name t)
    (string? t)  (str "\"" (escape-string t) "\"")
    (= t true)   "true"
    (= t false)  "false"
    (nil? t)     (throw (ex-info "smt/emit: nil is not an SMT term" {}))
    (int? t)     (if (< t 0) (str "(- " (- t) ")") (str t))
    (float? t)   (let [s (str t)] (if (< t 0) (str "(- " (subs s 1) ")") s))
    (or (list? t) (vector? t))
      (str "(" (join " " (map emit t)) ")")
    ; a lazy seq (a `(map …)` nobody forced) is the term it realizes to —
    ; the printer accepts every shape the language produces as a sequence.
    ; `vec`, not `seq`: seq answers nil for an already-realized lazy.
    (let [s (try (vec t) (catch _ :unseqable))]
      (if (or (= s :unseqable) (nil? s))
        (throw (ex-info "smt/emit: not an SMT term" {:term t}))
        (str "(" (join " " (map emit s)) ")")))))

(defn raw
  "A verbatim SMT-LIB text chunk as a SCRIPT ITEM — the cutover boundary
   for legacy strings a caller hands in (declarations, a hand-written
   predicate). Script items may mix forms and raws freely; only new code
   should produce raws."
  [text]
  [:smt/raw text])

(defn script
  "A list of commands → SMT-LIB text, one command per line, trailing newline.
   Nils are skipped (a conditional command is `(smt/assert (when g f))`);
   `(smt/raw text)` items splice verbatim, no quoting."
  [cmds]
  (join ""
        (map (fn [c]
               (if (and (vector? c) (= :smt/raw (first c)))
                 (str (second c) "\n")
                 (str (emit c) "\n")))
             (remove nil? cmds))))

; ── the READER: SMT-LIB text → the form `emit` renders back ─────────────────
;
; The inverse of `emit`, for the ONE boundary where text still enters: a legacy
; caller that hands a predicate as a STRING. An SMT-LIB term IS an s-expression,
; so the language's own reader does the parsing and this section only normalises
; the difference between an SMT atom and a beam-lisp form.
;
; Why it exists: text a caller hands over used to be CONCATENATED into a script
; (`(str "(assert " t ")")`), and concatenation cannot tell a TERM from a STRING
; LITERAL. A predicate that arrived quoted reached z3 as `"z < 0"` — an inert
; value, which z3 answers `sat` to. Reading the text once here keeps that failure
; out of the engine: malformed text THROWS, naming the text, and is never emitted.

(defn- normalise
  "A reader datum → the form `emit` prints back to the same SMT-LIB text.

   ONE difference, and it is the `:keyword` trap: SMT-LIB spells an ATTRIBUTE
   with a colon (`(! t :named n)`) and `emit` prints a keyword as its bare name,
   so `:named` would come back as `named`. Restoring the colon here is why
   `set-option` and core.bl's `named-assert` write `(symbol \":named\")` rather
   than a keyword literal — the tree agrees on this encoding."
  [t]
  (cond
    (keyword? t) (symbol (str ":" (name t)))
    (list? t)    (apply list (map normalise t))
    (vector? t)  (vec (map normalise t))
    :else        t))

(defn read-terms
  "EVERY SMT-LIB command/term in the text BLOCK `text` → a vector of forms.
   A `decls` block is a sequence of declarations; a predicate is one term. Blank
   text is no commands; malformed text THROWS, naming the text."
  [text]
  (let [forms (try (BeamLisp.Compiler/read_all_data text)
                   (catch _ (throw (ex-info (str "smt/read-terms: not SMT-LIB: " text)
                                            {:text text}))))]
    (vec (map normalise forms))))

(defn read-term
  "ONE SMT-LIB term/predicate TEXT → the beam-lisp form `emit` renders back to
   the same SMT-LIB text: `(emit (read-term s))` is the identity on well-formed
   input, up to whitespace. The boundary where a legacy string predicate becomes
   a form — everything downstream composes forms. THROWS on malformed or
   multi-term text, naming the text it was given.

   It is the LANGUAGE's reader with one normalisation pass, not a full SMT-LIB
   parser: an SMT-LIB string literal with a DOUBLED quote (`\"a\"\"b\"`, z3's
   spelling of `a\"b`) reads as two adjacent strings. No caller in this tree
   passes a string literal in a predicate; the round-trip test over the
   predicates callers do pass is examples/z3/06-no-strings.bl."
  [text]
  (let [forms (read-terms text)]
    (if (= 1 (count forms))
      (first forms)
      (throw (ex-info (str "smt/read-term: expected ONE term, got " (count forms) ": " text)
                      {:text text :count (count forms)})))))

; ── conveniences that read well at the call site ────────────────────────────

(defn sym
  "A symbol from string parts: `(sym x \"2\")` → `x2`. For the `x'`-style
   primed state variable that a transition's post-state needs."
  [& parts]
  (symbol (apply str (map (fn [p] (if (symbol? p) (name p) (str p))) parts))))

(defn declare-const
  "`(declare-const x Int)` as data. Names and sorts may be symbols, strings
   or keywords — whatever reads best at the call site."
  [x sort]
  (let [nm (fn [v] (symbol (if (symbol? v) (name v) (str v))))]
    (list 'declare-const (nm x) (nm sort))))

(defn assert
  "`(assert t)` as data; `(assert nil)` is nil so it vanishes from a script."
  [t]
  (when (some? t) (list 'assert t)))

(defn set-option
  "A z3 option as data: `(set-option :timeout 3000)` → `(set-option timeout 3000)`.
   The option name is rendered as a SYMBOL by `emit` (a keyword prints as its bare
   name, which is how `:Int` becomes the sort `Int`) — so the constructor writes the
   `:`, and the encoding stays in this file rather than in every caller.

   This is the ONE thing the tree sets, and it appears as a hand-built string at six
   call sites; a caller that needs another option adds it here."
  [k v]
  (list 'set-option (symbol (str ":" (name k))) v))
