; lib/smt.bl — SMT-LIB as DATA. The one printer between the language and z3.
;
; ── The rule ────────────────────────────────────────────────────────────────
;
; Mathematical content — sorts, declarations, assertions, terms — is written
; in the language as QUOTED FORMS, never as strings. beam-lisp's prefix
; notation IS SMT-LIB's, so a constraint is just a form:
;
;   `(assert (and (>= ~x 0) (<= ~x ~hi)))
;   `(declare-const ~x Int)
;   '(declare-datatype Phase ((Phase-open) (Phase-closed)))
;
; and the ONLY place a form becomes SMT-LIB text is `emit` here, at the z3
; port's edge. Everything upstream — `system.smt`'s translator, the checker,
; `veritas`' generators, an example, a doc — composes forms. Why:
;
;   * a form is inspectable: `(assert (= x2 (+ x 1)))` can be walked, matched,
;     rewritten, printed, and tested as data. A string can be grep'd.
;   * splicing is hygienic: `~x` inserts a symbol; there is no way to forget
;     a space or a paren, and no `(str "(assert " …)` to get subtly wrong.
;   * one printer means one place to be right about SMT-LIB syntax (string
;     escaping, real literals, the `|quoted symbol|` form), instead of 68.
;
; ── The data ────────────────────────────────────────────────────────────────
;
; An SMT term is one of:
;   symbol       `x`, `Int`, `+`, `Phase-open`   → printed as its name
;   integer      42                             → `42`   (negatives as `(- 42)`)
;   float        1.5                            → `1.5`  (Real theory)
;   true / false                                → `true` / `false`
;   string       "hi"                           → `"hi"` (String theory, escaped)
;   keyword      :Int                           → `Int`  (a sort or ctor by name)
;   list/vector  (op a b …)                     → `(op a b …)`
;
; A SCRIPT is a list of commands. `emit` prints a term; `script` prints
; commands one per line, which is what the port sends.

(ns smt)

(defn- escape-string
  "SMT-LIB string literal body: `\"` doubles, everything else verbatim."
  [s]
  (String/replace s "\"" "\"\""))

(defn emit
  "One SMT term (a reader datum or plain data) → its SMT-LIB text."
  [t]
  (cond
    (symbol? t)  (name t)
    (keyword? t) (name t)
    (string? t)  (str "\"" (escape-string t) "\"")
    (= t true)   "true"
    (= t false)  "false"
    (nil? t)     (throw (ex-info "smt/emit: nil is not an SMT term" {}))
    (int? t)     (if (< t 0) (str "(- " (- t) ")") (str t))
    (float? t)   (let [s (str t)] (if (< t 0) (str "(- " (subs s 1) ")") s))
    (or (list? t) (vector? t))
      (str "(" (join " " (map emit t)) ")")
    ; a lazy seq (a `(map …)` nobody forced) is the term it realizes to —
    ; the printer accepts every shape the language produces as a sequence.
    ; `vec`, not `seq`: seq answers nil for an already-realized lazy.
    (let [s (try (vec t) (catch _ :unseqable))]
      (if (or (= s :unseqable) (nil? s))
        (throw (ex-info "smt/emit: not an SMT term" {:term t}))
        (str "(" (join " " (map emit s)) ")")))))

(defn raw
  "A verbatim SMT-LIB text chunk as a SCRIPT ITEM — the cutover boundary
   for legacy strings a caller hands in (declarations, a hand-written
   predicate). Script items may mix forms and raws freely; only new code
   should produce raws."
  [text]
  [:smt/raw text])

(defn script
  "A list of commands → SMT-LIB text, one command per line, trailing newline.
   Nils are skipped (a conditional command is `(smt/assert (when g f))`);
   `(smt/raw text)` items splice verbatim, no quoting."
  [cmds]
  (join ""
        (map (fn [c]
               (if (and (vector? c) (= :smt/raw (first c)))
                 (str (second c) "\n")
                 (str (emit c) "\n")))
             (remove nil? cmds))))

; ── conveniences that read well at the call site ────────────────────────────

(defn sym
  "A symbol from string parts: `(sym x \"2\")` → `x2`. For the `x'`-style
   primed state variable that a transition's post-state needs."
  [& parts]
  (symbol (apply str (map (fn [p] (if (symbol? p) (name p) (str p))) parts))))

(defn declare-const
  "`(declare-const x Int)` as data. Names and sorts may be symbols, strings
   or keywords — whatever reads best at the call site."
  [x sort]
  (let [nm (fn [v] (symbol (if (symbol? v) (name v) (str v))))]
    (list 'declare-const (nm x) (nm sort))))

(defn assert
  "`(assert t)` as data; `(assert nil)` is nil so it vanishes from a script."
  [t]
  (when (some? t) (list 'assert t)))
