; gen/llm.bl — the LLM seam for gen. A PURE-BL orchestrator: no ReqLLM, no
; dep store — OTP's inets/ssl/json, which every bl VM already carries.
;
; One function: `chat`. Messages in, text out. A provider is a small map, so
; any OpenAI-compatible endpoint is one `assoc` away; deepseek is the first
; impl because that is where the key is.
;
; Wire shape (OpenAI chat completions):
;
;   POST {base-url}/chat/completions
;   authorization: Bearer {$key-env}
;   {"model": …, "messages": [{"role": "system", "content": …}, …]}
;
; NB: `messages` must be a LIST of maps, not a vector — bl vectors are Erlang
; tuples and OTP's json encoder refuses tuples ({:unsupported_type …}).

(ns gen.llm)

(def deepseek
  "DeepSeek's OpenAI-compatible endpoint. The first impl."
  {:provider :deepseek
   :base-url "https://api.deepseek.com"
   :model    "deepseek-flash"
   :key-env  "DEEPSEEK_API_KEY"})

(defn- ensure-apps []
  (Application/ensure_all_started :ssl)
  (Application/ensure_all_started :inets))

(defn- encode [v]
  (erlang/iolist_to_binary (json/encode v)))

(defn- content-of
  "The assistant's text out of a chat-completions body."
  [body]
  (let [d  (json/decode body)
        cs (erlang/map_get "choices" d)]
    (if (or (nil? cs) (nil? (erlang/hd cs)))
      {:error {:no-choices body}}
      (let [msg (erlang/map_get "message" (erlang/hd cs))]
        {:ok (erlang/map_get "content" msg)}))))

(defn chat
  "One chat completion against an OpenAI-compatible endpoint.

   `messages` is a LIST of {:role string :content string} maps.
   Returns {:ok text} | {:error {:status n :body b} | {:transport r} | {:no-choices b}}."
  ([messages] (chat deepseek messages))
  ([provider messages]
   (ensure-apps)
   (let [key     (System/get_env (:key-env provider))
         payload (encode {:model (:model provider) :messages messages})
         url     (String/to_charlist (str (:base-url provider) "/chat/completions"))
         headers (list (tuple (String/to_charlist "authorization")
                              (String/to_charlist (str "Bearer " key))))
         r       (httpc/request :post (tuple url headers (String/to_charlist "application/json") payload)
                                (list (tuple :timeout 180000))
                                (list (tuple :body_format :binary)))]
     (if (= :ok (erlang/element 1 r))
       (let [resp   (erlang/element 2 r)
             status (erlang/element 2 (erlang/element 1 resp))
             body   (erlang/element 3 resp)]
         (if (= 200 status)
           (content-of body)
           {:error {:status status :body body}}))
       {:error {:transport (erlang/element 2 r)}}))))
