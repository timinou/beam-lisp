; priv/lib/scenario/runner/kit.bl — the generic runner + video-explorer components.
;
; ══ WHAT THIS IS ════════════════════════════════════════════════════════════
;
; A DOMAIN-NEUTRAL component kit for WATCHING runs: browse a suite, scrub one
; run's timeline, jump to the failure, and (when a recording exists) play the
; frame aligned to the step. Every component is a pure fn of a normalized `Run`
; (scenario.runner.adapt) — it knows verdicts and coordinates, nothing about
; print, scenarios, or any host domain. Drop the kit into any project that can
; emit a Run.
;
; Built ONLY on loom (box/ui/token) — never printflow.kit (that layer speaks
; French print vocabulary; this one must not). NO HTML is generated; every
; component returns hiccup, so it renders in a static page and drives a live
; socket unchanged. Interaction is closed event terms ([:assign …] / [:intent …]
; / [:navigate …]) forwarded by the box — never raw JS.
;
; ══ THE ONE COORDINATE ══════════════════════════════════════════════════════
;
; `at` — the current step index (1-based) — is the whole interface. The scrubber
; lights it, the transport moves it, the claims seek to it, the stage shows the
; world at it. In a live socket it is a LOCAL (`[:assign :at n]`), so moving
; through time is a pure re-render, no server write. This mirrors
; a chronicle-style read-head; a scrubber tick can never seek off the
; log.

(ns scenario.runner.kit
  (:require [loom.box :as b] [loom.ui :as ui] [loom.token :as t]))

;; ════════════════════════════════════════════════════════════════════
;; 0. THE VERDICT PALETTE — colour + mark + word (the a11y floor)
;; ════════════════════════════════════════════════════════════════════
;;
;; The kit's shared vocabulary: a verdict is NEVER colour alone. Each carries a
;; tone (token colour), a mark (glyph), and a word — so it reads for the
;; colour-blind and assistive tech both. One source of truth; every component
;; reads it.

(def verdict-face
  {:proven    {:tone :success :mark "✓" :word "proven"}
   :witnessed {:tone :accent  :mark "◉" :word "witnessed"}
   :refuted   {:tone :danger  :mark "✗" :word "refuted"}
   :unknown   {:tone :warning :mark "?" :word "unknown"}
   :running   {:tone :accent-2 :mark "•" :word "running"}
   :skipped   {:tone :muted   :mark "–" :word "skipped"}})

(defn- face [v] (get verdict-face v (get verdict-face :unknown)))
(defn- vcolor [v] (t/color (:tone (face v))))

;; ════════════════════════════════════════════════════════════════════
;; 1. verdict-badge — the verdict as colour + mark + word
;; ════════════════════════════════════════════════════════════════════

(defn verdict-badge
  "A verdict rendered as a calm pill: coloured mark + the word. `opts`
   = {:size :sm|:md}. The a11y floor — never colour alone."
  ([v] (verdict-badge v {}))
  ([v opts]
   (let [f (face v) sm (= :sm (get opts :size))]
     (b/row {:inline true :gap :2 :align :center
             :pad (if sm [:1 :2] [:1 :3]) :radius :full :bg :surface-2
             :style {:border (str "1px solid " (vcolor v))}}
       [:span {:class (t/sx {:color (vcolor v) :font-weight (t/weight :bold)
                             :font-size (t/text (if sm :xs :sm))})} (:mark f)]
       [:span {:class (t/sx {:color (t/color :text) :font-size (t/text (if sm :xs :sm))
                             :font-weight (t/weight :medium)})} (:word f)]))))

;; ════════════════════════════════════════════════════════════════════
;; 2. verdict-ribbon — a run's headline
;; ════════════════════════════════════════════════════════════════════

(defn verdict-ribbon
  "The run headline: title + verdict badge + a danger border when refuted.
   The first thing you see; it says pass/fail before you read a word."
  [run]
  (let [v (:verdict run)]
    (b/row {:justify :between :align :center :pad [:4 :5] :radius :lg :bg :surface
            :border true
            :style {:border-left (str "4px solid " (vcolor v))}}
      (b/col {:gap :1}
        [:span {:class (t/sx {:font-size (t/text :xs) :letter-spacing "0.08em"
                              :text-transform "uppercase" :color (t/color :muted)})}
         (str (name (:world run)) " · run")]
        [:span {:class (t/sx {:font-size (t/text :xl) :font-weight (t/weight :bold)
                              :color (t/color :text)})} (:title run)])
      (verdict-badge v))))

;; ════════════════════════════════════════════════════════════════════
;; 3. timeline-scrubber — the spine: one tick per step, coloured by verdict
;; ════════════════════════════════════════════════════════════════════

(defn timeline-scrubber
  "The step axis. One tick per step, coloured by that step's verdict; the
   current step is wider and outlined. A tick is a jump through time — a pure
   local `[:assign :at i]`, no server write (the read-head shape).
   `at` is the current 1-based step."
  [run at]
  (let [steps (:steps run)]
    (b/row {:gap :1 :align :center :wrap true :role "slider"
            :aria-label "run timeline" :aria-valuenow (str at)
            :aria-valuemin "1" :aria-valuemax (str (count steps))}
      (for [s steps]
        (let [i (:i s) here (= i at)]
          [:button {:key (str "tick-" i)
                    :type "button"
                    :aria-label (str "step " i " — " (:word (face (:verdict s))))
                    :on-click [:assign :at i]
                    :class (t/sx {:width (if here "26px" "14px") :height "14px"
                                  :border-radius (t/radius :sm)
                                  :background (vcolor (:verdict s))
                                  :border "none" :cursor "pointer" :padding "0"
                                  :outline (if here (str "2px solid " (t/color :text)) "none")
                                  :outline-offset "2px"
                                  :opacity (if here "1" "0.75")
                                  :transition "width .12s ease, opacity .12s ease"})}])))))

;; ════════════════════════════════════════════════════════════════════
;; 4. transport-bar — control time
;; ════════════════════════════════════════════════════════════════════

(defn- t-btn [label ev disabled aria]
  (ui/button {:variant :subtle :size :sm :disabled disabled
              :aria-label aria :on-click ev} label))

(defn transport-bar
  "Playback transport: ⏮ rewind · ◀ prev · ▶/⏸ play · ▶ next · ⏭ live, plus a
   danger 'jump to failure' when the run is refuted. Buttons emit closed event
   terms the socket forwards. `at` scopes prev/next bounds; `n-fail` is the step
   to jump to (or nil)."
  [run at]
  (let [n (count (:steps run))
        first-fail (:step (first (filter (fn [c] (= :refuted (:verdict c))) (:claims run))))]
    (b/row {:gap :2 :align :center}
      (t-btn "⏮" [:assign :at 1] (<= at 1) "rewind to start")
      (t-btn "◀" [:assign :at (max 1 (dec at))] (<= at 1) "previous step")
      (t-btn "▶" [:intent :play {}] false "play")
      (t-btn "▸" [:assign :at (min n (inc at))] (>= at n) "next step")
      (t-btn "⏭" [:assign :at n] (>= at n) "jump to present")
      (when first-fail
        (ui/button {:variant :danger :size :sm
                    :aria-label "jump to first failure"
                    :on-click [:assign :at first-fail]}
          (str "✗ jump to failure"))))))

;; ════════════════════════════════════════════════════════════════════
;; 5. playhead — where am I in time
;; ════════════════════════════════════════════════════════════════════

(defn playhead
  "A mono readout of the coordinate: step k / N · actor · action, and the video
   time when a recording exists. The 'you are here' of the timeline."
  [run at]
  (let [s (nth (:steps run) (dec at) nil)]
    (b/row {:gap :3 :align :center :pad [:2 :3] :radius :md :bg :surface-2}
      [:span {:class (t/sx {:font-family (t/tok :font :mono) :font-size (t/text :sm)
                            :color (t/color :accent) :font-weight (t/weight :bold)})}
       (str "step " at " / " (count (:steps run)))]
      (when s
        [:span {:class (t/sx {:font-size (t/text :sm) :color (t/color :text)})}
         (:label s)])
      (when (and s (:t s))
        [:span {:class (t/sx {:font-family (t/tok :font :mono) :font-size (t/text :xs)
                              :color (t/color :muted)})}
         (str "t=" (:t s) "s")]))))

;; ════════════════════════════════════════════════════════════════════
;; 6. video-stage — the recording, or the state projection (degrade honestly)
;; ════════════════════════════════════════════════════════════════════

(defn- state-lines [view]
  (b/col {:gap :1}
    (for [k (keys view)]
      (b/row {:key (str "kv-" (name k)) :gap :2 :justify :between}
        [:span {:class (t/sx {:font-size (t/text :xs) :color (t/color :muted)})} (name k)]
        [:span {:class (t/sx {:font-family (t/tok :font :mono) :font-size (t/text :xs)
                              :color (t/color :text)})} (pr-str (get view k))]))))

(defn video-stage
  "The SHOW plane. When the run has :media, render the <video> with a seek hook
   bound to the step's time (two-way sync lands with the media event term). With
   NO recording, render the state projection at the head — a fully supported
   mode, never a blank box (DX rule: degrade honestly). `view` is the actor's
   projected world at the head."
  [run at view]
  (let [media (:media run)
        s (nth (:steps run) (dec at) nil)
        tsec (:t s)]
    (b/box {:radius :lg :bg :surface :border true :pad :0
            :style {:overflow "hidden" :min-height "220px"}}
      (if (and media (:src media) tsec)
        [:video {:src (:src media) :poster (:poster media) :controls "true"
                 :data-media-seek (str tsec)     ; hook sets currentTime = tsec
                 :class (t/sx {:width "100%" :display "block" :background "#000"})}]
        (b/col {:gap :3 :pad :5}
          [:span {:class (t/sx {:font-size (t/text :xs) :letter-spacing "0.08em"
                                :text-transform "uppercase" :color (t/color :muted)})}
           "state at this step (no recording)"]
          (if view (state-lines view)
            (ui/prose {:tone :muted} "no projected view for this actor")))))))

;; ════════════════════════════════════════════════════════════════════
;; 7. filmstrip — the whole run at a glance, one cell per step
;; ════════════════════════════════════════════════════════════════════

(defn filmstrip
  "One cell per step, coloured by verdict, the failing one ringed. Click a cell
   to jump. The bird's-eye of the timeline — you see the shape of the run and
   where it went red before scrubbing."
  [run at]
  (b/row {:gap :2 :wrap true}
    (for [s (:steps run)]
      (let [i (:i s) here (= i at) refuted (= :refuted (:verdict s))]
        [:button {:key (str "film-" i) :type "button"
                  :aria-label (str "step " i)
                  :on-click [:assign :at i]
                  :class (t/sx {:width "72px" :height "48px" :cursor "pointer"
                                :border-radius (t/radius :md)
                                :background (t/color :surface-2)
                                :border (str (if here "2px" "1px") " solid "
                                            (if (or here refuted) (vcolor (:verdict s)) (t/color :border)))
                                :display "flex" :align-items "center" :justify-content "center"
                                :color (vcolor (:verdict s)) :font-weight (t/weight :bold)
                                :position "relative"})}
         [:span {:class (t/sx {:font-size (t/text :xs)})} (str i)]]))))

;; ════════════════════════════════════════════════════════════════════
;; 8. claim-list / claim-row — the proof side (refuted first)
;; ════════════════════════════════════════════════════════════════════

(defn claim-row
  "One assertion: mark · message · step link. Clicking seeks the whole page to
   that step (timeline + video + state). Refuted rows read red."
  [claim]
  (let [v (:verdict claim) refuted (= :refuted v)]
    (b/row {:justify :between :align :center :pad [:2 :3] :radius :md
            :bg (if refuted :surface :surface-2)
            :on-click [:assign :at (:step claim)]
            :style (merge {:cursor "pointer"}
                          (when refuted {:border-left (str "3px solid " (t/color :danger))}))}
      (b/row {:gap :3 :align :center}
        [:span {:class (t/sx {:color (vcolor v) :font-weight (t/weight :bold)})} (:mark (face v))]
        [:span {:class (t/sx {:color (t/color :text) :font-size (t/text :sm)})}
         (or (:msg claim) "—")])
      [:span {:class (t/sx {:font-family (t/tok :font :mono) :font-size (t/text :xs)
                            :color (t/color :muted)})} (str "step " (:step claim))])))

(defn claim-list
  "The assertions, worst-first (the adapter already sorts). The proof ledger."
  [run]
  (b/col {:gap :1}
    (if (empty? (:claims run))
      (ui/prose {:tone :muted} "no claims in this run")
      (for [c (:claims run)] (with-meta (claim-row c) {:key (str "claim-" (:step c))})))))

;; ════════════════════════════════════════════════════════════════════
;; 9. witness-card — a refuted claim's falsifying world (payoff #1)
;; ════════════════════════════════════════════════════════════════════

(defn witness-card
  "The receipt of a refutation: the claim, and the world at the basis that
   makes it false. The media slot (:frame) is where a replay frame docks — same
   card, richer evidence — with zero structural change."
  [claim]
  (let [ev (:evidence claim)]
    (b/col {:gap :3 :pad [:4 :5] :radius :lg :bg :surface :border true
            :style {:border-left (str "4px solid " (t/color :danger))}}
      (b/row {:gap :2 :align :center}
        [:span {:class (t/sx {:color (t/color :danger) :font-weight (t/weight :bold)})} "✗"]
        [:span {:class (t/sx {:font-weight (t/weight :semibold) :color (t/color :text)})}
         (str "refuted — step " (:step claim))])
      (ui/prose {:tone :danger :style {:font-size (t/text :sm)}} (:msg claim))
      [:div {:class (t/sx {:font-family (t/tok :font :mono) :font-size (t/text :xs)
                           :color (t/color :muted) :white-space "pre-wrap"})}
       (str "the world at this basis: " (pr-str (:view ev)))]
      (when (:frame ev)
        [:div {:class (t/sx {:font-size (t/text :xs) :color (t/color :accent)})}
         (str "▶ recording frame at t=" (:frame ev) "s")]))))

;; ════════════════════════════════════════════════════════════════════
;; 10. step-card — this frame's trace entry
;; ════════════════════════════════════════════════════════════════════

(defn step-card
  "What happened at the head: kind · actor · action · outcome. The 'this frame'
   readout beside the stage."
  [run at]
  (let [s (nth (:steps run) (dec at) nil)]
    (if (nil? s) (ui/prose {:tone :muted} "no step")
      (b/col {:gap :2 :pad [:3 :4] :radius :md :bg :surface-2}
        (b/row {:gap :2 :align :center :justify :between}
          [:span {:class (t/sx {:font-size (t/text :xs) :text-transform "uppercase"
                                :letter-spacing "0.06em" :color (t/color :muted)})}
           (name (or (:kind (:trace s)) :step))]
          (verdict-badge (:verdict s) {:size :sm}))
        [:span {:class (t/sx {:color (t/color :text) :font-size (t/text :sm)})} (:label s)]
        [:span {:class (t/sx {:font-family (t/tok :font :mono) :font-size (t/text :xs)
                              :color (t/color :muted)})}
         (str "outcome: " (name (or (:outcome (:trace s)) :n/a)))]))))

;; ════════════════════════════════════════════════════════════════════
;; 11. stretch-badge — a run-level property verdict
;; ════════════════════════════════════════════════════════════════════

(defn stretch-badge
  "A whole-run property (e.g. a value that must never change) and its verdict."
  [stretch]
  (b/row {:inline true :gap :2 :align :center :pad [:1 :3] :radius :full
          :bg :surface-2 :style {:border (str "1px solid " (vcolor (:verdict stretch)))}}
    [:span {:class (t/sx {:color (vcolor (:verdict stretch)) :font-weight (t/weight :bold)
                          :font-size (t/text :xs)})} (:mark (face (:verdict stretch)))]
    [:span {:class (t/sx {:font-size (t/text :xs) :color (t/color :muted)})} (name (:kind stretch))]
    [:span {:class (t/sx {:font-size (t/text :xs) :color (t/color :text)})} (:msg stretch)]))

;; ════════════════════════════════════════════════════════════════════
;; 12. run-tile — a run in the suite index
;; ════════════════════════════════════════════════════════════════════

(defn run-tile
  "One run in the suite grid: verdict border, title, world chip, step count,
   and a poster when a recording exists. Reds jump out (DX: land on the
   problem). Clicking navigates to the run detail."
  [run]
  (let [v (:verdict run)]
    (b/col {:gap :3 :pad [:4 :4] :radius :lg :bg :surface :border true
            :on-click [:navigate (str "/run/" (:id run))]
            :style {:cursor "pointer" :border-top (str "3px solid " (vcolor v))}}
      (b/row {:justify :between :align :start :gap :3}
        [:span {:class (t/sx {:font-weight (t/weight :semibold) :color (t/color :text)
                              :font-size (t/text :md)})} (:title run)]
        (verdict-badge v {:size :sm}))
      (b/row {:gap :2 :align :center :wrap true}
        [:span {:class (t/sx {:font-family (t/tok :font :mono) :font-size (t/text :xs)
                              :color (t/color :muted)})}
         (str (count (:steps run)) " steps")]
        [:span {:class (t/sx {:font-size (t/text :xs) :color (t/color :muted)
                              :padding "1px 6px" :border-radius (t/radius :sm)
                              :background (t/color :surface-2)})} (name (:world run))]
        (when (:media run)
          [:span {:class (t/sx {:font-size (t/text :xs) :color (t/color :accent)})} "▶ film"])))))

;; ════════════════════════════════════════════════════════════════════
;; 13. suite-header — the front door's health bar
;; ════════════════════════════════════════════════════════════════════

(defn- tally-stat [label n tone]
  (b/col {:gap :1 :pad [:3 :4] :radius :md :bg :surface-2 :align :center}
    [:span {:class (t/sx {:font-size (t/text :2xl) :font-weight (t/weight :bold)
                          :font-family (t/tok :font :mono) :color (t/color tone)
                          :line-height "1"})} (str n)]
    [:span {:class (t/sx {:font-size (t/text :xs) :color (t/color :muted)})} label]))

(defn suite-header
  "The suite health bar: total · passed · witnessed · failed. The at-a-glance
   pulse of a whole test run. `tally` is scenario.runner.adapt/tally output."
  [title tally]
  (b/col {:gap :4}
    [:span {:class (t/sx {:font-size (t/text :2xl) :font-weight (t/weight :bold)
                          :color (t/color :text)})} title]
    (b/row {:gap :3 :wrap true}
      (tally-stat "total"     (:total tally)     :text)
      (tally-stat "proven"    (:passed tally)    :success)
      (tally-stat "witnessed" (:witnessed tally) :accent)
      (tally-stat "refuted"   (:failed tally)    :danger)
      (tally-stat "unknown"   (:unknown tally)   :warning))))

;; ════════════════════════════════════════════════════════════════════
;; 15. section-title — a quiet labelled divider between panels
;; ════════════════════════════════════════════════════════════════════

(defn section-title
  "A quiet uppercase label to head a panel (Claims, Properties, …)."
  [txt]
  [:div {:class (t/sx {:font-size (t/text :xs) :text-transform "uppercase"
                       :letter-spacing "0.08em" :color (t/color :muted)
                       :font-weight (t/weight :semibold)})} txt])

;; ════════════════════════════════════════════════════════════════════
;; 16. keyboard-hints — the shortcut legend (DX: keyboard-first)
;; ════════════════════════════════════════════════════════════════════

(defn keyboard-script
  "The keyboard driver, injected once by the run page. Keys map onto the SAME
   buttons a mouse uses — every shortcut is a transport click through the
   ordinary event path — so the keyboard can never diverge from the pointer.
   space auto-plays by stepping `next` until the deck disables itself (the
   run's end); any other transport key stops playback. A window flag guards
   the navigate/remount double-install. Single-quoted JS only: beam-lisp
   strings cannot carry escaped double quotes."
  []
  [:script {:key "kbd"}
   "(function(){if(window.__bpKeys)return;window.__bpKeys=true;"
   "var t=null;"
   "function b(l){return Array.from(document.querySelectorAll('button')).find(function(x){return x.getAttribute('aria-label')===l;});}"
   "function go(l){var x=b(l);if(x&&!x.disabled)x.click();}"
   "function stop(){if(t){clearInterval(t);t=null;}}"
   "document.addEventListener('keydown',function(e){"
   "if(e.target&&/INPUT|TEXTAREA/.test(e.target.tagName))return;"
   "var k=e.key;"
   "if(k==='ArrowLeft'){stop();go('previous');}"
   "else if(k==='ArrowRight'){stop();go('next');}"
   "else if(k==='Home'){stop();go('to start');}"
   "else if(k==='End'){stop();go('to end');}"
   "else if(k==='f'){go('jump to first failure');}"
   "else if(k===' '){e.preventDefault();"
   "if(t){stop();}"
   "else{t=setInterval(function(){var n=b('next');if(!n||n.disabled){stop();}else{n.click();}},950);}}"
   "});})();"])

(defn keyboard-hints
  "The keyboard legend — exactly what keyboard-script implements. A promise
   here is a contract: drop a shortcut from the script and it drops from this
   line, or the legend becomes folklore."
  []
  (b/row {:gap :3 :wrap true :align :center :pad [:2 :3] :radius :md :bg :surface-2}
    (for [[k d] [["←/→" "step"] ["space" "play"] ["f" "jump to fail"]
                 ["Home/End" "ends"]]]
      (b/row {:key k :gap :1 :align :center}
        [:kbd {:class (t/sx {:font-family (t/tok :font :mono) :font-size (t/text :xs)
                             :padding "1px 5px" :border-radius (t/radius :sm)
                             :background (t/color :surface-3) :color (t/color :text)
                             :border (str "1px solid " (t/color :border))})} k]
        [:span {:class (t/sx {:font-size (t/text :xs) :color (t/color :muted)})} d]))))
