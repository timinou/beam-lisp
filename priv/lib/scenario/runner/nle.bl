; priv/lib/scenario/runner/nle.bl — the non-linear editor chrome.
;
; ══ WHAT THIS IS ════════════════════════════════════════════════════════════
;
; The runner, shot like a professional NLE (Premiere / Resolve / Final Cut). A
; scenario run IS a timeline: steps are clips, the head is the playhead, the
; frame (scenario.runner.frame) is what the program monitor shows. This module
; is the editor CHROME around that frame — built on loom (box/token/ui), so it
; is semantic and theme-driven, never ad-hoc HTML.
;
; Layout it provides (composed by runner.app):
;   ┌─────────────────────────────┬───────────────┐
;   │  PROGRAM MONITOR (the frame) │  INSPECTOR    │
;   │  + monitor scrubline         │  (claims,     │
;   ├─────────────────────────────┤   properties, │
;   │  TRANSPORT DECK               │   witness)    │
;   ├─────────────────────────────┴───────────────┤
;   │  TIMECODE RULER                               │
;   │  VIDEO TRACK  [clip][clip][clip] ← playhead   │
;   │  VERDICT TRACK ▓▓▓░░░                          │
;   └───────────────────────────────────────────────┘
;
; One coordinate — `at` (the current step) — is the playhead. A click on any
; clip / ruler tick is `[:assign :at n]`: a pure re-render at a new basis, no
; server write (the a chronicle read-head, on the wire).

(ns scenario.runner.nle
  (:require [loom.box :as b] [loom.ui :as ui] [loom.token :as t]
            [scenario.runner.frame :as frame]))

;; ── shared verdict palette (mirrors runner.kit; the NLE is a peer view) ──
(def ^:private vhue
  {:proven "#3fb950" :witnessed "#5b8def" :refuted "#e5534b"
   :unknown "#d29922" :running "#7c5cff" :skipped "#5f656b"})
(defn- vcol [v] (get vhue v "#9aa0a6"))
(defn vcol-pub "Public verdict colour, for the app title bar." [v] (vcol v))

(defn timecode
  "Format measured media seconds as HH:MM:SS; absent clocks stay absent."
  [seconds]
  (if (nil? seconds) "—"
    (let [n (erlang/trunc (max 0 seconds))
          pad (fn [i] (if (< i 10) (str "0" i) (str i)))]
      (str (pad (quot n 3600)) ":" (pad (mod (quot n 60) 60)) ":" (pad (mod n 60))))))

(defn- tc [i] (str "step " i))

(defn- position [run i]
  (if (get-in run [:media :src])
    (timecode (get-in run [:steps (dec i) :t])) (tc i)))

(defn- panel
  "A dark NLE panel with a hairline top border and an uppercase label."
  [label & body]
  (b/col {:gap :0 :radius :lg :style {:overflow "hidden"
                                      :background "#0e1013"
                                      :border "1px solid #23272d"}}
    [:div {:class (t/sx {:font-size "11px" :letter-spacing "0.14em"
                         :text-transform "uppercase" :color "#6b7377"
                         :font-weight "700" :padding "9px 14px"
                         :background "#121519"
                         :border-bottom "1px solid #23272d"})} label]
    (apply b/col {:gap :0 :pad :0} body)))

;; ════════════════════════════════════════════════════════════════════
;; 1. program-monitor — the big frame + a monitor scrubline
;; ════════════════════════════════════════════════════════════════════

(defn program-monitor
  "The program monitor: the frame at the head, framed like a broadcast monitor
   (a thin bezel, a status LED strip). `step` is the adapted step map; `at`/`n`
   drive the scene + timecode. `order` is the STABLE actor order for the
   multiviewer (derived once from the run, so panes never reshuffle mid-scrub).

   When the step carries per-actor `:screens`, the monitor is a MULTIVIEWER —
   every actor's live screen at this basis, side by side, the acting actor lit
   (you see the operator's jam and the commercial's slipping promise at once).
   With one screen it is a single frame; with none, the neutral poster. All
   three come from `frame/multiviewer`, which degrades on its own."
  [step at n verdict order]
  (panel (str "Program monitor · scene " at " / " n)
    (b/box {:pad :4 :style {:background "#000"}}
      (b/box {:radius :md :style {:overflow "hidden"
                                  :border (str "1px solid " (vcol verdict))
                                  :box-shadow (str "0 0 0 1px #000, 0 18px 50px -12px " (vcol verdict) "55")}}
        (frame/multiviewer {:uid "mon"
                            :scene at
                            :actor (:actor step)
                            :verdict (:verdict step)
                            :view (get (:views step) (:actor step))
                            ;; per-actor real screens (multiviewer); when a step
                            ;; carries none, :screens is nil → multiviewer falls to
                            ;; the poster via its own {} default.
                            :screens (:screens step)
                            :routes (:routes step)
                            :order order
                            ;; single-frame fallback path (one screen / poster)
                            :html (:screen step)
                            :route (:route step)
                            :label (:label step)
                            :timecode (tc at)
                            :recording? true})))))

;; ════════════════════════════════════════════════════════════════════
;; 2. transport-deck — the pro playback bar (a real deck)
;; ════════════════════════════════════════════════════════════════════

(defn- deck-btn [glyph ev disabled aria big]
  [:button {:type "button" :aria-label aria
            :on-click ev
            :disabled disabled
            :class (t/sx {:width (if big "52px" "40px") :height "36px"
                          :display "inline-flex" :align-items "center" :justify-content "center"
                          :background (if big "#1c2126" "#151a1e")
                          :color (if disabled "#4a5157" "#d6dee2")
                          :border "1px solid #2a3037" :border-radius (t/radius :md)
                          :font-size "15px" :cursor (if disabled "default" "pointer")})}
   glyph])

(defn transport-deck
  "The transport deck: jog to start · prev · play · next · jog to end, a live
   timecode, and a danger jump-to-failure. The command centre."
  [run at]
  (let [n (count (:steps run))
        first-fail (:step (first (filter (fn [c] (= :refuted (:verdict c))) (:claims run))))]
    (b/row {:justify :between :align :center :pad [:3 :4]
            :radius :lg :style {:background "#0e1013" :border "1px solid #23272d"}}
      (b/row {:gap :2 :align :center}
        (deck-btn "⏮" [:assign :at 1] (<= at 1) "to start" false)
        (deck-btn "◀" [:assign :at (max 1 (dec at))] (<= at 1) "previous" false)
        (if (get-in run [:media :src])
          [:button {:type "button" :aria-label "play" :data-media-toggle "1"
                    :style {:background "#5b8def" :color "#fff" :border "none"
                            :padding "8px 14px" :border-radius "6px" :cursor "pointer"}} "▶"]
          (deck-btn "▶" [:intent :play {}] false "play" true))
        (deck-btn "▶" [:assign :at (min n (inc at))] (>= at n) "next" false)
        (deck-btn "⏭" [:assign :at n] (>= at n) "to end" false))
      (b/row {:gap :4 :align :center}
        [:span {:class (t/sx {:font-family (t/tok :font :mono) :font-size "18px"
                              :font-weight "700" :letter-spacing "1px"
                              :color "#e8f0ec"
                              :background "#05070a" :padding "6px 12px"
                              :border-radius (t/radius :md) :border "1px solid #23272d"})}
         (if (get-in run [:media :src])
           (str (position run at) " / " (timecode (when (:duration-ms run) (/ (:duration-ms run) 1000))))
           (str (tc at) " / " n))]
        (when first-fail
          [:button {:type "button" :aria-label "jump to first failure"
                    :on-click [:assign :at first-fail]
                    :class (t/sx {:display "inline-flex" :align-items "center" :gap "6px"
                                  :background "#e5534b" :color "#fff" :font-weight "700"
                                  :font-size "13px" :padding "8px 14px" :border "none"
                                  :border-radius (t/radius :md) :cursor "pointer"})}
           "✗ jump to failure"])))))

;; ════════════════════════════════════════════════════════════════════
;; 3. the timeline — ruler + clip track + verdict track
;; ════════════════════════════════════════════════════════════════════
;;
;; The heart of an NLE. Steps are laid out as clips of equal width on a track;
;; the playhead is an absolutely-positioned needle at the current step; a ruler
;; above marks timecodes; a verdict track below colours the run's health.

(defn- mini-frame
  "A small thumbnail for a clip — the REAL screen scaled to a chip when the
   step carries one (:screen), else the abstract poster. A row of them reads as
   a filmstrip of the actual app."
  [step at]
  (if (:screen step)
    (frame/screen-thumb {:uid (str "clip" at) :html (:screen step)})
    (frame/poster {:uid (str "clip" at)
                   :scene at :actor (:actor step) :verdict (:verdict step)
                   :view (get (:views step) (:actor step))
                   :label "" :timecode (tc at) :recording? false})))

(defn- clip
  "One clip on the video track: a mini-frame with a verdict base-strip, a scene
   number, lit when it is the playhead. Clicking seeks."
  [step at here?]
  (let [v (:verdict step)]
    [:button {:type "button" :aria-label (str "scene " at) :data-timeline-step at
              :on-click [:assign :at at]
              :class (t/sx {:position "relative" :flex "1 1 0" :min-width "0"
                            :padding "0" :cursor "pointer" :overflow "hidden"
                            :border-radius (t/radius :sm)
                            :border (if here? "2px solid #e8f0ec" (str "1px solid " (vcol v) "88"))
                            :background "#000"
                            :box-shadow (if here? "0 0 0 2px #05070a, 0 8px 22px -6px #000" "none")
                            :opacity (if here? "1" "0.82")})}
     (b/box {:style {:pointer-events "none"}} (mini-frame step at))
     ;; verdict base-strip
     [:div {:class (t/sx {:height "4px" :background (vcol v)})}]
     ;; scene tag, top-left
     [:div {:class (t/sx {:position "absolute" :top "5px" :left "6px"
                          :font-family (t/tok :font :mono) :font-size "11px"
                          :font-weight "700" :color "#fff"
                          :background "#00000090" :padding "1px 5px"
                          :border-radius "3px"})} (str at)]]))

(defn- ruler
  "A timecode ruler across the track: a tick + label per step."
  [run]
  (b/row {:gap :2 :align :stretch :style {:padding "0 2px"}}
    (for [s (:steps run)]
      [:div {:key (str "rule-" (:i s))
             :class (t/sx {:flex "1 1 0" :min-width "0"
                           :font-family (t/tok :font :mono) :font-size "10px"
                           :color "#5f676d" :letter-spacing "0.5px"
                           :border-left "1px solid #23272d" :padding "3px 0 3px 5px"})}
       (position run (:i s))])))

(defn- verdict-track
  "The verdict lane: a proportional bar per step in its verdict colour — the
   health of the run as a single glance, aligned under the clips."
  [run at]
  (b/row {:gap :2 :align :stretch :style {:padding "0 2px"}}
    (for [s (:steps run)]
      [:div {:key (str "vt-" (:i s))
             :class (t/sx {:flex "1 1 0" :min-width "0" :height "10px"
                           :border-radius "2px"
                           :background (vcol (:verdict s))
                           :opacity (if (= (:i s) at) "1" "0.55")
                           :outline (if (= (:i s) at) "1px solid #e8f0ec" "none")})}])))

(defn timeline
  "The full NLE timeline: ruler · VIDEO track of clips · VERDICT track, with the
   playhead needle riding over the current clip. One click on any clip seeks the
   whole editor to that step."
  [run at]
  (panel "Timeline"
    (b/col {:gap :2 :pad :3 :style {:background "#0b0d10"}}
      (ruler run)
      ;; the video track — clips fill the width, equal share
      (b/row {:gap :2 :align :stretch :style {:min-height "84px"}}
        (for [s (:steps run)]
          (with-meta (clip s (:i s) (= (:i s) at)) {:key (str "clip-" (:i s))})))
      ;; a track label + the verdict lane
      (b/row {:gap :3 :align :center}
        [:span {:class (t/sx {:font-family (t/tok :font :mono) :font-size "10px"
                              :color "#5f676d" :min-width "54px"})} "VERDICT"]
        (b/box {:style {:flex "1 1 0"}} (verdict-track run at))))))

;; ════════════════════════════════════════════════════════════════════
;; 4. clip-inspector — the "what happened at this cut" readout
;; ════════════════════════════════════════════════════════════════════

(defn clip-inspector
  "The inspector's per-clip head: scene, actor, verdict chip, outcome — the
   metadata of the current cut, like a clip's properties panel."
  [step at n]
  (let [v (:verdict step)]
    (panel "Clip"
      (b/col {:gap :3 :pad :4}
        (b/row {:justify :between :align :center}
          [:span {:class (t/sx {:font-family (t/tok :font :mono) :font-size "13px"
                                :color "#8b949e"})} (str "scene " at " / " n)]
          [:span {:class (t/sx {:display "inline-flex" :align-items "center" :gap "6px"
                                :font-size "12px" :font-weight "700" :color (vcol v)
                                :padding "3px 10px" :border-radius (t/radius :full)
                                :border (str "1px solid " (vcol v))})}
           (str "● " (String/upcase (name v)))])
        [:span {:class (t/sx {:font-size "15px" :color "#e8f0ec" :line-height "1.4"})}
         (:label step)]
        [:span {:class (t/sx {:font-family (t/tok :font :mono) :font-size "12px"
                              :color "#6b7377"})}
         (str "cut " (name (or (:kind (:trace step)) :step))
              " · outcome " (name (or (:outcome (:trace step)) :na)))]))))

;; a re-export so the app can title inspector sub-sections consistently.
(defn section-title [txt]
  [:div {:class (t/sx {:font-size "11px" :text-transform "uppercase"
                       :letter-spacing "0.14em" :color "#6b7377"
                       :font-weight "700"})} txt])

;; ════════════════════════════════════════════════════════════════════
;; 5. inspector-claims — the assertion list, NLE-styled, seek-on-click
;; ════════════════════════════════════════════════════════════════════

(defn- claim-line [run c at]
  (let [v (:verdict c) here? (= at (:step c))]
    [:button {:type "button" :aria-label (str "scene " (:step c))
              :on-click [:assign :at (:step c)]
              :class (t/sx {:display "flex" :align-items "center" :gap "10px"
                            :width "100%" :text-align "left" :cursor "pointer"
                            :padding "9px 11px" :border-radius (t/radius :md)
                            :background (if here? "#161b20" "transparent")
                            :border (str "1px solid " (if here? "#2a3138" "transparent"))
                            :border-left (str "3px solid " (if (= v :refuted) (vcol v)
                                               (if here? (vcol v) "transparent")))})}
     [:span {:class (t/sx {:color (vcol v) :font-weight "700" :font-size "14px"})}
      (if (= v :refuted) "✗" (if (= v :proven) "✓" "◉"))]
     [:span {:class (t/sx {:flex "1 1 0" :min-width "0" :color "#d6dee2" :font-size "13px"
                           :line-height "1.35"})} (or (:msg c) "—")]
     [:span {:class (t/sx {:font-family (t/tok :font :mono) :font-size "11px"
                           :color "#5f676d"})} (position run (:step c))]]))

(defn inspector-claims
  "The proof ledger for the inspector: assertions worst-first, each a seek. A
   click jumps the playhead to that cut — chase a failure straight to its frame."
  [run at]
  (panel "Claims"
    (b/col {:gap :1 :pad :2}
      (if (empty? (:claims run))
        [:div {:class (t/sx {:padding "12px" :color "#6b7377" :font-size "13px"})}
         "no claims"]
        (for [c (:claims run)]
          (with-meta (claim-line run c at) {:key (str "ic-" (:step c))}))))))

;; ════════════════════════════════════════════════════════════════════
;; 6. witness — the falsifying world, values formatted (no raw Interval leak)
;; ════════════════════════════════════════════════════════════════════

(defn witness
  "The receipt of a refutation: the claim, and the falsifying world at its basis
   — each projected value formatted (an Interval reads 'Fri 14:00', never its raw
   struct). The frame slot (W1 recording) docks here unchanged."
  [claim]
  (let [view (get-in claim [:evidence :view])]
    (b/col {:gap :3 :pad [:4 :4] :radius :lg
            :style {:background "#1a0e10" :border "1px solid #5c2027"
                    :border-left "4px solid #e5534b"}}
      (b/row {:gap :2 :align :center}
        [:span {:class (t/sx {:color "#e5534b" :font-weight "700"})} "✗"]
        [:span {:class (t/sx {:font-weight "700" :color "#e8f0ec" :font-size "14px"})}
         (str "refuted — scene " (:step claim))])
      [:span {:class (t/sx {:color "#f0b9b4" :font-size "13px" :line-height "1.4"})}
       (:msg claim)]
      ;; the falsifying world, as a clean KV table
      (b/col {:gap :1 :pad [:2 :3] :radius :md :style {:background "#0c0709"}}
        (if (or (nil? view) (empty? view))
          [:span {:class (t/sx {:color "#8b949e" :font-size "12px"})} "no witness view"]
          (for [k (keys view)]
            (b/row {:key (str "w-" (name k)) :gap :3 :justify :between}
              [:span {:class (t/sx {:font-family (t/tok :font :mono) :font-size "11px"
                                    :color "#7d8a84"})} (String/upcase (name k))]
              [:span {:class (t/sx {:font-family (t/tok :font :mono) :font-size "12px"
                                    :color "#e8f0ec" :font-weight "600"})}
               (frame/fmt (get view k))])))))))
