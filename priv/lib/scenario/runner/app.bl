; priv/lib/scenario/runner/app.bl — the runner as a live app: browse a suite, open
; a run, scrub its timeline. Domain-neutral; the SUITE is the only thing a host
; swaps.
;
; ══ WHAT THIS IS ════════════════════════════════════════════════════════════
;
; A two-screen live.app over the runner kit:
;   /runs        — the suite: every run as a tile, health at a glance
;   /run/:id     — one run: verdict ribbon · scrubber · transport · the SHOW
;                  plane (video or state) · the PROVE plane (claims + witness)
;
; The whole interface is ONE coordinate — `:at`, the current step — held as a
; socket LOCAL. A scrubber tick / transport button is `[:assign :at n]`: a
; pure re-render at a new coordinate, no server write to move through time (the
; the read-head shape, now on the wire). This is why time-travel
; needs no :observe feed — a finished run is a value; scrubbing is projection.
;
; The library ships NO runs. A host builds its Suite from real scenario
; results (adapted to the normalized Run via scenario.runner.adapt), injects it
; with `set-suite!`, then `serve`s — and gets the whole UI unchanged.
;
; Host example: examples/scenario/01-two-actors-converge.bl
; Screens: /runs · /run/:id

(ns scenario.runner.app
  (:require [datom] [datom.time :as time]
            [web] [live.app :as app] [live.hiccup :as h]
            [loom.box :as b] [loom.ui :as ui] [loom.token :as t]
            [scenario :as s]
            [scenario.runner.adapt :as adapt]
            [scenario.runner.kit :as rk]
            [scenario.runner.nle :as nle]))

;; ════════════════════════════════════════════════════════════════════
;; 1. THE SUITE — injected by the host, held in persistent_term
;; ════════════════════════════════════════════════════════════════════
;;
;; A web request runs in Bandit's own process (no shared process-dict with the
;; seed), so the adapted Runs live in persistent_term where every request
;; process reads the same value — the printflow.live lesson.

(def ^:private SUITE-KEY :scenario.runner/suite)
(defn- the-suite [] (try (erlang/apply :persistent_term :get (list SUITE-KEY)) (catch _e nil)))
(defn set-suite! [sui] (erlang/apply :persistent_term :put (list SUITE-KEY sui)) sui)

;; ════════════════════════════════════════════════════════════════════
;; 2. WORLDS / PRINCIPAL — the suite is the world; :at is a local
;; ════════════════════════════════════════════════════════════════════

(defn- principal [_conn] "viewer")
(defn worlds [_me _params] {:suite (the-suite)})

;; public reader: hosts and tests read the seeded suite (the-suite is private)
(defn suite [] (the-suite))

(defn- find-run [suite id]
  (first (filter (fn [r] (= id (:id r))) (:runs suite))))

;; ════════════════════════════════════════════════════════════════════
;; 3. SCREENS
;; ════════════════════════════════════════════════════════════════════

(app/defscreen runs-screen [{:keys [db]}]
  (let [suite (db :suite)]
    (b/col {:gap :6 :max-w "1080px" :pad [:7 :6] :style {:margin "0 auto"}}
      (rk/suite-header (:title suite) (adapt/tally suite))
      (b/grid {:min-col "300px" :gap :4}
        (for [r (:runs suite)]
          (with-meta (rk/run-tile r) {:key (:id r)}))))))

(app/defscreen run-screen [{:keys [db params locals]}]
  (let [suite (db :suite)
        run (find-run suite (:id params))]
    (if (nil? run)
      (b/col {:pad :7} (ui/prose {:tone :muted} (str "no run " (:id params))))
      (let [n (count (:steps run))
            at (let [a (get locals :at)] (if (and a (>= a 1) (<= a n)) a (if (get-in run [:media :src]) 1 n)))
            step (nth (:steps run) (dec at) nil)
            v (:verdict step)
            ;; the STABLE multiviewer pane order: every actor across the whole
            ;; run, in first-appearance order. Derived once from the run (not
            ;; the step) so the pane grid keeps identical shape+slots on every
            ;; scrub — the patch contract wants morph-in-place, never a reshuffle.
            order (reduce (fn [acc s]
                            (let [a (:actor s)]
                              (if (or (nil? a) (some (fn [x] (= x a)) acc)) acc
                                (conj acc a))))
                          [] (:steps run))
            refc (first (filter (fn [c] (and (= at (:step c)) (= :refuted (:verdict c)))) (:claims run)))]
        ;; the NLE workspace: a full-bleed dark editor, three regions.
        (b/col {:gap :4 :pad [:4 :5 :6 :5]
                :style {:max-width "1600px" :margin "0 auto"}}
          ;; ── title bar ────────────────────────────────────────────
          (b/row {:justify :between :align :center}
            (b/row {:gap :4 :align :center}
              [:a {:href "/runs"
                   :class (t/sx {:font-size "13px" :color "#8b949e"
                                 :display "inline-flex" :align-items "center" :gap "6px"})}
               "← runs"]
              [:span {:class (t/sx {:font-size "20px" :font-weight "800" :color "#e8f0ec"})}
               (:title run)]
              [:span {:class (t/sx {:display "inline-flex" :align-items "center" :gap "6px"
                                    :font-size "12px" :font-weight "700" :color (nle/vcol-pub v)
                                    :padding "3px 10px" :border-radius "999px"
                                    :border (str "1px solid " (nle/vcol-pub v))})}
               (str "● " (String/upcase (name v)))])
            [:span {:class (t/sx {:font-family (t/tok :font :mono) :font-size "12px"
                                  :color "#5f676d"})}
             (str (name (:world run)) " · " n " scenes")])
          ;; ── top region: PROGRAM MONITOR ∣ INSPECTOR ──────────────
          (b/grid {:grid "minmax(0,1.85fr) minmax(0,1fr)" :gap :4 :align :start}
            (b/col {:gap :4}
              (if (get-in run [:media :src])
                (rk/video-stage run at (get (:views step) (:actor step)))
                (nle/program-monitor step at n v order))
              (nle/transport-deck run at))
            (b/col {:gap :4}
              ;; KEYED regions, with ATTR keys (not metadata): the differ
              ;; reads either, but the CLIENT addresses a keyed op via
              ;; data-key in the DOM — metadata keys never render, so a keyed
              ;; :remove would silently no-op and leave a ghost block. The
              ;; witness block exists only while the head step carries a
              ;; refuted claim; its comings and goings must be a keyed
              ;; remove/insert of ONE stable node, never a positional
              ;; shuffle (the scrambled-inspector glitch).
              [:div {:key "inspector"} (nle/clip-inspector step at n)]
              [:div {:key "claims"} (nle/inspector-claims run at)]
              (when refc
                [:div {:key "witness"}
                 (b/col {:gap :2}
                   (nle/section-title "Witness")
                   (nle/witness refc))])
              [:div {:key "properties"}
               (b/col {:gap :2}
                 (nle/section-title "Properties")
                 (b/wrap {:gap :2}
                   (for [st (:stretches run)]
                     (with-meta (rk/stretch-badge st) {:key (:msg st)}))))]))
          ;; ── bottom region: THE TIMELINE (filmstrip) ──────────────
          (nle/timeline run at)
          (rk/keyboard-hints)
          (rk/media-script)
          (rk/keyboard-script))))))

;; ════════════════════════════════════════════════════════════════════
;; 4. APP VALUE + serve
;; ════════════════════════════════════════════════════════════════════

(defn app-value []
  {:title "Blueprint runner"
   :home "/runs"
   :principal principal
   :worlds worlds
   ;; THE RUNNER'S OWN THEME — load-bearing, not cosmetic. The NLE chrome is
   ;; authored for loom's DARK defaults (#0b0c0e canvas, #e8f0ec text, 8px
   ;; radius). loom themes are process-local: `warm-style` runs at boot in a
   ;; process the host's `film` may have tainted with ITS brand (printflow
   ;; installs a cream palette + 9px radius while SSR'ing its screens), while
   ;; every HTTP request renders in a fresh Bandit process. Without an explicit
   ;; :theme those two disagree — warm captures cream/9px class hashes, the
   ;; request emits dark/8px hashes, and 25 chrome classes ship RULELESS (grey
   ;; UA buttons, dark text on the leaked cream canvas). Declaring the theme
   ;; pins EVERY render — warm and request — to the same defaults, so the class
   ;; names match the warmed sheet. live.app/dispatch documents this contract.
   ;; `install-theme! {}` = pure loom defaults, immune to any brand a prior
   ;; render left in the process dict.
   :theme (fn [] (t/install-theme! {}))
   :observe (fn [_me] [])            ; a finished run is a value; scrubbing is a local
   :intents {:play (fn [_s _p _me] nil)}   ; play is a client concern (FUP-007); no server write
   :routes [["/runs" runs-screen]
            ["/run/:id" run-screen]]
   :warm-me "viewer"
   ;; warm EVERY reachable route: the head <style> ships every class a live
   ;; patch can name, so unwarmed screens paint ruleless. Derived from the
   ;; SUITE — a host's injected runs must warm too, not just the model seed's.
   :warm (into ["/runs"]
               (mapv (fn [r] (str "/run/" (name (:id r)))) (:runs (the-suite))))})

(defn serve
  "Serve the runner on `port`. The host MUST have injected its suite first
   (`set-suite!`): the library ships no runs of its own — see
   examples/scenario/01-two-actors-converge.bl for a complete host."
  [port]
  (when (nil? (the-suite))
    (throw (ex-info "scenario.runner.app/serve: no suite — call set-suite! first" {})))
  (app/serve (app-value) {:port port}))
