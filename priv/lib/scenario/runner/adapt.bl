; priv/lib/scenario/runner/adapt.bl — the reusability seam: any result → a Run.
;
; ══ WHY THIS FILE ═══════════════════════════════════════════════════════════
;
; The runner kit (scenario.runner.*) renders ONE normalized value — a `Run` —
; and knows nothing else. A host project meets the kit by writing an adapter to
; this shape; the kit never reaches back into the project's domain. This file is
; the adapter FOR scenario (the reference producer); a Jest, Pytest,
; or Playwright suite would ship its own `of-*` beside it, emitting the same Run.
;
; The Run is deliberately a plain map (not a record): serializable, diffable,
; and the whole contract fits on a screen (see `run` docstring). Everything the
; scenario result already computes — :bases (one basis/step), :verdicts,
; :trace, bisect views — projects straight in; the kit adds no new truth, only
; a normalized surface over it.
;
; ══ THE Run SHAPE (the entire host contract) ════════════════════════════════
;
;   {:id :title :verdict :duration-ms :tags :world           ; identity
;    :media {:kind :src :poster :marks [{:step :t}]}         ; the recording (opt)
;    :steps [{:i :label :actor :verdict :t :views :trace}]   ; one frame/step
;    :claims [{:msg :verdict :step :evidence{:view :frame}}] ; the proof
;    :stretches [{:kind :verdict :msg}]}                     ; run-level props
;
; Required: :id :title :verdict :steps. All else optional — the kit degrades
; (no :media → state projection; no :steps → empty-state). See 20-runner-kit.md.

(ns scenario.runner.adapt
  (:require [scenario :as s]))

;; ── verdict helpers (shared vocabulary the whole kit reads) ─────────

(def verdict-order
  "Worst-first: a runner surfaces failures before successes (DX rule D1)."
  {:refuted 0 :unknown 1 :running 2 :witnessed 3 :skipped 4 :proven 5})

(defn verdict-rank [v] (get verdict-order v 9))

(defn roll-up
  "The one verdict for a whole run: the WORST of its claims + stretches. A
   single refutation makes the run red; all-proven reads green."
  [claims stretches]
  (let [vs (concat (map :verdict claims) (map :verdict stretches))]
    (if (empty? vs) :unknown
      (reduce (fn [a b] (if (<= (verdict-rank a) (verdict-rank b)) a b)) vs))))

(defn- slugify [s]
  ;; plain string ops only (no regex literals in beam-lisp) — mirrors
  ;; slug: trim, downcase, spaces→dashes.
  (if (nil? s) "run"
    (String/replace (String/trim (String/downcase (str s))) " " "-")))

;; ── the step frames ─────────────────────────────────────────────────
;;
;; One entry per trace step, carrying the coordinate (:basis) the chronicle/
;; bisect reads and the per-actor views AT that basis. `:t` is the video-time
;; for this step when a recording exists (nil otherwise → the kit shows state).

(defn- step-label [entry]
  (let [ev (:action entry) tag (first ev)
        who (name (or (:actor entry) "?"))]
    (case tag
      :sees   (str who " sees — " (or (nth ev 3 nil) "claim"))
      :expect (str who " expects — " (or (:because entry) "claim"))
      :does   (str who " does " (pr-str (nth ev 2 nil)))
      :act    (str who " acts — " (name (first (nth ev 2 nil))))
      :witness (str who " witnesses")
      :beat   "—"
      (str (name tag)))))

(defn- steps-of [result marks]
  (let [t-of (into {} (map (fn [m] [(:step m) (:t m)]) marks))
        ;; scenario marks an ACT with :n/a — no assertion was made, so no
        ;; verdict. But the runner's tally colors need a word: an act that
        ;; happened on the floor is WITNESSED (the v2 word for "this
        ;; happened"), never unknown, or every act step paints alarm-amber.
        verdict (fn [v] (if (contains? #{:n/a :a nil} v) :witnessed v))]
    (mapv (fn [entry]
            (let [n (:step entry)]
              {:i n
               :label (step-label entry)
               :actor (:actor entry)
               :verdict (verdict (:verdict entry))
               :t (get t-of n nil)
               :basis (nth (:bases result) (dec n) nil)
               :views (:views (s/bisect result n))
               :trace {:kind (first (:action entry))
                       :outcome (:outcome entry)
                       :action (:action entry)}}))
          (:trace result))))

;; ── the claims (proof side), refuted first ──────────────────────────

(defn- claims-of [result marks]
  (let [t-of (into {} (map (fn [m] [(:step m) (:t m)]) marks))]
    (->> (:verdicts result)
         (mapv (fn [v]
                 (let [frame (get-in v [:evidence])
                       t (get t-of (:step v) nil)]
                   {:msg (:msg v)
                    :verdict (:verdict v)
                    :step (:step v)
                    :actor (:actor v)
                    :evidence {:view (get (:views (s/bisect result (:step v))) (:actor v))
                               :basis (:evidence v)
                               :frame t}})))
         (sort-by (fn [c] (verdict-rank (:verdict c)))))))

;; ════════════════════════════════════════════════════════════════════
;; of-scenario — the reference adapter
;; ════════════════════════════════════════════════════════════════════

(defn of-scenario
  "Normalize a `scenario` run result into a Run. `opts` supplies the
   host-side extras the scenario layer does not know: {:id :tags :duration-ms
   :media}. `:media` (optional) is {:kind :src :poster :marks [{:step :t}]} —
   the step↔video-time map that powers two-way scrubbing; omit it and the kit
   renders the state projection instead (a fully supported no-video mode)."
  ([result] (of-scenario result {}))
  ([result opts]
   (let [marks (get-in opts [:media :marks] [])
         claims (claims-of result marks)
         stretches (mapv (fn [st] {:kind (:kind st) :verdict (:verdict st)
                                   :msg (:msg st)})
                         (:stretches result))]
     {:id       (or (:id opts) (slugify (:name result)))
      :title    (or (:name result) "run")
      :verdict  (roll-up claims stretches)
      :duration-ms (:duration-ms opts)
      :tags     (or (:tags opts) [])
      :world    (or (:world result) :model)
      :media    (:media opts)
      :steps    (steps-of result marks)
      :claims   claims
      :stretches stretches})))

;; ════════════════════════════════════════════════════════════════════
;; of-browser — a browser take → a Run (see 52-browser-evidence-contract.md)
;; ════════════════════════════════════════════════════════════════════
;;
;; The browser leg of the same seam: a DESCRIPTOR (the authored, fingerprinted
;; evidence a take must satisfy) and a MANIFEST (what the take actually did),
;; plus the CURRENT expected provenance the report supplies independently of the
;; stored manifest. Nothing here touches the filesystem or the network: the host
;; passes the shot availability/view resolvers, so a removed capture cannot be
;; counted as green.
;;
;; The rule that governs every branch: only a matching, terminal COMPLETE take
;; with positively complete beats/assertions/shots yields :witnessed frames.
;; Browser evidence is NEVER :proven — the model producer owns that word. Nil,
;; empty, legacy, stale, running, global failure and incomplete takes produce no
;; newly witnessed green: they read unknown/running/refuted, with the reason in
;; each frame's :trace.

(defn- name-of [k] (if (keyword? k) (name k) (str k)))

(defn- pick
  "First key present in `m` among candidates `ks` (keyword or string form).
   Absent is nil; `contains?` decides presence, so a present nil/false is never
   confused with a missing key."
  [m ks]
  (when (map? m)
    (let [hit (some (fn [k] (when (contains? m k) k)) ks)]
      (when (some? hit) (get m hit)))))

(defn- nonempty [s] (and (string? s) (pos? (count s))))

(def ^:private DT (erlang/binary_to_atom "Elixir.DateTime"))

(defn- iso-ms
  "An ISO-8601 instant string -> epoch milliseconds, or nil when absent or
   unparseable. The core DateTime reader (the same one the connectors use):
   the adapter READS a clock, it never invents one."
  [s]
  (when (nonempty s)
    (let [r (erlang/apply DT :from_iso8601 (list s))]
      (when (= :ok (erlang/element 1 r))
        (erlang/apply DT :to_unix (list (erlang/element 2 r) :millisecond))))))

(defn- nm [v] (if (nil? v) nil (name-of v)))

;; ── descriptor + expected-provenance normalization (once) ───────────
;; A descriptor is accepted either as the keyword map printflow.film/descriptor
;; returns, or as the camelCase JSON `evidence` object a launcher parsed. Both
;; land on the SAME keyword shape here; nothing downstream re-decides a key.

(defn- norm-actor [a]
  {:role (pick a [:role "role"])
   :path (pick a [:path "path"])
   :viewport (pick a [:viewport "viewport"])})

(defn- norm-actors [as]
  (into {} (map (fn [kv] [(name-of (key kv)) (norm-actor (val kv))]) (to-list (or as {})))))

(defn- norm-shot [s]
  {:step (pick s [:step "step"])
   :actor (nm (pick s [:actor "actor"]))
   :name (pick s [:name "name"])})

(defn- present? [m ks] (boolean (some (fn [k] (contains? m k)) ks)))

(defn- norm-op-req [r]
  {:step (pick r [:step "step"])
   :actor (nm (pick r [:actor "actor"]))
   :op (pick r [:op "op"])})

(defn- norm-assert-req [r]
  (cond-> {:step (pick r [:step "step"])
           :actor (nm (pick r [:actor "actor"]))
           :kind (pick r [:kind "kind"])}
    (present? r [:selector "selector"]) (assoc :selector (pick r [:selector "selector"]))
    (present? r [:text "text"]) (assoc :text (pick r [:text "text"]))
    (present? r [:value-ref "valueRef"]) (assoc :value-ref (pick r [:value-ref "valueRef"]))))

(defn- norm-beat [b]
  {:id (nm (pick b [:id "id"]))
   :title (pick b [:title "title"])
   :actor (nm (pick b [:actor "actor" :who "who"]))
   :missing? (= true (pick b [:missing? "missing" :missing "missing?"]))
   :hole (pick b [:hole "hole"])
   :caveat (pick b [:caveat "caveat"])
   :at (pick b [:at "at"])
   :screen (pick b [:screen "screen"])
   :roster (vec (or (pick b [:roster "roster"]) []))
   :required-steps (vec (or (pick b [:required-steps "requiredSteps"]) []))
   :required-ops (vec (map norm-op-req (or (pick b [:required-ops "requiredOps"]) [])))
   :required-assertions (vec (map norm-assert-req (or (pick b [:required-assertions "requiredAssertions"]) [])))
   :required-shots (vec (map norm-shot (or (pick b [:required-shots "requiredShots"]) [])))})

(defn- normalize-descriptor [d]
  (when (map? d)
    (let [beats (pick d [:beats "beats"])]
      {:schema-version (pick d [:schema-version "schemaVersion"])
       :id (nm (pick d [:id "id"]))
       :title (pick d [:title "title"])
       :actors (norm-actors (pick d [:actors "actors"]))
       :story-fingerprint (pick d [:story-fingerprint "storyFingerprint" :storyFingerprint])
       :beats (vec (map norm-beat (or beats [])))})))

(defn- normalize-expected [p]
  (when (map? p)
    {:source (pick p [:source-fingerprint "sourceFingerprint" :sourceFingerprint])
     :runtime (pick p [:runtime-version "runtimeVersion" :runtimeVersion])
     :server (pick p [:server-runtime-version "serverRuntimeVersion" :serverRuntimeVersion])}))

;; ── manifest access (JSON: string keys) ─────────────────────────────

(defn- mget [m k] (pick m [k (keyword k)]))

(defn- assert-msg [a]
  (let [actor (or (nm (mget a "actor")) "?")
        kind (or (mget a "kind") "assert")
        sel (mget a "selector")
        txt (mget a "text")
        err (mget a "error")
        ok? (= true (mget a "ok"))]
    (str actor " " kind
         (when (nonempty txt) (str " " txt))
         (when (nonempty sel) (str " " sel))
         (when (and (not ok?) (nonempty err)) (str " — " err)))))

(defn- find-shot [shots rs]
  (some (fn [rec]
          (when (and (= (:step rs) (mget rec "step"))
                     (= (:actor rs) (nm (mget rec "actor")))
                     (= (:name rs) (mget rec "name")))
            rec))
        shots))

;; Small constructors keep the shape of a claim/frame/stretch in ONE place — a
;; host reads them structurally, and a single constructor cannot drift.

(defn- claim [msg verdict step beat actor src-step evidence]
  {:msg msg :verdict verdict :step step :beat beat :actor actor
   :src-step src-step :evidence evidence})

(defn- evid
  ([kind selector text error] (evid kind selector text error nil))
  ([kind selector text error extra]
   (merge {:kind kind :selector selector :text text :error error
           :basis nil :frame nil :view nil}
          extra)))

(defn- stretch [kind verdict msg] {:kind kind :verdict verdict :msg msg})

(defn- beat-rows [coll id]
  (filter (fn [x] (= id (mget x "beat"))) coll))

(defn- index-rows
  "Index `coll` by `key-fn` → row, recording COLLISIONS instead of silently
   taking the last. A duplicate key cannot be interpreted as evidence, so it is
   surfaced as a manifest anomaly (`:dups`), never resolved to one row."
  [coll key-fn]
  (reduce (fn [acc x]
            (let [k (key-fn x)]
              (if (contains? (:by acc) k)
                {:by (:by acc) :dups (assoc (:dups acc) k true)}
                {:by (assoc (:by acc) k x) :dups (:dups acc)})))
          {:by {} :dups {}}
          coll))

(defn- req-op-row-ok?
  "A required step is positively complete only when an EXISTING manifest step
   row matches the expected actor, beat and op and is status complete. A
   pending/running/absent row is not completion; a mismatched row is worse."
  [beat-id rop row]
  (and (some? row)
       (= "complete" (mget row "status"))
       (= (:op rop) (mget row "op"))
       (= (:actor rop) (nm (mget row "actor")))
       (= beat-id (mget row "beat"))))

(defn- assert-req-match?
  "A manifest assert row satisfies a required assertion when index, beat, actor
   and kind agree, and the requirement's selector / static expected literal (when
   specified) match exactly. A `:value-ref` requirement matches on identity —
   the reference's runtime value is never inlined as plaintext."
  [ra a]
  (and (= (:step ra) (mget a "step"))
       (= (:actor ra) (nm (mget a "actor")))
       (= (:kind ra) (mget a "kind"))
       (if (contains? ra :selector) (= (:selector ra) (mget a "selector")) true)
       (if (contains? ra :text) (= (:text ra) (mget a "text")) true)))

(defn- assert-claim [b idx a pos-complete? witness-ok?]
  (let [ok? (= true (mget a "ok"))
        actor (nm (mget a "actor"))
        cv (if ok? (if (and witness-ok? pos-complete?) :witnessed :unknown) :refuted)]
    (claim (assert-msg a) cv (inc idx) (:id b)
           (when (nonempty actor) (keyword actor))
           (mget a "step")
           (evid (mget a "kind") (mget a "selector") (mget a "text") (mget a "error")))))

(defn- shot-claim [ctx b idx rs pos-complete? witness-ok?]
  (let [rec (find-shot (:screenshots ctx) rs)
        ok? ((:shot-satisfied? ctx) rs)
        actor (:actor rs)
        cv (if ok? (if (and witness-ok? pos-complete?) :witnessed :unknown) :refuted)]
    (claim (str (or actor "?") " screenshot " (:name rs)) cv
           (inc idx) (:id b)
           (when (nonempty actor) (keyword actor))
           (:step rs)
           (evid :shot nil nil nil
                 {:name (:name rs)
                  :path (when (some? rec) (mget rec "path"))
                  :sha256 (when (some? rec) (mget rec "sha256"))}))))

(defn- shot-views [ctx b]
  (let [sv (:shot-view ctx)]
    (reduce (fn [acc rs]
              (let [rec (find-shot (:screenshots ctx) rs)]
                (if (and (some? rec) ((:shot-ok? ctx) rec))
                  (let [view (if (nil? sv)
                               {:step (mget rec "step") :beat (mget rec "beat")
                                :actor (nm (mget rec "actor")) :name (mget rec "name")
                                :path (mget rec "path") :sha256 (mget rec "sha256")}
                               (sv rec))]
                    (if (nonempty (:actor rs))
                      (assoc acc (keyword (:actor rs)) view)
                      acc))
                  acc)))
            {} (:required-shots b))))

(defn- beat-frame [b idx v reason rids missing-steps missing-shots
                   failed-asserts beat-errors views prov-note]
  {:i (inc idx)
   :id (:id b)
   :label (or (:title b) (:id b) (str "beat " (inc idx)))
   :actor (when (nonempty (:actor b)) (keyword (:actor b)))
   :verdict v
   :t nil
   :views views
   :trace {:kind :beat
           :beat (:id b)
           :status (case v :witnessed "complete" :refuted "failed"
                         :skipped "skipped" "unknown")
           :reason reason
           :required-steps rids
           :missing-steps missing-steps
           :missing-shots (mapv :name missing-shots)
           :failed-asserts (mapv assert-msg failed-asserts)
           :errors beat-errors
           :provenance prov-note}})

(defn- beat-outcome
  "One descriptor beat, against the manifest. Returns
   {:frame Run-frame :claims [claim] :refuted? bool}.

   A beat is positively witnessed ONLY when a manifest beats row exists with
   status exactly complete, its completedSteps cover every required index, and
   every required op has a complete matching (actor/beat/op) step row and every
   required assertion has an explicit successful matching row. There must be an
   actual positive event: an empty non-missing executable beat is never a pass.
   Duplicate indexes/ids, mismatched rows and extra failed evidence all refuse
   the witness rather than being resolved by a first match."
  [ctx b idx]
  (let [terminal? (:terminal? ctx)
        complete-take? (:complete? ctx)
        witness-ok? (:witness-ok? ctx)
        struct-bad? (:struct-bad? ctx)
        rids (:required-steps b)
        rops (:required-ops b)
        ras (:required-assertions b)
        rshots (:required-shots b)
        step-by-i (:step-by-i ctx)
        row-at (fn [i] (get step-by-i i))
        mbeat (get (:beat-by-id ctx) (:id b))
        mbeat-complete? (and (map? mbeat) (= "complete" (mget mbeat "status")))
        mbeat-failed? (and (map? mbeat) (= "failed" (mget mbeat "status")))
        completed (if (map? mbeat) (set (or (mget mbeat "completedSteps") [])) #{})
        covers? (every? (fn [i] (contains? completed i)) rids)
        ;; A required step is missing when no complete matching row exists; it is
        ;; WRONG (contradictory, not merely absent) when a complete row exists
        ;; but names another actor/beat/op.
        missing-ops (vec (remove (fn [r] (req-op-row-ok? (:id b) r (row-at (:step r)))) rops))
        wrong-ops (vec (filter (fn [r]
                                 (let [row (row-at (:step r))]
                                   (and (some? row)
                                        (= "complete" (mget row "status"))
                                        (not (req-op-row-ok? (:id b) r row)))))
                               rops))
        ops-cover? (every? (fn [i] (some (fn [r] (= i (:step r))) rops)) rids)
        beat-asserts (vec (beat-rows (:asserts ctx) (:id b)))
        failed-asserts (vec (remove (fn [a] (= true (mget a "ok"))) beat-asserts))
        missing-ras (vec (remove (fn [ra] (some (fn [a] (assert-req-match? ra a)) beat-asserts)) ras))
        satisfied-ras (vec (filter (fn [ra]
                                     (some (fn [a] (and (assert-req-match? ra a)
                                                        (= true (mget a "ok"))))
                                           beat-asserts))
                                   ras))
        missing-shots (vec (remove (:shot-satisfied? ctx) rshots))
        beat-errors (vec (beat-rows (:step-errors ctx) (:id b)))
        failed-steps (vec (filter (fn [s] (and (= (:id b) (mget s "beat"))
                                               (= "failed" (mget s "status"))))
                                  (:steps ctx)))
        empty-beat? (and (not (:missing? b)) (empty? rids) (empty? ras) (empty? rshots))
        positive? (boolean (or (some (fn [r] (req-op-row-ok? (:id b) r (row-at (:step r)))) rops)
                               (seq satisfied-ras)
                               (some (:shot-satisfied? ctx) rshots)))
        hard? (or struct-bad? (seq wrong-ops) (seq failed-asserts) (seq beat-errors)
                  mbeat-failed? (seq failed-steps) (not ops-cover?))
        soft? (or (seq missing-ops) (seq missing-ras) (not mbeat-complete?)
                  (not covers?) (not positive?) (seq missing-shots))
        refuted? (or hard? (and terminal? soft?))
        pos-complete? (and complete-take? witness-ok? (not hard?) (not struct-bad?)
                            (empty? missing-ops) (empty? missing-ras)
                            mbeat-complete? covers? positive?
                            (empty? missing-shots) (empty? failed-asserts)
                            (empty? beat-errors))
        v (cond (:missing? b) :skipped
                refuted? :refuted
                (and pos-complete? witness-ok?) :witnessed
                :else :unknown)
        reason (cond
                 (:missing? b) (str "authored hole: " (or (:hole b) "not built"))
                 refuted? (cond
                            struct-bad? "manifest has duplicate step index or beat id"
                            (seq wrong-ops) "required step present but actor/beat/op mismatch"
                            (seq failed-asserts) (str (count failed-asserts) " assertion(s) failed")
                            mbeat-failed? "beat marked failed"
                            (seq beat-errors) (str (count beat-errors) " beat error(s)")
                            (seq failed-steps) (str (count failed-steps) " step(s) failed")
                            (not ops-cover?) "descriptor declares required steps without required ops"
                            :else "required evidence missing")
                 (and pos-complete? witness-ok?) "positively complete"
                 empty-beat? "authored beat declares no required evidence"
                 (not mbeat-complete?) "manifest beat absent or not complete"
                 (not covers?) "completedSteps does not cover every required step"
                 (seq missing-ras) "required assertion has no successful row"
                 (seq missing-ops) "required step is missing or incomplete"
                 (seq missing-shots) "required shot missing"
                 (not terminal?) "take is not terminal"
                 (not complete-take?) "take is not a matching complete take"
                 :else "evidence incomplete")
        missing-assert-claims (mapv (fn [ra]
                                      (let [cv (if (and terminal? complete-take?) :refuted :unknown)]
                                        (claim (str "required " (or (:actor ra) "? ") (:kind ra)
                                                    " assertion has no successful row")
                                               cv (inc idx) (:id b)
                                               (when (nonempty (:actor ra)) (keyword (:actor ra)))
                                               (:step ra)
                                               (evid (:kind ra) (:selector ra) (:text ra)
                                                     "no matching successful assertion"))))
                                    missing-ras)
        a-claims (mapv (fn [a] (assert-claim b idx a pos-complete? witness-ok?)) beat-asserts)
        s-claims (mapv (fn [rs] (shot-claim ctx b idx rs pos-complete? witness-ok?)) rshots)]
    {:refuted? refuted?
     :frame (beat-frame b idx v reason rids (mapv :step missing-ops) missing-shots
                        failed-asserts beat-errors (shot-views ctx b) (:prov-note ctx))
     :claims (vec (concat a-claims s-claims missing-assert-claims))}))

(defn- orphan-claim
  "An assertion the manifest attributes to a beat the descriptor never authored
   is an anomaly, not evidence — refuted, with its raw identity kept."
  [a]
  (let [actor (nm (mget a "actor"))]
    (claim (str (assert-msg a) " (unknown beat)") :refuted
           nil (mget a "beat")
           (when (nonempty actor) (keyword actor))
           (mget a "step")
           (evid (mget a "kind") (mget a "selector") (mget a "text") (mget a "error")))))

(defn of-browser
  "Normalize a browser take into a Run.

   `descriptor` is the authored evidence descriptor (keyword map from
   printflow.film/descriptor, or its camelCase JSON `evidence`). `manifest` is
   the JSON take record; `expected-provenance` is the CURRENT expected
   {:source-fingerprint :runtime-version :server-runtime-version} — the adapter
   never treats the stored manifest as its own expectation.

   A complete take is not a witness unless its provenance carries
   `sourceFingerprintAfter` (nonempty and equal to BOTH the before
   `sourceFingerprint` and the expected source — the source was measured on
   both sides of the take), and its `startedAt`/`finishedAt` are valid ISO
   instants in order. Missing/null/drifted post-source or invalid/reversed
   instants read stale/time with no witnessed frame; `:duration-ms` is derived
   from the parse and absent when unknown, never invented.

   `opts`: {:available-shot? (fn [shot] bool)  ; host: does the artifact exist?
            :shot-view (fn [shot] view)}       ; host: evidence link for a still

   PURE: no filesystem or network. Returns the existing Run shape, with one
   frame per authored beat (stable :id) and browser evidence :witnessed, never
   :proven."
  ([descriptor manifest expected-provenance]
   (of-browser descriptor manifest expected-provenance {}))
  ([descriptor manifest expected-provenance opts]
   (let [opts (or opts {})
         D (normalize-descriptor descriptor)
         desc-ok? (and (map? D) (nonempty (:id D)) (seq (:beats D)))
         schema-ok? (= 1 (:schema-version D))
         expected (normalize-expected expected-provenance)
         expected-shape? (or (nil? expected-provenance) (map? expected-provenance))
         m (when (map? manifest) manifest)
         m-schema (mget m "schemaVersion")
         run-id (mget m "runId")
         status (mget m "status")
         started (mget m "startedAt")
         finished (mget m "finishedAt")
         started-ms (iso-ms started)
         finished-ms (iso-ms finished)
         ;; Valid instants: startedAt must parse; finishedAt, when present,
         ;; must parse and not precede the start. An unparseable or reversed
         ;; pair is never a witness — the duration it implies is nonsense.
         time-ok? (boolean (and (some? started-ms)
                                (or (not (nonempty finished))
                                    (and (some? finished-ms) (<= started-ms finished-ms)))))
         time-note (cond
                     (not (nonempty started)) "take has no startedAt instant"
                     (nil? started-ms) "take startedAt is not an ISO instant"
                     (and (nonempty finished) (nil? finished-ms)) "take finishedAt is not an ISO instant"
                     (and (some? finished-ms) (< finished-ms started-ms))
                     "take finishedAt precedes startedAt"
                     :else "take instants are ordered")
         prov (mget m "provenance")
         prov-map? (map? prov)
         m-name (mget m "name")
         m-story (mget prov "storyFingerprint")
         m-source (mget prov "sourceFingerprint")
         m-source-after (mget prov "sourceFingerprintAfter")
         m-runtime (mget prov "runtimeVersion")
         m-server (mget prov "serverRuntimeVersion")
         expected-src (:source expected)
         expected-rt (:runtime expected)
         expected-srv (:server expected)
         story-fp (:story-fingerprint D)
         story-match? (and (nonempty story-fp) (nonempty m-story) (= story-fp m-story))
         id-match? (and desc-ok? (nonempty m-name) (= (:id D) m-name))
         source-match? (and expected-shape? prov-map? (nonempty expected-src)
                            (nonempty m-source) (= expected-src m-source))
         ;; The take's source identity is measured TWICE — before and after —
         ;; and BOTH must equal the host's independent expectation. An absent,
         ;; null or drifted after-fingerprint is not a witness: it cannot prove
         ;; the bytes the evidence ran against did not move during the take.
         source-after-present? (and prov-map? (nonempty m-source-after))
         source-after-match? (and expected-shape? source-after-present?
                                  (nonempty expected-src)
                                  (= m-source-after m-source)
                                  (= m-source-after expected-src))
         runtime-match? (and expected-shape? prov-map? (nonempty expected-rt)
                             (nonempty m-runtime) (= expected-rt m-runtime))
         server-match? (and prov-map? (nonempty m-runtime) (nonempty m-server)
                            (= m-runtime m-server)
                            (if (nonempty expected-srv) (= expected-srv m-server) true))
         prov-ok? (and prov-map? story-match? id-match? source-match? source-after-match?
                     runtime-match? server-match?)
         terminal? (and (nonempty run-id) (nonempty finished) time-ok?
                        (contains? #{"complete" "failed" "aborted"} status))
         complete? (and terminal? (= "complete" status))
         errors-all (vec (or (mget m "errors") []))
         run-errors (vec (filter (fn [e] (= "run" (mget e "scope"))) errors-all))
         step-errors (vec (filter (fn [e] (not= "run" (mget e "scope"))) errors-all))
         global-refuted? (or (seq run-errors) (= "failed" status) (= "aborted" status))
         witness-ok? (and complete? (= 1 m-schema) time-ok? prov-ok? (not global-refuted?))
         m-beats (vec (or (mget m "beats") []))
         m-steps (vec (or (mget m "steps") []))
         screenshots (vec (or (mget m "screenshots") []))
         asserts (vec (or (mget m "asserts") []))
         step-idx (index-rows m-steps (fn [s] (mget s "i")))
         beat-idx (index-rows m-beats (fn [b] (mget b "id")))
         step-by-i (:by step-idx)
         beat-by-id (:by beat-idx)
         struct-bad? (or (pos? (count (:dups step-idx)))
                         (pos? (count (:dups beat-idx))))
         avail (or (:available-shot? opts) (fn [_] true))
         shot-ok? (fn [rec] (and (nonempty (mget rec "path"))
                                 (nonempty (mget rec "sha256"))
                                 (avail rec)))
         shot-matches (fn [rs] (filter (fn [rec]
                                         (and (= (:step rs) (mget rec "step"))
                                              (= (:actor rs) (nm (mget rec "actor")))
                                              (= (:name rs) (mget rec "name"))))
                                       screenshots))
         ;; A required shot counts only when at least one row matches AND every
         ;; matching row is a genuine published artifact — a conflicting bad
         ;; duplicate refuses the witness rather than being hidden by the good.
         shot-satisfied? (fn [rs] (let [ms (vec (shot-matches rs))]
                                    (and (seq ms) (every? shot-ok? ms))))
         prov-note (cond
                     (not prov-map?) "manifest has no provenance"
                     (not story-match?) "story fingerprint mismatch"
                     (not id-match?) "story id mismatch"
                     (not source-match?) "source fingerprint mismatch"
                     (not source-after-present?) "manifest has no source-after fingerprint"
                     (not source-after-match?) "source-after fingerprint mismatch"
                     (not runtime-match?) "runtime version mismatch"
                     (not server-match?) "parent/server identity mismatch"
                     :else "matching provenance")
         ctx {:descriptor D :terminal? terminal? :complete? complete? :witness-ok? witness-ok?
              :struct-bad? struct-bad?
              :step-by-i step-by-i :steps m-steps :screenshots screenshots :asserts asserts
              :beat-by-id beat-by-id :step-errors step-errors
              :shot-ok? shot-ok? :shot-satisfied? shot-satisfied?
              :shot-view (:shot-view opts) :prov-note prov-note}
         outs (if desc-ok?
                (mapv (fn [i] (beat-outcome ctx (nth (:beats D) i) i))
                      (range (count (:beats D))))
                [])
         frames (mapv :frame outs)
         beat-ids (set (map :id (:beats D)))
         ;; A manifest step whose index no authored beat requires is an orphan
         ;; index — it cannot participate in any witness.
         req-idx (reduce (fn [acc b] (reduce (fn [a i] (assoc a i true)) acc (:required-steps b)))
                         {}
                         (if desc-ok? (:beats D) []))
         orphan-step-claims (mapv (fn [s]
                                    (let [a (nm (mget s "actor"))]
                                      (claim (str "manifest step " (mget s "i")
                                                  " belongs to no authored beat")
                                             (if desc-ok? :refuted :unknown)
                                             nil (mget s "beat")
                                             (when (nonempty a) (keyword a))
                                             (mget s "i")
                                             (evid (mget s "op") nil nil "orphan step index"))))
                                  (if desc-ok?
                                    (filter (fn [s] (not (contains? req-idx (mget s "i")))) m-steps)
                                    []))
         claims (vec (concat (mapcat :claims outs)
                             (map orphan-claim (remove (fn [a] (contains? beat-ids (mget a "beat"))) asserts))
                             orphan-step-claims))
         holes (vec (filter :missing? (:beats D)))
         refuted-frames (vec (filter (fn [f] (= :refuted (:verdict f))) frames))
         unknown-frames (vec (filter (fn [f] (= :unknown (:verdict f))) frames))
         state-stretch (cond
                         (not desc-ok?) (stretch :unplayed :unknown "no authored evidence descriptor")
                         (not schema-ok?) (stretch :legacy :unknown "unsupported evidence schema version")
                         (nil? m) (stretch :unplayed :unknown "no take manifest")
                         (nil? m-schema) (stretch :legacy :unknown "unversioned legacy manifest is not evidence")
                         (not prov-ok?) (stretch :stale :unknown prov-note)
                         (not time-ok?) (stretch :time :unknown time-note)
                         (not terminal?) (stretch :running :unknown "take is not terminal")
                         (not complete?) (stretch :running :unknown (str "take status " status))
                         :else (stretch :take :witnessed "complete matching take"))
         run-stretch (when (and (some? m) (or (seq run-errors) (= "failed" status) (= "aborted" status)))
                       (stretch :run :refuted
                                (if (seq run-errors)
                                  (str (count run-errors) " run-level error(s)")
                                  (str "take " status))))
         hole-stretch (when (and desc-ok? (seq holes))
                        (stretch :partial :unknown
                                 (str (count holes) " authored moment(s) have no evidence")))
         beat-stretch (cond
                        (seq refuted-frames) (stretch :beats :refuted
                                                     (str (count refuted-frames) " beat(s) failed"))
                        (seq unknown-frames) (stretch :beats :unknown
                                                     (str (count unknown-frames) " beat(s) incomplete"))
                        :else nil)
         stretches (vec (remove nil? [state-stretch run-stretch hole-stretch beat-stretch]))]
     {:id (or (:id D) (mget m "name") "browser")
      :title (or (:title D) (mget m "name") "browser take")
      :verdict (roll-up claims stretches)
      :duration-ms (when (and (some? started-ms) (some? finished-ms) (<= started-ms finished-ms))
                      (- finished-ms started-ms))
      :tags (vec (concat [:browser :evidence] (when (seq holes) [:partial])))
      :world :browser
      :media nil
      :steps frames
      :claims claims
      :stretches stretches})))

;; ── Suite: a titled bag of runs ─────────────────────────────────────

(defn suite
  "A Suite is what Band A renders: {:title :runs [Run]}. `runs` are already
   adapted (of-scenario). The runner's front door."
  [title runs]
  {:title title :runs (vec runs)})

(defn tally
  "Suite health for `suite-header`: counts by verdict + total. Pure over the
   runs' roll-ups — the number badges on the front door."
  [suite]
  (let [runs (:runs suite)]
    {:total (count runs)
     :passed (count (filter (fn [r] (= :proven (:verdict r))) runs))
     :witnessed (count (filter (fn [r] (= :witnessed (:verdict r))) runs))
     :failed (count (filter (fn [r] (= :refuted (:verdict r))) runs))
     :unknown (count (filter (fn [r] (contains? #{:unknown :running} (:verdict r))) runs))}))
