; priv/lib/scenario/runner/frame.bl — the FRAME: the world at a basis, as a poster.
;
; ══ THE IDEA ════════════════════════════════════════════════════════════════
;
; "Show me the frames." A scenario has no camera yet (that is the W1 NIF). But a
; frame is not pixels — a frame is THE WORLD AT A COORDINATE. We already have
; that: every step carries its basis and the projected view. So we RENDER the
; frame — a cinematic 16:9 SVG poster of the world at that step — deterministic,
; self-contained, gorgeous, and swappable for a real <video> the instant the NIF
; lands (the media slot is unchanged).
;
; This is "the film before the film": the proof plane, shot like a movie.
;
; ══ WHAT A FRAME SHOWS ══════════════════════════════════════════════════════
;
; Domain-neutral — it renders whatever the projection put in the view map, but
; COMPOSED like a real program monitor:
;   · a verdict-tinted cinematic gradient (green/amber/red mood)
;   · letterbox bars + a subtle vignette + scanline grain (the film look)
;   · top-left: SCENE n · the actor
;   · center: the DOMINANT value, shown large (the promised date, the status)
;   · a viewfinder HUD: the whole projection as a mono readout, bottom-left
;   · a REC dot + timecode, top-right / bottom-right
;   · a status "tally light" that glows the verdict colour
;
; All pure SVG hiccup; hiccup preserves attr keys verbatim, so structural
; camelCase attrs (viewBox, preserveAspectRatio) survive AND presentation attrs
; stay kebab-case (stop-color, stop-opacity) as SVG-in-HTML requires. No JS.

(ns scenario.runner.frame
  (:require [loom.token :as t]))

;; ── the verdict mood: a two-stop gradient + accent, per verdict ─────

(def ^:private mood
  {:proven    {:a "#0c1f17" :b "#0a2b1e" :key "#3fb950" :dim "#1c5137"}
   :witnessed {:a "#0c1622" :b "#0a1e33" :key "#5b8def" :dim "#22406b"}
   :refuted   {:a "#241012" :b "#2b0a12" :key "#e5534b" :dim "#5c2027"}
   :unknown   {:a "#221c0c" :b "#2b230a" :key "#d29922" :dim "#5c4a1c"}
   :running   {:a "#150c22" :b "#1c0a33" :key "#7c5cff" :dim "#3a226b"}
   :skipped   {:a "#161719" :b "#1e2124" :key "#9aa0a6" :dim "#2a2e33"}})

(defn- mood-of [v] (get mood v (get mood :unknown)))

;; ── pick the dominant value to feature big ─────────────────────────
;;
;; Heuristic: a :promised-date / :date / :when key is the hero (scenarios are
;; about time); else the :status; else the first value. Domain-neutral but
;; opinionated about what reads as a headline.

(defn- hero-value [view]
  (cond
    (nil? view) "—"
    (contains? view :promised-date) (fmt-val (:promised-date view))
    (contains? view :date) (fmt-val (:date view))
    (contains? view :when) (fmt-val (:when view))
    (contains? view :status) (String/upcase (str (name-or (:status view))))
    (empty? view) "—"
    :else (fmt-val (second (first (seq view))))))

(defn- name-or [x] (if (keyword? x) (name x) (str x)))

(def ^:private weekday
  {0 "Sun" 1 "Mon" 2 "Tue" 3 "Wed" 4 "Thu" 5 "Fri" 6 "Sat"})

(defn- interval? [x]
  (and (map? x) (int? (get x :from nil)) (int? (get x :to nil)) (contains? x :resolution)))

(defn- clock-of
  "A scale-second (1970-01-01 = Thursday) → 'Thu 10:00' — a human wall-clock."
  [secs]
  (let [days (quot secs 86400)
        wd   (rem (+ 4 (rem days 7)) 7)
        within (rem secs 86400)
        h  (quot within 3600)
        m  (quot (rem within 3600) 60)
        hh (if (< h 10) (str "0" h) (str h))
        mm (if (< m 10) (str "0" m) (str m))]
    (str (get weekday wd "?") " " hh ":" mm)))

(defn- fmt-val [x]
  ;; render a value for a frame: intervals become a wall-clock; keywords upcase;
  ;; anything else prints, truncated. A datom Interval prints huge raw — THIS is
  ;; the fix for the monitor showing 'time/Interval{:calendar…'.
  (cond
    (nil? x) "—"
    (interval? x) (clock-of (:from x))
    (keyword? x) (String/upcase (name x))
    :else (let [s (pr-str x)] (if (> (count s) 42) (str (subs s 0 40) "…") s))))

(defn fmt
  "Public: render one projected value for display — intervals become a
   wall-clock, keywords upcase. Shared by the monitor and the inspector so a
   datom Interval never leaks its raw struct into the UI."
  [x] (fmt-val x))

;; ── small builders ──────────────────────────────────────────────────

(defn- hud-lines [view]
  ;; the projection as a viewfinder readout: KEY  value, dim + mono.
  ;; FIXED ARITY: exactly `hud-cap` lines, padded with invisible ones. This is
  ;; the patch contract, not a style choice — the live client renders an
  ;; inserted/replace'd subtree with createElement (no createElementNS), so an
  ;; SVG node born in a patch paints BLANK. A scrub between two steps must
  ;; therefore emit only attribute/text morphs: constant shape, moving content.
  (let [cap 6
        kvs (into [] (take cap (seq (or view {}))))
        pad (- cap (count kvs))
        rows (concat kvs (map (fn [_] nil) (range pad)))]
    (map-indexed
      (fn [i kv]
        (if (nil? kv)
          [:text {:x 44 :y (+ 372 (* i 26))
                  :font-family (t/tok :font :mono) :font-size 17
                  :fill "#c9d4cf" :opacity "0"}
           [:tspan {:fill "#7d8a84"} " "]
           [:tspan {:fill "#e8f0ec"} " "]]
          (let [k (first kv) v (second kv)]
            [:text {:x 44 :y (+ 372 (* i 26))
                    :font-family (t/tok :font :mono) :font-size 17
                    :fill "#c9d4cf" :opacity "0.92"}
             [:tspan {:fill "#7d8a84"} (str (String/upcase (name-or k)) "  ")]
             [:tspan {:fill "#e8f0ec"} (fmt-val v)]])))
      rows)))

;; ════════════════════════════════════════════════════════════════════
;; poster — the frame, as SVG hiccup (960×540, 16:9)
;; ════════════════════════════════════════════════════════════════════

;; ╔═════════════════════════════════════════════════════════════════════════╗
;; screen-frame — the REAL application, filmed. The monitor is the app itself.
;; ╚═════════════════════════════════════════════════════════════════════════╝
;;
;; A poster is a chart OF the data. This is the product ITSELF at that step:
;; the host SSR-renders its own live screen against the scenario's synthetic db
;; (the basis every step already retains) and hands us the HTML. We frame it in
;; a CSS-isolated <iframe srcdoc> so the app's own theme paints exactly as it
;; ships — no leakage either way. Scrubbing n→n+1 is a single `set-attr srcdoc`
;; morph on ONE keyed iframe: the patch contract holds (no SVG insert, no move).
;;
;; This is the whole point of the runner: watch YOUR app run on synthetic
;; stories. The neutral kit stays neutral — it renders whatever HTML string the
;; host attached to the step (:screen); it never knows a dashboard from a kiosk.

(defn screen-frame
  "Frame the host's own rendered screen. `opts` = {:html str :route str
   :actor kw :verdict kw :scene n :timecode str :recording? bool :uid str}.
   `:html` is a COMPLETE HTML document (the host's SSR of its live screen at
   this step's basis). Returned as an isolated iframe with a thin broadcast
   chrome: a top status strip (scene · actor · route · REC · timecode) over
   the live app. Falls back to `poster` when `:html` is absent."
  [opts]
  (let [{:keys [html route actor verdict scene timecode]} opts
        m (mood-of (or verdict :unknown))
        rec (get opts :recording? true)
        uid (or (get opts :uid nil) "scr")]
    (if (nil? html)
      (poster opts)
      [:div {:key (str "scrwrap-" uid)
             :style (str "position:relative;width:100%;aspect-ratio:16/9;"
                         "background:#000;overflow:hidden;"
                         "border-bottom:2px solid " (:key m))}
       ;; the broadcast status strip — a thin HUD OVER the live app
       [:div {:key "scrhud"
              :style (str "position:absolute;top:0;left:0;right:0;height:30px;z-index:2;"
                          "display:flex;align-items:center;gap:12px;padding:0 14px;"
                          "font-family:" (t/tok :font :mono) ";font-size:12px;"
                          "color:#e8f0ec;pointer-events:none;"
                          "background:linear-gradient(#000d,#0000)")}
        [:span {:style "font-weight:700;letter-spacing:1.5px"}
         (str "SCENE " (or scene "—"))]
        [:span {:style (str "color:" (:key m) ";font-weight:700;letter-spacing:1px")}
         (String/upcase (name-or (or actor "world")))]
        [:span {:style "opacity:0.65"} (or route "")]
        [:span {:style "flex:1"} ""]
        (when rec [:span {:style "color:#e5534b;font-weight:700;display:flex;align-items:center;gap:5px"}
                   [:span {:style "width:7px;height:7px;border-radius:50%;background:#e5534b;display:inline-block"}]
                   "REC"])
        [:span {:style "color:#c9d4cf"} (or timecode "00:00:00")]]
       ;; the app itself — CSS-isolated, non-interactive (this is a monitor)
       [:iframe {:key (str "scr-" uid)
                 :srcdoc html
                 :title (str "scene " (or scene "") " — " (or route ""))
                 :sandbox "allow-same-origin"
                 :style (str "width:100%;height:100%;border:0;display:block;"
                             "background:#0e1013;pointer-events:none")}]
       ;; a faint verdict vignette so the whole monitor still reads a mood
       [:div {:key "scrvig"
              :style (str "position:absolute;inset:0;z-index:1;pointer-events:none;"
                          "box-shadow:inset 0 0 120px 8px " (:key m) "14")}]])))

;; ╔════════════════════════════════════════════════════════════════════╗
;; multiviewer — several live screens at once, the broadcast multiviewer
;; ╚════════════════════════════════════════════════════════════════════╝
;;
;; A scenario is MULTI-ACTOR: at any step the commercial's order screen and the
;; operator's kiosk are BOTH live, and the story is the causality BETWEEN them
;; (the jam on Karim's Bobst is why Amina's promise slips). A single monitor
;; hides that link. The multiviewer shows every actor's real screen side by
;; side at the SAME basis, the acting actor lit — you watch cause and effect in
;; one glance, exactly like a gallery of camera feeds in a broadcast truck.
;;
;; Each pane is ONE keyed iframe (keyed by ACTOR, stable across scrubs), so a
;; scrub n→n+1 morphs every pane's `srcdoc` in place — the patch contract holds
;; per pane, no node is born or moved. The acting actor's pane carries the
;; verdict border + a LIVE tag; the others dim slightly so the eye lands on who
;; is acting without losing the context screens.

(defn- viewer-pane
  "One feed in the multiviewer: an actor's live screen under a compact HUD.
   `p` = {:actor kw :html str :route str :acting? bool :verdict kw :scene n}.
   Keyed by actor so a scrub only ever morphs its srcdoc."
  [p]
  (let [{:keys [actor html route acting? verdict scene]} p
        m (mood-of (or verdict :unknown))
        lit (if acting? (:key m) "#2a3037")]
    [:div {:key (str "pane-" (name-or actor))
           :style (str "position:relative;aspect-ratio:16/9;overflow:hidden;"
                       "background:#000;border-radius:8px;"
                       "border:2px solid " lit ";"
                       (if acting?
                         (str "box-shadow:0 0 0 1px #000, 0 10px 30px -8px " (:key m) "66;")
                         "opacity:0.72;")
                       "transition:opacity 160ms")}
     ;; the feed HUD — actor · route, and a LIVE tag on the acting feed
     [:div {:key "phud"
            :style (str "position:absolute;top:0;left:0;right:0;height:24px;z-index:2;"
                        "display:flex;align-items:center;gap:8px;padding:0 10px;"
                        "font-family:" (t/tok :font :mono) ";font-size:11px;"
                        "color:#e8f0ec;pointer-events:none;"
                        "background:linear-gradient(#000d,#0000)")}
      [:span {:style (str "color:" (:key m) ";font-weight:700;letter-spacing:1px")}
       (String/upcase (name-or actor))]
      [:span {:style "opacity:0.6;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"}
       (or route "")]
      [:span {:style "flex:1"} ""]
      (when acting?
        [:span {:style (str "color:#e5534b;font-weight:700;display:flex;"
                            "align-items:center;gap:4px")}
         [:span {:style "width:6px;height:6px;border-radius:50%;background:#e5534b;display:inline-block"}]
         "LIVE"])]
     ;; the app itself — CSS-isolated, non-interactive. A pane is narrower than
     ;; the app's smallest comfortable width, so rendering at pane px would trip
     ;; the app's responsive breakpoints and clip. Instead render at 2× the pane
     ;; (width/height:200%) and scale(0.5) back to fit: the app lays out at a
     ;; comfortable logical width and the WHOLE screen shows, proportionally —
     ;; a real multiviewer feed is the whole screen, shrunk, not a clipped
     ;; corner. transform-origin top-left pins the header (nav · title · hero,
     ;; the part that tells the story); the fold clips, as a camera feed should.
     (if (nil? html)
       [:div {:key "pempty" :style "width:100%;height:100%;background:#0e1013"} ""]
       [:iframe {:key (str "pfr-" (name-or actor))
                 :srcdoc html
                 :title (str (name-or actor) " — scene " (or scene "") " — " (or route ""))
                 :scrolling "no"
                 :sandbox "allow-same-origin"
                 :style (str "width:200%;height:200%;border:0;display:block;"
                             "transform:scale(0.5);transform-origin:top left;"
                             "background:#0e1013;pointer-events:none")}])]))

(defn multiviewer
  "The broadcast multiviewer: every actor's live screen at one basis, side by
   side, the acting actor lit. `opts` =
     {:screens {actor html} :routes {actor route} :actor kw(acting)
      :verdict kw :scene n :order [kw …]}
   `:order` (optional) fixes the pane order so panes never reshuffle across a
   scrub — a stable order is what keeps each keyed pane in its slot (the patch
   contract: morph srcdoc, never move a node). Falls back to a single
   `screen-frame` when there is only one screen, and to `poster` when none."
  [opts]
  (let [screens (or (get opts :screens {}) {})
        routes (get opts :routes {})
        acting (:actor opts)
        ;; a STABLE actor order: the caller's :order if given, else the acting
        ;; actor first, then the rest by name — deterministic, so the pane grid
        ;; is identical shape every scrub (only srcdoc content moves). Either
        ;; way, keep ONLY actors that actually have a screen at this basis, so a
        ;; caller's run-level order never births an empty pane.
        has? (fn [a] (not (nil? (get screens a))))
        actors (let [given (get opts :order nil)
                     ranked (if (seq given) given
                              (cons acting (sort-by name-or
                                             (filter (fn [a] (not= a acting)) (keys screens)))))]
                 (filter has? ranked))
        n (count actors)]
    (cond
      (= n 0) (poster opts)
      (= n 1) (screen-frame (merge opts {:html (get screens (first actors))
                                         :route (get routes (first actors))
                                         :actor (first actors)}))
      :else
      ;; a responsive grid: 2-up is the common case (commercial + operator);
      ;; 3+ wraps to a second row. `minmax(0,1fr)` lets panes shrink without
      ;; overflow. The grid template is constant per actor-count, so the DOM
      ;; shape is stable across scrubs.
      [:div {:key "mv-grid"
             :style (str "display:grid;gap:10px;padding:10px;background:#000;"
                         "grid-template-columns:repeat(" (if (<= n 2) n 2)
                         ",minmax(0,1fr))")}
       (for [a actors]
         (viewer-pane {:actor a
                       :html (get screens a)
                       :route (get routes a)
                       :acting? (= a acting)
                       :verdict (:verdict opts)
                       :scene (:scene opts)}))])))

(defn screen-thumb
  "A filmstrip thumbnail of the host's real screen — the same SSR HTML as the
   monitor, scaled DOWN to a chip so a row reads as a strip of real frames.
   `opts` = {:html str :uid str}. The doc renders at 1180px then a CSS scale
   shrinks the whole page into the chip (a real NLE filmstrip is tiny real
   frames, not charts). Non-interactive. Falls back to a flat panel when no
   :html. The scale wrapper is constant per clip — scrubbing never touches it
   (only the selection chrome around it morphs), so the patch contract holds."
  [opts]
  (let [html (get opts :html nil)
        uid (or (get opts :uid nil) "thumb")]
    (if (nil? html)
      [:div {:key (str "thumb-empty-" uid)
             :style "width:100%;aspect-ratio:16/9;background:#0e1013"} ""]
      ;; the chip clips a 1180×664 page scaled to fit its width. width:600%
      ;; + scale(0.1667) = the page laid out at ~1180px then shrunk 6×, so the
      ;; whole screen shows, legibly proportioned, inside the thumbnail.
      [:div {:key (str "thumbwrap-" uid)
             :style "position:relative;width:100%;aspect-ratio:16/9;overflow:hidden;background:#f6f7f9"}
       [:iframe {:key (str "thumb-" uid)
                 :srcdoc html
                 :scrolling "no"
                 :sandbox "allow-same-origin"
                 :style (str "width:600%;height:600%;border:0;"
                             "transform:scale(0.1667);transform-origin:top left;"
                             "pointer-events:none;background:#f6f7f9")}]])))

(defn poster
  "A cinematic 16:9 SVG poster of the world at a step. `opts` =
   {:scene n :actor kw :verdict kw :view {…} :label str :timecode str
    :recording? bool :uid str}. `:uid` names the poster INSTANCE (mon, clip3)
   — gradient defs are keyed by it, so ids are stable across scrubs of one
   poster and unique ACROSS posters on the same page (the old scene-numbered
   ids collided: the monitor and clip 5 both owned bg-5). Returns SVG hiccup
   — drop it in a monitor frame."
  [opts]
  (let [{:keys [scene actor verdict view label timecode]} opts
        uid (or (get opts :uid nil) (str "s" (or scene "x")))
        m (mood-of (or verdict :unknown))
        rec (get opts :recording? true)]
    [:svg {:viewBox "0 0 960 540" :width "100%"
           :preserveAspectRatio "xMidYMid meet"
           :style "display:block;width:100%;height:auto;aspect-ratio:16/9;background:#000"}
     ;; ── defs: gradient + vignette + grain ──────────────────────────
     [:defs {}
      [:linearGradient {:id (str "fbg-" uid) :x1 "0" :y1 "0" :x2 "1" :y2 "1"}
       [:stop {:offset "0%" :stop-color (:a m)}]
       [:stop {:offset "100%" :stop-color (:b m)}]]
      [:radialGradient {:id (str "fvig-" uid) :cx "50%" :cy "42%" :r "75%"}
       [:stop {:offset "55%" :stop-color "#000" :stop-opacity "0"}]
       [:stop {:offset "100%" :stop-color "#000" :stop-opacity "0.62"}]]
      [:linearGradient {:id (str "fglow-" uid) :x1 "0" :y1 "0" :x2 "0" :y2 "1"}
       [:stop {:offset "0%" :stop-color (:key m) :stop-opacity "0.30"}]
       [:stop {:offset "100%" :stop-color (:key m) :stop-opacity "0"}]]]
     ;; ── the field ─────────────────────────────────────────────────
     [:rect {:x 0 :y 0 :width 960 :height 540 :fill (str "url(#fbg-" uid ")")}]
     ;; a soft top glow in the verdict colour
     [:rect {:x 0 :y 0 :width 960 :height 220 :fill (str "url(#fglow-" uid ")")}]
     ;; faint horizon grid — a sense of a stage/space
     [:g {:stroke (:dim m) :stroke-width "1" :opacity "0.5"}
      (for [gx [160 320 480 640 800]]
        [:line {:key (str "vx" gx) :x1 gx :y1 96 :x2 gx :y2 444}])
      (for [gy [180 270 360]]
        [:line {:key (str "hy" gy) :x1 60 :y1 gy :x2 900 :y2 gy}])]
     ;; ── the hero value, centered ──────────────────────────────────
     [:text {:x 480 :y 262 :text-anchor "middle"
             :font-family (t/tok :font :sans) :font-size 76 :font-weight "800"
             :fill "#ffffff" :style "letter-spacing:-2px"}
      (hero-value view)]
     [:text {:x 480 :y 300 :text-anchor "middle"
             :font-family (t/tok :font :sans) :font-size 20 :font-weight "600"
             :fill (:key m) :opacity "0.9" :style "letter-spacing:3px"}
      (String/upcase (str (name-or (or verdict :unknown))))]
     ;; ── the status tally light (a glowing orb, verdict colour) ─────
     [:circle {:cx 858 :cy 452 :r 30 :fill (:key m) :opacity "0.16"}]
     [:circle {:cx 858 :cy 452 :r 15 :fill (:key m)}]
     [:circle {:cx 852 :cy 446 :r 5 :fill "#ffffff" :opacity "0.8"}]
     ;; ── letterbox bars ────────────────────────────────────────────
     [:rect {:x 0 :y 0 :width 960 :height 64 :fill "#000" :opacity "0.55"}]
     [:rect {:x 0 :y 476 :width 960 :height 64 :fill "#000" :opacity "0.55"}]
     ;; ── top-left: SCENE n · actor ─────────────────────────────────
     [:text {:x 44 :y 42 :font-family (t/tok :font :mono) :font-size 20
             :fill "#ffffff" :font-weight "700" :style "letter-spacing:2px"}
      (str "SCENE " (or scene "—"))]
     [:text {:x 150 :y 42 :font-family (t/tok :font :mono) :font-size 20
             :fill (:key m) :style "letter-spacing:2px"}
      (str "· " (String/upcase (name-or (or actor "world"))))]
     ;; ── top-right: REC dot + timecode ─────────────────────────────
     (when rec
       [:circle {:cx 720 :cy 35 :r 7 :fill "#e5534b"}])
     (when rec
       [:text {:x 734 :y 42 :font-family (t/tok :font :mono) :font-size 18
               :fill "#e5534b" :font-weight "700"} "REC"])
     [:text {:x 940 :y 42 :text-anchor "end" :font-family (t/tok :font :mono)
             :font-size 18 :fill "#c9d4cf"} (or timecode "00:00:00")]
     ;; ── the viewfinder HUD (projection readout), bottom-left ───────
     (into [:g {}] (hud-lines view))
     ;; ── bottom-right: the step label, quiet ───────────────────────
     [:text {:x 916 :y 512 :text-anchor "end" :font-family (t/tok :font :sans)
             :font-size 17 :fill "#9fb0a8" :opacity "0.9"}
      (let [l (or label "")] (if (> (count l) 54) (str (subs l 0 52) "…") l))]
     ;; ── framing corner ticks (camera viewfinder) ──────────────────
     [:g {:stroke "#ffffff" :stroke-width "2" :opacity "0.35" :fill "none"}
      [:path {:d "M40,86 L40,110 M40,86 L64,86"}]
      [:path {:d "M920,86 L920,110 M920,86 L896,86"}]
      [:path {:d "M40,454 L40,430 M40,454 L64,454"}]
      [:path {:d "M920,454 L920,430 M920,454 L896,454"}]]
     ;; ── the vignette, last (on top) ───────────────────────────────
     [:rect {:x 0 :y 0 :width 960 :height 540 :fill (str "url(#fvig-" uid ")")}]]))
