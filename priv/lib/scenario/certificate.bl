; priv/lib/scenario/certificate.bl — a run, rendered as an inspectable
; artifact.
;
; ══ WHAT THIS IS ════════════════════════════════════════════════════════════
;
; The certificate is the FILM BEFORE THE FILM: the run's verdicts, history and
; bases rendered to ONE self-contained HTML file — no JS, no network, no
; timestamps — so it is deterministic and diffable like everything else here.
;
;   · every claim is a row with its VERDICT (:proven/:witnessed/:refuted/:unknown)
;   · a REFUTED row carries its witness: the actor's projected view at the
;     basis where the claim was false — `(scenario/bisect result step)`
;   · every history step folds open to the world as it exactly was after it
;
; At W3 the replay frame docks into the same structure: a refuted row gains a
; frame reference, and the certificate becomes an index over the film. The
; data shape does not change — that is the point.
;
; World-neutral on purpose: a certificate is a rendering of a RUN, not of a
; print shop (domain-neutral).

(ns scenario.certificate
  (:require [scenario :as s]))

;; ── escaping: content is data; never markup ─────────────────────────

(defn- esc [x]
  (let [s (pr-str x)]
    (String/replace (String/replace (String/replace s "&" "&amp;")
                                    "<" "&lt;")
                    ">" "&gt;")))

(defn- esc-plain [x]
  (if (nil? x) ""
    (String/replace (String/replace (String/replace (str x) "&" "&amp;")
                                    "<" "&lt;")
                    ">" "&gt;")))

;; ── the bisect view: one basis, every actor's projected view of it ──

(defn- views-at [result n]
  (let [b (s/bisect result n)]
    (or (:views b) {})))

;; ── render ──────────────────────────────────────────────────────────

(defn render
  "Render a run (result of scenario/run-world) to a self-contained HTML string."
  [result]
  (let [trace (:trace result)
        n-steps (count trace)
        verdicts (:verdicts result)
        n-proven (count (filter (fn [v] (= :proven (:verdict v))) verdicts))
        n-wit (count (filter (fn [v] (= :witnessed (:verdict v))) verdicts))
        n-ref (count (filter (fn [v] (= :refuted (:verdict v))) verdicts))
        n-unk (count (filter (fn [v] (= :unknown (:verdict v))) verdicts))
        badge (if (:ok result) "OK" "REFUTED")]
    (str
      "<!doctype html><html><head><meta charset=\"utf-8\">"
      "<title>scenario certificate — " (esc-plain (or (:name result) "run")) "</title>"
      "<style>"
      "body{font:14px/1.5 ui-monospace,monospace;margin:2.5rem auto;max-width:60rem;"
      "color:#1c1916;background:#faf7f2;padding:0 1.5rem}"
      "h1{font-size:1.15rem;letter-spacing:.02em}"
      ".badge{display:inline-block;padding:.15rem .6rem;border-radius:.2rem;"
      "font-weight:700;color:#fff;background:#3d7a4f;margin-left:.6rem}"
      ".badge.refuted{background:#a33d2f}"
      "table{border-collapse:collapse;width:100%;margin:1rem 0}"
      "td,th{border:1px solid #e3ddd2;padding:.35rem .6rem;text-align:left;"
      "vertical-align:top}"
      "th{background:#f0ebe1}"
      ".proven{color:#2c6e3f}.witnessed{color:#7a5a2c}.unknown{color:#777}"
      ".refuted td{background:#f7e8e4}.refuted .verdict{color:#a33d2f;font-weight:700}"
      "details{margin:.25rem 0;border:1px solid #e3ddd2;border-radius:.25rem;"
      "padding:.35rem .6rem;background:#fff}"
      "summary{cursor:pointer;user-select:none}"
      ".basis{color:#555;margin-top:.3rem;white-space:pre-wrap;word-break:break-all}"
      ".mut{color:#777}.step-n{color:#a08050;font-weight:700}"
      ".foot{color:#777;margin-top:2rem;font-size:.85rem}"
      "</style></head><body>"
      "<h1>scenario certificate"
      "<span class=\"badge" (if (:ok result) "" " refuted") "\">" badge "</span></h1>"
      "<p class=\"mut\">world: " (esc-plain (:world result))
      " · steps: " n-steps
      " · claims: " n-proven " proven, " n-wit " witnessed, "
      n-ref " refuted, " n-unk " unknown</p>"

      ;; ── the claims ──
      "<h2>claims</h2><table><tr><th>verdict</th><th>actor</th><th>claim</th>"
      "<th>step</th></tr>"
      (apply str
             (map (fn [v]
                    (str "<tr class=\"" (name (:verdict v)) "\"><td class=\"verdict\">"
                         (name (:verdict v)) "</td><td>" (esc-plain (:actor v))
                         "</td><td>" (esc-plain (:msg v)) "</td><td>" (:step v) "</td></tr>"))
                  verdicts))
      "</table>"

      ;; ── the stretches (run-level properties) ──
      (if (empty? (:stretches result)) ""
        (str "<h2>stretches</h2><table><tr><th>kind</th><th>verdict</th><th>property</th></tr>"
             (apply str
                    (map (fn [st]
                           (str "<tr class=\"" (name (:verdict st)) "\"><td>" (name (:kind st))
                                "</td><td class=\"verdict\">" (name (:verdict st))
                                "</td><td>" (esc-plain (or (:msg st) "")) "</td></tr>"))
                         (:stretches result)))
             "</table>"))

      ;; ── the history: every step folds open to its basis ──
      "<h2>history</h2>"
      (apply str
             (map (fn [t]
                    (let [views (views-at result (:step t))
                          view (get views (:actor t))]
                      (str "<details><summary><span class=\"step-n\">" (:step t)
                           "</span> · " (esc-plain (:actor t)) " · "
                           (esc-plain (first (:action t)))
                           " → " (name (:outcome t))
                           (if (:verdict t) (str " / " (name (:verdict t))) "")
                           "</summary>"
                           (when (:because t)
                             (str "<div>claim: “" (esc-plain (:because t)) "”</div>"))
                           (when (and (= :refuted (:verdict t)) view)
                             (str "<div class=\"basis\">witness — the actor's view at "
                                  "this basis: " (esc view) "</div>"))
                           (when view
                             (str "<div class=\"basis\">view at this basis: "
                                  (esc view) "</div>"))
                           "</details>")))
                  trace))

      ;; ── the witnesses (comparative claims) ──
      (if (empty? (:witnesses result)) ""
        (str "<h2>witnesses</h2><table><tr><th>name</th><th>observation</th></tr>"
             (apply str
                    (map (fn [kv]
                           (str "<tr><td>" (esc-plain (nth kv 0)) "</td><td>"
                                (esc (nth kv 1)) "</td></tr>"))
                         (seq (:witnesses result))))
             "</table>"))

      "<p class=\"foot\">the certificate is the film before the film: at W3 a "
      "replay frame docks beside every refuted claim. data shape unchanged.</p>"
      "</body></html>")))

(defn write!
  "Render and write the certificate, creating the parent directory if needed.
   Returns the path."
  [path result]
  (File/mkdir_p (Path/dirname path))
  (File/write path (render result))
  path)
