(ns scenario.film
  (:require [interop]))

(defn film
  "Author a presentation of witnessed media. Scenes carry :id, :source,
   :say, optional :subtitle, :camera and :cursor keyframes. Export measures
   narration before scheduling visuals and subtitles. Verdicts stay in :run."
  [id scenes opts]
  (merge {:version 1 :id id :width 1920 :height 1080 :fps 30
          :voice "aura-2-hector-fr" :language "fr" :scenes (vec scenes)} opts))

(defn from-run
  "Attach an unmodified Scenario Runner run as provenance. The film's scenes
   are an editorial selection; they do not introduce new scenario witnesses."
  [run scenes opts]
  (film (:id run) scenes (assoc opts :run (select-keys run [:id :title :verdict :claims :stretches]))))

(defn export!
  "Write a JSON film value and invoke the optional media worker. opts may name
   :worker, :python and :env-file. Credentials never enter the film value.
   Requires Python 3, FFmpeg/ffprobe with libass; rsvg-convert for the cursor.
   Returns the measured export manifest. No browser or network at import."
  ([value out] (export! value out {}))
  ([value out opts]
   (let [out (Path/expand out)
         worker (or (:worker opts) (str (BeamLisp.Tiers/priv_root) "/lib/scenario/film/render.py"))
         input (str out "/film.json")]
     (File/mkdir_p! out)
     (File/write! input (interop/->json value))
     (let [args (into [worker input "--out" out]
                     (if (:env-file opts) ["--env-file" (Path/expand (:env-file opts))] []))
           result (System/cmd (or (:python opts) "python3") (to-list args))]
       (when (not= 0 (erlang/element 2 result))
         (throw (ex-info "Demo export failed" {:diagnostic (erlang/element 1 result)})))
       (interop/json-> (File/read! (str out "/manifest.json")))))))
