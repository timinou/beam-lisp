(ns scenario.film.http (:require [web]))
(def ^:private Conn (erlang/binary_to_atom "Elixir.Plug.Conn"))

(defn- natural [s]
  (when (and (seq s) (<= (erlang/byte_size s) 20)
             (every? (fn [c] (and (>= c 48) (<= c 57))) (String/to_charlist s)))
    (String/to_integer s)))

(defn byte-range
  "Interpret one HTTP byte range for a known file size. Invalid, empty and
   multi-range requests return 416; normal, open-ended and suffix ranges work."
  [header size]
  (let [bad {:status 416 :offset 0 :length 0}]
    (if (nil? header) {:status 200 :offset 0 :length size}
      (if (or (<= size 0) (not (String/starts_with? header "bytes="))) bad
        (let [parts (String/split (subs header 6) "-")]
          (if (not= 2 (count parts)) bad
            (let [a (first parts) b (second parts) lo (natural a) hi (natural b)]
              (cond
                (and (= "" a) hi (> hi 0))
                {:status 206 :offset (max 0 (- size hi)) :length (min size hi)}
                (and lo (< lo size) (or (= "" b) (and hi (>= hi lo))))
                (let [end (min (dec size) (if (= "" b) (dec size) hi))]
                  {:status 206 :offset lo :length (inc (- end lo))})
                :else bad))))))))

(defn serve-file
  "Serve a caller-authorized local media file, with real byte-range seeking.
   The host owns path resolution, authorization, MIME and CORS policy. Uses
   Plug send_file instead of loading the complete movie into the BEAM heap."
  [conn path content-type]
  (let [size (:size (File/stat! path))
        range (byte-range (when (= "get" (web/method conn)) (web/req-header conn "range")) size)
        c (-> conn (web/resp-header "accept-ranges" "bytes")
                   (web/resp-header "content-type" content-type))]
    (cond
      (= 416 (:status range))
      (erlang/apply Conn :send_resp
        (list (web/resp-header c "content-range" (str "bytes */" size)) 416 ""))
      (= "head" (web/method conn))
      (erlang/apply Conn :send_resp (list (web/resp-header c "content-length" (str size)) 200 ""))
      :else
      (let [c (if (= 206 (:status range))
                (web/resp-header c "content-range"
                  (str "bytes " (:offset range) "-" (dec (+ (:offset range) (:length range))) "/" size)) c)]
        (erlang/apply Conn :send_file (list c (:status range) (Path/expand path) (:offset range) (:length range)))))))
