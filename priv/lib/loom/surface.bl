;; loom/surface.bl — a loom view over live state, whatever it is painted on.
;;
;; A SURFACE is the part of a loom app that does not care where the page lives:
;; the page-side hook, a frame (state → body HTML + sheet CSS), the first-paint
;; document, the event parse, and the fold — (state, event) → the new state plus
;; the one line of JavaScript that brings the page up to date.
;;
;; A HOST owns the transport. `loom.desktop` hosts a surface in a wry window
;; (`wry/eval` down, `bl.send` → IPC up); `android.loom` hosts one in the
;; phone's WebView (`webview_eval_js` down, `MobNative.postMessage` up). The view,
;; the reducer and the event vocabulary are the same in every host:
;;
;;   :view      (fn [state] → loom hiccup)
;;   :on-event  (fn [state ev] → state)      ev is the term the view wrote,
;;                                           `:on-click [:inc]` → [:inc]
;;
;; Everything that goes DOWN to the page is ASCII (`js-str`): a host whose seam
;; mangles non-ASCII text (JNI's modified UTF-8) gets `\uXXXX` escapes the page
;; decodes for free. Up is the host's business — a phone shim escapes before it
;; posts.
;;
;; Reserved events travel on the same channel as the app's own and never reach
;; the reducer — see `reserved`.

(ns loom.surface
  (:require [loom.token :as t]
            [live.hiccup :as h]
            [interop]))

;;
;; Injected once, at mount, ahead of any frame. It does three jobs:
;;
;;   1. delegation: one document-level click listener walks up from the target
;;      to the nearest `[data-ev-click]` and posts its term back — so buttons
;;      rendered in ANY later frame are live without re-binding. `input`/`change`
;;      are delegated the same way, carrying the field's value, and so is
;;      `keydown` (Enter, via `:on-keydown.enter`) — the composer gesture the
;;      web client already speaks, so the same view drives both transports.
;;   2. swap: `__loom_swap(html)` replaces the app root's innerHTML, and
;;      `__loom_style(css)` keeps the stylesheet current (a new frame may use
;;      classes the first did not). Both are what the driver calls via `eval`.
;;   3. caret: the swap is a full innerHTML replacement, which would destroy
;;      the focused element — so focus and selection are captured before it
;;      and restored after, and a render landing mid-keystroke never moves the
;;      caret. (Keyed diffing would avoid the swap entirely; this is the small
;;      honest fix until a second consumer needs the diff.)
;;
;; The term in `data-ev-*` is JSON (live/hiccup emits it that way); we post it
;; verbatim so the driver can parse it back to a beam-lisp value.

(def client-hook
  "The page half of every loom surface (see the comment above). A host defines
   `bl.send(string)` before it runs and calls `__loom_style`/`__loom_swap`."
  (str
    "window.__loom = window.__loom || {};"
    ;; ── auto-height ─────────────────────────────────────────────────
    ;; After any render the page measures its OWN intrinsic content height
    ;; (loom-root.scrollHeight, independent of the surface's current size) and,
    ;; if it changed, reports it back as a reserved event ["__loom-height", h].
    ;; The driver turns that into a surface resize — so a dropdown that opens
    ;; below the bar makes the surface exactly tall enough to show it, and
    ;; closing shrinks it back. No view ever computes a pixel height.
    "window.__loom_h = 0;"
    ;; the height the surface needs = the lowest pixel ANY content reaches.
    ;; Measured as the max getBoundingClientRect().bottom over loom-root and
    ;; all its descendants (the viewport top is the surface top, since the bar
    ;; is anchored to the top edge). This is robust to out-of-flow dropdowns:
    ;; an absolutely-positioned panel below a pill counts, even though it does
    ;; not expand any ancestor's normal-flow height.
    "window.__loom_measure = function(){"
    "  var r=document.getElementById('loom-root'); if(!r) return;"
    "  var max=0; var els=r.querySelectorAll('*');"
    "  var b=r.getBoundingClientRect().bottom; if(b>max) max=b;"
    "  for(var i=0;i<els.length;i++){var rb=els[i].getBoundingClientRect().bottom; if(rb>max) max=rb;}"
    "  var h=Math.ceil(max);"
    "  if(h>0 && h!==window.__loom_h){window.__loom_h=h; bl.send(JSON.stringify(['__loom-height', h]));}"
    "};"
    ;; measure on the next frame (after layout settles) following any swap
    "window.__loom_remeasure = function(){requestAnimationFrame(function(){requestAnimationFrame(window.__loom_measure);});};"
    ;; ── the caret survives a re-render ──────────────────────────────
    ;; A full innerHTML swap destroys the focused element, so a render that
    ;; lands WHILE the user is typing (a draft in state, an async verdict, a
    ;; tick) would steal the caret and the selection. Save the focused
    ;; element's id + selection range before the swap and restore it after —
    ;; only when focus was INSIDE the app root, so a window that never had it
    ;; does not steal it.
    "window.__loom_focus = function(){"
    "  var a=document.activeElement, r=document.getElementById('loom-root');"
    "  if(!a||!r||!r.contains(a)||!a.id) return null;"
    "  var sel=null; try{if(a.selectionStart!=null) sel=[a.selectionStart,a.selectionEnd];}catch(e){}"
    "  return {id:a.id, sel:sel};"
    "};"
    "window.__loom_restore = function(f){"
    "  if(!f) return; var el=document.getElementById(f.id); if(!el) return;"
    "  try{ el.focus({preventScroll:true});"
    "       if(f.sel && f.sel[0]!=null && el.setSelectionRange) el.setSelectionRange(f.sel[0], f.sel[1]); }catch(e){}"
    "};"
    ;; swap the app body and (if present) the live stylesheet, then remeasure
    "window.__loom_swap = function(html){var r=document.getElementById('loom-root'); var f=window.__loom_focus(); if(r) r.innerHTML=html; window.__loom_restore(f); window.__loom_remeasure();};"
    "window.__loom_style = function(css){var s=document.getElementById('loom-style'); if(s) s.textContent=css; window.__loom_remeasure();};"
    ;; augment an event term with a value pulled from the source element
    "function __loom_val(el){return el&&(el.type==='checkbox')?el.checked:(el?el.value:null);}"
    ;; post the term on the nearest ancestor carrying data-ev-<kind>
    "function __loom_fire(kind, target){"
    "  var el=target; while(el&&el!==document){"
    "    var raw=el.getAttribute&&el.getAttribute('data-ev-'+kind);"
    "    if(raw){var term=JSON.parse(raw);"
    "      if(kind==='input'||kind==='change'){term=[term,__loom_val(el)];}"
    "      bl.send(JSON.stringify(term)); return;}"
    "    el=el.parentNode;}"
    "}"
    "document.addEventListener('click', function(e){__loom_fire('click', e.target);});"
    "document.addEventListener('input', function(e){__loom_fire('input', e.target);}, true);"
    "document.addEventListener('change', function(e){__loom_fire('change', e.target);}, true);"
    ;; Enter in an input fires its `on-keydown.enter` term — the composer
    ;; gesture the web client already speaks (live/client.js). The event
    ;; carries the field's value (so a form needs no click) and clears the
    ;; field. Matching is by PREFIX: loom renders `:on-keydown.enter` to
    ;; `data-ev-keydown.enter`, so a bare `:on-keydown` fires on any key.
    "document.addEventListener('keydown', function(e){"
    "  if(e.key!=='Enter'||e.shiftKey) return;"
    "  var el=e.target, attr=null;"
    "  while(el&&el!==document){ if(el.getAttribute){"
    "    if(el.getAttribute('data-ev-keydown.enter')!=null){attr='data-ev-keydown.enter'; break;}"
    "    if(el.getAttribute('data-ev-keydown')!=null){attr='data-ev-keydown'; break;} }"
    "    el=el.parentNode; }"
    "  if(!attr) return;"
    "  e.preventDefault();"
    "  var term=JSON.parse(el.getAttribute(attr));"
    "  bl.send(JSON.stringify([term, __loom_val(e.target)]));"
    "  if(e.target.tagName==='INPUT') e.target.value='';"
    "}, true);"
    ;; ── the probe ───────────────────────────────────────────────────
    ;; `__loom_probe(id, thunk)` runs a host-supplied expression in the page
    ;; and posts the outcome back as ["__loom-reply", id, {ok|err}] — how a
    ;; test (or a curious desk) reads the live DOM in beam-lisp terms.
    "window.__loom_probe = function(id, f){var r;"
    "  try{var v=f(); r={ok:(v===undefined?null:v)};}catch(e){r={err:String(e)};}"
    "  bl.send(JSON.stringify(['__loom-reply', id, r]));};"
    ;; measure the first paint too
    "window.__loom_remeasure();"
    ;; and say so: a host whose page can be recreated under it (a phone
    ;; WebView after a rotation, a back-navigation) repaints the CURRENT
    ;; frame on this, since the page only ever holds the first one.
    "bl.send(JSON.stringify(['__loom-ready']));"))

;; ── down: ASCII-only JavaScript ────────────────────────────────────────

(defn- hex4 [c] (String/pad_leading (lower-case (erlang/integer_to_binary c 16)) 4 "0"))

(defn- escape-char [c]
  (cond
    (< c 128) c
    (< c 65536) (str "\\u" (hex4 c))
    ;; beyond the BMP: a UTF-16 surrogate pair, as JSON and JS spell it
    :else (let [v (- c 65536)]
            (str "\\u" (hex4 (+ 55296 (erlang/bsr v 10)))
                 "\\u" (hex4 (+ 56320 (erlang/band v 1023)))))))

(defn ascii
  "`s` with every non-ASCII character as a `\\uXXXX` escape (surrogate pairs
   beyond the BMP). Only valid INSIDE a JSON/JS string literal — which is where
   `js-str` puts it."
  [s]
  (if (= :nomatch (re/run s "[^\\x00-\\x7f]"))
    s
    (erlang/iolist_to_binary (lists/map escape-char (unicode/characters_to_list s)))))

(defn js-str
  "`s` as a JavaScript string literal made only of ASCII: JSON-quoted, then
   escaped. U+2028/2029, `</script>`-free contexts and emoji all survive any
   seam."
  [s]
  (ascii (interop/->json s)))

;; ── frames ─────────────────────────────────────────────────────────────
;;
;; `t/with-sheet` runs the view with a fresh atomic-CSS sheet and returns the
;; realized tree plus the <style> element. The first frame builds a whole
;; document (so the hook and root exist); later frames send just the body HTML
;; and the current sheet CSS, which the hook swaps in.

(defn frame
  "Run `view` on `state` → `{:body <html> :css <sheet css>}`."
  [view state]
  (let [result (t/with-sheet (fn [] (view state)))]
    {:body (h/hiccup->html (:tree result))
     ;; the style element's second item is the full CSS text (base + sheet)
     :css (second (:style result))}))

(defn swap-js
  "The JavaScript that shows `frame` on a live page: the sheet first (so its
   classes exist), then the body."
  [fr]
  (str "window.__loom_style(" (js-str (:css fr)) ");"
       "window.__loom_swap(" (js-str (:body fr)) ");"))

; when the window is transparent, loom's base-css still paints an opaque
; `body{background:<bg>}`. This override (emitted AFTER the sheet, so it wins)
; makes the document itself see-through, leaving only the view's own
; translucent blocks visible — the compositor shows through the rest.
(def ^:private transparent-css
  "html,body{background:transparent !important}")

(defn document
  "The first-paint HTML: the host's shim, the hook, a live <style>, and the app
   root holding the first body. Everything a frame needs exists after this.
   `opts`: `:title`, `:transparent?` (see-through document), `:shim` (JS that
   runs BEFORE the hook — where a host defines `bl.send`), `:head` (extra
   markup for <head>)."
  [fr opts]
  (str "<!doctype html><html lang=\"en\"><head>"
       "<meta charset=\"utf-8\">"
       "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
       "<title>" (h/escape (or (:title opts) "beam-lisp")) "</title>"
       "<style id=\"loom-style\">" (:css fr) "</style>"
       (if (:transparent? opts) (str "<style>" transparent-css "</style>") "")
       (or (:head opts) "")
       "</head><body>"
       "<div id=\"loom-root\">" (:body fr) "</div>"
       (if (:shim opts) (str "<script>" (:shim opts) "</script>") "")
       "<script>" client-hook "</script>"
       "</body></html>"))

;; ── up: the event parse ──────────────────────────────────────────────
;;
;; The page posts a JSON string. Decode it to beam-lisp data; a leading
;; string head (JSON has no keywords) is turned back into a keyword so a
;; reducer can `(case (first ev) :inc … )` naturally. `[["inc"]]`-shaped
;; nesting from the input/change wrapper is handled too.

(defn- keywordize-head
  "A decoded JSON event `[inc …]` → `[:inc …]`; a nested `[[assign k] v]`
   keywordizes the inner head as well. Non-list events pass through."
  [ev]
  (cond
    (and (or (list? ev) (vector? ev)) (seq ev))
      ;; build a VECTOR, not `(cons kw (map …))`: consing a keyword onto a lazy
      ;; seq makes an improper list that `nth`/`second`/`vec` cannot index.
      (let [head (first ev)
            head' (if (string? head) (keyword head) (keywordize-head head))
            tail (mapv keywordize-head (rest ev))]
        (into [head'] tail))
    :else ev))

(defn parse-event
  "A page message (JSON text) → the event term; unparseable text arrives as
   `[:raw text]`."
  [body]
  (try
    (keywordize-head (interop/json-> body))
    (catch _ [:raw body])))

(defn reserved
  "The surface's own traffic, which a host acts on and the reducer never sees:
     [:height h]      the page's content height changed (auto-sizing hosts)
     [:ready]         the page (re)loaded and holds only the FIRST frame
     [:reply id res]  a `probe-js` answered; `res` is {ok v} or {err msg}
   nil for an app event."
  [ev]
  (when (and (vector? ev) (seq ev))
    (case (first ev)
      :__loom-height [:height (nth ev 1 nil)]
      :__loom-ready [:ready]
      :__loom-reply [:reply (nth ev 1 nil) (nth ev 2 nil)]
      nil)))

;; ── the fold ─────────────────────────────────────────────────────────

(defn step
  "Fold `ev` into `state` through `on-event` → `[state' js]`, where `js` shows
   the new frame, or nil when the state did not move (the page is already
   right)."
  [view on-event state ev]
  (let [state' (on-event state ev)]
    [state' (when (not= state' state) (swap-js (frame view state')))]))

(defn repaint-js
  "The JavaScript that shows `state`'s frame, changed or not."
  [view state]
  (swap-js (frame view state)))

(defn probe-js
  "The JavaScript that evaluates `expr` (a JS expression) in the page and
   answers `[:reply id {ok v}]` — or `{err msg}` when it throws."
  [id expr]
  (str "window.__loom_probe(" (interop/->json id) ",function(){return (" expr ");});"))
