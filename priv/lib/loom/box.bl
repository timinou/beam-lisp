; loom/box.bl — the layout algebra: every arrangement is a point in one space.
;
; ── The idea ──────────────────────────────────────────────────────────
;
; The Grammar of Graphics does not enumerate chart types; it composes a few
; orthogonal parts. Layout is the same. There is ONE primitive — `box` — and
; every arrangement (a column, a row, a wrap grid, a centered hero, a
; sidebar+content split, a responsive stack that becomes a row at :md) is a
; POINT in its parameter space, not a new component.
;
; A box is a flex/grid container described by data:
;
;   :dir      :col | :row | :row-reverse | :col-reverse   (flex-direction)
;   :gap      token | number | "raw"                       (gap)
;   :pad      token | number | "raw" | [y x] | [t r b l]   (padding)
;   :align    :start :center :end :stretch :baseline        (align-items)
;   :justify  :start :center :end :between :around :evenly   (justify-content)
;   :wrap     true | false                                   (flex-wrap)
;   :grow     n                                              (flex-grow, on SELF)
;   :basis    token|number|"raw"                             (flex-basis, on SELF)
;   :w :h     token|number|"raw" | :full | :screen           (width/height)
;   :max-w    token|number|"raw"                              (max-width)
;   :grid     n (equal cols) | "raw template" | :auto-fit    (→ display:grid)
;   :min-col  token|number|"raw"    (auto-fit min column width; default 240px)
;   :bg :radius :shadow :border     token-or-raw skin passthroughs
;   :at       {:md {…box props…} :lg {…}}   responsive overrides (min-width)
;   :on       {:hover {…css…}}              stateful raw css
;   :style    {…raw css…}                   ESCAPE HATCH — merged LAST, wins
;   :as       :section | :main | :ul | …    the element tag (default :div)
;
; NOTHING here is a ceiling. Every value may be a raw string; `:style` can say
; anything the props cannot; a caller may pass any extra HTML attr and it is
; forwarded. The algebra is the happy path, not a fence.

(ns loom.box
  (:require [loom.token :as t]))

;; ── enum → css value maps ───────────────────────────────────────────

(def ^:private align-css
  {:start "flex-start" :center "center" :end "flex-end"
   :stretch "stretch" :baseline "baseline"})

(def ^:private justify-css
  {:start "flex-start" :center "center" :end "flex-end"
   :between "space-between" :around "space-around" :evenly "space-evenly"})

(def ^:private dir-css
  {:col "column" :row "row" :row-reverse "row-reverse" :col-reverse "column-reverse"})

;; ── pad: a token/number/raw, or a [y x] / [t r b l] vector ──────────

(defn- pad-css [p]
  (cond
    (vector? p)
      (join " " (map t/len p))          ; [y x] or [t r b l], each token-or-raw
    :else (t/len p)))

;; ── dimension: token/number/raw, plus :full and :screen keywords ────

(defn- dim [v axis]
  (cond
    (= v :full)   "100%"
    (= v :screen) (if (= axis :h) "100vh" "100vw")
    :else         (t/len v)))

;; ── the core: box props → a flat css map (no variants) ──────────────
;;
;; Split out so it can render the base rule AND each `:at` override through
;; the same logic — a responsive override is just another box map.

(defn box-css
  "A map of box props → a flat CSS declaration map. Grid and flex are one
   surface: `:grid` switches display and lets the same gap/align/justify/pad
   describe a grid. `:style` (raw) is merged by the CALLER, last."
  [p]
  (let [grid (get p :grid)
        display (cond (some? grid) "grid"
                      (contains? p :inline) "inline-flex"
                      :else "flex")
        base {:display display}
        ;; flex axis (ignored by grid but harmless to omit there)
        base (if (some? grid) base
               (merge base {:flex-direction (get dir-css (get p :dir :col) "column")}))
        ;; grid template
        base (cond
               (nil? grid) base
               (number? grid) (assoc base :grid-template-columns
                                     (str "repeat(" grid ",minmax(0,1fr))"))
               (= grid :auto-fit) (assoc base :grid-template-columns
                                     (str "repeat(auto-fit,minmax("
                                          (t/len (get p :min-col 240)) ",1fr))"))
               :else (assoc base :grid-template-columns (str grid)))
        add (fn [m k v] (if (nil? v) m (assoc m k v)))]
    (-> base
        (add :gap (when (contains? p :gap) (t/len (get p :gap))))
        (add :padding (when (contains? p :pad) (pad-css (get p :pad))))
        (add :align-items (when (contains? p :align) (get align-css (get p :align) (name (get p :align)))))
        (add :justify-content (when (contains? p :justify) (get justify-css (get p :justify) (name (get p :justify)))))
        (add :flex-wrap (when (get p :wrap) "wrap"))
        (add :flex-grow (when (contains? p :grow) (str (get p :grow))))
        (add :flex-shrink (when (contains? p :shrink) (str (get p :shrink))))
        (add :flex-basis (when (contains? p :basis) (t/len (get p :basis))))
        (add :width (when (contains? p :w) (dim (get p :w) :w)))
        (add :height (when (contains? p :h) (dim (get p :h) :h)))
        (add :max-width (when (contains? p :max-w) (dim (get p :max-w) :w)))
        (add :min-width (when (contains? p :min-w) (dim (get p :min-w) :w)))
        (add :min-height (when (contains? p :min-h) (dim (get p :min-h) :h)))
        (add :background (when (contains? p :bg) (t/hue (get p :bg))))
        (add :color (when (contains? p :fg) (t/hue (get p :fg))))
        (add :border-radius (when (contains? p :radius) (let [r (get p :radius)] (if (keyword? r) (t/radius r) (t/len r)))))
        (add :box-shadow (when (contains? p :shadow) (if (keyword? (get p :shadow)) (t/shadow (get p :shadow)) (str (get p :shadow)))))
        (add :border (when (contains? p :border)
                       (let [b (get p :border)]
                         (if (= b true) (str "1px solid " (t/color :border)) (str b))))))))

;; props consumed by the algebra — everything else is forwarded to the DOM
(def ^:private own-keys
  #{:dir :gap :pad :align :justify :wrap :grow :shrink :basis :w :h :max-w
    :min-w :min-h :bg :fg :radius :shadow :border :grid :min-col :inline
    :at :on :style :as :class})

(defn- forward [p] (apply dissoc p (into [] own-keys)))

(defn box
  "The layout primitive. `(box {props} & children)` → hiccup.
   Props are a point in the layout space; `:at` adds responsive overrides,
   `:on` stateful css, `:style` a raw override that wins. Any non-layout key
   (e.g. :on-click, :id, :data-*) is forwarded to the element."
  [& args]
  (let [p (if (and (seq args) (map? (first args))) (first args) {})
        body (if (and (seq args) (map? (first args))) (rest args) args)
        raw (get p :style {})
        base (merge (box-css p) raw)                 ; escape hatch wins
        at (get p :at)
        on (get p :on)
        cls (if (or (some? at) (some? on))
              (t/sx* {:base base
                      :on (or on {})
                      :at (reduce (fn [m kv]
                                    (assoc m (first kv)
                                           (merge (box-css (second kv))
                                                  (get (second kv) :style {}))))
                                  {} (seq (or at {})))})
              (t/sx base))
        tag (get p :as :div)
        author-class (get p :class)
        class-attr (if author-class (str cls " " author-class) cls)]
    (into [tag (merge {:class class-attr} (forward p))] body)))

;; ── named arrangements: thin points in the space, for readability ───
;;
;; These add NOTHING the raw `box` cannot express — they are just the most
;; common points, named. A caller who wants something unnamed reaches for
;; `box` directly. No arrangement is privileged; these are convenience, not
;; capability.

(defn col   [& a] (apply box (merge {:dir :col :gap :4} (if (map? (first a)) (first a) {})) (if (map? (first a)) (rest a) a)))
(defn row   [& a] (apply box (merge {:dir :row :gap :3 :align :center} (if (map? (first a)) (first a) {})) (if (map? (first a)) (rest a) a)))
(defn wrap  [& a] (apply box (merge {:dir :row :gap :3 :wrap true} (if (map? (first a)) (first a) {})) (if (map? (first a)) (rest a) a)))
(defn grid  [& a] (apply box (merge {:grid :auto-fit :gap :4} (if (map? (first a)) (first a) {})) (if (map? (first a)) (rest a) a)))
(defn center [& a] (apply box (merge {:align :center :justify :center} (if (map? (first a)) (first a) {})) (if (map? (first a)) (rest a) a)))

(defn spacer
  "A flex spacer — pushes siblings apart. `(spacer)` grows; `(spacer 2)` at rate 2."
  ([] (spacer 1))
  ([n] [:div {:class (t/sx {:flex-grow (str n)})}]))
