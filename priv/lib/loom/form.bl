; loom/form.bl — a form is a projection of a schema, the way an axis is of a scale.
;
; ── The idea ──────────────────────────────────────────────────────────
;
; A datom schema is already a VALUE: a vector of attribute maps, each with a
; `:db/valueType`, a `:db/cardinality`, maybe a `:db/doc`. The Grammar of
; Graphics derives a chart's axis from its scale; loom derives a FORM from its
; schema — one field per attribute, its input kind chosen by the value type,
; its validation the same predicate the database already uses. Nothing is
; hand-wired: change the schema, the form changes.
;
;   (form-for schema {:on-submit [:intent :save]
;                     :values {:person/name "Ada"}   ; pre-fill
;                     :errors {:person/name "required"} ; per-attr, aria-wired
;                     :only [:person/name :person/age]  ; optional allow-list
;                     :edit? true})                     ; identity → read-only
;   → a loom.ui form (a column of fields + a submit button)
;
; The form is a pure function of the schema and the options — it renders in a
; static page and drives a live socket unchanged, and its accessibility comes
; free from loom.ui/field (label wiring, aria-invalid, role=alert).

(ns loom.form
  (:require [loom.ui :as ui]
            [loom.box :as b]
            [loom.token :as t]))

;; ── schema plumbing (the authored VECTOR-of-attr-maps form) ─────────

(defn- attr-ident [a] (get a :db/ident))
(defn- attr-type  [a] (get a :db/valueType))
(defn- attr-doc   [a] (get a :db/doc))
(defn- attr-card  [a] (or (get a :db/cardinality) :db.cardinality/one))
(defn- attr-unique [a] (get a :db/unique))
(defn- identity-attr? [a] (= :db.unique/identity (attr-unique a)))

;; ── valueType → field kind ──────────────────────────────────────────
;;
;; The mapping table. A hint on the attribute (:form/multiline, :form/enum,
;; :form/label) refines the default without changing the schema's meaning.

(defn- input-type-for
  "The HTML input `type` for a scalar value type."
  [vt]
  (cond
    (= vt :db.type/long)    "number"
    (= vt :db.type/instant) "datetime-local"
    :else                   "text"))

(defn- humanise
  "\"first-name\" → \"First name\": dashes to spaces, first letter upper."
  [nm]
  (let [spaced (String/replace nm "-" " ")]
    (if (= spaced "") spaced
      (str (String/upcase (subs spaced 0 1)) (subs spaced 1 (count spaced))))))

(defn- label-for
  "A human label: the explicit :form/label hint, else the ident's name
   humanised (:person/first-name → \"First name\")."
  [a]
  (or (get a :form/label) (humanise (name (attr-ident a)))))

;; ── one field per attribute ─────────────────────────────────────────

(defn- field-for
  "The loom.ui field for one schema attribute, pre-filled and error-wired."
  [a opts]
  (let [id (attr-ident a)
        vt (attr-type a)
        values (get opts :values {})
        errors (get opts :errors {})
        edit? (get opts :edit? false)
        value (get values id "")
        error (get errors id)
        hint (attr-doc a)
        label (label-for a)
        ro (and edit? (identity-attr? a))
        base {:name id :label label :value value
              :on-input [:assign id [:from :value]]}
        base (if error (assoc base :error error) base)
        base (if hint (assoc base :hint hint) base)
        base (if ro (assoc base :disabled true) base)]
    (cond
      ;; boolean → a checkbox (checked from the value)
      (= vt :db.type/boolean)
        (ui/checkbox {:name id :label label :checked (= true value)
                      :on-change [:assign id [:from :checked]]})

      ;; keyword with an enum hint → a select
      (and (= vt :db.type/keyword) (get a :form/enum))
        (b/col {:gap :1 :style {:margin-bottom (t/space :4)}}
          [:label {:class (t/sx {:font-size (t/text :sm) :font-weight (t/weight :medium)
                                 :color (t/color :muted)})} label]
          (ui/select {:name id :value value
                      :options (get a :form/enum)
                      :on-change [:assign id [:from :value]]}))

      ;; string with a multiline hint → a textarea
      (and (= vt :db.type/string) (get a :form/multiline))
        (ui/field (assoc base :multiline true))

      ;; everything else → a typed text/number input
      :else
        (ui/field (assoc base :type (input-type-for vt))))))

;; ── the form ────────────────────────────────────────────────────────

(defn- form-attrs
  "The attributes to render: schema order, filtered by :only, and dropping
   the internal :db/* attributes a caller never edits."
  [schema opts]
  (let [only (get opts :only)
        wanted (filter (fn [a]
                         (let [id (attr-ident a)]
                           (and (some? id)
                                (not (String/starts_with? (name id) "db"))
                                (or (nil? only) (contains? (set only) id)))))
                       schema)]
    (into [] wanted)))

(defn form-for
  "Derive a loom.ui form from a datom `schema` (the authored vector of attribute
   maps). `opts`:
     :on-submit  an event term fired by the submit button (required for a button)
     :values     {ident → value} to pre-fill
     :errors     {ident → message} shown via the aria-wired field
     :only       [ident …] to render a subset, in that priority (schema order otherwise)
     :edit?      true → identity attributes render read-only
     :submit     the submit button label (default \"Save\")"
  [schema opts]
  (let [attrs (form-attrs schema opts)
        on-submit (get opts :on-submit)
        submit-label (get opts :submit "Save")
        fields (map (fn [a] (field-for a opts)) attrs)
        submit (when on-submit
                 (b/row {:gap :2 :style {:margin-top (t/space :2)}}
                   (ui/button {:variant :primary :on-click on-submit} submit-label)))]
    ;; splice the fields as individual children (a seq child, not a vector),
    ;; then the submit row; drop the nil submit when absent.
    (apply b/box
           {:as :form :dir :col :gap :2 :style {:max-width "420px"}}
           (into [] (filter some? (concat fields [submit]))))))
