; loom/form.bl — a form is a projection of a schema, the way an axis is of a scale.
;
; ── The idea ──────────────────────────────────────────────────────────
;
; A datom schema is already a VALUE: a vector of attribute maps, each with a
; `:db/valueType`, a `:db/cardinality`, maybe a `:db/doc`. The Grammar of
; Graphics derives a chart's axis from its scale; loom derives a FORM from its
; schema — one field per attribute, its input kind chosen by the value type,
; its validation the same predicate the database already uses. Nothing is
; hand-wired: change the schema, the form changes.
;
;   (form-for schema {:on-submit [:intent :save]
;                     :values {:person/name "Ada"}   ; pre-fill
;                     :errors {:person/name "required"} ; per-attr, aria-wired
;                     :only [:person/name :person/age]  ; optional allow-list
;                     :edit? true})                     ; identity → read-only
;   → a loom.ui form (a column of fields + a submit button)
;
; The form is a pure function of the schema and the options — it renders in a
; static page and drives a live socket unchanged, and its accessibility comes
; free from loom.ui/field (label wiring, aria-invalid, role=alert).
;
; ── Three shapes of schema, one form ──────────────────────────────────
;
; `schema` may be any of:
;   · the datom vector of attribute maps (above) — the store's own words;
;   · a defrecord TYPE or INSTANCE — one field per declared field, its kind
;     inferred from the instance's value (an int → number, a boolean →
;     checkbox, a keyword → text, a string → text) and refined by `:hints`
;     ({field {:form/label … :form/enum … :db/valueType …}}), so a record
;     already in hand IS its form: (form-for order {:values order …});
;   · a plain map {:fields [{:db/ident …}…]} (a hand-written spec).
; `as-attrs` normalises them; everything downstream sees attribute maps.
;
; ── Honest defaults ───────────────────────────────────────────────────
;
; A select SHOWS its first option when no value is set — so that option is the
; value the user sees and expects to submit. The form therefore treats the
; first enum entry as the field's effective value (`effective-values`), and
; a caller reads what the screen shows: (form/effective-values schema values).
; A drawer that read only its locals submitted `nil` for a select the user
; never touched — the bug this closes.

(ns loom.form
  (:require [loom.ui :as ui]
            [loom.box :as b]
            [loom.token :as t]))

;; ── schema plumbing: three shapes → a vector of attr maps ────────────

(defn- record-module
  "The struct module of a defrecord type symbol or instance, else nil."
  [x]
  (cond
    (BeamLisp.Record/record? x) (erlang/map_get :__struct__ x)
    (and (keyword? x) (BeamLisp.Record/record_module? x)) x
    :else nil))

(defn- type-of-value
  "The :db/valueType a sample value implies (nil → :db.type/string)."
  [v]
  (cond
    (erlang/is_boolean v) :db.type/boolean
    (erlang/is_integer v) :db.type/long
    (keyword? v) :db.type/keyword
    :else :db.type/string))

(defn as-attrs
  "Normalise `schema` to the vector of attribute maps form-for reads:
   a vector passes through; {:fields [...]} unwraps; a defrecord type or
   instance yields one attr per declared field (:db/ident = the field
   keyword), typed from the instance's value and merged with `hints`
   ({field {…}}) so a record's form can name labels, enums and docs without
   the record knowing about forms."
  ([schema] (as-attrs schema {}))
  ([schema hints]
   (cond
     (vector? schema) schema
     (and (map? schema) (contains? schema :fields)) (into [] (get schema :fields))
     (record-module schema)
       (let [mod (record-module schema)
             inst (if (keyword? schema) nil schema)]
         (into []
           (map (fn [f]
                  (let [h (get hints f {})
                        v (when inst (get inst f))]
                    (merge {:db/ident f
                            :db/valueType (or (get h :db/valueType) (type-of-value v))}
                           h)))
                (BeamLisp.Record/fields_of mod))))
     (seq? schema) (into [] schema)
     :else (throw (ex-info "form-for: unknown schema shape" {:schema schema})))))

(defn- attr-ident [a] (get a :db/ident))
(defn- attr-type  [a] (get a :db/valueType))
(defn- attr-doc   [a] (get a :db/doc))
(defn- attr-card  [a] (or (get a :db/cardinality) :db.cardinality/one))
(defn- attr-unique [a] (get a :db/unique))
(defn- identity-attr? [a] (= :db.unique/identity (attr-unique a)))

;; ── valueType → field kind ──────────────────────────────────────────
;;
;; The mapping table. A hint on the attribute (:form/multiline, :form/enum,
;; :form/label) refines the default without changing the schema's meaning.

(defn- input-type-for
  "The HTML input `type` for a scalar value type."
  [vt]
  (cond
    (= vt :db.type/long)    "number"
    (= vt :db.type/instant) "datetime-local"
    :else                   "text"))

(defn- humanise
  "\"first-name\" → \"First name\": dashes to spaces, first letter upper."
  [nm]
  (let [spaced (String/replace nm "-" " ")]
    (if (= spaced "") spaced
      (str (String/upcase (subs spaced 0 1)) (subs spaced 1 (count spaced))))))

(defn- label-for
  "A human label: the explicit :form/label hint, else the ident's name
   humanised (:person/first-name → \"First name\")."
  [a]
  (or (get a :form/label) (humanise (name (attr-ident a)))))

;; ── one field per attribute ─────────────────────────────────────────

(defn- field-for
  "The loom.ui field for one schema attribute, pre-filled and error-wired."
  [a opts]
  (let [id (attr-ident a)
        vt (attr-type a)
        values (get opts :values {})
        errors (get opts :errors {})
        edit? (get opts :edit? false)
        value (get values id "")
        error (get errors id)
        hint (attr-doc a)
        label (label-for a)
        ro (and edit? (identity-attr? a))
        base {:name id :label label :value value
              :on-input [:assign id [:from :value]]}
        base (if error (assoc base :error error) base)
        base (if hint (assoc base :hint hint) base)
        base (if ro (assoc base :disabled true) base)]
    (cond
      ;; boolean → a checkbox (checked from the value)
      (= vt :db.type/boolean)
        (ui/checkbox {:name id :label label :checked (= true value)
                      :on-change [:assign id [:from :checked]]})

      ;; keyword with an enum hint → a select
      (and (= vt :db.type/keyword) (get a :form/enum))
        (b/col {:gap :1 :style {:margin-bottom (t/space :4)}}
          [:label {:class (t/sx {:font-size (t/text :sm) :font-weight (t/weight :medium)
                                 :color (t/color :muted)})} label]
          (ui/select {:name id :value value
                      :options (get a :form/enum)
                      :on-change [:assign id [:from :value]]}))

      ;; string with a multiline hint → a textarea
      (and (= vt :db.type/string) (get a :form/multiline))
        (ui/field (assoc base :multiline true))

      ;; everything else → a typed text/number input; a number carries its
      ;; range hints as HTML constraints (the browser enforces them first)
      :else
        (ui/field (merge (assoc base :type (input-type-for vt))
                         (when (= vt :db.type/long)
                           (merge (when-let [mn (get a :form/min)] {:min mn})
                                  (when-let [mx (get a :form/max)] {:max mx})
                                  (when-let [st (get a :form/step)] {:step st})))
                         (when-let [ph (get a :form/placeholder)] {:placeholder ph}))))))

;; ── the form ────────────────────────────────────────────────────────

(defn- form-attrs
  "The attributes to render: schema order, filtered by :only, and dropping
   the internal :db/* attributes a caller never edits."
  [schema opts]
  (let [only (get opts :only)
        wanted (filter (fn [a]
                         (let [id (attr-ident a)]
                           (and (some? id)
                                (not (String/starts_with? (name id) "db"))
                                (or (nil? only) (contains? (set only) id)))))
                       schema)]
    (into [] wanted)))

(defn effective-values
  "What the screen SHOWS for each attribute, given `values`: the value set,
   else — for a select — its first option (the one the browser displays and
   the user believes is chosen). The submit must carry THIS, not the raw
   locals, or an untouched select submits nil. Pure; the same rule the
   fields render with."
  [schema values]
  (reduce (fn [m a]
            (let [id (attr-ident a) v (get values id)
                  enum (get a :form/enum)]
              (cond
                (some? v) (assoc m id v)
                (and (= :db.type/keyword (attr-type a)) (seq enum)) (assoc m id (first (first enum)))
                :else m)))
          {} (form-attrs schema {})))

(defn- section-of
  "A field's :form/section (nil = the unnamed default group)."
  [a] (get a :form/section))

(defn- section-block
  "A titled group of fields: the section name as a small heading, then its
   fields. `nil` title → the fields alone."
  [title fields]
  (if (nil? title)
    (into [] fields)
    [(apply b/col {:gap :1 :style {:margin-top (t/space :2)}}
       [:div {:class (t/sx {:font-size (t/text :xs) :font-weight (t/weight :semibold)
                            :letter-spacing "0.08em" :text-transform "uppercase"
                            :color (t/color :muted)})} title]
       (into [] fields))]))

(defn form-for
  "Derive a loom.ui form from `schema` — a datom attribute vector, a defrecord
   type/instance, or {:fields […]} (see `as-attrs`). `opts`:
     :hints      {ident {:form/label … :form/enum … :db/valueType …}} merged
                 into record-derived attrs (ignored for a vector schema)
     :sections   true → group fields by their :form/section, in first-seen order
     :on-submit  an event term fired by the submit button (required for a button)
     :values     {ident → value} to pre-fill
     :errors     {ident → message} shown via the aria-wired field
     :only       [ident …] to render a subset, in that priority (schema order otherwise)
     :edit?      true → identity attributes render read-only
     :submit     the submit button label (default \"Save\")
     :submit-attrs extra attributes for the submit button (e.g. a data-testid)
     :attrs      extra attributes for the <form> box (a wider :style, a testid)"
  [schema opts]
  (let [attrs (form-attrs (as-attrs schema (get opts :hints {})) opts)
        on-submit (get opts :on-submit)
        submit-label (get opts :submit "Save")
        ;; render against what the screen shows, so a select's displayed
        ;; option and its value attribute agree
        opts (assoc opts :values (merge (effective-values attrs (get opts :values {}))
                                        (get opts :values {})))
        fields (if (get opts :sections)
                 (let [order (distinct (map section-of attrs))]
                   (mapcat (fn [sec] (section-block sec (map (fn [a] (field-for a opts))
                                                             (filter (fn [a] (= sec (section-of a))) attrs))))
                           order))
                 (map (fn [a] (field-for a opts)) attrs))
        submit (when on-submit
                 (b/row {:gap :2 :style {:margin-top (t/space :2)}}
                   (ui/button (merge {:variant :primary :on-click on-submit}
                                     (get opts :submit-attrs {}))
                     submit-label)))]
    ;; splice the fields as individual children (a seq child, not a vector),
    ;; then the submit row; drop the nil submit when absent.
    (apply b/box
           (merge {:as :form :dir :col :gap :2 :style {:max-width "420px"}}
                  (get opts :attrs {}))
           (into [] (filter some? (concat fields [submit]))))))
