; loom/ui.bl — the component vocabulary: accessible marks, built from the box.
;
; ── The idea ──────────────────────────────────────────────────────────
;
; A component is a pure function that returns hiccup, painted from the token
; scale and arranged by the box algebra, carrying the accessibility semantics
; most hand-written UIs forget: real labels tied to inputs, ARIA roles and
; states, keyboard affordances, visible focus, disabled handling. Because these
; are baked into the primitive, every button in the app is accessible by
; default — you cannot ship the broken version by accident.
;
; Every component is a pure function of its inputs, so it renders in a static
; page and drives a live socket unchanged. Events are the closed vocabulary the
; socket understands: :on-click carries an [:intent …] / [:assign …] /
; [:navigate …] term (or a vector of them), never a closure. loom/ui does not
; interpret those terms — it forwards them, and hiccup renders them to
; `data-ev-*` markers the client hook reads.
;
; ── The no-ceiling contract, inherited ────────────────────────────────
;
; Every component funnels its own attrs through loom.box, so it inherits the
; box's escape hatches for FREE: a raw `:style` map that wins, arbitrary HTML
; attrs (events, ids, data-*, aria-*) forwarded to the element, and an author
; `:class` appended. A component author never re-implements these; a component
; USER is never boxed in.

(ns loom.ui
  (:require [loom.token :as t]
            [loom.box :as b]))

;; ── option plumbing ─────────────────────────────────────────────────
;;
;; Every component takes an optional leading opts map, then body children.

(defn- opts-of [args] (if (and (seq args) (map? (first args))) (first args) {}))
(defn- body-of [args] (if (and (seq args) (map? (first args))) (rest args) args))

(defn- name-str [x] (if (keyword? x) (name x) (str x)))

;; ════════════════════════════════════════════════════════════════════
;; Button — the workhorse action
;; ════════════════════════════════════════════════════════════════════
;;
;; (button {:variant :primary :on-click [:intent :save {}]} "Save")
;;
;; variants: :primary (accent) · :subtle (default) · :ghost (quiet) · :danger
;; sizes:    :sm :md :lg
;; A disabled button sets the real `disabled` attr AND aria-disabled, and drops
;; its handler — a disabled action cannot fire.

(defn- button-skin [variant]
  (case variant
    :primary {:bg :accent :fg :accent-fg}
    :danger  {:bg :danger :fg :accent-fg}
    :ghost   {:bg "transparent" :fg :text :border true}
    :subtle  {:bg :surface-2 :fg :text :border true}
    {:bg :surface-2 :fg :text :border true}))

(defn- button-pad [size]
  (case size :sm [:1 :3] :lg [:3 :5] [:2 :4]))

(defn- button-font [size]
  (case size :sm :sm :lg :lg :md))

(defn button
  [& args]
  (let [opts (opts-of args)
        body (body-of args)
        variant (get opts :variant :subtle)
        size (get opts :size :md)
        disabled (get opts :disabled false)
        skin (button-skin variant)
        ;; the box props: layout + skin, then the caller's own opts merged so a
        ;; raw :style / extra attr / event flows straight through the box.
        box-opts (merge {:as :button :inline true :dir :row :align :center :gap :2
                         :pad (button-pad size) :radius :md
                         :type "button"
                         :style (merge {:font-size (t/text (button-font size))
                                        :font-weight (t/weight :semibold)
                                        :line-height "1" :cursor "pointer"
                                        :border (if (get skin :border) (str "1px solid " (t/color :border)) "1px solid transparent")
                                        :user-select "none"
                                        :transition (str "background " (t/tok :motion :fast) " " (t/tok :motion :ease))}
                                       (when disabled {:opacity "0.5" :cursor "not-allowed"})
                                       (get opts :style {}))}
                        {:bg (get skin :bg) :fg (get skin :fg)}
                        ;; caller opts minus the ones we consumed ourselves
                        (dissoc opts :variant :size :disabled :style :border)
                        ;; a disabled button carries the real attrs and NO handler
                        (if disabled
                          {:disabled true :aria-disabled "true" :on-click nil}
                          {}))
        ;; strip a nil'd :on-click so it never reaches the DOM
        box-opts (if (nil? (get box-opts :on-click)) (dissoc box-opts :on-click) box-opts)]
    (apply b/box box-opts body)))

;; ════════════════════════════════════════════════════════════════════
;; Field — a labelled input, wired for assistive tech
;; ════════════════════════════════════════════════════════════════════
;;
;; (field {:name :email :label "Email" :value v
;;         :on-input [:assign :email [:from :value]]
;;         :error "Not a valid address" :hint "we never share it"})
;;
;; A real <label for=…> tied to the input id (click the label → focus the
;; input). An error is wired via aria-invalid + aria-describedby + role=alert,
;; so a screen reader announces it.

(defn- field-input-style [error]
  {:padding (str (t/space :2) " " (t/space :3))
   :font-size (t/text :md) :color (t/color :text)
   :background (t/color :surface)
   :border (str "1px solid " (if error (t/color :danger) (t/color :border)))
   :border-radius (t/radius :md) :width "100%"
   :transition (str "border-color " (t/tok :motion :fast) " " (t/tok :motion :ease))})

(defn field
  [opts]
  (let [nm (get opts :name)
        id (str "f-" (name-str nm))
        label (get opts :label)
        value (get opts :value "")
        error (get opts :error)
        hint (get opts :hint)
        multiline (get opts :multiline false)
        err-id (str id "-err")
        hint-id (str id "-hint")
        described (join " " (filterv some? [(when hint hint-id) (when error err-id)]))
        input-cls (t/sx (field-input-style error))
        ;; attrs the caller may add (events, autocomplete, placeholder) minus our own
        passthrough (dissoc opts :name :label :value :error :hint :multiline :type :style)
        input-attrs (merge {:class (if (get opts :style) (str input-cls " " (t/sx (get opts :style))) input-cls)
                            :id id :name (name-str nm) :value value}
                           (when (not multiline) {:type (get opts :type "text")})
                           (when (not= described "") {:aria-describedby described})
                           (when error {:aria-invalid "true"})
                           passthrough)]
    (b/col {:gap :1 :style {:margin-bottom (t/space :4)}}
      (when label
        [:label {:class (t/sx {:font-size (t/text :sm) :font-weight (t/weight :medium)
                               :color (t/color :muted)})
                 :for id} label])
      (if multiline
        (into [:textarea input-attrs] [value])
        [:input input-attrs])
      (when hint
        [:div {:class (t/sx {:font-size (t/text :sm) :color (t/color :faint)})
               :id hint-id} hint])
      (when error
        [:div {:class (t/sx {:font-size (t/text :sm) :color (t/color :danger)})
               :id err-id :role "alert"} error]))))

;; ════════════════════════════════════════════════════════════════════
;; Checkbox / Switch — a boolean, labelled
;; ════════════════════════════════════════════════════════════════════

(defn checkbox
  [opts]
  (let [nm (get opts :name)
        id (str "c-" (name-str nm))
        label (get opts :label)
        checked (get opts :checked false)
        passthrough (dissoc opts :name :label :checked :style)]
    (b/row {:gap :2 :align :center}
      [:input (merge {:type "checkbox" :id id :name (name-str nm)}
                     (when checked {:checked true})
                     passthrough)]
      (when label [:label {:for id :class (t/sx {:font-size (t/text :md) :color (t/color :text)})} label]))))

;; ════════════════════════════════════════════════════════════════════
;; Select — a keyword choice
;; ════════════════════════════════════════════════════════════════════
;;
;; (select {:name :role :value :admin
;;          :options [[:admin "Admin"] [:member "Member"]]})

(defn select
  [opts]
  (let [nm (get opts :name)
        id (str "s-" (name-str nm))
        value (get opts :value)
        options (get opts :options [])
        passthrough (dissoc opts :name :value :options :style :label)]
    [:select (merge {:id id :name (name-str nm)
                     :class (t/sx (field-input-style nil))}
                    passthrough)
     (for [o options]
       (let [ov (first o) olabel (second o)]
         [:option (merge {:value (name-str ov)} (when (= ov value) {:selected true}))
          olabel]))]))

;; ════════════════════════════════════════════════════════════════════
;; Card — a raised surface for grouping
;; ════════════════════════════════════════════════════════════════════

(defn card
  [& args]
  (let [opts (opts-of args) body (body-of args)]
    (apply b/box
           (merge {:dir :col :gap :4 :bg :surface :border true
                   :radius :lg :pad :5 :shadow :sm}
                  opts)
           body)))

;; ════════════════════════════════════════════════════════════════════
;; Typography — roles from the scale
;; ════════════════════════════════════════════════════════════════════

(defn heading
  [level & body]
  (let [sz (case level 1 :3xl 2 :2xl 3 :xl 4 :lg 5 :md :sm)
        cls (t/sx {:font-size (t/text sz) :font-weight (t/weight :bold)
                   :line-height (t/tok :leading :tight) :color (t/color :text)})]
    (into [(keyword (str "h" level)) {:class cls}] body)))

(defn prose
  [& args]
  (let [opts (opts-of args) body (body-of args)
        tone (get opts :tone :default)
        cls (t/sx (merge {:font-size (t/text :md) :line-height (t/tok :leading :relaxed)
                          :color (case tone :muted (t/color :muted) :faint (t/color :faint)
                                            (t/color :text))}
                         (get opts :style {})))]
    (into [:p (merge {:class cls} (dissoc opts :tone :style))] body)))

(defn link
  [& args]
  (let [opts (opts-of args) body (body-of args)
        cls (t/sx (merge {:color (t/color :accent) :text-decoration "none"}
                         (get opts :style {})))]
    (into [:a (merge {:class cls} (dissoc opts :style))] body)))

;; ════════════════════════════════════════════════════════════════════
;; Badge — a small status pill
;; ════════════════════════════════════════════════════════════════════

(defn badge
  [& args]
  (let [opts (opts-of args) body (body-of args)
        tone (get opts :tone :default)
        bg (case tone :success (t/color :success) :danger (t/color :danger)
                      :warning (t/color :warning) :accent (t/color :accent)
                      (t/color :surface-2))]
    (apply b/box
           (merge {:as :span :inline true :dir :row :align :center
                   :pad [:0 :2] :radius :full
                   :bg bg :fg :accent-fg
                   :style (merge {:height (t/space :5) :font-size (t/text :xs)
                                  :font-weight (t/weight :semibold)}
                                 (get opts :style {}))}
                  (dissoc opts :tone :style))
           body)))

;; ════════════════════════════════════════════════════════════════════
;; Alert — an announced message block
;; ════════════════════════════════════════════════════════════════════
;;
;; role=alert so assistive tech reads it when it appears. Tones tint the border
;; and text; the surface stays calm.

(defn alert
  [& args]
  (let [opts (opts-of args) body (body-of args)
        tone (get opts :tone :info)
        accent (case tone :success (t/color :success) :danger (t/color :danger)
                          :warning (t/color :warning) (t/color :accent))]
    (apply b/box
           (merge {:dir :row :gap :3 :align :start :pad :4 :radius :md
                   :bg :surface-2
                   :role "alert"
                   :style (merge {:border-left (str "3px solid " accent)
                                  :color (t/color :text)}
                                 (get opts :style {}))}
                  (dissoc opts :tone :style))
           body)))

;; ════════════════════════════════════════════════════════════════════
;; Divider — a hairline separator
;; ════════════════════════════════════════════════════════════════════

(defn divider
  ([] (divider {}))
  ([opts]
   [:hr (merge {:class (t/sx (merge {:border "none" :border-top (str "1px solid " (t/color :border))
                                     :margin (str (t/space :3) " 0") :width "100%"}
                                    (get opts :style {})))}
               (dissoc opts :style))]))

;; ════════════════════════════════════════════════════════════════════
;; Skeleton — a loading placeholder
;; ════════════════════════════════════════════════════════════════════

(defn skeleton
  ([] (skeleton {}))
  ([opts]
   (b/box (merge {:radius :sm
                  :style (merge {:background (t/color :surface-3)
                                 :height (t/len (get opts :h :5))
                                 :width (if (contains? opts :w) (t/len (get opts :w)) "100%")}
                                (get opts :style {}))
                  :aria-hidden "true"}
                 (dissoc opts :h :w :style)))))
