; loom/transform.bl — the view is data, so the path-algebra transforms it.
;
; ── The idea ──────────────────────────────────────────────────────────
;
; A hiccup tree is nested vectors and maps. So the SAME tools that navigate any
; beam-lisp value navigate a view — and a cross-cutting UI concern becomes a
; transform over the view VALUE, not a framework feature you wait for. This
; module is a thin, honest layer over the repo's existing path-algebra
; (rewrite, specter, optics) aimed at hiccup. It adds no new engine; it shows
; the engines already apply.
;
;   retheme          rewrite/postwalk — swap every token-valued style
;   retarget-events  rewrite/postwalk — redirect every :on-EVENT handler
;   expand-aliases   rewrite/postwalk — a custom tag → real hiccup (Replicant's
;                    "aliases", as reviewable DATA rules)
;   find-nodes       specter          — query the tree (e.g. an a11y audit)
;   audit-missing-labels  a real accessibility linter, as a select
;   map-text         optics/rewrite   — transform every text node (i18n)

(ns loom.transform
  (:require [rewrite]
            [specter.navs :as sp]))

;; ── element helpers ─────────────────────────────────────────────────

(defn element?
  "A hiccup element: a vector whose head is a keyword tag."
  [x]
  (and (vector? x) (> (count x) 0) (keyword? (first x))))

(defn tag-of [el] (first el))

(defn attrs-of
  "The attrs map of an element, or {} when it has none."
  [el]
  (if (and (> (count el) 1) (map? (nth el 1))) (nth el 1) {}))

;; ════════════════════════════════════════════════════════════════════
;; retheme — swap values throughout a subtree
;; ════════════════════════════════════════════════════════════════════
;;
;; `(retheme {old-value new-value …} tree)` replaces every occurrence of a
;; mapped value anywhere in the tree — a colour swap, a spacing bump, a brand
;; change — in one pass. Because a style is just a map value, this reaches into
;; :style maps, :class strings, and attributes alike.

(defn retheme
  [swaps tree]
  (rewrite/postwalk
    (fn [x] (if (contains? swaps x) (get swaps x) x))
    tree))

;; ════════════════════════════════════════════════════════════════════
;; retarget-events — redirect every handler in a subtree
;; ════════════════════════════════════════════════════════════════════
;;
;; `(retarget-events f tree)` calls `(f event-key event-term)` for every
;; :on-EVENT attribute and replaces the term with the result. A higher-order
;; component — as a VALUE, not a wrapper function: disable a whole panel, route
;; every click through an audit log, prefix every intent.

(defn- event-key? [k]
  (and (keyword? k) (String/starts_with? (name k) "on-")))

(defn retarget-events
  [f tree]
  (rewrite/postwalk
    (fn [x]
      (if (map? x)
        (reduce (fn [m kv]
                  (let [k (first kv) v (second kv)]
                    (assoc m k (if (event-key? k) (f k v) v))))
                {} (seq x))
        x))
    tree))

;; ════════════════════════════════════════════════════════════════════
;; expand-aliases — extend the hiccup vocabulary with your own tags
;; ════════════════════════════════════════════════════════════════════
;;
;; An alias is a tag that expands to more hiccup, defined as DATA: a map
;; {tag → (fn [attrs children] → hiccup)}. `expand-aliases` rewrites every
;; occurrence bottom-up, so aliases may nest. This is Replicant's killer
;; "aliases" feature — a terse dialect that stays inspectable data.
;;
;;   (expand-aliases {:ui/pill (fn [a cs] (into [:span (assoc a :class "pill")] cs))}
;;                   [:ui/pill {} "hi"])
;;   ;=> [:span {:class "pill"} "hi"]

(defn expand-aliases
  [aliases tree]
  (rewrite/postwalk
    (fn [x]
      (if (and (element? x) (contains? aliases (tag-of x)))
        (let [expand (get aliases (tag-of x))
              a (attrs-of x)
              cs (if (and (> (count x) 1) (map? (nth x 1))) (drop 2 x) (rest x))]
          (expand a cs))
        x))
    tree))

;; ════════════════════════════════════════════════════════════════════
;; find-nodes / audit — QUERY the tree
;; ════════════════════════════════════════════════════════════════════
;;
;; Because the tree is data, an audit is a select. `find-nodes` returns every
;; node (at any depth) satisfying a predicate.

(defn find-nodes
  "Every subnode of `tree` (any depth) for which `pred` holds."
  [pred tree]
  (let [acc (atom [])]
    (rewrite/postwalk
      (fn [x] (when (pred x) (swap! acc conj x)) x)
      tree)
    (into [] @acc)))

(defn- input-element? [x]
  (and (element? x) (contains? #{:input :textarea :select} (tag-of x))))

(defn- has-label-link? [x]
  ;; an input is labelled if it carries an id (a <label for=id> can target it)
  ;; or an explicit aria-label / aria-labelledby.
  (let [a (attrs-of x)]
    (or (contains? a :id) (contains? a :aria-label) (contains? a :aria-labelledby))))

(defn audit-missing-labels
  "Every input/textarea/select in `tree` with no way for a label to reach it —
   a real accessibility linter, expressed as a query over the view value."
  [tree]
  (find-nodes (fn [x] (and (input-element? x) (not (has-label-link? x)))) tree))

;; ════════════════════════════════════════════════════════════════════
;; map-text — transform every text node (e.g. i18n)
;; ════════════════════════════════════════════════════════════════════

(defn map-text
  "Apply `f` to every string leaf in `tree` (translation, casing, redaction)."
  [f tree]
  (rewrite/postwalk
    (fn [x] (if (string? x) (f x) x))
    tree))
