; loom/parts.bl — the second tier of the component vocabulary.
;
; loom.ui carries the atoms (button, field, card, badge, alert…). This file
; carries the compound, interaction-heavy parts that every real app screen
; needs and that were, until now, re-improvised per app: overlays (dialog,
; drawer), navigation (tabs), data display (table, identity chip, relative
; time, kbd, progress, a stage timeline), and feedback (toast, empty/error
; states). Same contract as loom.ui: a pure function of inputs → hiccup, painted
; from tokens, arranged by the box, accessible by construction, events as the
; closed [:intent …]/[:assign …]/[:navigate …] term vocabulary.
;
; Interactivity that needs no server round-trip (a dialog's open/close, a tab
; switch) is driven by tiny, dependency-free inline scripts keyed off data-*
; attributes — the same shape the live client already reads. Everything renders
; identically in a static page and over a live socket.

(ns loom.parts
  (:require [loom.token :as t]
            [loom.box :as b]
            [loom.ui :as ui]))

(defn- opts-of [args] (if (and (seq args) (map? (first args))) (first args) {}))
(defn- body-of [args] (if (and (seq args) (map? (first args))) (rest args) args))
(defn- name-str [x] (if (keyword? x) (name x) (str x)))

;; a colour token at partial opacity, as an rgba() string. loom.token has no
;; alpha helper, so a scrim / soft ring computes it here from the hex token.
(defn- hex->rgb [hex]
  (let [h (if (String/starts_with? hex "#") (subs hex 1 (count hex)) hex)]
    (if (>= (count h) 6)
      [(erlang/binary_to_integer (subs h 0 2) 16)
       (erlang/binary_to_integer (subs h 2 4) 16)
       (erlang/binary_to_integer (subs h 4 6) 16)]
      [0 0 0])))

(defn- alpha [color-key a]
  (let [[r g bl] (hex->rgb (t/color color-key))]
    (str "rgba(" r "," g "," bl "," a ")")))

;; ════════════════════════════════════════════════════════════════════
;; Identity — an avatar + name + role, for people and agents
;; ════════════════════════════════════════════════════════════════════
;;
;; (identity {:name "Amina" :role "Partner" :kind :person})
;; kind :agent draws a square (a machine); :person draws a circle.

(defn- initials [nm]
  (let [parts (filter (fn [w] (not (= "" w))) (split (or nm "") " "))]
    (cond
      (empty? parts) "?"
      (= 1 (count parts)) (String/upcase (subs (first parts) 0 1))
      :else (String/upcase (str (subs (first parts) 0 1)
                                (subs (first (rest parts)) 0 1))))))

(defn identity
  [& args]
  (let [opts (opts-of args)
        nm (get opts :name "Unknown")
        role (get opts :role)
        kind (get opts :kind :person)
        av-cls (t/sx {:width (t/space :7) :height (t/space :7)
                      :border-radius (if (= kind :agent) (t/radius :md) (t/radius :full))
                      :background (t/color :accent) :color (t/color :accent-fg)
                      :display "flex" :align-items "center" :justify-content "center"
                      :font-size (t/text :xs) :font-weight (t/weight :bold) :flex-shrink "0"})]
    (b/box {:dir :row :gap :2 :align :center}
      [:span {:class av-cls :aria-hidden "true"} (initials nm)]
      (b/box {:dir :col}
        [:span {:class (t/sx {:font-weight (t/weight :semibold) :font-size (t/text :sm)
                              :color (t/color :text)})} nm]
        (when role
          [:span {:class (t/sx {:font-size (t/text :xs) :color (t/color :muted)})} role])))))

;; ════════════════════════════════════════════════════════════════════
;; when — a relative time with the absolute in a tooltip
;; ════════════════════════════════════════════════════════════════════
;;
;; Dates in this product are YYYYMMDD longs. `when` renders a human string
;; ("28 Aug 2026") in a <time> with the ISO value in `datetime` + `title`, so a
;; date is never a bare integer on screen again.

(def ^:private months
  ["Jan" "Feb" "Mar" "Apr" "May" "Jun" "Jul" "Aug" "Sep" "Oct" "Nov" "Dec"])

(defn- ymd-parts [d]
  (if (and (number? d) (>= d 10000000) (< d 100000000))
    (let [y (quot d 10000) m (rem (quot d 100) 100) day (rem d 100)] [y m day])
    nil))

(defn when-day
  [d]
  (let [p (ymd-parts d)]
    (if (nil? p)
      [:span (str d)]
      (let [[y m day] p
            iso (str y "-" (if (< m 10) "0" "") m "-" (if (< day 10) "0" "") day)
            human (str day " " (nth months (- m 1)) " " y)]
        [:time {:datetime iso :title iso
                :class (t/sx {:color (t/color :muted) :font-size (t/text :sm)})}
         human]))))

;; ════════════════════════════════════════════════════════════════════
;; kbd — a keyboard hint
;; ════════════════════════════════════════════════════════════════════

(defn kbd
  [& body]
  (into [:kbd {:class (t/sx {:font-family (t/tok :font :mono)
                             :font-size (t/text :xs)
                             :background (t/color :surface-2)
                             :border (str "1px solid " (t/color :border))
                             :border-radius (t/radius :sm)
                             :padding "1px 5px" :color (t/color :muted)})}]
        body))

;; ════════════════════════════════════════════════════════════════════
;; progress — a determinate bar
;; ════════════════════════════════════════════════════════════════════
;;
;; (progress {:value 62 :max 100})                      the bar alone
;; (progress {:value 6200 :max 10000 :tone :danger      tinted, and captioned:
;;            :label "6 200 / 10 000 feuilles" :caption "62%" :h "14px"})
;; A caption row (label left, caption right) sits above the bar when given.

(defn progress
  [& args]
  (let [opts (opts-of args)
        value (get opts :value 0) mx (get opts :max 100)
        pct (if (> mx 0) (Integer/to_string (erlang/round (* 100 (/ value mx)))) "0")
        tone (get opts :tone :accent)
        h (get opts :h (t/space :2))
        label (get opts :label) caption (get opts :caption)
        bar [:div {:role "progressbar" :aria-valuenow (str value) :aria-valuemin "0"
                   :aria-valuemax (str mx) :aria-label (or label caption "progress")
                   :class (t/sx {:width "100%" :height h
                                 :background (t/color :surface-2) :border-radius (t/radius :full)
                                 :overflow "hidden"})}
             [:div {:class (t/sx {:height "100%" :background (t/color tone)
                                  :transition "width 200ms ease"})
                    :style (str "width:" pct "%")}]]]
    (if (or label caption)
      (b/box {:dir :col :gap :1}
        (b/box {:dir :row :justify :between :align :baseline}
          [:span {:class (t/sx {:font-family (t/tok :font :mono) :font-size (t/text :xs) :color (t/color :muted)})} (or label "")]
          [:span {:class (t/sx {:font-family (t/tok :font :mono) :font-size (t/text :xs) :color (t/color tone)})} (or caption "")])
        bar)
      bar)))

;; ════════════════════════════════════════════════════════════════════
;; timeline — ordered stages, each with a state
;; ════════════════════════════════════════════════════════════════════
;;
;; (timeline {:stages [{:name "read" :status :done} {:name "embed" :status :running}
;;                     {:name "graph" :status :pending}]})
;; status ∈ :done :running :pending :failed :planned — each its own visual, so
;; "grey means nothing" is impossible.

(defn- stage-tone [status]
  (case status
    :done   (t/color :success)
    :running (t/color :accent)
    :failed (t/color :danger)
    :planned (t/color :border)
    (t/color :border)))

(defn timeline
  [& args]
  (let [opts (opts-of args)
        stages (get opts :stages [])]
    (b/box {:dir :col :gap :3 :role "list"}
      (map (fn [s]
             (let [status (get s :status :pending)
                   tone (stage-tone status)
                   dot (t/sx {:width (t/space :3) :height (t/space :3)
                              :border-radius (t/radius :full) :flex-shrink "0"
                              :background tone
                              :box-shadow (if (= status :running)
                                            (str "0 0 0 3px " (alpha :accent 0.2)) "none")})]
               (b/box {:dir :row :gap :3 :align :center :role "listitem"}
                 [:span {:class dot :aria-hidden "true"}]
                 [:span {:class (t/sx {:font-size (t/text :sm)
                                       :color (if (= status :pending) (t/color :muted) (t/color :text))
                                       :font-weight (if (= status :running) (t/weight :semibold) (t/weight :normal))})}
                  (name-str (get s :name))]
                 (when (= status :running)
                   [:span {:class (t/sx {:font-size (t/text :xs) :color (t/color :accent)})} "running…"])
                 (when (get s :note)
                   [:span {:class (t/sx {:font-size (t/text :xs) :color (t/color :muted)})} (get s :note)]))))
           stages))))

;; ════════════════════════════════════════════════════════════════════
;; events — a timeline of things that HAPPENED: who · when · what
;; ════════════════════════════════════════════════════════════════════
;;
;; (events {:items [{:key "t-12" :who "Rachid M." :role "conducteur"
;;                   :when "J1 · 9h15" :what "a démarré Impression 4 coul."
;;                   :tone :success :meta "kiosk:sm74"} …]})
;; Newest first is the caller's choice (items render in order). Each item is
;; keyed so a live append patches one row. `:tone` tints the rule; `:meta`
;; is the small print (a device, a transaction id). Empty → :empty note.

(defn events
  [& args]
  (let [opts (opts-of args)
        items (get opts :items [])
        empty-note (get opts :empty "Nothing has happened yet.")]
    (if (empty? items)
      (b/box {:pad :5 :align :center}
        [:span {:class (t/sx {:color (t/color :muted) :font-size (t/text :sm)})} empty-note])
      (b/box {:dir :col :gap :0 :role "list"}
        (map (fn [it]
               (let [tone (get it :tone :info)
                     rule (case tone :success (t/color :success) :danger (t/color :danger)
                                     :warning (t/color :warning) :muted (t/color :border) (t/color :accent))]
                 (b/box (merge {:dir :row :gap :3 :align :start :role "listitem" :pad [:3 :2]
                                :style {:border-left (str "3px solid " rule)
                                        :border-bottom (str "1px solid " (alpha :border 0.5))}}
                               (if (get it :key) {:key (str (get it :key))} {}))
                   [:span {:class (t/sx {:font-family (t/tok :font :mono) :font-size (t/text :xs)
                                         :color (t/color :muted) :flex-shrink "0" :min-width "6.5rem"})}
                    (get it :when "")]
                   (b/box {:dir :col :gap :1 :grow 1}
                     (b/box {:dir :row :gap :2 :align :baseline :wrap true}
                       [:span {:class (t/sx {:font-weight (t/weight :semibold) :font-size (t/text :sm) :color (t/color :text)})}
                        (get it :who "")]
                       (when (get it :role)
                         [:span {:class (t/sx {:font-size (t/text :xs) :color (t/color :muted)})} (get it :role)])
                       [:span {:class (t/sx {:font-size (t/text :sm) :color (t/color :text)})} (get it :what "")])
                     (when (get it :meta)
                       [:span {:class (t/sx {:font-family (t/tok :font :mono) :font-size (t/text :xs) :color (t/color :muted)})}
                        (get it :meta)])))))
             items)))))

;; ════════════════════════════════════════════════════════════════════
;; tabs — roving, URL-driven
;; ════════════════════════════════════════════════════════════════════
;;
;; (tabs {:active :documents
;;        :tabs [{:id :documents :label "Documents" :on-select [:navigate "…"]}
;;               {:id :entities  :label "Entities"  :on-select [:navigate "…"]}]})
;; Rendered as role=tablist; the active tab carries aria-selected. Selection is
;; an event term (navigate/assign), so the app decides what a tab switch does.

(defn tabs
  [& args]
  (let [opts (opts-of args)
        active (get opts :active)
        items (get opts :tabs [])]
    [:div {:role "tablist"
           :class (t/sx {:display "flex" :gap (t/len :4)
                         :border-bottom (str "1px solid " (t/color :border))})}
     (map (fn [it]
            (let [id (get it :id)
                  sel (= id active)
                  cls (t/sx* {:base {:padding (str (t/len :3) " " (t/len :1))
                                     :background "transparent" :border "none"
                                     :border-bottom (str "2px solid "
                                                         (if sel (t/color :accent) "transparent"))
                                     :color (if sel (t/color :text) (t/color :muted))
                                     :font-size (t/text :sm)
                                     :font-weight (if sel (t/weight :semibold) (t/weight :normal))
                                     :cursor "pointer" :margin-bottom "-1px"}
                              :on {:hover {:color (t/color :text)}
                                   :focus-visible {:outline (str "2px solid " (t/color :accent))
                                                   :outline-offset "2px"}}})]
              (into [:button (merge {:role "tab" :aria-selected (if sel "true" "false")
                                     :class cls}
                                    (let [ev (get it :on-select)] (if ev {:on-click ev} {})))]
                    [(get it :label)])))
          items)]))

;; ════════════════════════════════════════════════════════════════════
;; table — a data table
;; ════════════════════════════════════════════════════════════════════
;;
;; Two shapes, one part:
;;
;;   (table {:columns ["Title" "Added"] :rows [["Art 1240" "28 Aug"] …]})
;;     rows are vectors of cells (strings or hiccup).
;;
;;   (table {:columns [{:key :name :label "Nom" :align "right" :render (fn [row] …)}]
;;           :rows [{:name "…"} …] :row-key (fn [row] key) :on-row (fn [row] event|nil)
;;           :sort {:col :name :dir :asc :on-sort (fn [key dir] event)}})
;;     rows are MAPS; a column reads (get row key) or its :render; rows are
;;     keyed so a live change patches one row, not the whole table; :on-row
;;     makes a row a gesture; :sort marks the sorted column and makes each
;;     header a button that fires (on-sort key next-dir).
;;
;; A view sorts/filters its rows itself (they are values) — the part only
;; RENDERS the state and names the gesture, so it stays pure.

(defn- col-map [c] (if (map? c) c {:label c}))
(defn- cell-of [row c i]
  (cond (some? (:render c)) ((:render c) row)
        (map? row) (let [v (get row (:key c))] (if (nil? v) "" (if (string? v) v (str v))))
        :else (nth row i "")))
(defn- th-of [c sort]
  (let [k (:key c)
        sorted? (and sort k (= k (:col sort)))
        dir (if sorted? (:dir sort) nil)
        next-dir (if (= dir :asc) :desc :asc)
        on-sort (:on-sort sort)
        base {:text-align (or (:align c) "left") :padding (t/len :2)
              :border-bottom (str "1px solid " (t/color :border))
              :color (if sorted? (t/color :text) (t/color :muted))
              :font-weight (t/weight :semibold) :font-size (t/text :xs)
              :text-transform "uppercase" :letter-spacing "0.06em"}
        label (str (:label c) (if sorted? (if (= dir :asc) " ▲" " ▼") ""))]
    (if (and on-sort k)
      [:th {:class (t/sx base) :aria-sort (if sorted? (if (= dir :asc) "ascending" "descending") "none")}
       [:button {:type "button"
                 :class (t/sx {:background "transparent" :border "none" :padding "0"
                               :font "inherit" :color "inherit" :cursor "pointer"
                               :text-transform "inherit" :letter-spacing "inherit"})
                 :on-click (on-sort k next-dir)}
        label]]
      [:th {:class (t/sx base)} label])))

(defn table
  [& args]
  (let [opts (opts-of args)
        cols (map col-map (get opts :columns []))
        rows (get opts :rows [])
        row-key (get opts :row-key)
        on-row (get opts :on-row)
        sort (get opts :sort)
        empty-note (get opts :empty "Nothing here yet.")]
    (if (empty? rows)
      (b/box {:pad :5 :align :center}
        [:span {:class (t/sx {:color (t/color :muted) :font-size (t/text :sm)})} empty-note])
      [:table {:class (t/sx {:width "100%" :border-collapse "collapse" :font-size (t/text :sm)})}
       [:thead (into [:tr] (map (fn [c] (th-of c sort)) cols))]
       (into [:tbody]
             (map (fn [row]
                    (let [ev (if on-row (on-row row) nil)
                          k (if row-key (row-key row) nil)]
                      (into [:tr (merge (if k {:key (str k)} {})
                                        {:class (t/sx* {:base {:transition "background 120ms ease"}
                                                        :on {:hover {:background (t/color :surface-2)}}})}
                                        (if ev {:on-click ev :style "cursor:pointer"} {}))]
                            (map-indexed
                              (fn [i c]
                                [:td {:class (t/sx {:padding (t/len :2)
                                                    :text-align (or (:align c) "left")
                                                    :border-bottom (str "1px solid " (alpha :border 0.5))
                                                    :color (t/color :text)})}
                                 (cell-of row c i)])
                              cols))))
                  rows))])))

;; ════════════════════════════════════════════════════════════════════
;; dialog — a modal, Esc-dismissable, focus-scrimmed
;; ════════════════════════════════════════════════════════════════════
;;
;; (dialog {:id "confirm-revoke" :title "Revoke access?" :open false}
;;   body… )
;; Open/close is data-*-driven so it needs no server round-trip: any element
;; with data-open="ID" opens it, the scrim + Esc close it. Buttons inside carry
;; real event terms for the actual action.

(defn dialog
  [& args]
  (let [opts (opts-of args) body (body-of args)
        id (get opts :id "dialog")
        title (get opts :title)
        open (get opts :open false)]
    [:div {:class (t/sx {:position "fixed" :inset "0" :z-index "50"
                         :align-items "center" :justify-content "center"
                         :background (alpha :text 0.4)})
           ;; display is inline so open/close is a cheap data-driven toggle the
           ;; client flips without a re-render (and is trivially testable).
           :style (str "display:" (if open "flex" "none"))
           :data-dialog id :role "dialog" :aria-modal "true"
           :aria-label (or title "dialog")}
     (apply b/box {:dir :col :gap :4 :bg :surface :radius :lg :pad :6
                   :shadow :lg
                   :style {:max-width "28rem" :width "90%"
                           :max-height "85vh" :overflow "auto"}}
       (concat
         (if title [(ui/heading 3 title)] [])
         body))]))

;; ════════════════════════════════════════════════════════════════════
;; drawer — a side/bottom panel (mobile nav lives here)
;; ════════════════════════════════════════════════════════════════════

(defn drawer
  [& args]
  (let [opts (opts-of args) body (body-of args)
        id (get opts :id "drawer")
        open (get opts :open false)
        side (get opts :side :right)]
    [:div {:class (t/sx {:position "fixed" :inset "0" :z-index "40"
                         :background (alpha :text 0.35)})
           :style (str "display:" (if open "block" "none"))
           :data-drawer id}
     (apply b/box {:dir :col :gap :3 :bg :surface :pad :5
                   :style (merge {:position "absolute" :top "0" :height "100%"
                                  :width "80%" :max-width "20rem" :overflow "auto"}
                                 (case side
                                   :left {:left "0"}
                                   :bottom {:bottom "0" :left "0" :width "100%" :height "auto" :max-height "80%"}
                                   {:right "0"}))}
       body)]))

;; ════════════════════════════════════════════════════════════════════
;; toast — a transient message, optional Undo
;; ════════════════════════════════════════════════════════════════════
;;
;; (toast {:tone :success :message "Saved." :action {:label "Undo" :on-click […]}})
;; aria-live=polite so it is announced; tone tints the left rule.

(defn toast
  [& args]
  (let [opts (opts-of args)
        tone (get opts :tone :info)
        rule (case tone :success (t/color :success) :danger (t/color :danger)
                        :warning (t/color :warning) (t/color :accent))
        action (get opts :action)]
    (b/box {:dir :row :gap :3 :align :center :bg :surface :pad [:3 :4]
            :radius :md :shadow :md
            :style {:border-left (str "3px solid " rule) :min-width "16rem"}
            :role "status" :aria-live "polite"}
      [:span {:class (t/sx {:font-size (t/text :sm) :color (t/color :text) :flex-grow "1"})}
       (get opts :message "")]
      (when action
        (into [:button (merge {:class (t/sx {:background "transparent" :border "none"
                                             :color (t/color :accent) :cursor "pointer"
                                             :font-size (t/text :sm) :font-weight (t/weight :semibold)})}
                              (let [ev (get action :on-click)] (if ev {:on-click ev} {})))]
              [(get action :label "Undo")])))))

;; ════════════════════════════════════════════════════════════════════
;; empty / error — the reachable non-happy states
;; ════════════════════════════════════════════════════════════════════

(defn empty-state
  [& args]
  (let [opts (opts-of args)]
    (b/box {:dir :col :gap :3 :align :center :pad :7}
      (when (get opts :icon) [:div {:aria-hidden "true"} (get opts :icon)])
      [:span {:class (t/sx {:font-weight (t/weight :semibold) :color (t/color :text)})}
       (get opts :title "Nothing here yet")]
      (when (get opts :body)
        [:span {:class (t/sx {:font-size (t/text :sm) :color (t/color :muted)
                              :text-align "center"})}
         (get opts :body)])
      (when (get opts :action) (get opts :action)))))

(defn error-state
  [& args]
  (let [opts (opts-of args)]
    (b/box {:dir :col :gap :3 :align :center :pad :7
            :style {:border-left (str "3px solid " (t/color :danger))}}
      [:span {:class (t/sx {:font-weight (t/weight :semibold) :color (t/color :danger)})}
       (get opts :title "Something went wrong")]
      (when (get opts :body)
        [:span {:class (t/sx {:font-size (t/text :sm) :color (t/color :muted)})}
         (get opts :body)])
      (when (get opts :action) (get opts :action)))))
