; auth/revocation.bl — the one thing an offline token cannot do alone.
;
; ── The honest tension ────────────────────────────────────────────────
;
; Biscuit's headline is OFFLINE verification: any holder of the root public
; key can verify a token with no callback to the issuer. But revocation IS
; a callback — to know a token was revoked, you must consult something that
; changed after the token was minted. These pull in opposite directions,
; and `auth` refuses to pretend otherwise. It makes the tradeoff a per-call
; CHOICE rather than a baked-in policy:
;
;   - pure offline: pass NO oracle. The token's own TTL check (a
;     `check if time($t), $t < <expiry>` inside the token) is the whole
;     revocation story. Correct for short-lived, low-blast-radius
;     capabilities.
;   - online: pass an oracle. The authorizer consults a revocation set
;     before allowing. Correct when instant revocation matters more than
;     zero-dependency verification.
;
; Same token, same authorizer; the deployment picks the stance by whether
; it provides an oracle. Revocation is thus addable per call, never a
; property of the token format.
;
; ── Revocation as a fact ──────────────────────────────────────────────
;
; A revocation is just data: "this block id is revoked". Storing
; revocations in datom makes 'is this token revoked as-of T?' a TEMPORAL
; query — you can ask whether a token was revoked at the time a historical
; action was taken, not just now. That falls out of datom being temporal,
; and it is why revocation lives here as a thin layer over a fact store
; rather than as bespoke machinery.
;
; ── Compare bytes, never text ────────────────────────────────────────
;
; A block's revocation id is its signature BYTES (see codec/revocation-ids).
; The spec is explicit: compare the raw bytes, never a base64 rendering,
; because base64 is non-canonical — two encodings of the same id would
; compare unequal and a revoked token would slip through. Every comparison
; here is on the byte binaries.

(ns auth.revocation
  (:require [auth.biscuit.codec :as codec]))

;; ── an in-memory oracle ─────────────────────────────────────────────
;;
;; The simplest oracle: a set of revoked ids held in memory. An oracle is
;; anything with `(revoked? oracle id) → bool`; this is the reference
;; implementation and the shape a datom-backed oracle also satisfies.

(defn set-oracle
  "An oracle over an in-memory collection of revoked id byte-binaries.

   `revoked-ids` is a vector of raw signature bytes. Membership is a byte
   comparison, so an id presented in any form other than its exact bytes
   correctly does NOT match — there is no textual normalisation to get
   wrong."
  [revoked-ids]
  {:revoked (into [] revoked-ids)})

(defn revoked-id?
  "Whether `id` (raw bytes) is in `oracle`'s revoked set."
  [oracle id]
  (some? (some (fn [r] (= r id)) (:revoked oracle))))

;; ── checking a token ────────────────────────────────────────────────

(defn any-revoked?
  "Whether ANY block of `token` is revoked according to `oracle`.

   A token is revoked if any block in its chain is — revoking a block
   revokes every token that contains it, including every attenuation
   derived from it, because they all share that block's signature. nil
   oracle means 'no revocation checking' and returns false (pure-offline
   stance).

   This is the hook the authorizer calls when an oracle is supplied: a
   true here turns an otherwise-valid token into a denial."
  [oracle token]
  (if (nil? oracle)
    false
    (let [ids (codec/revocation-ids token)]
      (some? (some (fn [id] (revoked-id? oracle id)) ids)))))

;; ── datom-backed oracle (composition point) ─────────────────────────
;;
;; A production oracle stores revocations in datom, so "revoked as-of T"
;; is a query. We do not hard-wire datom here — instead an app supplies a
;; `lookup` fn `(id) → bool` closing over its own db value and basis, and
;; `fn-oracle` adapts it. This keeps `revocation` independent of any
;; particular store while making the datom case a one-liner at the call
;; site.

(defn fn-oracle
  "An oracle backed by a lookup function `(id) → bool`.

   The function closes over whatever the app uses to answer 'is this id
   revoked' — typically a datom query against a revocations relation at a
   chosen basis. Adapting a function rather than a store keeps this file
   store-agnostic while supporting the temporal-query use case the design
   calls for."
  [lookup]
  {:fn lookup})

(defn revoked-id-via?
  "Membership check that understands both oracle shapes: the in-memory set
   and the function-backed oracle."
  [oracle id]
  (cond
    (contains? oracle :fn) ((:fn oracle) id)
    (contains? oracle :revoked) (revoked-id? oracle id)
    :else false))

(defn revoked?
  "Whether any block of `token` is revoked, for EITHER oracle shape.

   The authorizer-facing entry point: nil oracle → false (offline);
   otherwise every block's revocation id is checked through whichever
   oracle shape was supplied. Prefer this over `any-revoked?` when the
   oracle may be function-backed."
  [oracle token]
  (if (nil? oracle)
    false
    (let [ids (codec/revocation-ids token)]
      (some? (some (fn [id] (revoked-id-via? oracle id)) ids)))))
