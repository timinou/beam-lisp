; auth/register.bl — creating a credential, as a value: the mirror of login.
;
; ── The one idea ────────────────────────────────────────────────────
;
; auth.login names how a credential is CHECKED. This file names how one is
; CREATED — the other half of an account, and the half where a small omission
; becomes a durable security bug:
;
;   • a POLICY decides what is acceptable, once      (length, emptiness)
;   • the PASSWORD is hashed, never stored           (auth.password)
;   • the FACTS the new identity will carry are emitted
;
; Registration is a VALUE, not a framework:
;
;     (auth/register {:identity "ada@x.com" :password "…"})
;     → {:ok {:identity "ada@x.com" :verifier "pbkdf2$…" :facts [["user" "ada@x.com"]]}}
;     | {:error :password-too-short}
;
; The returned `:verifier` is what the app STORES (in its own datom); the
; `:facts` are exactly what `auth/issue` mints a token from — so registration
; and login meet at one seam, and a freshly registered identity carries the
; same authority shape as a logged-in one (`auth.strategy/password-strategy`
; emits `[["user" identity]]`, and so does this).
;
; ── Why this lives in `auth` ────────────────────────────────────────
;
; The same reason password.bl and login.bl do. Every app with passwords must
; (a) refuse an empty or one-character password, (b) salt and stretch what it
; stores, and (c) never keep the plaintext. Each is one line, and each is the
; line an app forgets — so it is written once here, with the policy as DATA an
; app can inspect, tighten, or replace. A product re-deriving this is how
; unhashed secrets and unenforceable minimums happen.
;
; Storage stays the app's: nothing here writes a datom, opens a connection, or
; looks an identity up. `register` takes credentials and answers with the two
; values an app persists (:identity, :verifier) plus the facts to mint from.

(ns auth.register
  (:require [auth.password :as password]))

;; ── the policy ──────────────────────────────────────────────────────
;;
;; A map, so it prints, diffs, and travels: an app that wants a 12-character
;; floor passes its own policy and the default below is never consulted. The
;; defaults are deliberately ordinary — long enough to matter, short enough
;; that a passphrase is never rejected for length.

(def default-policy
  "The default password policy, as data. `check` reads `:min-length` and
   `:max-length` from whatever policy it is given, falling back to these."
  {:min-length 8
   :max-length 200})

(defn check
  "Why `password` is unacceptable for `identity`, or nil when it is fine.

   Returns a value — `{:error reason}` with a reason an app can render
   (`:identity-empty`, `:password-empty`, `:password-too-short`,
   `:password-too-long`, `:password-equals-identity`) — never throws, so a
   signup form can show the caller what to fix. `policy` may be nil (the
   default) or a map overriding `:min-length` / `:max-length`."
  ([identity password] (check default-policy identity password))
  ([policy identity password]
   (let [p (or policy default-policy)
         min-len (:min-length p 8)
         max-len (:max-length p 200)]
     (cond
       (= "" (String/trim (str identity)))  {:error :identity-empty}
       (or (nil? password) (= "" password)) {:error :password-empty}
       (< (String/length password) min-len) {:error :password-too-short}
       (> (String/length password) max-len) {:error :password-too-long}
       (= password identity)                {:error :password-equals-identity}
       :else nil))))

;; ── the credential ──────────────────────────────────────────────────

(defn credential
  "The record to STORE for `identity`/`password`: `{:identity :verifier}`.

   The verifier is the self-describing PBKDF2 string from auth.password (it
   carries its own salt and iteration count); the plaintext is retained
   nowhere. `identity` is carried alongside only so the pair is one value —
   an app persists it as the key it already has (`:principal/email`)."
  [identity password]
  {:identity identity
   :verifier (password/hash-password password)})

(defn verify-credential
  "Whether `password` matches a stored `credential`, in constant time. A
   malformed or missing verifier authenticates no one — false, not a throw."
  [credential password]
  (password/verify-password password (:verifier credential)))

;; ── the one entry point ─────────────────────────────────────────────

(defn register
  "Create a credential from `opts`, or explain why not.

   `opts` is `{:identity <string> :password <string>}`. Returns

     {:ok  {:identity … :verifier … :facts [(\"user\" identity)]}}
     | {:error reason}

   where `reason` is `check`'s. On :ok the app stores `:verifier` against
   `:identity` and mints from `:facts` — no further assembly.

   The mirror of `auth.login/session-of`: that turns a stored secret + a
   presented one into a verified principal; this turns a chosen one into the
   stored secret and the facts to mint. `policy` may be nil (the default) or a
   map overriding it."
  ([opts] (register opts default-policy))
  ([{:keys [identity password]} policy]
   (let [problem (check policy identity password)]
     (if (some? problem)
       problem
       {:ok {:identity identity
             :verifier (password/hash-password password)
             :facts [["user" identity]]}}))))
