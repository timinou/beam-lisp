; auth/biscuit/datalog.bl — Biscuit datalog ⇄ datom-shaped clauses.
;
; ── What this is ──────────────────────────────────────────────────────
;
; A Biscuit block carries its authorization logic as protobuf: facts,
; rules, and checks whose predicate names and string values are INDICES
; into a symbol table. This file turns those wire structures into plain
; beam-lisp data the authorizer can evaluate — predicates as vectors,
; terms as strings/ints/variables — reusing the exact fact SHAPE datom's
; own datalog uses so one engine can serve both.
;
; It is the bridge in the "one datalog" thesis: the token's `check if …`
; and a datom RLS `:where` clause must be the SAME kind of value, and this
; is where a token's wire form is lowered to that value.
;
; ── The atom discipline is the whole point here ──────────────────────
;
; Symbol indices in a HOSTILE token are attacker-controlled. A predicate
; name or string value is resolved to a beam-lisp STRING, never an atom —
; so a token full of junk symbols costs GC-able strings, never permanent
; atoms (trust-boundary.md). Interning to a keyword happens later and
; only at bounded sites, when a name is matched against a KNOWN predicate.
;
; ── Representation ────────────────────────────────────────────────────
;
; A decoded predicate is `{:name "right" :terms [<term> …]}`.
; A term is one of:
;   {:var N}            a variable (symbol index; stays numeric — a
;                       variable's identity is its slot, not a name)
;   "a string"          a string value (resolved through the symbol table)
;   42                  an integer
;   {:bytes <bin>}      a byte array
;   {:date N}           a date (unix seconds)
;   true / false        a boolean
;   {:set [<term> …]}   a set
;   :null               the null value
; This mirrors datom term values closely enough that the authorizer's
; unification (which reuses datom.query.engine/unify-term) treats a
; resolved string or int exactly as datom does.

(ns auth.biscuit.datalog
  (:require [auth.biscuit.codec :as codec]
            [auth.engine.expr :as expr]))

;; ── the default symbol table ────────────────────────────────────────
;;
;; Indices 0–1023 are RESERVED for these fixed default symbols (only the
;; first 28 are defined); a token's own symbols begin at index 1024. This
;; table is part of the wire contract — a fact `right(0,"read")` means
;; `right` because index 4 is "right" here, so the table must match the
;; spec exactly or every fact decodes to the wrong predicate.

(def default-symbols
  ["read" "write" "resource" "operation" "right" "time" "role" "owner"
   "tenant" "namespace" "user" "team" "service" "admin" "email" "group"
   "member" "ip_address" "client" "client_ip" "domain" "path" "version"
   "cluster" "node" "hostname" "nonce" "query"])

(def CUSTOM-BASE 1024)

(defn symbol-lookup
  "Resolve a symbol INDEX to its string, given a block's own `symbols`.

   Indices below 1024 hit the default table; from 1024 up they index the
   block's symbol list (offset by 1024). An out-of-range index is a
   malformed token and fails loudly rather than silently resolving to nil
   — a wrong predicate name is a security-relevant misparse, not a
   cosmetic one."
  [symbols idx]
  (if (< idx CUSTOM-BASE)
    (if (< idx (count default-symbols))
      (nth default-symbols idx)
      (throw (ex-info "reserved symbol index out of range"
                      {:index idx :max (count default-symbols)})))
    (let [local (- idx CUSTOM-BASE)]
      (if (< local (count symbols))
        (nth symbols local)
        (throw (ex-info "custom symbol index out of range"
                        {:index idx :local local :count (count symbols)}))))))

;; ── term decoding ───────────────────────────────────────────────────
;;
;; A Term is a protobuf `oneof` — exactly one field set, identifying the
;; type. We decode by which field is present.

(defn decode-term
  "Decode a Term message (already parsed to `{field [val]}`) using
   `symbols` to resolve string indices.

   Public because the expression VM (auth.engine.expr) resolves value
   opcodes through the SAME term decoder — one implementation of 'what a
   wire term means', shared, so a fact term and an expression term can
   never disagree.

   Variables stay NUMERIC (their identity is the slot); strings resolve
   through the table; everything else is its literal value. Sets recurse."
  [m symbols]
  (let [f (fn [n] (first (get m n)))]
    (cond
      (get m 1) {:var (f 1)}
      (get m 2) (f 2)                                  ; integer
      (get m 3) (symbol-lookup symbols (f 3))          ; string
      (get m 4) {:date (f 4)}
      (get m 5) {:bytes (f 5)}
      (contains? m 6) (not (= 0 (f 6)))                ; bool
      (get m 7) {:set (mapv (fn [t] (decode-term (codec/parse-message t) symbols))
                            (get (codec/parse-message (f 7)) 1))}
      (contains? m 8) :null
      :else (throw (ex-info "unknown or empty term" {:fields (keys m)})))))

(defn- decode-predicate
  "Decode a Predicate message bytes into `{:name <string> :terms […]}`.

   The name is a symbol index resolved to a string (never an atom); terms
   decode left to right. This is the shared shape a fact, a rule head, and
   a rule-body predicate all take."
  [bytes symbols]
  (let [m (codec/parse-message bytes)
        name-idx (first (get m 1))
        term-msgs (or (get m 2) [])]
    {:name (symbol-lookup symbols name-idx)
     :terms (mapv (fn [t] (decode-term (codec/parse-message t) symbols)) term-msgs)}))

;; ── fact / rule / check decoding ────────────────────────────────────

(defn- decode-fact
  "Decode a Fact message (just a wrapped predicate)."
  [bytes symbols]
  (decode-predicate (first (get (codec/parse-message bytes) 1)) symbols))

(defn- decode-rule
  "Decode a Rule into `{:head <pred> :body [<pred>…] :exprs [<raw>…]}`.

   Expressions are kept as RAW op bytes here; `auth.engine.expr` compiles
   them. Separating decode from expression evaluation keeps this file
   about STRUCTURE and lets the operator semantics live in one place."
  [bytes symbols]
  (let [m (codec/parse-message bytes)
        head (first (get m 1))
        body (or (get m 2) [])
        exprs (or (get m 3) [])]
    {:head (decode-predicate head symbols)
     :body (mapv (fn [p] (decode-predicate p symbols)) body)
     :exprs exprs
     :symbols symbols}))

(defn- decode-check
  "Decode a Check into `{:queries [<rule>…] :kind <int>}`.

   A check is a set of queries (rules) plus a Kind (0 One / 1 All /
   2 Reject). The kind changes how the queries' results are read — One
   means any query matching passes; Reject inverts — so it is surfaced,
   not dropped."
  [bytes symbols]
  (let [m (codec/parse-message bytes)
        queries (or (get m 1) [])
        kind (or (first (get m 2)) 0)]
    {:queries (mapv (fn [q] (decode-rule q symbols)) queries)
     :kind kind}))

;; ── the block ───────────────────────────────────────────────────────

(defn decode-block
  "Decode a block's raw Datalog bytes into `{:symbols :facts :rules
   :checks :version :context}`.

   `raw` is the `:data` field a decoded SignedBlock carries — the exact
   bytes the signature covers. The block's own `symbols` are read first
   because every predicate and string in the block resolves through them."
  [raw]
  (let [m (codec/parse-message raw)
        ;; repeated string symbols = field 1; each is raw UTF-8 bytes,
        ;; kept as a string (a binary IS a beam-lisp string), never atom'd.
        symbols (mapv (fn [b] b) (or (get m 1) []))
        facts (or (get m 4) [])
        rules (or (get m 5) [])
        checks (or (get m 6) [])]
    {:symbols symbols
     :context (first (get m 2))
     :version (first (get m 3))
     :facts (mapv (fn [f] (decode-fact f symbols)) facts)
     :rules (mapv (fn [r] (decode-rule r symbols)) rules)
     :checks (mapv (fn [c] (decode-check c symbols)) checks)}))

;; ── projection to datom-shaped tuples ───────────────────────────────

(defn predicate->tuple
  "A decoded predicate as a flat tuple `[name term…]`, the form the
   authorizer stores and matches as a FACT.

   `right(\"file1\",\"read\")` becomes `[\"right\" \"file1\" \"read\"]`. A
   fact tuple has no variables; a query predicate may, and those stay as
   `{:var N}` for unification to bind. Keeping facts as plain vectors lets
   the authorizer reuse datom's `unify-term` position by position."
  [pred]
  (into [(:name pred)] (:terms pred)))

;; ── encoding (for issuance) ──────────────────────────────────────────
;;
;; Minting a token is the reverse of decoding: fact tuples become a Block
;; message. We own the encoding for tokens WE mint, so we take the simple,
;; correct path — every string goes into the block's own symbol table
;; (indices from 1024) and is referenced by index. This is not the
;; smallest possible encoding (a producer could reuse default symbols) but
;; it is a VALID one that any conformant verifier accepts, and simplicity
;; here means fewer ways to mis-encode a security token.

(def default-symbol-index
  "The inverse of default-symbols: string → reserved index. Strings the
   spec already defines encode as their DEFAULT index — reusing them
   keeps the custom table minimal and matches what biscuit-rust writes
   (byte-compatible blocks, not merely equivalent ones)."
  (into {} (map-indexed (fn [i s] [s i]) default-symbols)))

(defn- intern-symbol
  "The symbol index for `s`, extending the custom table `state` only when
   `s` is not a default symbol and not already interned. Returns
   `[state index]`: default indices (< 1024) or 1024 + position."
  [state s]
  (let [default-idx (get default-symbol-index s)]
    (if (some? default-idx)
      [state default-idx]
      (let [syms (:symbols state)
            existing (loop [i 0]
                       (cond (>= i (count syms)) nil
                             (= (nth syms i) s) i
                             :else (recur (+ i 1))))]
        (if (some? existing)
          [state (+ CUSTOM-BASE existing)]
          [(assoc state :symbols (conj syms s))
           (+ CUSTOM-BASE (count syms))])))))

(defn- encode-string-term
  "Encode a string term: intern it, emit a Term with the string index
   (field 3). Returns `[state term-bytes]`."
  [state s]
  (let [pair (intern-symbol state s)
        st (first pair)
        idx (second pair)]
    [st (erlang/iolist_to_binary (codec/write-varint-field 3 idx))]))

(defn- encode-int-term
  "Encode an integer term (field 2)。 Returns `[state term-bytes]`."
  [state n]
  [state (erlang/iolist_to_binary (codec/write-varint-field 2 n))])

(defn- encode-term
  "Encode one fact term, threading the symbol-table `state`.

   Strings intern into the table; integers are inline; booleans use the
   bool field. Only the term kinds an issued token needs are handled —
   an unsupported term kind fails loud rather than minting a token that
   says something other than intended."
  [state term]
  (cond
    (string? term) (encode-string-term state term)
    (erlang/is_integer term) (encode-int-term state term)
    (= term true) [state (erlang/iolist_to_binary (codec/write-varint-field 6 1))]
    (= term false) [state (erlang/iolist_to_binary (codec/write-varint-field 6 0))]
    :else (throw (ex-info "cannot encode term kind for issuance" {:term term}))))

(defn- encode-predicate
  "Encode a fact tuple `[name arg…]` as a Predicate message, threading
   `state`. The name interns like any string; each arg is a Term."
  [state tuple]
  (let [name-pair (intern-symbol state (first tuple))
        st1 (first name-pair)
        name-idx (second name-pair)
        ;; encode each argument term, threading state
        result (reduce (fn [acc term]
                         (let [s (first acc)
                               terms (second acc)
                               tp (encode-term s term)]
                           [(first tp) (conj terms (second tp))]))
                       [st1 []]
                       (into [] (rest tuple)))
        st2 (first result)
        term-msgs (second result)
        ;; Predicate = { name:1 uint64, terms:2 repeated Term }
        name-field (codec/write-varint-field 1 name-idx)
        term-fields (mapv (fn [tb] (codec/write-len-field 2 tb)) term-msgs)]
    [st2 (erlang/iolist_to_binary
           (Enum/to_list (concat (list name-field) term-fields)))]))

(defn encode-block
  "Encode fact `tuples` into a Block message's bytes.

   Threads a symbol-table state across all facts so shared strings are
   interned once, then emits: the symbols (field 1), the version (field 3
   = 3, datalog v3.0), and each fact (field 4, a Fact wrapping a
   Predicate). Rules and checks are omitted — an issued authority block
   grants via facts; attenuation adds checks through a separate path.

   Returns the raw Block bytes, ready to be the `:data` of a signed block."
  [tuples]
  (let [result (reduce (fn [acc tuple]
                         (let [state (first acc)
                               facts (second acc)
                               pp (encode-predicate state tuple)]
                           [(first pp) (conj facts (second pp))]))
                       [{:symbols []} []]
                       tuples)
        state (first result)
        pred-msgs (second result)
        ;; symbols: repeated string, field 1
        symbol-fields (mapv (fn [s] (codec/write-len-field 1 s)) (:symbols state))
        ;; version: field 3 = 3
        version-field (codec/write-varint-field 3 3)
        ;; each Fact wraps a Predicate at field 1
        fact-fields (mapv (fn [pm]
                            (codec/write-len-field 4
                              (erlang/iolist_to_binary (codec/write-len-field 1 pm))))
                          pred-msgs)]
    (erlang/iolist_to_binary
      (Enum/to_list (concat symbol-fields (list version-field) fact-fields)))))

;; ── encoding rules, checks, expressions (for attenuation) ──────────
;;
;; Minting grants via facts; ATTENUATION narrows via checks, and checks
;; carry queries with EXPRESSIONS (`check if time($t), $t < T`). This
;; half of the wire encoder inverts decode-rule/decode-check/decode-op.
;; Variable slots follow the spec rule — every slot must exceed
;; 1023 + (count symbols) — with named vars ({"$t" as {:var "t"}})
;; allocated deterministically in first-appearance order.

(def unary-kind->idx
  "The inverse of expr/unary-kinds — one source of truth for the enum."
  (into {} (map (fn [p] [(second p) (first p)]) expr/unary-kinds)))

(def binary-kind->idx
  "The inverse of expr/binary-kinds."
  (into {} (map (fn [p] [(second p) (first p)]) expr/binary-kinds)))

(defn- walk-collect
  "Collect [strings var-names] from authoring data, in encounter order.
   Strings intern into the block's symbol table; named vars get slots."
  [x acc]
  (cond
    (string? x)
      [(conj (first acc) x) (second acc)]
    (and (map? x) (contains? x :var) (string? (:var x)))
      ;; the corpus interns a variable's NAME into the symbol table (for
      ;; printing); its SLOT is separate. Collect into both.
      [(conj (first acc) (:var x)) (conj (second acc) (:var x))]
    (map? x)
      (reduce (fn [a v] (walk-collect v a)) acc (vals x))
    (or (vector? x) (erlang/is_list x))
      (reduce (fn [a v] (walk-collect v a)) acc x)
    :else acc))

(defn- var-resolver
  "A fn mapping a var (name string or explicit slot int) to its slot.
   Slots start past 1023 + (count strings), per the spec; an unknown
   NAME fails loud — a silently misnumbered variable in a check is a
   security bug."
  [strings var-names]
  (let [base (+ CUSTOM-BASE (count (distinct strings)))
        slots (into {} (map-indexed (fn [i n] [n (+ base i)])
                                    (distinct var-names)))]
    (fn [v]
      (if (erlang/is_integer v)
        v
        (let [slot (get slots v)]
          (if (nil? slot)
            (throw (ex-info "unbound variable name in check" {:var v}))
            slot))))))

(defn- encode-term*
  "encode-term plus the term kinds checks need: `{:var slot-or-name}`
   (field 1) and `{:date unix}` (field 4). `resolve-var` maps named vars
   to slots; explicit slots pass through."
  [state resolve-var term]
  (cond
    (and (map? term) (contains? term :var))
      [state (erlang/iolist_to_binary
               (codec/write-varint-field 1 (resolve-var (:var term))))]
    (and (map? term) (contains? term :date))
      [state (erlang/iolist_to_binary
               (codec/write-varint-field 4 (:date term)))]
    (and (map? term) (contains? term :bytes))
      [state (erlang/iolist_to_binary
               (codec/write-len-field 5 (:bytes term)))]
    (= term :null)
      [state (erlang/iolist_to_binary
               (codec/write-varint-field 8 1))]
    (and (map? term) (contains? term :set))
      (let [result (reduce (fn [acc t]
                             (let [tp (encode-term* (first acc) resolve-var t)]
                               [(first tp) (conj (second acc) (second tp))]))
                           [state []]
                           (:set term))
            st (first result)
            term-fields (mapv (fn [tb] (codec/write-len-field 1 tb)) (second result))]
        [st (erlang/iolist_to_binary
              (codec/write-len-field 7
                (erlang/iolist_to_binary (Enum/to_list term-fields))))])
    :else (encode-term state term)))

(defn- pred->tuple
  "A predicate from either authoring shape: the decoded map
   `{:name :terms}` or the fact-style tuple `[name term…]`."
  [p]
  (if (map? p) (into [(:name p)] (:terms p)) p))

(defn- encode-predicate*
  [state resolve-var p]
  (let [tuple (pred->tuple p)
        name-pair (intern-symbol state (first tuple))
        st1 (first name-pair)
        name-idx (second name-pair)
        result (reduce (fn [acc term]
                         (let [tp (encode-term* (first acc) resolve-var term)]
                           [(first tp) (conj (second acc) (second tp))]))
                       [st1 []]
                       (into [] (rest tuple)))
        st2 (first result)
        name-field (codec/write-varint-field 1 name-idx)
        term-fields (mapv (fn [tb] (codec/write-len-field 2 tb)) (second result))]
    [st2 (erlang/iolist_to_binary
           (Enum/to_list (concat (list name-field) term-fields)))]))

(defn- encode-op
  "One Expression op: `{:op :value :term t}` (field 1, a Term),
   `{:op :unary :kind kw}` (field 2) or `{:op :binary :kind kw}`
   (field 3). Unknown kinds fail loud via the inverse tables."
  [state resolve-var op]
  (let [kind (:op op)]
    (cond
      (= kind :value)
        ;; a decoded value op carries raw TERM bytes (decode-expression keeps
        ;; terms opaque) — pass them through untouched, mirroring the
        ;; expression-level binary passthrough; authoring shapes encode
        [state (erlang/iolist_to_binary
                 (codec/write-len-field 1
                   (if (erlang/is_binary (:term op))
                     (:term op)
                     (second (encode-term* state resolve-var (:term op))))))]
      (= kind :unary)
        (let [idx (get unary-kind->idx (:kind op))]
          (if (nil? idx) (throw (ex-info "unknown unary op kind" {:op op})))
          [state (erlang/iolist_to_binary
                   (codec/write-len-field 2
                     (erlang/iolist_to_binary (codec/write-varint-field 1 idx))))])
      (= kind :binary)
        (let [idx (get binary-kind->idx (:kind op))]
          (if (nil? idx) (throw (ex-info "unknown binary op kind" {:op op})))
          [state (erlang/iolist_to_binary
                   (codec/write-len-field 3
                     (erlang/iolist_to_binary (codec/write-varint-field 1 idx))))])
      :else (throw (ex-info "unknown expression op" {:op op})))))

(defn encode-expression
  "Encode an RPN op vector as an Expression message (repeated Op, field
   1), threading the symbol-table state. Raw BINARY entries pass through
   untouched — the round-trip path, where decoded rules keep their exprs
   as raw bytes."
  [state resolve-var ops-or-bytes]
  (if (erlang/is_binary ops-or-bytes)
    [state ops-or-bytes]
    (let [result (reduce (fn [acc op]
                           (let [op-p (encode-op (first acc) resolve-var op)]
                             [(first op-p) (conj (second acc) (second op-p))]))
                         [state []]
                         ops-or-bytes)
          st (first result)
          op-fields (mapv (fn [ob] (codec/write-len-field 1 ob)) (second result))]
      [st (erlang/iolist_to_binary (Enum/to_list op-fields))])))

(defn encode-rule
  "Encode a rule `{:head :body :exprs}` — head defaults to `query()`, the
   check-query head; body predicates take either authoring shape; exprs
   are op vectors or raw bytes. Threads the symbol state."
  [state resolve-var rule]
  (let [head (or (:head rule) ["query"])
        hp (encode-predicate* state resolve-var head)
        st1 (first hp)
        body-result (reduce (fn [acc p]
                              (let [pp (encode-predicate* (first acc) resolve-var p)]
                                [(first pp) (conj (second acc) (second pp))]))
                            [st1 []]
                            (or (:body rule) []))
        st2 (first body-result)
        expr-result (reduce (fn [acc e]
                              (let [ep (encode-expression (first acc) resolve-var e)]
                                [(first ep) (conj (second acc) (second ep))]))
                            [st2 []]
                            (or (:exprs rule) []))
        st3 (first expr-result)
        head-field (codec/write-len-field 1 (second hp))
        body-fields (mapv (fn [pb] (codec/write-len-field 2 pb)) (second body-result))
        expr-fields (mapv (fn [eb] (codec/write-len-field 3 eb)) (second expr-result))]
    [st3 (erlang/iolist_to_binary
           (Enum/to_list (concat (list head-field) body-fields expr-fields)))]))

(defn encode-check
  "Encode a check `{:kind :queries}` into Check bytes: queries (field 1,
   repeated Rule) then kind (field 2, elided when 0 — protobuf default)."
  [check]
  (let [pair (reduce (fn [acc q]
                       (let [collected (walk-collect (concat (or (:body q) [])
                                                             (or (:exprs q) []))
                                                     [(first (first acc)) (second (first acc))])
                             strings (first collected)
                             vars (second collected)]
                         [[strings vars] (second acc)]))
                     [[[] []] []]
                     (:queries check))
        strings (vec (distinct (filter (fn [s] (nil? (get default-symbol-index s)))
                                       (first (first pair)))))
        var-names (second (first pair))
        resolve-var (var-resolver strings var-names)
        ;; the symbol table's strings are known UP FRONT (var slots
        ;; depend on its final size), so seed the state with all of them
        state {:symbols (vec (distinct (filter (fn [s] (nil? (get default-symbol-index s)))
                                                strings)))}
        result (reduce (fn [acc q]
                         (let [rp (encode-rule (first acc) resolve-var q)]
                           [(first rp) (conj (second acc) (second rp))]))
                       [state []]
                       (:queries check))
        query-fields (mapv (fn [rb] (codec/write-len-field 1 rb)) (second result))
        kind (:kind check)
        kind-field (if (or (nil? kind) (= kind 0)) []
                     [(codec/write-varint-field 2 kind)])]
    (erlang/iolist_to_binary
      (Enum/to_list (concat query-fields kind-field)))))

(defn encode-block*
  "The general block encoder: `{:facts :rules :checks}` (all optional).
   Fields emit in schema order — symbols(1), context(2, when present),
   version(3), facts(4), rules(5), checks(6). `encode-block` remains the
   facts-only fast path for minting; this is the attenuation path.

   Facts are tuples; rules take `encode-rule`'s shapes; checks take
   `encode-check`'s. Facts and rules share one symbol state; each CHECK
   owns its table by the same walk-collect discipline — for blocks WE
   author, one walk over the whole block keeps the table minimal."
  [spec]
  (let [facts (or (:facts spec) [])
        rules (or (:rules spec) [])
        checks (or (:checks spec) [])
        ;; collect strings + var names across EVERYTHING, so the symbol
        ;; table is final before var slots are computed
        collected (reduce (fn [acc x] (walk-collect x acc)) [[] []]
                    (concat facts
                            (mapcat (fn [r] (concat (or (:body r) []) (or (:exprs r) [])))
                                    rules)
                            (mapcat (fn [c] (mapcat (fn [q] (concat (or (:body q) []) (or (:exprs q) [])))
                                                    (:queries c)))
                                    checks)))
        ;; an explicit :symbols seed (round-trip: the decoded block's own
        ;; table) wins — var NAMES are not recoverable from numeric slots
        strings (or (:symbols spec)
                    (vec (distinct (filter (fn [s] (nil? (get default-symbol-index s)))
                                           (first collected)))))
        resolve-var (var-resolver strings (second collected))
        ;; the table is KNOWN up front — seed it, so encounter order
        ;; during encoding cannot reorder it (byte-stability)
        fact-result (reduce (fn [acc tuple]
                              (let [pp (encode-predicate* (first acc) resolve-var tuple)]
                                [(first pp) (conj (second acc) (second pp))]))
                            [{:symbols strings} []]
                            facts)
        st1 (first fact-result)
        ;; encode rules
        rule-result (reduce (fn [acc r]
                              (let [rp (encode-rule (first acc) resolve-var r)]
                                [(first rp) (conj (second acc) (second rp))]))
                            [st1 []]
                            rules)
        st2 (first rule-result)
        ;; checks: predicates thread st2's table; walk-collect already
        ;; interned their strings into `strings`, and intern-symbol is
        ;; idempotent — so encode them through encode-rule with the
        ;; SHARED state rather than encode-check's fresh one
        check-result
        (reduce (fn [acc c]
                  (let [qr (reduce (fn [acc2 q]
                                     (let [rp (encode-rule (first acc2) resolve-var q)]
                                       [(first rp) (conj (second acc2) (second rp))]))
                                   [(first acc) []]
                                   (:queries c))
                        st3 (first qr)
                        query-fields (mapv (fn [rb] (codec/write-len-field 1 rb)) (second qr))
                        kind (:kind c)
                        kind-field (if (or (nil? kind) (= kind 0)) []
                                     [(codec/write-varint-field 2 kind)])
                        check-bytes (erlang/iolist_to_binary
                                      (Enum/to_list (concat query-fields kind-field)))]
                    [st3 (conj (second acc) check-bytes)]))
                [st2 []]
                checks)
        st3 (first check-result)
        symbol-fields (mapv (fn [s] (codec/write-len-field 1 s)) (:symbols st3))
        context (:context spec)
        context-field (if (nil? context) [] [(codec/write-len-field 2 context)])
        version-field (codec/write-varint-field 3 (or (:version spec) 3))
        fact-fields (mapv (fn [pm]
                            (codec/write-len-field 4
                              (erlang/iolist_to_binary (codec/write-len-field 1 pm))))
                          (second fact-result))
        rule-fields (mapv (fn [rb] (codec/write-len-field 5 rb)) (second rule-result))
        check-fields (mapv (fn [cb] (codec/write-len-field 6 cb)) (second check-result))]
    (erlang/iolist_to_binary
      (Enum/to_list (concat symbol-fields context-field (list version-field)
                            fact-fields rule-fields check-fields)))))
