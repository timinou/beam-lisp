; datom/blob-fs.bl — the bytes port, on a filesystem.
;
; The default tier for a durable (fjall) database: a sibling directory
; `<db-path>.blobs`, so the database and its bytes move together. Also the
; `:tmp` opt-in for an in-memory database whose files are too large to keep
; on the heap.
;
; ── Layout ────────────────────────────────────────────────────────────
;
;   <dir>/ab/cd/abcd…<64 hex>     two levels of 256-way sharding, so a
;                                 million blobs never sit in one directory
;   <dir>/.tmp/…                  in-flight writes
;
; A write lands in `.tmp` and is `rename`d into place: rename is atomic on a
; POSIX filesystem, so a torn write is never visible under its final name —
; `-blob-has?` is `File.exists?`, and a half-written file does not exist.

(ns datom.blob-fs
  (:require [datom.blob] [datom.file] [datom.store]))

; `ephemeral?` — whether close! may delete the directory. True only for the
; `:tmp` opt-in, whose directory nobody else knows the name of. A directory
; the caller named (or the fjall sibling `<path>.blobs`) is durable data and
; is never removed by a close.
(defrecord BlobFs [dir ephemeral?])

(defn- unique-suffix
  "Unique across VMs and within one run (see datom.store/fresh-path for why
   all three components are needed)."
  []
  (str (erlang/list_to_binary (os/getpid))
       "_" (erlang/monotonic_time :nanosecond)
       "_" (erlang/unique_integer (to-list [:positive]))))

(defn open
  "A blob store at directory `dir` (created if absent). `:tmp` picks a fresh
   directory under the system temp dir. An unwritable location fails HERE, at
   setup, never at the first put."
  [dir]
  (let [ephemeral? (= dir :tmp)
        d (if ephemeral?
            (str (System/tmp_dir!) "/beam_lisp_blobs_" (unique-suffix))
            dir)]
    (File/mkdir_p! d)
    (File/mkdir_p! (str d "/.tmp"))
    (->BlobFs d ephemeral?)))

(defn- shard-dir [bs hex]
  (str (:dir bs) "/" (erlang/binary_part hex 0 2) "/" (erlang/binary_part hex 2 2)))

(defn- path-for [bs sha]
  (let [hex (datom.file/sha-hex sha)]
    (str (shard-dir bs hex) "/" hex)))

(defn- ls
  "Directory entries as a vector of names, [] when absent."
  [p]
  (if (= true (File/dir? p)) (into [] (to-list (File/ls! p))) []))

(extend-type BlobFs
  datom.blob/BlobStore

  (-blob-put [bs sha bytes]
    (let [final (path-for bs sha)]
      (if (= true (File/exists? final))
        bs                                   ; idempotent: content-addressed
        (let [tmp (str (:dir bs) "/.tmp/" (datom.file/sha-hex sha) "_" (unique-suffix))]
          (File/mkdir_p! (shard-dir bs (datom.file/sha-hex sha)))
          (File/write! tmp bytes)
          (File/rename! tmp final)
          bs))))

  (-blob-get [bs sha]
    (let [p (path-for bs sha)]
      (if (= true (File/exists? p)) (File/read! p) nil)))

  (-blob-has? [bs sha]
    (= true (File/exists? (path-for bs sha))))

  (-blob-delete [bs sha]
    (let [p (path-for bs sha)]
      (if (= true (File/exists? p)) (File/rm! p) nil)
      bs))

  (-blob-shas [bs]
    (into []
          (mapcat (fn [l1]
                    (mapcat (fn [l2]
                              (mapv (fn [nm] (binary/decode_hex nm))
                                    (ls (str (:dir bs) "/" l1 "/" l2))))
                            (ls (str (:dir bs) "/" l1))))
                  (filterv (fn [nm] (not (= nm ".tmp"))) (ls (:dir bs)))))))

;; Extending from the protocol side, as store-fjall does for FileBacked: two
;; `extend-type BlobFs` blocks would collide under AOT.
(extend-protocol datom.blob/BlobUrl
  BlobFs
  (-blob-url [bs sha opts] (str "file://" (path-for bs sha))))

(def ^:private CHUNK-BYTES 65536)

;; `File.stream!` with a byte size is a lazy Elixir stream of binaries; it is
;; realized as a seq here so the consumer sees plain chunks. 64 KiB matches
;; the BEAM's own file read buffering.
(extend-protocol datom.blob/BlobStream
  BlobFs
  (-blob-stream [bs sha]
    (let [p (path-for bs sha)]
      (if (= true (File/exists? p))
        (seq (Enum/to_list (File/stream! p CHUNK-BYTES (to-list []))))
        nil))))

;; A `:tmp` directory is deleted on close; a named one is durable and kept.
;; Idempotent: `rm_rf` of an absent directory is fine.
(extend-protocol datom.store/Closeable
  BlobFs
  (-close [bs]
    (if (:ephemeral? bs) (File/rm_rf! (:dir bs)) nil)
    nil))
