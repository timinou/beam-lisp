; datom/blob-fs.bl — the bytes port, on a filesystem.
;
; The default tier for a durable (fjall) database: a sibling directory
; `<db-path>.blobs`, so the database and its bytes move together. Also the
; `:tmp` opt-in for an in-memory database whose files are too large to keep
; on the heap.
;
; ── Layout ────────────────────────────────────────────────────────────
;
;   <dir>/ab/cd/abcd…<64 hex>     two levels of 256-way sharding, so a
;                                 million blobs never sit in one directory
;   <dir>/.tmp/…                  in-flight writes
;
; A write lands in `.tmp` and is `rename`d into place: rename is atomic on a
; POSIX filesystem, so a torn write is never visible under its final name —
; `-blob-has?` is `File.exists?`, and a half-written file does not exist.

(ns datom.blob-fs
  (:require [datom.blob] [datom.blob-retention :as retention] [datom.file] [datom.store]))

; `ephemeral?` — whether close! may delete the directory. True only for the
; `:tmp` opt-in, whose directory nobody else knows the name of. A directory
; the caller named (or the fjall sibling `<path>.blobs`) is durable data and
; is never removed by a close.
(defrecord BlobFs [dir ephemeral?])

(defn- unique-suffix
  "Unique across VMs and within one run (see datom.store/fresh-path for why
   all three components are needed)."
  []
  (str (erlang/list_to_binary (os/getpid))
       "_" (erlang/monotonic_time :nanosecond)
       "_" (erlang/unique_integer (to-list [:positive]))))

(defn open
  "A blob store at directory `dir` (created if absent). `:tmp` picks a fresh
   directory under the system temp dir. An unwritable location fails HERE, at
   setup, never at the first put."
  [dir]
  (let [ephemeral? (= dir :tmp)
        d (if ephemeral?
            (str (System/tmp_dir!) "/beam_lisp_blobs_" (unique-suffix))
            dir)]
    (File/mkdir_p! d)
    (File/mkdir_p! (str d "/.tmp"))
    (->BlobFs d ephemeral?)))

(defn- retention-identity [bs]
 ;; Filesystem identity also joins differently spelled aliases of one tier.
 (let [st (File/stat! (:dir bs))]
  [:blob-fs (:major_device st) (:minor_device st) (:inode st)]))

(defn- shard-dir [bs hex]
  (str (:dir bs) "/" (erlang/binary_part hex 0 2) "/" (erlang/binary_part hex 2 2)))

(defn- path-for [bs sha]
  (let [hex (datom.file/sha-hex sha)]
    (str (shard-dir bs hex) "/" hex)))

(defn- ls
  "Directory entries as a vector of names, [] when absent."
  [p]
  (if (= true (File/dir? p)) (into [] (to-list (File/ls! p))) []))

(extend-type BlobFs
  datom.blob/BlobStore

  (-blob-put [bs sha bytes]
    (let [final (path-for bs sha)]
      (if (= true (File/exists? final))
        bs                                   ; idempotent: content-addressed
        (let [tmp (str (:dir bs) "/.tmp/" (datom.file/sha-hex sha) "_" (unique-suffix))]
          (File/mkdir_p! (shard-dir bs (datom.file/sha-hex sha)))
          (File/write! tmp bytes)
          (File/rename! tmp final)
          bs))))

  (-blob-get [bs sha]
    (let [p (path-for bs sha)]
      (if (= true (File/exists? p)) (File/read! p) nil)))

  (-blob-has? [bs sha]
    (= true (File/exists? (path-for bs sha))))

  (-blob-delete [bs sha]
    (retention/with-delete! (retention-identity bs)
     (fn [] (let [p (path-for bs sha)]
      (if (= true (File/exists? p)) (File/rm! p) nil) bs))))

  (-blob-shas [bs]
    (into []
          (mapcat (fn [l1]
                    (mapcat (fn [l2]
                              (mapv (fn [nm] (binary/decode_hex nm))
                                    (ls (str (:dir bs) "/" l1 "/" l2))))
                            (ls (str (:dir bs) "/" l1))))
                  (filterv (fn [nm] (not (= nm ".tmp"))) (ls (:dir bs)))))))

;; Extending from the protocol side, as store-fjall does for FileBacked: two
;; `extend-type BlobFs` blocks would collide under AOT.
(extend-protocol datom.blob/BlobUrl
  BlobFs
  (-blob-url [bs sha opts] (str "file://" (path-for bs sha))))

(def ^:private CHUNK-BYTES 65536)

;; The lazy seq does not own a live descriptor between chunks: consumers may
;; stop after `take`, or realize it from a different process. Positional reads
;; keep both early termination and process ownership safe, with bounded memory.
(extend-protocol datom.blob/BlobStream
  BlobFs
  (-blob-stream [bs sha]
    (let [p (path-for bs sha)]
      (if (= true (File/exists? p))
        ((fn next-chunk [offset]
           (lazy-seq
             (let [fd (File/open! p (to-list [:read :binary :raw]))
                   r (try (erlang/apply :file :pread (list fd offset CHUNK-BYTES))
                          (finally (File/close fd)))]
               (cond (= r :eof) nil
                     (= :ok (elem r 0)) (cons (elem r 1) (next-chunk (+ offset (erlang/byte_size (elem r 1)))))
                     :else (throw (ex-info "Blob stream read failed" {})))))) 0)
        nil))))

;; A `:tmp` directory is deleted on close; a named one is durable and kept.
;; Idempotent: `rm_rf` of an absent directory is fine.
(extend-protocol datom.store/Closeable
  BlobFs
  (-close [bs]
    (if (and (:ephemeral? bs) (File/exists? (:dir bs)))
     (retention/with-delete! (retention-identity bs) #(File/rm_rf! (:dir bs))) nil)
    nil))


(extend-protocol datom.blob/BlobImport
  BlobFs
  (-blob-import [bs path opts]
    (let [tmp (str (:dir bs) "/.tmp/import_" (unique-suffix))
          input (File/open! path (to-list [:read :binary :raw]))
          output (try (File/open! tmp (to-list [:write :binary :raw]))
                      (catch e (File/close input) (throw e)))]
      (try
        (let [result (loop [hash (crypto/hash_init :sha256) size 0]
                       (let [r (erlang/apply :file :read (list input 65536))]
                         (cond
                           (= r :eof) {:sha (crypto/hash_final hash) :size size}
                           (= :ok (elem r 0))
                           (let [bytes (elem r 1) written (erlang/apply :file :write (list output bytes))]
                             (when (not= :ok written) (throw (ex-info "Blob import write failed" {})))
                             (recur (crypto/hash_update hash bytes) (+ size (erlang/byte_size bytes))))
                           :else (throw (ex-info "Blob import read failed" {})))))
              _ (when (not= :ok (erlang/apply :file :sync (list output)))
                  (throw (ex-info "Blob import sync failed" {})))
              _ (File/close output)
              final (path-for bs (:sha result))]
          (File/mkdir_p! (Path/dirname final))
          (if (File/exists? final) (File/rm! tmp) (File/rename! tmp final))
          (datom.file/->DFile (:sha result) (:size result) (:media-type opts)))
        (finally (File/close input) (File/close output)
                 (when (File/exists? tmp) (File/rm tmp)))))))

(extend-protocol datom.blob/BlobRetention
 BlobFs
 (-retain-blobs [bs] (retention/acquire! (retention-identity bs)))
 (-release-blobs [bs pin] (retention/release! (retention-identity bs) pin))
 (-blobs-retained? [bs] (retention/retained? (retention-identity bs))))
