;; A monotone join: older observations cannot erase newer or unrelated writes.
(ns datom.attr-marks)

(defn merge-marks [current incoming]
  (reduce (fn [m e]
            (let [a (get e 0) tx (get e 1) known (get m a)]
              (if (and (erlang/is_integer tx) (<= 0 tx)
                       (or (nil? known) (> tx known)))
                (assoc m a tx) m)))
          current (into [] incoming)))
