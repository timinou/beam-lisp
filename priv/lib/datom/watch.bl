; datom/watch.bl — L3: filtered, per-principal, live queries.
;
; ── Watch is a TRANSACTION-TIME axis; valid-time does not apply ───────
;
; A watch fires on the COMMIT STREAM: "a write just happened, here is its
; delta". That is transaction time — WHEN a fact was recorded. datom's other
; time axis, VALID time (`datom.time/valid-at`, when a fact is true in the
; world), is a READ-view filter that lives in `db/datoms`; it deliberately does
; NOT reach a watcher. T1 matches the raw broadcast `:tx-datoms` (never a db
; read), and T2 diffs the query over db-before/db-after (the CURRENT view). So a
; transaction that back-dates or future-dates its `:db.valid/from` still fires
; every watch on the attributes it touches AT COMMIT — which is correct: a
; subscriber reacts to changes as they are made, not to the world-time they
; describe. A feed that wants only facts valid at a point filters its own
; callback by reading `(valid-at (d/db conn) t)`. (PLAN-115 B2, W0 audit: the one
; reader that does not pass through `db/datoms`, documented rather than
; retrofitted — the axes are genuinely different questions.)
;
; ── What this adds over L2 ────────────────────────────────────────────
;
; L2 (datom.broadcast) delivers the raw commit stream: every commit, as a
; delta. That is the right primitive, but a subscriber usually cares about
; a SLICE — "orders that became :shipped", "alice's documents", "notes near
; this query vector". L3 is that filter, and it fires the callback ONLY when
; a commit actually affects the interest.
;
; ── The filter already exists (why this file is thin) ─────────────────
;
; Three seams already in the tree compose, so watch writes almost no new
; logic:
;
;   1. auth/rls — a per-principal scope is the SAME `:where` clause
;      injection RLS does. `(auth/guard query filters)` returns a guarded
;      query; `watch` takes it verbatim. The monotonicity of injection (a
;      conjunctive clause only REMOVES rows) is exactly the soundness a
;      subscription needs: a feed can never carry a fact its guard excludes.
;
;   2. query.engine/unify-pattern — already matches ONE `:where` pattern
;      against ONE datom [e a v tx]. A commit's :tx-datoms is a list of
;      those. So the datom-level filter is: ∃ d ∈ tx-datoms . pattern
;      unifies with d. We REUSE that matcher — no second engine to keep in
;      agreement with query semantics (the anti-pattern datom.datalog warns
;      of).
;
;   3. datom.q — for a full query, we do not re-derive incrementally; we
;      re-RUN the query over :db-before and :db-after and diff the answers.
;      The answer is by definition the query engine's, so it cannot drift.
;
; ── The two tiers ─────────────────────────────────────────────────────
;
;   T1  a bare pattern   [?e :order/status :shipped]
;         → match tx-datoms directly with unify-pattern. Cheapest, and the
;           callback gets the matching DATOMS (with add/retract).
;
;   T2a a full query     (guarded or plain, `:find … :where …`, maybe `:in`)
;         → prefilter: does the commit touch any attribute the query reads?
;           If yes, run the query over db-before and db-after and hand the
;           callback the DIFF {:added :removed}. Semantic (`similar-to`) is
;           just a T2a query whose clause happens to be analytic — the bound
;           entity turns it into a filter, so a commit's touched entities are
;           the only ones scored.
;
; ── A watch is a PROCESS ──────────────────────────────────────────────
;
; `watch` spawns a subscriber process that listens to the L2 stream and runs
; the matcher. That is deliberate: a matcher or callback that crashes takes
; down only the watch, never the writer that holds the ordering guarantee
; (let-it-crash), and the callback's backpressure is the watch's mailbox,
; never the writer's. `unwatch` stops it. FEAT-016 holds: the callback
; receives DATOMS or result ROWS — the reader's own material — never a
; projection computed by the writer.

(ns datom.watch
  (:require [datom.conn] [datom.db] [datom.index]
            [datom.query.engine] [datom.query.parse]
            [datom.query.relation] [datom.query.rules]))

;; ── recognising the interest shape ──────────────────────────────────

(defn- query-interest?
  "Whether `interest` is a full query (a `:find` vector or a map), as
   opposed to a bare T1 pattern like `[?e :a ?v]`.

   A query vector begins with the `:find` section keyword; a map is the
   assembled query form; anything else is a bare pattern clause."
  [interest]
  (or (map? interest)
      (and (vector? interest)
           (> (count interest) 0)
           (= :find (get interest 0)))))

;; ── T1: match a bare pattern against the delta ──────────────────────

(defn- pattern-matches
  "Every tx-datom that unifies with `pattern`, as change maps.

   Reuses `query.engine/unify-pattern` — the SAME matcher the query engine
   runs — so a T1 watch and a T1 query agree by construction. Each result
   carries the datom, its bindings, and whether it was asserted or retracted
   (invariant 5: retractions fire too)."
  [pattern tx-datoms]
  (filterv some?
           (mapv (fn [d]
                   (let [b (datom.query.engine/unify-pattern {} pattern d)]
                     (if (nil? b)
                       nil
                       {:datom d
                        :bindings b
                        :e (datom.index/-e d)
                        :a (datom.index/-a d)
                        :v (datom.index/-v d)
                        :added (datom.index/assertion? d)})))
                 tx-datoms)))

;; ── T2a: prefilter by attribute, then diff the query result ─────────
;;
;; The prefilter must OVER-approximate what a commit can move the answer
;; through: a commit touching none of the query's read attributes cannot
;; change its answer, so the query need not run. UNDER-approximating it —
;; naming fewer attributes than the query really reads — silently DROPS
;; firings, the one failure a watch cannot report. BUG-100 was exactly
;; that: an attribute read only inside a rule body, a `:not`, an `:or`, or
;; a computed relation was invisible, so a real change came back `:silent`.
;; Everything the walker cannot NAME therefore yields ALWAYS-RELEVANT.

(def ^:private ALWAYS-RELEVANT
  "The read-set verdict for a query (or a computed relation) whose
   attributes cannot be enumerated: every commit is relevant, so the query
   runs. `query-attrs` otherwise returns the SET of attributes read;
   `touches?` accepts either verdict."
  :all)

(defn- merge-attrs
  "Union two read-set verdicts. ALWAYS-RELEVANT absorbs: one clause the
   walker cannot classify makes the WHOLE query always-relevant, because a
   partial set would drop the firings of the piece it missed."
  [a b]
  (if (or (= ALWAYS-RELEVANT a) (= ALWAYS-RELEVANT b))
    ALWAYS-RELEVANT
    (into a b)))

(defn- pattern-attrs
  "The read set of a data pattern: `#{:order/status}` for a constant
   attribute, or ALWAYS-RELEVANT when the pattern names none.

   `[?e :order/status ?v]` → `#{:order/status}`. A variable attribute
   (`[?e ?a ?v]`) or a wildcard could be any attribute; naming none of them
   would drop real firings."
  [clause]
  (let [a (if (> (count clause) 1) (get clause 1) nil)]
    (if (keyword? a) #{a} ALWAYS-RELEVANT)))

(defn- relation-reads
  "The attributes a computed-relation clause reads, from the relation's
   declared `:reads` (datom.query.relation axis 8), or ALWAYS-RELEVANT when
   it declares none — an undeclared relation reads anything."
  [clause]
  (let [reads (get (datom.query.relation/relation (first (get clause 0))) :reads)]
    (if (seq reads) (set (to-list reads)) ALWAYS-RELEVANT)))

(defn- db-call?
  "Whether a call form takes the database as an argument — a DATABASE
   BUILTIN (`get-else`, `missing?`), which reads attributes this walker does
   not know. A plain predicate never takes a `$` source."
  [call]
  (some datom.query.parse/source? (into [] (rest call))))

(defn- clause-attrs
  "The attributes ONE `:where` (sub-)clause reads: a set, or
   ALWAYS-RELEVANT when it reads something the walker cannot name.

   `names` are the names the query's `%` rules define, `rule-attrs` what
   their bodies read; together they tell a rule invocation from a predicate
   by exactly the test the engine uses (the name is a defined rule).
   Recursion covers the rule operators, so a `:not`/`:or`/`:and`/`-join`
   sub-clause contributes exactly like a top-level one."
  [clause names rule-attrs]
  (cond
    ; a rule operator — recurse into its sub-clauses. The -join forms carry
    ; a join-variable vector first; it names no attribute, so it is skipped.
    (datom.query.parse/rule-clause? clause)
      (let [op (get clause 0)
            subs (cond
                   (= op :not) (rest clause)
                   (= op :or) (rest clause)
                   (= op :and) (rest clause)
                   (= op :not-join) (drop 2 clause)
                   (= op :or-join) (drop 2 clause)
                   :else nil)]
        (if (nil? subs)
          ALWAYS-RELEVANT                    ; unknown operator: fail open
          (reduce (fn [acc sub]
                    (merge-attrs acc (clause-attrs sub names rule-attrs)))
                  #{}
                  subs)))

    ; a computed relation — its DECLARED :reads
    (datom.query.parse/analytic-clause? clause)
      (relation-reads clause)

    ; a rule invocation — what the rule bodies read (walked once, over all)
    (datom.query.parse/rule-invocation? clause names)
      rule-attrs

    ; a call form taking the db — a database builtin, reads unknown attrs
    (and (or (list? clause)
             (and (vector? clause) (> (count clause) 0) (list? (get clause 0))))
         (db-call? (if (list? clause) clause (get clause 0))))
      ALWAYS-RELEVANT

    ; a plain predicate reads no attribute — it filters on bound values
    (datom.query.parse/predicate-clause? clause) #{}

    ; an unrecognised call form
    (list? clause) ALWAYS-RELEVANT

    ; a data pattern
    (datom.query.parse/pattern-clause? clause) (pattern-attrs clause)

    :else ALWAYS-RELEVANT))

(defn- rules-attrs
  "The attributes the `%` rules read: the union over EVERY rule body.

   Laying every body side by side is exact and needs no per-name closure or
   fixpoint — a body's rule invocation names a rule that is IN `%`, so that
   body is in this union too, and recursion cannot contribute an attribute
   no body mentions. An invocation inside a body therefore adds nothing."
  [rules names]
  (reduce (fn [acc rule-def]
            (reduce (fn [a c] (merge-attrs a (clause-attrs c names #{})))
                    acc
                    (into [] (rest rule-def))))
          #{}
          (to-list rules)))

(defn- rules-argument
  "The `%` rules value out of `inputs`, by POSITION: `inputs` line up with
   `parse/input-forms` (data sources excluded), so the form at an index
   names which argument it is.

   nil when the query takes no rules; ALWAYS-RELEVANT when it declares `%`
   but the value is not a rule set (or the arguments do not line up) — the
   walker must not conclude a query reads nothing from rules it could not
   read."
  [parsed inputs]
  (let [forms (datom.query.parse/input-forms parsed)
        supplied (into [] (or inputs '()))]
    (if (not= (count forms) (count supplied))
      (if (datom.query.parse/has-rules-input? parsed) ALWAYS-RELEVANT nil)
      (loop [i 0]
        (if (>= i (count forms))
          nil
          (if (datom.query.parse/rules-var? (get forms i))
            (let [r (get supplied i)]
              (if (and (or (vector? r) (list? r))
                       (every? datom.query.rules/rule-definition? (to-list r)))
                r
                ALWAYS-RELEVANT))
            (recur (+ i 1))))))))

(defn- query-attrs
  "The set of attributes a query reads — over the WHOLE query — or
   ALWAYS-RELEVANT when any part of it cannot be named.

   Walks the top-level `:where`, recurses into every rule operator's
   sub-clauses (`:not`/`:not-join`/`:or`/`:or-join`/`:and`), and folds in
   every body of the `%` rules input (located by `parse/input-forms`
   position, so it lines up with the `inputs` the watch holds). A computed
   relation contributes its declared `:reads`. Anything unclassifiable — a
   variable attribute, an unknown clause form, an undeclared computed
   relation, a `%` argument that is not a rule set — makes the whole
   verdict ALWAYS-RELEVANT: correctness over the optimisation, the promise
   `touches?` already made for variable attributes (BUG-100)."
  [parsed inputs]
  (let [rules (rules-argument parsed inputs)]
    (if (= ALWAYS-RELEVANT rules)
      ALWAYS-RELEVANT
      (let [names (if (nil? rules) #{} (set (to-list (datom.query.rules/rule-names rules))))
            rule-attrs (if (nil? rules) #{} (rules-attrs rules names))]
        (reduce (fn [acc c] (merge-attrs acc (clause-attrs c names rule-attrs)))
                #{}
                (to-list (:where parsed)))))))

(defn- touches?
  "Whether a commit's tx-datoms touch any attribute the query reads.

   `attrs` is `query-attrs`' verdict: a set of attributes, or
   ALWAYS-RELEVANT. Either ALWAYS-RELEVANT or the empty set (a query that
   names no attribute at all) means 'always relevant' — the query runs.
   Otherwise the cheap set-membership test discards a commit that cannot
   possibly affect the query WITHOUT running it."
  [attrs tx-datoms]
  (if (or (= ALWAYS-RELEVANT attrs) (empty? attrs))
    true
    (reduce (fn [_ d]
              (if (contains? attrs (datom.index/-a d)) (reduced true) false))
            false
            tx-datoms)))

(defn- query-diff
  "Run `query` over db-before and db-after and return `{:added :removed}`
   as sets of result tuples, or nil if nothing changed.

   The answer is the query engine's on both sides, so the diff cannot drift
   from query semantics (invariant 3). `inputs` are the query's `:in`
   arguments (a query vector for the semantic case)."
  [query inputs db-before db-after]
  (let [before (apply datom.query.engine/q query db-before inputs)
        after  (apply datom.query.engine/q query db-after inputs)]
    (if (= before after)
      nil
      {:added   (reduce (fn [s x] (if (contains? before x) s (conj s x))) #{} after)
       :removed (reduce (fn [s x] (if (contains? after x) s (conj s x))) #{} before)})))

;; ── the watch process ───────────────────────────────────────────────

(defn- run-t1
  "The T1 loop: listen, match each commit's delta against `pattern`, fire
   `callback` with the matching change maps."
  [conn pattern callback]
  (datom.conn/listen! conn)
  (loop []
    (receive
      [:datom/tx _basis tx-datoms]
        (let [changes (pattern-matches pattern tx-datoms)]
          (when (seq changes) (callback changes))
          (recur))
      [:datom/watch-stop] (datom.conn/unlisten! conn)
      (after 3600000 (recur)))))

(defn- run-t2a
  "The T2a loop: listen, prefilter on touched attributes, and on a
   relevant commit run the query over before/after and fire `callback`
   with the diff. Holds the last db value to diff against."
  [conn query inputs callback]
  (datom.conn/listen! conn)
  (let [parsed (datom.query.parse/parse query)
        attrs (query-attrs parsed inputs)]
    (loop [db-before (datom.conn/db conn)]
      (receive
        [:datom/tx _basis tx-datoms]
          (if (touches? attrs tx-datoms)
            (let [db-after (datom.conn/db conn)
                  d (query-diff query inputs db-before db-after)]
              (when (some? d) (callback d))
              (recur db-after))
            (recur db-before))
        [:datom/watch-stop] (datom.conn/unlisten! conn)
        (after 3600000 (recur db-before))))))

(defn watch
  "Spawn a watch over `conn`, returning a watch reference (a pid) to pass
   to `unwatch`.

   `interest` is either:
     * a bare PATTERN `[?e :order/status :shipped]` (T1) — `callback` gets a
       vector of change maps `{:datom :e :a :v :bindings :added}`, one per
       matching tx-datom;
     * a full QUERY (T2a), a `[:find … :where …]` vector or map, possibly
       `auth/guard`'d — `callback` gets a diff `{:added :removed}` of result
       tuples whenever a relevant commit changes the answer.

   `inputs` are the query's `:in` arguments (e.g. a query vector for a
   `similar-to` clause); omit for T1 or an input-free query.

   The watch runs in its own process: a crashing callback takes down only
   the watch, and its backpressure never reaches the writer."
  ([conn interest callback] (watch conn interest [] callback))
  ([conn interest inputs callback]
   (erlang/spawn
     (fn []
       (if (query-interest? interest)
         (run-t2a conn interest inputs callback)
         (run-t1 conn interest callback))))))

(defn unwatch
  "Stop a watch started by `watch`. Idempotent and safe on a dead watch."
  [watch-ref]
  (if (Process/alive? watch-ref)
    (do (erlang/send watch-ref [:datom/watch-stop]) :ok)
    :ok))
