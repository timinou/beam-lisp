; datom/store_ets.bl — the Store port, filled by ETS `:ordered_set`.
;
; ── What this is for ──────────────────────────────────────────────────
;
; This is the substrate the database is DEVELOPED against. Hobbes is the
; eventual production target (PLAN-033 wave 6), but it is pre-alpha with
; no public API, so making it a prerequisite would put a churning
; dependency on the critical path of every wave. Instead: build the whole
; database on ETS, prove it with the conformance suite, then fill the same
; five methods with Hobbes and run the SAME suite unchanged.
;
; ── Why `:ordered_set` specifically ───────────────────────────────────
;
; `:set` is a hash table — O(1) lookup, no ordering, no ranges. An EAV
; index needs ordered range scans (see datom/store.bl), so the table type
; is load-bearing, not a preference. `:ordered_set` gives O(log n) lookup
; and, critically, `:ets.next/2` — a cursor that walks keys in term order
; from an arbitrary starting point. That cursor is what `-range` is built
; from, and it is why a range scan costs the size of its RESULT rather
; than the size of the table.
;
; ── The honest limitation: atomicity ──────────────────────────────────
;
; ETS has no transactions. `-commit` here applies its operations in a
; single `:ets.insert` call where it can (insert of a LIST of tuples is
; atomic per the ETS docs) but a mixed put/delete batch is NOT atomic:
; a process killed mid-batch can leave some operations applied.
;
; That is stated loudly rather than papered over, because a torn index is
; a corrupt database. For the development substrate this is acceptable —
; single test process, no concurrent writers, no crash recovery story.
; It is ALSO the single strongest argument for Hobbes: strict
; serializability is exactly the property this impl cannot provide, and
; the layers above are written against the protocol's promise, not this
; impl's shortcut.

(ns datom.store-ets
  (:require [datom.store] [datom.blob] [datom.blob-ets]))

(defrecord EtsStore [table])

(defn open
  "Open a fresh ETS-backed store.

   The table is `:ordered_set` (ordering is required — see above) and
   `:public` so any process can read it; ownership stays with the
   creating process, so the table dies when that process does. For a
   development substrate that lifetime is a feature: no cleanup, no
   leaks between test runs."
  ([] (open (keyword (str "datom_store_" (name (gensym "t"))))))
  ([nm] (->EtsStore (ets/new nm (to-list [:ordered_set :public])))))

(defn close
  "Delete the backing table. Idempotent: a table already gone is left gone."
  [store]
  (if (= :undefined (ets/info (:table store)))
    nil
    (ets/delete (:table store)))
  nil)

;; ── internals ───────────────────────────────────────────────────────
;;
;; Every Erlang boundary needs a vector→list conversion: `:ets` speaks
;; tuples and lists, beam-lisp speaks vectors. These two helpers are the
;; only places that translation happens, so the protocol impl below reads
;; as plain data code.

(defn- ->tuple
  "A beam-lisp `[k v]` pair as the `{k, v}` tuple ETS stores."
  [k v]
  (erlang/list_to_tuple (to-list [k v])))

(defn- tuple->entry
  "An ETS `{k, v}` tuple back as a beam-lisp `[k v]` vector."
  [t]
  [(erlang/element 1 t) (erlang/element 2 t)])

(def ^:private END-OF-TABLE
  ; ETS signals exhaustion with the atom `$end_of_table`. Now spelled as the
  ; quoted keyword literal it is (BUG-004 fixed: the reader reads `:"..."` as
  ; one keyword). `$` is not a legal bare-symbol char, so the quotes are
  ; required.
  :"$end_of_table")

(defn- end-of-table?
  "Whether an ETS cursor position is the exhaustion sentinel.

   Naming it once matters: calling `:ets.next` WITH that sentinel raises
   `not a key that exists in the table`, so every cursor step must test
   for it first. (Observed as a crash on the empty-table range scan —
   `ets/first` returns the sentinel, which was then handed straight to
   `ets/next`.)"
  [k]
  (= k END-OF-TABLE))

(defn- walk-from
  "Ascending `[k v]` entries starting at ETS key `k`, up to `stop`
   inclusive, accumulated in reverse.

   Uses `:ets.next/2` as a cursor rather than `tab2list` + filter: the
   cursor stops as soon as the upper bound is passed, so a scan of ten
   keys in a million-row table touches ten keys. That difference is the
   entire reason an index is faster than a scan."
  [table k stop acc]
  (if (end-of-table? k)
    (reverse acc)
    ; The bound test MUST use the same order the cursor walks in. ETS
    ; `:ordered_set` uses ERLANG term order; beam-lisp's `compare` uses
    ; CLOJURE order, and the two disagree (Erlang: atoms before binaries;
    ; Clojure: strings before keywords). Testing with `compare` made a
    ; scan stop early and silently drop valid entries — a range that
    ; returns a SUBSET is worse than one that returns a superset, because
    ; no filter above can recover the missing rows.
    (if (and (some? stop) (erlang/> k stop))
      (reverse acc)
      (let [hit (ets/lookup table k)]
        (recur table
               (ets/next table k)
               stop
               (if (empty? hit)
                 acc
                 (cons (tuple->entry (first hit)) acc)))))))

(defn- start-key
  "The ETS key a scan should begin at.

   `nil` start means unbounded below, so begin at the table's first key.
   Otherwise begin at `start` itself when present, or at the next key
   after it — `:ets.next` skips a key that does not exist, which is
   exactly the semantics an inclusive lower bound wants.

   Guards the sentinel on BOTH paths: an empty table has no first key,
   and a `start` past the last key has no successor."
  [table start]
  (if (nil? start)
    (ets/first table)
    (if (empty? (ets/lookup table start))
      (if (end-of-table? start) start (ets/next table start))
      start)))

(extend-type EtsStore datom.store/Store
  (-get [store k]
    (let [hit (ets/lookup (:table store) k)]
      (if (empty? hit) nil (erlang/element 2 (first hit)))))

  (-range [store start stop]
    (walk-from (:table store) (start-key (:table store) start) stop '()))

  (-put [store k v]
    (ets/insert (:table store) (->tuple k v))
    store)

  (-delete [store k]
    (ets/delete (:table store) k)
    store)

  (-update [store k f]
    ; ETS gives no general CAS, but it DOES give an atomic increment
    ; (`update_counter`) — which is not general enough for an arbitrary
    ; `f`. So this is a plain read-modify-write, and it is atomic ONLY
    ; because the development substrate has a single writer.
    ;
    ; Stated plainly rather than hidden: this is the weakest method in
    ; this implementation, and it is precisely the guarantee Hobbes's
    ; strictly-serializable transactions provide for real. The layer
    ; above must therefore ALSO funnel writes through one process per
    ; database (which wave 2 does), so correctness does not rest on this
    ; method being more than it is.
    (let [current (let [hit (ets/lookup (:table store) k)]
                    (if (empty? hit) nil (erlang/element 2 (first hit))))
          updated (f current)]
      (ets/insert (:table store) (->tuple k updated))
      [store updated]))

  (-commit [store ops]
    ; Operations apply IN ORDER.
    ;
    ; An earlier version grouped all puts into one `:ets.insert` and ran
    ; the deletes afterwards. That is faster, and wrong: a batch of
    ; `[[:delete "k"] [:put "k" 2]]` — exactly what a transaction emits
    ; when it retracts and re-asserts a datom in one go — ended with "k"
    ; ABSENT, because the grouped delete ran last. The value was lost
    ; silently.
    ;
    ; Batching is a performance property; order is a correctness one, so
    ; correctness wins. (A future optimisation may batch CONTIGUOUS runs
    ; of puts, which preserves order.)
    ;
    ; Atomicity remains the documented gap: ETS has no transactions, so a
    ; process killed mid-batch leaves it half-applied. That is the
    ; property Hobbes exists to provide.
    (doseq [op ops]
      (if (= (get op 0) :put)
        (ets/insert (:table store) (->tuple (get op 1) (get op 2)))
        (ets/delete (:table store) (get op 1))))
    store))

;; An in-memory database keeps its file bytes in memory too, unless told
;; otherwise at connect time (`{:blobs :tmp}`). The store owns this default —
;; no caller decides tiers by inspecting the store's type.
(extend-protocol datom.blob/DefaultBlobs
  EtsStore
  (-default-blobs [store] (datom.blob-ets/open)))

;; An ETS table outlives every connection over it until its OWNER dies.
;; `close!` on the last connection is how a long-lived process lets go.
(extend-protocol datom.store/Closeable
  EtsStore
  (-close [store] (close store)))

