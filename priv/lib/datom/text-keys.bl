(ns datom.text-keys
  (:require [datom.index :as index] [datom.codec :as codec] [datom.store-fjall]
            [vm.native :as native]))
(declare cached-ops)
(def prefix (erlang/list_to_binary (to-list [0 120])))
(defn payload [d opts]
  (if (:compact? opts) [(get d 0) :p "" (get d 3) (get d 4)] d))
(defn- floor-ops [ds opts]
  (mapv (fn [d] [:put (erlang/iolist_to_binary (list prefix (index/key-for :avet d))) (payload d opts)]) ds))
(defn- chunk-ops [ds opts]
  (let [ks (when (and (not (:force-floor? opts)) (native/available? "datom.store-fjall"))
             (BeamLisp.Native.Datom.StoreFjall/keycodec_batch
               (to-list (mapv (fn [d] (erlang/list_to_tuple (to-list d))) ds))
               (to-list (mapv (fn [_] (list 3)) ds))))]
    (if (nil? ks)
      (if (:force-floor? opts) (floor-ops ds opts) (cached-ops ds opts))
      (let [keys (into [] ks) n (count ds)]
        (loop [i 0 out []]
          (if (>= i n) out
            (let [d (get ds i)]
              (recur (inc i) (conj out [:put (erlang/iolist_to_binary (list prefix (get keys i))) (payload d opts)])))))))))
(defn ops [datoms opts]
  (let [n (min 256 (max 1 (or (:chunk-size opts) 256)))]
    (loop [remaining (seq datoms) out []]
      (if (empty? remaining) out
        (recur (drop n remaining) (into out (chunk-ops (into [] (take n remaining)) opts)))))))
(defn cached-ops
  ([datoms] (cached-ops datoms {}))
  ([datoms opts]
    (let [yes (codec/encode-value true) no (codec/encode-value false)]
      (:ops
        (reduce (fn [acc d]
                  (let [[e a term tx added] d k [a term]
                        p (or (get (:prefixes acc) k) (erlang/iolist_to_binary (list prefix (index/key-prefix :avet a term))))
                        eb (or (get (:entities acc) e) (codec/encode-value e))
                        tb (or (get (:transactions acc) tx) (codec/encode-value tx))]
                    {:prefixes (assoc (:prefixes acc) k p)
                     :entities (assoc (:entities acc) e eb)
                     :transactions (assoc (:transactions acc) tx tb)
                     :ops (conj (:ops acc) [:put (erlang/iolist_to_binary (list p eb tb (if added yes no))) (payload d opts)])}))
                {:prefixes {} :entities {} :transactions {} :ops []} datoms)))))
