; The transaction writer's current-value projection. History remains authoritative
; for snapshots. These records are derived, bounded by live values, and committed
; atomically with indexes. An attribute epoch invalidates older records when a
; writer that does not maintain this projection advances the attribute marker.
(ns datom.current
  (:require [datom.index :as index] [datom.derived :as derived]))

(defn- marker [store a]
  (let [m (derived/get-record store [:datom.current/attribute a])
        basis (get (derived/get-record store [:datom.attr-basis]) a)]
    (when (and m (some? basis) (= basis (:basis m))) m)))

(defn apply-pending
  "Apply one pair's realized datoms in operation order, including intra-tx changes."
  [values datoms]
  (reduce (fn [vs d]
            (let [v (get d 2)]
              (if (get d 4)
                (if (some (fn [x] (= x v)) vs) vs (conj vs v))
                (filterv (fn [x] (not (= x v))) vs))))
          values datoms))

(defn from-history
  "One linear pass; sort only surviving assertions, never the historical log.
   A retraction at the same tx wins, matching immutable database visibility."
  [datoms]
  (let [latest (reduce (fn [m d]
                        (let [v (get d 2) old (get m v)]
                          (if (or (nil? old) (> (get d 3) (get old 3))
                                  (and (= (get d 3) (get old 3)) (not (get d 4))))
                            (assoc m v d) m))) {} datoms)]
    (mapv (fn [d] (get d 2))
      (sort-by (fn [d] (get d 3)) (filterv (fn [d] (get d 4)) (vals latest))))))

(defn values
  "Current values for a writer, with lazy adoption of pre-projection stores.
   Never used by historical/snapshot readers. An empty projection is a hit."
  [store e a]
  (let [m (marker store a)
        p (when m (derived/get-record store [:datom.current/pair e a]))]
    (if (and p (= (:epoch m) (:epoch p)))
      (:values p)
      (from-history (index/scan store :eavt e a)))))

(defn transaction-ops
  "Projection and coverage evidence for the SAME atomic commit as datoms.
   An interrupted/legacy writer invalidates the attribute epoch, not history."
  ([store datoms tx] (transaction-ops store datoms tx false))
  ([store datoms tx fresh?]
   (let [pairs (reduce (fn [m d]
                         (update m [(get d 0) (get d 1)]
                           (fn [ds] (conj (or ds []) d)))) {} datoms)
         attrs (set (mapv (fn [[pair _]] (get pair 1)) (into [] pairs)))
         epochs (into {} (mapv (fn [a] [a (or (:epoch (marker store a)) tx)]) (into [] attrs)))
         headers (mapcat (fn [a]
                           (derived/put-ops [:datom.current/attribute a]
                             {:basis tx :epoch (get epochs a)})) attrs)]
     (into (vec headers)
       (mapcat (fn [[[e a] ds]]
                 (derived/put-ops [:datom.current/pair e a]
                   {:epoch (get epochs a) :basis tx
                    :values (apply-pending (if fresh? [] (values store e a)) ds)})) pairs)))))

(defn excision-ops
  "Erasure removes projected values as well as their historical datoms."
  [datoms]
  (mapv (fn [[e a]] [:delete (derived/record-key [:datom.current/pair e a])])
    (into [] (set (mapv (fn [d] [(get d 0) (get d 1)]) datoms)))))

(defn projected-values
  "Optional point-read fast path for an immutable current database view.
   nil means use the ordinary snapshot reader. Both coverage and pair basis
   are checked: a commit between the two reads cannot leak a newer value."
  [db e a]
  (when (and (= :current (:filter-mode db)) (nil? (:since-t db))
             (nil? (:valid-at db)) (nil? (:valid-between db)))
    (let [m (marker (:store db) a)
          p (when m (derived/get-record (:store db) [:datom.current/pair e a]))
          t (:basis-t db)]
      (when (and m p (= (:epoch m) (:epoch p)) (number? (:basis p))
                 (<= (:basis p) (:basis m)) (<= (:basis m) t))
        {:values (:values p)}))))
