; Allocation preflight shared by substrate producers and Conn. The authoritative
; registration fence remains Conn's one registry decision; this leaf never
; grants creator/adoption rights and never closes a borrowed native resource.
(ns datom.store-admission (:require [reload.execution :as execution] [datom.migration-policy :as migration-policy] [datom.store-opening :as opening]))
(defn check!
 "Refuse known reserved fresh allocation/registration before substrate work.
  An exact existing store view is still usable. Path containment is refusal
  only, and a preflight is not an atomic opening receipt or completion proof."
 ([path] (check! path nil))
 ([path existing-store]
  (BeamLisp.Env/assert_execution_context!)
  (let [pid (erlang/whereis :datom-conn-registry)
        app (when (execution/owned?) (:application-id (execution/current)))
        normalized (when (string? path) (Path/expand path))
        creator (when (execution/owned?) (select-keys (execution/current) [:application-id :scope :digest]))
        required? (get-in (execution/current) [:resources :dynamic-store-policy])
        permit (Process/get :datom.conn/migration-connect)
        caller (erlang/self)
        ;; Retired Root paths are denial-only inventory. A newly minted NIF
        ;; alias must not turn old protected storage into the legacy Source lane.
        retired-path? (when (and normalized (not= :undefined pid))
                        (Agent/get pid
                         (fn [cells]
                          (some (fn [[_ old]]
                                  (and (migration-policy/under-root? (:root old) normalized)
                                       (not-any? #(and (= :active (:state (second %)))
                                                       (= (:root old) (:root (second %))))
                                                 (get cells :datom.conn/native-mutation-roots {}))))
                                (get cells :datom.conn/native-mutation-retired {}))) 30000))
        _ (when retired-path?
            ;; Original fresh native construction remains possible, before
            ;; enrollment/Source init. A selected G or Source callback refuses.
            (BeamLisp.Env/assert_native_framework_execution!)
            (when (BeamLisp.Env/assert_execution_context!)
             (throw (ex-info "Retired storage requires a fresh native Root before Source opening"
                             {:kind :retired-root-native-bootstrap-required}))))
        queue-role (when-not existing-store (opening/queue-allocation-evidence! normalized))]
   (when (and (= :undefined pid) required?)
    (throw (ex-info "Declared migration policy is not installed" {:kind :migration-policy-not-installed})))
   (when-not (= :undefined pid)
    (BeamLisp.Loader.Server/worker_call
     (fn [delegate]
      (let [refused (Agent/get pid
        (delegate (fn [cells]
         (let [policy (migration-policy/matching cells creator normalized)]
          (when (and required? (nil? policy))
           (throw (ex-info "Declared migration policy is not installed" {:kind :migration-policy-not-installed})))
          (when (and policy (not (and existing-store (get cells existing-store))))
           (migration-policy/check-preflight cells
             {:creator creator :owner caller :path normalized :producer :fjall} permit (some? queue-role))))
         (when-not (and existing-store (get cells existing-store))
          (boolean (some (fn [[_ gate]]
           (or (and app (= app (:application-id gate)))
               (and normalized (:root gate)
                    (migration-policy/under-root? (:root gate) normalized))))
            (get cells :datom.conn/guard-admissions {})))))) 30000)]
       (when refused
        (throw (ex-info "Store allocation is reserved by native activation"
                        {:kind :guard-store-admission-reserved}))))))))
  :admitted))
