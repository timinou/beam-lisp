; datom/blob.bl — the BYTES port: where a file's content lives.
;
; ── A second port beside `datom.store`, the same shape for the same reason ─
;
; `datom.store/Store` is the ordered key/value seam every index rests on.
; File bodies are the one kind of value that must NOT go through it (see
; datom/file.bl: a body copied into every index is the failure mode). So
; bytes get their own port — content-addressed, unordered, four methods plus
; one for GC — and the same discipline: the layers above are written against
; the protocol; a substrate never leaks upward.
;
; ── Tiering is a capability, not a branch ─────────────────────────────
;
; Where bytes live follows where the DATABASE lives, by default:
;
;   store-ets / store-map  (memory)   → blob-ets   (memory)      opt-in: :tmp
;   store-fjall            (disk)     → blob-fs    (<path>.blobs) opt-in: S3
;   store-hobbes           (cluster)  → blob-s3    REQUIRED       (later)
;
; Each Store substrate declares its own default by extending `DefaultBlobs`
; — the store owns the knowledge, exactly as it owns its path suffix via
; `FileBacked`. There is no `if fjall … else …` anywhere above this file, so
; adding a substrate never edits a caller.
;
; The choice is made ONCE, at `connect-with`, and is a property of the STORE
; (it lives in the connection registry cell beside the writer and the basis):
; a second connection over the same store inherits it, and a second connection
; asking for a DIFFERENT blob store is refused. Configuration at setup is an
; enforced invariant, not a convention.

(ns datom.blob)

(defprotocol BlobStore
  "Content-addressed bytes. Keys are 32-byte sha256 binaries; values are
   binaries. Implementations must pass test/bl/datom/blob_test.bl."

  (-blob-put [bs sha bytes]
    "Store `bytes` under `sha`. IDEMPOTENT: a second put of the same sha is a
     no-op. Returns the blob store.")

  (-blob-get [bs sha]
    "The bytes at `sha`, or nil when absent.")

  (-blob-has? [bs sha]
    "Whether `sha` is held. Must be O(1)-ish: the transaction writer calls
     this once per file datom, inside the serializer.")

  (-blob-delete [bs sha]
    "Remove `sha` (idempotent). GC ONLY — never called from the transaction
     path, because a retracted file's bytes are still referenced by history.
     Returns the blob store.")

  (-blob-shas [bs]
    "Every sha held, as a vector. The GC sweep's input: blobs held minus
     blobs referenced anywhere in history are orphans (a crash between
     blob-put and index commit leaves one)."))

;; ── optional capabilities, dispatched by `satisfies?` like datom.store/Scan ──

(defprotocol BlobStream
  "A substrate that can hand bytes out in CHUNKS, so a large file never has
   to be whole on the heap of the process reading it."
  (-blob-stream [bs sha]
    "A lazy sequence of binary chunks for `sha`, or nil when absent."))

(defprotocol BlobUrl
  "A substrate that can hand out a URL for a blob — a presigned S3 GET, a
   `file://` path — so bytes can flow to a client without crossing the BEAM."
  (-blob-url [bs sha opts]
    "A URL string for `sha`, or nil. `opts` may carry `:expires` seconds."))

(defprotocol DefaultBlobs
  "A STORE's default blob tier. Extended by each Store substrate."
  (-default-blobs [store]
    "A fresh blob store appropriate to this database store."))

(defn stream
  "Chunks of `sha`: the substrate's own stream when it offers one, else the
   whole blob as a single chunk (memory tiers already hold it whole). nil
   when absent."
  [bs sha]
  (if (satisfies? BlobStream bs)
    (-blob-stream bs sha)
    (let [b (-blob-get bs sha)] (if (nil? b) nil (list b)))))

(defn url
  "A URL for `sha` if the substrate offers one, else nil."
  [bs sha opts]
  (if (satisfies? BlobUrl bs) (-blob-url bs sha opts) nil))

(defn default-for
  "The blob store `store` declares as its default, or nil for a store with
   no opinion (a wrapper, a test double) — the connection then falls back to
   the memory tier.

   A store for which local bytes would be WRONG — a distributed one, whose
   files must outlive any single node — extends `DefaultBlobs` and throws
   from it, naming the tier it needs. The refusal belongs to the store that
   knows; this function does not guess."
  [store]
  (if (satisfies? DefaultBlobs store) (-default-blobs store) nil))
