;; Admission for automatically maintained exact membership. Input must be the
;; authorization-rewritten query. This module grants no permission to read data.
(ns datom.query.rank-plan
 (:require [datom.query.parse :as parse] [datom.schema :as schema]
           [datom.query.relation :as relation] [data.bounded-cache :as cache]))

(def SCALAR-TYPES #{:db.type/string :db.type/keyword :db.type/long :db.type/ref
                    :db.type/boolean :db.type/instant :db.type/uuid})
(defn descriptor
 "Decline joins, temporal patterns, computed attributes, predicates, repeated
  value variables, noninjective projections and dynamic relation inputs. All
  required fields must be declared cardinality-one scalar attributes. Scope
  values are separate from structural identities; policy must run first."
 [query s inputs order]
 (try
  (let [p (parse/parse query) forms (parse/input-forms p)
        bindings (zipmap forms inputs) clauses (:where p)
        root (first (first clauses))
        patterns? (and (<= 1 (count clauses) 16) (parse/variable? root)
                       (every? (fn [c]
                         (and (vector? c) (= 3 (count c)) (= root (first c))
                              (keyword? (get c 1)) (schema/known? s (get c 1))
                              (not (schema/many? s (get c 1)))
                              (contains? SCALAR-TYPES (schema/value-type s (get c 1)))
                              (nil? (relation/relation (get c 1))))) clauses))
        scoped (when patterns? (filterv (fn [c]
                          (let [v (get c 2)]
                           (or (parse/constant? v) (contains? bindings v)))) clauses))
        scope (when (= 1 (count scoped)) (first scoped))
        fields (when scope (filterv (fn [c] (not= c scope)) clauses))
        values (mapv (fn [c] (get c 2)) fields)
        attrs (mapv (fn [c] (get c 1)) clauses)
        kind (parse/find-kind p)
        count? (and (= :scalar kind) (= (list 'count root) (first (:find p))))
        relation? (and (= :relation kind) (some (fn [v] (= root v)) (:find p))
                       (every? (fn [v] (or (= v root) (contains? (set values) v))) (:find p)))
        ov (first order) direction (second order)
        ordered (when order (first (filter (fn [c] (= ov (get c 2))) fields)))
        scope-value (when scope (let [v (get scope 2)] (if (parse/variable? v) (get bindings v) v)))
        normalized (cache/key-data scope-value 0)
        schema-evidence (into {} (map (fn [a] [a (schema/attr-def s a)]) attrs))
        weight (cache/footprint [normalized schema-evidence])]
   (when (and patterns? scope normalized weight (<= weight 65536) (empty? (parse/validate p))
              (empty? (:with p)) (<= (count forms) 1) (= (count forms) (count inputs))
              (every? parse/variable? forms)
              (every? (fn [v] (= v (get scope 2))) forms)
              (= (count attrs) (count (set attrs)))
              (every? parse/variable? values) (not (contains? (set values) root))
              (= (count values) (count (set values)))
              (or count? relation?)
              (or (and count? (nil? order))
                  (and ordered (contains? #{:asc :desc} direction))))
    {:version 1 :root root :kind (if count? :count :relation)
     :scope normalized :scope-attr (get scope 1)
     :required (vec (sort attrs))
     :order-attr (when ordered (get ordered 1)) :direction direction
     :columns (when relation? (mapv (fn [v]
                      (when (not= root v)
                       (get (first (filter (fn [c] (= v (get c 2))) fields)) 1))) (:find p)))
     :schema schema-evidence}))
  (catch _ nil)))
