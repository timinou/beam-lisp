; datom/query/magic.bl — magic sets, as a rule rewrite over rule DATA.
;
; ── Why this lives in beam-lisp, not the native crate ─────────────────
;
; Magic sets is a SOURCE-TO-SOURCE transformation: rules in, rules out. It
; makes bottom-up evaluation goal-directed by seeding a `magic` relation
; from the query's bound arguments and guarding each rule so it only fires
; for demanded bindings. The asymptotic win — a query touching one corner
; of a graph derives only that corner, not the whole closure — comes from
; the REWRITE, not from where it runs.
;
; And rules here ARE data (`'[[(reachable ?a ?b) …] …]`). So the rewrite is
; an ordinary function `rules -> rules`, and its output is fed to the SAME
; semi-naive engine (datom.query.rules) that runs any rule set. One
; representation: no second engine, and the rewritten rules compose with
; everything the engine already does (predicates, aggregates, as-of).
;
; This is the reconciled architecture the native-spike critique pointed to:
; the two ASYMPTOTIC axes (magic sets here, PreM in prem.bl) are pure
; datalog transforms; only the CONSTANT-factor fixpoint is a native matter.
;
; ── The transformation (linear-recursion, bound first argument) ───────
;
; For a query `(reachable c ?b)` — first arg bound to constant `c`:
;
;   magic-reachable(c).                              ; seed from the bound arg
;   magic-reachable(x) :- magic-reachable(a), edge(a,x).   ; demand propagates
;   reachable(a,b) :- magic-reachable(a), edge(a,b).       ; base, demand-guarded
;   reachable(a,b) :- magic-reachable(a), edge(a,x), reachable(x,b).
;
; Evaluated bottom-up this derives only reachable(c, *). A general magic-sets
; compiler handles every adornment; this implements the common measurable
; case — one recursive predicate, bound FIRST argument — which is exactly the
; demand pattern (reachable-from, ancestor-of, depends-on) queries hit.

(ns datom.query.magic
  (:require [datom.query.parse]))

(defn- magic-name
  "The magic predicate symbol for rule `name`: `magic-<name>`."
  [name]
  (symbol (str "magic-" name)))

(defn- rule-head [rule] (get rule 0))
(defn- rule-body [rule] (into [] (rest rule)))
(defn- head-name [rule] (first (rule-head rule)))
(defn- head-args [rule] (into [] (rest (rule-head rule))))

(defn- invocation-of?
  "Whether body clause `c` is an invocation of rule `name` (bare `(name …)`
   or wrapped `[(name …)]`)."
  [c name]
  (cond
    (list? c) (= (first c) name)
    (and (vector? c) (> (count c) 0) (list? (get c 0))) (= (first (get c 0)) name)
    :else false))

(defn- call-of [c] (if (list? c) c (get c 0)))

(defn rewrite
  "Rewrite `rules` for a demand-driven query on `query-name` whose FIRST
   argument is bound to constant `seed`. Returns a NEW rule set (the same
   data shape) that the semi-naive engine evaluates goal-directed.

   The rewrite, for each rule defining `query-name` with head `(q a …)`:
     * seed rule: `(magic-q seed)` — a fact deriving the demand.
     * guarded rule: prepend `(magic-q a)` to the body.
     * demand rules: for each recursive body invocation `(q x …)`, emit
       `(magic-q x) :- (magic-q a), <preceding non-recursive body clauses>`."
  [rules query-name seed]
  (let [mname (magic-name query-name)
        defs (filterv (fn [r] (= (head-name r) query-name)) (to-list rules))
        others (filterv (fn [r] (not (= (head-name r) query-name))) (to-list rules))
        ; seed fact: (magic-q seed) with an empty body
        seed-rule [(list mname seed)]
        ; per-definition guarded + demand rules
        rewritten (reduce
                    (fn [acc r]
                      (let [hargs (head-args r)
                            a (get hargs 0)                 ; the head's first arg var
                            body (rule-body r)
                            ; guarded: (magic-q a) then the original body
                            guarded (into [(rule-head r) (list mname a)] body)
                            ; demand rules per recursive invocation
                            demand (reduce
                                     (fn [dacc i]
                                       (let [c (get body i)]
                                         (if (invocation-of? c query-name)
                                           (let [x (get (into [] (rest (call-of c))) 0)
                                                 ; preceding non-recursive clauses feed sideways info
                                                 preceding (filterv (fn [pc] (not (invocation-of? pc query-name)))
                                                                    (into [] (take i body)))]
                                             (conj dacc (into [(list mname x) (list mname a)] preceding)))
                                           dacc)))
                                     []
                                     (range (count body)))]
                        (into (conj acc guarded) demand)))
                    []
                    defs)]
    (into (into [seed-rule] rewritten) others)))

(defn rewrite-clause
  "Convenience: given a query `:where` invocation `(query-name seed ?out)`
   with a CONSTANT first argument, return `[rewritten-rules query-name]` so
   the caller can run the demand-optimised program. Returns nil when the
   first argument is not a bound constant (magic needs a bound arg to seed)."
  [rules clause]
  (let [call (call-of clause)
        name (first call)
        args (into [] (rest call))
        first-arg (get args 0)]
    (if (datom.query.parse/variable? first-arg)
      nil
      [(rewrite rules name first-arg) name])))
