;; Disposable demand evidence, never correctness authority. A one-off page
;; should not buy a durable index and its continuing write-maintenance cost.
(ns datom.query.rank-demand
  (:require [data.bounded-cache :as cache]))
(def CACHE :datom.query.rank-demand)
(def MIN-REQUESTS 3)
(def WINDOW-MS 300000)
(defn decision
  "Pure bounded demand transition. Expiration is fixed by the first request;
   occasional requests cannot keep a candidate alive forever."
  [previous now]
  (let [live? (and previous (< now (:expires-at previous)))
        requests (min MIN-REQUESTS (inc (if live? (:requests previous) 0)))]
    {:requests requests :expires-at (if live? (:expires-at previous) (+ now WINDOW-MS))
     :build? (>= requests MIN-REQUESTS)}))
(defn observe!
  "Finite store/definition identities only. Missing cache capacity declines
   speculative construction; ordinary queries remain authoritative."
  [store-key definition]
  (try
    (when (and store-key definition)
      (cache/ready! CACHE)
      (let [key [store-key definition]]
        (= true (global/trans (tuple [::demand key] (erlang/self))
          (fn []
            (let [old (cache/lookup CACHE key :v1)
                  next (decision (:value old) (erlang/monotonic_time :millisecond))]
              (and (cache/put! CACHE key :v1 next) (:build? next))))))))
    (catch _ false)))
