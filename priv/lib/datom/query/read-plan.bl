;; Complete dependency discovery for an engine-owned, closed query fragment.
;; Includes negative and empty reads. No caller-provided attribute assertion,
;; computed provider, arbitrary predicate, rule, or raw database escape is trusted.
(ns datom.query.read-plan
 (:require [datom.query.parse :as parse] [datom.query.relation :as relation]
           [datom.query.agg :as agg]))
(defn clause-attributes [clause depth]
 (when (and (< depth 32) (vector? clause) (<= 1 (count clause) 64))
  (cond
   (parse/pattern-clause? clause)
    (when (and (<= 3 (count clause) 4) (keyword? (get clause 1))
               (nil? (relation/relation (get clause 1)))) #{(get clause 1)})
   (contains? #{:and :or :not :or-join :not-join} (first clause))
    (let [join? (contains? #{:or-join :not-join} (first clause))
          variables (when join? (get clause 1))
          children (vec (drop (if join? 2 1) clause))]
     (when (and (seq children)
                (or (not join?) (and (vector? variables) (every? parse/variable? variables))))
      (let [reads (mapv (fn [c] (clause-attributes c (inc depth))) children)]
       (when (every? some? reads) (reduce into #{} reads)))))
   :else nil)))
(defn attributes [parsed]
 (let [clauses (:where parsed) kind (parse/find-kind parsed)
       elements (case kind :scalar [(first (:find parsed))]
                           :collection [(first (first (:find parsed)))]
                           :tuple (first (:find parsed)) (:find parsed))]
  (when (and (<= 1 (count clauses) 64)
             (every? (fn [x] (or (parse/variable? x) (agg/aggregate-form? x))) elements)
             (every? (fn [f] (or (parse/variable? f) (parse/collection-binding? f)))
                     (parse/input-forms parsed)))
   (let [reads (mapv (fn [c] (clause-attributes c 0)) clauses)]
    (when (every? some? reads) (vec (sort (reduce into #{} reads))))))))
