; datom/query/corpus.bl — the derived embedding-column cache (PLAN-132 Phase 5).
;
; ── What this is, and why it exists ───────────────────────────────────
;
; An embedding column is read by SIMILARITY, not by a range (datom/vector.bl):
; every analytic clause — `similar-to`, `cluster`, `project-2d`, and the
; semantic-graph providers in query/relations.bl — first ASSEMBLES the corpus,
; the list of `[entity dvec]` for every current datom of the column, and then
; hands it to a Rust NIF. Assembly is `attr-datoms db attr` |> keep the DVec
; values |> pair with the entity id.
;
; On the live corpus (filali sources-legales: 62 396 chunks × 768 dims) that
; assembly is ~3.85 s of engine work per evaluation — while the underlying
; store read of the same attribute is 203–400 ms, i.e. the RE-ASSEMBLY, not the
; IO, is the cost (PLAN-132 §10). And it was paid on EVERY eval: warm == cold,
; because nothing held the assembled corpus. Three call sites each rebuilt it.
;
; This ns builds the corpus ONCE per `(store, attr)` state and memoises it, so
; the second and every later evaluation at the same basis pays nothing. The
; NIF search/cluster still runs each time (it must — the query differs); only
; the ~3.85 s assembly is removed.
;
; ── Why the key is (store, attr) discriminated by (basis, filter, since) ──
;
; A datom cache MUST NOT serve a value from a basis the caller is not reading.
; The db value carries a basis-t (and a filter-mode / since-t for history and
; `since` views); the corpus is a pure function of exactly those. So the cache
; is keyed by `(store, attr)` and the stored entry carries the DISCRIMINATOR
; `[basis-t filter-mode since-t]` it was built under. A read at a different
; discriminator is a miss that rebuilds and overwrites — so a transaction
; (which advances basis-t) is an AUTOMATIC miss, with no explicit invalidation
; to forget to call. One slot per column keeps the table O(distinct columns),
; and the newest state evicts the previous one in place.
;
; This is the (store, attribute, basis) derived-column cache of PLAN-132 Phase
; 5, and it is pure beam-lisp: the table is ETS, the policy is here, the vector
; DECODING stays native (we cache the DVec values the store already decoded —
; we never re-decode value bytes in bl, which the read path measured at 4× loss).

;; Cached artifacts per column, chosen by what the caller strides:
;;   :rows     — the `[[entity dvec] …]` pair list (clustering, projection, knn-all)
;;   :resident — a datom.vector/Resident (native decoded+quantised index) for the
;;               SEARCH hot path: decode+quantise happen ONCE per basis, a query
;;               only quantises itself. Supersedes the raw packed corpus for
;;               search (PLAN-132 Phase 5c).
;;   :packed   — a datom.vector/PackedCorpus (raw corpus binary) for callers that
;;               want the bytes directly.
;; All are pure functions of (store, attr, basis), share one slot key and
;; discriminator, and are built lazily and independently on first demand.
;;
;; ── The memory bound (PLAN-132 Phase 4) ──────────────────────────────
;;
;; Each of those artifacts is LARGE: on the live corpus (62 396 × 768) the rows
;; are ~196 MB, the packed binary ~190 MB, the resident index ~190 MB — ~580 MB
;; for ONE fully-built column, and there is one slot per (store, attr) with no
;; bound across stores. A long-lived daemon indexing many stores would grow
;; without limit. So the cache carries a BYTE BUDGET and evicts least-recently-
;; used columns when an insert pushes it over. The budget is a SOFT floor: a
;; single column larger than the whole budget is still cached (the entry being
;; built is never its own eviction victim) — the bound is "at most one oversized
;; column plus whatever else fits", never "unbounded".
;;
;; The row is a WIDE TUPLE, not a map, for one reason: `ets/update_element` can
;; bump the access-time field in place on every read WITHOUT recopying the row's
;; heavy fields. (ETS shares refc binaries by pointer, but the rows list spine
;; is heap; update_element touches only the atime slot.)
;;   row = {key atime bytes disc rows packed resident n dim}
;;           1    2     3    4    5     6      7     8  9
;; Every slot also carries a nonzero metadata charge, including empty columns.
;; Only the requested artifact is returned on hits; metadata projection masks
;; all three heavy fields before ETS returns a row.
;; Meta rows share the table under ATOM keys (entry keys are {store attr}
;; tuples, so eviction tells them apart with is_tuple): {:__total_bytes__ N},
;; {:__evictions__ N}, {:__budget_bytes__ N}.

(ns datom.query.corpus
  (:require [datom.db] [datom.index] [datom.vector] [datom.attr-basis]
            [datom.store] [datom.derived] [datom.cache-validity] [env]))

;; ── the table ────────────────────────────────────────────────────────

(def TABLE :datom_corpus_cache)
(def TOTAL-KEY :__total_bytes__)
(def EVICT-KEY :__evictions__)
(def BUDGET-KEY :__budget_bytes__)
(def DEFAULT-BUDGET (* 512 1024 1024)) ; 512 MiB of derived columns before eviction

(defn- t2 [a b] (erlang/list_to_tuple (to-list [a b])))
(defn- now-tick [] (erlang/unique_integer (to-list [:monotonic :positive])))

(def OWNER :datom-corpus-cache-owner)
(def READY-KEY :__ready__)
(def SLOT-BYTES 256)

(defn- table-ready? []
  (try (not (empty? (ets/lookup TABLE READY-KEY))) (catch _ false)))

(defn- table []
  (when (not (table-ready?))
    ;; A first reader is not the lifetime owner of a VM-wide optional cache.
    ;; The unlinked Agent owns the table, not its contents or query execution.
    (let [started (Agent/start (fn [] :cache-owner) (list (t2 :name OWNER)))
          pid (cond (= :ok (elem started 0)) (elem started 1)
                    (= :already_started (elem (elem started 1) 0)) (elem (elem started 1) 1)
                    :else (throw {:cache-owner-start started}))]
      (Agent/update pid
        (env/convey
          (fn [state]
            (when (not (table-ready?))
              (when (= :undefined (ets/info TABLE))
                (ets/new TABLE (to-list [:set :public :named_table
                                         (t2 :read_concurrency true)
                                         (t2 :write_concurrency true)])))
              ;; Legacy optional rows are dropped, never reused with old
              ;; accounting or resource-bearing keys. Readiness publishes last.
              (ets/select_delete TABLE
                (list (tuple (tuple :_ :_ :_ :_ :_ :_ :_ :_ :_) (list) (list true))))
              (ets/insert TABLE (to-list [(t2 TOTAL-KEY 0) (t2 EVICT-KEY 0)
                                          (t2 BUDGET-KEY DEFAULT-BUDGET) (t2 READY-KEY true)])))
            state)) 30000)
      ;; Scoped initialization callbacks can capture request sinks. Retire
      ;; that garbage once, rather than collecting on a cache hit.
      (erlang/garbage_collect pid)))
  TABLE)

(defn- publication [f]
  (global/trans (t2 :datom-corpus-publication (erlang/self)) f))

;; ── row accessors ─────────────────────────────────────────────────────

(defn- r-key [row] (erlang/element 1 row))
(defn- r-atime [row] (erlang/element 2 row))
(defn- r-bytes [row] (erlang/element 3 row))
(defn- r-disc [row] (erlang/element 4 row))
(defn- r-rows [row] (erlang/element 5 row))
(defn- r-packed [row] (erlang/element 6 row))
(defn- r-resident [row] (erlang/element 7 row))
(defn- r-n [row] (erlang/element 8 row))
(defn- r-dim [row] (erlang/element 9 row))

(defn- ->row [k atime bytes disc rows packed resident n dim]
  (erlang/list_to_tuple (to-list [k atime bytes disc rows packed resident n dim])))

;; ── byte accounting ───────────────────────────────────────────────────

(defn- words-for [dim] (erlang/div (+ dim 63) 64))

(defn- corpus-dim [rows]
  ;; Row-only columns can legally mix dimensions. Charge their maximum,
  ;; outside the publication fence; the first row cannot underprice the rest.
  (reduce (fn [dim row] (max dim (:dim (get row 1)))) 0 rows))

(defn- est-bytes
  "Estimated resident memory of an entry given which artifacts are present.
   rows: n DVec bodies (dim*4 each) plus ~96 B list/record spine per pair;
   packed: one dim*4*n contiguous binary; resident: the decoded f32 matrix
   (dim*4*n) plus the quantised codes (words*8 per row). All additive — none
   share bytes (packed is a fresh concat, resident is decoded off-heap)."
  [n dim has-rows has-packed has-resident]
  (+ SLOT-BYTES (if has-rows (+ (* n dim 4) (* n 96)) 0)
     (if has-packed (* n dim 4) 0)
     (if has-resident (+ (* n dim 4) (* n (words-for dim) 8)) 0)))

(defn- current-total []
  (let [hit (ets/lookup TABLE TOTAL-KEY)]
    (if (empty? hit) 0 (erlang/element 2 (first (to-list hit))))))

(defn- get-budget []
  (let [hit (ets/lookup TABLE BUDGET-KEY)]
    (if (empty? hit) DEFAULT-BUDGET (erlang/element 2 (first (to-list hit))))))

(defn- projected-rows [guards fields]
  ;; Projection happens inside ETS: neither metadata readers nor a resident
  ;; search copy the cached embedding-list spine onto their heaps.
  (ets/select TABLE
    (list (tuple (tuple :"$1" :"$2" :"$3" :"$4" :"$5" :"$6" :"$7" :"$8" :"$9")
                 guards (list (tuple fields))))))

(defn- entry-rows []
  (projected-rows (list (tuple :is_tuple :"$1"))
                  (tuple :"$1" :"$2" :"$3" :"$4" nil nil nil :"$8" :"$9")))

(defn- evict-row! [row]
  (ets/delete TABLE (r-key row))
  (ets/update_counter TABLE TOTAL-KEY (t2 2 (- 0 (r-bytes row))))
  (ets/update_counter TABLE EVICT-KEY (t2 2 1)))

(defn- evict-to-budget!
  "Evict least-recently-used columns until total ≤ budget. Never evicts
   `keep-key` (the entry just built), so the budget is a soft floor: one
   oversized column can exceed it, but nothing grows unbounded."
  [keep-key]
  (loop []
    (when (> (current-total) (get-budget))
      (let [rows (filterv (fn [r] (not= (r-key r) keep-key)) (entry-rows))]
        (when (not (empty? rows))
          (let [victim (reduce (fn [a b] (if (< (r-atime a) (r-atime b)) a b))
                               (first rows) (rest rows))]
            (evict-row! victim)
            (recur)))))))

(defn- store-entry!
  "Publish one artifact under a short fence. Read the winning row's actual
   byte count here; stale builders cannot double-account or lose artifacts.
   All store IO, assembly and native work remain outside this fence."
  [k row]
  (publication
   (fn []
    (table)
    (let [hit (ets/lookup TABLE k) old (first hit)
          same? (and old (= (r-disc old) (r-disc row)))
          older? (and old (= (first (r-disc old)) (first (r-disc row)))
                       (> (second (r-disc old)) (second (r-disc row))))]
     (if older? row
      (let [rows (or (r-rows row) (when same? (r-rows old)))
            packed (or (r-packed row) (when same? (r-packed old)))
            resident (or (r-resident row) (when same? (r-resident old)))
            n (r-n row) dim (r-dim row)
            priced (->row k (now-tick)
                          (est-bytes n dim (some? rows) (some? packed) (some? resident))
                          (r-disc row) rows packed resident n dim)]
       (ets/insert TABLE priced)
       (ets/update_counter TABLE TOTAL-KEY (t2 2 (- (r-bytes priced) (if old (r-bytes old) 0))))
       (evict-to-budget! k)
       priced))))))

(defn- attr-changed?
  "Whether `attr`'s datoms differ between the basis `built` a corpus was built
   at and the basis `db` reads.

   O(1), from the per-attribute marks the connection records at every commit
   (`datom.attr-basis`) plus the mark a build LEAVES BEHIND: a build at tx T
   proves the artifact holds the column as of T, so readers may ask from T
   onward rather than from the beginning of the store's history.

   UNKNOWN means rebuild. The temptation is a WAL-tail read — the quantity is
   right (proportional to the delta) but `datom.time/history` materialises an
   index over the WHOLE store to build it, measured at 736 ms on a 1M-datom
   store for a one-transaction window. Rebuilding costs 2–5 s; a hedge that
   costs a third of a rebuild to answer a question whose honest answers are
   'no' and 'yes' is not a hedge. With the mark recorded at build time,
   unknown happens once per (store, attribute) per VM."
  [db attr built]
  (let [now (datom.db/basis-t db)
        mark (datom.attr-basis/basis-t-for (datom.db/store-of db) attr 0)]
    (not (datom.cache-validity/reusable? now built mark))))

(defn- discriminator
  "The db state a corpus of `attr` depends on: the basis it was BUILT at plus
   the view axes. Two db values may share the slot when the filter/since axes
   match and the attribute has not changed between the built basis and the
   reading one — which `corpus-valid?` decides, because that question needs
   the store and not just two values.

   The basis recorded is the one the ROWS were built at, not the reader's: a
   slot built at tx 40 stays usable at tx 41 when tx 41 wrote some other
   attribute. Keying on the reader's basis instead meant every unrelated
   write — an audit row, a label, a title — invalidated the column, and
   re-decoding + re-quantising 64 708 rows costs 5.3 s + 2.1 s. That is why
   the first application to need this grew a SECOND cache beside the tier's."
  [db]
  [(:filter-mode db) (:since-t db) (:valid-at db) (:valid-between db)])

(defn- complete-column-view?
  "Attribute marks certify a complete transaction-time column. Restricted
   history/since/valid-time views assemble authoritatively instead of reusing
   or publishing a projection whose additional dependencies are unknown."
  [db]
  (and (= :current (:filter-mode db)) (nil? (:since-t db))
       (nil? (:valid-at db)) (nil? (:valid-between db))))

(defn- store-key
  "The store this column is cached AGAINST — the bottom of the wrapper chain,
   not the wrapper itself (`datom.store/identity-of`).

   Keyed by a wrapper's own record value, the same column would exist twice:
   the base's slot and the wrapper's. The measured consequence, on the first
   application to try it: a query through a dry-run re-decoded and re-quantised
   64 708 rows the base had already built, and a PROFILE of a query reported a
   cache build as the query's cost. Resource-neutral typed keys retain no
   underlying native store handle; unsupported identities bypass this cache."
  [db]
  (datom.store/cache-key (datom.db/store-of db)))

(defn- has-blobs?
  "Whether this database value has a blob tier — the same question
   `datom.derived` asks before it can persist anything. Absent (a value built
   without a connection) means memory-only, which is a correct degradation: the
   cache still works inside the process."
  [db]
  (some? (datom.db/blobs-of db)))

(defn- assemble
  "The corpus of `[entity dvec]` for embedding column `attr`, current-basis.
   The one place the assembly lives — every caller routes here.
   A datom whose value is not a DVec (a mis-typed column) is skipped, matching
   the previous inline behaviour in analytic.bl / relations.bl."
  [db attr]
  (filterv some?
           (mapv (fn [d]
                   (let [e (datom.index/-e d) v (datom.index/-v d)]
                     (if (datom.vector/vec? v) [e v] nil)))
                 (datom.db/attr-datoms db attr))))

;; ── the durable tier: an artifact that outlives the process ─────────
;;
;; Everything above is ETS, and ETS dies with the VM. So every restart re-pays
;; the assembly — measured on filali's sources-legales: 2.8 s for the text
;; column's rows, 8.8 s to assemble the embedding column AND quantise it into a
;; resident index — to arrive at a value that is bit-for-bit the one that
;; existed a moment before the restart.
;;
;; `datom.derived` carries those artifacts across the gap: bytes in the store's
;; blob tier, a pointer in the store's internal keyspace. Nothing here decides
;; whether a loaded artifact is still TRUE — that is `attr-changed?`'s question,
;; asked against the pointer's recorded basis, and it is why a loaded column can
;; never be served from a basis the caller is not reading.
;;
;; `:rows` is deliberately NOT durable. It is ~196 MB of BEAM heap (a `DVec`
;; record per row), and loading it would rebuild that heap object by object. The
;; two artifacts worth persisting are the ones a query actually strides — the
;; packed bytes and the quantised index — and both are built from the packed
;; form without going near `:rows`.

(defn- artifact-ident [attr kind] [:datom.corpus attr kind])

(defn- durable-usable?
  "Whether a pointer describes a state `db` can read: it recorded a basis, and
   this attribute has not changed since. The one place a durable artifact is
   judged, so a rehydrated column cannot be served from the wrong basis."
  [db attr pointer]
  (let [basis (get pointer :basis-t)]
    (and (complete-column-view? db)
         (int? basis) (>= (datom.db/basis-t db) basis)
         (= (discriminator db) (get (get pointer :meta) :view))
         (not (attr-changed? db attr basis)))))

(defn- load-packed-artifact
  "The durable `PackedCorpus` for `attr`, or nil. Never throws: an absent or
   unreadable artifact is a MISS, and a miss is rebuilt — a cache is not a
   reason a query fails."
  [db attr]
  (let [hit (datom.derived/load db (artifact-ident attr :packed))]
    (when (and (some? hit) (durable-usable? db attr (get hit :pointer)))
      (try
        (let [meta (get (get hit :pointer) :meta)
              parts (get hit :parts)
              pc (datom.vector/pack-from (BeamLisp.Env/decode_data_term! (get parts :ids))
                                         (get parts :corpus)
                                         (get meta :dim))]
          (datom.attr-basis/note! (datom.db/store-of db) attr (get (get hit :pointer) :basis-t))
          pc)
        (catch _ nil)))))

(defn- save-packed-artifact!
  "Persist the packed corpus. An EMPTY one is skipped: there are no bytes worth
   keeping (rebuilding a column with no rows is free), and a saved empty
   artifact would be restored as authoritative over a column that may since
   have grown."
  [db attr pc]
  (when (and (complete-column-view? db) (> (get pc :n) 0))
    (datom.derived/save! db (artifact-ident attr :packed)
      {:ids (erlang/term_to_binary (get pc :ids))
       :corpus (get pc :corpus)}
      {:basis (datom.db/basis-t db)
       :meta {:dim (get pc :dim) :n (get pc :n) :view (discriminator db)}})))

(defn- load-resident-artifact
  "The durable `Resident` index for `attr`, or nil."
  [db attr]
  (let [hit (datom.derived/load db (artifact-ident attr :resident))]
    (when (and (some? hit) (durable-usable? db attr (get hit :pointer)))
      (try
        (let [meta (get (get hit :pointer) :meta)
              parts (get hit :parts)
              r (datom.vector/resident-load (get parts :index)
                                            (BeamLisp.Env/decode_data_term! (get parts :ids))
                                            (get meta :dim))]
          (datom.attr-basis/note! (datom.db/store-of db) attr (get (get hit :pointer) :basis-t))
          r)
        (catch _ nil)))))

(defn- save-resident-artifact!
  "Persist the resident index. Skipped when there is nothing to persist: an
   empty index has no native handle (`resident-dump` answers nil), and the
   caller must not have to know that before saving."
  [db attr r]
  (let [blob (datom.vector/resident-dump r)]
    (when (and (complete-column-view? db) (some? blob))
      (datom.derived/save! db (artifact-ident attr :resident)
        {:index blob
         :ids (erlang/term_to_binary (get r :ids))}
        {:basis (datom.db/basis-t db)
         :meta {:dim (get r :dim) :n (get r :n) :view (discriminator db)}}))))

;; ── the slot ─────────────────────────────────────────────────────────

(defn- slot
  "Read only the requested artifact, with its immutable build/view stamp.
   Unrelated transactions do not require rewriting or copying the whole slot."
  [db attr kind]
  (try
   (table)
   (when-let [identity (store-key db)]
    (let [k (t2 identity attr)
          row (first (projected-rows
                       (list (tuple :"=:=" :"$1" (tuple :const k)))
                       (tuple :"$1" :"$2" :"$3" :"$4"
                              (if (= kind :rows) :"$5" nil)
                              (if (= kind :packed) :"$6" nil)
                              (if (= kind :resident) :"$7" nil) :"$8" :"$9")))]
     (when row
      (let [built (second (r-disc row))]
       (when (and (complete-column-view? db) (= (discriminator db) (first (r-disc row)))
                  (>= (datom.db/basis-t db) built) (not (attr-changed? db attr built)))
        (ets/update_element TABLE k (t2 2 (now-tick)))
        row)))))
   ;; Optional ownership loss is a miss, never a failed authoritative query.
   (catch _ nil)))

(defn- blank-row
  "A valid slot for `(store, attr)` with no artifact in it yet, stamped with the
   reader's basis — which is what a build at this moment proves."
  [db attr]
  (->row (when-let [key (store-key db)] (t2 key attr)) (now-tick) 0
         [(discriminator db) (datom.db/basis-t db)]
         nil nil nil 0 0))

(defn- attach!
  "Retain a derived artifact when possible; publication failure cannot alter
   the authoritative result the caller just built."
  [_row newrow]
  (if (nil? (r-key newrow)) newrow
    (try (store-entry! (r-key newrow) newrow) (catch _ newrow))))

(defn- with-rows
  "The row for `(store, attr)` with `:rows` built — the ONE place assembly
   happens, and the fallback for every artifact that is not cached at all."
  [db attr]
  (let [row (or (slot db attr :rows) (blank-row db attr))]
    (if (some? (r-rows row))
      row
      (let [rows (assemble db attr)
            n (count rows)
            dim (corpus-dim rows)
            _ (when (complete-column-view? db)
                (datom.attr-basis/note! (datom.db/store-of db) attr (datom.db/basis-t db)))]
        (attach! row (->row (r-key row) (now-tick) 0 (r-disc row)
                            rows (r-packed row) (r-resident row) n dim))))))

;; ── the public read ──────────────────────────────────────────────────

(defn column
  "The `[[entity dvec] …]` corpus of embedding column `attr` in `db`, memoised
   by `(store, attr)` and validated against `db`'s basis/filter/since.

   First call at a given state assembles it (≈ the old per-eval cost); every
   later call returns the cached vector in O(1) as long as this column has not
   changed in between — a write to an UNRELATED attribute advances the store's
   basis and costs nothing here. A change to this column rebuilds, and a reader
   behind the built basis never sees rows from its future."
  [db attr]
  (if (complete-column-view? db)
    (r-rows (with-rows db attr))
    (assemble db attr)))

(defn packed
  "The `datom.vector/PackedCorpus` of embedding column `attr` in `db` — the ids
   plus one contiguous corpus binary, ready for `datom.vector/search-packed`.

   Three tiers, cheapest first: this process's ETS slot, the DURABLE artifact
   (bytes an earlier process already concatenated), and the assembly. A durable
   hit is stamped into the slot, so every later caller pays an ETS lookup."
  [db attr]
  (if-not (complete-column-view? db)
    (datom.vector/pack-corpus (assemble db attr))
    (let [row (slot db attr :packed)]
      (if (and (some? row) (some? (r-packed row)))
        (r-packed row)
        (let [base (or row (blank-row db attr))
              pc (or (load-packed-artifact db attr)
                     (let [r (with-rows db attr)
                           p (datom.vector/pack-corpus (r-rows r))]
                       (when (has-blobs? db) (save-packed-artifact! db attr p))
                       p))]
          (attach! base (->row (r-key base) (now-tick) 0 (r-disc base)
                              (r-rows base) pc (r-resident base)
                              (get pc :n) (get pc :dim)))
          pc)))))

(defn resident
  "The `datom.vector/Resident` index of embedding column `attr` in `db` — a
   native decoded+quantised index ready for `datom.vector/search-resident`. This
   is the hot search path; `packed` remains for callers that want the raw corpus
   binary, and `resident-from-packed` makes that a real intermediate rather than
   a rewrite.

   The most expensive artifact to build (191 MB of f32 decoded, every row
   quantised) and the cheapest to load: the durable tier makes a restart pay a
   READ instead of the arithmetic."
  [db attr]
  (if-not (complete-column-view? db)
    (datom.vector/resident-from-packed (packed db attr))
    (let [row (slot db attr :resident)]
      (if (and (some? row) (some? (r-resident row)))
        (r-resident row)
        (let [base (or row (blank-row db attr))
              r (or (load-resident-artifact db attr)
                    (let [p (packed db attr)
                          built (datom.vector/resident-from-packed p)]
                      (when (has-blobs? db) (save-resident-artifact! db attr built))
                      built))]
          (attach! base (->row (r-key base) (now-tick) 0 (r-disc base)
                              (r-rows base) (r-packed base) r
                              (get r :n) (get r :dim)))
          r)))))

;; ── configuration + introspection (probes, a future `bl cache status`) ─

(defn set-budget!
  "Set the derived-column byte budget and evict LRU under the publication fence."
  [bytes]
  (when (not (and (int? bytes) (>= bytes 0)))
    (throw (ex-info "cache budget must be a nonnegative integer" {:reason :invalid-cache-budget})))
  (publication (fn [] (table) (ets/insert TABLE (t2 BUDGET-KEY bytes)) (evict-to-budget! nil)))
  bytes)

(defn stats
  "Coherent cache occupancy from projected metadata; never copies artifacts."
  []
  (let [empty-stats {:columns 0 :rows 0 :bytes 0 :budget DEFAULT-BUDGET :evictions 0}]
   (if (= :undefined (ets/info TABLE)) empty-stats
    (try
     (publication
      (fn []
       (table)
       (let [rows (entry-rows) evh (ets/lookup TABLE EVICT-KEY)]
        {:columns (count rows)
         :rows (reduce (fn [acc r] (+ acc (r-n r))) 0 rows)
         :bytes (current-total) :budget (get-budget)
         :evictions (if (empty? evh) 0 (elem (first evh) 1))})))
     (catch _ empty-stats)))))

(defn forget!
  "Retire optional columns and accounting together; correctness needs no flush."
  []
  (when (not= :undefined (ets/info TABLE))
   (publication
    (fn []
     (table)
     (doseq [r (entry-rows)] (ets/delete TABLE (r-key r)))
     (ets/insert TABLE (t2 TOTAL-KEY 0)))))
  :ok)
