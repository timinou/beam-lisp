; datom/query/fixpoint.bl — the ONE-TRUTH recursive-rule solver.
;
; The public surface is deliberately implementation-agnostic: `materialise`
; and `compatible?` name WHAT this does (solve a least fixpoint; decide if it
; can), not HOW. That it runs the fixpoint in a Rust kernel is an internal
; fact, explained below but never leaked into a name — there is no bl twin of
; these functions to disambiguate against.
;
; ── What this is, and why it is not a "second engine" ─────────────────
;
; There is exactly ONE place that decides what recursion MEANS: the native
; fixpoint in `native/datom_datalog` (unify, novelty, termination, the
; semi-naive delta). This file does NOT re-implement any of that. It is the
; COMPILER + MARSHALLER that lets beam-lisp drive that one fixpoint:
;
;   1. beam-lisp evaluates the non-recursive body clauses (patterns,
;      predicates) using its OWN engine — the single authority on what a
;      pattern means, including retraction and `as-of`. Those become BASE
;      RELATIONS (sets of tuples). This is bl's existing job.
;   2. The recursive rules are translated to the native IR (atoms + computed
;      items for arithmetic). No evaluation happens in bl.
;   3. The native fixpoint runs ONCE (one boundary crossing) and returns the
;      closure as integer tuples.
;   4. bl decodes the tuples back to values.
;
; So bl owns: value↔integer, pattern meaning, decode. Native owns: the whole
; fixpoint. The responsibilities are DISJOINT — there is no join loop in bl to
; disagree with the join loop in Rust, because bl has none.
;
; ── Full spec adherence: interning ANY value, not just integers ───────
;
; The native kernel joins and stores i64 tuples. To make EVERY Datalog program
; run natively — not only integer-valued graph programs — this driver interns
; arbitrary values (entity refs, keywords, strings, booleans, instants) to
; dense i64 ids and decodes back on the way out. The one thing that must stay
; a *genuine* integer is a value that feeds ARITHMETIC (`+`/`min`/… in a
; recursive rule, e.g. a shortest-path cost): you cannot add two intern ids.
;
; So each predicate POSITION is classified as one of two column kinds:
;
;   :num  — carries a real number; passes through unchanged; may feed a
;           computed item. (Datalog costs, weights, counts.)
;   :sym  — carries an opaque value; interned to an id; never arithmetic.
;           (Entity ids used as identities, keywords, strings, …)
;
; A variable has ONE kind everywhere it appears (it is a single logic
; variable), so kinds are inferred by unifying positions a variable links
; (a small fixpoint, `infer-column-kinds`). A position touched by a computed
; op is :num; everything else defaults to :sym. Because :num and :sym values
; never share a column, intern ids can never collide with live numbers — the
; two id spaces are per-column, not global.
;
; The ONLY program the native path cannot serve: recursion whose body calls an
; ARBITRARY bl function on a RECURSIVE variable (`[(similar-to ?x ?b)]` where
; ?x comes from a recursive invocation) — that value exists only mid-fixpoint
; and its meaning lives in bl. `compatible?` detects it; such programs
; run on the all-bl fixpoint (datom.query.rules/derive-semi-naive), the single
; evaluator for that disjoint class. No input is ever evaluated two ways.

(ns datom.query.fixpoint
  (:require [datom.query.parse] [datom.datalog :as nd]))

;; ── shape helpers (shared vocabulary with rules.bl) ─────────────────

(defn- rule-name [d] (first (get d 0)))
(defn- rule-head-args [d] (into [] (rest (get d 0))))
(defn- rule-body [d] (into [] (rest d)))

(defn- invocation? [c names] (and (list? c) (contains? names (first c))))

;; arithmetic/comparison operators the native kernel understands
(def COMPUTED-OPS
  #{'+ '- '* 'min 'max '< '<= '> '>= '== '!=})
(def PREDICATE-OPS
  #{'< '<= '> '>= '== '!=})
(def OP->KW
  {'+ :+ '- :- '* :* 'min :min 'max :max
   '< :< '<= :<= '> :> '>= :>= '== :== '!= :!=})

(defn- computed-clause?
  "A `[(op arg… ) out]` clause whose op is a native-computable primitive,
   or a bare `[(cmp a b)]` comparison guard."
  [c]
  (and (vector? c)
       (> (count c) 0)
       (list? (get c 0))
       (contains? COMPUTED-OPS (first (get c 0)))))

;; ── a tiny mutable table (process-dict backed) ──────────────────────

(defn- new-table [init] (let [k (erlang/make_ref)] (erlang/put k init) k))
(defn- tget [k] (erlang/get k))
(defn- tset! [k v] (erlang/put k v))

;; ── value interning: opaque value ↔ dense i64 (per driver run) ──────
;;
;; ONE bijection for all :sym columns of a program. A value maps to a stable
;; id; decoding inverts it. Integers that happen to be :sym values are
;; interned too (so a :sym column of small ints and a :num column of small
;; ints never clash — they live in different id spaces by construction).

(defn- new-interner [] (new-table {:fwd {} :rev {} :next 0}))

(defn- intern-value! [tbl v]
  (let [st (tget tbl) fwd (get st :fwd)]
    (if (contains? fwd v)
      (get fwd v)
      (let [id (get st :next)]
        (tset! tbl (assoc st :fwd (assoc fwd v id)
                             :rev (assoc (get st :rev) id v)
                             :next (+ id 1)))
        id))))

(defn- unintern [tbl id] (get (get (tget tbl) :rev) id))

;; ── symbol → dense id (predicate names, variable slots) ─────────────

(defn- new-symtab [] (new-table {:fwd {} :next 0}))
(defn- intern-sym! [tbl s]
  (let [st (tget tbl) fwd (get st :fwd)]
    (if (contains? fwd s)
      (get fwd s)
      (let [id (get st :next)]
        (tset! tbl (assoc st :fwd (assoc fwd s id) :next (+ id 1)))
        id))))

;; ── column-kind inference ───────────────────────────────────────────
;;
;; A POSITION is (pred-name . index). Two positions a variable co-occupies
;; must share a kind. A position feeding a computed op's numeric slot is
;; :num; otherwise :sym. We propagate :num across variable links to a
;; fixpoint, then default the rest to :sym.

(defn- pos [pred idx] [pred idx])

(defn- var-positions
  "Map var → set of positions it occupies across the whole program
   (rule heads + rule-invocation body atoms). Plain patterns don't define
   named predicate positions; their variables get kinds from where they
   ALSO appear in an invocation/head/computed slot."
  [defs names]
  (let [acc (new-table {})]
    (doseq [d (to-list defs)]
      (let [hn (rule-name d) hargs (rule-head-args d)]
        ;; head positions
        (doseq [i (range (count hargs))]
          (let [a (get hargs i)]
            (when (datom.query.parse/variable? a)
              (tset! acc (assoc (tget acc) a
                                (conj (or (get (tget acc) a) #{}) (pos hn i)))))))
        ;; invocation positions in the body
        (doseq [c (to-list (rule-body d))]
          (when (invocation? c names)
            (let [cn (first c) cargs (into [] (rest c))]
              (doseq [i (range (count cargs))]
                (let [a (get cargs i)]
                  (when (datom.query.parse/variable? a)
                    (tset! acc (assoc (tget acc) a
                                      (conj (or (get (tget acc) a) #{}) (pos cn i))))))))))))
    (tget acc)))

(defn- numeric-vars
  "Variables that MUST be numeric: any var appearing in a computed clause —
   an argument to arithmetic/comparison, or its output. These force their
   positions to :num."
  [defs]
  (reduce
    (fn [s d]
      (reduce
        (fn [s2 c]
          (if (computed-clause? c)
            (let [call (get c 0)
                  args (filterv datom.query.parse/variable? (into [] (rest call)))
                  out (if (> (count c) 1) (get c 1) nil)
                  s3 (into s2 args)]
              (if (and (some? out) (datom.query.parse/variable? out))
                (conj s3 out) s3))
            s2))
        s
        (to-list (rule-body d))))
    #{}
    (to-list defs)))

(defn- positions->vars
  "Invert var-positions: `{position #{vars}}` — which variables share each
   named predicate position. Two vars at one position must share a kind."
  [vpos]
  (reduce (fn [m v]
            (reduce (fn [m2 p]
                      (assoc m2 p (conj (or (get m2 p) #{}) v)))
                    m (into [] (or (get vpos v) #{}))))
          {}
          (into [] (keys vpos))))

(defn- numeric-var-set
  "The CLOSED set of numeric variables. Seeded from variables that appear in
   a computed clause (direct arithmetic/comparison), then propagated across
   shared predicate positions to a fixpoint: if any variable at a position is
   numeric, every variable at that position is numeric (they unify to one
   column, which must be a real number for the kernel's arithmetic). This is
   what keeps a weight `?w` — which occupies no head/invocation position but
   feeds `(+ ?dx ?w)` — correctly :num, so it passes through as a raw number
   instead of being interned."
  [defs names vpos]
  (let [seed (numeric-vars defs)
        pvars (positions->vars vpos)]
    (loop [num seed]
      (let [grown (reduce
                    (fn [s v]
                      ;; every position v occupies pulls in its co-occupants
                      (reduce (fn [s2 p] (into s2 (or (get pvars p) #{})))
                              s (into [] (or (get vpos v) #{}))))
                    num
                    (into [] num))]
        (if (= (count grown) (count num)) num (recur grown))))))

;; a variable's kind is authoritative from the CLOSED numeric var set:
;; :num iff numeric (arithmetic-touched or position-linked to one), else :sym.
;; Correct even for a var with no named predicate position (a weight that
;; appears only in a base clause and a computed op).
(defn- var-kind [num-vars v]
  (if (contains? num-vars v) :num :sym))

;; ── encode a value for a column of a given kind ─────────────────────

;; Thrown when a program is structurally native but its DATA is not (a float
;; in an arithmetic column: the native kernel's Op is saturating i64). Caught
;; by `rules/materialise`, which then runs the whole program on the bl
;; fallback — the program is still computable, just not by the i64 kernel. The
;; tag makes the catch PRECISE: only this condition falls back, real bugs
;; still surface.
(def FALLBACK-TAG :native-datalog/needs-bl-fallback)

(defn- encode-val [ival kind v]
  (cond
    (= kind :num)
      (cond
        (erlang/is_integer v) v
        ;; a float in an arithmetic column: the i64 kernel cannot add it.
        ;; Signal a fallback to bl rather than crashing on a valid program.
        (erlang/is_float v)
          (throw (ex-info "native-datalog: float in an arithmetic column"
                          {:tag FALLBACK-TAG :val v}))
        :else
          (throw (ex-info "native-datalog: non-numeric value in an arithmetic column"
                          {:val v})))
    :else (intern-value! ival v)))     ; :sym → intern (any value)

(defn- decode-val [ival kind v]
  (if (= kind :num) v (unintern ival v)))

;; ── IR term construction ────────────────────────────────────────────

(defn- var-term [vslot v] (nd/var-term (intern-sym! vslot v)))
(defn- const-term-for [ival kind c] (nd/const-term (encode-val ival kind c)))

;; ── the boundary: what the native kernel can and cannot evaluate ────

(defn- non-native-predicate?
  "A call-form predicate/function whose op the native kernel does NOT know —
   `[(similar-to …)]`, an arbitrary bl fn. Native primitives are excluded."
  [clause names]
  (and (vector? clause)
       (> (count clause) 0)
       (list? (get clause 0))
       (not (invocation? clause names))
       (not (contains? COMPUTED-OPS (first (get clause 0))))))

(defn- native-compatible-clause?
  "Whether one body clause is native-evaluable. Exactly four shapes are:
     * a rule invocation      — the recursion (kernel);
     * a native computed op   — `+`/`min`/comparison (kernel computed item);
     * a pattern              — a vector whose head is NOT a call form; bl
                                pre-evaluates it to a fixed base relation the
                                kernel joins against (independently evaluable,
                                even with unbound or recursive-joined vars).
   Anything else is an ARBITRARY bl call-form clause `[(f …)]` whose op is not
   a native primitive — a FILTER (`[(even? ?b)]`) or a generator
   (`[(similar-to ?x ?b)]`). Such a clause is NOT independently evaluable into
   a base relation (a filter needs the in-body join bindings; a generator
   needs its input bound), so it can never be native. It falls to the bl
   fixpoint, which evaluates it per-row with the join already in hand. This is
   correct regardless of whether its vars are recursive — the earlier
   'only-if-recursive' rule was unsound for filters."
  [clause names]
  (cond
    (invocation? clause names) true
    (computed-clause? clause) true
    (non-native-predicate? clause names) false
    (vector? clause) true
    :else false))

(defn compatible?
  "Whether an entire rule set can be evaluated by the native kernel. False ⇒
   the caller must use the all-bl fixpoint for this program. Value type is NO
   LONGER a constraint (interning handles any value); the only bar is an
   arbitrary bl predicate over a recursive variable."
  [rules]
  (let [defs (to-list rules)
        names (set (mapv rule-name defs))]
    (every?
      (fn [d]
        (every? (fn [c] (native-compatible-clause? c names))
                (to-list (rule-body d))))
      defs)))

(defn fallback-signal?
  "Whether `err` (an ex-info caught from `materialise`) is the DATA-
   level fallback signal — a structurally-native program whose runtime values
   the i64 kernel cannot take (a float in an arithmetic column). The caller
   (`rules/materialise`) catches exactly this to re-run on the bl fixpoint;
   any other error is a real fault and propagates."
  [err]
  (= FALLBACK-TAG (get (ex-data err) :tag)))

;; ── base relations from a plain clause (bl's authority) ─────────────
;;
;; bl evaluates the clause with its OWN engine, projecting the clause's
;; variables in first-appearance order; each row is encoded per the column
;; kind of the position the variable links to elsewhere in the program.

(defn- clause-vars [clause]
  (if (vector? clause)
    (filterv datom.query.parse/variable? (into [] clause))
    []))

(defn- plain-clause-relation
  "[vars encoded-tuples] for a plain clause. Encoding uses each variable's
   inferred kind so :sym values intern and :num values pass through."
  [db eval-plain ival num-vars clause]
  (let [vars (clause-vars clause)
        rows (eval-plain db {} clause)
        tuples (mapv (fn [b]
                       (mapv (fn [v] (encode-val ival (var-kind num-vars v) (get b v)))
                             vars))
                     (into [] rows))]
    [vars tuples]))

;; ── the driver ──────────────────────────────────────────────────────

(defn- build-ir
  "Compile a rule set to the native IR, shared by the full and demand-scoped
   evaluators. Returns a map of everything the kernel call needs:
     :ival       the value interner (value ↔ i64), also decodes results
     :ir-rules   the native rule IR
     :edb        the base relations (plain clauses materialised via eval-plain)
     :idb-ids    the derived predicate ids
     :name->id   rule name → predicate id
     :head-kinds rule name → per-column value-kind (for decoding)
     :num-vars   the numeric-variable set (for encoding a seed the same way)
   Interning is done ONCE here so a seed value encoded later lands on the same
   i64 as the matching EDB tuples."
  [db rules eval-plain]
  (let [defs (to-list rules)
        names (set (mapv rule-name defs))
        vpos (var-positions defs names)
        num-vars (numeric-var-set defs names vpos)
        ival (new-interner)
        pred-tbl (new-symtab)
        name->id (reduce (fn [m nm] (assoc m nm (intern-sym! pred-tbl nm))) {} (into [] names))
        head-kinds (reduce
                     (fn [m d]
                       (let [hn (rule-name d)]
                         (if (contains? m hn) m
                           (assoc m hn (mapv (fn [a] (var-kind num-vars a)) (rule-head-args d))))))
                     {} (to-list defs))
        edb-acc (new-table {:rels [] :next-pred 1000000})
        ir-rules
        (reduce
          (fn [acc d]
            (let [head-id (get name->id (rule-name d))
                  vslot (new-symtab)
                  head-atom (nd/atom head-id
                                     (mapv (fn [a]
                                             (if (datom.query.parse/variable? a)
                                               (var-term vslot a)
                                               (const-term-for ival (var-kind num-vars a) a)))
                                           (rule-head-args d)))
                  body-items
                  (mapv
                    (fn [clause]
                      (cond
                        (invocation? clause names)
                          (nd/atom-item
                            (nd/atom (get name->id (first clause))
                                     (mapv (fn [a]
                                             (if (datom.query.parse/variable? a)
                                               (var-term vslot a)
                                               (const-term-for ival (var-kind num-vars a) a)))
                                           (into [] (rest clause)))))
                        (computed-clause? clause)
                          (let [call (get clause 0)
                                op (get OP->KW (first call))
                                args (mapv (fn [a]
                                             (if (datom.query.parse/variable? a)
                                               (var-term vslot a)
                                               (nd/const-term a)))     ; numeric literal
                                           (into [] (rest call)))]
                            (if (> (count clause) 1)
                              (nd/computed-item op args
                                                (if (datom.query.parse/variable? (get clause 1))
                                                  (var-term vslot (get clause 1))
                                                  (nd/const-term (get clause 1))))
                              (nd/computed-item op args (nd/const-term 1))))
                        :else
                          (let [rel (plain-clause-relation db eval-plain ival num-vars clause)
                                vars (get rel 0)
                                tuples (get rel 1)
                                st (tget edb-acc)
                                pid (get st :next-pred)]
                            (tset! edb-acc
                                   (assoc st :next-pred (+ pid 1)
                                             :rels (conj (get st :rels)
                                                         (nd/edb-relation pid (count vars) tuples))))
                            (nd/atom-item (nd/atom pid (mapv (fn [v] (var-term vslot v)) vars))))))
                    (rule-body d))]
              (conj acc (nd/rule head-atom body-items))))
          []
          defs)]
    {:ival ival
     :ir-rules ir-rules
     :edb (get (tget edb-acc) :rels)
     :idb-ids (mapv (fn [nm] (get name->id nm)) (into [] names))
     :name->id name->id
     :head-kinds head-kinds
     :num-vars num-vars
     :names (into [] names)}))

(defn- decode-relation
  "Decode a native `[arity flat-tuples]` result for rule `nm` back to a set of
   value tuples, using the interner and the rule's head kinds."
  [ir nm result]
  (let [hk (get (get ir :head-kinds) nm)
        tuples (nd/tuples result)]
    (set (mapv (fn [t]
                 (mapv (fn [i] (decode-val (get ir :ival) (get hk i) (get t i)))
                       (range (count t))))
               (into [] tuples)))))

(defn materialise
  "Least fixpoint of `rules` over `db`, via the native kernel. Same signature
   and output shape as datom.query.rules/materialise: `{name tuple-set}` with
   DECODED value tuples. Works for any value type (interning); requires that
   the program be `compatible?` (checked by the caller/dispatcher)."
  [db rules eval-plain]
  (let [ir (build-ir db rules eval-plain)]
    (reduce
      (fn [out nm]
        (let [pid (get (get ir :name->id) nm)
              result (nd/eval (get ir :ir-rules) (to-list (get ir :idb-ids))
                              (to-list (get ir :edb)) pid 2)]
          (assoc out nm (decode-relation ir nm result))))
      {}
      (get ir :names))))

(defn materialise-magic
  "Demand-scoped least fixpoint: compute ONLY the `query-name` relation, and
   only the tuples reachable from `seed-val` bound to the query predicate's
   FIRST argument (adornment `bf…`). Routes to the native magic-sets kernel
   (`dl_eval_magic`), which rewrites the program so recursion fires only on the
   demanded frontier — O(reachable subgraph) instead of O(all pairs).

   `seed-val` is a decoded value (e.g. the bound entity); it is encoded through
   the SAME interner as the EDB, so it lands on the matching i64. Returns just
   `{query-name tuple-set}` (the other rules are not materialised — that is the
   point of demand). Requires `compatible?` (caller checks) AND a single scalar
   seed on the first head arg."
  [db rules eval-plain query-name seed-val]
  (let [ir (build-ir db rules eval-plain)
        pid (get (get ir :name->id) query-name)
        ;; encode the seed the same way the query predicate's first head arg is
        ;; encoded, so the magic seed relation joins the EDB correctly
        kind (get (get (get ir :head-kinds) query-name) 0)
        seed-i64 (encode-val (get ir :ival) kind seed-val)
        result (nd/eval-magic (get ir :ir-rules) (to-list (get ir :idb-ids))
                              (to-list (get ir :edb)) pid seed-i64)]
    {query-name (decode-relation ir query-name result)}))
