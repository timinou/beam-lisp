; A query received as data must not acquire the querying namespace's code.
; Ordinary application queries keep lexical resolution. External boundaries
; opt into a closed vocabulary once, around their existing query handler.
(ns datom.query.functions (:require [data.first-order :as first-order]))

(def ^:private POLICY :datom.query.functions/closed)

(defn restricted? [] (map? (erlang/get POLICY)))

(defn check-query! [query]
  (when (restricted?) (first-order/check! query))
  query)

(defn keyword-token
  "Read a keyword token from an external query without allocating a VM atom.
   Schema/DSL keywords already exist. Unknown names refuse rather than grow a
   permanent VM table from request data. text excludes the leading colon."
  [text]
  (try (erlang/binary_to_existing_atom text :utf8)
    (catch _ (throw (ex-info "Unknown external query keyword"
                     {:kind :query-keyword-refused :keyword text})))))

(defn pure
  "Fixed SDK operations for queries supplied by an untrusted caller. No Env
   lookup, native invocation, mutable catalogue or application alias resolution."
  []
  {"=" = "not=" not= "<" < "<=" <= ">" > ">=" >=
   "+" + "-" - "*" * "/" / "quot" quot "rem" rem
   "inc" inc "dec" dec "min" min "max" max "abs" abs
   "not" not "nil?" nil? "some?" some? "number?" number?
   "string?" string? "keyword?" keyword? "boolean" boolean
   "str" str "name" name "count" count "empty?" empty?
   "contains?" contains? "get" get "nth" nth "first" first "second" second
   "String/contains?" String/contains? "String/starts_with?" String/starts_with?
   "String/ends_with?" String/ends_with? "String/downcase" String/downcase
   "String/upcase" String/upcase "String/trim" String/trim "subs" subs})

(defn with-only
  "Run thunk with closed predicate resolution. Trusted hosts can supply an
   explicit string->function registry. Nested scopes can only narrow authority.
   This process-local extent must surround execution, not just query parsing."
  ([thunk] (if (restricted?) (thunk) (with-only (pure) thunk)))
  ([operations thunk]
   (when-not (and (map? operations)
                 (every? (fn [[k v]] (and (string? k) (fn? v))) operations))
     (throw (ex-info "Invalid query function registry" {:kind :invalid-query-functions})))
   (let [before (erlang/get POLICY)
         narrowed (if (map? before)
                    (into {} (filter (fn [[k f]] (= f (get before k))) operations))
                    operations)]
     (erlang/put POLICY narrowed)
     (try (thunk) (finally
       (if (= :undefined before) (erlang/erase POLICY) (erlang/put POLICY before)))))))

(defn resolve-op
  "Resolve through the closed registry, or call the ordinary trusted fallback."
  [op fallback]
  (if (restricted?)
    (if-let [f (get (erlang/get POLICY) (str op))]
      ;; Database values may also contain opaque terms. Validate before a pure
      ;; sequence operation can dispatch a forged foreign Enumerable protocol.
      (fn [& args] (first-order/check! args) (apply f args))
      (throw (ex-info "Query function is outside the closed vocabulary"
               {:kind :query-function-refused :operation (str op)})))
    (fallback)))

(def ^:private DATABASE-OPS #{"get-else" "missing?"})
(def ^:private ANALYTIC-OPS #{"similar-to" "cluster" "project-2d" "community" "components"})

(defn- check-expression! [expression]
  (loop [pending (list expression) budget 16384]
    (when (seq pending)
      (when (<= budget 0)
        (throw (ex-info "Query expression exceeds admission budget" {:kind :query-expression-budget})))
      (let [item (first pending) tail (rest pending)]
        (if (and (list? item) (seq item) (not= 'quote (first item)))
          (do (resolve-op (first item) (fn [] nil))
              (recur (concat (rest item) tail) (dec budget)))
          (recur tail (dec budget)))))))

(defn guard!
  "Preflight all executable predicates, including unused rule branches, before
   scanning a row. Literal/quoted data is inert. Relation dispatch independently
   restricts computed providers to the fixed SDK implementations."
  [clauses rules relation]
  (when (restricted?)
    (first-order/check! rules)
    (let [names (set (map (fn [rule] (first (first rule))) (or rules [])))
          bodies (mapcat rest (or rules []))]
      (loop [pending (concat clauses bodies) budget 16384]
        (when (seq pending)
          (when (<= budget 0)
            (throw (ex-info "Query exceeds admission budget" {:kind :query-expression-budget})))
          (let [clause (first pending) tail (rest pending)
                call (when (vector? clause) (first clause))]
            (when (and (vector? clause) (> (count clause) 1)
                       (keyword? (second clause)))
              (relation (second clause)))
            (cond
              (and (vector? clause) (keyword? call)
                   (contains? #{:and :or :not :or-join :not-join} call))
                (recur (concat (if (contains? #{:or-join :not-join} call)
                                  (drop 2 clause) (rest clause)) tail) (dec budget))
              (and (vector? clause) (list? call))
                (do
                  (when-not (or (contains? names (first call))
                                (contains? DATABASE-OPS (str (first call)))
                                (contains? ANALYTIC-OPS (str (first call))))
                    (check-expression! call))
                  (recur tail (dec budget)))
              (and (list? clause) (seq clause))
                (do (when-not (contains? names (first clause)) (check-expression! clause))
                    (recur tail (dec budget)))
              :else (recur tail (dec budget))))))))
  :ok)
