; datom/query/agg.bl — aggregates in the :find clause.
;
; ── The shape ─────────────────────────────────────────────────────────
;
;   [:find (count ?e) :where [?e :person/name _]]        how many people?
;   [:find (avg ?age) :where [?e :person/age ?age]]      average age
;   [:find ?city (count ?e)                              per-city counts
;    :where [?e :person/city ?city]]
;
; An aggregate is a call form in `:find` position, which is why the
; parser distinguishes `(count ?e)` from the plain variable `?e`.
;
; ── Grouping is implicit, and that is the good design ─────────────────
;
; There is no `GROUP BY`. The plain variables in `:find` ARE the grouping
; key; the aggregated ones are folded within each group.
;
;   [:find ?city (count ?e)]   groups by ?city, counts ?e per group
;   [:find (count ?e)]         no plain variables, so ONE group
;
; SQL needs GROUP BY because its SELECT list and its grouping are
; separately specified and must be kept consistent by hand — the source
; of the classic `column must appear in the GROUP BY clause` error. Here
; the two cannot disagree, because there is only one list.
;
; ── Aggregates run over the RESULT SET ────────────────────────────────
;
; Datalog results are a set, so `(count ?e)` counts DISTINCT bindings.
; That is worth stating because it differs from SQL's `COUNT(*)`: two
; identical rows are one answer here, and counting them twice would be
; counting a derivation rather than a fact.
;
; `count-distinct` is therefore the same as `count` on the tuples; where
; a caller wants the number of distinct VALUES of one variable within a
; group, that is `count-distinct` over the projected column.

(ns datom.query.agg
  (:require [datom.query.parse]))

(def AGGREGATES #{'count 'count-distinct 'distinct 'sum 'avg 'max 'min})

(defn aggregate-form?
  "Whether `element` is an aggregate call like `(count ?e)`."
  [element]
  (and (list? element)
       (> (count element) 0)
       (contains? AGGREGATES (first element))))

(defn aggregate-op
  "The operator of an aggregate form."
  [element]
  (first element))

(defn aggregate-variable
  "The variable an aggregate folds over."
  [element]
  (first (rest element)))

(defn has-aggregates?
  "Whether any `:find` element is an aggregate."
  [find-elements]
  (some? (first (filterv aggregate-form? find-elements))))

(defn grouping-variables
  "The plain variables in `:find` \u2014 the implicit grouping key."
  [find-elements]
  (filterv datom.query.parse/variable? find-elements))

;; ── the folds ───────────────────────────────────────────────────────

(defn- apply-aggregate
  "Fold `values` with the named aggregate.

   `nil` values are SKIPPED rather than treated as zero: an attribute an
   entity does not have should not drag an average down. Datomic does the
   same, and the alternative silently reports a wrong statistic."
  [op values]
  (let [vs (filterv some? values)]
    (cond
      ; count includes nils \u2014 it counts ROWS, not values, so an entity
      ; missing the attribute still counts as an entity.
      (= op 'count) (count values)
      (= op 'count-distinct) (count (distinct vs))
      ; `distinct` returns the SET of distinct values as a vector (nils
      ; skipped, like every other value fold). Unlike the scalar folds this
      ; yields a COLLECTION in the result tuple — the caller that wants the
      ; actual members, not just their count (count-distinct). Order is the
      ; first-seen order the underlying result set presents.
      (= op 'distinct) (into [] (distinct vs))
      (= op 'sum) (reduce + 0 vs)
      (= op 'max) (if (empty? vs) nil (reduce (fn [a b] (if (> a b) a b)) (first vs) (rest vs)))
      (= op 'min) (if (empty? vs) nil (reduce (fn [a b] (if (< a b) a b)) (first vs) (rest vs)))
      ; An average over nothing is nil, not 0: `no data` and `zero` are
      ; different answers, and returning 0 would be a lie about an empty
      ; group.
      (= op 'avg) (if (empty? vs) nil (/ (reduce + 0 vs) (count vs)))
      :else (throw (ex-info (str "unknown aggregate: " op) {:op op})))))

;; ── applying them to a result set ───────────────────────────────────

(defn aggregate
  "Fold `bindings` into result tuples per `find-elements`.

   `bindings` are the raw binding maps from the engine \u2014 NOT the
   projected tuples, because an aggregate needs the variable's value in
   every row, including rows that project identically.

   That distinction matters: `[:find ?city (count ?e)]` over two people
   in London must count TWO, even though both rows project to
   `[\"London\"]` before aggregation. Aggregating after projection would
   collapse them first and count one."
  [find-elements bindings]
  (let [group-vars (grouping-variables find-elements)
        groups (group-by (fn [b] (mapv (fn [v] (get b v)) group-vars)) bindings)]
    (set (mapv (fn [entry]
                 (let [key (key entry)
                       rows (val entry)]
                   (mapv (fn [element]
                           (if (aggregate-form? element)
                             (apply-aggregate (aggregate-op element)
                                              (mapv (fn [b]
                                                      (get b (aggregate-variable element)))
                                                    rows))
                             ; a grouping variable: its value is the same
                             ; for every row in the group by construction
                             (get (first rows) element)))
                         find-elements)))
               (seq groups)))))

(defn validate-find
  "Problems with aggregate usage in `:find`, as data."
  [find-elements]
  (filterv some?
           (mapv (fn [element]
                   (cond
                     (datom.query.parse/variable? element) nil
                     (aggregate-form? element)
                       (if (datom.query.parse/variable? (aggregate-variable element))
                         nil
                         {:error :aggregate-needs-a-variable :element element})
                     (list? element)
                       {:error :unknown-aggregate :element element}
                     :else {:error :unsupported-find-element :element element}))
                 find-elements)))
