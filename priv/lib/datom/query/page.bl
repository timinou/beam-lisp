;; Ordered query pages over existing indexes. Closed admission, bounded physical
;; work, complete retraction groups, and server-held cursor provenance.
(ns datom.query.page
  (:require [datom.db :as db] [datom.store :as store] [datom.index :as index]
            [datom.schema :as schema] [datom.query.parse :as parse]
            [datom.query.plan :as plan] [datom.cache-validity :as validity]
            [datom.query.engine :as engine] [datom.query.relation :as relation]
            [data.bounded-cache :as cache] [datom.compound :as compound]))

(defn- resolve-term [bindings term]
  (if (parse/variable? term) (get bindings term) term))

(defn- descriptor [query database inputs order]
  (let [p (parse/parse query) forms (parse/input-forms p)
        where (:where p) [ov direction] order
        ordered (first (filterv (fn [c] (and (parse/pattern-clause? c)
                                           (= ov (nth c 2 nil)))) where))
        root (first ordered) attr (get ordered 1)
        s (db/schema-of database)
        bindings (zipmap forms inputs)
        physical (compound/path database where bindings root attr)]
    (when (and (empty? (parse/validate p)) (= :relation (parse/find-kind p))
               (every? parse/variable? (:find p))
               (<= 1 (count where) 16) (= (count forms) (count inputs))
               (every? parse/variable? forms)
               (parse/variable? root) (parse/variable? ov)
               ;; Relation pages need an injective projection. Projecting the
               ;; entity root proves row uniqueness without retaining an
               ;; unbounded cross-page seen set for arbitrary value projections.
               (some (fn [v] (= root v)) (:find p))
               (contains? #{:asc :desc} direction)
               (or physical (schema/indexed? s attr)) (not (schema/many? s attr))
               (= :current (:filter-mode database)) (nil? (:since-t database))
               (nil? (:valid-at database)) (nil? (:valid-between database))
               (every? (fn [c] (and (parse/pattern-clause? c) (<= 3 (count c) 4)
                                   (= root (get c 0)) (keyword? (get c 1))
                                   (schema/known? s (get c 1))
                                   (not (schema/many? s (get c 1)))
                                   (nil? (relation/relation (get c 1))))) where))
      {:parsed (assoc p :where (plan/order-clauses (conj (set forms) root) where))
       :root root :order-var ov :attr attr
       :direction direction :bindings bindings :physical physical})))

(defn- complete-attribute [database eid attr budget]
  (let [s (db/store-of database) lo (index/key-prefix :eavt eid attr)
        hi (index/prefix-end lo)]
    (loop [after nil raw [] budget budget]
      (if (or (<= (:rows budget) 0) (<= (:seeks budget) 0) (<= (:bytes budget) 0))
        {:incomplete true :budget budget}
        (let [p (store/ordered-page s lo after hi (min 1024 (:rows budget)) :asc (:bytes budget))
              budget (-> budget (update :rows - (count (:datoms p))) (update :seeks dec)
                         (update :bytes - (or (:bytes p) 0)))
              raw (into raw (:datoms p))]
          (cond
            (:refused p) {:refused (:refused p) :budget budget}
            (:byte-limited? p) {:incomplete true :budget budget}
            (:end? p) {:datoms (db/filter-datoms database raw) :budget budget}
            :else (recur (:last p) raw budget)))))))

(defn- evaluate [database spec eid value budget]
  (let [initial (engine/unify-term (:bindings spec) (:root spec) eid)
        initial (when initial (engine/unify-term initial (:order-var spec) value))]
    (loop [clauses (:where (:parsed spec)) bindings initial read {} budget budget]
      (cond
        (nil? bindings) {:budget budget}
        (empty? clauses)
          {:row (mapv (fn [v] (get bindings v)) (:find (:parsed spec))) :budget budget}
        :else
          (let [c (first clauses) a (get c 1)
                r (if (contains? read a) {:datoms (get read a) :budget budget}
                    (complete-attribute database eid a budget))]
            (if (or (:incomplete r) (:refused r)) r
              (recur (rest clauses)
                     (first (keep (fn [d] (engine/unify-pattern bindings c d)) (:datoms r)))
                     (assoc read a (:datoms r)) (:budget r))))))))

(defn- save-cursor [context position rows expires]
  (let [token (crypto/strong_rand_bytes 24)]
    (when (cache/put! :datom.query.cursors token context
                     {:position position :rows rows :expires-at expires}) token)))

(defn page
  "Execute an ordered page of an ordinary query. opts: :order-by [?v :asc|:desc],
   :limit, optional :after opaque cursor and :budget {:rows :seeks :bytes}.
   Current admission: projected entity root, indexed cardinality-one order and plain patterns on one
   entity variable (including injected owner/tenant constraints). Other shapes
   return :refused. Physical rows AND seeks are bounded; permission conditions
   run before page admission. :incomplete returns no partial page and a retry
   cursor retaining accepted rows. Cursor binds exact DB/query/inputs/order and
   optional :authorization context, with five-minute maximum lifetime."
  [query database opts inputs]
  (let [spec (descriptor query database inputs (:order-by opts))
        limit (or (:limit opts) 50) now (erlang/system_time :millisecond)
        permission-expiry (:expires-at (:authorization opts))
        valid-expiry? (or (nil? permission-expiry) (erlang/is_integer permission-expiry))
        expiry (if valid-expiry? (min (+ now 300000) (or permission-expiry (+ now 300000))) now)
        _ (when spec
            (cache/ready! :datom.query.cursors)
            (cache/ready! :datom.query.pages)
            (cache/ready! :data.cache.fingerprints))
        code (when spec (validity/definition-stamp))
        page-code (when code (BeamLisp.Env/namespace_generations (list "datom.query.page")))
        context (when (and code page-code)
                  (cache/fingerprint [(db/view-key database) query inputs (:order-by opts) (:physical spec)
                                      limit (:authorization opts) code page-code]))
        valid-token? (or (nil? (:after opts))
                         (and (erlang/is_binary (:after opts)) (= 24 (erlang/byte_size (:after opts)))))
        old (when (and (:after opts) valid-token?) (cache/lookup :datom.query.cursors (:after opts) context))
        state (:value old)
        budget (merge {:rows 4096 :seeks 4096 :bytes 8388608} (:budget opts))]
    (cond
      (not (and (erlang/is_integer limit) (<= 1 limit 1000))) {:status :refused :reason :invalid-limit}
      (nil? spec) {:status :refused :reason :unsupported-plan}
      (not (store/ordered-page-capable? (db/store-of database))) {:status :refused :reason :unbounded-substrate}
      (nil? context) {:status :refused :reason :opaque-context}
      (not valid-expiry?) {:status :refused :reason :invalid-authorization}
      (<= expiry now) {:status :refused :reason :expired-authorization}
      (not (and (erlang/is_integer (:rows budget)) (<= 1 (:rows budget) 100000)
                (erlang/is_integer (:seeks budget)) (<= 1 (:seeks budget) 100000)
                (erlang/is_integer (:bytes budget)) (<= 1 (:bytes budget) 268435456)))
        {:status :refused :reason :invalid-budget}
      (or (not valid-token?) (and (:after opts) (or (not (:hit? old)) (<= (:expires-at state) now))))
        {:status :refused :reason :invalid-cursor}
      :else
        (let [s (db/store-of database)
              physical (:physical spec)
              physical-attr (or (:attr physical) (:attr spec))
              lo (if (contains? (:bindings spec) (:order-var spec))
                   (index/key-prefix :avet physical-attr
                     (if physical [(:scope physical) (get (:bindings spec) (:order-var spec))]
                       (get (:bindings spec) (:order-var spec))))
                   (or (:lo physical) (index/key-prefix :avet physical-attr)))
              hi (index/prefix-end lo)
              expires (min expiry (or (:expires-at state) expiry))
              page-key [context (:position state) (or (:rows state) [])]
              retained (cache/lookup :datom.query.pages page-key context)
              cached (:value retained)
              stable-code? (fn []
                             (and (= code (validity/definition-stamp))
                                  (= page-code (BeamLisp.Env/namespace_generations
                                                 (list "datom.query.page")))))
              reuse? (and (:hit? retained) (> (:expires-at cached) now)
                          (stable-code?))
              finish (fn [status rows position more?]
                       (if (<= expires (erlang/system_time :millisecond))
                         {:status :refused :reason :expired-authorization}
                         (let [cursor (when more? (save-cursor context position
                                                              (if (= status :incomplete) rows []) expires))]
                           (if (and more? (nil? cursor)) {:status :refused :reason :cursor-capacity}
                             (do
                               ;; Retain completed data and physical continuation,
                               ;; never an opaque token that can be evicted. A hit
                               ;; mints a fresh provenance-checked cursor below.
                               (when (and (= status :exact) (not reuse?) (stable-code?))
                                 (cache/put! :datom.query.pages page-key context
                                   {:rows rows :position position :more? more?
                                    :expires-at expires}))
                               {:status status :rows (if (= status :exact) rows [])
                                :after cursor :more? more?})))))]
          (if reuse?
            (finish :exact (:rows cached) (:position cached) (:more? cached))
          (loop [position (:position state) rows (or (:rows state) []) budget budget]
            (cond
              (= limit (count rows)) (finish :exact rows position true)
              (or (<= (:rows budget) 0) (<= (:seeks budget) 0) (<= (:bytes budget) 0)) (finish :incomplete rows position true)
              :else
                (let [p (store/ordered-page s lo position hi 1 (:direction spec) (:bytes budget))
                      budget (-> budget (update :rows - (count (:datoms p))) (update :seeks dec)
                                 (update :bytes - (or (:bytes p) 0)))
                      candidate (first (:datoms p))]
                  (cond
                    (:refused p) {:status :refused :reason (:refused p)}
                    (:byte-limited? p) (finish :incomplete rows position true)
                    (nil? candidate) (finish :exact rows position false)
                    :else
                    (let [eid (index/-e candidate)
                          stored-value (index/-v candidate)
                          value (if physical (second stored-value) stored-value)
                          evaluated (evaluate database spec eid value budget)
                          prefix (index/key-prefix :avet physical-attr stored-value eid)
                          ;; Whole EAVT group proves current visibility. All AVET
                          ;; versions of this exact [value entity] are redundant.
                          next (if (= :desc (:direction spec)) prefix (index/prefix-end prefix))]
                      (cond
                        (:refused evaluated) {:status :refused :reason (:refused evaluated)}
                        (:incomplete evaluated) (finish :incomplete rows position true)
                        :else (recur next (if (:row evaluated) (conj rows (:row evaluated)) rows)
                                     (:budget evaluated)))))))))))))
