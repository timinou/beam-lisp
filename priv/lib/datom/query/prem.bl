; datom/query/prem.bl — PreM: pushing extrema (min/max) into recursion.
;
; ── The idea (Zaniolo et al.) ─────────────────────────────────────────
;
; The natural way to write shortest-path or connected-components in Datalog
; is STRATIFIED: compute every path cost recursively, THEN take the min in
; an outer query.
;
;   path(Y,D)  :- edge(source,Y,D).
;   path(Y,D)  :- path(X,Dx), edge(X,Y,W), D = Dx + W.
;   shortest(Y, min<D>) :- path(Y,D).       ; outer stratum
;
; On a cyclic graph the recursive `path` relation is INFINITE (a cycle keeps
; adding cost), so the stratified program does not terminate. PreM's move:
; push the min INTO the recursion so only the best cost per node survives
; each round — the relation stays finite and converges.
;
;   path(Y, min<D>) :- edge(source,Y,D).
;   path(Y, min<D>) :- path(X,Dx), edge(X,Y,W), D = Dx + W.
;
; ── How this engine realises it ───────────────────────────────────────
;
; The recursive-rules engine (datom.query.rules) materialises a relation as
; a SET of tuples. PreM adds a per-round REDUCTION: after each fixpoint
; round, collapse the relation to the extremum value per group key, so a
; node keeps only its best cost. This is the monotone-aggregate-in-recursion
; of the literature, realised as a reduction hook rather than a new engine.
;
; This module provides the reduction (`min-by-key` / `max-by-key`) and a
; `converge` driver that iterates "derive one round → reduce to extrema →
; repeat until stable". Same one-representation principle as magic.bl: it
; operates on the rule engine's own relation tuples, composing rather than
; forking.

(ns datom.query.prem)

(defn min-by-key
  "Reduce a set of `[key value]` tuples to the MIN value per key. `key-cols`
   selects the grouping columns (default [0]); `val-col` the value (default
   1). Returns the reduced set of tuples."
  [tuples key-cols val-col]
  (let [best (reduce (fn [m t]
                       (let [k (mapv (fn [c] (get t c)) key-cols)
                             v (get t val-col)
                             cur (get m k)]
                         (if (or (nil? cur) (< v (get cur val-col)))
                           (assoc m k t)
                           m)))
                     {}
                     (to-list tuples))]
    (into [] (vals best))))

(defn max-by-key
  "Reduce `[key value]` tuples to the MAX value per key."
  [tuples key-cols val-col]
  (let [best (reduce (fn [m t]
                       (let [k (mapv (fn [c] (get t c)) key-cols)
                             v (get t val-col)
                             cur (get m k)]
                         (if (or (nil? cur) (> v (get cur val-col)))
                           (assoc m k t)
                           m)))
                     {}
                     (to-list tuples))]
    (into [] (vals best))))

(defn converge
  "Iterate `step` (a function `relation -> relation` deriving one round of
   new tuples from the current relation) with a PreM reduction between
   rounds, until the reduced relation stops changing.

   `reduce-fn` is the extremum reduction (min-by-key / max-by-key partially
   applied). `init` is the seed relation. Returns the converged relation.

   This is the monotone-aggregate fixpoint: because the reduction keeps only
   the best value per key, a cyclic graph that would make the raw relation
   grow without bound instead settles — each node's cost can only DECREASE
   (for min), and it is bounded below, so it stabilises.

   `max-rounds` guards against a non-convergent (non-monotone) misuse."
  [step reduce-fn init max-rounds]
  (loop [rel (reduce-fn init) rounds 0]
    (if (>= rounds max-rounds)
      rel
      (let [derived (step rel)
            combined (reduce-fn (into (into [] rel) (into [] derived)))]
        (if (= (set (into [] combined)) (set (into [] rel)))
          rel
          (recur combined (+ rounds 1)))))))
