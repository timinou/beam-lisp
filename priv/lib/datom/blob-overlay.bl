; datom/blob-overlay.bl — speculative bytes, for `with`.
;
; `datom.conn/with` applies a transaction against an overlay of the store so
; the base is never touched. A file datom in a speculative transaction has a
; body, and that body must be just as speculative: the `db-after` value must
; resolve it, and the real blob store must never learn it existed. Same idea
; as store-overlay, for bytes: puts land in a private buffer, reads consult
; the buffer then fall through.
;
; Delete throws — GC never runs inside a speculation.

(ns datom.blob-overlay
  (:require [datom.blob]))

(defrecord BlobOverlay [base buffer])            ; buffer: atom of {sha bytes}

(defn open
  "An overlay over `base`."
  [base]
  (->BlobOverlay base (atom {})))

(extend-type BlobOverlay
  datom.blob/BlobStore

  (-blob-put [bs sha bytes]
    (swap! (:buffer bs) (fn [m] (assoc m sha bytes)))
    bs)

  (-blob-get [bs sha]
    (let [b (get (deref (:buffer bs)) sha)]
      (if (nil? b) (datom.blob/-blob-get (:base bs) sha) b)))

  (-blob-has? [bs sha]
    (or (contains? (deref (:buffer bs)) sha)
        (datom.blob/-blob-has? (:base bs) sha)))

  (-blob-delete [bs sha]
    (throw (ex-info "blob delete inside a speculation" {:sha sha})))

  (-blob-shas [bs]
    (into (datom.blob/-blob-shas (:base bs)) (keys (deref (:buffer bs))))))

;; Streams follow the same read-through: a speculative body is one chunk;
;; anything else is whatever the base does.
(extend-protocol datom.blob/BlobStream
  BlobOverlay
  (-blob-stream [bs sha]
    (let [b (get (deref (:buffer bs)) sha)]
      (if (nil? b) (datom.blob/stream (:base bs) sha) (list b)))))

