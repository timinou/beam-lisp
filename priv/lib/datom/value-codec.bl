; datom/value-codec.bl — scheme-C typed value payload.
;
; ── Two encodings, one asymmetry (again) ──────────────────────────────
;
; codec.bl encodes the order-preserving KEY: its bytes must SORT, so it
; is hand-rolled (type tags, IEEE bit-twiddling, nul-escaping). This file
; encodes the VALUE slot, whose bytes are never compared, only decoded
; back into a column — so it optimises for DECODE SPEED, not order.
;
; The win it exists for: a datom's value on the durable path is
; today `term_to_binary` of the whole datom, and reading it back costs a
; `binary_to_term` per datom — ~40% of a query. A value typed by its
; attribute's `:db/valueType` needs no self-description: a `:db.type/long`
; is 8 raw little-endian bytes, decoded by a fixed-width read, and a Rust
; NIF can build a typed column from a scan with no ETF parse at all.
;
; ── The lanes ─────────────────────────────────────────────────────────
;
;   long / ref / instant  → 8 bytes, little-endian i64        (fixed)
;   boolean               → 1 byte, 0 or 1                     (fixed)
;   string / keyword      → raw UTF-8 (keyword: its name)      (variable)
;   float                 → 8 bytes, IEEE-754 little-endian    (fixed)
;   ELSE (term/bignum/nil,
;         or a value that
;         does not fit its
;         declared lane)   → 1-byte ESC tag + term_to_binary   (escape)
;
; The escape hatch is what keeps datom's promise that a value may be ANY
; BEAM term (`:db.type/term`): such a value round-trips through the BEAM's
; own serializer, handed back whole, never interpreted. It also catches a
; bignum past 64 bits and a nil in an otherwise-typed column, so the
; typed lanes stay strictly fixed-width — which is what lets the NIF build
; a contiguous column later.
;
; The FIRST BYTE of every payload is a lane tag, so decode never needs the
; schema to choose a lane — it needs the schema only to VALIDATE. This is
; deliberate: the durable value slot is self-delimiting even though the
; column it feeds is homogeneous, because a single stray value (a nil, a
; bignum) must not corrupt the read of its neighbours.

(ns datom.value-codec)

;; ── lane tags (first byte of the payload) ───────────────────────────
;;
;; Distinct from codec.bl's KEY tags: those rank for ORDER, these select a
;; DECODE. Kept in their own space so neither constrains the other.

(def LANE-LONG 1)      ; 8B LE i64  (also :db.type/ref, :db.type/instant)
(def LANE-BOOL 2)      ; 1B 0/1
(def LANE-STR 3)       ; raw UTF-8 (string)
(def LANE-KEYWORD 4)   ; raw UTF-8 (keyword name)
(def LANE-FLOAT 5)     ; 8B LE IEEE-754
(def LANE-ESC 255)     ; term_to_binary escape: any BEAM term
(def LANE-DATOM 6)     ; a stored datom [e a v tx op], packed field-wise
                       ; (see "the datom lane" below; never an ETF envelope)
;; A `:db.type/file` descriptor (datom/file.bl: 32B sha + size + media-type)
;; rides LANE-ESC today, like a vector. A packed LANE-FILE (raw sha, u64
;; size, media-type) would shave the term_to_binary framing — a contained
;; later optimisation, not a correctness matter; it is NOT a key lane.

(def INT-MAX 9223372036854775807)
(def INT-MIN -9223372036854775808)

;; ── little-endian fixed-width integer ───────────────────────────────

(defn- u64-le-bytes
  "An unsigned 64-bit integer as 8 little-endian bytes (a list)."
  [n]
  (mapv (fn [i] (rem (erlang/bsr n (* 8 i)) 256)) [0 1 2 3 4 5 6 7]))

(defn- bytes-le->u64
  "Recover an unsigned 64-bit integer from 8 little-endian bytes.

   `bytes` is a bl vector of 8 byte values (the caller lifts the erlang
   binary_to_list result into a vector so positional `get` applies)."
  [bytes]
  (reduce (fn [acc i] (+ acc (* (get bytes i) (erlang/bsl 1 (* 8 i)))))
          0
          [0 1 2 3 4 5 6 7]))

(def TWO-64 18446744073709551616)  ; 2^64
(def TWO-63 9223372036854775808)   ; 2^63

(defn- i64->u64
  "Two's-complement wrap of a signed 64-bit int into unsigned space."
  [n]
  (if (< n 0) (+ n TWO-64) n))

(defn- u64->i64
  "Interpret an unsigned 64-bit int as signed two's-complement."
  [u]
  (if (>= u TWO-63) (- u TWO-64) u))

(defn- encode-i64-le
  "A signed i64 as a binary of 8 little-endian bytes."
  [n]
  (erlang/list_to_binary (to-list (u64-le-bytes (i64->u64 n)))))

(defn- decode-i64-le
  "Recover a signed i64 from an 8-byte little-endian binary."
  [bin]
  (u64->i64 (bytes-le->u64 (into [] (erlang/binary_to_list bin)))))

;; ── float payload: reuse the BEAM's IEEE bytes ──────────────────────

(defn- encode-float-le
  "The 8 IEEE-754 bytes of `f`, little-endian.

   `term_to_binary` on a float emits a tagged envelope whose last 8 bytes
   are the big-endian IEEE double; we take those and reverse to LE so the
   Rust side reads `f64::from_le_bytes` directly."
  [f]
  (let [bytes (erlang/binary_to_list (erlang/term_to_binary f))
        ieee-be (drop (- (count bytes) 8) bytes)]
    (erlang/list_to_binary (to-list (reverse (to-list ieee-be))))))

(defn- decode-float-le
  "Recover a float from its 8 little-endian IEEE bytes.

   Rebuild the big-endian IEEE payload and wrap it in the minimal ETF
   float envelope (`131 70` = version + NEW_FLOAT_EXT) so `binary_to_term`
   reconstructs the double."
  [bin]
  (let [ieee-be (reverse (to-list (erlang/binary_to_list bin)))]
    (erlang/binary_to_term
      (erlang/list_to_binary (to-list (concat [131 70] ieee-be))))))

;; ── the escape hatch ────────────────────────────────────────────────

(defn- esc
  "Tag byte + `term_to_binary(v)`: the any-term lane."
  [v]
  (erlang/list_to_binary
    (to-list (concat [LANE-ESC]
                     (erlang/binary_to_list (erlang/term_to_binary v))))))

(defn- fits-i64?
  [n]
  (and (int? n) (<= INT-MIN n) (<= n INT-MAX)))

;; ── public: encode a value by its RUNTIME TYPE ──────────────────────
;;
;; No schema is consulted. The lane is chosen from what the value IS, and
;; decode reads it back from the lane tag — so the codec is a pure,
;; mechanical value↔bytes translation that any layer can call without the
;; schema in hand (the store, in particular, holds counters AND datoms and
;; has no schema). Type VALIDATION against `:db/valueType` is a separate
;; concern that already runs at transact time (`schema/validate-value`);
;; here every value the database accepts simply gets a faithful payload,
;; with the ESC lane catching whatever the fixed lanes cannot represent
;; (nil, a bignum past 64 bits, a composite term). Encoding is TOTAL.
;;
;; `:db.type/ref` and `:db.type/instant` are integers at rest, so they
;; ride the LONG lane; the schema — not the payload — is what tells a
;; reader they mean an entity or a moment.

(defn encode
  "Encode `v` as a scheme-C payload, choosing the lane from `v`'s runtime
   type. Total: any accepted value gets a payload (ESC for the rest)."
  [v]
  (cond
    (nil? v) (esc v)
    (= v true) (erlang/list_to_binary (to-list [LANE-BOOL 1]))
    (= v false) (erlang/list_to_binary (to-list [LANE-BOOL 0]))
    (float? v)
      (erlang/list_to_binary
        (to-list (concat [LANE-FLOAT]
                         (erlang/binary_to_list (encode-float-le v)))))
    (int? v)
      (if (fits-i64? v)
        (erlang/list_to_binary (to-list (concat [LANE-LONG]
                                                (u64-le-bytes (i64->u64 v)))))
        (esc v))                       ; bignum past 64 bits
    (string? v)
      (erlang/list_to_binary
        (to-list (concat [LANE-STR] (erlang/binary_to_list v))))
    (keyword? v)
      ; The FULL keyword string, namespace included: `str` on `:spend/model`
      ; yields `"spend/model"` (no leading colon), which `(keyword s)`
      ; reconstructs exactly. `name` would drop the qualifier.
      (erlang/list_to_binary
        (to-list (concat [LANE-KEYWORD]
                         (erlang/binary_to_list (str v)))))
    ; a tuple, map, set, list, pid — any BEAM term → the any-term lane.
    :else (esc v)))

;; ── public: decode a payload back to a value ────────────────────────

(defn decode
  "Recover the value from a scheme-C payload. The lane tag in the first
   byte selects the decode, so the schema is not consulted here — a
   payload is self-describing enough to decode, even though the column it
   came from is homogeneous."
  [payload]
  (let [size (erlang/byte_size payload)
        lane (erlang/hd (erlang/binary_to_list (erlang/binary_part payload 0 1)))
        rest-bin (if (> size 1)
                   (erlang/binary_part payload 1 (- size 1))
                   (erlang/list_to_binary (to-list [])))]
    (cond
      (= lane LANE-LONG) (decode-i64-le rest-bin)
      (= lane LANE-BOOL) (= (erlang/hd (erlang/binary_to_list rest-bin)) 1)
      (= lane LANE-STR) rest-bin
      (= lane LANE-KEYWORD) (keyword rest-bin)
      (= lane LANE-FLOAT) (decode-float-le rest-bin)
      (= lane LANE-ESC) (erlang/binary_to_term rest-bin)
      :else (throw (ex-info (str "unknown value-codec lane: " lane)
                            {:lane lane})))))

;; ── the datom lane: a stored datom, packed field-wise ───────────────
;;
;; Every datom index stores the whole datom as its value, so the value slot is
;; where a durable read spends its time. Encoded as a bare 5-vector it would
;; fall to the ESC lane and ride the BEAM's own serializer — an ETF envelope,
;; parsed back into a fresh 5-vector per row. That is the cost a columnar read
;; exists to delete: to build a typed column from a scan, the reader must not
;; parse a CONTAINER at all.
;;
;; So the datom lane packs the five fields field-wise, in the order a
;; fixed-width reader wants them:
;;
;;   LANE-DATOM | e:i64 | tx:i64 | op:u8 | a-len:u8 | a:utf8 | v:<lane payload>
;;        0        1-8     9-16      17      18      19..     19+a-len..
;;
;; e and tx sit at known offsets; `a` (a keyword, an attribute name) carries its
;; own length so that `v` — the only unbounded field — ends the payload, and the
;; reader recovers it with one `binary_part` and no delimiter search. A Rust NIF
;; reads e/tx with a single `i64::from_le_bytes` each and allocates NO term until
;; a row survives a filter — which is what makes a wide read cheap.
;;
;; `op` rides one byte (it is a boolean). A retraction is `0`, so a column read
;; can count or filter retractions with a byte comparison.
;;
;; Two composites fall to ESC instead of packing: an attribute name past 255
;; bytes, and an e/tx past i64. The lane is TOTAL, like every other.

(defn byte-at
  "The integer value of byte `i` of binary `b`."
  [b i]
  (erlang/hd (erlang/binary_to_list (erlang/binary_part b i 1))))

(defn datom-shaped?
  "Whether `v` has the shape of a datom: `[e a v tx op]` with an integer
   entity and tx, a keyword attribute, and a boolean op.

   A TOTAL test, not a guess. A user value that happens to match round-trips
   byte-for-byte through the datom lane, so misclassifying one costs bytes,
   never truth — which is why the store may apply it to any value, with no
   schema and no caller-supplied tag."
  [v]
  (and (vector? v)
       (= 5 (count v))
       (int? (get v 0))
       (keyword? (get v 1))
       (int? (get v 3))
       (or (= true (get v 4)) (= false (get v 4)))))

(defn encode-datom
  "Pack `[e a v tx op]` into the datom lane. Total: an attribute name past
   255 bytes, or an e/tx past i64, falls back to the any-term lane."
  [d]
  (let [e (get d 0)
        a (get d 1)
        tx (get d 3)
        a-bytes (erlang/binary_to_list (str a))]
    (if (and (fits-i64? e) (fits-i64? tx) (<= (count a-bytes) 255))
      (erlang/list_to_binary
        (to-list (concat [LANE-DATOM]
                         (u64-le-bytes (i64->u64 e))
                         (u64-le-bytes (i64->u64 tx))
                         [(if (get d 4) 1 0) (count a-bytes)]
                         a-bytes
                         (erlang/binary_to_list (encode (get d 2))))))
      (esc d))))

(defn decode-datom
  "Recover `[e a v tx op]` from a datom-lane payload."
  [payload]
  (let [a-len (byte-at payload 18)
        v-start (+ 19 a-len)
        v-size (- (erlang/byte_size payload) v-start)]
    [(decode-i64-le (erlang/binary_part payload 1 8))
     (keyword (erlang/binary_part payload 19 a-len))
     (decode (erlang/binary_part payload v-start v-size))
     (decode-i64-le (erlang/binary_part payload 9 8))
     (= 1 (byte-at payload 17))]))

(defn datom-v-offset
  "Where `v`'s payload starts inside a datom-lane payload.

   The columnar reader's side of the contract: a scan can locate every row's
   `v` without decoding the datom, so a filter over v's BYTES (a text search)
   never builds a term for a row it rejects."
  [payload]
  (+ 19 (byte-at payload 18)))

;; ── the storage slot: a datom lane, or any value ────────────────────
;;
;; The store holds datoms in the datom indexes and plain scalars elsewhere
;; (transaction and entity counters), so one slot codec must carry both. It
;; does that without being told which is which: a value shaped like a datom
;; takes the datom lane, everything else takes its own runtime lane.

(def LEGACY-ETF 131)   ; the ETF version byte: every pre-lane value starts here

(defn encode-slot
  "Encode a store value: the datom lane when `v` is datom-shaped, the
   value's own lane otherwise. Total for any BEAM term."
  [v]
  (if (datom-shaped? v) (encode-datom v) (encode v)))

(defn decode-slot
  "Recover a store value from a slot written by `encode-slot` — or by the
   `term_to_binary` era before it.

   The first byte discriminates and cannot be ambiguous: 131 is the ETF
   version byte, and no lane tag is 131 (they are 1..6 and 255). So rows
   written before this lane existed keep reading exactly as they did, with
   no rewrite and no migration — a durable store upgrades lazily, one
   rewritten value at a time, and a mixed keyspace is expected rather than
   exceptional."
  [b]
  (if (nil? b)
    nil
    (let [tag (byte-at b 0)]
      (cond
        (= tag LEGACY-ETF) (erlang/binary_to_term b)
        (= tag LANE-DATOM) (decode-datom b)
        :else (decode b)))))

