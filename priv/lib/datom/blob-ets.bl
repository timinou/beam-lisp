; datom/blob-ets.bl — the bytes port, in memory.
;
; The default tier for an in-memory database. An ETS `:set` from sha to
; binary: a binary of 64+ bytes is reference-counted on the BEAM, so the
; table holds a reference, not a copy — a 40 MB body costs 40 MB once.
;
; Ownership follows store-ets: the table belongs to the creating process and
; dies with it. For the development tier that is the right lifetime.

(ns datom.blob-ets
  (:require [datom.blob] [datom.blob-retention :as retention] [datom.store]))

(defrecord BlobEts [table])

(defn open
  "A fresh in-memory blob store."
  []
  ;; No :named_table option: native TID supplies identity, not a new permanent
  ;; atom for every connection. Fixed diagnostic name is safe across tables.
  (->BlobEts (ets/new :datom_blobs (to-list [:set :public]))))

(extend-type BlobEts
  datom.blob/BlobStore

  (-blob-put [bs sha bytes]
    (ets/insert (:table bs) (erlang/list_to_tuple (to-list [sha bytes])))
    bs)

  (-blob-get [bs sha]
    (let [hit (ets/lookup (:table bs) sha)]
      (if (empty? hit) nil (erlang/element 2 (first hit)))))

  (-blob-has? [bs sha]
    (ets/member (:table bs) sha))

  (-blob-delete [bs sha]
    (retention/with-delete! [:blob-ets (:table bs)] #(ets/delete (:table bs) sha))
    bs)

  (-blob-shas [bs]
    (mapv (fn [t] (erlang/element 1 t)) (to-list (ets/tab2list (:table bs))))))

;; Memory bytes die with the table. Idempotent: a table already gone stays gone.
(extend-protocol datom.store/Closeable
  BlobEts
  (-close [bs]
    (if (= :undefined (ets/info (:table bs))) nil
     (retention/with-delete! [:blob-ets (:table bs)] #(ets/delete (:table bs))))
    nil))

;; Blob bytes are an ETS table too, owned by whoever opened the connection, so
;; the same question has the same answer here.
(extend-protocol datom.store/Alive?
  BlobEts
  (-alive? [bs]
    (not= :undefined (ets/info (:table bs)))))


(extend-protocol datom.blob/BlobRetention
 BlobEts
 (-retain-blobs [bs] (retention/acquire! [:blob-ets (:table bs)]))
 (-release-blobs [bs pin] (retention/release! [:blob-ets (:table bs)] pin))
 (-blobs-retained? [bs] (retention/retained? [:blob-ets (:table bs)])))

(extend-protocol datom.blob/BlobStream
 BlobEts
 (-blob-stream [bs sha]
  (let [bytes (datom.blob/-blob-get bs sha)]
   (when bytes
    ((fn chunks [offset]
      (lazy-seq
       (when (< offset (erlang/byte_size bytes))
        (let [n (min 65536 (- (erlang/byte_size bytes) offset))]
         (cons (erlang/binary_part bytes offset n) (chunks (+ offset n))))))) 0)))))
