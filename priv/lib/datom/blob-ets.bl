; datom/blob-ets.bl — the bytes port, in memory.
;
; The default tier for an in-memory database. An ETS `:set` from sha to
; binary: a binary of 64+ bytes is reference-counted on the BEAM, so the
; table holds a reference, not a copy — a 40 MB body costs 40 MB once.
;
; Ownership follows store-ets: the table belongs to the creating process and
; dies with it. For the development tier that is the right lifetime.

(ns datom.blob-ets
  (:require [datom.blob]))

(defrecord BlobEts [table])

(defn open
  "A fresh in-memory blob store."
  []
  (->BlobEts (ets/new (keyword (str "datom_blobs_" (name (gensym "b"))))
                      (to-list [:set :public]))))

(extend-type BlobEts
  datom.blob/BlobStore

  (-blob-put [bs sha bytes]
    (ets/insert (:table bs) (erlang/list_to_tuple (to-list [sha bytes])))
    bs)

  (-blob-get [bs sha]
    (let [hit (ets/lookup (:table bs) sha)]
      (if (empty? hit) nil (erlang/element 2 (first hit)))))

  (-blob-has? [bs sha]
    (ets/member (:table bs) sha))

  (-blob-delete [bs sha]
    (ets/delete (:table bs) sha)
    bs)

  (-blob-shas [bs]
    (mapv (fn [t] (erlang/element 1 t)) (to-list (ets/tab2list (:table bs))))))
