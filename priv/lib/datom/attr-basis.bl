; datom/attr-basis.bl — the highest transaction that touched each attribute.
;
; ── Why this exists ──────────────────────────────────────────────────
;
; A derived column (the embedding corpus behind `similar-to`, a packed
; index, an HNSW graph) is a snapshot of ONE attribute's datoms. To decide
; whether it is still valid, the question is not "has the database moved?"
; but "has THIS ATTRIBUTE moved?".
;
; Asking the first question costs a full rebuild on every unrelated write:
; an audit datom, a label, a source title — none of them touch an
; embedding, and all of them advance the basis. Measured on knowledger's
; filali instance: assembling the 64 708-row embedding column costs 5.3 s
; (ETF decode) plus 2.1 s (quantise), so a rebuild per unrelated write is
; minutes of CPU during any ingest or agent run. That is why the
; application grew a hand-rolled second cache with a per-attribute
; fingerprint — the tier should have answered the question itself.
;
; ── The mechanism ────────────────────────────────────────────────────
;
; At commit time the connection already knows exactly which attributes the
; transaction wrote (`datom.broadcast/changed-attrs`, the same set the
; attribute-filtered subscriptions use). Fold those into a
; `{store → {attr → tx}}` table here, and `basis-t-for` answers the
; per-attribute question in O(1) from any db value.
;
; An attribute never written reads as the store's current basis: unknown
; is conservative (a rebuild), which is the only safe direction for a
; cache discriminator.

(ns datom.attr-basis
  (:require [datom.store] [datom.derived]))

(def ^:private TABLE :datom_attr_basis)

(defn- t2 [a b] (erlang/list_to_tuple (to-list [a b])))

(defn- table []
  (when (= :undefined (ets/info TABLE))
    ; Racy first-touch is fine: `ets/new` throws `:badarg` if a concurrent
    ; caller won, which means the table now exists — what we wanted.
    (try
      (ets/new TABLE (to-list [:set :public :named_table
                               (t2 :read_concurrency true)
                               (t2 :write_concurrency true)]))
      (catch _ :ok)))
  TABLE)

(defn- key-of
  "The store a mark is recorded AGAINST.

   A wrapper (`datom.store-overlay`, an instrumented store) keyed by its own
   record value would grow a second set of marks beside the real one — so a
   derived column built through a dry-run would look unknown to the base and
   rebuild, and a measured query would measure a cache build. The identity is
   the store at the bottom of the wrapper chain (`datom.store/identity-of`),
   asked HERE rather than at every call site, so no caller has to remember."
  [store]
  (datom.store/identity-of store))

;; ── the durable tier ─────────────────────────────────────────────────
;;
;; The marks above live in ETS, which dies with the process. That is survivable
;; for the LIVE question ("has this column changed since I built it?") but fatal
;; for the one a restart asks: a fresh VM has no marks at all, so `basis-t-for`
;; answers unknown, and unknown means rebuild — the 8.8 s corpus rebuild that a
;; durable artifact exists to avoid is forced by a missing number, not by any
;; change to the data.
;;
;; So the marks are kept in the store too, as ONE small record: `{attr → tx}`.
;; One key, rewritten per commit, INSIDE the transaction it describes (see
;; `record-ops`): a mark written after its data would leave a window where a
;; stale column looks valid, and the whole point of a mark is that it cannot lie.

(def MARK-IDENT
  "The small derived record holding every attribute's last-write transaction."
  [:datom.attr-basis])

(defn- durable-marks
  [store]
  (or (datom.derived/get-record store MARK-IDENT) {}))

(defn- hydrated?
  "Whether this store's marks have already been read from the store in THIS
   process. An EMPTY mark map counts as hydrated: the question is whether we
   have asked, not whether the answer was non-empty — otherwise every cold read
   would re-read the record forever."
  [store]
  (not (empty? (ets/lookup TABLE (t2 store :__marks_hydrated__)))))

(defn- mark-hydrated! [store]
  (ets/insert TABLE (t2 (t2 store :__marks_hydrated__) true)))

(defn hydrate!
  "Install this store's DURABLE marks into the ETS table, once per process.

   Called lazily from `basis-t-for`: a cold VM asks the store what it knows
   before concluding that it knows nothing. Idempotent and cheap after the first
   call (one ETS lookup). Returns the mark map."
  [store]
  (table)
  (let [store (key-of store)]
    (if (hydrated? store)
      (let [hit (ets/lookup TABLE store)]
        (if (empty? hit) {} (erlang/element 2 (first (to-list hit)))))
      (let [durable (try (durable-marks store) (catch _ {}))
            cur (let [hit (ets/lookup TABLE store)]
                  (if (empty? hit) {} (erlang/element 2 (first (to-list hit)))))
            ; A live mark is never LOWERED by a durable one: the ETS map is the
            ; same information with more recent writes in it.
            merged (reduce (fn [m e]
                             (let [a (get e 0) tx (get e 1)]
                               (if (and (some? (get m a)) (>= (get m a) tx)) m (assoc m a tx))))
                           cur
                           (into [] durable))]
        (ets/insert TABLE (t2 store merged))
        (mark-hydrated! store)
        merged))))

(defn record-ops
  "Record the attributes `tx` wrote, and return the store ops that make the
   record DURABLE — to be committed WITH the transaction's own ops.

   Both halves in one call on purpose. The ETS map is what the live process
   reads; the ops are what a later process reads. A caller that did only the
   first would work perfectly until a restart, and a caller that did only the
   second would rebuild on every write — so they are not two options, they are
   one write expressed twice, and the API does not offer them separately."
  [store attrs tx]
  (table)
  (let [key (key-of store)
        cur (let [hit (ets/lookup TABLE key)]
              (if (empty? hit) {} (erlang/element 2 (first (to-list hit)))))
        merged (reduce (fn [m a] (assoc m a tx)) cur attrs)]
    (ets/insert TABLE (t2 key merged))
    ; The durable half merges against what the STORE holds, not against ETS: on
    ; a cold process ETS starts empty, and writing only this transaction's attrs
    ; would erase every other attribute's mark.
    (datom.derived/put-ops MARK-IDENT
                           (reduce (fn [m a] (assoc m a tx))
                                   (durable-marks key)
                                   attrs))))

(defn note!
  "Raise the mark for `attr` to at least `tx`. Called when a cache BUILDS from
   the attribute at `tx`: whatever the column held then is what the derived
   artifact holds, so every later reader can ask a window that starts no
   earlier than this. Monotone (never lowers), so a real write recorded in
   between is not masked.

   DURABLE, and it has to be. A build is the only event that tells the store
   what a derived artifact holds — a store that has never been written through
   this code has no marks at all, so without this the artifact saved beside it
   would be rejected on every restart for ever, and the durable tier would only
   ever work for stores that also took writes. One small put per BUILD (not per
   read, not per query) is the price."
  [store attr tx]
  (table)
  (let [store (key-of store)
        cur (let [hit (ets/lookup TABLE store)]
              (if (empty? hit) {} (erlang/element 2 (first (to-list hit)))))
        known (get cur attr)
        raised (if (and (some? known) (>= known tx)) cur (assoc cur attr tx))]
    (when (not= raised cur)
      (ets/insert TABLE (t2 store raised)))
    (let [d (durable-marks store)
          d-known (get d attr)
          d-raised (if (and (some? d-known) (>= d-known tx)) d (assoc d attr tx))]
      (when (not= d-raised d)
        (datom.derived/put-record! store MARK-IDENT d-raised)))
    (or (get raised attr) tx)))

(defn basis-t-for
  "The highest transaction that touched `attr` in `store`, or `fallback`
   when nothing has been recorded (unknown ⇒ treat as changed)."
  [store attr fallback]
  (if (= :undefined (ets/info TABLE))
    fallback
    (let [store (key-of store)]
      ; A cold process has no marks; ask the STORE before concluding it knows
      ; nothing, or every restart rebuilds every derived column.
      (hydrate! store)
      (let [hit (ets/lookup TABLE store)]
        (if (empty? hit)
          fallback
          (or (get (erlang/element 2 (first (to-list hit))) attr) fallback))))))

(defn forget!
  "Drop every ETS mark — including the hydrated flags, so the next read asks the
   store again. For tests and for a store replaced under a reused handle. The
   DURABLE record is untouched: this drops the cache, not the truth."
  []
  (if (not= :undefined (ets/info TABLE)) (ets/delete_all_objects TABLE) nil)
  :ok)

(defn durable-marks-of
  "The marks the STORE holds for `store`, read directly — the durable half, for
   tests and for a caller that wants to see what a fresh process would see."
  [store]
  (durable-marks (key-of store)))
