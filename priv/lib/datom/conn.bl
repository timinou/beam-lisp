; datom/conn.bl — the connection: the one place writes happen.
;
; ── Why a single writer ───────────────────────────────────────────────
;
; A transaction must read the current state (to supersede cardinality-one
; values, to resolve upserts) and then write, indivisibly. Two concurrent
; transactions doing read-then-write would interleave and produce a
; database where an entity has two values for a one-valued attribute, or
; two entities share a unique value.
;
; Datomic solves this with a single transactor process. On the BEAM that
; is not an architectural imposition but the natural shape: a GenServer
; serialises its mailbox by construction, so transactions are atomic
; because only one runs at a time. No locks, no retries, no CAS loop.
;
; READS do not go through here. A db value holds the store directly, so
; queries run in the CALLING process, concurrently, with no contention
; — the single writer is not a bottleneck on reads.
;
; ── What the connection holds ─────────────────────────────────────────
;
; The store, the schema, and the current basis-t. That is all mutable
; state in the entire system; everything else is a value derived from it.

(ns datom.conn
  (:require [datom.current] [datom.db] [datom.index] [datom.schema] [datom.store] [datom.store-ets] [datom.store-admission :as store-admission] [datom.store-opening :as opening]
            [datom.migration-policy :as migration-policy] [datom.store-overlay] [datom.tx] [datom.broadcast] [datom.attr-basis] [env]
            [datom.blob] [datom.blob-ets] [datom.blob-fs] [datom.blob-overlay]
            [datom.file] [datom.index-coverage] [datom.text] [datom.query.rank-build] [datom.query.rank-demand] [data.bounded-cache] [proc.admission :as admission] [reload.declaration :as declaration] [reload.execution :as execution] [proc.callback :as callback] [proc.lifetime :as lifetime]))

;; ── env conveyance (PLAN-047 W1) ─────────────────────────────────────
;;
;; Every Agent action below runs in the AGENT's process, not the caller's.
;; A compiled bl fn resolves its vars (and, under the capability gate, its
;; interop rights) from the PROCESS's env binding — and the registry
;; process has none, so it reads `:global`. From a forked env (async test,
;; capped sandbox) that is two failures at once: `undefined var` crashes
;; (the caller's namespaces live under the fork's prefix), and a confused
;; deputy (the Agent holds `:global`'s caps — `:all` — and applies the
;; caller's fns with them). `convey` is the fix: capture the caller's env
;; at the call site, bind it inside the Agent. Clojure's binding
;; conveyance to agents, through the `env` namespace. Registry ROWS stay
;; shared across envs: the writer is per-STORE by design (the
;; single-transactor invariant); keying per env would let two forks claim
;; the same unique value twice.

(defn- agent-get-and-update
  "Convey the caller's environment and keep rejected decisions out of Agent
   crash semantics. An action returns {answer,next-state};an exception returns
   its original error with unchanged Agent state,then raises in the caller."
  [agent f timeout]
  (let [result (BeamLisp.Loader.Server/worker_call
                 (fn [delegate]
                  (Agent/get_and_update agent
                   (erlang/apply delegate
                    (list (fn [state]
                     (try
                      (let [decision (f state)]
                       (tuple [:ok (elem decision 0)] (elem decision 1)))
                      (catch error (tuple [:raised error] state)))))) timeout)))]
   (if (= :ok (first result)) (second result) (throw (second result)))))

;; ── id allocation ───────────────────────────────────────────────────
;;
;; Entity and transaction ids come from counters in the store itself, via
;; the port's atomic `-update`. Keeping them IN the store rather than in
;; process state means a persistent substrate resumes numbering correctly
;; after a restart — process state would forget.

; Counter keys are ENCODED BINARIES, like every other key in the store.
;
; They were bare keywords, which ETS accepted because an Erlang term is
; an Erlang term. A real storage engine takes bytes, so the moment a
; persistent backend appeared these two keys were the only things in the
; system that were not byte-comparable — and they failed at `connect`,
; before a single datom was written.
;
; The port always said keys are byte-comparable encoded terms. These
; were the exception nobody noticed, because the only substrate was one
; that did not care.
;
; The 0x00 prefix sorts them BELOW every datom key (whose first byte is
; an index tag of 1..4), so counters never appear inside an index scan.
(def ENTITY-COUNTER-KEY
  (erlang/list_to_binary (to-list [0 101])))   ; 0x00 'e'

(def TX-COUNTER-KEY
  (erlang/list_to_binary (to-list [0 116])))   ; 0x00 't'

; Transaction ids start high enough to be visually distinct from entity
; ids in a datom, the same reason Datomic partitions its id space.
(def FIRST-TX 1000000)

(defn- next-entity-id
  [store]
  (get (datom.store/-update store ENTITY-COUNTER-KEY
                            (fn [cur] (if (nil? cur) 1 (inc cur))))
       1))

(defn- next-tx-id
  [store]
  (get (datom.store/-update store TX-COUNTER-KEY
                            (fn [cur] (if (nil? cur) FIRST-TX (inc cur))))
       1))

;; ── the connection ──────────────────────────────────────────────────
;;
;; A record holding the store, the schema, and the current basis in an
;; atom. `transact!` runs its read-modify-write INSIDE the connection's
;; writer process (see below); reads never go through it.
;;
;; Serialization is NOT optional here, and the writer below provides it:
;; a transaction is a read-modify-write across several keys, so two
;; processes transacting one connection concurrently would interleave and
;; produce a database where a cardinality-one attribute holds two values.
;;
;; WHY AN AGENT AND NOT A `defserver`. Not a language limitation — an
;; earlier version of this comment claimed `defserver` could not express a
;; call carrying a payload, and that was simply wrong (FEAT-005): a
;; message pattern has always compiled into the callback's def head, so
;; `(handle-call [:transact tx-data] [_from state] …)` was always
;; writable, and a `:when` guard on it is writable now too.
;;
;; The Agent is chosen for what it OWNS, which is nothing. The writer
;; holds no state — every durable thing lives in the store, and the basis
;; lives in an atom shared through the registry — so it exists purely to
;; serialize, and losing it loses nothing. That is what lets `transact!`
;; replace a dead writer on demand (see `ensure-writer`) instead of
;; needing a supervisor, and it is why the process is neither linked nor
;; supervised. A GenServer here would be the same mailbox with a state
;; field nobody uses.
;;
;; A false rationale is worse than an undocumented choice: it tells the
;; next reader not to look.

; `schema` is an ATOM, like `basis`. Both are things the connection
; genuinely owns and genuinely changes; holding either as a plain field
; forced `install-schema!` to return a copy, which made a function whose
; name promises mutation silently pure (BUG-014). A caller who followed
; the naming convention lost their schema and learned about it later,
; from an unrelated `transact!` complaining about the data.
; `blobs` is the bytes port for `:db.type/file` values. Like the writer and
; the basis it belongs to the STORE (it lives in the registry cell), so two
; connections over one store resolve files through one blob store.
;; schema/basis atoms are writer state shared by all handles. :snapshot is an
;; extension field containing the complete immutable Db exposed to readers.
;; Private schema connections omit it, so speculative work cannot publish.
(defrecord Conn [store schema basis writer subs blobs lifetime])

(declare ensure-schema-coverage-in-writer with-canonical-writer install-native-mutation-root!
 native-command-close-root! native-command-close-sync! native-command-retirement-check!
 native-guard-anchor! native-guard-publish! native-closed-tx? native-canonical-connection! native-connection-exposure!)
(declare tuple-backfill-ops)
(declare install-schema!)
(declare migration-policy-with-reservation)
(declare sync-schema! migration-policy-claim-cell migration-policy-finish-connect!
 migration-policy-schema-change! migration-policy-datoms! migration-policy-excision!
 migration-enrollment-fail! native-schema-journal-with-turn native-schema-journal-forms! native-schema-journal-datoms! native-schema-journal-schema! native-schema-journal-protected? native-system-journal-attr?
 migration-policy-close! migration-policy-with-connect-turn)

(defn- publish-view! [conn]
  ;; A prospective schema connection has no publication cell. Its writes may
  ;; advance the internal counter, but readers retain the last complete view
  ;; until coverage and schema installation have both succeeded.
  (when-let [view (:snapshot conn)]
    (reset! view (datom.db/db-value (:store conn) @(:schema conn) @(:basis conn) (:blobs conn)))))

(defn- check-schema-publication! [conn]
  (when (and (:schema-publication conn) @(:schema-publication conn)
             (not (:prospective-schema conn)))
    (throw (ex-info "schema publication is incomplete; retry the schema operation before writing"
                    {:reason :incomplete-schema-publication}))))

(defn- begin-schema-publication! [conn after]
  (when-let [fence (:schema-publication conn)]
    (when (and @fence (not= @fence after))
      (throw (ex-info "retry the incomplete schema operation before installing a different schema"
                      {:reason :incomplete-schema-publication})))
    (reset! fence after)))

(defn- finish-schema-publication! [conn]
  (when-let [fence (:schema-publication conn)] (reset! fence nil)))

;; ── the cross-node PubSub resolver ──────────────────────────────────
;;
;; The cluster path is OPT-IN and configured, exactly like
;; spell/server.ex's `Application.get_env(:beam_lisp, :spell_pubsub)`. A
;; store with no web stack — a plain `mix run` script, a test — has none,
;; and that is not an error: `nil` means local-only. Losing a subscriber
;; because no cluster transport was configured would be a spectacular
;; trade against a database that is otherwise perfectly functional.
(defn- pubsub-server
  "The configured Phoenix.PubSub server as `{:server name}`, or nil."
  []
  (let [name (Application/get_env :beam_lisp :datom_pubsub)]
    (if (nil? name) nil {:server name})))

(defn- publish-report! [conn report]
  (if-let [pending (:pending-reports conn)]
    (swap! pending conj report)
    (datom.broadcast/publish! (:subs conn) (pubsub-server) report)))

(defn- flush-reports! [conn pending]
  (doseq [report @pending] (publish-report! conn report)))

;; ── the single writer ───────────────────────────────────────────────
;;
;; Every write for a connection runs INSIDE one process, one at a time.
;;
;; This is not a lock bolted on afterwards. It is the shape the whole
;; design already assumed: `datom.store/-update` on the ETS substrate is
;; a plain read-modify-write, documented as safe only under a single
;; writer, and the transaction itself is a read-modify-write across
;; several keys (the entity counter, the tx counter, the indexes) that no
;; store port can make atomic as a unit.
;;
;; Without it, twenty concurrent transactions produced five distinct
;; transaction ids, colliding entity ids, and seven entities all claiming
;; one `:db.unique/identity` value — uniqueness is checked by reading the
;; index and then writing, and two processes can both read `absent`.
;;
;; An Agent is exactly the right primitive: it is a process whose only
;; job is to hold something and serialize access to it. The BEAM answer
;; to a race is not a mutex, it is a process that owns the thing.
;;
;; READS DO NOT GO THROUGH HERE. `db` builds a value from the basis atom
;; and never blocks, so ten thousand readers proceed in parallel while
;; writes queue behind one another — which is the correct asymmetry for a
;; database whose central claim is that a database is a value.

(def REGISTRY :datom-conn-registry)

(def GUARD-REGISTRY :datom-guard-registry)

(defn- guard-registry
  "The process-wide map from a store key to its transaction GUARDS: a map
   `{store-key {guard-name pred}}` where each `pred` is `(fn [report] -> nil |
   problems)`. A guard runs in the writer over the fully-resolved speculative
   report BEFORE the real commit; a non-nil result aborts the transaction.
   Named like the connection registry so the lookup is race-safe."
  []
  (let [existing (erlang/whereis GUARD-REGISTRY)]
    (if (= :undefined existing)
      (let [started (Agent/start (fn [] {})
                                 (to-list [(->tuple-2 :name GUARD-REGISTRY)]))]
        (if (= :ok (erlang/element 1 started))
          (erlang/element 2 started)
          (erlang/element 2 (erlang/element 2 started))))
      existing)))

(defn- registry
  "The process-wide map from a store to its writer and basis.

   Two connections over the SAME store are two views of ONE database,
   and they must share both. When they did not, each got a private
   writer (so a unique value could be claimed twice, once per writer)
   and a private basis (so a write committed through one connection was
   invisible through the other — not stale, INVISIBLE, because the
   other basis had never advanced past it).

   Registered by name so the lookup is race-safe: two processes calling
   `connect-with` at once both reach the same Agent, because
   `Agent/start` with a `:name` fails with `already_started` for the
   loser rather than creating a second one."
  []
  (let [existing (erlang/whereis REGISTRY)]
    (if (= :undefined existing)
      (let [started (Agent/start (fn [] {})
                                 (to-list [(->tuple-2 :name REGISTRY)]))]
        (if (= :ok (erlang/element 1 started))
          (erlang/element 2 started)
          ; Lost the race — the winner's pid is in the error.
          (erlang/element 2 (erlang/element 2 started))))
      existing)))

(defn- ->tuple-2
  [a b]
  (erlang/list_to_tuple (to-list [a b])))

(defn- resolve-blobs
  "The blob store a `connect-with` call asks for: an explicit BlobStore, the
   `:tmp` shorthand (a fresh directory under the system temp dir), or the
   store's own default when nothing was requested."
  [store requested]
  (cond
    (nil? requested) (or (datom.blob/default-for store) (datom.blob-ets/open))
    (= requested :tmp) (datom.blob-fs/open :tmp)
    :else requested))

(defn- lifetime-cell [cell]
  ;; Older registry rows already share a basis atom: preserve that identity.
  (if (and cell (nil? (:lifetime cell)))
    (assoc cell :lifetime (atom :open)) cell))

(defn- lifetime-conn [conn]
  "Adopt the lifetime of an older handle only when its basis identity matches.
   A stale handle must never adopt a newly opened connection over the same store."
  (if (:lifetime conn) conn
    (let [life (agent-get-and-update
                (registry)
                (fn [reg]
                  (let [k (store-key (:store conn)) cell (get reg k)]
                    (if (and cell (= (:basis conn) (:basis cell)))
                      (let [current (lifetime-cell cell)]
                        (->tuple-2 (:lifetime current) (assoc reg k current)))
                      (->tuple-2 (atom :closed) reg))))
                30000)]
      (assoc conn :lifetime life))))

(defn- store-cell
  "The `{:writer pid :basis atom :subs :blobs}` shared by every connection
   over `store`, created once.

   `Agent/get_and_update` does the check-and-create in ONE serialized
   step, so two connections opening the same store concurrently cannot
   both decide it is absent.

   `requested-blobs` is what THIS caller asked for (nil = no opinion). The
   blob store is configured exactly once, when the cell is created: a later
   connection with no opinion inherits it, and a later connection asking
   for a DIFFERENT one is refused. Bytes must have one home per database;
   a second tier would silently split the files between two places."
  [store initial-basis initial-schema requested-blobs]
  (let [origin (BeamLisp.Env/assert_execution_context!)
        graph (execution/current)
        migration-permit (Process/get :datom.conn/migration-connect)
        creation-custody {:owner (erlang/self) :ticket (erlang/make_ref)
                          :origin (when origin (select-keys origin [:application-id :scope :digest]))}
        creator (when (execution/owned?)
                  (select-keys graph [:application-id :scope :digest]))]
  (let [result (agent-get-and-update
    (registry)
    (fn [reg]
      (let [unclaimed reg claim (opening/claim reg store creator) creator (:creator claim) reg (:cells claim)
            k (store-key store)
            hit (lifetime-cell (get reg k))
            hit (if (and hit (nil? (:schema hit)))
                  (assoc hit :schema (atom initial-schema)
                    :snapshot (atom (datom.db/db-value store initial-schema @(:basis hit) (:blobs hit)))) hit)
            hit (if (and hit (nil? (:schema-publication hit)))
                  (assoc hit :schema-publication (atom nil)) hit)
            reg (if hit (assoc reg k hit) reg)]
        (if (some? hit)
          (if (not= :open @(:lifetime hit))
            (->tuple-2 {:error {:reason :connection-closing}} unclaimed)
           (if (and (some? requested-blobs)
                   (not (= requested-blobs :tmp))
                   (not (= requested-blobs (:blobs hit))))
            (->tuple-2 {:error {:configured (:blobs hit) :requested requested-blobs}} unclaimed)
            (->tuple-2 (assoc hit :opening-guardians (:guardians claim)) reg)))
          (let [path (when (erlang/is_map store) (maps/get :path store nil))
                _ (doseq [[_ gate] (get reg :datom.conn/guard-admissions {})]
                    ;; Refusal only: root containment never confers creator or
                    ;; guard authority. The same Agent turn serializes this
                    ;; check with gate installation and actual cell creation.
                    (when (or (and creator (= (:application-id creator) (:application-id gate)))
                              (and (:root gate) (string? path)
                                   (migration-policy/under-root? (:root gate) (Path/expand path))))
                     (throw (ex-info "Store admission is reserved by native activation"
                                     {:kind :guard-store-admission-reserved}))))
                blobs nil
                cell {:writer nil :basis (atom initial-basis)
                      :schema (atom initial-schema)
                      :schema-publication (atom nil)
                      :snapshot nil
                      :lifetime (atom :open) :guard-creator creator :creation-custody creation-custody
                      :subs (datom.broadcast/new-subs)
                      :blobs blobs}
                migration (migration-policy-claim-cell reg store cell creator creation-custody migration-permit (:queue-role claim))
                blobs (resolve-blobs store requested-blobs)
                ready (assoc (:cell migration) :writer (start-writer) :blobs blobs
                        :snapshot (atom (datom.db/db-value store initial-schema initial-basis blobs)))]
            (->tuple-2 (assoc ready :opening-guardians (:guardians claim))
                       (assoc (:cells migration) k ready))))))
    30000)]
   (opening/finish-claim! (:opening-guardians result))
   (dissoc result :opening-guardians))))

(defn- store-key
  "An identity for a store, stable across the connections that share it.

   The store record itself: two `connect-with` calls over one store are
   passed the SAME value, so it keys them together, while two separately
   opened stores differ in their table or path and key apart."
  [store]
  store)

(defn- start-writer
  []
  ; `start` and NOT `start_link`. A linked writer would take its caller
  ; down with it, and the caller is whoever happened to open the
  ; connection — usually a request process with no business dying because
  ; a different request wrote bad data.
  ;
  ; It is not supervised for the same reason it is not linked: this
  ; process holds no state. It exists to serialize, so losing it loses
  ; nothing, and `transact!` restarts one on demand. Everything durable
  ; is in the store.
  (let [started (Agent/start (fn [] :writer))]
    ; `{:ok pid}` — an Agent that fails to start is not something to
    ; paper over, since every write would then be unserialized.
    (if (= :ok (erlang/element 1 started))
      (erlang/element 2 started)
      (throw (ex-info "could not start the connection writer"
                      {:reason (erlang/element 2 started)})))))

(defn- ensure-writer
  "Resolve or replace a live writer only while this connection lifetime is open.
   A released handle cannot recreate a writer or attach to a newer connection."
  [conn]
  (let [conn (lifetime-conn conn)]
  (when (not= :open @(:lifetime conn))
    (throw (ex-info "connection has been released" {:reason :released-connection})))
  (let [current (:writer conn)]
    (if (Process/alive? current)
      current
      (let [result (agent-get-and-update
        (registry)
        (fn [reg]
          (let [k (store-key (:store conn)) cell (get reg k)]
            (cond
              (or (not= :open @(:lifetime conn)) (nil? cell)
                  (not= (:lifetime conn) (:lifetime cell)))
                (->tuple-2 :released reg)
              (Process/alive? (:writer cell)) (->tuple-2 (:writer cell) reg)
              :else (let [fresh (start-writer)]
                      (->tuple-2 fresh (assoc reg k (assoc cell :writer fresh)))))))
        30000)]
        (if (= :released result)
          (throw (ex-info "connection has been released" {:reason :released-connection}))
          result))))))

(defn- writable-context! []
  (when (= true (Process/get :datom.conn/observing))
    (throw (ex-info "Datom observation cannot mutate or release a connection"
                    {:kind :read-only-observation}))))

(defn observing
  "Run trusted synchronous observations without Datom write/close authority.
   Nested observations restore their caller's context, including on exceptions.
   A callback may read any existing connection; every writer entry refuses
   before enqueueing. This is an accidental-effect guard, not a code sandbox
   or authority for spawning actors or invoking arbitrary external effects."
  [f]
  (let [previous (erlang/put :datom.conn/observing true)]
    (try (f)
      (finally (if (= :undefined previous)
                 (erlang/erase :datom.conn/observing)
                 (erlang/put :datom.conn/observing previous))))))

(defn- guard-entries [store]
 (let [pid (erlang/whereis GUARD-REGISTRY)]
  (if (= :undefined pid) {}
   (Agent/get pid (fn [entries] (get entries (store-key store) {})) 30000))))
(defn- guard-fail! [kind] (throw (ex-info "Transaction guard ownership refused" {:kind kind})))
(defn- guard-association-mutation! [key action]
 (when (Process/get :datom.conn/guard-publication)
  (guard-fail! :guard-publication-mutation-forbidden))
 (BeamLisp.Env/with_generation_lock (tuple :datom-guard-association key)
  (fn []
   (when (Agent/get (registry) (fn [entries] (:guard-reservation (get entries key))) 30000)
    (guard-fail! :guard-association-reserved))
   (action))))
(defn- managed-guard? [entry] (and (map? entry) (= :managed-guard (:kind entry))))
(defn- guards-for [conn]
 (let [entries (guard-entries (:store conn)) managed? (declaration/managed?)
       application (:application-id (Process/get :bl_generation))]
  (mapv
   (fn [[name entry]]
    (if (managed-guard? entry)
     (do
      (when-not managed? (guard-fail! :managed-guard-context-required))
      (when-not (= application (:application-id entry)) (guard-fail! :guard-application-mismatch))
      (when-not (= (:lifetime conn) (:lifetime entry)) (guard-fail! :stale-guard-resource))
      (when-not (= name (:guard-id entry)) (guard-fail! :invalid-store-guard-registration))
      (or (:provider (declaration/lookup :guard name)) (guard-fail! :missing-guard-declaration)))
     (do
      (when managed? (guard-fail! :legacy-guard-adoption-required))
      (when-not (fn? entry) (guard-fail! :invalid-store-guard-registration))
      entry))) entries)))


(defn- with-writer
  "Run `f` inside the connection's writer process, one caller at a time.

   `Agent/get_and_update` is used rather than `Agent/update` because the
   caller needs the transaction report BACK. The Agent's own state is
   irrelevant — the process IS the lock, and its serialization is the
   only thing being borrowed.

   The timeout is generous rather than absent: a write that genuinely
   takes minutes is a bug worth surfacing, and an infinite wait would
   hide a deadlock as a hang."
  [conn f]
  (native-canonical-connection! conn)
  (when (Process/get :datom.conn/guard-publication)
    (guard-fail! :guard-publication-writer-forbidden))
  (writable-context!)
  ;; Policy ownership is checked before enqueue and again inside the writer.
  (guards-for conn)
  ; A dead writer must not disable the connection FOREVER. It holds no
  ; state — that is why it is neither linked nor supervised — so a
  ; replacement is as good as the original, and the alternative is that
  ; one `Process/exit` permanently breaks every future write on a
  ; connection whose data is perfectly intact.
  ; A transaction REJECTED by schema is an ordinary outcome, not a
  ; crash: the caller asked for something invalid and must hear so. But
  ; an exception raised inside an Agent kills the Agent and reaches the
  ; caller as an opaque `:exit`, losing the problem list that made the
  ; rejection useful — and taking the connection's writer with it, so the
  ; NEXT caller fails for an unrelated reason.
  ;
  ; So the result is returned as data and re-raised out here, in the
  ; caller's own process, where a `try` around `transact!` can see it.
  (if (or (= (erlang/self) (:writer conn))
          (= (:store conn) (erlang/get :datom.conn/writing-store)))
    ; ALREADY inside the writer. `install-schema!` ends by transacting
    ; the schema datoms, so entering the writer again would be a
    ; GenServer calling itself — `:calling_self`, which the BEAM catches
    ; as an error but which is a deadlock in every design that does not.
    ;
    ; Running `f` directly is correct rather than a workaround: the
    ; guarantee being asked for is `one writer at a time`, and this IS
    ; that writer. Re-entering would be asking a question already
    ; answered.
    (do (BeamLisp.Env/assert_execution_context!) (f))
    (with-writer-call conn f)))

(defn serialized!
  "Run a short trusted database operation in this store's writer turn.
   Reads remain snapshot-based. Nested with/transact/schema operations reuse the
   turn. Never wait for network, another actor, or a different store here. This
   serializes decisions with writes; it does not make several commits atomic."
  [conn f]
  (with-writer conn f))

(defn writer-observations
  "Read up to 256 current writer queues in one bounded registry observation.
   No writer is restarted or acquired. Each registry lifetime must match its
   handle. Replacement writers resolve from the owner cell, since immutable
   Conn records can carry old PIDs. Unavailable/slow/closed returns :unavailable
   per input; no registry is created for observation."
  [connections]
  (when-not (and (vector? connections) (<= (count connections) 256))
    (throw (ex-info "Writer observation requires a bounded connection vector"
                    {:kind :invalid-observation-budget})))
  (let [registry-pid (erlang/whereis REGISTRY)]
    (if (= :undefined registry-pid) (mapv (fn [_] {:state :unavailable}) connections)
      (try
        (let [cells (Agent/get registry-pid
                      (fn [entries] (mapv #(get entries (store-key (:store %))) connections)) 50)]
          (mapv (fn [[conn cell]]
            (let [writer (:writer cell)
                  info (when (and cell (:lifetime conn)
                              (= (:lifetime conn) (:lifetime cell))
                              (= :open @(:lifetime cell)) (erlang/is_pid writer))
                         (erlang/process_info writer :message_queue_len))]
              (if (erlang/is_tuple info) {:state :ready :queued (elem info 1)}
                {:state :unavailable}))) (mapv (fn [connection cell] [connection cell]) connections cells)))
        (catch _ (mapv (fn [_] {:state :unavailable}) connections))))))
(defn writer-observation [connection]
  (first (writer-observations [connection])))

(defn- writer-operation [conn f]
  (let [prior (erlang/put :datom.conn/writing-store (:store conn))]
    (try (guards-for conn) [:ok (f)]
      (catch e [:raised e])
      (finally
        (if (= :undefined prior)
          (erlang/erase :datom.conn/writing-store)
          (erlang/put :datom.conn/writing-store prior))))))

(defn- with-writer-call
  [conn f]
  (let [timeout-ms (Process/get :datom.conn/writer-timeout-ms 30000)
        request (admission/token (erlang/self) timeout-ms)
        parent (Process/get :bl_admission)
        migration-permit (Process/get :datom.conn/migration-connect)
        schema-journal-ticket (Process/get :datom.conn/native-schema-journal-write)
        sender (erlang/self)
        ;; Authenticate BEFORE deriving or retaining modules. A conveyed graph
        ;; alone must not acquire native managed writer/producer authority.
        generation (BeamLisp.Env/assert_execution_context!)
        _ (when (and generation (not (execution/owned?)))
            (throw (ex-info "Managed writer requires actual Source execution"
                            {:kind :unadmitted-writer-execution})))
        ;; Both waiter and writer retain the complete authenticated Source
        ;; closure. The accepted writer owns an independent ticket, so caller
        ;; timeout/death cannot revoke transitive helper code or creator proof.
        modules (concat (list (elem (erlang/fun_info f :module) 1)
                              (elem (erlang/fun_info (fn [] nil) :module) 1))
                        (:modules generation))]
    (let [original (BeamLisp.Env/retain_code! modules)]
     (try
      (BeamLisp.Env/with_owned_code_execution original
       (fn [] (BeamLisp.Env/with_owned_generation_execution
        (fn []
        ;; Resolve the current writer, not the immutable record's stale PID.
        (let [pid (ensure-writer conn)
              outcome (agent-get-and-update pid
                        (fn [state]
                          (let [r (try
                                    (let [accepted (BeamLisp.Env/run_code! original
                                                     (fn [] (BeamLisp.Env/with_owned_generation_execution
                                                      (fn [] (admission/run request parent
                                                              (fn [] (migration-policy-with-connect-turn conn migration-permit sender
                                                                (fn [] (native-schema-journal-with-turn schema-journal-ticket sender
                                                                  (fn [] (writer-operation conn f)))))))))))]
                                      (if (= :cancelled accepted)
                                        [:raised (ex-info "Queued store operation was cancelled before admission"
                                                   {:kind :admission-cancelled :operation :datom-writer})]
                                        accepted))
                                    (catch e [:raised e]))]
                            (erlang/list_to_tuple (to-list [r state]))))
                        timeout-ms)]
          (if (= :ok (first outcome)) (second outcome) (throw (second outcome))))))))
      (finally (BeamLisp.Env/release_code! original))))))

(defn connect-with
  "Open a connection over an EXISTING store.

   The store is the L1 port (`datom.store/Store`), so this is the seam a
   different substrate arrives through: a persistent engine, a networked
   one, or a wrapper that counts operations for benchmarking. Everything
   above L1 is written against the protocol and cannot tell the
   difference.

   `connect` is this with a fresh ETS store, which is the development
   substrate rather than the only one."
  ([store] (connect-with store [] {}))
  ([store schema-defs] (connect-with store schema-defs {}))
  ([store schema-defs opts]
   (writable-context!)
   (store-admission/check! (when (erlang/is_map store) (maps/get :path store nil)) store)
   (let [; RECOVER whatever the store already holds. For an in-memory
         ; store this finds nothing and the defaults stand; for a durable
         ; one it is the difference between reopening a database and
         ; silently starting a new one on top of the old.
         ;
         ; Seeding the basis unconditionally to `FIRST-TX - 1` made every
         ; existing datom INVISIBLE (their tx is above that basis) while
         ; new writes reused transaction ids that already existed — and
         ; a datom key ends in `[... tx op]`, so a colliding tx silently
         ; overwrites a different datom.
         existing-tx (datom.store/-get store TX-COUNTER-KEY)
         basis (if (nil? existing-tx) (- FIRST-TX 1) existing-tx)
         ; Schema lives in the store as datoms, so it comes back the same
         ; way. Definitions passed in are installed ON TOP, which is what
         ; lets a caller reopen and evolve in one step.
         ; Every datom about each attribute ENTITY, not just its
         ; `:db/ident`. Reading only the idents recovered the attribute's
         ; NAME and nothing else, so a cardinality-many attribute came
         ; back as cardinality-one and its values silently collapsed to
         ; whichever the scan reached last — data loss on restart, with
         ; no error anywhere.
         metadata-view (datom.db/db-value store (datom.schema/empty-schema) basis)
         attr-entities (vec (distinct (mapv datom.index/-e
                             (datom.db/filter-datoms metadata-view
                               (datom.index/scan store :aevt :db/ident)))))
         recovered (datom.schema/schema-from-datoms
                     (into [] (mapcat
                                (fn [ae]
                                  (mapv (fn [d] [(datom.index/-e d) (datom.index/-a d)
                                                 (datom.index/-v d)])
                                        (datom.db/filter-datoms metadata-view
                                          (datom.index/scan store :eavt ae))))
                                attr-entities)))
         base (merge (datom.schema/empty-schema) recovered)
         ; The writer and the basis belong to the STORE, not to this
         ; connection: a second connection over the same store is another
         ; view of one database and must share both.
         cell (store-cell store basis base (get opts :blobs))
         _ (if (some? (:error cell))
             (throw (ex-info "connection setup refused; the store is closing or its blob store is already configured"
                             (:error cell)))
             nil)
         conn (assoc (->Conn store
                      (:schema cell)
                      (:basis cell)
                      (:writer cell)
                      (:subs cell)
                      (:blobs cell)
                      (:lifetime cell)) :snapshot (:snapshot cell) :schema-publication (:schema-publication cell))]
     ; Schema is written as DATOMS as well as held as a map. The map is
     ; what every read consults — it is touched on each datom filter, so
     ; deriving it per read would be a serious regression — but the
     ; datoms are what make the database self-describing: a program can
     ; ask what attributes exist, and a schema change appears in history
     ; with a transaction and a timestamp like any other change.
     ; Only definitions the store does not already carry are written.
     ; Re-writing a recovered one would create a SECOND attribute entity
     ; for the same `:db/ident`, which is a unique attribute — so the
     ; transaction would be rejected, and reopening a database with its
     ; own schema would fail.
     (let [fresh (filterv (fn [d] (nil? (get recovered (get d :db/ident)))) schema-defs)]
       (if (empty? fresh)
         conn
         (do (install-schema! conn fresh) conn)))
     (let [existing (filterv (fn [d] (contains? recovered (:db/ident d))) schema-defs)]
       (when (seq existing) (sync-schema! conn existing)))
     ;; Older runtimes omitted tuple components from schema datoms. When the
     ;; caller supplies the authoritative definition, persist that missing
     ;; metadata once so future opens need no schema repetition. Never infer
     ;; component identity from tuple values or a private index cache.
     (let [repairs (into [] (keep (fn [d]
                                  (let [ident (:db/ident d) old (get recovered ident)
                                        attrs (:db/tupleAttrs d)]
                                    (when (and (= :db.type/tuple (:db/valueType old))
                                               (nil? (:db/tupleAttrs old)) (seq attrs))
                                      (when-let [dt (first (datom.db/datoms
                                                            (datom.db/db-value store @(:schema conn) @(:basis conn) (:blobs conn))
                                                            :avet :db/ident ident))]
                                        [:db/add (datom.index/-e dt) :db/tupleAttrs attrs])))) schema-defs))]
       (when (seq repairs) (transact! conn repairs)))
     (with-canonical-writer conn :coverage (fn [] (ensure-schema-coverage-in-writer conn)))
     (migration-policy-finish-connect! conn))))

(defn owned-connections
 "Observe actual native path-backed connections under the registry fence.
  The caller must hold its exact application graph execution. Explicit handles
  admit lifecycle-opened declared stores; dynamic stores require immutable
  creator proof for this application. No path reopening or guard adoption."
 [application-id root declared]
 (when-not (and (execution/owned?) (= application-id (:application-id (execution/current)))
                (string? root) (= root (Path/expand root)) (not= "/" root)
                (vector? declared) (<= (count declared) 32))
  (throw (ex-info "Owned store observation refused" {:kind :invalid-owned-store-scope})))
 (let [pid (erlang/whereis REGISTRY)]
  (when (= :undefined pid)
   (throw (ex-info "Owned store registry unavailable" {:kind :store-not-ready})))
  (mapv native-connection-exposure!
   (agent-get-and-update pid
   (fn [entries]
    (when (> (count entries) 100000)
     (throw (ex-info "Owned store observation bound exceeded" {:kind :store-inventory-budget})))
    (let [explicit (into {} (map (fn [connection]
                         [(store-key (:store connection)) connection]) declared))
          _ (when-not (= (count explicit) (count declared))
              (throw (ex-info "Duplicate declared connection" {:kind :ambiguous-owned-store})))
          _ (doseq [[key connection] explicit]
              (let [cell (get entries key) path (:path (:store connection))]
               (when-not (and cell (= :open @(:lifetime cell))
                              (= (:lifetime connection) (:lifetime cell))
                              (string? path) (= path (Path/expand path))
                              (String/starts_with? path (str root "/"))
                              (contains? #{nil application-id} (get-in cell [:guard-creator :application-id])))
                (throw (ex-info "Declared connection is not owned" {:kind :stale-owned-store})))))
          matches (vec (keep (fn [[store cell]]
           (when (not (contains? #{:datom.conn/guard-admissions :datom.conn/store-openings :datom.conn/migration-policies} store))
            (let [path (:path store) creator (:guard-creator cell)
                  explicit? (contains? explicit store) same? (= application-id (:application-id creator))]
             ;; Root containment is a refusal boundary, never creator authority.
             ;; Unknown rows cannot silently disappear from a complete migration
             ;; inventory. Only the exact declared native handle may borrow one.
             (when (and (:lifetime cell) (= :open @(:lifetime cell)) (string? path)
                        (String/starts_with? path (str root "/"))
                        (nil? (:application-id creator)) (not explicit?))
              (throw (ex-info "Store creator authority is unclassified"
                              {:kind :unclassified-owned-store})))
             (when (and (:lifetime cell) (= :open @(:lifetime cell)) (string? path) (String/starts_with? path (str root "/"))
                        (:application-id creator) (not same?))
              (throw (ex-info "Foreign store under application root" {:kind :foreign-owned-store})))
             (when (or explicit? (and same? (:lifetime cell) (= :open @(:lifetime cell))))
              (when-not (and (string? path) (= path (Path/expand path))
                             (String/starts_with? path (str root "/")))
               (throw (ex-info "Owned store is outside the declared root" {:kind :owned-store-outside-root})))
              (when (= :open @(:lifetime cell))
               (assoc (->Conn store (:schema cell) (:basis cell) (:writer cell)
                              (:subs cell) (:blobs cell) (:lifetime cell))
                      :snapshot (:snapshot cell) :schema-publication (:schema-publication cell))))))) entries))]
     (when (or (> (count matches) 4096)
               (not= (count matches) (count (set (map #(get-in % [:store :path]) matches)))))
      (throw (ex-info "Owned store inventory is ambiguous or too large" {:kind :owned-store-inventory-refused})))
     (tuple matches entries))) 30000))))

(defn registered-at
  "Borrow an already-open path-backed connection from this VM. Never opens a
   store, starts a second writer, changes schema, or assumes ownership. The
   existing lifetime token still fences close/reopen. Missing/ambiguous paths
   refuse; callers must wait for the application's native store initialization."
  [path]
  (when-not (and (string? path) (String/starts_with? path "/") (= path (Path/expand path)))
    (throw (ex-info "Registered store requires a normalized absolute path" {:kind :invalid-store-path})))
  (let [pid (erlang/whereis REGISTRY)
        matches (if (= :undefined pid) []
                  (Agent/get pid (fn [entries]
                    (vec (keep (fn [[store cell]]
                      (when (and (not (contains? #{:datom.conn/guard-admissions :datom.conn/store-openings :datom.conn/migration-policies} store)) (= path (:path store)) (:lifetime cell)
                                 (= :open @(:lifetime cell)))
                        (assoc (->Conn store (:schema cell) (:basis cell) (:writer cell)
                                       (:subs cell) (:blobs cell) (:lifetime cell))
                               :snapshot (:snapshot cell) :schema-publication (:schema-publication cell)))) entries)))))]
    (when-not (= 1 (count matches))
      (throw (ex-info "Managed store is not uniquely open in this VM" {:kind :store-not-ready})))
    (native-connection-exposure! (first matches))))

(defn register-observer!
 "Admit an exact observer ticket before listen/ready. Called by the observer;
  its retained SDK drain registration must be live and owned by this process.
  Admission and close share the actual connection-lifetime Agent fence."
 [conn drain-registration]
 (native-canonical-connection! conn)
 (let [conn (lifetime-conn conn) owner (erlang/self) ticket (erlang/make_ref)
       lease (:lease drain-registration) key (store-key (:store conn))]
  (when-not (and (tuple? lease) (= 3 (erlang/tuple_size lease))
                 (= owner (elem lease 1)) (callback/active? drain-registration))
   (throw (ex-info "Observer drain must be retained by its actual process"
                   {:kind :invalid-observer-registration})))
  (agent-get-and-update (registry)
   (fn [entries]
    (let [cell (get entries key)]
     (when-not (and cell (= (:lifetime conn) (:lifetime cell)) (= :open @(:lifetime cell)))
      (throw (ex-info "Observer requires an open connection lifetime" {:kind :connection-closing})))
     (let [live (into {} (filter (fn [[pid _]] (Process/alive? pid)) (:observers cell {})))]
      (when (contains? live owner)
       (throw (ex-info "Observer already registered for this lifetime" {:kind :observer-already-registered})))
      (when (>= (count live) 4096)
       (throw (ex-info "Connection observer capacity exhausted" {:kind :connection-observer-capacity})))
      (tuple ticket (assoc entries key
                     (assoc cell :observers
                      (assoc live owner {:token ticket :drain drain-registration}))))))) 30000)))

(defn unregister-observer!
 "Release only this process's exact ticket. Closing is permitted so watch
  finally cleanup can complete while release! waits outside the Agent."
 [conn token]
 (native-canonical-connection! conn)
 (let [conn (lifetime-conn conn) owner (erlang/self) key (store-key (:store conn))]
  (agent-get-and-update (registry)
   (fn [entries]
    (let [cell (get entries key) before (get-in cell [:observers owner])]
     (tuple :released
      (if (and cell (= (:lifetime conn) (:lifetime cell)) (= token (:token before)))
       (assoc entries key (update cell :observers dissoc owner)) entries)))) 30000)))

(defn- drain-observer! [pid observer]
 (let [watch (Process/monitor pid)]
  (try
   (when (Process/alive? pid)
    ;; Cancellation alone is not completion. Finally cleanup can release its
    ;; stop ticket just before exit;only the exact monitor DOWN proves drain.
    (callback/invoke! (:drain observer) [5000]))
   (receive
    [:DOWN seen :process stopped _] :when (and (= seen watch) (= stopped pid)) :drained
    (after 5000
     (throw (ex-info "Connection observer has not drained"
                     {:kind :connection-observers-draining :observer pid}))))
   (catch error
    (if (= :connection-observers-draining (:kind (ex-data error))) (throw error)
     (throw (ex-info "Connection observer drain is incomplete"
                     {:kind :connection-observers-draining :observer pid :cause (ex-data error)}))))
   (finally (Process/demonitor watch (list :flush))))))

;; Low-level existing-lifetime retention. Application enrollment/creator
;; authority is deliberately NOT inferred here. The trusted typed handler
;; boundary authenticates that separately before retaining a returned receipt.
(defn- lifetime-borrow-registry! []
 (let [pid (erlang/whereis REGISTRY)]
  (when (= :undefined pid)
   (throw (ex-info "Existing connection registry required" {:kind :connection-borrow-unavailable})))
  pid))
(defn- lifetime-borrow-store! [store]
 ;; Read raw maps only. No Lookup/Store protocol, path coercion or custom
 ;; callback can run while inspecting a caller's altered Conn. The actual
 ;; registry key later authenticates this same native store value.
 (let [tag (when (erlang/is_map store) (maps/get :__struct__ store nil))
       info (when (erlang/is_atom tag) (BeamLisp.Record/info tag))]
  (when-not
   (and (erlang/is_map store)
    (or
     (and (erlang/== info (tuple :record "datom.store-ets" "EtsStore" (list :table)))
          (= (lists/sort (maps/keys store)) (lists/sort (list :__struct__ :table)))
          (let [table (maps/get :table store)]
           (or (erlang/is_reference table) (erlang/is_atom table) (erlang/is_integer table))))
     (and (erlang/== info (tuple :record "datom.store-fjall" "FjallStore" (list :handle :path)))
          (= (lists/sort (maps/keys store)) (lists/sort (list :__struct__ :handle :path)))
          (erlang/is_reference (maps/get :handle store))
          (erlang/is_binary (maps/get :path store))
          (<= (erlang/byte_size (maps/get :path store)) 4096))))
   (throw (ex-info "Canonical raw native store required" {:kind :invalid-connection-borrow})))
  store))
(defn- lifetime-borrow-connection! [connection]
 (when-not (and (erlang/is_map connection)
                (= Conn (maps/get :__struct__ connection nil))
                (= (lists/sort (maps/keys connection))
                   (lists/sort (list :__struct__ :store :schema :basis :writer :subs
                                     :blobs :lifetime :snapshot :schema-publication)))
                (erlang/is_pid (maps/get :writer connection)))
  (throw (ex-info "Exact complete connection handle required" {:kind :invalid-connection-borrow})))
 (lifetime-borrow-store! (maps/get :store connection))
 connection)
(defn- lifetime-borrow-identity? [connection cell]
 ;; Full static native identity also remains meaningful after writer failure.
 (let [custody (:creation-custody cell)]
  (and cell (= (:lifetime connection) (:lifetime cell))
       (= (:basis connection) (:basis cell)) (= (:schema connection) (:schema cell))
       (= (:subs connection) (:subs cell)) (= (:blobs connection) (:blobs cell))
       (= (:writer connection) (:writer cell))
       (= (:snapshot connection) (:snapshot cell))
       (= (:schema-publication connection) (:schema-publication cell))
       (erlang/is_map custody) (= #{:owner :ticket :origin} (set (keys custody)))
       (erlang/is_pid (:owner custody)) (erlang/is_reference (:ticket custody)))))
(defn- lifetime-borrow-cell? [connection cell]
 (and (lifetime-borrow-identity? connection cell)
      (= :open @(:lifetime cell)) (Process/alive? (:writer cell))))
(defn- lifetime-borrow-receipt! [receipt]
 (when-not (and (erlang/is_tuple receipt) (= 6 (erlang/tuple_size receipt))
                (= :datom.conn/retained-lifetime (elem receipt 0))
                (erlang/is_reference (elem receipt 3))
                (erlang/is_reference (elem receipt 4)) (erlang/is_pid (elem receipt 5)))
  (throw (ex-info "Exact issued connection borrow required" {:kind :invalid-connection-borrow})))
 receipt)
(defn- lifetime-borrow-matches? [receipt cell row]
 (and cell row (= (elem receipt 2) (:lifetime cell))
      (= (elem receipt 3) (get-in cell [:creation-custody :ticket]))
      (= row {:ticket (elem receipt 4) :owner (elem receipt 5)
              :lifetime (elem receipt 2) :custody (elem receipt 3)})))

(defn retain-lifetime!
 "Retain one ACTUAL already-open native connection lifetime. This is only
  resource retention: it grants no application enrollment, creator authority,
  graph execution, store opening, handler publication or completed-work proof.
  Only exact complete ETS/Fjall-backed handles are admitted initially. Stale
  writer handles refuse; no normalization or implicit writer restart occurs.
  The SDK handler must validate those independently and keep this opaque receipt
  private until its accepted work drains. Dead owners are NOT auto-released.
  At most128 active tickets per lifetime. No callback or writer RPC runs inside
  the existing registry decision; closed/legacy/replaced resources refuse."
 [connection]
 (let [connection (lifetime-borrow-connection! connection)
       pid (lifetime-borrow-registry!) key (store-key (maps/get :store connection))
       owner (erlang/self) ticket (erlang/make_ref)]
  (agent-get-and-update pid
   (fn [entries]
    (let [cell (get entries key) borrowers (:lifetime-borrowers cell {})]
     (when-not (lifetime-borrow-cell? connection cell)
      (throw (ex-info "Connection lifetime cannot be retained" {:kind :connection-borrow-unavailable})))
     (when (>= (count borrowers) 128)
      (throw (ex-info "Connection borrow capacity exhausted" {:kind :connection-borrow-capacity})))
     (let [custody (get-in cell [:creation-custody :ticket])
           receipt (tuple :datom.conn/retained-lifetime key (:lifetime cell) custody ticket owner)
           row {:ticket ticket :owner owner :lifetime (:lifetime cell) :custody custody}]
      (tuple receipt (assoc entries key
                       (assoc cell :lifetime-borrowers (assoc borrowers ticket row))))))) 30000)))

(defn lifetime-borrow-active?
 "Point-in-time native retention observation, never an execution/grant or a
  substitute for final typed-handler ownership checks. No registry is created."
 [receipt]
 (lifetime-borrow-receipt! receipt)
 (let [pid (erlang/whereis REGISTRY)]
  (if (= :undefined pid) false
   (Agent/get pid
    (fn [entries]
     (let [cell (get entries (elem receipt 1))
           row (get-in cell [:lifetime-borrowers (elem receipt 4)])]
      (boolean (and (lifetime-borrow-matches? receipt cell row)
                    (= :open @(:lifetime cell)) (Process/alive? (:writer cell)))))) 30000))))

(defn lifetime-borrow-state
 "Exact registry ticket PRESENCE, independent of writer/open liveness.
  :held means this exact ticket still exists; :absent means same native registry
  lifetime/custody but no such ticket; :unknown means unavailable/replaced/conflict.
  Absence alone does NOT prove prior issuance or authorize cleanup. Only an SDK
  PRIVATE previously-issued exact receipt may reconcile a lost return reply.
  A bare nominated ticket, dead holder or active? false is never that proof."
 [receipt]
 (lifetime-borrow-receipt! receipt)
 (let [pid (erlang/whereis REGISTRY)]
  (if (= :undefined pid) :unknown
   (try
    (Agent/get pid
     (fn [entries]
      (let [cell (get entries (elem receipt 1))
            row (get-in cell [:lifetime-borrowers (elem receipt 4)])]
       (cond
        (or (nil? cell) (not= (elem receipt 2) (:lifetime cell))
            (not= (elem receipt 3) (get-in cell [:creation-custody :ticket]))) :unknown
        (nil? row) :absent
        (lifetime-borrow-matches? receipt cell row) :held
        :else :unknown))) 30000)
    (catch _ :unknown)))))

(defn release-lifetime!
 "Return only an exact issued retention capability after its actual accepted
  work has drained. Possessing this opaque ticket does not prove work complete;
  the SDK issued-handler/drain boundary owns that decision. A duplicate/stale
  or edited receipt refuses; no owner-DOWN/timeout/TTL silently releases it."
 [receipt]
 (lifetime-borrow-receipt! receipt)
 (agent-get-and-update (lifetime-borrow-registry!)
  (fn [entries]
   (let [key (elem receipt 1) cell (get entries key)
         row (get-in cell [:lifetime-borrowers (elem receipt 4)])]
    (when-not (lifetime-borrow-matches? receipt cell row)
     (throw (ex-info "Connection borrow is stale" {:kind :stale-connection-borrow})))
    (let [ticket (elem receipt 4) request-row (get-in cell [:lifetime-borrow-requests ticket])]
     (when (and request-row
                (not (and (contains? #{:held :fenced} (:phase request-row))
                          (= receipt (:receipt request-row)))))
      (throw (ex-info "Request return custody conflict" {:kind :stale-connection-borrow})))
     (tuple :released
      (assoc entries key
       (cond-> (update cell :lifetime-borrowers dissoc ticket)
        request-row (assoc-in [:lifetime-borrow-requests ticket]
                      {:request (:request request-row) :phase :closed}))))))) 30000))

(defn- release-connection!
  "Forget everything the registry holds for this connection's store.

   The missing half of `connect-with`, and it is missing in a way that
   only a durable substrate makes visible.

   The registry keys a writer and a basis by the STORE, so two
   connections over one store share both — which is right, and is what
   keeps a unique value from being claimed twice. But nothing ever
   removed an entry, so every store ever opened stayed reachable from a
   named, process-wide Agent for the lifetime of the VM. On ETS that is
   a slow leak nobody notices. On a durable backend it is a FILE LOCK: the handle is
   a Rustler resource, released when the BEAM collects it, and a
   registry entry is a live reference — so a store whose owning process
   was provably dead still held its database file, and reopening the
   same path failed with a lock error naming the file.

   Found by a test that killed a store and reopened its file: the kill
   was confirmed, the process was gone, `garbage_collect` was asked for
   politely, and the lock stayed held — because the registry, not the
   dead process, was the one holding on.

   Idempotent, and safe on a store that was never registered: a caller
   releasing twice, or releasing something already gone, is asking for a
   state this brings about either way.

   NB this does NOT close the store — a port has no close, and the
   handle is freed by garbage collection once nothing refers to it. What
   it removes is the last long-lived reference the database itself
   holds."
  [conn retirement]
  (if retirement
   (native-command-retirement-check! conn retirement)
   (native-canonical-connection! conn))
  (writable-context!)
  (when (= (:store conn) (erlang/get :datom.conn/writing-store))
    (throw (ex-info "cannot release a connection inside its transaction" {:reason :release-in-writer})))
  (let [conn (lifetime-conn conn)
        k (store-key (:store conn)) releaser (erlang/self)
        owned (guard-association-mutation! k (fn [] (agent-get-and-update
                (registry)
                (fn [reg]
                  (let [cell (get reg k)]
                    (if (and cell (= (:lifetime conn) (:lifetime cell)))
                      (do
                          ;; Same serialized admission as retain-lifetime!: a
                          ;; live ticket wins before ANY closing/writer effects.
                          ;; Dead holder is uncertain custody, never completion.
                          (when (seq (:lifetime-borrowers cell))
                            (throw (ex-info "Connection borrowers have not drained"
                                            {:kind :connection-borrowers-draining
                                             :borrowers (count (:lifetime-borrowers cell))})))
                          (when (contains? (:observers cell {}) releaser)
                            (throw (ex-info "An observer cannot close its own observed connection"
                                            {:kind :release-from-observer})))
                          (migration-policy-close! reg conn retirement)
                          (reset! (:lifetime cell) :closing)
                          (->tuple-2 (select-keys cell [:writer :rank-worker :observers]) reg))
                      (->tuple-2 nil reg))))
                30000)))
        worker (:rank-worker owned) writer (:writer owned)]
    (when (and worker (Process/alive? worker)) (Process/exit worker :shutdown))
    ;; No observer is stopped while holding the registry Agent. A failed drain
    ;; leaves this exact lifetime closing,its handles intact,and may be retried.
    (doseq [[pid observer] (:observers owned)] (drain-observer! pid observer))
    ;; An unlinked process ignores exit(:normal). Stop the Agent outside the
    ;; registry action, so a finishing transaction can itself consult registry.
    (when (and writer (Process/alive? writer))
      (try (Agent/stop writer :normal 30000)
           (catch e (when (Process/alive? writer) (throw e)))))
    ;; Guard keys and profiling wrappers also retain native handles. Retire
    ;; those owners before allowing a new lifetime over the same store.
    (when owned
      (datom.attr-basis/release-store! (:store conn))
      (let [guards (erlang/whereis GUARD-REGISTRY)]
        (when (not= :undefined guards)
          (guard-association-mutation! k (fn [] (Agent/update guards (fn [reg] (dissoc reg k)) 30000)))
          ;; Removing a key does not collect the old Agent state or callback.
          ;; A quiet registry otherwise pins its native resource indefinitely.
          (erlang/garbage_collect guards)))
      ;; Optional instrumentation must not load a profiler in ordinary apps.
      ;; A deferred require is not an active profiler. fetch_exact initializes
      ;; declared providers; even a registered function may have deferred init.
      (when (BeamLisp.Env/ns_ready? "datom.profile")
        (let [cleanup (BeamLisp.Env/lookup (tuple "datom.profile" "release-store!"))]
          (when (and (tuple? cleanup) (= :ok (elem cleanup 0)))
            (BeamLisp.Ns.Rt/invoke (elem cleanup 1) (list (:store conn)))))))
    (agent-get-and-update
      (registry)
      (fn [reg]
        (let [cell (get reg k)]
          (reset! (:lifetime conn) :closed)
          (->tuple-2 :ok (if (= (:lifetime conn) (:lifetime cell)) (dissoc reg k) reg))))
      30000)
    ;; The synchronous removal above is the ownership boundary. Collect only
    ;; this idle owner, outside its action and after the writer has drained.
    ;; Caller-held db values remain valid; no query pays a global GC cost.
    (erlang/garbage_collect (registry))
    :ok))

(defn release! [conn] (release-connection! conn nil))

(defn close!
  "Release the registry entry, then tear down what the store and the blob
   store OWN: an ETS table is deleted, a `:tmp` blob directory removed, a
   durable store synced and let go. Durable data on disk is never deleted.

   `release!` is the half that fixes the registry leak; this is the half
   that fixes the RESOURCE leak, for a long-lived process that opens and
   discards many databases (a test runner, a per-request scratch db). After
   this the connection — and every other connection over the same store —
   is unusable. Idempotent."
  [conn]
  (writable-context!)
  (if (= :retired (native-command-close-root! conn)) nil
   (let [protected? (native-command-close-sync! conn)]
    ;; Protected Fjall must sync while its original live Conn/writer still
    ;; exists. release! intentionally makes the retained handle unusable.
    (release! conn)
    (datom.store/close (:blobs conn))
    (when-not protected? (datom.store/close (:store conn))) nil)))

(defn connect
  "Open a connection over a fresh ETS store.

   `schema-defs` are attribute definitions installed before any data, so
   the very first transaction already knows its cardinalities."
  ([] (connect []))
  ([schema-defs] (connect schema-defs {}))
  ([schema-defs opts]
   (store-admission/check! nil)
   (let [store (datom.store-ets/open)]
    (try (connect-with store schema-defs opts)
     (catch error
      ;; This constructor owns its new table. A racing registration refusal
      ;; must not leak it into a long-lived caller. A registered lifetime may
      ;; have accepted setup work; preserve it rather than delete behind writer.
      ;; connect-with deliberately performs no borrowed-substrate cleanup.
      (let [registered (Agent/get (registry) (fn [cells] (get cells (store-key store))) 30000)]
       (when-not registered (datom.store-ets/close store)))
      (throw error))))))

(defn db
  "The current database VALUE. O(1) — it captures a basis, not data."
  [conn]
  (if-let [snapshot (:snapshot conn)] @snapshot
    (datom.db/db-value (:store conn) @(:schema conn) @(:basis conn) (:blobs conn))))

;; ── files ───────────────────────────────────────────────────────────────────
;;
;; The efficient write path is TWO-PHASE: bytes leave through `put-file!` in
;; the CALLER's process — so a hundred uploads run in parallel and the single
;; writer never blocks on I/O — and the transaction then carries a 50-byte
;; descriptor. A staged DFile (one still carrying `:body`) in transaction
;; data is the one-shot convenience for small files: the pipeline uploads it
;; before the commit.

(defn put-file!
  "Store `bytes` in the connection's blob store and return the DFile at
   rest, ready to be transacted. Runs here, in the caller's process."
  ([conn bytes] (put-file! conn bytes {}))
  ([conn bytes opts]
   (let [staged (datom.file/file bytes opts)]
     (datom.blob/-blob-put (:blobs conn) (:sha staged) (:body staged))
     (datom.file/at-rest staged))))

(defn- stage-files!
  "For every `:db.type/file` op: upload a staged body and strip it, or
   confirm an at-rest descriptor's bytes are already held. Returns the ops
   with no body anywhere in them, or throws listing every missing file.

   Runs on OPS, after validation (which still sees the body to check its
   size) and before `realize` — so cardinality-one supersession compares
   descriptors, never a staged value against its own at-rest twin. A
   retraction of a file never uploads or checks: the fact is going away.

   Runs BEFORE the index commit, so a crash between the two leaves an orphan
   blob (recoverable by the GC sweep) and never a datom pointing at nothing."
  [blobs schema ops]
  (let [file-attr? (fn [a] (= :db.type/file (datom.schema/value-type schema a)))
        outcome
        (reduce
          (fn [acc op]
            (let [a (get op 2)
                  v (get op 3)]
              (if (and (file-attr? a) (datom.file/file? v))
                (cond
                  (datom.file/staged? v)
                    (do (if (= (get op 0) :db/add)
                          (datom.blob/-blob-put blobs (:sha v) (:body v))
                          nil)
                        (assoc acc :ops (conj (:ops acc) (assoc op 3 (datom.file/at-rest v)))))
                  (or (not (= (get op 0) :db/add))
                      (datom.blob/-blob-has? blobs (:sha v)))
                    (assoc acc :ops (conj (:ops acc) op))
                  :else
                    (assoc acc :missing (conj (:missing acc)
                                              {:error :file-missing
                                               :attr a
                                               :sha (datom.file/sha-hex v)})))
                (assoc acc :ops (conj (:ops acc) op)))))
          {:ops [] :missing []}
          ops)]
    (if (seq (:missing outcome))
      (throw (ex-info "transaction rejected: file bytes not in the blob store"
                      {:problems (:missing outcome)}))
      (:ops outcome))))

(defn gc-files!
  "Sweep orphan blobs: held by the blob store, referenced by no file datom
   anywhere in history. Runs INSIDE the writer — the one place where `no
   transaction is in flight` is true — so a `put-file!` whose transaction is
   queued cannot have its bytes swept from under it."
  [conn]
  (with-canonical-writer conn :gc-files (fn []
      ;; Fail before inventory or any deletion; substrate deletion also checks
      ;; the same native pin fence, covering direct callers and admission races.
      (datom.blob/ensure-collectable! (:blobs conn))
      (let [schema (deref (:schema conn))
            file-attrs (filterv (fn [a] (= :db.type/file (datom.schema/value-type schema a)))
                                (keys schema))
            ; Every datom, assertion or retraction, at any basis: history
            ; is what keeps a retracted file's bytes alive.
            referenced (reduce (fn [acc a]
                                 (reduce (fn [s d] (conj s (:sha (datom.index/-v d))))
                                         acc
                                         (datom.index/scan (:store conn) :aevt a)))
                               #{}
                               file-attrs)
            held (datom.blob/-blob-shas (:blobs conn))
            orphans (filterv (fn [sha] (not (contains? referenced sha))) held)]
        (doseq [sha orphans] (datom.blob/-blob-delete (:blobs conn) sha))
        {:swept (count orphans) :kept (- (count held) (count orphans))}))))

(defn schema
  "The connection's published schema map."
  [conn]
  (:schema (db conn)))

(def BRANCH-REGISTRY :datom-branch-registry)

(defn- branch-registry
  "The process-wide map from a branch NAME to its overlay store: `{name store}`.
   A branch is a long-lived copy-on-write overlay over another store — a named,
   speculative what-if database. Named like the connection registry so the
   lookup is race-safe."
  []
  (let [existing (erlang/whereis BRANCH-REGISTRY)]
    (if (= :undefined existing)
      (let [started (Agent/start (fn [] {})
                                 (to-list [(->tuple-2 :name BRANCH-REGISTRY)]))]
        (if (= :ok (erlang/element 1 started))
          (erlang/element 2 started)
          (erlang/element 2 (erlang/element 2 started))))
      existing)))

(defn branch!
  "Create a named copy-on-write BRANCH off `conn`'s store and register it under
   `name`. A branch is a long-lived `store-overlay` (reads fall through to the
   base, writes stay private), so a connection opened over it (`connect-branch`)
   sees the base's data plus its own changes, and the base — the shared
   template — is never touched. This is what makes per-test isolation off one
   seeded database O(1): kontor branches a fresh book per test instead of
   re-seeding. Branches are never merged back (a what-if is discarded, not
   applied). Returns `name`."
  [conn name]
  (let [overlay (datom.store-overlay/open (:store conn))]
    (agent-get-and-update
      (branch-registry)
      (fn [reg] (->tuple-2 name (assoc reg name overlay)))
      30000)))

(defn connect-branch
  "Open a connection over the branch registered under `name`. The connection is
   an ordinary one over the branch's overlay store, so every read and write goes
   through the normal path — the overlay just keeps the writes private to the
   branch. `schema-defs` are installed if the branch does not already carry
   them. Throws when no branch is registered under `name`."
  ([name] (connect-branch name []))
  ([name schema-defs]
   (let [overlay (get (Agent/get (branch-registry) (fn [m] m)) name)]
     (if (nil? overlay)
       (throw (ex-info "no branch registered under this name" {:branch name}))
       (connect-with overlay schema-defs {})))))

(defn- excise-in-writer
  "Physically remove datoms from `conn`'s store — EVERY index and ALL of history
   — for the entities/attributes named by `specs`. Each spec is `[:entity e]`
   (all of e's datoms) or `[:attr e a]` (only e's datoms for attribute a). Runs
   inside the writer, so it serialises against every other write. Returns the
   count of raw datoms removed.

   This is EXCISION, the deliberate hole in an append-only log: unlike
   `:db/retractEntity`, which appends a tombstone and leaves history able to
   reproduce the fact, this DELETES the keys, so `as-of`/`history` can no longer
   see the datom. It exists for legal erasure (GDPR right-to-be-forgotten) and
   for shedding data an append-only store must never have kept. `docs/trust-
   boundary.md` documents the audit-guarantee exception this creates."
  [conn specs]
  (check-schema-publication! conn)
  (when (native-schema-journal-protected? (:store conn))
   (migration-enrollment-fail! :native-schema-journal-excision-refused))
  (migration-policy-excision! conn)
  (let [store (:store conn)
        schema (deref (:schema conn))
        ; the RAW datoms (assertions AND retractions, every tx) each spec names
        raw (mapcat
              (fn [spec]
                (let [kind (get spec 0) e (get spec 1)]
                  (if (= kind :attr)
                    (into [] (datom.index/scan store :eavt e (get spec 2)))
                    (into [] (datom.index/scan store :eavt e)))))
              specs)
        ops (into [] (mapcat (fn [d] (datom.index/delete-ops schema d)) raw))]
    (when (seq ops)
      (let [; A transaction id for a transaction that writes no datoms. The number
            ; is not decoration: BOTH things a derived cache compares against
            ; (`record-ops`' per-attribute marks and `note!`'s build marks) are
            ; tx ids, so an excision has to speak the same language to be able to
            ; invalidate anything. A tx with no datoms is a harmless gap in the
            ; log — ids are a counter, and a reader that scans by tx simply finds
            ; nothing there.
            tx (next-tx-id store)
            ; The attributes that LOST datoms, read off the raw datoms rather
            ; than assumed from the specs: `[:entity e]` names an entity, not its
            ; attributes, and which indexes an attribute maintains is the
            ; schema's business, not the caller's.
            attrs (datom.broadcast/changed-attrs raw)]
        ; The marks ride in the SAME commit as the deletions. A mark written
        ; after the keys have gone would leave the window this exists to close:
        ; the attribute already changed, and a column built from it still says
        ; it is valid.
        (datom.store/-commit store
          (into ops (into (datom.attr-basis/record-ops store attrs tx)
                          (concat (datom.current/excision-ops raw)
                                  (datom.current/reverse-excision-ops store raw tx)
                                  (datom.text/excision-ops store schema raw tx)
                                  (datom.query.rank-build/transaction-ops
                                    (datom.db/db-value store schema (deref (:basis conn))) raw tx false)))))
        ; And the basis advances, because not every cache can ask a
        ; per-attribute question — the rule relations memoise on the basis
        ; alone, and an excision that advanced nothing would leave them
        ; describing rows that no longer exist anywhere.
        (swap! (:basis conn) (fn [cur] (max cur tx)))
        (publish-view! conn)))
    (count raw)))

(defn excise!
  "Physically remove data, returning a report `{:excised n}`. `specs` is a list
   of `[:entity e]` / `[:attr e a]`. The removal is irreversible — the datoms
   leave every index and all of history. datahike's `:db/purge` /
   `:db.purge/entity` / `:db.purge/attribute` project onto this.

   Excision is itself a change worth recording; the caller (or the datahike
   shim) transacts an audit datom separately — excise! only does the deletion,
   through the writer so it cannot race a concurrent commit."
  [conn specs]
  (with-canonical-writer conn :excise (fn [] {:excised (excise-in-writer conn (into [] specs))})))

(defn conn-of
  "The connection behind a db VALUE.

   A db is `{store schema basis-t …}`; the store keys the connection registry,
   so this recovers the live conn (writer, basis atom, subscriber table, blob
   store) for the db's store. The db's schema is a plain value, wrapped back
   into the atom a Conn holds. Used by the datahike shim's `db-with`, whose
   datahike signature is db-scoped while datom's `with` is conn-scoped.

   Throws when the db's store has no registered connection in this VM (a db
   value outlived its conn's release)."
  [db]
  (let [store (:store db)
        cell (agent-get-and-update (registry)
               (fn [reg]
                 (let [k (store-key store) cell (lifetime-cell (get reg k))]
                   (->tuple-2 cell (if cell (assoc reg k cell) reg))))
               30000)]
    (if (or (nil? cell) (not= :open @(:lifetime cell)))
      (throw (ex-info "no live connection for this db's store" {:store store}))
      (assoc (->Conn store (:schema cell) (:basis cell) (:writer cell)
              (:subs cell) (:blobs cell) (:lifetime cell)) :snapshot (:snapshot cell) :schema-publication (:schema-publication cell)))))

(defn conns
  "Every live connection cell in this VM, one map per store:

       {:store <store record> :basis <tx> :subscribers [pid …]}

    The read-only snapshot behind the governing-process question 'what
    databases exist right now?' — the spell-app observatory lists these
    next to the schema and the live namespaces. Reads the named registry
    agent directly; never touches a writer or a subscriber."
  []
  (let [pid (erlang/whereis REGISTRY)]
    (if (= :undefined pid)
      []
      (let [reg (Agent/get pid (fn [m] m))]
        (sort-by (fn [r] (str (get r :store)))
                 (map (fn [kv]
                        (let [store (key kv)
                              cell  (val kv)]
                          {:store store
                           :basis (deref (:basis cell))
                           :subscribers (datom.broadcast/subscribers (:subs cell))}))
                      (filter migration-policy/registry-cell? (to-list reg))))))))

;; ── subscribing to the commit stream (L2) ───────────────────────────
;;
;; A subscription is a plain registration in the store's subscriber table;
;; it does NOT go through the writer, because subscribing is not a write and
;; must not queue behind one. `transact!` broadcasts to whatever the table
;; holds at commit time, so a subscription registered concurrently with a
;; write simply starts at the next commit — exactly the semantics a caller
;; wants, and the log makes any gap recoverable via `since` regardless.

(defn listen!
  "Subscribe the CALLING process to `conn`'s commit stream.

   Delivers `[:datom/tx basis tx-datoms]` (the delta) by default. `opts`:
     :attrs   #{…}   — wake only on commits touching one of these attributes
     :payload :basis — receive `[:datom/changed basis attrs]` instead

   Returns the subscriber pid (the caller). Idempotent per process."
  ([conn] (listen! conn {}))
  ([conn opts]
   (native-canonical-connection! conn)
   (if-not (native-closed-tx? (:store conn))
    (datom.broadcast/listen! (:subs conn) (erlang/self) opts)
    (let [owner (erlang/self)]
     (BeamLisp.CompilerData/check_first_order! opts {:max-nodes 4096 :max-depth 16 :max-bytes 1048576})
     (with-canonical-writer conn :listen #(datom.broadcast/listen! (:subs conn) owner opts))))))

(defn unlisten!
  "Unsubscribe the calling process (or `pid`) from `conn`."
  ([conn] (unlisten! conn (erlang/self)))
  ([conn pid]
   (native-canonical-connection! conn)
   (if-not (native-closed-tx? (:store conn)) (datom.broadcast/unlisten! (:subs conn) pid)
    (do (when-not (erlang/is_pid pid) (migration-enrollment-fail! :invalid-subscriber))
        (with-canonical-writer conn :unlisten #(datom.broadcast/unlisten! (:subs conn) pid))))))

(defn subscribers
  "The pids currently subscribed to `conn` — for tests and introspection."
  [conn]
  (datom.broadcast/subscribers (:subs conn)))

(defn install-schema!
  "Add attribute definitions to a live connection.

   Schema is data and evolves like data. Returns the connection so it
   chains. Identical definitions do not append schema metadata or advance the
   basis. Index/tuple coverage and interrupted publication are still repaired."
  [conn defs]
  ; Through the WRITER, like every other mutation. This reads the
  ; schema, mutates it, scans for backfill and commits — a
  ; read-modify-write across several keys, which no store port makes
  ; atomic as a unit.
  ;
  ; Outside the writer, eighty concurrent installs all returned
  ; successfully and all eighty definitions were live in memory, but
  ; reopening the store recovered SEVENTY-FOUR: the schema datoms raced
  ; through the non-atomic ETS counter and overwrote each other. Six
  ; acknowledged schema changes existed only until restart, which is the
  ; worst place for a schema to disagree with itself.
  (with-canonical-writer conn :install-schema (fn [] (install-schema-in-writer conn defs))))

(defn sync-schema!
  "Update the connection's in-memory schema MAP (and any newly-demanded
   index) to reflect `defs`, WITHOUT writing schema datoms.

   For a caller that already wrote the schema deltas as datoms in its own
   transaction — `datom.migrate/apply!` folds them into one atomic commit
   with the migration's data changes, so the schema change and the data
   change it guards can never be half-applied. This brings the live
   connection's read path in line with those already-durable datoms.

   Idempotent and safe to call after a crash-resume: it only installs
   into the map, and a reopened connection recovers the same map from the
   datoms regardless."
  [conn defs]
  (with-canonical-writer conn :sync-schema (fn [] (sync-schema-map-in-writer conn defs))))

(defn- backfill-newly-indexed! [store before after basis defs]
  (doseq [d defs]
    (let [a (:db/ident d)]
      (if (datom.schema/indexed? after a)
        ;; Tuples need current entity derivation in the schema transaction first.
        (when-not (seq (datom.schema/tuple-attrs after a))
          (datom.index-coverage/ensure! store after a basis
                                      (not (datom.schema/indexed? before a))))
        (datom.index-coverage/invalidate! store a)))))

(defn- tuple-backfill-ops [conn after]
  (let [store (:store conn) basis (deref (:basis conn))
        missing (filterv (fn [a] (and (seq (datom.schema/tuple-attrs after a))
                                     (not (datom.index-coverage/derived-complete? store after a basis))))
                         (keys after))
        ;; Only current source values: introducing a tuple does not invent facts
        ;; at transactions before its schema existed. Existing views stay valid.
        database (datom.db/db-value store after basis)
        touches (into [] (mapcat (fn [a]
                                  (mapcat (fn [component]
                                            (mapv (fn [d] [:db/add (datom.index/-e d) component (datom.index/-v d)])
                                                  (datom.db/datoms database :aevt component)))
                                          (datom.schema/tuple-attrs after a))) missing))
        derived (datom.tx/derive-tuple-ops store after touches)]
    (filterv (fn [op]
               (let [held (mapv datom.index/-v (datom.db/datoms database :eavt (get op 1) (get op 2)))]
                 (if (= :db/add (get op 0)) (not (some (fn [v] (= v (get op 3))) held))
                   (some (fn [v] (= v (get op 3))) held)))) derived)))

(defn- ensure-schema-coverage-in-writer [conn]
  (let [sch (deref (:schema conn)) ops (tuple-backfill-ops conn sch)]
    (when (seq ops) (transact! conn ops))
    (doseq [a (keys sch)]
      (cond (datom.schema/indexed? sch a)
              (datom.index-coverage/ensure! (:store conn) sch a (deref (:basis conn)) false)
            (seq (datom.schema/tuple-attrs sch a))
              (datom.index-coverage/mark-derived! (:store conn) sch a (deref (:basis conn)))))
    conn))

(defn- sync-schema-map-in-writer [conn defs]
  (let [before (deref (:schema conn)) after (datom.schema/install-all before defs)
        _ (native-schema-journal-schema! conn after defs)
        _ (migration-policy-schema-change! conn after)
        pending (atom [])
        shadow (assoc (dissoc conn :snapshot) :schema (atom after) :pending-reports pending :prospective-schema true)
        tuples (tuple-backfill-ops shadow after)]
    (begin-schema-publication! conn after)
    (backfill-newly-indexed! (:store conn) before after (deref (:basis conn)) defs)
    (when (seq tuples) (transact! shadow tuples))
    (doseq [d defs]
      (if (datom.schema/indexed? after (:db/ident d))
        (datom.index-coverage/ensure! (:store conn) after (:db/ident d) (deref (:basis conn)) false)
        (when (seq (datom.schema/tuple-attrs after (:db/ident d)))
          (datom.index-coverage/mark-derived! (:store conn) after (:db/ident d) (deref (:basis conn))))))
    (reset! (:schema conn) after)
    (publish-view! conn)
    (finish-schema-publication! conn)
    (flush-reports! conn pending)
    conn))

(defn- install-schema-in-writer [conn defs]
  (let [before (deref (:schema conn)) after (datom.schema/install-all before defs)
        _ (native-schema-journal-schema! conn after defs)
        _ (migration-policy-schema-change! conn after)
        changed-defs (filterv (fn [definition] (not= definition (get before (:db/ident definition)))) defs)
        pending (atom [])
        shadow (assoc (dissoc conn :snapshot) :schema (atom after) :pending-reports pending :prospective-schema true)
        tuples (tuple-backfill-ops shadow after)]
    (begin-schema-publication! conn after)
    (backfill-newly-indexed! (:store conn) before after (deref (:basis conn)) defs)
    ;; Prospective schema belongs to a private view until the atomic schema +
    ;; tuple transaction and coverage have succeeded. Readers keep the old map.
    ;; Installation is commonly repeated by independent library components.
    ;; Reasserting unchanged definitions creates duplicate attribute entities,
    ;; advances the source basis and evicts otherwise valid query certificates.
    ;; Coverage repair above and below remains unconditional: an unchanged map
    ;; is not proof that a missing index or interrupted publication completed.
    (when (or (seq changed-defs) (seq tuples))
      (transact! shadow (into tuples (mapcat (fn [d]
                                              (datom.schema/definition-datoms
                                                (next-entity-id (:store conn)) d)) changed-defs))))
    (doseq [d defs]
      (if (datom.schema/indexed? after (:db/ident d))
        (datom.index-coverage/ensure! (:store conn) after (:db/ident d) (deref (:basis conn)) false)
        (when (seq (datom.schema/tuple-attrs after (:db/ident d)))
          (datom.index-coverage/mark-derived! (:store conn) after (:db/ident d) (deref (:basis conn))))))
    (reset! (:schema conn) after)
    (publish-view! conn)
    (finish-schema-publication! conn)
    (flush-reports! conn pending)
    conn))

(declare retire-query-rank!)
(defn transact!
  "Record `tx-data`, returning a transaction report.

   The report carries what a caller needs to continue:

     :db-before   the value before this transaction
     :db-after    the value after it
     :tx          the transaction id
     :tempids     tempid -> real entity id
     :tx-datoms   exactly the datoms recorded

   Raises on a schema violation, listing EVERY problem rather than the
   first — a partially-valid transaction is never applied.

   Writes are SERIALIZED per connection: this runs inside the
   connection's writer process, one at a time. Readers are unaffected
   and never block. Optional {:timeout-ms n} changes this call's finite writer
   wait/admission budget (1 ms through 1 hour); the default remains 30 seconds.
   A timeout after admission is an unknown commit outcome, never permission to
   retry automatically. Accepted writes drain under their existing code lease."
  ([conn tx-data]
  (native-canonical-connection! conn)
  (when (native-closed-tx? (:store conn)) (datom.tx/assert-eager-closed-input! tx-data))
  (native-schema-journal-forms! (:store conn) (db conn) tx-data)
  (let [result (with-canonical-writer conn :transact (fn []
                  (Process/put :datom_rank_maintenance [])
                  (Process/put :datom_rank_maintenance_store (:store conn))
                  (Process/put :datom_rank_prepare_us 0)
                  (Process/put :datom_rank_commit_us 0)
                  (try
                   (let [report (transact-in-writer conn tx-data)]
                    {:report report :maintenance (vec (set (Process/get :datom_rank_maintenance [])))
                     :elapsed-us (+ (Process/get :datom_rank_prepare_us 0)
                                    (Process/get :datom_rank_commit_us 0))})
                   (finally
                    (doseq [key [:datom_rank_maintenance :datom_rank_maintenance_store
                                 :datom_rank_prepare_us :datom_rank_commit_us]]
                     (Process/delete key))))))]
    ;; Real commit has completed. Optional measurement and policy cannot reject
    ;; the transaction, and no cache actor is invoked inside the source writer.
    (try
     (when (seq (:maintenance result))
      (let [key (data.bounded-cache/key-data (datom.store/identity-of (:store conn)) 0)]
       (doseq [[id generation] (:maintenance result)]
        (when (datom.query.rank-demand/record-cost! key id generation
                {:kind :write :elapsed-us (:elapsed-us result)})
         (retire-query-rank! conn id generation)))))
     (catch _ nil))
    (:report result)))
  ([conn tx-data opts]
   (when-not (and (map? opts) (every? #{:timeout-ms} (keys opts)))
     (throw (ex-info "Unknown transaction option" {:kind :invalid-transaction-options})))
   (let [timeout-ms (:timeout-ms opts 30000)]
     (when-not (and (erlang/is_integer timeout-ms) (<= 1 timeout-ms 3600000))
       (throw (ex-info "Transaction timeout must be 1 through 3600000 milliseconds"
                {:kind :invalid-transaction-timeout})))
     (let [prior (erlang/put :datom.conn/writer-timeout-ms timeout-ms)]
       (try (transact! conn tx-data)
         (finally
           (if (= :undefined prior) (erlang/erase :datom.conn/writer-timeout-ms)
             (erlang/put :datom.conn/writer-timeout-ms prior))))))))
(defn load-facts!
  "Bulk-load `tx-data` — transaction data whose facts are ALREADY new in
   this conn — returning the same report `transact!` returns.

   The path for a corpus that arrives analyzed: thousands of facts of the
   shape

     [{:db/id 1001 :fn/name \"meet\" :fn/ns \"lattice\" :fn/line 42}]

   whose values are ints, strings and vectors, and whose ids name nothing
   yet. `transact!` is the general pipeline, and it answers questions this
   shape has already answered — it expands transaction functions that are
   not there, resolves tempids that are not there, asks the store what
   every `[e a]` currently HOLDS so it can supersede it, reduces the result
   to the transaction's net effect, and validates each op against the
   schema. Those questions cost an index read per operation; on a corpus
   that is milliseconds per fact.

   ── the caller's warrant ─────────────────────────────────────────────

   This path is the FAST one, not the SAFE one, and it is correct only
   while ALL of the following hold. Ensuring them is the caller's job.
   Two of them cannot be checked at any price — checking them IS the store
   scan this exists to skip — and the rest are checked and RAISE.

     1. Every `:db/id` is a real integer naming NO existing datom in this
        conn. The store is never read, so an id that already holds facts
        is not superseded: it gains a second current value where the
        attribute is cardinality-one. NOT CHECKED.
     2. No value is a tempid and no ref needs resolving. A negative id
        RAISES rather than being silently mis-resolved. CHECKED.
     3. Every attribute is KNOWN to the conn's schema, and every value is
        of its declared type. Unlike `transact!`, nothing is validated
        here, so an unknown attribute or a mistyped value is written
        as given. CHECKED for the op kind only: `:db/retract`,
        `:db/retractEntity`, `:db/cas` and `:db/fn` all need the store,
        a tempid resolution or a fn expansion to know what they mean, and
        every one of them RAISES. NOT CHECKED for the schema.
     4. No `:db.type/file` value — staging bytes is `transact!`'s.
        CHECKED.

   A caller who cannot meet these wants `transact!`, which is the floor:
   correct for ANY transaction data, and the path this one is measured
   against.

   What the two SHARE is what makes the loaded conn INDISTINGUISHABLE:
   the same expansion of map forms, the same tx-id counter, the same
   `:db/txInstant` reification of the transaction, the same single atomic
   index commit, the same monotone basis advance, and the same report
   broadcast after it. `:tempids` is `{}` — none were allocated.

   Runs inside the writer, like every other write, so a bulk load and a
   hand-written transaction against one conn serialise against each
   other."
  [conn tx-data]
  (with-canonical-writer conn :load-facts (fn [] (if (seq (guards-for conn))
                           (transact-in-writer conn tx-data)
                           (load-facts-in-writer conn tx-data)))))

(defn with
  "Speculatively apply `tx-data` and return the report that WOULD result,
   WITHOUT committing to the connection.

   The database is a value, and this is the operation that treats a
   PROSPECTIVE change as one too: `(with conn tx-data)` runs the exact
   pipeline `transact!` runs — the same expand, resolve, validate,
   realize — but against an OVERLAY of the connection's store, so the real
   store and the connection's basis are untouched. Nothing any other
   reader sees changes.

   The report carries the same keys `transact!` returns:

     :db-before   the value before (the connection's current db)
     :db-after    the value AS IF the transaction had committed
     :tx          the tx id it would have used
     :tempids     tempid -> id, for reading the speculative entities
     :tx-datoms   exactly the datoms it would have recorded

   `:db-after` is a fully-functional database value: query it, pull from
   it, feed it to another `with`. This is what `datom.migrate/plan` uses
   to dry-run a whole migration — its data transform AND its schema grow —
   against a production database and report what breaks, before deploying.

   Runs THROUGH the writer, like `transact!`: a speculation reads the
   store and allocates ids, and doing so off the writer would race a
   concurrent real transaction for the same tx id. The overlay keeps the
   WRITES speculative; the writer keeps the READS consistent.

   NB: raises on a schema violation exactly as `transact!` does — a
   speculative transaction the real one would reject is itself a useful
   answer, surfaced the same way."
  [conn tx-data]
  (with-canonical-writer conn :speculate (fn [] (with-in-writer conn tx-data))))

;; ── transaction guards (PLAN-115 B3) ────────────────────────────────────────
;;
;; A GUARD is a predicate `(fn [report] -> nil | problems)` run in the writer
;; over the fully-resolved report — `:db-before`, `:db-after` (speculative),
;; `:tx-datoms` — AFTER the transaction realizes but BEFORE it commits. A
;; non-nil result aborts the commit. This is the one seam where "every committed
;; write is validated" can be enforced without a second engine: it reuses the
;; SAME speculative `:db-after` that `with` builds, so a guard sees exactly the
;; database the transaction would produce, and refusing it means nothing was
;; written. datahike's `datahike.tx-preds/register-tx-pred!` projects onto this.

(defn- guard-resource! [conn]
 (let [conn (lifetime-conn conn)
       cell (Agent/get (registry) (fn [entries] (get entries (store-key (:store conn)))) 30000)]
  (when-not (and cell (= (:lifetime conn) (:lifetime cell)) (= :open @(:lifetime cell)))
   (guard-fail! :invalid-guard-resource))
  [conn (:guard-creator cell)]))

(defn creation-evidence!
 "Private exact native connection custody. Captured at SDK cell creation,
  never inferred from a path, caller-supplied map or later view. A same-store
  join keeps first custody. Missing legacy custody or closed/replaced lifetime
  refuses; possession of this receipt alone grants no root enrollment."
 [connection]
 ;; Inspect only exact raw native fields BEFORE guard-resource!/store-key.
 ;; Keep this public observer's existing typed refusal category.
 (try (lifetime-borrow-connection! connection)
  (catch error
   (if (= :invalid-connection-borrow (:kind (ex-data error)))
    (guard-fail! :invalid-connection-custody) (throw error))))
 (when-not (and (erlang/is_map connection)
                (= Conn (maps/get :__struct__ connection nil)))
  (guard-fail! :invalid-connection-custody))
 (let [validated (guard-resource! connection) c (first validated)
       key (store-key (:store c))]
  (Agent/get (registry)
   (fn [entries]
    (let [cell (get entries key) custody (:creation-custody cell)]
     (when-not (lifetime-borrow-cell? c cell)
      (guard-fail! :connection-custody-unavailable))
     {:resource key :connection c :lifetime (:lifetime cell)
      :creator (:guard-creator cell) :custody custody})) 30000)))

;; Initial-borrow requests. The identity is local native data BEFORE any borrow
;; mutation. It grants no Root/application/graph/worker authority. The trusted
;; SDK consumer retains its handle privately, independently of the RPC reply.
(defn prepare-lifetime-request!
 "Capture exact current native Conn creation evidence with a fresh local ref,
  actual caller PID and Env. Evidence lookup is read-only; no borrow is issued.
  Losing this read's reply cannot strand native retention. Keep the handle private."
 [connection]
 (lifetime-borrow-connection! connection)
 ;; The existing observer may adopt legacy nil lifetimes. This new entry must
 ;; remain read-only before local request issuance, so reject that path first.
 (when-not (maps/get :lifetime connection)
  (throw (ex-info "Existing exact lifetime required" {:kind :invalid-connection-borrow-request})))
 (let [ticket (erlang/make_ref) owner (erlang/self) scope (BeamLisp.Env/env_id)
       pid (lifetime-borrow-registry!) key (store-key (maps/get :store connection))
       evidence
       (Agent/get pid
        (fn [entries]
         (let [cell (get entries key)]
          ;; Refuse outside Agent/get so an invalid handle cannot crash registry.
          (when (lifetime-borrow-cell? connection cell)
           {:resource key :connection connection :lifetime (:lifetime cell)
            :creator (:guard-creator cell) :custody (:creation-custody cell)}))) 30000)]
  (when-not evidence
   (throw (ex-info "Connection custody unavailable" {:kind :connection-borrow-unavailable})))
  (tuple :datom.conn/lifetime-request ticket owner scope evidence)))

(defn- lifetime-request! [request]
 (when-not (and (erlang/is_tuple request) (= 5 (erlang/tuple_size request))
                (= :datom.conn/lifetime-request (elem request 0))
                (erlang/is_reference (elem request 1)) (erlang/is_pid (elem request 2))
                (or (= :global (elem request 3))
                    (and (erlang/is_tuple (elem request 3)) (= 2 (erlang/tuple_size (elem request 3)))
                         (= :env (elem (elem request 3) 0))
                         (erlang/is_reference (elem (elem request 3) 1))))
                (erlang/is_map (elem request 4))
                (= #{:resource :connection :lifetime :creator :custody} (set (keys (elem request 4)))))
  (throw (ex-info "Exact native lifetime request required" {:kind :invalid-connection-borrow-request})))
 (lifetime-borrow-connection! (:connection (elem request 4)))
 request)

(defn- lifetime-request-cell? [request cell]
 ;; Reconciliation is independent of writer/open liveness. The full ORIGINAL
 ;; canonical Conn, immutable creation evidence and native cell must match.
 (let [evidence (elem request 4) connection (:connection evidence)]
  (and (lifetime-borrow-identity? connection cell)
       (= (:resource evidence) (store-key (maps/get :store connection)))
       (= (:lifetime evidence) (:lifetime cell))
       (= (:creator evidence) (:guard-creator cell))
       (= (:custody evidence) (:creation-custody cell)))))

(defn commit-lifetime-request!
 "Idempotent initial admission for ONLY the actual original caller PID/Env.
  A different custodian may fence/reconcile the exact handle, never create its
  borrow. Held or terminal request slots count toward a fixed128 per Conn
  lifetime; terminal slots never evict/replenish while late RPCs may arrive."
 [request]
 (lifetime-request! request)
 (when-not (and (= (erlang/self) (elem request 2))
                (= (BeamLisp.Env/env_id) (elem request 3)))
  (throw (ex-info "Original request caller required" {:kind :connection-borrow-request-caller})))
 (let [connection (:connection (elem request 4)) key (:resource (elem request 4))
       ticket (elem request 1) owner (elem request 2)
       receipt
       (agent-get-and-update (lifetime-borrow-registry!)
        (fn [entries]
         (let [cell (get entries key) slots (:lifetime-borrow-requests cell {})
               prior (get slots ticket) borrowers (:lifetime-borrowers cell {})]
          (when-not (lifetime-request-cell? request cell)
           (throw (ex-info "Original connection custody changed" {:kind :connection-borrow-request-unknown})))
          (if prior
           (do
            (when-not (= request (:request prior))
             (throw (ex-info "Request identity conflict" {:kind :connection-borrow-request-unknown})))
            (when-not (= :held (:phase prior))
             (throw (ex-info "Request is permanently fenced" {:kind :connection-borrow-request-closed})))
            (when-not (lifetime-borrow-matches? (:receipt prior) cell (get borrowers ticket))
             (throw (ex-info "Request custody is uncertain" {:kind :connection-borrow-request-unknown})))
            (tuple (:receipt prior) entries))
           (do
            (when-not (lifetime-borrow-cell? connection cell)
             (throw (ex-info "Connection lifetime cannot be retained" {:kind :connection-borrow-unavailable})))
            (when (:lifetime-request-admission-closed cell)
             (throw (ex-info "New lifetime requests are permanently fenced" {:kind :connection-borrow-request-closed})))
            (when (>= (count slots) 128)
             (throw (ex-info "Lifetime request capacity exhausted" {:kind :connection-borrow-request-capacity})))
            (when (>= (count borrowers) 128)
             (throw (ex-info "Connection borrow capacity exhausted" {:kind :connection-borrow-capacity})))
            (when (get borrowers ticket)
             (throw (ex-info "Request ticket collision" {:kind :connection-borrow-request-unknown})))
            (let [custody (get-in cell [:creation-custody :ticket])
                  receipt (tuple :datom.conn/retained-lifetime key (:lifetime cell) custody ticket owner)
                  row {:ticket ticket :owner owner :lifetime (:lifetime cell) :custody custody}]
             (tuple receipt
              (assoc entries key
               (assoc cell :lifetime-borrowers (assoc borrowers ticket row)
                           :lifetime-borrow-requests
                           (assoc slots ticket {:request request :phase :held :receipt receipt}))))))))) 30000)]
  receipt))

(defn fence-lifetime-request!
 "Serialized registry reconciliation for a PRIVATE original request handle.
  :held returns only its actual already-issued cap, and fences fresh admission.
  :closed is a terminal registry tombstone inserted BEFORE acknowledgment;
  every late commit of this same request refuses. Absence queries, dead owners,
  timeouts and inactive writers are never completion evidence. Unknown/replaced
  registry custody refuses. No callback, writer RPC or new resource opens here."
 [request]
 (lifetime-request! request)
 (let [key (:resource (elem request 4)) ticket (elem request 1)]
  (agent-get-and-update (lifetime-borrow-registry!)
   (fn [entries]
    (let [cell (get entries key) slots (:lifetime-borrow-requests cell {})
          prior (get slots ticket) row (get-in cell [:lifetime-borrowers ticket])]
     (when-not (and (lifetime-request-cell? request cell)
                    (or (nil? prior) (= request (:request prior))))
      (throw (ex-info "Original request custody unavailable" {:kind :connection-borrow-request-unknown})))
     (cond
      (nil? prior)
       (do
        (when row
         (throw (ex-info "Unclassified borrow row" {:kind :connection-borrow-request-unknown})))
        (if (or (:lifetime-request-admission-closed cell) (>= (count slots) 128))
         ;; Saturation is terminal for THIS native lifetime. Seal all unseen
         ;; requests, including a lost capacity rejection, without a129th slot.
         ;; Existing slots never evict, and no late unseen commit can succeed.
         (tuple {:status :closed}
          (assoc entries key (assoc cell :lifetime-request-admission-closed true)))
         (tuple {:status :closed}
          (assoc entries key
           (assoc cell :lifetime-borrow-requests
            (assoc slots ticket {:request request :phase :closed}))))))
      (contains? #{:held :fenced} (:phase prior))
       (do
        (when-not (lifetime-borrow-matches? (:receipt prior) cell row)
         (throw (ex-info "Issued borrow row unavailable" {:kind :connection-borrow-request-unknown})))
        (tuple {:status :held :receipt (:receipt prior)}
         (assoc entries key
          (assoc cell :lifetime-borrow-requests (assoc slots ticket (assoc prior :phase :fenced))))))
      (= :closed (:phase prior))
       (do
        (when row
         (throw (ex-info "Closed request still holds custody" {:kind :connection-borrow-request-unknown})))
        (tuple {:status :closed} entries))
      :else (throw (ex-info "Unknown request phase" {:kind :connection-borrow-request-unknown}))))) 30000)))

; Insert beside guard-resource!. Uses the existing native connection lifetime,
; guarded declaration catalogue and immutable exact association receipts.
(defn guard-association-inventory!
 "Observe compatible installed policies without invoking any predicate. Current
  admitted candidate graph supplies its immutable declaration catalogue. Native
  handles/tickets stay private; this is not a public JSON receipt."
 [connection]
 (when-not (and (execution/owned?) (declaration/managed?))
  (guard-fail! :managed-guard-execution-required))
 (when-not (and (erlang/is_map connection)
                (= Conn (maps/get :__struct__ connection nil)))
  (guard-fail! :invalid-guard-resource))
 (let [key (store-key (:store connection))]
  (BeamLisp.Env/with_generation_lock (tuple :datom-guard-association key)
   (fn []
    (let [validated (guard-resource! connection) conn (first validated)
          creator (second validated) entries (guard-entries (:store conn))
          graph (execution/current) app (:application-id graph)
          catalogue (declaration/entries :guard)]
     (when (> (count entries) 128) (guard-fail! :guard-inventory-budget))
     (doseq [[name entry] entries]
      (when-not (and (erlang/is_map entry) (not (erlang/is_map_key :__struct__ entry))
                     (managed-guard? entry)) (guard-fail! :legacy-guard-adoption-required))
      (when-not (= app (:application-id entry)) (guard-fail! :guard-application-mismatch))
      (when-not (and (= #{:kind :application-id :guard-id :lifetime :ticket} (set (keys entry)))
                     (erlang/is_reference (:ticket entry))
                     (= name (:guard-id entry)) (= (:lifetime conn) (:lifetime entry)))
       (guard-fail! :stale-guard-resource))
      (when-not (and (= :guard (get-in catalogue [name :data :kind]))
                    (= name (get-in catalogue [name :data :ident])))
       (guard-fail! :missing-guard-declaration)))
     (let [reservation (Agent/get (registry) (fn [cells] (:guard-reservation (get cells key))) 30000)
           holder (Process/get :datom.conn/guard-reservation)]
      (when (and reservation
                 (not (and (= (erlang/self) (:owner reservation))
                           (= holder (:ticket reservation))
                           (= :activating (:phase reservation)))))
       (guard-fail! (if (= :uncertain (:phase reservation))
                     :guard-activation-uncertain :guard-association-reserved))))
     {:kind :guard-association-inventory :application-id app :generation (:digest graph)
      :scope (:scope graph) :connection conn :resource key :lifetime (:lifetime conn) :creator creator
      :guards entries})))))

(defn- with-guard-association-locks [receipts action]
 (if (empty? receipts) (action)
  (BeamLisp.Env/with_generation_lock (tuple :datom-guard-association (:resource (first receipts)))
   #(with-guard-association-locks (rest receipts) action))))

(defn with-guard-publication-fence!
 "Recheck exact finite association/lifetime receipts while all native metadata
  fences are held in deterministic store order. Ordinary reads/writes continue;
  association mutation and open->closing cannot cross publication. The supplied
  trusted final publication action MUST NOT call a writer or close resources.
  No policy is installed, adopted, removed or disabled by this operation."
 [receipts action]
 (when-not (and (execution/owned?) (declaration/managed?) (vector? receipts)
                (<= (count receipts) 32) (erlang/is_function action 0)
                (nil? (Process/get :datom.conn/writing-store))
                (nil? (Process/get :datom.conn/guard-publication)))
  (guard-fail! :invalid-guard-publication-fence))
 (let [graph (execution/current)
       _ (doseq [receipt receipts]
          (when-not (and (erlang/is_map receipt) (not (erlang/is_map_key :__struct__ receipt)))
           (guard-fail! :invalid-guard-inventory))
          (let [connection (maps/get :connection receipt nil)]
           (when-not (and (erlang/is_map connection) (= Conn (maps/get :__struct__ connection nil)))
            (guard-fail! :invalid-guard-inventory)))
          (when-not (and (= :guard-association-inventory (:kind receipt))
                        (= (:application-id graph) (:application-id receipt))
                        (= (:digest graph) (:generation receipt)) (= (:scope graph) (:scope receipt))
                        (= (:resource receipt) (store-key (:store (:connection receipt))))
                        (= (:lifetime receipt) (:lifetime (:connection receipt)))
                        (map? (:guards receipt)) (<= (count (:guards receipt)) 128))
           (guard-fail! :invalid-guard-inventory)))
       ordered (Enum/sort_by receipts (fn [receipt] (:resource receipt)))
       _ (when-not (= (count receipts) (count (set (map :resource receipts))))
           (guard-fail! :duplicate-guard-resource))]
  (with-guard-association-locks ordered
   (fn []
    (doseq [expected ordered]
     (when-not (= expected (guard-association-inventory! (:connection expected)))
      (guard-fail! :stale-guard-association-inventory)))
    ;; Nonconveyed scope: a final publish cannot wait on a writer which is itself
    ;; waiting on our association lock. Other processes' normal writes continue.
    (Process/put :datom.conn/guard-publication true)
    (try (action)
     (finally (Process/delete :datom.conn/guard-publication)))))))

(defn- guard-reservation-update! [receipts ticket transform]
 ;; One bounded Agent decision, under sorted metadata locks. No writer, owner
 ;; RPC, callback or user data is evaluated by this decision.
 (with-guard-association-locks receipts
  (fn [] (agent-get-and-update (registry)
   (fn [cells]
    (let [next (reduce (fn [state receipt]
                 (let [key (:resource receipt) cell (get state key)
                       held (:guard-reservation cell)]
                  (if (and (= (:lifetime receipt) (:lifetime cell))
                           (= ticket (:ticket held)))
                   (let [replacement (transform held)]
                    (assoc state key (if replacement (assoc cell :guard-reservation replacement)
                                       (dissoc cell :guard-reservation))))
                   state))) cells receipts)]
     (let [gates (get next :datom.conn/guard-admissions {})
           remaining (reduce (fn [state [app held]]
                        (if (= ticket (:ticket held))
                         (if-let [replacement (transform held)] (assoc state app replacement) (dissoc state app))
                         state)) gates gates)
           next (if (empty? remaining) (dissoc next :datom.conn/guard-admissions)
                  (assoc next :datom.conn/guard-admissions remaining))]
      (tuple :ok next)))) 30000))))

(defn- guard-reservation-cleanup! [receipts ticket]
 (guard-reservation-update! receipts ticket
  (fn [held]
   (case (:phase held)
    :reserved nil
    :completed nil
    ;; Death/timeout is NOT completion. Preserve the exact native handles and
    ;; association freeze, even after the guardian exits. Recovery requires a
    ;; fresh native participant/journal proof; this API never guesses or replays.
    :activating (assoc held :phase :uncertain)
    held))))

(defn- guard-reservation-phase! [receipts ticket owner guardian phase]
 (with-guard-association-locks receipts
  (fn [] (agent-get-and-update (registry)
   (fn [cells]
    (doseq [receipt receipts]
     (let [cell (get cells (:resource receipt)) held (:guard-reservation cell)]
      (when-not (and (= (:lifetime receipt) (:lifetime cell))
                     (= ticket (:ticket held)) (= owner (:owner held))
                     (Process/alive? owner)
                     (= (if (= phase :activating) :reserved :activating) (:phase held))
                     (or (= phase :completed) (Process/alive? guardian)))
       (guard-fail! :invalid-guard-reservation))))
    (let [gates (get cells :datom.conn/guard-admissions {})
          gate (first (filter (fn [[_ held]] (= ticket (:ticket held))) gates))]
     (when-not (and gate (= owner (:owner (second gate)))
                    (= (if (= phase :activating) :reserved :activating) (:phase (second gate)))
                    (Process/alive? owner) (or (= phase :completed) (Process/alive? guardian)))
      (guard-fail! :invalid-guard-reservation))
     (tuple :ok (assoc-in
      (reduce (fn [state receipt]
                (assoc-in state [(:resource receipt) :guard-reservation :phase] phase)) cells receipts)
      [:datom.conn/guard-admissions (first gate) :phase] phase)))) 30000))))

(defn guard-reservation-status
 "Bounded diagnostic only. No ticket, process, identity or native resource
  capability escapes. An uncertain activation is retained, never auto-unlocked."
 [connection]
 (when-not (and (erlang/is_map connection) (= Conn (maps/get :__struct__ connection nil)))
  (guard-fail! :invalid-guard-resource))
 (let [validated (guard-resource! connection) c (first validated)
       held (Agent/get (registry) (fn [cells] (:guard-reservation (get cells (store-key (:store c))))) 30000)]
  {:state (if held (:phase held) :free)}))

(defn with-guard-reservation!
 "Freeze exact compatible association/lifetime receipts across an accepted
  native activation and its final source publication, without holding locks
  during either RPC. The trusted synchronous action must return only after its
  accepted work has a known outcome; do not catch ambiguous RPC failures into
  ordinary results. Any exception or owner death after action admission holds
  the reservation as uncertain. No automatic replay, cancellation or unlock.
  Normal transactions remain writable. The capability is private/nonconveyed."
 ([receipts action] (with-guard-reservation! receipts {} action))
 ([receipts opts action]
 (when-not (and (erlang/is_map opts) (not (erlang/is_map_key :__struct__ opts))
                (= (set (keys opts)) (if (:root opts) #{:root} #{}))
                (or (nil? (:root opts)) (and (string? (:root opts))
                    (= (:root opts) (Path/expand (:root opts))) (not= "/" (:root opts))))
                (erlang/is_function action 0)
                (nil? (Process/get :datom.conn/guard-reservation)))
  (guard-fail! :invalid-guard-reservation))
 ;; Validate actual native receipts before constructing cleanup ownership.
 (with-guard-publication-fence! receipts (fn [] :validated))
 (let [ordered (Enum/sort_by receipts (fn [receipt] (:resource receipt)))
       owner (erlang/self) custodian (or (execution/runtime-owner) owner)
       graph (execution/current) ticket (erlang/make_ref)
       cleanup (fn [] (guard-reservation-cleanup! ordered ticket))
       guard (lifetime/register! owner cleanup)]
  (try
   (with-guard-publication-fence! ordered
    (fn [] (agent-get-and-update (registry)
     (fn [cells]
      (when-not (and (Process/alive? owner) (Process/alive? (:pid guard)))
       (guard-fail! :invalid-guard-reservation))
      (when (> (count cells) 100000) (guard-fail! :guard-inventory-budget))
      (let [app (:application-id graph) gates (get cells :datom.conn/guard-admissions {})
            resources (set (map :resource ordered))]
       (opening/check-publication! cells app (:root opts))
       (when (or (get gates app) (>= (count gates) 128))
        (guard-fail! :guard-association-reserved))
       ;; Close the snapshot->installation race in the SAME registry decision
       ;; as gate publication. A newly registered matching resource must be
       ;; explicitly captured; it never silently misses the migration inventory.
       (doseq [[store cell] cells]
        (let [path (when (erlang/is_map store) (maps/get :path store nil))]
         (when (and (:lifetime cell) (= :open @(:lifetime cell))
                    (or (= app (get-in cell [:guard-creator :application-id]))
                        (and (:root opts) (string? path)
                         (String/starts_with? (Path/expand path) (str (:root opts) "/"))))
                    (not (contains? resources store)))
          (guard-fail! :stale-guard-association-inventory))))
      (doseq [receipt ordered]
       (let [cell (get cells (:resource receipt))]
        (when-not (and (= (:lifetime receipt) (:lifetime cell))
                       (= :open @(:lifetime cell)) (nil? (:guard-reservation cell)))
         (guard-fail! :guard-association-reserved))))
      (let [gate {:ticket ticket :owner owner :custodian custodian :phase :reserved
                  :application-id app :generation (:digest graph) :scope (:scope graph) :root (:root opts)}]
       (tuple :reserved
        (assoc-in (reduce (fn [state receipt]
                    (assoc-in state [(:resource receipt) :guard-reservation]
                     (assoc gate :lifetime (:lifetime receipt)))) cells ordered)
                  [:datom.conn/guard-admissions app] gate))))) 30000)))
   (guard-reservation-phase! ordered ticket owner (:pid guard) :activating)
   (Process/put :datom.conn/guard-reservation ticket)
   (let [result (action)]
    (guard-reservation-phase! ordered ticket owner (:pid guard) :completed)
    result)
   (finally
    (Process/delete :datom.conn/guard-reservation)
    ;; Exact-ticket cleanup is idempotent with owner-DOWN cleanup. Executing it
    ;; here also handles a dead guardian; no uncertain phase is cleared.
    (cleanup)
    (when (Process/alive? (:pid guard)) (lifetime/release! guard)))))))

(defn register-declared-guard!
 "Fixed SDK residual for the ordinary guard! API. The store remains a runtime
  owner resource;only application/id/lifetime data enter its association table.
  Each admitted writer resolves its own exact immutable guard declaration."
 [conn name]
 (when-not (declaration/managed?) (guard-fail! :managed-guard-context-required))
 (let [application (:application-id (Process/get :bl_generation))
       validated (guard-resource! conn) conn (first validated) creator (second validated)
       selected (select-keys (execution/current) [:application-id :scope :digest])
       key (store-key (:store conn))
       entry {:kind :managed-guard :application-id application :guard-id name
              :lifetime (:lifetime conn) :ticket (erlang/make_ref)}]
  (when-not (and (string? application) (seq application)) (guard-fail! :missing-guard-application))
  (when-not (:provider (declaration/lookup :guard name)) (guard-fail! :missing-guard-declaration))
  (with-canonical-writer conn :register-guard (fn []
    (guard-association-mutation! key (fn [] (agent-get-and-update (guard-registry)
     (fn [all]
      (let [entries (get all key {}) before (get entries name)]
       (doseq [[_ value] entries]
        (when-not (managed-guard? value) (guard-fail! :legacy-guard-adoption-required))
        (when-not (= application (:application-id value)) (guard-fail! :guard-application-mismatch)))
       (when (and (nil? before) (not= creator selected))
        (guard-fail! :guard-resource-adoption-required))
       (when (and before (not= (dissoc before :ticket) (dissoc entry :ticket)))
        (guard-fail! :guard-owner-handover-required))
       (tuple key (assoc all key (assoc entries name (or before entry)))))) 30000)))))))

(defn guard!
 "Register a writer-run predicate. Managed literal named/closed callbacks are
  automatically compiler-owned declarations;runtime dynamic registration refuses."
 [conn name pred]
 (declaration/require-development!)
 (register-store-guard! (store-key (:store conn)) name pred))

(defn unguard! [conn name]
 (declaration/require-development!)
 (unregister-store-guard! (store-key (:store conn)) name))

(defn guard-owner
 "Nonexecutable exact owner receipt for explicit lifecycle handover/removal."
 [conn name]
 (let [entry (get (guard-entries (:store conn)) name)] (when (managed-guard? entry) entry)))

(defn remove-declared-guard!
 "Explicit owner/data contract. Ordinary unguard! cannot erase managed policy;
  its exact current receipt and a graph owning the guard declaration are needed."
 [conn name expected]
 (when-not (declaration/managed?) (guard-fail! :managed-guard-context-required))
 (let [conn (first (guard-resource! conn)) application (:application-id (Process/get :bl_generation))
       key (store-key (:store conn))]
  (when-not (and (managed-guard? expected) (= name (:guard-id expected))
                 (= application (:application-id expected)) (= (:lifetime conn) (:lifetime expected))
                 (:provider (declaration/lookup :guard name)))
   (guard-fail! :invalid-guard-owner-receipt))
  (with-canonical-writer conn :remove-guard (fn []
    (guard-association-mutation! key (fn [] (agent-get-and-update (guard-registry)
     (fn [all]
      (let [entries (get all key {})]
       (when-not (= expected (get entries name)) (guard-fail! :stale-guard-owner-receipt))
       (let [next (dissoc entries name)]
        (tuple :removed (if (empty? next) (dissoc all key) (assoc all key next)))))) 30000)))))))

(defn register-store-guard!
 ([store-k pred] (register-store-guard! store-k :default pred))
 ([store-k name pred]
  (declaration/require-development!)
  (when-not (fn? pred) (guard-fail! :invalid-store-guard-registration))
  (guard-association-mutation! store-k (fn [] (agent-get-and-update (guard-registry)
   (fn [all]
    (let [entries (get all store-k {})]
     (when (some managed-guard? (vals entries)) (guard-fail! :managed-guard-context-required))
     (tuple store-k (assoc all store-k (assoc entries name pred))))) 30000)))))

(defn unregister-store-guard!
 ([store-k] (unregister-store-guard! store-k :default))
 ([store-k name]
  (declaration/require-development!)
  (guard-association-mutation! store-k (fn [] (agent-get-and-update (guard-registry)
   (fn [all]
    (let [entries (get all store-k {})]
     (when (some managed-guard? (vals entries)) (guard-fail! :managed-guard-context-required))
     (tuple :ok (assoc all store-k (dissoc entries name))))) 30000)))))

(defn- run-guards! [conn report guards]
 (reduce (fn [_ pred]
           (let [problems (observing #(if (erlang/function_exported :Elixir.BeamLisp.Env :with_native_command_callback! 1)
                                       (BeamLisp.Env/with_native_command_callback! (fn [] (pred report)))
                                       (pred report)))]
            (when-not (nil? problems) (throw (ex-info "transaction refused" {:problems problems})))))
         nil guards))

(declare with-expanded-in-writer run-expanded-tx-pipeline)

(defn- with-in-writer [conn tx-data]
 (with-expanded-in-writer conn (datom.tx/expand-tx-fns (db conn) tx-data (native-closed-tx? (:store conn)))))

(defn- with-expanded-in-writer
  "The body of `with`, already inside the writer process. Mirrors
   `transact-in-writer`, but commits into an overlay and advances no
   basis: the speculative db-after reads at the overlay's fresh tx over a
   base that never learned the transaction happened."
  [conn tx-data]
  (let [db-before (db conn)
        overlay (datom.store-overlay/open (:store conn))
        ; Bytes are speculative too: a staged file lands in a blob overlay
        ; the real blob store never sees, and db-after resolves through it.
        blob-overlay (datom.blob-overlay/open (:blobs conn))
        result (run-expanded-tx-pipeline overlay blob-overlay (deref (:schema conn)) db-before tx-data)
        tx (get result :tx)]
    {:db-before db-before
     :db-after (datom.db/db-value overlay (deref (:schema conn)) tx blob-overlay)
     :tx tx
     :tempids (get result :tempids)
     :tx-datoms (get result :tx-datoms)}))

(defn- run-tx-pipeline [store blobs schema db-before tx-data]
 (run-expanded-tx-pipeline store blobs schema db-before (datom.tx/expand-tx-fns db-before tx-data (native-closed-tx? (:store db-before)))))

(defn- run-expanded-tx-pipeline
  "The pure transaction pipeline over a store: expand, resolve tempids,
   expand store-ops, validate, allocate a tx id, realize and WRITE the
   datoms. Returns `{:tx :tempids :tx-datoms}`.

   Factored out of `transact-in-writer` because `with` needs exactly this
   — against an OVERLAY store — and the two must not drift: a speculative
   transaction that expanded, resolved or validated even slightly
   differently from a real one would make `plan` (the migration dry-run)
   preview a migration that is not the one `apply!` would run. So there is
   ONE pipeline, and both callers use it; the only thing that differs is
   the store handed in and whether a basis atom is advanced afterward.

   `store` is committed to. For `transact!` that is the connection's real
   store; for `with` it is an overlay whose base is never touched."
  [store blobs schema db-before tx-data]
  (let [expanded-tx-data tx-data
        _ (native-schema-journal-forms! store db-before expanded-tx-data)
        ops (datom.tx/expand schema expanded-tx-data)
        ; `:db/retractEntity` and `:db/cas` are questions about current
        ; state, so they expand AFTER tempid resolution (their entity is
        ; a real id by then) and BEFORE validation (what they expand to
        ; must be validated like anything else). Resolution therefore
        ; runs first, on the unexpanded ops — which is correct, because
        ; neither form introduces a tempid.
        resolved (datom.tx/resolve-tempids store schema ops (fn [] (next-entity-id store)))
        expanded0 (datom.tx/expand-store-ops store schema (get resolved 0))
        ; DERIVE tuple values (`:db.type/tuple` / `:db/tupleAttrs`) from the
        ; components this transaction touched, and append them BEFORE validation
        ; so composite `:db.unique/identity` is enforced on the derived tuple.
        tuple-ops (datom.tx/derive-tuple-ops store schema expanded0)
        expected-tuples (into {} (keep (fn [op] (when (= :db/add (get op 0))
                                                   [[(get op 1) (get op 2)] (get op 3)])) tuple-ops))
        expanded (into expanded0 tuple-ops)
        problems (into (datom.tx/validate store schema expanded)
                       (keep (fn [op]
                               (when (and (= :db/add (get op 0))
                                          (seq (datom.schema/tuple-attrs schema (get op 2)))
                                          (not= (get op 3) (get expected-tuples [(get op 1) (get op 2)])))
                                 {:error :derived-tuple-mismatch :attr (get op 2)
                                  :actual (get op 3) :expected (get expected-tuples [(get op 1) (get op 2)])}))
                             expanded0))]
    (if (seq problems)
      (throw (ex-info "transaction rejected by schema" {:problems problems}))
      (let [tx (next-tx-id store)
            ; The transaction REIFIES: it is an entity, and it records
            ; when it happened. That single datom is what lets a query
            ; ask `what changed on Tuesday?` rather than only `what
            ; changed after transaction 1000042?` — a transaction id is
            ; an opaque counter, and without a timestamp beside it the
            ; history is navigable only by numbers nobody chose.
            ;
            ; Recorded as an ordinary datom on the tx entity, so it is
            ; queryable, pullable and time-travellable like any other
            ; fact. Nothing special reads it.
            instant [:db/add tx :db/txInstant (erlang/system_time :millisecond)]
            ; `:db/current-tx` in an entity position means THIS
            ; transaction, so a caller can annotate the change itself:
            ; who made it, from which request, under what authority.
            with-self (mapv (fn [op]
                              (if (= (get op 1) datom.tx/TX-SELF)
                                (assoc op 1 tx)
                                op))
                            ; File bodies leave for the blob store HERE,
                            ; before any datom exists: what gets realized
                            ; and indexed is the descriptor alone.
                            (stage-files! blobs schema expanded))
            datoms (datom.tx/realize store schema tx (conj with-self instant))
        ; The attributes this transaction wrote: a derived column of ONE
        ; attribute is invalidated by writes to THAT attribute, not by every
        ; write in the store. Computed here because the writer already holds
        ; `datoms`, and `changed-attrs` is the same set the attribute-filtered
        ; subscriptions use — one answer, two readers.
        attrs (datom.broadcast/changed-attrs datoms)]
        ; One atomic commit for every index of every datom: a transaction
        ; visible in EAVT but not AEVT would be a corrupt database. The
        ; per-attribute marks ride in the SAME commit — see `write-datoms`.
        (native-schema-journal-datoms! store schema datoms)
        (migration-policy-datoms! store schema datoms)
        (datom.index/write-datoms store schema datoms
          (into (datom.attr-basis/record-ops store attrs tx)
                (concat (datom.current/transaction-ops store schema datoms tx false)
                        (datom.text/commit-ops store schema datoms)
                        (datom.index-coverage/transaction-ops store schema datoms tx true)
                        (datom.query.rank-build/transaction-ops db-before datoms tx true))))
        {:tx tx :tempids (get resolved 1) :tx-datoms datoms}))))

(defn- transact-in-writer
  "The body of `transact!`, already inside the writer process.

   Everything here is a read-modify-write — allocating a tx id, checking
   a unique value, appending to the indexes — and none of it is atomic as
   a unit. It is correct because exactly one process runs it at a time."
  [conn tx-data]
  (check-schema-publication! conn)
  (let [guards (guards-for conn)
        db-before (db conn)
        expanded (when (seq guards) (datom.tx/expand-tx-fns db-before tx-data (native-closed-tx? (:store db-before))))
        _ (when (seq guards) (run-guards! conn (with-expanded-in-writer conn expanded) guards))
        result (if (seq guards)
                 (run-expanded-tx-pipeline (:store conn) (:blobs conn) (deref (:schema conn)) db-before expanded)
                 (run-tx-pipeline (:store conn) (:blobs conn) (deref (:schema conn)) db-before tx-data))
        tx (get result :tx)]
    ; The basis is a HIGH-WATER MARK, not a variable. A bare `reset!`
    ; let a slower transaction with a LOWER id land last and rewind
    ; it, which filtered every datom above the rewound mark out of
    ; every subsequent read — twenty concurrent writes, all
    ; committed, all acknowledged, all durable, and sixteen visible.
    ;
    ; Nothing was lost: the datoms were on disk the whole time. That
    ; is what made it dangerous. The caller held a report saying the
    ; write succeeded, because it had, and a later read disagreed
    ; (BUG-022).
    ;
    ; `max` rather than a compare-and-set loop because advancing a
    ; high-water mark is monotone and idempotent: two writers racing
    ; can apply theirs in either order for the same result.
    (swap! (:basis conn) (fn [cur] (max cur tx)))
    (publish-view! conn)
    ; NB: the per-attribute marks were already recorded, IN the transaction's own
    ; commit — see `run-tx-pipeline`. Recording them here would be a second
    ; commit, and a window in which the data is durable and the mark is not.
    (let [report {:db-before db-before
                  :db-after (db conn)
                  :tx tx
                  :tempids (get result :tempids)
                  :tx-datoms (get result :tx-datoms)}]
      ; Broadcast AFTER the basis advances, still inside the writer, so
      ; reports leave in commit order (invariant 1). `with` and
      ; `run-tx-pipeline` never reach here, so a speculative or rejected
      ; transaction never broadcasts (invariant 2). The fan-out is cheap
      ; non-blocking `send`s, so a slow subscriber cannot stall the writer
      ; (invariant 4).
      (publish-report! conn report)
      report)))

;; ── the bulk fact load ──────────────────────────────────────────────
;;
;; The analysed-corpus path: every fact new, every op an assertion, no
;; tempid, no tx-fn, no store-reading form. What the general pipeline does
;; for such a batch, and what this does instead, is spelled out on
;; `load-facts!`; what lives here is the commit itself.

(defn- load-facts-in-writer
  "The body of `load-facts!`, already inside the writer process.

   Two of the general pipeline's stages are KEPT, because they are what
   make the result the same database rather than a plausible one: `expand`
   — a map form is sugar for the assertions it stands for, and expanding
   it anywhere else would be a second implementation of that sugar — and
   the tx-entity reification (`:db/txInstant`), which is an ordinary fact
   about the transaction and would otherwise be missing from history.

   Everything between them is gone. There is no `expand-tx-fns` (a
   `:db/fn` form RAISES in `realize-fresh`), no `resolve-tempids` (the ids
   are real), no `expand-store-ops`, no `validate`, no per-op store read
   inside `realize`, and no `net-datoms` reduction. What remains is one
   index write, one basis advance and one broadcast — the three things a
   commit IS."
  [conn tx-data]
  (check-schema-publication! conn)
  (let [store (:store conn)
        schema (deref (:schema conn))
        db-before (db conn)
        _ (native-schema-journal-forms! store db-before tx-data)
        tx (next-tx-id store)
        instant [:db/add tx :db/txInstant (erlang/system_time :millisecond)]
        datoms (datom.tx/realize-fresh tx (conj (datom.tx/expand schema tx-data) instant))]
    ; One atomic commit for every index of every datom, exactly as the
    ; general path does it: a transaction visible in EAVT but not AEVT is a
    ; corrupt database, not a fast one.
    (native-schema-journal-datoms! store schema datoms)
        (migration-policy-datoms! store schema datoms)
    (datom.index/write-datoms store schema datoms
                              (into (datom.attr-basis/record-ops
                                      store (datom.broadcast/changed-attrs datoms) tx)
                                    (concat (datom.current/transaction-ops store schema datoms tx true)
                                            (datom.text/commit-ops store schema datoms)
                                            (datom.index-coverage/transaction-ops store schema datoms tx false)
                                            (datom.query.rank-build/transaction-ops db-before datoms tx false))))
    ; A HIGH-WATER MARK like `transact-in-writer`'s, and NOT a `reset!`: two
    ; writers racing can apply theirs in either order for the same result,
    ; while a rewind filters committed datoms out of every later read
    ; (BUG-022).
    (swap! (:basis conn) (fn [cur] (max cur tx)))
    (publish-view! conn)
    (let [report {:db-before db-before
                  :db-after (db conn)
                  :tx tx
                  :tempids {}
                  :tx-datoms datoms}]
      ; After the basis advances and inside the writer, so reports leave in
      ; commit order exactly as `transact!`'s do.
      (publish-report! conn report)
      report)))


(defn ensure-query-rank!
  "Internal automatic query-index registration. Runs in the existing source
   writer; no app schema, count updates or cache keys are required."
  [conn plan]
  (datom.query.rank-build/prepare!)
  (with-canonical-writer conn :rank-ensure (fn []
      (let [database (db conn) s (:store conn)
            id (datom.query.rank-build/ident plan)
            pending (datom.query.rank-build/start-ops database plan)]
        (when pending (datom.store/-commit s (:ops pending)))
        (or (:ident pending)
            (when (some (fn [existing] (= id existing)) (datom.query.rank-build/registry s)) id))))))

(defn advance-query-rank!
  "One bounded stage/cleanup step in the source writer. A process may die
   between calls; the durable checkpoint resumes on the next query."
  [conn id]
  (let [result (with-canonical-writer conn :rank-advance (fn []
      (let [started (erlang/monotonic_time :microsecond)
            _ (Process/put :datom_rank_turn_entities 0)
            database (db conn) s (:store conn)
            before (datom.store/-get s (datom.query.rank-index/header-key id))
            ops (or (datom.query.rank-build/step-ops database id)
                    (datom.query.rank-build/cleanup-ops database id))
            _ (when (seq ops) (datom.store/-commit s ops))
            elapsed (max 1 (- (erlang/monotonic_time :microsecond) started))
            header (datom.store/-get s (datom.query.rank-index/header-key id))
            costs (or (Process/get :datom_rank_build_costs) {})
            accumulated (+ (or (get costs id) 0) elapsed)
            building? (= :building (:status before))
            completed? (and building? (= :complete (:status header)))]
        (when (seq ops)
          (Process/put :datom_rank_writer_turn
            (datom.query.rank-build/observe-turn
              (Process/get :datom_rank_writer_turn)
              (Process/get :datom_rank_turn_entities 0) elapsed)))
        ;; At most the finite durable registry size is retained by this writer.
        (Process/put :datom_rank_build_costs
          (if (and building? (= :building (:status header)))
            (assoc (select-keys costs (or (datom.query.rank-build/registry s) [])) id accumulated)
            (dissoc costs id)))
        {:header header :cost (when completed? accumulated)})))]
    ;; Optional telemetry publication stays OUTSIDE the source writer.
    (when (:cost result)
      (datom.query.rank-demand/record-build!
        (data.bounded-cache/key-data (datom.store/identity-of (:store conn)) 0)
        id (:cost result) (:members (:header result))))
    (:header result)))


(defn claim-query-rank-worker!
  "Register one finite index builder as owned by the connection. Release stops
   it before draining the writer; a closed connection cannot acquire a worker."
  [conn pid]
  (let [conn (lifetime-conn conn)]
  (agent-get-and-update
    (registry)
    (fn [reg]
      (let [k (store-key (:store conn)) cell (get reg k)]
        (if (or (nil? cell) (not= :open @(:lifetime cell))
                (not= (:lifetime conn) (:lifetime cell))
                (and (:rank-worker cell) (Process/alive? (:rank-worker cell))))
          (->tuple-2 false reg)
          (->tuple-2 true (assoc reg k (assoc cell :rank-worker pid))))))
    30000)))

(defn query-rank-worker-live?
  [conn pid]
  (let [conn (lifetime-conn conn)
        cell (Agent/get (registry) (fn [reg] (get reg (store-key (:store conn)))))]
    (and cell (= (:lifetime conn) (:lifetime cell))
         (= :open @(:lifetime cell)) (= pid (:rank-worker cell)))))

(defn retire-query-rank! [conn id generation]
 (let [retired? (with-canonical-writer conn :rank-retire (fn []
                   (let [ops (datom.query.rank-build/retire-ops (db conn) id generation)]
                    (when (seq ops) (datom.store/-commit (:store conn) ops) true))))]
  (when retired?
   (try
    (datom.query.rank-demand/retired!
      (data.bounded-cache/key-data (datom.store/identity-of (:store conn)) 0) id)
    (catch _ nil)))
  retired?))


(defn adopt-current!
  "One bounded native current reverse-facet adoption step in this SAME writer.
   Derived records commit atomically. It creates no source fact, owner, ledger,
   network request or scheduler. Incomplete/unavailable coverage stays explicit."
  ([conn attr] (adopt-current! conn attr {:max-datoms 1024}))
  ([conn attr opts]
   (when-not (and (map? opts) (= #{:max-datoms} (set (keys opts))))
     (throw (ex-info "Choose an explicit bounded current adoption page" {:kind :current-adoption-limit})))
   (with-writer conn
    (fn []
     (check-schema-publication! conn)
     (let [step (datom.current/adoption-step (:store conn) @(:schema conn) attr @(:basis conn) (:max-datoms opts))]
      (when (seq (:ops step)) (datom.store/-commit (:store conn) (:ops step)))
      (dissoc step :ops))))))

;; Opt-in native schema-family enrollment. This is private resource evidence,
;; not selector coverage, phase completion, migration or adoption authority.
;; Ordinary connect/schema/request paths do not call any of these helpers.
(defn- migration-enrollment-fail! [kind]
 (throw (ex-info "Native migration enrollment refused" {:kind kind})))
(defn- migration-data! [value]
 ;; Existing pinned raw checker; no provider initialization or dispatch.
 (BeamLisp.CompilerData/check_first_order! value
   {:max-nodes 65536 :max-depth 64 :max-bytes 1048576}) value)
(defn- migration-canonical-schema! [value]
 (migration-data! value)
 (when-not (and (erlang/is_map value) (not (erlang/is_map_key :__struct__ value))
                (<= (erlang/map_size value) 512))
  (migration-enrollment-fail! :migration-schema-budget))
 (into {} (map (fn [[ident definition]]
  (when-not (and (keyword? ident) (erlang/is_map definition)
                 (not (erlang/is_map_key :__struct__ definition))
                 (= ident (maps/get :db/ident definition nil))
                 (nil? (datom.schema/validate-attr-def definition)))
   (migration-enrollment-fail! :invalid-migration-schema))
  (let [components (or (maps/get :db/tupleAttrs definition nil) [])]
   (when-not (and (or (vector? components) (erlang/is_list components))
                  (<= (count components) 32) (every? keyword? components))
    (migration-enrollment-fail! :invalid-migration-schema))
   [ident {:db/ident ident :db/valueType (maps/get :db/valueType definition nil)
           :db/cardinality (or (maps/get :db/cardinality definition nil) :db.cardinality/one)
           :db/unique (maps/get :db/unique definition nil)
           :db/index (= true (maps/get :db/index definition false))
           :db/fulltext (= true (maps/get :db/fulltext definition false))
           :db/tupleAttrs (vec components)}])) value)))
(defn- migration-family! [descriptor]
 (migration-data! descriptor)
 (when-not (and (erlang/is_map descriptor) (not (erlang/is_map_key :__struct__ descriptor))
                (= #{:family :schema} (set (keys descriptor)))
                (string? (:family descriptor))
                (Regex/match? #"^[a-z][a-z0-9.-]{0,63}$" (:family descriptor)))
  (migration-enrollment-fail! :invalid-migration-family))
 {:family (:family descriptor) :schema (migration-canonical-schema! (:schema descriptor))})
(defn- migration-native-store! [connection]
 ;; Native registry identity is checked separately before protocol dispatch.
 ;; No foreign Store/Enumerable or caller-forged class is accepted here.
 (let [store (:store connection) tag (when (erlang/is_map store) (maps/get :__struct__ store nil))
       info (when (and (erlang/is_atom tag) (BeamLisp.AOT/sdk_generated_class? tag))
              (BeamLisp.Record/info tag))]
  (when-not (and (erlang/is_tuple info) (= 4 (erlang/tuple_size info))
                 (= :record (elem info 0)) (= "datom.store-fjall" (elem info 1))
                 (= "FjallStore" (elem info 2))
                 (string? (maps/get :path store nil)))
   (migration-enrollment-fail! :unsupported-migration-substrate)) store))
(defn- migration-root! [graph]
 ;; The existing root API authenticates exact native journal creation custody,
 ;; actual current execution and the immutable prepared resource scope. Neither
 ;; descriptor nor an opaque receipt supplied by our caller grants this proof.
 (let [observer (BeamLisp.Env/sdk_callable! "proc.queue-family-root" "evidence!" 1)]
  (observer graph)))
(defn- migration-root-id [root]
 (select-keys root [:application-id :root :resource :lifetime :custody :incarnation :owner]))
(defn- migration-native-connection! [connection]
 ;; Validate raw resource/alias identity BEFORE dereferencing a supplied field
 ;; or dispatching a Store protocol. Rebuild the view from protected SDK cells.
 (let [store (maps/get :store connection nil) life (maps/get :lifetime connection nil)]
  (Agent/get (registry)
   (fn [cells]
    (let [cell (maps/get store cells nil)]
     (when-not (and cell (erlang/=:= life (:lifetime cell))
                    (erlang/=:= (maps/get :schema connection nil) (:schema cell))
                    (erlang/=:= (maps/get :basis connection nil) (:basis cell))
                    (erlang/=:= (maps/get :snapshot connection nil) (:snapshot cell)))
      (migration-enrollment-fail! :stale-migration-enrollment))
     (assoc (->Conn store (:schema cell) (:basis cell) (:writer cell)
                    (:subs cell) (:blobs cell) (:lifetime cell))
             :snapshot (:snapshot cell) :schema-publication (:schema-publication cell)))) 30000)))
(defn- migration-context! [connection original?]
 (when-not (and (execution/owned?) (erlang/is_map connection)
                (erlang/=:= Conn (maps/get :__struct__ connection nil)) (:lifetime connection))
  (migration-enrollment-fail! :migration-enrollment-authority-required))
 (let [graph (execution/current) root (migration-root! graph)
       canonical (migration-native-connection! connection)
       actual (creation-evidence! canonical) creator (:creator actual) custody (:custody actual)]
  (when (or (= (:resource actual) (:resource root))
            (some (fn [[_ c]] (and (= (:store c) (:resource actual))
                                   (= (:lifetime c) (:lifetime actual)))) (:declared root)))
   (migration-enrollment-fail! :reserved-migration-store))
  (when-not (and creator (= (:application-id graph) (:application-id creator))
                 (= (:application-id graph) (:application-id root))
                 (= creator (:origin custody))
                 (or (not original?)
                     (and (= (erlang/self) (:owner custody))
                          (= (select-keys graph [:application-id :scope :digest]) creator))))
   (migration-enrollment-fail! :migration-enrollment-authority-required))
  (let [store (migration-native-store! (:connection actual)) path (maps/get :path store nil)]
   ;; Confinement is REFUSAL only; native custody supplied the authority above.
   (when-not (and (= path (Path/expand path))
                  (String/starts_with? path (str (:root root) "/")))
    (migration-enrollment-fail! :migration-store-outside-root)))
  {:graph graph :root root :actual actual :caller (erlang/self)}))
(defn- migration-range! [store prefix budget]
 ;; OrderedPageScan has NO whole-range fallback. Both bytes and historical
 ;; physical rows are bounded before native decoding, not just after `vec`.
 (loop [after nil pages () budget budget]
  (when (or (<= (:rows budget) 0) (<= (:bytes budget) 0))
   (migration-enrollment-fail! :migration-schema-budget))
  (let [page (datom.store/ordered-page store prefix after (datom.index/prefix-end prefix)
                  (min 1024 (:rows budget)) :asc (min 65536 (:bytes budget)))
        rows (:datoms page []) n (count rows) last (:last page)
        bytes (erlang/external_size rows)
        next-budget {:rows (- (:rows budget) n) :bytes (- (:bytes budget) bytes)}]
   (when (or (:refused page) (> bytes (:bytes budget))
             (and (not (:end? page))
                  (or (zero? n) (not (erlang/is_binary last))
                      (and after (not (erlang/> last after))))))
    (migration-enrollment-fail! :migration-schema-budget))
   (migration-data! rows)
   (let [pages (cons (to-list rows) pages)]
    (if (:end? page) [(lists/append (lists/reverse pages)) next-budget]
     (recur last pages next-budget))))))
(defn- migration-persisted-schema! [connection]
 (let [store (migration-native-store! connection)
       native-basis (datom.store/-get store (erlang/list_to_binary (list 0 116)))
       basis (if (nil? native-basis) 999999 native-basis)]
  (when-not (and (erlang/is_integer basis) (>= basis 999999))
   (migration-enrollment-fail! :invalid-migration-schema))
  (let [view (datom.db/db-value store (datom.schema/empty-schema) basis)
        [idents budget] (migration-range! store (datom.index/key-prefix :aevt :db/ident)
                                  {:rows 16384 :bytes 1048576})
        entities (vec (distinct (map datom.index/-e (datom.db/filter-datoms view idents))))]
   (when (> (count entities) 512) (migration-enrollment-fail! :migration-schema-budget))
   (loop [left (to-list entities) pages () budget budget]
    (if (empty? left)
     (let [triples (lists/append (lists/reverse pages))
           schema (migration-canonical-schema!
                   (merge (datom.schema/empty-schema) (datom.schema/schema-from-datoms triples)))
           alias (migration-canonical-schema! @(:schema connection))]
      (when (or (not= basis @(:basis connection)) (not= schema alias))
       (migration-enrollment-fail! :stale-migration-schema-view))
      ;; Canonical SDK queues persist this schema marker before binding. This
      ;; is REFUSAL only; absence does not grant a migration-purpose capability.
      (when (contains? schema :queue/key) (migration-enrollment-fail! :reserved-migration-store))
      {:basis basis :schema schema})
     (let [[rows next-budget] (migration-range! store (datom.index/key-prefix :eavt (first left)) budget)
           triples (mapv (fn [d] [(datom.index/-e d) (datom.index/-a d) (datom.index/-v d)])
                     (datom.db/filter-datoms view rows))]
      (recur (rest left) (cons (to-list triples) pages) next-budget)))))))
(defn- migration-cell! [cells context connection]
 (let [actual (:actual context) cell (get cells (:resource actual))
       root (:root context) root-cell (get cells (:resource root))]
  (when-not (and cell root-cell (= :open @(:lifetime cell))
                 (= (:lifetime actual) (:lifetime cell)) (= (:custody actual) (:creation-custody cell))
                 (= (:creator actual) (:guard-creator cell))
                 (= (:schema connection) (:schema cell)) (= (:basis connection) (:basis cell))
                 (= (:snapshot connection) (:snapshot cell))
                 (Process/alive? (:writer cell)) (Process/alive? (:caller context))
                 (= :open @(:lifetime root-cell)) (= (:lifetime root) (:lifetime root-cell))
                 (= (:custody root) (:creation-custody root-cell)) (Process/alive? (:owner root)))
   (migration-enrollment-fail! :stale-migration-enrollment)) cell))
(defn enroll-migration-family!
 "OPT-IN native metadata enrollment for the original actual Conn custodian.
  Descriptor is schema selection data only; no selector coverage, phase, resource
  ownership/adoption or migration right is granted. No callbacks are executed.
  Declared root stores/canonical SDK queues refuse. PRIVATE result, never JSON."
 [connection descriptor]
 (let [context (migration-context! connection true)
       connection (get-in context [:actual :connection]) descriptor (migration-family! descriptor)]
  (serialized! connection
   (fn []
    (let [snapshot (migration-persisted-schema! connection)]
     (when-not (= (:schema descriptor) (:schema snapshot))
      (migration-enrollment-fail! :migration-family-schema-mismatch))
     (agent-get-and-update (registry)
      (fn [cells]
       (when (> (count cells) 100000) (migration-enrollment-fail! :migration-enrollment-budget))
       (let [cell (migration-cell! cells context connection) actual (:actual context)
             _ (when (:guard-reservation cell)
                 (migration-enrollment-fail! :migration-enrollment-reserved))
             expected {:kind :native-schema-family-enrollment :purpose :dynamic-data
                       :application-id (get-in context [:graph :application-id])
                       :resource (:resource actual) :lifetime (:lifetime actual)
                       :custody (:custody actual) :creator (:creator actual)
                       :root (migration-root-id (:root context)) :descriptor descriptor}
             prior (:migration-enrollment cell)]
        (when (and prior (not= expected prior))
         (migration-enrollment-fail! :migration-enrollment-conflict))
        (when-not prior
         (let [[total own] (reduce (fn [[total own] [_ row]]
                              (if-let [registered (:migration-enrollment row)]
                               [(inc total) (if (= (:application-id expected) (:application-id registered))
                                              (inc own) own)] [total own])) [0 0] cells)]
          (when (or (>= total 4096) (>= own 32))
           (migration-enrollment-fail! :migration-enrollment-budget))))
        (tuple expected (assoc-in cells [(:resource actual) :migration-enrollment] expected)))) 30000))))))
(defn migration-family-evidence!
 "Fresh native observation of a protected enrollment. Rechecks persisted schema
  and borrowed alias consistency. New app scope may OBSERVE its original creator;
  this does not retag it. Opaque/copied receipts grant no authority. PRIVATE."
 [connection]
 (let [context (migration-context! connection false) connection (get-in context [:actual :connection])]
  (serialized! connection
   (fn []
    (let [snapshot (migration-persisted-schema! connection)]
     (Agent/get (registry)
      (fn [cells]
       (let [cell (migration-cell! cells context connection) row (:migration-enrollment cell)
             actual (:actual context)]
        (when-not (and row (= :native-schema-family-enrollment (:kind row))
                       (= (:application-id row) (get-in context [:graph :application-id]))
                       (= (:resource row) (:resource actual)) (= (:lifetime row) (:lifetime actual))
                       (= (:custody row) (:custody actual)) (= (:creator row) (:creator actual))
                       (= (:root row) (migration-root-id (:root context)))
                       (= (or (get-in cell [:migration-phase :schema]) (get-in row [:descriptor :schema])) (:schema snapshot)))
         (migration-enrollment-fail! :stale-migration-enrollment)) row)) 30000))))))

;; HOME additive-only policy protocol. Exact Root/Conn custody is private SDK
;; evidence. No caller transform, callback, selector or JSON grants admission.
(defn- migration-policy-context! [custodian?]
 (BeamLisp.Env/assert_execution_context!)
 (when-not (execution/owned?) (migration-enrollment-fail! :migration-policy-authority-required))
 (let [graph (execution/current)
       _ (when-not (= :succession custodian?)
           ((BeamLisp.Env/sdk_callable! "proc.queue-family-root" "require-policy-available!" 1) graph))
       root (migration-root! graph)]
  (when (contains? #{:original-custodian :succession} custodian?)
   (when-not (= (erlang/self) (:owner root))
    (migration-enrollment-fail! :migration-policy-custodian-required)))
  (when (= true custodian?)
   ((BeamLisp.Env/sdk_callable! "proc.queue-family-root" "require-schema-phase!" 1) graph))
  {:graph graph :root root :caller (erlang/self) :policy-mutation (not= false custodian?)}))
(defn- migration-policy-root-cell! [cells context]
 (let [root (:root context) cell (get cells (:resource root))]
  (when-not (and cell (= :open @(:lifetime cell))
                 (= (:lifetime root) (:lifetime cell))
                 (= (:custody root) (:creation-custody cell))
                 (Process/alive? (:owner root)))
   (migration-enrollment-fail! :migration-policy-root-unavailable)) cell))
(defn- migration-policy-row! [cells context]
 (migration-policy-root-cell! cells context)
 (let [app (get-in context [:graph :application-id])
       row (get-in cells [(migration-policy/table-key) app])]
  (when-not (and row (= app (:application-id row)) (= :active (:state row))
                 (= (migration-root-id (:root context)) (:root-id row))
                 (let [raw (get-in context [:graph :resources :dynamic-store-policy])]
                  (if (:policy-mutation context) (= raw (:raw-plan row))
                   (migration-policy/prefix? raw (:raw-plan row)))))
   (migration-enrollment-fail! :migration-policy-not-installed)) row))
(defn- migration-policy-members [cells policy]
 (vec (filter (fn [[_ cell]] (= (:ticket policy) (get-in cell [:migration-phase :policy])))
              (filter migration-policy/registry-cell? cells))))
(defn- migration-policy-fixed [name arity]
 (BeamLisp.Env/sdk_callable! "datom.migrate" name arity))
(defn- migration-policy-native-status [connection family]
 ;; Read actual native data through a fresh writer-owned view. Never evaluate a
 ;; migration callback, batch selector, check provider or arbitrary Env binding.
 (let [snapshot (migration-persisted-schema! connection)
       actual (migration-policy/business-schema (:schema snapshot))
       expected (contains? (:schemas family #{(:before family) (:after family)}) actual)
       inspector (migration-policy-fixed "additive-schema-status" 2)
       db (datom.db/db-value (:store connection) (:schema snapshot) (:basis snapshot) (:blobs connection))
       status (when expected (inspector db (:migration family)))]
  (when-not expected (migration-enrollment-fail! :unknown-migration-schema-family))
  {:snapshot snapshot :actual actual :status status}))
(defn- migration-policy-install-cell [cells context policy connection snapshot family]
 (let [actual (creation-evidence! connection)]
  ;; Called OUTSIDE registry decisions; returns a bounded proposed metadata row.
  ;; Root custody may select only already inventoried actual app-owned resources.
  (when-not (= (get-in actual [:creator :application-id]) (:application-id policy))
   (migration-enrollment-fail! :migration-policy-foreign-resource))
  {:resource (:resource actual) :lifetime (:lifetime actual) :custody (:custody actual)
   :creator (:creator actual) :snapshot snapshot :connection connection
   :enrollment {:kind :native-schema-family-enrollment :purpose :dynamic-data
                :application-id (:application-id policy) :resource (:resource actual)
                :lifetime (:lifetime actual) :custody (:custody actual) :creator (:creator actual)
                :root (migration-root-id (:root context))
                :descriptor {:family (:family family) :schema (:schema snapshot)}}
   :phase {:policy (:ticket policy) :family (:family family) :state :ready :frontier 0
           :schema (:schema snapshot)}}))
(defn install-migration-policy!
 "Opt-in additive schema-only v1. Intent is fenced BEFORE serialized schema
  observations. Unknown installation stays :installing and blocks opening and
  metadata mutation; ordinary data writes continue. No implicit replay."
 []
 (let [context (migration-policy-context! :original-custodian) graph (:graph context) root (:root context)
       raw (get-in graph [:resources :dynamic-store-policy]) plan (migration-policy/validate-plan raw)
       declared (vec (vals (:declared root))) all (owned-connections (:application-id graph) (:root root) declared)
       controls (set (map :store declared)) receipts (mapv guard-association-inventory! all)
       proposed {:application-id (:application-id graph) :root (:root root)
                 :root-id (migration-root-id root) :state :installing :ticket (erlang/make_ref)
                 :declared controls :raw-plan raw :plan plan :frontier 0 :permits {}}]
  (when (> (count all) 64) (migration-enrollment-fail! :migration-inventory-budget))
  (with-guard-reservation! receipts {:root (:root root)}
   (fn []
    (let [admitted (agent-get-and-update (registry)
       (fn [cells]
        (migration-policy-root-cell! cells context)
        (let [app (:application-id graph) table (get cells (migration-policy/table-key) {}) prior (get table app)]
         (if prior
          (do (when-not (and (= (:root-id proposed) (:root-id prior)) (= raw (:raw-plan prior))
                             (= :active (:state prior)))
                (migration-enrollment-fail! :migration-policy-identity-conflict))
              (tuple {:prior prior} cells))
          (do (when (>= (count table) 128) (migration-enrollment-fail! :migration-policy-capacity))
              (migration-policy/check-queue-inventory cells proposed)
              ;; String cache is only a refusal fast path. Native policy remains
              ;; authoritative even if an interrupted cache update is visible.
              (erlang/apply :persistent_term :put
               (list :datom-migration-policy-roots
                 (assoc (erlang/apply :persistent_term :get (list :datom-migration-policy-roots {})) app (:root root))))
              (tuple {:policy proposed}
               (assoc-in cells [(migration-policy/table-key) app] proposed)))))) 30000)]
     (if-let [prior (:prior admitted)]
      {:status :already-installed :frontier (:frontier prior)}
      (let [policy (:policy admitted)
            selected (Agent/get (registry)
             (fn [cells]
              (filterv (fn [connection]
                         (let [store (:store connection) cell (get cells store)]
                          (and (not (contains? controls store))
                               (not (migration-policy/queue-cell? cells store cell))))) all)) 30000)
            _ (when (> (count selected) 32) (migration-enrollment-fail! :migration-inventory-budget))
            rows (mapv (fn [connection]
                   (when (seq (guard-entries (:store connection)))
                    (migration-enrollment-fail! :migration-policy-guarded-store-unsupported))
                   (serialized! connection
                    (fn [] (let [snapshot (migration-persisted-schema! connection)
                                  family (migration-policy/family-for plan (:schema snapshot))]
                             (migration-policy-install-cell nil context policy connection snapshot family))))) selected)]
       (agent-get-and-update (registry)
        (fn [cells]
         (migration-policy-root-cell! cells context)
         (let [app (:application-id policy) now (get-in cells [(migration-policy/table-key) app])]
          (when-not (and (= (:ticket policy) (:ticket now)) (= :installing (:state now)))
           (migration-enrollment-fail! :migration-policy-identity-conflict))
          (migration-policy/check-queue-inventory cells policy)
          (let [next (reduce (fn [state row]
                       (let [cell (get state (:resource row))]
                        (when-not (and (= (:lifetime row) (:lifetime cell)) (= :open @(:lifetime cell))
                                       (= (:custody row) (:creation-custody cell))
                                       (= (:creator row) (:guard-creator cell))
                                       (= (get-in row [:snapshot :schema]) (migration-canonical-schema! @(:schema cell))))
                         (migration-enrollment-fail! :stale-migration-policy-inventory))
                        (when (and (:migration-enrollment cell) (not= (:migration-enrollment cell) (:enrollment row)))
                         (migration-enrollment-fail! :migration-enrollment-conflict))
                        (assoc state (:resource row)
                         (assoc cell :migration-enrollment (:enrollment row) :migration-phase (:phase row))))) cells rows)]
           (tuple {:status :installed :frontier 0 :stores (count rows)}
            (assoc-in next [(migration-policy/table-key) app :state] :active))))) 30000))))))))
(defn- migration-policy-permit! [context path schema-defs]
 (let [graph (:graph context) creator (select-keys graph [:application-id :scope :digest])
       owner (erlang/self) ticket (erlang/make_ref)
       normalized (Path/expand path)
       given (migration-policy/canonical-schema
               (datom.schema/install-all (datom.schema/empty-schema) schema-defs))]
  (agent-get-and-update (registry)
   (fn [cells]
    (let [policy (migration-policy-row! cells context)
          family (migration-policy/family-for (:plan policy) given)]
     (when-not (and (= path normalized) (not= path (:root policy))
                    (migration-policy/under-root? (:root policy) path)
                    (not (some (fn [[_ c]] (= path (get-in c [:store :path]))) (:declared (:root context)))))
      (migration-enrollment-fail! :reserved-migration-store))
     (when (or (get-in cells [:datom.conn/guard-admissions (:application-id policy)])
               (>= (+ (count (:permits policy)) (count (migration-policy-members cells policy))) 32))
      (migration-enrollment-fail! :migration-opening-reserved))
     (tuple ticket (assoc-in cells [(migration-policy/table-key) (:application-id policy) :permits ticket]
       {:ticket ticket :policy (:ticket policy) :owner owner :creator creator :path path
        :family (:family family) :state :issued :required (:frontier policy)})))) 30000)))
(defn- migration-policy-claim-cell [cells store cell creator custody permit queue-role]
 (let [policy (migration-policy/matching cells creator (when (erlang/is_map store) (:path store)))]
  (if queue-role
   (do
    (when-not (and (= (:owner custody) (:owner queue-role))
                   (migration-policy/queue-role-valid? cells queue-role creator (:owner custody)
                                                       (:path store) (:opening-ticket queue-role))
                   (or (nil? policy)
                       (and (= :active (:state policy)) (= (:root-id policy) (:root-id queue-role)))))
     (migration-enrollment-fail! :queue-family-allocation-ticket-refused))
    {:cell (assoc cell :migration-role (assoc queue-role :resource store :lifetime (:lifetime cell) :custody custody))
     :cells cells})
   (if policy
    (let [issued (get-in policy [:permits permit])]
     (when-not (and issued (= :issued (:state issued)) (= :active (:state policy))
                    (= creator (:creator issued)) (= (:owner custody) (:owner issued))
                    (= (:path store) (:path issued)) (= (:ticket policy) (:policy issued)))
      (migration-enrollment-fail! :migration-managed-open-required))
     {:cell (assoc cell :migration-phase {:policy (:ticket policy) :family (:family issued)
                                         :state :initializing :frontier 0 :permit permit})
      :cells (assoc-in cells [(migration-policy/table-key) (:application-id policy) :permits permit]
               (assoc issued :state :claimed :resource store :lifetime (:lifetime cell) :custody custody))})
    {:cell cell :cells cells}))))
(defn- migration-policy-mark-uncertain! [context permit]
 (agent-get-and-update (registry)
  (fn [cells]
   (let [app (get-in context [:graph :application-id]) row (get-in cells [(migration-policy/table-key) app :permits permit])]
    (tuple :held (if row (assoc-in cells [(migration-policy/table-key) app :permits permit :state] :uncertain) cells)))) 30000))
(defn- migration-policy-complete-in-writer! [connection context permit expand?]
 (let [graph (:graph context) app (:application-id graph) resource (:store connection)
       phase-ticket (erlang/make_ref) writer (erlang/self)
       family (agent-get-and-update (registry)
        (fn [cells]
         (let [policy (migration-policy-row! cells context) cell (get cells resource)
               issued (when permit (get-in policy [:permits permit])) phase (:migration-phase cell)
               family (first (filter #(= (:family phase) (:family %)) (get-in policy [:plan :families])))]
          (when-not (and family (= :open @(:lifetime cell)) (= (:lifetime connection) (:lifetime cell))
                         (= (:ticket policy) (:policy phase))
                         (or (nil? permit) (and issued (= resource (:resource issued))
                                              (= (:lifetime cell) (:lifetime issued))
                                              (= (:creation-custody cell) (:custody issued)))))
           (migration-enrollment-fail! :stale-migration-phase))
          (tuple (assoc family :observing-only (contains? #{:running :uncertain} (:state phase))) (assoc-in cells [resource :migration-phase]
             (assoc phase :state :running :turn phase-ticket :writer writer))))) 30000)]
  (let [previous-turn (Process/get :datom.conn/migration-phase)]
  (try
   (Process/put :datom.conn/migration-phase phase-ticket)
   (when (seq (guard-entries resource))
    (migration-enrollment-fail! :migration-policy-guarded-store-unsupported))
   (let [before (migration-policy-native-status connection family)
         required (if expand? 1
                    (Agent/get (registry) (fn [cells] (:frontier (migration-policy-row! cells context))) 30000))
         _ (when (= :conflict (get-in before [:status :ledger]))
             (migration-enrollment-fail! :migration-policy-identity-conflict))
         _ (when (and (= 1 required) (:observing-only family)
                      (not (and (= (:after family) (:actual before))
                                (= :complete (get-in before [:status :ledger]))
                                (= :valid (get-in before [:status :schema])))))
             (migration-enrollment-fail! :migration-phase-outcome-unconfirmed))
         _ (when (and (= 1 required) (not (:observing-only family)))
             (doseq [step (:steps family [family])]
              (let [now (migration-policy-native-status connection (assoc family :migration (:migration step)))
                    ledger (get-in now [:status :ledger])]
               (when (= :conflict ledger) (migration-enrollment-fail! :migration-policy-identity-conflict))
               (when-not (= :complete ledger)
                (let [apply-migration (migration-policy-fixed "apply!" 3)
                      outcome (apply-migration connection (:migration step)
                                {:expected-basis (get-in now [:snapshot :basis])})]
                 (when-not (contains? #{:applied :already-applied} (:status outcome))
                  (migration-enrollment-fail! (if (= :identity-conflict (:status outcome))
                   :migration-policy-identity-conflict :migration-additive-check-refused))))))))
         after (migration-policy-native-status connection family)
         complete? (and (= (:after family) (:actual after))
                        (= :complete (get-in after [:status :ledger]))
                        (= :valid (get-in after [:status :schema])))
         _ (when (and (= 1 required) (not complete?))
             (migration-enrollment-fail! :migration-phase-outcome-unconfirmed))]
    (agent-get-and-update (registry)
     (fn [cells]
      (let [policy (migration-policy-row! cells context) cell (get cells resource) phase (:migration-phase cell)
            issued (when permit (get-in policy [:permits permit]))]
       (when-not (and (= (:lifetime connection) (:lifetime cell)) (= phase-ticket (:turn phase))
                      (= writer (:writer phase)) (contains? #{:running :uncertain} (:state phase))
                      (= (:ticket policy) (:policy phase))
                      (= (get-in after [:snapshot :basis]) @(:basis cell)))
        (migration-enrollment-fail! :stale-migration-phase))
       (let [state (if complete? :complete :ready)
             enrollment (or (:migration-enrollment cell)
               {:kind :native-schema-family-enrollment :purpose :dynamic-data :application-id app
                :resource resource :lifetime (:lifetime cell) :custody (:creation-custody cell)
                :creator (:guard-creator cell) :root (:root-id policy)
                :descriptor {:family (:family family) :schema (get-in after [:snapshot :schema])}})
             prior-receipts (:migration-native-receipts cell [])
             prior (last prior-receipts)
             proof {:ticket (erlang/make_ref) :policy (:ticket policy) :root (:root-id policy)
                    :resource resource :lifetime (:lifetime cell) :custody (:creation-custody cell)
                    :family (:family family) :migration (select-keys (:migration family) [:migration/id :migration/digest])
                    :schema (get-in after [:snapshot :schema]) :basis (get-in after [:snapshot :basis])
                    :writer writer :state :complete}
             _ (when (and complete? (or @(:schema-publication cell) (not= writer (:writer cell))))
                 (migration-enrollment-fail! :migration-phase-outcome-unconfirmed))
             same? (= (select-keys prior [:policy :root :resource :lifetime :custody :family :migration :schema])
                      (select-keys proof [:policy :root :resource :lifetime :custody :family :migration :schema]))
             _ (when (and complete? (not same?) (>= (count prior-receipts) 8))
                 (migration-enrollment-fail! :migration-schema-receipt-capacity))
             next (assoc cells resource
                    (assoc cell :migration-enrollment enrollment
                     :migration-native-receipts (if (and complete? (not same?)) (conj prior-receipts proof) prior-receipts)
                     :migration-phase
                     {:policy (:ticket policy) :family (:family family) :state state
                      :frontier (if complete? 1 0) :schema (get-in after [:snapshot :schema])
                      :migration (select-keys (:migration family) [:migration/id :migration/digest])}))
             next (if permit
                    (update-in next [(migration-policy/table-key) app :permits] dissoc permit) next)]
        (tuple {:status :ready :frontier (if complete? 1 0)} next)))) 30000))
   (catch error
    (agent-get-and-update (registry)
     (fn [cells]
      (let [phase (get-in cells [resource :migration-phase])]
       (tuple :held (if (= phase-ticket (:turn phase))
         (assoc-in cells [resource :migration-phase :state] :uncertain) cells)))) 30000)
    (throw error))
   (finally (if previous-turn (Process/put :datom.conn/migration-phase previous-turn)
              (Process/delete :datom.conn/migration-phase)))))))
(defn- migration-policy-finalize! [connection]
 (let [context (migration-policy-context! false) permit (Process/get :datom.conn/migration-connect)]
  (when-not permit (migration-enrollment-fail! :migration-managed-open-required))
  (serialized! connection #(migration-policy-complete-in-writer! connection context permit false))
  connection))
(defn- migration-policy-successor-row! [cells context previous plan]
 (migration-policy-root-cell! cells context)
 (let [row (get-in cells [(migration-policy/table-key) (get-in context [:graph :application-id])])]
  (when-not (and row (= :active (:state row)) (= 1 (:frontier row))
                 (= (:root-id row) (migration-root-id (:root context)))
                 (= (:raw-plan row) (get-in previous [:resources :dynamic-store-policy]))
                 (empty? (:permits row)) (< (count (:handoff-receipts row [])) 8))
   (migration-enrollment-fail! :migration-policy-successor-prior-unconfirmed))
  (migration-policy/check-queue-inventory cells row)
  (migration-policy/check-frontier cells row)
  (doseq [[resource cell] (migration-policy-members cells row)]
   (let [receipt (last (:migration-native-receipts cell)) phase (:migration-phase cell)
         family (first (filter #(= (:family phase) (:family %)) (get-in row [:plan :families])))]
    (when-not (and receipt family (erlang/is_reference (:ticket receipt)) (= :complete (:state receipt))
                   (= (:ticket row) (:policy receipt)) (= (:root-id row) (:root receipt))
                   (= resource (:resource receipt)) (= (:lifetime cell) (:lifetime receipt))
                   (= (:creation-custody cell) (:custody receipt))
                   (= (:family family) (:family receipt))
                   (= (select-keys (:migration family) [:migration/id :migration/digest]) (:migration receipt))
                   (= (:schema phase) (:schema receipt) (migration-canonical-schema! @(:schema cell)))
                   (<= (:basis receipt) @(:basis cell)) (nil? @(:schema-publication cell))
                   (= :open @(:lifetime cell)) (Process/alive? (:writer cell)))
     (migration-enrollment-fail! :migration-policy-native-schema-receipt-required))
    (migration-policy/family-for plan (:schema receipt)))) row))
(defn succeed-migration-policy!
 "Fixed Root consumer. Exact old history prefix, genuine native schema and
  pointer receipts, complete actual inventory and one installation reservation.
  No Writer mutation, opener, callback, Contract, retry or nested activation."
 [previous publication]
 (BeamLisp.Env/assert_execution_context!)
 (when (or (Process/get :datom.conn/guard-reservation) (Process/get :datom.conn/writing-store)
           (Process/get :datom.conn/guard-publication))
  (migration-enrollment-fail! :migration-policy-native-succession-required))
 (let [context (migration-policy-context! :succession) graph (:graph context)
       raw (get-in graph [:resources :dynamic-store-policy]) old (get-in previous [:resources :dynamic-store-policy])
       plan (migration-policy/successor! old raw)
       gate (BeamLisp.Env/sdk_callable! "proc.queue-family-root" "schema-policy-succession-admission!" 3)
       publish-check (BeamLisp.Env/sdk_callable! "reload.generation" "schema-publication-evidence!" 1)
       _ (gate graph previous publication)
       _ (when-not (= publication (publish-check previous))
           (migration-enrollment-fail! :migration-policy-publication-receipt-required))
       prior (Agent/get (registry) #(migration-policy-successor-row! % context previous plan) 30000)
       all (owned-connections (:application-id graph) (:root (:root context)) (vec (vals (:declared (:root context)))))
       receipts (mapv guard-association-inventory! all)]
  ;; Root/prefix/phase/publication/native receipt metadata all pass BEFORE the
  ;; first writer observation. Reservation prevents any opening/close/association
  ;; change while fresh native schema+ledger reads and metadata commit occur.
  (with-guard-reservation! receipts {:root (:root (:root context))}
   (fn []
    (let [members (Agent/get (registry)
                   (fn [cells]
                    (let [row (migration-policy-successor-row! cells context previous plan)]
                     (when-not (= (:ticket prior) (:ticket row))
                      (migration-enrollment-fail! :migration-policy-successor-prior-changed))
                     (migration-policy-members cells row))) 30000)
          observations (mapv
           (fn [[resource cell]]
            (let [connection (assoc (->Conn resource (:schema cell) (:basis cell) (:writer cell)
                                           (:subs cell) (:blobs cell) (:lifetime cell))
                                :snapshot (:snapshot cell) :schema-publication (:schema-publication cell))
                  family (first (filter #(= (get-in cell [:migration-phase :family]) (:family %)) (get-in prior [:plan :families])))]
             (serialized! connection
              (fn []
               (let [now (migration-policy-native-status connection family)
                     receipt (last (:migration-native-receipts cell))]
                (when-not (and (= (:after family) (:actual now))
                               (= (:schema receipt) (get-in now [:snapshot :schema]))
                               (<= (:basis receipt) (get-in now [:snapshot :basis]))
                               (= :complete (get-in now [:status :ledger])) (= :valid (get-in now [:status :schema]))
                               (nil? @(:schema-publication connection)))
                 (migration-enrollment-fail! :migration-policy-native-schema-receipt-required))
                (doseq [step (:steps family [family])]
                 (let [status (migration-policy-native-status connection (assoc family :migration (:migration step)))]
                  (when-not (and (= :complete (get-in status [:status :ledger])) (= :valid (get-in status [:status :schema])))
                   (migration-enrollment-fail! :migration-policy-native-schema-receipt-required))))
                {:resource resource :lifetime (:lifetime cell) :custody (:creation-custody cell)
                 :receipt receipt :snapshot (:snapshot now)
                 :family (migration-policy/family-for plan (get-in now [:snapshot :schema]))}))))) members)
          _ (gate graph previous publication)
          _ (when-not (= publication (publish-check previous))
              (migration-enrollment-fail! :migration-policy-publication-receipt-required))
          ticket (erlang/make_ref)]
     (agent-get-and-update (registry)
      (fn [cells]
       (let [row (migration-policy-successor-row! cells context previous plan)
             _ (when-not (= (:ticket prior) (:ticket row))
                 (migration-enrollment-fail! :migration-policy-successor-prior-changed))
             _ (when-not (= (set (map first (migration-policy-members cells row))) (set (map :resource observations)))
                 (migration-enrollment-fail! :stale-migration-policy-inventory))
             next (reduce
              (fn [state observed]
               (let [resource (:resource observed) cell (get state resource) family (:family observed)]
                (when-not (and (= (:lifetime observed) (:lifetime cell)) (= (:custody observed) (:creation-custody cell))
                               (= (:receipt observed) (last (:migration-native-receipts cell)))
                               (= (get-in observed [:snapshot :basis]) @(:basis cell))
                               (= (get-in observed [:snapshot :schema]) (migration-canonical-schema! @(:schema cell)))
                               (nil? @(:schema-publication cell)))
                 (migration-enrollment-fail! :stale-migration-policy-inventory))
                (assoc state resource
                 (assoc cell :migration-enrollment
                  (assoc (:migration-enrollment cell) :descriptor {:family (:family family) :schema (get-in observed [:snapshot :schema])})
                  :migration-phase {:policy ticket :family (:family family) :state :ready :frontier 0
                                    :schema (get-in observed [:snapshot :schema])})))) cells observations)
             receipt {:ticket (erlang/make_ref) :previous-policy (:ticket row) :policy ticket
                      :root (:root-id row) :previous (:cache-key previous) :generation (:cache-key graph)
                      :publication (:ticket publication) :schemas (mapv :receipt observations)}
             policy (assoc row :ticket ticket :raw-plan raw :plan plan :frontier 0 :permits {}
                               :handoff-receipts (conj (:handoff-receipts row []) receipt))]
        ;; This is the sole handoff mutation. A lost Agent reply retains the
        ;; existing uncertain reservation and the Root issued/unknown latch.
        (tuple receipt (assoc-in next [(migration-policy/table-key) (:application-id graph)] policy)))) 30000))))))

(defn open-migration-connection!
 "Generic fixed SDK open, bounded first-order schema intent. Active policies
  never return a raw Store or Conn until actual native family/frontier catches
  up. Unknown accepted allocation/initialization is retained and blocks publish."
 [path schema-defs]
 (migration-data! [path schema-defs])
 (when-not (and (string? path) (vector? schema-defs) (<= (count schema-defs) 512))
  (migration-enrollment-fail! :invalid-migration-open))
 (let [context (migration-policy-context! false) permit (migration-policy-permit! context path schema-defs)
       prior (Process/get :datom.conn/migration-connect)
       open-store (BeamLisp.Env/sdk_callable! "datom.store-fjall" "open" 1)]
  (try
   (Process/put :datom.conn/migration-connect permit)
   (connect-with (open-store path) schema-defs)
   (catch error (migration-policy-mark-uncertain! context permit) (throw error))
   (finally (if prior (Process/put :datom.conn/migration-connect prior)
              (Process/delete :datom.conn/migration-connect))))))
(defn expand-migration-policy!
 "Advance a bounded live additive family frontier under the existing native
  opening/close/association reservation. No callback/provider or Contract."
 []
 (let [context (migration-policy-context! true) graph (:graph context) root (:root context)
       all (owned-connections (:application-id graph) (:root root) (vec (vals (:declared root))))
       receipts (mapv guard-association-inventory! all)]
  (migration-policy-with-reservation receipts context
   (fn []
    (let [members (Agent/get (registry)
                   (fn [cells] (migration-policy-members cells (migration-policy-row! cells context))) 30000)]
     (doseq [[resource cell] members]
      (let [connection (assoc (->Conn resource (:schema cell) (:basis cell) (:writer cell)
                                     (:subs cell) (:blobs cell) (:lifetime cell))
                         :snapshot (:snapshot cell) :schema-publication (:schema-publication cell))]
       (serialized! connection #(migration-policy-complete-in-writer! connection context nil true))))
     (agent-get-and-update (registry)
      (fn [cells]
       (let [policy (migration-policy-row! cells context) coverage (do (migration-policy/check-queue-inventory cells policy) (migration-policy/check-frontier cells policy))]
        (tuple (assoc coverage :status :expanded)
         (assoc-in cells [(migration-policy/table-key) (:application-id policy) :frontier] 1)))) 30000))))))
(defn migration-policy-status
 "Cached bounded observation. No migration/check/factory/provider invocation,
  heavy query, native ticket or message/data payload is returned."
 []
 (let [context (migration-policy-context! false)]
  (Agent/get (registry)
   (fn [cells]
    (let [_ (migration-policy-root-cell! cells context)
          policy (get-in cells [(migration-policy/table-key) (get-in context [:graph :application-id])])
          _ (when-not (and policy (= (migration-root-id (:root context)) (:root-id policy))
                           (migration-policy/prefix? (get-in context [:graph :resources :dynamic-store-policy]) (:raw-plan policy)))
              (migration-enrollment-fail! :migration-policy-not-installed))
          members (migration-policy-members cells policy)]
     {:state (:state policy) :frontier (:frontier policy) :stores (count members)
      :pending-openings (count (:permits policy))
      :complete (count (filter #(= :complete (get-in % [1 :migration-phase :state])) members))
      :unconfirmed (count (filter #(contains? #{:running :uncertain :initializing}
                                  (get-in % [1 :migration-phase :state])) members))})) 30000)))
(defn- migration-policy-existing-reservation! [receipts context ticket]
 ;; Private PDict ticket selects only. Exact live native execution, protected
 ;; app/root/scope/phase/owner/custody and complete lifetime coverage authorize
 ;; reuse. This function cannot release, transfer, widen or complete the guard.
 (BeamLisp.Env/assert_execution_context!)
 (when-not (and (execution/owned?) (= (:graph context) (execution/current))
                (erlang/is_reference ticket) (= ticket (Process/get :datom.conn/guard-reservation))
                (nil? (Process/get :datom.conn/writing-store))
                (nil? (Process/get :datom.conn/guard-publication)))
  (migration-enrollment-fail! :migration-reservation-mismatch))
 (let [graph (:graph context) app (:application-id graph) owner (erlang/self)
       custodian (or (execution/runtime-owner) owner) root (:root (:root context))
       resources (set (map :resource receipts))]
  ;; Existing primitive revalidates declaration/association proofs under sorted
  ;; store locks. Only a bounded registry read runs under its final fence.
  (with-guard-publication-fence! receipts
   (fn []
    (Agent/get (registry)
     (fn [cells]
      (migration-policy-root-cell! cells context)
      (let [gate (get-in cells [:datom.conn/guard-admissions app])
            identity [:ticket :owner :custodian :phase :application-id :generation :scope :root]
            expected {:ticket ticket :owner owner :custodian custodian :phase :activating
                      :application-id app :generation (:digest graph) :scope (:scope graph) :root root}
            native-resources (set (map first
               (filter (fn [[store cell]]
                         (and (:lifetime cell) (= :open @(:lifetime cell))
                              (or (= app (get-in cell [:guard-creator :application-id]))
                                  (migration-policy/under-root? root
                                    (when (erlang/is_map store) (maps/get :path store nil))))))
                       (filter migration-policy/registry-cell? cells))))]
       (when-not (and (= expected (select-keys gate identity)) (Process/alive? owner)
                      (Process/alive? custodian) (= resources native-resources))
        (migration-enrollment-fail! :migration-reservation-mismatch))
       (doseq [receipt receipts]
        (let [cell (get cells (:resource receipt)) held (:guard-reservation cell)]
         (when-not (and (= (:lifetime receipt) (:lifetime cell)) (= :open @(:lifetime cell))
                        (= (:lifetime receipt) (:lifetime held))
                        (= expected (select-keys held identity)))
          (migration-enrollment-fail! :migration-reservation-mismatch))))
       :validated)) 30000)))))
(defn- migration-policy-with-reservation [receipts context action]
 (if-let [ticket (Process/get :datom.conn/guard-reservation)]
  (do
   (migration-policy-existing-reservation! receipts context ticket)
   ;; Native writers/owner RPC run only AFTER all short metadata fences exit.
   ;; The outer owner alone advances phases/cleans up. An exception propagates
   ;; to that owner's existing uncertain retention path, never a success value.
   (let [answer (action)]
    (migration-policy-existing-reservation! receipts context ticket)
    answer))
  (with-guard-reservation! receipts {:root (:root (:root context))} action)))

(defn with-migration-publication-reservation!
 "Mandatory opted-in coordinator gate BEFORE owner activation or Source publish.
  All native store/Root proofs are freshly checked under the existing reservation;
  native writers run before final metadata checks, never under publication locks.
  A thrown/unknown action retains the existing reservation conservatively."
 [action]
 (when-not (erlang/is_function action 0) (migration-enrollment-fail! :invalid-migration-publication))
 (let [context (migration-policy-context! true) graph (:graph context) root (:root context)
       all (owned-connections (:application-id graph) (:root root) (vec (vals (:declared root))))
       receipts (mapv guard-association-inventory! all)]
  (migration-policy-with-reservation receipts context
   (fn []
    (let [members (Agent/get (registry)
                   (fn [cells]
                    (let [policy (migration-policy-row! cells context)]
                     (when-not (= 1 (:frontier policy))
                      (migration-enrollment-fail! :migration-frontier-not-advanced))
                     (do (migration-policy/check-queue-inventory cells policy) (migration-policy/check-frontier cells policy))
                     (migration-policy-members cells policy))) 30000)]
     (doseq [[resource cell] members]
      (let [connection (assoc (->Conn resource (:schema cell) (:basis cell) (:writer cell)
                                      (:subs cell) (:blobs cell) (:lifetime cell))
                         :snapshot (:snapshot cell) :schema-publication (:schema-publication cell))
            family (first (filter #(= (get-in cell [:migration-phase :family]) (:family %))
                                   (:families (migration-policy/validate-plan
                                     (get-in graph [:resources :dynamic-store-policy])))))]
       (serialized! connection
        (fn []
         (let [now (migration-policy-native-status connection family)]
          (when-not (and (= (:after family) (:actual now)) (= :complete (get-in now [:status :ledger]))
                         (= :valid (get-in now [:status :schema])))
           (migration-enrollment-fail! :stale-migration-phase))))))
     (Agent/get (registry)
      (fn [cells]
       (let [policy (migration-policy-row! cells context)]
        (migration-policy/check-queue-inventory cells policy) (migration-policy/check-frontier cells policy))) 30000)
     (action))))))
)

(defn- migration-policy-fast? [store]
 ;; Cache contains bounded strings only, never Native handles/functions. A
 ;; positive result ALWAYS rechecks actual registry/custody. Unrelated ETS and
 ;; path-backed apps incur no new Agent RPC or policy resources.
 (let [roots (erlang/apply :persistent_term :get (list :datom-migration-policy-roots {}))
       app (:application-id (execution/current))
       path (when (erlang/is_map store) (maps/get :path store nil))]
  (or (some? (get-in (execution/current) [:resources :dynamic-store-policy]))
      (contains? roots app) (some #(migration-policy/under-root? % path) (vals roots)))))
(defn- migration-policy-writer-scope! []
 (BeamLisp.Env/assert_execution_context!)
 {:caller (erlang/self) :creator (when (execution/owned?)
                                (select-keys (execution/current) [:application-id :scope :digest]))
  :permit (Process/get :datom.conn/migration-connect) :turn (Process/get :datom.conn/migration-phase)})
(defn- migration-policy-schema-scope? [cells connection scope]
 (let [cell (get cells (:store connection)) phase (:migration-phase cell)
       permit (:permit scope)
       turn (:turn scope)
       policy (first (filter #(= (:policy phase) (:ticket %))
                           (vals (get cells (migration-policy/table-key) {}))))
       issued (get-in policy [:permits permit])]
  (and policy (= :active (:state policy)) (= (:lifetime connection) (:lifetime cell))
       (= (:application-id policy) (get-in scope [:creator :application-id]))
       (or (and (= :initializing (:state phase)) issued (= :claimed (:state issued))
                (= permit (:permit phase)) (= (:caller scope) (:initializer issued))
                (= (:creator scope) (:creator issued)))
           (and (= :running (:state phase)) (= turn (:turn phase))
                (= (:caller scope) (:writer phase)))))))
(defn- migration-policy-business-row! [cells store]
 (let [cell (get cells store) policy (migration-policy/matching cells (:guard-creator cell)
                                                             (when (erlang/is_map store) (:path store)))]
  (when (and policy cell (not (contains? (:declared policy) store))
             (not (migration-policy/queue-cell? cells store cell)))
   {:cell cell :policy policy})))
(defn- migration-policy-schema-change! [connection after]
 (when (migration-policy-fast? (:store connection))
  (let [scope (migration-policy-writer-scope!)]
   (Agent/get (registry)
    (fn [cells]
     (when-let [business (migration-policy-business-row! cells (:store connection))]
      (let [phase (get-in business [:cell :migration-phase]) policy (:policy business)
            actual (migration-policy/business-schema after)
            family (first (filter #(= (:family phase) (:family %)) (get-in policy [:plan :families])))]
       (when-not (and (= :active (:state policy)) phase family
                      (if (migration-policy-schema-scope? cells connection scope)
                       (contains? #{(:before family) (:after family)} actual)
                       (= (migration-policy/business-schema (:schema phase)) actual)))
        (migration-enrollment-fail! :migration-schema-publication-reserved))))) 30000))))
(defn- migration-policy-datoms! [store schema datoms]
 (when (migration-policy-fast? store)
  (let [scope (migration-policy-writer-scope!)
        metadata? (some #(contains? #{:db/ident :db/valueType :db/cardinality :db/unique :db/index
                                     :db/fulltext :db/tupleAttrs :migration/id :migration/digest :migration/started-id}
                                    (datom.index/-a %)) datoms)]
   (Agent/get (registry)
    (fn [cells]
     (when-let [business (migration-policy-business-row! cells store)]
      (let [cell (:cell business) phase (:migration-phase cell) policy (:policy business)
            connection (assoc (->Conn store (:schema cell) (:basis cell) (:writer cell)
                                      (:subs cell) (:blobs cell) (:lifetime cell)) :snapshot (:snapshot cell))
            allowed? (and phase (= :active (:state policy))
                          (migration-policy-schema-scope? cells connection scope))]
       (when (and metadata? (not allowed?))
        (migration-enrollment-fail! :migration-schema-publication-reserved))
       ;; Installing blocks metadata only. Earlier accepted data turns drain
       ;; before schema observation; ordinary writes do not change family proof.
       (when (and (= :active (:state policy)) (not allowed?))
        (when-not (and phase (:schema phase)
                       (= (migration-policy/canonical-schema (:schema phase)) (migration-policy/canonical-schema schema))
                       (= (migration-policy/canonical-schema (:schema phase))
                          (migration-policy/canonical-schema @(:schema cell))))
         (migration-enrollment-fail! :stale-migration-schema-view)))))) 30000))))
(defn- migration-policy-close! [cells connection retirement]
 (if retirement
  (let [root (get-in cells [:datom.conn/native-mutation-roots (:root-resource retirement)])]
   (when-not (and root (= :retiring (:state root))
                  (= (:context retirement) (:retirement-context root))
                  (= (:owner retirement) (:owner root))
                  (some #(and (= (:store connection) (:store %)) (= (:lifetime connection) (:lifetime %)))
                        (:retirement-connections root)))
    (migration-enrollment-fail! :native-command-retirement-connection-required)) cells)
  (do
 (doseq [[_ root] (get cells :datom.conn/native-mutation-roots {})]
  (when (or (= (:store connection) (:resource root))
            (migration-policy/under-root? (:root root) (get-in connection [:store :path])))
   (when (or (BeamLisp.Env/native_command_unknown! (:credential root))
             (and (= (:store connection) (:resource root))
                  (BeamLisp.Env/native_command_retirement_blocker! (:credential root))))
    (migration-enrollment-fail! :native-command-outcome-unconfirmed))))
 (when (or (seq (get-in cells [(:store connection) :native-canonical-turns]))
           (some #(and (contains? #{:issued :entered :unknown} (:state (second %)))
                       (or (= (:store connection) (:resource (second %)))
                           (= (:store connection) (get-in (second %) [:root :resource]))))
                 (get cells :datom.conn/native-mutation-effects {})))
  (migration-enrollment-fail! :native-command-outcome-unconfirmed))
 (when (get-in cells [(:store connection) :native-schema-journal-window])
  (migration-enrollment-fail! :native-schema-journal-write-unconfirmed))
 (when-let [phase (get-in cells [(:store connection) :migration-phase])]
  (when (contains? #{:initializing :running :uncertain} (:state phase))
   (migration-enrollment-fail! :migration-phase-outcome-unconfirmed)))
 (doseq [[_ policy] (get cells (migration-policy/table-key) {})]
  (when (= (:store connection) (get-in policy [:root-id :resource]))
   (migration-enrollment-fail! :migration-policy-root-held))) cells)))


(defn- migration-policy-with-connect-turn [connection permit sender action]
 (if-not permit (action)
  (let [scope (migration-policy-writer-scope!) previous (Process/get :datom.conn/migration-connect)]
   (when-not (:creator scope) (migration-enrollment-fail! :migration-policy-authority-required))
   (agent-get-and-update (registry)
    (fn [cells]
     (let [policy (migration-policy/matching cells (:creator scope) (get-in connection [:store :path]))
           issued (get-in policy [:permits permit]) phase (get-in cells [(:store connection) :migration-phase])]
      (when-not (and issued (= sender (:owner issued)) (= (:creator scope) (:creator issued))
                     (= :claimed (:state issued)) (= :initializing (:state phase))
                     (= (:lifetime connection) (:lifetime issued))
                     (= (:store connection) (:resource issued)) (= permit (:permit phase)))
       (migration-enrollment-fail! :migration-managed-open-required))
      (tuple :accepted (assoc-in cells [(migration-policy/table-key) (:application-id policy)
                                       :permits permit :initializer] (:caller scope))))) 30000)
   (try (Process/put :datom.conn/migration-connect permit) (action)
    (finally (if previous (Process/put :datom.conn/migration-connect previous)
               (Process/delete :datom.conn/migration-connect)))))))

(defn- migration-policy-excision! [connection]
 (when (migration-policy-fast? (:store connection))
  (Agent/get (registry)
   (fn [cells]
    (when (get-in cells [(:store connection) :migration-phase])
     (migration-enrollment-fail! :migration-contract-drain-proof-required))) 30000)))

(defn- migration-policy-finish-connect-existing! [connection]
 (if-not (migration-policy-fast? (:store connection)) connection
  (let [policy (Agent/get (registry)
                 (fn [cells]
                  (when (get-in cells [(:store connection) :migration-phase])
                   (migration-policy/matching cells (get-in cells [(:store connection) :guard-creator])
                                               (get-in connection [:store :path])))) 30000)]
   (if-not policy connection
    (if (Process/get :datom.conn/migration-connect)
     (migration-policy-finalize! connection)
     (do
      (BeamLisp.Env/assert_execution_context!)
      (when (and (execution/current)
                 (not= (:application-id policy) (:application-id (execution/current))))
       (migration-enrollment-fail! :migration-policy-foreign-resource))
      (serialized! connection
       (fn []
        (migration-persisted-schema! connection)
        (Agent/get (registry)
         (fn [cells]
          (let [cell (get cells (:store connection)) phase (:migration-phase cell)
                current (get-in cells [(migration-policy/table-key) (:application-id policy)])]
           (when-not (and (= (:ticket policy) (:ticket current))
                          (= (:lifetime connection) (:lifetime cell))
                          (contains? #{:ready :complete} (:state phase))
                          (>= (:frontier phase) (:frontier current))
                          (= (:schema phase) (migration-canonical-schema! @(:schema cell))))
            (migration-enrollment-fail! :migration-phase-outcome-unconfirmed)))) 30000)))
      connection))))))

(defn migration-policy-installed?
 "Read-only optional generation publication preflight. Boolean is not a grant."
 [application]
 (if-not (contains? (erlang/apply :persistent_term :get (list :datom-migration-policy-roots {})) application) false
  (let [pid (erlang/whereis REGISTRY)]
   (if (= :undefined pid) false
    (Agent/get pid #(some? (get-in % [(migration-policy/table-key) application])) 30000)))))

(defn with-migration-activation!
 "Mandatory opted-in data frontier gate BEFORE native owner activation. Reuse
  ONLY a validated exact existing reservation; ordinary no-policy apps retain
  existing behavior. No public receipt/Boolean can choose or skip the gate."
 [action]
 (when-not (erlang/is_function action 0) (migration-enrollment-fail! :invalid-migration-publication))
 (BeamLisp.Env/assert_execution_context!)
 (let [graph (execution/current) declared (get-in graph [:resources :dynamic-store-policy])
       installed (when graph (migration-policy-installed? (:application-id graph)))]
  (when (and installed (nil? declared))
   (migration-enrollment-fail! :migration-policy-declaration-required))
  (if declared (with-migration-publication-reservation! action) (action))))
(defn schema-policy-publication-evidence!
 "Fixed Root completion consumer inside the current native reservation. Only
  positive writer-issued receipts for the current whole policy frontier count."
 []
 (let [context (migration-policy-context! true) graph (:graph context)]
  (Agent/get (registry)
   (fn [cells]
    (let [row (migration-policy-row! cells context) members (migration-policy-members cells row)]
     (when-not (= 1 (:frontier row)) (migration-enrollment-fail! :migration-frontier-not-advanced))
     (migration-policy/check-queue-inventory cells row) (migration-policy/check-frontier cells row)
     (doseq [[resource cell] members]
      (let [receipt (last (:migration-native-receipts cell)) phase (:migration-phase cell)]
       (when-not (and receipt (= :complete (:state receipt)) (= (:ticket row) (:policy receipt))
                      (= (:root-id row) (:root receipt)) (= resource (:resource receipt))
                      (= (:lifetime cell) (:lifetime receipt)) (= (:creation-custody cell) (:custody receipt))
                      (= (:family phase) (:family receipt)) (= (:migration phase) (:migration receipt))
                      (= (:schema phase) (:schema receipt) (migration-canonical-schema! @(:schema cell)))
                      (<= (:basis receipt) @(:basis cell)) (nil? @(:schema-publication cell)))
        (migration-enrollment-fail! :migration-policy-native-schema-receipt-required))))
     {:policy (:ticket row) :generation (:cache-key graph) :root (:root-id row)
      :schemas (mapv #(last (:migration-native-receipts (second %))) members)})) 30000)))

;; Fixed schema reconstruction journal. Source data is never a native receipt.
(def ^:private NATIVE-GUARD-CONTRACT "native-canonical-commands-v1")
(def ^:private NATIVE-JOURNAL-EPOCH-KEY
 ;; Internal non-Datom keyspace, below every index. Datom transactions cannot
 ;; create it. Source raw Store mutators must remain denied by the SDK boundary.
 (erlang/list_to_binary (to-list [0 106 111 117 114 110 97 108 49])))
(defn- native-system-journal-attr? [ident]
 (and (keyword? ident)
      (let [n (namespace ident)]
       (or (= n "upgrade") (and (string? n) (String/starts_with? n "upgrade."))
           (= n "live-backup")))))
(def ^:private SCHEMA-JOURNAL-DEFINITIONS
 [{:db/ident :upgrade.schema/operation :db/valueType :db.type/string :db/unique :db.unique/identity}
  {:db/ident :upgrade.schema/intent :db/valueType :db.type/term}
  {:db/ident :upgrade.initialization/scope :db/valueType :db.type/string :db/unique :db.unique/identity}
  {:db/ident :upgrade.initialization/receipt :db/valueType :db.type/term}
  {:db/ident :upgrade.initialization/events :db/valueType :db.type/term}
  {:db/ident :upgrade/id :db/valueType :db.type/string :db/unique :db.unique/identity}
  {:db/ident :upgrade/snapshot :db/valueType :db.type/term}
  {:db/ident :upgrade/events :db/valueType :db.type/term}
  {:db/ident :upgrade/commands :db/valueType :db.type/term}
  {:db/ident :upgrade/scope :db/valueType :db.type/string :db/unique :db.unique/identity}
  {:db/ident :upgrade/active :db/valueType :db.type/string}
  {:db/ident :upgrade.admission/key :db/valueType :db.type/string :db/unique :db.unique/identity}
  {:db/ident :upgrade.admission/operation :db/valueType :db.type/string :db/unique :db.unique/identity}
  {:db/ident :upgrade.admission/entry :db/valueType :db.type/term}
  {:db/ident :upgrade.admission/scope :db/valueType :db.type/string :db/unique :db.unique/identity}
  {:db/ident :upgrade.admission/active :db/valueType :db.type/string}
  {:db/ident :live-backup/key :db/valueType :db.type/string :db/unique :db.unique/identity}
  {:db/ident :live-backup/snapshot :db/valueType :db.type/term}
  {:db/ident :live-backup/events :db/valueType :db.type/term}])
(defn- native-schema-journal-allowed? [store]
 (let [scope (Process/get :datom.conn/native-schema-journal-turn)
       ticket (or (first scope) (Process/get :datom.conn/native-schema-journal-write))
       caller (or (second scope) (erlang/self))]
  (when (erlang/is_reference ticket)
   (Agent/get (registry)
    (fn [cells]
     (let [cell (get cells store) window (:native-schema-journal-window cell)]
      (and window (= :active (:state window)) (= ticket (:ticket window)) (= caller (:owner window))
           (= (:lifetime cell) (:lifetime window)) (= (:creation-custody cell) (:custody window))
           (= :open @(:lifetime cell)) (Process/alive? caller)))) 30000))))
(defn- native-schema-journal-with-turn [ticket sender action]
 (let [prior (Process/get :datom.conn/native-schema-journal-turn)
       prior-caller (Process/get :datom.conn/native-journal-caller)]
  (try
   (Process/put :datom.conn/native-journal-caller sender)
   (when ticket (Process/put :datom.conn/native-schema-journal-turn [ticket sender]))
   (action)
   (finally
    (if prior-caller (Process/put :datom.conn/native-journal-caller prior-caller)
       (Process/delete :datom.conn/native-journal-caller))
    (if prior (Process/put :datom.conn/native-schema-journal-turn prior)
       (Process/delete :datom.conn/native-schema-journal-turn))))))
(defn- native-schema-journal-protected? [store]
 ;; Cache is a refusal fast path only; actual write authority is always the
 ;; private registry window. Ordinary no-policy stores incur no Agent read.
 (contains? (erlang/apply :persistent_term :get (list :datom-native-schema-journals {})) store))
(defn- native-schema-journal-forms! [store db forms]
 ;; Run BEFORE tempid/entity/tx allocation. A retractEntity or schema-entity
 ;; rewrite cannot remove/relabel reserved records through another attribute.
 (when (native-schema-journal-protected? store)
 (let [reserved-ident? (fn [ident]
        (or (native-system-journal-attr? ident)
            (and (erlang/is_integer ident) (> ident 0)
                 (some #(native-system-journal-attr? (datom.index/-v %))
                       (datom.db/datoms db :eavt ident :db/ident)))))
       reserved-entity? (fn [entity]
        (let [resolved (cond
                        (and (vector? entity) (= 2 (count entity))) (datom.db/resolve-eid db entity)
                        (erlang/is_integer entity) entity
                        :else nil)]
         (or (reserved-ident? entity)
             (and (vector? entity) (or (reserved-ident? (first entity))
               (and (= :db/ident (first entity)) (reserved-ident? (second entity)))))
             (and (erlang/is_integer resolved) (> resolved 0)
               (some #(or (reserved-ident? (datom.index/-a %))
                          (and (= :db/ident (datom.index/-a %)) (reserved-ident? (datom.index/-v %))))
                     (datom.db/datoms db :eavt resolved))))))
       touches? (some (fn [form]
        (if (erlang/is_map form)
         (or (some reserved-ident? (keys form))
             (reserved-ident? (:db/ident form)) (reserved-entity? (:db/id form)))
         (or (reserved-ident? (get form 2))
             (and (= :db/ident (get form 2)) (reserved-ident? (get form 3)))
             (reserved-entity? (get form 1))))) forms)]
  (when (and touches? (not (native-schema-journal-allowed? store)))
   (migration-enrollment-fail! :native-schema-journal-write-required)))))
(defn- native-schema-journal-datoms! [store schema datoms]
 (when (and (native-schema-journal-protected? store)
            (some #(or (native-system-journal-attr? (datom.index/-a %))
                      (and (= :db/ident (datom.index/-a %)) (native-system-journal-attr? (datom.index/-v %)))) datoms)
            (not (native-schema-journal-allowed? store)))
  (migration-enrollment-fail! :native-schema-journal-write-required)))
(defn- native-schema-journal-schema! [connection after defs]
 (when (and (native-schema-journal-protected? (:store connection))
            (or (some #(native-system-journal-attr? (:db/ident %)) defs)
                (not= (into {} (filter #(native-system-journal-attr? (first %)) @(:schema connection)))
                      (into {} (filter #(native-system-journal-attr? (first %)) after))))
            (not (native-schema-journal-allowed? (:store connection))))
  (migration-enrollment-fail! :native-schema-journal-write-required)))
(defn- native-schema-journal-window! [connection mode payload]
 ;; PRIVATE fixed consumer, never an application callback/with-* API.
 (BeamLisp.Env/assert_native_framework_execution!)
 (let [actual (creation-evidence! connection) resource (:resource actual)
       caller (erlang/self) ticket (erlang/make_ref)
       _ (when (Process/get :datom.conn/native-schema-journal-write)
           (migration-enrollment-fail! :native-schema-journal-nested-write))
       _ (agent-get-and-update (registry)
          (fn [cells]
           (let [cell (get cells resource)]
            (when-not (and cell (= (:lifetime actual) (:lifetime cell)) (= :open @(:lifetime cell))
                           (= (:custody actual) (:creation-custody cell)) (nil? (:native-schema-journal-window cell)))
             (migration-enrollment-fail! :native-schema-journal-write-unconfirmed))
            (let [cache (erlang/apply :persistent_term :get (list :datom-native-schema-journals {}))]
             (when (and (not (contains? cache resource)) (>= (count cache) 128))
              (migration-enrollment-fail! :native-schema-journal-capacity))
             (erlang/apply :persistent_term :put (list :datom-native-schema-journals (assoc cache resource true))))
            (tuple :issued (assoc cells resource
              (assoc cell :native-schema-journal {:lifetime (:lifetime actual) :custody (:custody actual)}
               :native-schema-journal-window {:ticket ticket :owner caller :state :active
                 :mode mode :operation (get payload "operation") :record-state (get payload "state")
                 :lifetime (:lifetime actual) :custody (:custody actual)}))))) 30000)]
  (try
   (Process/put :datom.conn/native-schema-journal-write ticket)
   (let [answer (case mode
                 :install (let [store (:store connection) epoch (datom.store/-get store NATIVE-JOURNAL-EPOCH-KEY)
                                anchor (native-guard-anchor! connection epoch)]
                            ;; Existing receipt/epoch is validated BEFORE any
                            ;; schema installation. A Source-shaped old marker
                            ;; never becomes native evidence by being present.
                            (when-not anchor (install-schema! connection SCHEMA-JOURNAL-DEFINITIONS))
                            (let [accepted (or anchor (native-guard-publish! connection))]
                             (when-not epoch
                              (datom.store/-commit store [[:put NATIVE-JOURNAL-EPOCH-KEY (:epoch accepted)]])))
                            :installed)
                 :control (transact! connection payload)
                 :write (transact! connection [{:db/id -1 :upgrade.schema/operation (get payload "operation")
                                                :upgrade.schema/intent payload}])
                 :initialization (transact! connection [{:db/id -1 :upgrade.initialization/scope (:scope payload)
                                                         :upgrade.initialization/receipt (:receipt payload)
                                                         :upgrade.initialization/events (:events payload)}]))]
    (datom.store/sync! (:store connection))
    (agent-get-and-update (registry)
     (fn [cells]
      (let [cell (get cells resource) window (:native-schema-journal-window cell)]
       (when-not (= ticket (:ticket window)) (migration-enrollment-fail! :native-schema-journal-write-unconfirmed))
       (tuple :completed (assoc cells resource (dissoc cell :native-schema-journal-window))))) 30000)
    answer)
   (catch error
    (agent-get-and-update (registry)
     (fn [cells]
      (tuple :held (if (= ticket (get-in cells [resource :native-schema-journal-window :ticket]))
                     (assoc-in cells [resource :native-schema-journal-window :state] :uncertain) cells))) 30000)
    (throw error))
   (finally (Process/delete :datom.conn/native-schema-journal-write)))))
(defn install-schema-reconstruction-journal!
 "Fixed native journal installer, before Source initialization. Protects only
  the reserved SDK census/startup/activation/admission attrs; ordinary application transactions retain behavior."
 [connection]
 (BeamLisp.Env/assert_native_framework_execution!)
 (let [actual (creation-evidence! connection)]
  (when-not (and (= (erlang/self) (get-in actual [:custody :owner]))
                 (nil? (get-in actual [:custody :origin])) (nil? (:creator actual))
                 (= :open @(:lifetime actual)))
   (migration-enrollment-fail! :native-schema-journal-custodian-required))
  (migration-native-store! (:connection actual))
  (install-native-mutation-root! (:connection actual))
  (native-schema-journal-window! (:connection actual) :install nil)) :installed)
(defn write-schema-reconstruction-journal!
 "Closed data from a fixed native schema/publication consumer. Actual Root
  phase, exact journal lifetime/custody and private writer turn remain mandatory."
 [connection payload]
 (BeamLisp.Env/assert_native_framework_execution!)
 (migration-data! payload)
 (when-not (and (erlang/is_map payload) (= 1 (get payload "version"))
                (contains? #{"prepared" "consumed"} (get payload "state"))
                (string? (get payload "operation")) (<= 1 (erlang/byte_size (get payload "operation")) 128)
                (<= (erlang/external_size payload) 65536))
  (migration-enrollment-fail! :invalid-native-schema-journal-record))
 (let [context (migration-policy-context! true) root (:root context) actual (creation-evidence! connection)]
  (when-not (and (= (:resource root) (:resource actual)) (= (:lifetime root) (:lifetime actual))
                 (= (:custody root) (:custody actual)) (= :open @(:lifetime actual))
                 (native-schema-journal-protected? (:resource actual)))
   (migration-enrollment-fail! :native-schema-journal-custodian-required))
  (native-schema-journal-window! (:connection actual) :write payload)) :written)

(defn schema-reconstruction-journal?
 "Read-only branch hint. This Boolean never grants the native writer window."
 [connection] (native-schema-journal-protected? (:store connection)))
(defn write-initialization-journal!
 "Fixed native startup consumer for opt-in protected journals. Source cannot
  create an apparent ready receipt or erase a submitted/uncertain initializer."
 [connection scope receipt events]
 (BeamLisp.Env/assert_native_framework_execution!)
 (migration-data! [scope receipt events])
 (when-not (and (string? scope) (<= 1 (erlang/byte_size scope) 8192)
                (erlang/is_map receipt) (= 1 (get receipt "version")) (= "startup" (get receipt "kind"))
                (vector? events) (<= 1 (count events) 8)
                (<= (erlang/external_size [scope receipt events]) 65536))
  (migration-enrollment-fail! :invalid-native-initialization-record))
 (let [actual (creation-evidence! connection)
       in-writer? (and (= (:resource actual) (Process/get :datom.conn/writing-store))
                       (= (erlang/self) (get-in actual [:connection :writer])))
       caller (if in-writer? (Process/get :datom.conn/native-journal-caller) (erlang/self))]
  ;; Initialization saves already execute in the actual native writer. Its
  ;; original accepted caller was captured by with-writer, never conveyed from
  ;; a caller-supplied dictionary. Actual writer identity is checked above.
  (when-not (and (= caller (get-in actual [:custody :owner])) (Process/alive? caller)
                 (nil? (get-in actual [:custody :origin])) (nil? (:creator actual))
                 (= :open @(:lifetime actual)) (native-schema-journal-protected? (:resource actual)))
   (migration-enrollment-fail! :native-schema-journal-custodian-required))
  (native-schema-journal-window! (:connection actual) :initialization {:scope scope :receipt receipt :events events})) :written)

(defn write-control-journal!
 "Fixed closed-data native activation/admission consumer. The native writer
  borrow and execution origin are checked before allocating a private turn.
  This API cannot write schema census or startup receipts, or execute tx functions."
 [connection forms]
 (BeamLisp.Env/assert_native_framework_execution!)
 (migration-data! forms)
 (let [allowed #{:db/id :upgrade/id :upgrade/snapshot :upgrade/events :upgrade/commands
                 :upgrade/scope :upgrade/active :upgrade.admission/key :upgrade.admission/operation
                 :upgrade.admission/entry :upgrade.admission/scope :upgrade.admission/active
                 :live-backup/key :live-backup/snapshot :live-backup/events}]
  (when-not (and (vector? forms) (<= 1 (count forms) 2)
                 (<= (erlang/external_size forms) 1048576)
                 (every? (fn [form]
                   (and (erlang/is_map form) (not (erlang/is_map_key :__struct__ form))
                        (every? allowed (keys form)) (contains? #{-1 -2} (:db/id form))
                        (> (count form) 1))) forms))
   (migration-enrollment-fail! :invalid-native-control-record)))
 (let [actual (creation-evidence! connection)
       in-writer? (and (= (:resource actual) (Process/get :datom.conn/writing-store))
                       (= (erlang/self) (get-in actual [:connection :writer])))
       caller (if in-writer? (Process/get :datom.conn/native-journal-caller) (erlang/self))]
  ;; Native engine/control borrowers may be different actual processes from
  ;; the creation custodian. No Source origin may invoke this fixed SDK writer;
  ;; creation-evidence! validates the actual native accepted lifetime borrow.
  (when-not (and (erlang/is_pid caller) (Process/alive? caller)
                 (nil? (get-in actual [:custody :origin])) (nil? (:creator actual))
                 (= :open @(:lifetime actual)) (native-schema-journal-protected? (:resource actual)))
   (migration-enrollment-fail! :native-schema-journal-custodian-required))
  (when-not (Process/alive? (get-in actual [:custody :owner]))
   (migration-enrollment-fail! :native-schema-journal-custodian-required))
  (when-not (= caller (get-in actual [:custody :owner]))
   ;; The actual accepted sender must be an original SDK native start rooted
   ;; at this exact Conn custodian. A supplied PID or current ancestry is not
   ;; evidence, and restarted/changed/unknown native classes refuse.
   (BeamLisp.Env/native_process_start_evidence! caller (get-in actual [:custody :owner])))
  (native-schema-journal-window! (:connection actual) :control forms)))

(defn native-journal-evidence!
 "Fixed native observer: every requested actual current record must have
  committed AFTER the internal durable native-guard epoch. Legacy Source-shaped
  journal rows are never upgraded to positive reconstruction authority."
 [connection selectors]
 (BeamLisp.Env/assert_native_framework_execution!)
 (migration-data! selectors)
 (when-not (and (vector? selectors) (<= 1 (count selectors) 8)
                (every? #(and (vector? %) (= 3 (count %))
                              (native-system-journal-attr? (get % 0))
                              (string? (get % 1)) (<= (erlang/byte_size (get % 1)) 8192)
                              (native-system-journal-attr? (get % 2))) selectors))
  (migration-enrollment-fail! :invalid-native-journal-evidence))
 (let [actual (creation-evidence! connection) c (:connection actual) store (:store c)
       epoch (datom.store/-get store NATIVE-JOURNAL-EPOCH-KEY) view (db c)]
  (when-not (and (= (erlang/self) (get-in actual [:custody :owner]))
                 (nil? (get-in actual [:custody :origin])) (nil? (:creator actual))
                 (= :open @(:lifetime actual)) (native-schema-journal-protected? (:resource actual))
                 (erlang/is_map epoch) (= #{:version :basis :nonce :contract} (set (keys epoch)))
                 (= 2 (:version epoch)) (= NATIVE-GUARD-CONTRACT (:contract epoch))
                 (erlang/is_integer (:basis epoch))
                 (<= FIRST-TX (:basis epoch) (datom.db/basis-t view)))
   (migration-enrollment-fail! :native-journal-provenance-required))
  (native-guard-anchor! c epoch)
  (doseq [[identity value attribute] selectors]
   (let [entity (datom.db/resolve-eid view [identity value])
         datoms (when entity (datom.db/datoms view :eavt entity attribute))]
    (when-not (and (= 1 (count datoms)) (> (datom.index/-tx (first datoms)) (:basis epoch)))
     (migration-enrollment-fail! :native-journal-provenance-required))))
  :confirmed))


;; Coupled to authenticated SDK-private target admission and the fixed Host
;; command ABI. This is not a Source callback/native-domain promotion API.
(def ^:private NATIVE-MUTATION-ROOTS :datom.conn/native-mutation-roots)
(def ^:private NATIVE-MUTATION-RETIRED :datom.conn/native-mutation-retired)
(def ^:private NATIVE-MUTATION-EFFECTS :datom.conn/native-mutation-effects)
(def ^:private NATIVE-MUTATION-CONSUMED :datom.conn/native-mutation-consumed)
(def ^:private NATIVE-CANONICAL-KINDS
 #{:coverage :gc-files :excise :install-schema :sync-schema :transact :load-facts
   :speculate :register-guard :remove-guard :rank-ensure :rank-advance :rank-retire :listen :unlisten})
(defn- native-mutation-root-id [row]
 (select-keys row [:application-id :root :path :resource :lifetime :custody :owner :incarnation]))
(defn- native-mutation-root! [cells store]
 ;; A claimed path is never the resource identity. Match the real Fjall handle
 ;; against original private registry resources BEFORE considering containment.
 (let [handle (when (erlang/is_map store) (maps/get :handle store nil))
       encoded (when handle (erlang/term_to_binary handle))
       _ (when (and encoded (some #(contains? (:resources (second %)) encoded)
                                  (get cells NATIVE-MUTATION-RETIRED {})))
           (migration-enrollment-fail! :native-command-retired-resource))
       actual (filterv (fn [[resource cell]]
                        (and handle (migration-policy/registry-cell? [resource cell])
                             (erlang/is_map resource) (= handle (maps/get :handle resource nil)))) cells)
       canonical-paths (mapv (fn [[resource _]] (maps/get :path resource nil)) actual)
       tag (when (erlang/is_map store) (maps/get :__struct__ store nil))
       fjall? (or handle (and (erlang/is_atom tag)
                            (= (BeamLisp.Record/info tag)
                               (tuple :record "datom.store-fjall" "FjallStore" (list :handle :path)))))
       path (when fjall? (maps/get :path store nil))
       rows (filterv
              (fn [[_ root]]
               (or (= store (:resource root))
                   (and handle (or (= handle (get-in root [:resource :handle]))
                                   (contains? (:native-resource-identities root {}) handle)
                                   (some #(= handle (get-in (second %) [:resource :handle])) (:declared-evidence root))))
                   (some #(migration-policy/under-root? (:root root) %) canonical-paths)
                   (migration-policy/under-root? (:root root) path)))
              (get cells NATIVE-MUTATION-ROOTS {}))]
  (when (> (count rows) 1) (migration-enrollment-fail! :native-command-root-ambiguous))
  (when-let [pair (first rows)]
   (when-not (and (= 1 (count actual)) (= store (first (first actual))))
    (migration-enrollment-fail! :native-command-original-resource-required))
   (let [row (second pair) root-cell (get cells (:resource row))]
    (when-not (and (= :active (:state row)) root-cell
                   (= :open @(:lifetime row)) (= (:lifetime row) (:lifetime root-cell))
                   (= (:custody row) (:creation-custody root-cell)) (Process/alive? (:owner row)))
     (migration-enrollment-fail! :native-command-root-unconfirmed))
    row))))
(defn- install-native-mutation-root! [connection]
 (BeamLisp.Env/assert_native_framework_execution!)
 (when (BeamLisp.Env/assert_execution_context!)
  (migration-enrollment-fail! :native-command-bootstrap-outside-generation-required))
 (doseq [[name arity] [[:register_native_command! 3] [:begin_native_command_boundary! 1]
                        [:end_native_command_boundary! 2] [:assert_native_command_context! 1]
                        [:dispatch_native_command! 2] [:assert_native_command_bootstrap_context! 1]
                        [:with_native_command_callback! 1] [:assert_native_command_turn! 1]
                        [:refresh_native_command_cells! 1] [:assert_critical_cell_mutation! 2] [:native_command_unknown! 1]
                        [:native_command_retirement_blocker! 1]
                        [:assert_native_command_callback_inactive! 0]
                        [:retire_native_command! 1] [:assert_native_command_retirement_context! 1]]]
  (when-not (erlang/function_exported :Elixir.BeamLisp.Env name arity)
   (migration-enrollment-fail! :native-canonical-mutation-contract-required)))
 (let [actual (creation-evidence! connection)
       owner (erlang/self)
       root ((BeamLisp.Env/sdk_callable! "proc.queue-family-root" "native-command-root!" 1) connection)
       _ (migration-native-store! connection) key (:resource root) reservation (erlang/make_ref)
       admitted (agent-get-and-update (registry)
        (fn [cells]
         (let [rows (get cells NATIVE-MUTATION-ROOTS {}) prior (get rows key)]
          (when-not (and (= (:resource actual) key) (= (:custody actual) (:custody root))
                         (= (:lifetime actual) (:lifetime root)) (= owner (:owner root)))
           (migration-enrollment-fail! :native-command-root-custody-required))
          (if prior
           (do (when-not (and (= :active (:state prior))
                              (= (native-mutation-root-id root) (native-mutation-root-id prior)))
                 (migration-enrollment-fail! :native-command-root-unconfirmed))
               (tuple :existing cells))
           (do (when (>= (count rows) 128) (migration-enrollment-fail! :native-command-root-capacity))
               (tuple :register (assoc-in cells [NATIVE-MUTATION-ROOTS key]
                                 (assoc root :state :registering :reservation reservation))))))) 30000)]
  (when (= :register admitted)
   ;; A lost registration reply holds the reserved root; no guessed retry.
   (let [credential (BeamLisp.Env/register_native_command! "datom.conn" "native-mutation-plan!" 1)]
    (agent-get-and-update (registry)
     (fn [cells]
      (let [row (get-in cells [NATIVE-MUTATION-ROOTS key])]
       (when-not (and (= reservation (:reservation row)) (= :registering (:state row)))
        (migration-enrollment-fail! :native-command-root-unconfirmed))
       (tuple :registered (assoc-in cells [NATIVE-MUTATION-ROOTS key]
                           (assoc row :state :active :credential credential))))) 30000)))
  (let [credential (Agent/get (registry) #(get-in % [NATIVE-MUTATION-ROOTS key :credential]) 30000)]
   (BeamLisp.Env/refresh_native_command_cells! credential))
  :registered))
(defn- native-mutation-cell! [cells store root owner]
 (let [cell (get cells store)]
  (when-not (and cell (= :open @(:lifetime cell)) (= owner (:writer cell))
                 (or (= store (:resource root))
                     (some (fn [[_ receipt]]
                             (and (= store (:resource receipt))
                                  (= (:lifetime cell) (:lifetime receipt))
                                  (= (:creation-custody cell) (:custody receipt))
                                  (= (:owner root) (get-in receipt [:custody :owner]))
                                  (nil? (get-in receipt [:custody :origin])) (nil? (:creator receipt))))
                           (:declared-evidence root))
                     (= (:application-id root) (get-in cell [:guard-creator :application-id]))))
   (migration-enrollment-fail! :native-command-writer-custody-required)) cell))
(defn- native-mutation-held? [cells root]
 (some #(and (= (native-mutation-root-id root) (:root (second %)))
             (contains? #{:issued :entered :unknown} (:state (second %))))
       (get cells NATIVE-MUTATION-EFFECTS {})))
(defn- native-mutation-unknown? [cells root]
 (or (some (fn [[_ effect]]
             (and (= (native-mutation-root-id root) (:root effect))
                  (or (= :unknown (:state effect)) (not (Process/alive? (:owner effect))))))
           (get cells NATIVE-MUTATION-EFFECTS {}))
     (BeamLisp.Env/native_command_unknown! (:credential root))))
(defn- native-mutation-resource-issued? [cells resource]
 (some (fn [[_ effect]] (and (= resource (:resource effect))
                             (contains? #{:issued :entered :unknown} (:state effect))))
       (get cells NATIVE-MUTATION-EFFECTS {})))
(defn- with-native-canonical-turn [connection kind action]
 (let [store (:store connection) root (Agent/get (registry) #(native-mutation-root! % store) 30000)]
  (if-not root (action)
   (do
    (when-not (contains? NATIVE-CANONICAL-KINDS kind)
     (migration-enrollment-fail! :native-command-kind-unsupported))
    (let [context (BeamLisp.Env/begin_native_command_boundary! (:credential root))
          owner (erlang/self) entered (atom false)]
     ;; Always leave an accepted Host boundary, including a refused private
     ;; registry admission. An unknown registry reply remains conservatively
     ;; visible as a private turn and blocks retirement; it is never retried.
     (try
      (let [observed (BeamLisp.Env/assert_native_command_context! context)
            boundary (:boundary observed)]
       (when-not (and (= owner (:caller observed)) (= (:credential root) (:credential observed))
                      (erlang/is_reference boundary) (erlang/is_integer (:source-depth observed)))
        (migration-enrollment-fail! :native-command-boundary-required))
       (agent-get-and-update (registry)
        (fn [cells]
         (let [current (native-mutation-root! cells store) cell (native-mutation-cell! cells store current owner)
               stack (:native-canonical-turns cell [])]
          (when (or (native-mutation-unknown? cells current) (>= (count stack) 8))
           (migration-enrollment-fail! :native-command-outcome-unconfirmed))
          (tuple :entered (assoc-in cells [store :native-canonical-turns]
            (conj stack {:boundary boundary :owner owner :depth (:source-depth observed)
                         :credential (:credential current) :root (native-mutation-root-id current)
                         :lifetime (:lifetime cell) :custody (:creation-custody cell) :kind kind}))))) 30000)
       (reset! entered true)
       (try (action)
        (finally
         (when @entered
          (agent-get-and-update (registry)
           (fn [cells]
            (let [stack (get-in cells [store :native-canonical-turns]) top (last stack)]
             (when-not (= boundary (:boundary top))
              (migration-enrollment-fail! :native-command-boundary-unconfirmed))
             (tuple :left (if (= 1 (count stack))
                           (update cells store dissoc :native-canonical-turns)
                           (assoc-in cells [store :native-canonical-turns] (pop stack)))))) 30000)))))
      (finally (BeamLisp.Env/end_native_command_boundary! (:credential root) context))))))))
(defn- with-canonical-writer [connection kind action]
 ;; Only the finite compiled SDK call sites use this PRIVATE adapter. The
 ;; generic public serialized!/with-writer callback never enters it implicitly.
 (let [store (:store connection)]
  ;; Check actual unknown/dead turns before with-writer can create a replacement
  ;; writer. Independent live resource turns retain normal parallel admission.
  (Agent/get (registry)
   (fn [cells]
    (when-let [root (native-mutation-root! cells store)]
     (when (native-mutation-unknown? cells root)
      (migration-enrollment-fail! :native-command-outcome-unconfirmed)))) 30000)
  (with-writer connection #(with-native-canonical-turn connection kind action))))
(defn- native-closed-tx? [store]
 (boolean (Agent/get (registry) #(native-mutation-root! % store) 30000)))
(defn- native-mutation-admit! [store]
 ;; BEFORE encoding, collection traversal or -update's user callback. This
 ;; issues no witness: actual fixed encoded effects are rechecked later.
 (let [root (Agent/get (registry) #(native-mutation-root! % store) 30000)]
  (if-not root :legacy
   (let [_ (BeamLisp.Env/assert_native_command_callback_inactive!)
         cell (Agent/get (registry) #(get % store) 30000)]
    (if-not (seq (:native-canonical-turns cell))
     (do (BeamLisp.Env/assert_native_framework_execution!)
         (Agent/get (registry)
          (fn [cells]
           (when (native-mutation-unknown? cells root)
            (migration-enrollment-fail! :native-command-outcome-unconfirmed))) 30000)
         :legacy)
     (let [observed (BeamLisp.Env/assert_native_command_turn! (:credential root))]
      (Agent/get (registry)
       (fn [cells]
        (let [current (native-mutation-root! cells store)
              actual (native-mutation-cell! cells store current (:caller observed))
              turn (last (:native-canonical-turns actual))]
         (when-not (and turn (= (:caller observed) (:owner turn))
                        (= (:credential observed) (:credential current) (:credential turn))
                        (= (:boundary observed) (:boundary turn))
                        (= (:source-depth observed) (:depth turn))
                        (= (:lifetime actual) (:lifetime turn))
                        (= (:creation-custody actual) (:custody turn))
                        (= (native-mutation-root-id current) (:root turn))
                        (not (native-mutation-unknown? cells current)))
          (migration-enrollment-fail! :native-command-turn-required)) :canonical)) 30000)))))))
(defn- native-mutation-encoded! [op arguments]
 (BeamLisp.CompilerData/check_first_order! arguments {:max-nodes 131072 :max-depth 16 :max-bytes 16777216})
 (when-not
  (case op
   :fjall-put (and (= 2 (count arguments)) (every? erlang/is_binary arguments))
   :fjall-delete (and (= 1 (count arguments)) (erlang/is_binary (first arguments)))
   :fjall-cas (and (= 3 (count arguments)) (erlang/is_binary (get arguments 0))
                  (or (nil? (get arguments 1)) (erlang/is_binary (get arguments 1)))
                  (erlang/is_binary (get arguments 2)))
   :fjall-commit (and (= 1 (count arguments)) (vector? (first arguments))
                     (every? (fn [entry]
                       (or (and (= :put (first entry)) (= 3 (count entry))
                                (every? erlang/is_binary (rest entry)))
                           (and (= :delete (first entry)) (= 2 (count entry))
                                (erlang/is_binary (get entry 1))))) (first arguments)))
   :fjall-sync (empty? arguments)
   false)
  (migration-enrollment-fail! :native-command-encoded-effect-invalid))
 (when (> (erlang/external_size arguments) 16777216)
  (migration-enrollment-fail! :native-command-effect-capacity)) :validated)
(defn native-mutation-effect!
 "Fixed primitive adapter. Possessing a store/Conn or running on its writer
  does not grant a turn. Actual Source callback depth must match the private
  canonical turn; no callback receives its credential or witness."
 [store op arguments]
 (let [root (Agent/get (registry) #(native-mutation-root! % store) 30000)]
  (if-not root :legacy
   (let [_ (BeamLisp.Env/assert_native_command_callback_inactive!)
         cell (Agent/get (registry) #(get % store) 30000)]
    (if-not (seq (:native-canonical-turns cell))
     ;; Trusted native SDK/IO can operate under G without being app Source.
     ;; Actual Source cannot use this branch, even on the original owner's PID.
     (do (BeamLisp.Env/assert_native_framework_execution!)
         (Agent/get (registry)
          (fn [cells]
           (when (native-mutation-unknown? cells root)
            (migration-enrollment-fail! :native-command-outcome-unconfirmed))) 30000)
         :legacy)
     (do
      (native-mutation-encoded! op arguments)
      (let [answer (BeamLisp.Env/dispatch_native_command! (:credential root)
                     {:version 1 :path (:path store) :op op :arguments arguments})]
       [:native-effect (first answer)])))))))
(defn- native-mutation-plan! [context payload]
 ;; Private dynamic invocation cannot fabricate a planning frame. Only the
 ;; Host invokes this exact immutable SDK body with its native-local token.
 (let [observed (BeamLisp.Env/assert_native_command_context! context)
       _ (BeamLisp.CompilerData/check_first_order! payload {:max-nodes 131072 :max-depth 16 :max-bytes 16777216})
       _ (when-not (and (= #{:version :path :op :arguments} (set (keys payload)))
                        (= 1 (:version payload)) (string? (:path payload))
                        (= (:path payload) (Path/expand (:path payload))))
           (migration-enrollment-fail! :native-command-payload-invalid))
       _ (native-mutation-encoded! (:op payload) (:arguments payload))
       witness (erlang/make_ref) key (Base/encode16 (crypto/strong_rand_bytes 32) (list (tuple :case :lower)))
       row (agent-get-and-update (registry)
        (fn [cells]
         (let [matches (filterv (fn [[store cell]]
                          (and (migration-policy/registry-cell? [store cell])
                               (= (:path payload) (when (erlang/is_map store) (:path store))))) cells)
               _ (when-not (= 1 (count matches)) (migration-enrollment-fail! :native-command-resource-ambiguous))
               [store _] (first matches) root (native-mutation-root! cells store)
               cell (native-mutation-cell! cells store root (:caller observed)) turn (last (:native-canonical-turns cell))
               effects (get cells NATIVE-MUTATION-EFFECTS {})]
          (when-not (and turn (= (:caller observed) (:owner turn))
                         (= (:boundary observed) (:boundary turn)) (= (:source-depth observed) (:depth turn))
                         (= (:credential observed) (:credential root) (:credential turn))
                         (= (:lifetime cell) (:lifetime turn)) (= (:creation-custody cell) (:custody turn))
                         (= (native-mutation-root-id root) (:root turn))
                         (not (native-mutation-unknown? cells root))
                         (not (native-mutation-resource-issued? cells store)) (< (count effects) 512))
           (migration-enrollment-fail! :native-command-turn-required))
          (let [row {:key key :witness witness :owner (:caller observed) :resource store
                     :lifetime (:lifetime cell) :custody (:creation-custody cell)
                     :root (:root turn) :boundary (:boundary turn) :depth (:depth turn)
                     :credential (:credential root) :state :issued
                     :op (:op payload) :arguments (:arguments payload)}]
           (tuple row (assoc-in cells [NATIVE-MUTATION-EFFECTS witness] row))))) 30000)]
  {:witness witness :effects [{:op (:op row) :arguments (:arguments row)}] :result :effect-results}))
(defn- native-mutation-witness! [context witness]
 (let [observed (BeamLisp.Env/assert_native_command_context! context)]
  (agent-get-and-update (registry)
   (fn [cells]
    (let [row (get-in cells [NATIVE-MUTATION-EFFECTS witness]) store (:resource row)
          root (native-mutation-root! cells store) cell (native-mutation-cell! cells store root (:caller observed))
          turn (last (:native-canonical-turns cell))]
     (when-not (and row (= witness (:witness row)) (= :issued (:state row))
                    (not (native-mutation-unknown? cells root))
                    (= (:owner row) (:caller observed))
                    (= (:credential observed) (:credential root) (:credential row))
                    (= (:boundary observed) (:boundary row) (:boundary turn))
                    (= (:source-depth observed) (:depth row) (:depth turn))
                    (= (:root row) (native-mutation-root-id root))
                    (= (:lifetime row) (:lifetime cell)) (= (:custody row) (:creation-custody cell)))
      (migration-enrollment-fail! :native-command-witness-refused))
     (tuple {:resource store :native-handle (:handle store) :lifetime (:lifetime row)
             :writer (:owner row) :source-depth (:depth row) :boundary (:boundary row)
             :effects [{:op (:op row) :arguments (:arguments row)}]}
            (assoc-in cells [NATIVE-MUTATION-EFFECTS witness :state] :entered)))) 30000)))
(defn- native-mutation-outcome! [context witness outcome]
 (let [observed (BeamLisp.Env/assert_native_command_context! context)]
  (agent-get-and-update (registry)
   (fn [cells]
    (let [row (get-in cells [NATIVE-MUTATION-EFFECTS witness])]
     (when-not (and row (= :entered (:state row)) (= (:owner row) (:caller observed))
                    (= (:credential observed) (:credential row))
                    (= (:boundary observed) (:boundary row))
                    (= (:source-depth observed) (:depth row))
                    (= :open @(:lifetime row))
                    (= (:lifetime row) (get-in cells [(:resource row) :lifetime]))
                    (= (:custody row) (get-in cells [(:resource row) :creation-custody]))
                    (contains? #{:known :unknown} outcome))
      (migration-enrollment-fail! :native-command-outcome-unconfirmed))
     (if (= :unknown outcome)
      (tuple :held (assoc-in cells [NATIVE-MUTATION-EFFECTS witness :state] :unknown))
      (let [consumed (conj (get cells NATIVE-MUTATION-CONSUMED [])
                       {:witness witness :key (:key row) :state :consumed})
            retained (vec (drop (max 0 (- (count consumed) 256)) consumed))]
       (tuple :consumed (-> cells
                          (update NATIVE-MUTATION-EFFECTS dissoc witness)
                          (assoc NATIVE-MUTATION-CONSUMED retained))))))) 30000)))


(def ^:private NATIVE-GUARD-DIRECTORY ".foundry-native-command-guard-v1")
(defn- native-guard-fixed [name arity]
 (BeamLisp.Env/sdk_callable! "datom.store-fjall" name arity))
(defn- native-guard-root! [connection]
 (BeamLisp.Env/assert_native_framework_execution!)
 (let [actual (creation-evidence! connection)
       root (Agent/get (registry) #(native-mutation-root! % (:resource actual)) 30000)]
  (when-not (and root (= (erlang/self) (:owner root))
                 (= (:resource actual) (:resource root)) (= (:lifetime actual) (:lifetime root))
                 (= (:custody actual) (:custody root)) (= :open @(:lifetime actual))
                 (nil? (get-in actual [:custody :origin])) (nil? (:creator actual)))
   (migration-enrollment-fail! :native-guard-original-custody-required)) root))
(defn- native-guard-schema-digest [connection]
 (Base/encode16 (crypto/hash :sha256
   (erlang/term_to_binary (vec (sort-by first (migration-canonical-schema! @(:schema connection))))))
  (list (tuple :case :lower))))
(defn- native-guard-stat [path]
 (let [found (File/lstat path)]
  (cond (= :ok (elem found 0)) (elem found 1)
        (= :enoent (elem found 1)) nil
        :else (migration-enrollment-fail! :native-guard-receipt-io-refused))))
(defn- native-guard-epoch! [epoch]
 (when-not (and (erlang/is_map epoch) (= #{:version :basis :nonce :contract} (set (keys epoch)))
                (= 2 (:version epoch)) (= NATIVE-GUARD-CONTRACT (:contract epoch))
                (erlang/is_integer (:basis epoch)) (<= FIRST-TX (:basis epoch))
                (string? (:nonce epoch)) (Regex/match? #"^[a-f0-9]{64}$" (:nonce epoch)))
  (migration-enrollment-fail! :native-guard-epoch-invalid)) epoch)
(defn- native-guard-anchor! [connection epoch]
 ;; The fixed durable receipt is outside Source's Store keyspace. OS/filesystem
 ;; and explicit native IO remain trusted; this is not a File sandbox.
 (let [root (native-guard-root! connection) directory (str (:root root) "/" NATIVE-GUARD-DIRECTORY)
       stat (native-guard-stat directory)]
  (when (and epoch (nil? stat))
   (migration-enrollment-fail! :native-guard-unanchored-store-marker))
  (when (and (nil? stat)
             (some #(String/starts_with? % (str NATIVE-GUARD-DIRECTORY ".pending-")) (File/ls! (:root root))))
   (migration-enrollment-fail! :native-guard-publication-unknown))
  (when stat
   (let [path (str directory "/receipt.json") file (native-guard-stat path)]
    (when-not (and (= :directory (:type stat)) (= :regular (:type file))
                   (<= 1 (:size file) 16384) (= #{"receipt.json"} (set (File/ls! directory))))
     (migration-enrollment-fail! :native-guard-receipt-invalid))
    (let [receipt (Jason/decode! (File/read! path))
          _ (migration-data! receipt)
          _ (when-not (and (= #{"version" "contract" "root" "journal" "basis" "nonce" "schemaDigest"}
                              (set (keys receipt)))
                           (= 1 (get receipt "version")) (= NATIVE-GUARD-CONTRACT (get receipt "contract"))
                           (= (:root root) (get receipt "root")) (= (:path root) (get receipt "journal"))
                           (erlang/is_integer (get receipt "basis")) (<= FIRST-TX (get receipt "basis"))
                           (string? (get receipt "nonce")) (Regex/match? #"^[a-f0-9]{64}$" (get receipt "nonce"))
                           (string? (get receipt "schemaDigest"))
                           (Regex/match? #"^[a-f0-9]{64}$" (get receipt "schemaDigest")))
              (migration-enrollment-fail! :native-guard-receipt-invalid))
          expected {:version 2 :contract NATIVE-GUARD-CONTRACT :basis (get receipt "basis") :nonce (get receipt "nonce")}]
     (if epoch
      (when-not (and (= expected (native-guard-epoch! epoch)) (<= (:basis epoch) @(:basis connection)))
       (migration-enrollment-fail! :native-guard-receipt-mismatch))
      ;; Reconcile only completed native receipt publication with untouched
      ;; logical schema/basis. No Source initializer/migration is replayed.
      (when-not (and (= (get receipt "basis") @(:basis connection))
                     (= (get receipt "schemaDigest") (native-guard-schema-digest connection)))
       (migration-enrollment-fail! :native-guard-interrupted-install-unconfirmed)))
     ((native-guard-fixed "sync-directory!" 1) directory)
     {:root root :directory directory :epoch expected :receipt receipt})))))
(defn- native-guard-publish! [connection]
 (let [root (native-guard-root! connection)
       nonce (Base/encode16 (crypto/strong_rand_bytes 32) (list (tuple :case :lower)))
       destination (str (:root root) "/" NATIVE-GUARD-DIRECTORY)
       stage (str destination ".pending-" nonce)
       receipt {"version" 1 "contract" NATIVE-GUARD-CONTRACT "root" (:root root) "journal" (:path root)
                "basis" @(:basis connection) "nonce" nonce "schemaDigest" (native-guard-schema-digest connection)}
       bytes (Jason/encode! receipt)]
  (when (or (native-guard-stat destination) (native-guard-stat stage) (> (erlang/byte_size bytes) 16384))
   (migration-enrollment-fail! :native-guard-publication-refused))
  (File/mkdir! stage)
  (File/write! (str stage "/receipt.json") bytes (list :exclusive))
  ;; This existing native publisher fsyncs the tiny private tree, publishes
  ;; without clobbering, and fsyncs its parent. Unknown ack retains the stage or
  ;; destination; no blind cleanup/overwrite is recovery authority.
  ((native-guard-fixed "publish-directory!" 2) stage destination)
  (native-guard-anchor! connection nil)))

(defn native-mutation-retirement-blocker [application root-path]
 (let [pid (erlang/whereis REGISTRY)]
  (when-not (= :undefined pid)
   (Agent/get pid
    (fn [cells]
     (let [roots (filterv #(and (= application (:application-id (second %)))
                                (= root-path (:root (second %)))) (get cells NATIVE-MUTATION-ROOTS {}))]
      (when (some (fn [[_ root]]
                    (or (not= :active (:state root)) (native-mutation-held? cells root)
                        (BeamLisp.Env/native_command_retirement_blocker! (:credential root))
                        (some (fn [[store cell]]
                                (and (migration-policy/registry-cell? [store cell])
                                     (seq (:native-canonical-turns cell))
                                     (= (native-mutation-root-id root) (:root (last (:native-canonical-turns cell)))))) cells))) roots)
       :native-command-outcome-unconfirmed))) 30000))))

(defn native-guard-backup-evidence!
 "Read the fixed durable native receipt on the actual original Root owner.
  A borrowed Conn, Source callback, supplied path or Store marker grants no
  authority. Bytes are immutable native inventory, never application payload."
 [connection]
 (BeamLisp.Env/assert_native_framework_execution!)
 (let [epoch (datom.store/-get (:store connection) NATIVE-JOURNAL-EPOCH-KEY)
       anchor (native-guard-anchor! connection epoch)]
  (when-not (and epoch anchor)
   (migration-enrollment-fail! :native-guard-backup-anchor-required))
  {:path (str NATIVE-GUARD-DIRECTORY "/receipt.json")
   :bytes (File/read! (str (:directory anchor) "/receipt.json"))
   :epoch (:epoch anchor)}))

(defn- native-command-bootstrap! [context]
 ;; Fixed Host registration observer. Neither a fabricated context nor a
 ;; Source-shaped row can promote original native Root/Conn custody.
 (let [observed (BeamLisp.Env/assert_native_command_bootstrap_context! context)
       owner (:caller observed)
       row (Agent/get (registry)
            (fn [cells]
             (let [matches (filterv #(and (= :registering (:state (second %)))
                                          (= owner (:owner (second %))))
                                    (get cells NATIVE-MUTATION-ROOTS {}))]
              (when-not (= 1 (count matches))
               (migration-enrollment-fail! :native-command-bootstrap-root-required))
              (second (first matches)))) 30000)
       connection (registered-at (:path row))
       _ (when-not connection (migration-enrollment-fail! :native-command-bootstrap-conn-required))
       actual (creation-evidence! connection)
       root ((BeamLisp.Env/sdk_callable! "proc.queue-family-root" "native-command-root!" 1) connection)]
  (when-not (and (= 0 (:source-depth observed)) (nil? (:generation observed))
                 (= owner (erlang/self) (:owner root))
                 (= (native-mutation-root-id row) (native-mutation-root-id root))
                 (= (:resource actual) (:resource root)) (= (:lifetime actual) (:lifetime root))
                 (= (:custody actual) (:custody root)) (= :open @(:lifetime actual))
                 (= owner (get-in actual [:custody :owner]))
                 (nil? (get-in actual [:custody :origin])) (nil? (:creator actual)))
   (migration-enrollment-fail! :native-command-bootstrap-custody-required))
  (migration-native-store! connection)
  (native-mutation-root-id root)))

(def ^:private NATIVE-CRITICAL-CELL-FIELDS
 [:schema :basis :lifetime :snapshot :schema-publication :subs])
(defn- native-command-cell-census! [context]
 (let [observed (BeamLisp.Env/assert_native_command_census_context! context)
       credential (:credential observed)]
  (agent-get-and-update (registry)
   (fn [cells]
    (let [matches (filterv #(= credential (:credential (second %))) (get cells NATIVE-MUTATION-ROOTS {}))
          _ (when-not (= 1 (count matches)) (migration-enrollment-fail! :native-command-census-root-required))
          [root-key root] (first matches)
          _ (when-not (and (= :active (:state root)) (= :open @(:lifetime root))
                           (Process/alive? (:owner root)))
              (migration-enrollment-fail! :native-command-root-unconfirmed))
          resources (filterv (fn [[resource cell]]
                       (and (migration-policy/registry-cell? [resource cell])
                            (= :open @(:lifetime cell))
                            (or (= resource (:resource root))
                                (migration-policy/under-root? (:root root) (:path resource))))) cells)
          _ (when (> (count resources) 1024) (migration-enrollment-fail! :native-command-cell-capacity))
          records (vec (mapcat (fn [[resource cell]]
                     (when-not (and (= :open @(:lifetime cell)) (:creation-custody cell))
                      (migration-enrollment-fail! :native-command-cell-custody-required))
                     (keep (fn [field]
                       (let [target (get cell field)]
                        (when (and (erlang/is_map target)
                                   (= :Elixir.BeamLisp.Atom (maps/get :__struct__ target nil)))
                         {:atom target :field field :resource resource :lifetime (:lifetime cell)
                          :custody (:creation-custody cell)}))) NATIVE-CRITICAL-CELL-FIELDS)) resources))
          identities (reduce (fn [known [resource _]]
                              (let [handle (:handle resource) previous (get known handle)]
                               (when (and previous (not= previous resource))
                                (migration-enrollment-fail! :native-command-resource-identity-collision))
                               (assoc known handle resource))) (:native-resource-identities root {}) resources)
          _ (when (> (count identities) 4096) (migration-enrollment-fail! :native-command-resource-capacity))]
     (tuple records (assoc-in cells [NATIVE-MUTATION-ROOTS root-key :native-resource-identities] identities)))) 30000)))
(defn- native-cell-mutation-witness! [context request]
 (let [observed (BeamLisp.Env/assert_native_command_context! context)]
  (Agent/get (registry)
   (fn [cells]
    (let [resource (:resource request) root (native-mutation-root! cells resource)
          cell (native-mutation-cell! cells resource root (:caller observed))
          turn (last (:native-canonical-turns cell)) target (get cell (:field request))
          actual-id (BeamLisp.LazyMemo/id (maps/get (:slot request) target))]
     (when-not (and (= #{:resource :lifetime :custody :atom :field :slot :cell-id} (set (keys request)))
                    (contains? (set NATIVE-CRITICAL-CELL-FIELDS) (:field request))
                    (contains? #{:cell :watches} (:slot request))
                    (= target (:atom request)) (= actual-id (:cell-id request))
                    (= (:lifetime request) (:lifetime cell)) (= (:custody request) (:creation-custody cell))
                    turn (= (:caller observed) (:owner turn))
                    (= (:credential observed) (:credential root) (:credential turn))
                    (= (:boundary observed) (:boundary turn)) (= (:source-depth observed) (:depth turn))
                    (= (:root turn) (native-mutation-root-id root))
                    (not (native-mutation-unknown? cells root)))
      (migration-enrollment-fail! :native-command-critical-cell-refused))
     {:resource resource :lifetime (:lifetime cell) :boundary (:boundary turn)
      :cell-id actual-id :atom target :field (:field request) :slot (:slot request)})) 30000)))
(defn- migration-policy-finish-connect! [connection]
 (let [ready (migration-policy-finish-connect-existing! connection)
       root (Agent/get (registry) #(native-mutation-root! % (:store ready)) 30000)]
  (when root (BeamLisp.Env/refresh_native_command_cells! (:credential root))) ready))
(defn- native-canonical-connection! [connection]
 (let [store (when (erlang/is_map connection) (maps/get :store connection nil))
       root (Agent/get (registry) #(native-mutation-root! % store) 30000)]
  (when root
   ;; Check at the sending caller before writer handoff, including generic
   ;; serialized! on another protected resource. Native0 callback state must
   ;; not disappear merely by queuing work to another SDK writer PID.
   (BeamLisp.Env/assert_native_command_callback_inactive!)
   (let [cell (Agent/get (registry) #(get % store) 30000)
         exact? (and (erlang/is_map connection)
                     (= Conn (maps/get :__struct__ connection nil))
                     (= (set (keys connection))
                        #{:__struct__ :store :schema :basis :writer :subs :blobs :lifetime :snapshot :schema-publication})
                     (lifetime-borrow-identity? connection cell))]
    (when-not exact?
     ;; A schema shadow is an INTERNAL already-entered canonical SDK view.
     ;; Source flags cannot supply its original writer/turn/depth or fence.
     (let [observed (BeamLisp.Env/assert_native_command_turn! (:credential root))
           turn (last (:native-canonical-turns cell))]
      (when-not (and turn (= (:caller observed) (:writer cell) (:owner turn))
                     (= (:boundary observed) (:boundary turn)) (= (:source-depth observed) (:depth turn))
                     (contains? #{:install-schema :sync-schema} (:kind turn))
                     (= true (:prospective-schema connection)) (nil? (:snapshot connection))
                     (every? #(= (get connection %) (get cell %))
                       [:basis :writer :subs :blobs :lifetime :schema-publication])
                     (erlang/is_map (:schema connection))
                     (= :Elixir.BeamLisp.Atom (maps/get :__struct__ (:schema connection) nil))
                     (= @(:schema-publication cell) @(:schema connection)))
       (migration-enrollment-fail! :native-command-original-connection-required))))))) connection)

(defn- native-connection-exposure! [connection]
 (when (and (erlang/function_exported :Elixir.BeamLisp.Env :source_execution_observation! 0)
            (> (:source-depth (BeamLisp.Env/source_execution_observation!)) 0))
  (let [root (Agent/get (registry) #(native-mutation-root! % (:store connection)) 30000)]
   (when root
    (Agent/get (registry)
     (fn [cells]
      (let [cell (get cells (:store connection)) phase (:migration-phase cell)]
       (when (and phase (not (contains? #{:ready :complete} (:state phase))))
        (migration-enrollment-fail! :native-command-resource-not-ready)))) 30000)
    (BeamLisp.Env/refresh_native_command_cells! (:credential root))))) connection)


(defn- native-command-retirement-cells! [cells root]
 ;; Pure metadata preflight; no forcing user callbacks or Store protocols.
 ;; Every live managed resource is closed only after ALL graph native retirements
 ;; and accepted schema/publication phases have already positively completed.
 (when-not (and (= :active (:state root)) (Process/alive? (:owner root))
                (= :open @(:lifetime root)) (not (native-mutation-held? cells root)))
  (migration-enrollment-fail! :native-command-known-root-close-required))
 (datom.store-opening/check-publication! cells (:application-id root) (:root root))
 (doseq [[_ policy] (get cells (migration-policy/table-key) {})]
  (when (= (:resource root) (get-in policy [:root-id :resource]))
   (when-not (and (= :active (:state policy)) (empty? (:permits policy)))
    (migration-enrollment-fail! :native-command-policy-close-unconfirmed))))
 (let [members (filterv (fn [[resource cell]]
                         (and (migration-policy/registry-cell? [resource cell])
                              (or (= resource (:resource root))
                                  (contains? (:native-resource-identities root {}) (:handle resource))))) cells)]
  (when-not (some #(= (:resource root) (first %)) members)
   (migration-enrollment-fail! :native-command-original-root-connection-required))
  (doseq [[resource cell] members]
   (let [blob (:blobs cell) tag (when (erlang/is_map blob) (:__struct__ blob))]
    ;; The supported fixed cleanup is the ordinary durable SDK blob tier.
    ;; Never dispatch a caller/custom Blob Closeable after a privileged sync.
    (when-not (and (erlang/is_atom tag) (BeamLisp.AOT/sdk_generated_class? tag)
                   (= (BeamLisp.Record/info tag)
                      (tuple :record "datom.blob-fs" "BlobFs" (list :dir :ephemeral?)))
                   (= false (:ephemeral? blob)) (= (str (:path resource) ".blobs") (:dir blob)))
     (migration-enrollment-fail! :native-command-retirement-fixed-blob-tier-required)))
   (when-not (and (= :open @(:lifetime cell)) (Process/alive? (:writer cell))
                  (empty? (:lifetime-borrowers cell)) (empty? (:observers cell))
                  (empty? (:native-canonical-turns cell))
                  (nil? (:guard-reservation cell)) (nil? (:native-schema-journal-window cell))
                  (nil? @(:schema-publication cell))
                  (not (contains? #{:initializing :running :uncertain} (get-in cell [:migration-phase :state]))))
    (migration-enrollment-fail! :native-command-resource-close-unconfirmed))) members))
(defn- native-command-member-connection [resource cell]
 (assoc (->Conn resource (:schema cell) (:basis cell) (:writer cell) (:subs cell) (:blobs cell) (:lifetime cell))
        :snapshot (:snapshot cell) :schema-publication (:schema-publication cell)))
(defn- native-command-retirement-check! [connection retirement]
 (let [observed (BeamLisp.Env/assert_native_command_retirement_context! (:context retirement))]
  (when-not (and (= :release (:phase observed)) (= (:credential retirement) (:credential observed))
                 (= (erlang/self) (:caller observed) (:owner retirement))
                 (= 0 (:source-depth observed)) (nil? (:generation observed)))
   (migration-enrollment-fail! :native-command-retirement-context-required))
  (Agent/get (registry)
   (fn [cells]
    (let [root (get-in cells [NATIVE-MUTATION-ROOTS (:root-resource retirement)])
          cell (get cells (:store connection))]
     (when-not (and root (= :retiring (:state root))
                    (= (:context retirement) (:retirement-context root))
                    (= (:credential retirement) (:credential root))
                    (lifetime-borrow-identity? connection cell)
                    (some #(= connection %) (:retirement-connections root)))
      (migration-enrollment-fail! :native-command-retirement-connection-required)))) 30000)) :confirmed)
(defn- native-command-retirement! [context stage]
 (let [observed (BeamLisp.Env/assert_native_command_retirement_context! context)
       credential (:credential observed) owner (erlang/self)]
  (when-not (and (= owner (:caller observed)) (= 0 (:source-depth observed))
                 (nil? (:generation observed)) (= stage (:phase observed)) (contains? #{:preflight :release} stage))
   (migration-enrollment-fail! :native-command-retirement-context-required))
  (case stage
   :preflight
   (let [root (Agent/get (registry)
               (fn [cells]
                (let [rows (filterv #(= credential (:credential (second %))) (get cells NATIVE-MUTATION-ROOTS {}))]
                 (when-not (= 1 (count rows)) (migration-enrollment-fail! :native-command-retirement-root-required))
                 (second (first rows)))) 30000)
         connection (registered-at (:path root))
         proof ((BeamLisp.Env/sdk_callable! "proc.queue-family-root" "native-command-retired-root!" 1) connection)]
    (agent-get-and-update (registry)
     (fn [cells]
      (let [current (get-in cells [NATIVE-MUTATION-ROOTS (:resource root)])
            members (native-command-retirement-cells! cells current)
            connections (mapv (fn [[resource cell]] (native-command-member-connection resource cell)) members)
            resources (vec (vals (:native-resource-identities current)))
            root-connection (first (filter #(= (:resource root) (:store %)) connections))]
       (when-not (and (= root current) (= owner (:owner current))
                      (= (:resource-key proof) (erlang/term_to_binary (get-in root [:resource :handle])))
                      (= (:application-id proof) (:application-id root)) (= (:root proof) (:root root))
                      (= (:lifetime root) (:lifetime root-connection))
                      (every? #(contains? (:native-resource-identities current) (:handle (first %))) members)
                      (<= 1 (count resources) 4096))
        (migration-enrollment-fail! :native-command-retirement-inventory-required))
       (tuple {:root (native-mutation-root-id root) :resources resources}
        (assoc-in cells [NATIVE-MUTATION-ROOTS (:resource root)]
         (assoc current :state :retiring :retirement-context context :retirement-proof proof
                        :retirement-connections (vec (concat (remove #(= (:resource root) (:store %)) connections)
                                                           [root-connection])))))) 30000)))
   :release
   (let [root (Agent/get (registry)
               (fn [cells]
                (let [rows (filterv #(and (= credential (:credential (second %)))
                                          (= context (:retirement-context (second %)))) (get cells NATIVE-MUTATION-ROOTS {}))]
                 (when-not (= 1 (count rows)) (migration-enrollment-fail! :native-command-retirement-root-required))
                 (second (first rows)))) 30000)
         retirement {:credential credential :context context :owner owner :root-resource (:resource root)}]
    (when-not (and (= :retiring (:state root)) (= owner (:owner root)))
     (migration-enrollment-fail! :native-command-retirement-root-required))
    (doseq [connection (:retirement-connections root)]
     (release-connection! connection retirement)
     ;; Fjall was already synced. Preflight proved the exact durable SDK
     ;; BlobFs whose close is a no-op; no arbitrary protocol/callback runs.
     nil)
    (agent-get-and-update (registry)
     (fn [cells]
      (let [current (get-in cells [NATIVE-MUTATION-ROOTS (:resource root)])
            root-key (erlang/term_to_binary (get-in root [:resource :handle]))
            resources (set (map erlang/term_to_binary (keys (:native-resource-identities root))))
            notes (get cells NATIVE-MUTATION-RETIRED {})]
       (when-not (and (= root current) (= :closed @(:lifetime root))
                      (every? #(and (= :closed @(:lifetime %)) (nil? (get cells (:store %)))) (:retirement-connections root))
                      (not (native-mutation-held? cells root)) (not (contains? notes root-key)) (< (count notes) 128))
        (migration-enrollment-fail! :native-command-retirement-close-unconfirmed))
       (let [policies (into {} (remove #(= (:resource root) (get-in (second %) [:root-id :resource]))
                                      (get cells (migration-policy/table-key) {})))
             next (-> cells
                      (update NATIVE-MUTATION-ROOTS dissoc (:resource root))
                      (assoc (migration-policy/table-key) policies)
                      (assoc-in [NATIVE-MUTATION-RETIRED root-key]
                       {:state :retired :owner owner :credential credential
                        :lifetime-id (BeamLisp.LazyMemo/id (:cell (:lifetime root)))
                        :application-id (:application-id root) :root (:root root)
                        :resources resources}))]
        (erlang/apply :persistent_term :put
         (list :datom-migration-policy-roots (into {} (map (fn [[app policy]] [app (:root policy)]) policies))))
        (tuple {:state :closed :root (native-mutation-root-id root)} next)))) 30000)))))
(defn- native-command-close-sync! [connection]
 (native-canonical-connection! connection)
 (let [root (Agent/get (registry) #(native-mutation-root! % (:store connection)) 30000)]
  (when root
   (with-canonical-writer connection :transact #(datom.store/sync! (:store connection))) true)))
(defn- native-command-close-root! [connection]
 (let [store (when (erlang/is_map connection) (:store connection))
       encoded (when (:handle store) (erlang/term_to_binary (:handle store)))
       retired (when encoded (Agent/get (registry) #(get-in % [NATIVE-MUTATION-RETIRED encoded]) 30000))]
  (if retired
   (do
    (BeamLisp.Env/assert_native_framework_execution!)
    (when-not (and (= (erlang/self) (:owner retired))
                   (= (:lifetime-id retired) (BeamLisp.LazyMemo/id (:cell (:lifetime connection))))
                   (= :retired (:state (BeamLisp.Env/native_command_evidence! (:credential retired)))))
     (migration-enrollment-fail! :native-command-retirement-outcome-unconfirmed)) :retired)
   (let [root (Agent/get (registry) #(native-mutation-root! % store) 30000)]
    (when (and root (= store (:resource root)))
     (BeamLisp.Env/assert_native_framework_execution!)
     (native-canonical-connection! connection)
     ((BeamLisp.Env/sdk_callable! "proc.queue-family-root" "native-command-retired-root!" 1) connection)
     (when-not (= (erlang/self) (:owner root))
      (migration-enrollment-fail! :native-command-original-root-owner-required))
     ;; Known readiness refuses BEFORE Host accepts a retirement attempt.
     (Agent/get (registry) #(native-command-retirement-cells! % root) 30000)
     (BeamLisp.Env/retire_native_command! (:credential root)))))))
(defn close-owned-native-roots!
 "Fixed native lifecycle cleanup, after actual graph retirement. Protected
  resource list is derived privately; caller handles select no extra authority."
 [connections]
 (let [roots (Agent/get (registry) #(vals (get % NATIVE-MUTATION-ROOTS {})) 30000)]
  (when (seq roots)
   (BeamLisp.Env/assert_native_framework_execution!)
   (doseq [connection connections]
    (when (some #(= (:store connection) (:resource %)) roots)
     (native-command-close-root! connection)))) :ok))

(defn- native-command-protected-root? [resource]
 (let [pid (erlang/whereis REGISTRY)]
  (and (not= :undefined pid)
       (Agent/get pid #(boolean (get-in % [NATIVE-MUTATION-ROOTS resource])) 30000))))
