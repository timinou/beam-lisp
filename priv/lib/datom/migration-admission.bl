; Public SDK supported lane: no product-specific coordinator or transform.
(ns datom.migration-admission (:require [datom.conn :as conn] [datom.migrate]
                                       [datom.store-fjall] [reload.execution :as execution]))
(defn install! [] (conn/install-migration-policy!))
(defn open! [path schema-defs] (conn/open-migration-connection! path schema-defs))
(defn expand! [] (conn/expand-migration-policy!))
(defn status [] (conn/migration-policy-status))
(defn with-publication! [action] (conn/with-migration-publication-reservation! action))
