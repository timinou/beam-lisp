;; Pure proof for reusing an attribute artifact; unknown and future means miss.
(ns datom.cache-validity
  (:require [datom.schema] [datom.db :as db] [datom.store :as store] [datom.attr-basis :as marks]
            [datom.query.relation :as relation]))

(defn reusable?
  "A cached column built at `built` can describe `reader` only when the last
   known attribute write is positive and no later than its build. A future
   artifact is never evidence about a historical reader."
  [reader built mark]
  (and (erlang/is_integer reader) (erlang/is_integer built) (erlang/is_integer mark)
       (<= 0 built reader) (< 0 mark) (<= mark built)))

(def QUERY-NAMESPACES
  '("core" "sugar" "rt" "datom.db" "datom.index" "datom.schema" "datom.store"
    "datom.attr-basis" "datom.cache-validity" "datom.query.engine"
    "datom.query.parse" "datom.query.read-plan" "datom.query.plan" "datom.query.agg"
    "datom.query.relation" "datom.query.analytic" "datom.query.rules"
    "datom.codec" "datom.store-ets" "datom.store-map" "datom.store-fjall" "datom.profile"
    "datom.attr-marks" "datom.derived" "datom.value-codec"
    "datom.blob" "datom.blob-ets" "datom.blob-fs" "datom.file"
    "datom.datalog" "datom.explain" "datom.query.corpus" "datom.query.fixpoint"
    "datom.vector" "datom.compound" "datom.index-coverage"
    "data.bounded-cache" "data.cache-budget" "data.cache-ring" "data.cache-pool"))

(defn definition-stamp []
  (when (erlang/function_exported :Elixir.BeamLisp.Env :namespace_generations 1)
    (BeamLisp.Env/namespace_generations (to-list QUERY-NAMESPACES))))

(defn- attribute-stamp [database s basis attr opts]
 (let [mark (marks/basis-t-for s attr nil)]
  (if (some? mark) mark
   (if (and (= true (:prove-empty? opts))
             (datom.schema/known? (:schema database) attr))
    (let [page (db/attribute-page database attr nil 1)]
     ;; A zero-row page is NOT enough: retracted groups can precede visible
     ;; facts. Only an exhausted native page proves this snapshot is empty.
     (if (and (empty? (:datoms page)) (not (:more? page))) {:empty? true} basis))
    basis))))

(defn read-stamp
  "Attribute evidence for one current immutable view. Missing marks use the
   exact reader basis, recording unknown reads conservatively. With explicit
   `{:prove-empty? true}`, a missing mark may instead use a pure exhausted
   native attribute page as negative evidence. Nonempty or incomplete reads
   remain conservative. Future evidence and behavioral wrappers decline reuse."
  ([database attrs] (read-stamp database attrs {}))
  ([database attrs opts]
  (let [s (db/store-of database) basis (db/basis-t database)]
    (when (and (erlang/function_exported :Elixir.BeamLisp.Env :namespace_generations 1)
               (= (store/identity-of s) (store/capability-target s))
               (= :current (:filter-mode database)) (nil? (:since-t database))
               (nil? (:valid-at database)) (nil? (:valid-between database)))
      (let [stamps (mapv (fn [a] (attribute-stamp database s basis a opts)) attrs)]
        (when (every? (fn [t] (or (= {:empty? true} t)
                                 (and (erlang/is_integer t) (<= 0 t basis)))) stamps)
          (when-let [providers (relation/stored-attributes-stamp attrs)]
            (when-let [generation (definition-stamp)] [generation stamps providers]))))))))
