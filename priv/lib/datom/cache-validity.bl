;; Pure proof for reusing an attribute artifact; unknown and future means miss.
(ns datom.cache-validity
  (:require [datom.db :as db] [datom.store :as store] [datom.attr-basis :as marks]))

(defn reusable?
  "A cached column built at `built` can describe `reader` only when the last
   known attribute write is positive and no later than its build. A future
   artifact is never evidence about a historical reader."
  [reader built mark]
  (and (erlang/is_integer reader) (erlang/is_integer built) (erlang/is_integer mark)
       (<= 0 built reader) (< 0 mark) (<= mark built)))

(defn read-stamp
  "Attribute evidence for one current immutable view. Missing marks use the
   exact reader basis, recording empty reads conservatively. Future evidence
   and behavioral wrappers decline reuse rather than relabel historical data."
  [database attrs]
  (let [s (db/store-of database) basis (db/basis-t database)]
    (when (and (= (store/identity-of s) (store/capability-target s))
               (= :current (:filter-mode database)) (nil? (:since-t database))
               (nil? (:valid-at database)) (nil? (:valid-between database)))
      (let [stamps (mapv (fn [a] (marks/basis-t-for s a basis)) attrs)]
        (when (every? (fn [t] (and (erlang/is_integer t) (<= 0 t basis))) stamps)
          stamps)))))
