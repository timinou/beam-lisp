; Durable finite value identities use the native value codec, not ETF storage.
(ns datom.identity (:require [datom.codec :as codec] [datom.schema :as schema]))

(defn- finite-data? [value depth]
 (and (< depth 128)
  (cond
   (or (nil? value) (boolean? value) (string? value) (keyword? value)
       (int? value) (float? value)) true
   (or (vector? value) (set? value) (sorted-set? value) (erlang/is_list value))
     (every? (fn [x] (finite-data? x (inc depth))) value)
   (or (sorted-map? value) (and (map? value) (not (erlang/is_map_key :__struct__ value))))
     (every? (fn [[k v]] (and (finite-data? k (inc depth))
                             (finite-data? v (inc depth)))) value)
   :else false)))

(defn digest
 "SHA256 of finite native definition data under datom.identity/value-v1.
  Map ordering, collection storage and metadata do not affect identity. Native
  value equality for supported numbers is preserved. Functions, execution
  handles, lazy computations and opaque host records are refused. Source bytes
  can be supplied directly; this never introspects a function's implementation."
 [value]
 (when-not (finite-data? value 0)
  (throw (ex-info "Durable identity requires finite native definition data"
                  {:kind :invalid-identity})))
 (String/downcase (Base/encode16
  (crypto/hash :sha256 (codec/encode-value [:datom.identity/value-v1 value])))))

(defn schema-digest
 "A stable identity for validated attribute declarations. Declaration order and
  identical repetitions are immaterial; contradictory duplicates are refused."
 [definitions]
 (let [by-ident
  (reduce (fn [out definition]
   (when-let [problem (schema/validate-attr-def definition)]
    (throw (ex-info "Invalid identity schema declaration"
                    (assoc problem :kind :invalid-identity))))
   (let [ident (:db/ident definition) previous (get out ident)]
    (when (and previous (not= previous definition))
     (throw (ex-info "Conflicting identity schema declarations"
                     {:kind :invalid-identity :ident ident})))
    (assoc out ident definition))) {} definitions)]
  (digest [:datom.identity/schema-v1 (mapv second (sort-by first by-ident))])))
