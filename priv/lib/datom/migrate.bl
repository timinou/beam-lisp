; datom/migrate.bl — schema evolution you can trust against real data.
;
; ── The problem migrations actually solve ─────────────────────────────
;
; Growing a schema is safe: a new attribute breaks nothing, because no
; existing datom mentions it. The dangerous changes are the ones that
; TIGHTEN an invariant — "email is now unique", "role is now single-
; valued". Whether such a change is safe is not a fact about the schema;
; it is a fact about the DATA. Email-is-unique is fine on a database where
; emails happen to be unique and a corruption waiting to happen on one
; where they are not.
;
; And here is the twist that makes this hard: the database that decides is
; PRODUCTION, whose data shapes your laptop has never seen. A migration
; that passes every local test can still be a breaking change against the
; one database that matters.
;
; ── What this namespace gives you ─────────────────────────────────────
;
; A migration is ONE value carrying everything a change needs:
;
;   {:migration/id     :2026-08-26-unique-email   ; ordered, immutable name
;    :migration/grows  [{:db/ident :person/email  ; the schema delta (data)
;                        :db/valueType :db.type/string
;                        :db/unique :db.unique/identity}]
;    :migration/checks [{:check :unique :attr :person/email}]  ; invariants
;    :migration/fn     dedup-emails}              ; the remediation (a tx-fn)
;
;   plan   — walk ANY database (local or a production replica) and report
;            every way the migration would BREAK against the data present,
;            WITHOUT committing anything. This is the deploy gate.
;   apply! — remediate, re-check, then grow the schema and record the
;            migration, folding the data transform and the schema change
;            into ONE atomic transaction.
;
; ── Why it rests on `with` and `:db/fn` ───────────────────────────────
;
; `plan` previews the WHOLE migration — the remediation fn AND the schema
; grow — by running it through `datom.conn/with` against a db value.
; Because a database is a value and `with` mutates nothing, previewing a
; migration against production is a read, safe to run from anywhere.
;
; `apply!` folds the remediation, the schema deltas and the ledger stamp
; into a single `transact!` (the remediation rides as a `:db/fn`, the
; schema deltas as tempid maps that UPSERT on `:db/ident`). So a crash can
; never leave data fixed but schema unrecorded: either the whole migration
; committed or none of it did. The in-memory schema map is synced after,
; from those same durable datoms.
;
; ── The ledger is a query, not a side table ───────────────────────────
;
; Which migrations have run is answered by `[?m :migration/id ?id]`, not
; by a `schema_migrations` table beside the data. A database whose premise
; is one uniform store should not keep this record somewhere else — and a
; query-derived ledger is automatically consistent with the transaction
; that wrote it, because it IS that transaction's datom.

(ns datom.migrate
  (:require [datom.conn] [datom.db] [datom.index] [datom.query.engine] [datom.schema]))

;; ── the migration ledger attribute ──────────────────────────────────

(def LEDGER-ATTR
  "The attribute a recorded migration asserts about itself. Installed on
   first `apply!`; `:db.unique/identity` so recording the same migration
   twice UPSERTS rather than duplicating — the datom-level idempotence a
   crash-resumed migration depends on."
  {:db/ident :migration/id
   :db/valueType :db.type/keyword
   :db/cardinality :db.cardinality/one
   :db/unique :db.unique/identity})

(def DIGEST-ATTR
  {:db/ident :migration/digest :db/valueType :db.type/string
   :db/cardinality :db.cardinality/one})

(def START-ATTR
  "A partial backfill reserves its identity before its first data commit.
   Separate from :migration/id: a started migration is never reported complete."
  {:db/ident :migration/started-id :db/valueType :db.type/keyword
   :db/cardinality :db.cardinality/one :db/unique :db.unique/identity})

(defn- ledger-installed?
  [conn]
  (and (datom.schema/known? (datom.conn/schema conn) :migration/id)
       (datom.schema/known? (datom.conn/schema conn) :migration/digest)
       (datom.schema/known? (datom.conn/schema conn) :migration/started-id)))

(defn- ensure-ledger!
  "Install the ledger attribute if this connection has never seen it.
   Idempotent."
  [conn]
  (if (ledger-installed? conn)
    conn
    (datom.conn/install-schema! conn [LEDGER-ATTR DIGEST-ATTR START-ATTR])))

;; ── reading the ledger ──────────────────────────────────────────────

(defn applied-ids
  "The set of migration ids recorded in `db`."
  [db]
  (if (datom.schema/known? (datom.db/schema-of db) :migration/id)
    (into #{} (mapv (fn [t] (get t 0))
                    (into [] (datom.query.engine/q
                               '[:find ?id :where [?m :migration/id ?id]] db))))
    #{}))

(defn applied?
  "Whether `migration` is recorded as applied in `db`."
  [db migration]
  (contains? (applied-ids db) (get migration :migration/id)))

(defn- recorded-digest [db attr id]
  (first (first (datom.query.engine/q
     [:find '?digest :in '$ '?id :where ['?m attr '?id] ['?m :migration/digest '?digest]] db id))))

(defn- started? [db migration]
  (and (datom.schema/known? (datom.db/schema-of db) :migration/started-id)
       (seq (datom.query.engine/q
              '[:find ?m :in $ ?id :where [?m :migration/started-id ?id]] db (:migration/id migration)))))

(defn- identity-status [db migration]
  (let [wanted (:migration/digest migration) id (:migration/id migration)
        accepted? (fn [recorded]
          (or (= wanted recorded)
              (contains? (:migration/legacy-digests migration #{}) recorded)))]
   (cond
    (applied? db migration)
      (if (and wanted (not (accepted? (recorded-digest db :migration/id id))))
        :identity-conflict :already-applied)
    (and (started? db migration) wanted
         (not (accepted? (recorded-digest db :migration/started-id id)))) :identity-conflict
    :else nil)))

(defn- reserve! [conn migration]
  (ensure-ledger! conn)
  (when-not (started? (datom.conn/db conn) migration)
   (datom.conn/transact! conn
     [(cond-> {:db/id -2 :migration/started-id (:migration/id migration)}
        (:migration/digest migration) (assoc :migration/digest (:migration/digest migration)))])))

(defn- validate-spec! [migration]
  (when-not (keyword? (:migration/id migration))
    (throw (ex-info "Migration requires a keyword identity" {:kind :invalid-migration})))
  (when (and (:migration/digest migration)
             (not (and (string? (:migration/digest migration))
                       (Regex/match? (Regex/compile! "^[a-f0-9]{64}$") (:migration/digest migration)))))
    (throw (ex-info "Migration digest must identify sealed implementation bytes" {:kind :invalid-migration})))
  ;; Deployment-authored compatibility for reviewed historical encodings. This
  ;; never derives aliases from database contents or rewrites a recorded seal.
  (when (contains? migration :migration/legacy-digests)
   (let [legacy (:migration/legacy-digests migration)]
    (when-not (and (:migration/digest migration) (set? legacy) (<= (count legacy) 16)
                  (every? (fn [digest] (and (string? digest)
                    (Regex/match? (Regex/compile! "^[a-f0-9]{64}$") digest))) legacy))
     (throw (ex-info "Legacy migration digests require a current digest and a bounded reviewed SHA256 set"
                     {:kind :invalid-migration})))))
  (doseq [definition (:migration/grows migration [])]
   (when-let [problem (datom.schema/validate-attr-def definition)]
    (throw (ex-info "Invalid migration schema declaration" (assoc problem :kind :invalid-migration))))))

;; ── invariant checks: violations derived from data, as data ─────────
;;
;; Each check is a QUESTION only the data can answer, expressed as a query
;; over whatever db value it is handed. A check returns a vector of
;; violation maps — empty means the invariant already holds.

(defn- rows-e-v
  "Every `[entity value]` pair for `attr` in `db`."
  [db attr]
  (into [] (datom.query.engine/q [:find '?e '?v :where ['?e attr '?v]] db)))

(defn- unique-violations [attr rows]
  (let [by-v (group-by (fn [t] (get t 1)) rows)]
    (filterv some?
      (mapv (fn [entry]
              (let [grp (val entry)]
                (when (> (count grp) 1)
                  {:check :unique :attr attr :value (key entry)
                   :entities (mapv (fn [t] (get t 0)) grp)})))
            (seq by-v)))))

(defn check-unique
  "Violations of a uniqueness invariant on `attr`: any value held by more
   than one entity."
  [db attr]
  (unique-violations attr (rows-e-v db attr)))

(defn- cardinality-violations [attr rows]
  (let [by-e (group-by (fn [t] (get t 0)) rows)]
    (filterv some?
      (mapv (fn [entry]
              (let [grp (val entry)]
                (when (> (count grp) 1)
                  {:check :cardinality-one :attr attr :entity (key entry)
                   :values (mapv (fn [t] (get t 1)) grp)})))
            (seq by-e)))))

(defn check-cardinality-one
  "Violations of a cardinality-one invariant on `attr`: any entity holding
   more than one value."
  [db attr]
  (cardinality-violations attr (rows-e-v db attr)))

(defn schema-checks
  "Derive historical checks from the actual requested schema, without repeated
   application predicates. Uses schema's existing validation/type semantics.
   A changed derived tuple requires a full prospective-schema preview; refuse
   that unsupported transition instead of validating an empty new attribute."
  [db migration]
  (let [before (datom.db/schema-of db)
        after (datom.schema/install-all before (:migration/grows migration []))]
   (vec (mapcat
     (fn [attr]
       (let [definition (get after attr) old (get before attr)]
        (concat
         (when (and (seq (:db/tupleAttrs definition))
                    (not= (:db/tupleAttrs definition) (:db/tupleAttrs old)))
          [{:check :derived-schema :attr attr :reason :prospective-tuple-preview-required}])
         (when (datom.schema/unique? after attr) [{:check :unique :attr attr}])
         (when-not (datom.schema/many? after attr) [{:check :cardinality-one :attr attr}])
         (when-let [t (datom.schema/value-type after attr)] [{:check :value-type :attr attr :expected t}]))))
     (distinct (map :db/ident (:migration/grows migration [])))))))

(defn- run-check
  "Run one check spec against `db`, returning its violations."
  [db spec rows]
  (let [kind (get spec :check) attr (get spec :attr)]
    (cond
      (= kind :unique) (unique-violations attr rows)
      (= kind :cardinality-one) (cardinality-violations attr rows)
      (= kind :value-type)
        (let [validate (datom.schema/value-validator
                        {attr {:db/ident attr :db/valueType (:expected spec)}} attr)]
         (filterv some? (mapv (fn [row]
          (when-let [problem (validate (get row 1))]
           (assoc problem :check :value-type :entity (get row 0)))) rows)))
      (= kind :derived-schema) [spec]
      (= kind :predicate)
        (let [r ((get spec :fn) db)]
          (cond (nil? r) [] (= true r) [] (= false r) [{:check :predicate :id (:id spec)}]
                (sequential? r) (vec r)
                :else (throw (ex-info "Migration predicate must return boolean or violations" {:kind :invalid-migration}))))
      :else (throw (ex-info "unknown migration check" {:check spec})))))

(defn- check-all
  "Every violation of `migration`'s checks against `db`, flattened."
  [db migration]
  (let [checks (vec (distinct (concat (get migration :migration/checks []) (schema-checks db migration))))
        attrs (distinct (keep #(when (contains? #{:unique :cardinality-one :value-type} (:check %)) (:attr %)) checks))
        rows (into {} (map (fn [attr] [attr (rows-e-v db attr)]) attrs))]
   (into [] (mapcat (fn [spec] (run-check db spec (get rows (:attr spec)))) checks))))

;; ── remediation ─────────────────────────────────────────────────────

;; The remediation HELPERS: pure functions of a db value that return the
;; retractions which make a tightening invariant true. A migration's
;; `:migration/fn` is typically built from these — they are the corrective
;; counterpart of the checks above.

(defn dedup-unique
  "Retract a duplicated `attr` value from every entity but the first that
   holds it, so the value becomes unique. The corrective for
   `check-unique`."
  [db attr]
  (into []
    (mapcat (fn [v]
              (mapv (fn [e] [:db/retract e attr (get v :value)])
                    (rest (get v :entities))))
            (check-unique db attr))))

(defn collapse-cardinality-one
  "Retract all but the first value of `attr` on any entity holding
   several, so the attribute becomes single-valued. The corrective for
   `check-cardinality-one`."
  [db attr]
  (into []
    (mapcat (fn [v]
              (mapv (fn [each] [:db/retract (get v :entity) attr each])
                    (rest (get v :values))))
            (check-cardinality-one db attr))))


(defn- remediation-tx-data
  "The migration's remediation as transaction data: its `:migration/fn`
   applied to `db`, or `[]` when it has none.

   The fn is a tx-fn (`(fn [db] -> tx-data)`), so this is exactly what
   `[:db/fn f]` would splice — computed here directly so `plan` can
   preview it and `apply!` can fold it in."
  [db migration]
  (let [f (get migration :migration/fn)]
    (if (some? f) (into [] (f db)) [])))

;; ── the deltas that GROW the schema, as one transaction ─────────────

(defn- grow-tx-data
  "The migration's schema deltas as tempid maps that UPSERT on
   `:db/ident`. Written this way they land in the SAME transaction as the
   remediation and the ledger stamp, and re-running is a no-op at the
   datom level rather than a second attribute entity.

   Each definition gets a DISTINCT tempid: they are different attribute
   entities, and sharing one tempid across two `:db.unique/identity`
   idents makes the resolver try to unify them onto one entity — a
   genuine error, since one entity cannot be both `:person/email` and
   `:person/role`. Tempids here start below -1 (the migration's own stamp
   uses -2, so these start at -10) to stay clear of any tempid a caller's
   remediation fn might have used."
  [migration]
  (let [defs (get migration :migration/grows [])]
    (into []
      (map-indexed (fn [i definition] (assoc definition :db/id (- 0 (+ 10 i))))
                   defs))))

(defn- migration-tx-data
  "The full transaction a migration commits: remediation, then schema
   grow, then the ledger stamp — in that order, as one atomic unit.

   Order matters: the remediation must make an invariant TRUE before the
   grow that enforces it lands, and both must precede recording that the
   migration ran. `transact!` applies the ops as one commit regardless,
   but the order is what makes the intermediate state within the
   transaction consistent."
  [remediated migration]
  (into (into remediated
              (grow-tx-data migration))
        [(cond-> {:db/id -2 :migration/id (get migration :migration/id)}
           (:migration/digest migration) (assoc :migration/digest (:migration/digest migration)))]))

;; ── plan: the deploy gate ───────────────────────────────────────────

(defn plan
  "Walk `db` and report how `migration` would behave against the data
   actually present, WITHOUT committing anything.

   Returns a report map:

     :id          the migration id
     :status      :clean | :breaking | :already-applied
     :breaking    invariant violations present in `db` (empty on :clean)
     :remediated  the remediation tx-data the migration's fn would run
     :would-tx    the full transaction `apply!` would commit

   `plan` takes a DB VALUE, not a connection, precisely so it can run
   against a read-only production replica opened from anywhere. It reports
   the breakage PRESENT in the data — the shapes that make the migration
   dangerous, named down to the offending entities. This is the deploy
   gate: run it against production in CI and a migration that would break
   is a non-zero exit before anything is deployed.

   The violations here are checked against `db` as it stands. To see what
   remains AFTER the migration's remediation fn runs — the exact residual
   `apply!` gates on — use `plan-with` against a live connection, which
   previews the remediation through `with`. `plan` answers 'is there
   anything to remediate?'; `plan-with` answers 'does the remediation
   fully handle it?'. Both commit nothing."
  [db migration]
  (if-let [identity (identity-status db migration)]
    {:id (get migration :migration/id) :status identity
     :breaking [] :remediated [] :would-tx []}
    (let [violations (check-all db migration)
          remediated (remediation-tx-data db migration)]
      {:id (get migration :migration/id)
       :status (if (seq violations) :breaking :clean)
       :breaking violations
       :remediated remediated
       :would-tx (migration-tx-data remediated migration)})))

;; ── plan-with: the EXACT preview, through a live connection ─────────

(defn plan-with
  "Like `plan`, but previews the migration through `datom.conn/with` on a
   live `conn`, so the residual invariants are checked against the TRUE
   speculative result — including remediations that assert, not just
   retract. Commits nothing.

   Use `plan` for a db value pulled from a replica (the common CI case:
   'is this migration safe against prod?'). Use `plan-with` when you have
   a live connection and want the remediation's full effect — asserts and
   all — reflected exactly."
  [conn migration]
  (let [db (datom.conn/db conn)]
    (if-let [identity (identity-status db migration)]
      {:id (get migration :migration/id) :status identity
       :breaking [] :remediated [] :would-tx []}
      (let [remediated (remediation-tx-data db migration)
            ; Speculatively apply ONLY the remediation, then check the
            ; invariants on the resulting db-after. This is exact: the
            ; residual violations are precisely what would remain after
            ; the fn runs, whatever shape its output takes.
            spec (if (seq remediated)
                   (get (datom.conn/with conn remediated) :db-after)
                   db)
            residual (check-all spec migration)]
        {:id (get migration :migration/id)
         :status (if (seq residual) :breaking :clean)
         :breaking residual
         :remediated remediated
         :would-tx (migration-tx-data remediated migration)}))))

;; ── apply!: gated, atomic, idempotent ───────────────────────────────

(defn apply!
  "Preview, validate and commit in ONE store-writer turn; readers keep serving.
   Optional :expected-basis binds reviewed data. A digest binds a sealed migration
   implementation; a reused id with changed/unknown digest is refused. Optional
   :migration/legacy-digests names explicitly reviewed historical encodings;
   these deployment definitions preserve existing seals and must be bound to
   the exact current source/schema identity by their author's manifest. Individual
   data/schema/ledger commits are atomic. Remediation/check functions must be pure.
   Residual invariant violations return :blocked with the fixed public reason
   :migration-invariants-violated; detailed :breaking values stay caller-local."
  ([conn migration] (apply! conn migration {}))
  ([conn migration opts]
   (validate-spec! migration)
   (datom.conn/serialized! conn
    (fn []
     (let [basis (datom.db/basis-t (datom.conn/db conn))
           identity (identity-status (datom.conn/db conn) migration)]
      (cond
       (= identity :identity-conflict) {:id (:migration/id migration) :status :identity-conflict}
       (= identity :already-applied)
         (do (datom.conn/sync-schema! conn (:migration/grows migration []))
             {:id (:migration/id migration) :status :already-applied})
       (and (some? (:expected-basis opts)) (not= basis (:expected-basis opts)))
         {:id (:migration/id migration) :status :stale :basis basis}
       :else
        (do
         (ensure-ledger! conn)
         (let [preview (plan-with conn migration)]
          (if (= :breaking (:status preview))
           {:id (:migration/id migration) :status :blocked
            :reason :migration-invariants-violated :breaking (:breaking preview)
            :remediated (:remediated preview)}
           (let [tx-data (:would-tx preview)
                 speculative (datom.conn/with conn tx-data)]
            (if (and (:allow-tx? opts) (not= true ((:allow-tx? opts) speculative)))
             {:id (:migration/id migration) :status :blocked :reason :transaction-policy}
             (let [report (datom.conn/transact! conn tx-data)]
              (datom.conn/sync-schema! conn (:migration/grows migration []))
              {:id (:migration/id migration) :status :applied
               :remediated (:remediated preview) :tx (:tx report)}))))))))))))

;; ── running a set of migrations, in order ───────────────────────────

(defn apply-all!
  "Apply `migrations` to `conn` in order, stopping at the first that is
   :blocked. Returns a vector of per-migration reports.

   Each migration is its own transaction (they are individually named,
   ordered and idempotent), so a stop is a clean resume point: fix the
   blocked migration's data assumption and re-run — the applied ones are
   skipped."
  [conn migrations]
  (loop [pending migrations acc []]
    (if (empty? pending)
      acc
      (let [report (apply! conn (first pending))]
        (if (not (contains? #{:applied :already-applied} (:status report)))
          (conj acc report)
          (recur (rest pending) (conj acc report)))))))

;; ── batched remediation, for migrations too large for one commit ────

(defn capabilities []
  #{:serialized-decisions :immutable-digests :basis-bound :transaction-policy :online-steps :partial-identity
    :inferred-schema-checks :shared-attribute-scans})

(defn step!
  "Perform ONE bounded resumable backfill step. batch-fn is pure and returns
   [tx-data more?]. Partial progress lives in data, never an in-memory cursor.
   Final remediation/schema/ledger share the last writer turn. :allow-tx? checks
   each batch and final commit; :expected-basis is checked before this step."
  ([conn migration batch-fn] (step! conn migration batch-fn {}))
  ([conn migration batch-fn opts]
   (validate-spec! migration)
   (let [requested (erlang/monotonic_time :microsecond)
         measured (atom {})
         result (datom.conn/serialized! conn
    (fn []
     (let [entered (erlang/monotonic_time :microsecond)]
      (reset! measured {:writer-wait-us (- entered requested)})
      (try
     (let [db (datom.conn/db conn) identity (identity-status db migration)]
      (cond
       identity (apply! conn migration)
       (and (some? (:expected-basis opts))
            (not= (:expected-basis opts) (datom.db/basis-t db)))
        {:id (:migration/id migration) :status :stale :basis (datom.db/basis-t db)}
       :else
        (let [;; Reserve metadata BEFORE deriving/speculating business effects.
              ;; Installing ledger attributes or allocating a reservation after
              ;; authorization would shift tempids: policy would approve entity
              ;; A and the real commit could write entity B in the same turn.
              _ (reserve! conn migration)
              selected-at (erlang/monotonic_time :microsecond)
              [tx-data more?] (batch-fn (datom.conn/db conn))
              _ (swap! measured assoc :selection-us (- (erlang/monotonic_time :microsecond) selected-at)
                                      :selected-tx-forms (count tx-data))
              speculative (when (seq tx-data) (datom.conn/with conn tx-data))]
         (when (and more?
                    (or (empty? tx-data)
                        (empty? (remove (fn [d] (= :db/txInstant (datom.index/-a d)))
                                        (:tx-datoms speculative)))))
          (throw (ex-info "Migration batch made no progress" {:kind :migration-no-progress})))
         (if (and speculative (:allow-tx? opts)
                  (not= true ((:allow-tx? opts) speculative)))
          {:id (:migration/id migration) :status :blocked :reason :transaction-policy}
          (do
           (let [report (when (seq tx-data) (datom.conn/transact! conn tx-data))]
            (if more?
             {:id (:migration/id migration) :status :progress :tx (:tx report)}
             (apply! conn migration (dissoc opts :expected-basis)))))))))
       (finally (swap! measured assoc :writer-occupancy-us
                   (- (erlang/monotonic_time :microsecond) entered)))))))]
    (assoc result :metrics @measured))))

(defn apply-batched!
  "Run resumable steps until complete. Every step yields the store writer.
   For background integration use step! from a supervised proc worker instead
   of keeping a request waiting for the entire backfill."
  [conn migration batch-fn]
  (loop []
   (let [r (step! conn migration batch-fn)]
    (if (= :progress (:status r)) (recur) r))))

(defn additive-schema-status
 "Callback-free current native schema invariant/ledger observation for the
  additive admission protocol. This data alone is NOT a migration capability.
  Spec is closed first-order; fn/batch/custom checks refuse before invocation."
 [db migration]
 (BeamLisp.CompilerData/check_first_order! migration
   {:max-nodes 65536 :max-depth 64 :max-bytes 1048576})
 (when-not (and (erlang/is_map migration)
                (= #{:migration/id :migration/digest :migration/grows} (set (keys migration)))
                (keyword? (:migration/id migration)) (string? (:migration/digest migration))
                (Regex/match? #"^[a-f0-9]{64}$" (:migration/digest migration))
                (vector? (:migration/grows migration)) (<= 1 (count (:migration/grows migration)) 32))
  (throw (ex-info "Only closed additive migration observation is supported"
                  {:kind :unsupported-migration-spec})))
 (validate-spec! migration)
 (let [identity (identity-status db migration)
       ledger (cond (= identity :identity-conflict) :conflict
                    (= identity :already-applied) :complete
                    (started? db migration) :started :else :absent)]
  {:ledger ledger :schema (if (empty? (check-all db migration)) :valid :blocked)}))
