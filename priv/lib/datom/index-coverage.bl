;; Durable coverage evidence for selective indexes. Schema presence is not proof
;; that old data reached the index. Checkpoints and index writes share a commit.
(ns datom.index-coverage
  (:require [datom.store :as store] [datom.index :as index]
            [datom.schema :as schema] [datom.derived :as derived]
            [datom.attr-basis :as marks]))

(def VERSION 1)
(def PAGE-SIZE 1024)
(defn ident [attr] [:datom.index-coverage/avet attr])
(defn definition [s attr]
  {:version VERSION :attr attr :type (schema/value-type s attr)
   :many (schema/many? s attr) :indexed (schema/indexed? s attr)
   :tuple (mapv (fn [a] [a (schema/value-type s a) (schema/many? s a)])
                (or (schema/tuple-attrs s attr) []))})
(defn certificate [s attr] (derived/get-record s (ident attr)))
(defn- writes-covered? [c committed]
  (let [through (or (:through c) (:basis c)) d (:definition c)
        attrs (conj (mapv first (:tuple d)) (:attr d))]
    (and (erlang/is_integer through) (<= 0 through)
         (every? (fn [a] (let [t (get committed a through)]
                           (and (erlang/is_integer t) (<= 0 t through)))) attrs))))

(defn derived-complete? [s sch attr basis]
  (let [c (certificate s attr)]
    (and (= :complete (:status c))
         (= (definition sch attr) (:definition c))
         (erlang/is_integer (:basis c)) (<= (:basis c) basis)
         ;; A stale connection or bulk writer can change a component without
         ;; maintaining this tuple/index. Schema presence is not evidence of
         ;; maintenance: every source write must be covered by the checkpoint.
         (writes-covered? c (marks/committed-marks s)))))

(defn transaction-ops
  "Advance or invalidate coverage IN the source commit. A gap is permanent
   until full repair; a later good write must never hide an earlier missed one.
   Bulk loading has no tuple derivation proof and invalidates affected tuples."
  [s sch datoms tx trusted-tuples?]
  (let [changed (set (mapv index/-a datoms)) deps (schema/tuple-attrs-index sch)
        affected (into changed (mapcat (fn [a] (get deps a [])) changed))
        committed (marks/committed-marks s)]
    (into [] (mapcat
      (fn [a]
        (let [c (certificate s a) tuple? (seq (schema/tuple-attrs sch a))]
          (when (= :complete (:status c))
            (if (or (not= (definition sch a) (:definition c))
                    (not (writes-covered? c committed))
                    (and tuple? (not trusted-tuples?)))
              [[:delete (derived/record-key (ident a))]]
              (when (contains? changed a)
                (derived/put-ops (ident a) (assoc c :through tx))))))) affected))))

(defn complete? [s sch attr basis]
  (and (schema/indexed? sch attr) (derived-complete? s sch attr basis)))

(defn mark-derived! [s sch attr basis]
  (store/-commit s (derived/put-ops (ident attr)
    {:status :complete :definition (definition sch attr) :basis basis :rows 0})))

(defn ensure!
  "Inside the store writer: cover authoritative AEVT history before publishing
   an AVET plan. A changed source basis restarts an interrupted snapshot; keys
   are idempotent. force? is required when writes used an unindexed old schema,
   even if a failed earlier attempt left a certificate. No codec format changes."
  [s sch attr basis force?]
  (when (schema/indexed? sch attr)
    (let [d (definition sch attr) old (certificate s attr)
          ready (and (complete? s sch attr basis)
                     (or (not force?) (= basis (:basis old))))]
      (when-not ready
        (let [resume (and (= :building (:status old)) (= d (:definition old)) (= basis (:basis old)))
              lo (index/key-prefix :aevt attr) hi (index/prefix-end lo)]
          (loop [after (when resume (:after old)) rows (if resume (:rows old) 0)]
            (let [page (store/page-datoms s lo after hi PAGE-SIZE)
                  ds (filterv (fn [dt] (<= (index/-tx dt) basis)) (:datoms page))
                  count (+ rows (count ds))
                  c {:status (if (:end? page) :complete :building) :definition d
                     :basis basis :after (:last page) :rows count}
                  ops (into (mapv (fn [dt] [:put (index/key-for :avet dt) dt]) ds)
                            (derived/put-ops (ident attr) c))]
              (store/-commit s ops)
              (when-not (:end? page) (recur (:last page) count))))))))
  :ok)

(defn invalidate! [s attr]
  (store/-delete s (derived/record-key (ident attr)))
  :ok)
