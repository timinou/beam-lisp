; datom/store-fjall.bl — the storage port, over fjall (an LSM engine).
;
; The durable substrate under datom.store/Store, beside the in-memory ETS and
; map stores. fjall is a log-structured merge tree. The datom log is
; append-dominated (each datom writes into 2-4 index orderings, monotonically)
; and reads are ordered range scans — the exact shape an LSM is built for. This
; wrapper is the bl side of native/datom_fjall; it implements the SAME six-method
; protocol the in-memory stores do, so everything above L1 cannot tell them apart.
;
; Values round-trip through term_to_binary (the store only requires a faithful
; value round trip; only KEYS must be order-preserving, and those are passed
; through untouched). A columnar `resolve` fast path that packs datoms for a
; native range decode is deferred (FUP-022); the generic -range scan is correct
; and is what everything above uses today.

;; ── EXCLUSIVE OWNERSHIP (one store, one OS process) ──────────────────
;;
;; fjall locks nothing of its own, so two OS processes opening one keyspace
;; directory would write the same segment files: silent CORRUPTION, not a slow
;; read. `open` therefore takes an exclusive OS lock — a `flock` on the store's
;; real directory, taken by the native `fjall-open` — held for the lifetime of
;; the store's native handle. The kernel releases it when that fd closes: at the
;; resource's drop (a normal close) or at process death (a crash, a SIGKILL).
;; There is no lock FILE and no PID to compare, so there is no stale lock to
;; misread — a dead owner's store is simply free.
;;
;; Two consequences a caller can rely on:
;;   * a store another PROCESS owns raises a TYPED error from `open`
;;     (`{:reason :store-already-open}` in its `ex-data`) — an answer distinct
;;     from an I/O failure (a plain message), and never a corruption report;
;;   * a second open of the SAME store inside one process is ALLOWED and shares
;;     the one lock, matching `datom.conn`'s semantics (its writer and basis are
;;     keyed by the store VALUE, and two connections over one store are two
;;     views of one database). A path alias — a symlink, a relative path, a
;;     trailing separator — cannot evade the lock: the directory is
;;     canonicalized before it is locked, so aliases meet on one inode. The
;;     alias resolves to the same `:path`, and therefore to the same blob tier
;;     (`<path>.blobs`), so the two spellings are one store in every respect,
;;     not only in the lock.

(ns datom.store-fjall
  (:require [datom.store] [datom.blob] [datom.blob-fs] [datom.value-codec] [datom.store-admission :as admission] [datom.store-opening :as opening]))

(def ^:private CHUNK-ROWS
  "Rows per native range crossing. 512 keeps a chunk ~8ms on the measured
   corpus (16µs/row), so a concurrent get waits a chunk rather than a scan,
   while the crossing overhead stays noise against the work each chunk does."
  512)

;; ── the native backend, declared here (defnative makes this ns the host) ──

(defnative "datom_fjall"
  (fjall-open 1)
  ; fjall-canonical-path: (path) → the CANONICAL directory the path refers to,
  ; or {:error, reason}. Symlinks, `..`, a trailing separator and a relative
  ; spelling collapse onto the one real directory the claim's flock is taken
  ; on. The claim already canonicalizes internally; this exposes the SAME
  ; answer so `open` can key the record's :path — and with it the
  ; `<path>.blobs` sibling — off the store's ONE identity rather than off
  ; whatever spelling the caller used. bl has no realpath of its own.
  (fjall-canonical-path 1)
  (fjall-get 2)
  (fjall-range 3)
  ; fjall-range-chunk: the next `limit` [k v] pairs — `start` (inclusive)
  ; bounds the first chunk, `after` (exclusive) resumes from the last key
  ; received. A whole-window scan on a real corpus is 15.6s in ONE crossing
  ; (969k rows / 1.1GB) and every op shares one dirty-IO scheduler, so a
  ; concurrent get waited the whole scan (max 3421ms). Chunks release that
  ; lane between reads and bound the native transient.
  (fjall-range-chunk 5)
  ; fjall-resolve-chunk: the DATOM read path — up to `limit` datoms from the
  ; same three bounds, DECODED IN RUST. Args: (start after stop limit mode),
  ; where mode is :datoms (a list under "datoms"), :pairs ([k v] decoded values,
  ; what `-range` needs) or :columns (a dense-union columnar chunk: e/tx/op/
  ; a-dict+a-idx/v-lane+v-idx + per-lane dense arrays and one shared
  ; variable-width area). Returns {n, last} plus one of them; `last` is nil when
  ; the chunk was empty, which is how a caller stops.
  ;
  ; Why it exists: on the real corpus (969 016 rows / 1.1 GB) the generic
  ; `-range` read costs 8.57s, of which fjall iteration is 2.48s — the rest is
  ; per-row BEAM work (term_to_binary parse, a fresh vector per row, the [k v]
  ; pairs) that is thrown away for every row a filter rejects. Here the parse
  ; is a byte read and the caller can filter columns before materializing
  ; anything. Measured on 50 000 identical rows: 112ms read as datoms through
  ; this path where the BEAM-decoding path needs 479ms.
  (fjall-resolve-chunk 6)
  ; fjall-count-range: (handle lo hi limit) → {count capped} — how many KEYS lie
  ; in [lo, hi], counting at most `limit` of them. The VALUE of every entry is
  ; dropped unread, so no datom is decoded and no term is built, and the walk
  ; stops ON the limit-th key: `capped` says the range holds AT LEAST `limit`
  ; keys. The semi-join gate's cheap question (datom.store/Count), the
  ; counterpart to fjall-resolve-prefixes' expensive answer.
  (fjall-count-range 4)
  ; fjall-resolve-prefixes: (handle bounds) where bounds is a list of {lo hi}
  ; 2-tuples, inclusive. Every datom under any bound, decoded in Rust, ONE
  ; crossing. Returns {n datoms}. The semi-join read (datom.store/MultiScan).
  (fjall-resolve-prefixes 2)
  (fjall-resolve-prefixes-data 2)
  (fjall-put 3)
  (fjall-delete 2)
  (fjall-cas 4)
  (fjall-commit 2)
  (fjall-sync 1)
  (fjall-checkpoint-capture 1)
  (fjall-checkpoint-release 1)
  (fjall-checkpoint-begin 2)
  (fjall-checkpoint-step 3)
  (fjall-checkpoint-finish 3)
  (fjall-publish-directory 4)
  (fjall-sync-directory 3)
  (fjall-checkpoint-abort 1)
  ; fjall-stats: what the ENGINE reports — block-cache capacity, write buffer,
  ; compaction (count, in flight, time spent), journal and disk accounting,
  ; partition count. `lsm-tree`'s cache exposes size/capacity and NO hit/miss
  ; counters, so a hit RATE cannot be measured on this stack; read volume
  ; (rchar deltas) plus this capacity is what answers the same question, and
  ; compaction is what write amplification is made of — neither was observable
  ; before this. Cheap: atomics the engine already maintains.
  (fjall-stats 1)
  ; keycodec-encode: the order-preserving KEY encoding in Rust, byte-identical
  ; to datom.codec/encode-value for the four bulk lanes (int/str/kw/bool). Args:
  ; (tag ival sval bval). Returns the key binary, or nil for an out-of-lane
  ; value (caller falls back to the bl codec).
  (keycodec-encode 4)
  ; keycodec-key: build a WHOLE index key native — (idx-tag components), where
  ; components is a list of {lane ival sval bval} in index-sort order. Returns
  ; the finished key binary, or nil if any component is out of lane. One
  ; crossing per key, byte-identical to datom.index/key-for.
  (keycodec-key 2)
  ; keycodec-batch: the WHOLE transaction's keys in ONE crossing. Args:
  ; (datoms idx-lists) where datoms is a list of {e a v tx op} 5-tuples and
  ; idx-lists[i] is the index tags datom i belongs in. Classifies + encodes
  ; entirely in Rust (no per-component bl allocation). Returns a flat list of
  ; keys (datom-major, index order), or nil if any component is out of lane.
  (keycodec-batch 2))

(defrecord FjallStore [handle path])

;; ── values: faithful round trip, and CHEAP to read back ─────────────
;; KEYS are the database's own order-preserving binaries — never reinterpreted.
;; VALUES are whatever the layer above stored; their bytes are only returned,
;; never compared, so the slot codec's only jobs are fidelity and speed.
;;
;; A datom is the overwhelmingly common value here (every index row), and the
;; old `term_to_binary` slot paid for it twice: an ETF envelope around a
;; 5-vector, parsed back into a fresh vector per row, at every read. The datom
;; lane packs e/tx as fixed-width little-endian integers, `op` as one byte, the
;; attribute with its own length, and `v` last — so a reader (in Rust, in the
;; columnar path) recovers fields by offset and allocates NOTHING for a row it
;; filters out. Scalars (the transaction and entity counters in this same
;; keyspace) take their own runtime lane; nothing here guesses wrong, because a
;; slot that is not a datom still round-trips.
;;
;; Rows written before the lane existed start with the ETF version byte (131),
;; which no lane tag is, so `decode-slot` reads them exactly as before: a store
;; upgrades lazily and a mixed keyspace is expected.

(defn- encode-value [v] (datom.value-codec/encode-slot v))
(defn- decode-value [b] (datom.value-codec/decode-slot b))

(defn- source-data-read?
 "Actual native Source context, never a caller option. Old recovery has no
  Source admission; a managed graph requires the current coupled Host ABI."
 []
 (and (erlang/function_exported :Elixir.BeamLisp.Env :source_data_decode_required? 0)
      (BeamLisp.Env/source_data_decode_required?)))

(defn- native-read-mode [mode]
 (if (source-data-read?)
  (case mode :datoms :datoms-data :datoms-reverse :datoms-reverse-data
             :pairs :pairs-data :columns :columns-data
             (throw (ex-info "Unsupported Source read mode" {:kind :source-store-read-mode})))
  mode))

(defn- native-mutation-admit! [store]
 ;; Empty native Root summary avoids loading Conn for standalone/no-policy
 ;; Store use. Only actual Env owns this denial-only protected fast path.
 (if (and (erlang/function_exported :Elixir.BeamLisp.Env :native_command_critical_active? 0)
          (BeamLisp.Env/native_command_critical_active?))
  ((BeamLisp.Env/with_env :global
    #(BeamLisp.AOT/sdk_named_constructor! "datom.conn" "native-mutation-admit!" 1)) store)
  :legacy))

(defn- native-update-callback [action]
 (if (erlang/function_exported :Elixir.BeamLisp.Env :with_native_command_callback! 1)
  (BeamLisp.Env/with_native_command_callback! action) (action)))
(defn- native-mutation [store op arguments]
 (if (and (erlang/function_exported :Elixir.BeamLisp.Env :native_command_critical_active? 0)
          (BeamLisp.Env/native_command_critical_active?))
  ((BeamLisp.Env/with_env :global
    #(BeamLisp.AOT/sdk_named_constructor! "datom.conn" "native-mutation-effect!" 3))
   store op arguments) :legacy))


;; ── the datom read fast path: the `Scan` capability ─────────────────
;;
;; `Scan` is declared in datom.store as an OPTIONAL capability beside the Store
;; port, and this backend is the reason it exists: it is the serializing one, so
;; it is the one whose generic read pays a per-row BEAM decode it can avoid.
;; `datom.store/scan-datoms` dispatches on `satisfies?`, so the index layer and
;; everything above it take this path for fjall and an in-memory fast path for
;; ETS without either naming a substrate.
;;
;; The contract is the generic one, exactly: every datom whose key is in
;; [lo, hi] inclusive, in key order, unfiltered (basis and time travel are the
;; db layer's job, and doing them here would hide them from `:history`).
;;
;; Chunked for the same reason `-range` is — the whole-window read over a real
;; corpus is 15.6s in one crossing on ONE dirty-IO scheduler, so a concurrent
;; get waited the entire scan (measured 3421ms against a 0.05ms median). A
;; chunk releases that lane, and here it also bounds the native transient to
;; CHUNK-ROWS datoms instead of the table.
(extend-protocol datom.store/Scan
  FjallStore
  (-scan-datoms [store lo hi]
    ; chunks are accumulated as erlang lists and joined ONCE: `into` over a list
    ; is a core `reduce` that consults `core/reduced?` per element (~190 reductions
    ; each, measured), which made a full scan 460 reductions a datom.
    (loop [chunks '() start lo after nil]
      (let [res (fjall-resolve-chunk (:handle store) start after hi CHUNK-ROWS (native-read-mode :datoms))
            n (get res "n")]
        ; A native read that FAILED comes back as {:error, reason} rather than
        ; raising, and a failed first call would then read exactly like an empty
        ; range — a query that silently answers "no datoms" for a full table.
        ; So the RESULT SHAPE is the test, never the row count: `n` is present on
        ; every successful chunk and absent on every failure.
        (if (nil? n)
          (throw (ex-info (str "native datom scan failed: " res) {:lo lo :hi hi}))
          (let [last (get res "last")]
            (if (nil? last)
              (vec (lists/append (lists/reverse chunks)))
              (recur (cons (to-list (get res "datoms")) chunks) nil last))))))))

;; ── the multi-prefix read: `MultiScan` ─────────────────────────────────
;;
;; N prefixes, ONE crossing. This is what turns the engine's semi-join from
;; "N round trips" into one native pass with N seeks — the read a join over
;; already-bound entities wants, and the one the column scan was standing in
;; for. Bounds arrive sorted from the index layer.
(extend-protocol datom.store/MultiScan
  FjallStore
  (-scan-prefixes [store bounds]
    (let [ranges (to-list (mapv (fn [b] (erlang/list_to_tuple (to-list [(get b 0) (get b 1)]))) bounds))
          res (if (source-data-read?)
                (fjall-resolve-prefixes-data (:handle store) ranges)
                (fjall-resolve-prefixes (:handle store) ranges))
          n (get res "n")]
      (if (nil? n)
        (throw (ex-info (str "native multi-prefix scan failed: " res) {:bounds (count bounds)}))
        (into [] (to-list (get res "datoms")))))))

;; ── the bounded key count: `Count` ────────────────────────────────────
;;
;; The semi-join gate needs the SIZE OF ITS TARGET COLUMN — an earlier clause's
;; scan cannot tell it, and the column may be two rows or two hundred thousand.
;; This is the cheap answer: keys only (the value of every entry is dropped in
;; Rust, so nothing is decoded and no term is built) and stopped as soon as the
;; question is settled, so the walk is `min(range, limit)` rather than the
;; range. The limit is chosen by the gate from the prefix count being judged.
(extend-protocol datom.store/Count
  FjallStore
  (-count-range [store lo hi limit]
    (let [res (fjall-count-range (:handle store) lo hi limit)
          n (get res :count)]
      ; A native count that FAILED comes back without a `count`, and would
      ; otherwise read as an empty range — a probe that silently picks the
      ; wrong read shape. The RESULT SHAPE is the test, never the number.
      (if (nil? n)
        (throw (ex-info (str "native range count failed: " res)
                        {:lo lo :hi hi :limit limit}))
        {:count n :capped (get res :capped)}))))

;; ── the bounded page read: `PageScan` ───────────────────────────────
;;
;; ONE native crossing per page, bounded by `limit` and resuming from `after`
;; — the same `fjall-resolve-chunk` `-scan-datoms` drives, but stopped at the
;; page instead of looping to the end of the range. `-scan-datoms` is right for
;; a query that wants the whole column; this is right for a backfill that wants
;; the next `limit` rows, and it is why such a walk costs the page rather than
;; the corpus. The NIF bounds its own transient to `limit` datoms, so neither
;; the native nor the BEAM side ever holds the column.
(extend-protocol datom.store/PageScan
  FjallStore
  (-scan-datoms-page [store start after hi limit]
    (let [res (fjall-resolve-chunk (:handle store) start after hi limit (native-read-mode :datoms))
          n (get res "n")]
      ; A native read that FAILED comes back without an `n`, and would
      ; otherwise read exactly like an empty page — a backfill that silently
      ; ends early. The RESULT SHAPE is the test, never the row count.
      (if (nil? n)
        (throw (ex-info (str "native datom page failed: " res)
                        {:start start :after after :hi hi :limit limit}))
        {:datoms (into [] (to-list (get res "datoms")))
         :last (get res "last")
         :end? (< n limit)}))))

(extend-protocol datom.store/OrderedPageScan
  FjallStore
  (-ordered-page [store lo after hi limit direction max-bytes]
    (let [reverse? (= direction :desc)
          res (fjall-resolve-chunk (:handle store)
                                  (if (or reverse? (nil? after)) lo nil)
                                  after hi limit (tuple (native-read-mode (if reverse? :datoms-reverse :datoms)) max-bytes))
          n (get res "n")]
      (when (nil? n)
        (throw (ex-info "native ordered datom page failed" {:result res})))
      (if (get res "opaque-value") {:refused :opaque-value :datoms [] :bytes (get res "bytes")}
        {:datoms (into [] (to-list (get res "datoms"))) :bytes (get res "bytes")
         :byte-limited? (get res "byte-limited") :last (get res "last")
         :end? (and (not (get res "byte-limited")) (< n limit))}))))

(defn- __allocate-native!
  "Open (or create) a fjall-backed store at `path`. The keyspace persists after
   the process exits — which is the whole point: reopening recovers every datom.

   EXCLUSIVELY OWNED. A store is one OS process's at a time: `fjall-open` takes
   an exclusive `flock` on the store's directory and holds it for as long as this
   store's native handle lives (released when the last reference is dropped —
   `datom.conn/release!` then collection, or `datom.conn/close!` — and by the
   kernel if the process dies). Opening a store another PROCESS owns raises a
   TYPED error:

       (ex-info … {:reason :store-already-open, :path …, :locked-path …})

   That `:reason` is the contract. It is deliberately NOT an I/O message and
   never a corruption report — an owned store is not a damaged store, and a
   caller can back off, retry, or tell the user, instead of treating a healthy
   database as damaged. Reuse inside ONE process is allowed
   and shares the one lock, matching `datom.conn`: two connections over the same
   store are two views of one database.

   CANONICAL PATH. `:path` on the returned store is the store directory's REAL
   directory, not the spelling passed in: a symlink, a relative path, a `..` or
   a trailing separator resolves onto the one directory the lock is on. That
   matters because everything a store derives from its path — notably the
   default blob tier, the sibling `<path>.blobs` — must key off that same
   identity. Two spellings of one store are then one store: one datom log AND
   one set of bytes, not a shared log with bytes split across two directories.

   Other canonicalization and engine-open failures raise `:store-open-failed`
   with the native cause. A returned store always carries a usable handle."
  [path]
  (opening/assert-producer! :fjall path)
  ;; Canonicalization itself creates the directory. Check before that native
  ;; effect, then recheck the canonical spelling before opening the engine.
  (admission/check! path)
  ; ONE IDENTITY FOR THE STORE. The claim's flock, its registry and its engine
  ; are all keyed by the directory's CANONICAL path (the lock is on the inode,
  ; so a symlink, a `..`, a relative spelling and a trailing separator all reach
  ; the same lock). The record and the blob tier must key off that SAME
  ; directory: because a same-process reopen through an alias now JOINS the
  ; claim rather than being refused, a record that kept the caller's spelling
  ; would share the one datom log and yet write its bytes to a different
  ; sibling (`<alias>.blobs`) — a datom read back through the alias would name a
  ; blob only the other spelling could find. `fjall-canonical-path` is the same
  ; canonicalization the claim takes, asked once, here.
  (let [canon (fjall-canonical-path path)]
    (if (and (erlang/is_tuple canon)
             (= :error (erlang/element 1 canon)))
      (throw (ex-info "Cannot resolve Fjall store directory"
                      {:reason :store-open-failed :native (erlang/element 2 canon) :path path}))
      (let [_ (admission/check! canon) handle (fjall-open canon)]
        (if (and (erlang/is_tuple handle)
                 (= :error (erlang/element 1 handle))
                 (erlang/is_tuple (erlang/element 2 handle))
                 (= :already_open (erlang/element 1 (erlang/element 2 handle))))
          (let [locked (erlang/element 2 (erlang/element 2 handle))]
            (throw (ex-info (str "store already open: " canon
                                 " is exclusively owned by another OS process ("
                                 locked ")")
                            {:reason :store-already-open
                             :path canon
                             :locked-path locked})))
          (if (and (erlang/is_tuple handle) (= :error (erlang/element 1 handle)))
            (throw (ex-info "Cannot open Fjall engine" {:reason :store-open-failed :native (erlang/element 2 handle) :path canon}))
            (->FjallStore handle canon)))))))

(defn open
 "Open a native Fjall store. Managed allocation is indexed before native entry
  and atomically handed to Conn; unconnected/unknown handles block activation."
 [path]
 (admission/check! path)
 (if (opening/managed?) (opening/allocate! :fjall path) (__allocate-native! path)))

(defn available?
  "Whether the native fjall backend loaded. A persistent backend that fails to
   load should read as ABSENT, never as present-but-not-durable.

   TOTAL — the probe's own module can be absent (a ward, an isolated test run,
   does not carry `vm.native`), and an undefined function must read as `false`
   here, not raise. The caller's contract is a boolean: `codebase/cache-available?`
   exists so a command can CHOOSE the in-memory path, and a probe that raises
   takes that choice away from every caller at once — the failure surfaces as
   `vm.native.available?/1 is undefined` from deep inside a test, naming neither
   the store nor the decision it prevented."
  []
  (try (vm.native/available? "datom.store-fjall") (catch _ false)))

(extend-type FjallStore
  datom.store/Store

  (-get [store k]
    (decode-value (fjall-get (:handle store) k)))

  (-range [store lo hi]
    ; Bounds INCLUSIVE on both sides, as the port specifies (the NIF uses
    ; inclusive bounds); a half-open upper bound silently drops one datom per
    ; scan. The conformance suite asserts this.
    ;
    ; Read in CHUNKS, not one window: a wide scan over a real corpus is
    ; 969k rows / 1.1GB (measured 15.6s), it runs on ONE dirty-IO scheduler
    ; shared by every fjall op, and the whole-window call therefore blocked a
    ; point get for the entire scan (measured max 3421ms vs a 0.05ms median).
    ; Each chunk releases that lane, so other work interleaves and the native
    ; transient is bounded by the chunk, not by the table. The port's contract
    ; is unchanged — the same vector, same order, inclusive bounds.
    ;
    ; The values are decoded NATIVELY (:pairs), which is not an optimisation
    ; detail but a correctness-of-cost one: the packed value lane is cheap only
    ; for a compiled reader, and decoding it in the BEAM made this method four
    ; times slower than the ETF it replaced (1964ms against 479ms over 50 000
    ; rows). A port method that the whole database's reads rest on must not get
    ; slower when the storage format improves.
    ; chunks are accumulated as erlang lists and joined ONCE: `into` over a list
    ; is a core `reduce` that consults `core/reduced?` per element (~190 reductions
    ; each, measured), which made a full scan 460 reductions a datom.
    (loop [chunks '() start lo after nil]
      (let [res (fjall-resolve-chunk (:handle store) start after hi CHUNK-ROWS (native-read-mode :pairs))
            n (get res "n")]
        (if (nil? n)
          (throw (ex-info (str "native range read failed: " res) {:lo lo :hi hi}))
          (let [last (get res "last")]
            (if (nil? last)
              (vec (lists/append (lists/reverse chunks)))
              (recur (cons (to-list (get res "pairs")) chunks) nil last)))))))

  (-put [store k v]
    (native-mutation-admit! store)
    (let [encoded (encode-value v) answer (native-mutation store :fjall-put [k encoded])]
     (when (= :legacy answer) (fjall-put (:handle store) k encoded)))
    store)

  (-delete [store k]
    (native-mutation-admit! store)
    (when (= :legacy (native-mutation store :fjall-delete [k]))
     (fjall-delete (:handle store) k))
    store)

  (-update [store k f]
    ; A compare-and-swap LOOP: -get then -put is not atomic, so two writers can
    ; both read t=41 and both write t=42. The NIF does its read+write under the
    ; handle lock, so a losing attempt is DETECTED (the {swapped?, value} flag),
    ; and the loop re-reads. `f` must be pure — it may run more than once. No
    ; attempt ceiling: every failed iteration failed BECAUSE another writer won,
    ; so the system always makes progress; yield after a few spins to avoid a
    ; livelock under heavy contention.
    (native-mutation-admit! store)
    (loop [attempt 0]
      (let [_ (native-mutation-admit! store)
            raw (fjall-get (:handle store) k)
            next (native-update-callback #(f (decode-value raw)))
            encoded (encode-value next)
            accepted (native-mutation store :fjall-cas [k raw encoded])
            result (if (= :legacy accepted) (fjall-cas (:handle store) k raw encoded) (second accepted))]
        (if (erlang/element 1 result)
          [store next]
          (do (if (> attempt 8) (erlang/yield) nil)
              (recur (+ attempt 1)))))))

  (-commit [store ops]
    ; THE method this backend exists for: the whole batch lands together or not
    ; at all, applied IN ORDER — [[:delete k] [:put k v]] is a retract-then-
    ; reassert, so grouping puts ahead of deletes would lose the value.
    (native-mutation-admit! store)
    (let [encoded (mapv (fn [op]
                          (if (= (get op 0) :put)
                           [:put (get op 1) (encode-value (get op 2))]
                           [:delete (get op 1)])) ops)
          answer (native-mutation store :fjall-commit [encoded])]
     (when (= :legacy answer)
      (fjall-commit (:handle store)
       (to-list (mapv #(erlang/list_to_tuple (to-list %)) encoded)))))
    store))

;; fjall is a DIRECTORY keyspace (segment files), not a single file; `.fjall`
;; names that. Extending from the protocol side, the same AOT-safe way the store
;; and Scan do (two `extend-type <Type>` blocks would collide under AOT).
(extend-protocol datom.store/FileBacked
  FjallStore
  (-path-suffix [store] ".fjall"))

;; A durable database keeps its file bytes beside it: `<path>.blobs`, a
;; sibling directory, so database and bytes are backed up and moved as one.
;; `(:path store)` is the store's CANONICAL directory (see `open`), so the
;; sibling is derived from the store's one identity and not from whatever
;; spelling a caller opened it with — an alias reaches the SAME bytes.
;; S3 is the opt-in for this tier (`{:blobs (datom.blob-s3/open …)}`).
(extend-protocol datom.blob/DefaultBlobs
  FjallStore
  (-default-blobs [store] (datom.blob-fs/open (str (:path store) ".blobs"))))

;; Closing a durable store is a durability boundary, not a deletion: sync the
;; journal, then let go. The exclusive OS lock `open` took lives on the native
;; handle's fd, so it goes with the handle: after `datom.conn/release!` has
;; dropped the registry's last reference, collection frees the resource and
;; closes that fd; a process that dies releases it without any of this. Nothing
;; here has to remember to unlock, which is the point of holding it on an fd
;; rather than in a file.
(extend-protocol datom.store/Closeable
  FjallStore
  (-close [store]
   (when (= :legacy (native-mutation store :fjall-sync [])) (fjall-sync (:handle store))) nil))

(defn open-fresh
  "Open a fjall store at a fresh unique path. The engine owns its naming
   convention (a directory keyspace), so a caller never hardcodes a suffix."
  []
  (open (datom.store/fresh-path ".fjall")))

(defn sync!
  "Force everything written so far to disk. Writes journal (crash-recoverable)
   on each put/commit but do NOT fsync per call — fsyncing per datom-group is the
   dominant bulk-load cost. Call this once at a durability boundary (end of a
   transaction or a bulk load) to turn N per-group fsyncs into one."
  [store]
  (when (= :legacy (native-mutation store :fjall-sync [])) (fjall-sync (:handle store)))
  store)

(extend-protocol datom.store/Durable
  FjallStore
  (-sync [store] (sync! store)))

(defn stats
  "What the engine itself reports: block-cache capacity, the write buffer,
   compaction (count, in flight, time spent), and the disk/journal accounting.

   WHY THIS EXISTS. `lsm-tree`'s block cache exposes size/capacity and NO hit or
   miss counters, so a block-cache hit rate cannot be measured on this stack —
   ever. What answers the same question is (a) how much the read path pulls from
   the OS (measured with `rchar` deltas; see knowledger's
   `semantica/benches/bench-s93.bl`) and (b) how full the cache is, which is this.
   Before it, `the cache is too small` was an inference, and compaction — the
   thing that decides write amplification — had never been observed at all.

   Returns a map of plain numbers; `:cache_capacity` is bytes."
  [store]
  (fjall-stats (:handle store)))

(defn- checkpoint-result [result]
 (when (and (erlang/is_tuple result) (= 2 (erlang/tuple_size result)) (= :error (elem result 0)))
  (throw (ex-info "Native checkpoint failed" {:kind :checkpoint-failed :native (elem result 1)})))
 result)

(defrecord FjallCheckpointCursor [handle])
(defrecord FjallCheckpointArtifact [handle])
(extend-protocol datom.store/Checkpoint
 FjallStore
 (-capture-checkpoint [store]
  (when (not= :legacy (native-mutation-admit! store))
   (BeamLisp.Env/assert_native_framework_execution!))
  (->FjallCheckpointCursor (checkpoint-result (fjall-checkpoint-capture (:handle store))))))
(extend-protocol datom.store/CheckpointCursor
 FjallCheckpointCursor
 (-begin-checkpoint [cursor destination]
  (->FjallCheckpointArtifact (checkpoint-result (fjall-checkpoint-begin (:handle cursor) destination))))
 (-release-checkpoint [cursor] (checkpoint-result (fjall-checkpoint-release (:handle cursor)))))
(extend-protocol datom.store/CheckpointArtifact
 FjallCheckpointArtifact
 (-step-checkpoint [artifact rows bytes]
  (let [result (checkpoint-result (fjall-checkpoint-step (:handle artifact) rows bytes))]
   {:done? (elem result 0) :copied (elem result 1) :entries (elem result 2) :bytes (elem result 3)}))
 (-finish-checkpoint [artifact]
  (let [tag (erlang/make_ref)
        _ (checkpoint-result (fjall-checkpoint-finish (:handle artifact) (erlang/self) tag))
        result (receive [reply-tag value] :when (= reply-tag tag) (checkpoint-result value))]
   {:status :complete :kind :logical :path (elem result 0) :source (elem result 1)
    :sequence (elem result 2) :entries (elem result 3) :bytes (elem result 4) :durability :stable}))
 (-abort-checkpoint [artifact] (checkpoint-result (fjall-checkpoint-abort (:handle artifact)))))

(defn publish-directory!
 "Fsync a complete private staging tree, atomically publish to a distinct
  canonical sibling without clobbering, and fsync its parent. Runs off DirtyIo.
  Accepted publication outlives caller death; reconcile an existing destination
  after an uncertain response. Caller owns staging contents and verification."
 [stage destination]
 (let [tag (erlang/make_ref)
       _ (checkpoint-result (fjall-publish-directory stage destination (erlang/self) tag))]
  (receive [reply-tag value] :when (= reply-tag tag) (checkpoint-result value))))

(defn sync-directory!
 "Re-establish durable tree and parent sync after verifying an uncertain private
  publication. Refuses aliases, symlinks and observed identity replacement.
  Caller owns immutable contents. Runs on an owned worker outside DirtyIo."
 [path]
 (let [tag (erlang/make_ref)
       _ (checkpoint-result (fjall-sync-directory path (erlang/self) tag))]
  (receive [reply-tag value] :when (= reply-tag tag) (checkpoint-result value))))
