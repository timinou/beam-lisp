;; Closed physical access paths over existing, writer-certified derived tuples.
;; This module changes neither query semantics nor persisted key encoding.
(ns datom.compound
  (:require [datom.codec :as codec] [datom.index :as index] [datom.schema :as schema]
            [datom.db :as db] [datom.index-coverage :as coverage] [datom.query.parse :as parse]))

(def SCALAR-TYPES #{:db.type/long :db.type/ref :db.type/instant :db.type/string
                    :db.type/keyword :db.type/boolean})
(defn tuple-prefix
  "Typed proper component prefix of a declared indexed tuple. Unsupported,
   empty, full-length or ill-typed prefixes refuse; full tuples use key-prefix."
  [sch attr components]
  (let [attrs (schema/tuple-attrs sch attr)]
    (when (and (vector? components) (seq components) (< (count components) (count attrs))
               (schema/indexed? sch attr) (not (schema/many? sch attr))
               (every? (fn [[a v]] (and (schema/known? sch a) (not (schema/many? sch a))
                                        (contains? SCALAR-TYPES (schema/value-type sch a))
                                        (nil? (schema/validate-value sch a v))))
                       (map (fn [a v] [a v]) attrs components)))
      (let [encoded (codec/encode-value components)]
        ;; The existing VECTOR encoder terminates with zero. Components within
        ;; it are self-delimited, so dropping only this terminator is exact.
        (codec/concat-bins [(index/key-prefix :avet attr)
                           (binary/part encoded 0 (dec (erlang/byte_size encoded)))])))))

(defn path
  "Select a certified [scope order] tuple from ordinary bound same-root
   patterns. A residual authorization clause still evaluates on every entity;
   finding a physical scope is never an authorization verdict."
  [database where bindings root order-attr]
  (let [sch (db/schema-of database) s (db/store-of database) basis (db/basis-t database)]
    (first (keep (fn [a]
                   (let [attrs (schema/tuple-attrs sch a) scope-attr (first attrs)
                         clause (first (filter (fn [c] (and (parse/pattern-clause? c)
                                                            (= root (get c 0)) (= scope-attr (get c 1)))) where))
                         term (get clause 2) bound (and clause (or (not (parse/variable? term)) (contains? bindings term)))
                         value (if (parse/variable? term) (get bindings term) term)]
                     (when (and (= 2 (count attrs)) (= order-attr (second attrs)) bound
                                (contains? SCALAR-TYPES (schema/value-type sch order-attr))
                                (not (schema/many? sch order-attr))
                                (coverage/complete? s sch a basis))
                       (when-let [lo (tuple-prefix sch a [value])]
                         {:attr a :scope value :lo lo :tuple true}))))
                 (sort (keys sch))))))
