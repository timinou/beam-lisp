; datom/file.bl — a file is a FACT; its bytes are not.
;
; ── The one constraint that shapes everything here ────────────────────
;
; A datom's value is written into 2–4 covering indexes, and in AVET the value
; is part of the KEY. Put a 40 MB binary in a datom and the database writes
; 80–160 MB of index entries and hands the key encoder a 40 MB term. So a
; file datom holds a small CONTENT-ADDRESSED DESCRIPTOR — sha256, size, media
; type, ~50 bytes — and the bytes live in a second port, `datom.blob`, keyed
; by that sha.
;
; Content addressing is not a storage trick; it is what makes a file behave
; like every other value in this database:
;
;   immutable   → `as-of` resolves the SAME bytes forever; history never lies
;   dedup       → two entities with one attachment cost one blob
;   idempotent  → a retried upload is a no-op, never a duplicate
;   "edit"      → assert a NEW DFile; the old fact is retracted like any other
;
; ── Two shapes, one record ────────────────────────────────────────────
;
; At rest a DFile is `{sha size media-type}`. STAGED — between the caller and
; the commit — it additionally carries `:body`, the bytes themselves. The
; transaction pipeline uploads a staged body to the blob store and strips it
; before a single index entry is written; a body never reaches an index, and
; a broadcast report never carries one. Metadata beyond the descriptor
; (filename, uploader, created-at) belongs in ORDINARY attributes on the
; entity, where it is queryable — not buried in a map.

(ns datom.file)

(defrecord DFile [sha size media-type])

(defn sha256
  "The 32-byte sha256 of `bytes`."
  [bytes]
  (crypto/hash :sha256 bytes))

(defn sha-hex
  "The lowercase hex of a DFile's (or a raw) sha — the form that names a
   path or an object key."
  [sha-or-file]
  (String/downcase
    (binary/encode_hex (if (map? sha-or-file) (:sha sha-or-file) sha-or-file))))

(defn file
  "Stage `bytes` as a file value: a DFile carrying its `:body`.

   The ONLY constructor that hashes. The sha is computed here, once, in the
   caller's process — never in the writer, which must not do O(bytes) work
   inside the serializer."
  ([bytes] (file bytes {}))
  ([bytes opts]
   (assoc (->DFile (sha256 bytes) (erlang/byte_size bytes) (get opts :media-type))
          :body bytes)))

(defn file?
  "Whether `v` is a file value (staged or at rest)."
  [v]
  (instance? DFile v))

(defn staged?
  "Whether `v` is a file value still carrying its bytes."
  [v]
  (and (file? v) (some? (get v :body))))

(defn at-rest
  "The descriptor alone: a staged DFile with its body removed. Rebuilt rather
   than `dissoc`ed so the result is exactly the three-field record whatever
   the input carried."
  [df]
  (->DFile (:sha df) (:size df) (:media-type df)))
