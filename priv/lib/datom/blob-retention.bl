; Node-local whole-tier retention. A pin protects captured historical references
; while a live exporter discovers them; puts remain available, deletion refuses.
(ns datom.blob-retention)
(def ^:private registry-key :datom.blob-retention/registry)
(defn- registry []
 (or (erlang/apply :persistent_term :get (list registry-key nil))
  (BeamLisp.Env/with_generation_lock (tuple :blob-retention :registry)
   (fn [] (or (erlang/apply :persistent_term :get (list registry-key nil))
    (let [r (atom {})] (erlang/apply :persistent_term :put (list registry-key r)) r))))))
(defn- locked [identity f]
 (BeamLisp.Env/with_generation_lock (tuple :blob-retention identity)
  (fn []
   (let [r (registry)]
    (swap! r (fn [all]
     (let [live (into {} (filter (fn [[_ owner]] (Process/alive? owner)) (get all identity)))]
      (if (seq live) (assoc all identity live) (dissoc all identity)))))
    (f r)))))
(defn acquire! [identity]
 (locked identity (fn [r]
  (let [token (erlang/make_ref)]
   (swap! r assoc-in [identity token] (erlang/self))
   {:identity identity :token token :owner (erlang/self)}))))
(defn release! [identity pin]
 (when-not (= identity (:identity pin))
  (throw (ex-info "Blob retention identity mismatch" {:kind :blob-retention-identity})))
 (locked identity (fn [r] (swap! r (fn [all] (let [left (dissoc (get all identity) (:token pin))]
   (if (seq left) (assoc all identity left) (dissoc all identity))))) :released)))
(defn retained? [identity]
 (locked identity (fn [r] (boolean (seq (get @r identity))))))
(defn with-delete! [identity f]
 (locked identity (fn [r]
  (when (seq (get @r identity))
   (throw (ex-info "Blob tier has a live historical retention pin" {:kind :blob-retention-active})))
  (f))))
