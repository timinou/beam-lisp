; datom/store-overlay.bl — a read-through store for SPECULATIVE writes.
;
; ── What this is for ──────────────────────────────────────────────────
;
; `with` (datom.conn/with) applies a transaction and returns the database
; value that WOULD result, without committing anything to the connection.
; The migration system's dry-run (datom.migrate/plan) rests on it: preview
; a whole migration — its data transform AND its schema grow — against a
; production database value, and learn what breaks before deploying.
;
; The hard part is not "don't advance the basis". It is the STORE. A
; speculative write must not mutate the base, and the development
; substrate (store-ets) is a shared mutable table with NO transactions:
; writing into it and retracting afterwards would be visible to concurrent
; readers mid-flight and unrecoverable on a crash. Speculation must not be
; a PLACE — the same reason a database is a value.
;
; ── How it works ──────────────────────────────────────────────────────
;
; An overlay holds a BASE store (read-only to it) and a small speculative
; BUFFER (a sorted map in an atom). Reads consult the buffer first, then
; fall through to the base. Writes land ONLY in the buffer. The base is
; never touched, so the same base can back any number of independent
; speculations at once.
;
; ── Why no deletion-masking is needed ─────────────────────────────────
;
; A subtlety that makes this forty lines instead of two hundred: datom
; writes are ALL `[:put k v]` of NEW keys. A retraction is a new datom
; with `op` encoded IN its key (see codec.bl), never a store `-delete` of
; an existing key. So a speculative transaction only ever ADDS keys the
; base does not have; it never needs to hide a base key. The buffer is a
; pure addition, and `-range` is a straight merge with the buffer winning
; only on the id COUNTER keys it re-increments.
;
; ── Cost ──────────────────────────────────────────────────────────────
;
; Zero up front (no copy). Each speculative read is one base range plus a
; buffer merge; a dry-run therefore transfers only the columns it actually
; reads. That is the right shape for "plan THIS migration" against a large
; remote store — measured against the clone alternative in
; examples/datom/10-with-efficiency.bl.
;
; A wrapper must not downgrade a CAPABILITY
; ─────────────────────────────────────────────────────────────────────
;
; The port is deliberately tiny, and the fast reads are OPTIONAL protocols
; beside it (`Scan`, `MultiScan`, `PageScan`). That design has one trap, and
; this wrapper fell into it: an optional protocol is dispatched with
; `satisfies?` on the store VALUE, so a wrapper that implements only `Store`
; silently removes every fast path beneath it. An overlay over fjall lost all
; three — so the engine's semi-join read a 64 708-row column instead of
; 3 520 datoms (4.1–6.4 s instead of 0.73 s), a datom scan paid a per-row key
; decode it did not need, and a bounded page materialized the whole range.
; None of it raised: a dry-run is just quiet and slow.
;
; So this wrapper forwards each capability, and forwards it only when the
; speculative buffer cannot change the answer. Buffered writes are NEW keys,
; so a read whose bounds the buffer does not touch gets the BASE's answer
; unchanged — one native request, not a merge. When the buffer IS inside the
; bounds the merge is mandatory (a speculation's datoms must be visible), so
; that bound falls back to `-range` plus a key-ordered merge: correct, and
; the only case that is not a single request.
;
; `Underlying` is the same lesson for the caches ABOVE the port: they key by
; store value, so a wrapper declares what it wraps (`datom.store/identity-of`).

(ns datom.store-overlay
  (:require [datom.store]))

(defrecord OverlayStore [base buffer])          ; buffer: atom of sorted-map

(defn open
  "An overlay over `base`. Reads fall through to `base`; writes stay in a
   private buffer `base` never sees."
  [base]
  (->OverlayStore base (atom (sorted-map))))

(defn- buffer-get
  "The buffer's value at `k`, or the sentinel `:datom.store-overlay/miss`
   when the buffer does not hold `k` (distinct from a stored nil, though
   the layers above never store nil)."
  [store k]
  (get (deref (:buffer store)) k :datom.store-overlay/miss))

(extend-type OverlayStore
  datom.store/Store

  (-get [store k]
    (let [b (buffer-get store k)]
      (if (= b :datom.store-overlay/miss)
        (datom.store/-get (:base store) k)
        b)))

  (-range [store lo hi]
    ; base ∪ buffer within [lo,hi], buffer winning on a key collision
    ; (only the counters collide), returned in ascending key order. The
    ; merge builds a sorted map so ordering is the map's, not a re-sort.
    (let [base-entries (datom.store/-range (:base store) lo hi)
          in-bounds (filterv (fn [e]
                               (let [k (get e 0)]
                                 (and (or (nil? lo) (not (erlang/< k lo)))
                                      (or (nil? hi) (not (erlang/> k hi))))))
                             (into [] (seq (deref (:buffer store)))))
          merged (reduce (fn [m e] (assoc m (get e 0) (get e 1)))
                         (reduce (fn [m e] (assoc m (get e 0) (get e 1)))
                                 (sorted-map) base-entries)
                         in-bounds)]
      (into [] (seq merged))))

  (-put [store k v]
    (swap! (:buffer store) (fn [m] (assoc m k v)))
    store)

  (-delete [store k]
    ; Included for protocol completeness. Datom writes never delete a base
    ; key, so this only ever removes a key the SPECULATION itself wrote.
    (swap! (:buffer store) (fn [m] (dissoc m k)))
    store)

  (-update [store k f]
    ; Atomic read-modify-write against the OVERLAID value: read through to
    ; base when the buffer has not seen `k` yet, apply `f`, write the
    ; result to the buffer. This is how the id counters advance during a
    ; speculation without touching the base counters — the next real
    ; transaction on the base allocates the SAME ids the speculation used,
    ; which is correct: the speculation never happened.
    (let [cur (let [b (buffer-get store k)]
                (if (= b :datom.store-overlay/miss)
                  (datom.store/-get (:base store) k)
                  b))
          nv (f cur)]
      (swap! (:buffer store) (fn [m] (assoc m k nv)))
      [store nv]))

  (-commit [store ops]
    ; One swap! for the whole batch, so a reader never observes a
    ; half-applied speculative transaction — the same atomicity the map
    ; store provides, over the buffer alone.
    (swap! (:buffer store)
           (fn [m]
             (reduce (fn [acc op]
                       (if (= (get op 0) :put)
                         (assoc acc (get op 1) (get op 2))
                         (dissoc acc (get op 1))))
                     m
                     ops)))
    store))

;; ── the wrapper's identity for cache keys ───────────────────────────
;;
;; A dry-run IS the base for the purpose of "has this attribute changed?":
;; the speculation is invisible to the base, and the base's marks are the
;; truth for what the base holds. Keyed by the overlay's own record value,
;; the derived-column caches (`datom.attr-basis`, `datom.query.corpus`) grow
;; a second copy of a column the base had already built.

(extend-protocol datom.store/Underlying
  OverlayStore
  (-underlying [store] (:base store)))

;; ── the optional read capabilities, forwarded ───────────────────────
(defn- in-bounds?
  [k lo hi]
  (and (or (nil? lo) (not (erlang/< k lo)))
       (or (nil? hi) (not (erlang/> k hi)))))

(defn- buffered-keys
  "The buffer's keys within `[lo, hi]`, ascending. A read of that window must
   see these on top of the base's answer; an EMPTY result is the proof that it
   need not, which is what lets every forward below be one request."
  [store lo hi]
  (filterv (fn [k] (in-bounds? k lo hi)) (keys (deref (:buffer store)))))

(defn- overlay-entries
  "The base's `[k v]` entries in `[lo, hi]` with the buffer's merged in, in key
   order, the buffer winning on a collision (only the id counters collide)."
  [store lo hi]
  (let [base (datom.store/-range (:base store) lo hi)
        buf (filterv (fn [e] (in-bounds? (get e 0) lo hi))
                     (into [] (seq (deref (:buffer store)))))]
    (into [] (seq (reduce (fn [m e] (assoc m (get e 0) (get e 1)))
                          (reduce (fn [m e] (assoc m (get e 0) (get e 1)))
                                  (sorted-map) base)
                          buf)))))

(defn- datoms-of [entries] (mapv (fn [e] (get e 1)) entries))

(extend-protocol datom.store/Scan
  OverlayStore
  (-scan-datoms [store lo hi]
    (if (empty? (buffered-keys store lo hi))
      (datom.store/scan-datoms (:base store) lo hi)
      (datoms-of (overlay-entries store lo hi)))))

(extend-protocol datom.store/MultiScan
  OverlayStore
  (-scan-prefixes [store bounds]
    (if (every? (fn [b] (empty? (buffered-keys store (get b 0) (get b 1)))) bounds)
      (datom.store/scan-prefixes (:base store) bounds)
      (into [] (mapcat (fn [b]
                         (datoms-of (overlay-entries store (get b 0) (get b 1))))
                       bounds)))))

(extend-protocol datom.store/PageScan
  OverlayStore
  (-scan-datoms-page [store start after hi limit]
    (if (empty? (buffered-keys store (or start after) hi))
      (datom.store/page-datoms (:base store) start after hi limit)
      (datom.store/scan-via-range-page store start after hi limit))))

;; A bounded key count forwards only when the speculative buffer does not
;; touch the range. Materializing the merged range just to choose a scan shape
;; would defeat the bound on this probe; nil keeps the engine's old safe gate.
(extend-protocol datom.store/Count
  OverlayStore
  (-count-range [store lo hi limit]
    (if (empty? (buffered-keys store lo hi))
      (datom.store/count-range (:base store) lo hi limit)
      nil)))

;; `Alive?` forwards: an overlay over a handle that died with its owner is not
;; usable, and `alive?` exists for the caller that MEMOIZED the handle. Not
;; forwarded, deliberately: `Closeable` (closing a speculation must never close
;; its base) and `FileBacked` (an overlay is never opened at a path, so it has
;; no naming convention to declare). Both defaults are the truthful answer.

(extend-protocol datom.store/Alive?
  OverlayStore
  (-alive? [store] (datom.store/alive? (:base store))))
