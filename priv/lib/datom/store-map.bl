; datom/store-map.bl — a second Store, to prove the port is real.
;
; ── Why a second implementation exists ────────────────────────────────
;
; A port with ONE implementation is a hypothesis. Everything above L1
; claims to depend only on the protocol, but nothing tests that claim:
; an assumption about ETS could be threaded through the whole stack and
; nobody would notice until a persistent backend was half-written.
;
; So this is the control. A sorted map in an atom — no ETS, no tables, no
; process ownership, different concurrency story, different everything.
; If the full datom suite passes against BOTH, the port is genuine. If it
; does not, the failures are precisely the leaks.
;
; It is also the reference an author of a real backend can read: it is
; forty lines, so what the six methods must actually DO is visible at a
; glance rather than buried in ETS specifics.
;
; ── What it is not ────────────────────────────────────────────────────
;
; Not fast (a sorted map rebuilt per write), not durable, not concurrent.
; It exists to be CORRECT and OBVIOUS. `store-ets` remains the
; development substrate.

(ns datom.store-map
  (:require [datom.store] [datom.blob] [datom.blob-ets]))

(defrecord MapStore [state])

(defn open
  "A fresh store backed by a sorted map in an atom.

   Sorted, because `-range` must return keys in order \u2014 that is the one
   requirement the whole database rests on, and a hash map would satisfy
   every other method while silently breaking every prefix scan."
  []
  (->MapStore (atom (sorted-map))))

(extend-type MapStore
  datom.store/Store

  (-get [store k]
    (get (deref (:state store)) k))

  (-range [store lo hi]
    ; Bounds are INCLUSIVE on both sides — the port says so, matching
    ; `subseq` in core. This implementation originally used a half-open
    ; range, and the conformance suite caught the disagreement on its
    ; first run: two stores answering the same scan differently is
    ; exactly the class of defect a second implementation exists to
    ; expose.
    ;
    ; `prefix-end` appends 0xFF, which sorts above every real component
    ; tag, so an inclusive upper bound still excludes the next prefix.
    ;
    ; `nil` on either side means unbounded.
    (into []
          (filterv (fn [entry]
                     (let [k (get entry 0)]
                       (and (or (nil? lo) (not (erlang/< k lo)))
                            (or (nil? hi) (not (erlang/> k hi))))))
                   (into [] (seq (deref (:state store)))))))

  (-put [store k v]
    (swap! (:state store) (fn [m] (assoc m k v)))
    store)

  (-delete [store k]
    (swap! (:state store) (fn [m] (dissoc m k)))
    store)

  (-update [store k f]
    ; Atomic read-modify-write. `swap!` retries on contention, so `f`
    ; must be pure \u2014 which is exactly the contract the port states.
    (let [updated (swap! (:state store)
                         (fn [m] (assoc m k (f (get m k)))))]
      [store (get updated k)]))

  (-commit [store ops]
    ; Operations apply IN ORDER, which is correctness rather than
    ; optimisation: `[[:delete k] [:put k 2]]` \u2014 what a transaction emits
    ; when it retracts and re-asserts a datom \u2014 must end with the value
    ; present. Reordering to batch the puts loses it.
    ;
    ; One `swap!` for the whole batch, so a reader never observes a
    ; half-applied transaction. That is the atomicity the ETS
    ; implementation cannot provide and a real substrate must.
    (swap! (:state store)
           (fn [m]
             (reduce (fn [acc op]
                       (if (= (get op 0) :put)
                         (assoc acc (get op 1) (get op 2))
                         (dissoc acc (get op 1))))
                     m
                     ops)))
    store))

;; In memory, like store-ets: file bytes default to the memory tier.
(extend-protocol datom.blob/DefaultBlobs
  MapStore
  (-default-blobs [store] (datom.blob-ets/open)))

