; datom/db.bl — the database as a VALUE.
;
; ── The idea Datomic is built on ──────────────────────────────────────
;
; A database is not a place you query. It is a VALUE you hold: an
; immutable snapshot, cheap to pass around, that never changes underneath
; you. Two queries against the same db value see exactly the same facts,
; forever, regardless of what anyone else transacts meanwhile.
;
; That is the difference from every place-oriented database, and almost
; everything pleasant about Datomic follows from it:
;
;   - a query needs no transaction or isolation level; the snapshot IS
;     the isolation
;   - `as-of` is not a special mode, just a different value
;   - a function taking a db is referentially transparent, so it can be
;     tested with a literal db rather than a live connection
;
; ── How a snapshot can be cheap ───────────────────────────────────────
;
; The db does NOT copy any data. It holds the store plus a BASIS: the
; transaction id it was taken at. Since datoms are never mutated or
; deleted — a "change" appends a retraction and an assertion at a NEW tx
; — every datom carries the tx that recorded it, and a snapshot is simply
; "ignore everything after basis-t".
;
; So `(db conn)` is O(1), and the db value from an hour ago still answers
; queries about the world as it was an hour ago. Wave 5's `as-of` is the
; same mechanism with a different number.
;
; ── Current vs historical ─────────────────────────────────────────────
;
; `:current` filtering — the default — answers "what is true NOW (at
; basis-t)": a datom counts only if it was asserted at or before the
; basis and not retracted since.
;
; `:history` keeps every datom, assertions and retractions alike. That is
; what makes "when did this value change, and to what?" answerable, and
; it is the mode wave 5's `history` selects.

(ns datom.db
  (:require [datom.index] [datom.schema] [datom.store]))

; `blobs` is the bytes port (datom.blob) a `:db.type/file` datom resolves
; through. It rides on the VALUE so `file-bytes` needs no registry lookup and
; an `as-of` db resolves a retracted file's bytes exactly as the live db does.
(defrecord Db [store schema basis-t filter-mode since-t blobs])

(defn db-value
  "A database value over `store` as of `basis-t`. `blobs` is the blob store
   file values resolve through (nil for a database that holds no files)."
  ([store schema basis-t] (db-value store schema basis-t nil))
  ([store schema basis-t blobs]
   (->Db store schema basis-t :current nil blobs)))

(defn blobs-of [db] (:blobs db))

(defn basis-t
  "The transaction id this value was taken at. Every datom recorded after
   it is invisible here."
  [db]
  (:basis-t db))

(defn schema-of [db] (:schema db))
(defn store-of [db] (:store db))

;; ── visibility ──────────────────────────────────────────────────────

(defn- within-basis?
  "Whether a datom was recorded at or before this value's basis."
  [db d]
  (<= (datom.index/-tx d) (basis-t db)))

(defn- retraction-key
  "The identity of the FACT a datom is about: `[e a v]`.

   Assertions and retractions of the same fact share this key, which is
   what lets a single pass pair them up."
  [d]
  [(datom.index/-e d) (datom.index/-a d) (datom.index/-v d)])

(def FILTER-STATS
  "Which path `filter-datoms` took, counted: `{:fast n :indexed n}`. A
   diagnostic for cost_test, not a metric anyone should read in production —
   it exists so the fast path is PROVEN taken rather than assumed."
  (atom {}))

(def ^:private VALID-FOREVER 253402300799999)  ; #inst "9999-12-31T23:59:59.999" ms

(defn- tx-valid-window
  "The `[from to)` valid-time window of transaction `tx`, read from its
   `:db.valid/from` / `:db.valid/to` datoms. A tx with no `:db.valid/from` is
   always-valid: `[MIN, MAX)`. Reads the tx entity's own datoms directly from
   the store (a tx entity is small), UNFILTERED — the window is metadata about
   when facts are true, not itself a time-travelled fact."
  [db tx]
  (let [ds (datom.index/scan (store-of db) :eavt tx)
        from (reduce (fn [acc d] (if (= :db.valid/from (datom.index/-a d)) (datom.index/-v d) acc)) nil ds)
        to (reduce (fn [acc d] (if (= :db.valid/to (datom.index/-a d)) (datom.index/-v d) acc)) nil ds)]
    [(or from 0) (or to VALID-FOREVER)]))

(defn- index-retractions
  "The retractions in `ds` as a `[e a v] → tx` map, for pairing against
   assertions. Only ever called with retractions (the caller splits first), so
   nothing here asks each row what it is."
  [db retracts]
  (reduce (fn [acc d]
            (if (within-basis? db d)
              (let [k (retraction-key d)
                    tx (datom.index/-tx d)
                    known (get acc k)]
                (if (and (some? known) (>= known tx)) acc (assoc acc k tx)))
              acc))
          {}
          retracts))

(defn- later-retraction?
  "Whether a `[e a v]` fact was retracted at or after `tx` — the check that
   pairs an assertion with the retraction that un-asserted it."
  [retractions d tx]
  (let [r (get retractions (retraction-key d))]
    (or (nil? r) (< r tx))))

(defn filter-datoms
  "Apply this value's filter to a scan result, in ONE pass over the candidates
   (and a second only when a retraction actually has to be paired).

   `:history` keeps every visible datom — including retractions, which
   are the record of what STOPPED being true and when. `:current` keeps
   only what holds at the basis. A `:valid-at`/`:valid-between` bound then
   filters by VALID time — when each fact's transaction says it is true in the
   world — the second bitemporal axis, applied here so every reader honours it.

   The basis, the since bound, the filter mode and the valid-time window are
   read from `db` ONCE and closed over, never re-read inside the loop. That is
   not tidiness: reading a field out of a large structure costs reductions in
   proportion to the structure's size (S1 measured `(:basis-t db)` at ~700
   reductions a row over 64 708 rows, and a padded db at 14x that), so the
   per-row shape here is two field reads and two comparisons.

   The retraction pairing is skipped entirely when the scan holds no
   retraction — decided by one short-circuiting pass that does not
   materialise anything, not by a pass per row that then has to."
  [db candidates]
  (let [bt (basis-t db)
        st (:since-t db)
        va (:valid-at db)
        vb (:valid-between db)]
    (if (and (nil? va) (nil? vb))
      ; no valid-time bound: transaction-time filtering only, as before.
      (if (= (:filter-mode db) :history)
        (do (swap! FILTER-STATS (fn [m] (assoc m :history (inc (get m :history 0)))))
            (filterv (fn [d] (let [tx (datom.index/-tx d)]
                               (and (<= tx bt) (or (nil? st) (> tx st)))))
                     candidates))
        ; THE common case: a scan that holds no retraction at all. Then every
        ; visible datom is an assertion that nothing has un-asserted, and the
        ; `[e a v] → tx` pairing map is never built — one pass to know, one pass
        ; for basis visibility. The pairing pass runs only when owed, and then
        ; only over the retractions (a 64 708-row column with one retraction in
        ; it pays for that one).
        (if (every? datom.index/assertion? candidates)
          (do (swap! FILTER-STATS (fn [m] (assoc m :fast (inc (get m :fast 0)))))
              (filterv (fn [d] (let [tx (datom.index/-tx d)]
                                 (and (<= tx bt) (or (nil? st) (> tx st)))))
                       candidates))
          (do (swap! FILTER-STATS (fn [m] (assoc m :indexed (inc (get m :indexed 0)))))
              (let [retractions (index-retractions
                                  db (filterv datom.index/retraction? candidates))]
                (filterv (fn [d] (let [tx (datom.index/-tx d)]
                                   (and (<= tx bt)
                                        (or (nil? st) (> tx st))
                                        (datom.index/assertion? d)
                                        (later-retraction? retractions d tx))))
                         candidates)))))
      ; A valid-time bound changes the ORDER: valid-time is filtered FIRST, then
      ; transaction-time supersession is computed AMONG the surviving datoms.
      ; This is the essence of bitemporality — a fact superseded by a later
      ; transaction whose VALID window does not cover `t` is still current AT `t`.
      ; (A newer price valid from Jan 15 does not un-current the Jan 1 price when
      ; asking "what was true on Jan 10?".) Retraction/basis still apply within
      ; the valid-time slice.
      (let [cache (atom {})
            window-of (fn [tx]
                        (let [hit (get (deref cache) tx)]
                          (if (some? hit) hit
                            (let [w (tx-valid-window db tx)]
                              (swap! cache assoc tx w) w))))
            keep-window (fn [d]
                          (let [w (window-of (datom.index/-tx d))]
                            (if (some? va)
                              (and (<= (get w 0) va) (< va (get w 1)))
                              (let [a (get vb 0) b (get vb 1)]
                                (and (< (get w 0) b) (> (get w 1) a))))))
            visible-tx (fn [tx] (and (<= tx bt) (or (nil? st) (> tx st))))
            in-valid (filterv keep-window candidates)]
        (cond
          ; a RANGE (valid-between) is history-like: a fact valid anywhere in the
          ; range belongs in the answer, so cardinality-one supersession must NOT
          ; collapse two values that were each true at different points. Keep every
          ; visible assertion in the range (basis/since still apply).
          (some? vb)
            (filterv (fn [d] (and (visible-tx (datom.index/-tx d))
                                  (datom.index/assertion? d)))
                     in-valid)
          (= (:filter-mode db) :history)
            (filterv (fn [d] (visible-tx (datom.index/-tx d))) in-valid)
          ; a POINT (valid-at) is a single world-state: supersede within the slice.
          :else
            (if (every? datom.index/assertion? in-valid)
              (filterv (fn [d] (visible-tx (datom.index/-tx d))) in-valid)
              (let [retractions (index-retractions
                                  db (filterv datom.index/retraction? in-valid))]
                (filterv (fn [d] (let [tx (datom.index/-tx d)]
                                   (and (visible-tx tx)
                                        (datom.index/assertion? d)
                                        (later-retraction? retractions d tx))))
                         in-valid))))))))

;; ── reading ─────────────────────────────────────────────────────────

(defn datoms
  "Datoms from `index` matching `components`, filtered by this value.

   The single read path: every higher-level read (`entity`, `pull`, and
   wave 3's query engine) goes through here, so the time-travel filter
   cannot be bypassed by accident."
  [db index & components]
  (filter-datoms db (apply datom.index/scan (store-of db) index (or components '()))))

(defn datoms-many
  "Datoms from `index` matching ANY of `component-vectors`, filtered by
   this value, in one store request. The read a semi-join makes: the join's
   distinct bound values in, only their datoms out."
  [db index component-vectors]
  (filter-datoms db (datom.index/scan-many (store-of db) index component-vectors)))

(defn range-datoms
  "Datoms in `index` whose next component falls between `low` and `high`,
   filtered by this value's basis.

   The bounded counterpart of `datoms`: where that scans a whole prefix,
   this scans a WINDOW inside it. `[?e :person/age ?a]` with
   `20 <= ?a <= 30` reads only the ages in range rather than the whole
   column, so the cost follows the RESULT instead of the attribute.

   Bounds are `[value inclusive?]` or nil for unbounded on that side."
  [db index components low high]
  (filter-datoms db (datom.index/scan-range (store-of db) index components low high)))

(defn resolve-eid
  "An entity id from either an id or a lookup ref `[:attr value]`.

   `entity`, `entity-datoms` and any other entity-taking read here accept
   both spellings through this one rule, matching `pull` (pull.bl resolve-entity)
   and `q` (which resolve lookup refs in the `:avet` index). A lookup ref needs
   a `:db/unique` attribute and resolves to at most one id, or nil when nothing
   has that value."
  [db e]
  (if (vector? e)
    (let [attr (get e 0) v (get e 1)]
      (if (not (datom.schema/unique? (schema-of db) attr))
        (throw (ex-info "a lookup ref needs a :db/unique attribute"
                        {:attr attr :ref e}))
        (let [hits (datoms db :avet attr v)]
          (if (empty? hits) nil (datom.index/-e (first hits))))))
    e))

(defn entity-datoms
  "Every current datom about `e` (an id or a lookup ref)."
  [db e]
  (let [eid (resolve-eid db e)]
    (if (nil? eid) [] (datoms db :eavt eid))))

(defn attr-datoms
  "Every current datom for attribute `a` across all entities."
  [db a]
  (datoms db :aevt a))

;; ── attribute paging: the read a backfill can afford ────────────────
;;
;; Materializing a whole attribute column to walk it is what makes a backfill
;; O(corpus) in the middle of an otherwise incremental pipeline. `attribute-page`
;; is the bounded replacement: the next `limit` ENTITY groups of one attribute
;; after a cursor, each group read WHOLE.
;;
;; Why whole groups: AEVT orders a datom by (attribute, entity, …), so every
;; datom of one `[e a]` is contiguous — which means a native page boundary can
;; fall INSIDE an entity's datoms. Filtering a half group would build the
;; supersession map from half the retractions and could publish a stale value.
;; A group is therefore only filtered once the scan has shown the NEXT entity,
;; and it is filtered by the db value's OWN filter — so a snapshot, `as-of`,
;; `since` or `history` view all compose without a second visibility rule here.
;;
;; The cursor is the ENTITY, not a row: a group that is entirely retracted
;; still advances `:after-eid`, and a caller loops until `:more?` is false
;; rather than until the visible rows run out. `:datoms` holds only what the db
;; value says is visible.

(def ^:private PAGE-MIN-CHUNK
  "Smallest rows-per-native-crossing when paging. A page rescales its read to
   twice the entities asked for, so a column of one-datom entities reads about
   twice what it returns; the floor keeps a tiny page from crossing once per
   datom."
  16)

(def ^:private PAGE-MAX-CHUNK
  "Largest rows-per-native-crossing when paging. A ceiling keeps the native and
   BEAM transient bounded no matter how large the requested page is."
  1024)

(defn- page-chunk
  "Rows to ask the store for per crossing when paging `limit` entities."
  [limit]
  (min PAGE-MAX-CHUNK (max PAGE-MIN-CHUNK (* 2 limit))))

(defn- split-entity-groups
  "Split `datoms` (ascending by entity, as AEVT orders them) into CLOSED groups
   — entities a later datom has proven complete — and the trailing OPEN group of
   the last entity, which the next page completes. Only closed groups may be
   filtered: an open group's retractions may still lie ahead."
  [datoms]
  (if (empty? datoms)
    {:closed [] :open []}
    (loop [ds datoms cur-e (datom.index/-e (first datoms)) cur [] closed []]
      (if (empty? ds)
        {:closed closed :open cur}
        (let [d (first ds) e (datom.index/-e d)]
          (if (= e cur-e)
            (recur (rest ds) cur-e (conj cur d) closed)
            (recur (rest ds) e [d] (conj closed cur))))))))

(defn attribute-page
  "The next bounded page of attribute `attr`'s entity groups, after `after-eid`.

  Returns `{:datoms [...] :after-eid eid :more? bool}`:

    :datoms     the VISIBLE datoms of up to `limit` entity groups, in AEVT
                order. Visibility is this db value's own filter, so a
                snapshot, `as-of`, `since` or `history` value all behave.
    :after-eid  the last entity group consumed — pass it back as the cursor.
                A fully retracted group still advances it, so the walk never
                stalls on a page with no visible datoms.
    :more?      true when another entity group follows. Stop on `false`; never
                on a row count, since a page can legitimately hold zero
                visible datoms and still have advanced.

  `after-eid` nil starts at the beginning of the attribute. `attr` must be in
  the schema and `limit` a positive integer. A durable store reads this in
  bounded native pages — never the whole column."
  [db attr after-eid limit]
  (when-not (datom.schema/known? (schema-of db) attr)
    (throw (ex-info "attribute-page: unknown attribute" {:attr attr})))
  (when-not (and (erlang/is_integer limit) (> limit 0))
    (throw (ex-info "attribute-page: limit must be a positive integer"
                    {:limit limit})))
  ; A cursor is an ENTITY id (an integer); anything else would build a bogus
  ; lower bound and silently page the wrong slice, so it fails loud here.
  (when-not (or (nil? after-eid) (erlang/is_integer after-eid))
    (throw (ex-info "attribute-page: after-eid must be nil or an entity id"
                    {:after-eid after-eid})))
  (let [base (datom.index/key-prefix :aevt attr)
        ; Resume AFTER the cursor entity: `prefix-end` of that entity's prefix
        ; sorts above every datom about it and below the next entity.
        lo (if (nil? after-eid)
             base
             (datom.index/prefix-end (datom.index/key-prefix :aevt attr after-eid)))
        hi (datom.index/prefix-end base)
        chunk (page-chunk limit)
        emit (fn [groups more?]
               (if (empty? groups)
                 {:datoms [] :after-eid after-eid :more? more?}
                 (let [datoms (reduce (fn [acc g] (into acc g)) [] groups)
                       last-eid (datom.index/-e (peek (peek groups)))]
                   {:datoms (filter-datoms db datoms)
                    :after-eid last-eid
                    :more? more?})))]
    (loop [start lo after nil open [] closed []]
      (let [res (datom.store/page-datoms (store-of db) start after hi chunk)
            ds (:datoms res)
            end? (or (:end? res) (empty? ds))
            split (split-entity-groups (into open ds))
            closed2 (into closed (get split :closed))
            open2 (get split :open)]
        (if end?
          ; The range is exhausted: the trailing group is complete too.
          (let [all (if (empty? open2) closed2 (conj closed2 open2))]
            (emit (vec (take limit all)) (> (count all) limit)))
          (if (>= (count closed2) limit)
            ; `open2` is non-empty whenever the page was not empty, so those
            ; `limit` closed groups are followed by at least one more entity.
            (emit (vec (take limit closed2)) true)
            (recur nil (:last res) open2 closed2)))))))

(defn entity
  "Entity `e` as a map of attribute to value.

   A cardinality-many attribute collects into a VECTOR; a cardinality-one
   attribute holds its single value. `:db/id` is included so the result
   round-trips as transaction data.

   REFUSES on a history view. A history db holds every value an attribute
   ever had, so folding it into a map would report an entity with three
   simultaneous ages — a value that never existed at any point in time.
   That is a category error rather than a rare edge, so it fails loudly:
   ask `datom.time/changes` for the history of a field."
  [db e]
  (if (= (:filter-mode db) :history)
    (throw (ex-info "entity is not meaningful on a history view (use datom.time/changes)"
                    {:entity e}))
  (let [eid (resolve-eid db e)
        ds (if (nil? eid) [] (datoms db :eavt eid))]
    (if (empty? ds)
      nil
      (reduce (fn [acc d]
                (let [a (datom.index/-a d)
                      v (datom.index/-v d)]
                  (if (datom.schema/many? (schema-of db) a)
                    (assoc acc a (conj (or (get acc a) []) v))
                    (assoc acc a v))))
              {:db/id eid}
              ds)))))

(defn attr-value
  "The value of `[e a]`, or nil.

   For a cardinality-many attribute this is the FIRST value, which is
   rarely what a caller wants — use `entity` or `datoms` there."
  [db e a]
  (let [ds (datoms db :eavt e a)]
    (if (empty? ds) nil (datom.index/-v (first ds)))))
