; facts.bl — the process's CLAUSE TOPOLOGY as datom facts (code-as-data).
;
; model.bl extracts a process into clauses {:label :pattern :guard :next …}. The
; SMT layer asks z3 the ARITHMETIC questions about them. But a second class of
; question is purely STRUCTURAL — about the dispatch, the guards, the patterns —
; and structure is datalog's job, not the solver's (the strict engine split:
; datom = codebase-as-data). This module projects the clauses into facts so the
; implicit invariants latent in the topology become QUERIES:
;
;   · dispatch coverage — which message labels are handled? which are guarded?
;   · guard preconditions — the {label → guard} map, extracted not annotated.
;   · always-fireable labels — a label with an UNGUARDED clause (total handler).
;   · guarded-only labels — every clause for the label has a :when (partial).
;
; The projection is dependency-injected (mk-conn / q-fn) exactly like the
; coverage helpers in system.core, so this module need not require datom.
;
; SCHEMA (one entity per clause):
;   :clause/label   keyword   the message label it handles
;   :clause/guarded bool      does it have a :when guard?
;   :clause/guard   string    the guard source (nil-guard clauses omit it)
;   :clause/order   long      position among the process's clauses (shadowing)

(ns system.facts
  (:require [system.model :as model]))

(def SCHEMA
  [{:db/ident :clause/label   :db/valueType :db.type/keyword}
   {:db/ident :clause/guarded :db/valueType :db.type/boolean}
   {:db/ident :clause/guard   :db/valueType :db.type/string}
   {:db/ident :clause/order   :db/valueType :db.type/long}])

(defn clause-facts
  "The clause set of `node` as a vector of fact maps (one per message clause,
   :init excluded — it is establishment, not dispatch). `:db/id` is the 1-based
   order so shadowing (an earlier clause subsuming a later one) is expressible."
  [node]
  (let [clauses (filter (fn [c] (not (= :init (:label c)))) (:transitions (model/system-model node)))]
    (into [] (map-indexed
               (fn [i c]
                 (let [g (:guard c)]
                   (merge {:db/id (- (+ i 1))
                           :clause/label (:label c)
                           :clause/guarded (some? g)
                           :clause/order (+ i 1)}
                          (if g {:clause/guard g} {}))))
               clauses))))

(defn facts-db
  "Build a queryable db of `node`'s clause facts. `mk-conn` is (schema)→conn and
   `transact` is (conn facts)→_, injected so this module need not require datom."
  [node mk-conn transact]
  (let [conn (mk-conn SCHEMA)]
    (transact conn (clause-facts node))
    conn))

; ── the implicit-invariant queries (datalog over the clause facts) ──────────

(defn handled-labels
  "Every message label the process handles. `q-fn` is (db query & args)→rows."
  [db q-fn]
  (into #{} (map first (q-fn db '[:find ?l :where [?c :clause/label ?l]]))))

(defn always-fireable-labels
  "Labels with at least one UNGUARDED clause — a total handler that fires in any
   state. The complement (guarded-only) is a partial handler: a message that can
   be dropped when no guard matches. This is a datalog anti-join, not z3."
  [db q-fn]
  (into #{} (map first (q-fn db '[:find ?l :where [?c :clause/label ?l]
                                                  [?c :clause/guarded false]]))))

(defn guarded-only-labels
  "Labels EVERY clause of which is guarded — the message is refused unless a
   :when matches, so a sender can be silently ignored. handled − always-fireable."
  [db q-fn]
  (let [handled (handled-labels db q-fn)
        total (always-fireable-labels db q-fn)]
    (into #{} (filter (fn [l] (not (contains? total l))) (into [] handled)))))

(defn guard-preconditions
  "{label → [guard-source …]} — the implicit precondition of each handled label,
   read straight from the :when clauses. The spec nobody wrote down."
  [db q-fn]
  (let [rows (q-fn db '[:find ?l ?g :where [?c :clause/label ?l] [?c :clause/guard ?g]])]
    (reduce (fn [m row]
              (let [l (first row) g (second row)]
                (assoc m l (conj (or (get m l) []) g))))
            {} rows)))

(defn dispatch-report
  "The whole structural picture in one map: handled labels, which are total
   (always fireable) vs guarded-only (partial), and the guard preconditions."
  [db q-fn]
  {:handled          (handled-labels db q-fn)
   :always-fireable  (always-fireable-labels db q-fn)
   :guarded-only     (guarded-only-labels db q-fn)
   :preconditions    (guard-preconditions db q-fn)})
