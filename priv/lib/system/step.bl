; system/step.bl — :~step as a computed relation (P17).
;
; The transition CLAUSES are STORED facts; :~step is a COMPUTED relation that
; expands a state through them; :~reachable is a DERIVED fixpoint over :~step on
; the SHIPPED datom.query.fixpoint engine — which cannot tell a computed edge
; from a stored one (the seven-axis relation thesis, datom/query/relation.bl).
;
; This makes the state graph a queryable VIEW: "is the bad state reachable?" and
; "what path leads there?" become datalog over :~step, not bespoke search. The
; provider is a PURE fn of the model + a concrete state instance, so the graph
; cannot drift from the code.
;
; A step here is concrete (integer states over a bounded instance), the same
; model P16a's BFS used — graduated to the relation interface so it composes
; with the fixpoint engine and introspects via catalog-datoms.

(ns system.step
  (:require [datom.query.relation :as rel]))

; ── the step function: a concrete state → its successors ────────────────
;
; `stepper` is (fn [label state] → next-state); `labels` the transition labels;
; `enabled?` (fn [label state] → bool) the guard. These come from the extracted
; model (the caller wires them). The provider enumerates successors of a bound
; state, or all edges when unbound.

(defn make-step-provider
  "Build a :~step provider from a concrete stepper. Emits [from to] tuples.
   In :bf mode (from bound) → successors of `from`; the state universe is the
   passed `states` list (a bounded instance)."
  [labels stepper enabled? states]
  (fn [db mode bounds args]
    ; bounds = {:e from-state :v to-state}. In :bf mode (from bound) restrict to
    ; that from-state; free ⇒ the whole state universe. For each from-state,
    ; emit [from (step label from)] for every enabled label.
    (let [froms (if (some? (get bounds :e)) [(get bounds :e)] states)]
      (mapcat
        (fn [from]
          (map (fn [label] [from (stepper label from)])
               (filter (fn [label] (enabled? label from)) labels)))
        froms))))

(defn register-step!
  "Register :~step for a machine. Idempotent per process (re-registration
   replaces). Returns :~step."
  [labels stepper enabled? states]
  (rel/register-relation! :~step
    {:arity 2
     :modes #{:bf :bb}
     :doc "the transition step relation of a process (computed)"
     :tags #{:system}
     :provider (make-step-provider labels stepper enabled? states)}))

; ── reachability as a fixpoint over :~step ──────────────────────────────
;
; With :~step registered, reachability is the standard transitive-closure rule;
; a caller runs it through datom/q. We expose the rule + a direct helper that
; computes reachable states by iterating the provider to a fixpoint (so the
; spike is self-contained without wiring the full query engine).

(defn reachable-states
  "The set of states reachable from `start` under the step provider — the least
   fixpoint. Pure, terminating (the state set is finite and only grows)."
  [labels stepper enabled? start]
  (loop [frontier #{start} seen #{start}]
    (if (empty? frontier)
      seen
      (let [nexts (set (mapcat
                         (fn [s] (map (fn [l] (stepper l s))
                                      (filter (fn [l] (enabled? l s)) labels)))
                         (into [] frontier)))
            fresh (set (filter (fn [s] (not (contains? seen s))) (into [] nexts)))]
        (recur fresh (reduce (fn [acc s] (conj acc s)) seen (into [] fresh)))))))

(defn reaches?
  "Is `target` reachable from `start`?"
  [labels stepper enabled? start target]
  (contains? (reachable-states labels stepper enabled? start) target))

(defn path-to
  "A path [start … target] to the first state satisfying `bad?`, or nil. The
   counterexample trace — backward-search made concrete (P16a's :fb mode)."
  [labels stepper enabled? start bad?]
  (loop [frontier [[start]] seen #{start}]
    (if (empty? frontier)
      nil
      (let [path (first frontier)
            s (last path)]
        (if (bad? s)
          path
          (let [nexts (keep
                        (fn [l]
                          (let [ns (stepper l s)]
                            (if (or (contains? seen ns) (not (enabled? l s)))
                              nil
                              (conj path ns))))
                        labels)]
            (recur (concat (rest frontier) nexts)
                   (reduce (fn [acc p] (conj acc (last p))) seen nexts))))))))
