; prove.bl — proofs as compiler output: annotate bl-ANF with what the engines
; prove, so downstream passes CONSUME a fact instead of RE-DERIVING it.
;
; ── The vertical this closes ────────────────────────────────────────────
;
; docs/from-source-to-silicon/06 promises: "engines read the same IR the
; backend reads and write their findings back onto it, into the :ann slots."
; This module is that write-back for the two effect/measure engines that read
; bl-ANF (footprint, termination). It takes a node — typically a clause body —
; and returns it with :ann enriched:
;
;     :footprint {resource → mode}   ; system.footprint
;     :pure      bool                 ; footprint = ∅ (doc-05 theorem 1)
;     :terminates bool                ; a recognised, well-founded loop, or no loop
;
; The proof TRAVELS with the node: a later pass (native-eligibility, memory
; policy, deployment sizing) reads (get-in node [:ann :pure]) rather than
; walking the tree again. A missing key means "not proven" — never a wrong
; "proven", per the engines' sound-only contract.
;
; ── Tier ─────────────────────────────────────────────────────────────────
;
; This is a lib-tier pass (priv/lib/system): it requires the engines, which
; requires the compiler — the dependency points UPWARD from boot. The Core
; backend (priv/boot/lower.bl) never requires this; it only carries the extra
; :ann keys through emission untouched (verified: they survive descriptor
; validation and load). Proof-directed emission is therefore a lib-tier
; decision that annotates BEFORE the descriptor reaches the boot backend.

(ns system.prove
  (:require [system.ir :as ir]
            [system.footprint :as fp]
            [system.summary :as summary]))

; ── the per-node proof ─────────────────────────────────────────────────

; One walk, all facts. system.summary computes footprint and termination from a
; SINGLE traversal; prove-node projects the proof keys onto :ann. No second
; walk, no duplicate termination logic — the summary layer owns both. The old
; standalone footprint-of / terminates? projections are gone: a caller wanting
; one fact reads it off the summary (or off the annotated node's :ann).

(defn prove-node
  "Return `node` with :footprint, :pure and :terminates written into its :ann,
   from ONE summary walk. `annotate-clause` maps it over a descriptor."
  [node]
  (let [s (summary/summarize {} node)
        f (:footprint s)]
    (-> node
        (ir/ann-put :footprint f)
        (ir/ann-put :pure (fp/pure? f))
        (ir/ann-put :terminates (:terminates s)))))

; ── descriptor-level pass ──────────────────────────────────────────────

(defn annotate-clause
  "A :defn-clause with its :body's proof written onto the body node's :ann."
  [clause]
  (assoc clause :body (prove-node (:body clause))))

(defn annotate-descriptor
  "Return module descriptor `d` with every clause body proof-annotated. Eager
   (apply list …) so the result still satisfies the anf/module boundary."
  [d]
  (assoc d :clauses (apply list (map annotate-clause (:clauses d)))))

; ── the consumer: native eligibility, read from :ann ────────────────────
;
; doc-05's native-offload gate is: pure ∧ terminating. Instead of re-walking
; the tree (as research/lowerers_spike/lower2 does with check-pure!/
; check-terminates!), read the proofs the pass already wrote. This is the
; point of the vertical: one proof, many consumers, zero re-derivation.

(defn native-eligible?
  "Whether a proof-annotated node earned native compilation: proven pure AND
   proven terminating. Reads :ann only — never re-derives. An un-annotated node
   is not eligible (nil → false), the sound default."
  [node]
  (and (= true (ir/ann-get node :pure))
       (= true (ir/ann-get node :terminates))))

(defn eligibility-report
  "A human-readable verdict for a proof-annotated node: {:pure :terminates
   :eligible :footprint}. The 'why' a fragment did or did not earn native code."
  [node]
  {:pure       (ir/ann-get node :pure)
   :terminates (ir/ann-get node :terminates)
   :footprint  (ir/ann-get node :footprint)
   :eligible   (native-eligible? node)})
