; Suspension is independent of purity: a DOM write can be synchronous, while
; an otherwise pure receive must return control to the actor scheduler.
(ns system.suspension (:require [system.ir :as ir]))
(declare synchronous? function-synchronous?)
(defn- callable-synchronous? [callee resolve locals]
  (cond
    (= :var (:op callee))
      (if-let [value (get locals (:name callee))]
        (callable-synchronous? value resolve (dissoc locals (:name callee))) false)
    (or (= :fn (:op callee)) (ir/self-scaffold? callee) (ir/blfn-value? callee))
      (function-synchronous? callee resolve locals)
    ; Calling a literal keyword or collection is a lookup, not a call of its value.
    (and (= :lit (:op callee)) (keyword? (:val callee))) true
    (contains? #{:map :struct} (:op callee)) true
    (= :global (:op callee)) (= true (resolve {:mode :global :callee callee}))
    :else false))
(defn synchronous?
  "Does executing this checked ANF node avoid actor suspension? Unknown calls
   fail closed. resolve classifies already-resolved globals/host leaves; author
   annotations never supply evidence. Creating a closure does not execute it."
  ([node resolve] (synchronous? node resolve {}))
  ([node resolve locals]
   (cond
     (not (ir/node? node)) true
     (contains? #{:recv :receive} (:op node)) false
     (= :fn (:op node)) true
     (ir/self-scaffold? node) true
     (= :let (:op node))
       (and (synchronous? (:init node) resolve locals)
            (synchronous? (:body node) resolve (assoc locals (:name node) (:init node))))
     (ir/anf-loop? node)
       (let [parts (ir/loop-parts node)]
         (and (every? (fn [n] (synchronous? n resolve locals)) (:inits parts))
              (synchronous? (:body parts) resolve locals)))
     :else
       (let [site (ir/call-site node)]
         (and (or (nil? site)
                  (if (= :remote (:mode site)) (= true (resolve site))
                    (callable-synchronous? (:callee site) resolve locals)))
              (every? (fn [child] (synchronous? child resolve locals)) (ir/child-nodes node)))))))
(defn function-synchronous?
  "Prove every arity of a callable value non-suspending. Closure creation alone
   is insufficient: this inspects the bodies that a host callback would run."
  ([node resolve] (function-synchronous? node resolve {}))
  ([node resolve locals]
   (cond
     (ir/self-scaffold? node) (function-synchronous? (ir/scaffold-inner node) resolve locals)
     (= :fn (:op node))
       (every? (fn [cl]
                 (let [scope (reduce dissoc locals (ir/clause-pattern-vars cl))]
                   (and (synchronous? (:guard cl) resolve scope)
                        (synchronous? (:body cl) resolve scope)))) (:clauses node))
     (ir/blfn-value? node)
       (let [[_ fixed variadic] (:elems node)]
         (and (every? (fn [pair] (function-synchronous? (second pair) resolve locals)) (:pairs fixed))
              (or (not= :tuple (:op variadic))
                  (function-synchronous? (second (:elems variadic)) resolve locals))))
     :else false)))
(defn analyze
  "Greatest fixed point of non-suspension over checked callable definitions.
   resolve-for receives the current name->proof map. A recursive cycle remains
   synchronous only if every executable edge is proven; non-convergence refuses."
  [definitions resolve-for]
  (loop [models (into {} (map (fn [[name _]] [name true]) definitions)) round 0]
    (let [resolve (resolve-for models)
          next (into {} (map (fn [[name node]] [name (function-synchronous? node resolve)]) definitions))]
      (cond
        (= models next) {:proofs next :rounds (inc round) :converged true}
        (>= round 128) {:proofs (into {} (map (fn [[name _]] [name false]) definitions)) :rounds (inc round) :converged false}
        :else (recur next (inc round))))))
