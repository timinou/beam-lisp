; Conservative native-JS evidence over canonical ANF. Unknown stays silent.
; Shared by build, live compilation and typed/check-js-ir; no boot cycle.
(ns system.js (:require [system.ir :as ir]))

(defn value-tags [node env]
  (let [op (:op node)]
    (cond
      (= op :var) (get env (:name node) #{:unknown})
      (= op :map) #{:bl-map}
      (= op :struct) (if (= :Elixir.BeamLisp.Vector (:mod node)) #{:bl-vector} #{:unknown})
      (contains? #{:cons :enil} op) #{:bl-list}
      (and (= op :remote) (= :Elixir.BeamLisp.Set (:mod node)) (= :new (:fun node))) #{:bl-set}
      (= op :fn) #{:fn}
      (= op :lit) (let [v (:val node)]
                    (cond (= (type v) :Elixir.BeamLisp.Decimal) #{:decimal}
                          (map? v) #{:bl-map} (vector? v) #{:bl-vector}
                          (set? v) #{:bl-set} (list? v) #{:bl-list}
                          (nil? v) #{:nil} (keyword? v) #{:kw}
                          (number? v) #{:number} (string? v) #{:string}
                          (boolean? v) #{:bool} :else #{:unknown}))
      (= op :js) (cond (contains? #{:array :object :new :to-js} (:kind node)) #{:js-object}
                      (= :undefined? (:kind node)) #{:bool}
                      (= :helper (:kind node)) #{:fn} :else #{:unknown})
      (= op :let) (value-tags (:body node) (assoc env (:name node) (value-tags (:init node) env)))
      (= op :do) (value-tags (last (:stmts node)) env)
      (= op :if) (set (concat (value-tags (:then node) env) (value-tags (:else node) env)))
      :else #{:unknown})))

(def bl-collections #{:bl-map :bl-vector :bl-list :bl-set})
(defn- definitely? [allowed got]
  (and (not (empty? got)) (every? (fn [t] (contains? allowed t)) got)))

(defn- diagnostic [node message]
  (merge (:ann node) {:kind :js-interop :message message}))

(defn- visit [node env opts]
  (let [native-call? (and (:native-call? opts) ((:native-call? opts) node))
        kind (:kind node) args (:args node)
        receiver (when (and (= :js (:op node)) (contains? #{:method :get :index :set} kind)) (first args))
        bad-receiver (when (and receiver (definitely? (set (concat bl-collections [:nil :kw])) (value-tags receiver env)))
                       [(diagnostic receiver "JavaScript receiver is a known BL value; use #js or bl->js for collections")])
        native-values (if native-call? (ir/cons-args (second (:args node)))
                        (when (= :js (:op node))
                        (cond (contains? #{:array :object :call :new} kind) args
                              (= :method kind) (rest args)
                              (= :set kind) (list (last args))
                              :else (list))))
        bad-values (mapcat (fn [arg]
                             (let [tags (value-tags arg env)]
                               (cond (definitely? bl-collections tags)
                                       [(diagnostic arg "BL collection crosses a native JS boundary; missing #js or bl->js")]
                                     (= tags #{:decimal})
                                       [(diagnostic arg "Exact decimal cannot cross a native JS boundary without an explicit numeric policy")]
                                     :else []))) native-values)
        nested (if (= :let (:op node))
                 (concat (visit (:init node) env opts)
                         (visit (:body node) (assoc env (:name node) (value-tags (:init node) env)) opts))
                 (mapcat (fn [child] (visit child env opts)) (ir/child-nodes node)))]
    (concat bad-receiver bad-values nested)))

(defn check
  ([node] (check node {}))
  ([node opts] (vec (visit node {} opts))))

(defn check!
  ([node] (check! node {}))
  ([node opts]
  (let [problems (check node opts)]
    (when-not (empty? problems)
      (let [p (first problems)]
        (throw (ex-info (str (or (:file p) "JavaScript") ":" (or (:line p) "?") ": " (:message p)) p))))
    node)))
