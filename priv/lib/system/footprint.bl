; footprint.bl — an effect is a FOOTPRINT (P16b), computed over bl-ANF.
;
; ── The redefinition ──────────────────────────────────────────────────
;
; effects.bl models an effect as a RUNG on a ladder (pure < atom < process < io)
; — the JOIN, a lossy summary. This module promotes an effect to what it
; actually is: a set of RESOURCES, each touched in a MODE.
;
;     footprint ≜ {resource → mode}
;     mode ∈ {:R read · :A append/monotone · :W write · :S send · :K recv · :X spawn}
;
; The rung lattice is RECOVERED: rung = rank(join of modes). Nothing regresses;
; `rung` below reproduces effects.bl's ladder from a footprint, so the two
; models agree. The algebra the footprint carries IS the guarantees:
;
;     purity        ≜ footprint touches only :R (or is empty)
;     monotonicity  ≜ footprint touches only :R/:A
;     commutativity ≜ no shared resource carries a CONFLICTING mode pair
;     frame rule    ≜ disjoint resources ⟹ e1 preserves any invariant over e2's
;                     region (Separation Logic, decided STRUCTURALLY)
;
; ── Why over bl-ANF ────────────────────────────────────────────────────
;
; The footprint is computed over the IR the compiler emits, not the surface
; s-expression. The compiler has already expanded every macro and resolved
; every call, so `(-> a (swap! inc))`, `(when p (swap! a x))`, `(doto a …)`
; all reduce to the same resource ops a bare `swap!` does — the engine sees
; the MEANING, not the spelling, and never collapses a macro to :opaque-world.
; A resource op is a :remote to a known [module function]; its resource is the
; first argument, resolved through the alias env (system.ir) that tracks which
; local stands for which global. `fp-walk` remains for callers holding a
; surface node: it compiles to ANF, then walks.

(ns system.footprint
  (:require [system.ir :as ir] [compiler :as c]))

; ── the mode lattice ────────────────────────────────────────────────────
(def mode-rank {:R 0 :A 1 :W 2 :S 3 :K 3 :X 3})

(def opaque-world ir/opaque-world)

; Two modes on the SAME resource CONFLICT unless both are reads, or both are
; appends (appends commute — the monotone-merge property).
(defn conflict? [m1 m2]
  (not (or (and (= m1 :R) (= m2 :R))
           (and (= m1 :A) (= m2 :A)))))

; ── op classification, keyed by [module function] ────────────────────────
;
; ANF resolved the callee, so classification is by the exact [mod fun] the
; compiler chose — never a shadowable string name. The modules the runtime
; routes stateful ops through:
(def refs  :Elixir.BeamLisp.Refs)         ; atoms: swap!/reset!/deref/atom
(def rt    :Elixir.BeamLisp.Ns.Rt)           ; invoke / println / collection ops
(def datom :Elixir.BeamLisp.Ns.Datom)     ; datom conn ops (RESOLVED module atom)

; A datom call resolves to the interned module atom when `datom` is loaded, and
; to the bare namespace atom `:datom` when it is not (e.g. a pre-datom compile).
; Key BOTH so classification is load-order-independent — the surface engine got
; this for free by keying the string name; ANF names the resolved module, so we
; enumerate both forms.
(def op-mode
  {[refs :swap!] :W  [refs :reset!] :W  [refs :deref] :R  [refs :atom] :R
   [datom :transact!] :A [datom :listen!] :R [datom :db] :R [datom :q] :R
   [:datom :transact!] :A [:datom :listen!] :R [:datom :db] :R [:datom :q] :R
   [:erlang :send] :S [:erlang :spawn] :X
   [rt :println] :W [:Elixir.File :read] :R [:Elixir.File :write] :W})

; io ops act on the ambient :io resource, not on an argument.
(def io-ops #{[rt :println] [:Elixir.File :read] [:Elixir.File :write]})

; A var invoked dynamically (RT.invoke of a :global) is opaque UNLESS it is a
; known io-by-name primitive.
(def global-io #{"println"})

; Purity belongs to an exact operation, including arity, not a module.
; Higher-order calls, process state, lazy forcing and native counters require
; effect evidence; sharing a module with arithmetic is not that evidence.
(def value-ops
  #{[:erlang :+ 1] [:erlang :+ 2] [:erlang :- 1] [:erlang :- 2]
    [:erlang :* 2] [:erlang :/ 2] [:erlang :div 2] [:erlang :rem 2]
    [:erlang :abs 1] [:erlang :round 1] [:erlang :trunc 1]
    [:erlang :min 2] [:erlang :max 2]
    [:erlang :== 2] [:erlang :/= 2] [:erlang :=:= 2] [:erlang :=/= 2]
    [:erlang :< 2] [:erlang :> 2] [:erlang :=< 2] [:erlang :>= 2]
    [:erlang :not 1] [:erlang :and 2] [:erlang :or 2] [:erlang :xor 2]
    [:erlang :band 2] [:erlang :bor 2] [:erlang :bxor 2]
    [:erlang :bnot 1] [:erlang :bsl 2] [:erlang :bsr 2]
    [:erlang :is_atom 1] [:erlang :is_boolean 1] [:erlang :is_binary 1]
    [:erlang :is_bitstring 1] [:erlang :is_float 1] [:erlang :is_integer 1]
    [:erlang :is_number 1] [:erlang :is_list 1] [:erlang :is_map 1]
    [:erlang :is_tuple 1] [:erlang :is_function 1] [:erlang :is_function 2]
    [:erlang :is_pid 1] [:erlang :is_port 1] [:erlang :is_reference 1]
    [:erlang :length 1] [:erlang :hd 1] [:erlang :tl 1]
    [:erlang :tuple_size 1] [:erlang :element 2] [:erlang :setelement 3]
    [:erlang :tuple_to_list 1] [:erlang :list_to_tuple 1]
    [:erlang :byte_size 1] [:erlang :bit_size 1] [:erlang :map_size 1]
    [:erlang :map_get 2] [:erlang :is_map_key 2]
    [:erlang :list_to_binary 1] [:erlang :iolist_to_binary 1]
    [:erlang :binary_to_list 1] [:erlang :binary_to_list 3]
    [:erlang :integer_to_binary 1] [:erlang :integer_to_binary 2]
    [:erlang :atom_to_binary 1] [:erlang :atom_to_binary 2]
    [:erlang :phash2 1] [:erlang :phash2 2]
    [:erlang :++ 2] [:erlang :-- 2]
    [:binary :part 2] [:binary :part 3] [:binary :at 2]
    [:binary :copy 1] [:binary :copy 2]
    [:lists :reverse 1] [:lists :reverse 2] [:lists :append 1] [:lists :append 2]
    [:lists :member 2] [:lists :nth 2] [:lists :nthtail 2]
    [:lists :seq 2] [:lists :seq 3] [:lists :sort 1] [:lists :usort 1]
    [:maps :get 2] [:maps :get 3] [:maps :put 3] [:maps :update 3]
    [:maps :remove 2] [:maps :is_key 2] [:maps :keys 1] [:maps :values 1]
    [:maps :to_list 1] [:maps :from_list 1] [:maps :size 1]})

; ── applying a value: calling a fn value, forcing a lazy seq ──────────────
;
; Some host ops do no effect of their OWN but may run code the caller handed
; them: a higher-order op calls its fn argument, and a consuming op FORCES a
; lazy seq argument, which runs the producer's deferred thunk. Forcing IS
; applying a function value (the thunk). Measured on the runtime 2026-10-02:
; count/first/rest/next/seq/nth/second/last/empty?/=/compare/into/vec/set/
; keys/vals/str/pr-str/name/keyword/symbol/reverse/take/drop and every
; higher-order op force a lazy argument, as do assoc-in/get-in (key path),
; subs and ex-message. get/assoc/conj/cons/dissoc/nil?/some?/type and the
; type predicates do not force an argument in ANY position.
; test/bl/system/footprint_forcing_test.bl re-measures every classified op.
;
; What applying costs is NOT knowable from the op: it is the effect of the
; value applied. So the op asks its resolver for `apply-value`:
;   * no program context (the default resolver) → :unknown → opaque. A value
;     from nowhere may print when forced; this is the single-node answer.
;   * a CLOSED-WORLD resolver (system.analyze) → {} — every fn value and every
;     lazy thunk was created in the program, and its effect is charged to its
;     CREATOR's :latent. A consumer that must know "running this does nothing"
;     reads footprint ⊔ latent (system.analyze/effects), never footprint alone.
(def apply-value :system.footprint/apply-value)

(defn- apply-fp
  "The footprint of applying a value under `resolve`: opaque unless the
   resolver vouches for the closed world."
  [resolve]
  (let [r (resolve apply-value)]
    (if (= r :unknown) {opaque-world :W} r)))

; Runtime value ops: no effect of their own, and they neither call nor force
; an argument. Creating a lazy seq or a fn value is here (creation defers).
(def core-mod :Elixir.BeamLisp.Ns.Core)
(def rt-value-ops
  #{[rt :assoc 3] [rt :conj 2] [rt :cons 2] [rt :get 2] [rt :get 3]
    [rt :range 1] [rt :range 2] [rt :repeat 2]
    [rt :coll? 1] [rt :float? 1] [rt :fn? 1] [rt :int? 1] [rt :keyword? 1]
    [rt :map? 1] [rt :number? 1] [rt :seq? 1] [rt :sequential? 1] [rt :set? 1]
    [rt :string? 1] [rt :vector? 1] [rt :even? 1] [rt :odd? 1] [rt :neg? 1]
    [rt :pos? 1] [rt :zero? 1]
    [core-mod :abs 1] [core-mod :boolean? 1]
    [core-mod :dec 1] [core-mod :inc 1] [core-mod :dissoc 2]
    [core-mod :identity 1] [core-mod :max 2] [core-mod :min 2] [core-mod :mod 2]
    [core-mod :quot 2] [core-mod :nil? 1] [core-mod :some? 1] [core-mod :type 1]
    [core-mod :ex-data 1] [core-mod :ex-info 2]
    [core-mod :trim 1] [core-mod :index-of 2]
    [core-mod :upper-case 1] [core-mod :lower-case 1] [core-mod :list__bl_v 1]
    ; combinators BUILD a closure; building calls and forces nothing (the
    ; closure's own effect is charged when it is applied). Every arity.
    [core-mod :comp 0] [core-mod :comp 1] [core-mod :comp 2] [core-mod :comp 3]
    [core-mod :comp__bl_v 4] [core-mod :juxt 1] [core-mod :juxt 2] [core-mod :juxt 3]
    [core-mod :juxt__bl_v 4] [core-mod :partial 1] [core-mod :partial 2]
    [core-mod :partial 3] [core-mod :partial 4] [core-mod :partial__bl_v 5]
    [core-mod :complement 1] [core-mod :constantly 1]
    [:Elixir.BeamLisp.Ns.Sugar :fnil 2] [:Elixir.BeamLisp.Num :neg 1]
    [:Elixir.BeamLisp.Transient :hash_map 3] [:Elixir.BeamLisp.LazySeq :from_fun 1]
    ; a literal map KEY is normalized through hash_key; it strips metadata
    ; and never forces (measured, footprint_forcing_test)
    [rt :hash_key 1]
    ; a set literal `#{…}` lowers to Set/new over its element list
    [:Elixir.BeamLisp.Set :new 1]})

; Struct literals whose constructor is pure field assembly (see :struct below).
(def pure-struct-mods #{:Elixir.BeamLisp.Vector})

; Runtime ops that APPLY a value: they force a lazy argument and/or call a fn
; argument. Their cost is `apply-fp` (see above).
(def applying-ops
  #{[rt :count 1] [rt :first 1] [rt :rest 1] [rt :next 1] [rt :seq 1]
    [rt :nth 2] [rt :nth 3] [rt :empty? 1] [rt :eqv 2] [rt :compare 2]
    [rt :contains? 2] [rt :set 1] [rt :sort 1] [rt :doall 1]
    [rt :dorun 1] [rt :take 2] [rt :drop_clj 2] [rt :take_while 2]
    [rt :drop_while 2] [rt :map 2] [rt :iterate 2] [rt :apply_to 2]
    [rt :print_readably 1]
    [core-mod :second 1] [core-mod :last 1] [core-mod :butlast 1]
    [core-mod :not= 2] [core-mod :keys 1] [core-mod :vals 1] [core-mod :into 2]
    [core-mod :vec 1] [core-mod :reverse 1] [core-mod :name 1] [core-mod :keyword 1]
    [core-mod :symbol 1] [core-mod :distinct 1] [core-mod :frequencies 1]
    [core-mod :interpose 2] [core-mod :partition 2] [core-mod :zipmap 2]
    [core-mod :select-keys 2] [core-mod :merge__bl_v 1] [core-mod :peek 1]
    [core-mod :pop 1] [core-mod :not-empty 1]
    [core-mod :mapv 2] [core-mod :filterv 2] [core-mod :remove 2] [core-mod :keep 2]
    [core-mod :reduce 2] [core-mod :reduce 3] [core-mod :reduce-kv 3]
    [core-mod :some 2] [core-mod :every? 2] [core-mod :not-any? 2]
    [core-mod :group-by 2] [core-mod :sort-by 2] [core-mod :sort-by 3] [core-mod :map-indexed 2]
    [core-mod :mapcat__bl_v 2] [core-mod :partition-by 2] [core-mod :split-with 2]
    [core-mod :update 3] [core-mod :update-vals 2] [core-mod :update-keys 2]
    [core-mod :max-key 3] [core-mod :min-key 3] [core-mod :repeatedly 1]
    ; these force ONE argument position (measured): the key path of
    ; assoc-in/get-in, the string of subs, the exception of ex-message
    [core-mod :assoc-in 3] [core-mod :get-in 2] [core-mod :subs 2]
    [core-mod :subs 3] [core-mod :ex-message 1]})

; Retain the public module index as descriptive data, not as a proof rule.
(def value-mods (set (map first value-ops)))

; ── footprint over bl-ANF ─────────────────────────────────────────────────

(defn join-fp [a b]
  (reduce (fn [m [r mode]]
            (let [prev (get m r)]
              (if (or (nil? prev) (> (get mode-rank mode) (get mode-rank prev)))
                (assoc m r mode)
                m)))
          a b))

(declare fp-anf)

(defn- fp-all [aliases resolve nodes]
  (reduce (fn [m n] (join-fp m (fp-anf aliases resolve n))) {} nodes))

(defn- fp-clauses
  "Footprint of clause guards+bodies, each under the clause's shadowed env."
  [aliases resolve clauses]
  (reduce (fn [m cl]
            (let [al (ir/clause-env aliases cl)]
              (join-fp m (fp-all al resolve (if (nil? (:guard cl)) (list (:body cl))
                                             (list (:guard cl) (:body cl)))))))
          {} clauses))

; A CALLEE RESOLVER lets an inter-procedural caller (system.analyze) replace
; the opaque footprint of a user-function call with that callee's KNOWN
; footprint. Default resolver knows nothing (every user call is opaque) —
; the honest single-function answer. analyze passes a resolver backed by the
; summary table, closing the footprint over the call graph.
(def no-resolver (fn [_name] :unknown))

(def pure-value-globals
  "Core names that are FIRST-ORDER value functions: their result depends only on
   their arguments and they call no argument. The higher-order core names
   (`map`, `filter`, `reduce`, …) are deliberately NOT here: they invoke an
   argument, so their footprint is the argument's.

   A NAME IS NOT A PROOF. `fp-anf` never consults this table: an unresolved
   global stays opaque, so a caller with no resolver can never be told a
   shadowed name is pure. Only a PROGRAM-AWARE resolver may map one of these
   names to `{}` — and only after proving the program binds no definition of
   that name anywhere (`system.analyze` does exactly that)."
  #{"str" "+" "*" "-" "/" "inc" "dec" "count" "get" "get-in"
    "assoc" "assoc-in" "conj" "cons" "first" "second" "rest"
    "next" "keys" "vals" "into" "vec" "set" "list" "vector" "hash-map"
    "=" "not=" "<" ">" "<=" ">=" "not" "min" "max" "abs" "mod" "rem"
    "quot" "keyword" "symbol" "name" "pr-str" "type" "some?" "nil?"
    "empty?" "bit-and" "bit-or" "bit-xor" "bit-shift-left"
    "bit-shift-right" "bit-not" "boolean?" "compare"
    "identity" "even?" "odd?" "pos?" "neg?" "zero?" "int?" "string?"
    "keyword?" "map?" "vector?" "last"})

(defn fp-anf
  "Footprint of a bl-ANF node under alias env `aliases`: {resource → mode}.
   With a `resolve` fn (name→footprint|:unknown), a resolved user call
   contributes its callee's footprint instead of :opaque-world."
  ([n] (fp-anf ir/empty-aliases no-resolver n))
  ([aliases n] (fp-anf aliases no-resolver n))
  ([aliases resolve n]
   (if (nil? n) {}
     ; the numeric-tower scaffold (system.ir/arith-bif) is its BIF: pure
     (let [n (ir/arith-bif n)
           o (:op n)]
       (cond
         (contains? #{:lit :var :global :enil} o) {}
         (= o :remote)
           (let [k [(:mod n) (:fun n)] args (:args n)]
             (cond
               (contains? io-ops k)  (join-fp {:io (get op-mode k)} (fp-all aliases resolve args))
               (contains? op-mode k) (join-fp {(ir/resource-of aliases (first args)) (get op-mode k)}
                                              (fp-all aliases resolve args))
               (and (= k [rt :invoke]) (= :global (:op (first args))))
                 (if (contains? global-io (:name (first args)))
                   (join-fp {:io :W} (fp-all aliases resolve (rest args)))
                   (let [r (resolve (:name (first args)))]
                     (if (= r :unknown)
                       (join-fp {opaque-world :W} (fp-all aliases resolve (rest args)))
                       (join-fp r (fp-all aliases resolve (rest args))))))
               ; calling a computed fn value: applying it (see `apply-value`)
               (= k [rt :invoke])
                 (join-fp (apply-fp resolve) (fp-all aliases resolve args))
               (or (contains? value-ops [(:mod n) (:fun n) (count args)])
                   (contains? rt-value-ops [(:mod n) (:fun n) (count args)]))
                 (fp-all aliases resolve args)
               (contains? applying-ops [(:mod n) (:fun n) (count args)])
                 (join-fp (apply-fp resolve) (fp-all aliases resolve args))
               :else (join-fp {opaque-world :W} (fp-all aliases resolve args))))
         (= o :apply)
           (cond
             ; a compiled loop scaffold: the self-application is CONTROL, not an
             ; effect. Its footprint is its body's plus its init exprs' — the
             ; loop vars are computed locals (shadow any alias).
             (ir/anf-loop? n)
               (let [{:keys [vars body inits]} (ir/loop-parts n)
                     al (reduce (fn [a v] (dissoc a v)) aliases vars)]
                 (join-fp (fp-all aliases resolve inits) (fp-anf al resolve body)))
             ; a recur back-edge: fold the next-value footprints (the self-apply
             ; head is control). Its args are the new loop values.
             (ir/recur? n)
               (fp-all aliases resolve (ir/recur-vals n))
             ; a genuine call of a fn VALUE: applying it (see `apply-value`).
             :else (join-fp (apply-fp resolve) (fp-all aliases resolve (cons (:fn n) (:args n)))))
         ; a bare fn VALUE is the self scaffold `let self = (fn [self] inner)
         ; in (self self)`: the knot is control, the inner fn is deferred
         ; (realized at call) — the value has no footprint of its own.
         (ir/self-scaffold? n) {}
         (= o :let)    (join-fp (fp-anf aliases resolve (:init n))
                                (fp-anf (ir/let-env aliases n) resolve (:body n)))
         (= o :if)     (fp-all aliases resolve (list (:test n) (:then n) (:else n)))
         (= o :do)     (fp-all aliases resolve (:stmts n))
         (= o :case)   (join-fp (fp-anf aliases resolve (:subj n)) (fp-clauses aliases resolve (:clauses n)))
         (= o :fn)     {}                                  ; deferred: realized at call
         (= o :try)    (join-fp (fp-anf aliases resolve (:body n))
                                (join-fp (fp-clauses aliases resolve (:catch n))
                                         (if (nil? (:after n)) {} (fp-anf aliases resolve (:after n)))))
         (= o :recv)   (join-fp {opaque-world :K}
                                (join-fp (fp-clauses aliases resolve (:clauses n))
                                         (if (nil? (:after n)) {} (fp-anf aliases resolve (:after n)))))
         (= o :tuple)  (fp-all aliases resolve (:elems n))
         (= o :map)    (fp-all aliases resolve (mapcat (fn [p] (list (first p) (second p))) (:pairs n)))
         (= o :cons)   (fp-all aliases resolve (list (:head n) (:tail n)))
         ; a struct literal runs Mod:__struct__/1, i.e. module code: opaque, EXCEPT
         ; the vector literal, whose constructor is a pure field assembly
         ; (priv/host/vector.bl struct-of). Measured 2026-10-02: a vector
         ; literal is the only :struct ordinary source compiles to.
         (= o :struct) (if (contains? pure-struct-mods (:mod n))
                         (fp-all aliases resolve (ir/child-nodes n))
                         (join-fp {opaque-world :W}
                                  (fp-all aliases resolve (ir/child-nodes n))))
         (= o :arith) (fp-all aliases resolve (:args n))
         :else (join-fp {opaque-world :W} (fp-all aliases resolve (ir/child-nodes n))))))))

(defn fp-fn-body
  "Footprint of a compiled (fn …) node's clause bodies — what the fn DOES when
   called, which the :fn deferral above intentionally does not fold into the
   surrounding form's footprint. This is a function value's LATENT effect.
   With a `resolve` fn (name→footprint|:unknown) a named call inside the body
   contributes the callee's known footprint, exactly as in `fp-anf`."
  ([fn-node] (fp-fn-body no-resolver fn-node))
  ([resolve fn-node]
   (fp-clauses ir/empty-aliases resolve (:clauses fn-node))))

; ── surface-node shim ─────────────────────────────────────────────────────
;
; Callers that hold a SURFACE reader node (verify-process's spawn walk,
; examples, tests) reach the engine here: compile to bl-ANF, then walk. The
; `env` argument is retained for signature compatibility and is unused (the
; footprint's resource identity comes from the alias env, not the verify env).

(def compile-env (c/new-env "system.footprint"))

(defn fp-walk
  "The footprint of a SURFACE form: {resource → mode}. Compiles the form to
   bl-ANF and delegates to `fp-anf`."
  [_env node]
  (fp-anf (c/compile-node node compile-env)))

; ── the algebra ─────────────────────────────────────────────────────────

(defn rung
  "Recover the ladder rung from a footprint: the join of its mode ranks.
   Reproduces effects.bl's pure<atom<process<io."
  [fp]
  (let [max-rank (reduce (fn [r [_ m]] (max r (get mode-rank m))) -1 fp)]
    (cond (neg? max-rank) :pure
          (zero? max-rank) :pure
          (<= max-rank 2)
            (if (some (fn [[r _]] (= r :io)) fp) :io :atom)
          :else :process)))

(defn op-rung
  "The effect rung of a single op by NAME (effects.bl's leaf query). Kept
   name-keyed because effects.bl asks about a surface head symbol before any
   ANF exists; it maps the pure/io/resource families to a rung, or nil for an
   unknown op (the caller decides). This is the one intentional name-keyed
   surface, bridging effects.bl to the footprint model."
  [hname]
  (let [pure-names (into pure-value-globals
                         #{"map" "filter" "reduce" "and" "or" "binary/at"
                           "byte-at" "binary/size" "binary/part"})
        io-names #{"println" "File/read" "File/write"}
        mode-names {"swap!" :W "reset!" :W "deref" :R "atom" :R
                    "datom/transact!" :A "datom/listen!" :R "datom/db" :R "datom/q" :R
                    "erlang/send" :S "erlang/spawn" :X "receive" :K}]
    (cond
      (contains? pure-names hname) :pure
      (contains? io-names hname)   :io
      (contains? mode-names hname) (rung {:res (get mode-names hname)})
      :else                        nil)))

(defn pure? [fp]
  (every? (fn [[_ m]] (= m :R)) fp))

(defn monotone? [fp]
  (every? (fn [[_ m]] (contains? #{:R :A} m)) fp))

(defn resources [fp] (set (keys fp)))

; set intersection via membership (mirrors typed/t-meet) — no clojure.set in bl.
(defn- intersect [a b] (set (filter (fn [x] (contains? a x)) (into [] b))))

(defn commute?
  "Two footprints commute iff no SHARED resource carries a conflicting mode
   pair. Disjoint resources ⟹ trivially commute (the frame rule's core)."
  [fp1 fp2]
  (every? (fn [r] (not (conflict? (get fp1 r) (get fp2 r))))
          (into [] (intersect (resources fp1) (resources fp2)))))

(defn frame-independent?
  "e1 preserves any invariant over e2's region iff their resources are
   disjoint — Separation Logic's frame rule, decided structurally."
  [fp1 fp2]
  (empty? (intersect (resources fp1) (resources fp2))))
