; footprint.bl — an effect is a FOOTPRINT (P16b), computed over bl-ANF.
;
; ── The redefinition ──────────────────────────────────────────────────
;
; effects.bl models an effect as a RUNG on a ladder (pure < atom < process < io)
; — the JOIN, a lossy summary. This module promotes an effect to what it
; actually is: a set of RESOURCES, each touched in a MODE.
;
;     footprint ≜ {resource → mode}
;     mode ∈ {:R read · :A append/monotone · :W write · :S send · :K recv · :X spawn}
;
; The rung lattice is RECOVERED: rung = rank(join of modes). Nothing regresses;
; `rung` below reproduces effects.bl's ladder from a footprint, so the two
; models agree. The algebra the footprint carries IS the guarantees:
;
;     purity        ≜ footprint touches only :R (or is empty)
;     monotonicity  ≜ footprint touches only :R/:A
;     commutativity ≜ no shared resource carries a CONFLICTING mode pair
;     frame rule    ≜ disjoint resources ⟹ e1 preserves any invariant over e2's
;                     region (Separation Logic, decided STRUCTURALLY)
;
; ── Why over bl-ANF ────────────────────────────────────────────────────
;
; The footprint is computed over the IR the compiler emits, not the surface
; s-expression. The compiler has already expanded every macro and resolved
; every call, so `(-> a (swap! inc))`, `(when p (swap! a x))`, `(doto a …)`
; all reduce to the same resource ops a bare `swap!` does — the engine sees
; the MEANING, not the spelling, and never collapses a macro to :opaque-world.
; A resource op is a :remote to a known [module function]; its resource is the
; first argument, resolved through the alias env (system.ir) that tracks which
; local stands for which global. `fp-walk` remains for callers holding a
; surface node: it compiles to ANF, then walks.

(ns system.footprint
  (:require [system.ir :as ir] [compiler :as c]))

; ── the mode lattice ────────────────────────────────────────────────────
(def mode-rank {:R 0 :A 1 :W 2 :S 3 :K 3 :X 3})

(def opaque-world ir/opaque-world)

; Two modes on the SAME resource CONFLICT unless both are reads, or both are
; appends (appends commute — the monotone-merge property).
(defn conflict? [m1 m2]
  (not (or (and (= m1 :R) (= m2 :R))
           (and (= m1 :A) (= m2 :A)))))

; ── op classification, keyed by [module function] ────────────────────────
;
; ANF resolved the callee, so classification is by the exact [mod fun] the
; compiler chose — never a shadowable string name. The modules the runtime
; routes stateful ops through:
(def refs  :Elixir.BeamLisp.Refs)         ; atoms: swap!/reset!/deref/atom
(def rt    :Elixir.BeamLisp.RT)           ; invoke / println / collection ops
(def datom :Elixir.BeamLisp.Ns.Datom)     ; datom conn ops (RESOLVED module atom)

; A datom call resolves to the interned module atom when `datom` is loaded, and
; to the bare namespace atom `:datom` when it is not (e.g. a pre-datom compile).
; Key BOTH so classification is load-order-independent — the surface engine got
; this for free by keying the string name; ANF names the resolved module, so we
; enumerate both forms.
(def op-mode
  {[refs :swap!] :W  [refs :reset!] :W  [refs :deref] :R  [refs :atom] :R
   [datom :transact!] :A [datom :listen!] :R [datom :db] :R [datom :q] :R
   [:datom :transact!] :A [:datom :listen!] :R [:datom :db] :R [:datom :q] :R
   [:erlang :send] :S [:erlang :spawn] :X
   [rt :println] :W [:Elixir.File :read] :R [:Elixir.File :write] :W})

; io ops act on the ambient :io resource, not on an argument.
(def io-ops #{[rt :println] [:Elixir.File :read] [:Elixir.File :write]})

; A var invoked dynamically (RT.invoke of a :global) is opaque UNLESS it is a
; known io-by-name primitive.
(def global-io #{"println"})

; A :remote to one of these modules that is not a named resource/io op is a
; PURE host call: erlang arithmetic/guards, RT collection ops, binary
; indexing, list/map builders. Value semantics, no resource. Everything else
; (an unknown application module) stays conservatively opaque.
(def value-mods
  #{:erlang :binary :lists :maps :Elixir.BeamLisp.RT
    :Elixir.BeamLisp.Ns.Core :Elixir.BeamLisp.Ns.Reader})

; ── footprint over bl-ANF ─────────────────────────────────────────────────

(defn join-fp [a b]
  (reduce (fn [m [r mode]]
            (let [prev (get m r)]
              (if (or (nil? prev) (> (get mode-rank mode) (get mode-rank prev)))
                (assoc m r mode)
                m)))
          a b))

(declare fp-anf)

(defn- fp-all [aliases resolve nodes]
  (reduce (fn [m n] (join-fp m (fp-anf aliases resolve n))) {} nodes))

(defn- fp-clauses
  "Footprint of clause guards+bodies, each under the clause's shadowed env."
  [aliases resolve clauses]
  (reduce (fn [m cl]
            (let [al (ir/clause-env aliases cl)]
              (join-fp m (fp-all al resolve (if (nil? (:guard cl)) (list (:body cl))
                                             (list (:guard cl) (:body cl)))))))
          {} clauses))

; A CALLEE RESOLVER lets an inter-procedural caller (system.analyze) replace
; the opaque footprint of a user-function call with that callee's KNOWN
; footprint. Default resolver knows nothing (every user call is opaque) —
; the honest single-function answer. analyze passes a resolver backed by the
; summary table, closing the footprint over the call graph.
(def no-resolver (fn [_name] :unknown))

(defn fp-anf
  "Footprint of a bl-ANF node under alias env `aliases`: {resource → mode}.
   With a `resolve` fn (name→footprint|:unknown), a resolved user call
   contributes its callee's footprint instead of :opaque-world."
  ([n] (fp-anf ir/empty-aliases no-resolver n))
  ([aliases n] (fp-anf aliases no-resolver n))
  ([aliases resolve n]
   (if (nil? n) {}
     (let [o (:op n)]
       (cond
         (contains? #{:lit :var :global :enil} o) {}
         (= o :remote)
           (let [k [(:mod n) (:fun n)] args (:args n)]
             (cond
               (contains? io-ops k)  (join-fp {:io (get op-mode k)} (fp-all aliases resolve args))
               (contains? op-mode k) (join-fp {(ir/resource-of aliases (first args)) (get op-mode k)}
                                              (fp-all aliases resolve args))
               (and (= k [rt :invoke]) (= :global (:op (first args))))
                 (if (contains? global-io (:name (first args)))
                   (join-fp {:io :W} (fp-all aliases resolve (rest args)))
                   (let [r (resolve (:name (first args)))]
                     (if (= r :unknown)
                       (join-fp {opaque-world :W} (fp-all aliases resolve (rest args)))
                       (join-fp r (fp-all aliases resolve (rest args))))))
               (contains? value-mods (:mod n)) (fp-all aliases resolve args)
               :else (join-fp {opaque-world :W} (fp-all aliases resolve args))))
         (= o :apply)
           (cond
             ; a compiled loop scaffold: the self-application is CONTROL, not an
             ; effect. Its footprint is its body's plus its init exprs' — the
             ; loop vars are computed locals (shadow any alias).
             (ir/anf-loop? n)
               (let [{:keys [vars body inits]} (ir/loop-parts n)
                     al (reduce (fn [a v] (dissoc a v)) aliases vars)]
                 (join-fp (fp-all aliases resolve inits) (fp-anf al resolve body)))
             ; a recur back-edge: fold the next-value footprints (the self-apply
             ; head is control). Its args are the new loop values.
             (ir/recur? n)
               (fp-all aliases resolve (ir/recur-vals n))
             ; a genuine call of an unknown fn VALUE: opaque.
             :else (join-fp {opaque-world :W} (fp-all aliases resolve (cons (:fn n) (:args n)))))
         (= o :let)    (join-fp (fp-anf aliases resolve (:init n))
                                (fp-anf (ir/let-env aliases n) resolve (:body n)))
         (= o :if)     (fp-all aliases resolve (list (:test n) (:then n) (:else n)))
         (= o :do)     (fp-all aliases resolve (:stmts n))
         (= o :case)   (join-fp (fp-anf aliases resolve (:subj n)) (fp-clauses aliases resolve (:clauses n)))
         (= o :fn)     {}                                  ; deferred: realized at call
         (= o :try)    (join-fp (fp-anf aliases resolve (:body n))
                                (join-fp (fp-clauses aliases resolve (:catch n))
                                         (if (nil? (:after n)) {} (fp-anf aliases resolve (:after n)))))
         (= o :recv)   (join-fp {opaque-world :K}
                                (join-fp (fp-clauses aliases resolve (:clauses n))
                                         (if (nil? (:after n)) {} (fp-anf aliases resolve (:after n)))))
         (= o :tuple)  (fp-all aliases resolve (:elems n))
         (= o :map)    (fp-all aliases resolve (mapcat (fn [p] (list (first p) (second p))) (:pairs n)))
         (= o :cons)   (fp-all aliases resolve (list (:head n) (:tail n)))
         (= o :struct) (fp-all aliases resolve (mapcat (fn [p] (list (first p) (second p))) (:fields n)))
         :else {})))))

(defn fp-fn-body
  "Footprint of a compiled (fn …) node's clause bodies — what the fn DOES when
   called, which the :fn deferral above intentionally does not fold into the
   surrounding form's footprint."
  [fn-node]
  (fp-clauses ir/empty-aliases no-resolver (:clauses fn-node)))

; ── surface-node shim ─────────────────────────────────────────────────────
;
; Callers that hold a SURFACE reader node (verify-process's spawn walk,
; examples, tests) reach the engine here: compile to bl-ANF, then walk. The
; `env` argument is retained for signature compatibility and is unused (the
; footprint's resource identity comes from the alias env, not the verify env).

(def compile-env (c/new-env "system.footprint"))

(defn fp-walk
  "The footprint of a SURFACE form: {resource → mode}. Compiles the form to
   bl-ANF and delegates to `fp-anf`."
  [_env node]
  (fp-anf (c/compile-node node compile-env)))

; ── the algebra ─────────────────────────────────────────────────────────

(defn rung
  "Recover the ladder rung from a footprint: the join of its mode ranks.
   Reproduces effects.bl's pure<atom<process<io."
  [fp]
  (let [max-rank (reduce (fn [r [_ m]] (max r (get mode-rank m))) -1 fp)]
    (cond (neg? max-rank) :pure
          (zero? max-rank) :pure
          (<= max-rank 2)
            (if (some (fn [[r _]] (= r :io)) fp) :io :atom)
          :else :process)))

(defn op-rung
  "The effect rung of a single op by NAME (effects.bl's leaf query). Kept
   name-keyed because effects.bl asks about a surface head symbol before any
   ANF exists; it maps the pure/io/resource families to a rung, or nil for an
   unknown op (the caller decides). This is the one intentional name-keyed
   surface, bridging effects.bl to the footprint model."
  [hname]
  (let [pure-names #{"str" "+" "*" "-" "/" "inc" "dec" "count" "get" "get-in"
                     "assoc" "assoc-in" "conj" "cons" "first" "second" "rest"
                     "next" "keys" "vals" "map" "filter" "reduce" "into" "vec"
                     "set" "list" "vector" "hash-map" "=" "not=" "<" ">" "<="
                     ">=" "and" "or" "not" "min" "max" "abs" "mod" "rem" "quot"
                     "keyword" "symbol" "name" "pr-str" "type" "some?" "nil?"
                     "empty?" "bit-and" "bit-or" "bit-xor" "bit-shift-left"
                     "bit-shift-right" "bit-not" "binary/at" "byte-at"
                     "binary/size" "binary/part"}
        io-names #{"println" "File/read" "File/write"}
        mode-names {"swap!" :W "reset!" :W "deref" :R "atom" :R
                    "datom/transact!" :A "datom/listen!" :R "datom/db" :R "datom/q" :R
                    "erlang/send" :S "erlang/spawn" :X "receive" :K}]
    (cond
      (contains? pure-names hname) :pure
      (contains? io-names hname)   :io
      (contains? mode-names hname) (rung {:res (get mode-names hname)})
      :else                        nil)))

(defn pure? [fp]
  (every? (fn [[_ m]] (= m :R)) fp))

(defn monotone? [fp]
  (every? (fn [[_ m]] (contains? #{:R :A} m)) fp))

(defn resources [fp] (set (keys fp)))

; set intersection via membership (mirrors typed/t-meet) — no clojure.set in bl.
(defn- intersect [a b] (set (filter (fn [x] (contains? a x)) (into [] b))))

(defn commute?
  "Two footprints commute iff no SHARED resource carries a conflicting mode
   pair. Disjoint resources ⟹ trivially commute (the frame rule's core)."
  [fp1 fp2]
  (every? (fn [r] (not (conflict? (get fp1 r) (get fp2 r))))
          (into [] (intersect (resources fp1) (resources fp2)))))

(defn frame-independent?
  "e1 preserves any invariant over e2's region iff their resources are
   disjoint — Separation Logic's frame rule, decided structurally."
  [fp1 fp2]
  (empty? (intersect (resources fp1) (resources fp2))))
