; smt.bl — source → SMT-LIB translation, over bl-ANF (the ONE translator).
;
; The seam between model.bl (extracts a transition's guard/next as a reader
; node) and system.core (proves over SMT forms). This module turns a predicate
; — a reader node or a source string — into an SMT-LIB FORM (never a string;
; callers wrap with smt/emit at the z3 port edge) or :untranslatable.
;
; ── Why ANF, not surface syntax ──────────────────────────────────────────
;
; This translator reads bl-ANF, the compiler's resolved intermediate form, NOT
; the surface reader tree. Reading ANF is strictly better on two axes the old
; surface walker could not reach:
;
;   1. Operator resolution is FREE. The compiler already mapped every spelling —
;      `>=`, `erlang/>=`, a macro that expands to it — to ONE resolved [mod fun].
;      One table covers the arithmetic/relational fragment; a macro or qualified
;      call the surface matcher missed by NAME now collapses to the same node.
;
;   2. It can SEE THROUGH A CALL. A guard `(safe? balance)` where `safe?` is a
;      pure helper was opaque to the surface walker (uninterpreted, or dropped).
;      Here a user call is a clear (RT/invoke (:global f) …); if f is PROVEN PURE
;      (system.analyze footprint = ∅), of-source-inlining looks up its ANF body
;      and INLINES it, modelling the helper's actual computation soundly.
;
; The old surface walker was verified equivalent to this one, term-for-term,
; through z3 over a 22-entry corpus (scalar, and/or/=>, enums, collection
; length, multi-clause define-fun) before it was deleted. See
; docs/tools/07-one-smt-translator.bl.org.
;
; ── the vocabulary ───────────────────────────────────────────────────────
;
;   arithmetic/relational  + - * div mod < > <= >= = (and erlang == =:=)
;   booleans               and or not =>            (reconstructed from the
;                                                     compiler's short-circuit
;                                                     :let/:if scaffold)
;   predicates             pos? neg? zero? inc dec   → comparisons/±1
;   truncated division     quot rem                  → reconstructed from
;                                                       Euclidean div/mod
;   idioms                 max min                    → ite
;   strings                str str-len str-contains? str-prefix? str-suffix?
;   enums                  keyword lit / {:tag v} / (:tag x) / (some? (:tag x))
;   collection length      count conj rest pop next empty?  → integer arith
;   functional lowering    a defn → (define-fun …)
;
; Anything outside this fragment yields :untranslatable, so the checker SKIPS
; that proof and warns — never a false proof.

(ns system.smt
  (:require [typed] [smt :as smtlib]
            [system.ir :as ir]
            [system.analyze :as analyze]
            [compiler :as c]))

; ── the SORT FUNCTOR: a value's tag-lattice tag → its z3 SORT ─────────────
;
; z3 is NOT an Int solver — that limitation never lived in the port (z3/check
; pipes raw SMT-LIB; every theory is reachable). Each state field's INFERRED tag
; picks its natural z3 theory, so one verify-process spans Int, Real, Bool and
; String with no per-theory code — just the sort the field already has.
;
;   :int → Int      :float → Real     :bool → Bool     :string → String
;
; Compound tags (:vec :set :map :kw) are the caller's business and return
; :unknown here — the checker then stays silent on what it cannot yet model.

(defn sort-of-tags
  "The z3 sort NAME for a tagset, or :unknown. Scalar theories only; a compound
   or ambiguous tagset is :unknown so the caller keeps it untranslatable."
  [tags]
  (cond
    (contains? tags :int)    "Int"
    (contains? tags :float)  "Real"
    (contains? tags :bool)   "Bool"
    (contains? tags :string) "String"
    :else :unknown))

(defn value-tags
  "The tag-lattice tagset of a parsed literal VALUE node. Delegates scalar
   classification to typed/lit-type (the one source of truth for a datum's
   tag); a keyword/collection node carries its structural tag; a symbol
   (pass-through field) is `any`, mapped to :unknown by the sort functor."
  [node]
  (let [f (typed/node-form node) tg (typed/node-tag f)]
    (cond
      (= tg :scalar)  (typed/lit-type f)
      (= tg :keyword) #{:kw}
      (= tg :vector)  #{:vec}
      (= tg :map)     #{:map}
      (= tg :set)     #{:set}
      :else           typed/any)))

(defn sort-of-value
  "z3 sort NAME for an init field VALUE node, via the tag lattice. :unknown when
   the value is a pass-through symbol or a compound the scalar functor doesn't
   cover (the caller defaults those to Int, preserving the integer common case)."
  [node]
  (sort-of-tags (value-tags node)))

; ══════════════════════════════════════════════════════════════════════════
; THE ANF TRANSLATOR
; ══════════════════════════════════════════════════════════════════════════

(def rt :Elixir.BeamLisp.RT)

(defn- untranslatable? [x] (= x :untranslatable))

; [mod fun] → SMT operator symbol, for the ops the compiler resolves to a clean
; remote. `and`/`or`/`=>` are absent — they lower to short-circuit :let/:if,
; reconstructed by `scaffold`. `div`/`not`/`=<`(the `<=` spelling)/`str*` arrive
; as RT/invoke and are handled in the call dispatch.
(def op-table
  {[:erlang :+] '+ [:erlang :-] '- [:erlang :*] '*
   [:erlang :>] '> [:erlang :<] '< [:erlang :>=] '>= [:erlang :=<] '<=
   [:erlang :==] '= [:erlang :=:=] '=
   [rt :eqv] '= [:Elixir.BeamLisp.Ns.Core :mod] 'mod})

; truncated division from z3's Euclidean div/mod (see the quot/rem note below).
(defn- smt-quot [a b]
  (list '+ (list 'div a b)
        (list 'ite (list 'and (list '< a 0) (list '> (list 'mod a b) 0))
              (list 'ite (list '> b 0) 1 (list '- 1)) 0)))
(defn- smt-rem [a b]
  (list '- a (list '* b (smt-quot a b))))

; ── quot / rem: TRUNCATED division from z3's EUCLIDEAN div/mod ──────────────
;
; beam-lisp quot/rem are BEAM/C truncated division: quot rounds toward zero, rem
; carries the DIVIDEND's sign. SMT-LIB div/mod are Euclidean: mod is always in
; [0,|b|). They DISAGREE on negative operands, so a naive quot→div would let z3
; reason about a different function than the code runs. smt-quot/smt-rem
; reconstruct truncation from div/mod EXACTLY (verified for all four sign
; combinations). Sound when b≠0 (b=0 raises in bl, uninterpreted in z3 — a crash
; the property tester surfaces, not a false proof).

(declare translate-node)

; length abstraction: a collection var c ∈ colls → c_len (Int); count/conj/
; rest/pop/next/empty? over it → integer arithmetic on c_len.
(defn- len-name [c] (symbol (str c "_len")))

(defn- coll-var? [ctx node]
  (and (= :global (:op node)) (contains? (:colls ctx) (:name node))))

; ── the short-circuit reconstruction: :let scaffold → and/or/=> ───────────
;
; (and X Y) compiles to  (let [g X] (if g Y g))   — else branch re-reads g
; (or  X Y) compiles to  (let [g X] (if g g Y))   — then branch re-reads g
; (=> X Y) is (or (not X) Y): the or-scaffold, init = (not X).
; The recognizer matches the STRUCTURAL shape (the let-var appearing as test AND
; as one branch), so it survives the compiler's gensym renames.
(defn- scaffold [ctx node]
  (if (not (= :let (:op node)))
    :no
    (let [nm (:name node) body (:body node)]
      (if (not (= :if (:op body)))
        :no
        (let [test (:test body) then (:then body) els (:else body)
              is-var? (fn [n] (and (= :var (:op n)) (= nm (:name n))))]
          (cond
            (and (is-var? test) (is-var? els))
              (let [x (translate-node ctx (:init node)) y (translate-node ctx then)]
                (if (or (untranslatable? x) (untranslatable? y)) :untranslatable
                  (list 'and x y)))
            (and (is-var? test) (is-var? then))
              (let [x (translate-node ctx (:init node)) y (translate-node ctx els)]
                (if (or (untranslatable? x) (untranslatable? y)) :untranslatable
                  (list 'or x y)))
            :else :no))))))

; ── call dispatch ─────────────────────────────────────────────────────────

(defn- cons->args [node]
  (loop [n node acc []]
    (if (= :cons (:op n)) (recur (:tail n) (conj acc (:head n))) acc)))

; primitives that arrive as RT/invoke (:global name) — the ops the compiler
; leaves as a var apply rather than a resolved remote.
(def invoke-desugar
  {"div"           (fn [as] (list 'div (first as) (second as)))
   "not"           (fn [as] (list 'not (first as)))
   "=<"            (fn [as] (list '<= (first as) (second as)))
   "str"           (fn [as] (apply list 'str.++ as))
   "str-len"       (fn [as] (list 'str.len (first as)))
   "str-contains?" (fn [as] (apply list 'str.contains as))
   "str-prefix?"   (fn [as] (apply list 'str.prefixof as))
   "str-suffix?"   (fn [as] (apply list 'str.suffixof as))})

(defn- global-name [node]
  (and (= :global (:op node)) (:name node)))

(defn- t-args [ctx nodes]
  (let [ts (map (fn [n] (translate-node ctx n)) nodes)]
    (if (some untranslatable? ts) :untranslatable ts)))

(defn- t-invoke
  "An (RT/invoke (:global f) argcons) call: payload accessor, nth, primitive
   desugar, or pure-helper inline. Otherwise :untranslatable (honest — an
   unknown or impure callee is not modellable)."
  [ctx node]
  (let [args (:args node)
        callee (first args)
        f (global-name callee)
        actuals (if (>= (count args) 2) (cons->args (second args)) [])]
    (cond
      ; payload accessor (:tag arg): callee is a :lit keyword
      (and (= :lit (:op callee)) (keyword? (:val callee)))
        (let [k (name (:val callee))
              v (get (:variants ctx) k)]
          (if (and (map? v) (:field v))
            (let [a (translate-node ctx (first actuals))]
              (if (untranslatable? a) :untranslatable (list (symbol (:field v)) a)))
            :untranslatable))
      (nil? f) :untranslatable
      ; nth over a positional tuple var: (nth p 0) → p_0
      (and (= f "nth") (= 2 (count actuals))
           (= :global (:op (first actuals)))
           (= :lit (:op (second actuals))) (int? (:val (second actuals))))
        (symbol (str (:name (first actuals)) "_" (:val (second actuals))))
      ; primitive desugar
      (contains? invoke-desugar f)
        (let [ts (t-args ctx actuals)]
          (if (untranslatable? ts) :untranslatable ((get invoke-desugar f) ts)))
      ; pure-helper inline
      (and (contains? (:bodies ctx) f) ((:pure? ctx) f))
        (let [d (get (:bodies ctx) f)
              params (:params d)
              benv (reduce (fn [m [p a]] (assoc m p (translate-node ctx a)))
                           (:env ctx) (map (fn [p a] [p a]) params actuals))]
          (translate-node (assoc ctx :env benv) (:body d)))
      :else :untranslatable)))

; collection-length ops keyed by :fun (mod-agnostic — RT or Core). First arg is
; the collection; abstracted to <c>_len when c ∈ (:colls ctx).
(defn- t-length-op [ctx node]
  (let [fun (:fun node) args (:args node) a0 (first args)]
    (cond
      (and (= fun :count) (= 1 (count args)) (coll-var? ctx a0))
        (len-name (:name a0))
      (and (= fun :conj) (= 2 (count args)) (coll-var? ctx a0))
        (list '+ (len-name (:name a0)) 1)
      (and (contains? #{:rest :pop :next} fun) (= 1 (count args)) (coll-var? ctx a0))
        (list '- (len-name (:name a0)) 1)
      (and (= fun :empty?) (= 1 (count args)) (coll-var? ctx a0))
        (list '= (len-name (:name a0)) 0)
      :else :no)))

; (some? (:tag x)) / (is? (:tag x)) → ((_ is Ctor) x): "the :tag arm is present".
(defn- discriminant [ctx node]
  (let [args (:args node) inner (first args)]
    (if (and (= 1 (count args)) (ir/node? inner)
             (= :remote (:op inner)) (= rt (:mod inner)) (= :invoke (:fun inner)))
      (let [iargs (:args inner) kw (first iargs)]
        (if (and (= :lit (:op kw)) (keyword? (:val kw)))
          (let [k (name (:val kw))
                v (get (:variants ctx) k)
                actuals (if (>= (count iargs) 2) (cons->args (second iargs)) [])
                arg (first actuals)]
            (if (and (map? v) (:ctor v) (= :global (:op arg)))
              (list (list '_ 'is (symbol (:ctor v))) (symbol (:name arg)))
              :untranslatable))
          :untranslatable))
      :untranslatable)))

(defn- t-remote [ctx node]
  (let [key [(:mod node) (:fun node)]
        fun (:fun node) args (:args node)]
    (cond
      (and (= (:mod node) rt) (= fun :invoke)) (t-invoke ctx node)
      ; collection length (mod-agnostic, only when a coll var is present)
      (and (not (empty? (:colls ctx)))
           (contains? #{:count :conj :rest :pop :next :empty?} fun)
           (not (= :no (t-length-op ctx node))))
        (t-length-op ctx node)
      ; some?/is? discriminant
      (and (contains? #{:some? :is?} fun) (= 1 (count args)))
        (let [d (discriminant ctx node)]
          (if (untranslatable? d) :untranslatable d))
      ; max/min → ite
      (and (contains? #{:max :min} fun) (= 2 (count args)))
        (let [ts (t-args ctx args)]
          (if (untranslatable? ts) :untranslatable
            (let [a (first ts) b (second ts) cmp (if (= fun :max) '>= '<=)]
              (list 'ite (list cmp a b) a b))))
      ; quot (Core) / rem (erlang)
      (and (= fun :quot) (= 2 (count args)))
        (let [ts (t-args ctx args)]
          (if (untranslatable? ts) :untranslatable (smt-quot (first ts) (second ts))))
      (and (= key [:erlang :rem]) (= 2 (count args)))
        (let [ts (t-args ctx args)]
          (if (untranslatable? ts) :untranslatable (smt-rem (first ts) (second ts))))
      ; pos?/neg?/zero?/inc/dec (mod-agnostic — RT for the predicates, Core for inc/dec)
      (and (contains? #{:pos? :neg? :zero? :inc :dec} fun) (= 1 (count args)))
        (let [a (translate-node ctx (first args))]
          (if (untranslatable? a) :untranslatable
            (cond (= fun :pos?) (list '> a 0) (= fun :neg?) (list '< a 0)
                  (= fun :zero?) (list '= a 0) (= fun :inc) (list '+ a 1)
                  (= fun :dec) (list '- a 1))))
      ; nth over a positional tuple var (also reachable as a resolved remote)
      (and (= fun :nth) (= 2 (count args))
           (= :global (:op (first args)))
           (= :lit (:op (second args))) (int? (:val (second args))))
        (symbol (str (:name (first args)) "_" (:val (second args))))
      ; op-table (arithmetic/relational)
      (contains? op-table key)
        (let [op (get op-table key)
              ts (t-args ctx args)]
          (if (untranslatable? ts) :untranslatable (apply list op ts)))
      :else :untranslatable)))

(defn translate-node
  "bl-ANF node → an SMT formula (a quoted s-expr) or :untranslatable, under
   `ctx` {:env :variants :colls :bodies :pure?}. env maps a var/param name to an
   already-translated formula (inlining); variants maps an enum tag string to
   its z3 constructor entry; colls is the set of length-abstracted var names;
   bodies/pure? gate pure-helper inlining."
  [ctx node]
  (cond
    (not (ir/node? node)) :untranslatable
    (= :lit (:op node))
      (let [v (:val node)]
        (cond
          (keyword? v)
            (let [entry (get (:variants ctx) (name v))]
              (cond (nil? entry) :untranslatable
                    (map? entry) (symbol (:ctor entry))
                    :else (symbol entry)))
          (int? v) v (float? v) v (= v true) true (= v false) false
          (string? v) v
          :else :untranslatable))
    (= :var (:op node)) (get (:env ctx) (:name node) (symbol (:name node)))
    (= :global (:op node))
      (let [nm (:name node)]
        (if (contains? (:colls ctx) nm) (len-name nm)
          (get (:env ctx) nm (symbol nm))))
    ; empty vector literal → length 0 (only meaningful in length mode)
    (and (= :struct (:op node)) (= :Elixir.BeamLisp.Vector (:mod node)))
      (if (empty? (:colls ctx)) :untranslatable 0)
    (= :if (:op node))
      (let [test (translate-node ctx (:test node))
            then (translate-node ctx (:then node))
            els (translate-node ctx (:else node))]
        (if (some untranslatable? [test then els]) :untranslatable
          (list 'ite test then els)))
    (= :let (:op node))
      (let [s (scaffold ctx node)]
        (if (= s :no) :untranslatable s))
    ; single-key map literal {:tag v} → payload ctor call
    (= :map (:op node))
      (let [pairs (:pairs node)]
        (if (not (= 1 (count pairs))) :untranslatable
          (let [pair (first pairs)
                khead (first pair)
                kw (and (= :remote (:op khead)) (first (:args khead)))
                vnode (second pair)]
            (if (and kw (= :lit (:op kw)) (keyword? (:val kw)))
              (let [k (name (:val kw)) v (get (:variants ctx) k)]
                (if (and (map? v) (:field v))
                  (let [a (translate-node ctx vnode)]
                    (if (untranslatable? a) :untranslatable (list (symbol (:ctor v)) a)))
                  :untranslatable))
              :untranslatable))))
    (= :remote (:op node)) (t-remote ctx node)
    :else :untranslatable))

; ── translation context ───────────────────────────────────────────────────

(defn- ctx-of
  "A translation ctx. `vars` seed env as themselves; `variants`/`colls` set the
   enum/length modes; `prog-src` (optional) supplies pure-helper bodies to inline."
  ([vars] (ctx-of vars {} #{} nil))
  ([vars variants colls prog-src]
   (let [summaries (if prog-src (analyze/analyze prog-src) {})
         bodies (if prog-src (into {} (analyze/fn-bodies prog-src)) {})
         pure? (fn [nm] (empty? (:footprint (get summaries nm {:footprint {:x 1}}))))]
     {:env (reduce (fn [m v] (assoc m v (symbol v))) {} (into [] vars))
      :variants variants :colls colls :bodies bodies :pure? pure?})))

(defn- ->anf-src
  "Compile a SOURCE string to bl-ANF (read, then compile the first form)."
  [src]
  (c/compile-node (first (BeamLisp.Reader/read_string src)) (c/new-env "system.smt")))

(defn- ->anf-node
  "Compile a reader NODE to bl-ANF. A NODE argument may be a bare scalar (the
   reader stores a string/number/bool literal as the raw value, not a tagged
   tuple) — compile-node handles those directly, so we must NOT re-read a bare
   string as source (that would parse \"evt:init\" as the symbol evt:init)."
  [node]
  (c/compile-node node (c/new-env "system.smt")))

; ── PUBLIC API (unchanged surface; ANF underneath) ────────────────────────

(defn translate
  "A reader node → a DATA FORM or :untranslatable. `variants` maps an enum tag
   string (e.g. \"open\") to its z3 constructor entry; the 2-arg form is the
   no-enum default. Callers wrap the returned form with smt/script or smt/emit
   only at the z3 port edge."
  ([vars node] (translate vars {} node))
  ([vars variants node] (translate-node (ctx-of vars variants #{} nil) (->anf-node node))))

(defn translate-len
  "Like translate, but each name in `colls` is abstracted to its length:
   count/conj/rest/pop/next/empty? over a collection var become integer
   arithmetic on <var>_len; the empty-vector literal is 0."
  [vars colls node]
  (translate-node (ctx-of vars {} colls nil) (->anf-node node)))

(defn translatable?
  "Whether a source string translates cleanly under `vars`."
  [vars src]
  (not (untranslatable? (translate vars (first (BeamLisp.Reader/read_string src))))))

(defn of-source
  "Translate a source STRING to a FORM or :untranslatable. `vars` is the set of
   state-variable name strings. Prefer of-node when a clause node is in hand."
  [vars src]
  (if (nil? src) nil (translate-node (ctx-of vars) (->anf-src src))))

(defn of-node
  "Translate a reader NODE (model.bl's clause carriers) to a FORM or
   :untranslatable. The 3-arg form threads an enum `variants` map."
  ([vars node] (of-node vars {} node))
  ([vars variants node]
   (if (nil? node) nil (translate-node (ctx-of vars variants #{} nil) (->anf-node node)))))

(defn of-source-len
  "translate-len over a source STRING."
  [vars colls src]
  (if (nil? src) nil (translate-node (ctx-of vars {} colls nil) (->anf-src src))))

(defn of-node-len
  "translate-len over a reader NODE — the node-direct sibling of of-source-len."
  [vars colls node]
  (if (nil? node) nil (translate-node (ctx-of vars {} colls nil) (->anf-node node))))

(defn of-source-variants
  "of-source with an enum `variants` map (tag string → constructor entry)."
  [vars variants src]
  (if (nil? src) nil (translate-node (ctx-of vars variants #{} nil) (->anf-src src))))

(defn of-source-inlining
  "Translate predicate `pred-src` against whole program `prog-src`, INLINING any
   pure helper it calls. The capability the surface walker never had: a guard
   `(safe? x)` where safe? is a pure helper is modelled by its actual body,
   soundly, instead of being dropped. `state-vars` seed the env as SMT symbols."
  [prog-src state-vars pred-src]
  (translate-node (ctx-of state-vars {} #{} prog-src) (->anf-src pred-src)))

; ── enum datatype support (emission helpers — not translation) ────────────
;
; A field whose value is a keyword is a finite ENUM. Its universe is the set of
; tags it can hold; in z3 that is an algebraic datatype whose constructors are
; the tags. Constructors are SORT-PREFIXED (Phase-open, not open) because a bare
; constructor name collides across datatypes ("ambiguous constant reference").

(defn variant-ctor
  "The z3 constructor name for tag `k` in the enum sort `sort`:
   \"E_phase\", \"open\" → \"E_phase-open\"."
  [sort k]
  (str sort "-" k))

(defn variant-field
  "The z3 accessor (field selector) name for a payload arm `k` of `sort`:
   \"E_mode\", \"on\" → \"E_mode-on.val\"."
  [sort k]
  (str sort "-" k ".val"))

; A variant sort's `arms` is {tag → payload-sort-or-nil}: nil = a NULLARY arm,
; a sort string = a PAYLOAD arm. This one shape drives both the map the
; translator reads and the declare-datatypes prelude.

(defn variants-map
  "{tag → entry} for a variant `sort` over `arms` {tag→payload-sort|nil}. A
   nullary arm maps to its constructor STRING; a payload arm to a MAP
   {:ctor :field :sort} the translator uses for constructor/accessor/discriminant."
  [sort arms]
  (into {} (map (fn [pair]
                  (let [k (first pair) psort (second pair)]
                    (if (nil? psort)
                      [k (variant-ctor sort k)]
                      [k {:ctor (variant-ctor sort k)
                          :field (variant-field sort k)
                          :sort psort}])))
                (into [] arms))))

(defn datatype-decl
  "The (declare-datatypes …) FORM for a variant `sort` over `arms`
   {tag→payload-sort|nil}. A nullary arm is a bare constructor; a payload arm is
   (Ctor (Ctor.val Sort)). All constructors sort-prefixed (no cross-sort clash)."
  [sort arms]
  (list 'declare-datatypes
        '()
        (list (apply list (symbol sort)
                      (map (fn [pair]
                             (let [k (first pair) psort (second pair)]
                               (if (nil? psort)
                                 (symbol (variant-ctor sort k))
                                 (list (symbol (variant-ctor sort k))
                                       (list (symbol (variant-field sort k)) (symbol psort))))))
                           (into [] arms))))))

; ── FUNCTIONAL lowering: a defn → an SMT (define-fun …) ──────────────────────
;
; covers/of-source check predicates OVER inputs — a STRUCTURAL question. To
; prove a law over a function's OUTPUT (∀ x. law(x, (f x))) z3 must know what `f`
; COMPUTES: a define-fun whose body is the translated defn body. A multi-clause
; guarded defn folds to nested ite, the last clause the else arm. Because the
; guards/bodies come from ANF, a guard using a macro or resolved op works.
; Any untranslatable guard or body ⇒ :untranslatable (never a false definition).

(defn- descriptor-clauses
  "The clause tuples of a compiled defn node, or nil if not a defn. A defn
   compiles to (Link/defvar ns name (:lit DESCRIPTOR) meta); the descriptor is a
   LIST of {:fixed arity fname clausemap} tuples."
  [anf]
  (if (and (= :remote (:op anf)) (= :Elixir.BeamLisp.Link (:mod anf)) (= :defvar (:fun anf)))
    (let [lit (nth (:args anf) 2)]
      (if (= :lit (:op lit)) (:val lit) nil))
    nil))

(defn- clause-parts
  "{:params [name…] :guard ANF|nil :body ANF} from a {:fixed arity fname cm}
   descriptor tuple."
  [tup]
  (let [l (erlang/tuple_to_list tup)
        cm (nth l 3)]
    {:params (into [] (map (fn [p] (:name p)) (:params cm)))
     :guard (:guard cm)
     :body (:body cm)}))

(defn- fold-clauses
  "Fold guarded clauses to nested ite over canonical param symbols `cps`. Each
   clause's own (compiler-renamed) params bind to the canonical params in env;
   the last clause is the else arm."
  [cps clauses]
  (let [c (first clauses)
        p (clause-parts c)
        env (reduce (fn [m [rp cp]] (assoc m rp (symbol cp)))
                    {} (map (fn [rp cp] [rp cp]) (:params p) cps))
        ctx (assoc (ctx-of #{}) :env env)]
    (if (empty? (rest clauses))
      (translate-node ctx (:body p))
      (let [g (if (nil? (:guard p)) true (translate-node ctx (:guard p)))
            b (translate-node ctx (:body p))
            rest-smt (fold-clauses cps (rest clauses))]
        (if (or (untranslatable? g) (untranslatable? b) (untranslatable? rest-smt))
          :untranslatable
          (list 'ite g b rest-smt))))))

(defn- source-param-names
  "The ORIGINAL param name strings of a defn SOURCE's first clause. ANF renames
   params (c → c_3); the define-fun signature should read in the user's names,
   so we take them from the surface AST, not the descriptor."
  [defn-src]
  (let [node (first (BeamLisp.Reader/read_string defn-src))
        its (typed/node-items (typed/node-form node))
        dc (typed/defn-clauses its)
        clauses (nth dc 2)
        pc (first clauses)]
    (into [] (map (fn [p] (typed/node-name (typed/node-form p))) (:params pc)))))

(defn defn->define-fun
  "Lower a defn SOURCE to (define-fun name ((p Sort)…) Ret body) over `ret-sort`
   (all params share it — the arithmetic common case), via the ANF descriptor.
   Folds guarded clauses to nested ite. :untranslatable when the body leaves the
   fragment. The returned form is a z3 prelude: assert a law over (name …)."
  [defn-src ret-sort]
  (let [anf (->anf-src defn-src)
        clauses (descriptor-clauses anf)]
    (if (nil? clauses) :untranslatable
      (let [cls (into [] clauses)
            cps (source-param-names defn-src)
            body-smt (fold-clauses cps cls)]
        (if (untranslatable? body-smt) :untranslatable
          ; eager lists: a form is data, never a half-realized thunk
          (apply list 'define-fun (symbol (:val (nth (:args anf) 1)))
                 (apply list (map (fn [p] (list (symbol p) (symbol ret-sort))) cps))
                 (symbol ret-sort)
                 (list body-smt)))))))
