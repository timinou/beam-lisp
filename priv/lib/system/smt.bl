; smt.bl — source → SMT-LIB translation (P17: the checker seam).
;
; The seam between model.bl (extracts a transition's guard/next as source) and
; system.bl (proves over SMT strings). beam-lisp's prefix arithmetic is ALREADY
; valid SMT-LIB — (+ balance amt), (>= n 0), (and a b) translate as identity.
; This module adds:
;   - predicate desugaring: (pos? x) → (> x 0), (zero? x) → (= x 0), etc.
;   - inc/dec: (inc n) → (+ n 1), (dec n) → (- n 1)
;   - literal rendering (ints, true/false)
;   - UNTRANSLATABLE detection: an unknown form yields :untranslatable, so the
;     checker SKIPS that proof and warns, never emitting a false proof.
;
; State vars are modelled as SMT integers — the common case for process state
; (balances, counters, phases-as-ints). Non-integer state (maps, strings) is
; out of this translator's scope and surfaces as :untranslatable.

(ns system.smt
  (:require [typed]))

; ── the SORT FUNCTOR: a value's tag-lattice tag → its z3 SORT ─────────────
;
; z3 is NOT an Int solver — that limitation lived HERE, in this translator,
; never in the port (z3/check pipes raw SMT-LIB and reads sat/unsat; every z3
; theory is already reachable). The functor is the wire the P18 thesis always
; implied: "state ≜ ⟦type-lattice⟧". Each state field's INFERRED tag picks its
; natural z3 theory, so one `verify-process` spans Int, Real, Bool and String
; with no per-theory code — just the sort the field already has.
;
;   :int → Int      :float → Real     :bool → Bool     :string → String
;
; Compound tags (:vec :set :map :kw) are the caller's business (Array/Seq/ADT,
; the next increment) and return :unknown here — the checker then stays silent
; on what it cannot yet model (sound-warnings-only).

(defn sort-of-tags
  "The z3 sort NAME for a tagset, or :unknown. Scalar theories only; a compound
   or ambiguous tagset is :unknown so the caller keeps it untranslatable."
  [tags]
  (cond
    (contains? tags :int)    "Int"
    (contains? tags :float)  "Real"
    (contains? tags :bool)   "Bool"
    (contains? tags :string) "String"
    :else :unknown))

(defn value-tags
  "The tag-lattice tagset of a parsed literal VALUE node. Delegates scalar
   classification to typed/lit-type (the one source of truth for a datum's
   tag) — for a :scalar node the form IS the raw value (int/float/string/bool);
   keyword/collection nodes carry their structural tag; a symbol (pass-through
   field) is `any`, which the sort functor maps to :unknown."
  [node]
  (let [f (typed/node-form node) tg (typed/node-tag f)]
    (cond
      (= tg :scalar)  (typed/lit-type f)
      (= tg :keyword) #{:kw}
      (= tg :vector)  #{:vec}
      (= tg :map)     #{:map}
      (= tg :set)     #{:set}
      :else           typed/any)))

(defn sort-of-value
  "z3 sort NAME for an init field VALUE node, via the tag lattice: the
   type-directed replacement for the old two-case lit-sort. :unknown when the
   value is a pass-through symbol or a compound the scalar functor doesn't cover
   (the caller defaults those to Int, preserving the integer common case)."
  [node]
  (sort-of-tags (value-tags node)))

; ── the translatable vocabulary ─────────────────────────────────────────

; binary/n-ary ops that pass through unchanged (prefix bl = prefix SMT-LIB)
(def passthrough-ops
  #{"+" "-" "*" "and" "or" "not" "=" "<" ">" "<=" ">=" "mod" "=>" "ite"})

; predicates that desugar to a comparison against a state var
(def unary-desugar
  {"pos?"  (fn [x] (str "(> " x " 0)"))
   "neg?"  (fn [x] (str "(< " x " 0)"))
   "zero?" (fn [x] (str "(= " x " 0)"))
   "inc"   (fn [x] (str "(+ " x " 1)"))
   "dec"   (fn [x] (str "(- " x " 1)"))
   "not"   (fn [x] (str "(not " x ")"))})

; STRING-theory operations: bl string fns → SMT-LIB str.* (SMT-LIB 2.6 Unicode
; strings). Each maps a bl call to the z3 operator of the same meaning, so a
; message-content invariant ((str.contains reply \"ok\")) translates directly.
; NB: `count` is deliberately ABSENT — it is ambiguous (collection length vs
; string length) and the collection path (translate-len) owns it. A string
; length invariant uses (str-len s) explicitly.
(def string-ops
  {"str"           "str.++"       ; (str a b) → concatenation
   "str-len"       "str.len"      ; (str-len s) → length
   "str-contains?" "str.contains"
   "str-prefix?"   "str.prefixof"
   "str-suffix?"   "str.suffixof"})

; Render a bl float as an SMT Real literal. z3 wants a decimal point; a whole
; float like 2.0 already carries one via str, but guard the integer-valued case.
(defn- smt-real [x]
  (let [s (str x)]
    (if (some (fn [ch] (= ch ".")) (into [] s)) s (str s ".0"))))

; ── the translator ──────────────────────────────────────────────────────
;
; Returns an SMT-LIB string, or the keyword :untranslatable if any subform is
; outside the vocabulary. `vars` is the set of known state-variable names
; (symbols); a symbol not in `vars` is still emitted (it may be an input var
; the caller declared), but see translate-strict for the checked variant.

(declare translate)

(defn- untranslatable? [x] (= x :untranslatable))

; ── payload-variant discriminant recognition (R1b) ──────────────────────
; (some? (:on mode)) is the discriminant "the :on arm is present". Recognize the
; inner (:on mode) as a payload-accessor over a known variant tag, and emit the
; z3 tester ((_ is E_mode-on) mode).
(defn- variant-access?
  "Is `node` a payload accessor (:tag field) over a known payload variant?"
  [variants node]
  (let [f (typed/node-form node)]
    (and (= :list (typed/node-tag f))
         (let [its (typed/node-items f)]
           (and (= 2 (count its))
                (= :keyword (typed/node-tag (typed/node-form (first its))))
                (let [v (get variants (typed/node-name (typed/node-form (first its))))]
                  (and (map? v) (:field v))))))))

(defn- variant-is-test
  "The z3 discriminant ((_ is Ctor) arg) for a recognized (:tag arg) accessor."
  [variants node]
  (let [its (typed/node-items (typed/node-form node))
        k (typed/node-name (typed/node-form (first its)))
        v (get variants k)
        arg (typed/node-name (typed/node-form (second its)))]
    (str "((_ is " (:ctor v) ") " arg ")")))

; ── quot / rem: TRUNCATED division from z3's EUCLIDEAN div/mod ──────────────
;
; beam-lisp quot/rem are BEAM/C truncated division: quot rounds toward zero, rem
; carries the DIVIDEND's sign. SMT-LIB div/mod are Euclidean: mod is always in
; [0,|b|). They DISAGREE on negative operands, so a naive quot→div would let z3
; reason about a different function than the code runs. These reconstruct
; truncation from div/mod EXACTLY (verified against the bl runtime for all four
; sign combinations):
;   quot a b = (div a b) + correction, correction = sign(b) when a<0 ∧ (mod a b)>0 else 0
;   rem  a b = a − b·(quot a b)       [the division identity a = b·q + r]
; Sound when b≠0 (b=0 raises in bl and is uninterpreted in z3 — a crash the
; property tester surfaces, not a false proof). `a`,`b` are already-translated
; SMT strings; the correction re-references them but is side-effect-free.
(defn- smt-quot [a b]
  (str "(+ (div " a " " b ") "
       "(ite (and (< " a " 0) (> (mod " a " " b ") 0)) "
            "(ite (> " b " 0) 1 (- 1)) 0))"))

(defn- smt-rem [a b]
  (str "(- " a " (* " b " " (smt-quot a b) "))"))

(defn- translate-args
  "Translate every child; if any is untranslatable, the whole form is."
  [vars variants nodes]
  (let [ts (map (fn [n] (translate vars variants n)) nodes)]
    (if (some untranslatable? ts) :untranslatable ts)))

(defn translate
  "A reader node → an SMT-LIB string, or :untranslatable.
   `variants` maps an enum keyword tag (a string, e.g. \"open\") to its z3
   CONSTRUCTOR name (e.g. \"Phase-open\"); an empty map ⇒ no enums (Int/Real/
   Bool/String only, unchanged). The 2-arg form is the no-enum default."
  ([vars node] (translate vars {} node))
  ([vars variants node]
   (let [f (typed/node-form node)
         tg (typed/node-tag f)]
     (cond
       ; literals (a :scalar node's form IS the raw value)
       (= tg :scalar)
         (cond (int? f)      (str f)
               (float? f)    (smt-real f)               ; Real theory: 1.5 → "1.5"
               (= f true)    "true"
               (= f false)   "false"
               (string? f)   (str "\"" f "\"")           ; String theory constant
               :else         :untranslatable)

       ; a keyword literal → its z3 constructor. A finite tagged variant is a z3
       ; algebraic datatype; a NULLARY arm :open becomes the sort-prefixed
       ; constructor the caller registered (E_phase-open) — bare `open` collides
       ; across datatypes. A keyword absent from `variants` → untranslatable.
       (= tg :keyword)
         (let [k (typed/node-name f)
               v (get variants k)]
           (cond (nil? v) :untranslatable
                 (map? v) (:ctor v)      ; a payload arm named bare = its 0-ary use is rare; emit ctor
                 :else v))               ; nullary arm: the constructor string

       ; a single-key MAP literal {:on lvl} → a PAYLOAD-arm constructor call
       ; (E_mode-on <lvl>). The key is the tag; its value is the payload arg.
       (= tg :map)
         (let [items (typed/node-items f)]
           (if (not (= 1 (count items)))
             :untranslatable
             (let [pair (first items)
                   k (typed/node-name (typed/node-form (first (erlang/tuple_to_list pair))))
                   vnode (second (erlang/tuple_to_list pair))
                   v (get variants k)]
               (if (and (map? v) (:field v))
                 (let [a (translate vars variants vnode)]
                   (if (untranslatable? a) :untranslatable
                     (str "(" (:ctor v) " " a ")")))
                 :untranslatable))))

       ; a symbol: emit its name (state var or declared input)
       (= tg :symbol)
         (typed/node-name f)

       ; a list: an operator application
       (= tg :list)
         (let [its (typed/node-items f)]
           (if (empty? its)
             :untranslatable
             (let [head (typed/node-form (first its))]
               (cond
                 ; a KEYWORD head applied to a variant field: (:on mode) — the
                 ; PAYLOAD ACCESSOR. Emits the z3 field selector (E_mode-on.val mode).
                 (and (= :keyword (typed/node-tag head)) (= 1 (count (rest its))))
                   (let [k (typed/node-name head)
                         v (get variants k)
                         argsmt (translate vars variants (second its))]
                     (if (and (map? v) (:field v) (not (untranslatable? argsmt)))
                       (str "(" (:field v) " " argsmt ")")
                       :untranslatable))
                 (not (= :symbol (typed/node-tag head)))
                 :untranslatable
                 :else
                 (let [op (typed/node-name head)
                       args (rest its)]
                   (cond
                     ; (some? (:on mode)) / (is? (:on mode)) — the DISCRIMINANT:
                     ; "the :on arm is present" → ((_ is E_mode-on) mode).
                     (and (contains? #{"some?" "is?"} op) (= 1 (count args))
                          (variant-access? variants (first args)))
                       (variant-is-test variants (first args))
                     ; unary desugar: (pos? x) etc — exactly one arg
                     (and (contains? unary-desugar op) (= 1 (count args)))
                       (let [a (translate vars variants (first args))]
                         (if (untranslatable? a) :untranslatable
                           ((get unary-desugar op) a)))
                     ; (if c t e) → z3 (ite c t e): bl's `if` IS z3's ite.
                     (and (= op "if") (= 3 (count args)))
                       (let [ts (translate-args vars variants args)]
                         (if (untranslatable? ts) :untranslatable
                           (str "(ite " (join " " ts) ")")))
                     ; (max a b) → (ite (>= a b) a b); (min a b) → (ite (<= a b) a b).
                     ; The floor/ceiling idiom (max 0 c) relay billing leans on.
                     (and (contains? #{"max" "min"} op) (= 2 (count args)))
                       (let [ts (translate-args vars variants args)]
                         (if (untranslatable? ts) :untranslatable
                           (let [a (first ts) b (second ts)
                                 cmp (if (= op "max") ">=" "<=")]
                             (str "(ite (" cmp " " a " " b ") " a " " b ")"))))
                     ; (quot a b) / (rem a b) → TRUNCATED division reconstructed
                     ; from z3's Euclidean div/mod (see smt-quot/smt-rem). Both
                     ; args translated; either untranslatable ⇒ the whole form is.
                     (and (contains? #{"quot" "rem"} op) (= 2 (count args)))
                       (let [ts (translate-args vars variants args)]
                         (if (untranslatable? ts) :untranslatable
                           (let [a (first ts) b (second ts)]
                             (if (= op "quot") (smt-quot a b) (smt-rem a b)))))
                     ; (nth p <int>) → p_<int>: index a POSITIONAL tuple var. The
                     ; tuple gen declares z3 consts p_0 p_1…; this lets a predicate
                     ; spell them as (nth p 0) so the SAME source also evals in bl.
                     (and (= op "nth") (= 2 (count args))
                          (= :symbol (typed/node-tag (typed/node-form (first args))))
                          (= :scalar (typed/node-tag (typed/node-form (second args))))
                          (int? (typed/node-form (second args))))
                       (str (typed/node-name (typed/node-form (first args)))
                            "_" (typed/node-form (second args)))
                     ; passthrough n-ary ops
                     (contains? passthrough-ops op)
                       (let [ts (translate-args vars variants args)]
                         (if (untranslatable? ts) :untranslatable
                           (str "(" op " " (join " " ts) ")")))
                     ; STRING-theory ops → the SMT str.* operator, args translated
                     (contains? string-ops op)
                       (let [ts (translate-args vars variants args)]
                         (if (untranslatable? ts) :untranslatable
                           (str "(" (get string-ops op) " " (join " " ts) ")")))
                     :else :untranslatable))))))

       :else :untranslatable))))

; ── collection LENGTH abstraction (P18 Rung 3) ───────────────────────────
;
; A collection state var `c` is abstracted to its LENGTH `c_len` (an Int), which
; makes capacity/size invariants decidable integer arithmetic — Rung 1 over a
; derived quantity. The rewrites (sound for length-only reasoning):
;   (count c)   → c_len          (conj c x) → (+ c_len 1)   ; append grows by 1
;   (rest c)    → (- c_len 1)    (pop c)    → (- c_len 1)    ; remove shrinks by 1
;   (empty? c)  → (= c_len 0)    []          → 0             ; empty literal
; A form mentioning the collection's ELEMENTS (not just its length) stays
; untranslatable — content invariants are Rung 3(b), a bounded check, not this.

(declare translate-len)

(defn- len-name [c] (str c "_len"))

(defn- translate-len-args [vars colls nodes]
  (let [ts (map (fn [n] (translate-len vars colls n)) nodes)]
    (if (some untranslatable? ts) :untranslatable ts)))

(defn translate-len
  "Like translate, but each name in `colls` (a set of collection var names) is
   abstracted to its length. count/conj/rest/pop/empty? over a collection var
   become integer arithmetic on <var>_len; the empty-vector literal is 0."
  [vars colls node]
  (let [f (typed/node-form node)
        tg (typed/node-tag f)]
    (cond
      (= tg :scalar)
        (cond (int? f) (str f) (= f true) "true" (= f false) "false" :else :untranslatable)
      ; the empty-vector literal → length 0
      (= tg :vector)
        (if (empty? (typed/node-items f)) "0" :untranslatable)
      (= tg :symbol)
        (let [nm (typed/node-name f)]
          (if (contains? colls nm) (len-name nm) nm))
      (= tg :list)
        (let [its (typed/node-items f)]
          (if (empty? its) :untranslatable
            (let [head (typed/node-form (first its))]
              (if (not (= :symbol (typed/node-tag head))) :untranslatable
                (let [op (typed/node-name head)
                      args (rest its)
                      coll-arg? (fn [n]
                                  (let [ff (typed/node-form n)]
                                    (and (= :symbol (typed/node-tag ff))
                                         (contains? colls (typed/node-name ff)))))]
                  (cond
                    ; (count c) → c_len
                    (and (= op "count") (= 1 (count args)) (coll-arg? (first args)))
                      (len-name (typed/node-name (typed/node-form (first args))))
                    ; (conj c x) → (+ c_len 1)  — one element added
                    (and (= op "conj") (= 2 (count args)) (coll-arg? (first args)))
                      (str "(+ " (len-name (typed/node-name (typed/node-form (first args)))) " 1)")
                    ; (rest c) / (pop c) → (- c_len 1)
                    (and (contains? #{"rest" "pop" "next"} op) (= 1 (count args)) (coll-arg? (first args)))
                      (str "(- " (len-name (typed/node-name (typed/node-form (first args)))) " 1)")
                    ; (empty? c) → (= c_len 0)
                    (and (= op "empty?") (= 1 (count args)) (coll-arg? (first args)))
                      (str "(= " (len-name (typed/node-name (typed/node-form (first args)))) " 0)")
                    (and (contains? unary-desugar op) (= 1 (count args)))
                      (let [a (translate-len vars colls (first args))]
                        (if (untranslatable? a) :untranslatable ((get unary-desugar op) a)))
                    (contains? passthrough-ops op)
                      (let [ts (translate-len-args vars colls args)]
                        (if (untranslatable? ts) :untranslatable
                          (str "(" op " " (join " " ts) ")")))
                    :else :untranslatable))))))
      :else :untranslatable)))

(defn of-source-len
  "translate-len over a source STRING. `colls` is the set of collection var
   names abstracted to length; `vars` the full state-var set."
  [vars colls src]
  (if (nil? src) nil
    (translate-len vars colls (first (BeamLisp.Reader/read_string src)))))

; ── convenience for the seam ────────────────────────────────────────────

(defn translatable?
  "Whether a source string translates cleanly under `vars`."
  [vars src]
  (not (untranslatable? (translate vars (first (BeamLisp.Reader/read_string src))))))

(defn of-source
  "Translate a source STRING (as model.bl stores guards/next) to SMT, or
   :untranslatable. `vars` is a set of state-variable name strings.
   Prefer `of-node` when a clause node is in hand — it skips the re-read."
  [vars src]
  (if (nil? src)
    nil
    (translate vars (first (BeamLisp.Reader/read_string src)))))

(defn of-node
  "Translate a reader NODE (as model.bl now carries on a clause) to SMT, or
   :untranslatable. The direct path: the node is already parsed, so unlike
   of-source there is no delaborate→re-read round-trip to lose fidelity through.
   The 3-arg form threads an enum `variants` map (keyword tag → constructor)."
  ([vars node] (of-node vars {} node))
  ([vars variants node] (if (nil? node) nil (translate vars variants node))))

; ── enum datatype support (R1a) ─────────────────────────────────────────
;
; A field whose value is a keyword is a finite ENUM. Its universe is the set of
; tags it can hold; in z3 that is an algebraic datatype whose constructors are
; the tags. Constructors are SORT-PREFIXED (Phase-open, not open) because a bare
; constructor name collides across datatypes (\"ambiguous constant reference\").

(defn variant-ctor
  "The z3 constructor name for tag `k` in the enum sort named `sort`:
   sort \"E_phase\", k \"open\" → \"E_phase-open\"."
  [sort k]
  (str sort "-" k))

(defn variant-field
  "The z3 accessor (field selector) name for a payload arm `k` of `sort`:
   \"E_mode\", \"on\" → \"E_mode-on.val\"."
  [sort k]
  (str sort "-" k ".val"))

; A variant sort's `arms` is {tag → payload-sort-or-nil}: nil = a NULLARY arm
; (:paused), a sort string = a PAYLOAD arm ({:on Int}). This one shape drives
; both the map the translator reads and the declare-datatypes prelude.

(defn variants-map
  "{tag → entry} for a variant `sort` over `arms` {tag→payload-sort|nil}. A
   nullary arm maps to its constructor STRING; a payload arm to a MAP
   {:ctor :field :sort} the translator uses for constructor/accessor/discriminant."
  [sort arms]
  (into {} (map (fn [pair]
                  (let [k (first pair) psort (second pair)]
                    (if (nil? psort)
                      [k (variant-ctor sort k)]
                      [k {:ctor (variant-ctor sort k)
                          :field (variant-field sort k)
                          :sort psort}])))
                (into [] arms))))

(defn datatype-decl
  "The (declare-datatypes …) prelude line for a variant `sort` over `arms`
   {tag→payload-sort|nil}. A nullary arm is a bare constructor; a payload arm is
   (Ctor (Ctor.val Sort)). All constructors sort-prefixed (no cross-sort clash)."
  [sort arms]
  (str "(declare-datatypes () ((" sort " "
       (join " " (map (fn [pair]
                        (let [k (first pair) psort (second pair)]
                          (if (nil? psort)
                            (variant-ctor sort k)
                            (str "(" (variant-ctor sort k)
                                 " (" (variant-field sort k) " " psort "))"))))
                      (into [] arms)))
       ")))\n"))

(defn of-source-variants
  "of-source with an enum `variants` map (tag string → constructor entry): the
   string-source sibling of the 3-arity of-node. Consumers holding a source
   string — veritas predicates — thread their datatypes through here.
   :untranslatable when any form is outside the vocabulary."
  [vars variants src]
  (if (nil? src) nil
    (translate vars variants (first (BeamLisp.Reader/read_string src)))))

(defn of-node-len
  "translate-len over a reader NODE — the node-direct sibling of of-source-len."
  [vars colls node]
  (if (nil? node) nil (translate-len vars colls node)))

; ── FUNCTIONAL lowering: a defn BODY → an SMT (define-fun …) ────────────────
;
; covers/of-source check predicates OVER inputs — a STRUCTURAL question. To prove
; a law over a function's OUTPUT (∀ x. law(x, (f x))) z3 must know what `f`
; COMPUTES. That is a define-fun whose body is the translated defn body:
;   (defn floor [c] (if (< c 0) 0 c))
;   → (define-fun floor ((c Int)) Int (ite (< c 0) 0 c))
; A multi-clause guarded defn folds to nested ite, last clause = the else arm:
;   (defn sign ([n] :when (pos? n) 1) ([n] :when (neg? n) -1) ([n] 0))
;   → (define-fun sign ((n Int)) Int (ite (> n 0) 1 (ite (< n 0) -1 0)))
; Any untranslatable guard or body ⇒ :untranslatable (never a false definition).

(defn- clause-params
  "The param NAME strings of a parsed clause (its :params node list)."
  [pc]
  (into [] (map (fn [p] (typed/node-name (typed/node-form p))) (:params pc))))

(defn- last-body-node
  "The final body form of a parsed clause — the clause's return expression."
  [pc]
  (last (:body pc)))

(defn- fold-clauses
  "Fold guarded clauses into a nested ite SMT string over `vars`. The LAST clause
   is the else (its guard, if any, ignored — it is the fallthrough); each earlier
   clause contributes (ite <guard> <body> <rest>). :untranslatable if any guard
   or body is."
  [vars clauses]
  (if (empty? (rest clauses))
    ; last clause: just its body (the else arm)
    (of-node vars (last-body-node (first clauses)))
    (let [pc (first clauses)
          g (if (nil? (:guard pc)) "true" (of-node vars (:guard pc)))
          b (of-node vars (last-body-node pc))
          rest-smt (fold-clauses vars (rest clauses))]
      (if (or (untranslatable? g) (untranslatable? b) (untranslatable? rest-smt))
        :untranslatable
        (str "(ite " g " " b " " rest-smt ")")))))

(defn defn->define-fun
  "Lower a defn SOURCE string to an SMT-LIB (define-fun name ((p Sort)…) Ret body)
   over sort `ret-sort` (all params share it — the arithmetic common case). Folds
   guarded clauses to nested ite. :untranslatable when the body leaves the
   fragment. The returned string is a z3 prelude: assert a law over (name …)."
  [defn-src ret-sort]
  (let [node (first (BeamLisp.Reader/read_string defn-src))
        its (typed/node-items (typed/node-form node))
        dc (typed/defn-clauses its)
        name (first dc)
        clauses (nth dc 2)
        params (clause-params (first clauses))
        vars (set params)
        body-smt (fold-clauses vars clauses)]
    (if (untranslatable? body-smt)
      :untranslatable
      (str "(define-fun " name " ("
           (join " " (map (fn [p] (str "(" p " " ret-sort ")")) params))
           ") " ret-sort " " body-smt ")"))))
