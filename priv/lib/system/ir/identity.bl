; Pure IR identity; no analyzer, database, solver or runtime owner dependency.
(ns system.ir.identity)

(defn- walkable? [x]
  (and (map? x) (or (contains? x :op) (contains? x :pats) (contains? x :pop))))

(defn- normalize
  "One traversal, threading the persistent binding map within this process.
   Literal values are opaque even when a quoted map happens to resemble IR."
  [node bindings rename?]
  (cond
    (walkable? node)
    (let [local? (and rename? (or (= :var (:op node)) (= :pvar (:pop node)) (= :let (:op node))))
          original (:name node)
          bindings (if (and local? (not (contains? bindings original)))
                     (assoc bindings original (str "v" (count bindings))) bindings)
          initial (cond-> (dissoc node :ann) local? (assoc :name (get bindings original)))]
      (reduce (fn [[out env] [k v]]
                (if (or (= k :val) (and local? (= k :name)))
                  [out env]
                  (let [[value env] (normalize v env rename?)] [(assoc out k value) env])))
              [initial bindings] initial))

    (or (list? node) (vector? node))
    (let [[items env] (reduce (fn [[out env] x]
                                (let [[value env] (normalize x env rename?)] [(conj out value) env]))
                              [[] bindings] node)]
      [(if (list? node) (apply list items) items) env])

    :else [node bindings]))

(defn strip-ann
  "Remove IR positions through nodes, clauses and patterns, preserving literals."
  [node]
  (first (normalize node {} false)))

(defn body-identity
  "Exact position-free, alpha-normalized IR identity. Hashes are lookup hints;
   reuse and duplicate detection compare this complete identity."
  ([body] (body-identity body {}))
  ([body bindings] (first (normalize body bindings true))))

(defn body-hash [body] (erlang/phash2 (body-identity body)))
