; ir_smells.bl — house smells for code that reads bl-ANF via system.ir.
;
; The engines that read the IR (footprint, termination, prove, and any future
; one) share a small vocabulary of node access. Left unspelled, that vocabulary
; drifts: one author writes (get (:ann n) k), another (get-in n [:ann k]),
; a third reaches into a clause body by hand. These smells name the ONE spelling
; the substrate provides, so `deodorant/scan` flags the drift in review — the
; same mechanism that keeps `(if (not p) …)` from surviving next to `if-not`.
;
; Each is a RULE you can read: pattern => the system.ir call that means it.
; Load this file to extend the registry (defsmell auto-registers); it adds to,
; never replaces, deodorant's built-ins.

(ns system.ir-smells
  (:require [deodorant :as deo]))

; :ann access — the substrate owns get/put, so a raw (get (:ann n) k) or a
; (get-in n [:ann k]) should say (system.ir/ann-get n k). Confined to a keyword
; literal key (the guard), because a computed key is a different, rarer shape.
(deo/defsmell ann-get-raw :idiomatic
  (get (:ann ?n) ?k) => (system.ir/ann-get ?n ?k)
  :when (fn [b] (keyword? (get b '?k))))

(deo/defsmell ann-get-in :idiomatic
  (get-in ?n [:ann ?k]) => (system.ir/ann-get ?n ?k)
  :when (fn [b] (keyword? (get b '?k))))

; :ann write — a hand-rolled (assoc n :ann (assoc (:ann n) k v)) is exactly
; what ann-put does, with the (or (:ann n) {}) nil-guard the substrate carries.
(deo/defsmell ann-put-raw :idiomatic
  (assoc ?n :ann (assoc (:ann ?n) ?k ?v)) => (system.ir/ann-put ?n ?k ?v)
  :when (fn [b] (keyword? (get b '?k))))

; op test — (= :remote (:op n)) is the guard every engine clause opens with;
; system.ir/op names the accessor so the intent reads at a glance. This is a
; DETECT-only convention (no rewrite target that shortens it), so it is tier
; :reinvention — opt-in, surfaced by every-rule, not the default deodorize.
(deo/defsmell op-of :reinvention
  (:op ?n) => (system.ir/op ?n))
