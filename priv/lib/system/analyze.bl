; analyze.bl — the whole-program inter-procedural pass. ONE call graph, ONE
; fixpoint, feeding every engine.
;
; ── What it produces ────────────────────────────────────────────────────
;
; Given a source, analyze builds {fn-name → summary} where each summary
; ({:footprint :terminates :returns :calls}) is computed with EVERY callee's
; summary substituted — the inter-procedural closure of system.summary. A
; caller's footprint now includes its callees' footprints; a caller's return
; type flows from its callees' returns; a higher-order call is resolved through
; the flow facts (0-CFA) so a function reached only through a parameter is still
; in the graph.
;
; ── Why a fixpoint ──────────────────────────────────────────────────────
;
; Summaries are mutually dependent: f's footprint depends on g's, and with
; recursion g's may depend on f's. So we iterate: start every function at the
; empty/bottom summary, recompute all summaries from the current table, repeat
; until nothing changes. Monotonicity (footprints only grow toward
; :opaque-world, tagsets toward `any`) guarantees a fixpoint; a round cap is the
; belt-and-suspenders bound.
;
; ── Soundness ───────────────────────────────────────────────────────────
;
; A function truly reachable only at runtime (chosen by I/O) stays unresolved —
; the flow set for its call site is empty and the call contributes
; :opaque-world / `any`. Sound over-approximation: the graph never MISSES a
; statically-knowable edge and never INVENTS one it cannot justify.

(ns system.analyze
  (:require [system.ir :as ir]
            [system.summary :as summary]
            [system.footprint :as fp]
            [compiler :as c]
            [typed]))

(def rt :Elixir.BeamLisp.Ns.Rt)

; ── extract every function body as ANF ───────────────────────────────────

(defn- headname [form]
  (let [f (typed/node-form form)]
    (if (= :list (typed/node-tag f))
      (let [its (typed/node-items f)]
        (if (and (seq its) (= :symbol (typed/node-tag (typed/node-form (first its)))))
          (typed/node-name (typed/node-form (first its))) nil))
      nil)))

(def top-name
  "The synthetic function a file's top-level forms are analyzed as. Script
   files — examples, tasks, wry handlers — run their meat OUTSIDE any defn;
   without this name every analysis (hover, references, dead-code) is blind
   to exactly the code a script file is made of. Matches the `<top>` caller
   the codebase db and `bl ask` already print."
  "<top>")

(def ^:private top-skip-heads
  "Top-level forms that are declarations, not code: the reader handles them,
   they have no place in the synthetic function's body."
  #{"ns" "require" "defn" "defn-"})

(defn- peeled-clause
  "The clause a compiled `(fn …)` carries — the self scaffold's inner fn, or
   the scaffold in the VARIADIC slot of the `$blfn` dispatch tuple a
   `& rest`-clause fn compiles to. nil when it is neither shape."
  [compiled]
  (cond
    (ir/self-scaffold? compiled)
      (first (:clauses (ir/scaffold-inner compiled)))
    (and (= :tuple (:op compiled))
         (= (erlang/binary_to_atom "$blfn") (:val (first (:elems compiled)))))
      ; {:"$blfn" arity-map {min SCAFFOLD}} — the scaffold is the variadic
      ; slot's second element, and `(a/lit nil)` when there is no variadic
      (let [scaffold (last (:elems (last (:elems compiled))))]
        (when (and (ir/node? scaffold) (ir/self-scaffold? scaffold))
          (first (:clauses (ir/scaffold-inner scaffold)))))))

(defn- top-level-body
  "{:params [] :body anf} for the file's top-level NON-declaration forms,
   compiled as one synthetic 0-arity fn, or nil when there are none (or they
   do not compile — a declaration-only file, or a mid-edit form the compiler
   rejects, must not blind the defns that DO compile)."
  [forms]
  (let [code (filter (fn [form] (not (contains? top-skip-heads (or (headname form) ""))))
                     forms)]
    (when (seq code)
      (try
        (let [fn-form (typed/->tuple
                        [:list (apply list
                                 ;; the RAW forms: their {:meta …} wrappers are
                                 ;; where the compiler reads every hover span from
                                 (concat (list (typed/sym-node "fn")
                                               (typed/->tuple [:vector '()]))
                                         code))])
              compiled (c/compile-node fn-form (c/new-env "an-<top>"))
              clause (peeled-clause compiled)]
          {:params [] :body (:body clause)})
        (catch _e nil)))))

(defn- clause-body
  "Compile one parsed clause `(fn [params] body...)` and peel it back to a
   `{:params [names] :body anf}` - the compiler's own reading, so destructuring,
   guards, docstrings and metadata are exactly the runtime's. THROWS on a peel
   miss: a vacuous body makes every analysis over the fn agree with every other
   and read as 'no violation' (BUG-054)."
  [name c]
  (let [params (:params c)
        body-forms (:body c)
        ; compile a (fn [params] body...) and peel to the clause body
        fn-form (typed/->tuple
                  [:list (apply list
                    (concat (list (typed/sym-node "fn")
                                  (typed/->tuple [:vector (apply list params)]))
                            (if (some? (:guard c)) (list :when (:guard c)) (list))
                            body-forms))])
        compiled (c/compile-node fn-form (c/new-env (str "an-" name)))
        ; a fn compiles to the self scaffold; its inner fn is the clause-bearer
        clause (peeled-clause compiled)]
    (when (or (nil? clause) (nil? (:body clause)))
      (throw (ex-info (str "system.analyze: " name " did not peel to a fn clause - "
                           "the compiled scaffold carries no clause body, so params/body "
                           "would be stored as nil and the analysis over it vacuous")
                      {:fn name :compiled (ir/op compiled)})))
    {:params (map :name (:pats clause))
     :body (if (some? (:guard clause))
             {:op :do :stmts (list (:guard clause) (:body clause))
              :ann (merge (:ann (:guard clause))
                          (select-keys (:ann (:body clause)) ["end-line" "end-col"]))}
             (:body clause))}))

(defn fn-bodies
  "{name -> {:params [names] :body anf :clauses [{:params :body} ...]}} for every
   defn/defn- in src, plus `<top>` for the top-level forms outside any defn.
   EVERY clause of a multi-arity/multi-clause fn is parsed and compiled - a
   later arity's I/O is not dropped - and `analyze` unions the summaries over
   all of them. :body/:params are the FIRST clause, kept for consumers that
   read a single body (system.incr, system.linear)."
  [src]
  (let [forms (BeamLisp.Reader/read_string src)
        defns (reduce
    (fn [m form]
      (if (contains? #{"defn" "defn-"} (headname form))
        (let [items (typed/node-items (typed/node-form form))
              name (typed/node-name (typed/node-form (second items)))
              clauses (into [] (map (fn [c] (clause-body name c))
                                    (nth (typed/defn-clauses items) 2)))]
          (assoc m name {:params (:params (first clauses))
                         :body (:body (first clauses))
                         :clauses clauses}))
        m))
    {} forms)
        top (top-level-body forms)]
    (if (nil? top) defns (assoc defns top-name top))))

(defn- all-bodies
  "Every clause body of `d`: a multi-clause fn's summary is the union over ALL
   of them, and flow facts are gathered from each."
  [d]
  (if (seq (:clauses d)) (map :body (:clauses d)) [(:body d)]))

(defn- params-for
  "The param names of the clause whose arity is `argc` - a multi-arity fn binds
   each clause's own params - else the fn's primary params."
  [d argc]
  (let [cs (:clauses d)
        match (first (filter (fn [c] (= (count (:params c)) argc)) cs))]
    (if (nil? match) (:params d) (:params match))))

(defn- join-summaries
  "Union two clause summaries. footprint joins on the mode lattice; terminates
   is the CONJUNCTION (a fn halts only if every clause halts); returns and calls
   are unions. A missing clause can therefore never read as an absence."
  [a b]
  (cond
    (nil? a) b
    (nil? b) a
    :else {:footprint  (fp/join-fp (:footprint a) (:footprint b))
           :terminates (and (:terminates a) (:terminates b))
           :returns    (into (:returns a) (:returns b))
           :calls      (into (:calls a) (:calls b))}))

(defn- summarize-all
  "Summarize EVERY clause of `d` and union the results, so a later arity's
   calls/effects/termination are part of the fn's summary rather than dropped
   with the first clause. One clause is the degenerate case."
  [known fp-resolve d]
  (reduce (fn [acc b] (join-summaries acc (summary/summarize known fp-resolve b)))
          nil (all-bodies d)))

; ── flow facts: which functions can reach each variable (0-CFA) ──────────
;
; A param bound to a global fn (passed as an argument) flows that fn's name to
; the param. We compute a coarse per-program flow map {var-name → #{fn-names}}
; by scanning every call's actuals against the callee's params.

(defn- atom-fns [defns flow node]
  (cond
    (= :global (:op node)) (if (contains? defns (:name node)) #{(:name node)} #{})
    (= :var (:op node)) (get flow (:name node) #{})
    :else #{}))

(defn- flow-step [defns flow fname node]
  (cond
    (not (ir/node? node)) flow
    (= :let (:op node))
      (let [f1 (flow-step defns flow fname (:init node))
            fv (atom-fns defns f1 (:init node))
            f2 (if (empty? fv) f1 (assoc f1 (:name node) (into (get f1 (:name node) #{}) fv)))]
        (flow-step defns f2 fname (:body node)))
    ; a call — read ONE way via system.ir/call-site, so the callable ABI
    ; (RT.invoke of a cons-packed chain) and a native :apply (args unpacked)
    ; propagate actuals to the callee's params IDENTICALLY; a rewrite that
    ; changes the shape cannot drop the edge. The callee expression is walked
    ; too (a computed callee may itself be a call).
    (ir/call-site node)
      (let [cs (ir/call-site node)
            callee (:callee cs)
            actuals (:args cs)
            f1 (reduce (fn [fl a] (flow-step defns fl fname a)) flow (cons callee actuals))
            targets (atom-fns defns f1 callee)]
        (reduce (fn [fl g]
                  (let [gdef (get defns g)
                        params (params-for gdef (count actuals))]
                    (reduce (fn [ff [p a]]
                              (let [av (atom-fns defns ff a)]
                                (if (empty? av) ff (assoc ff p (into (get ff p #{}) av)))))
                            fl (map (fn [p a] [p a]) params actuals))))
                f1 (into [] targets)))
    :else (reduce (fn [fl ch] (flow-step defns fl fname ch)) flow (ir/child-nodes node))))

(defn- flow-facts [defns]
  (loop [flow {} n 0]
    (let [next (reduce (fn [fl [fname d]]
                         (reduce (fn [f b] (flow-step defns f fname b)) fl (all-bodies d))) flow (into [] defns))]
      (if (or (= next flow) (> n 8)) next (recur next (inc n))))))

; ── the summary fixpoint ─────────────────────────────────────────────────
;
; returns-table : {fn → :returns tagset}. Iterate summarize until stable.
; footprint closure: a caller's footprint joins every resolved callee's.

(defn- resolve-calls
  "Concrete callee fn-names a call key denotes: a bare name is itself; a
   [:flow v] resolves through flow facts; a [mod fun] host op is not a user fn."
  [defns flow k]
  (cond
    (and (erlang/is_binary k) (contains? defns k)) #{k}
    (and (BeamLisp.Ns.Rt/vector? k) (= :flow (first k))) (get flow (second k) #{})
    :else #{}))

(defn analyze
  "Whole-program summaries: {fn-name → {:footprint :terminates :returns :calls
   :edges}} with inter-procedural closure. `src` is source text.

   Each round recomputes every function's summary with two tables from the
   PREVIOUS round substituted: `returns` (callee return tagsets) and `fps`
   (callee footprints, via a resolver passed to system.footprint). A caller's
   footprint therefore GROWS to include its callees' resources; recursion reads
   the in-progress footprint and converges monotonically. Iterates to a fixpoint
   (a round cap bounds pathological cases).

   Every clause of a multi-arity defn is summarized and UNIONED, so a later
   arity's calls/effects/termination are never dropped with the first clause."
  [src]
  (let [defns (fn-bodies src)
        flow (flow-facts defns)
        names (into [] (map first defns))]
    (loop [returns {} fps {} n 0]
      ; a footprint resolver over the PREVIOUS round's fps: a resolved user call
      ; contributes its callee's known footprint; an unresolved one stays opaque.
      (let [fp-resolve (fn [callee-name]
                         (if (contains? fps callee-name) (get fps callee-name) :unknown))
            locals (reduce (fn [m [name d]]
                             (assoc m name (summarize-all returns fp-resolve d)))
                           {} (into [] defns))
            returns2 (reduce (fn [m name] (assoc m name (:returns (get locals name)))) {} names)
            fps2 (reduce (fn [m name] (assoc m name (:footprint (get locals name)))) {} names)]
        (if (or (and (= returns2 returns) (= fps2 fps)) (> n 12))
          ; final table: local summary + resolved call edges
          (reduce (fn [m name]
                    (let [loc (get locals name)
                          resolved (reduce (fn [s k] (into s (resolve-calls defns flow k)))
                                           #{} (into [] (:calls loc)))]
                      (assoc m name (assoc loc :edges resolved))))
                  {} names)
          (recur returns2 fps2 (inc n)))))))

; ── the call/flow graph (for reachability / dead-code / impact) ──────────

(defn call-graph
  "{caller → #{callee fn-names}} — the resolved inter-procedural edges,
   including higher-order calls. A function reachable only through a parameter
   IS an edge here."
  [summaries]
  (reduce (fn [m [name s]] (assoc m name (:edges s))) {} (into [] summaries)))

(defn reachable
  "Every fn-name reachable from `roots` through the call graph (transitive)."
  [summaries roots]
  (let [g (call-graph summaries)]
    (loop [seen (set roots) frontier (into [] roots)]
      (if (empty? frontier)
        seen
        (let [n (first frontier)
              nexts (filter (fn [x] (not (contains? seen x))) (into [] (get g n #{})))]
          (recur (into seen nexts) (concat (rest frontier) nexts)))))))

(defn dead-fns
  "Functions never reached from `roots` — sound dead code, including through
   higher-order calls (a fn used only as a callback is correctly LIVE)."
  [summaries roots]
  (let [live (reachable summaries roots)]
    (filter (fn [name] (not (contains? live name)))
            (into [] (map first (into [] summaries))))))
