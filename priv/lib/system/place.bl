; system/place.bl — WHERE a piece of a program may run: here (any host, e.g.
; the browser, through the JS target) or only on the BEAM, and WHY.
;
; One rule, from the whole-program analysis (system.analyze): a function is
; PORTABLE when it is pure (footprint {}), the function values it makes are
; pure (latent {}), and it provably terminates. Anything else stays on the
; BEAM, with the reason named — the analyzer's own facts, not a guess:
;
;   {:place :local}                                  runs anywhere
;   {:place :beam :why {:reason :effect :detail "footprint {:io :W}" :via "slurp-it"}}
;
; A reason is attributed to the function that HAS it: a caller of an impure
; function is :beam because of its callee (`:via`), so a refusal names the one
; definition to look at.
;
; Callers: the split gate (research/js-actors/compiler.bl, apps) and bl-ed's
; per-cell placement (ed: local cells evaluate in the page).

(ns system.place
  (:require [system.analyze :as an]))

(defn pure?
  "The portability rule over one summary."
  [s]
  (and (some? s) (= {} (:footprint s)) (= {} (or (:latent s) {})) (= true (:terminates s))))

(defn reason
  "Why `name` is not portable, from its own summary: nil when it is."
  [s]
  (cond
    (nil? s) {:reason :not-analyzed :detail "the analyzer produced no summary"}
    (pure? s) nil
    (not (= true (:terminates s))) {:reason :may-not-terminate :detail "termination is not proven"}
    (not (= {} (:footprint s))) {:reason :effect :detail (str "footprint " (pr-str (:footprint s)))}
    :else {:reason :effectful-value
           :detail (str "a function value it creates or names has footprint " (pr-str (:latent s)))}))

(defn- local-callees [summaries name]
  (filter (fn [c] (and (string? c) (not= c name) (contains? summaries c))) (:calls (get summaries name))))

(defn placements
  "{fn-name → {:place :local|:beam :why …}} for every function of `src`
   (source text), from ONE whole-program analysis. An impure function whose
   impurity is inherited names the callee it comes through (`:via`)."
  [src]
  (let [summaries (an/analyze src)
        own (reduce (fn [m [n s]] (assoc m n (reason s))) {} summaries)]
    (reduce
      (fn [m [n s]]
        (let [r (get own n)]
          (assoc m n
            (cond
              (pure? s) {:place :local}
              (some? r)
                (let [bad (first (filter (fn [c] (not (pure? (get summaries c)))) (local-callees summaries n)))]
                  (if (and (some? bad) (= (:reason r) (:reason (get own bad))))
                    {:place :beam :why (assoc r :via bad)}
                    {:place :beam :why r}))))))
      {} summaries)))

; ── cells (a livebook's units) ──────────────────────────────────────────────────────
;
; A cell is local when everything it RUNS is portable: each top-level form of
; the cell is analyzed as a function body of its own (`(defn __cell_N_k [] form)`)
; inside the whole document's program, so a cell's expression that calls
; another cell's defn inherits that defn's placement. `defn`/`def` forms are
; what they define; an `ns` form is setup and never forces :beam.

(defn- head-of [form-src]
  (let [t (trim form-src)]
    (when (starts-with? t "(")
      (first (filter (fn [s] (not (blank? s))) (split (subs t 1) " "))))))

(defn- def-name [form-src]
  (let [toks (filter (fn [s] (not (blank? s))) (split (trim form-src) " "))]
    (when (>= (count toks) 2) (let [n (second toks)] (if (ends-with? n ")") (subs n 0 (dec (count n))) n)))))

(defn cell-placements
  "{cell-id → {:place :local|:beam :why …}} for `cells` — [{:id :forms
   [form-src …]}] in document order — by one analysis of the whole program."
  [cells]
  (let [probe (fn [i k] (str "__cell_" i "_" k))
        program (join "\n"
                  (for [[i c] (map-indexed (fn [i c] [i c]) cells)
                        [k f] (map-indexed (fn [k f] [k f]) (:forms c))]
                    (let [h (head-of f)]
                      (cond
                        (contains? #{"defn" "defn-" "defmacro"} h) f
                        ; a def becomes a zero-arity defn of its init under its
                        ; own name (`(def x v)` → `(defn x [] v)`, the same text
                        ; with `defn` and `[]`): the analyzer knows defns, so
                        ; the value's placement is that defn's
                        (= "def" h) (let [tt (trim f)
                                          after (subs tt 5)
                                          nm (def-name f)
                                          rest-src (subs after (+ (index-of after nm) (count nm)))]
                                      (str "(defn " nm " [] " rest-src))
                        (= "ns" h) ""
                        :else (str "(defn " (probe i k) " [] " f ")")))))
        ps (placements program)
        name-of (fn [i k f] (let [h (head-of f)]
                              (cond (contains? #{"defn" "defn-" "def"} h) (def-name f)
                                    (contains? #{"ns" "defmacro"} h) nil
                                    :else (probe i k))))]
    (reduce
      (fn [m [i c]]
        (let [names (keep (fn [[k f]] (name-of i k f)) (map-indexed (fn [k f] [k f]) (:forms c)))
              beam (first (keep (fn [n] (let [p (get ps n)] (when (= :beam (:place p)) [n p]))) names))]
          (assoc m (:id c)
            (if (nil? beam)
              {:place :local}
              (let [[n p] beam]
                {:place :beam
                 :why (assoc (:why p) :form (if (starts-with? n "__cell_") "an expression" n))})))))
      {} (map-indexed (fn [i c] [i c]) cells))))

