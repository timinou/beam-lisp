; summary.bl — a function's SUMMARY: everything the engines need to know about
; it in order to reason about its CALLERS.
;
; ── Why summaries ───────────────────────────────────────────────────────
;
; Every "meaning" engine hits the same wall at a call to another function.
; footprint says :opaque-world, termination cannot see through it, a type
; checker calls the result `any`. They fail identically for one reason: none
; has a description of what the callee DOES. A summary is that description,
; computed once per function from its bl-ANF body:
;
;   {:footprint  {resource → mode}   ; what state it touches (system.footprint)
;    :terminates bool                 ; does every loop in it halt
;    :returns    #{tags}              ; the tagset its value can take
;    :calls      #{callee-keys}}      ; who it calls (resolved, incl. higher-order)
;
; system.analyze propagates these across the call graph to a fixpoint, so a
; caller reads a callee's summary instead of giving up. This module computes ONE
; function's summary given the summaries known so far — the per-node step the
; fixpoint iterates.

(ns system.summary
  (:require [system.ir :as ir]
            [system.footprint :as fp]
            [termination :as term]))

(def rt   :Elixir.BeamLisp.Ns.Rt)
(def core :Elixir.BeamLisp.Ns.Core)

(declare terminates?)

; ── resolved callees (the CFA-ready call set) ────────────────────────────
;
; A user call compiles to RT/invoke of a (:global g). A direct host op is a
; :remote [mod fun]. We record BOTH, keyed uniformly: a user call as the global
; name string, a host op as [mod fun]. Higher-order calls through a :var are
; recorded as [:flow varname] — system.analyze resolves those against the flow
; facts; on their own they stay unresolved (honest).

(defn- callee-key
  "The callee a canonical call site names: a resolved host op as [mod fun],
   a user global by its name, a higher-order value as [:flow varname], else nil."
  [cs]
  (if (= :remote (:mode cs)) [(:mod cs) (:fun cs)]
    (let [c (:callee cs)]
      (cond
        (= :global (:op c)) (ir/global-key c)
        (= :var (:op c))    [:flow (:name c)]
        :else nil))))

(declare calls-in)

(defn- calls-all [nodes]
  (reduce (fn [s n] (into s (calls-in n))) #{} nodes))

(defn calls-in
  "The set of callee keys invoked anywhere under `n`: a user call yields its
   name, a host op yields [mod fun], a higher-order call yields [:flow v].
   Read through system.ir/call-site, so a call is the SAME call whether the
   compiler emitted the callable ABI (RT.invoke of a cons-packed chain) or a
   direct-call rewrite emitted a native :apply (args already unpacked) — the
   callee and argument nodes are read identically in both. The compiled
   loop/recur/scaffold :apply control forms are not calls and are skipped."
  [n]
  (if-not (ir/node? n) #{}
    (let [cs (ir/call-site n)]
      (if (nil? cs)
        (calls-all (ir/child-nodes n))
        (let [k (callee-key cs)]
          (into (if (nil? k) #{} #{k}) (calls-all (cons (:callee cs) (:args cs)))))))))

; ── return tagset over ANF ────────────────────────────────────────────────
;
; A conservative, sound tag inference: a literal's tag is exact; an `if`/`case`
; is the union of its branches; a call's return is looked up in `known` (the
; summaries so far) — unknown ⇒ `any`. This is the inter-procedural return flow:
; once a callee's :returns is known, its call sites inherit it.

(def all-tags #{:int :float :kw :string :bool :map :vec :set :fn :nil :sym :seq :list :js-object :js-array :undefined})

(defn- lit-tag [v]
  (cond
    (erlang/is_integer v) :int
    (erlang/is_float v) :float
    (erlang/is_binary v) :string
    (or (= v true) (= v false)) :bool
    (nil? v) :nil
    (keyword? v) :kw
    (erlang/is_atom v) :sym
    (map? v) :map
    (BeamLisp.Ns.Rt/vector? v) :vec
    :else nil))

; host ops with a known scalar result tag — enough to catch the classic
; arithmetic-on-nonnumber inter-procedural bug. Extended as needed; unknown host
; ops fall to `any` (sound).
(def host-return
  {[:erlang :+] #{:int :float} [:erlang :-] #{:int :float}
   [:erlang :*] #{:int :float} [:erlang :div] #{:int}
   [:erlang :>] #{:bool} [:erlang :<] #{:bool} [:erlang :>=] #{:bool}
   [:erlang :=<] #{:bool} [:erlang :==] #{:bool} [:erlang :=:=] #{:bool}})

(declare returns)

(defn returns-tag
  "The tagset the value of ANF node `n` can take, given `known` {fn-name →
   :returns}. Public entry for consumers (system.typecheck) that need a single
   node's inferred return type. Sound: unresolved shapes yield the full tagset."
  [known n]
  (returns known n))

(defn- returns [known n]
 (let [budget (atom 100000)]
  (letfn [(join [a b] (into a b))
          (walk [n locals loops]
           (if (or (neg? (swap! budget dec)) (not (ir/node? n))) all-tags
            (cond
             (= :lit (:op n)) (let [tag (lit-tag (:val n))] (if tag #{tag} all-tags))
             (= :var (:op n)) (get locals (:name n) all-tags)
             (= :js (:op n)) (case (:kind n) :array #{:js-array} :object #{:js-object} :undefined? #{:bool} all-tags)
             (= :enil (:op n)) #{:nil}
             (= :if (:op n)) (join (walk (:then n) locals loops) (walk (:else n) locals loops))
             (= :do (:op n)) (if (empty? (:stmts n)) #{:nil}
                              (last (mapv #(walk % locals loops) (:stmts n))))
             (ir/self-scaffold? n) #{:fn}
             (= :fn (:op n)) #{:fn}
             (= :let (:op n)) (walk (:body n) (assoc locals (:name n) (walk (:init n) locals loops)) loops)
             (= :case (:op n))
              (let [subject (walk (:subj n) locals loops)]
               (reduce (fn [tags clause]
                         ;; A plain pattern variable receives the subject. More
                         ;; elaborate patterns remain unknown, including names
                         ;; that shadow an outer lexical binding.
                         (let [bound (reduce #(assoc %1 %2 all-tags) locals (ir/clause-pattern-vars clause))
                               pats (:pats clause)
                               bound (if (and (= 1 (count pats)) (= :pvar (:pop (first pats))))
                                       (assoc bound (:name (first pats)) subject) bound)]
                          (join tags (walk (:body clause) bound loops)))) #{} (:clauses n)))
             (ir/anf-loop? n)
              (let [{:keys [self vars body inits]} (ir/loop-parts n)
                    initial (mapv #(walk % locals loops) inits)
                    backedges (atom initial)
                    nested (assoc loops self backedges)]
               (loop [values initial round 0]
                (let [environment (into locals (map (fn [name tags] [name tags]) vars values))
                      result (walk body environment nested)
                      next (mapv join values @backedges)]
                 (cond
                  (= values next) result
                  (>= round 16)
                   ;; Widen the complete loop environment before reading exits.
                   ;; A partial fixpoint must never authorize native execution.
                   (walk body (into locals (map #(vector % all-tags) vars)) nested)
                  :else (recur next (inc round))))))
             (ir/recur? n)
              (if-let [edge (get loops (:name (:fn (:fn n))))]
               (do (swap! edge #(mapv join % (mapv (fn [arg] (walk arg locals loops)) (ir/recur-vals n)))) #{})
               all-tags)
             (contains? #{:invoke :apply} (get (ir/call-site n) :mode))
              (let [callee (:callee (ir/call-site n))]
               (if (= :global (:op callee)) (get known (ir/global-key callee) all-tags) all-tags))
             (contains? #{:arith :remote} (:op n))
              (let [target (if (= :arith (:op n)) [:erlang (:bif n)] [(:mod n) (:fun n)])
                    args (mapv #(walk % locals loops) (:args n))]
               (cond
                (= [:binary :at] target) #{:int}
                (and (contains? #{[:erlang :+] [:erlang :-] [:erlang :*]} target)
                     (every? #(= #{:int} %) args)) #{:int}
                :else (get host-return target all-tags)))
             :else all-tags)))]
   (let [result (walk n {} {})]
    (if (neg? @budget) all-tags result)))))

; ── the summary of one function ───────────────────────────────────────────

(defn summarize
  "Summarize function body `anf-body`. `known` {fn-name → :returns} flows callee
   return types; `fp-resolve` (name→footprint|:unknown) closes footprints over
   resolved callees. Both default to knowing nothing — the honest single-function
   answer. system.analyze passes tables that make the summary inter-procedural."
  ([known anf-body] (summarize known fp/no-resolver anf-body))
  ([known fp-resolve anf-body]
   {:footprint  (fp/fp-anf ir/empty-aliases fp-resolve anf-body)
    :terminates (terminates? anf-body)
    :returns    (returns known anf-body)
    :calls      (calls-in anf-body)}))

(defn- terminates? [n]
  (cond
    (= :js (:op n)) false
    (not (ir/node? n)) true
    (ir/anf-loop? n) (and (= :accepted (:status (term/check-anf-loop n)))
                          (every? terminates? (ir/child-nodes n)))
    :else (every? terminates? (ir/child-nodes n))))
