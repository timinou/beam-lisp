;; One conservative evidence contract for publication-time consumers. Runtime
;; state/version/identity checks are separate obligations, never hidden in pure?.
(ns system.evidence
  (:require [system.incr :as incr] [system.footprint :as fp] [system.smt :as smt]
            [data.bounded-cache :as cache]))

(def VERSION 1)
(defn classify [s]
  (let [f (:footprint s)
        conditional (or (:conditional-effects s)
                        (some (fn [k] (and (vector? k) (= :flow (first k)))) (:calls s)))
        read-only (and (map? f) (fp/pure? f))
        independent (and read-only (empty? f) (empty? (:latent s)) (not conditional))
        sort (smt/sort-of-tags (:returns s))]
    {:version VERSION :summary s :read-only (boolean read-only) :state-independent (boolean independent)
     :conditional (boolean conditional) :terminates (:terminates s) :return-sort sort
     :native-candidate (boolean (and independent (:terminates s) (not= :unknown sort)))
     :reuse (cond (or (not read-only) conditional (seq (:latent s))) :refused
                  (empty? f) :value-candidate :else :versioned-candidate)}))

(defn generation []
  (let [analysis (incr/evidence-generation)
        consumer (try (BeamLisp.Env/namespace_generations (list "system.evidence" "system.smt")) (catch _ nil))]
    (when (and analysis consumer) [analysis consumer])))

(defn- publish-once
  "Incremental program evidence with stable analysis/consumer provenance.
   Opaque and conditional effects remain explicit refusal, even for a closed
   source call graph. No solver is run. Consumers must verify :admitted."
  [previous src]
  (let [before (generation) result (incr/analyze-program previous src)
        functions (into {} (map (fn [[n s]] [n (classify s)]) (:summaries result)))
        admitted (and before (:stable? result) (= before (generation)))]
    {:version VERSION :generation before :admitted (boolean admitted)
     :functions functions :analysis result}))

(defn publish
  "Retry cold dependency loading with fresh analysis; never relabel stale facts."
  [previous src]
  (loop [attempt 0 prior previous]
    (let [p (publish-once prior src)]
      (if (or (:admitted p) (>= attempt 2)) p
        (recur (inc attempt) {})))))

(defn- retained-publication [src]
  (let [p (publish {} src)]
    ;; Incremental caches carry live compiler-generation references. Tooling
    ;; retention needs verdicts, not that compiler state. Typed provenance
    ;; preserves exact identity without retaining a resource-bearing term.
    (assoc p :generation (cache/key-data (:generation p) 0)
             :analysis (dissoc (:analysis p) :cache))))

(defn source
  "Automatically retain finite verdicts; opaque retention falls back to analysis."
  [src]
  (cache/ready! :system.evidence)
  (if-let [g (generation)]
    (let [stamp (cache/key-data g 0)
          result (cache/value :system.evidence src g (fn [] (retained-publication src)))]
      (if (and (:admitted result) (= stamp (:generation result))
               (= stamp (cache/key-data (generation) 0))) result
        (retained-publication src)))
    (retained-publication src)))
