; typecheck.bl — inter-procedural type checking over the call graph.
;
; ── What it adds ────────────────────────────────────────────────────────
;
; The single-function type checker (typed.bl) treats every callee's result as
; `any`, so a type error that only appears ACROSS a call is invisible:
;
;     (defn mk [] :a-keyword)
;     (defn use-it [] (erlang/+ 1 (mk)))   ; + on a keyword — but mk's return
;                                          ; is `any` to a local checker
;
; This checker reads system.analyze's summaries, where mk's :returns is #{:kw},
; and flows that into the argument position of erlang:+ — whose arguments must
; be numeric. The disjoint meet (#{:kw} ∩ #{:int :float} = ∅) is the warning.
;
; It is ADDITIVE: typed.bl keeps its position-precise, single-function evidence
; and hover untouched. This pass answers a different question (cross-call value
; flow) and reports through the SAME :ann positions, so its warnings render with
; the same carets.

(ns system.typecheck
  (:require [system.ir :as ir]
            [system.summary :as summary]
            [system.analyze :as analyze]
            ; clauses-of: the canonical reading of a fn-bodies entry — every
            ; clause, so a later arity is inspected rather than dropped
            [system.incr :as incr]
            [errors]))

(def rt :Elixir.BeamLisp.Ns.Rt)

; host ops whose arguments carry a type constraint: [mod fun] → required tagset.
; Only the ops where a wrong type is a genuine error; extended as needed.
(def arg-constraint
  {[:erlang :+] #{:int :float} [:erlang :-] #{:int :float}
   [:erlang :*] #{:int :float} [:erlang :div] #{:int} [:erlang :rem] #{:int}})

(defn- disjoint? [need got]
  ; got ⊆ any is fine; a warning only when the two sets cannot overlap AND got
  ; is a concrete (non-universal) set — an unknown `any` argument stays silent.
  (and (not (empty? got))
       (empty? (filter (fn [t] (contains? need t)) (into [] got)))))

(defn- check-node
  "Warnings for host-op type violations under `n`, given `known` return tags.
   Each warning is a DIAGNOSTIC (diag.bl) carrying the ARG node's :ann
   {:line :col :end-line :end-col :file} — so it points at the offending
   argument. `:kind :type-mismatch`, the same kind the single-function checker
   uses for a disjoint argument, because a consumer dispatches on the kind and
   not on which pass found it."
  [known n]
  (cond
    (not (ir/node? n)) (list)
    (= :remote (:op n))
      (let [k [(:mod n) (:fun n)]
            need (get arg-constraint k)
            here (if (nil? need)
                   (list)
                   (reduce (fn [acc arg]
                             (let [got (summary/returns-tag known arg)]
                               (if (disjoint? need got)
                                 (let [w (errors/node->warning :type-mismatch arg
                                           (str "type error: " (:fun n) " expects "
                                                (pr-str (into [] need)) ", got "
                                                (pr-str (into [] got))))]
                                   (if (nil? w) acc (cons w acc)))
                                 acc)))
                           (list) (:args n)))]
        (concat here (mapcat (fn [c] (check-node known c)) (ir/child-nodes n))))
    :else (mapcat (fn [c] (check-node known c)) (ir/child-nodes n))))

(defn- bodies-of
  "Every body of a fn-bodies entry `d` — ALL clauses of a multi-arity fn, or the
   one body a legacy single-body map carries. A later arity is inspected, never
   dropped; first-body maps stay accepted."
  [d]
  (map :body (incr/clauses-of d)))

(defn check-source*
  "Inter-procedural type warnings over tables the caller already computed:
   `known` = {fn → :returns tagset}, `bodies` = {fn → fn-bodies entry}. EVERY
   clause of a multi-arity fn is checked, so a type error in a later arity is
   reported instead of being read as a clean first body; a legacy
   `{fn → {:body anf}}` map still checks its one body. A caller that HOLDS the
   whole-program analysis (the language server, via lsp/analyzed) checks without
   analyzing a second time; `check-source` is this over a fresh analysis — the
   two must stay in step, which the lsp suite asserts."
  [known bodies]
  (mapcat (fn [[name d]] (mapcat (fn [b] (check-node known b)) (bodies-of d)))
          (into [] bodies)))

(defn check-source
  "Inter-procedural type warnings for `src`. Uses whole-program summaries so a
   callee's return type flows into its call sites. Returns a list of warning
   maps (render with errors/render)."
  [src]
  (let [summaries (analyze/analyze src)
        known (reduce (fn [m [name s]] (assoc m name (:returns s))) {} (into [] summaries))]
    (check-source* known (analyze/fn-bodies src))))
