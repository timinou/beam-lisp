; incr.bl — content-addressed incremental proofs.
;
; ── The idea ─────────────────────────────────────────────────────────────
;
; A function's summary (footprint, termination, return type) is a PURE FUNCTION
; of its ANF structure. So it is content-addressable: hash the normalized body,
; and an unchanged body reuses its cached summary instead of re-proving. After
; an edit, only the functions whose STRUCTURE changed re-analyze — the rest are
; cache hits. On a large file this turns "re-prove everything on every keystroke"
; into "re-prove the one function you touched."
;
; The hash must be over STRUCTURE, not source text: renaming a local, adding a
; comment, or reindenting must NOT invalidate a summary (the proof is the same).
; The ANF is already normalized (positions live in :ann, which we strip for the
; hash), so hashing the :ann-free node tree gives exactly that.

(ns system.incr
  (:require [system.ir :as ir]
            [system.analyze :as analyze]
            [system.footprint :as fp]
            [system.summary :as summary]))

; ── structural hash: :ann-free AND alpha-normalized ──────────────────────
;
; The compiler gensyms every bound variable (a param `z` becomes `z_2` in one
; compile, `z_7` in another), so two identical bodies get different var names.
; A structural hash must be ALPHA-INVARIANT: canonicalize each :var/:global
; name to the ORDER it is first seen (`v0`, `v1`, …). Then a body hashes the
; same across compiles, and only a real structural change misses.

;; A node, a clause `{:pats :guard :body}`, or a pattern `{:pop …}` — the three
;; map shapes the IR is built from. A pattern's :pvar binds a name the body
;; then reads as a :var, so patterns take part in alpha-renaming too.
(defn- walkable? [x]
  (and (map? x) (or (contains? x :op) (contains? x :pats) (contains? x :pop))))

(defn- alpha-rename
  "Rewrite every BOUND :var name in `node` to a canonical `vN` by first
   -occurrence order, using `env` {orig → canon} threaded via an atom. A
   :global (a free callee reference) keeps its name — `double` vs `triple`
   must not collide. Positions already stripped; this makes the tree
   rename-invariant for locals."
  [env node]
  (if (not (walkable? node))
    node
    ; every BINDING and USE of a local: a :var read, a :pvar pattern, a :let's
    ; binder. A :global is a free callee name that MUST stay.
    (let [n (if (or (= :var (:op node)) (= :pvar (:pop node)) (= :let (:op node)))
              (let [orig (:name node)
                    e (deref env)
                    canon (if (contains? e orig)
                            (get e orig)
                            (let [c (str "v" (count e))]
                              (swap! env assoc orig c) c))]
                (assoc node :name canon))
              node)]
      (reduce (fn [m k]
                (let [v (get m k)]
                  (assoc m k
                    (cond
                      (walkable? v) (alpha-rename env v)
                      (list? v) (apply list (map (fn [x] (if (walkable? x) (alpha-rename env x) x)) v))
                      (vector? v) (into [] (map (fn [x] (if (walkable? x) (alpha-rename env x) x)) v))
                      :else v))))
              n (keys n)))))

(defn strip-ann
  "`node` with :ann removed everywhere — the pure structure. Two bodies that
   differ only in position/comments/whitespace strip to the SAME tree, so they
   share a summary. Recurses through child nodes AND clause/pattern maps
   (a :fn's clauses are `{:pats :guard :body}`, not nodes, but their bodies
   are — skipping them left positions inside every fn and made two
   identical closures hash differently)."
  [node]
  (if (not (walkable? node))
    node
    (let [without (dissoc node :ann)]
      (reduce (fn [m k]
                (let [v (get m k)]
                  (assoc m k
                    (cond
                      (walkable? v) (strip-ann v)
                      (list? v) (apply list (map (fn [x] (if (walkable? x) (strip-ann x) x)) v))
                      (vector? v) (into [] (map (fn [x] (if (walkable? x) (strip-ann x) x)) v))
                      :else v))))
              without (keys without)))))

(defn body-hash
  "A content hash of a fn body's STRUCTURE, position- AND rename-independent.
   Same normalized proof ⇒ same hash; hits still require full identity equality. Two bodies that differ only in
   whitespace, comments, or gensym'd variable names hash identically."
  [body]
  (erlang/phash2 (alpha-rename (atom {}) (strip-ann body))))

; ── every clause, not just the first ─────────────────────────────────────
;
; `analyze/fn-bodies` hands back `{:params :body :clauses [{:params :body} …]}`.
; A multi-arity/multi-clause defn summarises over ALL its clauses, so its cache
; key must too: hashing only the first body would let an edit in a later arity
; reuse a stale summary. `<top>` and legacy first-body maps carry no :clauses;
; they normalise to the one clause they hold, so external first-body input
; stays accepted.

(defn clauses-of
  "Every `{:params :body}` clause of a fn-bodies entry `d`, in order. A
   single-body entry (`<top>`, a legacy `{:params :body}` map) yields the one
   clause it carries."
  [d]
  (if (seq (:clauses d)) (:clauses d) [{:params (:params d) :body (:body d)}]))

(defn fn-identity
  "Normalized identity of a fn-bodies entry `d`: EVERY clause's body, with its
   arity, in order. A `body-hash` over the first clause alone misses an edit in
   a later arity — the stale summary would be reused over a changed body — and
   omits the arity, so a later clause could be conflated with an earlier one."
  [d]
  (into []
      (map (fn [c]
             ; Bind canonical parameter identities BEFORE walking uses. First-use
             ; renaming alone conflates (f [a b] a) with (f [a b] b).
             (let [bindings (into {} (map-indexed (fn [i p] [p (str "p" i)]) (:params c)))]
               [(count (:params c))
                (alpha-rename (atom bindings) (strip-ann (:body c)))]))
           (clauses-of d))))

(defn fn-hash
  "A lookup hint for normalized structure; hash equality is NEVER authority."
  [d]
  (erlang/phash2 (fn-identity d)))

(defn evidence-generation []
  (try (BeamLisp.Env/namespace_generations
         (list "core" "sugar" "rt" "compiler" "body" "anf" "lower" "reader"
               "typed" "system.ir" "system.summary" "system.footprint"
               "system.analyze" "system.incr" "termination"))
       (catch _ nil)))

(defn- flow-names [d]
  ;; Alpha-equivalent summaries may contain concrete [:flow var] keys. Those
  ;; keys can only be reused with the same binding names, not a renamed IR.
  (into #{} (filter (fn [k] (and (vector? k) (= :flow (first k))))
                    (mapcat (fn [cl] (summary/calls-in (:body cl))) (clauses-of d)))))

(defn- join-summaries
  "Union two clause summaries, the same join system.analyze performs for a
   multi-clause fn: footprint joins on the mode lattice; terminates is the
   CONJUNCTION (a fn halts only if every clause halts); returns and calls are
   unions — a later clause can never read as an absence."
  [a b]
  (cond
    (nil? a) b
    (nil? b) a
    :else {:footprint  (fp/join-fp (:footprint a) (:footprint b))
           :terminates (and (:terminates a) (:terminates b))
           :returns    (into (:returns a) (:returns b))
           :calls      (into (:calls a) (:calls b))}))

(defn- summarize-fn
  "The fn's summary as the union over ALL its clauses — the reading
   system.analyze makes, so a multi-arity fn's cached summary covers every
   arity."
  [known fp-resolve d]
  (reduce (fn [acc c] (join-summaries acc (summary/summarize known fp-resolve (:body c))))
          nil (clauses-of d)))

; ── the incremental analyzer ──────────────────────────────────────────────
;
; A cache is {fn-name → {:hash h :identity identity :flow-names flows :generation generation :summary s}}. `analyze-incremental` takes the
; previous cache and new source; for each fn it hashes the body and reuses the
; cached summary on a hit, recomputing only on a miss. It returns the new
; summaries AND a report of which fns were hits vs misses — the proof that an
; edit only re-proves what changed.

(defn analyze-incremental
  "Re-analyze `src` reusing `cache` {fn-name → {:hash :summary}} for unchanged
   bodies. Returns {:summaries … :cache … :hits [names] :misses [names]}.

   NB: this prototype recomputes each fn's LOCAL summary on a miss (footprint/
   terminates/returns from its own body). The inter-procedural closure still
   needs a fixpoint over misses' callers — the honest extension is to
   invalidate a fn's dependents transitively; here we show the per-fn caching
   that makes that fixpoint cheap."
  [cache src]
  (let [bodies (analyze/fn-bodies src)
        known {} generation (evidence-generation)]
    (reduce
      (fn [acc [name d]]
        (let [identity (fn-identity d) h (erlang/phash2 identity)
              flows (flow-names d) cached (get cache name)]
          (if (and generation cached (= (:hash cached) h)
                   (= (:identity cached) identity) (= (:flow-names cached) flows)
                   (= (:generation cached) generation))
            ; cache hit — reuse the summary, no proof work
            (-> acc
                (assoc-in [:summaries name] (:summary cached))
                (assoc-in [:cache name] cached)
                (update :hits conj name))
            ; miss — recompute this fn's summary
            (let [s (summarize-fn known fp/no-resolver d)]
              (-> acc
                  (assoc-in [:summaries name] s)
                  (assoc-in [:cache name] {:hash h :identity identity :flow-names flows
                                          :generation generation :summary s})
                  (update :misses conj name))))))
      {:summaries {} :cache {} :hits [] :misses []}
      (into [] bodies))))

; ── transitive invalidation ──────────────────────────────────────
;
; A per-fn hash tells us which BODIES changed. But a summary is inter
; -procedural: if `b`'s return type or footprint changed, every function that
; CALLS b (transitively) may have a stale summary too. The reverse call graph
; gives those dependents; the dirty set is the changed fns plus their transitive
; callers, and only that set needs re-proving in the fixpoint. Everything else
; is a genuine cache hit.

(defn reverse-graph
  "{callee → #{callers}} — the call graph inverted, so a changed fn can find
   who depends on it."
  [call-graph]
  (reduce (fn [m pair]
            (let [caller (first pair) callees (second pair)]
              (reduce (fn [mm callee] (update mm callee (fn [s] (conj (or s #{}) caller))))
                      m (into [] callees))))
          {} (into [] call-graph)))

(defn dependents
  "Every fn that transitively CALLS any of `changed`, via the reverse call
   graph `rg` {callee → #{callers}}. The changed fns themselves are included —
   the full set whose summaries may now be stale."
  [rg changed]
  (loop [seen (set changed) frontier (into [] changed)]
    (if (empty? frontier)
      seen
      (let [n (first frontier)
            callers (filter (fn [c] (not (contains? seen c))) (into [] (get rg n #{})))]
        (recur (into seen callers) (concat (rest frontier) callers))))))

(defn dirty-set
  "Given the previous whole-program `summaries` and the hash MISSES from
   analyze-incremental, the set of fns that must re-prove: the misses plus every
   transitive caller of a miss. On a large module an edit to one leaf dirties a
   small neighbourhood; the rest stay cache hits."
  [summaries misses]
  (dependents (reverse-graph (analyze/call-graph summaries)) misses))


(defn analyze-program
  "Collision-safe whole-program incremental closure. Reuses raw round summaries
   only outside the transitive dirty cone in BOTH old and new dependency graphs.
   Deletions, function values and changed flow/shadowing evidence are covered.
   Compilation/flow and latent closure still run; :hits counts reused function
   round summaries, not skipped parsing or a fully incremental compiler."
  [cache src]
  (let [program (analyze/prepare-program src) bodies (:bodies program)
        identities (into {} (map (fn [[n d]] [n (fn-identity d)]) bodies))
        generation (evidence-generation)
        valid (and generation (= :whole-program-v1 (:kind cache))
                   (= generation (:generation cache)))
        old-identities (if valid (:identities cache) {})
        removed (set (filter (fn [n] (not (contains? identities n))) (keys old-identities)))
        changed (set (filter (fn [n] (not= (get identities n) (get old-identities n))) (keys identities)))
        graph (analyze/dependency-graph program)
        evidence-changed (or (not valid)
                             (not= (set (filter fp/pure-value-globals (:shadowed program)))
                                   (set (filter fp/pure-value-globals (:shadowed cache))))
                             (not= (:flow program) (:flow cache)))
        graph-changed (set (filter (fn [n] (not= (get graph n) (get (:graph cache) n))) (keys graph)))
        seeds (if evidence-changed (set (keys identities)) (into (into changed removed) graph-changed))
        old-dirty (dependents (reverse-graph (or (:graph cache) {})) seeds)
        dirty (dependents (reverse-graph graph) old-dirty)
        result (analyze/analyze-prepared program (if valid (:locals cache) {}) dirty)
        after (evidence-generation)
        stable (and generation (= generation after))
        next-cache (when stable {:kind :whole-program-v1 :generation generation :identities identities
                                :graph graph :flow (:flow program) :shadowed (:shadowed program)
                                :locals (:locals result)})]
    {:summaries (:summaries result) :cache (or next-cache {}) :dirty dirty :removed removed
     :hits (vec (sort (filter (fn [n] (not (contains? dirty n))) (keys bodies))))
     :misses (vec (sort (filter (fn [n] (contains? dirty n)) (keys bodies))))
     :rounds (:rounds result)
     :summaries-evaluated (* (:rounds result) (count (filter (fn [n] (contains? dirty n)) (keys bodies))))
     :stable? stable}))
