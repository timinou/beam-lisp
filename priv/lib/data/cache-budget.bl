;; Pure policy: one revision per logical key, bounded count and charged bytes.
(ns data.cache-budget)

(def MAX-BYTES (* 32 1024 1024))
(def MAX-ENTRY (* 2 1024 1024))
(def MAX-ENTRIES 4096)

(defn empty-state [] {:entries {} :bytes 0})

(defn offer [state key revision weight]
  (if (or (not (erlang/is_integer weight)) (<= weight 0) (> weight MAX-ENTRY))
    {:accepted? false :clear? false :state state}
    (let [entries (:entries state)
          old (get entries key)
          bytes (+ (- (:bytes state) (or (:weight old) 0)) weight)
          clear? (or (> bytes MAX-BYTES)
                     (and (nil? old) (>= (count entries) MAX-ENTRIES)))
          next (if clear? (empty-state) state)]
      {:accepted? true :clear? clear?
       :state {:entries (assoc (:entries next) key {:revision revision :weight weight})
               :bytes (if clear? weight bytes)}})))
