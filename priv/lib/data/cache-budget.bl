;; Pure FIFO policy: one revision per key, bounded count and charged bytes.
;; Evict only the entries needed to admit the new value; never clear a warm
;; cache because one new entry crossed a limit. The queue holds one key each.
(ns data.cache-budget)

(def MAX-BYTES (* 32 1024 1024))
(def MAX-ENTRY (* 8 1024 1024))
(def MAX-ENTRIES 4096)

(defn empty-state [] {:entries {} :bytes 0 :order (queue/new)})

(defn admissible? [weight]
  (and (erlang/is_integer weight) (> weight 0) (<= weight MAX-ENTRY)))

(defn offer [state key revision weight]
  (if (not (admissible? weight))
    {:accepted? false :clear? false :evict [] :state state}
    (let [old (get (:entries state) key)
          bytes (+ (- (:bytes state) (or (:weight old) 0)) weight)
          ;; Hot replacement may inherit the previous clear-all policy state.
          ;; Its finite entries can seed a queue once without dropping values.
          existing-order (or (:order state) (queue/from_list (to-list (keys (:entries state)))))
          order (if old existing-order (queue/in key existing-order))]
      (loop [entries (assoc (:entries state) key {:revision revision :weight weight})
             order order bytes bytes evicted []]
        (if (and (<= bytes MAX-BYTES) (<= (count entries) MAX-ENTRIES))
          {:accepted? true :clear? false :evict evicted
           :state {:entries entries :bytes bytes :order order}}
          (let [popped (queue/out order)
                victim (erlang/element 2 (erlang/element 1 popped))
                remaining (erlang/element 2 popped)]
            ;; A larger replacement must not evict itself. Rotate that one
            ;; key once; its admissible weight always fits after older peers.
            (if (= victim key)
              (recur entries (queue/in victim remaining) bytes evicted)
              (recur (dissoc entries victim) remaining
                     (- bytes (:weight (get entries victim)))
                     (conj evicted victim)))))))))
