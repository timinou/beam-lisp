;; Immutable AVL nodes behind a caller-owned transactional port. Nodes have
;; subtree counts; rank reads skip prefixes. No mutable tree or app cache key.
(ns data.ranked-tree)
(def MAX-WORK 16384)
(defn context [fetch next-id]
 {:fetch fetch :next (atom next-id) :new (atom {}) :retired (atom #{})
  :reads (atom {}) :work (atom MAX-WORK)})
(defn node [ctx id]
 (when id
  (when (neg? (swap! (:work ctx) dec)) (throw {:refused :rank-work-limit}))
  (or (get @(:new ctx) id) (get @(:reads ctx) id)
      (let [n ((:fetch ctx) id)]
       (when-not (and (map? n) (= id (:id n)) (erlang/is_integer (:size n)) (pos? (:size n))
                      (erlang/is_integer (:height n)) (<= 1 (:height n) 64))
        (throw {:refused :rank-node-missing :id id}))
       (swap! (:reads ctx) assoc id n) n))))
(defn size [ctx id] (if id (:size (node ctx id)) 0))
(defn height [ctx id] (if id (:height (node ctx id)) 0))
(defn- retire [ctx id] (when id (swap! (:retired ctx) conj id)))
(defn- make-node [ctx key value left right]
 (let [id (swap! (:next ctx) inc)
       n {:id id :key key :value value :left left :right right
          :height (inc (max (height ctx left) (height ctx right)))
          :size (inc (+ (size ctx left) (size ctx right)))}]
  (swap! (:new ctx) assoc id n) id))
(defn- rotate-left [ctx id]
 (let [n (node ctx id) p (node ctx (:right n))
       left (make-node ctx (:key n) (:value n) (:left n) (:left p))
       root (make-node ctx (:key p) (:value p) left (:right p))]
  (retire ctx id) (retire ctx (:id p)) root))
(defn- rotate-right [ctx id]
 (let [n (node ctx id) p (node ctx (:left n))
       right (make-node ctx (:key n) (:value n) (:right p) (:right n))
       root (make-node ctx (:key p) (:value p) (:left p) right)]
  (retire ctx id) (retire ctx (:id p)) root))
(defn- balance [ctx id]
 (let [n (node ctx id) delta (- (height ctx (:left n)) (height ctx (:right n)))]
  (cond
   (> delta 1)
    (let [l (node ctx (:left n))]
     (if (> (height ctx (:right l)) (height ctx (:left l)))
      (let [next (make-node ctx (:key n) (:value n) (rotate-left ctx (:left n)) (:right n))]
       (retire ctx id) (rotate-right ctx next))
      (rotate-right ctx id)))
   (< delta -1)
    (let [r (node ctx (:right n))]
     (if (> (height ctx (:left r)) (height ctx (:right r)))
      (let [next (make-node ctx (:key n) (:value n) (:left n) (rotate-right ctx (:right n)))]
       (retire ctx id) (rotate-left ctx next))
      (rotate-left ctx id)))
   :else id)))
(defn insert [ctx id key value]
 (if-not id (make-node ctx key value nil nil)
  (let [n (node ctx id) c (compare key (:key n))
        next (cond
               (neg? c) (make-node ctx (:key n) (:value n)
                          (insert ctx (:left n) key value) (:right n))
               (pos? c) (make-node ctx (:key n) (:value n)
                          (:left n) (insert ctx (:right n) key value))
               :else (make-node ctx key value (:left n) (:right n)))]
   (retire ctx id) (balance ctx next))))
(defn- minimum [ctx id]
 (let [n (node ctx id)] (if (:left n) (minimum ctx (:left n)) n)))
(defn remove [ctx id key]
 (if-not id nil
  (let [n (node ctx id) c (compare key (:key n))]
   (retire ctx id)
   (cond
    (neg? c) (balance ctx (make-node ctx (:key n) (:value n)
                           (remove ctx (:left n) key) (:right n)))
    (pos? c) (balance ctx (make-node ctx (:key n) (:value n)
                           (:left n) (remove ctx (:right n) key)))
    (nil? (:left n)) (:right n)
    (nil? (:right n)) (:left n)
    :else (let [successor (minimum ctx (:right n))]
            (balance ctx (make-node ctx (:key successor) (:value successor)
                            (:left n) (remove ctx (:right n) (:key successor)))))))))
(defn page
 "Return at most limit values after skipping offset entries. direction chooses
  traversal only; subtree sizes are independent of ordering direction."
 [ctx id offset limit direction]
 (if (or (nil? id) (<= limit 0)) []
  (let [n (node ctx id)
        first-child (if (= direction :desc) (:right n) (:left n))
        last-child (if (= direction :desc) (:left n) (:right n))
        first-size (size ctx first-child)
        out (if (< offset first-size) (page ctx first-child offset limit direction) [])
        out (if (and (<= offset first-size) (< (count out) limit)) (conj out (:value n)) out)]
   (if (< (count out) limit)
    (into out (page ctx last-child (max 0 (- offset first-size 1)) (- limit (count out)) direction)) out))))
(defn changes
 "New nodes and unreachable replaced nodes; commit them with the published
  root/source data. Consumers of a deleted old root must fall back on a miss."
 [ctx]
 {:new (apply dissoc @(:new ctx) @(:retired ctx))
  :delete (into [] (core/remove (fn [id] (contains? @(:new ctx) id)) @(:retired ctx)))
  :next @(:next ctx) :work (- MAX-WORK @(:work ctx))})
