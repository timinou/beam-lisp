;; Optional finite-value cache. Computation belongs to callers; one owner only
;; publishes entries after charging their complete retained data footprint.
(ns data.bounded-cache (:require [data.cache-budget :as budget]))

(def OWNER-TIMEOUT-MS 25)

(declare binary-extra)
(declare key-data)
(declare ensure-owner)
(declare publish-entry!)

(defn- key-list [xs depth]
  (loop [xs xs out []]
    (cond
      (erlang/== xs ()) out
      (not (erlang/is_list xs)) nil
      :else (when-let [x (key-data (erlang/hd xs) depth)]
              (recur (erlang/tl xs) (conj out x))))))

(defn- key-map [x depth]
  (loop [it (maps/iterator x) out {}]
    (let [entry (maps/next it)]
      (if (= :none entry) out
        (let [k (key-data (erlang/element 1 entry) depth)
              v (key-data (erlang/element 2 entry) depth)]
          (when (and k v) (recur (erlang/element 3 entry) (assoc out k v))))))))

(defn key-data
  "Typed identity without retaining local reference resources. Unsupported
   identities decline caching; container tags prevent forged scalar collisions."
  [x depth]
  (when (<= depth 128)
    (cond
      (erlang/is_atom x) (tuple :atom x)
      (erlang/is_integer x) (tuple :integer x)
      (erlang/is_float x) (tuple :float x)
      (erlang/is_binary x) (tuple :binary x)
      (erlang/is_reference x)
        (when (= (erlang/node x) (erlang/node))
          (tuple :reference (erlang/node x) (erlang/ref_to_list x)))
      (erlang/is_tuple x)
        (when-let [v (key-list (erlang/tuple_to_list x) (inc depth))] (tuple :tuple v))
      (erlang/is_map x)
        (when-let [v (key-map x (inc depth))] (tuple :map v))
      (erlang/is_list x)
        (when-let [v (key-list x (inc depth))] (tuple :list v))
      :else nil)))

(defn- list-extra [xs depth]
  (loop [xs xs acc 0]
    (cond
      (erlang/== xs ()) acc
      (not (erlang/is_list xs)) nil
      :else (let [n (binary-extra (erlang/hd xs) depth)]
              (when (some? n) (recur (erlang/tl xs) (+ acc n)))))))

(defn- tuple-extra [x depth]
  (loop [i 1 acc 0]
    (if (> i (erlang/tuple_size x)) acc
      (let [n (binary-extra (erlang/element i x) depth)]
        (when (some? n) (recur (inc i) (+ acc n)))))))

(defn- map-extra [x depth]
  (loop [it (maps/iterator x) acc 0]
    (let [entry (maps/next it)]
      (if (= :none entry) acc
        (let [k (binary-extra (erlang/element 1 entry) depth)
              v (binary-extra (erlang/element 2 entry) depth)]
          (when (and (some? k) (some? v))
            (recur (erlang/element 3 entry) (+ acc k v))))))))

(defn- binary-extra [x depth]
  ;; References, processes, ports, functions and deep/opaque values cannot
  ;; hide native resource ownership inside a supposedly small cache entry.
  (when (<= depth 128)
    (cond
      (erlang/is_binary x) (- (binary/referenced_byte_size x) (erlang/byte_size x))
      (or (erlang/is_atom x) (erlang/is_number x)) 0
      (erlang/is_tuple x) (tuple-extra x (inc depth))
      (erlang/is_map x) (map-extra x (inc depth))
      (erlang/is_list x) (list-extra x (inc depth))
      :else nil)))

(defn footprint
  "Conservative charge for an entry, including sub-binaries' retained parents.
   nil declines opaque/resource-bearing values. No serialization copy is made."
  [entry]
  (let [extra (binary-extra entry 0)]
    (when (some? extra)
      ;; Charge twice for owner metadata and ETS terms, plus per-entry overhead.
      (+ 256 (* 2 (+ (* (erlang/system_info :wordsize) (erts_debug/flat_size entry))
                       (erlang/external_size entry) extra))))))

(defn- digest-data [data]
  (when-let [weight (footprint data)]
    (when (<= weight 1048576)
      {:digest (crypto/hash :sha256 (erlang/term_to_binary data)) :weight weight})))

(defn fingerprint
  "Compact finite provenance; large repeated immutable inputs reuse their digest
   and proven charge under this implementation's current generation. Typed
   normalization still validates each input; small inputs avoid cache machinery."
  [value]
  (when-let [data (key-data value 0)]
    (if (< (erts_debug/flat_size data) 256)
      (:digest (digest-data data))
      (let [name :data.cache.fingerprints
            pid (try (ensure-owner name) (catch _ nil))
            code (try (BeamLisp.Env/namespace_generations
                        (list "data.bounded-cache" "data.cache-budget")) (catch _ nil))
            revision (when code (key-data code 0))
            key (when revision (tuple :fingerprint data revision))
            retained (try (when (and pid key) (ets/lookup_element name key 3)) (catch _ nil))
            hit (and retained
                     (= code (try (BeamLisp.Env/namespace_generations
                                    (list "data.bounded-cache" "data.cache-budget"))
                                  (catch _ nil))))
            result (if hit retained (digest-data data))]
        (when (and result (not hit) revision
                   (= code (BeamLisp.Env/namespace_generations
                             (list "data.bounded-cache" "data.cache-budget"))))
          (when-let [weight (footprint (tuple key :fingerprint result))]
            (when (budget/admissible? weight)
              (try (publish-entry! name key :fingerprint result weight) (catch _ false)))))
        (:digest result)))))

(defn- publish-control! [name gate state]
  (ets/insert name (tuple :cache-control
    {:gate gate :stats {:size (count (:entries state)) :bytes (:bytes state)}})))

(defserver owner
  (init [name]
    (ets/new name (list :set :protected :named_table
                       (tuple :read_concurrency true)))
    (let [gate (atomics/new 1 (list)) state (budget/empty-state)]
      (publish-control! name gate state)
      (ok {:name name :gate gate :budget state})))
  ;; put! supplies a charge proven before sending immutable finite data.
  ;; The owner serializes only publication and the pure budget decision.
  (handle-call [:put key revision value weight] [_from st]
    (let [decision
          (try
            (let [entry (tuple key revision value)
                  decision (budget/offer (:budget st) key revision weight)]
              (when (:accepted? decision)
                (doseq [victim (:evict decision)] (ets/delete (:name st) victim))
                (ets/insert (:name st) entry))
              (publish-control! (:name st) (:gate st) (:state decision))
              decision)
            ;; The caller timing out does NOT release admission: its payload
            ;; remains queued until this owner actually consumes the request.
            (finally (atomics/put (:gate st) 1 0)))]
      (reply (:accepted? decision) (assoc st :budget (:state decision)))))
  (handle-call [:clear] [_from st]
    ;; Retain the admission/stats row. User keys are typed tuples; metadata
    ;; uses a raw atom and two fields, so it cannot collide with an entry.
    (ets/select_delete (:name st) (list (tuple (tuple :_ :_ :_) (list) (list true))))
    (let [state (budget/empty-state)
          gate (or (:gate st) (atomics/new 1 (list)))]
      (publish-control! (:name st) gate state)
      (reply :ok (assoc st :gate gate :budget state))))
  (handle-call [:stats] [_from st]
    (reply {:size (count (get-in st [:budget :entries]))
            :bytes (get-in st [:budget :bytes])} st)))

(defn- ensure-owner [name]
  (or (Process/whereis name)
      (try (start owner name {:name name :timeout OWNER-TIMEOUT-MS})
           ;; Racing first touches converge on the registered owner.
           (catch _ (Process/whereis name)))))

(defn ready!
  "Initialize optional retention before a caller captures code-validity evidence.
   Failure remains a cache miss; authoritative computation does not depend on it."
  [name]
  (try (some? (ensure-owner name)) (catch _ false)))

(defn lookup [name key revision]
  (try
    (let [key (key-data key 0) revision (key-data revision 0)]
      (if (and key revision)
        (do (ensure-owner name)
            (let [entry (first (ets/lookup name key))]
              (if (and entry (erlang/=:= revision (erlang/element 2 entry)))
                {:hit? true :value (erlang/element 3 entry)}
                {:hit? false})))
        {:hit? false}))
    (catch _ {:hit? false})))

(defn- publish-entry! [name key revision value weight]
  (if-let [pid (ensure-owner name)]
    (let [control (first (ets/lookup name :cache-control))
          gate (when control (:gate (erlang/element 2 control)))]
      (if (and gate (= pid (ets/info name :owner))
               (= :ok (atomics/compare_exchange gate 1 0 1)))
        (call pid [:put key revision value weight] OWNER-TIMEOUT-MS)
        false)) false))

(defn put!
  "Validate finite admission before copying into the bounded publication queue.
   A busy optional cache never imposes OTP's default five-second write timeout."
  [name key revision value]
  (try
    (let [key (key-data key 0) revision (key-data revision 0)]
      (if (and key revision)
        (let [weight (footprint (tuple key revision value))]
          (if (budget/admissible? weight)
            (publish-entry! name key revision value weight) false)) false))
    (catch _ false)))

(defn value
  "Compute on a miss; optional cache failure never changes the answer or
   suppresses computation errors. One revision occupies each logical key."
  [name key revision f]
  (if (or (not (erlang/is_function f))
          (not= :local (erlang/element 2 (erlang/fun_info f :type)))) (f)
    (let [revision (tuple :computation revision
                          (erlang/element 2 (erlang/fun_info f :module))
                          (erlang/element 2 (erlang/fun_info f :new_uniq))
                          (erlang/element 2 (erlang/fun_info f :index)))
          hit (lookup name key revision)]
      (if (:hit? hit) (:value hit)
        (let [v (f)] (put! name key revision v) v)))))

(defn clear! [name]
  (try (when-let [pid (Process/whereis name)] (call pid [:clear]))
       (catch _ nil))
  :ok)

(defn stats [name]
  (or (try
        (when-let [control (first (ets/lookup name :cache-control))]
          (:stats (erlang/element 2 control)))
        (catch _ nil)) {:size 0 :bytes 0}))
