;; Optional finite-value cache. Computation belongs to callers; one owner only
;; publishes entries after charging their complete retained data footprint.
(ns data.bounded-cache (:require [data.cache-budget :as budget] [data.cache-pool :as pool]))

(def OWNER-TIMEOUT-MS 25)

(declare binary-extra)
(declare key-data)
(declare ensure-owner)
(declare publish-entry!)

(defn- key-list [xs depth]
  (loop [xs xs out []]
    (cond
      (erlang/== xs ()) out
      (not (erlang/is_list xs)) nil
      :else (when-let [x (key-data (erlang/hd xs) depth)]
              (recur (erlang/tl xs) (conj out x))))))

(defn- key-map [x depth]
  (loop [it (maps/iterator x) out {}]
    (let [entry (maps/next it)]
      (if (= :none entry) out
        (let [k (key-data (erlang/element 1 entry) depth)
              v (key-data (erlang/element 2 entry) depth)]
          (when (and k v) (recur (erlang/element 3 entry) (assoc out k v))))))))

(defn key-data
  "Typed identity without retaining local reference resources. Unsupported
   identities decline caching; container tags prevent forged scalar collisions."
  [x depth]
  (when (<= depth 128)
    (cond
      (erlang/is_atom x) (tuple :atom x)
      (erlang/is_integer x) (tuple :integer x)
      (erlang/is_float x) (tuple :float x)
      (erlang/is_binary x) (tuple :binary x)
      (erlang/is_reference x)
        (when (= (erlang/node x) (erlang/node))
          (tuple :reference (erlang/node x) (erlang/ref_to_list x)))
      (erlang/is_tuple x)
        (when-let [v (key-list (erlang/tuple_to_list x) (inc depth))] (tuple :tuple v))
      (erlang/is_map x)
        (when-let [v (key-map x (inc depth))] (tuple :map v))
      (erlang/is_list x)
        (when-let [v (key-list x (inc depth))] (tuple :list v))
      :else nil)))

(defn- list-extra [xs depth]
  (loop [xs xs acc 0]
    (cond
      (erlang/== xs ()) acc
      (not (erlang/is_list xs)) nil
      :else (let [n (binary-extra (erlang/hd xs) depth)]
              (when (some? n) (recur (erlang/tl xs) (+ acc n)))))))

(defn- tuple-extra [x depth]
  (loop [i 1 acc 0]
    (if (> i (erlang/tuple_size x)) acc
      (let [n (binary-extra (erlang/element i x) depth)]
        (when (some? n) (recur (inc i) (+ acc n)))))))

(defn- map-extra [x depth]
  (loop [it (maps/iterator x) acc 0]
    (let [entry (maps/next it)]
      (if (= :none entry) acc
        (let [k (binary-extra (erlang/element 1 entry) depth)
              v (binary-extra (erlang/element 2 entry) depth)]
          (when (and (some? k) (some? v))
            (recur (erlang/element 3 entry) (+ acc k v))))))))

(defn- binary-extra [x depth]
  ;; References, processes, ports, functions and deep/opaque values cannot
  ;; hide native resource ownership inside a supposedly small cache entry.
  (when (<= depth 128)
    (cond
      (erlang/is_binary x) (- (binary/referenced_byte_size x) (erlang/byte_size x))
      (or (erlang/is_atom x) (erlang/is_number x)) 0
      (erlang/is_tuple x) (tuple-extra x (inc depth))
      (erlang/is_map x) (map-extra x (inc depth))
      (erlang/is_list x) (list-extra x (inc depth))
      :else nil)))

(defn footprint
  "Conservative charge for an entry, including sub-binaries' retained parents.
   nil declines opaque/resource-bearing values. No serialization copy is made."
  [entry]
  (let [extra (binary-extra entry 0)]
    (when (some? extra)
      ;; Charge twice for owner metadata and ETS terms, plus per-entry overhead.
      (+ 256 (* 2 (+ (* (erlang/system_info :wordsize) (erts_debug/flat_size entry))
                       (erlang/external_size entry) extra))))))

(defn- digest-data [data]
  (when-let [weight (footprint data)]
    (when (<= weight 1048576)
      {:digest (crypto/hash :sha256 (erlang/term_to_binary data)) :weight weight})))

(defn- fingerprint-code []
  (try (BeamLisp.Env/namespace_generations
         (list "core" "sugar" "rt" "data.bounded-cache" "data.cache-budget"))
       (catch _ nil)))

(defn fingerprint
  "Compact finite provenance; large repeated immutable inputs reuse their digest
   and proven charge under this implementation's current generation. Typed
   normalization still validates each input; small inputs avoid cache machinery."
  [value]
  (when-let [data (key-data value 0)]
    (if (< (erts_debug/flat_size data) 256)
      (:digest (digest-data data))
      (let [name :data.cache.fingerprints
            pid (try (ensure-owner name) (catch _ nil))
            code (fingerprint-code)
            revision (when code (key-data code 0))
            key (when revision (tuple :fingerprint data revision))
            retained (try (when (and pid key) (ets/lookup_element name key 3)) (catch _ nil))
            hit (and retained
                     (= code (fingerprint-code)))
            result (if hit retained (digest-data data))]
        (when (and result (not hit) revision
                   (= code (fingerprint-code)))
          (when-let [weight (footprint (tuple key :fingerprint result))]
            (when (budget/admissible? weight)
              (try (publish-entry! name key :fingerprint result weight) (catch _ false)))))
        (:digest result)))))

(defn- publish-control! [name gate state]
  (ets/insert name (tuple :cache-control
    {:gate gate :stats {:size (count (:entries state)) :bytes (:bytes state)}})))

(defn- lease-row [gate] (first (ets/lookup gate :lease)))
(defn- drop-claim! [gate ticket]
  (ets/select_delete gate (list (tuple (tuple :lease ticket :_ :_ :_) (list) (list true)))))
(defn- release-pending! [st]
  (when-let [pending (:pending st)]
    (erlang/demonitor (:monitor pending) (list :flush))
    (drop-claim! (:gate st) (:ticket pending))
    (pool/release! (erlang/self) (:ticket pending)))
  (assoc st :pending nil))

(defserver owner
  (init [name]
    (when-not (pool/register! (erlang/self)) (throw "optional cache aggregate budget exhausted"))
    (ets/new name (list :set :protected :named_table (tuple :read_concurrency true)))
    ;; One small claim row gates METADATA before any full value is copied.
    ;; Owner grants the claim and monitors its sender before acknowledging.
    (let [gate (ets/new :cache_admission (list :set :public)) state (budget/empty-state)]
      (publish-control! name gate state)
      ;; The owner rearms exactly one timer AFTER consuming it. A suspended
      ;; owner therefore holds at most one maintenance message, regardless
      ;; of elapsed time or collector restarts.
      (erlang/send_after 100 (erlang/self) :cache-reap)
      (ok {:name name :gate gate :budget state :pending nil})))
  (handle-call [:reserve caller ticket weight] [from st]
    (let [row (lease-row (:gate st))
          match (and (= caller (erlang/element 1 from)) (nil? (:pending st))
                     (= row (tuple :lease ticket :claimed caller weight))
                     (Process/alive? caller) (budget/admissible? weight))]
      (if match
        (let [monitor (erlang/monitor :process caller)]
          (ets/insert (:gate st) (tuple :lease ticket :granted caller weight))
          (reply true (assoc st :pending {:caller caller :ticket ticket :weight weight :monitor monitor})))
        (do (drop-claim! (:gate st) ticket) (pool/release! (erlang/self) ticket) (reply false st)))))
  (handle-call [:put ticket key revision value weight] [from st]
    (let [pending (:pending st)]
      (if (and pending (= ticket (:ticket pending)) (= weight (:weight pending))
               (= (:caller pending) (erlang/element 1 from)))
        (let [decision (budget/offer (:budget st) key revision weight)
              old (get-in st [:budget :entries key :lease])]
          (if (:accepted? decision)
            (do
              (doseq [victim (:evict decision)]
                (ets/delete (:name st) victim)
                (pool/release! (erlang/self) (get-in st [:budget :entries victim :lease])))
              (ets/insert (:name st) (tuple key revision value))
              (pool/retain! (erlang/self) ticket)
              (when old (pool/release! (erlang/self) old)))
            (pool/release! (erlang/self) ticket))
          (let [state (if (:accepted? decision) (assoc-in (:state decision) [:entries key :lease] ticket) (:state decision))]
            (erlang/demonitor (:monitor pending) (list :flush))
            (drop-claim! (:gate st) ticket)
            (publish-control! (:name st) (:gate st) state)
            (reply (:accepted? decision) (assoc st :budget state :pending nil))))
        (reply false st))))
  (handle-cast [:cancel ticket] [st]
    ;; Sent only after reserve failure, NEVER after a queued put times out.
    (if (= ticket (get-in st [:pending :ticket]))
      (noreply (release-pending! st))
      (do (drop-claim! (:gate st) ticket) (pool/release! (erlang/self) ticket) (noreply st))))
  (handle-info [:DOWN ref :process caller why] [st]
    (if (= ref (get-in st [:pending :monitor]))
      ;; Signals from this sender to this owner preserve order: an already
      ;; sent put is consumed before its monitor DOWN. Unsent credits release.
      (noreply (release-pending! st)) (noreply st)))
  (handle-info :cache-reap [st]
    (let [row (lease-row (:gate st))
          claimed (when row (erlang/element 2 row))
          caller (when row (erlang/element 4 row))
          credit (pool/pending (erlang/self))]
      (when (and row (= :claimed (erlang/element 3 row)) (not (Process/alive? caller)))
        (drop-claim! (:gate st) claimed)
        (pool/release! (erlang/self) claimed))
      ;; A killed sender may have reserved after its claim was reaped. The
      ;; ledger survives that race; an orphan with no grant cannot queue data.
      (when (and credit (not= credit claimed) (not= credit (get-in st [:pending :ticket])))
        (pool/release! (erlang/self) credit))
      (erlang/send_after (if (pool/pending (erlang/self)) 100 1000)
                         (erlang/self) :cache-reap)
      (noreply st)))
  (handle-call [:clear] [_from st]
    (ets/select_delete (:name st) (list (tuple (tuple :_ :_ :_) (list) (list true))))
    (doseq [entry (vals (get-in st [:budget :entries]))]
      (pool/release! (erlang/self) (:lease entry)))
    (let [state (budget/empty-state)]
      (publish-control! (:name st) (:gate st) state)
      (reply :ok (assoc st :budget state))))
  (handle-call [:stats] [_from st]
    (reply {:size (count (get-in st [:budget :entries])) :bytes (get-in st [:budget :bytes])} st)))

(defn- ensure-owner [name]
  (or (Process/whereis name)
      (try (pool/ready!)
           (start owner name {:name name :timeout OWNER-TIMEOUT-MS})
           ;; Racing first touches converge on the registered owner.
           (catch _ (Process/whereis name)))))

(defn ready!
  "Initialize optional retention before a caller captures code-validity evidence.
   Failure remains a cache miss; authoritative computation does not depend on it."
  [name]
  (try (some? (ensure-owner name)) (catch _ false)))

(defn- scoped-revision [revision]
  ;; A shared SDK factory can produce the same callback fingerprint for two
  ;; different application graphs/configurations. Context is native authority,
  ;; not another key every application developer must remember to supply.
  ;; key-data converts the local Env reference without retaining that resource.
  (if-let [g (Process/get :bl_generation)]
    (if (and (map? g) (string? (:digest g)) (= 64 (erlang/byte_size (:digest g))) (:scope g))
      (tuple :sealed-generation (:scope g) (:application-id g) (:digest g) revision)
      (throw (ex-info "Unknown generation cache authority" {:kind :invalid-cache-generation})))
    revision))

(defn lookup [name key revision]
  (try
    (let [key (key-data key 0) revision (key-data (scoped-revision revision) 0)]
      (if (and key revision)
        (do (ensure-owner name)
            (let [entry (first (ets/lookup name key))]
              (if (and entry (erlang/=:= revision (erlang/element 2 entry)))
                {:hit? true :value (erlang/element 3 entry)}
                {:hit? false})))
        {:hit? false}))
    (catch _ {:hit? false})))

(defn- publish-entry! [name key revision value weight]
  (if-let [pid (ensure-owner name)]
    (let [control (first (ets/lookup name :cache-control)) gate (when control (:gate (erlang/element 2 control)))
          ticket (erlang/make_ref) caller (erlang/self)]
      (if (and gate (= pid (ets/info name :owner))
               (ets/insert_new gate (tuple :lease ticket :claimed caller weight)))
        (if (pool/reserve! pid ticket weight)
          (let [reserved (try (call pid [:reserve caller ticket weight] OWNER-TIMEOUT-MS)
                              (catch _ false))]
            (if reserved
              ;; Timeout here keeps the credit: the value may still be queued.
              (call pid [:put ticket key revision value weight] OWNER-TIMEOUT-MS)
              (do (cast pid [:cancel ticket]) false)))
          (do (drop-claim! gate ticket) false))
        false)) false))

(defn put!
  "Validate finite admission before copying into the bounded publication queue.
   A busy optional cache never imposes OTP's default five-second write timeout."
  [name key revision value]
  (try
    (let [key (key-data key 0) revision (key-data (scoped-revision revision) 0)]
      (if (and key revision)
        (let [weight (footprint (tuple key revision value))]
          (if (budget/admissible? weight)
            (publish-entry! name key revision value weight) false)) false))
    (catch _ false)))

(defn value
  "Compute on a miss; optional cache failure never changes the answer or
   suppresses computation errors. One revision occupies each logical key."
  [name key revision f]
  (if (or (not (erlang/is_function f))
          (not= :local (erlang/element 2 (erlang/fun_info f :type)))) (f)
    (let [revision (tuple :computation revision
                          (erlang/element 2 (erlang/fun_info f :module))
                          (erlang/element 2 (erlang/fun_info f :new_uniq))
                          (erlang/element 2 (erlang/fun_info f :index)))
          hit (lookup name key revision)]
      (if (:hit? hit) (:value hit)
        (let [v (f)] (put! name key revision v) v)))))

(defn clear! [name]
  (try (when-let [pid (Process/whereis name)] (call pid [:clear]))
       (catch _ nil))
  :ok)

(defn key-identities
  "Read-only retention diagnostics: normalized logical keys, without copying
   cached values or retaining the original keys' native reference resources."
  [name]
  (try (ets/select name (list (tuple (tuple :"$1" :_ :_) (list) (list :"$1"))))
       (catch _ (list))))

(defn stats [name]
  (or (try
        (when-let [control (first (ets/lookup name :cache-control))]
          (:stats (erlang/element 2 control)))
        (catch _ nil)) {:size 0 :bytes 0}))
