;; Pure bounded FIFO admission. Duplicate cold readers never duplicate keys.
(ns data.cache-ring)

(defn offer [state key value charge max-entry max-entries]
  (if (or (not (erlang/is_integer max-entry)) (<= max-entry 0)
          (not (erlang/is_integer max-entries)) (<= max-entries 0)
          (not (erlang/is_integer charge)) (<= charge 0) (> charge max-entry)
          (contains? (:entries state) key)) state
    (let [order (conj (:order state) key)
          entries (assoc (:entries state) key value)
          over (- (count order) max-entries)]
      (if (> over 0)
        (assoc state :entries (reduce dissoc entries (subvec order 0 over))
                     :order (subvec order over))
        (assoc state :entries entries :order order)))))
