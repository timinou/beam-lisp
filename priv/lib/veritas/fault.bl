; veritas/fault.bl — the fault SPACE of a contract, as data; errors on demand.
;
; ── Why this is a distinct layer, not just veritas/faults ──────────────────
;
; veritas core's `faults` answers, per law i: "is there a value wrong for exactly
; law i?" — a z3 question (find a witness), tagged with a modality. That is ONE
; engine. A sturdy mock needs the whole fault SURFACE as a queryable set:
;   • which laws does the SUITE of mutants actually exercise? (coverage)
;   • which mutants test the same thing? (redundancy)
;   • which laws break alone vs are implied by others? (independence)
; Those are questions ABOUT A SET, and that is datalog's half of the engine
; division. So this module runs in two movements, each engine at its best:
;
;   z3       GENERATES the fault space  — an isolated mutant per law (via the
;                                         veritas core's exists-not), modality-tagged.
;   datalog  ANALYSES  the fault space  — every mutant/law/violation is a datom;
;                                         sturdiness is then a QUERY (not-join for
;                                         coverage, grouping for redundancy).
;
; The z3 half is NOT reimplemented here — it is veritas.mock (contract → isolated
; value) plus the core's modality. This module adds only the datom analysis and
; the error-injection server that a contract-as-set makes possible.
;
; ── Errors on demand ───────────────────────────────────────────────────────
;
; An isolated mutant breaks ONE named law, so "give me an error" is a precise
; request: `error-for` returns a response wrong for EXACTLY the law you name, and
; `serve` answers valid normally but injects a requested error. The error's
; identity IS the law it violates, so a negative test can never accidentally
; assert against a valid response.

(ns veritas.fault
  (:require [smt :as smtlib]  [z3] [veritas :as v] [veritas.mock :as m] [datom] [core]))

(def TIMEOUT-MS 3000)

(defn- kwize
  "{name-string → v} → {name-keyword → v}."
  [mp]
  (into {} (map (fn [p] [(keyword (first p)) (second p)]) (into [] mp))))

; ── z3: an ISOLATED mutant (exactly one law broken) — modality-tagged ───────
;
; To break law i alone: assert (not law_i) AND every other law j≠i. If SAT, the
; model violates i and nothing else — a value whose ONLY fault is nameable, and
; the modality is :proven (z3 built it). If unsat, law i CANNOT be broken while
; the others hold: it is IMPLIED by them (a redundant contract law — a finding,
; surfaced not hidden), and that redundancy is z3-PROVEN.

(defn- assert-except
  "Assert every ensures clause except index `i`, and the NEGATION of clause i.
   Ensures are FORMS (or legacy raw strings); the result is form commands."
  [ensures i]
  (vec (map-indexed (fn [j e]
                      (if (= j i)
                        (if (string? e)
                          (smtlib/raw (str "(assert (not " e "))"))
                          (smtlib/assert `(not ~e)))
                        (if (string? e)
                          (smtlib/raw (str "(assert " e ")"))
                          (smtlib/assert e))))
                    ensures)))

(defn isolate
  "A value violating EXACTLY clause `i` of `contract`, with a verdict. Returns
   {:clause i :status \"sat\"|\"unsat\"|\"unknown\" :modality :proven|:unknown
    :value {…}|nil :implied bool}. unsat ⟹ clause i is implied by the others
   (redundant), z3-proven; unknown ⟹ undecidable."
  [port contract i]
  (let [cmds (concat [(smtlib/raw (str "(set-option :timeout " TIMEOUT-MS ")"))]
                     (m/contract-decls (:fields contract))
                     (assert-except (:ensures contract) i))
        r (z3/check-model port cmds)
        st (:status r)]
    {:clause i
     :status st
     :modality (if (= st "unknown") :unknown :proven)
     :implied (= st "unsat")
     :value (if (= st "sat") (kwize (v/parse-model (:model r))) nil)}))

(defn isolate-all
  "One isolated mutant per clause: [{:clause :status :modality :implied :value} …].
   The full single-fault surface, each fault broken for one named reason."
  [port contract]
  (into [] (map (fn [i] (isolate port contract i))
                (range 0 (count (:ensures contract))))))

; ── errors on demand ─────────────────────────────────────────────────────────

(defn error-for
  "A response WRONG for exactly clause `i` — an error requested by the law it
   breaks. nil when that law cannot be broken alone (implied/undecidable)."
  [port contract i]
  (:value (isolate port contract i)))

(defn errors
  "Every requestable single-law error: {clause-idx → wrong-response}. Skips laws
   that cannot be broken in isolation. The catalogue of every distinct way this
   contract's response can be individually wrong."
  [port contract]
  (into {}
    (keep (fn [mp] (if (nil? (:value mp)) nil [(:clause mp) (:value mp)]))
          (isolate-all port contract))))

(defn total-error
  "A response that violates ALL laws at once — the maximally-wrong value."
  [port contract]
  (:value (m/synth-invalid port contract)))

; ── a mock SERVER that can inject errors (on veritas.mock's server) ─────────
;
; Valid responses by default (delegating to veritas.mock's deterministic server),
; an injected error when a request asks for one. `injections` maps a request key →
; the clause index to break, so a test drives the server through both its happy
; path and a chosen fault WITHOUT changing the caller — the fault is data,
; requested by name.

(defn make-server
  "A fault-injecting mock server: {:mock :injections {key→clause-idx}}. `mock` is a
   veritas.mock server (make-mock); injections name which clause to break per key."
  [mock injections]
  {:mock mock :injections injections})

(defn serve
  "Answer request `key`. If `key` is in :injections, serve the error for that clause
   (wrong by one named law); else serve a deterministic valid response. The verdict
   travels WITH the response: {:ok? bool :reason clause-idx|nil :value {…}}."
  [server key]
  (let [inj (get (:injections server) key)
        mock (:mock server)]
    (if (core/some? inj)
      {:ok? false :reason inj
       :value (error-for (:port mock) (:contract mock) inj)}
      (let [a (m/answer mock key)]
        {:ok? true :reason nil :value (:value a)}))))

; ── the fault suite as datoms ──────────────────────────────────────────────
;
; Every clause is an entity; every generated mutant is an entity; a mutant that
; violates a clause is an edge. Once the fault surface is a db, sturdiness stops
; being ad-hoc bookkeeping and becomes ordinary queries over :fault/violates.

(def SCHEMA
  [{:db/ident :clause/idx      :db/valueType :db.type/long :db/unique :db.unique/identity}
   {:db/ident :clause/text     :db/valueType :db.type/string}
   {:db/ident :fault/id        :db/valueType :db.type/long :db/unique :db.unique/identity}
   {:db/ident :fault/kind      :db/valueType :db.type/keyword}
   {:db/ident :fault/violates  :db/valueType :db.type/ref :db/cardinality :db.cardinality/many}
   {:db/ident :fault/reason    :db/valueType :db.type/long}])

(defn- violated-clauses
  "Which clause INDICES a concrete value breaks — MEASURED by m/check on a
   one-clause contract per index. Does not trust the generator's intent; measures
   what the value actually violates."
  [port contract value]
  (into []
    (keep (fn [i]
            (let [one {:fields (:fields contract) :ensures [(nth (:ensures contract) i)]}]
              (if (m/check port one value) nil i)))    ; check=false ⟹ violates i
          (range 0 (count (:ensures contract))))))

(defn build-db
  "Generate the fault space of `contract` and load it as a datom db. Each clause
   and each mutant is an entity; :fault/violates edges are MEASURED (re-check every
   mutant against every clause). Returns {:conn :db :faults}. `mutants` is the
   generated set — each {:value :fault/id :kind :clause}."
  [port contract mutants]
  (let [conn (datom/connect SCHEMA)
        ; :clause/text is a STRING column: an ensures FORM renders at the
        ; boundary, exactly as it would reach z3
        clause-tx (into [] (map-indexed
                             (fn [i e] {:db/id (+ 1 i) :clause/idx i
                                        :clause/text (if (string? e) e (smtlib/emit e))})
                             (:ensures contract)))
        fault-tx (into []
                   (keep (fn [mut]
                           (if (nil? (:value mut)) nil
                             (let [vio (violated-clauses port contract (:value mut))]
                               {:db/id (+ 1000 (:fault/id mut))
                                :fault/id (:fault/id mut)
                                :fault/kind (:kind mut)
                                :fault/reason (or (:clause mut) -1)
                                :fault/violates (into [] (map (fn [i] (+ 1 i)) vio))})))
                         mutants))]
    (datom/transact! conn (into clause-tx fault-tx))
    {:conn conn :db (datom/db conn) :faults fault-tx}))

; ── datalog: sturdiness is a query ──────────────────────────────────────────

(defn uncovered-clauses
  "Clause indices NO fault in the db exercises — the suite's blind spots. A
   negation query: a clause with no incoming :fault/violates edge."
  [db]
  (into [] (sort (map (fn [r] (get r 0))
             (into [] (datom/q '[:find ?idx
                                 :where [?c :clause/idx ?idx]
                                        [:not-join [?c] [?f :fault/violates ?c]]]
                               db))))))

(defn covered-clauses
  "Clause indices at least one fault exercises."
  [db]
  (into [] (sort (distinct (map (fn [r] (get r 0))
                       (into [] (datom/q '[:find ?idx
                                           :where [?f :fault/violates ?c]
                                                  [?c :clause/idx ?idx]]
                                         db)))))))

(defn faults-per-clause
  "{clause-idx → count of faults that break it}. A clause broken by many faults is
   well-defended; a clause broken by one is fragile to that test's removal."
  [db]
  (let [rows (into [] (datom/q '[:find ?idx ?f
                                 :where [?f :fault/violates ?c] [?c :clause/idx ?idx]]
                               db))]
    (core/update-vals (group-by (fn [r] (get r 0)) rows) count)))

(defn redundant-mutants
  "Groups of fault ids whose violated-clause SET is identical — duplicates that
   test the same thing. Keeping one per group is a smaller, equally-strong suite."
  [db]
  (let [rows (into [] (datom/q '[:find ?f ?idx
                                 :where [?fe :fault/id ?f] [?fe :fault/violates ?c]
                                        [?c :clause/idx ?idx]]
                               db))
        by-fault (core/update-vals (group-by (fn [r] (get r 0)) rows)
                                   (fn [rs] (sort (map (fn [r] (get r 1)) rs))))
        by-sig (group-by (fn [p] (second p)) (into [] by-fault))]
    (into []
      (keep (fn [p]
              (let [ids (sort (map first (second p)))]
                (if (> (count ids) 1) {:signature (into [] (first p)) :faults (into [] ids)} nil)))
            (into [] by-sig)))))

(defn independent-laws
  "Clause indices that CAN break in isolation vs those that cannot (implied by the
   others — redundant contract laws) vs undecidable. Reads isolate-all directly."
  [isolated]
  {:independent (into [] (sort (keep (fn [mp] (if (= "sat" (:status mp)) (:clause mp) nil)) isolated)))
   :implied     (into [] (sort (keep (fn [mp] (if (:implied mp) (:clause mp) nil)) isolated)))
   :undecidable (into [] (sort (keep (fn [mp] (if (= "unknown" (:status mp)) (:clause mp) nil)) isolated)))})

; ── the whole robustness report in one call ─────────────────────────────────

(defn report
  "The full sturdiness picture of `contract`: generate isolated mutants, load the
   fault db, and answer every coverage/redundancy/independence query. One value,
   fully queryable, honest about undecidable laws."
  [port contract]
  (let [isolated (isolate-all port contract)
        mutants (into [] (map-indexed (fn [i mp] (assoc mp :fault/id i :kind :isolated)) isolated))
        world (build-db port contract mutants)
        db (:db world)]
    {:clauses (count (:ensures contract))
     :faults (count (filter (fn [mp] (core/some? (:value mp))) mutants))
     :covered (covered-clauses db)
     :uncovered (uncovered-clauses db)
     :faults-per-clause (faults-per-clause db)
     :redundant (redundant-mutants db)
     :laws (independent-laws isolated)
     :db db}))
