; connector/keep.bl — keep a remote TREE as facts: the part of a provider's
; change feed that falls under a set of roots, and nothing else.
;
; Design: docs/connectors/mirror-and-reconcile.md (M1–M4, amended 2026-09-28).
;
; ── The laws ────────────────────────────────────────────────────────────────
;
;   M1  the mirror is the CLOSURE of its roots. An item outside every root is
;       never written — not its name, not its id. A change is judged against
;       the mirror + the change's own parent before anything is transacted.
;   M2  cursor FIRST. With no cursor, the start token is read BEFORE the roots
;       are seeded, so a change made during the seed is replayed afterwards
;       (idempotent writes make the overlap harmless).
;   M3  commit LAST. The new cursor is written in the SAME transaction as the
;       last page's facts; a crash mid-walk re-reads from the old cursor.
;   M4  a folder that ARRIVES under a root is seeded (its subtree listed), and a
;       root added since the last step is seeded before paging.
;
; Removal is a fact, never a deletion: `removed` → :file/gone, trashed →
; :file/trashed. Moving OUT of every root keeps the entity (its parent now
; points outside, or is cleared) so a projection sees it as stale — the
; mirror records what happened; consumers decide what that means.
;
; ── Shape ───────────────────────────────────────────────────────────────────
;
; `(step! k)` does one bounded unit of work and returns a report map. A keep is
; `{:conn datom-conn :feed feed :get (fn [url]) :roots (fn [db] [key …])}`; the
; feed is provider data (connector.google.gdrive/feed). Nothing here names a
; provider — a Graph feed is the same keep.

(ns connector.keep
  (:require [datom] [files]))

(def schema
  "The keep's own facts: one cursor + bookkeeping per feed, one seeded mark per
   root (so a root is seeded exactly once, and re-seeded only when asked)."
  [{:db/ident :feed/key       :db/valueType :db.type/term :db/unique :db.unique/identity}
   {:db/ident :feed/cursor    :db/valueType :db.type/string}
   {:db/ident :feed/stepped-at :db/valueType :db.type/long}
   {:db/ident :feed/error     :db/valueType :db.type/string}
   {:db/ident :feed/error-at  :db/valueType :db.type/long}
   {:db/ident :root/seeded    :db/valueType :db.type/term :db/unique :db.unique/identity}])

(defn full-schema [] (into (into [] files/schema) schema))

(defn- now [] (erlang/system_time :millisecond))
(defn feed-key [feed] [(:provider feed) (:namespace feed)])

(defn- eid [db k]
  (let [ds (into [] (datom/datoms db :avet :conn/key k))]
    (if (empty? ds) nil (nth (first ds) 0))))

(defn cursor [db feed]
  (let [r (into [] (datom/q '[:find ?c :in $ ?k :where [?f :feed/key ?k] [?f :feed/cursor ?c]] db (feed-key feed)))]
    (if (empty? r) nil (first (first r)))))

(defn- seeded? [db root]
  (seq (into [] (datom/datoms db :avet :root/seeded root))))

;; ── item → transaction ──────────────────────────────────────────────────────

(def ^:private CURSOR-TEMPID
  "The feed entity's tempid when it rides in a page transaction — far below any
   id `tempids` allocates for items."
  -1000000000)

(defn- tempids
  "A per-transaction allocator: key → the entity's eid when it exists, else a
   stable NEGATIVE tempid for this transaction (datom tempids are negative
   ints; a key seen twice in one transaction gets the same one, and a
   `:conn/key` upsert resolves it onto an existing entity)."
  [db]
  (let [m (atom {})]
    (fn [k]
      (or (eid db k)
          (get @m k)
          (let [t (- -1 (count @m))] (swap! m assoc k t) t)))))

(defn- item-tx
  "The facts for one item; `ref` is the transaction's key → id allocator."
  [ref item parent-ref]
  (cond-> {:db/id (ref (:key item))
           :conn/key (:key item)
           :file/name (or (:name item) "")
           :file/folder? (= true (:folder? item))}
    (some? (:mime item)) (assoc :file/mime (:mime item))
    (some? (:rev item)) (assoc :file/rev (:rev item))
    (some? (:size item)) (assoc :file/size (:size item))
    (some? (:modified item)) (assoc :file/modified (:modified item))
    (some? (:md5 item)) (assoc :file/md5 (:md5 item))
    (some? parent-ref) (assoc :file/parent parent-ref)))

(defn- flags-tx
  "Trashed is a flag that can be set AND cleared (untrash); gone is set only."
  [db ref item]
  (let [e (eid db (:key item))]
    (cond
      (:trashed item) [[:db/add (ref (:key item)) :file/trashed true]]
      (and (some? e) (seq (into [] (datom/datoms db :eavt e :file/trashed))))
        [[:db/retract e :file/trashed true]]
      :else [])))

;; ── the root closure (M1) ───────────────────────────────────────────────────

(defn- closure-keys
  "Every key currently inside some root: the roots themselves plus the mirror's
   descendants of each. Computed once per page — the membership test for every
   change in it."
  [db roots]
  (let [root-eids (keep (fn [r] (eid db r)) roots)
        desc (mapcat (fn [re] (files/descendants db re)) root-eids)
        eid->key (fn [e] (let [ds (into [] (datom/datoms db :eavt e :conn/key))]
                           (if (empty? ds) nil (nth (first ds) 2))))]
    (into (into #{} roots) (keep eid->key desc))))

;; ── seeding (M4) ────────────────────────────────────────────────────────────

(defn- list-children [k parent-key]
  (loop [page nil out []]
    (let [r ((:children (:feed k)) (:get k) parent-key page)]
      (if (contains? r :error) r
        (let [out (into out (:items (:ok r)))]
          (if (nil? (:next (:ok r))) {:ok out} (recur (:next (:ok r)) out)))))))

(defn- seed-tx
  "Transactions for `root` and its whole subtree (BFS over children listings).
   Returns {:ok [tx …] :items n} or {:error …}. Folders are expanded; a folder
   is listed once even if it appears twice."
  [k root-key root-item]
  (let [db (datom/db (:conn k))]
    (loop [frontier [root-key] seen #{root-key}
           txs [(let [ref (tempids db)] (into [(item-tx ref root-item nil)] (flags-tx db ref root-item)))] n 1]
      (if (empty? frontier) {:ok txs :items n}
        (let [pk (first frontier)
              r (list-children k pk)]
          (if (contains? r :error) r
            (let [kids (remove (fn [i] (contains? seen (:key i))) (:ok r))
                  ;; parent + children in ONE transaction: the parent is
                  ;; re-asserted by key so its tempid resolves whether or not
                  ;; an earlier transaction of this seed has committed it
                  ref (tempids (datom/db (:conn k)))
                  tx (if (empty? kids) []
                       (into [{:db/id (ref pk) :conn/key pk}]
                             (mapcat (fn [i] (into [(item-tx ref i (ref pk))] (flags-tx db ref i))) kids)))
                  folders (map :key (filter :folder? kids))]
              (recur (into (into [] (rest frontier)) folders)
                     (into seen (map :key kids))
                     (if (empty? tx) txs (conj txs tx))
                     (+ n (count kids))))))))))

(defn- seed-root! [k root-key]
  (let [it ((:item (:feed k)) (:get k) root-key)]
    (cond
      (contains? it :error) {:error (:error it) :root root-key}
      (not (:folder? (:ok it))) {:error :root-not-a-folder :root root-key}
      :else
        (let [r (seed-tx k root-key (:ok it))]
          (if (contains? r :error) (assoc r :root root-key)
            (do (doseq [tx (:ok r)] (datom/transact! (:conn k) tx))
                (datom/transact! (:conn k) [{:db/id -1 :root/seeded root-key}])
                {:ok (:items r)}))))))

;; ── one page of changes ─────────────────────────────────────────────────────

(defn- page-tx
  "The facts one change page contributes, M1-filtered. A change is kept when
   its key is already inside the closure (an update, a move out, a removal) or
   its NEW parent is (a move in, a create). Returns {:tx [...] :arrived [folder
   keys that arrived and need seeding] :kept n :dropped n}."
  [k db closure items]
  (let [pk (:parent-key (:feed k))
        ref (tempids db)]
    (reduce
      (fn [acc it]
        (let [inside (contains? closure (:key it))
              parent (if (:removed it) nil (pk it))
              lands (and (some? parent) (contains? closure parent))]
          (cond
            (:removed it)
              (if (and inside (some? (eid db (:key it))))
                (-> acc (update :tx conj [:db/add (eid db (:key it)) :file/gone true])
                        (update :kept inc))
                (update acc :dropped inc))
            lands
              (-> acc
                  (update :tx into (into [{:db/id (ref parent) :conn/key parent}
                                          (item-tx ref it (ref parent))]
                                         (flags-tx db ref it)))
                  (update :arrived (fn [a] (if (and (:folder? it) (not inside)) (conj a (:key it)) a)))
                  (update :kept inc))
            inside
              ;; moved OUT (or its parent is unknown): keep the entity, detach it
              (let [e (eid db (:key it))
                    olds (into [] (datom/datoms db :eavt e :file/parent))]
                (-> acc
                    (update :tx into (into (mapv (fn [d] [:db/retract e :file/parent (nth d 2)]) olds)
                                           (flags-tx db ref it)))
                    (update :kept inc)))
            :else (update acc :dropped inc))))
      {:tx [] :arrived [] :kept 0 :dropped 0}
      items)))

(defn- record-error! [k msg]
  (datom/transact! (:conn k) [{:db/id -1 :feed/key (feed-key (:feed k))
                               :feed/error (str msg) :feed/error-at (now)}]))

(defn step!
  "One unit of keeping. Returns
     {:ok :seeded|:paged|:idle :items n :dropped n :pages n :cursor c}
     {:error reason …}  (recorded on the feed entity; the cursor is untouched)"
  [k]
  (let [c (:conn k) feed (:feed k) fk (feed-key feed)
        db (datom/db c)
        roots (into [] ((:roots k) db))
        unseeded (filter (fn [r] (not (seeded? db r))) roots)
        cur (cursor db feed)]
    (cond
      ;; M2: no cursor → take the start token FIRST, then seed, then commit it
      (nil? cur)
        (let [st ((:start-token feed) (:get k))]
          (if (contains? st :error) (do (record-error! k (:error st)) st)
            (let [seeds (map (fn [r] (seed-root! k r)) roots)
                  bad (first (filter (fn [s] (contains? s :error)) seeds))]
              (if (some? bad) (do (record-error! k (:error bad)) bad)
                (do (datom/transact! c [{:db/id -1 :feed/key fk :feed/cursor (:ok st) :feed/stepped-at (now)}])
                    {:ok :seeded :items (reduce + 0 (map :ok seeds)) :cursor (:ok st)})))))
      ;; M4: a root added since the last step
      (seq unseeded)
        (let [seeds (map (fn [r] (seed-root! k r)) unseeded)
              bad (first (filter (fn [s] (contains? s :error)) seeds))]
          (if (some? bad) (do (record-error! k (:error bad)) bad)
            {:ok :seeded :items (reduce + 0 (map :ok seeds)) :cursor cur}))
      ;; page the feed; commit the cursor with the LAST page (M3)
      :else
        (loop [token cur pages 0 kept 0 dropped 0]
          (let [r ((:changes feed) (:get k) token)]
            (if (contains? r :error)
              (do (record-error! k (:error r)) (assoc r :pages pages))
              (let [db (datom/db c)
                    page (page-tx k db (closure-keys db roots) (:items (:ok r)))
                    last? (nil? (:next (:ok r)))
                    tx (if last?
                         ;; its OWN tempid: the page's allocator hands out -1,
                         ;; -2, … and a shared -1 would merge the cursor into
                         ;; the first new file (found by keep-model, shrunk to 4 steps)
                         (conj (:tx page) {:db/id CURSOR-TEMPID :feed/key fk :feed/cursor (:cursor (:ok r))
                                           :feed/stepped-at (now)})
                         (:tx page))]
                (when (seq tx) (datom/transact! c tx))
                ;; M4: folders that arrived bring their subtree
                (doseq [fk2 (:arrived page)]
                  (let [s (seed-tx k fk2 (first (filter (fn [i] (= fk2 (:key i))) (:items (:ok r)))))]
                    (when (contains? s :ok) (doseq [t (rest (:ok s))] (datom/transact! c t)))))
                (if last?
                  {:ok (if (= 0 (+ kept (:kept page))) :idle :paged)
                   :items (+ kept (:kept page)) :dropped (+ dropped (:dropped page))
                   :pages (+ 1 pages) :cursor (:cursor (:ok r))}
                  (recur (:next (:ok r)) (+ 1 pages) (+ kept (:kept page)) (+ dropped (:dropped page)))))))))))

(defn status
  "What a console shows for a feed: cursor, last step, last error, roots and
   how many of each were seeded, mirrored item count. A query, no process."
  [db feed roots]
  (let [fk (feed-key feed)
        f (into [] (datom/q '[:find ?e :in $ ?k :where [?e :feed/key ?k]] db fk))
        m (if (empty? f) {} (datom/pull db [:feed/cursor :feed/stepped-at :feed/error :feed/error-at] (first (first f))))]
    {:feed fk
     :cursor (:feed/cursor m)
     :stepped-at (:feed/stepped-at m)
     :error (:feed/error m)
     :error-at (:feed/error-at m)
     :roots (mapv (fn [r] {:root r :seeded (boolean (seeded? db r))
                           :items (let [e (eid db r)] (if (nil? e) 0 (count (files/descendants db e))))})
                  roots)}))
