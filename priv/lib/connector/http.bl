; connector/http.bl — bytes over a wire, and nothing about what they mean.
;
; Kept apart from `connector.bl` on purpose. A `conn` is a connection: an
; identity, a grant, a store, a budget line. This is the layer that turns a URL
; and a token into a decoded value, and it knows nothing about either — which
; is what lets the same transport serve Gmail, Drive, and (later) a Graph or an
; S3 endpoint without learning a single one of their names.
;
; Returns VALUES for every outcome. A transport that raises forces every caller
; to wrap it, and a caller that wraps it badly turns `the wifi dropped` into a
; stack trace — the one thing a long backfill must never do, because the
; resumption point is decided by the error's SHAPE (:retry vs :reauth), not by
; whether an exception happened to escape.

(ns connector.http)

(defn ensure-apps []
  (Application/ensure_all_started :ssl)
  (Application/ensure_all_started :inets))

(defn get-json
  "GET `url` with `token` as a bearer. → {:ok decoded} | {:error {:status n :body b}}.

   `:status 0` is a transport failure (no response at all) — a different animal
   from a 500, and the difference matters: a 500 is the server saying no, and a
   0 is nobody answering. One is worth retrying with a backoff, the other is
   worth checking the network for."
  [url token]
  (ensure-apps)
  (let [r (httpc/request :get
            (tuple (String/to_charlist url)
                   (list (tuple (String/to_charlist "authorization")
                                (String/to_charlist token))))
            (list (tuple :timeout 30000))
            (list (tuple :body_format :binary)))]
    (if (= :ok (elem r 0))
      (let [resp (elem r 1)
            status (elem (elem resp 0) 1)
            body (elem resp 2)]
        (if (and (>= status 200) (< status 300))
          {:ok (erlang/apply :json :decode (list body))}
          {:error {:status status :body body}}))
      {:error {:status 0 :body (elem r 1)}})))

(defn post-form
  "POST a form-encoded body. → {:ok decoded} | {:error {:status n :body b}}.

   The content type is the THIRD element of the request tuple and nowhere else.
   Putting it in the header list as well sends it twice, and the endpoint
   answers `malformed request` with an HTML body — measured, against the real
   token endpoint, where the JSON error should have been."
  [url body]
  (ensure-apps)
  (let [ct (String/to_charlist "application/x-www-form-urlencoded")
        r (httpc/request :post
            (tuple (String/to_charlist url) (list) ct body)
            (list (tuple :timeout 30000))
            (list (tuple :body_format :binary)))]
    (if (= :ok (elem r 0))
      (let [resp (elem r 1)
            status (elem (elem resp 0) 1)
            b (elem resp 2)]
        (if (and (>= status 200) (< status 300))
          {:ok (erlang/apply :json :decode (list b))}
          {:error {:status status :body b}}))
      {:error {:status 0 :body (elem r 1)}})))

(defn get-bytes
  "GET `url` as BYTES with `token` as a bearer. → {:ok bin :content-type s} |
   {:error {:status n :reason kw? :body b}}.

   `max-bytes` is decided BEFORE the body is kept when the server sends a
   Content-Length (the common case for Drive downloads), and checked on the
   received body otherwise — so an oversized file is refused by name
   (`:too-large`), never half-ingested. Status 0 is a transport failure, as in
   `get-json`."
  [url token max-bytes]
  (ensure-apps)
  (let [r (httpc/request :get
            (tuple (String/to_charlist url)
                   (list (tuple (String/to_charlist "authorization") (String/to_charlist token))))
            (list (tuple :timeout 120000) (tuple :autoredirect true))
            (list (tuple :body_format :binary)))]
    (if (= :ok (elem r 0))
      (let [resp (elem r 1)
            status (elem (elem resp 0) 1)
            headers (elem resp 1)
            body (elem resp 2)
            hdr (fn [nm] (let [h (first (filter (fn [p] (= nm (String/downcase (erlang/list_to_binary (elem p 0))))) (to-list headers)))]
                           (if (nil? h) nil (erlang/list_to_binary (elem h 1)))))
            declared (let [cl (hdr "content-length")] (if (nil? cl) nil (String/to_integer cl)))]
        (cond
          (not (and (>= status 200) (< status 300))) {:error {:status status :body body}}
          (and (some? declared) (> declared max-bytes)) {:error {:status status :reason :too-large :size declared}}
          (> (erlang/byte_size body) max-bytes) {:error {:status status :reason :too-large :size (erlang/byte_size body)}}
          :else {:ok body :content-type (hdr "content-type")}))
      {:error {:status 0 :body (elem r 1)}})))
