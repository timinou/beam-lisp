; connector/microsoft/fake_graph.bl — Microsoft (Entra + Graph) as a SERVED
; `veritas.model`: the model's state is the tenant, the HTTP endpoints are
; commands with :request/:response, and everything a real tenant does to a
; client over time (rename, move, delete, stale cursor, throttle, secret
; rotation, site-grant revoke) is a non-HTTP command driven by `:inject!`
; or by `vm/check` histories. One state machine, two drivers — no second
; hand-written fake to drift from the model.
;
; Fidelity per knowledger docs/22-m365-test-tenant.md §1.3:
;   token       client_credentials; TTL 3600 s enforced; bad secret → 401
;               invalid_client AADSTS7000215; unknown app/tenant → 400 with
;               AADSTS700016 / AADSTS90002
;   least priv. every Graph call needs a Bearer THIS fake issued, for a consented
;               app (else 401 InvalidAuthenticationToken), and a granted site
;               (else 403 accessDenied)
;   ids         stable across rename and move; cTag = content hash, absent on folders
;   delta       root only; pages of `page-size` (default 2); nextLink/deltaLink
;               are FULL urls on the fake's own host (taken from the request's
;               Host header); `deleted` facet; moving a folder in emits the
;               FOLDER ONLY; stale cursor → 410 + Location + code
;               resyncChangesApplyDifferences; the drive-root item is not emitted
;   download    /content → 302 to /_fake/blob/<token> (60 s, NO auth needed —
;               pre-authenticated), which serves raw bytes
;   throttle    next n authorised calls → 429 Retry-After: 1
;
;   permissions GET /drives/:d/items/:i/permissions (paged) returns EFFECTIVE
;               grants, computed here the way SharePoint does: an item inherits
;               its parent's list until it has UNIQUE permissions (break-
;               inheritance copies or empties); no `inheritedFrom`. The OWNER-VIEW
;               RULE (docs/connectors/rights-as-relations.md §1): with the app's
;               site role :read only permissions granting the APP are listed;
;               with :fullcontrol everything is. Permission changes do NOT enter
;               the delta log (no deltashowsharingchanges).
;   groups      GET /groups/:g/transitiveMembers (paged): users and nested
;               groups, flattened; cycles terminate.
;
; Not modelled: deltashowsharingchanges, multiple parents, versions, large-file
; upload sessions, sharing-link tokens, per-user hidden group membership.

(ns connector.microsoft.fake-graph
  (:require [veritas.model :as vm] [connector.microsoft.graph :as g]))

(def TOKEN-TTL-MS 3600000)
(def BLOB-TTL-MS 60000)
(def ^:private SCOPE "https://graph.microsoft.com/.default")

(defn- now [] (erlang/system_time :millisecond))
(defn- err [code msg] {:error {:code code :message msg}})

;; ── pure state transitions (shared by commands and the seed) ────────────────

(defn- touch
  "Log `id` as changed and bump its version (eTag). A change is reported once
   per window with the item's CURRENT state, as Graph coalesces."
  [d id]
  (-> d (update :log conj id) (update :t inc)
        (update-in [:items id :version] (fnil inc 0))))

(defn- upd [s did f] (update-in s [:drives did] f))

(defn add-item
  "Add file/folder `id` under `parent` in drive `did`."
  [s did id {:keys [parent name folder? content]}]
  (upd s did (fn [d] (touch (assoc-in d [:items id]
                                      {:name name :parent parent :folder? (= true folder?)
                                       :content content :version 0 :mt (:t d)})
                            id))))

(defn edit-item [s did id content]
  (upd s did (fn [d] (touch (-> d (assoc-in [:items id :content] content) (assoc-in [:items id :mt] (:t d))) id))))
(defn rename-item [s did id name] (upd s did (fn [d] (touch (assoc-in d [:items id :name] name) id))))
(defn move-item [s did id parent] (upd s did (fn [d] (touch (assoc-in d [:items id :parent] parent) id))))
(defn delete-item [s did id] (upd s did (fn [d] (touch (assoc-in d [:items id :deleted] true) id))))

(defn visible-under
  "Ids a real drive shows under `root` in drive `did` of model state `s`
   (transitively; deleted items and everything below them excluded) — the
   model's truth for a keep's invariants."
  [s did root]
  (let [items (get-in s [:drives did :items])
        kids (fn [p] (keep (fn [[id it]] (if (and (= p (:parent it)) (not (:deleted it))) id nil))
                           (into [] items)))]
    (loop [frontier [root] out #{}]
      (if (empty? frontier) out
        (let [ks (mapcat kids frontier)]
          (recur (into [] ks) (into out ks)))))))

;; ── json shapes ─────────────────────────────────────────────────────────────

(def ^:private MIMES
  {"pdf" "application/pdf" "md" "text/markdown" "txt" "text/plain"
   "docx" "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
   "xlsx" "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"})

(defn- mime-of [name]
  (let [parts (String/split (or name "") ".")]
    (get MIMES (String/downcase (last parts)) "application/octet-stream")))

(defn- sha [content]
  (String/downcase (Base/encode16 (crypto/hash :sha256 (or content "")))))

(defn- iso [t]
  (str "2026-10-04T10:" (+ 10 (rem (quot t 60) 50)) ":" (+ 10 (rem t 50)) "Z"))

(defn- item-json [did id it root-id]
  (let [content (or (:content it) "")]
    (cond-> {"id" id "name" (:name it) "size" (erlang/byte_size content)
             "lastModifiedDateTime" (iso (:mt it))
             "eTag" (str "\"{" id "},v" (:version it) "\"")}
      (= id root-id) (assoc "root" {})
      (not= id root-id) (assoc "parentReference" {"driveId" did "id" (:parent it)})
      (:folder? it) (assoc "folder" {"childCount" 0})
      (not (:folder? it)) (assoc "file" {"mimeType" (mime-of (:name it))}
                                 "cTag" (str "\"c:{" id "},h" (sha (:content it)) "\""))
      )))

(defn- deleted-json [id] {"id" id "deleted" {"state" "deleted"}})

;; ── gate: every Graph call passes the same four questions, in order ─────────

(defn- bearer [req]
  (let [h (get (:headers req) "authorization")]
    (if (and (string? h) (starts-with? h "Bearer ")) (subs h 7) nil)))

(defn- authed? [s req]
  (let [t (get (:tokens s) (bearer req))]
    (boolean (and t (> (:exp t) (now)) (get-in s [:apps (:app t) :consented])))))

(defn- site-of-drive [s did] (get-in s [:drives did :site]))
(defn- granted? [s site-id] (= true (get-in s [:sites site-id :granted])))

(defn- tick
  "Run before every Graph call's own :next: forget the last outcome, and eat one
   throttle if the call is authorised."
  [s req]
  (let [s (assoc s :last {})]
    (if (and (pos? (:throttle s)) (authed? s req))
      (-> s (update :throttle dec) (assoc :last {:throttled true}))
      s)))

(defn- gate
  "The response for a Graph call: 401, 429, 403, else `(f)`."
  [s req site-id f]
  (cond
    (not (authed? s req))
      {:status 401 :headers {"WWW-Authenticate" "Bearer"}
       :body (err "InvalidAuthenticationToken" "Access token is empty, expired, or not issued for this tenant.")}
    (get-in s [:last :throttled])
      {:status 429 :headers {"Retry-After" "1"} :body (err "activityLimitReached" "The request has been throttled.")}
    (and (some? site-id) (not (granted? s site-id)))
      {:status 403 :body (err "accessDenied" "Access denied (no grant for this site under Sites.Selected).")}
    :else (f)))

(defn- base-of [req] (str "http://" (get (:headers req) "host") "/v1.0"))
(defn- not-found [] {:status 404 :body (err "itemNotFound" "The resource could not be found.")})

(defn- drive-id [req] (get (:params req) "d"))
(defn- root-of [s did] (get-in s [:drives did :root]))
(defn- live-item [s did id]
  (let [it (get-in s [:drives did :items id])] (if (or (nil? it) (:deleted it)) nil it)))

;; ── delta ───────────────────────────────────────────────────────────────────

(defn- token-str [epoch from off]
  (str "e" epoch "-" from (if (nil? off) "" (str "-" off))))

(defn- delta-url [req did tok]
  (str (base-of req) "/drives/" did "/root/delta" (if (nil? tok) "" (str "?token=" tok))))

(defn- delta-body [s req]
  (let [did (drive-id req)
        d (get-in s [:drives did])
        root-id (:root d)
        tok (get (:query req) "token")
        epoch (:epoch s)
        n (count (:log d))]
    (if (= tok "latest")
      {:body {"value" [] "@odata.deltaLink" (delta-url req did (token-str epoch n nil))}}
      (let [ps (if (nil? tok) [(str "e" epoch) "0"] (String/split tok "-"))
            tok-epoch (first ps)
            from (String/to_integer (second ps))
            off (if (> (count ps) 2) (String/to_integer (nth ps 2)) 0)]
        (if (not= tok-epoch (str "e" epoch))
          {:status 410 :headers {"Location" (delta-url req did nil)}
           :body (err "resyncChangesApplyDifferences" "The delta token is no longer valid; re-enumerate.")}
          (let [ids (into [] (reverse (distinct (reverse (drop from (:log d))))))
                ids (into [] (filter (fn [id] (not= id root-id)) ids))
                chunk (into [] (take (:page-size s) (drop off ids)))
                more (< (+ off (:page-size s)) (count ids))
                value (mapv (fn [id] (let [it (get-in d [:items id])]
                                       (if (:deleted it) (deleted-json id) (item-json did id it root-id))))
                            chunk)]
            {:body (if more
                     {"value" value
                      "@odata.nextLink" (delta-url req did (token-str epoch from (+ off (:page-size s))))}
                     {"value" value
                      "@odata.deltaLink" (delta-url req did (token-str epoch n nil))})}))))))

;; ── children (paged by nextLink) ────────────────────────────────────────────

(defn- children-body [s req parent-id]
  (let [did (drive-id req)
        d (get-in s [:drives did])
        kids (into [] (sort (keep (fn [[id it]] (if (and (= parent-id (:parent it)) (not (:deleted it))) id nil))
                                  (into [] (:items d)))))
        off (let [p (get (:query req) "skip")] (if (nil? p) 0 (String/to_integer p)))
        chunk (into [] (take (:page-size s) (drop off kids)))
        more (< (+ off (:page-size s)) (count kids))]
    {:body (cond-> {"value" (mapv (fn [id] (item-json did id (get-in d [:items id]) (:root d))) chunk)}
             more (assoc "@odata.nextLink"
                         (str "http://" (get (:headers req) "host") (:path req) "?skip=" (+ off (:page-size s)))))}))

;; ── permissions ─────────────────────────────────────────────────────────────
;
; Grantee = {:type :user|:group|:site-group|:link|:app :id …}; a link is
; {:type :link :scope "organization"|"anonymous"|"users"|"existingAccess"
; :users [uid …]}. A permission = {:id :grantee :role}. Directory:
; (:users s) {uid {:mail :name}}, (:groups s) {gid {:name :members [[:user uid]
; | [:group gid] …]}}.

(defn- own-perms [s did id] (get-in s [:drives did :items id :perms] []))

(defn effective-perms
  "What SharePoint lists for `id`: its own list when it has unique permissions
   (or is the root), else its parent's effective list."
  [s did id]
  (loop [x id n 0]
    (let [it (get-in s [:drives did :items x])]
      (if (or (nil? it) (> n 64)) []
        (if (or (:unique? it) (nil? (:parent it))) (own-perms s did x)
          (recur (:parent it) (+ n 1)))))))

(defn- next-perm-id [s] (str "perm-" (:seq s)))

(defn share
  "Grant `grantee` `role` on `id`. Sharing an inheriting item gives it unique
   permissions first (copy of what it inherited), as SharePoint does."
  [s did id grantee role]
  (let [s (if (get-in s [:drives did :items id :unique?]) s
            (-> s (assoc-in [:drives did :items id :perms] (effective-perms s did id))
                  (assoc-in [:drives did :items id :unique?] true)))
        pid (next-perm-id s)]
    (-> s (update :seq inc)
          (update-in [:drives did :items id :perms] conj {:id pid :grantee grantee :role role}))))

(defn unshare
  "Remove the direct permissions of `grantee` on a UNIQUE `id`; on an inheriting
   item it removes nothing (the grant lives on an ancestor)."
  [s did id grantee]
  (if (get-in s [:drives did :items id :unique?])
    (update-in s [:drives did :items id :perms] (fn [ps] (into [] (remove (fn [p] (= (:grantee p) grantee)) ps))))
    s))

(defn break-inheritance
  "Give `id` unique permissions: a COPY of its effective list when `keep?`, else empty."
  [s did id keep?]
  (-> s (assoc-in [:drives did :items id :perms] (if keep? (effective-perms s did id) []))
        (assoc-in [:drives did :items id :unique?] true)))

(defn group-users
  "User ids that are (transitively) members of group `gid` — the model's truth
   for group expansion; a cycle terminates."
  [s gid]
  (loop [frontier [gid] seen #{} users #{}]
    (if (empty? frontier) users
      (let [ms (mapcat (fn [g] (get-in s [:groups g :members] [])) frontier)
            us (map second (filter (fn [m] (= :user (first m))) ms))
            gs (remove (fn [g] (contains? seen g)) (map second (filter (fn [m] (= :group (first m))) ms)))]
        (recur (into [] (distinct gs)) (into seen frontier) (into users us))))))

(defn- user-json [s uid]
  (let [u (get-in s [:users uid])]
    (cond-> {"id" uid "displayName" (or (:name u) uid)} (some? (:mail u)) (assoc "email" (:mail u)))))

(defn- grantee-set [s g]
  (case (:type g)
    :user {"user" (user-json s (:id g))}
    :group {"group" {"id" (:id g) "displayName" (get-in s [:groups (:id g) :name] (:id g))}}
    :site-group {"siteGroup" {"id" (:id g) "displayName" (str "Site group " (:id g))}}
    :app {"application" {"id" (:id g) "displayName" "knowledger"}}
    {}))

(defn- perm-json [s p]
  (let [g (:grantee p)]
    (if (= :link (:type g))
      (cond-> {"id" (:id p) "roles" [(:role p)] "link" {"scope" (:scope g) "type" (:role p)}}
        (= "users" (:scope g)) (assoc "grantedToIdentitiesV2" (mapv (fn [u] (grantee-set s {:type :user :id u})) (:users g))))
      {"id" (:id p) "roles" [(:role p)] "grantedToV2" (grantee-set s g)})))

(defn- site-role [s did] (get-in s [:sites (site-of-drive s did) :role] :read))

(defn visible-perms
  "The permission resources the APP is shown for `id`: always its own site grant
   as an application permission; the real list only with the :fullcontrol role."
  [s did id]
  (let [role (site-role s did)
        app {:id "app-site-grant" :grantee {:type :app :id (:client-id s)} :role (name role)}]
    (if (= role :fullcontrol)
      (into (effective-perms s did id) [app])
      [app])))

(defn- permissions-body [s req did id]
  (let [ps (visible-perms s did id)
        off (let [p (get (:query req) "skip")] (if (nil? p) 0 (String/to_integer p)))
        chunk (into [] (take (:page-size s) (drop off ps)))
        more (< (+ off (:page-size s)) (count ps))]
    {:body (cond-> {"value" (mapv (fn [p] (perm-json s p)) chunk)}
             more (assoc "@odata.nextLink"
                         (str "http://" (get (:headers req) "host") (:path req) "?skip=" (+ off (:page-size s)))))}))

(defn- members-body [s req gid]
  (let [g (get-in s [:groups gid])
        flat (loop [frontier [gid] seen #{gid} out []]
               (if (empty? frontier) out
                 (let [ms (mapcat (fn [x] (get-in s [:groups x :members] [])) frontier)
                       fresh (remove (fn [m] (or (and (= :group (first m)) (contains? seen (second m))))) ms)]
                   (recur (into [] (distinct (map second (filter (fn [m] (= :group (first m))) fresh))))
                          (into seen (map second (filter (fn [m] (= :group (first m))) ms)))
                          (into out fresh)))))
        flat (into [] (distinct flat))
        off (let [p (get (:query req) "skip")] (if (nil? p) 0 (String/to_integer p)))
        chunk (into [] (take (:page-size s) (drop off flat)))
        more (< (+ off (:page-size s)) (count flat))
        json (fn [m] (if (= :user (first m))
                       (let [u (get-in s [:users (second m)])]
                         {"@odata.type" "#microsoft.graph.user" "id" (second m) "displayName" (or (:name u) (second m))
                          "mail" (:mail u) "userPrincipalName" (:mail u)})
                       {"@odata.type" "#microsoft.graph.group" "id" (second m) "displayName" (get-in s [:groups (second m) :name])}))]
    (if (nil? g) (not-found)
      {:body (cond-> {"value" (mapv json chunk)}
               more (assoc "@odata.nextLink"
                           (str "http://" (get (:headers req) "host") (:path req) "?skip=" (+ off (:page-size s)))))})))

;; ── the model ───────────────────────────────────────────────────────────────

(defn- mint-tok [s app]
  (let [tok (str "fake-token-" (:seq s))]
    [tok (-> s (update :seq inc) (assoc-in [:tokens tok] {:app app :exp (+ (now) TOKEN-TTL-MS)}))]))

(defn- token-next [s req]
  (let [s (assoc s :last {})
        b (or (:body req) {})
        app (get-in s [:apps (get b "client_id")])]
    (cond
      (not= (:tenant s) (get (:params req) "tenant")) (assoc s :last {:oauth :unknown-tenant})
      (nil? app) (assoc s :last {:oauth :unknown-app})
      (not= (:secret app) (get b "client_secret")) (assoc s :last {:oauth :bad-secret})
      (not= "client_credentials" (get b "grant_type")) (assoc s :last {:oauth :bad-grant})
      (not= SCOPE (get b "scope")) (assoc s :last {:oauth :bad-scope})
      :else (let [[tok s2] (mint-tok s (get b "client_id"))] (assoc s2 :last {:token tok})))))

(defn- oauth-error [kind]
  (case kind
    :bad-secret {:status 401 :body {"error" "invalid_client" "error_codes" [7000215]
                                    "error_description" "AADSTS7000215: Invalid client secret provided."}}
    :unknown-app {:status 400 :body {"error" "unauthorized_client" "error_codes" [700016]
                                     "error_description" "AADSTS700016: Application not found in the directory."}}
    :unknown-tenant {:status 400 :body {"error" "invalid_request" "error_codes" [90002]
                                        "error_description" "AADSTS90002: Tenant not found."}}
    :bad-scope {:status 400 :body {"error" "invalid_scope" "error_codes" [70011]
                                   "error_description" "AADSTS70011: The provided scope is invalid."}}
    {:status 400 :body {"error" "unsupported_grant_type" "error_codes" [70003]
                        "error_description" "AADSTS70003: unsupported grant type."}}))

(defn- site-json [s sid]
  (let [st (get-in s [:sites sid])]
    {"id" sid "name" (last (String/split (:path st) "/")) "displayName" (:name st)
     "webUrl" (str "https://" (:host st) (:path st))}))

(defn- drive-json [did] {"id" did "driveType" "documentLibrary" "name" "Documents"})

(defn- site-by-address [s rest]
  (let [parts (String/split rest ":")
        host (first parts)
        path (String/trim_trailing (join ":" (drop 1 parts)) ":")]
    (core/some (fn [[sid st]] (if (and (= host (:host st)) (= path (:path st))) sid nil))
               (into [] (:sites s)))))

(defn- drive-cmd
  "A /drives/:d/... endpoint: the shared tick/gate around `body-f` (s req did)."
  [pattern body-f]
  {:request [:get pattern]
   :next (fn [s req] (tick s req))
   :response (fn [s req]
               (let [did (drive-id req)]
                 (if (nil? (get-in s [:drives did]))
                   (if (authed? s req) (not-found) (gate s req nil (fn [] nil)))
                   (gate s req (site-of-drive s did) (fn [] (body-f s req did))))))})

(defn- site-cmd [pattern body-f]
  {:request [:get pattern]
   :next (fn [s req] (tick s req))
   :response (fn [s req]
               (let [sid (get (:params req) "id")]
                 (if (nil? (get-in s [:sites sid]))
                   (if (authed? s req) (not-found) (gate s req nil (fn [] nil)))
                   (gate s req sid (fn [] (body-f s req sid))))))})

(def commands
  {;; ── served endpoints ───────────────────────────────────────────────────
   :token {:request [:post "/:tenant/oauth2/v2.0/token"]
           :next token-next
           :response (fn [s _]
                       (let [l (:last s)]
                         (if (:token l)
                           {:body {"token_type" "Bearer" "expires_in" 3600 "ext_expires_in" 3600
                                   "access_token" (:token l)}}
                           (oauth-error (:oauth l)))))}

   ;; `*rest` also matches /sites/:id/drives — :pre keeps this to host:path forms
   :site-by-path {:request [:get "/v1.0/sites/*rest"]
                  :pre (fn [_ req] (String/contains? (get (:params req) "rest") ":"))
                  :next (fn [s req] (tick s req))
                  :response (fn [s req]
                              (let [sid (site-by-address s (get (:params req) "rest"))]
                                (if (nil? sid)
                                  (if (authed? s req) (not-found) (gate s req nil (fn [] nil)))
                                  (gate s req sid (fn [] {:body (site-json s sid)})))))}

   :site-drives (site-cmd "/v1.0/sites/:id/drives"
                          (fn [s _ sid]
                            {:body {"value" (mapv drive-json (sort (keep (fn [[did d]] (if (= sid (:site d)) did nil))
                                                                         (into [] (:drives s)))))}}))
   :site-drive (site-cmd "/v1.0/sites/:id/drive"
                         (fn [s _ sid]
                           (let [did (first (sort (keep (fn [[did d]] (if (= sid (:site d)) did nil)) (into [] (:drives s)))))]
                             (if (nil? did) (not-found) {:body (drive-json did)}))))

   :delta (drive-cmd "/v1.0/drives/:d/root/delta" (fn [s req _] (delta-body s req)))
   :item (drive-cmd "/v1.0/drives/:d/items/:id"
                    (fn [s req did]
                      (let [id (get (:params req) "id") it (live-item s did id)]
                        (if (nil? it) (not-found) {:body (item-json did id it (root-of s did))}))))
   :children (drive-cmd "/v1.0/drives/:d/items/:id/children"
                        (fn [s req did]
                          (let [id (get (:params req) "id")]
                            (if (nil? (live-item s did id)) (not-found) (children-body s req id)))))
   :permissions (drive-cmd "/v1.0/drives/:d/items/:id/permissions"
                           (fn [s req did]
                             (let [id (get (:params req) "id")]
                               (if (nil? (live-item s did id)) (not-found) (permissions-body s req did id)))))
   :transitive-members {:request [:get "/v1.0/groups/:g/transitiveMembers"]
                        :next (fn [s req] (tick s req))
                        :response (fn [s req]
                                    (gate s req nil (fn [] (members-body s req (get (:params req) "g")))))}
   :root-children (drive-cmd "/v1.0/drives/:d/root/children"
                             (fn [s req did] (children-body s req (root-of s did))))

   ;; /content: the 302 to a pre-authenticated blob; the blob token is minted
   ;; in :next so the state, not the response, owns it
   :content {:request [:get "/v1.0/drives/:d/items/:id/content"]
             :next (fn [s req]
                     (let [s (tick s req)
                           did (drive-id req) id (get (:params req) "id")
                           it (live-item s did id)]
                       (if (and (nil? (get-in s [:last :throttled])) (authed? s req) (granted? s (site-of-drive s did))
                                (some? it) (not (:folder? it)))
                         (let [tok (str "blob-" (:seq s))]
                           (-> s (update :seq inc)
                               (assoc-in [:blobs tok] {:content (or (:content it) "") :name (:name it) :exp (+ (now) BLOB-TTL-MS)})
                               (assoc :last {:blob tok})))
                         s)))
             :response (fn [s req]
                         (let [did (drive-id req)
                               tok (get-in s [:last :blob])]
                           (if (nil? (get-in s [:drives did]))
                             (if (authed? s req) (not-found) (gate s req nil (fn [] nil)))
                             (gate s req (site-of-drive s did)
                                   (fn [] (if (nil? tok) (not-found)
                                            {:status 302 :headers {"Location" (str "http://" (get (:headers req) "host") "/_fake/blob/" tok)}}))))))}

   :blob {:request [:get "/_fake/blob/:t"]
          :response (fn [s req]
                      (let [b (get (:blobs s) (get (:params req) "t"))]
                        (if (or (nil? b) (<= (:exp b) (now)))
                          {:status 404 :body (err "itemNotFound" "blob expired")}
                          {:raw (:content b) :content-type (mime-of (:name b))})))}

   ;; ── world changes (no HTTP; :inject! or a check history) ───────────────
   :add-file {:next (fn [s [did id parent name content]] (add-item s did id {:parent parent :name name :content content}))}
   :add-folder {:next (fn [s [did id parent name]] (add-item s did id {:parent parent :name name :folder? true}))}
   :edit {:next (fn [s [did id content]] (edit-item s did id content))}
   :rename {:next (fn [s [did id name]] (rename-item s did id name))}
   :move {:next (fn [s [did id parent]] (move-item s did id parent))}
   ;; Deleting a folder deletes what is under it, each reported with a deleted
   ;; facet. ASSUMED (docs/connectors/microsoft-graph.md): real Graph may report
   ;; the folder alone; a keep that is correct for both marks descendants gone
   ;; via the folder and tolerates the extra items.
   :delete {:next (fn [s [did id]]
                    (let [under (conj (visible-under s did id) id)]
                      (reduce (fn [s2 x] (delete-item s2 did x)) s (sort under))))}

   ;; ── faults and governance ───────────────────────────────────────────────
   :expire-cursors {:next (fn [s _] (update s :epoch inc))}
   :throttle {:next (fn [s n] (assoc s :throttle n))}
   :rotate-secret {:next (fn [s new-secret] (assoc-in s [:apps (:client-id s) :secret] new-secret))}
   ;; `sid` or `[sid role]`; role :read (default — least privilege) | :fullcontrol.
   ;; The role decides what /permissions shows the app (owner-view rule).
   :grant-site {:next (fn [s a] (let [sid (if (vector? a) (first a) a)
                                       role (if (vector? a) (second a) :read)]
                                   (-> s (assoc-in [:sites sid :granted] true) (assoc-in [:sites sid :role] role))))}
   ;; ── permission changes (not in the delta log) ────────────────────────────
   :share {:next (fn [s [did id grantee role]] (share s did id grantee role))}
   :unshare {:next (fn [s [did id grantee]] (unshare s did id grantee))}
   :break-inheritance {:next (fn [s [did id keep?]] (break-inheritance s did id keep?))}
   :add-member {:next (fn [s [gid member]] (update-in s [:groups gid :members]
                                                      (fn [ms] (let [ms (or ms [])] (if (some (fn [m] (= m member)) ms) ms (conj ms member))))))}
   :remove-member {:next (fn [s [gid member]] (update-in s [:groups gid :members]
                                                         (fn [ms] (into [] (remove (fn [m] (= m member)) (or ms []))))))}
   :revoke-site {:next (fn [s sid] (assoc-in s [:sites sid :granted] false))}
   ;; every issued token is now past its TTL (a clock jump, not a deletion)
   :expire-token {:next (fn [s _] (update s :tokens (fn [ts] (into {} (map (fn [[k v]] [k (assoc v :exp 0)]) (into [] ts))))))}})

(def model
  (vm/model "microsoft-graph" {:state {} :commands commands}))

;; ── the tenant, as docs/22 §1.2 lays it out ─────────────────────────────────

(def TENANT "00000000-0000-0000-0000-00000000f00d")
(def CLIENT-ID "11111111-0000-0000-0000-00000000a000")
(def SECRET "local-only-secret")
(def SITE-HOST "contoso.sharepoint.com")
(def SITE-PATH "/sites/knowledger-test")
(def DRIVE "b!knowledger-test-documents")
(def OTHER-DRIVE "b!other-site-documents")
(def SITE-ID "contoso.sharepoint.com,kt-guid,kt-web")
(def OTHER-SITE-ID "contoso.sharepoint.com,other-guid,other-web")

(defn seed
  "The docs/22 §1.2 tree. `other-site` exists but is NOT granted."
  [opts]
  (let [f (fn [s id parent name content] (add-item s DRIVE id {:parent parent :name name :content content}))
        d (fn [s id parent name] (add-item s DRIVE id {:parent parent :name name :folder? true}))]
    (-> {:tenant TENANT :client-id CLIENT-ID
         :apps {CLIENT-ID {:secret (get opts :secret SECRET) :consented true}}
         :sites {SITE-ID {:host SITE-HOST :path SITE-PATH :name "Knowledger Test" :granted true}
                 OTHER-SITE-ID {:host SITE-HOST :path "/sites/other-site" :name "Other Site" :granted false}}
         :drives {DRIVE {:site SITE-ID :root "root" :log [] :t 1000
                         :items {"root" {:name "Documents" :parent nil :folder? true :version 0 :mt 1000
                                  ;; the library's inherited default: Everyone (lawyers + youssef) reads
                                  :perms [{:id "p-root-all" :grantee {:type :group :id "g-all"} :role "read"}]}}}
                  OTHER-DRIVE {:site OTHER-SITE-ID :root "oroot" :log [] :t 1000
                               :items {"oroot" {:name "Documents" :parent nil :folder? true :version 0 :mt 1000}
                                       "osecret" {:name "other.md" :parent "oroot" :content "other" :version 0 :mt 1000}}}}
         :users {"u-amina" {:mail "amina@contoso.com" :name "Amina"}
                 "u-youssef" {:mail "youssef@contoso.com" :name "Youssef"}
                 "u-omar" {:mail "omar@contoso.com" :name "Omar"}}
         :groups {"g-lawyers" {:name "Lawyers" :members [[:user "u-amina"]]}
                  "g-all" {:name "Everyone" :members [[:group "g-lawyers"] [:user "u-youssef"]]}}
         :tokens {} :blobs {} :seq 1 :epoch 0 :throttle 0 :last {}
         :page-size (get opts :page-size 2)}
        (d "clients" "root" "Clients")
        (d "dupont" "clients" "Dupont — 2026-014")
        (f "engagement" "dupont" "engagement-letter.pdf" "%PDF engagement")
        (f "memo" "dupont" "memo.md" "# memo")
        (d "unique" "dupont" "Unique")
        (f "priv" "unique" "privileged.md" "privileged")
        (f "pleadings" "root" "Pleadings 2026.docx" "docx bytes")
        (d "benali" "root" "Benali")
        (f "notes" "benali" "notes.md" "notes")
        (d "outside" "root" "Outside")
        (f "hr" "outside" "hr-salaries.xlsx" "salaries"))))

(defn start!
  "Serve a seeded tenant on loopback. opts {:page-size 2 :secret SECRET}. →
   {:server <vm/serve handle> :graph-base … :login-base … :tenant :client-id
    :client-secret :site-host :site-path :drive :site-id :stop (fn [])}.
   Everything a connector needs is in the map: `(g/endpoints {:graph-base …
   :login-base …})` is the only place the fake differs from Microsoft."
  [opts]
  (let [srv (vm/serve model {:state (seed (or opts {}))})]
    {:server srv
     :graph-base (str (:url srv) "/v1.0")
     :login-base (:url srv)
     :tenant TENANT :client-id CLIENT-ID :client-secret (get opts :secret SECRET)
     :site-host SITE-HOST :site-path SITE-PATH :drive DRIVE :site-id SITE-ID
     :stop (:stop srv)}))

(defn do!
  "Run world/fault command `nm` on a started fake: `(do! f :rename [drive id name])`."
  [f nm args] ((:inject! (:server f)) nm args))

(defn visible
  "visible-under on the fake's CURRENT state."
  [f did root] (visible-under ((:state (:server f))) did root))
