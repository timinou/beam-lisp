(ns connector.clock)

(defn system [] {:now (fn [] (erlang/system_time :millisecond)) :realtime? true})
(defn- changed! [observers token]
  ;; A clock change is a hint to read the current clock. Sending a sampled time
  ;; would let concurrent advance/restore messages invent an ordering contract.
  (doseq [pid (keys @observers)]
    (if (Process/alive? pid)
      (erlang/send pid [:connector.clock/changed token])
      (swap! observers dissoc pid))))
(defn virtual [at]
  (let [held (atom at) observers (atom {}) token (erlang/make_ref)]
    {:now (fn [] @held) :realtime? false
     :listen! (fn [] (swap! observers assoc (erlang/self) true) token)
     :unlisten! (fn [] (swap! observers dissoc (erlang/self)) :ok)
     :advance! (fn [ms]
                 (when (or (not (number? ms)) (< ms 0))
                   (throw (ex-info "Clock advances must be nonnegative milliseconds" {:code :clock})))
                 (let [value (swap! held + ms)] (changed! observers token) value))
     :restore! (fn [value] (reset! held value) (changed! observers token) value)}))
(defn now [clock] ((:now clock)))
(defn advance! [clock ms]
  (if-let [f (:advance! clock)] (f ms)
    (throw (ex-info "System clock cannot be advanced" {:code :clock}))))
(defn restore! [clock value]
  (if-let [f (:restore! clock)] (f value)
    (throw (ex-info "System clock cannot be restored" {:code :clock}))))
(defn listen!
 "Observe this clock in the CALLING process. Returns its opaque identity, or
  nil for a clock without notifications. Hints contain no cached business data."
 [clock] (when-let [f (:listen! clock)] (f)))
(defn unlisten! "Release this process's optional clock observation." [clock]
 (if-let [f (:unlisten! clock)] (f) :ok))
(defn realtime? "Whether absolute deadlines also need a real elapsed-time timer." [clock]
 (not= false (:realtime? clock)))
