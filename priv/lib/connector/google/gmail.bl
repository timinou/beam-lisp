(ns connector.google.gmail
  (:require [connector :as conn]))

(def spec
  "What Gmail IS: an endpoint, the scopes it needs, and the methods wave 1 uses.

   A spec is a VALUE, not a wrapper. Nothing here can make a request; the
   methods below are paths and names, and the requesting is `connector`'s. That
   separation is what lets the same spec drive the real transport, a mock, and
   a budget line without any of the three knowing about the others.

   `:as` is the interesting key: it says which RELATION a method IS. Not which
   relation it is *like* — `messages.get` does not resemble a bound
   `:~msg/messages`, it IS one. A method that could not name its relation would
   be a method with no way to be reached except by a bespoke call, which is the
   parallel implementation this design forbids."
  {:service :google
   :id :gmail
   :base-url "https://gmail.googleapis.com"
   :scopes ["https://www.googleapis.com/auth/gmail.readonly"]
   :resources
   {:messages
    {:list {:path "/gmail/v1/users/me/messages"
            :query [["maxResults" 100]]
            :items "messages"
            :next "nextPageToken"
            :as {:relation :~msg/messages :mode :bf}}
     :get  {:path "/gmail/v1/users/me/messages/{id}"
            :query [["format" "metadata"]
                    ["metadataHeaders" "Subject"]
                    ["metadataHeaders" "From"]]
            :as {:relation :~msg/messages :mode :bb}}}}})

(defn- header-value [msg name]
  (let [hs (to-list (get (get msg "payload") "headers"))
        hit (first (filter (fn [h] (= name (get h "name"))) hs))]
    (if (nil? hit) nil (get hit "value"))))

(defn entity
  "The identity of a message: `[:google account-id remote-id]`.

   The COMPOSITE, never the remote id alone. Two mailboxes both have a message
   `1a0c9e0ac41309a8` — Gmail's ids are not globally unique across accounts —
   so keying on the id would silently merge two people's mail into one entity,
   and the merge would look like a sync bug for as long as it took to find."
  [account-id msg]
  [:google account-id (get msg "id")])

(defn tuple
  "A message as `[entity subject from when]`, the shape `:~msg/messages` emits.

   `:when` comes from `internalDate` — epoch MILLISECONDS, as a string — and not
   from the `Date` header. The header is RFC 2822 in whatever timezone the
   sender's client chose, and parsing it is a small project with a long tail of
   malformed senders; `internalDate` is the same instant, already normalised."
  [account-id msg]
  (let [d (get msg "internalDate")]
    [(entity account-id msg)
     (header-value msg "Subject")
     (header-value msg "From")
     (if (nil? d) nil (erlang/binary_to_integer d))]))

(defn fetch
  "Messages from one connection, as tuples. → {:ok [tuple …]} | {:error …}.

   N+1 requests, and that is stated rather than hidden: Gmail's `messages.list`
   answers ids and thread ids and nothing else, so the metadata for each one is
   a second call. A caller wanting a thousand messages wants the batch endpoint,
   and knowing this is where the cost is is how they would find that out."
  [c {:keys [limit query]}]
  (let [ids (conn/walk c (str (:base-url spec) "/gmail/v1/users/me/messages")
                       (if (nil? query) [] [["q" query]])
                       "messages" "nextPageToken" {:limit limit})]
    (if (= :error (first (keys ids)))
      ids
      (loop [xs (to-list (get ids :ok)) acc []]
        (if (empty? xs)
          {:ok acc}
          (let [id (get (first xs) "id")
                r (conn/get! c (str (:base-url spec) "/gmail/v1/users/me/messages/" id
                                    "?format=metadata&metadataHeaders=Subject&metadataHeaders=From"))]
            (if (= :error (first (keys r)))
              {:error (get r :error) :got (count acc)}
              (recur (rest xs) (conj acc (tuple (:account-id c) (get r :ok)))))))))))
