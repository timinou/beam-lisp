; Immutable, scoped observations. Freshness is a query with explicit time,
; never a periodically mutated "fresh" flag. Partial pulls remain partial.
(ns connector.observation (:require [datom :as d] [datom.query.relation :as rel]))
(def schema
  [{:db/ident :observation/key :db/valueType :db.type/term :db/unique :db.unique/identity}
   {:db/ident :observation/query-key :db/valueType :db.type/term}
   {:db/ident :observation/at :db/valueType :db.type/long}
   {:db/ident :observation/expires-at :db/valueType :db.type/long}
   {:db/ident :observation/complete? :db/valueType :db.type/boolean}
   {:db/ident :observation/coverage :db/valueType :db.type/term}
   {:db/ident :observation/payload :db/valueType :db.type/term}])
(defn key [context query]
  (when-not (and (:connection context) (:scope context) (erlang/is_integer (:grant-generation context)))
    (throw (ex-info "Observation context needs connection, scope and grant generation" {:code :scope})))
  [(:connection context) (:scope context) (:grant-generation context) query])
(defn put! [conn context query observation]
  (when-not (and (number? (:at observation)) (number? (:expires-at observation))
                 (>= (:expires-at observation) (:at observation)) (contains? observation :complete?))
    (throw (ex-info "Observation needs bounded freshness and explicit completeness" {:code :observation})))
  (d/install-schema! conn schema)
  (let [qk (key context query)
        id [qk (:at observation) (crypto/hash :sha256 (erlang/term_to_binary observation))]]
    (d/transact! conn [{:db/id -1 :observation/key id :observation/query-key qk
                       :observation/at (:at observation) :observation/expires-at (:expires-at observation)
                       :observation/complete? (:complete? observation) :observation/coverage (:coverage observation {})
                       :observation/payload (:payload observation)}]) id))
(defn latest [database context query now]
  (let [qk (key context query)
        rows (d/q '[:find ?e :in $ ?q :where [?e :observation/query-key ?q]] database qk)
        row (last (sort-by (fn [r] [(:observation/at r) (:db/id r)]) (map (fn [[e]] (d/entity database e)) rows)))]
    (when row (assoc row :observation/fresh? (< now (:observation/expires-at row))))))
(rel/defrelation :~connector/observation
  {:arity 2 :modes #{:ff} :provenance true
   :provider (fn [database _ _ args]
               (let [[context query now] args row (latest database context query now)]
                 (if row [[(:db/id row) row]] [])))})
