; live.bl — MVP-F: proven live queries.
;
; datom.watch re-runs a query on every relevant commit and ships the
; diff. That re-derivation is SOUND only when two things hold:
;
;   1. MONOTONICITY — the query contains no negation. With [:not …] a
;      new datom can make an old answer FALSE; the {:added :removed}
;      diff stays exact (it is set difference), but "the watch tells
;      you what changed" silently becomes "the world changed under a
;      non-monotone question" — and incremental consumers that cache
;      or append break. A monotone query's answer only grows with the
;      db (modulo retractions, which the diff reports honestly).
;
;   2. HONEST EFFECTS — the question must be data-pure (monotone
;      datalog over core predicates); the callback's effect is
;      declared, reported at registration, and any ^:pure claim is
;      provable file-wide by effects/check-purity-claims.
;
; register-live! is the gate: monotone or no watch. Rejection names
; the reason — never a silent refusal, never a guess.

(ns live
  (:require [typed] [effects] [datom.watch]
            [datom.query.parse :as parse]))

; --- monotonicity -----------------------------------------------------------

(def non-monotone-heads
  "Clause heads that make a query non-monotone: negation. (or/and are
   monotone; computed relations that are monotone compose.)"
  #{:not :not-join})

(defn combinator-head
  "The keyword head of a [:or …] / [:not …] combinator clause, else nil."
  [clause]
  (if (and (vector? clause)
           (keyword? (get clause 0)))
    (get clause 0)
    nil))

(defn violations
  "Every non-monotone clause in a parsed query's :where, recursively
   (a [:not …] nested inside [:or …] still counts)."
  [clauses]
  (reduce
    (fn [acc c]
      (let [h (combinator-head c)]
        (if (nil? h)
          acc
          (concat acc
                  (if (contains? non-monotone-heads h)
                    [{:clause c :reason (str (name h) " is non-monotone: new datoms can retract old answers")}]
                    [])
                  (violations (rest c))))))
    [] clauses))

(defn check-query
  "Parse query; report {:monotone bool :violations […]}. Parse errors
   surface as :parse-error (the query was never runnable, monotone or
   not)."
  [query]
  (let [parsed (parse/parse query)
        problems (parse/validate parsed)]
    (if (seq problems)
      {:monotone false :parse-error problems}
      (let [vs (violations (:where parsed))]
        {:monotone (empty? vs) :violations vs}))))

; --- the gate -----------------------------------------------------------------
;
; Why the callback is NOT purity-gated: delivery IS an effect
; (erlang/send → :process) — a pure callback could not tell you
; anything. What must be pure is the QUESTION (monotone, data-only);
; the callback is the consumer. Its declared effect is REPORTED with
; the registration, and any ^:pure claim it carries is provable
; file-wide by effects/check-purity-claims (trust is auditable —
; the same contract as ^:opaque).

(defn callback-effect
  "The callback var's declared effect: ^:pure claim → :pure, else
   :unknown. The claim is data (Env meta); the PROOF is
   effects/check-purity-claims over the defining source."
  [ns cb-name]
  (let [m (BeamLisp.Env/meta ns cb-name)]
    (if (and (map? m) (= true (:pure m))) :pure :unknown)))

(defn register-live!
  "The gated watch. Returns {:ok watch-ref :callback-effect eff} or
   {:error reason-map}. Reasons are data, never a silent refusal:
   {:unparseable problems} or {:non-monotone [violations]}."
  [conn query inputs ns cb-name]
  (let [qcheck (check-query query)]
    (cond
      (contains? qcheck :parse-error)
        {:error {:unparseable (:parse-error qcheck)}}
      (not (:monotone qcheck))
        {:error {:non-monotone (:violations qcheck)}}
      :else
        {:ok (datom.watch/watch conn query inputs
                                (BeamLisp.Env/fetch! ns cb-name))
         :callback-effect (callback-effect ns cb-name)})))
