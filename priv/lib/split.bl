; split.bl — ONE file, two programs: `split/defapp`.
;
; A split app is an ordinary namespace of pure functions and one declaration:
;
;   (ns groceries (:require [split]))
;   (defn tick-problem [board args] …)   ; ordinary functions
;   …
;   (split/defapp groceries
;     {:wire    {…}                      ; the shapes that may cross the network
;      :server  {:init f :snapshot :t …} ; what only the server holds
;      :client  {:init f :view f :on f}  ; what each browser tab holds
;      :intents {:tick {:params {…} :check f :predict f :apply f …}}})
;
; From it come two programs. The BROWSER half is compiled to JavaScript by the
; split build (research/js-actors/compiler.bl), which also proves which of
; these functions may run there. The SERVER half is this namespace plus the
; authority loop (split.core), running natively on BEAM, served over HTTP by
; split.web. The author writes no route, codec, socket, queue or handler: the
; declaration is the only glue.
;
; `defapp` keeps the declaration TWICE: quoted (the data the contract is made
; from) and evaluated (each role symbol becomes the function it names). So the
; app value `(groceries)`-side carries both what the network may see and what
; the server may run, and nothing is generated as source.
;
; The contract is the part both halves must agree on — wire types, the
; snapshot type, each intent's parameter record — as data. Its canonical JSON
; is hashed, and both halves carry the hash (the DIGEST): two halves built
; from different declarations refuse each other (`:client-outdated`). The JS
; build computes the same bytes, so the digest a browser carries equals
; `(:digest app)` here; `test/bl/split/app_test.bl` pins that for every app.

(ns split
  (:require [split.wire] [split.core]))

; ── canonical JSON: the digest's bytes ────────────────────────────────────────

(defn- json-str
  "One JSON string literal, escaped exactly as the JS build escapes it: `\"`,
   `\\`, \\n, \\r, \\t, other controls as \\u00XX, everything else verbatim."
  [s]
  (str "\""
       (apply str
              (map (fn [c]
                     (cond
                       (= c 34) "\\\""
                       (= c 92) "\\\\"
                       (= c 10) "\\n"
                       (= c 13) "\\r"
                       (= c 9) "\\t"
                       (< c 32) (str "\\u00" (if (< c 16) "0" "") (String/downcase (Integer/to_string c 16)))
                       :else (erlang/list_to_binary (list c))))
                   (erlang/binary_to_list s)))
       "\""))

(defn- key-name [k] (if (keyword? k) (name k) (str k)))

(defn cjson
  "Canonical JSON: object keys sorted, keywords as their bare names, no
   whitespace. The contract digest is the SHA-256 of exactly these bytes."
  [v]
  (cond
    (nil? v) "null"
    (= v true) "true"
    (= v false) "false"
    (int? v) (str v)
    (string? v) (json-str v)
    (keyword? v) (json-str (name v))
    (symbol? v) (json-str (str v))
    (map? v) (str "{" (apply str (interpose "," (map (fn [k] (str (json-str (key-name k)) ":" (cjson (get v k))))
                                                     (sort-by key-name (keys v))))) "}")
    (or (vector? v) (seq? v) (set? v) (list? v)) (str "[" (apply str (interpose "," (map cjson (vec v)))) "]")
    :else (throw (ex-info "split: cjson: not contract data" {:value v}))))

(defn- hex [bin]
  (apply str (map (fn [b] (let [s (String/downcase (Integer/to_string b 16))] (if (< b 16) (str "0" s) s)))
                  (erlang/binary_to_list bin))))

(defn contract
  "The contract of declaration `decl` (the QUOTED data) for app `app-name`."
  [app-name decl]
  (let [history? (some? (get-in decl [:server :history]))
        intents (get decl :intents)]
    {:schema 1 :app app-name :wire (get decl :wire) :snapshot (get-in decl [:server :snapshot])
     :people (some? (get-in decl [:server :people]))
     :history history?
     :intents (reduce (fn [m op] (assoc m op {:params (get-in intents [op :params])}))
                      (if history? {:undo {:params {}} :redo {:params {}}} {})
                      (keys intents))}))

(defn digest [c] (hex (crypto/hash :sha256 (cjson c))))

; ── the declaration ───────────────────────────────────────────────────────────

(defn app
  "The app value: the declaration as data, its contract and digest, and the
   roles resolved to functions (`fns` is `decl` evaluated). `apply-arities`
   maps each intent to its :apply's arity (2, or 3 to receive the person)."
  [app-name decl fns apply-arities]
  (let [c (contract app-name decl)]
    {:name app-name :decl decl :contract c :digest (digest c)
     :server (get fns :server) :client (get fns :client)
     :intents (reduce (fn [m op] (assoc m op (assoc (get-in fns [:intents op]) :apply-arity (get apply-arities op 2))))
                      {} (keys (get fns :intents)))}))

(defmacro defapp
  "Declare a split app. `(split/defapp name {:wire … :server … :client …
   :intents …})` defines `name` as the app value (see `app`). Serve it with
   `(split.web/serve name opts)` or `bl serve` on a file that does."
  [app-name decl]
  (let [applies (reduce (fn [m op] (assoc m op (get-in decl [:intents op :apply]))) {} (keys (get decl :intents)))]
    `(def ~app-name
       (app ~(str app-name) '~decl ~decl
            ~(reduce (fn [m [op sym]] (assoc m op `(if (BeamLisp.Ns.Rt/invocable? ~sym 3) 3 2))) {} applies)))))
