; credential.bl — proof of authority over a remote, as a value.
;
; ── The split this enforces ──────────────────────────────────────────
;
; A CONNECTION has two halves that are easy to conflate and expensive to
; conflate:
;
;   the CLIENT  — the application's own identity: an id, a secret, the scopes
;                 it is allowed to ask for. The same for every account, lives
;                 in configuration, rotates when a human rotates it.
;   the GRANT   — one account's proof that a human once said yes: an access
;                 token, a refresh token, an expiry. One per account, lives in
;                 a store, dies on revoke.
;
; They are separate because they FAIL separately. A wrong secret is a
; `:config-error` that no amount of re-consent fixes; a revoked grant is a
; `:reauth` that no amount of configuration fixes. A module that took one
; combined "credentials" map could not tell a caller which of the two to do,
; and the caller would guess — usually by asking the human to log in again,
; which does not help when the secret is wrong.
;
; ── Why refresh is here and not in the caller ────────────────────────
;
; An access token lasts an hour. Every caller that holds one for longer than
; that — a backfill, a mirror, a page walk — would otherwise have to know how
; to renew it, and the ones that forget fail as a 401 in the middle of a batch
; that is expensive to resume. So renewal is a property of the credential, not
; a step a caller remembers: `bearer` answers with a token that is good NOW,
; and renews first if it is not.

(ns credential
  (:require [credential.oauth2 :as oauth]
            [credential.flow :as flow]))

(def SKEW-MS
  "How long before expiry a token is treated as already gone.

   Not paranoia. A token with 400 ms left is expired for any request that takes
   longer than 400 ms, and the failure it produces is a 401 somewhere inside a
   batch rather than a refresh before it — which is the difference between a
   retry and a resume. A minute costs one refresh per hour and removes the
   whole class."
  60000)

(defn client
  "The application half, from a config map. Named so a caller has one place to
   look for which keys a client needs."
  [m]
  {:client-id (get m :client-id)
   :client-secret (get m :client-secret)})

(defn expired?
  "Whether `grant`'s access token is gone, or will be within `skew-ms`.

   A grant with NO `:expires-at` is treated as live: an absent expiry is a
   provider saying `this does not expire`, and refreshing on it would be a
   request per call."
  ([grant] (expired? grant (erlang/system_time :millisecond) SKEW-MS))
  ([grant now-ms skew-ms]
   (let [e (:expires-at grant)]
     (if (nil? e)
       false
       (<= e (+ now-ms skew-ms))))))

(defn bearer
  "The Authorization header value for `grant`."
  [grant]
  (str "Bearer " (:access grant)))

(defn refresh!
  "Trade `grant`'s refresh token for a new access token.

   `post!` is injected for the same reason it is in `credential.flow`: this is
   the one step that needs a network, and keeping it a parameter is what lets
   everything else here be exercised without one.

   → {:ok grant'} | {:error reason :disposition …}

   THE REFRESH TOKEN IS CARRIED FORWARD when the response omits it, and Google
   omits it on every refresh. A `(merge grant fresh)` would therefore be fine
   and a `(assoc grant :access …)` would silently keep a scope set that the
   provider may have narrowed — so the merge is written out, field by field,
   with a note for each about which side wins."
  ([grant client] (refresh! grant client flow/post-form!))
  ([grant client post!]
   (let [rt (:refresh grant)]
     (if (nil? rt)
       {:error :no-refresh-token
        :disposition :reauth
        :detail "this grant has no refresh token — only a code exchange can mint one"}
       (let [resp (post! oauth/TOKEN-ENDPOINT
                         (oauth/form-encode
                           (oauth/refresh-body {:client-id (:client-id client)
                                                :client-secret (:client-secret client)
                                                :refresh-token rt})))]
         (if (= 200 (:status resp))
           (let [tok (oauth/decode-token (:body resp))]
             (if (contains? tok :ok)
               (let [t (:ok tok)]
                 {:ok {:service (:service grant)      ; the grant's identity is
                       :account-id (:account-id grant) ; KEPT: a refresh does
                       :label (:label grant)           ; not re-identify anyone
                       :client-id (:client-id grant)
                       :access (:access t)
                       ;; the response has no refresh token; keep ours
                       :refresh (or (:refresh t) rt)
                       ;; a narrowed scope set is a real answer and is kept;
                       ;; an absent one is not a narrowing, so ours survives
                       :scopes (or (:scopes t) (:scopes grant))
                       :expires-at (:expires-at t)
                       :refreshed-at (erlang/system_time :millisecond)}})
               {:error :malformed :body (:body tok)}))
           {:error :refresh-failed
            :body (oauth/decode-error (:body resp))
            :disposition (:disposition (oauth/decode-error (:body resp)))}))))))

(defn fresh!
  "`{:ok grant}` whose access token is good for the next request — renewing
   first if it is not. The function a caller should reach for; `refresh!` is
   the one underneath it."
  ([grant client] (fresh! grant client flow/post-form!))
  ([grant client post!]
   (if (expired? grant)
     (refresh! grant client post!)
     {:ok grant})))

(defn good?
  "Whether `r` is an `{:ok …}`. The one-line so a caller does not have to
   remember which of `:ok`/`:error` a helper used."
  [r]
  (contains? r :ok))

(defn ok
  "The value of an `{:ok v}`, or nil."
  [r]
  (get r :ok))
