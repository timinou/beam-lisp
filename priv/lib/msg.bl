(ns msg
  (:require [datom.query.relation]
            [connector :as conn]
            [connector.google.gmail]))

;; ── the domain, not the service ──────────────────────────────────────
;
; `msg` knows nothing about Google. It owns the ATTRIBUTES a message has and
; the relation those attributes live in; a provider BINDS its methods onto that
; relation (see `connector.google.gmail/spec`, whose `:as` names it).
;
; This is the middle tier doing its job. A second mail provider — Graph, IMAP, a
; local mbox — writes no code here and no relation: it writes a spec whose `:as`
; says which of its methods IS `:~msg/messages`. A query above it never learns
; which one answered.

(def attrs
  "`:msg/*` — what a message is, whoever carries it."
  {:msg/subject  {:db/valueType :db.type/string
                  :db/doc "the subject line as the sender wrote it"}
   :msg/from     {:db/valueType :db.type/string
                  :db/doc "the From header, verbatim; :person/* is the parsed form"}
   :msg/sent-at  {:db/valueType :db.type/instant
                  :db/doc "when the message was sent, as the provider normalised it"}
   :msg/snippet  {:db/valueType :db.type/string}
   :msg/labels   {:db/valueType :db.type/ref
                  :db/cardinality :db.cardinality/many}})

(def providers
  "Which specs can serve `:~msg/messages`. A LIST, because two accounts — or
   two services — is the normal case and not a special one."
  [connector.google.gmail/spec])

(def DEFAULT-LIMIT
  "How many messages a bare query may pull.

   A relation whose provider fetches EVERYTHING when nothing is bound is a
   relation that spends a day of quota on one careless query — and the cost is
   invisible, because the query looks the same as a cheap one. So the
   unbound case is BOUNDED here, and the bound is a number a caller can see and
   argue with rather than one buried in a page size.

   The real answer is the mirror: a fill walks the account once and the
   relation then reads local facts, at which point this bound disappears
   because nothing remote is fetched at all. Until then, this is the honest
   ceiling, named."
  20)

(defn- fetch-all
  "Every tuple every provisioned connection can give for this aspect.

   The connection set is read at CALL time, not captured at registration: a
   relation registered before anything was connected must start answering the
   moment something is, and a captured list would freeze the empty set."
  [aspect opts]
  (let [cs (conn/connections-for aspect)
        opts (if (nil? (get opts :limit)) (assoc opts :limit DEFAULT-LIMIT) opts)]
    (if (empty? cs)
      []
      (vec (mapcat
             (fn [c]
               (let [svc (:id (:spec c))
                     r (if (= :gmail svc)
                         (connector.google.gmail/fetch c opts)
                         {:ok []})]
                 (if (= :error (first (keys r))) [] (get r :ok))))
             (to-list cs))))))

;; ── the relation ────────────────────────────────────────────────────
;
; Arity 4: `[entity subject from when]`. A query says
;
;     [?m :~msg/messages ?subject ?from ?when]
;
; and never names a provider.

(defn register!
  "Register `:~msg/messages`. Idempotent. Call before the first query.

   A FUNCTION and not a top-level side effect, and that is not style. An
   AOT-compiled namespace does NOT re-run its top-level effects when it LOADS:
   a registration written as a bare call runs in whichever VM happened to
   COMPILE the file and in no other. Measured — `:~msg/messages` answered under
   `bl run` from source and vanished once the same file was AOT-compiled into a
   drop, with no error anywhere, because an unregistered ident is not a broken
   query: it is a keyword in attribute position, which is either a
   `pattern-too-long` rejection or — worse, for a 3-wide relation — a valid
   stored-attribute pattern that matches nothing.

   `codebase`'s `register-reaches!` is the same shape for the same reason."
  []
  (datom.query.relation/register-relation!
    :~msg/messages
    {:arity 4
     :modes #{:bf}
     :maintenance :recompute
     :doc "messages from every provisioned mail connection, as [entity subject from when]"
     :provider (fn [db mode bounds args]
                 (fetch-all :~msg/messages {}))}))
