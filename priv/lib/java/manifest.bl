; java/manifest.bl — the CLOSED map from Java's names to beam-lisp's own.
;
; Unmodified Clojure libraries reach the JVM through four doors: `(.method
; obj args)`, `Class/static`, `(Class. args)` and `catch Class`. beam-lisp has
; no JVM, so each door leads HERE, and here is a table — not a runtime, not a
; reflection tier. Every row projects a Java name onto a beam-lisp value or
; function that already exists on its own terms: `java.util.Date` IS an
; integer of epoch milliseconds (the same value datom's `:db.type/instant`
; holds), `BigDecimal` IS `decimal/Decimal`, `RoundingMode/HALF_EVEN` IS the
; keyword `:half-even` — folded in at compile time, so compiled code carries
; no trace of the JVM spelling.
;
; Closed on purpose. A method, static or class that is not in this table is a
; COMPILE-TIME error naming what was asked and listing what exists — never a
; runtime "undefined". Adding a row means adding the beam-lisp fn it maps to
; and a differential test against the JVM (test/beam_lisp/java_oracle_test.exs);
; there is no row without an oracle. What the table covers is what an
; accounting kernel's `:clj` lane actually calls (measured over the 73 source
; files of replikativ/kontor): decimals, dates as instants, strings, uuids,
; a hash, base64, an atomic counter, and the statics/constants beside them.
;
; Instance methods are keyed by METHOD NAME, because Clojure call sites carry
; no receiver type; where two classes share a name (`compareTo` on a decimal
; and on a date-integer, `add` on a decimal and on a mutable collection we do
; not model) the target is a fn that dispatches on the receiver's own type —
; beam-lisp's protocols and multi-clause fns, one `type_of` away.

(ns java.manifest
  (:require [decimal :as d]
            [clojure.string :as str]))

;; ── helpers the rows point at ─────────────────────────────────────────────

(defn- date-now [] (erlang/system_time :millisecond))

(defn- compare-to
  "`.compareTo` on the two receivers kontor has: a decimal (numeric, scale-
   insensitive) or a date-integer. Both are `compare` in this language."
  [a b]
  (compare a b))

(defn- equals [a b] (= a b))

(defn- to-long
  "`.longValue`/`.intValue`/`.toBigInteger`: a decimal truncates toward zero;
   an integer (BigInteger, Long) is itself."
  [x]
  (if (d/decimal? x) (d/->long x) x))

(defn- to-double
  [x]
  (if (d/decimal? x) (d/->double x) (* 1.0 x)))

(defn- to-string
  "`.toString` on every receiver modelled: a decimal prints plain, a string or
   uuid is itself, anything else is `str`."
  [x]
  (if (d/decimal? x) (d/plain-str x) (str x)))

(defn- sha256-bytes
  "`(.digest (MessageDigest/getInstance \"SHA-256\") bytes)` collapses: the
   receiver is elided (see the `digest` row) and the algorithm must be SHA-256."
  ([bytes] (crypto/hash :sha256 bytes))
  ([_digest bytes] (crypto/hash :sha256 bytes)))

(defn- message-digest
  "`MessageDigest/getInstance` — the only algorithm modelled is SHA-256; any
   other name is refused where it is asked for."
  [algo]
  (if (= algo "SHA-256")
    :sha256
    (throw (ex-info (str "java.security.MessageDigest: only SHA-256 is modelled, got " algo)
                    {:type :java/unsupported :algorithm algo}))))

(defn- base64-url-encode [_encoder bytes] (base64/encode bytes (list (erlang/list_to_tuple (list :mode :urlsafe)) (erlang/list_to_tuple (list :padding false)))))

(defn- uuid-from-string
  "`UUID/fromString` — canonical 8-4-4-4-12 lowercase text, validated."
  [s]
  (let [t (str/lower-case (str s))]
    (if (re-matches (re-pattern "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}") t)
      t
      (throw (ex-info (str "not a UUID: " s) {:type :java/illegal-argument :value s})))))

(defn- get-bytes
  "`.getBytes` — a beam-lisp string IS its UTF-8 bytes; the charset argument
   is accepted and ignored (only UTF-8 is modelled)."
  ([s] s)
  ([s _charset] s))

(defn- long-max-value [] 9223372036854775807)

;; ── the table ─────────────────────────────────────────────────────────────
;;
;; :classes    qualified name → {:methods {name target} :statics {name target}
;;                               :ctor target}
;;   a target is a SYMBOL naming a fn (resolved in this namespace or a
;;   required alias) or a LITERAL (keyword/number) folded in as a constant.
;; :exceptions class → :any (untyped catch) | a beam-lisp struct module atom
;;                     | [:ex-info type] (an ExInfo whose :type matches)

(def classes
  {"java.math.BigDecimal"
   {:ctor 'd/of
    :statics {"ZERO" 'd/ZERO "ONE" 'd/ONE "TEN" 'd/TEN "valueOf" 'd/of}
    :methods {"add" 'd/add "subtract" 'd/sub "multiply" 'd/mul "divide" 'd/div
              "negate" 'd/neg "abs" 'd/abs "signum" 'd/signum
              "setScale" 'd/rescale "stripTrailingZeros" 'd/strip-zeros
              "movePointLeft" 'd/move-point-left "movePointRight" 'd/move-point-right
              "scale" 'd/scale "unscaledValue" 'd/unscaled "precision" 'd/precision
              "compareTo" 'compare-to "equals" 'equals
              "toPlainString" 'd/plain-str "toString" 'to-string
              "doubleValue" 'to-double "longValue" 'to-long "intValue" 'to-long
              "toBigInteger" 'to-long}}

   "java.math.BigInteger"
   {:statics {"valueOf" 'identity "ZERO" 0 "ONE" 1}
    :methods {"longValue" 'to-long "intValue" 'to-long}}

   "java.math.RoundingMode"
   {:statics {"HALF_EVEN" :half-even "HALF_UP" :half-up "HALF_DOWN" :half-down
              "CEILING" :ceiling "FLOOR" :floor "DOWN" :down "UP" :up
              "UNNECESSARY" :unnecessary}}

   ;; A Date / Instant is an integer of epoch milliseconds — the value datom
   ;; stores for :db.type/instant, so `:db/txInstant` compares with no adapter.
   "java.util.Date"
   {:ctor 'date-now
    :statics {"from" 'identity}
    :methods {"getTime" 'identity "toInstant" 'identity
              "before" '< "after" '> "compareTo" 'compare-to "equals" 'equals}}

   "java.time.Instant"
   {:statics {"now" 'date-now "ofEpochMilli" 'identity}
    :methods {"toEpochMilli" 'identity "compareTo" 'compare-to "isBefore" '< "isAfter" '>}}

   "java.lang.System"
   {:statics {"currentTimeMillis" 'date-now
              "nanoTime" 'monotonic-ns}}

   "java.lang.Math"
   {:statics {"abs" 'abs "max" 'max "min" 'min}}

   "java.lang.Long"
   {:statics {"MAX_VALUE" 9223372036854775807 "MIN_VALUE" -9223372036854775808
              "parseLong" 'parse-long "valueOf" 'identity}}

   "java.lang.Integer"
   {:statics {"MAX_VALUE" 2147483647 "MIN_VALUE" -2147483648
              "toString" 'str "parseInt" 'parse-long "valueOf" 'identity}}

   "java.lang.Character"
   {:statics {"isDigit" 'char-digit?}}

   "java.lang.Double" {:statics {"parseDouble" 'parse-double "valueOf" 'to-double}}
   "java.lang.Boolean" {:statics {"TRUE" true "FALSE" false}}

   "java.lang.String"
   {:methods {"length" 'count "toUpperCase" 'str/upper-case "toLowerCase" 'str/lower-case
              "trim" 'str/trim "startsWith" 'str/starts-with? "endsWith" 'str/ends-with?
              "contains" 'str/includes? "indexOf" 'str/index-of "lastIndexOf" 'str/last-index-of
              "substring" 'subs "replaceAll" 'str/replace "replace" 'str/replace
              "getBytes" 'get-bytes "equals" 'equals "hashCode" 'hash "isEmpty" 'empty?
              "compareTo" 'compare-to "toString" 'to-string "split" 'str/split}}

   "java.util.UUID"
   {:statics {"fromString" 'uuid-from-string "randomUUID" 'random-uuid}
    :methods {"toString" 'to-string}}

   "java.security.MessageDigest"
   {:statics {"getInstance" 'message-digest}
    :methods {"digest" 'sha256-bytes}}

   "java.nio.charset.StandardCharsets"
   {:statics {"UTF_8" :utf-8}}

   "java.util.Base64"
   {:statics {"getUrlEncoder" :url-encoder "getEncoder" :encoder}
    :methods {"encodeToString" 'base64-url-encode}}

   ;; An AtomicLong is an atom holding an integer — pure sugar.
   "java.util.concurrent.atomic.AtomicLong"
   {:ctor 'atomic-long
    :methods {"incrementAndGet" 'atomic-inc! "getAndIncrement" 'atomic-get-inc!
              "get" 'deref "set" 'reset! "addAndGet" 'atomic-add!}}

   "java.lang.Throwable"
   {:methods {"getMessage" 'ex-message}}

   "java.lang.Exception"
   {:methods {"getMessage" 'ex-message}}

   "java.lang.Class"
   {:methods {"getName" 'type-name}}})

(defn- atomic-long ([] (atom 0)) ([n] (atom n)))
(defn- atomic-inc! [a] (swap! a inc))
(defn- atomic-get-inc! [a] (let [v (deref a)] (swap! a inc) v))
(defn- atomic-add! [a n] (swap! a + n))
(defn- monotonic-ns [] (erlang/monotonic_time :nanosecond))
(defn- char-digit? [c] (and (>= c 48) (<= c 57)))
(defn- type-name [t] (str t))

(def types
  "A class used as a VALUE (`(instance? BigDecimal x)`, `^BigDecimal`) is its
   beam-lisp type identity — exactly what `(type x)` answers, so `instance?`
   needs no special case. A class with no single runtime type (`Double` is a
   float; `Long`/`Integer`/`BigInteger` an integer; `String` a binary)."
  {"java.math.BigDecimal" (erlang/binary_to_atom "Elixir.BeamLisp.Decimal")
   "java.math.BigInteger" :integer
   "java.lang.Long" :integer
   "java.lang.Integer" :integer
   "java.lang.Double" :float
   "java.lang.Float" :float
   "java.lang.String" :binary
   "java.lang.Boolean" :boolean
   "java.util.Date" :integer
   "java.time.Instant" :integer
   "java.util.UUID" :binary})

(defn type-target
  "`Class` as a value → `[:lit type-identity]` or nil."
  [class]
  (let [t (get types class)]
    (if (nil? t) nil [:lit t])))

(def exceptions
  "`catch Class e` → how the class is matched. `:any` is the untyped catch;
   a `[:ex-info type]` row matches an `ex-info` whose `:type` is `type`."
  {"Throwable" :any
   "Exception" :any
   "RuntimeException" :any
   "java.lang.Throwable" :any
   "java.lang.Exception" :any
   "java.lang.RuntimeException" :any
   "clojure.lang.ExceptionInfo" (erlang/binary_to_atom "Elixir.BeamLisp.ExInfo")
   "ExceptionInfo" (erlang/binary_to_atom "Elixir.BeamLisp.ExInfo")
   "NumberFormatException" [:ex-info :decimal/parse]
   "java.lang.NumberFormatException" [:ex-info :decimal/parse]
   "ArithmeticException" [:ex-info :decimal/non-terminating]
   "java.lang.ArithmeticException" [:ex-info :decimal/non-terminating]
   "IllegalArgumentException" [:ex-info :java/illegal-argument]
   "java.lang.IllegalArgumentException" [:ex-info :java/illegal-argument]})

;; ── derived: methods by bare name ─────────────────────────────────────────
;;
;; A `(.add x y)` names no class, so the compiler asks by method name. When
;; every class agreeing on a name agrees on its target the answer is that
;; target; when they differ the manifest must resolve it to ONE fn that
;; dispatches on the receiver (the `compare-to`/`equals` rows do exactly
;; that), so a conflict here is a manifest bug, refused at load.

(def methods-by-name
  (reduce (fn [acc [_class spec]]
            (reduce (fn [acc [m target]]
                      (let [seen (get acc m)]
                        (cond
                          (nil? seen) (assoc acc m target)
                          (= seen target) acc
                          :else (throw (ex-info (str "java.manifest: method ." m " maps to two targets: "
                                                     (pr-str seen) " and " (pr-str target))
                                                {:method m :targets [seen target]})))))
                    acc
                    (:methods spec)))
          {}
          classes))

;; ── the compiler's questions ──────────────────────────────────────────────
;;
;; Every answer is either `[:fn ns name]` (call this var), `[:lit value]` (fold
;; this constant in), or nil (not in the manifest — the compiler refuses with
;; the message from `explain-*`). Targets written as bare symbols live here;
;; `d/x` and `str/x` resolve through this namespace's aliases, and a symbol
;; the core already owns (`<`, `>`, `identity`, `compare`, `abs`, `count`,
;; `subs`, `hash`, `deref`, `reset!`, `str`, `empty?`, `ex-message`,
;; `random-uuid`, `parse-long`) is answered as a core var.

(defn- resolve-target
  [target]
  (cond
    (keyword? target) [:lit target]
    (number? target) [:lit target]
    (or (= target true) (= target false)) [:lit target]
    (symbol? target)
      (let [s (str target)                 ; `name` drops the ns part; the whole spelling is wanted
            i (index-of s "/")]
        (if (nil? i)
          (if (BeamLisp.Env/local_var? "java.manifest" s)
            [:fn "java.manifest" s]
            [:fn "core" s])
          (let [alias (subs s 0 i)
                member (subs s (inc i))
                ns (BeamLisp.Env/alias_target "java.manifest" alias)]
            [:fn ns member])))
    :else nil))

(defn method-target
  "`(.name recv args)` → the fn to call with `(recv args…)`, or nil."
  [name]
  (some-> (get methods-by-name name) resolve-target))

(defn static-target
  "`Class/NAME` → `[:fn ns name]` | `[:lit v]` | nil. `class` is qualified."
  [class name]
  (some-> (get-in classes [class :statics name]) resolve-target))

(defn ctor-target
  "`(Class. args)` → the constructor fn, or nil."
  [class]
  (some-> (get-in classes [class :ctor]) resolve-target))

(defn exception-match
  "`catch Class` → `:any` | module atom | `[:ex-info type]` | nil."
  [class]
  (get exceptions class))

(defn known-class? [class] (contains? classes class))

(defn explain-method
  "The refusal text for an unknown `.name`."
  [name]
  (str "no Java method ." name " in the interop manifest (priv/lib/java/manifest.bl); "
       "known methods: " (str/join " " (map (fn [m] (str "." m)) (sort (keys methods-by-name))))))

(defn explain-static
  [class name]
  (if (known-class? class)
    (str "no static " class "/" name " in the interop manifest; this class has: "
         (str/join " " (sort (keys (get-in classes [class :statics])))))
    (str "class " class " is not in the interop manifest (priv/lib/java/manifest.bl); "
         "known classes: " (str/join " " (sort (keys classes))))))

(defn explain-exception
  [class]
  (str "catch " class ": not in the interop manifest's exception table; known: "
       (str/join " " (sort (keys exceptions)))))
