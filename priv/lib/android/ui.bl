(ns android.ui
  "Screens as data. Every element is a plain map `{:type :props :children}` —
   the tree mob's renderer walks — so a screen's `render` is an ordinary function
   from assigns to a value you can print, diff and test on the desk.

     (ui/column {:padding 24 :gap 12}
       (ui/text \"Rita wrote 3 times\" {:size :xl :color :ink})
       (ui/button \"Call back\" {:on-tap [(erlang/self) :call]}))

   Props are kebab-case keywords (`:text-size`, `:on-tap`); they reach mob as its
   snake_case atoms. Colours are `\"#RRGGBB\"` strings, `[r g b]`, or a name from
   `palette` — all become the ARGB integers the Compose renderer reads. A tap
   handler is `[pid tag]`; the screen receives `{:tap tag}` in `handle_info`.")

;; ── colours ─────────────────────────────────────────────────────────────

(def palette
  "The house palette (calm Paper, light), by name."
  {:paper "#faf8f5" :paper-2 "#f2efe9" :sheet "#fffdf9"
   :ink "#1a1614" :ink-2 "#5c554e" :ink-3 "#8a837b"
   :rule "#d9d4cc" :accent "#3f66b0" :ok "#2d8a4e" :care "#b7791f" :stop "#c4392b"
   :people "#7c4dbd" :notes "#3a6fb0" :inbox "#2c7a78" :money "#2e7d4f"
   :writing "#a8741c" :milestones "#9a5a3c"
   :forest "#1F2A24" :cream "#F4EFE6"})

(defn- hex-digit [c]
  (let [i (index-of "0123456789abcdef" (lower-case c))]
    (if (nil? i) (throw (ex-info (str "android.ui: not a hex digit: " c) {})) i)))

(defn- argb-of [a r g b]
  (let [u (+ (* a 16777216) (* r 65536) (* g 256) b)]
    (if (>= u 2147483648) (- u 4294967296) u)))

(defn argb
  "A colour as the signed 32-bit ARGB integer Compose reads. Accepts a palette
   keyword, \"#RRGGBB\", \"#AARRGGBB\" or `[r g b]` / `[r g b a]`."
  [c]
  (cond
    (erlang/is_integer c) c
    (keyword? c) (argb (or (get palette c)
                           (throw (ex-info (str "android.ui: unknown colour " c) {:colour c}))))
    (vector? c) (let [[r g b a] c] (argb-of (or a 255) r g b))
    (string? c)
    (let [h (if (starts-with? c "#") (subs c 1) c)
          byte-at (fn [i] (+ (* 16 (hex-digit (subs h i (+ i 1)))) (hex-digit (subs h (+ i 1) (+ i 2)))))]
      (cond
        (= 6 (count h)) (argb-of 255 (byte-at 0) (byte-at 2) (byte-at 4))
        (= 8 (count h)) (argb-of (byte-at 0) (byte-at 2) (byte-at 4) (byte-at 6))
        :else (throw (ex-info (str "android.ui: not a colour: " c) {:colour c}))))
    :else (throw (ex-info (str "android.ui: not a colour: " (pr-str c)) {:colour c}))))

;; ── props: bl names in, mob names out ───────────────────────────────────

(def ^:private colour-props
  #{:color :text-color :background :border-color :tint :track-color :thumb-color})

(def ^:private renames
  "Short bl names for mob's props."
  {:color :text-color :size :text-size :weight :font-weight :align :text-align})

(defn- snake [k] (keyword (join "_" (vec (split (name k) "-")))))

(defn- handler
  "`[pid tag]` → mob's `{pid, tag}`; a bare pid passes through."
  [v]
  (if (vector? v) (tuple (nth v 0) (nth v 1)) v))

(defn props
  "bl props → the map mob's renderer reads."
  [m]
  (into {}
        (map (fn [[k v]]
               (let [k (get renames k k)
                     v (cond
                         (contains? colour-props k) (argb v)
                         (starts-with? (name k) "on-") (handler v)
                         :else v)]
                 [(snake k) v])))
        (or m {})))

(defn- kids
  "Children as a LIST (mob maps over them with Enum); nil and nested seqs
   flatten, so `(when x …)` and `(map row items)` read naturally."
  [xs]
  (apply list (filter some? (mapcat (fn [x] (if (or (seq? x) (vector? x) (list? x)) x [x])) xs))))

(defn el
  "Any mob element: `(el :lazy-list {…} child …)`."
  [type p & children]
  {:type (snake type) :props (props p) :children (kids children)})

;; ── the vocabulary ──────────────────────────────────────────────────────

(defn column [p & children] (apply el :column p children))
(defn row [p & children] (apply el :row p children))
(defn box [p & children] (apply el :box p children))
(defn scroll [p & children] (apply el :scroll p children))

(defn text
  ([s] (text s {}))
  ([s p] (el :text (assoc p :text (str s)))))

(defn button
  ([label on-tap] (button label on-tap {}))
  ([label on-tap p] (el :button (assoc p :text (str label) :on-tap on-tap))))

(defn spacer ([] (spacer 8)) ([h] (el :spacer {:height h})))
(defn divider ([] (el :divider {})) ([p] (el :divider p)))

(defn card
  "A sheet lifted off the page: padding, a rounded background, a border."
  [p & children]
  (apply el :column (merge {:padding 16 :gap 6 :background :sheet :corner-radius 14
                            :border-color :rule :border-width 1}
                           p)
         children))
