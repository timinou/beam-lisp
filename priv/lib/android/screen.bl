(ns android.screen
  "What makes a namespace a mob screen.

   mob drives a screen through ten functions with Elixir names. `(defscreen)`
   defines all of them with sensible defaults; define the ones you care about
   AFTER it and yours win:

     (ns people.home (:require [android.screen :refer [defscreen]] [android.ui :as ui]))
     (defscreen)
     (defn mount [_params _session socket] (tuple :ok (android.app/assign socket :n 0)))
     (defn render [a] (ui/text (str \"taps: \" (:n a))))
     (defn handle_info [msg socket] …)      ; {:tap tag} from a ui handler lands here

   Options: `(defscreen {:vsn 1 :persist? true})` — the state version and
   whether mob saves assigns across restarts (then `dump_state`/`load_state`
   matter). Callback names keep mob's underscores: they are called by mob, by
   name, so they are spelled the way mob spells them.")

(defmacro defscreen
  ;; qualified: the expansion lands in the CALLER's namespace, which may have
  ;; required android.screen without referring defscreen
  ([] `(android.screen/defscreen {}))
  ([opts]
   `(do
      (defn ~'__mob_vsn__ [] (or (:vsn ~opts) 0))
      (defn ~'__mob_persist__ [] (boolean (:persist? ~opts)))
      (defn ~'mount [~'_params ~'_session ~'socket] (tuple :ok ~'socket))
      (defn ~'render [~'_assigns] {:type :column :props {} :children (list)})
      (defn ~'handle_event [~'_event ~'_params ~'socket] (tuple :noreply ~'socket))
      (defn ~'handle_info [~'_msg ~'socket] (tuple :noreply ~'socket))
      (defn ~'dump_state [~'assigns] ~'assigns)
      (defn ~'load_state [~'_vsn ~'stored] ~'stored)
      (defn ~'terminate [~'_reason ~'_socket] :ok))))

(defn noreply "`{:noreply socket}` — what a handler returns." [socket] (tuple :noreply socket))
(defn ok "`{:ok socket}` — what `mount` returns." [socket] (tuple :ok socket))
