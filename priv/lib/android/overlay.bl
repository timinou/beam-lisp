(ns android.overlay
  "Draw over any app: cards that float above whatever is on screen.

     (overlay/permitted?)                          ; SYSTEM_ALERT_WINDOW granted?
     (overlay/show! {:id :nudge :kicker \"PEOPLE\"
                     :title \"Call Rita back\"
                     :body \"She wrote 3 times today.\"
                     :gravity :top :y 64})
     (overlay/shown)                               ; [:nudge]
     (overlay/hide! :nudge)

   A tap on a card (touchable unless `:touchable false`) arrives as
   `[:android :overlay/tap {\"id\" \"nudge\"}]`. Card keys:

     :id        keyword or string, required — showing the same id replaces it
     :kicker :title :body     the three lines of text, all optional
     :gravity   :top :center :bottom        :y  offset in dp (default 48)
     :bg :fg :border  colours \"#RRGGBB\"      :radius :width  in dp
     :touchable  default true

   Grant with `(overlay/request!)`, or from the desk `bl android grant overlay`."
  (:require [android.jvm :as jvm]
            [bl.json :as json]))

(def ^:private overlay-class "io.beamlisp.android.BlOverlay")

(def default-style
  "The house look: deep green paper with warm ink."
  {:bg "#1F2A24" :fg "#F4EFE6" :radius 18})

(defn permitted? [] (jvm/static overlay-class :permitted))

(defn request!
  "Open the system screen where the user lets this app draw over others."
  []
  (let [pkg (jvm/call (jvm/ctx) :get-package-name)
        uri (jvm/static "android.net.Uri" :parse (str "package:" pkg))
        i (jvm/new "android.content.Intent" "android.settings.action.MANAGE_OVERLAY_PERMISSION" uri)]
    (jvm/call i :add-flags 268435456)
    (jvm/call (jvm/ctx) :start-activity i)
    (jvm/release i uri)
    :ok))

(defn- wire [card]
  (into {}
        (keep (fn [[k v]]
                (when (some? v)
                  [(name k) (if (keyword? v) (name v) v)]))
              (merge default-style card))))

(defn show!
  "Show `card` (see the namespace doc). Returns its id, or throws when the
   overlay permission is missing."
  [card]
  (when-not (:id card)
    (throw (ex-info "android.overlay: a card needs an :id" {:card card})))
  (if (jvm/static overlay-class :show (json/encode (wire card)))
    (:id card)
    (throw (ex-info "android.overlay: not permitted to draw over other apps; grant with (android.overlay/request!)"
                    {:android/error :overlay-not-permitted}))))

(defn hide! [id] (jvm/static overlay-class :hide (name id)) :ok)
(defn hide-all! [] (jvm/static overlay-class :hide-all) :ok)

(defn shown
  "Ids of the cards currently on screen, as keywords."
  []
  (mapv keyword (json/decode (jvm/static overlay-class :shown) {:keys :string})))
