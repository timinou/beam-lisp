(ns android.reader
  "Read whatever is on the phone's screen, from any app, through accessibility.

     (reader/granted?)            ; the user enabled the service
     (reader/texts)               ; [{:text \"Rita\" :bounds [l t r b]} …] top to bottom
     (reader/tree 6)              ; {:package … :root node} to depth 6
     (reader/foreground)          ; the package in front, e.g. \"com.android.settings\"
     (reader/find \"Network\")      ; nodes whose text or description contains it
     (reader/click! \"Network\")    ; click the first clickable node with that text
     (reader/global! :back)       ; :back :home :recents :notifications
     (reader/stream! true)        ; events [:android :reader/event {\"kind\" \"window\" …}]

   A node is a map with keyword keys: :class :text :desc :id :bounds
   :clickable :editable :focused :selected :checked :children.

   Grant with `(reader/request!)` (opens Accessibility settings), or on an
   emulator from the desk with `bl android grant reader`."
  (:require [android.jvm :as jvm]
            [bl.json :as json]
))

(def ^:private reader-class "io.beamlisp.android.BlReader")

(defn- keywordize [x]
  (cond
    (map? x) (into {} (map (fn [[k v]] [(keyword k) (keywordize v)]) x))
    (vector? x) (mapv keywordize x)
    (list? x) (mapv keywordize x)
    :else x))

(defn granted?
  "Is the reader enabled in the system's accessibility settings?"
  []
  (let [resolver (jvm/call (jvm/ctx) :get-content-resolver)
        enabled (jvm/static "android.provider.Settings$Secure" :get-string resolver "enabled_accessibility_services")
        pkg (jvm/call (jvm/ctx) :get-package-name)]
    (jvm/release resolver)
    (boolean (and (string? enabled) (includes? enabled (str pkg "/" reader-class))))))

(defn connected?
  "Has the OS bound the reader (granted AND running)?"
  []
  (jvm/static reader-class :connected))

(defn request!
  "Open Accessibility settings so the user can enable the reader."
  []
  (let [i (jvm/new "android.content.Intent" "android.settings.ACCESSIBILITY_SETTINGS")]
    (jvm/call i :add-flags 268435456)
    (jvm/call (jvm/ctx) :start-activity i)
    (jvm/release i)
    :ok))

(defn- service []
  (or (jvm/static reader-class :get-instance)
      (throw (ex-info "android.reader: the accessibility service is not connected; enable it with (android.reader/request!)"
                      {:android/error :reader-not-connected}))))

(defn tree
  "The foreground window as a node tree, to `max-depth` levels (default 12).
   nil when there is no active window."
  ([] (tree 12))
  ([max-depth]
   (let [t (json/decode (jvm/call (service) :tree max-depth) {:keys :string})]
     (when (map? t) (keywordize t)))))

(defn texts
  "Every visible text on screen, top to bottom: `[{:text :bounds}]`."
  []
  (keywordize (json/decode (jvm/call (service) :texts) {:keys :string})))

(defn screen-text
  "The screen as one string, a line per text: handy to print or to grep."
  []
  (join "\n" (map :text (texts))))

(defn foreground "The package of the window in front, or nil." []
  (:package (tree 0)))

(defn nodes
  "Every node of `t` (default: the current tree), depth first."
  ([] (nodes (:root (tree))))
  ([t] (if (nil? t) [] (cons t (mapcat nodes (:children t))))))

(defn find
  "Nodes whose text or description contains `s` (case-insensitive)."
  [s]
  (let [needle (lower-case s)
        hit? (fn [v] (and (string? v) (includes? (lower-case v) needle)))]
    (vec (filter (fn [n] (or (hit? (:text n)) (hit? (:desc n)))) (nodes)))))

(defn click!
  "Click the first clickable node (or clickable ancestor) whose text is `label`.
   True when something was clicked."
  [label]
  (jvm/call (service) :click-text label))

(defn global!
  "A system-wide action: :back :home :recents :notifications."
  [action]
  (jvm/call (service) :global (name action)))

(defn stream!
  "Turn the live event stream on or off. While on, window changes, clicks and
   text edits arrive as `[:android :reader/event {\"kind\" \"package\" \"class\" \"text\"}]`."
  [on?]
  (jvm/static reader-class :set-streaming (boolean on?))
  on?)
