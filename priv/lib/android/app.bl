(ns android.app
  "An Android app is a beam-lisp namespace.

     (ns people.app (:require [android.app :as app] [people.home]))
     (defn navigation [_platform] (app/stack :home 'people.home))
     (defn on-start [] (app/start-root! 'people.home))

   A SCREEN is a namespace too — mob calls its functions directly:

     (ns people.home (:require [android.screen :refer [defscreen]] [android.ui :as ui]))
     (defscreen)                                ; the callbacks you leave out
     (defn mount [params session socket] (tuple :ok (app/assign socket :n 0)))
     (defn render [a] (ui/text (str (:n a))))
     (defn handle-info [msg socket] (tuple :noreply socket))

   `start!` is what the phone runs at boot: it brings mob's runtime up exactly as
   `use Mob.App` would, with this namespace as the app module, then calls its
   `on-start`. `module` turns a namespace symbol into the module mob is given.")

(defn module
  "The BEAM module a beam-lisp namespace compiles to: `people.home` →
   `Elixir.BeamLisp.Ns.People.Home`. Accepts a symbol, string or keyword."
  [ns]
  (BeamLisp.Emit/module_for (name ns)))

(defn stack
  "A navigation stack named `nm` whose root is screen namespace `root`."
  ([nm root] (stack nm root nil))
  ([nm root title]
   {:type :stack :name nm :root (module root) :title title}))

(defn- ok-started [r]
  (if (or (= :ok r) (= :ok (erlang/element 1 r))) :ok r))

(defn- start-link [m] (ok-started (erlang/apply m :start_link (list))))

(defn dist!
  "Join distribution as `<node>` so the desk can reach this phone (mob waits for
   EPMD, and skips quietly when there is none)."
  [node cookie]
  (Mob.Dist/ensure_started (list (tuple :node node) (tuple :cookie cookie))))

(defn start!
  "Boot mob for app namespace `app-ns` (whose `navigation` and optional
   `on-start` it calls), with `otp-app` the OTP application its plugins belong
   to. Mirrors the `start/0` that `use Mob.App` generates, step for step."
  ([app-ns] (start! app-ns nil))
  ([app-ns otp-app]
   (let [m (module app-ns)]
     (Mob.App/configure_ios_inet_db)
     (Mob.NativeLogger/install)
     (Mob.Theme/set (list))
     (ok-started (Mob.Nav.Registry/start_link m))
     (Mob.Plugins/boot otp-app)
     (doseq [svc [:Elixir.Mob.State :Elixir.Mob.ComponentRegistry :Elixir.Mob.Sender
                  :Elixir.Mob.Listener :Elixir.Mob.Device.IOS :Elixir.Mob.Device.Android
                  :Elixir.Mob.Device :Elixir.Mob.Theme.AdaptiveWatcher]]
       (start-link svc))
     (Mob.Plugins/start_lifecycle)
     (when (erlang/function_exported m :on-start 0)
       (erlang/apply m :on-start (list)))
     ; The desk's door: `bl android up` launches with a dist port, and this
     ; joins as `<otp-app>_android[_suffix]@127.0.0.1`. mob waits for EPMD and
     ; skips quietly when there is none (a phone off the cable), and never
     ; starts it in a release build.
     (when otp-app
       (dist! (keyword (str (name otp-app) "_android@127.0.0.1")) :mob_secret))
     :ok)))

(defn start-root!
  "Mount screen namespace `screen-ns` as the root screen."
  ([screen-ns] (start-root! screen-ns {}))
  ([screen-ns params]
   (Mob.Screen/start_root (module screen-ns) params)))

(defn assign
  "Set assigns on a mob socket: `(assign socket :n 1)` or `(assign socket {:n 1 :m 2})`."
  ([socket m] (Mob.Socket/assign socket m))
  ([socket k v] (Mob.Socket/assign socket k v)))

(defn assigns "A socket's assigns." [socket] (:assigns socket))

(defn push
  "Open screen namespace `screen-ns` on top of this one once the handler returns
   (back comes home). `params` reach its `mount`."
  ([socket screen-ns] (push socket screen-ns {}))
  ([socket screen-ns params] (Mob.Socket/push_screen socket (module screen-ns) params)))

(defn pop "Go back to the previous screen once the handler returns." [socket]
  (Mob.Socket/pop_screen socket))

(defn platform
  "`:android`, `:ios`, or `:host` on the desk."
  []
  (try (mob_nif/platform) (catch _ :host)))
