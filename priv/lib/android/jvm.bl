(ns android.jvm
  "The whole Android API, from beam-lisp.

   Java objects stay in the JVM; beam-lisp holds HANDLES to them — small maps
   `{\"$h\" 7, \"class\" \"android.app.NotificationManager\"}` that print, compare
   and travel like any value. Four verbs reach everything:

     (new \"android.app.NotificationChannel\" \"people\" \"People\" 4)
     (call nm :create-notification-channel ch)     ; :kebab-name → camelName
     (static \"android.provider.Settings$Secure\" :get-string resolver \"x\")
     (field \"android.os.Build$VERSION\" \"SDK_INT\") ; → 36

   plus `ctx` (the application Context), `service` (getSystemService by name),
   `describe` (what a class offers), `proxy` (implement a Java interface whose
   calls arrive as messages) and `release` (let the JVM forget handles).

   Values cross BY VALUE when they can: nil, booleans, numbers, strings,
   vectors/lists (→ java.util.List, or an array when the parameter is one),
   maps (→ Map). Tagged values say what JSON cannot: `(float 1.5)`,
   `(long 3)`, `(enum \"a.B\" \"X\")`, `(klass \"a.B\")`. A Java exception is a
   beam-lisp exception: `(ex-message e)` is `Class: message`, `(ex-data e)`
   carries `:android/error` and the request.

   Off the phone every call throws with `{:android/error :not-on-android}`, so
   namespaces that use this load and test anywhere."
  (:require [bl.json :as json]))

;; ── the wire ─────────────────────────────────────────────────────────────

(defn available?
  "True on a phone whose bridge is attached (the Activity ran BlBridge.attach)."
  []
  (and (Code/ensure_loaded? :bl_android_nif)
       (= true (bl_android_nif/attached))))

(defn- wire-name [k] (if (keyword? k) (name k) (str k)))

(defn request
  "Send one request map to the JVM and return its `ok` value, or throw.
   The low-level door; the verbs below are this with a shape."
  [req]
  (let [r (if (Code/ensure_loaded? :bl_android_nif)
            (bl_android_nif/call (json/encode req))
            (tuple :error :not_on_android))]
    (cond
      (= r (tuple :error :not_on_android))
      (throw (ex-info "android.jvm: not on an Android device" {:android/error :not-on-android :request req}))

      (= :error (erlang/element 1 r))
      (throw (ex-info (str "android.jvm: " (erlang/element 2 r)) {:android/error :bridge :request req}))

      :else
      (let [ans (json/decode (erlang/element 2 r) {:keys :string})]
        (if (contains? ans "error")
          (throw (ex-info (get ans "error") {:android/error :java :request req}))
          (get ans "ok"))))))

;; ── values that JSON cannot say ─────────────────────────────────────────

(defn handle? [x] (and (map? x) (contains? x "$h")))
(defn class-name [h] (get h "class"))
(defn float [x] {"$float" x})
(defn long [x] {"$long" x})
(defn char [s] {"$char" s})
(defn enum [cls value] {"$enum" (wire-name value) "class" cls})
(defn klass [cls] {"$class" cls})

;; ── the four verbs ──────────────────────────────────────────────────────

(defn new
  "Construct `cls` (a fully qualified class name) with `args`."
  [cls & args]
  (request {"op" "new" "class" cls "args" (vec args)}))

(defn call
  "Call instance method `m` on handle `target`. `m` may be a keyword in
   kebab case: `:create-notification-channel` is `createNotificationChannel`."
  [target m & args]
  (request {"op" "call" "target" target "method" (wire-name m) "args" (vec args)}))

(defn call-ui
  "`call`, run on the Android main thread (anything that touches a View)."
  [target m & args]
  (request {"op" "call" "ui" true "target" target "method" (wire-name m) "args" (vec args)}))

(defn static
  "Call static method `m` of class `cls`."
  [cls m & args]
  (request {"op" "static" "class" cls "method" (wire-name m) "args" (vec args)}))

(defn field
  "A public field: `(field \"a.B\" \"NAME\")` for a static, `(field handle \"name\")`
   for an instance field."
  [cls-or-target f]
  (if (string? cls-or-target)
    (request {"op" "field" "class" cls-or-target "field" (wire-name f)})
    (request {"op" "field" "target" cls-or-target "field" (wire-name f)})))

(defn set-field! [target f v]
  (request {"op" "set-field" "target" target "field" (wire-name f) "value" v}))

;; ── the app itself ──────────────────────────────────────────────────────

(defn ctx "The application Context." [] (request {"op" "context"}))
(defn activity "The live Activity, or nil when the UI is gone." [] (request {"op" "activity"}))

(defn service
  "`Context.getSystemService(name)`: `(service \"notification\")`."
  [n]
  (call (ctx) :get-system-service (wire-name n)))

(defn sdk-int "The device's API level." [] (field "android.os.Build$VERSION" "SDK_INT"))

(defn describe
  "What a handle's class offers: `{\"class\" \"methods\" [...] \"fields\" [...]}`.
   With a class name, describes that class."
  [x]
  (if (string? x)
    (request {"op" "describe" "target" (klass x)})
    (request {"op" "describe" "target" x})))

(defn release
  "Let the JVM drop `handles`. Handles are otherwise kept for the life of the
   process; long-running code that makes many should release them."
  [& handles]
  (request {"op" "release" "handles" (vec (map (fn [h] (get h "$h")) handles))}))

(defn live-handles "How many handles the JVM is holding." [] (request {"op" "handles"}))

(defn proxy
  "A Java object implementing interface `iface`. Every call on it becomes the
   event `[\"proxy\" {\"id\" id \"method\" m \"args\" [...]}]` (see `android.events`);
   the Java caller gets a default return value (false/0/null)."
  [iface id]
  (request {"op" "proxy" "interface" iface "id" (wire-name id)}))

(defn ping [] (request {"op" "ping"}))
