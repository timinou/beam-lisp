; live/diff.bl — a keyed structural diff of two hiccup trees → patch ops.
;
; ── Why this exists ───────────────────────────────────────────────────
;
; After first paint (live/hiccup), the socket holds the current hiccup VALUE.
; On every update it computes the next value (a pure `db → hiccup` call) and
; diffs the two trees into a minimal list of patch ops. The client applies
; them against the real DOM. This is the thing LiveView approximates by
; diffing rendered STRINGS; here we diff the tree with real keys, so a
; reorder moves DOM nodes instead of rewriting them.
;
; ── The op set (the wire; serialises to JSON via interop/->json) ──────
;
;   [:set-attr    path k v]         an attribute gained/changed
;   [:remove-attr path k]           an attribute dropped
;   [:text        path s]           a text node changed
;   [:replace     path subtree]     node kind (tag) changed — full swap
;   [:insert      path key subtree] a keyed child appeared
;   [:remove      path key]         a keyed child left
;   [:move        path key idx]     a keyed child moved to index `idx`
;
; `path` is a vector of child indices from the root ([] is the root itself).
; A keyed op names the child by its `:key`, not its index, because the whole
; point of keys is that an index is unstable under insert/remove/reorder.
;
; ── Keys: attr or metadata, one reader ────────────────────────────────
;
; A node's key is `:key` in its attrs map OR `^{:key …}` metadata on the
; vector (W0 made the latter reach runtime). `node-key` reads either, so a
; view author may write whichever reads better; the differ sees one thing.
;
; ── Correctness contract ──────────────────────────────────────────────
;
; `apply-ops` (below) is the reference semantics the JS client mirrors. The
; property the test pins: (apply-ops (diff a b) a) == b, for every pair of
; trees. So the ops are not merely "plausible" — applying them to the old
; tree reconstructs the new one exactly.

(ns live.diff)

;; ── node accessors (a node is [:tag attrs? child*]) ─────────────────

(defn- element? [n] (and (vector? n) (> (count n) 0) (keyword? (first n))))
(defn- tag-of [n] (first n))
(defn- has-attrs? [n] (and (> (count n) 1) (map? (nth n 1))))
(defn- attrs-of [n] (if (has-attrs? n) (nth n 1) {}))
(defn- splice-children
  "Flatten a child list the way `hiccup->html` renders it: a SEQ in child
   position splices (so `(for …)` yields adjacent children), and a nil child
   is dropped. The differ MUST see the same flat list the renderer does, or a
   `(for …)` child reads as one opaque node and diffs as text."
  [cs]
  (reduce (fn [acc c]
            (cond
              (nil? c) acc
              ;; a seq (lazy or list) that is NOT a hiccup element splices
              (and (seq? c) (not (and (vector? c) (keyword? (first c)))))
                (into acc (splice-children (into [] c)))
              :else (conj acc c)))
          []
          cs))

(defn- children-of [n]
  (splice-children (if (has-attrs? n) (drop 2 n) (rest n))))

(defn node-key
  "A node's stable identity: `:key` in its attrs, else `^{:key …}` vector
   metadata, else nil. One reader so the differ never cares which the
   author wrote."
  [n]
  (cond
    (not (vector? n)) nil
    (contains? (attrs-of n) :key) (get (attrs-of n) :key)
    :else (get (meta n) :key)))

(defn- all-keyed?
  "Whether every element in `nodes` carries a key (the condition for a
   keyed reconcile; a single unkeyed child falls back to positional)."
  [nodes]
  (and (seq nodes)
       (reduce (fn [_ n] (if (nil? (node-key n)) (reduced false) true)) true nodes)))

;; ── attribute diff ──────────────────────────────────────────────────
;;
;; `:key` is identity, not a DOM attribute, so it is excluded from the attr
;; diff (it never renders — live/hiccup strips it). Every other key is
;; compared: present-and-changed → :set-attr; gone → :remove-attr.

(defn- attr-ops
  [path old-attrs new-attrs]
  (let [oa (dissoc old-attrs :key)
        na (dissoc new-attrs :key)
        changed (mapcat (fn [kv]
                          (let [k (first kv) v (second kv)]
                            (if (= (get oa k :live.diff/absent) v)
                              []
                              [[:set-attr path (name k) v]])))
                        (seq na))
        removed (mapcat (fn [kv]
                          (let [k (first kv)]
                            (if (contains? na k) [] [[:remove-attr path (name k)]])))
                        (seq oa))]
    (concat changed removed)))

;; ── keyed child reconcile ───────────────────────────────────────────
;;
;; Match children by key. A key present only in NEW is an insert; only in
;; OLD is a remove; in both at a different index is a move; in both at the
;; same index recurses (its content may still have changed). Order: removes
;; first (so indices the client computes for inserts/moves are against the
;; surviving set), then inserts/moves/recursion walked in NEW order.

(defn- index-by-key [nodes]
  (reduce (fn [m pair]
            (assoc m (node-key (second pair)) (first pair)))
          {} (map-indexed (fn [i n] [i n]) nodes)))

;; The longest strictly-increasing subsequence of a vector of integers,
;; returned as a SET of the values it contains. O(n^2) — child lists are
;; short, and clarity beats the O(n log n) patience-sort here. These are the
;; kept children whose relative order is already correct: the anchors that
;; need no move. Every other kept child moves. This is the snabbdom insight —
;; minimise moves by keeping the largest already-ordered run in place.
(defn- lis-set
  [xs]
  (let [v (into [] xs)
        n (count v)]
    (if (= n 0)
      #{}
      (let [;; len[i] = length of LIS ending at i; prev[i] = predecessor index
            init {:len (into [] (repeat n 1)) :prev (into [] (repeat n -1))}
            filled (reduce
                     (fn [st i]
                       (reduce
                         (fn [s j]
                           (if (and (< (nth (:v-old s) j) (nth (:v-old s) i))
                                    (> (+ 1 (nth (:len s) j)) (nth (:len s) i)))
                             (assoc s :len (assoc (:len s) i (+ 1 (nth (:len s) j)))
                                      :prev (assoc (:prev s) i j))
                             s))
                         st
                         (range i)))
                     (assoc init :v-old v)
                     (range n))
            lens (:len filled)
            prevs (:prev filled)
            ;; best endpoint = index of max len
            best (reduce (fn [b i] (if (> (nth lens i) (nth lens b)) i b)) 0 (range n))]
        ;; walk the prev chain, collecting the VALUES
        (loop [i best acc #{}]
          (if (= i -1)
            acc
            (recur (nth prevs i) (conj acc (nth v i)))))))))

(defn- keyed-child-ops
  [path old-children new-children diff-fn]
  (let [old-idx (index-by-key old-children)
        new-idx (index-by-key new-children)
        removes (mapcat (fn [pair]
                          (let [k (node-key (second pair))]
                            (if (contains? new-idx k) [] [[:remove path k]])))
                        (map-indexed (fn [i n] [i n]) old-children))
        ;; an inserted subtree must carry its key as an ATTR: the JSON wire
        ;; strips metadata, and the client renders the subtree via the DOM —
        ;; without a data-key attribute the fresh node is unaddressable, so
        ;; the NEXT diff's keyed :remove of it silently no-ops (zombie DOM).
        ;; `normalize` excludes :key, so the round-trip property is unchanged.
        attach-key (fn [n k]
                     (if (and (has-attrs? n) (not (contains? (attrs-of n) :key)))
                       (assoc n 1 (assoc (attrs-of n) :key k))
                       n))
        ;; kept keys, in NEW order, tagged with their OLD index. The anchors
        ;; that need no move are those whose old-index sits on the LIS of
        ;; this sequence — their relative order already matches.
        kept-old-indices (filterv some?
                                  (mapv (fn [n]
                                          (let [k (node-key n)]
                                            (if (contains? old-idx k) (get old-idx k) nil)))
                                        new-children))
        anchors (lis-set kept-old-indices)
        placements-recur
          (mapcat
            (fn [pair]
              (let [i (first pair) n (second pair) k (node-key n)]
                (if (contains? old-idx k)
                  ;; existing key: recurse for content; move unless it is an
                  ;; anchor (already correctly ordered relative to its peers)
                  (let [oi (get old-idx k)
                        old-child (nth old-children oi)
                        move (if (contains? anchors oi) [] [[:move path k i]])
                        inner (diff-fn (conj path i) old-child n)]
                    (concat inner move))
                  ;; new key: insert the whole subtree at index i, keyed
                  [[:insert path k i (attach-key n k)]])))
            (map-indexed (fn [i n] [i n]) new-children))]
    (concat removes placements-recur)))

;; ── positional child reconcile (no keys) ────────────────────────────

;; Positional reconcile pairs children by INDEX. It is correct only for the
;; overlap [0, min): beyond it, a longer NEW list has genuinely-new trailing
;; children (an :insert, never a :replace of a nonexistent index) and a longer
;; OLD list has trailing children to drop (a :remove-at, never a blanking
;; :text). Emitting :replace/:text on an out-of-range index silently DROPS the
;; extra node — the bug keys exist to avoid. Length/order changes without keys
;; are handled correctly here, but sub-optimally (every shifted child re-diffs
;; in place); `warn-unkeyed` flags exactly that case so a view author adds keys.
(defn- positional-child-ops
  [path old-children new-children diff-fn]
  (let [oc (count old-children)
        nc (count new-children)
        overlap (min oc nc)
        ;; [0, overlap): diff the paired children in place
        paired (mapcat (fn [i]
                         (diff-fn (conj path i) (nth old-children i) (nth new-children i)))
                       (range overlap))
        ;; NEW longer → append the surplus (index-based insert, nil key)
        inserts (mapcat (fn [i] [[:insert path nil i (nth new-children i)]])
                        (range overlap nc))
        ;; OLD longer → drop the surplus, HIGH index first so earlier indices
        ;; stay valid as each removal shrinks the list
        removes (mapv (fn [i] [:remove-at path i])
                      (reverse (into [] (range overlap oc))))]
    (concat paired inserts removes)))

;; ── self-awareness: warn when a diffed list should be keyed ─────────
;;
;; A hiccup tree is DATA the differ reconciles by re-running the view and
;; comparing. When a list of sibling elements changes length or order and the
;; children carry no `:key`, the differ falls back to positional reconcile:
;; still correct (the property test holds), but it re-diffs every shifted child
;; in place instead of moving a node. beam-lisp can SEE this happening — so it
;; says so, once, pointing at the parent tag, so the author adds keys where it
;; actually matters. Silence it with `(set-keyless-warning! false)`.

(def ^:private warn-flag :live.diff/warned-keyless)
(def ^:private warn-enabled (atom true))

(defn set-keyless-warning!
  "Enable/disable the dev warning about unkeyed diffed lists (default on)."
  [on?]
  (reset! warn-enabled on?))

(defn- warn-keyless! [tag old-n new-n]
  ;; fire at most once per process — a nudge, not a per-frame flood
  (when (and @warn-enabled (nil? (Process/get warn-flag)))
    (Process/put warn-flag true)
    (erlang/apply :io :put_chars
      (list :standard_error
        (str "\n[loom/diff] a <" (name tag) "> child list changed length ("
             old-n " → " new-n ") without :key on its children.\n"
             "           The view still renders correctly, but it is being\n"
             "           reconciled POSITIONALLY — add a :key to each child so a\n"
             "           reorder MOVES a node instead of re-diffing it in place.\n"
             "           e.g. (for [x xs] (row {:key (:id x)} …))\n"
             "           (silence: (live.diff/set-keyless-warning! false))\n\n")))))

;; ── the diff ────────────────────────────────────────────────────────

(defn diff
  "Structural diff of two hiccup nodes at `path` (default root []), a vector
   of patch ops. Applying them to `old` reconstructs `new` exactly."
  ([old new] (diff [] old new))
  ([path old new]
   (cond
     ;; identical: nothing to do (cheap short-circuit on unchanged subtrees)
     (= old new) []
     ;; both text (string/number): a text replacement
     (and (not (element? old)) (not (element? new))
          (not (vector? old)) (not (vector? new)))
       [[:text path (if (nil? new) "" (str new))]]
     ;; kind changed (text↔element, or different tag): a full replace
     (or (not (element? old)) (not (element? new))
         (not= (tag-of old) (tag-of new)))
       [[:replace path new]]
     ;; same tag: diff attrs, then children. `into []` REALIZES the op seq:
     ;; `concat`/`mapcat` are lazy, and a lazy seq that reaches the wire
     ;; (interop/->json) has no Jason encoder — the ops must be a plain
     ;; vector before they leave this fn.
     :else
       (let [oc (children-of old)
             nc (children-of new)
             keyed (or (all-keyed? oc) (all-keyed? nc))
             ;; warn only where keys would actually help: an UNKEYED list of
             ;; several element children whose length changed — the exact case
             ;; that reconciles positionally when it wanted to move nodes.
             _ (when (and (not keyed)
                          (not= (count oc) (count nc))
                          (> (max (count oc) (count nc)) 1)
                          (element? old))
                 (warn-keyless! (tag-of old) (count oc) (count nc)))
             child-ops (if keyed
                         (keyed-child-ops path oc nc diff)
                         (positional-child-ops path oc nc diff))]
         (into [] (concat (attr-ops path (attrs-of old) (attrs-of new))
                          child-ops))))))

;; ── apply-ops: the REFERENCE semantics (mirrored by the JS client) ──
;;
;; Not used in production (the client applies ops to the DOM); it exists so
;; the property test can assert (apply-ops (diff a b) a) == b, and so the
;; wire contract has an executable definition the JS is a port of.

(defn- get-at [node path]
  (if (empty? path)
    node
    (let [children (children-of node)
          i (first path)]
      (get-at (nth children i) (rest path)))))

(defn- update-children [node f]
  (let [t (tag-of node)
        a (attrs-of node)
        cs (f (children-of node))]
    (into [t a] cs)))

(defn- update-at [node path f]
  (if (empty? path)
    (f node)
    (update-children node
      (fn [cs]
        (let [i (first path)]
          (into [] (map-indexed
                     (fn [j c] (if (= j i) (update-at c (rest path) f) c))
                     cs)))))))

(defn- apply-op [tree op]
  (let [kind (first op) path (second op)]
    (cond
      (= kind :set-attr)
        (update-at tree path (fn [n]
          (into [(tag-of n) (assoc (attrs-of n) (keyword (nth op 2)) (nth op 3))]
                (children-of n))))
      (= kind :remove-attr)
        (update-at tree path (fn [n]
          (into [(tag-of n) (dissoc (attrs-of n) (keyword (nth op 2)))]
                (children-of n))))
      (= kind :text)
        (if (empty? path) (nth op 2)
          (update-at tree (butlast path) (fn [n]
            (update-children n (fn [cs]
              (let [i (last path)]
                (into [] (map-indexed (fn [j c] (if (= j i) (nth op 2) c)) cs))))))))
      (= kind :replace)
        (if (empty? path) (nth op 2)
          (update-at tree (butlast path) (fn [n]
            (update-children n (fn [cs]
              (let [i (last path)]
                (into [] (map-indexed (fn [j c] (if (= j i) (nth op 2) c)) cs))))))))
      (= kind :remove)
        (update-at tree path (fn [n]
          (update-children n (fn [cs]
            (filterv (fn [c] (not= (node-key c) (nth op 2))) cs)))))
      (= kind :insert)
        ;; insert the subtree (nth op 4) at index (nth op 3). Inserts are
        ;; applied in NEW order, so inserting at the target index builds the
        ;; right positions; the move pass then fixes any anchor ordering.
        (update-at tree path (fn [n]
          (update-children n (fn [cs]
            (let [idx (nth op 3) sub (nth op 4)]
              (into [] (concat (take idx cs) [sub] (drop idx cs))))))))
      (= kind :move)
        tree  ;; a move is a reorder; final positions are fixed by the pass below
      :else tree)))

(defn normalize
  "Rewrite a tree so every element has an EXPLICIT attrs map. `apply-ops`
   reconstructs in this form (its `update-children` always re-emits the
   attrs slot), so comparing a reconstruction to a target means comparing
   normalized to normalized — structural equality, not the incidental
   presence of an empty `{}`. Text/number nodes pass through.

   `:key` is excluded from the comparison: it is IDENTITY, not content —
   the differ may legitimately attach a key attr to an inserted subtree
   (see keyed-child-ops) without that counting as a difference."
  [node]
  (if (element? node)
    (into [(tag-of node) (dissoc (attrs-of node) :key)] (map normalize (children-of node)))
    node))

;; Structural (child-order) vs deep (in-place) op kinds. Structural ops
;; rebuild a parent's child list; deep ops mutate a node found by path. They
;; are applied in that order — structure first, so deep ops' NEW-index paths
;; land on the reordered tree, exactly as a DOM client patches attributes
;; after it has reconciled the keyed children.
(defn- structural-op? [op] (contains? #{:remove :remove-at :insert :move} (first op)))

;; Positional structural ops (`:remove-at idx`, `:insert path nil idx sub`)
;; are index-based, not key-based: reconcile by splicing. Removes apply high
;; index first (so lower indices stay valid), then inserts apply low index
;; first (each builds the growing list). This is the no-keys counterpart to
;; the keyed anchor-fill below.
(defn- rebuild-children-positional
  [old-children ops]
  (let [;; descending index order so each splice keeps lower indices valid.
        ;; NB: `(sort > …)` does not reliably descend here — sort ascending then
        ;; reverse.
        remove-idxs (reverse (sort (into [] (mapcat (fn [op] (if (= (first op) :remove-at) [(nth op 2)] [])) ops))))
        after-remove (reduce (fn [cs i] (into [] (concat (take i cs) (drop (+ i 1) cs))))
                             (into [] old-children) remove-idxs)
        insert-ops (sort-by (fn [op] (nth op 3))
                            (filterv (fn [op] (= (first op) :insert)) ops))]
    (reduce (fn [cs op]
              (let [idx (nth op 3) sub (nth op 4)]
                (into [] (concat (take idx cs) [sub] (drop idx cs)))))
            after-remove insert-ops)))

(defn- positional-ops?
  "Whether this parent's structural ops are positional (index-based) rather
   than keyed — the two never mix for one parent (the diff picks one path)."
  [ops]
  (reduce (fn [_ op]
            (if (or (= (first op) :remove-at)
                    (and (= (first op) :insert) (nil? (nth op 2))))
              (reduced true) false))
          false ops))

(defn- rebuild-children
  "Rebuild one parent's child vector from its structural ops. Keyed ops use
   anchor-fill (minimal-move reconciliation); positional ops splice by index."
  [old-children ops]
  (if (positional-ops? ops)
    (rebuild-children-positional old-children ops)
  (let [removed (reduce (fn [s op] (if (= (first op) :remove) (conj s (nth op 2)) s))
                        #{} ops)
        survivors (filterv (fn [c] (not (contains? removed (node-key c)))) old-children)
        moves (filterv (fn [op] (= (first op) :move)) ops)
        inserts (filterv (fn [op] (= (first op) :insert)) ops)
        moved-keys (reduce (fn [s op] (conj s (nth op 2))) #{} moves)
        ;; index → node it must occupy
        placed (merge
                 (reduce (fn [m op]
                           (let [k (nth op 2) idx (nth op 3)
                                 node (first (filterv (fn [c] (= (node-key c) k)) survivors))]
                             (assoc m idx node)))
                         {} moves)
                 (reduce (fn [m op] (assoc m (nth op 3) (nth op 4))) {} inserts))
        ;; anchors: survivors that did not move, in their existing order
        anchors (filterv (fn [c] (not (contains? moved-keys (node-key c)))) survivors)
        total (+ (count anchors) (count placed))]
    (loop [i 0 ai 0 acc []]
      (if (= i total)
        acc
        (if (contains? placed i)
          (recur (+ i 1) ai (conj acc (get placed i)))
          (recur (+ i 1) (+ ai 1) (conj acc (nth anchors ai)))))))))

(defn- apply-structural [tree ops]
  ;; group structural ops by parent path, deepest paths first so an inner
  ;; parent is rebuilt before an outer reorder could shift its index.
  (let [by-path (reduce (fn [m op]
                          (let [p (second op)]
                            (assoc m p (conj (get m p []) op))))
                        {} ops)
        paths (sort-by count > (into [] (keys by-path)))]
    (reduce (fn [t p]
              (update-at t p (fn [n]
                              (update-children n (fn [cs] (rebuild-children cs (get by-path p)))))))
            tree paths)))

(defn apply-ops
  "Apply patch ops to a tree, reconstructing the diff's target. The reference
   semantics the JS client mirrors: reconcile keyed children (anchor-fill),
   then patch attributes/text on the reordered tree."
  [ops tree]
  (let [structural (filterv structural-op? ops)
        deep (filterv (fn [op] (not (structural-op? op))) ops)
        reordered (apply-structural tree structural)
        patched (reduce apply-op reordered deep)]
    (normalize patched)))
