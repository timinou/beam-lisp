; Projection scheduling is a pure decision over ordered message data. It never
; removes events or writes: it only omits a render guaranteed by a later handler.
(ns live.projection)

(defn decision
  "One ordered lookahead step: :skip has a guaranteed later projection,
   :scan may cross a commit, and :render stops at a barrier."
  [change e]
  (let [kind (first e) own (first change)]
    (cond
      (= kind :commit) (if (= own :commit) :skip :scan)
      (= kind :navigate) (if (or (= own :commit) (= own :navigate)) :skip :render)
      (= kind :assign) (if (and (= own :assign) (= (second change) (second e))) :skip :render)
      :else :render)))

(defn superseded?
  "Can an asynchronous change omit its projection? `queued` is ordered event
   data, with [:commit] for world changes and [:barrier] for opaque messages.
   Only a single navigation or an assign to the same path can supersede locals.
   Intent, compound gesture, call and transport boundaries stop lookahead.
   Nothing is debounced: the final event always renders, even without a timer."
  [change queued]
  (loop [xs (seq queued)]
    (if (empty? xs)
      false
      (let [d (decision change (first xs))]
        (cond (= d :skip) true
              (= d :scan) (recur (rest xs))
              :else false)))))
