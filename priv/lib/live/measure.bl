(ns live.measure (:require [diagnostics :as diag]))

(def ^:private NAVIGATION-KEY :bl_live_navigation_phases)
(def ^:private ARRIVAL-KEY :bl_live_navigation_arrival)
(def ^:private PHASE-FIELDS
  {:worlds :live.navigation/worlds-us :screen :live.navigation/screen-us
   :view :live.navigation/view-us :realize :live.navigation/realize-us
   :diff :live.navigation/diff-us :styles :live.navigation/styles-us
   :html :live.navigation/html-us :serialize :live.navigation/serialize-us})

(defn timed
  "Measure this process's work only. Nested durations are inclusive. The event
   schema admits fixed phase names and numeric costs, never view/query data."
  [phase f]
  (let [start (erlang/monotonic_time :microsecond)
        reductions (elem (erlang/process_info (erlang/self) :reductions) 1)]
    (try (f)
      (finally
        (let [us (- (erlang/monotonic_time :microsecond) start)
              phases (erlang/get NAVIGATION-KEY)]
          (when (and (map? phases) (contains? PHASE-FIELDS phase))
            (let [field (get PHASE-FIELDS phase)]
              (erlang/put NAVIGATION-KEY (assoc phases field (+ (get phases field 0) us)))))
          (diag/emit! :live.phase/completed
            {:live.phase/name phase :live.phase/duration-us us
             :live.phase/reductions (- (elem (erlang/process_info (erlang/self) :reductions) 1) reductions)}))))))

(defn phase-enabled? []
  (or (map? (erlang/get NAVIGATION-KEY)) (diag/enabled? :live.phase/completed)))

(defmacro phase [name & body]
  ;; Disabled execution allocates no timing closure, IDs, clock samples or
  ;; reduction samples. Navigation aggregates enroll only their dynamic extent.
  `(if (live.measure/phase-enabled?)
     (live.measure/timed ~name (fn [] ~@body))
     (do ~@body)))

(defn- navigation-timed*
  "One info-level aggregate per handled navigation, without paths or query data.
   Phase costs are inclusive, not additive. Duration ends at server patch enqueue;
   queue-us separately measures trusted transport receipt to handler execution;
   transport delivery and browser paint are excluded. Mailbox count
   is a pressure hint, never a duration. Restore collection even if rendering fails."
  [f]
  (let [previous (erlang/get NAVIGATION-KEY)
        started (erlang/monotonic_time :microsecond)
        reductions (elem (erlang/process_info (erlang/self) :reductions) 1)
        queued (elem (erlang/process_info (erlang/self) :message_queue_len) 1)
        arrival (erlang/get ARRIVAL-KEY)
        queue-us (when (and (erlang/is_integer arrival) (<= arrival started)) (- started arrival))
        finish (fn [outcome]
                 (diag/emit! :live.navigation/completed
                   (merge (erlang/get NAVIGATION-KEY)
                     {:live.navigation/duration-us (- (erlang/monotonic_time :microsecond) started)
                      :live.navigation/reductions (- (elem (erlang/process_info (erlang/self) :reductions) 1) reductions)
                      :live.navigation/mailbox-count queued :live.navigation/outcome outcome
                      :live.navigation/queue-us queue-us})))]
    (erlang/put NAVIGATION-KEY {})
    (try
      (let [result (f)] (finish :returned) result)
      (catch e (finish :raised) (throw e))
      (finally (if (= previous :undefined) (erlang/erase NAVIGATION-KEY)
                   (erlang/put NAVIGATION-KEY previous))))))

(defn navigation-arrival
  "A trusted same-VM receipt clock. Never taken from browser frame data."
  [] (when (diag/enabled? :live.navigation/completed) (erlang/monotonic_time :microsecond)))

(defn with-arrival-fn [arrival f]
  (let [previous (erlang/get ARRIVAL-KEY)]
    (erlang/put ARRIVAL-KEY arrival)
    (try (f) (finally (if (= previous :undefined) (erlang/erase ARRIVAL-KEY)
                         (erlang/put ARRIVAL-KEY previous))))))

(defn navigation-timed
  "Give each navigation fresh server-minted linkage, retaining only trusted
   tenant/library/release context. Never reuse an old HTTP or ingestion span."
  [f]
  (diag/with-linkage-fn
    (assoc (select-keys (diag/context) [:diagnostics/tenant-id :diagnostics/library-id :diagnostics/release-id])
           :diagnostics/operation-id (diag/new-id))
    (fn [] (navigation-timed* f))))

(defmacro navigation [& body]
  `(if (diagnostics/enabled? :live.navigation/completed)
     (live.measure/navigation-timed (fn [] ~@body))
     (do ~@body)))
