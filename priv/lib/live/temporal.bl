; One owned next-deadline hint for a native projection. No domain facts or IO.
(ns live.temporal (:require [connector.clock :as clock]))
(def max-delay-ms 3600000)
(defn- fail! [] (throw (ex-info "Live deadlines require bounded absolute integer milliseconds" {:code :live-deadline})))
(defn- instant? [value] (and (erlang/is_integer value) (<= 0 value 9223372036854775807)))
(defn- now! [state]
 (let [value (clock/now (:clock state))] (when-not (instant? value) (fail!)) value))
(defn- cancel! [state]
 (when-let [timer (:timer state)] (erlang/cancel_timer timer))
 (assoc state :timer nil :timer-ticket nil :pending nil))
(defn open! [owned-clock]
 (when-not (and (map? owned-clock) (erlang/is_function (:now owned-clock) 0)) (fail!))
 (let [now (clock/now owned-clock)]
  (when-not (instant? now) (fail!))
  {:clock owned-clock :watch (clock/listen! owned-clock) :timer nil :timer-ticket nil
   :pending nil :deadline nil :active? false :projected-at now}))
(defn- arm! [state at now]
 (if (and at (clock/realtime? (:clock state)))
  (let [ticket (erlang/make_ref)
        timer (erlang/send_after (min max-delay-ms (- at now)) (erlang/self)
                                [:live/temporal-deadline ticket])]
   (assoc state :timer timer :timer-ticket ticket)) state))
(defn rearm!
 "After a current projection, cancel its old timer/ticket and derive ONE future
  deadline. A past result is already represented and cannot cause a busy loop."
 [state deadline active?]
 (when-not (or (nil? deadline) (instant? deadline)) (fail!))
 (let [now (now! state) cleared (cancel! state)
       at (when (and active? deadline (> deadline now)) deadline)
       current (assoc cleared :deadline at :active? (= true active?) :projected-at now)]
  (arm! current at now)))
(defn- enqueue! [state]
 (if (:pending state) state
  (let [ticket (erlang/make_ref)]
   (erlang/send (erlang/self) [:live/temporal-project ticket])
   (assoc state :pending ticket))))
(defn clock-changed!
 "Only this owned clock can wake a projection. Re-read current time so a burst
  whose last value has already been projected adds no second render."
 [state identity attached?]
 (if (and state attached? (:watch state) (= identity (:watch state))
          (not= (now! state) (:projected-at state))) (enqueue! state) state))
(defn deadline!
 "Ignore canceled/stale timers. Long deadlines use bounded timer segments;
  an early segment rearms without performing a view or provider operation."
 [state ticket attached?]
 (if (and state attached? (:active? state) (:timer-ticket state) (= ticket (:timer-ticket state)))
  (let [now (now! state) cleared (assoc state :timer nil :timer-ticket nil)]
   (if (>= now (:deadline state)) (enqueue! cleared)
    (arm! cleared (:deadline state) now))) state))
(defn project? [state ticket]
 (and state (:pending state) (= ticket (:pending state))))
(defn pause! [state]
 (when state (assoc (cancel! state) :deadline nil :active? false)))
(defn close! [state]
 (when state
  (cancel! state)
  (clock/unlisten! (:clock state))) :ok)
(defn status [state]
 {:configured? (boolean state) :active? (= true (:active? state))
  :armed? (boolean (:timer state)) :pending? (boolean (:pending state))
  :observable? (boolean (:watch state)) :deadline (:deadline state)})
