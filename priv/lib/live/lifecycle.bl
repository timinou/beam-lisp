; SDK adapter for ordinary live.app factories. No deployment code in the app.
(ns live.lifecycle
 (:require [live.app :as app] [reload.generation :as generation]
           [proc.inventory :as inventory] [datom.conn :as conn]))

(defn- refuse [kind] (throw (ex-info "Managed live application refused" {:kind kind})))
(defn- reference? [value]
 (and (string? value) (Regex/match? #"^[a-z][a-z0-9.-]*/[a-z][a-z0-9!?-]*$" value)))
(defn- parent-of [pid]
 (let [information (erlang/process_info pid :dictionary)]
  (when (tuple? information)
   (first (erlang/apply :proplists :get_value
            (list :"$ancestors" (elem information 1) (list)))))))
(defn- owned [graph]
 (let [result (inventory/snapshot (:application-id graph) 100 10000)]
  (when-not (= :valid (:status result)) (refuse :owner-inventory-unavailable))
  (into {} (keep (fn [entry]
    (when (and (contains? #{:server :supervisor} (:kind entry))
               (= (:origin-generation entry) (:digest graph)))
     (let [evidence (generation/owner-evidence (:pid entry))]
      (when-not evidence (refuse :owner-authority-changed))
      [(:pid entry) (assoc evidence :pid (:pid entry) :parent (parent-of (:pid entry)))])))
    (:participants result)))))
(defn- collect-children [graph before]
 (let [after (owned graph) parent (erlang/self)]
  (vec (keep (fn [[pid record]]
    (when-not (contains? before pid)
     ;; Parentage only gains meaning AFTER the native retained-owner proof.
     ;; A discovered arbitrary actor is never sent a shutdown request.
     (when (= parent (:parent record))
      (when-not (= :server (:kind record)) (refuse :background-supervisor-drain-contract-required))
      record))) after))))
(defn- initialized-app [graph factory]
 (when-not (reference? factory) (refuse :invalid-live-factory))
 (let [value (generation/invoke! graph factory [])]
  (when-not (and (map? value) (fn? (:principal value)) (fn? (:worlds value))
                 (vector? (:routes value)) (some? (:shared-conn value)))
   (refuse :invalid-managed-live-app))
  value))

(defn initialize!
 "Invoke the real initializer with declared borrowed options, validate its
  live.app factory and collect only native-proved direct initializer children.
  Caller is the stable lifecycle owner, before graph publication."
 [graph factory initialize borrow context]
 (when-not (and (reference? initialize) (map? borrow) (<= (count borrow) 32)
                (every? (fn [[option store]]
                  (and (keyword? option) (string? store) (contains? (:stores context) store))) borrow))
  (refuse :invalid-live-bootstrap))
 (generation/with! graph
  (fn []
   (let [before (owned graph)
         options (reduce (fn [result [option store]]
                    (assoc result option (get (:stores context) store)))
                  (select-keys context [:configuration :data-root :candidate]) borrow)
         _ (generation/invoke! graph initialize [options])
         app (initialized-app graph factory)
         _ (when-not (= :ready (:state (conn/writer-observation (:shared-conn app))))
             (refuse :live-shared-store-unavailable))
         children (collect-children graph before)]
    {:status :ready :owned-processes (mapv :pid children) :initializer-owners children}))))

(defn start-background!
 "Start the sealed domain background reference under its actual graph. New
  direct children are native creator-proved; no namespace/pid guessing. This
  constructor is an effect and must be invoked under a journal/lifecycle owner."
 [graph reference]
 (when-not (reference? reference) (refuse :invalid-background-reference))
 (generation/with! graph
  (fn [] (let [before (owned graph)]
    (try
     (generation/invoke! graph reference [])
     {:status :ready :generation (:digest graph) :owners (collect-children graph before)}
     (catch _
      ;; A constructor may have started work before throwing. Do not pretend
      ;; that the failure proves no effect or permits automatic re-execution.
      {:status :uncertain :kind :background-constructor-outcome-uncertain
       :generation (:digest graph) :owners (collect-children graph before)}))))))

(defn stop-background!
 "Stop only captured direct owned server children, gracefully. A timeout
  leaves an accepted handler/code/resources alive and returns waiting. Never
  infer physical provider cancellation or retry safety from a stop request."
 [records timeout-ms]
 (when-not (and (vector? records) (<= (count records) 10000)
                (erlang/is_integer timeout-ms) (<= 1 timeout-ms 30000))
  (refuse :invalid-background-drain))
 ;; Validate the entire finite inventory BEFORE sending even one stop. A
 ;; journal turn waits on at most one live child, so timeout bounds the turn;
 ;; following turns resume the same captured inventory without killing work.
 (let [live (vec (filter (fn [record]
    (let [pid (:pid record)]
     (when-not (erlang/is_pid pid) (refuse :invalid-background-owner))
     (when (Process/alive? pid)
      (let [actual (generation/owner-evidence pid)]
       (when-not (and (= :server (:kind record))
                      (= (select-keys record [:application-id :generation :module :ticket :kind])
                         (select-keys actual [:application-id :generation :module :ticket :kind]))
                      (= (erlang/self) (:parent record)) (= (:parent record) (parent-of pid)))
        (refuse :background-owner-authority-changed)))
      true))) records))]
  (when-let [record (first live)]
   (try (GenServer/stop (:pid record) :normal timeout-ms) (catch _ nil)))
  (let [waiting (count (filter (fn [record] (Process/alive? (:pid record))) live))]
   {:status (if (pos? waiting) :waiting :drained)
    :owners (count records) :waiting waiting})))

(defn route!
 "Factory and router share one atomically admitted selected graph. The app
  value stays inside that lease; native WebSocket sessions retain independently."
 [slot factory request]
 (generation/with-selected! slot
  (fn []
   (let [graph (generation/current) value (initialized-app graph factory)
         handler (fn [conn] (app/router value conn))]
    (if-let [around (:around value)] (around handler request) (handler request))))))
