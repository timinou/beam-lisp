; credential/env.bl — where a secret comes from, and nothing more.
;
; ── Why a file and not just the environment ──────────────────────────
;
; `System/get_env` is the right place to READ a secret and the wrong place
; to keep one: a value exported in a shell is inherited by every process the
; shell starts, is visible in `/proc/<pid>/environ`, and survives in a
; terminal's scrollback the moment someone echoes it. A `.env` file is
; mode 0600, gitignored, read once, and holds nothing a child inherits by
; accident.
;
; So this module reads a file. It deliberately does NOT export what it reads
; into the OS environment: that would hand the secret to every process the
; VM goes on to start, which is the property that made the file the better
; place to begin with. Callers pass a map around.
;
; ── What this is not ─────────────────────────────────────────────────
;
; Not a shell. No expansion (`$HOME` stays the five characters `$HOME`), no
; command substitution, no interpolation, no `source`. A `.env` that needs
; those needs a shell, and a program that needs a shell to read its
; credentials has a different problem. Saying so here is cheaper than being
; asked later why `${FOO}` came through verbatim.

(ns credential.env)

;; The three characters whose literals are easy to get wrong in a source
;; file, spelled by code point: a quote and a tab inside a string literal are
;; the kind of escaping that a reader may or may not honour, and a parser that
;; depends on the reader's escape rules is a parser with a portability bug.
(def ^:private DQUOTE (erlang/list_to_binary (list 34)))
(def ^:private SQUOTE (erlang/list_to_binary (list 39)))
(def ^:private TAB    (erlang/list_to_binary (list 9)))

(defn- comment-at
  "The index where a trailing comment begins, or nil. A `#` begins a comment
   only OUTSIDE quotes AND at the start of the line or after whitespace."
  [line]
  (loop [i 0 q nil]
    (if (>= i (count line))
      nil
      (let [c (subs line i (inc i))
            prev (if (> i 0) (subs line (- i 1) i) "")]
        (cond
          (and (not (nil? q)) (= c q))                (recur (inc i) nil)
          (and (nil? q) (or (= c DQUOTE) (= c SQUOTE))) (recur (inc i) c)
          (and (nil? q) (= c "#")
               (or (= 0 i) (= " " prev) (= TAB prev))) i
          :else                                       (recur (inc i) q))))))

(defn- strip-comment
  "A line without its trailing comment.

   Quote-aware, and it has to be: the naive version (cut at the first `#`)
   turns a quoted `a # b` into the value `\"a`, a silent corruption of any
   credential containing a `#` — a URL fragment, a colour, a generated
   password."
  [line]
  (let [at (comment-at line)]
    (if (nil? at) line (subs line 0 at))))

(defn- unquote
  "The value with one layer of matching surrounding quotes removed.

   Quoted values get their comment stripping skipped first, so
   `KEY=\"a # b\"` is the value `a # b` and not a truncated one."
  [v]
  (let [n (count v)]
    (if (and (>= n 2)
             (or (and (= "\"" (subs v 0 1)) (= "\"" (subs v (- n 1) n)))
                 (and (= "'" (subs v 0 1)) (= "'" (subs v (- n 1) n)))))
      (subs v 1 (- n 1))
      v)))

(defn parse
  "`.env` text → {\"KEY\" \"VALUE\"}. Pure, so the format is testable without
   a filesystem.

   Blank lines and `#` comments are dropped. An optional leading `export ` is
   accepted, so a file that a shell can also source still parses. The split is
   on the FIRST `=` only, because a secret may contain one (a base64
   signature, a connection string) and a parser that split on all of them
   would silently truncate every such secret."
  [text]
  (reduce
    (fn [acc raw]
      (let [line (String/trim (strip-comment raw))]
        (if (or (= "" line) (not (includes? line "=")))
          acc
          (let [line (if (String/starts_with? line "export ")
                       (String/trim (subs line 7))
                       line)
                parts (String/split line "=")
                k (String/trim (first parts))
                v (unquote (String/trim (join "=" (drop 1 parts))))]
            (if (= "" k) acc (assoc acc k v))))))
    {}
    (to-list (String/split text "\n"))))

(defn read-file
  "The env at `path` as a map, or {} when there is no such file.

   An absent file is {}, not an error: a `.env` is a convenience for a
   development tree, and a deployed one supplies the same keys the normal
   way. The failure that matters is a missing KEY, and `require!` is where
   that is reported — naming the key, not the file."
  [path]
  (let [r (File/read path)]
    (if (= :ok (elem r 0))
      (parse (elem r 1))
      {})))

(defn lookup
  "The value at `k`, or `default` (nil)."
  ([m k] (lookup m k nil))
  ([m k default] (let [v (get m k)] (if (nil? v) default v))))

(defn require!
  "The value at `k`, or a raise that names the key AND where to put it.

   Raising rather than returning nil is the point: every downstream symptom
   of a missing credential is confusing (`invalid_client`, a 401, a redirect
   that never arrives), and none of them names the thing that was actually
   absent."
  [m k]
  (let [v (get m k)]
    (if (or (nil? v) (= "" v))
      (throw (ex-info (str "credential: " k " is not set — add it to .env "
                           "(mode 0600, gitignored) or export it")
                      {:key k}))
      v)))
