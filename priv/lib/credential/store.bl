; credential/store.bl — where a grant lives, as a PORT.
;
; ── Why a protocol and not a path ────────────────────────────────────
;
; A grant has to live somewhere, and *somewhere* is a deployment decision:
; a file on a laptop, an env var in a container, a row in an encrypted
; database, a call out to `op` or Vault. The connector must not choose,
; for the same reason `datom.blob` does not choose its byte tier — the
; store that KNOWS is the store that decides, and a store for which
; plaintext would be wrong must REFUSE BY NAME rather than quietly write
; a refresh token to disk in the clear.
;
; So this is a protocol, and the four implementations in the design
; (file, env, datom, command) are four `extend-type` blocks away. The
; prototype ships the first.
;
; ── The shape of a grant at rest ─────────────────────────────────────
;
; Content is opaque to this module — it stores and returns, it does not
; interpret. That is deliberate: interpretation is `credential`'s job, and
; a store that understood the credential would have to change every time
; the credential gained a field.
;
; Keys are (service, account-id): the SAME pair that makes up the account
; entity's identity, so "which grant is this" and "which account is this"
; can never disagree.

(ns credential.store)

(defprotocol Store
  "Where a grant lives. Implementations must pass
   test/bl/credential/store_test.bl."

  (-get [s service account-id]
    "The stored grant, or nil when absent. Absent is NOT an error: an
     unconnected account is the normal starting state, and a store that
     raised here would make `authorize!`'s idempotence check a rescue.")

  (-put [s service account-id grant]
    "Store `grant` under the pair. Idempotent — a second put REPLACES, because
     a re-consent mints a new refresh token and the old one is dead.")

  (-delete [s service account-id]
    "Remove the grant (idempotent). This is DISCONNECT, not revocation:
     revocation is a call to the provider, and forgetting the token
     locally while it is still live at Google is a half-measure worth
     naming so nobody mistakes one for the other.")

  (-list [s]
    "Every pair held, as [[service account-id] …]. The roll-call that makes
     `which accounts am I connected to` a question with an answer.")

  (-where [s]
    "A human-readable description of where this store keeps things — for a
     log line or a `conn/status`, NEVER for reading a secret out."))

;; ── the prototype tier: one file per account, 0600 ───────────────────

(defrecord StoreFile [dir])

(defn store-file
  "A grant store rooted at `dir`, one file per (service, account-id).

   The honest default for a personal install and the wrong answer for a
   server: the bytes are `term_to_binary` and readable by anyone who can
   read the file, so the file must be unreadable by anyone else."
  [dir]
  (->StoreFile dir))

(defn- key-hex
  "The LEGACY filename for a (service, account-id) pair: the hex of the whole
   key. Read, never written — its length grows with the account id, and an
   id like `integration:firm:<slug>:google:<sub>` passes the filesystem's
   255-byte name limit (observed: `file name too long` on a real connect)."
  [service account-id]
  (binary/encode_hex (erlang/term_to_binary [service account-id])))

(defn- key-digest
  "The filename for a (service, account-id) pair: sha256 of the key, hex.

   Hashed, not the raw id: an account id is provider-supplied and can hold a
   `/`, a `:`, or a `..`, and a store that trusted it would let a remote
   value choose a path. Fixed length (64), so no id is too long to store.
   A digest cannot be read back, so the file carries its own key (`-put`)."
  [service account-id]
  (String/downcase (binary/encode_hex (crypto/hash :sha256 (erlang/term_to_binary [service account-id])))))

(defn- path-for [s service account-id]
  (str (:dir s) "/" (name service) "/" (key-digest service account-id) ".grant"))

(defn- legacy-path-for [s service account-id]
  (str (:dir s) "/" (name service) "/" (key-hex service account-id) ".grant"))

(def ^:private ENVELOPE :credential.store/v2)
;; ── the sealed tier: AES-256-GCM, key supplied by the deployment ─────
;;
;; The tier above is the honest default for a laptop and the wrong answer for
;; a server: the bytes are `term_to_binary` and readable by anyone who can
;; read the file. This tier is the server's — the grant is encrypted with
;; AES-256-GCM under a key the DEPLOYMENT supplies, so a database backup, a
;; stray `cp -r`, or a filesystem snapshot is not a grant leak.
;;
;; The key is 32 raw bytes, passed IN. Nothing here reads the environment,
;; walks a file, or derives a key from a passphrase: a store that chose its
;; own key would be a store whose key nobody can rotate. The deployment
;; decodes its configured key (`key-decode`) and hands it over.
;;
;; The (service, account-id) pair is the AEAD's ASSOCIATED DATA, and it is
;; taken from the CALLER's arguments — never from the file — so the tag
;; authenticates which account the ciphertext belongs to. Move a grant's file
;; to another account's name and it fails to open: the substitution is a
;; decryption failure, not a silent cross-account read.

(def ^:private SEALED :credential.store/sealed-v1)
(def ^:private KEY-BYTES 32)
(def ^:private NONCE-BYTES 12)   ; the GCM standard nonce

(def ^:private ENVELOPE :credential.store/v2)
(defn- file-format
  "What a stored file IS: :plaintext envelope, :sealed envelope, or :legacy
   (a bare grant under a hex-of-key name)."
  [path]
  (let [v (erlang/binary_to_term (File/read! path))]
    (cond
      (and (map? v) (= ENVELOPE (get v :format))) :plaintext
      (and (map? v) (= SEALED (get v :format))) :sealed
      :else :legacy)))

(defn- read-file
  "{:key [service account-id] :grant g} for a stored file. A v2 file is an
   envelope that names its key; a legacy file is the bare grant, its key
   decoded from its name."
  [path]
  (let [v (erlang/binary_to_term (File/read! path))]
    (if (and (map? v) (= ENVELOPE (get v :format)))
      {:key (:key v) :grant (:grant v)}
      {:key (erlang/binary_to_term
              (binary/decode_hex (String/replace (erlang/apply :filename :basename (list path)) ".grant" "")))
       :grant v})))

(defn- key-of-file
  "The [service account-id] pair a stored file names — for `-list`, which
   answers `which accounts am I connected to` and must not decrypt to do it.

   Sealed and v2 files name their key inside; a legacy file's name IS its
   key. A SEALED file's name is the digest of the key it claims, so the claim
   is CHECKED against the name: a file whose contents name a different account
   than its filename is refused rather than listed under a lie."
  [path f]
  (let [v (erlang/binary_to_term (File/read! path))]
    (cond
      (and (map? v) (= SEALED (get v :format)))
      (let [k (:key v)
            named (String/replace f ".grant" "")]
        (when (not= named (key-digest (first k) (second k)))
          (throw (ex-info (str "credential.store: sealed file " f
                               " names a key that does not hash to its name")
                          {:error :credential.store/key-mismatch
                           :file f :named named :key k})))
        k)

      (and (map? v) (= ENVELOPE (get v :format))) (:key v)

      :else
      (erlang/binary_to_term (binary/decode_hex (String/replace f ".grant" ""))))))

(defn- legacy-file
  "The legacy path when it exists — and only when its name is short enough to
   exist at all (asking the filesystem about a >255-byte name is an error)."
  [s service account-id]
  (let [n (+ 6 (count (key-hex service account-id)))]
    (when (<= n 255)
      (let [p (legacy-path-for s service account-id)]
        (when (File/exists? p) p)))))

(defn- err-message
  "A throwable as a string - ex-info carries a map, a raw error does not."
  [e]
  (if (map? e) (str (or (get e :message) e)) (str e)))

(defn- write-atomic!
  "term_to_binary → 0600 tmp → rename.

   The order is the security property, not the durability one: the file is
   chmod'ed BEFORE anything is written into it, so there is no window in
   which a readable file holds a refresh token. A straightforward
   `write then chmod` leaves exactly that window, and it is the kind of
   window that is only ever observed by someone you did not want."
  [dir path value]
  (let [tmp (str path ".tmp." (erlang/list_to_binary (os/getpid)))]
    (try
      (File/mkdir_p! dir)
      (File/write! tmp (erlang/term_to_binary value))
      (File/chmod tmp 384)                     ; 0o600
      (File/rename! tmp path)
      (catch e
        (throw (ex-info (str "credential.store: cannot write " path " - "
                             (err-message e))
                        {:error :credential.store/write-failed
                         :file path :reason (err-message e)}))))))

(extend-type StoreFile
  Store

  (-get [s service account-id]
    (let [p (path-for s service account-id)
          lp (when-not (File/exists? p) (legacy-file s service account-id))]
      (cond
        (File/exists? p)
                (if (= :sealed (file-format p))
                  (throw (ex-info (str "credential.store: sealed grant at " p
                                       " - this is a PLAINTEXT store; open it with store-sealed")
                                  {:error :credential.store/sealed-present :file p}))
                  (:grant (read-file p)))
        (some? lp) (:grant (read-file lp))
        :else nil)))

  (-put [s service account-id grant]
    (write-atomic! (str (:dir s) "/" (name service)) (path-for s service account-id)
                   {:format ENVELOPE :key [service account-id] :grant grant})
    ;; a legacy twin would answer -list twice; the v2 file supersedes it
    (let [lp (legacy-file s service account-id)] (when (some? lp) (File/rm! lp)))
    s)

  (-delete [s service account-id]
    (let [p (path-for s service account-id)
          lp (legacy-file s service account-id)]
      (when (File/exists? p) (File/rm! p))
      (when (some? lp) (File/rm! lp))
      s))

  (-list [s]
    (let [root (:dir s)]
      (if-not (File/exists? root)
        []
        (into []
          (mapcat
            (fn [svc]
              ;; `ls!` not `ls`: the bang form returns the list, the bare
              ;; one returns {:ok, list}, and unwrapping a tuple on every
              ;; call site is how a caller forgets to once.
              ;; the WHOLE pair, not its tail: dropping either half would
              ;; make `-list` unable to answer `-get`. A v2 file names its
              ;; key inside; a legacy file's name IS its key.
              (map (fn [f] (key-of-file (str root "/" svc "/" f) f))
                   (filter (fn [f] (String/ends_with? f ".grant"))
                           (File/ls! (str root "/" svc)))))
            (File/ls! root))))))

  (-where [s] (str "file store at " (:dir s))))


;; ── the sealed store, built ──────────────────────────────────────────

(defn- b64-pad
  "`s` padded to a multiple of four, which `Base/decode64!` requires and a
   key copied out of a config often is not."
  [s]
  (let [n (rem (count s) 4)]
    (if (= 0 n) s (str s (subs "====" 0 (- 4 n))))))

(defn key-decode
  "A 32-byte key from its textual form: 64 hex characters, or base64.

   REFUSES anything that does not decode to exactly 32 bytes. A short key is
   a weak key, and silently padding or hashing one would accept a deployment
   that meant something else; a long one is not this cipher's key at all.

   The key is a secret, so this is the ONLY place it is allowed to come from
   text — and the result is bytes the caller hands to `store-sealed`, never a
   value that lands in a log or an inspect."
  [s]
  (let [raw (cond
              (not (string? s)) nil
              (= 64 (count s)) (try (binary/decode_hex s) (catch _e nil))
              :else (try (Base/decode64!
                          (b64-pad (String/replace (String/replace s "-" "+") "_" "/")))
                         (catch _e nil)))]
    (if (and (erlang/is_binary raw) (= KEY-BYTES (erlang/byte_size raw)))
      raw
      (throw (ex-info (str "credential.store: the grant key must decode to "
                           KEY-BYTES " bytes (64 hex chars, or base64) — got "
                           (if (erlang/is_binary raw)
                             (str (erlang/byte_size raw) " bytes")
                             "nothing decodable"))
                      {:error :credential.store/invalid-key
                       :bytes (when (erlang/is_binary raw) (erlang/byte_size raw))})))))

(defrecord StoreSealed [dir key])

(defn store-sealed
  "A SEALED grant store rooted at `dir`, under `key`.

   `key` is 32 raw bytes — an AES-256-GCM key — supplied by the deployment's
   config, not chosen here (`key-decode` turns a configured string into one).
   REFUSES a missing or wrong-length key BY NAME, because the one failure a
   sealed store must never have is `no key, so it stored in the clear`.

   The plaintext `store-file` is unchanged and stays the dev default. There
   is no silent upgrade in either direction: this store refuses to read a
   plaintext grant, and `store-file` refuses to read a sealed one. Bringing
   old grants across is the deliberate `migrate-to-sealed!`, run once, with
   the key you intend to keep."
  [dir key]
  (cond
    (nil? key)
    (throw (ex-info (str "credential.store: store-sealed needs a grant key — "
                         "32 bytes from the deployment's config; refusing to "
                         "store grants in the clear instead")
                    {:error :credential.store/missing-key}))

    (not (erlang/is_binary key))
    (throw (ex-info "credential.store: the grant key must be a 32-byte binary"
                    {:error :credential.store/invalid-key}))

    (not= KEY-BYTES (erlang/byte_size key))
    (throw (ex-info (str "credential.store: the grant key must be exactly "
                         KEY-BYTES " bytes, got " (erlang/byte_size key))
                    {:error :credential.store/invalid-key
                     :bytes (erlang/byte_size key)}))

    :else (->StoreSealed dir key)))

(defn- aad
  "The associated data that binds a ciphertext to its account: the format and
   the (service, account-id) pair, as bytes.

   The pair comes from the CALLER's arguments — never from the file — so a
   grant copied to another account's name fails to open rather than opening
   as the wrong account. Both halves must survive to decrypt."
  [service account-id]
  (erlang/term_to_binary [SEALED service account-id]))

(defn- seal
  "`grant` as a sealed envelope: a fresh nonce, the ciphertext, the tag.

   A FRESH nonce every write, from `strong_rand_bytes` — a GCM nonce may
   never repeat under one key, and a counter or a timestamp is a nonce that
   repeats the moment a clock does."
  [key service account-id grant]
  (let [iv (erlang/apply :crypto :strong_rand_bytes (list NONCE-BYTES))
        enc (erlang/apply :crypto :crypto_one_time_aead
                          (list :aes_256_gcm key iv (erlang/term_to_binary grant)
                                (aad service account-id) true))]
    {:format SEALED
     :key [service account-id]
     :iv iv
     :tag (erlang/element 2 enc)
     :ct (erlang/element 1 enc)}))

(defn- unseal
  "The grant inside a sealed envelope, or a REFUSAL.

   GCM verifies the tag against the AAD, so a wrong key, a flipped byte, or a
   file that belongs to another account all arrive here as the same `:error`
   — and all three are refused rather than returned as garbage."
  [key env service account-id]
  (let [plain (erlang/apply :crypto :crypto_one_time_aead
                            (list :aes_256_gcm key (:iv env) (:ct env)
                                  (aad service account-id) (:tag env) false))]
    (if (= :error plain)
      (throw (ex-info (str "credential.store: sealed grant will not open — "
                           "wrong key, a changed file, or a file that belongs "
                           "to another account")
                      {:error :credential.store/decrypt-failed
                       :key [service account-id]}))
      (erlang/binary_to_term plain))))

(extend-type StoreSealed
  Store

  (-get [s service account-id]
    (let [p (path-for s service account-id)
          lp (when-not (File/exists? p) (legacy-file s service account-id))
          path (cond (File/exists? p) p (some? lp) lp :else nil)]
      (when (some? path)
        (if (= :sealed (file-format path))
          (let [env (erlang/binary_to_term (File/read! path))]
            ;; the file must NAME the account it was asked for; the AAD check
            ;; below would refuse a substitution anyway, but this says WHY.
            (when (not= [service account-id] (:key env))
              (throw (ex-info (str "credential.store: sealed file names " (:key env)
                                   ", not " [service account-id])
                              {:error :credential.store/key-mismatch
                               :want [service account-id] :got (:key env)})))
            (unseal (:key s) env service account-id))
          (throw (ex-info (str "credential.store: plaintext grant at " path
                               " — this is a SEALED store; migrate deliberately "
                               "with migrate-to-sealed!")
                          {:error :credential.store/plaintext-present :file path}))))))

  (-put [s service account-id grant]
    (write-atomic! (str (:dir s) "/" (name service))
                   (path-for s service account-id)
                   (seal (:key s) service account-id grant))
    ;; a superseded plaintext twin is removed — not migrated, just dead: the
    ;; grant it held has been replaced by the one just written.
    (let [lp (legacy-file s service account-id)] (when (some? lp) (File/rm! lp)))
    s)

  (-delete [s service account-id]
    (let [p (path-for s service account-id)
          lp (legacy-file s service account-id)]
      (when (File/exists? p) (File/rm! p))
      (when (some? lp) (File/rm! lp))
      s))

  (-list [s]
    (let [root (:dir s)]
      (if-not (File/exists? root)
        []
        (into []
          (mapcat
            (fn [svc]
              (map (fn [f] (key-of-file (str root "/" svc "/" f) f))
                   (filter (fn [f] (String/ends_with? f ".grant"))
                           (File/ls! (str root "/" svc)))))
            (File/ls! root))))))

  (-where [s] (str "sealed file store at " (:dir s))))

;; ── bringing a plaintext tree across, DELIBERATELY ───────────────────

(defn- stored-format
  "What the grant for a pair IS on disk right now, or nil when absent."
  [s service account-id]
  (let [p (path-for s service account-id)]
    (cond
      (File/exists? p) (file-format p)
      (some? (legacy-file s service account-id)) :legacy
      :else nil)))

(defn migrate-to-sealed!
  "Re-seal every PLAINTEXT grant under `dir` into a sealed one, ONCE.

   Nothing calls this for you. A store that silently encrypted a live grant
   would be a store that changed what is at rest without being asked — and a
   wrong key would turn every grant into unreadable bytes with nothing to say
   so. The caller runs this, with the key it intends to keep, on a plaintext
   tree it has decided to move; grants already sealed are left alone.

   Each grant is read through the PLAINTEXT store (so legacy-named files come
   across too) and written through the SEALED one, which lands on the same
   digest path and removes a superseded legacy twin. Returns the count moved."
  [dir key]
  (let [src (store-file dir)
        dst (store-sealed dir key)]
    (loop [ks (-list src) n 0]
      (if (empty? ks)
        n
        (let [k (first ks) svc (first k) acct (second k)]
          (if (= :sealed (stored-format src svc acct))
            (recur (rest ks) n)
            (do (-put dst svc acct (-get src svc acct))
                (recur (rest ks) (inc n)))))))))
