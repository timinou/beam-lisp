; credential/flow.bl — the dance, around one human click.
;
; ── The shape ────────────────────────────────────────────────────────
;
;   mint a verifier ──► claim a port ──► listen ──► build the URL
;         │                                            │
;         │                                      ( the human )
;         │                                            │
;         └──────────► exchange ◄── the callback ◄─────┘
;
; Everything before the click and everything after it is code that can be
; tested. The click is the only step that cannot, which is why the two
; halves are split at exactly that line: `begin!` returns the URL and
; `finish!` takes a code, and neither one needs the other.
;
; ── The port is claimed, never hard-coded ────────────────────────────
;
; A literal port is a promise about a number, and a promise about a number
; is a promise that a laptop with a dev server on :8000 will break. So the
; port is BOUND, not assumed: `bind-loopback(0)` lets the OS choose, and the
; number it chose is read back off the socket with `:inet.port/1`.
;
;   want 0  → the OS chooses.
;   want N  → we want THAT number, and fail loudly if it is taken, rather
;             than quietly serving somewhere the registered redirect
;             cannot reach.
;
; `vm.ports` is the tree's registry for this, and it is the right answer
; when something ELSE must discover the port — a `bl serve` route, another
; VM, a supervisor. A callback listener has no such reader: the URL is
; built from the port in this same function, so the port is read back off
; the socket (`:inet.port/1`) and can never disagree with the URL. A
; registry would be a second place for the truth to live.
;
; ── Which one you want depends on the CLIENT, and this is the honest bit ──
;
; A provider's registered redirect URI may pin the port. Google's rule
; splits by client type: an INSTALLED-app client accepts loopback on any
; port (RFC 8252), while a WEB client must match the registered URI
; character for character — port included. So `:port` is configuration
; with a default of 0, and `:redirect` says what to build from it.
;
; NB: which rule applies cannot be determined without completing a real
; consent. Google's token endpoint rejects a bad CODE before it ever
; compares `redirect_uri`, so a probe with a bogus code answers
; `invalid_grant` for a registered URI, a moved port and a changed path
; alike — measured. The first live run is the test; a
; `redirect_uri_mismatch` there means pin the port, nothing more.

; ── Two beginnings, one flow ────────────────────────────────────────
;
; The same shape serves a laptop and a server, and the only difference is
; who answers the callback:
;
;   begin! / finish!         the DEV loopback (RFC 8252): this process binds
;                            a port, hands back `:lsock`, and `finish!`
;                            blocks on it. The halves are joined by a live
;                            process.
;   begin-web / finish-web!  the PRODUCTION web redirect: the app serves a
;                            public route and the browser comes back to it
;                            in a different request. No socket here — the
;                            halves are joined by a one-time, expiring
;                            `state` kept in a `Pending` store.
;
; After the exchange the two are the same code path (`exchange-code`), so an
; app swaps halves without swapping anything downstream, and both present
; the redirect and verifier they RECORDED rather than any value read off the
; callback. `finish-web!` refuses, by name, on a missing/unknown/replayed/
; expired state, a session (firm or principal) other than the one that
; began, a client or redirect that changed since the URL was minted, a
; provider `error=`, and a callback with no code — and it consumes the state
; before deciding any of them.
;

(ns credential.flow
  (:require [credential.oauth2 :as oauth]
            [credential.pending :as pending]
            [credential.store :as store]
            [interop]))

;; The Elixir module, bound once. A namespace that is not on the load path
;; is reached through `erlang/apply`, and the module atom has to come from
;; somewhere — `binary_to_atom` is the tree's idiom for it (see
;; `priv/lib/tooling/catalog.bl`), and it is spelled here rather than inline
;; so `parse-query` reads as the parse it is.
(def ^:private URI (erlang/binary_to_atom "Elixir.URI"))

;; No regex. A redirect URI is three fixed pieces — scheme, authority,
;; path — and `Regex.run` through interop was a dependency this does not
;; need for a job `String/split` does exactly. The one thing to be careful
;; about is that BOTH halves matter: the authority carries the port, the
;; path is where the listener must answer.

(defn- authority
  "The `host:port` of a URI, or nil for one with no `://`."
  [uri]
  (first (String/split (second (String/split uri "://")) "/")))

(defn redirect-port
  "The port a redirect URI names, or nil for one that names none.

   nil is a real answer, not a failure: `http://localhost/cb` means the
   default port for the scheme, and refusing it would reject a legal URI."
  [uri]
  (let [a (authority uri)]
    (if (nil? a)
      nil
      (let [parts (String/split a ":")]
        (if (> (count parts) 1)
          (erlang/binary_to_integer (second parts))
          nil)))))

(defn with-port
  "`uri` with its port replaced — the string the provider compares byte for byte.

   This is what makes an ephemeral port usable at all: the registered URI
   supplies the SHAPE and the bound port supplies the NUMBER. Parsing and
   re-printing the URI would also work and would normalise things nobody
   asked it to normalise; a substitution touches the one token we mean."
  [uri port]
  (let [p (redirect-port uri)]
    (if (nil? p)
      uri
      (String/replace uri (str ":" p) (str ":" port)))))

(defn callback-path
  "The path a redirect URI names — where the listener must answer."
  [uri]
  (let [after (second (String/split uri "://"))
        path (first (String/split (str after) "?"))]
    (if (nil? after)
      "/"
      (let [segs (to-list (String/split path "/"))]
        (if (<= (count segs) 1)
          "/"
          (str "/" (join "/" (drop 1 segs))))))))

;; ── the listener: one request, one page of HTML, then gone ───────────

(defn- parse-query
  "`a=1&b=2` → {\"a\" \"1\" \"b\" \"2\"}, percent-decoded.

   A hand-rolled parse is defensible HERE and nowhere else: this is one
   line of a callback URL that this same process just caused to exist,
   not an input surface."
  [q]
  (into {}
    (map (fn [kv]
           (let [parts (String/split kv "=")
                 k (first parts)
                 ;; REJOINED, not `(second parts)`. A value is allowed to
                 ;; contain `=`, and Google's authorization codes do — taking
                 ;; element 2 alone truncates the code at its first `=` and the
                 ;; provider answers `invalid_grant`, which names nothing that
                 ;; would send you looking at the parse.
                 v (join "=" (drop 1 parts))]
             (tuple (erlang/apply URI :decode_www_form (list k))
                    (erlang/apply URI :decode_www_form (list v)))))
         (to-list (String/split q "&")))))

(defn- http-body
  [code title]
  (str "<!doctype html><meta charset=utf-8><title>" title "</title>"
       "<style>body{font:16px/1.6 system-ui;margin:4rem auto;max-width:34rem}"
       "code{background:#f2f2f2;padding:.2em .4em;border-radius:4px}</style>"
       "<h1>" title "</h1><p>You can close this tab and return to the terminal.</p>"
       (if code (str "<p><code>" code "</code></p>") "")))

(defn- respond!
  [conn status title code]
  (let [body (http-body code title)
        head (str "HTTP/1.1 " status " \r\n"
                  "Content-Type: text/html; charset=utf-8\r\n"
                  "Content-Length: " (erlang/byte_size body) "\r\n"
                  "Connection: close\r\n\r\n")]
    (gen_tcp/send conn (str head body))
    (gen_tcp/close conn)))

(defn bind-loopback
  "Listen on `port` on the loopback interface only.

   `127.0.0.1`, never `0.0.0.0`: a callback carries an authorization code,
   and a code is a bearer credential for the few seconds it is valid. There
   is no reason for it to be reachable from the network, and a listener
   that binds every interface is reachable from a coffee-shop wifi."
  [port]
  (gen_tcp/listen port
    (list :binary (tuple :packet :raw)
          (tuple :active false) (tuple :reuseaddr true)
          (tuple :ip (tuple 127 0 0 1)))))

(def ^:private CALLBACK-FENCE-MS
  "How long to hold the listener open for a human.

   Ten minutes, and it is a HUMAN budget, not a network one: the person on the
   other end is reading a consent screen, possibly an unverified-app warning,
   possibly a second factor. The first version used five, which is enough to
   click and not enough to read — and when it expired the process simply ended
   with no output, so a slow click looked identical to a crash."
  600000)

(defn- read-request
  "Everything up to the blank line that ends the request headers.

   Read in a LOOP, never one `recv`. A request can arrive in more than one
   segment, and a single read that returns early truncates the URL — and a
   truncated `code` is rejected as `invalid_grant`, which names nothing that
   would send you looking at the read. The cap is a backstop, not a size
   estimate."
  [conn]
  (loop [acc "" n 0]
    (if (or (>= n 16) (includes? acc "\r\n\r\n"))
      acc
      (let [r (gen_tcp/recv conn 0 4096)]
        (if (= :ok (elem r 0))
          (recur (str acc (elem r 1)) (inc n))
          acc)))))

(defn accept-callback
  "Block until a request arrives on `lsock`, answer it, and close.

   Returns {:code … :state …} or {:error …}. Two outcomes are NORMAL RETURNS
   and not exceptions, because both are things a human does:

     :declined       Google redirects to the SAME URI with `error=` instead of
                     `code=` when the person says no. Raising here would turn
                     `the human said no` into a crash page.
     :state-mismatch a callback carrying a different `state` did not come from
                     the URL this process printed. Refusing it is the whole
                     point of the parameter — without this check the binding is
                     decoration."
  [lsock expected-state]
  (try
    (let [accepted (gen_tcp/accept lsock CALLBACK-FENCE-MS)]
      (if (not= :ok (elem accepted 0))
        {:error :no-callback
         :detail (elem accepted 1)
         :hint "nothing connected before the fence expired — click the URL, or re-run"}
        (let [conn (elem accepted 1)
              head (read-request conn)
              line (first (String/split head "\r\n"))
              parts (String/split line " ")
              target (if (> (count parts) 1) (second parts) "")
              qs (second (String/split target "?"))
              params (if (some? qs) (parse-query qs) {})]
          (if (not (contains? params "code"))
            (do (respond! conn "200 OK" "Not connected"
                          (str (get params "error") " — " (get params "error_description")))
                {:error :declined
                 :reason (get params "error")
                 :description (get params "error_description")})
            (if (and (some? expected-state) (not= expected-state (get params "state")))
              (do (respond! conn "400 Bad Request" "Not connected"
                            "this callback did not come from the URL this process printed")
                  {:error :state-mismatch
                   :expected expected-state
                   :got (get params "state")})
              (do (respond! conn "200 OK" "Connected" (get params "code"))
                  {:code (get params "code") :state (get params "state")}))))))
    (finally (gen_tcp/close lsock))))

(defn begin!
  "Bind, mint a verifier, and hand back everything the click needs.

   Nothing here talks to the network, so it is testable end to end — and the
   bind happens HERE so that the returned URL is honest the moment it
   exists, rather than honest a moment later when someone gets round to
   accepting."
  [cfg]
  (let [{:keys [client-id redirect scopes state port]} cfg
        want (or port (redirect-port redirect) 0)
        lsock (elem (bind-loopback want) 1)
        ;; `:inet.port/1` answers `{:ok, Port}` on this OTP, NOT a bare port
        ;; — measured, and it matters: unwrapped, the tuple goes into
        ;; `redirect_uri` as the url-encoded `%7B%3Aok%2C+45183%7D` and the
        ;; provider rejects the request for a redirect that was never sent.
        p (elem (erlang/apply :inet :port (list lsock)) 1)
        bound (with-port redirect p)
        verifier (oauth/verifier)]
    {:url (oauth/auth-url {:client-id client-id
                           :redirect-uri bound
                           :scopes scopes
                           :challenge (oauth/challenge verifier)
                           :state state})
     :verifier verifier
     :state state
     :scopes scopes
     :port p
     :lsock lsock
     :redirect bound
     :path (callback-path redirect)}))

(defn post-form!
  "POST `body` as `application/x-www-form-urlencoded`. → {:status n :body b}.

   FORM, not JSON, and that is not a detail: OAuth 2.0's token endpoint takes
   `application/x-www-form-urlencoded` (RFC 6749 §4.1.3). The body is already
   built by `oauth/exchange-body` -> `oauth/form-encode`, both of which are
   pinned by tests, so this function's whole job is the wire.

   It answers a VALUE for every outcome — a transport failure is
   `{:status 0 :body reason}`, never a raise. `finish!` branches on `:status`,
   and a raise here would turn 'the wifi dropped' into a stack trace, which is
   the one thing a sign-in flow must never do."
  [url body]
  (Application/ensure_all_started :ssl)
  (Application/ensure_all_started :inets)
  (let [ct (String/to_charlist "application/x-www-form-urlencoded")
        r (httpc/request :post
            ;; The content type is the FOURTH element of the request tuple and
            ;; NOWHERE else. Passing it in the header list as well sends the
            ;; header twice and the endpoint answers "Your client has issued a
            ;; malformed or illegal request" — measured, against the real token
            ;; endpoint, as a 400 with an HTML body where the JSON error should
            ;; have been.
            (tuple (String/to_charlist url)
                   (list)
                   ct
                   body)
            (list (tuple :timeout 30000))
            (list (tuple :body_format :binary)))]
    (if (= :ok (elem r 0))
      ;; httpc answers {{HttpVersion, Status, Reason}, Headers, Body}
      (let [resp (elem r 1)]
        {:status (elem (elem resp 0) 1)
         :body (elem resp 2)})
      {:status 0 :body (elem r 1)})))

(defn- exchange-code
  "Trade an authorization code for tokens through `post!`. → {:ok token} | {:error …}.

   Shared by the loopback `finish!` and the web `finish-web!`: the exchange is
   one step in both, and the verifier and redirect it presents are the ones
   THIS PROCESS recorded when it minted the URL — never values read off the
   callback (see `finish-web!`).

   Built ONCE and bound, so the failure can carry what was actually sent.
   A rejection with no record of the request is a dead end: `invalid_grant`
   is what Google answers for a stale code, a replayed code, a verifier
   that does not match, and a redirect_uri that does not match — four
   different repairs, one message. `redact` keeps the secrets out while
   keeping the shapes in."
  [client-id client-secret code verifier redirect post!]
  (let [body (oauth/form-encode
               (oauth/exchange-body {:client-id client-id
                                     :client-secret client-secret
                                     :code code
                                     :verifier verifier
                                     :redirect-uri redirect}))
        resp (post! oauth/TOKEN-ENDPOINT body)]
    (if (= 200 (:status resp))
      (oauth/decode-token (:body resp))
      {:error :exchange-failed
       :body (oauth/decode-error (:body resp))
       :request (oauth/redact body)})))

(defn finish!
  "Wait for the redirect, then trade the code for tokens.

   `post!` is injected rather than called directly: the exchange is the one
   step that needs a network, so keeping it a parameter is what lets the
   rest of this file be exercised without one. The 2-arity form is the real
   thing — `post-form!` — which is what a caller wants nine times in ten."
  ([cfg begun] (finish! cfg begun post-form!))
  ([cfg begun post!]
   (let [got (accept-callback (:lsock begun) (:state begun))]
     (if (contains? got :error)
       got
       (exchange-code (:client-id cfg) (:client-secret cfg) (:code got)
                      (:verifier begun) (:redirect begun) post!)))))


;; ── the web redirect: two request halves, one stored attempt ─────────

(def ^:private WEB-TTL-MS
  "How long a web authorization attempt waits for the browser to come back.

   The same ten-minute human budget as CALLBACK-FENCE-MS — a consent screen,
   a warning, a second factor — but enforced by a timestamp instead of a
   socket: the request that began the flow and the request that finishes it
   are different requests, and nothing but the record connects them."
  600000)

(def ^:private WEB-CONFIG-KEYS
  "The config `begin-web` and `finish-web!` both require, in one place so a
   missing key is reported by NAME and the two halves cannot drift apart."
  [:client-id :client-secret :redirect :firm :principal])

(defn- absent-keys
  "The keys in `ks` that `cfg` carries no usable value for."
  [cfg ks]
  (into [] (filter (fn [k] (let [v (get cfg k)] (or (nil? v) (= "" v)))) ks)))

(defn- absolute-uri?
  "Whether `u` names an absolute URI (a scheme, then `://`)."
  [u]
  (and (string? u) (includes? u "://")))

(defn- callback-params
  "The callback's parameters as a string-keyed map, from either the raw query
   string the wire carries or an already-parsed map."
  [q]
  (if (string? q) (parse-query q) q))

(defn begin-web
  "Mint one web authorization attempt and return the consent URL.

   `cfg` — `:client-id :client-secret :redirect :scopes :firm :principal`,
   the same client the loopback half takes plus the session context the
   callback will be checked against. Optional `:ttl-ms`, `:login-hint`,
   `:prompt`.

   `pending` — where the attempt is kept until the callback (see
   `credential.pending`). This half makes NO network call: the whole point of
   splitting the flow is that the URL can be built and tested without one.

   → {:ok {:url u :state s :expires-at ms :redirect u :firm f :principal p}}
   | {:error :missing-config :keys [k …]}
   | {:error :invalid-redirect :redirect u}

   The `state` is minted HERE, never accepted from the caller: it is the
   single-use, expiring handle the callback is matched against, and a caller
   free to choose it is a caller free to make two attempts collide. The PKCE
   `verifier` is deliberately NOT returned — it is stored with the attempt and
   read back at `finish-web!`, because a verifier the app holds is a verifier
   the app can copy into a log."
  [cfg pending]
  (let [missing (absent-keys cfg (conj WEB-CONFIG-KEYS :scopes))]
    (cond
      (not (empty? missing))
      {:error :missing-config :keys missing}

      (not (absolute-uri? (:redirect cfg)))
      {:error :invalid-redirect :redirect (:redirect cfg)}

      :else
      (let [now (erlang/system_time :millisecond)
            expires-at (+ now (or (:ttl-ms cfg) WEB-TTL-MS))
            state (oauth/state)
            verifier (oauth/verifier)
            base {:client-id (:client-id cfg)
                  :redirect-uri (:redirect cfg)
                  :scopes (:scopes cfg)
                  :challenge (oauth/challenge verifier)
                  :state state}
            opts (if-let [p (:prompt cfg)] (assoc base :prompt p) base)
            opts (if-let [h (:login-hint cfg)] (assoc opts :login-hint h) opts)]
        (pending/-put pending state
                      {:verifier verifier
                       :firm (:firm cfg)
                       :principal (:principal cfg)
                       :client-id (:client-id cfg)
                       :redirect (:redirect cfg)
                       :scopes (:scopes cfg)
                       :created-at now
                       :expires-at expires-at})
        {:ok {:url (oauth/auth-url opts)
              :state state
              :expires-at expires-at
              :redirect (:redirect cfg)
              :firm (:firm cfg)
              :principal (:principal cfg)}}))))

(defn finish-web!
  "Finish the web attempt a callback belongs to, and trade its code for tokens.

   `cfg` — the same client and session context `begin-web` was given.
   `params` — the callback's query string (`a=1&b=2`), or the parsed
   string-keyed map. `post!` is injected exactly as in `finish!`, so every
   branch but the exchange is exercised offline.

   → {:ok token}                                   (as `finish!`)
   | {:error :missing-config :keys [k …]}
   | {:error :missing-state}
   | {:error :unknown-state}                       wrong, or already spent
   | {:error :state-expired :at :expires-at}
   | {:error :state-mismatch :attempt :session}
   | {:error :client-mismatch :attempt :config}
   | {:error :redirect-mismatch :attempt :config}
   | {:error :declined :reason :description}       the human said no
   | {:error :provider-error :reason :description}
   | {:error :missing-code}
   | {:error :exchange-failed :body :request}      (as `finish!`, redacted)

   THE STATE IS CONSUMED BEFORE ANY OF THESE ARE DECIDED, once it is found:
   a callback is a single use of a single attempt, and a check that leaves
   the state behind is a check an attacker can present a different `code`
   against. `:unknown-state` is therefore what a REPLAY gets — the store no
   longer holds the attempt — and it is deliberately the same answer a
   forged state gets: telling the two apart would mean keeping every spent
   state, which is the state-tracking this store exists to bound.

   The `redirect` and `verifier` presented to the provider are the ones the
   attempt RECORDED. Nothing here reads a redirect from the callback or its
   `Host` header; a redirect supplied by the requester would let the
   requester choose where the code is sent."
  ([cfg params pending] (finish-web! cfg params pending post-form!))
  ([cfg params pending post!]
   (let [missing (absent-keys cfg WEB-CONFIG-KEYS)]
     (if (not (empty? missing))
       {:error :missing-config :keys missing}
       (let [params (callback-params params)
             state (get params "state")]
         (if (nil? state)
           {:error :missing-state}
           (let [taken (pending/-take pending state)
                 now (erlang/system_time :millisecond)]
             (cond
               (nil? taken)
               {:error :unknown-state
                :detail "no attempt is waiting for this state — it was never issued, or already spent"}

               (>= now (:expires-at taken))
               {:error :state-expired :at now :expires-at (:expires-at taken)}

               (or (not= (:firm taken) (:firm cfg))
                   (not= (:principal taken) (:principal cfg)))
               {:error :state-mismatch
                :attempt {:firm (:firm taken) :principal (:principal taken)}
                :session {:firm (:firm cfg) :principal (:principal cfg)}}

               (not= (:client-id taken) (:client-id cfg))
               {:error :client-mismatch :attempt (:client-id taken) :config (:client-id cfg)}

               (not= (:redirect taken) (:redirect cfg))
               {:error :redirect-mismatch :attempt (:redirect taken) :config (:redirect cfg)}

               (some? (get params "error"))
               {:error (if (= "access_denied" (get params "error")) :declined :provider-error)
                :reason (get params "error")
                :description (get params "error_description")}

               (nil? (get params "code"))
               {:error :missing-code}

               :else
               (exchange-code (:client-id cfg) (:client-secret cfg)
                              (get params "code") (:verifier taken)
                              (:redirect taken) post!)))))))))
