; Opt-in versioned grant coordination. Existing connector/Google callers retain
; their API; new strategies keep provider renewal policy out of credential core.
(ns credential.session (:require [credential.store :as store] [connector.clock :as clock]))
(defn open [opts] opts)
(defn- locked [session f]
  (global/trans (tuple [(store/-where (:store session)) (:service session) (:account-id session)] (erlang/self)) f))
(defn read [session] (store/-get (:store session) (:service session) (:account-id session)))
(defn version [session] (get (read session) :credential/version 0))
(defn replace! [session expected grant]
  (locked session (fn []
    (let [current (read session) v (get current :credential/version 0)]
      (if (not= expected v) {:error :stale-grant :version v}
        (let [next (assoc grant :credential/version (inc v))]
          (store/-put (:store session) (:service session) (:account-id session) next)
          {:ok next :version (inc v)}))))))
(defn access! [session]
  (locked session (fn []
    (let [grant (read session) expires (:expires-at-ms grant)
          now (clock/now (get session :clock (clock/system))) strategy (:strategy session)]
      (cond
        (nil? grant) {:error :not-connected}
        (= :revoked (:state grant)) {:error :reconnect-required}
        (or (nil? expires) (< now (- expires (get session :expiry-margin-ms 30000)))) {:ok grant}
        (nil? (:renew! strategy)) {:error :reconnect-required}
        :else (let [r ((:renew! strategy) grant)]
                (if-let [g (:ok r)]
                  (let [next (assoc g :credential/version (inc (get grant :credential/version 0)))]
                    (store/-put (:store session) (:service session) (:account-id session) next) {:ok next}) r)))))))
