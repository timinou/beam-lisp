; credential/oauth2.bl — the protocol, as values.
;
; ── Why this file is pure ────────────────────────────────────────────
;
; Everything here is a FUNCTION FROM DATA TO DATA: nothing sends, nothing
; stores, nothing sleeps. That is not tidiness — it is what makes the
; protocol testable without a network and provable against the spec.
; RFC 7636 Appendix B publishes a verifier and its S256 challenge; if
; `challenge` reproduces that pair, the derivation is CORRECT, and no
; amount of integration testing would tell you more.
;
; The I/O lives in the flow, one layer out. So the risky part (crypto,
; encoding, URL assembly, the error taxonomy) is asserted offline, and
; the part that can only fail on a network is small enough to read.
;
; ── The two directions ───────────────────────────────────────────────
;
; OUT  : a client, a redirect, some scopes        → an authorization URL
; BACK : a code, a verifier                       → a token request
; OUT  : a refresh token                          → another token request
; IN   : a token response, or an error            → a value, or a disposition
;
; The IN direction is where integrations rot, so the taxonomy is explicit
; and every entry names what the CALLER should DO — because "invalid_grant"
; and "429" must not be handled by the same code path (see `classify`).

(ns credential.oauth2)

;; `URI` and `Base` are Elixir modules reached through the same interop the
;; rest of the tree uses. `Base` is compiler-known; `URI` is bound here the
;; way tooling/catalog.bl binds it, because an interop alias is a GRANT and
;; the grant has to be written down.
(def ^:private URI (erlang/binary_to_atom "Elixir.URI"))

;; OTP's own JSON codec, not `bl.json` — deliberately. `bl.json` is a
;; workspace library and is NOT in a released drop; `:json` is in every BEAM
;; this runs on. It is the same choice gen/llm.bl makes and for the same
;; reason: the protocol layer must not depend on the toolchain it is
;; developed in. (Binary keys are the default, which is what the wire wants.)
(defn- snip
  "A body reduced to something safe to carry: whitespace collapsed, truncated.

   A token endpoint that answers with an HTML error page should not put a
   stylesheet in a log line, and the first 200 bytes name the problem
   (usually the status line and the title) as reliably as the whole thing."
  [body]
  (let [flat (String/trim (String/replace (str body) "\n" " "))
        flat (String/replace flat "\r" "")]
    (if (> (count flat) 200) (str (subs flat 0 200) "...") flat)))

(defn- json-decode
  "The body as a map, or nil when it is not JSON.

   A token endpoint does NOT always answer JSON. A misconfigured proxy, a
   captive portal, or a request the server refused to parse all produce an
   HTML page, and OTP's decoder RAISES on one — `{:invalid_byte, 60}`,
   measured against a real 400 from Google. Letting that raise would crash a
   sign-in at the exact moment the caller needed to branch on the status,
   and the status is the whole point of asking."
  [body]
  (try
    (let [m (erlang/apply :json :decode (list body))]
      (if (map? m) m nil))
    (catch _ nil)))

;; ── PKCE (RFC 7636) ──────────────────────────────────────────────────

(def VERIFIER-BYTES 32)

(defn- b64url
  "base64url with the padding removed.

   `Base.url_encode64` pads to a multiple of four; RFC 7636's challenge and
   verifier are defined WITHOUT `=`, and Google compares them literally. A
   32-byte digest is 32 mod 3 = 2, so the padding is always there to remove —
   which is exactly the kind of off-by-one-padding bug that presents as
   `invalid_grant` and sends you looking at the wrong thing entirely."
  [bytes]
  (String/replace (Base/url_encode64 bytes) "=" ""))

(defn verifier
  "A fresh PKCE code verifier: `strong_rand_bytes` rendered base64url.

   32 random bytes is 43 base64url characters — the RFC's floor is 43, so
   this is the shortest verifier that is also a full 256 bits of entropy.
   Deliberately not configurable: a knob here only ever gets turned down."
  []
  (b64url (erlang/apply :crypto :strong_rand_bytes (list VERIFIER-BYTES))))

(defn challenge
  "The S256 challenge for `v`: base64url(sha256(ASCII(v))), unpadded.

   The one line of crypto in the whole protocol, and the reason this file
   can be proved against a published vector rather than a live server."
  [v]
  (b64url (crypto/hash :sha256 v)))

;; ── out: the authorization URL ───────────────────────────────────────

(def AUTH-ENDPOINT "https://accounts.google.com/o/oauth2/v2/auth")

(defn- enc
  "Percent-encode one query value.

   `URI.encode_www_form` rather than a hand-rolled set: it is the encoding
   every OAuth client uses for form bodies, it is already the idiom in this
   tree (tooling/catalog.bl), and a hand-rolled encoder is the kind of code
   that passes every test until a scope URI contains a character nobody
   thought of."
  [s]
  (erlang/apply URI :encode_www_form (list (str s))))

(defn- query
  [pairs]
  (join "&" (map (fn [p] (str (enc (first p)) "=" (enc (second p)))) pairs)))

(defn auth-url
  "The URL to send a browser to.

   `opts`:
     :client-id     required
     :redirect-uri  required, and must be registered EXACTLY
     :scopes        required, a vector of scope URIs
     :challenge     required, from `challenge`
     :state         required — the caller's session binding, never a random
                    nonce invented here (see docs/connectors/accounts-and-credentials.md §5)
     :login-hint    optional
     :prompt        optional `:consent` forces the screen again; `:none`
                    answers without interaction (the probe that proves a
                    client+redirect pair is valid)

   `access_type=offline` and `prompt=consent` are what make Google return a
   REFRESH token at all: without offline the grant is an hour long, and
   without an explicit consent Google omits the refresh token on a repeat
   authorization. Both are load-bearing, not tuning."
  [opts]
  (let [base [(tuple "client_id" (:client-id opts))
              (tuple "redirect_uri" (:redirect-uri opts))
              (tuple "response_type" "code")
              (tuple "scope" (join " " (to-list (:scopes opts))))
              (tuple "code_challenge" (:challenge opts))
              (tuple "code_challenge_method" "S256")
              (tuple "state" (:state opts))
              (tuple "access_type" "offline")
              (tuple "prompt" (name (get opts :prompt :consent)))]
        extra (if-let [h (get opts :login-hint)]
                (conj base (tuple "login_hint" h))
                base)]
    (str AUTH-ENDPOINT "?" (query (to-list extra)))))

;; ── back: the token requests ─────────────────────────────────────────

(def TOKEN-ENDPOINT "https://oauth2.googleapis.com/token")

(defn exchange-body
  "The form body that trades an authorization code for tokens."
  [opts]
  [(tuple "client_id" (:client-id opts))
          (tuple "client_secret" (:client-secret opts))
          (tuple "code" (:code opts))
          (tuple "code_verifier" (:verifier opts))
          (tuple "grant_type" "authorization_code")
          (tuple "redirect_uri" (:redirect-uri opts))])

(defn refresh-body
  "The form body that trades a refresh token for a new access token.

   A refresh token is BOUND to the client that minted it, which is why the
   client id and secret travel here too — and why the credential carries
   `:client-id` rather than assuming the current one."
  [opts]
  [(tuple "client_id" (:client-id opts))
          (tuple "client_secret" (:client-secret opts))
          (tuple "refresh_token" (:refresh-token opts))
          (tuple "grant_type" "refresh_token")])

(defn form-encode
  "Render pairs as an application/x-www-form-urlencoded body."
  [pairs]
  (join "&" (map (fn [p] (str (enc (first p)) "=" (enc (second p)))) (to-list pairs))))

;; ── in: what came back ───────────────────────────────────────────────

(defn decode-token
  "A token response as a credential-shaped map, in epoch MILLISECONDS.

   `expires_at` is the interesting one: Google reports a RELATIVE
   `expires_in` (seconds), so a clock that is wrong at the moment of
   minting poisons every later comparison. Converting once, here, keeps
   the skew in one place instead of at every call site."
  ([body] (decode-token body (erlang/system_time :millisecond)))
  ([body now-ms]
   (let [m (json-decode body)
         ttl (if (nil? m) nil (get m "expires_in"))]
     (if (nil? m)
       {:error :unparseable :body (snip body)}
     (if (nil? (get m "access_token"))
       {:error :malformed :body m}
       {:ok {:access (get m "access_token")
             :refresh (get m "refresh_token")      ; absent on a refresh
             :token-type (get m "token_type" "Bearer")
             :scopes (if-let [s (get m "scope")] (into #{} (to-list (String/split s " "))) nil)
             :expires-at (if (some? ttl) (+ now-ms (* 1000 ttl)) nil)
             :id-token (get m "id_token")          ; carries `sub` — the account id
             :raw m}})))))

(defn id-claims
  "The claims of an `id_token`'s payload, or nil when they cannot be read.

   NOT VERIFIED, and that is a bounded, deliberate choice. This token came
   straight from the token endpoint over TLS, in the same exchange that minted
   it — the one channel OIDC §3.1.3.7 treats as the case where a signature
   adds nothing an attacker who could forge it could not already do. A token
   arriving ANY OTHER WAY (a front channel, a query parameter, a cookie) must
   be verified, and this function is the wrong tool for it.

   The payload is the SECOND of three dot-separated segments, base64url
   WITHOUT padding — which is why it is padded back before decoding."
  [jwt]
  (if (nil? jwt)
    nil
    (let [segs (to-list (String/split jwt "."))]
      (if (< (count segs) 2)
        nil
        (let [p (second segs)
              pad (rem (- 4 (rem (count p) 4)) 4)
              padded (str p (join "" (repeat pad "=")))
              r (Base/url_decode64 padded)]
          (if (= :ok (elem r 0))
            (json-decode (elem r 1))
            nil))))))

(def DISPOSITION
  "Every OAuth error Google documents, and what the caller must DO.

   This table is the design. The distinction that matters is between
   :reauth and :retry — an integration that retries `invalid_grant` burns
   quota FOREVER while looking busy, and one that re-prompts on a
   transient 5xx trains its user to click through consent dialogs."
  {"invalid_grant"        :reauth        ; revoked, expired, wrong password, evicted
  "invalid_client"        :config-error  ; the secret or the client id is wrong
  "redirect_uri_mismatch" :config-error  ; not registered, character for character
  "invalid_request"       :config-error
  "unauthorized_client"   :config-error
  "access_denied"         :declined      ; the human said no — do not re-prompt
  "interaction_required"  :interactive   ; a session is needed; send them to the URL
  "invalid_scope"         :config-error
  "admin_policy_enforced" :policy
  "invalid_rapt"          :reauth})      ; a session-control policy expired

(defn classify
  "What to DO about an error response. `:retry` is reserved for responses
   that could plausibly succeed later (5xx, a network failure); everything
   the protocol itself reports is terminal for this attempt."
  [{:keys [error status] :as r}]
  (cond
    (contains? DISPOSITION error) (get DISPOSITION error)
    (and (some? status) (>= status 500)) :retry
    (and (some? status) (= status 429)) :retry
    (some? error) :unknown
    :else :retry))

(defn decode-error
  "The error shape of a failed token request.

   Google answers OAuth failures with a flat `{error, error_description}`
   — NOT the nested `{error: {code, status, errors: […]}}` envelope the
   resource APIs use. Two shapes, one endpoint family; assuming either
   gets the other wrong, so the difference is named here."
  [body]
  (let [m (json-decode body)]
    (if (nil? m)
      ;; Not an OAuth error at all — so there is no `error` code to classify,
      ;; and inventing one would report a protocol verdict no protocol gave.
      ;; A request the server would not parse is a CONFIG error: the same
      ;; bytes will not parse next time either.
      {:error :unparseable
       :description (snip body)
       :disposition :config-error}
      {:error (get m "error")
       :description (get m "error_description")
       :uri (get m "error_uri")
       :disposition (classify {:error (get m "error")})})))

;; ── secrecy ──────────────────────────────────────────────────────────

(def SECRET-KEYS #{"client_secret" "access_token" "refresh_token" "id_token" "code" "code_verifier"})

(defn- redact-one
  "`<key>=<value>` with the value replaced by its length when the key is secret."
  [k v]
  (str k "="
       (if (contains? SECRET-KEYS k)
         (str "<" (erlang/byte_size (str v)) " bytes>")
         (str v))))

(defn redact
  "A request or response body with every secret replaced by its LENGTH —
   accepting the ENCODED STRING, a map, or a sequence of pairs.

   Length, not a fixed marker: enough to tell `present but wrong` from `absent`
   while leaking nothing, and that is the difference that actually comes up when
   a flow fails at 2am.

   The encoded string is accepted because that is what a request log HAS. This
   was documented as taking `a form body` from the first version and only ever
   handled a sequence of pairs — so handing it the string a caller actually holds
   put a CHARLIST through `second` and raised `nth/2`, from a function whose
   entire job is to make a failure legible. A docstring that promises a shape the
   code cannot take is worse than no docstring: it is why the caller passed a
   string in the first place."
  [m]
  (cond
    ;; the encoded body, returned in the SAME encoding: every non-secret piece
    ;; is passed through untouched, so what is logged is what was sent
    (string? m)
    (join "&"
      (map (fn [piece]
             (let [kv (String/split piece "=")
                   k (first kv)]
               (if (contains? SECRET-KEYS k)
                 (redact-one k (join "=" (drop 1 kv)))
                 piece)))
           (to-list (String/split m "&"))))

    ;; a map, or a sequence of [k v] pairs
    :else
    (let [pairs (if (map? m) (to-list m) (to-list m))]
      (into {}
        (map (fn [p]
               (let [k (str (first p))
                     v (if (> (count (to-list p)) 1) (second p) nil)]
                 (tuple k (if (contains? SECRET-KEYS k)
                            (str "<" (erlang/byte_size (str v)) " bytes>")
                            v))))
             pairs)))))