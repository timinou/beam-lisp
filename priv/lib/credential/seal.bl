; Storage-independent authenticated bytes. Keys and context belong to the caller.
(ns credential.seal)

(defn- refuse []
  (throw (ex-info "credential.seal: authenticated bytes unavailable"
                  {:error :credential.seal/authentication-failed})))

(defn- check-key [key]
  (when-not (and (erlang/is_binary key) (= 32 (erlang/byte_size key)))
    (throw (ex-info "credential.seal: a 32-byte key is required"
                    {:error :credential.seal/invalid-key}))))

(defn seal-bytes
  "AES-256-GCM bytes with explicit associated-data bytes; no storage or encoding.
   A fresh 96-bit nonce and full 128-bit tag on every write."
  [key aad plain]
  (check-key key)
  (when-not (and (erlang/is_binary aad) (erlang/is_binary plain)) (refuse))
  (let [iv (crypto/strong_rand_bytes 12)
        enc (crypto/crypto_one_time_aead :aes_256_gcm key iv plain aad true)]
    {:iv iv :ct (erlang/element 1 enc) :tag (erlang/element 2 enc)}))

(defn open-bytes
  "Authenticate before returning bytes. Context must come from trusted caller data.
   Failures never contain key, ciphertext, associated data or plaintext."
  [key aad envelope]
  (check-key key)
  (when-not (and (erlang/is_binary aad)
                 (erlang/is_binary (:iv envelope)) (= 12 (erlang/byte_size (:iv envelope)))
                 (erlang/is_binary (:tag envelope)) (= 16 (erlang/byte_size (:tag envelope)))
                 (erlang/is_binary (:ct envelope))) (refuse))
  (let [plain (try (crypto/crypto_one_time_aead :aes_256_gcm key (:iv envelope)
                           (:ct envelope) aad (:tag envelope) false)
                  (catch _e :error))]
    (if (= plain :error) (refuse) plain)))

(def FORMAT :credential.seal/v1)
(defn seal
  "Versioned envelope bound to a caller-owned key ID and context."
  [key key-id context plain]
  (assoc (seal-bytes key (erlang/term_to_binary [FORMAT key-id context]) plain)
         :format FORMAT :key-id key-id))

(defn open
  "The expected version, key ID and context are supplied independently of storage."
  [key key-id context envelope]
  (when-not (and (= FORMAT (:format envelope)) (= key-id (:key-id envelope))) (refuse))
  (open-bytes key (erlang/term_to_binary [FORMAT key-id context]) envelope))
