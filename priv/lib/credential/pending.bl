; credential/pending.bl — where an authorization attempt waits for the browser.
;
; ── Why the loopback flow needs none of this, and the web flow needs it ──
;
; The loopback flow splits at the click and rejoins in ONE process: `begin!`
; returns the socket, `finish!` blocks on it, and the verifier and the state
; travel from one to the other as fields of a local map. Nothing has to
; survive between the two calls because the process does.
;
; A web redirect has no such process. `begin-web` runs in the request that
; renders the consent URL; the callback arrives in a DIFFERENT request,
; possibly on a different scheduler, minutes later. The only thing joining
; the halves is the `state` parameter, so the attempt — verifier, firm,
; principal, client, redirect, and the moment it stops being valid — has to
; live somewhere between them. That somewhere is this port.
;
; It is a port for the same reason `credential.store` is: a store for which
; plaintext-at-rest (or a VM-local map) would be wrong must REFUSE BY NAME
; rather than quietly keep a PKCE verifier where the deployment did not mean
; it to be. The connector does not choose; the deployment builds the store it
; can defend.
;
; ── The one property the implementations must hold ───────────────────
;
; `-take` is a GET-AND-REMOVE, and it must be atomic: a state is a one-time
; bearer handle, and two callbacks presenting it concurrently must not both
; receive the attempt. Read-then-delete is NOT that property — the gap
; between the two is exactly where a replayed callback lands — and neither
; is a read-modify-write over a shared value under contention.
;
; The reference store below is single-VM and holds the property exactly,
; not approximately: it is an ETS table, and `:ets.take/2` is one atomic
; get-and-remove, so concurrent `-take`s of one state yield the record to
; exactly one caller. A multi-node deployment still needs a store whose
; `-take` the substrate makes atomic ACROSS nodes; that requirement is
; stated here so it is a decision, not an oversight.
;
; ── What is kept ─────────────────────────────────────────────────────
;
; The record is small and deliberately holds NO secret that outlives the
; exchange: the PKCE verifier for this attempt, the identity the attempt is
; bound to (firm, principal), the client and exact redirect it was minted
; for, and its mint/expiry instants in epoch milliseconds. The CLIENT SECRET
; is not here — it belongs to the deployment's config and is supplied again
; at `finish-web!`. A store that never holds it cannot leak it.

(ns credential.pending
  ;; The reference tier keeps its table in ETS, and an ETS table is owned by
  ;; the process that creates it. The process that BEGINS a web attempt is not
  ;; the process that receives its callback, so the table cannot be created by
  ;; whichever request happens to ask first — it must be HELD by a process that
  ;; outlives every request, with an heir that catches it if that process dies.
  ;; `proc.table` is exactly that owner, and it is the only dependency here.
  (:require [proc.table :as table]))

(defprotocol Pending
  "Where an in-flight web authorization attempt lives.

   Implementations must make `-take` atomic (see the header); an attempt
   that is read twice is an attempt that is spent twice."

  (-put [p state record]
    "Keep `record` under `state`. Idempotent — a second put for the same
     state REPLACES, because the same state is never minted twice.")

  (-take [p state]
    "Remove and return the attempt kept under `state`, or nil when there is
     none. One call, not a read plus a delete: the gap between the two is
     where a replayed callback lands.")

  (-sweep! [p]
    "Drop every attempt whose expiry has passed, and return how many. The
     maintenance verb the reference store runs opportunistically on `-put`;
     a store with no local storage may answer 0. An attempt swept before its
     callback arrives is answered `:unknown-state` — the same answer a replay
     gets, which is the safe side of the distinction.")

  (-where [p]
    "A human-readable description of where this store keeps attempts — for a
     log line or a status read, NEVER for reading a verifier out."))

;; ── the reference tier: one VM, an ETS table with an owner ───────────

(def ^:private DEFAULT :credential.pending/default)

;; An expiry is an epoch-ms from the record. A record with NO `:expires-at`
;; is one that never expires, and `:never` says so in a way the sweep's
;; matchspec can order: Erlang term order puts atoms AFTER numbers, so
;; `:never =< <now>` is false and such a row is never swept.
(def ^:private NEVER :never)

(defrecord PendingMem [name])

(defn mem-pending
  "An attempt store in this VM's ETS, under `name`.

   ETS and not `persistent_term`: `-take` must be a single atomic
   get-and-remove, and `persistent_term` offers only get and put — a take
   written as `get` then `put` leaves exactly the window a replayed callback
   lands in. `:ets.take/2` has no window.

   ETS and not a plain table: a table dies with the process that creates it,
   and the process that BEGINS a web attempt is not the process that receives
   its callback. So the table is HELD by `proc.table`, whose keeper process
   outlives the request and whose heir catches the table if the keeper dies;
   the lifetime that a single node wants, and the one the callback needs.

   `name` defaults to one well-known key, so two callers that both mean 'this
   VM's web flows' agree without threading a handle."
  ([] (mem-pending DEFAULT))
  ([name] (->PendingMem name)))

;; One row is `{state, expiry, record}` — a 3-tuple, and NOT `{state, record}`
;; with the expiry buried in the record map. The shape is the sweep: a
;; matchspec can name the second element directly, so expiry is a field the
;; substrate can compare without a map lookup it cannot express.
(defn- row [state record]
  (tuple state (or (:expires-at record) NEVER) record))

(defn- now-ms [] (erlang/system_time :millisecond))

(defn- held
  "The ETS table for this store, created under an owner that outlives the
   request. `proc.table/hold` is idempotent and cheap after the first call."
  [p]
  (table/hold (:name p)))

(defn- sweep-expired!
  "Delete every row whose expiry is at or before `now`. Returns the count.

   A matchspec and not a `tab2list` + filter: the guard is a value the
   substrate evaluates over the table, so the cost is the expired rows, not
   the whole table, and nothing crosses the interop boundary but a count."
  [t now]
  (erlang/apply :ets :select_delete
    (list t
          (list (tuple (tuple :_ :"$1" :_)
                       (list (tuple :"=<" :"$1" now))
                       (list :true))))))

(extend-type PendingMem
  Pending

  (-put [p state record]
    (let [t (held p)]
      ;; BOUND THE STORE: an attempt that was never taken is still an attempt
      ;; that has expired, and leaving it in the table forever is how a
      ;; one-time handle store becomes an unbounded one. The sweep runs
      ;; BEFORE the insert, so the attempt just put is never the one dropped.
      (sweep-expired! t (now-ms))
      (erlang/apply :ets :insert (list t (row state record)))
      p))

  (-take [p state]
    ;; ONE call. `:ets.take/2` removes and returns atomically, so of N
    ;; concurrent takes of one state exactly one gets the row and the rest
    ;; get nothing — which is the one-time property the whole flow rests on.
    (let [t (held p)
          hit (erlang/apply :ets :take (list t state))]
      (if (= 0 (count hit))
        nil
        (erlang/element 3 (first hit)))))

  (-sweep! [p]
    (sweep-expired! (held p) (now-ms)))

  (-where [p]
    (let [t (held p)]
      (str "in-VM attempt store " (:name p) " (this VM only — "
           (erlang/apply :ets :info (list t :size)) " attempt(s) waiting)"))))
