(ns files
  (:require [datom.query.relation]
            [connector :as conn]
            [connector.google.gdrive]))

;; ── the domain, beside the service ───────────────────────────────────
;
; `:file/*` is already owned by `datom.file` (the DFile half). This module adds
; the RELATION over it, so a query can reach a synced file the same way it
; reaches a local one. The attributes live there and not here on purpose: a
; file that arrived over HTTP and one that arrived on disk must be THE SAME
; ENTITIES, and they cannot be if their schemas are two.
;
; The projection each provider promises is `[entity name when]` — the minimum
; that makes a file findable. Content, size and checksum are what a mirror adds
; when it has the bytes; a listing does not.

(def providers [connector.google.gdrive/spec])

(def DEFAULT-LIMIT
  "How many files a bare query may pull — the same ceiling as `msg`, for the
   same reason: an unbound relation that fetches everything looks identical to
   one that fetches nothing, and only one of them costs a quota."
  20)

(defn- fetch-all [aspect opts]
  (let [cs (conn/connections-for aspect)
        opts (if (nil? (get opts :limit)) (assoc opts :limit DEFAULT-LIMIT) opts)]
    (if (empty? cs)
      []
      (vec (mapcat
             (fn [c]
               (if (= :gdrive (:id (:spec c)))
                 (let [r (connector.google.gdrive/fetch c opts)]
                   (if (= :error (first (keys r))) [] (get r :ok)))
                 []))
             (to-list cs))))))

(datom.query.relation/register-relation!
  :~file/files
  {:arity 3
   :modes #{:bf}
   :maintenance :recompute
   :doc "files from every provisioned drive connection, as [entity name when]"
   :provider (fn [db mode bounds args]
               (fetch-all :~file/files {}))})
