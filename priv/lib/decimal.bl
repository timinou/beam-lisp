; decimal.bl — exact decimals: the number an accountant writes.
;
; `123.45M` reads as a decimal; `(decimal/of "123.45")` makes one from a string
; or an integer. A decimal is an unbounded integer of digits and a scale
; (`123.45M` is 12345 at scale 2) — the model java.math.BigDecimal uses, chosen
; here because the SCALE IS INFORMATION: `1.50M` says cents, `1.5M` does not,
; and an arithmetic that dropped the difference would round money silently.
;
; Two equalities, on purpose. `=` is structural: `1.5M` and `1.50M` are
; different values (as in Java `equals`). `==`, `compare`, `<` and friends are
; numeric: `(== 1.5M 1.50M)` is true. Every core operator sees a decimal —
; `(+ 1.10M 2.20M)` is `3.30M`, exact, and an integer beside a decimal promotes.
; A FLOAT beside a decimal is refused: `0.1` is not one tenth, and laundering
; it into exact arithmetic is the bug this type exists to prevent.
;
; Everything that can round says so in its arguments. `div` and `rescale` take
; a scale and a rounding mode — `:half-even` (banker's, the accounting default),
; `:half-up`, `:half-down`, `:ceiling`, `:floor`, `:down`, `:up`, and
; `:unnecessary` which raises rather than lose a digit. `/` on two decimals is
; EXACT division and refuses a non-terminating quotient (`(/ 1M 3M)` raises
; `:decimal/non-terminating`); a rounded quotient is spelled `(div a b 2 :half-even)`.
; There is no ambient precision or rounding context anywhere: the result of an
; operation is a function of its arguments and nothing else.

(ns decimal)

;; ── construction ──────────────────────────────────────────────────────

(defn of
  "A decimal from an integer, a string (\"123.45\", \"-1e3\"), or a decimal.
   A float is refused (see `from-float`)."
  [x]
  (BeamLisp.Decimal/new x))

(defn of-scaled
  "A decimal from its digits and scale: `(of-scaled 12345 2)` is `123.45M`."
  [unscaled scale]
  (BeamLisp.Decimal/of unscaled scale))

(defn parse
  "Parse a decimal string; raises `:decimal/parse` when it is not one."
  [s]
  (BeamLisp.Decimal/parse! s))

(defn from-float
  "A decimal from a float's shortest round-tripping decimal expansion — an
   approximation, asked for by name."
  [f]
  (BeamLisp.Decimal/from_float f))

(def ZERO (BeamLisp.Decimal/zero))
(def ONE (BeamLisp.Decimal/one))
(def TEN (BeamLisp.Decimal/ten))

(defn decimal?
  "True for a decimal value."
  [x]
  (BeamLisp.RT/decimal? x))

;; ── exact arithmetic ──────────────────────────────────────────────────

(defn add "Exact sum; the scale is the larger of the two." [a b] (BeamLisp.Decimal/add (of a) (of b)))
(defn sub "Exact difference." [a b] (BeamLisp.Decimal/sub (of a) (of b)))
(defn mul "Exact product; the scales add." [a b] (BeamLisp.Decimal/mul (of a) (of b)))
(defn neg "Negation." [d] (BeamLisp.Decimal/neg (of d)))
(defn abs "Absolute value." [d] (BeamLisp.Decimal/abs (of d)))
(defn signum "-1, 0 or 1." [d] (BeamLisp.Decimal/signum (of d)))

;; ── rounding ──────────────────────────────────────────────────────────

(def rounding-modes
  "The rounding modes, as keywords."
  #{:half-even :half-up :half-down :ceiling :floor :down :up :unnecessary})

(defn div
  "`(div a b scale mode)`: a ÷ b to exactly `scale` fractional digits under
   `mode`. `(div a b)` is exact division and refuses a non-terminating result.
   Division by zero raises `:decimal/divide-by-zero`."
  ([a b] (BeamLisp.Decimal/div (of a) (of b)))
  ([a b scale] (BeamLisp.Decimal/div (of a) (of b) scale :half-even))
  ([a b scale mode] (BeamLisp.Decimal/div (of a) (of b) scale mode)))

(defn rescale
  "The same number at `scale` fractional digits. Growing the scale is exact;
   shrinking it rounds under `mode` (default `:unnecessary`, which raises if a
   digit would be lost)."
  ([d scale] (BeamLisp.Decimal/rescale (of d) scale))
  ([d scale mode] (BeamLisp.Decimal/rescale (of d) scale mode)))

(defn round
  "`(round d)` to 2 places, `(round d n)` to n, `(round d n mode)` — always a
   rounding, never a refusal (default mode `:half-even`)."
  ([d] (rescale d 2 :half-even))
  ([d scale] (rescale d scale :half-even))
  ([d scale mode] (rescale d scale mode)))

(defn strip-zeros
  "The smallest scale that represents the same number: `1.500M` → `1.5M`."
  [d]
  (BeamLisp.Decimal/strip_zeros (of d)))

(defn move-point-left
  "Divide by 10ⁿ exactly: `(move-point-left 1M 2)` is `0.01M`."
  [d n]
  (BeamLisp.Decimal/move_point_left (of d) n))

(defn move-point-right
  "Multiply by 10ⁿ exactly."
  [d n]
  (BeamLisp.Decimal/move_point_right (of d) n))

;; ── conversion ────────────────────────────────────────────────────────

(defn scale "The number of fractional digits." [d] (BeamLisp.Decimal/scale (of d)))
(defn unscaled "The digits as an integer." [d] (BeamLisp.Decimal/unscaled (of d)))
(defn precision "The number of significant digits." [d] (BeamLisp.Decimal/precision (of d)))

(defn ->long
  "The integer part, truncated toward zero."
  [d]
  (BeamLisp.Decimal/to_integer (of d)))

(defn ->double
  "The nearest float — lossy by definition; for display and sort keys, not arithmetic."
  [d]
  (BeamLisp.Decimal/to_float (of d)))

(defn plain-str
  "The number without exponent and with exactly `scale` fractional digits: `\"123.45\"`."
  [d]
  (BeamLisp.Decimal/to_plain_string (of d)))
