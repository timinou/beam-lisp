; harness/doc.bl — the session document: what comes in, what gets appended.
;
; A harness session IS a `.bl.md` livebook. Everything that happens in it — a
; task, a steer, an evaluation, a model's reply — arrives as blocks and is
; APPENDED, never rewritten: prose stays prose, code becomes a ```beam-lisp
; cell, and every cell is followed by the ```bl-result block its evaluation
; produced. So one file is the transcript a person reads, the context a model
; reads, and a document `bl.doc` can slice.
;
; Input is `.bl` (code: one cell) or `.bl.md` (prose + ```beam-lisp cells).
; Reading a `.bl.md` is `bl.doc`'s job — the SAME slicer the loader and the
; livebook runner use, so the harness and the language cannot disagree about
; where a cell begins.

(ns harness.doc
  (:require [bl.doc :as doc]))

(def RESULT-CHARS
  "The most of one result a document keeps. A model reads the whole document on
   every step, so one runaway print would otherwise be paid for forever."
  16000)

(defn format-of
  "The format of an input: `:bl` or `:md`.

   An explicit `fmt` (\"bl\" / \"bl.md\") wins, then the path's extension, then
   the text itself — a ```beam-lisp fence means a document. With none of those,
   `default` decides: code for `eval`, a document for a task (plain prose IS a
   valid `.bl.md`, and a task is usually prose)."
  [text path fmt default]
  (cond
    (= fmt "bl") :bl
    (or (= fmt "bl.md") (= fmt "md")) :md
    (and (string? path) (ends-with? path ".bl.md")) :md
    (and (string? path) (ends-with? path ".md")) :md
    (and (string? path) (ends-with? path ".bl")) :bl
    (includes? text "```beam-lisp") :md
    :else default))

(defn parts
  "Input text → its blocks, in order: `{:kind :cell :src s}` and
   `{:kind :prose :text s}`.

   A `.bl` input is one cell. A `.bl.md` is sliced by `bl.doc`: cells become
   cells, prose and other fenced code stay prose, and a `bl-result` block is
   DROPPED — a result is something evaluation produces, never something an
   author (or a model) gets to assert.

   A document that ends inside a fence (a model cut off mid-cell) is closed and
   sliced again, so its cells still run. One the slicer still refuses is kept
   whole as prose rather than lost."
  [text fmt]
  (let [text (or text "")]
    (if (= fmt :bl)
      (if (blank? text) [] [{:kind :cell :src (trim text)}])
      (let [r (doc/slice-text text :md)
            r (if (contains? r :error) (doc/slice-text (str text "\n```") :md) r)]
        (if (contains? r :error)
          [{:kind :prose :text (trim text)}]
          (vec
           (keep (fn [sp]
                   (cond
                     (= :cell (:kind sp))
                     (let [src (doc/cell-source sp)]
                       (if (blank? src) nil {:kind :cell :src src}))

                     (= :result (:kind sp)) nil

                     :else
                     (let [t (trim (join "\n" (:lines sp)))]
                       (if (blank? t) nil {:kind :prose :text t}))))
                 (get-in r [:ok :spans]))))))))

(defn cells?
  "Does a parts list hold any code?"
  [ps]
  (some? (some (fn [p] (= :cell (:kind p))) ps)))

(defn clip
  "At most RESULT-CHARS of `s`, saying how much was dropped."
  [s]
  (if (> (count s) RESULT-CHARS)
    (str (subs s 0 RESULT-CHARS) "\n;; … clipped, " (count s) " chars in all")
    s))

(defn result-text
  "What a cell's evaluation shows: its stdout, then its printed value — or,
   when it failed, its stdout then `;; error: …`. The same shape `bl.doc`
   writes, so a harness document reads like any other livebook."
  [r]
  (let [out (or (:stdout r) "")]
    (clip
     (cond
       (some? (:error r)) (str out ";; error: " (:error r))
       (blank? out) (str (:value r))
       :else (str out (:value r))))))

(defn cell-block [id src]
  (str "```beam-lisp id=" id "\n" src "\n```\n"))

(defn result-block [id text]
  (str "```bl-result " id "\n" text "\n```\n"))

(defn section-heading?
  "Headings generated by the harness, not headings inside operator/model prose."
  [line]
  (or (= line "## task") (= line "## steer") (= line "## eval")
      (starts-with? line "## model · t")
      (starts-with? line "## turn ")))

(defn safe-prose
  "Keep user/model prose from forging a generated section heading. Escaped
   Markdown renders the same text, but history reconstruction keeps its role."
  [text]
  (join "\n" (map (fn [line]
                     (if (section-heading? line) (str "\\" line) line))
                   (split text "\n"))))

(defn heading [title]
  (str "\n## " title "\n"))

(defn preamble
  "The first lines of a new session document."
  [sid ns]
  (str "# harness · " sid "\n\n"
       "A beam-lisp session. Every block is appended: `## task`/`## steer` come "
       "from the operator, `## eval` is code the operator ran, `## model` is the "
       "model. Cells evaluate in `" ns "`, in the project's warm VM.\n"))
