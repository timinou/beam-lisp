; harness/model.bl — one model step: the session document in, a .bl.md reply out.
;
; The append-only session document is the source of truth. For each model
; request, its sections become assistant/user chat messages; evaluated results
; are separate user messages, never text attributed to the assistant. Cells
; remain inline with prose in the human-readable .bl.md document.
;
; The provider is DeepSeek V4.1 Flash over `gen.llm`, keyed from the project's
; `.env` (DEEPSEEK_API_KEY; DEEPSEEK_BASE_URL and HARNESS_MODEL override).

(ns harness.model
  (:require [gen.llm :as llm]
            [credential.env :as cenv]
            [bl.doc :as doc]
            [harness.doc :as hd]))

(def MODEL "deepseek-flash")

(defn provider
  "The provider for project `root`: gen.llm's DeepSeek, keyed from `root/.env`
   (or the process environment when the file lacks the key)."
  [root]
  (let [env (cenv/read-file (str root "/.env"))
        pick (fn [k] (or (cenv/lookup env k) (System/get_env k)))]
    (merge llm/deepseek
           {:model (or (pick "HARNESS_MODEL") MODEL)
            :key (pick "DEEPSEEK_API_KEY")
            :max-tokens 8000
            :timeout-ms 170000
            ;; A result is what evaluation says. The model stops where it would
            ;; start writing one, so it cannot invent an answer and then
            ;; reason about it — its next step reads the real one.
            :stop (list "```bl-result")}
           (if-let [u (pick "DEEPSEEK_BASE_URL")] {:base-url u} {}))))

(defn- section-role [line]
  (if (starts-with? line "## model · t") "assistant" "user"))

(defn- finish-section [state]
  (let [section (:section state)
        text (trim (:text section))
        messages (if (blank? text)
                   (:messages state)
                   (conj (:messages state) {:role (:role section) :content text}))]
    (assoc state :messages
           (reduce (fn [ms result] (conj ms {:role "user" :content result}))
                   messages (:results section)))))

(defn messages
  "Reconstruct chat history from the append-only .bl.md document. A section's
   author owns all its prose and cells, including prose written *after* a cell
   in the same reply. Each evaluated result then follows as its own user
   message, linked to its cell by id. Nothing in the document is rewritten."
  [document]
  (let [sliced (doc/slice-text document :md)]
    (if (contains? sliced :error)
      (list {:role "user" :content document})
      (let [state
            (reduce
             (fn [state span]
               (if (= :result (:kind span))
                 (let [result (join "\n" (:lines span))]
                   (update-in state [:section :results] conj result))
                 (if (= :prose (:kind span))
                   (reduce (fn [state line]
                             (if (hd/section-heading? line)
                               (assoc (finish-section state) :section
                                      {:role (section-role line) :text (str line "\n") :results []})
                               (update-in state [:section :text] str line "\n")))
                           state (:lines span))
                   (update-in state [:section :text] str (join "\n" (:lines span)) "\n"))))
             {:section {:role "user" :text "" :results []} :messages []}
             (get-in sliced [:ok :spans]))]
        (to-list (:messages (finish-section state)))))))

(defn system-prompt [ns]
  (str
   "You are working inside a live beam-lisp VM (a Clojure-like Lisp on the BEAM). "
   "Your conversation comes from the session document: operator sections (## task, ## steer, ## eval) are user messages, "
   "your ## model sections are assistant messages, and each evaluated ```bl-result is a separate user message identified by its cell id.\n\n"
   "Reply in .bl.md: short prose, plus ```beam-lisp fenced cells when you need to act. "
   "Every cell you write is evaluated, in order, in namespace `" ns "`, and its result is appended for your next step. "
   "Never write ```bl-result blocks yourself — results come only from evaluation. "
   "Prose after a cell in your reply was written before its result; wait for the next step to inspect it. "
   "Only the last top-level form's value is shown per cell; use println to show earlier values. "
   "Start every ``` fence on its own line; a fence inside a sentence is prose and does not run.\n\n"
   "Work in small steps: one or two cells, then read the results. "
   "To use another namespace, redeclare this one with its requires: (ns " ns " (:require [clojure.string :as s])) — "
   "the aliases then hold in every later cell. A fully qualified var works without that: (harness/tail \"main\"). "
   "Files: (File/read! \"path\"), (File/write! \"path\" text), (File/ls! \"dir\"); paths are relative to the project root. "
   "Elixir and Erlang modules are called directly: (String/split s \",\"), (erlang/self). "
   "There is no `require`, `slurp`, `resolve` or `doc` fn — use the forms above.\n\n"
   "When the task is done, reply with prose only (no cell): that ends the turn. "
   "Say what you found or changed, plainly."))

(defn reply
  "One model reply to `document`, for project `root`, whose cells will run in
   `ns`: {:ok text} | {:error …}. The harness keeper's default model."
  [root ns document]
  (let [p (provider root)]
    (if (nil? (:key p))
      {:error "DEEPSEEK_API_KEY is not set — put it in the project's .env"}
      (llm/chat p
                (cons {:role "system" :content (system-prompt ns)}
                      (messages document))))))
