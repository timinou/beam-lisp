; split/log.bl — a split app's durable history, as datom facts on fjall.
;
; An app that declares `:server {:history n}` keeps every commit. One commit is
; one entity:
;
;   :split.commit/app       the app's name
;   :split.commit/revision  the revision it produced (1, 2, 3, …)
;   :split.commit/actor     the signed-in person's id (absent: nobody)
;   :split.commit/op        the intent (a keyword)
;   :split.commit/args      its decoded arguments (BL data, stored as itself)
;   :split.commit/nonce     the proposal's nonce
;
; The log holds INTENTS, not states: the state is what replaying them through
; the same authority produces. So a restart decides every commit again — with
; the same rules, the same permissions — and a line the authority refuses
; stops the start (split.core/start), rather than serving a history nobody
; can explain.
;
; `append!` returns only once the transaction is on disk; the authority calls
; it BEFORE it acknowledges the commit, so an answer the browser sees is
; never ahead of the log.

(ns split.log
  (:require [datom] [datom.store-fjall]))

(def schema
  [{:db/ident :split.commit/app :db/valueType :db.type/string :db/index true}
   {:db/ident :split.commit/revision :db/valueType :db.type/long}
   {:db/ident :split.commit/actor :db/valueType :db.type/string}
   {:db/ident :split.commit/op :db/valueType :db.type/keyword}
   ; no value type: any BL term, stored as itself
   {:db/ident :split.commit/args}
   {:db/ident :split.commit/nonce :db/valueType :db.type/string}])

(defn open
  "Open (or create) the log for app `app-name` in the fjall keyspace `path`."
  [path app-name]
  {:conn (datom/connect-with (datom.store-fjall/open path) schema) :app app-name :path path})

(defn append!
  "Record one commit (split.core's commit record). Raises when the store
   refuses — which stops the authority before anything is acknowledged."
  [log commit]
  (let [e (:entry commit)]
    (datom/transact! (:conn log)
                     [(merge {:db/id -1 :split.commit/app (:app log)
                              :split.commit/revision (:revision e)
                              :split.commit/op (:op e)
                              :split.commit/args (:args commit)
                              :split.commit/nonce (:nonce commit)}
                             (if (nil? (:actor commit)) {} {:split.commit/actor (:actor commit)}))])
    :ok))

(defn commits
  "Every recorded commit of this app, in revision order:
   [{:revision :actor :op :args :nonce} …]."
  [log]
  (->> (datom/q '[:find ?e ?r ?op ?a ?n :in $ ?app
                  :where [?e :split.commit/app ?app] [?e :split.commit/revision ?r]
                         [?e :split.commit/op ?op] [?e :split.commit/args ?a] [?e :split.commit/nonce ?n]]
                (datom/db (:conn log)) (:app log))
       (map (fn [[e r op a n]]
              {:revision r :op op :args a :nonce n
               :actor (get (datom/entity (datom/db (:conn log)) e) :split.commit/actor)}))
       (sort-by :revision)
       vec))

(defn proposals
  "The log as proposals the authority decides again at boot (split.core/start
   `:replay`), each against the revision before it."
  [log digest]
  (vec (map-indexed (fn [i c]
                      {:request (inc i) :revision (dec (:revision c)) :digest digest
                       :nonce (:nonce c) :actor (:actor c) :op (:op c) :args (:args c)})
                    (commits log))))
