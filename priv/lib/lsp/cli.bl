; lsp/cli.bl — render the language server's analysis as a terminal report.
;
; The LSP module (lsp.bl) answers editor requests as data. `bl lsp check FILE`
; renders that same data for a terminal: the diagnostics an editor would show as
; squiggles, then the document-symbol outline — but with the PROOF badges the
; compiler already computed for each definition (return type, purity,
; termination, native-eligibility). It is the "compiler-as-IDE" view without an
; editor: point the drop at a file and read what the compiler PROVED about it.

(ns lsp.cli
  (:require [lsp]))

; ── badges ────────────────────────────────────────────────────────────────

(defn- purity-badge [s]
  (if (:pure s) "pure" (str "effects" (pr-str (into [] (:footprint s))))))

(defn- native-badge
  "◆ = native-eligible (pure ∧ terminating), · = not."
  [src name]
  (let [e (lsp/native-eligible src name)]
    (if (:eligible e) "◆ native" "·")))

(defn- returns-str [s]
  ; tags are keywords (:int) plus the literal nil; render each as a bare word.
  (let [rs (into [] (:returns s))
        tag-name (fn [t] (if (keyword? t) (name t) (pr-str t)))]
    (if (empty? rs) "?" (join "|" (map tag-name rs)))))

; ── the report ──────────────────────────────────────────────────────────────

(defn- render-diagnostics [diags]
  (if (empty? diags)
    (println "  diagnostics: none")
    (do
      (println (str "  diagnostics (" (count diags) "):"))
      (reduce (fn [_ d]
                (println (str "    " (get d :line "?") ":" (get d :col "?")
                              "  " (get d :msg (get d :message "?"))))
                nil)
              nil diags))))

(defn- render-symbol [src s]
  ; s = {:name :returns :terminates :pure :calls} from lsp/document-symbols
  (let [name (:name s)
        badges (join "  "
                     [(str "→ " (returns-str s))
                      (if (:pure s) "pure" "effects")
                      (if (:terminates s) "terminates" "may-diverge")
                      (native-badge src name)])]
    (println (str "    " name))
    (println (str "        " badges))
    (when (seq (:calls s))
      (println (str "        calls: " (join ", " (into [] (:calls s))))))))

(defn report
  "Render the full LSP analysis of `src` (namespace `ns`) as a terminal report:
   diagnostics, then each definition with its proven summary. Returns the number
   of diagnostics (0 ⇒ clean)."
  [src ns]
  (let [diags (lsp/diagnostics src ns)
        syms (lsp/document-symbols src)]
    (println (str "── " ns " ──"))
    (render-diagnostics diags)
    (println (str "  symbols (" (count syms) "):"))
    (reduce (fn [_ s] (render-symbol src s) nil) nil (into [] syms))
    (count diags)))
