; lsp/cli.bl — render the language server's analysis as a terminal report.
;
; The LSP module (lsp.bl) answers editor requests as data. `bl lsp check FILE`
; renders that same data for a terminal: the diagnostics an editor would show as
; squiggles, then the document-symbol outline — but with the PROOF badges the
; compiler already computed for each definition (return type, purity,
; termination, native-eligibility). It is the "compiler-as-IDE" view without an
; editor: point the drop at a file and read what the compiler PROVED about it.
;
; Every badge here is rendered by the SAME function the editor's hover card
; uses (lsp/tagset-str, lsp/footprint-str), because an editor and a terminal are
; two clients of one answer and must not disagree about what it says.

(ns lsp.cli
  (:require [lsp]))

; ── badges ────────────────────────────────────────────────────────────────

(defn- purity-badge
  "`pure`, or the effects it does have — named the way the hover card names
   them, because a reader meets the same words in both places."
  [s]
  (if (:pure s)
    "pure"
    (str "effects: " (or (lsp/footprint-str (:footprint s)) "?"))))

(defn- native-badge
  "◆ = native-eligible (pure ∧ terminating), · = not. Reads the bundle the
   report bound once — a whole-program analysis per symbol is this command's
   biggest waste."
  [a name]
  (let [e (lsp/native-eligible* a name)]
    (if (:eligible e) "◆ native" "·")))

(defn- returns-str
  "The inferred return type, in the same words the hover card uses — `any`, not
   fourteen tags."
  [s]
  (lsp/tagset-str (:returns s)))

; ── the report ──────────────────────────────────────────────────────────────

(defn- render-diagnostics [diags]
  (if (empty? diags)
    (println "  diagnostics: none")
    (do
      (println (str "  diagnostics (" (count diags) "):"))
      (reduce (fn [_ d]
                (println (str "    " (get d :line "?") ":" (get d :col "?")
                              "  " (get d :msg (get d :message "?"))))
                nil)
              nil diags))))

(defn- growth-badge
  "The recursion growth label (O(n) / >= O(n^2) / O(2^n)) when the fn is
   self-recursive, else no badge."
  [s]
  (if (:growth-label s) [(:growth-label s)] []))

(defn- render-symbol
  "One definition: its name, the docstring its author wrote, and the facts the
   compiler proved about it."
  [a docs s]
  ; s = {:name :returns :terminates :pure :calls :growth :growth-label} from lsp/document-symbols
  (let [name (:name s)
        doc (:doc (get docs name))
        badges (join "  "
                     (concat [(str "→ " (returns-str s))
                              (purity-badge s)
                              (if (:terminates s) "terminates" "may-diverge")
                              (native-badge a name)]
                             (growth-badge s)))]
    (println (str "    " name))
    (when (string? doc)
      (println (str "        " (join "\n        " (split doc "\n")))))
    (println (str "        " badges))
    (when (seq (:calls s))
      (println (str "        calls: " (join ", " (into [] (:calls s))))))))

(defn report
  "Render the full LSP analysis of `src` (namespace `ns`) as a terminal report:
   diagnostics, then each definition with its docstring and proven summary.
   Returns the number of diagnostics (0 ⇒ clean)."
  [src ns]
  (let [a (lsp/analyzed src)
        diags (lsp/diagnostics src ns)
        syms (lsp/document-symbols src)
        docs (lsp/defn-info src)]
    (println (str "── " ns " ──"))
    (render-diagnostics diags)
    (println (str "  symbols (" (count syms) "):"))
    (reduce (fn [_ s] (render-symbol a docs s) nil) nil (into [] syms))
    (count diags)))
