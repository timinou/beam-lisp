; web.bl — a pure-beam-lisp HTTP + WebSocket server.
;
; ── What this is ──────────────────────────────────────────────────────
;
; Everything you need to run a real web app from a `.bl` file: start an HTTP
; server, route requests, and upgrade a connection to a WebSocket — all with
; plain beam-lisp functions.
;
; The WebSocket callbacks are carried as a map of bl fns in the socket state and
; dispatched by the `BeamLisp.WebSocket` adapter. NB this adapter is a
; convenience, not a necessity: a bl namespace compiles to a real BEAM module
; whose `defn`s are genuine exports, so a bl ns can itself BE an OTP behaviour
; module — point the callback at the ns's own module atom and OTP calls its
; exports directly (see `priv/executor/ssh.bl`, which is its own
; `:ssh_server_key_api` module with zero Elixir). The adapter is kept only
; because a WebSocket's handlers are per-connection VALUES (closures over socket
; state), which suits delegation better than fixed module exports.
;
;   (web/serve {:port 4000 :plug my-router})
;
;   (defn my-router [conn]
;     (web/route conn
;       [:get "/"]   (web/html conn (home-page))
;       [:get "/ws"] (web/upgrade conn ws-handlers)
;       :else        (web/text conn 404 "not found")))
;
; A WebSocket handler is a map of bl functions:
;   {:init      (fn [state] [:push [[:text "hi"]] state])
;    :handle-in (fn [frame state] …)      ; frame = [:text "…"] / [:binary …]
;    :handle-info (fn [msg state] …)}     ; an Erlang message to this socket
; each returning a defserver-style result: [:ok s] · [:push msgs s] · [:stop r s].

(ns web)

;; ── the Elixir modules we lean on (loaded once) ───────────────────────
(def ^:private Bandit (erlang/binary_to_atom "Elixir.Bandit"))
(def ^:private Conn (erlang/binary_to_atom "Elixir.Plug.Conn"))
(def ^:private WSA (erlang/binary_to_atom "Elixir.WebSockAdapter"))
(def ^:private Adapter (erlang/binary_to_atom "Elixir.BeamLisp.WebSocket"))
(def ^:private Code (erlang/binary_to_atom "Elixir.Code"))

(defn- ensure! [m] (erlang/apply Code :ensure_loaded (list m)))
(ensure! Bandit) (ensure! Conn) (ensure! WSA) (ensure! Adapter)

;; ── Plug.Conn wrappers ────────────────────────────────────────────────

(defn method
  "The request method, lowercased: \"get\", \"post\", …"
  [conn]
  (String/downcase (erlang/map_get :method conn)))

(defn path
  "The request path, e.g. \"/ws\"."
  [conn]
  (erlang/map_get :request_path conn))

(defn query
  "The raw query string (\"a=1&b=2\")."
  [conn]
  (erlang/map_get :query_string conn))

(defn req-cookie
  "One request cookie by name, or nil. Fetches cookies first."
  [conn name]
  (let [c (erlang/apply Conn :fetch_cookies (list conn (list)))
        cookies (erlang/map_get :req_cookies c)]
    (get cookies name)))

(defn req-header
  "The first request header named `name` (lowercase), or nil.

   Plug lowercases header names, and `get_req_header` returns a LIST of
   values (a header may repeat); we take the first, which is what a
   single-valued header like `authorization` always is. This is the seam a
   bearer credential arrives on: `(req-header conn \"authorization\")` →
   \"Bearer <token>\". Absent header ⇒ nil, never a crash."
  [conn name]
  (let [vs (erlang/apply Conn :get_req_header (list conn name))]
    (if (empty? vs) nil (first vs))))

(defn bearer-token
  "The token from an `Authorization: Bearer <t>` request header, or nil.

   The standard way an API/MCP caller presents a capability over HTTP. Case
   of the scheme is normalized; a header that is present but not a Bearer
   yields nil so a caller can distinguish 'no bearer' from a malformed one."
  [conn]
  (let [h (req-header conn "authorization")]
    (if (nil? h) nil
      (let [parts (String/split h " ")]
        (if (and (>= (count parts) 2) (= "bearer" (String/downcase (first parts))))
          (second parts)
          nil)))))

(defn read-body
  "Read the full request body as a binary (empty when none). For a login POST
   or a webhook. Reads once; a second call is empty (Plug consumes the body)."
  [conn]
  (let [res (erlang/apply Conn :read_body (list conn (list)))]
    ;; {:ok body conn} | {:more partial conn} | {:error _}; take the first chunk's
    ;; body (login/webhook bodies are small, single-chunk).
    (let [tag (elem res 0)]
      (if (or (= tag :ok) (= tag :more)) (elem res 1) ""))))

(defn form-params
  "Parse an application/x-www-form-urlencoded body into a string-keyed map,
   e.g. a=1&b=hi -> {a 1, b hi}. Percent-decoded, '+' as space. The shape a
   POSTed HTML form arrives in."
  [conn]
  (let [body (read-body conn)]
    (if (or (nil? body) (= "" body)) {}
      (reduce (fn [acc pair]
                (let [kv (String/split pair "=")]
                  (if (>= (count kv) 2)
                    (assoc acc (url-decode (first kv)) (url-decode (second kv)))
                    acc)))
              {} (String/split body "&")))))

(defn put-cookie
  "Set a response cookie. Returns the updated conn. `opts` is an Erlang
   keyword list (a list of {key value} tuples), e.g.
   (list (tuple :http_only false) (tuple :same_site \"Lax\"))."
  ([conn name value] (put-cookie conn name value (list)))
  ([conn name value opts]
   (erlang/apply Conn :put_resp_cookie (list conn name value opts))))

(defn- content-type [conn ct]
  (erlang/apply Conn :put_resp_content_type (list conn ct)))

(defn text
  "Send a plain-text response with `status`. Returns the (sent) conn."
  ([conn body] (text conn 200 body))
  ([conn status body]
   (erlang/apply Conn :send_resp (list (content-type conn "text/plain") status body))))

(defn html
  "Send an HTML response (200). Returns the sent conn."
  ([conn body] (html conn 200 body))
  ([conn status body]
   (erlang/apply Conn :send_resp (list (content-type conn "text/html") status body))))

(defn js
  "Send a JavaScript response (200)."
  [conn body]
  (erlang/apply Conn :send_resp (list (content-type conn "application/javascript") 200 body)))

(defn bytes
  "Send a response with an explicit content type and a binary/iodata body
   (200). For static assets (fonts, images, wasm) the text/html/js helpers
   can't express. Returns the sent conn."
  [conn ct body]
  (erlang/apply Conn :send_resp (list (content-type conn ct) 200 body)))

(defn bytes-cached
  "Like `bytes`, but also sets a long immutable Cache-Control — for
   content-addressed or versioned static assets that never change under a
   given URL."
  [conn ct body]
  (let [c (erlang/apply Conn :put_resp_header
                        (list conn "cache-control" "public, max-age=31536000, immutable"))]
    (erlang/apply Conn :send_resp (list (content-type c ct) 200 body))))

(defn redirect
  "302 redirect to `location`."
  [conn location]
  (let [c (erlang/apply Conn :put_resp_header (list conn "location" location))]
    (erlang/apply Conn :send_resp (list c 302 ""))))

;; ── routing ───────────────────────────────────────────────────────────
;;
;; `(route conn [:get "/"] expr [:post "/x"] expr … :else expr)` matches the
;; method+path pairs in order and evaluates the first matching expression.

(defmacro route [conn & clauses]
  (let [c (gensym "conn")
        pairs (partition 2 clauses)
        cond-clauses
        (mapcat
          (fn [pair]
            (let [pat (first pair) expr (second pair)]
              (if (= pat :else)
                (list :else expr)
                (let [m (name (first pat)) p (second pat)]
                  (list `(and (= (method ~c) ~m) (= (path ~c) ~p)) expr)))))
          pairs)]
    `(let [~c ~conn]
       (cond ~@cond-clauses))))

;; ── WebSocket upgrade ─────────────────────────────────────────────────

(defn upgrade
  "Upgrade `conn` to a WebSocket handled by `handlers` (a map of bl fns).
   `init-state` (optional) is the bl callbacks' starting state."
  ([conn handlers] (upgrade conn handlers nil))
  ([conn handlers init-state]
   (let [wrap (erlang/apply Adapter :wrap (list handlers init-state))
         opts (list (erlang/list_to_tuple (list :timeout 120000)))]
     (erlang/apply WSA :upgrade (list conn Adapter wrap opts)))))

;; ── push to a socket process ──────────────────────────────────────────
;;
;; A WebSocket runs in its own process. To push a frame from elsewhere, send
;; the socket pid a message; its :handle-info returns [:push …]. `send-frame`
;; is sugar for that when the handler forwards raw frames.

(defn send!
  "Send an Erlang message to a socket process (delivered to its :handle-info)."
  [pid msg]
  (erlang/send pid msg))

;; ── misc helpers ──────────────────────────────────────────────────────

(def ^:private URI (erlang/binary_to_atom "Elixir.URI"))
(ensure! URI)

(defn url-decode
  "Percent-decode a query/form value ('a%20b' -> 'a b', '+' -> space)."
  [s]
  (erlang/apply URI :decode_www_form (list s)))

(def ^:private CodeMod (erlang/binary_to_atom "Elixir.Code"))

(defn priv-dir
  "Absolute path to beam-lisp's priv/ directory (where lib/live/client.js
   lives). Goes through `BeamLisp.Tiers.priv_root`, which knows an escript
   reports a virtual archive path and falls back to the source checkout."
  []
  (BeamLisp.Tiers/priv_root))

(defn asset
  "A static asset by its priv-relative path — e.g. (asset
   \"lib/live/client.js\"). The W0 taxonomy moved live/ under lib/, so call
   sites carry the tier, not this fn."
  [rel]
  (File/read! (str (priv-dir) "/" rel)))

;; ── the server ────────────────────────────────────────────────────────

(defn serve
  "Start a Bandit HTTP server. `opts` = {:port int :plug fn}. The plug is a
   1-arg bl function (conn → conn). Returns {:ok pid}."
  [opts]
  (let [port (get opts :port 4000)
        plug-fn (get opts :plug)
        ;; Bandit accepts a function plug of arity 2: (conn, opts) -> conn.
        ;; Wrap the user's 1-arg router so it ignores the opts argument.
        plug2 (fn [conn _opts] (plug-fn conn))
        bopts (list (erlang/list_to_tuple (list :plug plug2))
                    (erlang/list_to_tuple (list :port port))
                    (erlang/list_to_tuple (list :scheme :http)))]
    (erlang/apply Bandit :start_link (list bopts))))
