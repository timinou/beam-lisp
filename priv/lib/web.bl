; web.bl — a pure-beam-lisp HTTP + WebSocket server.
;
; ── What this is ──────────────────────────────────────────────────────
;
; Everything you need to run a real web app from a `.bl` file: start an HTTP
; server, route requests, and upgrade a connection to a WebSocket — all with
; plain beam-lisp functions.
;
; The WebSocket callbacks are carried as a map of bl fns in the socket state and
; dispatched by the `BeamLisp.WebSocket` adapter. NB this adapter is a
; convenience, not a necessity: a bl namespace compiles to a real BEAM module
; whose `defn`s are genuine exports, so a bl ns can itself BE an OTP behaviour
; module — point the callback at the ns's own module atom and OTP calls its
; exports directly (see `priv/executor/ssh.bl`, which is its own
; `:ssh_server_key_api` module with zero Elixir). The adapter is kept only
; because a WebSocket's handlers are per-connection VALUES (closures over socket
; state), which suits delegation better than fixed module exports.
;
;   (web/serve {:port 4000 :plug my-router})
;
;   (defn my-router [conn]
;     (web/route conn
;       [:get "/"]   (web/html conn (home-page))
;       [:get "/ws"] (web/upgrade conn ws-handlers)
;       :else        (web/text conn 404 "not found")))
;
; A WebSocket handler is a map of bl functions:
;   {:init      (fn [state] [:push [[:text "hi"]] state])
;    :handle-in (fn [frame state] …)      ; frame = [:text "…"] / [:binary …]
;    :handle-info (fn [msg state] …)}     ; an Erlang message to this socket
; each returning a defserver-style result: [:ok s] · [:push msgs s] · [:stop r s].

(ns web)

;; ── the Elixir modules we lean on (loaded once) ───────────────────────
(def ^:private Bandit (erlang/binary_to_atom "Elixir.Bandit"))
(def ^:private Conn (erlang/binary_to_atom "Elixir.Plug.Conn"))
(def ^:private WSA (erlang/binary_to_atom "Elixir.WebSockAdapter"))
(def ^:private Adapter (erlang/binary_to_atom "Elixir.BeamLisp.WebSocket"))
(def ^:private Code (erlang/binary_to_atom "Elixir.Code"))

(defn- ensure! [m] (erlang/apply Code :ensure_loaded (list m)))
(ensure! Bandit) (ensure! Conn) (ensure! WSA) (ensure! Adapter)

;; ── Plug.Conn wrappers ────────────────────────────────────────────────

(defn method
  "The request method, lowercased: \"get\", \"post\", …"
  [conn]
  (String/downcase (erlang/map_get :method conn)))

(defn path
  "The request path, e.g. \"/ws\"."
  [conn]
  (erlang/map_get :request_path conn))

(defn query
  "The raw query string (\"a=1&b=2\")."
  [conn]
  (erlang/map_get :query_string conn))

(defn req-cookie
  "One request cookie by name, or nil. Fetches cookies first."
  [conn name]
  (let [c (erlang/apply Conn :fetch_cookies (list conn (list)))
        cookies (erlang/map_get :req_cookies c)]
    (get cookies name)))

(defn req-header
  "The first request header named `name` (lowercase), or nil.

   Plug lowercases header names, and `get_req_header` returns a LIST of
   values (a header may repeat); we take the first, which is what a
   single-valued header like `authorization` always is. This is the seam a
   bearer credential arrives on: `(req-header conn \"authorization\")` →
   \"Bearer <token>\". Absent header ⇒ nil, never a crash."
  [conn name]
  (let [vs (erlang/apply Conn :get_req_header (list conn name))]
    (if (empty? vs) nil (first vs))))

(defn bearer-token
  "The token from an `Authorization: Bearer <t>` request header, or nil.

   The standard way an API/MCP caller presents a capability over HTTP. Case
   of the scheme is normalized; a header that is present but not a Bearer
   yields nil so a caller can distinguish 'no bearer' from a malformed one."
  [conn]
  (let [h (req-header conn "authorization")]
    (if (nil? h) nil
      (let [parts (String/split h " ")]
        (if (and (>= (count parts) 2) (= "bearer" (String/downcase (first parts))))
          (second parts)
          nil)))))

(defn read-body*
  "Read the FULL request body and return [body conn].

   RESPOND WITH THAT CONN. Plug tracks how much of the request it has already
   consumed, and the conn carries that position; a response sent on the
   pre-read conn leaves the socket mid-body, so the next request on a
   keep-alive connection is parsed from the leftover bytes. The failure is a
   bare 400 with an empty body ('Request line HTTP error: …' in the journal)
   on the FOLLOWING request — measured at 15-35% of POSTs when the body
   arrives in its own TCP segment, which is what a browser, a proxy, or any
   streaming client does. A client that coalesces headers and body into one
   write (curl does) never trips it, which is why it hides in a smoke test.

   Loops until Plug says :ok, so a body larger than one read chunk is
   complete — unlike the single-chunk convenience of the same name."
  [conn]
  (loop [conn conn acc []]
    (let [res (erlang/apply Conn :read_body (list conn (list)))
          tag (elem res 0)]
      (cond
        (= tag :ok) [(apply str (conj acc (elem res 1))) (elem res 2)]
        (= tag :more) (recur (elem res 2) (conj acc (elem res 1)))
        :else [(apply str acc) conn]))))

(defn read-body
  "The body only — for a caller that will not respond on this connection.
   Prefer read-body* when you do respond: dropping the conn it returns costs
   the NEXT request on a keep-alive connection (read-body* documents how)."
  [conn]
  (first (read-body* conn)))

(defn form-params*
  "Parse an application/x-www-form-urlencoded body and return [params conn].

   A string-keyed map, e.g. a=1&b=hi -> {a 1, b hi}, percent-decoded, '+' as
   space — the shape a POSTed HTML form arrives in. RESPOND WITH THAT CONN:
   see read-body* for what a response on the pre-read conn costs."
  [conn]
  (let [[body conn] (read-body* conn)]
    [(if (or (nil? body) (= "" body)) {}
       (reduce (fn [acc pair]
                 (let [kv (String/split pair "=")]
                   (if (>= (count kv) 2)
                     (assoc acc (url-decode (first kv)) (url-decode (second kv)))
                     acc)))
               {} (String/split body "&")))
     conn]))

(defn form-params
  "The parsed form only — for a caller that will not respond on this
   connection. Prefer form-params* when you do respond."
  [conn]
  (first (form-params* conn)))

(defn- content-type-of [conn]
  (let [h (req-header conn "content-type")] (or h "")))

(defn- part-body
  "Drain one multipart part's body (Plug.Conn.read_part_body loops until :ok)."
  [conn]
  (loop [conn conn acc []]
    (let [res (erlang/apply Conn :read_part_body (list conn (list)))
          tag (elem res 0)]
      (cond
        (= tag :ok) [(apply str (conj acc (elem res 1))) (elem res 2)]
        (= tag :more) (recur (elem res 2) (conj acc (elem res 1)))
        :else [(apply str acc) conn]))))

(defn- disposition-of
  "content-disposition header → {:name … :filename …} (a form part's identity).
   Plain string parsing: `form-data; name=\"pin\"; filename=\"bat.pdf\"`."
  [headers]
  (let [cd (or (some (fn [h] (when (= "content-disposition" (String/downcase (elem h 0))) (elem h 1))) headers) "")
        kv (fn [k]
             (let [needle (str k "=\"")
                   ix (index-of cd needle)]
               (when (and ix (>= ix 0))
                 (let [rest-s (subs cd (+ ix (count needle)) (count cd))
                       end (index-of rest-s "\"")]
                   (if (and end (>= end 0)) (subs rest-s 0 end) rest-s)))))]
    {:name (kv "name") :filename (kv "filename")}))

(defn multipart-params*
  "Parse a multipart/form-data body. Returns [params conn]: the string-keyed
   map (a plain field → its string; a file field → {:filename :content-type
   :bytes}) AND the conn AFTER the body was drained. Respond with THAT conn:
   Plug tracks how much of the request was consumed, and responding on the
   pre-read conn leaves the socket mid-body, so the next request on a
   keep-alive connection is parsed from the leftover bytes (a 400).
   A urlencoded body falls back to form-params (its conn is unchanged)."
  [conn]
  (if (not (String/starts_with? (content-type-of conn) "multipart/form-data"))
    [(form-params conn) conn]
    (loop [conn conn acc {}]
      (let [res (erlang/apply Conn :read_part_headers (list conn (list)))
            tag (elem res 0)]
        (if (not= tag :ok)
          [acc (elem res 1)]
          (let [headers (to-list (elem res 1))
                conn2 (elem res 2)
                d (disposition-of headers)
                ct (some (fn [h] (when (= "content-type" (String/downcase (elem h 0))) (elem h 1))) headers)
                [body conn3] (part-body conn2)]
            (recur conn3
                   (if (nil? (:name d)) acc
                     (assoc acc (:name d)
                            (if (:filename d)
                              {:filename (:filename d) :content-type ct :bytes body}
                              body))))))))))

(defn multipart-params
  "The parsed multipart body only — for a caller that will not respond on
   this connection. Prefer multipart-params* when you do respond."
  [conn]
  (first (multipart-params* conn)))

(defn put-cookie
  "Set a response cookie. Returns the updated conn. `opts` is an Erlang
   keyword list (a list of {key value} tuples), e.g.
   (list (tuple :http_only false) (tuple :same_site \"Lax\"))."
  ([conn name value] (put-cookie conn name value (list)))
  ([conn name value opts]
   (erlang/apply Conn :put_resp_cookie (list conn name value opts))))

(defn- content-type [conn ct]
  (erlang/apply Conn :put_resp_content_type (list conn ct)))

(defn text
  "Send a plain-text response with `status`. Returns the (sent) conn."
  ([conn body] (text conn 200 body))
  ([conn status body]
   (erlang/apply Conn :send_resp (list (content-type conn "text/plain") status body))))

(defn json
  "Send a JSON response. `body` may be a pre-encoded string/iodata or any
   JSON-encodable value (encoded with bl.json). The seam an API/MCP endpoint
   answers on. Returns the sent conn."
  ([conn body] (json conn 200 body))
  ([conn status body]
   (let [payload (if (string? body) body (bl.json/encode body))]
     (erlang/apply Conn :send_resp
       (list (content-type conn "application/json") status payload)))))

(defn resp-header
  "Set a response header. Returns the updated conn (chain before a send)."
  [conn name value]
  (erlang/apply Conn :put_resp_header (list conn name value)))

;; ── Server-Sent Events (chunked streaming) ──────────────────────────
;; The transport an MCP server uses to PUSH notifications to a client over
;; one long-lived HTTP response (Content-Type: text/event-stream). A caller
;; opens the stream, then writes `sse-event` frames until the peer goes away.

(defn sse-open
  "Begin a chunked SSE response (status 200, text/event-stream). Returns the
   sent conn to pass to `sse-event`."
  [conn]
  (let [c (-> conn
              (resp-header "content-type" "text/event-stream")
              (resp-header "cache-control" "no-cache")
              (resp-header "connection" "keep-alive"))]
    (erlang/apply Conn :send_chunked (list c 200))))

(defn sse-event
  "Write one SSE frame. `data` is a string (already-encoded JSON, typically);
   `event` is an optional event name. Returns {:ok conn} | {:error reason} so
   the caller can stop when the peer disconnects."
  ([conn data] (sse-event conn nil data))
  ([conn event data]
   (let [frame (str (if (nil? event) "" (str "event: " event "\n"))
                    "data: " data "\n\n")
         r (erlang/apply Conn :chunk (list conn frame))]
     (if (= (erlang/element 1 r) :ok)
       {:ok (erlang/element 2 r)}
       {:error (erlang/element 2 r)}))))

(defn sse-comment
  "Write an SSE heartbeat comment (keeps the connection alive through proxies)."
  [conn]
  (let [r (erlang/apply Conn :chunk (list conn ": ping\n\n"))]
    (if (= (erlang/element 1 r) :ok) {:ok (erlang/element 2 r)} {:error (erlang/element 2 r)})))

(defn html
  "Send an HTML response (200). Returns the sent conn."
  ([conn body] (html conn 200 body))
  ([conn status body]
   (erlang/apply Conn :send_resp (list (content-type conn "text/html") status body))))

(defn js
  "Send a JavaScript response (200)."
  [conn body]
  (erlang/apply Conn :send_resp (list (content-type conn "application/javascript") 200 body)))

(defn bytes
  "Send a response with an explicit content type and a binary/iodata body
   (200). For static assets (fonts, images, wasm) the text/html/js helpers
   can't express. Returns the sent conn."
  [conn ct body]
  (erlang/apply Conn :send_resp (list (content-type conn ct) 200 body)))

(defn bytes-cached
  "Like `bytes`, but also sets a long immutable Cache-Control — for
   content-addressed or versioned static assets that never change under a
   given URL."
  [conn ct body]
  (let [c (erlang/apply Conn :put_resp_header
                        (list conn "cache-control" "public, max-age=31536000, immutable"))]
    (erlang/apply Conn :send_resp (list (content-type c ct) 200 body))))

(defn redirect
  "302 redirect to `location`."
  [conn location]
  (let [c (erlang/apply Conn :put_resp_header (list conn "location" location))]
    (erlang/apply Conn :send_resp (list c 302 ""))))

;; ── routing ───────────────────────────────────────────────────────────
;;
;; `(route conn [:get "/"] expr [:post "/x"] expr … :else expr)` matches the
;; method+path pairs in order and evaluates the first matching expression.

(defmacro route [conn & clauses]
  (let [c (gensym "conn")
        pairs (partition 2 clauses)
        cond-clauses
        (mapcat
          (fn [pair]
            (let [pat (first pair) expr (second pair)]
              (if (= pat :else)
                (list :else expr)
                (let [m (name (first pat)) p (second pat)]
                  (list `(and (= (method ~c) ~m) (= (path ~c) ~p)) expr)))))
          pairs)]
    `(let [~c ~conn]
       (cond ~@cond-clauses))))

;; ── WebSocket upgrade ─────────────────────────────────────────────────

(defn upgrade
  "Upgrade `conn` to a WebSocket handled by `handlers` (a map of bl fns).
   `init-state` (optional) is the bl callbacks' starting state."
  ([conn handlers] (upgrade conn handlers nil))
  ([conn handlers init-state]
   (let [wrap (erlang/apply Adapter :wrap (list handlers init-state))
         opts (list (erlang/list_to_tuple (list :timeout 120000)))]
     (erlang/apply WSA :upgrade (list conn Adapter wrap opts)))))

;; ── push to a socket process ──────────────────────────────────────────
;;
;; A WebSocket runs in its own process. To push a frame from elsewhere, send
;; the socket pid a message; its :handle-info returns [:push …]. `send-frame`
;; is sugar for that when the handler forwards raw frames.

(defn send!
  "Send an Erlang message to a socket process (delivered to its :handle-info)."
  [pid msg]
  (erlang/send pid msg))

;; ── misc helpers ──────────────────────────────────────────────────────

(def ^:private URI (erlang/binary_to_atom "Elixir.URI"))
(ensure! URI)

(defn url-encode
  "Percent-encode `s` for a query-string value (www-form: space → +)."
  [s]
  (erlang/apply URI :encode_www_form (list (str s))))

(defn url-decode
  "Percent-decode a query/form value ('a%20b' -> 'a b', '+' -> space)."
  [s]
  (erlang/apply URI :decode_www_form (list s)))

(def ^:private CodeMod (erlang/binary_to_atom "Elixir.Code"))

(defn priv-dir
  "Absolute path to beam-lisp's priv/ directory (where lib/live/client.js
   lives). Goes through `BeamLisp.Tiers.priv_root`, which knows an escript
   reports a virtual archive path and falls back to the source checkout."
  []
  (BeamLisp.Tiers/priv_root))

(defn asset
  "A static asset by its priv-relative path — e.g. (asset
   \"lib/live/client.js\"). The W0 taxonomy moved live/ under lib/, so call
   sites carry the tier, not this fn."
  [rel]
  (File/read! (str (priv-dir) "/" rel)))

;; ── the access log ───────────────────────────────────────────────────────
;
; One EDN record per request, on STDERR by default. stdout is reserved for a
; program's own data (`bl run --json`), so a log line there would corrupt it —
; config/config.exs points the Elixir logger at :standard_error for the same
; reason.
;
; THE STATUS EXISTED NOWHERE ELSE. When a screen raises, no bl code sees the
; response: the exception unwinds through this plug into Bandit, which maps it
; with Plug.Exception.status/1, replies 500 with an EMPTY body, and logs it
; itself (Bandit.Pipeline.handle_error/7). A log placed in a router, or in an
; app's own hooks, is therefore blind exactly when it matters most. The wrapper
; in `serve` owns the try/catch for that reason: it records 500, then re-raises
; so Bandit still owns the reply.
;
; An EDN record, not prose, because `bl` can read its own log back — and
; because journald is what RETAINS it in production: a unit's stderr lands in
; the journal, and retention is `journalctl --vacuum-*`'s business, not this
; server's. `:log-pretty` is for a FOREGROUND terminal: journald gives every
; LINE its own record, so the multi-line shape is a dev-server shape.

(defn status
  "The response status of a (sent) conn, or nil before anything was sent."
  [conn]
  (erlang/map_get :status conn))

(defn put-private
  "Stash `v` under `k` on the conn — Plug's own place for data a later layer
   needs and the client must never see."
  [conn k v]
  (erlang/apply Conn :put_private (list conn k v)))

(defn private
  "The `k` a previous layer stashed with `put-private`, or nil.

   `get`, not `erlang/map_get`: a conn whose router stashed nothing is the
   ordinary case for a plain `web/serve` server, and a log field that is absent
   must be absent, not a KeyError."
  [conn k]
  (get (erlang/map_get :private conn) k))

(defn- elapsed-ms
  "Whole microseconds since `t0`, as milliseconds to one decimal."
  [t0]
  (/ (erlang/round (/ (- (erlang/monotonic_time :microsecond) t0) 100.0)) 10.0))

(defn- who
  "A principal as one short token for the log. The app's principal is whatever
   the app decided it is (a string, or a map with :id); the log names it,
   bounded, so one record stays one readable line."
  [me]
  (when (some? me)
    (let [s (cond
              (string? me) me
              (map? me) (str (or (:id me) (:name me) "?"))
              :else (str me))]
      (if (> (count s) 48) (String/slice s 0 48) s))))

;; The bytes this fn escapes TO, built from their codes: a backslash and a double
;; quote. Written as literals they need escaping, and in a language where a stray
;; quote ANYWHERE — including inside a `;` comment — breaks the parse of the
;; whole file (measured: it cost an hour, and it is why no comment below quotes
;; anything), a code is cheaper to read than a count of backslashes.
(def ^:private bs (erlang/list_to_binary (list 92)))
(def ^:private qt (erlang/list_to_binary (list 34)))
(def ^:private nl (erlang/list_to_binary (list 10)))
(def ^:private cr (erlang/list_to_binary (list 13)))
(def ^:private tab (erlang/list_to_binary (list 9)))

(defn- edn-string
  "A string as EDN text, quoted and escaped.

   `pr-str` alone is not enough: bl prints a STRING bare, so a path with a space
   or a colon would produce a record that cannot be read back. Quoting also
   keeps a multi-line error message on one line."
  [s]
  (let [escaped (-> (str s)
                    (String/replace bs (str bs bs))
                    (String/replace qt (str bs qt))
                    (String/replace nl (str bs "n"))
                    (String/replace cr (str bs "r"))
                    (String/replace tab (str bs "t")))]
    (str qt escaped qt)))

(defn- edn-value
  "A value as EDN text: strings quoted, everything else as bl prints it."
  [v]
  (if (string? v) (edn-string v) (pr-str v)))

(defn- access-line
  "The record as EDN: one line, or `pretty?` one field per line."
  [pretty? pairs]
  (let [field (fn [kv] (str ":" (name (first kv)) " " (edn-value (second kv))))]
    (if pretty?
      (str "{" (join "\n " (map field pairs)) "}")
      (str "{" (join " " (map field pairs)) "}"))))

(defn- log-sink
  "Where records go: :stderr (the default), nil/:off for silence, or a 1-arg
   fn the caller routes — the fn is handed the record as DATA, so pretty
   printing of a routed log is the caller's business, not this one's."
  [log]
  (cond
    (nil? log) nil
    (= log :off) nil
    (= log :stderr) :stderr
    (BeamLisp.RT/invocable? log 1) log
    :else :stderr))

(defn- access!
  "One record for one request. `code` is nil when the request ENDED without a
   response — the raise path, which is logged as 500 because that is what
   Bandit will send.

   Never raises: the record is worth less than the response it describes, and
   this runs on the request's own path (measured: a `:me` getter that raised on
   a conn whose router stashed nothing turned every logged request into an
   error AFTER its body was already sent — the client saw 200, the log showed a
   stack trace, and the record never appeared)."
  [sink pretty? conn code t0 err]
  (when (some? sink)
    (try
      ;; a field with nothing to say is ABSENT, not nil: one record, one line,
      ;; and every field in it worth reading
      (let [pairs (into []
                        (keep (fn [kv] (if (some? (second kv)) kv nil))
                              [[:at (erlang/system_time :millisecond)]
                               [:method (method conn)]
                               [:path (path conn)]
                               [:status (if (nil? code) 500 code)]
                               [:ms (elapsed-ms t0)]
                               [:me (who (private conn :me))]
                               [:err (when (some? err) (ex-message err))]]))]
        (if (= sink :stderr)
          (IO/puts :stderr (access-line pretty? pairs))
          (sink (into {} pairs))))
      (catch _e nil))))

;; ── the server ────────────────────────────────────────────────────────

(defn serve
  "Start a Bandit HTTP server. `opts` = {:port int :plug fn :ip tuple
   :log :stderr|:off|fn :log-pretty bool}.
   The plug is a 1-arg bl function (conn → conn). :ip (an Erlang ip tuple,
   e.g. {127,0,0,1}) binds a specific interface — a management console
   belongs on loopback; absent, Bandit's default (all interfaces) applies.
   Every request is logged (see the access-log note above) unless :log says
   otherwise. Returns {:ok pid}."
  [opts]
  (let [port (get opts :port 4000)
        plug-fn (get opts :plug)
        sink (log-sink (get opts :log :stderr))
        pretty? (get opts :log-pretty false)
        ;; Bandit accepts a function plug of arity 2: (conn, opts) -> conn.
        ;; Wrap the user's 1-arg router so it ignores the opts argument, and
        ;; log what it produced: this wrapper is the only place a response is
        ;; observable at all (see the access-log note above).
        plug2 (fn [conn _opts]
                (let [t0 (erlang/monotonic_time :microsecond)]
                  (try
                    (let [c (plug-fn conn)]
                      (access! sink pretty? conn (status c) t0 nil)
                      c)
                    (catch e
                      (access! sink pretty? conn nil t0 e)
                      (throw e)))))
        bopts (list (erlang/list_to_tuple (list :plug plug2))
                    (erlang/list_to_tuple (list :port port))
                    (erlang/list_to_tuple (list :scheme :http)))
        bopts (if-let [ip (get opts :ip)]
                (concat bopts (list (erlang/list_to_tuple (list :ip ip))))
                bopts)]
    (erlang/apply Bandit :start_link (list bopts))))
