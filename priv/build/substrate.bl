; build/substrate.bl — the ELIXIR SUBSTRATE stage: `lib/**/*.ex` compiled
; in-process. (The wave that designed this called it `build/ex`; in the flat
; `priv/build/` namespace convention its name is what it compiles — the
; substrate.)
;
; `mix compile` builds two things: the Elixir sources in `lib/` (mix's own
; `:elixir` compiler) and the `.bl` sources (this project's compiler task). The
; drop must do both with no Mix project, no `_build`, no `MIX_ENV` — and it can:
; Elixir's compiler and `Kernel.ParallelCompiler` ship in the payload (W0/P2
; measured 86 modules in 9.9 s with Mix absent from the module set entirely).
;
; So the substrate is a STAGE, not a second build: same plan, same output
; directory, same fact log. Its facts are
;
;   [:build/ex path content-hash [module …]]
;
; Freshness is the CONTENT HASH, and modules are RECORDED, for two reasons that
; matter in different ways: a hash is what an Elixir file's freshness can
; honestly be without parsing its interface, and the module list is what makes a
; DELETED beam (or a half-extracted release tree) pull its source back into the
; build — the hole W1-R1 documents for the AOT side is closed here by
; construction.
;
; Attribution is the compiler's own: every compiled module answers
; `module_info(:compile)` with a `:source` entry naming the file it came from.
; That is what lets this compile the whole set in ONE batch — which is what the
; parallel compiler needs in order to resolve cross-file dependencies itself —
; and still record a fact PER FILE, so one edited file recompiles alone.
(ns substrate)

(defn sources
  "Every `.ex` under `root`, minus anything under an entry of `exclude`
   (relative paths, e.g. the Mix-task shells and the dev-only server). Sorted:
   the log's fact order must not depend on the filesystem's."
  [root exclude]
  (vec (sort (remove (fn [f]
                       (let [rel (Path/relative_to f root)]
                         (some (fn [x] (String/starts_with? rel x)) exclude)))
                     (Path/wildcard (Path/join root "**/*.ex"))))))

(defn- content-hash [path] (sha256-hex (File/read! path)))

(defn stale
  "The sources the log cannot vouch for: no fact, a different content hash, or
   a beam its fact names that is no longer on disk."
  [state paths out]
  (vec (filter (fn [p]
                 (let [e (get (:ex state) p)]
                   (or (nil? e)
                       (not= (:hash e) (content-hash p))
                       (not (every? (fn [m] (File/exists? (Path/join out (str m ".beam"))))
                                    (:modules e))))))
               paths)))

(defn- source-of
  "The file a compiled module came from, per the compiler's own compile info."
  [m]
  (let [info (erlang/apply m :module_info (list :compile))]
    (erlang/list_to_binary (second (first (filter (fn [e] (= :source (first e))) info))))))

(defn- by-source
  "`{expanded-path → [module-name …]}` over a batch's modules."
  [mods]
  (reduce (fn [m mod]
            (update m (source-of mod) (fn [v] (conj (or v []) (str mod)))))
          {}
          mods))

(defn- error-message
  "One compiler error as a line.

   With `return_diagnostics: true` — which the parallel compiler now REQUIRES,
   the raw `{file, {line, col}, message}` tuples being deprecated — an error is
   a `%Code.Diagnostic{}`: a map with `:message`, `:file` and `:position`. The
   tuple branch stays for a VM whose compiler still answers the old way: read
   whichever shape is there rather than matching one and printing `nil` for the
   other."
  [e]
  (if (map? e)
    (let [p (:position e)]
      (str "beam-lisp substrate: " (:file e)
           (if (and (some? p) (= 2 (count p))) (str ":" (first p) ":" (second p)) "")
           ": " (:message e)))
    (str "beam-lisp substrate: " (erlang/element 1 e) ": "
         (if (= 3 (count e)) (erlang/element 3 e) (erlang/element 2 e)))))

(defn compile!
  "Compile `paths` into `out` as ONE batch.

   Returns `{:compiled n :facts [fact …] :errors [msg …]}`; the CALLER appends
   the facts, because the build owns the log's ordering and there is one writer.
   A failed batch records nothing: the sources stay stale, so the next run
   retries them, and the errors are reported to whoever asked for the build."
  [paths out]
  (if (empty? paths)
    {:compiled 0 :facts [] :errors []}
    (do
      (File/mkdir_p! out)
      ; A batch that recompiles a file whose module already lives in this VM is
      ; the NORMAL case — the build VM has loaded them — so the conflict is
      ; expected, not something to drown the build log in.
      (Code/compiler_options (list (erlang/list_to_tuple (list :ignore_module_conflict true))))
      ; `Enum/to_list`: the parallel compiler walks its file argument as an
      ; Erlang list, and a bl vector is a struct — handing it one fails inside
      ; the compiler's own `[file | queue]` clauses, not here.
      (let [r (Kernel.ParallelCompiler/compile_to_path (Enum/to_list paths) out
                 (list (erlang/list_to_tuple (list :return_diagnostics true))))]
        (if (= :ok (erlang/element 1 r))
          (let [grouped (by-source (vec (erlang/element 2 r)))]
            {:compiled (count paths)
             :errors []
             :facts (vec (map (fn [p]
                                [:build/ex p (content-hash p) (vec (get grouped (Path/expand p) []))])
                              paths))})
          {:compiled 0
           :facts []
           :errors (vec (map error-message (erlang/element 2 r)))})))))
