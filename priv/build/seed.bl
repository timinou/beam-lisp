    :struct-fields (list (tuple :__exception__ true) (tuple :message nil))
    :behaviour :"Elixir.Exception"}
   {:module :"Elixir.BeamLisp.Reader.AtomLimitError"
    :source (Path/join host-dir "reader_exception.bl")
    :struct-fields (list (tuple :__exception__ true) (tuple :message nil))
    :behaviour :"Elixir.Exception"}
   {:module :"Elixir.BeamLisp.Reader"
    :source (Path/join host-dir "reader.bl")}
   {:module :"Elixir.BeamLisp.Compiler"
    :source (Path/join host-dir "compiler.bl")}
   {:module :"Elixir.BeamLisp.CompileError"
    :source (Path/join host-dir "compile_error.bl")
    :struct-fields (list (tuple :__exception__ true) (tuple :message nil) (tuple :file nil) (tuple :line nil) (tuple :form nil))
    :behaviour :"Elixir.Exception"}
   {:module :"Elixir.BeamLisp.ExInfo"
    :source (Path/join host-dir "ex_info.bl")
