; build/seed.bl — the bootstrap floor, regenerated by the toolchain itself.
;
; `priv/bootstrap/seed/` is the checked-in bootstrap floor: the compiled
; Core-Erlang beams of the BOOT PRELUDE (`priv/boot/*.bl`), so a tree with no
; generation behind it loads the whole compiler from bytes and then compiles
; everything else with it. Seeding that closed set is what breaks every
; bootstrap loop. The manifest beside the beams records the tier keys they were
; built under and a sha256 per beam, so the floor can be JUDGED rather than
; trusted.
;
; This file is that generator, and it was `mix run priv/bootstrap/gen_manifest.exs`
; for exactly one reason: Mix knew where the compiled beams were. Where the
; beams are is not a fact about the floor — and a generator that cannot run
; without the thing the floor exists to replace is the circle this whole
; programme is about. The rules are unchanged, and so is the evidence: every
; shim beam is LOADED and asked for its provenance stamp, and a beam built under
; a different key is refused rather than published. A seed whose manifest key and
; beam stamps disagree is a lie that crashes genesis-less boots CIRCULARLY — the
; drift gate reads a beam's key, finds it foreign, and routes the namespace to
; the source path, which needs that very namespace.
;
;   bl seed [--out DIR] [--ebin DIR]
;
; The BUILD DRIVER (`priv/build/`) is deliberately not seeded. Codegen floored
; from a previous generation is a bootstrap; a driver floored from a previous
; generation is a MIXED TOOLCHAIN — the caller depends on the current contract,
; and staged driver bytes would outlive the source they were written from. The
; driver is read or compiled from the current tree, always. `multi` is not a tier
; file (it is a prelude layer loaded by init) but the compiler needs it too, so
; the closure includes it.

(ns seed
  (:require [drop :as d] [app-resource :as ar]))

(def schema "beam-lisp-bootstrap-seed-v2")

(def default-boot "priv/boot")
(def default-out "priv/bootstrap/seed")
(def default-host "priv/host")

(defn- as-text
  "An Erlang string (a charlist) as a binary."
  [x]
  (if (string? x) x (erlang/list_to_binary x)))

(defn- split-path
  "The path as its segments. `Path/join` in the runtime's Elixir joins the parts
   it is given and does NOT let a later absolute part win, so a caller's absolute
   argument must be used whole rather than joined onto a default."
  [p]
  (String/split p "/"))

(defn- absolute?
  "Whether `p` is absolute — the CLI resolves its paths, a test may not."
  [p]
  (= "" (first (split-path p))))

(defn- under
  "`p` resolved against `root` only when it is relative."
  [root p]
  (if (absolute? p) p (Path/join root p)))

(defn default-ebin
  "Where the compiled boot beams are when nobody said: `BL_SEED_EBIN`, else the
   layout BOTH toolchains write — `_build/<env>/lib/beam_lisp/ebin`. Mix reached
   it through `Mix.Project.compile_path/0`; the convention is the same path, so
   the second toolchain does not need the first to find its own beams."
  []
  (or (System/get_env "BL_SEED_EBIN")
      (System/get_env "BL_SEED_EBIN_FALLBACK")
      ;; Built with `str`, not `Path/join`: that function takes an Erlang list and a
      ;; bl vector is a struct, so the vector form dies with "no function clause
      ;; matches" the moment this default is the one that runs (measured — the
      ;; `--ebin` runs never touched it).
      (str "_build/" (or (System/get_env "MIX_ENV") "dev") "/lib/beam_lisp/ebin")))

(defn namespaces
  "The namespaces the floor must contain: every `BOOT/*.bl` (the compiler, the
   reader, the prelude the compiler resolves its vars against, the tagged-literal
   registry, the Core-Erlang backend) plus `multi`."
  [boot-dir]
  (distinct (concat (map (fn [p] (Macro/camelize (Path/basename p ".bl")))
                         (Path/wildcard (Path/join boot-dir "*.bl")))
                    ["Multi"])))

(defn variants
  "The three beams one namespace is emitted as: the shim (`Ns.X`, the only one
   carrying `__bl_provenance__/0`), the body, and the init companion."
  [ns]
  [(str "Ns." ns) (str "Ns.Body." ns) (str "Ns.Init." ns)])

(defn beam-of [variant] (str "Elixir.BeamLisp." variant ".beam"))

(defn ns-of
  "The namespace a shim beam BELONGS to, from its filename: `Ns.Reader-node` →
   `reader-node`. The tier of a beam is a property of its namespace, and this is
   the same routing the emitter and `AOTCache.key_for_ns/1` use, so a beam's
   stamp and the check below cannot disagree about which tier it is in."
  [name]
  (let [base (String/replace_prefix (Path/basename name ".beam") "Elixir.BeamLisp.Ns." "")]
    (join "-" (map (fn [s] (Macro/underscore s)) (String/split base "-")))))

(defn shim?
  "Whether a beam is a namespace's SHIM rather than one of its companions. Only
   the shims are stamped, so only they can be asked what built them."
  [name]
  (let [base (Path/basename name ".beam")]
    (not (or (includes? base ".Body.") (includes? base ".Init.")))))

(defn expected-key
  "The tier key a namespace's beams must carry: the driver's key for a
   `priv/build/` namespace, the codegen key for everything else."
  [ns compiler-key build-key]
  (if (= :build (BeamLisp.Tiers/tier_of_ns ns)) build-key compiler-key))

(defn stamp
  "What a beam says built it: `{:ok {:hash h :key k}}` when it answered,
   `{:error why}` when it could not. Those are DIFFERENT FACTS and the caller must
   be able to tell them apart — a beam that answers with a foreign key is evidence
   about a toolchain, while a beam that cannot be loaded at all is evidence about a
   file. Collapsing the second into the first is how a generator reports that a
   beam is not one of ours about a beam that is one of ours and says so (measured:
   `binary/to_list` does not exist, and the catch turned that into `built under no
   key`).

   Both halves are needed and for different questions: the KEY is the beam's
   generation (what `stale-why/5` judges), and the HASH is the source closure it was
   emitted from — the same `ns_closure_hash` the language computes from the live
   tree. Together they make the floor JUDGEABLE rather than trusted, and both are
   already IN the beam, so judging costs no new state.

   The key is read by LOADING the beam: a stale beam answers this question
   wrongly, which is exactly what there is to catch. The module is purged first,
   so the file on disk — not a loaded copy — answers."
  [path]
  (try
    (let [mod (String/to_atom (Path/basename path ".beam"))
          bytes (File/read! path)]
      (code/purge mod)
      (code/delete mod)
      (let [loaded (code/load_binary mod (erlang/binary_to_list "seed") bytes)]
        (if (and (tuple? loaded) (= :module (erlang/element 1 loaded)))
          (let [st (erlang/apply mod :__bl_provenance__ (list))]
            (if (tuple? st)
              (let [h (as-text (erlang/element 1 st))
                    k (as-text (erlang/element 2 st))]
                ;; A key with no source hash is a beam nothing can compare against:
                ;; the emitter resolves the closure at emit time and answers nil when
                ;; the namespace's source is not on its search path (measured on
                ;; `data-readers` and `multi`). Naming it is what keeps `check` from
                ;; reading that nil as agreement.
                (if (empty? h)
                  {:error "the beam carries a key but no source hash"}
                  {:ok {:hash h :key k}}))
              {:error "the beam carries no provenance stamp"}))
          {:error (str "cannot load the beam: " (pr-str loaded))})))
    (catch e {:error (str "cannot load the beam: " (or (ex-message e) (pr-str e)))})))

;; ── the pinned HOST floor ───────────────────────────────────────────────────
;
; The boot shims above are COPIED from a build's ebin: the compiler emits them
; and the seed publishes them. A pinned HOST module is different — it is
; COMPILED here, from checked-in source, by the very artefact the floor exists
; to make replaceable (`BeamLisp.AOT/compile-host-file`). That is the whole
; point of the migration: a host leaf stops needing an Elixir `.ex` to exist at
; boot, while the compiler that compiles it still comes from the floor beneath.
;
; Three properties keep that safe, and each is why a function below exists:
;   * the mapping is EXPLICIT — which module a source becomes is written down;
;   * compilation is ISOLATED — into a scratch ebin, `load? false`, so a pinned
;     leaf (CompilerData is live in this VM) is never substituted mid-run;
;   * the bytes are JUDGED — the beam carries the digest of the source it was
;     built from, and `run` refuses one whose stamp disagrees with the source.

(defn host-sources
  "The pinned HOST modules the floor carries: each a checked-in `.bl` source and
   the EXACT `Elixir.BeamLisp.X` module it is compiled to. A table, not a
   directory sweep: which module a source becomes is a decision, and a sweep
   could not tell a pinned leaf from a stray file.

   `:module` is an atom because the emitter takes an atom (a string is never
   turned into one on that path); the beam filename is derived from it.

   Seventeen leaves now. The first four are the compiler's own substrate.
   `CompilerData` and the `Emit`/`Link` pair are seeded TOGETHER on purpose:
   `Emit` builds every descriptor and the `Link` pinned beside it CALLS `Emit`,
   so a floor carrying one without the other would straddle the boundary the pin
   exists to close. `Tiers` joins them because it is the tier AUTHORITY:
   `AOTCache` asks it where the codegen sources live and which tier a namespace
   belongs to, so an edit to it must rotate the codegen key — and once `tiers.ex`
   is deleted this beam is the only copy of the module a boot has. Table order is
   not install order: the whole table is compiled before any of it is used, and
   `Bootstrap.install_hosts!/1` loads the authority first (see there).

   `Delay` and `Deferred` are the deferred-computation pair: `Deferred` builds
   and forces the value-shaped face, `Delay` is the struct cell it wraps, so they
   are seeded together like `Emit`/`Link`. `Delay` carries `:struct-fields
   [{:seq nil}]` — the ONE thing that makes its pinned beam a struct module
   rather than a functions-only one — which `compile-host` forwards to
   `compile-host-file` as the Elixir `:struct_fields` opt. A source edit is
   caught by the per-host `bl_source_hash` (no codegen key rotation), so the
   pair needs no entry in the codegen key table.

   `Derived` and `Reactive` are the second deferred-computation pair, seeded
   together like `Emit`/`Link`: `Reactive`'s `derive` builds a `Derived` and
   `Derived` is the struct cell holding the memo, deps and thunk, so a `derive`
   whose value type is absent names a struct no boot can recognize.

   `Set` and `SetEnumerable` are the collection pair, and the one whose impl
   lives OUTSIDE `Elixir.BeamLisp.*`: `Set` is the pinned struct (`:members`)
   and `SetEnumerable` is the `Enumerable` protocol impl compiled beside it as
   `Elixir.Enumerable.BeamLisp.Set`. That second name is the case a name-prefix
   rule could not reach, which is why `host-names` records the inventory as
   data; it is listed AFTER `Set` so the type is on the code path before its
   impl. Four entries carry `:struct-fields` (`Delay` `[{:seq nil}]`, `Derived`
   `[{:cell nil} {:deps nil} {:thunk nil}]`, `Set` `[{:members nil}]`, `SeqCursor`
   `[{:chunk []} {:tail nil} {:dirty false}]`); every other entry is
   functions-only and produces exactly the option list it did before.

   `SeqCursor` and `SeqCursorEnumerable` are the streaming pair, seeded together
   the way `Set`/`SetEnumerable` are: `SeqCursor` is the pinned struct whose
   `:chunk` copies the one small piece of an eager input onto the BEAM heap, and
   `SeqCursorEnumerable` is its `Enumerable` protocol impl compiled beside it as
   `Elixir.Enumerable.BeamLisp.SeqCursor` — the second pinned leaf outside
   `Elixir.BeamLisp.*`, listed AFTER `SeqCursor` so the type is on the code path
   before its impl. `SeqCursor`'s `:chunk` default is the RAW Erlang empty list,
   never a bl vector: the walk reads it with `hd`/`tl`, so a `BeamLisp.Vector`
   would be the wrong shape.

   `WebSocket` is the WebSock behaviour module. A websocket handler must BE a
   module implementing the `WebSock` behaviour, so its pinned entry carries
   `:behaviour` (the `Elixir.WebSock` atom), forwarded to `compile-host-file` as
   the Elixir `:behaviour` option and recorded as the beam's `-behaviour`
   attribute.

   `Meta` and `FormMeta` are the metadata pair, seeded together like
   `Emit`/`Link`: `FormMeta` carries metadata on FORM DATA and DELEGATES its one
   runtime value type (a lazy seq) to `BeamLisp.Meta`, so `Meta` is listed
   BEFORE `FormMeta` — the delegate stands beside the thing it delegates to.
   `Num` is the numeric tower's seam: the language links `+ - * / < > <= >= ==`
   straight into it (rt.bl's operator table), and it is called from the BOOT
   tier, so its pinned beam must be installed before the boot namespaces are
   interned — which is exactly what `install_hosts!/1` does. All three are
   functions-only: no `:struct-fields`, no `:behaviour`.

   `Application` is the OTP application callback `env.bl`'s `:mod` entry names
   (`{:mod, {'Elixir.BeamLisp.Application', []}}`), so `Application.ensure_all_started(:beam_lisp)`
   calls `start(:normal, [])` on its pinned beam. Its entry carries `:behaviour`
   (the `Elixir.Application` atom), forwarded to `compile-host-file` exactly as
   `WebSocket`'s `Elixir.WebSock` is, so the emitted beam records
   `-behaviour(Application)` and every behaviour reader can judge it as an
   application callback module. It is functions-only — `start/2` and `stop/1`,
   no `:struct-fields`. It is listed LAST after the pinned leaves its `start/2`
   supervises and its `init/0` interns; the whole table is compiled before any of
   it is installed, and `install_hosts!/1` orders the install authority-first by
   name, so the position is documentation, never install order."
  [host-dir]
  [{:module :"Elixir.BeamLisp.CompilerData"
    :source (Path/join host-dir "compiler_data.bl")}
   {:module :"Elixir.BeamLisp.Emit"
    :source (Path/join host-dir "emit.bl")}
   {:module :"Elixir.BeamLisp.Link"
    :source (Path/join host-dir "link.bl")}
   {:module :"Elixir.BeamLisp.Tiers"
    :source (Path/join host-dir "tiers.bl")}
   {:module :"Elixir.BeamLisp.Delay"
    :source (Path/join host-dir "delay.bl")
    :struct-fields (list (tuple :seq nil))}
   {:module :"Elixir.BeamLisp.Deferred"
    :source (Path/join host-dir "deferred.bl")}
   {:module :"Elixir.BeamLisp.Derived"
    :source (Path/join host-dir "derived.bl")
    :struct-fields (list (tuple :cell nil) (tuple :deps nil) (tuple :thunk nil))}
   {:module :"Elixir.BeamLisp.Reactive"
    :source (Path/join host-dir "reactive.bl")}
   {:module :"Elixir.BeamLisp.Set"
    :source (Path/join host-dir "set.bl")
    :struct-fields (list (tuple :members nil))}
   {:module :"Elixir.Enumerable.BeamLisp.Set"
    :source (Path/join host-dir "set_enumerable.bl")}
   {:module :"Elixir.BeamLisp.SeqCursor"
    :source (Path/join host-dir "seq_cursor.bl")
    :struct-fields (list (tuple :chunk (list)) (tuple :tail nil) (tuple :dirty false))}
   {:module :"Elixir.Enumerable.BeamLisp.SeqCursor"
    :source (Path/join host-dir "seq_cursor_enumerable.bl")}
   {:module :"Elixir.BeamLisp.WebSocket"
    :source (Path/join host-dir "web_socket.bl")
    :behaviour :"Elixir.WebSock"}
   {:module :"Elixir.BeamLisp.Meta"
    :source (Path/join host-dir "meta.bl")}
   {:module :"Elixir.BeamLisp.FormMeta"
    :source (Path/join host-dir "form_meta.bl")}
   {:module :"Elixir.BeamLisp.Num"
    :source (Path/join host-dir "num.bl")}
   {:module :"Elixir.BeamLisp.Application"
    :source (Path/join host-dir "application.bl")
    :behaviour :"Elixir.Application"}])

(defn host-beam
  "The seed beam filename a host mapping entry compiles to."
  [entry]
  (str (:module entry) ".beam"))

(defn host-names
  "The pinned host beams' filenames, in the mapping's own order. This is what the
   manifest records under `\"hosts\"`: an EXPLICIT inventory, so a consumer
   (`Bootstrap.install!/1`, `Bootstrap.install_hosts!/1`, `bin/bl-stage-hosts`)
   selects host beams by the LIST rather than by a name prefix.

   A prefix rule cannot name a pinned leaf outside `Elixir.BeamLisp.*` —
   `Elixir.Enumerable.BeamLisp.Set`, the protocol-impl module compiled beside a
   host source, is the case that forced the table to carry its inventory as data.
   Order is the TABLE's: an inventory a reader compares against the mapping must
   be reproducible, not a map's iteration order."
  [hosts]
  (to-list (map (fn [e] (host-beam e)) hosts)))

(defn host-provenance
  "The `bl_source_hash` a pinned host beam carries, read WITHOUT loading it —
   the attribute chunk, exactly the read `Bootstrap.stamped_key/1` does for
   `bl_compiler_key`. Returns `{:ok hash}` or `{:error why}`.

   Loading is not an option: the beam's module is a LIVE host leaf in the VM
   doing the check, and `code/load_binary` would replace it — the one thing the
   pinned path exists to avoid. The attribute is the beam's own claim about the
   source it was built from, so the reader judges the claim, never runs it."
  [path]
  (try
    (let [r (erlang/apply :beam_lib :chunks
                          (list (erlang/binary_to_list path) (list :attributes)))]
      (if (and (tuple? r) (= :ok (erlang/element 1 r)))
        (let [pair (erlang/element 2 r)
              chunks (erlang/element 2 pair)
              attrs (erlang/element 2 (erlang/hd chunks))]
          (loop [as attrs]
            (cond
              (empty? as) {:error "the beam carries no source hash"}
              (= :bl_source_hash (erlang/element 1 (first as)))
              {:ok (as-text (erlang/element 2 (first as)))}
              :else (recur (rest as)))))
        {:error (str "cannot read the beam's attributes: " (pr-str r))}))
    (catch e {:error (str "cannot read the beam's attributes: " (or (ex-message e) (pr-str e)))})))

(defn- host-opts
  "The Elixir keyword opts `BeamLisp.AOT/compile_host_file` compiles one host
   entry under: the module, the scratch output dir, the source file, its source
   hash and `load? false` — the ISOLATED build every pinned leaf needs. Two
   optional keys WIDEN that base, both forwarded GENERICALLY and only when the
   mapping declares them: `:struct-fields` (a `[{field default}]` list) becomes
   the Elixir `:struct_fields` opt — the one that widens the pinned module with
   the `defstruct` constructor/introspection surface — and `:behaviour` (a
   module atom) becomes the `:behaviour` opt recorded as `-behaviour(Mod)`. An
   entry WITHOUT either key produces exactly the option list it did before —
   same elements, same order — so a functions-only pinned beam stays
   byte-identical, and a struct-only entry keeps its `:struct_fields` tail
   unchanged. When both are present `:struct_fields` precedes `:behaviour`."
  [entry dir source-hash]
  (let [base (list (erlang/list_to_tuple (list :module (:module entry)))
                   (erlang/list_to_tuple (list :output_dir dir))
                   (erlang/list_to_tuple (list :file (:source entry)))
                   (erlang/list_to_tuple (list :source_hash source-hash))
                   ;; NEVER load a host leaf into the generator: CompilerData is a
                   ;; live module in this VM, and the pinned beam exists for the
                   ;; NEXT boot, not this one.
                   (erlang/list_to_tuple (list :load? false)))
        optional (cond
                   (and (some? (:struct-fields entry)) (some? (:behaviour entry)))
                   (list (erlang/list_to_tuple (list :struct_fields (:struct-fields entry)))
                         (erlang/list_to_tuple (list :behaviour (:behaviour entry))))

                   (some? (:struct-fields entry))
                   (list (erlang/list_to_tuple (list :struct_fields (:struct-fields entry))))

                   (some? (:behaviour entry))
                   (list (erlang/list_to_tuple (list :behaviour (:behaviour entry))))

                   :else nil)]
    ;; `erlang/++`, not `concat`: a bl list is a List struct, and the option
    ;; list must BE an Erlang list of 2-tuples for `Keyword` to read it.
    (if (some? optional) (erlang/++ base optional) base)))

(defn- compile-host
  "Compile ONE pinned host source into `dir` with `load? false`, then VERIFY its
   byte provenance: the emitted beam's `bl_source_hash` must equal the digest of
   the source just compiled. Returns
   `{:ok {:name :path :source :source-hash :sha}}` or `{:error why}`."
  [entry dir]
  (let [source (:source entry)
        name (host-beam entry)]
    (cond
      (not (File/exists? source))
      {:error (str source ": no such pinned host source")}

      :else
      (let [source-hash (d/sha256-hex-of source 0 (d/file-size source))]
        (try
          (BeamLisp.AOT/compile_host_file source (host-opts entry dir source-hash))
          (let [path (Path/join dir name)]
            (cond
              (not (File/exists? path))
              {:error (str name ": the pinned compile wrote no beam")}

              :else
              (let [got (host-provenance path)]
                (cond
                  (:error got) {:error (str name ": " (:error got))}

                  (not= source-hash (:ok got))
                  {:error (str name ": stamped with source "
                               (subs (as-text (:ok got)) 0 12) "… but built from "
                               (subs source-hash 0 12) "…")}

                  :else
                  {:ok {:name name :path path :source source
                        :source-hash source-hash
                        :sha (d/sha256-hex-of path 0 (d/file-size path))}}))))
          (catch e
            {:error (str name ": pinned compile failed: " (or (ex-message e) (pr-str e)))}))))))

(defn- compile-hosts
  "Compile every pinned host source into `dir`. The WHOLE set is compiled (and
   each beam's provenance verified) before any of it is used, so a failure here
   leaves the floor exactly where it was — the same safety order the shim refusal
   keeps. Returns `{:ok? true :beams [...]}` or `{:ok? false :errors [...]}`."
  [entries dir]
  (let [results (map (fn [e] (compile-host e dir)) entries)
        errors (vec (keep (fn [r] (:error r)) results))]
    (if (empty? errors)
      {:ok? true :beams (vec (map (fn [r] (:ok r)) results))}
      {:ok? false :errors errors})))

(defn- host-rows
  "The pinned host floor as JUDGEABLE rows, in the same shape `moved/2` gives
   for shims so one refusal printer serves both: what the beam says it was built
   from (`:stamped`) versus what the tree's source hashes now (`:live`). A beam
   that is absent, or carries no hash, is reported and BLOCKS — there is no
   action-only host source, so every missing or unjudged one is drift."
  [out hosts]
  (map (fn [entry]
         (let [beam (Path/join out (host-beam entry))
               name (str (:module entry))
               live (try (d/sha256-hex-of (:source entry) 0 (d/file-size (:source entry)))
                         (catch e (str "unresolved: " (or (ex-message e) (pr-str e)))))]
           (if-not (File/exists? beam)
             {:ns name :beam (Path/basename beam) :stamped nil :live live :verdict :moved}
             (let [got (host-provenance beam)]
               (cond
                 (:error got)
                 {:ns name :beam (Path/basename beam) :stamped nil :live live :verdict :unjudged}

                 :else
                 {:ns name :beam (Path/basename beam) :stamped (:ok got) :live live
                  :verdict (if (= (:ok got) live) :current :moved)})))))
       hosts))

(defn- stale-why
  "Why `name` must not be seeded, or nil when it may: only a SHIM is stamped, and
   the key it carries must be the one this toolchain writes for its namespace."
  [name ebin compiler-key build-key]
  (if (not (shim? name))
    nil
    (let [want (expected-key (ns-of name) compiler-key build-key)
          got (stamp (Path/join ebin name))]
      (cond
        (= (:key (:ok got)) want) nil
        (some? (:error got)) (str name ": " (:error got))
        :else (str name ": built under " (subs (:key (:ok got)) 0 16)
                   "…, this toolchain writes " (subs want 0 16) "…")))))

(defn- moved
  "Which of `nss` no longer match the source they were seeded from — the
   incremental question, answered per namespace.

   `[{:ns :beam :stamped :live :verdict}]`, where the verdict is `:moved` (the two
   hashes differ), `:current` (they agree), or `:unjudged` (the beam carries no
   source hash, so there is nothing to compare and the answer must NOT be read as
   agreement). Nothing is written and nothing is compiled: the beam already holds
   one side of the comparison and the language already computes the other."
  [out nss]
  (map (fn [ns]
         (let [beam (Path/join out (beam-of (str "Ns." ns)))
               ;; The row is keyed by the NAMESPACE — lowercased and hyphenated —
               ;; not by the CamelCase the beam FILENAME carries. `namespaces/1`
               ;; answers filenames (it feeds `beam-of`), while
               ;; `ns_closure_hash` is asked for a namespace, and `ns-of` is the
               ;; same routing the emitter and the tier table use. Without this
               ;; the hash came back unresolved for every row and the check
               ;; reported the whole floor as moved (measured).
               name (ns-of (beam-of (str "Ns." ns)))
               p (stamp beam)
               live (try (BeamLisp.AOT/ns_closure_hash name)
                         (catch e (str "unresolved: " (or (ex-message e) (pr-str e)))))]
           (cond
             ;; An ACTION-ONLY namespace (a body of pure registrations, e.g.
             ;; `data-readers`) emits no `Ns.<X>` shim at all, so the floor never
             ;; carried a beam to judge. That is NOT an unjudged beam — there is
             ;; nothing that could be stale — so it must not make the floor STALE.
             ;; `:absent` is a distinct, reported fact: not applicable, not agreement.
             (not (File/exists? beam))
             {:ns name :beam (Path/basename beam) :stamped nil :live live
              :verdict :absent}

             (:ok p)
             (let [h (:hash (:ok p))]
               {:ns name :beam (Path/basename beam) :stamped h :live live
                :verdict (if (= h live) :current :moved)})

             :else
             {:ns name :beam (Path/basename beam) :stamped nil :live live
              :verdict :unjudged})))
       nss))

(defn moved-lines
  "The `:moved` rows as the lines a refusal prints: the namespace, then the two
   hashes. Twelve characters tells two closures apart and stays readable; the full
   value is in the manifest when someone needs it."
  [rows]
  (map (fn [r]
         (str "  " (:ns r) ": seeded from "
              (if (string? (:stamped r)) (subs (:stamped r) 0 12) "<none>")
              "…, the tree's source hashes "
              (if (string? (:live r)) (subs (:live r) 0 12) "<none>")
              "… — rebuilt by `bl build`, republished by `bl seed`"))
       rows))

(defn check
  "Is the committed floor CURRENT, and if not, WHAT moved? Reads the floor's shim
   beams and the tree's live source closures; writes nothing, compiles nothing.

   This is the question a pre-commit gate asks, and it is cheap for one reason: both
   sides of the comparison already exist. A beam carries the source closure it was
   emitted from (`stamp/1`) and the language computes the same closure from the tree
   (`ns_closure_hash`), so `check` never builds anything in order to decide whether
   a build is needed.

   The PINNED HOST floor is judged by the same idea, on its own evidence: a host
   beam carries `bl_source_hash` — the digest of the source it was built from —
   read from the attribute chunk WITHOUT loading the module, and the live
   `priv/host/*.bl` is hashed to compare against it. A host source that changed is
   `:moved` exactly like a boot shim that moved, and unlike `:absent` shims there
   is no host case that may be skipped: a missing or unjudged host beam BLOCKS.

   Returns `{:ok? :current :moved :unjudged :absent :namespaces :compiler-key
     :build-key :errors}`. `:ok?` is true when every namespace that emits a stamped
     shim is `:current`; a beam that exists but cannot be judged (`:unjudged`) is
     REPORTED and blocks, never silently counted as agreement, while a namespace
     that emits NO shim at all (`:absent`, e.g. the action-only `data-readers`) is
     reported but does not block — there is no beam that could be stale."
  [opts]
  (let [root (or (:root opts) (BeamLisp/cwd))
        boot (under root (or (:boot opts) default-boot))
        out (under root (or (:out opts) default-out))
        host-dir (under root (or (:host opts) default-host))
        nss (namespaces boot)
        hosts (host-sources host-dir)]
    (cond
      (empty? nss)
      {:ok? false :errors [(str "no boot sources under " boot)]}

      (not (File/exists? (Path/join out "manifest.exs")))
      {:ok? false :errors [(str "no floor at " out " — there is nothing to check")]}

      :else
      (let [rows (vec (concat (moved out nss) (host-rows out hosts)))
            gone (vec (filter (fn [r] (= :moved (:verdict r))) rows))
            unjudged (vec (map (fn [r] (:ns r))
                               (filter (fn [r] (= :unjudged (:verdict r))) rows)))
            absent (vec (map (fn [r] (:ns r))
                             (filter (fn [r] (= :absent (:verdict r))) rows)))]
        {:ok? (and (empty? gone) (empty? unjudged))
         :current (vec (map (fn [r] (:ns r))
                            (filter (fn [r] (= :current (:verdict r))) rows)))
         :moved gone
         :unjudged unjudged
         :absent absent
         :namespaces (+ (count nss) (count hosts))
         :compiler-key (BeamLisp.AOTCache/current_compiler_key)
         :build-key (BeamLisp.AOTCache/current_build_key)
         :errors []}))))

(defn- manifest-text
  "The manifest as it is written: the header, then the map as pretty-printed
   Elixir data. Text because the readers are other programs — `Bootstrap` reads
   the keys, a person reads the file — and data because a manifest nobody can
   read is not evidence."
  [m]
  (str "# beam-lisp bootstrap seed manifest — generated, do not edit by hand.\n"
       "# Regenerate: bl seed (after a keyed build).\n"
       (Kernel/inspect m (list (erlang/list_to_tuple (list :pretty true))
                               (erlang/list_to_tuple (list :limit :infinity))))
       "\n"))

(defn run
  "Regenerate the bootstrap floor. Every shim beam is loaded and asked for its
   provenance stamp BEFORE anything is written or deleted, because a generator
   that clears the floor and then discovers the new beams are foreign has
   destroyed the floor. Returns
   `{:ok? :out :ebin :compiler-key :build-key :modules :namespaces :errors}`.

   The floor has TWO kinds of beam and they are produced differently: the boot
   SHIMS are copied from the build's ebin (the compiler emitted them), while the
   pinned HOST beams are COMPILED here from `priv/host/*.bl` by
   `BeamLisp.AOT/compile-host-file` with `load? false` — into a scratch ebin, so
   the live module in this VM is never substituted, and each beam is refused
   unless its `bl_source_hash` proves it came from the source beside it. Both
   sets are verified before the floor is cleared, and both enter the manifest."
  [opts]
  (let [root (or (:root opts) (BeamLisp/cwd))
        boot (under root (or (:boot opts) default-boot))
        out (under root (or (:out opts) default-out))
        ebin (under root (or (:ebin opts) (default-ebin)))
        nss (namespaces boot)
        wanted (vec (filter (fn [n] (File/exists? (Path/join ebin n)))
                            (mapcat (fn [ns] (map beam-of (variants ns))) nss)))]
    (cond
      (empty? nss)
      {:ok? false :errors [(str "no boot sources under " boot)]}

      (empty? wanted)
      {:ok? false :errors [(str "no boot-closure beams in " ebin
                                " — build the boot tier first, or pass --ebin DIR")]}

      :else
      (let [compiler-key (BeamLisp.AOTCache/current_compiler_key)
            build-key (BeamLisp.AOTCache/current_build_key)
            stale (keep (fn [name] (stale-why name ebin compiler-key build-key))
                        wanted)
            host-dir (under root (or (:host opts) default-host))
            hosts (host-sources host-dir)
            scratch (Path/join (System/tmp_dir)
                               (str "bl-seed-host-" (erlang/unique_integer (list :positive))))]
        (if-not (empty? stale)
          {:ok? false :errors (concat [(str "refusing to seed a stale floor — " ebin
                                            " holds beams this toolchain did not build")]
                                      stale
                                      ;; WHICH SOURCES MOVED, not just which beams
                                      ;; refused. A beam named by filename does not
                                      ;; tell a reader what to edit; this does — the
                                      ;; part of the tree that is ahead of the floor,
                                      ;; in the tree's own terms.
                                      (moved-lines
                                        (filter (fn [r] (= :moved (:verdict r)))
                                                (moved out nss))))}
          (let [hc (compile-hosts hosts scratch)
                beams (:beams hc)]
            (try
              (if-not (:ok? hc)
                {:ok? false :errors (:errors hc)}
                (do
                  (File/mkdir_p! out)
                  (doseq [p (Path/wildcard (Path/join out "*.beam"))] (File/rm! p))
                  (doseq [name wanted]
                    (File/cp! (Path/join ebin name) (Path/join out name)))
                  ;; The pinned host beams were COMPILED, not copied, so they come
                  ;; from the scratch ebin the provenance check just judged — never
                  ;; from the build's ebin, which holds the Elixir host leaf this
                  ;; floor replaces.
                  (doseq [b beams]
                    (File/cp! (:path b) (Path/join out (:name b))))
                  (let [entries (reduce (fn [m name]
                                          (let [p (Path/join out name)]
                                            (assoc m name (d/sha256-hex-of p 0 (d/file-size p)))))
                                        {} (concat wanted (map (fn [b] (:name b)) beams)))
                  ; THE APP RESOURCE IS PART OF THE FLOOR, for the same reason the
                  ; compiler beams are: the first command in a fresh clone must
                  ; START an application, and OTP reads what to start — and with
                  ; which callback — from `<name>.app`. Without it a Mix-free
                  ; checkout compiles its substrate and then dies with
                  ; `{:error, {:beam_lisp, {~c"no such file or directory", ~c"beam_lisp.app"}}}`.
                  ;
                  ; Written from the PROJECT VALUE the caller passes (`:app`,
                  ; derived by `app-resource/of-project` from env.bl), never from
                  ; the machine that generates the seed. The module list is
                  ; deliberately empty: what got compiled is a BUILD output, and
                  ; a floor whose `.app` named its generator's modules would be a
                  ; lie about every tree that installs it.
                  aw (if (some? (:app opts))
                       (let [a (:app opts)]
                         (ar/write! (Path/join out (str (:name a) ".app"))
                                    (:name a) (:vsn a) (list) (:applications a) (:mod a)))
                       nil)
                  manifest (-> {}
                               (assoc "schema" schema)
                               (assoc "compiler_key" compiler-key)
                               (assoc "build_key" build-key)
                               (assoc "elixir" (System/version))
                               (assoc "otp" (as-text (erlang/system_info :otp_release)))
                               (assoc "app" (if (and (some? aw) (:ok? aw))
                                              {"file" (Path/basename (:path aw))
                                               "sha256" (d/sha256-hex-of (:path aw) 0 (d/file-size (:path aw)))}
                                              nil))
                               (assoc "modules" entries)
                               ;; The pinned host inventory AS DATA. A consumer
                               ;; selects host beams from THIS list, not from a
                               ;; name prefix, so a pinned leaf outside
                               ;; `Elixir.BeamLisp.*` (`Elixir.Enumerable.BeamLisp.Set`)
                               ;; can be named. `host-names` is the mapping's
                               ;; filenames in table order, so the list is the
                               ;; table a reader can compare it to.
                               (assoc "hosts" (host-names hosts)))]
              ;; The keys were read before the copy and the manifest is written
              ;; after it: a toolchain that changed under this run would publish
              ;; a manifest whose key describes a build that no longer exists.
              (if (or (not= (BeamLisp.AOTCache/current_compiler_key) compiler-key)
                      (not= (BeamLisp.AOTCache/current_build_key) build-key))
                {:ok? false :errors ["the toolchain's sources changed during seed assembly; refusing to publish its manifest"]}
                ; A floor with an app resource that cannot be written is a floor
                ; with a hole in it — REFUSED, like a stale beam, not published.
                (if (and (some? (:app opts)) (not (:ok? aw)))
                  {:ok? false :errors [(str "the project's :app cannot be written: " (:why aw))]}
                  (do
                    ;; Atomic: a concurrent `bl` run's `install!` may be reading
                    ;; this floor, and a torn manifest is a floor nobody can
                    ;; judge. Sibling temp + rename, as everywhere else here.
                    (let [mp (Path/join out "manifest.exs")
                          tmp (str mp ".tmp-" (erlang/apply :os :getpid (list)))]
                      (File/write! tmp (manifest-text manifest))
                      (File/rename! tmp mp))
                    {:ok? true :out out :ebin ebin
                     :compiler-key compiler-key :build-key build-key
                     :app (if (some? aw) (Path/basename (:path aw)) nil)
                     :modules (count entries) :namespaces (vec nss) :errors []}))))))
              (finally (File/rm_rf! scratch)))))))))
