; build/seed.bl — the bootstrap floor, regenerated by the toolchain itself.
;
; `priv/bootstrap/seed/` is the checked-in bootstrap floor: the compiled
; Core-Erlang beams of the BOOT PRELUDE (`priv/boot/*.bl`), so a tree with no
; generation behind it loads the whole compiler from bytes and then compiles
; everything else with it. Seeding that closed set is what breaks every
; bootstrap loop. The manifest beside the beams records the tier keys they were
; built under and a sha256 per beam, so the floor can be JUDGED rather than
; trusted.
;
; This file is that generator, and it was `mix run priv/bootstrap/gen_manifest.exs`
; for exactly one reason: Mix knew where the compiled beams were. Where the
; beams are is not a fact about the floor — and a generator that cannot run
; without the thing the floor exists to replace is the circle this whole
; programme is about. The rules are unchanged, and so is the evidence: every
; shim beam is LOADED and asked for its provenance stamp, and a beam built under
; a different key is refused rather than published. A seed whose manifest key and
; beam stamps disagree is a lie that crashes genesis-less boots CIRCULARLY — the
; drift gate reads a beam's key, finds it foreign, and routes the namespace to
; the source path, which needs that very namespace.
;
;   bl seed [--out DIR] [--ebin DIR]
;
; The BUILD DRIVER (`priv/build/`) is deliberately not seeded. Codegen floored
; from a previous generation is a bootstrap; a driver floored from a previous
; generation is a MIXED TOOLCHAIN — the caller depends on the current contract,
; and staged driver bytes would outlive the source they were written from. The
; driver is read or compiled from the current tree, always. `multi` is not a tier
; file (it is a prelude layer loaded by init) but the compiler needs it too, so
; the closure includes it.

(ns seed
  (:require [drop :as d] [app-resource :as ar]))

(def schema "beam-lisp-bootstrap-seed-v2")

(def default-boot "priv/boot")
(def default-out "priv/bootstrap/seed")
(def default-host "priv/host")

(defn- as-text
  "An Erlang string (a charlist) as a binary."
  [x]
  (if (string? x) x (erlang/list_to_binary x)))

(defn- split-path
  "The path as its segments. `Path/join` in the runtime's Elixir joins the parts
   it is given and does NOT let a later absolute part win, so a caller's absolute
   argument must be used whole rather than joined onto a default."
  [p]
  (String/split p "/"))

(defn- absolute?
  "Whether `p` is absolute — the CLI resolves its paths, a test may not."
  [p]
  (= "" (first (split-path p))))

(defn- under
  "`p` resolved against `root` only when it is relative."
  [root p]
  (if (absolute? p) p (Path/join root p)))

(defn default-ebin
  "Where the compiled boot beams are when nobody said: `BL_SEED_EBIN`, else the
   layout BOTH toolchains write — `_build/<env>/lib/beam_lisp/ebin`. Mix reached
   it through `Mix.Project.compile_path/0`; the convention is the same path, so
   the second toolchain does not need the first to find its own beams."
  []
  (or (System/get_env "BL_SEED_EBIN")
      (System/get_env "BL_SEED_EBIN_FALLBACK")
      ;; Built with `str`, not `Path/join`: that function takes an Erlang list and a
      ;; bl vector is a struct, so the vector form dies with "no function clause
      ;; matches" the moment this default is the one that runs (measured — the
      ;; `--ebin` runs never touched it).
      (str "_build/" (or (System/get_env "MIX_ENV") "dev") "/lib/beam_lisp/ebin")))

(defn namespaces
  "The namespaces the floor must contain: every `BOOT/*.bl` (the compiler, the
   reader, the prelude the compiler resolves its vars against, the tagged-literal
   registry, the Core-Erlang backend) plus `multi`."
  [boot-dir]
  (distinct (concat (map (fn [p] (Macro/camelize (Path/basename p ".bl")))
                         (Path/wildcard (Path/join boot-dir "*.bl")))
                    ["Multi"])))

(defn variants
  "The three beams one namespace is emitted as: the shim (`Ns.X`, the only one
   carrying `__bl_provenance__/0`), the body, and the init companion."
  [ns]
  [(str "Ns." ns) (str "Ns.Body." ns) (str "Ns.Init." ns)])

(defn beam-of [variant] (str "Elixir.BeamLisp." variant ".beam"))

(defn ns-of
  "The namespace a shim beam BELONGS to, from its filename: `Ns.Reader-node` →
   `reader-node`. The tier of a beam is a property of its namespace, and this is
   the same routing the emitter and `AOTCache.key_for_ns/1` use, so a beam's
   stamp and the check below cannot disagree about which tier it is in."
  [name]
  (let [base (String/replace_prefix (Path/basename name ".beam") "Elixir.BeamLisp.Ns." "")]
    (join "-" (map (fn [s] (Macro/underscore s)) (String/split base "-")))))

(defn shim?
  "Whether a beam is a namespace's SHIM rather than one of its companions. Only
   the shims are stamped, so only they can be asked what built them."
  [name]
  (let [base (Path/basename name ".beam")]
    (not (or (includes? base ".Body.") (includes? base ".Init.")))))

(defn expected-key
  "The tier key a namespace's beams must carry: the driver's key for a
   `priv/build/` namespace, the codegen key for everything else."
  [ns compiler-key build-key]
  (if (= :build (BeamLisp.Tiers/tier_of_ns ns)) build-key compiler-key))

(defn stamp
  "What a beam says built it: `{:ok {:hash h :key k}}` when it answered,
   `{:error why}` when it could not. Those are DIFFERENT FACTS and the caller must
   be able to tell them apart — a beam that answers with a foreign key is evidence
   about a toolchain, while a beam that cannot be loaded at all is evidence about a
   file. Collapsing the second into the first is how a generator reports that a
   beam is not one of ours about a beam that is one of ours and says so (measured:
   `binary/to_list` does not exist, and the catch turned that into `built under no
   key`).

   Both halves are needed and for different questions: the KEY is the beam's
   generation (what `stale-why/5` judges), and the HASH is the source closure it was
   emitted from — the same `ns_closure_hash` the language computes from the live
   tree. Together they make the floor JUDGEABLE rather than trusted, and both are
   already IN the beam, so judging costs no new state.

   The key is read by LOADING the beam: a stale beam answers this question
   wrongly, which is exactly what there is to catch. The module is purged first,
   so the file on disk — not a loaded copy — answers."
  [path]
  (try
    (let [mod (String/to_atom (Path/basename path ".beam"))
          bytes (File/read! path)]
      (code/purge mod)
      (code/delete mod)
      (let [loaded (code/load_binary mod (erlang/binary_to_list "seed") bytes)]
        (if (and (tuple? loaded) (= :module (erlang/element 1 loaded)))
          (let [st (erlang/apply mod :__bl_provenance__ (list))]
            (if (tuple? st)
              (let [h (as-text (erlang/element 1 st))
                    k (as-text (erlang/element 2 st))]
                ;; A key with no source hash is a beam nothing can compare against:
                ;; the emitter resolves the closure at emit time and answers nil when
                ;; the namespace's source is not on its search path (measured on
                ;; `data-readers` and `multi`). Naming it is what keeps `check` from
                ;; reading that nil as agreement.
                (if (empty? h)
                  {:error "the beam carries a key but no source hash"}
                  {:ok {:hash h :key k}}))
              {:error "the beam carries no provenance stamp"}))
          {:error (str "cannot load the beam: " (pr-str loaded))})))
    (catch e {:error (str "cannot load the beam: " (or (ex-message e) (pr-str e)))})))

;; ── the pinned HOST floor ───────────────────────────────────────────────────
;
; The boot shims above are COPIED from a build's ebin: the compiler emits them
; and the seed publishes them. A pinned HOST module is different — it is
; COMPILED here, from checked-in source, by the very artefact the floor exists
; to make replaceable (`BeamLisp.AOT/compile-host-file`). That is the whole
; point of the migration: a host leaf stops needing an Elixir `.ex` to exist at
; boot, while the compiler that compiles it still comes from the floor beneath.
;
; Three properties keep that safe, and each is why a function below exists:
;   * the mapping is EXPLICIT — which module a source becomes is written down;
;   * compilation is ISOLATED — into a scratch ebin, `load? false`, so a pinned
;     leaf (CompilerData is live in this VM) is never substituted mid-run;
;   * the bytes are JUDGED — the beam carries the digest of the source it was
;     built from, and `run` refuses one whose stamp disagrees with the source.

(defn host-sources
  "The pinned HOST modules the floor carries: each a checked-in `.bl` source and
   the EXACT `Elixir.BeamLisp.X` module it is compiled to. A table, not a
   directory sweep: which module a source becomes is a decision, and a sweep
   could not tell a pinned leaf from a stray file.

   `:module` is an atom because the emitter takes an atom (a string is never
   turned into one on that path); the beam filename is derived from it.

   Fifty-seven leaves now. The first four are the compiler's own substrate.
   `CompilerData` and the `Emit`/`Link` pair are seeded TOGETHER on purpose:
   `Emit` builds every descriptor and the `Link` pinned beside it CALLS `Emit`,
   so a floor carrying one without the other would straddle the boundary the pin
   exists to close. `Tiers` joins them because it is the tier AUTHORITY:
   `AOTCache` asks it where the codegen sources live and which tier a namespace
   belongs to, so an edit to it must rotate the codegen key — and once `tiers.ex`
   is deleted this beam is the only copy of the module a boot has. Table order is
   not install order: the whole table is compiled before any of it is used, and
   `Bootstrap.install_hosts!/1` loads the authority first (see there).

   `Delay` and `Deferred` are the deferred-computation pair: `Deferred` builds
   and forces the value-shaped face, `Delay` is the struct cell it wraps, so they
   are seeded together like `Emit`/`Link`. `Delay` carries `:struct-fields
   [{:seq nil}]` — the ONE thing that makes its pinned beam a struct module
   rather than a functions-only one — which `compile-host` forwards to
   `compile-host-file` as the Elixir `:struct_fields` opt. A source edit is
   caught by the per-host `bl_source_hash` (no codegen key rotation), so the
   pair needs no entry in the codegen key table.

   `Derived` and `Reactive` are the second deferred-computation pair, seeded
   together like `Emit`/`Link`: `Reactive`'s `derive` builds a `Derived` and
   `Derived` is the struct cell holding the memo, deps and thunk, so a `derive`
   whose value type is absent names a struct no boot can recognize.

   `Set` and `SetEnumerable` are the collection pair, and the one whose impl
   lives OUTSIDE `Elixir.BeamLisp.*`: `Set` is the pinned struct (`:members`)
   and `SetEnumerable` is the `Enumerable` protocol impl compiled beside it as
   `Elixir.Enumerable.BeamLisp.Set`. That second name is the case a name-prefix
   rule could not reach, which is why `host-names` records the inventory as
   data; it is listed AFTER `Set` so the type is on the code path before its
   impl. Four of the collection/deferred entries carry `:struct-fields` (`Delay`
   `[{:seq nil}]`, `Derived` `[{:cell nil} {:deps nil} {:thunk nil}]`, `Set`
   `[{:members nil}]`, `SeqCursor` `[{:chunk []} {:tail nil} {:dirty false}]`);
   the `Vector` and `LazySeq` types seeded below — and every exception type —
   carry them too, and every OTHER entry is functions-only and produces exactly
   the option list it did before.

   `SeqCursor` and `SeqCursorEnumerable` are the streaming pair, seeded together
   the way `Set`/`SetEnumerable` are: `SeqCursor` is the pinned struct whose
   `:chunk` copies the one small piece of an eager input onto the BEAM heap, and
   `SeqCursorEnumerable` is its `Enumerable` protocol impl compiled beside it as
   `Elixir.Enumerable.BeamLisp.SeqCursor` — the second pinned leaf outside
   `Elixir.BeamLisp.*`, listed AFTER `SeqCursor` so the type is on the code path
   before its impl. `SeqCursor`'s `:chunk` default is the RAW Erlang empty list,
   never a bl vector: the walk reads it with `hd`/`tl`, so a `BeamLisp.Vector`
   would be the wrong shape.

   `WebSocket` is the WebSock behaviour module. A websocket handler must BE a
   module implementing the `WebSock` behaviour, so its pinned entry carries
   `:behaviour` (the `Elixir.WebSock` atom), forwarded to `compile-host-file` as
   the Elixir `:behaviour` option and recorded as the beam's `-behaviour`
   attribute.

   `Meta` and `FormMeta` are the metadata pair, seeded together like
   `Emit`/`Link`: `FormMeta` carries metadata on FORM DATA and DELEGATES its one
   runtime value type (a lazy seq) to `BeamLisp.Meta`, so `Meta` is listed
   BEFORE `FormMeta` — the delegate stands beside the thing it delegates to.
   `Num` is the numeric tower's seam: the language links `+ - * / < > <= >= ==`
   straight into it (rt.bl's operator table), and it is called from the BOOT
   tier, so its pinned beam must be installed before the boot namespaces are
   interned — which is exactly what `install_hosts!/1` does. All three are
   functions-only: no `:struct-fields`, no `:behaviour`.

   `Application` is the OTP application callback `env.bl`'s `:mod` entry names
   (`{:mod, {'Elixir.BeamLisp.Application', []}}`), so `Application.ensure_all_started(:beam_lisp)`
   calls `start(:normal, [])` on its pinned beam. Its entry carries `:behaviour`
   (the `Elixir.Application` atom), forwarded to `compile-host-file` exactly as
   `WebSocket`'s `Elixir.WebSock` is, so the emitted beam records
   `-behaviour(Application)` and every behaviour reader can judge it as an
   application callback module. It is functions-only — `start/2` and `stop/1`,
   no `:struct-fields`. It is listed LAST after the pinned leaves its `start/2`
   supervises and its `init/0` interns; the whole table is compiled before any of
   it is installed, and `install_hosts!/1` orders the install authority-first by
   name, so the position is documentation, never install order.

   The reader/compiler front doors and their exceptions are the last four.
   `Reader.SyntaxError` and `Reader.AtomLimitError` are the reader's two
   exception types, and they are SHAPE-IDENTICAL, so ONE source
   (`reader_exception.bl`) serves both: the seed points the SAME file at two
   module atoms, each entry carrying the identical pair of compile options —
   `:struct-fields [{:__exception__ true} {:message nil}]` (the `defexception
   [:message]` shape) and `:behaviour` (the `Elixir.Exception` atom, so each beam
   records `-behaviour(Exception)`). A pinned source's
   bytes are hashed per LEAF (`host-provenance`), so the two entries share a
   source hash but compile to two DIFFERENT beams (`Elixir.BeamLisp.Reader.
   SyntaxError.beam` and `...AtomLimitError.beam`); the mapping is a table, not a
   source-keyed set, so neither is deduped. They are listed BEFORE `Reader`
   because the reader raises them at RUNTIME, so their pinned beams must be on
   the code path whenever the reader runs — a floor carrying `Reader` without
   the exceptions it raises would boot a front door whose failures are
   undefined. `Reader` is the host-facing FRONT DOOR to the self-hosted reader
   (`ns reader`), and `Compiler` is the front door to the self-hosted compiler
   (`ns compiler`); both are functions-only — no `:struct-fields`, no
   `:behaviour`. They are named after the boot namespaces they drive, so a boot
   whose Elixir source is gone still has the module a caller types.

   `CompileError` and `ExInfo` are the last two: the core runtime's remaining
   exception types. `CompileError` is what the compiler RAISES when a form
   cannot be compiled; `ExInfo` is the exception `throw` compiles to and `try`'s
   untyped catch binds — the Clojure-shaped payload surface the language's
   `throw`/`ex-info`/`ex-data`/`ex-message`/`ex-original` ride on. Both are
   `defexception` types, so both carry the same pair of compile options as the
   reader's exceptions: `:struct-fields` with `:__exception__ true` FIRST, then
   the declared fields IN DECLARATION ORDER — `[{:__exception__ true} {:message
   nil} {:file nil} {:line nil} {:form nil}]` for `CompileError` (the
   `defexception [:message, :file, :line, :form]` shape) and `[{:__exception__
   true} {:message nil} {:data nil}]` for `ExInfo` (the `defexception [:message,
   :data]` shape) — plus `:behaviour` (the `Elixir.Exception` atom, so each beam
   records `-behaviour(Exception)`). The field order is load-bearing: it is the
   order `__info__(:struct)` reports and therefore the struct's introspection
   surface. Each compiles from its OWN source (`compile_error.bl`, `ex_info.bl`),
   hashed per LEAF, so neither is deduped. They are listed after the front doors:
   the whole table is compiled before any of it is installed, so position is
   documentation, never install order.

   `AtomGuard` and its nested `LimitError`, and `Transient`, are the last three:
   the runtime seams the boot tier samples. `AtomGuard` is the atom-table seam —
   the reader, the compiler and the RT's keyword intern all sample it through
   `to_atom`/`account!`/`check!` before the VM's atom table can fill and abort
   uncatchably — so it is functions-only, and it names no module of its own (the
   `num.bl`/`transient.bl` idiom: the module comes from a fun literal compiled
   into the file). Its exception `LimitError` is a `defexception [:message]`,
   the SAME shape as the reader's two exceptions, so it carries the same pair of
   compile options — `:struct-fields [{:__exception__ true} {:message nil}]` and
   `:behaviour` (the `Elixir.Exception` atom, so its beam records
   `-behaviour(Exception)`) — as the reader's exceptions. It is listed BEFORE
   `AtomGuard` because `check!/1` raises it: the exception the guard throws must
   be registered before the guard can run, and `install_hosts!/1`'s name sort
   already orders `AtomGuard.LimitError` ahead of `AtomGuard`, so the table
   states the dependency the installer guarantees. `Transient` is the transient
   collection view the RT's prims (`transient`/`persistent!`/`conj!`/`assoc!`/
   `dissoc!`/`hash-map`) call; a transient is a TAGGED TUPLE, never a struct, so
   it is functions-only too. It is used after `core` is interned, so no ordering
   constraint pins it to the guard's slot.

   `Vector` and `VectorEnumerable` are the eager collection pair the compiler
   itself builds: a vector literal is a `BeamLisp.Vector` value, so, like `Set`,
   `Vector`'s source is BOOT-SAFE — the compiler and `rt.bl` reach it WHILE the
   boot tier is still being interned, and it depends on no beam-lisp namespace.
   It carries `:struct-fields [{:items {}} {:meta nil}]`: `:items` is the 32-way
   trie or the small tuple that IS the compiler's literal shape, and its default
   is the RAW Erlang empty tuple `{}` — never a bl vector — because the
   small-vector walk reads it directly. `VectorEnumerable` is its `Enumerable`
   protocol impl as `Elixir.Enumerable.BeamLisp.Vector`, listed AFTER `Vector`
   so the type is on the code path before its impl, and it is functions-only.

   `LazySeq.ForceError`, `LazySeq`, `LazySeqEnumerable` and `LazySeqInspect` are
   the lazy-sequence quartet, seeded in that dependency order. `ForceError` is
   the NESTED exception `force/1` raises — a `defexception [:reason, :message]`
   that needs its OWN source, because a pinned file carries functions in exactly
   ONE namespace — so it is listed BEFORE `LazySeq`, which raises it at runtime;
   it carries `:struct-fields [{:__exception__ true} {:reason nil} {:message
   nil}]` with `:__exception__` FIRST and `:behaviour` (the `Elixir.Exception`
   atom, so its beam records `-behaviour(Exception)`), the same pair the reader's
   exceptions carry. `LazySeq` is the pinned struct `:struct-fields [{:resource
   nil} {:metadata nil}]` in declaration order — `:resource` holds the shared
   memo cell and `:metadata` the immutable value-owned metadata.
   `LazySeqEnumerable` and `LazySeqInspect` are its `Enumerable` and `Inspect`
   protocol impls, compiled beside the type as
   `Elixir.Enumerable.BeamLisp.LazySeq` and `Elixir.Inspect.BeamLisp.LazySeq` —
   the second and third pinned leaves outside
   `Elixir.BeamLisp.*` a name-prefix rule could not reach. Both impls are
   functions-only; the `Inspect` impl is what keeps a lazy node's `(1 2 3…)` list
   face instead of the opaque `Inspect.Any` struct map, including inside a test
   failure message.
   `Sorted` is beam-lisp's ORDERED collection pair — `SortedMap` and `SortedSet`
   keyed in the language's `compare` order over OTP's `:gb_trees` — and it is
   the substrate the EAV/datalog index rides on, reached by `rt.bl` while the
   boot tier is still being interned. `Sorted` (`sorted.bl`) is functions-only:
   it BUILDS the two structs by writing the production tag literally, never by
   calling a synthesized `__struct__/1`, because its functions live in a
   DIFFERENT module from the structs they build and `rt.bl` classifies a value
   by the literal atoms. `SortedMap` and `SortedSet` (`sorted_map.bl`,
   `sorted_set.bl`) are the bare `defstruct [:tree]` types, one source per type,
   pinned beside the module that builds them. Each writes its `__struct__/0,1`
   and `__info__/1` BY HAND — and therefore carries NO `:struct-fields` —
   because the two rules leave no other honest shape: a bare `defstruct` has no
   functions at all and `compile-host-file` refuses a source with none, while
   `:struct_fields` refuses to synthesize a surface the module already spells
   out (the collision). So the mapping is functions-only while the published
   beam is STILL a struct module, and the seed test proves it from the beam's
   own export chunk rather than from the options. The three are listed `Sorted`
   first, then its two types: the installer's name sort gives the same order, so
   table order and install order agree for this family.
   `Decimal` and its `Inspect` impl are the exact-decimal pair, seeded together
   the way `Set`/`SetEnumerable` are. `BeamLisp.Decimal` is the pinned struct
   (`:struct-fields [{:unscaled 0} {:scale 0}]`) the BOOT tier reaches — `rt.bl`
   at runtime, `num.bl` from the boot tier, the reader through `parse/1` while
   reading any file — so, like `Vector`, its source is boot-safe. It is the ONE
   entry that declares `:macro-exports`: `[{:is_decimal 1}]` keeps the live
   `defguard is_decimal/1` a `require`-able macro (`__info__(:macros)`) over the
   `MACRO-is_decimal/2` implementer its source carries, which
   `compile_host_file` validates by name before it will advertise the macro.
   `Inspect.BeamLisp.Decimal` (`decimal_inspect.bl`) is its `Inspect` protocol
   impl, compiled beside the type as `Elixir.Inspect.BeamLisp.Decimal` — the
   fourth pinned leaf outside `Elixir.BeamLisp.*` a name-prefix rule could not
   reach — listed AFTER `Decimal` so the type is on the code path before its
   impl, and it is functions-only.

   `Atom`, `Volatile`, `Reduced`, `Promise`, `Future` and `Refs` are the
   reference runtime `refs.ex` declares: its Clojure-shaped `deref`/`swap!`/
   `reset!` surface, and the five bare struct TYPES it builds and reads. The
   five types come from ONE source (`refs_structs.bl`) compiled at five exact
   module atoms — the `reader_exception.bl` idiom, and the second time the table
   maps ENTRIES rather than sources to modules — each entry carrying only the
   `:struct-fields` that name ITS shape: `[{:cell nil} {:watches nil}]` for
   `Atom`, `[{:key nil}]` for `Volatile`, `[{:value nil}]` for `Reduced`,
   `[{:pid nil}]` for `Promise` and `[{:task nil}]` for `Future`. The source's
   shape-agnostic `new/1` reads its own `__info__(:struct)` and folds the given
   values over the synthesized `__struct__/0`, so the same bytes answer five
   correct constructors, and a source path is never deduped: five entries, five
   beams. `Refs` (`refs.bl`) is functions-only — no `:struct-fields`, no
   `:behaviour` — and it is listed after the `Deferred`/`Reactive` pair its
   `deref` DELEGATES to: it builds its five values by the literal tags, so
   nothing here requires a type beam to be loaded first.

   `Loader.Server` (`loader_server.bl`) is APPENDED last, and it is the pinned
   GenServer the OTP application starts as a child BEFORE anything else:
   `BeamLisp.Application`'s supervisor starts it, and `BeamLisp.Loader` routes
   every `:global` library load through it so a load's top-level forms run in
   ONE process and their process-owned state (ETS tables, the process-dictionary
   re-entrancy flag) is bound to the VM rather than to whichever process
   required the library first. Table order is documentation, never install
   order: the whole table is compiled before any of it is installed, and
   `install_hosts!/1`'s name sort gives the same order this append reads. The
   module is functions-only — no `:struct-fields`, no `:macro-exports` — and
   carries `:behaviour` (the `Elixir.GenServer` atom, forwarded to
   `compile-host-file` exactly as `WebSocket`'s `Elixir.WebSock` and
   `Application`'s `Elixir.Application` are), so the emitted beam records
   `-behaviour(GenServer)` and every behaviour reader — OTP included — judges it
   as a GenServer callback module. Because a pinned module's export surface IS
   the file's top-level defns, the source spells out `use GenServer`'s generated
   defaults (`child_spec/1`, `handle_cast/2`, `handle_info/2`, `terminate/2`,
   `code_change/3`) beside the module's own `start_link/1`, `init/1`,
   `in_server?/0`, `run/1` and `handle_call/3`, so the floor beam's export list
   is the live module's exactly.

   `Supervisor` and `Z3Port` are APPENDED after `Loader.Server`, and both are
   FUNCTIONS-ONLY — no `:struct-fields`, no `:behaviour`, no `:macro-exports` —
   so each carries the bare `{:module, :source}` pair and produces exactly the
   option list it did before. `Supervisor` (`supervisor.bl`) is the tree-builder
   `rt.bl`'s `supervise`/`worker` rows bind by VALUE and `priv/std/proc/super.bl`
   calls directly; `BeamLisp.Supervisor` is ALSO the name the OTP application
   registers its top supervisor under, so the atom names a module a running
   application already owns — the mapping changes which beam answers that atom,
   never the registered process name. `Z3Port` (`z3_port.bl`) is the
   subprocess-protocol driver `priv/std/z3pool.bl` drives over a port; because a
   port delivers its answers to the process that OWNS it, the module is
   FUNCTIONS, not a process, and the pool's `defserver` owns the port. Neither is
   reached while the boot tier is interned, so the append needs no ordering
   constraint; `install_hosts!/1`'s name sort places both after `Loader.Server`.

   `Multi` and `Server` are APPENDED after `Z3Port`, and both are
   FUNCTIONS-ONLY — no `:struct-fields`, no `:behaviour`, no `:macro-exports` —
   so each carries the bare `{:module, :source}` pair and produces exactly the
   option list it did before. `Multi` (`multi.bl`) is the runtime engine for
   OPEN DISPATCH: `defmulti`/`defmethod` lower to its `define_multi/3` and
   `add_method/4`, and `defprotocol`/`extend-type`/`deftype` dispatch through
   `type_of/1`, `define_protocol/3`, `extend_type/4`, `dispatch_protocol/4` and
   `satisfies?/3`, all keyed as ordinary rows in `BeamLisp.Env`'s store rather
   than in a struct. `Server` (`server.bl`) is the runtime side of the
   `defserver` special form: `compile-defserver` lowers `(defserver …)` into a
   real `:gen_server` behaviour module and asks `module_for/2` for the generated
   module NAME, `callback/1` and `callback_order/0` for the OTP callback names
   and clause shapes, and `return_constructors/0` for the locals bound in every
   callback body, while `start`/`start_link`/`call`/`cast`/`stop` are the
   client side that wraps `:gen_server`. `Server` needs NO
   `AOTCache.@pinned_host_sources` row: that table exists so a CODEGEN module's
   source keeps feeding the codegen key after its `.ex` is deleted, and
   `BeamLisp.Server` is not a `@codegen_modules` member — the compiler CALLS it,
   it does not compile it. Like `Supervisor`/`Z3Port`, neither is reached while
   the boot tier is interned, so the append needs no ordering constraint;
   `install_hosts!/1`'s name sort places both after `Z3Port`. Each pinned source
   inlines the live module's `defn-` helpers (`multi!`/`no_method_error`/
   `walk_ancestors`/`protocol!` for `Multi`; `convey_arg`/`unwrap`/
   `server_name`/`gen_opts`/`resolve` for `Server`) as LOCAL closures, so its
   published beam's export list is the live module's exactly, minus the
   Elixir-generated `__info__/1`.

   `Guards` and `Record` are APPENDED after `Server`, and they are the two host
   leaves that let the `lib/beam_lisp/record.ex` front door come down.
   `Guards` (`guards.bl`) is FUNCTIONS-ONLY — no `:struct-fields`, no
   `:behaviour` — because the live module is a bag of `defguard`s and one plain
   function; it declares the table's SECOND `:macro-exports` entry,
   `[{:is_bl_map 1} {:is_ref_type 1} {:is_data_tuple 1}]`, the three
   `__info__(:macros)` pairs that keep the guards `require`-able macros over the
   `MACRO-is_bl_map/2` / `MACRO-is_ref_type/2` / `MACRO-is_data_tuple/2`
   implementers its source carries. It is listed BEFORE `Record` because the
   live `record.ex` `import`s `is_bl_map/1` and uses it in a GUARD, so `elixirc`
   must resolve the macro against the pinned beam before it compiles `record.ex`
   — the precompile edge the guard's own test drives; `install_hosts!/1`'s name
   sort already orders `Guards` ahead of `Record`, so the table states the
   dependency the installer guarantees. `Record` (`record.bl`) is FUNCTIONS-ONLY
   too — a record is a synthesized struct MODULE and a deftype a tagged tuple,
   so the factory beam declares no struct of its own — and it is the sole reason
   this wave exists: it is a `@codegen_modules` member, so
   `AOTCache.@pinned_host_sources` must name it or the live codegen digest would
   halt at `:missing` on the deleted `record.ex` and freeze the key on a stale
   baked digest (BUG-106). Table order is documentation, never install order:
   the whole table is compiled before any of it is installed.

   `Trace` and `ReloadWatcher` are APPENDED after `Record`, and both are
   FUNCTIONS-ONLY — no `:struct-fields`, no `:macro-exports` — so each carries
   the bare `{:module, :source}` pair and produces exactly the option list it
   did before. `Trace` (`trace.bl`) is the pinned `BeamLisp.Trace`: the BEAM's
   `:dbg` exposed as data, the module `rt.bl`'s `trace`/`untrace` rows bind by
   name, so any function call in a live system can be traced without
   instrumentation. Its exports are exactly `trace/3`, `trace/4` and
   `untrace/2` — every helper the live module kept private is a LOCAL closure —
   and the tracer is started only when `trace/3` is CALLED, never at host load,
   so the pinned beam is inert until a caller arms it. `ReloadWatcher`
   (`reload_watcher.bl`) is the dev-only live-reload watcher: it turns a `.bl`
   save into a staged edit on the reload bundle and commits it, so editing a
   source file updates the running image coherently with no restart. It is
   FUNCTIONS-ONLY with ONE opt — `:behaviour` (the `Elixir.GenServer` atom,
   forwarded to `compile-host-file` exactly as `Loader.Server`'s is) — so the
   emitted beam records `-behaviour(GenServer)` and OTP judges it as a GenServer
   callback module. Because a pinned module's export surface IS the file's
   top-level defns, the source spells out `use GenServer`'s generated
   `child_spec/1`, `handle_cast/2` and `code_change/3` beside its own
   `start_link/1`, `init/1`, `handle_call/3`, `handle_info/2`, `terminate/2`,
   the process API (`drain/0,1`, `sync/0,1,2`) and the reload seam
   (`apply_change/1,2,3`); its private helpers stay LOCAL closures, so the
   floor beam's export list is the live module's exactly. The linked
   `FileSystem` worker it starts is started only when a watcher is CALLED for —
   never at host load. Neither leaf is a `@codegen_modules` member, so neither
   needs an `AOTCache.@pinned_host_sources` row; table order is documentation,
   never install order: the whole table is compiled before any of it is
   installed.

   `AnfInterpreter`, `Sandbox` and `ExUnitCase` are APPENDED after
   `ReloadWatcher`, and they are the last leaves of the repository Elixir
   surface's TEST harness. `AnfInterpreter` (`anf_interpreter.bl`) is
   FUNCTIONS-ONLY — no `:struct-fields`, no `:behaviour`, no `:macro-exports` —
   so it carries the bare `{:module, :source}` pair and produces exactly the
   option list a functions-only leaf always did. It is the pinned
   `BeamLisp.AnfInterpreter`, the raise model `priv/self/anf.bl`'s reference
   interpreter runs every canonical `:try` through: `capture/1` invokes a thunk
   and answers `{:ok value}` or `{:raised kind reason {:interpreted_trace
   frames}}`, and `reraise/3` re-raises such a tagged trace through the real
   `erlang:raise/3` BIF. Its whole export surface is those TWO functions — the
   oracle ABI — and nothing else. It is TEST-only (the compiled language raises
   through its own `raw_raise`), but it is the oracle the differential ANF test
   compares against, so it is pinned rather than dropped. `Sandbox`
   (`sandbox.bl`) is FUNCTIONS-ONLY too: the test-harness surface that builds a
   warm base env once per VM (`warm!/2`), reads it back (`base!/1`), forks and
   destroys zero-copy children (`checkout/0,1`, `checkin/1`) and evaluates a
   file, a namespace or a source string into the current env (`load_file/1`,
   `load_ns/1`, `eval/1`). Its whole surface is those functions, so it carries
   the bare pair. It is a RUNTIME-tier module — every caller runs after
   `BeamLisp.init/0`, and `warm!/2` calls `init/0` itself — so it may build its
   few tuples and lists with the language's own `(tuple …)`/`(list …)` (i.e.
   `BeamLisp.Ns.Core`), the same runtime-tier trade `ReloadWatcher` makes; it
   is never reached while the boot tier is interned. `ExUnitCase`
   (`ex_unit_case.bl`) is FUNCTIONS-ONLY with ONE opt — `:macro-exports
   [{:__using__ 1}]` — the table's THIRD macro entry: `resolve_base/1` is the
   plain function the `setup_all` expansion calls, and `MACRO-__using__/2` is
   the implementer behind the `use BeamLisp.ExUnitCase, warm: …` a caller's
   test module expands, advertised through `__info__(:macros)` so `use` reads a
   macro rather than an undefined function. The macro must be STAGED before an
   Elixir test file compiles: `bin/bl-stage-hosts` copies every beam the
   manifest's `hosts` list names into the build ebin BEFORE `elixirc` runs, so a
   `use BeamLisp.ExUnitCase` in the Elixir test corpus (`test/**/*_test.exs`)
   resolves against the pinned beam. None of the three is a `@codegen_modules` member,
   so none needs an `AOTCache.@pinned_host_sources` row; table order is
   documentation, never install order: the whole table is compiled before any
   of it is installed."

  [host-dir]
  [{:module :"Elixir.BeamLisp.CompilerData"
    :source (Path/join host-dir "compiler_data.bl")}
   {:module :"Elixir.BeamLisp.Emit"
    :source (Path/join host-dir "emit.bl")}
   {:module :"Elixir.BeamLisp.Link"
    :source (Path/join host-dir "link.bl")}
   {:module :"Elixir.BeamLisp.Tiers"
    :source (Path/join host-dir "tiers.bl")}
   {:module :"Elixir.BeamLisp.Delay"
    :source (Path/join host-dir "delay.bl")
    :struct-fields (list (tuple :seq nil))}
   {:module :"Elixir.BeamLisp.Deferred"
    :source (Path/join host-dir "deferred.bl")}
   {:module :"Elixir.BeamLisp.Derived"
    :source (Path/join host-dir "derived.bl")
    :struct-fields (list (tuple :cell nil) (tuple :deps nil) (tuple :thunk nil))}
   {:module :"Elixir.BeamLisp.Reactive"
    :source (Path/join host-dir "reactive.bl")}
   {:module :"Elixir.BeamLisp.Set"
    :source (Path/join host-dir "set.bl")
    :struct-fields (list (tuple :members nil))}
   {:module :"Elixir.Enumerable.BeamLisp.Set"
    :source (Path/join host-dir "set_enumerable.bl")}
   {:module :"Elixir.BeamLisp.SeqCursor"
    :source (Path/join host-dir "seq_cursor.bl")
    :struct-fields (list (tuple :chunk (list)) (tuple :tail nil) (tuple :dirty false))}
   {:module :"Elixir.Enumerable.BeamLisp.SeqCursor"
    :source (Path/join host-dir "seq_cursor_enumerable.bl")}
   {:module :"Elixir.BeamLisp.WebSocket"
    :source (Path/join host-dir "web_socket.bl")
    :behaviour :"Elixir.WebSock"}
   {:module :"Elixir.BeamLisp.Meta"
    :source (Path/join host-dir "meta.bl")}
   {:module :"Elixir.BeamLisp.FormMeta"
    :source (Path/join host-dir "form_meta.bl")}
   {:module :"Elixir.BeamLisp.Num"
    :source (Path/join host-dir "num.bl")}
   {:module :"Elixir.BeamLisp.Application"
