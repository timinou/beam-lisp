; build/release.bl — THE RELEASE IS A VALUE; this is where the value comes from,
; and (below) how it becomes a `.rel` that `systools` accepts.
;
; A Mix release is a tree assembled by a 700-line Elixir module that reads the
; project, the dependency graph, the OTP installation and a pile of templates.
; The drop needs the same tree, so the first thing to get right is WHAT GOES IN
; IT — as data, derivable from the running VM, so the assembly stage (the rest
; of this wave) never has to ask Mix anything.
;
; The value:
;
;   {:name "bl" :vsn "0.1.0"
;    :erts {:vsn "17.0.1" :dir "/usr/lib/erlang"}
;    :apps [{:app :kernel :vsn "10.0.1" :dir "/usr/lib/erlang/lib/kernel-10.0.1"} …]}
;
; Derivation rules, each of which an assembled tree depends on:
;
;   * the APP SET is the transitive `:applications` closure of the root app —
;     exactly what a release boots, and what `:systools` will insist on: a
;     missing app is a script error, an extra one is a permanent app that must
;     start. `:kernel` and `:stdlib` come along because every app applies them.
;   * an app's DIR is `:code.lib_dir/1`, which answers for OTP apps and for
;     `_build/<env>/lib/<app>` dependencies alike — the VM already has the whole
;     closure on its code path, so no dependency file is read here.
;   * VERSIONS are the `.app` files' own, because that is what `systools`
;     compares against the `.rel`.
;
; `rel-text` writes the classic `Name.rel` term:
;
;   {release, {"bl", "0.1.0"}, {erts, "17.0.1"}, [{kernel, "10.0.1", permanent}, …]}.
;
; `write-rel!` puts it where `systools` looks when it is told `:path` — the
; release's own directory — and that term is written through Erlang's own
; printer (`~p`), so what comes out is Erlang syntax, not this project's.
(ns release)

(defn- text
  "A charlist or binary as a binary. `:erlang` answers with charlists; bl
   strings are binaries; `~w` wants one shape for both."
  [x]
  (cond
    (string? x) x
    (erlang/is_list x) (erlang/list_to_binary x)
    :else (str x)))

(defn app-info
  "`{:app :vsn :dir}` for one application, or nil when the VM cannot see it.
   `nil` is the honest answer for an app that is not loaded and not on the code
   path: the closure below drops it, and `systools` will say so if it mattered."
  [app]
  (let [dir (erlang/apply :code :lib_dir (list app))]
    (if (erlang/is_list dir)
      {:app app
       :vsn (text (or (Application/spec app :vsn) "0"))
       :dir (text dir)}
      nil)))

(defn app-closure
  "Every application the root app needs, transitively, in `:applications`
   order — the set a release must carry. Sorted inside each depth step, so the
   result is deterministic for a given VM."
  [root]
  (loop [seen (set [root]) frontier [root] out [root]]
    (if (empty? frontier)
      out
      (let [next (vec (sort (distinct
                              (vec (remove (fn [a] (contains? seen a))
                                           (vec (mapcat (fn [a] (or (Application/spec a :applications) []))
                                                        frontier)))))))]
        (recur (into seen next) next (into out next))))))

(defn value
  "The release value for `root`, deriving everything the assembly stage needs
   from the RUNNING VM."
  [root]
  (let [apps (vec (keep app-info (app-closure root)))
        erts-vsn (text (erlang/system_info :version))]
    {:name (text root)
     :vsn (text (or (Application/spec root :vsn) "0.1.0"))
     :erts {:vsn erts-vsn
            :dir (text (erlang/apply :code :root_dir (list)))}
     :apps apps}))

(defn- rel-term
  "The `.rel` term as an Erlang tuple tree.

   Two shapes here are not free choices, both taken from the release mix built
   for this project (`releases/<vsn>/<name>.rel` in a shipped drop):

   * the app entries are 3-tuples carrying a TYPE (`permanent` here; `none` is
     for an app that is carried but not started, e.g. `iex`), which is what
     `systools` reads to decide what to boot;
   * strings are CHARLISTS, because the writer is `~p` — `~w` prints a binary
     as `<<98,101,…>>`, which `erl` will not read as a release name. `~p` of a
     charlist prints `\"bl\"`, and of an atom prints it bare: Erlang syntax,
     which is the syntax a `.rel` is written in.

   The app list must be a REAL list: a lazy seq would print as a closure and
   `systools` would reject the file."
  [v]
  (erlang/list_to_tuple
    (list :release
          (erlang/list_to_tuple (list (String/to_charlist (:name v))
                                      (String/to_charlist (:vsn v))))
          (erlang/list_to_tuple (list :erts (String/to_charlist (:vsn (:erts v)))))
          (Enum/to_list (map (fn [a]
                               (erlang/list_to_tuple
                                 (list (:app a) (String/to_charlist (:vsn a)) :permanent)))
                             (:apps v))))))

(defn rel-text [v]
  (erlang/iolist_to_binary (erlang/apply :io_lib :format (list "~p.~n" (list (rel-term v))))))

(defn rel-file
  "The `.rel` path: `releases/<vsn>/<name>.rel` under the tree."
  [out name vsn]
  (Path/join (Path/join (Path/join out "releases") vsn) (str name ".rel")))

(defn write-rel!
  "Write the `.rel` and answer its path."
  [v out]
  (let [path (rel-file out (:name v) (:vsn v))]
    (File/mkdir_p! (Path/dirname path))
    (File/write! path (rel-text v))
    path))
