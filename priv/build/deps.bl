; build/deps.bl — THE LOCK, and the library verbs over it.
;
; `bl.lock` is FACTS, one per line, the same idiom as the build's own memory
; (`build.log`): appended, greppable, readable by anything that can read a line
; — no reader, no evaluation, no format to version. A lock that needed the
; language to interpret it could not be inspected by the tools that check it.
;
;   [:dep jason 1.4.4 <sha256> hex]
;   [:dep beam_lisp 0.1.0 <sha256> path]
;
; ── Lock-first, and honest about it ────────────────────────────────────────
;
; Only `bl deps lock` CHOOSES a version (see `resolve`, at the end). Everything
; else reads the lock: `bl deps fetch` obtains exactly what it names and `bl deps
; verify` proves the store holds it, offline. A resolver that pretends to be a
; fetcher is how a build becomes unreproducible; where a lock does not name
; something, the answer is "the lock does not say", not a guess.

(ns deps
  (:require [store :as st] [hex :as hx] [claim :as c]))

(def lock-name "bl.lock")

(defn lock-path
  "The lock in `dir` (default: the current tree)."
  ([] (lock-path "."))
  ([dir] (Path/join dir lock-name)))

(defn fact->entry
  "One line → one entry, or nil. Unknown facts are skipped rather than fatal: a
   lock is a log, and a log written by a newer tool must not stop an older one
   from reading what it does understand."
  [line]
  (let [t (String/trim line)]
    (if (or (= "" t) (= ";" (subs t 0 1)))
      nil
      (let [parts (String/split t " ")]
        (if (and (= "[:dep" (first parts)) (>= (count parts) 5))
          {:name (nth parts 1)
           :vsn (nth parts 2)
           :sha (nth parts 3)
           :source (keyword (String/replace (nth parts 4) "]" ""))}
          nil)))))

(defn read-lock
  "The lock as `{:deps [entry …] :path path}`, or `{:deps [] :path path :missing true}`
   when there is no lock at all — an empty lock and an absent lock are different
   answers and the caller should be able to tell them apart."
  ([] (read-lock "."))
  ([dir]
   (let [p (lock-path dir)]
     (if (File/exists? p)
       {:deps (vec (keep fact->entry (String/split (File/read! p) "\n"))) :path p}
       {:deps [] :path p :missing true}))))

(defn write-lock!
  "Write a lock from entries — the one place a lock is produced. Sorted by name so
   a re-write with the same content is the same bytes."
  [dir entries]
  (let [p (lock-path dir)
        lines (map (fn [e] (str "[:dep " (:name e) " " (:vsn e) " " (:sha e) " "
                                (name (or (:source e) :hex)) "]"))
                   (sort-by (fn [e] [(:name e) (:vsn e)]) entries))]
    (File/write! p (str (join "\n" (vec lines)) "\n"))
    p))

(defn installed
  "What the store holds, read from the DISK: `[{:name :vsn :sha8 :dir} …]`. A
   report of what is there, which is the only way `list` can disagree with the
   lock out loud."
  []
  (st/entries))

(defn verify
  "Does the store hold what the lock names? Offline, no network."
  [dir]
  (let [lock (read-lock dir)]
    (if (:missing lock)
      {:ok? false :checked 0 :missing [] :why (str "no lock at " (:path lock))}
      (assoc (st/verify lock) :path (:path lock)))))

(defn fetch!
  "Obtain every `:hex` entry the store is missing. Entries from `:path` and
   `:payload` sources are NOT fetched: a path source is the tree's own library and
   a payload source is the running drop's — both are already where they are, which
   is the whole reason a same-host build needs no network."
  [dir scratch transport]
  (let [lock (read-lock dir)
        want (filter (fn [e] (= :hex (:source e))) (:deps lock))
        missing (remove (fn [e] (st/present? (:name e) (:vsn e) (:sha e))) want)]
    {:ok? true
     :wanted (count want)
     :fetched (vec (keep (fn [e]
                           (let [r (hx/install! transport e scratch)]
                             (if (:ok? r) (:name e) {:name (:name e) :why (:why r)})))
                         missing))}))

; ── resolution: env.bl's :deps → a lock ───────────────────────────────────
;
; The one place a version is CHOSEN, and it chooses once: `bl deps lock` writes
; the answer down, and every later fetch, verify and compile reads the lock. A
; declared `:vsn` is either an exact version ("0.9.3") or a hex requirement
; ("~> 0.9"). Each package gets the NEWEST non-retired version that satisfies
; every requirement seen for it so far; a later requirement that the chosen
; version fails is a CONFLICT, reported with both sides — not backtracked over.
; A resolver that silently searches is how two machines lock differently.

(defn- exact? [req] (erlang/is_tuple (Version/parse req)))

(defn- meets? [vsn req]
  (if (exact? req)
    (= vsn req)
    (try (Version/match? vsn req) (catch _ false))))

(defn- newer? [a b] (= :gt (Version/compare (:vsn a) (:vsn b))))

(defn- pick
  "The newest listed version satisfying every requirement in `reqs`."
  [versions reqs]
  (reduce (fn [best v]
            (if (and (not (:retired? v))
                     (every? (fn [r] (meets? (:vsn v) r)) reqs)
                     (or (nil? best) (newer? v best)))
              v
              best))
          nil
          versions))

(defn resolve
  "Resolve declared deps `[{:name :vsn} …]` against hex through `transport`.
   `{:ok? true :entries [lock-entry …]}` or `{:ok? false :why reason}`."
  [declared transport]
  (loop [queue (vec (map (fn [d] {:name (:name d) :req (:vsn d) :from "env.bl"}) declared))
         chosen {}
         reqs {}]
    (if (empty? queue)
      {:ok? true :entries (vec (sort-by :name (vals chosen)))}
      (let [item (first queue)
            nm (:name item)
            req (:req item)
            from (:from item)
            more (vec (rest queue))
            reqs2 (assoc reqs nm (conj (or (get reqs nm) []) {:req req :from from}))
            have (get chosen nm)]
        (cond
          (and have (meets? (:vsn have) req))
          (recur more chosen reqs2)

          have
          {:ok? false
           :why (str nm " " (:vsn have) " was chosen for "
                     (join ", " (vec (map (fn [r] (str (:from r) " (" (:req r) ")")) (get reqs nm))))
                     ", but " from " requires " req)}

          :else
          (let [p (hx/package transport nm)]
            (if (:error p)
              {:ok? false :why (str nm ": " (:error p))}
              (let [v (pick (:versions (:ok p)) (map :req (get reqs2 nm)))]
                (if (nil? v)
                  {:ok? false :why (str "no version of " nm " satisfies " req " (from " from ")")}
                  (let [rel (hx/release transport nm (:vsn v))]
                    (if (:error rel)
                      {:ok? false :why (:error rel)}
                      (let [r (:ok rel)
                            deps (vec (map (fn [q] {:name (:package q) :req (:req q)
                                                    :from (str nm " " (:vsn r))})
                                           (remove :optional? (:requirements r))))]
                        (recur (vec (concat more deps))
                               (assoc chosen nm {:name nm :vsn (:vsn r) :sha (:sha r) :source :hex})
                               reqs2)))))))))))))

(defn lock!
  "Resolve `declared` and write the lock in `dir`. Path and payload entries the
   lock already holds are kept: they are not hex's to choose."
  [dir declared transport]
  (let [r (resolve declared transport)]
    (if (not (:ok? r))
      r
      (let [kept (vec (remove (fn [e] (= :hex (:source e))) (:deps (read-lock dir))))
            entries (vec (concat kept (:entries r)))]
        (assoc r :path (write-lock! dir entries) :entries entries)))))
