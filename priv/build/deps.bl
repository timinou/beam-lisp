; build/deps.bl — THE LOCK, and the library verbs over it.
;
; `bl.lock` is FACTS, one per line, the same idiom as the build's own memory
; (`build.log`): appended, greppable, readable by anything that can read a line
; — no reader, no evaluation, no format to version. A lock that needed the
; language to interpret it could not be inspected by the tools that check it.
;
;   [:dep jason 1.4.4 <sha256> hex]
;   [:dep beam_lisp 0.1.0 <sha256> path]
;
; ── Lock-first, and honest about it ────────────────────────────────────────
;
; Nothing here CHOOSES a version. A lock names versions; `bl deps fetch` obtains
; exactly those and `bl deps verify` proves the store holds them, offline. That
; is deliberate: resolution is a different problem (constraints, retirements,
; backtracking) and a resolver that pretends to be a fetcher is how a build
; becomes unreproducible. Where a lock does not name something, the answer is
; "the lock does not say", not a guess.

(ns deps
  (:require [store :as st] [hex :as hx] [claim :as c]))

(def lock-name "bl.lock")

(defn lock-path
  "The lock in `dir` (default: the current tree)."
  ([] (lock-path "."))
  ([dir] (Path/join dir lock-name)))

(defn fact->entry
  "One line → one entry, or nil. Unknown facts are skipped rather than fatal: a
   lock is a log, and a log written by a newer tool must not stop an older one
   from reading what it does understand."
  [line]
  (let [t (String/trim line)]
    (if (or (= "" t) (= ";" (subs t 0 1)))
      nil
      (let [parts (String/split t " ")]
        (if (and (= "[:dep" (first parts)) (>= (count parts) 5))
          {:name (nth parts 1)
           :vsn (nth parts 2)
           :sha (nth parts 3)
           :source (keyword (String/replace (nth parts 4) "]" ""))}
          nil)))))

(defn read-lock
  "The lock as `{:deps [entry …] :path path}`, or `{:deps [] :path path :missing true}`
   when there is no lock at all — an empty lock and an absent lock are different
   answers and the caller should be able to tell them apart."
  ([] (read-lock "."))
  ([dir]
   (let [p (lock-path dir)]
     (if (File/exists? p)
       {:deps (vec (keep fact->entry (String/split (File/read! p) "\n"))) :path p}
       {:deps [] :path p :missing true}))))

(defn write-lock!
  "Write a lock from entries — the one place a lock is produced. Sorted by name so
   a re-write with the same content is the same bytes."
  [dir entries]
  (let [p (lock-path dir)
        lines (map (fn [e] (str "[:dep " (:name e) " " (:vsn e) " " (:sha e) " "
                                (name (or (:source e) :hex)) "]"))
                   (sort-by (fn [e] [(:name e) (:vsn e)]) entries))]
    (File/write! p (str (join "\n" (vec lines)) "\n"))
    p))

(defn installed
  "What the store holds, read from the DISK: `[{:name :vsn :sha8 :dir} …]`. A
   report of what is there, which is the only way `list` can disagree with the
   lock out loud."
  []
  (st/entries))

(defn verify
  "Does the store hold what the lock names? Offline, no network."
  [dir]
  (let [lock (read-lock dir)]
    (if (:missing lock)
      {:ok? false :checked 0 :missing [] :why (str "no lock at " (:path lock))}
      (assoc (st/verify lock) :path (:path lock)))))

(defn fetch!
  "Obtain every `:hex` entry the store is missing. Entries from `:path` and
   `:payload` sources are NOT fetched: a path source is the tree's own library and
   a payload source is the running drop's — both are already where they are, which
   is the whole reason a same-host build needs no network."
  [dir scratch transport]
  (let [lock (read-lock dir)
        want (filter (fn [e] (= :hex (:source e))) (:deps lock))
        missing (remove (fn [e] (st/present? (:name e) (:vsn e) (:sha e))) want)]
    {:ok? true
     :wanted (count want)
     :fetched (vec (keep (fn [e]
                           (let [r (hx/install! transport e scratch)]
                             (if (:ok? r) (:name e) {:name (:name e) :why (:why r)})))
                         missing))}))
