; build/app-resource.bl — a project's own `.app`, derived from the PROJECT VALUE.
;
; ── Why this file exists ───────────────────────────────────────────────────
;
; `beam_lisp.app` is what makes `Application.ensure_all_started(:beam_lisp)`
; resolvable: OTP answers "what must be started, and with which callback" from
; that file and nothing else. Until now exactly one thing in the tree could
; write it — `mix compile`, from `mix.exs`. So a checkout with no Mix compiled
; 109 Elixir modules, put them on the code path, and then died with
;
;     {:error, {:beam_lisp, {~c"no such file or directory", ~c"beam_lisp.app"}}}
;
; which is a strange way to say "this toolchain forgot one of its own outputs".
; The release assembly needed it too (it copies an app's ebin, `.app` included),
; and so does the boot floor, because the first command in a fresh clone must
; start an application whose resource has never been built.
;
; ── One writer, two callers, and the mix.exs they replaced ────────────────
;
; The dependency compiler already owned this knowledge for LIBRARIES
; (`deps-compile/write-app!`): the term is built in Erlang terms so `io_lib`
; prints it, the module list is read from the ebin, and the file is consulted
; back because a term file nobody can read is not an application. That code
; moved here, unchanged, so there is ONE writer: `deps-compile` calls it for a
; package, `bl build` and `bl seed` call it for the tree itself.
;
; What is NOT the same is where the declaration comes from. A package is
; declared by its `mix.exs` (read without Mix — see `deps-compile/project-of`);
; a tree is declared by its `env.bl` `:app` value, which is exactly the consumer
; that key was added for: name, version, what must be started, and the callback.
;
; ── The module list is a build output, never a declaration ────────────────
;
; `{modules, […]}` is what got compiled, so it is read from the ebin that
; received it. A caller that writes an `.app` before compiling (which
; `deps-compile` does on purpose, so `:code.priv_dir/1` resolves while modules
; load) passes an empty list and fills it in after. The seed does the same: a
; floor whose `.app` listed the modules of the machine that generated it would
; be a lie about every tree that installs it.

(ns app-resource)

(defn atom-of
  "A name as an atom, whichever form it arrives in: MODULE names come from the
   compiler as strings, while `applications` a project declares as `[:logger]` —
   already atoms. Coercing the second as a binary fails with 'not a binary' and
   names neither the list nor the package."
  [s]
  (if (erlang/is_binary s) (erlang/binary_to_atom s :utf8) s))

(defn erl-list
  "An Erlang LIST from a collection.

   `map` and `vec` answer bl Vectors, and a Vector is a struct — an Erlang map.
   Handed to Erlang's term printer it prints as `#{meta => nil, items => {…},
   '__struct__' => 'Elixir.BeamLisp.Vector'}`, so the `.app` this file writes
   would carry a map where OTP wants a list of modules. Caught by reading the
   file it produced."
  [coll]
  (Enum/to_list coll))

(defn mod-prop
  "`{mod, {Module, Args}}` for an application callback.

   A project declares this as `mod: {Bandit.Application, []}`, so the value is a
   TUPLE and the module inside it is already an atom. `(str …)` on the tuple is
   what the first version did, and it asked bl to turn a tuple into a Vector —
   the run died with `no function clause matching in BeamLisp.Vector.new/1`,
   naming neither the project nor the field."
  [mod]
  (if (nil? mod)
    nil
    (let [m (if (erlang/is_tuple mod) (erlang/element 1 mod) mod)
          args (if (erlang/is_tuple mod) (erlang/element 2 mod) (list))]
      (erlang/list_to_tuple
        (list :mod (erlang/list_to_tuple (list (atom-of m) args)))))))

(defn term
  "The `{application, Name, Props}` term, built in ERLANG terms so `io_lib` can
   print it: hand-formatting a term file is how a `.app` ends up subtly wrong in
   a way only `file:consult` notices.

   `vsn` is a string (charlist) because that is what an `.app` carries — the lock
   holds it as a binary, and the two are not the same term."
  [name vsn mods apps mod]
  (let [props (list (erlang/list_to_tuple (list :description (list)))
                    (erlang/list_to_tuple (list :vsn (erlang/binary_to_list vsn)))
                    (erlang/list_to_tuple (list :modules (erl-list (map atom-of (erl-list mods)))))
                    (erlang/list_to_tuple (list :registered (list)))
                    ; DISTINCT after `atom-of`: a caller composes this list as
                    ; `kernel stdlib [elixir] ++ declared`, and an Erlang
                    ; package's `.app.src` ALREADY names `[kernel, stdlib]` in
                    ; its own `applications` (nearly all do) — so the raw list
                    ; carries them twice, and `file:consult` reads it back fine
                    ; while release assembly rejects it with `{:dupl_entry,
                    ; :applications, [:kernel, :stdlib]}`. Deduping at the atom
                    ; level (not the mixed string/atom input) is the one place
                    ; that guarantees no `.app` this writer emits can carry a
                    ; duplicate application, whatever the caller passes.
                    (erlang/list_to_tuple (list :applications (erl-list (distinct (map atom-of (erl-list apps)))))))
        extra (mod-prop mod)
        props (if (nil? extra)
                props
                (erlang/apply :lists :append (list props (list extra))))]
    (erlang/list_to_tuple (list :application (atom-of name) props))))

(defn write!
  "Write one `.app` at `path` and CONSULT IT BACK. A term file nobody can read
   is not an application, and the failure would otherwise surface as a missing
   app two stages later."
  [path name vsn mods apps mod]
  (File/mkdir_p! (Path/dirname path))
  (let [text (erlang/iolist_to_binary
               (erlang/apply :io_lib :format (list "~p.~n" (list (term name vsn mods apps mod)))))
        _ (File/write! path text)
        r (erlang/apply :file :consult (list (erlang/binary_to_list path)))]
    (if (= :ok (erlang/element 1 r))
      {:ok? true :path path}
      {:ok? false :why (str "the .app just written will not read: " (pr-str r))})))

(defn modules-in
  "The module names an `ebin` holds, as binaries — the `.app` body of `modules`.

   Read from the DIRECTORY, not from a build's bookkeeping. The compiler's own
   attribution (substrate's `:source` compile-info) is the right answer for a
   build LOG, where each fact must name the file it came from; for an `.app` the
   question is only which modules are there, and the directory answers it
   directly. Measured on the first version: attributing through compile-info
   answered ZERO modules for a module that was already loaded, so the `.app`
   named none of them. The directory also cannot be out of date about what the
   build put there."
  [ebin]
  (vec (map (fn [p] (Path/basename p ".beam"))
            (sort (Path/wildcard (Path/join ebin "*.beam"))))))

; ── a project value's own app resource ─────────────────────────────────────

(defn- split-mod
  "A project's `:mod`, as the `{Module, Args}` tuple an `.app` carries.

   `env.bl` declares it as data — `{:name \"BeamLisp.Application\" :start
   [:normal []]}` — because the project file is a value, not code, and a value
   cannot name an Elixir module. The `:normal` is the start TYPE (the third
   element of the `{Module, Args}` shape OTP already implies for `mod`), so the
   ARGS are its tail."
  [m]
  (if (map? m)
    (let [start (:start m)
          ; `erl-list` is load-bearing here: in bl `[]` reads as an EMPTY
          ; VECTOR, and a Vector is a struct — an Erlang map. Printed into the
          ; `.app` it became `{mod,{'Elixir.BeamLisp.Application',
          ; %BeamLisp.Vector{items: {}, meta: nil}}}`, and OTP then refused the
          ; start spec with `{:badstartspec, {~c"Elixir.BeamLisp.Application",
          ; []}}`. Measured on the first version of this function.
          args (if (pos? (count start)) (erl-list (last start)) (list))]
      (erlang/list_to_tuple (list (atom-of (str "Elixir." (:name m))) args)))
    m))

(defn of-project
  "The app resource a PROJECT VALUE declares, as data.

   `{:ok? true :name :vsn :applications :mod}`, or `{:ok? false :why}` — a
   shape problem is DATA, because a tree with a wrong project file is still a
   tree: a command degrades without an app resource, while a seed REFUSES to
   publish a floor that has none."
  [project]
  (let [app (:app project)]
    (cond
      (nil? app)        {:ok? false :why "the project declares no :app"}
      (nil? (:name app)) {:ok? false :why "the project's :app declares no :name"}
      :else
      {:ok? true
       :name (:name app)
       :vsn (or (:vsn app) "0.0.0")
       :applications (vec (or (:applications app) (list)))
       :mod (split-mod (:mod app))})))

(defn write-project!
  "Write a project's app resource into `ebin`, with the modules that ebin holds.

   → `{:ok? true :path}` or `{:ok? false :why}`, the same shape `write!` answers."
  [project ebin]
  (let [r (of-project project)]
    (if (not (:ok? r))
      r
      (write! (Path/join ebin (str (:name r) ".app"))
              (:name r) (:vsn r) (modules-in ebin) (:applications r) (:mod r)))))
