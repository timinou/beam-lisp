; A workspace has kernel custody and a readable owner. The permanent sibling
; lock inode survives clear!/restaging. The OS releases custody after crashes;
; stale diagnostic text cannot wedge a workspace or authorize a second writer.

(ns claim
  (:require [core] [release :as rel]))

(defn path-for
  "The claim file beside the thing being written."
  [dir]
  (Path/join dir ".claim"))

(defn owner-pid
  "This OS process's pid, as a string."
  []
  (rel/text (erlang/apply :os :getpid (list))))

(defn read-claim
  "The claim at `dir` as `{:pid :at :bin}`, or nil when there is none (or it is
   unreadable — an unreadable claim is no claim).

   A claim file is ONE FACT, space-separated, the same idiom as the build log and
   the lock: `[:claim <pid> <at-ms> <what>]`. The first version wrote a map with
   `pr-str` and read it back with `read-string` — and bl's reader answers NODES,
   not values, so the map test failed, every claim read as nil, and the exclusion
   silently did nothing. The suite caught it: a claim written by another process
   was not seen. A format that needs no reader cannot have that bug."
  [dir]
  (let [r (File/read (path-for dir))]
    (when (= :ok (elem r 0))
      (let [parts (String/split (String/trim (elem r 1)) " ")]
        (when (and (= "[:claim" (first parts)) (>= (count parts) 4))
          {:pid (nth parts 1) :at (nth parts 2)
           :bin (String/trim_trailing (Enum/join (Enum/drop parts 3) " ") "]")})))))

(defn alive?
  "Whether the process that wrote `c` is still running. Linux answers with
   `/proc/<pid>`; anywhere else, and for a pid we cannot read, the answer is
   `true` — see the header: refusing is recoverable, stomping is not."
  [c]
  (let [pid (:pid c)]
    (cond
      (nil? pid) false
      (= pid (owner-pid)) true
      (File/dir? "/proc") (File/dir? (Path/join "/proc" (str pid)))
      :else true)))

(defn- workspace-path [dir]
  (or (BeamLisp.AOT/physical_sdk_path (Path/expand dir)) (Path/expand dir)))
(defn- handle-key [dir] (tuple :build-claim (workspace-path dir)))

(defn owned? [dir] (some? (Process/get (handle-key dir))))

(defn- lock! [dir]
  (File/mkdir_p! dir)
  (let [physical (workspace-path dir) base (Path/basename physical)
        anchors (if (= base ".bl") ".bl-locks" ".bl")
        path (Path/join (Path/join (Path/join (Path/dirname physical) anchors) "locks") base)]
    (BeamLisp.LazyMemo/ensure_loaded!)
    (BeamLisp.LazyMemo/nif_file_lock path false true)))

(defn held-by
  "Observe kernel custody. The readable claim is diagnostic, never authority.
   Only this BEAM process's own handle is reentrant."
  [dir]
  (if (Process/get (handle-key dir))
    nil
    (let [r (lock! dir)]
      (if (= :ok (elem r 0))
        (do (BeamLisp.LazyMemo/nif_file_unlock (elem r 1)) nil)
        (or (read-claim dir) {:pid "unknown" :at "unknown" :bin "build"})))))

(defn acquire!
  "Atomically claim a workspace. Kernel ownership releases on owner/VM death;
   the claim file names the owner for diagnostics. Never unlink the lock anchor."
  [dir what]
  (if (Process/get (handle-key dir))
    {:ok? true :swept false :held nil}
    (let [r (lock! dir)]
      (if (not= :ok (elem r 0))
        {:ok? false :swept false :held (or (read-claim dir)
                                          {:pid "unknown" :at "unknown" :bin "build"})}
        (let [handle (elem r 1) prior (read-claim dir)]
          (try
            (File/mkdir_p! dir)
            (File/write! (path-for dir)
              (str "[:claim " (owner-pid) " " (erlang/system_time :millisecond) " " what "]"))
            (Process/put (handle-key dir) handle)
            {:ok? true :swept (some? prior) :held nil}
            (catch e
              (BeamLisp.LazyMemo/nif_file_unlock handle)
              (throw e))))))))

(defn clear!
  "Empty `dir` and keep it, and keep the claim on it. A build that rewrites a
   directory it holds a claim on must not use `rm_rf!`: the claim file lives IN the
   directory, so wiping it hands the directory to the next builder mid-build (the
   self-build did exactly that, and a second build then wiped its staging root while
   the first was compiling from it). Everything but the claim goes."
  [dir]
  (File/mkdir_p! dir)
  (let [keep (path-for dir)]
    (doseq [entry (to-list (File/ls! dir))]
      (let [p (Path/join dir entry)]
        (when (not= p keep) (File/rm_rf! p)))))
  :ok)

(defn release!
  "Release this BEAM process's claim, removing its diagnostic before unlock."
  [dir]
  (when-let [handle (Process/delete (handle-key dir))]
    (try (File/rm (path-for dir))
         (finally (BeamLisp.LazyMemo/nif_file_unlock handle))))
  :ok)
