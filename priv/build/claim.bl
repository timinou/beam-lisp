; build/claim.bl — WHO IS BUILDING THIS DIRECTORY.
;
; A build writes a directory; two builds writing one produce a tree that is
; neither. The usual answer is a lock, and a lock is a poor answer: it cannot say
; who holds it or whether its holder is still alive, so a killed build wedges the
; directory forever. Mix's `_build/<env>/lib/<app>/.mix/compile.lock` is 0 bytes
; naming nobody (measured), and cargo's target lock is the same shape.
;
; A CLAIM is the same exclusion, made readable: a small file naming the owner's
; pid, when it took the claim, and what it is building. A claim whose holder is
; gone is swept rather than honoured — that is the difference between a claim and
; a lock, and it is what makes a killed build recoverable.
;
; Liveness is asked of the OS, not of a heartbeat: on Linux `/proc/<pid>` is the
; answer (a claim from this VM or another), and where that is not available the
; answer is conservatively "alive" — refusing to build is recoverable, stomping
; another build is not.

(ns claim
  (:require [core] [release :as rel]))

(defn path-for
  "The claim file beside the thing being written."
  [dir]
  (Path/join dir ".claim"))

(defn owner-pid
  "This OS process's pid, as a string."
  []
  (rel/text (erlang/apply :os :getpid (list))))

(defn read-claim
  "The claim at `dir` as `{:pid :at :bin}`, or nil when there is none (or it is
   unreadable — an unreadable claim is no claim)."
  [dir]
  (let [p (path-for dir)]
    (if (File/exists? p)
      (try
        (let [m (read-string (File/read! p))]
          (if (map? m) m nil))
        (catch _ nil))
      nil)))

(defn alive?
  "Whether the process that wrote `c` is still running. Linux answers with
   `/proc/<pid>`; anywhere else, and for a pid we cannot read, the answer is
   `true` — see the header: refusing is recoverable, stomping is not."
  [c]
  (let [pid (:pid c)]
    (cond
      (nil? pid) false
      (= pid (owner-pid)) true
      (File/dir? "/proc") (File/dir? (Path/join "/proc" (str pid)))
      :else true)))

(defn held-by
  "The claim holding `dir` that we must NOT take, or nil when it is free, ours,
   or stale. Returns the claim map so the caller can NAME the owner."
  [dir]
  (let [c (read-claim dir)]
    (cond
      (nil? c) nil
      (= (:pid c) (owner-pid)) nil
      (alive? c) c
      :else nil)))

(defn acquire!
  "Take the claim on `dir`, sweeping a stale one. Returns
   `{:ok? bool :swept bool :held claim}` — `:held` is set, and `:ok?` false, when
   a LIVE build holds it (the caller reports that owner rather than waiting)."
  [dir what]
  (let [cur (read-claim dir)
        stale? (and (some? cur) (not (alive? cur)))
        other (held-by dir)]
    (if (some? other)
      {:ok? false :swept false :held other}
      (do
        (File/mkdir_p! dir)
        (File/write! (path-for dir)
                     (pr-str {:pid (owner-pid)
                              :at (erlang/system_time :millisecond)
                              :bin what}))
        {:ok? true :swept stale? :held nil}))))

(defn release!
  "Drop the claim on `dir` if it is ours. Never removes someone else's."
  [dir]
  (let [c (read-claim dir)]
    (when (and (some? c) (= (:pid c) (owner-pid)))
      (File/rm (path-for dir)))
    :ok))
