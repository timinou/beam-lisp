; build/ns-interface.bl — what a dependent can SEE of a namespace, as one hash.
;
; ── The problem ─────────────────────────────────────────────────────────────
;
; The per-namespace freshness key (source-graph/closure-hash) folds the FULL
; CONTENT of every namespace in the require-closure. Edit one `defn` body in
; `datom.store` and 35 beams rebuild — every dependent, transitively — though
; not one of their bytes changes. Their bytes cannot change: a dependent's
; compiled code reaches a required namespace's functions through a direct
; call `Module.fname(args)` (resolved by name and arity) or a var fetch by
; name. What is INSIDE a function body is invisible to the caller's beam.
;
; So the right key for "must a dependent rebuild?" is not "did the required
; source change?" but "did the part of it the dependent can OBSERVE change?".
; That observable part is the namespace's INTERFACE.
;
; ── What a dependent's bytes observe (the interface, exactly) ───────────────
;
; Read straight off compiler.bl's cross-namespace reads (every `BeamLisp.Env/…`
; call it makes about a name in ANOTHER namespace):
;
;   1. the SET OF NAMES        `Env/peek`, `refer_source`: does `foo/bar`
;                              resolve? Is it referred? (a missing name is a
;                              compile error → the dependent's output changes)
;   2. per name, its KIND      fn | macro | value | module (record/deftype):
;                              `macro-lookup` decides EXPANSION vs CALL;
;                              `Record/record_module?` decides a type-tag
;   3. a fn's LINK SHAPE       `Env/link` → {module, {arity → fname}, {min
;                              fname}}: the caller bakes a direct call iff its
;                              arity is in the map; else `RT.invoke(fetch …)`.
;                              Changing an arity changes the caller's bytes.
;   4. a macro's DEFINITION    the expansion is inlined into the caller, and
;                              an expansion is a pure function of the macro's
;                              source text and the call's arguments. So the
;                              macro's whole `(defmacro …)` form text IS its
;                              interface — body included.
;   5. per name, PRIVATE?      `reject-private!`: calling a private var is a
;                              compile error
;   6. a defnative's SIGNATURES `Native.declare` names+arities (a host module
;                              the caller links to directly)
;   7. the ns's own REQUIRES/ALIASES/REFERS  `alias_target`: `mk/bind` in a
;                              dependent resolves through the dependent's own
;                              ns form, not the required one's — so NOT part
;                              of the required ns's interface. (A required
;                              ns's `:refer` of a third ns's macro, however,
;                              is: `refer_source` lets a dependent see it.)
;
; NOT in the interface, deliberately: fn bodies (the whole point), docstrings
; (metadata is written by the defining ns's own init, never baked into a
; caller), `def` VALUES (a caller fetches at runtime), comments, formatting.
;
; ── Why source-derived, and how it stays sound ──────────────────────────────
;
; The interface is computed from the SOURCE TEXT alone — the same discipline
; as the closure hash — so the build can ask it before anything compiles and
; the runtime gate can recompute it without a running compiler. It reads the
; top-level forms with the real reader and classifies each defining form by
; its head: defn/defn- (name + clause arities + private), defmacro (name +
; full form text), def (name), defrecord/deftype/defprotocol/defmulti/
; defserver (name + kind), defnative (crate + signatures). Anything else at
; top level (an expression, a `(comment …)`, a `declare`) contributes nothing.
;
; A defining form that is ITSELF produced by a macro at top level
; (`(defsmell …)`, `(deftest …)`) is invisible to this scan: the reader sees
; `(defsmell name …)`, not the `def` it expands to. Such a name is therefore
; NOT in the interface hash, and a dependent that calls it would not rebuild
; when it changes. Soundness is preserved by construction, not by hoping: the
; build keys a dependent on the interface hash ONLY when every name it
; references in the required ns is accounted for by the scan (the
; `covered?` check in build-plan); otherwise it falls back to the closure
; hash for that edge. Today that fallback is what every edge already uses,
; so the interface can only ever REMOVE rebuilds it has proven unnecessary.
;
; ── Host-only, like source-graph ────────────────────────────────────────────
;
; No `core` vars: the drift gate may ask this while `core` is loading.

(ns ns-interface
  (:require [reader-node :as rn] [source-graph :as sg]))

; Pure algorithms live in the pinned compiler kernel; these preserve Source APIs.

(def ^:private defining-heads (BeamLisp.NamespaceInterface/defining-heads))

(defn- tag-is?
 [node tag]
 (BeamLisp.NamespaceInterface/tag-is? node tag))

(defn- non-empty?
 [xs]
 (BeamLisp.NamespaceInterface/non-empty? xs))

(defn- head-name
 "The symbol name heading a list form, or nil."
 [form]
 (BeamLisp.NamespaceInterface/head-name form))

(defn- second-name
 "The symbol name in a list form's second position, or nil. A top-level form
   that is not a list names nothing: a livebook cell may be a bare keyword
   (`:payroll-v1`), whose node items are not a list."
 [form]
 (BeamLisp.NamespaceInterface/second-name form))

(defn- amp?
 [n]
 (BeamLisp.NamespaceInterface/amp? n))

(defn- param-shape
 "[fixed-count variadic?] of one parameter vector node."
 [pv]
 (BeamLisp.NamespaceInterface/param-shape pv))

(defn- clause-shapes
 "The shapes of every clause after the docstring/attr-map of a defn's args."
 [args]
 (BeamLisp.NamespaceInterface/clause-shapes args))

(defn- shapes->text
 "Canonical text of a shape list: sorted `n` for fixed, `n+` for variadic."
 [shapes]
 (BeamLisp.NamespaceInterface/shapes->text shapes))

(defn- form-text
 "A canonical rendering of a form's bare shape (positions stripped): the
   external term format of the reader node, hex-encoded. Stable across
   whitespace, comments and line numbers; distinct for any real change."
 [form]
 (BeamLisp.NamespaceInterface/form-text form))

(defn- form-line
 "The interface line for one top-level form, or nil when it defines nothing
   a dependent can observe."
 [form]
 (BeamLisp.NamespaceInterface/form-line form))

(defn lines-forms
 "`lines` over already-read forms."
 [forms]
 (BeamLisp.NamespaceInterface/lines-forms forms))

(defn lines
 "The interface of a source: its sorted defining lines (see the header)."
 [content]
 (BeamLisp.NamespaceInterface/lines content))

(defn- inner-names
 "Names a defining form introduces BESIDES its own: a protocol's methods
   (each `(-get [store k] …)` clause), a defnative's signatures (each
   `(vec-pack 1)`). Both are names a dependent calls by `ns/name`."
 [form]
 (BeamLisp.NamespaceInterface/inner-names form))

(defn names
 "The names the interface accounts for — every defined name the scan saw,
   including a protocol's methods and a defnative's signatures. The build
   uses this to decide whether a dependent's references into this namespace
   are all COVERED (else it keeps the closure key for that edge)."
 [content]
 (BeamLisp.NamespaceInterface/names content))

(defn names-forms
 "`names` over already-read forms."
 [forms]
 (BeamLisp.NamespaceInterface/names-forms forms))

(defn hash
 "sha256 hex of the interface. Two sources with the same observable surface
   — same names, kinds, arities, privacy, macro definitions — hash alike, so a
   dependent keyed on this does not rebuild when only a fn body changed."
 [content]
 (BeamLisp.NamespaceInterface/hash content))

(defn hash-forms
 "`hash` over already-read forms."
 [forms]
 (BeamLisp.NamespaceInterface/hash-forms forms))
