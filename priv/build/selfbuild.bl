; build/selfbuild.bl — THE DROP BUILDS ITSELF (PLAN-108 W6).
;
; Run from inside a shipped drop, `self-build` reproduces that drop: it takes the
; payload it is ALREADY RUNNING FROM, rebuilds every tier source into a fresh
; tree, re-assembles the release, and seals it with the very launcher that is
; running. The launcher's bytes are in the file `BL_BIN` names (measured: in a
; packed drop the launcher exports the COMPOUND's own path), so recovering them is
; a read of the first `offset` bytes — no Rust tool, no checkout, no Mix.
;
; ── The four stages, and why each is separate ──────────────────────────────
;
;   assemble   `Release/value(:beam_lisp)` — the apps the VM is running from —
;              into a scratch tree, with `.rel`s, boot scripts and wrappers.
;   compile    every tier source, STAGED first (see `staging-root`), into the new
;              tree's app ebin; manifest and log go OUTSIDE the tree, because a
;              release must carry no build state (measured: none of a release
;              tree's 2,099 files is a log, manifest or lock).
;   pack       the tree, sealed with the running launcher's own prefix bytes.
;   verify     the new compound against its own trailer.
;
; Each stage is a function from a result map to a result map that does nothing
; once one has failed, so a half-assembled tree is never presented as a drop.
;
; ── What it does NOT do, and says so ───────────────────────────────────────
;
; The compiler that rebuilds the tier sources is the one RUNNING — the payload's
; own codegen. That is the bootstrap reality, and it is why the proof that matters
; is the fixpoint gate (build with gen-N, then with gen-N+1, compare), not this
; run. The shipped payload carries no Elixir sources either, so the substrate
; stage compiles nothing and the result reports `:ex 0` rather than implying a
; rebuild that did not happen.

(ns selfbuild
  (:require [release :as rel] [drop :as d] [build :as b] [substrate :as sub] [claim :as c]
            [provenance :as prov] [build-plan :as bp] [seed] [app-resource :as ar]))

(defn staging-root
  "Where a self-build stages the sources it is about to compile.

   FIXED, not per-run, and that is load-bearing: a beam embeds the path of the
   source it was compiled from, so two generations would differ in every beam if
   each staged somewhere new. Measured: gen-2 and gen-3 differed in 438 beams,
   every one of them by the extraction path, before this existed.

   A claim keeps two concurrent self-builds from sharing it (see `claim`)."
  []
  (Path/join (System/tmp_dir) "bl-selfbuild-src"))

(defn running-root
  "The root of the running image: the VM answers `<root>/lib/<app>-<vsn>` as the
   app's lib dir, so the root is two levels up. Reported, so a self-build says
   WHICH image it reproduced."
  []
  (Path/dirname (Path/dirname (rel/text (erlang/apply :code :lib_dir (list :beam_lisp))))))

(defn- under?
  "Whether `path` lies inside `dir`. Both are made absolute first; a trailing
   separator on `dir` is what keeps `/a/bc` from reading as inside `/a/b`."
  [path dir]
  (String/starts_with? (Path/expand path) (str (Path/expand dir) "/")))

(defn foreign-checkout
  "The checkout in the current directory whose `priv/` is NOT the one this build
   would stage, or nil when there is no such mismatch.

   `self-build` stages `Tiers.priv_root()` — the payload it is RUNNING FROM — and
   that is the right tree in exactly one situation: when the launcher IS the
   checkout, as `bin/bl` makes it. `bin/bl` builds into `build/` and symlinks
   `.bl/lib/beam_lisp-0.1.0/{ebin,priv}` at the tree, so `priv_root()` answers the
   checkout and the staged sources are yours.

   Run instead as a shipped DROP from inside a checkout — `./bl self-build` —
   `priv_root()` answers the drop, so the build faithfully reproduces the drop it
   is already running as, and it CANNOT absorb a line of what you are standing
   in. Worse, it then reports the drop's staleness as defects in YOUR tree:

     var loom.token/realize is not public   (the drop's copy predates the fix)
     namespace not found: vm.index          (the drop predates the module)

   Both name a file whose source is correct. That is the real cost of getting
   this wrong: an hour spent reading your own code for a bug that is a stale
   payload. So the mismatch is DETECTED and NAMED here, rather than staged and
   misreported."
  []
  (let [cwd (System/cwd)
        root (Path/expand (rel/text (BeamLisp.Tiers/priv_root)))]
    (when (and (File/exists? (Path/join cwd "env.bl"))
               (not (under? root cwd)))
      {:cwd cwd :staged root})))

(defn- app-dir
  "`lib/<app>-<vsn>` inside the assembled tree."
  [tree v app]
  (let [info (first (filter (fn [a] (= app (:app a))) (:apps v)))]
    (Path/join tree (str "lib/" (:app info) "-" (:vsn info)))))

(defn- launcher-file
  "Write the launcher to `out`.

   Two shapes, one meaning. In a running DROP the launcher is the compound's own
   first `offset` bytes, which its trailer states. In a CHECKOUT there is no
   compound at all: `bin` is a stock launcher built by cargo from
   `tooling/drop`, which is exactly what `d/pack` documents that argument to be
   ('a STOCK launcher binary (or, in a running drop, its own first `offset`
   bytes)'). Copying is the whole operation — refusing a bare launcher was the
   single thing that made a drop impossible to build without a drop to start
   from."
  [bin c out]
  (if (nil? c)
    (File/cp! bin out)
    (File/write! out (d/read-slice bin 0 (:len (:launcher c)))))
  out)

(defn- local-os
  "The release tag for the platform this VM runs on, as `drop` numbers them:
   0 linux, 1 macos, 2 windows. Used when there is no compound to read a tag
   from — see `launcher-file` for why that case exists."
  []
  (let [t (erlang/apply :os :type (list))]
    (cond
      (= :win32 (erlang/element 1 t)) 2
      (= :darwin (erlang/element 2 t)) 1
      :else 0)))

(defn- stage-sources!
  "Copy the running priv's tiers into `stage`, preserving the tier layout, and
   answer the staged sources. Staging is what makes the compiled-in path stable:
   the payload sits under a directory named for its own hash, so compiling
   straight from it bakes a different path into every generation."
  [stage]
  (c/clear! stage)
  (doseq [t (BeamLisp.Tiers/library_names)]
    (let [src (Path/join (BeamLisp.Tiers/priv_root) (name t))]
      (when (File/dir? src)
        (File/cp_r! src (Path/join stage (name t))))))
  (vec (BeamLisp.Tiers/sources stage)))

(defn- failed? [acc] (not (:ok? acc)))

(defn- with-error [acc msg]
  (assoc acc :ok? false :errors (conj (vec (:errors acc)) msg)))

(defn- do-assemble
  "Stage 1: the release tree."
  [acc v tree]
  (if (failed? acc)
    acc
    (let [a (rel/assemble v tree)]
      (if (:ok? a)
        (assoc acc :stages (assoc (:stages acc) :assemble (:apps a)))
        (reduce with-error acc (map (fn [e] (str "assemble: " e)) (:errors a)))))))

(defn- do-compile
  "Stage 2: the language half, from the staged sources."
  [acc stage scratch ebin jobs]
  (if (failed? acc)
    acc
    (let [srcs (stage-sources! stage)
          r (b/run {:sources srcs
                    :root stage
                    :out ebin
                    :manifest (Path/join scratch "manifest")
                    :log-path (Path/join scratch "build.log")
                    :force? true
                    :jobs jobs
                    :log nil})]
      (if (pos? (count (:errors r)))
        (reduce with-error acc (map (fn [e] (str "build: " e)) (:errors r)))
        (let [inventory (BeamLisp.AOT/write_sdk_inventory! stage (:manifest r) ebin
                        (Path/join (Path/dirname ebin) "priv/sdk-code.term"))]
          (assoc acc :built (:built r) :compiled (:compiled r) :cached (:cached r)
                     :stages (assoc (:stages acc) :sources (count srcs)
                                    :sdk-code-modules inventory)))))))

(defn- do-reuse-floor
  "Package the qualified compiler floor, then leave source tiers in place. The
   library tiers are compiled by `do-library-compile` immediately after this
   stage, so a fresh drop does not compile them on first use."
  [acc tree v ebin]
  (if (failed? acc)
    acc
    (let [root (Path/dirname (rel/text (BeamLisp.Tiers/priv_root)))
          checked (seed/check {:root root})
          manifest (BeamLisp.Bootstrap/manifest)
          seed-dir (BeamLisp.Bootstrap/seed_dir)]
      (if (not (and (:ok? checked) (BeamLisp.Bootstrap/key_matches? manifest)))
        (with-error acc (str "compiler floor is not current: " (pr-str checked)))
        (do
          ;; Clear namespace outputs copied from a development image. Only the
          ;; SHA-verified floor can be reused; all other namespaces use source.
          (doseq [path (Path/wildcard (Path/join ebin "Elixir.BeamLisp.Ns.*.beam"))]
            (File/rm! path))
          (doseq [[file digest] (get manifest "modules")]
            (let [bytes (File/read! (Path/join seed-dir file))]
              (when (not= digest (Base/encode16 (crypto/hash :sha256 bytes) (list (tuple :case :lower))))
                (throw (ex-info "compiler floor artifact digest mismatch" {:file file})))
              (File/write! (Path/join ebin file) bytes)))
          (File/rm (Path/join (Path/dirname ebin) "priv/sdk-code.term"))
          (assoc acc :stages (assoc (:stages acc) :floor-reused (count (get manifest "modules")))))))))

(defn- library-root
  "The fixed root a library compile stages under. Its shape is an application
   release (`beam_lisp-0.1.0/{ebin,priv}`) because the CHILD VM resolves
   `:code.priv_dir` through it: `priv` must be the source root for the tier
   checks, and the ebin must be a real directory because the floor is installed
   into it. FIXED like `staging-root`, for the same reason — a beam embeds the
   path of the source it was compiled from."
  []
  (Path/join (System/tmp_dir) "bl-selfbuild-lib/beam_lisp-0.1.0"))

(defn- path-string
  "A code-path entry as a string. `:code.get_path/0` answers charlists."
  [p]
  (if (erlang/is_binary p) p (List/to_string p)))

(defn- copy-entry!
  "Copy a priv entry, directory or file."
  [src dst]
  (if (File/dir? src) (File/cp_r! src dst) (File/cp! src dst)))

(defn- stage-library-root!
  "Build the child VM's application root and copy the staged sources into it.

   The CHILD compiles the library tiers, not this VM: this VM already has some
   of those namespaces loaded, and recompiling a loaded namespace publishes a
   different forwarder route and is refused. The child starts with only the
   floor and the build driver loaded, exactly like the launcher's boot-tier
   rebuild child.

   `priv` receives the library tiers as copies (the tier checks hash source
   bytes and relative paths) and every OTHER payload entry as a copy too — the
   compiler key folds `priv/codegen.sources`, and the language loads NIFs from
   `priv/native`; omitting either makes the staged tree a different generation
   from the floor. `ebin` receives the running image's BEAMs so the floor can be
   installed from the seed."
  [root]
  (c/clear! root)
  (let [priv (Path/join root "priv")
        ebin (Path/join root "ebin")
        running (rel/text (BeamLisp.Tiers/priv_root))
        running-ebin (Path/join (Path/dirname running) "ebin")
        tiers (set (BeamLisp.Tiers/library_names))]
    (File/mkdir_p! priv)
    (File/mkdir_p! ebin)
    (doseq [entry (to-list (File/ls! running))]
      (let [src (Path/join running entry)]
        (cond
          (contains? tiers entry) (File/cp_r! src (Path/join priv entry))
          (contains? #{"sdk-code.term" ".claim" "parts"} entry) :ok
          :else (copy-entry! src (Path/join priv entry)))))
    (doseq [entry (to-list (File/ls! running-ebin))]
      (when (or (String/ends_with? entry ".beam") (= entry "beam_lisp.app"))
        (File/cp! (Path/join running-ebin entry) (Path/join ebin entry))))
    {:priv priv :ebin ebin}))

(defn- library-program
  "The child VM's program, as Elixir source. It installs the floor into its own
   ebin, boots the language, and runs the SAME `build/run` the non-reuse
   self-build uses. Only the process differs; the compiler, keys and manifest
   are the ones the drop was built by."
  []
  (Enum/join
    (list " [stage, ebin, mpath, lpath, jobs, shadow, result] = System.argv()"
          "BeamLisp.Bootstrap.install!(shadow)"
          "BeamLisp.AOT.boot()"
          ":ok = BeamLisp.Loader.ensure_loaded(\"build\")"
          "run = BeamLisp.Env.fetch!(\"build\", \"run\")"
          "select = BeamLisp.Env.fetch!(\"build\", \"namespace-sources\")"
          "sources = :erlang.apply(select, [stage]) |> Enum.reject(&BeamLisp.AOT.floor_file?/1) |> Enum.reject(fn p -> String.ends_with?(p, \"-fixture.bl\") end)"
          "r = :erlang.apply(run, [%{:\"log-path\" => lpath, sources: sources, root: stage, out: ebin, manifest: mpath, jobs: String.to_integer(jobs), log: &IO.puts/1}])"
          "File.write!(result, :erlang.term_to_binary(Map.put(r, :sources, length(sources))))"
          "System.halt(if Enum.count(r[:errors]) == 0, do: 0, else: 1)")
    "\n"))

(defn- run-library-child!
  "Run `library-program` in a CHILD VM, answering its result map.

   The whole running code path is handed over (`-pa`, the parent's order
   preserved), with the staged ebin prepended last so `:code.priv_dir` answers
   the staged root. A crash is reported with the child's own output."
  [root ebin scratch jobs]
  (let [exe (some-> (System/find_executable "elixir") path-string)
        result (Path/join scratch "library-result.term")
        manifest (Path/join scratch "library-manifest")
        logpath (Path/join scratch "library-build.log")
        pa (erlang/++ (Enum/flat_map (Enum/reverse (code/get_path))
                        (fn [p] (list "-pa" (path-string p))))
                      (list "-pa" (Path/join root "ebin")))
        args (erlang/++ (list "-e" (library-program) "--")
                      (list (Path/join root "priv") ebin manifest logpath (Integer/to_string jobs) (Path/join root "ebin") result))
        _ (File/rm result)
        r (System/cmd exe (erlang/++ pa args)
                     (list (tuple :cd root) (tuple :stderr_to_stdout true)
                           (tuple :into (IO/stream :stdio :line))))]
    (if (File/exists? result)
      (let [built (erlang/binary_to_term (File/read! result))]
        (if (pos? (count (:errors built)))
          {:ok? false :errors (:errors built)}
          {:ok? true :manifest (:manifest built) :built (:built built)
           :compiled (:compiled built) :cached (:cached built) :sources (:sources built)}))
      {:ok? false
       :errors (list (str "library build failed (child exit " (elem r 1) "); see child output above"))})))

(defn- do-library-compile
  "Stage 2a: compile the shipped library namespaces into the payload ebin.

   A release drop carries the compiler floor as BEAMs but the std/lib/compat/
   build tiers as SOURCE. Without this stage the first `bl run` on a fresh
   machine pays to compile every library namespace it touches; the release
   build already has the sources and the right compiler, so it pays that cost
   once, here. The manifest and log stay in `scratch` (a release carries no
   build state). `precompiled.term` indexes complete library units. The floor
   owns its boot sources and `std/multi.bl`; rebuilding either here would
   replace the exact bytes authenticated by the floor manifest.

   Test FIXTURES (`*-fixture.bl`) are not precompiled: they are inputs to tests,
   loaded on demand by the test that names them, and one of them
   (`std/reload/macro-origin-fixture.bl`) does not compile under `bl build` at
   all today (a pre-existing `Rt/nth` failure, reproducible in a checkout). A
   release must not fail its own build over a test input."
  [acc scratch ebin jobs]
  (if (failed? acc)
    acc
    (let [root (library-root)
          payload (do (stage-library-root! root) ebin)
          r (run-library-child! root payload scratch jobs)]
      (if-not (:ok? r)
        (reduce with-error acc (map (fn [e] (str "build: " e)) (:errors r)))
        (let [_ (b/relocate-unit-sources! (:manifest r) (Path/join root "priv") payload)
              inventory (BeamLisp.AOT/write_sdk_inventory! (Path/join root "priv") (:manifest r) payload
                        (Path/join scratch "library-attestation.term"))]
          (b/write-precompiled-index! (:manifest r) payload
            (Path/join (Path/dirname payload) "priv/precompiled.term"))
          (assoc acc :built (:built r) :compiled (:compiled r) :cached (:cached r)
                     :stages (assoc (:stages acc) :sources (:sources r)
                                    :sdk-code-modules inventory)))))))

(defn- do-app
  "Stage 2b: rewrite `beam_lisp.app` AFTER every payload beam exists.

   A release's `.app` is its module inventory; an entry missing from it is a
   module a release cannot start. `do-assemble` copies the running image's app,
   which names the boot floor but none of the library beams compiled here."
  [acc v ebin]
  (if (failed? acc)
    acc
    (do
      (ar/write! (Path/join ebin "beam_lisp.app") "beam_lisp" (:vsn v)
                 (ar/modules-in ebin) (rel/spec-of :beam_lisp :applications)
                 (rel/spec-of :beam_lisp :mod))
      (assoc acc :stages (assoc (:stages acc) :app-modules (count (ar/modules-in ebin)))))))

(defn- do-prime
  "Stage 2a: parse the tier sources once and ship the result in the drop.

   A cold `bl` boots a drop whose beams are fresh and whose sources it has never
   parsed, and the freshness gate parses every source of a namespace's require
   closure to prove that (measured: 14-19 s of a 15 s start). The parse is a pure
   function of the bytes, so it is done HERE, where the sources are already in
   hand, into `priv/parts/<build-key>/` of the tree being sealed
   (`build-plan/prime!`). The result is keyed by the generation this toolchain
   computes, so a payload read by another toolchain finds a different directory
   and parses, never misreads."
  [acc tree v]
  (if (failed? acc)
    acc
    (let [priv (Path/join (app-dir tree v :beam_lisp) "priv")
          n (bp/prime! priv (vec (BeamLisp.Tiers/sources priv)))]
      (assoc acc :stages (assoc (:stages acc) :primed n)))))

(defn source-provenance
  "Where the sources this build stages came from. A checkout run through
   `bin/bl` stages the checkout (`BL_ROOT`), so its git state is collected
   there, uncommitted files included. A drop rebuilding itself has no checkout:
   it reproduces the sources its payload came from, so it carries that
   payload's provenance VERBATIM. Restamping it (a new build time, a new host)
   would make every generation differ in one file, and the fixpoint gate
   (gen-2 == gen-3, byte for byte) exists to catch exactly that."
  []
  (let [checkout (System/get_env "BL_ROOT")
        running (rel/text (BeamLisp.Tiers/priv_root))]
    (if (and (some? checkout) (under? running checkout))
      (prov/collect checkout)
      (or (prov/read (running-root)) (prov/collect (running-root))))))

(defn- do-stamp
  "Stage 2b: write `BUILD_INFO.bl` at the tree's root, so the drop can say
   where it came from without being unpacked by anyone but its own launcher."
  [acc tree info]
  (if (failed? acc)
    acc
    (do (prov/write! tree info)
        (assoc acc :provenance info))))

(defn- do-pack
  "Stage 3: seal the tree with the launcher we are running as."
  [acc tree bin c out os scratch]
  (if (failed? acc)
    acc
    (let [p (d/pack tree (launcher-file bin c (Path/join scratch "launcher")) out os)]
      (if (:ok? p)
        (assoc acc :os os :offset (:offset p) :len (:len p) :sha (:sha p))
        (reduce with-error acc (map (fn [e] (str "pack: " e)) (:errors p)))))))

(defn- do-verify
  "Stage 4: the new compound must pass its own check."
  [acc out]
  (if (failed? acc)
    acc
    (let [vf (d/verify out)]
      (if (:ok? vf)
        (assoc acc :stages (assoc (:stages acc) :verify true))
        (with-error acc (str "the new compound does not verify: " (:expected vf)
                             " vs " (:actual vf)))))))

(defn run
  "Build a drop from the drop we are running as.

   opts: `{:out path :scratch dir :bin path :os n :jobs n}` — `:bin` defaults to
   `BL_BIN`, `:os` to the source drop's own tag. A qualified compiler floor is
   reused by default; `:reuse-floor? false` requests full source regeneration.

   → `{:ok? bool :out :tree :built :len :sha :stages {…} :errors [msg …]}`"
  [opts]
  (let [out (rel/text (:out opts))
        scratch (rel/text (or (:scratch opts) (Path/join (System/tmp_dir) "bl-selfbuild")))
        bin (some-> (:bin opts) rel/text)
        c (if (some? bin) (d/compound bin) nil)
        tree (Path/join scratch "tree")
        stage (staging-root)
        other (c/held-by stage)
        base {:ok? true :out out :tree tree :built 0 :ex 0 :errors []
              :running-root (running-root)
              :stages {:assemble 0 :sources 0 :verify false}}]
    (cond
      ;; Checked BEFORE the claim, so a misdirected run never takes one: the
      ;; answer is already known, and a held staging root would be released a
      ;; line later anyway.
      (some? (foreign-checkout))
      (with-error base
        (str "this build would stage " (:staged (foreign-checkout))
             ", which is not the checkout you are standing in ("
             (:cwd (foreign-checkout) ) "). \"bl self-build\" reproduces the payload"
             " it is RUNNING FROM, so a drop cannot rebuild a checkout — every"
             " error it reports would be the drop's staleness, not your source."
             " Run it through the checkout's own launcher instead:"
             " ./bin/bl self-build --bin ./bl --out ./bl-new"))

      (some? bin)
      (if (some? other)
        (with-error base (str "another self-build holds the staging root " stage
                              " (pid " (:pid other) ", since " (:at other) ")"))
        (do (c/acquire! stage bin)
            (try
              (let [v (rel/value :beam_lisp)
                    ; `:os` is the SOURCE drop's tag when there is a source drop,
                    ; and this machine's own tag when there is not (a checkout).
                    os (or (:os opts) (:os (:trailer c)) (local-os))
                    jobs (or (:jobs opts) 4)
                    ebin (Path/join (app-dir tree v :beam_lisp) "ebin")]
                (File/rm_rf! tree)
                (File/mkdir_p! tree)
                (-> base
                    (do-assemble v tree)
                    ((fn [acc] (if (not= false (:reuse-floor? opts))
                                 (-> (do-reuse-floor acc tree v ebin)
                                     (do-library-compile scratch ebin jobs)
                                     (do-app v ebin))
                                 (do-compile acc stage scratch ebin jobs))))
                    (do-prime tree v)
                    (do-stamp tree (or (:provenance opts) (source-provenance)))
                    (do-pack tree bin c out os scratch)
                    (do-verify out)))
              (finally (c/release! stage)))))

      :else
      (with-error base
                  (str "no launcher: pass --bin PATH (a stock launcher, e.g. "
                       "tooling/drop/target/release/drop-launcher) or run from a "
                       "drop, whose BL_BIN names the compound to re-seal")))))
