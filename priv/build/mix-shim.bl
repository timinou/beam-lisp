; build/mix-shim.bl — the two Mix functions a DEPENDENCY may ask, for the length
; of one compile window.
;
; ── Why this exists ────────────────────────────────────────────────────────
;
; Some packages read their own project at compile time. `explorer` — the NIF
; reader in this lock — does:
;
;     mix_config = Mix.Project.config()
;     version    = mix_config[:version]
;     github_url = mix_config[:package][:links]["GitHub"]
;     mode       = if Mix.env() in [:dev, :test], do: :debug, else: :release
;
; and those three values become the base URL of the precompiled artifact the
; package downloads. A toolchain with no Mix cannot answer them by loading Mix —
; and must not answer them by inventing values, which would fetch the wrong
; artifact for the wrong version.
;
; ── What it answers with ───────────────────────────────────────────────────
;
; The package's OWN declaration, evaluated by `deps-compile/project-of` from its
; own `mix.exs` — the same read that produces the `.app` this toolchain writes.
; `Mix.env/0` answers `:prod`, the honest answer for a build with no `MIX_ENV`:
; a package that branches on it (test-only support paths, debug artifacts) takes
; its production branch.
;
; ── The window is explicit, and closed ─────────────────────────────────────
;
; `install!` defines both modules in THIS VM; `remove!` purges and deletes them
; again, so `Code.ensure_loaded?(Mix)` cannot answer `true` for a caller outside
; the window. That discipline is the point: a shim left standing would be a lie
; about the image, and every Mix guard in this tree (`AOT`'s output-dir default,
; the dev-server gate) would take a path that does not exist. `deps-compile`
; calls this from exactly one place, with a `finally`.
;
; It is installed rather than conditionally-installed on purpose: deciding by
; scanning sources for the string "Mix." would miss the case where a macro
; expands to the call, and the window costs two tiny modules.
;
; WRITTEN IN BEAM-LISP, and it has to be: the caller is the dependency compiler,
; which is beam-lisp. An Elixir module doing this would be load-bearing Elixir
; for a decision the language can make itself — the only Elixir it touches is
; `Code.compile_string/1`, the substrate call that has no beam-lisp equivalent
; (defining a module named `Mix` at runtime cannot be done by defining one).

(ns mix-shim)

(def project-key :bl_deps_compile_project)
(def window-key :bl_deps_compile_window)

; Defined from a string, never as a module of our own: a `Mix.Project`
; written into this tree would be compiled into the substrate and would shadow
; the real Mix for the lifetime of every VM that loads it — including a
; checkout, where Mix exists and other guards ask about it.
(def source
  (str "defmodule Mix.Project do\n"
       "  @moduledoc false\n"
       "  def config, do: :persistent_term.get(:bl_deps_compile_project, [])\n"
       "end\n"
       "\n"
       "defmodule Mix do\n"
       "  @moduledoc false\n"
       "  def env, do: :prod\n"
       "end\n"))

(defn- shim-modules
  "The two modules this window owns, as atoms."
  []
  (list (erlang/binary_to_atom "Mix.Project" :utf8)
        (erlang/binary_to_atom "Mix" :utf8)))

(defn install!
  "Define `Mix` and `Mix.Project` for the compile window that follows."
  []
  (erlang/apply :persistent_term :erase (list project-key))
  (erlang/apply :persistent_term :put (list window-key true))
  ; A CHECKOUT has the real Mix loadable (it ships with Elixir), so defining
  ; these two modules there is a redefinition and the compiler says so. The
  ; warning is true and unwanted: the redefinition IS the design, and `remove!`
  ; puts the code server back where it was. The option is saved and restored
  ; rather than forced, so a caller's own setting survives.
  (let [prev (Code/get_compiler_option :ignore_module_conflict)]
    (Code/put_compiler_option :ignore_module_conflict true)
    (try
      (Code/compile_string source)
      (finally (Code/put_compiler_option :ignore_module_conflict prev))))
  :ok)

(defn publish!
  "Publish a package's own `project/0` as the answer to `Mix.Project.config/0`.

   Called by `deps-compile/project-of` with what it just read from the package's
   `mix.exs`, so the config a package sees while compiling IS the declaration it
   ships — not a reconstructed subset of it."
  [project]
  (when (some? project)
    ; `Enum/to_list` is load-bearing: a list built IN beam-lisp is a Vector (a
    ; struct — an Erlang map), and Mix's config is indexed as `config[:version]`
    ; and `config[:package][:links]`. Handed a Vector, either access fails —
    ; measured with a probe that published a bl list and read back nil. The
    ; real caller passes what a package's own `project/0` returned (already an
    ; Erlang keyword list), so this conversion is a no-op there and the fix for
    ; everything else.
    (erlang/apply :persistent_term :put (list project-key (Enum/to_list project))))
  :ok)

(defn remove!
  "Undo `install!`: erase the published project, purge and delete both modules."
  []
  (erlang/apply :persistent_term :erase (list project-key))
  (erlang/apply :persistent_term :erase (list window-key))
  (doseq [m (shim-modules)]
    (erlang/apply :code :purge (list m))
    (erlang/apply :code :delete (list m)))
  :ok)

(defn installed?
  "Whether a compile window is open."
  []
  (erlang/apply :persistent_term :get (list window-key false)))
