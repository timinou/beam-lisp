; build/store.bl — THE LIBRARY STORE: where a dependency lives once it is known.
;
; One rule decides everything here: A LIBRARY'S ADDRESS IS CONTENT. The path is
; `<name>-<vsn>-<sha8>` from the lock's own digest, so a version whose contents
; changed without its digest changing cannot exist, and two trees sharing a store
; share exactly the bytes their locks name. The same rule the datom blob store
; follows, and the same one the AOT cache follows.
;
; Nothing above the store inspects a library's SOURCE to decide anything: it
; either finds the bytes its lock names or it does not.
;
; ── What `verify` does and does not prove ──────────────────────────────────
;
; `verify` is OFFLINE and cheap: it answers "is every locked library present, and
; does the digest recorded beside it agree with the lock?" — the question a build
; asks before it starts and the question CI asks without a network. It does NOT
; re-hash a library's files: the digest in a hex lock is the digest of the
; TARBALL, which the store does not keep. `install!` is where the tarball's
; digest is checked, against the bytes themselves, and it is checked BEFORE the
; rename that makes the library visible. So the store is trustworthy because
; nothing enters it unverified, and `verify` reports the state rather than
; re-deriving it. A store whose `.hex-sha` file was hand-edited is a store
; someone attacked directly — that is what a signature is for, not this.

(ns store
  (:require [drop :as d] [claim :as c]))

(defn root
  "The shared store: `$XDG_CACHE_HOME/beam_lisp/lib`, or `~/.cache/...`."
  []
  (let [xdg (System/get_env "XDG_CACHE_HOME")
        base (if (and (some? xdg) (not= "" xdg))
               xdg
               (Path/join (System/get_env "HOME") ".cache"))]
    (Path/join (Path/join base "beam_lisp") "lib")))

(defn dir-for
  "The store path for one library, addressed by content."
  ([name vsn sha] (dir-for (root) name vsn sha))
  ([root name vsn sha]
   (Path/join root (str name "-" vsn "-" (subs sha 0 8)))))

(defn sha-file
  "Where a library's lock digest is recorded, beside the library's bytes."
  [dir]
  (Path/join dir ".hex-sha"))

(defn present?
  "Whether the store holds this library AND remembers the digest it was installed
   under."
  [name vsn sha]
  (let [dir (dir-for name vsn sha)]
    (and (File/dir? dir)
         (File/exists? (sha-file dir))
         (= sha (String/trim (File/read! (sha-file dir)))))))

(defn- lock-entry
  "One `{:name :vsn :sha}` from a lock map."
  [e]
  {:name (:name e) :vsn (:vsn e) :sha (:sha e)})

(defn verify
  "Does the store hold exactly what `lock` names? OFFLINE: no network, no hex —
  the bytes on disk against the digest recorded with them. Returns
  `{:ok? :checked :missing [{:name :vsn :sha} …]}`."
  [lock]
  (let [deps (vec (:deps lock))
        missing (vec (remove (fn [e] (present? (:name e) (:vsn e) (:sha e)))
                             (map lock-entry deps)))]
    {:ok? (empty? missing) :checked (count deps) :missing missing}))

(defn install-dir!
  "Install a DIRECTORY of files as the library `(name, vsn, sha)`:\n\n   copy to a temp dir beside the destination, record the digest, then RENAME.\n\n   The rename is the whole point: a library becomes visible under its content\n   address only when it is complete, so a build that dies mid-install leaves a\n   temp dir to sweep, never a half-library that looks locked."
  [name vsn sha from]
  (let [dir (dir-for name vsn sha)
        tmp (str dir ".tmp-" (c/owner-pid))]
    (File/rm_rf! tmp)
    (File/mkdir_p! (Path/dirname dir))
    (File/mkdir_p! tmp)
    (File/cp_r! from tmp)
    (File/write! (sha-file tmp) sha)
    (File/rm_rf! dir)
    (File/rename tmp dir)
    dir))

(defn sweep-temp!
  "Remove leftover `.tmp-*` directories in the store. A killed install leaves one;
   nothing else ever does, so this needs no bookkeeping to be safe."
  []
  (let [r (root)]
    (if (File/dir? r)
      (let [tmps (filter (fn [p] (some? (index-of (Path/basename p) ".tmp-")))
                         (Path/wildcard (Path/join r "*")))]
        (doseq [t tmps] (File/rm_rf! t))
        (count tmps))
      0)))

(defn entries
  "What the store actually holds, sorted: `[{:name :vsn :sha8 :dir} …]` read from
   the directories themselves, so `bl deps list` reports the disk, not the lock."
  []
  (let [r (root)]
    (if-not (File/dir? r)
      []
      (vec (sort-by (fn [e] (:dir e))
                    (keep (fn [p]
                            (let [base (Path/basename p)
                                  parts (String/split base "-")
                                  n (count parts)]
                              (when (and (File/dir? p) (>= n 3))
                                {:name (join "-" (take (- n 2) parts))
                                 :vsn (nth parts (- n 2))
                                 :sha8 (nth parts (dec n))
                                 :dir p})))
                          (Path/wildcard (Path/join r "*"))))))))
