; build/embed-asset.bl — THE PINNED STATIC CODE-EMBEDDING MODEL, fetched.
;
; `mix bl.embed.fetch` did this; `bl embed fetch` must, with no Mix and no
; `Mix.Task` left in the tree. This namespace is the whole of that task: resolve
; where the weights go, fetch the three pinned files from HuggingFace over hex's
; transport, verify each against its pin BEFORE it is written, and leave the
; DIGEST file that makes a directory a model at all.
;
; ── What is fetched, and why this model ────────────────────────────────────
;
; `minishlab/potion-code-16M-v2` — a Model2Vec *static* embedding model: 16M
; parameters, 256 dimensions, ~32 MB on disk, distilled from
; `nomic-ai/CodeRankEmbed` on the CornStack code corpus. A lookup table plus a
; mean, not a transformer, so an embed is a hash lookup rather than a forward
; pass. The whole point is that it is the smallest thing that still retrieves
; code by meaning: a code transformer of comparable quality
; (`jina-embeddings-v2-base-code`, 161M params) costs ~20x the resident memory
; and ~1000x the latency for a corpus this size.
;
; Three files, all three pinned by sha256 below. The digest is the contract: an
; upstream re-upload that changes one weight byte must fail LOUDLY here rather
; than quietly change what every already-cached embedding in every index means.
; A vector space is identified by its weights; silently swapping them makes
; every stored vector a lie.
;
; ── Where it goes ──────────────────────────────────────────────────────────
;
;   * `:dir PATH` — writes into PATH itself, for a test or an unusual install.
;   * `:bundle`   — `<priv>/embed/<name>`: the copy `bl build` packs into a
;     drop. That is what makes a shipped `bl` answer with no network, no Mix and
;     no cache on the box.
;   * default     — the AMBIENT cache: `$BEAM_LISP_MODEL_DIR`, else
;     `$XDG_CACHE_HOME/beam_lisp/models`. Shared across checkouts and worktrees:
;     one ~32 MB copy per machine, not per tree. This is what a person working
;     on beam-lisp wants.
;
; A drop reads the BUNDLED copy; a source tree reads whichever exists. That
; choice is a reader's, not a fetch's — see `priv/lib/code/embed.bl`.
;
; The capability stays OPTIONAL either way: everything that uses it checks
; availability first and reads as absent when the weights are not there.
;
; ── Offline ───────────────────────────────────────────────────────────────
;
; Only this file touches the network, and only when something asks it to fetch.
; Nothing at query time does: after one fetch, semantic search over code runs
; with the machine unplugged.
;
; ── The Elixir twin, now redundant ────────────────────────────────────────
;
; `lib/beam_lisp/model.ex` (`root/0`, `ambient_dir/1`, `bundled_dir/1`,
; `dir_env/0`, `files/0`, `fetched?/1`) is the Elixir TWIN of what this file
; resolves for itself, and `lib/mix/tasks/bl.embed.fetch.ex` is the twin of
; `fetch!`. Both should be RETIRED, and nothing here edits them: with Mix gone
; there is one caller of each rule (`priv/lib/code/embed.bl` asks where the
; weights are, this file fetches into that directory), and two implementations
; of "where do the weights live / is this copy complete?" is exactly how a fetch
; into one root and a read from another becomes a capability that silently reads
; as absent. The rules below are the port; the port is what makes the twin dead
; code.

(ns embed-asset
  (:require [hex :as h] [drop :as d]))

; ── the pin ────────────────────────────────────────────────────────────────

(def model "minishlab/potion-code-16M-v2")

(def base (str "https://huggingface.co/" model "/resolve/main"))

; The DIRECTORY is the bare model name, because that is what the code that reads
; the weights computes for itself (`code.embed/MODEL` → the model's own
; directory). The org prefix belongs to the URL and stops there: resolving it
; into the path put the files under `models/minishlab/potion-code-16M-v2`, which
; nothing ever looks in — the fetch reported success while semantic search still
; saw no model on disk.
(def dir-name "potion-code-16M-v2")

; name → sha256 (pinned; computed from the upstream artifacts at the revision
; whose weights these are), in the order the fetch writes them — sorted, which
; is the order `Enum.sort(@files)` produced in the Mix task this replaces. Sizes
; are not pinned, only reported, because 32 MB of weights make a partial
; download visible as one.
(def files
  [["config.json" "148e5691a6fcc553437156859701fba017a1ba5d340b170f17e0f3668fb861a7"]
   ["model.safetensors" "75cf7a6c2171b230ad19b1e7d8e0b1aee86da5a02af8e7cacedd9921d227623c"]
   ["tokenizer.json" "107bbdcbad4bff1d299b7a4c3a2fb17c52890688b7dd0e4c9deab79d3c4f3d45"]])

(def weights "model.safetensors")

; The digest file's NAME, written LAST, after every weight has verified. It
; holds the model.safetensors pin: the weights' digest, on disk, for the code
; that has to decide whether a cached vector is still current. Verifying 32 MB
; of weights on every query would be absurd; verifying them ONCE, here, is what
; pinning them buys.
(def digest-name "DIGEST")

(def provenance-name "PROVENANCE")

; Retried, because the model host resets a small fraction of connections
; (observed: `Recv failure: Connection reset by peer` on an otherwise healthy
; route). A single retry-with-backoff is the difference between "fetching the
; model works" and "fetching the model works if you are lucky", and there is
; nothing here a retry can corrupt: a partial body never reaches the digest
; check.
(def retries 3)
(def retry-pause 1000)

(def env-dir "BEAM_LISP_MODEL_DIR")

(defn- name-of [f] (first f))
(defn- sha-of [f] (second f))

(defn- sha-of-named
  "The pinned sha256 of the file called `name`."
  [name]
  (sha-of (first (filter (fn [f] (= name (name-of f))) files))))

; ── where the weights live ─────────────────────────────────────────────────
;
; The rule, once, for the three roots a caller can name (see the header). The
; directory a READER should take is `BeamLisp.Model.dir/1`'s business and is not
; this file's: a fetch writes where it is told, and reports it.

(defn- to-path
  "`x` as a path string. OTP answers some of these as CHARLISTS
   (`:code.priv_dir/1`, `:filename.basedir/2`), and `File`/`Path` accept either
   — but a path that is going to be printed or joined is a string."
  [x]
  (cond
    (erlang/is_binary x) x
    (erlang/is_list x) (erlang/list_to_binary x)
    :else (str x)))

(defn priv-root
  "beam-lisp's `priv/`: `:code.priv_dir/1` when it answers a REAL directory (a
   release, a `_build` tree, an extracted drop), else the checkout this code is
   running from, else the `priv` under the cwd.

   The check is the point: an escript answers `priv_dir` with a path INSIDE its
   archive, which no `File`/`Path` call can see — the same reason
   `BeamLisp.Tiers.priv_root/0`, the Elixir twin of these four lines, falls back
   to the tree."
  []
  (or (let [d (to-path (erlang/apply :code :priv_dir (list :beam_lisp)))]
        (if (File/dir? d) d nil))
      (let [d (Path/join (System/cwd) "priv")]
        (if (File/dir? d) d nil))
      "priv"))

(defn bundled-root
  "The BUNDLED root, `<priv>/embed/`: what `bl build` ships, and what a drop
   reads the weights from."
  []
  (Path/join (priv-root) "embed"))

(defn bundled-dir
  "The bundled directory for `name` — where a `:bundle` fetch writes."
  [name]
  (Path/join (bundled-root) name))

(defn cache-root
  "Where this machine keeps beam-lisp's derived state: `$XDG_CACHE_HOME/beam_lisp`,
   else `~/.cache/beam_lisp`. OTP's own answer, and the one
   `BeamLisp.Cache.root/0` asks for; read PER CALL, never memoised, because a
   test sets the variable and expects the next call to see it."
  []
  (to-path (erlang/apply :filename :basedir (list :user_cache (erlang/binary_to_list "beam_lisp")))))

(defn dir-env
  "The environment variable that overrides the ambient root — SET MEANS ANSWER."
  []
  env-dir)

(defn ambient-root
  "The AMBIENT root: `$BEAM_LISP_MODEL_DIR`, else `<cache>/models`.

   This is where a fetch writes by DEFAULT, and what a person working on
   beam-lisp wants: shared across checkouts, worktrees and branches, which is
   the arithmetic that keeps 32 MB out of every tree."
  []
  (let [pin (System/get_env env-dir)]
    (if (some? pin)
      (Path/expand pin)
      (Path/join (cache-root) "models"))))

(defn ambient-dir
  "The ambient directory for `name` — where a plain fetch writes."
  [name]
  (Path/join (ambient-root) name))

(defn dest-for
  "The directory `fetch!` writes into for `opts` — the same cond the Mix task
   ran: an explicit `:dir` wins, else `:bundle` picks the copy a drop carries,
   else the ambient cache."
  [opts]
  (cond
    (some? (:dir opts)) (:dir opts)
    (= true (:bundle opts)) (bundled-dir dir-name)
    :else (ambient-dir dir-name)))

(defn fetched?
  "Whether `dir` holds a COMPLETE fetched copy: the `DIGEST` file this namespace
   writes LAST, after every weight has verified against its pinned sha256, AND
   the files that digest stands for.

   Both halves are required, because a directory that passes this and cannot be
   read is worse than an absent one: the caller stops looking, and the failure
   surfaces later as a parse error instead of as \"not on disk\". And because the
   digest is written after the last file, a PARTIALLY fetched directory answers
   false here — which is the whole reason it is written last."
  [dir]
  (and (File/regular? (Path/join dir digest-name))
       (every? (fn [f] (File/regular? (Path/join dir (name-of f)))) files)))

; ── fetching ───────────────────────────────────────────────────────────────

(defn- digest-of
  "The lowercase hex sha256 of `path`'s bytes, or nil when it cannot be read."
  [path]
  (try (d/sha256-hex (File/read! path)) (catch _ nil)))

(defn- verified?
  "Whether the file at `path` IS the pinned artifact: its digest equals `sha`.
   An unreadable file is not verified — the answer to a missing file, a
   permission error and a truncated one is the same here (fetch it), which is
   why the read failure is folded away rather than reported."
  [path sha]
  (= sha (digest-of path)))

(defn- download
  "`{:ok body}` or `{:error reason}` for `url`, retried `attempts` times with
   `retry-pause` between tries. Over hex's transport: this is the same `:httpc`
   + verified-TLS path hex downloads tarballs through, and it starts `:inets`
   and `:ssl` itself."
  [url attempts]
  (let [r (try (h/fetch (h/httpc-transport) url {:binary? true})
               (catch e {:error (ex-message e)}))]
    (cond
      (some? (:ok r)) r
      (> attempts 1) (do (Process/sleep retry-pause) (download url (dec attempts)))
      :else r)))

(defn- fetch-one
  "One pinned file: `{:ok :cached}` when the copy on disk already matches its
   pin, `{:ok :fetched}` when it crossed the network and was written, or
   `{:error reason}`.

   The reason NAMES THE FILE, because a caller asking what went wrong must not
   have to guess which of three downloads it was. Nothing is written before the
   digest is checked: `File/write!` is the last step, so a mismatched or
   truncated body never becomes a file a later run has to tell apart from a good
   one."
  [dest force? name sha]
  (let [path (Path/join dest name)]
    (if (and (not force?) (verified? path sha))
      {:ok :cached}
      (try
        (let [r (download (str base "/" name) retries)]
          (if (:error r)
            {:error (str "download failed for " name ": " (:error r))}
            (let [body (:ok r)
                  actual (d/sha256-hex body)]
              (if (not= sha actual)
                {:error (str "sha256 mismatch for " name
                             " — pinned " sha ", actual " actual
                             " (the upstream artifact changed; re-verify the new"
                             " weights before re-pinning, because every embedding"
                             " cached against the old ones is in a different space)")}
                (do (File/write! path body) {:ok :fetched})))))
        (catch e {:error (str name ": " (ex-message e))})))))

(defn fetch!
  "Fetch the pinned model into `opts`'s destination, and answer what happened:

     {:ok? true  :dir path :files [name …] :fetched n :why nil}
     {:ok? false :why reason}

   opts: `{:dir path-or-nil :bundle bool :force bool}`.

   `:dir` wins, else `:bundle` picks the copy a drop carries, else the ambient
   cache (see `dest-for`). `:force` re-downloads even a file that already matches
   its pin; without it a cached file is not fetched again, which is what makes a
   second run free. `:fetched` counts the files that crossed the network THIS
   run, and `:files` is what the directory holds when the answer is ok.

   A sha256 that does not match its pin writes NOTHING and answers
   `{:ok? false :why …}` naming the file; a network failure answers the same
   way. This never raises, so a caller keeps which file failed and why."
  [opts]
  (let [dest (dest-for opts)
        force? (= true (:force opts))]
    (try
      (do
        (File/mkdir_p! dest)
        (let [r (loop [rest files fetched 0]
                  (if (empty? rest)
                    {:ok? true :dir dest :files (vec (map name-of files))
                     :fetched fetched :why nil}
                    (let [f (first rest)
                          one (fetch-one dest force? (name-of f) (sha-of f))]
                      (cond
                        (:error one) {:ok? false :why (:error one)}
                        (= :fetched (:ok one)) (recur (rest rest) (inc fetched))
                        :else (recur (rest rest) fetched)))))]
          (if (:ok? r)
            (do
              (File/write! (Path/join dest digest-name) (sha-of-named weights))
              (File/write! (Path/join dest provenance-name) (provenance dest))
              r)
            r)))
      (catch e {:ok? false :why (str "fetching into " dest ": " (ex-message e))}))))

; ── provenance ─────────────────────────────────────────────────────────────
;
; Provenance, because these weights SHIP inside the drop: a redistributed
; artifact carries its origin, its licence and the digests it was pinned by,
; next to the bytes rather than in a commit message nobody has. MIT (per the
; upstream model card) requires the notice to travel with the copy.

(defn- pad2 [n] (String/pad_leading (Integer/to_string n) 2 "0"))

(defn- now-iso8601
  "\"2026-09-16T08:48:50Z\" — the second-precision UTC instant
   `DateTime.utc_now() |> DateTime.truncate(:second) |> DateTime.to_iso8601()`
   wrote in the Mix task, taken from OTP's own clock rather than Elixir's
   calendar."
  []
  (let [t (erlang/apply :calendar :universal_time (list))
        date (erlang/element 1 t)
        time (erlang/element 2 t)]
    (str (erlang/element 1 date) "-" (pad2 (erlang/element 2 date)) "-" (pad2 (erlang/element 3 date))
         "T" (pad2 (erlang/element 1 time)) ":" (pad2 (erlang/element 2 time)) ":" (pad2 (erlang/element 3 time))
         "Z")))

(defn- digest-lines
  "The three pinned digests, one per line, names padded to a column — the shape
   `Enum.map_join` wrote."
  []
  (join "\n" (map (fn [f] (str "  " (String/pad_trailing (name-of f) 18) " " (sha-of f))) files)))

(defn- provenance
  "The PROVENANCE file, in the same shape the Mix task wrote it."
  [dest]
  (str "PROVENANCE — " model "\n"
       "\n"
       "A static code-embedding model (Model2Vec: a lookup table and a mean, not a\n"
       "transformer), redistributed inside a beam-lisp drop.\n"
       "\n"
       "  upstream:  https://huggingface.co/" model "\n"
       "  fetched:   " (now-iso8601) "\n"
       "  by:        bl.embed.fetch (--bundle for the copy a drop carries)\n"
       "  into:      " dest "\n"
       "  licence:   MIT (per the upstream model card; the upstream repository\n"
       "             ships no separate LICENSE file — see the model card)\n"
       "\n"
       "sha256 of the three files this pinned revision is identified by:\n"
       "\n"
       (digest-lines) "\n"
       "\n"
       "Those digests are the contract, and the model.safetensors one is the model's\n"
       "IDENTITY: every stored embedding records it, so weights that change silently\n"
       "would make every cached vector a lie. A copy without a DIGEST file beside it\n"
       "is not a model any caller will read (see `embed-asset/fetched?`).\n"))
