; build/source-graph.bl — the namespace graph as data, and what to hash from it.
;
; A beam-lisp program is a set of files, each opening with `(ns name (:require …))`.
; Those `:require` clauses are EDGES; the files are NODES. Everything the build
; wants to know about freshness — "which beams does this edit invalidate?" — is
; a question over that graph, so the graph lives in one place, written in the
; language it describes.
;
; Three things live here:
;
;   header        one file's node: its declared ns and direct requires. Read by
;                 the real reader (one parser — never a regex twin of it), so a
;                 `:require` inside a comment or a string is never an edge.
;   closure       the transitive requires of a ns, itself included. Cycle-safe.
;   closure-hash  sha256 over every `ns:hash` line of a closure. Changes iff
;                 the ns OR anything it transitively requires changes — this is
;                 the per-namespace freshness key the manifest stores, the beam
;                 stamps in `__bl_provenance__`, and the runtime drift gate
;                 compares. All three call THIS fn with THE SAME callbacks, so
;                 they cannot drift apart.
;
; Callers hand in two functions instead of files, so the graph never touches
; the disk itself:
;
;   (srchash ns) → content hash of that ns's source, or nil when unresolvable
;   (reqs ns)    → that ns's direct requires
;
; An unresolvable member hashes as "ns:?" rather than vanishing — a require
; that STOPS resolving is itself a change worth rebuilding for.
;
; ── Why this file uses only host calls ──────────────────────────────────────
;
; The drift gate asks this graph while `core` is still being loaded (the gate
; vets core's own beam), and a test may ask it from a fresh forked Env with no
; prelude interned. So nothing here may reach a `core` var: every operation is
; a direct `erlang/`, `lists/`, `crypto/` or `reader-node` call, all of which
; are linked at compile time and need no var lookup at run time. The payoff is
; a graph that is callable from ANY Env at ANY point of boot, and whose entire
; semantic dependency is the reader. That is also what makes it fast: no
; dispatch, no lazy seqs, plain Erlang lists end to end.

(ns source-graph
  (:require [reader-node :as rn]))

; Pure algorithms live in the pinned compiler kernel; these preserve Source APIs.

(defn- tag-is?
 [node tag]
 (BeamLisp.SourceGraph/tag-is? node tag))

(defn- ns-form?
 "Is this bare reader node an `(ns …)` list?"
 [form]
 (BeamLisp.SourceGraph/ns-form? form))

(defn- require-target
 "The namespace a `:require` spec names, as `{true ns}` for lists/filtermap,
   or false when the spec names nothing: `foo` → foo, `[foo :as f]` → foo."
 [spec]
 (BeamLisp.SourceGraph/require-target spec))

(defn- require-clause?
 "Is this ns clause a `(:require …)` list?"
 [clause]
 (BeamLisp.SourceGraph/require-clause? clause))

(defn- clause-requires
 "Requires named by one ns clause; the empty list when it is not a require."
 [clause]
 (BeamLisp.SourceGraph/clause-requires clause))

(defn- dedupe
 "First occurrence of each element, order preserved. O(n·k) over the k
   distinct names — an ns form names a handful, so this beats building a set."
 [xs]
 (BeamLisp.SourceGraph/dedupe xs))

(defn- spec-aliases
 "For one `:require` spec, the `[alias target]` pairs it introduces: `[t :as
   a]` → ([\"a\" \"t\"]); a bare or alias-less spec → (). Also the target's
   own name maps to itself, so `t/x` and `a/x` resolve alike."
 [spec]
 (BeamLisp.SourceGraph/spec-aliases spec))

(defn- spec-refer-all?
 "Does this spec say `:refer :all`? Then every bare name in the file MAY
   come from its target, and no name-level attribution is possible."
 [spec]
 (BeamLisp.SourceGraph/spec-refer-all? spec))

(defn- spec-refers
 "For one `:require` spec, the `[name target]` pairs its `:refer [a b]`
   introduces (a `:refer :all` is handled by `spec-refer-all?`)."
 [spec]
 (BeamLisp.SourceGraph/spec-refers spec))

(defn forms
 "Read a source into bare reader forms ONCE. Every fn below has a `-forms`
   variant taking this, so the build reads each file a single time (five
   reads per file was the node-build cost: 5s for 116 sources)."
 [content]
 (BeamLisp.SourceGraph/forms content))

(defn header*-forms
 "`header*` over already-read forms."
 [forms]
 (BeamLisp.SourceGraph/header*-forms forms))

(defn- bare-header-node
 "Normalize only a namespace header, not the complete program. Position and
   author metadata have no effect on dependency or alias identity."
 [node]
 (BeamLisp.SourceGraph/bare-header-node node))

(defn header*-nodes
 "header* over actual positioned Reader nodes. Only the chosen ns header is
   normalized; executable bodies are neither copied nor parsed again."
 [nodes]
 (BeamLisp.SourceGraph/header*-nodes nodes))

(defn header*
 "`header` plus what a name-resolver needs: `[ns requires aliases refers
   refer-all]`, where `aliases` maps every alias AND every required ns name
   to the ns it denotes, `refers` maps each explicitly referred name to its
   ns, and `refer-all` lists the namespaces required with `:refer :all`."
 [content]
 (BeamLisp.SourceGraph/header* content))

(defn references
 "The `{ns → sorted (name …)}` of every QUALIFIED reference `prefix/name` in
   `content` whose prefix is a required ns or an alias of one, plus every
   explicitly `:refer`red name under its ns. This is what a dependent can
   observe of each required namespace by NAME — the coverage input for
   interface keying (see ns-interface). A namespace required with
   `:refer :all` gets the single entry `:all`: its bare names cannot be
   attributed, so no interface can be shown to cover the edge.

   Walks the reader forms, so a `x/y` inside a comment or string never counts."
 [content]
 (BeamLisp.SourceGraph/references content))

(defn references-forms
 "`references` over already-read forms."
 [forms]
 (BeamLisp.SourceGraph/references-forms forms))

(defn header
 "The node a source file declares: `[ns requires]`.

   `ns` is the name in the leading `(ns …)` form, nil when the file has none
   (it then compiles into `user`). `requires` lists the namespaces its
   `:require` clauses name, in order, without duplicates. Only the FIRST
   symbol of each spec vector counts — `[a :refer [x y]]` contributes `a`."
 [content]
 (BeamLisp.SourceGraph/header content))

(defn header-forms
 "`header` over already-read forms."
 [forms]
 (BeamLisp.SourceGraph/header-forms forms))

(defn- as-list
 "A caller's `reqs` may answer with a vector, a list, or nil; the walk wants
   an Erlang list. `Enum.to_list` covers every beam-lisp collection."
 [xs]
 (BeamLisp.SourceGraph/as-list xs))

(defn closure
 "Every namespace `ns` transitively requires, including `ns`. A sorted list
   without duplicates. Each node is expanded once — `seen` is a map, so the
   walk is O(V + E) with O(1) membership — and the frontier is a plain list,
   so it is a depth-first walk that terminates on cycles."
 [ns reqs]
 (BeamLisp.SourceGraph/closure ns reqs))

(defn cycles
 "Every require cycle reachable from `roots`, as a list of paths
   `(ns … ns)` whose last element repeats an earlier one — the NAME of the
   cycle, ready to print. `reqs` is the same callback `closure` takes
   (ns → direct requires, any collection or nil).

   This is the one place cycle KNOWLEDGE lives: `closure` must stay total
   (a hash cannot skip what it cannot see), so its back-edge is silent;
   here the same back-edge is recorded as the path the DFS was on when it
   re-met a node still on its own stack. Each node is expanded once
   (`:done`), so the walk is O(V + E) and terminates on any graph."
 [roots reqs]
 (BeamLisp.SourceGraph/cycles roots reqs))

(defn hash-lines
 "sha256 hex over `lines` joined by a NUL byte — the one digest shape every
   freshness key uses, so the build and the runtime hash alike."
 [lines]
 (BeamLisp.SourceGraph/hash-lines lines))

(defn closure-hash
 "The freshness key of `ns`: sha256 over the sorted `ns:hash` line of every
   member of its require-closure. Deterministic in the two callbacks alone."
 [ns srchash reqs]
 (BeamLisp.SourceGraph/closure-hash ns srchash reqs))
