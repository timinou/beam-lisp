; One callback-tail grammar for compilation, analysis and target lowering.
; Predicates adapt reader nodes/plain macro data; no source is evaluated here.
(ns server-clause (:require [reader-node :as rn]))

(defn parse-tail
 "Normalize [parameters] :when guard body, or :when guard [parameters] body.
  The guard-presence bit distinguishes an explicit nil guard from no guard.
  Refuse missing/duplicate guards and malformed tails before any body executes."
 [forms vector-form? when-form?]
 (let [forms (BeamLisp.CompilerData/eager_to_list forms)
       fail (fn [message] (throw (ex-info message {:kind :invalid-server-clause})))
       before? (and (seq forms) (when-form? (first forms)))
       _ (when (and before? (< (count forms) 3))
           (fail "Server :when needs a guard and a parameter vector"))
       remaining (if before? (Enum/drop forms 2) forms)
       params (first remaining)
       _ (when-not (and (seq remaining) (vector-form? params))
           (fail "Server callback parameters must be a vector"))
       after (rest remaining)
       after? (and (seq after) (when-form? (first after)))
       _ (when (and before? after?) (fail "Server callback has duplicate :when guards"))
       _ (when (and after? (< (count after) 2))
           (fail "Server :when must be followed by a guard expression"))
       body (if after? (Enum/drop after 2) after)
       _ (when (empty? body) (fail "Server callback needs a body after its parameters and guard"))]
  {:params params :guarded? (or before? after?)
   :guard (cond before? (second forms) after? (second after) :else nil)
   :body body}))

(defn guard-node
 "Normalize a never-passing nil guard to false. Metadata is transparent to
  language nil?, so wrapping nil cannot distinguish it from an absent guard."
 [value position]
 (if (nil? value) (rn/meta-node false (or position {})) value))

(defn read-tail [forms]
 (let [parsed (parse-tail forms #(= :vector (rn/node-tag (rn/node-form %)))
  #(let [node (rn/node-form %)]
    (and (= :keyword (rn/node-tag node)) (= "when" (rn/node-name node)))))]
  (if (:guarded? parsed) (update parsed :guard #(guard-node % nil)) parsed)))

(defn data-tail [forms]
 (parse-tail forms vector? #(= :when %)))
