; boot/lower.bl — bl-ANF → Core Erlang → .beam: THE backend (PLAN-079 S-C/S-D,
; PLAN-086 E1).
;
; Graduated from priv/self/core.bl to the boot tier in PLAN-086 E1: this is the
; lowering compiler.bl's output flows through, so it lives where the toolchain
; can reach it. The QUOTED lowerers (lower/defs->module/core-defvar — the
; Elixir-quoted readers) stay behind in priv/self/core.bl until compiler.bl
; emits bl-ANF directly and they are deleted (E5).
;
; cerl, compile:forms, code:load_binary, core_pp are all public OTP APIs,
; reached through plain erlang/-style interop. No Elixir compiler is on this
; path.

(ns lower (:require [anf :as anf]))

;; ── tiny cerl surface ───────────────────────────────────────────────────────

(defn lit [v] (cerl/abstract v))
(defn catom [a] (cerl/c_atom a))
(defn cvar [name] (cerl/c_var name))
(defn ccall [m f args] (cerl/c_call (catom m) (catom f) (to-list args)))
(defn capply [f args] (cerl/c_apply f (to-list args)))
(defn cfun [vars body] (cerl/c_fun (to-list vars) body))
(defn cfun-anno
  "cfun plus the [function: {name arity}] annotation v3_core stamps on every
   fun. A MODULE-LEVEL fun that (transitively) contains a raw_raise primop
   must carry it — without it the primop degrades to a returned :badarg
   (nested funs are unaffected). Mirror of what erlc's core output shows."
  [fname arity vars body]
  (cerl/set_ann (cfun vars body) (list (tuple :function (tuple fname arity)))))
(defn craise
  "Re-raise the caught exception, preserving class, reason and stacktrace.

   A plain `erlang:raise/3` call does NOT work from Core Erlang: from_core
   starts after v3_core (the pass that rewrites raise/3), and the call quietly
   RETURNS :badarg instead of raising — every error escaping an evaluated form
   surfaced as the atom :badarg. v3_core emits `primop raw_raise(class,
   reason, stack)`; emit exactly that (plus the enclosing-fun annotation, see
   cfun-anno)."
  [cls rsn stk]
  (cerl/c_primop (catom :raw_raise) (to-list (list cls rsn stk))))
(defn clet [v arg body] (cerl/c_let (list v) arg body))
(defn cseq [a b] (cerl/c_seq a b))
(defn ccase [arg clauses] (cerl/c_case arg (to-list clauses)))
(defn cclause
  ([pats body] (cerl/c_clause (to-list pats) body))
  ([pats guard body] (cerl/c_clause (to-list pats) guard body)))
(defn ctuple [es] (cerl/c_tuple (to-list es)))
(defn cmap [pairs] (cerl/c_map (to-list pairs)))
(defn cpair [k v] (cerl/c_map_pair k v))

; The per-process counter/module keys are INLINE literal atoms, not value defs.
; A `(def k …)` would intern a var that `set-current-module!`/`next-fresh!`
; reach through `Env.fetch!` at runtime — and when core-defvar-anf runs from a
; throwaway eval env (the backend switch's path, core_switch_test) that var is
; not interned there, so the fetch raised `undefined var: lower/…-key`.
; A literal atom is baked into the body module and needs no var lookup.

(defn reset-fresh!
  "Reset THIS PROCESS's fresh-name counter to 0. Called once per COMPILATION
   UNIT (each module build) so the fresh var names — hence the emitted beam's
   bytes — are a function of that unit's source alone, never of what else built
   earlier OR CONCURRENTLY in the VM.

   The counter is per-process (process dictionary), exactly like
   BeamLisp.Compiler.reset_fresh!/0 and priv/boot/compiler.bl's `reset-fresh!`.
   A shared ref would be a reproducibility HAZARD: the AOT build compiles
   namespaces in PARALLEL worker processes (build.bl `pmap-ordered` →
   `spawn_link`), and two workers racing one global counter would interleave
   fresh numbers and emit non-reproducible beams — the exact leak class
   aot_reproducible_test pins (serial ≡ parallel ≡ post-perturbation). Per
   process, each worker's sequence is a function of its own source alone."
  []
  (erlang/put :bl_core_fresh_seq 0)
  nil)

(defn- next-fresh!
  "The next number from THIS PROCESS's fresh-name counter (1, 2, 3 …)."
  []
  (let [cur (erlang/get :bl_core_fresh_seq)
        n (erlang/+ (if (erlang/=:= cur :undefined) 0 cur) 1)]
    (erlang/put :bl_core_fresh_seq n)
    n))

(defn fresh [prefix]
  (cvar (erlang/binary_to_atom (str prefix "_ce" (next-fresh!)))))

;; ── quoted-node accessors (TRANSITION-ONLY — serve shim-def/eval-def-anf's
;;    quoted readback until E5 deletes the quoted layer) ─────────────────────

(defn node? [t n] (and (tuple? t) (= n (tuple-size t))))
(defn head [t] (elem t 0))
(defn args [t] (elem t 2))
(defn form? [t k] (and (node? t 3) (= k (head t))))
(defn kw [kvs k] (Keyword/get kvs k))

(defn- set-current-module! [m] (erlang/put :bl_core_current_module m) m)

;; ── bl-ANF → cerl (PLAN-079 S-C) ─────────────────────────────────────────────
;;
;; The lowering for the backend-neutral IR. anf/normalise already desugared
;; truthiness/cond/let into :if/:do/:let and resolved every name, so this table
;; is a direct op→constructor map. This is the shape a future MLIR emitter
;; mirrors: one :op → one target constructor, :ann → attributes, body nodes →
;; regions.

(declare lower-anf)

(defn lower-anf-pattern-key
  "Lower the KEY of a map/struct pattern pair to a ground cerl term. A pattern
   key is always a literal value, never a sub-pattern or an expression to
   evaluate, but the two producers spell it differently: norm-pattern's :pstruct
   keeps the field name as a RAW atom (:items), while its :pmap wraps the key
   through normalise into a :lit node. Accept both: a bl-ANF node map lowers
   through lower-anf (a :lit yields its literal), and a bare value is abstracted
   directly. Calling lower-anf on the raw atom was the bug: an atom is not a
   node, so it fell to the else branch and threw an unknown-op error, which
   blocked every namespace with a vector pattern in a receive/case clause
   (e.g. (receive [:done r] r), which reads as a %Vector struct pattern)."
  [k]
  (if (and (map? k) (contains? k :op))
    (lower-anf k)
    (lit k)))

(defn lower-anf-pattern [p]
  (let [op (:pop p)]
    (cond
      (= op :pvar) (if (= "_" (:name p)) (fresh "_") (cvar (erlang/binary_to_atom (:name p))))
      (= op :plit) (lit (:val p))
      (= op :pnil) (cerl/c_nil)
      (= op :ptuple) (ctuple (map lower-anf-pattern (:elems p)))
      (= op :pcons) (cerl/c_cons (lower-anf-pattern (:head p)) (lower-anf-pattern (:tail p)))
      (= op :palias) (cerl/c_alias (lower-anf-pattern (:a p)) (lower-anf-pattern (:b p)))
      (= op :pmap)
        (cerl/c_map_pattern
          (to-list (map (fn [kv] (cerl/c_map_pair_exact (lower-anf-pattern-key (first kv)) (lower-anf-pattern (second kv))))
                        (:pairs p))))
      (= op :pstruct)
        (cerl/c_map_pattern
          (cons (cerl/c_map_pair_exact (catom :__struct__) (catom (:mod p)))
                (to-list (map (fn [kv] (cerl/c_map_pair_exact (lower-anf-pattern-key (first kv)) (lower-anf-pattern (second kv))))
                              (:fields p)))))
      :else (throw (ex-info "lower-anf-pattern: unknown pop" {:pop op :pat p})))))

(defn lower-anf-clauses
  "bl-ANF clauses ({:pats :guard :body}) → cerl clauses over the SAME arity."
  [clauses]
  (map (fn [cl]
         (let [pats (to-list (map lower-anf-pattern (:pats cl)))]
           (if (nil? (:guard cl))
             (cclause pats (lower-anf (:body cl)))
             (cclause pats (lower-anf (:guard cl)) (lower-anf (:body cl))))))
       clauses))

(defn lower-anf-fn
  "A bl-ANF :fn → Core fun. One clause of plain-var params lowers to a direct
   fun; otherwise a fun over fresh params whose body cases on their tuple."
  [n]
  (let [clauses (:clauses n)
        cl0 (first clauses)
        arity (count (:pats cl0))
        simple? (and (= 1 (count clauses)) (nil? (:guard cl0))
                     (every? (fn [p] (= :pvar (:pop p))) (:pats cl0)))]
    (if simple?
      (cfun (to-list (map (fn [p] (cvar (erlang/binary_to_atom (:name p)))) (:pats cl0)))
            (lower-anf (:body cl0)))
      (let [params (to-list (map (fn [_] (fresh "A")) (range arity)))
            lowered (lower-anf-clauses clauses)
            tupled (map (fn [cl] (cerl/c_clause (list (ctuple (cerl/clause_pats cl)))
                                                (cerl/clause_guard cl)
                                                (cerl/clause_body cl)))
                        lowered)]
        (cfun params (ccase (ctuple params) tupled))))))

(defn lower-anf-try
  [n]
  (let [body (lower-anf (:body n))
        v (fresh "V") cls (fresh "Class") rsn (fresh "Reason") stk (fresh "Stack")
        catch-clauses (:catch n)
        handler (ccase (cerl/c_values (list cls rsn))
                       (to-list (concat (lower-anf-clauses catch-clauses)
                               (list (cclause (list (fresh "_") (fresh "_"))
                                              (craise cls rsn stk))))))
        handler* (clet (cvar :__STACKTRACE__) stk handler)
        after (:after n)
        caught (if (empty? catch-clauses) body
                 (cerl/c_try body (list v) v (list cls rsn stk) handler*))
        c2 (fresh "Class") r2 (fresh "Reason") s2 (fresh "Stack") v2 (fresh "V")]
    (if (nil? after)
      caught
      (cerl/c_try caught (list v2) (cseq (lower-anf after) v2)
                  (list c2 r2 s2)
                  (cseq (lower-anf after) (craise c2 r2 s2))))))

(defn anf-if->case
  "Lower a truthy `if` to a Core `case`, given the ALREADY-lowered cerl test,
   then, and else. Elixir truthiness: only `false` and `nil` are falsey.

   `then` and `else` each appear ONCE. The naive encoding — a `false` clause and
   a `nil` clause both yielding `else`, plus a catch-all `then` — lowered `else`
   TWICE, and because a `cond` nests one `if` inside another's else, the else
   subtree at depth k was re-lowered 2^k times: O(2^N) in the branch count. A
   15-branch `cond` (datom.codec/encode-value) took 45s+ and blocked the whole
   Core AOT build. A single guarded clause — `X when X =:= false or X =:= nil`
   → else — collapses the two falsey patterns into one, so each branch is
   lowered once and the cost is linear. `erlang:or/2` (the strict boolean BIF,
   not `orelse`) is guard-legal in Core Erlang; `=:=` is exact equality."
  [ctest cthen celse]
  (let [x (fresh "If")
        guard (ccall :erlang :or
                     (list (ccall :erlang (erlang/binary_to_atom "=:=") (list x (catom false)))
                           (ccall :erlang (erlang/binary_to_atom "=:=") (list x (catom nil)))))]
    (ccase ctest
           (list (cclause (list x) guard celse)
                 (cclause (list (fresh "_")) cthen)))))

(defn- anno-cerl
  "Attach a node's source position (:ann {:line :file}) to the cerl term it
   lowered to — a bare integer line plus {file, name}, v3_core's own spelling.
   This is what makes a runtime error's stack frame name the .bl file and
   line (wave20); the BEAM's line table is built from these annotations."
  [n c]
  (let [a (:ann n)]
    (if (and (map? a)
             (erlang/is_integer (maps/get :line a 0))
             (> (maps/get :line a 0) 0))
      (let [f (maps/get :file a nil)
            adds (if (or (nil? f) (and (erlang/is_binary f) (erlang/=:= 0 (erlang/byte_size f))))
                   (list (maps/get :line a))
                   (list (maps/get :line a) (tuple :file f)))]
        (cerl/set_ann c (to-list (concat (cerl/get_ann c) adds))))
      c)))

(defn- lower-anf-node
  [n]
  (let [op (:op n)]
    (cond
      (= op :lit) (lit (:val n))
      (= op :var) (cvar (erlang/binary_to_atom (:name n)))
      (= op :global) (ccall :Elixir.BeamLisp.Env :fetch! (list (lit (:ns n)) (lit (:name n))))
      (= op :remote)
        (let [m (:mod n) f (:fun n) as (to-list (:args n))]
          ; erlang:raise/3 cannot be CALLED from Core Erlang — from_core runs
          ; after v3_core (the pass that rewrites it), so the call degrades to
          ; a returned :badarg. Emit v3_core's own spelling instead; the
          ; enclosing module-level fun must carry a function annotation (see
          ; cfun-anno).
          (if (and (= m :erlang) (= f :raise) (= 3 (count as)))
            (cerl/c_primop (catom :raw_raise) (to-list (map lower-anf as)))
            (ccall m f (to-list (map lower-anf as)))))
      (= op :apply) (capply (lower-anf (:fn n)) (to-list (map lower-anf (:args n))))
      (= op :let) (clet (cvar (erlang/binary_to_atom (:name n))) (lower-anf (:init n)) (lower-anf (:body n)))
      (= op :if) (anf-if->case (lower-anf (:test n)) (lower-anf (:then n)) (lower-anf (:else n)))
      (= op :do) (reduce (fn [acc s] (cseq acc (lower-anf s)))
                         (lower-anf (first (:stmts n)))
                         (rest (:stmts n)))
      (= op :case) (ccase (lower-anf (:subj n)) (lower-anf-clauses (:clauses n)))
      (= op :fn) (lower-anf-fn n)
      (= op :try) (lower-anf-try n)
      (= op :recv)
        (let [cls (lower-anf-clauses (:clauses n))]
          (if (nil? (:timeout n))
            (cerl/c_receive (to-list cls))
            (cerl/c_receive (to-list cls) (lower-anf (:timeout n)) (lower-anf (:after n)))))
      (= op :tuple) (ctuple (map lower-anf (:elems n)))
      (= op :map) (cmap (map (fn [kv] (cpair (lower-anf (first kv)) (lower-anf (second kv)))) (:pairs n)))
      (= op :enil) (cerl/c_nil)
      (= op :cons) (cerl/c_cons (lower-anf (:head n)) (lower-anf (:tail n)))
      (= op :struct)
        ;; %Mod{…} → the SAME struct value the Elixir backend builds, INCLUDING
        ;; every default field. Elixir's `%Mod{f: v}` fills the fields the literal
        ;; omits from `defstruct` (e.g. %BeamLisp.Vector{items: …} gets
        ;; `meta: nil`); a plain map of only the written fields does NOT, so a
        ;; Core-built struct was missing keys and `map_get(:meta, v)` — the shape
        ;; the compiler's own `data->form` relies on — raised `key :meta not
        ;; found`, breaking every file compiled while a Core-built compiler.bl
        ;; was loaded. Build it the way the quoted `lower` does: call the
        ;; struct module's generated `__struct__/1` with the written fields as a
        ;; `[{key, value}]` list — it applies them over the defaults, yielding a
        ;; complete struct. Field keys are literal atoms; values are lowered.
        (ccall (:mod n) :__struct__
               (list (reduce (fn [acc kv]
                               (cerl/c_cons (ctuple (list (lower-anf-pattern-key (first kv))
                                                          (lower-anf (second kv))))
                                            acc))
                             (cerl/c_nil)
                             (reverse (to-list (:fields n))))))
      :else (throw (ex-info "lower-anf: unknown op" {:op op :node n})))))

;; ── module wrapper + the evaluator ──────────────────────────────────────────

(defn lower-anf
  "bl-ANF node (anf vocabulary) → cerl, with the node's source position
   stamped onto the cerl term (see anno-cerl)."
  [n]
  (anno-cerl n (lower-anf-node n)))

(defn module-info-defs [mname]
  (let [k (cvar :K)]
    (list (tuple (cerl/c_fname :module_info 0)
                 (cfun (list) (ccall :erlang :get_module_info (list (catom mname)))))
          (tuple (cerl/c_fname :module_info 1)
                 (cfun (list k) (ccall :erlang :get_module_info (list (catom mname) k)))))))

(defn expr->module
  "A Core module `mname` exporting run/0 whose body is `core-expr`."
  [mname core-expr]
  (let [run (cerl/c_fname :run 0)
          defs (cons (tuple run (cfun-anno :run 0 (list) core-expr)) (module-info-defs mname))]
    (cerl/c_module (catom mname) (to-list (map first defs)) (list) (to-list defs))))

(defn eval-core
  "Compile a Core module, load it, run run/0, purge."
  [mname core-expr]
  (let [m (expr->module mname core-expr)
        res (compile/forms m (list :from_core :binary :return))]
    (when (not= :ok (elem res 0)) (throw (ex-info "ce1: compile failed" {:res res})))
    (code/load_binary mname (erlang/binary_to_list (str mname ".core")) (elem res 2))
    ; the module is KEPT: a closure the form returns (a macro fn, a defn's
    ; value) lives in it — the same reason Elixir's Eval.M* modules stay.
    (erlang/apply mname :run (list))))

; ── def-tuple readback + the body/namespace module topology ──────────────────
;;
;; TRANSITION-ONLY quoted tooling (unescape/def-head/expand-defaults/shim-def):
;; these read the quoted {:def …} def-asts compiler.bl still emits today. When
;; compiler.bl emits {:op :defn-clause …} nodes directly (PLAN-086 E2–E4), they
;; are deleted and defs->module-anf reads the nodes without a readback (E5).

(defn unescape [t]
  (cond
    (form? t (erlang/binary_to_atom "{}")) (erlang/list_to_tuple (to-list (map unescape (args t))))
    (and (node? t 2) (not (erlang/is_atom (elem t 0)))) (tuple (unescape (elem t 0)) (unescape (elem t 1)))
    (node? t 2) (tuple (elem t 0) (unescape (elem t 1)))
    (erlang/is_list t) (to-list (map unescape t))
    :else t))

(defn def-head
  "{:def _ [head [do: body]]} → [fname params guard-or-nil body]."
  [d]
  (let [[h kv] (args d) body (kw kv :do)]
    (if (form? h :when)
      (let [ws (args h) n (dec (count ws)) fh (first ws)]
        [(head fh) (args fh) (nth ws n) body])
      [(head h) (args h) nil body])))

(def default-op (erlang/binary_to_atom "\\\\"))

(defn expand-defaults
  "Elixir `def f(a, b \\ 1, c \\ 2)` = three defs: f/1 → f(a,1,2), f/2 → f(a,b,2),
   f/3 body. One def in, one or more defs out; heads lose the `\\` markers."
  [d]
  (let [[fname ps g body] (def-head d)
        ps (to-list ps)
        defaulted? (fn [p] (form? p default-op))]
    (if (not (some defaulted? ps))
      (list d)
      (let [plain (to-list (map (fn [p] (if (defaulted? p) (first (args p)) p)) ps))
            full (tuple :def (list) (list (if (nil? g) (tuple fname (list) plain)
                                            (tuple :when (list) (list (tuple fname (list) plain) g)))
                                          (list (tuple :do body))))
            n-req (count (take-while (fn [p] (not (defaulted? p))) ps))
            n (count ps)
            ; one forwarding def per arity in [n-req, n)
            fwd (map (fn [k]
                       (let [given (take k plain)
                             call-args (to-list (concat given (map (fn [p] (second (args p))) (drop k ps))))]
                         (tuple :def (list)
                                (list (tuple fname (list) (to-list given))
                                      (list (tuple :do (tuple (tuple :. (list) (list :__MODULE__ fname)) (list) call-args)))))))
                     (range n-req n))]
        (to-list (concat fwd (list full)))))))

(defn- def-head-anf
  "A quoted {:def …} → [fname bl-ANF-params guard-or-nil bl-ANF-body], the
   def-head pieces normalised into bl-ANF (params→patterns, guard/body→nodes).
   TRANSITION-ONLY: when compiler.bl emits {:op :defn-clause …} nodes directly
   (PLAN-086 E2–E4), this readback is deleted and defs->module-anf destructures
   the node (E5)."
  [d]
  (let [[fname ps g body] (def-head d)]
    [fname
     (to-list (map anf/norm-pattern (to-list ps)))
     (if (nil? g) nil (anf/normalise g))
     (anf/normalise body)]))

(defn defs->module-anf
  "Each def body/guard/params flow through bl-ANF (normalise → lower-anf).
   This is the def path on the neutral IR (PLAN-079 S-D): the SAME body/shim
   topology, fed by bl-ANF. `attrs` is [[name value] …]."
  ([mname def-asts] (defs->module-anf mname def-asts (list)))
  ([mname def-asts attrs]
   (set-current-module! mname)
   (reset-fresh!)   ; per-unit: emitted bytes are a function of THIS source alone
   (let [def-asts (to-list (mapcat expand-defaults def-asts))
         heads (to-list (map def-head-anf def-asts))
         ;; Group clauses by [fname arity], then iterate in a STABLE order.
         ;; `group-by` returns a map keyed by [fname arity], and a map with ATOM
         ;; keys iterates in atom-TABLE order (creation order), not term order —
         ;; so which function's clauses come first depended on which atoms the VM
         ;; had interned by the time this ran, i.e. on everything compiled
         ;; earlier in the build. That made both the function order AND the
         ;; per-function `fresh "P"` params vary run-to-run: the emitted beam was
         ;; NOT reproducible. Sorting the groups by the fname STRING + arity ties
         ;; the order to the source alone, which is what reproducibility means.
         groups (sort-by (fn [[[f n] _]] [(erlang/atom_to_binary f) n])
                         (to-list (group-by (fn [[f ps _ _]] [f (count ps)]) heads)))
         funs (to-list
                (map (fn [[[f n] cls]]
                       (let [params (to-list (map (fn [_] (fresh "P")) (range n)))
                             clauses (to-list
                                       (map (fn [[_ ps g body]]
                                              (let [pats (to-list (map lower-anf-pattern ps))]
                                                (if (nil? g)
                                                  (cclause (list (ctuple pats)) (lower-anf body))
                                                  (cclause (list (ctuple pats)) (lower-anf g) (lower-anf body)))))
                                            cls))
                             fail (cclause (list (fresh "_"))
                                           (ccall :erlang :error (list (catom :function_clause))))]
                         (tuple (cerl/c_fname f n)
                                (cfun-anno f n params (ccase (ctuple params) (concat clauses (list fail)))))))
                     (to-list groups)))
         defs (to-list (concat funs (module-info-defs mname)))
         cattrs (to-list (map (fn [[k v]] (tuple (catom k) (lit v))) attrs))]
     (cerl/c_module (catom mname) (to-list (map first defs)) cattrs defs))))

; ── the effectful edge: compile a cerl module and load it ────────────────────
(defn load-module!
  [m]
  (let [res (compile/forms m (list :from_core :binary :return))]
    (when (not= :ok (elem res 0)) (throw (ex-info "ce1: compile failed" {:res res})))
    (code/load_binary (elem res 1) (erlang/binary_to_list (str (elem res 1) ".core")) (elem res 2))
    (elem res 1)))

;; else (Env bookkeeping, fn_value, link-info) is reused as is.

(defn reload-defs!
  "Compile quoted def-asts into module `mname` through the Core path
   (defs->module-anf) and load it, purging any previous version first — the
   genesis Module.create + ignore_module_conflict role (a redefined defserver
   silently replaces its module). Returns the module name."
  [mname def-asts attrs]
  (code/purge mname)
  (code/delete mname)
  (load-module! (defs->module-anf mname def-asts attrs)))

(defn shim-def
  "A body-module def → the namespace shim: same head (+ guard), body forwards.
   TRANSITION-ONLY quoted producer: builds the shim as a quoted {:def …} that
   defs->module-anf normalises. E3 emits shims as :defn-clause nodes directly."
  [body-mod d]
  (let [[fname ps g body] (def-head d)
        ps (to-list ps)
        fwd (tuple (tuple :. (list) (list body-mod fname)) (list) ps)
        ; the :when head is [head-call, guard] — Elixir's shape and the one
        ; def-head reads. (Loose `params… guard` inside :when is what Elixir
        ; quotes for `def f(x) when g`; the shim must reproduce THAT, or the
        ; Core def path (def-head/expand-defaults) reads a param var tuple as
        ; the head and seqs its context atom.)
        h (if (nil? g)
            (tuple fname (list) ps)
            (tuple :when (list) (list (tuple fname (list) ps) g)))]
    (tuple :def (list) (list h (list (tuple :do fwd))))))

;; ── S-D: the def seam on bl-ANF ─────────────────────────────────────────────
;;
;; core-defvar-anf lowers BOTH the body module and the namespace shims through
;; bl-ANF (defs->module-anf). The shim forms shim-def produces are ordinary
;; quoted {:def …} forwards (transition), so normalise handles them the same as
;; any def. This is the def-building path; the quoted-reading defs->module is
;; retained in priv/self/core.bl only until compiler.bl emits bl-ANF directly
;; and the quoted `lower` retires (PLAN-086 E5).

(defn core-defvar-anf
  "Define `name` in `ns` from compiler def-tuples [{kind arity fname def_ast}…],
   building both modules in Core via bl-ANF. Returns the fn value."
  [ns name new-defs]
  (let [mod (BeamLisp.Emit/module_for ns)
        body-mod (BeamLisp.Emit/fresh_body_module)
        body-defs (BeamLisp.Emit/attach_body_module new-defs body-mod)
        all-defs (Map/put (BeamLisp.Env/ns_defs ns) name body-defs)
        _ (load-module! (defs->module-anf body-mod (to-list (map (fn [t] (elem t 3)) body-defs))))
        shims (to-list (mapcat (fn [[_ defs]] (map (fn [t] (shim-def (elem t 4) (elem t 3))) defs))
                               (to-list all-defs)))
        _ (load-module! (defs->module-anf mod shims))
        _ (BeamLisp.Env/put_ns_defs ns all-defs)
        fv (BeamLisp.Emit/fixed_variadic new-defs)
        fixed (elem fv 0) variadic (elem fv 1)
        value (BeamLisp.Emit/fn_value mod fixed variadic)]
    (BeamLisp.Env/put_key (tuple :link ns name) (tuple mod (Map/new fixed) variadic))
    (BeamLisp.Env/intern ns name value)))

(defn eval-def-anf
  "Evaluate a quoted defn through the bl-ANF def path."
  [q]
  (let [[ns name tuples] (args q)]
    (core-defvar-anf ns name (to-list (map unescape tuples)))))

;; ── S-C: the bl-ANF eval seam ────────────────────────────────────────────────
;;
;; The expression evaluator on the neutral IR. Today: quoted → normalise →
;; bl-ANF → lower-anf → cerl. After PLAN-086 E2 compiler.bl emits bl-ANF
;; directly and the normalise step drops out of this composition.

(defn eval-core-anf
  "Evaluate one compiler-emitted quoted form through bl-ANF → Core Erlang."
  [mname q]
  (reset-fresh!)
  (eval-core mname (lower-anf (anf/normalise q))))

;; ── S-D.aot: Core → .beam on disk ────────────────────────────────────────────
;;
;; The AOT edge: compile a module built by the Core backend to a .beam BINARY
;; and persist it, so a namespace's code can be loaded in a fresh VM with no
;; Elixir compiler present. reset-fresh! per module keeps the bytes
;; reproducible (a rebuild of the same source yields the same beam).

(defn module->beam
  "Compile a cerl module to a {module-name, beam-binary} pair."
  [m]
  (let [res (compile/forms m (list :from_core :binary :return))]
    (when (not= :ok (elem res 0))
      (throw (ex-info "lower: from_core compile failed" {:res res})))
    (tuple (elem res 1) (elem res 2))))

(defn write-beam!
  "Write a compiled beam binary to <dir>/<module>.beam. Returns the path."
  [dir module beam]
  (let [path (str dir "/" (erlang/atom_to_binary module) ".beam")]
    (File/mkdir_p! dir)
    (File/write! path beam)
    path))

(defn ns-body-beam
  "Compile a namespace's def-asts to its BODY module beam via Core, returning
   {module beam}. `mname` is the body-module atom (deterministic per ns)."
  [mname def-asts]
  (module->beam (defs->module-anf mname def-asts)))

(defn aot-body-beams
  "The AOT integration seam: compile EVERY body module of a namespace to a
   .beam via Core, returning a list of {module beam} pairs.

   `ns-defs` is the stabilised var→def-tuples map the Elixir AOT path holds
   (Env.ns_defs after emit.ex's stabilise_body_modules). We reuse
   BeamLisp.Emit/body_modules to group it into [{body-mod [def-ast …]} …] — the
   SAME grouping emit.ex uses for its Elixir body modules — so the Core path and
   the Elixir path split a namespace into byte-identical module topology,
   differing only in the backend that lowers each body. The shim, init, and
   provenance modules stay Elixir (role-B/C plumbing: Env.intern, __bl_init__,
   __bl_provenance__); only the real code — the sole semantic Elixir dependency
   — flows through Core here."
  [ns-defs]
  (to-list
    (map (fn [[body-mod def-asts]]
           (ns-body-beam body-mod (to-list def-asts)))
         (to-list (BeamLisp.Emit/body_modules ns-defs)))))
