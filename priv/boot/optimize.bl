; optimize.bl — boot-cycle facade for the checked-rewrite optimizer.
;
; Rules, facts and evidence live in priv/host/optimize.bl (BeamLisp.Optimize).
; This namespace is the ergonomic public API; it delegates without duplicating
; the implementation.
;
; Boot cycle note: the optimizer must exist before it can compile/rebuild its own
; namespace. The exact pinned host is the single implementation; this boot facade
; exposes the same coherent API to user programs.
(ns optimize)

(def VERSION "optimize-1")

(defn version [] (BeamLisp.Optimize/version))
(defn rules [] (BeamLisp.Optimize/rules))

(defn run
  "Validate and optimize a canonical ANF module descriptor. Delegates to host.optimize.
   See priv/host/optimize.bl for algorithm documentation."
  ([descriptor] (BeamLisp.Optimize/run descriptor))
  ([descriptor opts] (BeamLisp.Optimize/run descriptor opts)))

(defn module
  "Compiler-facing API: validated optimized descriptor. Delegates to host.optimize."
  ([descriptor] (BeamLisp.Optimize/module descriptor))
  ([descriptor opts] (BeamLisp.Optimize/module descriptor opts)))

(defn node
  "Optimize one ANF expression. Delegates to host.optimize."
  ([expression] (BeamLisp.Optimize/node expression))
  ([expression opts] (BeamLisp.Optimize/node expression opts)))

(defn explain
  "The full checked rewrite/refusal report. Delegates to host.optimize."
  ([descriptor] (BeamLisp.Optimize/explain descriptor))
  ([descriptor opts] (BeamLisp.Optimize/explain descriptor opts)))
