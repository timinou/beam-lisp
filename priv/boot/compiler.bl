; compiler.bl — stable namespace delegating to the canonical ANF compiler.
(ns compiler
  (:require [compiler2 :as canonical]))

(defn new-env [ns] (canonical/new-env ns))
(defn new_env [ns] (canonical/new_env ns))
(defn reset-fresh! [] (canonical/reset-fresh!))
(defn reset_fresh! [] (canonical/reset_fresh!))
(defn macroexpand-1 [form ns] (canonical/macroexpand-1 form ns))
(defn macroexpand_1 [form ns] (canonical/macroexpand_1 form ns))
(defn prelink-defn [form ns] (canonical/prelink-defn form ns))
(defn prelink_defn [form ns] (canonical/prelink_defn form ns))
(defn compile-node [form env] (canonical/compile-node form env))
(defn compile [form env] (canonical/compile form env))
(defn eval-form [form env] (canonical/eval_form form env))
(defn eval_form [form env] (canonical/eval_form form env))
(defn eval-string [source env file] (canonical/eval_string source env file))
(defn eval_string [source env file] (canonical/eval_string source env file))
(defn read-data [source] (canonical/read_data source))
(defn read_data [source] (canonical/read_data source))
(defn read-all-data [source] (canonical/read_all_data source))
(defn read_all_data [source] (canonical/read_all_data source))