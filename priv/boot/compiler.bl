; compiler.bl — the bl-ANF compiler, written in beam-lisp.
;
; A compiler turns a program you wrote into something the machine can run.
; This one's target is bl-ANF: the one IR of the self-hosted toolchain. The
; pipeline is reader.bl (text -> forms) -> this file (forms -> bl-ANF nodes)
; -> lower.bl (bl-ANF -> Core Erlang -> BEAM). `eval_form` lowers and runs
; each form as run/0 of a throwaway module; AOT lowers whole namespaces into
; real modules. There is no Elixir-quoted layer on this path.
(ns compiler
  (:require [reader-node :as rn] [anf :as a] [lower :as lower]))

;; These private bindings operate on finite compiler data, not user sequences.
;; Their host implementation refuses deferred inputs without realizing them.
(defn- map
  ([f xs] (BeamLisp.CompilerData/eager_map f xs))
  ([f xs ys] (BeamLisp.CompilerData/eager_map f xs ys)))
(defn- mapcat [f xs] (BeamLisp.CompilerData/eager_mapcat f xs))
(defn- filter [f xs] (BeamLisp.CompilerData/eager_filter f xs))
(defn- concat [& xs] (BeamLisp.CompilerData/eager_concat xs))
(defn- distinct [xs] (BeamLisp.CompilerData/eager_distinct xs))

; ──────────────────────────────────────────────────────────────────────
; The compile environment
;
; A tiny map threaded through every compile step. `:ns` is the namespace whose
; variables an unqualified name resolves against; `:locals` is the set of names
; bound right here (function parameters, let bindings) which resolve to
; themselves rather than to a namespace variable.
; ─────────────────────────────────────────────────────────────────────────────

(defn new-env
  "Make a fresh compile environment for namespace `ns`.

   `:locals` starts empty: at the top level nothing is bound locally, so every
   name is a namespace variable until a `let` or a function parameter adds to
   it. `:recur` is nil until a `loop` (or, later, a function) sets a target for
   `recur` to jump back to. `:tail` says whether the form being compiled is in
   tail position — the last thing its enclosing body does — which is where
   `recur` is allowed."
  [ns]
  {:ns ns :locals {} :recur nil :tail true})

(defn- with-ann
  "Stamp an ANF node's :ann with the source position the reader recorded on
   its form (:meta map with :line/:file). Lowering turns it into a cerl line
   annotation, so a runtime error's stack frame names the .bl file and line.
   Nodes built from thin air (macro output) carry no position — the honest
   answer to 'where did this come from' is nowhere."
  ([node m] (with-ann node m nil))
  ([node m env-file]
  (if (and (erlang/is_map m)
           (erlang/is_integer (maps/get :line m 0))
           (pos? (maps/get :line m 0)))
    ; Carry the FULL source span the reader recorded: :line and :file feed the
    ; cerl line annotation (runtime stack frames); :col is the column the reader
    ; captured. Lowering reads only :line/:file, so :col rides along untouched —
    ; available to engines (hover/evidence) and to any error reporter that wants
    ; a caret, without a second surface pass. A node with no column (macro
    ; output) simply omits the key.
    (let [col (maps/get :col m nil)
          end-line (maps/get :end-line m nil)
          end-col (maps/get :end-col m nil)
          ; :file from the reader meta, falling back to the env's file when the
          ; meta lacks it (in-memory read_string has no file; a real load does).
          file (or (maps/get :file m nil) env-file)
          base {:line (maps/get :line m) :file file}
          with-col (if (erlang/is_integer col) (assoc base :col col) base)
          with-span (if (and (erlang/is_integer end-line) (erlang/is_integer end-col))
                      (assoc with-col :end-line end-line :end-col end-col)
                      with-col)]
      ; MERGE onto any :ann the node already carries: a node built by a
      ; lower pass may already hold proof annotations (e.g. a loop scaffold's
      ; :decreasing trusted measure). Position augments those, never erases them.
      (assoc node :ann (maps/merge (or (:ann node) {}) with-span)))
    node)))

(defn- pos-env
  "Thread a form's source position into the compile environment.

   The reader wraps a form in a `:meta` node whose map carries `:line`/`:file`
   — where in the user's source this form was written. Copying those onto the
   env means every compile step below has them in hand, so when something is
   wrong the error can name the user's file and line instead of the compiler's
   own frames. Only sane values are copied (a positive integer line, a string
   file); a form with no position leaves the env untouched, and compiles
   exactly as before."
  [env m]
  (if (erlang/is_map m)
    ; A macro can attach a metadata map that carries only SOME position keys
    ; (e.g. `(with-meta form {:line 1})` — a line, no file), so read each key
    ; with a nil default rather than the 2-arg `maps/get`, which raises on a
    ; missing key. An absent or non-sane value simply leaves the env untouched.
    (let [line (maps/get :line m nil)
          file (maps/get :file m nil)
          e1 (if (and (erlang/is_integer line) (pos? line)) (assoc env :line line) env)]
      (if (erlang/is_binary file) (assoc e1 :file file) e1))
    env))

(defn- compile-error
  "Stop compiling and report a typed, source-located error.

   Raises a `BeamLisp.CompileError` — the same rich error the original compiler
   raised — carrying the message plus the `:file` and `:line` threaded onto the
   env by `pos-env`, and optionally the offending form. The message is prefixed
   with `file:line` when known, so the reader of the error sees WHERE in their
   own source the problem is, not a stack of compiler internals. Use this for
   every compile-time rejection instead of a bare `throw`: a `throw` becomes a
   generic runtime error with no position and no type, which is exactly the
   information a good error message must not lose.

   `env` is the current compile environment; `message` is the human sentence;
   `form` (optional) is the reader node the error is about."
  ([env message] (compile-error env message nil))
  ([env message form]
   (erlang/error
     (BeamLisp.CompileError/exception
       (apply list
         (concat
           (list (erlang/list_to_tuple (list :message message)))
           (if (some? (:file env)) (list (erlang/list_to_tuple (list :file (:file env)))) (list))
           (if (some? (:line env)) (list (erlang/list_to_tuple (list :line (:line env)))) (list))
           (if (some? form) (list (erlang/list_to_tuple (list :form form))) (list))))))))

(defn- local?
  "Say whether `name` is bound locally in this environment (a parameter or a
   let binding), as opposed to being a namespace variable."
  [env name]
  (contains? (:locals env) name))

(defn- local-var
  "The Elixir variable a local `name` was bound to in this environment."
  [env name]
  (get (:locals env) name))

(defn- put-local
  "Add a local binding `name` -> Elixir variable `var` to the environment,
   returning the updated environment."
  [env name var]
  (assoc env :locals (assoc (:locals env) name var)))

(defn- notail
  "A copy of the environment with tail position turned OFF.

   Arguments to a call, the test of an `if`, and the non-last forms of a body
   are not in tail position, so `recur` is not allowed there. Threading this
   env into those places is what makes `recur must be in tail position` fire
   exactly where it should."
  [env]
  (assoc env :tail false))


; ── bl-ANF emission helpers (PLAN-086 E2) ────────────────────────────────────
;
; compile-node and the compile-* family emit bl-ANF nodes (priv/boot/anf.bl),
; not Elixir-quoted trees. The host modules the runtime calls live at fixed
; atoms; anf-list builds a LIST VALUE node (a cons chain) from a list of nodes.

(def ^:private mod-erlang :erlang)
(def ^:private mod-body-lower (erlang/binary_to_atom "Elixir.BeamLisp.Ns.Body.Lower"))
(def ^:private mod-rt (erlang/binary_to_atom "Elixir.BeamLisp.RT"))
(def ^:private mod-env (erlang/binary_to_atom "Elixir.BeamLisp.Env"))
(def ^:private mod-vector (erlang/binary_to_atom "Elixir.BeamLisp.Vector"))
(def ^:private mod-set (erlang/binary_to_atom "Elixir.BeamLisp.Set"))
(def ^:private mod-record (erlang/binary_to_atom "Elixir.BeamLisp.Record"))
(def ^:private mod-exinfo (erlang/binary_to_atom "Elixir.BeamLisp.ExInfo"))
(def ^:private mod-exception (erlang/binary_to_atom "Elixir.Exception"))
(def ^:private mod-formmeta (erlang/binary_to_atom "Elixir.BeamLisp.FormMeta"))
(def ^:private mod-link (erlang/binary_to_atom "Elixir.BeamLisp.Link"))
(def ^:private mod-loader (erlang/binary_to_atom "Elixir.BeamLisp.Loader"))
(def ^:private mod-multi (erlang/binary_to_atom "Elixir.BeamLisp.Multi"))
(def ^:private mod-native (erlang/binary_to_atom "Elixir.BeamLisp.Native"))
(def ^:private mod-server (erlang/binary_to_atom "Elixir.BeamLisp.Server"))
(def ^:private mod-module (erlang/binary_to_atom "Elixir.Module"))
(def ^:private mod-code (erlang/binary_to_atom "Elixir.Code"))

(defn- anf-list
  "A bl-ANF node that evaluates to the LIST of the given nodes' values."
  [nodes]
  (reduce (fn [acc n] (a/cons-cell n acc)) a/enil (reverse nodes)))

(defn- anf-invoke
  "The general beam-lisp call: BeamLisp.RT.invoke(f, [args]) — handles plain
   fns, keywords, remote references, and the $blfn dispatch tuple."
  [f-node arg-nodes]
  (a/remote mod-rt :invoke (list f-node (anf-list arg-nodes))))

; ── fresh names ──────────────────────────────────────────────────────────────
;
; Every `let` binding, loop parameter and auto-gensym (`x#`) needs a name no
; other binding in the same emitted module can collide with. Those names are
; drawn from ONE counter, `fresh-seq`, which lives in the process dictionary
; of the compiling process and is RESET at the start of each compilation unit
; (`BeamLisp.AOT.compile_source/2` calls `reset-fresh!`).
;
; Why a per-unit counter and not `erlang/unique_integer`: unique_integer is
; VM-global, so the names — and therefore the beam bytes — depend on how much
; other compilation ran before this file. Two builds of the same source gave
; two different beams; a parallel build gave a third. A beam that is a pure
; function of its source is what makes the AOT cache, the byte-parity oracle
; and "did this edit change the output?" all mean something. A per-unit
; counter, reset per source, makes the emitted module deterministic.
;
; Why the process dictionary and not an atom: compilation is one process per
; unit, the counter is only ever read and bumped by that process, and a pdict
; read is ~free on the hot path where a var-per-binding is minted.

(def ^:private fresh-key (erlang/binary_to_atom "bl_fresh_seq"))

(defn reset-fresh!
  "Start this process's fresh-name counter over. Call once per compilation
   unit; the emitted names are then a function of the unit's source alone."
  []
  (erlang/put fresh-key 0)
  nil)

(defn- next-fresh!
  "The next number from this process's fresh-name counter (1, 2, 3 …)."
  []
  (let [cur (erlang/get fresh-key)
        n (erlang/+ (if (erlang/=:= cur :undefined) 0 cur) 1)]
    (erlang/put fresh-key n)
    n))

(defn- fresh-var
  "Invent a brand-new name for a local binding named `base`.

   Every `let` binding and loop parameter needs its own unique name, so nested
   bindings of the same source name do not collide. The name is a STRING
   (base plus the next number from `fresh-seq`) — bl-ANF :var/:let nodes carry
   string names, atomised at lowering. The differential oracle compares local
   variables by role, not by name."
  [base]
  (str base "_" (next-fresh!)))

(defn- compile-each
  "Compile a sequence of forms and return the results as a PLAIN list of
   bl-ANF nodes."
  [forms env]
  (apply list (map (fn [f] (compile-node f env)) forms)))

(defn- compile-each-notail
  "Compile a sequence of forms with tail position turned off, as a plain list.
   Used for call and recur arguments, which are never in tail position."
  [forms env]
  (apply list (map (fn [f] (compile-node f (notail env))) forms)))

; ─────────────────────────────────────────────────────────────────────────────
; Small helpers over reader forms and text
; ─────────────────────────────────────────────────────────────────────────────

(defn- has-slash?
  "Say whether a name is qualified: alias/var or Module/function.

   A name that IS `/` (the division operator) or merely starts with `/` is NOT
   qualified: the `/` there is the name itself, not a separator. Only a `/`
   with something before it splits a name into a module/alias and a member."
  [name]
  (let [i (index-of name "/")]
    (and (some? i) (pos? i))))

(defn- uppercase-first?
  "Say whether the first character of `s` is an uppercase letter A\u2013Z, which is
   how a qualified name's prefix signals an Elixir module (`String/upcase`)
   rather than an Erlang one (`lists/reverse`)."
  [s]
  (let [c (first (erlang/binary_to_list s))]
    (and (>= c 65) (<= c 90))))

(defn- split-slash
  "Split a qualified name `a/b` into the pair [prefix suffix] at the first `/`.
   `prefix` is the module or alias, `suffix` the function or variable."
  [name]
  (let [i (index-of name "/")]
    [(subs name 0 i) (subs name (inc i))]))

(defn- split-dots
  "Split a dotted name like A.B.C into its parts at each `.` (here: A, B, C).
   Used to turn a catch's `Module.Name` into the atom segments an Elixir
   `:__aliases__` node carries."
  [name]
  (loop [s name acc (list)]
    (let [i (index-of s ".")]
      ; index-of yields nil (not -1) when there is no more `.`: that is the last
      ; segment, so emit it and stop.
      (if (nil? i)
        (reverse (cons s acc))
        (recur (subs s (inc i)) (cons (subs s 0 i) acc))))))

(defn- module-atom
  "Turn a qualified name's module prefix into the atom the BEAM uses for it.

   An Elixir module written `String` is really the atom `:\"Elixir.String\"`
   on the BEAM — the compiler prepends `Elixir.` to any prefix that starts
   with an uppercase letter. A lowercase prefix (`lists`, `erlang`) is an
   Erlang module and becomes the bare atom `:lists`."
  [prefix]
  (if (and (uppercase-first? prefix)
           (not (and (>= (erlang/byte_size prefix) 7)
                     (= "Elixir." (erlang/binary_part prefix 0 7)))))
    (erlang/binary_to_atom (str "Elixir." prefix))
    (erlang/binary_to_atom prefix)))

(defn- module-label
  "Render a host-module atom the way `inspect` does, for the caps error.
   An Elixir module atom `Elixir.File` prints as `File` (the `Elixir.` prefix
   stripped); an Erlang module atom `os` prints as `:os` (a leading colon).
   This avoids depending on `Kernel/inspect` inside the tier-0 compiler ns."
  [module]
  (let [s (erlang/atom_to_binary module)]
    (if (and (> (erlang/byte_size s) 7)
             (= "Elixir." (erlang/binary_part s 0 7)))
      (erlang/binary_part s 7 (- (erlang/byte_size s) 7))
      (str ":" s))))

(defn- gate-remote!
  "The capability gate at COMPILE time: a qualified name resolving to a HOST
   module (Elixir `Foo/bar`, Erlang `:erlang/atom_to_binary`) is a remote call
   into the host — allowed only when the current env's caps grant that module.

   Rejecting HERE means denied code never becomes bytecode at all: the
   strongest form of the gate, zero runtime cost for static calls. Returns the
   `[:remote module fun]` target when allowed, else raises a compile error
   naming the module. Mirrors the genesis `gate_remote!`; the op is looked up
   so an op-scoped grant (e.g. `{File :read}`) is honoured."
  [env module fun]
  (if (BeamLisp.Env/caps_allowed? module (BeamLisp.Env/op_of module fun))
    (list :remote module fun)
    (compile-error env
      (str "module " (module-label module) " is not granted in this environment "
           "(this code runs under a capability-restricted environment)"))))

(defn- slash-target
  "Decide what a qualified name `prefix/member` refers to.

   Returns [:var ns member] for a reference to a variable in another
   namespace, or [:remote module member] for a call into a host module. The
   order matters and matches how a name resolves: an ALIAS wins, then an
   UPPERCASE prefix is an Elixir module, then an existing NAMESPACE is a var
   (so `core/not` is the var `not` in ns `core`, not a call to a `core`
   module), and finally a lowercase unknown prefix is an Erlang module."
  [env name]
  (let [[prefix member] (split-slash name)
        prefix (if (= "clojure.core" prefix) "core" prefix)
        alias (BeamLisp.Env/alias_target (:ns env) prefix)]
    (cond
      ; an alias or an existing beam-lisp namespace resolves to a VAR — not a
      ; host escape — so it is never capability-gated.
      (some? alias) (list :var alias member)
      ; an UPPERCASE prefix is an Elixir host module; a lowercase unknown prefix
      ; is an Erlang host module. Both are remote calls into the host, so they
      ; pass through the compile-time capability gate before resolving.
      (uppercase-first? prefix)
        (gate-remote! env (module-atom prefix)
                          (erlang/binary_to_atom member))
      (BeamLisp.Env/ns_exists? prefix) (list :var prefix member)
      ; a beam-lisp namespace that is NOT loaded yet but exists (AOT module or
      ; source on the search path): load it and resolve to its var. Before
      ; this branch a fully-qualified `datom.query.engine/q` compiled as a call
      ; into an ERLANG module named "datom.query.engine" and failed at run
      ; time — or worked, depending on whether some other file had loaded the
      ; namespace first. Resolution must not depend on load order.
      (BeamLisp.Loader/resolvable? prefix)
        (do (BeamLisp.Loader/ensure_loaded prefix)
            (list :var prefix member))
      :else (gate-remote! env (erlang/binary_to_atom prefix)
                              (erlang/binary_to_atom member)))))

; ─────────────────────────────────────────────────────────────────────────────
; Compiling a symbol
; ─────────────────────────────────────────────────────────────────────────────

(defn- private-var?
  "Say whether the var `name` in namespace `ns` was defined private (`defn-`,
   `^:private`). A private var records `{:private true}` in its metadata; a
   public one has no such flag. Mirrors the genesis `private_var?`."
  [ns name]
  (let [m (BeamLisp.Env/meta ns name)]
    (and (erlang/is_tuple m)
         (= :ok (erlang/element 1 m))
         (= true (maps/get :private (erlang/element 2 m) false)))))

(defn- reject-private!
  "Stop compiling with a clear error when `target-ns/var` is a PRIVATE var
   reached from a DIFFERENT namespace.

   Clojure enforces `defn-`/`^:private` at compile time in the RESOLVING
   namespace: `var: ns/name is not public`. Same-namespace qualified access
   stays legal (a namespace may name its own private vars). This is the single
   choke point both the value-fetch path (`compile-symbol`) and the
   direct-call shortcut (`compile-call`) route through, so a private linked fn
   cannot slip past via the remote-call fast path either — matching genesis
   `private_fetch_quoted` + `reject_private_link`."
  [env target-ns var]
  (when (and (not= target-ns (:ns env))
           (private-var? target-ns var)) (compile-error env (str "var " target-ns "/" var " is not public"))))

(defn- compile-symbol
  "Turn a symbol into the tree that produces its VALUE.

   Three cases, in order:
     * a local (parameter or let binding) compiles to itself \u2014 handled by the
       caller, which holds the real Elixir variable; here we only reach the
       non-local cases;
     * a qualified name `Module/fun` or `alias/var` compiles to a remote
       function value or a variable fetch;
     * a plain name compiles to a namespace-variable fetch,
       `BeamLisp.Env.fetch!(ns, name)`.

   `name` is the symbol's text; `env` says which namespace to resolve against."
  [name env]
  (cond
    ; a local (let binding or parameter): usually its fresh var name; a named
    ; fn's own name stores the self-application NODE directly
    (local? env name)
      (let [lv (local-var env name)]
        (if (erlang/is_binary lv) (a/var lv) lv))
    (has-slash? name)
      (let [tgt (slash-target env name)]
        (if (= :remote (first tgt))
          ; Module/fun as a VALUE: a runtime remote-function reference
          (a/remote mod-rt :remote_fun (list (a/lit (second tgt)) (a/lit (nth tgt 2))))
          ; a var in another namespace: refuse a private one, else a reference
          (do (reject-private! env (second tgt) (nth tgt 2))
              (a/global (second tgt) (nth tgt 2)))))
    :else
      (a/global (:ns env) name)))

; ─────────────────────────────────────────────────────────────────────────────
; Compiling collection literals
; ─────────────────────────────────────────────────────────────────────────────

(defn- compile-vector
  "Turn a vector literal like [1 2 3] into the tree that builds a beam-lisp
   vector value.

   A beam-lisp vector is a struct wrapping a tuple of its elements. The tree
   is the Elixir struct-construction syntax for `%BeamLisp.Vector{items: {..}}`
   with each element compiled in turn."
  [items env]
  (a/structt mod-vector
             (list [(a/lit :items) (a/tup (compile-each items env))])))

(defn- compile-map
  "Turn a map literal like {:a 1} into the tree that builds a beam-lisp map.

   Every key is wrapped in `BeamLisp.RT.hash_key(...)` so that keys compare
   the way beam-lisp expects (metadata on a key is invisible to equality, so
   it must be invisible to the map too). The result is Elixir's map syntax
   `%{k => v, ...}` with each key and value compiled."
  [pairs env]
  (let [entries (apply list (map (fn [pair]
                                (let [kv (erlang/tuple_to_list pair)
                                      k (compile-node (first kv) env)
                                      v (compile-node (second kv) env)]
                                  [(a/remote mod-rt :hash_key (list k))
                                   v]))
                              pairs))]
    (a/mapp entries)))

(defn- compile-set
  "Turn a set literal like #{1 2} into the tree that builds a beam-lisp set,
   `BeamLisp.Set.new([...])` with each member compiled."
  [items env]
  (a/remote mod-set :new (list (anf-list (compile-each items env)))))

; ─────────────────────────────────────────────────────────────────────────────
; Compiling a call
; ─────────────────────────────────────────────────────────────────────────────

(defn- linked-call
  "Try to build a DIRECT call to a linked function, or return nil.

   Some names are linked to a specific implementation: `+` to the Erlang BIF
   `:erlang.+`, `first` to `BeamLisp.RT.first`, and so on. When a name is
   linked and the call's argument count matches, the call compiles to a direct
   `Module.function(args)` — no lookup, no dispatch, which is what makes hot
   loops fast. `link-info` is what `BeamLisp.Env/link` returned: a
   `{module, arity=>function-name map, variadic-or-nil}` triple. Returns the
   direct-call tree, or nil when the arity does not match (so the caller falls
   back to the general path)."
  [link-info arg-nodes]
  (let [parts (erlang/tuple_to_list link-info)
        mod (first parts)
        fixed (second parts)
        variadic (nth parts 2)
        arity (count arg-nodes)]
    (cond
      ; a fixed arity match: Module.fname(args)
      (contains? fixed arity)
        (let [fname (get fixed arity)]
          (a/remote mod fname arg-nodes))
      ; a variadic match {min, fname}: pass the first `min` args plus the rest
      ; collected into a list — Module.fname(a1, ..., amin, [rest...])
      (and (erlang/is_tuple variadic)
           (>= arity (first (erlang/tuple_to_list variadic))))
        (let [vparts (erlang/tuple_to_list variadic)
              min (first vparts)
              fname (second vparts)
              fixed-args (apply list (take min arg-nodes))
              rest-args (apply list (drop min arg-nodes))]
          ; collect the trailing args into one list literal: f(a1..amin, [rest...])
          (a/remote mod fname
                    (apply list (concat fixed-args (list (anf-list rest-args))))))
      :else nil)))

(defn- core-qualified
  "Map `clojure.core/x` to `core/x`, leaving every other name unchanged.

   A name written the Clojure way (`clojure.core/map`) refers to the same
   thing as beam-lisp's own `core/map`, so link lookup normalizes it first."
  [name]
  (if (some? (index-of name "clojure.core/"))
    (str "core/" (subs name (count "clojure.core/")))
    name))

(defn- macro-lookup
  "The macro FUNCTION bound to `name` in namespace `ns`, or nil when `name` is
   not a macro.

   A macro is stored as a variable whose value is the tagged pair
   `{:\"$macro\", fn}` — the tag says ‘this is a macro’ and the second element
   is the function that does the expanding. This looks the name up (normalized
   the same way calls are, so `clojure.core/x` finds `core/x`) and, when the
   value is that tagged pair, hands back just the function. Anything else —
   an ordinary value, an unbound name — yields nil."
  [ns name]
  ; `peek`, not `fetch`: probing whether a name is a macro at COMPILE time must
  ; not materialize a `^:per-env` value. A per-env descriptor is never a macro,
  ; so it correctly falls through. Mirrors genesis `macro_for`.
  (let [r (BeamLisp.Env/peek ns (core-qualified name))]
    (when (and (erlang/is_tuple r)
             (= :ok (erlang/element 1 r))) (let [v (erlang/element 2 r)]
        (when (and (erlang/is_tuple v)
                 (= (erlang/binary_to_atom "$macro") (erlang/element 1 v))) (erlang/element 2 v))))))

(defn- macro?
  "Say whether `name` names a macro visible in this environment's namespace.

   A macro is a variable whose value is tagged `{:\"$macro\", fn}`. When a call
   head is a macro, the call is expanded at compile time instead of being run
   — that is what makes `when`, `and`, `->`, and the rest work. Looked up
   through the same name normalization calls use."
  [env name]
  (some? (macro-lookup (:ns env) name)))

(defn- deftype-field-name
  "The field name a `.-x` / `.x` head reads, or nil when `name` is not a
   deftype field-access head.

   `(.-x obj)` and `(.x obj)` both read the field `x` off a deftype instance.
   Returns the field string (x) with the leading `.-` or `.` stripped, or nil
   when the head is a plain name, a bare `.`/`.-`, or a slash-qualified symbol.
   The field must be non-empty so a lone `.` is never mistaken for a field read."
  [name]
  (cond
    (has-slash? name) nil
    (and (> (erlang/byte_size name) 2) (= ".-" (erlang/binary_part name 0 2)))
      (erlang/binary_part name 2 (- (erlang/byte_size name) 2))
    (and (> (erlang/byte_size name) 1) (= "." (erlang/binary_part name 0 1)))
      (erlang/binary_part name 1 (dec (erlang/byte_size name)))
    :else nil))

(defn- compile-call
  "Turn a call form (head arg ...) into the tree that runs it.

   The kernel handles ordinary calls (special forms come later). Cases, in
   order:
     * a keyword head like (:a m): compiles to `RT.invoke(:a, [m])`, which
       looks the keyword up in its argument;
     * a qualified head `Module/fun`: compiles to a direct remote call
       `apply(Module, :fun, [args])`;
     * a plain name that is LINKED (like `+` or `map`): compiles to a direct
       `Module.function(args)` call when the argument count matches;
     * any other plain name: compiles to `RT.invoke(fetch(name), [args])`;
     * a compound head: compiles the head to a value and calls it.

   `items` is the whole form's children: the head followed by the arguments."
  [items env]
  (let [head (rn/node-form (first items))
        args (rest items)
        ; call arguments are never in tail position — a recur inside an
        ; argument is an error, so compile them with tail turned off
        arg-nodes (compile-each-notail args env)
        tag (rn/node-tag head)]
    (cond
      ; (:keyword m ...) — the keyword looks itself up in its argument
      (= tag :keyword)
        (anf-invoke (a/lit (BeamLisp.AtomGuard/to_atom (rn/node-name head))) arg-nodes)

      ; (Module/fun args), (alias/var args), or (ns/var args)
      (and (= tag :symbol) (has-slash? (rn/node-name head)))
        (let [tgt (slash-target env (rn/node-name head))]
          (if (= :remote (first tgt))
            ; a host-module call: Module.fun(args) directly
            (a/remote (second tgt) (nth tgt 2) arg-nodes)
            ; a var in another namespace: refuse a private one FIRST (before the
            ; linked direct-call shortcut, which bypasses the fetch path), then
            ; use the linked direct call when it is a linked defn, else invoke
            ; its fetched value
            (let [tns (second tgt) tvar (nth tgt 2)]
              (reject-private! env tns tvar)
              (let [link (BeamLisp.Env/link tns tvar)]
                (or (and (not= link :error)
                         (linked-call (second (erlang/tuple_to_list link)) arg-nodes))
                    (anf-invoke (a/global tns tvar) arg-nodes))))))

      ; deftype field access: `(.-x obj)` and `(.x obj)` both read field `x`
      ; off a deftype instance. Records have no field surface (keyword lookup
      ; is their access path), so this reaches only deftype values, via
      ; Record.deftype_field.
      (and (= tag :symbol) (= 1 (count args))
           (deftype-field-name (rn/node-name head)))
        (a/remote mod-record :deftype_field
                  (list (first arg-nodes)
                        (a/lit (erlang/binary_to_atom (deftype-field-name (rn/node-name head))))))

      ; (name args) with a plain name. A LOCAL (a parameter, a let binding)
      ; in call position faces a linked global of the same name: the decided
      ; dispatch is CALLABILITY — the local's value is invoked when it can
      ; take this many arguments (RT.invocable?), otherwise the linked global
      ; runs. `(comp a b)` with a fn parameter `comp` invokes the parameter
      ; (jank's sort-by slice depends on it); `(max h max)` with an integer
      ; binding `max` still reaches core/max (the async backpressure contract
      ; depends on THAT). Clojure would always pick the local and fail the
      ; second; always-global would fail the first. When no linked global
      ; exists the local is invoked unconditionally, exactly as before.
      (= tag :symbol)
        (let [name (rn/node-name head)]
          (if (local? env name)
            (let [link (BeamLisp.Env/link (:ns env) (core-qualified name))
                  local-node (compile-symbol name env)
                  direct (and (not= link :error)
                              (linked-call (second (erlang/tuple_to_list link)) arg-nodes))]
              (if direct
                (a/iff (a/remote mod-rt :invocable? (list local-node (a/lit (count arg-nodes))))
                       (anf-invoke local-node arg-nodes)
                       direct)
                (anf-invoke local-node arg-nodes)))
            (let [link (BeamLisp.Env/link (:ns env) (core-qualified name))]
              (or (and (not= link :error)
                       (linked-call (second (erlang/tuple_to_list link)) arg-nodes))
                  (anf-invoke (compile-symbol name env) arg-nodes)))))

      ; (expr args) with a compound head — compile it, then call it
      :else
        (anf-invoke (compile-node head env) arg-nodes))))

; ─────────────────────────────────────────────────────────────────────────────
; The one entry point
; ─────────────────────────────────────────────────────────────────────────────

(def special-forms
  "The names the compiler treats as special forms rather than function calls.
   A list whose head is one of these is compiled by its own rule."
  #{"ns" "if" "do" "throw" "try" "receive" "quote" "syntax-quote" "def" "defn" "defn-" "defmacro"
    "defmulti" "defmethod" "defprotocol" "extend-type" "extend-protocol" "satisfies?"
    "defrecord" "deftype" "reify" "defnative" "defserver"
    "let" "let*" "loop" "loop*" "fn" "fn*" "recur"})

(defn- compile-body
  "Compile body forms into one bl-ANF node (a single form, or a :do)."
  [body env]
  (cond
    (empty? body) (a/lit nil)
    (empty? (rest body)) (compile-node (first body) env)
    :else (a/doo (apply list (map (fn [f] (compile-node f env)) body)))))

(defn- compile-if
  "Turn (if test then else) into the bl-ANF :if node."
  [test then else env]
  (let [test-node (compile-node test env)
        then-node (compile-node then env)
        else-node (if (nil? else) (a/lit nil) (compile-node else env))]
    (a/iff test-node then-node else-node)))

(defn- nest-lets
  "Wrap body-node in one :let per binding step. Each step is [name init-node]."
  [steps body-node]
  (reduce (fn [inner step]
            (a/lett (first step) (second step) inner))
          body-node (reverse steps)))

(defn- self-apply
  "Build the self-application scaffold a loop uses to call itself:
   the outer fn takes `self` and returns the inner fn; applied to itself,
   the inner closes over the recursive reference."
  [self inner-fn]
  (let [outer-fn (a/fnn (list (a/clause (list (a/pvar self)) nil inner-fn)))]
    ; `let self = (fn [self] inner) in (self self)` — the inner fn appears ONCE.
    ; The previous spelling, `let self = outer in inner`, spliced `inner-fn`
    ; a second time as the let body: every fn/loop DOUBLED its body in the
    ; emitted IR, and nested scaffolds compounded (a `for` = 3 scaffolds +
    ; a duplicated branch = ×24 per level; three nested `for` = ×13 824,
    ; four never finished compiling). One occurrence is the invariant the
    ; anf-linearity proof (system.linear) holds the compiler to.
    (a/lett self outer-fn (a/app (a/var self) (list (a/var self))))))

(defn- compile-recur
  "Turn (recur value ...) into a jump back to the enclosing loop or function.

   Two ways to re-enter: a loop or anonymous fn re-enters by self-application;
   a linked defn re-enters by a direct named self-call Module.fname(args),
   which the BEAM tail-call-optimizes. recur must be in tail position, inside a
   loop or fn, with the right number of values."
  [args env]
  (let [target (:recur env)]
    (cond
      (nil? target) (compile-error env "recur used with no enclosing loop or fn")
      (not (:tail env)) (compile-error env "recur must be in tail position")
      (not= (count args) (:arity target))
        (compile-error env (str "recur arity mismatch: target takes " (:arity target)
                                ", got " (count args)))
      :else
        (let [arg-nodes (compile-each-notail args env)]
          (if (contains? target :self-call)
            ; a linked defn: a direct named self-call Module.fname(args)
            (let [mf (:self-call target)]
              (a/remote (first mf) (second mf) arg-nodes))
            ; a loop / anonymous fn: re-enter by self-application
            (let [self (:self target)
                  self-app (a/app (a/var self) (list (a/var self)))]
              (a/app self-app arg-nodes)))))))

(defn- binding-pairs
  "Split a binding vector's items into [pattern value] pairs.

   `env` is threaded only so a malformed binding vector reports with the user's
   file and line through `compile-error`."
  [items env]
  (if (odd? (count items))
    (compile-error env "binding forms must be even, each a pattern and a value")
    (loop [xs items acc (list)]
      (if (empty? xs)
        (reverse acc)
        (recur (rest (rest xs)) (cons (list (first xs) (second xs)) acc))))))

; ── destructuring ────────────────────────────────────────────────────────────
;
; A binding pattern can be more than a plain name. `[a b]` pulls the first two
; elements out of a sequence; `{:keys [x y]}` pulls named keys out of a map.
; Clojure compiles these into EXTRA plain bindings: bind the whole value to a
; temporary, then bind each name to a lookup into that temporary. So
; destructuring is not a new kind of step — it is a way to turn one fancy
; binding into several plain ones, which the existing `let` machinery then
; nests as usual.

(declare destructure-steps)

(defn- rt-nth-node
  "The node for `BeamLisp.RT.nth(whole, i)` — the i-th element of a sequence."
  [whole-node i]
  (a/remote mod-rt :nth (list whole-node (a/lit i))))

(defn- rt-get-node
  "The node for `BeamLisp.RT.get(whole, key, default)` — a map lookup with a
   fallback used when the key is absent."
  [whole-node key default-node]
  (a/remote mod-rt :get (list whole-node (a/lit key) default-node)))

(defn- rt-get-raw
  "Like rt-get-node, but the key is already a bl-ANF node."
  [whole-node key-node default-node]
  (a/remote mod-rt :get (list whole-node key-node default-node)))

(defn- rt-drop-node
  "The node for the trailing part of a sequence after the first `n` elements —
   what an `& rest` parameter binds.

   Clojure binds an EXHAUSTED rest to nil, not to an empty list, so this is a
   :case over `RT.drop(whole, n)`: an empty result becomes nil, anything else
   is the remaining sequence. Matching Clojure here matters — `(when (next s))`
   loops depend on an exhausted rest being falsey."
  [whole-node n]
  ; a FIXED `dropped` var (not gensym'd), matching the existing compiler; it is
  ; scoped to this one :case so there is no collision
  (let [drop-call (a/remote mod-rt :drop (list whole-node (a/lit n)))]
    (a/casee drop-call
             (list (a/clause (list a/pnil) nil (a/lit nil))
                   (a/clause (list (a/pvar "dropped")) nil (a/var "dropped"))))))

(defn- symbol-pattern?
  "Say whether a pattern node is a plain symbol (a simple name binding) rather
   than a vector or map pattern."
  [pat]
  (= :symbol (rn/node-tag (rn/node-form pat))))

(defn- amp?
  "Say whether a pattern node is the `&` that marks a rest parameter."
  [pat]
  (and (symbol-pattern? pat) (= "&" (rn/node-name (rn/node-form pat)))))

(defn- destructure-symbol
  "Bind a plain-name pattern to `value-node`: one step, and the name recorded
   as a local."
  [name value-node env]
  (let [var (fresh-var name)]
    {:steps (list (list var value-node)) :env (put-local env name var)}))

(defn- destructure-vector
  "Expand a vector pattern `[a b & rest :as all]` against `whole-ast`.

   Each element binds to `RT.nth(whole-ast, i)` (recursively, so `[[a] b]`
   works by indexing into an index), an `& rest` name to the trailing sequence,
   and an `:as name` to the whole value. `whole-ast` is the expression for the
   value being taken apart — already a simple variable at the top level (the
   caller binds a temporary), or an `RT.nth(...)` expression when nested."
  [elems whole-node env]
  (loop [items elems i 0 acc {:steps (list) :env env}]
    (cond
      (empty? items) acc
      ; :as name  — bind the whole value to name. Must be the LAST TWO
      ; elements: a missing name or a trailing element is a silent mis-bind,
      ; so refuse loudly (the genesis Elixir compiler raised these; the port
      ; dropped them).
      (and (= :keyword (rn/node-tag (rn/node-form (first items))))
           (= "as" (rn/node-name (rn/node-form (first items)))))
        (cond
          (nil? (second items))
            (erlang/error
              (RuntimeError/exception "\" :as \" in a vector binding must be followed by a name"))
          (not (empty? (rest (rest items))))
            (erlang/error
              (RuntimeError/exception "\" :as \" in a vector binding must be its last two elements ([... :as name])"))
          (not= :symbol (rn/node-tag (rn/node-form (second items))))
            (erlang/error
              (RuntimeError/exception "\" :as \" in a vector binding must name a symbol"))
          :else
            (let [name (rn/node-name (rn/node-form (second items)))
                  r (destructure-symbol name whole-node (:env acc))]
              (recur (rest (rest items)) i
                     {:steps (concat (:steps acc) (:steps r)) :env (:env r)})))
      ; & rest  — bind the trailing sequence
      (amp? (first items))
        (let [rest-pat (second items)
              drop-node (rt-drop-node whole-node i)]
          (if (symbol-pattern? rest-pat)
            ; a plain-name rest binds the trailing sequence directly
            (let [r (destructure-steps rest-pat drop-node (:env acc))]
              (recur (rest (rest items)) i
                     {:steps (concat (:steps acc) (:steps r)) :env (:env r)}))
            ; a COMPOSITE rest pattern: bind the trailing sequence to a temp
            ; ONCE, then destructure the pattern against that temp (so the
            ; drop expression is not re-evaluated for each nested name)
            (let [rest-var (fresh-var "rest")
                  r (destructure-steps rest-pat (a/var rest-var) (:env acc))]
              (recur (rest (rest items)) i
                     {:steps (concat (:steps acc)
                                     (cons (list rest-var drop-node) (:steps r)))
                      :env (:env r)}))))
      ; an ordinary element at position i
      :else
        (let [r (destructure-steps (first items) (rt-nth-node whole-node i) (:env acc))]
          (recur (rest items) (inc i)
                 {:steps (concat (:steps acc) (:steps r)) :env (:env r)})))))

(defn- kv-key
  "The key node of a map-node key/value pair (a 2-tuple)."
  [pair]
  (first (erlang/tuple_to_list pair)))

(defn- kv-val
  "The value node of a map-node key/value pair (a 2-tuple)."
  [pair]
  (second (erlang/tuple_to_list pair)))

(defn- destructure-map
  "Expand a map pattern against `whole-ast`.

   Binds the whole value to a temporary, then each named key to a
   `RT.get(whole, key, default)`. Handles `{:keys [x y]}` (bind x and y to keys
   :x and :y), `{:as name}` (bind the whole value), `{:or {x 0}}` (defaults for
   absent keys), and `{local :key}` (bind local to the value at :key). `kvs` is
   the list of key/value pair tuples from the map pattern node."
  [kvs whole-node env]
  (let [whole-var whole-node
        ; collect :or defaults first so any binding can use them
        ors (reduce (fn [m pair]
                      (let [k (rn/node-form (kv-key pair))]
                        (if (and (= :keyword (rn/node-tag k)) (= "or" (rn/node-name k)))
                          (reduce (fn [mm orpair]
                                    (assoc mm (rn/node-name (rn/node-form (kv-key orpair)))
                                              (kv-val orpair)))
                                  m (rn/node-items (rn/node-form (kv-val pair))))
                          m)))
                    {} kvs)
        base {:steps (list) :env env}]
    (reduce
      (fn [acc pair]
        (let [k (rn/node-form (kv-key pair))
              v (kv-val pair)]
          (cond
            ; :keys [a b] — bind each symbol to its keyword key
            (and (= :keyword (rn/node-tag k)) (= "keys" (rn/node-name k)))
              (reduce (fn [a2 sym]
                        (let [name (rn/node-name (rn/node-form sym))
                              default (get ors name)
                              default-node (if (nil? default) (a/lit nil) (compile-node default (:env a2)))
                              r (destructure-symbol name
                                   (rt-get-node whole-var (erlang/binary_to_atom name) default-node)
                                   (:env a2))]
                          {:steps (concat (:steps a2) (:steps r)) :env (:env r)}))
                      acc (rn/node-items (rn/node-form v)))
            ; :strs [s t] — like :keys, but the lookup key is the STRING of
            ; each name (`{:strs [a]}` reads key "a"), not the keyword.
            (and (= :keyword (rn/node-tag k)) (= "strs" (rn/node-name k)))
              (reduce (fn [a2 sym]
                        (let [name (rn/node-name (rn/node-form sym))
                              default (get ors name)
                              default-node (if (nil? default) (a/lit nil) (compile-node default (:env a2)))
                              r (destructure-symbol name
                                   (rt-get-node whole-var name default-node)
                                   (:env a2))]
                          {:steps (concat (:steps a2) (:steps r)) :env (:env r)}))
                      acc (rn/node-items (rn/node-form v)))
            ; :as name — bind the whole value
            (and (= :keyword (rn/node-tag k)) (= "as" (rn/node-name k)))
              (let [name (rn/node-name (rn/node-form v))
                    r (destructure-symbol name whole-var (:env acc))]
                {:steps (concat (:steps acc) (:steps r)) :env (:env r)})
            ; :or — already collected
            (and (= :keyword (rn/node-tag k)) (= "or" (rn/node-name k)))
              acc
            ; Two spellings bind a single key. Clojure's canonical form is
            ; `{local :key}` (a binding PATTERN in the key slot, the lookup
            ; keyword in the value slot). The codebase also uses the mirror
            ; `{:key local}` (keyword in the key slot, the binding symbol in
            ; the value slot); both mean the same thing, so accept both.
            ; `{:key local}` — keyword key, symbol value: bind the VALUE symbol
            ; to a lookup of the KEY keyword. (Matches genesis exactly; without
            ; this branch the value symbol was compiled as a namespace var and
            ; failed with `undefined var`.)
            (and (= :keyword (rn/node-tag k))
                 (= :symbol (rn/node-tag (rn/node-form v))))
              (let [name (rn/node-name (rn/node-form v))
                    default (get ors name)
                    default-node (if (nil? default) (a/lit nil) (compile-node default (:env acc)))
                    r (destructure-symbol name
                         (rt-get-node whole-var (erlang/binary_to_atom (rn/node-name k)) default-node)
                         (:env acc))]
                {:steps (concat (:steps acc) (:steps r)) :env (:env r)})
            ; `{local :key}` / `{[a b] :pair}` — a binding pattern in the key
            ; slot, the lookup key in the value slot. The pattern may be a plain
            ; symbol or a nested destructuring pattern, so recurse through
            ; destructure-steps rather than assuming a bare name.
            :else
              (let [key-node (rn/node-form v)
                    key-node-val (if (= :keyword (rn/node-tag key-node))
                                   (a/lit (erlang/binary_to_atom (rn/node-name key-node)))
                                   (compile-node v (:env acc)))
                    pat-node (rn/node-form (kv-key pair))]
                ; When the binding pattern is a plain symbol (`{x 'k :or {x 9}}`
                ; or `{x :key}`), apply that symbol's :or default in the lookup
                ; — the same defaulting :keys/:strs get. A nested pattern
                ; (`{[a b] :pair}`) has no single name to default, so it recurses
                ; with no default, matching genesis.
                (if (= :symbol (rn/node-tag pat-node))
                  (let [name (rn/node-name pat-node)
                        default (get ors name)
                        default-node (if (nil? default) (a/lit nil) (compile-node default (:env acc)))
                        r (destructure-symbol name
                             (rt-get-raw whole-var key-node-val default-node)
                             (:env acc))]
                    {:steps (concat (:steps acc) (:steps r)) :env (:env r)})
                  (let [r (destructure-steps (kv-key pair)
                                             (rt-get-raw whole-var key-node-val (a/lit nil))
                                             (:env acc))]
                    {:steps (concat (:steps acc) (:steps r)) :env (:env r)}))))))
      base kvs)))

(defn- destructure-steps
  "Turn one binding pattern against `value-node` into a list of plain
   [fresh-name value-node] steps plus the updated environment.

   A plain name is one step. A vector pattern `[a b]` or a map pattern
   `{:keys [..]}` expands into several — a temporary for the whole value, then
   one step per destructured name. Nested patterns recurse."
  [pattern value-node env]
  (let [pat (rn/node-form pattern)
        tag (rn/node-tag pat)]
    (cond
      (= tag :symbol) (destructure-symbol (rn/node-name pat) value-node env)
      (= tag :vector) (destructure-vector (rn/node-items pat) value-node env)
      (= tag :map) (destructure-map (rn/node-items pat) value-node env)
      :else (compile-error env "unsupported binding pattern: expected a symbol, vector, or map" pattern))))

(defn- compile-let
  "Turn (let [pattern value ...] body...) into nested immediately-called fns.

   Each binding's value is compiled against the environment so far, then the
   binding's pattern is expanded into one or more plain steps (a plain name is
   one step; a vector or map pattern expands into several). The steps nest as
   immediately-called functions, and the body runs with all the bound names in
   scope."
  [bindings-form body env]
  (let [items (rn/node-items (rn/node-form bindings-form))
        pairs (binding-pairs items env)
        result (reduce
                 (fn [acc pair]
                   (let [e (:env acc)
                         init-node (compile-node (second pair) (notail e))]
                     (if (symbol-pattern? (first pair))
                       ; a plain name: one step, no temporary
                       (let [r (destructure-symbol (rn/node-name (rn/node-form (first pair)))
                                                   init-node e)]
                         {:steps (concat (:steps acc) (:steps r)) :env (:env r)})
                       ; a destructuring pattern: bind the value to a temporary
                       ; ONCE (so it is not recomputed for each name), then
                       ; index into that temporary
                       (let [whole-var (fresh-var "whole")
                             r (destructure-steps (first pair) (a/var whole-var) e)]
                         {:steps (concat (:steps acc)
                                         (cons (list whole-var init-node) (:steps r)))
                          :env (:env r)}))))
                 {:steps (list) :env env} pairs)
        final-env (:env result)
        steps (:steps result)
        body-node (compile-body body final-env)]
    (nest-lets steps body-node)))

(defn- compile-loop
  "Turn (loop [pattern value ...] body...) into a self-re-entrant function.

   A binding whose pattern is a plain name becomes a loop PARAMETER directly.
   A destructuring pattern (`[x :as xs]`, `{:keys [a]}`) instead binds a fresh
   `whole` parameter and emits destructure steps that run at the TOP of the
   body — so a `recur` that hands back a new value re-destructures it every
   iteration, exactly as the genesis `loop_bindings` does. This is what lets
   `(loop [[x :as xs] (list 1 2 3)] … (recur (rest xs)))` rebind x/xs each turn
   and terminate on the exhausted-rest nil."
  [bindings-form body env]
  (let [items (rn/node-items (rn/node-form bindings-form))
        pairs (binding-pairs items env)
        built (reduce
                (fn [acc pair]
                  (let [pat-node (first pair)
                        pat (rn/node-form pat-node)]
                    (if (= :symbol (rn/node-tag pat))
                      ; a plain name is a loop parameter
                      (let [name (rn/node-name pat)
                            var (fresh-var name)]
                        {:params (cons var (:params acc))
                         :args (cons (compile-node (second pair) (notail env)) (:args acc))
                         :steps (:steps acc)
                         :env (put-local (:env acc) name var)})
                      ; a destructuring pattern: a `whole` param + prelude steps
                      (let [whole (fresh-var "whole")
                            r (destructure-steps pat-node (a/var whole) (:env acc))]
                        {:params (cons whole (:params acc))
                         :args (cons (compile-node (second pair) (notail env)) (:args acc))
                         :steps (concat (:steps acc) (:steps r))
                         :env (:env r)}))))
                {:params (list) :args (list) :steps (list) :env env} pairs)
        params (reverse (:params built))
        arg-nodes (reverse (:args built))
        prelude-steps (:steps built)
        self (fresh-var "loop")
        loop-env (assoc (:env built) :recur {:self self :arity (count params)} :tail true)
        body-core (compile-body body loop-env)
        body-node (if (empty? prelude-steps)
                    body-core
                    (nest-lets prelude-steps body-core))
        inner-fn (a/fnn (list (a/clause (apply list (map (fn [v] (a/pvar v)) params)) nil body-node)))
        self-applied (self-apply self inner-fn)
        app (a/app self-applied arg-nodes)
        ; A ^{:decreasing …} measure on the bindings vector is a TRUSTED
        ; termination proof the author asserts. It is author metadata the
        ; compiler otherwise drops, so stamp it onto the scaffold's :ann here —
        ; the same channel that carries position and proofs. The termination
        ; engine then reads trust and location from the IR, with no second pass
        ; over the surface form. Lowering ignores unknown :ann keys.
        bmeta (rn/node-pos bindings-form)
        decreasing (when (and (erlang/is_map bmeta) (maps/is_key :decreasing bmeta))
                     (maps/get :decreasing bmeta))]
    (if (nil? decreasing)
      app
      (assoc app :ann (assoc (or (:ann app) {}) :decreasing decreasing)))))
(defn- compile-throw
  "Turn (throw x) into BeamLisp.ExInfo.raise_payload(x)."
  [x env]
  (a/remote mod-exinfo :raise_payload (list (compile-node x (notail env)))))

; ---- pattern matching (receive) ----------------------------------------------
;
; A message pattern matches the shape of a value. beam-lisp patterns compile to
; Elixir match patterns, with one twist: a vector pattern `[a b]` matches BOTH
; an Erlang tuple `{a, b}` AND a beam-lisp `%Vector{}`, because a small vector
; is a tuple wrapped in a struct. So a pattern can produce SEVERAL alternative
; Elixir patterns; the caller emits one clause per alternative, sharing one
; body. `compile-pattern` returns [alternatives env-with-bindings].

(def ^:private max-pattern-alternatives
  "The most Elixir clauses one beam-lisp pattern may expand into before the
   compiler refuses it. A vector pattern matches both a tuple and a vector, so
   alternatives double per nesting level; this ceiling (64) stops a deeply
   nested pattern from generating an explosion of clauses. Matches the genesis
   `@max_pattern_alternatives`."
  64)

(declare compile-pattern)

(defn- pattern-product
  "Combine sub-pattern alternatives into the product of Elixir patterns.

   Each sub-pattern may have several alternatives; the result is every
   combination, threading the environment so all combinations share the same
   fresh binding variables. Returns [list-of-combos env]."
  [forms env]
  (let [built (reduce (fn [acc form]
                        (let [r (compile-pattern form (:env acc))]
                          {:alts (concat (:alts acc) (list (first r))) :env (second r)}))
                      {:alts (list) :env env}
                      forms)
        alt-lists (:alts built)
        ; count the product BEFORE building it. A vector pattern matches both a
        ; tuple and a beam-lisp vector, so each nesting level DOUBLES the count;
        ; seven levels deep is 128 combinations. Multiplying the child lengths
        ; answers 'how big would this get?' for a few integers, so an over-large
        ; pattern is refused instantly instead of exhausting the compiler while
        ; building the very list whose size is illegal. Mirrors the genesis
        ; `compile_alternatives` ceiling (max-pattern-alternatives).
        product-count (reduce (fn [n alts] (* n (count alts))) 1 alt-lists)
        _ (when (> product-count max-pattern-alternatives) (compile-error env
              (str "this pattern nests too deeply: a vector pattern matches both a tuple and a "
                   "beam-lisp vector, and those alternatives multiply through nesting, so "
                   product-count " clauses would be generated (the ceiling is "
                   max-pattern-alternatives "). Match the outer shape and destructure the "
                   "rest in the body with `let`.")))
        ; cartesian product of the alternative lists
        combos (reduce (fn [acc alts]
                         (apply list
                           (mapcat (fn [prefix]
                                     (map (fn [alt] (concat prefix (list alt))) alts))
                                   acc)))
                       (list (list))
                       alt-lists)]
    (list combos (:env built))))

(defn- compile-pattern
  "Compile a message pattern into [alternatives env].

   `_` matches anything (no binding); a symbol binds a fresh variable; a keyword
   or literal matches itself; `[p q]` matches a tuple OR a vector (both
   alternatives, for every combination of the items' own alternatives); `{:k p}`
   matches a map; `(quote datum)` matches literal data."
  [form env]
  (let [f (rn/node-form form)
        tag (rn/node-tag f)]
    (cond
      (and (= tag :symbol) (= "_" (rn/node-name f)))
        (list (list (a/pvar "_")) env)
      (= tag :symbol)
        (let [name (rn/node-name f) var (fresh-var name)]
          (list (list (a/pvar var)) (put-local env name var)))
      (= tag :keyword)
        (list (list (a/plit (erlang/binary_to_atom (rn/node-name f)))) env)
      (= tag :vector)
        (let [pr (pattern-product (rn/node-items f) env)
              combos (first pr)
              alts (apply list
                     (mapcat (fn [pats]
                               (let [ps (apply list pats)]
                                 (list (a/ptuple ps)
                                       (a/pstruct mod-vector
                                                  ; pstruct field keys are RAW
                                                  ; atoms (norm-pattern's
                                                  ; encoding; quote-pat and
                                                  ; lower-anf-pattern-key both
                                                  ; expect it), not plit nodes
                                                  (list [:items (a/ptuple ps)])))))
                             combos))]
          ; a vector matches a tuple OR a beam-lisp vector, so this doubles the
          ; child count. Refuse once the doubled alternatives cross the ceiling
          ; — the check the product-count in `pattern-product` cannot see,
          ; because the doubling happens HERE. Mirrors the genesis per-pattern
          ; `compile_pattern` length gate.
          (when (> (count alts) max-pattern-alternatives) (compile-error env
              (str "this pattern nests too deeply: a vector pattern matches both a tuple and a "
                   "beam-lisp vector, and those alternatives multiply through nesting, so "
                   (count alts) " clauses would be generated (the ceiling is "
                   max-pattern-alternatives "). Match the outer shape and destructure the "
                   "rest in the body with `let`.")))
          (list alts (second pr)))
      (= tag :map)
        (let [kvs (rn/node-items f)
              keys (apply list (map (fn [pair]
                                      (let [k (rn/node-form (kv-key pair))]
                                        ; map-pattern keys are :lit EXPRESSION
                                        ; nodes (norm-pattern's encoding:
                                        ; normalise of the key form), not plit
                                        (a/lit (erlang/binary_to_atom (rn/node-name k)))))
                                    kvs))
              pr (pattern-product (apply list (map kv-val kvs)) env)
              combos (first pr)]
          (list (apply list
                  (map (fn [vals]
                         (a/pmap
                           (apply list
                             (loop [ks keys vs vals acc (list)]
                               (if (or (empty? ks) (empty? vs))
                                 (reverse acc)
                                 (recur (rest ks) (rest vs)
                                        (cons [(first ks) (first vs)] acc)))))))
                       combos))
                (second pr)))
      :else
        ; a number, string, boolean, or nil matches itself
        (list (list (a/plit f)) env))))

; ---- try / catch / finally ---------------------------------------------------
;
; `(try body... (catch e handler...) (finally cleanup...))` becomes an Elixir
; `try/catch/after`. The single catch clause catches ALL exit kinds, normalizes
; the raised value the way Clojure expects (a thrown value stays itself; an
; error becomes an exception struct; an exit becomes {:exit, v}), binds it to
; the handler's name, and runs the handler. A `finally` becomes the `after`
; block that always runs.

(defn- catch-clause-form?
  "Say whether a try sub-form is a (catch ...) clause."
  [form]
  (let [f (rn/node-form form)]
    (and (= :list (rn/node-tag f))
         (let [items (rn/node-items f)]
           (and (not (empty? items))
                (= :symbol (rn/node-tag (rn/node-form (first items))))
                (= "catch" (rn/node-name (rn/node-form (first items)))))))))

(defn- finally-clause-form?
  "Say whether a try sub-form is a (finally ...) clause."
  [form]
  (let [f (rn/node-form form)]
    (and (= :list (rn/node-tag f))
         (let [items (rn/node-items f)]
           (and (not (empty? items))
                (= :symbol (rn/node-tag (rn/node-form (first items))))
                (= "finally" (rn/node-name (rn/node-form (first items)))))))))

(defn- anf-and2
  "Strict boolean AND of two nodes, lowered as the if-chain the normaliser
   uses for quoted `and`."
  [x y]
  (a/iff x y (a/lit false)))

(defn- catch-handler-node
  "Build the body a catch clause runs once it matches: bind the handler's name
   to the normalized exception value, then run the handler forms. Shared by the
   typed and untyped branches, mirroring the genesis `run_handler`."
  [e-name handler-forms e-var env]
  (let [handler-var (fresh-var e-name)
        handler-env (put-local env e-name handler-var)
        handler-body (compile-body handler-forms handler-env)]
    (a/lett handler-var (a/var e-var) handler-body)))

(defn- catch-cond-branch
  "Compile ONE (catch …) clause into a `cond` branch `[test] -> handler`.

   Two shapes, decided by the clause's first element:
     * `(catch e handler…)`         — an untyped catch-all: the test is `true`,
       so it matches every caught value. `e` binds the exception.
     * `(catch Module.Name e handler…)` — a typed catch: the test is
       `is_struct(e, Module.Name)`, so it matches only that exception struct;
       `e` binds it.
   A first element that is neither a bare variable nor a dotted Module.Name
   (e.g. `(catch :bad e …)`) is refused with the same message the genesis
   compiler raises, because a keyword/literal names no catchable shape."
  [catch-form e-var env]
  (let [items (rn/node-items (rn/node-form catch-form))
        first-node (rn/node-form (second items))
        first-tag (rn/node-tag first-node)]
    (if-not (= :symbol first-tag) (compile-error env (str "catch requires a variable or Module.Name, got a " (rn/node-tag first-node))) (let [name (rn/node-name first-node)]
        (if (uppercase-first? name)
          ; typed: (catch Module.Name e handler…)
          (let [rest-items (rest (rest items))
                e-name (rn/node-name (rn/node-form (first rest-items)))
                handler-forms (rest rest-items)
                ; the module the type names, as its BEAM atom
                mod-atom (module-atom name)
                ; `is_struct(e, Mod)` is a Kernel guard, not an :erlang BIF, so
                ; build its expansion directly: e is a map whose :__struct__ is
                ; exactly Mod. `and` lowers as the if-chain the normaliser uses.
                test (anf-and2 (anf-and2 (a/remote mod-erlang :is_map (list (a/var e-var)))
                                         (a/remote mod-erlang :is_map_key (list (a/lit :__struct__) (a/var e-var))))
                               (a/remote mod-erlang (erlang/binary_to_atom "=:=")
                                         (list (a/remote mod-erlang :map_get (list (a/lit :__struct__) (a/var e-var)))
                                               (a/lit mod-atom))))
                handler (catch-handler-node e-name handler-forms e-var env)]
            (a/clause (list test) nil handler))
          ; untyped: (catch e handler…)
          (let [handler-forms (rest (rest items))
                handler (catch-handler-node name handler-forms e-var env)]
            (a/clause (list (a/lit true)) nil handler)))))))

(defn- compile-catch-dispatch
  "Compile ALL of a try's catch clauses into a single `cond` dispatch.

   Each clause becomes one `cond` branch (typed or untyped, see
   `catch-cond-branch`); the FIRST branch whose test holds wins, so an earlier
   clause shadows a later one — the `first matching clause wins` rule. A final
   `true -> reraise` branch re-raises the original kind/value/stack when every
   clause is typed and none matched, so an unmatched typed catch propagates
   instead of being swallowed. Mirrors the genesis catch dispatch."
  [catches e-var kind-var value-var stack-var env]
  (let [branches (apply list (map (fn [c] (catch-cond-branch c e-var env)) catches))
        reraise (a/remote mod-erlang :raise (list (a/var kind-var) (a/var value-var) (a/var stack-var)))
        fallthrough (a/clause (list (a/lit true)) nil reraise)
        all-branches (apply list (concat branches (list fallthrough)))]
    ; the first branch whose test holds wins — a nested if-chain, exactly the
    ; normaliser's encoding of quoted `cond` (the last test is `true`)
    (let [init (:body (first (reverse all-branches)))]
      (reduce (fn [else cl]
                (a/iff (first (:pats cl)) (:body cl) else))
              init
              (rest (reverse all-branches))))))

(defn- after-clause-form?
  "Say whether a receive sub-form is an (after ms body) clause."
  [form]
  (let [f (rn/node-form form)]
    (and (= :list (rn/node-tag f))
         (let [items (rn/node-items f)]
           (and (not (empty? items))
                (= :symbol (rn/node-tag (rn/node-form (first items))))
                (= "after" (rn/node-name (rn/node-form (first items)))))))))

(defn- receive-clause-forms
  "Group a receive's forms into {pattern guard body} triples.

   Each clause is a pattern, an optional `:when guard`, then a single body
   form. Returns a list of {:pattern :guard :body}. A clause whose `:when`
   guard has no body form after it is refused (`env` carries the position)."
  [forms env]
  (loop [fs forms acc (list)]
    (if (empty? fs)
      (reverse acc)
      (let [pattern (first fs)
            after-pat (rest fs)
            gb (split-when after-pat env)      ; [guard-or-nil rest]
            guard (first gb)
            body-and-more (second gb)
            _ (when (and (some? guard) (empty? body-and-more)) (compile-error env "a receive clause needs a body after its `:when` guard"))
            body (first body-and-more)]
        (recur (rest body-and-more)
               (cons {:pattern pattern :guard guard :body body} acc))))))

(defn- compile-receive
  "Compile (receive pattern body... (after ms body)) into an Elixir receive.

   Each clause's pattern may match several shapes (a vector matches a tuple and
   a beam-lisp vector), so it expands to one `->` clause per alternative,
   sharing the clause's body. A `:when` guard rides on the clause head. An
   optional `(after ms body)` becomes the receive timeout."
  [forms env]
  (let [after-forms (filter after-clause-form? forms)
        normal (filter (fn [f] (not (after-clause-form? f))) forms)
        clauses (receive-clause-forms normal env)
        ; each clause -> one ANF clause per pattern alternative
        do-clauses (apply list
                     (mapcat (fn [cl]
                               (let [pr (compile-pattern (:pattern cl) env)
                                     pats (first pr)
                                     pat-env (second pr)
                                     guard-node (if (nil? (:guard cl)) nil
                                                  (compile-guard (:guard cl) pat-env))
                                     body-node (compile-node (:body cl) pat-env)]
                                 (map (fn [pat]
                                        (a/clause (list pat) guard-node body-node))
                                      pats)))
                             clauses))]
    (if (empty? after-forms)
      (a/recv do-clauses nil nil)
      (let [af-items (rn/node-items (rn/node-form (first after-forms)))
            timeout (compile-node (second af-items) (notail env))
            after-body (compile-node (nth af-items 2) env)]
        (a/recv do-clauses timeout after-body)))))

(defn- compile-try
  "Compile (try body... (catch e h...) (finally f...)) into Elixir try/catch.

   A try with neither catch nor finally is just its body. Otherwise it builds a
   `try` with a single catch-all clause (normalizing the caught value) and an
   optional `after` block."
  [forms env]
  (let [catches (filter catch-clause-form? forms)
        finallies (filter finally-clause-form? forms)
        body (filter (fn [f] (not (or (catch-clause-form? f) (finally-clause-form? f)))) forms)]
    (if (and (empty? catches) (empty? finallies))
      (compile-body body env)
      (let [body-node (compile-body body env)
            kind-var (fresh-var "kind")
            value-var (fresh-var "value")
            e-var (fresh-var "e")
            stack-var (fresh-var "stack")
            ; e = case kind do :throw -> value; :error -> normalize; :exit -> {:exit,value}
            ; stack-var is v3_core's RAW stacktrace (a wrapper tuple): the
            ; reraise below must pass it to raise/raw_raise AS IS — the primop
            ; takes the raw form and a plain frame list SEGFAULTS the VM. But
            ; Exception.normalize wants the frame LIST (element 2 of the raw
            ; form — what Elixir's compiler emits for a __STACKTRACE__ read),
            ; or an undef normalizes to a fieldless %UndefinedFunctionError{}
            ; ("undefined function" with no module named).
            raw-stack (a/var stack-var)
            frame-list (a/remote mod-erlang :element (list (a/lit 2) raw-stack))
            ; e = case kind do :throw -> value; :error -> normalize; :exit -> {:exit,value}
            normalize (a/casee (a/var kind-var)
                               (list (a/clause (list (a/plit :throw)) nil (a/var value-var))
                                     (a/clause (list (a/plit :error)) nil
                                               (a/remote mod-exception :normalize
                                                         (list (a/lit :error) (a/var value-var) frame-list)))
                                     (a/clause (list (a/plit :exit)) nil
                                               (a/tup (list (a/lit :exit) (a/var value-var))))))
            ; the catch branch exists only when there ARE catch clauses (a try
            ; with only a finally emits just [body, after]); the lowerer binds
            ; the cerl var `__STACKTRACE__` around every catch clause's body
            dispatch-body (if (empty? catches) nil
                            (compile-catch-dispatch catches e-var kind-var value-var stack-var env))
            catch-clauses (if (empty? catches) (list)
                            (list (a/clause (list (a/pvar kind-var) (a/pvar value-var))
                                            nil
                                            (a/lett stack-var (a/var "__STACKTRACE__")
                                                    (a/lett e-var normalize dispatch-body)))))
            after-node (if (empty? finallies) nil
                         (let [fin-items (rest (rn/node-items (rn/node-form (first finallies))))]
                           (compile-body fin-items (notail env))))]
        (a/tryy body-node catch-clauses after-node)))))

(defn- datum
  "Turn a reader form into the plain DATA value it denotes.

   This is what `quote` hands back: the form as data, not as running code. A
   symbol stays a symbol node, a list becomes a list of data, a vector becomes
   a real beam-lisp vector, a keyword becomes its atom, and a plain literal is
   itself. Source-location wrappers are peeled first."
  [form]
  (let [tag (rn/node-tag form)]
    (cond
      ; a metadata wrapper carries two kinds of key. POSITIONAL keys
      ; (:line/:col/:file) are the compiler's source channel and are dropped
      ; here (a {:meta list m} wrapper would break rest-based macros like `->`).
      ; AUTHOR keys (^{:key …}) ARE data and must survive the macro-argument
      ; boundary, exactly as they survive compile/2 — they re-attach to the
      ; datum'd VALUE. Only a vector can carry them (its struct has a `meta`
      ; field, so first/rest/seq/count still work); a list has no such field so
      ; list metadata stays dropped. Mirrors genesis datum/1 (BUG-009).
      (= tag :meta)
        (let [m (rn/node-pos form)
              author (if (erlang/is_map m) (maps/without (list :line :col :file :end-line :end-col) m) {})
              base (datum (rn/node-form form))]
          (if (and (erlang/is_map author)
                   (pos? (maps/size author))
                   (vector? base))
            ; re-attach the author map onto the vector's meta field via the same
            ; runtime setter compile/2 uses; a non-vector (a list) drops it.
            (BeamLisp.FormMeta/with_meta base author)
            base))
      (= tag :symbol) form
      (= tag :keyword) (erlang/binary_to_atom (rn/node-name form))
      (= tag :list) (apply list (map datum (rn/node-items form)))
      (= tag :vector) (BeamLisp.Vector/new (apply list (map datum (rn/node-items form))))
      (= tag :set) (BeamLisp.Set/new (apply list (map datum (rn/node-items form))))
      (= tag :map)
        ; build a plain map value from the key/value data; :maps.from_list
        ; takes a list of {k, v} tuples, which is what each pair becomes
        (maps/from_list
          (apply list (map (fn [pair]
                             (let [kv (erlang/tuple_to_list pair)]
                               (erlang/list_to_tuple
                                 (list (datum (first kv)) (datum (second kv))))))
                           (rn/node-items form))))
      :else form)))

(defn- compile-quote
  "Turn (quote form) into the data the form denotes, as a literal value.

   `quote` says 'do not evaluate this — give it back as data'. The datum (the
   form as a plain value) embeds directly as a bl-ANF literal: the lowerer
   abstracts any ground term, so a quoted list, symbol, or literal is a
   constant in the compiled code."
  [form]
  (a/lit (datum form)))

; ── guards ────────────────────────────────────────────────────────────────────
;
; A clause can carry a `:when` guard — a test the BEAM checks BEFORE running
; the clause body, using only side-effect-free operations. Because the BEAM
; evaluates guards specially, a guard is compiled in a RESTRICTED dialect:
; comparisons and type tests become direct `:erlang` calls, `and`/`or`/`not`
; become the short-circuit `andalso`/`orelse`/`not`, and a fixed set of
; predicates (`int?`, `pos?`, `nil?`, `vector?`, …) expand to their guard-safe
; definitions. Anything else is refused, matching what the BEAM allows.

(defn- erl-call
  "The node for a direct Erlang call `:mod.fun(args)` — the building block of
   guard expressions."
  [mod fun args]
  (a/remote mod fun args))

(def ^:private guard-bifs
  "The guard vocabulary: each allowed name mapped to how it compiles. A
   `[:bif mod fun arity]` entry becomes a direct Erlang call; a
   `[:expand tag arity]` entry expands to a guard-safe expression built by
   guard-special."
  {"="  (list :bif :erlang :== 2)   "==" (list :bif :erlang :== 2)
   "not=" (list :bif :erlang :"/=" 2)
   "<"  (list :bif :erlang :< 2)    ">"  (list :bif :erlang :> 2)
   "<=" (list :bif :erlang :"=<" 2) ">=" (list :bif :erlang :>= 2)
   "+"  (list :bif :erlang :+ 2)    "-"  (list :bif :erlang :- 2)
   "*"  (list :bif :erlang :* 2)    "rem" (list :bif :erlang :rem 2)
   "tuple-size" (list :bif :erlang :tuple_size 1)
   "int?" (list :bif :erlang :is_integer 1)
   "float?" (list :bif :erlang :is_float 1)
   "number?" (list :bif :erlang :is_number 1)
   "string?" (list :bif :erlang :is_binary 1)
   "tuple?" (list :bif :erlang :is_tuple 1)
   "list?" (list :bif :erlang :is_list 1)
   "pid?" (list :bif :erlang :is_pid 1)
   "ref?" (list :bif :erlang :is_reference 1)
   "port?" (list :bif :erlang :is_port 1)
   "fn?" (list :expand :guard_fn 1)
   "nil?" (list :expand :guard_nil 1)
   "some?" (list :expand :guard_some 1)
   "true?" (list :expand :guard_true 1)
   "keyword?" (list :expand :guard_keyword 1)
   "map?" (list :expand :guard_map 1)
   "vector?" (list :expand :guard_vector 1)
   "zero?" (list :expand :guard_zero 1)
   "pos?" (list :expand :guard_pos 1)
   "neg?" (list :expand :guard_neg 1)})

(defn- g-and
  "Strict boolean AND of two guard nodes (the if-chain the normaliser uses
   for quoted `and`)."
  [a b]
  (anf-and2 a b))

(defn- g-or
  "Boolean OR of two guard nodes, as an if-chain (case-in-guard is legal
   Core Erlang)."
  [a b]
  (a/iff a (a/lit true) b))

(defn- g-eq3
  "Strict equality `a =:= b` between guard nodes."
  [a b]
  (a/remote mod-erlang (erlang/binary_to_atom "=:=" ) (list a b)))

(defn- g-ne3
  "Strict inequality `a =/= b` between guard nodes."
  [a b]
  (a/remote mod-erlang (erlang/binary_to_atom "=/=") (list a b)))

(defn- guard-special
  "Expand a guard predicate that no single Erlang BIF captures into a
   guard-safe expression. `tag` names the predicate; `args` are the already-
   compiled argument trees (each predicate takes one)."
  [tag args]
  (let [x (first args)]
    (cond
      (= tag :guard_nil) (erl-call :erlang (erlang/binary_to_atom "=:=") (list x (a/lit nil)))
      (= tag :guard_some) (erl-call :erlang (erlang/binary_to_atom "=/=") (list x (a/lit nil)))
      (= tag :guard_true) (erl-call :erlang (erlang/binary_to_atom "=:=") (list x (a/lit true)))
      (= tag :guard_zero) (erl-call :erlang :== (list x (a/lit 0)))
      (= tag :guard_pos) (erl-call :erlang :> (list x (a/lit 0)))
      (= tag :guard_neg) (erl-call :erlang :< (list x (a/lit 0)))
      (= tag :guard_keyword)
        ; an atom that is not true/false/nil
        (g-and (erl-call :erlang :is_atom (list x))
               (g-and (g-ne3 x (a/lit true))
                      (g-and (g-ne3 x (a/lit false)) (g-ne3 x (a/lit nil)))))
      (= tag :guard_vector)
        ; a map carrying a :__struct__ of BeamLisp.Vector (left-nested and)
        (g-and (g-and (erl-call :erlang :is_map (list x))
                      (erl-call :erlang :is_map_key (list (a/lit :__struct__) x)))
               (g-eq3 (erl-call :erlang :map_get (list (a/lit :__struct__) x))
                      (a/lit mod-vector)))
      (= tag :guard_fn)
        (g-or (erl-call :erlang :is_function (list x))
              (g-and (erl-call :erlang :is_tuple (list x))
                     (g-and (erl-call :erlang :==
                                      (list (erl-call :erlang :tuple_size (list x)) (a/lit 3)))
                            (g-in-list (erl-call :erlang :element (list (a/lit 1) x))
                                       (list (erlang/binary_to_atom "$blfn")
                                             (erlang/binary_to_atom "$remote"))))))
      (= tag :guard_map)
        ; a plain map that is not one of the wrapper structs
        (let [wrapper-atoms (list mod-vector
                                  mod-set
                                  (erlang/binary_to_atom "Elixir.BeamLisp.LazySeq")
                                  (erlang/binary_to_atom "Elixir.BeamLisp.Sorted.SortedSet")
                                  (erlang/binary_to_atom "Elixir.BeamLisp.Atom")
                                  (erlang/binary_to_atom "Elixir.BeamLisp.Volatile")
                                  (erlang/binary_to_atom "Elixir.BeamLisp.Promise")
                                  (erlang/binary_to_atom "Elixir.BeamLisp.Future")
                                  (erlang/binary_to_atom "Elixir.BeamLisp.Reduced"))
              has-struct (erl-call :erlang :is_map_key (list (a/lit :__struct__) x))
              struct-val (erl-call :erlang :map_get (list (a/lit :__struct__) x))
              in-wrappers (g-in-list struct-val wrapper-atoms)]
          (g-and (erl-call :erlang :is_map (list x))
                 (g-or (a/remote mod-erlang :not (list has-struct))
                       (a/remote mod-erlang :not (list in-wrappers)))))
      :else (throw (str "compiler: unknown guard expansion " tag)))))

(defn- g-in-list
  "Membership test `x in [a, b, …]` as a nested =:= if-chain — the guard-safe
   expansion of Elixir's `in` operator."
  [x atoms]
  (if (empty? atoms)
    (a/lit false)
    (a/iff (g-eq3 x (a/lit (first atoms)))
           (a/lit true)
           (g-in-list x (rest atoms)))))

(declare compile-guard)

(defn- guard-vocabulary
  "The guard vocabulary as a human-readable, comma-separated, backtick-quoted
   list — every allowed predicate/operator name, sorted. Named in the
   'not allowed in a guard' error so the reader learns what a guard MAY call
   instead of just what it may not. Matches the genesis `guard_vocabulary`."
  []
  (let [names (lists/sort (apply list (concat (maps/keys guard-bifs) (list "and" "or" "not"))))]
    (reduce (fn [acc n]
              (let [quoted (str "`" n "`")]
                (if (= acc "") quoted (str acc ", " quoted))))
            "" names)))

(defn- compile-guard-list
  "Compile a guard call `(op args...)` into a guard-safe tree.

   `and`/`or`/`not` become the short-circuit `andalso`/`orelse`/`not`; a name
   in the guard vocabulary becomes its BIF call or its expansion; anything
   else is refused, matching the BEAM's rule that a guard calls no user code."
  [items env]
  (let [head (rn/node-form (first items))
        name (rn/node-name head)
        args (rest items)]
    (cond
      (= name "and")
        ; an if-chain, not erlang:andalso/2 (which does not exist — a call to
        ; it in a guard makes the guard silently fail). This is the same
        ; shape the normaliser gives genesis's quoted `:and`.
        (reduce (fn [acc a] (g-and acc (compile-guard a env)))
                (compile-guard (first args) env) (rest args))
      (= name "or")
        (reduce (fn [acc a] (g-or acc (compile-guard a env)))
                (compile-guard (first args) env) (rest args))
      (= name "not")
        (erl-call :erlang :not (list (compile-guard (first args) env)))
      (contains? guard-bifs name)
        (let [entry (get guard-bifs name)
              arg-nodes (apply list (map (fn [a] (compile-guard a env)) args))]
          (if (= :bif (first entry))
            (erl-call (second entry) (nth entry 2) arg-nodes)
            (guard-special (second entry) arg-nodes)))
      :else
        (compile-error env
          (str "`" name "` is not allowed in a guard. The BEAM evaluates guards without "
               "calling user code, so only side-effect-free tests are permitted: "
               (guard-vocabulary) ". Move the rest into the clause body.")))))

(defn- compile-guard
  "Compile one guard expression into a guard-safe Elixir tree.

   A bound local becomes its variable; a keyword becomes its atom; a number,
   string, or boolean is itself; a list is a guard call (see
   compile-guard-list). A name not bound by the clause head is refused — a
   guard can only see what the head binds."
  [form env]
  (let [f (rn/node-form form)
        tag (rn/node-tag f)]
    (cond
      (= tag :symbol)
        (if (local? env (rn/node-name f))
          (a/var (local-var env (rn/node-name f)))
          (compile-error env (str "`" (rn/node-name f) "` is not bound by this clause's pattern")))
      (= tag :keyword) (a/lit (erlang/binary_to_atom (rn/node-name f)))
      (= tag :list) (compile-guard-list (rn/node-items f) env)
      :else (a/lit f))))

(defn- guardable-env
  "Narrow an env so a guard may read ONLY the variables the clause head binds.

   A BEAM guard runs BEFORE the body, so it can see the head's own parameters
   but NOT a destructured name (those are bound by a body prelude that has not
   run yet) nor any outer local. `head-vars` is the list of parameter var-ASTs
   in the clause head; this keeps only the `:locals` entries whose variable is
   one of them, so a guard reading a destructured or unbound name is refused
   with 'not bound by this clause's pattern' instead of leaking an undefined
   variable from generated Elixir. Mirrors the genesis `guardable_env`."
  [env head-vars]
  (let [head-set (into #{} head-vars)]
    (assoc env :locals
           (maps/filter (fn [_name var] (contains? head-set var))
                        (:locals env)))))

(defn- amp-node?
  "Say whether a param node is the `&` marking the start of a rest parameter."
  [pform]
  (and (= :symbol (rn/node-tag (rn/node-form pform)))
       (= "&" (rn/node-name (rn/node-form pform)))))

(defn- split-variadic
  "Split a parameter list at `&` into [fixed-params rest-param-or-nil].

   `[a b]` -> [(a b) nil]; `[a & r]` -> [(a) r]. The rest parameter is the one
   form after `&` (a name or a destructuring pattern)."
  [param-forms]
  (loop [ps param-forms fixed (list)]
    (cond
      (empty? ps) [(reverse fixed) nil]
      (amp-node? (first ps))
        ; exactly one form may follow `&` — a name or one pattern
        (if (and (some? (second ps)) (empty? (rest (rest ps))))
          [(reverse fixed) (second ps)]
          (erlang/error (RuntimeError/exception "& in params must be followed by exactly one parameter")))
      :else (recur (rest ps) (cons (first ps) fixed)))))

(defn- check-rest-pattern!
  "Refuse a MAP pattern in rest position.

   The rest is always a positional seq; destructuring it as a map would
   silently bind every key to nil (a seq is not a map) — a footgun, not a
   feature, so refuse loudly like the genesis Elixir compiler did."
  [rest-form]
  (when (= :map (rn/node-tag (rn/node-form rest-form)))
    (erlang/error
      (RuntimeError/exception "& rest pattern cannot be a map: the rest is a positional seq; use a vector pattern (& [a b]) or destructure the map as a fixed param"))))

(defn- bind-param
  "Bind one parameter form to a fresh Elixir variable.

   A plain-name parameter binds that name directly and adds no body prelude.
   A destructuring parameter binds a fresh `whole` variable as the actual
   parameter and returns the steps that take it apart (to run at the top of
   the body). Returns {:param var :steps steps :env env}."
  [pform env]
  (if (symbol-pattern? pform)
    (let [name (rn/node-name (rn/node-form pform))
          var (fresh-var name)]
      {:param var :steps (list) :env (put-local env name var)})
    (let [whole-var (fresh-var "whole")
          r (destructure-steps pform (a/var whole-var) env)]
      {:param whole-var :steps (:steps r) :env (:env r)})))

(defn- clause-shape
  "The dispatch shape of a parameter list: [:fixed n] for `n` plain params, or
   [:variadic n] for `n` fixed params followed by an `& rest`. Two clauses with
   the same shape are dispatched together."
  [param-forms]
  (let [sv (split-variadic param-forms)]
    (if (nil? (second sv))
      (list :fixed (count (first sv)))
      (list :variadic (count (first sv))))))

(defn- compile-fn-clause
  "Compile one fn clause (its parameters, body, and self/name environment) into
   an inner `params -> body` Elixir clause node, plus its shape.

   Each parameter becomes an Elixir variable (destructuring ones prefix the
   body with match statements); a trailing `& rest` becomes one more ordinary
   parameter bound to the collected rest list. The body runs in tail position
   with the given recur target. Returns {:shape shape :clause ->node}."
  [param-forms guard body self fn-name nil-rest? base-env]
  (let [sv (split-variadic param-forms)
        fixed-forms (first sv)
        rest-form (second sv)
        ; bind fixed parameters left to right, collecting body-prelude steps
        fixed-built (reduce (fn [acc pform]
                              (let [b (bind-param pform (:env acc))]
                                {:params (cons (:param b) (:params acc))
                                 :steps (concat (:steps acc) (:steps b))
                                 :env (:env b)}))
                            {:params (list) :steps (list) :env base-env}
                            fixed-forms)
        ; a rest parameter is one more Elixir parameter (the collected list).
        ; For a macro (nil-rest?), an empty rest is normalized to nil rather
        ; than `[]`, so the actual parameter is a raw var and a body prelude
        ; binds the rest name to `if raw == [] then nil else raw`.
        rest-built
          (cond
            (nil? rest-form) fixed-built
            (and nil-rest? (symbol-pattern? rest-form))
              (let [rname (rn/node-name (rn/node-form rest-form))
                    raw (fresh-var "rest")
                    rest-var (fresh-var rname)
                    norm (a/iff (a/remote mod-erlang :== (list (a/var raw) a/enil))
                                (a/lit nil)
                                (a/var raw))]
                {:params (cons raw (:params fixed-built))
                 :steps (concat (:steps fixed-built) (list (list rest-var norm)))
                 :env (put-local (:env fixed-built) rname rest-var)})
            ; a COMPOSITE rest pattern `[& [a b :as all]]`: the trailing args
            ; arrive as the actual parameter `raw`. Clojure binds an EXHAUSTED
            ; rest to nil, not `()`, and its variadic recursion relies on the
            ; base case seeing nil (an empty list is truthy, so `(when more …)`
            ; would loop forever). So normalize `raw == [] -> nil` FIRST, then
            ; destructure the pattern against that normalized value — every name
            ; (and an `:as`) binds nil when the rest is exhausted. This mirrors
            ; the genesis `compile_clause` pattern branch.
            (not (symbol-pattern? rest-form))
              (let [raw (fresh-var "rest")
                    rest-var (fresh-var "rest")
                    norm (a/iff (a/remote mod-erlang :== (list (a/var raw) a/enil))
                                (a/lit nil)
                                (a/var raw))
                    _ (check-rest-pattern! rest-form)
                    r (destructure-steps rest-form (a/var rest-var) (:env fixed-built))]
                {:params (cons raw (:params fixed-built))
                 :steps (concat (:steps fixed-built)
                                (cons (list rest-var norm) (:steps r)))
                 :env (:env r)})
            :else
              (let [b (bind-param rest-form (:env fixed-built))]
                {:params (cons (:param b) (:params fixed-built))
                 :steps (concat (:steps fixed-built) (:steps b))
                 :env (:env b)}))
        params (reverse (:params rest-built))
        prelude-steps (:steps rest-built)
        arity (count params)
        ; a named fn binds its own name to self.(self) inside the body
        named-env (if (nil? fn-name)
                    (:env rest-built)
                    (let [self-app (a/app (a/var self) (list (a/var self)))]
                      (put-local (:env rest-built) fn-name self-app)))
        body-env (assoc named-env :recur {:self self :arity arity} :tail true)
        body-node (compile-body body body-env)
        full-body (if (empty? prelude-steps)
                    body-node
                    (nest-lets prelude-steps body-node))
        ; a :when guard is compiled in the restricted guard dialect against the
        ; head's variables; a guard reads only the head's parameter variables
        ; (guardable-env), so a destructured or unbound name in the guard is
        ; refused rather than leaking an undefined variable.
        guard-node (if (nil? guard) nil
                     (compile-guard guard (guardable-env body-env params)))]
    {:shape (clause-shape param-forms)
     :clause (a/clause (apply list (map (fn [p] (a/pvar p)) params)) guard-node full-body)}))

(defn- split-when
  "Split a clause's forms into [guard body] at a leading `:when`.

   `(:when g rest...)` -> [g (rest...)]; forms with no `:when` -> [nil forms].
   The guard is the test that must hold before the body runs. A DANGLING
   `:when` — one with no guard expression after it — is refused here (rather
   than silently read as a body form) so `(defn f [x] :when)` is a clear
   compile error, not a mysterious runtime one. `env` carries the source
   position for that error."
  [forms env]
  (if (and (not (empty? forms))
           (= :keyword (rn/node-tag (rn/node-form (first forms))))
           (= "when" (rn/node-name (rn/node-form (first forms)))))
    (if (empty? (rest forms))
      (compile-error env "`:when` must be followed by a guard expression")
      (list (second forms) (rest (rest forms))))
    (list nil forms)))

(defn- parse-fn-clauses
  "Pull the clauses out of a (fn ...) form's arguments.

   Two shapes: a single clause written inline `(fn [params] body...)`, or
   several clauses each wrapped in parentheses
   `(fn ([params] :when guard body...) ([params] body...))`. A clause may
   carry a `:when` guard between its parameters and its body. Returns a list
   of {:params param-forms :guard guard-or-nil :body body-forms}. A guarded
   clause with a guard but NO body after it is refused, so
   `(defn f [x] :when (int? x))` is a clear compile error. `env` carries the
   source position for these errors."
  [args env]
  (let [first-arg (rn/node-form (first args))
        check-body (fn [guard body]
                     (when (and (some? guard) (empty? body)) (compile-error env "a guarded clause needs a body after its `:when` guard")))]
    (if (= :vector (rn/node-tag first-arg))
      ; single inline clause
      (let [gb (split-when (rest args) env)]
        (check-body (first gb) (second gb))
        (list {:params (rn/node-items first-arg) :guard (first gb) :body (second gb)}))
      ; several parenthesised clauses
      (map (fn [clause]
             (let [items (rn/node-items (rn/node-form clause))
                   gb (split-when (rest items) env)]
               (check-body (first gb) (second gb))
               {:params (rn/node-items (rn/node-form (first items)))
                :guard (first gb) :body (second gb)}))
           args))))

(defn- assemble-fn
  "Assemble compiled clauses into a function value.

   A single fixed-arity clause is just its own self-applied function. Anything
   with more than one arity, or a variadic clause, becomes a `$blfn` tagged
   tuple: `{:\"$blfn\", %{arity => fn}, variadic-or-nil}`, which the runtime
   dispatches on by argument count. Clauses of the same shape are grouped into
   one function with several `->` heads. `self-map` gives the shared self
   variable for each shape (all clauses of a shape recur into the same one)."
  [compiled self-map]
  (let [; group clause -> nodes by shape
        by-shape (reduce (fn [m c]
                           (assoc m (:shape c)
                                    (concat (get m (:shape c) (list)) (list (:clause c)))))
                         {} compiled)
        shapes (distinct (map (fn [c] (:shape c)) compiled))]
    (if (and (= 1 (count shapes))
             (= :fixed (first (first shapes))))
      ; one fixed arity: a bare self-applied fn
      (self-apply (get self-map (first shapes))
                  (a/fnn (apply list (get by-shape (first shapes)))))
      ; multiple arities and/or a variadic: a $blfn dispatch tuple
      (let [fixed-entries
            (apply list
              (map (fn [shape]
                     [(a/lit (second shape))
                      (self-apply (get self-map shape)
                                  (a/fnn (apply list (get by-shape shape))))])
                   (filter (fn [s] (= :fixed (first s))) shapes)))
            variadic-shape (first (filter (fn [s] (= :variadic (first s))) shapes))
            ; the variadic slot is the tuple {min, fn}
            variadic-node (if (nil? variadic-shape)
                            (a/lit nil)
                            (a/tup (list (a/lit (second variadic-shape))
                                         (self-apply (get self-map variadic-shape)
                                                     (a/fnn (apply list (get by-shape variadic-shape)))))))]
        ; the whole value is the tuple {:"$blfn", %{...}, variadic}
        (a/tup (list (a/lit (erlang/binary_to_atom "$blfn"))
                     (a/mapp fixed-entries)
                     variadic-node))))))

(defn- compile-fn
  "Turn a (fn ...) form into a function value.

   Handles all shapes: `(fn [params] body)`, the named `(fn name [params]
   body)`, multi-clause `(fn ([a] ...) ([a b] ...))`, and variadic
   `(fn [a & rest] ...)`. Each distinct arity gets its own inner function; a
   function with more than one arity (or a variadic clause) becomes a `$blfn`
   dispatch tuple the runtime selects on by argument count."
  [args env]
  (compile-fn* args false env))

(defn- compile-fn*
  "The general fn compiler, with an explicit `nil-rest?` flag.

   `nil-rest?` is true only for macro functions, whose trailing `& rest` binds
   to nil (not `[]`) when there are no extra arguments. Ordinary fns keep the
   Clojure `()` empty rest."
  [args nil-rest? env]
  (let [first-arg (rn/node-form (first args))
        fn-name (when (= :symbol (rn/node-tag first-arg)) (rn/node-name first-arg))
        clause-args (if (nil? fn-name) args (rest args))
        clauses (parse-fn-clauses clause-args env)
        ; one shared self variable per distinct shape (all clauses of a shape
        ; recur into the same dispatcher)
        shapes (distinct (map (fn [c] (clause-shape (:params c))) clauses))
        self-map (reduce (fn [m s] (assoc m s (fresh-var "fnself"))) {} shapes)
        compiled (apply list
                   (map (fn [c]
                          (compile-fn-clause (:params c) (:guard c) (:body c)
                                             (get self-map (clause-shape (:params c)))
                                             fn-name nil-rest? env))
                        clauses))]
    (assemble-fn compiled self-map)))

; ---- syntax-quote (backtick, ~, ~@, x#) --------------------------------------
;
; A syntax-quote (written with a backtick) is a TEMPLATE for building a form.
; Most of it is data to reproduce as-is, but ~x (unquote) splices in the value
; of x, ~@xs (unquote-splicing) splices in each element of xs, and x# (auto-
; gensym) becomes a fresh unique name, stable within one template. Plain
; symbols resolve in the namespace that WROTE the template and are emitted
; qualified, so a macro can name its own helpers.
;
; `synq` builds the Elixir tree that CONSTRUCTS the templated form at run time,
; threading a gensym map g so repeated x# share one generated name.

(declare synq)

(defn- cons-cell
  "A cons node `[head | tail]` — the list-construction building block."
  [head tail]
  (a/cons-cell head tail))

(defn- gensym-hash?
  "Say whether a template symbol name ends in # (and is longer than one char),
   the auto-gensym marker x#."
  [name]
  (and (> (count name) 1)
       (= "#" (subs name (dec (count name)) (count name)))))

(defn- resolve-gensym
  "Resolve an auto-gensym name x# to a stable generated name within a template.
   Returns [resolved-name new-gensym-map]. A non-gensym name is unchanged. The
   same x# twice yields the same name."
  [name g]
  (if (gensym-hash? name)
    (if (contains? g name)
      (list (get g name) g)
      (let [base (subs name 0 (dec (count name)))
            gen (str base "__" (next-fresh!) "__auto")]
        (list gen (assoc g name gen))))
    (list name g)))

(defn- owner-ns
  "The namespace a var visible from ns actually lives in: ns itself when it is
   defined there, otherwise the namespace that referred it in."
  [ns name]
  (if (BeamLisp.Env/local_var? ns name)
    ns
    (or (BeamLisp.Env/refer_source ns name) ns)))

(defn- qualify-synq
  "Resolve a plain template symbol to the name it should expand to. A name with
   a slash, an auto-gensym, a special form, a template local, or a macro stays
   bare. A var the writing namespace defines or refers is qualified with the
   namespace that OWNS it. Anything else stays bare."
  [name env]
  (cond
    (has-slash? name) name
    (and (> (count name) 6)
         (= "__auto" (subs name (- (count name) 6) (count name)))) name
    (and (> (count name) 3)
         (= "__c" (subs name (- (count name) 3) (count name)))) name
    (contains? special-forms name) name
    (local? env name) name
    (macro? env name) name
    :else
      (let [ns (:ns env)
            ; `peek`: resolving a syntax-quote name at COMPILE time must not
            ; materialize a `^:per-env` value — only test whether it binds.
            r (BeamLisp.Env/peek ns name)]
        (if (and (erlang/is_tuple r) (= :ok (erlang/element 1 r)))
          (str (owner-ns ns name) "/" name)
          name))))

(defn- unquote-form?
  "Say whether a form is (unquote x), a ~x splice point."
  [form]
  (let [f (rn/node-form form)]
    (and (= :list (rn/node-tag f))
         (let [items (rn/node-items f)]
           (and (not (empty? items))
                (= :symbol (rn/node-tag (rn/node-form (first items))))
                (= "unquote" (rn/node-name (rn/node-form (first items)))))))))

(defn- splice-form?
  "Say whether a form is (unquote-splicing x), a ~@x splice point."
  [form]
  (let [f (rn/node-form form)]
    (and (= :list (rn/node-tag f))
         (let [items (rn/node-items f)]
           (and (not (empty? items))
                (= :symbol (rn/node-tag (rn/node-form (first items))))
                (= "unquote-splicing" (rn/node-name (rn/node-form (first items)))))))))

(defn- synq-list
  "Build the constructor for a template list's items, right to left. Each
   ordinary item is consed onto the growing tail; a ~@xs item splices its whole
   sequence with BeamLisp.RT.splice. Returns [node new-gensym-map]."
  [items env g]
  (reduce (fn [acc item]
            (let [built-node (first acc)
                  gacc (second acc)]
              (if (splice-form? item)
                (let [x (second (rn/node-items (rn/node-form item)))]
                  (list (a/remote mod-rt :splice
                                  (list (compile-node x (notail env)) built-node))
                        gacc))
                (let [r (synq item env gacc)]
                  (list (cons-cell (first r) built-node) (second r))))))
          (list a/enil g)
          (reverse items)))

(defn- nested-synq-form?
  "Say whether a template form is itself a `(syntax-quote inner)` — a backtick
   nested inside the enclosing backtick."
  [form]
  (let [f (rn/node-form form)]
    (and (= :list (rn/node-tag f))
         (let [items (rn/node-items f)]
           (and (not (empty? items))
                (= :symbol (rn/node-tag (rn/node-form (first items))))
                (= "syntax-quote" (rn/node-name (rn/node-form (first items)))))))))

(defn- synq
  "Build the bl-ANF node that constructs one templated form at run time.
   Returns [node new-gensym-map]."
  [form env g]
  (let [f (rn/node-form form)
        tag (rn/node-tag f)]
    (cond
      (unquote-form? form)
        (list (compile-node (second (rn/node-items f)) (notail env)) g)
      ; a bare ~@x outside any list/vector template: refused (splicing makes
      ; sense only as a list item — synq-list's splice-form? branch). The
      ; genesis Elixir compiler raised this; the port dropped it.
      (splice-form? form)
        (erlang/error
          (RuntimeError/exception "~@ is only valid inside a syntax-quoted list or vector"))
      ; a NESTED syntax-quote gets its OWN fresh gensym map: its `x#` symbols
      ; must be independent of the enclosing template's, so two sibling nested
      ; backticks each holding `x#` produce DIFFERENT generated names. The
      ; enclosing map `g` is threaded on unchanged. Mirrors the genesis
      ; nested-`syntax-quote` clause in synq_data.
      (nested-synq-form? form)
        (let [inner (second (rn/node-items f))
              inner-r (synq inner env {})
              inner-node (first inner-r)
              sq-sym (a/lit (rn/->tuple (list :symbol "syntax-quote")))]
          (list (cons-cell sq-sym (cons-cell inner-node a/enil)) g))
      (= tag :list)
        (synq-list (rn/node-items f) env g)
      (= tag :vector)
        (let [r (synq-list (rn/node-items f) env g)]
          (list (a/remote mod-vector :new (list (first r))) (second r)))
      (= tag :map)
        (let [built (reduce (fn [acc pair]
                              (let [k (kv-key pair) v (kv-val pair)
                                    rk (synq k env (second acc))
                                    rv (synq v env (second rk))]
                                (list (cons [(first rk) (first rv)]
                                            (first acc))
                                      (second rv))))
                            (list (list) g)
                            (rn/node-items f))]
          (list (a/mapp (apply list (reverse (first built)))) (second built)))
      (= tag :symbol)
        (let [rg (resolve-gensym (rn/node-name f) g)
              resolved (first rg)
              g2 (second rg)]
          (list (a/lit (rn/->tuple (list :symbol (qualify-synq resolved env)))) g2))
      (= tag :keyword)
        (list (a/lit (erlang/binary_to_atom (rn/node-name f))) g)
      :else (list (a/lit f) g))))

(defn- compile-syntax-quote
  "Compile a (syntax-quote form) into the node that builds the templated form."
  [form env]
  (first (synq form env {})))

; ---- def and defn (var linking) ----------------------------------------------

;
; `(def x value)` records a namespace variable. `(defn name [params] body)`
; records a FUNCTION variable, but not as a closure — it emits real Elixir
; `def name(params), do: body` clauses into a per-namespace module, so a call
; to it is a direct BEAM function call (fast), and a self-call recurs by name
; (tail-call-optimized). `BeamLisp.Link.defvar` installs those clauses and
; regenerates the namespace module; the compiler's job is to build the clause
; data it takes.

; ---- dispatch and objects ----------------------------------------------------
;
; Multimethods, protocols, records, and types. These mostly hand work to
; runtime modules (BeamLisp.Multi for dispatch, BeamLisp.Record for structs):
; the compiler builds the DECLARATION, the runtime does the installation. That
; keeps the compiler small and the object system's behavior in one place.

(defn- multi-var-target
  "Resolve a protocol/multimethod name to the [ns name] where it lives.

   A bare name resolves to the namespace that defines or referred it; a
   qualified `alias/name` resolves through the alias. This is how
   `(extend-type T Proto ...)` finds the protocol var even when it was referred
   in from another namespace."
  [env name]
  (if (has-slash? name)
    (let [[prefix var] (split-slash name)
          target (or (BeamLisp.Env/alias_target (:ns env) prefix)
                     (if (= "clojure.core" prefix) "core" prefix))]
      (list target var))
    (if (BeamLisp.Env/local_var? (:ns env) name)
      (list (:ns env) name)
      (list (or (BeamLisp.Env/refer_source (:ns env) name) (:ns env)) name))))

(defn- type-tag
  "The dispatch tag for a type in an `extend-type`/`defrecord` protocol block.

   A keyword tag (`:circle`) is its atom. A symbol naming a record or deftype
   module resolves to that module; any other symbol becomes a plain type tag
   (its atom)."
  [form env]
  (let [f (rn/node-form form)]
    (cond
      (= :keyword (rn/node-tag f)) (erlang/binary_to_atom (rn/node-name f))
      (= :symbol (rn/node-tag f))
        (let [name (rn/node-name f)
              ; `peek`: resolving a type-tag symbol at COMPILE time must not
              ; materialize a per-env value. A descriptor is not an atom module.
              r (BeamLisp.Env/peek (:ns env) name)]
          (if (and (erlang/is_tuple r) (= :ok (erlang/element 1 r))
                   (erlang/is_atom (erlang/element 2 r))
                   (or (BeamLisp.Record/record_module? (erlang/element 2 r))
                       (BeamLisp.Record/deftype_module? (erlang/element 2 r))))
            (erlang/element 2 r)
            (erlang/binary_to_atom name)))
      :else (compile-error env "expected a type tag (keyword) or struct module"))))

(defn- protocol-impl
  "Compile one `(method-name [args] body...)` implementation into a
   {method-name-string, fn-ast} tuple for a protocol's method map."
  [form env]
  (let [f (rn/node-form form)
        items (rn/node-items f)
        m (rn/node-name (rn/node-form (first items)))]
    (erlang/list_to_tuple
      (list m (compile-fn (apply list (parse-fn-clauses-as-args (rest items))) env)))))

(defn- protocol-impl-pair
  "protocol-impl's result as an a/mapp pair: [(a/lit name) fn-node]."
  [form env]
  (let [p (protocol-impl form env)]
    [(a/lit (first (erlang/tuple_to_list p)))
   (second (erlang/tuple_to_list p))]))

(defn- impls-map
  "The method-implementations map node for a group of (name [args] body) forms."
  [method-forms env]
  (a/mapp (apply list (map (fn [mf] (protocol-impl-pair mf env)) method-forms))))

(defn- parse-fn-clauses-as-args
  "Wrap a method body (a single `[params] body...` clause) as the argument list
   the fn compiler expects."
  [clause-items]
  clause-items)

(defn- with-doc-meta
  "Wrap a definition's AST so a leading docstring is written as var metadata
   AFTER the definition runs, mirroring `compile-defn*`:
   `value = <define>; Env.put_meta(ns, name, %{doc: …}); value`.

   `doc` nil (no docstring) returns the bare define-AST unchanged — a var with
   no metadata stays metadata-free, exactly as genesis does for a plain
   defprotocol/defmulti. This is what makes a protocol/multimethod docstring
   retrievable via the same `Env.meta`/doc resolution as a `defn` docstring."
  [define-node doc ns name]
  (if (nil? doc)
    define-node
    (a/lett "value" define-node
            (a/doo (list (a/remote mod-env :put_meta
                                   (list (a/lit ns) (a/lit name)
                                         (a/mapp (list (list (a/lit :doc) (a/lit doc))))))
                         (a/var "value"))))))

(defn- compile-defmulti
  "Compile (defmulti name dispatch-fn) — or (defmulti name docstring dispatch-fn)
   — into a Multi.define_multi call, storing a leading docstring as var metadata.

   `more` is everything after the name: either `(dispatch)` or
   `(docstring dispatch)`. A leading string is the docstring (Clojure allows a
   docstring between the multimethod name and its dispatch fn); it is peeled
   off, the dispatch fn is compiled, and the docstring is recorded via
   `with-doc-meta`."
  [name-form more env]
  (let [name (rn/node-name (rn/node-form name-form))
        has-doc (and (> (count more) 1)
                     (erlang/is_binary (rn/node-form (first more))))
        doc (when has-doc (rn/node-form (first more)))
        dispatch (if has-doc (second more) (first more))
        define-node (a/remote mod-multi :define_multi
                              (list (a/lit (:ns env)) (a/lit name)
                                    (compile-node dispatch (notail env))))]
    (with-doc-meta define-node doc (:ns env) name)))

(defn- compile-defmethod
  "Compile (defmethod name dispatch-val [params] body...) into a
   Multi.add_method call. The method body is compiled as an ordinary fn."
  [name-form dispatch-val rest-forms env]
  (let [name (rn/node-name (rn/node-form name-form))
        tgt (multi-var-target env name)]
    (a/remote mod-multi :add_method
              (list (a/lit (first tgt)) (a/lit (second tgt))
                    (compile-node dispatch-val (notail env))
                    (compile-fn (apply list rest-forms) env)))))

(defn- compile-defprotocol
  "Compile (defprotocol Name (method [args])...) into a Multi.define_protocol
   call listing the method names."
  [name-form method-forms env]
  (let [name (rn/node-name (rn/node-form name-form))
        ; a leading string between the name and the first method is a
        ; docstring: capture it, drop it from the method list, and store it as
        ; var metadata so `(doc Proto)` / `Env.meta` resolve it like a defn.
        has-doc (and (not (empty? method-forms))
                     (erlang/is_binary (rn/node-form (first method-forms))))
        doc (when has-doc (rn/node-form (first method-forms)))
        methods (if has-doc (rest method-forms) method-forms)
        method-names (apply list
                       (map (fn [mf]
                              (rn/node-name (rn/node-form (first (rn/node-items (rn/node-form mf))))))
                            methods))
        define-node (a/remote mod-multi :define_protocol
                              (list (a/lit (:ns env)) (a/lit name) (a/lit method-names)))]
    (with-doc-meta define-node doc (:ns env) name)))

(defn- compile-extend-type
  "Compile (extend-type Type Protocol (method [args] body)...) into a
   Multi.extend_type call installing the method map for the type's tag."
  [type-form protocol-form method-forms env]
  (let [protocol (rn/node-name (rn/node-form protocol-form))
        tgt (multi-var-target env protocol)
        tag (type-tag type-form env)
        impls (impls-map method-forms env)]
    (a/remote mod-multi :extend_type
              (list (a/lit (first tgt)) (a/lit (second tgt)) (a/lit tag) impls))))

(defn- compile-satisfies?
  "Compile (satisfies? Protocol value) into a Multi.satisfies? call."
  [protocol-form value-form env]
  (let [tgt (multi-var-target env (rn/node-name (rn/node-form protocol-form)))]
    (a/remote mod-multi :satisfies?
              (list (a/lit (first tgt)) (a/lit (second tgt))
                    (compile-node value-form (notail env))))))

(defn- compile-extend-protocol
  "Compile (extend-protocol Protocol Type (method...)... Type2 (method...)...)
   into one Multi.extend_type call per type.

   The forms after the protocol alternate a TYPE (a keyword or symbol) and its
   method implementations (lists). Types are collected with the methods that
   follow each, and each group becomes an extend_type call."
  [protocol-form forms env]
  (let [protocol (rn/node-name (rn/node-form protocol-form))
        tgt (multi-var-target env protocol)
        ; walk the forms, grouping each type with the method-lists after it
        grouped (reduce (fn [acc mf]
                          (let [f (rn/node-form mf)]
                            (if (= :list (rn/node-tag f))
                              ; a method form: add to the current group
                              {:groups (:groups acc)
                               :type (:type acc)
                               :methods (concat (:methods acc) (list mf))}
                              ; a type form: close the previous group, start new
                              {:groups (if (nil? (:type acc))
                                         (:groups acc)
                                         (concat (:groups acc)
                                                 (list (list (:type acc) (:methods acc)))))
                               :type mf
                               :methods (list)})))
                        {:groups (list) :type nil :methods (list)}
                        forms)
        all-groups (if (nil? (:type grouped))
                     (:groups grouped)
                     (concat (:groups grouped)
                             (list (list (:type grouped) (:methods grouped)))))
        calls (apply list
                (map (fn [grp]
                       (let [type-form (first grp)
                             method-forms (second grp)
                             tag (type-tag type-form env)
                             impls (impls-map method-forms env)]
                         (a/remote mod-multi :extend_type
                                   (list (a/lit (first tgt)) (a/lit (second tgt))
                                         (a/lit tag) impls))))
                     all-groups))]
    ; a single call is itself; several become a do block
    (if (= 1 (count calls))
      (first calls)
      (a/doo calls))))

(defn- group-proto-forms
  "Group protocol/method forms: each protocol symbol followed by its method
   lists. Returns a list of [protocol-form method-forms].

   Shared by reify (protocol Proto (m [args]...)...) and the extend-protocol
   grouping: a list is a method, anything else starts a new protocol group."
  [forms]
  (let [grouped (reduce (fn [acc mf]
                          (let [f (rn/node-form mf)]
                            (if (= :list (rn/node-tag f))
                              {:groups (:groups acc) :type (:type acc)
                               :methods (concat (:methods acc) (list mf))}
                              {:groups (if (nil? (:type acc)) (:groups acc)
                                         (concat (:groups acc) (list (list (:type acc) (:methods acc)))))
                               :type mf :methods (list)})))
                        {:groups (list) :type nil :methods (list)}
                        forms)]
    (if (nil? (:type grouped))
      (:groups grouped)
      (concat (:groups grouped) (list (list (:type grouped) (:methods grouped)))))))

(defn- compile-defnative
  "Compile (defnative \"crate\" (fn-name arity)...) into a Native.declare call.

   Declares that a set of functions in the current namespace are implemented by
   a native (Rust NIF) crate. The declaration lives in beam-lisp; the crate is
   the substrate. `signatures` is a list of {name, arity} tuples."
  [crate-form sig-forms env]
  ; a NIF is arbitrary host code entering the VM; INSTALLING one is a capability
  ; a restricted env must not hold. Only `:global`-capability code (caps = :all)
  ; may declare native functions — matching the genesis defnative gate. The
  ; host-side `Native.declare` stays callable from Elixir; this gate is the
  ; beam-lisp language path.
  (when-not (= (BeamLisp.Env/caps) :all) (compile-error env
      (str "defnative is not available in a capability-restricted environment: "
           "a NIF is substrate, and only `:global`-capability code installs substrate")))
  (let [crate (rn/node-form crate-form)
        signatures (apply list
                     (map (fn [sf]
                            ; each signature must be (fn-name arity) — a
                            ; two-element list with a symbol name and an
                            ; integer arity. Anything else is a malformed
                            ; declaration; refuse it loudly instead of
                            ; crashing deep inside node accessors (genesis
                            ; raised this; the port dropped it).
                            (let [sf-form (rn/node-form sf)]
                              (if (and (= :list (rn/node-tag sf-form))
                                       (erlang/=:= 2 (count (rn/node-items sf-form)))
                                       (= :symbol (rn/node-tag (rn/node-form (first (rn/node-items sf-form)))))
                                       (erlang/is_integer (rn/node-form (second (rn/node-items sf-form)))))
                                (erlang/list_to_tuple
                                  (list (rn/node-name (rn/node-form (first (rn/node-items sf-form))))
                                        (rn/node-form (second (rn/node-items sf-form)))))
                                (erlang/error
                                  (RuntimeError/exception
                                    (str "defnative: expected (fn-name arity), got "
                                         (pr-str (rn/form sf))))))))
                          sig-forms))]
    (a/remote mod-native :declare
              (list (a/lit (:ns env)) (a/lit crate) (a/lit signatures)))))

(defn- compile-reify
  "Compile (reify Protocol (method [args] body)... ) into an anonymous object.

   Makes a fresh unique tag with `make_ref()`, extends each named protocol for
   that tag with its method implementations, and returns the tagged object
   `{:bl_reify, tag, {}}` — a value that satisfies those protocols without a
   named type."
  [forms env]
  (let [groups (group-proto-forms forms)
        tag-var "tag"
        extends (map (fn [grp]
                       (let [proto (rn/node-name (rn/node-form (first grp)))
                             tgt (multi-var-target env proto)
                             method-forms (second grp)
                             impls (impls-map method-forms env)]
                         (a/remote mod-multi :extend_type
                                   (list (a/lit (first tgt)) (a/lit (second tgt))
                                         (a/var tag-var) impls))))
                     groups)
        ; the reified value: {:bl_reify, tag, {}}
        reified (a/tup (list (a/lit :bl_reify) (a/var tag-var) (a/tup (list))))]
    ; tag = make_ref(); extends...; reified
    (a/lett tag-var (a/remote mod-erlang :make_ref (list))
            (a/doo (apply list (concat extends (list reified)))))))

(defn- record-field-names
  "The field names of a record/deftype field vector, as strings."
  [fields-form]
  (apply list (map (fn [it] (rn/node-name (rn/node-form it)))
                   (rn/node-items (rn/node-form fields-form)))))

(defn- record-protocol-extends
  "Compile a record's inline protocol blocks into `Multi.extend_type` calls.

   In `(defrecord Rect [w h] Shape (area [s] ...) (perim [s] ...))` the trailing
   forms are a FLAT list that alternates a protocol NAME (a bare symbol) with
   the method implementations that follow it (each a `(name [args] body)`
   list), and a record may implement several protocols in a row. This groups
   the forms — every bare symbol starts a new protocol group, every list is a
   method of the group in progress — then emits one
   `BeamLisp.Multi.extend_type(pns, pname, mod, impls)` per protocol, where the
   dispatch tag is the record's own module `mod-var`. Mirrors the standalone
   `extend-type`, so a record implements a protocol exactly as an external
   `(extend-type Rect Shape ...)` would.

   `proto-forms` is the trailing form list; `mod-var` is the record module
   variable; `env` is the compile environment."
  [proto-forms mod-var env]
  ; fold the flat list into groups: [[proto-form (method-form ...)] ...]
  (let [grouped (reduce
                  (fn [acc pf]
                    (let [f (rn/node-form pf)]
                      (if (= :list (rn/node-tag f))
                        ; a method list: append to the group in progress (the last one)
                        (if (empty? acc)
                          acc  ; a leading method with no protocol — ignore (malformed)
                          (let [last-group (last acc)
                                init-groups (into [] (take (dec (count acc)) acc))]
                            (conj init-groups
                                  (list (first last-group)
                                        (concat (second last-group) (list pf))))))
                        ; a protocol name: start a new group
                        (conj (into [] acc) (list pf (list))))))
                  [] proto-forms)]
    (map (fn [group]
           (let [proto-form (first group)
                 method-forms (second group)
                 protocol (rn/node-name (rn/node-form proto-form))
                 tgt (multi-var-target env protocol)
                 impls (impls-map method-forms env)]
             (a/remote mod-multi :extend_type
                       (list (a/lit (first tgt)) (a/lit (second tgt))
                             (a/var mod-var) impls))))
         grouped)))

(defn- compile-defrecord
  "Compile (defrecord Name [fields...] & protocols) into the block that defines
   a struct-backed type, interns its constructors, and installs any inline
   protocol implementations.

   Emits: a `mod = Record.define(ns, Name, fields)` binding, then interns of
   `Name` (the module), `->Name` (positional constructor), and `map->Name`
   (map constructor for a record). Any trailing protocol blocks
   (`Shape (area [s] ...)`) become `Multi.extend_type` calls via
   `record-protocol-extends`, so a record can implement protocols inline just
   like a standalone `extend-type`."
  [name-form fields-form proto-forms kind env]
  (let [name (rn/node-name (rn/node-form name-form))
        fields (record-field-names fields-form)
        ; a FIXED variable named `mod` (not gensym'd), matching the existing
        ; compiler — there is only one per record definition, so no collision
        mod-var "mod"
        define-fn (if (= kind :record) :define :define_type)
        define-node (a/remote mod-record define-fn
                              (list (a/lit (:ns env)) (a/lit name) (a/lit fields)))
        base (list
               ; intern Name -> mod
               (a/remote mod-env :intern (list (a/lit (:ns env)) (a/lit name) (a/var mod-var)))
               ; intern ->Name -> positional constructor
               (a/remote mod-env :intern
                         (list (a/lit (:ns env)) (a/lit (str "->" name))
                               (a/remote mod-record :positional_ctor (list (a/var mod-var))))))
        ; the map-constructor slot: a record interns `map->Name`; a deftype has none
        map-ctor-stmts (if (= kind :record)
                         (list (a/remote mod-env :intern
                                 (list (a/lit (:ns env)) (a/lit (str "map->" name))
                                       (a/remote mod-record :map_ctor (list (a/var mod-var))))))
                         (list))
        ; the inline protocol extends, in source order, each a Multi.extend_type
        extend-nodes (record-protocol-extends (or proto-forms (list)) mod-var env)
        stmts (apply list (concat base map-ctor-stmts extend-nodes (list (a/var mod-var))))]
    (a/lett mod-var define-node (a/doo stmts))))

; ---- defserver (real gen_server) ---------------------------------------------
;
; (defserver name (init [arg] body) (handle-call PAT [from state] body) ...)
(defn- server-body
  "Compile a callback body with OTP return constructors bound as locals."
  [forms env]
  (let [ctors (BeamLisp.Server/return_constructors)
        ret-env (reduce (fn [e cname]
                          (put-local e cname
                                     (a/remote (erlang/binary_to_atom "Elixir.Map") :fetch!
                                               (list (a/remote mod-server :return_constructors (list))
                                                     (a/lit cname)))))
                        env (maps/keys ctors))]
    (compile-body forms ret-env)))

(defn- server-defn-clause [fname params guard body]
  {:op :defn-clause :fname fname
   :params (apply list (map (fn [p] {:pop :pvar :name p}) params))
   :guard guard :body body :ann {}})

(defn- server-clause-defs
  "Compile one callback clause directly to canonical :defn-clause maps."
  [clause fname shape env]
  (let [items (rn/node-items (rn/node-form clause)) rest-forms (rest items)]
    (if (= shape :vector)
      (let [params (rn/node-items (rn/node-form (first rest-forms))) body (rest rest-forms)
            built (reduce (fn [acc pform]
                            (let [b (bind-param pform (:env acc))]
                              {:params (cons (:param b) (:params acc))
                               :steps (concat (:steps acc) (:steps b)) :env (:env b)}))
                          {:params (list) :steps (list) :env env} params)
            head-vars (reverse (:params built)) init? (= fname :init)
            conveyed-var (fresh-var "bl_init_arg")
            inner-body (nest-lets (:steps built) (server-body body (:env built)))
            with-unwrap (cond
                          (not init?) inner-body
                          (empty? head-vars) (a/doo (list (a/remote mod-server :bind_init (list (a/var conveyed-var))) inner-body))
                          :else (a/lett (first head-vars) (a/remote mod-server :bind_init (list (a/var conveyed-var))) inner-body))
            def-head-vars (if init? (list conveyed-var) head-vars)]
        (list (server-defn-clause fname def-head-vars nil with-unwrap)))
      (let [pat-form (first rest-forms) after-pat (rest rest-forms)
            gb (split-when after-pat env) guard (first gb) rest2 (second gb)
            params-form (first rest2) body (rest rest2)
            pr (compile-pattern pat-form env) pats (first pr) msg-env (second pr)
            guard-node (if (nil? guard) nil (compile-guard guard msg-env))
            built (reduce (fn [acc pform]
                            (let [b (bind-param pform (:env acc))]
                              {:params (cons (:param b) (:params acc))
                               :steps (concat (:steps acc) (:steps b)) :env (:env b)}))
                          {:params (list) :steps (list) :env msg-env}
                          (rn/node-items (rn/node-form params-form)))
            head-vars (reverse (:params built))
            body-node (nest-lets (:steps built) (server-body body (:env built)))]
        (map (fn [pat]
               {:op :defn-clause :fname fname
                :params (cons pat (apply list (map (fn [p] {:pop :pvar :name p}) head-vars)))
                :guard guard-node :body body-node :ann {}}) pats)))))

(defn- server-client-defs [mod]
  (let [gs (erlang/binary_to_atom "Elixir.GenServer")
        remote (fn [m f xs] (a/remote m f (apply list (map a/var xs))))
        clause (fn [f ps body] (server-defn-clause f ps nil body))]
    (list
      (clause :start (list "init_arg") (a/remote mod-server :start (list (a/lit mod) (a/var "init_arg") a/enil)))
      (clause :start (list "init_arg" "opts") (a/remote mod-server :start (list (a/lit mod) (a/var "init_arg") (a/var "opts"))))
      (clause :start_link (list "init_arg") (a/remote mod-server :start_link (list (a/lit mod) (a/var "init_arg") a/enil)))
      (clause :start_link (list "init_arg" "opts") (a/remote mod-server :start_link (list (a/lit mod) (a/var "init_arg") (a/var "opts"))))
      (clause :call (list "server" "request") (a/remote gs :call (list (a/var "server") (a/var "request") (a/lit 5000))))
      (clause :call (list "server" "request" "timeout") (remote gs :call (list "server" "request" "timeout")))
      (clause :cast (list "server" "request") (remote gs :cast (list "server" "request")))
      (clause :stop (list "server") (a/remote gs :stop (list (a/var "server") (a/lit :normal) (a/lit :infinity))))
      (clause :stop (list "server" "reason") (a/remote gs :stop (list (a/var "server") (a/var "reason") (a/lit :infinity))))
      (clause :stop (list "server" "reason" "timeout") (remote gs :stop (list "server" "reason" "timeout"))))))

(defn- server-default-defs [cb]
  (let [clause (fn [f ps body] (server-defn-clause f ps nil body))]
    (cond
      (= cb :handle_call) (list (clause :handle_call (list "msg" "_from" "state") (a/tup (list (a/lit :stop) (a/tup (list (a/lit :bad_call) (a/var "msg"))) (a/var "state")))))
      (= cb :handle_cast) (list (clause :handle_cast (list "msg" "state") (a/tup (list (a/lit :stop) (a/tup (list (a/lit :bad_cast) (a/var "msg"))) (a/var "state")))))
      (= cb :handle_info) (list (clause :handle_info (list "_msg" "state") (a/tup (list (a/lit :noreply) (a/var "state")))))
      (= cb :terminate) (list (clause :terminate (list "_reason" "_state") (a/lit :ok)))
      (= cb :code_change) (list (clause :code_change (list "_old_vsn" "state" "_extra") (a/tup (list (a/lit :ok) (a/var "state")))))
      :else (list))))

(defn- compile-defserver
  "Compile defserver through the canonical ANF module descriptor path."
  [name-form clauses env]
  (let [name (rn/node-name (rn/node-form name-form)) mod (BeamLisp.Server/module_for (:ns env) name)
        parts (reduce (fn [acc clause]
                        (let [hd (rn/node-name (rn/node-form (first (rn/node-items (rn/node-form clause)))))]
                          (if (= hd "invariant") (assoc acc :inv (cons clause (:inv acc)))
                            (assoc acc :cbs (cons clause (:cbs acc))))))
                      {:inv (list) :cbs (list)} clauses)
        clause-defs (map (fn [clause]
                           (let [cb-name (rn/node-name (rn/node-form (first (rn/node-items (rn/node-form clause)))))
                                 cb (BeamLisp.Server/callback cb-name)]
                             (list (first (erlang/tuple_to_list cb))
                                   (server-clause-defs clause (first (erlang/tuple_to_list cb)) (nth (erlang/tuple_to_list cb) 2) env))))
                         (reverse (:cbs parts)))
        inv-defs (mapcat (fn [c] (server-clause-defs c :__invariant__ :vector env)) (reverse (:inv parts)))
        grouped (reduce (fn [m cd] (assoc m (first cd) (concat (get m (first cd) (list)) (second cd)))) {} clause-defs)
        ordered (mapcat (fn [cb] (let [user (get grouped cb (list))] (if (empty? user) (server-default-defs cb) user)))
                        (BeamLisp.Server/callback_order))
        module-defs (apply list (concat ordered inv-defs (server-client-defs mod)))
        exports (to-list (distinct (map (fn [d] [(:fname d) (count (:params d))]) module-defs)))
        descriptor (a/module mod module-defs exports (list [:behaviour (list :gen_server)]))
        create-node (a/remote mod-body-lower :reload-descriptor! (list (a/lit descriptor)))]
    (a/doo (list create-node
                 (a/remote mod-env :intern (list (a/lit (:ns env)) (a/lit name) (a/lit mod)))
                 (a/lit mod)))))

; ---- ns (namespace declaration) ----------------------------------------------
;
; (ns name (:require [other :as o] [lib :refer [x y]] ...)) declares and enters
; a namespace and loads/aliases/refers its dependencies. It compiles to a block
; that declares the namespace, enters it, runs the requires, installs aliases
; and refers, and returns the namespace name as an atom.

(defn- parse-require-spec
  "Parse one :require spec into [target as-alias refer]. A bare symbol is just a
   target; a vector `[target :as a :refer [x y]]` carries an alias and/or refer
   list (or :all)."
  [spec env]
  (let [f (rn/node-form spec)]
    (if (= :symbol (rn/node-tag f))
      (list (rn/node-name f) nil (list))
      ; a vector [target flags...]
      (let [items (rn/node-items f)
            target (rn/node-name (rn/node-form (first items)))]
        (loop [fs (rest items) as-alias nil refer (list) expect nil]
          (if (empty? fs)
            (list target as-alias refer)
            (let [x (rn/node-form (first fs))
                  tag (rn/node-tag x)]
              (cond
                (and (= tag :keyword) (= "as" (rn/node-name x)))
                  (recur (rest fs) as-alias refer :as)
                (and (= tag :keyword) (= "refer" (rn/node-name x)))
                  (recur (rest fs) as-alias refer :refer)
                (= expect :as)
                  (recur (rest fs) (rn/node-name x) refer nil)
                (and (= expect :refer) (= tag :keyword) (= "all" (rn/node-name x)))
                  (recur (rest fs) as-alias :all nil)
                (and (= expect :refer) (= tag :vector))
                  (recur (rest fs) as-alias
                         (apply list (map (fn [s] (rn/node-name (rn/node-form s))) (rn/node-items x)))
                         nil)
                :else (compile-error env (str "invalid :require spec for " target))))))))))

(defn- compile-ns
  "Compile (ns name clauses...) into the block that declares and enters the
   namespace and processes its :require clauses.

   Emits: bind `ns` = name, declare it, enter it, load each required target,
   install aliases and refers, and return the namespace as an atom. The
   namespace is declared BEFORE requiring so a circular require finds it
   present."
  [name-form clauses env]
  (let [name (rn/node-name (rn/node-form name-form))
        ; gather all :require specs across the clauses
        specs (mapcat (fn [clause]
                        (let [items (rn/node-items (rn/node-form clause))
                              head (rn/node-form (first items))]
                          (if (and (= :keyword (rn/node-tag head)) (= "require" (rn/node-name head)))
                            (rest items)
                            (compile-error env "ns supports only :require clauses"))))
                      clauses)
        parsed (map (fn [s] (parse-require-spec s env)) specs)
        loads (apply list
                (map (fn [p] (a/remote mod-loader :ensure_loaded (list (a/lit (first p)))))
                     parsed))
        ; aliases/refers accumulate in REVERSE spec order (the existing compiler
        ; prepends each spec's op-group), but ops WITHIN a spec stay forward.
        ; So build a per-spec op-list, reverse the outer, then flatten.
        alias-groups (map (fn [p]
                            (if (nil? (second p))
                              (list)
                              (list (a/remote mod-env :add_alias
                                              (list (a/lit name) (a/lit (second p)) (a/lit (first p)))))))
                          parsed)
        aliases (apply concat (reverse alias-groups))
        refer-groups (map (fn [p]
                            (let [r (nth p 2)]
                              (cond
                                (= r :all)
                                  (list (a/remote mod-env :add_refer_all (list (a/lit name) (a/lit (first p)))))
                                (empty? r) (list)
                                :else
                                  (apply list
                                    (map (fn [sym]
                                           ; a `:refer [x]` of a PRIVATE var from
                                           ; the required ns is refused at compile
                                           ; time, exactly like a qualified
                                           ; reference — a private var is not part
                                           ; of another namespace's public surface.
                                           (do (reject-private! env (first p) sym)
                                               (a/remote mod-env :add_refer
                                                         (list (a/lit name) (a/lit sym) (a/lit (first p))))))
                                         r)))))
                          parsed)
        refers (apply concat (reverse refer-groups))
        ; bind `ns` once, like genesis's `ns = ...` assignment: the var reads
        ; keep the corpus (and any consumer walking the IR) on one shape
        nsvar (a/var "ns")]
    (a/lett "ns" (a/lit name)
            (a/doo (apply list
                     (concat (list (a/remote mod-env :declare_ns (list nsvar))
                                   (a/remote mod-env :in_ns (list nsvar)))
                             loads
                             aliases
                             refers
                             (list (a/remote (erlang/binary_to_atom "Elixir.String") :to_atom
                                             (list nsvar)))))))))

(defn- compile-def
  "Compile (def name value) or (def name \"doc\" value) into the tree that
   records a namespace variable.

   The value is compiled (not in tail position) and interned under the name in
   the current namespace with `BeamLisp.Env.intern`. A docstring wraps the
   result so the metadata is written after interning:
   `value = intern(...); Env.put_meta(ns, name, %{doc: ...}); value`."
  [args env]
  (let [name-form (rn/node-form (first args))
        name (rn/node-name name-form)
        rest-args (rest args)
        ; (def name "doc" value) has a string before the value
        has-doc (and (= 2 (count rest-args))
                     (erlang/is_binary (rn/node-form (first rest-args))))
        doc (when has-doc (rn/node-form (first rest-args)))
        init (if has-doc (second rest-args) (first rest-args))
        init-node (compile-node init (notail env))
        author (name-author-meta (first args))
        meta (var-meta-map doc false author)]
    (if (per-env-attr? author)
      (compile-per-env-def name init-node env meta)
      (let [intern-node (a/remote mod-env :intern (list (a/lit (:ns env)) (a/lit name) init-node))]
        (if (nil? meta)
          intern-node
          (a/lett "value" intern-node
                  (a/doo (list (a/remote mod-env :put_meta
                                         (list (a/lit (:ns env)) (a/lit name)
                                               (a/lit meta)))
                               (a/var "value")))))))))

(defn- per-env-attr?
  "Say whether a def's AUTHOR metadata carries `^:per-env` (the reader lowers it
   to the key `:per-env` => true). A per-env def registers a re-runnable init
   THUNK instead of a value, so each consuming namespace materializes its own
   instance on first read. Mirrors genesis `per_env_attr?`."
  [author]
  (and (erlang/is_map author)
       (= true (maps/get :per-env author false))))

(defn- compile-per-env-def
  "Compile a `^:per-env` value def: register a re-runnable init THUNK (not a
   value) with `BeamLisp.Env.define_per_env`, so each consuming env materializes
   its own instance on first read. The thunk is `fn -> init end`; wrapping the
   already-compiled initializer in a zero-arity fn anchors any closure it builds
   to a stable module, so the thunk stays callable across namespace churn.

   A marked def is opt-in and returns `:ok`, NOT the value — returning the value
   would force eager materialization at definition time. Mirrors genesis
   `compile_per_env_def`."
  [name init-node env meta]
  (let [thunk-node (a/fnn (list (a/clause (list) nil init-node)))
        define-node (a/remote mod-env :define_per_env
                              (list (a/lit (:ns env)) (a/lit name) thunk-node))]
    (if (nil? meta)
      define-node
      (a/doo (list define-node
                   (a/remote mod-env :put_meta
                             (list (a/lit (:ns env)) (a/lit name)
                                   (a/lit meta)))
                   (a/lit :ok))))))

(defn- compile-defn-clause
  "Compile one defn clause into a def-clause entry {kind fixed-count fname def-ast}.

   Unlike an anonymous fn clause (a `->` inside a closure), a defn clause is a
   real named `def fname(params), do: body`. Parameters bind as Elixir
   variables (destructuring ones prefix the body with matches); a `& rest`
   becomes one more parameter. The body recurs by a direct named self-call to
   `mod.fname`, which the BEAM tail-call-optimizes. A variadic clause uses the
   function name `name__bl_v` so it does not collide with the fixed arities."
  [name param-forms guard body mod env]
  (let [sv (split-variadic param-forms)
        fixed-forms (first sv)
        rest-form (second sv)
        variadic? (some? rest-form)
        fname (if variadic?
                (erlang/binary_to_atom (str name "__bl_v"))
                (erlang/binary_to_atom name))
        fixed-built (reduce (fn [acc pform]
                              (let [b (bind-param pform (:env acc))]
                                {:params (cons (:param b) (:params acc))
                                 :steps (concat (:steps acc) (:steps b))
                                 :env (:env b)}))
                            {:params (list) :steps (list) :env env}
                            fixed-forms)
        rest-built (cond
                     (nil? rest-form) fixed-built
                     ; a plain-name rest binds the collected list directly
                     (symbol-pattern? rest-form)
                       (let [b (bind-param rest-form (:env fixed-built))]
                         {:params (cons (:param b) (:params fixed-built))
                          :steps (concat (:steps fixed-built) (:steps b))
                          :env (:env b)})
                     ; a COMPOSITE rest pattern `[& [a b :as all]]`: bind the
                     ; raw trailing args, normalize an exhausted `[]` rest to
                     ; nil (Clojure binds `&` to nil, not `()`, and variadic
                     ; recursion terminates on that nil), then destructure the
                     ; pattern against the normalized value so every name and
                     ; an `:as` bind nil when the rest is empty. Mirrors the
                     ; genesis `compile_clause` pattern branch.
                     :else
                       (let [raw (fresh-var "rest")
                             rest-var (fresh-var "rest")
                             ; bl-ANF, like the fn-clause composite-rest branch
                             ; above: a quoted ast-node tree here dies in
                             ; anf-quote-node with `op: nil`.
                             norm (a/iff (a/remote mod-erlang :== (list (a/var raw) a/enil))
                                         (a/lit nil)
                                         (a/var raw))
                             _ (check-rest-pattern! rest-form)
                             r (destructure-steps rest-form (a/var rest-var) (:env fixed-built))]
                         {:params (cons raw (:params fixed-built))
                          :steps (concat (:steps fixed-built)
                                         (cons (list rest-var norm) (:steps r)))
                          :env (:env r)}))
        params (reverse (:params rest-built))
        prelude-steps (:steps rest-built)
        fixed-count (count fixed-forms)
        ; the fn can call itself by name; recur is a direct Module.fname call
        body-env (assoc (:env rest-built)
                        :recur {:self-call (list mod fname) :arity (count params)}
                        :tail true)
        ; E3: the clause is emitted DIRECTLY as a bl-ANF {:op :defn-clause}
        ; node — no quoted readback (normalise ∘ quote-node) anywhere on the
        ; defn path. Destructure preludes become nested :lets around the body,
        ; exactly the fn-clause spelling.
        body-node (nest-lets prelude-steps (compile-body body body-env))
        ; a guard sees ONLY the head's parameter variables — not the
        ; destructured names bound by the body prelude, which have not run when
        ; the BEAM evaluates the guard.
        guard-node (if (nil? guard) nil
                     (compile-guard guard (guardable-env body-env params)))
        ; params are always fresh plain vars (patterns compile to prelude
        ; steps), so the head is a list of pvar pattern nodes
        clause-node {:op :defn-clause :fname fname
                     :params (apply list (map (fn [p] {:pop :pvar :name p}) params))
                     :guard guard-node :body body-node :ann {}}
        kind (if variadic? :variadic :fixed)]
    ; entry shape Link.defvar wants: {kind, fixed-count, fname, clause-node}
    (erlang/list_to_tuple (list kind fixed-count fname clause-node))))

(defn- macro-fn-form
  "Build the anonymous-fn form for a macro's clauses.

   A macro is really a function that receives the call FORM and the call-site
   environment ahead of its declared parameters, so each clause's parameter
   vector gets `&form` and `&env` prepended. The clauses are assembled into a
   `(fn ...)`-shaped argument list for the ordinary fn compiler."
  [clauses]
  ; produce args shaped like the tail of (fn ([p...] body) ...): one
  ; parenthesised clause per macro clause, with &form/&env prepended
  (map (fn [c]
         (let [params (:params c)
               ; prepend &form and &env symbol nodes
               new-params (concat (list (rn/sym-node "&form") (rn/sym-node "&env")) params)
               body (:body c)
               guard (:guard c)]
           ; rebuild a clause form: (list [params...] :when guard? body...)
           (rn/list-node
             (concat (list (rn/->tuple (list :vector (apply list new-params))))
                     (if (nil? guard)
                       (apply list body)
                       (concat (list (rn/->tuple (list :keyword "when")) guard) (apply list body)))))))
       clauses))

(defn- compile-defmacro
  "Compile (defmacro name [params] body...) into the tree that records a macro.

   A macro is a variable whose value is tagged `{:\"$macro\", fn}`. The function
   is an ordinary compiled fn whose parameters are `&form`, `&env`, then the
   declared parameters, so at expansion time it receives the call form, the
   call-site environment, and the unevaluated arguments. It is interned like a
   `def`."
  [args env]
  (let [name-form (rn/node-form (first args))
        name (rn/node-name name-form)
        rest-args (rest args)
        has-doc (and (not (empty? rest-args))
                     (erlang/is_binary (rn/node-form (first rest-args)))
                     (not (empty? (rest rest-args))))
        doc (when has-doc (rn/node-form (first rest-args)))
        after-doc (if has-doc (rest rest-args) rest-args)
        ; A macro expands at COMPILE time; a per-env (runtime, per-consumer)
        ; instance is meaningless for one. Reject explicitly. Mirrors genesis.
        _ (when (per-env-attr? (name-author-meta (first args))) (compile-error env (str "defmacro " name ": ^:per-env is only valid on a `def` value, not a macro")))
        clauses (parse-fn-clauses after-doc env)
        fn-args (macro-fn-form clauses)
        ; macro fns use nil-rest: a trailing `& body` is nil when empty
        fn-node (compile-fn* (apply list fn-args) true env)
        macro-val (a/tup (list (a/lit (erlang/binary_to_atom "$macro")) fn-node))
        intern-node (a/remote mod-env :intern (list (a/lit (:ns env)) (a/lit name) macro-val))
        meta (var-meta-map doc false (name-author-meta (first args)))]
    (if (nil? meta)
      intern-node
      (a/lett "value" intern-node
              (a/doo (list (a/remote mod-env :put_meta
                                     (list (a/lit (:ns env)) (a/lit name)
                                           (a/lit meta)))
                           (a/var "value")))))))

(defn- compile-defn
  "Compile (defn name [params] body...) — or its multi-clause form — into the
   tree that records a linked function variable.

   Each clause becomes a real `def` clause installed into the namespace's own
   module by `BeamLisp.Link.defvar`, so calls are direct and fast. Returns the
   `defvar` call tree, which at run time interns the function and returns it.
   A leading docstring is skipped (metadata handling is a later refinement)."
  [args env]
  (compile-defn* args false env))

(defn- name-author-meta
  "The AUTHOR metadata attached to a def/defn name, as a plain value map, or an
   empty map when there is none.

   The reader wraps a name carrying `^{:doc ...}` / `^:private` / `^:x` as
   `{:meta, {:symbol name}, m}`, where `m` mixes the SOURCE POSITION
   (:line/:col/:file) with the author keys. This drops the position keys and
   returns just the author keys — the same split `compile` does for a `:meta`
   form. `name-node` is the RAW first argument (before `node-form` peels the
   wrapper), so the metadata is still present."
  [name-node]
  (let [m (rn/node-pos name-node)]
    (if (erlang/is_map m)
      (maps/without (list :line :col :file :end-line :end-col) m)
      {})))

(defn- var-meta-map
  "Build the plain metadata data map for a var, or nil when there is none.

   Author metadata is stored as data, never as compiler AST. Raw reader values
   become datums and lose exactly one intentional quote layer. Explicit
   docstrings and `defn-` privacy apply last and therefore override author
   metadata."
  [doc private? author]
  (let [author-entries (map (fn [k]
                              (erlang/list_to_tuple
                                (list k (lower-meta-value (maps/get k author)))))
                            (maps/keys author))
        doc-entries (if (nil? doc) (list)
                      (list (erlang/list_to_tuple (list :doc doc))))
        private-entries (if private?
                          (list (erlang/list_to_tuple (list :private true)))
                          (list))
        entries (concat author-entries doc-entries private-entries)]
    (if (empty? entries) nil (maps/from_list (to-list entries)))))

(defn- reader-form?
  "Say whether `v` is a RAW READER FORM (a tagged tuple straight from the
   reader: {:symbol …}, {:list …}, {:meta inner pos} …), as opposed to a
   plain runtime value a macro placed into metadata via `vary-meta`.

   Mirrors the genesis `bl_form?`: a tuple whose head is an atom is a reader
   node; anything else — a string, a number, a beam-lisp Vector struct — is
   already a value. Used to decide whether a metadata value must first be
   turned into DATA (`datum`) before it is escaped into AST."
  [v]
  (and (erlang/is_tuple v)
       (erlang/is_atom (first (erlang/tuple_to_list v)))))

(defn- strip-one-quote
  "Strip exactly ONE `quote` layer from a datum, matching genesis `unquote_data`.

   `^{:arglists '([x])}` reads its value as `(quote ([x]))`; once metadata is
   stored as DATA (not evaluated), that quote layer is intent — 'the datum,
   literally' — not content, so remove it. A datum that is not a two-element
   `(quote x)` list is returned unchanged."
  [data]
  (if (and (erlang/is_list data)
           (= 2 (count data))
           (erlang/is_tuple (first data))
           (= :symbol (first (erlang/tuple_to_list (first data))))
           (= "quote" (second (erlang/tuple_to_list (first data)))))
    (second data)
    data))

(defn- attr-kvs->map
  "Turn a `{:map …}` reader node written after a defn docstring into a plain
   metadata map `{key-atom => value-node}`.

   In `(defn f <docstring> {:inline (fn* [o] o)} [x] …)` Clojure's defn takes
   an optional metadata-map literal between the docstring and the parameter
   vector. Each key is a keyword node (lowered to its atom); each value is kept
   as its RAW reader node, so it merges uniformly with the `^{…}` author map
   and is later lowered to stored DATA by `lower-meta-value`, exactly as the
   genesis `attr_map`/`attr_value_ast` pair does."
  [map-node]
  (maps/from_list
    (apply list
      (map (fn [pair]
             (erlang/list_to_tuple
               (list (erlang/binary_to_atom (rn/node-name (rn/node-form (kv-key pair))))
                     (kv-val pair))))
           (rn/node-items map-node)))))

(defn- lower-meta-value
  "Lower an author-metadata value to plain stored data.

   Raw reader forms first become datums; values supplied by macros are already
   data. Exactly one outer quote layer expresses literal metadata and is
   removed."
  [v]
  (strip-one-quote (if (reader-form? v) (datum v) v)))

(defn- prelink-info
  "The `{module, arity→fname, variadic-or-nil}` link triple `Link.defvar` will
   install for `name`'s `clauses` — computed from the clause shapes alone, so
   the link can be put BEFORE the clauses compile (see compile-defn*). One
   `{min fname__bl_v}` at most: a defn has at most one variadic clause shape."
  [mod name clauses]
  (let [shapes (distinct (map (fn [c] (clause-shape (:params c))) clauses))
        fixed (reduce (fn [m sh]
                        (if (= :fixed (first sh))
                          (assoc m (second sh) (erlang/binary_to_atom name))
                          m))
                      {} shapes)
        variadic (some (fn [sh]
                         (when (= :variadic (first sh)) (erlang/list_to_tuple (list (second sh) (erlang/binary_to_atom (str name "__bl_v"))))))
                       shapes)]
    (erlang/list_to_tuple (list mod fixed variadic))))

(defn- defn-clauses-of
  "The parsed clauses of a `(defn name doc? attr? clauses…)` argument list —
   the same peeling `compile-defn*` does, factored so the two agree."
  [args env]
  (let [rest-args (rest args)
        has-doc (and (not (empty? rest-args))
                     (erlang/is_binary (rn/node-form (first rest-args)))
                     (not (empty? (rest rest-args))))
        after-doc (if has-doc (rest rest-args) rest-args)
        has-attr (and (not (empty? after-doc))
                      (= :map (rn/node-tag (rn/node-form (first after-doc)))))
        after-attr (if has-attr (rest after-doc) after-doc)]
    (if (or (empty? after-attr) (erlang/is_binary (rn/node-form (first after-attr))))
      nil
      (parse-fn-clauses after-attr env))))

(defn prelink-defn
  "If `form` is a top-level `(defn …)`/`(defn- …)`, install its link in `ns`
   NOW, before anything in the unit compiles, and return true; else false.

   Why: a call to a defn compiles to a direct `Module.fname(args)` iff the
   var is linked at that moment, else to `RT.invoke(fetch …)`. Within one
   file, `mplus` may call `bind` defined 6 lines LATER: in a fresh VM that
   call compiled slow (no link yet); in a VM that had compiled the file
   before, fast (the link survived). Same source, two beams — and the first
   build in every VM the slower. `AOT.compile_source` prelinks every defn in
   the unit before compiling any form, so forward references inside a file
   are direct calls, deterministically. Only the link is installed (the
   shape triple `Link.defvar` will put back); no var value — a call before
   the definition runs still fails loudly, as it should."
  [form ns]
  (let [f (rn/node-form form)]
    (if (and (= :list (rn/node-tag f))
             (let [items (rn/node-items f)]
               (and (not (empty? items))
                    (= :symbol (rn/node-tag (first items)))
                    (contains? #{"defn" "defn-"} (rn/node-name (first items)))
                    (not (empty? (rest items)))
                    (= :symbol (rn/node-tag (rn/node-form (second items)))))))
      (let [args (rest (rn/node-items f))
            name (rn/node-name (rn/node-form (first args)))
            clauses (defn-clauses-of args (new-env ns))]
        (if (nil? clauses)
          false
          (do (BeamLisp.Env/put_link ns name (prelink-info (BeamLisp.Link/module_for ns) name clauses))
              true)))
      false)))

(defn- compile-defn*
  "The general defn compiler, with an explicit `private?` flag (for defn-).

   Records a linked function variable via Link.defvar. When the definition has
   a docstring or is private, the result is wrapped so the metadata is written
   after interning: `value = defvar(...); Env.put_meta(ns, name, %{...}); value`."
  [args private? env]
  (let [name-form (rn/node-form (first args))
        name (rn/node-name name-form)
        kind (if private? "defn-" "defn")
        rest-args (rest args)
        has-doc (and (not (empty? rest-args))
                     (erlang/is_binary (rn/node-form (first rest-args)))
                     ; a lone string with nothing after is the body, not a doc
                     (not (empty? (rest rest-args))))
        doc (when has-doc (rn/node-form (first rest-args)))
        after-doc (if has-doc (rest rest-args) rest-args)
        ; a `{:map …}` literal after the docstring is Clojure's attr-map: peel
        ; it and merge into the `^{…}` author metadata (attr keys win on a clash,
        ; matching genesis `merge_attr`). What remains are the parameter clauses.
        has-attr (and (not (empty? after-doc))
                      (= :map (rn/node-tag (rn/node-form (first after-doc)))))
        attr-map (if has-attr (attr-kvs->map (rn/node-form (first after-doc))) {})
        after-attr (if has-attr (rest after-doc) after-doc)
        author (maps/merge (name-author-meta (first args)) attr-map)
        ; `^:per-env` is a stateful-VALUE-def marker; a function is already
        ; re-entrant and interns one global fn value (the PLAN-047 invariant),
        ; so the marker would do nothing on a defn. Reject rather than silently
        ; ignore it. Mirrors genesis `compile_defn`.
        _ (when (per-env-attr? author) (compile-error env (str kind " " name ": ^:per-env is only valid on a `def` value, not a function")))
        ; Parity guards (genesis compile_def_special): a defn with no clauses,
        ; or a docstring followed by another string instead of a parameter
        ; vector, is a source error — caught here with the exact message.
        _ (cond
            (empty? after-attr)
              (compile-error env (str kind " " name ": expected at least one parameter vector"))
            (erlang/is_binary (rn/node-form (first after-attr)))
              (compile-error env (str kind " " name ": expected a parameter vector, got a string literal (a docstring must be followed by clauses)"))
            :else nil)
        mod (BeamLisp.Link/module_for (:ns env))
        clauses (parse-fn-clauses after-attr env)
        ; PRE-LINK before compiling the clauses. A non-tail self-reference in
        ; a body — `(bind …)` inside `bind`, or `mplus` calling `bind` calling
        ; `mplus` — compiles to a direct `Module.fname(args)` iff the var is
        ; linked at that moment, else to a slow `RT.invoke(fetch …)`. The
        ; link is normally installed by `Link.defvar` AFTER the whole form
        ; runs, so a fresh VM emitted the slow form and a warm VM (the var
        ; linked by an earlier compile of the same file) the fast one: the
        ; SAME source gave two different beams, and the first build in every
        ; VM was the slower one. Installing the link from the clause shapes
        ; up front makes the emitted code a function of the source alone,
        ; and always the direct call. The link is exactly what defvar will
        ; put back (`Emit.fixed_variadic` over the same shapes).
        _ (BeamLisp.Env/put_link (:ns env) name (prelink-info mod name clauses))
        entries (apply list
                  (map (fn [c]
                         (compile-defn-clause name (:params c) (:guard c) (:body c) mod env))
                       clauses))
        location (list (erlang/list_to_tuple (list :file (or (:file env) "nofile")))
                       (erlang/list_to_tuple (list :line (or (:line env) 1))))
        ; the entries are DATA (def-clause tuples with quoted bodies) embedded
        ; as one literal; Link.defvar interns them at run time
        defvar-node (a/remote mod-link :defvar
                              (list (a/lit (:ns env)) (a/lit name)
                                    (a/lit entries) (a/lit location)))
        meta (var-meta-map doc private? author)]
    (if (nil? meta)
      defvar-node
      ; value = defvar(...); Env.put_meta(ns, name, meta); value
      (a/lett "value" defvar-node
              (a/doo (list (a/remote mod-env :put_meta
                                     (list (a/lit (:ns env)) (a/lit name)
                                           (a/lit meta)))
                           (a/var "value")))))))

(defn- compile-special
  "Compile a special form by name."
  [head args env]
  (cond
    (= head "if") (compile-if (first args) (second args)
                              (when (>= (count args) 3) (nth args 2)) env)
    (= head "do") (compile-body args env)
    (= head "throw") (compile-throw (first args) env)
    (= head "try") (compile-try args env)
    (= head "receive") (compile-receive args env)
    (= head "quote") (compile-quote (first args))
    (= head "syntax-quote") (compile-syntax-quote (first args) env)
    (= head "ns") (compile-ns (first args) (rest args) env)
    (= head "def") (compile-def args env)
    (= head "defn") (compile-defn* args false env)
    (= head "defn-") (compile-defn* args true env)
    (= head "defmacro") (compile-defmacro args env)
    (= head "defmulti") (compile-defmulti (first args) (rest args) env)
    (= head "defmethod") (compile-defmethod (first args) (second args) (rest (rest args)) env)
    (= head "defprotocol") (compile-defprotocol (first args) (rest args) env)
    (= head "extend-type")
      (compile-extend-type (first args) (second args) (rest (rest args)) env)
    (= head "satisfies?") (compile-satisfies? (first args) (second args) env)
    (= head "extend-protocol") (compile-extend-protocol (first args) (rest args) env)
    (= head "defrecord") (compile-defrecord (first args) (second args) (rest (rest args)) :record env)
    (= head "deftype") (compile-defrecord (first args) (second args) (rest (rest args)) :deftype env)
    (= head "reify") (compile-reify args env)
    (= head "defnative") (compile-defnative (first args) (rest args) env)
    (= head "defserver") (compile-defserver (first args) (rest args) env)
    (or (= head "let") (= head "let*")) (compile-let (first args) (rest args) env)
    (or (= head "loop") (= head "loop*")) (compile-loop (first args) (rest args) env)
    (or (= head "fn") (= head "fn*")) (compile-fn args env)
    (= head "recur") (compile-recur args env)
    :else (compile-error env (str "unknown special form `" head "`"))))

(defn- data->form
  "Turn a DATA value back into the reader form that denotes it — the exact
   inverse of `datum`.

   A macro is a function from data to data: it receives the call's parts as
   plain values and returns a new value that stands for the code to compile
   next. That returned value has to be turned back into reader-form shape so
   the compiler can lower it. This walks the value and rebuilds nodes:
     * a symbol node (already form-shaped) passes straight through;
     * a metadata wrapper `{:meta form m}` keeps its wrapper, rebuilding the
       form inside — a nil metadata is dropped (the bare form);
     * a beam-lisp vector becomes a `:vector` node; if it carries author
       metadata that metadata is re-wrapped so a later compile puts it back
       onto the value, exactly as Clojure preserves `^{...}` on returned data;
     * a set becomes a `:set` node, a list becomes a `:list` node;
     * a plain map becomes a `:map` node of rebuilt key/value pairs;
     * an atom that is not nil/true/false becomes a `:keyword` node;
     * any other literal (number, string, boolean, nil) is already itself."
  [d]
  (cond
    ; a reader node is a tuple whose head names its kind. A symbol node is
    ; already form-shaped; a meta wrapper rebuilds its inner form; any other
    ; tuple is an opaque literal value and passes through unchanged.
    (erlang/is_tuple d)
      (let [h (erlang/element 1 d)]
        (cond
          (= h :symbol) d
          (= h :meta)
            (let [f (erlang/element 2 d)
                  m (erlang/element 3 d)]
              (if (nil? m)
                (data->form f)
                (rn/meta-node (data->form f) m)))
          :else d))

    ; a vector: rebuild the items, then re-wrap author metadata if present
    (vector? d)
      (let [vform (rn/->tuple
                    (list :vector
                          (apply list (map data->form (BeamLisp.Vector/to_list d)))))
            m (erlang/map_get :meta d)]
        (if (and (erlang/is_map m) (pos? (erlang/map_size m)))
          (rn/meta-node vform m)
          vform))

    (set? d)
      (rn/->tuple (list :set
                        (apply list (map data->form (BeamLisp.Set/to_list d)))))

    (erlang/is_list d)
      (rn/list-node (apply list (map data->form d)))

    ; a plain map (not one of the struct-backed values vector?/set? caught).
    ; SORTED by the reader-form key: an Erlang map enumerates atom keys in
    ; atom-INDEX order — the order the atoms were created in this VM — which
    ; differs between a serial and a parallel build, and would make the
    ; emitted `%{}` literal (hence the beam) depend on build history rather
    ; than on the source. Map semantics are unaffected by entry order.
    (map? d)
      (rn/->tuple
        (list :map
              (lists/sort
                (fn [a b] (erlang/=< (erlang/element 1 a) (erlang/element 1 b)))
                (apply list
                  (map (fn [kv]
                         (erlang/list_to_tuple
                           (list (data->form (erlang/element 1 kv))
                                 (data->form (erlang/element 2 kv)))))
                       (maps/to_list d))))))

    ; a keyword is an atom other than nil/true/false; its node carries the name
    (and (erlang/is_atom d) (some? d) (not= d true) (not= d false))
      (rn/->tuple (list :keyword (erlang/atom_to_binary d)))

    :else d))

(defn- macro-env
  "The `&env` a macro sees: the call site's locals as data.

   A macro can ask what names are bound where it was called — that is `&env`.
   beam-lisp locals are compiler variables, not inspectable values, so the
   useful surface is their NAMES. This builds a map from each local's symbol
   node to its name string, which is what a macro inspects with, e.g.,
   `(contains? &env 'x)`."
  [env]
  (maps/from_list
    (apply list
      (map (fn [name]
             (erlang/list_to_tuple (list (rn/sym-node name) name)))
           (maps/keys (:locals env))))))

; ── gensym canonicalisation ──────────────────────────────────────────────────
;
; A macro's syntax-quote template mints `x#` names ONCE, when the macro's own
; `defmacro` is compiled: the `__N__auto` number is baked into the macro's
; body, so every expansion of `or` carries `or-tmp__847__auto` — the N the
; compiling process's counter was at back when `core.bl` compiled. That N is
; a function of core.bl's compile, not of the file now being compiled, so it
; leaks build history into every dependent's bytes: the same source emitted
; different beams depending on what compiled before it (35/303 beams differed
; run-to-run after locals were made deterministic; all 35 were this).
;
; Hygiene needs only that a template's gensym be DISTINCT from the user's
; names and from other templates' gensyms in the same expansion; it does not
; need the number to be the one minted at definition. So each expansion
; renames: walk the expanded form, and give every distinct baked `__N__auto`
; name a CANONICAL `base__M__c` name, M from THIS unit's counter. The `__c`
; marker (not `__auto`) is what makes the scheme total: a canonical name is
; never renamed again, so it is safe to re-expand a form that carries one,
; and the baked number the template happened to have is never consulted
; twice — it can change under our feet (a sibling in the same build wave
; recompiling `core.bl` re-interns every macro with new baked numbers) and
; the emitted names are still a function of this unit's source alone.
; Distinctness is preserved (the per-expansion map is 1:1).
;
; Order matters here, because this file is compiled by the compiler it
; defines: once `expand-macro` below is (re)defined, every later form's
; macro expansions run through it, and it calls `canonical-gensyms` →
; `renumber`. Both are therefore defined ABOVE it, as real fns.

(def ^:private gensym-re (Regex/compile! "^(.+)__[0-9]+__auto$"))

(defn- gensym-base
  "`base` of a BAKED template gensym `base__N__auto`, or nil when `name` is
   not one. A canonical `base__N__c` is deliberately NOT matched."
  [name]
  (let [m (Regex/run gensym-re name)]
    (if (erlang/=:= m nil) nil (second m))))

; Order matters here, because this file is compiled by the compiler it
; defines: the moment `expand-macro` below is (re)defined, every later
; form's macro expansions run through it — and it calls
; `canonical-gensyms` → `renumber` → `renumber*`. So all three must be REAL
; definitions before `expand-macro` is, which is why this block sits above
; it. `renumber` and `renumber*` are mutually recursive: declare one, define
; the other, then define the first.
(defn- renumber
  "Walk `node` threading the rename map `m` (baked name → canonical name).
   Returns [node' m']. One self-recursive fn: this file is compiled by the
   compiler it defines, so by the time the NEXT form after `expand-macro`
   expands a macro, everything `expand-macro` reaches must already be a real
   definition — a `declare`d placeholder would be called for real."
  [node m]
  (if (and (erlang/is_tuple node) (= :meta (erlang/element 1 node)))
    ; a positioned node: renumber what is inside, keep the position
    (let [inner (renumber (erlang/element 2 node) m)]
      (list (rn/meta-node (first inner) (erlang/element 3 node)) (second inner)))
    (let [tag (rn/node-tag node)]
      (cond
        (= tag :symbol)
          (let [name (rn/node-name node)
                base (gensym-base name)]
            (if (nil? base)
              (list node m)
              (if (contains? m name)
                (list (rn/->tuple (list :symbol (get m name))) m)
                (let [new (str base "__" (next-fresh!) "__c")]
                  (list (rn/->tuple (list :symbol new)) (assoc m name new))))))
        ; a (quote …) form is DATA: renaming symbols inside it changes the
        ; value the quote yields, not just hygiene. Leave it untouched.
        (and (= tag :list)
             (let [items (rn/node-items node)]
               (and (not (empty? items))
                    (= :symbol (rn/node-tag (rn/node-form (first items))))
                    (= "quote" (rn/node-name (rn/node-form (first items)))))))
          (list node m)
        (or (= tag :list) (= tag :vector) (= tag :set))
          (let [r (reduce (fn [acc item]
                            (let [x (renumber item (second acc))]
                              (list (cons (first x) (first acc)) (second x))))
                          (list (list) m)
                          (rn/node-items node))]
            (list (rn/->tuple (list tag (apply list (reverse (first r))))) (second r)))
        (= tag :map)
          (let [r (reduce (fn [acc pair]
                            (let [k (renumber (kv-key pair) (second acc))
                                  v (renumber (kv-val pair) (second k))]
                              (list (cons (erlang/list_to_tuple (list (first k) (first v))) (first acc)) (second v))))
                          (list (list) m)
                          (rn/node-items node))]
            (list (rn/->tuple (list :map (apply list (reverse (first r))))) (second r)))
        :else (list node m)))))

(defn- canonical-gensyms
  "Rename every template gensym in one expansion's result to a canonical name
   drawn from this unit's counter (see above). `form` is a reader form (the
   shape `data->form` returns).

   The rename map is PER EXPANSION and keyed on the BAKED name: within one
   expansion the same `x#` is the same baked name, so it maps to one
   canonical name (hygiene inside the template holds); across expansions the
   map is fresh, so it does not matter that the baked number can CHANGE mid
   unit — it does, whenever `core.bl` is recompiled by a sibling in the same
   build wave and its macros re-intern with new baked numbers. A canonical
   name (`__c`) is never in the map's domain, so a nested re-expansion of an
   already-canonical form passes it through unchanged."
  [form]
  (first (renumber form {})))

(defn- expand-macro
  "Run a macro once and turn its result back into a form.

   The macro function is called with the call as data: first the whole form,
   then the `&env` map, then each argument as its own datum — the arguments
   are handed over UNEVALUATED, because a macro works on code, not values. The
   value it returns is data, so `data->form` turns it back into a reader form
   ready to compile.

   `macro-fn` is the function from `macro-lookup`; `form` is the whole call
   node; `args` are the argument nodes; `env` is a fresh compile environment."
  [macro-fn form args env]
  (canonical-gensyms
    (data->form
      (BeamLisp.RT/invoke macro-fn
        (apply list
          (concat (list (datum form) (macro-env env))
                  (map datum args)))))))



(declare macroexpand-1-env)

(defn macroexpand-1
  "Expand a macro call by one step, or return the form unchanged.

   If `form` is a list whose head is a plain symbol naming a macro (and not a
   special form, which always wins), run that macro once and hand back what it
   produced. Anything else — a non-list, a list headed by a non-symbol, a
   special form, or an ordinary call — is returned exactly as given. This is
   the one place macro expansion happens; the compiler calls it, then compiles
   the result, and the language's own analysis tools call it to see through
   defining macros.

   `form` is a reader node; `ns` is the namespace name whose macros are in
   scope."
  [form ns]
  (macroexpand-1-env form (new-env ns)))

(defn- macroexpand-1-env
  "Expand a macro call by one step against a REAL compile environment, so the
   macro's `&env` sees the call site's actual locals.

   Identical to `macroexpand-1` except the caller hands in the live env instead
   of just a namespace name. The compile path uses THIS so that a macro invoked
   inside `(defn f [x] (has-x?))` sees `x` in `&env`; the public
   `macroexpand-1` keeps its `(form ns)` shape for tooling that has no locals
   and delegates here with a fresh env."
  [form env]
  (let [items (when (= :list (rn/node-tag form)) (rn/node-items form))]
    (if (and (some? items)
             (not (empty? items))
             (= :symbol (rn/node-tag (first items))))
      (let [name (rn/node-name (first items))
            args (rest items)]
        (if (contains? special-forms name)
          form
          (let [macro-fn (macro-lookup (:ns env) name)]
            (if (some? macro-fn)
              (expand-macro macro-fn form args env)
              form))))
      form)))

(defn compile-node
  "Turn one reader form into its bl-ANF node.

   This is the compiler's front door. It looks at what KIND of form it was
   handed and routes to the matching builder: a plain value is a literal, a
   collection literal builds its runtime value, a symbol resolves to a
   variable or remote reference, and a list is a call. Metadata wrappers are
   peeled first so the real form underneath is what gets compiled.

   `form` is a reader node (from reader.bl or the reader); `env` is a compile
   environment from `new-env`."
  [form env]
  (let [tag (rn/node-tag form)]
    (cond
      ; a metadata wrapper carries two kinds of key. Positional keys
      ; (:line/:col/:file) are source location — thread them into the env and
      ; compile the bare form. AUTHOR keys (anything else, e.g. `^{:key …}`) are
      ; USER DATA and must survive onto the value at run time, so the compiled
      ; value is wrapped in FormMeta.with-meta with the (compiled) author map.
      (= tag :meta)
        (let [inner (rn/node-form form)
              m (rn/node-pos form)
              ; thread this form's source position (:line/:file) onto the env so
              ; every step below can name the user's file and line in an error
              penv (pos-env env m)
              author (if (erlang/is_map m)
                       (maps/without (list :line :col :file :end-line :end-col) m)
                       {})
              inner-node (with-ann (compile-node inner penv) m (:file penv))]
          (if (or (not (erlang/is_map author)) (zero? (erlang/map_size author)))
            inner-node
            (let [author-map (a/mapp
                               (apply list
                                 (map (fn [k]
                                        [(a/lit k) (compile-node (maps/get k author) (notail penv))])
                                      (maps/keys author))))]
              (with-ann (a/remote mod-formmeta :with_meta
                          (list inner-node author-map))
                        m (:file penv)))))

      ; keyword literal: its value is the interned atom. Intern it through the
      ; AtomGuard — NOT a raw `binary_to_atom` — so a novel keyword reaching the
      ; compiler directly (a macro building keyword forms, or any caller
      ; compiling forms without going through the reader's counter) still passes
      ; the atom-table safety guard instead of silently exhausting the table.
      (= tag :keyword) (a/lit (BeamLisp.AtomGuard/to_atom (rn/node-name form)))

      ; collection literals
      (= tag :vector) (compile-vector (rn/node-items form) env)
      (= tag :map)    (compile-map (rn/node-items form) env)
      (= tag :set)    (compile-set (rn/node-items form) env)

      ; a `#Name{:k v …}` / `#ns/Name{…}` record literal. The reader emits
      ; `{:record, name, kvs}`; resolve the name to its struct module at run
      ; time and build the record from the given (known) fields via
      ; Record.literal — the same runtime entry the genesis compiler uses.
      (= tag :record)
        (let [parts (erlang/tuple_to_list (rn/node-form form))
              rec-name (second parts)
              kvs (nth parts 2)]
          (a/remote mod-record :literal
                    (list (a/lit (:ns env)) (a/lit rec-name) (compile-map kvs env))))

      ; a symbol names a value
      (= tag :symbol)
        (let [name (rn/node-name form)]
          ; a local resolves to itself; the kernel has no locals yet, so all
          ; symbols are namespace variables or remote references
          (compile-symbol name env))

      ; a list is a special form, a macro call, or an ordinary call
      ; (an empty list is just an empty list value)
      (= tag :list)
        (let [items (rn/node-items form)]
          (if (empty? items)
            a/enil
            (let [head (rn/node-form (first items))
                  name (when (= :symbol (rn/node-tag head)) (rn/node-name head))]
              (cond
                ; a special form has its own rule
                (and (some? name) (contains? special-forms name))
                  (compile-special name (rest items) env)
                ; a macro call: expand it once, then compile what it produced.
                ; The arguments are NOT pre-compiled — a macro receives them as
                ; data. `local?` names shadow macros, so a bound local wins.
                (and (some? name) (not (local? env name)) (macro? env name))
                  (compile-node (macroexpand-1-env form env) env)
                ; an ordinary call
                :else (compile-call items env)))))

      ; a plain number, string, boolean, or nil is a literal
      :else (a/lit form))))

(defn compile
  "Turn one reader form directly into its canonical bl-ANF node."
  [form env]
  (compile-node form env))

; ============================================================================
; Elixir-facing driver entry points (underscore names)
;
; These export from BeamLisp.Ns.Compiler under the SAME names the deleted
; genesis facade (lib/beam_lisp/compiler.ex) exported, so every host caller and
; every test reaches the self-hosted compiler with NO name churn and NO genesis
; behind them. The language now owns its own front door: read -> compile -> run.
; ============================================================================

(defn new_env
  "Host name for `new-env`: a fresh compile environment for namespace `ns`."
  [ns]
  (new-env ns))

(defn reset_fresh!
  "Host name for `reset-fresh!`: restart this process's fresh-name counter."
  []
  (reset-fresh!))

(defn macroexpand_1
  "Host name for `macroexpand-1`: expand `form` once in namespace `ns`."
  [form ns]
  (macroexpand-1 form ns))

(defn prelink_defn
  "Host name for `prelink-defn`."
  [form ns]
  (prelink-defn form ns))


(defn eval_form
  "Compile one reader `form` in `env` and RUN it, returning its value.

   The form compiles to bl-ANF, then eval-anf lowers it to a canonical module
   descriptor for run/0, compiles via descriptor->beam, loads the binary, and
   invokes run/0 — never interpreted — so `loop`/`recur` keep real
   tail-call optimisation. The module is KEPT loaded: a closure the form
   returns (a macro fn, a defn's value) lives in it."
  [form env]
  (let [node (compile-node form env)
        n (System/unique_integer (list :positive))
        modname (erlang/binary_to_atom (str "Elixir.BeamLisp.Eval.M" n))]
    (lower/eval-anf modname node)))

(defn eval_string
  "Read, compile and evaluate every form in `source`; return the last value.

   `file` (or nil) is attached to each form's position metadata so generated
   modules and compile errors can name it. Enters `env`'s namespace first, and
   re-reads each form's namespace so mid-source `ns` switches take effect."
  [source env file]
  (BeamLisp.Env/in_ns (:ns env))
  (let [forms (BeamLisp.Ns.Reader/read_string source file)]
    (reduce (fn [_ form]
              (eval_form form (assoc env :ns (BeamLisp.Env/current_ns))))
            nil
            (to-list forms))))

(defn read_data
  "Read ONE top-level form of `source` as runtime DATA (never evaluated),
   atom-guarded. The single-form entry the model-tool path uses."
  [source]
  (BeamLisp.AtomGuard/check! source)
  (datum (BeamLisp.Ns.Reader/read_one source)))

(defn read_all_data
  "Read EVERY top-level form of `source` as runtime data — the plural of
   `read_data`, for files we wrote ourselves. Never evaluated, atom-guarded."
  [source]
  (BeamLisp.AtomGuard/check! source)
  ; eager list — read_all_data callers (the persist journal) index it concretely
  (to-list (map datum (to-list (BeamLisp.Ns.Reader/read_all source)))))

; ── hyphen-spelling aliases (public façade compatibility) ───────────────────
; The underscore forms above are the primary implementations; these aliases
; preserve the hyphenated spellings that external callers and the old
; compiler.bl delegation shim exported.
(defn eval-form [form env] (eval_form form env))
(defn eval-string [source env file] (eval_string source env file))
(defn read-data [source] (read_data source))
(defn read-all-data [source] (read_all_data source))

