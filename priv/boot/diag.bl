; diag.bl — THE DIAGNOSTIC VOCABULARY.
;
; One shape for every failure this tree reports, whoever found it: the reader (a
; form that cannot be read), the checker (a value that cannot hold), the
; compiler, the supervisor (a child that died). A producer builds one of these;
; every consumer — the CLI, the editor's diagnostics, a repair pass, a test
; suite — reads the same fields. So a NEW producer inherits the whole reporting
; stack, and a new CONSUMER serves every producer, instead of each pairing
; inventing its own sentence.
;
; THE SHAPE (a map; these keys ARE the vocabulary, and it is closed):
;
;   :diag        true            the discriminator — this map IS a diagnostic
;   :severity    :error          stops a read or a check
;                :warning        a provable but survivable fact
;                :note           an aside
;   :kind        keyword         WHAT went wrong, for machine dispatch
;   :msg         string          the complete one-line message, the user's text
;                                (`file:line:col: sentence` — see `at-msg`)
;   :line        integer         WHERE, 1-indexed; 0 means "no source location"
;   :col         integer           (a session-level warning has no line)
;   :file        string | nil
;   :offset      integer         codepoint index of that position in the source
;   :end-line    integer         the SPAN — what a renderer underlines
;   :end-col     integer
;   :end-offset  integer
;   :form        string          the source form, re-rendered for humans
;   :expected    string          a delimiter the source needed
;   :closer      string          a delimiter the source has
;   :opened-at   positioned map  a SECOND location worth naming
;
; THE INVARIANTS — the whole contract, and each one is checkable:
;
;   1. `:msg` STANDS ALONE. Logged with no file, no line and no source, it is
;      still a sentence a human can act on.
;   2. `:line`/`:col` are where a human should LOOK, not where detection stopped.
;      An unterminated collection points at its OPENER, not at the end of file.
;   3. A POSITION IS WHOLE: :line with :col, :end-line with :end-col. A span
;      needs a START (:end-* without :line/:col locates nothing) and an END
;      INDEX (:end-offset) needs the start index (:offset). A START stands
;      alone: :offset alone is a location, not half of a span.
;   4. UNKNOWN KEYS ARE REFUSED HERE, at the producer, where the typo is
;      visible — not silently dropped by a renderer that never read them.
;   5. `:msg` IS COMPLETE: it already names its location when it has one. A
;      renderer must NOT prefix it again — two renderers that both add the
;      prefix print the location twice, which is how this rule was found. A
;      bare message from a producer that has not adopted the vocabulary yet is
;      the one case a renderer still prefixes, so producers can migrate one at
;      a time instead of all at once.
;
; WHY CLOSED, AND WHY REFUSE: a diagnostic is a wire format between a producer
; that knows things and a renderer that must not guess. Every silently-ignored
; key is a fact that dies in transit, and every unstated field is a consumer
; that has to re-parse a sentence to get it back.
;
; Producers call `error` / `warning` / `note`. The READER writes this shape
; too — it raises the same map — and it reaches this file through `from-pos`,
; the one place that knows both ways a position is written in this tree (a
; reader pos TUPLE {line col file offset}, a location MAP {:line :col …}).

(ns diag)

(def severities
  "The three levels. A reader or a checker failure is :error; a provable but
   survivable fact is :warning; an aside is :note."
  #{:error :warning :note})

(def position-keys
  "The keys that LOCATE a diagnostic, and the only ones a renderer reads. A
   SET, not a vector: membership is the question (`contains?` on a vector asks
   about INDICES, which made every real key look unknown — measured)."
  #{:line :col :file :offset :end-line :end-col :end-offset})

(def vocabulary
  "Every key a diagnostic may carry: the discriminator, the routing keys, the
   position keys, and the structure a kind-specific report attaches. Anything
   else is a typo and `why-not` names it."
  (set (concat [:diag :severity :kind :msg :form :expected :closer :opened-at]
               position-keys)))

(defn diag?
  "True when `x` is a diagnostic rather than a map that merely looks like one.
   The discriminator is `:diag`, so a host edge can tell OUR failure from any
   other map that happens to be raised."
  [x]
  (and (map? x) (= true (:diag x))))

(defn from-pos
  "A location map from a READER position tuple {line col file offset} — the one
   place that knows both representations of a position. nil in, nil out: a
   positionless diagnostic is a case, not an error."
  [pos]
  (if (nil? pos)
    nil
    {:line (erlang/element 1 pos)
     :col (erlang/element 2 pos)
     :file (erlang/element 3 pos)
     :offset (erlang/element 4 pos)}))

(defn whole
  "The location keys of `at` that are present, as a map. Absent means absent:
   this never invents a 0 or a 1 to fill a hole."
  [at]
  (if (nil? at)
    {}
    (reduce (fn [acc k] (if (some? (get at k)) (assoc acc k (get at k)) acc))
            {}
            position-keys)))

(defn loc
  "`file:line:col` for a location, or nil when there is no line to name — the
   prefix that makes a message greppable in a log and clickable in a terminal.
   With no file the line and column stand alone (`12:5`) rather than hanging off
   a dangling colon: a bare `:12:5` is an artifact, not a location."
  [at]
  (if (and (some? at) (some? (:line at)))
    (if (some? (:file at))
      (str (:file at) ":" (:line at) ":" (:col at))
      (str (:line at) ":" (:col at)))
    nil))

(defn at-msg
  "`message` with its location prefixed when there is one. Producers never
   format this themselves: one place knows the format, so two failures at the
   same place read the same way."
  [message at]
  (let [l (loc at)]
    (if (nil? l) message (str l ": " message))))

(defn- starts-with?
  "True when `s` begins with `prefix` — the smallest test that answers
   whether a message already names this place, without a regex."
  [s prefix]
  (and (string? s) (string? prefix)
       (>= (count s) (count prefix))
       (= prefix (subs s 0 (count prefix)))))

(defn complete?
  "True when `msg` already names its location — invariant 5: a diagnostic's
   `:msg` is complete. ANY renderer asks this before prefixing, so adopting the
   vocabulary is incremental: a diagnostic is passed through, a legacy bare
   message (a producer that has not converted yet) gets the location added.

   Both spellings count — with the file (`f.bl:12:5: …`) and without it
   (`12:5: …`) — because a producer may not know the file a renderer does: a
   node's :ann carries line and column, and the renderer is told the path."
  [msg at]
  (or (starts-with? msg (loc at))
      (starts-with? msg (loc {:line (:line at) :col (:col at)}))))

(defn caret
  "`at` extended over ONE character — the span to underline when a diagnostic
   points AT something rather than spanning a whole form."
  [at]
  (if (and (some? at) (some? (:line at)) (some? (:col at)))
    (let [base (assoc (assoc at :end-line (:line at)) :end-col (inc (:col at)))]
      (if (some? (:offset at)) (assoc base :end-offset (inc (:offset at))) base))
    at))

(defn named
  "A one-key map putting location `at` under `key` — how a diagnostic names a
   SECOND place, the opener a stray closer should have closed."
  [key at]
  (maps/from_list (list (erlang/list_to_tuple (list key (whole at))))))

(defn why-not
  "nil when `d` is a diagnostic this tree can render, else a sentence naming the
   first thing wrong with it. The vocabulary's whole enforcement, in one place,
   so producers and tests ask the same question."
  [d]
  (cond
    (not (map? d)) "not a map"
    (not (= true (:diag d))) "missing the :diag discriminator"
    (not (keyword? (:kind d))) ":kind must be a keyword"
    (not (string? (:msg d))) ":msg must be a string"
    (not (contains? severities (:severity d)))
      (str ":severity must be one of " (pr-str severities))
    (and (some? (:line d)) (nil? (:col d))) ":line without :col"
    (and (some? (:col d)) (nil? (:line d))) ":col without :line"
    (and (some? (:end-line d)) (nil? (:end-col d))) ":end-line without :end-col"
    ; a span needs a START before it needs an end: {:end-col 9} with no :line
    ; and no :col locates nothing, and saying so is more useful than reporting
    ; which half of the span is missing.
    (and (some? (:end-col d)) (nil? (:col d))) "a span with no start position"
    (and (some? (:end-col d)) (nil? (:end-line d))) ":end-col without :end-line"
    (and (some? (:end-offset d)) (nil? (:offset d))) ":end-offset without :offset"
    (and (some? (:opened-at d))
         (not (and (map? (:opened-at d)) (some? (:line (:opened-at d))))))
      ":opened-at must be a positioned map"
    (seq (into [] (filter (fn [k] (not (contains? vocabulary k))) (keys d))))
      (str "unknown keys " (pr-str (unknown-keys d vocabulary)))
    :else nil))

(defn- unknown-keys
  "The keys of `m` that are not in `allowed`. One question, asked of a whole
   diagnostic and of a bare location."
  [m allowed]
  (into [] (filter (fn [k] (not (contains? allowed k))) (keys (if (nil? m) {} m)))))

(defn conforms?
  "True when `d` is a well-formed diagnostic — `why-not` asked the question."
  [d]
  (nil? (why-not d)))

(defn- build
  [severity kind message at attrs]
  ; A locaTION is checked before it is copied into the diagnostic: `whole` drops
  ; what it does not recognise, so a typo in a location map (:end-lin) would
  ; otherwise vanish into a diagnostic that conforms — the exact silent loss
  ; invariant 4 exists to prevent. Measured: this is how the hole was found.
  (let [bad (unknown-keys at position-keys)]
    (if (seq bad)
      (erlang/error (str "not a diagnostic: unknown location keys " (pr-str bad)))
      (let [d (merge {:diag true
                      :severity severity
                      :kind kind
                      :msg (at-msg message at)}
                     (whole at)
                     (if (nil? attrs) {} attrs))
            why (why-not d)]
        (if (nil? why)
          d
          ; A producer bug, and it must not travel disguised as a user-facing
          ; diagnostic: refuse it where the mistake was made.
          (erlang/error (str "not a diagnostic: " why)))))))

(defn error
  "A failure that stops the work — what a reader or a checker raises."
  [kind message at attrs]
  (build :error kind message at attrs))

(defn warning
  "A provable but survivable fact, attached to source."
  [kind message at attrs]
  (build :warning kind message at attrs))

(defn note
  "An aside — no failure, no fix, worth saying once."
  [kind message at attrs]
  (build :note kind message at attrs))
