; reader-node.bl — the shape of a program, as data you can walk.
;
; When beam-lisp reads your source text, it does not hand back the text. It
; hands back a TREE of small tuples that describe what you wrote. This file
; is the vocabulary for looking at that tree: given one node, what kind is
; it, what is inside it, what did the original source line say. Nothing here
; reads text or runs code — these are pure accessors over data the reader
; already produced.
;
; Why it exists on its own: three different tools walk this same tree — the
; type checker, the tool that turns your code into a searchable database of
; facts, and (the point of the whole self-hosting effort) the compiler. They
; were each carrying their own private copy of these accessors. One copy,
; shared, means all three agree on what a node IS, which is the ground every
; later prototype stands on.
;
; The shapes a node can take (each is an Erlang tuple, or a bare value):
;
;   {:symbol, "name"}     a name you wrote, like `map` or `+`
;   {:keyword, "k"}       a keyword, like `:timeout`
;   {:list, [items]}      a call or form in round brackets, like (f a b)
;   {:vector, [items]}    a vector in square brackets, like [1 2 3]
;   {:map, [pairs]}       a map in curly brackets, like {:a 1}
;   {:set, [items]}       a set, like #{1 2 3}
;   {:record, name, kvs}  a record literal, like #Point{:x 1}
;   {:meta, node, pos}    any of the above, wrapped with its source location
;   a plain number/string/boolean/nil passes through as itself (a "scalar")

(ns reader-node)

; --- looking at a node -------------------------------------------------------

(defn node-tag
  "Say what kind of node this is, as a keyword.

   Returns the tag at the front of the tuple — :symbol, :list, :vector,
   :map, :set, :keyword, :record, or :meta — or :scalar for a bare value
   like a number or string that is not wrapped in a tuple at all."
  [n]
  (if (erlang/is_tuple n)
    (first (erlang/tuple_to_list n))
    :scalar))

(defn node-form
  "Unwrap one layer of source-location metadata, if there is one.

   The reader wraps many nodes as {:meta, inner, position} so it can
   remember which line and column they came from. Most of the time you want
   the inner node, not the wrapper. This peels exactly one :meta layer and
   returns what is inside; a node that is not wrapped is returned unchanged.
   Use it before asking what a node contains, so the metadata wrapper does
   not get in the way."
  [n]
  (if (and (erlang/is_tuple n)
           (= :meta (first (erlang/tuple_to_list n))))
    (second (erlang/tuple_to_list n))
    n))

(defn node-items
  "The children of a composite node, as a plain list.

   For a list, vector, map, or set node, this is the sequence of things
   inside it — the arguments of a call, the elements of a vector, and so on.
   It unwraps a metadata layer first, so you can call it on a node straight
   from the reader without peeling by hand."
  [n]
  (second (erlang/tuple_to_list (node-form n))))

(defn node-pos
  "The source location of a node — {:line n :col n :file ...} — or nil.

   Only nodes the reader wrapped in metadata have a position. A node that
   carries none (for example one a macro built out of thin air) returns nil,
   which is the honest answer: it came from no particular place in your
   source."
  [n]
  (if (and (erlang/is_tuple n)
           (= :meta (first (erlang/tuple_to_list n))))
    (nth (erlang/tuple_to_list n) 2)
    nil))

(defn node-name
  "The text of a symbol or keyword node — the name you actually wrote.

   For {:symbol, \"map\"} this is \"map\"; for {:keyword, \"timeout\"} it is
   \"timeout\". Call node-form first if the node might be wrapped in
   metadata."
  [n]
  (second (erlang/tuple_to_list n)))

; --- building nodes ----------------------------------------------------------
;
; Sometimes a tool needs to MAKE a node — a macro expander building a new
; form, a rewrite producing replacement code. beam-lisp has no literal
; syntax for an Erlang tuple, so these build one from a real list. (You
; cannot write the tuple directly: [:list …] would be a Vector value, and
; {:symbol …} would be a map — neither is the tuple the reader uses.)

(defn form
  "The node as an ordinary beam-lisp FORM — the inverse of the reader. A :list
   node becomes a real list, :vector/:set keep their kind, :symbol is itself
   (the runtime symbol IS the tagged tuple), :keyword becomes the runtime
   keyword, scalars are themselves, and :meta wrappers are peeled. :map and
   :record nodes throw — honestly, rather than hand back a tuple in form
   clothing. This is the seam where code-as-nodes becomes code-as-data."
  [n]
  (let [n (node-form n)
        tag (node-tag n)]
    (cond
      (or (= :symbol tag) (= :scalar tag)) n
      (= :keyword tag) (keyword (node-name n))
      (= :list tag) (apply list (map form (node-items n)))
      (= :vector tag) (into [] (map form (node-items n)))
      :else (erlang/error (str "reader-node/form: cannot convert a " (pr-str tag)
                               " node to a form — convert it at the callsite")))))

(defn ->tuple
  "Make an Erlang tuple from a list of parts.

   The one primitive the builders below share: it turns a beam-lisp list
   like [:symbol \"x\"] into the tuple {:symbol, \"x\"} that the reader and
   compiler expect. Everything else in this section is a friendly name for a
   common shape."
  [xs]
  (erlang/list_to_tuple (apply list xs)))

(defn sym-node
  "Build a symbol node for the name `s` — the node for writing `s` in code."
  [s]
  (->tuple [:symbol s]))

(defn list-node
  "Build a list node whose children are `items` — the node for a call or
   form in round brackets."
  [items]
  (->tuple [:list items]))

(defn meta-node
  "Wrap node `n` with source location `pos`, so an error can point back to
   where it came from."
  [n pos]
  (->tuple [:meta n pos]))
