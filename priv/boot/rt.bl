; rt.bl — the runtime's PUBLIC namespace.
;
; This file is the runtime's face and nothing else: one defn per public name,
; each delegating to the sub-namespace that owns the decision. The folder beside
; it (`rt/`) carries the implementation, in the same shape the `krt` prototype
; proved out (kind · seq · eq · key · number · reduce · …).
;
; WHY A FACADE. The compiler, the `core` link table and every caller name a
; MODULE and a FUNCTION. A BL namespace `rt` emits `Elixir.BeamLisp.Ns.Rt`
; (`Emit.module_for/1`), so making this namespace the runtime means every
; existing seam — `mod-rt`, the link rows, literal `hash_key`, the `lib/**/*.ex`
; callers — names a real module with a real export surface, and nothing in the
; toolchain has to learn a new naming rule.
;
; The cost is one call per operation: facade → owner. That is deliberate and
; measured: it is the first thing P5 optimises, and it keeps the ownership
; boundary visible in a stack trace while the port is in flight.
;
; (Names appear here only once their owner exists. A facade that claimed a name
; it could not serve would fail at RUNTIME, not at compile time — the link table
; is consulted on invocation — so the surface is grown alongside the port.)

(ns rt)

;; ════ rt.raw ═══════════════════════════════════════════════════════════════════
; rt/raw.bl — the runtime's raw constructors, from BIFs alone.
;
; WHY THIS FILE EXISTS. A runtime cannot call the language it implements to
; build its own values: `(cons 1 xs)` is a PRELUDE function, `(list 1 2)` is a
; prelude function, and the prelude's init needs the primitives this package
; supplies. Anything the runtime builds therefore has to come from the BEAM
; itself.
;
; WHAT THE BEAM GIVES (measured, not assumed):
;   * `()` — the empty list is a READER literal, so it needs no constructor;
;   * `'(a b c)` — a quoted list compiles to a literal list, likewise free;
;   * a 2-word TUPLE built by `make_tuple`/`setelement` is NOT a cons cell —
;     `is_list({1, []})` is false — so a cons must be produced by something the
;     list type allows;
;   * `tuple_to_list({x})` yields the one-element list `[x]`, and
;     `lists:append([[x], xs])` copies that first sublist and shares the rest,
;     which makes it a cons (`lists:append/1` is the one list builder that
;     needs nothing but its argument).
;
; This is a real cost — five BIF calls per cons — and it is deliberately the
; first thing P5 replaces (a generated raw-constructor module, or a compiler
; form that lowers straight to a cons cell, as `anf/cons-cell` already does for
; the generated modules). Until then the runtime states its intent here, once,
; instead of at every construction site.



(defn empty-list
  "The empty list, as a term. The literal, not a call."
  []
  ())

(defn raw-cons
  "The cons cell `[x|xs]`. Builds `[x]` from a one-tuple and appends it in
   front of `xs`; `lists:append/1` copies only its first sublist, so the spine
   of `xs` is shared."
  [x xs]
  (erlang/apply :lists :append
    (erlang/tuple_to_list
      (erlang/setelement 2
        (erlang/setelement 1
          (erlang/make_tuple 2 nil)
          (erlang/tuple_to_list (erlang/make_tuple 1 x)))
        xs))))

(defn raise-argument
  "Raise `%ArgumentError{message: msg}` — the exception the runtime's refusals
   have always been, so `ex-message` and a `catch ArgumentError` see one shape
   whichever runtime raised."
  [msg]
  (erlang/error (Elixir.ArgumentError/exception msg)))

(defn tuple2
  "A 2-tuple. Unlike a cons this needs no dance: `make_tuple` builds tuples."
  [a b]
  (erlang/setelement 2 (erlang/setelement 1 (erlang/make_tuple 2 nil) a) b))

(defn tuple3 [a b c]
  (erlang/setelement 3
    (erlang/setelement 2 (erlang/setelement 1 (erlang/make_tuple 3 nil) a) b)
    c))

(defn list-of
  "A list of the given items, built left to right. Convenience for the small
   static tables the package needs to build at load time."
  [items]
  (lists/foldr (fn [x acc] (raw-cons x acc)) () items))


;; ════ rt.kind ══════════════════════════════════════════════════════════════════
; krt/kind.bl — the ONE classifier every runtime protocol dispatches on.
;
; Why this file exists: the Elixir runtime decides "what kind of thing is this"
; in at least five independent places — the clause heads of rt.ex's protocol
; functions, the `rank/1` table behind `compare`, the `call_shape/1` table
; behind `invoke`, the per-type `when is_bl_map(...)` exclusions, and the
; `guard-bifs`/`num-bifs` tables in the compiler. Each is maintained by hand and
; each can disagree with the others; Set's own moduledoc warns that rt's set
; clauses MUST precede its `is_bl_map` clauses "or count/seq/first read the
; struct's fields instead of the members" — an invariant enforced by comment.
;
; One classifier makes the ordering hazard structural instead of documentary: a
; struct can never be mistaken for a map because `kind` asks the struct first.
;
; This file is written with raw Erlang BIFs only. Every `erlang/...` call below
; lowers to a direct Core Erlang remote call; none of them routes through
; BeamLisp.Ns.Rt, so `krt` carries no dependency on the runtime it is replacing.
; (Writing `(= a b)` here would emit a linked call to BeamLisp.Ns.Rt.eqv/2 — the
; compiler's call-lowering shortcut — so equality is spelled `erlang/==`.) The
; one shared dependency is `rt.raw` — the BIF-level constructors a runtime needs
; so that it never calls the language it implements.
;
; EQUALITY OF KINDS uses `(erlang/== x MOD)`, not a `case` on literal atoms,
; because the module atoms are computed once at load time; a `case` would have
; to repeat each literal everywhere.
;
; REPAIRS over the first prototype (NATIVE-PLAN §5):
;   * predicates are now read off `kind` instead of sniffing field presence, so
;     `(vector? {:items 1})` is false — a plain map with a `:items` key used to
;     satisfy `vector?` while `kind` called it `:map`;
;   * every reserved tuple tag from `BeamLisp.Guards/@internal_tuple_tags` is
;     classified (not just symbol/blfn/remote/bl_vec), so `{:meta f m}`,
;     `{:bl_deftype …}` and `{:bl_reify …}` are no longer mistaken for data
;     tuples whose fields leak through `first`/`count`/`seq`;
;   * kinds are one public descriptor vector `representations`, and `struct-kind`
;     reads it — there is no second module→kind table to drift;
;   * unknown structs are `:opaque`; only structs registered as beam-lisp records
;     are `:record`.



;; ── registered representation modules ──────────────────────────────────────
; Computed once at load: `case` patterns elsewhere would have to repeat each
; literal atom in every clause.







; The reference types, from `lib/beam_lisp/refs.ex`. `BeamLisp.Guards.is_ref_type/1`
; names exactly these four modules — plus `Reduced` and `Decimal`, registered just
; above — as "the types that hold a value behind an indirection … none of them is a
; collection". The classifier has to know them by name for the same reason it
; knows Vector: `struct?` answers `not is_ref_type(x)`, so a struct it cannot
; recognise as a reference is reported as a struct a program may inspect — wrong
; for a ref cell, right for a `%Date{}`. Registering them here keeps ONE table:
; `Guards` holds the Elixir-side list, this holds the runtime-side one.





;; ── reserved tuple tags (the guards.ex authority, mirrored) ─────────────────
; `BeamLisp.Guards/@internal_tuple_tags` is the production single place that
; decides what is data and what is machinery. A reserved tag means the tuple is
; language machinery, not a positional data value: it must stay opaque to
; `first`/`rest`/`count`/`seq`. `reserved-tags` is public and `semantic_test`
; asserts it equals the host list, so the mirror cannot drift silently.












(defn kind-struct-mod
  "The `__struct__` module of `x`, or nil when `x` is not a struct. A struct IS
   a map on the BEAM, so this is where 'map' and 'struct' are separated — once,
   for every protocol in the runtime."
  [x]
  (cond
    (erlang/is_map x) (cond (erlang/is_map_key :__struct__ x) (erlang/map_get :__struct__ x)
                            :else nil)
    :else nil))

(defn- literal-struct-kind
  "Every REGISTERED struct representation and its kind — THE table. Literal
   module atoms in a `cond` compile to a select on the atom: no load-time state,
   no `Env` lookup, nothing to keep in step. Adding a representation is one
   clause here and one in `registered-family`."
  [mod]
  (cond
    (erlang/== mod :"Elixir.BeamLisp.Vector") :vector
    (erlang/== mod :"Elixir.BeamLisp.LazySeq") :lazy
    (erlang/== mod :"Elixir.BeamLisp.Set") :set
    (erlang/== mod :"Elixir.BeamLisp.Sorted.SortedSet") :sorted-set
    (erlang/== mod :"Elixir.BeamLisp.Sorted.SortedMap") :sorted-map
    (erlang/== mod :"Elixir.BeamLisp.Decimal") :decimal
    (erlang/== mod :"Elixir.BeamLisp.Reduced") :reduced
    (erlang/== mod :"Elixir.BeamLisp.Atom") :ref-cell
    (erlang/== mod :"Elixir.BeamLisp.Volatile") :ref-cell
    (erlang/== mod :"Elixir.BeamLisp.Promise") :ref-cell
    (erlang/== mod :"Elixir.BeamLisp.Future") :ref-cell
    :else :not-registered))


(defn- struct-kind [mod]
  (let [k (literal-struct-kind mod)]
    (cond
      (erlang/== k :not-registered)
      (cond (BeamLisp.Record/record_module? mod) :record
            :else :opaque)
      :else k)))

(defn- tuple-kind [x]
  (cond
    (erlang/== 0 (erlang/tuple_size x)) :tuple
    :else (let [h (erlang/element 1 x)]
            (cond
              (erlang/== h :"$blfn") :blfn
              (erlang/== h :"$remote") :remote
              (erlang/== h :"$macro") :macro
              (erlang/== h :"$protocol") :protocol
              (erlang/== h :"$transient") :transient
              (erlang/== h :symbol) :symbol
              (erlang/== h :meta) :meta
              (erlang/== h :bl_deftype) :deftype
              (erlang/== h :bl_reify) :reify
              (erlang/== h :bl_vec) :opaque
              :else :tuple))))

(defn kind-kind
  "The single classification of a beam-lisp value.

   The order is load-bearing and belongs to exactly one place: nils and scalars
   first, then the CONTAINERS, then the rare leaf types. A struct is a map, so
   the struct check runs before the plain-map answer and can never be forgotten.

   The container tests come before `is_function`/`is_pid`/`is_port`/
   `is_reference` because a walk classifies collections on every step and
   essentially never classifies a pid. This order answers a vector in 7 tests
   where the scalar-first order took 13, and a list in 8 where it took 11. The
   tests are mutually exclusive — a term has one type — so the order is a pure
   cost decision, not a semantic one."
  [x]
  (cond
    (erlang/== x nil) :nil
    (erlang/is_boolean x) :bool
    (erlang/is_atom x) :atom
    (erlang/is_integer x) :int
    (erlang/is_float x) :float
    (erlang/is_binary x) :text
    (erlang/is_map x) (cond
                        (erlang/is_map_key :__struct__ x)
                        (struct-kind (erlang/map_get :__struct__ x))
                        :else :map)
    (erlang/is_list x) :list
    (erlang/is_tuple x) (tuple-kind x)
    (erlang/is_function x) :fn
    (erlang/is_pid x) :pid
    (erlang/is_port x) :port
    (erlang/is_reference x) :ref
    :else :other))

;; ── kind predicates ────────────────────────────────────────────────────────
; Each is a one-line read of the one table, so no predicate can drift from the
; classifier. The first prototype sniffed field presence (`is_map_key :items`),
; which let a plain map answer `vector?` while `kind` answered `:map`.

(declare kind-family)

(defn- no-clause
  "RT's refusal for a value that has no clause: `FunctionClauseError` for a
   function, a tagged value, a number or a keyword; `ArgumentError` for a
   reference type. The port answered 0/nil for them — a silent wrong answer
   where RT raised, which is what the tests of opacity pin."
  [fname arity x]
  (cond
    (erlang/== (kind-kind x) :ref-cell)
      (raise-argument (erlang/iolist_to_binary
                        `(~fname ": " ~(Elixir.Kernel/inspect (erlang/map_get :__struct__ x)) " is a reference, not a collection")))
    :else
      (erlang/error (Elixir.FunctionClauseError/exception
                      `(~(tuple2 :module :"Elixir.BeamLisp.Ns.Rt") ~(tuple2 :function (erlang/binary_to_atom fname)) ~(tuple2 :arity arity))))))

(defn- struct-of?
  "True when `x` is a struct of module `mod` — the one test a hot leaf needs,
   without running the whole classifier."
  [x mod]
  (and (erlang/is_map x) (erlang/=:= mod (maps/get :__struct__ x nil))))

(defn- is-kind? [x kd] (erlang/== (kind-kind x) kd))

(defn kind-nil? [x] (is-kind? x :nil))
(defn kind-bool? [x] (is-kind? x :bool))
(defn kind-keyword? [x] (is-kind? x :atom))
(defn kind-symbol? [x] (is-kind? x :symbol))
(defn kind-string? [x] (is-kind? x :text))
(defn kind-fn? [x]
  (let [kd (kind-kind x)]
    (cond
      (erlang/== kd :fn) true
      (erlang/== kd :blfn) true
      (erlang/== kd :remote) true
      :else false)))
(defn kind-int? [x] (is-kind? x :int))
(defn kind-float? [x] (is-kind? x :float))
(defn kind-decimal? [x] (is-kind? x :decimal))
(defn kind-number? [x] (erlang/== (kind-family (kind-kind x)) :number))
(defn kind-vector? [x] (struct-of? x :"Elixir.BeamLisp.Vector"))
(defn kind-set? [x] (is-kind? x :set))
(defn kind-sorted-set? [x] (is-kind? x :sorted-set))
(defn kind-lazy? [x] (is-kind? x :lazy))
(defn kind-sorted-map? [x] (is-kind? x :sorted-map))
(defn kind-record? [x] (is-kind? x :record))
(defn kind-map? [x] (is-kind? x :map))
(defn kind-sequential? [x] (erlang/== (kind-family (kind-kind x)) :sequential))
(defn kind-ident? [x]
  (cond
    (erlang/== (kind-kind x) :atom) true
    (erlang/== (kind-kind x) :symbol) true
    :else false))
(defn kind-ref-type? [x]
  (cond
    (erlang/== (kind-kind x) :ref) true
    (erlang/== (kind-kind x) :port) true
    (erlang/== (kind-kind x) :pid) true
    (erlang/== (kind-kind x) :fn) true
    (erlang/== (kind-kind x) :blfn) true
    (erlang/== (kind-kind x) :remote) true
    :else false))
(defn kind-coll? [x]
  (cond
    (erlang/== (kind-kind x) :list) true
    (erlang/== (kind-kind x) :vector) true
    (erlang/== (kind-kind x) :lazy) true
    (erlang/== (kind-kind x) :set) true
    (erlang/== (kind-kind x) :sorted-set) true
    (erlang/== (kind-kind x) :map) true
    (erlang/== (kind-kind x) :sorted-map) true
    (erlang/== (kind-kind x) :record) true
    :else false))

;; ── semantic family ────────────────────────────────────────────────────────
; The comparison/equality family a kind belongs to. `krt.eq` orders and compares
; by family, not by kind, so a list, a vector and a lazy seq with the same
; elements are one value, and a set equals its sorted sibling. The registered
; struct families are read from the descriptors themselves. Primitive scalar
; families below have no separate descriptor to keep in sync.
(defn- registered-family
  "The comparison family of a REGISTERED struct kind — the other half of
   `literal-struct-kind`'s table."
  [kd]
  (cond
    (erlang/== kd :vector) :sequential
    (erlang/== kd :lazy) :sequential
    (erlang/== kd :set) :set
    (erlang/== kd :sorted-set) :set
    (erlang/== kd :sorted-map) :map
    (erlang/== kd :decimal) :number
    (erlang/== kd :reduced) :identity
    (erlang/== kd :ref-cell) :identity
    :else :opaque))

(defn kind-family
  "kind → family: the equality/ordering class a kind belongs to. `krt.eq`
   compares by family, so a list, a vector and a lazy seq with the same elements
   are one value, and a set equals its sorted sibling. A `cond` over literal
   atoms — no table, no `Env` lookup — because it is asked on every comparison."
  [kd]
  (cond
    (erlang/== kd :nil) :nil
    (erlang/== kd :bool) :bool
    (erlang/== kd :int) :number
    (erlang/== kd :float) :number
    (erlang/== kd :text) :text
    (erlang/== kd :symbol) :symbol
    (erlang/== kd :atom) :atom
    (erlang/== kd :list) :sequential
    (erlang/== kd :map) :map
    (erlang/== kd :record) :record
    (erlang/== kd :tuple) :tuple
    (erlang/== kd :meta) :meta
    (erlang/== kd :fn) :identity
    (erlang/== kd :blfn) :identity
    (erlang/== kd :remote) :identity
    (erlang/== kd :pid) :identity
    (erlang/== kd :port) :identity
    (erlang/== kd :ref) :identity
    :else (registered-family kd)))


;; ════ rt.call ══════════════════════════════════════════════════════════════════
; rt/call.bl — function invocation and callability.






;; Multi-fn construction
(defn call-multi-fn
  ([clauses]
   (tuple3 :"$blfn" clauses nil))
  ([clauses variadic]
   (tuple3 :"$blfn" clauses variadic)))

;; Helper to convert seq to args list
(defn- seq-to-args
  "`apply`'s final argument, as the list of arguments it spreads: RT's
   `seq_to_args/1`, clause for clause. A vector and a lazy seq SPREAD — the
   port's first version answered `()` for them, so `(apply list [a b])` was
   `()` and every reader node built through `->tuple` came out `{}`; found by
   the first boot-tier build through this runtime. Anything else is not a
   seq of arguments and refuses, as RT's missing clause did."
  [s]
  (cond
    (erlang/== s nil) ()
    (erlang/is_list s) s
    (struct-of? s :"Elixir.BeamLisp.Vector") (BeamLisp.Vector/to_list s)
    (struct-of? s :"Elixir.BeamLisp.LazySeq") (BeamLisp.LazySeq/to_list s)
    :else (raise-argument
            (erlang/iolist_to_binary
              `("apply: the last argument must be a sequence, got " ~(Elixir.Kernel/inspect s))))))

;; Error message
(defn- plural [n]
  (cond (erlang/== n 1) "" :else "s"))

(defn- call-describe [v]
  (cond
    (erlang/is_integer v) "a number"
    (erlang/is_float v) "a number"
    (erlang/is_binary v) "a string"
    (erlang/== nil v) "nil"
    (erlang/is_boolean v) "a boolean"
    (erlang/is_list v) "a list"
    (erlang/is_map v)
      (cond
        (erlang/== (maps/get :__struct__ v nil) :"Elixir.BeamLisp.LazySeq") "a lazy seq"
        (erlang/is_atom (maps/get :__struct__ v nil))
          (cond (kind-ref-type? v) "a reference" :else "an opaque host value")
        :else "a value")
    :else "a value"))

(defn- call-shape
  "RT's `call_shape/1`: `{kind help}` for a value that IS callable at some
   arity, nil for one that never is. The message names what the value accepts."
  [v]
  (cond
    (erlang/is_function v)
      (tuple2 "fn" "a fn takes exactly the arguments its parameter list declares")
    (and (erlang/is_tuple v) (erlang/== 3 (erlang/tuple_size v))
         (erlang/== :"$blfn" (erlang/element 1 v)))
      (let [ks (lists/sort (maps/keys (erlang/element 2 v)))
            fixed (cond (erlang/== ks ()) nil
                        :else (lists/join "/" (lists/map (fn [a] (erlang/integer_to_binary a)) ks)))
            var (erlang/element 3 v)]
        (tuple2 "fn"
          (cond
            (and (erlang/== nil fixed) (erlang/is_tuple var))
              (erlang/iolist_to_binary `("a variadic fn taking " ~(erlang/integer_to_binary (erlang/element 1 var)) " or more arguments"))
            (erlang/is_tuple var)
              (erlang/iolist_to_binary `("a fn of " ~fixed " arguments, or " ~(erlang/integer_to_binary (erlang/element 1 var)) " or more"))
            :else (erlang/iolist_to_binary `("a fn of " ~fixed " arguments")))))
    (and (erlang/is_tuple v) (erlang/== 3 (erlang/tuple_size v))
         (erlang/== :"$remote" (erlang/element 1 v)))
      (tuple2 "fn" (erlang/iolist_to_binary
                     `("a host fn " ~(Elixir.Kernel/inspect (erlang/element 2 v)) "." ~(erlang/atom_to_binary (erlang/element 3 v)))))
    (erlang/is_map v)
      (let [m (maps/get :__struct__ v nil)]
        (cond
          (erlang/== m :"Elixir.BeamLisp.Vector") (tuple2 "vector" "a vector is a function of its index: ([10 20] 1)")
          (erlang/== m :"Elixir.BeamLisp.Set") (tuple2 "set" "a set is a function of its members: (#{1 2} 1)")
          (erlang/== m :"Elixir.BeamLisp.Sorted.SortedSet") (tuple2 "sorted set" "a sorted set is a function of its members")
          (erlang/== m :"Elixir.BeamLisp.Sorted.SortedMap") (tuple2 "sorted map" "a sorted map is a function of its keys: (sm :k)")
          (erlang/is_atom m) nil
          :else (tuple2 "map" "a map is a function of its keys: ({:a 1} :a), or with a default: ({:a 1} :zz :none)")))
    (and (erlang/is_atom v) (erlang/=/= v nil) (erlang/=/= v true) (erlang/=/= v false))
      (tuple2 "keyword" "a keyword looks itself up in a map: (:a {:a 1})")
    :else nil))

(defn call-call-shape-error
  "The message for calling `v` with `arity` arguments — RT's, clause for clause."
  [v arity]
  (let [shape (call-shape v)]
    (cond
      (erlang/== nil shape)
        (erlang/iolist_to_binary
          `("cannot call " ~(Elixir.Kernel/inspect v `(~(tuple2 :limit 3) ~(tuple2 :printable_limit 40)))
            " — " ~(call-describe v) " is not a function"))
      :else
        (erlang/iolist_to_binary
          `("a " ~(erlang/element 1 shape) " called with " ~(erlang/integer_to_binary arity)
            " argument" ~(plural arity) " — " ~(erlang/element 2 shape))))))

;; ── the call protocol ──────────────────────────────────────────────────────



(defn- facade-get
  "`get` for `invoke`'s keyword and map clauses — one implementation of indexing."
  ([m k] (coll-get m k nil))
  ([m k d] (coll-get m k d)))

(defn- bad-call [f arity]
  (raise-argument (call-call-shape-error f arity)))

(defn- invoke-multi
  "The multi-fn tag tuple: `fixed` is the arity→fn map, `variadic` is `{min, f}`
   or nil. RT's own clause, one for one — including the shape of the variadic
   call, which passes the first `min` arguments followed by the REST AS ONE
   LIST. That is what makes `str`'s `{0, fn args -> … end}` receive its whole
   argument list in a single parameter."
  [f args]
  (let [fixed (erlang/element 2 f)
        variadic (erlang/element 3 f)
        arity (erlang/length args)]
    (cond
      (erlang/is_map_key arity fixed)
      (erlang/apply (maps/get arity fixed) args)

      (erlang/== variadic nil)
      (bad-call f arity)

      :else
      (let [mn (erlang/element 1 variadic)
            vf (erlang/element 2 variadic)]
        (cond
          (erlang/>= arity mn)
          (erlang/apply vf
            (lists/append (lists/sublist args mn)
                    (raw-cons (lists/nthtail mn args) ())))
          :else (bad-call f arity))))))

(defn call-invoke
  "Call `f` with the argument LIST `args`.

   A plain BEAM fn is answered first, by `erlang/is_function/1`: it IS the
   classifier's `:fn` clause, and the nine container/scalar tests above that
   clause in `kind-kind` are pure cost for the overwhelmingly common call.
   Every other value is classified once by `rt.kind/kind`, so the whole question
   \"what is this and how do I call it\" stays one read of the one classifier
   rather than a chain of `is_*` tests kept in the classifier's order.

   The clauses mirror `BeamLisp.Ns.Rt.invoke/2`: a plain fn, a multi-fn, a dynamic
   remote handle, a keyword (a function of maps), a vector (of its indices), a
   set (of its members), a sorted collection, and a plain map (of its keys).
   The port had the first three and treated a plain map as callable — both too
   permissive (a struct is a map, so a Vector was callable as a lookup) and too
   narrow (a keyword, a vector and a set were all uncallable). Nothing else is
   callable, and the last clause says so in a sentence rather than leaving the
   reader a host stack frame naming the wrong function."
  ([f] (call-invoke f ()))
  ([f args]
   (let [kd (cond (erlang/is_function f) :fn :else (kind-kind f))
         n (erlang/length args)]
     (cond
       ;; A plain fn: the overwhelmingly common case — and the ONE case the
       ;; classifier reaches only after nine container/scalar tests.
       ;; `erlang/is_function/1` IS the classifier's `:fn` clause (a fun has no
       ;; other kind), so a plain fn is answered directly and those nine tests
       ;; are never run; every other value is classified once by `kind-kind`,
       ;; exactly as before. `length(args)` is still bound eagerly above, so an
       ;; improper argument list still raises `badarg` before `apply`, and
       ;; `erlang:apply/2` still raises the BEAM's own arity refusal.
       (erlang/== kd :fn) (erlang/apply f args)

       (erlang/== kd :blfn) (invoke-multi f args)

       ;; Dynamic invocation of a host-module handle: the runtime half of the
       ;; capability gate, whose static half the compiler enforces. A handle
       ;; made at :global carries no authority into a capped env — the CALLING
       ;; env's grants decide. The port first applied the handle unchecked,
       ;; which let a capped sandbox call any module through a handle it was
       ;; given (caps_test: "a $remote handle created at :global cannot fire
       ;; inside a capped env", and the confused-deputy DOCTRINE test).
       (erlang/== kd :remote)
       (let [m (erlang/element 2 f) fun (erlang/element 3 f)]
         (cond
           (BeamLisp.Env/caps_allowed? m (BeamLisp.Env/op_of m fun)) (erlang/apply m fun args)
           :else (erlang/error (Elixir.BeamLisp.CompileError/exception
                                 `(~(tuple2 :message
                                      (erlang/iolist_to_binary
                                        `("module " ~(Elixir.Kernel/inspect m) " is not granted in this environment "
                                          "(dynamic invocation of " ~(Elixir.Kernel/inspect m) "." ~(erlang/atom_to_binary fun)
                                          "/" ~(erlang/integer_to_binary n) " denied)"))))))))

       ;; Keywords are functions of maps: `(:a m)` is `(get m :a)`.
       (erlang/== kd :atom)
       (cond
         (erlang/== n 1) (facade-get (erlang/hd args) f)
         (erlang/== n 2) (facade-get (erlang/hd args) f (erlang/hd (erlang/tl args)))
         :else (bad-call f n))

       ;; Vectors are functions of their indices: `([a b] 1)` is `(nth [a b] 1)`.
       (erlang/== kd :vector)
       (cond
         (and (erlang/== n 1) (erlang/is_integer (erlang/hd args)))
         (BeamLisp.Vector/nth f (erlang/hd args))
         :else (bad-call f n))

       ;; Sets are functions of their members: the member, or the default.
       (erlang/== kd :set)
       (cond
         (erlang/== n 1)
         (cond (BeamLisp.Set/member? f (erlang/hd args)) (erlang/hd args) :else nil)
         (erlang/== n 2)
         (cond (BeamLisp.Set/member? f (erlang/hd args)) (erlang/hd args)
               :else (erlang/hd (erlang/tl args)))
         :else (bad-call f n))

       (erlang/== kd :sorted-set)
       (cond
         (erlang/== n 1)
         (cond (BeamLisp.Sorted/set_member? f (erlang/hd args)) (erlang/hd args) :else nil)
         (erlang/== n 2)
         (cond (BeamLisp.Sorted/set_member? f (erlang/hd args)) (erlang/hd args)
               :else (erlang/hd (erlang/tl args)))
         :else (bad-call f n))

       (erlang/== kd :sorted-map)
       (cond
         (erlang/== n 1) (facade-get f (erlang/hd args))
         (erlang/== n 2) (facade-get f (erlang/hd args) (erlang/hd (erlang/tl args)))
         :else (bad-call f n))

       ;; A plain map is a function of its keys. A struct never reaches here:
       ;; each has its own kind, which is the ordering hazard the classifier
       ;; removes for every protocol at once.
       (erlang/== kd :map)
       (cond
         (erlang/== n 1) (facade-get f (erlang/hd args))
         (erlang/== n 2) (facade-get f (erlang/hd args) (erlang/hd (erlang/tl args)))
         :else (bad-call f n))

       :else (bad-call f n)))))

;; invocable? checks if a value can be called with a specific arity.
;;
;; The clauses mirror `BeamLisp.Ns.Rt.invocable?/2` one for one, because the
;; compiler's call-head dispatch is the caller: it lets a local shadow a linked
;; global only when the local's value is actually callable, so a wrong answer
;; here silently re-routes a call. Three of the four defects this port had are
;; the kind a probe cannot see — a probe asks about the cases its author
;; thought of.
(defn call-invocable? [value arity]
  (cond
    ;; A plain fn: EXACT arity. (`fun_info(f, :arity)` returns the 2-tuple
    ;; `{:arity, n}`, so comparing it to an integer was always false — every
    ;; plain fn answered "not invocable". `is_function/2` is the question.)
    (erlang/is_function value)
    (erlang/is_function value arity)

    ;; An atom — which INCLUDES nil, true and false: RT's clause is
    ;; `when is_atom(kw)`, and `is_atom(nil)` is true.
    (erlang/is_atom value)
    (or (erlang/== arity 1) (erlang/== arity 2))

    ;; A multi-fn: the tag tuple built by multi-fn/1,2. `fixed` is the
    ;; arity→fn map; `variadic` is `{min, f}` or nil. RT has this clause and the
    ;; port simply did not, so every multi-fn answered false.
    (and (erlang/is_tuple value)
         (erlang/== 3 (erlang/tuple_size value))
         (erlang/== :"$blfn" (erlang/element 1 value))
         (erlang/is_map (erlang/element 2 value)))
    (or (erlang/is_map_key arity (erlang/element 2 value))
        (and (let [v (erlang/element 3 value)]
               (and (erlang/is_tuple v)
                    (erlang/== 2 (erlang/tuple_size v))))
             (erlang/>= arity (erlang/element 1 (erlang/element 3 value)))))

    ;; A dynamic remote handle is invocable at ANY arity.
    (and (erlang/is_tuple value)
         (erlang/== 3 (erlang/tuple_size value))
         (erlang/== :"$remote" (erlang/element 1 value)))
    true

    :else false))

;; ── callback preparation ───────────────────────────────────────────────────
; A fold or a lazy map/filter invokes ONE callable once per element. `step`'s
; generic fallback runs the whole `call-invoke` protocol every time — classify
; the callable, build an argument list, look up a fixed arm, split a variadic
; rest list. `call-prepare-callback` moves that decision OUT of the loop: it
; resolves a NATIVE fun of the fixed arity the call site uses, so the hot path
; is the BEAM's direct call. It is the ONE shared preparation seam; the reduce
; walk (`reduce-callback`) and the map/filter entry points all route through it.
;
; Preparation is EFFECT-FREE and NONTHROWING. It calls nothing, so an invalid
; callable still fails only at its first INVOCATION (never on empty input), and
; a malformed arm keeps its own failure rather than falling through to another.

(defn- call-prepare-generic
  "The fallback `call-prepare-callback` keeps for a callable it cannot turn into
   a native arm: a native `n`-arity wrapper around the ORIGINAL `call-invoke`,
   so the same arguments reach the same protocol and the same failure the
   unprepared path would raise."
  [f n]
  (cond
    (erlang/== n 1) (fn [x] (call-invoke f (raw-cons x ())))
    :else (fn [acc x] (call-invoke f (raw-cons acc (raw-cons x ()))))))

(defn- call-prepare-callback
  "Normalize a callable for a FIXED arity `n` (1 or 2) into a native `n`-arity
   fun, so a hot call site pays the BEAM's direct call instead of the generic
   `call-invoke` protocol on every element. Resolved ONCE per traversal:

     · a native fun of arity `n`                      → itself, unchanged;
     · a well-formed `$blfn` tuple whose valid fixed arm is at `n`
                                                      → that arm;
     · a `$blfn` whose eligible variadic arm covers `n` (min ≤ n)
                                                      → a native adapter that
                                                        reproduces
                                                        `invoke-multi`'s exact
                                                        call: the first `min`
                                                        arguments then the REST
                                                        as ONE proper list;
     · anything else (keyword/map/set/vector/remote/opaque, a wrong arity, or a
       MALFORMED fixed/variadic descriptor)            → a native wrapper around
                                                        the ORIGINAL
                                                        `call-invoke`.

   A present-but-malformed fixed arm is NOT skipped for a variadic one — the
   wrapper preserves the fixed arm's own failure. The captured value is adapted
   privately: the registry tuple and the callable's identity are never replaced,
   so a later rebinding affects future captures, not this one."
  [f n]
  (cond
    (erlang/is_function f n) f

    (and (erlang/is_tuple f)
         (erlang/== 3 (erlang/tuple_size f))
         (erlang/== :"$blfn" (erlang/element 1 f)))
    (let [fixed (erlang/element 2 f)
          variadic (erlang/element 3 f)]
      (cond
        (erlang/== false (erlang/is_map fixed))
        (call-prepare-generic f n)

        (erlang/is_map_key n fixed)
        (let [arm (maps/get n fixed)]
          (cond
            (erlang/is_function arm n) arm
            :else (call-prepare-generic f n)))

        (and (erlang/is_tuple variadic)
             (erlang/== 2 (erlang/tuple_size variadic))
             (erlang/is_integer (erlang/element 1 variadic))
             (erlang/>= (erlang/element 1 variadic) 0)
             (erlang/is_function (erlang/element 2 variadic)
                                 (erlang/+ (erlang/element 1 variadic) 1))
             (erlang/>= n (erlang/element 1 variadic)))
        (let [mn (erlang/element 1 variadic)
              vf (erlang/element 2 variadic)]
          (cond
            (erlang/== n 1)
            (cond
              (erlang/== mn 0) (fn [x] (vf (raw-cons x ())))
              :else (fn [x] (vf x ())))
            (erlang/== mn 0) (fn [acc x] (vf (raw-cons acc (raw-cons x ()))))
            (erlang/== mn 1) (fn [acc x] (vf acc (raw-cons x ())))
            :else (fn [acc x] (vf acc x ()))))

        :else (call-prepare-generic f n)))

    :else (call-prepare-generic f n)))

;; apply-to: apply with seq argument
(defn call-apply-to [f args]
  (call-invoke f (seq-to-args args)))

;; apply-variadic: variadic apply
(defn call-apply-variadic [f arg1 rest-list]
  (let [all-args (erlang/++ `(~arg1) rest-list)
        reversed (erlang/apply :lists :reverse (raw-cons all-args ()))
        seq-arg (erlang/hd reversed)
        leading-rev (erlang/tl reversed)
        leading (erlang/apply :lists :reverse (raw-cons leading-rev ()))]
    (call-invoke f (erlang/++ leading (seq-to-args seq-arg)))))

;; remote-fun: create a remote function handle
(defn- to-text
  "Elixir's `\"#{x}\"` for the values an error message names: an atom's name,
   a binary as itself, anything else through `inspect`."
  [x]
  (cond (erlang/is_atom x) (erlang/atom_to_binary x)
        (erlang/is_binary x) x
        (erlang/is_integer x) (erlang/integer_to_binary x)
        :else (Elixir.Kernel/inspect x)))

(defn- compile-error [msg]
  (erlang/error (Elixir.BeamLisp.CompileError/exception `(~(tuple2 :message msg)))))

(defn call-remote-fun
  "RT's `remote_fun/2`: creating a host-module handle is itself interop, so it
   is gated — a capped env cannot even FORGE a handle (`invoke` checks again,
   since handles travel between processes). Both refusals are
   `BeamLisp.CompileError`, as RT's were: the port raised a bare tuple, which a
   `rescue BeamLisp.CompileError` did not catch."
  [module fun]
  (cond
    (erlang/== false (BeamLisp.Env/caps_allowed? module (BeamLisp.Env/op_of module fun)))
      (compile-error (erlang/iolist_to_binary
                       `("module " ~(Elixir.Kernel/inspect module) " is not granted in this environment")))
    (erlang/== false (Code/ensure_loaded? module))
      (compile-error (erlang/iolist_to_binary
                       `("unresolved qualified name " ~(to-text module) "/" ~(to-text fun)
                         ": no namespace or alias named " ~(Elixir.Kernel/inspect module)
                         " is in scope, and no such module is loadable. A lowercase prefix means Erlang interop"
                         " — if you meant a beam-lisp namespace, require or alias it first.")))
    :else (tuple3 :"$remote" module fun)))

;; Type predicates
(defn call-seq? [x]
  (cond
    (and (erlang/is_map x)
         (erlang/is_map_key :"__struct__" x)
         (erlang/== (erlang/map_get :"__struct__" x) :"Elixir.BeamLisp.LazySeq"))
    true
    (erlang/is_list x) (erlang/== false (erlang/== () x))
    :else false))

(defn call-list? [x]
  (erlang/is_list x))

(defn call-struct?
  "A user/foreign BEAM struct — a bl record OR a foreign struct. FALSE for
   beam-lisp's own collection structs and for its reference types.

   The set is exactly what `kind` already knows: `:record` and `:opaque` (a
   foreign struct), plus `:decimal`, which RT also calls a struct. It is NOT
   \"everything carrying a `__struct__`\" — Vector, Set, SortedMap, SortedSet,
   LazySeq, Reduced and the four reference cells all carry one and are none of
   them a struct a program inspects.

   This used to be an exclusion LIST of module atoms: a second table beside the
   classifier's, and it had already drifted. It excluded Decimal (RT includes
   it, and the oracle caught the disagreement) and said nothing at all about the
   reference cells, which only the classifier knows."
  [x]
  (cond
    (erlang/== false (erlang/is_map x)) false
    (erlang/== false (erlang/is_map_key :"__struct__" x)) false
    :else
    (let [kd (kind-kind x)]
      (cond
        (erlang/== kd :decimal) true
        (erlang/== kd :record) true
        (erlang/== kd :opaque) true
        :else false))))

(defn call-map?
  "RT's `map?`: a plain map, a sorted map, or a bl record — in RT a record is a
   user-facing map. NOT the classifier's `map?`, which answers for the plain map
   alone. Two different questions; this file answers RT's."
  [x]
  (let [kd (kind-kind x)]
    (cond
      (erlang/== kd :map) true
      (erlang/== kd :sorted-map) true
      (erlang/== kd :record) true
      :else false)))

(defn call-set?
  "RT's `set?`: a set — hashed or ordered."
  [x]
  (let [kd (kind-kind x)]
    (cond
      (erlang/== kd :set) true
      (erlang/== kd :sorted-set) true
      :else false)))

(defn call-associative?
  "RT's `associative?`: a value fields can be read from by key or index — a bl
   map, a record, a foreign struct, or a vector. Written as one read of the
   classifier, so the non-associative structs (Set, SortedSet, LazySeq, the
   reference cells) are excluded by not being listed."
  [x]
  (let [kd (kind-kind x)]
    (cond
      (erlang/== kd :map) true
      (erlang/== kd :sorted-map) true
      (erlang/== kd :vector) true
      (erlang/== kd :decimal) true
      (erlang/== kd :record) true
      (erlang/== kd :opaque) true
      :else false)))

(defn call-transientable?
  "RT's `transientable?/1`: a vector, a set, a record and a plain map have a
   transient view; ordered collections, lazy seqs and reference types do not."
  [x]
  (let [kd (kind-kind x)]
    (cond
      (erlang/== kd :vector) true
      (erlang/== kd :set) true
      (erlang/== kd :map) true
      (erlang/== kd :record) true
      (erlang/== kd :opaque) true
      :else false)))

(defn call-sorted? [x]
  (cond
    (and (erlang/is_map x)
         (erlang/is_map_key :"__struct__" x))
    (let [mod (erlang/map_get :"__struct__" x)]
      (cond
        (erlang/== mod :"Elixir.BeamLisp.Sorted.SortedMap") true
        (erlang/== mod :"Elixir.BeamLisp.Sorted.SortedSet") true
        :else false))
    :else false))

(defn call-identical? [a b]
  (erlang/=:= a b))

(defn call-not-
  "Clojure `not`: true for exactly nil and false."
  [x]
  (or (erlang/== x false) (erlang/== x nil)))

(defn call-boolean [x]
  (and (erlang/== false (erlang/== x nil))
       (erlang/== false (erlang/== x false))))


;; ════ rt.seq ═══════════════════════════════════════════════════════════════════
; rt/seq.bl — the sequence protocol, dispatched on one classifier.
;
; Every function here asks `rt.kind/kind` what it is holding, once, and then
; answers. The Elixir runtime answers the same questions in the clause heads of
; `seq`, `first`, `rest`, `next`, `count`, `nth`, `empty?` — seven independent
; multi-clause functions that must each be edited when a type is added, and
; whose comments carry the ordering rule ("both of these are structs, and a
; struct is a map — they MUST precede the is_bl_map clause or count returns the
; number of struct fields"). One classifier makes that ordering a property of
; the code rather than a property of the reviewer.
;
; CONSTRUCTION is `rt.raw` — the BIF-level constructors: raw `cons/2`, `empty-list/0`,
; `tuple2/2`, `tuple3/3`. The
; first prototype rebuilt lists from `make_tuple`/`setelement`/`tuple_to_list`
; plus `lists:append/1` (a one-element `append` copies only its first sublist,
; so it happened to be an O(1) cons). Direct constructors state the intent and
; remove the dance; the compiler already knows how to emit a Core cons cell.
;
; TWO REPAIRS over the first prototype (NATIVE-PLAN §5):
;
;   * LIST EMPTINESS IS O(1). The prototype tested `(= 0 (length x))`, which
;     walks the whole spine just to learn whether a head exists, making `first`
;     and `seq` linear in the list. Empty is now a term compare against the
;     empty list (`erlang/==`), which the BEAM answers from the type tag:
;     a cons is never `[]`, so the answer is constant time.
;
;   * LAZY `nth` IS BOUNDED. The prototype realized the WHOLE lazy sequence
;     through `k-to-list` to take one element — unbounded work for a bounded
;     question, and an infinite loop on an infinite seq. It now forces exactly
;     the required prefix (i+1 cells, or until the seq ends) and returns nil
;     for a negative index without forcing anything.



;; ── construction ───────────────────────────────────────────────────────────
; The empty list is written `()` — a READER LITERAL, which the compiler emits
; as an `:enil` node with no variable resolution at all.
;
; It used to be a namespace `def` (`(def ^:private EMPTY …)`). A `def` VALUE is
; not a linked name — it has no arity, so the link table holds no row for it —
; so each reference compiled to a `:global` node and cost TWO `BeamLisp.Env`
; lookups. Measured on the comparison path, that difference alone was 405 -> 42
; ns per element.

(defn- seq-one [x] (raw-cons x ()))
(defn- seq-two [a b] (raw-cons a (raw-cons b ())))

(defn- empty-list?
  "O(1): a list is empty exactly when it IS the empty list. `erlang/==` is a
   term compare, so a cons cell answers from its type tag without walking."
  [xs]
  (cond
    (erlang/is_list xs) (erlang/== xs ())
    :else false))

(defn k-empty-list [] ())

(declare k-to-list)

(defn k-cons
  "RT's `cons/2`: onto nil, a list, a vector (its elements) or a lazy seq.
   Anything else has no clause — a set, a map, a string was a
   FunctionClauseError in RT, and still is."
  [x xs]
  (cond
    (erlang/== xs nil) (raw-cons x ())
    (erlang/is_list xs) (raw-cons x xs)
    (struct-of? xs :"Elixir.BeamLisp.Vector") (raw-cons x (BeamLisp.Vector/to_list xs))
    (struct-of? xs :"Elixir.BeamLisp.LazySeq") (raw-cons x xs)
    :else (erlang/error (Elixir.FunctionClauseError/exception
                          `(~(tuple2 :module :"Elixir.BeamLisp.Ns.Rt") ~(tuple2 :function :cons) ~(tuple2 :arity 2))))))

(defn seq-entry
  "A 2-element vector — the shape a map's seq yields (Clojure's MapEntry)."
  [kk v]
  (BeamLisp.Vector/new (raw-cons kk (raw-cons v ()))))

(defn- rev [xs] (erlang/apply :lists :reverse (seq-one xs)))

;; ── entries for the map-shaped kinds ───────────────────────────────────────

(defn pairs->entries
  "A list of {k, v} tuples into a list of entry vectors."
  [pairs]
  (loop [acc () ps pairs]
    (cond
      (empty-list? ps) (rev acc)
      :else (let [pr (erlang/hd ps)]
              (recur (k-cons (seq-entry (erlang/element 1 pr) (erlang/element 2 pr)) acc)
                     (erlang/tl ps))))))

(defn- map-entries [m] (pairs->entries (erlang/apply :maps :to_list (seq-one m))))
(defn- sorted-entries [m] (pairs->entries (BeamLisp.Sorted/map_to_list m)))

(defn- record-entries [r]
  ; Records retain assoc'd extension fields; only the implementation tag is hidden.
  (map-entries (erlang/apply :maps :remove (seq-two :__struct__ r))))

(defn- tuple-entries [t] (pairs->entries (erlang/tuple_to_list t)))

;; ── the sequence protocol ──────────────────────────────────────────────────

(defn k-seq
  "The seq of `x`: itself when non-empty, nil when empty. A string seqs to
   single-character strings, a tuple to its elements, a map to its entries."
  [x]
  (let [kd (kind-kind x)]
    (cond
      (erlang/== kd :nil) nil
      (erlang/== kd :list) (cond (empty-list? x) nil :else x)
      (erlang/== kd :text) (k-seq (String/graphemes x))
      (erlang/== kd :vector) (cond (erlang/== 0 (BeamLisp.Vector/count x)) nil :else x)
      (erlang/== kd :lazy) (cond (erlang/== nil (BeamLisp.LazySeq/cell x)) nil :else x)
      (erlang/== kd :set) (k-seq (BeamLisp.Set/to_list x))
      (erlang/== kd :sorted-set) (k-seq (BeamLisp.Sorted/set_to_list x))
      (erlang/== kd :sorted-map) (k-seq (sorted-entries x))
      (erlang/== kd :map) (k-seq (map-entries x))
      (erlang/== kd :record) (k-seq (record-entries x))
      (erlang/== kd :tuple) (k-seq (erlang/tuple_to_list x))
      (erlang/== kd :opaque) (k-seq (map-entries (maps/remove :__struct__ x)))
      :else (no-clause "seq" 1 x))))

(defn k-first [x]
  ; A LIST IS CHECKED FIRST, without classifying. `is_list` is one tag test on
  ; the BEAM and lists are the common sequential value in bl code, so this skips
  ; a call into the classifier on the hot path. Everything else still goes
  ; through the one classifier, which is what keeps a struct from being read as
  ; a map.
  (cond
    (erlang/is_list x) (cond (empty-list? x) nil :else (erlang/hd x))
    (struct-of? x :"Elixir.BeamLisp.Vector") (BeamLisp.Vector/first x)
    :else
    (let [kd (kind-kind x)]
      (cond
        (erlang/== kd :nil) nil
        (erlang/== kd :list) nil
        (erlang/== kd :text) (k-first (k-seq x))
        (erlang/== kd :vector) (cond (erlang/== 0 (BeamLisp.Vector/count x)) nil
                                     :else (BeamLisp.Vector/nth x 0))
        (erlang/== kd :lazy) (let [c (BeamLisp.LazySeq/cell x)]
                               (cond (erlang/== nil c) nil :else (erlang/hd c)))
        (erlang/== kd :set) (k-first (BeamLisp.Set/to_list x))
        (erlang/== kd :sorted-set) (k-first (BeamLisp.Sorted/set_to_list x))
        (erlang/== kd :sorted-map) (k-first (sorted-entries x))
        (erlang/== kd :map) (k-first (map-entries x))
        (erlang/== kd :record) (k-first (record-entries x))
        (erlang/== kd :tuple) (cond (erlang/== 0 (erlang/tuple_size x)) nil
                                    :else (erlang/element 1 x))
        (erlang/== kd :ref-cell) (no-clause "first" 1 x)
        :else nil))))

(defn k-rest
  "The tail as a sequence; empty (never nil) for a non-collection."
  [x]
  (cond
    (erlang/is_list x) (cond (empty-list? x) () :else (erlang/tl x))
    :else (k-rest-classified x)))

(defn- k-rest-classified [x]
  (let [kd (kind-kind x)]
    (cond
      (erlang/== kd :nil) ()
      (erlang/== kd :list) (cond (empty-list? x) ()
                                 :else (erlang/tl x))
      (erlang/== kd :text) (let [s (k-seq x)]
                             (cond (erlang/== nil s) () :else (erlang/tl s)))
      (erlang/== kd :vector) (k-rest (BeamLisp.Vector/to_list x))
      (erlang/== kd :lazy) (let [c (BeamLisp.LazySeq/cell x)]
                             (cond (erlang/== nil c) () :else (erlang/tl c)))
      (erlang/== kd :set) (k-rest (BeamLisp.Set/to_list x))
      (erlang/== kd :sorted-set) (k-rest (BeamLisp.Sorted/set_to_list x))
      (erlang/== kd :sorted-map) (k-rest (sorted-entries x))
      (erlang/== kd :map) (k-rest (map-entries x))
      (erlang/== kd :record) (k-rest (record-entries x))
      (erlang/== kd :tuple) (let [s (erlang/tuple_to_list x)]
                              (cond (empty-list? s) () :else (erlang/tl s)))
      (erlang/== kd :ref-cell) (no-clause "rest" 1 x)
      :else ())))

(defn k-next
  "`(seq (rest x))`: nil when nothing remains.

   A LIST and a VECTOR are answered without the classify-twice walk. The rest
   of either is a list, whose seq is itself or nil. `(seq v)` of a vector is
   the vector, so a `(loop [s (seq v)] … (next s))` walk asks this for EVERY
   step after the first."
  [x]
  (cond
    (erlang/is_list x) (cond (empty-list? x) nil
                             :else (let [t (erlang/tl x)]
                                     (cond (erlang/is_list t) (cond (empty-list? t) nil :else t)
                                           :else (k-seq t))))
    (struct-of? x :"Elixir.BeamLisp.Vector")
      (let [t (k-rest (BeamLisp.Vector/to_list x))]
        (cond (empty-list? t) nil :else t))
    :else (k-seq (k-rest x))))

(declare k-count)

; The fold toolkit lives with `k-reduce` at the bottom of the file — it needs
; `step`, which is defined there — but `k-count`/`k-to-list` and the lazy
; producers above need it first, so the names are reserved here.
(declare lazy-fold-claim lazy-fold-claimed lazy-fold-source lazy-reduce-source)
(declare reduce-reduced? reduce-reduced unwrap k-fold k-reduce)

(defn- count-list [xs]
  (loop [ys xs n 0]
    (cond
      (erlang/== ys ()) n
      (erlang/is_list ys) (recur (erlang/tl ys) (erlang/+ n 1))
      :else (erlang/+ n (k-count ys)))))

(defn k-count [x]
  (cond
    (struct-of? x :"Elixir.BeamLisp.Vector") (BeamLisp.Vector/count x)
    (erlang/is_list x) (count-list x)
    :else (k-count-classified x)))

(defn- lazy-count
  "Count a lazy seq. A node whose pending fold recipe this process CLAIMS is
   counted straight from its source (no memo cell per element, no capture
   copied) and realised as it goes (`lazy-fold-claimed`); anything else —
   already realised, claimed by another consumer, or recipe-less — walks the
   shared memo cells, which reads the fulfilled answer instead of recomputing
   it."
  [x]
  (let [claim (lazy-fold-claim x)]
    (cond
      (erlang/== claim nil) (BeamLisp.LazySeq/count x)
      :else (erlang/length
              (erlang/element 2 (lazy-fold-claimed x claim (fn [a _] a) nil))))))

(defn- k-count-classified [x]
  (let [kd (kind-kind x)]
    (cond
      (erlang/== kd :nil) 0
      (erlang/== kd :list) (count-list x)
      (erlang/== kd :text) (String/length x)
      (erlang/== kd :vector) (BeamLisp.Vector/count x)
      (erlang/== kd :lazy) (lazy-count x)
      (erlang/== kd :set) (BeamLisp.Set/count x)
      (erlang/== kd :sorted-set) (BeamLisp.Sorted/set_count x)
      (erlang/== kd :sorted-map) (BeamLisp.Sorted/map_count x)
      (erlang/== kd :map) (erlang/map_size x)
      (erlang/== kd :record) (erlang/- (erlang/map_size x) 1)
      (erlang/== kd :tuple) (erlang/tuple_size x)
      (erlang/== kd :opaque) (erlang/- (erlang/map_size x) 1)
      :else (no-clause "count" 1 x))))

(declare k-nth)

(defn- nth-list
  "Iterative `nth` over a cons chain — no recursion depth, no length call.
   A negative or exhausted index answers nil."
  [xs i]
  (loop [ys xs k i]
    (cond
      (erlang/== false (erlang/is_list ys)) (k-nth ys k)
      (erlang/== ys ()) nil
      (erlang/== k 0) (erlang/hd ys)
      :else (recur (erlang/tl ys) (erlang/- k 1)))))

(defn- nth-lazy
  "Force exactly the prefix `nth` needs and no more: at most i+1 cells, then
   stop. A lazy seq that never ends still answers index i (unlike the first
   prototype, which realized the whole seq through `k-to-list`)."
  [l i]
  (loop [cell (BeamLisp.LazySeq/cell l) k i]
    (cond
      (erlang/== cell nil) nil
      (erlang/== k 0) (erlang/hd cell)
      :else (recur (BeamLisp.LazySeq/cell (erlang/tl cell)) (erlang/- k 1)))))

(defn- in-range?
  "Whether index `i` addresses an element of `x`.

   This is the question `nth/3` exists to answer. `nth` returns nil both for an
   absent element and for a present-but-nil one, so a caller wanting a DEFAULT
   cannot tell the two apart without asking the bounds — and asking the bounds
   at every call site is what the explicit default saves the caller from having
   to remember."
  [x i]
  (cond
    (erlang/== x nil) false
    (if (erlang/is_integer i) false true) false
    (erlang/< i 0) false
    (erlang/is_list x) (erlang/< i (erlang/length x))
    (erlang/is_binary x) (erlang/< i (erlang/byte_size x))
    :else
    (let [kd (kind-kind x)]
      (cond
        (erlang/== kd :vector) (erlang/< i (k-count x))
        (erlang/== kd :lazy) (erlang/< i (k-count x))
        :else false))))

(defn- lists-at
  "`Enum.at/2` on a list, which RT's `nth` is: a negative index counts from the
   end, out of range is nil."
  [xs i]
  (cond
    (erlang/== false (erlang/is_integer i)) (erlang/error (Elixir.FunctionClauseError/exception
                                                            `(~(tuple2 :module :"Elixir.Enum") ~(tuple2 :function :at) ~(tuple2 :arity 2))))
    (erlang/>= i 0) (nth-list xs i)
    :else (let [n (erlang/+ (count-list xs) i)]
            (cond (erlang/< n 0) nil :else (nth-list xs n)))))

(defn- nth-refuse
  "RT's `nth/2` has clauses for nil, lists, vectors, data tuples and lazy seqs
   only; everything else — a string, a map, a set, a fn — raised."
  [x]
  (erlang/error (Elixir.FunctionClauseError/exception
                  `(~(tuple2 :module :"Elixir.BeamLisp.Ns.Rt") ~(tuple2 :function :nth) ~(tuple2 :arity 2)))))

(defn k-nth
  ([x i]
   (cond
    (erlang/is_list x) (lists-at x i)
    (erlang/== false (erlang/is_integer i)) (cond (erlang/== x nil) nil
                                                  (struct-of? x :"Elixir.BeamLisp.Vector") (BeamLisp.Vector/nth x i)
                                                  (erlang/== (kind-kind x) :tuple) nil
                                                  (erlang/== (kind-kind x) :lazy) nil
                                                  :else (nth-refuse x))
    (erlang/< i 0) (cond (erlang/== x nil) nil
                         (struct-of? x :"Elixir.BeamLisp.Vector") nil
                         (erlang/== (kind-kind x) :tuple) nil
                         (erlang/== (kind-kind x) :lazy) nil
                         :else (nth-refuse x))
    (struct-of? x :"Elixir.BeamLisp.Vector") (BeamLisp.Vector/nth x i)
    :else
    (let [kd (kind-kind x)]
      (cond
        (erlang/== kd :nil) nil
        (erlang/== kd :list) (nth-list x i)
        (erlang/== kd :vector) (BeamLisp.Vector/nth x i)
        (erlang/== kd :lazy) (nth-lazy x i)
        (erlang/== kd :tuple) (cond (erlang/< i (erlang/tuple_size x)) (erlang/element (erlang/+ i 1) x)
                                    :else nil)
        :else (nth-refuse x)))))

  ([x i default]
   (let [v (k-nth x i)]
     (cond
       (erlang/== v nil) (cond (in-range? x i) nil :else default)
       :else v))))

(defn k-empty? [x]
  (cond
    (erlang/is_list x) (empty-list? x)
    (struct-of? x :"Elixir.BeamLisp.Vector") (erlang/== 0 (BeamLisp.Vector/count x))
    :else (k-empty-classified x)))

(defn- k-empty-classified [x]
  (let [kd (kind-kind x)]
    (cond
      (erlang/== kd :nil) true
      (erlang/== kd :list) (empty-list? x)
      (erlang/== kd :lazy) (erlang/== nil (BeamLisp.LazySeq/cell x))
      :else (erlang/== 0 (k-count x)))))

(defn- to-list-memo
  "The memo walk behind `k-to-list`: force one cell at a time and share every
   answer. This is what `doall` is defined to do — it REALISES the memo."
  [x]
  (let [s (k-seq x)]
    (loop [acc () ys s]
      (cond
        (erlang/== ys nil) (rev acc)
        :else (recur (k-cons (k-first ys) acc) (k-next ys))))))

(defn k-to-list
  "Realize a sequence as a proper list. The one place a lazy seq is forced.
   A lazy node whose pending fold recipe this process CLAIMS is realized through
   the recipe: the same list, built and published without a memo cell per
   element. Anything else walks the shared cells, so an already-realised seq —
   or one another consumer already claimed — is not recomputed."
  [x]
  (let [claim (lazy-fold-claim x)]
    (cond
      ; a vector is already realised: its element list, without a cell walk
      (struct-of? x :"Elixir.BeamLisp.Vector") (BeamLisp.Vector/to_list x)
      (erlang/== claim nil) (to-list-memo x)
      :else (erlang/element 2 (lazy-fold-claimed x claim (fn [a _] a) nil)))))

; `doall` is defined to REALISE: it publishes every cell so a second consumer
; reads the shared answers. It therefore walks the memo, never a fold recipe —
; the recipe is for consumers that walk the seq once and discard it.
(defn k-doall [x] (to-list-memo x))

(defn k-take
  "The first `n` elements as a list. For `n <= 0` it returns the empty list
   WITHOUT touching the collection — no `k-seq`, so a lazy seq is not forced
   even once. For `n > 0` it forces exactly the cells it yields and does not
   ask for the next cell after the nth, so a lazy seq pays for n cells, not
   n+1."
  [n x]
  (cond
    (erlang/=< n 0) (k-empty-list)
    :else
    (loop [acc () i n ys (k-seq x)]
      (cond
        (erlang/== ys nil) (rev acc)
        :else (let [acc2 (k-cons (k-first ys) acc)
                    i2 (erlang/- i 1)]
                (cond
                  (erlang/== i2 0) (rev acc2)
                  :else (recur acc2 i2 (k-next ys))))))))

(defn k-drop
  "RT's `drop_from/2`. `n <= 0` hands back the collection itself as a sequence
   (nil → `()`, a vector → its list, a list or lazy seq untouched — no
   forcing); `n > 0` steps through `LazySeq.cell`, which is what makes a
   string drop by grapheme and a set or map by member."
  [n x]
  (cond
    (erlang/=< n 0)
      (cond (erlang/== x nil) ()
            (struct-of? x :"Elixir.BeamLisp.Vector") (BeamLisp.Vector/to_list x)
            :else x)
    :else
      (loop [i n ys x]
        (let [c (BeamLisp.LazySeq/cell ys)]
          (cond
            (erlang/== c nil) ()
            (erlang/== i 0) c
            :else (recur (erlang/- i 1) (erlang/tl c)))))))

(defn k-splice
  "RT's `splice/2` for `~@`: a vector or list spreads, nil is empty, and
   anything else goes through `Enum.to_list` — so a spliced map yields its raw
   `{k, v}` entries, as the macros that splice maps have always seen."
  [spliced tail]
  (erlang/++
    (cond
      (erlang/== spliced nil) ()
      (erlang/is_list spliced) spliced
      (struct-of? spliced :"Elixir.BeamLisp.Vector") (BeamLisp.Vector/to_list spliced)
      :else (Enum/to_list spliced))
    tail))

(defn k-list-star
  "RT's `list_star/2` — the VARIADIC clause of `list*`, so `rest` is the rest
   of the call's arguments and its LAST element is the seq that is spread:
   `(list* a b [c d])` is `(list-star a (b [c d]))` → `(a b c d)`. The port first
   read `rest` as the seq itself and so never spread anything: `(list* 'f
   more)` built `(f (x y))` instead of `(f x y)`, and core's recursive
   `assert-macro-args` expanded to a call of its own arguments."
  [x rest]
  (if (erlang/== rest ())
    (k-seq x)
    (let [rev (lists/reverse (erlang/++ `(~x) rest))]
      (erlang/++ (lists/reverse (erlang/tl rev)) (seq-to-args (erlang/hd rev))))))


;; ════ rt.hash ══════════════════════════════════════════════════════════════════
; rt/hash.bl — the value a hash boundary sees.
;
; Metadata is invisible to `eqv`, so it must be invisible to HASHING: otherwise
; `(= a b)` is true while `(get {a :x} b)` is nil, and the same value counts
; twice under `distinct` or in a set. Elixir's maps and MapSets key on the raw
; term, which DOES see the struct's `:meta` field, so the metadata is stripped
; here — at every hash boundary, recursively, because a vector holding a
; metadata-bearing vector has to hash like the plain one.
;
; THE COMMON CASE MUST NOT ALLOCATE. This runs on every map and set key
; operation, and the overwhelmingly common answer is "nothing anywhere carries
; metadata". So the walk is short-circuited (it descends only as far as the
; first metadata) and a value with none is returned AS ITSELF, not rebuilt.



;; ── representation predicates ──────────────────────────────────────────────
; Literal module atoms, like the classifier: comparing against a literal is
; free, and naming a table costs two Env lookups per call — on the hottest path
; there is.

(defn- hash-struct-mod [x]
  (cond (erlang/is_map x) (maps/get :"__struct__" x nil)
        :else nil))

(defn- dense-items?
  "A vector's `:items` is a dense tuple, OR a 5-tuple tagged `:bl_vec` for the
   trie form. Only the dense form is walked here; a trie node's metadata is
   reached through the same walk when it is a leaf."
  [t]
  (and (erlang/is_tuple t)
       (erlang/== false (and (erlang/== 5 (erlang/tuple_size t))
                             (erlang/== :bl_vec (erlang/element 1 t))))))

(declare carries-meta?)

(declare hash-hash-key)

(defn- any-meta-in-list? [xs]
  (loop [ys xs]
    (cond
      (erlang/== false (erlang/is_list ys)) false
      (erlang/== ys ()) false
      :else (cond (carries-meta? (erlang/hd ys)) true
                  :else (recur (erlang/tl ys))))))

(defn- needs-normalizing?
  "Whether any element of a dense items tuple carries metadata."
  [t]
  (loop [i 0]
    (cond
      (erlang/>= i (erlang/tuple_size t)) false
      :else (cond (carries-meta? (erlang/element (erlang/+ i 1) t)) true
                  :else (recur (erlang/+ i 1))))))

(defn- any-meta-in-map? [m]
  (loop [iter (maps/iterator m)]
    (let [nx (maps/next iter)]
      (cond
        (erlang/== nx :none) false
        :else (let [k (erlang/element 1 nx)
                    v (erlang/element 2 nx)
                    rest-iter (erlang/element 3 nx)]
                (cond
                  (carries-meta? k) true
                  (carries-meta? v) true
                  :else (recur rest-iter)))))))

(defn- carries-meta?
  "Whether `x` holds metadata anywhere inside it. A scalar answers immediately
   (one tag test), so a deep structure is only walked as far as its first
   metadata."
  [x]
  (cond
    (erlang/is_map x)
    (let [mod (hash-struct-mod x)]
      (cond
        (erlang/== mod :"Elixir.BeamLisp.Vector")
        (let [meta (erlang/map_get :meta x)]
          (cond
            (erlang/=/= nil meta) true
            ; no `:items` field: the JS target's vector (PLAN-163 C2)
            (erlang/== false (erlang/is_map_key :items x)) (any-meta-in-list? (BeamLisp.Vector/to_list x))
            :else
            (let [items (erlang/map_get :items x)]
              (cond (dense-items? items) (needs-normalizing? items)
                    :else false))))

        (erlang/== mod :"Elixir.BeamLisp.Set")
        (any-meta-in-list? (BeamLisp.Set/to_list x))

        ;; another struct: not a collection, and its fields are not user data
        (erlang/=/= nil mod) false

        :else (any-meta-in-map? x)))

    (erlang/is_list x) (any-meta-in-list? x)
    :else false))

;; ── the hash key ───────────────────────────────────────────────────────────

(defn- normalize-map [m]
  (maps/from_list (k-to-list
                        (map (fn [pair] (tuple2 (hash-hash-key (erlang/element 1 pair))
                                                    (hash-hash-key (erlang/element 2 pair))))
                             (maps/to_list m)))))

(defn- normalize-set [s]
  (BeamLisp.Set/new (k-to-list (map (fn [x] (hash-hash-key x)) (BeamLisp.Set/to_list s)))))

(defn hash-hash-key
  "A value normalized for use as a hash key: metadata stripped throughout, and
   the SAME term returned whenever there was none to strip."
  [x]
  (cond
    (erlang/is_map x)
    (let [mod (hash-struct-mod x)]
      (cond
        (erlang/== mod :"Elixir.BeamLisp.Vector")
        (cond
          ; no `:items` field: the JS target's vector (PLAN-163 C2) — rebuilt
          ; from its normalized elements, which also drops the metadata
          (erlang/== false (erlang/is_map_key :items x))
          (cond (carries-meta? x) (BeamLisp.Vector/new (k-to-list (map (fn [e] (hash-hash-key e)) (BeamLisp.Vector/to_list x))))
                :else x)
          :else
        (let [meta (erlang/map_get :meta x)
              normalized (cond (erlang/== nil meta) x
                               :else (maps/put :meta nil x))
              items (erlang/map_get :items x)]
          (cond
            (dense-items? items)
            (cond (needs-normalizing? items)
                  (maps/put :items
                            (erlang/list_to_tuple (k-to-list (map (fn [e] (hash-hash-key e))
                                                                   (erlang/tuple_to_list items))))
                            normalized)
                  :else normalized)
            :else normalized)))

        (erlang/== mod :"Elixir.BeamLisp.Set")
        (let [members (BeamLisp.Set/to_list x)]
          (cond (any-meta-in-list? members) (normalize-set x)
                :else x))

        (erlang/=/= nil mod) x

        :else (cond (any-meta-in-map? x) (normalize-map x)
                    :else x)))

    (erlang/is_list x)
    (cond (any-meta-in-list? x) (k-to-list (map (fn [e] (hash-hash-key e)) x))
          :else x)

    :else x))


;; ════ rt.number ════════════════════════════════════════════════════════════════
; rt/number.bl — the ONE exact rational projection for finite numbers.
;
; WHY. The first prototype ordered numbers with a MIXTURE: `Num.cmp/2` for
; int/float, `Decimal.compare/2` (through `Decimal.from_float/1`) for
; decimal/float. `from_float/1` is the shortest decimal that ROUND-TRIPS, not
; the float's exact value, so the two halves disagree about the same pair and
; `=` stops being transitive at the boundaries — a float beside the integer it
; rounded from, and beside a decimal with more digits than the float can hold.
; The key projection had the same split, so values the order called equal could
; produce different keys (and values it called different could collide).
;
; THE PROJECTION. Every finite number becomes one EXACT rational
; `{numerator, denominator}`:
;
;   int      n        -> n / 1
;   float    f        -> Float.ratio/1          (the IEEE value, exactly)
;   decimal  U/10^S   -> unscaled / 10^scale
;
; then reduced by gcd with a POSITIVE denominator and zero canonicalised to
; 0/1. There is NO approximation anywhere: no shortest-decimal, no
; float-to-string round-trip. `0.1` (the float) is
; 3602879701896397/36028797018963968 while `0.1M` is 1/10 — the order says so,
; and so does the key.
;
; BOTH CONSUMERS read this one projection: `rt.eq` orders numbers with
; `num-cmp` (cross-multiplication `na*db` vs `nb*da`, exact for arbitrary
; precision integers, no common denominator materialised) and `rt.key` builds
; `{:num, numerator, denominator}` with `num-key`. Because both read the SAME
; reduced rational, "the order says 0" and "the keys are equal" are one
; predicate over numbers.
;
; Construction uses `rt.raw` and BIFs plus `Float.ratio/1`; no
; `BeamLisp.Ns.Rt` and no `Decimal` module — a decimal's `:unscaled`/`:scale`
; fields are read directly. `erlang/gcd/2` is not a BIF; gcd is Euclid below.



(defn- number-refuse [x why]
  (erlang/error (tuple3 :"$krt-number/unsupported" why x)))

;; ── exact integer helpers ──────────────────────────────────────────────────
(defn- gcd
  "Euclid on non-negative integers. `erlang/gcd/2` is not a BIF."
  [a b]
  (loop [x a y b]
    (cond
      (erlang/== y 0) x
      :else (recur y (erlang/rem x y)))))

(defn- pow10 [n]
  (loop [i n acc 1]
    (cond
      (erlang/== i 0) acc
      :else (recur (erlang/- i 1) (erlang/* acc 10)))))

(defn- reduce-ratio
  "`{n, d}` in lowest terms with a positive denominator; zero is 0/1."
  [n d]
  (cond
    (erlang/== n 0) (tuple2 0 1)
    :else
    (let [neg (erlang/< d 0)
          nn (cond neg (erlang/- 0 n) :else n)
          dd (cond neg (erlang/- 0 d) :else d)
          g (gcd (erlang/abs nn) dd)]
      (tuple2 (erlang/div nn g) (erlang/div dd g)))))

;; ── the projection ─────────────────────────────────────────────────────────
(defn ratio
  "The exact reduced rational `{numerator, denominator}` of a finite number:
   int -> n/1, float -> the IEEE value via `Float.ratio/1`, decimal ->
   unscaled/10^scale. The denominator is positive. Raises for a non-number."
  [x]
  (let [kd (kind-kind x)]
    (cond
      (erlang/== kd :int) (tuple2 x 1)
      (erlang/== kd :float)
      (let [r (Float/ratio x)]
        (reduce-ratio (erlang/element 1 r) (erlang/element 2 r)))
      (erlang/== kd :decimal)
      (let [u (BeamLisp.Decimal/unscaled x)
            s (BeamLisp.Decimal/scale x)]
        (cond
          (erlang/== s 0) (tuple2 u 1)
          (erlang/< s 0) (tuple2 (erlang/* u (pow10 (erlang/- 0 s))) 1)
          :else (reduce-ratio u (pow10 s))))
      :else (number-refuse x :not-a-finite-number))))

(defn number-num-cmp
  "Three-way compare of two finite numbers on their EXACT rational values, by
   cross-multiplication. Exact for arbitrary precision integers and identical
   for every int/float/decimal triple, so the order is transitive."
  [a b]
  (let [ra (ratio a) rb (ratio b)
        l (erlang/* (erlang/element 1 ra) (erlang/element 2 rb))
        r (erlang/* (erlang/element 1 rb) (erlang/element 2 ra))]
    (cond
      (erlang/< l r) -1
      (erlang/> l r) 1
      :else 0)))

(defn number-num-key
  "The canonical hash key of a finite number: `{:num, numerator, denominator}`
   over the same reduced rational `num-cmp` orders by. Hence equal numbers
   always produce equal keys. (Keys are canonical, NOT injective: a lookup must
   still compare values, and an order-preserving codec is a separate, unimplemented
   concern — see rt.key.)"
  [x]
  (let [r (ratio x)]
    (tuple3 :num (erlang/element 1 r) (erlang/element 2 r))))


;; ════ rt.eq ════════════════════════════════════════════════════════════════════
; rt/eq.bl — equality and ordering, from ONE comparison.
;
; The claim this file makes: if `=` is defined as `(compare a b) == 0` and
; `compare` is one function over one classifier, then "= and compare disagree"
; stops being a bug you can have. It becomes a property of the code.
;
; The current runtime has two independent implementations. `RT.eqv/2` is a
; `cond` over type predicates; `RT.compare/2` is a `rank/1` table plus
; `cmp_same/2` plus Erlang's own term order. BUG-018 was found because the two
; disagreed about tuples; BUG-019 is the same defect one type family up.
;
; POLICY. Comparison is by SEMANTIC FAMILY, not by kind (`rt.kind/family`).
; This prototype deliberately chooses a NEW policy (NATIVE-PLAN §3-4), not the
; production compatibility policy:
;
;   * `:sequential` — list, vector and lazy seq are ONE value family. Two of
;     them are equal when their elements are equal, element by element, stopping
;     at the first difference. A lazy seq is realised only as far as the walk
;     reaches; it is never eagerly realised. Equal INFINITE sequences do not
;     terminate, which is the honest cost of streaming equality.
;   * `:number` — int, float and decimal are one numeric family, compared on
;     their EXACT rational value (`rt.number/ratio`): a float by its IEEE value
;     (`Float.ratio/1`), a decimal by unscaled/10^scale, an int as n/1. The
;     comparison is cross-multiplication, exact for arbitrary precision
;     integers. `Num.cmp/2` is NOT consulted and the shortest decimal that
;     round-trips (`Decimal.from_float`) is NOT used: `0.1` and `0.1M` are
;     different numbers, the honest reading and the only one transitive beside a
;     large float integer.
;   * `:set` — set and sorted-set are equal when they hold the same elements;
;     `:map` — map and sorted-map when they hold the same entries. Sortedness is
;     a storage property, not part of a value's identity.
;   * `:record` — a record equals only a record of the SAME type with equal
;     fields (Clojure's rule); a record is not a plain map. The fields are ALL
;     the map's keys except `__struct__`, so a key assoc'd onto the record after
;     construction is part of its value — `Record.fields_of` alone would
;     silently drop it.
;   * `:tuple` — data tuples compare by ARITY first, then element-wise, matching
;     Erlang and the datom codec (BUG-005). A tuple is not a vector.
;   * metadata is ignored wherever it can ride: a vector's `:meta` never reaches
;     the walk, and a `{:meta form m}` reader wrapper compares as its `form`
;     (recursively), so a wrapper and the bare value it wraps are ONE value.
;   * identities (`fn`/`blfn`/`remote`/`pid`/`port`/`ref`/`reduced`) and opaque
;     values (`macro`/`protocol`/`transient`/`deftype`/`reify`/unknown structs)
;     have no value order, so they fall back to Erlang's TOTAL term order — never
;     a silent 0, which is what BUG-018 was. Two distinct functions now compare
;     -1 and 1 in the two directions, not 1 and 1.
;
; Construction uses `rt.raw` (raw cons/tuple) and BIFs only; the file
; imports nothing from the runtime it classifies.



(declare k-compare)

;; ── shared constants and helpers ───────────────────────────────────────────
; `[]`, built once. A proper list walk ends here, and comparing against this is
; O(1) — where `(length xs)` in the loop condition would make every walk
; quadratic on exactly the vector sizes P0 asks about.
; The empty list is a READER LITERAL here, not a `def`: a `def` VALUE has no
; link row (it has no arity), so each reference would cost two `BeamLisp.Env`
; lookups — and this file references it inside per-element loops.

(defn- erlang-order [a b]
  (cond
    (erlang/== a b) 0
    (erlang/< a b) -1
    :else 1))

;; ── numbers ────────────────────────────────────────────────────────────────
; All three numeric kinds project to ONE exact rational (`rt.number/ratio`) and
; compare by cross-multiplication, so an int, a float and a decimal share one
; order — including at the 2^53 boundary, where the float's rounding and the
; integer part company. See rt.number for the projection and the proof.
(defn- eq-num-cmp [a b] (number-num-cmp a b))

;; ── sequences ──────────────────────────────────────────────────────────────
; `finite-list` materialises a finite sequence ONCE. It is only used when
; neither operand is lazy (or after a lazy walk has already excluded that), so
; this is not an eager realisation of a lazy value — those go through walk-cmp.
(defn- finite-list [x]
  (let [kd (kind-kind x)]
    (cond
      (erlang/== kd :list) x
      (erlang/== kd :vector) (BeamLisp.Vector/to_list x)
      (erlang/== kd :tuple) (erlang/tuple_to_list x)
      :else (k-to-list x))))

; A proper list ends at (). `is_list/1` is true for improper lists too, so
; this also separates `[1 2 | lazy]` (which walk-cmp must handle) from data.
(defn- proper? [xs]
  (cond
    (erlang/== xs ()) true
    (erlang/is_list xs) (proper? (erlang/tl xs))
    :else false))

(defn- step-cmp
  "The distance between two ELEMENTS — 0, -1 or 1 — or nil when the fast path
   cannot PROVE an answer and the full comparison must decide.

   This exists because `k-compare` is the wrong thing to call once per element.
   Measured, per element: a call into `k-compare` costs `unwrap-meta` twice,
   `kind` twice and `family` twice — 1.5–2.2us — and `family` alone measures
   459–607ns. Almost every step of a real walk is one of five cases that need
   none of it: the elements are identical, or both are integers, atoms, binaries
   or floats, where the BEAM's own term order IS the semantic order.

   SOUNDNESS: every clause returns only a decision it can prove; `nil` means
   defer. Nothing is approximated. The deferring cases are exactly where
   representation and value come apart — a number against a number of a
   different representation (`1` vs `1.0` vs `1M`), NaN, metadata wrappers, and
   any pair from different families — and those reach `k-compare`, the authority.
   Floats compare both directions and defer when neither holds, which is what NaN
   needs."
  [a b]
  (cond
    (erlang/== a b) 0
    (and (erlang/is_integer a) (erlang/is_integer b))
    (cond (erlang/< a b) -1 :else 1)
    (and (erlang/is_atom a) (erlang/is_atom b))
    (cond (erlang/< a b) -1 :else 1)
    (and (erlang/is_binary a) (erlang/is_binary b))
    (cond (erlang/< a b) -1 :else 1)
    (and (erlang/is_float a) (erlang/is_float b) (erlang/< a b)) -1
    (and (erlang/is_float a) (erlang/is_float b) (erlang/< b a)) 1
    :else nil))

(defn- element-cmp
  "One step of a walk: the provable answer, or the full comparison."
  [a b]
  (let [c (step-cmp a b)]
    (cond (erlang/== c nil) (k-compare a b) :else c)))

(declare walk-cmp)

(defn- list-cmp
  "Cons-walking comparison. A cell whose TAIL is not a list — a cons onto a lazy
   seq, what `interpose`/`interleave` build — hands the rest of both walks to
   `walk-cmp`, which realises one cell at a time; `erlang/hd` on the lazy tail
   was the crash ((= (interpose :x [1 2 3]) '(1 :x 2 :x 3)), wave25).

   `()` is bound to a LOCAL before the loop on purpose. A reference to a
   namespace `def` is resolved through `BeamLisp.Env` — measured with eprof, as
   `atomics:get/2` plus `persistent_term:get/2` per reference, ~0.4us. Referencing
   it inside the loop cost 2 lookups per element, which was the whole of the
   ~380ns/element the comparison step could not otherwise account for: 2000 env
   lookups for a 1000-element walk. One lookup for the walk instead."
  [xs ys]
  (let [e0 ()]
    (loop [xs xs ys ys]
      (cond
        (erlang/== xs e0) (cond (erlang/== ys e0) 0 :else -1)
        (erlang/== ys e0) 1
        (or (erlang/== false (erlang/is_list xs)) (erlang/== false (erlang/is_list ys)))
          (walk-cmp xs ys)
        :else (let [c (element-cmp (erlang/hd xs) (erlang/hd ys))]
                (cond (erlang/== c 0) (recur (erlang/tl xs) (erlang/tl ys))
                      :else c))))))

; The lazy walk: realise one cell at a time, stop at the first difference.
(defn- walk-cmp [a b]
  (loop [xs (k-seq a) ys (k-seq b)]
    (cond
      (erlang/== xs nil) (cond (erlang/== ys nil) 0 :else -1)
      (erlang/== ys nil) 1
      :else (let [c (element-cmp (k-first xs) (k-first ys))]
              (cond (erlang/== c 0) (recur (k-next xs) (k-next ys))
                    :else c)))))

(defn- vec-cmp
  "Two vectors: convert through the HOST representation, then use the list walk.

   This looks like the realization that A1 removed, and the difference is worth
   stating: A1 removed `finite-list`, which built lists with the RUNTIME's own
   `cons` at ~700 ns per element — two full copies, to answer a question usually
   decided by the first element. `BeamLisp.Vector/to_list` is a host function
   over the vector's own items, an order of magnitude cheaper than the element it
   feeds, and it lands the comparison on `list-cmp`, which walks cons cells with
   `hd`/`tl` — 22 ns per element, against 90 for stepping a vector through the
   seq protocol (measured: the step is k-first+k-next, two calls and a
   classification each, and it DOMINATES the comparison — the comparison logic
   adds 7 ns on top of it).

   The order is unchanged: the elements come out in the same sequence, and
   `list-cmp` is the same element-by-element comparison."
  [a b]
  (list-cmp (BeamLisp.Vector/to_list a) (BeamLisp.Vector/to_list b)))

(defn- seq-cmp
  "Two sequences.

   LISTS walk cons cells; VECTORS convert once through the host representation
   and take the same list path; anything else (lazy, sets, tuples) is walked in
   place by `walk-cmp`. The prototype realised EVERYTHING into lists first and
   then walked the copies, which is why a comparison differing at the FIRST
   element cost 70% of one differing at the last (400us against 1.39ms for 1000
   elements). That is gone; what remains is the one conversion that pays for
   itself."
  [a b]
  (cond
    (erlang/== (kind-kind a) :lazy) (walk-cmp a b)
    (erlang/== (kind-kind b) :lazy) (walk-cmp a b)
    (and (kind-vector? a) (kind-vector? b)) (vec-cmp a b)
    (and (erlang/is_list a) (erlang/is_list b)) (list-cmp a b)
    :else (walk-cmp a b)))

;; ── unordered collections ──────────────────────────────────────────────────
; Insertion sort. O(n^2) on the collection size; enough for the finite
; collections this prototype compares, and it compares WHOLE elements, which the
; first prototype did not: keying on `(first entry)` made every scalar element's
; key `nil`, so a set was never actually ordered and could not equal its sorted
; sibling. Sorting both operands by the same total order makes unordered
; equality order-insensitive.
(defn- insert-entry [sorted e]
  (cond
    (erlang/== sorted ()) (k-cons e (k-empty-list))
    :else (let [h (erlang/hd sorted)]
            (cond
              (erlang/< 0 (k-compare h e)) (k-cons e sorted)
              :else (k-cons h (insert-entry (erlang/tl sorted) e))))))

(defn- sort-elems [es]
  (loop [acc (k-empty-list) rest es]
    (cond
      (erlang/== rest ()) acc
      :else (recur (insert-entry acc (erlang/hd rest)) (erlang/tl rest)))))

(defn- coll-cmp [a b]
  (let [ca (k-count a) cb (k-count b)]
    (cond
      (erlang/== ca cb) (seq-cmp (sort-elems (k-to-list a)) (sort-elems (k-to-list b)))
      (erlang/< ca cb) -1
      :else 1)))

;; ── records ────────────────────────────────────────────────────────────────
; A record's identity includes its type. Two records of different types are
; never equal even with identical fields; a record is never equal to a plain map
; (which `:map` handles alone). The fields are every map key except `__struct__`
; — NOT `Record.fields_of`, which names only the declared fields and would let a
; key assoc'd after construction ride invisibly.
(defn- eq-record-fields [r]
  (loop [acc (k-empty-list)
         ps (erlang/apply :maps :to_list (raw-cons r (empty-list)))]
    (cond
      (erlang/== ps ()) acc
      :else
      (let [pr (erlang/hd ps)
            f (erlang/element 1 pr)]
        (cond
          (erlang/== f :__struct__) (recur acc (erlang/tl ps))
          :else (recur (k-cons (seq-entry f (erlang/element 2 pr)) acc)
                       (erlang/tl ps)))))))

(defn- record-cmp [a b]
  (let [ma (erlang/map_get :__struct__ a) mb (erlang/map_get :__struct__ b)]
    (cond
      (erlang/== ma mb) (seq-cmp (sort-elems (eq-record-fields a)) (sort-elems (eq-record-fields b)))
      :else (erlang-order ma mb))))

;; ── tuples ─────────────────────────────────────────────────────────────────
; Arity first, then element-wise — Erlang's rule and the datom codec's.
(defn- tuple-cmp [a b]
  (let [sa (erlang/tuple_size a) sb (erlang/tuple_size b)]
    (cond
      (erlang/< sa sb) -1
      (erlang/> sa sb) 1
      :else (seq-cmp a b))))

;; ── family dispatch ────────────────────────────────────────────────────────
(defn- same-family [fam a b]
  (cond
    (erlang/== fam :nil) 0
    (erlang/== fam :bool) (cond (erlang/== a b) 0 (erlang/== a true) 1 :else -1)
    (erlang/== fam :number) (eq-num-cmp a b)
    (erlang/== fam :text) (erlang-order a b)
    (erlang/== fam :atom) (erlang-order a b)
    (erlang/== fam :symbol) (erlang-order (erlang/element 2 a) (erlang/element 2 b))
    (erlang/== fam :sequential) (seq-cmp a b)
    (erlang/== fam :set) (coll-cmp a b)
    (erlang/== fam :map) (coll-cmp a b)
    (erlang/== fam :record) (record-cmp a b)
    (erlang/== fam :tuple) (tuple-cmp a b)
    (erlang/== fam :meta) (k-compare (erlang/element 2 a) (erlang/element 2 b))
    :else (erlang-order a b)))

(defn- family-rank [fam]
  (cond
    (erlang/== fam :nil) 0
    (erlang/== fam :bool) 1
    (erlang/== fam :number) 2
    (erlang/== fam :text) 3
    (erlang/== fam :symbol) 4
    (erlang/== fam :atom) 5
    (erlang/== fam :sequential) 6
    (erlang/== fam :set) 7
    (erlang/== fam :map) 8
    (erlang/== fam :record) 9
    (erlang/== fam :tuple) 10
    (erlang/== fam :meta) 11
    (erlang/== fam :identity) 12
    :else 13))

(defn rank
  "The rank of a KIND's family. Kept kind-indexed because the first prototype's
   `rank` took a kind; the policy table is `family-rank`."
  [kd]
  (family-rank (kind-family kd)))

(defn- unwrap-meta
  "A `{:meta form m}` reader wrapper is `form` carrying metadata: unwrap it —
   and any wrapper nested inside — so comparison never sees the wrapper. (A
   vector struct's `:meta` is a different carrier: its kind stays `:vector` and
   the field never reaches the walk.)"
  [x]
  (cond
    (erlang/== (kind-kind x) :meta) (unwrap-meta (erlang/element 2 x))
    :else x))

(defn k-compare
  "A total order over every value the language can hold. Metadata wrappers are
   unwrapped first, so a wrapper and the bare value it wraps compare equal. Two
   values of the same family compare INSIDE that family (so a vector and a list
   with equal elements are 0); different families compare by `family-rank`,
   which is injective, so a cross-family pair is never 0 and the order is
   antisymmetric and total."
  [a b]
  (cond
    ; IDENTITY IS DISTANCE ZERO — and it is a term compare, so the BEAM answers
    ; it from the type tags without walking one element of a collection.
    ; Measured before this clause existed: comparing a 1000-element vector with
    ; ITSELF took 1.52 ms against the Elixir runtime's 11 ns (137 810x), because
    ; the walk re-derived what the term was already saying. Reflexivity is not a
    ; heuristic here — a value compared with itself IS zero under this order,
    ; including NaN, whose equality is false but whose position is fixed.
    (erlang/== a b) 0

    ; THE SAME IDEA, ONE LEVEL DOWN. For a pair whose representation IS its
    ; value, the BEAM's own term order answers the semantic question and the
    ; whole classify-then-dispatch chain is unnecessary. This is the top-level
    ; twin of `step-cmp` in the walk, and it matters because `compare` is called
    ; once per SORT COMPARISON, not once per operation.
    ;
    ; Deferring, not approximating: every clause below is an exact correspondence
    ; (integers order by value, binaries by term order, floats by value), and a
    ; pair that is not covered falls through to the full comparison. Atoms are
    ; deliberately NOT here — `nil` and the booleans are atoms too, and they sit
    ; in different FAMILIES from a keyword, so the term order would answer a
    ; cross-family question that `family-rank` owns.
    (and (erlang/is_integer a) (erlang/is_integer b))
    (cond (erlang/< a b) -1 :else 1)
    (and (erlang/is_binary a) (erlang/is_binary b))
    (cond (erlang/< a b) -1 :else 1)
    (and (erlang/is_float a) (erlang/is_float b) (erlang/< a b)) -1
    (and (erlang/is_float a) (erlang/is_float b) (erlang/< b a)) 1

    :else
    (let [a (unwrap-meta a)
          b (unwrap-meta b)
          fa (kind-family (kind-kind a)) fb (kind-family (kind-kind b))]
      (cond
        (erlang/== fa fb) (same-family fa a b)
        (erlang/< (family-rank fa) (family-rank fb)) -1
        :else 1))))

(defn k-eqv
  "`=`. Defined by the order, so these can never disagree — with ONE documented
   exception: two DECIMALS are equal only when they are the same VALUE, scale
   included. `(= 1.5M 1.50M)` is false and `(== 1.5M 1.50M)` true, exactly as
   `equals` and `compareTo` differ on the JVM (docs/exact-decimals.bl.md, the
   Java oracle row `(.equals 1.0M 1.00M)`). The order still places them
   together; `=` asks the stricter question."
  [a b]
  (cond
    ; THE LEAF FAST PATH. `=` is the most-called predicate in the language —
    ; `nil?`, `some?`, `not=` and every `(= k (:id e))` reach it — and the
    ; general answer below costs `unwrap-meta`, `kind` and `family` per side
    ; (~40 reductions) to say what one term test already knows. Each clause is
    ; an EXACT correspondence with `k-compare`, never an approximation:
    ;   * identical terms are distance 0 (k-compare's own first clause; a
    ;     decimal pair that is =:= is the same value, scale included);
    ;   * an atom (nil, a boolean, a keyword) is only ever equal to itself or
    ;     to a `{:meta …}` wrapper of itself — no struct, number, string,
    ;     list or map shares an atom's family — so an atom against anything
    ;     but a TUPLE is decided here, and the tuple case (a possible wrapper)
    ;     defers to the full comparison.
    (erlang/=:= a b) true
    (erlang/is_atom a) (cond (erlang/is_tuple b) (erlang/== 0 (k-compare a b)) :else false)
    (erlang/is_atom b) (cond (erlang/is_tuple a) (erlang/== 0 (k-compare a b)) :else false)
    (and (struct-of? a :"Elixir.BeamLisp.Decimal") (struct-of? b :"Elixir.BeamLisp.Decimal"))
      (erlang/=:= a b)
    :else (erlang/== 0 (k-compare a b))))


;; ════ rt.coll ══════════════════════════════════════════════════════════════════
; rt/coll.bl — collection operations dispatched on representation.



;; ── helpers ────────────────────────────────────────────────────────────────

(defn- coll-entry [kk v]
  (BeamLisp.Vector/new (raw-cons kk (raw-cons v ()))))

(defn- coll-hash-key [k]
  "The hash boundary, asked once: hashing must strip metadata, or `(= a b)` is
   true while `{a :x}` cannot find `b`. The implementation belongs to rt.hash and
   is not duplicated here — this used to forward to the HOST runtime's
   `hash_key`, the module this cutover deletes (and the forwarder is named in
   prose nowhere else on purpose: `gap.bl` scans for that module's name and
   cannot tell a call from a docstring)."
  (hash-hash-key k))

;; ── GET ────────────────────────────────────────────────────────────────────

(defn coll-get
  "RT's `get/3`, clause for clause. A vector is a struct and so also a map —
   index access is decided before any map clause. A transient map reads through
   to its live state (`frequencies`/`group-by` do `(get transient k d)`). A
   reference type REFUSES: it is not a collection. Anything that is not a
   lookup target answers the default, never an error."
  ([m key] (coll-get m key nil))
  ([m key default]
   (let [kd (kind-kind m)]
     (cond
       (erlang/== kd :vector) (BeamLisp.Vector/nth m key)
       (erlang/== kd :map) (maps/get (coll-hash-key key) m default)
       (erlang/== kd :nil) default
       (erlang/== kd :set) (cond (BeamLisp.Set/member? m key) key :else default)
       (erlang/== kd :sorted-map) (BeamLisp.Sorted/map_get m key default)
       (erlang/== kd :sorted-set) (cond (BeamLisp.Sorted/set_member? m key) key :else default)
       (erlang/== kd :transient)
         (cond (erlang/== :map (erlang/element 2 m)) (BeamLisp.Transient/get m key default)
               :else default)
       (erlang/== kd :record)
         (cond (erlang/== key :__struct__) default :else (maps/get key m default))
       (erlang/== kd :ref-cell)
         (raise-argument (erlang/iolist_to_binary
                           `("get: " ~(Elixir.Kernel/inspect (erlang/map_get :__struct__ m))
                             " is a reference, not a collection")))
       (and (erlang/is_map m) (erlang/is_atom (maps/get :__struct__ m nil)))
         (maps/get key m default)
       :else default))))

;; ── CONJ ───────────────────────────────────────────────────────────────────

(defn- bad-map-entry [entry n]
  (raise-argument (erlang/iolist_to_binary
                    `("conj on a map takes a two-element entry, got " ~(erlang/integer_to_binary n)
                      " elements: " ~(print-print-str entry)))))

(defn- entry-kv
  "A `[k v]` map entry as `{k, v}`: a 2-vector, a 2-list or a 2-tuple — or nil."
  [e]
  (cond
    (and (struct-of? e :"Elixir.BeamLisp.Vector") (erlang/== 2 (BeamLisp.Vector/count e)))
      (tuple2 (BeamLisp.Vector/nth e 0) (BeamLisp.Vector/nth e 1))
    (and (erlang/is_list e) (erlang/=/= e ()) (erlang/is_list (erlang/tl e)) (erlang/=/= (erlang/tl e) ())
         (erlang/== (erlang/tl (erlang/tl e)) ()))
      (tuple2 (erlang/hd e) (erlang/hd (erlang/tl e)))
    :else nil))

(defn coll-conj
  "RT's `conj/2`, clause for clause: prepend to a list, append to a vector,
   add to a set, put a `[k v]` entry into a map. A value that has no conj — a
   reference, a non-entry into a map — refuses rather than growing a struct."
  ([x] x)
  ([x v]
   (let [kd (kind-kind x)]
     (cond
       (erlang/== kd :nil) (raw-cons v ())
       (erlang/== kd :list) (raw-cons v x)
       (erlang/== kd :vector) (BeamLisp.Vector/conj x v)
       (erlang/== kd :lazy) (raw-cons v x)
       (erlang/== kd :set) (BeamLisp.Set/add x v)
       (erlang/== kd :sorted-set) (BeamLisp.Sorted/set_add x v)
       (erlang/== kd :sorted-map)
         (let [kv (entry-kv v)]
           (cond (erlang/=/= kv nil)
                   (BeamLisp.Sorted/map_put x (erlang/element 1 kv) (erlang/element 2 kv))
                 :else (raise-argument (erlang/iolist_to_binary
                                         `("conj on a sorted map expects a [k v] entry, got: " ~(Elixir.Kernel/inspect v))))))
       (erlang/== kd :ref-cell)
         (raise-argument (erlang/iolist_to_binary
                           `("conj: " ~(Elixir.Kernel/inspect (erlang/map_get :__struct__ x)) " is a reference, not a collection")))
       (erlang/== kd :map)
         (cond
           (and (erlang/is_tuple v) (erlang/== 2 (erlang/tuple_size v)))
             (maps/put (coll-hash-key (erlang/element 1 v)) (erlang/element 2 v) x)
           (erlang/=/= nil (entry-kv v))
             (let [kv (entry-kv v)] (maps/put (coll-hash-key (erlang/element 1 kv)) (erlang/element 2 kv) x))
           (erlang/is_list v) (bad-map-entry v (erlang/length v))
           (struct-of? v :"Elixir.BeamLisp.Vector") (bad-map-entry v (BeamLisp.Vector/count v))
           ; a scalar is not an entry of any length: RT had no clause for it
           :else (erlang/error (Elixir.FunctionClauseError/exception
                                 `(~(tuple2 :module :"Elixir.BeamLisp.Ns.Rt") ~(tuple2 :function :conj) ~(tuple2 :arity 2)))))
       ; RT: a struct accepts a [k v] ENTRY — a record adds it, any other
       ; struct refuses by name; a non-entry has no clause at all
       (erlang/== kd :record)
         (let [kv (entry-kv v)]
           (cond (erlang/=/= kv nil) (maps/put (erlang/element 1 kv) (erlang/element 2 kv) x)
                 :else (erlang/error (Elixir.FunctionClauseError/exception
                                 `(~(tuple2 :module :"Elixir.BeamLisp.Ns.Rt") ~(tuple2 :function :conj) ~(tuple2 :arity 2))))))
       (and (erlang/is_map x) (erlang/is_atom (maps/get :__struct__ x nil)))
         (cond (erlang/=/= nil (entry-kv v)) (raise-argument "conj with a map entry is not supported on a struct")
               :else (erlang/error (Elixir.FunctionClauseError/exception
                                 `(~(tuple2 :module :"Elixir.BeamLisp.Ns.Rt") ~(tuple2 :function :conj) ~(tuple2 :arity 2)))))
       ; a string, a number, a fn: RT had no conj clause for them
       :else (erlang/error (Elixir.FunctionClauseError/exception
                             `(~(tuple2 :module :"Elixir.BeamLisp.Ns.Rt") ~(tuple2 :function :conj) ~(tuple2 :arity 2))))))))

;; ── CONTAINS? ──────────────────────────────────────────────────────────────

(defn coll-contains? [coll key]
  (let [kd (kind-kind coll)]
    (cond
      (erlang/== kd :vector) (and (erlang/is_integer key) (erlang/>= key 0) (erlang/< key (BeamLisp.Vector/count coll)))
      (erlang/== kd :set) (BeamLisp.Set/member? coll key)
      (erlang/== kd :sorted-set) (BeamLisp.Sorted/set_member? coll key)
      (erlang/== kd :sorted-map) (BeamLisp.Sorted/map_has_key? coll key)
      (erlang/== kd :ref-cell)
        (raise-argument (erlang/iolist_to_binary
                          `("contains?: " ~(Elixir.Kernel/inspect (erlang/map_get :__struct__ coll)) " is a reference, not a collection")))
      (erlang/== kd :record) (cond (erlang/== key :__struct__) false :else (erlang/is_map_key key coll))
      (erlang/== kd :map) (erlang/is_map_key (coll-hash-key key) coll)
      :else false)))

;; ── ASSOC ──────────────────────────────────────────────────────────────────

(defn coll-assoc
  "RT's `assoc/3`, clause for clause. A set and a reference REFUSE (assoc would
   add a field to the struct); a record refuses its internal `:__struct__` key."
  [coll key val]
  (let [kd (kind-kind coll)]
    (cond
      (erlang/== kd :vector) (BeamLisp.Vector/assoc coll key val)
      (erlang/== kd :set) (raise-argument "assoc not supported on a set")
      (erlang/== kd :sorted-map) (BeamLisp.Sorted/map_put coll key val)
      (erlang/== kd :sorted-set) (raise-argument "assoc not supported on a sorted set")
      (erlang/== kd :ref-cell)
        (raise-argument (erlang/iolist_to_binary
                          `("assoc: " ~(Elixir.Kernel/inspect (erlang/map_get :__struct__ coll)) " is a reference, not a collection")))
      (erlang/== kd :record)
        (cond (erlang/== key :__struct__)
                (raise-argument "assoc on the internal :__struct__ key is not allowed on a record")
              :else (maps/put key val coll))
      (erlang/== kd :map) (maps/put (coll-hash-key key) val coll)
      (erlang/== kd :nil) (maps/put (coll-hash-key key) val (maps/new))
      (and (erlang/is_map coll) (erlang/is_atom (maps/get :__struct__ coll nil)))
        (cond (erlang/== key :__struct__) (maps/put key val coll)
              :else (raise-argument "assoc not supported on a struct"))
      :else (erlang/error (Elixir.FunctionClauseError/exception
                            `(~(tuple2 :module :"Elixir.BeamLisp.Ns.Rt") ~(tuple2 :function :assoc) ~(tuple2 :arity 3)))))))

(defn coll-assoc-variadic [coll key val rest]
  (cond (erlang/=/= 0 (erlang/rem (erlang/length rest) 2))
          (raise-argument "assoc expects an even number of key/value arguments")
        :else nil)
  (loop [acc (coll-assoc coll key val) ks rest]
    (cond
      (erlang/== ks ()) acc
      :else
      (let [k (erlang/hd ks)
            v (erlang/hd (erlang/tl ks))
            ks2 (erlang/tl (erlang/tl ks))]
        (recur (coll-assoc acc k v) ks2)))))

;; ── FIND ───────────────────────────────────────────────────────────────────

(defn coll-find [m key]
  (let [kd (kind-kind m)]
    (cond
      (erlang/== kd :ref-cell) (no-clause "find" 2 m)
      (erlang/== kd :sorted-map)
      (cond (BeamLisp.Sorted/map_has_key? m key)
            (coll-entry key (BeamLisp.Sorted/map_get m key nil))
            :else nil)
      (erlang/== kd :record)
      (cond (erlang/== key :__struct__) nil
            (erlang/is_map_key key m) (coll-entry key (maps/get key m))
            :else nil)
      (erlang/== kd :map)
      (let [hk (coll-hash-key key)]
        (cond (erlang/is_map_key hk m) (coll-entry key (maps/get hk m))
              :else nil))
      :else nil)))

;; ── SET ────────────────────────────────────────────────────────────────────

(defn coll-set [coll]
  (let [kd (kind-kind coll)]
    (cond
      (erlang/== kd :set) coll
      :else (BeamLisp.Set/new (k-to-list (k-seq coll))))))

;; ── DISJ ───────────────────────────────────────────────────────────────────

(defn coll-disj [coll elem]
  (let [kd (kind-kind coll)]
    (cond
      (erlang/== kd :set) (BeamLisp.Set/del coll elem)
      (erlang/== kd :sorted-set) (BeamLisp.Sorted/set_del coll elem)
      :else coll)))

;; ── PEEK ───────────────────────────────────────────────────────────────────

(defn coll-peek [coll]
  (let [kd (kind-kind coll)]
    (cond
      (erlang/== kd :vector)
      (let [xs (BeamLisp.Vector/to_list coll)]
        (cond (erlang/== xs ()) nil
              :else (erlang/apply :lists :last (raw-cons xs ()))))
      (erlang/== kd :nil) nil
      ; an ordered collection is not a STACK: `(peek sorted-set)` answering the
      ; smallest element would be a different operation wearing the same name
      (erlang/== kd :sorted-set) (raise-argument "peek: a sorted set is not a stack (use first / last-key)")
      (erlang/== kd :sorted-map) (raise-argument "peek: a sorted map is not a stack (use first / last-entry)")
      :else (k-first coll))))

;; ── POP ────────────────────────────────────────────────────────────────────

(defn coll-pop [coll]
  (let [kd (kind-kind coll)]
    (cond
      (erlang/== kd :vector)
      (let [xs (BeamLisp.Vector/to_list coll)]
        (cond (erlang/== xs ()) (raise-argument "Can't pop empty vector")
              :else (BeamLisp.Vector/new (erlang/apply :lists :droplast (raw-cons xs ())))))
      (erlang/== kd :list)
      (cond (erlang/== coll ()) (raise-argument "Can't pop empty list")
            :else (erlang/tl coll))
      (erlang/== kd :nil) (raise-argument "Can't pop empty list")
      (erlang/== kd :sorted-set) (raise-argument "pop: a sorted set is not a stack (use disj)")
      (erlang/== kd :sorted-map) (raise-argument "pop: a sorted map is not a stack (use dissoc)")
      :else (k-rest coll))))

;; ── LAST-KEY ──────────────────────────────────────────────────────────────

(defn coll-last-key [coll]
  (let [kd (kind-kind coll)]
    (cond
      (erlang/== kd :sorted-map) (BeamLisp.Sorted/last_key coll)
      (erlang/== kd :sorted-set) (BeamLisp.Sorted/last_key coll)
      :else nil)))

;; ── LAST-ENTRY ────────────────────────────────────────────────────────────

(defn coll-last-entry [coll]
  (let [kd (kind-kind coll)]
    (cond
      (erlang/== kd :sorted-map)
      (let [e (BeamLisp.Sorted/last_entry coll)]
        (cond (erlang/== e nil) nil
              :else (coll-entry (erlang/element 1 e) (erlang/element 2 e))))
      :else nil)))

;; ── CONCAT ─────────────────────────────────────────────────────────────────
; `concat` is a LAZY sequence producer, so it lives in rt.lazy beside `map` and
; `range` — it used to be a one-line forwarder to `BeamLisp.Ns.Rt/concat`, the
; module this cutover deletes.

;; ── SORT ───────────────────────────────────────────────────────────────────

(defn- comparator-le
  "Bridge a Clojure comparator to `:lists.sort`'s `a =< b` contract.

   A boolean result is used directly — `true` means \"a before b\", which is
   exactly a `<`-style predicate. A number means `=< 0`. Anything else is
   `false`, which is RT's own fallback and not an accident: every non-number term
   (atom, tuple, pid, list, map, binary) is GREATER than every number in Erlang's
   term order, so `result =< 0` is false for all of them.

   Without the boolean case `(sort > coll)` silently mis-sorts: `true =< 0` is
   false for every pair, so nothing orders. That is the fidelity gap RT's own
   comment records against `(sort-by val > freqs)`."
  [r]
  (cond
    (erlang/is_boolean r) r
    (erlang/is_number r) (erlang/=< r 0)
    :else false))

(defn coll-sort
  "`(sort coll)` / `(sort comp coll)` — a stable sorted list.

   `comp` may be a 3-way comparator (returns a number, like `compare`) or a
   boolean predicate (like `<`), which is Clojure's contract for both `sort` and
   `sort-by`."
  ([coll]
   (let [xs (k-to-list (k-seq coll))
         le (fn [a b] (erlang/=< (k-compare a b) 0))]
     (erlang/apply :lists :sort (raw-cons le (raw-cons xs ())))))
  ([comp coll]
   (let [xs (k-to-list (k-seq coll))
         ; a plain 2-arity fun is called directly: `call-invoke` would build an
         ; argument list per comparison only to apply the same fun to it
         le (cond
              (erlang/is_function comp 2) (fn [a b] (comparator-le (comp a b)))
              :else (fn [a b]
                      (comparator-le (call-invoke comp (raw-cons a (raw-cons b ()))))))]
     (erlang/apply :lists :sort (raw-cons le (raw-cons xs ()))))))


;; ════ rt.key ═══════════════════════════════════════════════════════════════════
; rt/key.bl — the finite semantic key projection: a CANONICAL HASH KEY.
;
; WHAT THIS IS. `semantic-key` maps a value to a portable term such that EQUAL
; values (under `rt.eq/k-eqv`) always map to EQUAL keys:
;
;   (= a b)  =>  (= (semantic-key a) (semantic-key b))
;
; That implication is the whole contract. It is what a hash table, a datom key
; or a set membership test needs to be reproducible across VM images. It is NOT
; an order-preserving encoding: key order carries NO meaning, and this file does
; not provide an ordinal codec. `BeamLisp.Sorted.encode_key/1` — the production
; ORDER-PRESERVING encoder — has NO counterpart here; an ordinal codec over the
; semantic family policy is UNIMPLEMENTED and is a separate piece of work.
;
; NOT INJECTIVE, AND THAT IS LOAD-BEARING. Keys are canonical, not unique: the
; converse of the implication above is NOT promised, so two distinct values can
; collide on one key (as any finite projection does). A store keyed by
; `semantic-key` MUST compare the values on a collision; key equality alone is
; never value equality. `semantic-hash` inherits exactly this and says so.
;
; WHAT IS PORTABLE. A key exists only for values whose meaning survives leaving
; this VM image:
;
;   nil · booleans · keywords · text · symbols · numbers (int/float/decimal)
;   · lists · vectors · tuples · sets · maps · sorted-set/sorted-map · records
;
; METADATA IS IGNORED, recursively: a vector's `:meta` never enters the key and
; a reader wrapper `{:meta form m}` keys by `form` alone — so it keys EQUAL to
; the bare value, matching `=` and set membership.
;
; WHAT IS NOT PORTABLE, and is REFUSED rather than encoded (nested too):
;
;   * lazy sequences — a key would have to realise them, and an infinite one
;     would hang. The finite-key domain explicitly excludes them;
;   * runtime-local identities — `fn`/`blfn`/`remote`/`pid`/`port`/`ref` and the
;     `Reduced` sentinel;
;   * opaque values — `macro`/`protocol`/`transient`/`deftype`/`reify` and any
;     struct that is neither a registered representation nor a registered
;     record.
;
; Refusal is `erlang:error/1` with `{:"$krt-key/unsupported", why, value}`, so a
; caller cannot mistake a refused value for an empty key. This is deliberately
; NOT "encode everything by Erlang term order": a portable storage format and a
; runtime identity are different things, and pretending otherwise is how an
; index stops being reproducible across images (NATIVE-PLAN §4.6).
;
; NUMBERS share ONE exact rational projection with `rt.eq` (`rt.number`): a
; float by its IEEE value (`Float.ratio/1`), a decimal by unscaled/10^scale, an
; int as n/1, reduced by gcd with a positive denominator. The key is
; `{:num, numerator, denominator}`. `1`, `1.0` and `1M` all key as `{:num, 1, 1}`
; while `0.1` (the float) and `0.1M` do NOT collide — the same reading the order
; uses. The shortest decimal that round-trips (`Decimal.from_float`) is not used:
; it disagrees with the float's exact value and so disagreed with the order.
;
; MAPS AND SETS. A map's/set's key is the SORTED list of its entry keys (a map
; entry is `{key-key, value-key}`); sorting uses the same `rt.eq` order, so a
; hashed collection and its sorted sibling project to one key. The sort is a
; MULTISET sort — duplicates are preserved, never merged — so cardinality is not
; silently collapsed: `#{1 1.0}` (two distinct BEAM map keys) keys differently
; from `#{1}`. Two DIFFERENT collections can still collide on one key (the
; not-injective caveat), so a lookup must compare the values.
;
; Construction uses `rt.raw` (raw cons/tuple) and BIFs only. The
; projection is `semantic-key`, NOT `key`: an unqualified `(key x)` inside this
; namespace resolves to core's map lookup, which returns nil instead of refusing.
; The name is the contract.



(declare semantic-key)

(defn- key-refuse [x why]
  (erlang/error (tuple3 :"$krt-key/unsupported" why x)))

;; ── canonical finite lists ─────────────────────────────────────────────────
; `()` is a reader literal, not a `def`: a `def` VALUE has no link row, so each
; reference costs two `BeamLisp.Env` lookups.

(defn- insert-key [sorted k]
  (cond
    (erlang/== sorted ()) (raw-cons k (empty-list))
    :else (let [h (erlang/hd sorted)]
            (cond
              (erlang/< 0 (k-compare h k)) (raw-cons k sorted)
              :else (raw-cons h (insert-key (erlang/tl sorted) k))))))

; Insertion sort into a list. It is a MULTISET sort: a key equal to an existing
; one is placed AFTER it, never merged, so the canonical form keeps cardinality
; (two distinct elements with equal keys stay two entries).
(defn- sort-keys [ks]
  (loop [acc (empty-list) rest ks]
    (cond
      (erlang/== rest ()) acc
      :else (recur (insert-key acc (erlang/hd rest)) (erlang/tl rest)))))

; A proper list of values into a list of keys, preserving order. An improper
; list (`[1 2 | lazy]`) is refused: its tail is not a portable sequence.
(defn- key-list [lst]
  (cond
    (erlang/== lst ()) (empty-list)
    (erlang/is_list lst)
    (raw-cons (semantic-key (erlang/hd lst)) (key-list (erlang/tl lst)))
    :else (key-refuse lst :improper-sequence)))

;; ── numbers ────────────────────────────────────────────────────────────────
; The ONE exact rational projection shared with `rt.eq` (rt.number): int n/1,
; float via `Float.ratio/1`, decimal unscaled/10^scale, reduced by gcd with a
; positive denominator. `num-key` returns `{:num, numerator, denominator}`.
(defn- key-num-key [x] (number-num-key x))

;; ── entries ────────────────────────────────────────────────────────────────
(defn- entry-key [pair]
  (tuple2 (semantic-key (erlang/element 1 pair))
                         (semantic-key (erlang/element 2 pair))))

(defn- entry-keys [pairs]
  (cond
    (erlang/== pairs ()) (empty-list)
    (erlang/is_list pairs)
    (raw-cons (entry-key (erlang/hd pairs)) (entry-keys (erlang/tl pairs)))
    :else (key-refuse pairs :improper-entries)))

(defn- map-pairs [m]
  (erlang/apply :maps :to_list (raw-cons m (empty-list))))

; Every map key except `__struct__` — the declared fields AND anything assoc'd
; onto the record. `Record.fields_of` would list only the declared fields and
; drop the rest, so a record and its assoc'd sibling would collide.
(defn- field-keys [pairs]
  (cond
    (erlang/== pairs ()) (empty-list)
    :else (let [pr (erlang/hd pairs)
                f (erlang/element 1 pr)]
            (cond
              (erlang/== f :__struct__) (field-keys (erlang/tl pairs))
              :else (raw-cons
                      (tuple2 f (semantic-key (erlang/element 2 pr)))
                      (field-keys (erlang/tl pairs)))))))

;; ── the projection ─────────────────────────────────────────────────────────
(defn semantic-key
  "The portable semantic key of `x`, or a raise when `x` has none. Equal values
   (under `rt.eq/k-eqv`) always produce equal keys; the converse is NOT promised
   — a key collision is not equality, so a lookup MUST still compare values.
   Metadata is ignored everywhere, including the `{:meta form m}` wrapper, which
   keys as its `form`."
  [x]
  (let [kd (kind-kind x)]
    (cond
      (erlang/== kd :nil) (tuple2 :nil nil)
      (erlang/== kd :bool) (tuple2 :bool x)
      (erlang/== kd :atom) (tuple2 :atom (erlang/atom_to_binary x :utf8))
      (erlang/== kd :text) (tuple2 :text x)
      (erlang/== kd :symbol) (tuple2 :symbol (erlang/element 2 x))
      (erlang/== kd :int) (key-num-key x)
      (erlang/== kd :float) (key-num-key x)
      (erlang/== kd :decimal) (key-num-key x)
      (erlang/== kd :meta) (semantic-key (erlang/element 2 x))
      (erlang/== kd :list) (tuple2 :seq (key-list x))
      (erlang/== kd :vector)
      (tuple2 :seq (key-list (BeamLisp.Vector/to_list x)))
      (erlang/== kd :tuple)
      (tuple3 :tuple (erlang/tuple_size x) (key-list (erlang/tuple_to_list x)))
      (erlang/== kd :set)
      (tuple2 :set (sort-keys (key-list (BeamLisp.Set/to_list x))))
      (erlang/== kd :sorted-set)
      (tuple2 :set (sort-keys (key-list (BeamLisp.Sorted/set_to_list x))))
      (erlang/== kd :map)
      (tuple2 :map (sort-keys (entry-keys (map-pairs x))))
      (erlang/== kd :sorted-map)
      (tuple2 :map (sort-keys (entry-keys (BeamLisp.Sorted/map_to_list x))))
      (erlang/== kd :record)
      (let [mod (erlang/map_get :__struct__ x)]
        (tuple3 :record mod (sort-keys (field-keys (map-pairs x)))))
      (erlang/== kd :lazy) (key-refuse x :lazy-sequence)
      (erlang/== kd :fn) (key-refuse x :runtime-identity)
      (erlang/== kd :blfn) (key-refuse x :runtime-identity)
      (erlang/== kd :remote) (key-refuse x :runtime-identity)
      (erlang/== kd :pid) (key-refuse x :runtime-identity)
      (erlang/== kd :port) (key-refuse x :runtime-identity)
      (erlang/== kd :ref) (key-refuse x :runtime-identity)
      (erlang/== kd :reduced) (key-refuse x :runtime-identity)
      :else (key-refuse x :opaque))))

(defn semantic-hash
  "A hash of the semantic key, equal for equal values. It never establishes
   equality: two keys can collide, so a lookup must still compare the values."
  [x]
  (erlang/apply :erlang :phash2 (raw-cons (semantic-key x) (empty-list))))

(defn portable?
  "True when `semantic-key` can be computed for `x` — and, because projection
   recurses, for everything nested inside it."
  [x]
  (try
    (do (semantic-key x) true)
    (catch _e false)))


;; ════ rt.lazy ══════════════════════════════════════════════════════════════════
; rt/lazy.bl — lazy sequences and infinite iterators.
;
; Laziness is an OBSERVABLE property: a `map` must not realize its input, and
; must not lose it when something else does. `doall` FORCES and returns its
; argument; `dorun` forces and discards (returns nil). The representations are
; `BeamLisp.LazySeq` (built with `LazySeq.new/1` or `LazySeq.chain/2`) and
; ordinary lists with a lazy tail (what `cons x lazy` yields).
;
; CHUNKING: several operations batch elements into chunks (up to `chunk_size`)
; before wrapping the tail in a new thunk, so a consumer that stops early never
; realizes more than one chunk past the point it stopped. This is the shape
; `lib/beam_lisp/rt.ex`'s `lazy_map`, `lazy_filter` and `take_while_seg` use.










;; ── small list constructors ───────────────────────────────────────────────
(defn- lazy-one [x] (raw-cons x ()))
(defn- lazy-two [a b] (raw-cons a (raw-cons b ())))

;; ── invoke: call a function with arguments ────────────────────────────────
(defn- lazy-invoke
  "Apply `f` to the given arguments. Fast path: a raw Erlang fun. Fallback: the
   runtime's call-shape dispatcher, for BL multi-arity fns and other callables."
  [f args]
  (cond
    (erlang/is_function f) (erlang/apply f args)
    :else (call-invoke f args)))

(defn- lazy-invoke1
  "`(f x)`: `lazy-invoke` of one argument. A 1-arity fun is called directly —
   no argument list per element in the map/filter chunk walks."
  [f x]
  (cond
    (erlang/is_function f 1) (f x)
    :else (lazy-invoke f (raw-cons x ()))))

;; ── seqable: coerce a collection to a seqable form ────────────────────────
(defn- seqable
  "RT's `seqable/1`: the form the lazy walkers (map, filter, …) consume. A set
   and the ordered collections iterate their MEMBERS in order, a record its
   public entries; everything else passes through to `LazySeq.input`. The port
   first returned `x` unchanged, so `(map f sorted-set)` walked the struct and
   died in `hd` — found by the suite (sorted_test, examples/sorted.bl)."
  [x]
  (let [kd (kind-kind x)]
    (cond
      (erlang/== kd :nil) ()
      (erlang/== kd :set) (BeamLisp.Set/to_list x)
      (erlang/== kd :sorted-set) (BeamLisp.Sorted/set_to_list x)
      (erlang/== kd :sorted-map) (sorted-entries x)
      (erlang/== kd :record) (record-entries x)
      :else x)))

;; ── map: apply f to each element, lazily ───────────────────────────────────
(declare map-chunk lazy-map)

(defn lazy--map [f coll]
  "Map `f` over a collection lazily. The result is a lazy seq that applies `f`
   to each element as it is consumed; forcing only the prefix that is demanded."
  (lazy-map (call-prepare-callback f 1) (BeamLisp.LazySeq/input (seqable coll))))

(defn- lazy-map [f coll]
  ; The fold recipe folds the SOURCE (a cursor or list, not a memo cell), so a
  ; `count`/`reduce`/`vec` over the result pays one `f` call per element and no
  ; cell — which is what removes the captured-environment cost from the env
  ; bench rows. Forcing still goes through `BeamLisp.LazySeq/cell`, so laziness
  ; and the chunked shape are untouched.
  (BeamLisp.LazySeq/new
    (fn []
      (let [cell (BeamLisp.LazySeq/cell coll)]
        (cond
          (erlang/== nil cell) nil
          :else
          (let [h (erlang/hd cell)
                t (erlang/tl cell)
                f-h (lazy-invoke1 f h)
                chunk-size (BeamLisp.LazySeq/chunk_size)
                result (map-chunk f (raw-cons f-h ()) t (erlang/- chunk-size 1))]
            (let [acc (erlang/element 1 result)
                  rest (erlang/element 2 result)]
              (cond
                (erlang/== nil rest) (lists/reverse acc)
                :else (lists/reverse acc
                         (BeamLisp.LazySeq/new (fn [] (lazy-map f rest))))))))))
    (fn [rf init]
      (lazy-reduce-source
        (fn [acc x] (rf acc (lazy-invoke1 f x)))
        init
        coll))))

(defn- map-chunk [f acc coll n]
  "Collect up to n elements from coll, applying f to each, accumulating in
   REVERSE. Returns [reversed-accumulator rest]; rest is nil when the input
   ran out. The caller finishes the chunk ONCE (see `lazy-map`):
   `lists/reverse/1` for an exhausted chunk, `lists/reverse/2` onto the tail
   node for a continuing one, so an emitted element is consed once instead of
   twice."
  (cond
    (erlang/== n 0) (tuple2 acc coll)
    :else
    (let [cell (BeamLisp.LazySeq/cell coll)]
      (cond
        (erlang/== nil cell) (tuple2 acc nil)
        :else
        (let [h (erlang/hd cell)
              t (erlang/tl cell)
              f-h (lazy-invoke1 f h)]
          (map-chunk f (raw-cons f-h acc) t (erlang/- n 1)))))))

;; ── map-multi: map over multiple collections ───────────────────────────────
(declare lazy-multi-map)

(defn lazy-map-multi [f c1 rest-colls]
  "Map `f` over multiple collections, stopping when the shortest ends.
   Applies `f` to one element from each collection."
  (let [wrapped (lists/map (fn [c] (BeamLisp.LazySeq/input c))
                         (raw-cons c1 rest-colls))]
    (lazy-multi-map f wrapped)))

(defn- lazy-multi-map [f colls]
  (BeamLisp.LazySeq/new
    (fn []
      (let [seqs (lists/map (fn [seq]
                            (cond
                              (erlang/is_map seq)
                              (cond
                                (erlang/is_map_key :"__struct__" seq)
                                (BeamLisp.LazySeq/cell seq)
                                :else (k-seq seq))
                              :else (k-seq seq)))
                          colls)]
        (cond
          (lists/any (fn [seq] (erlang/== nil seq)) seqs)
          nil
          :else
          (let [args (lists/map (fn [seq] (erlang/hd seq)) seqs)]
            (raw-cons (lazy-invoke f args)
              (lazy-multi-map f
                (lists/map (fn [seq] (erlang/tl seq)) seqs)))))))
      ; Lockstep through the sources' CELLS — `LazySeq.cell` is the one
      ; accessor that understands a SeqCursor, a list, a vector and a lazy node
      ; alike — so the result folds without ever forming a cell of its own. The
      ; fold stops at the shortest source, as the seq walk does.
      (fn [rf init]
        (loop [acc init ss colls]
          (let [cells (lists/map (fn [s] (BeamLisp.LazySeq/cell s)) ss)]
            (cond
              (lists/any (fn [c] (erlang/== c nil)) cells) acc
              :else
              (let [args (lists/map (fn [c] (erlang/hd c)) cells)
                    acc2 (rf acc (lazy-invoke f args))]
                (cond
                  (reduce-reduced? acc2) acc2
                  :else (recur acc2 (lists/map (fn [c] (erlang/tl c)) cells))))))))))

;; ── filter: select elements matching a predicate ──────────────────────────
(declare filter-chunk lazy-filter-realise lazy-filter*)

(defn lazy-filter [pred coll]
  "Filter `coll` with `pred`, lazily. Returns a lazy seq of elements for which
   `pred` returns a truthy value."
  (lazy-filter* (call-prepare-callback pred 1) (BeamLisp.LazySeq/input (seqable coll))))

(defn- lazy-filter* [pred coll]
  (let [coll (BeamLisp.LazySeq/input coll)]
    (BeamLisp.LazySeq/new
      (fn [] (lazy-filter-realise pred coll))
      ; The fold keeps only matching elements, so the source's cells never form.
      (fn [rf init]
        (lazy-reduce-source
          (fn [acc x]
            (cond
              (lazy-invoke1 pred x) (rf acc x)
              :else acc))
          init
          coll)))))

(defn- lazy-filter-realise [pred coll]
  "One cell of `filter`: scan up to `chunk_size` INPUTS (never 'until 32
   matches' — a sparse predicate over an infinite coll must still seal a
   chunk), looping in place past an all-reject scan so no cell is empty.

   `filter-chunk` hands back a REVERSED accumulator; the chunk is finished
   ONCE here — `lists/reverse/1` when the input ran out, `lists/reverse/2`
   onto the tail node otherwise. An all-reject scan (empty accumulator) keeps
   scanning IN PLACE rather than publishing an empty chunk, and so never
   allocates the tail until a matching element exists."
  (let [r (filter-chunk pred () coll (BeamLisp.LazySeq/chunk_size))
        acc (erlang/element 1 r)
        rest (erlang/element 2 r)]
    (cond
      (erlang/== nil rest) (lists/reverse acc)
      (erlang/== () acc) (lazy-filter-realise pred rest)
      :else (lists/reverse acc
               (BeamLisp.LazySeq/new (fn [] (lazy-filter* pred rest)))))))

(defn- filter-chunk [pred acc coll n]
  "Scan up to n INPUT elements, keeping those matching pred (accumulated in
   REVERSE). Returns {reversed-accumulator rest}; rest is nil when the input ran
   out. The caller finishes the chunk once (see `lazy-filter-realise`) and NEVER
   reverses an empty accumulator onto a tail."
  (cond
    (erlang/== n 0) (tuple2 acc coll)
    :else
    (let [cell (BeamLisp.LazySeq/cell coll)]
      (cond
        (erlang/== nil cell) (tuple2 acc nil)
        :else
        (let [h (erlang/hd cell)]
          (filter-chunk pred
                        (cond (lazy-invoke1 pred h) (raw-cons h acc) :else acc)
                        (erlang/tl cell) (erlang/- n 1)))))))

;; ── filter-xform: transducer version of filter ─────────────────────────────
(defn lazy-filter-xform [pred]
  "Transducer arity of filter. Returns a function that wraps a reducing function."
  (fn [rf]
    (call-multi-fn
      (maps/put 0 (fn [] (lazy-invoke rf ()))
              (maps/put 1 (fn [result] (lazy-invoke rf (lazy-one result)))
                (maps/put 2 (fn [result input]
                              (cond
                                (lazy-invoke pred (lazy-one input))
                                (lazy-invoke rf (lazy-two result input))
                                :else result))
                  (maps/new)))))))

;; ── map-xform: transducer version of map ───────────────────────────────────
(defn lazy-map-xform [f]
  "Transducer arity of map. Returns a function that wraps a reducing function."
  (fn [rf]
    (call-multi-fn
      (maps/put 0 (fn [] (lazy-invoke rf ()))
              (maps/put 1 (fn [result] (lazy-invoke rf (lazy-one result)))
                (maps/put 2 (fn [result input]
                              (lazy-invoke rf (lazy-two result (lazy-invoke f (lazy-one input)))))
                  (maps/new)))))))

;; ── take-xform: transducer that takes first n elements ──────────────────────
(defn lazy-take-xform [n]
  "Transducer that passes through the first n inputs, then stops."
  (fn [rf]
    (let [nv (BeamLisp.Refs/volatile n)]
      (call-multi-fn
        (maps/put 0 (fn [] (lazy-invoke rf ()))
                (maps/put 1 (fn [result] (lazy-invoke rf (lazy-one result)))
                  (maps/put 2 (fn [result input]
                                (let [cur (BeamLisp.Refs/deref nv)
                                      _ (BeamLisp.Refs/vreset! nv (erlang/- cur 1))]
                                  (cond
                                    (erlang/> cur 0) (lazy-invoke rf (lazy-two result input))
                                    :else result)))
                    (maps/new))))))))

;; ── take-while: lazy seq of leading elements matching predicate ────────────
(declare take-while-build take-while-seg)

(defn lazy-take-while [pred coll]
  "Lazy seq of leading elements from coll for which pred is truthy. Stops at
   the first falsy pred result."
  (let [input (BeamLisp.LazySeq/input (seqable coll))]
    (BeamLisp.LazySeq/new
      (fn [] (take-while-seg pred input))
      ; The fold BOUNDS an infinite source: on the first falsy pred it wraps
      ; the accumulator in a Reduced, which stops the source fold at that
      ; element — no further element is read. The wrapper is peeled by the
      ; caller, so the fold's value is the ordinary accumulator.
      (fn [rf init]
        (lazy-reduce-source
          (fn [acc x]
            (cond
              (lazy-invoke pred (lazy-one x)) (rf acc x)
              :else (reduce-reduced acc)))
          init
          input)))))

(defn- take-while-seg [pred coll]
  "Chunked version that collects up to chunk_size consecutive matching elements."
  (let [chunk-size (BeamLisp.LazySeq/chunk_size)
        result (take-while-build pred coll () chunk-size)]
    (cond
      (erlang/== :empty result) nil
      :else
      (let [elems (erlang/element 1 result)
            rest (erlang/element 2 result)]
        (cond
          (erlang/== nil rest) elems
          :else (BeamLisp.LazySeq/chain elems
                   (fn [] (take-while-seg pred rest))))))))

(defn- take-while-build [pred coll acc n]
  "Build a chunk of matching elements. Returns :empty, or [elements rest]."
  (cond
    (erlang/== n 0)
    (cond
      (erlang/== acc ()) :empty
      :else (tuple2 (lists/reverse acc) coll))
    :else
    (let [cell (BeamLisp.LazySeq/cell coll)]
      (cond
        (erlang/== nil cell)
        (cond
          (erlang/== acc ()) :empty
          :else (tuple2 (lists/reverse acc) nil))
        :else
        (let [h (erlang/hd cell)
              t (erlang/tl cell)]
          (cond
            (lazy-invoke pred (lazy-one h))
            (take-while-build pred t (raw-cons h acc) (erlang/- n 1))
            :else
            (cond
              (erlang/== acc ()) :empty
              :else (tuple2 (lists/reverse acc) nil))))))))

;; ── drop-while: drop elements while predicate is truthy ──────────────────────
(declare drop-while-skip)

(defn lazy-drop-while [pred coll]
  "Lazy seq with leading elements removed where pred is truthy. Returns the
   first element where pred is falsy and everything after it."
  (let [input (BeamLisp.LazySeq/input (seqable coll))]
    (BeamLisp.LazySeq/new
      (fn [] (drop-while-skip pred input))
      ; One volatile carries the phase: while dropping, a matching element is
      ; skipped without touching the accumulator; the first miss flips the
      ; phase and every element after it is folded. The pred runs once per
      ; element in order, as the cell walk does.
      (fn [rf init]
        (let [dropping (BeamLisp.Refs/volatile true)]
          (lazy-reduce-source
            (fn [acc x]
              (cond
                (BeamLisp.Refs/deref dropping)
                (cond
                  (lazy-invoke pred (lazy-one x)) acc
                  :else (do (BeamLisp.Refs/vreset! dropping false) (rf acc x)))
                :else (rf acc x)))
            init
            input))))))

(defn- drop-while-skip [pred coll]
  "Skip leading elements while pred is truthy, returning the rest."
  (let [cell (BeamLisp.LazySeq/cell coll)]
    (cond
      (erlang/== nil cell) nil
      :else
      (let [h (erlang/hd cell)
            t (erlang/tl cell)]
        (cond
          (lazy-invoke pred (lazy-one h))
          (drop-while-skip pred t)
          :else (raw-cons h t))))))

;; ── range: infinite or bounded integer sequence ──────────────────────────
(declare range-chunk range-build)

(defn lazy-range
  ([] (lazy-range 0 nil))
  ([end_] (lazy-range 0 end_))
  ([start end_]
   (BeamLisp.LazySeq/new
     (fn [] (range-chunk start end_))
     ; A generator's fold is a plain counter loop — no source to walk, no cell
     ; to publish. `end_` nil is the infinite range, bounded only by a consumer
     ; step that returns a Reduced.
     (fn [rf init]
       (loop [i start acc init]
         (cond
           (erlang/and (erlang/== false (erlang/== end_ nil)) (erlang/>= i end_)) acc
           :else
           (let [acc2 (rf acc i)]
             (cond
               (reduce-reduced? acc2) acc2
               :else (recur (erlang/+ i 1) acc2)))))))))

(defn- range-chunk [start end_]
  "Build one chunk of integers (up to chunk_size) with a lazy tail if not
   exhausted. `range-build` hands back a REVERSED accumulator; the chunk is
   finished ONCE here — `lists/reverse/1` when the range ran out,
   `lists/reverse/2` onto the tail node for a continuing chunk."
  (cond
    (erlang/and (erlang/== false (erlang/== end_ nil)) (erlang/>= start end_))
    nil
    :else
    (let [chunk-size (BeamLisp.LazySeq/chunk_size)
          result (range-build start end_ () chunk-size)]
      (let [acc (erlang/element 1 result)
            next (erlang/element 2 result)]
        (cond
          (erlang/== nil next) (lists/reverse acc)
          :else (lists/reverse acc
                   (BeamLisp.LazySeq/new (fn [] (range-chunk next end_)))))))))

(defn- range-build [i end_ acc n]
  "Accumulate integers from i until end_ or chunk is full, in REVERSE. Returns
   [reversed-accumulator next]."
  (cond
    (erlang/== n 0) (tuple2 acc i)
    :else
    (cond
      (erlang/and (erlang/== false (erlang/== end_ nil)) (erlang/>= i end_))
      (tuple2 acc nil)
      :else
      (range-build (erlang/+ i 1) end_ (raw-cons i acc) (erlang/- n 1)))))

;; ── iterate: infinite sequence x, (f x), (f (f x)), ... ───────────────────
(declare iterate-from)

(defn lazy-iterate [f x]
  "Infinite lazy seq starting with x, then (f x), (f (f x)), etc."
  (BeamLisp.LazySeq/new
    (fn [] (iterate-from f x))
    ; The generator's fold applies f in the same order the cell walk does, so
    ; the elements agree; an infinite seq is bounded only by a consumer step
    ; returning a Reduced.
    (fn [rf init]
      (loop [x x acc init]
        (let [acc2 (rf acc x)]
          (cond
            (reduce-reduced? acc2) acc2
            :else (recur (lazy-invoke f (lazy-one x)) acc2)))))))

(defn- iterate-from [f x]
  "Generate the next element: x, then tail is the infinite iteration of f."
  (raw-cons x
    (BeamLisp.LazySeq/new
      (fn [] (iterate-from f (lazy-invoke f (lazy-one x)))))))

;; ── repeat: infinite or bounded repetition ──────────────────────────────────
(declare repeat-from)

(defn lazy-repeat
  ([x] (BeamLisp.LazySeq/new
         (fn [] (repeat-from x))
         (fn [rf init]
           (loop [acc init]
             (let [acc2 (rf acc x)]
               (cond
                 (reduce-reduced? acc2) acc2
                 :else (recur acc2)))))))
  ([n x] (lists/duplicate (erlang/max n 0) x)))

(defn- repeat-from [x]
  "Generate an infinite repetition of x."
  (raw-cons x
    (BeamLisp.LazySeq/new
      (fn [] (repeat-from x)))))

;; ── cycle: repeat a collection forever ─────────────────────────────────────
(declare cycle-from)

(defn lazy-cycle [coll]
  "Infinite lazy seq repeating the elements of coll forever. Returns nil
   (empty seq) if coll is empty."
  (let [input (BeamLisp.LazySeq/input coll)]
    (let [cell (BeamLisp.LazySeq/cell input)]
      (cond
        (erlang/== nil cell) nil
        :else (BeamLisp.LazySeq/new
                (fn [] (cycle-from input input))
                ; Re-walk the source for each lap until the consumer halts. The
                ; source is immutable (a cursor or list) or a memoised lazy seq,
                ; so a later lap replays it; a halt returns the Reduced as-is
                ; for the caller to peel.
                (fn [rf init]
                  (loop [acc init]
                    (let [acc2 (lazy-fold-source rf acc input)]
                      (cond
                        (reduce-reduced? acc2) acc2
                        :else (recur acc2))))))))))

(defn- cycle-from [current original]
  "Yield current's head, then recursively cycle through tail. When current ends,
   restart from original."
  (let [cell (BeamLisp.LazySeq/cell current)]
    (cond
      (erlang/== nil cell)
      (cycle-from original original)
      :else
      (let [head (erlang/hd cell)
            tail (erlang/tl cell)]
        (raw-cons head
          (BeamLisp.LazySeq/new
            (fn [] (cycle-from tail original))))))))

;; ── doall: force a lazy seq and return it ────────────────────────────────
(defn lazy-doall [x]
  "Force a lazy seq to completion and return it. Improper lists (lazy tail)
   are realized to proper lists. Non-lazy values are returned unchanged."
  (cond
    (erlang/is_map x)
    (cond
      (erlang/== (maps/get :"__struct__" x nil)
        :"Elixir.BeamLisp.LazySeq")
      (BeamLisp.LazySeq/to_list x)
      :else x)
    (erlang/is_list x)
    (cond
      (is-improper? x)
      (BeamLisp.LazySeq/to_list x)
      :else x)
    :else x))

(defn- is-improper? [xs]
  "Check if xs is an improper list (ends in a LazySeq, not nil or [])."
  (cond
    (erlang/is_list xs)
    (cond
      (erlang/== () xs) false
      :else
      (let [t (erlang/tl xs)]
        (is-improper-tail? t)))
    :else false))

(defn- is-improper-tail? [tail]
  "Check if tail is a LazySeq (improper) or a proper list terminator."
  (cond
    (erlang/== nil tail) false
    (erlang/== () tail) false
    (erlang/is_map tail)
    (cond
      (erlang/== (maps/get :"__struct__" tail nil)
        :"Elixir.BeamLisp.LazySeq")
      true
      :else false)
    (erlang/is_list tail)
    (is-improper-tail? (erlang/tl tail))
    :else false))

;; ── dorun: force a lazy seq for side effects ───────────────────────────────
(defn lazy-dorun [x]
  "Force a lazy seq for side effects only, returning nil. Only lazy seqs are
   forced; other values return nil unchanged."
  (cond
    (erlang/is_map x)
    (cond
      (erlang/== (maps/get :"__struct__" x nil)
        :"Elixir.BeamLisp.LazySeq")
      (do (BeamLisp.LazySeq/run x) nil)
      :else nil)
    :else nil))

;; ── subseq: subsequence of a sorted collection ──────────────────────────────
(defn lazy-subseq [coll start stop]
  "Ascending-order subsequence of coll from start to stop (both inclusive for
   keys >= start and < stop). Works on sorted maps and sets."
  (range-seq coll start stop :asc))

;; ── rsubseq: descending subsequence ────────────────────────────────────────
(defn lazy-rsubseq [coll start stop]
  "Descending-order subsequence of coll from start to stop."
  (range-seq coll start stop :desc))

;; ── range-seq: backing implementation for subseq / rsubseq ────────────────
(defn- range-seq [coll start stop dir]
  "Extract a subsequence from a sorted collection. Uses nil as unbounded marker."
  (let [lo (cond (erlang/== start nil) :unbounded :else (tuple2 :bound start))
        hi (cond (erlang/== stop nil) :unbounded :else (tuple2 :bound stop))
        entries (cond
                  (erlang/== dir :asc)
                  (erlang/apply :"Elixir.BeamLisp.Sorted"
                    ;; `subseq_entries/3` takes the two bounds as SEPARATE
                    ;; arguments. Packing them into one tuple made this a
                    ;; two-argument call to a three-arity function, so every
                    ;; `subseq` on an ordered collection raised
                    ;; FunctionClauseError — and nothing saw it, because the
                    ;; differential matrix had no ordered collection in it.
                    :subseq_entries `(~coll ~lo ~hi))
                  :else
                  (erlang/apply :"Elixir.BeamLisp.Sorted"
                    :rsubseq_entries `(~coll ~lo ~hi)))]
    (let [struct (maps/get :"__struct__" coll nil)]
      (cond
        (erlang/== struct :"Elixir.BeamLisp.Sorted.SortedSet")
        (lists/map (fn [e] (erlang/element 1 e)) entries)
        (erlang/== struct :"Elixir.BeamLisp.Sorted.SortedMap")
        (lists/map (fn [e]
                  (let [k (erlang/element 1 e) v (erlang/element 2 e)]
                    (BeamLisp.Vector/new (raw-cons k (raw-cons v ())))))
            entries)
        :else entries))))

;; ── tree-seq: depth-first traversal of a tree ──────────────────────────────
(defn lazy-tree-seq [branch? children root]
  "Depth-first traversal: yields root, then each subtree reachable through
   children. Uses branch? to decide if a node has children. Realized eagerly."
  (cond
    (lazy-invoke branch? (lazy-one root))
    (let [kids (lazy-invoke children (lazy-one root))
          seqable-kids (seqable kids)
          tree-seqs (lists/flatmap (fn [child] (lazy-tree-seq branch? children child))
                            (k-to-list seqable-kids))]
      (raw-cons root tree-seqs))
    :else (lazy-one root)))

;; ── concat: one lazy seq from a list of collections ────────────────────────
;
; Laziness here is the CONTRACT, not a nicety: `(concat (list 1 2) (range))`
; must yield 1 and 2 without forcing the infinite tail, and entering a source
; only when the previous one runs out is what makes that true.
;
; This replaced a forwarder to `BeamLisp.Ns.Rt/concat` — a call into the module the
; cutover deletes, which the differential gate could not see because a
; forwarder ANSWERS CORRECTLY right up until the flip. RT's version is chunked
; (up to 32 elements from ONE source per chunk, the remaining sources held in a
; native cursor), which is an answer to a quadratic-tail problem and not to a
; semantic one. A slow-but-right concat can be measured against the host's; a
; fast-but-wrong one cannot.


(declare concat-chunk)

(defn- concat-next-seq
  "The next NON-EMPTY input from the cursor as `{cell cursor'}`, or nil when
   every input is spent. An empty input (nil, [], an exhausted lazy seq) is
   skipped here, so a chunk never ends merely because the next input is empty."
  [cursor]
  (loop [cursor cursor]
    (let [cell (BeamLisp.SeqCursor/cell cursor)]
      (cond
        (erlang/== cell nil) nil
        :else
          (let [s (erlang/hd cell)
                rest (erlang/tl cell)
                c (BeamLisp.LazySeq/cell s)]
            (cond (erlang/== c nil) (recur rest)
                  :else (tuple2 c rest)))))))

(defn- concat-pull
  "Drain up to `n` elements into `acc` (reversed). An exhausted `cur` ENDS the
   chunk at the input boundary; `cur` = nil takes the next input from the
   cursor. → `{elems cur cursor}`, or :empty when nothing at all remains."
  [cur cursor n acc]
  (loop [cur cur cursor cursor n n acc acc]
    (cond
      (erlang/== n 0) (tuple3 (lists/reverse acc) cur cursor)
      (erlang/== cur nil)
        (let [nx (concat-next-seq cursor)]
          (cond
            (erlang/== nx nil) (cond (erlang/== acc ()) :empty
                                     :else (tuple3 (lists/reverse acc) nil cursor))
            :else (let [c (erlang/element 1 nx)]
                    (recur (erlang/tl c) (erlang/element 2 nx) (erlang/- n 1) (raw-cons (erlang/hd c) acc)))))
      :else
        (let [c (BeamLisp.LazySeq/cell cur)]
          (cond
            (erlang/== c nil) (tuple3 (lists/reverse acc) nil cursor)
            :else (recur (erlang/tl c) cursor (erlang/- n 1) (raw-cons (erlang/hd c) acc)))))))

(defn- concat-chunk
  "RT's `concat_chunk/2`: ONE lazy node per CHUNK of up to `chunk_size`
   elements, not one per element. The port first built a node per element —
   a memo cell each — and `(count (mapcat (fn [x] [x]) (range 8000)))` went
   from linear to quadratic: 559 ms at 1000, 2366 ms at 2000, and the
   linearity test timed out at 8000."
  [cur cursor]
  (let [r (concat-pull cur cursor (BeamLisp.LazySeq/chunk_size) ())]
    (cond
      (erlang/== r :empty) nil
      :else
        (let [elems (erlang/element 1 r)
              cur2 (erlang/element 2 r)
              cursor2 (erlang/element 3 r)]
          (cond
            ; an EMPTY chunk with inputs left: the previous input ended exactly
            ; on a chunk boundary — advance, never end the seq here
            (and (erlang/== elems ()) (erlang/== cur2 nil)) (concat-chunk nil cursor2)
            (and (erlang/== cur2 nil) (erlang/== nil (BeamLisp.SeqCursor/cell cursor2))) elems
            :else (BeamLisp.LazySeq/chain elems (fn [] (concat-chunk cur2 cursor2))))))))

(defn lazy-concat
  "Concatenate a list of collections into one lazy seq — RT's `concat/1`: each
   input through `LazySeq.input`, all of them behind one `SeqCursor`."
  [seqs]
  (let [inputs (lists/map (fn [x] (BeamLisp.LazySeq/input x)) (k-to-list seqs))
        cursor (BeamLisp.SeqCursor/new inputs)]
    (BeamLisp.LazySeq/new
      (fn [] (concat-chunk nil cursor))
      ; Fold each input in order, stopping the whole concat when the consumer's
      ; step halts: the raw source fold returns the Reduced, so the next input
      ; is never entered.
      (fn [rf init]
        (loop [acc init ss inputs]
          (cond
            (empty-list? ss) acc
            :else
            (let [acc2 (lazy-fold-source rf acc (erlang/hd ss))]
              (cond
                (reduce-reduced? acc2) acc2
                :else (recur acc2 (erlang/tl ss))))))))))


;; ════ rt.num ═══════════════════════════════════════════════════════════════════
; rt/num.bl — numeric operations and predicates.
;
; Numbers include integers, floats, and Decimals. The predicates here handle
; totality: they answer a boolean on any value, not just numbers, but the
; behaviour on non-numbers follows the Elixir runtime's own — read it first.
;
; `nan?` is a special case: a float answering true when it is not equal to
; itself (the NaN property). `promoting-inc` and `ratio?` interact with Decimal
; promotion and the absence of a Ratio type, respectively — read the Elixir
; implementations before changing these.



;; ── decimal helpers ───────────────────────────────────────────────────────
; Decimals are maps with :unscaled and :scale fields. `Decimal.signum` returns
; -1, 0, or 1 corresponding to negative, zero, or positive. We call it directly.

(defn- decimal-signum [d]
  "The sign of a Decimal: -1, 0, or 1. Delegates to Decimal.signum."
  (BeamLisp.Decimal/signum d))

(defn- is-decimal? [x]
  "True when x is a Decimal struct. Checks for :__struct__ == BeamLisp.Decimal."
  (cond
    (erlang/is_map x)
    (cond
      (erlang/is_map_key :__struct__ x)
      (erlang/== (erlang/map_get :__struct__ x)
                 (erlang/binary_to_atom "Elixir.BeamLisp.Decimal" :utf8))
      :else false)
    :else false))

;; ── remainder ──────────────────────────────────────────────────────────────
; Erlang's rem and the jank/Clojure semantics are the same: the remainder has
; the sign of the dividend. rem(-7, 3) is -1 (not 2).

(defn num-rem
  "Remainder of a/b with the sign of the dividend.

   Delegates to erlang/rem, which matches Clojure's rem: rem(-7, 3) => -1.
   Raises when b is zero or when the operands are not integers."
  [a b]
  (erlang/rem a b))

;; ── bitwise not ────────────────────────────────────────────────────────────

(defn num-bit-not
  "Bitwise NOT of an integer. Raises on a non-integer."
  [x]
  (erlang/bnot x))

;; ── even and odd ───────────────────────────────────────────────────────────
; Both delegate to rem and answer true/false for any integer or non-integer.
; On non-integers, rem raises (e.g. (rem "str" 2) errors), so even? and odd?
; propagate that error.

(defn num-even?
  "True when x is an even integer. Raises on a non-integer."
  [x]
  (erlang/== (num-rem x 2) 0))

(defn num-odd?
  "True when x is an odd integer. Raises on a non-integer."
  [x]
  (erlang/=/= (num-rem x 2) 0))

;; ── NaN detection ──────────────────────────────────────────────────────────
; Only floats can be NaN (a float is NaN iff it is not equal to itself).
; Everything else answers false.

(defn num-nan?
  "True when x is a floating-point NaN. Always false for non-floats."
  [x]
  (cond
    (erlang/is_float x) (erlang/=/= x x)
    :else false))

;; ── numeric predicates (sign and zero) ─────────────────────────────────────
; These follow the Elixir runtime semantics from BeamLisp.Num:
; - For integers and floats, direct comparison (e.g. x > 0, x == 0, x < 0).
; - For Decimals, use Decimal.signum (returns -1, 0, or 1) and compare.
; - For other values, attempt the comparison anyway (may raise or return false).

(defn num-zero?
  "True when x is numerically zero.

   For integers/floats: x == 0.
   For Decimals: Decimal.signum(x) == 0.
   For other values: erlang.==(x, 0) (may raise or return false)."
  [x]
  (cond
    (erlang/is_number x) (erlang/== x 0)
    (is-decimal? x) (erlang/== (decimal-signum x) 0)
    :else (erlang/== x 0)))

(defn num-pos?
  "True when x is numerically positive.

   For integers/floats: x > 0.
   For Decimals: Decimal.signum(x) > 0.
   For other values: erlang.>(x, 0) (may raise or return false)."
  [x]
  (cond
    (erlang/is_number x) (erlang/> x 0)
    (is-decimal? x) (erlang/> (decimal-signum x) 0)
    :else (erlang/> x 0)))

(defn num-neg?
  "True when x is numerically negative.

   For integers/floats: x < 0.
   For Decimals: Decimal.signum(x) < 0.
   For other values: erlang.<(x, 0) (may raise or return false)."
  [x]
  (cond
    (erlang/is_number x) (erlang/< x 0)
    (is-decimal? x) (erlang/< (decimal-signum x) 0)
    :else (erlang/< x 0)))

;; ── promotion and ratios ───────────────────────────────────────────────────

(defn num-promoting-inc
  "Increment x by 1, promoting through any numeric tower as needed.

   For integers, the result is an integer. For Decimals, adds 1 (exact).
   The promotion jank's C++ `inc'` performs is inherent in the Decimal
   representation; no extra step is needed."
  [x]
  (erlang/+ x 1))

(defn num-ratio?
  "True when x is a ratio (exact rational). Always false for beam-lisp.

   beam-lisp has no Ratio type (no exact rationals). This mirrors jank's
   `cpp/jank.runtime.is_ratio`, which detects a type that does not exist
   in the target runtime."
  [_]
  false)


;; ════ rt.print ═════════════════════════════════════════════════════════════════
; rt/print.bl — printing and stringification.
;
; The printer is part of the bootstrap seed's required set — the compiler calls
; `print_str` directly — and it is the one group with no host implementation to
; delegate to: `BeamLisp.Ns.Rt`'s printer IS the printer, so this file has to be
; right on its own.
;
; ── the idioms, MEASURED, because the ported version used six that do not work ─
;
;   (erlang/apply :string :concat [a b])   the third argument is a BL VECTOR — a
;       struct — so `:erlang.apply/3` raises badarg before the call happens; and
;       `:string.concat/2` wants TWO charlists, not binaries, so it would raise
;       even with a real list.
;   (erlang/string:find s "/")             that is the module `erlang` and the
;       function `"string:find"`, not `:string.find/2`. Undefined.
;   (erlang/apply :erlang :inspect [x])    `:erlang.inspect/1` does not exist.
;   (erlang/apply :erlang :to_string [x])  nor does that.
;   (erlang/apply (:BeamLisp.Vector :to_list) [x])  a keyword applied to a
;       module name, which is a map lookup, not a call.
;   (erlang/== [] x)                       `[]` is an EMPTY VECTOR in BL source,
;       not the empty list — so this never matched, the `tl` of an empty list
;       raised badarg, and the printer died on `()`.
;
; What replaces them, all of it checked by running it:
;   `iolist_to_binary/1` for concatenation — ONE primitive, any number of parts;
;   `Elixir.Kernel/inspect/1` for the opaque fallback, which is what RT's own
;   printer calls; the representation modules directly for their own types; and
;   `()` for the empty list.
;
; DISPATCH is `rt.kind/kind`, one read per value, so the ordering hazard the
; classifier exists to remove — a struct is a map, a set is a struct — cannot
; come back as a printed form.



;; ── the two primitives every printed string is built from ──────────────────

(defn- cat
  "Join parts. `iolist_to_binary/1` takes ONE list of parts, so this is `iodata`
   and not a fold, and it is the only concatenation in this file."
  [& parts]
  (erlang/iolist_to_binary parts))

(defn- inspect-str
  "The opaque fallback: a foreign struct, a tuple, a pid — a value the language
   has no printed syntax for. `inspect` is honest about it and BOUNDED, so a
   megabyte of data cannot flood a log at the moment someone is reading it to
   find out what went wrong."
  [x]
  (Elixir.Kernel/inspect x))

(defn- map-join
  "Join `(f x)` for each `x` in the LIST `xs`, with `sep` between. Written as a
   loop rather than handed to `Enum.map_join`, so no BL function has to cross
   into Elixir's enumerable protocol."
  [sep xs f]
  ; iodata collected in REVERSE and flattened ONCE: re-concatenating the
  ; accumulated binary per element copied it every time — quadratic, and in a
  ; heap-bounded process `(apply str (range 1000000))` then allocated far past
  ; the bound RT's `Enum.map_join` stays within (resource_bounds_test).
  (loop [ys xs acc () started false]
    (cond
      (if (erlang/is_list ys) false true) (erlang/iolist_to_binary (lists/reverse acc))
      (erlang/== ys ()) (erlang/iolist_to_binary (lists/reverse acc))
      :else
      (let [s (f (erlang/hd ys))]
        (recur (erlang/tl ys)
               (cond started (raw-cons s (raw-cons sep acc)) :else (raw-cons s acc))
               true)))))

(declare print-print-str print-print-readably)

;; ── a possibly-infinite seq prints BOUNDED ─────────────────────────────────

(defn- print-seq
  "At most 20 elements, then ` …`. Shared by the lazy and improper-list paths:
   an infinite interleave must never hang the printer, which is the one place a
   reader is already looking because something is wrong."
  [l]
  (let [r (BeamLisp.LazySeq/sample l 20)
        elems (erlang/element 1 r)
        trunc (erlang/element 2 r)]
    (cat "(" (map-join " " elems (fn [v] (print-print-readably v))) (cond trunc " …" :else "") ")")))

(defn- improper?
  "A list whose tail is a LazySeq — a partially-realized seq. `()` is the empty
   LIST; `[]` is an empty VECTOR and is not the same term."
  [xs]
  (loop [x xs]
    (cond
      (erlang/== x nil) false
      (erlang/== x ()) false
      (erlang/is_list x)
      (let [t (erlang/tl x)]
        (cond
          (erlang/is_map t) (erlang/== (maps/get :"__struct__" t nil) :"Elixir.BeamLisp.LazySeq")
          :else (recur t)))
      :else false)))

;; ── map and record bodies ─────────────────────────────────────────────────

(defn- print-pairs
  "A list of `{k, v}` tuples as `k v`, joined by `, `."
  [pairs]
  (map-join ", " pairs
    (fn [p]
      (cat (print-print-readably (erlang/element 1 p))
           " "
           (print-print-readably (erlang/element 2 p))))))

(defn- print-record-fields [x]
  (print-pairs
    (lists/filter (fn [p] (erlang/=/= :"__struct__" (erlang/element 1 p)))
            (maps/to_list x))))

;; ── the printer ───────────────────────────────────────────────────────────

(defn print-print-str
  "Print a value non-readably, in the syntax the reader reads back."
  [x]
  (let [kd (kind-kind x)]
    (cond
      (erlang/== kd :vector)
      (cat "[" (map-join " " (BeamLisp.Vector/to_list x) (fn [v] (print-print-readably v))) "]")

      (erlang/== kd :blfn)
      (cond
        (erlang/== (erlang/element 3 x) nil) "#fn[multi-arity]"
        :else "#fn[variadic]")

      (erlang/== kd :remote)
      (cat "#fn[" (erlang/atom_to_binary (erlang/element 2 x)) "/" (erlang/atom_to_binary (erlang/element 3 x)) "]")

      (erlang/== kd :text) x

      (erlang/== kd :symbol) (erlang/element 2 x)

      (erlang/== kd :nil) "nil"

      (erlang/== kd :bool)
      (cond (erlang/== x true) "true" :else "false")

      (erlang/== kd :atom) (cat ":" (erlang/atom_to_binary x :utf8))

      (erlang/== kd :list)
      (cond
        (improper? x) (print-seq x)
        :else (cat "(" (map-join " " x (fn [v] (print-print-readably v))) ")"))

      (erlang/== kd :lazy) (print-seq x)

      (erlang/== kd :set)
      (cat "#{" (map-join " " (BeamLisp.Set/to_list x) (fn [v] (print-print-readably v))) "}")

      (erlang/== kd :sorted-set)
      (cat "#{" (map-join " " (BeamLisp.Sorted/set_to_list x) (fn [v] (print-print-readably v))) "}")

      (erlang/== kd :sorted-map)
      (cat "{" (print-pairs (BeamLisp.Sorted/map_to_list x)) "}")

      ;; A reference is NOT a map: printing one as a map would leak its backing
      ;; process (`{:pid #PID…}`) at exactly the moment a reader is trying to
      ;; find out what the value actually is.
      (erlang/== kd :ref-cell) (inspect-str x)
      (erlang/== kd :reduced) (inspect-str x)

      ;; A decimal prints as the literal it reads from, so `pr-str` round-trips
      ;; and the scale stays visible in the output.
      (erlang/== kd :decimal) (BeamLisp.Decimal/to_literal x)

      ;; A record prints as the TAGGED literal the reader lowers back into a
      ;; record; a plain map print would come back as a map and break record
      ;; equality, which is the whole reason a record is not just a map.
      (erlang/== kd :record)
      (let [info (BeamLisp.Record/info (maps/get :"__struct__" x nil))]
        (cat "#" (erlang/element 2 info) "/" (erlang/element 3 info)
             "{" (print-record-fields x) "}"))

      (erlang/== kd :map)
      (cat "{" (print-pairs (maps/to_list x)) "}")

      ;; A tuple, a foreign struct, a pid, a port, a plain fn — opaque. Hand it
      ;; to `inspect` rather than ENUMERATE it: asking the map path to walk a
      ;; struct yields fields, not pairs, and the printer would die on the very
      ;; value it was asked to describe.
      :else (inspect-str x))))

(defn print-print-readably
  "Print a value readably: a string is QUOTED and a decimal keeps its `M`, so
   `pr-str` then `read` round-trips. `print-str` is the non-readable sibling."
  [x]
  (cond
    (erlang/is_binary x) (inspect-str x)
    :else (print-print-str x)))

;; ── stringification ───────────────────────────────────────────────────────

(defn to-str
  "Clojure's `toString` for ONE value: what each argument of `str` contributes.

   A decimal prints PLAIN (`\"1.50\"`) where `pr-str` keeps the literal
   (`1.50M`); a symbol prints as its name, which is what jank's keyword
   constructor needs; a keyword prints WITHOUT its colon.
   A collection or tuple falls back to the printer, so `(str {:a 1})` is
   \"{:a 1}\" rather than a String.Chars crash — maps, vectors, lists and lazy
   seqs have no String.Chars impl on the BEAM, and `print-str` is exactly the
   printer that knows their syntax."
  [x]
  (let [kd (kind-kind x)]
    (cond
      (erlang/== kd :nil) ""
      (erlang/== kd :decimal) (BeamLisp.Decimal/to_plain_string x)
      (erlang/== kd :text) x
      (erlang/== kd :atom) (erlang/atom_to_binary x :utf8)
      (erlang/== kd :bool) (cond (erlang/== x true) "true" :else "false")
      (erlang/== kd :symbol) (erlang/element 2 x)
      (erlang/== kd :int) (erlang/integer_to_binary x)
      (erlang/== kd :float) (erlang/float_to_binary x `(~:short))
      :else (print-print-str x))))

(defn str-0
  "RT's `str/0`.

   The contract exports it at ZERO arity because it is a VALUE, not a call: the
   `core` link table maps the name `str` to this function, the compiler passes
   that value to `invoke`, and the CALL SITE's argument count is what selects the
   variadic clause. So `(str a b c)` and `(str)` are the same function, and the
   variadic clause receives its whole argument list as ONE parameter — the shape
   `rt.call/invoke-multi` implements."
  []
  (call-multi-fn (maps/new) (tuple2 0 (fn [args] (map-join "" args (fn [v] (to-str v)))))))

;; ── printing to stdout ────────────────────────────────────────────────────

(defn- write-line
  "Write `s` to standard output followed by a newline.

   `io:puts/1` DOES NOT EXIST — it was never part of the `io` module's surface,
   and the call to it failed at RUNTIME on the first `println` anywhere in the
   language. That is what made the whole cutover look blocked on a mystery: the
   failing name is spelled as two separate atoms, `:io :puts`, so no search for
   `io/puts`, `io.puts` or `io:puts` could see it, and a stack trace of the
   failure named the CALL but not its site. `io:format/2` with `~ts~n` is the
   native spelling of the same write."
  [s]
  (io/format "~ts~n" `(~s)))

(defn print-println
  "Print with a newline. Arity 0 prints a BLANK LINE, as Clojure's does — it is
   how you space output, and an example that has to write `(println \"\")`
   instead reads like a workaround for a missing arity."
  ([] (write-line ""))
  ([x] (write-line (print-print-str x)))
  ([x & rest] (print-println-multi x rest)))

(defn print-println-multi
  "Print several values on one line, space-separated."
  [x rest-list]
  (write-line (map-join " " (raw-cons x rest-list) (fn [v] (print-print-str v)))))

;; ── names ─────────────────────────────────────────────────────────────────

(defn- parts-on [s] (Elixir.String/split s "/"))

(defn- name-part
  "The part after the first `/`, or the whole thing when there is none."
  [n]
  (let [ps (parts-on n)]
    (cond
      (erlang/== 1 (erlang/length ps)) n
      :else (erlang/hd (erlang/tl ps)))))

(defn- ns-part
  "The part before the first `/`, or nil when there is none."
  [n]
  (let [ps (parts-on n)]
    (cond
      (erlang/== 1 (erlang/length ps)) nil
      :else (erlang/hd ps))))

(defn print-name-of
  "jank's `cpp/jank.runtime.name`: the name String of a string, symbol or
   keyword; nil for anything else. A STRING is returned whole — only a symbol or
   a keyword is split, because only those can carry a namespace."
  [x]
  (cond
    (erlang/is_binary x) x
    (erlang/is_tuple x)
    (cond
      (and (erlang/>= (erlang/tuple_size x) 2) (erlang/== (erlang/element 1 x) :symbol))
      (name-part (erlang/element 2 x))
      :else nil)
    (and (erlang/is_atom x)
         (if (erlang/is_boolean x) false true)
         (erlang/=/= x nil))
    (name-part (erlang/atom_to_binary x :utf8))
    :else nil))

(defn print-namespace-of
  "jank's `cpp/jank.runtime.namespace_`: the namespace String of a symbol or
   keyword, or nil. A STRING has no namespace here — this is the asymmetry with
   `name-of`, and the oracle checks it."
  [x]
  (cond
    (erlang/is_tuple x)
    (cond
      (and (erlang/>= (erlang/tuple_size x) 2) (erlang/== (erlang/element 1 x) :symbol))
      (ns-part (erlang/element 2 x))
      :else nil)
    (and (erlang/is_atom x)
         (if (erlang/is_boolean x) false true)
         (erlang/=/= x nil))
    (ns-part (erlang/atom_to_binary x :utf8))
    :else nil))

(defn print-keyword-of
  "jank's `cpp/jank.runtime.keyword`: a keyword from a namespace and a name.
   When the namespace is nil and the name itself reads `ns/name`, the name is
   split; otherwise the two are joined as given.

   Interning goes through `BeamLisp.AtomGuard`, not `String.to_atom/1`: a
   keyword built at RUNTIME comes from data, and a loop interning one atom per
   input row fills the atom table, which aborts the VM uncatchably."
  [ns name]
  (cond
    (erlang/is_tuple name)
    (cond
      (and (erlang/>= (erlang/tuple_size name) 2) (erlang/== (erlang/element 1 name) :symbol))
      (print-keyword-of ns (erlang/element 2 name))
      :else nil)

    (erlang/is_binary name)
    (let [nm (cond (erlang/is_binary name) name :else (erlang/atom_to_binary name :utf8))
          nsp (cond (erlang/== ns nil) nil
                    (erlang/is_binary ns) ns
                    :else (erlang/atom_to_binary ns :utf8))
          ps (parts-on nm)
          split (cond (erlang/== nsp nil) (cond (erlang/== 2 (erlang/length ps)) (tuple2 (erlang/hd ps) (erlang/hd (erlang/tl ps)))
                                                :else (tuple2 nil nm))
                      :else (tuple2 nsp nm))
          final-ns (erlang/element 1 split)
          final-name (erlang/element 2 split)]
      (BeamLisp.AtomGuard/to_atom
        (cond (erlang/== final-ns nil) final-name
              :else (cat final-ns "/" final-name))))

    :else nil))

(defn print-gensym
  "A fresh symbol datum for hand-written macros, in the `__N__auto` shape that
   syntax-quote's `x#` auto-gensyms share."
  ([] (print-gensym "G"))
  ([prefix]
   (let [p (cond (erlang/is_binary prefix) prefix
                 :else (erlang/atom_to_binary prefix :utf8))]
     (tuple2 :symbol
       (cat p "__"
            (erlang/integer_to_binary (Elixir.System/unique_integer `(~:positive)))
            "__auto")))))


;; ════ rt.read ══════════════════════════════════════════════════════════════════
; rt/read.bl — reader macros and data-reader registries.
;
; These functions manage two tables: one mapping single-char dispatch strings to
; reader macro names, and one mapping tag names to data-reader function symbols.
; Both are stored in BeamLisp.Env, the shared key-value store.
;
; KEY DIFFERENCE BETWEEN THE TWO:
;  - reader_macro/reader_macro!: stores and returns the NAME STRING
;  - data_reader/data_reader!: stores and returns the WHOLE {:symbol, name} tuple
;
; `read-data` is the sole entry point to the reader, used by spell.run to load
; source as pure data — never evaluated, never compiled.



(defn read-read-data
  "Read ONE form from a string of source, as data, without evaluation.

   Returns the form if the read succeeds; raises SyntaxError if not."
  [source]
  (BeamLisp.Compiler/read_data source))

(defn read-reader-macro
  "The reader macro registered for a dispatch character, or :error.

   Returns {:ok name} when a macro is registered under the char string,
   :error when no macro is found. The name is a string."
  [char]
  (BeamLisp.Env/lookup (tuple2 :reader_macro char)))

(defn read-reader-macro!
  "Register a reader macro for a dispatch character.

   Takes a char string and a symbol like 'my-reader, and stores the mapping
   so #char[...] reads as (my-reader [...]).

   Returns the name STRING extracted from the symbol."
  [char sym]
  (let [name (erlang/element 2 sym)]
    (do
      (BeamLisp.Env/put_key (tuple2 :reader_macro char) name)
      name)))

(defn read-data-reader
  "The data-reader registered for a tag name, or :error.

   A tag is the dispatch name in #tag[...] / #tag{...} literals. This function
   looks up the registered reader function for the tag.

   Returns {:ok {:symbol name}} when registered, :error when not found."
  [tag]
  (BeamLisp.Env/lookup (tuple2 :data_reader tag)))

(defn read-data-reader!
  "Register a data-reader for a tag name.

   Takes a tag string and a symbol like 'my-reader, and stores the mapping
   so #tag[...] reads as (my-reader [...]).

   Returns the reader symbol (the whole {:symbol, name} tuple)."
  [tag sym]
  (do
    (BeamLisp.Env/put_key (tuple2 :data_reader tag) sym)
    sym))


;; ════ rt.reduce ════════════════════════════════════════════════════════════════
; rt/reduce.bl — one traversal protocol, selected once per collection.
;
; `k-reduce` asks `rt.kind/kind` ONE time, then walks the representation it
; found directly:
;
;   list   → the cons spine (hd/tl), no length call, no copy
;   vector → the small tuple, or the trie's leaves then its tail buffer, in
;            order — NEVER `BeamLisp.Vector/to_list`
;   lazy   → the memo cell contract: force the next cell only when an element
;            is actually consumed; a `reduced` step stops before the next force
;   map    → `maps:iterator`/`maps:next`, no entry list materialized
;   other  → the generic seq protocol (`rt.seq`) for sets, sorted collections,
;            records, tuples and text
;
; EARLY TERMINATION. The step function may return `(BeamLisp.Ns.Rt/reduced v)` (or
; a bare `%BeamLisp.Reduced{}`); the fold returns `v` unwrapped at that point
; and performs NO further callback and NO further lazy force. This mirrors
; `BeamLisp.Ns.Rt/reduce`, which peels the sentinel at the halting point.
;
; CALLBACKS. A raw Erlang fun of arity 2 — which is what a single-clause BL
; `(fn [acc x] …)` compiles to — is applied with `erlang:apply/2`, no runtime
; hop. Anything else callable (a BL `$blfn` multi-arity/variadic fn, a keyword,
; a map, a vector) is dispatched through `BeamLisp.Ns.Rt.invoke/2`. That fallback
; is reached through a COMPUTED module atom, so it adds no static import to
; this module — but it IS a runtime dependency on RT and is recorded here
; deliberately: the fast path has no RT edge, the general path does.
;
; POLICY. `k-fold`/`k-reduce` take a 4th argument selecting the fold's boundary
; rule; the 3-arity is `:kernel`. `:kernel` is the representation walk's own
; rule: an improper cons chain stops at its first non-lazy, non-list tail, and a
; foreign opaque struct folds the entries `k-seq` yields. `:compat` is the
; historical public `core/reduce` rule over the SAME single walk: a supported
; collection used as a tail still folds, an UNSUPPORTED tail raises the same
; `count`-shaped `empty?` refusal it always did (after the prefix, no replay),
; and a foreign opaque struct folds ONE `nil` callback when non-empty (and none
; when the tag is its only field). See `reduce-tail` / `reduce-opaque`.
;
; The vector walk mirrors `lib/beam_lisp/vector.ex`: a small vector stores its
; elements directly as the `items` tuple; a trie stores `{bl_vec, cnt, shift,
; root, tail}` and `leaves_to_list(root, div(shift,5))` is the ordered leaf
; sequence, with `tail` appended last. We fold the same sequence without
; building it.



; `()` is a reader literal, not a `def`: a `def` VALUE has no link row, so each
; reference costs two `BeamLisp.Env` lookups — and this file has several inside
; per-element loops.



;; ── small list constructors (raw intrinsics) ───────────────────────────────
(defn- reduce-one [x] (raw-cons x ()))
(defn- reduce-two [a b] (raw-cons a (raw-cons b ())))

;; ── the reduced sentinel ───────────────────────────────────────────────────
(defn reduce-reduced?
  "Whether `x` is the reduced sentinel.

   The check names the module LITERALLY, the way the classifier names its
   registered kinds. The prototype resolved this through
   `Krt.Specialized/reduced?`, a descriptor-generated module that does not exist
   outside the prototype — so every reduce over a collection raised
   `function Krt.Specialized.reduced?/1 is undefined`, which the differential
   oracle never saw because none of its cases reaches a reducing step. A
   scaling probe found it while asking a different question, which is the
   argument for having more than one instrument."
  [x]
  (and (erlang/is_map x)
       (erlang/== (maps/get :"__struct__" x nil) :"Elixir.BeamLisp.Reduced")))

(defn- unwrap [x] (erlang/map_get :value x))

(defn reduce-reduced
  "Wrap `x` so a fold stops early with it — jank's `cpp/jank.runtime.reduced`.

   The sentinel is a `BeamLisp.Reduced` struct built from BIF-level maps, the
   same way the classifier names its kinds: no map literal, because a map
   literal lowers through `BeamLisp.Ns.Rt.hash_key` and this file must not import
   the runtime it replaces. `reduce` peels it at the halting point, so a caller
   never sees the wrapper.

   This was missing while `k-reduce` and `reduced?` were already here: the fold
   could RECOGNISE the sentinel but nothing could MAKE one, which is exactly the
   half of the contract a probe that only folds cannot see."
  [x]
  (maps/put :value x
    (maps/put :"__struct__" :"Elixir.BeamLisp.Reduced" (maps/new))))

(defn reduce-reduce
  "`(reduce f init coll)` — the public fold; `k-reduce` is its implementation.

   Two names on purpose: `k-reduce` is the kernel's, spelled with the `k-` prefix
   every other representation-directed walk in this package uses, and `reduce`
   is the name the contract exports and every caller writes."
  [f init coll]
  (k-reduce f init coll))

;; ── the step callback ──────────────────────────────────────────────────────
(defn- step
  "Apply `f` to `(acc, x)`. Fast path: a raw 2-arity fun. Fallback: the
   runtime's call-shape dispatcher, for BL multi-arity fns and other callables."
  [f acc x]
  (cond
    (erlang/is_function f 2) (f acc x)
    :else (call-invoke f `(~acc ~x))))

;; ── representation-directed walks ──────────────────────────────────────────
(declare reduce-lazy reduce-tail)

(defn- reduce-list [f acc xs policy]
  (loop [acc acc ys xs]
    (cond
      (erlang/== false (erlang/is_list ys)) (reduce-tail f acc ys policy)
      (erlang/== ys ()) acc
      :else
      (let [acc2 (step f acc (erlang/hd ys))]
        (cond
          (reduce-reduced? acc2) acc2
          :else (recur acc2 (erlang/tl ys)))))))

(defn- reduce-tail
  "Fold the non-list tail of a cons chain according to `policy` (see
   `reduce-list`). `:kernel` — the 3-arity kernel default — stops at the tail
   and returns the accumulator. `:compat` — the historical public
   `core/reduce` rule — reproduces the old generic loop's step at the tail:
   `empty?` FIRST (so an unsupported tail raises `count`'s FunctionClauseError,
   and never after a halting step), then `first` steps and `rest` — a proper
   list for every supported representation — resumes the one spine walk. No
   element of the already-folded prefix is replayed. A lazy tail was already
   folded in either mode."
  [f acc ys policy]
  (cond
    (erlang/== (kind-kind ys) :lazy) (reduce-lazy f acc ys)
    (erlang/== policy :kernel) acc
    (k-empty? ys) acc
    :else
    (let [acc2 (step f acc (k-first ys))]
      (cond
        (reduce-reduced? acc2) acc2
        :else (reduce-list f acc2 (k-rest ys) policy)))))

(defn- reduce-lazy [f acc l]
  (loop [acc acc cell (BeamLisp.LazySeq/cell l)]
    (cond
      (erlang/== cell nil) acc
      :else
      (let [acc2 (step f acc (erlang/hd cell))]
        (cond
          (reduce-reduced? acc2) acc2
          :else (recur acc2 (BeamLisp.LazySeq/cell (erlang/tl cell))))))))

(defn- reduce-tuple-elems
  "Fold every element of a dense tuple (a small vector's `items`, or a trie
   leaf)."
  [f acc t]
  (let [n (erlang/tuple_size t)]
    (loop [i 0 acc acc]
      (cond
        (erlang/>= i n) acc
        :else
        (let [acc2 (step f acc (erlang/element (erlang/+ i 1) t))]
          (cond
            (reduce-reduced? acc2) acc2
            :else (recur (erlang/+ i 1) acc2)))))))

(defn- trie-items?
  "The trie tag test from `vector.ex`: a 5-tuple tagged `:bl_vec` with a count
   above the small-vector bound. A small vector's `items` tuple never has this
   shape for a value a caller could not already confuse in the runtime."
  [items]
  (cond
    (erlang/is_tuple items)
    (cond
      (erlang/== 5 (erlang/tuple_size items))
      (cond
        (erlang/== (erlang/element 1 items) :bl_vec)
        (cond
          (erlang/is_integer (erlang/element 2 items))
          (erlang/> (erlang/element 2 items) 32)
          :else false)
        :else false)
      :else false)
    :else false))

(defn- reduce-trie-node
  "Fold the leaves under `node`, in order. `depth` counts node levels from the
   root to a leaf (`div(shift,5)`), matching `vector.ex:leaves_to_list`."
  [f acc node depth]
  (cond
    (erlang/== depth 0) (reduce-tuple-elems f acc node)
    :else
    (let [n (erlang/tuple_size node)]
      (loop [i 0 acc acc]
        (cond
          (erlang/>= i n) acc
          :else
          (let [child (erlang/element (erlang/+ i 1) node)]
            (cond
              (erlang/== child nil) (recur (erlang/+ i 1) acc)
              :else
              (let [acc2 (reduce-trie-node f acc child (erlang/- depth 1))]
                (cond
                  (reduce-reduced? acc2) acc2
                  :else (recur (erlang/+ i 1) acc2))))))))))

(defn- reduce-vector
  "Fold a vector. The BEAM vector's `:items` (a dense tuple or a `:bl_vec`
   trie) is walked in place, allocating nothing. A host whose vector keeps
   its elements elsewhere (the JS target: no `:items` field, PLAN-163 C2)
   folds the element list `BeamLisp.Vector/to_list` gives — one guard BIF on
   the BEAM path, the representation owned by the Vector module everywhere."
  [f acc v]
  (cond
    (erlang/== false (erlang/is_map_key :items v))
    (reduce-tuple-elems f acc (erlang/list_to_tuple (BeamLisp.Vector/to_list v)))
    :else
  (let [items (erlang/map_get :items v)]
    (cond
      (trie-items? items)
      (let [shift (erlang/element 3 items)
            root (erlang/element 4 items)
            tail (erlang/element 5 items)
            acc1 (reduce-trie-node f acc root (erlang/div shift 5))]
        (cond
          (reduce-reduced? acc1) acc1
          :else (reduce-tuple-elems f acc1 tail)))
      :else (reduce-tuple-elems f acc items)))))

(defn- reduce-map
  "Iterate a plain map directly. Entries are the same `[k v]` vectors the seq
   protocol yields (`rt.seq/entry`), so `k-reduce` and `k-seq` agree."
  [f acc m]
  (loop [iter (erlang/apply :maps :iterator (reduce-one m)) acc acc]
    (let [nx (erlang/apply :maps :next (reduce-one iter))]
      (cond
        (erlang/== nx :none) acc
        :else
        (let [acc2 (step f acc (seq-entry (erlang/element 1 nx) (erlang/element 2 nx)))]
          (cond
            (reduce-reduced? acc2) acc2
            :else (recur (erlang/element 3 nx) acc2)))))))

(defn- reduce-seq [f acc coll]
  (loop [acc acc ys (k-seq coll)]
    (cond
      (erlang/== ys nil) acc
      :else
      (let [acc2 (step f acc (k-first ys))]
        (cond
          (reduce-reduced? acc2) acc2
          :else (recur acc2 (k-next ys)))))))

(defn- reduce-opaque
  "Fold a foreign (non-beam-lisp) struct the way the historical public
   `core/reduce` did: `first` has no opaque clause, so the step sees `nil`, and
   `rest` is empty — exactly ONE callback, and none at all when the struct has
   no fields beyond its tag. Reached only from the `:compat` boundary; the
   kernel's own rule (`:kernel`) folds the entries `k-seq` yields instead."
  [f acc coll]
  (cond
    (k-empty? coll) acc
    :else (step f acc (k-first coll))))

;; ── the fold recipe toolkit ────────────────────────────────────────────────
; A lazy producer may attach a fold recipe (`BeamLisp.LazySeq.new/2`): a
; 2-arity fn that folds the seq's elements straight from its SOURCE. The
; toolkit below is what a recipe is built from, and it decides WHEN a recipe
; may be used at all.
;
; `lazy-fold-claim` is the one rule AND the ownership: only a node whose head
; cell is still `:pending` may be folded from source, and the claim that
; establishes it is the same `:running` attempt an ordinary force takes — so a
; concurrent force and a concurrent fold agree on one owner, and the loser waits
; on (or reads) the winner's answer instead of running the producer a second
; time. A claim the ceiling refuses raises before any effect runs. Once
; ANYTHING is realised (or claimed elsewhere) the memo walk is used instead, so
; an element already published keeps its shared value and a side-effecting `f`
; is not re-run for it. What a fold means for a claimed node — the elements are
; realised ONCE and published, or handed back on a halt — is on
; `BeamLisp.LazySeq`.

(defn- reduce-cursor
  "Fold a `SeqCursor` — native, chunked storage for a finite eager input. It
   carries no memo cell, so this is a plain walk of `SeqCursor.cell`."
  [f acc cursor]
  (loop [acc acc cell (BeamLisp.SeqCursor/cell cursor)]
    (cond
      (erlang/== cell nil) acc
      :else
      (let [acc2 (step f acc (erlang/hd cell))]
        (cond
          (reduce-reduced? acc2) acc2
          :else (recur acc2 (BeamLisp.SeqCursor/cell (erlang/tl cell))))))))

(defn lazy-fold-source
  "Fold `rf` over a producer's SOURCE, RAW: a step returning a `Reduced` stops
   the fold and the sentinel is returned as-is, so a recipe can tell a halt from
   an exhausted source (concat, cycle). A `SeqCursor` is walked directly;
   everything else goes through `k-fold`, which consults a nested LazySeq's own
   recipe. `rf` is a raw 2-arity fun."
  [rf init source]
  (cond
    (struct-of? source :"Elixir.BeamLisp.SeqCursor") (reduce-cursor rf init source)
    :else (k-fold rf init source)))

(defn lazy-reduce-source
  "`lazy-fold-source`, with the `Reduced` peeled — what a recipe whose fold
   simply propagates a halt uses, so its value is the ordinary accumulator."
  [rf init source]
  (let [out (lazy-fold-source rf init source)]
    (cond (reduce-reduced? out) (unwrap out) :else out)))

(defn- lazy-fold-claim
  "Claim a LazySeq's pending fold recipe for THIS process (see
   `BeamLisp.LazySeq/claim_recipe`), or nil when there is nothing to claim — not
   a LazySeq, no recipe, or the recipe is no longer pending because the cell was
   realised, claimed by another consumer, failed or made terminal. nil is the
   caller's signal to use the memo-cell walk, which reads whatever the cell now
   holds (or waits on the consumer that holds it)."
  [x]
  (cond
    (erlang/== false (struct-of? x :"Elixir.BeamLisp.LazySeq")) nil
    :else (BeamLisp.LazySeq/claim_recipe x)))

(defn- lazy-fold-claimed
  "Fold the CLAIMED node `l` through its recipe and REALISE it: every element
   the recipe yields is also collected, and a fold that runs to the end
   publishes the complete list as the node's shared answer — a second consumer
   then reads the memo instead of re-running the producer (the realise-once
   contract Clojure's `seq-reduce` keeps: a side-effecting `f` under `map` runs
   once per element, however many folds).

   `claim` is `{:claimed attempt pending}`, so the cell is ALREADY `:running`
   under this process: no other force or fold can run the producer now, and
   every way out publishes through the ordinary attempt protocol. A fold that
   runs to the end calls `complete_attempt`, whose ceiling verdict is the same
   one the equivalent force reaches and whose refusal leaves the cell TERMINAL
   (a later `count`/`first` fails fast rather than re-running the producer). A
   recipe that FAILS calls `fail_attempt`: the class, the unnormalized reason
   and the raw frames are recorded against the node's ORIGINAL thunk and
   re-raised here, and every waiter replays the same failure. A consumer that
   halts calls `release_recipe`, which hands the cell back `:pending` (a prefix
   may never be published as the whole seq) and re-dispatches any waiter.

   The halt is carried IN the accumulator (`{acc buf halted?}`), never read
   off the recipe's return: a recipe that propagates a halt through
   `lazy-reduce-source` peels the `Reduced` before returning, and a partial
   list published as the whole seq would be a wrong answer forever after.

   Returns `{acc elems}`: `acc` is the step's accumulator (a `Reduced` when it
   halted) and `elems` the published list (nil when halted)."
  [l claim f acc]
  (let [attempt (erlang/element 2 claim)
        pending (erlang/element 3 claim)
        thunk (erlang/element 2 pending)
        recipe (erlang/element 3 pending)
        produced
        (BeamLisp.LazySeq/capture_attempt
          (fn []
            (let [out (lazy-invoke recipe
                        (lazy-two
                          (fn [p x]
                            (let [a2 (step f (erlang/element 1 p) x)
                                  buf (raw-cons x (erlang/element 2 p))]
                              (cond
                                (reduce-reduced? a2)
                                (reduce-reduced (tuple (unwrap a2) buf true))
                                :else (tuple a2 buf false))))
                          (tuple acc () false)))]
              (cond (reduce-reduced? out) (unwrap out) :else out))))]
    (cond
      (erlang/== :failed (erlang/element 1 produced))
      (BeamLisp.LazySeq/fail_attempt l attempt thunk
        (erlang/element 2 produced) (erlang/element 3 produced) (erlang/element 4 produced))

      (erlang/element 3 (erlang/element 2 produced))
      (do
        (BeamLisp.LazySeq/release_recipe l attempt pending)
        (tuple (reduce-reduced (erlang/element 1 (erlang/element 2 produced))) nil))

      :else
      (let [p (erlang/element 2 produced)
            elems (erlang/apply :lists :reverse (list (erlang/element 2 p)))]
        (BeamLisp.LazySeq/complete_attempt l attempt elems)
        (tuple (erlang/element 1 p) elems)))))

(defn- lazy-fold
  "Reduce with an arbitrary callable through the memo-cell walk. A consumer may
   return Reduced: a recipe cannot resume from its collected prefix, so restoring
   it to pending would repeat producer effects on the next read. The chunked
   thunk path publishes each realized prefix before calling the reducer.

   Trusted non-halting count/materialization consumers still use the claimed
   full-fold recipe; this boundary does not assume a user callable is pure or
   incapable of halting."
  [f acc l]
  (reduce-lazy f acc l))

;; ── the one entry point ────────────────────────────────────────────────────
(defn k-fold
  "`k-reduce`'s walk, WITHOUT peeling the `Reduced` sentinel, so a fold recipe
   that must know its consumer halted can read it (see `lazy-fold-source`).
   Prefer `k-reduce`. The 4-arity carries the tail/opaque POLICY (see
   `reduce-list`): the 3-arity is `:kernel`, the representation walk's own rule,
   unchanged; `:compat` is the historical public `core/reduce` rule."
  ([f init coll] (k-fold f init coll :kernel))
  ([f init coll policy]
   (let [kd (kind-kind coll)]
     (cond
       (erlang/== kd :list) (reduce-list f init coll policy)
       (erlang/== kd :vector) (reduce-vector f init coll)
       (erlang/== kd :lazy) (lazy-fold f init coll)
       (erlang/== kd :map) (reduce-map f init coll)
       (erlang/== kd :nil) init
       (erlang/== kd :opaque) (cond (erlang/== policy :compat) (reduce-opaque f init coll)
                                    :else (reduce-seq f init coll))
       :else (reduce-seq f init coll)))))

(defn- compat-reduced?
  "The LIVE public `core/reduced?`, fetched at each call so a rebinding made
   mid-fold (by the step fn or by a prior predicate) is honoured exactly as the
   historical loop's late-bound `(reduced? acc)` was. A raw arity-1 fn is
   applied directly; any other callable goes through `call-invoke`."
  [x]
  (let [p (BeamLisp.Env/fetch! "core" "reduced?")]
    (cond
      (erlang/is_function p 1) (p x)
      :else (call-invoke p (reduce-one x)))))

(defn- compat-finish
  "Resolve a `:compat` fold's outcome. The kernel only ever saw OUR values:
   `{:$reduce_acc acc}` (exhausted) or the intrinsic Reduced holding
   `{:$reduce_halt v}` (the public predicate already said stop; `v` is the
   already-dereferenced payload, returned with no second predicate or peel).
   Exhaustion unwraps the user acc and runs the historical final LIVE
   predicate/deref once."
  [out]
  (let [r (cond (reduce-reduced? out) (unwrap out) :else out)]
    (cond
      (erlang/== (erlang/element 1 r) :"$reduce_halt") (erlang/element 2 r)
      :else
      (let [acc (erlang/element 2 r)]
        (cond (compat-reduced? acc) (BeamLisp.Refs/deref acc)
              :else acc)))))

(defn reduce-callback
  "The step callback `(acc x)` as ONE native 2-arity fun, prepared ONCE per
   traversal — see `call-prepare-callback`. A native 2-arity `f` is returned
   itself; a fixed `$blfn` arm becomes that arm; an eligible variadic arm
   becomes a native adapter reproducing `invoke-multi` exactly; anything else
   is wrapped around the ORIGINAL `call-invoke`. Building it calls nothing, so
   an invalid `f` still fails only at its first step (never on empty input),
   and the original failure is preserved."
  [f]
  (call-prepare-callback f 2))

(defn k-reduce
  "`(reduce f init coll)`: fold `f` as `(f acc x)` over `coll`, returning the
   accumulator. Dispatch happens once, on the collection's kind; the walk is
   then representation-directed. A step returning a `Reduced` stops the fold
   immediately — no further callback, no further lazy force — and its value is
   returned unwrapped. Arbitrary lazy reducers walk shared memo cells, publishing
   realized prefixes before callbacks so effects and early termination replay
   safely. Trusted count/materialization consumers have a separate recipe path.

   The 4-arity threads the POLICY `k-fold` takes (see `reduce-list`); the
   3-arity is `:kernel`, whose behaviour is unchanged.

   `:compat` keeps the ONE `k-fold` traversal and adapts only the accumulator:
   the kernel folds an internal envelope `{:$reduce_acc acc}`, so a user value
   the kernel's own sentinel test would take for Reduced (but live
   `core/reduced?` rejects) can never halt it. Per element: unwrap, call `f`
   once, THEN ask the live `core/reduced?`; truthy → `BeamLisp.Refs/deref` once
   and return the intrinsic Reduced carrying `{:$reduce_halt payload}`; else
   re-envelope.

   `mode` (5-arity, explicit, additive; every ordinary call is `:normalized`):
   `:normalized` selects the callback representation ONCE per traversal with
   `reduce-callback` and then runs the SAME walks. It is representation
   mechanics only — the generic wrapper delegates to the same `call-invoke`,
   creating it never invokes `f`, and the live `reduced?` fetch is untouched.
   `:baseline` keeps the raw `f` as the differential ORACLE the prototype test
   compares against; the ordinary arities PREPARE, because
   `reduce-callback`/`call-prepare-callback` preserve the outcome and the
   errors exactly while removing the per-element dispatch."
  ([f init coll] (k-reduce f init coll :kernel :normalized))
  ([f init coll policy] (k-reduce f init coll policy :normalized))
  ([f init coll policy mode]
   (let [cb (cond (erlang/== mode :normalized) (reduce-callback f) :else f)]
     (cond
       (erlang/== policy :compat)
       (compat-finish
         (k-fold (fn [env x]
                   (let [r (step cb (erlang/element 2 env) x)]
                     (cond
                       (compat-reduced? r)
                       (reduce-reduced (tuple :"$reduce_halt" (BeamLisp.Refs/deref r)))
                       :else (tuple :"$reduce_acc" r))))
                 (tuple :"$reduce_acc" init) coll policy))
       :else
       (let [out (k-fold cb init coll policy)]
         (cond
           (reduce-reduced? out) (unwrap out)
           :else out))))))


;; ════ rt.sorted ════════════════════════════════════════════════════════════════
; rt/sorted.bl — ordered maps and sets.
;
; The comparison used to order elements is the RUNTIME's ordering (`rt.eq/k-compare`),
; not the host's term order — a sorted set built with the wrong order answers
; membership wrongly. All creation functions delegate to BeamLisp.Sorted, which
; uses :gb_trees with the runtime's comparator.



;; ── set construction ───────────────────────────────────────────────────────

(defn sorted-sorted-set
  "Build an ordered set from variadic arguments, adding each in order.

   A new set is empty; each argument is added through `set_add`, which uses
   the runtime's comparison to place it. The final order is the output of the
   comparator, not the argument order."
  [args]
  (let [xs (k-to-list args)]
    (loop [s (BeamLisp.Sorted/set_new ()) ys xs]
      (cond
        (erlang/== ys ()) s
        :else (recur (BeamLisp.Sorted/set_add s (erlang/hd ys)) (erlang/tl ys))))))

(defn sorted-sorted-set-of
  "Build an ordered set from a collection's distinct elements.

   Every element in the collection is added; duplicates are automatically
   eliminated by the set structure. The final order is the output of the
   comparator."
  [coll]
  (let [xs (k-to-list coll)]
    (loop [s (BeamLisp.Sorted/set_new ()) ys xs]
      (cond
        (erlang/== ys ()) s
        :else (recur (BeamLisp.Sorted/set_add s (erlang/hd ys)) (erlang/tl ys))))))

;; ── map construction ───────────────────────────────────────────────────────

(defn sorted-sorted-map
  "Build an ordered map from variadic key/value arguments.

   Syntax: `(sorted-map k1 v1 k2 v2 …)`. Raises ArgumentError if an odd
   number of arguments is provided (i.e., a key without a value)."
  [args]
  (let [xs (k-to-list args)]
    (loop [m (BeamLisp.Sorted/map_new ()) ps xs]
      (cond
        (erlang/== ps ()) m
        (erlang/== (erlang/tl ps) ())
        (raise-argument (erlang/iolist_to_binary `("sorted-map: no value supplied for key " ~(Elixir.Kernel/inspect (erlang/hd ps)))))
        :else (let [k (erlang/hd ps) v (erlang/hd (erlang/tl ps))]
                (recur (BeamLisp.Sorted/map_put m k v) (erlang/tl (erlang/tl ps))))))))

(defn sorted-sorted-map-of
  "RT's `sorted_map_of/1`: an ordered map from a collection of `[k v]` entries,
   each a 2-element vector or a 2-element list; anything else refuses."
  [coll]
  (lists/foldl
    (fn [e m]
      (cond
        (and (struct-of? e :"Elixir.BeamLisp.Vector")
             (erlang/== 2 (BeamLisp.Vector/count e)))
          (BeamLisp.Sorted/map_put m (BeamLisp.Vector/nth e 0) (BeamLisp.Vector/nth e 1))
        (and (erlang/is_list e) (erlang/=/= e ()) (erlang/is_list (erlang/tl e))
             (erlang/=/= (erlang/tl e) ()) (erlang/== (erlang/tl (erlang/tl e)) ()))
          (BeamLisp.Sorted/map_put m (erlang/hd e) (erlang/hd (erlang/tl e)))
        :else
          (raise-argument (erlang/iolist_to_binary
                            `("sorted-map-of: not a [k v] entry: " ~(Elixir.Kernel/inspect e))))))
    (BeamLisp.Sorted/map_new ())
    (k-to-list coll)))

;; ── predicates ─────────────────────────────────────────────────────────────

(defn sorted-sorted-set?
  "True only for an ordered set (a sorted map answers false)."
  [x]
  (cond
    (erlang/is_map x)
    (cond
      (erlang/is_map_key :__struct__ x)
      (let [m (erlang/map_get :__struct__ x)]
        (erlang/== m (erlang/binary_to_atom "Elixir.BeamLisp.Sorted.SortedSet" :utf8)))
      :else false)
    :else false))

(defn sorted-sorted-map?
  "True only for an ordered map (a sorted set answers false)."
  [x]
  (cond
    (erlang/is_map x)
    (cond
      (erlang/is_map_key :__struct__ x)
      (let [m (erlang/map_get :__struct__ x)]
        (erlang/== m (erlang/binary_to_atom "Elixir.BeamLisp.Sorted.SortedMap" :utf8)))
      :else false)
    :else false))

;; ── mutation ───────────────────────────────────────────────────────────────

(defn sorted-sorted-dissoc
  "An ordered map without key k (idempotent).

   Exists because `dissoc` in `priv/boot/core.bl` uses `Map/delete`, which on a
   SortedMap would delete a struct FIELD rather than a tree entry. core.bl
   dispatches here for ordered maps specifically."
  [m k]
  (cond
    (sorted-sorted-map? m) (BeamLisp.Sorted/map_delete m k)
    :else (raise-argument (erlang/iolist_to_binary `("sorted-dissoc: expected a sorted map, got " ~(Elixir.Kernel/inspect m))))))

;; ════ rt — the public surface ════════════════════════════════════════════
;; ── classification ─────────────────────────────────────────────────────────
; One classifier answers every "what kind of thing is this". Predicates read it
; rather than sniffing shapes, so a struct can never be mistaken for a map (the
; rule `lib/beam_lisp/set.ex` records as a comment: set clauses MUST precede
; `is_bl_map`, or count/seq/first read the struct's fields).

(defn kind [x] (kind-kind x))
(defn family [kd] (kind-family kd))

(defn nil? [x] (kind-nil? x))
(defn bool? [x] (kind-bool? x))
(defn string? [x] (kind-string? x))
(defn keyword? [x] (kind-keyword? x))
(defn symbol? [x] (kind-symbol? x))
(defn fn?
  "`fn?`: a function value — a compiled fn, a tagged multi-arity fn, or a remote reference." [x] (kind-fn? x))
(defn int? [x] (kind-int? x))
(defn float?
  "jank's `float?`: true for floating-point values. On the BEAM that is `is_float/1`; upstream jank spells the derived predicate `double?`." [x] (kind-float? x))
(defn decimal? [x] (kind-decimal? x))
(defn number? [x] (kind-number? x))
(defn vector? [x] (kind-vector? x))
(defn set?
  "`set?`: true for a set — hashed or ordered." [x] (call-set? x))
(defn sorted-set?
  "`sorted-set?`: true only for an ordered SET (a sorted map answers false)." [x] (kind-sorted-set? x))
(defn lazy? [x] (kind-lazy? x))
(defn sorted-map?
  "`sorted-map?`: true only for an ordered MAP (a sorted set answers false)." [x] (kind-sorted-map? x))
(defn record? [x] (kind-record? x))
(defn map? [x] (call-map? x))
(defn sequential?
  "`sequential?`: a list, vector, or lazy seq — never a map, set, or string." [x] (kind-sequential? x))
(defn ident?
  "`ident?`: a keyword or a symbol." [x] (kind-ident? x))
(defn ref-type? [x] (kind-ref-type? x))
(defn coll? [x] (kind-coll? x))


;; ── the sequence protocol ─────────────────────────────────────────────────
; One classifier decides what `x` is; every operation below asks it once. The
; Elixir runtime answers the same questions in the clause heads of seven
; independent multi-clause functions, each carrying the ordering rule as a
; comment.

(defn first [x] (k-first x))
(defn rest [x] (k-rest x))
(defn next
  "Clojure `next` ≡ `(seq (rest coll))`: nil when the remainder is empty,
   where `rest` returns an empty seq. Every recursive seq function in
   core.jank tests `(if (next xs) …)`, so the nil-vs-empty split is the
   contract. Over a LazySeq it forces exactly one cell and returns the tail
   without realizing the next one." [x] (k-next x))
(defn seq
  "Clojure `seq`: nil for empty, the collection (or the lazy seq) otherwise." [x] (k-seq x))
(defn count [x] (k-count x))
(defn nth
  "Lenient element access for sequential destructuring: nil-safe, out-of-range gives nil."
  ([x i] (k-nth x i))
  ([x i default] (k-nth x i default)))
(defn empty? [x] (k-empty? x))
(defn take
  "Clojure `take`: force minimally, return a realized list." [n x] (k-take n x))
(defn drop
  "RT's `drop/2`, in RT's argument order `(coll, n)` — NOT Clojure's. The
   compiler's sequential destructuring emits `(mod-rt/drop whole n)` for `[a &
   more]`; Clojure's `(drop n coll)` is `drop_clj`, the var `core/drop` is
   seeded with. The port had this as `[n x]`, which the oracle could not see:
   its row called both runtimes in the same wrong order."
  [coll n] (k-drop n coll))
(defn cons [x xs] (k-cons x xs))
(defn splice [spliced tail] (k-splice spliced tail))
(defn list-star [x xs] (k-list-star x xs))
(defn list-star-0 [] nil)

; `doall`/`dorun` are NOT here yet on purpose: the Elixir runtime's `doall`
; FORCES its argument and returns it unchanged, while the kernel's `k-doall`
; returns a realized list. The oracle caught that mis-mapping. They belong with
; the lazy group, where forcing and return shape are decided together.

;; ── one comparison, one equality ───────────────────────────────────────────
; `=` is DEFINED as `(compare a b) == 0`, so the two can never disagree — which
; is the whole bug class (BUG-018/019) this cutover removes by construction.
; In the Elixir runtime they are two hand-ordered tables that have to be kept in
; step.

(defn compare
  "`(compare a b)` — a total order over the common beam-lisp types,
   mirroring Clojure: nil < false < true < numbers < strings < symbols <
   keywords < collections < anything else. Within a type, natural order
   (numeric, lexicographic, element-wise for collections). Not covered:
   the JVM-specific interop cases (chars, regexes, other Java types) —
   those fall to a generic rank." [a b] (k-compare a b))
(defn eqv [a b] (k-eqv a b))

;; ── the ported surface ─────────────────────────────────────────────────────
; Grown name by name, alongside the implementation that owns each one. A name
; appears here only when its owner exists — the link table is consulted on
; INVOCATION, never at compile time, so a facade that claimed a name it could
; not serve would fail at runtime and nowhere else.
;
; `rt.read` is deliberately ABSENT: its owner exists and loads, but it answers
; wrongly (its probe raises), and a name in the facade has to answer.
;
; ALSO ABSENT, each because the differential gate disagrees with it (counts are
; failures out of 24 corpus values, measured before removal):
;
;   the printer group   print-str 23, print-readably 24, name-of 24,
;                       namespace-of 24 — the port is unfinished
;   invocable?          28 across two arities: it answers true where the runtime
;                       being replaced answers false, so it is too permissive.
;                       SEED-CRITICAL, and the reason a name does not get wired
;                       because a probe passed.
;   sort                7 — returns lists of vectors where the runtime returns
;                       2-tuple entries, and () where it returns []
;   struct?, associative?  1 each — both answer false for a Decimal, which the
;                       runtime answers true for
;
; The per-group probes these came from all PASSED. Their corpora were written by
; the same worker that wrote the code, over the values it happened to think of;
; the 24-value corpus here was written first and is broader. A test and its
; subject sharing an author is not a test.

;; calls
(defn invoke [f args] (call-invoke f args))
(defn multi-fn
  ([clauses] (call-multi-fn clauses))
  ([clauses spec] (call-multi-fn clauses spec)))
(defn call-shape-error [f arity] (call-call-shape-error f arity))
(defn remote-fun [m f] (call-remote-fun m f))
(defn apply-to [f args] (call-apply-to f args))
(defn apply-variadic [f n args] (call-apply-variadic f n args))
(defn boolean
  "`boolean`: coercive truthiness — `true` for anything but `nil`/`false`." [x] (call-boolean x))
(defn seq?
  "`seq?`: a sequence — a proper list or a lazy seq, never a vector." [x] (call-seq? x))
(defn list?
  "`list?`: a proper list (incl. the empty list) — never a vector, map, or nil." [x] (call-list? x))
(defn transientable?
  "jank's `transientable?`: whether a collection supports `(transient coll)`.
   Mirrors `BeamLisp.Transient.transient/1` exactly, so it can never lie and
   silently send `into` down the wrong path: beam-lisp vectors, sets, and maps
   (a map on the BEAM is any struct or plain map) get a transient view; lists,
   lazy seqs, and non-collections do not. `(transient coll)` and this predicate
   must stay in lockstep — a drift here is exactly the silent-slow/ silent-wrong
   bug the doc warns about." [x] (call-transientable? x))
(defn sorted?
  "`sorted?`: true for an ordered map or set." [x] (call-sorted? x))
(defn identical? [a b] (call-identical? a b))
(defn not- [x] (call-not- x))
(defn invocable? [v arity] (call-invocable? v arity))
(defn struct?
  "`struct?`: a user/foreign BEAM struct — a bl record OR a foreign struct (a
   `%Date{}`, `%ReqLLM.Response{}`). FALSE for beam-lisp's own collection
   structs (vector, set, sorted map/set, lazy-seq) and reference types, which
   are the language's values rather than structs a program inspects." [x] (call-struct? x))
(defn associative?
  "`associative?`: a value fields can be read from by key or index — a bl map,
   a bl record, a foreign struct, or a vector. The predicate to branch on when
   the question is \"can I `get` into this?\", where `map?` is the wrong one
   because it excludes foreign structs that `Map/get` reads fine." [x] (call-associative? x))

;; collections
(defn get
  ([m key] (coll-get m key))
  ([m key default] (coll-get m key default)))
(defn conj
  "Clojure `conj`: prepend to a list, append to a vector."
  ([coll] (coll-conj coll))
  ([coll x] (coll-conj coll x)))
(defn contains?
  "`contains?`: KEY membership for maps, index-in-range for vectors — never
   value membership (the classic Clojure trap)." [coll k] (coll-contains? coll k))
(defn assoc
  "Clojure `assoc`: maps get a key update, vectors an index update (append at count)." [m k v] (coll-assoc m k v))
(defn assoc-variadic [m k v ks] (coll-assoc-variadic m k v ks))
(defn disj
  "`(disj set x)` — the set without x (idempotent)." [s k] (coll-disj s k))
(defn set
  "`(set coll)` — a set of the distinct elements of coll; a set input is returned unchanged." [coll] (coll-set coll))
(defn find
  "`find`: the map entry for `k` in map `m` as a `[key value]` vector, else nil." [coll k] (coll-find coll k))
(defn peek [coll] (coll-peek coll))
(defn pop [coll] (coll-pop coll))
(defn last-key
  "`(last-key coll)` — the largest key/member, or nil when empty. O(log n)." [coll] (coll-last-key coll))
(defn last-entry
  "`(last-entry m)` — the largest `[k v]` entry of a sorted map, or nil." [coll] (coll-last-entry coll))

;; numbers
(defn rem
  "Clojure `rem`: the remainder of a/b, with the sign of the *dividend* a.
   This is deliberately not `mod` (sign of the divisor) — the two differ on
   negative operands, which is why upstream defines `mod` in terms of `rem`.
   Elixir's `rem` is Erlang's, which is exactly Clojure's: rem(-7, 3) is -1." [a b] (num-rem a b))
(defn bit-not [x] (num-bit-not x))
(defn even? [x] (num-even? x))
(defn odd? [x] (num-odd? x))
(defn nan? [x] (num-nan? x))
(defn zero? [x] (num-zero? x))
(defn pos? [x] (num-pos? x))
(defn neg? [x] (num-neg? x))
(defn promoting-inc [x] (num-promoting-inc x))
(defn ratio? [x] (num-ratio? x))

;; the hash boundary
(defn hash-key [x] (hash-hash-key x))

;; the fold
(defn reduce [f init coll] (reduce-reduce f init coll))
(defn reduced
  "jank's `cpp/jank.runtime.reduced`: wrap x so a `reduce` terminates early with it." [x] (reduce-reduced x))
(defn reduced?
  "jank's `cpp/jank.runtime.is_reduced`: true exactly for a reduced wrapper." [x] (reduce-reduced? x))

;; printing, names and stringification
; Both spellings live here, like everything else: the kebab name is what
; beam-lisp source writes, the snake name is what the compiler's literal
; lowers, the `core` link table and `lib/**/*.ex` write. Writing only the
; snake one is a real defect and it was MINE — `rt/name-of` raised
; "undefined var" from BL while the contract's `name_of` worked.
; `str` is exported at ZERO arity because in the Elixir runtime it is a VALUE:
; the `core` link table maps the name to `str/0`, and the call site's argument
; count is what selects the variadic clause inside `multi_fn`. `to-str/1` is not
; here — RT keeps it private, and the contract does not name it.
(defn print-str [x] (print-print-str x))
(defn print-readably [x] (print-print-readably x))
(defn println
  ([] (print-println))
  ([x] (print-println x)))
(defn println-multi [x rest] (print-println-multi x rest))
(defn name-of [x] (print-name-of x))
(defn namespace-of [x] (print-namespace-of x))
(defn keyword-of [ns name] (print-keyword-of ns name))
(defn gensym
  ([] (print-gensym))
  ([prefix] (print-gensym prefix)))
(defn str [] (str-0))
(defn str_v
  "The LINKED `str`: the call site's arguments as one list, exactly what the
   variadic clause of `str-0`'s value receives."
  [args]
  (map-join "" args (fn [v] (to-str v))))

; `drop-clj` is the Clojure-ordered `(drop n coll)`, which is the order the
; `core` link table binds the name `drop` to; the compiler lowers `:drop`
; directly. Both spellings name the same walk here, and the oracle checks it.
;; the reader's two registries
; A reader macro is keyed by a single dispatch CHARACTER and stores the NAME;
; a data reader is keyed by a TAG NAME and stores the WHOLE symbol. The
; asymmetry is RT's and is the kind of thing a reader of either function has to
; be told, so it is stated here rather than discovered.
(defn read-data
  "`(read-data s)` — read ONE form of source as DATA. Never evaluates.
   
   This is the seam a model-written definition crosses (`spell.run`): source
   arrives as text, and the only safe thing to do with text is READ it — the
   reader's atom guard (PLAN-009) bounds what reading can intern, and no form
   is ever compiled or called. Errors raise SyntaxError, which the ladder
   catches and reports as a rung-1 refusal." [source] (read-read-data source))
(defn reader-macro [char] (read-reader-macro char))
(defn reader-macro! [char sym] (read-reader-macro! char sym))
(defn data-reader [tag] (read-data-reader tag))
(defn data-reader!
  "`(data-reader! \"d\" 'datom/read-query)` registers a data-reader so
   `#d[…]` reads as `(datom/read-query […])`. Rebindable, like
   `reader-macro!`, and registered from beam-lisp source rather than wired
   into the reader." [tag sym] (read-data-reader! tag sym))

(defn drop-clj [n coll] (k-drop n coll))

;; laziness
(defn map [f coll] (lazy--map f coll))
(defn map-multi [f c1 rest] (lazy-map-multi f c1 rest))
(defn filter [pred coll] (lazy-filter pred coll))
(defn take-while [pred coll] (lazy-take-while pred coll))
(defn drop-while [pred coll] (lazy-drop-while pred coll))
(defn doall
  "`(doall coll)` fully realizes a lazy seq, returning it. A
   partially-realized improper list (`[h | LazySeq]` — what cons onto a
   lazy tail yields) is realized to a proper list too, so a lazy
   interleave / interpose result survives doall and the printer; a proper
   list is returned unchanged." [coll] (lazy-doall coll))
(defn dorun
  "`(dorun coll)` forces a lazy seq for side effects, returning nil." [coll] (lazy-dorun coll))
(defn map-xform [f] (lazy-map-xform f))
(defn filter-xform [pred] (lazy-filter-xform pred))
(defn take-xform [n] (lazy-take-xform n))
(defn iterate
  "`(iterate f x)` yields x, (f x), (f (f x)), … forever, lazily." [f x] (lazy-iterate f x))
(defn repeat
  "`(repeat x)` is infinite and lazy; `(repeat n x)` is a realized list."
  ([x] (lazy-repeat x))
  ([n x] (lazy-repeat n x)))
(defn cycle
  "`(cycle coll)` repeats `coll` forever, lazily." [coll] (lazy-cycle coll))
(defn range
  "`(range)` is an infinite lazy seq. Bounded `(range end)` and
   `(range start end)` are lazy too, so `(take 5 (map f (range 1000000)))`
   realizes only the chunk `take` asks for instead of every element. An
   empty or exhausted range is an empty lazy seq (`()`), not a `[]` vector."
  ([] (lazy-range))
  ([end] (lazy-range end))
  ([start end] (lazy-range start end)))
(defn subseq
  "`(subseq coll start stop)` — ascending elements between inclusive bounds.
   
   `nil` bounds are unbounded. A sorted set yields members; a sorted map
   yields `[k v]` entries. The scan starts AT the lower bound rather than
   filtering from the beginning — the property index range-scans need." [coll start stop] (lazy-subseq coll start stop))
(defn rsubseq
  "`(rsubseq coll start stop)` — as `subseq`, descending." [coll start stop] (lazy-rsubseq coll start stop))
(defn tree-seq
  "`(tree-seq branch? children root)` — depth-first traversal of the tree
   rooted at `root`, yielding `root` then each child subtree in turn.
   Realized eagerly (a finite flatten input); Clojure's is lazy, but the
   emitted sequence is identical." [branch? children root] (lazy-tree-seq branch? children root))


;; sorting and concatenation
; `sort` and `concat` are the two collection operations whose RESULT is a
; sequence the caller walks, so both live with the laziness group: `concat`
; yields lazily and `sort` returns a list.
(defn sort
  "`(sort coll)` / `(sort comp coll)` — a stable sorted seq (a list)."
  ([coll] (coll-sort coll))
  ([comp coll] (coll-sort comp coll)))
(defn concat
  "`(concat & seqs)` — a lazy seq of every input, in order." [seqs] (lazy-concat seqs))

;; sorted collections
(defn sorted-set [coll] (sorted-sorted-set coll))
(defn sorted-set-of
  "`(sorted-set-of coll)` — an ordered set of a collection's distinct elements." [coll] (sorted-sorted-set-of coll))
(defn sorted-set? [x] (sorted-sorted-set? x))
(defn sorted-map [coll] (sorted-sorted-map coll))
(defn sorted-map-of
  "`(sorted-map-of coll)` — an ordered map from a collection of `[k v]` entries." [coll] (sorted-sorted-map-of coll))
(defn sorted-map? [x] (sorted-sorted-map? x))
(defn sorted-dissoc
  "`(sorted-dissoc m k)` — an ordered map without `k` (idempotent).
   
   Exists because `dissoc` in `priv/boot/core.bl` reaches for `Map/delete`, which
   on a SortedMap would delete a struct FIELD (or silently no-op) rather
   than a tree entry — leaving the key still present. core dispatches here
   for ordered maps." [m k] (sorted-sorted-dissoc m k))

;; ── the two spellings of one member ────────────────────────────────────────
; A member of a BL namespace is an Erlang atom spelled as it was written, so
; `(defn hash-key …)` exports `hash-key`. Nothing munges: `slash-target`
; (compiler.bl:442) passes the member text through literally whether it resolved
; the prefix to a namespace or to a host module. But the compiler's OWN literal
; lowers name the runtime with `_` (`:hash_key` at :592, `:invoke` at :199,
; `:nth` at :1012, `:drop` at :1036, `:splice` at :2406), every `lib/**/*.ex`
; caller does (`RT.invoke/2`, `RT.hash_key/1`, `RT.seed_core/0`), and the VALUES
; of the `core` link table do (`"print-str" => :print_str`).
;
; So after the cutover the module is named two ways by two conventions that both
; genuinely exist, and a name it does not export is a call site that breaks at
; RUNTIME, not at compile time — the link table is consulted on invocation. An
; alias costs one line and no runtime (it delegates straight to the owner, like
; the kebab line above it); a missing export costs a broken build.
;
; (The deeper fix is to munge at the boundary the way Clojure munges `-` to `_`
; for the JVM, so there is ONE spelling in source. That is a change to `Emit`
; with bootstrap-wide blast radius, and it does not belong inside a cutover that
; has to land green. Noted, not smuggled in.)

(defn apply_to [f args] (call-apply-to f args))
(defn apply_variadic [f n args] (call-apply-variadic f n args))
(defn assoc_variadic [m k v ks] (coll-assoc-variadic m k v ks))
(defn bit_not [x] (num-bit-not x))
(defn call_shape_error [f arity] (call-call-shape-error f arity))
(defn drop_while [pred coll] (lazy-drop-while pred coll))
(defn filter_xform [pred] (lazy-filter-xform pred))
(defn hash_key [x] (hash-hash-key x))
(defn last_entry [coll] (coll-last-entry coll))
(defn last_key [coll] (coll-last-key coll))
(defn list_star [x xs] (k-list-star x xs))
(defn map_xform [f] (lazy-map-xform f))
(defn multi_fn
  ([clauses] (call-multi-fn clauses))
  ([clauses spec] (call-multi-fn clauses spec)))
(defn not_ [x] (call-not- x))
(defn promoting_inc [x] (num-promoting-inc x))
(defn remote_fun [m f] (call-remote-fun m f))
(defn sorted_dissoc [m k] (sorted-sorted-dissoc m k))
(defn sorted_map [coll] (sorted-sorted-map coll))
(defn sorted_map? [x] (sorted-sorted-map? x))
(defn sorted_map_of [coll] (sorted-sorted-map-of coll))
(defn sorted_set [coll] (sorted-sorted-set coll))
(defn sorted_set? [x] (sorted-sorted-set? x))
(defn sorted_set_of [coll] (sorted-sorted-set-of coll))
(defn take_while [pred coll] (lazy-take-while pred coll))
(defn take_xform [n] (lazy-take-xform n))
(defn tree_seq [branch? children root] (lazy-tree-seq branch? children root))
(defn map_multi [f c1 rest] (lazy-map-multi f c1 rest))
(defn print_str [x] (print-print-str x))
(defn print_readably [x] (print-print-readably x))
(defn println_multi [x rest] (print-println-multi x rest))
(defn name_of [x] (print-name-of x))
(defn namespace_of [x] (print-namespace-of x))
(defn keyword_of [ns name] (print-keyword-of ns name))
(defn drop_clj [n coll] (k-drop n coll))
(defn list_star_0 [] nil)
(defn read_data [source] (read-read-data source))
(defn reader_macro [char] (read-reader-macro char))
(defn reader_macro! [char sym] (read-reader-macro! char sym))
(defn data_reader [tag] (read-data-reader tag))
(defn data_reader! [tag sym] (read-data-reader! tag sym))



;; ── `seed_core` — the `core` table ───────────────────────────────────────
;
; Every name the prelude, the interop layer and the `cpp/*` slices resolve
; before any `.bl` has loaded. Two mechanisms, one table:
;
;   VALUE  `Env/intern` binds a var whose value is a CALLABLE; a call site that
;          is not linked goes through `invoke`, which reads the arity out of it.
;   LINK   `Env/put_link` writes `{module, %{arity => fun}, {min, fun} | nil}`;
;          the compiler turns a BARE call at a linked arity into a direct remote
;          call and never consults `invoke`.
;
; A row is `(name module fixed variadic how)`: `module` is `:rt` for this
; namespace or a host module atom, `fixed` maps arity → exported function,
; `variadic` is `(min fun)` or nil, and `how` says whether the row seeds the
; value, the link, or both. VALUE and LINK are derived from the same row, so
; they cannot drift; where they genuinely differ (`assoc` links only its fixed
; arity, `map`'s link has no transducer arity) the name has two rows.
;
; RULES THE TABLE ENCODES, each paid for once:
;   * A link at ONE arity makes the other arities unreachable — `invoke` is not
;     consulted. So `filter` has no link row; `take` links BOTH its arities.
;   * A value is a plain capture exactly when it has one fixed arity and no
;     variadic clause, otherwise the `{:"$blfn", fixed, {min, f}}` tag —
;     `Emit.fn_value/3`'s rule, so a seeded value and a compiled `defn` value
;     are the same shape.
;   * Every module is an ATOM. A link row is compiled into every namespace that
;     calls the name; a binary module there is an ANF validation failure in
;     code that never mentions the runtime.
;   * Nothing here runs at load. Loading `rt` must never touch `core`.

(defn- seed-rows
  "The `core` table. A FUNCTION returning a quoted literal, not a `def`: the
   literal is a constant in the beam, so `seed-core` reads it with no `Env`
   lookup — which matters because `seed-core` runs before anything, `rt`'s own
   init included, has interned a single var."
  []
  '(("identical?" :rt {2 :identical?} nil :both)
    ("first" :rt {1 :first} nil :both)
    ("rest" :rt {1 :rest} nil :both)
    ("seq" :rt {1 :seq} nil :both)
    ("next" :rt {1 :next} nil :both)
    ("count" :rt {1 :count} nil :both)
    ("empty?" :rt {1 :empty?} nil :both)
    ("cons" :rt {2 :cons} nil :both)
    ("conj" :rt {1 :conj 2 :conj} nil :both)
    ("nth" :rt {2 :nth 3 :nth} nil :both)
    ("get" :rt {2 :get 3 :get} nil :both)
    ("assoc" :rt {3 :assoc} (3 :assoc_variadic) :value)
    ("assoc" :rt {3 :assoc} nil :link)
    ("apply" :rt {2 :apply_to} (2 :apply_variadic) :both)
    ("list*" :rt {0 :list_star_0} (1 :list_star) :both)
    ("println" :rt {0 :println 1 :println} (1 :println_multi) :value)
    ("pr-str" :rt {1 :print_readably} nil :both)
    ("print-str" :rt {1 :print_str} nil :both)
    ("gensym" :rt {0 :gensym 1 :gensym} nil :both)
    ("map" :rt {1 :map_xform 2 :map} (2 :map_multi) :value)
    ("map" :rt {2 :map} (2 :map_multi) :link)
    ("filter" :rt {1 :filter_xform 2 :filter} nil :value)
    ("range" :rt {0 :range 1 :range 2 :range} nil :both)
    ("iterate" :rt {2 :iterate} nil :both)
    ("repeat" :rt {1 :repeat 2 :repeat} nil :both)
    ("cycle" :rt {1 :cycle} nil :both)
    ("concat" :rt {} (0 :concat) :value)
    ; `str` stays a VALUE (seed-closures puts the multi-fn) and is ALSO linked:
    ; a bare `(str a b)` compiles to one direct `str_v([a, b])` instead of an
    ; `Env/fetch!` + `invoke` per call — the most-fetched var of a page render.
    ("str" :rt {} (0 :str_v) :link)
    ("take" :rt {1 :take_xform 2 :take} nil :both)
    ("drop" :rt {2 :drop_clj} nil :both)
    ("take-while" :rt {2 :take_while} nil :both)
    ("drop-while" :rt {2 :drop_while} nil :both)
    ("doall" :rt {1 :doall} nil :both)
    ("dorun" :rt {1 :dorun} nil :both)
    ("not" :rt {1 :not_} nil :both)
    ("even?" :rt {1 :even?} nil :both)
    ("odd?" :rt {1 :odd?} nil :both)
    ("zero?" :rt {1 :zero?} nil :both)
    ("pos?" :rt {1 :pos?} nil :both)
    ("neg?" :rt {1 :neg?} nil :both)
    ("rem" :rt {2 :rem} nil :value)
    ("rem" :erlang {2 :rem} nil :link)
    ("float?" :rt {1 :float?} nil :both)
    ("transientable?" :rt {1 :transientable?} nil :both)
    ("fn?" :rt {1 :fn?} nil :both)
    ("seq?" :rt {1 :seq?} nil :both)
    ("boolean" :rt {1 :boolean} nil :both)
    ("find" :rt {2 :find} nil :both)
    ("contains?" :rt {2 :contains?} nil :both)
    ("keyword?" :rt {1 :keyword?} nil :both)
    ("symbol?" :rt {1 :symbol?} nil :both)
    ("string?" :rt {1 :string?} nil :both)
    ("number?" :rt {1 :number?} nil :both)
    ("int?" :rt {1 :int?} nil :both)
    ("map?" :rt {1 :map?} nil :both)
    ("struct?" :rt {1 :struct?} nil :both)
    ("associative?" :rt {1 :associative?} nil :both)
    ("vector?" :rt {1 :vector?} nil :both)
    ("list?" :rt {1 :list?} nil :both)
    ("coll?" :rt {1 :coll?} nil :both)
    ("ident?" :rt {1 :ident?} nil :both)
    ("set" :rt {1 :set} nil :both)
    ("set?" :rt {1 :set?} nil :both)
    ("disj" :rt {2 :disj} nil :both)
    ("sequential?" :rt {1 :sequential?} nil :both)
    ("sorted-map-of" :rt {1 :sorted_map_of} nil :both)
    ("sorted-set-of" :rt {1 :sorted_set_of} nil :both)
    ("sorted?" :rt {1 :sorted?} nil :both)
    ("last-key" :rt {1 :last_key} nil :both)
    ("last-entry" :rt {1 :last_entry} nil :both)
    ("subseq" :rt {3 :subseq} nil :both)
    ("rsubseq" :rt {3 :rsubseq} nil :both)
    ("sorted-map?" :rt {1 :sorted_map?} nil :both)
    ("sorted-set?" :rt {1 :sorted_set?} nil :both)
    ("sorted-dissoc" :rt {2 :sorted_dissoc} nil :both)
    ("tree-seq" :rt {3 :tree_seq} nil :both)
    ("compare" :rt {2 :compare} nil :both)
    ("sort" :rt {1 :sort 2 :sort} nil :both)
    ("reduced" :rt {1 :reduced} nil :value)
    ("reduced?" :rt {1 :reduced?} nil :value)
    ("reader-macro!" :rt {2 :reader_macro!} nil :both)
    ("data-reader!" :rt {2 :data_reader!} nil :both)
    ("read-data" :rt {1 :read_data} nil :both)
    ;; the numeric tower: values are the variadic closures below; the 2-arity
    ;; call sites link straight into BeamLisp.Num (Erlang spells `<=` as `=<`,
    ;; so no row names an :erlang comparison)
    ("+" :Elixir.BeamLisp.Num {2 :add} nil :link)
    ("-" :Elixir.BeamLisp.Num {1 :neg 2 :sub} nil :link)
    ("*" :Elixir.BeamLisp.Num {2 :mul} nil :link)
    ("/" :Elixir.BeamLisp.Num {2 :div} nil :link)
    ("<" :Elixir.BeamLisp.Num {2 :lt} nil :link)
    (">" :Elixir.BeamLisp.Num {2 :gt} nil :link)
    ("<=" :Elixir.BeamLisp.Num {2 :le} nil :link)
    (">=" :Elixir.BeamLisp.Num {2 :ge} nil :link)
    ("==" :Elixir.BeamLisp.Num {2 :num_eq} nil :link)
    ("=" :rt {2 :eqv} nil :link)
    ;; reference types
    ("atom" :Elixir.BeamLisp.Refs {1 :atom} nil :both)
    ("deref" :Elixir.BeamLisp.Refs {1 :deref 3 :deref} nil :both)
    ("swap!" :Elixir.BeamLisp.Refs {2 :swap!} (2 :swap!) :both)
    ("reset!" :Elixir.BeamLisp.Refs {2 :reset!} nil :both)
    ("compare-and-set!" :Elixir.BeamLisp.Refs {3 :compare_and_set!} nil :both)
    ("add-watch" :Elixir.BeamLisp.Refs {3 :add_watch!} nil :both)
    ("remove-watch" :Elixir.BeamLisp.Refs {2 :remove_watch!} nil :both)
    ("promise" :Elixir.BeamLisp.Refs {0 :promise} nil :both)
    ("deliver" :Elixir.BeamLisp.Refs {2 :deliver} nil :both)
    ("force" :Elixir.BeamLisp.Deferred {1 :force} nil :both)
    ("realized?" :Elixir.BeamLisp.Deferred {1 :realized?} nil :both)
    ("delay?" :Elixir.BeamLisp.Deferred {1 :delay?} nil :both)
    ("derived?" :Elixir.BeamLisp.Reactive {1 :derived?} nil :both)
    ("future?" :Elixir.BeamLisp.Refs {1 :future?} nil :both)
    ("future-cancel" :Elixir.BeamLisp.Refs {1 :future_cancel} nil :both)
    ("volatile!" :Elixir.BeamLisp.Refs {1 :volatile} nil :value)
    ("vreset!" :Elixir.BeamLisp.Refs {2 :vreset!} nil :value)
    ("vswap!" :Elixir.BeamLisp.Refs {2 :vswap!} (2 :vswap!) :value)
    ("volatile?" :Elixir.BeamLisp.Refs {1 :volatile?} nil :value)
    ;; transients
    ("transient" :Elixir.BeamLisp.Transient {1 :transient} nil :both)
    ("persistent!" :Elixir.BeamLisp.Transient {1 :persistent!} nil :both)
    ("conj!" :Elixir.BeamLisp.Transient {1 :conj! 2 :conj!} nil :both)
    ("assoc!" :Elixir.BeamLisp.Transient {3 :assoc!} nil :both)
    ("dissoc!" :Elixir.BeamLisp.Transient {2 :dissoc!} nil :both)
    ("hash-map" :Elixir.BeamLisp.Transient {0 :hash_map_empty} (2 :hash_map) :both)
    ;; the BEAM-native band: supervision and the generic process verbs
    ;; (`gen_server:call` works on any gen_server, so the bare names are ours)
    ("supervise" :Elixir.BeamLisp.Supervisor {2 :supervise 3 :supervise} nil :value)
    ("worker" :Elixir.BeamLisp.Supervisor {2 :worker 3 :worker} nil :value)
    ("start" :Elixir.BeamLisp.Server {1 :start 2 :start 3 :start} nil :value)
    ("start-link" :Elixir.BeamLisp.Server {1 :start_link 2 :start_link 3 :start_link} nil :value)
    ("call" :Elixir.BeamLisp.Server {2 :call 3 :call} nil :value)
    ("cast" :Elixir.BeamLisp.Server {2 :cast} nil :value)
    ("stop" :Elixir.BeamLisp.Server {1 :stop 2 :stop} nil :value)
    ("link" :erlang {1 :link} nil :value)))

; `cpp/*` interop: jank calls its C++ primitives under the `cpp` namespace, so
; the qualified name maps onto a BEAM function with the same semantics and
; upstream core.jank slices load unchanged. Values only.
(defn- seed-cpp-rows
  []
  '(("jank.runtime.name" :rt {1 :name_of} nil)
    ("jank.runtime.namespace_" :rt {1 :namespace_of} nil)
    ("jank.runtime.keyword" :rt {2 :keyword_of} nil)
    ("jank.runtime.reduce" :rt {3 :reduce} nil)
    ("jank.runtime.reduced" :rt {1 :reduced} nil)
    ("jank.runtime.is_reduced" :rt {1 :reduced?} nil)
    ("jank.runtime.peek" :rt {1 :peek} nil)
    ("jank.runtime.pop" :rt {1 :pop} nil)
    ("jank.runtime.promoting_inc" :rt {1 :promoting_inc} nil)
    ("jank.runtime.is_integer" :rt {1 :int?} nil)
    ("jank.runtime.is_ratio" :rt {1 :ratio?} nil)
    ("jank.runtime.is_big_decimal" :rt {1 :decimal?} nil)
    ("jank.runtime.is_sorted" :rt {1 :sorted?} nil)
    ("jank.runtime.is_nan" :rt {1 :nan?} nil)
    ("jank.runtime.is_list" :rt {1 :list?} nil)
    ("jank.runtime.volatile_" :Elixir.BeamLisp.Refs {1 :volatile} nil)
    ("jank.runtime.vreset" :Elixir.BeamLisp.Refs {2 :vreset!} nil)
    ("jank.runtime.vswap" :Elixir.BeamLisp.Refs {2 :vswap! 3 :vswap!} nil)
    ("jank.runtime.is_volatile" :Elixir.BeamLisp.Refs {1 :volatile?} nil)
    ("jank.runtime.bit_not" :rt {1 :bit_not} nil)))

(defn- row-module [m] (if (erlang/== m :rt) :"Elixir.BeamLisp.Ns.Rt" m))

(defn- row-variadic [v] (if (erlang/is_list v) (erlang/list_to_tuple v) nil))

(defn- fn-value
  "The callable a row names — `Emit.fn_value/3`'s rule, over external funs, so
   a seeded value and a compiled `defn` value have one shape."
  [mod fixed variadic]
  (let [capture (fn [a f] (erlang/make_fun mod f a))]
    (if (and (erlang/== 1 (erlang/map_size fixed)) (erlang/== nil variadic))
      (let [pair (erlang/hd (maps/to_list fixed))]
        (capture (erlang/element 1 pair) (erlang/element 2 pair)))
      (multi-fn (maps/map (fn [a f] (capture a f)) fixed)
                (if (erlang/== nil variadic)
                  nil
                  (let [mn (erlang/element 1 variadic)]
                    (tuple2 mn (capture (erlang/+ mn 1) (erlang/element 2 variadic)))))))))

(defn- seed-row [ns row how]
  (let [name (lists/nth 1 row)
        mod (row-module (lists/nth 2 row))
        fixed (lists/nth 3 row)
        variadic (row-variadic (lists/nth 4 row))]
    (when (erlang/=/= how :link)
      (BeamLisp.Env/intern ns name (fn-value mod fixed variadic)))
    (when (erlang/=/= how :value)
      (BeamLisp.Env/put_link ns name (tuple3 mod fixed variadic)))))

; `(< 1 2 3)` is a chain: 1 < 2 AND 2 < 3.
(defn- chain-of
  "`(< a b c)` is `(and (< a b) (< b c))`: `op` over each adjacent pair,
   stopping at the first false."
  [op]
  (multi-fn {} (tuple2 1 (fn [x rest]
    (loop [a x ys rest]
      (cond
        (erlang/== ys ()) true
        (op a (erlang/hd ys)) (recur (erlang/hd ys) (erlang/tl ys))
        :else false))))))

(defn- fold-left [op x rest]
  (lists/foldl (fn [e acc] (op acc e)) x rest))

(defn- seed-closures
  "The `core` values that are closures over a host operation rather than an
   export: the variadic arithmetic and comparison chains, `str`, and the process
   verbs that thread the calling namespace or a fixed argument."
  []
  (let [put (fn [name v] (BeamLisp.Env/intern "core" name v))]
    (put "+" (multi-fn {} (tuple2 0 (fn [args] (fold-left (fn [a b] (BeamLisp.Num/add a b)) 0 args)))))
    (put "*" (multi-fn {} (tuple2 0 (fn [args] (fold-left (fn [a b] (BeamLisp.Num/mul a b)) 1 args)))))
    (put "-" (multi-fn {} (tuple2 1 (fn [x rest]
      (if (erlang/== rest ()) (BeamLisp.Num/neg x) (fold-left (fn [a b] (BeamLisp.Num/sub a b)) x rest))))))
    (put "/" (multi-fn {} (tuple2 1 (fn [x rest]
      (if (erlang/== rest ()) (BeamLisp.Num/div 1 x) (fold-left (fn [a b] (BeamLisp.Num/div a b)) x rest))))))
    (put "<" (chain-of (fn [a b] (BeamLisp.Num/lt a b))))
    (put ">" (chain-of (fn [a b] (BeamLisp.Num/gt a b))))
    (put "<=" (chain-of (fn [a b] (BeamLisp.Num/le a b))))
    (put ">=" (chain-of (fn [a b] (BeamLisp.Num/ge a b))))
    (put "==" (chain-of (fn [a b] (BeamLisp.Num/num_eq a b))))
    (put "=" (chain-of (fn [a b] (eqv a b))))
    ; `str` is a VALUE: the call site's argument count selects the variadic
    ; clause inside the multi-fn, so the constructor is called once, here.
    (put "str" (str))
    (put "trace" (multi-fn {2 (fn [sym h] (BeamLisp.Trace/trace (BeamLisp.Env/current_ns) sym h))
                            3 (fn [sym h opts] (BeamLisp.Trace/trace (BeamLisp.Env/current_ns) sym h opts))}))
    (put "untrace" (fn [sym] (BeamLisp.Trace/untrace (BeamLisp.Env/current_ns) sym)))
    (put "monitor" (fn [p] (erlang/monitor :process p)))
    (put "kill" (fn [p] (erlang/exit p :kill)))))

(defn seed-core
  "Seed `core` (and `cpp`) with the primitives, BEFORE the prelude loads — the
   prelude's own init calls them. Writes into the CURRENT env, so a forked env
   can hold a whole second table (that is how `seed-diff.bl` checks this one)."
  []
  (lists/foreach (fn [row] (seed-row "core" row (lists/last row))) (seed-rows))
  (lists/foreach (fn [row] (seed-row "cpp" row :value)) (seed-cpp-rows))
  (seed-closures)
  :ok)

;; ── the contract's spelling ───────────────────────────────────────────────
; `lib/beam_lisp.ex` calls `seed_core/0`: an underscore, like the rest of the
; contract. Both spellings are exports of this module.
(defn seed_core [] (seed-core))
