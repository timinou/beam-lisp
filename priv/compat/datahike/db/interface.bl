; datahike/db/interface.bl — the datahike.db.interface protocol methods kontor
; calls, as datom projections. kontor uses exactly one: `-schema`, the protocol
; accessor for a db value's schema map (analytic.cljc:91, compliance/period.cljc:146,
; both `(contains? (dbi/-schema db) attr)`). datom keeps the schema on the db
; value, so `-schema` is `datom.db/schema-of`.

(ns datahike.db.interface
  (:require [datom.db]))

(defn -schema
  "The schema map `{attr → def-map}` of a db value (datahike's protocol
   accessor). datom keeps schema on the value; this reads the field."
  [db]
  (datom.db/schema-of db))
