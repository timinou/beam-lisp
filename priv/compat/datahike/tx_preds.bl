; datahike/tx_preds.bl — datahike's writer-run transaction predicates, as datom
; guards. This is kontor's WHOLE integrity story: `govern!` registers
; `validate-report` here so "every committed write is validated post-resolution
; in the writer" (governance.cljc:6-8). kontor reaches it by `requiring-resolve`
; (a soft dependency), so the namespace need only LOAD for W1; the predicate is
; ENFORCED once datom grows `guard!` in W2 (PLAN-115 B3).
;
; datahike keys a tx-pred by STORE-ID and runs it over the resolved report
; before commit, aborting on a non-nil problem list. datom's native equivalent
; is `datom.conn/guard!` (W2): a per-store registry of `(fn [report] → problems)`
; run inside the writer after realize, reusing the speculative `:db-after` that
; `with` already builds. This shim maps datahike's spelling onto it.

(ns datahike.tx-preds
  (:require [datom.conn]))

(defn register-tx-pred!
  "Register `pred` — `(fn [report] → nil | problems)` — as a writer-run guard on
   the store identified by `store-id`. datahike's `register-tx-pred!`, projected
   onto datom's `guard!`."
  [store-id pred]
  (datom.conn/register-store-guard! store-id pred)
  store-id)

(defn unregister-tx-pred!
  "Remove the guard registered for `store-id`."
  [store-id]
  (datom.conn/unregister-store-guard! store-id)
  nil)
