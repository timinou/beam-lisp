; datahike/query.bl — the datahike.query internals kontor reaches for. Two
; names, both about the QUERY layer's configuration rather than its mechanism:
;
;   built-ins          the registry of builtin query-fn symbols. kontor reads
;                      `(keys built-ins)` to whitelist which fn-symbols an
;                      invariant query may call (invariant.cljc:71), and
;                      `(alter-var-root #'built-ins assoc 'subquery d/q)` to add
;                      its own `subquery`. datom resolves query predicates by
;                      NAME from the querying namespace (engine.bl resolve-fn),
;                      so the map's KEYS are what matters; the values are the
;                      standard Datalog builtins, present so `(keys …)` returns
;                      the right whitelist.
;
;   *disable-planner*  a datahike knob that turns off its query planner to dodge
;                      a JVM-planner scope-leak bug (invariant.cljc:296). datom
;                      has no separate planner to disable, so this is an inert
;                      dynamic var: kontor's `(with-bindings {var true} (d/q …))`
;                      runs the same query either way. Kept so the binding form
;                      resolves.
;
; The full builtin SET (get-else / missing? / ground / tuple …) becomes real
; datom query syntax in PLAN-115 W3 (B4); this file only makes the namespace
; load and the whitelist correct.

(ns datahike.query)

(def built-ins
  "The builtin query-fn whitelist. Keys are the symbols an invariant query may
   call; a caller `alter-var-root`s in its own (kontor adds `subquery`). Values
   are placeholders — datom resolves predicates by name at query time, so only
   the key set is read (invariant.cljc `(keys built-ins)`)."
  {'= = 'not= not= '< < '> > '<= <= '>= >=
   '+ + '- - '* * '/ /
   'count count 'sum + 'min min 'max max
   'get-else :get-else 'missing? :missing? 'ground :ground
   'tuple :tuple 'untuple :untuple 'identity identity})

(def ^:dynamic *disable-planner*
  "Inert on datom (no separate planner to disable). Present so kontor's
   `(with-bindings {#'*disable-planner* true} …)` resolves; the query runs the
   same regardless."
  false)
