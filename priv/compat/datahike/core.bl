; datahike/core.bl — the two datahike.core internals kontor reaches for, as
; projections of datom. Not the whole of datahike.core: only `empty-db`,
; `db-with` and `with`, which kontor's invariant + governance engines use to
; build a SCRATCH database value to join against (`$empty+txs`) without touching
; the real connection.
;
; ── empty-db is the interesting one ────────────────────────────────────────
;
; datahike's `empty-db` returns a standalone db VALUE with a schema and no
; connection — a scratch graph you seed with `db-with` and read with `q`, never
; commit. datom's speculative machinery is conn-scoped (`with` → `:db-after`
; over a store-overlay), so `empty-db` opens an EPHEMERAL in-memory datom conn,
; installs the schema, and hands back its db value. `db-with` then extends it
; through that conn (recovered by `conn-of`). The conn is unregistered scratch;
; nothing external ever sees it, which is exactly datahike's `empty-db`
; contract.

(ns datahike.core
  (:require [datom.conn]
            [datom.db]
            [datahike.api]))

(defn empty-db
  "A fresh, standalone database value with `schema` installed. `opts` (e.g.
   `:schema-flexibility`) is accepted and ignored — datom validates schema by
   the attribute definitions themselves, not a flexibility mode. The value is
   backed by an ephemeral in-memory conn so `db-with` can extend it and `q` can
   read it; that conn is scratch and unregistered."
  ([] (empty-db [] {}))
  ([schema] (empty-db schema {}))
  ([schema _opts]
   (let [c (datom.conn/connect [])]
     (when (seq schema) (datom.conn/install-schema! c (into [] schema)))
     (datom.conn/db c))))

(defn db-with
  "The db value that would result from applying `tx-data` to db `db`, without
   committing — datahike.core's spelling of the same speculative read the public
   `datahike.api/db-with` performs."
  [db tx-data]
  (datahike.api/db-with db tx-data))

(defn with
  "The speculative report `{:db-before :db-after :tx-data :tempids}` for applying
   `tx-data` to `db` — datahike.core's `with`, projected onto datom's conn-scoped
   `with` via the db's connection."
  [db tx-data]
  (datom.conn/with (datom.conn/conn-of db) (into [] tx-data)))
