; fs.bl — a useful subset of babashka.fs, native on the BEAM.
;
; babashka.fs is the filesystem library nearly every bb script reaches for. On
; the JVM it wraps java.nio; here it wraps Elixir's `File` and `Path` (which are
; grapheme-correct and OTP-backed). The names and contracts follow babashka.fs
; (https://github.com/babashka/fs); paths are plain strings (bb.fs uses
; java.nio.Path, but strings interoperate with every fn here and are what a
; script writes as a literal).
;
; Scope: the operations scripts actually use — existence/type predicates, path
; manipulation, directory listing and globbing, create/delete/copy, and
; read/write. Not the full nio surface; a recorded, honest subset.
;
; The oracle is test/bl/compat/fs_test.bl (round-trips against a temp dir).

(ns babashka.fs
  (:require [clojure.core-ext]))

;; ── predicates ───────────────────────────────────────────────────────────────

(defn exists?
  "True when something exists at `path`."
  [path]
  (File/exists? path))

(defn directory?
  "True when `path` is a directory."
  [path]
  (File/dir? path))

(defn regular-file?
  "True when `path` is a regular file."
  [path]
  (File/regular? path))

;; ── path manipulation ────────────────────────────────────────────────────────

(defn file-name
  "The final segment of `path` (basename)."
  [path]
  (Path/basename path))

(defn parent
  "The parent directory of `path`, or nil at a filesystem root."
  [path]
  (let [d (Path/dirname path)]
    (if (= d path) nil d)))

(defn extension
  "The file extension of `path` WITHOUT the dot (\"txt\"), or nil when there is
   none. (babashka.fs/extension drops the leading dot.)"
  [path]
  (let [e (Path/extname path)]
    (if (= "" e) nil (subs e 1))))

(defn path
  "Join path segments into one path string (babashka.fs/path)."
  [& segments]
  (reduce (fn [acc seg] (Path/join acc seg)) (first segments) (rest segments)))

(defn absolutize
  "The absolute form of `path`, resolved against the current directory."
  [path]
  (Path/absname path))

(defn canonicalize
  "The canonical (expanded, `~`-resolved) form of `path`."
  [path]
  (Path/expand path))

;; ── listing / globbing ───────────────────────────────────────────────────────

(defn list-dir
  "A vector of the immediate children of directory `dir`, each as a full path
   (dir joined to the entry name). babashka.fs/list-dir."
  [dir]
  (vec (map (fn [entry] (Path/join dir entry)) (File/ls! dir))))

(defn glob
  "A vector of paths under `root` matching the wildcard `pattern` (e.g.
   \"*.edn\" or \"**/*.bl\"). Uses Elixir's Path.wildcard, joining the pattern
   onto `root`. babashka.fs/glob (simplified: returns strings, not nio Paths)."
  [root pattern]
  (vec (Path/wildcard (Path/join root pattern))))

;; ── create / delete / copy ───────────────────────────────────────────────────

(defn create-dirs
  "Creates directory `path` and every missing parent (mkdir -p). Idempotent."
  [path]
  (File/mkdir_p! path)
  path)

(defn delete
  "Deletes the file or empty directory at `path`. Raises if it cannot be
   deleted; a no-op contract is `delete-if-exists`."
  [path]
  (File/rm! path)
  nil)

(defn delete-tree
  "Recursively deletes `path` and everything under it (rm -rf). Idempotent."
  [path]
  (File/rm_rf! path)
  nil)

(defn delete-if-exists
  "Deletes `path` if it exists, returning true when it did, false otherwise."
  [path]
  (if (File/exists? path)
    (do (File/rm_rf! path) true)
    false))

(defn copy
  "Copies the file `src` to `dest`, returning `dest`."
  [src dest]
  (File/cp! src dest)
  dest)

;; ── read / write ─────────────────────────────────────────────────────────────

(defn read-all-string
  "Reads the whole file at `path` into a string (babashka.fs has slurp-like
   helpers; this is the direct one)."
  [path]
  (File/read! path))

(defn write-all-string
  "Writes string `content` to `path`, replacing it. Returns `path`."
  [path content]
  (File/write! path content)
  path)

;; ── working directory ─────────────────────────────────────────────────────────

(defn cwd
  "The current working directory as a path string."
  []
  (File/cwd!))

(defn home
  "The user's home directory."
  []
  (System/user_home))
