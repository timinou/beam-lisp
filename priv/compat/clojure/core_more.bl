; core_more.bl — clojure.core names an unmodified library reaches for that the
; prelude did not have, each projected onto what beam-lisp already owns:
;
;   defonce            → `def` guarded by `Env.local_var?` (the var, not a flag)
;   alter-var-root     → `Env.intern` of `(f current)`
;   intern             → `Env.intern` (3-arity) in a NAMED ns
;   bound?  var?  resolve  ns-resolve
;                      → questions to `BeamLisp.Env`; a "var" here is the
;                        `{ns name}` handle the environment already keys on
;   hash               → `:erlang.phash2`, total over every value
;   random-uuid  uuid? → canonical 36-char text (there is no UUID class)
;   inst-ms  inst?     → an instant IS epoch milliseconds (datom's :db.type/instant)
;   parse-long  parse-double
;   long  double  int  → coercions that RAISE on a lossy input rather than
;                        truncate silently; a decimal converts by its own rules
;   format             → the printf subset `%s %d %f %.Nf %x %% %-Ns %0Nd`
;                        over io_lib; an unsupported directive is an error
;                        naming it, never silent garbage
;   locking            → the body, unlocked: BEAM processes share nothing, so
;                        there is nothing to lock. Kept so the form compiles.
;
; Installed into `core` on load (the same `install!` pattern as core_ext.bl),
; so a plain `(defonce x …)` resolves in any namespace once `clojure.string`
; or this file has been required — and the bb-compat loader tier requires it
; for every `.clj`/`.cljc` source.

(ns clojure.core-more
  (:require [decimal :as d]
            [clojure.core-ext]
            [clojure.re :refer [re-pattern re-matches re-find]]))

;; ── vars ──────────────────────────────────────────────────────────────

(defmacro defonce
  "Define `name` to `expr` unless the var already exists in this namespace —
   the guard is the var itself, so a reload keeps the live value."
  [name expr]
  (let [ns (BeamLisp.Env/current_ns)]
    `(if (BeamLisp.Env/local_var? ~ns ~(str name))
       (BeamLisp.Env/fetch! ~ns ~(str name))
       (def ~name ~expr))))

(defn- var-handle [x]
  (cond
    (and (vector? x) (= 2 (count x))) x
    (symbol? x)
      (let [s (str x) i (index-of s "/")]
        (if (nil? i)
          [(BeamLisp.Env/current_ns) s]
          [(subs s 0 i) (subs s (inc i))]))
    :else (throw (ex-info (str "not a var: " (pr-str x)) {:value x}))))

(defn var?
  "True for a var handle `[ns name]` whose var exists."
  [x]
  (and (vector? x) (= 2 (count x)) (BeamLisp.Env/bound? (first x) (second x))))

(defn bound?
  "True when every var (a handle or a symbol) has a value."
  [& vars]
  (every? (fn [v] (let [[ns n] (var-handle v)] (BeamLisp.Env/bound? ns n))) vars))

(defn resolve
  "The var handle `[ns name]` a symbol names from the current namespace, or nil."
  [sym]
  (let [[ns n] (var-handle sym)
        r (BeamLisp.Env/fetch ns n)]
    (if (= r :error) nil [ns n])))

(defn ns-resolve
  [ns sym]
  (let [n (str sym) i (index-of n "/")]
    (if (nil? i)
      (if (= :error (BeamLisp.Env/fetch (str ns) n)) nil [(str ns) n])
      (resolve sym))))

(defn alter-var-root
  "Set the var to `(f current args…)` and return the new value."
  [v f & args]
  (let [[ns n] (var-handle v)
        cur (BeamLisp.Env/fetch! ns n)
        new (apply f cur args)]
    (BeamLisp.Env/intern ns n new)
    new))

(defn intern
  "Intern `name` in namespace `ns` (a symbol or string) with `value`."
  ([ns name] (intern ns name nil))
  ([ns name value]
   (BeamLisp.Env/declare_ns (str ns))
   (BeamLisp.Env/intern (str ns) (str name) value)
   [(str ns) (str name)]))

(defmacro locking
  "The body, unlocked: a BEAM process shares no memory, so a monitor has
   nothing to guard. The lock expression is still evaluated for its effects."
  [x & body]
  `(do ~x ~@body))

;; ── values ────────────────────────────────────────────────────────────

(defn hash
  "A total, stable hash of any value."
  [x]
  (erlang/phash2 x))

(defn random-uuid
  "A random v4 UUID as its canonical lowercase 36-character text."
  []
  (let [b (crypto/strong_rand_bytes 16)
        hex (String/downcase (Base/encode16 b))
        ; version 4 in the 13th nibble, variant 10xx in the 17th
        v (str (subs hex 0 12) "4" (subs hex 13 16)
               (subs "89ab" (let [k (rem (erlang/binary_to_integer (subs hex 16 17) 16) 4)] k) (inc (rem (erlang/binary_to_integer (subs hex 16 17) 16) 4)))
               (subs hex 17 32))]
    (str (subs v 0 8) "-" (subs v 8 12) "-" (subs v 12 16) "-" (subs v 16 20) "-" (subs v 20 32))))

(defn uuid?
  [x]
  (and (string? x)
       (some? (re-matches (re-pattern "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}") x))))

(defn inst-ms
  "An instant is its epoch milliseconds already."
  [x]
  x)

(defn inst?
  [x]
  (int? x))

(defn parse-long
  "The integer `s` spells, or nil — Clojure's contract (no exception)."
  [s]
  (if (string? s)
    (let [r (string/to_integer (erlang/binary_to_list s))]
      (if (and (not= :error (erlang/element 1 r)) (empty? (erlang/element 2 r)))
        (erlang/element 1 r)
        nil))
    nil))

(defn parse-double
  [s]
  (if (string? s)
    (let [r (Float/parse s)]
      (if (and (tuple? r) (= "" (erlang/element 2 r))) (erlang/element 1 r) nil))
    nil))

(defn long
  "Coerce to an integer: an integer is itself, a float truncates toward zero,
   a decimal converts by its own rule, a char is its codepoint."
  [x]
  (cond
    (int? x) x
    (float? x) (erlang/trunc x)
    (d/decimal? x) (d/->long x)
    :else (throw (ex-info (str "cannot coerce to long: " (pr-str x)) {:value x}))))

(defn double
  [x]
  (cond
    (float? x) x
    (int? x) (* 1.0 x)
    (d/decimal? x) (d/->double x)
    :else (throw (ex-info (str "cannot coerce to double: " (pr-str x)) {:value x}))))

;; ── format ────────────────────────────────────────────────────────────

(defn- fmt-directive
  "One `%…` directive against one arg → its text. The subset an application
   library uses: s d f x X e with optional `-`, `0`, width and `.precision`."
  [flags width prec conv arg]
  (let [left? (some? (index-of flags "-"))
        zero? (some? (index-of flags "0"))
        body (cond
               (= conv "s") (if (string? arg) arg (pr-str arg))
               (= conv "d") (str (long arg))
               (= conv "f") (let [p (if (nil? prec) 6 prec)
                                  v (if (d/decimal? arg) arg (d/from-float (double arg)))]
                              (d/plain-str (d/rescale v p :half-up)))
               (= conv "e") (erlang/list_to_binary (io_lib/format (str "~." (if (nil? prec) 6 prec) "e") (list (double arg))))
               (= conv "x") (String/downcase (erlang/integer_to_binary (long arg) 16))
               (= conv "X") (erlang/integer_to_binary (long arg) 16)
               :else (throw (ex-info (str "format: unsupported directive %" conv) {:directive conv})))
        pad (if (nil? width) 0 (- width (count body)))]
    (cond
      (<= pad 0) body
      left? (str body (apply str (repeat pad " ")))
      (and zero? (not= conv "s")) (if (starts-with? body "-")
                                     (str "-" (apply str (repeat pad "0")) (subs body 1))
                                     (str (apply str (repeat pad "0")) body))
      :else (str (apply str (repeat pad " ")) body))))

(defn format
  "`(format \"%s owes %.2f\" who amt)` — the printf directives an accounting
   library uses; `%%` is a literal percent. Unsupported directives raise."
  [fmt & args]
  (let [re (re-pattern "%(-?0?)(\\d+)?(?:\\.(\\d+))?([sdfeExX%])")]
    (loop [s fmt args args out ""]
      (let [m (re-find re s)]
        (if (nil? m)
          (str out s)
          (let [whole (first m)
                i (index-of s whole)
                flags (nth m 1)
                width (let [w (nth m 2)] (if (or (nil? w) (= w "")) nil (parse-long w)))
                prec (let [p (nth m 3)] (if (or (nil? p) (= p "")) nil (parse-long p)))
                conv (nth m 4)
                before (subs s 0 i)
                after (subs s (+ i (count whole)))]
            (if (= conv "%")
              (recur after args (str out before "%"))
              (do (when (empty? args)
                    (throw (ex-info "format: not enough arguments" {:format fmt})))
                  (recur after (rest args)
                         (str out before (fmt-directive flags width prec conv (first args))))))))))))

;; ── install into core ─────────────────────────────────────────────────

(defn install!
  []
  (doseq [[n v] [["var?" var?] ["bound?" bound?] ["resolve" resolve] ["ns-resolve" ns-resolve]
                 ["alter-var-root" alter-var-root] ["intern" intern]
                 ["hash" hash] ["random-uuid" random-uuid] ["uuid?" uuid?]
                 ["inst-ms" inst-ms] ["inst?" inst?]
                 ["parse-long" parse-long] ["parse-double" parse-double]
                 ["long" long] ["double" double] ["format" format]]]
    (BeamLisp.Env/intern "core" n v))
  ; a macro is a var whose value is the tagged `{:"$macro", fn}` — copying
  ; the value copies the macro
  (doseq [n ["defonce" "locking"]]
    (BeamLisp.Env/intern "core" n (BeamLisp.Env/fetch! "clojure.core-more" n)))
  :installed)

(def ^:private __core-more-installed (install!))
