; core_ext.bl — the handful of clojure.core scalar/predicate functions that
; beam-lisp's prelude does not already ship, provided here so unmodified
; Clojure/Babashka code resolves them with no require (they are interned into
; `core` on load, like clojure.re's regex surface).
;
; Kept deliberately small: this is NOT a place to re-home core. It holds only
; names that (a) are clojure.core on the JVM, (b) real bb scripts use, and
; (c) are genuinely absent from priv/boot/core.bl. Each is a thin, total
; delegation to a BEAM primitive.

(ns clojure.core-ext)

;; ── characters (integer codepoints on the BEAM) ──────────────────────────────

(defn char
  "Coerce `x` to a character. On the BEAM a character IS its integer codepoint,
   so an integer passes through and a one-grapheme string yields its codepoint.
   Mirrors clojure.core/char closely enough for the code that calls it (mostly
   `(char N)` to name a codepoint a reader literal can't spell, e.g. `\\,`)."
  [x]
  (cond
    (erlang/is_integer x) x
    (and (erlang/is_binary x) (= 1 (String/length x))) (first (String/to_charlist x))
    :else (throw (ex-info "char: not coercible to a character" {:value x}))))

(defn char?
  "True when `x` is a character, an integer in the Unicode codepoint range.
   (beam-lisp represents characters as their codepoints.)"
  [x]
  (and (erlang/is_integer x) (>= x 0) (<= x 1114111)))

;; (integer?/true?/false?/boolean?/double?/pos-int?/neg-int?/nat-int? and a
;; variadic conj now live in core itself.)

;; ── string coercions clojure.core has and are handy at boundaries ────────────

(defn hash-set
  "Returns a set of the given values (clojure.core/hash-set). beam-lisp has one
   unordered set type, so this is (set of the args)."
  [& xs]
  (set xs))

;; ── collection helpers (clojure.core) ────────────────────────────────────────

(defn empty
  "Returns an empty collection of the same category as `coll`, or nil if `coll`
   is not a collection. clojure.core/empty. Extends the prelude's `empty-like`
   (which never returns a list) with the list/seq case, so clojure.walk can
   rebuild a list as a list."
  [coll]
  (cond
    (nil? coll) nil
    (list? coll) (list)
    (seq? coll) (list)
    (vector? coll) []
    (set? coll) (set [])
    (map? coll) (empty-like coll)
    :else nil))

(defn vector
  "Creates a new vector containing the args (clojure.core/vector)."
  [& xs]
  (vec xs))

(defn map-entry?
  "True when `x` is a map entry. beam-lisp yields map entries in two shapes
   depending on the traversal: `seq`/`first`/`reduce` produce a 2-element
   `%Vector{}`, while `map` over a map produces a raw 2-tuple. Both are entries,
   and `key`/`val` read either, so both count here."
  [x]
  (or (and (vector? x) (= 2 (count x)))
      (and (erlang/is_tuple x) (= 2 (erlang/tuple_size x)))))

(defn record?
  "True when `x` is a defrecord instance."
  [x]
  (BeamLisp.Record/record? x))

(defn macroexpand
  "Repeatedly macroexpands `form` in the current namespace until it is no longer
   a macro call (clojure.core/macroexpand). Single-step expansion is the
   compiler's `macroexpand-1`; this iterates to a fixpoint."
  [form]
  (let [ns (BeamLisp.Env/current_ns)]
    (loop [f form]
      (let [expanded (BeamLisp.Ns.Compiler/macroexpand_1 f ns)]
        (if (identical? expanded f)
          f
          (recur expanded))))))

;; ── intern into core so bare calls resolve everywhere ────────────────────────

(defn install!
  "Intern the clojure.core-ext surface into `core` for unqualified resolution."
  []
  (BeamLisp.Env/intern "core" "char" char)
  (BeamLisp.Env/intern "core" "char?" char?)
  (BeamLisp.Env/intern "core" "hash-set" hash-set)
  (BeamLisp.Env/intern "core" "empty" empty)
  (BeamLisp.Env/intern "core" "vector" vector)
  (BeamLisp.Env/intern "core" "map-entry?" map-entry?)
  (BeamLisp.Env/intern "core" "record?" record?)
  (BeamLisp.Env/intern "core" "macroexpand" macroexpand)
  :installed)

(def ^:private __core-ext-installed (install!))
