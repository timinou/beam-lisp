; core_ext.bl — the handful of clojure.core scalar/predicate functions that
; beam-lisp's prelude does not already ship, provided here so unmodified
; Clojure/Babashka code resolves them with no require (they are interned into
; `core` on load, like clojure.re's regex surface).
;
; Kept deliberately small: this is NOT a place to re-home core. It holds only
; names that (a) are clojure.core on the JVM, (b) real bb scripts use, and
; (c) are genuinely absent from priv/boot/core.bl. Each is a thin, total
; delegation to a BEAM primitive.

(ns clojure.core-ext)

;; ── characters (integer codepoints on the BEAM) ──────────────────────────────

(defn char
  "Coerce `x` to a character. On the BEAM a character IS its integer codepoint,
   so an integer passes through and a one-grapheme string yields its codepoint.
   Mirrors clojure.core/char closely enough for the code that calls it (mostly
   `(char N)` to name a codepoint a reader literal can't spell, e.g. `\\,`)."
  [x]
  (cond
    (erlang/is_integer x) x
    (and (erlang/is_binary x) (= 1 (String/length x))) (first (String/to_charlist x))
    :else (throw (ex-info "char: not coercible to a character" {:value x}))))

(defn char?
  "True when `x` is a character, an integer in the Unicode codepoint range.
   (beam-lisp represents characters as their codepoints.)"
  [x]
  (and (erlang/is_integer x) (>= x 0) (<= x 1114111)))

;; numeric / boolean predicates that are clojure.core but absent from the prelude
(defn integer? "True when `x` is an integer." [x] (erlang/is_integer x))
(defn true? "True when `x` is the value true." [x] (erlang/=:= x true))
(defn false? "True when `x` is the value false." [x] (erlang/=:= x false))
(defn boolean? "True when `x` is true or false." [x] (erlang/is_boolean x))
(defn double? "True when `x` is a float (Clojure double)." [x] (erlang/is_float x))
(defn pos-int? "True when `x` is a positive integer." [x] (and (erlang/is_integer x) (> x 0)))
(defn neg-int? "True when `x` is a negative integer." [x] (and (erlang/is_integer x) (< x 0)))
(defn nat-int? "True when `x` is a non-negative integer." [x] (and (erlang/is_integer x) (>= x 0)))

;; ── string coercions clojure.core has and are handy at boundaries ────────────

(defn hash-set
  "Returns a set of the given values (clojure.core/hash-set). beam-lisp has one
   unordered set type, so this is (set of the args)."
  [& xs]
  (set xs))

;; ── variadic conj ────────────────────────────────────────────────────────────

(defn conj
  "clojure.core/conj: (conj coll x & xs). beam-lisp's core `conj` primitive is
   1- and 2-arity only; Clojure's is variadic. This folds the extra elements
   through the 2-arity primitive (BeamLisp.RT/conj) left-to-right, so vendored
   Clojure source that writes `(conj coll a b c)` (clojure.set does, in its
   variadic union/intersection/difference) behaves exactly as upstream. The
   0-arity `(conj)` returns [] and the 1-arity `(conj coll)` returns coll, both
   as in Clojure."
  ([] [])
  ([coll] coll)
  ([coll x] (BeamLisp.RT/conj coll x))
  ([coll x & xs] (reduce (fn [c y] (BeamLisp.RT/conj c y)) (BeamLisp.RT/conj coll x) xs)))

;; ── intern into core so bare calls resolve everywhere ────────────────────────

(defn install!
  "Intern the clojure.core-ext surface into `core` for unqualified resolution."
  []
  (BeamLisp.Env/intern "core" "char" char)
  (BeamLisp.Env/intern "core" "char?" char?)
  (BeamLisp.Env/intern "core" "hash-set" hash-set)
  (BeamLisp.Env/intern "core" "conj" conj)
  (BeamLisp.Env/intern "core" "integer?" integer?)
  (BeamLisp.Env/intern "core" "true?" true?)
  (BeamLisp.Env/intern "core" "false?" false?)
  (BeamLisp.Env/intern "core" "boolean?" boolean?)
  (BeamLisp.Env/intern "core" "double?" double?)
  (BeamLisp.Env/intern "core" "pos-int?" pos-int?)
  (BeamLisp.Env/intern "core" "neg-int?" neg-int?)
  (BeamLisp.Env/intern "core" "nat-int?" nat-int?)
  :installed)

(def ^:private __core-ext-installed (install!))
