; io.bl — the clojure.core IO surface (slurp, spit) and *command-line-args*,
; native on the BEAM. These are what turn a beam-lisp file into a runnable
; Babashka-style SCRIPT: read a file, process, write a file, read argv.
;
; ── What is reproduced ───────────────────────────────────────────────────────
;
;   slurp                 read a whole file (or path) into a string
;   spit                  write a string to a file (:append option supported)
;   *command-line-args*   the seq of arguments after `--` on the command line,
;                         exactly as Babashka/Clojure expose it
;   line-seq / read-lines a file's lines
;
; slurp/spit and *command-line-args* are clojure.core on the JVM (no require).
; Loading this namespace interns them into `core`, so unmodified script code
; that says `(slurp "data.edn")` or reads `*command-line-args*` resolves with no
; require — the same reach they have in Clojure/bb.
;
; The oracle is test/bl/compat/io_test.bl (round-trips through a temp file).

(ns clojure.io
  (:require [clojure.core-ext]))

;; ── slurp / spit ─────────────────────────────────────────────────────────────

(defn slurp
  "Reads the file at `path` and returns its entire contents as a string. Raises
   if the file cannot be read. (Clojure's slurp also accepts readers/URLs/etc.;
   the file-path case is the one scripts overwhelmingly use.)"
  [path]
  (File/read! path))

(defn spit
  "Writes `content` (coerced to a string) to the file at `path`, replacing it.
   With `:append true` in the trailing options, appends instead. Mirrors
   clojure.core/spit's common forms."
  [path content & opts]
  (let [s (str content)
        options (apply hash-map opts)]
    (if (get options :append)
      (File/write! path s (list :append))
      (File/write! path s))
    nil))

;; ── lines ────────────────────────────────────────────────────────────────────

(defn read-lines
  "Reads the file at `path` and returns a vector of its lines (newline stripped),
   the eager whole-file counterpart to clojure.core/line-seq. A single trailing
   newline does NOT produce a trailing empty line, matching line-seq (a file
   ending in `\n` has N lines, not N+1)."
  [path]
  (let [content (File/read! path)]
    (cond
      (= "" content) []
      :else
        (let [lines (vec (String/split content (Regex/compile! "\\r?\\n")))]
          ; drop a single trailing empty caused by a terminal newline
          (if (and (pos? (count lines)) (= "" (peek lines)))
            (pop lines)
            lines)))))

(defn line-seq
  "Returns the lines of the file at `path` as a seq (eager here). clojure.core's
   line-seq takes a BufferedReader; a script almost always wants a path, so this
   accepts a path and returns its lines."
  [path]
  (read-lines path))

;; ── *command-line-args* ──────────────────────────────────────────────────────
;;
;; The program arguments after `--` on the command line. In beam-lisp these come
;; from `BeamLisp.argv/0` (the same source `bl run FILE -- a b c` binds). Exposed
;; as a plain var, refreshed on load, and interned into core so a script reads a
;; bare `*command-line-args*` exactly as under Clojure/bb.

(defn current-command-line-args
  "The current program arguments as a seq of strings (after `--`)."
  []
  (BeamLisp/argv))

;; ── intern the clojure.core surface ──────────────────────────────────────────

(defn install!
  "Intern slurp / spit / line-seq / read-lines and a *command-line-args* var
   into `core` for unqualified resolution, matching clojure.core."
  []
  (BeamLisp.Env/intern "core" "slurp" slurp)
  (BeamLisp.Env/intern "core" "spit" spit)
  (BeamLisp.Env/intern "core" "read-lines" read-lines)
  (BeamLisp.Env/intern "core" "line-seq" line-seq)
  ; NB: `*command-line-args*` is intentionally NOT interned here. Namespace
  ; loading runs in the pinned Loader.Server process, whose process-dictionary
  ; has no `:bl_argv` binding — so `(BeamLisp/argv)` here would snapshot an empty
  ; list and clobber the real value. Instead `BeamLisp.run_file/1` interns the
  ; live argv into `core` just before evaluating the script (see beam_lisp.ex),
  ; which is the process that actually holds the binding. A script that wants
  ; the value programmatically at any point can call
  ; `(clojure.io/current-command-line-args)`.
  :installed)

(def ^:private __io-installed (install!))
