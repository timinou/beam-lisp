; java_io.bl — a path-oriented subset of clojure.java.io, native on the BEAM.
;
; clojure.java.io wraps java.io around a coercion protocol (IOFactory) turning
; strings/Files/URLs into readers/writers/streams. The BEAM has no java.io; what
; scripts actually use from this namespace is a small set:
;   file           name a path (here: return the path string; bb.fs/File-like)
;   make-parents   create the parent directories of a path
;   delete-file    delete a file
;   copy           copy file contents
;   as-file        coerce to a path
;   reader/writer  open for reading/writing (here: eager slurp/spit helpers,
;                  since the BEAM IO model is not java.io streams)
;
; This provides those over Elixir File/Path, so `(require '[clojure.java.io :as
; io])` + `(io/file a b)` / `(io/make-parents path)` resolve. It is a recorded
; SUBSET: the stream/URL/resource surface is not reproduced (no java.io).
;
; The oracle is test/bl/compat/java_io_test.bl.

(ns clojure.java.io
  (:require [clojure.core-ext]))

(defn file
  "Names a file path from one or more segments (clojure.java.io/file). On the
   JVM this returns a java.io.File; here it returns the joined PATH STRING, which
   every fn in this namespace and in babashka.fs accepts."
  [& segments]
  (if (= 1 (count segments))
    (first segments)
    (reduce (fn [acc s] (Path/join acc s)) (first segments) (rest segments))))

(defn as-file
  "Coerces `x` to a path string (the identity on a string here)."
  [x]
  (str x))

(defn make-parents
  "Creates every parent directory of `path` (java.io.File/mkdirs on the parent).
   Returns true if any directory was created. clojure.java.io/make-parents."
  [path]
  (let [parent (Path/dirname path)]
    (if (File/exists? parent)
      false
      (do (File/mkdir_p! parent) true))))

(defn delete-file
  "Deletes the file at `path`. With a truthy `silently` second arg, a missing
   file is not an error. clojure.java.io/delete-file."
  ([path] (File/rm! path) nil)
  ([path silently]
   (if silently
     (do (when (File/exists? path) (File/rm! path)) nil)
     (do (File/rm! path) nil))))

(defn copy
  "Copies the contents of file `src` to file `dest` (both paths). A simplified
   clojure.java.io/copy covering the file-to-file case scripts use."
  [src dest]
  (File/cp! src dest)
  nil)

(defn reader
  "Opens `path` for reading. The BEAM IO model is not java.io streams, so this
   eagerly returns the file's CONTENTS as a string \u2014 a script that does
   `(slurp (io/reader path))` or `(line-seq (io/reader path))` still works,
   because slurp/line-seq accept the string/path. A recorded simplification."
  [path]
  (File/read! path))

(defn writer
  "Returns a writer handle for `path`. The BEAM has no java.io.Writer; this
   returns the path itself so `(spit (io/writer path) content)` still targets
   the right file. A recorded simplification."
  [path]
  path)
