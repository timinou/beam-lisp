; walk.bl — Clojure's clojure.walk, native on the BEAM.
;
; ── Why a light reimplementation ─────────────────────────────────────────────
;
; clojure.walk's `walk` dispatches on host interfaces — `clojure.lang.IMapEntry`,
; `clojure.lang.IRecord`, `clojure.lang.MapEntry/create` — none of which exist on
; the BEAM. Everything ELSE in the file (postwalk, prewalk, keywordize-keys,
; stringify-keys, the -replace and -demo helpers, macroexpand-all) is pure over
; `walk` and is reproduced VERBATIM. Only `walk` itself is re-expressed against
; beam-lisp's shapes:
;   * a map entry is a 2-element `%BeamLisp.Vector{}` (what `(first a-map)` and
;     `seq` over a map yield); `(key e)`/`(val e)` read it.
;   * `(into (empty coll) …)` rebuilds a collection of the same type; beam-lisp
;     has `empty` for vector/map/set/list (added to clojure.core-ext).
;   * records are `map?` here, so the IRecord branch folds into the map branch
;     (rebuilding a record by conj'ing entries is the same operation).
;
; The oracle is Clojure's own walk test suite, vendored in
; test/bl/compat/walk_test.bl.

(ns clojure.walk
  (:require [clojure.core-ext]))

(defn walk
  "Traverses `form`, an arbitrary data structure. `inner` and `outer` are
   functions. Applies `inner` to each element of `form`, building up a data
   structure of the same type, then applies `outer` to the result. Recognizes
   all beam-lisp data structures. Consumes seqs as with `doall`.

   Reproduces clojure.walk/walk; the host-interface dispatch (IMapEntry,
   IRecord) is re-expressed against beam-lisp's shapes — a map entry is a
   2-vector, and records answer `map?`."
  [inner outer form]
  (cond
    (list? form)
      (outer (with-meta (apply list (map inner form)) (meta form)))
    ; a RAW 2-TUPLE map entry (what `(map f a-map)` yields): walk key then value
    ; and return a 2-vector, the MapEntry shape. NB this matches only a tuple,
    ; never a 2-element VECTOR — a `[1 2]` vector is ordinary data (Clojure
    ; distinguishes MapEntry from vector; CLJ-2031), and treating it as an entry
    ; here would drop its metadata and mis-handle the walk-mapentry case. The
    ; map branch below normalizes its tuple entries to vectors before recursing,
    ; so a vector reaching `walk` is genuine vector data and flows through the
    ; coll? branch (which preserves meta).
    (and (erlang/is_tuple form) (= 2 (erlang/tuple_size form)))
      (let [wk (inner (key form))
            wv (inner (val form))]
        (outer (vector wk wv)))
    (seq? form)
      (outer (with-meta (doall (map inner form)) (meta form)))
    ; maps (and records, which are maps here): rebuild by conj'ing walked
    ; entries. beam-lisp's `(map f a-map)` yields entries as raw 2-tuples, but
    ; Clojure hands `inner` a MapEntry (a 2-vector) — and code like CLJ-2031's
    ; walk-mapentry test depends on seeing a vector. So normalize each entry to
    ; a 2-vector BEFORE applying inner.
    (map? form)
      (outer (with-meta (into (empty form)
                              (map (fn [e] (inner (vector (key e) (val e)))) form))
                        (meta form)))
    (coll? form)
      (outer (with-meta (into (empty form) (map inner form)) (meta form)))
    :else (outer form)))

(defn postwalk
  "Performs a depth-first, post-order traversal of `form`. Calls `f` on each
   sub-form, uses `f`'s return value in place of the original. Recognizes all
   beam-lisp data structures. Consumes seqs as with `doall`."
  [f form]
  (walk (fn [x] (postwalk f x)) f form))

(defn prewalk
  "Like postwalk, but does pre-order traversal."
  [f form]
  (walk (fn [x] (prewalk f x)) identity (f form)))

(defn postwalk-demo
  "Demonstrates the behavior of postwalk by printing each form as it is walked.
   Returns form."
  [form]
  (postwalk (fn [x] (do (print "Walked: ") (prn x) x)) form))

(defn prewalk-demo
  "Demonstrates the behavior of prewalk by printing each form as it is walked.
   Returns form."
  [form]
  (prewalk (fn [x] (do (print "Walked: ") (prn x) x)) form))

(defn keywordize-keys
  "Recursively transforms all map keys from strings to keywords."
  [m]
  (let [f (fn [e]
            (let [k (key e) v (val e)]
              (if (string? k) (vector (keyword k) v) (vector k v))))]
    (postwalk (fn [x] (if (map? x) (into {} (map f x)) x)) m)))

(defn stringify-keys
  "Recursively transforms all map keys from keywords to strings."
  [m]
  (let [f (fn [e]
            (let [k (key e) v (val e)]
              (if (keyword? k) (vector (name k) v) (vector k v))))]
    (postwalk (fn [x] (if (map? x) (into {} (map f x)) x)) m)))

(defn prewalk-replace
  "Recursively transforms `form` by replacing keys in `smap` with their values.
   Like clojure.core/replace but works on any data structure. Does replacement
   at the root of the tree first."
  [smap form]
  (prewalk (fn [x] (if (contains? smap x) (get smap x) x)) form))

(defn postwalk-replace
  "Recursively transforms `form` by replacing keys in `smap` with their values.
   Like clojure.core/replace but works on any data structure. Does replacement
   at the leaves of the tree first."
  [smap form]
  (postwalk (fn [x] (if (contains? smap x) (get smap x) x)) form))

(defn macroexpand-all
  "Recursively performs all possible macroexpansions in `form`."
  [form]
  (prewalk (fn [x] (if (seq? x) (macroexpand x) x)) form))
