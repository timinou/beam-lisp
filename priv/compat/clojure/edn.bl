; edn.bl — Clojure's clojure.edn, native on the BEAM.
;
; ── What EDN is, and why this is a realizer over the reader ───────────────────
;
; EDN (https://github.com/edn-format/edn) is Clojure's data notation: the subset
; of Clojure syntax that denotes DATA — numbers, strings, chars, keywords,
; symbols, vectors, lists, maps, sets, booleans, nil, and tagged literals — with
; NO code evaluation. `clojure.edn/read-string` parses that text into values and,
; crucially, NEVER evaluates it (unlike the load-time reader), which is why it is
; the safe way to read data from an untrusted source.
;
; beam-lisp already has a reader — but it produces reader-NODES (an AST of
; `{:vector …}` / `{:keyword "k"}` tuples), and it is wired to a compiler that
; WOULD evaluate. So clojure.edn here is a REALIZER: it reads the text into nodes
; with the existing reader, then walks those nodes building plain data VALUES
; directly. Because it only ever constructs data — it never calls the compiler —
; it cannot execute code, preserving EDN's safety contract. A list `(1 2 3)` in
; EDN is data (a list of numbers), not a call, and that is exactly what the
; realizer returns.
;
; The oracle is Clojure's own edn read behavior, exercised in
; test/bl/compat/edn_test.bl.

(ns clojure.edn
  (:require [clojure.core-ext]
            [reader-node :as rn]))

(defn- realize
  "Turn one reader NODE into a plain data VALUE. Recurs into collections. A
   symbol becomes a symbol value, a keyword a keyword \u2014 never resolved, never
   called, because EDN is data."
  [node]
  (let [n (rn/node-form node)
        tag (rn/node-tag n)]
    (cond
      ; a bare scalar (number, string, boolean, nil, char-as-codepoint)
      (= tag :scalar) n
      ; keyword node -> a keyword value
      (= tag :keyword) (keyword (rn/node-name n))
      ; symbol node -> a symbol value (nil/true/false read as scalars already)
      (= tag :symbol) (edn-symbol (rn/node-name n))
      ; vector -> a vector of realized items
      (= tag :vector) (vec (map realize (rn/node-items n)))
      ; list -> a list of realized items
      (= tag :list) (apply list (map realize (rn/node-items n)))
      ; set -> a set of realized items
      (= tag :set) (set (map realize (rn/node-items n)))
      ; map -> realize each key and value of each {k-node, v-node} pair
      (= tag :map) (realize-map (rn/node-items n))
      ; anything else (a tagged/record node) is returned as its node form; the
      ; common EDN scalars and collections are all covered above.
      :else n)))

(defn- edn-symbol
  "Build a symbol value from its name, honoring EDN's reserved words: `nil`,
   `true`, `false` denote those values, not symbols. (The reader already reads
   them as scalars in most positions; this guards the symbol path too.)"
  [name]
  (cond
    (= name "nil") nil
    (= name "true") true
    (= name "false") false
    :else (symbol name)))

(defn- realize-map
  "Build a map from a list of {key-node, value-node} pairs, realizing both sides
   of each pair. The reader represents each entry as a 2-tuple of nodes."
  [pairs]
  (reduce (fn [m pair]
            (let [k (realize (erlang/element 1 pair))
                  v (realize (erlang/element 2 pair))]
              (assoc m k v)))
          {}
          pairs))

(defn read-string
  "Reads one object from the string `s` and returns it as EDN DATA. Returns nil
   when `s` is nil or contains only whitespace/comments. Never evaluates `s`
   (EDN is data), so it is safe on untrusted input \u2014 the whole reason
   clojure.edn exists apart from the load-time reader.

   The single-arity form is by far the common one. (Clojure also accepts an
   opts map as a first argument; that arity is provided below.)"
  ([s]
   (if (nil? s)
     nil
     (let [forms (BeamLisp.Reader/read_all s)]
       (if (empty? forms)
         nil
         (realize (first forms))))))
  ([opts s]
   ;; opts (:readers, :default, :eof) are accepted for signature compatibility;
   ;; the common :eof value is honored, the tagged-literal :readers/:default are
   ;; not consulted (no tagged literals in the realizer yet).
   (if (nil? s)
     (get opts :eof nil)
     (let [forms (BeamLisp.Reader/read_all s)]
       (if (empty? forms)
         (get opts :eof nil)
         (realize (first forms)))))))

(defn read-string-all
  "Reads ALL objects from `s`, returning them as a vector of EDN values. Not in
   clojure.edn (which reads one object per call from a stream), but the natural
   whole-string counterpart when a file holds several forms."
  [s]
  (if (nil? s)
    []
    (vec (map realize (BeamLisp.Reader/read_all s)))))
