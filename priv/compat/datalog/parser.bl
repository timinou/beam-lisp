; datalog/parser.bl — datahike's query parser, projected onto datom's. kontor
; uses exactly `p/parse` (invariant.cljc:83), then reads `:qin` (must be 4
; sources) and `:qwhere` (the clause list) and walks the call clauses. So this
; parses a query into a `Query {qin qwhere …}` record whose call clauses are the
; typed `Predicate`/`Function` records kontor's `type`-selector recognises.
;
; Structure comes from datom's own `datom.query.parse/parse` (the section split
; is identical Datalog); this shim adds the ONE thing kontor introspects that
; datom's flat parse does not name: the typed call clauses. It does not
; reimplement parsing — it classifies datom's `:where` clauses into the record
; shapes, and nothing here ever executes a query (that is `datahike.api/q`).

(ns datalog.parser
  (:require [datom.query.parse]
            [datalog.parser.type :as t]))

(defn- fn-arg->node
  "A fn-arg as the record kontor reads: a variable `?x` → Variable, a plain
   symbol → PlainSymbol, anything else → Constant (kontor reads `:value` off a
   subquery's first arg, which is the inner query vector — a Constant)."
  [arg]
  (cond
    (datom.query.parse/variable? arg) (t/->Variable arg)
    (symbol? arg) (t/->PlainSymbol arg)
    :else (t/->Constant arg)))

(defn- call->parts
  "`(f arg …)` → `[fn-node [arg-node …]]`; nil when `form` is not a call."
  [form]
  (if (and (list? form) (seq form))
    (let [f (first form)
          fnode (if (datom.query.parse/variable? f) (t/->Variable f) (t/->PlainSymbol f))]
      [fnode (into [] (map fn-arg->node (rest form)))])
    nil))

(defn- classify-clause
  "A `:where` clause as a typed AST node when it is a call clause, else the raw
   clause. `[(f a b)]` (one call, no binding) → Predicate; `[(f a b) bind]` →
   Function; a data pattern `[?e :a ?v]` passes through unchanged (kontor's
   `type`-selector only matches Predicate/Function, so raw patterns are ignored
   by its walk)."
  [clause]
  (if (and (vector? clause) (seq clause) (list? (first clause)))
    (let [parts (call->parts (first clause))]
      (if (nil? parts)
        clause
        (let [fnode (first parts) args (second parts)]
          (if (= 1 (count clause))
            (t/->Predicate fnode args)
            (t/->Function fnode args (second clause))))))
    clause))

(defn parse
  "Parse a datalog `query` into a `Query` record with `:qfind`, `:qwith`, `:qin`
   and `:qwhere` — datahike's parser output shape. `:qwhere` call clauses are
   the typed `Predicate`/`Function` records kontor introspects; `:qin` is the
   source list (kontor asserts it has exactly 4)."
  [query]
  (let [p (datom.query.parse/parse query)]
    (t/->Query
      (:find p)
      (or (:with p) [])
      (into [] (:in p))
      (into [] (map classify-clause (:where p))))))
