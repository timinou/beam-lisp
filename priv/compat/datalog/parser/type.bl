; datalog/parser/type.bl — the datalog-parser AST record types kontor
; introspects. datahike parses an invariant query into these records and
; kontor's `assert-valid-query` (invariant.cljc:73-98) walks them: it selects
; call clauses by `(type c)` ∈ #{Function Predicate}, reads the called symbol
; via `(:symbol (:fn c))`, and a subquery's inner query via `(:value (first
; (:args c)))`. So the shim must reproduce exactly these record shapes and
; field names — the values need only carry what kontor reads.
;
; These are the SAME records the upstream datalog-parser defines
; (datalog/parser/type.cljc `deftrecord`), reduced to the set kontor touches.
; The dotted class-name spelling kontor uses — `datalog.parser.type.Function` —
; resolves to `datalog.parser.type/Function` through the compiler's dotted
; record-reference rule (compiler.bl dotted-var-ref).

(ns datalog.parser.type)

;; A called-fn / pred symbol. kontor reads `(:symbol (:fn clause))`.
(defrecord PlainSymbol [symbol])
(defrecord Variable [symbol])

;; A fn-arg. kontor reads `(:value (first (:args clause)))` for a subquery's
;; inner query, so a constant arg carries its value here.
(defrecord Constant [value])
(defrecord SrcVar [symbol])

;; The two call clauses kontor selects on by type.
(defrecord Predicate [fn args])
(defrecord Function [fn args binding])

;; The whole parsed query. kontor reads `:qin` (source count) and `:qwhere`
;; (the clause list) off it.
(defrecord Query [qfind qwith qin qwhere])
