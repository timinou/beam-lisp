; minikanren.bl — MVP-D: µKanren for beam-lisp, with the canonical
; macro spelling.
;
; Graduated from research/p13b_minikanren. The kernel is unchanged
; (streams as tagged vectors — '() / [:cons state s] / [:thunk f];
; fair interleave via mplus; no occurs check, as canonical). What
; graduation adds is the part that makes recursive relations SAFE BY
; CONSTRUCTION:
;
;   (conde [g1 g2] [g3])   — every goal is wrapped in delay-goal by the
;                            MACRO. The P13b footgun (a recursive call
;                            without delay diverges before mplus can
;                            interleave) cannot be expressed anymore:
;                            the delay is not the caller's job.
;   (fresh [x y …] g…)     — nested fresh1 + delayed conjuncts.
;   (run n q g…)           — canonical spelling over run*.
;
; Relations still span namespaces by full qualification: the macros
; emit minikanren/… symbols, so `(:require [minikanren])` is enough.
;
; The Barliman principle stands: an unbound logic variable in an answer
; is a HOLE — a partially synthesized program.

(ns minikanren)

; ── logic vars & state ────────────────────────────────────────────────

(defn lvar [id] {:lvar id})
(defn lvar? [x] (and (map? x) (int? (:lvar x))))

(def empty-state {:subst {} :counter 1})

; ── unification ────────────────────────────────────────────────────────

(defn walk [v subst]
  (if (lvar? v)
    (let [found (get subst v)]
      (if (nil? found) v (walk found subst)))
    v))

(defn- unify-vecs [u v subst]
  (if (or (not (vector? v)) (not (= (count u) (count v))))
    false
    (loop [i 0 s subst]
      (cond
        (not s) false
        (= i (count u)) s
        :else (recur (+ i 1) (unify (nth u i) (nth v i) s))))))

(defn unify [u v subst]
  (let [u (walk u subst)
        v (walk v subst)]
    (cond
      (and (lvar? u) (lvar? v) (= u v)) subst
      (lvar? u) (assoc subst u v)
      (lvar? v) (assoc subst v u)
      (and (list? u) (list? v) (empty? u) (empty? v)) subst
      (and (list? u) (list? v) (seq u) (seq v))
        (let [s2 (unify (first u) (first v) subst)]
          (if s2 (unify (rest u) (rest v) s2) false))
      (vector? u) (unify-vecs u v subst)
      :else (if (= u v) subst false))))

; ── predicate goals (Barliman: unbound var ⇒ succeed, leave the hole) ──

(defn numbero [x]
  (fn [state]
    (let [v (walk x (:subst state))]
      (cond (lvar? v) (unit state) (int? v) (unit state) :else mzero))))

(defn symbolo [x]
  (fn [state]
    (let [v (walk x (:subst state))]
      (cond (lvar? v) (unit state) (symbol? v) (unit state) :else mzero))))

(defn booleo [x]
  (fn [state]
    (let [v (walk x (:subst state))]
      (cond (lvar? v) (unit state)
            (or (= v true) (= v false)) (unit state)
            :else mzero))))

(defn stringo [x]
  (fn [state]
    (let [v (walk x (:subst state))]
      (cond (lvar? v) (unit state) (string? v) (unit state) :else mzero))))

; ── streams ────────────────────────────────────────────────────────────

(def mzero '())
(defn unit [state] [:cons state '()])

(defn === [u v]
  (fn [state]
    (let [s2 (unify u v (:subst state))]
      (if s2 (unit (assoc state :subst s2)) mzero))))

(defn thunk? [s] (and (vector? s) (= :thunk (first s))))

(defn mplus [s1 s2]
  (cond
    (thunk? s1) [:thunk (fn [] (mplus s2 ((nth s1 1))))]
    (empty? s1) s2
    :else [:cons (nth s1 1) (mplus (nth s1 2) s2)]))

(defn bind [s g]
  (cond
    (thunk? s) [:thunk (fn [] (bind ((nth s 1)) g))]
    (empty? s) mzero
    :else (mplus (g (nth s 1)) (bind (nth s 2) g))))

(defn pull [s] (if (thunk? s) (pull ((nth s 1))) s))

(defn take* [n s]
  (if (<= n 0)
    '()
    (let [s (pull s)]
      (if (empty? s)
        '()
        (cons (nth s 1) (take* (- n 1) (nth s 2)))))))

; ── goal combinators ───────────────────────────────────────────────────
; η-expansion: delay a relation call until the goal is INVOKED, and
; yield a thunk so mplus interleaves. The conde/fresh MACROS below wrap
; every goal in this — users never write it by hand.

(defn delay-goal [gf] (fn [state] [:thunk (fn [] ((gf) state))]))

(def fail-goal (fn [_] mzero))
(def succeed-goal (fn [state] (unit state)))

(defn disj2 [g1 g2] (fn [state] (mplus (g1 state) (g2 state))))
(defn conj2 [g1 g2] (fn [state] (bind (g1 state) g2)))

(defn disj* [goals] (reduce disj2 fail-goal goals))
(defn conj* [goals] (reduce conj2 succeed-goal goals))

(defn conde* [clauses]
  (disj* (map (fn [goals] (conj* goals)) clauses)))

(defn fresh1 [f]
  (fn [state]
    (let [c (:counter state)]
      ((f (lvar c)) (assoc state :counter (+ c 1))))))

(defn fresh2 [f] (fresh1 (fn [a] (fresh1 (fn [b] (f a b))))))
(defn fresh3 [f] (fresh1 (fn [a] (fresh2 (fn [b c] (f a b c))))))
(defn fresh4 [f] (fresh1 (fn [a] (fresh3 (fn [b c d] (f a b c d))))))

; ── run & reify ────────────────────────────────────────────────────────

(defn reify-walk [v subst]
  (let [v (walk v subst)]
    (cond
      (lvar? v) (symbol (str "_" (:lvar v)))
      (list? v) (doall (map (fn [x] (reify-walk x subst)) v))
      (vector? v) (doall (map (fn [x] (reify-walk x subst)) v))
      :else v)))

(defn run* [n f]
  (let [q (lvar 0)
        states (take* n ((f q) {:subst {} :counter 1}))]
    (doall (map (fn [st] (reify-walk q (:subst st))) states))))

; ── the macros: canonical spelling, delays inserted ────────────────────
;
; Emitted symbols are minikanren/-qualified so the expansion resolves in
; ANY requiring namespace. Every goal position is wrapped in delay-goal
; BY THE MACRO — recursion without delay is no longer expressible.

(defn- delayed [g]
  (list 'minikanren/delay-goal (list 'fn [] g)))

(defn- delay-all [goals]
  ; a CODE form that builds the goals list when evaluated — splicing a
  ; data list here would read as a nested CALL. (Found the hard way.)
  (apply list (concat ['list] (map delayed goals))))

(defmacro conde [& clauses]
  ; the clause list is emitted as a (list …) CALL — a bare data list
  ; would read as a nested call form (same lesson as delay-all).
  (list 'minikanren/conde*
        (apply list
               (concat ['list]
                       (map (fn [clause] (delay-all clause)) clauses)))))

(defmacro fresh [bindings & goals]
  (loop [bs (reverse (into [] bindings))
         body (list 'minikanren/conj* (delay-all goals))]
    (if (empty? bs)
      body
      (recur (rest bs)
             (list 'minikanren/fresh1
                   (list 'fn [(first bs)] body))))))

(defmacro run [n q & goals]
  (list 'minikanren/run* n
        (list 'fn [q] (list 'minikanren/conj* (delay-all goals)))))
