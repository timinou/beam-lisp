; priv/sugar.bl — the threading and conditional macros a Clojure superset is
; expected to carry, kept OUT of core.bl (already ~65KB) but loaded by default.
;
; ── Why a separate file, same default availability ──────────────────────────
;
; core.bl is the language floor and it is large; every macro added there grows
; the file every reader of the language must scan. These are pure sugar over
; core — `cond->` is a `let` over `->`, `condp` is a `cond` over a shared
; predicate — so they belong in their own layer. `BeamLisp.init/0` loads this
; as a third layer after core and multi, and `BeamLisp.Env`'s resolution falls
; back to `sugar` exactly as it does to `core`, so these names are available
; unqualified in every namespace without a require. The file is separate; the
; availability is not.
;
; ── Why macros, not functions ───────────────────────────────────────────────
;
; Threading and short-circuiting decide, at COMPILE time, the SHAPE of the code
; that runs — `some->` must not evaluate the next step once a nil appears, and
; a function cannot refuse to evaluate its argument. So each is a macro that
; emits the `let`/`if` a human would write by hand, which is exactly the
; boilerplate they exist to remove. (`fnil` is the one function here: it wraps
; a fn, and a wrapper is a value.)

(ns sugar)

(defmacro cond->
  "Thread `expr` through the clauses whose test is truthy, FIRST-arg. Each
   clause is `test form`; a passing test threads the current value in as
   form's first argument, a failing one leaves it untouched. The value — not a
   boolean — is what flows and what returns.

     (cond-> {} true (assoc :a 1) false (assoc :b 2))  ;=> {:a 1}

   This is the macro the hand-rolled `let`-rebinding ladders in a downstream
   gateway (assoc-some chains) existed to avoid."
  [expr & clauses]
  (assert (even? (count clauses)) "cond-> requires an even number of test/form clauses")
  (let [g (gensym "ct")]
    `(let [~g ~expr
           ~@(mapcat (fn [pair] [g `(if ~(first pair) (-> ~g ~(second pair)) ~g)])
                     (partition 2 clauses))]
       ~g)))

(defmacro cond->>
  "Like `cond->`, threading a passing clause's value in as the LAST argument."
  [expr & clauses]
  (assert (even? (count clauses)) "cond->> requires an even number of test/form clauses")
  (let [g (gensym "ct")]
    `(let [~g ~expr
           ~@(mapcat (fn [pair] [g `(if ~(first pair) (->> ~g ~(second pair)) ~g)])
                     (partition 2 clauses))]
       ~g)))

(defmacro as->
  "Bind `expr` to `name`, then thread it through `forms` by that name — for a
   chain where the insertion position varies step to step.

     (as-> 5 $ (+ $ 1) (* 2 $) (- $ 3))  ;=> 9"
  [expr name & forms]
  `(let [~name ~expr
         ~@(mapcat (fn [f] [name f]) forms)]
     ~name))

(defmacro some->
  "Thread `expr` through `forms` (FIRST-arg) while non-nil; the moment a step
   yields nil, stop and yield nil. The nil-safe navigation for a chain of
   lookups any of which may be absent.

     (some-> {:a {:b 1}} :a :b)   ;=> 1
     (some-> {:a {:b 1}} :x :b)   ;=> nil  (never calls :b on nil)"
  [expr & forms]
  (let [g (gensym "st")]
    `(let [~g ~expr
           ~@(mapcat (fn [f] [g `(if (nil? ~g) nil (-> ~g ~f))]) forms)]
       ~g)))

(defmacro some->>
  "Like `some->`, threading into the LAST argument while non-nil."
  [expr & forms]
  (let [g (gensym "st")]
    `(let [~g ~expr
           ~@(mapcat (fn [f] [g `(if (nil? ~g) nil (->> ~g ~f))]) forms)]
       ~g)))

(defmacro condp
  "`cond` with a shared binary predicate. `(condp pred expr & clauses)` tests
   each `test-value` as `(pred test-value expr)`; the first truthy match yields
   its result. A trailing SINGLE form is the default; without one, no match
   raises.

     (condp = x  1 :one  2 :two  :many)

   The `:>>` result-fn form of Clojure's condp is deliberately omitted until a
   caller needs it — one reviewable clause to add, not carried speculatively."
  [pred expr & clauses]
  (let [g (gensym "cp")]
    (letfn [(emit [cs]
              (cond
                (empty? cs)      `(throw (ex-info "condp: no matching clause and no default"
                                                  {:value ~g}))
                (= 1 (count cs)) (first cs)
                :else            `(if (~pred ~(first cs) ~g)
                                    ~(second cs)
                                    ~(emit (drop 2 cs)))))]
      `(let [~g ~expr] ~(emit clauses)))))

(defmacro doto
  "Evaluate `x` once, run each form on it (threaded FIRST) for its side effect,
   and return `x`. For a sequence of mutations or builder calls on one thing.

     (doto (transient []) (conj! 1) (conj! 2))  ;=> a transient holding 1 2"
  [x & forms]
  (let [g (gensym "dt")]
    `(let [~g ~x]
       ~@(map (fn [f] `(-> ~g ~f)) forms)
       ~g)))

(defmacro when-some
  "Like `when-let`, but binds only when the value is non-NIL — `false` passes
   through and binds, where `when-let` (falsy test) would stop. For a value
   whose valid domain includes `false`.

     (when-some [v (get m :flag)] (use v))"
  [bindings & body]
  (let [name (first bindings)
        expr (second bindings)
        g    (gensym "ws")]
    `(let [~g ~expr]
       (if (nil? ~g) nil (let [~name ~g] ~@body)))))

(defmacro if-some
  "Like `if-let`, but tests specifically for non-nil (so `false` takes the
   THEN branch, not the else)."
  [bindings then else]
  (let [name (first bindings)
        expr (second bindings)
        g    (gensym "is")]
    `(let [~g ~expr]
       (if (nil? ~g) ~else (let [~name ~g] ~then)))))

(defn fnil
  "Return a fn like `f` but with nil arguments replaced by the given defaults
   before the call — the nil-punning `(or x default)` written once. Patches the
   first 1, 2 or 3 args (Clojure's arities).

     ((fnil + 0) nil 5)     ;=> 5
     ((fnil conj []) nil 1) ;=> [1]"
  ([f a] (fn [x & more] (apply f (if (nil? x) a x) more)))
  ([f a b] (fn [x y & more] (apply f (if (nil? x) a x) (if (nil? y) b y) more)))
  ([f a b c] (fn [x y z & more]
               (apply f (if (nil? x) a x) (if (nil? y) b y) (if (nil? z) c z) more))))
