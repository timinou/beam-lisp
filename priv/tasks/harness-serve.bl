; harness-serve.bl — `bl harness`: arm the harness in this project's warm VM.
;
; This is a task, not a library namespace to AOT-compile: the final form starts
; an HTTP server and parks the cold VM. Keeping it outside priv/lib prevents a
; self-build from evaluating that form while compiling its library payload.
;
; Run through the daemon, the endpoint keeps serving after this returns (it is
; a member of the project VM). Run cold (BL_DAEMON=off), it serves until
; interrupted.

(ns harness.serve
  (:require [harness.mcp :as hm]))

(hm/run)
