; nano.bl — the smallest honest proof of self-hosting.
;
; This namespace is a TINY compiler, written in beam-lisp, for one shape of
; program: a single arithmetic call like (+ 1 2) or (* 6 7). It exists to
; prove the one thing every later prototype builds on — that beam-lisp code
; can turn a program into a real Elixir syntax tree and run it, with nothing
; but Erlang/Elixir standard-library calls underneath. No part of beam-lisp's
; own Elixir-written compiler is used at run time.
;
; The proof that matters: this file is compiled ahead of time into a .beam
; file, and that .beam is loaded into a bare Erlang virtual machine (plain
; `erl`, no mix, no Elixir compiler front-end) where it still works. If it
; runs there, the seed is real.

(ns bootstrap.nano)

(defn lower
  "Turn a beam-lisp arithmetic form into an Elixir syntax tree.

   Takes a form the reader produced for something like (+ 1 2): a list whose
   first element is an operator symbol and whose remaining elements are
   whole numbers. Returns the matching Elixir syntax tree, which for (+ 1 2)
   is the three-part tuple {:+, [], [1, 2]} — an operator atom, an empty slot
   for source-location metadata, and the list of arguments. That tuple is
   exactly what Elixir's own evaluator accepts.

   Only operator-and-numbers calls are understood; anything else is refused
   loudly, because a seed that quietly mishandles input is worse than one
   that stops."
  [form]
  (let [op   (first form)          ; the operator symbol, e.g. the + in (+ 1 2)
        args (rest form)]          ; the numbers being combined
    (if (and (symbol? op) (every? number? args))
      (erlang/list_to_tuple
        (list (keyword (str op))   ; symbol + becomes the atom :+  — the AST head
              (list)               ; no source-location metadata
              (apply list args)))  ; the argument numbers, unchanged
      (throw (str "nano can only lower (op number number ...), got: " form)))))

(defn run
  "Compile and run one arithmetic form, returning its number.

   Takes a form like (+ 1 2), lowers it to an Elixir syntax tree, hands that
   tree to Elixir's standard evaluator, and returns the single value the
   evaluator produced. This is the whole pipeline in miniature: beam-lisp
   builds the tree, the standard library turns the tree into an answer."
  [form]
  (first (erlang/tuple_to_list (Code/eval_quoted (lower form)))))
