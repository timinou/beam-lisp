; typed.bl — MVP-A: the beam-lisp type checker.
;
; Graduated from research/p1_lattice + research/p2_positions +
; research/p3_guards after their questions were answered:
;   P1: tag lattice is small, fast, catches real shapes, 0 FPs.
;   P2: FormMeta positions survive end-to-end; macros whitelisted, never
;       expanded; evidence table {[line col] -> tagset} + hover.
;   P3: real corpus (guards.bl, destructuring.bl) checks silent; clause
;       reachability fires on dead clauses.
;
; Contract: sound warnings only. Unknown means silent (and, when the
; deferred-constraint list lands, retryable after later loads).
; A type is a SET OF TAGS. Meet is intersection; a disjoint meet at a
; required position is the one thing we warn about.
;
; Entry points:
;   (typed/check-source src ns)  -> {:warnings [...] :evidence {...}}
;   (typed/hover ev line col)    -> human-readable type at a position
;
; Spike-grade honesty: warnings/evidence live in atoms (the production
; checker will thread them); the macro whitelist is small by design.

(ns typed
  (:require [reader-node :as rn]))

(def all-tags #{:int :float :kw :string :bool :map :vec :set :fn :nil :sym :seq :list})
(def any all-tags)
(def never #{})

(defn t-union [a b] (set (concat a b)))
(defn t-meet [a b] (set (filter (fn [t] (contains? a t)) b)))
(defn t-sub? [a b] (every? (fn [t] (contains? b t)) a))

; Type EXPRESSIONS (P0 convention: annotations are data).
;   int, string, …     a tag
;   number             int ∪ float
;   any                the top
;   (U a b …)          a union
;   (fn [a…] r)        fn — shallow in v1: the tag, not the columns
(defn type-expr [e]
  (cond
    (and (symbol? e) (= (str e) "any"))    any
    (and (symbol? e) (= (str e) "number")) #{:int :float}
    (symbol? e)
      (let [t (keyword (str e))]
        (if (contains? all-tags t) #{t} any))
    (and (list? e) (= (str (first e)) "U"))
      (reduce (fn [acc x] (t-union acc (type-expr x))) never (rest e))
    :else any))

; --- guard narrowing ---------------------------------------------------------
;
; The whitelist. Each predicate maps to the EXACT tag set it accepts, so
; both branches are sound: then = meet, else = difference. An unlisted
; guard narrows nothing, warns nothing.

(def guard-tags
  {'int?     #{:int}
   'float?   #{:float}
   'number?  #{:int :float}
   'string?  #{:string}
   'keyword? #{:kw}
   'symbol?  #{:sym}
   'map?     #{:map}
   'vector?  #{:vec}
   'set?     #{:set}
   'fn?      #{:fn}
   'boolean? #{:bool}
   'nil?     #{:nil}
   'list?    #{:list}
   'seq?     #{:seq :list}
   'pos?     #{:int :float}
   'neg?     #{:int :float}
   'zero?    #{:int :float}
   'some?    #{:int :float :kw :string :bool :map :vec :set :fn :sym}})

(defn t-diff [a b] (set (filter (fn [t] (not (contains? b t))) a)))

(defn lit-type [x]
  (cond
    (int? x)     #{:int}
    (float? x)   #{:float}
    (string? x)  #{:string}
    (keyword? x) #{:kw}
    (symbol? x)  #{:sym}
    (= x true)   #{:bool}
    (= x false)  #{:bool}
    (nil? x)     #{:nil}
    (map? x)     #{:map}
    (vector? x)  #{:vec}
    (list? x)    #{:list}
    (set? x)     #{:set}
    (fn? x)      #{:fn}
    :else        any))

; --- the driver: annotations flow through the REAL pipe (P0) ------------------
;
; The demo file is run first (its defs + ^ meta land in Env), then checked
; from source data. Signatures come from Env.meta — nothing is re-declared
; for the checker's benefit.

(defn sigs-from-env
  "The {name → {:args [tagset…] :ret tagset}} table for `ns`, from the
   ^{:args :ret} metadata the compiler already stores (P0)."
  [ns]
  (reduce
    (fn [acc name]
      (let [m (BeamLisp.Env/meta ns name)]
        (if (and (not (= m :error)) (contains? (second m) :args))
          (let [mm (second m)]
            (assoc acc name
                   {:args (into [] (map type-expr (:args mm)))
                    :ret  (type-expr (:ret mm))}))
          acc)))
    {}
    (BeamLisp.Env/public_names ns)))

; A small core seed table — P6 owns the full survey; the spike seeds only
; what the demo calls.
(def core-sigs
  {"+"    {:args [#{:int :float} #{:int :float}] :ret #{:int :float}}
   "*"    {:args [#{:int :float} #{:int :float}] :ret #{:int :float}}
   "str"  {:args [any] :ret #{:string}}
   "get"  {:args [#{:map :vec :set} any] :ret any}
   "-"    {:args [#{:int :float} #{:int :float}] :ret #{:int :float}}
   "count" {:args [any] :ret #{:int}}
   "max"  {:args [#{:int :float} #{:int :float}] :ret #{:int :float}}
   "pr-str" {:args [any] :ret #{:string}}
   "println" {:args [any] :ret #{:nil}}})

; P6: the empirical seed tables. Format = the one P1 established:
; {"name" {:args [tagset…] :ret tagset}}. SOUND-CONSERVATIVE: a fn is
; seeded only when its return tag is certain (verified against the
; runtime, research/p6_interop); anything doubtful stays unseeded, which
; means any, which means silent. Elixir-module seeds key on the exact
; "Module/fn" string the reader produces for interop heads.

(def core-seeds-v2
  {"map"      {:args [#{:fn :kw} any] :ret #{:seq}}
   "filter"   {:args [#{:fn :kw} any] :ret #{:seq}}
   "remove"   {:args [#{:fn :kw} any] :ret #{:seq}}
   "keep"     {:args [#{:fn :kw} any] :ret #{:seq}}
   "mapcat"   {:args [#{:fn :kw} any] :ret #{:seq}}
   "concat"   {:args [any] :ret #{:seq}}
   "take"     {:args [#{:int} any] :ret #{:seq}}
   "drop"     {:args [#{:int} any] :ret #{:seq}}
   "distinct" {:args [any] :ret #{:seq}}
   "dedupe"   {:args [any] :ret #{:seq}}
   "reverse"  {:args [any] :ret #{:seq}}
   "range"    {:args [] :ret #{:seq}}
   "repeat"   {:args [any] :ret #{:seq}}
   "iterate"  {:args [#{:fn :kw} any] :ret #{:seq}}
   "keys"     {:args [#{:map}] :ret #{:seq}}
   "vals"     {:args [#{:map}] :ret #{:seq}}
   "sort"     {:args [any] :ret #{:list}}
   "mapv"     {:args [#{:fn :kw} any] :ret #{:vec}}
   "filterv"  {:args [#{:fn :kw} any] :ret #{:vec}}
   "vec"      {:args [any] :ret #{:vec}}
   "vector"   {:args [] :ret #{:vec}}
   "name"     {:args [any] :ret #{:string}}
   "keyword"  {:args [any] :ret #{:kw}}
   "symbol"   {:args [any] :ret #{:sym}}
   "boolean"  {:args [any] :ret #{:bool}}
   "not"      {:args [any] :ret #{:bool}}
   "contains?" {:args [any any] :ret #{:bool}}
   "empty?"   {:args [any] :ret #{:bool}}
   "every?"   {:args [#{:fn :kw} any] :ret #{:bool}}
   "inc"      {:args [#{:int :float}] :ret #{:int :float}}
   "dec"      {:args [#{:int :float}] :ret #{:int :float}}
   "abs"      {:args [#{:int :float}] :ret #{:int :float}}
   "merge"    {:args [#{:map}] :ret #{:map}}
   "assoc"    {:args [#{:map}] :ret #{:map}}
   "dissoc"   {:args [#{:map}] :ret #{:map}}
   "select-keys" {:args [#{:map} any] :ret #{:map}}
   "zipmap"   {:args [any any] :ret #{:map}}
   "set"      {:args [any] :ret #{:set}}
   "pr-str"   {:args [] :ret #{:string}}
   "join"     {:args [any any] :ret #{:string}}
   "apply"    {:args [#{:fn}] :ret any}})

(def host-seeds
  {"String/upcase"   {:args [#{:string}] :ret #{:string}}
   "String/downcase" {:args [#{:string}] :ret #{:string}}
   "String/trim"     {:args [#{:string}] :ret #{:string}}
   "String/split"    {:args [#{:string}] :ret #{:list}}
   "String/length"   {:args [#{:string}] :ret #{:int}}
   "String/contains?" {:args [#{:string} any] :ret #{:bool}}
   "Map/get"         {:args [#{:map} any] :ret any}
   "Map/keys"        {:args [#{:map}] :ret #{:list}}
   "Map/values"      {:args [#{:map}] :ret #{:list}}
   "Map/merge"       {:args [#{:map} #{:map}] :ret #{:map}}
   "Enum/sum"        {:args [any] :ret #{:int :float}}
   "Enum/map"        {:args [any #{:fn}] :ret #{:list}}
   "Enum/count"      {:args [any] :ret #{:int}}
   "Enum/join"       {:args [any] :ret #{:string}}
   "Enum/sort"       {:args [any] :ret #{:list}}
   "Enum/filter"     {:args [any #{:fn}] :ret #{:list}}
   "Enum/reduce"     {:args [any any #{:fn}] :ret any}
   "Base/encode64"   {:args [#{:string}] :ret #{:string}}
   "Base/decode64"   {:args [#{:string}] :ret any}
   "File/read"       {:args [#{:string}] :ret any}
   "File/write"      {:args [#{:string} any] :ret any}
   "length"          {:args [any] :ret #{:int}}})



; --- node plumbing -----------------------------------------------------------
;
; Reader nodes are Elixir tuples: {:meta, node, pos} / {:list, items} /
; {:vector, items} / {:symbol, name} / {:map, pairs}. Scalars pass through.

; The node accessors and builders now live in reader-node.bl, shared with
; the codebase indexer and the self-hosted compiler so all three agree on
; what a reader node IS. These thin forwarders keep typed's own call sites
; (which say node-tag, node-form, … unqualified) working unchanged.
(defn node-tag [n] (rn/node-tag n))
(defn node-form [n] (rn/node-form n))
(defn node-items [n] (rn/node-items n))
(defn node-pos [n] (rn/node-pos n))
(defn node-name [n] (rn/node-name n))
(defn ->tuple [xs] (rn/->tuple xs))
(defn sym-node [s] (rn/sym-node s))
(defn list-node [items] (rn/list-node items))
(defn meta-node [n pos] (rn/meta-node n pos))

; --- state --------------------------------------------------------------------

(def warnings (atom []))
(def evidence (atom {}))

(defn warn! [msg pos form]
  (swap! warnings
         (fn [ws]
           (conj ws {:msg msg
                     :line (if (nil? pos) 0 (:line pos))
                     :col  (if (nil? pos) 0 (:col pos))
                     :form (pr-str form)}))))

(defn record! [pos type]
  (if (nil? pos)
    nil
    (swap! evidence (fn [ev] (assoc ev [(:line pos) (:col pos)] type)))))

; --- the walker -----------------------------------------------------------------

(declare walk)

(defn eff-pos
  "Position for warnings: the node's own, else the enclosing meta
   wrapper's (threaded through the env by the :meta case — synthesized
   nodes from threading honestly have none of their own)."
  [env node]
  (let [p (node-pos node)]
    (if (nil? p) (:__pos env) p)))

(defn sym-type [env n]
  (get env (node-name n) any))

(defn call-sig [sigs n] (get sigs (node-name n) nil))

(defn walk-call [sigs env items pos whole]
  (let [head (first items)
        arg-types (into [] (map (fn [a] (walk sigs env a)) (rest items)))]
    (if (= :keyword (node-tag (node-form head)))
      (if (and (= 1 (count arg-types))
               (empty? (t-meet (first arg-types) #{:map})))
        (warn! (str "keyword " (node-name (node-form head))
                    " called on a value that is provably not a map")
               pos whole)
        nil)
      nil)
    (if (= :symbol (node-tag head))
      (let [sig (call-sig sigs head)]
        (if (nil? sig)
          any
          (do
            (doall
              (map-indexed
                (fn [i declared]
                  (let [actual (get arg-types i nil)]
                    (if (and (some? actual)
                             (empty? (t-meet actual declared)))
                      (warn! (str (node-name head) ": argument " (+ i 1) " is "
                                  (pr-str (sort (into [] actual)))
                                  ", declared "
                                  (pr-str (sort (into [] declared))))
                             pos whole)
                      nil)))
                (:args sig)))
            (:ret sig))))
      any)))

(defn walk-if [sigs env items pos whole]
  (let [test (second items)
        then (nth items 2)
        else (get (into [] items) 3 nil)]
    (walk sigs env test)
    (let [[then-env else-env]
          (if (and (= :list (node-tag (node-form test)))
                   (= 2 (count (node-items test)))
                   (= :symbol (node-tag (node-form (first (node-items test)))))
                   (= :symbol (node-tag (node-form (second (node-items test))))))
            (let [pred (node-name (first (node-items test)))
                  x    (node-name (second (node-items test)))
                  tags (get guard-tags (symbol pred) nil)]
              (if (nil? tags)
                [env env]
                (let [cur (get env x any)
                      in  (t-meet cur tags)
                      out (t-diff cur tags)]
                  (if (empty? in)
                    (warn! (str "branch unreachable: " x " is provably not "
                                (pr-str (sort (into [] tags))))
                           (let [p (node-pos test)] (if (nil? p) (:__pos env) p))
                           test)
                    nil)
                  [(assoc env x in) (assoc env x out)])))
            [env env])]
      (t-union (walk sigs then-env then)
                 (if (nil? else) never (walk sigs else-env else))))))

(defn walk-let [sigs env bindings body]
  (let [bs (node-items (node-form bindings))
        env2 (loop [xs bs e env]
               (if (empty? xs)
                 e
                 (recur (rest (rest xs))
                        (assoc e (node-name (first xs))
                                 (walk sigs e (second xs))))))]
    (reduce (fn [_ b] (walk sigs env2 b)) never body)))

; Threading: (-> x (f a) g) is walked AS (g (f x a)) — but every
; synthesized call borrows the position of the form the user wrote.
; This is the InfoTree move: elaborated, position-attributed.

(defn desugar-thread
  "Returns the nested call the thread means, with each synthesized call
   wrapped in {:meta, _, pos} carrying the position of the STEP the user
   wrote — InfoTree-style: elaborated, position-attributed. `first?`:
   -> inserts at arg 1, ->> at the end."
  [first? x steps]
  (loop [acc x
         ss steps]
    (if (empty? ss)
      acc
      (let [s (first ss)
            pos (node-pos s)
            core (node-form s)]
        (if (= :list (node-tag core))
          (let [its (node-items core)
                args (if first?
                       (concat [(first its)] [acc] (rest its))
                       (concat [(first its)] (rest its) [acc]))
                syn (list-node (apply list args))]
            (recur (if (nil? pos) syn (meta-node syn pos))
                   (rest ss)))
          (let [syn (list-node (list s acc))]
            (recur (if (nil? pos) syn (meta-node syn pos))
                   (rest ss))))))))

(defn walk-cond [sigs env pairs]
  (loop [ps pairs acc never]
    (if (empty? ps)
      acc
      (do
        (walk sigs env (first ps))
        (recur (rest (rest ps))
               (t-union acc (walk sigs env (second ps))))))))

(def specials #{"if" "let" "do" "fn" "quote" "loop"})

(defn walk [sigs env node]
  (let [tag (node-tag node)]
    (cond
      (= tag :meta)
        (let [pos (node-pos node)
              ty  (walk sigs (assoc env :__pos pos)
                        (second (erlang/tuple_to_list node)))]
          (record! pos ty)
          ty)

      (= tag :symbol) (sym-type env node)

      (= tag :vector)
        (do (doall (map (fn [x] (walk sigs env x)) (node-items node)))
            #{:vec})

      (= tag :keyword) #{:kw}

      (= tag :set)
        (do (doall (map (fn [x] (walk sigs env x)) (node-items node)))
            #{:set})

      (= tag :map)
        (do (doall (map (fn [p] (walk sigs env (second (erlang/tuple_to_list p))))
                        (node-items node)))
            #{:map})

      (= tag :list)
        (let [items (node-items node)
              head  (first items)
              pos   (eff-pos env node)
              hname (if (= :symbol (node-tag head)) (node-name head) "")]
          (cond
            (= hname "if")   (walk-if sigs env items pos node)
            (= hname "let")  (walk-let sigs env (second items) (rest (rest items)))
            (= hname "do")   (reduce (fn [_ b] (walk sigs env b)) never (rest items))
            (= hname "quote") #{:sym}

            ; whitelisted macros — walked structurally, NEVER expanded
            (= hname "when")
              (walk-if sigs env
                       (apply list [head (second items)
                                    (list-node
                                      (apply list
                                             (concat [(sym-node "do")]
                                                     (rest (rest items)))))])
                       pos node)
            (= hname "when-not")
              (walk-if sigs env
                       (list head (second items)
                             (list-node
                               (apply list
                                      (concat [(sym-node "do")]
                                              (rest (rest items))))))
                       pos node)
            (= hname "cond") (walk-cond sigs env (rest items))
            (= hname "and")
              (do (doall (map (fn [x] (walk sigs env x)) (rest items)))
                  (t-union #{:bool} any))
            (= hname "or")
              (do (doall (map (fn [x] (walk sigs env x)) (rest items)))
                  any)
            (= hname "->")
              (walk sigs env (desugar-thread true (second items) (rest (rest items))))
            (= hname "->>")
              (walk sigs env (desugar-thread false (second items) (rest (rest items))))

            (= hname "doseq")
              (let [bs (node-items (node-form (second items)))
                    coll (second bs)
                    _    (walk sigs env coll)
                    env2 (bind-pattern env (first bs) any)]
                (doall (map (fn [b] (walk sigs env2 b)) (rest (rest items))))
                #{:nil})

            ; unknown macro? expand once via the compiler's own oracle,
            ; keep OUR position, walk the expansion (its generated nodes
            ; honestly carry none).
            :else
              (let [orig     (list-node items)
                    expanded (BeamLisp.Compiler/macroexpand_1 orig "p2demo")]
                (if (identical? expanded orig)
                  (walk-call sigs env items pos node)
                  (walk sigs (assoc env :__pos pos) expanded)))))

      :else (lit-type node))))

; --- P3: patterns, clauses, reachability ------------------------------------------
;
; bind-pattern: destructuring binds without lying. A pattern gives no
; tag information about its targets at this tier (map VALUES are any),
; so every bound symbol gets the value's type or any — sound, silent.

(defn bind-pattern [env pat ty]
  (let [p (node-form pat)
        tg (node-tag p)]
    (cond
      (= tg :symbol)
        (let [n (node-name p)]
          (if (= n "&") env (assoc env n ty)))

      (= tg :vector)
        (reduce (fn [e x] (bind-pattern e x any)) env (node-items p))

      (= tg :map)
        (reduce
          (fn [e pair]
            (let [k (node-form (first (erlang/tuple_to_list pair)))
                  v (second (erlang/tuple_to_list pair))]
              (if (and (= :keyword (node-tag k))
                       (contains? #{"keys" "as" "or"} (node-name k)))
                (cond
                  (= "keys" (node-name k))
                    (reduce (fn [e2 s] (bind-pattern e2 s any))
                            e (node-items (node-form v)))
                  (= "as" (node-name k)) (bind-pattern e v any)
                  :else e)
                (bind-pattern e k any))))
          env (node-items p))

      :else env)))

; Clause analysis. A defn is ([name] docstring? CLAUSE+) where each
; clause is ([params…] :when guard? body…) — or the params vector
; directly for the single-clause spelling.

(defn parse-clause [c]
  (let [its    (node-items c)
        params (first its)
        after  (rest its)
        has-guard (and (not (empty? after))
                       (= :keyword (node-tag (node-form (first after))))
                       (= "when" (node-name (node-form (first after)))))]
    {:params (node-items (node-form params))
     :guard  (if has-guard (second after) nil)
     :body   (if has-guard (rest (rest after)) after)
     :node   c}))

(defn defn-clauses
  "[name docstring-or-nil [clauses]] — single-clause spelling included."
  [items]
  (let [name  (node-name (node-form (second items)))
        rest1 (rest (rest items))
        [doc rest2] (if (and (not (empty? rest1))
                             (string? (first rest1)))
                      [(first rest1) (rest rest1)]
                      [nil rest1])]
    [name doc
     (if (and (not (empty? rest2))
              (= :list (node-tag (node-form (first rest2)))))
       (map parse-clause rest2)
       [(parse-clause (list-node (apply list rest2)))])]))

; guard-claim: the tags a clause guard FULLY claims for its param —
; sound coverage only. An exact whitelisted predicate claims its tags;
; (or …) of exact predicates claims the union; `and` claims NOTHING
; (it matches an unknown SUBSET of the meet). A missing guard claims
; everything — which is what makes later same-arity clauses dead.

(defn guard-claim [guard pname]
  (if (nil? guard)
    all-tags
    (let [g (node-form guard)]
      (if (not (= :list (node-tag g)))
        #{}
        (let [its (node-items g)
              h   (node-form (first its))]
          (cond
            (not (= :symbol (node-tag h))) #{}
            (= "and" (node-name h)) #{}
            (= "or" (node-name h))
              (reduce (fn [acc d] (t-union acc (guard-claim d pname)))
                      #{} (rest its))
            :else
              (if (and (= 2 (count its))
                       (= :symbol (node-tag (node-form (second its))))
                       (= pname (node-name (node-form (second its)))))
                (get guard-tags (symbol (node-name h)) #{})
                #{})))))))

; guard-narrow: the param's type INSIDE the clause body. Meet over and-
; conjuncts, union over or-disjuncts, exact for a bare predicate.

(defn guard-narrow [guard pname cur]
  (if (nil? guard)
    cur
    (let [g (node-form guard)]
      (if (not (= :list (node-tag g)))
        cur
        (let [its (node-items g)
              h   (node-form (first its))]
          (if (not (= :symbol (node-tag h)))
            cur
            (let [hn (node-name h)]
              (cond
                (= hn "and")
                  (reduce (fn [c d] (guard-narrow d pname c)) cur (rest its))
                (= hn "or")
                  (reduce (fn [acc d]
                            (t-union acc (guard-narrow d pname never)))
                          never (rest its))
                :else
                  (if (and (= 2 (count its))
                           (= :symbol (node-tag (node-form (second its))))
                           (= pname (node-name (node-form (second its)))))
                    (let [tags (get guard-tags (symbol hn) nil)]
                      (if (nil? tags) cur (t-meet cur tags)))
                    cur)))))))))

; check-defn: reachability across same-arity clauses + narrowed bodies.
; Coverage claims are single-param only — multi-param coverage is a
; product the spike does not compute (claims nothing, warns nothing).

(defn check-defn [sigs items pos]
  (let [[name _ clauses] (defn-clauses items)
        sig  (get sigs name nil)
        base (fn [c]
               (if (and (some? sig) (= 1 (count (:params c))))
                 (bind-pattern {} (first (:params c))
                               (first (:args sig)))
                 (reduce (fn [e p] (bind-pattern e p any))
                         {} (:params c))))]
    (loop [cs clauses claimed #{}]
      (if (empty? cs)
        nil
        (let [c (first cs)
              single-sym (and (= 1 (count (:params c)))
                              (= :symbol (node-tag
                                           (node-form (first (:params c))))))
              pname (if single-sym
                      (node-name (node-form (first (:params c)))) nil)]
          (if (and single-sym (t-sub? all-tags claimed))
            (warn! (str name ": clause unreachable — earlier clauses "
                        "already cover every tag")
                   (node-pos (:node c)) (:node c))
            nil)
          (let [env0 (base c)
                env1 (if single-sym
                       (assoc env0 pname
                              (guard-narrow (:guard c) pname
                                            (get env0 pname any)))
                       env0)]
            (doall (map (fn [b] (walk sigs env1 b)) (:body c))))
          (recur (rest cs)
                 (if single-sym
                   (t-union claimed (guard-claim (:guard c) pname))
                   claimed)))))))

; --- entry ---------------------------------------------------------------------------------------------------

(defn check-source
  "Walk top-level forms — source text or parsed forms. defn bodies get
   params bound from the ^{:args} annotation via the P0 pipe
   (sigs-from-env)."
  [src ns]
  (check-source-with src ns (merge core-seeds-v2 host-seeds)))

(defn check-source-with
  "check-source with an explicit seed table (P6 measures with/without)."
  [src ns seeds]
  (let [forms (if (string? src) (BeamLisp.Reader/read_string src) src)
        sigs (merge core-sigs seeds (sigs-from-env ns))]
    (doall
      (map
        (fn [form]
          (let [f (if (= :meta (node-tag form))
                    (second (erlang/tuple_to_list form))
                    form)]
            (cond
              (not (= :list (node-tag f)))
                (walk sigs {} form)

              ; ns is compile-time plumbing: (:require …) clauses are
              ; keyword-headed lists in DSL position, NOT kw-calls.
              ; (P8's corpus caught this FP.)
              (= "ns" (node-name (node-form (first (node-items f)))))
                nil

              (and (= :symbol (node-tag (node-form (first (node-items f)))))
                   (contains? #{"defn" "defn-"}
                              (node-name (node-form (first (node-items f))))))
                (do (check-defn sigs (node-items f) (node-pos form))
                    never)

              :else (walk sigs {} form))))
        forms))
    {:warnings (deref warnings) :evidence (deref evidence)}))

(defn hover
  "The L1/L12 demo: type at [line col], delaborated for a human."
  [ev line col]
  (let [ty (get ev [line col] nil)]
    (if (nil? ty)
      "∅ no evidence"
      (pr-str (sort (into [] ty))))))
