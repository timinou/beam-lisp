; fuzz.bl — property/fuzz/lint/hypothesis over a function's OWN structure.
;
; ── The idea ───────────────────────────────────────────────────────────────
;
; A beam-lisp function is a set of (guard → body) clauses, and system.model
; already reads that structure out as DATA. So the "property" of a function is
; not something you assert on the side — it is the clause set itself. Four
; checks fall out of that one fact, each applying to ANY function without a
; bespoke test:
;
;   LINT        (static)   — structural facts about the guards   (do they leave a hole?)
;   FUZZ        (dynamic)   — candidate inputs vs the guards       (which input hits no clause?)
;   PROVE       (coverage)  — ∀ candidate, ∃ covering guard?       (is every edge managed?)
;   HYPOTHESIS  (behaviour) — ∀ input, does a property hold?       (refute + SHRINK a witness)
;
; The novel move for coverage: a guard is a pure boolean predicate over the
; arguments (the BEAM evaluates it without user code — that is what makes it a
; guard), so "does clause i accept input xs" is just evaluating
; ((fn [args…] guard_i) xs…). An input no guard accepts is a witnessed GAP,
; found from the function's structure, not from a hand-written case.
;
; The hypothesis half is classic property-based testing (QuickCheck/Hypothesis)
; with one turn of the screw: a REFUTED property is SHRUNK to its minimal
; witness — the smallest input that still breaks it — so the report names the
; simplest failing case, not the first random one.

(ns fuzz
  (:require [system.model :as model] [typed] [env] [core] [errors]))

; ── read a function's shape as data ─────────────────────────────────────────

(defn- params-of
  "The parameter NAME vector of a defn's first clause (all args, in order).
   Multi-arg aware; defaults to [\"n\"] when the shape is opaque."
  [node]
  (let [its (typed/node-items (typed/node-form node))
        parsed (nth (typed/defn-clauses its) 2)
        params (:params (first parsed))
        names (into [] (keep (fn [p]
                               (if (= :symbol (typed/node-tag (typed/node-form p)))
                                 (typed/node-name (typed/node-form p)) nil))
                             params))]
    (if (empty? names) ["n"] names)))

(defn- fn-name-of
  "The defn's own name, for building a call to it."
  [node]
  (let [its (typed/node-items (typed/node-form node))]
    (typed/node-name (typed/node-form (second its)))))

(defn shape-of
  "The full data shape of a defn source: its name, parameter names, and guard
   SOURCE strings in clause order (a clause with no :when yields \"true\")."
  [src]
  (let [node (first (BeamLisp.Reader/read_string src))
        clauses (model/transitions node)]
    {:name (fn-name-of node)
     :params (params-of node)
     :guards (into [] (map (fn [c] (or (:guard c) "true")) clauses))}))

; ── render a candidate INPUT (a tuple of args) as bl source ─────────────────

(defn- lit
  "One value as bl SOURCE that re-reads to the same value. Negatives are
   parenthesised; strings quoted; keywords keep their colon (str drops it, so
   pr-str is mandatory); collections are QUOTED so they read as data literals
   rather than being evaluated as calls."
  [v]
  (cond (and (int? v) (< v 0)) (str "(- " (- 0 v) ")")
        (string? v) (str "\"" v "\"")
        (nil? v) "nil"
        (keyword? v) (core/pr-str v)
        (or (vector? v) (map? v) (set? v) (list? v)) (str "(quote " (core/pr-str v) ")")
        :else (str v)))

(defn- tuple-of
  "A candidate as an arg TUPLE, given the function's `arity`. A vector candidate
   is the arg LIST only when arity>1 ([6 0] → two args); for a single-arg
   function a vector is ONE value (the vector itself). A bare value is always
   [value]. This resolves the ambiguity a vector candidate would otherwise carry
   between 'one vector arg' and 'many args'."
  [arity cand]
  (cond
    (and (vector? cand) (> arity 1)) cand
    (vector? cand) [cand]
    :else [cand]))

(defn- args-src [arity cand] (core/join " " (map lit (tuple-of arity cand))))
(defn- params-src [params] (core/join " " params))

; ── evaluate a guard / call the function on a candidate ─────────────────────

(defn covers?
  "Does `guard-src` (a predicate over `params`) accept candidate input `cand`?
   Evaluates ((fn [params…] guard) args…) — a self-contained lambda application,
   no namespace vars, so nothing from the caller's scope leaks. A guard that
   RAISES counts as NOT covering (a raising guard declines the clause, as BEAM
   dispatch would)."
  [params guard-src cand]
  (try
    (= true (env/eval (str "((fn [" (params-src params) "] " guard-src ") "
                           (args-src (count params) cand) ")")))
    (catch _ false)))

(defn any-covers?
  "Does SOME guard accept `cand`? False ⟹ it falls through every clause head."
  [params guards cand]
  (core/some? (core/some (fn [g] (if (covers? params g cand) true nil)) guards)))

(defn- call
  "Call function `src` on candidate `cand`. Returns {:ok v} on a normal return,
   {:raised true} on any raise (a crash is a first-class fuzz outcome)."
  [src params cand]
  (let [node (first (BeamLisp.Reader/read_string src))
        body-fn (str "(fn [" (params-src params) "] "
                     ; call the defn's own body by inlining it as a lambda:
                     ; wrap the WHOLE defn and invoke the named fn.
                     ")")]
    (try
      {:ok (env/eval (str src "\n(" (fn-name-of node) " " (args-src (count params) cand) ")"))}
      (catch _ {:raised true}))))

; ── FUZZ DOMAINS ────────────────────────────────────────────────────────────

(defn ints
  "A deterministic integer fuzz domain over [lo, hi]: endpoints, zero, ±1, and a
   spread of hash-sampled interior points. Deterministic ⟹ a found failure
   replays. `n` interior samples."
  [lo hi n]
  (let [edges (list lo hi 0 1 -1 (+ lo 1) (- hi 1))
        span (+ 1 (- hi lo))
        interior (map (fn [i] (+ lo (core/mod (* (+ i 1) 2654435761) span))) (range 0 n))]
    (into [] (distinct (filter (fn [v] (and (>= v lo) (<= v hi)))
                               (concat edges interior))))))

(defn mixed
  "A cross-TYPE fuzz domain: ints, a float, strings, a keyword, a vector, a map,
   nil. Type-partiality gaps (a `kind` fn missing a clause for floats) only show
   when the domain spans types — an all-integer domain can never witness them."
  []
  (into [] (list 0 1 -1 42 -7 1.5 "hi" "" :kw [1 2] {:a 1} nil)))

(defn pairs
  "The cartesian product of two integer domains as [a b] tuples — a multi-arg
   fuzz domain. Deterministic order."
  [as bs]
  (into [] (mapcat (fn [a] (map (fn [b] [a b]) bs)) as)))

; ── COVERAGE: fuzz + prove + lint (structural, guard-based) ─────────────────

(defn check
  "Coverage of a function `src` over a candidate `domain`: which candidates a
   guard accepts, which fall through (gaps), the guards, and a verdict.
   `extra-edges` are candidates always included (regression edges)."
  [src domain extra-edges]
  (let [sh (shape-of src)
        params (:params sh)
        guards (:guards sh)
        cands (into [] (distinct (concat extra-edges domain)))
        tagged (map (fn [c] [c (any-covers? params guards c)]) cands)
        covered (into [] (keep (fn [p] (if (second p) (first p) nil)) tagged))
        uncovered (into [] (keep (fn [p] (if (second p) nil (first p))) tagged))]
    {:guards guards
     :params params
     :covered covered
     :uncovered uncovered
     :verdict (if (empty? uncovered) :total :gap)}))

(defn prove
  "The coverage property, universally: does EVERY candidate land in some clause?
   {:holds bool :counterexample cand|nil}. :holds true ⟹ every edge in `domain`
   is managed by the code's own guards."
  [src domain]
  (let [r (check src domain [])]
    {:holds (empty? (:uncovered r))
     :counterexample (if (empty? (:uncovered r)) nil (first (:uncovered r)))}))

(defn lint
  "Static findings about a function's guards over a default probe domain. An
   :incomplete-guards finding when some probed value lands in no clause. Empty ⟹
   clean. Multi-arg: probes the diagonal + a small pair grid."
  [src lo hi]
  (let [sh (shape-of src)
        dom (if (> (count (:params sh)) 1)
              (pairs (ints lo hi 4) (ints lo hi 4))
              (ints lo hi 24))
        r (check src dom [])]
    (if (empty? (:uncovered r))
      []
      [{:kind :incomplete-guards
        :missing-witness (first (:uncovered r))
        :guards (:guards r)
        :msg (str "guards " (core/join "," (:guards r))
                  " admit no clause for " (pr-str (first (:uncovered r))))}])))

; ── HYPOTHESIS TESTING: a property over the function's OUTPUT ────────────────
;
; A hypothesis is a predicate the OUTPUT must satisfy for every input — the
; behavioural analogue of a guard's structural coverage. The tool tries to
; REFUTE it by fuzzing, and on a failure SHRINKS the counterexample to the
; smallest input that still breaks it. Predicates are written over `result` (and
; the input params), evaluated as a lambda so nothing leaks.

(defn- holds-at?
  "Does hypothesis `pred-src` (over the params + `result`) hold for `cand`? Calls
   the function, then evaluates the predicate with `result` bound to the return.
   A raise during the CALL is reported as {:crash true}; a raise in the predicate
   counts as the property NOT holding (a property that errors is a failed
   property)."
  [src params pred-src cand]
  (let [r (call src params cand)]
    (if (:raised r)
      {:holds false :crash true :input cand}
      (let [ok (try
                 (= true (env/eval
                           (str "((fn [" (params-src params) " result] " pred-src ") "
                                (args-src (count params) cand) " " (lit (:ok r)) ")")))
                 (catch _ false))]
        {:holds ok :crash false :input cand :result (:ok r)}))))

(defn- smaller
  "Shrink candidates for `cand`: values closer to zero / shorter, toward a
   minimal witness. For an int: halve and step toward 0. For a pair: shrink each
   coordinate. Returns a list of strictly-simpler candidates."
  [cand]
  (if (vector? cand)
    ; shrink each coordinate independently
    (into [] (mapcat
               (fn [i]
                 (map (fn [s] (assoc cand i s))
                      (smaller-int (nth cand i))))
               (range 0 (count cand))))
    (smaller-int cand)))

(defn- smaller-int
  "Simpler integers than `v`: 0, v/2, v±1 toward 0 — the classic shrink ladder,
   deduped and strictly closer to 0 than v."
  [v]
  (if (not (int? v)) (list)
    (let [cands (list 0 (core/quot v 2) (if (> v 0) (- v 1) (+ v 1)))]
      (into [] (distinct (filter (fn [c] (< (core/abs c) (core/abs v))) cands))))))

(defn- shrink
  "Given a failing `cand`, walk the shrink ladder to a LOCAL MINIMUM: repeatedly
   replace the witness with any strictly-simpler candidate that still fails, until
   none does. Returns the minimal failing input."
  [src params pred-src cand]
  (loop [best cand fuel 200]
    (if (<= fuel 0)
      best
      (let [simpler (filter (fn [c] (not (:holds (holds-at? src params pred-src c))))
                            (smaller best))]
        (if (empty? simpler)
          best
          (recur (first simpler) (- fuel 1)))))))

(defn hypothesis
  "Test a behavioural hypothesis `pred-src` (a predicate over the input params
   and `result`) against a function `src` over `domain`. Tries to REFUTE it; on
   the first failing input, SHRINKS to the minimal witness. Returns
     {:holds true}                                           — no counterexample found
     {:holds false :witness cand :shrunk cand :result v      — refuted, minimal case
      :crash bool}                                            — whether it was a crash
   The property applies to every input by construction; the witness is the
   simplest input the code fails on."
  [src pred-src domain]
  (let [sh (shape-of src)
        params (:params sh)
        failing (core/some (fn [c]
                             (let [h (holds-at? src params pred-src c)]
                               (if (:holds h) nil h)))
                           domain)]
    (if (nil? failing)
      {:holds true}
      (let [minimal (shrink src params pred-src (:input failing))
            mres (holds-at? src params pred-src minimal)]
        {:holds false
         :witness (:input failing)
         :shrunk minimal
         :result (:result mres)
         :crash (:crash mres)}))))

; ── REPORT: every check over many functions at once ─────────────────────────

(defn report
  "Run coverage (and optional hypotheses) over several function sources. The
   property applies to ALL of them by construction — read from each function's
   clauses, no per-function test written. Each entry is
     {:name :src :domain [:edges] [:hypotheses [pred-src …]]}
   Returns {fn-name → {:coverage … :hypotheses […]}}."
  [entries]
  (into {}
    (map (fn [e]
           [(:name e)
            {:coverage (check (:src e) (:domain e) (or (:edges e) []))
             :hypotheses
               (into [] (map (fn [p] {:property p
                                      :result (hypothesis (:src e) p (:domain e))})
                             (or (:hypotheses e) [])))}])
         entries)))
