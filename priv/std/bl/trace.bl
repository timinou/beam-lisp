; bl.trace — a stack trace in the language's own terms.
;
; A BEAM frame is a 4-tuple of module, function, arity and location, and read
; literally it is the runtime describing the program rather than the program
; describing itself: `BeamLisp.Ns.Body.Bl.Cli`, a file path as a charlist, a
; location as a keyword list. A reader looking at that has to translate before
; they can act.
;
; This namespace answers the question a reader actually has — which namespace,
; which function, where — in the names the source uses:
;
;     bl.cli/cmd-eval  priv/std/bl/cli.bl:308
;
; The namespace is read from the FILE, not from the module atom. The tree's own
; layout IS the namespace: `priv/std/bl/cli.bl` is `bl.cli` and
; `priv/boot/core.bl` is `core`. The atom cannot say that. `Macro.camelize`
; takes `rt-cost-fixture` to `RtCostFixture`, and no inverse can tell that back
; from `rtcost-fixture`; so where a frame carries a `.bl` path the path decides,
; and where it does not the answer is the function alone or a de-camelized best
; effort — never a guess dressed as a name.

(ns bl.trace)

;; ── bytes ───────────────────────────────────────────────────────────────

(defn- as-string
  "`v` as a string. The BEAM spells a frame's file as a charlist; a path is
   text, so it is read as one. nil stays nil — an absent location is not the
   empty path."
  [v]
  (cond
    (nil? v) nil
    (erlang/is_binary v) v
    (erlang/is_list v) (erlang/list_to_binary v)
    (erlang/is_atom v) (erlang/atom_to_binary v)
    :else (str v)))

(defn- starts-with? [s pre]
  (let [n (erlang/byte_size s) m (erlang/byte_size pre)]
    (if (erlang/< n m) false
        (= (erlang/binary_part s 0 m) pre))))

(defn- ends-with? [s suf]
  (let [n (erlang/byte_size s) m (erlang/byte_size suf)]
    (if (erlang/< n m) false
        (= (erlang/binary_part s (erlang/- n m) m) suf))))

(defn- drop-suffix [s suf]
  (if (ends-with? s suf)
    (erlang/binary_part s 0 (erlang/- (erlang/byte_size s) (erlang/byte_size suf)))
    s))

(defn- after-marker
  "Everything after the LAST `marker` in `s`, or `s` when the marker is absent."
  [s marker]
  (let [parts (binary/split s marker (list :global))]
    (if (> (count parts) 1) (last parts) s)))

;; ── namespaces ──────────────────────────────────────────────────────────

(defn- kebab-segment
  "`Bl` → `bl`, `RtCostFixture` → `rt-cost-fixture`: a camelized namespace
   segment back in the spelling the source used."
  [seg]
  (let [out (reduce (fn [acc c]
                      (if (and (>= c 65) (not (> c 90)))
                        (cons (+ c 32) (if (empty? acc) acc (cons 45 acc)))
                        (cons c acc)))
                    (list)
                    (erlang/binary_to_list seg))]
    (erlang/list_to_binary (reverse out))))

(defn- root-and-rel
  "`[root rel]` for a frame path that sits under a source root, else nil. The
   root is kept: it is what makes the path openable from the tree."
  [file]
  (cond
    (nil? file) nil
    (not= (after-marker file "priv/std/") file)
      (list "priv/std/" (after-marker file "priv/std/"))
    (not= (after-marker file "priv/boot/") file)
      (list "priv/boot/" (after-marker file "priv/boot/"))
    (not= (after-marker file "priv/compat/") file)
      (list "priv/compat/" (after-marker file "priv/compat/"))
    :else nil))

(defn path-of-file
  "A frame's path as the tree spells it. The loader records where a module was
   actually read from — for an installed release that is an absolute path
   inside the version directory — so everything ahead of the source root is
   dropped and the root is kept: `priv/std/bl/cli.bl`. A path under no source
   root is returned as given."
  [file]
  (let [rr (root-and-rel file)]
    (if (nil? rr) file (str (first rr) (second rr)))))

(defn ns-of-file
  "The namespace a `.bl` source path belongs to, or nil.

   The tree's layout IS the namespace, so the path decides and the module atom
   is never consulted here: a path under no source root, or one that is not
   `.bl`, answers nil and leaves the atom as the only evidence. `bl` records the
   path a module was loaded from, which is absent for one built in memory."
  [file]
  (let [rr (root-and-rel file)]
    (if (and (some? rr) (ends-with? file ".bl"))
      (join "." (binary/split (drop-suffix (second rr) ".bl") "/" (list :global)))
      nil)))

(defn module-ns
  "The namespace a generated module atom names, or nil.

   The fallback for a frame with no `.bl` path. `Elixir.BeamLisp.Ns.Body.Bl.Cli`
   answers `bl.cli`. A body module spawned for a form evaluated in memory is
   named `Fn.M<N>` and has no namespace to answer, so it answers nil."
  [module]
  (let [m (as-string module)
        body? (starts-with? m "Elixir.BeamLisp.Ns.Body.")
        named? (or body? (starts-with? m "Elixir.BeamLisp.Ns."))]
    (cond
      (not named?)
        ;; A plain Erlang module names itself: `:erlang` answers `erlang`. An
        ;; Elixir module outside the language keeps its name minus the prefix,
        ;; which still points a reader at the right library.
        (if (starts-with? m "Elixir.") (after-marker m "Elixir.") m)
      :else
        (let [rest (if body?
                     (after-marker m "Elixir.BeamLisp.Ns.Body.")
                     (after-marker m "Elixir.BeamLisp.Ns."))]
          (if (starts-with? rest "Fn.")
            nil
            (join "." (map kebab-segment (binary/split rest "." (list :global)))))))))

;; ── frames ──────────────────────────────────────────────────────────────

(defn- frame-location
  "A frame's `[file line]`. The BEAM spells the location as a keyword list; a
   BIF frame carries no file, and a frame with no position carries nothing."
  [f]
  (let [loc (erlang/element 4 f)]
    (cond
      (erlang/is_list loc)
        (list (as-string (proplists/get_value :file loc nil))
              (proplists/get_value :line loc nil))
      (erlang/is_map loc)
        (list (as-string (maps/get loc :file nil)) (maps/get loc :line nil))
      :else (list nil nil))))

(defn frame->bl
  "One raw BEAM stack frame → a beam-lisp frame map.

   Keys: `:module`, `:fn`, `:arity`, `:args`, `:file`, `:line`, `:ns`. `:arity`
   is an integer for a function call and nil for a BIF frame, where the BEAM
   puts the ARGUMENTS in that slot and `:args` carries them instead. `:ns` is nil
   when the frame names no beam-lisp namespace, which the renderer prints as the
   function alone."
  [f]
  (let [module (erlang/element 1 f)
        slot (erlang/element 3 f)
        loc (frame-location f)
        shown (path-of-file (first loc))]
    {:module module
     :fn (as-string (erlang/element 2 f))
     :arity (if (erlang/is_integer slot) slot nil)
     :args (if (erlang/is_integer slot) nil slot)
     :file shown
     :line (second loc)
     :ns (or (ns-of-file shown) (module-ns module))}))

(defn render-frame
  "One frame map as the line a reader scans:
   `  at bl.cli/cmd-eval  priv/std/bl/cli.bl:308`."
  [fm]
  (let [site (if (:file fm)
               (str "  " (:file fm) (if (:line fm) (str ":" (:line fm)) ""))
               "")
        who (if (:ns fm) (str (:ns fm) "/" (:fn fm)) (:fn fm))]
    (str "  at " who site)))

(defn format-frames
  "A caught exception's frame list as beam-lisp text, one frame per line; an
   empty string when there is nothing to say."
  [frames]
  (if (or (nil? frames) (not (erlang/is_list frames)) (empty? frames))
    ""
    (join "\n" (map render-frame (map frame->bl (to-list frames))))))
