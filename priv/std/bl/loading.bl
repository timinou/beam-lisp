; One startup policy for every bl serve application, not an application cache.
(ns bl.loading
  (:require [source-graph :as graph]))

(def DEFAULTS {:environment-env "BL_ENV" :development :lazy :production :startup :roots []})

(defn validate
  "Pure configuration check. Unknown keys and unsupported modes fail closed."
  [config]
  (let [c (if (nil? config) {} config)]
    (when (not (map? c))
      (throw (ex-info ":loading must be a map" {:kind :loading-config})))
    (when (some (fn [k] (not (contains? DEFAULTS k))) (keys c))
      (throw (ex-info "Unknown :loading key" {:kind :loading-config})))
    (let [p (merge DEFAULTS c)]
      (when (not (and (string? (:environment-env p)) (not= "" (:environment-env p))
                      (= :lazy (:development p)) (= :startup (:production p))
                      (vector? (:roots p))
                      (every? (fn [n] (and (string? n) (not= "" n))) (:roots p))))
        (throw (ex-info "Invalid :loading policy: development :lazy, production :startup"
                        {:kind :loading-config})))
      p)))

(defn mode
  "Select a mode from one captured environment value. No global mutable policy."
  [policy environment]
  (if (contains? #{"production" "prod"} environment)
    (:production policy) (:development policy)))

(defn header-for
  "Select the actual declaration in literate source, ignoring illustrative nses."
  [n source]
  (first (filter (fn [header] (= n (first header)))
                 (map (fn [form] (graph/header-forms (list form))) (graph/forms source)))))

(defn dependencies
  [n]
  (let [source (BeamLisp.Loader/source_content n)]
    (when (nil? source)
      (throw (ex-info "Startup dependency source unavailable"
                      {:kind :loading-source :namespace n})))
    (let [[declared requires] (header-for n source)]
      (when (not= declared n)
        (throw (ex-info "Startup dependency declaration unavailable"
                        {:kind :loading-namespace :namespace n})))
      requires)))

(defn prepare
  "Dependency-injected barrier. Lazy mode does not even read the entry source.
   Startup traverses all roots once, then loads libraries. Entry execution is
   exclusively the caller's responsibility, after successful completion."
  [policy environment entry-source dependencies load!]
  (let [p (validate policy)]
    (if (= :lazy (mode p environment))
      {:mode :lazy :namespaces 0}
      (let [[entry roots] (graph/header (entry-source))
            _ (when (nil? entry)
                (throw (ex-info "Startup loading requires an entry namespace"
                                {:kind :loading-entry})))
            _ (when (some (fn [n] (= entry n)) (:roots p))
                (throw (ex-info "Entry program cannot be a preload root"
                                {:kind :loading-entry})))
            nses (into #{} (mapcat (fn [root] (graph/closure root dependencies))
                                   (concat roots (:roots p))))]
        ;; A library dependency back to the entry would run it too early.
        (when (contains? nses entry)
          (throw (ex-info "Library dependency reaches entry program"
                          {:kind :loading-entry})))
        (doseq [n (sort nses)] (load! n))
        {:mode :startup :namespaces (count nses)}))))

(defn prepare!
  "Apply a project's policy for a resolved bl serve entry path. The normal
   loader retains environment ownership, validity checks and load coordination."
  [project entry]
  (let [policy (validate (:loading project))
        start (erlang/monotonic_time :millisecond)
        result (prepare policy (System/get_env (:environment-env policy))
                        (fn [] (BeamLisp.Loader/read_source entry))
                        dependencies (fn [n] (BeamLisp.Loader/ensure_loaded n)))]
    (when (= :startup (:mode result))
      (println (str "Startup preload complete: " (:namespaces result) " namespaces in "
                    (- (erlang/monotonic_time :millisecond) start) " ms")))
    result))
