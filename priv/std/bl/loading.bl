; One startup policy for every bl serve application, not an application cache.
(ns bl.loading
  (:require [bl.loading-policy :as policy] [source-graph :as graph] [build-plan :as plan] [proc.admission :as admission]))

(def DEFAULTS policy/DEFAULTS)

(defn validate [config] (policy/validate config))

(defn mode
  "Select a mode from one captured environment value. No global mutable policy."
  [policy environment]
  (if (contains? #{"production" "prod"} environment)
    (:production policy) (:development policy)))

(defn header-for
  "Select the actual declaration through byte-keyed source parts. Primed SDK
   parts and parts already parsed by another pass avoid reparsing function
   bodies. A different source or requested namespace cannot reuse a header."
  [n source]
  (when-let [header (plan/header-for n source)] (vec header)))

(defn dependencies
  [n]
  (let [source (BeamLisp.Loader/source_content n)]
    (when (nil? source)
      (throw (ex-info "Startup dependency source unavailable"
                      {:kind :loading-source :namespace n})))
    (let [[declared requires] (header-for n source)]
      (when (not= declared n)
        (throw (ex-info "Startup dependency declaration unavailable"
                        {:kind :loading-namespace :namespace n})))
      requires)))

(defn discover
  "One visited set for ALL roots. Each dependency source is requested once,
   including shared descendants and cycles. No namespace is loaded here."
  [roots dependencies]
  (loop [pending (seq roots) seen #{}]
    (if (empty? pending) seen
      (let [n (first pending)]
        (if (contains? seen n) (recur (rest pending) seen)
          (recur (concat (dependencies n) (rest pending)) (conj seen n)))))))

(defn- reductions [] (elem (erlang/process_info (erlang/self) :reductions) 1))
(defn- now [] (erlang/monotonic_time :microsecond))

(defn- admitted! [namespace result]
  (when (= :cancelled result)
    (throw (ex-info "Startup library admission was cancelled"
                    {:kind :loading-cancelled :namespace namespace})))
  result)

(defn prepare-measured
  "Injected barrier with phase receipts. Detail is opt-in and bounded to the
   slowest 20 libraries; aggregate counters do not retain source or values."
  [policy environment entry-source dependencies load! detail?]
  (let [p (validate policy)]
    (if (not= :startup (mode p environment))
      {:mode (mode p environment) :namespaces 0 :discovery-us 0 :loading-us 0 :reductions 0}
      (let [start (now) before (reductions)
            [entry roots] (graph/header (entry-source))
            _ (when (or (nil? entry) (some (fn [n] (= entry n)) (:roots p)))
                (throw (ex-info "Invalid startup entry/root" {:kind :loading-entry})))
            nses (discover (concat roots (:roots p)) dependencies)
            _ (when (contains? nses entry)
                (throw (ex-info "Library dependency reaches entry program" {:kind :loading-entry})))
            discovered (now)
            slowest (reduce (fn [rows n]
                       (let [t (now) r (reductions)]
                         (admitted! n (load! n))
                         (if detail?
                           (vec (take 20 (sort-by (fn [row] (- (:elapsed-us row)))
                             (conj rows {:namespace n :elapsed-us (- (now) t)
                                         :reductions (- (reductions) r)})))) rows)))
                       [] (sort nses))]
        (cond-> {:mode :startup :namespaces (count nses)
                 :discovery-us (- discovered start) :loading-us (- (now) discovered)
                 :reductions (- (reductions) before)}
          detail? (assoc :slowest slowest))))))

(defn prepare
  "Compatibility API: lazy does not discover; entry runs only in the caller."
  [policy environment entry-source dependencies load!]
  (select-keys (prepare-measured policy environment entry-source dependencies load! false)
               [:mode :namespaces]))

(defn- prepare-package! [policy root entry detail?]
 (BeamLisp.Loader/ensure_loaded "application.package")
 (let [start (now) before (reductions)
       manifest (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! "application.package" "install!")
                  (list root (BeamLisp.Loader/read_source entry) (:roots policy)))
       verified (now)
       load-package (fn []
                      (doseq [n (:namespaces manifest)] (admitted! n (BeamLisp.Loader/ensure_loaded n)))
                      {:mode :startup :namespaces (count (:namespaces manifest))
                       :package root :discovery-us (- verified start)
                       :loading-us (- (now) verified) :reductions (- (reductions) before)})
       result (if (= 2 (:format manifest)) (load-package)
                 (BeamLisp.Loader/with_search_dir (str root "/source") load-package))]
  result))

(defn prepare!
  "Apply project policy. A production pass shares evidence only inside the
   owning loader session; a later pass always rereads live sources."
  [project entry]
  (let [policy (validate (:loading project)) environment (System/get_env (:environment-env policy))
        detail? (= "1" (System/get_env "BL_STARTUP_PROFILE"))
        start (now)
        package-path (when (and (= :startup (mode policy environment)) (:package-env policy))
                       (System/get_env (:package-env policy)))
        run (fn [] (if package-path
                    (prepare-package! policy (Path/expand package-path (or (:root project) (BeamLisp/cwd))) entry detail?)
                    (prepare-measured policy environment
                     (fn [] (BeamLisp.Loader/read_source entry))
                     dependencies (fn [n] (BeamLisp.Loader/ensure_loaded n)) detail?)))
        result (if (= :startup (mode policy environment))
                 (BeamLisp.Loader/with_loading_session run) (run))]
    (when (= :startup (:mode result))
      (println (str "Startup preload complete: " (:namespaces result) " namespaces in "
                    (quot (- (now) start) 1000) " ms"))
      (when detail? (println (str "Startup profile: " (pr-str result)))))
    result))

(defn start-background!
  "Optional development-only warm-up AFTER entry returns. One linked finite
   worker, ordinary per-library loader locks, no long session blocking requests.
   Source/reload validation remains the normal loader's responsibility."
  [project entry]
  (let [policy (validate (:loading project))
        environment (System/get_env (:environment-env policy))]
    (when (= :async (mode policy environment))
      (let [owner (erlang/self)
            request (admission/token owner 300000)
            dirs (or (Process/get :bl_fixed_dirs) (Process/get :bl_search_dirs)
                     (Process/get :bl_ambient_dirs) (list (BeamLisp/cwd)))
            action (BeamLisp.Env/convey
                     (fn [_]
                       (try
                         (let [result (BeamLisp.Loader/with_ambient_dirs dirs
                                      (fn [] (prepare-measured policy "production"
                                         (fn [] (BeamLisp.Loader/read_source entry)) dependencies
                                         (fn [n]
                                           (when (not (admission/live? request))
                                             (throw (ex-info "Development warm-up owner/budget ended" {})))
                                           (admitted! n (admission/with-request request (fn [] (BeamLisp.Loader/ensure_loaded n))))
                                           (Process/sleep 1)) false)))]
                           (println (str "Development warm-up complete: " (:namespaces result) " namespaces")))
                         (catch e
                           (println (str "Development warm-up failed: " (ex-message e)))))))]
        (erlang/spawn_link (fn [] (action nil)))))))
