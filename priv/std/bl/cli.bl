; bl/cli.bl — the beam-lisp CLI, written in beam-lisp. ALL of it.
;
; `bl` enters this namespace's AOT module (BeamLisp.Ns.Bl.Cli — real named
; BEAM functions, per the AOT contract): the drop launcher and `mix bl` both
; call `main/1` (or `run-argv/1` when the caller owns the VM). There is no
; Elixir floor module: `main` boots the substrate itself (BeamLisp.AOT/boot —
; Env + Loader.Server + the core seed), repopulates this namespace's var
; registry via ensure_loaded, and dispatches. Usage text, flag parsing, help,
; dispatch and exit codes all live here — compiled by the self-hosted compiler
; on every `mix compile` (priv/ is an AOT source dir) and shipped inside the
; release. The Elixir-shape bridges every verb shares (keyword lists, JSON
; lowering, path expansion) live in `bl.util`; each verb beyond the core set is
; its own `bl.<verb>` namespace, loaded on first use.
;
; Exit codes: 0 ok · 1 runtime failure · 2 usage error.

(ns bl.cli
  (:require [bl.util :as u] [bl.env :as env] [vm.client]))

;; ── argv parsing ──────────────────────────────────────────────────────
;; One uniform shape: global flags may appear anywhere before `--`, the
;; first positional is the command, the rest are its arguments. Built only
;; from verified primitives (assoc-in/get-in/loop/recur) — no #() literals,
;; no tuples-as-lists, no Elixir keyword literals.

(defn add-arg [st a] (assoc-in st [:args] (cons a (:args st))))
(defn dd-arg
  "Cons a post-`--` token onto `:dd` (the program's own argv), NOT `:args`.
  The program reads these through `BeamLisp/argv`; keeping them out of `:args`
  is what makes `--` the boundary between the command's arguments and the
  program's."
  [st a] (assoc-in st [:dd] (cons a (:dd st))))

(defn parse-int
  "An integer from a flag value, or nil when the value is not one."
  [s]
  (let [r (Integer/parse s)]
    (if (and (tuple? r) (= "" (erlang/element 2 r))) (erlang/element 1 r) nil)))

(defn parse-argv [argv]
  (loop [as argv
         st {:cmd nil :args [] :paths [] :out nil :async false :force false :jobs nil
             :json false :code-paths [] :tier nil :port nil
             :k nil :ns nil :like nil
             :max_mb nil :dry_run false
             :changed false :update false :fix false :check false :remove false :native false
             :install-hook false
             :shared false
             :diagnose false
             :help false :version false :dd nil}]
    (if (empty? as)
      (assoc-in (assoc-in st [:args] (reverse (:args st)))
                [:dd] (reverse (or (:dd st) [])))
      (let [a (first as)
            more (rest as)]
        (cond
          ;; after `--` everything is a PROGRAM argument (goes to :dd, exposed
          ;; as BeamLisp/argv), never the command's own positionals
          (:dd st)         (recur more (dd-arg st a))
          (= a "--")       (recur more (assoc-in st [:dd] []))
          (= a "-h")       (recur more (assoc-in st [:help] true))
          (= a "--help")   (recur more (assoc-in st [:help] true))
          (= a "--version") (recur more (assoc-in st [:version] true))
          (= a "--json")   (recur more (assoc-in st [:json] true))
          (= a "--deep")   (recur more (assoc-in st [:deep] true))

          ;; flags that take a value
          (= a "-p")
          (if (empty? more)
            (assoc-in st [:error] "missing value for -p")
            (recur (rest more)
                   (assoc-in st [:paths] (cons (first more) (:paths st)))))
          (= a "--path")
          (if (empty? more)
            (assoc-in st [:error] "missing value for --path")
            (recur (rest more)
                   (assoc-in st [:paths] (cons (first more) (:paths st)))))
          (= a "--code-path")
          (if (empty? more)
            (assoc-in st [:error] "missing value for --code-path")
            (recur (rest more)
                   (assoc-in st [:code-paths] (cons (first more) (:code-paths st)))))
          (= a "--out")
          (if (empty? more)
            (assoc-in st [:error] "missing value for --out")
            (recur (rest more) (assoc-in st [:out] (first more))))
          (= a "--scratch")
          (if (empty? more)
            (assoc-in st [:error] "missing value for --scratch")
            (recur (rest more) (assoc-in st [:scratch] (first more))))
          ;; `--bin PATH` is the launcher a self-build should seal with. It
          ;; exists so a CHECKOUT can build a drop with no drop to start from:
          ;; there, the launcher is a stock binary built by cargo.
          (= a "--bin")
          (if (empty? more)
            (assoc-in st [:error] "missing value for --bin")
            (recur (rest more) (assoc-in st [:bin] (first more))))
          (= a "--lock")
          (if (empty? more)
            (assoc-in st [:error] "missing value for --lock")
            (recur (rest more) (assoc-in st [:lock] (first more))))
          (= a "--ebin")
          (if (empty? more)
            (assoc-in st [:error] "missing value for --ebin")
            (recur (rest more) (assoc-in st [:ebin] (first more))))
          (= a "--async")  (recur more (assoc-in st [:async] true))
          (= a "--shared") (recur more (assoc-in st [:shared] true))
          ;; test --diagnose: report the state a file's answer could have read
          ;; that the file did not create (BUG-041, reload.ward-diag)
          (= a "--diagnose") (recur more (assoc-in st [:diagnose] true))
          (= a "--force")  (recur more (assoc-in st [:force] true))
          (= a "--jobs")
          (if (empty? more)
            (assoc-in st [:error] "missing value for --jobs")
            (let [n (parse-int (first more))]
              (if (nil? n)
                (assoc-in st [:error] (str "--jobs needs a number, got " (first more)))
                (recur (rest more) (assoc-in st [:jobs] n)))))
          (= a "--tier")
          (if (empty? more)
            (assoc-in st [:error] "missing value for --tier")
            (recur (rest more) (assoc-in st [:tier] (first more))))
          (= a "--port")
          (if (empty? more)
            (assoc-in st [:error] "missing value for --port")
            (let [n (parse-int (first more))]
              (if (nil? n)
                (assoc-in st [:error] (str "--port needs a number, got " (first more)))
                (recur (rest more) (assoc-in st [:port] n)))))

          ;; search: how many hits, and the two ways to narrow the corpus
          (= a "-k")
          (if (empty? more)
            (assoc-in st [:error] "missing value for -k")
            (let [n (parse-int (first more))]
              (if (nil? n)
                (assoc-in st [:error] (str "-k needs a number, got " (first more)))
                (recur (rest more) (assoc-in st [:k] n)))))
          (= a "--ns")
          (if (empty? more)
            (assoc-in st [:error] "missing value for --ns")
            (recur (rest more) (assoc-in st [:ns] (first more))))
          (= a "--like")
          (if (empty? more)
            (assoc-in st [:error] "missing value for --like")
            (recur (rest more) (assoc-in st [:like] (first more))))

          ;; cache: the ceiling on the analysis store, and a look before deleting
          (= a "--max-mb")
          (if (empty? more)
            (assoc-in st [:error] "missing value for --max-mb")
            (let [n (parse-int (first more))]
              (if (nil? n)
                (assoc-in st [:error] (str "--max-mb needs a number, got " (first more)))
                (recur (rest more) (assoc-in st [:max_mb] n)))))
          (= a "--dry-run")      (recur more (assoc-in st [:dry_run] true))
          (= a "--changed")      (recur more (assoc-in st [:changed] true))
          (= a "--update")       (recur more (assoc-in st [:update] true))
          (= a "--fix")          (recur more (assoc-in st [:fix] true))
          (= a "--check")        (recur more (assoc-in st [:check] true))
          (= a "--remove")       (recur more (assoc-in st [:remove] true))
          (= a "--native")       (recur more (assoc-in st [:native] true))
          (= a "--install-hook") (recur more (assoc-in st [:install-hook] true))

          ;; unknown dash-thing: bare "-" is a positional (stdin convention)
          (and (starts-with? a "-") (not= a "-"))
          (assoc-in st [:unknown] a)

          ;; first positional is the command, the rest are arguments
          (nil? (:cmd st)) (recur more (assoc-in st [:cmd] a))
          :else            (recur more (add-arg st a)))))))

;; `bl.cli/code-paths` is the public name for the `bl.util` helper, so a
;; caller that starts from `parse-argv` (a test, the daemon) reads the code
;; paths through the same namespace that parsed them.
(def code-paths u/code-paths)

;; ── help ──────────────────────────────────────────────────────────────

(def command-help
  {"run"     "bl run FILE|- [-- args...]               run a program (stdin when FILE is -)"
   "eval"    "bl eval EXPR|-                           evaluate one expression, print its value"
   "repl"    "bl repl                                  interactive session (default with no command)"
   "test"    "bl test [PATH...] [--shared] [--json] [--diagnose]    run .bl tests, each file isolated (default test/)"
   "examples" "bl examples [GLOB...] [--json]          ward-isolated example runner"
   "tasks"   "bl tasks                                 the tasks this project declares"
   "ports"   "bl ports | bl ui [--open]                 the session's named ports, and its URL"
   "open"    "bl open NAME [--open]                 the address behind a named port"
   "gateway" "bl gateway start|stop|status|run       the gateway that answers names"
   "check"   "bl check [PATH...] [--changed] [--update] [--fix] [--json] [--install-hook]"
   "lint"    "bl lint [PATH...] [--tier safe|idiomatic|every] [--json]   report smells"
   "fix"     "bl fix [PATH...] [--tier ...]             apply safe rewrites"
   "ask"     "bl ask QUESTION [TARGET] [PATH...] [--json]   codebase questions"
   "search"  "bl search QUERY [-k N] [--ns NS] [--like NAME] [-p DIR]   find functions by what they MEAN"
   "oracle"  "bl oracle stats [PATH...] [--dry-run] [--json]        what the oracle answered, and what it cost"
   "build"   "bl build [PATH...] [--out DIR] [--force] [--jobs N] [--native]  AOT-compile (defaults from env.bl)"
   "self-build" "bl self-build [--out BIN] [--scratch DIR]   the drop rebuilds itself (W6)"
   "deps"    "bl deps verify|list|fetch|compile [--lock DIR]   the library store"
   "seed"    "bl seed [--out DIR] [--ebin DIR]           regenerate the bootstrap floor"
   "watch"   "bl watch FILE|DIR                        live-reload on save"
   "monitor" "bl monitor DIR                           live reload image, re-rendered per commit"
   "serve"   "bl serve FILE [--port N]                 run, then keep the VM alive"
   "daemon"  "bl daemon start|stop|status              the warm-VM dev loop (one per tree)"
   "doc"     "bl doc run FILE... [--check] | bl doc build TARGET... [--out DIR]   livebooks"
   "lsp"     "bl lsp check FILE [--json] | bl lsp serve   analyze a file / serve the language server"
   "mcp"     "bl mcp                                   stdio MCP server"
   "install" "bl install TARGET [DIR] [--check] [--remove]   beam-lisp into your tools (doom, mcp, gateway, redirect)"
   "override" "bl override vendor|apply|list|diff|revert   override the .bl the compiler ships"
   "doctor"  "bl doctor [--deep] [--json]                environment + toolchain report"
   "cache"   "bl cache status | prune [--max-mb N] [--dry-run]   what the analysis store holds"
   "version" "bl version                                print the version"
   "help"    "bl help [COMMAND]                         show help"})

(def usage-groups
  [["run · eval · repl"                       ["run" "eval" "repl"]]
   ["test · examples · tasks · check · lint · fix · ask · search · oracle"
                                              ["test" "examples" "tasks" "check" "lint" "fix" "ask" "search" "oracle"]]
   ["build"                                   ["build" "self-build" "deps" "seed"]]
   ["watch · monitor · serve · daemon"        ["watch" "monitor" "serve" "daemon"]]
   ["ports · ui"                              ["ports" "ui"]]
   ["open · gateway"                          ["open" "gateway"]]
   ["doc"                                     ["doc"]]
   ["lsp · mcp"                               ["lsp" "mcp"]]
   ["install · override"                     ["install" "override"]]
   ["doctor · cache · version · help"          ["doctor" "cache" "version" "help"]]])

(defn usage []
  (println "bl — beam-lisp on the BEAM")
  (println "")
  (println "usage: bl [flags] COMMAND [args]")
  (println "")
  (println "commands:")
  (u/each
   (fn [g]
     (println (str "  " (first g)))
     (u/each (fn [c] (println (str "      " (get-in command-help [c])))) (second g)))
   usage-groups)
  (println "")
  (println "flags:")
  (println "  -p, --path DIR      add a library root (repeatable; BEAM_LISP_PATH also works)")
  (println "      --code-path DIR put a directory of AOT beams on the VM code path (repeatable)")
  (println "      --out DIR       build/doc output directory")
  (println "      --async         test: the concurrent runner (shared image, one env per file)")
  (println "      --shared        test: one shared image, every file in it")
  (println "      --diagnose      test: also report state a file's answer could have read")
  (println "                      that the file did not create (BUG-041; implies --deep)")
  (println "      --force         build: rebuild every source")
  (println "      --jobs N        build: parallel width per wave (default: schedulers)")
  (println "      --tier V        lint/fix: safe | idiomatic | every")
  (println "      --port N        serve: TCP port")
  (println "  -k N                search: how many hits to show (default 10)")
  (println "      --ns NS         search: only functions in this namespace")
  (println "      --like NAME     search: functions that look like this one")
  (println "      --changed       check: only sources changed since the last run")
  (println "      --update        check: record the new baseline")
  (println "      --fix           check: apply the safe rewrite")
  (println "      --check         doc/install: report drift / verify instead of writing")
  (println "      --remove        install: undo what an install target wrote")
  (println "      --native        build: also emit native modules")
  (println "      --install-hook  check: install the pre-commit hook")
  (println "      --json          machine-readable output where a command offers it")
  (println "      --deep          doctor: the toolchain's own facts too; test --diagnose: per-key detail")
  (println "  -h, --help          show help")
  (println "      --version       print the version")
  (println "  --                  everything after this goes to the program")
  (println "")
  (println "exit codes: 0 ok · 1 runtime failure · 2 usage error"))

;; ── commands (each returns an exit code) ──────────────────────────────

(defn cmd-run [args st]
  (if (empty? args)
    (u/usage-error "usage: bl run FILE.bl [-- args...]")
    (do (u/register-paths st)
        ;; parity with a plain `bl` program run: the last value prints. The
        ;; program sees its post-`--` args via `BeamLisp/argv`; `:dd` carries
        ;; them. `-` reads the program from standard input.
        (BeamLisp/with_argv (u/to-list (or (:dd st) []))
          (fn []
            (let [target (first args)
                  v (if (= target "-")
                      (BeamLisp/eval (u/read-source "-"))
                      (BeamLisp/run_file (u/resolve target)))]
              (println (BeamLisp.RT/print_str v)))))
        0)))

(defn cmd-eval [args st]
  (if (empty? args)
    (u/usage-error "usage: bl eval EXPR")
    (do (u/register-paths st)
        (let [src (if (and (= 1 (count args)) (= "-" (first args)))
                    (u/read-source "-")
                    (u/join-args args))]
          (u/emit st (BeamLisp/eval src) (fn [v] (BeamLisp.RT/print_str v))))
        0)))

(defn cmd-self-build
  "`bl self-build [--out BIN] [--scratch DIR]` — the drop rebuilds itself.

   Sources come from the RUNNING `priv` (in a drop, the payload's own), the
   launcher from the compound `BL_BIN` names, and the compiler from whatever
   image is running. So this verb is the same program in every generation, and a
   generation builds the next with the compiler it was built by — which is why
   the proof is the fixpoint gate, not this run."
  [_args st]
  (u/register-paths st)
  (BeamLisp.Loader/ensure_loaded "selfbuild")
  (let [run (BeamLisp.Env/fetch! "selfbuild" "run")
        out (u/resolve (or (:out st) "bl-self"))
        scratch (u/resolve (or (:scratch st) (Path/join (System/tmp_dir) "bl-selfbuild")))
        ; `--bin` wins over `BL_BIN`, and that is the CHECKOUT path: a stock
        ; launcher built by cargo, with no compound behind it (see
        ; `selfbuild/launcher-file`). In a drop, BL_BIN is the compound the
        ; launcher is extracted from.
        bin (or (:bin st) (System/get_env "BL_BIN"))
        r (run {:out out :scratch scratch
                :bin (if (some? bin) (u/resolve bin) nil)
                :jobs (:jobs st)})]
    (u/each u/io-err (:errors r))
    (when (:ok? r)
      (println (str "self-build: " (:out r) "  (" (:built r) " tier sources rebuilt from "
                    (:running-root r) ", " (:len r) " payload bytes)")))
    (if (:ok? r) 0 1)))

(defn cmd-deps
  "`bl deps verify|list|fetch|compile [--lock DIR]` — the library store.

   `verify` is offline and is the one a build or CI runs: does the store hold
   exactly what the lock names? `list` reports the DISK, not the lock, so the two
   can disagree out loud. `fetch` obtains only what is missing, only for `:hex`
   sources — a `:path` library is the tree's own and a `:payload` library is the
   running drop's. `compile` turns the fetched sources into beams and an `.app`,
   addressed by content beside the store, which is what makes a lock usable with
   no Mix and no `deps/`."
  [args st]
  (let [sub (first args)
        dir (u/resolve (or (:lock st) "."))]
    (BeamLisp.Loader/ensure_loaded "deps")
    (BeamLisp.Loader/ensure_loaded "deps-compile")
    (cond
      (= sub "verify")
      (let [r (BeamLisp.RT/invoke (BeamLisp.Env/fetch! "deps" "verify") (list dir))]
        (if (:ok? r)
          (do (println (str "bl deps: " (:checked r) " libraries locked, all present")) 0)
          (do (u/io-err (str "bl deps: store does not match the lock"
                             (if (some? (:why r)) (str " — " (:why r)) "")))
              (u/each (fn [m] (u/io-err (str "  missing: " (:name m) " " (:vsn m) " (" (:sha m) ")")))
                      (:missing r))
              1)))

      (= sub "list")
      (let [rows (BeamLisp.RT/invoke (BeamLisp.Env/fetch! "deps" "installed") (list))]
        (u/each (fn [e] (println (str "  " (:name e) " " (:vsn e) " " (:sha8 e)))) rows)
        (println (str "bl deps: " (count rows) " in the store"))
        0)

      (= sub "fetch")
      (let [scratch (u/resolve (or (:scratch st) (Path/join (System/tmp_dir) "bl-deps")))
            t (BeamLisp.RT/invoke (BeamLisp.Env/fetch! "hex" "httpc-transport") (list))
            r (BeamLisp.RT/invoke (BeamLisp.Env/fetch! "deps" "fetch!") (list dir scratch t))
            ; `fetch!` answers a NAME for a library it installed and a MAP for one
            ; it could not, so the two must not be printed the same way. The
            ; first version labelled every entry "failed" — including all 47
            ; names, on a run that had just installed all 47.
            bad (vec (filter map? (:fetched r)))
            got (vec (remove map? (:fetched r)))]
        (println (str "bl deps: " (:wanted r) " locked, " (count got) " fetched"))
        (u/each (fn [m] (u/io-err (str "  failed: " (:name m) " — " (:why m)))) bad)
        (if (empty? bad) 0 1))

      (= sub "compile")
      ; The verb that makes a fetched library USABLE. `install-paths!` runs
      ; first, so libraries compiled by an earlier run are on the code path
      ; while this one compiles their dependents — which is why the passes
      ; exist at all.
      (let [wait 60000
            _ (BeamLisp.RT/invoke (BeamLisp.Env/fetch! "deps-compile" "install-paths!") (list))
            r (BeamLisp.RT/invoke (BeamLisp.Env/fetch! "deps-compile" "compile!")
                                  (list dir wait println))
            results (or (:results r) [])]
        (u/each (fn [x] (println (str "  " (name (:state x)) "  " (:name x) " " (:vsn x)
                                      (if (some? (:why x)) (str " — " (:why x)) ""))))
                results)
        (println (str "bl deps: " (count results) " locked, "
                      (count (filter (fn [x] (or (= :compiled (:state x)) (= :cached (:state x)))) results))
                      " usable, " (:passes r) " pass(es)"))
        (if (:ok? r)
          0
          (do (u/io-err (str "bl deps: not every library compiled"
                             (if (some? (:why r)) (str " — " (:why r)) "")))
              1)))

      :else
      (u/usage-error "usage: bl deps verify|list|fetch|compile [--lock DIR]"))))

(defn cmd-seed
  "`bl seed [--out DIR] [--ebin DIR]` — regenerate the bootstrap floor
   (`priv/bootstrap/seed/`): the compiled Core-Erlang beams of the boot prelude,
   plus the manifest recording the tier keys they were built under and a sha256
   per beam.

   This is what `mix run priv/bootstrap/gen_manifest.exs` was, and it needs no
   Mix for the one thing that file needed it for — knowing where the compiled
   beams are. `--ebin` says; `BL_SEED_EBIN` says; otherwise the conventional
   layout BOTH toolchains write (`_build/<env>/lib/beam_lisp/ebin`) is read, and
   finding no beams there is an error naming the flag rather than a silently
   empty floor.

   Nothing is written until every shim beam has been loaded and asked for its
   provenance stamp: a floor cleared and then found foreign would be a floor
   destroyed. `--out` defaults to the checked-in `priv/bootstrap/seed`."
  [_args st]
  (do (u/register-paths st)
      (BeamLisp.Loader/ensure_loaded "seed")
      (BeamLisp.Loader/ensure_loaded "app-resource")
      ; `:app` is derived from the project value and written INTO the floor:
      ; the floor has to be enough to start the application, not just to load
      ; the compiler (see `app-resource`). The derivation happens here, in the
      ; tier that reads env.bl, and the writer it calls is the one a package's
      ; `.app` goes through.
      (let [r ((BeamLisp.Env/fetch! "seed" "run")
               {:root (BeamLisp/cwd)
                :out (if (some? (:out st)) (u/resolve (:out st)) nil)
                :ebin (if (some? (:ebin st)) (u/resolve (:ebin st)) nil)
                :app (BeamLisp.RT/invoke
                       (BeamLisp.Env/fetch! "app-resource" "of-project")
                       (list (project-value)))})]
        (u/each u/io-err (:errors r))
        (when (:ok? r)
          (println (str "bl seed: " (:modules r) " beams → " (u/rel-path (:out r))
                        "  (codegen=" (subs (:compiler-key r) 0 12) "… driver="
                        (subs (:build-key r) 0 12) "…"
                        (if (some? (:app r)) (str " app=" (:app r)) "")
                        ")")))
        (if (:ok? r) 0 1))))

(defn cmd-build
  "`bl build [PATH...] [--out DIR] [--force] [--jobs N] [--native]` — the same
   driver `mix compile` runs (`build/run`): dependency order, parallel waves,
   interface-keyed freshness, a manifest in the output dir. Second run is a
   no-op; a body edit rebuilds one file.

   Two things this verb adds around the driver, because a VERB is where a user
   meets the build:

     the CLAIM      the output directory is claimed, and a live claim is reported
                    by owner and pid rather than waited on. Mix held a 0-byte
                    lock here and named nobody (measured). A stale claim is
                    swept, so a killed build does not wedge the tree.
     the JOURNAL    start and finish go into `reload`'s journal, so a monitor
                    watching the image sees the build in the same stream as
                    every other change, and `reload/journal` answers what the
                    tree has been doing.

   Called with no PATH it builds what the tree DECLARED: `:build` in env.bl
   names the roots, the output, the width and whether the tree has natives. A
   flag still wins, and a PATH still means exactly what it meant — the
   declaration only fills the silence."
  [args st]
  (do (u/register-paths st)
      ; The tree may declare what `bl build` should do by default: `:build` in
      ; its env.bl names the roots, the output, the width and whether it has
      ; natives. A flag still wins, and a PATH argument still means exactly what
      ; it meant — the declaration only fills the silence.
      (let [declared (:build (project-value))
            ; `:paths` are ROOTS to search, the driver wants FILES: expand them
            ; the same way a PATH argument is expanded, so `priv/build` means the
            ; sources under it and not the directory itself (which the driver
            ; answered with "illegal operation on a directory", observed).
            paths (if (empty? args)
                    (vec (mapcat u/expand-targets (:paths declared)))
                    (vec (mapcat u/expand-targets (map u/resolve args))))]
    (if (empty? paths)
      (u/usage-error "usage: bl build [PATH...] [--out DIR] [--force] [--jobs N] [--native]")
      (do
          (BeamLisp.Loader/ensure_loaded "build")
          (BeamLisp.Loader/ensure_loaded "claim")
          (BeamLisp.Loader/ensure_loaded "reload")
          (let [out (cond
                      (:out st) (u/resolve (:out st))
                      (:out declared) (:out declared)
                      :else (u/resolve "build"))
                held (BeamLisp.RT/invoke (BeamLisp.Env/fetch! "claim" "held-by") (list out))]
            (if (some? held)
              (do (u/io-err (str "bl build: " out " is already being built by pid "
                                 (:pid held) " (since " (:at held) ") — not waiting"))
                  1)
              (do
                (BeamLisp.RT/invoke (BeamLisp.Env/fetch! "claim" "acquire!") (list out "bl build"))
                (BeamLisp.RT/invoke (BeamLisp.Env/fetch! "reload" "event!")
                                    (list {:event :build/start :out out :sources (count paths)}))
                (try
                  (let [; The project value is captured BEFORE the driver runs, and that is not
                        ; a style choice: a build RECOMPILES namespaces, `bl.cli`
                        ; among them, so the atom `project-value` reads can be a
                        ; fresh empty one by the time the build returns (measured
                        ; on a full build: the post-build read answered "the project
                        ; declares no :app" for a tree that plainly declares one).
                        proj (project-value)
                        run (BeamLisp.Env/fetch! "build" "run")
                        r (run {:sources paths :out out :force? (:force st)
                                :jobs (or (:jobs st) (:jobs declared))
                                :native (or (:native st) (some? (:native declared)))
                                ; `:ex` is the ELIXIR SUBSTRATE stage — the
                                ; project's own `.ex`, compiled into the same
                                ; output by the same run. It comes from the
                                ; declaration like the rest: a tree that says
                                ; `:ex {:root "lib" :exclude ["dev" "mix"]}`
                                ; gets its substrate compiled, and a tree that
                                ; says nothing gets no stage. (Measured: this
                                ; was declared in env.bl and read by nobody, so
                                ; every `bl build` left lib/*.ex to Mix.)
                                :ex (:ex declared)
                                :log println})]
                    (u/each u/io-err (:errors r))
                    (when (= 0 (:built r)) (println "beam-lisp AOT: up to date"))
                    ; THE TREE'S OWN APP RESOURCE. `beam_lisp.app` is what
                    ; `Application.ensure_all_started(:beam_lisp)` reads, and
                    ; until now nothing but Mix could write it: a build that
                    ; produced 109 modules and no `.app` is a build whose output
                    ; cannot be started. Derived from the project value (env.bl
                    ; `:app`), written through the same writer a package's `.app`
                    ; goes through (`app-resource`), and REPORTED when the
                    ; declaration is unusable rather than quietly skipped.
                    (let [w (do (BeamLisp.Loader/ensure_loaded "app-resource")
                                (BeamLisp.RT/invoke
                                  (BeamLisp.Env/fetch! "app-resource" "write-project!")
                                  (list proj out)))]
                      (if (:ok? w)
                        (println (str "  app       " (Path/basename (:path w))))
                        (u/io-err (str "bl build: no app resource — " (:why w)))))
                    (BeamLisp.RT/invoke (BeamLisp.Env/fetch! "reload" "event!")
                                        (list {:event :build/done :out out :built (:built r)
                                               :errors (count (:errors r))
                                               :native (:built (:native r))}))
                    (if (empty? (:errors r)) 0 1))
                  (finally
                    (BeamLisp.RT/invoke (BeamLisp.Env/fetch! "claim" "release!") (list out))))))))))))

(defn doc-usage []
  (println "bl doc — livebooks: documents that ARE programs (.bl.md / .bl.org)")
  (println "")
  (println "usage:")
  (println "  bl doc run FILE... [--check]       run cells, write result spans into the file")
  (println "                                     --check: write nothing; fail when stored results are stale")
  (println "  bl doc build TARGET... [--out DIR] render documents to static HTML (default: site)")
  (println "")
  (println "a document's cells evaluate in document order; exit 1 on any error"))

(defn doc-run-files
  "Run every file's cells and write its result spans. With `check?` the files
   are left as they are and a document whose stored results differ from a
   fresh run counts as failed. Returns the number of failed files."
  [paths check?]
  (loop [ps paths, fail 0]
    (if (empty? ps)
      fail
      (let [path (u/resolve (first ps))
            run! (BeamLisp.Env/fetch! "bl.doc" "run-and-write!")
            r (run! path {:check? check?})
            errors (get-in r [:errors])
            drift? (and check? (get-in r [:drift]))]
        (cond
          (get-in r [:error])
          (do (u/io-err (str "bl doc run: " path ": " (get-in r [:error])))
              (recur (rest ps) (inc fail)))

          drift?
          (do (u/io-err (str "bl doc run: " (u/rel-path path) " — stored results are stale; run `bl doc run` to refresh"))
              (recur (rest ps) (inc fail)))

          :else
          (do (println (str "bl doc run: " (u/rel-path path) " — " (get-in r [:cells]) " cells, "
                            (count errors) " cell errors"
                            (if check? " (checked, unchanged)" "")))
              (recur (rest ps) (if (empty? errors) fail (inc fail)))))))))

(defn doc-collect
  "One build target (file or dir) → its documents, via bl.doc.html."
  [target]
  ((BeamLisp.Env/fetch! "bl.doc.html" "collect-docs") (u/resolve target)))

(defn doc-build-files
  "Render every document. Returns the number of failed documents."
  [docs st]
  (let [out (u/resolve (or (:out st) "site"))]
    (loop [ds docs, built 0, fail 0]
      (if (empty? ds)
        (do (println (str "bl doc build: " (u/plural built "page") " → " (u/rel-path out)))
            fail)
        (let [path (first ds)
              r ((BeamLisp.Env/fetch! "bl.doc.html" "build-file") path out)]
          (if (get-in r [:error])
            (do (u/io-err (str "bl doc build: " path ": " (get-in r [:error])))
                (recur (rest ds) built (inc fail)))
            (do (println (str "bl doc build: " (u/rel-path (get-in r [:source])) " → " (u/rel-path (get-in r [:path]))
                             " (" (get-in r [:cells]) " cells)"))
                (if (empty? (get-in r [:errors]))
                  (recur (rest ds) (inc built) fail)
                  (do (u/io-err (str "bl doc build: " path " cell errors: "
                                   (join ", " (get-in r [:errors]))))
                      (recur (rest ds) (inc built) (inc fail)))))))))))

(defn cmd-doc [args st]
  (if (empty? args)
    (do (doc-usage) 2)
    (do (BeamLisp.Loader/ensure_loaded "bl.doc")
        (BeamLisp.Loader/ensure_loaded "bl.doc.html")
        (let [sub (first args)
              rest (rest args)]
          (cond
            (= sub "run")
            (if (empty? rest)
              (u/usage-error "usage: bl doc run FILE...")
              (let [fail (doc-run-files rest (:check st))] (if (= fail 0) 0 1)))

            (= sub "build")
            (if (empty? rest)
              (u/usage-error "usage: bl doc build TARGET... [--out DIR]")
              (let [docs (loop [ts rest, acc []]
                           (if (empty? ts)
                             acc
                             (recur (rest ts)
                                    (into acc (doc-collect (first ts))))))]
                (if (empty? docs)
                  (u/usage-error "bl doc build: no .bl.md / .bl.org documents found")
                  (let [fail (doc-build-files docs st)] (if (= fail 0) 0 1)))))

            (= sub "help")
            (do (doc-usage) 0)

            :else
            (do (u/io-err (str "bl doc: unknown subcommand \"" sub "\""))
                (doc-usage)
                2))))))

(defn cmd-lsp
  "`bl lsp check FILE` renders the language server's analysis of a file: the
  diagnostics an editor would show, then every definition with the facts the
  compiler PROVED about it. `bl lsp serve` runs the stdio language server.
  `check` exits 1 if the file has diagnostics, 0 if clean."
  [args st]
  (u/register-paths st)
  (let [sub (if (empty? args) "check" (first args))
        rest-args (if (empty? args) args (rest args))]
    (cond
      (= sub "check")
      (if (empty? rest-args)
        (u/usage-error "usage: bl lsp check FILE.bl")
        (let [path (u/resolve (first rest-args))
              src (File/read! path)
              ns (u/ns-of src)]
          (BeamLisp.Loader/ensure_loaded "lsp")
          (if (:json st)
            ;; the same data the text report renders, as one JSON object
            (let [diags ((BeamLisp.Env/fetch! "lsp" "diagnostics") src ns)]
              (u/emit st {:diagnostics diags
                          :symbols ((BeamLisp.Env/fetch! "lsp" "document-symbols") src)}
                      nil)
              (if (= 0 (count diags)) 0 1))
            (do
              (BeamLisp.Loader/ensure_loaded "lsp.cli")
              (let [report (BeamLisp.Env/fetch! "lsp.cli" "report")
                    n (report src ns)]
                (if (= 0 n) 0 1))))))

      (= sub "serve")
      (do (BeamLisp.Loader/ensure_loaded "lsp.server")
          ((BeamLisp.Env/fetch! "lsp.server" "run") rest-args st))

      (= sub "help")
      (do (println "bl lsp check FILE   analyze a file: diagnostics + proven summary per definition")
          (println "bl lsp serve        speak LSP on stdin/stdout")
          0)
      :else
      (do (u/io-err (str "bl lsp: unknown subcommand \"" sub "\" (check|serve)")) 2))))

(defn cmd-version [_args _st]
  (println (str "beam-lisp " (u/version)))
  0)

(defn cmd-daemon
  "`bl daemon start|stop|status` — the warm-VM lifecycle. `start` becomes the
  daemon (blocks; the native launcher runs it detached). `stop`/`status` are
  ordinary protocol clients against the tree's socket. One daemon per checkout,
  keyed by the tree root; it owns _build + the AOT image so concurrent runs
  never contend on a cross-VM lock."
  [args _st]
  (let [sub (if (empty? args) "status" (first args))]
    (cond
      (= sub "start")  (do (vm.client/start-foreground nil) 0)
      (= sub "stop")   (vm.client/stop nil)
      (= sub "status") (vm.client/status nil)
      :else (do (u/io-err (str "bl daemon: unknown subcommand \"" sub "\" (start|stop|status)")) 2))))

(defn cmd-help [args _st]
  (if (empty? args)
    (do (usage) 0)
    (if-let [line (get-in command-help [(first args)])]
      (do (println line) 0)
      (u/usage-error (str "bl help: unknown command \"" (first args) "\"")))))

(defn lazy
  "A verb loaded on first use: ensure its namespace is loaded, then call its
   exported `run`. A verb that lives in its own namespace costs nothing until
   the user asks for it."
  [ns]
  (fn [args st]
    (BeamLisp.Loader/ensure_loaded ns)
    ((BeamLisp.Env/fetch! ns "run") args st)))

(defn cmd-tasks
  "`bl tasks` — the tasks this tree declares, one line each. The listing is the
   same value dispatch reads, so what is listed is exactly what can be run."
  [_args _st]
  (let [p  (project-value)
        ts (:tasks p)]
    (if (empty? (keys ts))
      (println "bl tasks: this tree declares none — add a :tasks map to env.bl")
      (u/each
        (fn [n]
          (let [t (get ts n)]
            (println (str "  " n
                          (if (empty? (str (or (:doc t) "")))
                            ""
                            (str "  — " (:doc t)))
                          (if (:watch t) "  [watch]" "")
                          "\n      " (:run t)))))
        (sort-by identity (keys ts))))
    0))

(defn lazy-call
  "A verb loaded on first use whose entry point is not `run`."
  [ns entry]
  (fn [args st]
    (BeamLisp.Loader/ensure_loaded ns)
    ((BeamLisp.Env/fetch! ns entry) args st)))

(def commands
  {"run" cmd-run
   "eval" cmd-eval
   "repl" (lazy "bl.repl")
   "test"     (lazy "bl.test")
   "build" cmd-build
   "self-build" cmd-self-build
   "deps" cmd-deps
   "seed" cmd-seed
   "watch"    (lazy "bl.watch")
   "version" cmd-version
   "doc"     cmd-doc
   "tasks" cmd-tasks
   "daemon"  cmd-daemon
   "lsp"     cmd-lsp
   "help" cmd-help
   "check"    (lazy "bl.check")
   "lint"     (lazy "bl.lint")
   "fix"      (lazy "bl.fix")
   "ask"      (lazy "bl.ask")
   "search"   (lazy "bl.search")
   "oracle"   (lazy "bl.oracle")
   "cache"    (lazy "bl.cache")
   "doctor"   (lazy "bl.doctor")
   "serve"    (lazy "bl.serve")
   "monitor"  (lazy "bl.monitor")
   "examples" (lazy "bl.examples")
   "mcp"      (lazy "bl.mcp")
   "override" (lazy "bl.override")
   "install"  (lazy "bl.install")
   "ports"    (lazy "bl.ports")
   "ui"       (lazy-call "bl.ports" "run-ui")
   "open"     (lazy-call "bl.ports" "run-open")
   "gateway"  (lazy "bl.gateway")})

;; ── entry ─────────────────────────────────────────────────────────────

;; ── the project (env.bl) ──────────────────────────────────────────────
;;
;; Every command — standalone, or through the daemon — reads the tree's
;; `env.bl` before dispatch and binds what it declares: its library roots onto
;; the loader's search path, its `:env` into the process environment. The value
;; is kept in `project` so dispatch can read its tasks without reading the file
;; a second time.
;;
;; Shape problems go to stderr as they are found. A broken project file
;; degrades a command — no tasks, no declared ports — and never stops one,
;; because the tree is still a tree without its configuration.

(def project (atom nil))

(defn with-project
  "Bind the tree's env.bl for this command. Returns the project value.
   A tree's overrides/ directory — vendored or patched copies of shipped
   namespaces (see bl.override) — is a library root by CONVENTION: no env.bl
   entry, no flag, the same doctrine that makes the compiler's own .bl
   available by default."
  []
  (let [p (without-shadowed-tasks (env/project (BeamLisp/cwd)))]
    (u/each (fn [d] (BeamLisp.Env/add_search_path d)) (:paths p))
    (let [ovr (u/resolve "overrides")]
      (when (File/dir? ovr) (BeamLisp.Env/add_search_path ovr)))
    (u/each (fn [k] (System/put_env k (get (:env p) k))) (keys (:env p)))
    (u/each (fn [e] (u/io-err (str "bl: " (:path p) ": " e))) (:errors p))
    (reset! project p)
    p))

(defn project-value
  "The project value `with-project` bound, or nil before any command bound
   one."
  []
  @project)

;; ── tasks ─────────────────────────────────────────────────────────────
;;
;; A project's `env.bl` may declare tasks: `bl dev`, `bl seed`. Dispatch is a
;; FALLTHROUGH — builtin commands first, then the project's tasks. The order is
;; the safety property: `bl test` keeps meaning `bl test`, whatever a file
;; declares.
;;
;; A task that DOES shadow a builtin is dropped and reported rather than
;; silently losing to the builtin. A declaration that can never run is a bug in
;; the project file, and the only place it is visible is where it was written.

(defn- shadowing? [name] (not (nil? (get-in commands [name]))))

(defn- without-shadowed-tasks
  "The project with shadowing tasks removed and each removal reported."
  [p]
  (if (nil? p)
    p
    (let [bad (filter shadowing? (keys (:tasks p)))]
      (if (empty? bad)
        p
        (assoc p
               :tasks (reduce (fn [ts n] (dissoc ts n)) (:tasks p) bad)
               :errors (concat (:errors p)
                               (map (fn [n] (str "task \"" n
                                                 "\" shadows a bl command; rename it"))
                                    bad)))))))

(defn- run-program
  "Run a task's file the way `bl run FILE` runs one: the command's post-`--`
   args are the program's argv, and the value of its last form prints. A task
   is a saved invocation, not a second execution model."
  [file argv]
  (BeamLisp/with_argv (u/to-list (or argv []))
    (fn [] (println (BeamLisp.RT/print_str (BeamLisp/run_file (u/resolve file)))))))

(defn- watch-task
  "A task declared `:watch true` runs, then keeps running: every committed save
   under its file's directory re-runs it against the new image. It owns its
   process (like `bl watch`), which is why the daemon refuses it instead of
   parking its single worker on a session with no end."
  [name task argv]
  (let [dir (Path/dirname (:run task))]
    (BeamLisp.Loader/ensure_loaded "reload")
    (Process/flag :trap_exit true)
    (println (str "bl " name ": running, then watching " dir " — Ctrl+C to stop"))
    (run-program (:run task) argv)
    (let [[tag detail]
          (BeamLisp.ReloadWatcher/start_link
            (u/kw [:dirs (u/to-list [dir])]
                  [:auto_commit true]
                  [:on_result (fn [status]
                                (when (:ok? status)
                                  (println (str "bl " name ": re-running"))
                                  (run-program (:run task) argv)))]))]
      (if (= :ok tag)
        (do (Process/sleep :infinity) 0)
        (do (u/io-err (str "bl " name ": cannot start the watcher: " (pr-str detail)))
            1)))))

(defn run-task
  "Run the task `name` declared by the project. Returns an exit code. The
   command's own arguments become the program's argv (post-`--` ones included),
   so `bl seed --dry` and `bl seed` are one mechanism with different arguments."
  [name task st]
  (u/each (fn [d] (BeamLisp.Env/add_search_path d)) (:paths task))
  (let [argv (concat (or (:args st) []) (or (:dd st) []))]
    (if (not (File/regular? (:run task)))
      (do (u/io-err (str "bl " name ": no such file: " (:run task)))
          1)
      (if (:watch task)
        (watch-task name task argv)
        (do (run-program (:run task) argv) 0)))))

(defn dispatch [st]
  (let [cmd (:cmd st)]
    (if (= cmd "ward")
      ;; ward is not a second runner any more; it is what `bl test` DOES. The
      ;; one-line pointer is cheaper than making a user guess, and it is the
      ;; whole migration note.
      (do (u/io-err "bl: ward is now `bl test` — every file in its own isolated fork is the default (--shared opts out)")
          2)
      (dispatch-command cmd st))))

(defn dispatch-command [cmd st]
  (let []
    (if-let [f (get-in commands [cmd])]
      (f (:args st) st)
      (let [task (get-in (project-value) [:tasks cmd])]
        (if (nil? task)
          (do (u/io-err (str "bl: unknown command \"" cmd "\""))
              (usage)
              2)
          (run-task cmd task st))))))

(defn run-argv
  "Parse argv and run the command, returning an EXIT CODE — never halting. The
  re-entrant seam: `main` boots then calls this then halts; the daemon calls it
  per request inside a bound env (cwd/argv/ambient-dirs already set by the
  executor). All filesystem arguments resolve against `BeamLisp/cwd`, so a
  daemon request finds the client's files, a standalone run finds its own."
  [argv]
  (try
    ;; The library store's code path comes first, before parse and dispatch.
    ;; Every command may call a library module — `Jason` sits behind every
    ;; `--json`, and behind `bl install mcp`'s `.mcp.json` write — and a command
    ;; that reached one before the store's directories were on the path died
    ;; with `module Jason is not available`. Registering here, once and
    ;; unconditionally, is what makes "this command remembered to register paths
    ;; and that one did not" unrepresentable.
    (u/register-store-paths!)
    (let [st (parse-argv argv)]
      (cond
        (:error st)   (do (u/io-err (str "bl: " (:error st))) 2)
        (:unknown st) (do (u/io-err (str "bl: unknown flag " (:unknown st))) 2)
        (:help st)    (do (usage) 0)
        (:version st) (cmd-version nil st)
        ;; `bl` alone is a repl, like `python` alone. Both the repl and a
        ;; command run with the tree's project bound: the same env.bl a daemon
        ;; request reads, since warmth is an optimization and never a
        ;; difference in meaning.
        (nil? (:cmd st)) (do (with-project) ((get-in commands ["repl"]) nil st))
        :else (do (with-project) (dispatch st))))
    (catch e
      (if (closed-output? e)
        ;; stdout went away (`bl watch DIR | head`, `bl ask … | grep -q`): a
        ;; real unix tool dies on SIGPIPE, and a caller that closed the pipe is
        ;; not interested in the rest. Report nothing — the alternative is a
        ;; stack of alarms about the pipe the CALLER closed — and answer 141,
        ;; the shell's 128+13.
        141
        (do (u/io-err (str "error: " (ex-message e)))
            1)))))

(defn- closed-output?
  "Whether `e` is the pipe-closed failure the BEAM raises when the reader on the
   other end of stdout has gone — SIGPIPE's Erlang shape, `:terminated` or
   `:epipe`. The message is read defensively: a raise that carries no message
   must not turn this question into a second raise."
  [e]
  (let [m (try (ex-message e) (catch _ nil))]
    (if (not (string? m))
      false
      (or (includes? m "terminated") (includes? m "epipe")))))

(defn main [argv]
  ;; The escript enters here as a plain BEAM apply: same-module calls in
  ;; the body are direct remote calls and need no registry, so the boot
  ;; runs before any var-level use. AOT.boot/0 starts Env + Loader.Server
  ;; on demand and seeds core — the substrate work a command process needs;
  ;; ensure_loaded then runs THIS module's __bl_init__ (value defs like
  ;; `commands`, fn values, links) — the documented ordering: init first,
  ;; __bl_init__ second.
  (BeamLisp.AOT/boot)
  ;; AOT fast path first (escripts: always hits). A STRIPPED release reports
  ;; :no_module — the drift gate rightly refuses re-stamped beams — and the
  ;; designed pairing is the loader's source path (priv/bl/cli.bl ships in
  ;; the release), which reinterns the vars and marks the namespace loaded.
  (if (= :no_module (BeamLisp.AOT/ensure_loaded "bl.cli"))
    (BeamLisp.Loader/ensure_loaded "bl.cli"))
  (let [code (run-argv argv)]
    ;; An escript ignores main/1's return value — the exit code is a halt.
    (System/halt code)))
