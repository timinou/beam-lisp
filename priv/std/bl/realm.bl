; realm.bl — `bl realm`: the project in front of you, alive.
;
; A realm is a project (an `env.bl`) running inside a VM. It is what a developer
; means by "my daemon": the address, the routes, the index, the tasks. `bl vm`
; is the machine's view; this is the project's, scoped by the current directory.
;
;   bl realm [show] [--json]   this project's realm: VM, routes, address
;   bl realm open [NAME]       the address of a route (default: ui); --open launches it
;   bl realm stop              drain this project's realm
;
; TODAY one VM serves one realm (the VM is started for a root), so `stop` ends the
; VM. When one VM hosts many realms (see docs/design/realm/), `stop` drains only
; this realm and the VM stays for the others — the verb does not change.

(ns bl.realm
  (:require [bl.util :as u] [bl.json] [bl.vm :as vm] [vm.inventory :as inv]
            [vm.paths :as paths] [vm.client :as client] [bl.ports :as ports]))

(defn- here
  "The realm for the current directory: {:vm row :realm realm}, or nil. The root is
   resolved the way the daemon resolves it, so this finds exactly the realm a
   command in this directory would run in."
  []
  (let [root (paths/resolve-root (BeamLisp/cwd))
        root (if (contains? root :ok) (:ok root) (BeamLisp/cwd))]
    (some (fn [row]
            (some (fn [rm] (when (= (:root rm) root) {:vm row :realm rm :root root}))
                  (:realms row)))
          (inv/rows {}))))

(defn- none-here []
  (u/io-err "bl realm: no realm is running for this directory")
  (u/io-err "  start one: bl daemon start")
  1)

(defn- cmd-show [st]
  (let [h (here)]
    (if (nil? h)
      (none-here)
      (let [rm (:realm h) row (:vm h)]
        (if (:json st)
          (println (bl.json/encode {:realm rm :vm (select-keys row [:id :build :pid :uptime-s :memory-kb])}))
          (do
            (println (str (:name rm) "   in " (:id row) "   up " (vm/human-age (:uptime-s row))))
            (println (str "  root     " (:root rm)))
            (println (str "  build    " (:build row)))
            (u/each (fn [rt] (println (str "  route    " (vm/route-line rt))))
                    (to-list (:routes rm)))))
        0))))

(defn- cmd-open [args st]
  (let [h (here)
        name (or (first args) "ui")]
    (if (nil? h)
      (none-here)
      (let [rt (first (filter (fn [r] (= (:name r) name)) (:routes (:realm h))))]
        (if (nil? rt)
          (do (u/io-err (str "bl realm: no route named \"" name "\" — "
                             (join ", " (map (fn [r] (:name r)) (:routes (:realm h))))))
              1)
          (do (println (:url rt))
              (when (not= (:url rt) (:loopback rt)) (println (str "  → " (:loopback rt))))
              (when (some (fn [a] (= a "--open")) (u/to-list args))
                (ports/open-external (:url rt)))
              0))))))

(defn- cmd-stop []
  (let [h (here)]
    (if (nil? h)
      (none-here)
      (let [r (inv/stop! (:vm h) {})]
        (if (contains? r :ok)
          (do (println (str "bl realm: " (:name (:realm h)) " stopped")) 0)
          (do (u/io-err (str "bl realm: " (pr-str (:error r)))) 1))))))

(defn run
  "`bl realm [show|open|stop]`."
  [args st]
  (let [args (u/to-list args)
        sub (or (first args) "show")]
    (cond
      (= sub "show") (cmd-show st)
      (= sub "open") (cmd-open (rest args) st)
      (= sub "stop") (cmd-stop)
      :else (u/usage-error "usage: bl realm [show | open [NAME] [--open] | stop]"))))
