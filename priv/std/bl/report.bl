; bl/report.bl — how a FAILURE reaches a human on the CLI.
;
; ONE place, so every verb gets the same quality of failure. When a command dies
; on a source it could not read, this turns the diagnostic into:
;
;   priv/lib/web.bl:479:12: unterminated collection, expected ) — the ( opened
;     here is never closed
;     479 │ (defn render [x] (str y
;         │                          ^
;     the repair:
;       insert-closer-at-line-end — add ) at the end of line 479 — there is more
;         source after it, so the closer probably belongs there (clears the file)
;
; — the caret from errors.bl, the options from repair.bl, and nothing here about
; which command asked. `run`, `lint`, `fix`, `build`, `test` and `reload` all
; funnel their failures through the CLI's single catch in `run-argv`, so all of
; them inherit this, and a new verb gets it without knowing this file exists.
;
; The diagnosis and its repairs come from the SAME reader: `:read` below is the
; front door the command itself went through, so a repair is only offered when
; the text it produces reads under the reader that rejected the original.

(ns bl.report
  (:require [bl.util :as u] [diag] [repair] [errors]))

(defn diagnostic
  "The reader diagnostic a failure carries, or nil. A raised value arrives
   WRAPPED (the runtime's error wrapper holds it in :original); a value that is
   already the diagnostic passes through."
  [e]
  (let [d (if (diag/diag? e) e (:original e))]
    (if (diag/diag? d) d nil)))

(defn reads?
  "Whether `src` reads through the host front door. The forward check a CLI can
   offer without knowing how the command did its reading — and the same one
   `verifier` gives `repair`."
  [src file]
  (try
    (do (BeamLisp.Reader/read_string src file) true)
    (catch _ false)))

(defn verifier
  "`repair`'s :read — the failure, or nil. Only the QUESTION matters here (does
   this text read?), so a reader that answers with a bare message is enough:
   repair asks the same question of every candidate it offers."
  [src file]
  (if (reads? src file)
    nil
    {:error {:diag true :severity :error :kind :unreadable
             :msg "does not read"}}))

(defn opts
  "The options every repair call in this file uses: the file the diagnostic
   names, and the verifier above."
  [file]
  {:file file :read verifier})

(defn source-of
  "The text of the file a diagnostic names, or nil when there is none to read —
   a failure in a REPL snippet, a deleted file, an unreadable path. Those simply
   have no source to show, and the caller falls back to its own message."
  [d]
  (let [f (:file d)]
    (if (string? f)
      (try (File/read! f) (catch _ nil))
      nil)))

(defn report
  "The report for a failure, as a string — nil when the failure is not a reader
   diagnostic about a readable file, in which case the caller prints its own
   message.

   It NEVER raises: a reporting failure must not mask the failure it reports,
   which is why the whole body is guarded and the file read is guarded again."
  [e]
  (try
    (let [d (diagnostic e)
          src (if (nil? d) nil (source-of d))]
      (if (or (nil? d) (nil? src))
        nil
        (repair/explain src (opts (:file d)))))
    (catch _ nil)))

(defn show
  "Print the report for `e` to stderr, and answer whether anything was printed.
   The ONE hook a verb needs: false means \"I have nothing better to say\", and
   the caller prints its own message."
  [e]
  (let [r (report e)]
    (if (nil? r)
      false
      (do (u/io-err r) true))))
