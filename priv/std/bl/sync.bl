; bl/sync.bl — `bl sync status --store PATH`: what a sync store says about its
; own background work, read without the app that wrote it.
;
; For a copied production store, a dev store after the app stopped, or — best
; effort — a live one: fjall does not lock a store against a second OS process
; (measured 2026-09-28), so this READS what the running app has flushed. It never
; writes. On a live system the app's own console is the consistent view.

(ns bl.sync
  (:require [datom] [datom.store-fjall] [connector.console :as console] [bl.util :as u]))

(defn run
  "`bl sync status --store PATH`"
  [args st]
  ;; `--store` comes from the SHARED argv table (bl.cli/parse-argv): a verb
  ;; that parsed its own flags would be rejected before it ran
  (let [sub (first (to-list args))
        path (:store st)]
    (cond
      (not= sub "status") (do (u/io-err "usage: bl sync status --store PATH/sync.fjall") 2)
      (nil? path) (do (u/io-err "bl sync status: --store PATH is required") 2)
      (not (File/exists? path)) (do (u/io-err (str "bl sync status: no store at " path)) 2)
      :else
        (let [opened (try {:ok (datom.store-fjall/open path)} (catch e {:error (str e)}))]
          (if (contains? opened :error)
            (do (u/io-err (str "bl sync status: cannot open " path " (" (:error opened) ")"))
                3)
            (let [c (datom/connect-with (:ok opened) [])]
              (println (console/render-summary (console/store-summary (datom/db c))))
              (datom/close! c)
              0))))))
