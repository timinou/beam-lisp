; bl/doc/spans.bl — the ONE partition of a livebook's lines.
;
; Portable Beam Lisp: core functions only, no host calls, so the same source
; compiles for the BEAM (bl.doc, the loader's twin, the HTML renderer) and for
; JavaScript (bl-ed, through the sync profile). Every reader of a .bl.org /
; .bl.md file asks this namespace where its spans are; nobody re-derives them.
;
;   (spans lines fmt opts) → [span …]   in order, contiguous, TOTAL: every row
;                                       belongs to exactly one span.
;
;   span = {:kind :prose|:cell|:result|:prose-code|:block|:heading|:dynamic
;           :from row :to row            ; [from, to) over `lines`
;           …kind keys}
;
;   :cell        a beam-lisp source block. :code-from/:code-to are its code
;                rows; :explicit-id :frozen? :silent? come from its header.
;   :prose-code  any other source block / fence (:lang).
;   :block       an org `#+begin_X` block that is not source (:lang = X).
;                bl.doc reads it as prose; an editor shows it as a block.
;   :result      `#+RESULTS: id` / ```bl-result id — the only span a tool
;                writes (:id).
;   :heading     an org heading row — only with {:headings? true}, so an
;                outline and the partition agree. Otherwise headings are prose.
;
; The partition NEVER fails. A block still being typed (no closer yet) runs
; to the end of the text and carries :open? true; a strict reader (bl.doc)
; turns that into its error, an editor keeps going.
;
; Case: org keywords are case-insensitive (`#+BEGIN_SRC` is a block). A
; beam-lisp CELL additionally needs the lowercase `#+begin_src` the loader's
; minimal extractor (BeamLisp.Loader/doc_source) matches, so the program the
; loader loads and the cells this partition finds are the same set.

(ns bl.doc.spans)

; ─── lines ──────────────────────────────────────────────────────────────────

(defn- tokens
  "The non-blank space-separated tokens of a line, as a vector."
  [s]
  (vec (filter (fn [t] (not (blank? t))) (split (trim s) " "))))

(defn- lc-trim [l] (lower-case (trim l)))

(defn- find-row
  "First row ≥ from whose line satisfies pred, else nil."
  [lines from pred]
  (loop [r from]
    (cond
      (>= r (count lines)) nil
      (pred (nth lines r)) r
      :else (recur (inc r)))))

; ─── org headings ───────────────────────────────────────────────────────────

(defn heading-level
  "The heading level of a line (`*** x` → 3), or nil. Org requires a space
   after the stars; `*bold*` text is not a heading."
  [l]
  (loop [i 0]
    (cond
      (and (< i (count l)) (= "*" (subs l i (inc i)))) (recur (inc i))
      (and (> i 0) (< i (count l)) (= " " (subs l i (inc i)))) i
      :else nil)))

(def ^:private todo-words
  #{"TODO" "DONE" "ITEM" "DOING" "BLOCKED" "CANCELLED" "REVIEW" "NEXT" "WAIT"})

(defn parse-heading
  "{:level :todo :title :tags} of a heading line."
  [l]
  (let [lvl (heading-level l)
        body (trim (subs l (inc lvl)))
        words (split body " ")
        todo (if (contains? todo-words (first words)) (first words) nil)
        body (if (some? todo) (trim (subs body (count todo))) body)
        tag-start (if (and (ends-with? body ":") (some? (index-of body " :")))
                    (last-index-of body " :") nil)
        tags (if (some? tag-start)
               (vec (filter (fn [s] (not (blank? s))) (split (subs body (+ tag-start 2)) ":")))
               [])
        title (if (some? tag-start) (trim (subs body 0 tag-start)) body)]
    {:level lvl :todo (if (some? todo) (keyword (lower-case todo)) nil) :title title :tags tags}))

(defn outline
  "The heading spans of a partition, each with :row and :end = the row its
   section ends at (the next heading at the same or a shallower level, else
   `n`, the line count)."
  [spans n]
  (let [hs (vec (filter (fn [s] (= :heading (:kind s))) spans))]
    (vec (map-indexed
           (fn [i h]
             (let [nxt (some (fn [j] (let [g (nth hs j)] (if (<= (:level g) (:level h)) (:from g) nil)))
                             (range (inc i) (count hs)))]
               (assoc h :row (:from h) :end (or nxt n))))
           hs))))

; ─── org ────────────────────────────────────────────────────────────────────

(defn- src-attrs
  "A src header's `:id name :frozen :silent` tokens (anything else is kept in
   the file and ignored here — the format grows without a migration)."
  [toks]
  (loop [i 0 m {:explicit-id nil :frozen? false :silent? false}]
    (if (>= i (count toks))
      m
      (let [a (nth toks i)]
        (cond
          (= a ":id") (if (< (inc i) (count toks))
                        (recur (+ i 2) (assoc m :explicit-id (nth toks (inc i))))
                        m)
          (= a ":frozen") (recur (inc i) (assoc m :frozen? true))
          (= a ":silent") (recur (inc i) (assoc m :silent? true))
          :else (recur (inc i) m))))))

(defn results-id
  "The id of a `#+RESULTS: id` / `#+RESULTS[id]` line, or nil. A bare
   `#+RESULTS:` names nothing and stays prose."
  [l]
  (let [t (trim l)]
    (cond
      (starts-with? t "#+RESULTS:") (let [r (trim (subs t 10))] (if (blank? r) nil r))
      (starts-with? t "#+RESULTS[") (let [e (index-of t "]")] (if (nil? e) nil (subs t 10 e)))
      :else nil)))

(defn- results-stop?
  "The lines that end a results body. bl.doc's writer ends every block with a
   blank line, so the blank rule alone round-trips; the others keep a
   hand-written file from swallowing the next section."
  [l]
  (let [t (trim l) lt (lower-case t)]
    (or (blank? t) (starts-with? t "*")
        (starts-with? lt "#+begin_") (starts-with? lt "#+end_")
        (starts-with? lt "#+begin:") (= lt "#+end:")
        (starts-with? t "#+RESULTS"))))

(defn- closed
  "The common range keys of a block opened at row r whose closer is row `end`
   (nil = still open: it runs to the end of the text)."
  [r end n]
  {:from r :to (if (nil? end) n (inc end)) :open? (nil? end)
   :code-from (inc r) :code-to (if (nil? end) n end)})

(defn- org-span-at
  "The span that starts at row r of an org document."
  [lines r opts]
  (let [l (nth lines r) lt (lc-trim l) n (count lines)]
    (cond
      (and (:headings? opts) (some? (heading-level l)))
      (merge {:kind :heading :from r :to (inc r)} (parse-heading l))

      (starts-with? lt "#+begin:")
      (let [header (trim (subs (trim l) 8))
            name (first (tokens header))]
        (assoc (closed r (find-row lines (inc r) (fn [x] (= (lc-trim x) "#+end:"))) n)
               :kind :dynamic :name name
               :header (if (nil? name) "" (trim (subs header (count name))))))

      (starts-with? lt "#+begin_src")
      (let [toks (tokens l)
            lang (if (> (count toks) 1) (nth toks 1) "")
            base (assoc (closed r (find-row lines (inc r) (fn [x] (starts-with? (lc-trim x) "#+end_src"))) n)
                        :lang lang)]
        (if (and (= lang "beam-lisp") (starts-with? (trim l) "#+begin_src"))
          (merge base {:kind :cell} (src-attrs (subvec toks (min 2 (count toks)))))
          (assoc base :kind :prose-code)))

      (starts-with? lt "#+begin_")
      (assoc (closed r (find-row lines (inc r) (fn [x] (starts-with? (lc-trim x) "#+end_"))) n)
             :kind :block :lang (first (split (subs lt 8) " ")))

      (some? (results-id l))
      (let [stop (find-row lines (inc r) results-stop?)]
        {:kind :result :id (results-id l) :from r
         ; a blank terminator BELONGS to the span, so parse→write→parse is a
         ; fixpoint; any other stop (heading, next block, end) stays outside
         :to (cond (nil? stop) n (blank? (nth lines stop)) (inc stop) :else stop)})

      :else nil)))

; ─── markdown ───────────────────────────────────────────────────────────────

(defn- md-attrs
  "A fence's `id=gross frozen silent` tokens."
  [toks]
  (reduce (fn [m t]
            (cond
              (starts-with? t "id=") (assoc m :explicit-id (subs t 3))
              (= t "frozen") (assoc m :frozen? true)
              (= t "silent") (assoc m :silent? true)
              :else m))
          {:explicit-id nil :frozen? false :silent? false}
          toks))

(defn- md-span-at
  "The span that starts at row r of a markdown document: ANY fence opens a
   block, because a plain ``` block is prose whose body must never be read as
   new fences."
  [lines r]
  (let [l (nth lines r) t (trim l)]
    (when (starts-with? t "```")
      (let [toks (tokens t)
            lang (subs (first toks) 3)
            base (closed r (find-row lines (inc r) (fn [x] (= "```" (trim x)))) (count lines))
            more (subvec toks 1)]
        (cond
          (= lang "beam-lisp") (merge base {:kind :cell :lang lang} (md-attrs more))
          (= lang "bl-result") (assoc base :kind :result :id (if (empty? more) "" (first more)))
          :else (assoc base :kind :prose-code :lang lang))))))

; ─── the partition ──────────────────────────────────────────────────────────

(defn spans
  "The span partition of `lines` (a vector of strings) in format `fmt`
   (:org | :md). opts: {:headings? bool} — org heading rows as their own
   spans. Total and ordered; see the namespace comment."
  ([lines fmt] (spans lines fmt {}))
  ([lines fmt opts]
   (let [lines (vec lines) n (count lines)
         push-prose (fn [out from to] (if (< from to) (conj out {:kind :prose :from from :to to}) out))]
     (loop [r 0 prose-from 0 out []]
       (if (>= r n)
         (push-prose out prose-from n)
         (let [sp (if (= fmt :md) (md-span-at lines r) (org-span-at lines r opts))]
           (if (nil? sp)
             (recur (inc r) prose-from out)
             (recur (:to sp) (:to sp) (conj (push-prose out prose-from r) sp)))))))))

; ─── cell ids ───────────────────────────────────────────────────────────────

(def ^:private def-heads
  #{"(defn" "(def" "(defmacro" "(defn-" "(defmulti" "(defprotocol"})

(defn- bare-symbol
  "A token without one trailing `)`: `(def x)` names \"x\", not \"x)\"."
  [t]
  (if (ends-with? t ")") (subs t 0 (dec (count t))) t))

(defn- first-def-name
  "The name of the first definition in rows [from, to), or nil."
  [lines from to]
  (loop [r from]
    (if (>= r to)
      nil
      (let [toks (tokens (nth lines r))]
        (if (and (contains? def-heads (first toks)) (>= (count toks) 2))
          (bare-symbol (nth toks 1))
          (recur (inc r)))))))

(defn assign-ids
  "`spans` with every :cell given its :id, exactly once: the explicit id wins;
   else the cell's first definition name; else `cellN` (N = cells before it).
   A collision takes -2, -3, … in document order. Deterministic in content and
   order, so ids are stable across runs without being written into the file —
   and the editor and the runner always name a cell the same way."
  [lines spans]
  (loop [i 0 out [] used #{} n 0]
    (if (>= i (count spans))
      out
      (let [sp (nth spans i)]
        (if (not= :cell (:kind sp))
          (recur (inc i) (conj out sp) used n)
          (let [base (or (:explicit-id sp) (first-def-name lines (:from sp) (:to sp)) (str "cell" n))
                id (if (contains? used base)
                     (loop [k 2] (let [c (str base "-" k)] (if (contains? used c) (recur (inc k)) c)))
                     base)]
            (recur (inc i) (conj out (assoc sp :id id)) (conj used id) (inc n))))))))

; ─── results: the one span kind a tool writes ──────────────────────────────────────────

(defn result-lines
  "The lines a result is written as, per format. org: `#+RESULTS: id`, then
   each value line as `: line`, then a blank line; md: a ```bl-result fence."
  [fmt id value]
  (let [vls (split (str value) "\n")]
    (if (= :org fmt)
      (vec (concat [(str "#+RESULTS: " id)] (map (fn [l] (str ": " l)) vls) [""]))
      (vec (concat [(str "```bl-result " id)] vls ["```"])))))

(defn write-results
  "`lines` with {id → value-string} written into their result spans: an
   existing span for an id is rewritten IN PLACE, a missing one inserted
   directly after its cell. Only result spans change. bl.doc's runner and the
   editor (a cell evaluated in the page) write through this one function."
  [lines fmt results]
  (let [lines (vec lines)
        parts (assign-ids lines (spans lines fmt))
        have (set (keep (fn [s] (when (= :result (:kind s)) (:id s))) parts))]
    (vec (mapcat (fn [s]
                   (let [own (subvec lines (:from s) (:to s))]
                     (cond
                       (and (= :result (:kind s)) (contains? results (:id s)))
                         (result-lines fmt (:id s) (get results (:id s)))
                       (and (= :cell (:kind s)) (contains? results (:id s)) (not (contains? have (:id s))))
                         (concat own (if (= :org fmt) [] [""]) (result-lines fmt (:id s) (get results (:id s))))
                       :else own)))
                 parts))))

