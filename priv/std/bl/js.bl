; bl/js.bl — `bl js`: Beam Lisp to JavaScript, one verb.
;
;   bl js build NS [-p ROOT]... [--out DIR] [--host a,b]   ES modules for NS + its requires
;   bl js watch NS [-p ROOT]... [--out DIR] [--host a,b]   rebuild when a source changes
;   bl js test                                             the BEAM <-> JS differential
;
; The compiler is priv/lib/js (js.build / js.emit). This namespace only turns
; argv into a build and reports it; it holds no compiler logic, so the verb, the
; bl-ed build script and the tests all run the SAME build.
;
; Roots: every `-p ROOT` (repeatable), else the current directory. priv/std is
; always searched last, so a program can require the portable std namespaces
; (bl.doc.spans, …) without naming them.
;
; Host functions (`(js/now)` …) are named with `--host now,measure`: the build
; links them to the page's `globalThis.BL_HOST` and refuses any other js/ name.

(ns bl.js
  (:require [bl.util :as u]
            [js.build :as b]
            [js.emit :as e]))

(def ^:private runtime-dir
  ; the JS runtime (rt.mjs, abi.mjs, leaves.mjs …) lives beside js.build's source
  (Path/dirname (BeamLisp.Loader/source_path "js.build")))

(defn core-names
  "`core`'s names, from the LIVE BEAM registry — the authoritative source of
   the link table a build seeds. `Env/match` walks the whole env chain, so the
   seeded primitives and the clojure prelude are all seen; the compiled core has
   no `CORE` registry (a JS file) to parse."
  []
  (set (map first
            (BeamLisp.Env/match
              (erlang/list_to_tuple
                (list (erlang/list_to_tuple (list "core" :$1)) :_))))))

(defn leaf-names
  "The host leaves leaves.mjs exports in `NAMES` — asked of the module itself
   (node), because some leaves are registered by code (env.mjs's Env table),
   not written as literal keys. The JS file is the one source of the names."
  []
  (let [url (str "file://" (Path/expand (str runtime-dir "/leaves.mjs")))
        r (System/cmd "node" (u/to-list ["--input-type=module" "-e"
                                         (str "const L = await import(" (e/js-str url) "); console.log(L.NAMES.join('\\n'))")]))]
    (if (= 0 (erlang/element 2 r))
      (set (filter (fn [s] (not (blank? s))) (split (erlang/element 1 r) "\n")))
      (throw (ex-info (str "bl js: cannot read leaves.mjs: " (erlang/element 1 r)) {})))))

; core.bl/rt.bl/sugar.bl live in priv/boot, the sibling of priv/std (this file is
; priv/std/bl/js.bl): the SOURCE tree a build compiles, never a staged copy
(declare std-root)
(defn- boot-root [] (str (Path/dirname (std-root)) "/boot"))
(defn- compat-root [] (str (Path/dirname (std-root)) "/compat"))
(defn- lib-root [] (str (Path/dirname (std-root)) "/lib"))

(def ^:private base
  "What a build compiles as its base, in order: core imports the runtime
   and its seed boundary before evaluating core values, sugar's macros' runtime half, and the clojure
   prelude the BEAM interns into `core` (Loader's clojure-prelude-list:
   `vector`, `re-find`, `hash-set` … resolve bare, as on the BEAM).
   clojure.core-more is NOT in the base: it drags the whole Decimal library in
   (~30 more host leaves) for `bigdec`/`parse-double`/`random-uuid`; a page
   that names it gets it through module-name discovery."
  ["core" "rt" "sugar" "clojure.core-ext" "clojure.re" "js.binary"])

(defn- std-root [] (Path/dirname (Path/dirname (BeamLisp.Loader/source_path "bl.js"))))

(defn- roots-of [st]
  (let [ps (vec (reverse (u/to-list (or (:paths st) (list)))))]
    (conj (if (empty? ps) [(File/cwd!)] ps) (std-root))))

(defn- csv [s] (vec (filter (fn [x] (not (blank? x))) (split (or s "") ","))))

(defn- host-of [st]
  (set (filter (fn [s] (not (blank? s))) (split (or (:host st) "") ","))))

(defn- write-boot-cache!
  "Compile core.bl's and sugar.bl's definitions ONCE, now, with the built
   in-page compiler (node), and write out/boot-cache.mjs — so a page replays
   them instead of compiling macros at every start (boot.mjs). Without Node,
   source boot remains available unless explicit preloads require capture.
   A failed capture with Node available refuses the build."
  [out preloads]
  (let [boot-dir (Path/dirname (BeamLisp.Loader/source_path "core"))
        sources (mapv (fn [ns] (let [path (BeamLisp.Loader/source_path ns)]
                              [ns path (BeamLisp.Loader/read_source path)])) preloads)
        script (str "const out = " (e/js-str (str "file://" (Path/expand out) "/")) ";"
                    "const L = await import(out + 'leaves.mjs');"
                    "globalThis.BL_HOST = Object.assign(globalThis.BL_HOST || {}, { run: L.run });"
                    "const B = await import(out + 'boot.mjs');"
                    "const fs = await import('node:fs');"
                    "const text = await B.capture((f) => fs.readFileSync(f.startsWith('/') ? f : " (e/js-str (str boot-dir "/")) " + f.split('/').pop(), 'utf8'), " (str "[" (join "," (map (fn [[ns path source]] (str "[" (e/js-str ns) "," (e/js-str path) "," (e/js-str source) "]")) sources)) "]") ");"
                    "fs.writeFileSync(" (e/js-str (str (Path/expand out) "/boot-cache.mjs")) ", text);"
                    "console.log('boot-cache: ' + text.length + ' bytes');")
        script-path (str (Path/expand out) "/.boot-capture.mjs")
        _ (File/write! script-path script)
        r (try (System/cmd "node" (u/to-list [script-path]) (u/kw [:stderr_to_stdout true]))
               (catch e nil)
               (finally (File/rm! script-path)))]
    (when (and (seq preloads) (or (nil? r) (not= 0 (erlang/element 2 r))))
      (throw (ex-info "JS namespace preload failed" {:detail (when r (erlang/element 1 r))})))
    (when (and (some? r) (not= 0 (erlang/element 2 r)))
      (throw (ex-info "JS bootstrap capture failed" {:detail (erlang/element 1 r)})))))

(defn build!
  "Build `entry` with the options in `st`. :preload is an ordered vector of
   libraries whose compiled functions and cached macros bind at evaluator boot.
   Returns {:modules :bytes :ms :out}."
  [entry st]
  (let [out (or (:out st) (str "out/js/" entry))
        t0 (erlang/monotonic_time :millisecond)
        roots (conj (conj (conj (roots-of st) (boot-root)) (compat-root)) (lib-root))
        ; Declaration requires use the loader's roots as well as the linker.
        _ (doseq [root roots] (BeamLisp.Env/add_search_path root))
        ; ONE target. core and rt are COMPILED from priv/boot into the build
        ; (out/ns/), and every core call links to them; there is no
        ; hand-written core to opt into and no mode flag. priv/compat
        ; (clojure.string, clojure.set …) is compiled too: the BEAM loads those
        ; on first call, so a build compiles the ones it reaches.
        r (b/build {:roots roots
                    :entry entry :out out :actor-profile (get st :actor-profile true)
                    :core (core-names) :leaves (leaf-names) :host (host-of st)
                    :stub (csv (:stub st))
                    :with (into base (concat (csv (:with st)) (:preload st)))})]
    (doseq [f ["rt.mjs" "abi.mjs" "lazy.mjs" "host-leaves.mjs" "leaves.mjs" "env.mjs" "interop.mjs" "native-values.mjs"]] (File/cp! (str runtime-dir "/" f) (str out "/" f)))
    ; One host engine in the frontend graph; package entrypoints re-export it.
    (File/mkdir_p! (str out "/actor"))
    (doseq [f ["host.mjs" "native.mjs" "module.mjs"]]
      (File/cp! (str runtime-dir "/actor/" f) (str out "/actor/" f)))
    ; Retire only the known copied legacy runtime from reused output dirs.
    (let [legacy (str out "/core.mjs")]
      (when (and (File/regular? legacy)
                 (starts-with? (File/read! legacy) "// priv/lib/js/core.mjs"))
        (File/rm! legacy)))
    ; the language's own macros, loaded at start by an in-page compiler
    (when (contains? (set (:modules r)) "js.eval")
      (doseq [f ["boot.mjs" "repl.mjs"]] (File/cp! (str runtime-dir "/" f) (str out "/" f))))
    (File/write! (str out "/core-links.mjs") (b/core-links-module (core-names) (leaf-names)))
    (when-not (File/exists? (str out "/host.mjs"))
      (File/write! (str out "/host.mjs") "export const H = globalThis.BL_HOST || {};\n"))
    ; last: it runs the build it is caching (needs every module above)
    (when (contains? (set (:modules r)) "js.eval") (write-boot-cache! out (:preload st)))
    (assoc r :out out :ms (- (erlang/monotonic_time :millisecond) t0))))

(defn- report [r]
  (println (str "js: " (count (:modules r)) " module(s), " (:bytes r) " bytes, "
                (:ms r) " ms -> " (:out r))))

(defn- stamp
  "The mtimes of `files`: a change signal, one stat per file per poll."
  [files]
  (mapv (fn [f] (try (:mtime (File/stat! f (u/kw [:time :posix]))) (catch e nil))) files))

(defn- watch!
  "Build, then rebuild whenever a source the LAST build read changes. The
   watched set is exactly the build's own inputs (its :sources), so a new
   require is picked up by the rebuild that sees it, and nothing else in the
   roots costs a stat."
  [entry st]
  (println (str "js: watching " entry " (Ctrl-C to stop)"))
  (loop [files [] seen nil]
    (let [now (stamp files)]
      (if (and (some? seen) (= now seen))
        (do (Process/sleep 300) (recur files seen))
        (let [r (try (let [r (build! entry st)] (report r) r)
                     (catch e (do (println (str "js: build failed: " (ex-message e))) nil)))
              files* (if (some? r) (:sources r) files)]
          (Process/sleep 300)
          (recur files* (stamp files*)))))))

(defn- test!
  "Run both js_diff_test.bl and js_compiled_core_test.bl via bl.test."
  []
  (BeamLisp.Loader/ensure_loaded "bl.test")
  ((BeamLisp.Env/fetch! "bl.test" "run") (u/to-list ["test/bl/js_diff_test.bl" "test/bl/js_compiled_core_test.bl"]) {}))
(def usage
  "usage: bl js build NS [-p ROOT]... [--out DIR] [--host a,b]
       bl js watch NS [-p ROOT]... [--out DIR] [--host a,b]
       bl js test")

(defn run
  "`bl js build|watch|test` — see the namespace comment."
  [args st]
  (let [[sub entry] (u/to-list args)]
    (cond
      (and (= sub "build") (some? entry))
        (try (report (build! entry st)) 0
             (catch e (do (u/io-err (ex-message e)) 1)))
      (and (= sub "watch") (some? entry)) (watch! entry st)
      (= sub "test") (test!)
      :else (do (u/io-err usage) 2))))
