; bl/repair.bl — `bl repair`: what is wrong with a source, and the edits that fix it.
;
; `bl lint` reports smells in code that READS; this verb handles the case where
; the code does not read at all — the one failure a lint pass cannot describe,
; because everything downstream of the reader needs a tree.
;
;   bl repair src/x.bl            the caret, and the repairs that exist
;   bl repair --force src/x.bl    apply the chosen repair in place
;   bl repair --json src/x.bl     the same, as data
;
; Nothing is written without --force, and --force means exactly what it says: a
; source whose two repairs BOTH balance it is reported as ambiguous, and the
; write is the caller accepting one of them, never this tool pretending to know.
; (The report names which; `repair/choose`'s preference is the tie-break, and it
; is stated in `:policy` rather than hidden.)
;
; A repair is only ever offered for a plain `.bl` source: a literate document
; holds prose around its cells, and the whole-file text the fixer edits is not
; the text the reader read. Those are reported as skipped, the way `bl fix`
; refuses them.

(ns bl.repair
  (:require [bl.util :as u] [bl.report :as report] [repair] [diag]))

(defn- writable?
  "A file this verb may rewrite: a plain `.bl` source."
  [path]
  (String/ends-with? path ".bl"))

(defn- state-of [o]
  (cond
    (not (:solved o)) :unrepairable
    (:ambiguous o) :ambiguous
    :else :fixable))

(defn- examine
  "What `path` is: clean, fixable, ambiguous, unrepairable, unreadable — with the
   diagnostic, the options and the prose when there is something to say. When
   `force?` and the source is a plain `.bl` and a repair is SOLVED, it is written."
  [path force?]
  (let [src (try (File/read! path) (catch _ nil))]
    (cond
      (nil? src) {:file path :state :unreadable}

      (report/reads? src path) {:file path :state :clean}

      :else
        (let [opts (report/opts path)
              o (repair/options src opts)
              st (state-of o)]
          (if (and force? (:solved o))
            (if (writable? path)
              (do (File/write path (repair/apply-fix src (:chosen o)))
                  {:file path
                   :state :repaired
                   :kind (:kind (:chosen o))
                   :why (:why (:chosen o))})
              {:file path :state :skipped :kind (:kind (:chosen o))
               :why (str "a repair would rewrite this whole file; " path
                         " is not a plain .bl source, so nothing was written")})
            {:file path
             :state st
             :kind (get-in o [:chosen :kind])
             :policy (:policy o)
             :why (get-in o [:chosen :why])
             :fixes (map (fn [c] {:kind (:kind c) :why (:why c) :viable (:viable c)})
                         (:fixes o))
             :prose (repair/explain-of src opts o)})))))

(defn- state-word [s]
  (cond
    (= s :clean) "reads cleanly"
    (= s :fixable) "fixable"
    (= s :ambiguous) "ambiguous"
    (= s :unrepairable) "not repairable"
    (= s :unreadable) "cannot be read"
    (= s :skipped) "skipped"
    (= s :repaired) "repaired"
    :else (str s)))

(defn render
  "`bl repair`'s text form: one line per file, and the caret for the files that
   have something to show."
  [r]
  (str "bl repair: " (count (:files r)) " file(s), " (:remaining r) " needing attention"
       (join "" (map (fn [f]
                       (str "\n  " (:file f) " — " (state-word (:state f))
                            (if (:kind f) (str ": " (:kind f)) "")
                            (if (:prose f) (str "\n" (indent (:prose f))) "")))
                     (:files r)))))

(defn- indent
  "Every line of `s`, four spaces in — so a caret block sits under its file line."
  [s]
  (join "\n" (map (fn [l] (str "    " l)) (String/split s "\n"))))

(defn run
  "`bl repair [PATH…] [--force] [--json]`. Exit 0 when every file reads cleanly or
   was repaired, 1 when something remains, 2 on a usage error.

   With no PATH it repairs `src/` when that directory exists, the same shape
   `bl lint` takes."
  [args st]
  (u/register-paths st)
  (let [targets (if (empty? args)
                  (when (File/dir? (u/resolve "src")) ["src"])
                  args)]
    (if (nil? targets)
      (u/usage-error "bl repair: no PATH given and no src/ directory here")
      (let [paths (vec (mapcat u/expand-targets (map u/resolve targets)))]
        (if (empty? paths)
          (u/usage-error "bl repair: no source files found")
          (let [files (vec (map (fn [p] (examine p (:force st))) paths))
                remaining (filter (fn [f] (not (contains? #{:clean :repaired :skipped}
                                                          (:state f))))
                                  files)
                out {:files files :remaining (count remaining)}]
            (u/emit st out render)
            (if (empty? remaining) 0 1)))))))
