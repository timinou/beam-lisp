; Lifecycle commands load the transport without the VM dashboard and port UI.
(ns bl.realm-lifecycle
  (:require [vm.client :as client] [vm.paths :as paths] [bl.env :as project]))

(def DEFAULT-IDLE-SECONDS 28800)

(defn root-of [st]
  (let [cwd (BeamLisp/cwd)
        file (project/find cwd)
        root (or (:root st) (when file (Path/dirname file)))
        r (paths/resolve-root cwd root)]
    (if (contains? r :ok) (:ok r) (BeamLisp/cwd))))

(defn start-options [st]
  {:idle (or (:idle st) DEFAULT-IDLE-SECONDS)
   :log (:log st)
   :ui (not= true (:no-ui st))
   :commands-only (= true (:commands-only st))
   :shared (= true (:share-vm st))})

(defn run [args st]
  (if (= "start" (first args))
    (do (client/start-foreground (root-of st) (start-options st)) 0)
    (client/stop (root-of st))))
