; Pure loading configuration used while reading a project.
(ns bl.loading-policy)

(def DEFAULTS {:environment-env "BL_ENV" :production-values ["production" "prod"]
               :development :lazy :production :startup :roots [] :package-env nil})

(defn validate
  "Pure configuration check. Unknown keys and unsupported modes fail closed."
  [config]
  (let [c (if (nil? config) {} config)]
    (when (not (map? c))
      (throw (ex-info ":loading must be a map" {:kind :loading-config})))
    (when (some (fn [k] (not (contains? DEFAULTS k))) (keys c))
      (throw (ex-info "Unknown :loading key" {:kind :loading-config})))
    (let [p (merge DEFAULTS c)]
      (when (not (and (string? (:environment-env p)) (not= "" (:environment-env p))
                      (contains? #{:lazy :async} (:development p)) (= :startup (:production p))
                      (or (nil? (:package-env p)) (and (string? (:package-env p)) (not= "" (:package-env p))))
                      (vector? (:production-values p)) (<= 1 (count (:production-values p)) 16)
                      (every? (fn [value] (and (string? value) (<= 1 (erlang/byte_size value) 128))) (:production-values p))
                      (vector? (:roots p))
                      (every? (fn [n] (and (string? n) (not= "" n))) (:roots p))))
        (throw (ex-info "Invalid :loading policy: development :lazy/:async, production :startup"
                        {:kind :loading-config})))
      p)))
