; bl/daemon.bl — the language-level daemon request handler.
;
; The daemon's pure-beam-lisp substrate (vm.*) owns the socket, framing,
; env isolation, the group-leader I/O proxy, and the single-worker FIFO. When a
; command arrives it has already: forked a fresh env, bound the client's roots
; (Loader.with_ambient_dirs), and set the group leader to the wire proxy. What
; is LEFT is purely linguistic — parse argv and dispatch — and that is the SAME
; code path a standalone `bl` runs. So this is a thin adapter over `bl.cli`:
;
;   handle(argv, cwd) → bind cwd → bl.cli/run-argv(argv) → exit code
;
; One command router, standalone and daemon alike. No socket or process logic
; lives here; that is the substrate's job.

(ns bl.daemon
  (:require [bl.cli] [vm.manager :as mgr] [vm.spec :as spec] [vm.osenv :as osenv]))

(defn handle
  "Run one client command. `argv` is the raw argument vector (as the client's
  shell split it); `cwd` is the client's working directory, bound so every file
  argument resolves against the caller's tree, not the daemon's checkout.
  Returns an exit code (0 ok · 1 runtime failure · 2 usage). Never halts — a
  halt would take the whole warm daemon down."
  [argv cwd]
  (BeamLisp/with_cwd cwd
    (fn [] (bl.cli/run-argv argv))))

(defn handle-in-vm
  "Route one client command THROUGH its project VM.

   This is the cutover entry: instead of running the command in a single serial
   worker with node-global env, it resolves the VM for `cwd` (get-or-spawn,
   keyed by the collision-proof spec id), then runs `bl.cli/run-argv` under that
   VM — its capped env, its owned process set, its scope (so a `vm.scope/halt`
   inside ends only this VM), and the client's env bound PROCESS-LOCALLY via the
   osenv overlay (never the node-global OS table). `os-env` is the client's
   environment map (or nil to change nothing).

   Runs in the CALLING process (the per-request worker the transport spawns), so
   N concurrent requests are N processes — no FIFO. Returns an exit code; never
   halts the node."
  [argv cwd os-env]
  (mgr/start)
  (let [sp (spec/read cwd)
        vm (mgr/ensure sp)]
    (mgr/run (:id vm)
             (or os-env {})
             (fn [] (BeamLisp/with_cwd cwd (fn [] (bl.cli/run-argv argv)))))))

(defn boot-manager
  "Start the global VM manager (idempotent). The daemon's Elixir boot calls this
   in place of the old single-worker Workers supervisor."
  []
  (mgr/start))