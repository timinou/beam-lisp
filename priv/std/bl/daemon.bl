; bl/daemon.bl — the language-level daemon request handler.
;
; The daemon's pure-beam-lisp substrate (vm.*) owns the socket, framing,
; env isolation, the group-leader I/O proxy, and the single-worker FIFO. When a
; command arrives it has already: forked a fresh env, bound the client's roots
; (Loader.with_ambient_dirs), and set the group leader to the wire proxy. What
; is LEFT is purely linguistic — parse argv and dispatch — and that is the SAME
; code path a standalone `bl` runs. So this is a thin adapter over `bl.cli`:
;
;   handle(argv, cwd) → bind cwd → bl.cli/run-argv(argv) → exit code
;
; One command router, standalone and daemon alike. No socket or process logic
; lives here; that is the substrate's job.

(ns bl.daemon
  (:require [bl.cli] [bl.env :as env] [vm.manager :as mgr] [vm.realm :as realm]
            [vm.osenv :as osenv]))

(defn- run-client [argv cwd]
  (BeamLisp/with_cwd cwd
    (fn []
      (BeamLisp/with_argv (to-list argv)
        (fn [] (bl.cli/run-argv argv))))))

(defn handle
  "Run one client command. `argv` is the raw argument vector (as the client's
  shell split it); `cwd` is the client's working directory, bound so every file
  argument resolves against the caller's tree, not the daemon's checkout.
  Returns an exit code (0 ok · 1 runtime failure · 2 usage). Never halts — a
  halt would take the whole warm daemon down."
  [argv cwd]
  (run-client argv cwd))

(defn realm-root
  "The project root a command in `cwd` belongs to: the directory holding the
   nearest `env.bl` at or above it, else `cwd` itself. This is how a request to a
   shared VM picks its realm, and it is the same walk `bl` uses to find a
   project's file, so an ordinary project (not only an engine checkout) is a
   realm."
  [cwd]
  (let [f (env/find cwd)]
    (if (some? f) (Path/dirname f) (Path/expand cwd))))

(defn- client-environment [os-env]
  ;; A full request environment must hide variables present only at daemon boot.
  ;; Keep with-env's partial-overlay API; supply explicit deletion tombstones here.
  (reduce (fn [result key]
            (if (contains? result key) result (assoc result key nil)))
          (or os-env {}) (keys (erlang/apply :Elixir.System :get_env (list)))))

(defn handle-in-vm
  "Route one client command THROUGH its project's realm.

   The realm is the project `cwd` belongs to (`realm-root`). It is opened on
   first use — its env fork, its index owner, its declared schedules — and every
   later command finds it open. `bl.cli/run-argv` then runs under that realm: its
   capped env, its owned process set, its scope (so a `vm.scope/halt` inside ends
   only this realm), and the client's env bound PROCESS-LOCALLY via the osenv
   overlay (never the node-global OS table). `os-env` is the client's environment
   map (or nil to change nothing).

   Runs in the CALLING process (the per-request worker the transport spawns), so
   N concurrent requests are N processes — no FIFO. Returns an exit code; never
   halts the node."
  [argv cwd os-env]
  (mgr/start)
  (let [vm (realm/open (realm-root cwd))]
    (mgr/run (:id vm)
             (client-environment os-env)
             (fn [] (run-client argv cwd)))))

(defn boot-manager
  "Start the global VM manager (idempotent). The daemon's Elixir boot calls this
   in place of the old single-worker Workers supervisor."
  []
  (mgr/start))