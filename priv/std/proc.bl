; proc.bl — the process pattern language, behind ONE require.
;
; ══ WHAT THIS IS ════════════════════════════════════════════════════════════
;
; Every bundle in the tree is about a running process: a server and its
; clauses, a heartbeat, a bus, a registry, a supervision tree, a fence, a
; deadline queue. They grew one at a time and each landed loose at the root of
; `priv/std`, so there was no name for the tier, no home for it, and no single
; door into it.
;
; This is the door. A consumer writes ONE require:
;
;     (ns app.jobs
;       (:require [proc :as proc]))
;
;     (proc/defserver workers
;       (registry (keys :id))                 ; a CLAUSE: no var, no require
;       (bus (demand 8))
;       (tick 15 :minutes [st] (reap!)))      ; the VERBS are proc/…
;
;     (proc/tick-reset 200 {:name 'workers})
;
; ══ THE THREE SPELLINGS, AND WHICH RESOLVE ═════════════════════════════════
;
; Verified in this tree, 2026-09-18:
;
;   (proc/tick-delay …)          ✓  a qualified VERB through the re-export
;   (tick 15 :minutes [st] …)    ✓  an unqualified CLAUSE — a clause head is a
;                                    symbol the expander looks up, so it needs
;                                    no var and cannot collide with one
;   (proc.server/defserver …)    ✓  a fully-qualified MACRO, resolved by
;                                    namespace name (no alias needed)
;
;   (:require [proc :as p]) (p/defserver …)   ✗  a referred macro does not
;                                                  resolve through a qualifier
;   (:require [proc :refer :all]) (tick-delay …)  ✗  a two-level refer does not
;                                                  chain unqualified (a bare
;                                                  name resolves against the
;                                                  ns's OWN refers, not a
;                                                  referrer's referrer)
;
; So: one require, and the FORM is the only thing that needs qualifying. A bare
; `defserver` is still the compiler's special form — a special form is checked
; before macros — which is the one thing left for boot to fix
; (docs/scheduling/the-clock-and-the-wheel.md §4.6).
;
; ══ THE MOVE IS IN FLIGHT ═══════════════════════════════════════════════════
;
; `proc.server` and `proc.tick` have moved. `flow`, `bus`, `reg`, `super` and
; `fence` have not, and are referred here from their OLD names, so a consumer
; can adopt the new namespace TODAY without waiting for them:
;
;     priv/std/proc.bl        (ns proc)         ← you are here
;     priv/std/proc/server.bl (ns proc.server)  ← moved
;     priv/std/proc/tick.bl   (ns proc.tick)    ← moved
;     priv/std/proc/sched.bl  (ns proc.sched)   ← moved
;     priv/std/flow.bl        (ns flow)         ← still here:  later, proc.flow
;     priv/std/bus.bl         (ns bus)          ← still here:  later, proc.bus
;     priv/std/reg.bl         (ns reg)          ← still here:  later, proc.reg
;     priv/std/super.bl       (ns super)        ← still here:  later, proc.super
;     priv/std/fence.bl       (ns fence)        ← still here:  later, proc.fence
;
; Each `:require` below is deleted in the same commit that moves its file, so
; this list shrinks to nothing and the shim form disappears by attrition
; rather than by a migration event. See FUP-097.
;
; ══ SEE ALSO ════════════════════════════════════════════════════════════════
;
; docs/the-process-pattern-language.md — the tier's own document
; priv/std/proc/server.bl — the expander, and the clause contract

(ns proc
  (:require
    ;; ── moved ──────────────────────────────────────────────────────────
    [proc.server :refer :all]
    [proc.tick :refer :all]
    [proc.sched :refer :all]
    [proc.table :refer :all]
    ;; NOT `:refer :all`, and the reason is measured rather than tidy: `conn`,
    ;; `arm`, `op-name`, `serving?` and `store-live?` are sched's names too, and
    ;; a later `:refer :all` wins SILENTLY — which is exactly how
    ;; `(proc/live? :a-table)` once began answering about a scheduler (the
    ;; rename to `serving?` fixed one instance of it; the trap is the refer).
    ;;
    ;; The clause heads (`queue`, `perform`) need NO var at all — a clause head
    ;; is a symbol the expander looks up — which is the whole reason this door
    ;; can carry a clause from a namespace it barely refers.
    [proc.queue :refer [enqueue!]]
    ;; ── not yet moved: referred from their old names, deleted as they go ──
    [flow :refer :all]
    [bus :refer :all]
    [reg :refer :all]
    [super :refer :all]
    [fence :refer :all]))

;; ── the form, re-exported SHORT ─────────────────────────────────────
;;
;; `proc.server` owns the expander; this shortens the spelling from
;; `proc.server/defserver` to `proc/defserver`. It is a DELEGATION, one line, not
;; a second implementation, and it dies when boot's special form is renamed to
;; `defgen` (PLAN-126 §4.6) — at which point `(:require [proc :refer :all])`
;; and a bare `defserver` finally do what they look like they do.
;;
;; ══ WHY NOT A BARE `defserver` TODAY, AND WHY `:refer` WOULD BE A TRAP ═════
;;
;; The compiler checks `special-forms` BEFORE macros
;; (priv/boot/compiler.bl:4011-4014), and `"defserver"` is in that set. So a
;; bare `defserver` is ALWAYS the boot form, whatever is referred — a `:refer`
;; of this macro would not shadow it and would not error, it would silently
;; compile the OTHER defserver and then fail somewhere in the codegen. A trap,
;; not a convenience. So: QUALIFY, and the two gates are FUP-098 and PLAN-088.
(defmacro defserver
  "The server form, short. `(proc/defserver name clause…)`.

   Every clause the boot `defserver` takes, plus any clause this tier has
   registered: `tick`, `sched`, and whatever a bundle adds with
   `proc.server/extend-clause!`. An unknown clause is reported with the whole
   accepted vocabulary instead of reaching the codegen."
  [name & clauses]
  `(proc.server/defserver ~name ~@clauses))

;; ── what a consumer should reach for ────────────────────────────────────
;;
;; The clause NAMES (`registry`, `bus`, `tick`, `sched`, `fence` as a clause)
;; need no var at all: a clause head is a symbol the expander looks up in
;; `proc.server`'s registry, so they resolve with no require and cannot
;; collide with a fn. What this namespace adds is the VERBS — `register`,
;; `whereis`, `publish`, `subscribe`, `tick-reset`, `tick-cancel`, `children`,
;; `fence-fn` — and the forms the tier already had (`defregistry`, `defbus`,
;; `defsupervisor`), while the tier finds its footing.
;;
;; NB a bare `defserver` is still the compiler's own special form — a special
;; form is checked before macros — so the form is reached as `proc/defserver`
;; until boot's is renamed to `defgen`. When that lands, `:refer` starts
;; working and the qualifier drops off everywhere at once.
;; docs/scheduling/the-clock-and-the-wheel.md §4.6.
