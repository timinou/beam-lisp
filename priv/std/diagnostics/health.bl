; Independent of Logger admission and its writer; failure leaves a stale sample.
(ns diagnostics.health (:require [diagnostics :as diag] [diagnostics.otp :as otp]))
(defn sample []
  (merge {:version 1 :sampled-at (erlang/system_time :millisecond)}
         (select-keys (otp/stats) [:capacity :pending :accepted :written :failed :dropped :alive? :abandoned :saturated-dropped :unavailable-dropped])
         {:projection (diag/health) :identity (select-keys (diag/context) [:diagnostics/boot-id :diagnostics/release-id])}))
(defn publish! [path]
  (let [tmp (str path ".new") bytes (Jason/encode! (sample))]
    (when (> (erlang/byte_size bytes) 4096) (throw {:kind :invalid-config}))
    ;; Parent is provisioned privately by the service manager, never made public here.
    (File/write! tmp bytes (list :binary))
    (File/chmod! tmp 384)
    (File/rename! tmp path)) nil)
(defn start! [path]
  (when (and (string? path) (String/starts_with? path "/run/") (<= (erlang/byte_size path) 512))
    (let [token (BeamLisp.Env/capture)
          worker (fn []
                   (BeamLisp.Env/bind token)
                   (loop []
                     (try (publish! path) (catch _ nil))
                     (receive :diagnostics/stop nil (after 15000 (recur)))))
          spec {:id :diagnostics-health :restart :permanent :shutdown 1000
                :start (tuple :"Elixir.Task" :start_link (list worker))}
          result (erlang/apply :"Elixir.Supervisor" :start_link
                              (list (list spec) (list (tuple :strategy :one_for_one) (tuple :max_restarts 3) (tuple :max_seconds 5))))]
      (when (= :ok (first result))
        ;; Owned by this VM, independent of the request that installed logging.
        (erlang/unlink (second result))
        (second result)))))
(defn stop! [supervisor]
  (erlang/apply :"Elixir.Supervisor" :stop (list supervisor :normal 2000)))
