; Only identities in a trusted release catalog can become code sites.
(ns diagnostics.code)
(def ^:private CATALOG (atom {}))
(def ^:private OPERATIONS (atom {}))
(defn configure! [catalog]
  (when (or (not (map? catalog)) (> (count catalog) 16384)
            (some (fn [[k v]] (or (not (string? k)) (> (erlang/byte_size k) 256)
                                  (not (string? (:site v)))
                                  (not (Regex/match? (Regex/compile! "^[A-Za-z0-9_-]{1,96}$") (:site v))))) catalog))
    (throw (ex-info "diagnostics: invalid code catalog" {:kind :invalid-config})))
  (reset! CATALOG catalog) nil)
(defn frame
  "Project before formatting. Arguments, locations and unknown module names never escape."
  [raw index]
  (try
    (when (and (erlang/is_tuple raw) (>= (erlang/tuple_size raw) 3))
      (let [m (erlang/element 1 raw) f (erlang/element 2 raw) a (erlang/element 3 raw)
            site (when (and (erlang/is_atom m) (erlang/is_atom f))
                   (get @CATALOG (str (erlang/atom_to_binary m) "/" (erlang/atom_to_binary f))))
            arity (cond (erlang/is_integer a) a (erlang/is_list a) (count (take 256 a)) :else nil)]
        (when site
          (cond-> {:code/site-id (:site site) :code/frame index}
            (and (number? arity) (>= arity 0) (<= arity 255)) (assoc :code/arity arity)
            (erlang/is_integer (:line site)) (assoc :code/line (:line site))))))
    (catch _ nil)))
(defn stack [frames]
  (vec (keep identity (map-indexed (fn [i f] (frame f i)) (take 8 frames)))))
(defn with-operation-fn
  "Register only a locally minted handle for the dynamic lifetime of its worker."
  [operation f]
  (if (and (string? operation) (< (count @OPERATIONS) 1024))
    (let [owner (erlang/self)]
      (swap! OPERATIONS assoc operation owner)
      (try (f) (finally (swap! OPERATIONS (fn [m] (if (= owner (get m operation)) (dissoc m operation) m))))))
    (f)))
(defn snapshot
  "Read-only operator API. Handle lookup only: never accepts arbitrary PIDs."
  [operation]
  (when-let [pid (get @OPERATIONS operation)]
    (try
      (let [info (into {} (erlang/process_info pid (list :status :current_function :reductions :message_queue_len :current_stacktrace)))
            status (:status info)]
        {:status (if (contains? #{:running :runnable :waiting :suspended :exiting :garbage_collecting} status) status :unknown)
         :reductions (:reductions info) :mailbox-count (:message_queue_len info)
         :frames (stack (:current_stacktrace info))})
      (catch _ nil))))
(defn sample
  "At most three snapshots over four seconds. No dictionaries, messages or arguments."
  [operation]
  (loop [left 3 out []]
    (if-let [s (snapshot operation)]
      (let [out (conj out s)]
        (if (= left 1) out (do (Process/sleep 2000) (recur (dec left) out)))) out)))
