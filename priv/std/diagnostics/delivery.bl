; A bounded, lossy channel. Capacity includes the record being written.
(ns diagnostics.delivery)

(defn- worker [writer counters token]
  (loop []
    (receive
      [:diagnostics/write tag record] :when (= tag token)
      (do
        (try (writer record) (atomics/add counters 3 1)
             (catch _ (atomics/add counters 4 1)))
        (atomics/sub counters 1 1)
        (recur))
      [:diagnostics/stop tag] :when (= tag token) nil)))

(defn open!
  "One writer process and a fixed number of admission credits. No producer IO."
  [capacity writer]
  (when (or (not (erlang/is_integer capacity)) (< capacity 1) (> capacity 65536)
            (not (fn? writer)))
    (throw (ex-info "diagnostics: invalid delivery configuration" {:kind :invalid-config})))
  (let [c (atomics/new 8 (list (tuple :signed false))) token (erlang/make_ref)
        pid (spawn #(worker writer c token))]
    {:pid pid :token token :counters c :capacity capacity}))

(defn submit!
  "Reserve a credit in one atomic operation. Competing producers cannot lose
   a free slot merely because another producer changed the pending count.
   Rejected reservations are immediately returned; no producer IO or waiting."
  [channel record]
  (let [c (:counters channel)]
    (if (or (not= 0 (atomics/get c 6)) (not (erlang/is_process_alive (:pid channel))))
      (do (atomics/add c 5 1) (atomics/add c 8 1) :dropped)
      (let [reserved (atomics/add_get c 1 1)]
        (if (<= reserved (:capacity channel))
          (do (erlang/send (:pid channel) [:diagnostics/write (:token channel) record])
              (atomics/add c 2 1) :accepted)
          (do (atomics/sub c 1 1) (atomics/add c 5 1) (atomics/add c 7 1) :dropped))))))

(defn stats [channel]
  (let [c (:counters channel)]
    {:capacity (:capacity channel) :pending (min (:capacity channel) (atomics/get c 1)) :accepted (atomics/get c 2)
     :written (atomics/get c 3) :failed (atomics/get c 4)
     :dropped (atomics/get c 5) :alive? (erlang/is_process_alive (:pid channel))
     :saturated-dropped (atomics/get c 7) :unavailable-dropped (atomics/get c 8)
     :abandoned (if (erlang/is_process_alive (:pid channel)) 0 (atomics/get c 1))}))

(defn close!
  "Stop admission, drain for at most ms, then terminate a blocked writer.
   Pending counts abandoned work; close never waits indefinitely."
  [channel ms]
  (when (or (not (erlang/is_integer ms)) (< ms 0))
    (throw (ex-info "diagnostics: invalid close deadline" {:kind :invalid-config})))
  (let [c (:counters channel) pid (:pid channel) ref (erlang/monitor :process pid)]
    (atomics/put c 6 1)
    (erlang/send pid [:diagnostics/stop (:token channel)])
    (receive
      [:DOWN r :process _ _] :when (= r ref) nil
      (after ms (erlang/exit pid :kill)))
    (erlang/demonitor ref (list :flush))
    (stats channel)))
