; priv/deodorant.bl — smell detection and mechanical correction for
; beam-lisp source, built on the `rewrite` engine.
;
; The problem it solves: an agent (or a person in a hurry) writes the
; *long* spelling of something the language already has a short, exact
; word for — `(if (not p) a b)` where `if-not` exists, `(Map/get m :k)`
; where `(:k m)` exists. None of these are wrong; all of them are noise.
; Deodorant removes the noise.
;
; The honest contract — the same one `rewrite` makes — is that every
; correction is a RULE you can read below: `{:name :tier :pattern
; :replacement :when?}`. There is no model guessing at a fix: the after
; is exactly the sum of the registered rules, and a reviewer checks each
; by eye.
;
; FOUR TIERS, because not every rewrite is equal:
;
;   SAFE        — value-identical for all inputs. Apply blind.
;   IDIOMATIC   — value-identical under a mild, near-universal assumption
;                 (numeric argument, keyword-literal key). In the default
;                 `deodorize` ruleset.
;   REINVENTION — a hand-rolled stdlib function (count, sum). Exact, but
;                 restructures more of the form; opt-in via `every-rule`.
;   MIGRATION   — a form becomes another form: correct, but the target may
;                 not exist yet (a `:requires-ns` prerequisite makes the rule
;                 inert and REPORTED as skipped until it does) and the rewrite
;                 may drag a second edit with it (an `:ensure-require` entry
;                 added to the file's `(ns …)` require line). Opt-in via
;                 `every-rule`, never in the default ruleset — a migration is
;                 a diff to review, not a cosmetic tidy.
;
; A rule may carry `:when`, a GUARD fn receiving the match's bindings
; (keyed by pattern variable) that can veto the rewrite — this is what
; confines the map-access smells to keyword-literal keys: `(Map/get m k)`
; with a variable key is left alone, because the key might not be a
; keyword at runtime.
;
; A rule may also carry a PREREQUISITE, `:requires-ns` — a qualified symbol
; the rule's output depends on (the word it rewrites TO, or the clause that
; must be registered). An unmet prerequisite makes the rule inert AND
; visible (`skipped-rules`), because a rule that silently cannot fire is the
; failure this exists to expose: register a migration early and every
; `bl fix --tier every` would rewrite to a word that does not resolve.
;
; A rule may also carry a SECOND EDIT, `:ensure-require` — a require entry
; (e.g. `[proc.server :as srv]`) its output needs on the file's `(ns …)`
; line. The fixer appends it to the existing `:require` vector, or refuses
; loudly when the file has none; it never invents a require or reorders one.
;
; The registry is OPEN: a project declares its house idioms in its own
; file with `defsmell`, no library edit.
(ns deodorant
  (:require [rewrite] [span-rewrite] [reader-node :as rn]))

; --- the registry --------------------------------------------------------

(def registry
  "Every declared smell, in declaration order. An atom because `defsmell`
   extends it at runtime — a project's own file adds its own idioms."
  (atom (list)))

(defn register-smell!
  "Append `smell` to the registry, replacing any same-named smell
   (redefinition replaces, like a var); returns it. Called from the
   INITIALIZER of the var `defsmell` defines — value-def initializers
   are replayed by `__bl_init__` at module load, which is what makes a
   registered smell survive AOT compilation."
  [smell]
  (swap! registry
         (fn [rs] (concat (filter (fn [s] (not (= (:name s) (:name smell)))) rs)
                          (list smell))))
  smell)

(defmacro defsmell
  "Declare a smell: (defsmell name :tier (pattern) => (replacement)
   [:when guard]). Pattern and replacement are quoted for you — the `?`
   vars survive as pattern variables; the optional :when guard is CODE,
   evaluated here and stored as the veto fn.

   The expansion is a `def`: the smell is an ordinary VAR (inspectable,
   meta-able, visible to the codebase-as-database), and the registration
   call rides its initializer so it replays at AOT module load."
  [name tier pattern _arrow replacement & opts]
  ; Refuse a malformed pattern where it is WRITTEN, not at the first form
  ; it happens to meet — rewrite's own declaration-time contract.
  (rewrite/check-pattern! pattern)
  ; `:when` is CODE (a guard fn) and passes through untouched; the
  ; prerequisite `:requires-ns` and the second edit `:ensure-require` are
  ; DATA (a qualified symbol, a require vector) and are quoted for you,
  ; like pattern and replacement.
  (let [data-keys #{:requires-ns :ensure-require}
        opts (apply list
                    (mapcat (fn [p]
                              (let [k (first p) v (second p)]
                                (if (contains? data-keys k)
                                  (list k (if (and (list? v) (= 'quote (first v)))
                                            v (list 'quote v)))
                                  (list k v))))
                            (partition 2 opts)))]
    ; `concat` is LAZY — a LazySeq inside the expansion crashes the
    ; compiler's form walker (no data_to_form clause for it). `apply list`
    ; realizes the args into a proper list.
    (list 'def name
          (list 'deodorant/register-smell!
                (cons 'hash-map
                      (apply list
                             (concat (list :name (list 'quote name)
                                           :tier tier
                                           :pattern (list 'quote pattern)
                                           :replacement (list 'quote replacement))
                                     opts)))))))

; --- SAFE: value-identical, apply blind ----------------------------------
;
; Ordering matters where patterns overlap: `(if (not ?p) ?a nil)` matches
; both when-not and if-not; try-smells is first-match-wins, so the more
; specific `nil`-tailed forms come FIRST.

(defsmell if→when-not :safe (if (not ?p) ?a nil) => (when-not ?p ?a))
(defsmell if→when     :safe (if ?p ?a nil)       => (when ?p ?a))
(defsmell if→if-not   :safe (if (not ?p) ?a ?b)  => (if-not ?p ?a ?b))

(defsmell not-nil?→some? :safe (not (nil? ?x)) => (some? ?x))
(defsmell not-=→not=     :safe (not (= ?a ?b)) => (not= ?a ?b))

; `(= x nil)` and `(= nil x)` both mean `(nil? x)`; the matcher is
; positional and both spellings occur in the wild.
(defsmell =-nil→nil?  :safe (= ?x nil) => (nil? ?x))
(defsmell =-nil→nil?* :safe (= nil ?x) => (nil? ?x))

(defsmell not-not→boolean :safe (not (not ?x)) => (boolean ?x))

; `(if p true false)` is `(boolean p)` — the "coerce to bool by hand" tic.
; The literals match positionally, so this never fires on `(if p true x)`.
(defsmell if-true-false→boolean :safe (if ?p true false) => (boolean ?p))

; --- IDIOMATIC: value-identical under a mild assumption ------------------
;
; NUMERIC: `(= x 0)` is `(zero? x)` when x is a number — which, at a
; comparison against 0, it always is.
(defsmell =-0→zero?  :idiomatic (= ?x 0) => (zero? ?x))
(defsmell =-0→zero?* :idiomatic (= 0 ?x) => (zero? ?x))
(defsmell >-0→pos?   :idiomatic (> ?x 0) => (pos? ?x))
(defsmell <-0→neg?   :idiomatic (< ?x 0) => (neg? ?x))
(defsmell +1→inc     :idiomatic (+ ?x 1) => (inc ?x))
(defsmell +1→inc*    :idiomatic (+ 1 ?x) => (inc ?x))
(defsmell -1→dec     :idiomatic (- ?x 1) => (dec ?x))

; COLLECTION: `(first (rest x))` is `(second x)`. Structural and exact.
; NB: `(first (first x))`→`ffirst` is deliberately NOT a smell — `ffirst`
; is not defined in this runtime, and a rule may only rewrite to a word
; that actually resolves.
(defsmell first-rest→second :idiomatic (first (rest ?x)) => (second ?x))

; MAP ACCESS: `(Map/get m :k)` is Elixir spelled out. With a keyword
; LITERAL key the language's own words are exact: `(:k m)`,
; `(get m :k default)`, `(get-in m [:a :b])`. The guards confine every
; one of these to keyword literals — a variable or string key stays
; untouched, because it might not be a keyword at runtime. The ONE
; divergence (pinned in the test): keyword-as-fn on nil returns nil where
; Map/get on nil would raise.
(defsmell map-get->kw-access :idiomatic
  (Map/get ?m ?k) => (?k ?m)
  :when (fn [b] (keyword? (get b '?k))))

(defsmell map-get-default->get :idiomatic
  (Map/get ?m ?k ?d) => (get ?m ?k ?d)
  :when (fn [b] (keyword? (get b '?k))))

(defsmell nested-kw->get-in :idiomatic
  (?k2 (?k1 ?m)) => (get-in ?m [?k1 ?k2])
  :when (fn [b] (and (keyword? (get b '?k1)) (keyword? (get b '?k2)))))

(defsmell kw-of-get-default->get-in :idiomatic
  (?k2 (get ?m ?k1 {})) => (get-in ?m [?k1 ?k2])
  :when (fn [b] (and (keyword? (get b '?k1)) (keyword? (get b '?k2)))))

; --- REINVENTION: a hand-rolled stdlib fn, opt-in ------------------------

(defsmell reduce->count :reinvention
  (reduce (fn [?a ?x] (+ ?a 1)) 0 ?xs) => (count ?xs))

(defsmell reduce->sum :reinvention
  (reduce (fn [?a ?x] (+ ?a ?x)) 0 ?xs) => (apply + ?xs))

(defsmell reduce-map->sum :reinvention
  (reduce (fn [?a ?x] (+ ?a (?f ?x))) 0 ?xs) => (apply + (map ?f ?xs)))

; nil-punning in Elixir term order makes (>= nil 0) TRUE — comparing an
; index-of result against a number without a nil check is inverted when
; the substring is absent. Found the hard way in codebase/interop-name?
; (MVP-B): every name looked "interop" and unknown-callee queries went
; silently empty. Some?/nil? say what was meant.
(defsmell index-of-ge-zero :idiomatic
  (>= (index-of ?s ?sub) 0) => (some? (index-of ?s ?sub)))
(defsmell index-of-lt-zero :idiomatic
  (< (index-of ?s ?sub) 0) => (nil? (index-of ?s ?sub)))

; DATALOG PLANS: a nested `:not`/`:not-join`/`:or`/`:or-join` sub-query
; runs once per OUTER ROW. When one of its patterns binds an attribute
; VALUE and that attribute is not :db/indexed, the planner reads the
; whole column per row — correct, and quadratic (the arity-mismatches
; query took 62s over 28 files). The fix is a RESTRUCTURE — hoist the
; sub-query's answer out of the loop, or index the attribute — so there
; is no local rewrite that is always right and the rule is ADVISORY.
; A file with no readable schema can only flag the RISK; `datom.explain`
; is resolved LAZILY so `bl lint` on ordinary code never pays for it.
(defsmell datalog/nested-scan :idiomatic
  (quote ?q) => (quote ?q)
  :advisory true
  :note "A nested :not/:not-join/:or/:or-join sub-query re-runs per outer row, so a clause that binds a VALUE over an unindexed attribute re-reads that whole column once per row. Fix: index the attribute (:db/index true, or :db/unique) so AVET exists, or build the sub-query's answer ONCE outside the loop (a set / memo / index! step). A :db.type/ref attribute, and any indexed or unique one, already prefix-scans — when the schema is not in this file, confirm with `datom/explain` against the live conn."
  :when (fn [b]
          (let [q (get b '?q)]
            (and (vector? q)
                 (try
                   (do
                     (BeamLisp.Loader/ensure_loaded "datom.explain")
                     (let [smells (BeamLisp.Env/fetch! "datom.explain" "smells")]
                       (not (empty? (smells q nil)))))
                   (catch _ false))))))

; --- MIGRATION: a form becomes another form, opt-in ----------------------
;
; Every rule below is CORRECT but its target may not exist yet. The
; `:requires-ns` prerequisite makes it inert today and reported `skipped`
; by `bl lint` — never a silent no-op, never a rewrite to a word the
; compiler cannot read. FUP-094/095/096 carry the design; §4.6 of
; docs/scheduling/the-clock-and-the-wheel.md is the motive.

; The bundle macros become CLAUSES on ONE server form (FUP-094). The gate is
; the clause transform `proc.reg/registry-clause`, which `proc/reg.bl` defines
; and hands to `proc.server/extend-clause!`: while that var is absent the rule
; is inert and reported `skipped`, and the day it lands the rule fires with no
; edit here. The matcher is exact-arity, so the `(keys …)` sub-form binds as ONE
; variable and the guard checks its shape. The rewritten form needs `srv` on
; the file's require line, which the rule drags with it.
(defsmell defregistry→registry-clause :migration
  (reg/defregistry ?name ?keys) => (srv/defserver ?name (registry ?keys))
  :when (fn [b] (let [k (get b '?keys)]
                  (and (list? k) (= 'keys (first k)))))
  :requires-ns proc.reg/registry-clause
  :ensure-require [proc.server :as srv])

; Likewise the bus — both arities, since the `(demand …)` clause is optional.
(defsmell defbus→bus-clause :migration
  (bus/defbus ?name ?cfg) => (srv/defserver ?name (bus ?cfg))
  :requires-ns proc.bus/bus-clause
  :ensure-require [proc.server :as srv])

(defsmell defbus→bus-clause-default :migration
  (bus/defbus ?name) => (srv/defserver ?name (bus))
  :requires-ns proc.bus/bus-clause
  :ensure-require [proc.server :as srv])

; The qualifier drop (FUP-095): once boot's special form is renamed to
; `defgen`, std's `defserver` can finally be referred unqualified and the
; `srv/` alias the migrations above write drops off. The TAIL REST pattern
; is the whole point — the clause count varies, so an exact-arity rule
; cannot express the shape (`rewrite` gained `?*name` for exactly this).
(defsmell srv-defserver→defserver :migration
  (srv/defserver ?name ?*clauses) => (defserver ?name ?*clauses)
  :requires-ns core/defserver)

; --- tier queries ---------------------------------------------------------

(defn all-smells
  "Every registered smell map, declaration order."
  []
  (deref registry))

(defn rules-of-tier
  "The registered smells of one tier (`:safe`, `:idiomatic`,
   `:reinvention`, `:migration`)."
  [tier]
  (filter (fn [s] (= (:tier s) tier)) (all-smells)))

(defn safe-rules       [] (rules-of-tier :safe))
(defn migration-rules  [] (rules-of-tier :migration))
(defn every-rule       [] (all-smells))

(defn all-rules
  "The default `deodorize` ruleset: safe + idiomatic. Reinvention and
   migration are opt-in only — a caller who wants them takes `every-rule`.
   A migration belongs to no default set: it is a diff to review."
  []
  (concat (rules-of-tier :safe) (rules-of-tier :idiomatic)))

; --- matching: pattern + guard -------------------------------------------

; --- PREREQUISITE: is the rule's target available? -----------------------
;
; A migration rewrites to a word that may not exist yet — `proc.server/
; defserver` before the server expander lands, or the `(registry …)` clause
; before the registry bundle does. A rule declares the dependency as
; `:requires-ns`, a qualified symbol, and is INERT until that symbol
; resolves: it matches nothing, so `bl fix --tier every` is a no-op rather
; than a rewrite to a word the compiler cannot read. It is a GUARD, not a
; tier — the rule is still registered, still visible, and reported
; `skipped` (`skipped-rules`), because a rule that silently cannot fire is
; the failure this exists to expose.

(defn var-resolves?
  "Does the qualified symbol `sym` (e.g. `proc.server/defserver`) name a var
   this runtime can resolve NOW? Loads the namespace lazily — the same
   `Loader/ensure_loaded` + `Env/fetch` a guard uses — and answers false,
   never throws, for an unqualified symbol, an unloadable namespace, or a
   name that binds nothing."
  [sym]
  (try
    (let [nsp (namespace sym)]
      (and (some? nsp)
           (do (BeamLisp.Loader/ensure_loaded nsp)
               (not= :error (BeamLisp.Env/fetch nsp (name sym))))))
    (catch _ false)))

(defn available?
  "True when `smell`'s declared prerequisite is satisfied — or it declares
   none. A rule with `:requires-ns` is inert until that symbol resolves."
  [smell]
  (let [req (:requires-ns smell)]
    (if (nil? req) true (var-resolves? req))))

(defn skipped-rules
  "The rules in `rules` whose `:requires-ns` prerequisite does not resolve
   now — inert, and worth naming. `bl lint` prints each as `⊘ skipped`, so
   a migration parked on an absent target reads as parked, not as absent."
  [rules]
  (filter (fn [s] (and (some? (:requires-ns s)) (not (available? s)))) rules))

(defn smell-match
  "The bindings map if `smell` is AVAILABLE (its `:requires-ns` prerequisite
   resolves), its pattern matches `form`, AND its `:when` guard (if any)
   accepts the bindings, else nil. Bindings are keyed by the pattern
   VARIABLE — a guard reads `(get b '?k)`."
  [smell form]
  (when (available? smell)
    (let [binds (rewrite/match? (:pattern smell) form)]
      (if (and (some? binds)
               (let [g (get smell :when nil)]
                 (if (nil? g) true (g binds))))
        binds
        nil))))

; --- DETECT: find smells without changing anything ------------------------

(defn subforms
  "Every node of `form`, itself included, depth-first. A code form is a
   tree of lists/vectors; this is the flat view the scanner folds over."
  [form]
  (cons form
        (if (or (list? form) (vector? form))
          (reduce (fn [acc x] (concat acc (subforms x))) (list) (seq form))
          (list))))

(defn matches
  "The smells in `rules` that fire on `form` at its root (no descent),
   guards included."
  [rules form]
  (filter (fn [r] (some? (smell-match r form))) rules))

(defn scan
  "Detect: every smell in `form`, as a list of `{:rule name :at subform}`.
   Walks every node and reports each smell that fires there. Pure — it
   changes nothing, so it is the half a linter or a pre-commit check
   wants: tell me what is here, let me decide."
  [rules form]
  (reduce
    (fn [acc sub]
      (concat acc (map (fn [r] {:rule (:name r) :at sub}) (matches rules sub))))
    (list)
    (subforms form)))

(defn report
  "A `{smell-name → count}` summary of `form` under `rules`. The one-line
   answer to \"how noisy is this?\"."
  [rules form]
  (-> (group-by :rule (scan rules form))
      (update-vals count)))

; --- CORRECT: rewrite the smells away -------------------------------------

(defn- try-smells
  "Apply the first smell in `rules` whose pattern matches `form` and whose
   guard accepts, or `form` unchanged. First match wins; earlier rules
   take precedence."
  [rules form]
  (loop [rules rules]
    (if (empty? rules)
      form
      (let [s (first rules)
            binds (smell-match s form)]
        (if (some? binds)
          (rewrite/subst binds (:replacement s))
          (recur (rest rules)))))))

(defn deodorize-with
  "Correct `form` with an explicit ruleset, to a fixed point (children
   before parents each pass). Guards ride along — a vetoed match is not
   applied. Like `rewrite/apply-rules`, raises rather than hanging if the
   ruleset cycles."
  ([rules form] (deodorize-with rules form 1000))
  ([rules form cap]
   (loop [form form passes 0]
     (let [next (rewrite/postwalk (fn [x] (try-smells rules x)) form)]
       (if (= next form)
         form
         (if (>= passes cap)
           (throw (ex-info "deodorize did not reach a fixed point — the ruleset appears to cycle"
                           {:non-terminating true :passes passes :cap cap}))
           (recur next (inc passes))))))))

(defn deodorize
  "Correct `form` with the default ruleset (safe + idiomatic)."
  [form]
  (deodorize-with (all-rules) form))

; --- the fixer: span-preserving source rewrite ----------------------------
;
; The form-level fns above work on parsed data; the fixer works on TEXT,
; splicing each smelled top-level span and leaving everything else —
; comments, formatting, untouched siblings — byte-for-byte. (A read→print
; codemod would normalize formatting and drop comments; that is inherent
; to form-level work and why the fixer stays at the text level.)

(defn all-spans
  "The `[start end)` codepoint spans of EVERY list form in `src`, nested
   included, ordered by closing paren (inner before outer, left before
   right); `fix-source` reverses them so splicing runs rightmost-first
   and earlier offsets stay valid. A scanner, not a parse: parens inside
   string literals and comments do not count. Codepoint offsets compose
   with String/slice (grapheme-safe for source text, ASCII in practice)."
  [src]
  (let [chars (into [] (String/codepoints src))
        n (count chars)]
    (loop [i 0 stack (list) in-str false in-comment false spans []]
      (if (>= i n)
        spans
        (let [c (get chars i)]
          (cond
            in-comment
              (recur (inc i) stack in-str (not (= c "\n")) spans)

            in-str
              (cond
                (= c "\\") (recur (+ i 2) stack true false spans)
                (= c "\"") (recur (inc i) stack false false spans)
                :else      (recur (inc i) stack true false spans))

            (= c ";")  (recur (inc i) stack false true spans)
            (= c "\"") (recur (inc i) stack true false spans)
            (= c "(")  (recur (inc i) (cons i stack) false false spans)
            (= c ")")  (recur (inc i) (rest stack) false false
                               (conj spans [(first stack) (inc i)]))
            :else      (recur (inc i) stack false false spans)))))))

(defn overlaps?
  "Do [a b) and [x y) intersect? Spans are properly nested or disjoint,
   so any intersection means one contains the other — and the outer's
   text is stale once the inner changed (and vice versa)."
  [a b [x y]]
  (and (< a y) (> b x)))

(defn read-forms
  "Parse source text into a list of top-level forms (native, `list?`-true,
   ready for the matcher). Uses the compiler's data reader, which never
   evaluates."
  [src]
  (BeamLisp.Compiler/read_all_data src))

(defn fix-source
  "Rewrite every smelled subform in source text `src`, returning
   `{:source new-text :changed n}`. Splices at the SMELL's own span, so
   everything else — comments, formatting, the surrounding defn,
   non-smell siblings — survives byte-for-byte. Passes run to a fixed
   point (a rewrite can expose a new smell one level up), and the result
   is re-parsed before returning: the fixer never produces broken
   source."
  [rules src]
  (loop [out src changed 0 passes 0]
    (let [spans (reverse (all-spans out))
          step (fn [acc span]
                 (let [start (first span)
                       end (second span)]
                   (if (some (fn [r] (overlaps? start end r)) (:regions acc))
                     acc
                     (let [text (String/slice (:source acc) start (- end start))
                           form (first (read-forms text))
                           ; splice only a span whose ROOT is a smell —
                           ; never one that merely CONTAINS one, or the
                           ; enclosing defn's text (and its comments)
                           ; would be normalized away.
                           fixed (try-smells rules form)]
                       (if (= fixed form)
                         acc
                         {:source (str (String/slice (:source acc) 0 start)
                                       (pr-str fixed)
                                       (String/slice (:source acc) end
                                                     (- (String/length (:source acc)) end)))
                          :changed (inc (:changed acc))
                          :regions (conj (:regions acc) [start end])})))))
          pass (reduce step {:source out :changed 0 :regions []} spans)]
      (cond
        (= (:changed pass) 0)
          (do (doall (read-forms out))
              {:source out :changed changed})
        (>= passes 100)
          (throw (ex-info "fix-source did not reach a fixed point" {:passes passes}))
        :else
          (recur (:source pass) (+ changed (:changed pass)) (inc passes))))))

(defn fix-file!
  "`fix-source` over a file, writing only when something changed. NB this is
   the form-level fixer: it does NOT apply a migration's `:ensure-require`
   second edit. Use `fix-file-preserving!` (the one `bl fix` calls) when the
   ruleset can contain migrations."
  [rules path]
  (let [src (second (File/read path))
        res (fix-source rules src)]
    (when (> (:changed res) 0)
      (File/write path (:source res)))
    res))

; --- the SECOND EDIT: a migration may need a require on the header --------
;
; A migration rewrites to a word in another namespace, so the file's `(ns …)`
; line must carry that namespace or the output does not compile — the hole
; FUP-096 names: a fix whose output must be hand-repaired is worse than no
; fix, because the repair is invisible. The rule declares the entry it needs
; as `:ensure-require [proc.server :as srv]` and the fixer appends a NEW
; require vector to the `:require` clause — append only, never reorder,
; never merge two requires that differ in `:as`, and when the header has no
; `:require` at all, REFUSE and name the line rather than invent one.

(defn- ns-node
  "The file's top-level `(ns …)` reader node, or nil. Read from the reader's
   own tree, so positions are exact and the search cannot be fooled by a
   `(ns` inside a string or comment."
  [src]
  (first
   (filter (fn [n]
             (let [f (rn/node-form n)]
               (and (= :list (rn/node-tag f))
                    (seq (rn/node-items f))
                    (let [h (rn/node-form (first (rn/node-items f)))]
                      (and (= :symbol (rn/node-tag h))
                           (= "ns" (rn/node-name h)))))))
           (BeamLisp.Reader/read_string src))))

(defn- require-clause
  "The `(:require …)` clause node of an ns node, or nil."
  [nsn]
  (some (fn [c]
          (let [f (rn/node-form c)]
            (when (and (= :list (rn/node-tag f))
                       (seq (rn/node-items f))
                       (let [h (rn/node-form (first (rn/node-items f)))]
                         (and (= :keyword (rn/node-tag h))
                              (= "require" (rn/node-name h)))))
              c)))
        (rest (rn/node-items nsn))))

(defn- require-vectors
  "The `[…]` require entries inside a `(:require …)` clause, as data vectors."
  [clause]
  (keep (fn [c]
          (let [f (rn/node-form c)]
            (when (= :vector (rn/node-tag f))
              (try (rn/form f) (catch _ nil)))))
        (rn/node-items clause)))

(defn ensure-require-entries
  "The require ENTRIES a rule's `:ensure-require` declares, as a list of
   vectors: a single `[proc.server :as srv]` is one entry, a vector OF vectors
   is several. nil (no second edit) is the empty list."
  [rule]
  (let [e (:ensure-require rule)]
    (cond
      (nil? e) (list)
      (and (vector? e) (vector? (first e))) e
      :else (list e))))

(defn ensure-requires
  "Append each require `entry` (e.g. `[proc.server :as srv]`) the migration
   needs to the `(ns …)` form of `src`, as a new vector at the end of its
   `:require` clause. Returns `{:source text :changed bool :requires-added
   [...] :refused nil|msg}`.

   Conservative by construction: an entry already present (or its namespace
   already required) is left alone; the same namespace under a DIFFERENT
   alias is refused (two requires of one ns would fight over the header); a
   file with no `(ns …)` or no `:require` clause is REFUSED with the line to
   edit, never given an invented header."
  [src entries]
  (let [offs (span-rewrite/line-offsets src)]
    (loop [out src added [] es (seq entries)]
      (let [done {:source out :changed (not (empty? added))
                  :requires-added added :refused nil}]
        (if (empty? es)
          done
          (let [entry (first es)
                nsn (ns-node out)]
            (if (nil? nsn)
              (assoc done :refused
                     (str "no (ns …) form to add " (pr-str entry) " to"))
              (let [clause (require-clause nsn)]
                (if (nil? clause)
                  (assoc done :refused
                         (str "line " (get-in (rn/node-pos nsn) [:line])
                              ": the (ns …) form has no :require clause — add `"
                              (pr-str entry) "` by hand rather than let a machine invent the header"))
                  (let [entries-data (require-vectors clause)
                        exact (some (fn [d] (= d entry)) entries-data)
                        same-ns (some (fn [d] (and (vector? d) (= (first d) (first entry))))
                                      entries-data)
                        pos (rn/node-pos clause)
                        end (+ (get offs (:end-line pos)) (dec (:end-col pos)))
                        at (dec end)  ; just before the clause's closing `)`
                        new (str (String/slice out 0 at) " " (pr-str entry)
                                 (String/slice out at (- (String/length out) at)))]
                    (cond
                      exact
                        (recur out added (rest es))
                      same-ns
                        (assoc done :refused
                               (str "the header already requires " (first entry)
                                    " under a different alias — reconcile it by hand so `"
                                    (first entry) "` has one spelling"))
                      :else
                        (recur new (conj added entry) (rest es)))))))))))))

; --- TRIVIA-PRESERVING fixer (the default going forward) -------------------
;
; fix-source splices (pr-str fixed), which re-renders a matched subtree on one
; line — multi-line captures and their comments are destroyed, so a blanket
; sweep is unusable. fix-source-preserving delegates to span-rewrite: each
; smell becomes a rule whose replacement splices the ORIGINAL source bytes of
; every capture, so only the rule's own fixed tokens are new text. Comments,
; indentation, and multi-line shape survive byte-for-byte. This is what makes
; `deodorant fix --all` safe across the whole codebase.

(defn fix-source-preserving
  "Like fix-source, but trivia-preserving. Rewrites every smelled subform in
   `src` to a fixed point via span-rewrite; the result differs from the input
   ONLY inside matched spans. Returns `{:source new-text :changed n
   :requires-added [...] :refused nil|msg}`: after the rewrites, every rule
   that FIRED contributes its `:ensure-require` (the SECOND EDIT a migration
   implies) and the header is amended, or the whole fix is refused. Re-parses
   before returning — never emits broken source."
  [rules src]
  (let [rv (into [] (filter available? rules))
        srules (mapv span-rewrite/smell->rule rv)]
    ; `seen` guards against a NON-CONVERGING ruleset (a rare rule pair that
    ; undoes itself): if a pass reproduces source already emitted, or we hit the
    ; pass cap, stop and return the current text rather than throwing — a
    ; stubborn file yields its best-effort fixes instead of aborting a sweep.
    (loop [out src changed 0 passes 0 seen #{} fired []]
      (let [res (span-rewrite/rewrite-source srules out)
            fired (into fired (map (fn [i] (get rv i)) (:fired res)))]
        (if (or (= (:changed res) 0) (contains? seen (:source res)) (>= passes 50))
          (let [entries (distinct (mapcat ensure-require-entries fired))
                r (if (empty? entries)
                    {:source out :requires-added [] :refused nil}
                    (ensure-requires out entries))]
            (doall (read-forms (:source r)))
            ; A refusal means the header cannot be amended safely, so NOTHING
            ; is emitted: the result hands back the ORIGINAL source and a zero
            ; change count, and the caller reports the reason.
            (if (:refused r)
              (assoc r :source src :changed 0 :requires-added [])
              (assoc r :changed changed)))
          (recur (:source res) (+ changed (:changed res)) (inc passes)
                 (conj seen out) fired))))))

(defn fix-file-preserving!
  "fix-source-preserving over a file, writing only when something changed AND
   no second edit was refused. The trivia-safe sibling of fix-file! — use this
   for the blanket sweep. A refusal means the rewrites were found but the
   header could not be amended safely, so NOTHING is written."
  [rules path]
  (let [src (second (File/read path))
        res (fix-source-preserving rules src)]
    (when (and (> (:changed res) 0) (nil? (:refused res)))
      (File/write path (:source res)))
    res))

; --- SOURCE drivers: form-level batch passes -------------------------------

(defn print-forms
  "Render forms back to source, one top-level form per line."
  [forms]
  (join "\n" (map pr-str forms)))

(defn deodorize-source
  "Correct every top-level form in source text `src`, returning new
   source. NB: form-level — formatting normalizes and comments drop; for
   text-faithful fixing use `fix-source`."
  [rules src]
  (print-forms (map (fn [f] (deodorize-with rules f)) (read-forms src))))

(defn report-source
  "Detect smells across all top-level forms of `src`, merged into one
   `{smell-name → count}` summary."
  [rules src]
  (-> (group-by :rule
                (reduce (fn [acc f] (concat acc (scan rules f)))
                        (list) (read-forms src)))
      (update-vals count)))
