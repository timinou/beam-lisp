; The execution layer: turning a compiled navigator plus a structure
; into an answer.
;
; specter/engine.bl builds the navigator; this file runs it. The split
; is deliberate --- the algebra there is the part worth understanding
; and the part a reader who never cares about Specter might still want;
; everything here is mechanical by comparison, four entry points over
; one traversal.
;
; Upstream collects select results into a Java MutableCell holding a
; transient vector. That cell is a within-one-call accumulator, not
; shared state, so it ports to a plain fold --- and a fold is the
; clearer statement of what is actually happening. The one thing a naive
; fold gets wrong is early termination, which is why `doseqres` exists
; and why the tests count realizations rather than trusting the shape.

(ns specter.exec
  (:require [specter.engine :refer :all]))

; --- NONE-aware reduction --------------------------------------------
;
; The reduction every navigator's `select*` uses to combine results from
; its subvalues. Two rules, both load-bearing:
;
;   a NONE result leaves the accumulator alone --- "this branch selected
;   nothing" must not overwrite a sibling branch that selected something;
;
;   a `reduced` result terminates immediately and propagates, so
;   select-any can stop at the first hit without walking the rest of an
;   arbitrarily large structure.
;
; Upstream spells this as a macro binding a name over a body ---
; `(doseqres NONE [e structure] (next-fn e))` --- and vendored Specter
; code writes it that way, so the macro is the surface. `doseqres-fn` is
; the same reduction as an ordinary higher-order function, for callers
; who already have a function in hand and would rather not build syntax
; around it.
(defmacro doseqres [backup-res bindings & body]
  (let [n (get bindings 0)
        coll (get bindings 1)]
    `(doseqres-fn ~backup-res ~coll (fn [~n] ~@body))))

(defn doseqres-fn [backup-res coll f]
  (reduce
    (fn [curr x]
      (let [ret (f x)]
        (cond
          (identical? ret backup-res) curr
          (reduced? ret) (reduced ret)
          :else ret)))
    backup-res
    coll))

; --- select -----------------------------------------------------------
;
; Every navigated value, in navigation order. The fold replaces
; upstream's mutable cell: `compiled-traverse*` calls the collector once
; per value, and the collector appends.
;
; The collector returns NONE so that a navigator combining results sees
; "nothing selected here" and keeps walking --- returning the collection
; itself would look like a real selected value and stop the traversal at
; the first element.
(defn compiled-select* [path structure]
  (let [acc (volatile! [])]
    (compiled-traverse*
      path
      (fn [x] (vswap! acc conj x) NONE)
      structure)
    @acc))

; The first navigated value, or NONE when there is none. `reduced`
; short-circuits the traversal at the first hit, so this terminates on
; structures that `compiled-select*` would walk forever.
;
; The 3-arity threading `vals` is not decoration: `selected?*` is
; written against it, so a navigator that collected values can still be
; asked whether it selected anything. Porting only the 2-arity form
; looked complete and was not — vendored slice 06 found the gap by
; calling the arity that did not exist.
(defn compiled-select-any*
  ([path structure] (compiled-select-any* path [] structure))
  ([path vals structure]
   (unreduced
     (compiled-traverse-with-vals* path reduced vals structure))))

; Clojure's contract: nil when nothing was selected, rather than the
; sentinel leaking out to a caller who never agreed to know about it.
(defn compiled-select-first* [path structure]
  (let [ret (compiled-select-any* path structure)]
    (if (none? ret) nil ret)))

(defn compiled-selected-any? [path structure]
  (not (none? (compiled-select-any* path structure))))

; --- transform --------------------------------------------------------
;
; `terminal*` applies the user's function to a navigated value, passing
; any collected values ahead of it --- so a path that collected two
; values calls (f v1 v2 structure).
(defn terminal* [afn vals structure]
  (if (= vals [])
    (afn structure)
    (apply afn (conj vals structure))))

(defn compiled-transform* [nav transform-fn structure]
  (transform* nav [] structure
              (fn [vals structure] (terminal* transform-fn vals structure))))

; setval is transform with a function that ignores what it is given.
(defn compiled-setval* [path val structure]
  (compiled-transform* path (fn [_] val) structure))

; --- subrange transformation -----------------------------------------
;
; Replace [start, end) of a structure with the result of running
; `next-fn` over that slice, splicing the untouched prefix and suffix
; back around it.
;
; The vector/list distinction matters here in a way it does not upstream:
; beam-lisp keeps [] and () structurally distinct, so a transformed
; vector must come back a vector and a transformed list a list. Upstream
; has the same branch for the same reason, and it is the reason this
; function is not simply concat.
(defn srange-transform* [structure start end next-fn]
  (if (string? structure)
    (let [newss (next-fn (subs structure start end))]
      (str (subs structure 0 start)
           newss
           (subs structure end (count structure))))
    (let [structurev (vec structure)
          newpart (next-fn (subvec structurev start end))
          res (concat (subvec structurev 0 start)
                      newpart
                      (subvec structurev end (count structurev)))]
      (if (vector? structure) (vec res) res))))
