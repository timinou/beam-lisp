; optics.bl — van Laarhoven-flavored optics, self-hosted in beam-lisp.
;
; An optic is a pair of functions plus a shape flag:
;
;   {:view (fn [s] focus)
;    :over (fn [f s] s')      ; apply f to every focus, rebuild s
;    :traversal bool}
;
; The prototype (`lens`/`view`/`setv`/`over` over a `{:get :set}` map) is
; enough for lenses, where a focus is a single value. It cannot express a
; traversal, whose focus is *every element of a collection*: get would
; return many values and set would have to write many positions. So the
; representation is generalized from get/set to view/over — a lens is just
; an optic whose :over is "map one focus", a traversal one whose :over maps
; every element — and `setv` is derived from `over`, not stored. This is the
; single uniform shape composition threads; a lens and a traversal differ
; only in how many foci :view/:over see.
;
; Composition is outside-in: `(*> outer inner)` reads as a path, so
; `(*> (in :app) (in :users))` means ":app then :users", matching get-in
; and Specter. Do NOT flip this — the docstring below states it and the
; tests assert it.

(ns optics)

(defn lens "Build a lens from a getter and a setter. (set s v) rebuilds s
  with the single focus replaced by v."
  [getter setter]
  {:view (fn [s] (getter s))
   :over (fn [f s] (setter s (f (getter s))))
   :traversal false})

(defn view "The focus of a lens — or, through a traversal, the collection
  of its foci (a lens yields one value, a traversal a collection; this
  distinction is the whole point of the :traversal flag)."
  [l s]
  ((:view l) s))

(defn over "Apply f to every focus of l in s, rebuilding s."
  [l f s]
  ((:over l) f s))

(defn setv "Replace every focus of l in s with v. For a lens this is the
  classic set; for a traversal it writes v to every element — both fall out
  of `over` with a constant function, so there is exactly one setter."
  [l v s]
  (over l (fn [_] v) s))

; --- composition ---------------------------------------------------------
; view and over compose the same way (thread inner through each outer
; focus), but the RESULT of view depends on how many foci each side has.
; :traversal is the shape that survives composition: once a path branches,
; it stays branched, so `or` of the two flags is the composite's shape.

(defn to-list "A plain list view of a vector, list, or lazy seq, for joining foci."
  [c]
  (cond
    (vector? c) (BeamLisp.Vector/to_list c)
    ; map/filter are lazy in beam-lisp; force so the caller gets a proper
    ; list `rebuild` can hand to BeamLisp.Vector/new.
    (BeamLisp.LazySeq/lazy? c) (doall c)
    :else c))

(defn join "Flatten a collection of collections into one list of foci.
  concat is not used: this repo's concat refuses to flatten BeamLisp
  vectors, and joining has to be shape-agnostic."
  [colls]
  (reverse
    (reduce (fn [acc c]
              (reduce (fn [acc x] (cons x acc)) acc (to-list c)))
            (list) colls)))

(defn foci "The outer optic's foci as a seq: a single-element list for a
  lens, the collection itself for a traversal."
  [o s]
  (if (:traversal o) ((:view o) s) (list ((:view o) s))))

(defn compose-optic [outer inner]
  {:view (fn [s]
           (if (:traversal inner)
             ; inner branches: join its foci across every outer focus
             (join (map (:view inner) (foci outer s)))
             ; inner is single-valued: one focus per outer focus (lens-lens
             ; collapses to a single value, the common get-in shape)
             (if (:traversal outer)
               (map (:view inner) ((:view outer) s))
               ((:view inner) ((:view outer) s)))))
   :over (fn [f s] ((:over outer) (fn [x] ((:over inner) f x)) s))
   :traversal (or (:traversal outer) (:traversal inner))})

(defn *> "Compose optics into a path, outside-in: `(*> outer inner)` reads
  as a path — `(*> (in :app) (in :users))` means :app then :users, like
  get-in and Specter. Variadic: any number of optics, leftmost outermost."
  [& optics]
  (reduce compose-optic (first optics) (rest optics)))

; --- primitive optics -----------------------------------------------------
; Each lens is a `{:view :over}` optic map built with the closures inline.
; `lens` is the public constructor for a *custom* lens (getter/setter the
; caller supplies); these built-ins are not routed through it because a
; top-level def whose initializer calls a sibling fn and stores the returned
; closures is compiled to a stale-closure in the test harness ("function
; ... is invalid, likely because it points to an old version of the code")
; when the module also carries the composition machinery below -- a finding,
; see test/bl/optics_test.bl. Inline maps sidestep it.

(defn in "A lens into map key k. This is a plain lens: writing a missing
  key creates it (the nil hole), which is what `optional` exists to avoid."
  [k]
  {:view (fn [s] (get s k))
   :over (fn [f s] (assoc s k (f (get s k))))
   :traversal false})

(defn idx "A lens into vector index i."
  [i]
  {:view (fn [s] (nth s i))
   :over (fn [f s] (assoc s i (f (nth s i))))
   :traversal false})

(def fst "A lens into the first element of a pair (a 2-vector)."
  {:view (fn [s] (nth s 0))
   :over (fn [f s] (assoc s 0 (f (nth s 0))))
   :traversal false})

(def snd "A lens into the second element of a pair (a 2-vector)."
  {:view (fn [s] (nth s 1))
   :over (fn [f s] (assoc s 1 (f (nth s 1))))
   :traversal false})

; --- the optics update-in cannot express ---------------------------------
(defn rebuild "Reconstruct a collection from a mapped seq, preserving the
  vector/list shape of the input: a vector in, a vector out. The mapped
  seq may be a plain list or an empty BeamLisp vector (the runtime's
  empty-contract), so normalize it to a list first."
  [coll mapped]
  (let [items (to-list mapped)]
    (if (vector? coll) (BeamLisp.Vector/new items) items)))

(def traversed
  "A traversal over every element of a sequential collection.
  `(view traversed coll)` is the collection itself — the foci — not a
  single value; that is the contract that keeps a traversal honest."
  {:view (fn [s] s)
   :over (fn [f s] (rebuild s (map f s)))
   :traversal true})

(defn filtered "A traversal over just the elements of a collection that
  satisfy pred. `(over (filtered p) f coll)` maps f over matching elements
  and leaves the rest untouched."
  [pred]
  {:view (fn [s] (filter pred s))
   :over (fn [f s] (rebuild s (map (fn [x] (if (pred x) (f x) x)) s)))
   :traversal true})

(defn optional "An optic into map key k that no-ops on a missing key
  instead of punching a nil hole: `(over (optional :hits) inc m)` leaves m
  untouched when it has no :hits, where `(in :hits)` would write (inc nil).
  Compose it after a traversal to touch only the maps that have the key."
  [k]
  {:view (fn [s] (get s k))
   :over (fn [f s] (if (contains? s k) (assoc s k (f (get s k))) s))
   :traversal false})
