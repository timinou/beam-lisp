; fence.bl — bounded isolation: turn a child computation into a value.

(ns fence)

(defn- norm-opts [opts]
  (if (map? opts)
    {:ms (get opts :ms)
     :kill? (get opts :kill? true)}
    {:ms opts :kill? true}))

(defn fence-fn
  "Run `f` in a monitored child for at most `:ms` milliseconds.

   `opts` may be the timeout number or `{:ms n :kill? bool}`.
   Returns `{:ok value}`, `{:crash reason}`, or `{:timeout true}`. `:kill?`
   defaults true."
  [opts f]
  (let [{:keys [ms kill?]} (norm-opts opts)
        parent (erlang/self)
        [pid ref]
          (spawn-monitor
            (fn []
              (erlang/send parent [:fence-ok (erlang/self) (f)])))
        outcome
          (receive
            [:fence-ok reply-pid value]
              :when (= reply-pid pid)
              (do (erlang/demonitor ref (list :flush))
                  {:ok value})
            [:DOWN down-ref :process _down-pid reason]
              :when (= down-ref ref)
              (do (erlang/demonitor ref (list :flush))
                  {:crash reason})
            (after ms
              (do (when kill? (erlang/exit pid :kill))
                  (erlang/demonitor ref (list :flush))
                  {:timeout true})))]
    outcome))

(defmacro fence [opts & body]
  `(fence/fence-fn ~opts (fn [] ~@body)))
