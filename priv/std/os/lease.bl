;; Local Unix ownership, held by an OS descriptor rather than a timestamp.
;; A port owns the helper's stdin. Owner/VM death closes it and releases flock.
;; The persistent lock inode is NEVER unlinked. No caller-supplied shell text.
(ns os.lease)
(defn release! [lease]
 (when-let [port (:port lease)]
  (try (erlang/port_close port) (catch _ nil)))
 :ok)
(defn acquire!
 "Nonblocking local filesystem lease. Busy/unsupported/error never grants
  ownership. Requires util-linux flock and a POSIX shell on PATH; no FHS /bin helpers."
 [path]
 (let [executable (System/find_executable "flock")
       shell (System/find_executable "sh")]
 (if (and executable shell)
  (try
   (let [port (erlang/open_port (tuple :spawn_executable (String/to_charlist executable))
                (list :binary :exit_status :use_stdio
                  (tuple :args (list "--no-fork" "--nonblock" "--" path
                     shell "-c" "printf 'leased\\n'; while IFS= read -r line; do :; done"))))]
    (receive
     [p [:data "leased\n"]] :when (= p port) {:ok {:port port :path path}}
     [p [:exit_status status]] :when (= p port) {:error (if (= status 1) :busy [:helper-exit status])}
     (after 1000 (do (release! {:port port}) {:error :lease-timeout}))))
   (catch e {:error :lease-unavailable}))
  {:error :lease-unsupported})))
(defn transfer! [lease owner]
 "Transfer lifetime to the endpoint owner. Failure grants no ownership."
 (erlang/port_connect (:port lease) owner)
 (when (not= owner (erlang/self)) (erlang/unlink (:port lease)))
 lease)
(defn with-lease [path action]
 (let [r (acquire! path)]
  (if-let [lease (:ok r)]
   (try (action) (finally (release! lease))) r)))
