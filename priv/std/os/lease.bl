;; Local ownership through the mandatory native file-lock descriptor. A small
;; BEAM keeper retains the resource, follows its owner, and acknowledges release
;; only after closing the descriptor. No shell or external lock utility is used.
;; Persistent lock inodes are never unlinked.
(ns os.lease)

(defn- hold! [resource owner watch token]
 (receive
  [seen request caller :release] :when (= seen token)
   (do (BeamLisp.LazyMemo/nif_file_unlock resource)
       (erlang/unlink owner) (erlang/demonitor watch (list :flush))
       (erlang/send caller [request :ok]))
  [seen request caller [:transfer next]] :when (= seen token)
   (if (and (erlang/is_pid next) (= (erlang/node next) (erlang/node)) (Process/alive? next))
    (let [next-watch (erlang/monitor :process next)]
     (when-not (= next owner) (erlang/link next) (erlang/unlink owner))
     (erlang/demonitor watch (list :flush))
     (erlang/send caller [request :ok])
     (recur resource next next-watch token))
    (do (erlang/send caller [request {:error :invalid-lease-owner}])
        (recur resource owner watch token)))
  [:DOWN ref _ _ _] :when (= ref watch) :ok
  [:EXIT _ _] (recur resource owner watch token)))

(defn- keeper! [path owner token]
 (Process/flag :trap_exit true)
 (erlang/link owner)
 (let [watch (erlang/monitor :process owner)
       r (try (BeamLisp.LazyMemo/nif_file_lock path false true)
          (catch _ (tuple :error nil)))]
  (if (= :ok (elem r 0))
   (let [resource (elem r 1)]
    (try
     (erlang/send owner [token {:ok {:keeper (erlang/self) :token token :path path}}])
     (hold! resource owner watch token)
     (finally (BeamLisp.LazyMemo/nif_file_unlock resource))))
   (erlang/send owner [token {:error (if (= :busy (elem r 0)) :busy :lease-unavailable)}]))))

(defn acquire!
 "Take a nonblocking local filesystem lease. Owner or VM death releases it;
  a paused owner retains it. Works with the shipped native runtime on Unix."
 [path]
 (BeamLisp.LazyMemo/ensure_loaded!)
 (let [path (Path/expand path (BeamLisp/cwd)) token (erlang/make_ref)
       owner (erlang/self)
       child (erlang/spawn_monitor (fn [] (keeper! path owner token)))
       keeper (elem child 0) watch (elem child 1)]
  (try
   (receive
    [seen result] :when (= seen token) result
    [:DOWN ref _ _ _] :when (= ref watch) {:error :lease-unavailable}
    (after 5000 (do (erlang/unlink keeper) (erlang/exit keeper :kill) {:error :lease-timeout})))
   (finally (erlang/demonitor watch (list :flush))))))

(defn- control! [lease operation]
 (let [keeper (:keeper lease) request (erlang/make_ref)
       watch (erlang/monitor :process keeper)]
  (try
   (erlang/send keeper [(:token lease) request (erlang/self) operation])
   (receive
    [ref result] :when (= ref request) result
    [:DOWN ref _ _ _] :when (= ref watch) :closed
    (after 5000 {:error :lease-timeout}))
   (finally (erlang/demonitor watch (list :flush))))))

(defn release! [lease]
 (when (:keeper lease)
  (let [r (control! lease :release)]
   (when-not (contains? #{:ok :closed} r)
    (throw (ex-info "Lease release failed" r)))))
 :ok)

(defn transfer!
 "Transfer lifetime to a local owner, acknowledging its monitor before return."
 [lease owner]
 (let [r (control! lease [:transfer owner])]
  (when-not (= :ok r) (throw (ex-info "Lease transfer failed" {:result r})))
  lease))

(defn with-lease [path action]
 (let [r (acquire! path)]
  (if-let [lease (:ok r)]
   (try (action) (finally (release! lease))) r)))
