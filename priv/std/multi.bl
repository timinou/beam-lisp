; multi.bl — convenience wrappers for open dispatch (multimethods &
; protocols). The dispatch machinery itself lives in special forms
; (defmulti/defmethod/defprotocol/extend-type/extend-protocol) and in
; BeamLisp.Multi; this file only pretties up the hierarchy helpers so
; callers can write (derive :cat :animal) instead of
; (BeamLisp.Multi/derive (BeamLisp.Env/current_ns) :cat :animal).
;
; Loaded on demand (the test suite requires it before the hierarchy
; tests); a one-line startup hook would fold it into the prelude so it
; is always available.
(ns multi)

; Hierarchy relations act on the *current* namespace's hierarchy, so
; the wrappers thread Env.current_ns for you.

(defn derive "Record child as derived from parent. Returns true."
  [child parent]
  (BeamLisp.Multi/derive (BeamLisp.Env/current_ns) child parent))

(defn isa? "True when x is y or transitively derived from y."
  [x y]
  (BeamLisp.Multi/isa? (BeamLisp.Env/current_ns) x y))

(defn parents "The direct parents of x in the hierarchy."
  [x]
  (BeamLisp.Multi/parents (BeamLisp.Env/current_ns) x))

(defn ancestors "All transitive ancestors of x in the hierarchy."
  [x]
  (BeamLisp.Multi/ancestors (BeamLisp.Env/current_ns) x))

(defn underive "Remove child's derivation from parent. Returns false."
  [child parent]
  (BeamLisp.Multi/underive (BeamLisp.Env/current_ns) child parent))

(defn type-of "The type tag a protocol dispatches on for a value."
  [x]
  (BeamLisp.Multi/type_of x))

(defn method-keys
  "The dispatch keys registered for multimethod `ns`/`name` right now (source
   AND runtime-added), or [] when no such multimethod exists. The reload
   migration verifier fuses these with source `defmethod` forms so a dispatch
   table extended at runtime is enumerated, its source-absent arms reported
   :approximate."
  [ns name]
  (BeamLisp.Multi/method_keys ns name))
