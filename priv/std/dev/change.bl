; dev/change.bl — thin language wrapper over BeamLisp.DevChange.
;
; Planning, verification, application, and undo policy live in the host module;
; this namespace only exposes the host API under a beam-lisp namespace.

(ns dev.change)

(defn plan
  "Build a hash-guarded change plan from a specification map."
  [spec]
  (BeamLisp.DevChange/plan spec))

(defn preview
  "Render the candidate diff and diagnostics from a change plan."
  [plan]
  (BeamLisp.DevChange/preview plan))

(defn verify
  "Verify a plan in an isolated workspace; `opts` pass through to the host."
  ([plan] (BeamLisp.DevChange/verify plan))
  ([plan opts] (BeamLisp.DevChange/verify plan opts)))

(defn apply!
  "Apply a verified plan with its receipt and authorization map."
  [plan receipt auth]
  (BeamLisp.DevChange/apply! plan receipt auth))

(defn receipt
  "Read a durable change receipt by id from a workspace."
  [id workspace]
  (BeamLisp.DevChange/receipt id workspace))

(defn undo!
  "Plan an inverse change for a receipt, subject to authorization."
  [id auth workspace]
  (BeamLisp.DevChange/undo! id auth workspace))

