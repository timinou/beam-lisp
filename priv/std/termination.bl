; termination.bl — L13, graduated — P15d: termination for loop/recur.
;
; The rule under test: a (recur …) is ACCEPTED when its argument is
; provably shrinking along a measure, REJECTED with the counterexample
; path otherwise, and a ^{:decreasing …} annotation on the loop is the
; trusted escape hatch (L13).
;
; Shrinking, spike scope (sound — acceptance means the rule PROVED it):
;   (dec x) / (- x <positive-literal>)   — x an int-bound loop var
;   (rest xs) / (next xs)                — a seq-bound loop var
; Loop var boundness comes from the loop's binding vector; the var's
; initial LITERAL decides int vs seq. Anything else (identity, inc, a
; var-free expr, an unknown fn call) is not provably shrinking →
; rejected, with the failing recur form printed.
;
; The measure annotation: ^{:decreasing expr} on the loop's binding
; vector trusts the author's measure — the spike records it as accepted
; and reports WHICH measure was trusted (auditable, not silent).

(ns termination
  (:require [typed] [errors]))

(defn- unwrap [n] (typed/node-form n))

(defn head-sym [node]
  (if (and (= :list (typed/node-tag node))
           (not (empty? (typed/node-items node)))
           (= :symbol (typed/node-tag (unwrap (first (typed/node-items node))))))
    (typed/node-name (unwrap (first (typed/node-items node))))
    nil))

(defn- literal-kind
  "The init form's kind: :int, :seq, or :unknown."
  [node]
  (let [n (unwrap node)]
    (cond
      (int? n) :int
      (= :vector (typed/node-tag n)) :seq
      (and (= :list (typed/node-tag n))
           (= "quote" (head-sym n))) :seq
      :else :unknown)))

(defn- self-arg?
  "Is `node` the loop var `v` itself (a bare symbol reference)?"
  [node v]
  (and (= :symbol (typed/node-tag (unwrap node)))
       (= v (typed/node-name (unwrap node)))))

(defn measure-dir
  "The direction `node` moves loop var `v` (kind k) along a well-founded
   measure: :down (toward 0 / empty), :up (away from 0 by a positive literal —
   well-founded ONLY against an upper-bound guard, which check-loop verifies),
   or nil (not a measure move). Generalises the old boolean `shrinking-expr?`:
   :down is exactly the cases it accepted, :up is the counted-UP idiom
   (for i=0; i<n; i++) that a bounded loop uses — the checksum/blend/pixel shape.
   Well-foundedness of :up is NOT local: it needs the guard to bound v from
   above, so measure-dir only reports the shape and check-loop discharges the
   bound obligation."
  [node v k]
  (let [n (unwrap node)
        h (head-sym n)]
    (if (nil? h)
      nil
      (let [args (rest (typed/node-items n))]
        ; Shape, not kind: (dec v)/(rest v) shrink toward a floor; (inc v)/
        ; (+ v +k) grow toward a ceiling. Kind-correctness is the type
        ; checker's obligation (P1); we own the measure shape only.
        (cond
          (and (= h "dec") (= 1 (count args)) (self-arg? (first args) v)) :down
          (and (= h "inc") (= 1 (count args)) (self-arg? (first args) v)) :up
          (and (= h "-") (= 2 (count args)) (self-arg? (first args) v)
               (int? (unwrap (nth args 1))) (> (unwrap (nth args 1)) 0)) :down
          (and (= h "+") (= 2 (count args)) (self-arg? (first args) v)
               (int? (unwrap (nth args 1))) (> (unwrap (nth args 1)) 0)) :up
          ; (+ k v) — commuted literal-first form
          (and (= h "+") (= 2 (count args)) (self-arg? (nth args 1) v)
               (int? (unwrap (first args))) (> (unwrap (first args)) 0)) :up
          (and (contains? #{"rest" "next"} h) (= 1 (count args))
               (self-arg? (first args) v)) :down
          :else nil)))))

(defn shrinking-expr?
  "Back-compat boolean: a :down move (the original count-DOWN measures). The
   count-UP direction is well-founded only against a bound, so it is NOT
   reported here — callers wanting the general measure use `measure-dir`."
  [node v k]
  (= :down (measure-dir node v k)))

(declare find-recurs)

(defn find-recurs
  "All (recur …) forms under node (not descending into nested loop/fn —
   those are their own obligations)."
  [node acc]
  (let [n (unwrap node)
        tag (typed/node-tag n)]
    (cond
      (= tag :list)
        (let [h (head-sym n)]
          (cond
            (= h "recur") (conj acc n)
            (contains? #{"loop" "fn"} h) acc
            :else (reduce (fn [a x] (find-recurs x a)) acc (typed/node-items n))))
      (contains? #{:vector :set} tag)
        (reduce (fn [a x] (find-recurs x a)) acc (typed/node-items n))
      (= tag :map)
        (reduce (fn [a p] (find-recurs (second (erlang/tuple_to_list p)) a))
                acc (typed/node-items n))
      :else acc)))

(defn- cmp-bounds-above
  "Given a comparison (op a b), the var name it bounds ABOVE, or nil. A var v is
   bounded above by: (< v E) (<= v E) (> E v) (>= E v). E is any expression —
   soundness needs only that v cannot grow without bound before the guard fails.
   (For the counted loop the guard is the loop test itself; E is the length.)"
  [node]
  (let [n (unwrap node)
        h (head-sym n)]
    (if (nil? h) nil
      (let [args (rest (typed/node-items n))]
        (if (not= 2 (count args)) nil
          (let [a (first args) b (second args)
                a-sym (= :symbol (typed/node-tag (unwrap a)))
                b-sym (= :symbol (typed/node-tag (unwrap b)))
                a-nm (if a-sym (typed/node-name (unwrap a)) nil)
                b-nm (if b-sym (typed/node-name (unwrap b)) nil)]
            (cond
              (contains? #{"<" "<="} h) (if a-sym a-nm nil)   ; v < E → v bounded above
              (contains? #{">" ">="} h) (if b-sym b-nm nil)   ; E > v → v bounded above
              :else nil)))))))

(declare upper-bounded-vars)

(defn upper-bounded-vars
  "The set of loop-var names bounded ABOVE by some `if`/`when`/`and` guard in a
   loop body — a count-UP measure on such a var is well-founded (it cannot grow
   past the bound before the guard fails and the loop returns). Collected
   structurally over every guard test reachable in the body."
  [node]
  (let [n (unwrap node)
        tag (typed/node-tag n)]
    (cond
      (= tag :list)
        (let [h (head-sym n)
              items (typed/node-items n)]
          (cond
            ; (if TEST then else) / (when TEST …): TEST is a guard — harvest bounds,
            ; then recurse into the branches (nested loops guard their own vars).
            (contains? #{"if" "when" "when-not"} h)
              (let [test (second items)
                    here (let [th (head-sym (unwrap test))]
                           (if (= th "and")
                             ; conjunction of guards: each conjunct may bound a var
                             (reduce (fn [acc c] (let [v (cmp-bounds-above c)]
                                                   (if (nil? v) acc (conj acc v))))
                                     #{} (rest (typed/node-items (unwrap test))))
                             (let [v (cmp-bounds-above test)]
                               (if (nil? v) #{} #{v}))))]
                (reduce (fn [acc x] (into acc (upper-bounded-vars x)))
                        here (rest (rest items))))
            ; don't descend into a NESTED loop/fn — its guards bind its own vars
            (contains? #{"loop" "fn"} h) #{}
            :else
              (reduce (fn [acc x] (into acc (upper-bounded-vars x))) #{}
                      (typed/node-items n))))
      (contains? #{:vector :set} tag)
        (reduce (fn [acc x] (into acc (upper-bounded-vars x))) #{} (typed/node-items n))
      (= tag :map)
        (reduce (fn [acc p] (into acc (upper-bounded-vars (second (erlang/tuple_to_list p)))))
                #{} (typed/node-items n))
      :else #{})))

(defn check-loop
  "The termination verdict for one loop form. Returns
   {:status :accepted|:rejected|:trusted :detail …}."
  [node]
  (let [items (typed/node-items node)
        bindings-node (second items)
        ; ^{:decreasing …} on the bindings vector is the escape hatch
        bmeta (if (= :meta (typed/node-tag bindings-node))
                (nth (erlang/tuple_to_list bindings-node) 2)
                nil)
        decreasing (if (and (map? bmeta) (contains? bmeta :decreasing))
                     (:decreasing bmeta)
                     nil)]
    (if (some? decreasing)
      {:status :trusted :detail (str "trusted measure: " (errors/delaborate decreasing))}
      (let [bs (typed/node-items (unwrap bindings-node))
            vars (loop [xs bs m {}]
                   (if (empty? xs)
                     m
                     (let [b (first xs)
                           init (second xs)]
                       (recur (rest (rest xs))
                              (if (= :symbol (typed/node-tag (unwrap b)))
                                (assoc m (typed/node-name (unwrap b))
                                         (literal-kind init))
                                m)))))
            ; loop-var NAME by position, so a recur arg maps back to its var
            var-name (fn [i] (let [b (nth bs (* 2 i))]
                               (if (= :symbol (typed/node-tag (unwrap b)))
                                 (typed/node-name (unwrap b)) nil)))
            nvars (erlang/div (count bs) 2)
            body (rest (rest items))
            ; the guards that gate each recur: an (if <test> …) whose branch
            ; contains the recur. bounded-above collects vars v with a guard
            ; (< v E) / (<= v E) / (> E v) / (>= E v) — v is bounded from above,
            ; making a count-UP measure on v well-founded.
            ; harvest guard bounds from the loop BODY (not the loop node itself —
            ; that would hit the nested-loop guard and see nothing)
            bounded-above (reduce (fn [acc b] (into acc (upper-bounded-vars b)))
                                  #{} body)
            recurs (reduce (fn [a b] (find-recurs b a)) [] body)
            ; A loop TERMINATES when SOME ranking variable is well-founded on
            ; EVERY recur: it moves monotonically toward a fixed endpoint. This
            ; is the ∃-ranking rule (Floyd) — accumulators need not shrink, only
            ; the ranking var must. A :down move is always well-founded; a :up
            ; move is well-founded iff the guard bounds that var above.
            wf-on-all? (fn [vi]
                         (let [v (var-name vi)]
                           (and (some? v)
                                (every?
                                  (fn [r]
                                    (let [args (rest (typed/node-items r))]
                                      (if (< vi (count args))
                                        (let [dir (measure-dir (nth args vi) v
                                                               (get vars v :unknown))]
                                          (or (= dir :down)
                                              (and (= dir :up)
                                                   (contains? bounded-above v))))
                                        false)))
                                  recurs))))
            ranking (filter wf-on-all? (range nvars))]
        (if (empty? recurs)
          {:status :accepted :detail "no recur — trivially terminating"}
          (if (not (empty? ranking))
            {:status :accepted
             :detail (str "ranking variable: " (var-name (first ranking))
                          " (well-founded on every recur)")}
            {:status :rejected
             :detail (str "no ranking variable — every loop var either fails to "
                          "move toward a fixed endpoint or (counting up) lacks a "
                          "bounding guard: " (errors/delaborate (first recurs)))}))))))

(defn check-source
  "Verdicts for every top-level (and nested-in-defn) loop in src."
  [src]
  (let [forms (BeamLisp.Reader/read_string src)]
    (reduce
      (fn [acc form]
        (concat acc (find-loops form)))
      [] forms)))

(defn find-loops
  "All loop forms under node, with their verdicts."
  [node]
  (let [n (unwrap node)
        tag (typed/node-tag n)]
    (cond
      (= tag :list)
        (let [h (head-sym n)
              here (if (= h "loop") [(check-loop n)] [])
              kids (reduce (fn [a x] (concat a (find-loops x))) []
                           (typed/node-items n))]
          (concat here kids))
      (contains? #{:vector :set} tag)
        (reduce (fn [a x] (concat a (find-loops x))) [] (typed/node-items n))
      (= tag :map)
        (reduce (fn [a p] (concat a (find-loops (second (erlang/tuple_to_list p)))))
                [] (typed/node-items n))
      :else [])))
