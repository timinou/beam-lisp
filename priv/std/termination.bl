; termination.bl — L13, P15d: termination for loop/recur, computed over bl-ANF.
;
; The rule: a loop TERMINATES when SOME ranking variable is well-founded on
; EVERY back-edge — it moves monotonically toward a fixed endpoint (∃-ranking,
; Floyd). Accumulators need not shrink; only the ranking var must. A ^{:decreasing}
; measure on the loop is the trusted escape hatch (L13).
;
; Shrinking, spike scope (sound — acceptance means the rule PROVED it):
;   (dec x) / (- x <pos-lit>)   count-DOWN, x an int loop var
;   (rest xs) / (next xs)       a seq loop var
;   (inc x) / (+ x <pos-lit>)   count-UP, well-founded ONLY against an
;                               upper-bound guard (< x E) / (> E x)
;
; ── Why over bl-ANF ────────────────────────────────────────────────────
;
; The compiler desugars `loop`/`recur` to a Y-combinator self-application:
;
;   (loop [i INIT] BODY)  →  ( (let [loop_N (fn [self] (fn [i] BODY'))]
;                                 (let loop_N ...) )    INIT )
;   (recur V)             →  ((apply loop_N [loop_N]) [V])
;
; where BODY' is BODY with every op resolved. Reading the IR means the measure
; check sees the SAME resolved arithmetic (`:remote :erlang :dec` etc.) the
; backend emits, and recognises the shape regardless of the surface macro that
; produced it. The loop-var names and the ranking logic are recovered from the
; scaffold. `check-loop`/`check-source` keep their surface signatures: they
; compile the loop form to ANF, then run the ANF recogniser.

(ns termination
  (:require [system.ir :as ir] [compiler :as c] [errors] [typed]))

(def compile-env (c/new-env "termination"))

(defn- to-anf [surface-node] (c/compile-node surface-node compile-env))

; ── scaffold recognition ─────────────────────────────────────────────
;
; A compiled loop is (apply SCAFFOLD INIT-args) where SCAFFOLD is a
; (let [loop_N (fn [self] INNER)] INNER). INNER is (fn [v0 v1 …] LOOP-BODY).
; We extract: the self name loop_N, the loop-var names, and LOOP-BODY.

(defn- self-fn?
  "Is `n` a single-clause fn of one pvar (the `self` wrapper)?"
  [n]
  (and (= :fn (:op n)) (= 1 (count (:clauses n)))
       (= 1 (count (:pats (first (:clauses n)))))))

(defn anf-loop?
  "Is `n` a compiled loop scaffold? (apply (let loop_N (fn [self] (fn [vars] body)) …) inits)"
  [n]
  (and (= :apply (:op n))
       (let [f (:fn n)]
         (and (= :let (:op f))
              (self-fn? (:init f))
              (let [inner (:body (first (:clauses (:init f))))]
                (= :fn (:op inner)))))))

(defn- loop-parts
  "{:self :vars :body :inits} of a recognised loop scaffold."
  [n]
  (let [f (:fn n)
        self (:name f)
        inner (:body (first (:clauses (:init f))))
        clause (first (:clauses inner))
        vars (map :name (:pats clause))]
    {:self self :vars vars :body (:body clause) :inits (:args n)}))

; ── recur (back-edge) detection ───────────────────────────────────────
;
; A recur to loop_N is (apply (apply (var loop_N) [(var loop_N)]) NEW-VALS).
; Its NEW-VALS are the positional next values of the loop vars.

(defn- recur-to?
  [n self]
  (and (= :apply (:op n))
       (let [g (:fn n)]
         (and (= :apply (:op g))
              (= :var (:op (:fn g)))
              (= self (:name (:fn g)))))))

(defn- find-recurs
  "Every recur (back-edge) to `self` under `n`, not descending into a NESTED
   loop scaffold (its recurs are its own obligation). Returns list of NEW-VALS."
  [self n]
  (cond
    (not (ir/node? n)) (list)
    (recur-to? n self) (list (:args n))
    (anf-loop? n) (list)               ; nested loop: its own obligation
    :else (mapcat (fn [c] (find-recurs self c)) (ir/child-nodes n))))

; ── measure direction over ANF ──────────────────────────────────────

(def core :Elixir.BeamLisp.Ns.Core)
(def rt   :Elixir.BeamLisp.RT)

(defn- self-var? [n v] (and (= :var (:op n)) (= v (:name n))))
(defn- pos-lit? [n] (and (= :lit (:op n)) (int? (:val n)) (> (:val n) 0)))

(defn measure-dir
  "The direction ANF node `node` moves loop var `v`: :down (toward a floor),
   :up (away by a positive literal — well-founded only against an upper bound),
   or nil. Reads the resolved [mod fun] the compiler emitted."
  [node v]
  (if (not (= :remote (:op node)))
    nil
    (let [k [(:mod node) (:fun node)] args (:args node)]
      (cond
        (and (= k [core :dec]) (= 1 (count args)) (self-var? (first args) v)) :down
        (and (= k [core :inc]) (= 1 (count args)) (self-var? (first args) v)) :up
        (and (= k [:erlang :-]) (= 2 (count args)) (self-var? (first args) v) (pos-lit? (nth args 1))) :down
        (and (= k [:erlang :+]) (= 2 (count args)) (self-var? (first args) v) (pos-lit? (nth args 1))) :up
        (and (= k [:erlang :+]) (= 2 (count args)) (self-var? (nth args 1) v) (pos-lit? (first args))) :up
        (and (contains? #{[rt :rest] [rt :next]} k) (= 1 (count args)) (self-var? (first args) v)) :down
        :else nil))))

(defn shrinking-expr?
  "Back-compat boolean: a :down move (count-DOWN measures)."
  [node v]
  (= :down (measure-dir node v)))

; ── upper-bound harvesting over ANF ──────────────────────────────────
;
; A count-UP var is well-founded iff a guard bounds it above. Over ANF a guard
; is the :test of an :if; the comparison is a :remote to erlang </<=/>/>=.

(defn- cmp-bounds-above
  "The var name a comparison node bounds ABOVE, or nil: (< v E)/(<= v E) bound v;
   (> E v)/(>= E v) bound v."
  [node]
  (if (not (= :remote (:op node)))
    nil
    (let [k (:fun node) mod (:mod node) args (:args node)]
      (if (or (not= mod :erlang) (not= 2 (count args)))
        nil
        (let [a (first args) b (second args)
              a-nm (if (= :var (:op a)) (:name a) nil)
              b-nm (if (= :var (:op b)) (:name b) nil)]
          (cond
            (contains? #{:< :=<} k) a-nm     ; erlang :< / :=< : v < E → v bounded above
            (contains? #{:> :>=} k) b-nm     ; E > v → v bounded above
            :else nil))))))

(defn- upper-bounded-vars
  "Loop-var names bounded ABOVE by some guard in `node`. An :if :test is a
   guard; an :erlang :andalso/:and conjunction bounds via any conjunct."
  [node]
  (cond
    (not (ir/node? node)) #{}
    (= :if (:op node))
      (let [test (:test node)
            here (if (and (= :remote (:op test)) (contains? #{:andalso :and} (:fun test)) (= :erlang (:mod test)))
                   (reduce (fn [acc c] (let [v (cmp-bounds-above c)] (if (nil? v) acc (conj acc v))))
                           #{} (:args test))
                   (let [v (cmp-bounds-above test)] (if (nil? v) #{} #{v})))]
        (reduce (fn [acc x] (into acc (upper-bounded-vars x))) here
                (list (:then node) (:else node))))
    (anf-loop? node) #{}                      ; nested loop guards its own vars
    :else (reduce (fn [acc x] (into acc (upper-bounded-vars x))) #{} (ir/child-nodes node))))

; ── the verdict ────────────────────────────────────────────────────

(defn check-anf-loop
  "Termination verdict for a recognised ANF loop scaffold node."
  [n]
  (let [{:keys [self vars body]} (loop-parts n)
        bounded (upper-bounded-vars body)
        recurs (find-recurs self body)
        nvars (count vars)
        var-at (fn [i] (nth (apply list vars) i))
        wf-on-all? (fn [vi]
                     (let [v (var-at vi)]
                       (every? (fn [newvals]
                                 (if (< vi (count newvals))
                                   (let [dir (measure-dir (nth newvals vi) v)]
                                     (or (= dir :down)
                                         (and (= dir :up) (contains? bounded v))))
                                   false))
                               recurs)))
        ranking (filter wf-on-all? (range nvars))]
    (if (empty? recurs)
      {:status :accepted :detail "no recur — trivially terminating"}
      (if (not (empty? ranking))
        {:status :accepted
         :detail (str "ranking variable: " (var-at (first ranking))
                      " (well-founded on every recur)")}
        {:status :rejected
         :detail (str "no ranking variable — every loop var either fails to move "
                      "toward a fixed endpoint or (counting up) lacks a bounding guard")}))))

(defn check-loop
  "The termination verdict for one SURFACE loop form. A ^{:decreasing …} measure
   on the bindings vector is the trusted escape hatch; otherwise the form is
   compiled to bl-ANF and the scaffold recogniser runs. Returns
   {:status :accepted|:rejected|:trusted :detail …}."
  [surface-node]
  (let [items (typed/node-items surface-node)
        bindings-node (second items)
        bmeta (if (= :meta (typed/node-tag bindings-node))
                (nth (erlang/tuple_to_list bindings-node) 2) nil)
        decreasing (if (and (map? bmeta) (contains? bmeta :decreasing)) (:decreasing bmeta) nil)]
    (if (some? decreasing)
      {:status :trusted :detail (str "trusted measure: " (errors/delaborate decreasing))}
      (let [anf (to-anf surface-node)]
        (if (anf-loop? anf)
          (check-anf-loop anf)
          {:status :accepted :detail "no recur — trivially terminating"})))))

; ── source-level driver ────────────────────────────────────────────
;
; find-loops walks the SURFACE tree to locate loop forms (their source position
; is what an error renders against), then check-loop compiles each. Keeping the
; location walk on the surface tree preserves the reported line/col.

(defn- s-unwrap [n] (typed/node-form n))
(defn- s-head [node]
  (if (and (= :list (typed/node-tag node))
           (not (empty? (typed/node-items node)))
           (= :symbol (typed/node-tag (s-unwrap (first (typed/node-items node))))))
    (typed/node-name (s-unwrap (first (typed/node-items node))))
    nil))

(defn find-loops
  "All surface loop forms under node, with their verdicts."
  [node]
  (let [n (s-unwrap node)
        tag (typed/node-tag n)]
    (cond
      (= tag :list)
        (let [h (s-head n)
              here (if (= h "loop") [(check-loop n)] [])
              kids (reduce (fn [a x] (concat a (find-loops x))) [] (typed/node-items n))]
          (concat here kids))
      (contains? #{:vector :set} tag)
        (reduce (fn [a x] (concat a (find-loops x))) [] (typed/node-items n))
      (= tag :map)
        (reduce (fn [a p] (concat a (find-loops (second (erlang/tuple_to_list p))))) [] (typed/node-items n))
      :else [])))

(defn check-source
  "Verdicts for every top-level (and nested-in-defn) loop in src."
  [src]
  (let [forms (BeamLisp.Reader/read_string src)]
    (reduce (fn [acc form] (concat acc (find-loops form))) [] forms)))
