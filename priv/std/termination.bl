; termination.bl — L13, P15d: termination for loop/recur, computed over bl-ANF.
;
; The rule: a loop TERMINATES when SOME ranking variable is well-founded on
; EVERY back-edge — it moves monotonically toward a fixed endpoint (∃-ranking,
; Floyd). Accumulators need not shrink; only the ranking var must. A ^{:decreasing}
; measure on the loop is the trusted escape hatch (L13).
;
; Shrinking, spike scope (sound — acceptance means the rule PROVED it):
;   (dec x) / (- x <pos-lit>)   count-DOWN, x an int loop var
;   (rest xs) / (next xs)       a seq loop var KNOWN NON-EMPTY on the recur's
;                               path (`(seq xs)`, `(not (empty? xs))`, or for
;                               `next` a truthy xs) — `(rest [])` is `()`,
;                               truthy and no shorter. Sequences are finite
;                               values; an infinite lazy seq is not one.
;   (inc x) / (+ x <pos-lit>)   count-UP, well-founded ONLY against an
;                               upper-bound guard (< x E) / (> E x)
;
; ── Why over bl-ANF ────────────────────────────────────────────────────
;
; The compiler desugars `loop`/`recur` to a Y-combinator self-application:
;
;   (loop [i INIT] BODY)  →  ( (let [loop_N (fn [self] (fn [i] BODY'))]
;                                 (let loop_N ...) )    INIT )
;   (recur V)             →  ((apply loop_N [loop_N]) [V])
;
; where BODY' is BODY with every op resolved. Reading the IR means the measure
; check sees the SAME resolved arithmetic (`:remote :erlang :dec` etc.) the
; backend emits, and recognises the shape regardless of the surface macro that
; produced it. The loop-var names and the ranking logic are recovered from the
; scaffold. `check-loop`/`check-source` keep their surface signatures: they
; compile the loop form to ANF, then run the ANF recogniser.

(ns termination
  (:require [system.ir :as ir] [compiler :as c] [errors]))

(def compile-env (c/new-env "termination"))

; ── scaffold recognition ─────────────────────────────────────────────
;
; The loop→Y-combinator scaffold recognisers (anf-loop?, loop-parts, recur?)
; live in the shared substrate system.ir — footprint reads them too, so there
; is ONE recogniser, not one per engine.

; ── measure direction over ANF ──────────────────────────────────────

(def core :Elixir.BeamLisp.Ns.Core)
(def rt   :Elixir.BeamLisp.Ns.Rt)

(defn- fn-name-str
  "A fn name as its string form, whether the ANF carries it as a keyword or a
   binary."
  [k] (if (keyword? k) (name k) (str k)))

(defn- self-var? [n v] (and (= :var (:op n)) (= v (:name n))))
(defn- pos-lit? [n] (and (= :lit (:op n)) (int? (:val n)) (pos? (:val n))))

(defn measure-dir
  "The direction ANF node `node` moves loop var `v`: :down (toward a floor),
   :up (away by a positive literal — well-founded only against an upper bound),
   or nil. Reads the resolved [mod fun] the compiler emitted."
  [node v]
  (let [node (ir/arith-bif node)]
  (if (not (= :remote (:op node)))
    nil
    (let [k [(:mod node) (:fun node)] args (:args node)]
      (cond
        (and (= k [core :dec]) (= 1 (count args)) (self-var? (first args) v)) :down
        (and (= k [core :inc]) (= 1 (count args)) (self-var? (first args) v)) :up
        (and (= k [:erlang :-]) (= 2 (count args)) (self-var? (first args) v) (pos-lit? (nth args 1))) :down
        (and (= k [:erlang :+]) (= 2 (count args)) (self-var? (first args) v) (pos-lit? (nth args 1))) :up
        (and (= k [:erlang :+]) (= 2 (count args)) (self-var? (nth args 1) v) (pos-lit? (first args))) :up
        (and (contains? #{[rt :rest] [rt :next]} k) (= 1 (count args)) (self-var? (first args) v)) :down
        :else nil)))))

(defn shrinking-expr?
  "Back-compat boolean: a :down move (count-DOWN measures)."
  [node v]
  (= :down (measure-dir node v)))

; ── the verdict ────────────────────────────────────────────────────

; ── path guards: what is KNOWN where a recur happens ──────────────────────
;
; A measure is well-founded only if the recur that moves it is GUARDED on its
; own path: a count-down var must be known bounded BELOW where it recurs (else
; `(loop [i 0] (recur (dec i)))` runs forever), a count-up var bounded ABOVE.
; Facts come from the tests of the `if`s enclosing the recur: the THEN branch
; knows the test, the ELSE branch knows its negation.

; ── loop invariance: which values CANNOT move between iterations ─────────────
;
; A bound proves nothing if it moves with the measure: `(let [n (count xs)]
; (if (< i n) (recur (inc i) (conj xs 1))))` grows `n` as fast as `i`. So a
; local is a bound only when it is INVARIANT: bound outside the loop, or a
; body `let` whose initializer is itself invariant. Invariant expressions are
; literals, globals, invariant locals, and arithmetic or `count` over them —
; deterministic, effect-free reads (any other call may answer differently on
; each iteration, so it is variant).

(defn- body-binders
  "Every local `n` binds (let names and pattern variables), in any depth."
  [n]
  (cond
    (and (map? n) (= :pvar (:pop n))) #{(:name n)}
    (map? n) (reduce (fn [acc k] (into acc (body-binders (get n k)))) (if (= :let (:op n)) #{(:name n)} #{})
                     (keys n))
    (or (list? n) (vector? n) (seq? n)) (reduce (fn [acc x] (into acc (body-binders x))) #{} n)
    :else #{}))

(defn- body-lets
  "{name → init} for every `let` under `n`."
  [n]
  (cond
    (map? n) (reduce (fn [acc k] (merge acc (body-lets (get n k))))
                     (if (= :let (:op n)) {(:name n) (:init n)} {})
                     (keys n))
    (or (list? n) (vector? n) (seq? n)) (reduce (fn [acc x] (merge acc (body-lets x))) {} n)
    :else {}))

(defn- invariant-expr?
  "Is `x` a value no iteration can change, given the `variant` locals?"
  [x variant]
  (let [x (ir/arith-bif x)]
    (cond
      (contains? #{:lit :global} (:op x)) true
      (= :var (:op x)) (not (contains? variant (:name x)))
      (= :remote (:op x))
        (and (or (and (= :erlang (:mod x))
                      (contains? #{:+ :- :* :div :rem :abs :length :tuple_size :map_size :byte_size} (:fun x)))
                 (and (= rt (:mod x)) (= :count (:fun x))))
             (every? (fn [a] (invariant-expr? a variant)) (:args x)))
      :else false)))

(defn loop-variant
  "The locals of a loop that may differ between iterations: its vars and every
   local its body binds, less the body lets proven invariant (a fixpoint)."
  [vars body]
  (let [lets (body-lets body)]
    (loop [variant (into (set vars) (body-binders body))]
      (let [next (set (filter (fn [v] (not (and (contains? lets v)
                                                (invariant-expr? (get lets v) (disj variant v)))))
                              variant))]
        (if (= next variant) variant (recur next))))))

(defn- cmp-facts
  "The facts comparison `node` establishes when it is `truth` (true/false):
   a set of [:lower v] / [:upper v]. A bound counts only when it is
   LOOP-INVARIANT (see `loop-variant`), so `(> i x)` with `x` moving too — or
   `n` computed from a moving collection — proves nothing."
  [node truth loop-vars]
  (let [node (ir/arith-bif node)]
    (if (not (= :remote (:op node)))
      #{}
      (let [k (:fun node) m (:mod node) args (:args node)
            nm (fn [x] (when (= :var (:op x)) (:name x)))
            fixed? (fn [x] (invariant-expr? x loop-vars))]
        (cond
          ; `(not t)` is t with the branch's truth flipped
          (and (= m rt) (= k :invoke) (= :global (:op (first args))) (= "not" (:name (first args)))
               (= :cons (:op (second args))) (= :enil (:op (:tail (second args)))))
            (cmp-facts (:head (second args)) (not truth) loop-vars)
          (and (= m :erlang) (contains? #{:andalso :and} k) truth)
            (reduce (fn [acc c] (into acc (cmp-facts c true loop-vars))) #{} args)
          (and (= m :erlang) (= 2 (count args)) (contains? #{:< :=< :> :>=} k))
            (let [a (first args) b (second args)
                  ; `a < b` true: a is bounded above by b, b below by a;
                  ; false swaps the roles
                  small-big (if (contains? #{:< :=<} k) [a b] [b a])
                  [lo hi] (if truth small-big (vec (reverse small-big)))]
              (set (keep identity [(when (and (some? (nm lo)) (fixed? hi)) [:upper (nm lo)])
                                   (when (and (some? (nm hi)) (fixed? lo)) [:lower (nm hi)])])))
          (and (= m rt) (= 1 (count args)) (contains? #{:pos? :neg?} k) (some? (nm (first args))))
            (let [v (nm (first args))]
              (if (= truth (= k :pos?)) #{[:lower v]} #{[:upper v]}))
          ; sequence guards: `(seq s)` true or `(empty? s)` false means s has
          ; a first element, so `(rest s)` is strictly shorter
          (and (= m rt) (= 1 (count args)) (= k :seq) truth (some? (nm (first args))))
            #{[:nonempty (nm (first args))]}
          (and (= m rt) (= 1 (count args)) (= k :empty?) (not truth) (some? (nm (first args))))
            #{[:nonempty (nm (first args))]}
          ; `(nil? s)` false: s is truthy (see the var test in `path-facts`)
          (and (= m core) (= 1 (count args)) (= k :nil?) (not truth) (some? (nm (first args))))
            #{[:truthy (nm (first args))]}
          :else #{})))))

(defn- path-facts
  "What an `if` test establishes on one branch: its comparison facts, plus
   `[:truthy v]` when the test IS the local v and holds."
  [test truth loop-vars]
  (if (and truth (= :var (:op test)))
    #{[:truthy (:name test)]}
    (cmp-facts test truth loop-vars)))

(defn- guarded-recurs
  "Every recur to `self` under `n` as {:vals new-values :facts known-facts},
   not descending into a nested loop (its recurs are its own obligation)."
  [self loop-vars n facts]
  (cond
    (not (ir/node? n)) (list)
    (ir/recur? n self) (list {:vals (ir/recur-vals n) :facts facts})
    (ir/anf-loop? n) (list)
    (= :if (:op n))
      (concat (guarded-recurs self loop-vars (:test n) facts)
              (guarded-recurs self loop-vars (:then n) (into facts (path-facts (:test n) true loop-vars)))
              (guarded-recurs self loop-vars (:else n) (into facts (path-facts (:test n) false loop-vars))))
    :else (mapcat (fn [c] (guarded-recurs self loop-vars c facts)) (ir/child-nodes n))))

(defn check-anf-loop
  "Termination verdict for a recognised ANF loop scaffold node. A loop var
   RANKS the loop when, on EVERY recur, it moves toward a bound that the
   recur's own path guarantees: down (dec, minus a positive literal) under a
   lower bound, up under an upper bound, or down a finite sequence (rest/next)."
  [n]
  (let [{:keys [self vars body]} (ir/loop-parts n)
        recurs (guarded-recurs self (loop-variant vars body) body #{})
        nvars (count vars)
        var-at (fn [i] (nth (apply list vars) i))
        wf-on-all? (fn [vi]
                     (let [v (var-at vi)]
                       (every? (fn [r]
                                 (let [newvals (:vals r) facts (:facts r)]
                                   (if (< vi (count newvals))
                                     (let [nv (nth newvals vi)
                                           dir (measure-dir nv v)
                                           step (let [x (ir/arith-bif nv)]
                                                  (when (and (= :down dir) (= :remote (:op x)) (= rt (:mod x)))
                                                    (:fun x)))]
                                       (cond
                                         ; `(rest s)` shrinks only a NON-EMPTY s: `(rest [])` is
                                         ; `()`, truthy and just as long, so an unguarded walk
                                         ; never ends. `(next s)` of a truthy s is nil or shorter.
                                         (= step :rest) (contains? facts [:nonempty v])
                                         (= step :next) (or (contains? facts [:nonempty v])
                                                            (contains? facts [:truthy v]))
                                         (= dir :down) (contains? facts [:lower v])
                                         (= dir :up) (contains? facts [:upper v])
                                         :else false))
                                     false)))
                               recurs)))
        ranking (filter wf-on-all? (range nvars))]
    (if (empty? recurs)
      {:status :accepted :detail "no recur — trivially terminating"}
      (if (not (empty? ranking))
        {:status :accepted
         :detail (str "ranking variable: " (var-at (first ranking))
                      " (well-founded on every recur)")}
        {:status :rejected
         :detail (str "no ranking variable — every loop var either fails to move "
                      "toward a fixed endpoint or lacks a guard bounding it on the recur's path")}))))

(defn check-loop
  "The termination verdict for one recognised ANF loop scaffold node. A
   ^{:decreasing …} measure the author asserted rides in the node's :ann (the
   compiler stamps it there) — it is the trusted escape hatch. Otherwise the
   scaffold recogniser runs. The verdict carries the loop's source :pos, read
   straight from the IR — no second pass over the surface form."
  [anf]
  (let [ann (or (:ann anf) {})
        pos (select-keys ann (list :line :col :file :end-line :end-col))
        decreasing (maps/get :decreasing ann nil)]
    (assoc
      (if (some? decreasing)
        {:status :trusted :detail (str "trusted measure: " (errors/delaborate decreasing))}
        (check-anf-loop anf))
      :pos pos)))

; ── source-level driver, over bl-ANF ───────────────────────────────────
;
; The compiler desugars every loop to a Y-combinator scaffold whose :ann
; carries the loop's source span (and any trusted measure). So locating loops
; and positioning their verdicts is ONE walk of the IR — no parallel surface
; walk. A defn compiles its body into a descriptor the intern call embeds as a
; :lit; `loop-nodes` descends into that embedded ANF too, so a loop written
; inside a defn is found with the same code as a top-level one.

(defn- descriptor-fns
  "Every [fn-name params body] a defn descriptor embeds in a :lit value. A defn
   compiles to an intern call whose descriptor :lit is a LIST of
   {:fixed arity name descmap} tuples; each descmap carries the clause's ANF
   under :body. Empty for any other :lit."
  [n]
  (if (and (= :lit (:op n)) (erlang/is_list (:val n)))
    (keep (fn [item]
            (when (erlang/is_tuple item)
              (let [parts (erlang/tuple_to_list item)
                    desc (last parts)]
                (when (and (map? desc) (contains? desc :body))
                  [(if (>= (count parts) 3) (fn-name-str (nth parts 2)) "?")
                   (map (fn [p] (get p :name)) (get desc :params))
                   (:body desc)]))))
          (:val n))
    (list)))

(defn- descriptor-bodies
  "The clause ANF bodies a defn descriptor embeds in a :lit, as a list. Reach
   them so a loop written inside a defn is reachable from source with the same
   walk as a top-level one. Empty for any other :lit."
  [n]
  (map (fn [d] (nth d 2)) (descriptor-fns n)))

(defn- loop-nodes
  "Every ANF loop scaffold reachable under `n`, descending through ordinary
   child nodes AND through a defn descriptor's :lit-embedded clause bodies."
  [n]
  (cond
    (not (ir/node? n)) (list)
    (ir/anf-loop? n) (cons n (mapcat loop-nodes (ir/child-nodes n)))
    :else (let [embedded (descriptor-bodies n)
                kids (if (seq embedded) embedded (ir/child-nodes n))]
            (mapcat loop-nodes kids))))

(defn check-source
  "Verdicts for every loop in `src` — top-level and nested-in-defn — each
   carrying the loop's source position, read from the IR the compiler produced."
  [src]
  (let [forms (BeamLisp.Reader/read_string src)
        anfs (map (fn [f] (c/compile-node f compile-env)) forms)]
    (reduce (fn [acc anf] (concat acc (map check-loop (loop-nodes anf)))) (list) anfs)))

; ── growth: the cost class of a fn's own recursion ──────────────────────
;
; The recursion SHAPE bounds the fn's own work: how many times it runs per
; level, and whether its subproblems overlap. `growth` reads that shape off the
; bl-ANF the compiler produced and reports one of :linear / :quadratic /
; :exponential per self-recursive fn — a fn that calls itself by name, or that
; runs a loop (the compiler desugars loop/recur to the same self-application).
;
; The bound's LIMITS: it bounds the fn's OWN recursion shape only. It says
; nothing about the cost of the library functions the fn calls (a linear
; recursion calling a linear callee still reads :linear), and nothing about a
; non-recursive fn's cost. A fn the analysis cannot read is omitted, never
; guessed; `growth` never raises.

(defn- user-module?
  "Is `m` a beam-lisp namespace module — the only kind a self-call's [mod fun]
   form can name? Host modules (`erlang`, RT, core, `maps`, …) never are."
  [m]
  (and (not (contains? #{:erlang rt core} m))
       (not (nil? (index-of (str m) "BeamLisp.Ns")))))

(defn- self-call?
  "Is ANF node `n` a call to the fn named `self`? A call to a linked user fn
   compiles to `Module/fn` (a :remote whose module is a beam-lisp namespace);
   an unresolved user call compiles to RT/invoke of a (:global name)."
  [n self]
  (and (ir/node? n) (= :remote (:op n))
       (let [callee (first (:args n))]
         (or (and (= :global (:op callee)) (= self (:name callee)))
             (and (user-module? (:mod n)) (= self (fn-name-str (:fun n))))))))

(defn self-call-nodes
  "Every ANF node under `ir-node` that is a call to the fn named `self`, in
   pre-order. Descends into a self-call's own arguments, so a self-call nested
   inside another self-call is found too."
  [ir-node self]
  (cond
    (not (ir/node? ir-node)) (list)
    (self-call? ir-node self)
      (cons ir-node (mapcat (fn [c] (self-call-nodes c self)) (ir/child-nodes ir-node)))
    :else (mapcat (fn [c] (self-call-nodes c self)) (ir/child-nodes ir-node))))

(defn- invoke?
  "Is `n` a user-fn invocation (RT/invoke of a callee value)?"
  [n] (and (= :remote (:op n)) (= rt (:mod n)) (= :invoke (:fun n))))

(defn- cons-chain-nodes
  "The element nodes of a :cons list value, in order."
  [n]
  (loop [n n acc []]
    (cond
      (not (ir/node? n)) acc
      (= :cons (:op n)) (recur (:tail n) (conj acc (:head n)))
      (= :enil (:op n)) acc
      :else (conj acc n))))

(defn- call-args
  "The ACTUAL argument nodes of call node `n`: a linked remote carries them in
   :args; RT/invoke wraps them in a cons-chain list value."
  [n]
  (if (invoke? n) (cons-chain-nodes (second (:args n))) (:args n)))

(defn- arithmetic-image
  "The parameter name an ARITHMETIC descent node steps by a positive literal —
   `(- p k)` / `(+ p k)` / `(dec p)` / `(inc p)` — or nil. A STRUCTURAL descent
   (`rest` / `next`) is not an arithmetic image: its subproblems are disjoint."
  [node]
  ; See through the numeric-tower scaffold: `(- p 1)` compiles to
  ; (let [a p] (let [b 1] (if (is_map…) (Num/sub a b) (erlang/- a b)))) —
  ; ir/arith-bif hands back the BIF over the original operands (same unwrap
  ; measure-dir does); without it every `(- p k)` reads as an :if, not a step.
  (let [node (ir/arith-bif node)]
  (if (not (= :remote (:op node)))
    nil
    (let [k [(:mod node) (:fun node)] args (:args node)
          vn (fn [a] (when (= :var (:op a)) (:name a)))]
      (cond
        (and (= k [core :dec]) (= 1 (count args))) (vn (first args))
        (and (= k [core :inc]) (= 1 (count args))) (vn (first args))
        (and (= k [:erlang :-]) (= 2 (count args)) (pos-lit? (nth args 1))) (vn (first args))
        (and (= k [:erlang :+]) (= 2 (count args)) (pos-lit? (nth args 1))) (vn (first args))
        (and (= k [:erlang :+]) (= 2 (count args)) (pos-lit? (first args))) (vn (nth args 1))
        :else nil)))))

(defn- descendant?
  "Is node `target` `n` itself, or a node under it?"
  [n target]
  (cond
    (not (ir/node? n)) false
    (= n target) true
    :else (some (fn [c] (descendant? c target)) (ir/child-nodes n))))

(defn- nested-pair
  "The [inner outer] self-call pair where `inner` sits inside `outer`'s
   arguments, or nil."
  [calls]
  (some (fn [outer]
          (some (fn [inner]
                  (when (some (fn [arg] (descendant? arg inner)) (:args outer))
                    [inner outer]))
                calls))
        calls))

(defn- arithmetic-sites
  "The first-argument arithmetic descents of `calls`, as {param → count}."
  [calls]
  (reduce (fn [m c]
            (let [v (arithmetic-image (first (call-args c)))]
              (if (nil? v) m (assoc m v (inc (get m v 0))))))
          {} calls))

(defn- branching-param
  "The parameter name that ≥2 self-call sites descend by arithmetic, or nil."
  [calls params]
  (let [sites (arithmetic-sites calls)
        ps (set params)]
    (some (fn [v] (when (and (>= (get sites v 0) 2) (contains? ps v)) v))
          (keys sites))))

(defn- loop-nodes-under
  "Every loop scaffold reachable under `n` (its own and any nested one)."
  [n]
  (cond
    (not (ir/node? n)) (list)
    (ir/anf-loop? n) (cons n (mapcat loop-nodes-under (ir/child-nodes n)))
    :else (mapcat loop-nodes-under (ir/child-nodes n))))

(defn- recognised-loops
  "The loop scaffolds under `body` the termination rule accepts (or that carry
   a trusted measure)."
  [body]
  (filter (fn [n] (contains? #{:accepted :trusted} (:status (check-loop n))))
          (loop-nodes-under body)))

(defn- anf-shape
  "A short s-expression rendering of ANF node `n`, for a growth witness."
  [n]
  (cond
    (not (ir/node? n)) "?"
    (= :var (:op n)) (:name n)
    (= :lit (:op n)) (pr-str (:val n))
    (= :enil (:op n)) "()"
    (= :global (:op n)) (:name n)
    (= :remote (:op n))
      (let [head (if (invoke? n)
                   (let [c (first (:args n))] (if (= :global (:op c)) (:name c) "fn"))
                   (fn-name-str (:fun n)))
            as (call-args n)]
        (str "(" head (if (empty? as) "" (str " " (join " " (map anf-shape as)))) ")"))
    :else (str "(" (:op n) " …)")))

(defn- class-rank [c] (case c :quadratic 2 :exponential 1 :linear 0 0))

(defn- growth-of-body
  "The growth entry for one fn `body`, or nil when it has no boundable
   recursion. `params` are the fn's ANF parameter names."
  [self params body]
  (let [calls (self-call-nodes body self)
        loops (recognised-loops body)
        pair (nested-pair calls)
        branch (branching-param calls params)]
    (if (some? pair)
      {:class :quadratic :label ">= O(n^2)"
       :witness (anf-shape (first pair))
       :detail "a self-call sits inside the arguments of another self-call — the inner call redoes work the outer already paid for"}
      (if (some? branch)
        {:class :exponential :label "O(2^n)"
         :witness (str (get (arithmetic-sites calls) branch) " self-calls descend " branch " by arithmetic")
         :detail "self-calls whose first argument steps the same parameter overlap — without memoisation the work doubles per level"}
        (if (or (seq calls) (seq loops))
          {:class :linear :label "O(n)"
           :witness (if (seq loops)
                      (str "loop over " (join ", " (into [] (:vars (ir/loop-parts (first loops))))))
                      (str (count calls) " self-call site" (if (= 1 (count calls)) "" "s")))
           :detail "work grows with the recursion depth — a single self-call, or a recognised loop whose ranking variable moves toward its floor"}
          nil)))))

(defn- fn-descriptors
  "Every [fn-name params body] a compiled form embeds, walking to any depth."
  [n]
  (cond
    (not (ir/node? n)) (list)
    (= :lit (:op n)) (descriptor-fns n)
    :else (mapcat fn-descriptors (ir/child-nodes n))))

(defn growth
  "The growth class of every self-recursive fn in `src`, as
   {fn-name {:class :linear|:quadratic|:exponential :label … :witness …
             :detail …}}. A fn absent from the map is not self-recursive —
   nothing to say about it.

   :quadratic   a self-call sits inside another self-call's arguments (nested
                recursion: the inner call redoes work the outer already paid
                for).
   :exponential ≥2 self-call sites step the SAME parameter by positive
                arithmetic (`(- p k)` / `(+ p k)` / `dec` / `inc`) — overlapping
                subproblems, so without memoisation the work doubles per level
                (naive fib). Two calls over STRUCTURAL descents (`rest`/`next`,
                or differing fields of the same value) are NOT flagged: those
                subproblems are disjoint and the total work stays linear in the
                input.
   :linear      otherwise — a single self-call, or a recognised loop whose
                ranking variable moves toward its floor.
   Precedence: nested beats exponential beats linear.

   LIMITS: the bound is the fn's OWN recursion shape. It says nothing about the
   cost of the functions it calls — a linear recursion calling a linear callee
   still reads :linear — and nothing about a non-recursive fn. A fn the
   analysis cannot read is omitted, never guessed; `growth` never raises."
  [src]
  (try
    (let [forms (BeamLisp.Reader/read_string src)
          descriptors (mapcat (fn [f] (fn-descriptors (c/compile-node f compile-env))) forms)]
      (reduce (fn [acc d]
                (let [nm (nth d 0) params (nth d 1) body (nth d 2)
                      g (growth-of-body nm params body)
                      old (get acc nm)]
                  (if (nil? g) acc
                    (assoc acc nm (if (and (some? old)
                                           (> (class-rank (:class g)) (class-rank (:class old))))
                                    old g)))))
              {} descriptors))
    (catch _ {})))
