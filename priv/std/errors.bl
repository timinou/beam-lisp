; errors.bl — error rendering. The L12 criterion, made code.
;
; Every diagnostic this tree produces — the reader's syntax failures, the
; checker's warnings, a supervisor's child exits — renders the same way, because
; they are ONE shape: a diagnostic (diag.bl is the vocabulary, its header the
; invariants). This module does not know who produced one, or what it is about:
;
;   path/to/file.bl:12:5: argument 1 provably wrong
;     12 │ (greet 42)
;        │        ^^ expects (:string), got (:int)
;
; L12: the user NEVER sees the machine's representations — no
; {:list, …} tuples, no #{:int} sets, no raw tag names. Types print as
; sorted parenthesized lists; positions are the user's own; the
; excerpt is the user's own line with a caret under the offending
; form.

(ns errors
  (:require [diag] [reader-node :as rn]))

(defn delaborate
  "A reader node as the SOURCE the user wrote: symbols by name, forms
   re-parenthesized, literals by pr-str. Never a raw tuple. (Widths are
   not preserved — this is a message, not a pretty-printer.)"
  [node]
  (let [f (rn/node-form node)
        t (rn/node-tag f)]
    (cond
      (= t :list)
        (str "(" (join " " (map delaborate (rn/node-items f))) ")")
      (= t :vector)
        (str "[" (join " " (map delaborate (rn/node-items f))) "]")
      (= t :set)
        (str "#{" (join " " (map delaborate (rn/node-items f))) "}")
      (= t :map)
        (str "{" (join " "
                     (map (fn [pair]
                            (let [k (first (erlang/tuple_to_list pair))
                                  v (second (erlang/tuple_to_list pair))]
                              (str (delaborate k) " " (delaborate v))))
                          (rn/node-items f)))
             "}")
      (= t :symbol) (rn/node-name f)
      (= t :keyword) (str ":" (rn/node-name f))
      ; a STRING literal must round-trip AS a string: bl's pr-str does not add
      ; quotes (unlike Clojure), so an unquoted "evt:init" would re-parse as a
      ; SYMBOL. Re-quote here so delaborate → reader is an identity on strings.
      (and (= t :scalar) (erlang/is_binary f)) (str "\"" f "\"")
      :else (pr-str f))))

(defn source-line
  "The 1-indexed line of src, or nil."
  [src line]
  (let [ls (split src "\n")]
    (if (and (>= line 1) (<= line (count ls)))
      (nth ls (- line 1))
      nil)))

(defn caret-width
  "How wide the offending form is when NO SPAN was recorded: from col to the
   next delimiter on the line. A fallback — a producer that knows its span sets
   :end-col (the reader has recorded ends since the offsets landed), and the
   exact span wins (see `render`)."
  [text col]
  (let [rest-text (if (<= col (count text)) (subs text col) "")
        delims #{" " "(" ")" "[" "]" "{" "}" "\t"}
        idx (first (filter (fn [i] (contains? delims (subs rest-text i (+ i 1))))
                           (range 0 (count rest-text))))]
    (if (nil? idx) (max 1 (count rest-text)) (max 1 idx))))

(defn render
  "Render diagnostic `w` against `src` under `file`, as a caret/underline.

   It reads only :msg, :line, :col and the span keys (:end-col, :end-line), so
   ANY diagnostic renders — a reader syntax failure, a checker warning, a
   hand-built map — and a producer that attaches structure (:kind, :expected,
   :opened-at) renders identically. The location is printed ONCE: a diagnostic
   carries it in :msg (`diag/complete?`), and only a legacy bare message gets it
   from here. When w carries an :end-col on the same line the underline is the
   EXACT span the producer recorded; otherwise it falls back to the
   token-boundary approximation. Returns the multi-line string."
  [file src w]
  (let [line (:line w)
        col  (:col w)
        here (if (and (erlang/is_integer line) (erlang/is_integer col))
               (diag/loc {:line line :col col :file (or (:file w) file)})
               nil)
        head (if (or (nil? here) (diag/complete? (:msg w) {:line line :col col :file (or (:file w) file)}))
               (:msg w)
               (str here ": " (:msg w)))
        text (source-line src line)]
    (if (nil? text)
      head
      (let [gutter (str line)
            pad (apply str (repeat (count gutter) " "))
            w0 (max 0 (- col 1))
            end-col (:end-col w)
            end-line (:end-line w)
            ; exact span when the end is on the SAME line; a multi-line form
            ; underlines only its first line up to the token boundary (a caret
            ; cannot span lines in this single-line excerpt view).
            width (if (and (erlang/is_integer end-col)
                           (or (nil? end-line) (= end-line line))
                           (> end-col col))
                    (- end-col col)
                    (caret-width text w0))
            carets (apply str (repeat width "^"))]
        (str head "\n"
             "  " gutter " │ " text "\n"
             "  " pad " │ " (apply str (repeat w0 " ")) carets)))))

(defn node->warning
  "Bridge an ANF (or reader) node's :ann into a DIAGNOSTIC (diag.bl) that
   `render` draws a caret/underline from. The single position channel: any node
   carrying :ann can be pointed at, with no separate position bookkeeping.
   Returns nil when the node has no line — a node with no position is not a
   diagnostic about a place.

   The location is built EXPLICITLY here rather than trusting `:ann`'s shape:
   this bridge is where a half-recorded position is normalised (line without
   col), and a diagnostic must leave here whole."
  ([node msg] (node->warning :type node msg))
  ([kind node msg]
   (let [a (:ann node)]
     (if (and (map? a) (erlang/is_integer (:line a)))
       (let [at (merge {:line (:line a) :col (or (:col a) 1) :file (:file a)}
                       (if (and (erlang/is_integer (:end-line a))
                                (erlang/is_integer (:end-col a)))
                         {:end-line (:end-line a) :end-col (:end-col a)}
                         {}))]
         (diag/warning kind msg at nil))
       nil))))

(defn delaborated?
  "L12 as a predicate over RENDERED output: no raw repr markers may
   survive to the user. Returns the first offending marker, or nil."
  [rendered]
  (reduce (fn [_ m] (if (some? (index-of rendered m)) m nil))
          nil ["{:list" "{:symbol" "{:meta" "#{" "tuple"]))

(defn render-all
  "Every warning of a check, rendered in order."
  [file src warnings]
  (apply str (map (fn [w] (str (render file src w) "\n")) warnings)))
