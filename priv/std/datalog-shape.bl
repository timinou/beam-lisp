; priv/std/datalog-shape.bl — the vocabulary of the N+1 class, in one place.
;
; Two tools recognise "a store read inside a per-element loop": deodorant's
; `datalog/n+1-read` smell (file by file, at lint time) and codebase's
; `:call/loop-depth` fact behind `bl ask nplus1` (whole corpus, from the
; indexed store). They must agree on what a loop is and what a read is, or a
; site one reports and the other misses is a bug report about the tools
; rather than about the code. So both read these two sets and neither
; defines its own.

(ns datalog-shape)

(def LOOP-HEADS
  "Collection forms whose function argument (or body) runs once per element."
  #{"map" "mapv" "mapcat" "for" "doseq" "reduce" "filter" "filterv" "remove"
    "keep" "some" "every?" "run!" "pmap" "each" "map-indexed" "reduce-kv"
    "update-vals" "group-by" "sort-by" "frequencies"})

(def STORE-READ-NAMES
  "Callee NAMES (the part after the slash) that read a datom store per call.
   `datom/db` is deliberately absent: it is an O(1) snapshot, never a read."
  #{"pull" "pull-many" "q" "entity" "entity-datoms" "datoms" "attr-datoms"
    "range-datoms" "attribute-page" "datoms-many" "explain"})

(defn callee-name
  "The NAME part of a callee symbol string: `datom/pull` → `pull`."
  [callee]
  (let [parts (split callee "/")]
    (if (> (count parts) 1) (nth parts (- (count parts) 1)) callee)))
