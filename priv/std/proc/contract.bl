; Native callback admission, generated by the compiler from canonical clauses.
; A receipt describes current code. It is not a lease or publication authority.
(ns proc.contract
 (:require [proc.input-domain :as inputs] [reload.execution :as execution]
           [reload.server-entry :as entry] [data.first-order :as data] [env]))

(defn- code-id [module]
 (Base/encode16 (erlang/apply module :module_info (list :md5)) (list (tuple :case :lower))))

(defn snapshot
 "Read the compiler-owned callback contract of a loaded native server. Includes
  exact code identity and canonical patterns/guards, without handler bodies.
  Returns nil for old/uninstrumented modules. Does not load or start a server."
 [module]
 (when (and (erlang/is_atom module) (erlang/function_exported module :__bl_contract__ 0))
  (try (let [before (code-id module)
        descriptor (erlang/apply module :__bl_contract__ (list))]
   (when (and (= 1 (:version descriptor)) (= :beam (:target descriptor))
              (= :callback-admission (:scope descriptor)) (= before (code-id module)))
    (assoc descriptor :module module :code-id before)))
   (catch _ nil))))

(defn check
 "Check one message against actual compiled patterns and pure guards, using the
  supplied sender/state. Never execute a callback body. State-dependent failure
  means not admitted NOW, not necessarily malformed forever. A stale receipt
  refuses; retain the candidate generation separately for lifecycle authority.
  This checks declared callback clauses only, not implicit OTP fallback behavior,
  arbitrary body constraints, authorization, reply shape or state invariants."
 [contract kind message from state]
 (let [module (:module contract)
       f (case kind :call :__bl_accept_call__ :cast :__bl_accept_cast__
                    :info :__bl_accept_info__ :continue :__bl_accept_continue__ nil)]
  (cond
   (nil? f) {:status :refused :kind :unknown-callback}
   (not (and (= 1 (:version contract)) (= :callback-admission (:scope contract))
             (erlang/is_atom module) (string? (:code-id contract))))
    {:status :refused :kind :missing-contract}
   :else
    (try
     (if-not (= (:code-id contract) (code-id module))
      {:status :refused :kind :stale-code}
      (let [args (if (= kind :call) (list message from state) (list message state))
            accepted (erlang/apply module f args)]
       (cond
        (not= (:code-id contract) (code-id module)) {:status :refused :kind :stale-code}
        (= true accepted) {:status :accepted :scope :callback-admission}
        :else {:status :refused :kind :unmatched-clause :scope :callback-admission})))
     (catch _ {:status :refused :kind :unavailable-contract})))))

(defn admit?
 ([contract kind message state] (admit? contract kind message nil state))
 ([contract kind message from state] (= :accepted (:status (check contract kind message from state)))))

; Argument domains supplement callback admission; they never grant native owner
; adoption, state migration, reply compatibility or permission to run effects.
(def ^:private input-callbacks #{:handle_call :handle_cast :handle_info :handle_continue})
(defn- normalize-input [node names]
 ;; Pure threaded alpha normalization. Quoted literals are kept byte-for-byte;
 ;; there is no atom table/letfn resource cycle or namespace spelling heuristic.
 (cond
  (map? node)
   (cond
    (contains? #{:lit :plit} (or (:op node) (:pop node))) [names (dissoc node :ann)]
    (= :pvar (:pop node))
     (let [old (:name node) new (if (= old "_") "_" (get names old (str "v" (count names))))]
      [(if (= old "_") names (assoc names old new)) (assoc (dissoc node :ann) :name new)])
    (= :var (:op node)) [names (assoc (dissoc node :ann) :name (get names (:name node) (:name node)))]
    :else (reduce (fn [[names out] [key value]]
                    (if (= key :ann) [names out]
                     (let [[after value] (normalize-input value names)] [after (assoc out key value)])))
                  [names {}] node))
  (or (vector? node) (erlang/is_list node))
   (let [[after out] (reduce (fn [[names out] value]
                              (let [[after value] (normalize-input value names)] [after (conj out value)]))
                            [names []] node)]
    [after (if (vector? node) out (to-list out))])
  :else [names node]))
(defn- input-shape [clause]
 (let [[names params] (normalize-input (:params clause) {})
       [_ guard] (normalize-input (:guard clause) names)]
  {:callback (:fname clause) :params params :guard guard}))
(defn input-context [namespaces] (inputs/context namespaces))
(defn prepare-inputs!
 "Generation compiler only: bind requirements to its actual checked descriptor
  and loaded class MD5. Older compilers cannot assert an enforced entry hook.
  Unknown/uncovered classes stay retained-drain; preparation still succeeds."
 [descriptor input-context]
 (let [module (:name descriptor) actual (snapshot module)
       declared (first (keep #(when (= :__bl_contract__ (:fname %)) (:val (:body %))) (:clauses descriptor)))]
  (when-not (and (= :module (:op descriptor)) actual
                 (= declared (dissoc actual :module :code-id)))
   (throw (ex-info "Actor descriptor identity refused" {:kind :invalid-actor-input-descriptor})))
  (let [rows (mapv
              (fn [clause]
               (try
                (data/check! (select-keys clause [:params :guard])
                             {:max-nodes 16384 :max-depth 64 :max-bytes 262144})
                (let [projected (entry/input-body module clause)
                      proof (inputs/clause descriptor (assoc clause :body (:body projected)) input-context)]
                 {:key (entry/input-key clause) :shape (input-shape clause)
                  :enforced (:enforced projected) :proof (inputs/runtime-proof proof)})
                (catch _ {:key (entry/input-key clause) :shape nil :enforced false
                          :proof {:status :unknown :scope :body-argument-shapes :reason :input-proof-budget}})))
              (filter (fn [clause]
                        (let [kind (get {:handle_call :call :handle_cast :cast :handle_info :info
                                         :handle_continue :continue} (:fname clause))]
                         (some (fn [declared]
                                 (and (= (:params clause) (:params declared))
                                      (= (:guard clause) (:guard declared))))
                               (get-in actual [:callbacks kind :clauses])))) (:clauses descriptor)))
        eligible (and (seq rows) (every? #(and (:enforced %) (= :proved (get-in % [:proof :status]))
                                              (= true (get-in % [:proof :covered]))) rows))
        result {:version 1 :module module :code-id (:code-id actual)
                :scope :body-argument-shapes :eligible (boolean eligible)
                :status (if eligible :proved :retained-drain) :clauses rows
                :by-key (into {} (mapv (fn [row] [(:key row) row]) rows))}]
   (try
    (inputs/metadata! (update (dissoc result :by-key) :clauses
                  (fn [rows] (mapv (fn [row] (update row :proof inputs/data-view)) rows))))
    result
    (catch _ (assoc (select-keys result [:version :module :code-id :scope])
                    :status :retained-drain :eligible false :clauses [] :by-key {} :reason :input-proof-budget))))))
(defn inputs-valid?
 "Current actor code plus complete actual helper/native/binding identities."
 [certificate]
 (try
  (and (= 1 (:version certificate)) (= :body-argument-shapes (:scope certificate))
       (= true (:eligible certificate)) (seq (:clauses certificate))
       (= (:code-id certificate) (code-id (:module certificate)))
       (every? #(and (:enforced %) (= true (get-in % [:proof :covered]))
                     (inputs/valid? (:proof %))) (:clauses certificate)))
  (catch _ false)))
(defn- compare-inputs [current candidate current-valid candidate-valid]
 (cond
  (not (and (:eligible current) (:eligible candidate) current-valid candidate-valid))
   {:status :refused :kind :actor-body-input-compatibility-unproved}
  (not= (mapv :shape (:clauses current)) (mapv :shape (:clauses candidate)))
   {:status :refused :kind :actor-message-contract-changed}
  (= current candidate)
   {:status :valid :scope :exact-unchanged-actor-and-transitive-input-proof}
  :else
   ;; Each candidate actual guard covers its complete inferred requirements.
   ;; Equal heads/guards imply candidate argument-shape safety, not business
   ;; equivalence, state/reply compatibility or authorization to swap an actor.
   {:status :valid :scope :body-argument-shape-preservation}))
(defn adoption-check
 "Necessary input-preservation gate, never native adoption authority. Read only
  actual prepared graph catalogues and check each retained private scope. Ordinary
  source actors STILL retain/drain until a stable SDK kernel migrates state/head
  and versions all traffic. Unknown never passes."
 [current-generation current-module candidate-generation candidate-module]
  (let [old-ticket (execution/acquire! current-generation)]
   (try
    (let [new-ticket (execution/acquire! candidate-generation)]
     (try
      (let [current (get (:actor-inputs current-generation) current-module)
            candidate (get (:actor-inputs candidate-generation) candidate-module)
            old-valid (env/with-env (:scope current-generation) #(inputs-valid? current))
            new-valid (env/with-env (:scope candidate-generation) #(inputs-valid? candidate))]
       (compare-inputs current candidate old-valid new-valid))
      (finally (execution/release-ticket! candidate-generation new-ticket))))
    (finally (execution/release-ticket! current-generation old-ticket)))))
(defn- require-inputs! [rows bindings]
 (when-not (erlang/== rows ())
  (let [row (erlang/hd rows) name (erlang/element 1 row) domain (erlang/element 2 row)]
   (when-not (and (erlang/is_map bindings) (erlang/is_map_key name bindings)
                  (inputs/accepts? domain (erlang/map_get name bindings)))
    (throw (ex-info "Actor argument shape refused" {:kind :invalid-actor-body-input})))
   (require-inputs! (erlang/tl rows) bindings))))
(defn check-entry!
 "Fixed compiler-emitted entry inside actual native callback admission.
  Only generation-owned proved/covered rows enforce input requirements; legacy,
  unknown and uncovered ordinary actors keep their existing retained-drain
  behavior. No caller-supplied certificate or predicate is accepted here."
 [module key bindings]
 (when-let [generation (execution/current)]
  (when-not (and (execution/owned?) (contains? (:server-classes generation) module))
   (throw (ex-info "Actor input admission refused" {:kind :unadmitted-actor-input-check})))
  (let [certificate (get (:actor-inputs generation) module)
        row (get (:by-key certificate) key)]
   (when (and (:eligible certificate) (nil? row))
    (throw (ex-info "Actor input clause missing" {:kind :missing-actor-input-clause})))
   (when (and (:enforced row) (= :proved (get-in row [:proof :status]))
              (= true (get-in row [:proof :covered])))
    (when-not (and (= (:code-id certificate) (code-id module)) (inputs/valid? (:proof row)))
     (throw (ex-info "Actor input evidence changed" {:kind :stale-actor-input-proof})))
    (require-inputs! (maps/to_list (get-in row [:proof :requirements])) bindings))))

 :ok)
