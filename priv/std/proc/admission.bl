;; Admission is cancellation BEFORE execution, never interruption of effects.
(ns proc.admission)
(defn token [owner budget-ms]
 (when-not (and (erlang/is_pid owner) (= (erlang/node owner) (erlang/node))
                (erlang/is_integer budget-ms) (<= 0 budget-ms))
  (throw (ex-info "Admission requires a local owner and nonnegative budget" {})))
 {:owner owner :deadline-ms (+ (erlang/monotonic_time :millisecond) budget-ms)})
(defn live? [request]
 (and (map? request) (erlang/is_pid (:owner request))
      (= (erlang/node (:owner request)) (erlang/node)) (Process/alive? (:owner request))
      (erlang/is_integer (:deadline-ms request))
      (< (erlang/monotonic_time :millisecond) (:deadline-ms request))))
(defn with-request [request action]
 "Bind a request budget; registered Env conveyance crosses worker boundaries.
  This only sets admission context. Accepted shared operations clear it."
 (let [previous (Process/get :bl_admission)]
  (Process/put :bl_admission request)
  (try (action)
   (finally (if previous (Process/put :bl_admission previous) (Process/delete :bl_admission))))))
(defn run
 "Decline expired/dead queued work. An optional inherited request must also be
  live: a queue's own timeout cannot extend its parent's budget, nor can a live
  parent keep a dead immediate waiter admitted. Accepted shared effects drain."
 ([request action] (run request nil action))
 ([request parent action]
  (if (and (live? request) (or (nil? parent) (live? parent)))
   (with-request nil action) :cancelled)))
