; proc/reg.bl — find a process by what it is, not by its address.
;
; A pid is a pointer: precise, unstable across restarts, and meaningless to a
; human. When a supervisor heals your worker, the new process has a new pid
; and everyone holding the old one is talking to the dead. The registry is
; the pattern answer (§2.7 in docs/the-process-pattern-language.md): one
; process whose state is the RELATION pid ↔ attributes, kept true by the VM
; itself — every entry retracts itself when its pid dies, because the
; registry monitors each registration and handles :DOWN.
;
;   (proc/defserver sessions (registry (keys :user-id :node)))
;   (def r (start sessions nil {:name :sessions}))
;   (proc.reg/register r pid {:user-id 42})
;   (proc.reg/whereis r {:user-id 42})        ; → pid | nil
;   (proc.reg/where r {:node "b@h"})          ; → [pid …]
;
; And because the registry is started under an OTP name, every prelude verb
; accepts a NAME AS A VALUE — `[:sessions {:user-id 42}]` wherever a pid goes:
;
;   (call [:sessions {:user-id 42}] :balance)
;
; Resolution happens once, inside call/cast/stop (BeamLisp.Server), not in
; each form.
;
; Honest scope: single node. `where` is attribute-match, not datalog — a
; full query engine is a lib-tier dependency this std file does not take.

(ns proc.reg
  ; The registry is a CLAUSE of `defserver` now, not a form of its own, so the
  ; one thing this module needs from the expander is how to register it.
  (:require [proc.server :refer [extend-clause!]]))

;; ── the relation, as pure functions over the server state ─────────────
;; state: {:entries {pid → attr-map} :keys [declared-attr-keys]}

(defn- declared? [st k]
  (let [ks (:keys st)]
    (or (empty? ks) (some (fn [dk] (= dk k)) ks))))

(defn- matches?
  "An entry matches a query when every query k=v holds in the entry's attrs."
  [attrs query]
  (every? (fn [pair] (= (get attrs (first pair)) (second pair))) query))

(defn- index-entry [st pid attrs add?]
  (reduce (fn [state k]
    (let [value (get attrs k) bucket (get-in state [:indexes k value] {})
          changed (if add? (assoc bucket pid true) (dissoc bucket pid))]
      (if (seq changed) (assoc-in state [:indexes k value] changed)
        (update-in state [:indexes k] (fn [values] (dissoc values value)))))) st (:keys st)))

(defn remove-entry [st pid]
  (if-let [attrs (get (:entries st) pid)]
    (do
      (when-let [ref (get-in st [:registry-monitors pid])] (erlang/demonitor ref (list :flush)))
      (-> (index-entry st pid attrs false)
          (assoc :entries (dissoc (:entries st) pid))
          (update :registry-monitors (fn [refs] (dissoc refs pid))))) st))

(defn register-entry
  "Register and monitor a pid. Declared-key indexes are maintained in the same
   registry transaction; they are derived lookup paths, never separate owners."
  [st pid attrs]
  (let [bad (filter (fn [pair] (not (declared? st (first pair)))) attrs)]
    (if (empty? bad)
      (let [present? (contains? (:entries st) pid)
            clean (if present? (index-entry st pid (get (:entries st) pid) false) st)
            monitored (if present? clean
                        (assoc-in clean [:registry-monitors pid] (erlang/monitor :process pid)))]
        [:ok (index-entry (assoc monitored :entries (assoc (:entries monitored) pid attrs)) pid attrs true)])
      [[:error {:unknown-keys (vec (map first bad))}] st])))

(defn- candidate-pids [st query]
  (let [indexed (keep (fn [[k v]] (when (contains? (:indexes st) k)
                                     (get-in st [:indexes k v] {}))) query)]
    (if (seq indexed) (reduce (fn [a b] (if (< (count b) (count a)) b a)) indexed)
      (:entries st))))

(defn sample-entries
  "Bound allocation and traversal before reading entries. Single declared-key
   queries have an exact O(1) total and inspect at most limit candidates. Other
   predicates inspect at most 4096 candidates and report unknown total if cut.
   No cursor promises consistency across changing registry generations."
  [st query limit]
  (when-not (and (int? limit) (<= 1 limit 128))
    (throw (ex-info "Registry sample limit must be between 1 and 128" {})))
  (let [candidates (candidate-pids st query)
        exact? (or (empty? query) (and (= 1 (count query))
                    (contains? (:indexes st) (first (first query)))))
        total (when exact? (count candidates))]
    (loop [it (maps/iterator candidates) rows [] examined 0 matched 0]
      (let [next (maps/next it)]
        (cond
          (= next :none) {:entries rows :total (or total matched) :examined examined
                         :truncated (> (or total matched) (count rows)) :complete true}
          (or (= (count rows) limit) (>= examined 4096))
            {:entries rows :total total :examined examined :truncated true :complete exact?}
          :else
            (let [pid (elem next 0) attrs (get (:entries st) pid) found? (matches? attrs query)]
              (recur (elem next 2) (if found? (conj rows {:pid pid :attrs attrs}) rows)
                     (inc examined) (if found? (inc matched) matched))))))))

(defn down-handler
  "A monitored pid died: its entry retracts.

   This is the clause's `:down` contribution, not a `handle-info` clause of its
   own — the server's ONE `[:DOWN …]` clause threads every clause's handler, so
   a registry and a bus in one server cannot shadow each other. A pid this
   registry never held is a no-op, which is exactly what the thread needs."
  [st _ref pid _reason]
  (remove-entry st pid))

(defn find-one [st query]
  (first (keep (fn [pair]
                 (if (matches? (second pair) query) (first pair) nil))
               (:entries st))))

(defn entries-of
  "Every entry matching `query` as [{:pid pid :attrs attr-map}]: the registry's
   contents, not just who is in it. `find-all` answers pids because most callers
   only need to message them; a caller that must DISPLAY what is registered (a
   member list with ages) would otherwise need one query per attribute value."
  [st query]
  (vec (keep (fn [pair]
               (if (matches? (second pair) query)
                 {:pid (first pair) :attrs (second pair)}
                 nil))
             (:entries st))))

(defn find-all [st query]
  (vec (keep (fn [pair]
               (if (matches? (second pair) query) (first pair) nil))
             (:entries st))))

;; ── the clause ─────────────────────────────────────────────────────────
;;
;; `(registry (keys :user-id :node))` — the pid ↔ attributes relation as a
;; CLAUSE of `defserver`. It was a macro until `proc.server` gave bundles a
;; clause registry; a macro copies a whole server, a clause contributes a slice,
;; so a server that IS a registry AND holds its own state is one form rather
;; than a body to paste. The verbs below never needed the macro and do not
;; change.

(defn init-state
  "The state slice the clause contributes: the empty relation, and the attribute
   names the declaration allows. An empty key list means any attribute goes."
  [declared]
  {:entries {} :keys declared :indexes (into {} (map (fn [k] [k {}]) declared)) :registry-monitors {}})

(defn- declared-keys
  "The attribute names from a clause's `(keys …)` form, or `[]` when it has none.

   An impossible declaration is refused HERE, when the server form is expanded,
   with a sentence. A registry that cannot say what it keys on fails much later,
   on a `register` nobody can read: `[:error {:unknown-keys …}]` names the key it
   refused, never the declaration that refused it."
  [forms where]
  (when (> (count forms) 1)
    (throw (ex-info (str where ": (registry (keys :a :b)) takes at most one keys"
                         " clause — got " (count forms))
                    {:clause forms})))
  (let [ks (first forms)]
    (if (nil? ks)
      []
      (do
        (when-not (and (list? ks) (= 'keys (first ks)))
          (throw (ex-info (str where ": (registry …) takes (keys :a :b) — the attribute"
                               " names this registry allows. Got " (pr-str ks))
                          {:clause ks})))
        (let [declared (vec (rest ks))]
          (doseq [k declared]
            (when-not (keyword? k)
              (throw (ex-info (str where ": every registry key must be a keyword — got "
                                   (pr-str k) ". A non-keyword key can never match an"
                                   " attribute map, so no one could ever register on it.")
                              {:key k :clause ks}))))
          declared)))))

(defn registry-clause
  "The `(registry (keys …))` transform. Public because it is worth testing on its
   own: it is the unit that turns a declaration into the pid↔attributes relation,
   and it contributes a state SLICE rather than copying a server.

   A transform is backend-agnostic — `proc.server/clause-plan` applies it for the
   native macro, and for any other backend that hands it the same vocabulary."
  [clause ctx]
  (let [where (str "defserver " (:name ctx))
        declared (declared-keys (vec (rest clause)) where)]
    {:init `(proc.reg/init-state ~declared)
     :down [`proc.reg/down-handler]
     :clauses
     [`(handle-call [:register pid# attrs#] [_from# st#]
         (let [outcome# (proc.reg/register-entry st# pid# attrs#)]
           (reply (first outcome#) (second outcome#))))
      `(handle-call [:unregister pid#] [_from# st#]
         (reply :ok (proc.reg/remove-entry st# pid#)))
      `(handle-call [:whereis query#] [_from# st#]
         (reply (proc.reg/find-one st# query#) st#))
      `(handle-call [:where query#] [_from# st#]
         (reply (proc.reg/find-all st# query#) st#))
      `(handle-call [:sample query# limit#] [_from# st#]
         (reply (proc.reg/sample-entries st# query# limit#) st#))
      `(handle-call [:entries query#] [_from# st#]
         (reply (proc.reg/entries-of st# query#) st#))]}))

(extend-clause! :registry registry-clause)

;; ── the verbs (tier 2: hold for every registry) ────────────────────────

(defn register   [r pid attrs] (call r [:register pid attrs]))
(defn unregister [r pid]       (call r [:unregister pid]))
(defn whereis    [r query]     (call r [:whereis query]))
(defn where      [r query]     (call r [:where query]))
(defn entries    [r query]     (call r [:entries query]))

(defn sample [r query limit]
  (when-not (and (int? limit) (<= 1 limit 128))
    (throw (ex-info "Registry sample limit must be between 1 and 128" {})))
  (call r [:sample query limit]))
