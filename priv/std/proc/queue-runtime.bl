; Shared queue owner: immutable generations are handlers, not OTP scaffolds.
; This is the existing proc.queue engine, with FIFO handler publication.
(ns proc.queue-runtime
 (:require [proc.server :as ps] [proc.queue :as q] [proc.tick :as tick]
           [proc.owner-registry :as owners] [proc.framework :as framework]
           [reload.execution :as execution]
           [proc.queue-family :as family] [proc.reconcile-handler :as reconcile-handler] [proc.reconcile-config :as reconcile-config]
           [datom :as d] [datom.conn :as dc] [datom.store :as ds] [core]))

(def ^:private canonical-instances (atom {}))

(defn- refuse [kind] (throw (ex-info "Queue runtime transition refused" {:kind kind})))
(defn- registry-key [srv] (tuple :bl-queue-runtime (q/server-name srv)))
(defn- restoration-key [srv] (tuple :bl-queue-restoration (q/server-name srv)))
(defn- context-protocol [context srv]
 (let [p (or (get (:protocols context) (q/logical-name srv))
             (get (:protocols context) (keyword (q/logical-name srv))))]
  (let [explicit (if (map? p) (:protocol p) p)
        inferred (family/producer-contract (q/server-name srv))]
   (when (and explicit inferred (not= explicit (:protocol inferred)))
    (refuse :conflicting-queue-protocol))
   (or explicit (:protocol inferred)))))

(defn prepare
 "Capture one direct sealed queue handler and its execution environment.
  Candidate callers must execute under their own generation; no mutable alias
  resolution occurs during publication. Explicit callback modules retain wrapper
  dependencies, and the current generation's entire physical graph is retained."
 [srv spec]
 (let [srv (q/resolve-server srv)
       context (Process/get :bl_generation)
       declared (q/normalise-decl (:declaration spec))
       generation (or (:digest context) (:generation declared))
       decl (assoc declared :generation generation)
       _ (when-not (and (string? generation) (not (empty? generation))) (refuse :generation-required))
       _ (when (and (:digest context)
                    (or (not= (:protocol decl) (context-protocol context srv))
                        (and (:generation declared) (not= generation (:generation declared)))))
           (refuse :sealed-queue-contract-mismatch))
       _ (when-not (erlang/is_function (:perform spec) 1) (refuse :invalid-perform))
       clock (:clock spec tick/wall-ms)
       _ (when-not (erlang/is_function clock 0) (refuse :invalid-clock))]
  {:server srv :decl decl :perform (:perform spec) :clock clock
   :contract (q/normalise-contract (:contract spec {}))
   :environment (BeamLisp.Env/capture)
   :modules (vec (distinct (concat (:modules context []) (:modules spec [])
                                   (BeamLisp.Env/callback_modules (:perform spec))
                                   (BeamLisp.Env/callback_modules clock))))}))

(defn- retain [handler]
 (BeamLisp.Env/retain_code!
  (to-list (concat (:modules handler)
    (:modules (get-in handler [:environment :generation]) [])
    (BeamLisp.Env/callback_modules (:perform handler))
    (BeamLisp.Env/callback_modules (:clock handler))
    (mapcat BeamLisp.Env/callback_modules
      (concat (if-let [accept (get-in handler [:contract :accept?])] [accept] [])
        (mapcat (fn [edge] [(:upcast edge) (:accept? edge)])
                (vals (get-in handler [:contract :adapters])))))))))
(defn- release [handler]
 (reconcile-handler/close! handler)
 (when (:lease handler) (BeamLisp.Env/release_code! (:lease handler)))
 (when (:scope-lease handler) (BeamLisp.Env/release_code! (:scope-lease handler))))
(defn- sync [c]
 (if (ds/durable? (:store c)) (do (ds/sync! (:store c)) :stable) :volatile))
(defn- fixed-shape [decl] (select-keys decl [:of :unique :partition]))

(defn- with-current [st action]
 (if-not (framework/alive? (get-in st [:queue :framework]))
  (refuse :framework-initializer-exited)
  (q/with-handler-context (:queue st) action)))

(defn- initial [opts]
 (let [handler (if (:reconcile opts) (reconcile-handler/initialize! (:reconcile opts)) (:handler opts))
       srv (:server handler)
       held (atom {}) adopted (atom nil) registered (atom nil) published (atom nil)]
  (try
   (BeamLisp.Env/bind (:environment handler))
   ;; Even a restart/retained-inventory refusal must dispose this attempt's
   ;; pure SDK-issued resource ticket. All gates share the cleanup extent.
   (let [persisted (q/declaration srv)
       _ (when (and (:generation persisted)
                    (not= (:generation persisted) (get-in handler [:decl :generation])))
           (refuse :restart-generation-mismatch))
       required (keys (:required-generations (q/generation-inventory srv)))
       supplied (set (cons (get-in handler [:decl :generation])
                           (map #(get-in % [:decl :generation]) (:retained opts []))))
       _ (when-not (every? #(contains? supplied %) required) (refuse :missing-retained-generation))] :checked)
   (q/register-perform! srv (:perform handler) (:contract handler))
   (let [st (q/init-state srv (:decl handler) (:clock handler) (:contract handler))
         digest (get-in st [:queue :decl :generation])
         ;; Replace the clause's direct callback lease with one full sealed
         ;; handler graph lease. Parent actor ownership is a separate lifetime.
         current (try (assoc handler :lease (retain handler))
                   (finally (BeamLisp.Env/release_code! (get-in st [:queue :perform-lease]))))
         _ (swap! held assoc digest current)
         _ (doseq [h (:retained opts [])]
             (let [id (get-in h [:decl :generation])]
              (when (or (contains? @held id) (not= (fixed-shape (:decl current)) (fixed-shape (:decl h))))
               (refuse :invalid-retained-handler))
              (swap! held assoc id (assoc h :lease (retain h)))))
         initializer (execution/runtime-owner)
         _ (when initializer (reset! adopted (framework/adopt! initializer)))
         _ (reset! registered (owners/register-owned-role! :queue {:reference srv}))
         capability (owners/current-owner-capability)
         evidence {:pid (erlang/self) :ticket (or (:proof-id @registered) (erlang/make_ref))
                   :application-id (q/application-id srv) :inventory @registered}
         after (-> st
                   (update :queue merge (select-keys current [:modules :environment])
                     {:perform-lease (:lease current) :lease (:lease current) :handlers @held :inventory @registered
                      :framework @adopted :owner-evidence evidence}))]
    (erlang/apply :persistent_term :put (list (registry-key srv) evidence))
    (reset! published evidence)
    (when-let [reconcile (:reconcile current)]
     (reconcile-handler/accept! current)
     (when-not @adopted (refuse :reconcile-initializer-required))
     ;; Adoption has removed Source authority/full native actor retention.
     ;; Only this exact native actor may publish the handler-family receipt.
     (family/publish-shared-handler! (q/server-name srv) (:family reconcile)
       (:graph reconcile) (:lease current))
     (swap! canonical-instances assoc (q/server-name srv)
       {:owner (dissoc evidence :inventory) :family (:family reconcile) :start-context (:start-context reconcile)}))
    (when (:reconcile current) (reconcile-handler/activate-resources! current))
    (with-current after
     #(do (when (:reconcile current)
            (reconcile-handler/invoke! current :pump [])
            (reconcile-handler/invoke! current :arm []))
          (q/arm-first srv (:clock current)) (q/run-due after))))
   (catch error
    (try
     (when (and @published (= @published (erlang/apply :persistent_term :get (list (registry-key srv) nil))))
      (erlang/apply :persistent_term :erase (list (registry-key srv))))
     (owners/unregister! @registered)
     (finally
      (try
       (when (and (:reconcile handler) (empty? @held)) (reconcile-handler/close! handler))
       (doseq [h (vals @held)] (release h))
       (finally (framework/close! @adopted)))))
    (throw error)))))

(defn- handler-refusal [st handler]
 (try
  (when-not (and (erlang/is_map handler) (not (maps/is_key :__struct__ handler)))
   (refuse :invalid-queue-handler))
  (let [old (get-in st [:queue :handlers (get-in st [:queue :decl :generation])])]
   (if (or (:reconcile old) (maps/get :reconcile handler nil))
    (reconcile-handler/attested! handler)
    (do
     (when-not (and (keyword? (:server handler))
                    (erlang/is_map (:decl handler)) (not (maps/is_key :__struct__ (:decl handler)))
                    (erlang/is_function (:perform handler) 1) (erlang/is_function (:clock handler) 0))
      (refuse :invalid-queue-handler))
     (q/normalise-decl (:decl handler)))))
  nil
  (catch error
   (if (= :unsealed-reconcile-handler (:kind (ex-data error)))
    :unsealed-reconcile-handler :invalid-queue-handler))))
(defn- activation-blocker [st expected handler]
 (let [current (:queue st) srv (:server current)
       target (get-in handler [:decl :generation]) now (get-in current [:decl :generation])
       retained (get-in current [:handlers target])]
  (cond
   (= target now) (when-not (reconcile-handler/same-meaning? retained handler) :identity-conflict)
   (not= expected now) :stale-generation
   (not= (q/server-name srv) (q/server-name (:server handler))) :wrong-queue
   (not= (fixed-shape (:decl current)) (fixed-shape (:decl handler))) :queue-identity-migration-required
   (not= (:clock current) (:clock handler)) :clock-migration-required
   (< (get-in handler [:decl :protocol]) (get-in current [:decl :protocol])) :protocol-regression
   (and retained (not (reconcile-handler/same-meaning? retained handler))) :identity-conflict
   :else nil)))
(defn- activation-proof [st expected handler]
 (if-let [invalid (handler-refusal st handler)] {:status :refused :kind invalid}
  (let [blocker (activation-blocker st expected handler)
        srv (get-in st [:queue :server]) target (get-in handler [:decl :generation])]
   (cond (get-in st [:queue :transition-pending]) {:status :waiting :kind :queue-transition-outcome-uncertain}
         blocker {:status :refused :kind blocker}
         (contains? (:fenced-generations (q/generation-inventory srv)) target)
          {:status :refused :kind :generation-fenced}
         :else {:status :ready :generation (get-in st [:queue :decl :generation])}))))
(defn- installed-state [st handler lease]
 (assoc st :queue
  (merge (:queue st) (select-keys handler [:decl :perform :clock :contract :environment :modules])
    {:perform-lease lease :lease lease
     :handlers (assoc (get-in st [:queue :handlers]) (get-in handler [:decl :generation]) handler)
     :transition-pending nil})))
(defn- publish-installed! [st handler]
 (let [srv (get-in st [:queue :server]) reconcile (:reconcile handler)]
  (when reconcile
   (family/publish-shared-handler! (q/server-name srv) (:family reconcile)
     (:graph reconcile) (:lease handler))
   (reconcile-handler/activate-resources! handler))
  ;; Actual Source/provider work starts on a subsequent actor turn, AFTER the
  ;; new state is installed. A response loss cannot replay an accepted pump.
  (erlang/send (erlang/self) (tuple :bl-queue/wake))
  (when reconcile (erlang/send (erlang/self) (tuple :bl-reconcile/level)))
  st))
(defn- finish-install [st handler durability]
 (let [after (installed-state st handler (:lease handler))]
  (try
   (publish-installed! after handler)
   [{:status :applied :generation (get-in handler [:decl :generation]) :durability durability} after]
   (catch _
    ;; The native durable write has already happened. Preserve candidate AND
    ;; previous handler resources/leases; no effect cancellation or replay.
    [{:status :waiting :kind :queue-handler-publication-uncertain}
     (assoc-in after [:queue :transition-pending] {:handler handler :phase :publication})]))))
(defn- activate [st expected handler]
 (if-let [invalid (handler-refusal st handler)] [{:status :refused :kind invalid} st]
 (let [current (:queue st) srv (:server current)
       target (get-in handler [:decl :generation]) now (get-in current [:decl :generation])
       retained (get-in current [:handlers target]) blocker (activation-blocker st expected handler)
       pending (:transition-pending current)]
  (cond
   pending
    (try
    (let [held (:handler pending) actual (q/declaration srv)]
     (cond
      (not (reconcile-handler/same-meaning? held handler))
       [{:status :refused :kind :identity-conflict} st]
      (and (= target (:generation actual))
              (= (assoc (:decl held) :server (q/server-name srv)) actual))
      ;; Native metadata reconciliation only. No callback/provider/initializer
      ;; effect ran inside the failed publication turn, and none is replayed.
       (finish-install st held (sync (q/conn srv)))
      :else [{:status :waiting :kind :queue-transition-outcome-uncertain} st]))
    (catch _ [{:status :waiting :kind :queue-transition-outcome-uncertain} st]))
   blocker [{:status :refused :kind blocker} st]
   (= target now) [{:status :already-applied :generation target :durability (sync (q/conn srv))} st]
   :else
    (let [lease (if retained (:lease retained) (retain handler))
          installed (or retained (assoc handler :lease lease)) c (q/conn srv)
          submitted (atom false)]
     (try
      (reconcile-handler/accept! installed)
      (let [durability (dc/serialized! c
                         (fn []
                          (when (contains? (:fenced-generations (q/generation-inventory srv)) target)
                           (refuse :generation-fenced))
                          (reset! submitted true)
                          (d/transact! c [{:db/id -1 :queue/key (q/server-name srv)
                              :queue/decl (assoc (:decl handler) :server (q/server-name srv))}])
                          (sync c)))]
       (finish-install st installed durability))
      (catch error
       (if @submitted
        [{:status :waiting :kind :queue-transition-outcome-uncertain}
         (-> st
          (assoc-in [:queue :handlers target] installed)
          (assoc-in [:queue :transition-pending] {:handler installed :phase :durable-write}))]
        (do (when-not retained (release installed)) (throw error))))))))))

(defn- retire [st generation]
 (let [queue (:queue st) srv (:server queue) handler (get (:handlers queue) generation)
       running (count (filter #(= generation (:generation %)) (vals (:running queue))))
       retained (get-in (q/generation-inventory srv) [:required-generations generation] 0)]
  (cond
   (= generation (get-in queue [:decl :generation])) [{:status :refused :kind :current-generation} st]
   (or (pos? running) (pos? retained)) [{:status :waiting :running running :jobs retained} st]
   (nil? handler)
    (let [fenced (q/fence-generation! srv generation)
          after (get-in (q/generation-inventory srv) [:required-generations generation] 0)]
     (if (pos? after) [{:status :waiting :jobs after :running 0} st]
      [{:status :already-retired :durability (:durability fenced)} st]))
   :else
    (let [fenced (q/fence-generation! srv generation)
          after (get-in (q/generation-inventory srv) [:required-generations generation] 0)]
     (if (pos? after) [{:status :waiting :jobs after :running 0} st]
      (do (release handler)
          [{:status :retired :generation generation :durability (:durability fenced)}
           (update-in st [:queue :handlers] dissoc generation)]))))))

(defn- close-state! [st]
 (let [q (:queue st) srv (:server q) evidence (:owner-evidence q)]
  (try
   (owners/unregister! (:inventory q))
   (finally
    (try
     (when (= evidence (erlang/apply :persistent_term :get (list (registry-key srv) nil)))
      (erlang/apply :persistent_term :erase (list (registry-key srv))))
     (when (= (dissoc evidence :inventory) (:owner (get @canonical-instances (q/server-name srv))))
      (swap! canonical-instances dissoc (q/server-name srv)))
     (doseq [handler (vals (:handlers q))] (release handler))
     (finally (framework/close! (:framework q)))))))
 :ok)

(ps/defserver owner
 (init [opts] (ok (initial opts)))
 (handle-info [:DOWN ref :process pid _] [st]
  (if (framework/initializer-down? (get-in st [:queue :framework]) ref pid)
   (stop :normal st) (noreply st)))
 (handle-info [:bl-queue/wake] [st]
  (noreply (if (get-in st [:queue :transition-pending]) st (with-current st #(q/run-due st)))))
 (handle-info [:datom/tx _basis _datoms] [st]
  (noreply (if (get-in st [:queue :transition-pending]) st (with-current st #(q/run-due st)))))
 (handle-info [:bl-queue/finished ref out] [st]
  (noreply (with-current st
    #(let [settled (q/settle st ref out)]
       (if (get-in settled [:queue :transition-pending]) settled (q/run-due settled))))))
 (handle-call [:proc.queue-runtime/rehearse expected handler] [_ st]
  (reply (with-current st #(activation-proof st expected handler)) st))
 (handle-call [:proc.queue-runtime/activate expected handler] [_ st]
  ;; SDK metadata publication must not inherit a Source callback's authority.
  ;; Explicit Source work borrows its exact selected handler inside activate.
  (let [[result after] (activate st expected handler)] (reply result after)))
 (handle-call [:proc.queue-runtime/retire generation] [_ st]
  (let [[result after] (with-current st #(retire st generation))] (reply result after)))
 (handle-info [:bl-reconcile/level] [st]
  (let [handler (get-in st [:queue :handlers (get-in st [:queue :decl :generation])])]
   (when (and (:reconcile handler) (not (get-in st [:queue :transition-pending])))
    (with-current st #(do (reconcile-handler/invoke! handler :pump [])
                         (reconcile-handler/invoke! handler :arm []))))
   (noreply st)))
 (handle-call [:reconcile-status] [_ st]
  (let [handler (get-in st [:queue :handlers (get-in st [:queue :decl :generation])])]
   (reply (with-current st #(reconcile-handler/invoke! handler :status [])) st)))
 (handle-call [:reconcile-pump] [_ st]
  (let [handler (get-in st [:queue :handlers (get-in st [:queue :decl :generation])])]
   (reply (with-current st #(reconcile-handler/invoke! handler :pump [])) st)))
 (handle-call [:reconcile-retry id] [_ st]
  (reply (with-current st #(q/retry! (get-in st [:queue :server]) id)) st))
 (handle-call [:proc.queue-runtime/status] [_ st]
  (reply {:generation (get-in st [:queue :decl :generation])
          :retained (vec (keys (get-in st [:queue :handlers])))
          :running (count (get-in st [:queue :running]))
          :pending (when (get-in st [:queue :transition-pending]) :native-transition-uncertain)} st))
 (handle-call [:stats] [_ st] (reply (with-current st #(q/stats (get-in st [:queue :server]))) st))
 (handle-call [:enqueue job opts] [_ st]
  (reply (with-current st #(q/enqueue! (get-in st [:queue :server]) job opts)) st))
 (terminate [_ st] (close-state! st)))

(defn owner-evidence
 "Read the physical shared-queue registration without asking an arbitrary actor.
  Older registrations retain transition authority but lack inventory tickets."
 [srv]
 (let [pid (Process/whereis (q/op-name srv))
       registered (erlang/apply :persistent_term :get (list (registry-key srv) nil))
       evidence (if (map? registered) registered {:pid registered})]
  (when (and pid (= pid (:pid evidence)) (Process/alive? pid)
             (or (nil? (:inventory evidence)) (owners/owned-role-live? (:inventory evidence))))
   (dissoc evidence :inventory))))
(defn ready?
 "Only a shared native owner may receive runtime transitions. Custom servers
  keep their existing behavior and require an explicit migration authority."
 [srv]
 (some? (owner-evidence srv)))
(defn stop!
 "Stop only this queue's registered shared-native owner, synchronously. Used by
  lifecycle cleanup before closing its declared stores. Accepted jobs and the
  durable connection binding remain; active attempts keep their own code leases
  and native lifetime fences. Repeated cleanup of a dead owner is harmless.
  A custom queue server never grants stop authority through its name alone."
 [srv]
 (let [pid (Process/whereis (q/op-name srv))
       evidence (owner-evidence srv)]
  (cond
   (nil? pid) {:status :already-stopped :server srv}
   (not= pid (:pid evidence)) {:status :refused :kind :owner-transition-authority-required :server srv}
   :else
    (try
     (GenServer/stop pid :normal 30000)
     {:status :stopped :server srv}
     (catch e
      (if (Process/alive? pid) (throw e) {:status :already-stopped :server srv}))))))

(defn- owner-pid [srv]
 (when-not (ready? srv) (refuse :owner-transition-authority-required))
 (Process/whereis (q/op-name srv)))
(defn- with-restoration [srv action]
 (BeamLisp.Env/with_generation_lock (tuple :queue-restoration (q/server-name srv)) action))
(defn- stage [srv]
 (let [token (erlang/apply :persistent_term :get (list (restoration-key srv) nil))]
  (if (and token (not (Process/alive? (:owner token))))
   (do
    (erlang/apply :persistent_term :erase (list (restoration-key srv)))
    (BeamLisp.Env/release_code! (:lease token))
    nil)
   token)))

(defn restore!
 "Stage sealed handlers under this queue's native admission authority. Competing
  stagers serialize; a dead stager's exact lease is reclaimed on the next turn.
  Startup consumption and stale cleanup use the same per-queue authority."
 [srv target handlers]
 (let [srv (q/resolve-server srv)]
  (with-restoration srv
   (fn []
    (when (or (q/serving? srv) (stage srv)) (refuse :restoration-already-bound))
    (let [by-generation (into {} (map (fn [handler]
                                  (when-not (= (q/server-name srv) (q/server-name (:server handler))) (refuse :wrong-queue))
                                  [(get-in handler [:decl :generation]) handler]) handlers))
          _ (when-not (and (= (count handlers) (count by-generation))
                            (contains? by-generation target)) (refuse :invalid-restoration-inventory))
          _ (when-not (apply = (map #(fixed-shape (:decl %)) handlers)) (refuse :queue-identity-migration-required))
          lease (BeamLisp.Env/retain_code! (to-list (distinct (mapcat :modules handlers))))
          token {:server srv :target target :handlers by-generation :lease lease
                 :owner (erlang/self) :ticket (erlang/make_ref)}]
     (erlang/apply :persistent_term :put (list (restoration-key srv) token))
     token)))))

(defn release-restoration!
 "Release only the exact unconsumed stage under its queue authority. Cleanup
  cannot remove a newer stage; live owners have independent callback leases."
 [token]
 (with-restoration (:server token)
  (fn []
   (when (= token (erlang/apply :persistent_term :get (list (restoration-key (:server token)) nil)))
    (erlang/apply :persistent_term :erase (list (restoration-key (:server token))))
    (BeamLisp.Env/release_code! (:lease token)))
   :released)))

(defn start!
 "Consume restoration and start the native owner in one per-queue admission
  turn. A failed start retains the stage for recovery while its stager lives."
 ([handler] (start! handler {}))
 ([handler opts]
  (let [srv (:server handler)]
   (with-restoration srv
    (fn []
     (let [staged (stage srv)
           start-owner (fn []
             (let [current (:generation (q/declaration srv) (get-in handler [:decl :generation]))
                   by-generation (if staged (:handlers staged)
                                  (into {(get-in handler [:decl :generation]) handler}
                                    (map (fn [h] [(get-in h [:decl :generation]) h]) (:retained opts []))))
                   chosen (get by-generation current)
                   _ (when-not chosen (refuse :restart-generation-mismatch))
                   retained (vec (vals (dissoc by-generation current)))]
              (let [previous (BeamLisp.Env/capture)]
               (try
                (BeamLisp.Env/bind (:environment chosen))
                (core/start owner {:handler chosen :retained retained} (dissoc opts :retained))
                (finally (BeamLisp.Env/bind previous))))))]
      (if staged
       (do
        (when-not (= (:target staged) (get-in handler [:decl :generation])) (refuse :restoration-target-mismatch))
        (let [pid (BeamLisp.Env/run_code! (:lease staged) start-owner)]
         (when (= :cancelled pid) (refuse :expired-restoration-lease))
         (release-restoration! staged)
         pid))
       (start-owner))))))))
(defn rehearse! [srv expected handler]
 (GenServer/call (owner-pid srv) [:proc.queue-runtime/rehearse expected handler]))
(defn activate! [srv expected handler]
 (GenServer/call (owner-pid srv) [:proc.queue-runtime/activate expected handler] 30000))
(defn retire! [srv generation]
 (GenServer/call (owner-pid srv) [:proc.queue-runtime/retire generation] 30000))
(defn status [srv] (GenServer/call (owner-pid srv) [:proc.queue-runtime/status]))


(defn family-handlers
 "Automatic first-party contribution from real living shared native instances.
  No status/factory/provider reconstruction and no app coordinator. Canonical
  instance operands were captured as bounded first-order data at actual init.
  Unknown embedded/composed actors remain retained/drain obligations."
 [candidate]
 (let [app (:application-id candidate) plan (family/plan! candidate) made (atom {})]
  (try
   (doseq [member (get-in plan [:receipt :members])]
    (when (and (= :shared-reconcile (:owner-mode member))
               (not= (:digest candidate) (:handler-generation member)))
     (let [server (:server member) saved (get @canonical-instances server)
           evidence (owner-evidence (keyword server))
           recipe (get-in candidate [:declarations :reconcile (:family member) :data :canonical])]
      (when-not (and evidence (= evidence (:owner saved))
                     (= (:family member) (:family saved)) recipe
                     (= app (:application-id member)))
       (refuse :sealed-family-reifier-required))
      (let [handler (reconcile-handler/prepare-instance! candidate recipe (:start-context saved) (keyword server) false)
            srv (:server handler)]
       (swap! made assoc srv
        {:expected (:handler-generation member) :handler handler})))))
   @made
   (catch error
    ;; Earlier instances produced only pure, unaccepted bookkeeping. A later
    ;; identity/refusal must not leak those private Source graph references.
    (doseq [[_ entry] @made] (reconcile-handler/discard-prepared! (:handler entry)))
    (throw error)))))
(defn discard-prepared-handler!
 "Release only never-installed pure-reification resource tickets. An accepted
  actor handler is disposed exclusively by its native durable drain path."
 [handler] (reconcile-handler/discard-prepared! handler))
