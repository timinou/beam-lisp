; Replayable same-runtime transition plans. Sealing and durable step journal
; belong to the deployment coordinator; native owners remain authoritative.
(ns proc.transition
 (:require [proc.queue-runtime :as runtime] [proc.queue :as queue]
           [proc.evolve :as evolve] [proc.fence :as fence] [datom.conn :as dc] [datom :as d] [datom.db :as db] [datom.attr-basis :as ab]))

(defn- refuse [kind] (throw (ex-info "Process transition refused" {:kind kind})))
(defn prepare!
 "Prepare under the candidate generation's execution context. Queue descriptors
  contain :declaration/:perform and optional :contract/:clock/:modules. Owner
  descriptors contain :pid/:expected/:spec and explicit :queues dependencies.
  :adoption per queue is absent (drain exact old handler) or a declared payload
  migration {:digest :protocol :upcast :accept?}. No failed jobs are retried.
  Prepared owner grants are VM-local. Restart never replays an unknown conversion;
  a new plan requires actual native-owner outcome reconciliation."
 [spec]
 (when (> (+ (count (:queues spec {})) (count (:owners spec {}))) 128)
  (refuse :transition-inventory-too-large))
 (let [grants (atom []) family-handlers (atom {})]
 (try
 (let [generation (Process/get :bl_generation) digest (:digest generation)
       _ (when-not (and (BeamLisp.Env/executing_generation? generation) (string? digest) (seq digest)) (refuse :sealed-generation-required))
       automatic (runtime/family-handlers generation)
       _ (reset! family-handlers automatic)
       _ (when (> (+ (count automatic) (count (:queues spec {})) (count (:owners spec {}))) 128)
           (refuse :transition-inventory-too-large))
       queues-explicit (into {} (map (fn [[srv descriptor]]
                        (when-not (runtime/ready? srv) (refuse :owner-transition-authority-required))
                        (let [old (:expected-generation descriptor (:previous-generation spec))
                              now (:generation (runtime/status srv))
                              handler (runtime/prepare srv descriptor)
                              adoption (:adoption descriptor)]
                         (when (and adoption
                                    (not (and (= (:protocol adoption) (get-in handler [:decl :protocol]))
                                              (string? (:digest adoption)) (= 64 (count (:digest adoption)))
                                              (every? (fn [ch] (includes? "0123456789abcdefABCDEF" ch)) (String/graphemes (:digest adoption)))
                                              (erlang/is_function (:upcast adoption) 1)
                                              (erlang/is_function (:accept? adoption) 1))))
                          (refuse :invalid-adoption-contract))
                         (when-not (and (string? old) (not= old digest)
                                        (contains? #{old digest} now))
                          (refuse :previous-generation-required))
                         [(:server handler) {:expected old :handler handler :adoption (:adoption descriptor)}]))
                       (:queues spec {})))
       _ (when (some #(contains? automatic %) (keys queues-explicit))
           (refuse :duplicate-native-family-transition))
       queues (merge automatic queues-explicit)
       owners (into {} (map (fn [[id descriptor]]
                        (let [native (evolve/owner-evidence (:pid descriptor))
                              _ (when-not (and native (= (:application-id generation) (:application-id native)))
                                  (refuse :owner-transition-application-mismatch))
                              state (evolve/status (:pid descriptor))
                              grant (BeamLisp.Env/begin_owner_transition! (:pid descriptor))
                              _ (swap! grants conj grant)]
                         (when-not (and (:managed state)
                                        (or (= (:expected descriptor) (:version state))
                                            (and (= (get-in descriptor [:spec :version]) (:version state))
                                                 (= digest (:digest state))))
                                        (= digest (get-in descriptor [:spec :digest])))
                          (refuse :managed-owner-contract-mismatch))
                         (doseq [[key arity] [[:handler 2] [:check-state 1] [:accept? 1] [:migrate-state 1] [:upcast 1]]]
                          (when-not (erlang/is_function (get-in descriptor [:spec key]) arity)
                           (refuse :invalid-owner-callback)))
                         [id (assoc (update (update descriptor :queues #(mapv queue/resolve-server %)) :spec
                               #(update (evolve/prepare-spec %) :modules (fn [modules]
                                   (vec (distinct (concat modules (:modules generation []))))))) :grant grant)])) (:owners spec {})))
       lease (BeamLisp.Env/retain_code! (to-list (distinct (concat (:modules generation [])
                                      (mapcat (fn [entry] (get-in entry [:handler :modules])) (vals queues))))))]
  {:generation digest :queues queues :owners owners :lease lease :closed (atom false)
   :owner-receipts (atom {})})
 (catch error
  (doseq [[_ entry] @family-handlers]
   (runtime/discard-prepared-handler! (:handler entry)))
  (doseq [grant @grants] (try (BeamLisp.Env/abandon_owner_transition! grant) (catch _ nil)))
  (throw error)))))

(defn- live! [plan] (when @(:closed plan) (refuse :closed-transition)))
(defn- inventory-proof [c database]
 ;; These are committed WRITE markers, never reader hints/in-flight markers.
 ;; Journal-only writes on a shared store must not invalidate queue pagination.
 (let [attrs (mapv :db/ident queue/SCHEMA)]
  {:inventory-marks (select-keys (ab/committed-marks (:store c)) attrs)
   :schema-digest (erlang/apply :crypto :hash (list :sha256 (erlang/term_to_binary (select-keys (db/schema-of database) attrs) (list :deterministic))))}))
(defn- same-inventory? [receipt proof]
 (and (= (:inventory-marks receipt) (:inventory-marks proof))
      (= (:schema-digest receipt) (:schema-digest proof))))
(defn- queue-validation [srv entry opts]
 (let [authority (runtime/rehearse! srv (:expected entry) (:handler entry))]
 (when-not (= :ready (:status authority)) (refuse (:kind authority :stale-runtime-authority)))
 (if-not (:adoption entry)
  {:status :valid :scope :retained-old-handler :validated 0 :scanned 1}
  (let [c (queue/conn srv) cursor (get (:after opts {}) srv)
        snapshot (dc/serialized! c
                   (fn []
                    (let [db (d/db c) basis (d/basis-t db) proof (inventory-proof c db)]
                     (when (and cursor (not (same-inventory? cursor proof))) (refuse :stale-validation-inventory))
                     (let [page (d/attribute-page db :job/state (:after-eid cursor) (:limit opts 100))]
                      (merge proof {:basis basis :after-eid (:after-eid page) :more? (:more? page) :scanned (count (:datoms page))
                       :jobs (vec (keep (fn [datom]
                                         (let [job (d/entity db (d/datom-e datom))]
                                          (when (and (nil? (queue/adoption-blocker job))
                                                     (= (:expected entry) (:job/required-generation job (:job/generation job)))) job)))
                                       (:datoms page)))})))))
        prior (BeamLisp.Env/capture)
        result (try
                (BeamLisp.Env/bind (get-in entry [:handler :environment]))
                (fence/fence-fn (:ms opts 250)
                 #(dc/observing
                   (fn []
                    (doseq [job (:jobs snapshot)]
                     (let [adoption (:adoption entry)
                           converted ((:upcast adoption) (:job/adopted-payload job (:job/payload job)))
                           accept (get-in entry [:handler :contract :accept?])]
                      (when-not (and (= true ((:accept? adoption) converted))
                                     (or (nil? accept) (= true (accept converted))))
                       (refuse :invalid-adoption-payload))))
                    true)))
                (finally (BeamLisp.Env/bind prior)))]
   (if-not (contains? result :ok)
    {:status :refused :kind (if (:timeout result) :rehearsal-deadline :invalid-adoption-payload)}
    {:status (if (:more? snapshot) :more :valid) :scope :observed-queue-inventory
     :basis (:basis snapshot) :inventory-marks (:inventory-marks snapshot) :schema-digest (:schema-digest snapshot) :after-eid (:after-eid snapshot) :more? (:more? snapshot)
     :validated (count (:jobs snapshot)) :scanned (:scanned snapshot) :preserved (- (:scanned snapshot) (count (:jobs snapshot))) :jobs (mapv :job/id (:jobs snapshot))})))))

(defn validate!
 "Globally bounded rehearsal: :limit total scanned groups/owner callbacks,
  :ms total callback-work deadline; FIFO writer/actor admission waits may exceed
  that deadline. :previous persists queue/owner proofs and a fair task cursor.
  Metadata traversal is capped at 128 registered participants. :after queue
  cursors remain supported. :valid covers observed inventory/revisions only;
  recheck! before publication, retain old handlers for future producer work."
 ([plan] (validate! plan {}))
 ([plan opts]
  (live! plan)
  (when-not (and (erlang/is_integer (:limit opts 100)) (<= 1 (:limit opts 100) 1000)
                (erlang/is_integer (:ms opts 250)) (<= 1 (:ms opts 250) 30000))
   (refuse :invalid-rehearsal))
  (let [previous (:previous opts)
        _ (when (and previous (not= (:generation plan) (:generation previous))) (refuse :invalid-validation-receipt))
        tasks (vec (concat (map (fn [[id entry]] [:queue id entry]) (sort-by #(str (first %)) (:queues plan)))
                           (map (fn [[id entry]] [:owner id entry]) (sort-by #(str (first %)) (:owners plan)))))
        n (count tasks) started (erlang/monotonic_time :millisecond)
        initial-queues (:queues previous (:after opts {})) initial-owners (:owners previous {})]
   (loop [visited 0 cursor (if (zero? n) 0 (mod (:cursor previous 0) n))
          left (:limit opts 100) queues initial-queues owners initial-owners
          turn {:scanned 0 :validated 0 :preserved 0 :owners 0}]
    (let [remaining (- (:ms opts 250) (- (erlang/monotonic_time :millisecond) started))]
     (if (or (= visited n) (zero? left) (<= remaining 0))
      (let [rows (concat (vals queues) (vals owners)) complete? (= n (+ (count queues) (count owners)))]
       {:status (cond (some #(= :refused (:status %)) rows) :refused
                      (and complete? (every? #(= :valid (:status %)) rows)) :valid :else :more)
        :scope :observed-inventory :generation (:generation plan) :queues queues :owners owners
        :cursor cursor :turn turn :elapsed-ms (- (erlang/monotonic_time :millisecond) started)})
      (let [[kind id entry] (nth tasks cursor) rows (if (= kind :queue) queues owners)
            prior (get rows id) next-cursor (mod (inc cursor) n)]
       (if (= :valid (:status prior))
        (recur (inc visited) next-cursor left queues owners turn)
        (let [row (try
                    (if (= kind :queue)
                     (queue-validation id entry {:limit left :ms remaining :after queues})
                     (let [prior (evolve/transition-status (:pid entry) (:grant entry))
                           prepared (if (contains? #{:prepared :applied} (:status prior)) prior
                                      (evolve/prepare-transition! (:pid entry) (:grant entry) (:expected entry) (:spec entry)))
                           row (if (contains? #{:prepared :applied} (:status prepared))
                                 (assoc prepared :status :valid) prepared)]
                      (swap! (:owner-receipts plan) assoc id row) row))
                    (catch e {:status :refused :kind (or (:kind (ex-data e)) :rehearsal-failed)}))
              cost (if (= kind :queue) (max 1 (:scanned row 0)) 1)
              after-turn (if (= kind :queue)
                           (-> turn (update :scanned + cost) (update :validated + (:validated row 0))
                                    (update :preserved + (:preserved row 0))) (update turn :owners inc))]
         (recur (inc visited) next-cursor (max 0 (- left cost))
                (if (= kind :queue) (assoc queues id row) queues)
                (if (= kind :owner) (assoc owners id row) owners) after-turn))))))))))

(defn recheck!
 "Recheck a completed observed-inventory receipt under native queue writers and
  owner FIFO authority. Does not rerun candidate callbacks or admit future work.
  A stale receipt requires fresh bounded validation before publication intent."
 [plan receipt]
 (live! plan)
 (when-not (and (= :valid (:status receipt)) (= (:generation plan) (:generation receipt)))
  (refuse :invalid-validation-receipt))
 (let [queues (into {} (map (fn [[srv entry]]
                     [srv (if-not (and (runtime/ready? srv)
                                       (= :ready (:status (runtime/rehearse! srv (:expected entry) (:handler entry)))))
                       {:status :stale}
                       (if-not (:adoption entry) {:status :current}
                       (dc/serialized! (queue/conn srv)
                        (fn []
                         (let [c (queue/conn srv) proof (inventory-proof c (d/db c))]
                          {:status (if (same-inventory? (get-in receipt [:queues srv]) proof) :current :stale)})))))]) (:queues plan)))
       owners (into {} (map (fn [[id entry]]
                     [id (if-not (evolve/owner? (:pid entry)) {:status :stale}
                       (let [state (evolve/transition-status (:pid entry) (:grant entry))
                             observed (get-in receipt [:owners id])]
                        {:status (if (and (contains? #{:prepared :applied} (:status state))
                                          (= (:version state) (:version observed))
                                          (= (:revision state 0) (:revision observed))) :current :stale)}))]) (:owners plan)))
       current? (every? #(= :current (:status %)) (concat (vals queues) (vals owners)))]
  {:status (if current? :current :stale) :generation (:generation plan) :queues queues :owners owners}))

(defn activate!
 "FIFO publication inside each native owner, idempotent across partial batches.
  This does not claim a multi-actor atomic commit. The deployment journal stores
  intent before calling and reconciles the exact last committed native ticket;
  conversion callbacks are never rerun to recover a lost acknowledgment."
 [plan]
 (live! plan)
 (let [queues (into {} (map (fn [[srv entry]]
                         [srv (runtime/activate! srv (:expected entry) (:handler entry))]) (:queues plan)))
       owners (into {} (map (fn [[id entry]]
                         (doseq [srv (:queues entry [])]
                          (let [r (evolve/bind-queue! (:pid entry) srv)]
                           (when-not (= :bound (:status r)) (refuse :owner-dependency-refused))))
                         [id (evolve/commit-transition! (:pid entry) (:grant entry))]) (:owners plan)))
       successful? (fn [r] (contains? #{:applied :already-applied} (:status r)))]
  {:status (if (every? successful? (concat (vals queues) (vals owners))) :applied :blocked)
   :queues queues :owners owners}))

(defn adopt!
 "At most limit explicit nonrunning payload adoptions. Retains original
  identities and provenance, never requeues failed/held work or guesses a
  provider outcome. Running jobs continue under the retained exact handler."
 [plan limit]
 (live! plan)
 (when-not (and (erlang/is_integer limit) (pos? limit) (<= limit 1000)) (refuse :invalid-batch-limit))
 (loop [entries (vec (:queues plan)) left limit results []]
  (if (or (zero? left) (empty? entries)) {:status :batched :results results}
   (let [[srv entry] (first entries) adoption (:adoption entry)
         jobs (when adoption
               (let [db (d/db (queue/conn srv))]
                (take left (keep (fn [[id state]]
                              (when (contains? #{:queued :failed :held} state)
                               (let [j (d/entity db id)]
                                (when (and (nil? (queue/adoption-blocker j))
                                           (= (:expected entry) (:job/required-generation j (:job/generation j)))) j))))
                             (d/q '[:find ?e ?s :where [?e :job/state ?s]] db)))))
         batch (mapv (fn [j]
                 {:server srv :id (:job/id j)
                  :result (queue/adopt-generation! srv (:db/id j) (:expected entry)
                             (:generation plan) adoption)}) jobs)]
    (recur (vec (rest entries)) (- left (count batch)) (into results batch))))))

(defn retire!
 "Release exact old queue handlers only after durable dependencies and active
  attempts drain. Release proc.evolve adapters only using their native managed
  lease/inventory proof. Framework callers must separately close serving graph
  admissions before destructive schema work. No Boolean proves retirement."
 [plan]
 (live! plan)
 (let [queues (into {} (map (fn [[srv entry]] [srv (runtime/retire! srv (:expected entry))]) (:queues plan)))
       owners (into {} (map (fn [[id entry]]
                         [id (evolve/retire! (:pid entry) (get-in entry [:spec :version]) (:expected entry))])
                        (:owners plan)))
       retired? (fn [r] (contains? #{:retired :already-retired} (:status r)))]
  {:status (if (every? retired? (concat (vals queues) (vals owners))) :retired :waiting)
   :queues queues :owners owners}))

(defn close!
 "Release preparation's native code lease; runtime owners retain published
  callbacks independently. Closing never cancels accepted durable jobs."
 [plan]
 (when (compare-and-set! (:closed plan) false true)
  (doseq [[_ entry] (:owners plan)]
   (try
    (let [status (evolve/transition-status (:pid entry) (:grant entry))]
     (if (= :prepared (:status status))
      (evolve/cancel-transition! (:pid entry) (:grant entry))
      (when-not (= :applied (:status status)) (BeamLisp.Env/abandon_owner_transition! (:grant entry)))))
    ;; Uncertain accepted outcomes remain held; close does not make retry safe.
    (catch _ nil)))
  (doseq [[_ entry] (:queues plan)] (runtime/discard-prepared-handler! (:handler entry)))
  (BeamLisp.Env/release_code! (:lease plan)))
 :closed)
