; Node-local serialization without a callback-owning application actor.
(ns proc.mutex (:require [proc.instance :as instance]))

(defn with!
 "Run action on the calling process under a reentrant, application-scoped
  logical mutex. Exact native tickets recover dead holders. This is local
  serialization, not distributed storage consistency or a FIFO scheduler.
  Keep actions finite and never acquire locks in inconsistent order."
 [logical action]
 (when-not (and (or (keyword? logical)
                    (and (string? logical) (<= 1 (erlang/byte_size logical) 256)))
                (fn? action))
  (throw (ex-info "A logical mutex requires a bounded name and action"
           {:kind :invalid-mutex})))
 (BeamLisp.Env/with_generation_lock
  (tuple :proc.mutex (instance/identity logical)) action))
