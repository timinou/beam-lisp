; Native Task result/monitor semantics with automatic Env and executable lifetime.
(ns proc.task)

(defn async
 "Start linked work with captured Env/query authority and retained executable
  code. Returns an ordinary OTP Task; await/yield/shutdown preserve Task semantics.
  Managed callers retain their whole sealed graph automatically."
 [action] (BeamLisp.Refs/task_exec action :link))
(defn async-nolink
 "Start unlinked work. Unlink happens before action publication, so accepted
  work survives caller death and keeps its code lease until actual completion.
  A yield timeout only stops waiting; it does not cancel or make effects safe
  to replay. The owner must choose an explicit shutdown only when safe."
 [action] (BeamLisp.Refs/task_exec action :plain))
(defn pid "The Task's actual worker PID." [task] (erlang/map_get :pid task))
(defn await
 ([task] (await task 5000))
 ([task timeout-ms] (Task/await task timeout-ms)))
(defn yield
 ([task] (yield task 5000))
 ([task timeout-ms] (Task/yield task timeout-ms)))
(defn ignore
 "Abandon the result alias/monitor without stopping accepted work. The task
  keeps its executable lease until actual completion; future await/yield is no
  longer valid. Use after a timeout when a late reply must not fill a mailbox."
 [task] (Task/ignore task))
(defn shutdown
 "Explicit OTP Task cancellation for work the caller knows is safe to stop.
  Never infer replay safety or physical native/provider cancellation from it."
 ([task] (shutdown task 5000))
 ([task timeout-or-brutal-kill] (Task/shutdown task timeout-or-brutal-kill)))
