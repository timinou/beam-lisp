;; Explicit retained executable registrations. Handles have one lifetime owner;
;; invocation borrows an independent lease, so accepted work drains on unregister.
(ns proc.callback)

(defn register!
 "Retain a callback before publishing it. Managed callbacks automatically pin
  their whole sealed graph; callable arms alone omit transitive dependencies.
  Outside managed graphs, extra modules declare dependencies captured in values;
  arbitrary closures are not traced.
  Unregister explicitly or transfer to the process owning the registration."
 ([f] (register! f (list)))
 ([f modules]
  (BeamLisp.Env/assert_execution_context!)
  (let [modules (concat (BeamLisp.Env/callback_modules f) modules
                       (maps/get :modules (or (Process/get :bl_generation) {}) nil)
                       (list (elem (erlang/fun_info (fn [] nil) :module) 1)))
        lease (BeamLisp.Env/retain_code! modules)]
   (try
    {:lease lease :invoke (BeamLisp.Env/register_code_callback! lease f)}
    (catch e (do (BeamLisp.Env/release_code! lease) (throw e)))))))

(defn transfer!
 "Hand registration ownership to a local process. Publish the returned handle;
  the previous handle becomes cancelled and cannot unregister the new one."
 [registration owner]
 (let [lease (BeamLisp.Env/transfer_code! (:lease registration) owner)]
  (if (= :cancelled lease) :cancelled (assoc registration :lease lease))))

(defn prepare-transfer!
 "Create an inactive target ticket without changing source ownership. Index
  :accepted in a bounded lifetime-owner slot BEFORE commit-transfer!. A crash
  before handoff leaves an inactive target; a crash after handoff leaves the
  exact accepted ticket discoverable in that same slot. This is not acceptance."
 [registration owner]
 (when-not (and (erlang/is_pid owner) (= (erlang/node owner) (erlang/node)))
  (throw (ex-info "Callback handoff requires a local owner" {:kind :invalid-callback-owner})))
 {:source registration
  :accepted (assoc registration :lease
              (tuple (elem (:lease registration) 0) owner (erlang/make_ref)))})

(defn commit-transfer!
 "Activate a previously indexed target ticket. Returns its registration or
  cancelled. An optional admission token is checked inside the native fence.
  Lost acknowledgements are resolved by querying the prepublished target;
  repeated handoff never releases a previously accepted registration."
 ([prepared] (commit-transfer! prepared nil))
 ([prepared request]
  (let [accepted (:accepted prepared)
        result (BeamLisp.Env/handoff_code! (get-in prepared [:source :lease]) (:lease accepted) request)]
   (if (= :cancelled result) :cancelled accepted))))

(defn active?
 "Observe the exact retained ticket under the same native invocation fence.
  This does not invoke the application callback or authorize external effects."
 [registration]
 (BeamLisp.Env/code_callback_active? (:lease registration) (:invoke registration)))

(defn unregister! [registration]
 (BeamLisp.Env/release_code! (:lease registration)))

(defn invoke!
 "Accept a callback invocation or return cancelled after unregister/owner death.
  Accepted effects run to completion under an independent executing lease."
 [registration args]
 (let [result (BeamLisp.Env/run_code_callback! (:lease registration) (:invoke registration) (to-list args))]
  (case (:status result)
   :completed (:value result)
   :cancelled :cancelled
   :busy (erlang/error :code_lease_capacity))))

(defn try-invoke!
 "Invoke once. The native acceptance envelope distinguishes pre-entry capacity
  from a callback's own errors or a literal cancelled result. Accepted effects
  never become replay-safe merely because their exception says busy."
 [registration args]
 (BeamLisp.Env/run_code_callback! (:lease registration) (:invoke registration) (to-list args)))
