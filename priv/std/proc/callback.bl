;; Explicit retained executable registrations. Handles have one lifetime owner;
;; invocation borrows an independent lease, so accepted work drains on unregister.
(ns proc.callback)

(defn register!
 "Retain a callback before publishing it. Extra modules declare executable
  dependencies captured inside its values; arbitrary closures are not traced.
  Unregister explicitly or transfer to the process owning the registration."
 ([f] (register! f (list)))
 ([f modules]
  (let [modules (concat (BeamLisp.Env/callback_modules f) modules
                       (list (elem (erlang/fun_info (fn [] nil) :module) 1)))
        lease (BeamLisp.Env/retain_code! modules)]
   (try
    {:lease lease :invoke (BeamLisp.Env/convey (fn [args] (apply f args)))}
    (catch e (do (BeamLisp.Env/release_code! lease) (throw e)))))))

(defn transfer!
 "Hand registration ownership to a local process. Publish the returned handle;
  the previous handle becomes cancelled and cannot unregister the new one."
 [registration owner]
 (let [lease (BeamLisp.Env/transfer_code! (:lease registration) owner)]
  (if (= :cancelled lease) :cancelled (assoc registration :lease lease))))

(defn unregister! [registration]
 (BeamLisp.Env/release_code! (:lease registration)))

(defn invoke!
 "Accept a callback invocation or return cancelled after unregister/owner death.
  Accepted effects run to completion under an independent executing lease."
 [registration args]
 (BeamLisp.Env/run_code! (:lease registration)
  (fn [] (erlang/apply (:invoke registration) (list args)))))
