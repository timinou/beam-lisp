; Join bounded physical membership to each component's existing native authority.
; A discovered role never grants stop, rewrite or whole-actor migration rights.
(ns proc.inventory
 (:require [proc.owner-registry :as owners] [reload.generation :as generation]
           [proc.evolve :as evolve] [proc.queue-runtime :as queue] [proc.framework :as framework]))

(defn- inspect-role [entry]
 (let [kind (:kind entry) pid (:pid entry)
       evidence (case kind
                  :server (generation/owner-evidence pid)
                  :supervisor (generation/owner-evidence pid)
                  :evolve (evolve/owner-evidence pid)
                  :queue (queue/owner-evidence (:reference entry))
                  :framework (framework/owner-evidence pid)
                  nil)
       same? (and evidence (= (:application-id entry) (:application-id evidence))
                    (= (:proof-id entry) (:ticket evidence))
                    (case kind
                      :server (and (= kind (:kind evidence)) (= (:module entry) (:module evidence)))
                      :supervisor (= kind (:kind evidence))
                      :evolve (= :proc.evolve (:kind evidence))
                      :queue (= pid (:pid evidence))
                      :framework (and (= :framework (:kind evidence)) (= (:module entry) (:module evidence))) false))]
  (when same?
   (assoc (select-keys entry [:key :pid :kind :application-id :origin-generation :module :reference :managed])
     :capability (case kind
                   :queue :queue-handler-transition
                   :framework :application-lifetime
                   :evolve (if (:managed evidence) :managed-evolution-slice :unmanaged-evolution-slice)
                   :retained-drain)))))

(defn page
 "Observe at most limit app-local roles and validate native authority without
  actor RPCs. Servers/supervisors require retained drain until a stable kernel
  exists. Evolution slices do not cover a containing actor's arbitrary state."
 [application-id cursor limit]
 (let [result (owners/page application-id cursor limit)]
  (if-not (contains? #{:more :valid} (:status result)) result
   (let [participants (mapv inspect-role (:participants result))]
    (if (every? some? participants) (assoc result :participants participants :scope :observed-owner-index)
     {:status :stale :kind :owner-authority-changed :scope :observed-owner-index})))))

(defn recheck!
 "Revalidate a complete observed-index receipt and every native role. No claim
  about future joins, opaque producers or candidate compatibility follows."
 [receipt]
 (let [check (owners/recheck! receipt)]
  (if-not (= :current (:status check)) check
   (let [valid? (every? (fn [r]
                         (let [row (first (ets/lookup owners/INDEX (:key r)))]
                          (and row (some? (inspect-role (elem row 1)))))) (:registrations receipt))]
    (if valid? (owners/recheck! receipt)
     {:status :stale :kind :owner-authority-changed :scope :observed-owner-index})))))

(defn snapshot
 "Collect bounded pages under one revision, then recheck membership/authority.
  Budget limits total roles to avoid accidental unbounded planning. On churn,
  return stale; callers choose when to retry. This never fences admissions."
 ([application-id] (snapshot application-id 100 10000))
 ([application-id page-size budget]
  (when-not (and (erlang/is_integer budget) (<= 1 budget 100000))
   (throw (ex-info "Inventory budget must be 1..100000 roles" {:kind :invalid-inventory-budget})))
  (loop [cursor nil participants [] registrations []]
   (let [result (page application-id cursor page-size)]
    (cond
     (not (contains? #{:more :valid} (:status result))) result
     (> (get-in result [:receipt :total]) budget) {:status :refused :kind :inventory-budget-exceeded}
     :else
      (let [all (into participants (:participants result))
            regs (into registrations (get-in result [:receipt :registrations]))]
       (if (= :more (:status result)) (recur (:cursor result) all regs)
        (let [receipt (assoc (:receipt result) :registrations regs) check (recheck! receipt)]
         (if (= :current (:status check))
          {:status :valid :scope :observed-owner-index :participants all :receipt receipt :scanned (count all)}
          check)))))))))
