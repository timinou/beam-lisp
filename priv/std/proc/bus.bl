; proc/bus.bl — backpressured fan-out on flow's pull protocol.

(ns proc.bus
  ; The bus is a CLAUSE of `defserver` now, not a form of its own, so the one
  ; thing this module needs from the expander is how to register it.
  (:require [proc.server :refer [extend-clause!]]))

(defn- drain-sub [sub]
  (let [queue (:queue sub)
        demand (:demand sub)
        n (min demand (count queue))]
    (when (> n 0)
      (erlang/send (:pid sub) [:events (vec (take n queue))]))
    (assoc sub :queue (vec (drop n queue)) :demand (- demand n))))

(defn blocked? [st]
  (some (fn [[_ sub]]
          (and (= (:policy sub) :block)
               (>= (count (:queue sub)) (:max-lag sub))))
        (:subs st)))

(defn- append-one [sub ev]
  (let [queued (conj (:queue sub) ev)
        limit (:max-lag sub)
        policy (:policy sub)]
    (cond
      (and (> (count queued) limit) (= policy :drop-oldest))
        (drain-sub (assoc sub :queue (vec (drop (- (count queued) limit) queued))))

      (and (> (count queued) limit) (= policy :detach))
        :detach

      :else (drain-sub (assoc sub :queue queued)))))

(defn append-event [st ev]
  (let [result
        (reduce-kv
          (fn [acc key sub]
            (let [next-sub (append-one sub ev)]
              (if (= next-sub :detach)
                (do (erlang/demonitor (:ref sub) (list :flush))
                    (assoc acc :subs (dissoc (:subs acc) key)
                               :lagged (conj (:lagged acc) (:id sub))))
                (assoc acc :subs (assoc (:subs acc) key next-sub)))))
          (assoc st :lagged [])
          (:subs st))]
    (reduce
      (fn [acc id]
        (let [notice {:type :lagged :subscriber id}]
          (reduce-kv
            (fn [a key sub]
              (let [next-sub (append-one sub notice)]
                (if (= next-sub :detach)
                  (do (erlang/demonitor (:ref sub) (list :flush))
                      (assoc a :subs (dissoc (:subs a) key)))
                  (assoc a :subs (assoc (:subs a) key next-sub)))))
            acc (:subs acc))))
      (dissoc result :lagged)
      (:lagged result))))

(defn- reply-waiters [st]
  (if (or (blocked? st) (empty? (:waiting st)))
    st
    (let [[[from ev] & more] (:waiting st)
          next (append-event (assoc st :waiting (vec more)) ev)]
      (GenServer/reply from :ok)
      (reply-waiters next))))

(defn add-sub [st pid]
  (if (contains? (:subs st) pid)
    st
    (let [ref (erlang/monitor :process pid)
          sub {:id pid :pid pid :ref ref :demand 0 :queue []
               :policy :block :max-lag (:max-lag st)}]
      (assoc st :subs (assoc (:subs st) pid sub)))))

(defn configure-sub [st pid id policy max-lag]
  (if-let [sub (get (:subs st) pid)]
    (assoc st :subs
           (assoc (:subs st) pid
                  (assoc sub :id id :policy policy :max-lag max-lag)))
    st))

(defn demand-from [st pid n]
  (if-let [sub (get (:subs st) pid)]
    (reply-waiters
      (assoc st :subs
             (assoc (:subs st) pid
                    (drain-sub (assoc sub :demand (+ (:demand sub) n))))))
    st))

(defn remove-sub [st ref pid]
  (reply-waiters
    (assoc st :subs
           (reduce-kv
             (fn [subs key sub]
               (if (and (= (:pid sub) pid) (= (:ref sub) ref))
                 (dissoc subs key)
                 subs))
             (:subs st) (:subs st)))))

(defn down-handler
  "A monitored subscriber died: its subscription goes.

   This is the clause's `:down` contribution, not a `handle-info` clause of its
   own — the server's ONE `[:DOWN …]` clause threads every clause's handler, so
   a registry and a bus in one server cannot shadow each other. A pid this bus
   never subscribed is a no-op, and in particular does NOT release a waiting
   publisher on the way past."
  [st ref pid _reason]
  (if (some (fn [[_ sub]] (and (= (:pid sub) pid) (= (:ref sub) ref))) (:subs st))
    (remove-sub st ref pid)
    st))

(defn send-done [st]
  (vec (map (fn [[_ sub]] (erlang/send (:pid sub) [:done])) (:subs st)))
  (vec (map (fn [[from _ev]] (GenServer/reply from :done)) (:waiting st)))
  :ok)

;; ── the clause ─────────────────────────────────────────────────────────
;;
;; `(bus (demand 8))` — the bus as a CLAUSE of `defserver`. It was a macro
;; until `proc.server` gave bundles a clause registry; a clause contributes a
;; slice of a server's state, so a server that IS a bus AND carries its own
;; state is one form rather than a body to paste. `publish` and
;; `proc.flow/subscribe` never needed the macro and do not change.

(defn init-state
  "The state slice the clause contributes: subscribers, the waiter queue, and
   the lag bound. `start-opts` is the map the server was STARTED with, so the
   demand and the lag bound are configurable without editing the declaration."
  [start-opts default-demand]
  {:subs {} :closed? false :waiting []
   :demand (get start-opts :demand default-demand)
   :max-lag (get start-opts :max-lag 1024)})

(defn- declared-demand
  "The default demand from a clause's `(demand N)` form, or 8 when it has none.

   An impossible declaration is refused HERE, when the server form is expanded,
   with a sentence: a bus that cannot say what demand a subscriber starts with
   would hand the drain loop a value it cannot subtract."
  [forms where]
  (when (> (count forms) 1)
    (throw (ex-info (str where ": (bus (demand N)) takes at most one demand clause —"
                         " got " (count forms))
                    {:clause forms})))
  (let [cfg (first forms)]
    (if (nil? cfg)
      8
      (do
        (when-not (and (list? cfg) (= 'demand (first cfg)) (= 2 (count cfg)))
          (throw (ex-info (str where ": (bus …) takes (demand N) — the demand a"
                               " subscriber starts with. Got " (pr-str cfg))
                          {:clause cfg})))
        (second cfg)))))

(defn bus-clause
  "The `(bus (demand N))` transform. Public because it is worth testing on its
   own: it is the unit that turns a declaration into a fan-out."
  [clause ctx]
  (let [where (str "defserver " (:name ctx))
        default-demand (declared-demand (vec (rest clause)) where)]
    {:init `(proc.bus/init-state start-opts ~default-demand)
     :down [`proc.bus/down-handler]
     :clauses
     [`(handle-call [:publish ev#] [from# st#]
         (if (proc.bus/blocked? st#)
           (noreply (assoc st# :waiting (conj (:waiting st#) [from# ev#])))
           (reply :ok (proc.bus/append-event st# ev#))))
      `(handle-cast [:publish ev#] [st#]
         (noreply (proc.bus/append-event st# ev#)))
      `(handle-info [:subscribe pid#] [st#]
         (noreply (proc.bus/add-sub st# pid#)))
      `(handle-info [:flow-options pid# id# policy# max-lag#] [st#]
         (noreply (proc.bus/configure-sub st# pid# id# policy# max-lag#)))
      `(handle-info [:demand n# pid#] [st#]
         (noreply (proc.bus/demand-from st# pid# n#)))
      `(handle-info [:demand n#] [st#]
         (noreply st#))
      `(terminate [_reason# st#]
         (proc.bus/send-done st#))]}))

;; Registered BEFORE `broadcast-bus` expands, and that order is load-bearing: a
;; clause is resolved when the server form is COMPILED, so a registration at the
;; bottom of this file would arrive too late for its one in-file use.
(extend-clause! :bus bus-clause)

(defn publish
  "Publish one event. The call waits when a :block subscriber reaches its
   lag bound, making backpressure reach the publishing process."
  [b ev]
  (call b [:publish ev] :infinity))

;; The bus this namespace starts for `start-broadcast`, spelled as the clause.
(proc.server/defserver broadcast-bus (bus (demand 8)))

(defn- bridge-loop [up b batch]
  (receive
    [:events events]
    (do (vec (map (fn [ev] (publish b ev)) events))
        (erlang/send up [:demand batch (erlang/self)])
        (bridge-loop up b batch))
    [:done]
    (do (stop b) :done)
    (after 3600000 (bridge-loop up b batch))))

(defn start-broadcast [up opts]
  (let [b (start broadcast-bus opts)
        batch (get opts :demand 8)
        bridge (spawn (fn [] (bridge-loop up b batch)))]
    (erlang/send up [:subscribe bridge])
    (erlang/send up [:demand batch bridge])
    b))
