;; A latest-attempt slot containing data and an optional process owner.
;; Starting/ending a process or performing an external effect is the caller's
;; explicit job. A late reply cannot replace the newest attempt's outcome.
(ns proc.attempt (:require [reload.state :as state]))

(defn current [key]
  @(state/cell! key nil))

(defn begin!
  "Replace a declared attempt slot atomically. Return its new :id and the
   :previous-owner, which the caller may explicitly drain/cancel. IDs are
   instance-local data, never process names or dynamically allocated atoms."
  [key value]
  (let [id (str "attempt:" (erlang/unique_integer (list :positive :monotonic)))]
    (state/get-and-update! key nil
      (fn [before]
        (tuple {:id id :previous-owner (:owner before)}
          {:id id :owner nil :value value})))))

(defn attach!
  "Attach this attempt's live local owner. Return false for a superseded ID;
   the caller must then cancel its unpublished process. No other owner is
   replaced, and a completed or already-attached attempt refuses."
  [key id owner]
  (when-not (and (erlang/is_pid owner) (= (erlang/node owner) (erlang/node))
                (Process/alive? owner))
    (throw (ex-info "Attempt requires a live local owner" {:kind :invalid-attempt-owner})))
  (state/get-and-update! key nil
    (fn [before]
      (if (and (= id (:id before)) (nil? (:owner before)) (not (:settled? before)))
        (tuple true (assoc before :owner owner))
        (tuple false before)))))

(defn settle!
  "Publish one terminal outcome for the matching attempt. Stale/duplicate
   replies return false and preserve the current owner and outcome. This
   fences local publication; it never proves an external effect did not run."
  [key id value]
  (state/get-and-update! key nil
    (fn [before]
      (if (and (= id (:id before)) (not (:settled? before)))
        (tuple true (assoc before :value value :owner nil :settled? true))
        (tuple false before)))))
