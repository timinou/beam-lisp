; proc/flow.bl — demand-driven streaming, the uncompromisingly BEAM-native way.
;
; ══ THE INVERSION ═══════════════════════════════════════════════════════════
;
; core.async (and priv/channels.bl, its CSP cousin) is PUSH: a producer puts
; values into a buffer and blocks when the buffer fills. Backpressure is a
; SIDE EFFECT of a bounded buffer — you feel it only once the buffer is full,
; and the buffer is a guess (how big? too small stalls, too big hides latency
; and eats memory under load).
;
; The BEAM's own answer — GenStage — is the opposite, and it is the model this
; file implements: PULL. A consumer asks for N events ("demand"); a producer is
; FORBIDDEN to send more than has been demanded. Backpressure is not a buffer
; filling up; it is the STRUCTURE of the protocol. A slow consumer simply
; demands slower, and the producer — by contract — cannot outrun it. No buffer
; to size, no memory blowup under load, no dropped events. This is why every
; serious BEAM data pipeline (Broadway, Flow, the whole Dashbit stack) is
; GenStage-shaped and not channel-shaped.
;
;   PUSH (core.async / its CSP engine)  PULL (flow — this file)
;   ─────────────────────────────       ──────────────────────────────
;   producer decides the rate           CONSUMER decides the rate
;   buffer absorbs the mismatch         no mismatch is possible
;   backpressure = buffer-full stall    backpressure = unfilled demand
;   size the buffer (a guess)           nothing to size
;
; ══ THE SHAPE ═══════════════════════════════════════════════════════════════
;
; Three roles, each a process:
;   • a PRODUCER      emits events only in response to demand
;   • a CONSUMER      subscribes upstream, issues demand, handles events
;   • a PRODUCER-CONSUMER  does both: demands from upstream, is demanded from
;                          downstream, transforms in between
;
; The wire protocol between a consumer C and its producer P:
;   C -> P   [:subscribe C]                register downstream
;   C -> P   [:demand n]                   "I can handle n more events"
;   P -> C   [:events (e …)]               here are up-to-n events
;   P -> C   [:done]                       stream is exhausted, no more coming
;
; A producer keeps a running `demand` counter per subscriber and a generator of
; events. It emits min(demand, available) events, decrements demand, and goes
; quiet until more demand arrives. THAT quiet is the backpressure — it costs
; nothing and cannot overflow.
;
; ══ WHY THIS IS THE NATIVE TIER ═════════════════════════════════════════════
;
; This owes nothing to Clojure. There is no `<!`/`<!!`, no `go`, no CSP
; rendezvous — those are core.async's vocabulary, and core.async is the COMPAT
; shim (priv/clojure/core/async.bl), a skin for running Clojure source. This
; file is the beam-lisp concurrency model a native author reaches for: demand,
; subscription, transform stages — the GenStage algebra, in lisp.

(ns proc.flow)

;; ─────────────────────────────────────────────────────────────────────
;; PRODUCER — emits events only up to the demand it has been given.
;;
;; `gen` is a stateful generator: (gen state) -> [events' state'] | :halt,
;; where events' is a list of AT MOST the requested count. A producer never
;; buffers ahead; it computes events lazily, on demand, and only as many as
;; asked. This is the crux — the producer is structurally incapable of
;; outrunning its consumer.
;; ─────────────────────────────────────────────────────────────────────

(defn- producer-loop [gen gstate demand sub]
  (receive
    ;; a downstream stage subscribed to us
    [:subscribe c]
    (producer-loop gen gstate demand c)

    ;; downstream can handle `n` more events → try to satisfy from the gen
    [:demand n]
    (let [total (+ demand n)
          step  (gen gstate total)]
      (if (= step :halt)
        (do (when sub (erlang/send sub [:done])) :stopped)
        (let [[events gstate2] step
              k (count events)]
          (when (and sub (seq events))
            (erlang/send sub [:events events]))
          ;; carry any demand the gen could not yet fill
          (producer-loop gen gstate2 (- total k) sub))))

    ;; Tagged demand identifies the consumer for fan-out producers. A
    ;; single-subscriber producer intentionally uses the same logic.
    [:demand n _from]
    (let [total (+ demand n)
          step  (gen gstate total)]
      (if (= step :halt)
        (do (when sub (erlang/send sub [:done])) :stopped)
        (let [[events gstate2] step
              k (count events)]
          (when (and sub (seq events))
            (erlang/send sub [:events events]))
          (producer-loop gen gstate2 (- total k) sub))))

    [:cancel] :stopped

    (after 3600000 (producer-loop gen gstate demand sub))))

(defn producer
  "Spawn a demand-driven producer. `gen` is (fn [state max] -> [events state']
   | :halt): return at most `max` events and the next state, or :halt when the
   stream is exhausted. The producer emits ONLY what downstream demands."
  [gen init]
  (spawn (fn [] (producer-loop gen init 0 nil))))

;; A convenience producer over a finite collection — the `range`/seq source.
(defn from-seq
  "A producer that emits the elements of `coll`, at most `max` per demand,
   then signals :done. The canonical finite source."
  [coll]
  (producer
    (fn [remaining max]
      (if (empty? remaining)
        :halt
        [(take max remaining) (drop max remaining)]))
    (seq coll)))

;; ─────────────────────────────────────────────────────────────────────
;; PRODUCER-CONSUMER — the transform stage. Demands from upstream, is
;; demanded from downstream, maps `f` over events in between. Demand flows
;; UP (downstream's demand becomes our demand on upstream); events flow
;; DOWN (upstream's events, transformed, become ours). This is the whole
;; point of a demand pipeline: backpressure propagates end to end for free.
;; ─────────────────────────────────────────────────────────────────────

(defn- pc-loop [xform up sub]
  (receive
    [:subscribe c]
    (do (erlang/send up [:subscribe (erlang/self)])
        (pc-loop xform up c))

    ;; downstream demand → demand the same upstream (1:1 for map; a filter
    ;; would demand more, a flatMap fewer — xform decides via its own stage)
    [:demand n]
    (do (erlang/send up [:demand n (erlang/self)])
        (pc-loop xform up sub))

    [:demand n _from]
    (do (erlang/send up [:demand n (erlang/self)])
        (pc-loop xform up sub))

    ;; upstream events → transform, forward down
    [:events events]
    (let [out (xform events)]
      (when (and sub (seq out))
        (erlang/send sub [:events out]))
      (pc-loop xform up sub))

    [:done]
    (do (when sub (erlang/send sub [:done])) :stopped)

    [:cancel] (do (erlang/send up [:cancel]) :stopped)

    (after 3600000 (pc-loop xform up sub))))

(defn transform
  "A producer-consumer stage: subscribes to `up`, applies `xform` (a fn from a
   LIST of events to a list of events — so it can map, filter, or expand) and
   forwards downstream. Demand propagates upstream automatically."
  [up xform]
  (let [pc (spawn (fn [] (pc-loop xform up nil)))]
    pc))

;; sugar: element-wise map and filter stages built on `transform`
(defn map-stage    [up f]    (transform up (fn [events] (vec (map f events)))))
(defn filter-stage [up pred] (transform up (fn [events] (vec (filter pred events)))))

;; ─────────────────────────────────────────────────────────────────────
;; MULTI-RATE stage — where demand stops being 1:1 and becomes ARITHMETIC.
;;
;; `transform` above forwards demand 1:1: downstream asks for n, it asks
;; upstream for n. That is correct ONLY when the stage emits exactly one
;; event per input (a `map`). The moment the rate changes, 1:1 breaks the
;; demand contract in one of two ways:
;;
;;   • EXPANDING (flatMap): one input → many outputs. If downstream demands
;;     3 and we demand 3 upstream, a ×3 expansion emits 9 — THREE TIMES the
;;     demand. We just overran the consumer we promised never to overrun.
;;
;;   • CONTRACTING (filter/batch): one input → sometimes zero outputs. If
;;     downstream demands 3 and we demand 3 upstream but 2 are dropped,
;;     downstream gets 1 and then STARVES — we under-delivered and stalled.
;;
;; The fix is the crux of the GenStage algebra: a multi-rate stage cannot
;; pass demand through untouched. It must (1) meter its OUTPUT against the
;; outstanding downstream demand, delivering at most that many, (2) BUFFER
;; any surplus it produced, and (3) pull upstream, in its own chunks, only
;; when its buffer runs dry and downstream still wants more. Demand and
;; supply are reconciled by a little state machine — this is what a channel
;; fundamentally cannot express, because a channel has no notion of demand
;; to do arithmetic on.
;;
;; State: {:buf undelivered-outputs  :want outstanding-downstream-demand
;;         :up-out outstanding-upstream-demand  :done? upstream-finished}
;; ─────────────────────────────────────────────────────────────────────

(defn- mr-flush
  "Deliver min(buffered, wanted) events downstream; if upstream is done and
   the buffer has drained, propagate :done. Returns [buf' want']."
  [buf want sub done?]
  (let [k (min (count buf) want)]
    (when (> k 0)
      (erlang/send sub [:events (take k buf)]))
    (let [buf2 (drop k buf) want2 (- want k)]
      (when (and done? (empty? buf2))
        (erlang/send sub [:done]))
      [buf2 want2])))

(defn- mr-pull
  "If the buffer cannot satisfy outstanding demand and upstream is neither
   done nor already working, ask upstream for one chunk. Returns up-out'."
  [buf want up up-out done? chunk]
  (if (and (> want (count buf)) (= up-out 0) (not done?))
    (do (erlang/send up [:demand chunk (erlang/self)]) chunk)
    up-out))

(defn- mr-loop [xform up sub st chunk]
  (receive
    [:subscribe c]
    (do (erlang/send up [:subscribe (erlang/self)])
        (mr-loop xform up c st chunk))

    ;; downstream demand grows → try to satisfy from buffer, then maybe pull
    [:demand n]
    (let [want (+ (:want st) n)
          [buf2 want2] (mr-flush (:buf st) want sub (:done? st))
          up-out2 (mr-pull buf2 want2 up (:up-out st) (:done? st) chunk)]
      (mr-loop xform up sub
               (assoc st :buf buf2 :want want2 :up-out up-out2) chunk))

    [:demand n _from]
    (let [want (+ (:want st) n)
          [buf2 want2] (mr-flush (:buf st) want sub (:done? st))
          up-out2 (mr-pull buf2 want2 up (:up-out st) (:done? st) chunk)]
      (mr-loop xform up sub
               (assoc st :buf buf2 :want want2 :up-out up-out2) chunk))

    ;; upstream delivered → expand/contract via xform, buffer, meter out
    [:events events]
    (let [produced (reduce (fn [acc e] (concat acc (xform e))) (list) events)
          buf1 (concat (:buf st) produced)
          up-out1 (- (:up-out st) (count events))
          [buf2 want2] (mr-flush buf1 (:want st) sub (:done? st))
          up-out2 (mr-pull buf2 want2 up up-out1 (:done? st) chunk)]
      (mr-loop xform up sub
               (assoc st :buf buf2 :want want2 :up-out up-out2) chunk))

    ;; upstream exhausted → flush what remains against current demand; the
    ;; buffer may outlive this message and drain on later demand
    [:done]
    (let [[buf2 want2] (mr-flush (:buf st) (:want st) sub true)]
      (mr-loop xform up sub
               (assoc st :buf buf2 :want want2 :done? true) chunk))

    [:cancel] (do (erlang/send up [:cancel]) :stopped)

    (after 3600000 (mr-loop xform up sub st chunk))))

(defn flat-transform
  "A MULTI-RATE producer-consumer. `xform` maps ONE upstream event to a LIST
   of downstream events (length 0 = drop, 1 = map, >1 = expand). The stage
   meters output against downstream demand, buffers surplus, and pulls
   upstream in `chunk`-sized bites only when it must. Demand arithmetic,
   done correctly: it never emits more than demanded and never starves a
   consumer that still wants more."
  [up xform chunk]
  (spawn (fn []
           (mr-loop xform up nil
                    {:buf (list) :want 0 :up-out 0 :done? false} chunk))))

;; sugar over flat-transform: the two canonical multi-rate shapes
(defn expand-stage
  "×k expansion: each event becomes (f event) → a list. One in, many out."
  [up f chunk] (flat-transform up f chunk))

(defn mapcat-stage
  "clojure-flavoured expand: f returns a seq, flattened downstream."
  [up f chunk] (flat-transform up (fn [e] (vec (f e))) chunk))

;; ─────────────────────────────────────────────────────────────────────
;; BATCH — coalesce many events into one.
;;
;; A batcher is the multi-rate stage turned around: it takes MANY events and
;; emits ONE, a list. Two triggers race and whichever fires first wins:
;;
;;   • the COUNT trigger — `n` events have accumulated, emit them now;
;;   • the TIMEOUT trigger — fewer than `n` wait and `t` ms have passed, emit
;;     the short batch rather than hold it forever (Broadway's batcher).
;;
;; Downstream demand is counted in BATCHES, so a demand of k allows at most k
;; emissions and the stage cannot overrun its consumer. Upstream demand is what
;; the outstanding batch demand can absorb — `want × n` — less what is already
;; buffered or in flight. `n` = 1 is exactly no batching: every event is a batch
;; of one, emitted on arrival, and NO timer is ever armed.
;; ─────────────────────────────────────────────────────────────────────

(defn- b-emit
  "Emit whole `n`-event batches while downstream demand allows. [state' emitted?]"
  [st sub n]
  (let [k (min (:want st) (quot (count (:buf st)) n))]
    (if (> k 0)
      (do (erlang/send sub
                       [:events
                        (vec (map (fn [i] (vec (take n (drop (* i n) (:buf st)))))
                                  (range k)))])
          [(assoc st :buf (vec (drop (* k n) (:buf st))) :want (- (:want st) k)) true])
      [st false])))

(defn- b-emit-partial
  "Emit the open short batch now — the timeout trigger, and the tail at :done."
  [st sub]
  (if (and (> (count (:buf st)) 0) (> (:want st) 0))
    (do (erlang/send sub [:events [(vec (:buf st))]])
        [(assoc st :buf [] :want (- (:want st) 1)) true])
    [st false]))

(defn- b-settle
  "Push out everything that may go now: whole batches, then — once upstream is
   done — the remainder as a final short batch, then :done when the buffer drains."
  [st sub n]
  (let [[st _] (b-emit st sub n)
        [st _] (if (:done? st) (b-emit-partial st sub) [st false])]
    (if (and (:done? st) (empty? (:buf st)))
      (do (erlang/send sub [:done]) (assoc st :finished? true))
      st)))

(defn- b-clear-timer [st]
  (when (some? (:timer st)) (erlang/cancel_timer (:timer st)))
  (assoc st :timer nil))

(defn- b-arm
  "Arm the timeout iff a short batch is open and a partial may still go. `n` = 1
   never arms: a one-event batch is already whole, and an armed timer left
   behind is the exact leftover this stage must not have."
  [st n t]
  (if (and (nil? (:timer st)) (> n 1) (> (count (:buf st)) 0)
           (> (:want st) 0) (< (count (:buf st)) n))
    (let [r (erlang/make_ref)]
      (erlang/send_after t (erlang/self) (tuple :bl-flow/flush r))
      (assoc st :timer r))
    st))

(defn- b-pump
  "Ask upstream for what the outstanding batch demand can absorb, less what is
   buffered or already on its way. Never pulls without demand."
  [st up n]
  (let [need (- (* (:want st) n) (count (:buf st)) (:up-out st))]
    (if (and (> need 0) (not (:done? st)))
      (do (erlang/send up [:demand need (erlang/self)])
          (assoc st :up-out (+ (:up-out st) need)))
      st)))

(defn- b-step
  "The settle / clear-timer / arm-timer / pump sequence after a state change."
  [st sub up n t]
  (let [st (b-settle st sub n)]
    (if (:finished? st)
      st
      (b-pump (b-arm (b-clear-timer st) n t) up n))))

(defn- b-loop [up sub st n t]
  (receive
    [:subscribe c]
    (do (erlang/send up [:subscribe (erlang/self)])
        (b-loop up c st n t))

    [:demand k]       (let [st (b-step (assoc st :want (+ (:want st) k)) sub up n t)]
                        (if (:finished? st) :done (b-loop up sub st n t)))
    [:demand k _from] (let [st (b-step (assoc st :want (+ (:want st) k)) sub up n t)]
                        (if (:finished? st) :done (b-loop up sub st n t)))

    [:events events]
    (let [st (b-step (assoc st
                            :buf (into (:buf st) events)
                            :up-out (max 0 (- (:up-out st) (count events))))
                     sub up n t)]
      (if (:finished? st) :done (b-loop up sub st n t)))

    [:done]
    (let [st (b-step (assoc st :done? true) sub up n t)]
      (if (:finished? st) :done (b-loop up sub st n t)))

    ;; the timeout: only the timer THIS stage armed may flush
    [:bl-flow/flush r]
    (if (= r (:timer st))
      (let [[st _] (b-emit-partial (assoc st :timer nil) sub)
            st (b-step st sub up n t)]
        (if (:finished? st) :done (b-loop up sub st n t)))
      (b-loop up sub st n t))

    [:state from]
    (do (erlang/send from [:state st]) (b-loop up sub st n t))

    [:cancel] (do (erlang/send up [:cancel]) :cancelled)

    (after 3600000 (b-loop up sub st n t))))

(defn batch
  "A batcher stage: subscribe, demand in BATCHES, and receive one event per
   batch — a list of up to `n` upstream events, emitted when `n` have gathered
   (the count trigger) or after `t` ms with a shorter batch (the timeout
   trigger), whichever comes first. `n` = 1 is exactly no batching; each event
   is its own batch and no timer is ever armed."
  [up n t]
  (when (< n 1)
    (throw (ex-info "batch: n must be at least 1" {:n n})))
  (spawn (fn []
           (b-loop up nil {:buf [] :want 0 :up-out 0 :done? false
                           :timer nil :finished? false} n t))))

(defn batch-state
  "The batcher's state — the timer it holds, its buffer, its demand. Observability
   for a live batcher, e.g. that `n` = 1 leaves no timer armed."
  [b]
  (erlang/send b [:state (erlang/self)])
  (receive
    [:state s] s
    (after 5000 :timeout)))

;; CONSUMER — the demand SOURCE. It drives the whole pipeline: nothing
;; upstream produces anything until a consumer issues demand. `run` is the
;; blocking consumer that folds every event into an accumulator and returns
;; it when the stream signals :done — the native `reduce` over a stream.
;;
;; `batch` is the demand size: how many events to ask for at a time. This is
;; the ONE tuning knob, and unlike a channel's buffer size it cannot cause
;; memory blowup — it only sets how chatty the demand signalling is. Bigger
;; batch = fewer round-trips; smaller = tighter latency. Correctness is
;; identical for any batch ≥ 1.
;; ─────────────────────────────────────────────────────────────────────

(defn run
  "Drive `up` as a demand-driven consumer, folding events with (f acc event)
   from `init`, pulling `batch` events at a time. Blocks until the stream is
   exhausted, then returns the accumulator. This is `reduce` over a live,
   backpressured stream."
  [up init f batch]
  (erlang/send up [:subscribe (erlang/self)])
  (erlang/send up [:demand batch (erlang/self)])
  (loop [acc init]
    (receive
      [:events events]
      ;; fold this batch, then signal we can take another batch — the demand
      ;; RENEWAL is the backpressure: upstream got exactly `batch` ahead of us
      ;; and now waits until we ask again.
      (let [acc2 (reduce f acc events)]
        (erlang/send up [:demand batch (erlang/self)])
        (recur acc2))

      [:done] acc

      (after 3600000 (recur acc)))))

(defn run-each
  "Drive `up`, calling (f event) for its side effects on each event, until the
   stream is exhausted. The side-effecting consumer."
  [up f batch]
  (run up nil (fn [_ e] (f e) nil) batch))


;; ─────────────────────────────────────────────────────────────────────
;; SUBSCRIPTION + FAN-OUT — a generic consumer process and the bridge
;; from any producer into a bus.
;; ─────────────────────────────────────────────────────────────────────

(defn- subscription-loop [up target batch]
  (receive
    [:events events]
    (do (if (erlang/is_pid target)
          (erlang/send target [:events events])
          (vec (map target events)))
        (erlang/send up [:demand batch (erlang/self)])
        (subscription-loop up target batch))

    [:done]
    (do (when (erlang/is_pid target) (erlang/send target [:done]))
        :done)

    [:cancel]
    (do (erlang/send up [:cancel]) :cancelled)

    (after 3600000 (subscription-loop up target batch))))

(defn subscribe
  "Subscribe a function or process to `up`. The consumer pulls `:demand`
   events at a time and tags demand with its pid so fan-out producers can
   account for each subscriber independently. `:on-lag` and `:max-lag` are
   advisory metadata understood by buses and ignored by ordinary producers."
  ([up id target] (subscribe up id target {}))
  ([up id target opts]
   (let [batch (get opts :demand 8)
         policy (get opts :on-lag :block)
         max-lag (get opts :max-lag 1024)
         consumer (spawn (fn [] (subscription-loop up target batch)))]
     (erlang/send up [:subscribe consumer])
     (erlang/send up [:flow-options consumer id policy max-lag])
     (erlang/send up [:demand batch consumer])
     consumer)))

(defn broadcast
  "Start a bus fed by `up`. The bridge subscribes with ordinary flow demand;
   bus subscribers therefore see the same events as `proc.bus/publish` produces."
  ([up] (proc.bus/start-broadcast up {}))
  ([up opts] (proc.bus/start-broadcast up opts)))

;; ─────────────────────────────────────────────────────────────────────
;; FAN-OUT — one upstream, N concurrent workers.
;;
;; `subscribe` gives ONE consumer a demand-driven view of a stream;
;; `distribute` gives N. It demands from upstream the SUM of what its workers
;; have asked for, and routes each event to exactly one worker that has demand.
;; The arithmetic is the point: a worker that stops renewing withholds its own
;; credit, so the producer is throttled to the sum and cannot run away. A slow
;; worker bounds the producer; a dead one is reported, never silently dropped.
;;
;; Wire protocol — a worker C and its distributor D:
;;   C -> D   [:subscribe C]      join the worker set
;;   C -> D   [:demand n C]       I can take n more
;;   D -> C   [:events (e …)]     at most the per-worker demand outstanding
;;   D -> C   [:done]             upstream exhausted and every event routed
;;   C -> D   [:worker-done C]    after :done, C has handled all it was sent
;; ─────────────────────────────────────────────────────────────────────

(defn- d-demand
  "The live workers' total outstanding demand — the upstream window."
  [workers]
  (reduce (fn [acc w] (+ acc (:demand w))) 0 workers))

(defn- d-ready
  "Index at or after `start` (cyclically) of a worker with demand > 0, or nil."
  [workers start]
  (let [n (count workers)]
    (when (> n 0)
      (loop [i 0]
        (if (>= i n)
          nil
          (let [j (mod (+ start i) n)]
            (if (> (:demand (nth workers j)) 0) j (recur (inc i)))))))))

(defn- d-dispatch
  "Route `pending` events to live workers, one each, round-robin from `next`.
   Every event lands on exactly one worker, and only on one that had demand."
  [workers pending next]
  (loop [ws workers p (vec pending) idx next]
    (if (empty? p)
      [ws p idx]
      (let [j (d-ready ws idx)]
        (if (nil? j)
          [ws p idx]
          (let [w (nth ws j)
                ev (first p)]
            (erlang/send (:pid w) [:events [ev]])
            (recur (assoc ws j (assoc w
                                      :demand (- (:demand w) 1)
                                      :inflight (conj (:inflight w) ev)))
                   (vec (rest p))
                   (mod (inc j) (count ws)))))))))

(defn- d-topup
  "Demand from upstream the difference between the workers' total demand and
   what is already buffered or in flight. The window IS the sum — no more is
   ever asked of the producer."
  [st up]
  (if (:done? st)
    st
    (let [target (max 0 (- (d-demand (:workers st)) (count (:pending st))))
          out (:up-out st)]
      (if (> target out)
        (do (erlang/send up [:demand (- target out) (erlang/self)])
            (assoc st :up-out target))
        st))))

(defn- d-credit
  "A worker renewed demand: add the credit and clear the in-flight set it has
   now accounted for by renewing."
  [st w n]
  (assoc st :workers
         (vec (map (fn [x]
                     (if (= (:pid x) w)
                       (assoc x :demand (+ (:demand x) n) :inflight [])
                       x))
                   (:workers st)))))

(defn- d-without
  "The worker set with `ref` removed."
  [st ref]
  (vec (remove (fn [w] (= (:ref w) ref)) (:workers st))))

(defn- d-report
  "Tell the observer a worker died. A fn is called, a pid is sent a
   `[:worker-down …]`; with no observer the loss has nowhere to go, but the
   demand is still returned from the window."
  [down pid reason lost]
  (when (some? down)
    (let [notice {:worker pid :reason reason :lost (vec lost)}]
      (if (erlang/is_pid down)
        (erlang/send down [:worker-down notice])
        (down notice)))))

(defn- d-finish
  "The stream is fully handled: tell the observer once, and stop."
  [st]
  (when (some? (:on-done st)) ((:on-done st)))
  (assoc st :finished? true))

(defn- d-close
  "Upstream is exhausted and nothing is pending: release every worker, then
   wait for them to confirm they handled what they were sent."
  [st]
  (vec (map (fn [w] (erlang/send (:pid w) [:done])) (:workers st)))
  (if (empty? (:workers st))
    (d-finish st)
    (assoc st :closing? true)))

(defn- d-continue
  "Dispatch what can go, reconcile the upstream window, and close the stream
   once upstream is exhausted and nothing is left pending — so a demand that
   finally drains a backlog still ends the run."
  [st]
  (let [[ws p idx] (d-dispatch (:workers st) (:pending st) (:next st))
        st (d-topup (assoc st :workers ws :pending p :next idx) (:up st))]
    (if (and (:done? st) (empty? (:pending st))
             (not (:closing? st)) (not (:finished? st)))
      (d-close st)
      st)))

(defn- d-lost
  "A monitored worker died: report the events it held, drop it, and let the
   survivors absorb any pending backlog. Its demand leaves the window."
  [st ref pid reason]
  (let [victim (first (filter (fn [w] (= (:ref w) ref)) (:workers st)))]
    (if (nil? victim)
      st
      (do
        (d-report (:down st) pid reason (:inflight victim))
        (let [st (assoc st :workers (d-without st ref))
              [ws p idx] (d-dispatch (:workers st) (:pending st) (:next st))
              st (assoc st :workers ws :pending p :next idx)]
          (if (and (:closing? st) (empty? (:workers st)))
            (d-finish st)
            st))))))

(defn- d-loop [st]
  (receive
    [:subscribe w]
    (let [worker {:pid w :ref (erlang/monitor :process w) :demand 0 :inflight []}]
      (d-loop (assoc st :workers (conj (:workers st) worker))))

    [:demand n w]
    (let [st (d-continue (d-credit st w n))]
      (if (:finished? st) :finished (d-loop st)))

    ;; untagged demand is meaningful only for the single-consumer case
    [:demand n]
    (let [st (d-continue (if (= 1 (count (:workers st)))
                           (d-credit st (:pid (first (:workers st))) n)
                           st))]
      (if (:finished? st) :finished (d-loop st)))

    [:events events]
    (let [st (d-continue (assoc st
                                :pending (into (:pending st) events)
                                :up-out (max 0 (- (:up-out st) (count events)))))]
      (if (:finished? st) :finished (d-loop st)))

    [:worker-done w]
    (let [victim (first (filter (fn [x] (= (:pid x) w)) (:workers st)))
          st (if (nil? victim)
               st
               (do (erlang/demonitor (:ref victim) (list :flush))
                   (assoc st :workers (d-without st (:ref victim)))))]
      (if (and (:closing? st) (empty? (:workers st)))
        (do (d-finish st) :finished)
        (d-loop st)))

    [:done]
    (let [st (d-continue (assoc st :done? true))]
      (if (:finished? st) :finished (d-loop st)))

    [:workers from]
    (do (erlang/send from [:workers (vec (map (fn [w] (:pid w)) (:workers st)))])
        (d-loop st))

    [:DOWN ref :process pid reason]
    (let [st (d-lost st ref pid reason)]
      (if (:finished? st) :finished (d-loop st)))

    (after 3600000 (d-loop st))))

(defn- worker-loop [dist f batch]
  (erlang/send dist [:subscribe (erlang/self)])
  (erlang/send dist [:demand batch (erlang/self)])
  (loop []
    (receive
      [:events events]
      (do (vec (map f events))
          (erlang/send dist [:demand batch (erlang/self)])
          (recur))
      [:done]
      (do (erlang/send dist [:worker-done (erlang/self)]) :done)
      (after 3600000 (recur)))))

(defn distribute
  "Fan `up` out to `concurrency` concurrent workers, each running `(f event)`
   on its own process. Returns the distributor pid; `(workers d)` lists the
   live workers.

   The distributor is a producer to its workers and a consumer of `up`, and it
   extends the same demand protocol: workers pull with `[:demand n self]`, the
   distributor demands the SUM of their outstanding demand upstream, and routes
   each event to exactly one worker that had demand for it.

   INVARIANTS:
   · exactly-once routing: an upstream event is sent to exactly ONE worker,
     chosen round-robin among live workers with demand. While every worker
     lives, no event is lost and none is delivered twice.
   · the upstream window IS the sum of the workers' demand: the distributor
     asks upstream for `sum(demand) - pending` and nothing more, so a worker
     that stops renewing withholds only its own credit and throttles the
     producer. A slow worker cannot let the producer run away.
   · reported loss: the protocol has no ack, so an event handed to a worker
     counts as delivered. If a worker DIES, the events it was handed since its
     last demand are reported to `:on-down` as `{:worker pid :reason reason
     :lost [events]}` — AT-MOST-ONCE per worker, with the loss stated rather
     than guessed. The dead worker's demand leaves the window, so the producer
     stops working for a gone pid.

   opts (all optional): `:concurrency` workers (default 1 — exactly the single
   consumer), `:batch` events demanded per worker at a time (default 8),
   `:on-down` a fn or pid told about a worker death, `:on-done` a fn called once
   when the stream is fully handled (upstream exhausted AND every worker has
   handled what it was sent)."
  ([up f] (distribute up f {}))
  ([up f opts]
   (let [n (max 1 (get opts :concurrency 1))
         batch (get opts :batch 8)
         dist (spawn (fn []
                       (erlang/send up [:subscribe (erlang/self)])
                       (d-loop {:up up
                                :workers [] :next 0 :pending [] :up-out 0
                                :done? false :closing? false :finished? false
                                :down (get opts :on-down nil)
                                :on-done (get opts :on-done nil)})))]
     (vec (map (fn [_] (spawn (fn [] (worker-loop dist f batch))))
               (range n)))
     dist)))

(defn workers
  "The live worker pids of a `distribute` handle — the fan-out in flight."
  [d]
  (erlang/send d [:workers (erlang/self)])
  (receive
    [:workers ws] ws
    (after 5000 :timeout)))

