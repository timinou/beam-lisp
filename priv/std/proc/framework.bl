; Shared fixed-SDK actors belong to an application's logical lifetime while
; accepted callbacks retain their own exact application generations. App-owned
; actor declarations continue through ordinary generation ownership.
(ns proc.framework
 (:require [proc.owner-registry :as owners]))

(defn adopt!
 "Bind the authenticated SDK declaration context and monitor the application's
  initializer. This is called from ordinary generated init, after instance
  resources have been obtained. No app wrapper or SDK namespace allowlist."
 [initializer]
 (BeamLisp.Env/adopt_framework! initializer))

(defn adopt-runtime!
 "Declare this actual fixed-SDK init as a data-only VM-lifetime resource. The
  native boundary refuses application declarations and calls outside init."
 []
 (BeamLisp.Env/adopt_sdk_runtime!))

(defn alive? [handle]
 (or (nil? handle) (Process/alive? (:initializer handle))))

(defn initializer-down? [handle ref pid]
 (and handle (= (:monitor handle) ref) (= (:initializer handle) pid)
      (not (Process/alive? pid))))

(defn close! [handle]
 (when handle
  (try (owners/unregister! (:membership handle))
   (finally (BeamLisp.Env/release_framework! handle))))
 :ok)

(defn owner-evidence
 "Read exact native framework authority without actor RPCs or binding its Env.
  Application inventory observes lifecycle membership, not mutation authority."
 [pid]
 (when-let [native (BeamLisp.Env/framework_owner_evidence pid)]
  (let [lease (:lease native)]
   (assoc (select-keys native [:kind :application-id :module :declaration :initializer :origin-generation :starter])
     :ticket (elem lease 2) :retained true))))
