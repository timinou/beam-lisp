; Application-instance process identity without creating one atom per instance.
; Names survive source generations, never cross an application boundary, and
; OTP unregisters them on owner death. Lifetime/state evolution is separate.
(ns proc.instance)

(defn- application-id []
 (let [g (Process/get :bl_generation)
       id (if g (:application-id g) (Process/get :bl_application_identity))]
  (when (or g id)
   (when-not (and (string? id) (<= 1 (erlang/byte_size id) 128))
    (throw (ex-info "Managed process identity requires an application instance"
             {:kind :missing-application-id})))
   id)))

(defn identity
 "Scope a lock or registry key to the current application instance. Outside a
  managed generation, isolated environments receive isolated identities. The
  unbound global environment retains legacy names. No graph digest enters the
  identity: code publication must not create another owner."
 [logical]
 (if-let [id (application-id)] (tuple :beam_lisp_instance id logical)
  (let [scope (BeamLisp.Env/env_id)]
   (if (= :global scope) logical (tuple :beam_lisp_environment scope logical)))))

(defn name
 "OTP reference for a literal logical name. Managed names use ordinary global
  term registration, not dynamically allocated atoms or an unscoped fallback."
 [logical]
 (when-not (keyword? logical)
  (throw (ex-info "Process names require a logical keyword" {:kind :invalid-instance-name})))
 (let [key (identity logical)]
  (if (= key logical) logical (tuple :global key))))

(defn whereis [logical]
 (let [reference (name logical)]
  (if (tuple? reference)
   (let [pid (global/whereis_name (elem reference 1))]
    (when (and (not= :undefined pid) (Process/alive? pid)) pid))
   (Process/whereis reference))))

(defn register!
 "Register an already-owned local process. A conflict refuses and leaves the
  existing registration intact. This never transfers lifecycle authority."
 [logical pid]
 (when-not (and (erlang/is_pid pid) (= (erlang/node pid) (erlang/node)) (Process/alive? pid))
  (throw (ex-info "Process registration requires a live local owner" {:kind :invalid-instance-owner})))
 (let [reference (name logical)]
  (if (tuple? reference)
   (when-not (= :yes (global/register_name (elem reference 1) pid))
    (throw (ex-info "Application process is already registered" {:kind :instance-name-conflict})))
   (Process/register pid reference))
  pid))
