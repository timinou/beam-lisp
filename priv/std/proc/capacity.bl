; Shared native obligation admission across otherwise independent queue journals.
; This is upstream queue infrastructure, not a provider quota/scheduler or a
; second domain outbox. Reservation and queue stores have an explicit crash seam.
(ns proc.capacity
 (:require [datom :as d] [datom.conn :as dc] [datom.store :as ds]
           [proc.queue :as q] [proc.queue-runtime :as runtime]))
(def SCHEMA
 [{:db/ident :capacity.authority/id :db/valueType :db.type/string :db/unique :db.unique/identity}
  {:db/ident :capacity.authority/repair-cursor :db/valueType :db.type/string}
  {:db/ident :capacity.authority/path :db/valueType :db.type/string}
  {:db/ident :capacity.authority/relocations :db/valueType :db.type/term}
  {:db/ident :capacity.authority/policy :db/valueType :db.type/term}
  {:db/ident :capacity.reservation/key :db/valueType :db.type/term :db/unique :db.unique/identity}
  {:db/ident :capacity.reservation/descriptor :db/valueType :db.type/term}
  {:db/ident :capacity.reservation/state :db/valueType :db.type/keyword :db/index true}
  {:db/ident :capacity.reservation/job-id :db/valueType :db.type/string}])
(defn- refuse [kind] (throw (ex-info "Native shared capacity refused" {:kind kind})))
(defn- digest [value] (Base/encode16 (crypto/hash :sha256 (erlang/term_to_binary value))))
(defn- sync! [c] (if (ds/durable? (:store c)) (do (ds/sync! (:store c)) :stable) :volatile))
(defn- positive? [x] (and (erlang/is_integer x) (<= 1 x 1000000)))
(defn- policy! [policy]
 (when-not (and (map? policy) (= #{:max-outstanding :scopes} (set (keys policy)))
               (positive? (:max-outstanding policy)) (vector? (:scopes policy))
               (<= (count (:scopes policy)) 8)) (refuse :invalid-capacity-policy))
 (doseq [scope (:scopes policy)]
  (when-not (and (map? scope) (= #{:keys :max} (set (keys scope)))
                (vector? (:keys scope)) (<= 1 (count (:keys scope)) 8)
                (every? keyword? (:keys scope)) (= (count (:keys scope)) (count (distinct (:keys scope))))
                (positive? (:max scope)) (<= (:max scope) (:max-outstanding policy)))
   (refuse :invalid-capacity-scope)))
 (when-not (= (count (:scopes policy)) (count (distinct (map :keys (:scopes policy)))))
  (refuse :invalid-capacity-scope))
 policy)
(defn- scope-value [scope fields]
 (let [value (mapv #(get scope %) fields)]
  (when-not (and (every? some? value) (<= (erlang/byte_size (erlang/term_to_binary value)) 4096))
   (refuse :invalid-capacity-capture))
  value))
(defn attach-store!
 "Bind one explicitly owned durable Datom connection as the shared native
  admission authority. Caller owns open/stop/close and passes this SAME handle
  to every configured queue owner. Live replacement and different-path rebind
  refuse. Closed same-file reopen retains native reservations/policy."
 ([id c supplied-policy] (attach-store! id c supplied-policy {}))
 ([id c supplied-policy opts]
 (when-not (and (map? opts) (every? #{:relocate-from} (keys opts))
               (or (not (contains? opts :relocate-from)) (string? (:relocate-from opts))))
  (refuse :invalid-capacity-relocation))
 (when-not (and (string? id) (<= 1 (erlang/byte_size id) 256) (ds/durable? (:store c)))
  (refuse :invalid-capacity-authority))
 (let [policy (policy! supplied-policy) registry (tuple :proc.capacity id)]
  (BeamLisp.Env/with_generation_lock registry
   (fn []
    (let [old (erlang/apply :persistent_term :get (list registry nil))
          old-path (when old (:path (ds/identity-of (:store old))))
          current-path (:path (ds/identity-of (:store c)))]
     (when (and old (not= c old)
                (not (and (= :closed @(:lifetime old)) (string? old-path) (string? current-path)
                          (or (= old-path current-path) (= old-path (:relocate-from opts))))))
      (refuse :capacity-authority-already-bound))
     (dc/serialized! c (fn []
      (d/install-schema! c SCHEMA)
      (when (some #(not= id (first %)) (d/q '[:find ?id :where [_ :capacity.authority/id ?id]] (d/db c)))
       (refuse :capacity-authority-store-conflict))
      (let [record (d/entity (d/db c) [:capacity.authority/id id])
            previous (:capacity.authority/policy record)
            from (:capacity.authority/path record)
            current (:path (ds/identity-of (:store c)))]
       (when-not (string? current) (refuse :capacity-file-authority-required))
       (when (and from (not= from current) (not= from (:relocate-from opts)))
        (refuse :capacity-relocation-proof-required))
       (when (and (:relocate-from opts) (not= from (:relocate-from opts)))
        (refuse :capacity-relocation-source-conflict))
       (when (and (nil? record) (:relocate-from opts)) (refuse :capacity-relocation-identity-missing))
       ;; Policy changes are explicit later; stale handles cannot silently
       ;; change the meaning of reservations across independent queue owners.
       (when (and previous (not= previous policy)) (refuse :capacity-policy-migration-required))
       (d/transact! c [(cond-> {:db/id -1 :capacity.authority/id id :capacity.authority/policy policy
                                :capacity.authority/path current}
                        (and from (not= from current))
                          (assoc :capacity.authority/relocations
                            (conj (:capacity.authority/relocations record []) {:from from :to current})))]))
      (sync! c)))
     (erlang/apply :persistent_term :put (list registry c))
     {:id id :conn c :policy policy}))))))
(defn- live! [authority]
 (when-not (= (:conn authority) (erlang/apply :persistent_term :get (list (tuple :proc.capacity (:id authority)) nil)))
  (refuse :stale-capacity-authority))
 (when-not (= (:policy authority)
              (:capacity.authority/policy (d/entity (d/db (:conn authority)) [:capacity.authority/id (:id authority)])))
  (refuse :stale-capacity-policy))
 authority)
(defn- descriptor! [authority srv payload opts capture]
 (when-not (and (map? capture) (some? (:enrollment-key opts))
               (<= (erlang/byte_size (erlang/term_to_binary [capture (:enrollment-key opts)])) 8192))
  (refuse :invalid-capacity-capture))
 (doseq [scope (get-in authority [:policy :scopes])] (scope-value capture (:keys scope)))
 {:queue (q/server-name srv) :enrollment (:enrollment-key opts)
  :payload-hash (digest payload) :protocol (:protocol opts (get (q/declaration srv) :protocol 1))
  :generation (:generation opts) :capture capture})
(defn- reservation-key [authority descriptor] [(:id authority) (:queue descriptor) (:enrollment descriptor)])
(defn- reservations [authority]
 (mapv (fn [[e]] (d/entity (d/db (:conn authority)) e))
  (d/q '[:find ?e :where [?e :capacity.reservation/key _]] (d/db (:conn authority)))))
(defn- reserve-row!
 "One writer-atomic aggregate obligation reservation. Captured property/provider
  identity is application-authorized data; this native API infers no quotas.
  Duplicate immutable identity succeeds even at capacity. Unknown/reserved/
  enrolled rows keep consuming budget; only explicit safe release ends it."
 [authority srv payload opts capture grandfather?]
 (live! authority)
 (let [descriptor (descriptor! authority srv payload opts capture)
       key (reservation-key authority descriptor) c (:conn authority)]
  (dc/serialized! c (fn []
   (live! authority)
   (if-let [old (d/entity (d/db c) [:capacity.reservation/key key])]
    (do (when-not (= descriptor (:capacity.reservation/descriptor old)) (refuse :capacity-identity-conflict))
        {:status (if (= :released (:capacity.reservation/state old)) :released :existing) :reservation key})
    (let [rows (filter #(not= :released (:capacity.reservation/state %)) (reservations authority))
          policy (:policy authority)
          full? (or (>= (count rows) (:max-outstanding policy))
                    (some (fn [scope]
                     (let [value (scope-value capture (:keys scope))]
                      (>= (count (filter #(= value (scope-value (get-in % [:capacity.reservation/descriptor :capture]) (:keys scope))) rows))
                          (:max scope)))) (:scopes policy)))]
     (if (and full? (not grandfather?)) {:status :deferred :reason :shared-capacity}
      (do (d/transact! c [{:db/id -1 :capacity.reservation/key key
                          :capacity.reservation/descriptor descriptor :capacity.reservation/state :reserved}])
          {:status :reserved :reservation key :durability (sync! c)}))))))))
(defn reserve! [authority srv payload opts capture]
 (reserve-row! authority srv payload opts capture false))
(defn authorize!
 "Before actual application body/effect, verify its captured immutable native
  reservation. Repair enrollment-before-bind here; this is a counted original
  obligation, never permission to create a new provider effect or repeat one."
 [authority job]
 (live! authority)
 (let [canonical (d/entity (d/db (q/conn (keyword (:job/server job)))) (:db/id job))
       _ (when-not (and (= (:job/id job) (:job/id canonical)) (= (:job/server job) (:job/server canonical)))
           (refuse :capacity-worker-authority))
       job canonical c (:conn authority) proof (:job/capacity job)]
  (dc/serialized! c (fn []
   (live! authority)
   (let [row (when proof (d/entity (d/db c) [:capacity.reservation/key (:reservation proof)]))
         descriptor (:capacity.reservation/descriptor row)]
    (when-not (and row (= (:id authority) (:authority proof))
                  (contains? #{:reserved :enrolled} (:capacity.reservation/state row))
                  (= (digest descriptor) (:descriptor-hash proof))
                  (= (:queue descriptor) (:job/server job))
                  (= [(:queue descriptor) (:enrollment descriptor)] (:job/enrollment job))
                  (= (:payload-hash descriptor) (digest (:job/payload job)))
                  (= (:protocol descriptor) (:job/protocol job))
                  (= (:generation descriptor) (:job/generation job))
                  (or (nil? (:capacity.reservation/job-id row))
                      (= (:job/id job) (:capacity.reservation/job-id row))))
     (refuse :capacity-worker-authority))
    (d/transact! c [[:db/add (:db/id row) :capacity.reservation/state :enrolled]
                   [:db/add (:db/id row) :capacity.reservation/job-id (:job/id job)]])
    {:status :authorized :durability (sync! c)})))))
(defn adopt-existing!
 "Explicit accepted-obligation migration BEFORE native owner startup. Existing
  outstanding jobs count even above a newly lowered allocation; no accepted
  unknown is evicted to fit policy. Exact job snapshot is rechecked in its
  journal writer before attaching proof. A cut between stores remains reserved
  and is repaired by this SAME immutable enrollment. No provider IO occurs."
 [authority srv job capture]
 (when (q/serving? srv) (refuse :capacity-migration-owner-live))
 (when-not (and (= (q/server-name srv) (:job/server job)) (:job/enrollment job)
               (contains? #{:queued :running :held} (:job/state job)))
  (refuse :invalid-capacity-migration-job))
 (let [opts {:enrollment-key (second (:job/enrollment job)) :protocol (:job/protocol job 1)
             :generation (:job/generation job)}
       result (reserve-row! authority srv (:job/payload job) opts capture true)
       proof {:authority (:id authority) :reservation (:reservation result)
              :descriptor-hash (digest (descriptor! authority srv (:job/payload job) opts capture))}]
  (when (= :released (:status result)) (refuse :capacity-reservation-released))
  (q/bind-capacity! srv job proof)))

(defn- matching-job? [authority row job]
 (let [descriptor (:capacity.reservation/descriptor row)
       proof {:authority (:id authority) :reservation (:capacity.reservation/key row)
              :descriptor-hash (digest descriptor)}]
  (and job (= (:queue descriptor) (:job/server job))
       (= [(:queue descriptor) (:enrollment descriptor)] (:job/enrollment job))
       (= (:payload-hash descriptor) (digest (:job/payload job)))
       (= (:protocol descriptor) (:job/protocol job))
       (= (:generation descriptor) (:job/generation job)) (= proof (:job/capacity job))
       (or (nil? (:capacity.reservation/job-id row))
           (= (:capacity.reservation/job-id row) (:job/id job))))))
(defn- completed-original! [authority srv reservation]
 ;; READ ONLY: the domain publication marker can be lost AFTER original native
 ;; completion and safe aggregate release. Returning that retained receipt must
 ;; not allocate another slot, remove its fence, or start a worker/effect.
 (when-not (q/store-live? srv) (refuse :capacity-journal-unavailable))
 (let [row (d/entity (d/db (:conn authority)) [:capacity.reservation/key reservation])
       descriptor (:capacity.reservation/descriptor row) c (q/conn srv)]
  (dc/serialized! c (fn []
   (let [job (d/entity (d/db c) [:job/enrollment [(:queue descriptor) (:enrollment descriptor)]])]
    (when-not (and (:capacity.reservation/job-id row)
                  (= :released (:capacity.reservation/state row))
                  (matching-job? authority row job)
                  (= :done (:job/state job))
                  (every? #(contains? #{:complete :absent} (:state %)) (vals (:job/effects job {}))))
     (refuse :capacity-released-receipt-unavailable))
    {:status :existing :job (assoc job :job/created false) :released? true})))))

(defn bind!
 "Publish original queue acceptance after reservation. Completion/release may
   beat this cross-store publication: exact released terminal receipts return
   read-only, never reactivate reservation. Exposed for native cut recovery."
 [authority srv reservation job]
 (live! authority)
 (let [c (:conn authority)
       result (dc/serialized! c (fn []
        (live! authority)
        (let [row (d/entity (d/db c) [:capacity.reservation/key reservation])]
         (when-not (and row (matching-job? authority row job)) (refuse :capacity-binding-conflict))
         (if (= :released (:capacity.reservation/state row)) :released
          (do (d/transact! c [[:db/add (:db/id row) :capacity.reservation/state :enrolled]
                             [:db/add (:db/id row) :capacity.reservation/job-id (:job/id job)]])
              (sync! c) :bound)))))]
  (if (= :released result) (completed-original! authority srv reservation)
    {:status :bound :job job})))
(defn proof
 "The bounded original queue enrollment proof, only after native reservation.
   Native producers may compose explicit reserve/enroll/bind recovery phases."
 [authority reservation]
 (live! authority)
 (let [row (d/entity (d/db (:conn authority)) [:capacity.reservation/key reservation])]
  (when-not row (refuse :capacity-reservation-missing))
  {:authority (:id authority) :reservation reservation
   :descriptor-hash (digest (:capacity.reservation/descriptor row))}))
(defn enroll!
 "Reservation BEFORE original native queue enrollment; bind AFTER. Cross-store
   crash cuts retain original identity. Released completed originals resolve
   read-only both before enrollment and when completion beats final bind."
 [authority srv payload opts capture]
 (let [reserved (reserve! authority srv payload opts capture)]
  (case (:status reserved)
   :deferred reserved
   :released (completed-original! authority srv (:reservation reserved))
   (let [answer (q/try-enqueue! srv payload (assoc opts :capacity-proof (proof authority (:reservation reserved))))]
    (if (= :deferred (:status answer)) answer
     (let [bound (bind! authority srv (:reservation reserved) (:job answer))]
      (if (:released? bound) bound answer)))))))
(defn release!
 "Fence original queue enrollment FIRST, then release its aggregate reservation.
  No-job orphan fencing closes admission-before-enrollment, including late
  producer calls. Unknown/nonterminal effects refuse. A terminal job also needs
  actual native body-death evidence; lease expiry is never physical death.
  Crash after fence/before release is repaired by repeating this same command."
 [authority srv enrollment]
 (live! authority)
 (let [key [(:id authority) (q/server-name srv) enrollment] c (:conn authority)
       row (d/entity (d/db c) [:capacity.reservation/key key])]
  (when-not row (refuse :capacity-reservation-missing))
  (let [fenced (q/fence-enrollment! srv enrollment {:authority (:id authority) :reservation key})
        job (:job fenced)
        _ (when (and job (not (matching-job? authority row job))) (refuse :capacity-binding-conflict))
        physical (when (and job (pos? (:job/attempts job 0))) (runtime/body-status srv (:job/id job)))]
   (cond
    (not= :fenced (:status fenced)) fenced
    (and physical (or (not= :known (:status physical)) (pos? (:live physical))))
      {:status :waiting :reason :physical-body-lifetime}
    :else
      (dc/serialized! c (fn []
       (live! authority)
       (let [current (d/entity (d/db c) [:capacity.reservation/key key])]
        (when-not (= (:capacity.reservation/descriptor row) (:capacity.reservation/descriptor current))
         (refuse :capacity-identity-conflict))
        (d/transact! c (cond-> [[:db/add (:db/id current) :capacity.reservation/state :released]]
                         job (conj [:db/add (:db/id current) :capacity.reservation/job-id (:job/id job)])))
        {:status :released :durability (sync! c)})))))))
(defn status [authority]
 (live! authority)
 {:states (frequencies (map :capacity.reservation/state (reservations authority)))
  :max-outstanding (get-in authority [:policy :max-outstanding])})
(defn repair!
 "One bounded native recovery pass over counted obligations. Terminal original
  jobs may release only through the durable fence/body-death protocol. Absent
  reservations remain owed; this never guesses that a missing acknowledgement
  means no enrollment/effect, and never submits/retries provider IO."
 [authority limit]
 (live! authority)
 (when-not (and (erlang/is_integer limit) (<= 1 limit 1000)) (refuse :invalid-capacity-repair-limit))
 (let [c (:conn authority)
       cursor (:capacity.authority/repair-cursor (d/entity (d/db c) [:capacity.authority/id (:id authority)]))
       active (sort-by #(digest (:capacity.reservation/key %))
                (filter #(not= :released (:capacity.reservation/state %)) (reservations authority)))
       rows (take limit (concat
                  (filter #(or (nil? cursor) (> (compare (digest (:capacity.reservation/key %)) cursor) 0)) active)
                  (filter #(and cursor (<= (compare (digest (:capacity.reservation/key %)) cursor) 0)) active)))
       outcomes (mapv (fn [row]
         (let [descriptor (:capacity.reservation/descriptor row) srv (keyword (:queue descriptor))]
          (if-not (q/store-live? srv) {:status :waiting :reason :journal-unavailable}
           (let [job (d/entity (d/db (q/conn srv)) [:job/enrollment [(:queue descriptor) (:enrollment descriptor)]])]
            (if (and job (contains? #{:done :failed :cancelled} (:job/state job)))
              (release! authority srv (:enrollment descriptor))
              {:status :waiting :reason (if job :outstanding-obligation :owed-enrollment)}))))) rows)]
  (when (seq rows)
   (dc/serialized! c (fn []
    (live! authority)
    (let [owner (d/entity (d/db c) [:capacity.authority/id (:id authority)])]
     ;; Concurrent repair never overwrites a newer pass's progress with an old
     ;; snapshot. This cursor schedules repair reads, never provider effects.
     (when (= cursor (:capacity.authority/repair-cursor owner))
      (d/transact! c [[:db/add (:db/id owner) :capacity.authority/repair-cursor
                       (digest (:capacity.reservation/key (last rows)))]])
      (sync! c))))))
  {:examined (count rows) :states (frequencies (map :status outcomes))}))
