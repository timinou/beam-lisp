; proc/queue.bl — the durable queue: a job is a FACT, and the store is the wheel.
;
; ══ WHAT THIS IS ════════════════════════════════════════════════════════════
;
; The Deadline Queue of docs/scheduling/the-clock-and-the-wheel.md §3.1, over the
; store a server already has. Two of its patterns need NO new machinery —
; Idempotency Key (a unique value in the store) and Claim/Lease (a guarded
; transaction) — and everything else is the clause that declares both:
;
;   (proc/defserver larder
;     (queue {:of          :hotel/order
;             :concurrency 4
;             :retry       {:max 5 :backoff :exponential :base 1000
;                           :max-delay 60000 :jitter 0.2}
;             :unique      [:order/room :order/item]
;             :lease       300
;             :partition   [:order/room]})
;     (perform [job] (charge! job)))
;
;   (proc.queue/enqueue! :larder {:order/room "101" :order/item :breakfast})
;   (proc.queue/enqueue! :larder {:order/room "102" :order/item :minibar}
;                                {:in [30 :minutes]})
;   (proc.queue/enqueue! :larder {:order/room "103" :order/item :audit}
;                                {:at (proc/next housekeeping :audit)})
;
;   (proc.queue/stats :larder)   ; {:queued 3 :running 1 :done 12 :failed 0 …}
;
; ══ AT-LEAST-ONCE, SAID OUT LOUD ════════════════════════════════════════════
;
; This is an AT-LEAST-ONCE queue, and a body that has BEGUN may run AGAIN:
;
;   · a worker that is killed after its side effect, but before the outcome is
;     written, leaves the job `:running`; when its lease expires the job is
;     claimed and `perform` runs a second time;
;   · the write that records the outcome is itself refused when the queue lost
;     the job in the meantime (another claimant owns it), so the JOB cannot be
;     double-finished — but the BODY already ran.
;
; ∴ `perform` MUST be idempotent, or the caller must make it so. At-most-once
; EFFECT is available and is what this file gives you: the job settles once,
; under one owner token. At-most-once DELIVERY is not, and no amount of care
; inside this file could give it to you — the body's effect and the fact that
; records it are in two different processes.
;
; ══ THE CLAIM IS THE WHOLE OF CLAIM/LEASE ═══════════════════════════════════
;
; Taking a due job and marking it running is ONE transaction, and the CAS in it
; is what makes two claims unable to take one job:
;
;   [[:db/cas e :job/state :queued :running]   ; only if it is STILL queued
;    [:db/add e :job/lease-until …]
;    [:db/add e :job/owner token]
;    [:db/add e :job/attempt-id token]
;    [:db/add e :job/attempts n]]
;
; The read that decides "is it still :queued?" happens INSIDE the connection's
; writer (datom.conn/transact! serialises every write per connection), so it is
; not a read-then-write window — it is the transaction's own before-value. The
; loser's whole transaction is refused, and `claim!` answers nil; it does not
; half-apply. (BUG-022 lived one layer down, in the basis; the claim is proven
; under concurrency by `two-concurrent-claims-never-take-one-job`.)
;
; ══ THE NOTIFIER IS THE STORE, AND THE WAKE IS ONE TIMER ════════════════════
;
; Enqueue is a COMMIT, so it broadcasts on the store it wrote (`datom/listen!`,
; §3.2's "the notifier = datom/watch — no second transport") and the loop wakes.
; The wake itself is ONE `send_after` at the earliest deadline still worth a
; timer — a queued job's `:at` in the FUTURE, or a running job's lease expiry
; (the Lifeline wake: an orphan is reclaimed when its lease runs out, with no
; poll). A deadline already BEHIND us is not a timer: at boot it is a job nobody
; has claimed and the tick is the only thing that will notice it, while at
; runtime it is a job this process can already claim or one waiting for a slot —
; and a slot frees with a MESSAGE (a completion), never with a poll. Nothing
; scans, nothing sleeps in a loop, and the number of timers is one.
;
; The generation counter `tick` needs is NOT needed here. `tick-cancel` cannot
; un-send a message, so a stale tick's BODY must be refused; a stale queue wake
; only re-reads the store and claims what is due, which is idempotent by
; construction. A second timer is therefore cancelled and a message already in
; flight is harmless.
;
; ══ THE VERBS, AND THE ONE THAT IS NOT MACHINERY ═══════════════════════════
;
; `enqueue!` (a store write, with the queue's eligibility rules applied to it),
; `stats` (a QUERY — counts by status, so the pane never asks a process, and the
; answer is the same whether the queue is running, stopped, or was never started
; in this VM), `cancel!` (a store write that stops work NOT YET BEGUN) and
; `prune!` (a store write that deletes TERMINAL jobs past a bound). `retry`,
; `unique`, `lease`, `concurrency` and `partition` are OPTIONS ON THE CLAIM
; LOOP, not verbs.
;
; WHAT CANNOT BE CANCELLED, and why, is its own section below, beside `cancel!`.
;
; `prune!` is the FN, NOT the SCHEDULE. The design puts a queue's prune in the
; tree that owns it — a `:schedules` declaration of the tree's own verb (§4.3) —
; and this file invents no second scheduler to say when. What belongs here is
; that the DELETE is correct: terminal jobs only, never one that is owed,
; claimed or mid-retry. `prune!`'s docstring carries the declaration a tree
; writes, and the reason the guard is STRUCTURAL rather than a filtered check.
;
; ══ SEE ALSO ════════════════════════════════════════════════════════════════
;
; priv/std/proc/sched.bl — the sibling clause this is modelled on: the same
;   announcement name, the same public ETS table with an heir, the same "the
;   pane reads the store, never the process".
; priv/lib/datom/tx.bl — `cas-ops`, the compare-and-swap this claim is built on.

(ns proc.queue
  (:require [datom :as datom]
            [datom.conn :as dc]
            [datom.store :as ds]
            [datom.schema :as schema]
            [datom.store-ets :as store-ets]
            [proc.server :refer [extend-clause!]]
            [proc.table :as table]
            [proc.tick :as tick]
            [proc.fence :as fence]
            [diagnostics :as diag]))

;; ── the declaration, and its refusals ───────────────────────────────────

(def KNOWN-DECL-OPTS [:of :concurrency :retry :unique :lease :partition :protocol :generation :admission :dispatch])

(def KNOWN-CLAUSE-OPTS [:of :concurrency :retry :unique :lease :partition :protocol :generation :admission :dispatch
                        :clock :server :contract])

(def KNOWN-RETRY-OPTS [:max :backoff :base :max-delay :jitter])

(def KNOWN-BACKOFF [:exponential :constant])

(def KNOWN-ENQUEUE-OPTS [:in :at :protocol :generation :source-id :parent-id :enrollment-key])

(defn- known? [k ks] (some (fn [x] (= x k)) ks))

(defn- positive-int? [v] (and (erlang/is_integer v) (> v 0)))

(defn- positive-number? [v] (and (number? v) (> v 0)))

(defn- normalise-retry
  "The retry policy, defaults filled, every value a number a `backoff-ms` can
   honour. `:max` is the number of ATTEMPTS (Oban's `max_attempts`), not a
   delay; the delay ceiling is `:max-delay`. Two meanings of one word is how a
   knob comes to do nothing, and a map cannot hold `:max` twice."
  [r]
  (let [r (or r {})]
    (when-not (map? r)
      (throw (ex-info (str "queue: :retry must be a map — got " (str r)) {:retry r})))
    (doseq [k (keys r)]
      (when-not (known? k KNOWN-RETRY-OPTS)
        (throw (ex-info (str "queue: unknown :retry option " k " — known: "
                             (join " " (map (fn [x] (str x)) KNOWN-RETRY-OPTS)))
                        {:option k :retry r}))))
    (let [max (get r :max 1)
          backoff (get r :backoff :exponential)
          base (get r :base 1000)
          ceiling (get r :max-delay 60000)
          jitter (get r :jitter 0)]
      (when-not (positive-int? max)
        (throw (ex-info (str "queue: :retry :max is the number of attempts and must be a"
                             " positive integer — got " (str max))
                        {:max max})))
      (when-not (known? backoff KNOWN-BACKOFF)
        (throw (ex-info (str "queue: unknown :backoff " (str backoff) " — use "
                             (join " " (map (fn [x] (str x)) KNOWN-BACKOFF)))
                        {:backoff backoff})))
      (when-not (positive-int? base)
        (throw (ex-info (str "queue: :retry :base is milliseconds and must be a positive"
                             " integer — got " (str base))
                        {:base base})))
      (when-not (positive-int? ceiling)
        (throw (ex-info (str "queue: :retry :max-delay is milliseconds and must be a"
                             " positive integer — got " (str ceiling))
                        {:max-delay ceiling})))
      (when-not (and (number? jitter) (>= jitter 0))
        (throw (ex-info (str "queue: :retry :jitter is a fraction and must be ≥ 0 — got "
                             (str jitter))
                        {:jitter jitter})))
      {:max max :backoff backoff :base base :max-delay ceiling :jitter jitter})))

(defn- normalise-admission [policy]
  (when-not (and (map? policy) (= #{:max-outstanding :scopes} (set (keys policy)))
                (positive-int? (:max-outstanding policy)) (<= (:max-outstanding policy) 1000000)
                (vector? (:scopes policy)) (<= (count (:scopes policy)) 8))
    (throw (ex-info "Invalid native queue admission policy" {:kind :invalid-admission})))
  (doseq [scope (:scopes policy)]
    (when-not (and (map? scope) (= #{:keys :max} (set (keys scope)))
                  (vector? (:keys scope)) (<= 1 (count (:keys scope)) 8)
                  (= (count (:keys scope)) (count (distinct (:keys scope))))
                  (every? keyword? (:keys scope)) (positive-int? (:max scope))
                  (<= (:max scope) (:max-outstanding policy)))
      (throw (ex-info "Invalid native queue admission scope" {:kind :invalid-admission-scope}))))
  (when-not (= (count (:scopes policy)) (count (distinct (map :keys (:scopes policy)))))
    (throw (ex-info "Repeated admission scope" {:kind :invalid-admission-scope})))
  policy)

(defn- normalise-dispatch [policy]
  (when-not (and (map? policy) (= #{:mode :group :max-groups} (set (keys policy)))
                (= :round-robin (:mode policy)) (vector? (:group policy))
                (<= 1 (count (:group policy)) 8) (every? keyword? (:group policy))
                (= (count (:group policy)) (count (distinct (:group policy))))
                (positive-int? (:max-groups policy)) (<= (:max-groups policy) 4096))
    (throw (ex-info "Invalid durable native dispatch policy" {:kind :invalid-dispatch})))
  policy)

(defn normalise-decl
  "A queue's declaration with every default filled and every typo REFUSED, so
   the rest of this file reads one shape.

   It is called twice on purpose: once when the clause is EXPANDED (a literal
   typo fails at compile time, naming the server) and once at boot (the same
   checks over the values that actually arrived). A declaration is data — the
   options are literals, and `:clock` is the one expression allowed, which is
   why it is not part of this map."
  [d]
  (when-not (map? d)
    (throw (ex-info (str "queue: the declaration must be a map, got " (str d)) {:decl d})))
  (doseq [k (keys d)]
    (when-not (known? k KNOWN-DECL-OPTS)
      (throw (ex-info (str "queue: unknown declaration option " k " — known: "
                           (join " " (map (fn [x] (str x)) KNOWN-DECL-OPTS)))
                      {:option k :decl d}))))
  (let [of (get d :of)
        concurrency (get d :concurrency 1)
        lease (get d :lease 300)
        unique (or (get d :unique) [])
        partition (or (get d :partition) [])]
    (when-not (keyword? of)
      (throw (ex-info (str "queue: :of is required and must be a keyword — the entity"
                           " kind this server's jobs are")
                      {:decl d})))
    (when-not (positive-int? concurrency)
      (throw (ex-info (str "queue: :concurrency must be a positive integer — got "
                           (str concurrency))
                      {:concurrency concurrency})))
    (when-not (positive-number? lease)
      (throw (ex-info (str "queue: :lease is a duration in SECONDS and must be > 0 — got "
                           (str lease))
                      {:lease lease})))
    (when-not (vector? unique)
      (throw (ex-info (str "queue: :unique is the key set the store enforces, as a vector"
                           " of attribute keywords — got " (str unique))
                      {:unique unique})))
    (when-not (vector? partition)
      (throw (ex-info (str "queue: :partition is a vector of attribute keywords — got "
                           (str partition))
                      {:partition partition})))
    (doseq [k unique]
      (when-not (keyword? k)
        (throw (ex-info (str "queue: every :unique key must be a keyword — got " (str k))
                        {:key k}))))
    (doseq [k partition]
      (when-not (keyword? k)
        (throw (ex-info (str "queue: every :partition key must be a keyword — got " (str k))
                        {:key k}))))
    (when-not (positive-int? (:protocol d 1))
      (throw (ex-info "queue: :protocol must be a positive integer" {:kind :invalid-protocol})))
    (when (and (some? (:generation d))
               (not (and (string? (:generation d)) (not (empty? (:generation d))))))
      (throw (ex-info "queue: :generation must be a nonempty string" {:kind :invalid-generation})))
    (cond-> {:of of
     :protocol (:protocol d 1)
     :generation (:generation d)
     :concurrency concurrency
     :lease lease
     :unique (vec unique)
     :partition (vec partition)
     :retry (normalise-retry (get d :retry))}
      (contains? d :admission) (assoc :admission (normalise-admission (:admission d)))
      (contains? d :dispatch) (assoc :dispatch (normalise-dispatch (:dispatch d))))))

(defn backoff-ms
  "Milliseconds to wait before the attempt AFTER `n` failures.

   Pure, so the retry lattice is a test rather than a sleep: `:exponential`
   doubles from `:base`, `:constant` never grows, both are capped by
   `:max-delay`, and `:jitter` (a fraction) spreads the result by ± that much —
   never below a millisecond, because a delay of zero is a busy loop wearing a
   policy's name."
  [retry n]
  (let [r (if (map? retry) (normalise-retry retry) retry)
        base (get r :base 1000)
        raw (if (= :constant (get r :backoff))
              base
              (erlang/round (* base (erlang/apply :math :pow (list 2 (- n 1))))))
        capped (min raw (get r :max-delay 60000))
        j (get r :jitter 0)]
    (if (or (nil? j) (not (> j 0)))
      capped
      (let [u (- (erlang/apply :rand :uniform (list)) 0.5)
            v (erlang/round (* capped (+ 1 (* 2 j u))))]
        (if (< v 1) 1 v)))))

;; ── the store ───────────────────────────────────────────────────────────
;;
;; ONE PUBLIC ETS TABLE PER QUEUE, held by a keeper with an heir, and a datom
;; connection over it. Per queue rather than one for the VM, because `:of`,
;; `:unique` and `:lease` are the DECLARATION's: two queues sharing a table
;; would share an identity they do not share a policy for, and a ticket one
;; queue computed would refuse the other's job.
;;
;; The pane needs no registry of its own: it reads the same table with the same
;; query language, and `(proc.queue/conn :larder)` is the whole door.

(def SCHEMA
  [{:db/ident :job/id :db/valueType :db.type/string :db/cardinality :db.cardinality/one
    :db/unique :db.unique/identity}
   {:db/ident :job/source-id :db/valueType :db.type/term :db/cardinality :db.cardinality/one}
   {:db/ident :job/enrollment :db/valueType :db.type/term :db/cardinality :db.cardinality/one
    :db/unique :db.unique/identity}
   {:db/ident :job/parent-id :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
   {:db/ident :job/protocol :db/valueType :db.type/long :db/cardinality :db.cardinality/one :db/index true}
   {:db/ident :job/required-generation :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
   {:db/ident :job/adoption :db/valueType :db.type/term :db/cardinality :db.cardinality/one}
   {:db/ident :job/adopted-payload :db/valueType :db.type/term :db/cardinality :db.cardinality/one}
   {:db/ident :job/generation :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
   {:db/ident :job/effects :db/valueType :db.type/term :db/cardinality :db.cardinality/one}
   {:db/ident :job/deferral :db/valueType :db.type/term :db/cardinality :db.cardinality/one}
   {:db/ident :job/retry-base :db/valueType :db.type/long :db/cardinality :db.cardinality/one}
   {:db/ident :queue/fenced-generations :db/valueType :db.type/term :db/cardinality :db.cardinality/one}
   {:db/ident :queue/fenced-through :db/valueType :db.type/long :db/cardinality :db.cardinality/one}
   {:db/ident :job/attempt-id :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
   {:db/ident :queue/fenced-protocols :db/valueType :db.type/term :db/cardinality :db.cardinality/one}
   {:db/ident :job/of :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}
   {:db/ident :job/server :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
   {:db/ident :job/state :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one
    :db/index true}
   {:db/ident :job/at :db/valueType :db.type/long :db/cardinality :db.cardinality/one
    :db/index true}
   {:db/ident :job/attempts :db/valueType :db.type/long :db/cardinality :db.cardinality/one}
   {:db/ident :job/enqueued-at :db/valueType :db.type/long :db/cardinality :db.cardinality/one}
   {:db/ident :job/lease-until :db/valueType :db.type/long :db/cardinality :db.cardinality/one}
   ;; the lease's OWNER TOKEN: a fresh value per claim, so the process that
   ;; finishes a job must still hold it. A reclaimed job has a new token, and
   ;; the old worker's outcome is refused rather than written over the new one.
   {:db/ident :job/owner :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
   ;; the Idempotency Key. UNIQUE, so a second enqueue of one payload cannot
   ;; make a second entity — and RETRACTED when the job settles, so the same
   ;; payload may be owed again once it is finished.
   {:db/ident :job/ticket :db/valueType :db.type/string :db/cardinality :db.cardinality/one
    :db/unique :db.unique/identity}
   {:db/ident :job/partition :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
   ;; the job's own facts, as ONE value. `:db.type/term` rather than one
   ;; attribute per payload key: the queue cannot know a caller's attributes, and
   ;; a schema it invented for them would make every job kind a schema change.
   {:db/ident :job/diagnostic-context :db/valueType :db.type/term :db/cardinality :db.cardinality/one}
   {:db/ident :job/payload :db/valueType :db.type/term :db/cardinality :db.cardinality/one}
   {:db/ident :job/result :db/valueType :db.type/term :db/cardinality :db.cardinality/one}
   {:db/ident :job/last-failure :db/valueType :db.type/term :db/cardinality :db.cardinality/one}
   {:db/ident :job/last-error :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
   {:db/ident :job/finished-at :db/valueType :db.type/long :db/cardinality :db.cardinality/one}
   {:db/ident :queue/key :db/valueType :db.type/string :db/cardinality :db.cardinality/one
    :db/unique :db.unique/identity}
   {:db/ident :queue/dispatch-cursor :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
   {:db/ident :queue/decl :db/valueType :db.type/term :db/cardinality :db.cardinality/one}
   {:db/ident :queue/identity-receipt :db/valueType :db.type/term :db/cardinality :db.cardinality/one}])

(defn logical-name [srv]
  (let [value (name (if (string? srv) (keyword srv) srv))]
    (if (String/starts_with? value "blq.")
      (let [parts (String/split value "__" (list (tuple :parts 2)))]
        (if (= 2 (count parts)) (last parts) value))
      value)))

(defn scoped-server
  "Pin a logical queue to an application identity. Explicit scoped identities
   remain usable outside a generation; the legacy unscoped spelling is unchanged."
  [application-id srv]
  (when-not (and (string? application-id)
                (Regex/match? #"^[a-z][a-z0-9.-]{0,63}$" application-id))
    (throw (ex-info "Invalid queue application identity" {:kind :invalid-application-id})))
  (keyword (str "blq." application-id "__" (logical-name srv))))

(defn resolve-server
  "Resolve once at a native registration boundary. Scoped identities never
   fall back to a global queue, and cannot cross a sealed application context.
   The reserved blq.<application>__ prefix keeps OTP/ETS identity unqualified."
  [srv]
  (let [value (name (if (string? srv) (keyword srv) srv))
        scoped? (and (String/starts_with? value "blq.") (= 2 (count (String/split value "__" (list (tuple :parts 2))))))
        application-id (:application-id (Process/get :bl_generation))]
    (when (and scoped? application-id
               (not= value (name (scoped-server application-id value))))
      (throw (ex-info "Queue belongs to a different application" {:kind :queue-application-mismatch})))
    (cond scoped? (keyword value) application-id (scoped-server application-id value)
          :else (keyword value))))

(defn server-name [srv] (name (resolve-server srv)))

(defn application-id [srv]
  (let [value (server-name srv) parts (String/split value "__" (list (tuple :parts 2)))]
    (when (and (String/starts_with? value "blq.") (= 2 (count parts)))
      (String/slice (first parts) 4 (String/length (first parts))))))

(defn store-name
  "The ETS table one queue owns. The name is a FUNCTION of the server's, because
   a name that has to be remembered is a name that is sometimes not found."
  [srv]
  (keyword (str "bl_queue_" (server-name srv))))

(defn ensure-store!
  "Make this queue's store exist, with an owner and an heir that outlive every
   claimer. Never creates the table itself — `proc.table` starts the process that
   does, and that indirection is the whole guarantee."
  [srv]
  (table/hold (store-name srv) {:type :ordered_set
                                :options [:public :named_table]}))

(defn- conn-key [srv] (tuple :bl-queue-conn (server-name srv)))

(defn conn
  "The connection over this queue's store, published once per VM.

   Not a cache of state: two connections over one store share a writer and a
   basis through datom's own registry, so a reader needs this only to NAME the
   basis it reads at. `:persistent_term` because the read is lock-free and
   answers the same value from every process — a pane that has never started a
   queue can still read it."
  [srv]
  (or (erlang/apply :persistent_term :get (list (conn-key srv) nil))
      (BeamLisp.Env/with_generation_lock (tuple :queue-store (server-name srv))
       (fn []
        (or (erlang/apply :persistent_term :get (list (conn-key srv) nil))
            (let [c (datom/connect-with (store-ets/adopt (ensure-store! srv)) SCHEMA)]
              (erlang/apply :persistent_term :put (list (conn-key srv) c))
              c))))))

(defn- closed-file-rebind? [srv old current opts]
  (let [old-path (:path (ds/identity-of (:store old)))
        current-path (:path (ds/identity-of (:store current)))]
    (and (:lifetime old) (= :closed @(:lifetime old))
         (string? old-path) (string? current-path)
         (or (= old-path current-path)
             (and (= old-path (:relocate-from opts))
                  (= #{[(server-name srv)]}
                     (datom/q '[:find ?key :where [_ :queue/key ?key]] (datom/db current)))))
         (nil? (Process/whereis (keyword "bl-queue" (server-name srv)))))))

(defn attach-store!
  "Bind a queue to an existing dedicated persistent Datom connection BEFORE its
   first use. The connection owner supplies opening/closing and single-writer
   authority. Default ETS queues survive process death, not VM death. Bind the
   same persistent store at boot to resume jobs across VM/deployment restarts.
   Refuse live replacement or sharing a store with a different queue. A closed
   connection may rebind only to the same canonical file store while its queue
   owner is dead; the old native lifetime fence prevents stale writer revival.
   Explicit {:relocate-from <canonical-old-path>} also permits an offline
   restored journal naming this same queue to move after that closed owner is
   dead. The operator must verify its backup before calling; this is not a
   cross-VM lease or a backup-integrity verifier. Default behavior is unchanged."
  ([srv c] (attach-store! srv c {}))
  ([srv c opts]
  (when-not (and (map? opts) (every? #{:relocate-from} (keys opts))
                (or (not (contains? opts :relocate-from)) (string? (:relocate-from opts))))
    (throw (ex-info "Invalid queue store relocation options" {:kind :invalid-store-relocation})))
  (BeamLisp.Env/with_generation_lock (tuple :queue-store (server-name srv))
   (fn []
    (let [existing (erlang/apply :persistent_term :get (list (conn-key srv) nil))]
    (when (and existing (not= existing c) (not (closed-file-rebind? srv existing c opts)))
      (throw (ex-info "Queue connection already bound" {:kind :store-already-bound :server srv})))
    (dc/serialized! c
      (fn []
        ;; Recheck inside the replacement writer, after any competing attach.
        (let [bound (erlang/apply :persistent_term :get (list (conn-key srv) nil))]
          (when (and bound (not= bound c) (not (closed-file-rebind? srv bound c opts)))
            (throw (ex-info "Queue connection already bound" {:kind :store-already-bound :server srv}))))
        (datom/install-schema! c SCHEMA)
        (when (some (fn [row] (not= (server-name srv) (first row)))
                    (datom/q '[:find ?key :where [_ :queue/key ?key]] (datom/db c)))
          (throw (ex-info "Queue requires its own connection/store" {:kind :shared-queue-store})))
        (datom/transact! c [{:db/id -1 :queue/key (server-name srv)}])
        (erlang/apply :persistent_term :put (list (conn-key srv) c))))
    c)))))

(defn- identity-token []
  (Base/encode16 (erlang/apply :crypto :strong_rand_bytes (list 24))))

(defn- sync-checkpoint!
  "Critical decisions require stable-storage sync before authorizing an external
   effect or code collection. Development memory fixtures report volatility."
  [c]
  (if (ds/durable? (:store c))
    (do (ds/sync! (:store c)) :stable) :volatile))

(defn- identity-refuse [kind]
  (throw (ex-info "Queue identity conversion refused" {:kind kind})))

(defn- raw-queue-binding [srv]
  ;; Deliberately bypass generation name resolution: legacy means EXACTLY legacy.
  (erlang/apply :persistent_term :get (list (tuple :bl-queue-conn srv) nil)))

(defn- identity-owner-stopped! [srv]
  (when (Process/whereis (keyword "bl-queue" srv))
    (identity-refuse :queue-owner-running)))

(defn- identity-authority! [c path]
  (when-not (and (= path (:path (ds/identity-of (:store c))))
                (ds/durable? (:store c)) (:lifetime c) (= :open @(:lifetime c)))
    (identity-refuse :queue-store-authority-required))
  (let [registered (dc/registered-at path)]
    (when-not (and (= (:lifetime registered) (:lifetime c))
                  (= (ds/identity-of (:store registered)) (ds/identity-of (:store c))))
      (identity-refuse :queue-store-authority-required))))

(defn- bounded-identity-column [db attr limit]
  (let [page (datom/attribute-page db attr nil (inc limit))]
    (when (or (:more? page) (> (count (:datoms page)) limit))
      (identity-refuse :queue-identity-inventory-too-large))
    (:datoms page)))

(defn- with-identity-authority [names action]
  ;; Same order as runtime start: restoration admission before store binding.
  (BeamLisp.Env/with_generation_lock (tuple :queue-restoration (first names))
   (fn []
    (BeamLisp.Env/with_generation_lock (tuple :queue-restoration (last names))
     (fn []
      (doseq [srv names]
        (when (erlang/apply :persistent_term :get (list (tuple :bl-queue-restoration srv) nil))
          (identity-refuse :restoration-already-bound)))
      (action))))))

(defn migrate-identity!
  "Explicit stopped-owner legacy -> application-scoped conversion of a dedicated
   durable queue. Caller closes the OLD registered connection, reopens the SAME
   canonical store, then passes that fresh connection and exact :store-path,
   :legacy-key, :application-id and :generation. :max-jobs defaults512, max1024.
   Old producer lifetimes stay closed; captured claims/attempts stay fenced.
   No retry, protocol adoption, owner start or product auto-conversion occurs.
   One bounded writer transaction preserves every fact except queue/job naming,
   records an exact idempotent receipt, then fsyncs before target registration.
   A sync error is uncertain: retry this same conversion to reconcile its receipt."
  [c opts]
  (let [legacy (:legacy-key opts) app (:application-id opts) generation (:generation opts)
        path (:store-path opts) limit (:max-jobs opts 512) context (Process/get :bl_generation)]
    (when-not (and (map? opts)
                  (every? #{:legacy-key :application-id :generation :store-path :max-jobs} (keys opts))
                  (string? legacy) (Regex/match? #"^[a-z][a-z0-9._-]{0,63}$" legacy)
                  (not (String/starts_with? legacy "blq."))
                  (string? generation) (Regex/match? #"^[a-f0-9]{64}$" generation)
                  (string? path) (<= (erlang/byte_size path) 1024)
                  (String/starts_with? path "/") (= path (Path/expand path))
                  (erlang/is_integer limit) (<= 1 limit 1024))
      (identity-refuse :invalid-queue-identity-conversion))
    (let [target (name (scoped-server app legacy))
          names (sort [legacy target])
          contract {:version 1 :from legacy :to target :application-id app
                    :generation generation :store path}
          migration-id (Base/encode16 (erlang/apply :crypto :hash
                         (list :sha256 (erlang/term_to_binary contract (list :deterministic)))))]
      (when (and context (or (not= app (:application-id context))
                             (not= generation (:digest context))))
        (identity-refuse :queue-generation-mismatch))
      (with-identity-authority names
       (fn []
        (BeamLisp.Env/with_generation_lock (tuple :queue-store (first names))
       (fn []
        (BeamLisp.Env/with_generation_lock (tuple :queue-store (last names))
         (fn []
          (identity-owner-stopped! legacy) (identity-owner-stopped! target)
          (identity-authority! c path)
          (let [bound (raw-queue-binding target)]
            (when (and bound (not= bound c)
                       (not (and (:lifetime bound) (= :closed @(:lifetime bound))
                                 (= path (:path (ds/identity-of (:store bound)))))))
              (identity-refuse :store-already-bound)))
          (dc/serialized! c
           (fn []
            (identity-authority! c path)
            (identity-owner-stopped! legacy) (identity-owner-stopped! target)
            (when-let [old (raw-queue-binding legacy)]
              (when-not (and (:lifetime old) (= :closed @(:lifetime old))
                             (= path (:path (ds/identity-of (:store old)))))
                (identity-refuse :legacy-queue-lifetime-open)))
            (let [db (datom/db c)
                  rows (bounded-identity-column db :queue/key 2)
                  row (when (= 1 (count rows)) (datom/entity db (datom/datom-e (first rows))))
                  receipt (:queue/identity-receipt row)]
              (when-not row (identity-refuse :shared-queue-store))
              (if (= target (:queue/key row))
                (when-not (and receipt (= contract (select-keys receipt (keys contract)))
                              (= (set (keys receipt)) (into (set (keys contract)) [:migration-id :jobs :basis-before]))
                              (erlang/is_integer (:jobs receipt)) (<= 0 (:jobs receipt) 1024)
                              (erlang/is_integer (:basis-before receipt))
                              (= migration-id (:migration-id receipt))
                              (or (raw-queue-binding legacy) (= c (raw-queue-binding target))))
                  (identity-refuse :queue-identity-receipt-mismatch))
                (do
                  (when-not (= legacy (:queue/key row)) (identity-refuse :shared-queue-store))
                  ;; A string naming a file is not migration authority. The exact
                  ;; old queue registration must still prove its CLOSED lifetime.
                  (let [old (raw-queue-binding legacy)]
                    (when-not (and old (:lifetime old) (= :closed @(:lifetime old))
                                   (= path (:path (ds/identity-of (:store old)))))
                      (identity-refuse :legacy-queue-lifetime-open)))
                  (when receipt (identity-refuse :queue-identity-receipt-mismatch))
                  (let [allowed (into (set (keys schema/BUILT-IN)) (map :db/ident SCHEMA))]
                    (when-not (every? allowed (keys @(:schema c)))
                      (identity-refuse :shared-queue-store)))
                  (let [servers (bounded-identity-column db :job/server limit)
                        states (bounded-identity-column db :job/state limit)
                        ids (bounded-identity-column db :job/id limit)
                        entities (set (map datom/datom-e servers))
                        declaration (:queue/decl row)]
                    (when-not (and (every? #(= legacy (datom/datom-v %)) servers)
                                   (= entities (set (map datom/datom-e states)))
                                   (= entities (set (map datom/datom-e ids)))
                                   (or (nil? declaration) (and (map? declaration)
                                     (= legacy (:server declaration))
                                     (<= (erlang/byte_size (erlang/term_to_binary declaration)) 16384))))
                      (identity-refuse :shared-queue-store))
                    ;; All expected refusals precede even the optional schema add.
                    (let [accepted (assoc contract :migration-id migration-id
                                          :jobs (count entities) :basis-before (datom/basis-t db))
                          tx (into [[:db/add (:db/id row) :queue/key target]
                                    [:db/add (:db/id row) :queue/identity-receipt accepted]]
                               (map (fn [e] [:db/add e :job/server target]) entities))]
                      (when (> (erlang/byte_size (erlang/term_to_binary accepted)) 4096)
                        (identity-refuse :queue-identity-receipt-too-large))
                      (datom/install-schema! c SCHEMA)
                      (datom/transact! c (if declaration
                         (conj tx [:db/add (:db/id row) :queue/decl (assoc declaration :server target)]) tx))))))
              (let [accepted (:queue/identity-receipt
                               (datom/entity (datom/db c) (:db/id row)))]
                (sync-checkpoint! c)
                ;; Parent holds both registration locks. Calling attach-store!
                ;; here would acquire them from the different writer PID.
                (erlang/apply :persistent_term :put (list (tuple :bl-queue-conn target) c))
                (when-let [old (raw-queue-binding legacy)]
                  (erlang/apply :persistent_term :put
                    (list (tuple :bl-queue-conn legacy) (assoc old :queue/retired-identity accepted))))
                (assoc accepted :durability :stable))))))))))))))

(defn- retired-identity-binding? [srv bound]
  ;; A closed lifetime alone is not proof that durable work moved. Only the
  ;; exact fsynced conversion receipt plus its still-bound target removes an
  ;; obsolete alias from inventory; the target remains independently checked.
  (let [receipt (:queue/retired-identity bound) target (raw-queue-binding (:to receipt))]
    (and receipt (:lifetime bound) (= :closed @(:lifetime bound))
         (= 1 (:version receipt)) (= srv (:from receipt))
         (= (:store receipt) (:path (ds/identity-of (:store bound))))
         target (= (:store receipt) (:path (ds/identity-of (:store target)))))))

(defn- fenced-protocols [c srv]
  (:queue/fenced-protocols (datom/pull (datom/db c) '[*] [:queue/key (server-name srv)]) #{}))

(defn- protocol-fenced? [row protocol]
  (or (contains? (:queue/fenced-protocols row #{}) protocol)
      (<= protocol (:queue/fenced-through row 0))))

(defn fence-protocol!
  "Durably close admissions for a protocol. Existing jobs remain readable and
   executable. This fence is monotone and survives declaration updates/restarts."
  [srv protocol]
  (when-not (positive-int? protocol)
    (throw (ex-info "Invalid protocol fence" {:kind :invalid-protocol})))
  (let [c (conn srv)]
    (dc/serialized! c
      (fn []
        (datom/transact! c [{:db/id -1 :queue/key (server-name srv)
          :queue/fenced-protocols (conj (fenced-protocols c srv) protocol)}])
        {:status :fenced :protocol protocol :durability (sync-checkpoint! c)}))))

(defn fence-through!
  "Close the complete protocol prefix through version in one durable writer
   turn. Bounds are numeric; a version jump does not allocate a giant set."
  [srv version]
  (when-not (positive-int? version)
    (throw (ex-info "Invalid protocol fence" {:kind :invalid-protocol})))
  (let [c (conn srv)]
    (dc/serialized! c
      (fn []
        (let [row (datom/pull (datom/db c) '[*] [:queue/key (server-name srv)])]
          (datom/transact! c [{:db/id -1 :queue/key (server-name srv)
            :queue/fenced-through (max version (:queue/fenced-through row 0))}])
          {:status :fenced :through version :durability (sync-checkpoint! c)})))))

(defn fence-generation!
  "Monotone durable producer admission fence for one exact generation. Same
   payload protocol in a newer generation remains admissible. Accepted old work
   may finish or be explicitly adopted; closure is not proof it has drained."
  [srv digest]
  (when-not (and (string? digest) (not (empty? digest)))
    (throw (ex-info "Generation fence requires a nonempty identity" {:kind :invalid-generation})))
  (let [c (conn srv)]
    (dc/serialized! c
      (fn []
        (let [row (datom/pull (datom/db c) '[*] [:queue/key (server-name srv)])]
          (datom/transact! c [{:db/id -1 :queue/key (server-name srv)
            :queue/fenced-generations (conj (:queue/fenced-generations row #{}) digest)}])
          {:status :fenced :generation digest :durability (sync-checkpoint! c)})))))

(declare effect-pending?)
(defn protocol-inventory
  "Read retained protocol and generation dependencies from ONE snapshot.
   Failed/held/unknown jobs and incomplete provider effects remain dependencies.
   :generations retains producer provenance; :required-generations describes
   dispatch requirements after explicitly receipted adoption. Legacy protocol 1
   jobs without a generation are counted under :unversioned-generations."
  [srv]
  (let [c (conn srv) db (datom/db c)
        row (datom/pull db '[*] [:queue/key (server-name srv)])
        live (remove (fn [r] (contains? #{:done :cancelled} (second r)))
                     (datom/q '[:find ?e ?s :where [?e :job/state ?s]] db))
        ;; Do not pull every historical completed job. Only terminal rows with
        ;; checkpoints can retain a provider dependency; query that sparse fact.
        terminal-effects (filter (fn [r]
                             (and (contains? #{:done :cancelled} (second r))
                                  (effect-pending? {:job/effects (nth r 2)})))
                           (datom/q '[:find ?e ?s ?effects
                                      :where [?e :job/effects ?effects]
                                             [?e :job/state ?s]] db))
        jobs (map (fn [r] (datom/entity db (first r))) (concat live terminal-effects))
        bump (fn [m key] (update m key (fn [n] (inc (or n 0)))))
        counted (reduce (fn [m j]
                   (let [original (:job/generation j)
                         required (:job/required-generation j original)]
                     (cond-> (-> m
                                   (update :protocols (fn [p] (bump p (get-in j [:job/adoption :protocol] (:job/protocol j 1)))))
                                   (update :producer-protocols (fn [p] (bump p (:job/protocol j 1)))))
                       original (update :generations (fn [g] (bump g original)))
                       required (update :required-generations (fn [g] (bump g required)))
                       (nil? original) (update :unversioned-generations inc))))
                  {:protocols {} :producer-protocols {} :generations {} :required-generations {} :unversioned-generations 0} jobs)]
    (assoc counted :fenced (vec (sort (:queue/fenced-protocols row #{})))
                   :fenced-generations (vec (sort (:queue/fenced-generations row #{})))
                   :fenced-through (:queue/fenced-through row 0))))

(defn generation-inventory [srv]
 (select-keys (protocol-inventory srv) [:generations :required-generations :unversioned-generations :fenced-generations]))

(declare declaration)
(defn registered-queues
  "Discover existing native queue connection registrations. No process or
   duplicate catalogue is authoritative. Undeclared read-only registrations
   are omitted. Failed reads remain explicit blockers for release inventory."
  []
  (vec (keep (fn [entry]
         (let [key (elem entry 0)]
           (when (and (erlang/is_tuple key) (= 2 (erlang/tuple_size key))
                      (= :bl-queue-conn (elem key 0))
                      (not (retired-identity-binding? (elem key 1) (elem entry 1))))
             (let [srv (keyword (elem key 1))
                   app (:application-id (Process/get :bl_generation))
                   scoped (when app (name (scoped-server app (logical-name srv))))]
              (when (or (nil? app) (= scoped (elem key 1)))
               (try
                 (when-let [d (declaration srv)]
                   {:server srv :logical-server (keyword (logical-name srv)) :application-id (application-id srv)
                    :declaration d :inventory (protocol-inventory srv)
                    :store (let [store (ds/identity-of (:store (conn srv)))]
                             (if (:path store) {:kind :file :identity (:path store)}
                               {:kind :memory :identity (server-name srv)}))})
                 (catch _ {:server srv :status :unavailable})))))))
        (erlang/apply :persistent_term :get (list)))))

(defn declarations
  "Read native queue producer contracts for sealed release inventory. A failed
   store read is explicit :unavailable; never treated as an empty dependency."
  []
  (into {} (map (fn [row]
           [(server-name (:server row))
            (if (= :unavailable (:status row)) {:status :unavailable}
              {:protocol (get-in row [:declaration :protocol] 1)
               :generation (get-in row [:declaration :generation])
               :store (:store row) :inventory (:inventory row)})])
         (registered-queues))))

(defn store-live?
  "Whether this queue's store exists right now. Public for the same reason
   `proc.table/owner` is: a test and a pane both want to ask."
  [srv]
  (if-let [c (erlang/apply :persistent_term :get (list (conn-key srv) nil))]
    (ds/alive? (:store c)) (table/live? (store-name srv))))

(defn store-owner
  "The pid that owns this queue's store, or nil. The invariant, readable."
  [srv]
  (table/owner (store-name srv)))

(declare validate-declaration!)

(defn- write-decl!
  "Publish the declaration as a FACT. Upserted by `:queue/key`, so a boot is one
   transaction and re-booting is the same one.

   Why the store holds it at all: `enqueue!` is a store write that must apply the
   queue's OWN rules (`:of`, `:unique`, `:partition`) without asking a process,
   and a rule a caller has to restate at every call site is a rule that drifts."
  [c srv d]
  (dc/serialized! c (fn []
    (validate-declaration! c srv d)
    (datom/transact! c [{:db/id -1
                       :queue/key (server-name srv)
                       :queue/decl (assoc d :server (server-name srv))}]))))

(defn declaration
  "The durable declaration this queue wrote at boot, or nil when this VM's store
   has never seen a `(queue …)` for `srv`."
  [srv]
  (let [m (datom/pull (datom/db (conn srv)) '[*] [:queue/key (server-name srv)])]
    (:queue/decl m)))

;; ── reaching a live queue ───────────────────────────────────────────────
;;
;; The name is DERIVED from the declaration (`larder` → `:bl-queue/larder`), the
;; same trick `proc.sched` uses: a deterministic name is a handle that survives a
;; restart, and it is registered by the process that will answer to it — its own
;; init — never by whoever wants to call. The clause does NOT also ask to be
;; started under a `{:name …}`: one process, one name it owns (FUP-105).

(defn op-name [srv] (keyword "bl-queue" (server-name srv)))

(defn- error-text
  [e]
  (let [m (if (map? e) (get e :message) nil)]
    (if (nil? m) (str e) (str m))))

(defn serving?
  "Whether a queue is RUNNING for `srv` right now. Named `serving?` rather than
   `live?` so it cannot collide with `proc.table/live?` in the umbrella."
  [srv]
  (some? (Process/whereis (op-name srv))))

(defn announce!
  "Register this process under its declaration's name, from its OWN init.

   A collision is REFUSED, loudly: two queues for one declaration would claim
   the same jobs from the same store under the same leases, and the second one is
   not inconvenient, it is a second claimant of one job. The check is against a
   LIVE pid only — the VM frees a name when its process dies, so a predecessor
   that has properly stopped never blocks its successor.

   `{:name …}` on the start call is deliberately NOT how this is done; the whole
   point is that one process registers one name, and it is the process itself.
   (The register is still guarded, because a name lookup and a name claim are
   not one operation.)"
  [srv]
  (let [nm (op-name srv)
        holder (Process/whereis nm)]
    (when (some? holder)
      (throw (ex-info (str "proc.queue: a queue for " srv " is already running ("
                           holder "). Two would claim the same jobs from the same"
                           " store under the same leases.")
                      {:server srv :name nm :holder holder})))
    (try
      (erlang/register nm (erlang/self))
      (catch e
        (throw (ex-info (str "proc.queue: the name " nm " for " srv " is taken ("
                             (Process/whereis nm) ") — the register refused it;"
                             " the holder above is what the VM reported afterwards.")
                        {:server srv :name nm :holder (Process/whereis nm)
                         :why (error-text e)}))))
    nm))

;; ── the job's shape, and the two derived keys ───────────────────────────

(defn- validate-payload!
  "Refuse a job the declaration cannot act on. Every `:unique` and `:partition`
   key must be PRESENT: a rule whose key is missing matches `nil` on every job
   and therefore does nothing at all, which is the worst kind of configuration
   bug (docs/dev/env.bl.md). Keys in the `job` namespace are refused too — the
   payload is the caller's, and a caller who writes `:job/state` is editing the
   queue's bookkeeping by accident."
  [d job]
  (when-not (and (map? job) (seq job))
    (throw (ex-info "queue: a job must be a non-empty map — the facts perform will act on"
                    {:job job})))
  (doseq [k (keys job)]
    (when-not (keyword? k)
      (throw (ex-info (str "queue: every job key must be a keyword, got " (str k))
                      {:key k :job job})))
    (when (= "job" (namespace k))
      (throw (ex-info (str "queue: " k " is the queue's own namespace — a job's payload"
                           " may not write it")
                      {:key k :job job}))))
  (doseq [k (concat (:unique d) (:partition d))]
    (when (nil? (get job k))
      (throw (ex-info (str "queue: the declaration names " k " as :unique/:partition and"
                           " this job does not carry it — the rule would be a silent"
                           " no-op")
                      {:key k :job job :decl d})))))

(defn- ticket-for
  "The Idempotency Key for one job: the `:unique` values, plus the kind, as one
   string. `pr-str` per value rather than `str`, so `:a` and `\"a\"` are two
   facts and not one."
  [d job]
  (let [u (:unique d)]
    (when (seq u)
      (str (name (:of d))
           (join "" (map (fn [k] (str "|" (name k) "=" (pr-str (get job k)))) u))))))

(defn- partition-key
  "The `:partition` values of one job as one string, or nil. Per-key
   serialisation: two jobs with the SAME string never run at once."
  [d job]
  (let [p (:partition d)]
    (when (seq p)
      (join "|" (map (fn [k] (str (name k) "=" (pr-str (get job k)))) p)))))

(defn- due-at
  "When the job is owed, from `:in` / `:at` / neither.

   `:in [N UNIT]` follows the shape a project file's declarations already use
   (`:every [30 :min]`), so a duration is one value with its unit rather than two
   keys that can disagree. The clock here is the WALL clock: an enqueue may come
   from a process that has no queue and no injected clock, and `:at` is available
   to anyone who needs a number they chose."
  [now opts]
  (let [at (get opts :at)
        in (get opts :in)]
    (cond
      (and (some? at) (some? in))
        (throw (ex-info "queue: :in and :at are two ways to say when — give one"
                        {:opts opts}))
      (some? at) (if (erlang/is_integer at)
                   at
                   (throw (ex-info (str "queue: :at is epoch milliseconds — got " (str at))
                                   {:at at})))
      (some? in)
        (do
          (when-not (and (vector? in) (= 2 (count in)))
            (throw (ex-info "queue: :in takes [N UNIT] — as in {:in [30 :minutes]}"
                            {:in in})))
          (+ now (tick/unit-ms (first in) (second in))))
      :else now)))

;; ── enqueue: a transaction, never a send ────────────────────────────────

(defn- find-by-ticket [c ticket]
  (datom/pull (datom/db c) '[*] [:job/ticket ticket]))

(defn- admission-scope [payload keys]
  (let [value (mapv #(get payload %) keys)]
    (when-not (and (every? some? value)
                  (<= (erlang/byte_size (erlang/term_to_binary value)) 4096))
      (throw (ex-info "Admission scope is missing or oversized" {:kind :invalid-admission-payload})))
    value))

(defn- admission-jobs [database srv]
  (filter #(contains? #{:queued :running :held} (:job/state %))
   (mapv (fn [[e]] (datom/entity database e))
    (datom/q '[:find ?e :in $ ?server :where [?e :job/server ?server]
                 [?e :job/state ?state]]
      database (server-name srv)))))

(defn- require-capacity! [database srv policy payload except-id]
  (when policy
    (let [jobs (filter #(not= except-id (:db/id %)) (admission-jobs database srv))
          scopes (:scopes policy)
          ;; Validate both new and outstanding legacy work before counting. A
          ;; policy cannot silently put unknown legacy scopes outside its cap.
          target (mapv #(admission-scope payload (:keys %)) scopes)
          values (mapv (fn [job] (mapv #(admission-scope (:job/payload job) (:keys %)) scopes)) jobs)
          full? (or (>= (count jobs) (:max-outstanding policy))
                    (some true? (map (fn [scope value index]
                      (>= (count (filter #(= value (nth % index)) values)) (:max scope)))
                        scopes target (range (count scopes)))))]
      (when full?
        (throw (ex-info "Native queue admission is full; original domain work remains owed"
                        {:kind :queue-capacity :state :deferred :reason :queue-capacity}))))))

(defn- dispatch-group [policy payload]
  (Base/encode16 (erlang/term_to_binary (admission-scope payload (:group policy)))))

(defn- require-dispatch-room! [database srv policy payload]
  (when policy
    (let [groups (set (map #(dispatch-group policy (:job/payload %)) (admission-jobs database srv)))
          group (dispatch-group policy payload)]
      (when (and (not (contains? groups group)) (>= (count groups) (:max-groups policy)))
        (throw (ex-info "Native dispatch group budget is full"
                        {:kind :queue-capacity :state :deferred :reason :dispatch-groups}))))))

(defn dispatch-candidates
  "Current due native facts in durable round-robin order. Busy partitions and
   excluded unpreparable rows are caller-owned claim restrictions, never a
   second scheduling store. Queue writer rechecks this order at actual claim."
  [database srv now policy busy excluded]
  (let [rows (filter (fn [job]
                (and (not (contains? excluded (:db/id job)))
                     (or (nil? (:job/partition job)) (not (contains? busy (:job/partition job))))
                     (or (and (= :queued (:job/state job)) (<= (:job/at job) now))
                         (and (= :running (:job/state job)) (<= (:job/lease-until job 0) now)))))
              (admission-jobs database srv))
        cursor (:queue/dispatch-cursor (datom/entity database [:queue/key (server-name srv)]))
        groups (sort (distinct (map #(dispatch-group policy (:job/payload %)) rows)))
        rotated (concat (filter #(or (nil? cursor) (> (compare % cursor) 0)) groups)
                        (filter #(and cursor (<= (compare % cursor) 0)) groups))
        rank (into {} (map (fn [group index] [group index]) rotated (range (count rotated))))]
    (vec (sort-by (fn [job] [(get rank (dispatch-group policy (:job/payload job)))
                             (:job/at job) (:job/id job)]) rows))))

(defn validate-declaration!
  "Validate configured native scope identities against all outstanding work
   inside the caller's queue writer. Lower limits retain existing obligations;
   they only refuse additional admissions. Invalid legacy scope data refuses
   activation before the declaration is installed. No history is rewritten."
  [c srv declared]
  (let [jobs (admission-jobs (datom/db c) srv)]
    (doseq [job jobs]
      (doseq [scope (get-in declared [:admission :scopes] [])]
        (admission-scope (:job/payload job) (:keys scope)))
      (when (:dispatch declared) (dispatch-group (:dispatch declared) (:job/payload job))))
    :valid))

(defn enqueue!
  "Put a job ON the queue — a TRANSACTION against the queue's store, never a
   message, so the job is a FACT before anything could act on it and a restart
   cannot lose it. Returns the job, as a map of its stored facts (`:db/id`
   included).

   Options: `{:at <epoch-ms>}` for an absolute due, `{:in [N UNIT]}` for a
   delay; neither means NOW. Optional `:enrollment-key` identifies one durable
   enrollment across settlement/restart while its job record is retained. It
   is scoped by server and refuses a different payload/protocol. Unlike the
   outstanding-job ticket, settlement never retracts this identity. Explicit
   pruning of the job ends its retention; provider/domain journals must still
   guard effects independently.

   A DUPLICATE INSIDE THE WINDOW IS A NO-OP RETURNING THE EXISTING JOB. The
   window is the job's own life as an OUTSTANDING job — `:queued` or
   `:running`: `:unique` names this queue's Idempotency Key, the key is asserted
   with the job, and a second enqueue of the same key is refused by the store
   (its `:db.unique/identity`) rather than by a key table this file would have to
   keep in step. The returned map is the EXISTING job with `:job/created false`;
   a job that was created says `:job/created true`.

   The window CLOSES when the job settles: `:done` and `:failed` retract the
   ticket, so a payload that was owed, ran, and finished may be enqueued again —
   and does make a new job.

   The queue must have STARTED once in this VM (its init writes the declaration
   into the store, and a store that was never written has no declaration to
   apply). A queue whose process is merely down still accepts work: the store
   outlives the process, which is the entire point."
  ([srv job] (enqueue! srv job {}))
  ([srv job opts]
   (let [opts (or opts {})]
     (doseq [k (keys opts)]
       (when-not (known? k KNOWN-ENQUEUE-OPTS)
         (throw (ex-info (str "queue: unknown enqueue option " k " — known: "
                              (join " " (map (fn [x] (str x)) KNOWN-ENQUEUE-OPTS)))
                         {:option k :opts opts}))))
     (let [c (conn srv)
           d (declaration srv)
           context (Process/get :bl_generation)]
       (when (nil? d)
         (throw (ex-info (str "queue: no declaration for \"" (server-name srv) "\" in the"
                              " store — start the queue once before enqueueing into"
                              " it")
                         {:server srv})))
       (validate-payload! d job)
       (dc/serialized! c (fn []
       (let [sealed? (and (map? context) (:digest context))
             producer (or (get (:protocols context) (logical-name srv))
                          (get (:protocols context) (keyword (logical-name srv))))
             producer-version (if (map? producer) (:protocol producer) producer)
             _ (when (and sealed? (nil? producer-version))
                 (throw (ex-info "Sealed generation has no queue producer contract"
                                 {:kind :undeclared-queue-protocol :server srv})))
             _ (when (and sealed? (:generation opts) (not= (:digest context) (:generation opts)))
                 (throw (ex-info "Queue generation override conflicts with executing generation"
                                 {:kind :generation-conflict :server srv})))
             protocol (:protocol opts (or producer-version (:protocol d 1)))
             generation (:generation opts (or (:digest context) (:generation d)))
             _ (when-not (positive-int? protocol)
                 (throw (ex-info "Invalid enqueue protocol" {:kind :invalid-protocol})))
             _ (when (and generation (not (and (string? generation) (not (empty? generation)))))
                 (throw (ex-info "Invalid enqueue generation" {:kind :invalid-generation})))
             admissions (datom/pull (datom/db c) '[*] [:queue/key (server-name srv)])
             _ (when (protocol-fenced? admissions protocol)
                 (throw (ex-info "Queue protocol admissions are fenced" {:kind :protocol-fenced :protocol protocol})))
             _ (when (and generation (contains? (:queue/fenced-generations admissions #{}) generation))
                 (throw (ex-info "Queue generation admissions are fenced"
                                 {:kind :generation-fenced :generation generation})))
             enrollment (when (contains? opts :enrollment-key)
                          (let [key (:enrollment-key opts)]
                            (when (or (nil? key) (> (erlang/byte_size (erlang/term_to_binary key)) 4096))
                              (throw (ex-info "Enrollment key must be nonnil and bounded" {:kind :invalid-enrollment-key})))
                            [(server-name srv) key]))
             existing (when enrollment (datom/entity (datom/db c) [:job/enrollment enrollment]))
             id (identity-token)
             now (tick/wall-ms)
             at (due-at now opts)
             ticket (ticket-for d job)
             pk (partition-key d job)
             row (merge {:db/id -1
                         :job/id id
                         :job/source-id (:source-id opts (or ticket id))
                         :job/protocol protocol
                         :job/of (:of d)
                         :job/server (server-name srv)
                         :job/state :queued
                         :job/at at
                         :job/enqueued-at now
                         :job/attempts 0
                         :job/payload job
                         :job/diagnostic-context (merge (diag/context) {:diagnostics/job-id (diag/new-id)})}
                        (if enrollment {:job/enrollment enrollment} {})
                        (if generation {:job/generation generation :job/required-generation generation} {})
                        (if (:parent-id opts) {:job/parent-id (:parent-id opts)} {})
                        (if (some? ticket) {:job/ticket ticket} {})
                        (if (some? pk) {:job/partition pk} {}))
             ;; The row ASSERTS the ticket (so the tempid UPSERTS onto a job that
             ;; already holds it) and the CAS REFUSES that upsert — which is the
             ;; difference between "one job, quietly overwritten" and "no-op".
             tx (if (some? ticket)
                  [row [:db/cas -1 :job/ticket nil ticket]]
                  [row])]
         (if existing
           (do
             (when-not (and (= job (:job/payload existing)) (= protocol (:job/protocol existing)))
               (throw (ex-info "Enrollment identity already names a different payload or protocol"
                        {:kind :enrollment-conflict :server srv})))
             (assoc existing :job/created false))
         (let [old (when ticket (find-by-ticket c ticket))]
          (when (and old enrollment (not= enrollment (:job/enrollment old)))
            (throw (ex-info "Outstanding ticket belongs to a different enrollment"
                           {:kind :enrollment-conflict :server srv})))
          (if old
            (assoc old :job/created false)
            (do
             (require-capacity! (datom/db c) srv (:admission (declaration srv)) job nil)
             (require-dispatch-room! (datom/db c) srv (:dispatch (declaration srv)) job)
         (try
           (let [report (datom/transact! c tx)
                 e (get (:tempids report) -1)]
             (assoc (datom/entity (datom/db c) e) :job/created true))
           (catch err
             (if (and (some? ticket)
                      (includes? (error-text err) "compare-and-swap"))
               (let [j (find-by-ticket c ticket)]
                 (if (some? j)
                   (do (when (and enrollment (not= enrollment (:job/enrollment j)))
                         (throw (ex-info "Outstanding ticket belongs to a different enrollment"
                                  {:kind :enrollment-conflict :server srv})))
                       (assoc j :job/created false)) (throw err)))
               (throw err)))))))))))))))

(defn try-enqueue!
  "Native writer-atomic capacity admission. Duplicate retained enrollment or
   ticket resolves before capacity. Only a full configured budget returns
   :deferred; invalid scope/protocol/generation and conflicts still throw.
   Caller retains its original owed domain identity and retries enrollment on
   native capacity release; this creates no separate backlog or ledger."
  ([srv payload] (try-enqueue! srv payload {}))
  ([srv payload opts]
   (try
     (let [job (enqueue! srv payload opts)]
       {:status (if (:job/created job) :admitted :existing) :job job})
     (catch e
       (if (= :queue-capacity (:kind (ex-data e)))
         {:status :deferred :reason :queue-capacity}
         (throw e))))))

;; ── stats: a query, not a counter ───────────────────────────────────────

(defn- job-rows
  "Every job, as `[entity state at]`. A query, so the loop, the pane and the
   verifier read the SAME facts — the table is public and neither of them needs
   the process to have run."
  [d]
  (datom/q '[:find ?e ?s ?at :where [?e :job/state ?s] [?e :job/at ?at]] d))

(defn stats
  "Counts by status, as a QUERY over the store.

   No process is asked, so the answer is the same whether the queue is running,
   stopped, or was never started in this VM (an empty store answers zeros), and a
   dashboard cannot be made slow by the work it reports. `:overdue` counts jobs
   that are `:running` under an expired lease — the rows a Lifeline wake is about
   to reclaim, and the ones an operator wants to see BEFORE it happens."
  ([srv] (stats srv (tick/wall-ms)))
  ([srv now]
  (when-not (erlang/is_integer now)
    (throw (ex-info "Queue stats needs an explicit millisecond instant" {:kind :invalid-clock})))
  (let [d (datom/db (conn srv))
        rows (job-rows d)
        of (fn [st] (count (filter (fn [r] (= st (second r))) rows)))
        running (filter (fn [r] (= :running (second r))) rows)
        overdue (count (filter (fn [r]
                                 (let [j (datom/entity d (first r))
                                       lease (:job/lease-until j)]
                                   (or (nil? lease) (<= lease now))))
                               running))]
    {:queued (of :queued)
     :running (of :running)
     :done (of :done)
     :held (of :held)
     :failed (of :failed)
     :cancelled (of :cancelled)
     :overdue overdue
     :total (count rows)})))

;; ── the claim: ONE guarded transaction ──────────────────────────────────

(defn- claim-tx
  "The transaction that takes `job`, or nil when it is not claimable now.

   The CAS is the guard, and there are two of them because there are two ways to
   take a job: a `:queued` one (`:state` still `:queued`?) and an ORPHANED one —
   `:running` under a lease that has run out, where the only value that can tell
   two claimants apart is the lease itself (a CAS whose old equals its new would
   let both through)."
  [job now lease-ms token]
  (let [e (:db/id job)
        s (:job/state job)
        lease (:job/lease-until job)
        attempts (get job :job/attempts 0)]
    (cond
      (= s :queued)
        [[:db/cas e :job/state :queued :running]
         [:db/cas e :job/attempts (:job/attempts job) (inc attempts)]
         [:db/add e :job/lease-until (+ now lease-ms)]
         [:db/add e :job/owner token]
         [:db/add e :job/attempt-id token]
         [:db/add e :job/attempts (inc attempts)]]
      (and (= s :running) (or (nil? lease) (<= lease now)))
        [[:db/cas e :job/state :running :running]
         [:db/cas e :job/owner (:job/owner job) token]
         [:db/cas e :job/lease-until lease (+ now lease-ms)]
         [:db/add e :job/attempt-id token]
         [:db/add e :job/owner token]
         [:db/add e :job/attempts (inc attempts)]]
      :else nil)))

(defn- lose-race?
  "Whether a refusal is the OTHER claimer winning. A compare-and-swap that does
   not match throws, and everything else must stay loud: swallowing a schema
   violation as 'lost the race' would hide a broken queue behind a busy one."
  [e]
  (includes? (error-text e) "compare-and-swap"))

(defn claim!
  "Take ONE job: mark it `:running`, lease it, and record the attempt — in ONE
   transaction, so two claims cannot both take it. Returns the claimed job, or
   nil when the world moved underneath the caller.

   The caller passes the job it READ (the CAS is against that value, which is
   what makes the read-modify-write safe without a lock); a live lease is
   refused here as well as in the candidate scan, so a claim cannot steal a job
   a live worker holds merely by asking.

   Public because it is the whole of Claim/Lease and a verifier should be able
   to exercise it without a running queue."
  ([c job now lease-ms] (claim! c job now lease-ms {}))
  ([c job now lease-ms opts]
  (let [e (:db/id job)
        ;; A cryptographic token remains distinct across VM restarts; clocks and
        ;; monotonic counters alone can collide with persisted old owners.
        token (identity-token)
        base (claim-tx job now lease-ms token)
        id (or (:job/id job) (identity-token))
        tx (when base (vec (concat base
             (if (:job/id job) [] [[:db/add e :job/id id]])
             (if (:job/source-id job) [] [[:db/add e :job/source-id (or (:job/ticket job) id)]])
             (if (:job/protocol job) [] [[:db/add e :job/protocol 1]]))))]
    (when (some? tx)
      (dc/serialized! c
        (fn []
          ;; Preparation ran before this writer turn. An adoption must not slip
          ;; between prepared payload and claim, including A -> B -> A receipts.
          (let [current (datom/entity (datom/db c) e)
                fields [:job/server :job/required-generation :job/adoption :job/adopted-payload]]
            (when (and (= (select-keys current fields) (select-keys job fields))
                       (or (nil? (:dispatch opts))
                           (and (= (:dispatch opts) (:dispatch (declaration (:server opts))))
                           (= e (:db/id (first (dispatch-candidates (datom/db c) (:server opts) now
                                  (:dispatch opts) (:busy opts #{}) (:excluded opts #{}))))))))
              (try
                (datom/transact! c (if (:dispatch opts)
                   (conj tx {:db/id -9 :queue/key (server-name (:server opts))
                              :queue/dispatch-cursor (dispatch-group (:dispatch opts) (:job/payload current))}) tx))
                (datom/entity (datom/db c) e)
                (catch err
                  (if (lose-race? err) nil (throw err))))))))))))

(defn- owns-attempt? [job claimed now]
  (and job (= :running (:job/state job))
       (= (:job/server claimed) (:job/server job))
       (= (:job/owner claimed) (:job/owner job))
       (= (:job/attempt-id claimed) (:job/attempt-id job))
       (some? (:job/owner claimed)) (> (:job/lease-until job 0) now)))

(defn- attempt-clock [srv]
  ;; Claims and checkpoints share the queue worker's supplied clock. A virtual
  ;; epoch is neither a perpetually expired past lease nor a permanent future
  ;; lease. Manually claimed callers retain the historical wall-clock default.
  ;; Capture the function before entering a Datom writer's different process;
  ;; evaluate it inside that writer so lease validity uses the commit instant.
  (or (Process/get (tuple :bl-queue/attempt-clock (server-name srv))) tick/wall-ms))

(defn commit-attempt!
  "Publish database effects only while this claimed attempt still owns its
   unexpired lease. Executes in the QUEUE store's writer; tx must target this
   same connection. External effects need their own provider idempotency and
   uncertain-outcome reconciliation. This reports a journal commit, not fsync;
   critical provider checkpoints use explicit sync. Returns a refusal without executing tx
   when an old worker lost ownership."
  [srv claimed tx]
  (let [c (conn srv) clock (attempt-clock srv)]
    (dc/serialized! c
      (fn []
        (let [now (clock) j (datom/entity (datom/db c) (:db/id claimed))]
          (if (owns-attempt? j claimed now)
            {:status :committed :report (datom/transact! c tx)}
            {:status :refused :kind :stale-attempt}))))))

(defn defer-before-effect!
  "Requeue this SAME owned unsubmitted job at a future logical instant.
   Refuse any begun checkpoint, including completed/confirmed-absent history.
   Ticket, enrollment, payload and effect identity are unchanged. No HTTP or
   another store participates. Late settlement loses this relinquished claim.
   Deferral compensates retry-base so waiting does not consume failure budget.
   A committed-but-unacknowledged deferral remains future queued work; callers
   must inspect the retained job instead of inventing another enrollment."
  [srv claimed opts]
  (when-not (and (map? opts) (= #{:at :reason :basis} (set (keys opts)))
                (erlang/is_integer (:at opts)) (<= 0 (:at opts) 9223372036854775807)
                (keyword? (:reason opts))
                (<= (erlang/byte_size (erlang/term_to_binary (:reason opts))) 256)
                (some? (:basis opts))
                (<= (erlang/byte_size (erlang/term_to_binary (:basis opts))) 16384))
    (throw (ex-info "Deferral needs a future instant and bounded original basis" {:kind :invalid-deferral})))
  (let [c (conn srv) clock (attempt-clock srv)]
    (dc/serialized! c (fn []
     (let [now (clock) id (:db/id claimed) current (datom/entity (datom/db c) id)]
      (cond
       (not (owns-attempt? current claimed now)) {:status :refused :kind :stale-attempt}
       (seq (:job/effects current)) {:status :refused :kind :effect-already-begun}
       (<= (:at opts) now) {:status :refused :kind :deferral-not-future}
       :else
        (let [receipt {:at (:at opts) :observed-at now :reason (:reason opts)
                       :basis (:basis opts) :attempt-id (:job/attempt-id current)}]
         (datom/transact! c [[:db/cas id :job/state :running :queued]
                             [:db/cas id :job/owner (:job/owner current) (:job/owner current)]
                             [:db/retract id :job/owner (:job/owner current)]
                             [:db/add id :job/at (:at opts)]
                             [:db/add id :job/retry-base (inc (:job/retry-base current 0))]
                             [:db/add id :job/deferral receipt]])
         {:status :deferred :at (:at opts) :durability (sync-checkpoint! c)})))))))

(defn- effect-pending? [job]
  (some (fn [effect] (not= :complete (:state effect))) (vals (:job/effects job))))

(defn- effect-transition!
  [srv claimed step transition]
  (when-not (or (keyword? step) (and (string? step) (> (count step) 0) (<= (count step) 128)))
    (throw (ex-info "Effect step must be a keyword or short nonempty string" {:kind :invalid-effect})))
  (let [c (conn srv) clock (attempt-clock srv)]
    (dc/serialized! c
      (fn []
        (let [job (datom/entity (datom/db c) (:db/id claimed))]
          (if-not (owns-attempt? job claimed (clock))
            {:status :refused :kind :stale-attempt}
            (let [[result effect] (transition (get (:job/effects job) step) job)]
              (when effect
                (datom/transact! c [[:db/add (:db/id claimed) :job/effects
                                    (assoc (:job/effects job {}) step effect)]]))
              (assoc result :durability (sync-checkpoint! c)))))))))

(defn begin-effect!
  "Persist intent BEFORE provider submission. Returns :submit only for a fresh
   intent or an explicit provider-confirmed absence; repeated/unknown intents
   return :reconcile. Use the stable effect-id as provider idempotency key.
   A lost response never authorizes automatic resubmission."
  [srv claimed step]
  (effect-transition! srv claimed step
    (fn [prior job]
      (let [id (or (:effect-id prior)
                   (Base/encode16 (erlang/apply :crypto :hash
                     (list :sha256 (erlang/term_to_binary [(:job/id job) step])))))]
        (cond
          (= :complete (:state prior)) [{:status :complete :effect prior} nil]
          (or (nil? prior) (= :absent (:state prior)))
            (let [effect {:state :intent :effect-id id :attempt-id (:job/attempt-id claimed)}]
              [{:status :submit :effect-id id} effect])
          :else [{:status :reconcile :effect prior :effect-id id} nil])))))

(defn record-effect!
  "Record a provider receipt or uncertain response under the current attempt.
   :submitted/:uncertain require subsequent reconciliation; :complete releases
   the checkpoint. Receipts are bounded durable data, not emitted as UI/logs."
  [srv claimed step state receipt]
  (when-not (and (contains? #{:submitted :uncertain :complete} state) (map? receipt)
                (<= (erlang/byte_size (erlang/term_to_binary receipt)) 65536))
    (throw (ex-info "Invalid bounded provider receipt" {:kind :invalid-effect})))
  (effect-transition! srv claimed step
    (fn [prior _]
      (when-not prior (throw (ex-info "Provider effect requires prior durable intent" {:kind :missing-effect-intent})))
      (when (and (= :complete (:state prior)) (not= :complete state))
        (throw (ex-info "Completed provider effects cannot regress" {:kind :effect-regression})))
      (let [next (assoc prior :state state :receipt receipt :recorded-by (:job/attempt-id claimed))]
        [{:status :recorded :effect next} next]))))

(defn reconcile-effect!
  "Persist the result of an explicit provider lookup. :absent is the only
   transition that permits another submission; :submitted/:complete retain
   provider receipts. The caller must actually reconcile using the effect-id,
   never infer absence merely from a timeout or deployment revision."
  [srv claimed step outcome receipt]
  (when-not (and (contains? #{:absent :submitted :complete} outcome) (map? receipt)
                (<= (erlang/byte_size (erlang/term_to_binary receipt)) 65536))
    (throw (ex-info "Invalid provider reconciliation" {:kind :invalid-effect})))
  (effect-transition! srv claimed step
    (fn [prior _]
      (when-not prior (throw (ex-info "Reconciliation needs prior intent" {:kind :missing-effect-intent})))
      (when (and (= :complete (:state prior)) (not= :complete outcome))
        (throw (ex-info "Completed provider effects cannot regress" {:kind :effect-regression})))
      (let [next (assoc prior :state outcome :receipt receipt :recorded-by (:job/attempt-id claimed))]
        [{:status :reconciled :effect next} next]))))

(defn effects
  "Read durable provider checkpoints with the queue stopped."
  [srv id] (:job/effects (datom/entity (datom/db (conn srv)) id) {}))

(defn adoption-blocker
  "Pure existing-job eligibility shared by rehearsal, bounded adoption selection
   and the final writer fence. Pending provider intents keep their old route."
  [job]
  (cond (not (contains? #{:queued :failed :held} (:job/state job))) :active-or-terminal-job
        (effect-pending? job) :provider-effect-pending :else nil))

(defn adopt-generation!
  "Explicit sealed payload migration for non-running retained work. Original
   producer generation/protocol/payload stay unchanged. Persist converted payload,
   target dispatch generation and exact migration digest together in the writer.
   Pure upcast/check callbacks run outside the writer under a bounded fence.
   No pending provider effect may be reinterpreted by a code adoption. New
   obligations cannot target a fenced generation or retired protocol."
  [srv id expected-generation target-generation spec]
  (when-not (and (string? expected-generation) (string? target-generation)
                (not (empty? target-generation)) (positive-int? (:protocol spec))
                (string? (:digest spec)) (= 64 (count (:digest spec)))
                (every? (fn [ch] (includes? "0123456789abcdefABCDEF" ch)) (String/graphemes (:digest spec)))
                (erlang/is_function (:upcast spec) 1) (erlang/is_function (:accept? spec) 1))
    (throw (ex-info "Generation adoption requires sealed identity and payload contract" {:kind :invalid-adoption})))
  (let [c (conn srv) before (datom/entity (datom/db c) id)
        prior (:job/adoption before)
        already? (and (= target-generation (:job/required-generation before))
                      (= expected-generation (:from prior))
                      (= (:protocol spec) (:protocol prior))
                      (= (:digest spec) (:digest prior)))]
    (if already?
      (dc/serialized! c
        (fn []
          (if (= prior (:job/adoption (datom/entity (datom/db c) id)))
            {:status :already-applied :adoption prior :durability (sync-checkpoint! c)}
            {:status :refused :kind :stale-adoption})))
      (let [prepared (fence/fence-fn 250
                       (fn [] (dc/observing
                         (fn [] (let [payload ((:upcast spec) (:job/adopted-payload before (:job/payload before)))]
                                (when-not (= true ((:accept? spec) payload))
                                  (throw (ex-info "Adopted payload violates target contract" {:kind :invalid-message})))
                                payload)))))]
        (if-not (contains? prepared :ok) {:status :refused :kind :invalid-adoption-payload}
          (dc/serialized! c
            (fn []
              (let [job (datom/entity (datom/db c) id)
                    source (:job/required-generation job (:job/generation job))
                    admissions (datom/pull (datom/db c) '[*] [:queue/key (server-name srv)])
                    receipt {:digest (:digest spec) :from expected-generation :to target-generation
                             :protocol (:protocol spec)}]
                (cond
                  (or (nil? job) (not= source expected-generation) (not= job before))
                    {:status :refused :kind :stale-adoption}
                  (adoption-blocker job) {:status :refused :kind (adoption-blocker job)}
                  (protocol-fenced? admissions (:protocol spec))
                    {:status :refused :kind :protocol-fenced}
                  (contains? (:queue/fenced-generations admissions #{}) target-generation)
                    {:status :refused :kind :generation-fenced}
                  :else
                    (do (datom/transact! c [[:db/add id :job/required-generation target-generation]
                                           [:db/add id :job/adopted-payload (:ok prepared)]
                                           [:db/add id :job/adoption receipt]])
                        {:status :adopted :adoption receipt :durability (sync-checkpoint! c)}))))))))))

(defn retry!
  "Explicitly retry a failed/held job IN PLACE, preserving source/protocol,
   generation and stable job ID. A new attempt budget starts without resetting
   the lifetime attempt counter. Existing admitted work may drain after a
   protocol fence. No deployment implicitly retries failures or holds.
   Optional {:at <milliseconds>} schedules against a supplied logical clock;
   omitting it retains the wall-clock default."
  ([srv id] (retry! srv id {}))
  ([srv id opts]
  (when-not (and (map? opts) (every? #{:at} (keys opts))
                (or (not (contains? opts :at)) (erlang/is_integer (:at opts))))
    (throw (ex-info "Invalid explicit retry time" {:kind :invalid-retry-clock})))
  (let [c (conn srv) at (:at opts (tick/wall-ms))]
    (dc/serialized! c
      (fn []
        (let [j (datom/entity (datom/db c) id) d (declaration srv)]
          (when-not (contains? #{:failed :held} (:job/state j))
            (throw (ex-info "Only failed or held jobs may be retried" {:kind :not-retryable :state (:job/state j)})))
          (let [ticket (ticket-for d (:job/payload j))
                other (when ticket (find-by-ticket c ticket))]
            (when (and other (not= id (:db/id other)))
              (throw (ex-info "Outstanding work already holds retry ticket" {:kind :duplicate-retry})))
            (require-capacity! (datom/db c) srv (:admission d) (:job/payload j) id)
            (require-dispatch-room! (datom/db c) srv (:dispatch d) (:job/payload j))
            (datom/transact! c (vec (concat
              [[:db/cas id :job/state (:job/state j) :queued]
               [:db/add id :job/retry-base (:job/attempts j 0)]
               [:db/add id :job/at at]]
              (if (:job/owner j) [[:db/retract id :job/owner (:job/owner j)]] [])
              (if (:job/finished-at j) [[:db/retract id :job/finished-at (:job/finished-at j)]] [])
              (if ticket [[:db/add id :job/ticket ticket]] []))))
            (datom/entity (datom/db c) id))))))))

;; ── cancelling work that has not begun, and reaping what has ────────────
;;
;; Both verbs are STORE WRITES, so neither needs a running queue: the store
;; outlives the process, and an operator who has stopped a queue can still stop
;; work and still reap what is finished.

(def TERMINAL-STATES #{:done :failed :cancelled})

(defn- cancellable-effects?
  "Cancellation may stop future work only with no unresolved provider effect.
   Explicitly confirmed absence and completed receipts remain retained facts."
  [job]
  (every? (fn [effect] (contains? #{:absent :complete} (:state effect)))
          (vals (:job/effects job {}))))

(defn- cancel-state
  "The transaction that cancels `job`, from the state the caller READ, or nil
   when that state may not be cancelled.

   The CAS is on `:job/state`, so a cancel and a claim cannot both land: the
   loser's whole transaction is refused and `cancel!` retries against what
   actually happened. That is the claim's own read-modify-write discipline, one
   attribute over."
  [job now]
  (let [e (:db/id job)
        s (:job/state job)]
    (when (and (= :queued s) (cancellable-effects? job))
      (vec (concat [[:db/cas e :job/state s :cancelled]
                    [:db/add e :job/finished-at now]]
                   ;; THE KEY GOES WITH THE JOB. A cancelled job is finished, so its
                   ;; Idempotency Key window is CLOSED — the same payload may be
                   ;; owed again (as after :done), and no key is left held by a job
                   ;; nothing will ever run.
                   (if (some? (:job/ticket job))
                     [[:db/retract e :job/ticket (:job/ticket job)]]
                     []))))))

(defn cancel!
  "Cancel future execution of a queued job with no unresolved provider effects.
   No checkpoint, or only :absent/:complete checkpoints, is eligible. Retained
   known receipts remain evidence; cancellation never undoes past provider IO.
   A STORE WRITE, so it needs no running queue.

   REFUSES every other state, NAMING it, and that is this file's decision about
   a CLAIMED (in-flight) job:

     · cancelling a claimed job cannot undo an external effect. The separate
       strict owner shutdown can stop tracked local bodies, while retaining
       running jobs and uncertain effect checkpoints for native recovery. It
       cannot make a begun charge or send become work that never began.
     · the model this bundle follows agrees: Oban refuses `cancel` on an
       `executing` job, for the same reason, and §4.3 names Oban as the shape.
     · :held work and queued unresolved effects are refused. An explicit
       reconciliation retry does not make an unknown write unsubmitted.

   The refusal names the state; for `:running` it also names the OWNER TOKEN and
   how much lease is left. NOT a pid: the store keeps the lease's owner TOKEN and
   nothing else: physical PIDs belong to the ephemeral owner inventory, not the
   durable job or this store-only cancellation API. Naming a PID here would be
   inventing a current physical fact. The token is
   what a `:db/cas` on `:job/owner` compares against, so it is the worker's name
   in every sense this store has.

   A missing id is refused NAMING THE ID, so a typo is not a silent no-op; a
   terminal job is refused NAMING ITS STATE, because cancelling work that is
   already done is a category error and should read as one."
  [srv id]
  (let [c (conn srv)]
    (dc/serialized! c (fn []
    (loop [n 0]
      (let [job (datom/entity (datom/db c) id)
            st (:job/state job)]
        (cond
          (nil? job)
            (throw (ex-info (str "queue: no job " id " in " (server-name srv) " — nothing"
                                 " to cancel. Cancel takes the id of an EXISTING job,"
                                 " and only :queued work can be cancelled")
                            {:server srv :id id}))
          (contains? TERMINAL-STATES st)
            (throw (ex-info (str "queue: job " id " is :" (name st) " — a terminal job"
                                 " cannot be cancelled (only :queued work can)")
                            {:server srv :id id :state st}))
          (= :running st)
            (throw (ex-info (str "queue: job " id " is :running under owner "
                                 (:job/owner job) " with "
                                 (- (or (:job/lease-until job) (tick/wall-ms))
                                    (tick/wall-ms))
                                 "ms of lease left — a CLAIMED job has BEGUN and"
                                 " cannot be cancelled (only :queued work can); its"
                                 " outcome settles under that owner")
                            {:server srv :id id :state st :owner (:job/owner job)
                             :lease-until (:job/lease-until job)}))
          (not= :queued st)
            (throw (ex-info "Only queued work can be cancelled"
                            {:kind :not-queued :server srv :id id :state st}))
          (not (cancellable-effects? job))
            (throw (ex-info "Provider effect requires reconciliation before cancellation"
                            {:kind :provider-effect-pending :server srv :id id :state st}))
          (> n 2)
            (throw (ex-info (str "queue: job " id " would not settle into a"
                                 " cancellable state — it is :" (name st) " now")
                            {:server srv :id id :state st}))
          :else
            (let [outcome (try
                            (datom/transact! c (cancel-state job (tick/wall-ms)))
                            :cancelled
                            (catch err (if (lose-race? err) :lost (throw err))))]
              (if (= outcome :lost)
                (recur (inc n))
                (datom/entity (datom/db c) id))))))))))

(defn prune!
  "Delete TERMINAL jobs finished at or before `cutoff` (epoch milliseconds), and
   answer what was removed: `{:removed N :by-state {:done … :failed …
   :cancelled …} :ids […]}`. A STORE WRITE, so it needs no running queue — which
   is exactly when a nightly prune runs.

   TERMINAL ONLY, and the guard is STRUCTURAL rather than a filter someone could
   forget: eligibility is the PRESENCE of `:job/finished-at`, the attribute a
   terminal settle writes and nothing else does. A job that is owed (`:queued`),
   claimed (`:running`, live lease or expired) or waiting on a retry backoff
   carries no `finished-at`, so the query cannot see it. DELETING A LIVE JOB IS
   THE ONE WAY A PRUNE LOSES WORK SILENTLY — the queue would never re-run it and
   nothing would say so — which is why the bound is applied to a fact only
   terminal jobs have.

   THE FN, NOT THE SCHEDULE. This bundle has no scheduler, and the design puts a
   queue's prune in the tree that owns it (§4.3) as a `:schedules` line. A
   scheduled body is handed the occurrence map and nothing else, so the tree
   writes the two lines that say WHICH queue and HOW FAR BACK — neither of which
   this file could know:

     :schedules [{:id «larder-prune» :daily [4 10]
                  :run «hotel.jobs/prune-larder»}]

     (defn prune-larder [_occ]
       (proc.queue/prune! :larder (- (proc/wall-ms) (* 7 24 3600000))))

   Seven days, there, is the tree's choice: the queue has no opinion about how
   long a finished job is worth keeping, only that a live one is never worth
   deleting."
  [srv cutoff]
  (when-not (erlang/is_integer cutoff)
    (throw (ex-info (str "queue: prune! takes an epoch-ms cutoff — got " (str cutoff))
                    {:server srv :cutoff cutoff})))
  (let [c (conn srv)]
   (dc/serialized! c (fn []
    (let [d (datom/db c)
        doomed (vec (filter (fn [row]
                              (and (contains? TERMINAL-STATES (second row))
                                   (not (effect-pending? (datom/entity d (first row))))
                                   (<= (nth row 2) cutoff)))
                            (datom/q '[:find ?e ?s ?fin
                                       :where [?e :job/state ?s]
                                              [?e :job/finished-at ?fin]]
                                     d)))]
    (if (empty? doomed)
      {:removed 0 :by-state {} :ids []}
      (do
        (datom/transact! c (vec (map (fn [row] [:db/retractEntity (first row)]) doomed)))
        {:removed (count doomed)
         :by-state (reduce (fn [m row]
                             (assoc m (second row) (inc (get m (second row) 0))))
                           {}
                           doomed)
         :ids (vec (map first doomed))})))))))

;; ── the loop ────────────────────────────────────────────────────────────
;;
;; ONE timer at the earliest deadline, and a claim pass on every wake. The state
;; carries what a claim needs and nothing else: the declaration, the clock, the
;; body, and the jobs currently RUNNING IN THIS PROCESS (which is what bounds
;; concurrency and what makes :partition per-key serialisation possible).

(def TIMER-KEY :bl-queue/timer)

(defn- pd
  "The process dictionary's value for `key`, or `default`. `:erlang.get/1`
   answers the ATOM `:undefined` on a miss, and an atom is truthy here — so
   `(or (erlang/get k) …)` hands `:undefined` on and the next arithmetic dies."
  [key default]
  (let [v (erlang/get key)]
    (if (= :undefined v) default v)))

(defn- arm-ms!
  "Arm the ONE wake, `delay` milliseconds out, cancelling whatever was pending.

   A cancelled timer may already have sent its message; a stale wake is
   HARMLESS here (it re-reads the store), which is why this needs none of
   `proc.tick`'s generation machinery. `delay < 1` becomes 1: work that is due
   NOW is delivered as a message, never as a re-entrant call."
  [delay]
  (let [old (pd TIMER-KEY nil)]
    (when (some? old) (erlang/cancel_timer old))
    (erlang/put TIMER-KEY
                (erlang/send_after (if (< delay 1) 1 delay)
                                   (erlang/self)
                                   (tuple :bl-queue/wake)))))

(defn- wake-time
  "The earliest moment this queue must look again, from the store, or nil.

   `owed?` is BOOT semantics: a `:at` that ALREADY PASSED is a deadline missed
   while the queue was not running, nobody has claimed it, and the only thing
   that will notice it is this timer. At RUNTIME a past due is different — it is
   a job this process can already claim, or one waiting for a slot, and both of
   those unblock with a MESSAGE (a completion, an enqueue) rather than a timer —
   so arming for it would be a 1 ms poll, which is exactly what this design
   exists to avoid (a queue at its concurrency bound would spin at 1000 store
   reads a second).

   A RUNNING job's lease is always counted, past or absent: it means the owner is
   gone, and the wake after it prunes the dead claim and hands the job to the
   Lifeline."
  [d now owed?]
  (reduce
    (fn [acc row]
      (let [s (second row)
            t (cond
                (= s :queued) (let [at (nth row 2)]
                                (if (or owed? (> at now)) at nil))
                (= s :running) (or (:job/lease-until (datom/entity d (first row))) now)
                :else nil)]
        (if (nil? t) acc (if (or (nil? acc) (< t acc)) t acc))))
    nil
    (job-rows d)))

(defn next-wake
  "The earliest moment this queue must look again AT BOOT, or nil when there is
   nothing owed: a queued job's `:at` (past or future) or a running job's LEASE
   EXPIRY. A restart re-derives the wheel from the facts, so a deadline missed
   while the queue was down is visible here as a past `:at`."
  [d now]
  (wake-time d now true))

(defn- due-candidates
  "Every claimable job, oldest first: queued and due, plus running ones whose
   lease has run out."
  [d now]
  (->> (job-rows d)
       (filter (fn [row]
                 (let [s (second row)]
                   (or (= s :running)
                       (and (= s :queued) (<= (nth row 2) now))))))
       (map (fn [row] (datom/entity d (first row))))
       (filter (fn [j]
                 (if (= :queued (:job/state j))
                   true
                   (let [lease (:job/lease-until j)]
                     (or (nil? lease) (<= lease now))))))
       (sort-by (fn [j] (:job/at j)))))

(defn arm
  "Re-arm the wake at the earliest deadline still worth a timer. Returns the
   delay armed, or nil when nothing is outstanding — an idle queue is woken by
   its own store's broadcast (an enqueue) and by its workers' completions, never
   by a poll."
  [st]
  (let [q (:queue st)
        now ((:clock q))
        due (wake-time (datom/db (conn (:server q))) now false)]
    (when (some? due)
      (let [delay (- due now)]
        (arm-ms! delay)
        delay))))

(defn- busy-partitions [running]
  (into #{} (remove nil? (map (fn [entry] (:partition (second entry))) running))))

(defn- partition-free? [job busy]
  (let [pk (:job/partition job)]
    (or (nil? pk) (not (contains? busy pk)))))

(defn- job-map
  "The job as `perform` sees it: the stored facts, with the payload's own keys
   hoisted so a body may name them directly. The queue's own fields win a
   collision — `validate-payload!` has already refused a payload that writes the
   `job` namespace, so this is belt and braces."
  [j]
  (let [payload (:job/payload j)]
    (if (map? payload) (merge payload j) j)))

(defn- emit-entry! [entry event fields]
  (if-let [captured (:diagnostics entry)]
    (diag/with-captured-fn captured #(diag/emit! event fields))
    (diag/emit! event fields)))

(defn- prepare-payload [q job]
  (let [target (get-in q [:decl :protocol] 1) contract (:contract q {})]
    (loop [version (get-in job [:job/adoption :protocol] (:job/protocol job 1))
           payload (:job/adopted-payload job (:job/payload job)) seen #{}]
      (cond
        (= version target)
          (if (or (nil? (:accept? contract)) (= true ((:accept? contract) payload)))
            {:payload payload :protocol target}
            (throw (ex-info "Queue payload violates current protocol" {:kind :invalid-message})))
        (contains? seen version)
          (throw (ex-info "Cyclic queue protocol adapters" {:kind :invalid-adapter}))
        :else
          (if-let [edge (get (:adapters contract) version)]
            (let [next ((:upcast edge) payload)]
              (when-not (and (positive-int? (:to edge)) (> (:to edge) version)
                            (= true ((:accept? edge) next)))
                (throw (ex-info "Queue adapter violated its contract" {:kind :invalid-adapter})))
              (recur (:to edge) next (conj seen version)))
            (throw (ex-info "No queue payload upgrade path" {:kind :unsupported-version})))))))

(defn- launch!
  "Claim `job` and start its body on its OWN process. Returns the running entry,
   or nil when another claimer took it first.

   The body runs on a plain `spawn`, not on the server: a slow `perform` must not
   stop the queue from claiming the next job, which is what `:concurrency`
   means. A worker that is KILLED (not merely raising) sends nothing, and the
   job stays `:running` until its lease runs out — the Lifeline wake above —
   which is why the lease is the safety net and no monitor is registered: a
   `[:DOWN …]` handler would have to match every DOWN message in the server, and
   the lease already answers the same question for less."
  ([st job] (launch! st job {}))
  ([st job claim-opts]
  (let [base (:queue st)
        required (:job/required-generation job (:job/generation job))
        q (merge base (get (:handlers base) required {}))
        _ (when-not (:workers q) (throw (ex-info "Queue worker lifetime inventory is unavailable" {:kind :worker-inventory-required})))
        c (conn (:server q))
        now ((:clock q))
        decl (:decl q)
        generation-compatible? (or (nil? required) (= required (:generation decl)))
        prepared (when generation-compatible?
                   (if (and (= (get-in job [:job/adoption :protocol] (:job/protocol job 1)) (:protocol decl 1))
                          (nil? (get-in q [:contract :accept?])))
                   {:payload (:job/adopted-payload job (:job/payload job)) :protocol (:protocol decl 1)}
                   (let [r (fence/fence-fn 250 (fn [] (prepare-payload q job)))] (:ok r))))
        claimed (when prepared (claim! c job now (* 1000 (:lease decl)) claim-opts))]
    (when (some? claimed)
      (let [ref (erlang/make_ref)
            e (:db/id claimed)
            token (:job/owner claimed)
            body (:perform q)
            me (erlang/self)
            captured (diag/with-linkage-fn (:job/diagnostic-context claimed {}) diag/capture)
            inventory (:workers q)
            pid (BeamLisp.Refs/spawn_owned (fn []
                 ;; Registration precedes release. If the owner dies in the
                 ;; spawn/register window this body never starts provider IO.
                 (let [watch (Process/monitor me)]
                  (receive
                   [:bl-queue/start]
                   (do
                    (Process/demonitor watch (list :flush))
                 (when (:environment q) (BeamLisp.Env/bind (:environment q)))
                 (Process/put (tuple :bl-queue/attempt-clock (server-name (:server q))) (:clock q))
                  (let [out (try
                             {:ok (diag/with-captured-fn captured #(body (assoc (job-map (assoc claimed :job/payload (:payload prepared)))
                                                   :job/execution-protocol (:protocol prepared)
                                                   :job/execution-generation (:generation decl))))}
                             (catch err {:error (error-text err) :failure (diag/safe-error err)}))]
                   (erlang/send me (tuple :bl-queue/finished ref out))))
                   (tuple :DOWN _ :process _ _) nil)))
          :plain (to-list (concat (:modules q []) (BeamLisp.Env/callback_modules body)
                                  (BeamLisp.Env/callback_modules (:clock q)))))]
        (swap! inventory assoc ref {:pid pid :server (server-name (:server q)) :generation (:generation decl)})
        (erlang/send pid [:bl-queue/start])
        (emit-entry! {:diagnostics captured} :proc.queue/claimed {:proc.queue/attempt (:job/attempts claimed)})
        {:ref ref :pid pid :diagnostics captured
         :e e
         :token token
         :decl decl :generation (:generation decl) :clock (:clock q)
         :attempts (:job/attempts claimed)
         ;; the deadline this CLAIM will be judged by. Kept here as well as in
         ;; the store, because this process must know when its own claim stops
         ;; being one — that is what frees the slot a killed worker leaked.
         :lease-until (+ now (* 1000 (:lease decl)))
         :partition (:job/partition claimed)})))))

(defn worker-inventories
  "Ephemeral physical-body inventories, including bodies from an earlier
   actor-only owner stop. These cells never enter durable queue payloads."
  [state]
  (let [q (:queue state)]
    (vec (distinct (cons (:workers q) (:inherited-workers q []))))))

(defn prune-workers!
  "Forget only physically dead bodies. Lease expiry alone cannot prove death."
  [state]
  (doseq [inventory (worker-inventories state)]
    (when inventory
      (swap! inventory (fn [entries]
        (into {} (filter (fn [[_ entry]]
                           (let [pid (:pid entry)]
                            (or (not (erlang/is_pid pid))
                                (not= (erlang/node) (erlang/node pid))
                                (Process/alive? pid)))) entries))))))
  state)

(defn stop-workers!
  "Stop and await this queue's tracked physical bodies without inventing job
   outcomes. The live owner must invoke this in its own serialized turn; an
   already-dead owner may be cleaned through its exact retained inventory.
   In-flight provider effects retain their native uncertain checkpoints."
  [state timeout-ms]
  (let [q (:queue state) owner (:worker-owner q) inventories (worker-inventories state)
        authorized? (and (= 1 (:worker-inventory-version q)) (= true (:worker-inventory-complete? q)) (erlang/is_pid owner)
                         (or (= owner (erlang/self)) (not (Process/alive? owner))))]
    (if-not authorized? {:status :refused :kind :worker-lifetime-authority-required}
      (try
        (let [entries (mapcat (fn [inventory] (vals @inventory)) inventories)
              valid? (every? (fn [entry]
                      (let [pid (:pid entry)]
                        (and (erlang/is_pid pid) (= (erlang/node) (erlang/node pid))
                             (not= pid (erlang/self)) (= (server-name (:server q)) (:server entry))))) entries)]
          (if-not valid? {:status :refused :kind :invalid-worker-inventory}
            (let [pids (vec (distinct (map :pid entries)))
                  live (filter Process/alive? pids)
                  deadline (+ (erlang/monotonic_time :millisecond) timeout-ms)]
              (doseq [pid live] (erlang/exit pid :kill))
              (loop []
                (cond
                  (not-any? Process/alive? pids)
                    (do (doseq [inventory inventories] (reset! inventory {}))
                        {:status :stopped :workers (count live)})
                  (>= (erlang/monotonic_time :millisecond) deadline)
                    {:status :refused :kind :worker-stop-timeout}
                  :else (do (Process/sleep 1) (recur)))))))
        (catch _ {:status :refused :kind :invalid-worker-inventory})))))

(defn- outcome-tx
  "The transaction that settles one claimed job.

   Every branch is GUARDED on the owner token, so the process that no longer
   holds the job cannot write its outcome over the one that does — the job
   settles once, under one owner, however many times the body ran."
  [e job token out now decl attempts]
  (let [guard [[:db/cas e :job/owner token token]
               [:db/retract e :job/owner token]]
        ticket (when (some? (:job/ticket job))
                 [[:db/retract e :job/ticket (:job/ticket job)]])
        with-ticket (fn [ops] (vec (concat guard ops ticket)))]
    (if (effect-pending? job)
      (vec (concat guard [[:db/add e :job/state :held]
                         [:db/add e :job/last-error "Provider effect requires reconciliation"]]))
    (if (contains? out :ok)
      (with-ticket [[:db/add e :job/state :done]
                    [:db/add e :job/result (:ok out)]
                    [:db/add e :job/finished-at now]])
      (let [err (str (:error out))]
        (if (>= (- attempts (:job/retry-base job 0)) (:max (:retry decl)))
          ;; EXHAUSTED, and the job is KEPT: :failed is a state a human reads,
          ;; which is the whole difference between a retry ceiling and a hole the
          ;; work fell into. `:job/finished-at` is written on THIS arm as well as
          ;; on the success one, because it is the ONE attribute `prune!` ages a
          ;; terminal job by: a `:failed` row without it could never be reaped.
          (with-ticket [[:db/add e :job/last-failure (diag/safe-error {:kind (get-in out [:failure :diagnostics/error-kind])})]
                        [:db/add e :job/state :failed]
                        [:db/add e :job/last-error err]
                        [:db/add e :job/finished-at now]])
          (vec (concat guard [[:db/add e :job/last-failure (diag/safe-error {:kind (get-in out [:failure :diagnostics/error-kind])})]
                        [:db/add e :job/state :queued]
                        [:db/add e :job/at (+ now (backoff-ms (:retry decl) attempts))]
                        [:db/add e :job/last-error err]]))))))))

(defn- settle!
  [st entry out]
  (let [q (:queue st) c (conn (:server q))]
    (dc/serialized! c
      (fn []
        (let [now ((:clock entry (:clock q))) e (:e entry) decl (:decl entry (:decl q))
              job (datom/entity (datom/db c) e)]
          (if (nil? job) :gone
            (if-not (owns-attempt? job {:job/server (server-name (:server q))
                                       :job/owner (:token entry) :job/attempt-id (:token entry)} now)
              :expired-or-lost
            (let [tx (outcome-tx e job (:token entry) out now decl (:attempts entry))]
              (try (datom/transact! c tx) :settled
                   (catch err (if (lose-race? err) :lost (throw err))))))))))))

(defn settle
  "Record one worker's outcome and stop tracking it. A ref this process is not
   tracking is ignored — a wake that raced the completion is not an error."
  [st ref out]
  (let [q (:queue st)]
    (if (nil? (get (:running q) ref))
      st
      (do
        (let [entry (get (:running q) ref)
              settlement (settle! st entry out)]
          (emit-entry! entry :proc.queue/settled
            (merge (:failure out {}) {:proc.queue/settlement settlement
                                     :proc.queue/outcome (if (contains? out :ok) :returned :raised)
                                     :proc.queue/attempt (:attempts entry)})))
        (assoc st :queue (assoc q :running (dissoc (:running q) ref)))))))

(defn run-due
  "One pass: forget claims whose lease has run out, claim as much due work as
   there is ROOM for, then arm the next wake.

   Idempotent by construction — it reads the store and claims what is due, so a
   stale wake costs one store read and nothing else. `:concurrency` is bounded
   HERE, by the room left after the jobs this process is already running, which
   is also why `:partition` can be honoured at all: both rules are about what one
   claimant already holds.

   FORGETTING AN EXPIRED CLAIM is why the lease is a slot and not only a
   timestamp. A worker that was KILLED sends nothing, so its entry would sit in
   `:running` forever and the queue would be permanently one slot smaller — a
   queue that heals its job but not its own capacity. The entry dies with its
   lease instead; the job it was holding is then reclaimed by the same pass, and
   if that worker is merely SLOW, its late outcome is refused (it no longer owns
   the job) — which is at-least-once, stated where it happens."
  [st]
  (let [st (prune-workers! st) q0 (:queue st)
        c (conn (:server q0))
        now ((:clock q0))
        live (into {} (remove (fn [entry]
                                (let [lu (:lease-until (second entry))]
                                  (and (some? lu) (<= lu now))))
                              (:running q0)))
        _ (doseq [[ref entry] (:running q0)]
            (when-not (contains? live ref)
              (emit-entry! entry :proc.queue/claim-expired {:proc.queue/attempt (:attempts entry)})))
        st (assoc st :queue (assoc q0 :running live))
        room (- (:concurrency (:decl q0)) (count live))
        busy (busy-partitions live)
        policy (:dispatch (:decl q0))
        candidates (fn [busy excluded]
          (if policy (dispatch-candidates (datom/db c) (:server q0) now policy busy excluded)
            (vec (remove #(contains? excluded (:db/id %)) (due-candidates (datom/db c) now)))))
        cands (if (> room 0) (candidates busy #{}) [])]
    (loop [st st cs cands room room busy busy excluded #{}]
      (if (or (<= room 0) (empty? cs))
        (do (arm st) st)
        (let [job (first cs)]
          (if (not (partition-free? job busy))
            (recur st (vec (rest cs)) room busy (conj excluded (:db/id job)))
            (let [entry (launch! st job (if policy {:dispatch policy :server (:server q0) :busy busy :excluded excluded} {}))]
              (if (nil? entry)
                (recur st (vec (rest cs)) room busy (conj excluded (:db/id job)))
                (let [after-busy (if (some? (:partition entry)) (conj busy (:partition entry)) busy)
                      after-excluded (conj excluded (:db/id job))]
                 (recur (assoc-in st [:queue :running (:ref entry)] entry)
                       (if policy (candidates after-busy after-excluded) (vec (rest cs)))
                       (dec room) after-busy after-excluded))))))))))

;; ── the init, the prelude, the two clauses ──────────────────────────────

(defn- perform-key [srv] (tuple :bl.queue/perform (server-name srv)))

(defn- validate-contract! [contract]
  (when-not (and (map? contract)
                (every? (fn [k] (contains? #{:accept? :adapters} k)) (keys contract))
                (or (nil? (:accept? contract)) (erlang/is_function (:accept? contract) 1))
                (or (nil? (:adapters contract)) (map? (:adapters contract))))
    (throw (ex-info "Invalid queue protocol contract" {:kind :invalid-protocol})))
  (doseq [[from edge] (:adapters contract)]
    (when-not (and (positive-int? from) (positive-int? (:to edge)) (> (:to edge) from)
                  (erlang/is_function (:upcast edge) 1) (erlang/is_function (:accept? edge) 1))
      (throw (ex-info "Adapters require increasing versions and unary upcast/accept callbacks" {:kind :invalid-adapter}))))
  contract)

(defn normalise-contract
  "Validate the reusable queue payload contract without publishing callbacks."
  [contract] (validate-contract! (or contract {})))

(defn register-perform!
  "Stage this process's perform callback for its immediately following init.
   Retain before publication; queue process death releases the lifetime lease
   through Env's dead-owner reclamation. No global callback registry survives a
   stopped/restarted queue, or collides across environments using one name."
  ([srv f] (register-perform! srv f {}))
  ([srv f contract]
  (validate-contract! contract)
  (let [lease (BeamLisp.Env/retain_code! (concat (BeamLisp.Env/callback_modules f)
                 (mapcat (fn [g] (BeamLisp.Env/callback_modules g))
                   (concat (if (:accept? contract) [(:accept? contract)] [])
                     (mapcat (fn [edge] [(:upcast edge) (:accept? edge)]) (vals (:adapters contract)))))))
        previous (Process/put (perform-key srv) {:perform f :contract contract :lease lease})]
    (when previous (BeamLisp.Env/release_code! (:lease previous)))
    f)))

(defn- perform-registration [srv] (Process/delete (perform-key srv)))

(defn init-state
  "The state the clause contributes: the declaration, the clock, the body, and
   the jobs running in THIS process.

   The declaration is written to the store HERE, at boot. That is what lets
   `enqueue!` be a store write with no process to ask, and it is why a queue
   must be started once before it can be enqueued into."
  ([srv decl clock] (init-state srv decl clock {}))
  ([srv decl clock contract] (init-state srv decl clock contract srv))
  ([srv decl clock contract registration-server]
  (announce! srv)
  (let [srv (resolve-server srv)
        context (Process/get :bl_generation)
        declared (normalise-decl decl)
        _ (when (and (:digest context) (:generation declared)
                     (not= (:digest context) (:generation declared)))
            (throw (ex-info "Queue generation conflicts with executing sealed code" {:kind :generation-conflict})))
        d (assoc declared :generation (or (:digest context) (:generation declared)))
        ;; A clause may configure its durable queue identity from start-opts;
        ;; its perform was staged by this same process under the declaration
        ;; name. Consume that local registration without changing queue identity.
        registration (perform-registration registration-server)
        contract (validate-contract! (merge (:contract registration) contract))
        body (:perform registration)
        _ (when (nil? body)
            (throw (ex-info (str "queue: \"" (server-name srv) "\" declares no (perform [job] …) —"
                                 " a queue with no body would accept work it can never"
                                 " do")
                            {:server srv})))
        lease (try
                (BeamLisp.Env/retain_code!
                  (concat (BeamLisp.Env/callback_modules body)
                          (BeamLisp.Env/callback_modules clock)
                          (mapcat (fn [edge] (concat (BeamLisp.Env/callback_modules (:upcast edge))
                                                   (BeamLisp.Env/callback_modules (:accept? edge))))
                                  (vals (:adapters contract)))
                          (if-let [accept (:accept? contract)]
                            (BeamLisp.Env/callback_modules accept) [])))
                (catch e (do (BeamLisp.Env/release_code! (:lease registration)) (throw e))))]
    (BeamLisp.Env/release_code! (:lease registration))
    (try
      (write-decl! (conn srv) srv d)
      {:queue {:server srv
               :decl d
               :clock clock
               :environment (BeamLisp.Env/capture)
               :perform body
               :contract contract
               :perform-lease lease
               ;; This inventory outlives claim expiry. It is process lifetime
               ;; evidence, not durable job state or an additional worker pool.
               :workers (atom {}) :worker-owner (erlang/self) :worker-inventory-version 1
               :worker-inventory-complete? true
               :running {}}}
      (catch e (do (BeamLisp.Env/release_code! lease) (throw e)))))))

(defn arm-first
  "The prelude: subscribe THIS process to its store, and arm the wake for work
   already in it.

   Subscribing here, and not at the caller's, is deliberate: a subscription (like
   a name) is only useful if the process that OWNS it installed it. Arming from
   the STORE is what makes a restart RESUME — a deadline missed while the queue
   was down has `:at` in the past and runs at once, and a job left `:running`
   wakes the loop when its lease expires."
  [srv clock]
  ;; Retry at a frozen logical instant changes state without changing :job/at.
  ;; Adoption likewise can release work without changing its scheduled time.
  (datom/listen! (conn srv) {:attrs #{:job/state :job/at :job/required-generation :job/adoption}})
  (let [c (conn srv)
        now (clock)
        due (next-wake (datom/db c) now)]
    (when (some? due)
      (arm-ms! (- due now)))))

(defn queue-clause
  "The `(queue {…})` transform. Public because it is worth testing on its own:
   it is the unit that turns a declaration into a loop."
  [clause ctx]
  (let [forms (vec (rest clause))
        where (str "defserver " (:name ctx))]
    (when (not= 1 (count forms))
      (throw (ex-info (str where ": (queue {…}) — exactly one option map is required")
                      {:clause clause})))
    (let [opts (first forms)]
      (when-not (map? opts)
        (throw (ex-info (str where ": (queue {…}) — the options must be a LITERAL map,"
                             " so the declaration is data")
                        {:opts opts})))
      (doseq [k (keys opts)]
        (when-not (known? k KNOWN-CLAUSE-OPTS)
          (throw (ex-info (str where ": unknown queue option " k " — known: "
                               (join " " (map (fn [x] (str x)) KNOWN-CLAUSE-OPTS)))
                          {:option k}))))
      (let [decl (select-keys opts KNOWN-DECL-OPTS)
            _ (normalise-decl decl)          ; a typo fails HERE, naming the server
            clock (if (some? (get opts :clock)) (get opts :clock) `proc.tick/wall-ms)
            srv (if (some? (get opts :server))
                  (get opts :server)
                  (list 'quote (:name ctx)))]
        {:prelude [`(proc.queue/arm-first ~srv ~clock)]
         :init `(proc.queue/init-state ~srv ~decl ~clock ~(:contract opts {}) '~(:name ctx))
         :clauses
         [`(handle-info [:bl-queue/wake] [st#]
             (noreply (proc.queue/run-due st#)))
          `(handle-info [:datom/tx _basis# _datoms#] [st#]
             (noreply (proc.queue/run-due st#)))
          `(handle-info [:bl-queue/finished ref# out#] [st#]
             (noreply (proc.queue/run-due (proc.queue/settle st# ref# out#))))
          `(handle-call [:enqueue job# opts#] [_from# st#]
             (reply (proc.queue/enqueue! (:server (get st# :queue)) job# opts#) st#))
          `(handle-call [:stats] [_from# st#]
             (reply (proc.queue/stats (:server (get st# :queue))) st#))]}))))

(defn perform-clause
  "The `(perform [job] BODY…)` transform: the ONE thing a queue cannot derive.

   It contributes a prelude and no state, because the body belongs in the queue's
   OWN slice rather than beside it: two clauses claiming `:init` keys would merge
   as two maps where the later silently replaced the earlier, and a queue whose
   body vanished at boot is a queue that accepts work and never does it."
  [clause ctx]
  (let [forms (vec (rest clause))
        where (str "defserver " (:name ctx))]
    (when (< (count forms) 2)
      (throw (ex-info (str where ": (perform [job] BODY…) — a params vector and a body"
                           " are required")
                      {:clause clause})))
    (let [params (first forms)
          body (vec (rest forms))]
      (when-not (and (vector? params) (= 1 (count params)) (symbol? (first params)))
        (throw (ex-info (str where ": the perform's params vector holds exactly one"
                             " symbol — the job")
                        {:params params})))
      {:prelude [`(proc.queue/register-perform! '~(:name ctx) (fn ~params ~@body))]})))

(extend-clause! :queue queue-clause)

(extend-clause! :perform perform-clause)
