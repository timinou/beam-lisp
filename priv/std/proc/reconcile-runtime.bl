; Ordinary source constructors lower here only after canonical native compiler
; provenance and residual proof. Embedded/custom declarations stay unchanged.
(ns proc.reconcile-runtime
 (:require [proc.queue-runtime :as runtime] [proc.reconcile-handler :as handler]
           [reload.execution :as execution] [reload.reconcile-snapshot :as snapshot] [data.first-order :as data] [core]))
(defn- refuse [kind] (throw (ex-info "Reconciliation runtime constructor refused" {:kind kind})))
(defn- payload! [original-class start-context descriptor]
 (data/check! descriptor {:max-nodes 16 :max-depth 4 :max-bytes 4096})
 (when-not (and (= #{:version :declaration} (set (keys descriptor))) (contains? #{1 2} (:version descriptor))
                (string? (:declaration descriptor)) (execution/owned?))
  (refuse :unsealed-reconcile-constructor))
 (let [g (execution/current) recipe (handler/recipe! g (:declaration descriptor) original-class)]
  (when-not (= (:version descriptor) (:version recipe)) (refuse :unsealed-reconcile-constructor))
  (when (= 2 (:version recipe)) (snapshot/require-consumer!))
  ;; No resource handles/closures travel in actor argument state. Callback-only
  ;; native runtime resources remain behind the original initializer binding.
  (if (try (data/check! start-context {:max-nodes 32768 :max-depth 64 :max-bytes 1048576})
           true (catch error
                  (if (= :unsafe-first-order-data (:kind (ex-data error))) false (throw error))))
   {:reconcile {:declaration (:declaration recipe) :original-class original-class :start-context start-context}}
   ;; Preserve ordinary constructor semantics for native-handle/opaque args.
   ;; That actual Source class remains embedded/retained; never guess a recipe.
   {:embedded true})))
(defn start-declared!
 [original-class start-context options descriptor mode]
 (let [payload (payload! original-class start-context descriptor)]
  (case mode
   :start (if (:embedded payload) (core/start original-class start-context options)
             (core/start runtime/owner payload options))
   :start-link (if (:embedded payload) (core/start-link original-class start-context options)
                  (core/start-link runtime/owner payload options))
   (refuse :invalid-reconcile-start-mode))))
(defn child-spec-declared!
 [id original-class start-context options descriptor]
 ;; Existing native Supervisor.server preserves supervision/start context,
 ;; restart policy/name/shutdown options. This does not start any actor.
 (let [payload (payload! original-class start-context descriptor)]
  (if (:embedded payload) (BeamLisp.Supervisor/server id original-class start-context options)
      (BeamLisp.Supervisor/server id runtime/owner payload options))))
(defn prepare-existing!
 "First-party sealed family contribution for an already living shared actor.
  Reify exact callback bodies without invoking the original factory/provider.
  Caller submits this handler through existing queue-runtime rehearse/activate."
 [g id original-class start-context expected-server]
 (let [recipe (handler/recipe! g id original-class)]
  (handler/prepare-instance! g recipe start-context expected-server false)))
