; proc/fence.bl — bounded isolation: turn a child computation into a value.

(ns proc.fence (:require [diagnostics :as diag]))

(defn- norm-opts [opts]
  (if (map? opts)
    {:ms (get opts :ms)
     :kill? (get opts :kill? true)}
    {:ms opts :kill? true}))

(defn fence-fn
  "Run `f` in a monitored child for at most `:ms` milliseconds.

   `opts` may be the timeout number or `{:ms n :kill? bool}`.
   Returns `{:ok value}`, `{:crash reason}`, or `{:timeout true}`. `:kill?`
   defaults true."
  [opts f]
  (let [{:keys [ms kill?]} (norm-opts opts)
        _ (when (or (not (erlang/is_integer ms)) (< ms 0)
                    (not (contains? #{true false} kill?)))
            (throw (ex-info "fence: invalid deadline or kill option" {:kind :invalid-config})))
        start (erlang/monotonic_time :millisecond)
        reply (erlang/alias)
        [pid ref]
          (spawn-monitor
            (fn []
              (erlang/send reply [:fence-ok (erlang/self) (f)])))
        outcome
          (try (receive
            [:fence-ok reply-pid value]
              :when (= reply-pid pid)
              (do (erlang/demonitor ref (list :flush))
                  {:ok value})
            [:DOWN down-ref :process _down-pid reason]
              :when (= down-ref ref)
              (do (erlang/demonitor ref (list :flush))
                  {:crash reason})
            (after ms
              (do (when kill? (erlang/exit pid :kill))
                  (erlang/demonitor ref (list :flush))
                  {:timeout true})))
            (finally
              (erlang/unalias reply)
              (erlang/demonitor ref (list :flush))
              ; Unalias drops future signals; flush the one reply that may have
              ; reached the mailbox between the timeout and deactivation.
              (receive [:fence-ok reply-pid _] :when (= reply-pid pid) nil
                       (after 0 nil))))]
    (diag/emit! :proc.fence/completed
      (merge {:proc.fence/outcome (cond (contains? outcome :ok) :returned
                                       (contains? outcome :crash) :crashed :else :timed-out)
              :proc.fence/duration-ms (- (erlang/monotonic_time :millisecond) start)
              :proc.fence/kill-requested? (and kill? (contains? outcome :timeout))}
             (when (contains? outcome :crash) (diag/safe-error (:crash outcome)))))
    outcome))

(defmacro fence [opts & body]
  `(proc.fence/fence-fn ~opts (fn [] ~@body)))
