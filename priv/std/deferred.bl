; deferred.bl — L7, graduated — P15e: deferred constraints (L7).
;
; The amended invariant: unknown does NOT mean silent-at-once — it means
; DEFERRED. A call to an undefined name is recorded as a constraint
; awaiting that name's definition; when a later namespace in the
; require-DAG provides it, the constraint retries; at DAG end, whatever
; is still deferred stays silent (never a wrong warning).
;
; Demo: file A calls (helper "s") before helper exists anywhere.
;   phase 1: check A alone      → 0 warnings, 1 deferred constraint
;   phase 2: load B (defines ^{:args [int]} helper) → constraint
;            retries → the string arg is now PROVABLY wrong → 1 warning
;   phase 3: a call to (never-defined x) → deferred forever → DAG-end
;            report lists it as silent-unknown, NOT a warning

(ns deferred
  (:require [typed]))

(def deferred (atom []))

(defn check-file-deferring
  "typed/check-source, except 'unknown callee' doesn't just type the
   call any — it records a deferred constraint {ns callee args pos}.
   Returns {:warnings w :deferred d}."
  [src ns]
  ;; typed's warnings are per-call (BUG-041): the return value IS this check's
  ;; slice, no before/after dance over a shared atom.
  (let [forms (BeamLisp.Reader/read_string src)
        unknowns (collect-unknown-calls forms ns)]
    (swap! deferred (fn [d] (concat d unknowns)))
    (let [r (typed/check-source-with src ns (merge typed/core-seeds-v2 typed/host-seeds))]
      {:warnings (:warnings r)
       :deferred (deref deferred)})))

(declare collect-unknown-calls)

(defn collect-unknown-calls
  "Calls whose head is neither a special form, nor core, nor defined in
   ns, nor interop — each is a constraint awaiting a definition."
  [forms ns]
  (let [defined (set (BeamLisp.Env/public_names ns))
        core    (set (BeamLisp.Env/public_names "core"))]
    (reduce
      (fn [acc form]
        (concat acc (unknowns-in form defined core)))
      [] forms)))

(defn- pattern-symbols
  "The symbol leaves of a binding pattern — the names a binder introduces.
   Descends vectors/sets/maps (destructuring); keywords and literals bind
   nothing. A name collected here is simply never flagged as an unknown
   call — which is exactly var-shadowing semantics: a local by that name
   IS what a call resolves to."
  [node]
  (let [f (typed/node-form node)
        tag (typed/node-tag f)]
    (cond
      (= tag :symbol) [(typed/node-name f)]
      (contains? #{:vector :set :map} tag)
        (mapcat pattern-symbols (typed/node-items f))
      :else [])))

(defn- binding-vector-names
  "The local names a binding vector (`let`/`loop`/`doseq`/`for`/`when-let`…)
   introduces: the pattern symbols at EVEN positions — odd positions are the
   value expressions. doseq/for modifiers (`:let`, `:when`) sit on even slots
   as keywords and contribute nothing; a malformed (non-vector) node binds
   nothing rather than crashing the pass."
  [node]
  (let [f (typed/node-form node)]
    (if (not (= :vector (typed/node-tag f)))
      []
      (let [items (typed/node-items f)]
        (loop [i 0 acc []]
          (if (>= i (count items))
            acc
            (recur (+ i 2) (concat acc (pattern-symbols (nth items i))))))))))

(defn- binder-local-names
  "The names a binder form binds for its body, by head:
   let-family — the binding vector; catch — its one binding; fn/defn-family/
   defserver — every params vector in the tail (a bare [params …] for
   single-arity, the first element of each ([params …] body) clause for
   multi-arity and defserver clauses). Body lists that merely START with a
   vector literal contribute their symbols too — harmless: those positions
   hold tag keywords in practice, and over-collecting only ever SUPPRESSES a
   flag on a name a local would shadow anyway."
  [head tail]
  (cond
    (contains? #{"let" "loop" "doseq" "for" "when-let" "if-let"} head)
      (binding-vector-names (first tail))
    (= head "catch")
      (pattern-symbols (first tail))
    :else  ; fn / defn / defn- / defmacro / defmethod / defserver
      (mapcat (fn [it]
                (let [tf (typed/node-form it)
                      tg (typed/node-tag tf)]
                  (cond
                    (= tg :vector) (pattern-symbols it)
                    (= tg :list)
                      (let [sub (typed/node-items tf)]
                        (if (and (> (count sub) 0)
                                 (= :vector (typed/node-tag (typed/node-form (first sub)))))
                          (pattern-symbols (first sub))
                          []))
                    :else [])))
              tail)))

;; heads that bind locals for their body — see binder-local-names
(def ^:private binder-heads
  #{"let" "loop" "doseq" "for" "when-let" "if-let" "catch"
    "fn" "defn" "defn-" "defmacro" "defmethod" "defserver"})

(defn unknowns-in
  "Calls in `node` whose head is unknown: not a special form, not core, not
   in `defined`, not a LOCAL binding, not interop. The locals set is threaded
   through binder forms — without it a call to a let-bound fn (an utterly
   ordinary shape) was collected as an unknown var, and reload's coherence
   pass HELD every edit containing one as a false 'dangling reference'.
   Quoted forms are data, not calls: never descended into."
  ([node defined core] (unknowns-in node defined core #{}))
  ([node defined core locals]
   (let [f (typed/node-form node)
         tag (typed/node-tag f)]
     (cond
       (= tag :list)
         (let [items (typed/node-items f)]
           (if (empty? items)
             []
             (let [head (typed/node-form (first items))
                   h    (if (= :symbol (typed/node-tag head))
                          (typed/node-name head)
                          nil)]
               (cond
                 ;; (quote …) — the content is DATA; there are no calls inside
                 (= h "quote") []
                 ;; binder forms: their names are locals for everything inside
                 (contains? binder-heads h)
                   (let [locals2 (into locals (binder-local-names h (rest items)))]
                     (reduce (fn [a x] (concat a (unknowns-in x defined core locals2)))
                             [] items))
                 ;; special forms: not calls, but their contents may contain some
                 (contains? #{"ns" "def" "if" "do" "when" "cond"
                              "and" "or" "throw" "try" "recur"
                              ; try/receive sub-clauses: their heads are
                              ; syntax, not calls to resolve.
                              "finally" "after" "receive"}
                            h)
                   (reduce (fn [a x] (concat a (unknowns-in x defined core locals)))
                           [] items)
                 ;; a non-symbol head ((f x), (:k m), ([..] …)) — no name to flag
                 (nil? h)
                   (reduce (fn [a x] (concat a (unknowns-in x defined core locals)))
                           [] items)
                 ;; a plain call
                 :else
                   (let [p (typed/node-pos f)
                         mine (if (or (contains? locals h)
                                      (contains? defined h)
                                      (contains? core h)
                                      (some? (index-of h "/")))
                                []
                                [{:callee h
                                  :line (if (nil? p) 0 (:line p))
                                  ; arg types at deferral time — literals are
                                  ; provable, locals are any (sound)
                                  :arg-types (into [] (map (fn [a]
                                                             (typed/walk
                                                               (merge typed/core-sigs
                                                                      typed/core-seeds-v2)
                                                               {} a))
                                                           (rest items)))}])]
                     (concat mine
                             (reduce (fn [a x] (concat a (unknowns-in x defined core locals)))
                                     [] (rest items))))))))
       (contains? #{:vector :set} tag)
         (reduce (fn [a x] (concat a (unknowns-in x defined core locals)))
                 [] (typed/node-items f))
       :else []))))

(defn retry-deferred!
  "A namespace just loaded: every deferred constraint whose callee it
   NOW defines retries against its (possibly annotated) signature.
   Returns the warnings produced."
  [ns]
  (let [ds (deref deferred)
        defined (set (BeamLisp.Env/public_names ns))
        sigs (merge typed/core-sigs typed/core-seeds-v2 typed/host-seeds
                    (typed/sigs-from-env ns))]
    (reduce
      (fn [ws d]
        (if (contains? defined (:callee d))
          (let [sig (get sigs (:callee d) nil)]
            (if (and (some? sig) (some? (:arg-types d)))
              (concat ws
                (filter (fn [x] (not (nil? x)))
                  (map (fn [i declared]
                         (let [actual (get (:arg-types d) i nil)]
                           (if (and (some? actual)
                                    (empty? (typed/t-meet actual declared)))
                             {:msg (str (:callee d) ": argument " (+ i 1)
                                        " was deferred, now provably wrong: "
                                        (pr-str (sort (into [] actual)))
                                        " vs declared "
                                        (pr-str (sort (into [] declared))))
                              :line (:line d)}
                             nil)))
                       (range (count (:args sig)))
                       (:args sig))))
              ws))
          ws))
      [] ds)))

(defn dag-end-report
  "At the end of the require-DAG: what stayed deferred is SILENT
   unknown — listed for the record, never warned."
  []
  (deref deferred))
