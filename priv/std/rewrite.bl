; priv/rewrite.bl — pattern-directed code rewriting: mechanical,
; reviewable source-to-source transformation.
;
; A rewrite is DATA, not a function. A rule is a {pattern, replacement}
; pair; a ruleset is an ordinary collection; rulesets compose with the
; same collection ops as any other list. That is the whole argument for
; doing this in a Lisp — a codemod is a value you can build, share and
; inspect, not a closure you invoke and hope. `apply-rules` never needs
; to know where a rule came from, only that it is a {pattern, replacement}
; map.
;
; Convention: a symbol whose name begins with `?` is a PATTERN VARIABLE
; (`?x`), bound to whatever the corresponding position of the form holds
; and usable in the replacement. A bare `?` is a valid (if throwaway)
; variable that matches any one form. Repeated variables unify: `(?x ?x)`
; matches only when both positions hold equal forms. Real code does not
; contain `?`-named symbols, so the convention cannot collide with the
; forms being rewritten — the reason `?` was chosen over `~`-prefixed
; variables, which clash with syntax-quote's unquote.
;
; A `?*`-prefixed name (`?*clauses`) is a REST pattern variable. It is legal
; only as the LAST element of a list or vector pattern, where it binds the
; REMAINING elements as one seq — `()` at the shortest arity, so an empty
; tail matches — and in a replacement it SPLICES those elements inline
; instead of nesting them. This is the `?` convention EXTENDED, not a second
; convention beside it: the star is the whole difference. A non-final rest
; is refused at declaration (matching it would need backtracking), and the
; same `?*x` twice is refused too (sequence unification is unsupported).
;
; The walk family mirrors clojure.walk, so existing knowledge transfers:
; prewalk applies the fn on the way DOWN a form, postwalk on the way UP.
; Both descend into vectors, maps and sets as well as lists, and rebuild
; each collection as its own kind — a vector stays a vector, a map stays
; a map — which is the property a source rewrite relies on. `walk` itself
; is the split engine: `inner` rebuilds each child, `outer` wraps the
; finished collection.
;
; Rules run to a fixed point: keep taking full postwalk passes until a
; pass changes nothing, or until a bounded iteration cap trips — a pair
; of rules that undo each other must RAISE, not hang. A convergent rule
; set reaches a fixed point in a handful of passes (postwalk rewrites
; children before parents, so one pass can do a whole nesting); the cap
; exists purely so a cycle fails loudly instead of spinning.
(ns rewrite)

(defn walk
  "Rebuild `form` by applying `inner` to each element and `outer` to each
   finished collection. Lists become lists, vectors vectors, maps maps,
   sets sets — a source form keeps its shape. `outer` is what makes a
   rewrite read top-down or bottom-up: postwalk passes `f` here, prewalk
   passes identity and calls `f` before walking instead."
  [inner outer form]
  (cond
    (list? form)
      ; `map` over a proper list returns a lazy seq (beam-lisp's seq fns
      ; are uniformly lazy); force it back to a proper list so the result
      ; keeps list shape and `(list? …)` on the output stays true, exactly
      ; as Clojure's walk rebuilds via `(apply list …)`.
      (outer (doall (map inner form)))
    (seq? form)
      ; a LAZY SEQ (e.g. the result of `for`/`map`) is not `list?`, but it is
      ; a sequential collection whose elements must be walked — without this a
      ; `[:ul (for [x xs] [:li x])]` hiccup tree would walk the vector but skip
      ; every child the `for` produced. Force + rebuild as a proper list so the
      ; shape is stable and re-walkable.
      (outer (doall (map inner form)))
    (vector? form)
      ; `conj` appends to a vector, so folding the walked elements back
      ; into an empty vector preserves vector-ness (walking `[1 2]` must
      ; not turn it into the structurally distinct list `(1 2)`).
      (outer (reduce (fn [v x] (conj v x)) [] (map inner form)))
    (map? form)
      ; A map's elements are its [k v] entries (as `seq` yields); rebuild
      ; by re-assoc'ing the walked entries. An empty map has no entries
      ; to walk and is returned as-is after `outer`.
      (if (empty? form)
        (outer form)
        (outer (reduce (fn [m e] (assoc m (first e) (second e)))
                       {} (map inner (seq form)))))
    (set? form)
      (if (empty? form)
        (outer form)
        (outer (set (map inner (seq form)))))
    :else
      (outer form)))

(defn postwalk
  "Apply `f` to `form` and every subform, innermost first (on the way up).
   A child is rewritten before its parent sees it, so a rule that rewrites
   an inner form can feed its parent's match in the same pass."
  [f form]
  (walk (fn [x] (postwalk f x)) f form))

(defn prewalk
  "Apply `f` to `form` and every subform, outermost first (on the way
   down). The fn sees each form before its children are touched, so a
   transform that restructures a node changes what gets walked beneath it.
   The order difference from postwalk is what the tests prove."
  [f form]
  (walk (fn [x] (prewalk f x)) identity (f form)))

; --- pattern matching ---

(defn pattern-var?
  "True when `s` is a pattern variable — a symbol whose name begins with
   `?`. This is the one convention the whole library rests on; it must
   agree between match? (bind) and subst (splice)."
  [s]
  (and (symbol? s) (String/starts_with? (name s) "?")))

(defn rest-pattern-var?
  "True when `s` is a REST pattern variable — a symbol whose name begins
   with `?*`. It binds the remaining elements of a sequence instead of a
   single one, and is legal only as the LAST element of a list or vector
   pattern (`?*clauses`). The star is the whole distinction from `?x` —
   one convention extended, not a second convention beside it."
  [s]
  (and (symbol? s) (String/starts_with? (name s) "?*")))

(defn check-pattern!
  "Assert `pattern` obeys the rest-pattern rule, throwing a readable error
   otherwise. `?*name` may appear only as the LAST element of a list or
   vector pattern, and only once in a pattern: a non-final rest needs
   backtracking to match, and two rests need sequence unification, neither
   of which this matcher does. `defrule` calls this at expansion, so a
   malformed pattern is refused where it is written rather than silently
   under-matching at use."
  [pattern]
  (cond
    (rest-pattern-var? pattern)
      (throw (ex-info
               "rewrite: a rest pattern (?*name) is only legal as the LAST element of a list or vector pattern"
               {:pattern pattern}))
    (or (list? pattern) (vector? pattern))
      (let [elems (into [] pattern)
            rests (into [] (filter rest-pattern-var? elems))
            last? (and (> (count elems) 0)
                       (rest-pattern-var? (get elems (dec (count elems)))))]
        (when (> (count rests) 1)
          (throw (ex-info
                   "rewrite: a rest pattern (?*name) may appear only once in a pattern — sequence unification is deliberately unsupported"
                   {:pattern pattern})))
        (when (and (= 1 (count rests)) (not last?))
          (throw (ex-info
                   "rewrite: a rest pattern (?*name) must be the LAST element of its list or vector pattern — a non-final rest cannot be matched without backtracking"
                   {:pattern pattern})))
        (doseq [e elems]
          (when-not (rest-pattern-var? e) (check-pattern! e))))
    (map? pattern)
      (doseq [e (seq pattern)]
        (check-pattern! (key e))
        (check-pattern! (val e)))
    :else nil))

(defn match-seq
  "Match a list or vector `pattern` against a same-kind `form`. With no
   rest variable the arities must be EQUAL — the original exact-match
   contract, unchanged. With a trailing `?*name` the pattern's earlier
   elements match a prefix and `?*name` binds the REMAINING elements as a
   proper list — `()`, not nil, when the form is exactly as long as the
   fixed prefix, so an empty tail matches. A rest that is not last, or a
   rest variable seen twice, raises rather than silently matching one
   element: a malformed pattern must not produce a plausible-but-wrong
   rewrite."
  [pattern form binds]
  (loop [pattern pattern form form binds binds]
    (if (empty? pattern)
      ; exact arity: a longer form is a mismatch, never a prefix match.
      (if (empty? form) binds nil)
      (let [p (first pattern)]
        (cond
          (rest-pattern-var? p)
            (if (empty? (rest pattern))
              (if (contains? binds p)
                (throw (ex-info
                         "rewrite: a rest pattern (?*name) may appear only once in a pattern — sequence unification is deliberately unsupported"
                         {:rest-var p}))
                (assoc binds p (doall form)))
              (throw (ex-info
                       "rewrite: a rest pattern (?*name) must be the LAST element of its list or vector pattern — a non-final rest cannot be matched without backtracking"
                       {:pattern pattern :rest-var p})))
          (empty? form) nil
          :else
            (let [b (match* p (first form) binds)]
              (if (some? b)
                (recur (rest pattern) (rest form) b)
                nil)))))))

(defn match-map
  "Match a map pattern against a map form: every pattern key must be
   present in the form and its pattern value must match the form's value.
   Equal counts (enforced up front) plus per-key presence means a pattern
   can neither skip a key nor conjure a missing one."
  [pattern form binds]
  (if (not= (count pattern) (count form))
    nil
    (loop [entries (seq pattern) binds binds]
      (if (empty? entries)
        binds
        (let [e (first entries)
              k (key e)
              v (val e)]
          (if (contains? form k)
            (let [b (match* v (get form k) binds)]
              (if (some? b)
                (recur (rest entries) b)
                nil))
            nil))))))

(defn match*
  "Core matcher: bind `pattern` against `form`, extending `binds`.
   Structure must agree — a vector pattern only matches a vector form, a
   list pattern only a list — so a rewrite never silently coerces shapes."
  [pattern form binds]
  (cond
    ; A bare rest variable is not a sequence tail — it has nothing to bind
    ; the remainder OF. Refuse it rather than let it match one element. This
    ; MUST precede the pattern-var? branch: `?*x` also starts with `?`.
    (rest-pattern-var? pattern)
      (throw (ex-info
               "rewrite: a rest pattern (?*name) is only legal as the LAST element of a list or vector pattern"
               {:rest-var pattern}))
    ; A variable: first occurrence binds; a repeated occurrence must
    ; equal the first binding (the `(?x ?x)` rule, decided: unify).
    (pattern-var? pattern)
      (if (contains? binds pattern)
        (if (= (get binds pattern) form) binds nil)
        (assoc binds pattern form))
    (list? pattern)
      (if (list? form) (match-seq pattern form binds) nil)
    (vector? pattern)
      (if (vector? form) (match-seq pattern form binds) nil)
    (map? pattern)
      (if (map? form)
        (match-map pattern form binds)
        nil)
    ; Anything else is a literal: it matches only an equal form.
    :else
      (if (= pattern form) binds nil)))

(defn match?
  "Match a form against a pattern. Returns the bindings map (possibly
   empty) on a match, or nil on no match. A pattern variable is any
   symbol whose name starts with `?`."
  [pattern form]
  (match* pattern form {}))

(defn splice
  "One element of a replacement template. A bound REST variable splices its
   elements inline (zero or more); anything else substitutes to exactly one
   element. An unbound rest variable is left alone, like any other unbound
   variable."
  [binds x]
  (if (and (rest-pattern-var? x) (contains? binds x))
    (get binds x)
    (list (subst* binds x))))

(defn subst*
  "Splice `binds` into a pattern, replacing each `?`-variable with its
   bound form and rebuilding collections in place. Unbound variables are
   left alone (a variable in the replacement that never appeared in the
   pattern is an authoring error worth keeping visible, not hiding)."
  [binds form]
  (cond
    (rest-pattern-var? form)
      (if (contains? binds form) (get binds form) form)
    (pattern-var? form)
      (if (contains? binds form) (get binds form) form)
    (list? form)
      ; mapcat: a bound rest variable SPLICES its elements in place of
      ; itself (zero or more), every other element substitutes to exactly
      ; one; the lazy result is forced back to a proper list so list shape
      ; survives to the caller (and to a subsequent match's `list?`).
      (doall (mapcat (fn [x] (splice binds x)) form))
    (vector? form)
      (reduce (fn [v x] (conj v x)) [] (mapcat (fn [x] (splice binds x)) form))
    (map? form)
      (reduce (fn [m e]
                (assoc m (subst* binds (key e)) (subst* binds (val e))))
              {} (seq form))
    (set? form)
      (set (map (fn [x] (subst* binds x)) (seq form)))
    :else
      form))

(defn subst
  "Substitute a bindings map into a pattern, returning the instantiated
   form. `(subst {'?x 5} '(+ ?x ?x))` is `(+ 5 5)`."
  [binds pattern]
  (subst* binds pattern))

; --- rules ---

; A rule is data: a map with `:pattern` and `:replacement` keys. `defrule`
; is only sugar for naming such a map; the value it binds is a plain
; collection a caller can store, pass around, or combine with others.
(defmacro defrule
  "Bind `name` to a {pattern, replacement} rule. Both arguments are data
   (quoted for you), so `(defrule nil-eq (= ?x nil) (nil? ?x))` binds a
   rule that rewrites any `(= x nil)` into `(nil? x)`."
  [name pattern replacement]
  ; Validate at EXPANSION so a malformed rest pattern is refused where it is
  ; written, not at the first form it happens to be tried against.
  (check-pattern! pattern)
  `(def ~name {:pattern '~pattern :replacement '~replacement}))

(defn try-rules
  "Apply the first rule in `rules` whose pattern matches `form`, returning
   the substituted replacement, or `form` unchanged if none match. First
   match wins; a ruleset is tried in order, so earlier rules take
   precedence over later ones."
  [rules form]
  (loop [rules rules]
    (if (empty? rules)
      form
      (let [rule (first rules)
            binds (match? (get rule :pattern nil) form)]
        (if (some? binds)
          (subst binds (get rule :replacement nil))
          (recur (rest rules)))))))

(defn apply-rules
  "Rewrite `form` by running `rules` over every node, to a fixed point.
   Each iteration is one full postwalk pass (children before parents);
   when a pass changes nothing the result is returned. If the form is
   still changing after `cap` passes the ruleset is cycling — two rules
   undoing each other, say — and an error is raised rather than hanging.
   `rules` is an ordinary collection of {pattern, replacement} maps."
  ([rules form] (apply-rules rules form 1000))
  ([rules form cap]
   (let [step (fn [x] (try-rules rules x))]
     (loop [form form passes 0]
       (let [next (postwalk step form)]
         (if (= next form)
           form
           (if (>= passes cap)
             (throw (ex-info
                      "rewrite did not reach a fixed point within the iteration cap — the rules appear to cycle (two rules undoing each other?)"
                      {:non-terminating true :passes passes :cap cap}))
             (recur next (inc passes)))))))))

(defn apply-rule
  "Rewrite `form` by a single rule, to a fixed point. Sugar over
   `apply-rules` with a one-rule ruleset."
  ([rule form] (apply-rules (list rule) form))
  ([rule form cap] (apply-rules (list rule) form cap)))
