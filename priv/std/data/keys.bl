(ns data.keys (:require [data.first-order :as data]))

(defn- existing [text]
 ;; A JSON property must not manufacture a native struct header.
 (if (= "__struct__" text) text
  (try (erlang/binary_to_existing_atom text :utf8) (catch _ text))))

(defn keywordize-existing
 "Recursively convert string map keys only when their VM atom already exists.
  Unknown keys remain strings; request/model/provider data never interns atoms.
  Check bounded plain data before any collection/protocol traversal."
 ([value] (keywordize-existing value {}))
 ([value limits]
  (data/check! value limits)
  (letfn [(walk [v]
            (cond
             (map? v) (reduce (fn [out [k x]]
                               (let [normalized (if (string? k) (existing k) k)]
                                (when (contains? out normalized)
                                 (throw (ex-info "Keyword normalization would collapse distinct keys"
                                          {:kind :keyword-key-collision})))
                                (assoc out normalized (walk x)))) {} v)
             (vector? v) (with-meta (mapv walk v) (walk (meta v)))
             (list? v) (apply list (map walk v))
             (set? v) (into #{} (map walk v))
             :else v))]
    (data/check! (walk value) limits))))
