; Source admission treats templates as data and checks only evaluated unquotes.
; The original form still compiles once; this projection grants no execution.
(ns reload.macro-source (:require [reader-node :as rn]))

(defn- children [node]
 (let [n (rn/node-form node)]
  (case (rn/node-tag n)
   :list (rn/node-items n) :vector (rn/node-items n) :set (rn/node-items n)
   :map (mapcat (fn [pair] [(elem pair 0) (elem pair 1)]) (rn/node-items n)) [])))
(defn- head [node]
 (when (= :list (rn/node-tag (rn/node-form node)))
  (let [first-node (rn/node-form (first (children node)))]
   (when (= :symbol (rn/node-tag first-node)) (rn/node-name first-node)))))

(declare mask)
(defn- unquotes [node depth]
 (let [call (head node)]
  (cond
   (= "syntax-quote" call) (mapcat #(unquotes % (inc depth)) (rest (children node)))
   (contains? #{"unquote" "unquote-splicing"} call)
    (if (= depth 1) (map mask (rest (children node)))
     (mapcat #(unquotes % (dec depth)) (rest (children node))))
   :else (mapcat #(unquotes % depth) (children node)))))

(defn- mask [node]
 (let [n (rn/node-form node) tag (rn/node-tag n)]
  (cond
   (= "quote" (head node)) node
   (= "syntax-quote" (head node))
    (rn/list-node (cons (rn/sym-node "do") (mapcat #(unquotes % 1) (rest (children node)))))
   (contains? #{:list :vector :set} tag)
    (rn/->tuple (list tag (to-list (map mask (rn/node-items n)))))
   (= :map tag)
    (rn/->tuple (list :map (to-list (map (fn [pair] (tuple (mask (elem pair 0)) (mask (elem pair 1))))
                                          (rn/node-items n)))))
   :else node)))

(defn executable-form [form]
 (if (= "defmacro" (head form)) (mask form) form))
