; Source admission treats templates as data and checks only evaluated unquotes.
; The original form still compiles once; this projection grants no execution.
(ns reload.macro-source (:require [reader-node :as rn]))

(defn- children [node]
 (let [n (rn/node-form node)]
  (case (rn/node-tag n)
   :list (rn/node-items n) :vector (rn/node-items n) :set (rn/node-items n)
   :map (Enum/flat_map (rn/node-items n) (fn [pair] [(elem pair 0) (elem pair 1)])) [])))
(defn- head [node]
 (when (= :list (rn/node-tag (rn/node-form node)))
  (let [first-node (rn/node-form (first (children node)))]
   (when (= :symbol (rn/node-tag first-node)) (rn/node-name first-node)))))

(declare mask)
(defn- unquotes [node depth]
 (let [call (head node)]
  (cond
   (= "syntax-quote" call) (Enum/flat_map (rest (children node)) #(unquotes % (inc depth)))
   (contains? #{"unquote" "unquote-splicing"} call)
    (if (= depth 1) (Enum/map (rest (children node)) mask)
     (Enum/flat_map (rest (children node)) #(unquotes % (dec depth))))
   :else (Enum/flat_map (children node) #(unquotes % depth)))))

(defn- mask [node]
 (let [n (rn/node-form node) tag (rn/node-tag n)]
  (cond
   (= "quote" (head node)) node
   (= "syntax-quote" (head node))
    ;; Reader-node children are proper finite lists. A lazy tail here creates
    ;; an improper cons that native AST consumers cannot traverse safely.
    (rn/list-node (cons (rn/sym-node "do")
                       (Enum/flat_map (rest (children node)) #(unquotes % 1))))
   (contains? #{:list :vector :set} tag)
    (rn/->tuple (list tag (Enum/map (rn/node-items n) mask)))
   (= :map tag)
    (rn/->tuple (list :map (Enum/map (rn/node-items n)
                              (fn [pair] (tuple (mask (elem pair 0)) (mask (elem pair 1)))))))
   :else node)))

(defn executable-form [form]
 (if (= "defmacro" (head form)) (mask form) form))
