; Pure schema for release-owned callback registries. No lookup or evaluation.
(ns reload.registry-data)

(defn- refuse [] (throw (ex-info "Invalid immutable registry declaration" {:kind :invalid-registry-declaration})))
(defn field [m k default]
 (when (and (contains? m k) (contains? m (name k))) (refuse))
 (get m k (get m (name k) default)))
(defn token [value]
 (cond (string? value) value (keyword? value) (subs (pr-str value) 1) :else (refuse)))
(defn field-key [key]
 (if (keyword? key) key
  (try (erlang/binary_to_existing_atom key :utf8)
   (catch _ (throw (ex-info "Registry field is not declared by application code"
                    {:kind :unknown-registry-field}))))))
(defn- data? [value]
 (loop [todo [[value 0]] left 10000]
  (if (empty? todo) true
   (let [[v depth] (first todo)]
    (cond
     (or (neg? left) (> depth 32) (fn? v)) false
     (or (nil? v) (boolean? v) (number? v) (string? v) (keyword? v))
      (recur (rest todo) (dec left))
     (or (map? v) (vector? v) (list? v) (set? v))
      (let [items (if (map? v) (mapcat (fn [[k x]] [k x]) v) v)]
       (and (<= (count items) left)
            (recur (concat (map (fn [x] [x (inc depth)]) items) (rest todo)) (dec left))))
     :else false)))))

(defn entry
 "Normalize finite data and qualified callback names. Callable values/handles
  are refused; no borrowed closure can survive publication in this registry."
 [id value]
 (when-not (and (map? value) (data? value) (<= (count value) 64)
                (<= (erlang/external_size value) 65536)
                (Regex/match? #"^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$" (token id))
                (= (token id) (token (field value :id id)))) (refuse))
 (let [callbacks (field value :callbacks {})]
  (when-not (and (map? callbacks) (<= (count callbacks) 32)) (refuse))
  (let [normalized (into {} (map (fn [[key reference]]
                      (let [key (token key)]
                       (when-not (and (Regex/match? #"^[a-zA-Z][a-zA-Z0-9_!?-]{0,63}$" key)
                                      (not (contains? #{"id" "callbacks"} key))
                                      (string? reference) (<= (erlang/byte_size reference) 256)
                                      (Regex/match? #"^[a-zA-Z][a-zA-Z0-9_.-]*/[a-zA-Z_][a-zA-Z0-9_!?*-]*$" reference)) (refuse))
                       [key reference])) callbacks))
        data (dissoc value :callbacks "callbacks")]
   (when (or (not= (count normalized) (count callbacks))
             (not= (count data) (count (set (map token (keys data)))))
             (some #(contains? normalized (token %)) (keys data))) (refuse))
   {:data data :callbacks normalized})))

(defn registries [resources]
 (let [config (field resources :configuration {}) value (field config :registries {})]
  (when-not (and (map? value) (<= (count value) 64)) (refuse))
  (let [result (into {} (map (fn [[registry entries]]
                      (let [registry (token registry)]
                       (when-not (and (Regex/match? #"^[a-zA-Z][a-zA-Z0-9_.-]{0,127}$" registry)
                                      (map? entries) (<= (count entries) 256)) (refuse))
                       (let [normalized (into {} (map (fn [[id value]] [(token id) (entry id value)]) entries))]
                        (when-not (= (count normalized) (count entries)) (refuse))
                        [registry normalized]))) value))]
   (when-not (= (count result) (count value)) (refuse)) result)))

(defn references [registries]
 (vec (sort (set (mapcat (fn [[_ entries]] (mapcat (fn [[_ e]] (vals (:callbacks e))) entries)) registries)))))

(defn roots [registries] (vec (sort (set (map #(first (String/split % "/")) (references registries))))))

(defn check-fields! [registries]
 (doseq [[_ entries] registries [_ e] entries key (concat (keys (:data e)) (keys (:callbacks e)))]
  (field-key key)) :valid)
