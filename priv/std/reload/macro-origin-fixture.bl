(ns reload.macro-origin-fixture (:require [reload.preinit-counter :as counter]))
(def initialization (counter/mark! :lambda-origin-init))
(defmacro pass [x] x)
(defmacro privileged [x] (do (counter/mark! :macro-ran) x))
(def saved-macro privileged)
(def nested-macro {:saved [saved-macro]})
(def public-local (let [offset 3] (fn [x] (+ x offset))))
(def ^:private private-local (let [offset 4] (fn [x] (+ x offset))))
(def captured-macro (let [macro (erlang/element 2 saved-macro)] (fn [x] (macro nil {} x))))
(defn callback [] private-local)
(defn macro-value [] nested-macro)
(defn captured [] captured-macro)
(defn init-count [] (counter/value :lambda-origin-init))
(defn macro-count [] (counter/value :macro-ran))
