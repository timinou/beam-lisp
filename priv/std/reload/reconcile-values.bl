; Fixed SDK residual value operations. This module grants no execution/custody.
(ns reload.reconcile-values (:require [data.first-order :as data]))
(defn data!
 "Bounded raw runtime validation of a sealed first-order global value. A later
  mutable var cannot substitute an opaque/protocol/callable eager operand."
 [value]
 (data/check! value {:max-nodes 32768 :max-depth 64 :max-bytes 1048576}) value)
(defn every-first-order!
 "Validate the complete finite source before normal Source predicate invocation.
  Never seq a lazy/foreign/protocol object to discover whether it is data. The
  compiler separately proves the exact first-order predicate body without run."
 [predicate values]
 (data/check! values {:max-nodes 32768 :max-depth 64 :max-bytes 1048576})
 (when-not (or (nil? values) (erlang/is_list values)
               (and (erlang/is_map values) (= :Elixir.BeamLisp.Vector (maps/get :__struct__ values nil))))
  (throw (ex-info "Finite reconciliation predicate source required"
           {:kind :unproved-reconcile-recipe :reason :non-finite-predicate-source})))
 (every? predicate values))

(defn operand!
 "Fixed residual raw operand unwrap. Snapshot extraction never invokes a user
  Lookup or fails an unselected branch: an unsupported container is refused
  only when the actual residual control flow reaches this exact sealed leaf.
  This is a value operation, never a Conn/G/SDK custody or writer grant."
 [snapshot id]
 (when-not (and (erlang/is_map snapshot) (not (maps/is_key :__struct__ snapshot)) (keyword? id))
  (throw (ex-info "Raw reconciliation snapshot required"
           {:kind :unproved-reconcile-recipe :reason :unsealed-snapshot-operand})))
 (let [entry (maps/get id snapshot nil)]
  (when-not (and (erlang/is_map entry) (not (maps/is_key :__struct__ entry)))
   (throw (ex-info "Sealed reconciliation operand required"
            {:kind :unproved-reconcile-recipe :reason :unsealed-snapshot-operand})))
  (case (maps/get :state entry nil)
   :value (if (= #{:state :value} (set (keys entry))) (maps/get :value entry)
            (throw (ex-info "Invalid reconciliation operand"
                     {:kind :unproved-reconcile-recipe :reason :unsealed-snapshot-operand})))
   :missing (if (= #{:state} (set (keys entry))) nil
              (throw (ex-info "Invalid reconciliation operand"
                       {:kind :unproved-reconcile-recipe :reason :unsealed-snapshot-operand})))
   :invalid (throw (ex-info "Unsupported selected reconciliation container"
                    {:kind :unproved-reconcile-recipe :reason :unsupported-snapshot-container}))
   (throw (ex-info "Invalid reconciliation operand"
            {:kind :unproved-reconcile-recipe :reason :unsealed-snapshot-operand})))))
