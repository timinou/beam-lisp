; Source-only HOME candidate. The native compiler/Env floor is prerequisite.
(ns reload.server-entry)
(def ^:private callbacks #{:init :handle_call :handle_cast :handle_info :handle_continue :terminate})
(defn- wrapper? [node]
 (and (= :remote (:op node)) (= :Elixir.BeamLisp.Env (:mod node))
      (= :with_server_execution! (:fun node))))
(defn- native-body [module fname node]
 (let [args (:args node) target (first args) kind (second args) action (nth args 2 nil)
       clauses (:clauses action) clause (first clauses)]
  (when-not (and (= 3 (count args)) (= :lit (:op kind)) (= fname (:val kind)) (= :lit (:op target)) (= module (:val target))
                (= :fn (:op action)) (= 1 (count clauses))
                (empty? (:pats clause)) (nil? (:guard clause))
                (map? (:body clause)))
   (throw (ex-info "Generated callback entry refused" {:kind :invalid-server-execution-descriptor})))
  (:body clause)))
(defn body
 "Unwrap only the exact outer compiler callback entry of this actual class.
  The caller must still inspect the returned body with ordinary ANF policy.
  Nested/borrowed/malformed wrappers remain forbidden native Env operations."
 [module clause]
 (let [node (:body clause) fname (:fname clause)]
  (if-not (contains? callbacks fname) node
   (cond
    (wrapper? node) (native-body module fname node)
    ;; The sole native bind_init prelude remains outside the user init extent.
    ;; Keep the complete prelude for the caller's ordinary checker.
    (and (= :init fname) (= :let (:op node))
         (= :remote (:op (:init node))) (= :Elixir.BeamLisp.Server (:mod (:init node)))
         (= :bind_init (:fun (:init node))) (= 1 (count (:args (:init node))))
         (wrapper? (:body node)))
    (assoc node :body (native-body module fname (:body node)))
    (and (= :init fname) (= :do (:op node)) (= 2 (count (:stmts node)))
         (= :remote (:op (first (:stmts node))))
         (= :Elixir.BeamLisp.Server (:mod (first (:stmts node))))
         (= :bind_init (:fun (first (:stmts node))))
         (= 1 (count (:args (first (:stmts node)))))
         (wrapper? (second (:stmts node))))
    (assoc node :stmts (list (first (:stmts node))
                            (native-body module fname (second (:stmts node)))))
    :else node))))
