; Source-only HOME candidate. The native compiler/Env floor is prerequisite.
(ns reload.server-entry (:require [system.ir :as ir]))
(def ^:private callbacks #{:init :handle_call :handle_cast :handle_info :handle_continue :terminate})
(defn- wrapper? [node]
 (and (= :remote (:op node)) (= :Elixir.BeamLisp.Env (:mod node))
      (= :with_server_execution! (:fun node))))
(defn- native-body [module fname node]
 (let [args (:args node) target (first args) kind (second args) action (nth args 2 nil)
       clauses (:clauses action) clause (first clauses)]
  (when-not (and (= 3 (count args)) (= :lit (:op kind)) (= fname (:val kind)) (= :lit (:op target)) (= module (:val target))
                (= :fn (:op action)) (= 1 (count clauses))
                (empty? (:pats clause)) (nil? (:guard clause))
                (map? (:body clause)))
   (throw (ex-info "Generated callback entry refused" {:kind :invalid-server-execution-descriptor})))
  (:body clause)))
(defn body
 "Unwrap only the exact outer compiler callback entry of this actual class.
  The caller must still inspect the returned body with ordinary ANF policy.
  Nested/borrowed/malformed wrappers remain forbidden native Env operations."
 [module clause]
 (let [node (:body clause) fname (:fname clause)]
  (if-not (contains? callbacks fname) node
   (cond
    (wrapper? node) (native-body module fname node)
    ;; The sole native bind_init prelude remains outside the user init extent.
    ;; Keep the complete prelude for the caller's ordinary checker.
    (and (= :init fname) (= :let (:op node))
         (= :remote (:op (:init node))) (= :Elixir.BeamLisp.Server (:mod (:init node)))
         (= :bind_init (:fun (:init node))) (= 1 (count (:args (:init node))))
         (wrapper? (:body node)))
    (assoc node :body (native-body module fname (:body node)))
    (and (= :init fname) (= :do (:op node)) (= 2 (count (:stmts node)))
         (= :remote (:op (first (:stmts node))))
         (= :Elixir.BeamLisp.Server (:mod (first (:stmts node))))
         (= :bind_init (:fun (first (:stmts node))))
         (= 1 (count (:args (first (:stmts node)))))
         (wrapper? (second (:stmts node))))
    (assoc node :stmts (list (first (:stmts node))
                            (native-body module fname (second (:stmts node)))))
    :else node))))

(defn validation-body
 "Static checker projection only. Strip the exact compiler init prelude after
  matching its incoming parameter; every nested/user bind_init stays visible.
  This never changes or executes the compiled actor descriptor."
 [module clause]
 (let [node (body module clause) params (:params clause)
       incoming (first params)
       bind? (fn [candidate]
        (and (= :init (:fname clause)) (= 1 (count params))
             (= :pvar (:pop incoming)) (nil? (:guard clause))
             (= :remote (:op candidate)) (= :Elixir.BeamLisp.Server (:mod candidate))
             (= :bind_init (:fun candidate)) (= 1 (count (:args candidate)))
             (= :var (:op (first (:args candidate))))
             (= (:name incoming) (:name (first (:args candidate))))))
       inert {:op :lit :val nil :ann {}}]
  (cond
   (and (= :let (:op node)) (bind? (:init node))) (assoc node :init inert)
   (and (= :do (:op node)) (= 2 (count (:stmts node))) (bind? (first (:stmts node))))
    (assoc node :stmts (list inert (second (:stmts node))))
   :else node)))

(defn input-key
 "Exact compiler clause identity, including literal data. Not a hash hint."
 [clause]
 (list (:fname clause) (:params clause) (:guard clause)))
(defn input-names [clause]
 (vec (Enum/sort (Enum/uniq
       (to-list (remove #(= "_" %) (ir/clause-pattern-vars {:pats (:params clause)})))))))
(defn input-body
 "Strip ONLY the exact compiler input guard inside the accepted native entry.
  No user/nested checker call is exempted. Old compilers return enforced=false."
 [module clause]
 (let [node (validation-body module clause) first-node (first (:stmts node))
       names (input-names clause)
       expected {:op :remote :mod :Elixir.BeamLisp.Env :fun :check_server_inputs!
                 :args (list {:op :lit :val module :ann {}}
                             {:op :lit :val (input-key clause) :ann {}}
                             {:op :map :pairs (to-list (mapv (fn [name]
                                      (list {:op :lit :val name :ann {}}
                                            {:op :var :name name :ann {}})) names)) :ann {}})
                 :ann {}}
       guard {:op :if
              :test {:op :remote :mod :erlang :fun :==
                     :args (list {:op :remote :mod :Elixir.Process :fun :get
                                  :args (list {:op :lit :val :bl_generation :ann {}}) :ann {}}
                                 {:op :lit :val nil :ann {}}) :ann {}}
              :then {:op :lit :val :ok :ann {}} :else expected :ann {}}]
  (if (and (contains? #{:handle_call :handle_cast :handle_info :handle_continue} (:fname clause))
           (= :do (:op node)) (= 2 (count (:stmts node))) (= guard first-node))
   {:body (second (:stmts node)) :enforced true
    ;; Retain the exact literal carried by the compiler entry. Descriptor
    ;; canonicalization may represent IR field pairs as lists while the literal
    ;; keeps vectors; language equality validates the same pattern, but a native
    ;; map key must preserve the emitted representation byte for byte.
    :key (:val (second (:args (:else first-node))))}
   {:body node :enforced false})))
