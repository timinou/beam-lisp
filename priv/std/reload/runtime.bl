; Shared image reload policy and immutable-generation publication markers.
; This leaf owns the cells once; reload exposes exact aliases for compatibility.
; No evolution, queue, type analysis, compilation or initializer dependency.
(ns reload.runtime (:require [vm.image :as image]))

(def live-generations (atom {}))
(def policy-override (atom nil))

(defn set-enabled!
  "Force the reload mutation policy on (`true`) or off (`false`), overriding the
   environment decision; `nil` restores environment-based detection. Returns the
   new override value."
  [v]
  (reset! policy-override v))

(defn reload-enabled?
  "Whether MUTATING reloads (commit) are permitted in this image. An explicit
   `set-enabled!` override wins; otherwise a development image is yes, and a
   packaged one (a drop or an assembled release) is no unless BEAM_LISP_RELOAD is
   set — opt-in, bounded. BEAM_LISP_DEV forces the development answer, which is
   how a tree declares itself: `:env` in its env.bl is put into the real
   environment before a command runs."
  []
  (let [o (deref policy-override)
        env (contains? #{"1" "true"} (System/get_env "BEAM_LISP_RELOAD"))]
    (if (not (nil? o))
      o
      (or env (image/mutable?)))))

(def commit-target-key :reload/commit-target)

(defn commit-target
  "The env a commit makes live in THIS process — `:global` unless rebound by
   `with-target`. The injectable sink that makes reload isolatable."
  []
  (let [t (erlang/get commit-target-key)]
    (if (= t :undefined) :global t)))

(defn with-target
  "Run `thunk` with the commit target bound to `env` for its dynamic extent, then
   restore the previous target. A test (or ward) binds the target to its own fork
   so a commit lands there, never in the shared `:global` image."
  [env thunk]
  (let [prev (erlang/get commit-target-key)]
    (erlang/put commit-target-key env)
    (try (thunk)
         (finally
           (if (= prev :undefined)
             (erlang/erase commit-target-key)
             (erlang/put commit-target-key prev))))))
