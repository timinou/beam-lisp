; Genuine SDK component controls. No table/lease/G/resource is fabricated.
(ns reload.inert-reduced-fixture)
(defn growing [reducer n]
 ;; Input production is Native SDK work. Source sees scalar n and its own
 ;; reducer. This isolates the live reduced? gate from outer large-arg policy.
 (reduce reducer [] (lists/seq 0 (dec n))))
(defn one-step [reducer] (reduce reducer [] [0]))
(defn observe-predicate [calls value] (swap! calls inc) false)
(defn summarize [value]
 ;; Native-only caller in tests/benchmark. Inspect no callable/capability value.
 (loop [current value depth 0 total 0]
  (if (and (vector? current) (= 2 (count current)))
   (let [item (nth current 1)]
    (recur (nth current 0) (inc depth) (+ total item)))
   {:depth depth :sum total :empty-leaf (= [] current)})))
(defn benchmark-growing [reducer n]
 (let [input (lists/seq 0 (dec n))
       domain (BeamLisp.Env/source_execution_active?)
       before (elem (erlang/process_info (erlang/self) :reductions) 1)
       start (erlang/monotonic_time :microsecond)
       result (reduce reducer [] input)
       elapsed (- (erlang/monotonic_time :microsecond) start)
       after (elem (erlang/process_info (erlang/self) :reductions) 1)]
  (assoc (summarize result) :size n :source-active domain
    :elapsed-us elapsed :reductions (- after before))))
