; An upper bound over the same actual ANF accepted by syntax-constructor.
; No candidate code executes to measure its cost. Shared subtrees count each
; occurrence in the expanded syntax, and splice charges its copied input.
(ns reload.syntax-size (:require [system.ir :as ir]))

(def INPUT-NODES 8192)
(def OUTPUT-NODES 65536)
(defn- refuse! []
 (throw (ex-info "Syntax constructor exceeds its finite allocation bound"
                 {:kind :unproved-syntax-constructor :detail :allocation-bound})))

(defn- data-size [value budget depth]
 (when (or (> depth 64) (neg? (swap! budget dec))) (refuse!))
 (let [children (cond (tuple? value) (erlang/tuple_to_list value)
                      (or (erlang/is_list value) (vector? value)) value
                      (set? value) (BeamLisp.Set/to_list value)
                      (map? value) (mapcat (fn [[k v]] (list k v)) value) :else [])]
  (reduce (fn [size child]
            (let [next (+ size (data-size child budget (inc depth)))]
             (when (> next OUTPUT-NODES) (refuse!)) next)) 1 children)))

(defn check!
 "Conservative upper bounds for first-order constructor IR. Each parameter
  may contain INPUT-NODES nodes; the guarded caller checks that precondition.
  Both expanded output and cumulative constructor/consumer work are bounded.
  This is an allocation/work model, not a measured microsecond deadline."
 [expression parameters]
 (let [steps (atom 8192) allocation (atom 0)]
  (letfn [(charge! [n]
            (when (> (swap! allocation + n) OUTPUT-NODES) (refuse!)))
          (bounded [n]
            (when (> n OUTPUT-NODES) (refuse!)) n)
          (walk [node locals depth]
            (when (or (> depth 64) (neg? (swap! steps dec))) (refuse!))
            (case (:op node)
             :lit (data-size (:val node) (atom INPUT-NODES) depth)
             :enil 1
             :var (or (get locals (:name node)) (refuse!))
             :let (let [size (walk (:init node) locals (inc depth))]
                    (walk (:body node) (assoc locals (:name node) size) (inc depth)))
             :if (do (walk (:test node) locals (inc depth))
                     (max (walk (:then node) locals (inc depth)) (walk (:else node) locals (inc depth))))
             :do (or (last (mapv #(walk % locals (inc depth)) (:stmts node))) 1)
             :remote
              (let [sizes (mapv #(walk % locals (inc depth)) (:args node))
                    total (reduce + 0 sizes) target [(:mod node) (:fun node) (count sizes)]]
               ;; Tests/get/hash may traverse an argument. Charge every input
               ;; conservatively, even when the implementation is O(1).
               (charge! total)
               (bounded
                (cond
                 (= target [:Elixir.BeamLisp.Ns.Rt :splice 2]) (inc total)
                 (= target [:Elixir.BeamLisp.Vector :new 1]) (inc total)
                 (= target [:Elixir.BeamLisp.Ns.Core :list__bl_v 1]) (first sizes)
                 (contains? #{[:Elixir.BeamLisp.Ns.Rt :get 2] [:Elixir.BeamLisp.Ns.Rt :get 3]
                              [:Elixir.BeamLisp.Ns.Rt :hash_key 1]} target) (reduce max 1 sizes)
                 :else 1)))
             (if (contains? #{:cons :tuple :map :struct} (:op node))
              (let [children (ir/child-nodes node)
                    size (reduce (fn [sum child] (bounded (+ sum (walk child locals (inc depth))))) 1 children)]
               (charge! (inc (count children))) size)
              (refuse!))))]
   (let [size (walk expression (into {} (map (fn [name] [name INPUT-NODES]) parameters)) 0)]
    {:size size :allocation @allocation :steps (- 8192 @steps)}))))
