; Actual SDK lookup fixture; one ordinary memo counter records forbidden
; per-env initializer execution. No initializer runs during compile-only stage.
(ns reload.public-binding-fixture
 (:require [reload.unready-public-map :as pending-public]
           [reload.unready-private-map :as pending-private]))
(def ^:private initializer-count (atom 0))
(defn- private-step [x] (+ x 100))
(defn public-step [x] (+ x 2))
(def ^{:private true :per-env true} private-per-env
 (do (swap! initializer-count inc) private-step))
(defn count-initializers [] @initializer-count)
(defn fetch-member [namespace binding] (BeamLisp.Env/source_public_fetch namespace binding))

; These genuine SDK body imports cause compile-only closure staging while the
; ordinary alias requirements remain deferred. Neither target initializer runs.
(defn unused-public [f xs] (pending-public/map f xs))
(defn unused-private-anchor [] (pending-private/anchor))
