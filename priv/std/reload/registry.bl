; Callback registries are immutable release data, not process-global closures.
(ns reload.registry
 (:require [reload.registry-data :as data] [reload.generation :as generation] [reload.state :as state]))

(defn- legacy [registry] (state/cell! (tuple :reload.registry registry) {}))
(defn register!
 "Development registration of data and :callbacks namespace/function names.
  Managed applications declare configuration.registries in the candidate release;
  an old serving generation cannot mutate a new candidate's callback bindings."
 [registry entry]
 (when (generation/current)
  (throw (ex-info "Declare callbacks in configuration.registries and publish a candidate"
           {:kind :immutable-registry-required})))
 (let [registry (data/token registry) id (data/token (data/field entry :id nil))
       normalized (data/entry id entry)]
  (swap! (legacy registry) assoc id normalized) entry))

(defn lookup
 "Resolve callbacks against exactly the caller's sealed graph/configuration.
  Delayed work still needs its ordinary owned task/callback lease. Development
  resolves named functions through the ordinary loader; neither path stores them."
 [registry id]
 (let [registry (data/token registry) key (data/token id) g (generation/current)
       e (get (if g (get (:registries g) registry {}) @(legacy registry)) key)]
  (when e
   (let [metadata (into {} (map (fn [[k v]] [(data/field-key k) v]) (:data e)))
         callbacks (into {} (map (fn [[k reference]]
                     [(data/field-key k)
                      (fn [& args]
                       (if g (generation/invoke! g reference args)
                        (let [[namespace definition] (String/split reference "/")
                              _ (BeamLisp.Loader/ensure_loaded namespace)
                              f (BeamLisp.Env/fetch_exact! namespace definition)]
                         (apply f args))))]) (:callbacks e)))]
    (assoc (merge metadata callbacks) :id id)))))
