; Compiler-only Source IR adapter. Returned syntax is not execution authority.
; Invoked ONLY on actual application Source after native literal-apply expansion.
(ns reload.source-producer (:require [reload.system-bridge :as system-bridge] [reload.server-entry :as server-entry]))
(defn- refuse [kind] (throw (ex-info "Source producer specialization refused" {:kind kind})))
(defn- argv [arguments]
 (reduce (fn [tail argument] {:op :cons :head argument :tail tail :ann {}})
  {:op :enil :ann {}} (reverse arguments)))
(defn- source-body [body]
 ;; Added only by actual G preparation, after compilation and before exact IR
 ;; validation/emission. No author metadata or Source spelling selects ingress.
 {:op :remote :mod :Elixir.BeamLisp.Env :fun :with_source_execution!
  :args (list {:op :fn :clauses (list {:pats (list) :guard nil :body body}) :ann {}})
  :ann (or (:ann body) {})})
(defn initialization-body
 "Inspect a compiler-owned function's eager body without executing its runtime
  Source ingress. Delayed functions inside that body remain guarded."
 [body]
 (let [action (first (:args body)) clause (first (:clauses action))]
  (if (and (= :remote (:op body)) (= :Elixir.BeamLisp.Env (:mod body))
           (= :with_source_execution! (:fun body)) (= 1 (count (:args body)))
           (= :fn (:op action)) (= 1 (count (:clauses action)))
           (empty? (:pats clause)) (nil? (:guard clause)))
   (:body clause) body)))

(defn compiler-data-call?
 "Pure constructors emitted by audited macros, after explicit Source target
  checks. These build spec data; they confer no execution or starter authority."
 [module function arity]
 (and (= :Elixir.BeamLisp.Supervisor module) (= :server function)
      (contains? #{2 3 4} arity)))
(defn- compiler-call? [node]
 ;; Fixed compiler mechanics. Explicit reflective Source spellings are rejected
 ;; before compilation; these routes grant no native callback/target authority.
 (let [module (:mod node) function (:fun node) arity (count (:args node))]
  (or (compiler-data-call? module function arity)
      (and (= :Elixir.BeamLisp.Ns.Rt module)
           (contains? #{[:invoke 2] [:remote_fun 2] [:hash_key 1] [:invocable? 2]
                        [:get 2] [:get 3] [:nth 2] [:nth 3] [:drop 2] [:splice 1]} [function arity]))
      (and (= :erlang module)
           ;; Native guard/BIF lowering is side-effect free. Hand-written native
           ;; calls still require explicit grants in the existing Source pass.
           (contains? #{:== :=:= :/= :=/= :< :> :=< :>= :is_map :is_map_key :map_get
                        :is_atom :is_binary :is_integer :is_float :is_number :is_tuple :tuple_size
                        :is_list :is_function :element :hd :tl :length :not :and :or :xor} function))
      (and (= :Elixir.BeamLisp.Set module) (= :new function) (= 1 arity))
      (and (= :Elixir.BeamLisp.Vector module) (= :new function) (= 1 arity))
      (and (= :Elixir.BeamLisp.ExceptionInfo module) (= :raise_payload function) (= 1 arity))
      (and (= :Elixir.BeamLisp.Loader module) (= :ensure_ready function) (= 1 arity))
      ;; These are the compiler's actual managed class prologues/stubs. Their
      ;; native bodies validate original class/scope/lease; Source spellings of
      ;; privileged Env/Server operations are rejected before this pass.
      (and (= :Elixir.BeamLisp.Env module)
           (contains? #{[:check_server_inputs! 3] [:with_server_execution! 3]} [function arity]))
      (and (= :Elixir.BeamLisp.Server module)
           (contains? #{[:bind_init 1] [:start 3] [:start_link 3]} [function arity])))))
(defn- source-call [node]
 {:op :remote :mod :Elixir.BeamLisp.Env :fun :invoke_source_native!
  :args (list {:op :lit :val (:mod node) :ann {}}
              {:op :lit :val (:fun node) :ann {}} (argv (:args node)))
  :ann (or (:ann node) {})})
(defn- compiler-input-guard? [node module]
 ;; Reuse the canonical actor model. Rewriting its Process.get would change
 ;; both the runtime input check and the exact static proof of that check.
 (let [guard (first (:stmts node)) check (:else guard)
       key (:val (second (:args check)))]
  (and module (= :do (:op node)) (= 2 (count (:stmts node)))
       (= :if (:op guard)) (= :remote (:op check))
       (= :Elixir.BeamLisp.Env (:mod check)) (= :check_server_inputs! (:fun check))
       (erlang/is_list key) (= 3 (count key))
       (:enforced (server-entry/input-body module
                    {:fname (first key) :params (second key) :guard (nth key 2) :body node})))))

(defn specialize
 "Rewrite actual resolved HTTP native calls, including compiler-carried
  definition/module bodies. Literal data, patterns and annotations remain inert.
  Original arguments evaluate exactly once, left-to-right in one proper list."
 [expression context]
 (let [remaining (atom 100000) changes (atom 0)]
  (letfn [(walk [node depth in-body? class-module]
           (when (or (> depth 256) (neg? (swap! remaining dec))) (refuse :source-producer-budget))
           (cond
            ;; Persistent vectors are BEAM maps too. Dispatch by language
            ;; collection kind so a vector of IR nodes is never destructured
            ;; as a map's key/value entries.
            (map? node)
             (if (or (= :lit (:op node)) (:pop node)) node
              (if (compiler-input-guard? node class-module)
               (assoc node :stmts (list (first (:stmts node))
                                  (walk (second (:stmts node)) (inc depth) true class-module)))
              (if (and class-module (= :remote (:op node))
                       (= :Elixir.BeamLisp.Env (:mod node)) (= :with_server_execution! (:fun node))
                       (= 3 (count (:args node)))
                       (= class-module (:val (first (:args node))))
                       (= :lit (:op (first (:args node))))
                       (contains? #{:init :handle_call :handle_cast :handle_info :handle_continue :terminate}
                                  (:val (second (:args node)))))
               ;; Preserve the compiler-owned entry and input-check prologue.
               ;; Native bind_init must run before Source ingress; Env enters
               ;; the Source domain using the authenticated class ticket.
               (let [action (nth (:args node) 2) clause (first (:clauses action))]
                (when-not (and (= :fn (:op action)) (= 1 (count (:clauses action)))
                               (empty? (:pats clause)) (nil? (:guard clause)))
                 (refuse :invalid-source-server-entry))
                (assoc node :args (list (first (:args node)) (second (:args node))
                  (assoc action :clauses (list (assoc clause :body
                    (walk (:body clause) (+ depth 2) true class-module)))))))
              (if-let [factory (BeamLisp.CompilerData/self_application_parts node)]
               ;; Applying the compiler's outer fixed-point function only
               ;; constructs the callable. Restrict its actual inner body,
               ;; while permitting inert construction during preparation.
               (assoc node
                :init (assoc (:outer factory) :clauses
                        (list (assoc (:clause factory) :body
                                (walk (:inner factory) (+ depth 2) in-body? class-module))))
                :body (walk (:body node) (inc depth) in-body? class-module))
              (let [node (or (system-bridge/original-call node (:native-modules context)) node)
                    next (reduce (fn [out [k v]]
                                  (assoc out k (if (contains? #{:ann :meta :params :pats :pat :attrs :exports :guard} k) v
                                                (walk v (inc depth) (or in-body? (contains? #{:fn :defn-clause} (:op node))) class-module)))) {} node)]
               (cond
                (and (:source-ingress context) (nil? class-module) (= :defn-clause (:op next)))
                 (assoc next :body (source-body (:body next)))
                (and (:source-ingress context) (= :fn (:op next)))
                 (assoc next :clauses
                   (to-list (mapv (fn [clause] (assoc clause :body (source-body (:body clause)))) (:clauses next))))
                (and (= :remote (:op next)) (= :Elixir.BeamLisp.Link (:mod next))
                     (= :defvar (:fun next)) (= 4 (count (:args next))))
                 (let [payload (nth (:args next) 2)]
                  (when-not (and (= :lit (:op payload)) (erlang/is_list (:val payload)))
                   (refuse :invalid-source-producer-definition))
                  (let [entries (mapv (fn [entry]
                                  (when-not (and (erlang/is_tuple entry) (= 4 (erlang/tuple_size entry))
                                                 (= :defn-clause (:op (elem entry 3))))
                                   (refuse :invalid-source-producer-definition))
                                  (erlang/setelement 4 entry (walk (elem entry 3) (inc depth) false nil))) (:val payload))]
                   (assoc next :args (to-list (assoc (vec (:args next)) 2 (assoc payload :val (to-list entries)))))))
                (and (= :remote (:op next))
                     (contains? #{:Elixir.BeamLisp.Ns.Lower :Elixir.BeamLisp.Ns.Body.Lower} (:mod next))
                     (= :reload-descriptor! (:fun next)) (= 1 (count (:args next))))
                 (let [payload (first (:args next))]
                  (when-not (and (= :lit (:op payload)) (= :module (:op (:val payload))))
                   (refuse :invalid-source-producer-definition))
                  (assoc next :args (list (assoc payload :val (walk (:val payload) (inc depth) false (:name (:val payload)))))))
                (and (= :remote (:op next)) (= :httpc (:mod next)) (= :request (:fun next)))
                 (do
                  (when-not (contains? #{1 2 4 5} (count (:args next))) (refuse :invalid-managed-http-arity))
                  (when-not (contains? (:native-modules context) "httpc")
                   (refuse :undeclared-native-target))
                  (swap! changes inc)
                  {:op :remote :mod (:guard-module context) :fun (:guard-function context)
                   :args (list (argv (:args next))) :ann (or (:ann next) {})})
                (and (:source-ingress context) in-body? (= :remote (:op next))
                     (not (compiler-call? next)))
                 (source-call next)
                :else next))))))
            (vector? node) (mapv #(walk % (inc depth) in-body? class-module) node)
            (erlang/is_list node) (to-list (mapv #(walk % (inc depth) in-body? class-module) node))
            (erlang/is_tuple node) (erlang/list_to_tuple (to-list (mapv #(walk % (inc depth) in-body? class-module) (erlang/tuple_to_list node))))
            :else node))]
   (let [result (walk expression 0 false nil)]
    {:expression result :changes @changes}))))
