; Compiler-only Source IR adapter. Returned syntax is not execution authority.
; Invoked ONLY on actual application Source after native literal-apply expansion.
(ns reload.source-producer)
(defn- refuse [kind] (throw (ex-info "Source producer specialization refused" {:kind kind})))
(defn- argv [arguments]
 (reduce (fn [tail argument] {:op :cons :head argument :tail tail :ann {}})
  {:op :enil :ann {}} (reverse arguments)))
(defn specialize
 "Rewrite actual resolved HTTP native calls, including compiler-carried
  definition/module bodies. Literal data, patterns and annotations remain inert.
  Original arguments evaluate exactly once, left-to-right in one proper list."
 [expression context]
 (let [remaining (atom 100000) changes (atom 0)]
  (letfn [(walk [node depth]
           (when (or (> depth 256) (neg? (swap! remaining dec))) (refuse :source-producer-budget))
           (cond
            (erlang/is_map node)
             (if (or (= :lit (:op node)) (:pop node)) node
              (let [next (reduce (fn [out [k v]]
                                  (assoc out k (if (contains? #{:ann :meta :params :pats :pat :attrs :exports} k) v
                                                (walk v (inc depth))))) {} node)]
               (cond
                (and (= :remote (:op next)) (= :Elixir.BeamLisp.Link (:mod next))
                     (= :defvar (:fun next)) (= 4 (count (:args next))))
                 (let [payload (nth (:args next) 2)]
                  (when-not (and (= :lit (:op payload)) (erlang/is_list (:val payload)))
                   (refuse :invalid-source-producer-definition))
                  (let [entries (mapv (fn [entry]
                                  (when-not (and (erlang/is_tuple entry) (= 4 (erlang/tuple_size entry))
                                                 (= :defn-clause (:op (elem entry 3))))
                                   (refuse :invalid-source-producer-definition))
                                  (erlang/setelement 4 entry (walk (elem entry 3) (inc depth)))) (:val payload))]
                   (assoc next :args (to-list (assoc (vec (:args next)) 2 (assoc payload :val (to-list entries)))))))
                (and (= :remote (:op next)) (= :Elixir.BeamLisp.Ns.Lower (:mod next))
                     (= :reload-descriptor! (:fun next)) (= 1 (count (:args next))))
                 (let [payload (first (:args next))]
                  (when-not (and (= :lit (:op payload)) (= :module (:op (:val payload))))
                   (refuse :invalid-source-producer-definition))
                  (assoc next :args (list (assoc payload :val (walk (:val payload) (inc depth))))))
                (and (= :remote (:op next)) (= :httpc (:mod next)) (= :request (:fun next)))
                 (do
                  (when-not (contains? #{1 2 4 5} (count (:args next))) (refuse :invalid-managed-http-arity))
                  (when-not (contains? (:native-modules context) "httpc")
                   (refuse :undeclared-native-target))
                  (swap! changes inc)
                  {:op :remote :mod (:guard-module context) :fun (:guard-function context)
                   :args (list (argv (:args next))) :ann (:ann next)})
                :else next)))
            (vector? node) (mapv #(walk % (inc depth)) node)
            (erlang/is_list node) (to-list (mapv #(walk % (inc depth)) node))
            (erlang/is_tuple node) (erlang/list_to_tuple (to-list (mapv #(walk % (inc depth)) (erlang/tuple_to_list node))))
            :else node))]
   {:expression (walk expression 0) :changes @changes})))
