(ns reload.preinit-refusal-fixture
 (:refer-clojure :exclude [map])
 (:require [reload.preinit-counter :as counter]))
;; Constructor staging explicitly refuses unsupported namespace clauses.
;; It must not fall back to evaluating this effect, including for attribution.
(def sentinel (counter/mark! :refusal))
(defn public-value [] sentinel)
