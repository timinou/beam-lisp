; A cycle-breaking call that stays inside the selected immutable graph.
(ns reload.binding (:require [reload.generation :as generation] [reload.binding-data :as data]))

(defn call!
 "Invoke a literal namespace/function dependency using the caller's generation.
  Packaging discovers these source declarations automatically. Managed calls
  never fall back to the ambient application image. Development loads lazily,
  allowing cyclic execution relationships without cyclic namespace loading."
 [reference args]
 (data/reference reference)
 (when-not (or (list? args) (vector? args))
  (throw (ex-info "Late call arguments must be a sequence" {:kind :invalid-late-binding})))
 (if-let [g (generation/current)] (generation/invoke! g reference args)
  (let [[namespace definition] (String/split reference "/")]
   (BeamLisp.Loader/ensure_loaded namespace)
   (apply (BeamLisp.Env/fetch_exact! namespace definition) args))))
