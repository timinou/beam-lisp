; Immutable application graphs, independent request leases and resource context.
; Stable namespaces/native modules are an explicit trusted runtime boundary.
; This is not a source sandbox or an atomic publication across process owners.
(ns reload.generation
 (:require [env] [source-graph :as graph] [reader-node :as rn]
           [reader :as reader] [reload.static-call :as static-call] [reload]))

(def ^:private prepared (atom {}))
(def ^:private forbidden
 #{"eval" "resolve" "ns-resolve" "find-var" "load-file" "load-string"
   "require" "in-ns" "intern" "alter-var-root" "with-redefs" "syntax-quote"
   "var" "erlang/apply" "erlang/make_fun" "code/load_binary"})

(defn- refuse! [kind data]
 (throw (ex-info "Immutable generation refused" (assoc data :kind kind))))

(defn- bounded-data? [value]
 ;; Check before term serialization. A finite byte cap alone does not bound
 ;; nested traversal or the cost of preparing many small collection nodes.
 (loop [todo [[value 0]] remaining 100000]
  (if (empty? todo) true
   (let [[item depth] (first todo)]
    (if (or (neg? remaining) (> depth 64)) false
     (cond
      (or (nil? item) (string? item) (number? item) (erlang/is_atom item))
      (recur (rest todo) (dec remaining))
      (or (map? item) (vector? item) (list? item) (set? item))
      (let [items (if (map? item) (mapcat (fn [[k v]] (list k v)) item) item)]
       (if (> (count items) remaining) false
        (recur (concat (map (fn [v] [v (inc depth)]) items) (rest todo)) (dec remaining))))
      :else false))))))

(defn- normalize-protocols [input]
 (when-not (and (map? input) (<= (count input) 1024)) (refuse! :invalid-protocol-inventory {}))
 (into {}
  (map (fn [[server spec]]
         (let [version (if (map? spec) (:protocol spec) spec)]
          (when-not (and (or (string? server) (keyword? server))
                        (<= (erlang/byte_size (str server)) 128)
                        (int? version) (pos? version))
           (refuse! :invalid-protocol-inventory {:server server}))
          [server version])) input)))

(defn- children [node]
 (let [n (rn/node-form node) tag (rn/node-tag n)]
  (cond
   (contains? #{:list :vector :set} tag) (rn/node-items n)
   (= :map tag) (mapcat (fn [pair] [(elem pair 0) (elem pair 1)]) (rn/node-items n))
   :else [])))

(defn- name-of [node]
 (let [n (rn/node-form node)] (when (= :symbol (rn/node-tag n)) (rn/node-name n))))

(defn- head-of [node] (name-of (first (children node))))

(defn- executable-symbols [node]
 ;; Quoted symbols are application data. Syntax quote is deliberately refused:
 ;; macro-generated late namespace resolution needs a compiler-level seal.
 (if (= "quote" (head-of node)) []
  (concat (when-let [name (name-of node)] [[node name]])
          (mapcat executable-symbols (children node)))))

(defn- literal-node? [node quoted?]
 ;; Inspect reader nodes rather than evaluating an initializer. Quoting permits
 ;; symbols/lists as data; unquoted collections recursively require literals.
 (let [n (rn/node-form node) tag (rn/node-tag n)]
  (cond
   (= :scalar tag) (or (nil? n) (string? n) (number? n) (= true n) (= false n))
   (= :keyword tag) true
   (= :symbol tag) quoted?
   (contains? #{:vector :map :set} tag) (every? #(literal-node? % quoted?) (children node))
   (= :list tag) (if quoted? (every? #(literal-node? % true) (children node))
                  (and (= "quote" (head-of node)) (= 2 (count (children node)))
                       (literal-node? (second (children node)) true)))
   :else false)))

(defn- literal-def? [form]
 (let [items (vec (children form)) n (count items)]
  (and (= "def" (head-of form)) (name-of (get items 1))
       (or (= n 3) (and (= n 4) (string? (rn/node-form (get items 2)))))
       (literal-node? (last items) false))))

(defn- unmanaged-producer? [namespace name]
 (or
  (and (contains? #{"erlang" ":erlang"} namespace)
       (or (String/starts_with? name "spawn") (contains? #{"send_after" "start_timer"} name)))
  (and (= "Process" namespace) (contains? #{"spawn" "send_after"} name))
  (and (contains? #{"gen_server" "gen_statem" "gen_event" "supervisor"} namespace)
       (contains? #{"start" "start_link" "start_monitor" "start_child"} name))
  (and (= "timer" namespace)
       (or (String/starts_with? name "apply_")
           (contains? #{"send_after" "send_interval" "exit_after" "kill_after"} name)))
  (and (contains? #{"Task" "Agent" "GenServer" "Supervisor" "DynamicSupervisor"} namespace)
       (or (String/starts_with? name "start") (String/starts_with? name "async")))
  (and (= "web" namespace) (= "serve" name))
  (and (= "proc" namespace) (contains? #{"spawn" "spawn-link" "spawn-monitor" "async"} name))
  (and (= "proc.tick" namespace) (contains? #{"watch" "debounce" "interval" "after"} name))))

(defn- immutable-form-candidate? [form]
 (let [node (rn/node-form form) tag (rn/node-tag node) head (head-of form)]
  (cond
   (contains? #{:scalar :keyword :symbol} tag) true
   (contains? #{:vector :map :set} tag) (every? immutable-form-candidate? (children form))
   (= :list tag) (or (contains? #{"quote" "fn" "fn*"} head)
                   ;; Named factories are proved from compiler ANF before any
                   ;; initializer runs. Keep obvious mutable constructors out
                   ;; of even the structural plan; unknown calls are not trusted.
                   (and head (not (contains? #{"atom" "ref" "agent" "volatile!"} head))
                        (every? immutable-form-candidate? (rest (children form)))))
   :else false)))

(defn- definition-candidate? [form]
 (let [items (children form) head (head-of form)]
  (and head
   (or (contains? #{"ns" "defn" "defn-" "defserver"} head)
       (and (= "def" head) (immutable-form-candidate? (last items)))
       ;; A macro is evaluated only at the compiler boundary, and its expansion
       ;; must consist solely of checked definitions. Ordinary calls refuse.
       (not (contains? #{"def" "defmacro" "defsupervisor" "do" "let" "atom"} head))))))

(defn- check-source! [name source stable native sources]
 (when-not (and (string? source) (<= (erlang/byte_size source) 1048576))
  (refuse! :invalid-source {:namespace name}))
 (let [forms (BeamLisp.Reader/read_string source)
       header (graph/header* source)
       aliases (nth header 2)
       required (set (second header))]
  (when-not (and (= name (first header)) (= "ns" (head-of (first forms)))
                (= 1 (count (filter #(= "ns" (head-of %)) forms))))
   (refuse! :namespace-mismatch {:namespace name}))
  (doseq [form forms]
   (when-not (definition-candidate? form)
    (refuse! :effectful-generation {:namespace name :form (head-of form)})))
  (let [definitions (keep #(name-of (second (children %))) (rest forms))]
   (when (not= (count definitions) (count (distinct definitions)))
    (refuse! :duplicate-definition {:namespace name})))
  (doseq [dependency required]
   (when-not (or (contains? sources dependency) (contains? stable dependency))
    (refuse! :unsealed-dependency {:namespace name :dependency dependency})))
  (doseq [[node symbol] (mapcat executable-symbols (rest forms))]
   (let [parts (String/split symbol "/") prefix (first parts)
         base (last parts) resolved (get aliases prefix prefix)]
    (when (unmanaged-producer? resolved base)
     (refuse! :unmanaged-generation-producer {:namespace name :symbol symbol}))
    (when (or (= "persistent_term" resolved)
              (or (contains? forbidden symbol) (contains? forbidden (str resolved "/" base)))
              (and (contains? forbidden base)
                   (or (= 1 (count parts)) (contains? #{"core" "env" "reload" "compiler"} resolved)))
              (String/starts_with? resolved "BeamLisp.")
              (String/starts_with? resolved "Elixir.BeamLisp."))
     (refuse! :dynamic-code-dependency {:namespace name :symbol symbol}))
    (when (and (not= "/" symbol) (= 2 (count parts))
               (not (or (= name prefix) (contains? aliases prefix) (= "clojure.re" prefix)
                        (contains? native prefix))))
     ;; Every namespace reference must be declared, including direct qualified
     ;; calls. No fallback to a globally loaded app namespace or host guess.
     (refuse! :undeclared-dependency {:namespace name :symbol symbol}))))
  forms))

(declare rewrite-fragment)

(defn- rewrite-token [text node mapping mode]
 (let [form (rn/node-form node) tag (rn/node-tag form)]
  (cond
   (= :symbol tag)
    (let [name (rn/node-name form) parts (String/split name "/")]
     (if (contains? #{:target :require} mode) (get mapping name text)
      (if (and (= mode :code) (= 2 (count parts)) (get mapping (first parts)))
       (str (get mapping (first parts)) "/" (second parts)) text)))
   (and (= :list tag) (= "deref" (head-of node))
        (= 2 (count (children node))) (String/starts_with? text "@"))
    ;; The reader emits (deref operand), while the source span starts with @.
    ;; Keep that reader syntax and recursively seal only its actual operand.
    (str "@" (rewrite-fragment (String/slice text 1 (String/length text)) mapping mode))
   (and (= :list tag) (String/starts_with? text "#("))
    ;; Anonymous fn reader syntax owns generated parameter names. Preserve the
    ;; prefix and seal its original body rather than reconstructing expansion.
    (str "#" (rewrite-fragment (String/slice text 1 (String/length text)) mapping mode))
   (contains? #{:list :vector :map :set} tag)
    (if (= "quote" (head-of node)) text
     (let [opening (cond (= :set tag) "#{" (= :list tag) "(" (= :vector tag) "[" :else "{")
           closing (cond (= :list tag) ")" (= :vector tag) "]" :else "}")]
      ;; Unsupported reader prefixes do not have a collection-shaped source
      ;; span. Refuse rather than rewrite guessed text.
      (when-not (or (String/starts_with? text "#\"")
                    (and (String/starts_with? text opening) (String/ends_with? text closing)))
       (refuse! :unsupported-reader-expansion {}))
      (if (String/starts_with? text "#\"") text
       (let [inner (String/slice text (String/length opening)
                    (- (String/length text) (String/length opening) 1))
            child-mode (cond
                         (= mode :header) :header-items
                         (= mode :clause) (if (= :keyword (rn/node-tag (rn/node-form (first (children node)))))
                                           (if (= "require" (rn/node-name (rn/node-form (first (children node)))))
                                            :require-items :data) :data)
                         (= mode :require) :require-spec
                         :else mode)]
       (str opening (rewrite-fragment inner mapping child-mode) closing)))))
   :else text)))

(defn- rewrite-fragment [source mapping mode]
 ;; read-next-string provides the original token/collection text and the next
 ;; native reader cursor. This recovers leaf spans without a second lexer; leaf
 ;; symbols deliberately carry no metadata in the public reader contract.
 (let [size (String/length source)]
  (loop [stream (reader/stream source nil) index 0 edits []]
   (let [next (reader/read-next-string stream)]
    (if (= :eof (first next))
     (let [points (vec (String/codepoints source))]
      (apply str
      (reduce (fn [out edit]
                (vec (concat (subvec out 0 (:start edit))
                             (String/codepoints (:text edit)) (subvec out (:end edit)))))
              points (reverse edits))))
     (let [node (second next) text (nth next 2) after (nth next 3)
           end (- size (erlang/length (:chars after))) start (- end (String/length text))
           token-mode (cond
                        (= mode :header-items) (cond (= index 1) :target (> index 1) :clause :data)
                        (= mode :require-items) (if (= index 0) :data :require)
                        (= mode :require-spec) (if (= index 0) :target :data)
                        (= mode :require) :target
                        :else mode)
           replacement (rewrite-token text node mapping token-mode)]
      (recur after (inc index)
       (if (= text replacement) edits (conj edits {:start start :end end :text replacement})))))))))

(defn- rewrite-source [source forms mapping]
 ;; Process each top-level form using the same stream, with ns as a special
 ;; declarative context; generic code rewrites qualified executable symbols.
 (let [size (String/length source)]
  (loop [stream (reader/stream source nil) edits []]
   (let [next (reader/read-next-string stream)]
    (if (= :eof (first next))
     (let [points (vec (String/codepoints source))]
      (apply str
      (reduce (fn [out edit]
                (vec (concat (subvec out 0 (:start edit))
                             (String/codepoints (:text edit)) (subvec out (:end edit)))))
              points (reverse edits))))
     (let [node (second next) text (nth next 2) after (nth next 3)
           end (- size (erlang/length (:chars after))) start (- end (String/length text))
           replacement (rewrite-token text node mapping (if (= "ns" (head-of node)) :header :code))]
      (recur after (conj edits {:start start :end end :text replacement}))))))))

(defn- dependency-order [roots requires]
 (let [seen (atom #{}) result (atom [])]
  (letfn [(visit [name]
            (when-not (contains? @seen name)
             (swap! seen conj name)
             (doseq [dependency (sort (requires name))] (visit dependency))
             (swap! result conj name)))]
   (doseq [root (sort roots)] (visit root)) @result)))

(declare native-hazard-symbol?)

(defn- specialize-source [name source sources stable native]
 (let [result (static-call/specialize source
                {:namespace-prefixes (into stable (keys sources))})]
  (doseq [{:keys [module function]} (:targets result)]
   ;; A rewritten slash target must resolve to the precise declared native
   ;; module. Existing/resolvable BL namespaces win that spelling in compiler
   ;; resolution, so refuse that ambiguity before any compilation/evaluation.
   (when-not (contains? native module)
    (refuse! :undeclared-native-target {:namespace name :module module :function function}))
   (when (native-hazard-symbol? module function)
    (refuse! :dynamic-code-dependency {:namespace name :symbol (str module "/" function)}))
   (when (or (BeamLisp.Env/ns_exists? module) (BeamLisp.Loader/resolvable? module))
    (refuse! :ambiguous-native-target {:namespace name :module module :function function})))
  (:compile-source result)))

(defn plan
 "Generation plan without application evaluation. :sources is the complete managed source map; :roots
  defaults to its keys. :stable-namespaces and :native-modules explicitly name
  the fixed trusted runtime boundary. :resources is immutable generation data.
  Literal native apply calls are specialized only against explicit native
  authority; ambiguous BL namespace spellings refuse before compilation.
  Definition macros are expanded and initializers checked against actual ANF
  during prepare!. Mutable/effectful initializers, dynamic code lookup and
  undeclared namespace calls refuse before application evaluation. The artifact
  builder must independently seal/authorize this plan before prepare!."
 [opts]
 (let [sources (:sources opts) roots (or (:roots opts) (keys sources))
       stable (set (:stable-namespaces opts)) native (set (:native-modules opts))
       application-id (:application-id opts)
       resources (or (:resources opts) {})
       protocols (normalize-protocols (or (:protocols opts) {}))]
  (when-not (and (map? sources) (seq sources) (seq roots) (<= (count sources) 1024)
                (every? #(contains? sources %) roots) (map? resources) (bounded-data? resources)
                (<= (erlang/external_size resources) 4194304)
                (or (nil? application-id)
                    (and (string? application-id) (Regex/match? #"^[a-z][a-z0-9.-]{0,63}$" application-id)))
                (every? #(and (string? %) (Regex/match? #"^[a-zA-Z][a-zA-Z0-9_.-]*$" %))
                        (keys sources)))
   (refuse! :invalid-generation {}))
  (let [source-bytes (reduce + 0 (map #(if (string? %) (erlang/byte_size %) 0) (vals sources)))
        _ (when (> source-bytes 16777216) (refuse! :generation-source-budget {:bytes source-bytes}))
        compile-sources (into {} (map (fn [[name source]]
                                      [name (specialize-source name source sources stable native)]) sources))
        parsed (into {} (map (fn [[name source]]
                              [name (check-source! name source stable native sources)]) compile-sources))
        requires (fn [name] (filter #(contains? sources %) (second (graph/header (get sources name)))))
        cycles (graph/cycles roots requires)]
   (when (seq cycles) (refuse! :require-cycle {:cycles cycles}))
   (let [order (dependency-order roots requires)
         selected (select-keys sources order)
         digest (sha256-hex (erlang/term_to_binary
                  (cond-> [1 (vec (sort-by first selected)) (vec (sort stable)) (vec (sort native)) resources protocols]
                    application-id (conj [:application-id application-id]))
                  (list :deterministic)))
         mapping (into {} (map (fn [name] [name (str "sealed.g" digest (when (:instance opts) (str ".i" (:instance opts))) "." name)]) order))]
    (when (and (:digest opts) (not= digest (:digest opts)))
     (refuse! :identity-conflict {:expected (:digest opts) :actual digest}))
    {:input opts :digest digest :mapping mapping :order order :resources resources
     :application-id application-id :source-bytes source-bytes
     :protocols (into {} (map (fn [[server version]]
                               [server {:protocol version :generation digest}]) protocols))
     :stable-namespaces stable :native-modules native
     :sources (into {} (map (fn [name]
                             [(get mapping name) (rewrite-source (get compile-sources name) (get parsed name) mapping)]) order))}))))

(defn- physical-source-path [path]
 ;; The checkout launcher exposes SDK priv through a symlink, while project
 ;; load paths name its physical tree. Resolve every component, including an
 ;; escaping source symlink; a spelling alone must not grant runtime stability.
 (when (and (string? path) (File/exists? path))
  (loop [parts (rest (Path/split (Path/expand path))) current "/" links 0 steps 0]
   (when (and (<= links 32) (< steps 512))
    (if (empty? parts) current
     (let [next (Path/join current (first parts)) link (File/read_link next)]
      (if (= :ok (elem link 0))
       (recur (concat (rest (Path/split (Path/expand (elem link 1) current))) (rest parts))
              "/" (inc links) (inc steps))
       (recur (rest parts) next links (inc steps)))))))))

(defn fixed-runtime-namespace?
 "Whether this loader's selected source is inside its fixed SDK priv image.
  This checks source location, never a namespace prefix. The release builder
  must independently authorize/seal that runtime; this is not code attestation."
 [name]
 (let [path (physical-source-path (BeamLisp.Loader/source_path name))
       root (physical-source-path (BeamLisp.Tiers/priv_root))]
  (and (string? path) (string? root) (String/starts_with? path (str root "/")))))

(defn project-plan
 "Discover managed source closure through the native loader; no application
  function manifest. :entrypoint is namespace/function. Fixed runtime requires
  stop at :stable-namespaces. :fixed-runtime true also derives that boundary
  from the selected SDK source paths. The artifact builder must seal/authorize
  the runtime independently. This reads source only and executes no app forms."
 [opts]
 (let [entry (:entrypoint opts) parts (when (string? entry) (String/split entry "/"))
       stable (set (:stable-namespaces opts))]
  (when-not (= 2 (count parts)) (refuse! :invalid-entrypoint {}))
  (loop [todo [(first parts)] sources {} boundary stable]
   (if (empty? todo)
    (assoc (plan (assoc opts :sources sources :roots [(first parts)] :stable-namespaces boundary)) :entrypoint entry)
    (let [name (first todo)]
     (cond
      (or (contains? sources name) (contains? boundary name))
       (recur (rest todo) sources boundary)
      (and (:fixed-runtime opts) (fixed-runtime-namespace? name))
       (recur (rest todo) sources (conj boundary name))
      :else
       (do
        (when (>= (count sources) 1024) (refuse! :generation-capacity {}))
        (let [source (try (BeamLisp.Loader/source_content name) (catch _ nil))]
         (when-not (string? source) (refuse! :missing-source {:namespace name}))
         (recur (concat (rest todo) (second (graph/header source))) (assoc sources name source) boundary)))))))))

(defn- with-lock [key action] (BeamLisp.Env/with_generation_lock (tuple :sealed-generation key) action))

(defn capacity
 "Node-lifetime admission budget, including failed prepares. BEAM atoms cannot
  be collected; reaching this bound requires a runtime handover. Retirement
  does not replenish it. Two-argument form is the pure admission decision."
 ([] (capacity (erlang/apply :persistent_term :get
                 (list :bl_sealed_generation_budget {:preparations 0 :namespaces 0})) 1))
 ([used namespaces] (capacity used namespaces 0))
 ([used namespaces source-bytes]
  (assoc used :source-byte-limit 134217728 :preparation-limit 256 :namespace-limit 4096
    :status (if (and (< (:preparations used 0) 256)
                     (<= (+ (:namespaces used 0) namespaces) 4096)
                     (<= (+ (:source-bytes used 0) source-bytes) 134217728))
              :available :runtime-handover-required))))

(defn- reserve-capacity! [namespaces source-bytes]
 (with-lock :node-lifetime-capacity
  (fn []
   (let [used (erlang/apply :persistent_term :get
                (list :bl_sealed_generation_budget {:preparations 0 :namespaces 0}))
         decision (capacity used namespaces source-bytes)]
    (when (or (not= :available (:status decision))
              (< (- (erlang/system_info :atom_limit) (erlang/system_info :atom_count)) 65536))
     (refuse! :runtime-handover-required {:capacity decision}))
    (erlang/apply :persistent_term :put
      (list :bl_sealed_generation_budget
        {:preparations (inc (:preparations used 0)) :namespaces (+ (:namespaces used 0) namespaces)
         :source-bytes (+ (:source-bytes used 0) source-bytes)}))))))

(defn- namespace-modules [name]
 (cons (BeamLisp.Emit/module_for name)
       (keys (BeamLisp.Emit/body_modules (BeamLisp.Env/ns_defs name)))))

(defn- native-hazard-symbol? [module name]
 (let [namespace (String/replace_prefix module "Elixir." "")]
  (or (unmanaged-producer? namespace name)
      (= namespace "persistent_term")
      (contains? #{"BeamLisp.Env" "BeamLisp.Compiler" "BeamLisp.AOT"
                   "BeamLisp.AOTCache" "BeamLisp.Emit" "BeamLisp.Link" "BeamLisp.Bootstrap"} namespace)
      (and (= namespace "BeamLisp") (contains? #{"eval" "eval_string" "load_file"} name))
      (and (= namespace "erlang") (contains? #{"apply" "make_fun"} name))
      (and (= namespace "code") (contains? #{"load_binary" "load_file" "delete" "purge" "soft_purge"} name)))))

(defn- native-hazard? [module function]
 (native-hazard-symbol? (erlang/atom_to_binary module :utf8)
                        (erlang/atom_to_binary function :utf8)))

(defn- check-expanded-source! [name form]
 ;; Rt/invoke is legitimate compiler lowering for closure/keyword calls. Reject
 ;; explicit reflective source, including trusted macro output, before lowering.
 ;; Audited macros may emit native constructors such as Supervisor/server; the
 ;; initializer/descriptor ANF proof below checks their actual executable shape.
 (doseq [[_ symbol] (executable-symbols form)]
  (let [parts (String/split symbol "/") namespace (first parts) function (last parts)]
   (when (and (= 2 (count parts))
              (or (native-hazard-symbol? namespace function)
                  (and (= "BeamLisp.Ns.Rt" (String/replace_prefix namespace "Elixir." ""))
                       (= "invoke" function))))
    (refuse! :unmanaged-compiled-producer {:namespace name :symbol symbol})))))

(defn- check-anf! [planned expression]
 ;; Inspect the compiler's actual ANF too: a trusted macro must not inject a
 ;; late reference to an unversioned app namespace after source rewriting.
 (let [names (set (concat (vals (:mapping planned)) (:stable-namespaces planned) ["core" "sugar" "rt" "clojure.re"]))
       modules (set (mapcat namespace-modules names))]
  (letfn [(walk [node]
            (cond
             (map? node)
              (do
               (when (and (= :global (:op node)) (not (contains? names (:ns node))))
                (refuse! :unsealed-compiled-dependency {:namespace (:ns node)}))
               (when (and (= :remote (:op node)) (erlang/is_atom (:mod node))
                          (native-hazard? (:mod node) (:fun node)))
                (refuse! :unmanaged-compiled-producer {:module (:mod node) :function (:fun node)}))
               (when (and (= :remote (:op node)) (= :Elixir.BeamLisp.Loader (:mod node))
                          (not (and (= :ensure_ready (:fun node)) (= 1 (count (:args node)))
                                    (= :lit (:op (first (:args node))))
                                    (contains? names (:val (first (:args node)))))))
                (refuse! :unsealed-compiled-dependency {:module (:mod node) :function (:fun node)}))
               (when (and (= :remote (:op node)) (erlang/is_atom (:mod node))
                          (String/starts_with? (erlang/atom_to_binary (:mod node) :utf8)
                                               "Elixir.BeamLisp.Ns.")
                          (not (contains? modules (:mod node))))
                (refuse! :unsealed-compiled-dependency {:module (:mod node)}))
               (when-not (= :lit (:op node)) (doseq [child (vals node)] (walk child))))
             (erlang/is_tuple node) (doseq [child (erlang/tuple_to_list node)] (walk child))
             (or (list? node) (vector? node)) (doseq [child node] (walk child))))]
   (walk expression))))


(defn- check-compiled! [planned]
 (doseq [name (vals (:mapping planned))
         [_ entries] (BeamLisp.Env/ns_defs name) entry entries]
  (check-anf! planned (elem entry 3))))

(def ^:private immutable-remotes
 #{[:Elixir.BeamLisp.Supervisor :server]
   [:Elixir.BeamLisp.Vector :new] [:Elixir.BeamLisp.Set :new]
   [:Elixir.BeamLisp.Ns.Rt :hash_key] [:Elixir.BeamLisp.Ns.Clojure.Re :re-pattern]
   [:Elixir.BeamLisp.Ns.Core :merge__bl_v] [:Elixir.BeamLisp.Ns.Core :set]
   [:Elixir.BeamLisp.Ns.Core :vector__bl_v] [:Elixir.BeamLisp.Ns.Core :list__bl_v]
   [:Elixir.BeamLisp.Ns.Core :str__bl_v] [:Elixir.Regex :compile!]})

(defn- record-factory! [targets namespace definition]
 ;; Incremental per-definition index: do not materialize/rescan the whole
 ;; product graph for each literal constant or callback map initializer.
 (let [shim (BeamLisp.Emit/module_for namespace)
       entries (BeamLisp.Env/ns_definition namespace definition)]
  (doseq [entry entries]
   (let [clause (elem entry 3) fname (elem entry 2) arity (count (:params clause))
         body-module (when (> (erlang/tuple_size entry) 4) (elem entry 4))]
    (when (and (= :fixed (elem entry 0)) (= :defn-clause (:op clause)))
     (doseq [module (distinct (filter some? [shim body-module]))]
      (swap! targets update [module fname arity] (fnil conj []) clause)))))))

(defn- immutable-anf? [planned node targets]
 ;; Prove the finite executable construction path, not a function's delayed
 ;; callback body. Only exact compiled functions in this sealed graph may be
 ;; followed. Unknown/native calls, dynamic callees and recursive factories
 ;; refuse; no callback is executed to discover whether it happens to be pure.
 (let [ready-names (set (concat (vals (:mapping planned)) (:stable-namespaces planned)
                               ["core" "sugar" "rt" "clojure.re"]))
       remaining (atom 8192)]
  (letfn [(budget! [depth]
            (when (or (> depth 32) (neg? (swap! remaining dec)))
             (refuse! :initializer-analysis-budget {})))
          (clause-safe? [clause bindings active depth]
            ;; Named defn parameters are compiler-normalized plain variables.
            ;; Anonymous destructuring is lowered into its body and audited too.
            (let [params (or (:params clause) (:pats clause))]
             (and (every? #(= :pvar (:pop %)) params)
                  (let [locals (reduce (fn [out param] (assoc out (:name param) :immutable)) bindings params)]
                   (and (or (nil? (:guard clause)) (safe (:guard clause) locals active (inc depth)))
                        (safe (:body clause) locals active (inc depth)))))))
          (call-local? [callee arguments bindings active depth]
            (let [value (when (= :var (:op callee)) (get bindings (:name callee)))
                  closure (cond (= :fn (:op callee)) {:node callee :bindings bindings}
                                (map? value) value :else nil)
                  clauses (when closure (filter #(= (count arguments) (count (:pats %)))
                                                 (:clauses (:node closure))))]
             (and (seq clauses) (every? #(safe % bindings active (inc depth)) arguments)
                  (every? #(clause-safe? % (:bindings closure) active (inc depth)) clauses))))
          (safe [n bindings active depth]
           (budget! depth)
           (if-not (map? n) false
            (case (:op n)
             :lit true :enil true
             :global (let [found (BeamLisp.Env/fetch (:ns n) (:name n))]
                       (and (erlang/is_tuple found) (= :ok (elem found 0))
                            (or (bounded-data? (elem found 1))
                                (try (BeamLisp.Env/callback_modules (elem found 1)) true (catch _ false)))))
             :var (contains? bindings (:name n))
             :fn true
             :let (and (safe (:init n) bindings active (inc depth))
                    (safe (:body n)
                      (assoc bindings (:name n) (if (= :fn (:op (:init n)))
                                                 {:node (:init n) :bindings bindings} :immutable))
                      active (inc depth)))
             :apply (call-local? (:fn n) (:args n) bindings active depth)
             :if (every? #(safe % bindings active (inc depth)) [(:test n) (:then n) (:else n)])
             :map (every? #(every? (fn [v] (safe v bindings active (inc depth))) %) (:pairs n))
             :cons (and (safe (:head n) bindings active (inc depth)) (safe (:tail n) bindings active (inc depth)))
             :tuple (every? #(safe % bindings active (inc depth)) (:elems n))
             :struct (and (= :Elixir.BeamLisp.Vector (:mod n))
                          (every? #(every? (fn [v] (safe v bindings active (inc depth))) %) (:fields n)))
             :arith (every? #(safe % bindings active (inc depth)) (:args n))
             :remote
              (let [target [(:mod n) (:fun n) (count (:args n))] clause (get targets target)]
               (cond
                (contains? immutable-remotes [(:mod n) (:fun n)])
                 (every? #(safe % bindings active (inc depth)) (:args n))
                (and (= :Elixir.BeamLisp.Loader (:mod n)) (= :ensure_ready (:fun n))
                     (= 1 (count (:args n))) (= :lit (:op (first (:args n)))))
                 (contains? ready-names (:val (first (:args n))))
                clause
                 (and (not (contains? active target))
                      (every? #(safe % bindings active (inc depth)) (:args n))
                      (every? #(clause-safe? % {} (conj active target) (inc depth)) clause))
                :else false))
             :do (every? #(safe % bindings active (inc depth)) (:stmts n))
             false)))]
   (safe node {} #{} 0))))

(defn- executable-values [value]
 ;; Include compiler eval companions retained by callback-valued defs. Ignoring
 ;; them would let graph retirement report success while a closure remains live.
 (cond
  (erlang/is_function value) (BeamLisp.Env/callback_modules value)
  (and (erlang/is_tuple value) (= 3 (erlang/tuple_size value)) (= :$blfn (elem value 0)))
  (BeamLisp.Env/callback_modules value)
  (map? value) (mapcat executable-values (mapcat (fn [[k v]] (list k v)) value))
  (or (vector? value) (list? value) (set? value)) (mapcat executable-values value)
  :else []))

(defn- evaluate-definitions! [planned name source value-modules factory-targets]
 (let [forms (BeamLisp.Reader/read_string source) seen (atom #{}) env (BeamLisp.Compiler/new_env name)]
  (BeamLisp.Compiler/eval_form (first forms) env)
  (letfn [(definition! [form depth]
           (when (> depth 32) (refuse! :definition-expansion-budget {:namespace name}))
           (let [head (head-of form) items (children form)]
            (if (contains? #{"defn" "defn-" "def" "defserver"} head)
             (let [definition (name-of (second items))]
              (check-expanded-source! name form)
              (when (or (nil? definition) (contains? @seen definition))
               (refuse! :duplicate-definition {:namespace name :definition definition}))
              (swap! seen conj definition)
              (when (= head "def")
               (let [initializer (BeamLisp.Compiler/compile (last items) env)]
                (check-anf! planned initializer)
                (when-not (immutable-anf? planned initializer @factory-targets)
                 (refuse! :effectful-generation {:namespace name :definition definition}))))
              (when (= head "defserver")
               (let [compiled (BeamLisp.Compiler/compile form env)
                     descriptor (:val (first (:args (first (:stmts compiled)))))]
                (when-not (and (= :module (:op descriptor))
                               (= (BeamLisp.Server/module_for name definition) (:name descriptor)))
                 (refuse! :unmanaged-owner-descriptor {:namespace name}))
                (doseq [clause (:clauses descriptor)] (check-anf! planned (:body clause)))))
              (let [value (BeamLisp.Compiler/eval_form form env)]
               (when (contains? #{"defn" "defn-"} head) (record-factory! factory-targets name definition))
               (when (= head "defserver") (swap! value-modules conj value))
               (when (= head "def")
                (swap! value-modules into (filter #(String/starts_with? (erlang/atom_to_binary % :utf8)
                                                    "Elixir.BeamLisp.Eval.") (executable-values value))))))
             (let [expanded (BeamLisp.Compiler/macroexpand_1 (rn/node-form form) name)]
              (when (= expanded form)
               (refuse! :effectful-generation {:namespace name :form head}))
              (if (= "do" (head-of expanded))
               (doseq [child (rest (children expanded))] (definition! child (inc depth)))
               (definition! expanded (inc depth)))))))]
   (doseq [form (rest forms)] (definition! form 0)))))

(defn prepare!
 "Compile a validated plan into fresh names in a dedicated environment. Reuses
  an identical prepared graph in the same parent env. Returns an opaque runtime
  handle. No handler becomes reachable through a serving slot until publish!."
 [proposal]
 (let [input (or (:input proposal) proposal)
       validated (plan input)
       key [(env/current) (:digest validated)]]
  (with-lock key
   (fn []
    (or (get @prepared key)
     (let [_ (reserve-capacity! (count (:order validated)) (:source-bytes validated))
           planned (plan (assoc input :instance (str (erlang/unique_integer (list :positive)))))
           scope (env/fork) value-modules (atom #{}) factory-targets (atom {}) generation
           (try
            (env/with-env scope
             (fn []
              ;; The legacy source-only pass treats macro/owner DSL labels as
              ;; variable references. Keep it for ordinary definitions; extended
              ;; definitions are checked from their actual expanded compiler ANF.
              (when (every? (fn [[_ src]]
                       (every? #(contains? #{"ns" "def" "defn" "defn-"} (head-of %))
                               (BeamLisp.Reader/read_string src))) (:sources planned))
               (let [errors (reload/coherence (vec (:sources planned)))]
                (when (seq errors) (refuse! :incoherent-generation {:errors errors}))))
              (doseq [name (vals (:mapping planned))] (BeamLisp.Env/declare_ns name))
              (doseq [name (:order planned)]
               (let [fresh (get (:mapping planned) name)]
                (evaluate-definitions! planned fresh (get (:sources planned) fresh) value-modules factory-targets)
                (BeamLisp.Env/mark_loaded fresh)))
              (BeamLisp.Link/settle)
              (check-compiled! planned)
              (let [modules (vec (distinct (concat @value-modules (mapcat
                             namespace-modules
                             (vals (:mapping planned))))))]
               {:digest (:digest planned) :mapping (:mapping planned) :scope scope
                :context (assoc (env/capture) :generation nil) :resources (:resources planned) :modules modules
                :protocols (:protocols planned) :application-id (:application-id planned)
                :state (atom {:retired false :tickets {} :slots #{}}) :cache-key key})))
            (catch error
             (try
              (env/with-env scope
               (fn []
                (doseq [module (concat @value-modules (mapcat namespace-modules (vals (:mapping planned))))]
                 (BeamLisp.Env/retire_module! module))))
              (finally (env/destroy scope)))
             (throw error)))]
      ;; Ordinary development reload must never overwrite prepared providers.
      (swap! reload/live-generations
       (fn [m] (reduce (fn [a name] (assoc a name :sealed)) m (vals (:mapping planned)))))
      (swap! prepared assoc key generation)
      generation))))))

(defn prepare-project! [opts] (prepare! (project-plan opts)))

(defn- acquire! [generation]
 (with-lock (:cache-key generation)
  (fn []
   (when (:retired @(:state generation)) (refuse! :retired-generation {}))
   (let [ticket (BeamLisp.Env/retain_code! (to-list (:modules generation)))]
    (swap! (:state generation) assoc-in [:tickets ticket] (erlang/self)) ticket))))

(defn- release-ticket! [generation ticket]
 (with-lock (:cache-key generation)
  (fn [] (BeamLisp.Env/release_code! ticket)
         (swap! (:state generation) update :tickets dissoc ticket) :ok)))

(defn slot
 "A stable serving indirection. Admission/publication share a short lock;
  handlers execute concurrently outside it. One slot may serve many listeners."
 [] {:id (erlang/make_ref) :current (atom nil)})

(defn publish!
 "Compare-and-publish one serving slot. expected is nil or the current digest.
  Not a multi-owner transaction. Durable activation intent belongs upstream."
 [slot expected generation]
 (with-lock (:id slot)
  (fn []
   (let [old @(:current slot)]
    (cond
     (not (reload/reload-enabled?)) {:status :held :reason :reload-disabled}
     (= (:digest old) (:digest generation)) {:status :already-applied :digest (:digest old)}
     (not= expected (:digest old)) {:status :stale :digest (:digest old)}
     :else
      (do
       (with-lock (:cache-key generation)
        (fn []
         (when (:retired @(:state generation)) (refuse! :retired-generation {}))
         (swap! (:state generation) update :slots conj (:id slot))
         (reset! (:current slot) generation)))
       (when old (with-lock (:cache-key old)
                   (fn [] (swap! (:state old) update :slots disj (:id slot)))))
       {:status :applied :digest (:digest generation)}))))))

(defn current
 "Selected generation identity/resources in this execution, or nil outside it."
 [] (Process/get :bl_generation))

(defn close!
 "Stop new admissions during listener shutdown. Existing request/callback
  leases remain valid. Compare-and-close prevents shutting down a newer slot."
 [slot expected]
 (with-lock (:id slot)
  (fn []
   (let [old @(:current slot)]
    (if (not= expected (:digest old)) {:status :stale :digest (:digest old)}
     (do
      (reset! (:current slot) nil)
      (when old (with-lock (:cache-key old)
                  (fn [] (swap! (:state old) update :slots disj (:id slot)))))
      {:status :closed}))))))

(defn resource
 "Read a sealed resource/config value. Missing context/key refuses; never
  falls through to a newer release's mutable global configuration."
 [key]
 (let [context (current)]
  (when-not (and context (contains? (:resources context) key))
   (refuse! :missing-generation-resource {:resource key}))
  (get (:resources context) key)))

(defn resource-path
 "Resolve a relative asset/configuration path inside a sealed absolute resource
  root. Never reads ambient cwd/env or accepts traversal/absolute input. The
  release builder remains responsible for complete asset manifest coverage."
 [key relative]
 (let [root (resource key)]
  (when-not (and (string? root) (= root (Path/expand root))
                (string? relative) (not= "" relative)
                (not (String/starts_with? relative "/"))
                (not (String/contains? relative "\\"))
                (every? #(not (contains? #{"" "." ".."} %)) (String/split relative "/")))
   (refuse! :invalid-resource-path {:resource key :path relative}))
  (Path/join root relative)))

(defn- bounded-handles? [bindings]
 (loop [todo [bindings] remaining 100000]
  (if (empty? todo) true
   (if (neg? remaining) false
    (let [v (first todo)]
     (cond
      (erlang/is_function v) false
      (and (erlang/is_map v) (= :Elixir.BeamLisp.Atom (maps/get :__struct__ v nil)))
      (recur (cons @v (rest todo)) (dec remaining))
      (and (erlang/is_tuple v) (= 3 (erlang/tuple_size v)) (= :$blfn (elem v 0))) false
      (or (erlang/is_map v) (vector? v) (list? v) (set? v) (erlang/is_tuple v))
      (let [items (cond (erlang/is_map v) (mapcat (fn [pair] (list (elem pair 0) (elem pair 1)))
                                                  (maps/to_list v))
                       (erlang/is_tuple v) (erlang/tuple_to_list v) :else v)]
       (and (<= (count items) remaining)
            (recur (reduce (fn [stack item] (cons item stack)) (rest todo) items) (dec remaining))))
      :else (recur (rest todo) (dec remaining))))))))

(defn runtime-value?
 "Bounded nonexecutable runtime data/handles. Atom contents are checked too;
  callback references must remain sealed names instead of borrowed closures."
 [value]
 (bounded-handles? value))

(defn bind-runtime!
 "Bind initializer-owned live handles once in this generation. Unlike sealed
  resources these handles do not enter artifact identity. The lifecycle caller
  owns their cleanup and native store/process validation. Call while initializing,
  before publication; no global fallback and no executable callbacks in bindings."
 [bindings]
 (let [generation (current)]
  (when-not (and generation (map? bindings) (runtime-value? bindings))
   (refuse! :invalid-runtime-bindings {}))
  (with-lock (:cache-key generation)
   (fn []
    (let [state @(:state generation) previous (:runtime state)]
     (when (or (:retired state) (seq (:slots state)))
      (refuse! :runtime-bindings-closed {}))
     (if previous
      (if (and (= (erlang/self) (:owner previous)) (= bindings (:values previous))) :already-bound
       (refuse! :runtime-binding-conflict {}))
      (do (swap! (:state generation) assoc :runtime {:owner (erlang/self) :values bindings}) :bound)))))))

(defn runtime-bound?
 "Whether this graph has initializer bindings whose original owner is alive.
  Does not expose handles, authorize inheritance or acquire a serving lease."
 [generation]
 (let [state @(:state generation) runtime (:runtime state)]
  (boolean (and runtime (not (:retired state)) (Process/alive? (:owner runtime))))))

(defn inherit-runtime!
 "Explicitly share initializer-owned handles with an unpublished candidate.
  Only their original live owner may authorize this; actors are not restarted,
  resource ownership is not transferred, and no product global is consulted."
 [candidate previous]
 (let [graphs (sort-by #(pr-str (:cache-key %)) [candidate previous])]
  (with-lock (:cache-key (first graphs))
   (fn [] (with-lock (:cache-key (second graphs))
    (fn []
     (let [target @(:state candidate) source @(:state previous) runtime (:runtime source)]
      (when-not (and runtime (= (erlang/self) (:owner runtime)) (Process/alive? (:owner runtime))
                     (not (:retired source)) (not (:retired target)) (empty? (:slots target))
                     (= (:application-id candidate) (:application-id previous)))
       (refuse! :runtime-inheritance-refused {}))
      (if (:runtime target)
       (if (= (:runtime target) runtime) :already-bound (refuse! :runtime-binding-conflict {}))
       (do (swap! (:state candidate) assoc :runtime runtime) :inherited)))))))))

(defn runtime-resource
 "Read a live handle owned by this generation's initializer. Owner death,
  retired graph and missing binding fail closed, including conveyed callbacks."
 [key]
 (let [generation (current) state (when generation @(:state generation)) runtime (:runtime state)]
  (when-not (and runtime (not (:retired state)) (Process/alive? (:owner runtime))
                (contains? (:values runtime) key))
   (refuse! :missing-runtime-resource {:resource key}))
  (get (:values runtime) key)))

(defn owner-evidence
 "Read native first-party owner registration without messaging an arbitrary
  actor. Exact live code-lease tickets prove graph lifetime; no stop authority
  or state/message migration authority follows from this evidence."
 [pid]
 (when (and (erlang/is_pid pid) (= (erlang/node) (erlang/node pid)))
  (let [key (tuple :bl_generation_owner pid) rows (ets/lookup :beam_lisp_vars key)
        row (first rows) evidence (when row (elem row 1)) lease (:lease evidence)]
   (when evidence
    (if (and (Process/alive? pid) (= pid (elem lease 1))
             (every? (fn [module]
               (= [(tuple (tuple module pid (elem lease 2)) true)]
                  (vec (ets/lookup :beam_lisp_code_leases (tuple module pid (elem lease 2))))))
               (elem lease 0)))
     (assoc (dissoc evidence :lease) :ticket (elem lease 2))
     (do (ets/delete_object :beam_lisp_vars row) nil))))))

(defn- execute [generation action]
 (let [previous (env/capture)]
  (try
   (env/bind (:context generation))
   (Process/put :bl_generation generation)
   (action)
   (finally (env/bind previous)))))

(defn- invoke-entry [generation entry args]
 (let [parts (String/split entry "/") name (get (:mapping generation) (first parts))]
  (when-not (and name (= 2 (count parts))) (refuse! :unsealed-entrypoint {:entrypoint entry}))
  (let [result (BeamLisp.Env/fetch_exact name (second parts))]
   (when-not (and (erlang/is_tuple result) (= :ok (elem result 0)))
    (refuse! :missing-entrypoint {:entrypoint entry}))
   (apply (elem result 1) args))))

(defn call!
 "Admit a request against exactly one generation, pin its whole physical graph
  and context, then execute outside publication locks. Finally releases on error."
 [slot entry args]
 (let [[generation ticket]
       (with-lock (:id slot)
        (fn []
         (let [generation @(:current slot)]
          (when-not generation (refuse! :unavailable-generation {}))
          [generation (acquire! generation)])))]
  (try (execute generation #(invoke-entry generation entry args))
       (finally (release-ticket! generation ticket)))))

(defn with!
 "Trusted framework execution against a prepared graph, without publication.
  Keeps returned domain callbacks safe only while action runs; delayed users
  must capture! a registration. The caller cannot replace serving policy."
 [generation action]
 (let [ticket (acquire! generation)]
  (try (execute generation action)
       (finally (release-ticket! generation ticket)))))

(defn invoke!
 "Invoke sealed candidate code before publication with full graph/context."
 [generation entry args]
 (with! generation #(invoke-entry generation entry args)))

(defn selected
 "Snapshot serving identity under its admission lock."
 [slot]
 (with-lock (:id slot) #(some-> @(:current slot) :digest)))

(defn capture!
 "Retain the current generation for delayed work. Registration blocks
  retirement until release!; run! adds a separate executing native code lease.
  Transfer the native ticket when handing lifetime ownership to another process."
 []
 (let [generation (current)]
  (when-not generation (refuse! :missing-generation-context {}))
  {:generation generation :ticket (acquire! generation)}))

(defn run!
 "Invoke an entrypoint under a retained registration, or :cancelled after
  release/owner death. Does not serialize independent callback executions."
 [registration entry args]
 (let [generation (:generation registration)]
  (BeamLisp.Env/run_code! (:ticket registration)
   (fn []
    (let [ticket (acquire! generation)]
     (try (execute generation (fn [] (invoke-entry generation entry args)))
          (finally (release-ticket! generation ticket))))))))

(defn release! [registration]
 (release-ticket! (:generation registration) (:ticket registration)))

(defn transfer!
 "Transfer a retained callback's lifetime to the accepting local worker.
  The old handle becomes cancelled. Dead workers return :cancelled."
 [registration owner]
 (let [generation (:generation registration) ticket (:ticket registration)]
  (with-lock (:cache-key generation)
   (fn []
    (let [next (BeamLisp.Env/transfer_code! ticket owner)]
     (if (= :cancelled next) :cancelled
      (do (swap! (:state generation)
            (fn [state] (-> state (update :tickets dissoc ticket)
                                 (assoc-in [:tickets next] owner))))
          {:generation generation :ticket next})))))))

(defn evidence
 "Live managed obligations. Dead registration owners are pruned. A registered
  callback and an executing request both prevent retirement."
 [generation]
 (with-lock (:cache-key generation)
  (fn []
   (swap! (:state generation) update :tickets
    (fn [tickets] (into {} (filter (fn [[_ owner]] (erlang/is_process_alive owner)) tickets))))
   (let [state @(:state generation)]
    {:digest (:digest generation) :retired (:retired state)
     :serving-slots (count (:slots state)) :registrations (count (:tickets state))
     :modules (count (:modules generation))}))))

(defn retire!
 "Retire an unserved graph with no retained registrations. Native soft
  retirement still checks actual executing code leases. Unknown obligations
  outside this managed graph must be ruled out by the deployment coordinator."
 [generation]
 (with-lock (:cache-key generation)
  (fn []
   (let [status (evidence generation)]
    (cond
     (:retired status) {:status :already-retired}
     (or (pos? (:serving-slots status)) (pos? (:registrations status)))
      (assoc status :status :waiting)
     :else
      (if (= true (BeamLisp.Env/retire_modules! (to-list (:modules generation))))
       (do (swap! (:state generation) assoc :retired true)
           (env/destroy (:scope generation))
           (swap! prepared dissoc (:cache-key generation))
           (swap! reload/live-generations
            (fn [m] (reduce dissoc m (vals (:mapping generation)))))
           {:status :retired})
       {:status :waiting :reason :executing-code}))))))

(defn with-retirement-fence!
 "Hold graph admission while a trusted coordinator checks durable producer
  fences and retires it. No action runs while serving or managed users remain.
  Native retire! must still succeed before authorizing destructive changes."
 [generation action]
 (with-lock (:cache-key generation)
  (fn []
   (let [status (evidence generation)]
    (if (or (pos? (:serving-slots status)) (pos? (:registrations status)))
     (assoc status :status :waiting) (action))))))
