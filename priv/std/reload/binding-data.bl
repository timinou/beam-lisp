; Static late dependencies: literal names, never an ambient application lookup.
(ns reload.binding-data (:require [reader] [reader-node :as rn] [source-graph :as graph]))

(defn reference [value]
 (when-not (and (string? value) (<= (erlang/byte_size value) 256)
                (Regex/match? #"^[a-zA-Z][a-zA-Z0-9_.-]*/[a-zA-Z_][a-zA-Z0-9_!?*-]*$" value))
  (throw (ex-info "Late dependencies require literal namespace/function names"
           {:kind :invalid-late-binding})))
 value)

(defn references-forms
 "Collect direct literal reload.binding/call! declarations from source. Quotes
  remain data; borrowed call functions and dynamic target expressions refuse."
 [forms header]
 (let [aliases (nth header 2)
       _ (when (or (= "reload.binding" (get (nth header 3) "call!"))
                   (some #{"reload.binding"} (nth header 4)))
           (throw (ex-info "Declare late calls with a namespace qualifier or alias"
                    {:kind :invalid-late-binding})))
       target? (fn [node]
                 (let [n (rn/node-form node)]
                  (when (= :symbol (rn/node-tag n))
                   (let [parts (String/split (rn/node-name n) "/")]
                    (and (= 2 (count parts)) (= "call!" (second parts))
                         (= "reload.binding" (get aliases (first parts) (first parts))))))))]
  (letfn [(walk [node]
            (let [n (rn/node-form node) tag (rn/node-tag n)
                  children (cond
                             (contains? #{:list :vector :set} tag) (rn/node-items n)
                             (= :map tag) (Enum/flat_map (rn/node-items n) (fn [pair] [(elem pair 0) (elem pair 1)]))
                             :else [])
                  head (first children)]
             (cond
              (and (= :list tag) (= "quote" (when (and head (= :symbol (rn/node-tag (rn/node-form head)))) (rn/node-name (rn/node-form head))))) []
              (and (= :list tag) (target? head))
               (let [value (rn/node-form (second children))]
                (when-not (= 3 (count children))
                 (throw (ex-info "Late calls require a target and argument sequence" {:kind :invalid-late-binding})))
                (cons (reference value) (Enum/flat_map (drop 2 children) walk)))
              (target? node) (throw (ex-info "Late call targets must be statically declared" {:kind :invalid-late-binding}))
              :else (Enum/flat_map children walk))))]
   (vec (sort (set (Enum/flat_map forms walk)))))))

(defn references
 "Collect late binding names from exact source bytes. The -forms entry reuses
   an existing actual Reader result and its normalized header within one plan."
 [source]
 (let [forms (reader/read-string source nil)]
  (references-forms forms (graph/header*-nodes forms))))

(defn roots [source]
 (vec (sort (set (map #(first (String/split % "/")) (references source))))))
