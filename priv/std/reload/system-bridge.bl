; Recover the original System target from the compiler's exact command ABI.
; This removes only a fixed host-availability branch, never application logic.
(ns reload.system-bridge)

(def ^:private targets
 {:get_env [:os_get_env #{0 1 2}] :fetch_env [:os_fetch_env #{1}]
  :fetch_env! [:os_fetch_env! #{1}] :put_env [:os_put_env #{1 2}]
  :delete_env [:os_delete_env #{1}] :cmd [:os_cmd #{2 3}] :shell [:os_shell #{1 2}]})

(defn- remote? [node module function arity]
 (and (= :remote (:op node)) (= module (:mod node)) (= function (:fun node))
      (= arity (count (:args node)))))
(defn- literal? [node value]
 (and (= :lit (:op node)) (= value (:val node))))

(defn original-call
 "Recognize the complete compiler-owned System availability/fallback scaffold.
  Return its original checked System call, with arguments still bound once by
  the surrounding lets. Arbitrary Env calls and partial matches stay unchanged."
 [node native-modules]
 (when (and (= :if (:op node)) (contains? native-modules "System"))
  (let [available (:test node) bridge (:then node) fallback (:else node)
        ordinary (:then fallback) missing (:else fallback)
        operation (:fun ordinary) specification (get targets operation)
        target (first specification) arity (count (:args ordinary))
        absent (:test fallback) overlay (first (:args absent))]
   (when (and specification (contains? (second specification) arity)
              (remote? available :erlang :function_exported 3)
              (literal? (first (:args available)) :Elixir.BeamLisp.Env)
              (literal? (second (:args available)) target)
              (literal? (nth (:args available) 2) arity)
              (remote? bridge :Elixir.BeamLisp.Env target arity)
              (= :if (:op fallback)) (remote? ordinary :Elixir.System operation arity)
              (= (:args bridge) (:args ordinary))
              (remote? absent :erlang :== 2)
              (remote? overlay :erlang :get 1)
              (literal? (first (:args overlay)) :bl-osenv-overlay)
              (literal? (second (:args absent)) :undefined)
              (remote? missing :erlang :error 1)
              (literal? (first (:args missing)) :command_environment_host_unavailable))
    ;; Managed Source already requires this fixed host ABI. An older host
    ;; cannot select a raw-OS fallback and escape the command-local overlay.
    (when-not (erlang/function_exported :Elixir.BeamLisp.Env target arity)
     (throw (ex-info "System command environment host is unavailable"
                     {:kind :command-environment-host-unavailable})))
    (assoc ordinary :ann (:ann node))))))
