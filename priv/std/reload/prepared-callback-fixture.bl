; Native component fixture, not a resource/adoption authority. The intentionally
; unsafe private carrier tests that a late argument is refused before a public
; SDK callback observes it. No fake lease/table/graph or private app Source.
(ns reload.prepared-callback-fixture)
(defn- private-value [value] value)
(defn late-private-carrier []
 (let [definition (first (Map/fetch! (BeamLisp.Env/ns_defs "reload.prepared-callback-fixture") "private-value"))]
  (erlang/make_fun (elem definition 4) (elem definition 2)
                  (erlang/length (:params (elem definition 3))))))
(defn observe1 [calls value] (swap! calls inc) :observed)
(defn observe2 [calls left right] (swap! calls inc) :observed)
(defn observe3 [calls left right more] (swap! calls inc) :observed)
(defn compare-observed [calls left right] (swap! calls inc) 0)
(defn rest0 [args] (count args))
(defn rest1 [left args] [left (count args)])
(defn rest2 [left right args] [left right (count args)])
; Explicit native callback dispatch controls: the Source generator produces
; the argument AFTER the public helper's initial argument/capture validation.
(defn invoke-prepared1 [prepared generator]
 (erlang/apply prepared (list (generator))))
(defn invoke-prepared2 [prepared generator]
 (erlang/apply prepared (list 0 (generator))))
(defn add-one [value] (inc value))
(defn add-two [left right] (+ left right))
(defn benchmark-prepared [prepared arity repeats]
 (let [source? (BeamLisp.Env/source_execution_active?)
       before (elem (erlang/process_info (erlang/self) :reductions) 1)
       start (erlang/monotonic_time :microsecond)
       answer (loop [remaining repeats total 0]
                (if (zero? remaining) total
                 (recur (dec remaining)
                  (if (= arity 1) (erlang/apply prepared (list total))
                                 (erlang/apply prepared (list total 1))))))
       elapsed (- (erlang/monotonic_time :microsecond) start)
       after (elem (erlang/process_info (erlang/self) :reductions) 1)]
  {:source-active source? :answer answer :repeats repeats
   :elapsed-us elapsed :reductions (- after before)}))
