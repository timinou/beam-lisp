; Compiler-owned declarations. No datom/proc dependency and no global catalogue.
(ns reload.declaration
 (:require [env] [reload.execution :as execution] [reload.registry-data :as data]))

(def ^:private PREPARATION :reload.declaration/preparation)
(defn- refuse! [kind details]
 (throw (ex-info "Immutable executable declaration refused" (assoc details :kind kind))))
(defn- preparation []
 (let [p (Process/get PREPARATION)]
  (when (= (:scope p) (env/current)) p)))

(defn with-preparation!
 "Trusted compiler boundary. Declaration capture is temporary and scope-bound;
  restore it on failure as well as success. It never changes a serving catalogue."
 [mapping action]
 (let [previous (Process/get PREPARATION)
       p {:scope (env/current) :owners (into {} (map (fn [[logical physical]] [physical logical]) mapping))
          :descriptors (atom {})}]
  (try
   (Process/put PREPARATION p)
   (action)
   (finally
    (if (nil? previous) (Process/delete PREPARATION) (Process/put PREPARATION previous))))))

(defn expand-relation!
 "Used by the fixed SDK defrelation macro. Managed forms define one checked
  spec and one named callback;the caller writes the same declaration as before.
  Outside managed source returns nil so ordinary source/AOT registration works."
 [ident spec]
 (let [p (preparation) owner (BeamLisp.Env/current_ns) logical (get (:owners p) owner)]
  (when logical
   (when-not (keyword? ident) (refuse! :invalid-executable-declaration {:ident ident}))
   (let [suffix (sha256-hex (pr-str ident))
         value (str "__relation_value__" suffix) callback (str "__relation_provider__" suffix)
         key [:relation ident] descriptor {:kind :relation :id ident :owner owner :logical logical
                                           :value value :callback callback}]
    (when (contains? @(:descriptors p) key)
     (refuse! :duplicate-executable-declaration {:ident ident}))
    (swap! (:descriptors p) assoc key descriptor)
    (list 'do
     (list 'def (symbol value) spec)
     (list 'defn- (symbol callback) '[db mode bounds args]
       (list (list :provider (symbol value)) 'db 'mode 'bounds 'args)))))))

(defn- relation-data [ident spec]
 (when-not (and (map? spec) (fn? (:provider spec))
                (int? (:arity spec)) (pos? (:arity spec)) (<= (:arity spec) 64))
  (refuse! :invalid-executable-declaration {:ident ident}))
 (let [metadata (merge {:ident ident :extension :computed :modes #{:bf}
                        :maintenance :recompute :provenance false}
                       (dissoc spec :provider))
       modes (:modes metadata) reads (:reads metadata)]
  (when-not (and (= ident (:ident metadata)) (= :computed (:extension metadata))
                 (set? modes) (seq modes) (every? keyword? modes)
                 (contains? #{:recompute :incremental} (:maintenance metadata))
                 (boolean? (:provenance metadata))
                 (or (nil? reads) (and (or (set? reads) (vector? reads)) (seq reads) (every? keyword? reads))))
   (refuse! :invalid-executable-declaration {:ident ident}))
  ;; Reuse the same bounded nonexecutable-data check as configuration registries.
  (data/entry "declaration" {:metadata metadata})
  metadata))

(defn collect!
 "Collect only descriptors emitted during this compiler preparation. Values
  have already passed actual ANF initializer checks. No global table snapshot."
 []
 (let [p (preparation)]
  (when-not p (refuse! :missing-declaration-preparation {}))
  {:relation
   (into {} (map (fn [[[_ ident] descriptor]]
                 (let [{:keys [owner logical value callback]} descriptor
                       spec (BeamLisp.Env/fetch_exact! owner value)
                       provider (BeamLisp.Env/fetch_exact! owner callback)]
                  (when-not (fn? provider) (refuse! :invalid-executable-declaration {:ident ident}))
                  [ident {:data (relation-data ident spec) :callback (str logical "/" callback)}]))
             @(:descriptors p)))}))

(defn entries [kind]
 (get (:declarations (execution/current)) kind {}))

(defn lookup
 "Resolve one immutable entry against its exact graph;no global fallback.
  A returned callback acquires its ordinary execution lease when called later."
 [kind ident]
 (let [g (execution/current) descriptor (get (entries kind) ident)]
  (when descriptor
   (assoc (:data descriptor) :provider
    (fn [& args] (execution/invoke! g (:callback descriptor) args))))))

(defn stamp []
 (let [g (execution/current)] (when g (tuple :sealed-declarations (:scope g) (:digest g)))))

(defn managed? [] (some? (execution/current)))
(defn require-development!
 "Runtime registration cannot mutate any serving/candidate graph."
 []
 (when (managed?) (refuse! :immutable-declaration-required {})))
