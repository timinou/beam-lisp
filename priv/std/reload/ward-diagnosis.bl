; Optional process synthesis, loaded only for a failing defserver test.
(ns reload.ward-diagnosis (:require [system.core :as sys] [z3]))
(defn diagnose [procs]
  (let [port (z3/open)]
    (some (fn [node]
              (let [r (sys/repair-process port node)]
                (when (and (:checked r) (seq (:repairs r))) r))) procs)))
