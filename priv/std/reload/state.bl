; Initializer-owned managed cells and environment-owned development state.
(ns reload.state (:require [reload.execution :as generation] [env]))

(defn- cell? [value]
 (and (erlang/is_map value)
      (= :Elixir.BeamLisp.Atom (maps/get :__struct__ value nil))))

(defn- managed-cell [key]
 (let [cell (generation/runtime-resource key)]
  (when-not (cell? cell)
   (throw (ex-info "Managed runtime resource must be an Atom" {:kind :invalid-runtime-cell :resource key})))
  cell))

(defn- storage-key [key] (tuple :reload.state/value key))
(defn- own-value [key] (BeamLisp.Env/lookup_own (storage-key key)))
(defn- alive! [result]
 (when (= :retired result)
  (throw (ex-info "Runtime state environment has been destroyed" {:kind :retired-runtime-state})))
 result)

(defn get
 "Read an existing managed cell, or this environment's development value.
  Missing managed resources always refuse. Development never reads through
  another environment or a VM-global persistent_term fallback."
 ([key] (get key nil))
 ([key default]
  (if (generation/current) @(managed-cell key)
   (let [result (own-value key)]
    (if (= :error result) default (elem result 1))))))

(defn cell!
 "Return an initializer-bound managed Atom. Development cells are installed
  once in the current environment under its native lifetime/commit fence.
  They survive source reloads in that environment and are released from its
  registry on destruction. Explicit IO/process cleanup remains the owner's job."
 [key initial]
 (if (generation/current) (managed-cell key)
  (alive!
   (BeamLisp.Env/with_scope_commit (env/current)
    (fn []
     (let [result (own-value key) existing (when-not (= :error result) (elem result 1))]
      (cond
       (cell? existing) existing
       (some? existing)
        (throw (ex-info "Runtime cell has a different value" {:kind :invalid-runtime-cell :resource key}))
       :else (let [cell (atom initial)]
               (alive! (BeamLisp.Env/put_key (storage-key key) cell)) cell))))))))

(defn put!
 "Update a managed cell with bounded nonexecutable state. Development writes
  remain in the current environment and cannot outlive its destruction."
 [key value]
 (if (generation/current)
  (do
   (when-not (generation/runtime-value? value)
    (throw (ex-info "Managed state cannot retain executable values" {:kind :invalid-runtime-state :resource key})))
   (reset! (managed-cell key) value))
  (do (alive! (BeamLisp.Env/put_key (storage-key key) value)) value)))

(defn bind!
 "Bind the complete initializer-owned cell map once before publication. The
  caller owns cell cleanup; callers cannot add resources to a serving graph."
 [cells]
 (when-not (and (map? cells) (every? cell? (vals cells)))
  (throw (ex-info "Runtime state bindings must be Atom cells" {:kind :invalid-runtime-cells})))
 (generation/bind-runtime! cells))

(defn get-and-update!
 "Atomically return a result and replace an initializer-owned cell. Action is
  pure and returns (tuple result next-value); contention may re-run it. Only
  bounded nonexecutable data/handles may be retained. No callback-owning actor
  is created, and the caller keeps its exact generation and authority context."
 [key initial action]
 (when-not (fn? action)
  (throw (ex-info "State update requires an action" {:kind :invalid-runtime-update})))
 (let [cell (cell! key initial)]
  (loop []
   (let [before @cell outcome (action before)]
    (when-not (and (tuple? outcome) (= 2 (erlang/tuple_size outcome)))
     (throw (ex-info "State update requires a result/value pair" {:kind :invalid-runtime-update})))
    (let [after (elem outcome 1)]
     (when-not (generation/runtime-value? after)
      (throw (ex-info "State cannot retain executable values" {:kind :invalid-runtime-state :resource key})))
     (if (compare-and-set! cell before after) (elem outcome 0) (recur)))))))
