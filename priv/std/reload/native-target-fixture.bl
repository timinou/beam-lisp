; Ordinary firstparty SDK fixture for native target admission. No initializer
; callback, process, resource, cache edit, or lease is created by this unit.
(ns reload.native-target-fixture)
(defn- private-step [x] (+ x 2))
(defn public-step [x] (private-step x))
(defn local-callback [] (fn [x] (private-step x)))
(defn named-callback [] private-step)
(defn captured-callback [f] (partial f))
(defn internal-private-map [xs] (into [] (map private-step xs)))
(defn overwritten [] :old)
(def ^:private overwritten overwritten)
(defn decode-term [bytes] (BeamLisp.Env/decode_data_term! bytes))
(defrecord PublicRecord [value])
(deftype PublicType [value])
(defrecord ^:private PrivateRecord [value])
