; Actual managed Source transport callsites; SDK native grants remain exact.
; Before-effect raw bounded transport-data guard; no protocol dispatch.
(ns reload.source-guard
 (:require [reload.execution :as execution] [reload.generation :as generation]))
(defn- refuse [kind]
 (throw (ex-info "Managed Source producer refused"
                 {:kind kind :contract "runtime.producers"})))
(defn- budget [] {:nodes (atom 32768) :bytes (atom 67108864)})
(defn- account! [limits bytes]
 (when (or (neg? (swap! (:nodes limits) dec))
           (neg? (swap! (:bytes limits) - bytes)))
  (refuse :managed-native-data-budget)))
(defn- scalar? [v]
 (or (erlang/== v nil) (erlang/is_atom v)
     (erlang/is_number v) (erlang/is_binary v)))
(defn- data!
 "One request shares one node/byte/depth budget, including repeated binaries.
  Native tuples are only transport carriers, never executable/capability grants."
 [value limits]
 (letfn [(walk [v depth]
          (when (> depth 64) (refuse :managed-native-data-budget))
          (account! limits (if (erlang/is_binary v) (erlang/byte_size v) 8))
          (cond
           (scalar? v) :valid
           (erlang/is_list v)
            (loop [tail v]
             (when-not (erlang/== tail (list))
              (when-not (erlang/is_list tail) (refuse :invalid-managed-native-data))
              (walk (erlang/hd tail) (inc depth))
              (recur (erlang/tl tail))))
           (erlang/is_tuple v)
            (do
             (when (and (erlang/== 3 (erlang/tuple_size v))
                        (erlang/== :"$blfn" (erlang/element 1 v)))
              (refuse :unowned-managed-native-capability))
             (loop [i 1]
              (when (<= i (erlang/tuple_size v))
               (walk (erlang/element i v) (inc depth)) (recur (inc i)))))
           (erlang/is_map v)
            (if (maps/is_key :__struct__ v)
             (let [tag (maps/get :__struct__ v)]
              (when-not (or (erlang/== :Elixir.BeamLisp.Vector tag)
                            (erlang/== :Elixir.BeamLisp.Set tag))
               (refuse :unowned-managed-native-capability))
              ;; Reuse the native raw canonical-storage checker, never Vector/
              ;; Set/Enumerable methods. Forged tags/storage still refuse.
              (when (or (<= @(:nodes limits) 0) (<= @(:bytes limits) 0)
                        (>= depth 64))
               (refuse :managed-native-data-budget))
              (let [cost (BeamLisp.CompilerData/first_order_cost! v
                           {:max-nodes @(:nodes limits)
                            :max-bytes @(:bytes limits) :max-depth (- 64 depth)})]
               (swap! (:nodes limits) - (:nodes cost))
               (swap! (:bytes limits) - (:bytes cost))))
             (loop [it (maps/iterator v)]
              (let [part (maps/next it)]
               (when-not (erlang/== :none part)
                (walk (erlang/element 1 part) (inc depth))
                (walk (erlang/element 2 part) (inc depth))
                (recur (erlang/element 3 part))))))
           :else (refuse :unowned-managed-native-capability)))]
  (walk value 0) :valid))
(defn- arity! [args]
 ;; Never call length/count/Enumerable on an unchecked or unbounded term.
 (loop [tail args n 0]
  (cond
   (erlang/== tail (list)) n
   (or (not (erlang/is_list tail)) (>= n 5))
    (refuse :invalid-managed-http-arity)
   :else (recur (erlang/tl tail) (inc n)))))
(defn- options! [options limits]
 (loop [tail options left 128]
  (when-not (erlang/== tail (list))
   (when-not (erlang/is_list tail) (refuse :invalid-managed-http-options))
   (when (zero? left) (refuse :managed-native-data-budget))
   (account! limits 16)
   (let [entry (erlang/hd tail)]
    (when-not (and (erlang/is_tuple entry)
                   (erlang/== 2 (erlang/tuple_size entry))
                   (erlang/is_atom (erlang/element 1 entry)))
     (refuse :invalid-managed-http-options))
    (let [key (erlang/element 1 entry) value (erlang/element 2 entry)]
     (if (erlang/== :receiver key)
      ;; Native aliases, foreign PIDs, Fn and MFA receivers need a separately
      ;; retained SDK owner. Only this caller's actual PID is supported here.
      (when-not (erlang/== (erlang/self) value)
       (refuse :unowned-http-callback))
      (data! value limits)))
    (recur (erlang/tl tail) (dec left)))))
 :valid)
(defn validate-http!
 "Read-only component seam. Fixed finite data/same-caller transport only.
  Source Fn/MFA receivers/body generators refuse BEFORE native request.
  This function inspects data; it grants no network or execution authority."
 [args]
 (let [n (arity! args) limits (budget)]
  ;; Arity has proved a proper list of at most five elements.
  (case n
   1 (data! (erlang/hd args) limits)
   2 (do (data! (erlang/hd args) limits)
         (data! (erlang/hd (erlang/tl args)) limits))
   4 (do (doseq [v (take 3 args)] (data! v limits))
         (options! (nth args 3) limits))
   5 (do (doseq [v (take 3 args)] (data! v limits))
         (options! (nth args 3) limits) (data! (nth args 4) limits))
   (refuse :invalid-managed-http-arity)))
 :valid)
(defn- native-grant! [module]
 (BeamLisp.Env/assert_execution_context!)
 (when-not (execution/owned?) (refuse :managed-source-execution-required))
 (let [g (generation/attested-prepared! (execution/current))
       name (String/replace_prefix (erlang/atom_to_binary module :utf8) "Elixir." "")]
  (when-not (contains? (:native-modules g) name)
   (refuse :undeclared-native-target))))
(defn http-request!
 "Compiler-specialized managed Source route. SDK internals keep their audited
  ownership contract. No implicit retry, initialization or callback replay."
 [args]
 (native-grant! :httpc)
 (validate-http! args)
 (erlang/apply :httpc :request args))
