; Bounded first-order construction proof over exact compiled ANF.
; Private SDK identities and fresh factory receipts are supplied by preparation.
(ns reload.collection-constructor
 (:require [system.ir :as ir] [reload.closed-function :as closed]
           [data.first-order :as data] [reload.source-producer :as producer]
           [reload.native-call :as native-call]))
(defn- refuse! [reason]
 (throw (ex-info "Finite constructor remains unproved" {:kind :unproved-collection-constructor :reason reason})))
(defn- bounded [kind nodes bytes]
 (when (or (> nodes 131072) (> bytes 8388608) (< nodes 1) (< bytes 0)) (refuse! :output-budget))
 {:kind kind :nodes nodes :bytes bytes})
(defn- data? [shape]
 (contains? #{:nil :scalar :symbol :map :list :vector :set :sequence :data} (:kind shape)))
(defn- data! [shape] (when-not (data? shape) (refuse! :latent-or-opaque-result)) shape)
(defn- sequence? [shape]
 (contains? #{:nil :list :vector :set :sequence :recipe} (:kind shape)))
(defn- nil-shape [] {:kind :nil :nodes 1 :bytes 4 :exact nil :length 0 :minimum 0})
(declare join)
(defn- joined [shapes] (reduce (fn [out item] (if out (join out item) item)) nil shapes))
(defn- seq-shape [kind items]
 (let [items (vec items) n (count items)]
  (assoc (bounded kind (+ 8 (reduce + 0 (map :nodes items)))
                        (+ 256 (* 32 n) (reduce + 0 (map :bytes items))))
         :length n :minimum n :items items :element (or (joined items) (nil-shape)))))
(defn- map-shape [pairs]
 (let [parts (vec pairs) fields (into {} (map (fn [[k v]] [(:exact k) v])
                                 (filter (fn [[k _]] (contains? k :exact)) parts)))]
  (assoc (bounded :map (+ 1 (reduce + 0 (mapcat (fn [[k v]] [(:nodes k) (:nodes v)]) parts)))
                       (+ 128 (* 32 (count parts))
                          (reduce + 0 (mapcat (fn [[k v]] [(:bytes k) (:bytes v)]) parts))))
         :length (count parts) :minimum (count fields) :fields fields
         :key (or (joined (map first parts)) (nil-shape))
         :value (or (joined (map second parts)) (nil-shape)))))
(defn join [a b]
 (when (or (contains? #{:closure :factory} (:kind a)) (contains? #{:closure :factory} (:kind b)))
  (refuse! :callable-branch-union))
 (when (and (or (= :recipe (:kind a)) (= :recipe (:kind b)))
            (not (and (sequence? a) (sequence? b)))) (refuse! :latent-branch-union))
 (let [base (bounded (if (= (:kind a) (:kind b)) (:kind a) :data)
                     (max (:nodes a) (:nodes b)) (max (:bytes a) (:bytes b)))]
  (cond
   (and (= (:kind a) (:kind b)) (contains? a :exact) (contains? b :exact) (= (:exact a) (:exact b)))
    (assoc base :exact (:exact a))
   (and (sequence? a) (sequence? b))
    (assoc base :kind (cond (or (= :recipe (:kind a)) (= :recipe (:kind b))) :recipe
                             (= (:kind a) (:kind b)) (:kind a) :else :sequence)
           :length (max (or (:length a) 0) (or (:length b) 0))
           :minimum (min (or (:minimum a) 0) (or (:minimum b) 0))
           :element (join (or (:element a) (nil-shape)) (or (:element b) (nil-shape))))
   (and (= :map (:kind a)) (= :map (:kind b)))
    (assoc base :fields (into {} (map (fn [key]
                                  [key (join (get (:fields a) key (nil-shape))
                                             (get (:fields b) key (nil-shape)))])
                                   (set (concat (keys (:fields a)) (keys (:fields b))))))
           :length (max (:length a) (:length b)) :minimum (min (:minimum a) (:minimum b))
           :key (join (:key a) (:key b)) :value (join (:value a) (:value b)))
   :else base)))

(defn sdk-targets
 "Trusted-parent only. Exact definition receipts, including actual body routes
  and arities. Native Set/new and Vector/new are the fixed compiler-owned
  constructors from the coherent SDK floor; their generic Enumerable routes
  are allowed ONLY for proved proper eager lists. Root must pin this registry
  to its native SDK source/floor witness. Registry is private generation
  metadata; application evidence is never accepted here. No module-prefix or
  source-name purity rules."
 []
 (reduce
  (fn [out [namespace definition arity operation]]
   (reduce (fn [m entry]
             (let [clause (elem entry 3) fname (elem entry 2)
                   body (when (> (erlang/tuple_size entry) 4) (elem entry 4))]
              (if (and (= :fixed (elem entry 0)) (= :defn-clause (:op clause))
                       (= arity (count (:params clause))))
               (reduce (fn [table module] (assoc table [module fname arity] operation)) m
                       (distinct (filter some? [(BeamLisp.Emit/module_for namespace) body]))) m)))
           out (BeamLisp.Env/ns_definition namespace definition)))
  {[:Elixir.BeamLisp.Set :new 0] :empty-set
   [:Elixir.BeamLisp.Set :new 1] :literal-set
   [:Elixir.BeamLisp.Vector :new 1] :literal-vector}
  [["core" "vals" 1 :values] ["core" "keys" 1 :keys]
      ["core" "into" 2 :into] ["core" "mapv" 2 :mapv] ["rt" "map" 2 :map]
      ["core" "to-list" 1 :to-list] ["core" "vec" 1 :vec]
      ["rt" "set" 1 :set] ["rt" "conj" 1 :identity] ["rt" "conj" 2 :conj]
      ["rt" "get" 2 :get] ["rt" "get" 3 :get] ["rt" "nth" 2 :nth] ["rt" "nth" 3 :nth]
      ["rt" "first" 1 :first] ["core" "second" 1 :second] ["rt" "count" 1 :count]
      ["rt" "assoc" 3 :assoc] ["rt" "hash_key" 1 :identity]]))

(defn- inner! [node]
 (cond
  (= :fn (:op node)) node
  (ir/self-scaffold? node)
   (let [outer (:init node) clause (first (:clauses outer)) body (:body node)
         args (:args body) inner (ir/scaffold-inner node) self (:name node)]
    (when-not (and (= 1 (count (:pats clause))) (nil? (:guard clause))
                   (= :pvar (:pop (first (:pats clause)))) (= self (:name (first (:pats clause))))
                   (= 1 (count args)) (= :var (:op (first args))) (= self (:name (first args)))
                   (= :fn (:op inner))) (refuse! :unproved-function-scaffold)) inner)
  :else (refuse! :unproved-function-constructor)))

(defn- shape-with-context!
 "Bounded abstract interpretation of actual ANF and trusted first-order globals.
  Never execute candidate code or force supplied lazy/protocol values. Named
  bodies come from exact selected snapshot entries, anonymous constructors use
  closed-function free-variable proof, and all immediate body paths are walked
  under bounded argument/capture shapes before map/mapv can apply them. Unknown
  operations, cycles, open captures and escaping recipes/functions refuse."
 [expression context]
 (let [remaining (atom 131072) sdk (:sdk context) factories (:factories context)
       factory-globals (:factory-globals context) allowed (:allowed-globals context)]
  (letfn [(spend! [depth]
           (when (or (> depth 64) (neg? (swap! remaining dec))) (refuse! :analysis-budget)))
          (raw [value depth]
           (spend! depth)
           (cond
            (erlang/== nil value) (nil-shape)
            (erlang/is_list value)
             (seq-shape :list (loop [xs value out []]
                               (if (erlang/== (list) xs) out
                                (recur (erlang/tl xs) (conj out (raw (erlang/hd xs) (inc depth)))))))
            (erlang/is_map value)
             (if (erlang/is_map_key :__struct__ value)
              (case (erlang/map_get :__struct__ value)
               :Elixir.BeamLisp.Vector
                (seq-shape :vector (mapv #(raw % (inc depth)) (BeamLisp.Vector/to_list value)))
               :Elixir.BeamLisp.Set
                (let [entries (erlang/map_get :map (erlang/map_get :members value))]
                 (seq-shape :set (mapv #(raw % (inc depth)) (maps/keys entries))))
               (refuse! :foreign-struct))
              (map-shape (loop [it (maps/iterator value) out []]
                          (let [entry (maps/next it)]
                           (if (erlang/== :none entry) out
                            (recur (erlang/element 3 entry)
                                   (conj out [(raw (erlang/element 1 entry) (inc depth))
                                              (raw (erlang/element 2 entry) (inc depth))])))))))
            (erlang/is_tuple value) (bounded :symbol 2 (erlang/external_size value))
            :else (assoc (bounded :scalar 1 (erlang/external_size value)) :exact value)))
          (literal [value depth]
           (data/check! value (or (:literal-budget context)
                                  {:max-nodes 32768 :max-depth 64 :max-bytes 1048576}))
           (raw value depth))
          (key! [node locals active depth]
           (let [shape (walk node locals active depth)]
            (data! shape)
            (when-not (and (contains? shape :exact) (not= :__struct__ (:exact shape)))
             (refuse! :dynamic-or-struct-key)) shape))
          (closure [node locals]
           (let [inner (inner! node) captures (into {} (filter (fn [[_ value]] (data? value)) locals))
                 names (vec (keys captures))
                 lifted (assoc inner :clauses
                          (mapv (fn [clause]
                                  (assoc clause :pats
                                    (concat (map (fn [name] {:pop :pvar :name name}) names) (:pats clause))))
                                (:clauses inner)))]
            ;; This proves the real constructor/free-variable boundary. Empty
            ;; footprint or closedness alone does NOT prove callback effects.
            (when (some #(> (count (:pats %)) 255) (:clauses lifted))
             (refuse! :capture-arity-budget))
            (closed/declaration "finite_constructor_callback" lifted)
            {:kind :closure :node inner :bindings captures}))
          (nth-shape [source index default]
           (when-not (and (sequence? source) (contains? index :exact)
                          (int? (:exact index)) (>= (:exact index) 0)) (refuse! :unproved-nth))
           (let [i (:exact index) n (or (:length source) 0) minimum (or (:minimum source) 0)]
            (cond
             (>= i n) (or default (refuse! :nth-out-of-bounds))
             (< i minimum) (or (get (:items source) i) (:element source) (nil-shape))
             default (join (or (:element source) (nil-shape)) default)
             :else (refuse! :nth-may-be-out-of-bounds))))
          (lookup-shape [source key default]
           (data! source) (data! key)
           (let [default (or default (nil-shape))]
            (cond
             (and (= :map (:kind source)) (contains? key :exact))
              (get (:fields source) (:exact key) (join (or (:value source) (nil-shape)) default))
             (and (sequence? source) (contains? key :exact) (int? (:exact key)) (>= (:exact key) 0))
              (nth-shape source key default)
             :else (join (bounded :data (:nodes source) (:bytes source)) default))))
          (clauses! [clauses arguments captures active depth]
           (let [matching (filter #(= (count arguments) (count (or (:params %) (:pats %)))) clauses)]
            (when-not (seq matching) (refuse! :unproved-call-arity))
            (or (joined
             (mapv (fn [clause]
                     (let [params (or (:params clause) (:pats clause))]
                      (when-not (every? #(= :pvar (:pop %)) params) (refuse! :unproved-parameter-pattern))
                      (let [bindings (reduce (fn [out [param value]] (assoc out (:name param) value)) captures
                                             (map (fn [param value] [param value]) params arguments))]
                       (when (:guard clause) (data! (walk (:guard clause) bindings active (inc depth))))
                       (walk (producer/initialization-body (:body clause)) bindings active (inc depth))))) matching)) (nil-shape))))
          (factory! [target arguments active depth]
           ;; Ordinary factories consume first-order values. Callable operands
           ;; belong only to the exact SDK collection callback boundary.
           (doseq [argument arguments] (data! argument))
           (when (contains? active target) (refuse! :recursive-factory))
           (let [clauses (get factories target)]
            (when-not (seq clauses) (refuse! :unknown-factory))
            (clauses! clauses arguments {} (conj active target) (inc depth))))
          (invoke! [callee arguments active depth]
           (cond
            (= :closure (:kind callee))
             (clauses! (:clauses (:node callee)) arguments (:bindings callee) active (inc depth))
            (= :factory (:kind callee))
             (let [target (get (:arities callee) (count arguments))]
              (when-not target (refuse! :unproved-call-arity))
              (factory! target arguments active depth))
            (and (= :scalar (:kind callee)) (contains? callee :exact)
                 (erlang/is_atom (:exact callee)) (not (contains? #{nil true false} (:exact callee))))
             (do (when-not (<= 1 (count arguments) 2) (refuse! :keyword-arity))
                 (lookup-shape (first arguments) callee (second arguments)))
            :else (refuse! :dynamic-callback)))
          (sequence! [value]
           (when-not (sequence? value) (refuse! :unproved-finite-sequence)) value)
          (materialize [kind source]
           (sequence! source)
           (assoc (bounded kind (+ 8 (* 2 (:nodes source)))
                                (+ 256 (:bytes source) (* 64 (:nodes source))))
                  :length (or (:length source) 0) :minimum (if (= kind :set) 0 (or (:minimum source) 0))
                  :element (or (:element source) (nil-shape))))
          (construct [operation arguments active depth]
           (let [a (first arguments) b (second arguments) c (nth arguments 2 nil)]
            (case operation
             :identity (data! a)
             :empty-set (seq-shape :set [])
             :literal-set (do (when-not (= :list (:kind a)) (refuse! :native-constructor-input))
                              (materialize :set a))
             :literal-vector (do (when-not (= :list (:kind a)) (refuse! :native-constructor-input))
                                 (materialize :vector a))
             :values (do (when-not (= :map (:kind a)) (refuse! :projection-requires-map))
                         (assoc a :kind :recipe :element (:value a) :recipe :values))
             :keys (do (when-not (= :map (:kind a)) (refuse! :projection-requires-map))
                       (assoc a :kind :recipe :element (:key a) :recipe :keys))
             :set (materialize :set a)
             :vec (materialize :vector a)
             :to-list (materialize :list a)
             :into
              (do (when-not (contains? #{:nil :list :vector :set} (:kind a)) (refuse! :into-target))
                  (data! a) (sequence! b)
                  (let [kind (if (= :nil (:kind a)) :list (:kind a))]
                   (assoc (bounded kind (+ 8 (:nodes a) (* 2 (:nodes b)))
                                         (+ 256 (:bytes a) (:bytes b) (* 64 (:nodes b))))
                          :length (+ (or (:length a) 0) (or (:length b) 0))
                          :minimum (if (= kind :set) 0 (+ (or (:minimum a) 0) (or (:minimum b) 0)))
                          :element (cond (= 0 (or (:length a) 0)) (or (:element b) (nil-shape))
                                         (= 0 (or (:length b) 0)) (or (:element a) (nil-shape))
                                         :else (join (or (:element a) (nil-shape)) (or (:element b) (nil-shape)))))))
             :conj
              (do (data! b) (when-not (contains? #{:nil :list :vector :set} (:kind a)) (refuse! :conj-target))
                  (assoc (bounded (if (= :nil (:kind a)) :list (:kind a))
                                   (+ 8 (:nodes a) (* 2 (:nodes b))) (+ 256 (:bytes a) (:bytes b)))
                         :length (inc (or (:length a) 0))
                         :minimum (if (= :set (:kind a)) 0 (inc (or (:minimum a) 0)))
                         :element (if (= :nil (:kind a)) b (join (:element a) b))))
             :mapv
              (do (sequence! b)
                  (let [result (data! (invoke! a [(or (:element b) (nil-shape))] active (inc depth)))
                        n (or (:length b) 0)]
                   (assoc (bounded :vector (+ 8 (* n (:nodes result)))
                                           (+ 256 (* n (+ 32 (:bytes result)))))
                          :length n :minimum (or (:minimum b) 0) :element result)))
             :map (assoc (construct :mapv arguments active depth) :kind :recipe :recipe :closed-map)
             :get (lookup-shape a b c)
             :nth (nth-shape a b c)
             :first (nth-shape (sequence! a) (literal 0 depth) (nil-shape))
             :second (nth-shape (sequence! a) (literal 1 depth) (nil-shape))
             :count (do (when-not (or (sequence? a) (= :map (:kind a))) (refuse! :count-shape))
                        (let [base (assoc (bounded :scalar 1 16) :minimum-value (or (:minimum a) 0)
                                          :maximum-value (or (:length a) 0))]
                         (if (= (:minimum a) (:length a)) (assoc base :exact (:length a)) base)))
             :assoc
              (do (when-not (= :map (:kind a)) (refuse! :assoc-target))
                  (when-not (and (contains? b :exact) (not= :__struct__ (:exact b))) (refuse! :assoc-key))
                  (data! c)
                  (assoc (bounded :map (+ 2 (:nodes a) (:nodes b) (:nodes c))
                                      (+ 64 (:bytes a) (:bytes b) (:bytes c)))
                         :length (inc (:length a)) :minimum (:minimum a)
                         :fields (assoc (:fields a) (:exact b) c)
                         :key (join (:key a) b) :value (join (:value a) c)))
             (refuse! :unknown-operation))))
          (walk [node locals active depth]
           (spend! depth)
           (when-not (erlang/is_map node) (refuse! :invalid-ir))
           (let [node (producer/analysis-node node)]
           (if (or (= :fn (:op node)) (ir/self-scaffold? node)) (closure node locals)
            (let [call (ir/call-site node)]
             (if (and call (contains? #{:invoke :apply} (:mode call)))
              (do (when (nil? (:arity call)) (refuse! :dynamic-arity))
                  (invoke! (walk (:callee call) locals active (inc depth))
                           (mapv #(walk % locals active (inc depth)) (:args call)) active (inc depth)))
              (case (:op node)
               :lit (literal (:val node) (inc depth))
               :enil (seq-shape :list [])
               :global
                (do (when-not (contains? allowed (:ns node)) (refuse! :unsealed-global))
                 (if-let [arities (get factory-globals [(:ns node) (:name node)])]
                  {:kind :factory :arities arities}
                  (let [found (BeamLisp.Env/fetch_exact (:ns node) (:name node))]
                   (when-not (and (erlang/is_tuple found) (= :ok (elem found 0))) (refuse! :missing-global))
                   (literal (elem found 1) (inc depth)))))
               :var (or (get locals (:name node)) (refuse! :unbound-local))
               :let (walk (:body node) (assoc locals (:name node) (walk (:init node) locals active (inc depth))) active (inc depth))
               :if (do (data! (walk (:test node) locals active (inc depth)))
                       (join (walk (:then node) locals active (inc depth)) (walk (:else node) locals active (inc depth))))
               :do (or (last (mapv #(walk % locals active (inc depth)) (:stmts node))) (nil-shape))
               :map (map-shape (mapv (fn [[k v]] [(key! k locals active (inc depth))
                                                  (data! (walk v locals active (inc depth)))]) (:pairs node)))
               :cons
                (let [head (data! (walk (:head node) locals active (inc depth))) tail (walk (:tail node) locals active (inc depth))]
                 (when-not (= :list (:kind tail)) (refuse! :improper-list))
                 (if (:items tail) (seq-shape :list (cons head (:items tail)))
                  (assoc (bounded :list (+ 1 (:nodes head) (:nodes tail)) (+ 16 (:bytes head) (:bytes tail)))
                         :length (inc (:length tail)) :minimum (inc (:minimum tail))
                         :element (join head (:element tail)))))
               :struct
                (let [fields (:fields node) field (first fields) storage (second field)]
                 (when-not (and (= :Elixir.BeamLisp.Vector (:mod node)) (= 1 (count fields))
                                (= :lit (:op (first field))) (= :items (:val (first field)))
                                (= :tuple (:op storage))) (refuse! :opaque-struct))
                 (seq-shape :vector (mapv #(data! (walk % locals active (inc depth))) (:elems storage))))
               :remote
                (let [target [(:mod call) (:fun call) (:arity call)]
                      args (mapv #(walk % locals active (inc depth)) (:args call))]
                 (if-let [operation (get sdk target)] (construct operation args active (inc depth))
                  (factory! target args active (inc depth))))
               (refuse! :unsupported-node)))))))]
   (data! (walk expression {} #{} 0)))))

(defn shape!
 ([expression context] (shape-with-context! expression context))
 ([expression targets allowed-globals]
  ;; Preserve the original focused public helper's smaller literal boundary.
  (shape-with-context! expression
    {:sdk targets :allowed-globals allowed-globals :factories {} :factory-globals {}
     :literal-budget {:max-nodes 4096 :max-depth 32 :max-bytes 262144}})))

(defn proved?
 ([expression targets allowed-globals]
  (try (shape! expression targets allowed-globals) true
   (catch error
    (if (contains? #{:unproved-collection-constructor :unsafe-first-order-data
                    :dynamic-executable-registration} (:kind (ex-data error)))
     false (throw error)))))
 ([expression context]
  (try (shape! expression context) true
   (catch error
    (if (contains? #{:unproved-collection-constructor :unsafe-first-order-data
                    :dynamic-executable-registration} (:kind (ex-data error)))
     false (throw error))))))
