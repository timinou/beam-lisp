; Finite collection initializer proof; opaque inputs never gain forcing authority.
; Shape evidence is separate from effects: vals creates a finite, trusted
; recipe only for a checked plain map; set may force exactly that recipe.
(ns reload.collection-constructor
 (:require [system.ir :as ir] [data.first-order :as data]))

(defn- refuse! [reason]
 (throw (ex-info "Unproved finite collection constructor"
                 {:kind :unproved-collection-constructor :reason reason})))

(defn sdk-targets
 "Capture exact compiler-selected SDK routes in the trusted parent environment
  BEFORE preparing application namespaces. The caller owns this evidence; an
  application cannot supply a same-named namespace or target registry. Body
  module routes come from actual definition receipts, never name-prefix rules."
 []
 (reduce
  (fn [out [namespace definition arity operation]]
   (reduce
    (fn [targets entry]
     (let [clause (elem entry 3) function (elem entry 2)
           body (when (> (erlang/tuple_size entry) 4) (elem entry 4))]
      (if (and (= :fixed (elem entry 0)) (= :defn-clause (:op clause))
               (= arity (count (:params clause))))
       (reduce (fn [m module] (assoc m [module function arity] operation)) targets
               (distinct (filter some? [(BeamLisp.Emit/module_for namespace) body]))) targets)))
    out (BeamLisp.Env/ns_definition namespace definition)))
  {} [["core" "vals" 1 :values] ["core" "keys" 1 :keys]
      ["rt" "set" 1 :set] ["rt" "conj" 1 :identity] ["rt" "conj" 2 :conj]
      ["rt" "hash_key" 1 :identity]]))

(defn- bounded
 ([kind nodes] (bounded kind nodes (* 64 nodes)))
 ([kind nodes bytes]
  (when (or (not (int? nodes)) (< nodes 1) (> nodes 16384)) (refuse! :output-node-limit))
  (when (or (not (int? bytes)) (< bytes 0) (> bytes 1048576)) (refuse! :output-byte-limit))
  {:kind kind :nodes nodes :bytes bytes}))
(defn- first-order? [shape]
 (contains? #{:nil :scalar :map :list :vector :set :symbol :data} (:kind shape)))
(defn- require-data! [shape]
 (when-not (first-order? shape) (refuse! :latent-or-opaque-data)) shape)

(defn- literal-shape [value]
 ;; This raw validator rejects forged collection structs, functions, native
 ;; handles and LazySeq WITHOUT seq/Enumerable/protocol/callback dispatch.
 (data/check! value {:max-nodes 4096 :max-depth 32 :max-bytes 262144})
 ;; Conservative uniform bound is intentionally independent of user equality,
 ;; custom hashing or enumerable implementations. Tight bounds can be obtained
 ;; by sharing first-order's existing raw traversal; this draft does not fork it.
 (bounded
  (cond (erlang/== nil value) :nil
        (erlang/is_list value) :list
        (erlang/is_map value)
         (if (erlang/is_map_key :__struct__ value)
          (case (erlang/map_get :__struct__ value)
           :Elixir.BeamLisp.Vector :vector :Elixir.BeamLisp.Set :set
           (refuse! :opaque-struct)) :map)
        (erlang/is_tuple value) :symbol :else :scalar)
  (if (or (erlang/is_list value) (erlang/is_map value)) 4096 1)
  ;; external_size is safe ONLY after bounded raw validation above. This does
  ;; not dispatch collection protocols or force thunks.
  (erlang/external_size value)))

(defn- literal-map-key! [node targets]
 (let [call (ir/call-site node)
       key (if (and call (= :remote (:mode call))
                    (= :identity (get targets [(:mod call) (:fun call) (:arity call)]))
                    (= :hash_key (:fun call))) (first (:args call)) node)]
  (when-not (= :lit (:op key)) (refuse! :dynamic-map-key))
  (when (= :__struct__ (:val key)) (refuse! :opaque-struct))
  (literal-shape (:val key))))

(defn shape!
 "Infer a finite constructor from actual executable ANF. This draft accepts
  closed first-order literals/globals, lexical let/if/do, collection assembly
  and exact parent-captured SDK vals/keys/set/conj routes. It never evaluates
  an initializer, executes a callback, forces a supplied lazy value or calls
  a user protocol. A trusted finite projection recipe cannot escape: only
  set consumes it, and the root result must be eager first-order data. Unknown
  nodes/arity/dynamic callees/recursive helpers fail closed."
 [expression targets allowed-globals]
 (let [remaining (atom 8192)]
  (letfn [(walk [node locals depth]
           (when (or (> depth 32) (neg? (swap! remaining dec))) (refuse! :analysis-budget))
           (when-not (erlang/is_map node) (refuse! :invalid-ir))
           (case (:op node)
            :lit (literal-shape (:val node))
            :enil (bounded :list 1)
            :global
             (let [_ (when-not (contains? allowed-globals (:ns node))
                       (refuse! :unsealed-global))
                   found (BeamLisp.Env/fetch_exact (:ns node) (:name node))]
              (when-not (and (erlang/is_tuple found) (= :ok (elem found 0)))
               (refuse! :missing-global))
              (literal-shape (elem found 1)))
            :var (or (get locals (:name node)) (refuse! :unbound-variable))
            :let (walk (:body node) (assoc locals (:name node) (walk (:init node) locals (inc depth)))
                       (inc depth))
            :if
             (do (require-data! (walk (:test node) locals (inc depth)))
              (let [a (walk (:then node) locals (inc depth)) b (walk (:else node) locals (inc depth))]
               (if (= (:kind a) (:kind b)) (bounded (:kind a) (max (:nodes a) (:nodes b)) (max (:bytes a) (:bytes b)))
                (do (require-data! a) (require-data! b)
                    (bounded :data (max (:nodes a) (:nodes b)) (max (:bytes a) (:bytes b)))))))
            :do (let [results (mapv #(walk % locals (inc depth)) (:stmts node))]
                  (or (last results) (bounded :nil 1)))
            :map
             (let [parts (mapv (fn [pair]
                           [(literal-map-key! (first pair) targets)
                            (require-data! (walk (second pair) locals (inc depth)))]) (:pairs node))
                   nodes (+ 1 (reduce + 0 (mapcat (fn [[k v]] [(:nodes k) (:nodes v)]) parts)))
                   bytes (+ 64 (reduce + 0 (mapcat (fn [[k v]] [32 (:bytes k) (:bytes v)]) parts)))]
              (bounded :map nodes bytes))
            :cons
             (let [head (require-data! (walk (:head node) locals (inc depth)))
                   tail (walk (:tail node) locals (inc depth))]
              (when-not (= :list (:kind tail)) (refuse! :improper-list))
              (bounded :list (+ 1 (:nodes head) (:nodes tail)) (+ 16 (:bytes head) (:bytes tail))))
            :struct
             (let [fields (:fields node) field (first fields) storage (second field)]
              (when-not (and (= :Elixir.BeamLisp.Vector (:mod node)) (= 1 (count fields))
                             (= :lit (:op (first field))) (= :items (:val (first field)))
                             (= :tuple (:op storage))) (refuse! :opaque-struct))
              (let [items (mapv #(require-data! (walk % locals (inc depth))) (:elems storage))]
               (bounded :vector (+ 4 (reduce + 0 (map :nodes items)))
                                (+ 128 (reduce + 0 (map :bytes items))))))
            :remote
             (let [call (ir/call-site node)
                   operation (get targets [(:mod call) (:fun call) (:arity call)])
                   args (mapv #(walk % locals (inc depth)) (:args call))
                   source (first args) item (second args)]
              (case operation
               :identity (require-data! source)
               :values (do (when-not (= :map (:kind source)) (refuse! :projection-requires-plain-map))
                           (bounded :finite-projection (:nodes source) (:bytes source)))
               :keys (do (when-not (= :map (:kind source)) (refuse! :projection-requires-plain-map))
                         (bounded :finite-projection (:nodes source) (:bytes source)))
               :set (do (when-not (contains? #{:nil :list :vector :set :finite-projection} (:kind source))
                          (refuse! :unproved-sequence))
                        (bounded :set (+ 8 (* 2 (:nodes source))) (+ 256 (:bytes source) (* 128 (:nodes source)))))
               :conj (do (require-data! item)
                         (when-not (contains? #{:nil :list :vector :set} (:kind source))
                          (refuse! :unsupported-conj-shape))
                         (bounded (if (= :nil (:kind source)) :list (:kind source))
                                  (+ 4 (:nodes source) (* 2 (:nodes item)))
                                  (+ 256 (:bytes source) (:bytes item))))
               (refuse! :unproved-remote)))
            (refuse! :unproved-node)))]
   (require-data! (walk expression {} 0)))))

(defn proved? [expression targets allowed-globals]
 (try (shape! expression targets allowed-globals) true
  (catch error
   (if (contains? #{:unproved-collection-constructor :unsafe-first-order-data} (:kind (ex-data error)))
    false (throw error)))))
