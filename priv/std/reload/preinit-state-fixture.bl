(ns reload.preinit-state-fixture (:require [reload.preinit-counter :as counter]))
;; Both these effects and the partial execute only during the first real init.
(def initialization (counter/mark! :state))
(defn- private-step [x y] (+ x y))
(def private-partial (partial private-step 10))
(def ^:private private-saved private-partial)
(defn callback [] private-saved)
(defn invoke [x] (private-saved x))
(defn initialization-count [] (counter/value :state))
