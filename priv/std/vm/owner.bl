; vm/owner.bl — an env owns the processes spawned under it.
;
; ══ THE MISSING PRIMITIVE ═══════════════════════════════════════════════════
;
; beam-lisp forks a capped env cheaply (env/fork), but nothing links an env to
; the SET OF PROCESSES spawned under it: `env/destroy` drops var rows and
; monitors NOTHING (see the Elixir daemon's own admission — a program's
; `System.halt` kills the whole VM because there is no env-scoped teardown).
;
; `owner` closes that gap with the registry pattern (reg.bl) keyed by VM id:
; every process spawned as a member of a VM is REGISTERED and MONITORED, so its
; entry retracts itself on death (the VM keeps the relation true for us), and
; tearing a VM down is `halt` over exactly that VM's live set — never the node.
;
; This is the whole reason the bug classes vanish:
;   · a runaway/`halt`ing command tears down ITS vm, the node lives  → no DoS
;   · a crashed member retracts itself                               → no leak
;   · membership is a QUERY, not a mailbox                           → no scan
;
;   (owner/start)                     ; once per node — the registry
;   (owner/spawn vm role thunk)       ; spawn a MEMBER of `vm`, env conveyed
;   (owner/spawn-in vm role e thunk)  ; … under the VM's OWN capped env `e`
;   (owner/procs vm)                  ; → [pid …]      the live set
;   (owner/count vm)                  ; → n
;   (owner/halt vm)                   ; → {:halted n}  tear down exactly `vm`

(ns vm.owner
  ;; `proc.reg` is required twice on purpose. The aliased form is DEMAND-DRIVEN
  ;; (nothing of `proc.reg` runs until a name from it is used), but the
  ;; `defserver` below needs its `registry` CLAUSE at load time, and a clause is
  ;; registered by `proc.reg`'s top-level forms. The bare form is eager and makes
  ;; that happen; the aliased one is how this file spells `reg/where`. Without it
  ;; this file loads only if something else happened to load `proc.reg` first.
  (:require [proc.reg] [proc.reg :as reg] [env] [proc.server]))

;; The one relation: pid ↔ {vm, role}. `where {:vm id}` is a VM's process set;
;; an entry retracts on the pid's :DOWN (reg monitors every registrant).
(proc.server/defserver proc-relation (registry (keys :vm :role :since)))

(def REGISTRY :vm-owner-procs)

(defn start
  "Start the ownership registry (idempotent by name). One per node."
  []
  (if (nil? (Process/whereis REGISTRY))
    (core/start proc-relation nil {:name REGISTRY})
    (Process/whereis REGISTRY)))

(defn adopt
  "Make an ALREADY-RUNNING `pid` a member of VM `vm` under `role`.

   `spawn` and `spawn-in` are this plus the spawn: a process another module
   started (a server, a wheel, a side-app) still belongs to the VM whose work it
   does, and must therefore be registered the same way — the registry monitors
   it, so its entry retracts on death and `halt` takes it down with the VM.
   Idempotent: registering a pid twice is one entry, and starting the registry
   twice is one registry (which is why this is callable on its own: an adopter
   should not have to know that someone else already started it)."
  [vm role pid]
  (start)
  ;; `:since` is when it joined, in unix seconds: the BEAM keeps no start time per
  ;; process, and `bl realm members` shows how long each member has run
  (reg/register REGISTRY pid {:vm vm :role role :since (erlang/system_time :second)})
  pid)

(defn spawn
  "Spawn `thunk` as a MEMBER of VM `vm` under `role`. The language `spawn`
   conveys the caller's env (caps + heap bound ride along), and the child is
   registered+monitored so it counts toward `vm` and retracts on death.
   Returns the pid."
  [vm role thunk]
  (adopt vm role (core/spawn thunk)))

(defn spawn-in
  "Like `spawn`, but run the member under VM `vm`'s OWN env `e` (its caps + heap
   ceiling), not merely the caller's. The spawn happens INSIDE `e`: the language's
   spawn conveys the env it is called in AND sets the child's `max_heap_size` from
   it, which binding `e` in the child afterwards does not (measured: the member's
   flag stayed 0 and a 30M-element hog ran unkilled). Returns the pid."
  [vm role e thunk]
  (adopt vm role (env/with-env e (fn [] (core/spawn thunk)))))

(defn procs
  "The live pids of VM `vm`."
  [vm]
  (reg/where REGISTRY {:vm vm}))

(defn members
  "What VM `vm` owns, as [{:pid :role :since}]: one row per live member, in no
   particular order. The registry holds the attributes; this reads them, so the
   list and the count can never disagree (one query, one source)."
  [vm]
  (vec (map (fn [e] (assoc (:attrs e) :pid (:pid e))) (reg/entries REGISTRY {:vm vm}))))

(defn procs-except
  "The live pids of VM `vm` whose role is not in `roles` (a set). The registry
   answers per role, so this is the VM's members minus those of each excluded role."
  [vm roles]
  (let [all (procs vm)
        skip (set (mapcat (fn [r] (reg/where REGISTRY {:vm vm :role r})) (seq roles)))]
    (filter (fn [pid] (not (contains? skip pid))) all)))

(defn count
  "How many live processes VM `vm` owns."
  [vm]
  (core/count (procs vm)))

(defn halt
  "Tear down every process VM `vm` owns — and only those. Returns
   {:halted n}. The node, the manager, and every other VM are untouched;
   each killed pid's entry retracts itself via the monitor. Idempotent:
   halting an empty VM is {:halted 0}."
  [vm]
  (let [pids (procs vm)]
    (doseq [p pids] (erlang/exit p :kill))
    {:halted (core/count pids)}))
