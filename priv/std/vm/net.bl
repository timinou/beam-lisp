; vm/net.bl — the AF_UNIX transport for a warm VM (ports Daemon.Listener).
;
; ══ WHAT MOVED HERE (FUP-082 T2/D2-D3) ══════════════════════════════════════
;
; The socket the daemon binds, the accept loop, the per-connection process, the
; 0600 perms guard, and the hello/token handshake — all beam-lisp now. Proven
; end-to-end: a bl server accepts a {packet,4} connection, decodes a frame with
; vm.wire, and frames a response back (see the net round-trip proof).
;
; It lives in `vm.*` because it is runtime substrate any host reuses, and —
; critically (K10: namespace state does NOT survive a hot reload) — the LISTEN
; SOCKET is owned by a long-lived process started via `listen`, NOT held as
; namespace state. A reload swaps the handler code; the socket and the accept
; loop keep running.
;
;   (net/listen root handler)   → {:ok listener} | {:error reason}
;       handler : (fn [frame conn-send] …)  called per decoded request frame;
;                 conn-send is (fn [bytes] …) to write a frame back.
;       {:error :already-running} when a LIVE daemon already answers on this
;       endpoint — the caller attaches to it; it is not a failure to report.
;   (net/answering? sock-path)  → true | false   does anything accept there?
;   (net/stop listener)         → :ok
;
; ══ ONE DAEMON PER ENDPOINT, EXACTLY ════════════════════════════════════════
;
; A unix socket is a FILE, and binding over a file that exists is not an error
; here: `listen` used to unlink the path and bind, so a second start for the
; same endpoint took the path from the first (measured: both `listen`s returned
; {:ok …}, both accept loops lived, the path reached the second, and the first
; kept running unreachable). Two things close it:
;
;   • the bind happens under the endpoint's `.start` lock — an exclusive create,
;     held for milliseconds, so two starters take turns instead of racing;
;   • inside the lock the existing path is PROBED, not trusted: something that
;     accepts is a live daemon (→ :already-running); something that refuses is
;     the leftover of a crash and is reclaimed.
;
; A lock whose holder died inside its millisecond section is recovered by age
; (LOCK-STALE-MS), so a crash can delay a start but never wedge it.

(ns vm.net
  (:require [vm.wire :as wire] [vm.paths :as paths]))

(def LISTEN-BACKLOG
  "How many connections may wait to be accepted. The OS default is a handful, and a
   burst of requests (a test run starting, an editor and a build at once) overflows it:
   the surplus connects are reset before the VM ever sees them. Measured: 80 simultaneous
   clients, 5 of 6 bursts lost between 1 and 27 of them at the default; none lost at 128.
   One connection is one short-lived process, so a deep queue costs nothing."
  128)

(defn- listen-opts [charlist]
  ;; Erlang 2-tuple opts (NEVER bl maps — a bl-map opt gives {:exit :badarg}).
  (list (tuple :inet_backend :inet)
        :local
        (tuple :ifaddr (tuple :local charlist))
        :binary
        (tuple :packet 4)
        (tuple :active false)
        (tuple :backlog LISTEN-BACKLOG)
        (tuple :reuseaddr true)))

(defn- connect-opts []
  (list (tuple :inet_backend :inet) :local :binary (tuple :packet 4) (tuple :active false)))

;; How long a starter waits for another starter's bind to finish, how often it
;; looks, and how old a lock must be before its holder is presumed dead. The wait
;; is generous (a bind takes milliseconds; a loaded host stretches it), the stale
;; age is longer than any honest hold.
(def LOCK-WAIT-MS 5000)
(def LOCK-POLL-MS 25)
(def LOCK-STALE-MS 15000)
(def PROBE-TIMEOUT-MS 500)

(defn answering?
  "Whether anything accepts connections at the unix socket `sock-path`. A refused
   connect is the honest proof a socket is dead: the file's existence proves
   nothing, because a crashed daemon leaves it behind."
  [sock-path]
  (let [r (gen_tcp/connect (tuple :local (erlang/binary_to_list sock-path)) 0
            (connect-opts) PROBE-TIMEOUT-MS)]
    (if (= :ok (elem r 0))
      (do (gen_tcp/close (elem r 1)) true)
      false)))

;; ── the start lock ──────────────────────────────────────────────────────────

(defn- now-ms [] (erlang/system_time :millisecond))

(defn- take-lock
  "Create `path` exclusively, recording who and when. :ok | {:error reason}."
  [path]
  (let [r (erlang/apply :file :open
            (list (erlang/binary_to_list path) (to-list [:write :exclusive :binary])))]
    (if (= :ok (elem r 0))
      (let [fd (elem r 1)]
        (erlang/apply :file :write
          (list fd (str (erlang/apply :os :getpid (list)) " " (now-ms))))
        (erlang/apply :file :close (list fd))
        :ok)
      {:error (elem r 1)})))

(defn- lock-age-ms
  "How long ago `path` was taken, from the timestamp it carries; nil when it is
   unreadable or gone (a lock being released is not an old lock)."
  [path]
  (let [r (try (File/read! path) (catch e nil))]
    (if (erlang/is_binary r)
      (let [parts (erlang/apply :binary :split (list r " "))]
        (if (= 2 (count parts))
          (try (- (now-ms) (erlang/binary_to_integer (nth parts 1))) (catch e nil))
          nil))
      nil)))

(defn- acquire-lock
  "Take the start lock, waiting up to LOCK-WAIT-MS. A lock older than
   LOCK-STALE-MS belonged to a starter that died mid-bind and is removed."
  [path]
  (let [deadline (+ (now-ms) LOCK-WAIT-MS)]
    (loop []
      (let [r (take-lock path)]
        (cond
          (= :ok r) :ok
          (not= :eexist (:error r)) {:error (tuple :start-lock (:error r))}
          (let [age (lock-age-ms path)] (and age (> age LOCK-STALE-MS)))
            (do (File/rm path) (recur))
          (> (now-ms) deadline) {:error :start-lock-timeout}
          :else (do (erlang/apply :timer :sleep (list LOCK-POLL-MS)) (recur)))))))

(defn- with-start-lock
  "Run `f` holding the endpoint's start lock; release it however `f` ends.
   {:error …} when the lock could not be had."
  [path f]
  (let [l (acquire-lock path)]
    (if (= :ok l)
      (try (f) (finally (File/rm path)))
      l)))

(defn- frame-recv [conn timeout-ms]
  (let [r (gen_tcp/recv conn 0 timeout-ms)]
    (if (= :ok (elem r 0)) {:ok (elem r 1)} {:error (elem r 1)})))

(defn- frame-send [conn payload]
  (gen_tcp/send conn payload))

;; ── the per-connection handler ──────────────────────────────────────────────
;;
;; hello first (authenticated: the token file's bytes must match), then a
;; request loop. The connection process owns its socket for its whole life; it
;; dies when the client disconnects, taking nothing else with it.

(defn- serve-conn [conn expect token handler mine]
  (let [hello (frame-recv conn 5000)]
    (when (some? (:ok hello))
      (let [decoded (wire/decode (:ok hello))
            frame (:ok decoded)]
        (if (and (some? frame) (= :hello (elem frame 0)))
          (let [m (elem frame 1)
                given (:token m)
                tree (:tree m)
                asked (:build m)]
            (cond
              (not (and (erlang/is_binary given)
                        (= (erlang/byte_size given) (erlang/byte_size token))
                        (erlang/apply :crypto :hash_equals (list given token))
                        (= tree expect)))
              (frame-send conn (wire/reject :unauthorized "bad token or wrong tree" {}))

              ;; A client that names a build is told when this is not it. The
              ;; endpoint names already carry the build, so reaching here means
              ;; a file was renamed or a client computed the name by hand; the
              ;; answer is the same either way: this VM must not run its command.
              (and (some? asked) (not= asked mine))
              (frame-send conn (wire/reject :restart_required
                                 (str "this daemon runs build " mine ", not " asked)
                                 {:build mine}))

              :else
              (do
                ;; ready — the handshake meta. No queue/busy (PLAN-121): attach.
                (frame-send conn (wire/ready {:pid (erlang/list_to_binary (erlang/apply :os :getpid (list)))
                                              :build mine
                                              :queue_depth 0 :busy nil}))
                (serve-requests conn handler))))
          (frame-send conn (wire/reject :malformed "expected hello" {})))))))

;; ── a client that went away is told to the request ─────────────────────────
;;
;; One request per connection, and after the request is read nothing reads the
;; socket again, so a client killed mid-command (timeout -s KILL, Ctrl+C, a closed
;; terminal) was never noticed: its command ran on, holding whatever it held. A
;; watcher now polls the socket and, when the peer is gone, sends the request process
;; `:client_gone`. It does not kill anything itself: the handler decides how to stop
;; its command and runs its own cleanup (see `vm.session/dispatch-command`), because
;; killing a process from outside skips its `finally`.
;;
;; The poll is a zero-length `recv` with a short timeout on a passive socket: it
;; consumes nothing (the client sends no further frame on this connection) and
;; returns `{:error :closed}` the moment the peer is gone.

(def CLIENT-POLL-MS 200)
(def CLIENT-GONE :client_gone)

(defn client-gone?
  "Whether the peer of `conn` has closed it. Consumes nothing."
  [conn]
  (let [r (gen_tcp/recv conn 0 CLIENT-POLL-MS)]
    (and (= :error (elem r 0)) (not= :timeout (elem r 1)))))

(defn- watch-client
  "Spawn a watcher that sends `worker` `:client_gone` once `conn`'s peer closes, and
   ends by itself when `worker` does. Returns the watcher's pid."
  [conn worker]
  (spawn (fn []
           (loop []
             (cond
               (client-gone? conn) (erlang/send worker CLIENT-GONE)
               (erlang/is_process_alive worker) (recur)
               :else :ok)))))

(defn- serve-requests [conn handler]
  (let [req (frame-recv conn 1800000)]  ; 30min read window (a test can run long)
    (when (some? (:ok req))
      (let [decoded (wire/decode (:ok req))
            frame (:ok decoded)
            watcher (watch-client conn (erlang/self))]
        ;; :request → the command handler; :control → status/stop
        (when (some? frame)
          (handler frame (fn [bytes] (frame-send conn bytes))))
        (erlang/exit watcher :kill)
        ;; one request per connection (the launcher opens a fresh conn each time)
        (gen_tcp/close conn)))))

;; ── the accept loop (a long-lived process, NOT namespace state) ─────────────

(defn await-connection-start
  "Internal handoff worker. Only the transferring parent may release serving.
   Parent death before release ends the worker and closes any transferred socket."
  [parent ticket conn serve]
  (let [ref (erlang/monitor :process parent)]
    (try
      (receive
        [:connection-start received] :when (= received ticket)
        (do (erlang/demonitor ref (list :flush)) (serve))
        [:DOWN received :process _pid _reason] :when (= received ref)
        :parent-stopped)
      (finally
        (erlang/demonitor ref (list :flush))
        (gen_tcp/close conn)))))

(defn handoff-connection
  "Internal ownership boundary: serving starts only after a successful transfer.
   The acceptor subscribes to no worker notifications. Failure closes both sides."
  [conn serve]
  (let [parent (erlang/self) ticket (erlang/make_ref)
        worker (spawn (fn [] (await-connection-start parent ticket conn serve)))]
    (try
      (let [result (gen_tcp/controlling_process conn worker)]
        (if (= :ok result)
          (do (erlang/send worker (tuple :connection-start ticket)) {:ok worker})
          (do (gen_tcp/close conn) (erlang/exit worker :kill) {:error result})))
      (catch error
        (gen_tcp/close conn)
        (erlang/exit worker :kill)
        (throw error)))))

(defn- accept-loop [lsock expect token handler build]
  (let [ar (gen_tcp/accept lsock 5000)]
    (cond
      (= :ok (elem ar 0))
      (do
        (let [conn (elem ar 1)]
          (handoff-connection conn (fn [] (serve-conn conn expect token handler build))))
        (accept-loop lsock expect token handler build))

      ;; timeout is normal — loop again so the process stays responsive to stop
      (= :timeout (elem ar 1))
      (accept-loop lsock expect token handler build)

      ;; listener closed (stop) — exit the loop
      :else :stopped)))

(defn- bind-endpoint
  "Bind `sock-path`, chmod it, mint the token if absent, start accepting, and
   write the meta. Called only under the start lock, after the path was probed.
   `expect` is the hello :tree value a client must present."
  [root expect handler paths-map]
  (let [sock-path (:sock paths-map)
        token-path (:token paths-map)
        charlist (erlang/binary_to_list sock-path)]
    ;; reaching here means nothing answers: whatever file is at the path is the
    ;; leftover of a daemon that died without unlinking it
    (File/rm sock-path)
    (let [lr (gen_tcp/listen 0 (listen-opts charlist))]
      (if (not= :ok (elem lr 0))
        {:error (elem lr 1)}
        (let [lsock (elem lr 1)]
          (try
            (File/chmod sock-path 384)  ; 0o600
            (when (not (File/exists? token-path))
              (File/write! token-path (erlang/apply :crypto :strong_rand_bytes (list 32)))
              (File/chmod token-path 384))
            ;; Publish endpoint metadata before releasing acceptance. Identity
            ;; and listening-socket lifetime belong to the bound acceptor.
            (let [token (File/read! token-path) build (:build paths-map)]
              (write-meta! (:meta paths-map) root build)
              (let [handed (handoff-connection lsock
                             (fn [] (accept-loop lsock expect token handler build)))
                    pid (:ok handed)]
                (if pid
                  {:ok {:lsock lsock :pid pid :sock-path sock-path
                        :token-path token-path :meta-path (:meta paths-map)}}
                  (do (File/rm sock-path) (File/rm (:meta paths-map)) handed))))
            (catch error
              (gen_tcp/close lsock)
              (File/rm sock-path)
              (File/rm (:meta paths-map))
              (throw error))))))))

(defn listen
  "Bind the daemon socket for `root` and accept connections, dispatching each
   decoded request frame to `handler` (fn [frame conn-send]). Returns
   {:ok {:lsock :pid :sock-path}} | {:error reason}. The socket is chmod 0600 —
   the security boundary is file perms + the hello token.

   `opts` {:shared true} binds the SHARED endpoint of this build, which serves
   every shared project of the user and needs no `root` (pass nil): the realm is
   chosen per request. Without it the endpoint is the one for `root`.

   One daemon per endpoint: when a live daemon already answers there, returns
   {:error :already-running} and touches nothing of it."
  ([root handler] (listen root handler {}))
  ([root handler opts]
   (let [shared (= true (get opts :shared))
         build (paths/build-id)
         ep (paths/endpoints root build shared)]
     (if (nil? (:ok ep))
       ep
       (let [paths-map (:ok ep)
             expect (paths/hello-fingerprint root build shared)]
         (with-start-lock (:lock paths-map)
           (fn []
             (if (answering? (:sock paths-map))
               {:error :already-running}
               (bind-endpoint root expect handler paths-map)))))))))

(defn- write-meta!
  "Publish complete endpoint metadata or raise, removing scratch on failure."
  [path root build]
  (let [tmp (str path ".tmp." (erlang/apply :os :getpid (list)))]
    (try
      (File/write! tmp (erlang/term_to_binary
                         {:pid (erlang/list_to_integer (erlang/apply :os :getpid (list)))
                          :root root :build build
                          :started_at (erlang/system_time :second)}))
      (File/chmod tmp 384)
      (File/rename! tmp path)
      (finally (File/rm tmp)))))

(defn read-meta
  "The `.meta` term at `path` ({:pid :root :build :started_at}), or nil when it
   is absent or not one."
  [path]
  (let [r (try (File/read! path) (catch e nil))
        term (if (erlang/is_binary r) (try (erlang/binary_to_term r) (catch e nil)) nil)]
    (if (and (map? term) (contains? term :build) (contains? term :root)) term nil)))

(defn stop
  "Stop a listener: close the socket (ends the accept loop) and unlink every
   endpoint file it wrote, so a stopped daemon leaves nothing behind."
  [listener]
  (gen_tcp/close (:lsock listener))
  (File/rm (:sock-path listener))
  (when (:token-path listener) (File/rm (:token-path listener)))
  (when (:meta-path listener) (File/rm (:meta-path listener)))
  :ok)
