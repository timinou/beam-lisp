; vm/core.bl — a project VM as data, and its lifecycle.
;
; ══ WHAT A VM IS ════════════════════════════════════════════════════════════
;
; A "VM" here is NOT a separate BEAM node — it is a first-class ENVIRONMENT
; (env/fork of a warm base) plus the set of processes owned under it
; (vm.owner) plus a routing identity (an id + hostnames). One node hosts many;
; the isolation is the env (vars/caps/heap ceiling), and the teardown is
; vm.owner/halt over the owned set. This is the whole point: the concurrency
; and isolation the old Elixir daemon faked with a single serial worker are
; here just BEAM processes under a capped env, and the BEAM manages them.
;
; A VM value (pure data, so it prints, diffs, and travels):
;
;   {:id       "blueprint@main"     ; routing identity (project [+ instance])
;    :root     "/home/…/blueprint"  ; the checkout it serves
;    :base     :blueprint           ; the warm base env it forked from (or :global)
;    :env      {:env #Ref…}         ; its capped fork — the sandbox
;    :caps     [...]                ; the host-interop grant (never `System/halt`)
;    :status   :ready               ; :cold | :warming | :ready | :draining
;    :born-ms  173…}               ; monotonic birth, for uptime
;
; Lifecycle:
;   (core/spawn-vm spec)   → a VM value, env forked, owner registry ready
;   (core/serve vm role thunk)  → start a side-app member (web, runner, tooling)
;   (core/run vm src)      → run one command's source in the VM's env, scoped
;   (core/drain vm)        → tear the VM down (its processes, then its env)
;
; `spec` is what env.local.bl / env.bl declare, normalized:
;   {:id :root :base :caps :max-heap-words}

(ns vm.core
  (:require [vm.owner :as owner] [vm.scope :as scope] [vm.osenv :as osenv] [env]))

;; The one grant a project VM must NEVER carry: node-wide halt. A command that
;; wants to end its sandbox calls `vm.scope/halt`, which is substrate, not a
;; capability — so it is not in this list and cannot be.
(def SAFE-DENY [["Elixir.System" "exec"]])  ; documentation of intent; see caps below

(defn- vm-caps
  "The caps a VM's env is forked with. `:caps` from the spec, defaulting to a
   conservative set. `System/halt` is NOT reachable: we never grant the bare
   `System` module, only the op-scoped grants a project asks for — the compile
   gate then rejects `System/halt` inside the VM (op_of System :halt is nil, so
   an op-scoped System grant denies it)."
  [spec]
  (or (:caps spec) :all))

(def REALM-KEY-ROW :realm_key)
(def REALM-DECL-ROW :realm_decl)

(defn- mark-realm!
  "Record, IN the realm's env, whose it is: its key and what its project declares about
   the namespaces it owns. The loader reads both through the env chain, so they follow
   the env into every process spawned under it, and are gone with it when it is
   destroyed. A spec with no key (a test's bare spec) is no realm: nothing is recorded,
   and its loads behave as before."
  [e spec]
  (when (some? (:key spec))
    (env/with-env e
      (fn []
        (BeamLisp.Env/put_key (tuple REALM-KEY-ROW) (:key spec))
        (BeamLisp.Env/put_key (tuple REALM-DECL-ROW) (:decl spec))))))

(defn spawn-vm
  "Materialize a VM from `spec`. Forks a capped env off the warm `:base` (or
   :global), readies the owner registry, and returns the VM value with status
   :ready. Does not start any side-app — see `serve`."
  [spec]
  (owner/start)
  (let [base (or (:base spec) :global)
        caps (vm-caps spec)
        heap (:max-heap-words spec)
        e (if (nil? heap)
            (env/fork base {:caps caps})
            (env/fork base {:caps caps :max-heap-words heap}))]
    (mark-realm! e spec)
    {:id (:id spec)
     :key (:key spec)
     :alias (:alias spec)
     :decl (:decl spec)
     :root (:root spec)
     ;; the tree's declared periodic work rides on the VM value: the manager arms
     ;; it from here (`vm.sched/start-for` reads `:schedules`), so a VM that drops
     ;; the key silently arms nothing
     :schedules (:schedules spec)
     :base base
     :env e
     :caps caps
     :status :ready
     :born-ms (System/monotonic_time :millisecond)}))

(defn serve
  "Start a long-lived side-app as a MEMBER of `vm` under `role`, running its
   thunk in the VM's own env. This is how a web app, a dev tool, or an armed
   scenario runner joins the VM: it is owned, so `drain` tears it down, and it
   is capped, so it cannot exceed the VM's ceilings. Returns the pid."
  [vm role thunk]
  (owner/spawn-in (:id vm) role (:env vm) thunk))

(defn run
  "Run one command's `thunk` in `vm`'s env, scoped to `vm` so a `vm.scope/halt`
   inside it tears down only this VM. Returns the thunk's value. The command
   runs in the CALLING process (the router's per-request worker) under the VM's
   env — concurrency across commands is many such workers, one per request,
   each isolated by its VM's env; there is no single serial worker.

   3-arg form binds `os-env` (a {name → value} map, the CLIENT's environment)
   as this process's PROCESS-LOCAL env overlay — never the node-global OS table
   — so two concurrent commands with different env do not race. Read it inside
   the command with `vm.osenv/get`."
  ([vm thunk]
   (scope/with-vm (:id vm)
     (fn [] (env/with-env (:env vm) thunk))))
  ([vm os-env thunk]
   (scope/with-vm (:id vm)
     (fn [] (env/with-env (:env vm)
              (fn [] (osenv/with-env os-env thunk)))))))

(defn- realm-modules
  "The modules a realm owns: every loaded module named under `BeamLisp.Ns.R<key>.`,
   `BeamLisp.Ns.Fn.R<key>.` or `BeamLisp.Server.R<key>.` (its own and shadowed namespaces,
   their body modules, and their servers)."
  [key]
  (let [prefixes [(str "Elixir.BeamLisp.Ns.R" key ".")
                  (str "Elixir.BeamLisp.Ns.Fn.R" key ".")
                  (str "Elixir.BeamLisp.Ns.Body.R" key ".")
                  (str "Elixir.BeamLisp.Ns.Init.R" key ".")
                  (str "Elixir.BeamLisp.Server.R" key ".")]]
    (filter (fn [m]
              (let [n (Atom/to_string m)]
                (some (fn [p] (String/starts_with? n p)) prefixes)))
            (map first (code/all_loaded)))))

(defn- retire-module!
  "Retire code without killing a caller that still executes it. A busy old
   version keeps its code lease; module publication will refuse a third version."
  [mod]
  (if (code/soft_purge mod)
    (do (code/delete mod) (code/soft_purge mod))
    false))

(defn- purge-realm-modules!
  "Retire a closed realm's namespace, body and initializer modules. Ownership
   shutdown is asynchronous, so a busy code version is retained, never hard-purged.
   Reuse numbered body names only when all code leases have ended."
  [key]
  (let [inventory (tuple :vm_retired_modules key)
        ;; Deleted modules with busy old code disappear from code/all_loaded.
        ;; Retain their identity until soft_purge confirms the lease has ended.
        mods (vec (distinct (concat (persistent_term/get inventory []) (realm-modules key))))
        results (mapv (fn [mod] [mod (retire-module! mod)]) mods)
        retained (mapv first (filterv (fn [entry] (= false (get entry 1))) results))]
    (if (empty? retained)
      (do (persistent_term/erase inventory)
          (BeamLisp.Emit/reset_body_sequence (str "R" key)))
      (persistent_term/put inventory retained))
    (- (count mods) (count retained))))

(defn drain
  "Tear `vm` down: kill every process it owns, destroy its env, and delete the modules
   its own namespaces compiled into. Returns {:halted n :purged n}. The node and every
   other VM are untouched."
  [vm]
  (let [r (owner/halt (:id vm))]
    (env/destroy (:env vm))
    (assoc r :purged (if (some? (:key vm)) (purge-realm-modules! (:key vm)) 0))))

(defn uptime-ms
  "How long `vm` has been alive."
  [vm]
  (- (System/monotonic_time :millisecond) (:born-ms vm)))
