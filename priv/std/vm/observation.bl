; Bounded projections over vm.owner: no process registry, monitors or scheduler.
; A trusted host captures a scope and exposes only that projection to clients.
; This module does not grant or replace host authentication/capability checks.
(ns vm.observation
 (:require [vm.owner :as owner] [vm.scope :as scope] [vm.manager :as manager]
           [runtime.observation :as observation]))
(defn capture
 "Capture the hosting realm; foreground observations cover only this process.
  Passing this value to another host process preserves the selected scope."
 [] {:realm (scope/current) :foreground (erlang/self) :sequence (atom 0) :epoch (pr-str (erlang/make_ref))})
(defn- row [member]
 (let [pid (:pid member)
       info (erlang/process_info pid (list :status :memory :reductions :message_queue_len))]
  (merge {:id (pr-str pid) :kind "process" :role (str (:role member))
          :title (str (:role member)) :since (:since member)
          :owner (:realm member) :available (erlang/is_list info)}
         (when (erlang/is_list info)
          (into {} (map (fn [pair] [(elem pair 0) (elem pair 1)]) info))))))
(defn query
 "Read a bounded owner projection without advancing the delivery sequence."
 ([captured] (query captured observation/max-resources))
 ([captured requested]
  (let [limit (observation/bounded-limit requested) realm (:realm captured)
        sample (if realm (owner/sample-members realm limit)
                 {:members [{:pid (:foreground captured) :role :foreground}] :total 1 :examined 1})
        members (:members sample) total (:total sample)
        vm (when (and realm (Process/whereis manager/MANAGER)) (manager/get-vm realm))
        rows (mapv (fn [m] (row (assoc m :realm (or realm "foreground")))) (take limit members))
        issuer (str "beam-" (System/pid))]
   (assoc (observation/envelope "beam" {:runtime issuer :epoch (:epoch captured) :realm (or realm "foreground")}
             0 0 rows total)
    :vm {:id issuer :pid (System/pid) :memory (erlang/memory :total)
         :processes (erlang/system_info :process_count)}
    :realm {:id (or realm "foreground") :title (or (:alias vm) (if realm realm "Foreground host"))
            :members total}
    :services (mapv (fn [[slot service]] {:id (pr-str slot) :pid (pr-str (:pid service))
                :status (if (Process/alive? (:pid service)) "live" "retired")}) (take limit (:services vm)))
    :query {:examined (:examined sample) :indexed (boolean realm)}
    :services-truncated (> (count (:services vm)) limit)))))

(defn snapshot
 "Stamp a query with this reader's sequence and wall time; this is a control
  effect on the reader, distinct from the read-only ownership query."
 ([captured] (snapshot captured observation/max-resources))
 ([captured requested]
  (assoc (query captured requested)
    :sequence (swap! (:sequence captured) inc)
    :sampled-at (erlang/system_time :millisecond))))
