; vm/client.bl — the `bl realm` lifecycle from the CLI (ports Daemon facade).
;
; The three verbs a terminal (and the launcher) drive:
;
;   (client/start-foreground root)  → become the daemon (blocks). The launcher
;      runs this detached; `bl realm start` in a terminal runs it foreground.
;   (client/status root)            → connect, print the daemon's status. 0/1.
;   (client/stop root)              → ask the daemon to drain and exit. 0/1.
;   (client/probe root)             → {:ok ready-meta} | {:error reason}, the
;      launcher's fast path and start's double-start guard.
;
; start becomes a pure-beam-lisp SESSION (vm.session composes vm.net + vm.io +
; vm.manager + bl.daemon/handle-in-vm); status/stop/probe are ordinary clients
; speaking vm.wire frames over the AF_UNIX socket — the SAME path a real client
; runs, so they exercise the transport end to end.

(ns vm.client
  (:require [vm.session :as session] [vm.paths :as paths] [vm.wire :as wire]))

(def CONNECT-TIMEOUT 500)
(def PT-STOP (tuple :vm_session :stop))

;; ── start (become the daemon) ───────────────────────────────────────────────

(defn start-foreground
  "Run as the warm VM for `root` (default: the cwd's tree), blocking until
   a :control :stop frame flips the stop flag, or the idle clock `opts` {:idle
   seconds} arms runs out. If one is already up for this tree, prints a notice
   and returns :already_running."
  ([root] (start-foreground root {}))
  ([root opts]
  (let [shared (= true (get opts :shared))
        root (if shared nil (or root (BeamLisp/cwd)))
        p (if shared (probe-shared) (probe root))]
    (if (contains? p :ok)
      (do (println (str "bl realm: already running for " (or root "the shared VM"))) :already_running)
      (let [r (session/start root opts)]
        (cond
          (contains? r :ok)
          (let [listener (:ok r)]
            (erlang/apply :persistent_term :put (list PT-STOP false))
            (wait-for-stop)
            (session/stop listener)
            :ok)
          ;; lost the race to another starter: that one IS the daemon, which is
          ;; what the caller wanted. Not a failure.
          (= :already-running (:error r))
          (do (println (str "bl realm: already running for " (or root "the shared VM"))) :already_running)
          :else
          (do (IO/puts :stderr (str "bl realm: failed to start: " (pr-str r)))
              {:error r})))))))

(defn- wait-for-stop []
  (if (erlang/apply :persistent_term :get (list PT-STOP false))
    :ok
    (do (erlang/apply :timer :sleep (list 200)) (wait-for-stop))))

;; ── the client side (status / stop / probe) ─────────────────────────────────

(defn- resolve-root [root]
  (or root (BeamLisp/cwd)))

(defn- do-connect [sock-path]
  (let [r (gen_tcp/connect (tuple :local (erlang/binary_to_list sock-path)) 0
            (to-list [(tuple :inet_backend :inet) :local :binary
                      (tuple :packet 4) (tuple :active false)])
            CONNECT-TIMEOUT)]
    (if (= :ok (elem r 0)) {:ok (elem r 1)} {:error (elem r 1)})))

(defn- recv-frame [sock]
  (let [r (gen_tcp/recv sock 0 10000)]
    (if (= :ok (elem r 0))
      {:ok (erlang/apply :erlang :binary_to_term (list (elem r 1)))}
      {:error (elem r 1)})))

(defn- connect-hello
  "Connect + the hello/token handshake; {:ok sock ready-meta} | {:error reason}.
   The 2-arg form dials the daemon of ANOTHER build — the one a machine-wide stop
   has to reach, since a daemon runs one build's code and answers to its own
   endpoint names."
  ([root] (connect-hello root nil))
  ([root build]
   (connect-hello* root build)))

(defn- connect-hello*
  "The handshake against an endpoint. `shared` picks the build's shared endpoint,
   which needs no `root`; the 2-arity asks the project's own declaration."
  ([root build] (connect-hello* root build (paths/shared? root (or build (paths/build-id)))))
  ([root build shared]
  (let [ep (paths/endpoints root (or build (paths/build-id)) shared)]
    (if (not (contains? ep :ok))
      {:error :no_endpoints}
      (let [em (:ok ep)]
        (if (not (File/exists? (:sock em)))
          {:error :no_socket}
          (let [token (File/read! (:token em))
                c (do-connect (:sock em))]
            (if (not (contains? c :ok))
              {:error (:error c)}
              (let [sock (:ok c)]
                (gen_tcp/send sock (erlang/apply :erlang :term_to_binary
                                     (list (tuple :bl 1 :hello {:tree (paths/hello-fingerprint root (:build em) (:shared em)) :token token
                                                                :build (:build em)}))))
                (let [f (recv-frame sock)]
                  (if (not (contains? f :ok))
                    (do (gen_tcp/close sock) {:error (:error f)})
                    (let [frame (:ok f) tag (elem frame 2)]
                      (cond
                        (= tag :ready) {:ok sock :ready (elem frame 3)}
                        (= tag :reject) (do (gen_tcp/close sock) {:error (tuple :reject (elem frame 3))})
                        :else (do (gen_tcp/close sock) {:error frame}))))))))))))))

(defn- drain-to-exit
  "Read frames for request `id`, writing stdout/stderr, until :exit. Answers HOW it
   ended: {:ok :exit} when the VM said it was done, {:error reason} when the
   connection ended without it (`:closed` when the VM went away, `:timeout` when it
   went quiet). Callers decide what each means for them (see `outcome`)."
  [sock id]
  (let [f (recv-frame sock)]
    (if (not (contains? f :ok))
      f
      (let [frame (:ok f) tag (elem frame 2)]
        (cond
          (and (= tag :stdout) (= (elem frame 3) id)) (do (IO/write (elem frame 5)) (drain-to-exit sock id))
          (and (= tag :stderr) (= (elem frame 3) id)) (do (IO/write :stderr (elem frame 5)) (drain-to-exit sock id))
          (and (= tag :exit) (= (elem frame 3) id)) {:ok :exit}
          :else (drain-to-exit sock id))))))

(defn outcome
  "The exit code of a control operation `op`, from how its connection `ended`
   (what `drain-to-exit` answered). Pure.

   `:stop` asks the VM to leave, so the VM closing the connection IS its answer: it
   is gone. Anything that asks the VM to do something and KEEP RUNNING (`{:close
   root}`) is only done when the VM says so with an exit frame; a closed connection
   there means it died or refused, and reporting success would be a lie. Silence is
   never confirmation."
  [op ended]
  (cond
    (contains? ended :ok) 0
    (and (= op :stop) (= :closed (:error ended))) 0
    :else 1))

(defn- control [root op done-msg]
  (let [root (resolve-root root)
        c (connect-hello root)]
    (if (contains? c :ok)
      (let [sock (:ok c)
            id (erlang/apply :crypto :strong_rand_bytes (list 16))]
        (gen_tcp/send sock (erlang/apply :erlang :term_to_binary
                             (list (tuple :bl 1 :control id op))))
        (let [ended (drain-to-exit sock id)
              code (outcome op ended)]
          (gen_tcp/close sock)
          (when (and done-msg (= 0 code)) (println done-msg))
          code))
      c)))

(defn status
  "Print the daemon's status for `root`, or 'not running'. Returns 0/1."
  [root]
  (let [root (resolve-root root)
        r (control root :status nil)]
    (if (= 0 r) 0
      (do (println (str "bl realm: not running for " root " (" (pr-str (:error r)) ")")) 1))))

(defn stop
  "End the project at `root`. A project with its own VM stops that VM. A project
   served by a shared VM closes only its REALM: the VM and every other project in
   it keep running (stop the process itself with `bl vm stop`). Returns 0 on stop,
   1 if none was running."
  [root]
  (let [root (resolve-root root)
        shared (paths/shared? root (paths/build-id))
        r (if shared
            (control root (tuple :close (erlang/list_to_binary (erlang/binary_to_list root))) nil)
            (control root :stop (str "bl realm: stopped (" root ")")))]
    (if (= 0 r) 0
      (do (println (str "bl realm: not running for " root)) 1))))

(defn probe
  "Whether a live, authenticated daemon answers for `root`. {:ok ready-meta} |
   {:error reason}. Used by the launcher's fast path and start's guard."
  [root]
  (let [c (connect-hello (resolve-root root))]
    (if (contains? c :ok)
      (do (gen_tcp/close (:ok c)) {:ok (:ready c)})
      c)))

(defn probe-shared
  "Whether a live, authenticated SHARED VM answers on this build's shared
   endpoint. No project is involved: the endpoint is the build's."
  []
  (let [c (connect-hello* nil (paths/build-id) true)]
    (if (contains? c :ok)
      (do (gen_tcp/close (:ok c)) {:ok (:ready c)})
      c)))

(defn request-stop
  "Ask the daemon for `root` that runs `build` to drain and exit. Unlike `stop`
   this names the build, so a VM on a superseded build can be reached from a
   newer one. {:ok :asked} | {:error reason}; prints nothing."
  [root build]
  (let [c (connect-hello (resolve-root root) build)]
    (if (contains? c :ok)
      (let [sock (:ok c)
            id (erlang/apply :crypto :strong_rand_bytes (list 16))]
        (gen_tcp/send sock (erlang/apply :erlang :term_to_binary
                             (list (tuple :bl 1 :control id :stop))))
        (gen_tcp/close sock)
        {:ok :asked})
      c)))
