; vm/paths.bl — filesystem identity for a bl daemon (ports Daemon.Paths).
;
; ══ WHAT MOVED HERE (FUP-082 T2/D1) ═════════════════════════════════════════
;
; The daemon's on-disk identity — tree id, runtime dir, endpoint paths — is
; pure fs + crypto + string arithmetic. It lives in `vm.*` (not `bl.*`) because
; it is reusable substrate: any host that binds a per-tree socket wants it, not
; only the CLI. The tree id + fingerprint MUST match the Rust launcher's copy
; (daemon.rs tree_id/tree_fingerprint) and the old Elixir Paths byte-for-byte,
; or a client looks for the daemon in the wrong place — golden-tested.
;
;   (paths/tree-id root)        → "57461829a20cc2af"  (16 hex of sha256(realpath))
;   (paths/fingerprint root)    → the 32-byte sha256 (the hello :tree field)
;   (paths/runtime-dir)         → {:ok dir} | {:error …}  (0700, owned, XDG)
;   (paths/build-id)            → "3ffa4c3a" | "src"  (which build this VM is)
;   (paths/endpoints root)      → {:ok {:tree-id :build :sock :token :pid :meta :lock}}
;   (paths/resolve-root cwd)    → {:ok root} | {:error :no-root}

(ns vm.paths)

(def TREE-ID-LEN 16)

(defn- real-path
  "realpath via readlink chasing; falls back to expand when the path is absent."
  [path]
  (let [r (erlang/apply :file :read_link_all (list (erlang/binary_to_list path)))]
    (if (and (erlang/is_tuple r) (= :ok (elem r 0)))
      (let [target (erlang/list_to_binary (elem r 1))
            abs (if (= :absolute (erlang/apply :filename :pathtype (list target)))
                  target
                  (erlang/apply :filename :join
                    (list (erlang/apply :filename :dirname (list path)) target)))]
        (real-path (erlang/apply :filename :absname (list abs))))
      (erlang/apply :filename :absname (list path)))))

(defn- canonical [root]
  (if (File/exists? root) (real-path root) (erlang/apply :filename :absname (list root))))

(defn fingerprint
  "The 32-byte sha256 of `root`'s real path — the hello :tree field."
  [root]
  (erlang/apply :crypto :hash (list :sha256 (canonical root))))

(defn tree-id
  "The canonical 16-hex tree id for `root` (filenames use this)."
  [root]
  (erlang/apply :string :lowercase
    (list (erlang/apply :binary :part
            (list (erlang/apply :binary :encode_hex (list (fingerprint root))) 0 TREE-ID-LEN)))))

;; ── the user's real uid (probe once, memoise) ───────────────────────────────

(defn- probe-uid []
  (let [path (str (erlang/apply :filename :basedir (list :user_cache "beam_lisp"))
                  "/uid-probe-" (erlang/apply :erlang :unique_integer (list (to-list [:positive]))))]
    (File/mkdir_p! (erlang/apply :filename :dirname (list path)))
    (File/write! path "")
    (let [info (erlang/apply :file :read_file_info (list (erlang/binary_to_list path)))
          uid (if (and (erlang/is_tuple info) (= :ok (elem info 0)))
                (elem (elem info 1) 12)   ; file_info: uid is element 12 (0-indexed)
                0)]
      (File/rm path)
      uid)))

(defn- current-uid []
  (let [override (System/get_env "BL_TEST_UID")]
    (if (and (string? override) (not= override ""))
      (erlang/binary_to_integer override)
      (let [cached (erlang/apply :persistent_term :get (list (tuple :vm-paths :uid) :undefined))]
        (if (= cached :undefined)
          (let [uid (probe-uid)]
            (erlang/apply :persistent_term :put (list (tuple :vm-paths :uid) uid))
            uid)
          cached)))))

;; ── the runtime dir (0700, owned, XDG-preferred) ────────────────────────────

(defn- ensure-secure-dir [dir]
  (let [info (erlang/apply :file :read_link_info (list (erlang/binary_to_list dir)))]
    (cond
      (and (erlang/is_tuple info) (= :ok (elem info 0)))
        (let [fi (elem info 1)
              type (elem fi 2) mode (elem fi 7) uid (elem fi 12)]
          (cond
            (not= type :directory) {:error (tuple :not_a_directory dir)}
            (not= uid (current-uid)) {:error (tuple :wrong_owner dir uid)}
            (not= 0 (erlang/band mode 63)) (do (File/chmod dir 448) :ok)  ; 0o077 mask, tighten to 0o700
            :else :ok))
      (and (erlang/is_tuple info) (= :error (elem info 1)) (= :enoent (elem info 1)))
        (do (File/mkdir_p! dir) (File/chmod dir 448) :ok)
      ;; enoent may arrive as {:error :enoent}
      (and (erlang/is_tuple info) (= :error (elem info 0)))
        (if (= :enoent (elem info 1))
          (do (File/mkdir_p! dir) (File/chmod dir 448) :ok)
          {:error (tuple :stat_failed dir (elem info 1))})
      :else {:error (tuple :stat_failed dir info)})))

(defn runtime-dir
  "The user-owned 0700 runtime dir holding this user's daemon endpoints.
   Prefers $XDG_RUNTIME_DIR/beam_lisp, else /tmp/beam_lisp-<uid>."
  []
  (let [xdg (System/get_env "XDG_RUNTIME_DIR")
        base (if (and (string? xdg) (not= xdg ""))
               (str xdg "/beam_lisp")
               (str (erlang/apply :filename :basedir (list :user_cache ""))
                    "/../beam_lisp-" (current-uid)))]
    ;; normalise the tmp fallback to the real tmp dir
    (let [base (if (and (string? xdg) (not= xdg ""))
                 base
                 (str "/tmp/beam_lisp-" (current-uid)))
          r (ensure-secure-dir base)]
      (if (= :ok r) {:ok base} r))))

(def BUILD-ID-MAX 16)

(defn build-id
  "Which build this VM is: `BL_BUILD_ID`, which the drop launcher sets to its
   payload's sha8 and `bin/bl` sets to `src`. Anything outside [a-z0-9] is
   dropped and the result is capped at 16, so it is always safe in a file name.
   Unset or empty answers `src`: a VM that nobody labelled is a source run."
  []
  (let [raw (or (System/get_env "BL_BUILD_ID") "")
        clean (erlang/apply :re :replace
                (list (erlang/apply :string :lowercase (list raw)) "[^a-z0-9]" ""
                      (to-list [:global (tuple :return :binary)])))]
    (cond
      (= clean "") "src"
      (> (erlang/byte_size clean) BUILD-ID-MAX) (erlang/binary_part clean 0 BUILD-ID-MAX)
      :else clean)))

(defn endpoints
  "The endpoint path set for the daemon of `root` RUN BY `build` (default: this
   VM's `build-id`): {:tree-id :build :sock :token :pid :meta :lock}, every
   file named `<tree-id>-<build>.<ext>`.

   The build is part of the name because a daemon runs ONE build's code. Keyed
   by the tree alone, a second build's command reached the first build's VM and
   ran there (measured with two drops in one tree: the warm answer came from
   the other payload). Two builds in one tree are two daemons.

   The Rust launcher computes the same names (daemon.rs `endpoints_for`).
   Fails if the runtime dir cannot be secured or the socket path is too long."
  ([root] (endpoints root (build-id)))
  ([root build]
   (let [rd (runtime-dir)]
     (if (nil? (:ok rd))
       rd
       (let [dir (:ok rd)
             id (tree-id root)
             base (str dir "/" id "-" build)
             sock (str base ".sock")]
         (if (> (erlang/byte_size sock) 100)
           {:error (tuple :socket_path_too_long sock)}
           {:ok {:tree-id id
                 :build build
                 :sock sock
                 :token (str base ".token")
                 :pid (str base ".pid")
                 :meta (str base ".meta")
                 :lock (str base ".start")}}))))))

;; ── root resolution ─────────────────────────────────────────────────────────

(defn- tree-root? [dir]
  (or (File/exists? (str dir "/priv/boot/core.bl"))
      (and (File/exists? (str dir "/bin/bl")) (File/dir? (str dir "/releases")))))

(defn- find-root [dir]
  (cond
    (tree-root? dir) {:ok (real-path dir)}
    (or (= dir "/") (= dir ".")) {:error :no-root}
    :else (find-root (erlang/apply :filename :dirname (list dir)))))

(defn resolve-root
  "The daemon root for `cwd`: the nearest ancestor that looks like a bl tree.
   BL_DAEMON_ROOT overrides. Returns {:ok root} | {:error :no-root}."
  [cwd]
  (let [override (System/get_env "BL_DAEMON_ROOT")]
    (if (and (string? override) (not= override ""))
      {:ok (real-path override)}
      (find-root (erlang/apply :filename :absname (list cwd))))))

;; ── the cache tier: where derived beam-lisp state lives (ports Cache) ────────
;;
;; TWO tiers, one rule (ported from lib/beam_lisp/cache.ex, FUP-082 / PLAN-132
;; ZERO-.ex sweep):
;;   * the PROJECT cache — <project>/.local/bl/cache, beside .local/blrun etc.
;;     Derived from a tree, kept with it, deleted with it, read by no other.
;;   * the HOST cache — $XDG_CACHE_HOME/beam_lisp/cache/<tree id>, for a project
;;     that cannot be written to (an installed drop, a mounted checkout, a CI
;;     read-only bind). Addressed by the SAME 16-hex tree id a daemon uses, so
;;     re-extracting the same payload finds the same directory again.
;;
;; The `tree-id` here is the daemon's (sha256 realpath, 16 hex) — the cache and
;; the daemon name a tree the SAME way by construction, one crypto, no drift.
;; The difference from `resolve-root` is only the marker set: a cache project is
;; ANY vcs/build root (.git, .hg, mix.exs, core.bl, or an extracted drop), which
;; is broader than a daemon root, so a scratch dir of .bl files still caches.

(def CACHE-MARKERS (list ".git" ".hg" "mix.exs" "priv/boot/core.bl"))

(defn cache-root
  "The host cache root: $XDG_CACHE_HOME/beam_lisp (else ~/.cache/beam_lisp).
   `:filename.basedir/2` reads the variable PER CALL, so a test — or a fetch
   pointed elsewhere — is obeyed rather than overruled by a load-time value."
  []
  (erlang/list_to_binary
    (erlang/apply :filename :basedir
      (list :user_cache (erlang/binary_to_list "beam_lisp")))))

(defn- cache-project? [dir]
  (or (some (fn [m] (File/exists? (erlang/apply :filename :join (list dir m))))
            CACHE-MARKERS)
      (and (File/exists? (erlang/apply :filename :join (list dir "bin/bl")))
           (File/dir? (erlang/apply :filename :join (list dir "releases"))))))

(defn- cache-walk [dir fallback]
  (cond
    (or (= dir "/") (= dir ".")) fallback
    (cache-project? dir) dir
    :else (cache-walk (erlang/apply :filename :dirname (list dir)) fallback)))

(defn cache-project-root
  "The project root containing `path`: the nearest ancestor that looks like a
   project (a vcs/build root), else `path` itself — its parent when `path` is a
   file. The floor matters: a walk without it climbs to `/`, the one place a
   cache must never land."
  [path]
  (let [start (if (File/dir? path)
                (erlang/apply :filename :absname (list path))
                (erlang/apply :filename :dirname
                  (list (erlang/apply :filename :absname (list path)))))]
    (cache-walk start start)))

(defn cache-tree-id
  "The 16-hex id of the project containing `path` — the daemon's own tree id,
   kept in step by construction (one sha256 over one canonical path)."
  [path]
  (tree-id (cache-project-root path)))

(defn cache-host-dir
  "The host-cache directory for the project containing `path`, keyed by that
   project's tree id — so a drop payload extracted again keeps its analysis."
  [path]
  (str (cache-root) "/cache/" (cache-tree-id path)))

(defn cache-project-dir
  "The project-cache directory for the project containing `path`."
  [path]
  (str (cache-project-root path) "/.local/bl/cache"))

