; vm/manager.bl — the global daemon: one node, many project VMs.
;
; ══ THE TOPOLOGY THE DX WANTS ═══════════════════════════════════════════════
;
;   ONE global daemon (this defserver, node-registered :vm-manager)
;     ├── VM "blueprint@main"   (capped env + owned processes)
;     │     ├── :web      side-app  → http://blueprint.test
;     │     ├── :tooling  side-app  → http://tooling.blueprint.test
;     │     └── :runner   armed on demand → http://runner.blueprint.test
;     ├── VM "knowledger@main"
;     └── VM "blueprint@feature-x"   (same project, another instance)
;
; A command, by DEFAULT, attaches to this running global manager and is routed
; into the VM for its checkout — no per-command boot. If a caller wants an
; ISOLATED global VM instead (a clean node), that is a separate OS process
; running its own manager; nothing here assumes a singleton beyond the
; registered name, so a second node with its own name coexists.
;
; The manager is a SUPERVISOR-shaped owner of state, but it holds NO command
; worker and NO lock: a VM is an env, a command is a process under that env,
; and the BEAM schedules them. The manager's only job is the TABLE (id → VM)
; and the lifecycle verbs over it. Reading the table is a cast-free `call`;
; listing every VM is one message, not a directory scan.
;
;   (manager/start)                 ; boot the global daemon (idempotent)
;   (manager/ensure spec)           ; get-or-spawn the VM for a spec → vm
;   (manager/get id)                ; → vm | nil
;   (manager/list)                  ; → [vm …]   SEE THEM ALL
;   (manager/run id thunk)          ; route a command into VM id
;   (manager/serve id role thunk)   ; arm a side-app in VM id → pid
;   (manager/drain id)              ; tear one VM down
;   (manager/shutdown)              ; drain every VM, then stop the daemon

(ns vm.manager
  (:require [vm.core :as vmc] [vm.owner :as owner] [vm.sched :as sched]))

(def MANAGER :vm-manager)

;; state: {:vms {id → vm-value}}
(defserver daemon
  (init [_]
    (ok {:vms {}}))

  ;; get-or-spawn: idempotent by id, so two commands racing into the same
  ;; project both get the one VM (no double-spawn, no collision).
  ;;
  ;; ARMING is part of the spawn, not a step a caller might remember: the tree's
  ;; declared periodic work is a fact about the tree, and a VM is what a tree
  ;; means here. A project that declares none gets no process at all
  ;; (vm.sched/start-for answers nil), so the cost of this line is paid by
  ;; exactly the projects that asked for it.
  (handle-call [:ensure spec] [_from st]
    (let [id (:id spec)]
      (if (contains? (:vms st) id)
        (reply (get (:vms st) id) st)
        (let [vm (vmc/spawn-vm spec)]
          (sched/start-for vm)
          (reply vm (assoc st :vms (assoc (:vms st) id vm)))))))

  (handle-call [:get id] [_from st]
    (reply (get (:vms st) id) st))

  (handle-call [:list] [_from st]
    (reply (vals (:vms st)) st))

  (handle-call [:drain id] [_from st]
    (if (contains? (:vms st) id)
      (let [r (vmc/drain (get (:vms st) id))]
        (reply r (assoc st :vms (dissoc (:vms st) id))))
      (reply {:halted 0} st)))

  ;; shutdown drains every VM (each tears down its own processes + env) and
  ;; then lets the daemon stop — the ONE place a node-wide end is legitimate.
  (handle-call [:shutdown] [_from st]
    (let [drained (vec (map (fn [vm] (vmc/drain vm)) (vals (:vms st))))]
      (reply {:drained (count drained)} (assoc st :vms {})))))

(defn start
  "Boot the global daemon (idempotent by name). Returns its pid. The owner
   registry must exist before any VM spawns a member, so start it first."
  []
  (if (nil? (Process/whereis MANAGER))
    (do (owner/start)
        (core/start daemon nil {:name MANAGER}))
    (Process/whereis MANAGER)))

(defn ensure
  "Get-or-spawn the VM for `spec` (keyed by :id). Returns the VM value."
  [spec]
  (call MANAGER [:ensure spec]))

(defn get-vm
  "The VM registered under `id`, or nil."
  [id]
  (call MANAGER [:get id]))

(defn list-vms
  "Every live VM — the read-model behind `bl vms`/`bl ps`."
  []
  (call MANAGER [:list]))

(defn run
  "Route a command `thunk` into VM `id` (it must exist). Runs under the VM's
   env, scoped so a `vm.scope/halt` ends only that VM. The 3-arg form binds
   `os-env` (the client's environment map) as this process's PROCESS-LOCAL env
   overlay, so concurrent commands with different env do not race."
  ([id thunk]
   (let [vm (get-vm id)]
     (if (nil? vm)
       (throw (ex-info (str "no VM: " id) {:id id}))
       (vmc/run vm thunk))))
  ([id os-env thunk]
   (let [vm (get-vm id)]
     (if (nil? vm)
       (throw (ex-info (str "no VM: " id) {:id id}))
       (vmc/run vm os-env thunk)))))

(defn serve
  "Arm a long-lived side-app in VM `id` under `role`. Returns the pid."
  [id role thunk]
  (let [vm (get-vm id)]
    (if (nil? vm)
      (throw (ex-info (str "no VM: " id) {:id id}))
      (vmc/serve vm role thunk))))

(defn drain
  "Tear one VM down and drop it from the table. Returns {:halted n}."
  [id]
  (call MANAGER [:drain id]))

(defn shutdown
  "Drain every VM, then the daemon can stop. Returns {:drained n}."
  []
  (call MANAGER [:shutdown]))
