; vm/manager.bl — the global daemon: one node, many project VMs.
;
; ══ THE TOPOLOGY THE DX WANTS ═══════════════════════════════════════════════
;
;   ONE global daemon (this defserver, node-registered :vm-manager)
;     ├── VM "blueprint@main"   (capped env + owned processes)
;     │     ├── :web      side-app  → http://blueprint.test
;     │     ├── :tooling  side-app  → http://tooling.blueprint.test
;     │     └── :runner   armed on demand → http://runner.blueprint.test
;     ├── VM "knowledger@main"
;     └── VM "blueprint@feature-x"   (same project, another instance)
;
; A command, by DEFAULT, attaches to this running global manager and is routed
; into the VM for its checkout — no per-command boot. If a caller wants an
; ISOLATED global VM instead (a clean node), that is a separate OS process
; running its own manager; nothing here assumes a singleton beyond the
; registered name, so a second node with its own name coexists.
;
; The manager is a SUPERVISOR-shaped owner of state, but it holds NO command
; worker and NO lock: a VM is an env, a command is a process under that env,
; and the BEAM schedules them. The manager's only job is the TABLE (id → VM)
; and the lifecycle verbs over it. Reading the table is a cast-free `call`;
; listing every VM is one message, not a directory scan.
;
;   (manager/start)                 ; boot the global daemon (idempotent)
;   (manager/ensure spec)           ; get-or-spawn the VM for a spec → vm
;   (manager/get id)                ; → vm | nil
;   (manager/list)                  ; → [vm …]   SEE THEM ALL
;   (manager/run id thunk)          ; route a command into VM id
;   (manager/serve id role thunk)   ; arm a side-app in VM id → pid
;   (manager/drain id)              ; tear one VM down
;   (manager/shutdown)              ; drain every VM, then stop the daemon

(ns vm.manager
  (:require [vm.core :as vmc] [vm.owner :as owner]
            [vm.paths :as paths]))

(def MANAGER :vm-manager)

(defn- spec-identity [spec]
 ;; Display IDs and truncated module keys are routing hints, not authority to
 ;; reuse another project's environment or capabilities. Keep the full tree
 ;; fingerprint and execution-affecting spec beside the manager-owned entry.
 (assoc (select-keys spec [:key :decl :uses-paths :base :caps :max-heap-words :schedules])
        :tree (when (:root spec) (paths/fingerprint (:root spec)))))

(defn- conflict? [spec vms]
 (let [existing (get vms (:id spec)) identity (spec-identity spec)]
  (or (and existing (not= identity (:spec-identity existing)))
      (and (:key spec)
           (some (fn [vm]
                   (and (not= (:id vm) (:id spec)) (= (:key spec) (:key vm))))
                 (vals vms))))))

(defn- accepted [result]
 (if (= :realm-identity-conflict (:error result))
  (throw (ex-info "realm identity conflicts with an open realm; close it before changing its specification"
                  {:reason :realm-identity-conflict}))
  result))

;; state: {:vms {id → vm-value}}
(defn unique-alias
  "`alias` made distinct from the aliases of the realms already open: `pulse`, then
   `pulse-2`, `pulse-3`. A nil alias stays nil (a bare spec is no realm). The alias is
   for people — URLs and the console — so two projects both called `pulse` stay
   addressable; the key, not the alias, names modules and registry rows."
  [alias vms]
  (if (nil? alias)
    nil
    (let [taken (set (keep :alias vms))]
      (loop [n 1]
        (let [candidate (if (= n 1) alias (str alias "-" n))]
          (if (contains? taken candidate) (recur (inc n)) candidate))))))

(defn- start-schedules! [vm]
  (when (and (seq (:schedules vm))
             (not (erlang/apply :persistent_term :get (list (tuple :vm_session :commands-only) false))))
    (BeamLisp.Loader/ensure_loaded "vm.sched")
    (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! "vm.sched" "start-for") (list vm))))

(defserver daemon
  (init [_]
    (ok {:vms {}}))

  ;; get-or-spawn: idempotent by id, so two commands racing into the same
  ;; project both get the one VM (no double-spawn, no collision).
  ;;
  ;; ARMING is part of the spawn, not a step a caller might remember: the tree's
  ;; declared periodic work is a fact about the tree, and a VM is what a tree
  ;; means here. A project that declares none gets no process at all
  ;; (vm.sched/start-for answers nil), so the cost of this line is paid by
  ;; exactly the projects that asked for it.
  (handle-call [:ensure spec] [_from st]
    (let [id (:id spec)]
      (if (conflict? spec (:vms st))
        (reply {:error :realm-identity-conflict} st)
       (if (contains? (:vms st) id)
        (reply (get (:vms st) id) st)
        (let [vm (assoc (vmc/spawn-vm spec) :spec-identity (spec-identity spec))]
          (start-schedules! vm)
          (reply vm (assoc st :vms (assoc (:vms st) id vm))))))))

  ;; like :ensure, and says whether THIS call created the VM. The creator is the
  ;; one caller that must start the VM's services; deciding it inside the server
  ;; is what makes "exactly one" true when two first requests arrive together.
  (handle-call [:open spec] [_from st]
    (let [id (:id spec)]
      (if (conflict? spec (:vms st))
        (reply {:error :realm-identity-conflict} st)
       (if (contains? (:vms st) id)
        (reply {:vm (get (:vms st) id) :created false} st)
        (let [vm (assoc (vmc/spawn-vm (assoc spec :alias (unique-alias (:alias spec) (vals (:vms st)))))
                        :spec-identity (spec-identity spec))]
          (start-schedules! vm)
          (reply {:vm vm :created true} (assoc st :vms (assoc (:vms st) id vm))))))))

  ;; Reservation and member creation are one manager turn. The child is owned
  ;; before a request can obtain it; initialization never blocks this manager.
  (handle-call [:service id slot identity thunk modules] [_from st]
    (let [vm (get (:vms st) id)
          previous (get-in vm [:services slot])
          live? (and previous (Process/alive? (:pid previous)))]
      (cond
        (nil? vm) (reply {:error :realm-closed :id id} st)
        (and live? (not= identity (:identity previous)))
        (reply {:error :service-identity-conflict :slot slot} st)
        live? (reply previous st)
        :else
        (let [entry {:pid (vmc/serve vm :service (fn [] (thunk (:env vm)))
                      (cons (elem (erlang/fun_info thunk :module) 1) modules)) :identity identity}]
          (reply entry (assoc-in st [:vms id :services slot] entry))))))

  (handle-call [:get id] [_from st]
    (reply (get (:vms st) id) st))

  (handle-call [:validate spec] [_from st]
    (reply (if (conflict? spec (:vms st)) {:error :realm-identity-conflict} :ok) st))

  (handle-call [:validate-root spec] [_from st]
    (let [existing (get (:vms st) (:id spec))]
      (reply (if (and existing
                      (not= (:tree (spec-identity spec)) (:tree (:spec-identity existing))))
               {:error :realm-identity-conflict} :ok) st)))

  (handle-call [:list] [_from st]
    (reply (vals (:vms st)) st))

  (handle-call [:drain id] [_from st]
    (if (contains? (:vms st) id)
      (let [r (vmc/drain (get (:vms st) id))]
        (reply r (assoc st :vms (dissoc (:vms st) id))))
      (reply {:halted 0} st)))

  ;; shutdown drains every VM (each tears down its own processes + env) and
  ;; then lets the daemon stop — the ONE place a node-wide end is legitimate.
  (handle-call [:shutdown] [_from st]
    (let [drained (vec (map (fn [vm] (vmc/drain vm)) (vals (:vms st))))]
      (reply {:drained (count drained)} (assoc st :vms {})))))

(defn start
  "Boot the global daemon (idempotent by name). Returns its pid. The owner
   registry must exist before any VM spawns a member, so start it first."
  []
  (if (nil? (Process/whereis MANAGER))
    (do (owner/start)
        (core/start daemon nil {:name MANAGER}))
    (Process/whereis MANAGER)))

(defn ensure
  "Get-or-spawn the VM for `spec` (keyed by :id). Returns the VM value."
  [spec]
  (accepted (call MANAGER [:ensure spec] :infinity)))

(defn open
  "Like `ensure`, answering {:vm vm :created bool}: `created` is true for exactly
   one caller per VM, however many ask at once."
  [spec]
  (accepted (call MANAGER [:open spec] :infinity)))

(defn get-vm
  "The VM registered under `id`, or nil."
  [id]
  (call MANAGER [:get id]))

(defn validate-spec!
 "Refuse ambiguous project identity without creating or draining a realm."
 [spec]
 (accepted (call MANAGER [:validate spec])))

(defn validate-root!
 "Authorize project-scoped teardown by full tree identity. Changed declarations
  may still be drained; another project's colliding display ID may not."
 [spec]
 (accepted (call MANAGER [:validate-root spec])))

(defn list-vms
  "Every live VM — the read-model behind `bl vms`/`bl ps`."
  []
  (call MANAGER [:list]))

(defn run
  "Route a command `thunk` into VM `id` (it must exist). Runs under the VM's
   env, scoped so a `vm.scope/halt` ends only that VM. The 3-arg form binds
   `os-env` (the client's environment map) as this process's PROCESS-LOCAL env
   overlay, so concurrent commands with different env do not race."
  ([id thunk]
   (let [vm (get-vm id)]
     (if (nil? vm)
       (throw (ex-info (str "no VM: " id) {:id id}))
       (vmc/run vm thunk))))
  ([id os-env thunk]
   (let [vm (get-vm id)]
     (if (nil? vm)
       (throw (ex-info (str "no VM: " id) {:id id}))
       (vmc/run vm os-env thunk)))))

(defn serve
  "Arm a long-lived side-app in VM `id` under `role`. Returns the pid."
  [id role thunk]
  (let [vm (get-vm id)]
    (if (nil? vm)
      (throw (ex-info (str "no VM: " id) {:id id}))
      (vmc/serve vm role thunk))))

(defn drain
  "Tear one VM down and drop it from the table. Returns {:halted n}."
  [id]
  (call MANAGER [:drain id] :infinity))

(defn shutdown
  "Drain every VM, then the daemon can stop. Returns {:drained n}."
  []
  (call MANAGER [:shutdown] :infinity))
