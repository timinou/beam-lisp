; vm/image.bl — what kind of image this is: "dev", "release" or "drop".
;
; ── The question, and the answer that stopped existing ──────────────────────
;
; "Am I in a development image?" used to be answered by asking whether `Mix` was
; loaded. That answer stops existing the day Mix is deleted — and worse, it fails
; in the direction that hurts: a development image would start looking like
; production, so `reload` would refuse to mutate it and the dev server would not
; start. A signal that disappears with a dependency is not a signal.
;
; So the kind is DECLARED by whoever built the image, and read from there:
;
;   BL_BIN set            a drop. Its Rust launcher names the compound it runs
;                         from — `BL_BIN` IS the compound path.
;   BEAM_LISP_IMAGE set   a release; the shell launcher states its kind.
;   neither               a plain VM: `bl` from a checkout, a test run, CI.
;
; `BEAM_LISP_DEV=1` forces "dev" whatever the image, which is how a tree declares
; itself: `bl` puts a project file's `:env` into the real environment before a
; command runs, so `env.bl` can say `{:env {"BEAM_LISP_DEV" "1"}}` — as this
; repository's own does.
;
; ── One rule, two callers ───────────────────────────────────────────────────
;
; Reading the live image (inspect / status / journal / namespaces) is always
; safe; MUTATING it is gated, and this is the policy the gate reads. `reload`
; (which refuses a mutating commit in a packaged image unless `BEAM_LISP_RELOAD`
; is set) and `bl.doctor` (which reports what the image is) both call it,
; because two copies of a signal are two signals.
;
; This is the port of `BeamLisp.Image` to a beam-lisp namespace: a rule about
; beam-lisp's own image belongs beside the code that reads it, not in a host
; module callers reach across the boundary for.

(ns vm.image)

(defn- forced-dev?
  "Whether the tree DECLARES itself a development image (`BEAM_LISP_DEV`), which
   wins over whatever the launcher said."
  []
  (contains? #{"1" "true"} (System/get_env "BEAM_LISP_DEV")))

(defn kind
  "The image kind: `\"dev\"`, `\"release\"` or `\"drop\"`.

   Priority, exactly: an explicit `BEAM_LISP_DEV` override wins; then a drop's
   `BL_BIN`; then a release's own `BEAM_LISP_IMAGE` (which states its kind); else
   a plain development VM. Measured: `BL_BIN` is set in a drop and nil under
   `mix bl`; nothing here asks whether Mix is loaded, because that answer stops
   existing the day Mix is deleted."
  []
  (cond
    (forced-dev?) "dev"
    (some? (System/get_env "BL_BIN")) "drop"
    (some? (System/get_env "BEAM_LISP_IMAGE")) (System/get_env "BEAM_LISP_IMAGE")
    :else "dev"))

(defn dev?
  "Whether this is a development image — the question callers actually ask."
  []
  (= "dev" (kind)))

(defn mutable?
  "Whether a packaged image (release or drop) may mutate itself. `BEAM_LISP_RELOAD`
   is the operator's opt-in, per node, with a bounded window; it never changes
   what the image IS (`kind`), only what it may do."
  []
  (or (dev?) (contains? #{"1" "true"} (System/get_env "BEAM_LISP_RELOAD"))))
