; vm/osenv.bl — a process-local OS-environment view.
;
; ══ THE KEYSTONE DEFECT (verified) ══════════════════════════════════════════
;
; A command's cwd and argv are already PROCESS-LOCAL (BeamLisp/with_cwd,
; with_argv — a process-dict binding restored after). But the daemon's env
; conveyance was NODE-GLOBAL: the Elixir executor did System.put_env /
; delete_env per request, and bl's System/get_env maps straight to the OS env
; table. Two concurrent commands carrying different env therefore RACE on one
; node-global table. The single serial worker hid this by construction.
;
; For real concurrency (many commands at once, each isolated) the env view must
; be process-local like cwd/argv. It is — trivially — because each command runs
; in its OWN BEAM process (the per-request worker): a process-dictionary overlay
; is per-process by definition, so two concurrent commands cannot see each
; other's env, with ZERO locking. The BEAM's process isolation IS the fix.
;
;   (osenv/get "FOO")            ; overlay first, then the real OS env
;   (osenv/get "FOO" "default")  ; with a default when unset
;   (osenv/with-env {"FOO" "a"} thunk)  ; bind an overlay for this process only
;   (osenv/overlay)              ; the current overlay map (for inspection)
;
; A command's runner binds the CLIENT's env once via `with-env`, and every
; env read inside the command goes through `osenv/get` — never System/get_env,
; which sees only the node's own env. The daemon NEVER mutates the OS table.

(ns vm.osenv)

(def PDICT-KEY :bl-osenv-overlay)

(defn overlay
  "The env overlay bound in THIS process, or an empty map when none."
  []
  (let [v (erlang/get PDICT-KEY)]
    (if (= v :undefined) {} v)))

(defn get
  "The value of env var `k`: the process overlay first, then the real OS env,
   then `default` (nil in the 1-arg form). Process-local: concurrent commands
   with different overlays each read their own, no race."
  ([k] (get k nil))
  ([k default]
   (let [ov (overlay)]
     (if (contains? ov k)
       (core/get ov k)
       (let [v (System/get_env k)]
         (if (nil? v) default v))))))

(defn with-env
  "Run `thunk` with `env` (a {name → value} map) bound as this process's env
   overlay, restoring the previous overlay after. The overlay REPLACES the
   view for the keys it names; unnamed keys still fall through to the OS env.
   Because it lives in the process dictionary, a spawned command's overlay is
   invisible to every other command — this is the process-local conveyance the
   node-global System.put_env could not give."
  [env thunk]
  (let [prev (erlang/get PDICT-KEY)]
    (erlang/put PDICT-KEY env)
    (try
      (thunk)
      (finally
        (if (= prev :undefined)
          (erlang/erase PDICT-KEY)
          (erlang/put PDICT-KEY prev))))))
