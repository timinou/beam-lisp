; vm/catalog.bl — a tree's declared component catalog, as a session fact.
;
; ══ WHAT A TREE DECLARES ════════════════════════════════════════════════════
;
; A tree may name a component catalog in its env.bl:
;
;     :catalog {:name "knowledger"
;               :lib-dir "apps/knowledger/src/knowledger/ui"
;               :examples-dir "apps/knowledger/src/knowledger/catalog"}
;
; The tool (tooling.catalog) indexes those two directories into a datom db: the
; library's public primitives, what the showcase demonstrates, and the gap
; between them. Indexing EVALUATES the tree's own namespaces, so it is work with
; a real cost — and the rule this module keeps is the Index pane's rule: the
; work happens in the session that will serve it, it is VISIBLE while it runs,
; and a reader never queues behind it.
;
; ══ WHY THE BUILD HOLDS ITSELF OPEN ═════════════════════════════════════════
;
; A datom conn's store is an ETS table, and an ETS table lives exactly as long
; as the process that created it — the opening fact of `vm.index`, and the bug
; this module was caught by. The build runs in a process of its own so the
; request that asked for it can answer at once; that process must then STAY, or
; the conn it built dies with it and the next render raises badarg on a dead
; table. Measured, before `hold!`: the catalog page 500'd under the dashboard
; (`view-failed %ArgumentError`) while the standalone server — which prepares
; AND serves in one process — was fine.
;
; So the build process publishes its result and then waits, holding the conn for
; as long as the session lives. It costs one parked process and one atom read.
;
; ══ THE SHAPE ══════════════════════════════════════════════════════════════
;
;   (catalog/declaration root)      → the env.bl declaration, or nil
;   (catalog/status root)           → the read-model's field (never indexes)
;   (catalog/ensure-building! root) → start the build (idempotent)
;   (catalog/handler root)          → a plug: the LIVE catalog, mounted at PREFIX
;
; `status` is what vm.inspect puts in the model and what the dashboard's pane
; renders; neither indexes anything. `GET /catalog` is the door that pays, and
; it serves the SAME router the standalone `bl serve examples/catalog.bl` does —
; one implementation, reachable from `bl ui`, instead of a second server beside
; it (PLAN-024; the argument FUP-011 made for the scenario workbench).

(ns vm.catalog
  (:require [bl.env :as env] [tooling.catalog :as catalog] [web]))

(def PREFIX
  "Where the dashboard mounts this catalog. One address, so a link in a pane,
   the page's own script and socket URLs, and the page a person pastes agree."
  "/catalog")

;; One session, one tree, one catalog. The state is a value the session holds,
;; not a call into a build: a reader must be able to say "building" WHILE the
;; build runs, so nothing a renderer touches may queue behind it.
(def state (atom {:phase :cold}))

;; ── the declaration ─────────────────────────────────────────────────────────

(defn declaration
  "The tree's `:catalog` declaration, or nil. Read as DATA (never evaluated) out
   of the same project value every other caller reads."
  [root]
  (get (env/project (or root (BeamLisp/cwd))) :catalog))

;; ── the build ───────────────────────────────────────────────────────────────

(defn- summary
  "The report, projected for a pane: the counts a person acts on, the gap by
   name, and the escape leaders — not everything the tool can measure."
  [r]
  {:package (:package r)
   :groups (map (fn [g] [(:group g) (:count g)]) (:groups r))
   :entries (:entries r)
   :undocumented (:undocumented r)
   :prims (:prims r)
   :coverage (:coverage r)
   :gap (:gap r)
   :escapes (map (fn [e] [(:name e) (:n e)]) (:escapes r))
   :a11y (count (:a11y r))
   :unkeyed (:unkeyed r)})

(defn- hold!
  "Wait forever, holding whatever this process built.

   The prepared value contains a datom conn, whose store is an ETS table OWNED BY
   THIS PROCESS. A process that exits takes its tables with it, so a build that
   returned would leave every later render reading a dead table — which is
   exactly what happened before this fn existed. Parking is the whole mechanism:
   the catalog is dropped by killing the session, never by finishing."
  []
  (loop []
    (erlang/apply :timer :sleep (list 60000))
    (recur)))

(defn- build!
  "Index, measure, publish, then HOLD the build open. Failure is a STATE, not a
   crash: a catalog whose library does not load is a fact a pane can state, and
   the session it runs in must survive saying so."
  [root decl]
  (reset! state (assoc decl :root root :phase :building
                       :package (get decl :name)
                       :prefix PREFIX
                       :at (erlang/system_time :millisecond)))
  (try
    (let [prepared (catalog/prepare decl)
          r (catalog/report prepared)]
      (reset! state {:root root :decl decl :prepared prepared :phase :ready
                     :package (get decl :name)
                     :lib-dir (get decl :lib-dir)
                     :examples-dir (get decl :examples-dir)
                     :prefix PREFIX
                     :summary (summary r)
                     :problems (catalog/problems r)
                     :at (erlang/system_time :millisecond)})
      (hold!))
    (catch e
      (reset! state {:root root :decl decl :phase :error
                     :package (get decl :name)
                     :lib-dir (get decl :lib-dir)
                     :examples-dir (get decl :examples-dir)
                     :prefix PREFIX
                     :message (ex-message e)
                     :at (erlang/system_time :millisecond)}))))

(defn ensure-building!
  "Start the tree's catalog build, once (idempotent: a build in flight is
   joined, and a catalog already ready for THIS tree is not rebuilt). Returns the
   state that is now current — `:cold`, `:building`, `:ready` or `:error`."
  [root]
  (let [decl (declaration root)
        s @state]
    (if (or (nil? decl)
            (= :building (:phase s))
            (and (= :ready (:phase s)) (= root (:root s))))
      s
      (do
        (reset! state {:phase :building :root root :decl decl
                       :package (get decl :name) :prefix PREFIX
                       :at (erlang/system_time :millisecond)})
        (erlang/apply :erlang :spawn (list (fn [] (build! root decl))))
        @state))))

(defn forget!
  "Drop what was measured. The next `ensure-building!` indexes again."
  []
  (reset! state {:phase :cold})
  :ok)

(defn status
  "What this tree's catalog is, as data: cheap enough for every request to the
   dashboard and for `bl daemon status`, because it NEVER indexes — `:phase` says
   where the work stands and `:summary` exists only once it is done."
  [root]
  (let [decl (declaration root)]
    (if (nil? decl)
      {:declared false :prefix PREFIX}
      (let [s @state
            mine? (= root (:root s))
            s (if mine? s {:phase :cold})
            phase (:phase s)]
        {:declared true
         :prefix PREFIX
         :package (get decl :name)
         :lib-dir (get decl :lib-dir)
         :examples-dir (get decl :examples-dir)
         :phase phase
         :message (if (= :error phase) (:message s) nil)
         :summary (if (= :ready phase) (:summary s) nil)
         :problems (if (= :ready phase) (:problems s) [])}))))

;; ── the two pages a mount needs ─────────────────────────────────────────────
;;
;; Small on purpose: the catalog itself is `tooling.catalog`'s page. These say
;; "wait" and "no" — the two states a mount has that the standalone server,
;; which indexes before it listens, never shows.

(defn- esc [v]
  (if (nil? v)
    ""
    (-> (str v)
        (String/replace "&" "&amp;") (String/replace "<" "&lt;")
        (String/replace ">" "&gt;") (String/replace "\"" "&quot;")
        (String/replace "'" "&#39;"))))

(defn- page [title body]
  (str "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">"
       "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
       "<title>" (esc title) "</title>"
       "<style>body{margin:0;padding:3rem 1.5rem;background:#0b0a10;color:#ece9f5;"
       "font:15px/1.7 ui-sans-serif,system-ui,sans-serif}main{max-width:44rem;margin:0 auto}"
       "h1{font-size:1.3rem;margin:0 0 .4rem}.note{color:#9891ad}"
       "code{font-family:ui-monospace,Menlo,monospace;font-size:.85rem;background:#16141f;"
       "padding:.1rem .35rem;border-radius:4px}a{color:#7c5cff}</style></head><body><main>"
       body "</main></body></html>"))

(defn- building-page [decl]
  ;; the refresh is the honest answer to "where is it?": the build happens in
  ;; this session, so the page that asked is what can report it.
  (page (str (get decl :name) " · catalog")
        (str "<meta http-equiv=\"refresh\" content=\"2\">"
             "<h1>Indexing the catalog…</h1>"
             "<p class=\"note\">Evaluating <code>" (esc (get decl :lib-dir)) "</code> and <code>"
             (esc (get decl :examples-dir)) "</code>. This page reloads itself.</p>"
             "<p class=\"note\"><a href=\"/\">← the session dashboard</a></p>")))

(defn- error-page [decl s]
  (page "catalog · error"
        (str "<h1>The catalog could not be indexed</h1>"
             "<p class=\"note\"><code>" (esc (get decl :lib-dir)) "</code> / <code>"
             (esc (get decl :examples-dir)) "</code></p>"
             "<pre class=\"note\">" (esc (:message s)) "</pre>"
             "<p class=\"note\"><a href=\"/\">← the session dashboard</a></p>")))

;; ── the mount ───────────────────────────────────────────────────────────────

(defn handler
  "The catalog as a plug, for a host that mounts it at `PREFIX` (the session's
   dashboard does, from vm.http). Cold or building → start (or join) the build
   and answer a page that says so; ready → the catalog's OWN router, the same
   one `main` serves; error → a page naming the error, since a silent 500 would
   hide the reason a tree's catalog is not there."
  [root]
  (fn [conn]
    (let [decl (declaration root)]
      (if (nil? decl)
        (web/text conn 404 "this tree declares no :catalog package in env.bl")
        (let [s (ensure-building! root)]
          (cond
            (= :ready (:phase s))
            ((catalog/router (:prepared s) PREFIX) conn)

            (= :error (:phase s))
            (web/html conn 500 (error-page decl s))

            :else
            (web/html conn 200 (building-page decl))))))))
