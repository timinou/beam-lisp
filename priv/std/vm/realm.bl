; vm/realm.bl — a project, alive inside a VM: what starts with it and what ends it.
;
; ══ WHAT A REALM IS HERE ════════════════════════════════════════════════════
;
; `vm.manager` holds a table of "VMs": an env fork plus the processes it owns.
; That value IS the realm. This namespace is the lifecycle around it — the
; services that belong to a PROJECT rather than to the OS process:
;
;   · the code index owner (`vm.index`, one per root)
;   · the declared periodic work (`vm.sched`, one wheel per realm id; the manager
;     arms it when it creates the realm)
;
; Both start the first time a realm is used, and both are members of the realm
; (`vm.owner/adopt`), so draining it takes them down with everything else it owns. A VM booted for ONE project (a source checkout, or a project that did not
; ask to share) starts them at boot through the same call, so there is one way a
; realm comes alive, not two.
;
;   (realm/open root)    → the realm's VM value; idempotent, race-safe
;   (realm/close root)   → {:halted n}; only that realm
;   (realm/roots)        → the roots of every open realm
;   (realm/describe root) → {:alias :key :root :shadows :uses :members}, or nil
;   (realm/shadow-chip names) → "◇ shadows 2: a, b", or nil when there is none
;
; ══ WHY THE MANAGER DECIDES ═════════════════════════════════════════════════
;
; The manager owns the realm table. Each opener ensures services through their
; idempotent owner registry before returning. A per-realm lifecycle fence orders
; open against close; creator death cannot make an incomplete entry permanent.

(ns vm.realm
  (:require [vm.manager :as mgr] [vm.index :as index] [vm.spec :as spec] [vm.owner :as owner] [vm.paths :as paths]))

(defn- start-services!
  "What a realm brings alive beyond its env and its wheel (the manager arms the
   wheel when it creates the realm): a cold index owner. Index-consuming
   commands build on that owner; opening a realm never indexes its sources."
  [vm]
  (index/start-for (:root vm) (:id vm) {:build false}))

(defn open
  "Open a project under its physical identity's lifecycle lock. A changed
   project retires its executed definitions while the compiler VM stays warm.
   Pure document edits preserve an analyzer realm and its content cache."
  ([root] (open root nil))
  ([root generation]
   (let [sp (cond-> (spec/read root) generation (assoc :source-generation generation))]
    (global/trans (tuple (tuple :vm-realm-lifecycle (paths/fingerprint root)) (erlang/self))
      (fn []
        (when generation
          (let [decision (mgr/observe-sources sp generation)]
            (when (map? decision) (mgr/drain (:retire decision)))))
        (let [r (mgr/open sp)]
          (start-services! (:vm r))
          (:vm r)))))))

(defn close
  "Drain this realm under the same lifecycle fence as open. Other realms keep
   serving; repeated closes are harmless."
  [root]
  (let [sp (spec/read root)]
    (global/trans (tuple (tuple :vm-realm-lifecycle (paths/fingerprint root)) (erlang/self))
      (fn []
        (mgr/validate-root! sp)
        (index/stop-for (:root sp))
        (mgr/drain (:id sp))))))

(def CHIP-NAMES-SHOWN 3)
(def SHADOW-MARK "◇")

(defn shadow-chip
  "The chip a realm that shadows library namespaces wears, or nil when it shadows none (the
   empty case is silence). `names` are the shadowed namespaces. Past `CHIP-NAMES-SHOWN` the
   rest collapse to a count: `◇ shadows 5: a, b, c, +2`. A mark and a word, never colour
   alone; the console and `bl realm show` print this one string (FUP-157)."
  [names]
  (let [ns (vec (sort names))
        n (count ns)]
    (when (pos? n)
      (let [shown (take CHIP-NAMES-SHOWN ns)
            more (- n (count shown))]
        (str SHADOW-MARK " shadows " n ": " (join ", " shown)
             (if (pos? more) (str ", +" more) ""))))))

(defn- overrides-shadows
  "Namespaces vendored under the project's `overrides/` directory: a file there is a declared
   shadow by convention (`bl override vendor`). `dir` is the directory; the namespace is the
   path under it with `/` as `.` and `_` as `-`."
  [dir]
  (if (File/dir? dir)
    (vec (map (fn [path]
                (-> (subs path (inc (count dir)) (- (count path) (count ".bl")))
                    (String/replace "/" ".")
                    (String/replace "_" "-")))
              (Path/wildcard (str dir "/**/*.bl"))))
    []))

(defn describe
  "What a realm is, as data: {:alias :key :root :shadows :uses :members}. The control frame
   `:show` sends this; the page and `bl realm show` render it. nil when the realm is not open.
   `:shadows` is every library namespace the project replaces: the ones it declares plus the
   ones it vendored under overrides/."
  [root]
  (let [sp (spec/read root)
        vm (mgr/get-vm (:id sp))]
    (when (some? vm)
      (let [decl (:decl vm)]
        {:alias (:alias vm)
         :key (:key vm)
         :root (:root vm)
         :shadows (vec (distinct (concat (:shadow decl) (overrides-shadows (:overrides decl)))))
         :uses (:uses decl)
         :members (owner/count (:id vm))}))))

(defn roots
  "The roots of every realm this VM has open."
  []
  (to-list (map (fn [vm] (:root vm)) (mgr/list-vms))))
