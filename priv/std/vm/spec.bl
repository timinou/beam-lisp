; vm/spec.bl — a VM spec from env.bl, overlaid by a gitignored .env.local.bl.
;
; ══ WHAT A SPEC IS ══════════════════════════════════════════════════════════
;
; `vm.manager/ensure` takes a spec: {:id :root :base :caps :max-heap-words
; :apps}. This namespace derives that spec from a tree's project files, so the
; manager never reads disk itself — it is handed a value.
;
; ══ THE OVERLAY (the DX ask) ════════════════════════════════════════════════
;
; `env.bl` is committed: the project's shared truth. `.env.local.bl` is
; GITIGNORED: a developer's private overrides — a pinned port, an extra cap, a
; different instance name, an armed side-app — that must never reach the repo.
; The overlay is a DEEP MERGE with local winning, so a local file need only
; name what it changes:
;
;   ; env.bl                         ; .env.local.bl (gitignored)
;   {:name "blueprint"               {:ports {:ui 7700}
;    :ports {:ui 0}                   :apps  {:runner {:role :runner
;    :caps [["Elixir.File" "read"]]}          :start "scenarios/smoke.bl"}}}
;
;   → merged: ui pinned to 7700, plus an armed :runner side-app.
;
; ══ IDENTITY (fixes the silent-collision bug) ═══════════════════════════════
;
; A VM's :id is `<name>[@<instance>]`. `:instance` defaults to the git branch
; when it is not a default branch, ELSE a short hash of the ROOT PATH — so two
; worktrees of one project on `main` get DISTINCT ids (blueprint@a1b2c3 vs
; blueprint@d4e5f6) instead of colliding on a shared hostname. This is the
; env-reader design gap named in the audit, closed here at the identity source.
;
;   (spec/read root)            → {:id :root :base :caps :max-heap-words :apps}
;   (spec/overlay base local)   → deep-merged map (local wins)

(ns vm.spec
  (:require [bl.env :as project]))

(def LOCAL-FILE ".env.local.bl")

(defn- read-data-file
  "The last top-level form of a .bl file as DATA (never evaluated), or nil when
   the file is absent or not a trailing map. Same discipline as bl.env/literal:
   a private overrides file must not run project code."
  [path]
  (if (File/regular? path)
    (try
      (let [forms (BeamLisp.Compiler/read_all_data (File/read! path))]
        (if (and (not (empty? forms)) (map? (last forms))) (last forms) nil))
      (catch _ nil))
    nil))

(defn overlay
  "Deep-merge `local` onto `base`: a map value merges recursively, any other
   value replaces. `local` wins. This is what lets `.env.local.bl` name only
   what it changes."
  [base local]
  (cond
    (and (map? base) (map? local))
      (reduce (fn [acc k] (assoc acc k (overlay (get base k) (get local k))))
              base
              (keys local))
    :else (if (nil? local) base local)))

(defn- default-branch? [b]
  (contains? #{"main" "master" nil ""} b))

(defn- git-branch [root]
  (try
    (let [r (System/cmd "git"
              (to-list ["-C" root "rev-parse" "--abbrev-ref" "HEAD"])
              (to-list [(->tuple-2 :stderr_to_stdout false)]))
          out (elem r 0)]
      (erlang/apply :string :trim (list out)))
    (catch _ nil)))

(defn- path-hash
  "A short, stable id derived from the absolute root path — the disambiguator
   when two worktrees share a name on a default branch."
  [root]
  (let [full (erlang/apply :crypto :hash (list :sha256 (Path/expand root)))
        hx (erlang/apply :binary :encode_hex (list full))]
    (erlang/apply :string :lowercase
      (list (erlang/apply :binary :part (list hx 0 6))))))

(defn- instance-of
  "The instance qualifier: an explicit `:instance`, else a non-default git
   branch, else a short hash of the root path (so worktrees never collide)."
  [merged root]
  (let [decl (:instance merged)
        branch (git-branch root)]
    (cond
      (and (string? decl) (not= decl "")) decl
      (not (default-branch? branch)) branch
      :else (path-hash root))))

(defn- id-of [merged root]
  (let [nm (or (:name merged) (Path/basename (Path/expand root)))
        inst (instance-of merged root)]
    (str nm "@" inst)))

(defn read
  "The VM spec for the tree at `root`: env.bl overlaid by .env.local.bl, with a
   collision-proof :id derived. The manager consumes this directly.

   Returns {:id :root :base :caps :max-heap-words :apps :ports :schedules}.
   Never raises — a missing or broken file degrades to a bare spec, never a
   failure."
  [root]
  (let [base (or (read-data-file (str root "/env.bl")) {})
        local (or (read-data-file (str root "/" LOCAL-FILE)) {})
        merged (overlay base local)
        ;; The declarations are read through the project's own reader, so a
        ;; malformed one is a VALUE beside the file's other shape problems
        ;; (bl.env/normalize's :errors) rather than a crash in whoever armed it.
        ;; A VM carries what the tree SAID, not what a parser could salvage.
        decls (:schedules (project/normalize merged root nil))]
    {:id (id-of merged root)
     :root (Path/expand root)
     :base (or (:base merged) :global)
     :caps (or (:caps merged) :all)
     :max-heap-words (:max-heap-words merged)
     :apps (or (:apps merged) {})
     :ports (or (:ports merged) {})
     :schedules decls}))
