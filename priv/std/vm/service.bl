; Persistent services are realm members. The manager publishes the reservation
; before acknowledging acquire; startup belongs to the realm, never the client.
(ns vm.service (:require [vm.manager :as manager] [vm.scope :as scope] [env] [proc.admission :as admission]))

(defn- running [value stop]
 (receive
  [:apply from ref action registration request]
  (do
   (let [reply (try
                (let [accepted (if (or (nil? request) (admission/live? request))
                                 (BeamLisp.Env/transfer_code! registration (erlang/self)) :cancelled)]
                 (if (= :cancelled accepted) {:error (ex-info "Queued service operation was cancelled" {})}
                  (try {:ok (admission/with-request nil (fn [] (action value)))} (finally (BeamLisp.Env/release_code! accepted)))))
                (catch error {:error error}))]
    (erlang/send from [:applied ref reply]))
   (running value stop))
  [:ready from ref]
  (do (erlang/send from [:ready ref value]) (running value stop))
  [:stop from ref]
  (do (stop value) (erlang/send from [:stopped ref]))
  [:vm-service-stop from ref]
  (do (stop value) (erlang/send from [:vm-service-stopped ref]))))

(defn start
 "Internal owner entrypoint. Initialization failure exits the member; waiters
  observe DOWN and a later acquire can retry. Logs use the manager's stable IO."
 [init stop]
 (running (init) stop))

(defn- readiness [pid]
 (let [ref (erlang/monitor :process pid)]
  (erlang/send pid [:ready (erlang/self) ref])
  (receive
   [:ready seen initialized] :when (= ref seen)
    (do (erlang/demonitor ref (list :flush)) {:ok {:pid pid :value initialized}})
   [:DOWN seen :process _ reason] :when (= ref seen) {:error reason})))
(defn value
 "Read an initialized service through its native actor handshake."
 [pid]
 (let [result (readiness pid)]
  (if (contains? result :ok) (:ok result)
    (throw (ex-info "Service failed before readiness" {:reason (:error result)})))))
(defn lookup
 "Read a live initialized realm service without acquiring or changing identity.
  A retired reservation or owner that dies before readiness is absent."
 [realm slot]
 (when-let [entry (get-in (manager/get-vm realm) [:services slot])]
  (:ok (readiness (:pid entry)))))
(defn apply!
 "Execute an operation in the initialized service owner, serialized with stop.
  The owner's environment and ownership remain authoritative."
 [pid action]
 (let [ref (erlang/monitor :process pid)
       registration (BeamLisp.Env/retain_code! (BeamLisp.Env/callback_modules action))]
  (try
   (erlang/send pid [:apply (erlang/self) ref action registration (Process/get :bl_admission)])
   (receive
   [:applied seen result] :when (= ref seen)
    (do (erlang/demonitor ref (list :flush))
        (if (contains? result :error) (throw (:error result)) (:ok result)))
   [:DOWN seen :process _ reason] :when (= ref seen)
    (throw (ex-info "Service operation interrupted" {:reason reason})))
   (finally (BeamLisp.Env/release_code! registration)))))

(defn acquire
 "Acquire one service slot in an open realm. Identity must include every option
  affecting writers or compatibility. Matching callers await the same startup;
  a different identity is rejected. Caller death leaves owned startup running.
  Returns {:pid owner :value initialized-value}. init/stop run in that owner."
 [realm slot identity init stop]
 (let [action (BeamLisp.Env/convey
                (fn [target]
                  ;; Convey request resolution/project scopes, then rebind the
                  ;; authoritative current realm Env. A global caller must not
                  ;; replace its service's caps/vars with the caller's Env.
                  (env/with-env target
                    (fn [] (scope/with-vm realm (fn [] (start init stop)))))))
       modules (list (elem (erlang/fun_info init :module) 1)
                     (elem (erlang/fun_info stop :module) 1)
                     (elem (erlang/fun_info action :module) 1))
       result (call manager/MANAGER
                [:service realm slot identity (fn [target] (erlang/apply action (list target))) modules] :infinity)]
  (when (:error result) (throw (ex-info "service acquisition rejected" result)))
  (value (:pid result))))

(defn stop!
 "Graceful stop, waiting for the owner to exit. Startup may finish first.
  A stop callback failure is reported, not mistaken for a completed flush."
 [pid]
 (let [ref (erlang/monitor :process pid)]
  (erlang/send pid [:stop (erlang/self) ref])
  (receive
   [:stopped seen] :when (= ref seen)
   (receive [:DOWN seen :process observed reason] :when (and (= ref seen) (= pid observed)) :ok)
   [:DOWN seen :process observed reason] :when (and (= ref seen) (= pid observed))
   (if (= reason :noproc) :ok
    (throw (ex-info "service stopped before cleanup acknowledgement" {:reason reason}))))))
