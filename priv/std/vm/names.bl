; vm/names.bl — the host a port answers to (ports Daemon.Names).
;
; ══ WHAT MOVED HERE (FUP-082 T2/D1) ═════════════════════════════════════════
;
; A project's ports have names (`:ports {:web 0 :admin 0}` in env.bl); a name is
; what a developer types, links and opens. This turns a port name into the HOST
; that carries it, so the number the OS chose stays in the registry, out of
; every URL a human touches. Pure function of the tree + the port name — it
; binds nothing (that is vm.ports) and routes nothing (that is bl.gateway).
;
;   (names/host root "web")  → "web.pulse.test"
;   (names/host root :ui)    → "pulse.test"          the session's own address
;   (names/hosts root "web") → ["web.pulse.test" "web.pulse.localhost"]
;   (names/base root)        → "pulse" | "pulse-featurex"  (slug name [+ instance])
;   (names/slug s)           → a single DNS label
;
; It lives in `vm.*` because the gateway + ports + any non-CLI host reuse it.

(ns vm.names
  (:require [bl.env :as project-reader]))

(def OWN-PORT-NAMES #{"ui"})
(def DEFAULT-BRANCHES #{"main" "master" "trunk" "HEAD"})
(def DEFAULT-SUFFIXES (list "test" "localhost"))
(def MAX-LABEL 63)
(def FALLBACK-BASE "app")

(defn slug
  "A DNS label from `s`: lowercased, runs of non-alnum folded to one '-',
   trimmed, truncated to 63. Empty when nothing usable remains."
  [s]
  (if (nil? s)
    ""
    (let [s (if (string? s) s (str s))
          lowered (erlang/apply :string :lowercase (list s))
          folded (erlang/apply :erlang :iolist_to_binary
                   (list (erlang/apply :re :replace
                           (list lowered "[^a-z0-9]+" "-" (to-list [:global (tuple :return :binary)])))))
          trimmed (erlang/apply :string :trim (list folded :both (to-list [45])))
          sliced (erlang/apply :string :slice (list trimmed 0 MAX-LABEL))]
      (erlang/apply :string :trim (list sliced :trailing (to-list [45]))))))

(defn suffixes
  "The host suffixes offered, nearest first. BL_NAMES_SUFFIXES (colon list)
   replaces the default pair."
  []
  (let [v (System/get_env "BL_NAMES_SUFFIXES")]
    (if (and (string? v) (not= v ""))
      (let [parts (erlang/apply :string :split (list v ":" :all))]
        (filter (fn [p] (not= p ""))
                (map slug (filter (fn [p] (not= p "")) (to-list parts)))))
      DEFAULT-SUFFIXES)))

(defn- nonempty
  ([s] (nonempty s FALLBACK-BASE))
  ([s fallback] (if (= s "") fallback s)))

(defn- project [root]
  (try
    (let [p (project-reader/project root)]
      (if (map? p) p {}))
    (catch _ {})))

(defn- branch [root]
  (try
    (let [r (System/cmd "git"
              (to-list ["-C" root "rev-parse" "--abbrev-ref" "HEAD"])
              (to-list [(tuple :stderr_to_stdout true)]))]
      (if (not= 0 (elem r 1))
        nil
        (let [b (erlang/apply :string :trim (list (elem r 0)))]
          (cond
            (= b "") nil
            (contains? DEFAULT-BRANCHES b) nil
            (erlang/apply :string :prefix (list b "-")) nil  ; starts with '-'
            :else (nonempty (slug b) nil)))))
    (catch _ nil)))

(defn instance
  "The instance label for `root`, or nil: `:instance` from env.bl when declared,
   else the git branch when it is not a default branch."
  [proj root]
  (let [decl (:instance proj)]
    (if (and (string? decl) (not= decl ""))
      (nonempty (slug decl) nil)
      (branch root))))

(defn base
  "The base label for `root`: the project name, qualified by its instance.
   Always a single DNS label."
  [root]
  (let [proj (project root)
        nm (let [n (:name proj)]
             (if (and (string? n) (not= n ""))
               n
               (erlang/apply :filename :basename (list (erlang/apply :filename :absname (list root))))))
        inst (instance proj root)]
    (if (nil? inst)
      (nonempty (slug nm))
      (str (nonempty (slug nm)) "-" (slug inst)))))

(defn label
  "The label a port name contributes, or nil when the port IS the session's own
   address (`:ui` answers at the bare base)."
  [port-name]
  (let [s (if (string? port-name) port-name (str port-name))]
    (if (contains? OWN-PORT-NAMES s)
      nil
      (let [l (slug s)]
        (if (= l "") nil l)))))

(defn hosts
  "Every host `port-name` answers to for the tree at `root`, print order."
  [root port-name]
  (let [b (base root)
        lbl (let [l (label port-name)]
              (if (nil? l) b (str l "." b)))]
    (map (fn [suf] (str lbl "." suf)) (suffixes))))

(defn host
  "The first host for `port-name` — the one to print, or nil."
  [root port-name]
  (let [hs (hosts root port-name)]
    (if (empty? hs) nil (first hs))))
