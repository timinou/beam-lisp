; vm/index.bl — the tree's warm code index owner (ports Daemon.IndexWorker).
;
; ══ WHY THIS PROCESS EXISTS ═════════════════════════════════════════════════
;
; A datom conn's store is an ETS table, and an ETS table lives exactly as long
; as the process that created it. That single fact is why every code question
; used to pay for its own index: `bl ask`, `bl search`, the HTTP MCP mount each
; built one, and each died with the command. The fix is OWNERSHIP, not caching:
; a source's analysis is a pure function of its bytes (already cached to disk
; per file); what was missing was a process to HOLD the assembled conn between
; questions. This is that process — node-registered, one per daemon.
;
; Every door asks `code.index/ensure`, which runs its build thunk ON THIS OWNER
; when it exists (`run`), so the conn's tables outlive the answer and the next
; question finds them warm.
;
; ══ WHAT IT OWNS ════════════════════════════════════════════════════════════
;
;   · the conn the last build produced (handed back so a caller can reuse it);
;   · a PUBLIC ETS row describing the build — phase, files done, file in flight,
;     duration — which the dashboard renders so a background build is VISIBLE
;     rather than minutes of silence. The row is ETS, not a call, on purpose:
;     reading progress must never queue behind the build it reports on.
;
; ══ SERIALIZATION ═══════════════════════════════════════════════════════════
;
; Requests serialize on the owner — the honest shape of the resource: one index,
; one owner, one build at a time. A `run` that arrives mid-build waits, then
; finds a warm index (the build it waited for is the one it wanted).
;
;   (index/start root)         → boot the owner + a background build at boot
;   (index/run thunk)          → run thunk ON the owner; its result
;   (index/progress)           → the build's state, off ETS (never blocks)
;   (index/progress! frame)    → record one progress frame (the build's writer)
;   (index/ensure-building)    → kick a background build (idempotent)
;   (index/built)              → the conn the last build produced, or nil

(ns vm.index
  (:require [vm.core :as vmc]))

(def OWNER :vm-index)
(def TABLE :bl_index_progress)

;; ── the public progress row (ETS, read without blocking) ────────────────────

(defn- cold [] {:phase :cold :done 0 :total 0 :file nil})

(defn- ensure-table []
  (when (= :undefined (erlang/apply :ets :whereis (list TABLE)))
    (erlang/apply :ets :new
      (list TABLE (to-list [:set :public :named_table (tuple :read_concurrency true)])))))

(defn- get0 [f k] (or (get f k) 0))

(defn- row
  "One row shape, whichever frame arrived. A build reports :start then :file
   while it runs; a reader matching on :building would fall through to 'nothing
   indexed' mid-build — the one moment the row exists for. Single writer here."
  [f]
  (let [now (erlang/system_time :millisecond)]
    (cond
      (= :start (get f :phase)) {:phase :building :done 0 :total (get0 f :n) :file nil :at now}
      (= :file (get f :phase)) {:phase :building :done (+ 1 (get0 f :i)) :total (get0 f :n) :file (get f :file) :at now}
      :else (assoc f :at now))))

(defn progress
  "The build's current state as a map, off the ETS row. Never blocks and never
   queues: `run` does, and a pane that waits for the build it is reporting on
   could not report on it."
  []
  (ensure-table)
  (let [r (erlang/apply :ets :lookup (list TABLE :progress))]
    (if (and (erlang/is_list r) (not (empty? r)))
      (elem (first r) 1)
      (cold))))

(defn progress!
  "Record one progress frame, as `code.index` reported it. Total on purpose: a
   build must never fail because the UI could not be told, so a frame this does
   not understand is still stored. A non-map (a Vector/Set carrying :__struct__)
   is not a frame at all and is ignored."
  [frame]
  (ensure-table)
  (when (and (map? frame) (not (contains? frame :__struct__)))
    (erlang/apply :ets :insert (list TABLE (tuple :progress (row frame)))))
  :ok)

;; ── the owner process ───────────────────────────────────────────────────────

(defserver owner
  (init [opts]
    (ensure-table)
    (erlang/apply :ets :insert (list TABLE (tuple :progress (cold))))
    ;; A build at BOOT, not on the first question — the point of a warm session
    ;; is that the work happened before anyone asked. Deferred through the
    ;; mailbox so init stays instant and the listener is bound before the tree
    ;; is read. `:build false` is for a test that owns the process for one
    ;; assertion and must not index a real tree behind its back.
    (when (get opts :build true) (erlang/send (erlang/self) [:build]))
    (ok {:root (or (get opts :root) (BeamLisp/cwd)) :built nil}))

  ;; run the caller's thunk HERE, so whatever it builds is owned by this process
  (handle-call [:run thunk] [_from st]
    (reply (thunk) st))

  (handle-call [:built] [_from st]
    (reply (:built st) st))

  (handle-cast [:build] [st]
    (erlang/send (erlang/self) [:build])
    (noreply st))

  (handle-info [:build] [st]
    (noreply (assoc st :built (do-build (:root st))))))

;; ── the build ───────────────────────────────────────────────────────────────

(defn- do-build [root]
  (progress! {:phase :building :done 0 :total 0 :file nil})
  (try
    (do (BeamLisp.Loader/ensure_loaded "code.index")
        (BeamLisp.RT/invoke (BeamLisp.Env/fetch! "code.index" "ensure-tree") (to-list [root])))
    (catch e
      (do (progress! {:phase :error :message (ex-message e) :done 0 :total 0 :file nil})
          nil))))

;; ── public API ──────────────────────────────────────────────────────────────

(defn owner-pid
  "The index owner in THIS VM, or nil."
  []
  (Process/whereis OWNER))

(defn start
  "Boot the tree's index owner (idempotent by name). `opts`: {:root … :build …}.
   Kicks a background build at boot unless :build false. Returns its pid."
  ([] (start {}))
  ([opts]
   (if (nil? (Process/whereis OWNER))
     (vmc/start owner opts {:name OWNER})
     (Process/whereis OWNER))))

(defn run
  "Run `thunk` on the index owner, so whatever it builds is owned by a process
   that outlives this command. With no owner (or if we ARE the owner) run here."
  [thunk]
  (let [p (owner-pid)]
    (if (or (nil? p) (= p (erlang/self)))
      (thunk)
      (call OWNER [:run thunk]))))

(defn ensure-building
  "Kick a background build now (idempotent — a build mid-flight is joined, and
   then HITS because the bytes have not moved). No-op with no owner."
  []
  (when (owner-pid) (cast OWNER [:build])))

(defn built
  "The conn the last build produced, or nil: {:conn :key :stats …}."
  []
  (when (owner-pid) (call OWNER [:built])))
