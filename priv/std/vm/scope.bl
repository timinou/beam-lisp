; vm/scope.bl — scope destructive host effects to the calling VM.
;
; ══ THE PROBLEM ═════════════════════════════════════════════════════════════
;
; `System/halt` is `:erlang.halt` — VM-wide, untrappable. The capability gate
; can DENY the name (op-scope the `System` grant) but cannot change the EFFECT:
; a granted halt kills the node and every VM on it. The Elixir daemon documents
; this as unfixable ("System.halt inside a program is NOT trappable and kills
; the whole daemon … documented, not worked around").
;
; ══ THE ANSWER ══════════════════════════════════════════════════════════════
;
; Don't grant `System/halt` to a project VM at all. Grant instead a SCOPED verb,
; `vm.scope/halt`, that means "end MY vm" — it reads the current VM id (bound in
; the process env when the command was admitted) and tears down exactly that
; VM's process set via `vm.owner/halt`, returning an exit code to the router.
; At the manager/global scope (no VM bound) it is a no-op that reports refusal,
; never `:erlang.halt`.
;
; So a project's `(vm/halt 0)` is "I'm done, tear my sandbox down" — the warm
; node keeps serving every other VM. The ONLY code that may call the real
; `:erlang.halt` is the manager's own shutdown path, compiled at `:global` as
; trusted substrate (the env.bl doctrine: the shim is substrate, not a grant).
;
;   (scope/bind! vm)          ; the router marks THIS process as vm's
;   (scope/current)           ; → vm id | nil
;   (scope/halt code)         ; end the current vm; → {:halted n :code c} | :refused
;   (scope/with-vm vm thunk)  ; run thunk with vm bound, for one request

(ns vm.scope
  (:require [vm.owner :as owner]))

;; The current VM id lives in the process dictionary under a private key, put
;; there by the router when it admits a request into a VM. It is NOT the env id
;; (that is the sandbox); it is the ROUTING identity the owner registry keys on.
(def PDICT-KEY :bl-vm-scope)

(defn bind!
  "Mark THIS process as belonging to VM `vm` — the router calls this before it
   runs a request's body, so a scoped effect inside the body knows its VM."
  [vm]
  (erlang/put PDICT-KEY vm))

(defn current
  "The VM id bound in this process, or nil at manager/global scope."
  []
  ;; erlang/get's miss is the atom :undefined, not nil — normalize it so
  ;; callers test a single absence value.
  (let [v (erlang/get PDICT-KEY)]
    (if (= v :undefined) nil v)))

(defn with-vm
  "Run `thunk` with VM `vm` bound as the current scope, restoring the previous
   binding after. One request's dynamic extent."
  [vm thunk]
  (let [prev (current)]
    (bind! vm)
    (try
      (thunk)
      (finally
        (if (nil? prev)
          (erlang/erase PDICT-KEY)
          (erlang/put PDICT-KEY prev))))))

(defn halt
  "End the CURRENT VM: tear down exactly its process set and hand back an exit
   code for the router to send the client. Never `:erlang.halt`. At manager
   scope (no VM bound) it refuses — a command outside a VM has no sandbox to
   end, and ending the node is the manager's job, not a command's.

   Returns {:halted n :code code} when a VM was scoped, or :refused."
  ([] (halt 0))
  ([code]
   (let [vm (current)]
     (if (nil? vm)
       :refused
       (assoc (owner/halt vm) :code code)))))
