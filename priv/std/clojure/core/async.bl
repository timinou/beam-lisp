; async.bl — Clojure's core.async API, as a thin skin over priv/chan.bl.
;
; This file contains NO channel implementation. It requires `channels`
; (the native BEAM model) and re-exposes it under core.async's vocabulary,
; so unmodified Clojure source that says `(require '[clojure.core.async …])`
; and calls `<!`/`>!`/`go`/`alts!!` runs as-is.
;
; The split mirrors how beam-lisp already separates `priv/optics.bl` (native
; lenses) from `priv/specter/*` (the Clojure optics library) — EXCEPT here
; the compat layer does not reimplement anything. Specter needs its own
; engine because its semantics differ from optics'. core.async's semantics
; are IDENTICAL to native channels on this VM; only the NAMES differ. So
; this layer is ~15 lines of aliasing, not a parallel engine:
;
;   core.async name   ->  native (clojure.core.async.impl/)     why it exists on the JVM
;   ----------------------------------------------------------------------
;   >!!  / >!         ->  put!                    park-real-thread vs park-in-go
;   <!!  / <!         ->  take!                   (a distinction the BEAM lacks)
;   chan / close!     ->  chan / close!           (same — kept verbatim)
;   timeout / alts!!  ->  timeout / select        renamed
;   go   / thread     ->  spawn (+ result chan)   the CPS transform, deleted
;
; On the BEAM `<!` and `<!!` are the SAME operation (parking IS blocking),
; so the four arrow names collapse to two native verbs. `go`/`thread` are a
; `spawn` that publishes the body's result on a channel — the state-machine
; rewrite core.async performs on the JVM is simply absent.
;
; Native code should require `channels` directly and skip this file. This
; exists only so Clojure source loads unmodified.

(ns clojure.core.async
  (:require [clojure.core.async.impl]))

;; Fully-qualified `clojure.core.async.impl/…` throughout (no alias): this file is loaded
;; as a dependency of user code, and a require-alias does not reliably
;; resolve inside a transitively-required file the way it does in an entry
;; file. The qualified name always resolves.

;; channel construction — identical names, re-pointed at the native fns
(defn chan
  ([]  (clojure.core.async.impl/chan))
  ([n] (clojure.core.async.impl/chan n)))

(defn close!   [c] (clojure.core.async.impl/close! c))
(defn timeout  [ms] (clojure.core.async.impl/timeout ms))

;; the four arrow verbs -> two native verbs. On this VM parking = blocking,
;; so >!! and >! are the same call, as are <!! and <!.
(defn >!! [c v] (clojure.core.async.impl/put! c v))
(defn <!! [c]   (clojure.core.async.impl/take! c))
(defn >!  [c v] (clojure.core.async.impl/put! c v))
(defn <!  [c]   (clojure.core.async.impl/take! c))

;; alts!! -> select; core.async's [value channel] return shape is exactly
;; what select returns.
(defn alts!! [ops] (clojure.core.async.impl/select ops))

;; go / thread — a logical thread is a process. Both spawn the body and
;; publish its result on a 1-buffer channel that then closes. The JVM's CPS
;; state-machine transform (`go`) and OS-thread pool (`thread`) collapse
;; into one thing here, because the BEAM has one kind of cheap process.
(defmacro go [& body]
  ;; A macro expands in the CALLER's namespace, where the `ch` alias does
  ;; not exist. Emit fully-qualified `clojure.core.async.impl/` names so the expansion
  ;; resolves regardless of who calls `go`.
  `(let [c# (clojure.core.async.impl/chan 1)]
     (spawn (fn [] (clojure.core.async.impl/put! c# (do ~@body)) (clojure.core.async.impl/close! c#)))
     c#))

(defmacro thread [& body]
  `(let [c# (clojure.core.async.impl/chan 1)]
     (spawn (fn [] (clojure.core.async.impl/put! c# (do ~@body)) (clojure.core.async.impl/close! c#)))
     c#))
