; Portable read-model contract. Identity is descriptive, never a control grant.
(ns runtime.observation)
(def schema "bl.runtime.observation.v1")
(def max-resources 128)
(def max-history 32)
(defn active? [row] (contains? #{:running :cancelling} (:status row)))
(defn retain-history
 "Retain every active owner before newest completed records. The caller must
  enforce active admission separately; history pressure never drops live work."
 [rows limit]
 (when-not (and (int? limit) (pos? limit))
  (throw (ex-info "History limit must be a positive integer" {})))
 (let [active (filter active? rows) completed (remove active? rows)]
  (vec (concat active (take (max 0 (- limit (count active))) completed)))))
(defn bounded-limit [requested]
 (when-not (and (int? requested) (<= 1 requested max-resources))
  (throw (ex-info "Observation limit must be between 1 and 128" {})))
 requested)
(defn envelope [target scope sequence sampled-at rows total]
 {:schema schema :target target :scope scope :sequence sequence
  :sampled-at sampled-at :resources (vec rows) :total total
  :truncated (> total (count rows))
  :limits {:resources max-resources :payloads "not collected"}})

(def delta-schema "bl.runtime.observation.delta.v1")
(defn- scope-of [snapshot] (or (:scope snapshot) {:session (:session snapshot)}))
(defn- bounded-rows [snapshot]
 (let [rows (vec (take (inc max-resources) (:resources snapshot)))]
  (when (> (count rows) max-resources)
   (throw (ex-info "Observation changes require at most 128 resources per scope" {})))
  rows))
(defn changes
 "Compare bounded snapshots. A new/restarted scope requires a full reset;
  sequence gaps count unseen samples, not proven transport packet loss. Current
  snapshots remain the resynchronization authority; changes grant no controls."
 [before after]
 (let [rows (bounded-rows after) old-rows (bounded-rows before)
       sequence (:sequence after) previous (:sequence before)
       reset? (or (nil? before) (not= (scope-of before) (scope-of after))
                  (not (int? sequence)) (not (int? previous))
                  (and (int? sequence) (int? previous) (< sequence previous)))
       old (into {} (map (fn [r] [(:id r) r]) old-rows))
       current (into {} (map (fn [r] [(:id r) r]) rows))]
  {:schema delta-schema :scope (scope-of after) :from previous :sequence sequence
   :reset reset? :sequence-gap (when-not reset? (max 0 (- sequence previous 1)))
   :upsert (if reset? rows (vec (filter (fn [r] (not= r (get old (:id r)))) rows)))
   :removed (if reset? [] (vec (keep (fn [r] (when-not (contains? current (:id r)) (:id r))) old-rows)))
   :total (:total after) :truncated (:truncated after)}))
