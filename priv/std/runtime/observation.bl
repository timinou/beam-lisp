; Portable read-model contract. Identity is descriptive, never a control grant.
(ns runtime.observation)
(def schema "bl.runtime.observation.v1")
(def max-resources 128)
(def max-history 32)
(defn active? [row] (contains? #{:running :cancelling} (:status row)))
(defn retain-history
 "Retain every active owner before newest completed records. The caller must
  enforce active admission separately; history pressure never drops live work."
 [rows limit]
 (when-not (and (int? limit) (pos? limit))
  (throw (ex-info "History limit must be a positive integer" {})))
 (let [active (filter active? rows) completed (remove active? rows)]
  (vec (concat active (take (max 0 (- limit (count active))) completed)))))
(defn bounded-limit [requested]
 (when-not (and (int? requested) (<= 1 requested max-resources))
  (throw (ex-info "Observation limit must be between 1 and 128" {})))
 requested)
(defn envelope [target scope sequence sampled-at rows total]
 {:schema schema :target target :scope scope :sequence sequence
  :sampled-at sampled-at :resources (vec rows) :total total
  :truncated (> total (count rows))
  :limits {:resources max-resources :payloads "not collected"}})
