; codebase.bl — MVP-B: the codebase as a database.
;
; Graduated from research/p13c_datalog_checker (P13c) + typed (MVP-A)
; after their questions were answered. Source is FACTS; checks and
; program-comprehension questions are QUERIES over them:
;
;   [?d :fn/name "double"] [?d :fn/arity 1] [?d :fn/line 12]
;   [?d :fn/ret-tag "int"] [?d :fn/ret-source "annotated"]
;   [?c :call/caller "main"] [?c :call/callee "double"] [?c :call/line 34]
;
; Return types come from the REAL pipe: ^{:ret} annotations read from
; source meta (no loading required), falling back to typed/walk
; inference over the body. Queries shipped:
;
;   arity-mismatches · unknown-callees · reachable · impact (reverse
;   reachability: "what breaks if I change X") · find-by-type /
;   find-returning-only (L10: "which fns return string?")
;
; Head forms the walker understands: defn/defn-/def (incl. multi-clause,
; docstrings, destructuring via typed), defmulti/defmethod, defprotocol/
; extend-type/extend-protocol, defserver, defnative. Unknown macros are
; expanded ONCE via Compiler/macroexpand_1 and the expansion walked —
; the call graph sees through ->> and friends.

(ns ^{:instr {:for "mcp" :kind :usage :order 25
              :title "Reachability: bind the target"
              :text "An impact/reachable answer is only honest when the target is bound via :in. A free variable inside (reaches ?who ?name) means \"reaches SOMETHING\" — every caller in the graph, not the callees of a named fn. code/ask binds the target for you; raw code/query with the % rules must bind it itself. This discipline lives here, in the namespace that owns the rules, and reaches your prompt because the indexer reads this annotation as a fact."}}
  codebase
  (:require [typed] [datom] [compiler] [datom.query.relation]
           [datom.store-fjall] [datom.conn]))

; --- schema -------------------------------------------------------------------

; The name attributes are AVET-indexed: every question here binds a name and
; asks "which entity has it?" — `[?d :fn/name ?callee]` inside a not-join runs
; once per call row, and without the index each run is a full column scan
; (quadratic in the codebase; ~60s for 28 files). With it, a prefix read.
(def SCHEMA
  [{:db/ident :fn/name        :db/valueType :db.type/string :db/index true}
   {:db/ident :fn/ns          :db/valueType :db.type/string}
   {:db/ident :fn/arity       :db/valueType :db.type/long}
   {:db/ident :fn/line        :db/valueType :db.type/long}
   {:db/ident :fn/variadic    :db/valueType :db.type/boolean}
   {:db/ident :fn/ret-tag     :db/valueType :db.type/string :db/index true}
   {:db/ident :fn/ret-source  :db/valueType :db.type/string}
   {:db/ident :call/caller    :db/valueType :db.type/string :db/index true}
   {:db/ident :call/callee    :db/valueType :db.type/string :db/index true}
   {:db/ident :call/arity     :db/valueType :db.type/long}
   {:db/ident :call/line      :db/valueType :db.type/long}
   ;; instruction fragments (mcp.instructions): an agent-facing instruction
   ;; COLOCATED with the namespace it describes, via ^{:instr …} on the ns or
   ;; defn NAME. The corpus file (mcp.instructions) asserts the same attrs —
   ;; one fact space, two authoring styles: in-place, or a separate document.
   {:db/ident :instr/id       :db/valueType :db.type/string :db/unique :db.unique/identity}
   {:db/ident :instr/for      :db/valueType :db.type/string :db/index true}
   {:db/ident :instr/kind     :db/valueType :db.type/keyword :db/index true}
   {:db/ident :instr/order    :db/valueType :db.type/long}
   {:db/ident :instr/title    :db/valueType :db.type/string}
   {:db/ident :instr/text     :db/valueType :db.type/string}])

; Heads that are NOT calls: special forms and the whitelisted macros the
; walker handles structurally. A name containing "/" is interop or an
; aliased var — resolved elsewhere, never "unknown".
(defn interop-name?
  "Interop or alias-qualified callees (contain a /) resolve elsewhere."
  [s]
  (some? (index-of s "/")))

(def special-heads
  #{"ns" "def" "fn" "if" "do" "quote" "syntax-quote" "let" "loop" "recur"
    "throw" "try" "receive" "and" "or" "when" "when-not" "cond" "doseq"
    "defn" "defn-" "defmacro" "defmulti" "defmethod" "defprotocol"
    "extend-type" "extend-protocol" "defrecord" "deftype" "reify"
    "defnative" "defserver" "satisfies?"})

; --- form plumbing (reader nodes; see typed for the shape rules) ------------------

(defn node-form [n] (typed/node-form n))
(defn node-tag [n] (typed/node-tag n))
(defn node-items [n] (typed/node-items n))
(defn node-name [n] (typed/node-name n))
(defn node-pos [n] (typed/node-pos n))

(defn line-of [n fallback]
  (let [p (node-pos n)]
    (if (nil? p) fallback (:line p))))

; --- meta → types ----------------------------------------------------------------

(defn name-annotation
  "The ^ map on a defn name node, as {kw → form-node}, or nil."
  [name-node]
  (if (= :meta (node-tag name-node))
    (nth (erlang/tuple_to_list name-node) 2)
    nil))

(defn annotated-ret
  "^{:ret T} from source meta → tagset, or nil. Meta values are form
   nodes; symbols double as data symbols, which is all type-expr needs."
  [name-node]
  (let [m (name-annotation name-node)]
    (if (and (map? m) (contains? m :ret))
      (typed/type-expr (:ret m))
      nil)))

(defn annotated-args
  "^{:args [T…]} → vector of tagsets, or nil."
  [name-node]
  (let [m (name-annotation name-node)]
    (if (and (map? m) (contains? m :args))
      (into [] (map (fn [a] (typed/type-expr a))
                    (node-items (node-form (:args m)))))
      nil)))

; --- instruction annotations (^{:instr …} — colocated agent instructions) -----

(defn node-data
  "A reader form node as plain data: a :map node → a real map (keyword keys),
   a :vector node → a vector, a :keyword node → a keyword, a :symbol node →
   its name string, a scalar through unchanged. Instruction annotations are
   DATA, never evaluated — this is the only reading they get."
  [n]
  (let [f (node-form n)
        tag (node-tag f)]
    (cond
      (= tag :scalar)  f
      (= tag :keyword) (keyword (second (erlang/tuple_to_list f)))
      (= tag :symbol)  (second (erlang/tuple_to_list f))
      (= tag :vector)  (into [] (map node-data (node-items f)))
      (= tag :list)    (to-list (map node-data (node-items f)))
      (= tag :map)
      ;; a map node's items are {k, v} Erlang tuples (reader pair-items),
      ;; not a flat k v k v sequence
      (reduce (fn [m pair]
                (assoc m (node-data (erlang/element 1 pair))
                         (node-data (erlang/element 2 pair))))
              {} (node-items f))
      :else nil)))

(defn annotated-instr
  "The ^{:instr …} annotation on a NAME node, as a plain map, or nil."
  [name-node]
  (let [m (name-annotation name-node)]
    (if (and (map? m) (contains? m :instr))
      (node-data (:instr m))
      nil)))

(defn instr-fact
  "One instruction fact from a parsed ^{:instr …} map. Defaults make the
   common case one key long: `:id` is ns/name, `:for` is the namespace itself,
   `:kind` is :usage, `:order` 50, `:title` ns/name. `:text` is the point —
   an annotation without it carries nothing. Returns nil for a shape that is
   not a map at all (a stray ^{:instr true} is not an instruction)."
  [ns-str name id frag]
  (if (not (map? frag))
    nil
    {:db/id id
     :instr/id (str (or (get frag :id) (str ns-str "/" name)))
     :instr/for (str (or (get frag :for) ns-str))
     :instr/kind (or (get frag :kind) :usage)
     :instr/order (or (get frag :order) 50)
     :instr/title (str (or (get frag :title) (str ns-str "/" name)))
     :instr/text (str (or (get frag :text) ""))}))

; --- call extraction -----------------------------------------------------------

(declare walk-calls)

(defn walk-children [caller ns-str node acc next-id]
  (reduce (fn [[a i] sub] (walk-calls caller ns-str sub a i))
          [acc next-id] (node-items node)))

(defn walk-calls
  "Every (head …) call under `node`, as facts. `caller` is the
   enclosing fn name (string). Returns [facts next-id]. Meta wrappers
   carry the position; the inner list records against the WRAPPER's
   line (via the :__pos env-style hint, same rule as typed)."
  [caller ns-str node acc next-id]
  (walk-calls-at caller ns-str node acc next-id nil))

(defn walk-calls-at [caller ns-str node acc next-id hint]
  (let [tag (node-tag node)]
    (cond
      (= tag :meta)
        (walk-calls-at caller ns-str (second (erlang/tuple_to_list node))
                       acc next-id (node-pos node))

      (contains? #{:vector :set} tag)
        (reduce (fn [[a i] sub] (walk-calls-at caller ns-str sub a i hint))
                [acc next-id] (node-items node))

      (= tag :map)
        (reduce (fn [[a i] pair]
                  (let [[a2 i2] (walk-calls-at caller ns-str
                                            (first (erlang/tuple_to_list pair)) a i hint)]
                    (walk-calls-at caller ns-str
                                (second (erlang/tuple_to_list pair)) a2 i2 hint)))
                [acc next-id] (node-items node))

      (= tag :list)
        (let [items (node-items node)
              head  (node-form (first items))]
          (if (not (= :symbol (node-tag head)))
            (reduce (fn [[a i] sub] (walk-calls-at caller ns-str sub a i hint))
                    [acc next-id] items)
            (let [hname (node-name head)
                  rec-children (fn [a i]
                                 (reduce (fn [[a2 i2] sub]
                                           (walk-calls-at caller ns-str sub a2 i2 hint))
                                         [a i] (rest items)))]
              (cond
                (contains? special-heads hname)
                  (rec-children acc next-id)

                ; unknown head: macro? expand once, walk the expansion —
                ; the call graph sees through threading. Not a macro:
                ; it is a call.
                :else
                  (let [orig   (typed/->tuple [:list items])
                        grew?  (compiler/macroexpand-1 orig ns-str)]
                    (if (not (identical? grew? orig))
                      (walk-calls-at caller ns-str grew? acc next-id hint)
                      (let [p (node-pos node)
                            line (if (nil? p) (if (nil? hint) 0 (:line hint)) (:line p))
                            fact {:db/id next-id
                                  :call/caller caller
                                  :call/callee hname
                                  :call/arity (count (rest items))
                                  :call/line line}]
                        (rec-children (conj acc fact) (+ next-id 1)))))))))
      :else [acc next-id])))

; --- defn extraction ------------------------------------------------------------

(defn variadic? [params]
  (some (fn [p]
          (and (= :symbol (node-tag (node-form p)))
               (= "&" (node-name (node-form p)))))
        params))

(defn infer-clause-ret
  "typed/walk over a clause body, params bound to declared tags or any."
  [sigs clause args]
  (let [params (:params clause)
        env (if (nil? args)
              (reduce (fn [e p] (typed/bind-pattern e p typed/any)) {} params)
              (reduce (fn [e [p t]] (typed/bind-pattern e p t))
                      {} (map (fn [p t] [p t]) params args)))
        body (:body clause)]
    (reduce (fn [_ b] (typed/walk sigs env b)) typed/never body)))

(defn defn-facts
  "Facts for one defn/defn- form: fn entities (one per arity), ret-tag
   facts (annotated wins over inferred), every call in the bodies, and the
   colocated ^{:instr …} instruction fragment when the name carries one."
  [sigs ns-str form next-fn-id next-call-id next-instr-id]
  (let [f (typed/node-form form)
        items (node-items f)
        name-node (second items)
        name (node-name (node-form name-node))
        line (line-of form 0)
        [cname doc clauses] (typed/defn-clauses items)
        aret (annotated-ret name-node)
        aargs (annotated-args name-node)
        ainstr (annotated-instr name-node)
        by-arity (reduce (fn [m c]
                           (let [a (count (:params c))]
                             (assoc m a (conj (get m a []) c))))
                         {} clauses)
        ; fn facts
        [fn-facts fid]
          (reduce
            (fn [[facts i] [arity cs]]
              [(conj facts
                     {:db/id i :fn/name name :fn/ns ns-str
                      :fn/arity arity :fn/line line
                      :fn/variadic (if (variadic? (:params (first cs))) true false)})
               (+ i 1)])
            [[] next-fn-id] by-arity)
        ; ret facts: annotation or inference. An `any` ret records
        ; NOTHING — unknown stays silent, and does not flood
        ; find-by-type with every tag.
        inferred (if (some? aret)
                   nil
                   (reduce (fn [acc c]
                             (typed/t-union acc (infer-clause-ret sigs c aargs)))
                           typed/never clauses))
        ret (if (some? aret) aret inferred)
        ret-src (if (some? aret) "annotated" "inferred")
        ret-tags (if (or (nil? ret) (= ret typed/all-tags))
                   []
                   (filter keyword? ret))
        [ret-facts fid2]
          (reduce (fn [[facts i] t]
                    [(conj facts {:db/id i :fn/name name :fn/ns ns-str
                                  :fn/ret-tag (str t) :fn/ret-source ret-src})
                     (+ i 1)])
                  [[] fid] ret-tags)
        ; call facts from every clause body
        [call-facts cid]
          (reduce
            (fn [[a i] c]
              (reduce (fn [[a2 i2] b] (walk-calls name ns-str b a2 i2))
                      [a i] (:body c)))
            [[] next-call-id] clauses)
        ; the colocated instruction fragment, when the name carries one
        ifact (instr-fact ns-str name next-instr-id ainstr)]
    {:fn (concat fn-facts ret-facts)
     :calls call-facts
     :instr (if (nil? ifact) [] [ifact])
     :next-fn fid2
     :next-call cid
     :next-instr (if (nil? ifact) next-instr-id (+ next-instr-id 1))}))

; --- other def-bearing forms ------------------------------------------------------

(defn method-body-facts
  "Calls inside defmethod/extend-type/defserver bodies, attributed to a
   synthetic caller name."
  [ns-str caller node acc next-id]
  (walk-calls caller ns-str node acc next-id))

; --- the index ---------------------------------------------------------------------

(defn index-forms
  "All facts from a seq of top-level reader forms: {:fn :calls :instr}."
  [sigs ns-str forms]
  (loop [fs forms fid 1000 cid 100000 iid 500000 fn-acc [] call-acc [] instr-acc []]
    (if (empty? fs)
      {:fn fn-acc :calls call-acc :instr instr-acc}
      (let [form (first fs)
            f (node-form form)]
        (if (and (= :list (node-tag f))
                 (not (empty? (node-items f)))
                 (= :symbol (node-tag (node-form (first (node-items f)))))
                 (contains? #{"defn" "defn-"}
                            (node-name (node-form (first (node-items f))))))
          (let [r (defn-facts sigs ns-str form fid cid iid)]
            (recur (rest fs) (:next-fn r) (:next-call r) (:next-instr r)
                   (concat fn-acc (:fn r)) (concat call-acc (:calls r))
                   (concat instr-acc (:instr r))))
          ; non-defn top level: record calls under "<top>"; an (ns …) form
          ; can still carry a colocated ^{:instr …} on its name.
          (let [[cf cid2] (walk-calls "<top>" ns-str form [] cid)
                is-ns (and (= :list (node-tag f))
                           (not (empty? (node-items f)))
                           (= :symbol (node-tag (node-form (first (node-items f)))))
                           (= "ns" (node-name (node-form (first (node-items f))))))
                ifact (if is-ns
                        (instr-fact ns-str "<ns>" iid
                                    (annotated-instr (second (node-items f))))
                        nil)]
            (recur (rest fs) fid cid2 (if (nil? ifact) iid (+ iid 1))
                   fn-acc (concat call-acc cf)
                   (if (nil? ifact) instr-acc (concat instr-acc [ifact])))))))))

(defn index-source
  "Source text → {:fn […] :calls […] :instr […]}.

   The text must BE text. A caller that read a file and passed the read's
   failure back — `(second (File/read path))` is `:enoent` for a missing
   file — got a `function_clause` from deep inside the reader, which named
   neither the namespace nor the path. Fail here instead, where both are
   still known."
  [sigs ns-str src]
  (when-not (string? src)
    (throw (ex-info "codebase/index-source: source is not a string"
                    {:ns ns-str :source src})))
  (index-forms sigs ns-str (BeamLisp.Reader/read_string src)))

(defn connect-codebase
  "A fresh datom conn with the codebase schema."
  []
  (datom/connect SCHEMA))

(defn transact-source! [conn sigs ns-str src]
  (let [facts (index-source sigs ns-str src)]
    (datom/transact! conn (concat (:fn facts) (:calls facts) (:instr facts)))
    facts))

; --- persistent .blanalysis cache --------------------------------------------
;
; Indexing a source (parse -> facts) and transacting those facts into a store is
; the expensive part of code analysis — seconds for a large file, and it is
; re-paid every time even when the source has NOT changed. But a source's
; analysis is a pure function of its BYTES: same text -> same facts -> same
; datoms. So the analysis is CONTENT-ADDRESSABLE. We persist the fully-indexed
; datom store at a path keyed by sha256(source); an unchanged source reopens
; that store (tens of ms) instead of re-indexing (seconds). This is the
; `.blanalysis` cache — an .olean/.beam-style compiled-analysis artifact.
;
; Correctness never depends on the cache: a missing or stale entry just means a
; fresh index, and the reopened store is BYTE-IDENTICAL to a fresh one because
; the facts are a pure function of the source. The content hash is the sound
; invalidation key — change one byte and the path changes, so a stale artifact
; is never consulted.

(defn blanalysis-dir
  "Where .blanalysis artifacts live: $BLANALYSIS_DIR, else /tmp/blanalysis.
   Read PER CALL, not once at load — a test (or a build) that wants its own
   cache sets the variable and gets it, whether or not `codebase` was already
   loaded. A load-time `def` here meant the first loader of `codebase` fixed
   the directory for every later caller in the VM, and a suite asserting
   «first analyze is a miss» against the shared /tmp cache failed on every
   run after the first: the cache was doing its job."
  []
  (let [env (System/get_env "BLANALYSIS_DIR")]
    (if (nil? env) "/tmp/blanalysis" env)))

(defn cache-path
  "The .blanalysis store path for `ns-str` at content hash `sha`. The ns is in
   the name for legibility; the sha is what makes it sound — a byte-change moves
   the path, so a stale artifact is structurally unreachable."
  [ns-str sha]
  (str (blanalysis-dir) "/" ns-str "." sha ".fjall"))

(defn- cache-available?
  "Whether the persistent fjall backend loaded. Without it the cache is a no-op
   and every analyze indexes fresh (correct, just not cached)."
  []
  (datom.store-fjall/available?))

(defn analyze-cached
  "A codebase connection for `ns-str`'s `src`, using the content-addressed
   .blanalysis cache. Returns `{:conn :db :hit :sha}`.

   HIT (the artifact for this exact source exists): reopen the persistent store
   — tens of ms, no indexing, no transacting. The datoms are already there and
   byte-identical to a fresh index.

   MISS (no artifact, or the fjall backend is absent): open a fresh persistent
   store (or an in-memory one if fjall is unavailable), index + transact the
   source, and — when persistent — sync it to disk so the NEXT run hits. Either
   way the returned db answers every codebase query identically.

   `sigs` are the type seeds `index-source` needs; `ns-str` names the source;
   `src` is its text."
  [sigs ns-str src]
  (let [sha (sha256-hex src)]
    (if (not (cache-available?))
      ; no persistent backend: index fresh into an in-memory conn (uncached)
      (let [conn (connect-codebase)]
        (transact-source! conn sigs ns-str src)
        {:conn conn :db (datom/db conn) :hit false :sha sha})
      (let [path (cache-path ns-str sha)]
        (if (= true (File/exists? path))
          ; HIT: reopen the persistent store; no schema arg — it is recovered
          ; from the stored schema datoms, and re-passing it would re-transact.
          (let [store (datom.store-fjall/open path)
                conn (datom.conn/connect-with store)]
            {:conn conn :db (datom/db conn) :hit true :sha sha})
          ; MISS: create the dir, open a fresh persistent store, index+persist
          (do
            (File/mkdir_p (blanalysis-dir))
            (let [store (datom.store-fjall/open path)
                  conn (datom.conn/connect-with store SCHEMA)]
              (transact-source! conn sigs ns-str src)
              (datom.store-fjall/sync! store)
              {:conn conn :db (datom/db conn) :hit false :sha sha})))))))

; --- the queries ----------------------------------------------------------------

(def REACH
  '[[(calls ?from ?to) [?c :call/caller ?from] [?c :call/callee ?to]]
    [(reaches ?a ?b) (calls ?a ?b)]
    [(reaches ?a ?b) (calls ?a ?x) (reaches ?x ?b)]])

; The SAME edges flipped. The native magic-sets kernel demand-scopes on a
; predicate's FIRST argument, so a reverse (impact) question asked of REACH
; pins position 1 and cannot be demand-scoped; asked of REACH-REV it pins
; position 0 and can. impact(b) = the forward cone of b in the flipped
; graph: (reaches-r b a) ⟺ a transitively calls b. Without this, every
; impact query materialised and decoded the FULL closure and filtered it
; afterwards — measured 200 s on a 7875-edge graph vs milliseconds scoped.
(def REACH-REV
  '[[(calls-r ?to ?from) [?c :call/caller ?from] [?c :call/callee ?to]]
    [(reaches-r ?b ?a) (calls-r ?b ?a)]
    [(reaches-r ?b ?a) (calls-r ?b ?x) (reaches-r ?x ?a)]])

; The two "whole-codebase" questions are each ONE pass over calls joined against
; ONE pass over definitions, with the join done as set lookups in beam-lisp. A
; `[:not-join …]` per call row re-runs its sub-query once per row, so the
; datalog-only spelling is quadratic in the number of calls (a minute for a few
; dozen files); two linear scans and a set difference are the same relation.

(defn- all-calls
  "Every call row as [caller callee arity line]."
  [db]
  (datom/q '[:find ?caller ?callee ?n ?line
             :where
             [?c :call/caller ?caller]
             [?c :call/callee ?callee]
             [?c :call/arity ?n]
             [?c :call/line ?line]]
           db))

(defn- defined-arities
  "{name #{arity …}} over every definition, plus the set of variadic names."
  [db]
  (let [rows (datom/q '[:find ?name ?arity ?variadic
                        :where
                        [?d :fn/name ?name]
                        [?d :fn/arity ?arity]
                        [?d :fn/variadic ?variadic]]
                      db)]
    (reduce (fn [acc row]
              (let [[name arity variadic] (vec row)]
                (-> acc
                    (update-in [:arities name] (fn [s] (conj (or s #{}) arity)))
                    (update :variadic (fn [s] (if variadic (conj s name) s))))))
            {:arities {} :variadic #{}}
            rows)))

(defn arity-mismatches
  "Calls whose callee is defined but never at the called arity
   (variadic fns excluded — their min-arity check is v2)."
  [db]
  (let [defs (defined-arities db)
        arities (:arities defs)
        variadic (:variadic defs)]
    (sort (into []
      (filter (fn [row]
                (let [[_ callee n _] (vec row)
                      known (get arities callee)]
                  (and known
                       (not (contains? variadic callee))
                       (not (contains? known n)))))
              (all-calls db))))))

(defn unknown-callees
  "Calls to names that are never defn'd, not core, not interop/aliased."
  [db core-names]
  (let [defined (:arities (defined-arities db))]
    (sort (into []
      (map (fn [row] (let [[caller callee _ line] (vec row)] [caller callee line]))
        (filter (fn [row]
                  (let [[_ callee _ _] (vec row)]
                    (and (not (contains? defined callee))
                         (not (contains? core-names callee))
                         (not (interop-name? callee)))))
                (all-calls db)))))))

; ── reaches as a first-class relation (the unification) ──────────────────────
;
; The transitive closure of the call graph is ONE relation, :~reaches, whose
; three access modes ARE the three questions asked of a call graph:
;   [?a :~reaches ?b] ?a bound  → reachable(a)  (:bf, what a depends on)
;   [?a :~reaches ?b] ?b bound  → impact(b)     (:fb, what breaks if b changes)
;   [?a :~reaches ?b] both      → reaches?(a,b) (:bb, does a reach b?)
; So `reachable` and `impact` are not two functions with two closures — they are
; two adornments of one relation, and the relation composes inside any query.

(defn reaches-provider
  "The :~reaches provider: transitive-closure edges of the call graph, served in
   whichever access mode the query demanded. `bounds` = {:e from :v to}; each
   bound slot seeds the REACH fixpoint so only the relevant cone is computed
   (the native magic/scoped path), never the whole closure when a seed exists.
     :bf  from bound → forward cone   [from ?to]
     :fb  to   bound → reverse cone   [?from to]
     :bb  both bound → probe          [from to] if from reaches to, else []
     :ff  neither    → the full closure"
  [db mode bounds args]
  (let [from (get bounds :e)
        to (get bounds :v)]
    (cond
      (and (some? from) (some? to))
        ; probe: is `to` in from's forward cone?
        (let [cone (into [] (datom/q '[:find ?b :in $ % ?a :where (reaches ?a ?b)]
                                     db REACH from))]
          (if (some (fn [r] (= (get r 0) to)) cone) [[from to]] []))
      (some? from)
        (mapv (fn [r] [from (get r 0)])
              (into [] (datom/q '[:find ?b :in $ % ?a :where (reaches ?a ?b)]
                                db REACH from)))
      (some? to)
        ; reverse cone: asked of the FLIPPED rules so the bound slot is the
        ; first argument and the magic-sets kernel computes only the cone.
        (mapv (fn [r] [(get r 0) to])
              (into [] (datom/q '[:find ?a :in $ % ?b :where (reaches-r ?b ?a)]
                                db REACH-REV to)))
      :else
        (mapv (fn [r] [(get r 0) (get r 1)])
              (into [] (datom/q '[:find ?a ?b :in $ % :where (reaches ?a ?b)]
                                db REACH))))))

(defn register-reaches!
  "Register :~reaches over the call graph. Idempotent (re-registration replaces).
   Returns :~reaches. Call once before using the relation in a query; the
   codebase helpers `reachable`/`impact` register on demand."
  []
  (datom.query.relation/register-relation! :~reaches
    {:arity 2 :modes #{:bf :fb :bb} :extension :derived
     :maintenance :recompute
     :tags #{:codebase :graph}
     :doc "transitive closure of the call graph (caller reaches callee)"
     :provider reaches-provider}))

(defn reachable
  "Every fn transitively reachable FROM `from` — what `from` depends on. The
   forward (:bf) access mode of the :~reaches relation."
  [db from]
  (register-reaches!)
  (sort (into []
    (datom/q '[:find ?to :in $ ?from :where [?from :~reaches ?to]]
             db from))))

(defn impact
  "Every fn that transitively calls `name` — what breaks if `name` changes. The
   reverse (:fb) access mode of the :~reaches relation."
  [db name]
  (register-reaches!)
  (sort (into []
    (datom/q '[:find ?who :in $ ?name :where [?who :~reaches ?name]]
             db name))))

(defn find-by-type
  "Fns whose return MAY include `tag` (string, e.g. \"string\") — L10."
  [db tag]
  (sort (into []
    (datom/q '[:find ?name ?src
               :in $ ?wanted
               :where
               [?d :fn/name ?name]
               [?d :fn/ret-tag ?wanted]
               [?d :fn/ret-source ?src]]
             db tag))))

(defn find-returning-only
  "Fns whose return is entirely within `tags` (a set of strings).

   Two linear reads and a filter, not a `:not-join`: a nested sub-query
   re-runs once per outer row, so the datalog-only spelling is quadratic
   in the number of definitions. The same relation, with no rescan."
  [db tags]
  (let [rows (datom/q '[:find ?name ?t
                        :where
                        [?d :fn/name ?name]
                        [?d :fn/ret-tag ?t]]
                      db)
        by-name (reduce (fn [m row]
                          (let [[n t] (vec row)]
                            (update m n (fn [s] (conj (or s #{}) t)))))
                        {} rows)
        ok (filter (fn [e] (every? (fn [t] (contains? tags t)) (val e)))
                   (seq by-name))]
    (sort (into [] (map (fn [e] [(key e)]) ok)))))

(defn core-callee-names
  "The always-defined set: every public core name, plus this ns's."
  [ns-str]
  (set (concat (BeamLisp.Env/public_names "core")
               (BeamLisp.Env/public_names ns-str))))
