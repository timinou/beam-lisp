; self/anf.bl — the bl-ANF reference interpreter (the oracle).
;
; The bl-ANF VOCABULARY + constructors graduated to priv/boot/anf.bl in
; PLAN-086 E1 (compiler.bl emits them directly); the quoted→ANF bridge
; (normalise) went with it and dies in E5. What remains here is `interp`:
; a tree-walking evaluator that gives bl-ANF a MEANING independent of any
; backend. It gates the IR without trusting cerl, and it is the
; self-referential oracle now that Elixir genesis is gone: Core output vs
; interp, no Elixir in sight.
;
; Vocabulary contract: see priv/boot/anf.bl's header.

(ns self.anf)

;; ── the reference interpreter ────────────────────────────────────────────────
;;
;; interp gives bl-ANF a meaning that does not depend on cerl or on Elixir. It
;; is a tree-walker over an environment (a map name→value). Host calls go
;; through the real modules via erlang/apply, and fn VALUES are ordinary bl
;; closures — so a program's value is computed with the SAME runtime library
;; (Role B) both backends use, differing only in how control/binding is walked.

(declare interp)

(defn- truthy? [v] (and (not (nil? v)) (not (= false v))))

(defn- pmatch
  "Match value `v` against pattern `p`, extending bindings `b` (a map) or
   returning :nomatch. Mirrors Core/Erlang clause semantics."
  [p v b]
  (cond
    (= :nomatch b) :nomatch
    :else
      (let [op (:pop p)]
        (cond
          (= op :pvar) (assoc b (:name p) v)
          (= op :plit) (if (= (:val p) v) b :nomatch)
          (= op :pnil) (if (or (nil? v) (= (list) v) (and (erlang/is_list v) (empty? v))) b :nomatch)
          (= op :palias) (pmatch (:b p) v (pmatch (:a p) v b))
          (= op :ptuple)
            (if (and (tuple? v) (= (count (:elems p)) (tuple-size v)))
              (reduce (fn [acc [i pe]] (pmatch pe (elem v i) acc))
                      b (map-indexed (fn [i pe] [i pe]) (:elems p)))
              :nomatch)
          (= op :pcons)
            (if (and (erlang/is_list v) (not (empty? v)))
              (pmatch (:tail p) (rest v) (pmatch (:head p) (first v) b))
              :nomatch)
          (= op :pmap)
            (if (map? v)
              (reduce (fn [acc [k pe]]
                        (if (= :nomatch acc) :nomatch
                          (if (contains? v k) (pmatch pe (get v k) acc) :nomatch)))
                      b (:pairs p))
              :nomatch)
          (= op :pstruct)
            (if (and (map? v) (= (:mod p) (get v :__struct__)))
              (reduce (fn [acc [k pe]] (pmatch pe (get v k) acc)) b (:fields p))
              :nomatch)
          :else :nomatch))))

(defn- match-clauses
  "Try each clause against args (a list of values); run the first whose
   patterns match AND whose guard is truthy. `on-fail` is called with no args."
  [clauses args env on-fail]
  (let [hit (some (fn [cl]
                    (let [b (reduce (fn [acc [pat v]] (pmatch pat v acc))
                                    env (map (fn [pat v] [pat v]) (:pats cl) args))]
                      (if (= :nomatch b) nil
                        (if (or (nil? (:guard cl)) (truthy? (interp (:guard cl) b)))
                          [cl b] nil))))
                  clauses)]
    (if (nil? hit) (on-fail) (interp (:body (first hit)) (second hit)))))

(defn interp
  "Evaluate a bl-ANF node under env (name→value). Returns the value."
  [n env]
  (let [op (:op n)]
    (cond
      (= op :lit) (:val n)
      (= op :var) (get env (:name n))
      (= op :global) (BeamLisp.Env/fetch! (:ns n) (:name n))
      (= op :remote) (erlang/apply (:mod n) (:fun n) (to-list (map (fn [a] (interp a env)) (:args n))))
      (= op :apply) (BeamLisp.RT/invoke (interp (:fn n) env) (to-list (map (fn [a] (interp a env)) (:args n))))
      (= op :let) (interp (:body n) (assoc env (:name n) (interp (:init n) env)))
      (= op :if) (if (truthy? (interp (:test n) env)) (interp (:then n) env) (interp (:else n) env))
      (= op :do) (last (map (fn [s] (interp s env)) (:stmts n)))
      (= op :tuple) (erlang/list_to_tuple (to-list (map (fn [e] (interp e env)) (:elems n))))
      (= op :map) (reduce (fn [m [k v]] (assoc m (interp k env) (interp v env))) {} (:pairs n))
      (= op :enil) (list)
      (= op :cons) (cons (interp (:head n) env) (interp (:tail n) env))
      (= op :struct)
        ;; Build the raw struct map with Map/put, NOT bl assoc: assoc on a
        ;; %BeamLisp.Vector treats the key as an index ("assoc index out of
        ;; bounds"). The compiler emits %Mod{…} as a plain map carrying
        ;; :__struct__ plus the fields, so we construct exactly that.
        (reduce (fn [m [k v]] (Map/put m (interp k env) (interp v env)))
                (Map/put (Map/new) :__struct__ (:mod n)) (:fields n))
      (= op :case)
        (match-clauses (:clauses n) (list (interp (:subj n) env)) env
                       (fn [] (erlang/error (tuple :case_clause (interp (:subj n) env)))))
      (= op :fn)
        ;; compiler.bl emits a :fn whose clauses all share one arity (variadic
        ;; and multi-arity are already desugared UPSTREAM into the {:$blfn fixed
        ;; variadic} TUPLE the compiler builds around inner :fn nodes). So a :fn
        ;; node is exactly a raw BEAM closure of fixed arity = its pattern count.
        ;; We produce a real Erlang function of that arity via arity-keyed
        ;; clauses (1..8 covers every fn the compiler emits; a self/apply fn is
        ;; arity 1, the widest observed is small). The body runs the clause
        ;; matcher, so guards and destructuring still hold.
        (let [clauses (:clauses n)
              nargs (count (:pats (first clauses)))
              run (fn [args] (match-clauses clauses args env
                                            (fn [] (erlang/error :function_clause))))]
          (cond
            (= nargs 0) (fn [] (run (list)))
            (= nargs 1) (fn [a] (run (list a)))
            (= nargs 2) (fn [a b] (run (list a b)))
            (= nargs 3) (fn [a b c] (run (list a b c)))
            (= nargs 4) (fn [a b c d] (run (list a b c d)))
            (= nargs 5) (fn [a b c d e] (run (list a b c d e)))
            (= nargs 6) (fn [a b c d e f] (run (list a b c d e f)))
            (= nargs 7) (fn [a b c d e f g] (run (list a b c d e f g)))
            (= nargs 8) (fn [a b c d e f g h] (run (list a b c d e f g h)))
            :else (throw (ex-info "anf/interp: :fn arity > 8" {:nargs nargs}))))
      (= op :try)
        ;; The compiler emits Erlang-shaped catch clauses: two patterns
        ;; (class, reason). `throw` compiles to ExInfo.raise_payload → an
        ;; Elixir `raise`, so on the BEAM the class is :error and the reason is
        ;; the exception struct. bl's own (catch e …) normalises to that reason,
        ;; so we recover the pair by binding [:error caught] — the clause body
        ;; then reconstructs the bl value exactly as the Elixir backend does.
        (let [run (fn []
                    (try (interp (:body n) env)
                         (catch e
                           (if (empty? (:catch n)) (throw e)
                             (match-clauses (:catch n)
                                            (list :error e)
                                            env (fn [] (throw e)))))))]
          (if (nil? (:after n)) (run)
            (try (run) (finally (interp (:after n) env)))))
      (= op :recv)
        (throw (ex-info "anf/interp: :recv not supported in the reference interpreter" {:node n}))
      :else (throw (ex-info "anf/interp: unknown op" {:op op :node n})))))
