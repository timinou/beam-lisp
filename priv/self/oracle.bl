; oracle.bl — the differential oracle: grade the self-hosted frontend against
; the one it is replacing.
;
; The whole self-hosting effort turns on one promise: the reader and compiler
; we write in beam-lisp produce the SAME answer as the existing ones written
; in Elixir. This file is how we hold ourselves to that promise. It runs the
; same input through both sides and checks the results match, tree for tree.
;
; The current Elixir reader/compiler is the ANSWER KEY. It already works and
; is covered by hundreds of tests, so wherever the new side disagrees, the
; new side is wrong. We keep the answer key runnable right up until the very
; end, so a mistake fails a check here instead of shipping.
;
; Two comparisons live here:
;
;   forms-equal?  — did two readers turn the same text into the same tree of
;                   reader nodes? (used by the reader prototype)
;   ast-equal?    — did two compilers turn the same form into the same Elixir
;                   syntax tree? (used by every compiler prototype)

(ns self.oracle
  (:require [reader-node :as rn]))

; --- reading the answer key --------------------------------------------------

(defn oracle-read
  "Read source text into reader nodes using the existing Elixir reader.

   This is the answer key for the reader prototype: whatever text you give
   it, the tree it returns is the tree the new reader must also return."
  [src]
  (BeamLisp.Reader/read_all src))

(defn oracle-compile
  "Compile one reader form into an Elixir syntax tree using the existing
   Elixir compiler.

   This is the answer key for the compiler prototypes: whatever form you give
   it, the syntax tree it returns is the tree the new compiler must also
   return. `env` is a compile environment from
   `BeamLisp.Compiler/new_env`."
  [form env]
  (BeamLisp.Compiler/compile form env))

; --- comparing two Elixir syntax trees ---------------------------------------
;
; An Elixir syntax tree is made of three-part tuples {head, metadata, args}.
; The MIDDLE part is metadata: line numbers, import hints, context markers —
; bookkeeping that does not change what the code MEANS. Two compilers can emit
; the same code with different bookkeeping (one stamps a line, the other does
; not), so a meaning-level comparison must blank that middle element out
; before comparing. What remains is the pure computation: the calls, the
; arguments, the nesting.

(defn strip-ast-meta
  "Blank out the metadata in every node of an Elixir syntax tree, leaving
   only what the code means. A three-part call node {head, meta, args} keeps
   its head and args (both themselves stripped) but its metadata becomes an
   empty list, so two trees that compute the same thing compare equal even if
   they carry different line numbers or import hints. Lists are stripped
   element by element; anything else (a number, an atom, a string) is already
   pure and passes through."
  [node]
  (cond
    (erlang/is_tuple node)
      (let [parts (erlang/tuple_to_list node)]
        (if (= 3 (count parts))
          ; a {head, meta, args} node: keep head and args stripped, blank meta
          (erlang/list_to_tuple
            (list (strip-ast-meta (first parts))
                  (list)
                  (strip-ast-meta (nth parts 2))))
          ; any other tuple (e.g. a {key, value} pair): strip each element
          (erlang/list_to_tuple (into [] (map strip-ast-meta parts)))))
    (list? node)
      (into [] (map strip-ast-meta node))
    :else node))

(defn ast-equal?
  "Say whether two Elixir syntax trees mean the same computation.

   Blanks the metadata out of both (line numbers and import hints do not
   change meaning) and compares what is left. Returns true when they match.
   This is every compiler prototype's gate: compile a form with both the new
   compiler and the answer key, and the trees must be ast-equal."
  [ast-a ast-b]
  (= (strip-ast-meta ast-a) (strip-ast-meta ast-b)))

; --- comparing two trees of reader nodes -------------------------------------
;
; Reader nodes carry source-location metadata ({:line …}) that is noise for a
; correctness check: two readers can agree completely on WHAT was written and
; differ only in a column count. So the comparison strips one :meta layer at
; every level before comparing, the same way the type checker and the
; compiler peel metadata before they look at a node. What remains is the pure
; shape: the symbols, the numbers, the nesting.

(defn strip-meta
  "Remove source-location wrappers from a whole tree of reader nodes, leaving
   only the shapes. Two trees that describe the same program become equal
   even if they were read with different line/column bookkeeping."
  [node]
  (let [tag (rn/node-tag node)]
    (cond
      ; a metadata wrapper: drop it, keep stripping what was inside
      (= tag :meta)
        (strip-meta (rn/node-form node))

      ; the composite shapes: strip every child, keep the shape's tag.
      ; The children are forced to a concrete list with `into []` before
      ; wrapping: beam-lisp's `map` is LAZY, and two unforced lazy seqs never
      ; compare equal even when they will yield the same elements — so an
      ; unforced child would make equality non-deterministic, the exact bug
      ; this comparison exists to avoid.
      (= tag :list)
        (rn/->tuple [:list (into [] (map strip-meta (rn/node-items node)))])
      (= tag :vector)
        (rn/->tuple [:vector (into [] (map strip-meta (rn/node-items node)))])
      (= tag :set)
        (rn/->tuple [:set (into [] (map strip-meta (rn/node-items node)))])
      (= tag :map)
        ; a map node's items are {key value} tuples; strip both sides of each
        (rn/->tuple [:map (into [] (map (fn [pair]
                                 (let [kv (erlang/tuple_to_list pair)]
                                   (erlang/list_to_tuple
                                     (list (strip-meta (first kv))
                                           (strip-meta (second kv))))))
                               (rn/node-items node)))])

      ; a symbol, keyword, number, string, boolean, nil: already pure shape
      :else node)))

(defn forms-equal?
  "Say whether two lists of top-level reader nodes describe the same program.

   Strips source-location metadata from both, then compares. Returns true
   when they match. This is the reader prototype's gate: run a source file
   through both readers, and the trees must be forms-equal."
  [forms-a forms-b]
  ; `into []` forces both sides: the top-level map is lazy too, and the
  ; comparison must be over realized values.
  (= (into [] (map strip-meta forms-a))
     (into [] (map strip-meta forms-b))))

(defn first-diff
  "Find the first top-level form where two readings disagree, for a readable
   failure. Returns {:index i :oracle o :actual a} or nil if they match.

   When a check fails this is what turns 'not equal' into 'form 12 differs:
   the oracle read X, the new reader read Y' — the difference between a red
   light and a place to look."
  [forms-a forms-b]
  (loop [a forms-a b forms-b i 0]
    (cond
      (and (empty? a) (empty? b)) nil
      (empty? a) {:index i :oracle nil :actual (strip-meta (first b))}
      (empty? b) {:index i :oracle (strip-meta (first a)) :actual nil}
      :else
        (let [sa (strip-meta (first a)) sb (strip-meta (first b))]
          (if (= sa sb)
            (recur (rest a) (rest b) (+ i 1))
            {:index i :oracle sa :actual sb})))))
