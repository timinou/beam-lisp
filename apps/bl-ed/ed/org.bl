; ed/org.bl — the structure of a .bl.org document, derived from its lines.
;
; Two views, both pure functions of the text:
;
;   (blocks lines)   the SPAN PARTITION bl.doc uses (priv/std/bl/doc.bl): every
;                    line belongs to exactly one span —
;                      {:kind :prose|:cell|:result|:prose-code|:heading
;                       :from row :to row          ; [from, to) line range
;                       …kind-specific keys}
;                    A beam-lisp `#+begin_src` block is a :cell (with :id,
;                    :frozen?, :silent?, :code-from/:code-to = the code lines);
;                    `#+RESULTS: id` owns its body; other `#+begin_X` blocks
;                    are :prose-code. Headings are their own one-line spans so
;                    the outline and the partition agree. Unlike bl.doc this
;                    scanner NEVER fails: an unterminated block (what the user
;                    is typing right now) runs to the end of the text and is
;                    marked :open? true.
;
;   (outline lines)  the heading tree: [{:level n :title s :row r :end r'
;                    :todo kw|nil :tags [..]}…] in document order, `:end` being
;                    the row the section ends at (exclusive).
;
; The cell-id rule is bl.doc's: explicit `:id`, else the first def name in
; the cell, else `cell-N`, with `-2`/`-3` on a collision.

(ns ed.org)

; ─── line classification ────────────────────────────────────────────────────

(defn heading-level
  "The heading level of a line (`*** x` → 3), or nil. Org requires a space
   after the stars; `*bold*` text is not a heading."
  [l]
  (loop [i 0]
    (cond
      (and (< i (count l)) (= "*" (subs l i (inc i)))) (recur (inc i))
      (and (> i 0) (< i (count l)) (= " " (subs l i (inc i)))) i
      (and (> i 0) (= i (count l))) nil
      :else nil)))

(def ^:private todo-words #{"TODO" "DONE" "ITEM" "DOING" "BLOCKED" "CANCELLED" "REVIEW" "NEXT" "WAIT"})

(defn parse-heading
  "{:level :todo :title :tags} of a heading line."
  [l]
  (let [lvl (heading-level l)
        body (trim (subs l (inc lvl)))
        words (split body " ")
        todo (if (contains? todo-words (first words)) (first words) nil)
        body (if (some? todo) (trim (subs body (count todo))) body)
        ; trailing :tag1:tag2:
        tag-start (if (and (ends-with? body ":") (some? (index-of body " :")))
                    (last-index-of body " :") nil)
        tags (if (some? tag-start)
               (vec (filter (fn [s] (not (blank? s))) (split (subs body (+ tag-start 2)) ":")))
               [])
        title (if (some? tag-start) (trim (subs body 0 tag-start)) body)]
    {:level lvl :todo (if (some? todo) (keyword (lower-case todo)) nil) :title title :tags tags}))

(defn- lc-trim [l] (lower-case (trim l)))
(defn begin-src? [l] (starts-with? (lc-trim l) "#+begin_src"))
(defn end-src? [l] (starts-with? (lc-trim l) "#+end_src"))
(defn begin-block? [l] (starts-with? (lc-trim l) "#+begin_"))
(defn end-block? [l] (starts-with? (lc-trim l) "#+end_"))

(defn results-id
  "The id of a `#+RESULTS: id` / `#+RESULTS[id]` line, or nil."
  [l]
  (let [t (trim l)]
    (cond
      (starts-with? t "#+RESULTS:") (let [r (trim (subs t 10))] (if (blank? r) nil r))
      (starts-with? t "#+RESULTS[") (let [e (index-of t "]")] (if (nil? e) nil (subs t 10 e)))
      :else nil)))

(defn- src-header
  "{:lang :id :frozen? :silent?} of a `#+begin_src` line."
  [l]
  (let [toks (vec (filter (fn [s] (not (blank? s))) (split (trim l) " ")))
        lang (if (> (count toks) 1) (nth toks 1) "")
        attrs (subvec toks (min 2 (count toks)))]
    (loop [i 0 m {:lang lang :id nil :frozen? false :silent? false}]
      (if (>= i (count attrs))
        m
        (let [a (nth attrs i)]
          (cond
            (and (= a ":id") (< (inc i) (count attrs))) (recur (+ i 2) (assoc m :id (nth attrs (inc i))))
            (= a ":frozen") (recur (inc i) (assoc m :frozen? true))
            (= a ":silent") (recur (inc i) (assoc m :silent? true))
            :else (recur (inc i) m)))))))

(defn- find-row [lines from pred]
  (loop [r from]
    (cond (>= r (count lines)) nil (pred (nth lines r)) r :else (recur (inc r)))))

(defn- results-stop? [l]
  (let [t (trim l)]
    (or (blank? t) (some? (heading-level l)) (begin-block? l) (end-block? l) (starts-with? t "#+RESULTS"))))

; ─── the partition ──────────────────────────────────────────────────────────

(defn- push-prose [spans from to]
  (if (< from to) (conj spans {:kind :prose :from from :to to}) spans))

(defn blocks
  "The span partition of `lines` (a vector of strings). Total: every row is in
   exactly one span, spans are in order and contiguous."
  [lines]
  (let [n (count lines)]
    (loop [r 0 prose-from 0 spans []]
      (if (>= r n)
        (push-prose spans prose-from n)
        (let [l (nth lines r)]
          (cond
            (some? (heading-level l))
              (recur (inc r) (inc r)
                     (conj (push-prose spans prose-from r)
                           (merge {:kind :heading :from r :to (inc r)} (parse-heading l))))
            (begin-src? l)
              (let [end (find-row lines (inc r) end-src?)
                    to (if (nil? end) n (inc end))
                    h (src-header l)
                    base {:from r :to to :open? (nil? end)
                          :code-from (inc r) :code-to (if (nil? end) n end) :lang (:lang h)}]
                (recur to to
                       (conj (push-prose spans prose-from r)
                             (if (= "beam-lisp" (:lang h))
                               (merge base {:kind :cell :explicit-id (:id h) :frozen? (:frozen? h) :silent? (:silent? h)})
                               (assoc base :kind :prose-code)))))
            (begin-block? l)
              (let [end (find-row lines (inc r) end-block?)
                    to (if (nil? end) n (inc end))]
                (recur to to (conj (push-prose spans prose-from r)
                                   {:kind :prose-code :lang (trim (subs (lc-trim l) 8)) :from r :to to :open? (nil? end)
                                    :code-from (inc r) :code-to (if (nil? end) n end)})))
            (some? (results-id l))
              (let [stop (find-row lines (inc r) results-stop?)
                    to (cond (nil? stop) n (blank? (nth lines stop)) (inc stop) :else stop)]
                (recur to to (conj (push-prose spans prose-from r)
                                   {:kind :result :id (results-id l) :from r :to to})))
            :else (recur (inc r) prose-from spans)))))))

; ─── cell ids (bl.doc's rule) ───────────────────────────────────────────────

(def ^:private def-heads ["(defn-" "(defn" "(defmacro" "(defmulti" "(defprotocol" "(def"])

(defn- first-def-name [lines]
  (some (fn [l]
          (let [t (triml l)]
            (some (fn [h]
                    (if (and (starts-with? t h) (> (count t) (count h)) (= " " (subs t (count h) (inc (count h)))))
                      (let [rest (trim (subs t (inc (count h))))
                            nm (first (split rest " "))]
                        (if (blank? nm) nil nm))
                      nil))
                  def-heads)))
        lines))

(defn with-cell-ids
  "`spans` with every :cell given its :id by bl.doc's rule."
  [lines spans]
  (:out
    (reduce (fn [acc s]
              (if (not= :cell (:kind s))
                (update acc :out conj s)
                (let [n (inc (:n acc))
                      code (subvec lines (:code-from s) (:code-to s))
                      base (or (:explicit-id s) (first-def-name code) (str "cell-" n))
                      k (get (:seen acc) base 0)
                      id (if (= 0 k) base (str base "-" (inc k)))]
                  {:n n :seen (assoc (:seen acc) base (inc k)) :out (conj (:out acc) (assoc s :id id))})))
            {:n 0 :seen {} :out []}
            spans)))

(defn structure
  "Everything derived from the lines: {:blocks [...] :outline [...]}."
  [lines]
  (let [bs (with-cell-ids lines (blocks lines))]
    {:blocks bs :outline (outline-of bs (count lines))}))

; ─── the outline ────────────────────────────────────────────────────────────

(defn outline-of
  "Headings from the partition, each with :end = the row its section ends at
   (the next heading at the same or a shallower level, else the text end)."
  [bs n]
  (let [hs (vec (filter (fn [s] (= :heading (:kind s))) bs))]
    (vec (map-indexed
           (fn [i h]
             (let [nxt (some (fn [j] (let [g (nth hs j)] (if (<= (:level g) (:level h)) (:from g) nil)))
                             (range (inc i) (count hs)))]
               (assoc h :row (:from h) :end (or nxt n))))
           hs))))

(defn block-at
  "The span containing row `r`. Binary search: spans are in order, contiguous
   and total (the partition invariant), so this is O(log spans) — the render
   asks once per visible row."
  [bs r]
  (loop [lo 0 hi (dec (count bs))]
    (if (> lo hi)
      nil
      (let [mid (quot (+ lo hi) 2)
            s (nth bs mid)]
        (cond
          (< r (:from s)) (recur lo (dec mid))
          (>= r (:to s)) (recur (inc mid) hi)
          :else s)))))

(defn blocks-in
  "The spans intersecting rows [r1, r2)."
  [bs r1 r2]
  (filter (fn [s] (and (< (:from s) r2) (> (:to s) r1))) bs))

(defn heading-at
  "The innermost heading whose section contains row `r`, or nil."
  [ol r]
  (last (filter (fn [h] (and (<= (:row h) r) (< r (:end h)))) ol)))
