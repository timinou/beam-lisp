; ed/org.bl — the editor's view of a .bl.org document's structure.
;
; The partition itself is NOT computed here: `bl.doc.spans` (priv/std/bl/doc/
; spans.bl) is the one scanner every reader of a livebook uses — the BEAM
; runner, the loader's twin, the HTML renderer, and this editor (compiled to
; JS from the same source). This namespace only adds what an editor needs on
; top of it: heading rows as spans, the outline, and fast lookups by row.
;
;   (structure lines) → {:blocks [span…] :outline [heading…]}
;     :blocks  = (spans/spans lines :org {:headings? true}) with cell ids;
;                span kinds :prose :heading :cell :prose-code :block :result,
;                each {:from row :to row …}. Never fails: a block still being
;                typed runs to the end with :open? true.
;     :outline = [{:level :title :todo :tags :row :end}…]

(ns ed.org
  (:require [bl.doc.spans :as spans]))

(defn blocks
  "The span partition of `lines`, heading rows included. Total and ordered."
  [lines]
  (spans/spans lines :org {:headings? true}))

(defn structure
  "Everything derived from the lines: {:blocks [...] :outline [...]}."
  [lines]
  (let [bs (spans/assign-ids lines (blocks lines))]
    {:blocks bs :outline (spans/outline bs (count lines))}))

(defn block-at
  "The span containing row `r`. Binary search: spans are in order, contiguous
   and total (the partition invariant), so this is O(log spans) — the render
   asks once per visible row."
  [bs r]
  (loop [lo 0 hi (dec (count bs))]
    (if (> lo hi)
      nil
      (let [mid (quot (+ lo hi) 2)
            s (nth bs mid)]
        (cond
          (< r (:from s)) (recur lo (dec mid))
          (>= r (:to s)) (recur (inc mid) hi)
          :else s)))))

(defn blocks-in
  "The spans intersecting rows [r1, r2)."
  [bs r1 r2]
  (filter (fn [s] (and (< (:from s) r2) (> (:to s) r1))) bs))

(defn heading-at
  "The innermost heading whose section contains row `r`, or nil."
  [ol r]
  (last (filter (fn [h] (and (<= (:row h) r) (< r (:end h)))) ol)))
