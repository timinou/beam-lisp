; ed/selftest.bl — the editor core's own tests, in BL, runnable on BOTH targets:
;   BEAM:  bl run apps/bl-ed/ed/selftest-beam.bl     (prints the report)
;   JS:    built with the editor; `(run)` from Node or the browser console.
; Each check is [name expected actual]; `run` returns {:pass n :fail [names]}.

(ns ed.selftest
  (:require [ed.text :as t]
            [ed.org :as org]
            [ed.forms :as forms]
            [ed.core :as c]))

(def sample
  "#+TITLE: Sample\n\n* Intro\nSome prose.\n\n#+begin_src beam-lisp :id greet\n(defn greet [who]\n  (str \"hi \" who))\n#+end_src\n#+RESULTS: greet\n: #'user/greet\n\n** Nested :tag:\n#+begin_src beam-lisp\n(def x [1 2 {:a 3}])\n#+end_src\n* Second\nend")

(defn- checks []
  (let [tx (t/from-string "ab\ncdé👍🏽f\n")
        lines (:lines (t/from-string sample))
        s (org/structure lines)
        bs (:blocks s)
        ol (:outline s)
        cell (first (filter (fn [b] (= :cell (:kind b))) bs))
        fr (forms/read-forms lines (:code-from cell) (:code-to cell))
        ; a stray closer at top level, after a complete form
        broken (forms/read-forms ["(defn f [x]" "  (+ x 1)) ]"])
        ; `[x` closed by `)`: the vector closes there (mismatch), the defn stays open
        mismatched (forms/read-forms ["(defn f [x)"])
        ed (c/new-editor "hello\nworld" "x.bl.org")
        ed2 (-> ed (assoc :sels [{:anchor [0 0] :head [0 0]} {:anchor [1 0] :head [1 0]}]) (c/insert-at-heads ">> "))]
    [["text: lines" 3 (t/line-count tx)]
     ["text: grapheme len" 5 (t/line-len tx 1)]
     ["text: round trip" "ab\ncdé👍🏽f\n" (t/to-string tx)]
     ["text: slice across lines" "b\ncd" (t/slice tx [0 1] [1 2])]
     ["text: insert newline" "a\nXb\ncdé👍🏽f\n" (t/to-string (:text (t/insert tx [0 1] "\nX")))]
     ["text: insert end pos" [1 1] (:end (t/insert tx [0 1] "\nX"))]
     ["text: delete across" "acdé👍🏽f\n" (t/to-string (t/delete-range tx [0 1] [1 0]))]
     ["text: next-pos wraps" [1 0] (t/next-pos tx [0 2])]
     ["text: char-at astral" "👍🏽" (t/char-at tx [1 3])]
     ["text: char-at after astral" "f" (t/char-at tx [1 4])]
     ; inserting "\nX" at [0 1] ends at [1 1]: a later pos on row 0 col 2 moves to [1 2]
     ["text: shift same row" [1 2] (t/shift-pos [0 2] [0 1] [0 1] [1 1])]
     ["text: shift later row" [2 3] (t/shift-pos [1 3] [0 1] [0 1] [1 1])]
     ["text: shift before" [0 0] (t/shift-pos [0 0] [0 1] [0 1] [1 1])]
     ["org: span kinds" [:prose :heading :prose :cell :result :heading :cell :heading :prose] (mapv :kind bs)]
     ["org: derived id without a def is cellN (bl.doc's rule)" "cell1" (:id (nth (filter (fn [b] (= :cell (:kind b))) (:blocks (org/structure ["#+begin_src beam-lisp" "(def a 1)" "#+end_src" "#+begin_src beam-lisp" "(+ 1 2)" "#+end_src"]))) 1))]
     ["org: a quote block is a :block" [:block] (mapv :kind (org/blocks ["#+BEGIN_QUOTE" "hi" "#+END_QUOTE"]))]
     ["org: partition is total" (count lines) (reduce + 0 (map (fn [b] (- (:to b) (:from b))) bs))]
     ["org: explicit cell id" "greet" (:id cell)]
     ["org: derived cell id" "x" (:id (nth (filter (fn [b] (= :cell (:kind b))) bs) 1))]
     ["org: result id" "greet" (:id (first (filter (fn [b] (= :result (:kind b))) bs)))]
     ["org: outline titles" ["Intro" "Nested" "Second"] (mapv :title ol)]
     ["org: outline tags" ["tag"] (:tags (nth ol 1))]
     ["org: section end" 16 (:end (first ol))]
     ["org: nested ends at shallower" 16 (:end (nth ol 1))]
     ["org: last section runs to end" 18 (:end (nth ol 2))]
     ["org: unterminated block is open" true (:open? (first (org/blocks ["#+begin_src beam-lisp" "(x"])))]
     ["forms: one top form" 1 (count (forms/navigable fr))]
     ["forms: defn kids" 4 (count (:kids (first fr)))]
     ["forms: span" [[6 0] [7 18]] [(:from (first fr)) (:to (first fr))]]
     ; row 7 is `  (str "hi " who))`; navigable kids of the defn are
     ; defn greet [who] (str …) — so `str` is path [0 3 0]
     ["forms: path at sym" [0 3 0] (forms/path-at fr [7 3])]
     ; whitespace INSIDE a form selects that form; between top-level forms nothing
     ["forms: inner whitespace -> enclosing" [0] (forms/path-at fr [7 0])]
     ["forms: outside every form -> nil" nil (forms/path-at (forms/read-forms ["(a)  (b)"]) [0 4])]
     ["forms: down from defn" [0 0] (:path (forms/motion fr [0] :down))]
     ["forms: up from child" [0] (:path (forms/motion fr [0 1] :up))]
     ["forms: next sibling" [0 2] (:path (forms/motion fr [0 1] :next))]
     ["forms: no wrap cue" "Last form" (:cue (forms/motion fr [0] :next))]
     ["forms: broken input recovers" 2 (count broken)]
     ["forms: problems found" [:stray] (mapv :kind (forms/problems broken))]
     ["forms: mismatch + open reported" [:open :mismatch] (mapv :kind (forms/problems mismatched))]
     ["core: multi-cursor insert" ">> hello\n>> world" (t/to-string (:text ed2))]
     ["core: heads after insert" [[0 3] [1 3]] (mapv :head (:sels ed2))]
     ["core: undo restores" "hello\nworld" (t/to-string (:text (c/undo ed2)))]
     ["core: redo reapplies" ">> hello\n>> world" (t/to-string (:text (c/redo (c/undo ed2))))]
     ["core: dirty after edit" true (c/dirty? ed2)]
     ["core: clean after undo to saved" false (c/dirty? (c/undo ed2))]
     ["core: clean when fresh" false (c/dirty? ed)]]))

(defn run []
  (let [cs (checks)
        fails (filter (fn [[_ e a]] (not= e a)) cs)]
    {:pass (- (count cs) (count fails))
     :fail (mapv (fn [[n e a]] (str n ": expected " (pr-str e) ", got " (pr-str a))) fails)}))
