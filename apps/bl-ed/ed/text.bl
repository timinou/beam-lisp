; ed/text.bl — the document: a persistent vector of lines, edited by position.
;
; A position is `[row col]`: `row` a 0-based line index, `col` a GRAPHEME
; index within the line (the unit BL strings count in — `(count "é👍🏽")` is
; 2), so no position can split a character the user sees as one. A range is
; `[from to)` between two positions, `from` ≤ `to` in document order.
;
; Every function here is pure: a text in, a text out. The vector is
; persistent, so an edit costs O(log32 lines) plus the lines it touches, and
; an old text stays valid — which is what makes undo a pointer and not a copy.

(ns ed.text)

; ─── construction ───────────────────────────────────────────────────────────

(defn from-string
  "A text from a string. Lines split on \\n; a trailing \\r is kept as part of
   the line (CRLF files round-trip byte-for-byte). An empty string is one
   empty line, so every text has at least one line to put a cursor on."
  [s]
  {:lines (vec (split s "\n"))})

(defn to-string [t] (join "\n" (:lines t)))

(defn line-count [t] (count (:lines t)))
(defn line [t row] (nth (:lines t) row ""))
(defn line-len [t row] (count (line t row)))

; ─── positions ──────────────────────────────────────────────────────────────

(defn pos< [[r1 c1] [r2 c2]] (or (< r1 r2) (and (= r1 r2) (< c1 c2))))
(defn pos<= [a b] (not (pos< b a)))
(defn pos-min [a b] (if (pos< b a) b a))
(defn pos-max [a b] (if (pos< a b) b a))

(defn clamp
  "The nearest valid position to `p`: row within the text, col within the line."
  [t [r c]]
  (let [r (max 0 (min r (dec (line-count t))))]
    [r (max 0 (min c (line-len t r)))]))

(defn doc-start [_t] [0 0])
(defn doc-end [t] (let [r (dec (line-count t))] [r (line-len t r)]))

(defn next-pos
  "One grapheme forward; past a line's end is the next line's start. nil at
   the end of the text."
  [t [r c]]
  (cond
    (< c (line-len t r)) [r (inc c)]
    (< r (dec (line-count t))) [(inc r) 0]
    :else nil))

(defn prev-pos
  "One grapheme back; before a line's start is the previous line's end. nil at
   the start of the text."
  [t [r c]]
  (cond
    (> c 0) [r (dec c)]
    (> r 0) [(dec r) (line-len t (dec r))]
    :else nil))

(defn char-at
  "The grapheme at `p`, \"\\n\" at a line's end, nil at the text's end."
  [t [r c]]
  (let [l (line t r)]
    (cond
      (< c (count l)) (subs l c (inc c))
      (< r (dec (line-count t))) "\n"
      :else nil)))

; ─── slicing ────────────────────────────────────────────────────────────────

(defn slice
  "The text between positions `a` and `b` (any order), with \\n between lines."
  [t a b]
  (let [[r1 c1] (pos-min a b) [r2 c2] (pos-max a b)]
    (if (= r1 r2)
      (subs (line t r1) c1 c2)
      (join "\n" (concat [(subs (line t r1) c1)]
                         (map (fn [r] (line t r)) (range (inc r1) r2))
                         [(subs (line t r2) 0 c2)])))))

; ─── editing ────────────────────────────────────────────────────────────────

(defn- splice-lines
  "Replace lines [r1, r2] (inclusive) with the vector `new-lines`."
  [lines r1 r2 new-lines]
  (if (and (= r1 r2) (= 1 (count new-lines)))
    (assoc lines r1 (first new-lines))
    (into (into (subvec lines 0 r1) new-lines) (subvec lines (inc r2)))))

(defn replace-range
  "Replace [a, b) with string `s`. Returns {:text t' :end p}: `p` is the
   position just after the inserted text, where a cursor typing `s` lands."
  [t a b s]
  (let [[r1 c1] (pos-min a b) [r2 c2] (pos-max a b)
        before (subs (line t r1) 0 c1)
        after (subs (line t r2) c2)
        ins (split s "\n")
        n (count ins)
        new-lines (if (= n 1)
                    [(str before (first ins) after)]
                    (vec (concat [(str before (first ins))]
                                 (subvec ins 1 (dec n))
                                 [(str (last ins) after)])))
        end (if (= n 1) [r1 (+ c1 (count (first ins)))] [(+ r1 (dec n)) (count (last ins))])]
    {:text (assoc t :lines (splice-lines (:lines t) r1 r2 new-lines)) :end end}))

(defn insert [t p s] (replace-range t p p s))
(defn delete-range [t a b] (:text (replace-range t a b "")))

; ─── shifting positions across an edit ─────────────────────────────────────

(defn shift-pos
  "Where position `p` moves to after [a, b) was replaced by text ending at
   `end`. A position inside the replaced range collapses to `end`; one after
   it shifts by the edit's row/column delta; one before it is unchanged."
  [p a b end]
  (let [[a b] [(pos-min a b) (pos-max a b)]]
    (cond
      (pos< p a) p
      (pos< p b) end
      (= (first p) (first b)) [(first end) (+ (second end) (- (second p) (second b)))]
      :else [(+ (first p) (- (first end) (first b))) (second p)])))

; ─── words and classes ──────────────────────────────────────────────────────

(defn char-class
  "The class a grapheme belongs to for word motions: :space, :word or :punct.
   Word characters are letters, digits and the Lisp identifier punctuation, so
   `swap!`, `empty?`, `->>` and `ns/name` read as one word, as a Lisp author
   reads them."
  [ch]
  (cond
    (or (nil? ch) (= ch "\n") (= ch " ") (= ch "\t") (= ch "\r")) :space
    (contains? #{"(" ")" "[" "]" "{" "}" "\"" ";" "," "'" "`" "~" "@" "^" "#"} ch) :punct
    :else :word))
