; ed/keymap.bl — keymaps as data, and the dispatcher.
;
; A key is the string the host sends for one keypress: "j", "J", "C-s",
; "M-x", "Escape", "Enter", "Backspace", "Tab", "S-Tab", "ArrowLeft", " ".
; A keymap is {mode {sequence command-name}}, a sequence being keys joined by
; a space ("g g", "m i (", "space o"). Prefixes are implied: if "g g" is
; bound, "g" is a pending prefix.
;
; The keymap is Helix's where Helix has a binding, extended for org and forms:
;   ]h [h  next/prev heading      ]b [b  next/prev block      g u  parent heading
;   g j/k/h/l   form motion (down/up/prev/next) — the web chord for the
;               native Ctrl+J/K/H/L of docs/design/form-first-interaction.md
;   m i ( / m a (   select inside/around the enclosing form   m s  section  m c  cell
;   space e  eval cell   space o  outline   space ?  help   space r/w/s  raise/wrap/splice
;   :  Beam Lisp command line   M-x / space space  palette   C-s  save

(ns ed.keymap
  (:require [ed.num :as num]
            [ed.core :as c]
            [ed.commands :as cmds]
            [ed.text :as t]))

(def normal
  {"h" :move-left "j" :move-down "k" :move-up "l" :move-right
   "ArrowLeft" :move-left "ArrowDown" :move-down "ArrowUp" :move-up "ArrowRight" :move-right
   "w" :word-next "b" :word-prev "e" :word-end "W" :WORD-next "B" :WORD-prev "E" :WORD-end
   "0" :line-start "Home" :line-start "$" :line-end "End" :line-end "^" :first-nonblank
   "g g" :doc-start "G" :doc-end "g e" :doc-end "g s" :first-nonblank "g h" :line-start "g l" :line-end
   "%" :match-delim
   "] h" :heading-next "[ h" :heading-prev "g u" :heading-parent
   "] b" :block-next "[ b" :block-prev
   "g j" :form-down "g k" :form-up "g H" :form-prev "g L" :form-next "Escape" :collapse
   "m m" :select-form "m i (" :select-inner "m a (" :select-around "m i [" :select-inner "m a [" :select-around
   "m i {" :select-inner "m a {" :select-around "m s" :select-section "m c" :select-cell
   "x" :select-line "%" :match-delim "C" :add-cursor-below "," :keep-primary ";" :collapse "M-;" :flip
   "v" :select-mode
   "i" :insert "a" :append "I" :insert-line-start "A" :append-line-end "o" :open-below "O" :open-above
   "d" :delete "c" :change "y" :yank "p" :paste-after "P" :paste-before
   "u" :undo "U" :redo ">" :indent "<" :dedent "C-c" :toggle-comment
   "space r" :raise "space w (" :wrap-round "space w [" :wrap-square "space w {" :wrap-curly "space s" :splice
   "space e" :eval-cell "C-Enter" :eval-cell "space o" :outline "space ?" :help "Tab" :fold-toggle
   ":" :command-line "M-x" :palette "space space" :palette "space k" :describe-key "C-s" :save "space f s" :save})

(def select
  (merge normal
         {"Escape" :select-mode "v" :select-mode}))

(def insert
  {"Escape" :exit-insert "C-s" :save "C-Enter" :eval-cell
   "ArrowLeft" :move-left "ArrowRight" :move-right "ArrowUp" :move-up "ArrowDown" :move-down})

(def default {:normal normal :select select :insert insert})

(defn keymap-of [ed] (merge-with merge default (:user-keys ed)))

(defn- bindings [ed] (get (keymap-of ed) (:mode ed) {}))

(defn- prefix? [binds seq-str]
  (let [p (str seq-str " ")] (some (fn [k] (starts-with? k p)) (keys binds))))

; ─── running commands ───────────────────────────────────────────────────────

(defn run-command
  "Run the command named `name` (a keyword) on `ed`."
  [ed name]
  (let [cmd (cmds/lookup ed name)]
    (if (nil? cmd)
      (c/message ed (str "No command " (pr-str name)))
      (-> ((:run cmd) (assoc ed :message nil))
          (assoc :count nil :last-command name)
          c/scroll-to-cursor))))

(defn describe
  "The binding of `seq-str` in the current mode, as a message."
  [ed seq-str]
  (let [name (get (bindings ed) seq-str)]
    (if (nil? name)
      (c/message ed (str seq-str " is not bound in " (name (:mode ed)) " mode"))
      (c/message ed (str seq-str " runs " (pr-str name) " — " (:doc (cmds/lookup ed name)))))))

; ─── the dispatcher ─────────────────────────────────────────────────────────

(defn- printable? [k] (= 1 (count k)))

(def ^:private digit #{"1" "2" "3" "4" "5" "6" "7" "8" "9" "0"})

(defn key-name
  "The keymap name of a raw key: the space bar is \"space\" in sequences
   (\"space o\"), so a sequence string never contains a bare blank."
  [k]
  (if (= k " ") "space" k))

(defn key-event
  "Process one key in normal/select/insert mode. Insert mode types printable
   keys, Enter and Backspace; every mode resolves bound sequences."
  [ed raw]
  (let [k (if (= :insert (:mode ed)) raw (key-name raw))
        mode (:mode ed)
        binds (bindings ed)
        seq-keys (conj (:pending ed) k)
        seq-str (join " " seq-keys)]
    (cond
      ; describe-key: the NEXT complete sequence is described, not run
      (and (:describe-next ed) (contains? binds seq-str)) (describe (assoc ed :describe-next false :pending []) seq-str)
      ; a count prefix in normal/select ("3w"); "0" is line-start unless a count is in progress
      (and (not= mode :insert) (empty? (:pending ed)) (contains? digit k) (or (not= k "0") (some? (:count ed))))
        (assoc ed :count (+ (* 10 (or (:count ed) 0)) (num/parse-int k)))
      (contains? binds seq-str) (run-command (assoc ed :pending []) (get binds seq-str))
      (prefix? binds seq-str) (assoc ed :pending seq-keys :message (str seq-str "-"))
      ; insert mode: text
      (= mode :insert)
        (cond
          (= k "Enter") (c/insert-at-heads (assoc ed :pending [])
                                           (str "\n" (let [l (t/line (:text ed) (first (c/cursor ed)))]
                                                       (apply str (take-while (fn [ch] (= ch " ")) (map str l))))))
          (= k "Backspace") (c/delete-before-heads (assoc ed :pending []))
          (= k "Tab") (c/insert-at-heads (assoc ed :pending []) "  ")
          (printable? raw) (c/insert-at-heads (assoc ed :pending []) raw)
          :else (assoc ed :pending []))
      :else (assoc ed :pending [] :describe-next false
                   :message (if (empty? (:pending ed)) (str k " is not bound") (str seq-str " is not bound"))))))
