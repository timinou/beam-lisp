; ed/motion.bl — every motion as a function (text, pos) → pos.
;
; A motion only computes a destination. Whether it MOVES a cursor, EXTENDS a
; selection or DEFINES the range an action applies to is the caller's choice
; (ed.commands), which is exactly the Helix split between motions and the
; selection they produce.
;
; Word motions follow Helix/Vim: `w` = start of the next word, `b` = start of
; the previous word, `e` = end of the current/next word; `W`/`B`/`E` treat any
; run of non-space as one WORD. Classes come from ed.text/char-class, so Lisp
; identifiers (`swap!`, `->>`, `ns/name`) are single words.

(ns ed.motion
  (:require [ed.text :as t]
            [ed.org :as org]
            [ed.forms :as forms]))

(defn- class-of [tx p big?]
  (let [k (t/char-class (t/char-at tx p))]
    (if (and big? (= k :punct)) :word k)))

(defn left [tx [r c]] (if (> c 0) [r (dec c)] [r c]))
(defn right [tx [r c]] (if (< c (max 0 (dec (t/line-len tx r)))) [r (inc c)] [r c]))
(defn line-start [_tx [r _]] [r 0])
(defn line-end [tx [r _]] [r (max 0 (dec (t/line-len tx r)))])
(defn first-nonblank [tx [r _]]
  (let [l (t/line tx r)]
    [r (or (some (fn [i] (if (not (contains? #{" " "\t"} (subs l i (inc i)))) i nil)) (range (count l))) 0)]))

(defn up
  "One row up, keeping the column (clamped). `goal` is the remembered column
   for vertical moves; nil uses the current one."
  [tx [r c] goal]
  (if (= r 0) [r c] [(dec r) (min (or goal c) (max 0 (dec (t/line-len tx (dec r)))))]))

(defn down [tx [r c] goal]
  (if (>= r (dec (t/line-count tx))) [r c] [(inc r) (min (or goal c) (max 0 (dec (t/line-len tx (inc r)))))]))

(defn word-next
  "Start of the next word (w / W)."
  [tx p big?]
  (let [k0 (class-of tx p big?)
        ; skip the rest of the current run
        p1 (loop [q p] (let [n (t/next-pos tx q)] (if (and (some? n) (= k0 (class-of tx n big?)) (not= :space k0)) (recur n) q)))
        p2 (or (t/next-pos tx p1) p1)]
    ; then skip whitespace
    (loop [q p2] (let [n (t/next-pos tx q)]
                   (if (and (= :space (class-of tx q big?)) (some? n)) (recur n) q)))))

(defn word-end
  "End of the current/next word (e / E)."
  [tx p big?]
  (let [p1 (or (t/next-pos tx p) p)
        p2 (loop [q p1] (let [n (t/next-pos tx q)] (if (and (= :space (class-of tx q big?)) (some? n)) (recur n) q)))
        k (class-of tx p2 big?)]
    (loop [q p2] (let [n (t/next-pos tx q)] (if (and (some? n) (= k (class-of tx n big?))) (recur n) q)))))

(defn word-prev
  "Start of the previous word (b / B)."
  [tx p big?]
  (let [p1 (or (t/prev-pos tx p) p)
        p2 (loop [q p1] (let [n (t/prev-pos tx q)] (if (and (= :space (class-of tx q big?)) (some? n)) (recur n) q)))
        k (class-of tx p2 big?)]
    (loop [q p2] (let [n (t/prev-pos tx q)] (if (and (some? n) (= k (class-of tx n big?))) (recur n) q)))))

(defn doc-start [tx _] [0 0])
(defn doc-end [tx _] (let [r (dec (t/line-count tx))] [r 0]))

(defn find-char
  "The next (or previous, `dir` -1) occurrence of grapheme `ch` on the line;
   `till?` stops one before it (t / T)."
  [tx [r c] ch dir till?]
  (let [l (t/line tx r) n (count l)]
    (loop [i (+ c dir)]
      (cond
        (or (< i 0) (>= i n)) [r c]
        (= ch (subs l i (inc i))) [r (if till? (- i dir) i)]
        :else (recur (+ i dir))))))

(defn matching-delim
  "The delimiter matching the one under the cursor (% in Helix), using the
   lenient form tree so it agrees with what structural motions see."
  [tx p forest]
  (let [path (forms/path-at forest p)
        node (if (nil? path) nil (forms/node-at forest path))]
    (cond
      (nil? node) p
      (= p (:from node)) (or (t/prev-pos tx (:to node)) p)
      :else (:from node))))

; ─── org motions ────────────────────────────────────────────────────────────

(defn heading-next [struct [r _]]
  (let [h (some (fn [h] (if (> (:row h) r) h nil)) (:outline struct))]
    (if (nil? h) nil [(:row h) 0])))

(defn heading-prev [struct [r _]]
  (let [h (last (filter (fn [h] (< (:row h) r)) (:outline struct)))]
    (if (nil? h) nil [(:row h) 0])))

(defn heading-parent [struct [r _]]
  (let [here (org/heading-at (:outline struct) r)
        p (if (nil? here) nil
            (last (filter (fn [h] (and (< (:level h) (:level here)) (<= (:row h) (:row here)) (> (:end h) (:row here))))
                          (:outline struct))))]
    (if (nil? p) nil [(:row p) 0])))

(defn- block-starts [struct kinds]
  (map :from (filter (fn [b] (contains? kinds (:kind b))) (:blocks struct))))

(defn block-next [struct [r _]]
  (let [x (some (fn [f] (if (> f r) f nil)) (block-starts struct #{:cell :prose-code}))]
    (if (nil? x) nil [x 0])))

(defn block-prev [struct [r _]]
  (let [x (last (filter (fn [f] (< f r)) (block-starts struct #{:cell :prose-code})))]
    (if (nil? x) nil [x 0])))
