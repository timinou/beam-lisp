; bench/json.bl — the benchmark that decides whether a JSON change is a WIN.
;
; ── Why this file has to exist before any optimisation ──────────────────────
;
; Every performance claim in `bl.json` and `bl.json-native` rests on a
; before/after pair taken minutes apart on a loaded host. That is not enough to
; name a cause, and it is barely enough to see an effect: the SAME 24.3 KB decode
; measured 0.97, 1.46 and 1.92 ms inside one session, and `Jason`'s decode of ONE
; FIXED STRING measured 0.19 and 0.71 ms in two runs minutes apart.
;
; ∴ report MEDIAN and MIN, never `best of n`. The min says what the code can do;
; the median says what it does; the distance between them IS the noise floor, and
; a change smaller than that gap cannot be claimed. A layout that hides the gap
; is how a wrong optimisation gets committed.
;
; ── Report LAYERS, not totals ──────────────────────────────────────────────
;
; A total tells you a path is slow and nothing about why. This prints every layer
; the time can be spent in — raw NIF, bl.json's wrapper, OTP's decoder, Jason —
; because that is the only form that identifies a cause. It already earned its
; keep once: the pre-native 2.114 ms decode was assumed to be the parse, and was
; in fact bl's own per-node callbacks (OTP alone 0.262, OTP + bl's callbacks
; 2.303).
;
; Run: ./bin/bl run bench/json.bl

(ns bench.json
  (:require [bl.json :as j] [bl.json-native :as n]))

(def ^:private samples 51)

(defn- ms
  "One call, in milliseconds."
  [f]
  (let [t0 (System/monotonic_time :microsecond)]
    (f)
    (/ (- (System/monotonic_time :microsecond) t0) 1000.0)))

(defn- median [ts]
  (let [s (sort ts)]
    (nth s (erlang/div (count s) 2))))

(defn- round2 [x] (/ (erlang/round (* 100.0 x)) 100.0))

(defn- stat
  "The three numbers worth reporting: the floor, the typical, and the ceiling."
  [f]
  (f)
  (let [ts (to-list (for [_ (range samples)] (ms f)))
        s (sort ts)]
    {:min (first s) :med (median s) :max (last s)}))

(defn- show [label {:keys [min med max]}]
  (str "  " label (join "" (repeat (max 1 (- 22 (count label))) " "))
       " min " (round2 min) "  med " (round2 med) "  max " (round2 max)))

(defn- vs [a b] (round2 (/ (:med a) (:med b))))

; ── the corpus: ONE document per shape, used by every layer ─────────────────
;
; Fixed here rather than generated per run, so two runs measure the same bytes.
; Each shape isolates something: `ints`/`floats`/`strings` are flat and
; homogeneous (so a per-TYPE cost shows up), `mixed` is nested (so a per-CONTAINER
; cost shows up), `frame` is the MCP payload (so the fixed crossing cost shows up).

(def frame {"jsonrpc" "2.0" "id" 7 "method" "tools/call"
            "params" {"name" "read" "args" {"path" "/tmp/x" "limit" 10}}})
(def ints   (to-list (range 500)))
(def floats (to-list (map (fn [i] (+ 0.5 i)) (range 500))))
(def strs   (to-list (repeat 500 "abcdefgh")))
(def flat   (reduce (fn [m i] (assoc m (str "k" i) i)) {} (range 500)))
(def mixed  (to-list (for [i (range 500)]
                       {"id" i "name" (str "row-" i) "tags" (list "a" "b" "c")})))

(def j-frame (Jason/encode! frame))
(def j-ints  (Jason/encode! ints))
(def j-flat  (Jason/encode! flat))
(def j-mixed (Jason/encode! mixed))

(println "native loaded?" (n/loaded?))
(println "samples" samples "per measurement; min is the floor, med is the truth, max is the noise")
(println)
(println "corpus bytes: frame" (erlang/byte_size j-frame)
         " ints" (erlang/byte_size j-ints)
         " flat" (erlang/byte_size j-flat)
         " mixed" (erlang/byte_size j-mixed))
(println)

(println "── ENCODE ────────────────────────────────────────────────────────────────")
(println (show "frame  ~110 B" (stat (fn [] (j/encode frame)))))
(println (show "500 ints" (stat (fn [] (j/encode ints)))))
(println (show "500 floats" (stat (fn [] (j/encode floats)))))
(println (show "500 strings" (stat (fn [] (j/encode strs)))))
(println (show "flat 500-key" (stat (fn [] (j/encode flat)))))
(println (show "mixed 24 KB" (stat (fn [] (j/encode mixed)))))
(println "  Jason, same documents:")
(println (show "  frame" (stat (fn [] (Jason/encode! frame)))))
(println (show "  ints" (stat (fn [] (Jason/encode! ints)))))
(println (show "  floats" (stat (fn [] (Jason/encode! floats)))))
(println (show "  strings" (stat (fn [] (Jason/encode! strs)))))
(println (show "  flat" (stat (fn [] (Jason/encode! flat)))))
(println (show "  mixed" (stat (fn [] (Jason/encode! mixed)))))
(println "  bl.json / Jason  (medians): frame" (vs (stat (fn [] (j/encode frame))) (stat (fn [] (Jason/encode! frame))))
         " ints" (vs (stat (fn [] (j/encode ints))) (stat (fn [] (Jason/encode! ints))))
         " flat" (vs (stat (fn [] (j/encode flat))) (stat (fn [] (Jason/encode! flat))))
         " mixed" (vs (stat (fn [] (j/encode mixed))) (stat (fn [] (Jason/encode! mixed)))))
(println)

(println "── DECODE, BY LAYER ──────────────────────────────────────────────────────")
(println "  every layer decodes the SAME bytes; otp-default returns lists where bl")
(println "  promises vectors, so it is a floor and not a rival")
(println)
(defn- otp [s] (erlang/apply :json :decode (list s)))
;; The four layers are measured INSIDE one sample, in rotated order — NOT 51 samples of
;; one layer and then 51 of the next. Sequential is what this host punishes: each layer
;; then lands in the noise regime of its own second, and the same call measured 0.97, 1.46
;; and 1.92 ms inside one session. Not hypothetical — an ordered run put `full` at 1.81x
;; the NIF and a rotated one at 0.82x, on the same calls, twenty minutes apart.
(defn- layer-times [s]
  (let [fns [(fn [] (n/json-decode s :string))
             (fn [] (otp s))
             (fn [] (j/decode s))
             (fn [] (Jason/decode! s))]
        nf  (count fns)]
    (reduce
      (fn [acc i]
        (reduce (fn [a j]
                  (let [k (erlang/rem (+ i j) nf)
                        t (ms (fn [] ((nth fns k))))]
                    (assoc a k (cons t (get a k (list))))))
                acc
                (range nf)))
      {}
      (range samples))))

(defn- layer-stat [acc k]
  (let [s (sort (to-list (get acc k)))]
    {:min (first s) :med (median s) :max (last s)}))

(defn- lay [label s]
  (let [acc   (layer-times s)
        nif   (layer-stat acc 0)
        otp-d (layer-stat acc 1)
        full  (layer-stat acc 2)
        jasn  (layer-stat acc 3)]
    (println (str "  " label))
    (println (show "    native NIF" nif))
    (println (show "    OTP default" otp-d))
    (println (show "    bl.json full" full))
    (println (show "    Jason" jasn))
    (println (str "    -> full/NIF " (vs full nif) "   full/OTP " (vs full otp-d)
                  "   full/Jason " (vs full jasn)))))
(lay "frame  ~110 B" j-frame)
(lay "500 ints" j-ints)
(lay "flat 500-key" j-flat)
(lay "mixed 24 KB" j-mixed)
