(ns bench.initializer-connection)

(defn run []
  (let [started (erlang/monotonic_time :microsecond)
        fixture (Path/join (BeamLisp/cwd) "test/fixtures/initializer-cycle")]
    (BeamLisp.Loader/with_load_path fixture
      (fn [] (BeamLisp.Loader/ensure_loaded "initializer.connection")))
    (let [lookup (BeamLisp.Env/lookup (tuple "initializer.connection" "rows"))]
      (assert (= :ok (elem lookup 0)))
      (assert (= #{[73]} (elem lookup 1))))
    (println "INITIALIZER_CONNECTION_OK" (- (erlang/monotonic_time :microsecond) started))))
(run)

