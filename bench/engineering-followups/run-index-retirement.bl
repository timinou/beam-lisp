(ns bench.engineering-followups.run-index-retirement (:require [bl.json :as json]))
(println (str "RUNTIME_META " (json/encode
 {:source-root (BeamLisp/cwd)
  :revision (String/trim (elem (System/cmd "git" (list "rev-parse" "HEAD")) 0))
  :tracked-dirty? (not= "" (String/trim (elem (System/cmd "git" (list "status" "--porcelain" "--untracked-files=no")) 0)))
  :compiler-key (BeamLisp.AOTCache/compiler_key)
  :erts (erlang/list_to_binary (erlang/system_info :version))
  :elixir (System/version) :schedulers (erlang/system_info :schedulers_online)})))
(BeamLisp.Loader/with_ambient_dirs (list (BeamLisp/cwd))
 (fn []
  (BeamLisp.Loader/ensure_loaded "bench.engineering-followups.index-retirement")
  (BeamLisp.Ns.Rt/invoke
    (BeamLisp.Env/fetch! "bench.engineering-followups.index-retirement" "run") (list))))
