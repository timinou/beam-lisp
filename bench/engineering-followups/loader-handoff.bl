(ns bench.loader-handoff)

(def ^:private probe :Elixir.BeamLisp.LoaderHandoffBench)
(defn invoke [name & args] (erlang/apply probe name (to-list args)))
(defn worker [agent callback]
  (invoke :worker_call (fn [delegate] (Agent/get_and_update agent (delegate callback) 2000))))
(defn sample [action n]
  (let [before (elem (erlang/process_info (erlang/self) :reductions) 1)
        vm-before (elem (erlang/statistics :reductions) 0)
        started (erlang/monotonic_time :microsecond)]
    (dotimes [_ n] (assert (= :ok (action))))
    {:wall-us (- (erlang/monotonic_time :microsecond) started)
     :caller-reductions (- (elem (erlang/process_info (erlang/self) :reductions) 1) before)
     :vm-reductions (- (elem (erlang/statistics :reductions) 0) vm-before)
     :iterations n}))
(defn run []
  (let [dir (Path/join (System/tmp_dir!) (str "loader-handoff-bench-" (erlang/unique_integer (list :positive))))
        agent (elem (Agent/start (fn [] :state)) 1)
        plain (fn [] (Agent/get_and_update agent
                      (BeamLisp.Env/convey (fn [state] (tuple :ok state))) 2000))
        adapted (fn [] (worker agent (fn [state] (tuple :ok state))))
        initializer-direct (fn [] (invoke :run plain))
        initializer-adapted (fn [] (invoke :run adapted))
        causal (fn [] (invoke :run (fn []
                 (worker agent (fn [state] (tuple (invoke :run (fn [] :ok)) state))))))]
    (try
      (File/mkdir_p! dir)
      (BeamLisp.AOT/compile_host_file (Path/join (BeamLisp/cwd) "priv/host/loader_server.bl")
        (list (tuple :module probe) (tuple :output_dir dir) (tuple :load? true)
              (tuple :behaviour :Elixir.GenServer)))
      ;; Prime compilation, actors and ordinary loader metadata before timing.
      (dotimes [_ 20] (plain) (adapted) (causal))
      (println "HANDOFF_METADATA"
        (pr-str {:revision (String/trim (elem (System/cmd "git" (list "rev-parse" "HEAD")) 0))
                 :compiler-key (BeamLisp.AOTCache/compiler_key)
                 :erts (System/otp_release) :schedulers (erlang/system_info :schedulers_online)}))
      (doseq [round (range 8)]
        (doseq [mode (if (even? round)
                      [:direct :adapted :initializer-direct :initializer-adapted :causal]
                      [:causal :initializer-adapted :initializer-direct :adapted :direct])]
          (println "HANDOFF_SAMPLE" round mode
            (pr-str (sample (case mode :direct plain :adapted adapted
                                      :initializer-direct initializer-direct
                                      :initializer-adapted initializer-adapted :causal causal) 100)))))
      ;; Same synchronous cycle without the cooperative boundary. The short
      ;; test deadline bounds the stall; the production writer deadline is 30s.
      (let [started (erlang/monotonic_time :microsecond)
            baseline (invoke :run (fn []
              (try
                (Agent/get_and_update agent
                  (BeamLisp.Env/convey (fn [state] (tuple (invoke :run (fn [] :ok)) state))) 100)
              :unexpected-completion
              (catch e
                (if (and (= :exit __EXCEPTION_KIND__) (tuple? e)
                         (= :exit (elem e 0)) (tuple? (elem e 1))
                         (= :timeout (elem (elem e 1) 0)))
                  :bounded-timeout
                  (throw (ex-info "Cycle control failed for a reason other than timeout" {:caught e})))))))]
        (println "HANDOFF_BASELINE" baseline (- (erlang/monotonic_time :microsecond) started))
        (assert (= :bounded-timeout baseline)))
      (assert (= :ok (causal)))
      (println "LOADER_HANDOFF_BENCH_OK")
      (finally
        (Agent/stop agent)
        (when (Process/whereis probe) (GenServer/stop probe))
        (code/soft_purge probe) (code/delete probe)
        (File/rm_rf! dir)))))
(run)
