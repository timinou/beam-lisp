(ns bench.realm-packages (:require [application.package :as package]))
(defn in-realm [key action]
 (let [environment (BeamLisp.Env/fork (BeamLisp.Env/env_id))]
  (try (BeamLisp.Env/with_env environment (fn []
         (BeamLisp.Env/put_key (tuple :realm_key) key)
         (BeamLisp.Env/put_key (tuple :realm_decl) {:shadow [] :uses {}}) (action)))
   (finally (BeamLisp.Env/destroy environment)))))
(defn run []
 (let [root (str (System/tmp_dir!) "/realm-package-bench-" (erlang/unique_integer (list :positive)))
       src (str root "/src") entry (str root "/entry.bl") output (str root "/release")
       key (str "Bench" (erlang/unique_integer (list :positive)))
       program "(ns rpb.entry (:require [rpb.fixture]))"
       previous (System/get_env "BEAM_LISP_AOT_REPAIR")
       source (str "(ns rpb.fixture) (def setting (System/get_env \"REALM_BENCH_VALUE\")) "
                   (join " " (map (fn [n] (str "(defn f" n " [] (+ " n " 1))")) (range 64))))]
  (try
   (File/mkdir_p! (str src "/rpb")) (File/write! (str src "/rpb/fixture.bl") source)
   (File/write! entry program)
   (BeamLisp.Loader/with_search_dir src (fn []
    (let [start (erlang/monotonic_time :microsecond)
          built (in-realm key (fn [] (package/build! entry output [])))]
     (println (pr-str {:phase :build :elapsed-us (- (erlang/monotonic_time :microsecond) start)
                      :compiler (BeamLisp.AOTCache/compiler_key) :artifacts (:artifacts built)})))
    ;; Prime the ordinary local AOT cache outside every measured round.
    (System/put_env "BEAM_LISP_AOT_REPAIR" "on")
    (in-realm key (fn [] (BeamLisp.Loader/ensure_loaded "rpb.fixture")))
    (doseq [[trial order] (map-indexed (fn [index value] [index value]) [[:source :warm :package] [:warm :package :source]
                                              [:package :source :warm] [:source :package :warm]
                                              [:package :warm :source] [:warm :source :package]])]
     (doseq [mode order]
      (System/put_env "BEAM_LISP_AOT_REPAIR" (if (= :source mode) "off" "on"))
      (in-realm key (fn []
       (let [start (erlang/monotonic_time :microsecond)
             reductions (elem (erlang/process_info (erlang/self) :reductions) 1)]
        (when (= :package mode) (package/install! output program []))
        (BeamLisp.Loader/ensure_loaded "rpb.fixture")
        (let [elapsed (- (erlang/monotonic_time :microsecond) start)
              cost (- (elem (erlang/process_info (erlang/self) :reductions) 1) reductions)]
         (assert (= 64 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! "rpb.fixture" "f63") (list))))
         (println (pr-str {:trial trial :mode mode :elapsed-us elapsed :caller-reductions cost :oracle 64}))))))))))
   (finally
    (if previous (System/put_env "BEAM_LISP_AOT_REPAIR" previous) (System/delete_env "BEAM_LISP_AOT_REPAIR"))
    (File/rm_rf! root)))))
(run)
