(ns bench.engineering-followups.async-ownership
 (:require [proc.callback :as callback]))

(defn measure [area variant trial operations action]
 (let [start (erlang/monotonic_time :microsecond)
       before (elem (erlang/process_info (erlang/self) :reductions) 1)
       result (action)
       elapsed (- (erlang/monotonic_time :microsecond) start)
       reductions (- (elem (erlang/process_info (erlang/self) :reductions) 1) before)]
  (println "ASYNC-BENCH" (pr-str {:area area :variant variant :trial trial
    :operations operations :elapsed-us elapsed :caller-reductions reductions :result result}))))

(defn worker-trial [variant n]
 (let [parent (erlang/self)]
  (loop [i 0]
   (if (= i n) i
    (let [tag (erlang/make_ref)
          body (fn [] (erlang/send parent [:complete tag]))
          worker (case variant
                   :raw (erlang/spawn body)
                   :conveyed (let [token (BeamLisp.Env/capture)]
                               (erlang/spawn (fn [] (BeamLisp.Env/bind token)
                                              (BeamLisp.Refs/apply_heap_bound) (body))))
                   :owned (spawn body))
          ref (erlang/monitor :process worker)]
     (receive [:complete seen] :when (= tag seen) :ok
      (after 10000 (throw (ex-info "worker benchmark timed out" {}))))
     (receive [:DOWN seen :process _ _] :when (= ref seen) :ok
      (after 10000 (throw (ex-info "worker did not exit" {}))))
     (recur (inc i)))))))

(defn run []
 (let [f (fn [x] (+ x 1)) registration (callback/register! f)
       baseline (ets/info :beam_lisp_code_leases :size)]
  (try
   ;; warm both paths; alternate order, no source/SDK rebuild inside trials.
   (doseq [variant [:raw :conveyed :owned]] (worker-trial variant 10))
   (doseq [trial (range 6)]
    (doseq [variant (nth [[:raw :conveyed :owned] [:owned :conveyed :raw]
                         [:conveyed :raw :owned] [:owned :raw :conveyed]
                         [:raw :owned :conveyed] [:conveyed :owned :raw]] trial)]
     (measure :process-spawn variant trial 100 #(worker-trial variant 100)))
    (doseq [owned? (if (even? trial) [false true] [true false])]
     (measure :retained-invoke (if owned? :registered :direct) trial 1000
      #(loop [i 0 total 0]
        (if (= i 1000) total
         (recur (inc i) (+ total (if owned? (callback/invoke! registration [i]) (f i)))))))))
   (when (not= baseline (ets/info :beam_lisp_code_leases :size))
    (throw (ex-info "Normal completion leaked executable leases" {})))
   (finally (callback/unregister! registration)))))

(run)
