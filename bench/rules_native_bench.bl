; bench/rules_native_bench.bl — one-truth driver vs the all-bl fixpoint.
; Run: mix beam_lisp.run --path priv bench/rules_native_bench.bl
;
; The honest end-to-end comparison. Both paths receive the SAME db, rules, and
; eval-plain. Timing includes EVERYTHING the one-truth path must do:
;   bl evaluates the pattern clauses into base relations   ← bl's job
;   + marshals them across the BEAM boundary                ← the cost in question
;   + the native fixpoint runs                              ← the win
;   + decode                                                ← bl's job
; vs the all-bl fixpoint (datom.query.rules/materialise) doing it all in bl.
;
; The question this answers: after paying the boundary + base-relation cost
; ONCE per query, does native execution of the fixpoint still win? (The earlier
; benchmark timed the kernel in isolation; this times the whole driver.)

(ns bench.rules-native
  (:require [datom] [datom.query.rules :as blr] [datom.query.rules-native :as rn]
            [datom.query.engine :as eng]))

(defn- now [] (erlang/monotonic_time :millisecond))
(defn- median [xs]
  (let [s (into [] (sort (into [] xs))) n (count s)] (get s (erlang/div n 2))))
(defn- time-ms [trials f]
  (let [warm (f)
        samples (mapv (fn [k] (let [t0 (now) r (f) t1 (now)] (- t1 t0))) (range trials))]
    (median samples)))
(defn- row [& parts] (println (str "  " (join "  |  " (to-list (mapv (fn [p] (str p)) parts))))))

(def eval-plain
  (fn [d b c]
    (eng/eval-clause d b c
                     (fn [op] (try (BeamLisp.Env/fetch! "core" (name op)) (catch e nil)))
                     {})))

(def REACH
  '[[(reachable ?a ?b) [?e :e/from ?a] [?e :e/to ?b]]
    [(reachable ?a ?b) [?e :e/from ?a] [?e :e/to ?x] (reachable ?x ?b)]])

(def EDGE-ATTRS
  [{:db/ident :e/from :db/valueType :db.type/long}
   {:db/ident :e/to :db/valueType :db.type/long}])

(defn- chain-db [n]
  (let [conn (datom/connect EDGE-ATTRS)]
    (datom/transact! conn
      (into [] (mapv (fn [i] {:db/id (- i) :e/from i :e/to (+ i 1)}) (range 1 n))))
    (datom/db conn)))

(println "════════ ONE-TRUTH DRIVER vs ALL-BL FIXPOINT (end-to-end) ════════")
(println "both paths: same db + rules + eval-plain; timing includes base-relation")
(println "construction, boundary marshalling, native fixpoint, and decode.")
(println "median of 5 trials after warmup; identical output asserted.\n")
(row "N (chain)" "all-bl ms" "one-truth ms" "speedup" "identical?")

(doseq [n [20 40 60 100]]
  (let [db (chain-db n)
        bl-ms (time-ms 5 (fn [] (blr/materialise db REACH eval-plain)))
        nt-ms (time-ms 5 (fn [] (rn/materialise-native db REACH eval-plain)))
        bl-out (get (blr/materialise db REACH eval-plain) 'reachable)
        nt-out (get (rn/materialise-native db REACH eval-plain) 'reachable)
        ok (= (set (into [] bl-out)) (set (into [] nt-out)))]
    (row n bl-ms nt-ms
         (str (if (> nt-ms 0) (erlang/div bl-ms nt-ms) "-") "x")
         (str (count nt-out) (if ok " ✓" " ✗MISMATCH")))))

(println "\n── where the one-truth path spends its time (N=100) ──")
(let [db (chain-db 100)
      ;; native path decomposed: this is illustrative — the driver does base
      ;; relations + marshalling + fixpoint + decode in one call, so we time
      ;; the whole thing and note the fixpoint dominates for deep recursion.
      total (time-ms 5 (fn [] (rn/materialise-native db REACH eval-plain)))]
  (row "one-truth total ms" total "(base-rel build + marshal + native fixpoint + decode)"))

(println "\n════════ END ════════")
