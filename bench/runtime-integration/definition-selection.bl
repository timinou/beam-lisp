(ns bench.runtime-integration.definition-selection (:require [bench.runtime-integration.common :as c] [env]))
(defn run []
 (let [e (BeamLisp.Env/fork :global) ns "followups.tracked.fixture"]
  (try
   (BeamLisp.Env/with_env e
    (fn []
     (env/eval "(ns followups.tracked.fixture) (defmacro make [] '(defn generated [x] (+ x 1))) (defn ordinary [x] x) (make)")
     (let [definitions (BeamLisp.Env/ns_defs ns)
           names (set (keys definitions))]
      (c/need "generated definition included" (contains? names "generated"))
      (doseq [size [128 2048]]
       (BeamLisp.Env/put_ns_defs ns
        (merge (into {} (map (fn [i] [(str "inherited-" i) (vec (repeat 24 {:ast (String/duplicate "x" 64)}))]) (range size))) definitions))
       (doseq [variant c/schedule]
        (let [sample (c/measure (fn []
               (reduce + (mapv (fn [_]
                (let [selected (if (= variant :baseline)
                      (select-keys (BeamLisp.Env/ns_defs ns) names)
                      (BeamLisp.Env/selected_ns_definitions ns names))]
                 (c/need "same definitions" (= (select-keys definitions names) selected))
                 (count selected))) (range 100)))))]
         (c/emit :metadata (assoc sample :variant variant :inherited size :selected (count names) :operations 100))))))))
   (finally (BeamLisp.Env/destroy e)))))
