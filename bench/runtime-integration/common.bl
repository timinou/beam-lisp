(ns bench.runtime-integration.common (:require [bl.json :as json]))
(defn measure [f]
 (let [t (erlang/monotonic_time :microsecond)
       r (elem (erlang/statistics :reductions) 0)
       value (f)]
  {:us (- (erlang/monotonic_time :microsecond) t)
   :reductions (- (elem (erlang/statistics :reductions) 0) r) :value value}))
(defn emit [area data] (println (str "RUNTIME_JSON " (json/encode {:area area :data data}))))
(def schedule [:baseline :candidate :candidate :baseline :baseline :candidate :candidate :baseline])
(defn need [label ok] (when-not ok (throw (ex-info label {}))) :ok)
