(ns bench.runtime-integration.generations
 (:require [reload.generation :as gen] [env] [reload]))

(defn micros [] (erlang/monotonic_time :microsecond))
(defn timed [action] (let [start (micros) result (action)] [(- (micros) start) result]))
(defn source [value]
 {:sources {"bench.generation.helper" (str "(ns bench.generation.helper) (defn value [] " value ")")
            "bench.generation.router"
             "(ns bench.generation.router (:require [bench.generation.helper :as h] [reload.generation :as g])) (defn render [] [(h/value) (g/resource :assets)])"}
  :roots ["bench.generation.router"] :stable-namespaces #{"reload.generation"}
  :resources {:assets (str "release-" value)}})

(defn sample [action expected n]
 (doseq [_ (range 100)] (assert (= expected (action))))
 (let [measurements (mapv (fn [_] (let [[duration result] (timed action)]
                                   (assert (= expected result)) duration)) (range n))
       ordered (vec (sort measurements)) total (reduce + measurements)]
  {:requests n :errors 0 :p50-us (nth ordered (erlang/trunc (* n 0.50)))
   :p95-us (nth ordered (erlang/trunc (* n 0.95))) :total-us total
   :requests-per-second (if (pos? total) (/ (* n 1000000.0) total) nil)}))

(defn main []
 (let [[preparation-us one] (timed #(gen/prepare! (source 1)))
       [next-preparation-us two] (timed #(gen/prepare! (source 2)))
       slot (gen/slot)]
  (try
   (reload/set-enabled! true)
   (gen/publish! slot nil one)
   (let [admitted (sample #(gen/call! slot "bench.generation.router/render" []) [1 "release-1"] 1000)
         direct (env/with-env (:scope one)
                 (fn []
                  (let [previous (Process/get :bl_generation)
                        handler (BeamLisp.Env/fetch_exact! (get (:mapping one) "bench.generation.router") "render")]
                   (try
                    (Process/put :bl_generation one)
                    (sample #(handler) [1 "release-1"] 1000)
                    (finally (Process/put :bl_generation previous))))))
         [publication-us result] (timed #(gen/publish! slot (:digest one) two))]
    (assert (= :applied (:status result)))
    (assert (= [2 "release-2"] (gen/call! slot "bench.generation.router/render" [])))
    (println {:preparation-us preparation-us :next-preparation-us next-preparation-us
              :publication-us publication-us :admitted admitted :direct-sealed-function direct
              :scope :source-checkout :concurrency 1 :interpretation :safety-overhead-not-speedup}))
   (finally
    (gen/close! slot (:digest two)) (gen/close! slot (:digest one))
    (gen/retire! one) (gen/retire! two) (reload/set-enabled! nil)))))

(main)
