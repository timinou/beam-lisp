(ns bench.runtime-integration.query-composite-join
  (:require [datom :as d] [datom.db :as db] [datom.query.engine :as engine]))
(defn reductions [] (elem (erlang/process_info (erlang/self) :reductions) 1))
(defn run []
  (let [c (d/connect [{:db/ident :join/right :db/valueType :db.type/long
                       :db/cardinality :db.cardinality/many}])]
    (try
      (d/transact! c [{:db/id 100 :join/right (vec (range 500))}])
      (let [db (d/db c) rows (mapv (fn [v] {'?e 100 '?v v}) (range 500))
            clause '[?e :join/right ?v]
            baseline (fn [] (let [candidates (db/datoms db :eavt 100 :join/right)]
              (reduce (fn [acc row]
                (reduce conj acc (filterv some? (mapv (fn [fact] (engine/unify-pattern row clause fact)) candidates)))) [] rows)))
            candidate (fn [] (engine/run-clauses db rows [clause] nil {}))]
        (assert (= (baseline) (candidate)))
        (doseq [variant [:baseline :candidate :candidate :baseline]]
          (let [f (if (= variant :baseline) baseline candidate)
                before (reductions) start (erlang/monotonic_time :microsecond) result (f)]
            (println "COMPOSITE-JOIN" (pr-str {:variant variant :rows (count result)
              :elapsed-us (- (erlang/monotonic_time :microsecond) start)
              :reductions (- (reductions) before)})))))
      (finally (d/close! c)))))

(run)
