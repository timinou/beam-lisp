(ns bench.checkpoints
 (:require [datom.store :as s] [datom.store-fjall :as fj] [datom.conn :as dc]))
(defn micros [] (erlang/monotonic_time :microsecond))
(defn percentile [samples fraction]
 (let [ordered (vec (sort samples))] (nth ordered (min (dec (count ordered)) (erlang/trunc (* fraction (count ordered)))))))
(defn summary [samples]
 {:n (count samples) :p50-us (percentile samples 0.5) :p95-us (percentile samples 0.95) :max-us (apply max samples)})
(defn scenario [source c mode]
 (let [destination (s/fresh-path ".checkpoint-bench") parent (erlang/self)
       gate (atom false) samples (atom []) capture-time (atom nil) chunks (atom []) finish-time (atom nil)
       writer (erlang/spawn
                (fn []
                 (loop [] (when-not @gate (Process/sleep 1) (recur)))
                 (doseq [i (range 120)]
                  (let [before (micros)]
                   (dc/serialized! c #(s/-put source (str "later-" i) i))
                   (swap! samples conj (- (micros) before)))
                  (Process/sleep 1))
                 (erlang/send parent [:checkpoint-writer-done (erlang/self)])))
       begun (micros)
       run-export (fn []
                    (let [before (micros) cursor (s/capture-checkpoint! source)]
                     (reset! capture-time (- (micros) before))
                     (try
                      (let [artifact (s/begin-checkpoint! cursor destination)]
                       (try
                        (reset! gate true)
                        ;; Deterministically admit a writer while the cursor is live.
                        (Process/sleep 5)
                        (loop []
                         (let [before (micros) progress (s/checkpoint-step! artifact {:chunk-size 128 :max-chunk-bytes 524288})]
                          (swap! chunks conj (- (micros) before))
                          (when-not (:done? progress) (Process/sleep 0) (recur))))
                        (let [before (micros) receipt (s/finish-checkpoint! artifact)]
                         (reset! finish-time (- (micros) before)) receipt)
                        (finally (s/abort-checkpoint! artifact))))
                      (finally (s/release-checkpoint! cursor)))))
       receipt (if (= mode :writer-held) (dc/serialized! c run-export) (run-export))
       export-us (- (micros) begun)]
  (receive [:checkpoint-writer-done pid] :when (= pid writer) :done (after 30000 (throw :writer-timeout)))
  {:mode mode :capture-us @capture-time :export-us export-us :entries (:entries receipt)
   :chunks (summary @chunks) :finish-us @finish-time :source-write (summary @samples)}))
(let [source (fj/open-fresh) c (dc/connect-with source []) payload (String/duplicate "x" 2048)]
 (doseq [i (range 5000)] (s/-put source (str "row-" i) payload))
 (s/sync! source)
 (println {:benchmark :logical-checkpoint :rows 5000 :value-bytes 2048
           :baseline (scenario source c :writer-held)
           :online (scenario source c :live-cursor)})
 (dc/close! c))
