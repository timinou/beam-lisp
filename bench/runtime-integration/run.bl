;; One VM for all mechanism benchmarks. Run from the checkout root:
;; TMPDIR=$HOME/tmp/runtime-integration ./bin/bl run bench/runtime-integration/run.bl
;; Native trials include construction and maintenance; query reuse uses ABBA.
(ns bench.runtime-integration.run)
(BeamLisp.Loader/with_ambient_dirs (list (BeamLisp/cwd))
 (fn []
  (doseq [namespace ["bench.runtime-integration.query-reuse"
                    "bench.runtime-integration.leases"
                    "bench.runtime-integration.definition-selection"
                    "bench.runtime-integration.native-index"]]
   (BeamLisp.Loader/ensure_loaded namespace))
  (doseq [namespace ["bench.runtime-integration.query-reuse"
                    "bench.runtime-integration.leases"
                    "bench.runtime-integration.definition-selection"
                    "bench.runtime-integration.native-index"]]
   (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! namespace "run") (list)))))
