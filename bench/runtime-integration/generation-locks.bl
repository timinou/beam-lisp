(ns bench.runtime-integration.generation-locks)

(defn micros [] (erlang/monotonic_time :microsecond))
(defn under [strategy key action]
 (case strategy
  :global-baseline (BeamLisp.Env/with_namespace_lock (tuple :sealed-generation key) action)
  :node-local (BeamLisp.Env/with_generation_lock (tuple :sealed-generation key) action)))
(defn trace-target [strategy]
 (case strategy
  :global-baseline (tuple :global :random_sleep 1)
  :node-local (tuple :Elixir.BeamLisp.Env :wait_for_local_lock_retry 0)))

(defn forced-contention [strategy]
 (let [parent (erlang/self) key (erlang/make_ref) worker (atom nil)
       observed (atom nil) target (trace-target strategy)]
  (try
   (let [_ (under strategy key
             (fn []
              (reset! worker (erlang/spawn (fn []
                (receive :go
                 (let [began (micros)
                       acquired (under strategy key (fn [] (micros)))]
                  (erlang/send parent [:lock-sample (erlang/self) began acquired]))))))
              (erlang/trace @worker true (list :call (tuple :tracer parent)))
              (erlang/send @worker :go)
              ;; Release only after tracing the actual contention path, rather
              ;; than guessing with a sleep. This keeps both mechanisms equal.
              (let [expected @worker]
               (reset! observed
                (receive [:trace pid :call mfa] :when (= pid expected) mfa
                         (after 5000 :missing-contention-trace))))
              (assert (not= :missing-contention-trace @observed))
              (assert (= (elem target 0) (elem @observed 0)))
              (assert (= (elem target 1) (elem @observed 1)))))
         released (micros)
         expected @worker
         [began acquired] (receive [:lock-sample pid started entered] :when (= pid expected)
                                   [started entered] (after 10000 (throw :sample-timeout)))]
    {:wait-us (- acquired began) :after-release-us (max 0 (- acquired released))
     :traced-contention true})
   (finally
    (when (and @worker (Process/alive? @worker)) (erlang/exit @worker :kill))))))

(defn summary [samples field]
 (let [ordered (vec (sort (map field samples))) n (count ordered)]
  {:samples n :p50-us (nth ordered (erlang/trunc (* n 0.50)))
   :p95-us (nth ordered (erlang/trunc (* n 0.95))) :max-us (last ordered)
   :total-us (reduce + ordered)}))

(defn uncontended [strategy]
 (let [key (erlang/make_ref)]
  (doseq [_ (range 100)] (under strategy key (fn [] :ok)))
  (summary (mapv (fn [_] (let [start (micros)]
                          (assert (= :ok (under strategy key (fn [] :ok))))
                          {:duration-us (- (micros) start)})) (range 1000)) :duration-us)))

(defn main []
 (let [strategies [:global-baseline :node-local]
       targets (mapv trace-target strategies)]
  (try
   (doseq [target targets] (assert (= 1 (erlang/trace_pattern target true (list :local)))))
   (doseq [strategy strategies]
    (let [samples (mapv (fn [_] (forced-contention strategy)) (range 24))]
     (println {:scenario :forced-single-collision :strategy strategy
               :node (erlang/node) :otp (erlang/list_to_binary (erlang/system_info :otp_release))
               :traced-contentions (count (filter :traced-contention samples))
               :wait (summary samples :wait-us)
               :after-release (summary samples :after-release-us)
               :uncontended (uncontended strategy)
               :interpretation :controlled-lock-mechanism-not-http-latency})))
   (finally
    (doseq [target targets] (erlang/trace_pattern target false (list :local)))))))

(main)
