;; Mechanism benchmark, not full-app navigation. ABBA schedule, identical result
;; oracle outside timing, actual store rows and caller reductions reported.
(ns bench.runtime-integration.query-reuse
 (:require [datom :as d] [datom.db :as db] [datom.profile :as profile]
           [datom.query.engine :as engine]))
(def schema [{:db/ident :item/name :db/valueType :db.type/string}
             {:db/ident :item/blocked :db/valueType :db.type/boolean}])
(def query '[:find ?e ?n :where [?e :item/name ?n] [:not [?e :item/blocked true]]])
(defn reductions [] (elem (erlang/process_info (erlang/self) :reductions) 1))
(defn run []
 (let [c (d/connect schema)]
 (try
  (d/transact! c (mapv (fn [i] {:db/id i :item/name (str i) :item/blocked true}) (range 1 1001)))
  (let [database (d/db c) watch (profile/watch (db/store-of database))
        database (assoc database :store watch)
        baseline (fn [] (engine/q-uncached query database))
        candidate (fn [] (d/q query database))]
   (assert (= #{} (baseline)))
   (doseq [_ (range 6)] (baseline) (candidate))
   (doseq [variant [:baseline :candidate :candidate :baseline :candidate :baseline :baseline :candidate]]
    (profile/reset! watch)
    (let [action (if (= variant :baseline) baseline candidate)
          start (erlang/monotonic_time :microsecond) before (reductions)]
     (doseq [_ (range 10)] (action))
     (println "RUNTIME-BENCH" (pr-str {:area :negative-query-reuse :variant variant
        :operations 10 :entities 1000 :elapsed-us (- (erlang/monotonic_time :microsecond) start)
        :reductions (- (reductions) before) :store (profile/counters watch)}))))
   (assert (= (baseline) (candidate)))
   (d/transact! c [[:db/retract 1 :item/blocked true]])
   (assert (= #{[1 "1"]} (d/q query (d/db c)))))
  (finally (d/close! c))))
)
