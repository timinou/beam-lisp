(ns bench.runtime-integration.leases (:require [os.lease :as lease]))
(defn acquire [path]
 (loop [tries 0]
  (let [result (lease/acquire! path)]
   (if (:ok result) (:ok result)
    (if (and (= :busy (:error result)) (< tries 1000))
      (do (Process/sleep 1) (recur (inc tries)))
      (throw (ex-info "Lease benchmark admission failed" result)))))))
(defn run []
 (let [path (str (System/tmp_dir!) "/lease-bench-" (erlang/unique_integer (list :positive)))]
 (try
  (lease/release! (acquire path))
  (doseq [trial (range 5)]
   (let [start (erlang/monotonic_time :microsecond)]
    (doseq [_ (range 20)] (lease/release! (acquire path)))
    (println "RUNTIME-BENCH" (pr-str {:area :os-lease :trial trial :operations 20
                                     :elapsed-us (- (erlang/monotonic_time :microsecond) start)}))))
  (finally (File/rm path))))
)
