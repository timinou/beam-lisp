;; bench/lazy_scaling.bl — the lazy-sequence cost ledger.
;;
;; Every case is timed at n and 2n. A linear case doubles (ratio ≈ 2); a case
;; whose per-element cost grows with the input (the class this bench exists to
;; catch: a lazy-seq thunk that captures the unconsumed input, or a memo cell
;; that copies a large closure environment per element) quadruples.
;;
;;   bl run bench/lazy_scaling.bl            → a table, one row per case
;;   bl run bench/lazy_scaling.bl -- 16000   → a different n
;;
;; test/bl/lazy_scaling_test.bl asserts the same cases at a smaller n.
;;
;; EVIDENCE IS RELATIVE, never an absolute wall time: the 2n:n ratio is the
;; signal (2 = linear, 4 = quadratic), so a host under swap contention moves
;; both columns together and the verdict survives. Compare a before/after pair
;; on the SAME host, same load, same n.
;;
;; COST: `env` is a 20,000-entry map; at the default n=8000 the 2n column walks
;; a 16,000-element vector per case, three timed runs each, nineteen cases. Run
;; it under a memory cap so a sizing mistake kills the program and not the
;; machine:
;;
;;   systemd-run --user --scope -p MemoryMax=6G -p MemorySwapMax=1G -- \\
;;     bin/bl run bench/lazy_scaling.bl -- 8000
;;
;; It needs the chunked producers and the fold surface (`map`, `filter`,
;; `distinct`, `dedupe`, `partition`, `partition-by`, `interpose`, `interleave`,
;; `for`, `into`, `mapv`), as `test/bl/lazy_scaling_test.bl` does.

(ns bench.lazy-scaling)

(defn- ms [f]
  (let [t0 (erlang/monotonic_time :microsecond)]
    (f)
    (/ (- (erlang/monotonic_time :microsecond) t0) 1000.0)))

(defn- best [f] (min (ms f) (ms f) (ms f)))

(def cases
  "name → (fn [coll env]) that fully consumes a lazy result over coll. `env` is
   a large map the step fn closes over (the captured-environment case)."
  [["map-indexed"   (fn [c _] (count (map-indexed (fn [i x] [i x]) c)))]
   ["keep-indexed"  (fn [c _] (count (keep-indexed (fn [i x] (when (even? i) x)) c)))]
   ["distinct"      (fn [c _] (count (distinct c)))]
   ["dedupe"        (fn [c _] (count (dedupe c)))]
   ["keep"          (fn [c _] (count (keep (fn [x] (when (odd? x) x)) c)))]
   ["partition-by"  (fn [c _] (count (partition-by (fn [x] (quot x 7)) c)))]
   ["partition 4"   (fn [c _] (count (partition 4 c)))]
   ["interpose"     (fn [c _] (count (interpose 0 c)))]
   ["interleave"    (fn [c _] (count (interleave c c)))]
   ["for"           (fn [c _] (count (for [x c] x)))]
   ["for :when"     (fn [c _] (count (for [x c :when (even? x)] x)))]
   ["map"           (fn [c _] (count (map inc c)))]
   ["first/rest walk map-indexed"
    (fn [c _] (loop [s (map-indexed (fn [i x] [i x]) c) n 0] (if (seq s) (recur (rest s) (inc n)) n)))]
   ["reduce map-indexed" (fn [c _] (reduce (fn [a _] (inc a)) 0 (map-indexed (fn [i x] [i x]) c)))]
   ["into [] map"   (fn [c _] (count (into [] (map inc c))))]
   ["mapv, f closes over env" (fn [c env] (count (mapv (fn [x] (get env x)) c)))]
   ["map, f closes over env"  (fn [c env] (count (map (fn [x] (get env x)) c)))]
   ["for, body closes over env" (fn [c env] (count (for [x c] (get env x))))]
   ["distinct walk, env" (fn [c env] (count (distinct (map (fn [x] (get env x)) c))))]])

(defn run [n]
  (let [env (into {} (map (fn [i] [i i]) (range 20000)))]
    (for [[nm f] cases]
      (let [a (best (fn [] (f (vec (range n)) env)))
            b (best (fn [] (f (vec (range (* 2 n))) env)))]
        {:case nm :n-ms a :double-n-ms b :ratio (if (< a 1.0) 0.0 (/ b a))}))))

(defn -main [& args]
  (let [n (if (seq args) (erlang/binary_to_integer (first args)) 8000)]
    (println (str "n = " n "   (ratio: 2 = linear, 4 = quadratic; blank when n-ms < 1)"))
    (doseq [{:keys [case n-ms double-n-ms ratio]} (run n)]
      (println (str (subs (str case "                                  ") 0 32)
                    (subs (str (erlang/round n-ms) " ms          ") 0 12)
                    (subs (str (erlang/round double-n-ms) " ms          ") 0 12)
                    (if (zero? ratio) "" (/ (erlang/round (* 10 ratio)) 10.0)))))))

(apply -main *command-line-args*)
