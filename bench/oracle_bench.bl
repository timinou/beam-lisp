; bench/oracle_bench.bl — today's z3/check path vs the oracle prototype, per layer.
;
;   BL_DAEMON=off ./bl run bench/oracle_bench.bl
;
; The question set is the `account` verify loop: one prelude (define-fun Inv +
; decls), N transition obligations Inv(s) ∧ guard ∧ s2=next ∧ ¬Inv(s2).

(ns oracle.bench (:require [oracle] [z3] [z3pool] [smt :as smtlib] [system.decide :as decide]))

(defn now [] (erlang/monotonic_time :microsecond))
(defmacro timed [label n & body]
  `(let [t0# (now)] ~@body (println ~label "→" (quot (- (now) t0#) ~n) "us/q")))

(def prelude
  ['(define-fun Inv ((balance Int)) Bool (>= balance 0))
   '(declare-const balance Int)
   '(declare-const balance2 Int)
   '(declare-const amt Int)
   '(assert (Inv balance))])

;; N distinct transitions (the amount bound varies so no two scripts are equal)
(defn transition [i]
  [(list 'assert (list 'and (list '>= 'amt 0) (list '>= 'balance 'amt) (list '<= 'amt i)))
   '(assert (= balance2 (- balance amt)))
   '(assert (not (Inv balance2)))])

(def N 100)
(defn now [] (erlang/monotonic_time :microsecond))
(def obls (vec (map (fn [i] (oracle/obligation (keyword (str "t" i)) (concat prelude (transition i)))) (range N))))

(z3/pool! 4)
(def port (z3/open))
(z3/check port (concat prelude (transition 0)))          ; warm the pool
(println "solvers:" (z3pool/pool-size) " questions:" N)
(println)

;; ── L0 today: z3/check, string verdict, reset per question ──────────────
(timed "today   z3/check (reset+prelude+q) ×N" N
  (doseq [i (range N)] (= "unsat" (z3/check port (concat prelude (transition i))))))

;; ── L2+L6: oracle/ask — verdict record, effect handler, memo cold ────────
(oracle/memo-clear!)
(timed "L2/L6   oracle/ask cold (memo miss) ×N" N
  (doseq [o obls] (oracle/proven? (oracle/ask o))))

;; ── L5: the same obligations again — memo hit, no solver ─────────────────
(decide/clear-here!)
(timed "L5      oracle/ask warm (memo hit) ×N" N
  (doseq [o obls] (oracle/proven? (oracle/ask o))))
(println "        memo entries:" (oracle/memo-size) " solver calls on the warm pass:"
         (count (filter (fn [d] (= :z3 (:tier d))) (decide/here))))

;; ── L4: one session, prelude once, push/pop per question ─────────────────
(def steps (vec (map (fn [i] (oracle/obligation (keyword (str "s" i)) (transition i))) (range N))))
(timed "L4      oracle/session + scoped ×N" N
  (oracle/session prelude
    (fn [] (doseq [o steps] (oracle/proven? (oracle/scoped o))))))

;; ── L7: fan-out of cold asks over the pool ───────────────────────────────
(oracle/memo-clear!)
(timed "L7      oracle/ask-all cold ×N over pool" N
  (oracle/ask-all obls))
(println "        pool high-water during fan-out:" (z3pool/high-water))

;; ── L6: the effect, handled without z3 ───────────────────────────────────
(oracle/memo-clear!)
(timed "L6      with-oracle table (no z3) ×N" N
  (oracle/with-oracle (oracle/table {})
    (fn [] (doseq [o obls] (oracle/undecided? (oracle/ask o))))))
(println "        denied handler throws:"
         (try (oracle/with-oracle oracle/deny (fn [] (oracle/ask (first obls)))) false (catch _ true)))

;; ── L2: the record itself ────────────────────────────────────────────────
(oracle/memo-clear!)
(let [sat (oracle/obligation :cex [ '(declare-const x Int) '(declare-const y Real)
                                     '(assert (= x (- 7))) '(assert (= y (/ 1.0 4.0)))])
      v (oracle/ask sat true)]
  (println)
  (println "a refuted obligation, as a value:" (dissoc v :us))
  (println "  x =" (get (:model v) "x") " y =" (get (:model v) "y") " refuted?" (oracle/refuted? v)))
