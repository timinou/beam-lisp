; bench/store_backend_bench.bl — the two DURABLE store backends, head to head.
; Run: mix beam_lisp.run --path priv bench/store_backend_bench.bl
;
; ── What this measures, and why each number is honest ─────────────────
;
; `datom.store/Store` is filled by two persistent engines that make opposite
; structural bets:
;
;   fjall   an LSM tree     — writes land in a memtable and flush sequentially;
;                             range scans merge sorted runs.
;   sqlite  a B-tree        — `WITHOUT ROWID` table keyed by the BLOB key; a
;                             write updates pages in place, a scan walks the
;                             B-tree in key order.
;
; The datom log is APPEND-DOMINATED (each datom writes into 2-4 index orderings,
; monotonically) and reads are ORDERED RANGE SCANS. That shape is the LSM's home
; turf and the B-tree's tax, so this bench exists to put a NUMBER on that
; intuition rather than assert it. Both engines run in the SAME durability mode
; (journaled per commit, fsync deferred to an explicit `sync!`), so the
; comparison is engine-vs-engine, not fsync-policy-vs-fsync-policy.
;
;   1  BULK COMMIT      N entries in atomic batches — the transaction write path.
;   2  SYNC (fsync)     the cost of forcing the batch to disk once at the end.
;   3  POINT GET        random single-key lookups — the -get path.
;   4  RANGE SCAN       ordered windows of growing width — the load-bearing read.
;   5  FULL SCAN        every key in order — a table-wide read.
;   6  END-TO-END       a real datom db: transact M entities, then query.
;
; Keys are 8-byte BIG-ENDIAN integers: byte-lexicographic order == numeric
; order, so a range `[lo, hi]` selects exactly the numeric window — which is how
; the real datom key codec's ordering behaves, in miniature.

(ns bench.store-backend
  (:require [datom.store]
            [datom.store-fjall]
            [datom.store-sqlite]
            [datom.conn]
            [datom.db]
            [datom.query.engine :as eng]))

;; ── timing: median of trials after a warmup ─────────────────────────

(defn- now-us [] (erlang/monotonic_time :microsecond))
(defn- median [xs]
  (let [s (into [] (sort (into [] xs))) n (count s)]
    (if (= 0 (rem n 2))
      (erlang/div (+ (get s (- (erlang/div n 2) 1)) (get s (erlang/div n 2))) 2)
      (get s (erlang/div n 2)))))
(defn- time-us [trials f]
  (let [_warm (f)
        samples (mapv (fn [_] (let [t0 (now-us) _ (f) t1 (now-us)] (- t1 t0)))
                      (range trials))]
    (median samples)))

(defn- header [t] (println (str "\n" t)))
(defn- row [& parts]
  (println (str "  " (join " | " (to-list (mapv (fn [p] (str p)) parts))))))
(defn- ms [us] (str (erlang/div us 1000) "." (rem (erlang/div us 100) 10) "ms"))
; sub-millisecond-aware: keep us when small, switch to ms past 1000us, so a
; cheap checkpoint reads honestly (e.g. "312us") instead of collapsing to 0.0ms.
(defn- dur [us] (if (< us 1000) (str us "us") (ms us)))

;; ── order-preserving binary keys ────────────────────────────────────
;; 8-byte big-endian: memcmp order == numeric order, so range windows are exact.

(defn- be64 [n]
  (erlang/list_to_binary
    (to-list (mapv (fn [i] (rem (erlang/bsr n (* 8 (- 7 i))) 256)) (range 8)))))

;; A datom-shaped value, so term_to_binary pays a realistic encode/decode tax
;; (not a bare integer). [e a v tx op] — the exact shape the index layer stores.
(defn- datom-val [i]
  [i :bench/attr (str "value-" i) (+ 1000000 i) true])

;; ── the two backends under test ─────────────────────────────────────

(defn- backends []
  (let [fj (if (datom.store-fjall/available?)
             [["fjall" datom.store-fjall/open-fresh datom.store-fjall/sync!]]
             (do (println "  (fjall unavailable — skipped)") []))
        sq (if (datom.store-sqlite/available?)
             [["sqlite" datom.store-sqlite/open-fresh datom.store-sqlite/sync!]]
             (do (println "  (sqlite unavailable — skipped)") []))]
    (concat fj sq)))

;; ── 1+2  bulk commit + sync ─────────────────────────────────────────
;;
;; Write N entries in batches of BATCH via -commit (one atomic transaction each),
;; then sync! once. This is the transaction write path: the append-dominated
;; workload both engines are ultimately judged on.

(def N-WRITE 20000)
(def BATCH 500)

(defn- bulk-commit! [open-fresh]
  ; Returns the populated store so later phases reuse it (no re-populate).
  (let [s (open-fresh)]
    (doseq [chunk (partition BATCH (range N-WRITE))]
      (datom.store/-commit
        s (mapv (fn [i] [:put (be64 i) (datom-val i)]) chunk)))
    s))

(defn bench-writes []
  (header (str "1+2  BULK COMMIT — " N-WRITE " entries in batches of " BATCH
               ", then one sync"))
  (row "engine" "bulk-commit" "sync" "commit/entry")
  (doseq [b (backends)]
    (let [nm (get b 0) open-fresh (get b 1) sync! (get b 2)
          ; time the whole populate once (median over 3 fresh stores)
          commit-us (time-us 3 (fn [] (bulk-commit! open-fresh)))
          ; sync must be timed on a DIRTY store, ONCE: a repeat sync of an
          ; already-checkpointed store is a no-op (~0), and subtracting two
          ; independent medians drowns the fsync cost in populate noise. So:
          ; populate a fresh store, then time the single checkpoint directly.
          sync-us (let [s (bulk-commit! open-fresh)
                        t0 (now-us) _ (sync! s) t1 (now-us)]
                    (- t1 t0))]
      (row nm (ms commit-us) (dur sync-us)
           (str (erlang/div commit-us N-WRITE) "us")))))

;; ── 3  point get ────────────────────────────────────────────────────

(def N-GET 5000)

(defn bench-point-get []
  (header (str "3  POINT GET — " N-GET " random single-key lookups"))
  (row "engine" "total" "per-get")
  (doseq [b (backends)]
    (let [nm (get b 0) open-fresh (get b 1)
          s (bulk-commit! open-fresh)
          ; deterministic pseudo-random probe keys within the populated range
          probes (mapv (fn [i] (be64 (rem (* i 7919) N-WRITE))) (range N-GET))
          get-us (time-us 3 (fn []
                              (reduce (fn [acc k] (datom.store/-get s k)) nil probes)))]
      (row nm (ms get-us) (str (erlang/div get-us N-GET) "us")))))

;; ── 4  range scan (growing window) ──────────────────────────────────

(defn bench-range []
  (header "4  RANGE SCAN — ordered windows of growing width (median us)")
  (row "engine" "w=10" "w=100" "w=1000" "w=10000")
  (doseq [b (backends)]
    (let [nm (get b 0) open-fresh (get b 1)
          s (bulk-commit! open-fresh)
          scan (fn [w]
                 (time-us 5 (fn []
                              (let [lo (rem (* 3 w) (- N-WRITE w))]
                                (count (datom.store/-range s (be64 lo) (be64 (+ lo w))))))))]
      (row nm (ms (scan 10)) (ms (scan 100)) (ms (scan 1000)) (ms (scan 10000))))))

;; ── 5  full scan ────────────────────────────────────────────────────

(defn bench-full-scan []
  (header (str "5  FULL SCAN — every one of " N-WRITE " keys in order"))
  (row "engine" "total" "per-1k")
  (doseq [b (backends)]
    (let [nm (get b 0) open-fresh (get b 1)
          s (bulk-commit! open-fresh)
          scan-us (time-us 3 (fn [] (count (datom.store/-range s nil nil))))]
      (row nm (ms scan-us) (str (erlang/div scan-us (erlang/div N-WRITE 1000)) "us")))))

;; ── 6  end-to-end datom database ────────────────────────────────────
;;
;; The whole point of the port: a real database, transacting real entities and
;; answering real queries, over each backend in turn. This is the number a user
;; feels — everything above L1 is identical, so any gap here is the engine.

(def M-ENTITIES 3000)
(def E-BATCH 300)

(defn- schema []
  [{:db/ident :p/name :db/valueType :db.type/string}
   {:db/ident :p/age :db/valueType :db.type/long :db/index true}
   {:db/ident :p/city :db/valueType :db.type/string :db/index true}])

(defn- entities [lo n]
  (mapv (fn [i] {:db/id (- (+ i 1)) :p/name (str "person-" (+ lo i))
                 :p/age (+ 18 (rem (+ lo i) 60))
                 :p/city (str "city-" (rem (+ lo i) 50))})
        (range n)))

(defn bench-end-to-end []
  (header (str "6  END-TO-END — transact " M-ENTITIES " entities, then query"))
  (row "engine" "transact" "count-q" "range-q")
  (doseq [b (backends)]
    (let [nm (get b 0) open-fresh (get b 1)
          transact! (fn []
                      (let [c (datom.conn/connect-with (open-fresh) (schema))]
                        (doseq [chunk (range (erlang/div M-ENTITIES E-BATCH))]
                          (datom.conn/transact! c (entities (* chunk E-BATCH) E-BATCH)))
                        c))
          tx-us (time-us 3 (fn [] (transact!)))
          c (transact!)
          count-us (time-us 5 (fn []
                                (count (eng/q '[:find ?n :where [?e :p/name ?n]]
                                              (datom.conn/db c)))))
          range-us (time-us 5 (fn []
                                (count (eng/q '[:find ?n ?a
                                                :where [?e :p/name ?n]
                                                       [?e :p/age ?a] [(> ?a 60)]]
                                              (datom.conn/db c)))))]
      (row nm (ms tx-us) (ms count-us) (ms range-us)))))

;; ── run all ─────────────────────────────────────────────────────────

(println "=== datom store backend benchmark: fjall (LSM) vs sqlite (B-tree) ===")
(println (str "N-WRITE=" N-WRITE "  BATCH=" BATCH "  M-ENTITIES=" M-ENTITIES))
(bench-writes)
(bench-point-get)
(bench-range)
(bench-full-scan)
(bench-end-to-end)
(println "\n=== done ===")
