; bench/corpus_cache_bench.bl — the derived embedding-column cache win (PLAN-132 Phase 5).
; Run: bin/bl run bench/corpus_cache_bench.bl
;
; The live-corpus measurement (PLAN-132 §10) put the whole-column RE-ASSEMBLY at
; ~3.85 s per evaluation on 62 396 × 768 dims, with warm == cold because nothing
; held the assembled corpus. This bench reproduces the SHAPE on a synthetic
; column of the same order, and shows the cache turns the second evaluation from
; "assemble again" into "reuse", leaving only the NIF search.
;
; It reports cold (first eval, builds + searches) vs warm (cached corpus, only
; searches), and asserts the warm result is bit-identical to the cold one.

(ns bench.corpus-cache
  (:require [datom :as d] [datom.vector :as v] [datom.query.corpus :as corpus]))

(defn- now-ms [] (erlang/monotonic_time :millisecond))

(def DIM 768)
(def N 8000)    ; rows (scaled for a tractable synthetic build; ratio is N-independent)

(defn- rand-embedding []
  ; a deterministic-enough pseudo-random unit vector; the values do not matter,
  ; only that there are N of them at DIM width.
  (v/embedding (mapv (fn [_] (- (erlang/apply :rand :uniform (list)) 0.5)) (range DIM))))

(println "building a" N "-row ×" DIM "-dim embedding column …")
(def conn (d/connect [{:db/ident :vec :db/valueType :db.type/vector}]))
(def build-t0 (now-ms))
; transact in batches so one tx does not hold a giant list
(doseq [off (map (fn [b] (* b 2000)) (range (erlang/div (+ N 1999) 2000)))]
  (d/transact! conn (mapv (fn [i] {:db/id (- (+ i 1)) :vec (rand-embedding)})
                          (range off (min N (+ off 2000))))))
(println "  loaded in" (- (now-ms) build-t0) "ms")

(def db (d/db conn))
(def query (rand-embedding))
(def Q '[:find ?e ?s :in $ ?q :where [(similar-to :vec ?q 10) [?e ?s]]])

(corpus/forget!)

(def cold-t0 (now-ms))
(def cold (d/q Q db query))
(def cold-ms (- (now-ms) cold-t0))

(def warm-t0 (now-ms))
(def warm (d/q Q db query))
(def warm-ms (- (now-ms) warm-t0))

(def warm2-t0 (now-ms))
(def warm2 (d/q Q db query))
(def warm2-ms (- (now-ms) warm2-t0))

(println "")
(println "cold (assemble + search):" cold-ms "ms")
(println "warm (cached + search):  " warm-ms "ms")
(println "warm again:              " warm2-ms "ms")
(println "assembly removed ≈       " (- cold-ms warm-ms) "ms/eval")
(println "speedup:                 " (/ (* 1.0 cold-ms) (max 1 warm-ms)) "×")
(println "bit-identical result:    " (and (= cold warm) (= cold warm2)))
(println "resident corpus:         " (corpus/stats))
