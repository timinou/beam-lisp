(ns vcost2 (:require [mcp.tools :as tools] [z3] [system.decide :as decide]))

(def src
  "(defserver ^{:invariant (>= balance 0)} account
     (init [balance] (ok balance))
     (handle-call [:deposit amt] [_ balance] :when (>= amt 0) (reply :ok (+ balance amt)))
     (handle-call [:withdraw amt] [_ balance] :when (and (>= amt 0) (>= balance amt))
       (reply :ok (- balance amt)))
     (handle-call [:reset] [_ balance] (reply :ok 0)))")

(defn run-once [label f]
  (let [t0 (erlang/monotonic_time :microsecond)
        r (f)
        t1 (erlang/monotonic_time :microsecond)]
    (println label "verdict:" (:verdict r) "z3-calls:" (count (decide/here)) "wall-us:" (- t1 t0))))

(z3/pool! 4)
(run-once "cold" (fn [] (tools/code-verify-handler {"source" src})))
(run-once "warm" (fn [] (tools/code-verify-handler {"source" src})))
(run-once "warm" (fn [] (tools/code-verify-handler {"source" src})))
(println "trail:" (map (fn [d] [(:tier d) (:status d)]) (decide/here)))
