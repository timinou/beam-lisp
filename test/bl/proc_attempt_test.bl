(ns proc-attempt-test
 (:require [proc.attempt :as attempt] [reload.state :as state]
           [reload.generation :as generation]))

(def KEY :proc-attempt-test/current)

(defn- graph [id n]
 (generation/prepare! {:application-id id :sources
  {"attempt.probe" (str "(ns attempt.probe) (defn marker [] " n ")")}}))

(deftest latest-attempt-is-fenced-isolated-and-inherited
 (let [a (graph "attempt-alpha" 1) next-a (graph "attempt-alpha" 2)
       b (graph "attempt-bravo" 3) missing (graph "attempt-missing" 4)
       in (fn [g f] (generation/with! g f))]
  (try
   (doseq [g [a b]] (in g #(state/bind! {KEY (atom nil)})))
   (let [first (in a #(attempt/begin! KEY :first))
         second (in a #(attempt/begin! KEY :second))
         bravo (in b #(attempt/begin! KEY :bravo))]
    (is (not= (:id first) (:id second)))
    (is (= false (in a #(attempt/settle! KEY (:id first) :stale))))
    (is (= false (in a #(attempt/attach! KEY (:id first) (erlang/self)))))
    (is (= :second (:value (in a #(attempt/current KEY)))))
    (is (= :bravo (:value (in b #(attempt/current KEY)))))
    (is (= true (in a #(attempt/attach! KEY (:id second) (erlang/self)))))
    (is (= false (in a #(attempt/attach! KEY (:id second) (erlang/self)))))
    (generation/inherit-runtime! next-a a)
    (is (= (:id second) (:id (in next-a #(attempt/current KEY)))))
    (is (= true (in next-a #(attempt/settle! KEY (:id second) :connected))))
    (is (= false (in a #(attempt/settle! KEY (:id second) :duplicate))))
    (is (= :connected (:value (in a #(attempt/current KEY)))))
    (is (= :bravo (:value (in b #(attempt/current KEY)))))
    (is (nil? (:owner (in a #(attempt/current KEY)))))
    (is (= :missing-runtime-resource
         (try (in missing #(attempt/current KEY)) nil (catch e (:kind (ex-data e))))))
    (is (= :invalid-runtime-state
         (try (in a #(attempt/begin! KEY (fn [] :borrowed))) nil
           (catch e (:kind (ex-data e))))))
    (is (= :connected (:value (in a #(attempt/current KEY))))))
   (finally (doseq [g [a next-a b missing]] (generation/retire! g))))))

(deftest replacing-an-attempt-reports-its-owner-without-killing-it
 (let [first (attempt/begin! KEY :waiting)]
  (is (attempt/attach! KEY (:id first) (erlang/self)))
  (let [next (attempt/begin! KEY :replacement)]
   (is (= (erlang/self) (:previous-owner next)))
   (is (Process/alive? (:previous-owner next)))
   (is (not (attempt/settle! KEY (:id first) :late)))
   (is (attempt/settle! KEY (:id next) :done)))))
