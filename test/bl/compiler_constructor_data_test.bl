(ns compiler-constructor-data-test)
(defn- reason [action] (try (action) nil (catch error (:reason (ex-data error)))))
(defn- proof [callables] {:callables callables :recipe-frame nil :recipes {}})
(defn- cost [value witness] (BeamLisp.CompilerData/constructor_data_cost! value witness))

(deftest public-data-domain-does-not-expand-when-internal-domain-is-present
 (let [callback (fn [x] x) wrapped (tuple :"$blfn" {1 callback} nil)
       witness (proof {callback true wrapped true})]
  (doseq [value [(tuple :chunk [1 2] nil) [callback] [wrapped]]]
   (is (some? (reason #(BeamLisp.CompilerData/check_first_order! value))))
   (is (some? (reason #(BeamLisp.CompilerData/check_first_order! value
                        {:constructor-proof witness :constructor-domain? true})))))
  (is (= {:nodes 1 :bytes 3} (cost "abc" witness)))))

(deftest only-exact-witnessed-callables-can-enter-canonical-internal-containers
 (let [calls (atom 0) callback (fn [_] (swap! calls inc)) other (fn [_] (swap! calls inc))
       wrapped (tuple :"$blfn" {1 callback} nil) witness (proof {callback true wrapped true})]
  (doseq [value [[callback] [wrapped] {:clause [callback wrapped]}
                 (with-meta [callback] {:compiler (tuple :metadata 'name)})
                 (assoc (vec (range 1025)) 500 callback)]]
   (is (pos? (:nodes (cost value witness)))))
  (is (= :opaque-value (reason #(cost [other] witness))))
  (is (= :opaque-value (reason #(cost [(tuple :"$blfn" {1 other} nil)] witness))))
  (is (= 0 @calls))))

(deftest private-capsules-require-exact-frame-and-existing-index-before-storage-traversal
 (let [frame (tuple :constructor-machine-frame (erlang/make_ref))
       capsule (maps/from_list (list (tuple :__struct__ :Elixir.BeamLisp.LazySeq)
                     (tuple :constructor-frame frame) (tuple :constructor-id 1)))
       witness {:callables {} :recipe-frame frame :recipes {1 {:kind :thunk}}}]
  (is (pos? (:nodes (cost [capsule] witness))))
  (is (= :foreign-struct (reason #(cost [(Map/put capsule :constructor-frame (erlang/make_ref))] witness))))
  (is (= :foreign-struct (reason #(cost [(Map/put capsule :constructor-id 2)] witness))))
  (is (= :foreign-struct (reason #(cost [(Map/put capsule :extra :field)] witness))))
  (is (= :foreign-struct (reason #(BeamLisp.CompilerData/check_first_order! [capsule]))))))

(deftest internal-tuples-still-refuse-resources-and-foreign-protocol-objects
 (let [witness (proof {}) calls (atom 0)
       foreign (lazy-seq (swap! calls inc) (list 1))]
  (doseq [value [[(tuple :chunk (erlang/make_ref))]
                 [(tuple :chunk (erlang/self))]
                 [foreign]
                 [(maps/put :__struct__ :Elixir.File.Stream {:path "unused"})]]]
   (is (some? (reason #(cost value witness)))))
  (is (= 0 @calls))))

(deftest same-canonical-storage-checks-protect-internal-vector-and-set-data
 (let [witness (proof {}) value (vec (range 33)) items (erlang/map_get :items value)
       root (elem items 3) leaf (elem root 0)
       bad-root (erlang/setelement 2 (erlang/setelement 1 root nil) leaf)
       bad (maps/put :items (erlang/setelement 4 items bad-root) value)]
  (is (= :vector-placement (reason #(cost bad witness)))))
 (doseq [value [(maps/put :items (fn [] nil) [])
                (maps/put :extra :bad [])
                (maps/put :__struct__ :Elixir.BeamLisp.Set {:members (fn [] nil)})
                (maps/put :__struct__ :Elixir.BeamLisp.Set
                 {:members (maps/put :__struct__ :Elixir.MapSet {:map {(erlang/make_ref) []}})})]]
  (is (some? (reason #(cost value (proof {})))))))

(deftest internal-domain-budgets-and-witness-shape-are-bounded-before-work
 (is (= :invalid-constructor-witness (reason #(cost [] {}))))
 (is (= :invalid-constructor-witness (reason #(cost [] {:callables nil :recipe-frame nil :recipes {}}))))
 (is (= :node-limit (reason #(cost (vec (range 65537)) (proof {})))))
 (is (= :byte-limit (reason #(cost (String/duplicate "x" 1048577) (proof {})))))
 (is (= :depth-limit (reason #(cost (reduce (fn [v _] (list v)) 1 (range 130)) (proof {}))))))

(defn- native-memo-delta [action]
 ;; Build the action and every test input BEFORE this counter interval. Neither
 ;; this helper nor the validator may create a letfn/Atom closure table.
 (let [before (BeamLisp.LazyMemo/stats)
       result (action)
       after (BeamLisp.LazyMemo/stats)]
  (tuple (erlang/- (maps/get :op_new after) (maps/get :op_new before))
         (erlang/- (maps/get :op_new_fast after) (maps/get :op_new_fast before))
         result)))

(deftest raw-public-validation-allocates-no-native-memo-resource
 (let [value (BeamLisp.Vector/new (lists/seq 1 8192))
       validate (fn []
                  (Enum/each (lists/seq 1 32)
                   (fn [_] (BeamLisp.CompilerData/check_first_order! value)))
                  :validated)
       delta (native-memo-delta validate)]
  (is (= 0 (elem delta 0)))
  (is (= 0 (elem delta 1)))
  (is (= :validated (elem delta 2)))))

(deftest constructor-witness-validation-does-not-retain-closure-knots
 (let [payload (BeamLisp.Vector/new (lists/seq 1 8192))
       callback (fn [_] payload)
       witness (proof {callback true})
       value {:clause [callback] :payload payload}
       validate (fn []
                  (Enum/each (lists/seq 1 32) (fn [_] (cost value witness)))
                  :validated)
       delta (native-memo-delta validate)]
  (is (= 0 (elem delta 0)))
  (is (= 0 (elem delta 1)))
  (is (= :validated (elem delta 2)))))

(deftest rejected-storage-and-opaque-leaves-allocate-no-native-memo-resource
 (let [witness (proof {})
       values (list (maps/put :items (fn [] :never) [])
                    (tuple :opaque (erlang/make_ref))
                    (maps/put :__struct__ :Elixir.File.Stream {:path "unused"}))
       validate (fn []
                  (Enum/map values (fn [value] (reason #(cost value witness)))))
       delta (native-memo-delta validate)]
  (is (= 0 (elem delta 0)))
  (is (= 0 (elem delta 1)))
  (is (= (list :vector-storage :opaque-value :foreign-struct) (elem delta 2)))))
