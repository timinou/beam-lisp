; A cached artifact must retain the runtime edges discovered during compilation.
; The consumer source is removed before the cold replay, so fallback is impossible.
(ns aot.implicit-dependencies-test)

(defn- launch [file]
 (System/cmd "timeout"
  (list "-k" "10" "180"
        (Path/expand "bin/bl" (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd))) "run" file)
  (list (tuple :stderr_to_stdout true)
        (tuple :env (list (tuple "BL_DAEMON" "off") (tuple "BEAM_LISP_AOT_REPAIR" "off"))))))

(deftest compiled-runtime-edges-replay-lazily-without-consumer-source
 (let [root (str (System/get_env "HOME") "/tmp/bl-aot-implicit-" (System/unique_integer (list :positive)))
       source (str root "/src") out (str root "/ebin") probe-out (str root "/probe")
       provider (str source "/implicit/provider.bl") consumer (str source "/implicit/consumer.bl")
       macro (str source "/implicit/macros.bl") cycle-a (str source "/implicit/cycle-a.bl")
       cycle-b (str source "/implicit/cycle-b.bl") marker (str root "/initialized")
       child (str root "/replay.bl") environment (BeamLisp.Env/fork)
       probe :Elixir.BeamLisp.AOTImplicitDependencyProbe]
  (try
   (File/mkdir_p! (Path/dirname provider)) (File/mkdir_p! out) (File/mkdir_p! probe-out)
   (File/write! provider (str "(ns implicit.provider) (File/write! " (pr-str marker)
     " \"once\") (def answer 40) (defn add [x] (+ x 2))"))
   (File/write! macro "(ns implicit.macros) (defmacro constant [] 17)")
   (File/write! consumer
    "(ns implicit.consumer) (defn matches? [s] (Regex/match? #\"^[a-z]+$\" s)) (defn answer [] (implicit.provider/add implicit.provider/answer)) (defn expanded [] (implicit.macros/constant))")
   (File/write! cycle-a "(ns implicit.cycle-a) (defn value [] 5) (defn next [] (implicit.cycle-b/value))")
   (File/write! cycle-b "(ns implicit.cycle-b) (defn value [] (implicit.cycle-a/value))")
   ;; Compile the edited host source as an independent pinned emitter. This
   ;; tests the implementation even before the checkout's official seed refresh.
   (BeamLisp.Env/with_env environment
    (fn []
     (BeamLisp.AOT/compile_host_file (str (BeamLisp/cwd) "/priv/host/aot.bl")
       (list (tuple :module probe) (tuple :output_dir probe-out) (tuple :load? true)))
     (BeamLisp.Loader/with_ambient_dirs (list source)
      (fn []
       (doseq [file [provider macro consumer cycle-a cycle-b]]
        (erlang/apply probe :compile_file (list file (list (tuple :output_dir out)))))))))
   (let [chunks (beam_lib/chunks (String/to_charlist (str out "/Elixir.BeamLisp.Ns.Implicit.Consumer.beam"))
                                (list :attributes))
         attrs (Keyword/get (elem (elem chunks 1) 1) :attributes)
         witness (Keyword/get attrs :bl_aot_replay_version)]
    (is (or (= 1 witness) (= (list 1) witness)) "the actual emitter proves its initializer format"))
   (File/rm! consumer) (File/rm! macro) (File/rm! marker)
   ;; Remove the macro artifacts as well. A compile-time-only invocation must
   ;; not become an accidental runtime requirement of the consumer artifact.
   (doseq [path (Path/wildcard (str out "/*Implicit.Macros*.beam"))] (File/rm! path))
   (File/write! child
    (str "(ns implicit.replay) (Code/prepend_path " (pr-str out) ") "
     "(BeamLisp.Loader/with_ambient_dirs (list " (pr-str source) ") (fn [] "
     "(BeamLisp.Loader/ensure_loaded \"implicit.consumer\") "
     "(assert (not (File/exists? " (pr-str marker) "))) "
     "(assert (= 17 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! \"implicit.consumer\" \"expanded\") (list)))) "
     "(assert (= 42 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! \"implicit.consumer\" \"answer\") (list)))) "
     "(assert (= \"once\" (File/read! " (pr-str marker) "))) "
     "(assert (= true (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! \"implicit.consumer\" \"matches?\") (list \"letters\")))) "
     "(assert (= false (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! \"implicit.consumer\" \"matches?\") (list \"123\")))) "
     ;; Dormant cycle dependencies must be declarations, never eager loads.
     "(BeamLisp.Loader/ensure_loaded \"implicit.cycle-a\") "
     "(assert (= 5 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! \"implicit.cycle-a\" \"next\") (list)))) "
     "(println \"IMPLICIT_COLD_REPLAY_OK\")))"))
   (let [[text status] (launch child)]
    (is (= 0 status) text)
    (is (String/contains? text "IMPLICIT_COLD_REPLAY_OK") text))
   (finally (BeamLisp.Env/destroy environment) (File/rm_rf! root)))))

(deftest old-emitter-output-cannot-poison-the-current-source-key
 (let [root (str (System/get_env "HOME") "/tmp/bl-aot-witness-" (System/unique_integer (list :positive)))
       probe :Elixir.BeamLisp.AOTReplayWitnessProbe
       cache :Elixir.BeamLisp.AOTReplayCacheProbe
       mod :Elixir.BeamLisp.Ns.ReplayWitnessFixture
       key (BeamLisp.AOTCache/compiler_key) source "current-source"
       previous (System/get_env "BEAM_LISP_AOT_CACHE_DIR")
       environment (BeamLisp.Env/fork)]
  (try
   (File/mkdir_p! root)
   (System/put_env "BEAM_LISP_AOT_CACHE_DIR" (str root "/cache"))
   (BeamLisp.Env/with_env environment
    (fn []
     (doseq [[file module] [["aot.bl" probe] ["aot_cache.bl" cache]]]
      (BeamLisp.AOT/compile_host_file (str (BeamLisp/cwd) "/priv/host/" file)
       (list (tuple :module module) (tuple :output_dir root) (tuple :load? true))))))
   (let [entry (erlang/apply cache :entry_dir (list key source))
         name (str (Atom/to_string mod) ".beam")
         out (str root "/out")
         clauses (list
           (BeamLisp.Emit/function_clause :__bl_ns_defs__ (BeamLisp.Emit/lit {}))
           (BeamLisp.Emit/function_clause :__bl_provenance__ (BeamLisp.Emit/lit (tuple source key))))
         base (list (tuple :bl_source_hash source) (tuple :bl_compiler_key key))]
    (File/mkdir_p! entry)
    ;; The old emitter has exactly CURRENT compiler/source stamps and valid
    ;; digest/manifest. Only the emitted capability witness distinguishes it.
    (doseq [version [nil 2]]
     (let [attrs (if (nil? version) base (conj base (tuple :bl_aot_replay_version version)))
           compiled (BeamLisp.Emit/compile_descriptor
             (BeamLisp.Emit/descriptor_for mod clauses attrs {:file "old-emitter.bl"}))
           bytes (elem compiled 1) path (str entry "/" name)]
      (File/write! path bytes)
      (File/write! (str entry "/manifest.term")
       (erlang/term_to_binary {:version 2 :modules (list mod)
                              :digests {mod (crypto/hash :sha256 bytes)}}))
      (is (= false (erlang/apply cache :beam_provenance_matches? (list path key source))))
      (is (= :miss (erlang/apply cache :fetch (list key source out))))
      (code/purge mod) (code/delete mod)
      (code/load_binary mod (erlang/binary_to_list path) bytes)
      (is (nil? (erlang/apply probe :beam_provenance (list mod))))))
    (let [attrs (conj base (tuple :bl_aot_replay_version 1))
          compiled (BeamLisp.Emit/compile_descriptor
            (BeamLisp.Emit/descriptor_for mod clauses attrs {:file "current-emitter.bl"}))
          good (str root "/good") path (str good "/" name)]
     (File/mkdir_p! good) (File/write! path (elem compiled 1))
     (erlang/apply cache :store (list key source good (list mod)))
     (is (= :ok (elem (erlang/apply cache :fetch (list key source out)) 0)))
     (is (= (File/read! path) (File/read! (str out "/" name))))
     (code/purge mod) (code/delete mod)
     (code/load_binary mod (erlang/binary_to_list path) (elem compiled 1))
     (is (= (tuple source key) (erlang/apply probe :beam_provenance (list mod))))))
   (finally
    (if (nil? previous) (System/delete_env "BEAM_LISP_AOT_CACHE_DIR")
                       (System/put_env "BEAM_LISP_AOT_CACHE_DIR" previous))
    (code/purge mod) (code/delete mod)
    (BeamLisp.Env/destroy environment) (File/rm_rf! root)))))
