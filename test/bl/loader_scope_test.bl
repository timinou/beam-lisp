(ns loader.scope-test (:require [diagnostics :as diag]))
(defn raw-worker-scope []
 (elem (GenServer/call :Elixir.BeamLisp.Loader.Server
         (tuple :run (fn [] (BeamLisp.Env/capture))) :infinity) 1))
(deftest loader-boundary-conveys-and-restores-registered-scopes
 (BeamLisp.Loader.Server/run (fn [] :ready))
 (let [before (raw-worker-scope) caller (BeamLisp.Env/capture)
       overlay (or (erlang/get :bl-osenv-overlay) {})]
  (try
   (erlang/put :bl-osenv-overlay (assoc overlay "LOADER_SCOPE_FIXTURE" "local"))
   (erlang/put :bl-cli-project {:fixture :local})
   (diag/with-options {:sink (fn [_] nil)}
    (diag/with-context {:diagnostics/operation-id "loader-boundary"}
     (let [expected (BeamLisp.Env/env_id)
           result (BeamLisp.Loader.Server/run (fn []
                    [(BeamLisp.Env/env_id) (System/get_env "LOADER_SCOPE_FIXTURE")
                     (erlang/get :bl-cli-project) (:diagnostics/operation-id (diag/context))]))]
      (is (= expected (nth result 0)))
      (is (= "local" (nth result 1)))
      (is (= {:fixture :local} (nth result 2)))
      (is (= "loader-boundary" (nth result 3))))
     (is (= :caught (try (BeamLisp.Loader.Server/run (fn [] (throw :fixture)))
                        (catch _ :caught))))))
   (is (= before (raw-worker-scope)))
   (finally (BeamLisp.Env/bind caller)))))
