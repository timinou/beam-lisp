; link_test.bl — the pinned `Elixir.BeamLisp.Link` host leaf, pinned against the
; live module it is staged to replace.
;
; `priv/host/link.bl` is the second pinned host source (after
; `priv/host/compiler_data.bl`): compiled by `BeamLisp.AOT/compile-host-file`
; into ONE exact-named beam whose top-level `defn`s are the call surface the
; boot compiler already names at `Elixir.BeamLisp.Link`. This suite is the
; PRE-SEED gate for that file, and it judges the two things the seed mapping
; depends on:
;
;   1. THE EXPORTED ABI IS EXACTLY the recalled one — `module_for/1`,
;      `defvar/3`, `defvar/4`, `shim_clauses/1`, `body_modules/1` — no more, no
;      fewer. A pinned beam is a replacement, so an extra export is a
;      difference a caller could trip over and a missing one is a crash.
;
;   2. THE EFFECTS OF `defvar` MATCH the live `BeamLisp.Link` ANSWER FOR ANSWER:
;      the body module, the regenerated namespace shim, the ns_defs registry,
;      the `{:link, ns, name}` row, the interned value and the byte filename the
;      beam is published under. A fresh compile of the source at a PROBE atom is
;      run against a throwaway namespace, snapshotted, and the legacy module is
;      run against the SAME namespace from a clean state and snapshotted the
;      same way; the two snapshots must be equal. Nothing under `compiler`,
;      `reader` or any production namespace is touched — the isolated name is
;      the only registry row either run writes, and `cleanup-ns!` removes it.
;
; Once the orchestrator seeds the pinned pair, `Elixir.BeamLisp.Link` IS this
; source's beam, so comparison (2) becomes a reproducibility check of the
; source against itself — still the assertion that the emitted answer is stable
; — while (1) and the concrete expected values below stand on their own. The
; end-to-end question (does the BOOT COMPILER still self-build when `Link` is
; the seeded beam?) is the seed mapping's gate, not this suite's.
;
; Run: bin/bl test test/bl/link_test.bl

(ns link-test)

(def ^:private PROBE :Elixir.BeamLisp.LinkProbe)

; ── the pinned source, compiled once at a probe atom ────────────────────────

(defn- t [k v] (erlang/list_to_tuple (list k v)))

(defn- link-source [] (Path/join (BeamLisp/cwd) "priv/host/link.bl"))

(defn- ensure-probe!
  "The pinned `Link`, compiled from `priv/host/link.bl` at `PROBE` with
   `load? false`, then loaded here. Compiled once per VM: a second call returns
   the loaded atom without re-emitting."
  []
  (if (not= false (erlang/apply :code :is_loaded (list PROBE)))
    PROBE
    (let [out (str (System/tmp_dir) "/bl_link_probe_"
                   (erlang/unique_integer (list :positive)))
          result (BeamLisp.AOT/compile_host_file (link-source)
                   (list (t :module PROBE) (t :output_dir out) (t :load? false)))
          path (erlang/element 2 result)]
      (code/purge PROBE)
      (code/delete PROBE)
      (code/load_binary PROBE (erlang/binary_to_list path) (File/read! path))
      PROBE)))

; ── building the canonical def entries a `defn` compiles to ─────────────────

(defn- pvar [n] {:pop :pvar :name n})
(defn- v [n] {:op :var :name n :ann {}})
(defn- l [x] {:op :lit :val x :ann {}})

(defn- fixed-clause [fname params body]
  (tuple :fixed (count params) fname
         {:op :defn-clause :fname fname
          :params (Enum/map params pvar) :guard nil :body body :ann {}}))

(defn- variadic-clause [min fname params body]
  (tuple :variadic min fname
         {:op :defn-clause :fname fname
          :params (Enum/map params pvar) :guard nil :body body :ann {}}))

(defn- call [mod fun args]
  {:op :remote :mod mod :fun fun :args args :ann {}})

; ── one isolated namespace, one observation shape ───────────────────────────

(def ^:private NS "link-port-probe")
(def ^:private NAMES (list "probe-one" "probe-id" "probe-tally"))
(def ^:private LOCATION (list (t :file "probe/link_port.bl") (t :line 3)))

(defn- entries
  "What three `defn`s compile to: a SINGLE fixed arity (`probe-one`, the common
   case — the fn value is a plain capture), a TWO-clause fixed arity
   (`probe-id`, a `$blfn` fixed map), and a variadic one (`probe-tally`, min 1:
   two parameters with the second the rest list)."
  []
  (list
    (list "probe-one"
          (list (fixed-clause :probe-one (list "x") (call :erlang :+ (list (v "x") (l 1))))))
    (list "probe-id"
          (list (fixed-clause :probe-id (list "x") (v "x"))
                (fixed-clause :probe-id (list "a" "b") (call :erlang :+ (list (v "a") (v "b"))))))
    (list "probe-tally"
          (list (variadic-clause 1 :probe-tally (list "a" "rest")
                                 (call :erlang :+ (list (v "a") (call :erlang :hd (list (v "rest"))))))))))

(defn- snapshot
  "Everything `defvar` publishes for the isolated namespace, normalized so two
   runs (whose body modules are freshly named by construction) compare equal:
   the namespace module's exports, the ns_defs entries with the body module
   replaced by `:body`, both link rows, the live byte filename, the definition
   values' shapes and the answers through both the shim and the interned value."
  [link]
  (let [mod (erlang/apply link :module_for (list NS))
        values (Enum/map (entries)
                         (fn [pair]
                           (erlang/apply link :defvar
                             (list NS (first pair) (second pair) LOCATION))))
        row (fn [n] (BeamLisp.Env/lookup (tuple :link NS n)))
        intern (fn [n] (erlang/element 2 (BeamLisp.Env/fetch NS n)))
        exports (erlang/apply mod :module_info (list :exports))
        entry (fn [n]
                (Enum/map (get (BeamLisp.Env/ns_defs NS) n)
                          (fn [e] (list (erlang/element 1 e) (erlang/element 2 e)
                                        (erlang/element 3 e) :body))))
        value-tag (fn [x] (if (erlang/is_tuple x) (erlang/element 1 x) :capture))]
    {:exports (sort (Enum/map
                      (filter (fn [x] (not= :module_info (erlang/element 1 x))) exports)
                      (fn [x] (tuple (erlang/element 1 x) (erlang/element 2 x)))))
     :ns-defs (reduce (fn [acc n] (assoc acc n (entry n))) {} NAMES)
     :link (reduce (fn [acc n]
                     (let [r (erlang/element 2 (row n))]
                       (assoc acc n [(erlang/element 2 r) (erlang/element 3 r)])))
                   {} NAMES)
     :filename (code/which mod)
     :value-tags (Enum/map values value-tag)
     :shim-calls [(erlang/apply mod :probe-one (list 7))
                  (erlang/apply mod :probe-id (list 7))
                  (erlang/apply mod :probe-id (list 3 4))
                  ; a variadic shim entry passes its arity-(min+1) arguments
                  ; STRAIGHT through, so the rest parameter arrives as the list
                  ; the dispatch collected — 5 + hd([6]).
                  (erlang/apply mod :probe-tally (list 5 (list 6)))]
     :interned-calls [(BeamLisp.Ns.Rt/invoke (intern "probe-one") (list 9))
                      (BeamLisp.Ns.Rt/invoke (intern "probe-id") (list 9))
                      (BeamLisp.Ns.Rt/invoke (intern "probe-id") (list 9 10))
                      (BeamLisp.Ns.Rt/invoke (intern "probe-tally") (list 5 6))]}))

(defn- cleanup-ns!
  "Remove the isolated namespace from the image: its registry rows, its body
   modules and its shim. Leaves no trace for the next run — which is what lets
   the legacy module and the probe run against the SAME name and be compared."
  []
  (let [mod (BeamLisp.Emit/module_for NS)]
    (doseq [n NAMES]
      (doseq [e (or (get (BeamLisp.Env/ns_defs NS) n) (list))]
        (let [body (erlang/element 5 e)]
          (code/purge body)
          (code/delete body))))
    (doseq [n NAMES] (BeamLisp.Env/undefine_var NS n))
    (code/purge mod)
    (code/delete mod)))

; ── the ABI ─────────────────────────────────────────────────────────────────

(deftest the-pinned-link-exports-exactly-the-recalled-abi
  (let [mod (ensure-probe!)
        exports (sort (Enum/map (erlang/apply mod :module_info (list :exports))
                                (fn [x] (tuple (erlang/element 1 x) (erlang/element 2 x)))))]
    (is (= (list (tuple :body_modules 1) (tuple :defvar 3) (tuple :defvar 4)
                 (tuple :module_for 1) (tuple :module_info 0) (tuple :module_info 1)
                 (tuple :shim_clauses 1))
           exports)
        "exactly the recalled surface — the pinned emitter exports every top-level
         defn, so an extra helper is an ABI difference and a missing export a crash")
    (is (= :Elixir.BeamLisp.LinkProbe mod))))

(deftest every-abi-function-is-callable-at-its-arity
  (let [mod (ensure-probe!)]
    (is (= (BeamLisp.Emit/module_for "probe.link.ns")
           (erlang/apply mod :module_for (list "probe.link.ns"))))
    (is (= (BeamLisp.Emit/shim_clauses {}) (erlang/apply mod :shim_clauses (list {}))))
    (is (= (BeamLisp.Emit/body_modules {}) (erlang/apply mod :body_modules (list {}))))))

(deftest module-for-matches-the-live-module-over-representative-namespaces
  (let [mod (ensure-probe!)
        corpus (list "core" "datom.store-fjall" "a.b.c" "reader-node" "vm.generation"
                     "link_port_probe" "with-dash.and_under.score")]
    (doseq [ns corpus]
      (is (= (BeamLisp.Emit/module_for ns)
             (erlang/apply mod :module_for (list ns))
             (erlang/apply :Elixir.BeamLisp.Link :module_for (list ns)))
          (str "module_for " ns)))))

(deftest non-binary-arguments-raise-the-recalled-function-clause-error
  (let [probe (ensure-probe!)
        outcome (fn [link]
                  (try (erlang/apply link :defvar (list :not-a-ns "x" (list) nil))
                       :returned
                       (catch FunctionClauseError _e :function-clause)
                       (catch _e :other-class)))]
    (is (= :function-clause (outcome probe))
        "a non-binary ns is refused by the clause guard, not coerced")
    (is (= (outcome :Elixir.BeamLisp.Link) (outcome probe))
        "with the same error class the recalled module raised")))

(deftest rebuilding-the-pinned-source-is-byte-identical
  (let [dir (str (System/tmp_dir) "/bl_link_repro_"
                 (erlang/unique_integer (list :positive)))
        build (fn []
                (erlang/element 2
                  (BeamLisp.AOT/compile_host_file (link-source)
                    (list (t :module :Elixir.BeamLisp.LinkRepro)
                          (t :output_dir dir) (t :load? false)))))]
    (is (= (File/read! (build)) (File/read! (build)))
        "the pinned emitter is deterministic, so a committed seed beam can be
         re-derived from this source and judged by its digest")))

; ── the effects of `defvar` against the live module ─────────────────────────

(deftest defvar-effects-match-the-live-module-under-an-isolated-namespace
  (cleanup-ns!)
  (let [legacy (try (snapshot :Elixir.BeamLisp.Link)
                    (finally (cleanup-ns!)))
        probe (try (snapshot (ensure-probe!))
                   (finally (cleanup-ns!)))]
    (is (= legacy probe)
        "a fresh compile of priv/host/link.bl publishes exactly what the live
         BeamLisp.Link publishes: same exports, registry rows, link rows,
         filename, value shapes and answers")
    (testing "and the concrete answers are the expected ones, not merely equal"
      (is (= (list (tuple :"probe-id" 1) (tuple :"probe-id" 2) (tuple :"probe-one" 1)
                   (tuple :"probe-tally" 2))
             (:exports probe)))
      (is (= (list 8 7 7 11) (:shim-calls probe)))
      (is (= (list 10 9 19 11) (:interned-calls probe)))
      (is (= (list :capture :"$blfn" :"$blfn") (:value-tags probe))
          "a single fixed arity interns a plain capture; multi-arity and variadic\n           ones are $blfn values")
      (is (= (list "probe/link_port.bl") (Enum/map (list (:filename probe)) (fn [f] (String.Chars/to_string f))))
          "the location's :file is the filename the beams are published under"))))

(deftest the-publication-filename-rules-match-the-live-module
  (cleanup-ns!)
  (try
    (let [mod (BeamLisp.Emit/module_for NS)
          e (first (entries))
          which (fn [link location]
                  (erlang/apply link :defvar (list NS (first e) (second e) location))
                  (String.Chars/to_string (code/which mod)))
          corpus (list nil
                       (list (t :file "probe/one.bl"))
                       (list (t :line 4))
                       (list (t :file false) (t :line 1))
                       "probe/two.bl")]
      (doseq [loc corpus]
        (let [live (try (which :Elixir.BeamLisp.Link loc) (finally (cleanup-ns!)))
              probe (try (which (ensure-probe!) loc) (finally (cleanup-ns!)))]
          (is (= live probe) (str "publication filename for " (pr-str loc)))))
      (is (= "beam_lisp_live"
             (try (which (ensure-probe!) nil) (finally (cleanup-ns!))))
          "defvar/3 is defvar/4 with a nil location, and a nil location is the
           live default — the rule the recalled module kept"))
    (finally (cleanup-ns!))))

(deftest a-descriptor-that-will-not-compile-publishes-nothing
  (let [ns "link-port-probe-atomic"
        mod (BeamLisp.Emit/module_for ns)
        bad (list (tuple :fixed 1 :probe-bad {:op :not-a-clause :ann {}}))]
    (BeamLisp.Env/undefine_var ns "probe-bad")
    (code/purge mod)
    (code/delete mod)
    (is (thrown? (erlang/apply (ensure-probe!) :defvar (list ns "probe-bad" bad nil)))
        "a clause the canonical emitter refuses raises before anything loads")
    (is (= {} (BeamLisp.Env/ns_defs ns))
        "the ns_defs registry is untouched — compile happens before publish")
    (is (= :non_existing (erlang/apply :code :which (list mod)))
        "and no shim beam was loaded")))

; ── the isolated namespace is left exactly as it was found ──────────────────

(deftest the-probe-namespace-leaves-no-trace
  (cleanup-ns!)
  (is (= {} (BeamLisp.Env/ns_defs NS)))
  (is (= :non_existing (erlang/apply :code :which (list (BeamLisp.Emit/module_for NS)))))
  (is (= :error (BeamLisp.Env/lookup (tuple :link NS "probe-id")))
      "no link row survives the run"))
