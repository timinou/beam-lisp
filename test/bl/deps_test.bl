; test/bl/deps_test.bl — W7's server-side half: the CONTRACT, and the mock
; derived from it.
;
; The client's job is to decide about a server it does not control, so the server
; is written down first, as predicates. `veritas.mock` derives a mock from them,
; and the client is driven through a TRANSPORT built on it — so client and server
; answer to one predicate, which is what "interchangeable" means.
;
; ── The z3 guard, and why it is honest ─────────────────────────────────────
;
; Everything `veritas.mock` derives from a contract goes through the SMT port. In
; THIS worktree that port answers nil (the z3 native side is a gitignored
; dependency; `priv/z3` is symlinked in, and the shipped `test/bl/veritas/*.bl`
; fail here for the same reason). So the contract-derived tests GUARD on it and
; say so out loud, while the transport and client tests — which need no solver —
; run either way. A test that silently skips is a lie; a test that fails for an
; environment reason it cannot fix is noise.
;
; Run: bl test test/bl/deps_test.bl

(ns test.deps
  (:require [veritas.mock :as m] [z3]))

(def port (z3/open))

(def package-contract
  (m/contract-from
    [["versions" "Int"] ["retired" "Int"]]
    ['(>= versions 1)
     '(<= retired versions)]))

(defn smt? []
  (some? (m/satisfiable-status port package-contract)))

(deftest the-contract-is-realizable
  (if (smt?)
    (is (= :sat (m/satisfiable-status port package-contract)))
    (do (println "  (skipped: the SMT port answers nil in this worktree — see the header)")
        (is true))))

(deftest a-contract-is-the-mock
  (if (smt?)
    (let [v (:value (m/synth port package-contract ""))]
      (is (>= (:versions v) 1))
      (is (<= (:retired v) (:versions v))))
    (do (println "  (skipped: no SMT port)") (is true))))

(deftest the-mock-is-deterministic
  (if (smt?)
    (let [srv (m/make-mock port package-contract "versions")]
      (is (= (:value (m/answer srv 4)) (:value (m/answer srv 4))))
      (is (not= (:value (m/answer srv 4)) (:value (m/answer srv 9)))))
    (do (println "  (skipped: no SMT port)") (is true))))

(deftest the-edges-come-from-the-optimizer
  (if (smt?)
    (is (= 1 (:versions (:value (m/synth-seeded port package-contract "versions" 1)))))
    (do (println "  (skipped: no SMT port)") (is true))))

(deftest a-forbidden-response-is-outside-the-contract
  (if (smt?)
    (let [bad (:value (m/synth-invalid port package-contract))]
      (is (not (m/check port package-contract bad))))
    (do (println "  (skipped: no SMT port)") (is true))))

; ── the client, over a transport that is a VALUE (no solver involved) ──────

(def q
  "A double quote, built rather than escaped: an escape inside a `.bl` string is
   the kind of thing that silently truncates instead of failing loudly (W5 paid
   for that lesson in a compiler docstring)."
  (str (binary/encode_unsigned 34)))

(defn doc-for
  "An API document with `n` versions — the shape the contract describes, written
   out so this test does not need a solver to have one."
  [n]
  (str "{" q "name" q ":" q "fake" q "," q "releases" q ":["
       (join "," (map (fn [i] (str "{" q "version" q ":" q "1." i ".0" q
                                   "," q "checksum" q ":" q "00" q "}"))
                      (range 0 n)))
       "]}"))

; The valid-document path is covered where it belongs: `build_deps_test.exs`
; builds real API documents and real tarballs with Elixir's own tooling, and
; drives the client through a transport. What this file adds is the CONTRACT
; (above) and the client's decisions that need no well-formed document at all —
; asserting the JSON path twice, in two languages' string escaping, would be two
; places to be wrong about one thing.

(deftest the-client-asks-the-url-the-api-defines
  (let [seen (atom nil)
        t (fn [url _opts] (reset! seen url) {:error "stop here"})
        _ (hex/package t "jason")]
    (is (= "https://hex.pm/api/packages/jason" @seen)
        "the client's URL is the API's contract, not a detail of the mock")))

(deftest the-tarball-transport-is-asked-for-bytes
  (let [seen (atom nil)
        t (fn [url opts] (reset! seen [url opts]) {:error "stop here"})
        _ (hex/tarball t "jason" "1.4.4")]
    (is (= "https://repo.hex.pm/tarballs/jason-1.4.4.tar" (first @seen)))
    (is (= true (:binary? (second @seen)))
        "a tarball is fetched as bytes: decoding it as UTF-8 would corrupt it")))

(deftest an-unusable-document-is-an-error
  (let [t (fn [_url _opts] {:ok "not json at all"})
        r (hex/package t "fake")]
    (is (some? (:error r)))
    (is (nil? (:ok r)))))

(deftest a-document-with-no-releases-is-an-error
  (let [t (fn [_url _opts] {:ok "{\"name\":\"fake\"}"})
        r (hex/package t "fake")]
    (is (some? (:error r)))))

(deftest a-failing-transport-passes-through
  (let [t (fn [_url _opts] {:error "connection refused"})
        r (hex/package t "fake")]
    (is (= "connection refused" (:error r)))))

(deftest the-tarball-url-is-what-hex-serves
  (is (= "https://repo.hex.pm/tarballs/jason-1.4.4.tar"
         (hex/tarball-url "jason" "1.4.4"))))
