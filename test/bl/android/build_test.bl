(ns android.build-test (:require [bl.cli :as cli]))

(deftest android-packaging-flags-reach-the-build-command
  (let [st (cli/parse-argv ["android" "build" "--standalone" "--release"])]
    (is (= "android" (:cmd st)))
    (is (= ["build" "--standalone" "--release"] (vec (:args st))))
    (is (nil? (:unknown st)))))

(deftest android-packaging-flags-can-follow-the-argument-boundary
  (let [st (cli/parse-argv ["android" "build" "--" "--standalone" "--release"])]
    (is (= ["build"] (vec (:args st))))
    (is (= ["--standalone" "--release"] (vec (:dd st))))))

(deftest android-packaging-flags-stay-local-to-android
  (is (= "--standalone" (:unknown (cli/parse-argv ["test" "--standalone"])))))
