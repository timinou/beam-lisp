(ns android.ui-test
  (:require [android.ui :as ui]))

(deftest colours-become-the-argb-ints-compose-reads
  (is (= -16777216 (ui/argb "#000000")) "opaque black is 0xFF000000, signed")
  (is (= -1 (ui/argb "#ffffff")))
  (is (= 2131763248 (ui/argb "#7f102030")) "an explicit alpha under 0x80 stays positive")
  (is (= (ui/argb "#1F2A24") (ui/argb :forest)) "palette names resolve")
  (is (= (ui/argb "#102030") (ui/argb [16 32 48])))
  (is (= :bad (try (ui/argb "#12") (catch e :bad)))))

(deftest props-arrive-in-mobs-names
  (let [p (ui/props {:color :ink :size :xl :on-tap [:pid :call] :corner-radius 8})]
    (is (= (ui/argb :ink) (:text_color p)) ":color is mob's :text_color, and becomes an int")
    (is (= :xl (:text_size p)))
    (is (= (tuple :pid :call) (:on_tap p)) "a [pid tag] handler is mob's {pid, tag}")
    (is (= 8 (:corner_radius p)))))

(deftest a-tree-is-plain-data-with-list-children
  (let [t (ui/column {:gap 8}
            (ui/text "hi")
            nil
            (map (fn [n] (ui/text n)) ["a" "b"]))]
    (is (= :column (:type t)))
    (is (list? (:children t)) "mob maps children with Enum: a list, never a bl vector")
    (is (= ["hi" "a" "b"] (vec (map (fn [c] (:text (:props c))) (:children t))))
        "nil drops out and a seq of children splices in")))

(deftest a-card-is-a-column-with-house-defaults-you-can-override
  (let [c (ui/card {:padding 20} (ui/text "x"))]
    (is (= :column (:type c)))
    (is (= 20 (:padding (:props c))))
    (is (= (ui/argb :sheet) (:background (:props c))))))
