(ns android.events-test
  (:require [android.events :as ev] [android.jvm :as jvm]))

(deftest topics-route-by-name-and-namespace
  (ev/start!)
  (ev/subscribe! [:notify])
  (ev/emit! :notify/posted {"title" "Rita" "text" "are you coming?"})
  (ev/emit! :overlay/tap {"id" "nudge"})
  (is (= [:android :notify/posted {"title" "Rita" "text" "are you coming?"}]
         (receive m m (after 1000 :timeout))))
  (is (= :none (receive m m (after 100 :none))) "overlay events do not reach a :notify subscriber")
  (ev/unsubscribe!))

(deftest await-event-filters-by-payload
  (ev/start!)
  (let [p (spawn (fn [] (Process/sleep 50)
                        (ev/emit! :notify/posted {"package" "other"})
                        (ev/emit! :notify/posted {"package" "com.whatsapp" "title" "Sam"})))]
    (is (= "Sam" (get (ev/await-event :notify/posted (fn [n] (= "com.whatsapp" (get n "package"))) 2000) "title")))))

(deftest recent-keeps-the-tail
  (ev/start!)
  (ev/emit! :reader/event {"kind" "window"})
  (Process/sleep 20)
  (is (= :reader/event (:topic (last (ev/recent 3))))))

(deftest a-raw-jvm-message-is-decoded-once
  (ev/start!)
  (ev/subscribe! [:proxy])
  (erlang/send :android_events (tuple :android "proxy" "{\"id\":\"cb\",\"method\":\"onClick\",\"args\":[]}"))
  (is (= "onClick" (get (nth (receive m m (after 1000 nil)) 2) "method")))
  (ev/unsubscribe!))

(deftest off-the-phone-the-bridge-says-so
  (is (= false (jvm/available?)))
  (is (= :not-on-android
         (try (jvm/ping) (catch e (:android/error (ex-data e)))))))
