; loom_test.bl — a loom screen's logic, on the desk (no phone, no WebView).
;
; Run: bl test test/bl/android/loom_test.bl
;
; `react` is the whole screen: a message in, the new state and the actions out.
; The page's end of the seam (the shim) runs in node when it is on PATH.

(ns android.loom-test
  (:require [android.loom :as al]
            [loom.ui :as ui]
            [interop]))

(defn- view [n] (ui/button {:on-click [:inc]} (str "taps: " n)))
(defn- on-event [n ev]
  (cond (= ev [:inc]) (+ n 1)
        (and (vector? ev) (= :add (first ev))) (+ n (nth ev 1))
        :else n))
(def spec {:view view :on-event on-event :init (fn [p] (or (:start p) 0)) :title "t"})

(defn- page [json] (tuple :webview :message json))
(defn- kinds [actions] (vec (map first actions)))

(deftest mount-renders-the-first-frame-into-a-data-url
  (let [lm (al/init spec {:start 4})
        url (:url lm)
        html (base64/decode (nth (split url ",") 1))]
    (is (= 4 (:state lm)) ":init gets the mount params")
    (is (starts-with? url "data:text/html;charset=utf-8;base64,"))
    (is (includes? html "taps: 4"))
    (is (< (index-of html "window.bl=") (index-of html "window.__loom =")) "the shim defines bl.send before the hook uses it")
    (is (= 0 (:state (al/init {:view view :state 0} {}))) "or a plain :state")))

(deftest a-tap-folds-and-sends-the-new-frame-down
  (let [[lm actions] (al/react spec (al/init spec {}) (page "[\"inc\"]"))]
    (is (= 1 (:state lm)))
    (is (= [:eval] (kinds actions)))
    (is (includes? (nth (first actions) 1) "taps: 1"))))

(deftest a-tap-that-changes-nothing-sends-nothing
  (let [[lm actions] (al/react spec (al/init spec {}) (page "[\"nothing\"]"))]
    (is (= 0 (:state lm)))
    (is (= [] actions))))

(deftest any-other-message-is-an-event-too
  (let [[lm actions] (al/react spec (al/init spec {}) [:add 5])]
    (is (= 5 (:state lm)) "an events delivery or an emit! folds like a tap")
    (is (= [:eval] (kinds actions)))))

(deftest a-recreated-page-gets-the-current-frame
  (let [lm (assoc (al/init spec {}) :state 7)
        [lm' actions] (al/react spec lm (page "[\"__loom-ready\"]"))]
    (is (= lm lm') "ready is not an event")
    (is (includes? (nth (first actions) 1) "taps: 7"))))

(deftest a-probe-goes-down-and-its-answer-back-to-the-asker
  (let [lm (al/init spec {})
        [lm1 a1] (al/react spec lm (tuple :loom_probe :asker 42 "document.title"))
        [lm2 a2] (al/react spec lm1 (page "[\"__loom-reply\",42,{\"ok\":\"t\"}]"))]
    (is (= [:eval] (kinds a1)))
    (is (includes? (nth (first a1) 1) "document.title"))
    (is (= [[:reply :asker 42 {"ok" "t"}]] a2))
    (is (= {} (:pending lm2)) "answered probes are forgotten")
    (is (= 0 (:state lm2)) "a reply is not an event")))

(deftest a-page-trying-to-leave-opens-the-browser
  (let [[_ actions] (al/react spec (al/init spec {}) (tuple :webview :blocked "https://example.org/"))]
    (is (= [[:open "https://example.org/"]] actions))))

(deftest the-render-is-one-webview-on-the-page-url
  (let [t (al/render {:loom (al/init spec {})})]
    (is (= :web_view (:type t)))
    (is (starts-with? (:url (:props t)) "data:"))
    (is (= "data:" (:allow (:props t))) "only the page itself; anything else is blocked, then opened outside")))

(deftest the-shim-posts-ascii-that-decodes-to-the-original
  (when (System/find_executable "node")
    (let [js (str "var window=globalThis; var got; var MobNative={postMessage:function(s){got=s;}};" al/shim
                  "bl.send(JSON.stringify(['name','Sofia 😀 «é»']));"
                  "process.stdout.write(got)")
          out (erlang/element 1 (System/cmd "node" (list "-e" js) (list (tuple :stderr_to_stdout true))))]
      (is (= :nomatch (re/run out "[^\\x00-\\x7f]")) "only ASCII crosses JNI")
      (is (= [:name "Sofia 😀 «é»"] (android.loom-test/parse out)) "and it reads back as the original text"))))

(defn parse [s] (loom.surface/parse-event s))
