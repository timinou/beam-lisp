(ns pinned-build-plan-test (:require [build-plan :as plan] [source-graph :as graph]
                                    [ns-interface :as iface]))

(deftest pure-pinned-planner-preserves-reference-interface-and-closure-keys
 ;; When run as a native component overlay, these ordinary Source bindings are
 ;; the prior implementation; on the final floor they are the compatibility
 ;; facades. Fixed semantic controls below remain independent of delegation.
 (doseq [[root sources]
          [["root" {"root" "(ns root (:require [dep])) (defn call [] (dep/f))"
                    "dep" "(ns dep) (defn f [] 1)"}]
           ["root" {"root" "(ns root (:require [dep :as d])) (defn call [] (d/f))"
                    "dep" "(ns dep) (defn f [] 2)"}]
           ["root" {"root" "(ns root (:require [dep])) (defn call [] (dep/m))"
                    "dep" "(ns dep) (defmacro m [] '(do 1))"}]
           ["a" {"a" "(ns a (:require [b])) (def value 1)"
                 "b" "(ns b (:require [a missing])) (def value 2)"}]
           ["second" {"second" "(ns first) (def a 1) (ns second (:require [dep])) (def b 2)"
                      "dep" "(ns dep) (defn f [] 1)"}]
           ["absent" {}]]]
  (let [resolve (fn [name] (get sources name))]
   (is (= (plan/key-for root resolve nil plan/node-from)
          (BeamLisp.BuildPlan/key_for root resolve nil))))))

(deftest content-interface-and-plan-parts-have-one-shared-semantic-owner
 (let [source "(ns first (:require [dep :as d :refer [f]])) (defn call [x] (d/f x)) (ns second) (defrecord Item [id])"
       forms (graph/forms source)
       nodes (list (plan/node-from "first" source)
                   (plan/node-from "dep" "(ns dep) (defn f [x] x)"))]
  (is (= (graph/header*-forms forms) (BeamLisp.SourceGraph/header*-forms forms)))
  (is (= (graph/references-forms forms) (BeamLisp.SourceGraph/references-forms forms)))
  (is (= (iface/lines-forms forms) (BeamLisp.NamespaceInterface/lines-forms forms)))
  (is (= (iface/names-forms forms) (BeamLisp.NamespaceInterface/names-forms forms)))
  (is (= (iface/hash-forms forms) (BeamLisp.NamespaceInterface/hash-forms forms)))
  (is (= (plan/plan nodes) (BeamLisp.BuildPlan/plan nodes)))))

(deftest interface-coverage-and-macro-invalidation-remain-exact
 (let [root "(ns root (:require [dep :as d])) (defn call [] (d/f))"
       key (fn [dependency]
             (BeamLisp.BuildPlan/key_for "root"
              (fn [name] (get {"root" root "dep" dependency} name)) nil))]
  (is (= (key "(ns dep) (defn f [] 1)") (key "(ns dep) (defn f [] 2)")))
  (is (not= (key "(ns dep) (defn f [] 1)") (key "(ns dep) (defn f [x] x)")))
  (is (not= (key "(ns dep) (defmacro f [] 1)") (key "(ns dep) (defmacro f [] 2)")))
  (is (not= (key "(ns dep) (defn f [] 1)") (key nil)))))

(deftest pinned-planning-never-evaluates-source-forms
 (let [marker (str (System/get_env "HOME") "/tmp/pure-planner-never-run-"
                   (System/unique_integer (list :positive)))
       source (str "(ns pure.planner) (File/write! " (pr-str marker) " \"bad\") (defn f [] 1)")]
  (try
   (is (string? (BeamLisp.BuildPlan/key_for "pure.planner"
                 (fn [name] (when (= "pure.planner" name) source)) nil)))
   (is (= false (File/exists? marker)))
   (finally (File/rm marker)))))

(deftest pure-planner-needs-no-provider-init-or-inherited-callables
 (let [before (BeamLisp.Env/capture)
       loaded (mapv #(BeamLisp.Env/loaded_ns? %) ["build-plan" "source-graph" "ns-interface"])
       scope (BeamLisp.Env/fork :global)
       source "(ns isolated) (defn f [] 1)"
       expected (BeamLisp.BuildPlan/key_for "isolated" (fn [_] source) nil)]
  (try
   (is (= expected
          (BeamLisp.Env/with_env scope
           (fn []
            (BeamLisp.Env/intern "build-plan" "key-for" nil)
            (BeamLisp.Env/intern "build-plan" "memo-node" nil)
            (BeamLisp.Env/intern "core" "list" nil)
            (BeamLisp.Env/intern "core" "count" nil)
            (BeamLisp.Loader/without_initialization
             (BeamLisp.Env/as_thunk
              #(BeamLisp.BuildPlan/key_for "isolated" (fn [_] source) nil)))))))
   (is (= before (BeamLisp.Env/capture)))
   (is (= loaded (mapv #(BeamLisp.Env/loaded_ns? %) ["build-plan" "source-graph" "ns-interface"])))
   (finally (BeamLisp.Env/destroy scope)))))

(deftest aot-closure-validation-does-not-call-mutable-planner-provider-vars
 (let [id (str "pureaot" (System/unique_integer (list :positive)))
       dir (str (System/get_env "HOME") "/tmp/" id)
       marker (str dir "/provider-effect")
       source (str "(ns " id ") (File/write! " (pr-str marker) " \"bad\") (defn f [] 1)")
       previous (BeamLisp.Env/capture) scope (BeamLisp.Env/fork :global)
       shadow (fn [& _] (File/write! marker "called") nil)
       expected (BeamLisp.BuildPlan/key_for id (fn [_] source) nil)]
  (File/mkdir_p! dir)
  (File/write! (str dir "/" id ".bl") source)
  (try
   (is (= expected
          (BeamLisp.Env/with_env scope
           (fn []
            (BeamLisp.Env/intern "build-plan" "key-for" shadow)
            (BeamLisp.Env/intern "build-plan" "memo-node" shadow)
            (BeamLisp.Loader/with_ambient_dirs (list dir)
             (fn []
              (BeamLisp.Loader/without_initialization
               (BeamLisp.Env/as_thunk #(BeamLisp.AOT/ns_closure_hash id)))))))))
   (is (= false (File/exists? marker)))
   (is (= false (BeamLisp.Env/loaded_ns? id)))
   (is (= previous (BeamLisp.Env/capture)))
   (finally (BeamLisp.Env/destroy scope) (File/rm_rf! dir)))))


(deftest root-key-selection-preserves-full-plan-semantics
 (doseq [sources
          [{"a" "(ns a (:require [b :as b])) (defn call [] (b/f))"
            "b" "(ns b) (defn f [] 1)"}
           {"a" "(ns a (:require [b :refer :all])) (defn call [] (f))"
            "b" "(ns b) (defn f [] 2)"}
           {"a" "(ns a (:require [b])) (defn call [] (b/m))"
            "b" "(ns b (:require [missing])) (defmacro m [] 1)"}
           {"a" "(ns a (:require [b])) (def value 1)"
            "b" "(ns b (:require [a missing])) (def value 2)"}]]
  (let [nodes (BeamLisp.BuildPlan/nodes_for "a" #(get sources %) nil BeamLisp.BuildPlan/node-from)
        full (BeamLisp.BuildPlan/plan nodes)
        selected (BeamLisp.BuildPlan/plan nodes (list "a"))]
   (is (= {"a" (get (:key full) "a")} (:key selected)))
   (is (= (dissoc full :key) (dissoc selected :key))))))

(deftest a-single-root-query-folds-one-key-instead-of-every-dependency-key
 (let [nodes (into {} (mapv (fn [i]
                 (let [n (str "n" i)]
                   [n {:path n :ns n :hash (str "hash" i)
                       :reqs (if (= i 0) [] [(str "n" (dec i))])}])) (range 40)))
       trace (tuple :Elixir.BeamLisp.SourceGraph :hash-lines 1)]
  (try
   (erlang/trace_pattern trace true (list :local :call_count))
   (let [key (BeamLisp.BuildPlan/key_for "n39" #(get nodes %) nil (fn [_ node] node))
         folds (elem (erlang/trace_info trace :call_count) 1)]
    (is (string? key))
    (is (= 1 folds) "only the requested root's hash is folded")
    (is (= key (get (:key (BeamLisp.BuildPlan/plan (vals nodes))) "n39"))))
   (finally (erlang/trace_pattern trace false (list :local :call_count))))))

(deftest missing-and-differently-declared-root-headers-keep-total-key-semantics
 (doseq [source ["" "(def value 1)" "(ns another.name) (def value 2)"]]
  (let [nodes (BeamLisp.BuildPlan/nodes_for "requested" (fn [_] source) nil BeamLisp.BuildPlan/node-from)]
   (is (= (get (:key (BeamLisp.BuildPlan/plan nodes)) "requested")
          (BeamLisp.BuildPlan/key_for "requested" (fn [_] source) nil))))))
