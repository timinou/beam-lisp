; test/bl/wave19_str_test.bl — `str` on a collection, ported from
; test/beam_lisp/wave19_str_test.exs.
;
; Found while prototyping lenses in beam-lisp: `(str "x " {:a 1})` raised
; `Protocol.UndefinedError: String.Chars not implemented for Map`, because
; `to_str/1`'s fallback was `Kernel.to_string/1` and no BEAM collection
; implements String.Chars.
;
; Clojure's `str` is defined in terms of the printed representation, so a
; collection stringifies to its literal syntax. beam-lisp already had that
; printer — `print_str/1`, behind `pr-str` — so the fix was to delegate rather
; than to write a second stringifier.
;
; The distinction `str` must still preserve: a *bare string* prints raw ("a",
; not "\"a\""), while a string nested inside a collection keeps its quotes,
; because that is what makes the output re-readable.
;
; ── coverage map (ExUnit test → BL deftest) ────────────────────────────────
;   collections stringify to their literal syntax → collections-stringify-to-their-literal-syntax
;   nested collections survive interpolation …    → nested-collections-survive-interpolation-into-a-larger-string
;   a bare string still prints raw, unquoted      → a-bare-string-still-prints-raw-unquoted
;   scalars keep their existing behaviour         → scalars-keep-their-existing-behaviour
;   a lazy seq stringifies without forcing …      → a-lazy-seq-stringifies-without-forcing-the-whole-world
;   a set stringifies to set syntax               → a-set-stringifies-to-set-syntax
;
; Run: bin/bl test test/bl/wave19_str_test.bl

(ns wave19-str.test)

; The port of the ExUnit `eval/1`: `BeamLisp.init/0`, then compile and run
; `source` at a fresh `wave19str` env. `eval_string` moves the current ns to the
; env's, so `with_ns` restores the caller's afterwards — the file's own
; namespace must still own the deferred `run-tests`.
(defn- ev [source]
  (BeamLisp/init)
  (BeamLisp.Env/with_ns
    (BeamLisp.Env/current_ns)
    (fn [] (BeamLisp.Compiler/eval_string source (BeamLisp.Compiler/new_env "wave19str")))))

(deftest collections-stringify-to-their-literal-syntax
  (is (= "{:a 1}" (ev "(str {:a 1})")))
  (is (= "[1 2 3]" (ev "(str [1 2 3])")))
  (is (= "(1 2 3)" (ev "(str (list 1 2 3))"))))

(deftest nested-collections-survive-interpolation-into-a-larger-string
  (is (= "user: {:name \"ada\"}" (ev "(str \"user: \" {:name \"ada\"})"))))

(deftest a-bare-string-still-prints-raw-unquoted
  ; (str "a" "b") is concatenation, not a printed pair of quoted strings.
  (is (= "ab" (ev "(str \"a\" \"b\")"))))

(deftest scalars-keep-their-existing-behaviour
  (is (= "a1kwb" (ev "(str \"a\" 1 :kw nil \"b\")")))
  (is (= "foo" (ev "(str 'foo)")))
  (is (= "" (ev "(str)"))))

(deftest a-lazy-seq-stringifies-without-forcing-the-whole-world
  (is (= "(2 3)" (ev "(str (map inc [1 2]))"))))

(deftest a-set-stringifies-to-set-syntax
  ; Built by concatenation, so THIS test's source carries no set literal.
  (is (= (str "#" "{1}") (ev "(str (set [1]))"))))
