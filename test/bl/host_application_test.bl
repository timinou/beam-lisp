; host_application_test.bl — the pinned `BeamLisp.Application` OTP callback.
;
; `priv/host/application.bl` ports `lib/beam_lisp/application.ex` to ONE
; exact-named beam, `Elixir.BeamLisp.Application` — the callback `env.bl`'s
; `:mod` entry names, so `Application.ensure_all_started(:beam_lisp)` calls
; `start(:normal, [])` on it. That is why the port has to be RIGHT before it is
; ever wired into the seed. This suite pins it three ways:
;
;   * SURFACE — the pinned probe's exports, its `-behaviour` attribute and its
;     callback coverage, diffed against `Elixir.BeamLisp.Application` AND
;     against `Application`'s own `behaviour_info/1`. The migrated callback
;     and its probe both lack the Elixir-generated `__info__/1`; the
;     OPTIONAL callbacks the production module does not define (`config_change/3`,
;     `prep_stop/1`, `start_phase/3`) must stay undefined, because the export
;     surface IS the contract a port has to reproduce.
;
;   * CUTOVER — the same source compiled at the PRODUCTION atom and loaded over
;     the live module (the live beam saved and put back in `finally`), so the
;     pinned beam demonstrably takes the atom. Nothing here starts a
;     supervisor, and the atom is restored before the test returns.
;
;   * BOOT — a fresh CHILD VM whose code path resolves `BeamLisp.Application`
;     to the pinned beam starts the application on it: same supervisor name,
;     Env/Loader before `BeamLisp.init/0`, then the owner collector, a second
;     `ensure_all_started` starts nothing, and `stop/1` answers `:ok`. The
;     child is not tidiness: this VM already runs the tree, and starting a
;     second one — or stopping the live one — to ask the callback a question
;     is exactly the damage `start/2` is careful not to do.
;
; `start/2` is never called against a STOPPED tree here. Its only honest
; in-process question is the error path, and the refusal test asks it: with the
; tree up, a second start must return OTP's `already_started` and start
; nothing.
;
; A pinned beam has no `__info__/1` (only Elixir's compiler generates it).
; `compile_host_file` records the behaviour module as a bare atom rather than
; the one-element list generated by `@behaviour`. OTP uses the callback exports,
; not either representation of this metadata.
;
; Run: bin/bl test test/bl/host_application_test.bl

(ns host.application.test)

(defn- t2 [k v] (erlang/list_to_tuple (list k v)))

(defn- tmp-dir []
  (str (System/tmp_dir!) "/bl_host_application_" (erlang/unique_integer (list :positive))))

(defn- app-source [] (Path/join (BeamLisp/cwd) "priv/host/application.bl"))

(def ^:private probe :Elixir.BeamLisp.HostApplicationProbe)
(def ^:private shim :Elixir.BeamLisp.Ns.Host.Application)
(def ^:private live :Elixir.BeamLisp.Application)
(def ^:private supervisor :Elixir.BeamLisp.Supervisor)
(def ^:private behaviour-mod :Elixir.Application)

(defn- drop! [mod]
  (do (code/purge mod) (code/delete mod) :ok))

(defn- load-beam! [mod path]
  (drop! mod)
  (code/load_binary mod (erlang/binary_to_list path) (File/read! path))
  mod)

; Compile the pinned source at `mod` and publish ONLY the pinned beam: the
; compile's own load (and the namespace shim it built beside it) is dropped.
(defn- compile-pinned [mod dir]
  (let [res (BeamLisp.AOT/compile_host_file (app-source)
              (list (t2 :module mod) (t2 :output_dir dir) (t2 :load? false)
                    (t2 :behaviour behaviour-mod)))]
    (load-beam! mod (elem res 1))
    (drop! shim)
    mod))

(defn- exports [mod]
  (Enum/sort (erlang/apply mod :module_info (list :exports))))

; What a pinned beam's surface is measured against: `__info__/1` is generated
; by the Elixir compiler for every Elixir module and is NOT part of the ABI a
; pinned (functions-only) port carries.
(defn- functional-exports [mod]
  (Enum/sort (filter (fn [e] (not (erlang/== :__info__ (elem e 0)))) (exports mod))))

(defn- behaviour-attr
  "The `-behaviour` attribute's value for `mod`, normalized to a LIST: Elixir
   collects them (`[Application]`), a pinned host records the bare atom
   (`Application`). `nil` when the module carries no such attribute."
  [mod]
  (let [v (first (map (fn [a] (elem a 1))
                      (filter (fn [a] (erlang/== :behaviour (elem a 0)))
                              (erlang/apply mod :module_info (list :attributes)))))]
    (cond
      (nil? v) nil
      (erlang/is_list v) v
      :else (list v))))

(defn- behaviour-info [key]
  (erlang/apply behaviour-mod :behaviour_info (list key)))

(defn- optional-callbacks [] (Enum/sort (behaviour-info :optional_callbacks)))

(defn- required-callbacks
  "The behaviour's `:callbacks` minus its `:optional_callbacks` — `start/2` and
   `stop/1`, asked of OTP rather than written down twice."
  []
  (let [opt (optional-callbacks)]
    (filter (fn [c] (not (some (fn [o] (erlang/== o c)) opt))) (behaviour-info :callbacks))))

(defn- exported? [mod c] (erlang/function_exported mod (elem c 0) (elem c 1)))

; ── the surface: what the callback module exports, and what it must not ───

(deftest application-pinned-surface-is-the-live-callback-module
  (testing "exports, behaviour attribute and callback coverage, against the live module and the behaviour"
    (let [dir (tmp-dir)]
      (compile-pinned probe dir)
      ; NO SHIM: the compile's namespace shim is gone; the pinned beam answers.
      (is (= :non_existing (erlang/apply :code :which (list shim))))

      ; The production callback module this port stands in for is loaded — the
      ; precondition the diff below is meaningful under.
      (is (erlang/function_exported live :start 2) "the production callback module is loaded")
      (is (erlang/function_exported live :stop 1))

      ; Every production callback remains present at the probe atom. A pinned
      ; production beam has no compiler-generated Elixir introspection export.
      (is (= () (filter (fn [e] (not (exported? probe e))) (functional-exports live)))
          "all production callbacks are reproduced")
      (is (= (functional-exports live) (exports probe))
          "the pinned export surface equals the live module's minus __info__/1")

      ; The OTP callbacks themselves, by name and arity.
      (is (erlang/function_exported probe :start 2))
      (is (erlang/function_exported probe :stop 1))

      ; A pinned module is functions-only: no synthesized struct pair either.
      (is (not (erlang/function_exported probe :__struct__ 0)))
      (is (not (erlang/function_exported probe :__struct__ 1)))

      ; THE BEHAVIOUR ATTRIBUTE. `use Application` records `-behaviour
      ; Application`; `compile_host_file`'s `:behaviour` option records the
      ; same module, so the emitted beam is judgeable as an application
      ; callback module exactly as the live one is.
      (is (= (list behaviour-mod) (behaviour-attr probe)))
      (is (= (behaviour-attr live) (behaviour-attr probe)))

      ; THE CALLBACK CONTRACT, asked of the behaviour rather than guessed:
      ; `start/2` and `stop/1` are the REQUIRED callbacks, and both the live
      ; module and the pinned beam export both.
      (is (= (list (tuple :start 2) (tuple :stop 1)) (Enum/sort (required-callbacks))))
      (is (every? (fn [c] (exported? probe c)) (required-callbacks)))
      (is (every? (fn [c] (exported? live c)) (required-callbacks)))

      ; ...and the OPTIONAL callbacks stay undefined on BOTH. `config_change/3`
      ; is the one a "helpful" port would be tempted to add; the live module
      ; does not ship it, so neither does this one.
      (is (= (list (tuple :config_change 3) (tuple :prep_stop 1) (tuple :start_phase 3))
             (optional-callbacks)))
      (is (not (erlang/function_exported live :config_change 3))
          "precondition: the live module defines no config_change/3")
      (is (every? (fn [c] (not (exported? probe c))) (optional-callbacks))
          "no optional Application callback is invented by the port")
      (is (every? (fn [c] (not (exported? live c))) (optional-callbacks)))

      ; REPRODUCIBLE: the same source compiled again is the same bytes. The
      ; seed records a sha256 per host beam and `seed/check` re-derives it, so
      ; a non-deterministic emitter would make the committed floor
      ; unverifiable — and the floor is not published until every beam's stamp
      ; proves it came from the source beside it.
      (let [again (tmp-dir)
            again-beam (elem (BeamLisp.AOT/compile_host_file (app-source)
                                 (list (t2 :module probe) (t2 :output_dir again)
                                       (t2 :load? false) (t2 :behaviour behaviour-mod)))
                           1)]
        (is (= (File/read! (Path/join dir "Elixir.BeamLisp.HostApplicationProbe.beam"))
               (File/read! again-beam))
            "a rebuild of priv/host/application.bl is the same beam")
        (File/rm_rf! again))

      (File/rm_rf! dir))))

; ── stop/1: the callback `use Application` generates ──────────────────────

(deftest application-pinned-stop-is-the-generated-no-op
  (testing "stop/1 ignores its argument and answers :ok, as the generated callback does"
    (let [dir (tmp-dir)]
      (compile-pinned probe dir)
      ; The state OTP hands `stop/1` is the supervisor pid (or `:undefined` when
      ; the application never started). The generated callback ignores it.
      (is (= :ok (erlang/apply probe :stop (list :normal))))
      (is (= :ok (erlang/apply probe :stop (list :undefined))))
      (is (= :ok (erlang/apply probe :stop (list nil))))
      (is (= :ok (erlang/apply probe :stop (list 42))))
      (is (= :ok (erlang/apply probe :stop (list (erlang/self)))))
      ; differential: the live callback answers identically for the same states.
      (doseq [state (list :normal :undefined nil 42)]
        (is (= (erlang/apply live :stop (list state))
               (erlang/apply probe :stop (list state)))
            (str "stop/1 vs the live module, state " state)))
      (File/rm_rf! dir))))

; ── start/2 against a RUNNING tree: the refusal, and no second tree ───────
;
; A second `start/2` with `BeamLisp.Supervisor` already registered is the one
; call this suite can make in-process without starting anything: OTP refuses
; the name before any child is started, so the answer is the error and the tree
; is untouched. That is the shape the callback must pass through — not swallow,
; not replace with an `:ok`.

(deftest application-pinned-start-refuses-a-second-supervisor
  (testing "with the tree already running, start/2 returns OTP's already_started and starts nothing"
    (let [dir (tmp-dir)
          before (Process/whereis supervisor)]
      (compile-pinned probe dir)
      (is (erlang/is_pid before) "precondition: this VM already runs the tree")
      (when (erlang/is_pid before)
        (let [r (erlang/apply probe :start (list :normal (list)))]
          (is (erlang/is_tuple r))
          (is (erlang/== :error (elem r 0)))
          (is (erlang/== :already_started (elem (elem r 1) 0)))
          (is (= before (elem (elem r 1) 1)) "the error names the RUNNING supervisor")
          (is (= before (Process/whereis supervisor)) "no second tree was started")
          (is (= 3 (erlang/map_get :specs (erlang/apply :Elixir.Supervisor :count_children (list supervisor))))
              "the tree still has Env, Loader and the supervised owner collector")
          ; Neither init nor collector startup runs on refusal. The existing
          ; language and supervisor remain usable.
          (is (= 3 (BeamLisp/eval "(+ 1 2)")))))
      (File/rm_rf! dir))))

; ── the pinned beam AT the production atom, restored afterwards ───────────
;
; The differential above proves the ABI at a probe atom. This one proves the
; CUTOVER shape: the same source compiled to `Elixir.BeamLisp.Application` and
; loaded OVER the live module really answers there, and the live beam is put
; back in `finally`. No supervisor is started or stopped — the callback's boot
; behaviour belongs to the child VM below.

(deftest application-pinned-beam-stands-in-at-the-production-atom
  (testing "the pinned source takes the production atom, and the live beam is restored"
    (let [dir (tmp-dir)
          out (str dir "/prod")
          beam (Path/join out "Elixir.BeamLisp.Application.beam")
          orig-path (erlang/apply :code :which (list live))]
      (is (not= :non_existing orig-path) "precondition: the live beam is a readable file")
      (is (erlang/function_exported live :start 2) "precondition: the production callback is loaded")

      ; `:load? false` writes the beam at the production atom WITHOUT
      ; substituting the live module mid-flight.
      (let [res (BeamLisp.AOT/compile_host_file (app-source)
                  (list (t2 :module live) (t2 :output_dir out) (t2 :load? false)
                        (t2 :behaviour behaviour-mod)))]
        (is (= live (elem res 0)))
        (is (File/exists? (elem res 1)))
        (is (File/exists? beam))
        (is (= orig-path (erlang/apply :code :which (list live)))
            "the compile never substituted the production module"))

      (try
        (load-beam! live beam)
        (is (= (erlang/binary_to_list beam) (erlang/apply :code :which (list live)))
            "the test beam now owns the production atom")
        (is (erlang/function_exported live :start 2))
        (is (erlang/function_exported live :stop 1))
        (is (= (list behaviour-mod) (behaviour-attr live)))
        (is (= :ok (erlang/apply live :stop (list (Process/whereis supervisor))))
            "the pinned stop/1 answers at the production atom")
        (finally
          (load-beam! live (erlang/list_to_binary orig-path))))

      ; RESTORED: the original production beam owns the same atom again.
      (is (= orig-path (erlang/apply :code :which (list live))))
      (is (erlang/function_exported live :start 2))
      (is (= :ok (erlang/apply live :stop (list :normal))))
      (File/rm_rf! dir))))

; ── the boot: a fresh VM starting the application on the pinned callback ──

(defn- child-code-args
  "This VM's whole code path as `-pa` args, with `pinned` LAST so it lands
   FIRST: `-pa` PREPENDS, so the last one named wins (`bin/bl` relies on the
   same rule for the same reason)."
  [pinned]
  (concat (mapcat (fn [p] (list "-pa" (erlang/list_to_binary p))) (code/get_path))
          (list "-pa" pinned)))

(defn- boot-script
  "The child VM's program, as Elixir source. Every line it prints is read back
   as an assertion: the beam the code server resolved, the supervisor and its
   children, the seeded language, idempotence, stop."
  []
  (str
    "app = :beam_lisp\n"
    "IO.puts(\"which-before=\" <> List.to_string(:code.which(BeamLisp.Application)))\n"
    "{:ok, started} = Application.ensure_all_started(app)\n"
    "IO.puts(\"app-started=\" <> inspect(app in started))\n"
    "IO.puts(\"which-after=\" <> List.to_string(:code.which(BeamLisp.Application)))\n"
    "IO.puts(\"exports=\" <> inspect(Enum.sort(BeamLisp.Application.module_info(:exports))))\n"
    "sup = Process.whereis(BeamLisp.Supervisor)\n"
    "IO.puts(\"supervisor=\" <> inspect(is_pid(sup)))\n"
    "IO.puts(\"children=\" <> inspect(Supervisor.which_children(BeamLisp.Supervisor) |> Enum.map(&elem(&1, 0)) |> Enum.sort()))\n"
    "IO.puts(\"specs=\" <> inspect(Map.get(Supervisor.count_children(BeamLisp.Supervisor), :specs)))\n"
    "IO.puts(\"seeded=\" <> inspect(BeamLisp.Env.seeded?()))\n"
    "IO.puts(\"eval=\" <> inspect(BeamLisp.eval(\"(+ 1 2)\")))\n"
    "{:ok, []} = Application.ensure_all_started(app)\n"
    "IO.puts(\"idempotent=\" <> inspect(Process.whereis(BeamLisp.Supervisor) == sup))\n"
    "IO.puts(\"stop=\" <> inspect(BeamLisp.Application.stop(:normal)))\n"
    "IO.puts(\"stopped=\" <> inspect(Application.stop(app)))\n"
    "IO.puts(\"sup-after=\" <> inspect(Process.whereis(BeamLisp.Supervisor)))\n"
    "IO.puts(\"ok\")\n"))

(deftest application-pinned-callback-boots-the-application-in-an-isolated-vm
  (testing "a fresh child VM resolves the pinned beam and starts the app on it"
    (let [dir (tmp-dir)
          out (str dir "/boot")
          script (Path/join dir "boot.exs")
          beam (Path/join out "Elixir.BeamLisp.Application.beam")]
      ; The pinned beam AT the production atom, written here, never loaded here.
      (BeamLisp.AOT/compile_host_file (app-source)
        (list (t2 :module live) (t2 :output_dir out) (t2 :load? false)
              (t2 :behaviour behaviour-mod)))
      (is (File/exists? beam))
      (File/write! script (boot-script))

      (let [r (System/cmd "elixir"
                          (to-list (concat (child-code-args out) (list script)))
                          (to-list [(tuple :stderr_to_stdout true)]))
            text (elem r 0)]
        (is (zero? (elem r 1)) (str "the child VM exited " (elem r 1) ":\n" text))

        ; THE REPLACEMENT: the code server resolves the callback module to the
        ; pinned beam, both before and after the start.
        (is (includes? text (str "which-before=" beam)) text)
        (is (includes? text (str "which-after=" beam)) text)

        ; THE PINNED BEAM REALLY RAN: the code path above selects the isolated
        ; test beam, whose functions-only exports match the production callback.
        (is (includes? text "exports=[module_info: 0, module_info: 1, start: 2, stop: 1]") text)
        (is (not (includes? text "__info__: 1"))
            "the isolated callback has no Elixir-generated introspection export")

        ; THE START: the app came up on this callback.
        (is (includes? text "app-started=true") text)
        (is (includes? text "supervisor=true") text)
        (is (includes? text "children=[BeamLisp.Env, BeamLisp.Loader.Server, :beam_lisp_owner_registry]") text)
        (is (includes? text "specs=3") text)

        ; THE SEQUENCING: the supervisor's Env/Loader children are up and the
        ; language is interned before the source-defined collector is started.
        ; Successful boot proves the order: `init/0` starts
        ; `BeamLisp.Env` on demand when it is missing (`ensure_env/0`), so an
        ; `init/0` that ran BEFORE `Supervisor.start_link` would leave an
        ; unsupervised Env behind and the supervisor would refuse to start it —
        ; `{:error, {:already_started, pid}}`, no app at all.
        (is (includes? text "seeded=true") text)
        (is (includes? text "eval=3") text)

        ; IDEMPOTENCE AND STOP: a second `ensure_all_started` starts no second
        ; tree, the generated `stop/1` answers `:ok`, and the app stops.
        (is (includes? text "idempotent=true") text)
        (is (includes? text "stop=:ok") text)
        (is (includes? text "stopped=:ok") text)
        (is (includes? text "sup-after=nil") text)
        (is (includes? text "ok") text))

      (File/rm_rf! dir))))
