(ns data-first-order-test (:require [data.first-order :as data]))
(defn- reason [f] (try (f) nil (catch e (:reason (ex-data e)))))

(deftest ordinary-values-and-real-dense-and-trie-vectors-pass
 (doseq [v [nil false true :existing 42 "text" 'symbol
            (list 1 {:a [2 3]}) [] [1 2] #{} #{1 2} (set (range 40))
            (vec (range 33)) (vec (range 1025))]]
  (is (= v (data/check! v))))
 (is (= [1] (data/check! (with-meta [1] {:source "trusted-data"})))))

(deftest foreign-runtime-values-refuse-without-forcing
 (let [calls (atom 0)]
  (doseq [v [(fn [] (swap! calls inc)) (erlang/self) (erlang/make_ref)
             (lazy-seq (swap! calls inc) (list 1))
             (maps/put :__struct__ :Elixir.File.Stream {:path "synthetic-unused"})
             (maps/put :__struct__ (lazy-seq (swap! calls inc) nil) {})
             (erlang/++ (list :head) :improper-tail)
             (tuple :$transient :map :synthetic-key) (tuple :$remote :Elixir.File :read!)
             (with-meta [1] {:hidden (fn [] (swap! calls inc))})]]
   (is (some? (reason #(data/check! v)))))
  (is (= 0 @calls))))

(deftest malformed-vector-storage-refuses-before-protocol-dispatch
 (doseq [fields [{:items (fn [] nil) :meta nil}
                 {:items (tuple 1) :meta nil :extra :hidden}
                 {:items (tuple :bl_vec 33 5 (tuple) (tuple 1)) :meta nil}
                 {:items (tuple :bl_vec 999999999 5 (tuple) (tuple 1)) :meta nil}]]
  (is (some? (reason #(data/check! (maps/put :__struct__ :Elixir.BeamLisp.Vector fields)))))))

(deftest sparse-vector-placement-and-forged-set-storage-refuse
 (let [v (vec (range 33)) items (erlang/map_get :items v)
       root (elem items 3) leaf (elem root 0)
       bad-root (erlang/setelement 2 (erlang/setelement 1 root nil) leaf)
       bad (maps/put :items (erlang/setelement 4 items bad-root) v)]
  (is (= :vector-placement (reason #(data/check! bad)))))
 (doseq [v [(maps/put :__struct__ :Elixir.BeamLisp.Set {:members (fn [] nil)})
             (maps/put :__struct__ :Elixir.BeamLisp.Set
              {:members (maps/put :__struct__ :Elixir.MapSet {:map {(fn [] nil) []}})})]]
  (is (some? (reason #(data/check! v))))))

(deftest traversal-budgets-bound-raw-values
 (is (= :node-limit (reason #(data/check! (vec (range 100)) {:max-nodes 10}))))
 (is (= :byte-limit (reason #(data/check! "synthetic text" {:max-bytes 3}))))
 (is (= :depth-limit (reason #(data/check! [[[1]]] {:max-depth 2}))))
 (is (= :invalid-limits (reason #(data/check! 1 {:max-nodes 0})))))

(deftest native-kernel-boundary-preserves-sdk-refusals-and-reports-aggregate-cost
 (doseq [v [nil false true :existing 42 "text" 'symbol
             (list 1 {:a [2 3]}) [] [1 2] #{} #{1 2}
             (vec (range 33)) (vec (range 1025))]]
  (is (= (data/check! v) (BeamLisp.CompilerData/check_first_order! v))))
 (doseq [[v options] [[(vec (range 100)) {:max-nodes 10}]
                     ["synthetic text" {:max-bytes 3}]
                     [[[[1]]] {:max-depth 2}]
                     [(erlang/self) {}] [(fn [] nil) {}]]]
  (is (= (reason #(data/check! v options))
         (reason #(BeamLisp.CompilerData/check_first_order! v options)))))
 (is (= {:nodes 1 :bytes 3} (BeamLisp.CompilerData/first_order_cost! "abc")))
 (is (= {:nodes 3 :bytes 6} (BeamLisp.CompilerData/first_order_cost! (list 1 2))))
 (is (= {:nodes 2 :bytes 1} (BeamLisp.CompilerData/first_order_cost! 'x)))
 (is (= :byte-limit (reason #(BeamLisp.CompilerData/first_order_cost! "abc" {:max-bytes 2})))))
