; test/bl/files_test.bl — the mirror schema and :~file/under (PLAN-151 P2).

(ns files.test
  (:require [datom] [datom.watch :as watch] [files]))

(files/register-under!)

(defn- mirror []
  (let [c (datom/connect files/schema)]
    ;; root/{sub/{a}, c}, outside/{b}
    (datom/transact! c [{:db/id -1 :conn/key [:t "n" "root"] :file/folder? true}
                        {:db/id -2 :conn/key [:t "n" "sub"] :file/folder? true :file/parent -1}
                        {:db/id -3 :conn/key [:t "n" "a"] :file/parent -2 :file/rev "1"}
                        {:db/id -4 :conn/key [:t "n" "c"] :file/parent -1 :file/rev "1"}
                        {:db/id -5 :conn/key [:t "n" "out"] :file/folder? true}
                        {:db/id -6 :conn/key [:t "n" "b"] :file/parent -5 :file/rev "1"}])
    c))

(defn- e [c id] (first (first (into [] (datom/q '[:find ?e :in $ ?k :where [?e :conn/key ?k]]
                                                 (datom/db c) [:t "n" id])))))
(defn- ids [c es] (into #{} (map (fn [x] (nth (first (into [] (datom/q '[:find ?k :in $ ?e :where [?e :conn/key ?k]] (datom/db c) x))) 0)) es)))

(deftest fb-root-bound-is-every-descendant
  (let [c (mirror)
        rows (datom/q '[:find ?f :in $ ?r :where [?f :~file/under ?r]] (datom/db c) (e c "root"))]
    (is (= #{[:t "n" "sub"] [:t "n" "a"] [:t "n" "c"]} (ids c (map first rows))))))

(deftest bb-probe-hits-and-misses
  (let [c (mirror)
        hit (datom/q '[:find ?f :in $ ?f ?r :where [?f :~file/under ?r]] (datom/db c) (e c "a") (e c "root"))
        miss (datom/q '[:find ?f :in $ ?f ?r :where [?f :~file/under ?r]] (datom/db c) (e c "b") (e c "root"))]
    (is (= 1 (count hit)))
    (is (= 0 (count miss)))))

(deftest bf-file-bound-is-every-ancestor
  (let [c (mirror)
        rows (datom/q '[:find ?r :in $ ?f :where [?f :~file/under ?r]] (datom/db c) (e c "a"))]
    (is (= #{[:t "n" "sub"] [:t "n" "root"]} (ids c (map first rows))))))

(deftest the-portable-rules-agree-with-the-relation
  (let [c (mirror)
        r (e c "root")
        via-rel (into #{} (datom/q '[:find ?f :in $ ?r :where [?f :~file/under ?r]] (datom/db c) r))
        via-rules (into #{} (datom/q '[:find ?f :in $ % ?r :where (under ?f ?r)] (datom/db c) files/under-rules r))]
    (is (= via-rel via-rules))))

(deftest a-watch-fires-on-a-parent-only-move
  ;; BUG-100: the relation's :reads is what makes this fire
  (let [c (mirror)
        r (e c "root")
        seen (atom [])
        w (watch/watch c '[:find ?f :in $ ?r :where [?f :~file/under ?r]] [r]
                       (fn [ev] (swap! seen conj ev)))]
    (datom/transact! c [[:db/add (e c "b") :file/parent r]])
    (Process/sleep 200)
    (is (seq @seen) "moving b under root changed the answer, and the watch saw it")
    (watch/unwatch w)))

(deftest cost-of-fb-over-a-deep-wide-tree
  ;; 5 000 nodes, depth 10: each level holds 500 folders/files under the previous
  (let [c (datom/connect files/schema)
        _ (datom/transact! c [{:db/id -1 :conn/key [:t "n" "L0"] :file/folder? true}])
        _ (doseq [lvl (range 1 11)]
            (datom/transact! c
              (into [] (map (fn [i] {:db/id (- 0 (+ 2 i)) :conn/key [:t "n" (str "L" lvl "-" i)]
                                     :file/parent (e c (if (= lvl 1) "L0" (str "L" (- lvl 1) "-" (rem i 50))))})
                            (range 0 500)))))
        r (e c "L0")
        timed (fn [f] (let [t0 (erlang/monotonic_time :millisecond) n (count (f))]
                        [n (- (erlang/monotonic_time :millisecond) t0)]))
        [n ms] (timed (fn [] (datom/q '[:find ?f :in $ ?r :where [?f :~file/under ?r]] (datom/db c) r)))
        [_ fix] (timed (fn [] (datom/q '[:find ?f :in $ % ?r :where (under ?f ?r)] (datom/db c) files/under-rules r)))]
    (println (str "  :~file/under :fb over 5 000 nodes, depth 10: " n " rows in " ms
                  " ms (rule fixpoint: " fix " ms)"))
    (is (= 5000 n))
    ;; relative, so a loaded machine does not flake it: the frontier walk must
    ;; beat the recursive-rule fixpoint it replaced (measured ~3x)
    (is (< ms fix) "the relation's frontier walk is faster than the rule fixpoint")))
