; host_test_rt_test.bl — the pinned `BeamLisp.TestRT` ABI and run engine.
;
; `priv/host/test_rt.bl` replaces `lib/beam_lisp/test_rt.ex` at its exact module
; atom `Elixir.BeamLisp.TestRT`: the registry behind `deftest`/`is`/`testing`/
; `are`, the per-namespace run engine, the failure/error renderer and the
; serial/async fork suite `bl test` drives. Nothing here substitutes the live
; module in THIS vm: the source is compiled at its own probe atom, the namespace
; shim beside it is dropped, and the probe beam is loaded ALONE — so a leftover
; shim reference would be `undef` here.
;
; THE OBSERVATION RUNS IN A CHILD VM, and that is not decoration. `run_suite/2`
; compiles `priv/std/test.bl` into a fresh image and then drives it; the library
; expands `deftest`/`is`/`are` into calls on the PRODUCTION atom
; `Elixir.BeamLisp.TestRT`, so a probe-atom port cannot be exercised end to end
; without standing in for the production module. ONE child runs the SAME
; scenario TWICE — once against its own live module, then again after the beam
; compiled from `priv/host/test_rt.bl` has replaced it at the production atom —
; and prints both observations as `MARK live.…` / `MARK pinned.…`. Both passes
; therefore run against the same image and the same vars table, which is why the
; two sets are directly comparable.
;
; THE DIFFERENTIAL IS THOSE TWO PASSES: the same marks — totals, decoded run
; output and the pure-function results — with ONE deliberate exception,
; `which`, which names the beam that answered and therefore HAS to differ. Each
; run's output is captured through a StringIO group leader, so FAIL/ERROR blocks
; are compared as TEXT, not merely counted.
;
; FOUR THINGS THE TEST PINS BEYOND THE DIFFERENTIAL:
;   * the export surface is the live module's minus `__info__/1` — no `defn-`
;     helper leaks, because every private helper is a local closure;
;   * the embedded `test_lib_source/0` is `priv/std/test.bl` byte for byte (the
;     drift gate `@external_resource` used to provide) and the live module's;
;   * the whole remote-module set of the beam, read from its disassembly;
;   * the CLI's exit status on a red suite, live and pinned.
;
; THE EMBEDDED LIBRARY is a GENERATED SNAPSHOT, not a second source of truth:
; `priv/std/test.bl` escaped (`\` then `"`) and spliced between the
; `@@EMBED-TEST-LIB@@` markers of `priv/host/test_rt.bl`. The surface test
; re-derives it from both sides, so an edit to the library that is not
; re-spliced fails here rather than going stale silently.
;
; Run: bin/bl test test/bl/host_test_rt_test.bl

(ns host.test_rt.test)

(defn- t2 [k v] (erlang/list_to_tuple (list k v)))

(defn- tmp-dir []
  (str (System/tmp_dir!) "/bl_host_test_rt_" (erlang/unique_integer (list :positive))))

(defn- trt-source [] (Path/join (BeamLisp/cwd) "priv/host/test_rt.bl"))
(defn- test-lib-path [] (Path/join (BeamLisp/cwd) "priv/std/test.bl"))
(defn- bl-bin [] (Path/join (BeamLisp/cwd) "bin/bl"))

(def ^:private probe :"Elixir.BeamLisp.TestRTHostProbe")
(def ^:private shim :"Elixir.BeamLisp.Ns.Host.TestRt")
(def ^:private live :"Elixir.BeamLisp.TestRT")

(defn- drop! [mod]
  (do (code/purge mod) (code/delete mod) :ok))

(defn- load-pinned [mod path]
  (do (drop! mod)
      (code/load_binary mod (erlang/binary_to_list path) (File/read! path))
      mod))

(defn- probe-opts [dir]
  (to-list (list (t2 :module probe) (t2 :output_dir dir) (t2 :load? false))))

; Compile the pinned source at the probe atom and publish ONLY the pinned beam:
; the compile's namespace shim is dropped, so every answer below comes from the
; pinned bytes with no namespace behind them.
(defn- compile-probe [dir]
  (let [res (BeamLisp.AOT/compile_host_file (trt-source) (probe-opts dir))
        m (load-pinned probe (erlang/element 2 res))]
    (drop! shim)
    m))

(defn- compile-live-pinned
  "Compile the pinned source AT the production atom into `out`, written but not
   loaded here."
  [out]
  (let [res (BeamLisp.AOT/compile_host_file
              (trt-source)
              (to-list (list (t2 :module live) (t2 :output_dir out) (t2 :load? false))))]
    (erlang/element 2 res)))

; ── the pinned ABI, on a probe beam ──────────────────────────────────────

(def pinned-exports
  "The absolute export surface of the pinned beam: the live module's public API
   plus `module_info`, and NOT the Elixir-generated `__info__/1` a
   functions-only pinned module deliberately does not carry."
  (list (t2 :aggregate 1) (t2 :begin_test 2) (t2 :clear_registry 0)
        (t2 :cli 1) (t2 :cli 2) (t2 :declarations 1) (t2 :declaring? 0) (t2 :end_test 1) (t2 :eq_form? 1)
        (t2 :merge_totals 2) (t2 :module_info 0) (t2 :module_info 1)
        (t2 :passed? 1) (t2 :print_summary 1) (t2 :record 6)
        (t2 :register_test 3) (t2 :registered_tests 1) (t2 :reset_run 1)
        (t2 :run_ns 1) (t2 :run_suite 1) (t2 :run_suite 2) (t2 :subst 3)
        (t2 :sym_name 1) (t2 :test_lib_source 0) (t2 :test_namespaces 0)
        (t2 :with_context 2)))

(deftest trt-pinned-surface-is-the-live-surface
  (testing "one export per live export, and no helper leaks the surface"
    (let [dir (tmp-dir)
          m (compile-probe dir)]
      ; NO SHIM: the compile's namespace module is gone; the pinned beam answers.
      (is (erlang/== :non_existing (erlang/apply :code :which (list shim))))
      ; THE PUBLIC ABI, pinned absolutely.
      (is (erlang/== pinned-exports
                     (lists/sort (erlang/apply m :module_info (list :exports))))
          "the pinned module is the live module's public API and nothing else")
      ; EVERY LIVE EXPORT is present, `__info__/1` excepted by name — the ONE
      ; documented divergence for a functions-only pinned module.
      (is (every? (fn [e] (or (erlang/== :__info__ (erlang/element 1 e))
                              (erlang/function_exported m (erlang/element 1 e)
                                                        (erlang/element 2 e))))
                  (erlang/apply live :module_info (list :exports)))
          "the pinned ABI covers every live export")
      (is (not (erlang/function_exported m :__info__ 1))
          "no synthesized `__info__/1`, exactly as a struct-less live surface")
      ; THE EMBEDDED TEST LIBRARY: the live module's byte for byte, and
      ; `priv/std/test.bl`'s — the drift gate `@external_resource` used to give.
      (is (erlang/== (erlang/apply live :test_lib_source (list))
                     (erlang/apply m :test_lib_source (list)))
          "the embedded test library is the live module's")
      (is (erlang/== (File/read! (test-lib-path))
                     (erlang/apply m :test_lib_source (list)))
          "…and is priv/std/test.bl itself, so an edit to the library cannot go stale silently")
      ; REPRODUCIBLE: a rebuild of the same source is the same bytes.
      (let [dir2 (tmp-dir)]
        (is (erlang/== (File/read! (Path/join dir "Elixir.BeamLisp.TestRTHostProbe.beam"))
                       (File/read! (erlang/element
                                     2 (BeamLisp.AOT/compile_host_file
                                         (trt-source) (probe-opts dir2)))))
            "the pinned beam is a pure function of its source")
        (File/rm_rf! dir2))
      (File/rm_rf! dir))))

; ── the dependency contract, read off the beam ───────────────────────────

(defn- remote-mods
  "Every remote module the beam calls."
  [path]
  (let [funs (erlang/element 6 (erlang/apply :beam_disasm :file
                                             (list (erlang/binary_to_list path))))]
    (Enum/uniq
      (Enum/flat_map
        (Enum/filter funs (fn [f] (erlang/== :function (erlang/element 1 f))))
        (fn [f]
          (Enum/flat_map (erlang/element 5 f)
            (fn [ins]
              (if (and (erlang/is_tuple ins)
                       (erlang/> (erlang/tuple_size ins) 2)
                       (erlang/== :call_ext (erlang/element 1 ins))
                       (erlang/is_tuple (erlang/element 3 ins)))
                (list (erlang/element 2 (erlang/element 3 ins)))
                (list)))))))))

(deftest trt-pinned-dependency-contract
  (testing "the whole remote set of the pinned beam, asserted from the disassembly"
    (let [dir (tmp-dir)]
      (compile-probe dir)
      (let [deps (lists/sort (Enum/reject
                               (remote-mods (Path/join dir "Elixir.BeamLisp.TestRTHostProbe.beam"))
                               (fn [m] (erlang/== m probe))))]
        (is (erlang/== (lists/sort
                         (list :erlang :"Elixir.BeamLisp" :"Elixir.BeamLisp.Compiler"
                               :"Elixir.BeamLisp.Env" :"Elixir.BeamLisp.ExInfo"
                               :"Elixir.BeamLisp.Loader" :"Elixir.BeamLisp.Ns.Core"
                               :"Elixir.BeamLisp.Ns.Rt" :"Elixir.BeamLisp.Vector"
                               :"Elixir.Enum" :"Elixir.Exception" :"Elixir.FunctionClauseError"
                               :"Elixir.IO" :"Elixir.Keyword" :"Elixir.Map" :"Elixir.Path"
                               :"Elixir.Process" :"Elixir.String.Chars" :"Elixir.StringIO"
                               :"Elixir.System" :"Elixir.Task"))
                       deps)
            (str "the test_rt beam's remote modules; got " (pr-str deps))))
      (File/rm_rf! dir))))

; ── the scenario: one script, one VM, two passes ─────────────────────────

(defn- fixture
  "The suite files the scenario runs. `mixed` carries a pass, a fail and an
   error in ONE file — the case that proves the three counters and the three
   output shapes coexist — and `error` throws and exits from a test BODY, which
   is the `run_ns/1` catch path rather than the `is` macro's."
  []
  (list
    (tuple "pass.bl"
           "(ns trt.pass)\n(deftest arithmetic\n  (is (= (+ 1 2) 3))\n  (is (= (* 6 7) 42)))\n(deftest collections\n  (testing \"map\"\n    (is (= (map inc [1 2]) '(2 3))))\n  (are [x y] (= x y) 1 1 2 2))\n")
    (tuple "fail.bl"
           "(ns trt.fail)\n(deftest eq-mismatch\n  (testing \"comparison\"\n    (is (= 1 2))))\n(deftest ok-one (is (= 1 1)))\n")
    (tuple "error.bl"
           "(ns trt.error)\n(deftest error-inside-is\n  (is (= (throw (ex-info \"boom\" {:code 9})) nil)))\n(deftest thrown-body\n  (throw (ex-info \"top\" {:code 3})))\n(deftest exited-body\n  (erlang/exit :bye))\n")
    (tuple "mixed.bl"
           "(ns trt.mixed)\n(deftest passing (is (= 1 1)))\n(deftest failing (testing \"ctx\" (is (= 1 2))))\n(deftest erroring (is (= (throw (ex-info \"boom\" {})) nil)))\n")
    (tuple "cross.bl"
           "(ns trt.alpha)\n(deftest a1 (is (= 1 1)))\n(deftest a2 (is (= 2 2)))\n(ns trt.beta)\n(deftest b1 (is (= 3 3)))\n")))

(defn- write-fixtures! [dir]
  (File/mkdir_p! dir)
  (Enum/each (fixture)
             (fn [f] (File/write! (Path/join dir (erlang/element 1 f))
                                  (erlang/element 2 f))))
  dir)

(def ^:private scenario-helpers
  ["(defn p [n] (str dir \"/\" n))"
   "(defn cap [f] (let [io (elem (StringIO/open \"\") 1) prev (Process/group_leader)]"
   "  (erlang/group_leader io (erlang/self))"
   "  (try (do (f) (elem (StringIO/contents io) 1))"
   "       (finally (do (erlang/group_leader prev (erlang/self)) (StringIO/close io))))))"
   "(defn totals-str [t] (pr-str (list (:tests t) (:pass t) (:fail t) (:error t))))"
   "(defn canon [out] (join \"\\n\" (sort (String/split out \"\\n\"))))"
   "(defn show [name f] (let [t (atom nil) out (cap (fn [] (reset! t (f))))]"
   "  (mark (str name \".totals\") (totals-str @t))"
   "  (mark (str name \".out\") (Base/encode64 out))))"
   "(defn show-canon [name f] (let [t (atom nil) out (cap (fn [] (reset! t (f))))]"
   "  (mark (str name \".totals\") (totals-str @t))"
   "  (mark (str name \".out\") (Base/encode64 (canon out)))))"])

(def ^:private scenario-forms
  ["(mark \"which\" (Elixir.List/to_string (code/which :\"Elixir.BeamLisp.TestRT\")))"
   ""
   "; -- the suite runner: green, red, erroring, mixed, cross-namespace, async"
   "(show \"pass\" (fn [] (BeamLisp.TestRT/run_suite (list (p \"pass.bl\")))))"
   "; -- the SAME file again: a fork's registrations die with it, so the second"
   "; -- run sees only its own tests and the totals cannot double."
   "(show \"pass2\" (fn [] (BeamLisp.TestRT/run_suite (list (p \"pass.bl\")))))"
   "(show \"fail\" (fn [] (BeamLisp.TestRT/run_suite (list (p \"fail.bl\")))))"
   "(show \"err\" (fn [] (BeamLisp.TestRT/run_suite (list (p \"error.bl\")))))"
   "(show \"mixed\" (fn [] (BeamLisp.TestRT/run_suite (list (p \"mixed.bl\")))))"
   "; -- the cross-namespace file: `run-tests :all` walks the registry in ETS"
   "; -- order, which is the TABLE's, not this module's, so the captured text is"
   "; -- canonicalised (its lines sorted) before it is compared."
   "(show-canon \"cross\" (fn [] (BeamLisp.TestRT/run_suite (list (p \"cross.bl\")))))"
   "(show \"async\" (fn [] (BeamLisp.TestRT/run_suite (list (p \"pass.bl\") (p \"fail.bl\"))"
   "                                            (list (tuple :async true)))))"
   ""
   "; -- the registry and run_ns directly: register, run, record, with_context"
   "(BeamLisp.TestRT/register_test \"trt.single\" \"t1\""
   "  (fn [] (BeamLisp.TestRT/record \"trt.single\" :pass (quote (is true)) nil nil true)))"
   "(BeamLisp.TestRT/register_test \"trt.single\" \"t2\""
   "  (fn [] (BeamLisp.TestRT/with_context \"inner\""
   "           (fn [] (BeamLisp.TestRT/record \"trt.single\" :fail (quote (is false)) \"msg here\" 1 2)))))"
   "(show \"single\" (fn [] (BeamLisp.TestRT/run_ns \"trt.single\")))"
   ""
   "; -- the pure surface"
   "(mark \"merged\" (let [m (BeamLisp.TestRT/merge_totals"
   "                         {:tests 1 :pass 2 :fail 3 :error 4 :ns \"x\"}"
   "                         {:tests 1 :pass 2 :fail 3 :error 4 :ns \"y\"})]"
   "                  (pr-str (list (:tests m) (:pass m) (:fail m) (:error m) (:ns m)))))"
   "(mark \"agg\" (let [a (BeamLisp.TestRT/aggregate"
   "                      (list {:tests 2 :pass 3 :fail 1 :error 0 :ns \"x\"}"
   "                            {:tests 3 :pass 1 :fail 0 :error 2 :ns \"y\"}))]"
   "               (pr-str (list (:tests a) (:pass a) (:fail a) (:error a)))))"
   "(mark \"passed-green\" (pr-str (BeamLisp.TestRT/passed? {:tests 1 :pass 1 :fail 0 :error 0})))"
   "(mark \"passed-red\" (pr-str (BeamLisp.TestRT/passed? {:tests 1 :pass 0 :fail 1 :error 0})))"
   "(mark \"summary\" (Base/encode64 (cap (fn [] (BeamLisp.TestRT/print_summary"
   "                                                 {:tests 2 :pass 3 :fail 1 :error 4})))))"
   "(mark \"sym\" (pr-str (list (BeamLisp.TestRT/sym_name (tuple :symbol \"abc\"))"
   "                            (BeamLisp.TestRT/sym_name 7))))"
   "(mark \"eq\" (pr-str (list (BeamLisp.TestRT/eq_form? (quote (= 1 2)))"
   "                           (BeamLisp.TestRT/eq_form? (quote (foo 1 2))))))"
   "(mark \"subst\" (pr-str (BeamLisp.TestRT/subst (quote (x y)) (quote (1 2)) (quote (+ x y)))))"
   "(mark \"subst-vec\" (pr-str (BeamLisp.TestRT/subst (quote [x y]) (quote [1 2]) (quote [+ x y]))))"
   ""
   "; -- the registry, by name"
   "(doseq [n [(p \"pass.bl\") (p \"fail.bl\") (p \"error.bl\") (p \"cross.bl\")]]"
   "  (BeamLisp.TestRT/register_test \"trt.reg\" n (fn [] nil)))"
   "(mark \"reg-count\" (count (BeamLisp.TestRT/registered_tests \"trt.reg\")))"
   "(BeamLisp.TestRT/register_test \"trt.reg\" (p \"fail.bl\") (fn [] nil))"
   "(mark \"reg-redef\" (count (BeamLisp.TestRT/registered_tests \"trt.reg\")))"
   "(mark \"nss\" (pr-str (sort (BeamLisp.TestRT/test_namespaces))))"
   "(BeamLisp.TestRT/clear_registry)"
   "(mark \"nss-after\" (pr-str (BeamLisp.TestRT/test_namespaces)))"
   ""
   "; -- the CLI on a green suite: it does not halt, and answers nil"
   "(mark \"green-cli\" (pr-str (BeamLisp.TestRT/cli (list (p \"pass.bl\")))))"])

(defn- scenario-pass
  "One PASS of the scenario, every mark prefixed with `prefix`."
  [prefix]
  (reduce (fn [acc l] (str acc l "\n")) ""
          (concat (list (str "(defn mark [k v] (println (str \"MARK " prefix ".\" k \"=\" v)))"))
                  scenario-helpers
                  scenario-forms)))

(defn- scenario
  "The child's whole program: the scenario against the live module, the swap of
   the PRODUCTION atom onto the pinned beam, the SAME scenario again, and a
   `cli` on a red suite — which halts, so it is the last thing the child does
   (its exit status is the observation)."
  [dir beam]
  (str "(ns trt.scenario)\n"
       "(def dir \"" dir "\")\n"
       (scenario-pass "live")
       "(code/purge :\"Elixir.BeamLisp.TestRT\")\n"
       "(code/delete :\"Elixir.BeamLisp.TestRT\")\n"
       "(code/load_binary :\"Elixir.BeamLisp.TestRT\" (erlang/binary_to_list \"" beam
       "\") (File/read! \"" beam "\"))\n"
       "; the run left the current namespace wherever the last test file put it\n"
       "(BeamLisp.Env/in_ns \"trt.scenario\")\n"
       (scenario-pass "pinned")
       "(BeamLisp.TestRT/cli (list \"" dir "/fail.bl\"))\n"))

(defn- cmd-opts []
  (to-list (list (tuple :stderr_to_stdout true)
                 (tuple :env (to-list (list (tuple "ERL_CRASH_DUMP" "/dev/null")))))))

(defn- child-run [script]
  (let [path (str (tmp-dir) ".bl")]
    (File/write! path script)
    (try
      (System/cmd (bl-bin) (to-list (list "run" path)) (cmd-opts))
      (finally (File/rm! path)))))

(defn- marks
  "The child's `MARK key=value` lines, as a map, so two runs are compared as DATA
   rather than as text that happens to be in the same order."
  [text]
  (reduce
    (fn [acc line]
      (if (String/starts_with? line "MARK ")
        (let [parts (String/split (subs line 5) "=" (to-list (list (tuple :parts 2))))]
          (assoc acc (first parts) (second parts)))
        acc))
    {}
    (String/split text "\n")))

(defn- phase-marks
  "The marks of one pass, `prefix.` stripped — so the two passes are compared
   key for key, not `live.a` against `pinned.a`."
  [text prefix]
  (let [p (str prefix ".")
        n (count p)]
    (reduce (fn [acc kv]
              (let [k (first kv)]
                (if (String/starts_with? k p)
                  (assoc acc (subs k n) (second kv))
                  acc)))
            {}
            (marks text))))

(defn- decode [b64]
  (erlang/element 2 (Base/decode64 b64)))

(defn- line-index
  "The 0-based line of `needle` in `text`, or -1: used to assert the ORDER of two
   headers a single run printed."
  [text needle]
  (loop [ls (String/split text "\n")
         i 0]
    (cond (empty? ls) -1
          (erlang/== (first ls) needle) i
          :else (recur (rest ls) (erlang/+ i 1)))))

; ── the differential assertions ──────────────────────────────────────────

(defn- assert-same-observation [lm pm beam]
  ; (1) THE SAME OBSERVATION, mark for mark — with `which` masked, because
  ; naming the beam that answered is the one thing that MUST differ.
  (is (erlang/== (sort (keys lm)) (sort (keys pm)))
      "both passes produced the same set of marks")
  (is (erlang/== (assoc lm "which" "masked") (assoc pm "which" "masked"))
      (str "the PINNED module answers the LIVE module's observation, value for value.\n"
           "live:\n" (pr-str lm) "\npinned:\n" (pr-str pm)))
  ; (2) THE PROOF THAT THE PINNED BYTES RAN — and that the live pass ran the
  ; live module, so the differential is not a tautology.
  (is (erlang/== beam (get pm "which"))
      (str "the pinned pass's TestRT module IS the beam compiled from priv/host/test_rt.bl\n"
           "beam:  " (pr-str beam) "\npinned which: " (pr-str (get pm "which"))
           "\nlive which:   " (pr-str (get lm "which"))))
  (is (not (erlang/== beam (get lm "which")))
      "the live pass answered from this vm's own beam"))

(defn- assert-absolute
  "The absolute values, taken from the LIVE pass: equality between the two passes
   is not enough on its own — both could be wrong the same way. These pin the
   counters, the RENDERED output and the pure surface the module exists for."
  [lm]
  (is (erlang/== "(2 5 0 0)" (get lm "pass.totals")) "a green file counts and passes")
  (is (erlang/== "(2 5 0 0)" (get lm "pass2.totals"))
      "re-running the same file sees only its own registrations: the fork isolates them")
  (is (erlang/== "(2 1 1 0)" (get lm "fail.totals")) "a red file counts its failure")
  (is (erlang/== "(3 0 0 3)" (get lm "err.totals"))
      "a throwing and an exiting test BODY are errors, as is a raise inside `is`")
  (is (erlang/== "(3 1 1 1)" (get lm "mixed.totals"))
      "pass, fail and error coexist in ONE file")
  (is (erlang/== "(3 3 0 0)" (get lm "cross.totals"))
      "both namespaces in one file are registered and run")
  (is (erlang/== "(4 6 1 0)" (get lm "async.totals"))
      "the forked async mode aggregates every file")
  (is (erlang/== "(2 1 1 0)" (get lm "single.totals"))
      "`run_ns/1` runs exactly the registered namespace")

  (let [fout (decode (get lm "fail.out"))
        eout (decode (get lm "err.out"))
        mout (decode (get lm "mixed.out"))
        cout (decode (get lm "cross.out"))
        aout (decode (get lm "async.out"))]
    (is (includes? fout "Testing trt.fail") "the ns header is printed")
    (is (includes? fout "FAIL in (trt.fail)") "a failure renders the FAIL block")
    (is (includes? fout "  eq-mismatch\n  comparison")
        "the test name and the `testing` context render as indented lines")
    (is (includes? fout "expected: 1") "the expected VALUE is rendered")
    (is (includes? fout "  actual: 2") "the actual VALUE is rendered")
    (is (includes? fout "Ran 2 tests containing 2 assertions.")
        "the clojure.test summary line is printed")
    (is (includes? fout "1 failures, 0 errors.") "…with the failure count")
    (is (includes? eout "ERROR in (trt.error)") "an error renders the ERROR block")
    (is (includes? eout "  actual: boom") "…with the exception's message")
    (is (includes? eout "  actual: top")
        "a thrown test body records `{:throw, value}` and renders its message")
    (is (includes? eout "  actual: {:exit, :bye}")
        "an exiting test body records `{:exit, value}`")
    (is (includes? mout "FAIL in (trt.mixed)") "the mixed file renders its failure")
    (is (includes? mout "ERROR in (trt.mixed)") "…and its error")
    (is (includes? cout "Testing trt.alpha") "the first namespace of the file runs")
    (is (includes? cout "Testing trt.beta") "…and the second")
    (is (includes? cout "Ran 3 tests containing 3 assertions.")
        "both namespaces' tests ran under one summary")
    (is (< (line-index aout "Testing trt.pass") (line-index aout "Testing trt.fail"))
        "async output replays in the ORIGINAL path order"))

  (is (erlang/== "(2 4 6 8 \"x\")" (get lm "merged"))
      "merge_totals sums the four counters and keeps the left map's ns")
  (is (erlang/== "(5 4 1 2)" (get lm "agg")) "aggregate sums a list of results")
  (is (erlang/== "true" (get lm "passed-green")) "passed? sees a green totals map")
  (is (erlang/== "false" (get lm "passed-red")) "…and a red one")
  (is (erlang/== "(\"abc\" nil)" (get lm "sym")) "sym_name unwraps a symbol datum")
  (is (erlang/== "(true false)" (get lm "eq")) "eq_form? sees a three-element `=` datum")
  (is (erlang/== "(+ 1 2)" (get lm "subst")) "subst substitutes symbol datums")
  (is (erlang/== "[+ 1 2]" (get lm "subst-vec")) "…and rebuilds a vector datum as a vector")
  (is (erlang/== "4" (get lm "reg-count")) "four registrations under one ns")
  (is (erlang/== "4" (get lm "reg-redef"))
      "re-registering a name REPLACES it rather than duplicating")
  (is (erlang/== "()" (get lm "nss-after")) "clear_registry drops every registration")
  (is (includes? (get lm "nss") "trt.reg") "test_namespaces lists a registered ns")
  (is (erlang/== "nil" (get lm "green-cli"))
      "cli on a green suite does not halt and answers nil")
  (is (erlang/== "\nRan 2 tests containing 8 assertions.\n1 failures, 4 errors.\n"
                 (decode (get lm "summary")))
      "print_summary is the clojure.test shape, byte for byte"))

; ── the differential ─────────────────────────────────────────────────────

(deftest trt-pinned-answers-the-live-module-in-isolated-child-vms
  (testing "one scenario, one VM, two passes: identical marks, and only `which` may differ"
    (let [dir (tmp-dir)
          fix (Path/join dir "fix")
          out (Path/join dir "pin")]
      (write-fixtures! fix)
      (File/mkdir_p! out)
      (let [beam (compile-live-pinned out)]
        (is (File/exists? beam))
        (is (not (includes? (Elixir.List/to_string (code/which live)) out))
            "this vm still runs the live module, not the pinned beam")
        (is (erlang/function_exported live :run_suite 2)
            "the live module was never substituted mid-flight")
        (let [r (child-run (scenario fix beam))
              text (erlang/element 1 r)
              status (erlang/element 2 r)]
          ; the child ENDS on `cli` over a red suite, which halts with 1 — so the
          ; status is the CLI observation, and an early crash would show as
          ; missing marks below rather than as this exit code.
          (is (erlang/== 1 status)
              (str "the pinned `cli` halts 1 on a red suite (child exited " status "):\n" text))
          (let [lm (phase-marks text "live")
                pm (phase-marks text "pinned")]
            (is (pos? (count lm)) (str "the child printed no marks:\n" text))
            (assert-same-observation lm pm beam)
            (assert-absolute lm))))
      (File/rm_rf! dir))))

; ── the CLI's exit status on a red suite, live and pinned ────────────────
; A red `cli` halts, so the live half needs a VM of its own — the pinned half is
; the tail of the differential child above.

(deftest trt-live-cli-exits-one-on-a-red-suite
  (testing "the live module's `cli` halts 1, the other half of the pinned observation"
    (let [dir (tmp-dir)
          fix (Path/join dir "fix")]
      (write-fixtures! fix)
      (let [r (child-run (str "(ns trt.cli)\n"
                              "(BeamLisp.TestRT/cli (list \"" (Path/join fix "fail.bl") "\"))\n"))]
        (is (erlang/== 1 (erlang/element 2 r))
            (str "the live CLI exits 1 on a red suite:\n" (erlang/element 1 r)))
        (is (erlang/function_exported live :run_suite 2)
            "and this vm still runs the live module"))
      (File/rm_rf! dir))))

(run-tests)
