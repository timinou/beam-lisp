; HOME source fixture; actual native generated owner, no mocked registration.
(ns proc.reconcile-status-no-replay-test
 (:require [reload.generation :as g] [proc.reconcile-config :as config] [datom :as d]))
(defn graph [application marker version]
 (g/prepare! {:application-id application :native-modules #{"File"}
  :sources {"status.fixture"
   (str "(ns status.fixture (:require [proc.server :as server])) "
        "(def version " version ") "
        "(defn config-for [srv policy opts] (File/write! " (pr-str marker) " \"factory\") "
        " {:projection {:ident :status/example} :conn-fn (fn [_] (:conn opts)) "
        "  :scope-fn (fn [_ _] []) :apply (fn [_ _] nil) :level nil}) "
        "(server/defserver worker (reconcile {:server (:queue start-opts) :config-fn config-for :level nil})) "
        "(defn start! [opts] (start worker opts))")}}))
(defn kind [action] (try (action) nil (catch error (:kind (ex-data error)))))
(defn stopped! [pid]
 (let [ref (Process/monitor pid)]
  (GenServer/stop pid :normal 10000)
  (receive [:DOWN seen :process child _] :when (and (= seen ref) (= child pid)) true (after 10000 false))))

(deftest absent-owner-status-never-reexecutes-a-real-effectful-factory
 (let [path (str (System/get_env "HOME") "/tmp/reconcile-status-" (erlang/unique_integer (list :positive)))
       application (str "reconcile-status-" (erlang/unique_integer (list :positive)))
       old (graph application path 1) fresh (graph application path 2) mirror (d/connect [])
       owner (g/invoke! old "status.fixture/start!" [{:queue :same :conn mirror}])]
  (try
   (is (File/exists? path))
   (is (= true (g/with! old #(config/available? :same))))
   (is (stopped! owner))
   (File/rm! path)
   (is (= false (g/with! old #(config/registered? :same))))
   (is (= false (g/with! fresh #(config/available? :same))))
   ;; Known physical DOWN is unavailable even before asynchronous private
   ;; lifetime cleanup; status does not borrow an already-dead registration.
   (is (= :missing-reconcile-owner
         (kind #(g/with! fresh (fn [] (config/invoke! :same :status [] (fn [cfg _ _] (:level cfg))))))))
   (is (not (File/exists? path)))
   (is (= :missing-reconcile-owner
         (kind #(g/with! fresh (fn [] (config/invoke! :same :perform [{}] (fn [_ _ _] :wrong)))))))
   (is (not (File/exists? path)))
   (finally (when (Process/alive? owner) (stopped! owner))
    (d/close! mirror) (g/retire! old) (g/retire! fresh)
    (when (File/exists? path) (File/rm! path))))))
