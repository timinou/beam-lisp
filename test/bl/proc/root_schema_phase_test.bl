; DRAFT native acceptance. MISSING native receipt issuer is a prerequisite.
; UNRUN. Use an isolated final VM with parent203 + addendum204 + this SDK draft.
(ns proc.root-schema-phase-test
 (:require [test.support.dynamic-policy :as fixture] [datom.migration-admission :as migration]
           [datom :as d] [datom.conn :as conn] [datom.store-fjall :as fjall] [reload.generation :as g]
           [proc.queue-family-root :as root] [proc.task :as task]))
(defn setup []
 (let [path (fixture/directory) graph (fixture/prepared path
              (str "root-phase-" (erlang/unique_integer (list :positive))) (fixture/policy-plan))
       journal (d/connect-with (fjall/open (str path "/journal.fjall")))]
  (fixture/ready! graph journal) (fixture/install! graph)
  {:graph graph :journal journal :path path}))
(defn spec [operation] {:operation operation :phase :additive-schema-expand-publication})
(defn worker [graph operation called]
 (task/async-nolink
  (fn []
   (receive
    [:phase ticket]
     (fixture/kind #(root/with-delegated-schema-phase! graph (spec operation) ticket
       (fn [] (g/with! graph
        (fn [] (migration/expand!) (swap! called inc) :known)))))
    [:probe ticket target offered]
     (fixture/kind #(root/with-delegated-schema-phase! target offered ticket
       (fn [] (swap! called inc) :unexpected)))
    [:unknown ticket]
     (fixture/kind #(root/with-delegated-schema-phase! graph (spec operation) ticket
       (fn [] (g/with! graph
        (fn []
         (let [row (root/evidence! graph) journal (:journal row)]
          (conn/with-guard-reservation! [(conn/guard-association-inventory! journal)] {:root (:root row)}
           (fn [] (migration/expand!) (swap! called inc)
            (throw (ex-info "Unknown phase" {:kind :fixture-unknown}))))))))))
    :depart :departed))))
(deftest actual-native-worker-expands-once-and-cannot-reissue-operation
 (let [{:keys [graph]} (setup) called (atom 0) work (worker graph "once" called)
       ticket (root/delegate-schema-phase! graph (task/pid work) (spec "once"))]
  (is (erlang/is_reference ticket))
  (erlang/send (task/pid work) [:phase ticket])
  (is (nil? (task/await work 10000)))
  (is (= 1 @called))
  (is (= 1 (:frontier (fixture/status graph))))
  (let [again (worker graph "once" called)]
   (is (= :queue-root-schema-phase-already-issued-or-capacity
          (fixture/kind #(root/delegate-schema-phase! graph (task/pid again) (spec "once")))))
   (erlang/send (task/pid again) :depart) (task/await again 10000))
  (is (= 1 @called))))
(deftest foreign-selector-and-changed-generation-refuse-before-effects
 (let [{:keys [graph]} (setup) called (atom 0) intended (worker graph "foreign" called)
       ticket (root/delegate-schema-phase! graph (task/pid intended) (spec "foreign"))
       foreign (worker graph "foreign" called)]
  (erlang/send (task/pid foreign) [:phase ticket])
  (is (= :queue-root-schema-phase-authority-required (task/await foreign 10000)))
  (is (= 0 @called))
  (let [next (g/prepare! {:application-id (:application-id graph)
                        :sources {"phase.other" "(ns phase.other) (defn value [] 2)"}
                        :resources (:resources graph)})]
   (is (not= (:digest graph) (:digest next)))
   (erlang/send (task/pid intended) [:probe ticket next (spec "foreign")])
   (is (= :queue-root-schema-phase-authority-required (task/await intended 10000))))
  (is (= 0 @called))))
(deftest closed-phase-and-missing-root-refuse-before-effects
 (let [{:keys [graph]} (setup) called (atom 0) work (worker graph "closed" called)
       absent (g/prepare! {:application-id (:application-id graph)
                          :sources {"phase.absent" "(ns phase.absent) (defn value [] 3)"}
                          :resources (:resources graph)})]
  (is (= :queue-root-schema-phase-spec-required
         (fixture/kind #(root/delegate-schema-phase! graph (task/pid work)
                         {:operation "closed" :phase :contract}))))
  (is (= :queue-root-schema-phase-spec-required
         (fixture/kind #(root/delegate-schema-phase! graph (task/pid work)
                         (assoc (spec "closed") :callback (fn [] :fake))))))
  (is (= :queue-root-phase-custodian-required
         (fixture/kind #(root/delegate-schema-phase! absent (task/pid work) (spec "absent")))))
  (erlang/send (task/pid work) :depart) (task/await work 10000)
  (is (= 0 @called))))
(deftest actual-worker-departure-before-effects-keeps-operation-held
 (let [{:keys [graph]} (setup) called (atom 0) work (worker graph "departed" called)
       ticket (root/delegate-schema-phase! graph (task/pid work) (spec "departed"))]
  (is (erlang/is_reference ticket))
  ;; Cooperative actual Task completion, no forged DOWN and no process kill.
  (erlang/send (task/pid work) :depart)
  (is (= :departed (task/await work 10000)))
  (is (not (Process/alive? (task/pid work))))
  (is (= 0 @called))
  (is (= 0 (:frontier (fixture/status graph))))
  (is (= :queue-root-schema-phase-unconfirmed (root/retirement-blocker graph)))
  (let [replacement (worker graph "departed" called)]
   (is (= :queue-root-schema-phase-already-issued-or-capacity
          (fixture/kind #(root/delegate-schema-phase! graph (task/pid replacement) (spec "departed")))))
   (erlang/send (task/pid replacement) :depart) (task/await replacement 10000))
  (is (= 0 @called))))

(deftest unknown-native-phase-retains-actual-outer-reservation
 (let [{:keys [graph journal]} (setup) called (atom 0) work (worker graph "unknown" called)
       ticket (root/delegate-schema-phase! graph (task/pid work) (spec "unknown"))]
  (erlang/send (task/pid work) [:unknown ticket])
  (is (= :fixture-unknown (task/await work 10000)))
  (is (= 1 @called))
  (is (= {:state :uncertain} (conn/guard-reservation-status journal)))
  (is (= :queue-root-schema-phase-unconfirmed (root/retirement-blocker graph)))
  (let [replacement (worker graph "unknown" called)]
   (is (= :queue-root-schema-phase-already-issued-or-capacity
          (fixture/kind #(root/delegate-schema-phase! graph (task/pid replacement) (spec "unknown")))))
   (erlang/send (task/pid replacement) :depart) (task/await replacement 10000))
  (is (= 1 @called))))
