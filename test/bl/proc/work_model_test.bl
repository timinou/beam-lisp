(ns proc.work-model-test (:require [proc.work :as work] [system.model :as model] [typed]))
(defn until [pred]
 (loop [left 400] (cond (pred) true (zero? left) false :else (do (Process/sleep 5) (recur (dec left))))))
(deftest model-is-extracted-from-the-actual-owner
 (let [forms (BeamLisp.Reader/read_string (File/read! (BeamLisp.Loader/source_path "proc.work")))
       declaration (first (filter (fn [form] (= "proc.server/defserver" (model/head-name form))) forms))
       transitions (model/extract-defserver (typed/node-items (typed/node-form declaration)))
       labels (set (map :label transitions))]
  (is (contains? labels :submit)) (is (contains? labels :cancel))
  (is (contains? labels :snapshot)) (is (contains? labels :work-finished))
  (is (contains? labels :work-force-cancel))))
(deftest bounded-cancellation-completion-interleavings-preserve-terminal-state
 (let [controller (work/start! {:max-active 1 :history 2}) recipient (erlang/self)]
  (try
   (doseq [cancel-first [true false] iteration (range 8)]
    (let [id (:id (work/submit! controller {:generation iteration} (fn [context]
                 (erlang/send recipient [:started (erlang/self)])
                 (receive :finish :ok) ((:checkpoint context)))))
          worker (receive [:started pid] pid (after 2000 nil))]
      (is (some? worker))
      (when cancel-first (is (:accepted (work/cancel! controller id))))
      (erlang/send worker :finish)
      (is (until (fn [] (some (fn [row] (and (= id (:id row))
             (= (if cancel-first :cancelled :done) (:status row)))) (work/snapshot controller)))))
      (is (= false (:ok (work/cancel! controller id))))
      (is (= iteration (:generation (first (work/snapshot controller)))))))
   (finally (work/stop! controller)))))
