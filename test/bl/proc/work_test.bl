(ns proc.work-test (:require [proc.work :as work] [vm.scope :as scope] [vm.owner :as owner]))
(defn- wait-for [pred]
 (loop [n 400] (cond (pred) true (zero? n) false :else (do (Process/sleep 5) (recur (dec n))))))
(defn private-task [context]
 (loop [n 0]
  ((:checkpoint context)) ((:progress context) n) (Process/sleep 5) (recur (inc n))))
(deftest transient-work-is-owned-bounded-and-cancellable
 (let [owner (work/start! {:max-active 1 :history 2})]
  (try
   (let [id (:id (work/submit! owner {:title "private probe" :secret "never project"} private-task))]
    (is (string? id))
    (is (wait-for (fn [] (> (:progress (first (work/snapshot owner))) 0))))
    (is (= false (:ok (work/submit! owner {} private-task))))
    (is (:accepted (work/cancel! owner id)))
    (is (wait-for (fn [] (= :cancelled (:status (first (work/snapshot owner)))))))
    (let [row (first (work/snapshot owner))]
     (is (not (contains? row :pid))) (is (not (contains? row :secret)))
     (is (number? (:cancel-ms row))))
    (is (= false (:ok (work/cancel! owner "foreign")))))
   (finally (work/stop! owner)))
  (is (not (Process/alive? owner)))) )
(deftest result-completion-and-failure-are-terminal
 (let [owner (work/start!)]
  (try
   (work/submit! owner {} (fn [_] :done))
   (is (wait-for (fn [] (= :done (:status (first (work/snapshot owner)))))))
   (work/submit! owner {} (fn [_] (throw "private failure")))
   (is (wait-for (fn [] (some (fn [j] (= :failed (:status j))) (work/snapshot owner)))))
   (finally (work/stop! owner)))))
(deftest completed-churn-keeps-old-active-work-and-bounds-history
 (let [owner (work/start! {:max-active 2 :history 3})]
  (try
   (let [active (:id (work/submit! owner {:title "old active"} private-task))]
    (doseq [_ (range 8)]
     (let [id (:id (work/submit! owner {} (fn [_] :done)))]
      (is (wait-for (fn [] (some (fn [j] (and (= id (:id j)) (= :done (:status j)))) (work/snapshot owner)))))))
    (let [rows (work/snapshot owner)]
     (is (= 3 (count rows)))
     (is (some (fn [j] (= active (:id j))) rows)))
    (is (:accepted (work/cancel! owner active))))
   (finally (work/stop! owner)))))
(deftest noncooperative-private-work-is-forced-to-stop
 (let [owner (work/start! {:max-active 1 :history 2})]
  (try
   (let [id (:id (work/submit! owner {} (fn [_] (receive :never :ok))))]
    (is (:accepted (work/cancel! owner id)))
    (is (:accepted (work/cancel! owner id)))
    (is (wait-for (fn [] (= :cancelled (:status (first (work/snapshot owner))))))))
   (finally (work/stop! owner)))))

(deftest creator-death-retracts-private-owner-and-worker
 (let [recipient (erlang/self)
       creator (spawn (fn []
         (let [owner (work/start!)]
          (work/submit! owner {} (fn [_]
            (erlang/send recipient [:worker (erlang/self)]) (receive :never :ok)))
          (erlang/send recipient [:owner owner])
          (receive :finish :ok))))
       worker (receive [:worker p] p (after 2000 nil))
       owner (receive [:owner p] p (after 2000 nil))]
  (is (not (nil? worker))) (is (not (nil? owner)))
  (erlang/send creator :finish)
  (is (wait-for (fn [] (not (Process/alive? owner)))))
  (is (wait-for (fn [] (not (Process/alive? worker)))))))

(deftest private-workers-inherit-realm-membership-and-retract-on-stop
 (let [realm (str "private-work-" (erlang/unique_integer (list :positive)))
       recipient (erlang/self)
       controller (scope/with-vm realm (fn [] (work/start!)))]
  (try
   (work/submit! controller {} (fn [_]
     (erlang/send recipient [:scope (scope/current)]) (receive :never :ok)))
   (is (= realm (receive [:scope observed] observed (after 2000 nil))))
   (is (wait-for (fn [] (= 2 (count (owner/members realm))))))
   (finally (work/stop! controller)))
  (is (wait-for (fn [] (empty? (owner/members realm)))))))
