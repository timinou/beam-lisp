(ns proc.queue-configured-server-test
 (:require [proc :as proc] [proc.queue :as q] [datom :as d] [datom.conn :as dc] [datom.store-map :as sm]))
(proc/defserver configured-worker
 (queue {:of :test/configured :server (:server start-opts) :clock (:clock start-opts)
         :unique [:test/key] :concurrency 1})
 (perform [job] ((:perform start-opts) job)))
(defn finished [srv id]
 (loop [n 0]
  (let [job (d/entity (d/db (q/conn srv)) id)]
   (cond (= :done (:job/state job)) job
         (> n 1000) (throw (ex-info "Configured queue did not finish" {:server srv :state (:job/state job)}))
         :else (do (Process/sleep 5) (recur (inc n)))))))
(deftest configured-server-stages-the-perform-for-its-own-initialization
 (let [left :configured-left right :configured-right
       lc (dc/connect-with (sm/open) []) rc (dc/connect-with (sm/open) [])]
  (q/attach-store! left lc) (q/attach-store! right rc)
  (let [a (start configured-worker {:server left :clock (fn [] 1000)
            :perform (fn [job] {:side :left :value (:test/value job)})} {})]
   (try
    (let [b (start configured-worker {:server right :clock (fn [] 2000)
              :perform (fn [job] {:side :right :value (:test/value job)})} {})]
     (try
      (let [lj (q/enqueue! left {:test/key "same-key" :test/value 1} {:at 1000})
            rj (q/enqueue! right {:test/key "same-key" :test/value 2} {:at 2000})]
       (is (= {:side :left :value 1} (:job/result (finished left (:db/id lj)))))
       (is (= {:side :right :value 2} (:job/result (finished right (:db/id rj)))))
       (is (= "configured-left" (:job/server (d/entity (d/db lc) (:db/id lj)))))
       (is (= "configured-right" (:job/server (d/entity (d/db rc) (:db/id rj)))))
       (is (not= lc rc)))
      (finally (stop b))))
    (finally (stop a))))))
