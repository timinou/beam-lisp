(ns proc.evolve-test (:require [proc.evolve :as ev]))
(defn first-spec []
 {:version 1 :digest "counter-v1" :accept? (fn [m] (contains? #{:inc :read} m))
  :check-state (fn [s] (and (erlang/is_integer s) (>= s 0)))
  :handler (fn [m s] (let [n (if (= :inc m) (inc s) s)] {:reply n :state n}))})
(defn second-spec []
 {:version 2 :digest "counter-v2" :accept? (fn [m] (and (map? m) (contains? m :amount)))
  :check-state (fn [s] (and (map? s) (erlang/is_integer (:count s)) (>= (:count s) 0)))
  :migrate-state (fn [s] {:count s})
  :upcast (fn [m] (case m :inc {:amount 1} :read {:amount 0} m))
  :handler (fn [m s] (let [n (+ (:count s) (:amount m))] {:reply n :state {:count n}}))})

(deftest stable-pid-state-and-late-old-messages
 (let [p (ev/start! (first-spec) 0)]
  (try
   (is (= 1 (ev/call! p 1 :inc)))
   (is (= :applied (:status (ev/upgrade! p 1 (second-spec)))))
   (is (= p (:pid (ev/status p))))
   (is (= 2 (:version (ev/status p))))
   (is (= 2 (ev/call! p 1 :inc)))
   (is (= 7 (ev/call! p 2 {:amount 5})))
   (is (= [1] (:legacy-versions (ev/status p))))
   (is (= :already-applied (:status (ev/upgrade! p 1 (second-spec)))))
   (is (= :stale (:status (ev/upgrade! p 1 (assoc (second-spec) :version 3)))))
   (is (= :identity-conflict (:status (ev/upgrade! p 2 (assoc (second-spec) :digest "changed")))))
   (is (= 7 (ev/call! p 1 :read)))
   (finally (GenServer/stop p)))))

(deftest refused-upgrade-and-invalid-message-preserve-owner
 (let [p (ev/start! (first-spec) 4)]
  (try
   (is (= :refused (:status (ev/upgrade! p 1 (dissoc (second-spec) :upcast)))))
   (is (= :refused (:status (ev/upgrade! p 1 (assoc (second-spec) :migrate-state (fn [_] {:count -1}))))))
   (is (= 1 (:version (ev/status p))))
   (is (= 4 (ev/call! p 1 :read)))
   (is (= :refused (:status (ev/call! p 9 :inc))))
   (is (= :refused (:status (ev/call! p 1 :unhandled))))
   (is (= 5 (ev/call! p 1 :inc)))
   (finally (GenServer/stop p)))))

(deftest queued-old-calls-upcast-after-upgrade-without-rewriting-mailbox
 (let [p (ev/start! (first-spec) 0) parent (erlang/self)
       upgrade-alias (erlang/alias) call-alias (erlang/alias)]
  (try
   ;; Same sender's signals are ordered: upgrade first, old request already in
   ;; the mailbox behind it. Replies use OTP aliases, exactly like GenServer.
   (erlang/send p (tuple :"$gen_call" (tuple parent upgrade-alias)
                         [:proc.evolve/upgrade 1 (second-spec)]))
   (erlang/send p (tuple :"$gen_call" (tuple parent call-alias)
                         [:proc.evolve/call 1 :inc]))
   (is (= :applied (:status (receive [tag r] :when (= tag upgrade-alias) r
                                  (after 5000 nil)))))
   (is (= 1 (receive [tag r] :when (= tag call-alias) r (after 5000 nil))))
   (is (= p (:pid (ev/status p))))
   (finally (erlang/unalias upgrade-alias) (erlang/unalias call-alias) (GenServer/stop p)))))

(deftest slow-migration-is-bounded-and-history-is-bounded
 (let [p (ev/start! (first-spec) 1 {:upgrade-ms 10 :history-limit 1})]
  (try
   (is (= :refused (:status (ev/upgrade! p 1
                   (assoc (second-spec) :migrate-state (fn [s] (Process/sleep 100) {:count s}))))))
   (is (= 1 (ev/call! p 1 :read)))
   (is (= :applied (:status (ev/upgrade! p 1 (second-spec)))))
   (is (= :history-full (:status (ev/upgrade! p 2 (assoc (second-spec) :version 3)))))
   (is (= 2 (ev/call! p 1 :inc)))
   (finally (GenServer/stop p)))))

(deftest managed-retirement-fences-admissions-and-waits-for-real-clients
 (let [p (ev/start! (first-spec) 0 {:managed true :history-limit 1})
       acquired (ev/acquire-client! p 1) token (:token acquired)]
  (try
   (is (= :acquired (:status acquired)))
   (is (= :managed-client-required (:kind (ev/call! p 1 :inc))))
   (is (= 1 (ev/call-client! p token :inc)))
   (is (= :applied (:status (ev/upgrade! p 1 (second-spec)))))
   (is (= :waiting (:status (ev/retire! p 2 1))))
   (is (= :version-fenced (:kind (ev/acquire-client! p 1))))
   (is (= 2 (ev/call-client! p token :inc)))
   (ev/release-client! p token)
   (is (= :unknown-client (:kind (ev/call-client! p token :inc))))
   (is (= :retired (:status (ev/retire! p 2 1))))
   (is (= [] (:legacy-versions (ev/status p))))
   (is (= :applied (:status (ev/upgrade! p 2 (assoc (second-spec) :version 3 :digest "v3" :migrate-state (fn [s] s) :upcast (fn [m] m))))))
   (finally (GenServer/stop p)))))

(deftest unmanaged-owners-cannot-authorize-adapter-collection
 (let [p (ev/start! (first-spec) 0)]
  (try
   (ev/upgrade! p 1 (second-spec))
   (is (= :unmanaged-owner (:kind (ev/retire! p 2 1))))
   (is (= [1] (:legacy-versions (ev/status p))))
   (finally (GenServer/stop p)))))

(deftest retirement-keeps-evolution-bounded-across-many-releases
 (let [base {:version 1 :digest "bounded-1" :accept? (fn [_] true)
             :check-state (fn [_] true) :handler (fn [m s] {:reply m :state s})}
       p (ev/start! base nil {:managed true :history-limit 1})]
  (try
   (doseq [version (range 2 42)]
    (let [spec (assoc base :version version :digest (str "bounded-" version)
                          :migrate-state (fn [s] s) :upcast (fn [m] m))]
     (is (= :applied (:status (ev/upgrade! p (dec version) spec))))
     (is (= :retired (:status (ev/retire! p version (dec version)))))
     (is (= [] (:legacy-versions (ev/status p))))))
   (is (= 41 (:version (ev/status p))))
   (finally (GenServer/stop p)))))
