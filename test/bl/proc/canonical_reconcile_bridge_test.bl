; Genuine native integration gate for the HOME bridge. NOT RUN yet.
; No fabricated graph/native index, fake callback, synthetic queue or provider.
; This is SDK+Fjall component acceptance, not packaged Knowledger/Foundry UI.
(ns proc.canonical-reconcile-bridge-test
 (:require [reload.generation :as g] [reload.execution :as execution] [env]
           [proc.reconcile :as rec] [proc.reconcile-handler :as handler] [proc.reconcile-runtime :as declared]
           [proc.queue-runtime :as runtime] [proc.queue :as q]
           [proc.queue-family :as family] [proc.queue-family-root :as root]
           [proc.framework :as framework] [proc.transition :as transition]
           [datom :as d] [datom.projection :as pj] [datom.store-fjall :as fjall] [test.support.source-fixtures :as fixtures]))
(fixtures/effects!)
(def P (pj/projection :bridge/projection
         {:member '[[?src :fixture/scope ?scope]] :revision '[[?src :fixture/rev ?rev]]}))
(def SCHEMA (into pj/schema
 [{:db/ident :fixture/tenant :db/valueType :db.type/string :db/unique :db.unique/identity}
  {:db/ident :fixture/scope :db/valueType :db.type/ref}
  {:db/ident :fixture/rev :db/valueType :db.type/long}
  {:db/ident :conn/key :db/valueType :db.type/term :db/unique :db.unique/identity}]))
(defn kind [action] (try (action) nil (catch e (:kind (ex-data e)))))
(defn source [version eager-marker composed?]
 (str "(ns bridge.fixture (:require [proc.server :as proc] [reload.generation :as g] [datom :as d])) "
  "(def PROJECTION '" (pr-str P) ") "
  "(defn config-for [srv policy opts] "
  (when eager-marker (str "(File/write! " (pr-str eager-marker) " \"factory-ran\") "))
  "{:projection PROJECTION :level nil :watch? false "
  ":conn-fn (fn [_] (g/runtime-resource :mirror)) "
  ":scope-fn (fn [db _] (vec (d/q '[:find ?scope ?tenant :in $ ?tenant :where [?scope :fixture/tenant ?tenant]] db (:tenant opts)))) "
  ":apply (fn [row _] "
  " (let [control (g/runtime-resource :control)] "
  "  (SourceEffectObserverFixture/notify (:sink control) [:accepted (:ticket control) (erlang/self) (:tenant opts) " (pr-str version) " (:src-key row)]) "
  (when (= version :old)
    "  (let [expected-ticket (:ticket control)] (receive [:release ticket] :when (= ticket expected-ticket) :released (after 120000 (throw :fixture-release-timeout)))) ")
  "  {:target [(:tenant opts) " (pr-str version) "]})) "
  ":retire (fn [_ _] nil)}) "
  "(proc/defserver worker (reconcile {:server (:queue start-opts) :config-fn config-for :level nil}) "
  (when composed? "(handle-call :custom [_ st] (reply :custom st)) ") ") "
  "(defn start! [opts] (start worker opts)) "
  "(defn linked! [opts] (start-link worker opts)) "
  "(defn marker [] " (pr-str version) ")"))
(defn prepare [application version resources & [eager-marker composed?]]
 (g/prepare! {:application-id application :sources {"bridge.fixture" (source version eager-marker composed?)}
  :resources resources :native-modules #{"File" "erlang" "SourceEffectObserverFixture"}
  :stable-namespaces #{"proc.server" "proc.reconcile" "datom" "reload.generation" "proc.queue" "proc.queue-family" "proc.tick"}}))
(defn class-of [graph]
 (env/with-env (:scope graph)
  #(BeamLisp.Env/fetch_exact! (get (:mapping graph) "bridge.fixture") "worker")))
(defn canonical [graph] (get-in graph [:declarations :reconcile "bridge.fixture/worker" :data :canonical]))
(defn await [action]
 (let [deadline (+ (System/monotonic_time :millisecond) 10000)]
  (loop []
   (if (action) true
    (if (> (System/monotonic_time :millisecond) deadline) false
     (do (Process/sleep 10) (recur)))))))
(defn start-owner [graph queue tenant]
 (g/invoke! graph "bridge.fixture/start!" [{:queue queue :tenant tenant}]))
(defn add-source! [connection tenant revision]
 (let [db (d/db connection) scope (:db/id (d/entity db [:fixture/tenant tenant]))]
  (d/transact! connection [{:db/id -1 :conn/key [:bridge tenant "source"] :fixture/scope scope :fixture/rev revision}])
  scope))
(defn received [ticket expected-tenant expected-version]
 (receive
  [:accepted actual pid tenant version source-key]
   :when (= actual ticket)
    {:pid pid :tenant tenant :version version :source-key source-key
     :expected (and (= expected-tenant tenant) (= expected-version version))}
  (after 10000 nil)))

(deftest actual-compiler-seals-pure-residual-and-retains-unknown-contributions
 (let [app (str "canonical-proof-" (erlang/unique_integer (list :positive)))
       marker (str (System/get_env "HOME") "/tmp/product-online-20261014/" app "-eager")
       _ (when (File/exists? marker) (File/rm! marker))
       pure (prepare app :new {})
       effectful (prepare app :new {} marker)
       composed (prepare app :new {} nil true)]
  (try
   (is (= 1 (:version (canonical pure))))
   (is (= :empty-first-order (:snapshot-scope (canonical pure))))
   (is (= [] (:cell-keys (canonical pure))))
   (is (= (class-of pure) (:original-class (canonical pure))))
   (is (contains? (:server-classes pure) (class-of pure)))
   (is (erlang/is_function (get (:callables pure) (:reifier (canonical pure))) 4))
   (is (erlang/is_function (get (:callables pure) (:instance (canonical pure))) 2))
   (is (every? (set (:modules pure))
         (BeamLisp.Env/callback_modules (get (:callables pure) (:reifier (canonical pure))))))
   (is (nil? (canonical effectful)))
   (is (nil? (canonical composed)))
   (is (not (File/exists? marker)))
   ;; Actual sealed identity is mandatory; a forged descriptor cannot nominate
   ;; another family, class, factory or code as native runtime authority.
   (is (= :missing-sealed-reconcile-recipe
         (kind #(g/with! pure
                  (fn [] (declared/start-declared! (class-of pure) {} {}
                           {:version 1 :declaration "foreign/worker"} :start))))))
   (is (= :unsealed-reconcile-constructor
         (kind #(g/with! pure
                  (fn [] (declared/start-declared! (class-of pure) {} {}
                           {:version 1 :declaration "bridge.fixture/worker" :forged true} :start))))))
   (is (not (File/exists? marker)))
   (finally (doseq [graph [pure effectful composed]] (g/retire! graph))
            (when (File/exists? marker) (File/rm! marker))))))

(deftest canonical-first-order-start-handover-keeps-real-work-and-retires-old-graph
 (let [app (str "canonical-live-" (erlang/unique_integer (list :positive)))
       path (str (System/get_env "HOME") "/tmp/product-online-20261014/" app)
       resources {:data-root path :deployment-environment "production"
        :artifact-candidate (sha256-hex "actual-SDK-component-fixture")
        :managed-root-journal-id "journal" :managed-root-journal "journal.fjall"
        :managed-root-store-paths {"journal" "journal.fjall" "mirror" "mirror.fjall"}}
       a (prepare app :old resources) b (prepare app :new resources)
       journal (d/connect-with (fjall/open (str path "/journal.fjall")))
       mirror (d/connect-with (fjall/open (str path "/mirror.fjall")) SCHEMA)
       token (erlang/make_ref) slot (g/slot) pids (atom []) work (atom nil) plan (atom nil)
       qa (q/scoped-server app :a) qb (q/scoped-server app :b) stores (atom [])]
  (try
   (is (= :enrolled (root/enroll! a journal {"journal" journal "mirror" mirror})))
   (root/enter-initializer! a)
   (g/with! a #(g/bind-runtime! {:mirror mirror :control {:sink (erlang/self) :ticket token}}))
   (is (= :ready (root/ready! a)))
   (d/transact! mirror [{:db/id -1 :fixture/tenant "a"} {:db/id -2 :fixture/tenant "b"}])
   (let [pa (start-owner a :a "a") pb (start-owner a :b "b")]
    (reset! pids [pa pb]) (reset! stores [(q/conn qa) (q/conn qb)])
    (is (Process/alive? pa)) (is (Process/alive? pb))
    (is (not= pa pb))
    (is (= (tuple "proc.queue-runtime" "owner") (:declaration (framework/owner-evidence pa))))
    (is (= (tuple "proc.queue-runtime" "owner") (:declaration (framework/owner-evidence pb))))
    (is (= (:digest a) (:origin-generation (framework/owner-evidence pa))))
    (is (not= (get-in (q/conn qa) [:store :path]) (get-in (q/conn qb) [:store :path])))
    (is (= :shared-reconcile (:owner-mode (family/member-evidence app (name qa)))))
    (is (= :applied (:status (g/publish! slot nil a))))
    (add-source! mirror "a" 1)
    (g/with! a #(rec/pump! qa))
    (reset! work (received token "a" :old))
    (is (:expected @work))
    (is (= [:bridge "a" "source"] (:source-key @work)))
    (is (Process/alive? (:pid @work)))
    (is (= 1 (:running (q/stats qa))))
    (is (= 0 (:running (q/stats qb))))
    (is (= :inherited (root/inherit! b a)))
    (root/enter-initializer! b)
    (is (= :inherited (g/inherit-runtime! b a)))
    (root/ready! b)
    (reset! plan (g/with! b #(transition/prepare! {:previous-generation (:digest a)})))
    ;; No app :queues provider/coordinator. Real native instances contribute.
    (is (= #{qa qb} (set (keys (:queues @plan)))))
    (doseq [forged [(assoc (get-in @plan [:queues qa :handler]) :perform (fn [_] :forged))
                   (assoc-in (get-in @plan [:queues qa :handler]) [:reconcile :config :projection] {:ident :foreign/projection})
                   (assoc (get-in @plan [:queues qa :handler]) :contract {:accept? (fn [_] false)})]]
     (is (= :unsealed-reconcile-handler (:kind (runtime/rehearse! qa (:digest a) forged)))))
    (is (= (:digest a) (:generation (runtime/status qa))))
    (is (= :valid (:status (transition/validate! @plan {:limit 100 :ms 10000}))))
    (is (= :applied (:status (transition/activate! @plan))))
    (let [other (declared/prepare-existing! b "bridge.fixture/worker" (class-of b)
                  {:queue :a :tenant "foreign"} qa)]
     (try
      (is (= :identity-conflict (:kind (runtime/activate! qa (:digest a) other))))
      (is (= (:digest b) (:generation (runtime/status qa))))
      (finally (runtime/discard-prepared-handler! other))))
    (is (= :applied (:status (family/with-current-publication-fence! b #(g/publish! slot (:digest a) b)))))
    (is (= pa (Process/whereis (q/op-name qa))))
    (is (= pb (Process/whereis (q/op-name qb))))
    (is (= (:digest b) (:generation (runtime/status qa))))
    (is (= "passed" (get (family/public-plan (family/plan! b)) "state")))
    (is (= 0 (:serving-slots (g/evidence a))))
    (is (= :waiting (:status (transition/retire! @plan))))
    (is (= :waiting (:status (g/retire! a))))
    ;; This exact accepted old callback continues after new Source publication.
    (erlang/send (:pid @work) [:release token])
    (is (await #(= 1 (:done (q/stats qa)))))
    (is (await #(= :retired (:status (transition/retire! @plan)))))
    (is (await #(contains? #{:retired :already-retired} (:status (g/retire! a)))))
    (is (:retired (g/evidence a)))
    (is (Process/alive? pa)) (is (Process/alive? pb))
    (is (= :new (g/call! slot "bridge.fixture/marker" [])))
    (add-source! mirror "b" 1)
    (g/with! b #(rec/pump! qb))
    (let [new (received token "b" :new)]
     (is (:expected new))
     (is (= [:bridge "b" "source"] (:source-key new))))
    (is (await #(= 1 (:done (q/stats qb)))))
    (is (= ["a" :old] (:proj/target (pj/record P (d/db mirror) "a" [:bridge "a" "source"]))))
    (is (= ["b" :new] (:proj/target (pj/record P (d/db mirror) "b" [:bridge "b" "source"]))))
    (is (= 1 (:done (q/stats qa))))
    (is (= :invalid-reconcile-payload
          (kind #(g/with! b (fn [] (q/enqueue! qb {:wrong :message}))))))
    (is (= 1 (:done (q/stats qb)))))
   (finally
    (when (:pid @work) (erlang/send (:pid @work) [:release token]))
    (when @plan (transition/close! @plan))
    (doseq [pid @pids] (when (Process/alive? pid) (GenServer/stop pid)))
    (g/close! slot (g/selected slot))
    (g/retire! a) (g/retire! b)
    (doseq [store @stores] (d/close! store))
    (d/close! mirror) (d/close! journal)))))

(deftest native-resource-constructor-arguments-preserve-existing-embedded-semantics
 (let [app (str "canonical-opaque-" (erlang/unique_integer (list :positive)))
       graph (prepare app :new {}) mirror (d/connect SCHEMA) pid (atom nil)]
  (try
   (g/with! graph #(g/bind-runtime! {:mirror mirror :control {:sink (erlang/self) :ticket (erlang/make_ref)}}))
   (reset! pid (g/invoke! graph "bridge.fixture/start!" [{:queue :opaque :tenant "none" :conn mirror}]))
   (is (Process/alive? @pid))
   (is (nil? (framework/owner-evidence @pid)))
   (is (= (class-of graph) (:module (g/owner-evidence @pid))))
   (is (= :embedded-reconcile
          (:owner-mode (family/member-evidence app (q/server-name (q/scoped-server app :opaque))))))
   (is (not (runtime/ready? (q/scoped-server app :opaque))))
   (is (= :waiting (:status (g/retire! graph))))
   (finally (when (and @pid (Process/alive? @pid)) (GenServer/stop @pid))
            (g/retire! graph) (d/close! mirror)))))

(deftest real-owner-down-and-startup-refusal-release-only-pure-handler-bookkeeping
 (let [app (str "canonical-disposal-" (erlang/unique_integer (list :positive)))
       graph (prepare app :new {}) mirror (d/connect SCHEMA)
       srv (q/scoped-server app :disposal) pid (atom nil) connection (atom nil)]
  (try
   (g/with! graph #(g/bind-runtime! {:mirror mirror :control {:sink (erlang/self) :ticket (erlang/make_ref)}}))
   (reset! pid (start-owner graph :disposal "none"))
   (reset! connection (q/conn srv))
   (is (= (tuple "proc.queue-runtime" "owner") (:declaration (framework/owner-evidence @pid))))
   (is (= 1 (:issued (handler/diagnostic-counts graph))))
   (is (= 1 (:resources (handler/diagnostic-counts graph))))
   (is (= :waiting (:status (g/retire! graph))))
   ;; This exact owned actor is idle: no domain rows/provider work exists. Kill
   ;; skips terminate, so only the actual native/lifetime DOWN path can clean.
   (let [expected-pid @pid monitor (Process/monitor expected-pid)]
    (try
     (Process/exit @pid :kill)
     (is (receive [:DOWN ref :process dead _] :when (and (= monitor ref) (= dead expected-pid)) true
                  (after 10000 false)))
     (finally (Process/demonitor monitor (list :flush)))))
   (is (await #(zero? (:issued (handler/diagnostic-counts graph)))))
   (is (await #(zero? (:resources (handler/diagnostic-counts graph)))))
   ;; Genuine persisted native queue metadata is deliberately incompatible.
   ;; The same exact graph may construct only pure recipe bookkeeping before
   ;; rejecting this startup; no factory/provider callback is replayed.
   (let [foreign (assoc (q/declaration srv) :generation (sha256-hex "foreign-native-generation"))]
    (d/transact! @connection [{:db/id -1 :queue/key (q/server-name srv) :queue/decl foreign}])
    (is (try (start-owner graph :disposal "none") false (catch _ true)))
    (is (await #(zero? (:issued (handler/diagnostic-counts graph)))))
    (is (await #(zero? (:resources (handler/diagnostic-counts graph)))))
    (is (= (:generation foreign) (:generation (q/declaration srv)))))
   (is (await #(contains? #{:retired :already-retired} (:status (g/retire! graph)))))
   (finally
    (when (and @pid (Process/alive? @pid)) (GenServer/stop @pid))
    (g/retire! graph)
    (when @connection (d/close! @connection))
    (d/close! mirror)))))
