(ns proc.input-guard-test
 (:require [proc.input-domain :as inputs] [reload.server-entry :as entry]
           [data.first-order :as data]))
(defn- compiled-proof [guard body]
 (BeamLisp.Compiler/reset_fresh!)
 (let [source (str "(defserver sample (init [parent] (ok parent))"
                  " (handle-call [:run n] [_ parent] :when " guard " " body "))")
       form (first (BeamLisp.Reader/read_string source))
       compiled (BeamLisp.Compiler/compile form
                   (BeamLisp.Compiler/new_env "compiler.input.guard.fixture"))
       descriptor (:val (first (:args (first (:stmts compiled)))))
       clause (first (filter #(= :handle_call (:fname %)) (:clauses descriptor)))
       ;; This is the same ordinary bounded metadata step prepare-inputs! runs
       ;; before analyzing an actual checked descriptor; it is not a warmup or
       ;; SDK ownership receipt, and invokes neither actor init nor handler.
       _ (data/check! (select-keys clause [:params :guard])
                       {:max-nodes 16384 :max-depth 64 :max-bytes 262144})
       projected (entry/input-body (:name descriptor) clause)]
  {:descriptor descriptor :clause clause :projected projected
   :proof (inputs/clause descriptor (assoc clause :body (:body projected))
                         (inputs/context []))}))
(defn- numeric-body []
 "(do (erlang/send parent :input-guard-not-executed) (reply (erlang/+ n 1) parent))")
(deftest actual-compiled-and-guard-proves-both-required-argument-domains
 (let [row (compiled-proof "(and (number? n) (pid? parent))" (numeric-body))
       guard (:guard (:clause row)) proof (:proof row)]
  (is (= :if (:op guard)))
  (is (= :lit (:op (:else guard))))
  (is (erlang/== false (:val (:else guard))))
  (is (= :proved (:status proof)))
  (is (= true (:covered proof)))
  (is (= #{:number :pid} (set (vals (:requirements proof)))))
  (is (not (erlang/module_loaded (:name (:descriptor row)))))))
(deftest actual-nested-conjunction-and-other-branches-keep-conservative-coverage
 (doseq [[guard covered]
         [["(and (number? n) (and (pid? parent) (int? n)))" true]
          ["(or (number? n) (pid? parent))" false]
          ["(some? n)" false]
          ["(or false (and (number? n) (pid? parent)))" false]]]
  (let [proof (:proof (compiled-proof guard (numeric-body)))]
   (is (= :proved (:status proof)))
   (is (= covered (:covered proof))))))
(deftest actual-latent-and-unknown-effects-are-not-domain-proofs
 (doseq [[body reason]
         [["(reply (fn [x] x) parent)" :unsupported-input-ir]
          ["(do (erlang/process_flag :trap_exit true) (reply n parent))" :unknown-input-operation]]]
  (let [proof (:proof (compiled-proof "(and (number? n) (pid? parent))" body))]
   (is (= :unknown (:status proof)))
   (is (= reason (:reason proof)))))
 (is (= :refused
        (try (compiled-proof "(erlang/send parent :input-guard-not-executed)" "(reply n parent)")
             :accepted
         (catch error
          (if (and (erlang/is_map error)
                   (erlang/== :Elixir.BeamLisp.CompileError (Map/get error :__struct__))
                   (String/contains? (ex-message error) "erlang/send")
                   (String/contains? (ex-message error) "not allowed in a guard"))
           :refused :unexpected-failure)))))
 (is (= :quiet (receive :input-guard-not-executed :effect (after 0 :quiet)))))
