(ns proc.evolve-request-contract-test (:require [proc.evolve :as evolve]))
(defn base [calls]
 {:version 1 :digest "strict-old" :accept? (fn [m] (and (vector? m) (= 2 (count m)) (= :add (first m)) (int? (second m))))
  :check-state int? :check-reply int?
  :handler (fn [m s] (swap! calls inc) {:state (+ s (second m)) :reply (+ s (second m))})})
(defn next [calls conversions]
 {:version 2 :digest "strict-new" :accept? (fn [m] (and (map? m) (int? (:amount m)) (>= (:amount m) 0)))
  :check-state int? :check-reply int? :migrate-state identity :downcast identity
  :upcast (fn [m] (swap! conversions inc) {:amount (second m)})
  :handler (fn [m s] (swap! calls inc) {:state (+ s (:amount m)) :reply (+ s (:amount m))})})
(deftest malformed-old-requests-refuse-before-adapter-or-handler-effects
 (let [calls (atom 0) conversions (atom 0) p (evolve/start! (base calls) 0 {:managed true})
       client (:token (evolve/acquire-client! p 1))]
  (try
   (is (= :applied (:status (evolve/upgrade! p 1 (next calls conversions)))))
   (let [before (evolve/status p)]
    (doseq [message [[:add 4 :extra] [:other 4] [:add "4"]]]
     (is (= :invalid-message (:kind (evolve/request! p 1 message))))
     (is (= :invalid-message (:kind (evolve/call-client! p client message)))))
    (is (= before (evolve/status p)))
    (is (= 0 @calls))
    (is (= 0 @conversions)))
   (is (= 4 (evolve/request! p 1 [:add 4])))
   (is (= 1 @calls))
   (is (= 1 @conversions))
   (evolve/release-client! p client)
   (is (= :retired (:status (evolve/retire! p 2 1))))
   (is (= 5 (evolve/request! p 2 {:amount 1})))
   (finally (GenServer/stop p)))))

(deftest every-intermediate-protocol-is-checked-on-a-multi-hop-conversion
 (let [calls (atom 0) first-edge (atom 0) last-edge (atom 0)
       p (evolve/start! (base calls) 0)
       third (assoc (next calls first-edge) :version 3 :digest "looser-current"
                    :accept? (fn [m] (and (map? m) (int? (:amount m))))
                    :upcast (fn [m] (swap! last-edge inc) m))]
  (try
   (evolve/upgrade! p 1 (next calls first-edge))
   (evolve/upgrade! p 2 third)
   ;; Valid v1, invalid v2, and valid v3. The v2 boundary must still refuse.
   (is (= :invalid-message (:kind (evolve/call! p 1 [:add -1]))))
   (is (= 1 @first-edge))
   (is (= 0 @last-edge))
   (is (= 0 @calls))
   (is (= :refused (:status (evolve/prepare-upgrade! p 3
             (assoc third :version 4 :digest "next" :upcast identity) [{:version 1 :message [:add 1 :extra]}]))))
   (is (= 1 @first-edge))
   (is (= 0 @last-edge))
   (is (= 2 (evolve/call! p 1 [:add 2])))
   (is (= 1 @last-edge))
   (finally (GenServer/stop p)))))
