; Actual native owner + independent real Veritas HTTP. Domain publication is
; deliberately absent until AFTER completion/release; no synthetic done row.
(ns proc.capacity-completion-test
 (:require [proc.capacity :as cap] [proc.queue :as q] [proc.queue-runtime :as runtime]
           [datom :as d] [datom.conn :as dc] [datom.store :as ds]
           [datom.store-fjall :as fjall] [veritas.model :as vm]))
(defn await! [predicate]
 (let [deadline (+ (erlang/monotonic_time :millisecond) 10000)]
  (loop [] (when-not (predicate)
   (when (>= (erlang/monotonic_time :millisecond) deadline)
    (throw (ex-info "Original capacity completion did not settle" {:kind :fixture-timeout})))
   (Process/sleep 2) (recur)))))
(deftest completion-and-release-before-final-bind-recover-original-receipt-without-another-http-effect
 (let [suffix (String/downcase (Base/encode16 (crypto/strong_rand_bytes 8)))
       c (dc/connect-with (fjall/open (ds/fresh-path ".capacity-completion.fjall")) [])
       queue-c (dc/connect-with (fjall/open (ds/fresh-path ".capacity-completion-queue.fjall")) [])
       authority (cap/attach-store! (str "test.completion." suffix) c
                    {:max-outstanding 1 :scopes [{:keys [:property :provider] :max 1}]})
       srv (q/scoped-server (str "test.capacity-completion." suffix) :work)
       provider (vm/serve (vm/model "One accepted effect before original domain publication"
                 {:state {:accepted 0} :commands
                  {:create {:request [:post "/effects"] :next (fn [s _] (update s :accepted inc))
                            :response (fn [_ _] {:body {"id" "effect-1"}})}}}))
       _ (q/attach-store! srv queue-c)
       handler (runtime/prepare srv
         {:declaration {:of :test/completion :generation "completion-v1" :concurrency 1 :max-live-workers 1 :lease 60 :unique [:work/id]}
          :clock (fn [] 1000)
          :perform (fn [job]
            (cap/authorize! authority job)
            (case (:status (q/begin-effect! srv job :provider))
             :submit (let [result (vm/request provider :post "/effects" {"fixture" true})]
                       (assert (= "effect-1" (get-in result [:body "id"])))
                       (q/record-effect! srv job :provider :complete {:provider-id (get-in result [:body "id"])})
                       {:provider-id "effect-1"})
             (throw (ex-info "No second provider submission is allowed" {}))))})
       payload {:work/id "original"} opts {:enrollment-key [:original "domain-publication"] :generation "completion-v1" :at 1000}
       capture {:property "hotel:completion" :provider :meta}]
  (try
   (runtime/start! handler {})
   ;; Phased native admission is the REAL enroll! protocol. Cut before its
   ;; final bind; worker authorize! records the original binding before IO.
   (let [reserved (cap/reserve! authority srv payload opts capture)
         key (:reservation reserved)
         original (q/enqueue! srv payload (assoc opts :capacity-proof (cap/proof authority key)))]
    (await! #(and (= :done (:job/state (d/entity (d/db queue-c) (:db/id original))))
                  (= {:status :known :live 0} (runtime/body-status srv (:job/id original)))))
    (is (= 1 (:accepted ((:state provider)))))
    (is (= {:released 1} (:states (do (cap/repair! authority 10) (cap/status authority)))))
    (let [before-job (d/entity (d/db queue-c) (:db/id original))
          before-reservation (d/entity (d/db c) [:capacity.reservation/key key])]
     (doseq [answer [(cap/bind! authority srv key original)
                    (cap/enroll! authority srv payload opts capture)
                    (cap/enroll! authority srv payload opts capture)]]
      (is (= :existing (:status answer))) (is (:released? answer))
      (is (= (:job/id original) (get-in answer [:job :job/id])))
      (is (= :done (get-in answer [:job :job/state])))
      (is (= {:provider-id "effect-1"} (get-in answer [:job :job/result]))))
     (is (= before-job (d/entity (d/db queue-c) (:db/id original))))
     (is (= before-reservation (d/entity (d/db c) [:capacity.reservation/key key])))
     (is (= 1 (:job/attempts before-job)))
     (is (= :complete (get-in before-job [:job/effects :provider :state])))
     (is (= 1 (count (filter #(= :post (:method %)) ((:log provider))))))
     (is (= 1 (:accepted ((:state provider)))))))
   (finally
    (runtime/stop! srv {:workers :stop})
    (dc/close! queue-c) (dc/close! c) ((:stop provider))))))
