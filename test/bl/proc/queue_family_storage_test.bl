; Actual native generated classes, Fjall stores and private compiler contributions.
; HOME draft: no native result is claimed. Fault cases intentionally retain
; unknown accepted allocation custody until the isolated fixture VM exits.
(ns proc.queue-family-storage-test
 (:require [proc.queue :as queue] [proc.queue-family :as family]
           [proc.queue-family-root :as root] [proc.queue-family-storage :as storage]
           [reload.generation :as g] [datom :as d] [datom.conn :as conn]
           [datom.store :as store] [datom.store-fjall :as fjall]))
(defn kind [action] (try (action) nil (catch error (:kind (ex-data error)))))
(defn error-text [action] (try (action) "unexpected success" (catch error (str error))))
(defn directory []
 (let [p (str (System/get_env "HOME") "/tmp/queue-family-storage-" (erlang/unique_integer (list :positive)))]
  (File/mkdir_p! p) p))
(defn source [marker]
 (str "(ns storage.fixture (:require [proc.server :as server] [proc.queue :as q] "
      "[proc.queue-family :as family] [proc.queue-family-storage :as storage] [reload.generation :as g])) "
      "(defn config-for [srv policy opts] (File/write! " (pr-str marker) " \"factory\\n\" (list :append)) "
      " {:projection {:ident :storage/projection} :conn-fn (fn [_] (:conn opts)) "
      "  :scope-fn (fn [_ _] []) :apply (fn [_ _] nil) :level nil}) "
      "(defn normalized [] (q/normalise-decl {:of :proj/job :unique [:proj/key :proj/rev] :partition [:proj/scope]})) "
      "(defn server-key [opts] "
      " (Process/put :saved-queue-init-gate (Process/get :bl_server_init_gate)) "
      " (let [srv (q/server-name (:queue opts))] "
      "  (when (:hold opts) "
      "   (family/register! srv \"storage.fixture/worker\" (normalized)) "
      "   (let [ticket (storage/provision! (g/current) srv)] "
      "    (q/attach-store! srv (:connection ticket)) "
      "    (when (= :after-result (:hold opts)) (storage/attached! (g/current) srv ticket)) "
      "    (erlang/send (:parent opts) [:allocation-held (:notice opts) (erlang/self) (:hold opts)]) "
      "    (receive :release-allocation nil))) srv)) "
      "(server/defserver worker (reconcile {:server (server-key start-opts) :config-fn config-for :level nil}) "
      " (handle-call :late-provision [_ st] (reply "
      "  (try (storage/provision! (g/current) (q/server-name (:server (:queue st)))) :wrong "
      "   (catch error (:kind (ex-data error)))) st)) "
      " (handle-call :restored-gate [_ st] "
      "  (reply (let [before (Process/get :bl_server_init_gate)] "
      "    (try (Process/put :bl_server_init_gate (Process/get :saved-queue-init-gate)) "
      "     (storage/provision! (g/current) (q/server-name (:server (:queue st)))) :wrong "
      "     (catch error (:kind (ex-data error))) (finally (Process/put :bl_server_init_gate before)))) st))) "
      "(defn start! [opts] (start worker opts))"))
(defn graph [app path marker resources]
 (g/prepare! {:application-id app :sources {"storage.fixture" (source marker)}
  :stable-namespaces #{"proc.server" "proc.reconcile" "proc.queue" "proc.queue-family" "proc.queue-family-storage" "reload.generation"}
  :native-modules #{"File"}
  :resources (merge {:data-root path :managed-root-journal "journal.fjall"
                    :managed-root-journal-id "journal"
                    :managed-root-store-paths {"journal" "journal.fjall" "mirror" "mirror.fjall"}
                    :deployment-environment "production"} resources)}))
(defn open-stores [path]
 {"journal" (d/connect-with (fjall/open (str path "/journal.fjall")))
  "mirror" (d/connect-with (fjall/open (str path "/mirror.fjall")))})
(defn ready! [graph stores]
 (root/enroll! graph (get stores "journal") stores)
 (root/enter-initializer! graph)
 (g/with! graph #(g/bind-runtime! {}))
 (root/ready! graph))
(defn start! [graph srv mirror]
 (g/invoke! graph "storage.fixture/start!" [{:queue srv :conn mirror}]))
(defn path-for [graph srv]
 (family/storage-path graph "storage.fixture/worker" (name (queue/scoped-server (:application-id graph) srv))))
(defn records [journal]
 (vec (map (fn [[row]] row) (d/q '[:find ?r :where [_ :queue-family/record ?r]] (d/db journal)))))
(defn stopped! [pid]
 (let [m (Process/monitor pid)]
  (when (Process/alive? pid) (GenServer/stop pid :normal 10000))
  (receive [:DOWN ref :process seen _] :when (and (= m ref) (= seen pid)) true (after 10000 false))))
(defn close-stores! [stores] (doseq [[_ c] stores] (d/close! c)))

(deftest actual-two-tenant-families-provision-dedicated-native-durable-stores
 (let [path (directory) marker (str path "/factory.log") app (str "family-two-" (erlang/unique_integer (list :positive)))
       graph (graph app path marker {}) stores (open-stores path) actors (atom []) queues (atom [])]
  (try
   (is (= :ready (ready! graph stores)))
   (doseq [srv [:tenant-a :tenant-b]]
    (let [pid (start! graph srv (get stores "mirror")) c (g/with! graph #(queue/conn srv))]
     (swap! actors conj pid) (swap! queues conj c)
     (is (Process/alive? pid))
     (is (= (path-for graph srv) (get-in c [:store :path])))
     (is (store/durable? (:store c)))
     (is (= app (get-in (conn/creation-evidence! c) [:creator :application-id])))
     (is (= :queue-family-generated-store-owner-required (GenServer/call pid :late-provision)))
     (is (= :queue-family-generated-store-owner-required (GenServer/call pid :restored-gate)))))
   (is (not= (:store (first @queues)) (:store (second @queues))))
   (is (= 2 (count (records (get stores "journal")))))
   (is (= #{:attached} (set (map :state (records (get stores "journal"))))))
   (is (= #{(name (queue/scoped-server app :tenant-a)) (name (queue/scoped-server app :tenant-b))}
           (set (map :instance (records (get stores "journal"))))))
   (is (= 2 (count (String/split (String/trim (File/read! marker)) "\n"))))
   (finally
    (doseq [pid @actors] (stopped! pid))
    (doseq [c @queues] (d/close! c))
    (g/retire! graph) (close-stores! stores) (File/rm_rf! path)))))

(deftest absent-native-root-refuses-before-store-allocation-and-before-factory
 (let [path (directory) marker (str path "/factory.log")
       graph (graph (str "family-no-root-" (erlang/unique_integer (list :positive))) path marker {})
       stores (open-stores path)]
  (try
   (is (String/contains? (error-text #(start! graph :tenant-a (get stores "mirror"))) "queue-root-stale-custody"))
   (is (not (File/exists? (path-for graph :tenant-a))))
   (is (not (File/exists? marker)))
   (is (= :ready (:state (conn/writer-observation (get stores "journal")))))
   (finally (g/retire! graph) (close-stores! stores) (File/rm_rf! path)))))

(deftest concurrent-first-start-keeps-exactly-one-physical-store-and-factory-turn
 (let [path (directory) marker (str path "/factory.log") app (str "family-race-" (erlang/unique_integer (list :positive)))
       graph (graph app path marker {}) stores (open-stores path) parent (erlang/self) ids [(erlang/make_ref) (erlang/make_ref)]
       first-id (first ids) second-id (second ids)
       _ (ready! graph stores)
       starters (mapv (fn [id] (spawn (fn [] (receive :start
                   (erlang/send parent [:started id (try {:pid (start! graph :same (get stores "mirror"))}
                                                    (catch error {:refused true}))]))))) ids)
       owned (atom nil) connection (atom nil)]
  (try
   (doseq [pid starters] (erlang/send pid :start))
   (let [a (receive [:started id value] :when (or (= first-id id) (= second-id id)) value (after 20000 :timeout))
         b (receive [:started id value] :when (or (= first-id id) (= second-id id)) value (after 20000 :timeout))
         results [a b] pids (vec (keep :pid results))]
    (is (= 1 (count pids))) (is (= 1 (count (filter :refused results))))
    (reset! owned (first pids))
    (reset! connection (g/with! graph #(queue/conn :same)))
    (is (= (path-for graph :same) (get-in @connection [:store :path])))
    (is (= 1 (count (records (get stores "journal")))))
    (is (= 1 (count (String/split (String/trim (File/read! marker)) "\n")))))
   (finally
    (when @owned (stopped! @owned))
    (when @connection (d/close! @connection))
    (g/retire! graph) (close-stores! stores) (File/rm_rf! path)))))

(deftest attached-store-closed-in-the-same-vm-is-not-an-implicit-reopen-authority
 (let [path (directory) marker (str path "/factory.log") app (str "family-lifetime-" (erlang/unique_integer (list :positive)))
       graph (graph app path marker {}) stores (open-stores path) _ (ready! graph stores)
       actor (start! graph :same (get stores "mirror")) c (g/with! graph #(queue/conn :same))]
  (try
   (is (stopped! actor))
   (d/close! c) (File/rm! marker)
   (is (String/contains? (error-text #(start! graph :same (get stores "mirror"))) "queue-family-store-lifetime-ended"))
   (is (not (File/exists? marker)))
   (is (= :attached (:state (first (records (get stores "journal"))))))
   (is (= :closed @(:lifetime c)))
   (finally (g/retire! graph) (close-stores! stores) (File/rm_rf! path)))))

; Both fault points acknowledge the exact actual actor after actual native
; allocation/attachment, never a timer/poll. The deliberate actor kill is only
; an isolated fixture fault. A dead constructor is NOT a cleanup/retry grant.
(deftest actual-allocation-result-before-ack-and-actor-death-preserve-custody
 (doseq [point [:before-result :after-result]]
  (let [path (directory) marker (str path "/factory.log") app (str "family-fault-" (erlang/unique_integer (list :positive)))
        graph (graph app path marker {}) stores (open-stores path) _ (ready! graph stores)
        parent (erlang/self) notice (erlang/make_ref)
        starter (spawn (fn [] (try (g/invoke! graph "storage.fixture/start!"
                    [{:queue :held :conn (get stores "mirror") :hold point :parent parent :notice notice}])
                    (catch _ nil))
                    (erlang/send parent [:starter-returned notice])))
        held (receive [:allocation-held id pid seen] :when (and (= id notice) (= seen point)) pid (after 20000 nil))]
   (is (erlang/is_pid held))
   (is (= app (:application-id (g/owner-evidence held))))
   (is (= (:digest graph) (:generation (g/owner-evidence held))))
   (let [before (first (records (get stores "journal")))
         c (g/with! graph #(queue/conn :held)) monitor (Process/monitor held)]
    (is (= (if (= point :after-result) :attached :opening) (:state before)))
    (is (= (path-for graph :held) (get-in c [:store :path])))
    (is (not (File/exists? marker)))
    (erlang/exit held :kill)
    (is (receive [:DOWN ref :process pid _] :when (and (= ref monitor) (= pid held)) true (after 10000 false)))
    (is (receive [:starter-returned id] :when (= id notice) true (after 10000 false)))
    (is (= :ready (:state (conn/writer-observation c))))
    (if (= point :before-result)
     (do
      (is (String/contains? (error-text #(start! graph :held (get stores "mirror"))) "queue-family-allocation-outcome-uncertain"))
      (is (= :queue-family-allocation-outcome-uncertain (:reason (g/retire! graph))))
      (is (not (File/exists? marker))))
     ;; A completed allocation result is not evidence that its opaque app
     ;; constructor ran. The exact attached store remains recoverable, but this
     ;; batch makes no provider/config reconstruction or graph-retirement claim.
     (is (= :attached (:state (first (records (get stores "journal")))))))
    (is (= before (first (records (get stores "journal")))))
    (is (= :ready (:state (conn/writer-observation (get stores "journal"))))))
   ;; Intentionally retained until the isolated fixture VM is actually DOWN.
   ;; No test timeout/actor death closes these accepted allocation resources.
   )))

(deftest existing-queue-directory-alias-refuses-before-native-open-and-factory
 (let [path (directory) outside (directory) marker (str path "/factory.log")
       graph (graph (str "family-queue-alias-" (erlang/unique_integer (list :positive))) path marker {})
       stores (open-stores path)]
  (try
   (is (= :ready (ready! graph stores)))
   (File/ln_s! outside (str path "/queues"))
   (is (String/contains? (error-text #(start! graph :alias (get stores "mirror"))) "queue-family-noncanonical-directory"))
   (is (empty? (File/ls! outside)))
   (is (not (File/exists? marker)))
   (is (= :ready (:state (conn/writer-observation (get stores "journal")))))
   (finally (g/retire! graph) (close-stores! stores) (File/rm_rf! path) (File/rm_rf! outside)))))
