; Genuine native generated family init + actual Root/Fjall integration.
; HOME UNRUN. Opt-in policy retained deliberately; isolated final VM only.
(ns proc.queue-allocation-bridge-test
 (:require [proc.queue :as queue] [proc.queue-family :as family]
           [proc.queue-family-root :as root] [proc.queue-family-storage :as storage]
           [test.support.dynamic-policy :as fixture] [datom.migration-admission :as migration]
           [reload.generation :as g] [datom :as d] [datom.conn :as conn] [datom.store-fjall :as fjall]))
(defn graph [path app marker]
 (g/prepare! {:application-id app
  :sources {"bridge.fixture"
   (str "(ns bridge.fixture (:require [proc.server :as server] [proc.queue :as q] "
        " [proc.queue-family-storage :as storage] [reload.generation :as g])) "
        "(defn config-for [srv policy opts] (File/write! " (pr-str marker) " \"factory\") "
        " {:projection {:ident :bridge/projection} :conn-fn (fn [_] (:conn opts)) "
        "  :scope-fn (fn [_ _] []) :apply (fn [_ _] nil) :level nil}) "
        "(server/defserver worker (reconcile {:server (q/server-name (:queue start-opts)) :config-fn config-for :level nil}) "
        " (handle-call [:late path] [_ st] (reply "
        "  (try (storage/provision! (g/current) (q/server-name (:server (:queue st)))) :wrong (catch error (:kind (ex-data error)))) st))) "
        "(defn start! [opts] (start worker opts))")}
  :stable-namespaces #{"proc.server" "proc.reconcile" "proc.queue" "proc.queue-family" "proc.tick" "proc.queue-family-storage" "reload.generation"}
  :native-modules #{"File"}
  :resources {:data-root path :managed-root-journal "journal.fjall" :managed-root-journal-id "journal"
              :managed-root-store-paths {"journal" "journal.fjall" "mirror" "mirror.fjall"}
              :deployment-environment "sandbox" :dynamic-store-policy (fixture/policy-plan)}}))
(defn stopped! [pid]
 (let [m (Process/monitor pid)]
  (when (Process/alive? pid) (GenServer/stop pid :normal 10000))
  (receive [:DOWN ref :process seen _] :when (and (= m ref) (= seen pid)) true (after 10000 false))))
(deftest actual-native-queue-allocation-is-bound-once-and-remains-in-policy-inventory
 (let [path (fixture/directory) marker (str path "/factory.log")
       app (str "queue-bridge-" (erlang/unique_integer (list :positive))) candidate (graph path app marker)
       journal (d/connect-with (fjall/open (str path "/journal.fjall")))
       mirror (d/connect-with (fjall/open (str path "/mirror.fjall")))
       stores {"journal" journal "mirror" mirror}]
  (is (= :enrolled (root/enroll! candidate journal stores)))
  (is (= :entered (root/enter-initializer! candidate)))
  (g/with! candidate #(g/bind-runtime! {}))
  (is (= :ready (root/ready! candidate)))
  (is (= :installed (:status (g/with! candidate migration/install!))))
  (let [pid (g/invoke! candidate "bridge.fixture/start!" [{:queue :tenant-a :conn mirror}])
        connection (g/with! candidate #(queue/conn :tenant-a))
        actual-path (get-in connection [:store :path])]
   (is (Process/alive? pid))
   (is (File/exists? marker))
   (is (= app (get-in (conn/creation-evidence! connection) [:creator :application-id])))
   (is (= 3 (count (g/with! candidate #(conn/owned-connections app path (vec (vals stores)))))))
   (is (= 0 (:stores (fixture/status candidate))))
   (is (= 0 (:pending-openings (fixture/status candidate))))
   (is (= :expanded (:status (g/with! candidate migration/expand!))))
   (is (= :queue-family-generated-store-owner-required (GenServer/call pid [:late actual-path])))
   (is (= :migration-managed-open-required (fixture/kind #(g/with! candidate (fn [] (fjall/open actual-path))))))
   (is (stopped! pid))
   ;; Actual role does not vanish because its owner died. It still contributes
   ;; to inventory, and a stale native owner prevents publication/expansion.
   (is (= 3 (count (g/with! candidate #(conn/owned-connections app path (vec (vals stores)))))))
   (is (= :migration-queue-role-unconfirmed (fixture/kind #(g/with! candidate migration/expand!)))))))
(deftest private-selector-copy-has-no-role-or-allocation-authority
 (let [path (fixture/directory) marker (str path "/factory.log")
       app (str "queue-fake-" (erlang/unique_integer (list :positive))) candidate (graph path app marker)
       journal (d/connect-with (fjall/open (str path "/journal.fjall")))
       mirror (d/connect-with (fjall/open (str path "/mirror.fjall")))
       fake-path (str path "/queues/fake") previous (Process/get :proc.queue-family/allocation)]
  (root/enroll! candidate journal {"journal" journal "mirror" mirror})
  (root/enter-initializer! candidate) (g/with! candidate #(g/bind-runtime! {})) (root/ready! candidate)
  (is (= :installed (:status (g/with! candidate migration/install!))))
  (try
   (Process/put :proc.queue-family/allocation {:key [app "fake"] :ticket (erlang/make_ref)})
   (is (= :queue-family-generated-store-owner-required
          (fixture/kind #(g/with! candidate (fn [] (fjall/open fake-path))))))
   (is (not (File/exists? fake-path)))
   (is (not (File/exists? marker)))
   (is (= 0 (:pending-openings (fixture/status candidate))))
   (finally (if previous (Process/put :proc.queue-family/allocation previous)
              (Process/delete :proc.queue-family/allocation))))))
