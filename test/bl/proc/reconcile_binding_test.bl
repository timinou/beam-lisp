(ns proc.reconcile-binding-test
 (:require [proc.reconcile :as rec] [proc.queue :as q] [reload.generation :as g]))

(defn- kind [action] (try (action) nil (catch e (:kind (ex-data e)))))

(defn- overloaded-factory
 ([srv policy] {:arity 2 :server srv :policy policy})
 ([srv policy start-opts] {:arity 3 :server srv :policy policy :start start-opts}))

(deftest named-factories-receive-start-context-without-a-custom-clause
 (is (= [:owner {:level nil}]
        (rec/call-config-factory (fn [srv policy] [srv policy]) :owner {:level nil} {:firm 1})))
 (is (= [:owner {:level nil} {:firm 1}]
        (rec/call-config-factory (fn [srv policy opts] [srv policy opts])
                                :owner {:level nil} {:firm 1})))
 (is (= {:arity 3 :server :owner :policy {} :start {:firm 1}}
        (rec/call-config-factory overloaded-factory :owner {} {:firm 1})))
 (is (= :invalid-reconcile-factory
        (kind #(rec/call-config-factory (fn [_] :wrong) :owner {} {})))))

(deftest dynamic-owner-binding-uses-the-standard-reconcile-clause
 (let [clause (rec/reconcile-clause
                '(reconcile {:server (server-key start-opts) :config-fn config-for
                             :level [10 :minutes] :limit 50 :watch? true})
                {:name 'runtime})
       prelude (pr-str (:prelude clause)) init (pr-str (:init clause))]
  (is (String/contains? prelude "config-for"))
  (is (String/contains? prelude "server-key"))
  (is (String/contains? prelude "start-opts"))
  (is (String/contains? prelude ":limit 50"))
  (is (String/contains? prelude ":watch? true"))
  (is (String/contains? init "bound-server"))
  (is (not (String/contains? init "start-opts")))
  (is (not (String/contains? (pr-str (:clauses clause)) "start-opts")))
  (is (String/contains? (pr-str (:clauses clause)) "reconcile-pump"))))

(deftest runtime-factory-mode-is-explicit-and-unambiguous
 (is (= :invalid-reconcile-factory
        (kind #(rec/reconcile-clause '(reconcile {:config-fn (fn [_ _] {})}) {:name 'x}))))
 (doseq [option [:projection :conn-fn :scope-fn :rules :apply :retire :paused-fn]]
  (is (= :ambiguous-reconcile-config
         (kind #(rec/reconcile-clause
                  (list 'reconcile {:config-fn 'factory option 'other}) {:name 'x}))))))

(deftest runtime-factory-gets-the-same-default-level-policy-as-static-config
 (let [clause (rec/reconcile-clause '(reconcile {:config-fn factory}) {:name 'x})]
  (is (String/contains? (pr-str (:prelude clause)) "[10 :minutes]"))))

(deftest managed-configurations-never-borrow-development-registration
 (let [before @rec/configs
       source {"reconcile.identity" "(ns reconcile.identity) (defn version [] :same)"}
       a (g/prepare! {:application-id "reconcile-a" :sources source})
       b (g/prepare! {:application-id "reconcile-b" :sources source})]
  (try
   (rec/register! (q/scoped-server "reconcile-a" :same) {:marker :a})
   (rec/register! (q/scoped-server "reconcile-b" :same) {:marker :b})
   (is (= :a (:marker (get @rec/configs (name (q/scoped-server "reconcile-a" :same))))))
   (is (= :b (:marker (get @rec/configs (name (q/scoped-server "reconcile-b" :same))))))
   (is (not (contains? @rec/configs "same")))
   (is (not (g/with! a #(rec/configured? :same))))
   (is (not (g/with! b #(rec/configured? :same))))
   (is (= :immutable-declaration-required
          (kind #(g/with! a (fn [] (rec/register! :same {:marker :replacement}))))))
   (finally (reset! rec/configs before) (g/retire! a) (g/retire! b)))))
