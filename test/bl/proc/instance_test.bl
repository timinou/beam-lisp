(ns proc.instance-test (:require [proc.instance :as instance] [reload.generation :as generation]))

(defn probe [application marker]
 (generation/prepare! {:application-id application :stable-namespaces #{"proc.instance"}
  :native-modules #{"erlang"}
  :sources {"instance.probe"
   (str "(ns instance.probe (:require [proc.instance :as instance]))\n"
    "(defserver service (init [value] (instance/register! :instance-test/service (erlang/self)) (ok value))"
    " (handle-call :value [_ st] (reply st st)))\n"
    "(defn start-owner [value] (start service value))\n"
    "(defn find-owner [] (instance/whereis :instance-test/service))\n"
    "(defn value [] (call (instance/name :instance-test/service) :value))\n"
    "(defn marker [] " marker ")")}}))

(deftest process-names-are-isolated-by-instance-and-stable-across-code-generations
 (let [a (probe "instance-a" 1) a2 (probe "instance-a" 2) b (probe "instance-b" 3)
       pa (generation/invoke! a "instance.probe/start-owner" [:a])
       pb (generation/invoke! b "instance.probe/start-owner" [:b])]
  (try
   (is (not= pa pb))
   (is (= pa (generation/invoke! a2 "instance.probe/find-owner" [])))
   (is (= :a (generation/invoke! a2 "instance.probe/value" [])))
   (is (= :b (generation/invoke! b "instance.probe/value" [])))
   (is (nil? (Process/whereis :instance-test/service)))
   (is (nil? (instance/whereis :instance-test/service)))
   (is (= :instance-name-conflict
        (try (generation/with! a #(instance/register! :instance-test/service pb)) nil
         (catch e (:kind (ex-data e))))))
   (is (= pa (generation/invoke! a "instance.probe/find-owner" [])))
   (core/stop pa)
   (is (nil? (generation/invoke! a2 "instance.probe/find-owner" [])))
   (is (= :b (generation/invoke! b "instance.probe/value" [])))
   (finally
    (when (Process/alive? pa) (core/stop pa))
    (when (Process/alive? pb) (core/stop pb))
    (doseq [g [a a2 b]] (generation/retire! g))))))

(deftest managed-process-names-never-fall-back-without-an-instance
 (let [g (generation/prepare! {:sources {"instance.empty" "(ns instance.empty) (defn id [] 1)"}})]
  (try
   (is (= :missing-application-id
        (try (generation/with! g #(instance/whereis :instance-test/service)) nil
         (catch e (:kind (ex-data e))))))
   (is (= :invalid-instance-name
        (try (instance/name "request-supplied-name") nil (catch e (:kind (ex-data e))))))
   (finally (generation/retire! g)))))
