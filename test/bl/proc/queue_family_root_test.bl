; Actual native fixture, HOME source draft; no current native run claimed.
(ns proc.queue-family-root-test
 (:require [proc.queue-family-root :as root] [reload.generation :as g]
           [datom :as d] [datom.conn :as conn] [datom.store-fjall :as fjall]))
(defn kind [action]
 (try (action) nil (catch error (:kind (ex-data error)))))
(defn directory []
 (let [path (str (System/get_env "HOME") "/tmp/queue-root-" (erlang/unique_integer (list :positive)))]
  (File/mkdir_p! path) path))
(defn graph [app path version]
 (g/prepare! {:application-id app
  :resources {:data-root path :managed-root-journal "journal.fjall"
              :managed-root-journal-id "journal" :managed-root-store-paths {"journal" "journal.fjall"}
              :deployment-environment "production"}
  :stable-namespaces #{"proc.queue-family-root" "reload.generation" "env"}
  :sources {"root.fixture"
   (str "(ns root.fixture (:require [proc.queue-family-root :as root] [reload.generation :as g] [env])) "
        "(def version " version ") "
        "(defn enroll [c] (root/enroll! (g/current) c)) "
        "(defn clear-enroll [c] (let [actual (g/current) prior (env/capture)] "
        " (try (env/bind (assoc prior :generation nil)) (root/enroll! actual c) "
        "      (finally (env/bind prior)))))")}}))
(defn journal [path] (d/connect-with (fjall/open (str path "/journal.fjall"))))

(deftest genuine-native-journal-enrollment-is-once-and-candidate-inheritance-is-same-scope
 (let [path (directory) app (str "queue-root-" (erlang/unique_integer (list :positive)))
       old (graph app path 1) candidate (graph app path 2) c (journal path)]
  (try
   (let [first (conn/creation-evidence! c)
         joined (d/connect-with (:store c)) second (conn/creation-evidence! joined)]
    (is (= (erlang/self) (get-in first [:custody :owner])))
    (is (nil? (get-in first [:custody :origin])))
    (is (= (:custody first) (:custody second)))
    (is (= (:lifetime first) (:lifetime second))))
   (is (= :enrolled (root/enroll! old c)))
   (is (= :queue-root-already-enrolled (kind #(root/enroll! old c))))
   (is (= :entered (root/enter-initializer! old)))
   (g/with! old #(g/bind-runtime! {}))
   (is (= :ready (root/ready! old)))
   (is (= :inherited (root/inherit! candidate old)))
   (is (= :entered (root/enter-initializer! candidate)))
   (g/with! candidate #(g/bind-runtime! {}))
   (is (= :ready (root/ready! candidate)))
   (is (= :already-inherited (root/inherit! candidate old)))
   (let [a (g/with! old #(root/evidence! old)) b (g/with! candidate #(root/evidence! candidate))]
    (is (= (:custody a) (:custody b)))
    (is (= (:resource a) (:resource b)))
    (is (= (:lifetime a) (:lifetime b)))
    (is (= (:owner a) (:owner b)))
    (is (not= (:ticket a) (:ticket b))))
   (finally (d/close! c) (g/retire! old) (g/retire! candidate) (File/rm_rf! path)))))

(deftest same-pid-source-and-cleared-public-context-never-become-native-root-issuer
 (let [path (directory) app (str "queue-source-" (erlang/unique_integer (list :positive)))
       graph (graph app path 1) c (journal path)]
  (try
   (is (= :queue-root-native-initializer-required
           (kind #(g/invoke! graph "root.fixture/enroll" [c]))))
   (let [result (try (g/invoke! graph "root.fixture/clear-enroll" [c]) :unexpected
                    (catch error (str error)))]
    (is (String/contains? result "execution_origin_context_mismatch")))
   ;; Both refused Source invocations happened on this exact creator PID.
   ;; Refusal did not consume the true native pre-initializer enrollment.
   (is (= :enrolled (root/enroll! graph c)))
   (finally (d/close! c) (g/retire! graph) (File/rm_rf! path)))))

(deftest copied-scope-and-unrelated-connection-inside-root-are-not-journal-authority
 (let [path (directory) app (str "queue-confine-" (erlang/unique_integer (list :positive)))
       graph (graph app path 1) c (journal path)
       other (d/connect-with (fjall/open (str path "/unrelated.fjall")))]
  (try
   (is (= :unattested-prepared-generation
           (kind #(root/enroll! (assoc-in graph [:resources :managed-root-journal] "unrelated.fjall") other))))
   (is (= :queue-root-native-journal-required (kind #(root/enroll! graph other))))
   (is (= :unattested-prepared-generation
           (kind #(root/enroll! (assoc-in graph [:resources :data-root] (str path "/other")) c))))
   (is (= :enrolled (root/enroll! graph c)))
   (finally (d/close! other) (d/close! c) (g/retire! graph) (File/rm_rf! path)))))

(deftest another-native-pid-cannot-reenroll-copied-true-journal-receipt
 (let [path (directory) app (str "queue-custody-" (erlang/unique_integer (list :positive)))
       graph (graph app path 1) c (journal path) parent (erlang/self)
       child (spawn (fn [] (erlang/send parent [:root-enroll-result (kind #(root/enroll! graph c))])))
       monitor (Process/monitor child)]
  (try
   (is (= :queue-root-native-journal-required
           (receive [:root-enroll-result result] result (after 10000 :timed-out))))
   (is (receive [:DOWN ref :process pid _] :when (and (= ref monitor) (= pid child)) true
         (after 10000 false)))
   (is (= :enrolled (root/enroll! graph c)))
   (finally (d/close! c) (g/retire! graph) (File/rm_rf! path)))))

(deftest stale-native-lifetime-and-post-initializer-enrollment-refuse
 (let [path (directory) app (str "queue-stale-" (erlang/unique_integer (list :positive)))
       old (graph app path 1) initialized (graph app path 2) c (journal path)]
  (try
   (is (= :enrolled (root/enroll! old c)))
   (g/with! initialized #(g/bind-runtime! {}))
   (is (= :queue-root-enrollment-closed (kind #(root/enroll! initialized c))))
   (d/close! c)
   (is (some? (kind #(g/with! old (fn [] (root/evidence! old))))))
   (finally (g/retire! old) (g/retire! initialized) (File/rm_rf! path)))))

(deftest cross-application-or-root-candidate-does-not-inherit-live-native-journal
 (let [path (directory) other-path (directory)
       app (str "queue-app-" (erlang/unique_integer (list :positive)))
       old (graph app path 1) foreign (graph (str app "-foreign") path 1)
       moved (graph app other-path 2) c (journal path)]
  (try
   (is (= :enrolled (root/enroll! old c)))
   (is (= :queue-root-scope-mismatch (kind #(root/inherit! foreign old))))
   (is (= :queue-root-scope-mismatch (kind #(root/inherit! moved old))))
   (finally (d/close! c) (doseq [graph [old foreign moved]] (g/retire! graph))
    (File/rm_rf! path) (File/rm_rf! other-path)))))

(deftest abort-is-only-before-source-entry-and-does-not-close-native-journal
 (let [path (directory) app (str "queue-abort-" (erlang/unique_integer (list :positive)))
       graph (graph app path 1) c (journal path)]
  (try
   (is (= :enrolled (root/enroll! graph c)))
   (is (= :revoked (root/abort-unentered! graph)))
   (is (= :ready (:state (conn/writer-observation c))))
   (is (= :enrolled (root/enroll! graph c)))
   (is (= :entered (root/enter-initializer! graph)))
   (is (= :queue-root-custody-still-active (kind #(root/abort-unentered! graph))))
   (is (= :queue-root-initializer-uncertain (:reason (g/retire! graph))))
   (is (= :ready (:state (conn/writer-observation c))))
   ;; Controlled fixture then proves normal completion; no replay occurred.
   (g/with! graph #(g/bind-runtime! {}))
   (is (= :ready (root/ready! graph)))
   (is (= :retired (:status (g/retire! graph))))
   (is (= :ready (:state (conn/writer-observation c))))
   (finally (d/close! c) (File/rm_rf! path)))))

(deftest nested-symlink-journal-alias-refuses-using-physical-native-path
 (let [path (directory) outside (directory)
       app (str "queue-alias-" (erlang/unique_integer (list :positive)))
       _ (File/mkdir_p! (str path "/nested"))
       _ (File/ln_s! outside (str path "/nested/link"))
       proposal {:application-id app
        :resources {:data-root path :managed-root-journal "nested/link/journal.fjall"
                    :managed-root-journal-id "journal"
                    :managed-root-store-paths {"journal" "nested/link/journal.fjall"}}
        :sources {"alias.fixture" "(ns alias.fixture) (defn alive [] true)"}}
       graph (g/prepare! proposal)
       c (d/connect-with (fjall/open (str path "/nested/link/journal.fjall")))]
  (try
   (is (not= (str path "/nested/link/journal.fjall") (get-in c [:store :path])))
   (is (= :queue-root-noncanonical-directory (kind #(root/enroll! graph c))))
   (is (= :ready (:state (conn/writer-observation c))))
   (finally (d/close! c) (g/retire! graph) (File/rm_rf! path) (File/rm_rf! outside)))))

(deftest declared-store-custody-is-exact-and-cross-application-root-cannot-alias
 (let [path (directory) app (str "queue-declared-" (erlang/unique_integer (list :positive)))
       resources {:data-root path :managed-root-journal "journal.fjall" :managed-root-journal-id "journal"
                  :managed-root-store-paths {"journal" "journal.fjall" "mirror" "mirror.fjall"}}
       graph (g/prepare! {:application-id app :resources resources :sources {"declared.fixture" "(ns declared.fixture) (defn value [] true)"}})
       foreign (g/prepare! {:application-id (str app "-foreign") :resources resources :sources {"declared.fixture" "(ns declared.fixture) (defn value [] true)"}})
       c (journal path) mirror (d/connect-with (fjall/open (str path "/mirror.fjall")))
       unrelated (d/connect-with (fjall/open (str path "/foreign.fjall")))]
  (try
   (is (= :queue-root-declared-handles-required (kind #(root/enroll! graph c {"journal" c}))))
   (is (= :queue-root-native-journal-required
           (kind #(root/enroll! graph c {"journal" c "mirror" unrelated}))))
   (is (= :enrolled (root/enroll! graph c {"journal" c "mirror" mirror})))
   (is (= :queue-root-foreign-application-custody
           (kind #(root/enroll! foreign c {"journal" c "mirror" mirror}))))
   (is (= :ready (:state (conn/writer-observation unrelated))))
   (is (= :entered (root/enter-initializer! graph)))
   (g/with! graph #(g/bind-runtime! {}))
   (is (= :ready (root/ready! graph)))
   (is (= #{"journal" "mirror"} (set (keys (:declared (g/with! graph #(root/evidence! graph)))))))
   (finally (doseq [connection [c mirror unrelated]] (d/close! connection))
    (g/retire! graph) (g/retire! foreign) (File/rm_rf! path)))))

(deftest reopened-journal-in-same-vm-does-not-overwrite-live-root-incarnation
 (let [path (directory) app (str "queue-recreate-" (erlang/unique_integer (list :positive)))
       old (graph app path 1) next (graph app path 2) c (journal path) replacement (atom nil)]
  (try
   (is (= :enrolled (root/enroll! old c)))
   (let [before (conn/creation-evidence! c)]
    (d/close! c)
    (reset! replacement (journal path))
    (is (not= (:lifetime before) (:lifetime (conn/creation-evidence! @replacement))))
    (is (not= (:custody before) (:custody (conn/creation-evidence! @replacement))))
    (is (= :queue-root-custody-conflict (kind #(root/enroll! next @replacement))))
    (is (= :ready (:state (conn/writer-observation @replacement)))))
   (finally (when @replacement (d/close! @replacement))
    (g/retire! old) (g/retire! next) (File/rm_rf! path)))))

(deftest exact-declared-path-with-foreign-source-creator-is-not-native-root-custody
 (let [path (directory) app (str "queue-foreign-store-" (erlang/unique_integer (list :positive)))
       resources {:data-root path :managed-root-journal "journal.fjall" :managed-root-journal-id "journal"
                  :managed-root-store-paths {"journal" "journal.fjall" "mirror" "mirror.fjall"}}
       graph (g/prepare! {:application-id app :resources resources :sources {"foreign.store" "(ns foreign.store) (defn value [] true)"}})
       foreign (g/prepare! {:application-id (str app "-foreign") :sources {"foreign.store" "(ns foreign.store) (defn value [] true)"}})
       c (journal path) mirror (g/with! foreign #(d/connect-with (fjall/open (str path "/mirror.fjall"))))]
  (try
   (is (= (str app "-foreign") (get-in (conn/creation-evidence! mirror) [:creator :application-id])))
   (is (= :queue-root-native-journal-required (kind #(root/enroll! graph c {"journal" c "mirror" mirror}))))
   (is (= :ready (:state (conn/writer-observation c))))
   (is (= :ready (:state (conn/writer-observation mirror))))
   (finally (d/close! mirror) (d/close! c) (g/retire! graph) (g/retire! foreign) (File/rm_rf! path)))))
