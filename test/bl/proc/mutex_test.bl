(ns test.proc.mutex (:require [proc.mutex :as mutex]))

(deftest action-retains-caller-and-reentrant-state
 (let [caller (erlang/self)]
  (Process/put :mutex-context :caller)
  (try
   (is (= [caller :caller]
        (mutex/with! ::caller (fn []
         (mutex/with! ::caller (fn [] [(erlang/self) (Process/get :mutex-context)]))))))
   (is (= :after (try (mutex/with! ::caller (fn [] (throw :expected)))
                      (catch _ :after))))
   (is (= :released (mutex/with! ::caller (fn [] :released))))
   (finally (Process/delete :mutex-context)))))

(deftest concurrent-calls-serialize-and-dead-holders-release
 (let [parent (erlang/self)
       owner (erlang/spawn (fn []
        (mutex/with! ::concurrent (fn []
         (erlang/send parent :held)
         (receive :finish :finished))))) ]
  (is (= :held (receive :held :held (after 2000 :timeout))))
  (let [waiter (erlang/spawn (fn []
                (mutex/with! ::concurrent (fn [] (erlang/send parent :acquired)))))]
   (try
    (is (= :waiting (receive :acquired :unexpected (after 20 :waiting))))
    (Process/exit owner :kill)
    (is (= :acquired (receive :acquired :acquired (after 2000 :timeout))))
    (is (= :next (mutex/with! ::concurrent (fn [] :next))))
    (finally
     (when (Process/alive? owner) (Process/exit owner :kill))
     (when (Process/alive? waiter) (Process/exit waiter :kill)))))))

(deftest invalid-lock-identities-refuse
 (doseq [logical [nil {} (atom nil) "" (String/duplicate "x" 257)]]
  (is (= :invalid-mutex
       (try (mutex/with! logical (fn [] :unexpected))
        (catch e (:kind (ex-data e))))))))
