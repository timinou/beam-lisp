; Independent native writer admission facts. Provider quotas are configured,
; never inferred; shared multi-journal authority has separate tests.
(ns proc.queue-capacity-test
 (:require [proc.queue :as q] [datom :as d] [datom.conn :as dc]
           [datom.store-fjall :as fjall] [datom.store :as ds] [env :as env]))
(def POLICY {:max-outstanding 3
             :scopes [{:keys [:work/property] :max 2}
                      {:keys [:work/property :work/provider] :max 1}]})
(defn fixture []
 (let [suffix (String/downcase (Base/encode16 (crypto/strong_rand_bytes 8)))
       c (dc/connect-with (fjall/open (ds/fresh-path ".queue-capacity.fjall")) [])
       srv (q/scoped-server (str "test.capacity." suffix) :work)]
  (q/attach-store! srv c)
  (d/transact! c [{:db/id -1 :queue/key (name srv)
    :queue/decl (assoc (q/normalise-decl {:of :test/capacity :unique [:work/id] :admission POLICY}) :server (name srv))}])
  {:conn c :server srv}))
(defn payload [id property provider] {:work/id id :work/property property :work/provider provider})
(defn admit! [f payload] (q/try-enqueue! (:server f) payload {:enrollment-key [:original (:work/id payload)]}))
(defn refusal [f payload]
 (try (admit! f payload) nil (catch e (:kind (ex-data e)))))
(deftest configured-property-and-provider-groups-share-one-writer-cap
 (let [f (fixture)]
  (try
   ;; Source shadows are realm-local. Native Env bindings deliberately do not
   ;; cross Task.async: preserve the caller's actual authority in both writers.
   (let [token (env/capture)
         tasks (mapv (fn [id] (Task/async (fn [] (env/bind token)
                                        (admit! f (payload id "hotel:a" :meta))))) ["a" "b"])
         results (mapv #(Task/await % 30000) tasks)
         winner (:job (first (filter #(= :admitted (:status %)) results)))
         original (:job/payload winner)]
    (is (= 1 (count (filter #(= :admitted (:status %)) results))))
    (is (= 1 (count (filter #(= :deferred (:status %)) results))))
    (is (= :existing (:status (admit! f original))))
    (is (= :admitted (:status (admit! f (payload "c" "hotel:a" :pms)))))
    (is (= :deferred (:status (admit! f (payload "d" "hotel:a" :email)))))
    (is (= :admitted (:status (admit! f (payload "e" "hotel:b" :meta)))))
    (is (= :deferred (:status (admit! f (payload "f" "hotel:c" :pms)))))
    (is (= :invalid-admission-payload (refusal f {:work/id "missing"})))
    (is (= :enrollment-conflict
           (try (q/try-enqueue! (:server f) (assoc original :work/provider :changed)
                   {:enrollment-key [:original (:work/id original)]}) nil
                (catch e (:kind (ex-data e))))))
    ;; Held effects continue to occupy the original budget; a retry of this
    ;; same held obligation does not allocate it twice.
    (let [claimed (q/claim! (:conn f) winner (erlang/system_time :millisecond) 60000)]
     (q/begin-effect! (:server f) claimed :provider)
     (d/transact! (:conn f) [[:db/cas (:db/id winner) :job/state :running :held]])
     (is (= :deferred (:status (admit! f (payload "blocked" "hotel:a" :meta)))))
     (is (= :queued (:job/state (q/retry! (:server f) (:db/id winner)))))
     (is (seq (:job/effects (d/entity (d/db (:conn f)) (:db/id winner)))))))
   (finally (dc/close! (:conn f))))))
(deftest old-declarations-remain-identical-and-policy-is-strict
 (is (not (contains? (q/normalise-decl {:of :test/old}) :admission)))
 (doseq [policy [nil {} {:max-outstanding 0 :scopes []}
                 {:max-outstanding 2 :scopes [{:keys [] :max 1}]}
                 {:max-outstanding 2 :scopes [{:keys [:p] :max 3}]}]]
  (is (some? (try (q/normalise-decl {:of :test/bad :admission policy}) nil
                 (catch e (:kind (ex-data e))))))))
