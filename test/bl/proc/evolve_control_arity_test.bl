; Public synthetic SDK controls. Actual private SDK predicate and actual invalid
; message parser are called; no fabricated framework/owner/preparation receipts.
(ns proc.evolve-control-arity-test (:require [proc.evolve :as evolve]))
(def CONTROL-ARITIES
 [[:proc.evolve/status 1]
  [:proc.evolve/automatic-commit 2] [:proc.evolve/automatic-cancel 2] [:proc.evolve/automatic-status 2]
  [:proc.evolve/commit 2] [:proc.evolve/cancel 2] [:proc.evolve/acquire 2] [:proc.evolve/release 2]
  [:proc.evolve/fence 2] [:proc.evolve/bind-queue 2]
  [:proc.evolve/call 3] [:proc.evolve/upgrade 3] [:proc.evolve/client 3] [:proc.evolve/request 3]
  [:proc.evolve/retire 3] [:proc.evolve/automatic-current-rehearsal 3]
  [:proc.evolve/prepare 4] [:proc.evolve/rehearse 4]
  [:proc.evolve/automatic-prepare 5]])
(deftest actual-sdk-control-predicate-recognizes-every-exact-closed-arity
 (let [arity? (BeamLisp.Env/fetch_exact! "proc.evolve" "owner-control-arity?")]
  (doseq [[tag n] CONTROL-ARITIES]
   (let [message (cons tag (to-list (repeat (dec n) nil)))]
    (is (= true (arity? message)))
    (is (= false (arity? (to-list (drop 1 message)))))
    (is (= false (arity? (cons tag message))))))
  (is (not (arity? nil)))))
(deftest actual-invalid-control-shapes-refuse-without-class-owner-or-callback-access
 (let [effects (atom 0) action (fn [] (swap! effects inc) :unsafe)
       malformed [nil 1 :unknown {:callback action} [] [:unknown] [:proc.evolve/status nil]
                  [:proc.evolve/automatic-prepare]
                  [:proc.evolve/automatic-prepare nil nil nil nil nil]
                  {:__struct__ :Elixir.BeamLisp.Vector :items action}]]
  (doseq [value malformed]
   (is (= :unknown-evolution-message (:kind (first (evolve/message-step {} value))))))
  (is (= 0 @effects))))
