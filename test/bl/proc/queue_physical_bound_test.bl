; Original owned-stop regression deliberately retains legacy lease slot behavior.
; This independent fixture explicitly opts into the NEW physical lifetime bound.
(ns proc.queue-physical-bound-test
 (:require [proc.queue :as q] [proc.queue-runtime :as runtime]
           [datom :as d] [datom.store-fjall :as fjall]))
(defn await! [predicate]
 (let [deadline (+ (erlang/monotonic_time :millisecond) 10000)]
  (loop [] (when-not (predicate)
   (when (>= (erlang/monotonic_time :millisecond) deadline)
    (throw (ex-info "Native physical boundary did not settle" {:kind :fixture-timeout})))
   (Process/sleep 2) (recur)))))
(deftest slow-expired-body-keeps-its-physical-slot-until-actual-death-wakes-owner
 (let [suffix (String/downcase (Base/encode16 (crypto/strong_rand_bytes 8)))
       path (str ".local/queue-physical-bound-" suffix ".fjall")
       srv (q/scoped-server (str "test.physical." suffix) :work)
       conn (d/connect-with (fjall/open path) []) now (atom 1000)
       workers (atom []) holder (atom nil)
       _ (q/attach-store! srv conn)
       handler (runtime/prepare srv {:declaration {:of :test/physical :generation "physical-v1"
                 :concurrency 1 :max-live-workers 1 :lease 60 :unique [:test/key]}
                 :clock (fn [] @now)
                 :perform (fn [_] (swap! workers conj (erlang/self))
                                  (receive [:release] :done))})]
  (try
   (reset! holder (runtime/start! handler {}))
   (let [job (q/enqueue! srv {:test/key "slow"} {:at @now :generation "physical-v1"})]
    (await! #(= 1 (count @workers)))
    (swap! now + 60001)
    (erlang/send @holder [:bl-queue/wake])
    ;; Synchronous native-owner status call is a deterministic mailbox barrier
    ;; after wake, rather than a sleep-based assertion of nonoccurrence.
    (runtime/status srv)
    (is (= 1 (count @workers)))
    (is (Process/alive? (first @workers)))
    (is (= 1 (:live (runtime/body-status srv (:job/id job)))))
    (is (= 1 (:job/attempts (d/entity (d/db conn) (:db/id job)))))
    ;; Reopening only the actor inherits and monitors the same physical body.
    (runtime/stop! srv) (reset! holder (runtime/start! handler {}))
    (erlang/send @holder [:bl-queue/wake]) (runtime/status srv)
    (is (= 1 (count @workers)))
    (is (= 1 (:live (runtime/body-status srv (:job/id job)))))
    ;; Actual death, without another manual wake/time jump, must release slot.
    (erlang/exit (first @workers) :kill)
    (await! #(= 2 (count @workers)))
    (is (not (Process/alive? (first @workers))))
    (is (= 1 (:live (runtime/body-status srv (:job/id job)))))
    (is (= 2 (:job/attempts (d/entity (d/db conn) (:db/id job))))))
   (finally
    (runtime/stop! srv {:workers :stop})
    (doseq [pid @workers] (when (Process/alive? pid) (erlang/exit pid :kill)))
    (d/close! conn) (File/rm_rf! path) (File/rm_rf! (str path ".blobs"))))))
