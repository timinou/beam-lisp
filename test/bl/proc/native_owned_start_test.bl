; Concrete HostEnv/Refs native tests: UNRUN; requires new coherent host floor.
(ns proc.native-owned-start-test (:require [proc.task :as task]))
(defn refused [action] (try (action) :unexpected-acceptance (catch _ :refused)))
(defn pending [] (task/async-nolink (fn [] (receive :depart :departed))))
(deftest actual-native-task-has-stable-original-transfer-receipt
 (let [owner (erlang/self) work (pending) pid (task/pid work)
       a (BeamLisp.Env/native_process_start_evidence! pid owner)
       b (BeamLisp.Env/native_process_start_evidence! pid owner)
       first-receipt (first (:receipts a))]
  (is (= a b))
  (is (= pid (:child a)))
  (is (= owner (:original-creator a)))
  (is (= owner (:creator first-receipt)))
  (is (erlang/is_reference (:ticket first-receipt)))
  (is (erlang/is_reference (:lease-id first-receipt)))
  (is (nil? (:lease first-receipt)))
  (erlang/send pid :depart)
  (is (= :departed (task/await work 10000)))
  (is (= :refused (refused #(BeamLisp.Env/native_process_start_evidence! pid owner))))))
(deftest raw-process-and-copied-task-map-cannot-manufacture-original-start
 (let [owner (erlang/self) ready (erlang/make_ref)
       raw (erlang/spawn (fn [] (erlang/send owner [:raw-ready ready (erlang/self)])
                                  (receive :depart :departed)))
       work (pending) actual (task/pid work)]
  (receive [:raw-ready seen pid] :when (and (= seen ready) (= pid raw)) :ready)
  (is (= :refused (refused #(BeamLisp.Env/native_process_start_evidence! raw owner))))
  (is (= :refused (refused #(BeamLisp.Env/native_process_start_evidence!
                              (task/pid (assoc work :pid raw)) owner))))
  (is (= :refused (refused #(BeamLisp.Env/record_owned_start! raw (erlang/make_ref)
                              (tuple (list) raw (erlang/make_ref))))))
  (is (= :refused (refused #(BeamLisp.Env/record_owned_start! actual (erlang/make_ref)
                              (tuple (list) actual (erlang/make_ref))))))
  (erlang/send raw :depart) (erlang/send actual :depart)
  (task/await work 10000)))
(deftest wrong-original-owner-and-forged-ancestry-refuse
 (let [owner (erlang/self) work (pending) pid (task/pid work)
       foreign (task/async-nolink (fn []
                 ;; This is a genuine other native process, but not the original
                 ;; creator. A caller marker cannot change the private receipt.
                 (Process/put :"$ancestors" (list owner))
                 (refused #(BeamLisp.Env/native_process_start_evidence! pid (erlang/self)))))]
  (is (= :refused (task/await foreign 10000)))
  (is (= owner (:original-creator (BeamLisp.Env/native_process_start_evidence! pid owner))))
  (erlang/send pid :depart) (task/await work 10000)))
