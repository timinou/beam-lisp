; Actual native prepared identity, Fjall custody and normal SDK Root enrollment.
; No copied private receipt, Source flag issuer or mocked native retirement.
(ns proc.queue-root-retirement-outcome-test
 (:require [proc.queue-family-root :as root] [reload.generation :as g]
           [datom :as d] [datom.conn :as conn] [datom.store-fjall :as fjall]))
(defn- kind [action] (try (action) nil (catch error (:kind (ex-data error)))))
(defn- directory! []
 (let [p (str (System/get_env "HOME") "/tmp/root-native-outcome-" (erlang/unique_integer (list :positive)))]
  (File/mkdir_p! p) p))
(defn- graph [path]
 (g/prepare! {:application-id (str "root-native-outcome-" (erlang/unique_integer (list :positive)))
  :resources {:data-root path :managed-root-journal "journal.fjall"
              :managed-root-journal-id "journal" :managed-root-store-paths {"journal" "journal.fjall"}}
  :sources {"root.retirement" "(ns root.retirement) (defn value [] 13)"}}))
(defn- enter! [a c]
 (root/enroll! a c) (root/enter-initializer! a)
 (g/with! a #(g/bind-runtime! {})) (root/ready! a))

(deftest forged-reachable-retired-flag-cannot-dispose-a-real-native-root-grant
 (let [path (directory!) a (graph path) c (d/connect-with (fjall/open (str path "/journal.fjall")))
       before (atom nil)]
  (try
   (is (= :ready (enter! a c)))
   (reset! before (g/with! a #(root/evidence! a)))
   (is (nil? (g/native-retirement-outcome a)))
   (is (every? erlang/module_loaded (:modules a)))
   (swap! (:state a) assoc :retired true)
   (is (= :queue-root-generation-still-active (kind #(root/release-retired! a))))
   (is (nil? (g/native-retirement-outcome a)))
   (swap! (:state a) assoc :retired false)
   (let [after (g/with! a #(root/evidence! a))]
    (is (= (:ticket @before) (:ticket after)))
    (is (= (:custody @before) (:custody after)))
    (is (= (:lifetime @before) (:lifetime after))))
   (is (= 13 (g/invoke! a "root.retirement/value" [])))
   (is (= :ready (:state (conn/writer-observation c))))
   (finally
    (swap! (:state a) assoc :retired false)
    (let [r (g/retire! a)]
     (when (contains? #{:retired :already-retired} (:status r)) (d/close! c) (File/rm_rf! path)))))))

(deftest cleanup-rejects-edited-original-scope-application-and-module-inventory
 (let [path (directory!) a (graph path) c (d/connect-with (fjall/open (str path "/journal.fjall")))]
  (try
   (is (= :ready (enter! a c)))
   (is (= :unattested-prepared-generation
          (kind #(root/release-retired! (assoc a :scope (erlang/make_ref))))))
   (is (= :unattested-prepared-generation
          (kind #(root/release-retired! (assoc a :application-id "foreign-root")))))
   (is (= :unattested-prepared-generation
          (kind #(root/release-retired! (assoc a :modules [])))))
   (is (nil? (g/native-retirement-outcome a)))
   (is (= c (get-in (g/with! a #(root/evidence! a)) [:declared "journal"])))
   (is (= :open @(:lifetime c)))
   (finally
    (let [r (g/retire! a)]
     (when (contains? #{:retired :already-retired} (:status r)) (d/close! c) (File/rm_rf! path)))))))

(deftest genuine-native-success-disposes-only-root-metadata-and-keeps-journal-open
 (let [path (directory!) a (graph path) c (d/connect-with (fjall/open (str path "/journal.fjall")))]
  (try
   (is (= :ready (enter! a c)))
   (is (= :retired (:status (g/retire! a))))
   (is (= :native-retired (:status (g/native-retirement-outcome a))))
   (is (= :complete (:phase (g/native-retirement-outcome a))))
   (is (= :absent (root/release-retired! a)))
   (is (= :already-retired (:status (g/retire! a))))
   (is (every? #(not (erlang/module_loaded %)) (:modules a)))
   (is (= :ready (:state (conn/writer-observation c))))
   (is (= :open @(:lifetime c)))
   (d/close! c)
   (is (= :closed @(:lifetime c)))
   (finally
    (let [r (g/retire! a)]
     (when (contains? #{:retired :already-retired} (:status r)) (d/close! c) (File/rm_rf! path)))))))
