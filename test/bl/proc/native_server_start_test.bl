; Native regression SPECIMENS, UNRUN. No private product Source fixtures.
; Requires one coherent native host/SDK floor including Env/Refs/Server/Supervisor.
(ns proc.native-server-start-test
 (:require [proc.task :as task]))
(defn- refused [action] (try (action) :unexpected-acceptance (catch _ :refused)))
(def initializations (atom 0))
(defserver native-runner
 (init [opts]
  (swap! initializations inc)
  (when (:hold opts)
   (erlang/send (:owner opts) [:native-init-held (:hold opts) (erlang/self)])
   (let [hold (:hold opts)]
    (receive [:native-init-finish seen] :when (= seen hold) :ok)))
  (ok opts))
 (handle-call [:forge-ancestry pid] [_ opts]
  (Process/put :"$ancestors" (list pid))
  (Process/put :bl_server_start_receipt {:creator pid :child (erlang/self) :ticket (erlang/make_ref)})
  (reply :written opts)))
(defn supervised []
 (let [result (BeamLisp.Supervisor/start_native_link
               (list (BeamLisp.Supervisor/server :runner native-runner {} {:restart :temporary}))
               (list (tuple :strategy :one_for_one)))
       sup (elem result 1) child (elem (first (Supervisor/which_children sup)) 1)]
  {:sup sup :child child}))
(deftest lazy-native-bootstrap-is-owned-by-actual-env-and-outside-fabrication-refuses
 ;; This is also a first-use test for official seed recovery with an Env process
 ;; initialized before these tables existed. Never creates any ETS table itself.
 (let [tables (BeamLisp.Env/native_start_table_evidence!) owner (Process/whereis :Elixir.BeamLisp.Env)]
  (is (= 3 (count tables)))
  (is (every? #(= owner (:owner %)) tables))
  (is (= [:private :private :protected] (mapv :protection tables)))
  (is (every? #(= :set (:type %)) tables))
  (is (= :refused (refused #(BeamLisp.Env/ensure_native_start_tables!))))
  (is (= :refused (refused #(ets/lookup :beam_lisp_native_owned_starts (erlang/self)))))
  (is (= :refused (refused #(ets/insert :beam_lisp_native_start_code
                                   (tuple (tuple native-runner (erlang/make_ref)) :fake)))))))
(deftest actual-native-supervisor-runner-chain-is-captured-with-real-class-custody
 (let [owner (erlang/self) {:keys [sup child]} (supervised)]
  (try
   (let [evidence (BeamLisp.Env/native_process_start_evidence! child owner)
         receipts (:receipts evidence)]
    (is (= 2 (count receipts)))
    (is (= child (:child (first receipts))))
    (is (= sup (:creator (first receipts))))
    (is (= sup (:child (second receipts))))
    (is (= owner (:creator (second receipts))))
    (is (every? #(= :unmanaged-native-class (:custody-kind %)) receipts))
    (is (every? #(erlang/is_reference (:lease-id %)) receipts))
    (is (every? #(nil? (:lease %)) receipts))
    (is (BeamLisp.Env/native_start_class_held? native-runner))
    (is (nil? (Process/get :bl_generation)))
    (GenServer/call child [:forge-ancestry (erlang/self)])
    (is (= evidence (BeamLisp.Env/native_process_start_evidence! child owner))))
   (finally (Supervisor/stop sup :normal 5000)))
  (is (= :refused (refused #(BeamLisp.Env/native_process_start_evidence! child owner))))
  (is (not (BeamLisp.Env/native_start_class_held? native-runner)))))
(deftest actual-claimed-child-before-parent-finish-is-not-a-start-authority
 (let [owner (erlang/self) ticket (erlang/make_ref)
       parent (task/async-nolink
        (fn []
         (let [child (BeamLisp.Server/start native-runner {:hold ticket :owner owner})]
          (erlang/send owner [:native-parent-finished ticket child])
          (receive :depart (GenServer/stop child :normal 5000)))))]
  (let [child (receive [:native-init-held seen pid] :when (= seen ticket) pid)]
   (is (= :refused (refused #(BeamLisp.Env/native_process_start_evidence! child owner))))
   (erlang/send child [:native-init-finish ticket])
   (receive [:native-parent-finished seen pid] :when (and (= seen ticket) (= pid child)) :ready)
   (is (= 2 (count (:receipts (BeamLisp.Env/native_process_start_evidence! child owner)))))
   (is (= (task/pid parent) (:creator (first (:receipts (BeamLisp.Env/native_process_start_evidence! child owner))))))
   (erlang/send (task/pid parent) :depart) (task/await parent 10000))))
(deftest forged-native-envelope-refuses-before-actual-user-initialization
 (let [before @initializations fake (tuple :bl_native_launch (erlang/make_ref))
       envelope (tuple :"$bl_native_conveyed_env" (BeamLisp.Env/capture) native-runner {} fake)
       result (erlang/apply :gen_server :start (list native-runner envelope (list)))]
  (is (= :error (elem result 0)))
  (is (= before @initializations))
  (is (= :refused (refused #(BeamLisp.Env/begin_unmanaged_start! native-runner :server))))
  (is (= :refused (refused #(BeamLisp.Env/claim_unmanaged_start! fake native-runner :server))))
  (is (= :refused (refused #(BeamLisp.Env/finish_unmanaged_start! fake (tuple :ok (erlang/self))))))))
(deftest raw-elixir-supervisor-creates-a-gap-and-foreign-creator-refuses
 (let [owner (erlang/self)
       result (Supervisor/start_link
               (list (BeamLisp.Supervisor/server :runner native-runner {} {:restart :temporary}))
               (list (tuple :strategy :one_for_one)))
       sup (elem result 1) child (elem (first (Supervisor/which_children sup)) 1)
       foreign (task/async-nolink (fn [] (receive :depart :departed)))]
  (try
   ;; Actual child native server receipt exists, but its raw supervisor has no
   ;; protected original receipt. PID/ancestry inference must NEVER bridge it.
   (is (= :refused (refused #(BeamLisp.Env/native_process_start_evidence! child owner))))
   (is (= :refused (refused #(BeamLisp.Env/native_process_start_evidence! child (task/pid foreign)))))
   (GenServer/call child [:forge-ancestry owner])
   (is (= :refused (refused #(BeamLisp.Env/native_process_start_evidence! child owner))))
   (finally (Supervisor/stop sup :normal 5000)
            (erlang/send (task/pid foreign) :depart) (task/await foreign 10000)))))
(defn changed-class-beam [module]
 ;; Real different BEAM bytes, with unchanged generated class schema metadata.
 ;; This is compile-only test data; the protected publication must refuse it.
 (let [schema (BeamLisp.Env/generated_class_metadata (erlang/apply module :module_info (list :attributes)))
       attrs (if schema (list (tuple :attribute 1 :bl_generated_class schema)) (list))
       forms (concat (list (tuple :attribute 1 :module module)
                           (tuple :attribute 1 :export (list (tuple :init 1)))) attrs
                     (list (tuple :function 1 :init 1
                       (list (tuple :clause 1 (list (tuple :var 1 :Arg)) (list)
                         (list (tuple :tuple 1 (list (tuple :atom 1 :ok) (tuple :var 1 :Arg)))))))))
       result (erlang/apply :compile :forms (list (to-list forms) (list :binary :return_errors)))]
  (when-not (= :ok (elem result 0)) (throw (ex-info "Probe compile failed" {:kind :probe-compile-failed})))
  (tuple module (elem result 2))))
(deftest actual-native-class-lease-refuses-changed-bytes-before-publication
 (let [{:keys [sup child]} (supervised) before (erlang/apply native-runner :module_info (list :md5))]
  (try
   (let [probe (changed-class-beam native-runner)
         error (try (BeamLisp.Env/publish_binaries! (list (tuple probe "native-start-class-probe"))) "unexpected acceptance"
                 (catch error (str error)))]
    (is (String/contains? error "native_start_class_code_held"))
    (is (= before (erlang/apply native-runner :module_info (list :md5))))
    (is (Process/alive? child))
    (is (BeamLisp.Env/native_start_class_held? native-runner)))
   (finally (Supervisor/stop sup :normal 5000)))))
