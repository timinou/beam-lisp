(ns proc.queue-rebind-test
 (:require [proc.queue :as q] [proc.queue-runtime :as runtime]
           [datom :as d] [datom.conn :as dc] [datom.store :as ds]
           [datom.store-fjall :as fjall]))

(deftest closed-queue-connection-rebind-requires-same-file-and-dead-owner
 (let [srv :rebind-file-q path (ds/fresh-path ".queue-rebind.fjall")
       c (dc/connect-with (fjall/open path) [])
       handler (runtime/prepare srv {:declaration {:of :test/rebind :generation "rebind-generation"}
                                     :perform (fn [job] (:test/value job))})]
  (q/attach-store! srv c)
  (let [pid (runtime/start! handler)
        pending (q/enqueue! srv {:test/value 31} {:in [60 :seconds]})]
   (erlang/apply :sys :get_state (list pid))
   (dc/close! c)
   (let [replacement (dc/connect-with (fjall/open path) [])
         different (dc/connect-with (fjall/open (ds/fresh-path ".different-queue.fjall")) [])]
    (try
     (is (= :store-already-bound
            (try (q/attach-store! srv replacement) nil (catch e (:kind (ex-data e)))))
         "a live queue owner still owns its old connection even after closure")
     (is (= :stopped (:status (runtime/stop! srv))))
     (is (= :already-stopped (:status (runtime/stop! srv))))
     (is (= :store-already-bound
            (try (q/attach-store! srv different) nil (catch e (:kind (ex-data e)))))
         "closure does not authorize moving accepted work to another file")
     (is (= replacement (q/attach-store! srv replacement)))
     (is (= (:job/id pending) (:job/id (d/entity (d/db replacement) (:db/id pending)))))
     (is (= :released-connection
            (try (d/transact! c [{:db/id -1 :test/value 99}]) nil (catch e (:reason (ex-data e))))))
     (let [resumed (runtime/start! handler)]
      (try
       (is (= true (runtime/ready? srv)))
       (is (= "rebind-generation" (:generation (runtime/status srv))))
       (finally (runtime/stop! srv))))
     (erlang/register (q/op-name srv) (erlang/self))
     (try
      (is (= :owner-transition-authority-required (:kind (runtime/stop! srv)))
          "a custom owner name never grants shared-runtime stop authority")
      (finally (erlang/unregister (q/op-name srv))))
     (finally
      (when (Process/alive? pid) (stop pid))
      (dc/close! replacement) (dc/close! different)))))))
