(ns proc.owned-table-test (:require [proc.table :as table]))

(defserver initializer
 (init [_] (ok nil))
 (handle-call [:delete tid] [_ st] (ets/delete tid) (reply :ok st))
 (handle-info _ [st] (noreply st)))

(deftest owned-tables-survive-users-and-refuse-lost-lifetimes
 (let [owner (start initializer nil) cell (atom nil) other (atom nil)
       caller (erlang/self)]
  (try
   ;; The short-lived requesting worker is never the enduring table owner.
   (let [worker (spawn (fn []
                        (let [tid (table/hold-owned! cell owner)]
                         (ets/insert tid (tuple :accepted 7))
                         (erlang/send caller [:owned-table tid]))))
         tid (receive [:owned-table tid] tid (after 2000 nil))]
    (is (some? tid))
    (is (= owner (ets/info tid :owner)))
    (is (= tid (table/hold-owned! cell owner)))
    (is (= [(tuple :accepted 7)] (into [] (ets/lookup tid :accepted))))
    (let [second (table/hold-owned! other owner)]
     (is (not= tid second))
     (is (empty? (into [] (ets/lookup second :accepted)))))
    (call owner [:delete tid])
    (is (= :lost-owned-table
         (try (table/hold-owned! cell owner) nil (catch e (:kind (ex-data e))))))
    ;; A stale cell never silently becomes an empty accepted-work queue.
    (is (= tid @cell)))
   (is (= :invalid-owned-table-options
        (try (table/hold-owned! (atom nil) owner {:options [:public :named_table]}) nil
         (catch e (:kind (ex-data e))))))
   (is (= :invalid-owned-table-options
        (try (table/hold-owned! (atom nil) owner {:options [:public (tuple :heir owner nil)]}) nil
         (catch e (:kind (ex-data e))))))
   (stop owner)
   (is (= :invalid-table-owner
        (try (table/hold-owned! other owner) nil (catch e (:kind (ex-data e))))))
   (finally (when (Process/alive? owner) (stop owner))))))

(deftest competing-first-users-share-one-owned-table
 (let [owner (start initializer nil) cell (atom nil) caller (erlang/self)]
  (try
   (doseq [_ (range 12)]
    (spawn (fn [] (erlang/send caller [:table (table/hold-owned! cell owner)]))))
   (let [tables (mapv (fn [_] (receive [:table tid] tid (after 3000 nil))) (range 12))]
    (is (every? some? tables))
    (is (= 1 (count (distinct tables))))
    (is (= owner (ets/info (first tables) :owner))))
   (finally (stop owner)))))
