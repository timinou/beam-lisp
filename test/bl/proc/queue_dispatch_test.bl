; Native dispatch cursor and claim are one transaction. No worker sleeps or
; invented provider limit is needed to verify fairness facts.
(ns proc.queue-dispatch-test
 (:require [proc.queue :as q] [datom :as d] [datom.conn :as dc]
           [datom.store-fjall :as fjall] [datom.store :as ds]))
(def POLICY {:mode :round-robin :group [:work/property :work/guest] :max-groups 4})
(defn fixture []
 (let [suffix (String/downcase (Base/encode16 (crypto/strong_rand_bytes 8)))
       path (ds/fresh-path ".queue-dispatch.fjall")
       c (dc/connect-with (fjall/open path) [])
       srv (q/scoped-server (str "test.dispatch." suffix) :work)]
  (q/attach-store! srv c)
  (d/transact! c [{:db/id -1 :queue/key (name srv)
    :queue/decl (assoc (q/normalise-decl {:of :test/dispatch :unique [:work/id] :dispatch POLICY}) :server (name srv))}])
  {:conn c :server srv :path path}))
(defn enqueue! [f id guest at]
 (q/enqueue! (:server f) {:work/id id :work/property "hotel:a" :work/guest guest} {:at at}))
(defn candidates [f now] (q/dispatch-candidates (d/db (:conn f)) (:server f) now POLICY #{} #{}))
(defn claim! [f job now]
 (q/claim! (:conn f) job now 60000 {:dispatch POLICY :server (:server f) :busy #{} :excluded #{}}))
(deftest successive-claims-rotate-guests-and-lost-claims-never-advance-cursor
 (let [f (fixture)]
  (try
   (enqueue! f "a-old" "guest:a" 1) (enqueue! f "a-next" "guest:a" 2)
   (enqueue! f "b-old" "guest:b" 1) (enqueue! f "b-next" "guest:b" 2)
   (let [one (first (candidates f 10)) claimed (claim! f one 10)
         before (:queue/dispatch-cursor (d/entity (d/db (:conn f)) [:queue/key (name (:server f))]))
         two (first (candidates f 10))]
    (is (some? claimed))
    (is (not= (get-in one [:job/payload :work/guest]) (get-in two [:job/payload :work/guest])))
    (is (nil? (claim! f one 10)))
    (is (= before (:queue/dispatch-cursor (d/entity (d/db (:conn f)) [:queue/key (name (:server f))]))))
    (is (some? (claim! f two 10)))
    (is (= (get-in one [:job/payload :work/guest]) (get-in (first (candidates f 10)) [:job/payload :work/guest]))))
   (finally (dc/close! (:conn f))))))
(deftest future-due-and-busy-partitions-cannot-spend-a-turn
 (let [f (fixture)]
  (try
   (let [future (enqueue! f "future" "guest:a" 1000)
         due (enqueue! f "due" "guest:b" 10)]
    (is (= [(:db/id due)] (mapv :db/id (candidates f 10))))
    (d/transact! (:conn f) [[:db/add (:db/id due) :job/partition "occupied"]])
    (is (empty? (q/dispatch-candidates (d/db (:conn f)) (:server f) 10 POLICY #{"occupied"} #{})))
    (d/transact! (:conn f) [[:db/retract (:db/id due) :job/partition "occupied"]])
    (is (nil? (claim! f future 10)))
    (is (nil? (:queue/dispatch-cursor (d/entity (d/db (:conn f)) [:queue/key (name (:server f))]))))
    (is (some? (claim! f due 10))))
   (finally (dc/close! (:conn f))))))
(deftest reopen-retains-cursor-and-original-future-deadline
 (let [f (fixture) holder (atom (:conn f))]
  (try
   (enqueue! f "a" "guest:a" 1) (enqueue! f "b" "guest:b" 1)
   (let [future (enqueue! f "future" "guest:c" 100000)
         _ (claim! f (first (candidates f 10)) 10)
         before (mapv :job/id (candidates f 10))
         cursor (:queue/dispatch-cursor (d/entity (d/db @holder) [:queue/key (name (:server f))]))]
    (dc/close! @holder) (reset! holder nil)
    (let [c (dc/connect-with (fjall/open (:path f)) []) reopened (assoc f :conn c)]
     (reset! holder c) (q/attach-store! (:server f) c)
     (is (= cursor (:queue/dispatch-cursor (d/entity (d/db c) [:queue/key (name (:server f))]))))
     (is (= before (mapv :job/id (candidates reopened 10))))
     (is (= 100000 (:job/at (d/entity (d/db c) (:db/id future)))))))
   (finally (when @holder (dc/close! @holder))))))
