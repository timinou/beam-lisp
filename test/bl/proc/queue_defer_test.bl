; Native journal unit facts only, no provider HTTP or synthetic live receipts.
(ns proc.queue-defer-test
 (:require [proc.queue :as q] [proc.queue-runtime :as owner]
           [datom :as d] [datom.conn :as dc] [datom.store-fjall :as fjall] [datom.store :as ds]))
(defn fixture []
 (let [suffix (String/downcase (Base/encode16 (crypto/strong_rand_bytes 8)))
       c (dc/connect-with (fjall/open (ds/fresh-path ".queue-defer.fjall")) [])
       srv (q/scoped-server (str "test.defer." suffix) :work)]
  (q/attach-store! srv c)
  (d/transact! c [{:db/id -1 :queue/key (name srv)
                   :queue/decl (assoc (q/normalise-decl {:of :test/defer :unique [:test/id]}) :server (name srv))}])
  {:conn c :server srv}))
(defn job! [f id]
 (q/enqueue! (:server f) {:test/id id} {:enrollment-key [:original id]}))
(defn row [f job] (d/entity (d/db (:conn f)) (:db/id job)))
(defn opts [] {:at (+ (erlang/system_time :millisecond) 60000) :reason :provider-pressure :basis [:receipt "original"]})
(deftest deferral-keeps-the-original-job-and-relinquishes-only-its-unsubmitted-claim
 (let [f (fixture)]
  (try
   (let [job (job! f "waiting") claimed (q/claim! (:conn f) job (erlang/system_time :millisecond) 60000)
         at (opts) result (q/defer-before-effect! (:server f) claimed at) after (row f job)]
    (is (= :deferred (:status result))) (is (= :stable (:durability result)))
    (is (= :queued (:job/state after))) (is (= (:at at) (:job/at after)))
    (is (= (:job/id job) (:job/id after)))
    (is (= (:job/enrollment job) (:job/enrollment after)))
    (is (= (:job/ticket job) (:job/ticket after)))
    (is (= (:job/payload job) (:job/payload after)))
    (is (empty? (:job/effects after))) (is (nil? (:job/owner after)))
    (is (= (:job/attempts claimed) (:job/attempts after)))
    (is (= (inc (:job/retry-base claimed 0)) (:job/retry-base after)))
    (is (= :refused (:status (q/commit-attempt! (:server f) claimed [[:db/add (:db/id job) :job/result :stale]]))))
    (is (= (:db/id job) (:db/id (job! f "waiting")))))
   (finally (dc/close! (:conn f))))))
(deftest deferral-refuses-all-begun-checkpoint-states-and-stale-claims
 (let [f (fixture)]
  (try
   (doseq [mode [:intent :submitted :uncertain :complete :absent]]
    (let [job (job! f mode) claimed (q/claim! (:conn f) job (erlang/system_time :millisecond) 60000)]
     (q/begin-effect! (:server f) claimed :provider)
     (case mode
      :intent nil
      :absent (q/reconcile-effect! (:server f) claimed :provider :absent {:fixture :known-absence})
      (q/record-effect! (:server f) claimed :provider mode {:fixture mode}))
     (let [before (row f job)]
      (is (= :effect-already-begun (:kind (q/defer-before-effect! (:server f) claimed (opts)))))
      (is (= before (row f job))))))
   (let [job (job! f "stale") before (row f job)]
    (is (= :stale-attempt (:kind (q/defer-before-effect! (:server f) job (opts)))))
    (is (= before (row f job))))
   (finally (dc/close! (:conn f))))))
