(ns proc.queue-generation-context-test
 (:require [proc.queue-runtime :as runtime] [proc.queue :as queue] [reload.generation :as generation]
           [datom :as d] [diagnostics :as diag]))
(defn graph [version]
 (generation/prepare! {:application-id "queue-context-regression" :protocols {:imports 1} :native-modules #{"Process"}
   :stable-namespaces #{"proc.queue-runtime" "diagnostics"}
   :sources {"queue.context" (str
    "(ns queue.context (:require [proc.queue-runtime :as runtime] [diagnostics :as diag]))
     (defn handler [gate began]
      (runtime/prepare :imports {:declaration {:of :context/work :protocol 1 :unique [:test/id]}
       :perform (fn [job]
        (when (= \"running\" (:test/id job))
          (reset! began true) (loop [] (when-not @gate (Process/sleep 5) (recur))))
        {:version " version " :generation (:digest (Process/get :bl_generation))
         :job-id (:diagnostics/job-id (diag/context))
         :trace-id (:diagnostics/trace-id (diag/context))
         :attempt-id (:diagnostics/attempt-id (diag/context))})}))")}}))
(defn wait-job [c id]
 (loop [left 500]
  (let [job (d/entity (d/db c) id)]
   (if (or (contains? #{:done :failed} (:job/state job)) (zero? left)) job
    (do (Process/sleep 10) (recur (dec left)))))))
(deftest pending-and-running-old-jobs-cross-real-generation-environments-without-scope-leakage
 (let [a (graph 1) b (graph 2) gate (atom false) began (atom false)
       ha (generation/invoke! a "queue.context/handler" [gate began])
       hb (generation/invoke! b "queue.context/handler" [gate began]) c (d/connect [])]
  (queue/attach-store! (:server ha) c)
  (let [pid (runtime/start! ha)]
   (try
    (let [running (generation/with! a #(queue/enqueue! :imports {:test/id "running"}))
          pending (generation/with! a #(queue/enqueue! :imports {:test/id "pending"} {:in [3600 :seconds]}))]
     (loop [left 500] (when (and (not @began) (pos? left)) (Process/sleep 10) (recur (dec left))))
     (is @began)
     (is (= :applied (:status (runtime/activate! (:server ha) (:digest a) hb))))
     (reset! gate true)
     (let [done (wait-job c (:db/id running))]
      (is (= :done (:job/state done)))
      (is (= (:digest a) (get-in done [:job/result :generation])))
      (is (= 1 (get-in done [:job/result :version])))
      (is (string? (get-in done [:job/result :trace-id]))))
     ;; Claim happens in the new dispatcher; body must retain the old Env.
     (d/transact! c [[:db/add (:db/id pending) :job/at (System/system_time :millisecond)]])
     (let [done (wait-job c (:db/id pending))]
      (is (= :done (:job/state done)))
      (is (= 1 (get-in done [:job/result :version])))
      (is (= (:digest a) (get-in done [:job/result :generation])))
      (is (string? (get-in done [:job/result :job-id])))
      (is (string? (get-in done [:job/result :attempt-id]))))
     (is (Process/alive? pid))
     (let [new (generation/with! b #(queue/enqueue! :imports {:test/id "new"})) done (wait-job c (:db/id new))]
      (is (= :done (:job/state done)))
      (is (= 2 (get-in done [:job/result :version])))
      (is (= (:digest b) (get-in done [:job/result :generation]))))
     ;; Scope safety is not relaxed by the queue integration repair.
     (let [captured (generation/with! a diag/capture)]
      (is (try (generation/with! b #(diag/with-captured-fn captured (fn [] true))) false
            (catch e (= :invalid-config (:kind (ex-data e))))))))
    (finally (reset! gate true) (runtime/stop! (:server ha)) (d/close! c)
             (generation/retire! a) (generation/retire! b))))))
