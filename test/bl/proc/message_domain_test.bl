(ns review.message-domain-test
 (:require [reload.generation :as g] [proc.message-domain :as domain]
           [test.support.source-fixtures :as fixtures]))
(fixtures/effects!)
(def SOURCE
 "(ns proof.messages)
  (defn any [value] true)
  (defn integer-input [value] (erlang/is_integer value))
  (defn identity-input [value] value)
  (defn literal-map [value] {:value value})
  (defn always-false [value] false)
  (defn discarded-map-read [value] (do (maps/get :key value nil) value))
  (defn discarded-let-map-read [value] (let [ignored (maps/get :key value nil)] value))
  (defn discarded-number [value] (do (pos? value) value))
  (defn protocol-read [value] (do (get value :key) value))
  (defn effect [value] (do (SourceEffectObserverFixture/put :message-domain-probe value) value))")
(defn- callback [graph name]
 (g/with! graph #(let [namespace (get (:mapping graph) "proof.messages")]
   {:function (BeamLisp.Env/fetch_exact! namespace name) :environment (BeamLisp.Env/capture)})))
(deftest actual-compiled-discarded-operations-must-be-total-in-the-old-domain
 (let [graph (g/prepare! {:application-id "message-domain-totality" :native-modules #{"erlang" "maps" "SourceEffectObserverFixture"} :sources {"proof.messages" SOURCE}})]
  (try
   (let [old (callback graph "any") candidate (callback graph "any")]
    (is (= :proved (:status (domain/compare-callbacks old (callback graph "identity-input") candidate))))
    (is (= :proved (:status (domain/compare-callbacks old (callback graph "literal-map") candidate))))
    (doseq [name ["discarded-map-read" "discarded-let-map-read" "discarded-number" "protocol-read" "effect"]]
     (is (= :unknown (:status (domain/compare-callbacks old (callback graph name) candidate)))))
    (is (= :unknown (:status (domain/compare-callbacks old (callback graph "identity-input")
                                     (callback graph "always-false"))))))
   (finally (g/retire! graph)))))
(deftest branch-products-refuse-before-materializing-a-large-cartesian-witness
 (let [leaf (fn [n] {:tag :strict-eq :left {:tag :input} :right {:tag :literal :value n}})
       choices (fn [offset] {:tag :or :terms (mapv #(leaf (+ offset %)) (range 32))})
       old {:tag :and :terms [(choices 0) (choices 100)]}]
  (is (= :message-domain-branch-budget
          (:reason (domain/compare-expressions old {:tag :input} {:tag :literal :value true}))))))
