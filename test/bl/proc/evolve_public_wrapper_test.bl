(ns review.evolve-public-wrapper-test
 (:require [reload.generation :as g] [reload.state :as state] [proc.evolve :as ev]))
(def OLD
 "(ns wrapper.business)
  (defn accepts [message] (erlang/is_binary message))
  (defn valid [value] (erlang/is_integer value))
  (defn handler [message value] {:reply message :state value})
  (defn spec [digest] {:version 1 :digest digest :handler handler :accept? accepts :check-state valid})")
(def NEW
 "(ns wrapper.business)
  (defn accepts [message] (erlang/is_binary message))
  (defn valid [value] (erlang/is_integer value))
  (defn identity-value [value] value)
  (defn handler [message value] {:reply message :state value})
  (defn spec [digest] {:version 2 :digest digest :handler handler :accept? accepts :check-state valid
                      :migrate-state identity-value :upcast identity-value})")
(def BAD (String/replace NEW "(erlang/is_binary message)" "(erlang/is_integer message)"))
(defn- graph [app source] (g/prepare! {:application-id app :sources {"wrapper.business" source}}))
(defn- spec [graph] (g/with! graph #(ev/prepare-spec (g/invoke! graph "wrapper.business/spec" [(:digest graph)]))))
(defn- with-owner [app source action]
 (let [old (graph app OLD) fresh (graph app source) pid (atom nil)]
  (try
   (g/with! old #(state/bind! {})) (g/inherit-runtime! fresh old)
   (reset! pid (g/with! old #(ev/start! (spec old) 3 {:managed true})))
   (action old fresh @pid)
   (finally (when (and @pid (Process/alive? @pid)) (GenServer/stop @pid))
            (g/retire! fresh) (g/retire! old)))))
(deftest existing-preparation-and-commit-wrappers-use-native-receiver-admission-automatically
 (with-owner "public-owner-tickets" NEW
  (fn [_ fresh pid]
   (let [value (spec fresh) prepared (g/with! fresh #(ev/prepare-upgrade! pid 1 value)) ticket (:ticket prepared)]
    (is (= :prepared (:status prepared)))
    (is (erlang/is_reference ticket))
    (is (= 1 (:version (ev/status pid))))
    (is (= :owner-transition-authority-required (:kind (GenServer/call pid [:proc.evolve/commit ticket]))))
    (is (= :owner-transition-authority-required (:kind (ev/commit-upgrade! pid ticket))))
    (is (= :applied (:status (g/with! fresh #(ev/commit-upgrade! pid ticket)))))
    (is (= :already-applied (:status (g/with! fresh #(ev/commit-upgrade! pid ticket)))))
    (is (= "old client" (ev/request! pid 1 "old client")))
    (is (= "new client" (ev/request! pid 2 "new client")))))))
(deftest existing-rehearsal-and-one-call-upgrade-keep-the-same-public-interface
 (with-owner "public-owner-upgrade" NEW
  (fn [_ fresh pid]
   (let [value (spec fresh)]
    (is (= :valid (:status (g/with! fresh #(ev/rehearse! pid 1 value 1000)))))
    (is (= false (:prepared? (ev/status pid))))
    (is (= 1 (:version (ev/status pid))))
    (is (= :applied (:status (g/with! fresh #(ev/upgrade! pid 1 value)))))
    (is (= :already-applied (:status (g/with! fresh #(ev/upgrade! pid 1 value)))))
    ;; Same actual candidate G does not identify another target version/spec.
    (is (= :identity-conflict
           (:kind (g/with! fresh #(ev/upgrade! pid 2 (assoc value :version 3))))))
    (is (= 2 (:version (ev/status pid))))
    (is (= :identity-conflict
           (:kind (g/with! fresh #(ev/upgrade! pid 1 (assoc value :digest "another-artifact"))))))
    (is (= "still valid" (ev/request! pid 1 "still valid")))))))
(deftest unsupported-domains-and-copied-context-return-typed-retained-owner-refusals
 (with-owner "public-owner-refusal" BAD
  (fn [_ fresh pid]
   (let [value (spec fresh) refused (g/with! fresh #(ev/upgrade! pid 1 value))]
    (is (= :refused (:status refused)))
    (is (= :unproved-message-migration (:kind refused)))
    (is (= 1 (:version (ev/status pid))))
    (is (= "retained" (ev/request! pid 1 "retained")))
    (let [previous (BeamLisp.Env/capture) token (g/with! fresh #(BeamLisp.Env/capture))]
     (try
      (BeamLisp.Env/bind token)
      (is (= :owner-transition-authority-required (:kind (ev/prepare-upgrade! pid 1 value))))
      (finally (BeamLisp.Env/bind previous))))))))
(deftest explicit-message-samples-remain-part-of-the-existing-public-preparation-contract
 (with-owner "public-owner-samples" NEW
  (fn [_ fresh pid]
   (let [value (spec fresh)
         bad (g/with! fresh #(ev/prepare-upgrade! pid 1 value [{:version 1 :message 42}]))]
    (is (= :refused (:status bad)))
    (is (= :candidate-refused (:kind bad)))
    (is (= false (:prepared? (ev/status pid))))
    (let [good (g/with! fresh #(ev/prepare-upgrade! pid 1 value [{:version 1 :message "explicit"}]))]
     (is (= :prepared (:status good)))
     (is (erlang/is_reference (:ticket good)))
     (is (= :cancelled (:status (g/with! fresh #(ev/cancel-upgrade! pid (:ticket good)))))))
    (is (= 1 (:version (ev/status pid))))))))
