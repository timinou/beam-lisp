; Native runtime fixtures; HOME Source draft, no execution/authority fabricated.
(ns proc.message-domain-case-test
 (:require [reload.generation :as g] [proc.message-domain :as domain] [test.support.source-fixtures :as fixtures]))
(fixtures/effects!)
(def SOURCE
 "(ns domain.routes)
  (defn integer-input [value] (erlang/is_integer value))
  (defn via-helper [value] (integer-input value))
  (defn identity-input [value] value)
  (defn any [value] true)
  (defn partial-map-input [value] (do (maps/get :key value nil) value))
  (defn effect-input [value] (do (SourceEffectObserverFixture/notify (erlang/self) :route-effect) value))
  (defn higher-order-input [value] ((fn [x] x) value))")
(defn callback [graph name]
 (g/with! graph
  #(let [namespace (get (:mapping graph) "domain.routes")]
    {:function (BeamLisp.Env/fetch_exact! namespace name)
     :environment (BeamLisp.Env/capture)})))
(defn capture [record] (domain/capture (:function record) (:environment record)))
(def INPUT {:tag :input})
(def THREE {:tag :literal :value 3})
(def FOUR {:tag :literal :value 4})
(def TRUE {:tag :literal :value true})
(defn equality [tag right] {:tag tag :left INPUT :right right})

(deftest scalar-equality-case-routes-preserve-each-exact-relation
 (doseq [tag [:eq :bl-eq :num-eq :strict-eq]]
  (let [old (equality tag THREE) changed (equality tag FOUR)]
   (is (= :proved (:status (domain/compare-expressions old INPUT old))))
   (is (= :unknown (:status (domain/compare-expressions old INPUT changed)))))))

(deftest conjunction-and-disjunction-substitute-all-terms-without-widening
 (let [equal-three (equality :strict-eq THREE) equal-four (equality :strict-eq FOUR)
       integer {:tag :type :type :integer :value INPUT}
       old {:tag :and :terms [integer equal-three]}
       preserved-or {:tag :or :terms [equal-four equal-three]}
       refused-and {:tag :and :terms [integer equal-four]}]
  (is (= :proved (:status (domain/compare-expressions old INPUT old))))
  (is (= :proved (:status (domain/compare-expressions old INPUT preserved-or))))
  (is (= :unknown (:status (domain/compare-expressions old INPUT refused-and))))
  (is (= :unknown-message-expression
       (:reason (domain/compare-expressions old {:tag :unsupported} TRUE))))))

(deftest actual-published-remote-and-transitive-helper-callbacks-are-lifted
 (let [graph (g/prepare! {:application-id "message-domain-case-routes"
                         :native-modules #{"erlang" "maps" "SourceEffectObserverFixture"}
                         :sources {"domain.routes" SOURCE}})]
  (try
   (let [direct (callback graph "integer-input") helper (callback graph "via-helper")
         identity (callback graph "identity-input") proof (capture direct) other (capture helper)]
    (is (= :proved (:status proof)))
    (is (= {:tag :type :type :integer :value INPUT} (:expression proof)))
    (is (contains? (:modules proof) :erlang))
    (is (= :proved (:status other)))
    (is (= (:expression proof) (:expression other)))
    (is (= 2 (count (:definitions other))))
    (is (= :proved (:status (domain/compare-callbacks direct identity helper))))
    ;; These routes must still inspect every evaluated term and refuse unknown
    ;; effects/partial operations. Correct case dispatch is not permission.
    (is (= :unknown (:status (domain/compare-callbacks
                 (callback graph "any") (callback graph "partial-map-input") direct))))
    (is (= :unknown (:status (capture (callback graph "effect-input")))))
    (is (= :unknown (:status (capture (callback graph "higher-order-input")))))
    (is (= :empty (receive :route-effect :unexpected (after 0 :empty)))))
   (finally (g/retire! graph)))))
