(ns proc.queue-enrollment-test
 (:require [proc :as proc] [proc.queue :as q] [datom :as d]
           [datom.conn :as dc] [datom.store-map :as sm]))
(proc/defserver worker
 (queue {:of :test/enrollment :server (:server start-opts) :clock (fn [] 1000)
         :unique [:test/key] :concurrency 1})
 (perform [job] (:test/value job)))
(defn finished [srv job]
 (loop [n 0]
  (let [current (d/entity (d/db (q/conn srv)) (:db/id job))]
   (cond (= :done (:job/state current)) current
         (> n 1000) (throw "Enrollment job did not finish")
         :else (do (Process/sleep 5) (recur (inc n)))))))
(deftest durable-enrollment-is-independent-of-the-outstanding-window
 (let [srv :enrollment-test conn (dc/connect-with (sm/open) [])]
  (q/attach-store! srv conn)
  (let [pid (start worker {:server srv} {})]
   (try
    (let [payload {:test/key "first" :test/value 1}
          a (q/enqueue! srv payload {:at 1000 :enrollment-key ["source" "revision"]})]
     (finished srv a)
     (let [b (q/enqueue! srv payload {:at 1000 :enrollment-key ["source" "revision"]})]
      (is (= (:job/id a) (:job/id b)))
      (is (= :done (:job/state b))) (is (= false (:job/created b))))
     (is (try (q/enqueue! srv (assoc payload :test/value 2)
                {:at 1000 :enrollment-key ["source" "revision"]}) false (catch _ true)))
     (is (try (q/enqueue! srv payload {:at 1000 :protocol 2 :enrollment-key ["source" "revision"]}) false (catch _ true)))
     (let [c (q/enqueue! srv payload {:at 1000 :enrollment-key ["source" "revision-2"]})]
      (is (not= (:job/id a) (:job/id c))) (finished srv c))
     (let [normal (q/enqueue! srv {:test/key "normal"} {:at 1000})]
      (finished srv normal)
      (is (not= (:job/id normal) (:job/id (q/enqueue! srv {:test/key "normal"} {:at 1000})))))
     (is (try (q/enqueue! srv payload {:enrollment-key nil}) false (catch _ true))))
    (finally (stop pid))))
  ;; The identity is in Datom, not this process's memory.
  (let [pid (start worker {:server srv} {})]
   (try
    (is (= :done (:job/state (q/enqueue! srv {:test/key "first" :test/value 1}
           {:at 1000 :enrollment-key ["source" "revision"]}))))
    (finally (stop pid))))))
