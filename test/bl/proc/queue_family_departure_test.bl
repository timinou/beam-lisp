; HOME Source draft. Actual native actor fixture; runtime acceptance UNRUN.
(ns proc.queue-family-departure-test
 (:require [reload.generation :as g] [proc.queue :as queue] [proc.queue-family :as family] [datom :as d]))
(defn graph [application marker]
 (g/prepare! {:application-id application :native-modules #{"File"}
  :sources {"departure.fixture"
   (str "(ns departure.fixture (:require [proc.server :as server] [proc.queue :as q] [proc.owner-registry :as owners])) "
        "(defn config-for [srv policy opts] (File/write! " (pr-str marker) " \"factory\") "
        " {:projection {:ident :departure/example} :conn-fn (fn [_] (:conn opts)) "
        "  :scope-fn (fn [_ _] []) :apply (fn [_ _] nil) :level nil}) "
        "(server/defserver worker (reconcile {:server (:queue start-opts) :config-fn config-for :level nil}) "
        " (handle-call :invalidate-native-index [_ st] "
        "   (owners/unregister! (:membership (owners/current-owner-capability))) (reply :invalidated st))) "
        "(defn start! [opts] (start worker opts))")}}))
(defn start! [graph mirror] (g/invoke! graph "departure.fixture/start!" [{:queue :same :conn mirror}]))
(defn stopped! [pid]
 (let [ref (Process/monitor pid)]
  (when (Process/alive? pid) (try (GenServer/stop pid :normal 10000) (catch _ nil)))
  (receive [:DOWN seen :process child _] :when (and (= seen ref) (= child pid)) true (after 10000 false))))

(deftest stale-index-does-not-authorize-replacing-an-actual-living-family-actor
 (let [path (str (System/get_env "HOME") "/tmp/family-departure-" (erlang/unique_integer (list :positive)))
       application (str "family-departure-" (erlang/unique_integer (list :positive)))
       graph (graph application path) mirror (d/connect []) actor (start! graph mirror)]
  (try
   (is (File/exists? path))
   (is (= :invalidated (GenServer/call actor :invalidate-native-index)))
   (is (Process/alive? actor))
   (is (nil? (family/member-evidence application (name (queue/scoped-server application :same)))))
   (File/rm! path)
   (is (try (start! graph mirror) false
         (catch error (String/contains? (str error) "queue-family-instance-still-owned"))))
   (is (Process/alive? actor))
   (is (not (File/exists? path)))
   (is (stopped! actor))
   ;; A genuine fresh native monitor now observes this exact PID's DOWN. The
   ;; new actual generated actor may reclaim the same source family instance.
   (let [replacement (start! graph mirror)]
    (try
     (is (Process/alive? replacement))
     (is (not= actor replacement))
     (is (File/exists? path))
     (finally (stopped! replacement))))
   (finally (when (Process/alive? actor) (stopped! actor))
    (d/close! mirror) (g/retire! graph) (when (File/exists? path) (File/rm! path))))))
