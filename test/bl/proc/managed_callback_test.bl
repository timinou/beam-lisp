(ns proc.managed-callback-test
 (:require [reload.generation :as generation] [proc.callback :as callback]))

(deftest managed-callback-pins-transitive-graph-until-explicit-release
 (let [g (generation/prepare!
          {:application-id "callback-retention"
           :stable-namespaces #{"proc.callback"}
           :sources {"callback.dependency"
                     "(ns callback.dependency) (defn value [] :old-dependency) (defn physical [] (fn [] nil))"
                     "callback.entry"
                     "(ns callback.entry (:require [callback.dependency :as dependency] [proc.callback :as callback])) (defn retain [] (callback/register! (fn [] (dependency/value))))"}})
       registrations (atom [])]
  (try
   (let [registration (generation/invoke! g "callback.entry/retain" [])
         _ (swap! registrations conj registration)
         dependency (generation/invoke! g "callback.dependency/physical" [])
         modules (BeamLisp.Env/callback_modules dependency)]
    ;; Nothing is executing in dependency; only the retained whole-graph
    ;; registration prevents its physical code from being soft-purged.
    (is (= false (BeamLisp.Env/retire_modules! modules)))
    (is (= :waiting (:status (generation/retire! g))))
    (is (= :old-dependency (callback/invoke! registration [])))
    (callback/unregister! registration)
    (is (= :cancelled (callback/invoke! registration [])))
    (is (= :retired (:status (generation/retire! g)))))
   (finally
    (doseq [registration @registrations] (callback/unregister! registration))
    (generation/retire! g)))))
