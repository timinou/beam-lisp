; test/bl/native_lib_path_test.bl — where `vm.native/lib-path` finds a crate.
;
; `bl build --native` installs a project's crate at <root>/priv/native/<crate>.so
; (`project-installed-path`). Before a22c9474 NOTHING read that path: the search
; asked the loaded apps, then beam_lisp's own priv, so a crate the project had
; just built answered ABSENT with its .so sitting in the tree. The roots the
; LOADER searches (cwd, BEAM_LISP_PATH, pushed search paths) are the roots a
; native can live under, so `lib-path` searches them too.
;
; What is pinned here, and why each is a separate test:
;
;   1. a crate under a PUSHED search path resolves — the path `bl run` and a
;      daemon request both use, and the one a project's `env.bl :paths` feeds;
;   2. a crate under BEAM_LISP_PATH resolves — the ambient, per-process case;
;   3. a crate that exists NOWHERE falls back to beam_lisp's priv, so a load
;      error names a sensible location instead of nil. That fallback is the
;      contract `lib-path`'s docstring makes and an `or` refactor can lose;
;   4. a root without the `.so` is skipped — the check is the artifact, never
;      the directory (a half-built tree must not shadow a real crate below it).
;
; The `.so` is an empty file: `lib-path` only asks whether it EXISTS; loading is
; `load-nif`'s job and is covered by native_test.bl against a real cdylib.
;
; Run: bin/bl test test/bl/native_lib_path_test.bl

(ns test.native-lib-path
  (:require [vm.native :as n]))

(def root (str (System/tmp_dir!) "/bl_native_lib_path_" (System/system_time :millisecond)))

(defn- install! [dir crate]
  (File/mkdir_p! (str dir "/priv/native"))
  (File/write! (str dir "/priv/native/" crate ".so") ""))

(defn- fresh! [name]
  (let [d (str root "/" name)]
    (File/rm_rf! d)
    (File/mkdir_p! d)
    d))

(deftest a-pushed-search-path-resolves-a-project-crate
  (let [d (fresh! "pushed")]
    (install! d "pushed_crate")
    (BeamLisp.Env/add_search_path d)
    (try
      (is (= (str d "/priv/native/pushed_crate") (n/lib-path "pushed_crate"))
          "the crate a project built is found where the build put it")
      (finally (BeamLisp.Env/remove_search_path d)))))

(deftest a-crate-nowhere-falls-back-to-beam-lisps-priv
  (let [p (n/lib-path "no_such_crate_anywhere")]
    (is (string? p) "a load error needs a path to name, not nil")
    (is (= (str (BeamLisp.Tiers/priv_root) "/native/no_such_crate_anywhere") p))))

(deftest a-root-without-the-artifact-is-skipped
  (let [empty-root (fresh! "empty")
        real-root (fresh! "real")]
    (File/mkdir_p! (str empty-root "/priv/native"))
    (install! real-root "shadowed_crate")
    (BeamLisp.Env/add_search_path empty-root)
    (BeamLisp.Env/add_search_path real-root)
    (try
      (is (= (str real-root "/priv/native/shadowed_crate") (n/lib-path "shadowed_crate"))
          "an earlier root that has the directory but not the .so must not win")
      (finally
        (BeamLisp.Env/remove_search_path empty-root)
        (BeamLisp.Env/remove_search_path real-root)))))

(deftest the-nearest-root-wins
  (let [a (fresh! "near")
        b (fresh! "far")]
    (install! a "ordered_crate")
    (install! b "ordered_crate")
    (BeamLisp.Env/add_search_path a)
    (BeamLisp.Env/add_search_path b)
    (try
      (is (= (str a "/priv/native/ordered_crate") (n/lib-path "ordered_crate"))
          "roots are searched in the order the loader searches them")
      (finally
        (BeamLisp.Env/remove_search_path a)
        (BeamLisp.Env/remove_search_path b)))))

(deftest cleanup
  (File/rm_rf! root)
  (is (not (File/exists? root))))
