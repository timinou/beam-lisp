(ns aot.definition-collection-test)
(defn compiled-definitions [source]
 (let [out (str (System/tmp_dir!) "/aot-collected-" (erlang/unique_integer (list :positive)))]
  (try
   (BeamLisp.AOT/compile_source source (list (tuple :output_dir out)))
   (erlang/apply (BeamLisp.Emit/module_for "collected.fixture") :__bl_ns_defs__ (list))
   (finally (File/rm_rf! out)))))

(deftest generated-definitions-are-emitted-without-inherited-asts
 (let [e (BeamLisp.Env/fork :global)]
  (try
   (BeamLisp.Env/with_env e (fn []
    (BeamLisp.Compiler/eval_string "(ns collected.fixture) (defn inherited [] 99)")
    (let [defs (compiled-definitions
                "(ns collected.fixture) (defmacro make [] '(defn generated [x] (+ x 7))) (make) (defn ordinary [] 3)")]
     (is (contains? defs "generated"))
     (is (contains? defs "ordinary"))
     (is (not (contains? defs "inherited")))
     (is (= 12 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! "collected.fixture" "generated") (list 5))))
     (is (nil? (Process/get :bl_definition_collector))))))
   (finally (BeamLisp.Env/destroy e)))))

(deftest failed-and-nested-collection-restores-parent-bookkeeping
 (let [prior (Process/get :bl_definition_collector)
       parent {:env (BeamLisp.Env/env_id) :names {"parent" #{"kept"}}}
       out (str (System/tmp_dir!) "/aot-failure-" (erlang/unique_integer (list :positive)))]
  (try
   (Process/put :bl_definition_collector parent)
   (compiled-definitions "(ns collected.fixture) (defn ok [] 1)")
   (is (= parent (Process/get :bl_definition_collector)))
   (is (try (BeamLisp.AOT/compile_source
             "(ns collected.fixture) (defn partial [] 1) (throw :failed)"
             (list (tuple :output_dir out))) false (catch _ true)))
   (is (= parent (Process/get :bl_definition_collector)))
   (finally (File/rm_rf! out)
    (if prior (Process/put :bl_definition_collector prior) (Process/delete :bl_definition_collector))))))


(deftest defining-macro-sequences-retain-value-initializers-in-fresh-replay
 (let [ns (str "macrosequence" (erlang/unique_integer (list :positive)))
       dir (str (System/tmp_dir!) "/" ns)
       source (str "(ns " ns " (:require [proc.super :as super])) "
                   "(defserver worker (init [_] (ok {}))) "
                   "(super/defsupervisor tree (child :worker worker nil))")
       build-env (BeamLisp.Env/fork :global) replay-env (BeamLisp.Env/fork :global)]
  (try
   (BeamLisp.Env/with_env build-env
    (fn [] (BeamLisp.AOT/compile_source source
             (list (tuple :output_dir dir)))))
   (BeamLisp.Env/with_env replay-env
    (fn []
     (is (= :error (BeamLisp.Env/fetch_exact ns "tree")))
     (erlang/apply (BeamLisp.Link/module_for ns) :__bl_init__ (list))
     (let [descriptor (BeamLisp.Env/fetch_exact! ns "tree")]
      (is (= true (:__supervisor__ descriptor)))
      (is (some? (:children-factory descriptor))))))
   (finally (BeamLisp.Env/destroy build-env) (BeamLisp.Env/destroy replay-env)
            (File/rm_rf! dir)))))
