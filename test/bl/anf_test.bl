; anf_test.bl — bl-ANF is a faithful IR (PLAN-079 S-B).
;
; Two properties, one corpus:
;   1. normalise(quoted) evaluated by the REFERENCE INTERPRETER == the value the
;      Elixir backend computes for the same source. bl-ANF has the right meaning.
;   2. The IR is data: every node is a map with an :op and an :ann slot (the
;      MLIR-op shape S-C/S-D and PLAN-080 depend on).

(ns anf.test
  (:require [compiler :as c] [self.anf :as a]))

(def kenv (assoc (c/new-env "user") :ns "user"))
(defn- quoted-of [src] (c/compile (BeamLisp.Reader/read_one src) kenv))
(defn- via-elixir [q] (first (erlang/tuple_to_list (Code/eval_quoted q))))
(defn- via-anf [src] (a/interp (a/normalise (quoted-of src)) {}))

(defn- same? [src] (= (via-elixir (quoted-of src)) (via-anf src)))

(deftest literals-and-collections
  (testing "leaves, tuples, maps, vectors, lists all normalise + interp identically"
    (is (same? "42"))
    (is (same? "\"hi\""))
    (is (same? ":kw"))
    (is (same? "(erlang/list_to_tuple (list 1 2 3))"))
    (is (same? "{:a 1 :b 2}"))
    (is (same? "(list 1 2 3)"))))

(deftest host-calls-and-globals
  (testing "remote calls and Env-global var references"
    (is (same? "(+ 1 2)"))
    (is (same? "(erlang/tuple_size (erlang/list_to_tuple (list 1 2 3)))"))
    (is (same? "(first (list 1 2))"))
    (is (same? "(map inc (list 1 2 3))"))
    (is (same? "(reduce + 0 (list 1 2 3 4))"))))

(deftest binding-and-control
  (testing "let, if truthiness, cond, and blocks"
    (is (same? "(let [x 5 y 3] (* x y))"))
    (is (same? "(if (> 3 2) :y :n)"))
    (is (same? "(if nil :y :n)"))
    (is (same? "(if false :y :n)"))
    (is (same? "(cond (> 1 2) :a (< 1 2) :b :else :c)"))))

(deftest fns-and-matching
  (testing "closures, variadic, multi-clause dispatch, case, destructuring"
    (is (same? "((fn [n] (* n n)) 6)"))
    (is (same? "((fn [x & xs] (count xs)) 1 2 3 4)"))
    (is (same? "(let [f (fn ([a] :one) ([a b] :two))] [(f 1) (f 1 2)])"))
    (is (same? "(let [[a b] (list 1 2)] (+ a b))"))
    (is (same? "(case 2 1 :one 2 :two 3 :three :other)"))))

(deftest errors
  (testing "try/throw/catch and finally"
    (is (same? "(try (throw :x) (catch e (ex-message e)))"))
    (is (same? "(try (+ 1 (throw {:boom 1})) (catch e (ex-data e)))"))
    (is (same? "(let [a (atom 0)] (try (throw :x) (catch e (swap! a inc)) (finally (swap! a (fn [n] (+ n 10))))) (deref a))"))))

(deftest ir-is-data
  (testing "every node is a map with :op and an :ann attribute slot (MLIR-op shape)"
    (let [n (a/normalise (quoted-of "(let [x 1] (+ x 2))"))]
      (is (map? n))
      (is (= :let (:op n)))
      (is (map? (:ann n)))
      (is (= :remote (:op (:body n))))
      (is (= :erlang (:mod (:body n)))))))

(deftest census-full-vocabulary
  (testing "normalise covers every form the compiler emits over a real corpus"
    ; The structural coverage gate: normalise must accept EVERY node the
    ; compiler produces over real prelude source (compiler.bl included — the
    ; compiler normalising its own source). A throw here means a node kind the
    ; IR does not model yet. 430+ forms, zero rejected.
    ; A FRESH env per file, distinct from kenv: compiling 430 prelude forms
    ; (defs) into the shared "user" env would intern hundreds of vars and
    ; pollute the value-identity tests. The census only needs a compile env to
    ; produce quoted output to normalise; correctness of that output is the
    ; value tests' job, so a throwaway ns is right here.
    (let [census (fn [path]
                   (let [cenv (assoc (c/new-env "anfcensus") :ns "anfcensus")
                         forms (BeamLisp.Reader/read_all (File/read! path))]
                     (count
                       (filter
                         (fn [form]
                           (let [cr (try (c/compile form cenv) (catch e :skip))]
                             (if (= :skip cr) false
                               (try (do (a/normalise cr) false)
                                    (catch e true)))))
                         forms))))
          fails (reduce + 0 (map census
                                  (list "priv/boot/core.bl" "priv/boot/sugar.bl"
                                        "priv/boot/compiler.bl" "priv/boot/reader.bl"
                                        "priv/std/multi.bl" "priv/std/optics.bl")))]
      (is (= 0 fails)))))

(run-tests)
