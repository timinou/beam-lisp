; anf_test.bl — canonical compiler ANF is faithful, structured IR.

(ns anf.test
  (:require [compiler :as c]))

(BeamLisp.Env/add_search_path (BeamLisp.Tiers/priv_root))
(BeamLisp.Loader/ensure_loaded "self.anf")

(def kenv (assoc (c/new-env "user") :ns "user"))
(defn- compile-anf [src] (c/compile (BeamLisp.Reader/read_one src) kenv))
(defn- via-runtime [src] (BeamLisp.Compiler/eval_string src))
(defn- via-anf [src] (self.anf/interp (compile-anf src) {}))
(defn- same? [src] (= (via-runtime src) (via-anf src)))

(deftest literals-and-collections
  (testing "canonical leaves and collections interpret identically"
    (is (same? "42")) (is (same? "\"hi\"")) (is (same? ":kw"))
    (is (same? "(erlang/list_to_tuple (list 1 2 3))"))
    (is (same? "{:a 1 :b 2}")) (is (same? "(list 1 2 3)"))))

(deftest host-calls-and-globals
  (testing "remote calls and Env-global var references"
    (is (same? "(+ 1 2)"))
    (is (same? "(erlang/tuple_size (erlang/list_to_tuple (list 1 2 3)))"))
    (is (same? "(first (list 1 2))"))
    (is (same? "(map inc (list 1 2 3))"))
    (is (same? "(reduce + 0 (list 1 2 3 4))"))))

(deftest binding-and-control
  (testing "let, if truthiness, cond, and blocks"
    (is (same? "(let [x 5 y 3] (* x y))"))
    (is (same? "(if (> 3 2) :y :n)")) (is (same? "(if nil :y :n)"))
    (is (same? "(if false :y :n)"))
    (is (same? "(cond (> 1 2) :a (< 1 2) :b :else :c)"))))

(deftest fns-and-matching
  (testing "closures, variadic, multi-clause dispatch, case, destructuring"
    (is (same? "((fn [n] (* n n)) 6)"))
    (is (same? "((fn [x & xs] (count xs)) 1 2 3 4)"))
    (is (same? "(let [f (fn ([a] :one) ([a b] :two))] [(f 1) (f 1 2)])"))
    (is (same? "(let [[a b] (list 1 2)] (+ a b))"))
    (is (same? "(case 2 1 :one 2 :two 3 :three :other)"))))

(deftest errors
  (testing "try/throw/catch and finally"
    (is (same? "(try (throw :x) (catch e (ex-message e)))"))
    (is (same? "(try (+ 1 (throw {:boom 1})) (catch e (ex-data e)))"))
    (is (same? "(let [a (atom 0)] (try (throw :x) (catch e (swap! a inc)) (finally (swap! a (fn [n] (+ n 10))))) (deref a))"))))

(deftest ir-is-data
  (testing "every canonical node has the MLIR-op shape and source metadata"
    (let [n (compile-anf "(let [x 1] (+ x 2))")]
      (is (map? n)) (is (= :let (:op n))) (is (map? (:ann n)))
      (is (= :remote (:op (:body n)))) (is (= :erlang (:mod (:body n)))))))

(deftest census-full-vocabulary
  (testing "canonical compile accepts every supported form in the real corpus"
    (let [census (fn [path]
                   (let [cenv (assoc (c/new-env "anfcensus") :ns "anfcensus")
                         forms (BeamLisp.Reader/read_all (File/read! path))]
                     (count (filter (fn [form]
                                      (try (do (c/compile form cenv) false)
                                           (catch e true)))
                                    forms))))
          fails (reduce + 0 (map census
                                  (list "priv/boot/core.bl" "priv/boot/sugar.bl"
                                        "priv/boot/compiler.bl" "priv/boot/reader.bl"
                                        "priv/std/multi.bl" "priv/std/optics.bl")))]
      (is (= 0 fails)))))

(run-tests)
