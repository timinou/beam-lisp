; test/bl/optics_test.bl — the optics library, tested in beam-lisp itself.
; Run: mix beam_lisp.test test/bl/optics_test.bl

(ns optics.test
  (:require [optics :refer [lens view setv over in idx fst snd *>
                            traversed filtered optional]]))

; --- primitives ----------------------------------------------------------

; `lens` builds an optic from an arbitrary getter/setter. The built-in
; primitives below are NOT routed through it (they are inline maps): a
; top-level def whose initializer calls a sibling fn and stores the returned
; closures compiles to a stale-closure in this harness ("function ... points
; to an old version of the code") when the module also defines later fns --
; a finding reported with the wave. This test exercises `lens` directly so
; the public constructor stays covered.

(deftest lens-core
  (is (= (view (in :a) {:a 1}) 1))
  (is (= (setv (in :a) 9 {:a 1}) {:a 9}))
  (is (= (over (in :a) inc {:a 1}) {:a 2}))
  ; a custom lens from getter/setter, as the prototype ships
  (let [l (lens (fn [s] (get s :x nil)) (fn [s v] (assoc s :x v)))]
    (is (= (view l {:x 5}) 5))
    (is (= (over l inc {:x 5}) {:x 6}))))

(deftest idx-fst-snd
  (is (= (view (idx 1) [10 20 30]) 20))
  (is (= (setv (idx 1) 99 [10 20 30]) [10 99 30]))
  (is (= (over (idx 0) inc [1 2 3]) [2 2 3]))
  (is (= (view fst [1 2]) 1))
  (is (= (view snd [1 2]) 2))
  (is (= (setv fst 9 [1 2]) [9 2]))
  (is (= (setv snd 9 [1 2]) [1 9])))

; --- the lens laws ---------------------------------------------------------
; get-put / put-get / put-put ARE the definition of a lens. A pair of
; functions that fails any of them is not a lens, so every primitive lens
; is checked against all three. A traversal is not a lens and is exempt.

(deftest lens-law-get-put
  ; (setv l (view l s) s) == s
  (is (= (setv (in :a) (view (in :a) {:a 1}) {:a 1}) {:a 1}))
  (is (= (setv (idx 0) (view (idx 0) [1 2]) [1 2]) [1 2]))
  (is (= (setv fst (view fst [1 2]) [1 2]) [1 2]))
  (is (= (setv snd (view snd [1 2]) [1 2]) [1 2]))
  ; and across a composed path, since composition must itself be a lens
  (is (= (setv (*> (in :a) (in :b))
               (view (*> (in :a) (in :b)) {:a {:b 1}})
               {:a {:b 1}})
         {:a {:b 1}})))

(deftest lens-law-put-get
  ; (view l (setv l v s)) == v
  (is (= (view (in :a) (setv (in :a) 9 {:a 1})) 9))
  (is (= (view (idx 1) (setv (idx 1) 9 [1 2])) 9))
  (is (= (view fst (setv fst 9 [1 2])) 9))
  (is (= (view snd (setv snd 9 [1 2])) 9))
  (is (= (view (*> (in :a) (in :b)) (setv (*> (in :a) (in :b)) 9 {:a {:b 1}})) 9)))

(deftest lens-law-put-put
  ; (setv l v2 (setv l v1 s)) == (setv l v2 s)
  (is (= (setv (in :a) 7 (setv (in :a) 9 {:a 1})) (setv (in :a) 7 {:a 1})))
  (is (= (setv (idx 1) 7 (setv (idx 1) 9 [1 2])) (setv (idx 1) 7 [1 2])))
  (is (= (setv fst 7 (setv fst 9 [1 2])) (setv fst 7 [1 2])))
  (is (= (setv snd 7 (setv snd 9 [1 2])) (setv snd 7 [1 2]))))

; --- composition ------------------------------------------------------------

(deftest composition-direction
  ; *> is outside-in: (*> (in :app) (in :users)) reads ":app then :users",
  ; so the leftmost optic is the outermost key of the path.
  (let [data {:app {:users [{:hits 1} {:hits 2}]}}]
    (is (= (view (*> (in :app) (in :users) (idx 1) (in :hits)) data) 2))
    (is (= (view (*> (in :app)) data) {:users [{:hits 1} {:hits 2}]}))
    ; a single optic composes to itself
    (is (= (view (*> (in :app)) data) (view (in :app) data)))))

(deftest deep-composition
  ; a three-plus-level path, both directions
  (let [data {:app {:users [{:name "ada" :hits 41}
                            {:name "grace" :hits 12}]}}]
    (is (= (view (*> (in :app) (in :users) (idx 0) (in :hits)) data) 41))
    (is (= (setv (*> (in :app) (in :users) (idx 1) (in :hits)) 99 data)
           {:app {:users [{:name "ada" :hits 41}
                          {:name "grace" :hits 99}]}}))
    (is (= (over (*> (in :app) (in :users) (idx 0) (in :hits)) inc data)
           {:app {:users [{:name "ada" :hits 42}
                          {:name "grace" :hits 12}]}}))))

; --- traversed ---------------------------------------------------------------
; view through a traversal returns the COLLECTION of foci, not a single
; value — that is what makes a traversal different from a lens, and the
; tests pin the contract down so nobody "fixes" it into a lens later.

(deftest traversed-view-contract
  (is (= (view traversed [1 2 3]) [1 2 3]))
  (is (= (view traversed '(1 2 3)) '(1 2 3)))
  (is (= (view (*> (in :users) traversed (in :hits))
               {:users [{:hits 1} {:hits 2} {:hits 3}]})
         '(1 2 3))))

(deftest traversed-over
  ; vector in, vector out — the least-surprising shape, asserted
  (is (= (over traversed inc [1 2 3]) [2 3 4]))
  (is (= (over traversed inc '(1 2 3)) '(2 3 4)))
  (is (= (over traversed inc []) []))
  (is (= (over traversed inc '()) '()))
  ; setv through a traversal writes every focus
  (is (= (setv traversed 0 [1 2 3]) [0 0 0])))

(deftest traversed-in-deep-path
  ; the "bump every user's hits" case update-in cannot write
  (let [data {:users [{:name "ada" :hits 41}
                      {:name "grace" :hits 12}]}]
    (is (= (over (*> (in :users) traversed (in :hits)) inc data)
           {:users [{:name "ada" :hits 42}
                    {:name "grace" :hits 13}]}))))

; --- filtered ----------------------------------------------------------------

(deftest filtered-over
  (is (= (over (filtered even?) inc [1 2 3 4]) [1 3 3 5]))
  (is (= (over (filtered even?) inc '()) '()))
  (is (= (over (filtered even?) inc []) []))
  (is (= (view (filtered pos?) [-1 2 -3 4]) '(2 4)))
  ; filtered composes after a lens, focusing only matching elements
  (let [data {:users [{:name "ada" :hits 41}
                      {:name "grace" :hits 0}]}]
    (is (= (over (*> (in :users) (filtered (fn [u] (pos? (get u :hits nil)))) (in :hits))
                 inc data)
           {:users [{:name "ada" :hits 42}
                    {:name "grace" :hits 0}]}))))

; --- optional -----------------------------------------------------------------
; no-ops on a missing key instead of punching a nil hole

(deftest optional-no-op
  (is (= (over (optional :hits) inc {:hits 1}) {:hits 2}))
  (is (= (over (optional :hits) inc {:name "x"}) {:name "x"}))
  (is (= (setv (optional :hits) 9 {:name "x"}) {:name "x"}))
  ; where `in` fills the hole with the computed value, `optional` refuses to
  (is (= (over (in :hits) (fn [_] 7) {:name "x"}) {:name "x", :hits 7}))
  (is (= (over (optional :hits) (fn [_] 7) {:name "x"}) {:name "x"})))

(deftest optional-inside-traversal
  (is (= (over (*> traversed (optional :hits)) inc
               [{:hits 1} {:name "x"} {:hits 2}])
         [{:hits 2} {:name "x"} {:hits 3}])))

; --- immutability -----------------------------------------------------------
; the original structure is untouched by setv/over — the beams are immutable

(deftest immutability
  (let [users [{:name "ada" :hits 41} {:name "grace" :hits 12}]
        data {:users users :app {:name "demo"}}]
    (over (*> (in :users) traversed (in :hits)) inc data)
    (setv (*> (in :app) (in :name)) "changed" data)
    (is (= data {:users [{:name "ada" :hits 41} {:name "grace" :hits 12}]
                 :app {:name "demo"}}))
    (is (= users [{:name "ada" :hits 41} {:name "grace" :hits 12}]))))
