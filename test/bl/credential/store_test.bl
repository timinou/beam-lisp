; test/bl/credential/store_test.bl — the store, and the one property that matters.
;
; A grant store has one security property, and it is not "the bytes are
; encrypted" (that is the deployment's tier to choose). It is that there is
; no instant at which a readable file holds a refresh token. So the test
; that earns its place here checks the MODE OF THE FILE THAT EXISTS, not
; the mode of the file after the fact — and the implementation it pins
; writes to a 0600 temp and renames, so the window never opens.

(ns credential.store.test
  (:require [credential.store :as store]))

(defn- tmp-dir []
  (str "/tmp/cred-store-" (erlang/list_to_binary (os/getpid)) "-"
       (erlang/integer_to_list (erlang/system_time :nanosecond))))

(defn- with-store [f]
  (let [d (tmp-dir)
        s (store/store-file d)]
    (try (f s d)
         (finally (File/rm_rf! d)))))

(deftest a-grant-round-trips
  (with-store
    (fn [s _]
      (let [g {:scheme :oauth2 :account-id "117…" :material {:refresh "1//x"}}]
        (store/-put s :gmail "117…" g)
        (is (= g (store/-get s :gmail "117…")))))))

(deftest a-missing-grant-is-nil-and-not-an-error
  ; `authorize!` asks this question on every start to decide whether to mint.
  ; If absence raised, the idempotence check would be a rescue — and the
  ; 100-refresh-token eviction bug would be one `catch` away from returning.
  (with-store (fn [s _] (is (nil? (store/-get s :gmail "nobody"))))))

(deftest the-file-is-never-readable-by-anyone-else
  (with-store
    (fn [s _]
      (store/-put s :gmail "117…" {:material {:refresh "1//secret"}})
      (let [dir  (str (:dir s) "/gmail")
            path (str dir "/" (first (File/ls! dir)))
            mode (rem (:mode (File/stat! path)) 512)]   ; the low 9 bits = 0o777
        (is (= 384 mode) "0o600 — a refresh token is not group- or world-readable")))))

(deftest delete-is-idempotent-and-disconnect
  (with-store
    (fn [s _]
      (store/-put s :gmail "117…" {:material {:refresh "1//x"}})
      (store/-delete s :gmail "117…")
      (is (nil? (store/-get s :gmail "117…")))
      (store/-delete s :gmail "117…")     ; again, no error
      (is (nil? (store/-get s :gmail "117…"))))))

(deftest list-is-the-roll-call
  ; "which accounts am I connected to" is a question the design says has an
  ; answer. This is where it comes from.
  (with-store
    (fn [s _]
      (store/-put s :gmail "a" {:material {}})
      (store/-put s :gcal  "b" {:material {}})
      (let [ks (sort-by str (store/-list s))]
        (is (= 2 (count ks)))
        (is (= #{:gmail :gcal} (into #{} (map first ks))))))))

(deftest a-long-account-id-is-stored
  ; the key's hex grew with the id: `integration:firm:<slug>:google:<sub>`
  ; made a 286-byte filename and a real connect died on `file name too long`.
  (with-store
    (fn [s _]
      (let [aid (str "integration:firm:cabinet-atlas:google:" (String/duplicate "1" 120))
            g {:material {:refresh "1//x"}}]
        (store/-put s :google aid g)
        (is (= g (store/-get s :google aid)))
        (is (= [[:google aid]] (store/-list s)))
        (is (every? (fn [f] (<= (count f) 255)) (File/ls! (str (:dir s) "/google"))))))))

(deftest a-legacy-file-still-answers-and-is-superseded
  ; grants written before the digest names (bare grant, hex-of-key name) are
  ; read as they are; the next put replaces them, so -list never counts twice.
  (with-store
    (fn [s d]
      (let [legacy (str d "/gmail/" (binary/encode_hex (erlang/term_to_binary [:gmail "117"])) ".grant")
            g {:material {:refresh "1//old"}}]
        (File/mkdir_p! (str d "/gmail"))
        (File/write! legacy (erlang/term_to_binary g))
        (is (= g (store/-get s :gmail "117")))
        (is (= [[:gmail "117"]] (store/-list s)))
        (store/-put s :gmail "117" {:material {:refresh "1//new"}})
        (is (= {:material {:refresh "1//new"}} (store/-get s :gmail "117")))
        (is (= [[:gmail "117"]] (store/-list s)))
        (is (not (File/exists? legacy)))))))


;; ── the sealed tier ────────────────────────────────────────────────
;;
;; A sealed store has one property the plaintext one cannot offer: a file on
;; disk is not a grant. The tests that earn their place are the REFUSALS —
;; a wrong key, a changed byte, another account's name — because each is a
;; place a naive implementation returns garbage or the wrong grant instead.

(defn- key32 [] (erlang/apply :crypto :strong_rand_bytes (list 32)))

(defn- err-of
  "The `:error` a raised ex-info carries, or nil when the thunk returns."
  [f]
  (try (do (f nil) nil) (catch e (get (ex-data e) :error))))

(defn- with-sealed [key f]
  (let [d (tmp-dir)
        s (store/store-sealed d key)]
    (try (f s d)
         (finally (File/rm_rf! d)))))

(defn- only-file [d svc]
  (str d "/" svc "/" (first (File/ls! (str d "/" svc)))))

(deftest a-sealed-grant-round-trips
  (with-sealed (key32)
    (fn [s _]
      (let [g {:scheme :oauth2 :account-id "117" :material {:refresh "1//x"}}]
        (store/-put s :gmail "117" g)
        (is (= g (store/-get s :gmail "117")))
        (is (= [[:gmail "117"]] (store/-list s)))))))

(deftest a-missing-sealed-grant-is-nil-and-not-an-error
  (with-sealed (key32)
    (fn [s _] (is (nil? (store/-get s :gmail "nobody"))))))

(deftest the-refresh-token-is-not-plaintext-in-the-file
  (with-sealed (key32)
    (fn [s d]
      (store/-put s :gmail "117" {:material {:refresh "1//TOKEN-MARKER-Zx9"}})
      (let [bytes (File/read! (only-file d "gmail"))]
        (is (not (includes? bytes "TOKEN-MARKER-Zx9"))
            "the token is not in the file in the clear")
        (is (not (includes? bytes "1//")) "nor even its prefix")))))

(deftest a-wrong-key-refuses
  (let [d (tmp-dir)]
    (try
      (store/-put (store/store-sealed d (key32)) :gmail "117"
                  {:material {:refresh "1//x"}})
      (let [other (store/store-sealed d (key32))]
        (is (= :credential.store/decrypt-failed
               (err-of (fn [_] (store/-get other :gmail "117"))))
            "a different key does not open the file"))
      (finally (File/rm_rf! d)))))

(deftest a-tampered-file-refuses
  (with-sealed (key32)
    (fn [s d]
      (store/-put s :gmail "117" {:material {:refresh "1//x"}})
      (let [path (only-file d "gmail")
            env (erlang/binary_to_term (File/read! path))]
        ;; a replaced tag
        (File/write! path (erlang/term_to_binary
                            (assoc env :tag (erlang/apply :crypto :strong_rand_bytes (list 16)))))
        (is (= :credential.store/decrypt-failed
               (err-of (fn [_] (store/-get s :gmail "117"))))
            "a replaced tag does not authenticate")
        ;; and a changed ciphertext under the original tag
        (store/-put s :gmail "117" {:material {:refresh "1//x"}})
        (let [env (erlang/binary_to_term (File/read! path))]
          (File/write! path (erlang/term_to_binary (assoc env :ct (str "Z" (:ct env)))))
          (is (= :credential.store/decrypt-failed
                 (err-of (fn [_] (store/-get s :gmail "117"))))
              "a changed ciphertext does not authenticate"))))))

(deftest a-grant-cannot-be-substituted-for-another-account
  ; The attack AAD exists to stop: give account B the file that belongs to
  ; account A. The pair is authenticated, so B's slot will not open A's bytes.
  (with-sealed (key32)
    (fn [s d]
      (let [dir (str d "/gmail")]
        (store/-put s :gmail "acct-a" {:material {:refresh "AAA"}})
        (let [a-name (first (File/ls! dir))
              a-path (str dir "/" a-name)]
          (store/-put s :gmail "acct-b" {:material {:refresh "BBB"}})
          (let [b-name (first (filter (fn [n] (not= n a-name)) (File/ls! dir)))
                b-path (str dir "/" b-name)]
            (File/write! b-path (File/read! a-path))
            (is (= :credential.store/key-mismatch
                   (err-of (fn [_] (store/-get s :gmail "acct-b"))))
                "a substituted file is refused, not opened as the wrong account")
            (is (= {:material {:refresh "AAA"}} (store/-get s :gmail "acct-a"))
                "and the file it was copied from still opens for its own account")))))))

(deftest truncated-or-malformed-sealed-envelopes-refuse
  (with-sealed (key32)
    (fn [s d]
      (store/-put s :gmail "a" {:material {:refresh "SECRET-A"}})
      (let [path (only-file d "gmail")
            env (erlang/binary_to_term (File/read! path))]
        (doseq [tag ["" "x" nil :not-a-binary]]
          (File/write! path (erlang/term_to_binary (assoc env :tag tag)))
          (is (= :credential.store/decrypt-failed
                 (err-of (fn [_] (store/-get s :gmail "a"))))
              "the full 16-byte tag is mandatory before calling OTP"))
        (doseq [iv ["" "x" nil]]
          (File/write! path (erlang/term_to_binary (assoc env :iv iv)))
          (is (= :credential.store/decrypt-failed
                 (err-of (fn [_] (store/-get s :gmail "a"))))))
        (File/write! path (erlang/term_to_binary (assoc env :ct nil)))
        (is (= :credential.store/decrypt-failed
               (err-of (fn [_] (store/-get s :gmail "a")))))))))

(deftest rewriting-public-account-key-does-not-authenticate
  (with-sealed (key32)
    (fn [s d]
      (store/-put s :gmail "a" {:material {:refresh "SECRET-A"}})
      (let [a-path (only-file d "gmail")
            a-env (erlang/binary_to_term (File/read! a-path))]
        (store/-put s :gmail "b" {:material {:refresh "SECRET-B"}})
        (let [dir (str d "/gmail")
              b-path (first (filter (fn [p] (not= p a-path))
                             (map (fn [n] (str dir "/" n)) (File/ls! dir))))]
          (File/write! b-path (erlang/term_to_binary (assoc a-env :key [:gmail "b"])))
          (is (= :credential.store/decrypt-failed
                 (err-of (fn [_] (store/-get s :gmail "b"))))
              "caller-derived AAD still authenticates after the public key is rewritten")
          (File/write! b-path (erlang/term_to_binary
                               (assoc a-env :key [:gmail "b"] :tag "x")))
          (is (= :credential.store/decrypt-failed
                 (err-of (fn [_] (store/-get s :gmail "b"))))
              "a short-tag substitution is refused before decryption"))))))

(deftest a-missing-or-wrong-length-key-refuses-to-build-the-store
  (let [d (tmp-dir)]
    (is (= :credential.store/missing-key
           (err-of (fn [_] (store/store-sealed d nil))))
        "no key: refuse, never fall back to plaintext")
    (is (= :credential.store/invalid-key
           (err-of (fn [_] (store/store-sealed d (erlang/apply :crypto :strong_rand_bytes (list 16))))))
        "a short key is not this cipher's key")
    (is (= :credential.store/invalid-key
           (err-of (fn [_] (store/store-sealed d "a string, not a key"))))
        "nor is any other string")))

(deftest the-key-decodes-from-hex-and-base64
  (let [k (key32)]
    (is (= k (store/key-decode (binary/encode_hex k))))
    (is (= k (store/key-decode (Base/encode64 k))))
    (is (= k (store/key-decode (String/replace (Base/url_encode64 k) "=" "")))
        "url-safe and unpadded still decodes to the same key")
    (is (= :credential.store/invalid-key
           (err-of (fn [_] (store/key-decode "too short")))))))

(deftest the-two-tiers-refuse-to-read-each-other
  (let [d (tmp-dir)]
    (try
      (store/-put (store/store-file d) :gmail "a" {:material {:refresh "P"}})
      (is (= :credential.store/plaintext-present
             (err-of (fn [_] (store/-get (store/store-sealed d (key32)) :gmail "a"))))
          "a sealed store will not read a grant that is in the clear")
      (finally (File/rm_rf! d))))
  (with-sealed (key32)
    (fn [s d]
      (store/-put s :gmail "a" {:material {:refresh "S"}})
      (is (= :credential.store/sealed-present
             (err-of (fn [_] (store/-get (store/store-file d) :gmail "a"))))
          "a plaintext store will not read a sealed grant"))))

(deftest migration-is-explicit-and-total
  (let [d (tmp-dir)
        k (key32)]
    (try
      (let [flat (store/store-file d)
            legacy (str d "/gcal/" (binary/encode_hex (erlang/term_to_binary [:gcal "b"])) ".grant")]
        (store/-put flat :gmail "a" {:material {:refresh "REFRESH-PLAINTEXT-A"}})
        (File/mkdir_p! (str d "/gcal"))
        (File/write! legacy (erlang/term_to_binary {:material {:refresh "REFRESH-PLAINTEXT-B"}}))
        ;; nothing brings the old grants across on its own
        (is (= :credential.store/plaintext-present
               (err-of (fn [_] (store/-get (store/store-sealed d k) :gmail "a")))))
        (is (= 2 (store/migrate-to-sealed! d k)) "both grants moved")
        (let [s (store/store-sealed d k)]
          (is (= {:material {:refresh "REFRESH-PLAINTEXT-A"}} (store/-get s :gmail "a")))
          (is (= {:material {:refresh "REFRESH-PLAINTEXT-B"}} (store/-get s :gcal "b")))
          (is (not (File/exists? legacy)) "the legacy plaintext twin is gone"))
        ;; and no plaintext token survives anywhere under the root
        (let [bytes (reduce (fn [acc svc]
                              (concat acc (map (fn [f] (File/read! (str d "/" svc "/" f)))
                                               (File/ls! (str d "/" svc)))))
                            [] (File/ls! d))]
          (is (every? (fn [b] (not (includes? b "REFRESH-PLAINTEXT"))) bytes)
              "nothing at rest is in the clear")))
      (finally (File/rm_rf! d)))))

(deftest a-write-error-is-typed
  (let [d (tmp-dir)
        f (str d "-a-file")]
    (try
      (File/write! f "x")                     ; a FILE where the store expects a ROOT
      (is (= :credential.store/write-failed
             (err-of (fn [_] (store/-put (store/store-file f) :gmail "a" {:material {}})))))
      (is (= :credential.store/write-failed
             (err-of (fn [_] (store/-put (store/store-sealed f (key32)) :gmail "a" {:material {}})))))
      (finally (File/rm! f)))))
