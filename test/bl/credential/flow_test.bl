; test/bl/credential/flow_test.bl — the dance, without a browser.
;
; The flow has exactly one step that cannot be tested: the human. So the test
; splits there — a fake BROWSER plays the callback, and a fake `post!` plays
; the token endpoint — and what is left under test is every line that runs in
; production: the bind, the URL, the socket accept, the query parse, and the
; branch on `error=` versus `code=`.
;
; A fake browser is not a mock: it opens a real TCP connection to a real
; listener and sends a real HTTP request. Only the human is missing.
;
; ── Why there is no thread, and no sleep ─────────────────────────────
;
; The obvious test spawns the fake browser on a timer while `finish!` blocks
; in `accept`. That test is WRONG here, twice over:
;
;   1. `erlang/spawn` does not carry a closure's env across the process
;      boundary (see `build.bl`'s `pmap-ordered`, which CONVEYS `f`
;      deliberately) — so a fake browser closing over the port would have
;      run with no port in it.
;   2. A sleep-then-connect race is a timing assumption, and the whole point
;      of the fence in `accept` is that it holds for minutes.
;
; Neither is needed. `begin!` has ALREADY BOUND the socket, and TCP queues a
; connection in the listen backlog before anyone accepts it. So the test
; rings the bell first and answers it second, in ONE process: no race, no
; sleep, and it fails in milliseconds instead of hanging for five minutes.

(ns credential.flow.test
  (:require [credential.flow :as flow]
            [credential.oauth2 :as oauth]
            [credential.pending :as pending]))

;; ── parsing the redirect URI ─────────────────────────────────────────

(deftest a-redirect-port-is-read-out-of-the-uri
  (is (= 8000 (flow/redirect-port "http://localhost:8000/api/cb")))
  (is (= 54321 (flow/redirect-port "http://127.0.0.1:54321/cb")))
  (is (nil? (flow/redirect-port "https://app.example.com/oauth/callback"))
      "no port named — the scheme's default, which is a legal answer"))

(deftest with-port-replaces-the-port-and-nothing-else
  ; The provider compares this string byte for byte, so a "normalising"
  ; rewrite of the path or the host is a bug that presents as
  ; redirect_uri_mismatch, hours from its cause.
  (is (= "http://localhost:1234/api/cb"
         (flow/with-port "http://localhost:8000/api/cb" 1234)))
  (is (= "http://localhost:1234/api/cb"
         (flow/with-port "http://localhost:8000/api/cb" 1234))))

(deftest the-callback-path-is-where-the-listener-must-answer
  (is (= "/api/cb" (flow/callback-path "http://localhost:8000/api/cb")))
  (is (= "/" (flow/callback-path "http://localhost:8000"))))

;; ── a fake browser ───────────────────────────────────────────────────

(defn- ring!
  "Open a real connection to the listener and send a real request.

   Returns :sent, so a test can assert the ring happened rather than hoping.
   The connection goes into the listen backlog; the bytes wait there until
   `accept` picks them up."
  [port target]
  (let [r (gen_tcp/connect (tuple 127 0 0 1) port
            (list :binary (tuple :packet :raw) (tuple :active false)))]
    (if (= :ok (elem r 0))
      (let [sock (elem r 1)]
        (gen_tcp/send sock (str "GET " target " HTTP/1.1\r\nHost: localhost\r\n\r\n"))
        (Process/sleep 60)                        ; let the bytes leave the socket
        (gen_tcp/close sock)
        :sent)
      [:failed r])))

(defn- ok-post
  "A token endpoint that succeeds."
  [_url _body]
  {:status 200
   :body "{\"access_token\":\"ACCESS\",\"refresh_token\":\"REFRESH\",\"expires_in\":3600,\"scope\":\"a b\"}"})

(def ^:private CFG
  {:client-id "cid.apps.googleusercontent.com"
   :client-secret "not-a-real-secret"
   :scopes ["https://www.googleapis.com/auth/gmail.readonly"]
   :state "the-session-binding"
   :redirect "http://localhost:8000/api/cb"
   :port 0})                                      ; 0 = let the OS choose

;; ── the whole dance ──────────────────────────────────────────────────

(deftest a-code-becomes-a-credential
  (let [begun (flow/begin! CFG)
        sent  (ring! (:port begun) "/api/cb?code=THE-CODE&state=the-session-binding")
        got   (flow/finish! CFG begun ok-post)]
    (is (= :sent sent) "the fake browser actually connected")
    (is (= "ACCESS" (get (get got :ok) :access)))
    (is (= "REFRESH" (get (get got :ok) :refresh)))
    (is (= #{"a" "b"} (get (get got :ok) :scopes)))))

(deftest the-port-is-bound-not-assumed
  (let [begun (flow/begin! CFG)]
    (is (> (:port begun) 0) "the OS chose it")
    ; `:redirect` is the string the provider compares byte for byte, so this
    ; is the assertion that matters — and it is the one that catches a port
    ; unwrapped from the `{:ok, Port}` that `:inet.port/1` actually answers.
    (is (= (str "http://localhost:" (:port begun) "/api/cb") (:redirect begun))
        "the redirect carries the port we actually bound, not the one we asked for")
    (is (not (includes? (:redirect begun) ":8000"))
        ":8000 was a SHAPE; the bound port is the truth")
    (is (includes? (:url begun) (str "%3A" (:port begun)))
        "and the authorization URL carries the same port, url-encoded")))

(deftest a-refusal-is-a-return-value-and-not-an-exception
  ; Google signals "the human said no" by redirecting to the SAME URI with
  ; `error=` instead of `code=`. An integration that raised here would turn
  ; a normal outcome into a crash page.
  (let [begun (flow/begin! CFG)
        _ (ring! (:port begun) "/api/cb?error=access_denied&error_description=no+thanks")
        got (flow/finish! CFG begun ok-post)]
    (is (= :declined (get got :error)))
    (is (= "access_denied" (get got :reason)))))

(deftest a-failed-exchange-carries-its-disposition
  (let [begun (flow/begin! CFG)
        _ (ring! (:port begun) "/api/cb?code=STALE&state=the-session-binding")
        got (flow/finish! CFG begun
              (fn [_url _body]
                {:status 400 :body "{\"error\":\"invalid_grant\",\"error_description\":\"revoked\"}"}))]
    (is (= :exchange-failed (get got :error)))
    (is (= :reauth (get (get got :body) :disposition))
        "and the disposition is REAUTH, so nothing retries it")
    (is (includes? (get got :request) "grant_type=authorization_code")
        "the failure carries what was SENT, so the next reader is not guessing")
    (is (not (includes? (get got :request) "not-a-real-secret"))
        "and the client secret is not in it")))

(deftest a-callback-from-another-session-is-refused
  ; `state` is the binding between the URL this process printed and the
  ; callback it accepts. Left unchecked the parameter is decoration: any
  ; redirect to this port would be traded for tokens.
  (let [begun (flow/begin! CFG)
        _ (ring! (:port begun) "/api/cb?code=C&state=not-our-state")
        got (flow/finish! CFG begun ok-post)]
    (is (= :state-mismatch (get got :error)))
    (is (= "the-session-binding" (get got :expected)))
    (is (= "not-our-state" (get got :got)))))

;; ── the web redirect: two requests, one stored attempt ───────────────
;;
;; No socket and no browser: the two halves are joined by a `state` in a
;; `Pending` store, so the whole production path except the token exchange
;; runs offline. The fake `post!` is the only thing the network would have
;; supplied, and it also RECORDS what was sent, which is how the security
;; negatives below (the recorded redirect, no leaked code) are asserted.

(def ^:private WEB-CFG
  {:client-id "cid.apps.googleusercontent.com"
   :client-secret "not-a-real-secret"
   :redirect "https://app.example.com/oauth/callback"
   :scopes ["https://www.googleapis.com/auth/drive.readonly"]
   :firm "firm-atlas"
   :principal "principal-ada"})

(defn- new-pending []
  (pending/mem-pending
    (keyword (str "credential.flow.test-" (erlang/unique_integer (list :positive))))))

(defn- cell []
  (keyword (str "credential.flow.test.cell-" (erlang/unique_integer (list :positive)))))

(defn- cell-get [k]
  (try (erlang/apply :persistent_term :get (list k)) (catch _e nil)))

(defn- recording-post!
  "A token endpoint that answers `response` and remembers the one request it saw."
  [k response]
  (fn [_url body]
    (erlang/apply :persistent_term :put
      (list k {:body body :calls (inc (or (get (cell-get k) :calls) 0))}))
    response))

(defn- form-value
  "The value of `key` in an application/x-www-form-urlencoded body, or nil."
  [body key]
  (let [hit (first (filter (fn [s] (String/starts_with? s (str key "="))) (to-list (String/split body "&"))))]
    (when (some? hit)
      (join "=" (drop 1 (String/split hit "="))))))

(defn- ok-body []
  "{\"access_token\":\"ACCESS\",\"refresh_token\":\"REFRESH\",\"expires_in\":3600,\"scope\":\"a b\"}")

(deftest a-web-attempt-is-bound-and-carries-no-client-secret
  (let [p (new-pending)
        begun (flow/begin-web WEB-CFG p)
        s (:state (:ok begun))
        rec (pending/-take p s)]
    (is (= "firm-atlas" (:firm rec)))
    (is (= "principal-ada" (:principal rec)))
    (is (= (:client-id WEB-CFG) (:client-id rec)))
    (is (= (:redirect WEB-CFG) (:redirect rec)))
    (is (> (:expires-at rec) (:created-at rec)) "an attempt is mortal")
    (is (some? (:verifier rec)) "the verifier waits in the store, not in the app")
    (is (not= s (:verifier rec)) "the public state is not the secret verifier")
    (is (not (contains? rec :client-secret)) "the attempt holds no client secret")))

(deftest each-attempt-mints-a-fresh-unpredictable-state
  (let [p (new-pending)
        a (:state (:ok (flow/begin-web WEB-CFG p)))
        b (:state (:ok (flow/begin-web WEB-CFG p)))]
    (is (not= a b) "a state is never reused")
    (is (>= (count a) 43) "32 bytes of base64url, like the verifier")))

(deftest the-same-verifier-minted-the-url-and-pays-the-exchange
  ; The end-to-end PKCE proof the loopback cannot give across requests: the
  ; `code_verifier` the exchange presents must S256 to the `code_challenge`
  ; the URL carried, or the halves disagree about the attempt.
  (let [p (new-pending)
        k (cell)
        post! (recording-post! k {:status 200 :body (ok-body)})
        begun (flow/begin-web WEB-CFG p)
        s (:state (:ok begun))
        url (:url (:ok begun))
        got (flow/finish-web! WEB-CFG {"state" s "code" "THE-CODE"} p post!)
        sent (:body (cell-get k))
        verifier (form-value sent "code_verifier")]
    (is (= "ACCESS" (:access (:ok got))))
    (is (= "REFRESH" (:refresh (:ok got))))
    (is (= (oauth/challenge verifier) (form-value url "code_challenge")))
    (is (includes? url "code_challenge_method=S256"))
    (is (includes? url (str "state=" s)) "the URL carries the state the callback echoes")
    (is (not (includes? url verifier)) "the verifier never travels in the URL")))

(deftest the-exchange-presents-the-recorded-redirect-not-the-callbacks
  ; A redirect read from the callback (or a `Host` header) would let the
  ; requester choose where the code is delivered. It must come from the
  ; attempt, and a callback-supplied `redirect_uri` must be ignored.
  (let [p (new-pending)
        k (cell)
        post! (recording-post! k {:status 200 :body (ok-body)})
        begun (flow/begin-web WEB-CFG p)
        got (flow/finish-web! WEB-CFG
              {"state" (:state (:ok begun)) "code" "THE-CODE"
               "redirect_uri" "https://evil.example/steal"}
              p post!)
        sent (:body (cell-get k))]
    (is (= "ACCESS" (:access (:ok got))))
    (is (includes? sent "app.example.com") "the configured callback is the one sent")
    (is (not (includes? sent "evil.example")) "the callback cannot choose the redirect")))

(deftest a-web-callback-may-be-a-raw-query-string
  (let [p (new-pending)
        k (cell)
        post! (recording-post! k {:status 200 :body (ok-body)})
        begun (flow/begin-web WEB-CFG p)
        got (flow/finish-web! WEB-CFG
              (str "code=THE-CODE&state=" (:state (:ok begun))) p post!)]
    (is (= "ACCESS" (:access (:ok got))))))

(deftest the-optional-url-options-reach-the-consent-url
  (let [p (new-pending)
        plain (:url (:ok (flow/begin-web WEB-CFG p)))
        hinted (:url (:ok (flow/begin-web (assoc WEB-CFG
                                            :login-hint "ada@example.com"
                                            :prompt :none)
                                         p)))]
    (is (includes? plain "prompt=consent") "the default re-prompts for a refresh token")
    (is (includes? hinted "prompt=none"))
    (is (includes? hinted "login_hint=ada%40example.com"))))

(deftest a-callback-with-no-state-is-refused
  (let [p (new-pending)
        k (cell)
        post! (recording-post! k {:status 200 :body (ok-body)})
        got (flow/finish-web! WEB-CFG {"code" "THE-CODE"} p post!)]
    (is (= :missing-state (:error got)))
    (is (nil? (cell-get k)) "nothing is exchanged without a state")))

(deftest a-forged-state-is-refused
  (let [p (new-pending)
        k (cell)
        post! (recording-post! k {:status 200 :body (ok-body)})
        got (flow/finish-web! WEB-CFG {"state" "not-a-state" "code" "THE-CODE"} p post!)]
    (is (= :unknown-state (:error got)))
    (is (nil? (cell-get k)))))

(deftest a-state-is-single-use
  ; The point of consuming the state before the exchange: a second callback
  ; for the same attempt finds nothing, so the code is presented exactly once.
  (let [p (new-pending)
        k (cell)
        post! (recording-post! k {:status 200 :body (ok-body)})
        begun (flow/begin-web WEB-CFG p)
        s (:state (:ok begun))
        first (flow/finish-web! WEB-CFG {"state" s "code" "THE-CODE"} p post!)
        second (flow/finish-web! WEB-CFG {"state" s "code" "THE-CODE"} p post!)]
    (is (= "ACCESS" (:access (:ok first))))
    (is (= :unknown-state (:error second)))
    (is (= 1 (:calls (cell-get k))) "the exchange happened exactly once")))

(deftest an-expired-attempt-is-refused-and-still-spent
  (let [p (new-pending)
        k (cell)
        post! (recording-post! k {:status 200 :body (ok-body)})
        begun (flow/begin-web (assoc WEB-CFG :ttl-ms 0) p)
        s (:state (:ok begun))
        got (flow/finish-web! WEB-CFG {"state" s "code" "THE-CODE"} p post!)
        again (flow/finish-web! WEB-CFG {"state" s "code" "THE-CODE"} p post!)]
    (is (= :state-expired (:error got)))
    (is (nil? (cell-get k)) "an expired attempt is never exchanged")
    (is (= :unknown-state (:error again))
        "and it is spent, not re-usable once the clock has passed")))

(deftest an-attempt-cannot-be-finished-by-another-session
  ; The state binds the attempt to the firm and principal that began it. A
  ; callback carrying it must be answered against THAT session, or one firm
  ; could finish another's flow.
  (let [p (new-pending)
        k (cell)
        post! (recording-post! k {:status 200 :body (ok-body)})
        s1 (:state (:ok (flow/begin-web WEB-CFG p)))
        s2 (:state (:ok (flow/begin-web WEB-CFG p)))
        other-firm (flow/finish-web! (assoc WEB-CFG :firm "firm-other")
                      {"state" s1 "code" "THE-CODE"} p post!)
        other-principal (flow/finish-web! (assoc WEB-CFG :principal "principal-eve")
                           {"state" s2 "code" "THE-CODE"} p post!)]
    (is (= :state-mismatch (:error other-firm)))
    (is (= "firm-atlas" (:firm (:attempt other-firm))))
    (is (= "firm-other" (:firm (:session other-firm))))
    (is (= :state-mismatch (:error other-principal)))
    (is (nil? (cell-get k)) "neither mismatch reached the token endpoint")))

(deftest a-refusal-and-a-provider-error-are-values
  ; Google signals "the human said no" with `error=access_denied` on the SAME
  ; redirect. Turning that into a raise is turning a normal outcome into a
  ; crash page.
  (let [p (new-pending)
        k (cell)
        post! (recording-post! k {:status 200 :body (ok-body)})
        s1 (:state (:ok (flow/begin-web WEB-CFG p)))
        s2 (:state (:ok (flow/begin-web WEB-CFG p)))
        d (flow/finish-web! WEB-CFG
             {"state" s1 "error" "access_denied" "error_description" "no thanks"} p post!)
        e (flow/finish-web! WEB-CFG {"state" s2 "error" "server_error"} p post!)]
    (is (= :declined (:error d)))
    (is (= "access_denied" (:reason d)))
    (is (= :provider-error (:error e)))
    (is (nil? (cell-get k)) "a refusal never reaches the token endpoint")))

(deftest a-changed-client-or-redirect-is-refused
  (let [p (new-pending)
        k (cell)
        post! (recording-post! k {:status 200 :body (ok-body)})
        s1 (:state (:ok (flow/begin-web WEB-CFG p)))
        s2 (:state (:ok (flow/begin-web WEB-CFG p)))
        other-client (flow/finish-web! (assoc WEB-CFG :client-id "other.apps.googleusercontent.com")
                        {"state" s1 "code" "THE-CODE"} p post!)
        other-redirect (flow/finish-web! (assoc WEB-CFG :redirect "https://elsewhere.example/cb")
                          {"state" s2 "code" "THE-CODE"} p post!)]
    (is (= :client-mismatch (:error other-client)))
    (is (= :redirect-mismatch (:error other-redirect)))
    (is (nil? (cell-get k)))))

(deftest both-halves-name-the-config-they-are-missing
  (let [p (new-pending)
        partial {:client-id "cid" :client-secret "sec" :redirect "https://a.example/cb"}]
    (is (= [:firm :principal :scopes] (:keys (flow/begin-web partial p))))
    (is (= [:firm :principal] (:keys (flow/finish-web! partial {"state" "s"} p))))
    (is (= :missing-config (:error (flow/begin-web {} p))))))

(deftest a-redirect-must-be-absolute
  (let [p (new-pending)
        got (flow/begin-web (assoc WEB-CFG :redirect "/oauth/callback") p)]
    (is (= :invalid-redirect (:error got)))))

(deftest a-failed-exchange-leaks-neither-code-nor-secret
  (let [p (new-pending)
        k (cell)
        post! (recording-post! k {:status 400 :body "{\"error\":\"invalid_grant\",\"error_description\":\"revoked\"}"})
        begun (flow/begin-web WEB-CFG p)
        got (flow/finish-web! WEB-CFG {"state" (:state (:ok begun)) "code" "THE-SECRET-CODE"} p post!)]
    (is (= :exchange-failed (:error got)))
    (is (= :reauth (get (:body got) :disposition)) "so nothing retries it")
    (is (includes? (:request got) "grant_type=authorization_code"))
    (is (includes? (:request got) "code=<") "the code's value is replaced by its length")
    (is (not (includes? (:request got) "THE-SECRET-CODE")))
    (is (not (includes? (:request got) "not-a-real-secret")))))
