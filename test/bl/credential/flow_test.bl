; test/bl/credential/flow_test.bl — the dance, without a browser.
;
; The flow has exactly one step that cannot be tested: the human. So the test
; splits there — a fake BROWSER plays the callback, and a fake `post!` plays
; the token endpoint — and what is left under test is every line that runs in
; production: the bind, the URL, the socket accept, the query parse, and the
; branch on `error=` versus `code=`.
;
; A fake browser is not a mock: it opens a real TCP connection to a real
; listener and sends a real HTTP request. Only the human is missing.
;
; ── Why there is no thread, and no sleep ─────────────────────────────
;
; The obvious test spawns the fake browser on a timer while `finish!` blocks
; in `accept`. That test is WRONG here, twice over:
;
;   1. `erlang/spawn` does not carry a closure's env across the process
;      boundary (see `build.bl`'s `pmap-ordered`, which CONVEYS `f`
;      deliberately) — so a fake browser closing over the port would have
;      run with no port in it.
;   2. A sleep-then-connect race is a timing assumption, and the whole point
;      of the fence in `accept` is that it holds for minutes.
;
; Neither is needed. `begin!` has ALREADY BOUND the socket, and TCP queues a
; connection in the listen backlog before anyone accepts it. So the test
; rings the bell first and answers it second, in ONE process: no race, no
; sleep, and it fails in milliseconds instead of hanging for five minutes.

(ns credential.flow.test
  (:require [credential.flow :as flow]))

;; ── parsing the redirect URI ─────────────────────────────────────────

(deftest a-redirect-port-is-read-out-of-the-uri
  (is (= 8000 (flow/redirect-port "http://localhost:8000/api/cb")))
  (is (= 54321 (flow/redirect-port "http://127.0.0.1:54321/cb")))
  (is (nil? (flow/redirect-port "https://app.example.com/oauth/callback"))
      "no port named — the scheme's default, which is a legal answer"))

(deftest with-port-replaces-the-port-and-nothing-else
  ; The provider compares this string byte for byte, so a "normalising"
  ; rewrite of the path or the host is a bug that presents as
  ; redirect_uri_mismatch, hours from its cause.
  (is (= "http://localhost:1234/api/cb"
         (flow/with-port "http://localhost:8000/api/cb" 1234)))
  (is (= "http://localhost:1234/api/cb"
         (flow/with-port "http://localhost:8000/api/cb" 1234))))

(deftest the-callback-path-is-where-the-listener-must-answer
  (is (= "/api/cb" (flow/callback-path "http://localhost:8000/api/cb")))
  (is (= "/" (flow/callback-path "http://localhost:8000"))))

;; ── a fake browser ───────────────────────────────────────────────────

(defn- ring!
  "Open a real connection to the listener and send a real request.

   Returns :sent, so a test can assert the ring happened rather than hoping.
   The connection goes into the listen backlog; the bytes wait there until
   `accept` picks them up."
  [port target]
  (let [r (gen_tcp/connect (tuple 127 0 0 1) port
            (list :binary (tuple :packet :raw) (tuple :active false)))]
    (if (= :ok (elem r 0))
      (let [sock (elem r 1)]
        (gen_tcp/send sock (str "GET " target " HTTP/1.1\r\nHost: localhost\r\n\r\n"))
        (Process/sleep 60)                        ; let the bytes leave the socket
        (gen_tcp/close sock)
        :sent)
      [:failed r])))

(defn- ok-post
  "A token endpoint that succeeds."
  [_url _body]
  {:status 200
   :body "{\"access_token\":\"ACCESS\",\"refresh_token\":\"REFRESH\",\"expires_in\":3600,\"scope\":\"a b\"}"})

(def ^:private CFG
  {:client-id "cid.apps.googleusercontent.com"
   :client-secret "not-a-real-secret"
   :scopes ["https://www.googleapis.com/auth/gmail.readonly"]
   :state "the-session-binding"
   :redirect "http://localhost:8000/api/cb"
   :port 0})                                      ; 0 = let the OS choose

;; ── the whole dance ──────────────────────────────────────────────────

(deftest a-code-becomes-a-credential
  (let [begun (flow/begin! CFG)
        sent  (ring! (:port begun) "/api/cb?code=THE-CODE&state=the-session-binding")
        got   (flow/finish! CFG begun ok-post)]
    (is (= :sent sent) "the fake browser actually connected")
    (is (= "ACCESS" (get (get got :ok) :access)))
    (is (= "REFRESH" (get (get got :ok) :refresh)))
    (is (= #{"a" "b"} (get (get got :ok) :scopes)))))

(deftest the-port-is-bound-not-assumed
  (let [begun (flow/begin! CFG)]
    (is (> (:port begun) 0) "the OS chose it")
    ; `:redirect` is the string the provider compares byte for byte, so this
    ; is the assertion that matters — and it is the one that catches a port
    ; unwrapped from the `{:ok, Port}` that `:inet.port/1` actually answers.
    (is (= (str "http://localhost:" (:port begun) "/api/cb") (:redirect begun))
        "the redirect carries the port we actually bound, not the one we asked for")
    (is (not (includes? (:redirect begun) ":8000"))
        ":8000 was a SHAPE; the bound port is the truth")
    (is (includes? (:url begun) (str "%3A" (:port begun)))
        "and the authorization URL carries the same port, url-encoded")))

(deftest a-refusal-is-a-return-value-and-not-an-exception
  ; Google signals "the human said no" by redirecting to the SAME URI with
  ; `error=` instead of `code=`. An integration that raised here would turn
  ; a normal outcome into a crash page.
  (let [begun (flow/begin! CFG)
        _ (ring! (:port begun) "/api/cb?error=access_denied&error_description=no+thanks")
        got (flow/finish! CFG begun ok-post)]
    (is (= :declined (get got :error)))
    (is (= "access_denied" (get got :reason)))))

(deftest a-failed-exchange-carries-its-disposition
  (let [begun (flow/begin! CFG)
        _ (ring! (:port begun) "/api/cb?code=STALE&state=the-session-binding")
        got (flow/finish! CFG begun
              (fn [_url _body]
                {:status 400 :body "{\"error\":\"invalid_grant\",\"error_description\":\"revoked\"}"}))]
    (is (= :exchange-failed (get got :error)))
    (is (= :reauth (get (get got :body) :disposition))
        "and the disposition is REAUTH, so nothing retries it")
    (is (includes? (get got :request) "grant_type=authorization_code")
        "the failure carries what was SENT, so the next reader is not guessing")
    (is (not (includes? (get got :request) "not-a-real-secret"))
        "and the client secret is not in it")))

(deftest a-callback-from-another-session-is-refused
  ; `state` is the binding between the URL this process printed and the
  ; callback it accepts. Left unchecked the parameter is decoration: any
  ; redirect to this port would be traded for tokens.
  (let [begun (flow/begin! CFG)
        _ (ring! (:port begun) "/api/cb?code=C&state=not-our-state")
        got (flow/finish! CFG begun ok-post)]
    (is (= :state-mismatch (get got :error)))
    (is (= "the-session-binding" (get got :expected)))
    (is (= "not-our-state" (get got :got)))))
