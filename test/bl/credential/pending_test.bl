; test/bl/credential/pending_test.bl — the one-time property, under contention.
;
; A `state` is a one-time bearer handle, and the whole web flow rests on one
; sentence: two callbacks presenting it must not both receive the attempt.
; Everything else here — the sweep, the default name, the VM lifetime — exists
; so that sentence can be true without a lock.
;
; So the tests that matter are the CONCURRENT ones. A single-threaded take
; passes against the read-then-delete implementation this file replaced, which
; had a window between the read and the delete; only overlapping takes close
; it. Twenty tasks over one state, exactly one winner, and twenty distinct
; states all kept, is the proof the old reference store could not give.

(ns credential.pending.test
  (:require [credential.pending :as pending]))

(defn- new-store []
  (pending/mem-pending
    (keyword (str "credential.pending.test-"
                  (erlang/unique_integer (list :positive))))))

(defn- now-ms [] (erlang/system_time :millisecond))
(defn- future-ms [] (+ (now-ms) 60000))

(defn- attempt [n]
  {:verifier (str "verifier-" n) :firm "firm" :principal "ada"
   :created-at (now-ms) :expires-at (future-ms)})

(defn- await-all [tasks]
  (to-list (map (fn [t] (Task/await t)) tasks)))

;; ── the simple contract, restated so a regression in the shape is loud ──

(deftest an-attempt-round-trips-and-is-spent
  (let [p (new-store)
        r (attempt 1)]
    (pending/-put p "state-1" r)
    (is (= r (pending/-take p "state-1")))
    (is (nil? (pending/-take p "state-1"))
        "a second take finds nothing — the state is spent")))

(deftest a-put-replaces-because-a-state-is-never-minted-twice
  (let [p (new-store)]
    (pending/-put p "s" (attempt 1))
    (pending/-put p "s" (attempt 2))
    (is (= (attempt 2) (pending/-take p "s")))))

(deftest a-record-with-no-expiry-is-kept
  ; Not every caller sets an expiry; a record without one must round-trip and
  ; must never be swept (the store has nothing to judge it by).
  (let [p (new-store)
        r {:verifier "v"}]
    (pending/-put p "s" r)
    (is (= 0 (pending/-sweep! p)) "nothing without an expiry is expired")
    (is (= r (pending/-take p "s")))))

(deftest an-expired-attempt-is-still-handable-to-the-flow
  ; The store hands it over; `finish-web!` is the layer that says
  ; `:state-expired`. A store that answered nil here would erase the
  ; distinction between an expired attempt and a replayed one.
  (let [p (new-store)
        r (assoc (attempt 9) :expires-at 1)]
    (pending/-put p "old" r)
    (is (= r (pending/-take p "old")))))

;; ── the property under contention ────────────────────────────────────

(deftest twenty-concurrent-takes-of-one-state-yield-exactly-one-record
  (let [p (new-store)
        r (attempt 7)]
    (pending/-put p "s" r)
    (let [results (await-all
                    (to-list (map (fn [_] (Task/async (fn [] (pending/-take p "s"))))
                                  (range 20))))
          wins (filter (fn [x] (some? x)) results)]
      (is (= 20 (count results)) "every take answered")
      (is (= 1 (count wins)) "exactly one callback receives the attempt")
      (is (= r (first wins)) "and it is the attempt that was put"))))

(deftest twenty-concurrent-puts-of-different-states-lose-nothing
  (let [p (new-store)
        rs (into [] (map (fn [i] {:verifier (str "verifier-" i)})) (range 20))]
    (await-all
      (to-list (map (fn [i] (Task/async (fn [] (pending/-put p (str "s" i) (nth rs i)))))
                    (range 20))))
    (let [taken (to-list (map (fn [i] (pending/-take p (str "s" i))) (range 20)))]
      (is (= 20 (count (filter (fn [x] (some? x)) taken))) "no put was lost")
      (is (= (into #{} rs) (into #{} taken))
          "and every one is the record that was put"))))

(deftest an-attempt-outlives-the-process-that-began-it
  ; The cross-request property this store exists for: `begin-web` and its
  ; callback are different processes, so the attempt must not be tied to the
  ; process that put it. (The old ETS-story — a table dies with its creator —
  ; is why the table is HELD by `proc.table` rather than made by the request.)
  (let [p (new-store)
        r (attempt 3)]
    (Task/await (Task/async (fn [] (pending/-put p "s" r))))
    (is (= r (pending/-take p "s"))
        "the attempt survives the process that put it")))

;; ── the sweep bounds the store ───────────────────────────────────────

(deftest a-put-sweeps-what-an-earlier-put-left
  (let [p (new-store)]
    (pending/-put p "a" (assoc (attempt 1) :expires-at 1))
    (pending/-put p "b" (assoc (attempt 2) :expires-at 1))   ; the sweep drops "a"
    (is (= 1 (pending/-sweep! p)) "only the newest put's attempt remains")
    (is (= 0 (pending/-sweep! p)) "and the sweep is idempotent")))

(deftest repeated-puts-cannot-accumulate-expired-state
  ; Fifty expired attempts go in one at a time. Without a sweep they stay
  ; forever — a one-time handle store that is also an unbounded one. The
  ; final put of a LIVE attempt leaves nothing expired behind.
  (let [p (new-store)]
    (doseq [i (range 50)]
      (pending/-put p (str "dead" i) (assoc (attempt i) :expires-at 1)))
    (pending/-put p "live" (attempt 99))
    (is (= 0 (pending/-sweep! p)) "no expired attempt survived the last put")
    (is (some? (pending/-take p "live")) "and the live attempt is untouched")))

(deftest a-live-attempt-survives-the-sweeps-around-it
  (let [p (new-store)
        live (attempt 42)]
    (pending/-put p "live" live)
    (doseq [i (range 20)]
      (pending/-put p (str "dead" i) (assoc (attempt i) :expires-at 1)))
    (is (= live (pending/-take p "live"))
        "sweeping the expired must not touch the live")))
