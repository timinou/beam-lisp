; test/bl/credential/client_credentials_test.bl — app-only (Entra) tokens:
; the body, the endpoint, minting, renewal-by-minting, and the secret staying
; out of the grant. Google's refresh path is pinned alongside, unchanged.

(ns credential.client-credentials-test
  (:require [credential :as cred] [credential.oauth2 :as oauth]))

(def URL "https://login.example/t1/oauth2/v2.0/token")

(defn- ok-post [tok]
  (fn [_ _] {:status 200 :body (str "{\"access_token\":\"" tok "\",\"expires_in\":3600,\"token_type\":\"Bearer\"}")}))

(deftest body-is-client-credentials
  (let [b (oauth/form-encode (oauth/client-credentials-body {:client-id "cid" :client-secret "s e" :scope "https://graph.microsoft.com/.default"}))]
    (is (includes? b "grant_type=client_credentials"))
    (is (includes? b "scope=https%3A%2F%2Fgraph.microsoft.com%2F.default"))
    (is (includes? b "client_secret=s+e"))
    (is (not (includes? b "refresh_token")))))

(deftest entra-endpoint
  (is (= "https://login.microsoftonline.com/T/oauth2/v2.0/token" (oauth/entra-token-endpoint "T")))
  (is (= "http://127.0.0.1:1/T/oauth2/v2.0/token" (oauth/entra-token-endpoint "http://127.0.0.1:1" "T"))))

(deftest mint-posts-to-the-token-url-and-keeps-the-secret-out-of-the-grant
  (let [seen (atom nil)
        r (cred/mint-app! {:token-url URL :client-id "cid" :client-secret "SEKRET" :scope "S"
                           :service :microsoft :account-id "acct"}
                          (fn [u b] (reset! seen [u b]) ((ok-post "T1") u b)))
        g (cred/ok r)]
    (is (= URL (first @seen)))
    (is (includes? (second @seen) "client_secret=SEKRET"))
    (is (= "T1" (:access g)))
    (is (= :client-credentials (:grant-type g)))
    (is (= URL (:token-url g)))
    (is (nil? (:refresh g)))
    (is (not (includes? (pr-str g) "SEKRET")) "the secret is the client's, never the grant's")))

(deftest refresh-of-an-app-grant-mints-again-and-carries-identity
  (let [g0 (cred/ok (cred/mint-app! {:token-url URL :client-id "cid" :client-secret "x" :scope "S"
                                     :service :microsoft :account-id "acct" :label "L"} (ok-post "T1")))
        g1 (cred/ok (cred/refresh! (assoc g0 :expires-at 0) {:client-id "cid" :client-secret "x"} (ok-post "T2")))]
    (is (= "T2" (:access g1)))
    (is (= "acct" (:account-id g1)))
    (is (= "L" (:label g1)))
    (is (= URL (:token-url g1)))
    (is (= "T2" (:access (cred/ok (cred/fresh! (assoc g0 :expires-at 0) {:client-secret "x"} (ok-post "T2"))))))
    (is (= "T1" (:access (cred/ok (cred/fresh! g0 {:client-secret "x"} (ok-post "T2"))))) "a live token is not re-minted")))

(deftest bad-secret-is-a-config-error-with-a-named-reason
  (let [post (fn [_ _] {:status 401 :body "{\"error\":\"invalid_client\",\"error_codes\":[7000215],\"error_description\":\"AADSTS7000215\"}"})
        r (cred/mint-app! {:token-url URL :client-id "c" :client-secret "bad" :scope "S" :service :microsoft :account-id "a"} post)]
    (is (= :config-error (:disposition r)))
    (is (= :bad-secret (:reason r)))
    (is (= [7000215] (:error-codes (:body r))))))

(deftest entra-reasons
  (let [r (fn [code] (oauth/entra-reason (oauth/decode-error (str "{\"error\":\"x\",\"error_codes\":[" code "]}"))))]
    (is (= :bad-secret (r 7000215)))
    (is (= :secret-expired (r 7000222)))
    (is (= :secret-missing (r 7000218)))
    (is (= :unknown-app (r 700016)))
    (is (= :unknown-tenant (r 90002)))
    (is (= :consent-missing (r 65001)))
    (is (= :other (r 1)))
    (is (= :other (oauth/entra-reason (oauth/decode-error "{\"error\":\"x\"}"))))))

(deftest a-200-that-is-not-json-keeps-unparseable-and-is-retryable
  (let [r (cred/mint-app! {:token-url URL :client-id "c" :client-secret "s" :scope "S"}
                          (fn [_ _] {:status 200 :body "<html>portal</html>"}))]
    (is (= :unparseable (:error r)))
    (is (= :retry (:disposition r)))
    (is (= :config-error (:disposition (cred/mint-app! {:token-url URL :client-id "c" :client-secret "s" :scope "S"}
                                                      (fn [_ _] {:status 200 :body "{\"x\":1}"})))) "valid JSON without a token is a config problem")))

(deftest google-refresh-is-unchanged
  (let [g {:service :google :account-id "a" :client-id "cid" :refresh "RT" :access "old" :scopes #{"s"} :expires-at 0}
        seen (atom nil)
        r (cred/refresh! g {:client-id "cid" :client-secret "sec"}
                         (fn [u b] (reset! seen [u b]) ((ok-post "NEW") u b)))]
    (is (= oauth/TOKEN-ENDPOINT (first @seen)))
    (is (includes? (second @seen) "grant_type=refresh_token"))
    (is (= "RT" (:refresh (cred/ok r))) "refresh token carried forward")
    (is (= "NEW" (:access (cred/ok r))))
    (is (= :no-refresh-token (:error (cred/refresh! (dissoc g :refresh) {} (ok-post "x")))))))
