; test/bl/credential/oauth2_test.bl — the protocol, proved against the spec.
;
; RFC 7636 Appendix B publishes a verifier and its S256 challenge. If
; `challenge` reproduces that pair then the derivation is CORRECT, and no
; amount of integration testing would tell you more — an integration test
; proves that Google and this code agree today, a vector proves the code
; agrees with the specification.
;
; The rest of the file pins the things that rot quietly: that the URL
; carries `access_type=offline` and `prompt=consent` (without which Google
; returns no refresh token at all), that `invalid_grant` is NOT classified
; as retryable, and that a secret cannot reach a log.

(ns credential.oauth2.test
  (:require [credential.oauth2 :as oauth]))

;; ── PKCE: the published vector ───────────────────────────────────────

(deftest challenge-reproduces-the-rfc-7636-vector
  (is (= "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM"
         (oauth/challenge "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"))
      "RFC 7636 Appendix B — the whole reason this file is pure"))

(deftest a-verifier-is-base64url-and-long-enough
  (let [v (oauth/verifier)]
    (is (>= (count v) 43) "the RFC's floor is 43 characters")
    (is (not (includes? v "+")) "base64URL: no +")
    (is (not (includes? v "/")) "base64URL: no /")
    (is (not (includes? v "=")) "base64URL: no padding")
    (is (not= v (oauth/verifier)) "…and it is actually random")))

;; ── the authorization URL ────────────────────────────────────────────

(defn- url-with [params]
  (oauth/auth-url {:client-id "cid.apps.googleusercontent.com"
                   :redirect-uri "http://localhost:8000/api/calendar/public/v1/callback"
                   :scopes ["https://www.googleapis.com/auth/gmail.readonly"
                            "https://www.googleapis.com/auth/calendar.readonly"]
                   :challenge "CHAL"
                   :state "STATE"}))

(deftest the-url-asks-for-a-refresh-token
  (let [u (url-with {})]
    ; `access_type=offline` and an explicit `prompt` are what make Google
    ; return a refresh token. Without them the grant lasts an hour and the
    ; integration silently cannot survive a restart.
    (is (includes? u "access_type=offline"))
    (is (includes? u "prompt=consent"))
    (is (includes? u "code_challenge_method=S256"))
    (is (includes? u "state=STATE"))))

(deftest the-scope-URI-is-encoded-not-raw
  (let [u (url-with {})]
    ; A raw scope URI carries ':' and '/', which end a query value early.
    (is (not (includes? u "scope=https://")) "the scope must be percent-encoded")
    (is (includes? u "scope=https%3A%2F%2F"))))

;; ── the taxonomy: what to DO, not just what happened ─────────────────

(deftest invalid-grant-is-never-retryable
  ; THE regression this file exists for. `invalid_grant` is a revoked,
  ; expired or evicted grant: it will not become valid by waiting, and a
  ; retry loop on it burns quota forever while looking busy.
  (is (= :reauth (oauth/classify {:error "invalid_grant"})))
  (is (not= :retry (oauth/classify {:error "invalid_grant"})))
  (is (= :reauth (oauth/classify {:error "invalid_rapt"})) "session control expired")
  (is (= :declined (oauth/classify {:error "access_denied"})) "a human said no")
  (is (= :config-error (oauth/classify {:error "redirect_uri_mismatch"})))
  (is (= :retry (oauth/classify {:error nil :status 503})) "5xx is worth another try")
  (is (= :retry (oauth/classify {:error nil :status 429}))))

(deftest token-errors-are-flat-not-enveloped
  ; The resource APIs answer `{error: {code, status, errors: […]}}`; the
  ; token endpoint answers `{error, error_description}`. Two shapes, one
  ; service, and assuming either gets the other wrong.
  (let [e (oauth/decode-error "{\"error\":\"invalid_grant\",\"error_description\":\"Malformed auth code.\"}")]
    (is (= "invalid_grant" (:error e)))
    (is (= :reauth (:disposition e)))
    (is (= "Malformed auth code." (:description e)))))

;; ── the token response ───────────────────────────────────────────────

(deftest expires-in-becomes-an-absolute-instant-in-milliseconds
  (let [{:keys [ok]} (oauth/decode-token
                       "{\"access_token\":\"a\",\"expires_in\":3599,\"scope\":\"x y\"}"
                       1700000000000)]
    (is (= 1700003599000 (:expires-at ok)) "relative seconds -> absolute ms, once, here")
    (is (= #{"x" "y"} (:scopes ok)))
    (is (nil? (:refresh ok)) "a refresh response carries no new refresh token")))

(deftest a-response-without-an-access-token-is-malformed-not-ok
  (is (= :malformed (:error (oauth/decode-token "{\"expires_in\":1}")))))

;; ── secrecy ──────────────────────────────────────────────────────────

(deftest a-secret-cannot-survive-redaction
  (let [r (oauth/redact {"client_secret" "GOCSPX-super-secret" "client_id" "cid" "code" "4/0Aaaaa"})]
    (is (= "cid" (get r "client_id")) "the client id is public and stays readable")
    (is (not (includes? (pr-str r) "super-secret")))
    (is (includes? (get r "client_secret") "bytes") "length is kept — that is the useful part")))

;; ── a body that is not JSON ──────────────────────────────────────────
;
; Found against the REAL token endpoint: a request httpc sent with a
; duplicated content-type header came back 400 with an HTML page, and
; `decode-error` raised `{:invalid_byte, 60}` trying to parse it. A sign-in
; that crashes on the error path is worse than one that reports the error,
; so these are the cases that keep it from happening again.

(deftest an-html-error-page-decodes-to-a-config-error
  (let [html "<!DOCTYPE html>\n<html><title>Error 400 (Bad Request)</title></html>"
        e (oauth/decode-error html)]
    (is (= :unparseable (get e :error))
        "no `error` code was given, so none is invented")
    (is (= :config-error (get e :disposition))
        "the server would not parse the request — the same bytes will not parse next time")
    (is (not (includes? (get e :description) "\n"))
        "the body is flattened, so it cannot put a newline in a log line")))

(deftest an-html-token-response-is-unparseable-not-malformed
  (let [r (oauth/decode-token "<html>nope</html>")]
    (is (= :unparseable (get r :error)))
    (is (not (includes? (str r) "history")))))

(deftest a-long-body-is-truncated
  (let [e (oauth/decode-error (join "" (repeat 400 "x")))]
    (is (<= (count (get e :description)) 203))))

(deftest a-real-error-still-classifies
  ; The tolerant path must not swallow the cases it was written around.
  (is (= :reauth (get (oauth/decode-error "{\"error\":\"invalid_grant\"}") :disposition)))
  (is (= :config-error (get (oauth/decode-error "{\"error\":\"redirect_uri_mismatch\"}") :disposition))))

;; ── id_token claims ──────────────────────────────────────────────────

(deftest the-sub-comes-out-of-the-id-token
  ; `sub` is the account identity — the OIDC subject, which is what a
  ; connector keys an account on. The email is a LABEL and can change; the
  ; subject cannot.
  (let [jwt "eyJhbGciOiJSUzI1NiJ9.eyJzdWIiOiIxMjM0NSIsImVtYWlsIjoiYUBiLmMifQ.sig"
        c (oauth/id-claims jwt)]
    (is (= "12345" (get c "sub")))
    (is (= "a@b.c" (get c "email")))))

(deftest a-token-without-three-segments-is-nil
  (is (nil? (oauth/id-claims "not-a-jwt")))
  (is (nil? (oauth/id-claims nil))))

(deftest a-payload-that-is-not-json-is-nil
  (is (nil? (oauth/id-claims "aaa.bm90LWpzb24.sig"))))

;; ── redact ───────────────────────────────────────────────────────────

(deftest redact-takes-the-encoded-form-body
  ; The bug this pins: `redact` was documented as taking "a form body" and only
  ; handled sequences of pairs, so the string every caller actually holds went
  ; through as a charlist and raised `nth/2` — inside the function whose whole
  ; job is to make a failure readable.
  (let [body "client_id=abc&client_secret=supersecret&code=4/0Axyz&grant_type=authorization_code"
        r (oauth/redact body)]
    (is (includes? r "client_id=abc")
        "a non-secret passes through EXACTLY as sent")
    (is (includes? r "grant_type=authorization_code"))
    (is (not (includes? r "supersecret")) "the secret is gone")
    (is (not (includes? r "0Axyz")) "and so is the code — a bearer credential")
    (is (includes? r "client_secret=<11 bytes>")
        "but its LENGTH survives: present-but-wrong and absent are different bugs")))

(deftest redact-still-takes-pairs-and-maps
  ; `token_type` is not a secret and `refresh_token` is, so this is also a
  ; check that the split is on the KEY and not on position.
  (is (= {"token_type" "Bearer" "refresh_token" "<3 bytes>"}
         (oauth/redact [(tuple "token_type" "Bearer") (tuple "refresh_token" "xyz")])))
  (is (= {"token_type" "Bearer"} (oauth/redact {"token_type" "Bearer"}))))

(deftest redact-a-body-with-no-secrets-is-unchanged
  (let [b "grant_type=authorization_code&scope=openid"]
    (is (= b (oauth/redact b)))))
