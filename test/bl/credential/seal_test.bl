(ns credential.seal.test
  (:require [credential.seal :as s]))
(deftest authenticated-bytes
  (let [key (crypto/strong_rand_bytes 32) ctx ["invite" "firm:a" "inv_1" 1]
        env (s/seal key "deployment" ctx "secret")]
    (is (= "secret" (s/open key "deployment" ctx env)))
    (is (not= env (s/seal key "deployment" ctx "secret")))
    (is (thrown? (s/open key "deployment" ["invite" "firm:b" "inv_1" 1] env)))
    (is (thrown? (s/open key "other-key" ctx env)))
    (is (thrown? (s/open (crypto/strong_rand_bytes 32) "deployment" ctx env)))
    (is (thrown? (s/open key "deployment" ctx (assoc env :tag "short"))))
    (is (thrown? (s/open key "deployment" ctx (assoc env :ct "changed"))))
    (is (thrown? (s/seal nil "deployment" ctx "secret")))))
