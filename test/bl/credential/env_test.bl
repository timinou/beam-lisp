(ns credential.env.test
  (:require [credential.env :as env]))

(deftest a-simple-assignment-parses
  (is (= {"A" "1" "B" "2"} (env/parse "A=1\nB=2\n"))))

(deftest blanks-and-comments-are-dropped
  (is (= {"A" "1"} (env/parse "\n# a comment\nA=1\n\n"))))

(deftest a-trailing-comment-is-not-part-of-the-value
  (is (= {"A" "1"} (env/parse "A=1 # this is a note\n"))))

(deftest a-hash-in-a-value-survives-when-it-is-not-a-comment
  ; A URL fragment, a password, a colour. Treating every `#` as a comment
  ; start truncates all three, silently.
  (is (= {"URL" "http://x/y#frag"} (env/parse "URL=http://x/y#frag\n")))
  (is (= {"P" "abc123"} (env/parse "P=abc123\n"))))

(deftest quotes-are-stripped-and-protect-their-contents
  (is (= {"A" "a b"} (env/parse "A=\"a b\"\n")))
  (is (= {"A" "a b"} (env/parse "A='a b'\n")))
  (is (= {"A" "a # b"} (env/parse "A=\"a # b\"\n"))
      "a quoted # is content, not a comment"))

(deftest only-the-first-equals-splits
  ; A base64 signature ends `==`; a connection string is full of them.
  (is (= {"SIG" "abc=="} (env/parse "SIG=abc==\n")))
  (is (= {"URL" "postgres://u:p@h/db?x=1"} (env/parse "URL=postgres://u:p@h/db?x=1\n"))))

(deftest export-prefix-is-accepted
  (is (= {"A" "1"} (env/parse "export A=1\n"))))

(deftest whitespace-around-the-key-and-value-is-trimmed
  (is (= {"A" "1"} (env/parse "  A  =  1  \n"))))

(deftest a-line-without-an-equals-is-skipped
  (is (= {"A" "1"} (env/parse "GARBAGE\nA=1\n"))))

(deftest require!-names-the-missing-key
  (is (= "v" (env/require! {"K" "v"} "K")))
  (is (thrown? (env/require! {} "GOOGLE_OAUTH_CLIENT_ID"))))

(deftest require!-treats-empty-as-absent
  ; An exported-but-empty variable is the most common way to be missing a
  ; credential, and it is the one that passes a naive nil check.
  (is (thrown? (env/require! {"K" ""} "K"))))

(deftest lookup-falls-back
  (is (= "v" (env/lookup {"K" "v"} "K")))
  (is (= "d" (env/lookup {} "K" "d")))
  (is (nil? (env/lookup {} "K"))))
