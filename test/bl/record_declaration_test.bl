; Focused native controls; root runs with existing host_record_test in one VM.
(ns record-declaration-test)
(defn- refused? [action] (try (action) false (catch _ true)))
(defn- name! [] (str "canonical-record-" (erlang/unique_integer (list :positive))))
(deftest descriptor-construction-is-inert-and-only-exact-bodies-are-recognized
 (let [namespace (name!) descriptor (BeamLisp.Record/declaration_descriptor namespace "Shape" :record (list "field"))
       module (:name descriptor)]
  (is (= :module (:op descriptor)))
  (is (= :record (BeamLisp.Record/declaration_kind descriptor namespace "Shape")))
  (is (= (tuple 1 namespace "Shape" :record (list "field")) (BeamLisp.Record/declaration_metadata descriptor)))
  (is (nil? (BeamLisp.Record/info module)))
  (is (not (erlang/module_loaded module)))
  (is (= :error (BeamLisp.Env/lookup (tuple namespace "Shape"))))
  (is (nil? (BeamLisp.Record/declaration_kind (assoc descriptor :name :Elixir.WrongClass) namespace "Shape")))
  (is (nil? (BeamLisp.Record/declaration_kind (assoc descriptor :clauses (list)) namespace "Shape")))
  (is (refused? #(BeamLisp.Record/declaration_descriptor namespace "Bad" :record (list "__struct__"))))
  ;; Legacy duplicate-field constructor/struct behavior remains supported;
  ;; the descriptor producer itself emits no IO warning or initializer effect.
  (is (= :record (BeamLisp.Record/declaration_kind
        (BeamLisp.Record/declaration_descriptor namespace "Duplicates" :record (list "x" "x")) namespace "Duplicates")))))
(deftest canonical-compiler-scaffold-is-one-literal-atomic-producer
 (let [namespace (name!) compiled (BeamLisp.Compiler/compile
         (first (BeamLisp.Reader/read_string "(defrecord Packet [payload])"))
         (BeamLisp.Compiler/new_env namespace))
       init (:init compiled) descriptor (:val (first (:args init)))]
  (is (= :let (:op compiled)))
  (is (= :remote (:op init)))
  (is (= :Elixir.BeamLisp.Record (:mod init)))
  (is (= :publish_declaration! (:fun init)))
  (is (= 1 (count (:args init))))
  (is (= :record (BeamLisp.Record/declaration_kind descriptor namespace "Packet")))
  (is (not (erlang/module_loaded (:name descriptor))))
  (is (nil? (BeamLisp.Record/info (:name descriptor))))))
(deftest exact-class-leases-prevent-code-and-semantic-schema-replacement
 (let [namespace (name!) module (BeamLisp.Record/define namespace "Shape" (list "x"))
       before (BeamLisp.Record/info module) md5 (erlang/apply module :module_info (list :md5))
       ticket (BeamLisp.Env/retain_code! (list module))]
  (try
   (is (= module (BeamLisp.Record/define namespace "Shape" (list "x"))))
   (is (refused? #(BeamLisp.Record/define namespace "Shape" (list "changed"))))
   (is (= before (BeamLisp.Record/info module)))
   (is (= md5 (erlang/apply module :module_info (list :md5))))
   (finally (BeamLisp.Env/release_code! ticket)))
  (is (= module (BeamLisp.Record/define namespace "Shape" (list "changed"))))
  (is (= (list :changed) (BeamLisp.Record/fields_of module))))
 (let [namespace (name!) module (BeamLisp.Record/define_type namespace "Opaque" (list "x"))
       before (BeamLisp.Record/info module) md5 (erlang/apply module :module_info (list :md5))
       ticket (BeamLisp.Env/retain_code! (list module))]
  (try
   ;; Deftype executable bytes do not encode fields. The registry schema is
   ;; nevertheless protected by the SAME physical admission fence.
   (is (refused? #(BeamLisp.Record/define_type namespace "Opaque" (list "x" "extra"))))
   (is (= before (BeamLisp.Record/info module)))
   (is (= md5 (erlang/apply module :module_info (list :md5))))
   (finally (BeamLisp.Env/release_code! ticket)))
  (is (= module (BeamLisp.Record/define_type namespace "Opaque" (list "x" "extra"))))
  (is (= (list :x :extra) (BeamLisp.Record/fields_of module)))))
(deftest origin-collisions-and-missing-replay-artifacts-refuse-without-publication
 (let [base (name!) origin (str base ".source_name") collision (str base ".SourceName")
       module (BeamLisp.Record/define origin "Named" (list "field")) before (BeamLisp.Record/info module)]
  (is (= module (BeamLisp.Record/module_name collision "Named")))
  (is (refused? #(BeamLisp.Record/declaration_descriptor collision "Named" :record (list "field"))))
  (is (= before (BeamLisp.Record/info module))))
 (let [descriptor (BeamLisp.Record/declaration_descriptor (name!) "Missing" :deftype (list "x"))
       module (:name descriptor)]
  (is (refused? #(BeamLisp.Record/replay_declaration! descriptor (crypto/hash :md5 "unavailable"))))
  (is (not (erlang/module_loaded module)))
  (is (nil? (BeamLisp.Record/info module)))))
(deftest staged-type-metadata-does-not-execute-a-class-initializer
 (let [namespace (name!) form (first (BeamLisp.Reader/read_string "(defrecord Future [id])"))
       descriptor (BeamLisp.Record/declaration_descriptor namespace "Future" :record (list "id"))]
  (is (BeamLisp.Compiler/prelink_type form namespace))
  (is (= :error (BeamLisp.Env/lookup (tuple namespace "Future"))))
  (is (nil? (BeamLisp.Record/info (:name descriptor))))
  (is (not (erlang/module_loaded (:name descriptor))))))

(deftest explicit-later-type-binding-wins-over-staged-declaration-metadata
 (let [namespace (name!) form (first (BeamLisp.Reader/read_string "(defrecord Earlier [id])"))
       other (BeamLisp.Record/define namespace "Later" (list "id"))
       _ (BeamLisp.Compiler/prelink_type form namespace)
       _ (BeamLisp.Env/intern namespace "Earlier" other)
       compiled (BeamLisp.Compiler/compile
                 (first (BeamLisp.Reader/read_string "(extend-type Earlier Protocol (method [value] value))"))
                 (BeamLisp.Compiler/new_env namespace))]
  (is (= :extend_type (:fun compiled)))
  (is (= other (:val (nth (:args compiled) 2))))))

(deftest a-nil-masked-type-binding-keeps-the-declared-dispatch-tag
 ;; The SDK constructor view interns every staged binding as nil. A nil var
 ;; is not a later class binding: extend-type must still key on the record
 ;; module, or every impl lands under the bare symbol atom and dispatch on
 ;; real instances fails (datom.store-ets EtsStore regression).
 (let [namespace (name!) form (first (BeamLisp.Reader/read_string "(defrecord Masked [id])"))
       _ (BeamLisp.Compiler/prelink_type form namespace)
       declared (:name (elem (BeamLisp.Env/lookup (tuple :class-declaration namespace "Masked")) 1))
       _ (BeamLisp.Env/intern namespace "Masked" nil)
       compiled (BeamLisp.Compiler/compile
                 (first (BeamLisp.Reader/read_string "(extend-type Masked Protocol (method [value] value))"))
                 (BeamLisp.Compiler/new_env namespace))]
  (is (= :extend_type (:fun compiled)))
  (is (= declared (:val (nth (:args compiled) 2))))
  (is (not= :Masked (:val (nth (:args compiled) 2))))))

; Add after producer controls; emits an actual canonical cold class WITHOUT
; registering origin/schema, matching the AOT preloaded artifact lifecycle.
(deftest a-leased-uninitialized-deftype-requires-the-loaded-canonical-schema
 (let [namespace (name!) descriptor (BeamLisp.Record/declaration_descriptor namespace "Cold" :deftype (list "x"))
       module (:name descriptor) pair (BeamLisp.Emit/compile_descriptor descriptor)
       _ (BeamLisp.Env/publish_binaries! (list pair) "canonical_cold_class")
       ticket (BeamLisp.Env/retain_code! (list module))]
  (try
   (is (nil? (BeamLisp.Record/info module)))
   (is (refused? #(BeamLisp.Record/define_type namespace "Cold" (list "wrong" "extra"))))
   (is (nil? (BeamLisp.Record/info module)))
   (is (= module (BeamLisp.Record/replay_declaration! descriptor
                  (erlang/apply module :module_info (list :md5)))))
   (is (= (list :x) (BeamLisp.Record/fields_of module)))
   (finally (BeamLisp.Env/release_code! ticket)))))

(deftest concurrent-distinct-class-definitions-preserve-every-origin-registry-row
 (let [namespace (name!) parent (erlang/self)
       tasks (mapv (fn [i]
                      (future
                        (erlang/send parent [:record-worker-ready (erlang/self)])
                        ;; A failed parent assertion cannot strand a worker
                        ;; forever at the test-only start barrier.
                        (receive :define-class :go (after 10000 :go))
                        (BeamLisp.Record/define namespace (str "Concurrent" i) (list "value"))))
                    (range 16))
       pids (mapv (fn [_] (receive [:record-worker-ready pid] pid
                             (after 10000 (throw :missing-record-worker)))) (range 16))]
  (doseq [pid pids] (erlang/send pid :define-class))
  ;; Await every actual constructor/publication, not a sleep or mailbox count.
  (doseq [task tasks] (is (not= :unfinished (deref task 30000 :unfinished))))
  (doseq [i (range 16)]
   (let [name (str "Concurrent" i) module (BeamLisp.Record/module_name namespace name)]
    (is (= (tuple :record namespace name (list :value)) (BeamLisp.Record/info module)))
    (is (= module (erlang/map_get :__struct__ (erlang/apply module :__struct__ (list)))))))))

(deftest deftype-fields-preserve-ordinary-nonstruct-semantics
 (let [namespace (name!) module (BeamLisp.Record/define_type namespace "Fields" (list "__struct__" "x" "x"))
       value (BeamLisp.Record/build_type module (list 1 2 3))]
  (is (= (list :__struct__ :x :x) (BeamLisp.Record/fields_of module)))
  (is (= (tuple :bl_deftype module (tuple 1 2 3)) value))
  (is (= 1 (BeamLisp.Record/deftype_field value :__struct__)))
  (is (= 2 (BeamLisp.Record/deftype_field value :x)))))
