(ns aot-constructor-empty-recipes-test)
(defn- literal [value] {:op :lit :val value})
(defn- remote [module function args] {:op :remote :mod module :fun function :args args})
(defn- recipe []
 (remote :Elixir.BeamLisp.LazySeq :new
  (list {:op :fn :clauses (list {:pats (list) :guard nil :body (literal (list 1 2))})})))
(defn- run [expression] (BeamLisp.AOT/interpret_constructor! expression {} {}))
(defn- refusal [action] (try (action) nil (catch error (ex-data error))))
(defn- with-counter [frame action]
 ;; Non-authorizing white-box observation of this boolean helper only. This
 ;; isolated counter fixture creates no SDK/class/execution/owner capability.
 (let [key (tuple :constructor-empty-recipes-test (erlang/make_ref))]
  (when frame (erlang/put key frame))
  (try (action {:counter-frame key} key) (finally (erlang/erase key)))))

(deftest exact-empty-recipe-table-cost-does-not-grow-with-an-immutable-subtree
 (doseq [value [(list) (vec (range 8192)) {:nested [{:items (vec (range 8192))}]}]]
  (with-counter {:remaining 1 :recipes {}}
   (fn [state key]
    (is (= false (BeamLisp.AOT/constructor_recipe_present! value state)))
    (is (= 0 (:remaining (erlang/get key))))))))

(deftest empty-recipe-shortcut-preserves-counter-frame-and-exhaustion-refusals
 (doseq [frame [nil {} {:recipes {}}]]
  (with-counter frame
   (fn [state _]
    (is (= :missing-counter-frame
      (:detail (refusal (fn [] (BeamLisp.AOT/constructor_recipe_present! [1 2] state)))))))))
 (doseq [remaining [0 -1]]
  (with-counter {:remaining remaining :recipes {}}
   (fn [state _]
    (is (= :step-budget
      (:detail (refusal (fn [] (BeamLisp.AOT/constructor_recipe_present! [1 2] state))))))))))

(defn- hidden [kind]
 (let [value (recipe)]
  (case kind
   :list {:op :cons :head value :tail {:op :enil}}
   :tuple {:op :tuple :elems (list value)}
   :map {:op :map :pairs (list (list (literal :hidden) value))}
   :vector {:op :struct :mod :Elixir.BeamLisp.Vector
            :fields (list (list (literal :items) {:op :tuple :elems (list value)}))})))
(deftest actual-owned-recipes-hidden-in-each-container-still-refuse-observation-and-escape
 (doseq [kind [:list :tuple :map :vector]]
  (let [container (hidden kind)]
   (is (= :opaque-finite-recipe-observation
     (:detail (refusal (fn [] (run (remote :erlang :is_map (list container))))))))
   (is (= :finite-recipe-escape
     (:detail (refusal (fn [] (run container)))))))))

(deftest nonempty-frame-with-an-unrelated-recipe-still-allows-plain-data
 (is (= true (run {:op :do :stmts
   (list (recipe) (remote :erlang :is_map (list (literal {:plain [1 2]}))))}))))

(deftest recipe-absence-never-substitutes-for-public-data-validation-or-effect-denial
 (let [marker (str (System/get_env "HOME") "/tmp/empty-recipe-never-run-"
                   (System/unique_integer (list :positive)))
       effect (fn [] (File/write! marker "ran") 1)]
  (try
   (is (= :unsafe-first-order-data
     (:kind (refusal (fn [] (run (remote :Elixir.BeamLisp.Ns.Core :identity (list (literal effect)))))))))
   (is (= :foreign-struct
     (:reason (refusal (fn [] (run (remote :erlang :is_map
       (list (literal {:__struct__ :Elixir.BeamLisp.LazySeq :constructor-frame :forged :constructor-id 1})))))))))
   (is (= false (File/exists? marker)))
   (finally (File/rm marker)))))

(deftest hidden-recipe-observation-does-not-force-an-interpreted-effectful-thunk
 (let [marker (str (System/get_env "HOME") "/tmp/hidden-recipe-never-force-"
                   (System/unique_integer (list :positive)))
       deferred (remote :Elixir.BeamLisp.LazySeq :new
        (list {:op :fn :clauses (list {:pats (list) :guard nil
          :body (remote :Elixir.File :write! (list (literal marker) (literal "bad")))})}))
       container {:op :map :pairs (list (list (literal :hidden) deferred))}]
  (try
   (is (= :opaque-finite-recipe-observation
     (:detail (refusal (fn [] (run (remote :erlang :is_map (list container))))))))
   (is (= false (File/exists? marker)))
   (finally (File/rm marker)))))
