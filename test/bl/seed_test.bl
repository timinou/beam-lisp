; test/bl/seed_test.bl — the bootstrap floor's generator.
;
; `bl seed` replaced `mix run priv/bootstrap/gen_manifest.exs`, and the reason
; the `.exs` needed Mix is the reason this file exists: it asked Mix where the
; compiled beams were. Everything else about it — the closure, the per-beam
; provenance stamp, the refusal to publish a manifest whose keys moved — is a
; property of the FLOOR, and properties of the floor are worth pinning here.
;
; The order of operations is the safety property, and it is the one this file
; spends most of its assertions on: a generator that clears the checked-in floor
; and THEN discovers the replacement beams are foreign has destroyed the floor.
; `seed/run` asks every shim beam what built it BEFORE it writes or deletes
; anything, so a refusal leaves the previous floor exactly where it was.
;
; Run: bl test test/bl/seed_test.bl

(ns test.seed
  (:require [seed]))

(def boot "priv/boot")

(defn- sorted [coll] (vec (sort coll)))

(defn- has? [coll x] (> (count (filter (fn [y] (= y x)) coll)) 0))

; ── what the floor must contain ───────────────────────────────────────────

(deftest the-closure-is-every-boot-source-plus-multi
  (let [sources (Path/wildcard (Path/join boot "*.bl"))
        ns* (seed/namespaces boot)]
    (is (= (inc (count sources)) (count ns*))
        (str "every boot source plus multi, got " (pr-str ns*)))
    (is (has? ns* "Multi") "multi is not a tier file but the compiler needs it")
    (is (has? ns* "Reader-node") "a hyphenated namespace keeps its hyphen in the module name")
    (is (has? ns* "Compiler"))
    (is (has? ns* "Reader"))))

(deftest a-namespace-emits-three-beams
  (is (= ["Ns.Anf" "Ns.Body.Anf" "Ns.Init.Anf"] (seed/variants "Anf")))
  (is (= "Elixir.BeamLisp.Ns.Body.Anf.beam" (seed/beam-of "Ns.Body.Anf"))))

(deftest the-closure-is-closed
  ;; Every beam the run copies belongs to a namespace the closure names: a seed
  ;; that grew a beam nobody declared would be a floor nobody can reason about.
  (let [nss (seed/namespaces boot)
        beams (mapcat (fn [ns] (map seed/beam-of (seed/variants ns))) nss)]
    (is (= (* 3 (count nss)) (count beams)))
    (is (= (count beams) (count (distinct beams))) "no namespace is emitted twice")))

; ── a beam says which namespace it belongs to, and which key it must carry ─

(deftest a-shim-knows-its-namespace
  (is (= "reader-node" (seed/ns-of "Elixir.BeamLisp.Ns.Reader-node.beam")))
  (is (= "anf" (seed/ns-of "Elixir.BeamLisp.Ns.Anf.beam")))
  (is (= "build-log" (seed/ns-of "Elixir.BeamLisp.Ns.Build-log.beam"))))

(deftest only-shims-are-asked-what-built-them
  (is (seed/shim? "Elixir.BeamLisp.Ns.Anf.beam"))
  (is (not (seed/shim? "Elixir.BeamLisp.Ns.Body.Anf.beam")))
  (is (not (seed/shim? "Elixir.BeamLisp.Ns.Init.Anf.beam"))))

(deftest the-tier-decides-which-key-a-beam-must-carry
  ;; Two toolchain keys: the codegen and the driver. A seed beam's stamp is the
  ;; key of ITS tier, and the routing is the emitter's own (`key_for_ns/1`), so a
  ;; beam's stamp and this check cannot disagree about which tier it is in.
  (is (= "COMPILER" (seed/expected-key "anf" "COMPILER" "DRIVER")))
  (is (= "COMPILER" (seed/expected-key "reader-node" "COMPILER" "DRIVER")))
  (is (= "DRIVER" (seed/expected-key "build" "COMPILER" "DRIVER")))
  (is (= "DRIVER" (seed/expected-key "seed" "COMPILER" "DRIVER"))
      "the generator's own namespace is a driver namespace: it must never be floored"))

; ── the refusal, which is what makes the generator safe to run ────────────

(defn- scratch [name]
  (let [d (Path/join (System/tmp_dir) (str "bl-seed-test-" name))]
    (File/rm_rf! d)
    (File/mkdir_p! d)
    d))

(deftest a-floor-with-no-beams-is-refused-and-nothing-is-deleted
  (let [out (scratch "empty-ebin")
        keep (Path/join out "Elixir.BeamLisp.Ns.Anf.beam")
        _ (File/write! keep "the floor that must survive")
        r (seed/run {:root (BeamLisp/cwd) :out out
                     :ebin (Path/join (System/tmp_dir) "bl-seed-test-does-not-exist")})]
    (is (not (:ok? r)) "an ebin with no boot-closure beams cannot produce a floor")
    (is (> (count (:errors r)) 0))
    (is (File/exists? keep)
        "the refusal happens BEFORE the clear: a failed run must not destroy the floor it could not rebuild")))

(deftest a-foreign-beam-is-refused-and-nothing-is-deleted
  ;; The ebin holds a file with a beam's NAME and none of its meaning. Loading it
  ;; must fail the run rather than publish a manifest describing a floor that is
  ;; not there.
  (let [ebin (scratch "foreign-ebin")
        out (scratch "foreign-out")
        keep (Path/join out "the-previous-floor")
        _ (File/write! keep "keep me")
        _ (File/write! (Path/join ebin "Elixir.BeamLisp.Ns.Anf.beam") "not a beam")
        r (seed/run {:root (BeamLisp/cwd) :out out :ebin ebin})]
    (is (not (:ok? r)) "a file that cannot be loaded is not evidence of a build")
    (is (File/exists? keep))))

(deftest a-refused-run-says-what-to-do
  (let [r (seed/run {:root (BeamLisp/cwd)
                     :out (scratch "says-out")
                     :ebin (Path/join (System/tmp_dir) "bl-seed-test-absent")})]
    (is (includes? (join " " (:errors r)) "--ebin")
        "the error names the flag that fixes it, not just the directory that was empty")))

; ── the pinned HOST floor ─────────────────────────────────────────────────
;
; A host module is not a boot shim: it is COMPILED by `seed/run` from checked-in
; source, not copied from an ebin. So its inventory is different (it must appear
; in the manifest and on disk), and its drift signal is different (the floor
; beam carries `bl_source_hash`, the digest of the source it was built from).
; These pin both, on a scratch host source so the tree's real leaf is untouched.

(deftest the-pinned-host-sources-are-explicit
  (let [hs (seed/host-sources "priv/host")]
    (is (= 1 (count hs)) "one production host leaf so far")
    (is (= :"Elixir.BeamLisp.CompilerData" (:module (first hs))))
    (is (= "priv/host/compiler_data.bl" (:source (first hs))))
    (is (= "Elixir.BeamLisp.CompilerData.beam" (seed/host-beam (first hs))))))

(defn- host-fixture [extra]
  (str "(ns seed.host.fixture)\n(defn seeded-probe [x] x)\n" extra))

(defn- host-scratch [name extra]
  (let [d (Path/join (System/tmp_dir) (str "bl-seed-host-" name))]
    (File/rm_rf! d)
    (File/mkdir_p! d)
    (File/write! (Path/join d "compiler_data.bl") (host-fixture extra))
    d))

(defn- restore-assertions!
  "Put the test library back into `core`.

   `seed/run` and `seed/check` LOAD every boot shim to ask its provenance, and
   loading `core` puts the compiled `BeamLisp.Ns.Core` back from `core.bl` —
   which does not carry `is-report/4` (the runner interns the test library into
   core's ENV, not into that beam). Every `is` after such a call would die
   `is-report/4 is undefined or private`. Re-evaluating the library into core is
   exactly what the runner does at file start, so the assertions keep working."
  []
  (let [priv (erlang/list_to_binary (erlang/apply :code :priv_dir (list :beam_lisp)))]
    (BeamLisp.Env/with_ns "core"
      (fn [] (BeamLisp/eval (File/read! (str priv "/std/test.bl")))))))

(defn- seed-run! [opts] (let [r (seed/run opts)] (restore-assertions!) r))
(defn- seed-check! [opts] (let [c (seed/check opts)] (restore-assertions!) c))

(deftest run-publishes-the-pinned-host-beam-and-check-judges-it
  (let [root (BeamLisp/cwd)
        ebin (Path/join root "build")
        out (scratch "host-out")
        hd (host-scratch "host-src" "")]
    (let [r (seed-run! {:root root :out out :ebin ebin :host hd})]
      (is (:ok? r) (str "the floor is generated: " (pr-str (:errors r))))
      (is (File/exists? (Path/join out "Elixir.BeamLisp.CompilerData.beam"))
          "the pinned host beam is COMPILED into the floor, not copied from an ebin")
      ; INVENTORY: the manifest must LIST it, or `Bootstrap.install!/1` never
      ; copies it and the floor silently lacks the host leaf it carries.
      (let [manifest (erlang/element 1 (erlang/apply :Elixir.Code :eval_file
                                          (list (Path/join out "manifest.exs"))))]
        (is (some? (get (get manifest "modules") "Elixir.BeamLisp.CompilerData.beam"))
            "the host beam is in the manifest's module map")))
    (let [c (seed-check! {:root root :out out :host hd})]
      (is (:ok? c) (str "a floor generated from this source is current: " (pr-str (:moved c))))
      (is (has? (:current c) "Elixir.BeamLisp.CompilerData")))
    ; SOURCE DRIFT: the beam is still in the floor, but the source moved.
    (File/write! (Path/join hd "compiler_data.bl") (host-fixture "(defn extra [x] x)\n"))
    (let [c (seed-check! {:root root :out out :host hd})]
      (is (not (:ok? c)) "a host source that changed makes the floor STALE")
      (is (has? (map (fn [r] (:ns r)) (:moved c)) "Elixir.BeamLisp.CompilerData")))
    ; ABSENCE also blocks: there is no action-only host source.
    (File/rm! (Path/join out "Elixir.BeamLisp.CompilerData.beam"))
    (let [c (seed-check! {:root root :out out :host hd})]
      (is (not (:ok? c)) "a floor missing its pinned host beam is not current"))
    (File/rm_rf! out)
    (File/rm_rf! hd)))
