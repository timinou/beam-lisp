; test/bl/seed_test.bl — the bootstrap floor's generator.
;
; `bl seed` replaced `mix run priv/bootstrap/gen_manifest.exs`, and the reason
; the `.exs` needed Mix is the reason this file exists: it asked Mix where the
; compiled beams were. Everything else about it — the closure, the per-beam
; provenance stamp, the refusal to publish a manifest whose keys moved — is a
; property of the FLOOR, and properties of the floor are worth pinning here.
;
; The order of operations is the safety property, and it is the one this file
; spends most of its assertions on: a generator that clears the checked-in floor
; and THEN discovers the replacement beams are foreign has destroyed the floor.
; `seed/run` asks every shim beam what built it BEFORE it writes or deletes
; anything, so a refusal leaves the previous floor exactly where it was.
;
; Run: bl test test/bl/seed_test.bl

(ns test.seed
  (:require [seed]))

(def boot "priv/boot")

(defn- sorted [coll] (vec (sort coll)))

(defn- has? [coll x] (> (count (filter (fn [y] (= y x)) coll)) 0))

; ── what the floor must contain ───────────────────────────────────────────

(deftest the-closure-is-every-boot-source-plus-multi
  (let [sources (Path/wildcard (Path/join boot "*.bl"))
        ns* (seed/namespaces boot)]
    (is (= (inc (count sources)) (count ns*))
        (str "every boot source plus multi, got " (pr-str ns*)))
    (is (has? ns* "Multi") "multi is not a tier file but the compiler needs it")
    (is (has? ns* "Reader-node") "a hyphenated namespace keeps its hyphen in the module name")
    (is (has? ns* "Compiler"))
    (is (has? ns* "Reader"))))

(deftest a-namespace-emits-three-beams
  (is (= ["Ns.Anf" "Ns.Body.Anf" "Ns.Init.Anf"] (seed/variants "Anf")))
  (is (= "Elixir.BeamLisp.Ns.Body.Anf.beam" (seed/beam-of "Ns.Body.Anf"))))

(deftest the-closure-is-closed
  ;; Every beam the run copies belongs to a namespace the closure names: a seed
  ;; that grew a beam nobody declared would be a floor nobody can reason about.
  (let [nss (seed/namespaces boot)
        beams (mapcat (fn [ns] (map seed/beam-of (seed/variants ns))) nss)]
    (is (= (* 3 (count nss)) (count beams)))
    (is (= (count beams) (count (distinct beams))) "no namespace is emitted twice")))

; ── a beam says which namespace it belongs to, and which key it must carry ─

(deftest a-shim-knows-its-namespace
  (is (= "reader-node" (seed/ns-of "Elixir.BeamLisp.Ns.Reader-node.beam")))
  (is (= "anf" (seed/ns-of "Elixir.BeamLisp.Ns.Anf.beam")))
  (is (= "build-log" (seed/ns-of "Elixir.BeamLisp.Ns.Build-log.beam"))))

(deftest only-shims-are-asked-what-built-them
  (is (seed/shim? "Elixir.BeamLisp.Ns.Anf.beam"))
  (is (not (seed/shim? "Elixir.BeamLisp.Ns.Body.Anf.beam")))
  (is (not (seed/shim? "Elixir.BeamLisp.Ns.Init.Anf.beam"))))

(deftest the-tier-decides-which-key-a-beam-must-carry
  ;; Two toolchain keys: the codegen and the driver. A seed beam's stamp is the
  ;; key of ITS tier, and the routing is the emitter's own (`key_for_ns/1`), so a
  ;; beam's stamp and this check cannot disagree about which tier it is in.
  (is (= "COMPILER" (seed/expected-key "anf" "COMPILER" "DRIVER")))
  (is (= "COMPILER" (seed/expected-key "reader-node" "COMPILER" "DRIVER")))
  (is (= "DRIVER" (seed/expected-key "build" "COMPILER" "DRIVER")))
  (is (= "DRIVER" (seed/expected-key "seed" "COMPILER" "DRIVER"))
      "the generator's own namespace is a driver namespace: it must never be floored"))

; ── the refusal, which is what makes the generator safe to run ────────────

(defn- scratch [name]
  (let [d (Path/join (System/tmp_dir) (str "bl-seed-test-" name))]
    (File/rm_rf! d)
    (File/mkdir_p! d)
    d))

(deftest a-floor-with-no-beams-is-refused-and-nothing-is-deleted
  (let [out (scratch "empty-ebin")
        keep (Path/join out "Elixir.BeamLisp.Ns.Anf.beam")
        _ (File/write! keep "the floor that must survive")
        r (seed/run {:root (BeamLisp/cwd) :out out
                     :ebin (Path/join (System/tmp_dir) "bl-seed-test-does-not-exist")})]
    (is (not (:ok? r)) "an ebin with no boot-closure beams cannot produce a floor")
    (is (> (count (:errors r)) 0))
    (is (File/exists? keep)
        "the refusal happens BEFORE the clear: a failed run must not destroy the floor it could not rebuild")))

(deftest a-foreign-beam-is-refused-and-nothing-is-deleted
  ;; The ebin holds a file with a beam's NAME and none of its meaning. Loading it
  ;; must fail the run rather than publish a manifest describing a floor that is
  ;; not there.
  (let [ebin (scratch "foreign-ebin")
        out (scratch "foreign-out")
        keep (Path/join out "the-previous-floor")
        _ (File/write! keep "keep me")
        _ (File/write! (Path/join ebin "Elixir.BeamLisp.Ns.Anf.beam") "not a beam")
        r (seed/run {:root (BeamLisp/cwd) :out out :ebin ebin})]
    (is (not (:ok? r)) "a file that cannot be loaded is not evidence of a build")
    (is (File/exists? keep))))

(deftest a-refused-run-says-what-to-do
  (let [r (seed/run {:root (BeamLisp/cwd)
                     :out (scratch "says-out")
                     :ebin (Path/join (System/tmp_dir) "bl-seed-test-absent")})]
    (is (includes? (join " " (:errors r)) "--ebin")
        "the error names the flag that fixes it, not just the directory that was empty")))

; ── the pinned HOST floor ─────────────────────────────────────────────────
;
; A host module is not a boot shim: it is COMPILED by `seed/run` from checked-in
; source, not copied from an ebin. So its inventory is different (it must appear
; in the manifest and on disk), and its drift signal is different (the floor
; beam carries `bl_source_hash`, the digest of the source it was built from).
; These pin both, per leaf, on a scratch host source so the tree's real leaves
; are untouched. The fixture DERIVES its filenames from `seed/host-sources`, so
; it cannot drift from the mapping it is testing.

(deftest the-pinned-host-sources-are-explicit
  ;; A table, not a sweep: each pinned leaf names the EXACT module its source
  ;; becomes. All fifty-two are asserted, or a leaf could be added (or dropped)
  ;; while the floor still claimed the set it was built with. The struct-field
  ;; and behaviour mappings are pinned too, because they are the options that
  ;; decide what surface a pinned beam has: a struct module
  ;; (`Delay`/`Derived`/`Set`/`SeqCursor`/`Vector`/`LazySeq`/`Decimal`, and the
  ;; five reference-cell types `Atom`/`Volatile`/`Reduced`/`Promise`/`Future`
  ;; that share ONE source), a MACRO
  ;; module (`Decimal` and `Guards`, through the table's TWO `:macro-exports`
  ;; entries — `is_decimal/1`, and the guards' three `is_bl_map/1`/`is_ref_type/1`/
  ;; `is_data_tuple/1`), a
  ;; behaviour module (`WebSocket`, `Application`, `Loader.Server`, `ReloadWatcher` and the
  ;; exception types), or
  ;; functions-only (`Deferred`/`Reactive`, the `Enumerable`/`Inspect` impls,
  ;; `Inspect.Decimal`, the reference runtime `Refs`, the metadata pair
  ;; `Meta`/`FormMeta` with `Num`, the runtime seams `AtomGuard`/`Transient`, and the `Sorted` family — `Sorted` itself plus the two hand-written struct types `SortedMap`/`SortedSet`, which carry no `:struct_fields` because the pinned SOURCE spells the struct surface out and the opt would collide, the appended tree-builder `Supervisor` and port driver `Z3Port`, and the appended open-dispatch engine `Multi` and `defserver` runtime `Server`, and the appended `Guards` macro module and functions-only `Record` factory, and the appended bounded-tracing `Trace` and live-reload `ReloadWatcher` GenServer).
  (let [hs (seed/host-sources "priv/host")]
    (is (= 52 (count hs)) "the substrate four, the Delay/Deferred, Derived/Reactive, Set/SetEnumerable and SeqCursor/SeqCursorEnumerable pairs, the Vector/VectorEnumerable pair, the LazySeq quartet of ForceError, LazySeq, LazySeqEnumerable and LazySeqInspect, the WebSocket and Application behaviour modules, the Meta/FormMeta metadata pair beside Num, the Reader/Compiler front doors with the reader's two exception types, the compiler's CompileError beside the thrown ExInfo, and the runtime seams AtomGuard with its LimitError beside Transient, and the Sorted family — the functions-only Sorted with its two hand-written struct types SortedMap and SortedSet, and the exact-decimal pair — the pinned struct Decimal with its :struct-fields beside the TWO :macro-exports in the table — Decimal's is_decimal/1 and Guards' three guard macros, and the functions-only Inspect.Decimal, and the reference runtime — the five bare struct types Atom, Volatile, Reduced, Promise and Future sharing ONE source refs_structs.bl at five exact atoms, beside the functions-only Refs, and the pinned Loader.Server GenServer carrying :behaviour, and the appended Supervisor tree-builder and Z3Port port driver, both functions-only, and the appended Multi open-dispatch engine and Server defserver runtime, both functions-only, and the appended Guards macro module and functions-only Record type factory, and the appended bounded-tracing Trace and live-reload ReloadWatcher GenServer")
    (is (= ["Elixir.BeamLisp.Application" "Elixir.BeamLisp.Atom" "Elixir.BeamLisp.AtomGuard" "Elixir.BeamLisp.AtomGuard.LimitError" "Elixir.BeamLisp.CompileError" "Elixir.BeamLisp.Compiler" "Elixir.BeamLisp.CompilerData" "Elixir.BeamLisp.Decimal" "Elixir.BeamLisp.Deferred" "Elixir.BeamLisp.Delay" "Elixir.BeamLisp.Derived" "Elixir.BeamLisp.Emit" "Elixir.BeamLisp.ExInfo" "Elixir.BeamLisp.FormMeta" "Elixir.BeamLisp.Future" "Elixir.BeamLisp.Guards" "Elixir.BeamLisp.LazySeq" "Elixir.BeamLisp.LazySeq.ForceError" "Elixir.BeamLisp.Link" "Elixir.BeamLisp.Loader.Server" "Elixir.BeamLisp.Meta" "Elixir.BeamLisp.Multi" "Elixir.BeamLisp.Num" "Elixir.BeamLisp.Promise" "Elixir.BeamLisp.Reactive" "Elixir.BeamLisp.Reader" "Elixir.BeamLisp.Reader.AtomLimitError" "Elixir.BeamLisp.Reader.SyntaxError" "Elixir.BeamLisp.Record" "Elixir.BeamLisp.Reduced" "Elixir.BeamLisp.Refs" "Elixir.BeamLisp.ReloadWatcher" "Elixir.BeamLisp.SeqCursor" "Elixir.BeamLisp.Server" "Elixir.BeamLisp.Set" "Elixir.BeamLisp.Sorted" "Elixir.BeamLisp.Sorted.SortedMap" "Elixir.BeamLisp.Sorted.SortedSet" "Elixir.BeamLisp.Supervisor" "Elixir.BeamLisp.Tiers" "Elixir.BeamLisp.Trace" "Elixir.BeamLisp.Transient" "Elixir.BeamLisp.Vector" "Elixir.BeamLisp.Volatile" "Elixir.BeamLisp.WebSocket" "Elixir.BeamLisp.Z3Port" "Elixir.Enumerable.BeamLisp.LazySeq" "Elixir.Enumerable.BeamLisp.SeqCursor" "Elixir.Enumerable.BeamLisp.Set" "Elixir.Enumerable.BeamLisp.Vector" "Elixir.Inspect.BeamLisp.Decimal" "Elixir.Inspect.BeamLisp.LazySeq"]
           (sorted (map (fn [e] (str (:module e))) hs))))
    (is (= ["priv/host/application.bl" "priv/host/atom_guard.bl" "priv/host/atom_guard_limit_error.bl" "priv/host/compile_error.bl" "priv/host/compiler.bl" "priv/host/compiler_data.bl" "priv/host/decimal.bl" "priv/host/decimal_inspect.bl" "priv/host/deferred.bl" "priv/host/delay.bl" "priv/host/derived.bl" "priv/host/emit.bl" "priv/host/ex_info.bl" "priv/host/form_meta.bl" "priv/host/guards.bl" "priv/host/lazy_seq.bl" "priv/host/lazy_seq_enumerable.bl" "priv/host/lazy_seq_force_error.bl" "priv/host/lazy_seq_inspect.bl" "priv/host/link.bl" "priv/host/loader_server.bl" "priv/host/meta.bl" "priv/host/multi.bl" "priv/host/num.bl" "priv/host/reactive.bl" "priv/host/reader.bl" "priv/host/reader_exception.bl" "priv/host/reader_exception.bl" "priv/host/record.bl" "priv/host/refs.bl" "priv/host/refs_structs.bl" "priv/host/refs_structs.bl" "priv/host/refs_structs.bl" "priv/host/refs_structs.bl" "priv/host/refs_structs.bl" "priv/host/reload_watcher.bl" "priv/host/seq_cursor.bl" "priv/host/seq_cursor_enumerable.bl" "priv/host/server.bl" "priv/host/set.bl" "priv/host/set_enumerable.bl" "priv/host/sorted.bl" "priv/host/sorted_map.bl" "priv/host/sorted_set.bl" "priv/host/supervisor.bl" "priv/host/tiers.bl" "priv/host/trace.bl" "priv/host/transient.bl" "priv/host/vector.bl" "priv/host/vector_enumerable.bl" "priv/host/web_socket.bl" "priv/host/z3_port.bl"]
           (sorted (map (fn [e] (:source e)) hs))))
    (is (= ["Elixir.BeamLisp.Application.beam" "Elixir.BeamLisp.Atom.beam" "Elixir.BeamLisp.AtomGuard.LimitError.beam" "Elixir.BeamLisp.AtomGuard.beam" "Elixir.BeamLisp.CompileError.beam" "Elixir.BeamLisp.Compiler.beam" "Elixir.BeamLisp.CompilerData.beam" "Elixir.BeamLisp.Decimal.beam" "Elixir.BeamLisp.Deferred.beam" "Elixir.BeamLisp.Delay.beam" "Elixir.BeamLisp.Derived.beam" "Elixir.BeamLisp.Emit.beam" "Elixir.BeamLisp.ExInfo.beam" "Elixir.BeamLisp.FormMeta.beam" "Elixir.BeamLisp.Future.beam" "Elixir.BeamLisp.Guards.beam" "Elixir.BeamLisp.LazySeq.ForceError.beam" "Elixir.BeamLisp.LazySeq.beam" "Elixir.BeamLisp.Link.beam" "Elixir.BeamLisp.Loader.Server.beam" "Elixir.BeamLisp.Meta.beam" "Elixir.BeamLisp.Multi.beam" "Elixir.BeamLisp.Num.beam" "Elixir.BeamLisp.Promise.beam" "Elixir.BeamLisp.Reactive.beam" "Elixir.BeamLisp.Reader.AtomLimitError.beam" "Elixir.BeamLisp.Reader.SyntaxError.beam" "Elixir.BeamLisp.Reader.beam" "Elixir.BeamLisp.Record.beam" "Elixir.BeamLisp.Reduced.beam" "Elixir.BeamLisp.Refs.beam" "Elixir.BeamLisp.ReloadWatcher.beam" "Elixir.BeamLisp.SeqCursor.beam" "Elixir.BeamLisp.Server.beam" "Elixir.BeamLisp.Set.beam" "Elixir.BeamLisp.Sorted.SortedMap.beam" "Elixir.BeamLisp.Sorted.SortedSet.beam" "Elixir.BeamLisp.Sorted.beam" "Elixir.BeamLisp.Supervisor.beam" "Elixir.BeamLisp.Tiers.beam" "Elixir.BeamLisp.Trace.beam" "Elixir.BeamLisp.Transient.beam" "Elixir.BeamLisp.Vector.beam" "Elixir.BeamLisp.Volatile.beam" "Elixir.BeamLisp.WebSocket.beam" "Elixir.BeamLisp.Z3Port.beam" "Elixir.Enumerable.BeamLisp.LazySeq.beam" "Elixir.Enumerable.BeamLisp.SeqCursor.beam" "Elixir.Enumerable.BeamLisp.Set.beam" "Elixir.Enumerable.BeamLisp.Vector.beam" "Elixir.Inspect.BeamLisp.Decimal.beam" "Elixir.Inspect.BeamLisp.LazySeq.beam"]
           (sorted (map (fn [e] (seed/host-beam e)) hs))))
    (let [by-mod (fn [m] (first (filter (fn [e] (= (str (:module e)) m)) hs)))]
      (is (= (list (tuple :seq nil)) (:struct-fields (by-mod "Elixir.BeamLisp.Delay")))
          "Delay carries the :seq struct field the pinned beam synthesizes")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Deferred")))
          "Deferred is functions-only: no :struct_fields opt")
      (is (= (list (tuple :cell nil) (tuple :deps nil) (tuple :thunk nil))
             (:struct-fields (by-mod "Elixir.BeamLisp.Derived")))
          "Derived carries the :cell/:deps/:thunk struct fields, in that order")
      (is (= (list (tuple :members nil)) (:struct-fields (by-mod "Elixir.BeamLisp.Set")))
          "Set carries the :members struct field")
      (is (= (list (tuple :chunk ()) (tuple :tail nil) (tuple :dirty false))
             (:struct-fields (by-mod "Elixir.BeamLisp.SeqCursor")))
          "SeqCursor carries the :chunk/:tail/:dirty struct fields, in that order, with :chunk defaulting to the RAW Erlang empty list")
      (is (= (list (tuple :items (erlang/list_to_tuple (list))) (tuple :meta nil))
             (:struct-fields (by-mod "Elixir.BeamLisp.Vector")))
          "Vector carries the :items/:meta struct fields, :items defaulting to the RAW Erlang empty tuple")
      (is (nil? (:struct-fields (by-mod "Elixir.Enumerable.BeamLisp.Vector")))
          "Enumerable.Vector is functions-only: no :struct_fields opt")
      (is (= (list (tuple :__exception__ true) (tuple :reason nil) (tuple :message nil))
             (:struct-fields (by-mod "Elixir.BeamLisp.LazySeq.ForceError")))
          "LazySeq.ForceError carries the defexception [:reason, :message] struct fields, :__exception__ first")
      (is (= :"Elixir.Exception" (:behaviour (by-mod "Elixir.BeamLisp.LazySeq.ForceError")))
          "LazySeq.ForceError records -behaviour(Exception)")
      (is (= (list (tuple :resource nil) (tuple :metadata nil))
             (:struct-fields (by-mod "Elixir.BeamLisp.LazySeq")))
          "LazySeq carries the :resource/:metadata struct fields in declaration order")
      (is (nil? (:struct-fields (by-mod "Elixir.Enumerable.BeamLisp.LazySeq")))
          "Enumerable.LazySeq is functions-only: no :struct_fields opt")
      (is (nil? (:struct-fields (by-mod "Elixir.Inspect.BeamLisp.LazySeq")))
          "Inspect.LazySeq is functions-only: no :struct_fields opt")
      (is (= :"Elixir.WebSock" (:behaviour (by-mod "Elixir.BeamLisp.WebSocket")))
          "WebSocket carries the :behaviour opt so its pinned beam records -behaviour(WebSock)")
      (is (= :"Elixir.Application" (:behaviour (by-mod "Elixir.BeamLisp.Application")))
          "Application carries the :behaviour opt so its pinned beam records -behaviour(Application)")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Application")))
          "Application is functions-only: no :struct_fields opt")
      (is (= (list (tuple :__exception__ true) (tuple :message nil))
             (:struct-fields (by-mod "Elixir.BeamLisp.Reader.SyntaxError")))
          "Reader.SyntaxError carries the defexception [:message] struct fields, :__exception__ first")
      (is (= :"Elixir.Exception" (:behaviour (by-mod "Elixir.BeamLisp.Reader.SyntaxError")))
          "Reader.SyntaxError records -behaviour(Exception)")
      (is (= (list (tuple :__exception__ true) (tuple :message nil))
             (:struct-fields (by-mod "Elixir.BeamLisp.Reader.AtomLimitError")))
          "Reader.AtomLimitError carries the SAME struct fields, from the SAME source")
      (is (= :"Elixir.Exception" (:behaviour (by-mod "Elixir.BeamLisp.Reader.AtomLimitError")))
          "Reader.AtomLimitError records -behaviour(Exception)")
      (is (= (:source (by-mod "Elixir.BeamLisp.Reader.SyntaxError"))
             (:source (by-mod "Elixir.BeamLisp.Reader.AtomLimitError")))
          "the two exceptions share ONE source: the mapping is a table, not deduped by source path")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Reader")))
          "Reader is functions-only: no :struct_fields opt")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Compiler")))
          "Compiler is functions-only: no :struct_fields opt")
      (is (= (list (tuple :__exception__ true) (tuple :message nil)
                   (tuple :file nil) (tuple :line nil) (tuple :form nil))
             (:struct-fields (by-mod "Elixir.BeamLisp.CompileError")))
          "CompileError carries the defexception [:message, :file, :line, :form] struct fields in DECLARATION order, :__exception__ first")
      (is (= :"Elixir.Exception" (:behaviour (by-mod "Elixir.BeamLisp.CompileError")))
          "CompileError records -behaviour(Exception)")
      (is (= (list (tuple :__exception__ true) (tuple :message nil) (tuple :data nil))
             (:struct-fields (by-mod "Elixir.BeamLisp.ExInfo")))
          "ExInfo carries the defexception [:message, :data] struct fields in DECLARATION order, :__exception__ first")
      (is (= :"Elixir.Exception" (:behaviour (by-mod "Elixir.BeamLisp.ExInfo")))
          "ExInfo records -behaviour(Exception)")
      (is (= (list (tuple :__exception__ true) (tuple :message nil))
             (:struct-fields (by-mod "Elixir.BeamLisp.AtomGuard.LimitError")))
          "AtomGuard.LimitError carries the defexception [:message] struct fields, :__exception__ first")
      (is (= :"Elixir.Exception" (:behaviour (by-mod "Elixir.BeamLisp.AtomGuard.LimitError")))
          "AtomGuard.LimitError records -behaviour(Exception)")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.AtomGuard")))
          "AtomGuard is functions-only: no :struct_fields opt")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Transient")))
          "Transient is functions-only: no :struct_fields opt")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Sorted")))
          "Sorted is functions-only: no :struct_fields opt")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Sorted.SortedMap")))
          "SortedMap writes __struct__/0,1 and __info__/1 by HAND, so the mapping carries NO :struct_fields — the opt would collide with the hand-written surface")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Sorted.SortedSet")))
          "SortedSet writes __struct__/0,1 and __info__/1 by HAND, so the mapping carries NO :struct_fields — the opt would collide with the hand-written surface")
      (is (= (list (tuple :unscaled 0) (tuple :scale 0))
             (:struct-fields (by-mod "Elixir.BeamLisp.Decimal")))
          "Decimal carries the :unscaled/:scale struct fields the pinned beam synthesizes, in that order")
      (is (= (list (tuple :is_decimal 1))
             (:macro-exports (by-mod "Elixir.BeamLisp.Decimal")))
          "Decimal is one of the TWO entries declaring :macro-exports: is_decimal/1, the defguard as a require-able macro")
      (is (= (list (tuple :is_bl_map 1) (tuple :is_ref_type 1) (tuple :is_data_tuple 1))
             (:macro-exports (by-mod "Elixir.BeamLisp.Guards")))
          "Guards is the other: its three defguards as require-able macros, in declaration order")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Guards")))
          "Guards is functions-only: no :struct_fields opt")
      (is (nil? (:behaviour (by-mod "Elixir.BeamLisp.Guards")))
          "Guards records no -behaviour")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Record")))
          "Record is functions-only: no :struct_fields opt")
      (is (nil? (:behaviour (by-mod "Elixir.BeamLisp.Record")))
          "Record records no -behaviour")
      (is (nil? (:macro-exports (by-mod "Elixir.BeamLisp.Record")))
          "Record declares no :macro-exports: the factory has no compile-time artifact")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Trace")))
          "Trace is functions-only: no :struct_fields opt")
      (is (nil? (:behaviour (by-mod "Elixir.BeamLisp.Trace")))
          "Trace records no -behaviour")
      (is (nil? (:macro-exports (by-mod "Elixir.BeamLisp.Trace")))
          "Trace declares no :macro-exports either")
      (is (= :"Elixir.GenServer" (:behaviour (by-mod "Elixir.BeamLisp.ReloadWatcher")))
          "ReloadWatcher carries the :behaviour opt so its pinned beam records -behaviour(GenServer)")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.ReloadWatcher")))
          "ReloadWatcher is functions-only: no :struct_fields opt")
      (is (nil? (:macro-exports (by-mod "Elixir.BeamLisp.ReloadWatcher")))
          "ReloadWatcher declares no :macro-exports either")
      (is (nil? (:macro-exports (by-mod "Elixir.BeamLisp.Deferred")))
          "an entry with no :macro-exports carries no such key, so its option list is unchanged")
      (is (nil? (:struct-fields (by-mod "Elixir.Inspect.BeamLisp.Decimal")))
          "Inspect.Decimal is functions-only: no :struct_fields opt")
      (is (nil? (:macro-exports (by-mod "Elixir.Inspect.BeamLisp.Decimal")))
          "Inspect.Decimal declares no :macro-exports either")
      (is (= (list (tuple :cell nil) (tuple :watches nil))
             (:struct-fields (by-mod "Elixir.BeamLisp.Atom")))
          "Atom carries the :cell/:watches struct fields the pinned beam synthesizes, in that order")
      (is (= (list (tuple :key nil)) (:struct-fields (by-mod "Elixir.BeamLisp.Volatile")))
          "Volatile carries the :key struct field")
      (is (= (list (tuple :value nil)) (:struct-fields (by-mod "Elixir.BeamLisp.Reduced")))
          "Reduced carries the :value struct field")
      (is (= (list (tuple :pid nil)) (:struct-fields (by-mod "Elixir.BeamLisp.Promise")))
          "Promise carries the :pid struct field")
      (is (= (list (tuple :task nil)) (:struct-fields (by-mod "Elixir.BeamLisp.Future")))
          "Future carries the :task struct field")
      (is (has? (map (fn [m] (str (:source (by-mod m))))
                     ["Elixir.BeamLisp.Volatile" "Elixir.BeamLisp.Reduced"
                      "Elixir.BeamLisp.Promise" "Elixir.BeamLisp.Future"])
                 (str (:source (by-mod "Elixir.BeamLisp.Atom"))))
          "the five refs types share ONE source (refs_structs.bl): the mapping maps ENTRIES, not sources, and no source path is deduped")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Refs")))
          "Refs is functions-only: no :struct_fields opt")
      (is (nil? (:behaviour (by-mod "Elixir.BeamLisp.Refs")))
          "Refs records no -behaviour")
      (is (nil? (:macro-exports (by-mod "Elixir.BeamLisp.Refs")))
          "Refs declares no :macro-exports either")
      (is (= :"Elixir.GenServer" (:behaviour (by-mod "Elixir.BeamLisp.Loader.Server")))
          "Loader.Server carries the :behaviour opt so its pinned beam records -behaviour(GenServer)")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Loader.Server")))
          "Loader.Server is functions-only: no :struct_fields opt")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Supervisor")))
          "Supervisor is functions-only: no :struct_fields opt")
      (is (nil? (:behaviour (by-mod "Elixir.BeamLisp.Supervisor")))
          "Supervisor records no -behaviour")
      (is (nil? (:macro-exports (by-mod "Elixir.BeamLisp.Supervisor")))
          "Supervisor declares no :macro-exports either")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Z3Port")))
          "Z3Port is functions-only: no :struct_fields opt")
      (is (nil? (:behaviour (by-mod "Elixir.BeamLisp.Z3Port")))
          "Z3Port records no -behaviour")
      (is (nil? (:macro-exports (by-mod "Elixir.BeamLisp.Z3Port")))
          "Z3Port declares no :macro-exports either"))
    (is (= ["Elixir.BeamLisp.Application" "Elixir.BeamLisp.AtomGuard.LimitError" "Elixir.BeamLisp.CompileError" "Elixir.BeamLisp.ExInfo" "Elixir.BeamLisp.LazySeq.ForceError" "Elixir.BeamLisp.Loader.Server" "Elixir.BeamLisp.Reader.AtomLimitError" "Elixir.BeamLisp.Reader.SyntaxError" "Elixir.BeamLisp.ReloadWatcher" "Elixir.BeamLisp.WebSocket"]
           (sorted (keep (fn [e] (if (some? (:behaviour e)) (str (:module e)) nil)) hs)))
        "Application, WebSocket, Loader.Server, ReloadWatcher, LazySeq.ForceError and the five exception types (the reader's two, CompileError, ExInfo and AtomGuard.LimitError) are the ONLY entries that record a behaviour; every other beam is behaviour-free")
    (doseq [m ["Elixir.BeamLisp.CompilerData" "Elixir.BeamLisp.Emit" "Elixir.BeamLisp.Link" "Elixir.BeamLisp.Tiers"
               "Elixir.BeamLisp.Reactive" "Elixir.Enumerable.BeamLisp.Set" "Elixir.Enumerable.BeamLisp.SeqCursor" "Elixir.Enumerable.BeamLisp.Vector" "Elixir.Enumerable.BeamLisp.LazySeq" "Elixir.Inspect.BeamLisp.LazySeq" "Elixir.Inspect.BeamLisp.Decimal"
               "Elixir.BeamLisp.Meta" "Elixir.BeamLisp.FormMeta" "Elixir.BeamLisp.Num"
               "Elixir.BeamLisp.Application" "Elixir.BeamLisp.Reader" "Elixir.BeamLisp.Compiler"
               "Elixir.BeamLisp.AtomGuard" "Elixir.BeamLisp.Transient" "Elixir.BeamLisp.Refs" "Elixir.BeamLisp.Loader.Server" "Elixir.BeamLisp.Sorted" "Elixir.BeamLisp.Sorted.SortedMap" "Elixir.BeamLisp.Sorted.SortedSet" "Elixir.BeamLisp.Supervisor" "Elixir.BeamLisp.Z3Port" "Elixir.BeamLisp.Multi" "Elixir.BeamLisp.Server" "Elixir.BeamLisp.Guards" "Elixir.BeamLisp.Record" "Elixir.BeamLisp.Trace" "Elixir.BeamLisp.ReloadWatcher"]]
      (is (nil? (:struct-fields (first (filter (fn [e] (= (str (:module e)) m)) hs))))
          (str m " stays functions-only")))))

(deftest the-host-inventory-is-the-mapping-in-table-order
  ;; The manifest's `hosts` list is written from the mapping, so its order is the
  ;; TABLE's — reproducible, not a map's iteration order — because it is an
  ;; inventory a reader (and `Bootstrap`) compares against the mapping. A
  ;; consumer selecting host beams from it gets the same set on every read.
  (let [hs (seed/host-sources "priv/host")]
    (is (= (seed/host-names hs) (vec (map (fn [e] (seed/host-beam e)) hs)))
        "host-names is host-beam over the mapping, in table order")
    (is (= (count hs) (count (seed/host-names hs))))
    (is (= ["Elixir.BeamLisp.CompilerData.beam"
            "Elixir.BeamLisp.Emit.beam"
            "Elixir.BeamLisp.Link.beam"
            "Elixir.BeamLisp.Tiers.beam"
            "Elixir.BeamLisp.Delay.beam"
            "Elixir.BeamLisp.Deferred.beam"
            "Elixir.BeamLisp.Derived.beam"
            "Elixir.BeamLisp.Reactive.beam"
            "Elixir.BeamLisp.Set.beam"
            "Elixir.Enumerable.BeamLisp.Set.beam"
            "Elixir.BeamLisp.SeqCursor.beam"
            "Elixir.Enumerable.BeamLisp.SeqCursor.beam"
            "Elixir.BeamLisp.WebSocket.beam"
            "Elixir.BeamLisp.Meta.beam"
            "Elixir.BeamLisp.FormMeta.beam"
            "Elixir.BeamLisp.Num.beam"
            "Elixir.BeamLisp.Application.beam"
            "Elixir.BeamLisp.Reader.SyntaxError.beam"
            "Elixir.BeamLisp.Reader.AtomLimitError.beam"
            "Elixir.BeamLisp.Reader.beam"
            "Elixir.BeamLisp.Compiler.beam"
            "Elixir.BeamLisp.CompileError.beam"
            "Elixir.BeamLisp.ExInfo.beam"
            "Elixir.BeamLisp.AtomGuard.LimitError.beam"
            "Elixir.BeamLisp.AtomGuard.beam"
            "Elixir.BeamLisp.Transient.beam"
            "Elixir.BeamLisp.Vector.beam"
            "Elixir.Enumerable.BeamLisp.Vector.beam"
            "Elixir.BeamLisp.LazySeq.ForceError.beam"
            "Elixir.BeamLisp.LazySeq.beam"
            "Elixir.Enumerable.BeamLisp.LazySeq.beam"
            "Elixir.Inspect.BeamLisp.LazySeq.beam"
            "Elixir.BeamLisp.Sorted.beam"
            "Elixir.BeamLisp.Sorted.SortedMap.beam"
            "Elixir.BeamLisp.Sorted.SortedSet.beam"
            "Elixir.BeamLisp.Decimal.beam"
            "Elixir.Inspect.BeamLisp.Decimal.beam"
            "Elixir.BeamLisp.Atom.beam"
            "Elixir.BeamLisp.Volatile.beam"
            "Elixir.BeamLisp.Reduced.beam"
            "Elixir.BeamLisp.Promise.beam"
            "Elixir.BeamLisp.Future.beam"
            "Elixir.BeamLisp.Refs.beam"
            "Elixir.BeamLisp.Loader.Server.beam"
            "Elixir.BeamLisp.Supervisor.beam"
            "Elixir.BeamLisp.Z3Port.beam"
            "Elixir.BeamLisp.Multi.beam"
            "Elixir.BeamLisp.Server.beam"
            "Elixir.BeamLisp.Guards.beam"
            "Elixir.BeamLisp.Record.beam"
            "Elixir.BeamLisp.Trace.beam"
            "Elixir.BeamLisp.ReloadWatcher.beam"]
           (seed/host-names hs))
        "the table order is explicit, not sorted")))

(defn- host-fixture [extra]
  ;; A `MACRO-<name>` implementer is part of the fixture because a mapping entry
  ;; that declares `:macro-exports` (Decimal's `is_decimal/1`, the guards'
  ;; `is_bl_map/1`/`is_ref_type/1`/`is_data_tuple/1`) is REFUSED by name unless
  ;; the compiled source carries the matching `MACRO-<name>/<arity+1>`. Leaves
  ;; that declare no macros simply export harmless extra functions.
  (str "(ns seed.host.fixture)\n"
       "(defn seeded-probe [x] x)\n"
       "(defn MACRO-is_decimal [caller x] nil)\n"
       "(defn MACRO-is_bl_map [caller x] nil)\n"
       "(defn MACRO-is_ref_type [caller x] nil)\n"
       "(defn MACRO-is_data_tuple [caller x] nil)\n"
       extra))

(defn- host-scratch
  "A scratch host dir holding a fixture source for EVERY entry
   `seed/host-sources` names. `real` optionally maps a module's `(str)` name to
   a checked-in source whose CONTENT is written in place of the fixture, so a
   test can drive the seed's own mapping with the real bytes of a leaf whose
   compiled surface it wants to inspect. The filenames come from the mapping
   itself, so this fixture can never test a shape the seed does not look for."
  ([name extra] (host-scratch name extra {}))
  ([name extra real]
   (let [d (Path/join (System/tmp_dir) (str "bl-seed-host-" name))]
     (File/rm_rf! d)
     (File/mkdir_p! d)
     (doseq [e (seed/host-sources d)]
       (let [p (get real (str (:module e)))]
         (File/write! (:source e)
           (if (some? p) (File/read! p) (host-fixture extra)))))
     d)))

(defn- beam-exports
  "The export list a beam DECLARES, read from its `:exports` chunk without
   loading it. The question a published struct beam answers is about the bytes
   the floor carries, and a live module of the same name may be on the code
   path — so the beam is READ, never loaded."
  [path]
  (let [r (erlang/apply :beam_lib :chunks
                        (list (erlang/binary_to_list path) (list :exports)))]
    (if (and (tuple? r) (erlang/== :ok (erlang/element 1 r)))
      (let [chunks (erlang/element 2 (erlang/element 2 r))]
        (erlang/element 2 (erlang/hd chunks)))
      (list))))

(defn- with-swapped-module
  "Run `f` with `mod` replaced by the BEAM at `path`, then put the module that was
   there back. The pinned host leaves are LIVE modules in this VM (the Elixir
   implementation of `decimal.ex` is still running at this wave), so a published
   beam is read by swapping it in and restoring the original — the same read
   `test/bl/host_decimal_test.bl` does at the production atom."
  [mod path f]
  (let [orig-path (erlang/apply :code :which (list mod))
        orig-bin (if (erlang/== :non_existing orig-path)
                   nil
                   (File/read! (erlang/list_to_binary orig-path)))]
    (try
      (do
        (code/purge mod)
        (code/delete mod)
        (code/load_binary mod (erlang/binary_to_list path) (File/read! path))
        (f mod))
      (finally
        (code/purge mod)
        (code/delete mod)
        (if (some? orig-bin)
          (code/load_binary mod orig-path orig-bin)
          :ok)))))

(defn- restore-assertions!
  "Put the test library back into `core`.

   `seed/run` and `seed/check` LOAD every boot shim to ask its provenance, and
   loading `core` puts the compiled `BeamLisp.Ns.Core` back from `core.bl` —
   which does not carry `is-report/4` (the runner interns the test library into
   core's ENV, not into that beam). Every `is` after such a call would die
   `is-report/4 is undefined or private`. Re-evaluating the library into core is
   exactly what the runner does at file start, so the assertions keep working."
  []
  (let [priv (erlang/list_to_binary (erlang/apply :code :priv_dir (list :beam_lisp)))]
    (BeamLisp.Env/with_ns "core"
      (fn [] (BeamLisp/eval (File/read! (str priv "/std/test.bl")))))))

(defn- seed-run! [opts] (let [r (seed/run opts)] (restore-assertions!) r))
(defn- seed-check! [opts] (let [c (seed/check opts)] (restore-assertions!) c))

(deftest run-publishes-every-pinned-host-beam-and-check-judges-it
  (let [root (BeamLisp/cwd)
        ebin (Path/join root "build")
        out (scratch "host-out")
        hd (host-scratch "host-src" "")
        hosts (seed/host-sources hd)
        nss (map (fn [e] (str (:module e))) hosts)
        beams (map (fn [e] (seed/host-beam e)) hosts)]
    (let [r (seed-run! {:root root :out out :ebin ebin :host hd})]
      (is (:ok? r) (str "the floor is generated: " (pr-str (:errors r))))
      (doseq [b beams]
        (is (File/exists? (Path/join out b))
            (str b " is COMPILED into the floor, not copied from an ebin")))
      ; INVENTORY: the manifest must LIST every host beam, or
      ; `Bootstrap.install!/1` never copies it and the floor silently lacks the
      ; host leaf it carries.
      (let [manifest (erlang/element 1 (erlang/apply :Elixir.Code :eval_file
                                          (list (Path/join out "manifest.exs"))))]
        (doseq [b beams]
          (is (some? (get (get manifest "modules") b))
              (str b " is in the manifest's module map")))
        ; INVENTORY: the manifest must NAME its host beams as data — the
        ; host-sources mapping's filenames, in the table's own order — so a
        ; consumer selects host beams by the list, not by a name prefix. The
        ; list is what lets a pinned leaf outside `Elixir.BeamLisp.*` be staged.
        (is (erlang/is_list (get manifest "hosts"))
            "the manifest inventory is a plain Erlang list, not a BL Vector")
        (is (= (seed/host-names hosts) (get manifest "hosts"))
            (str "the manifest's `hosts` list is the mapping's filenames in table order, got "
                 (pr-str (get manifest "hosts"))))))
    ; THE MACRO ABI of the PUBLISHED Decimal beam. `:macro-exports` is the whole
    ; difference between a plain function named `MACRO-is_decimal` and a macro a
    ; `require`d caller can expand, and the floor's beam must carry BOTH halves:
    ; the implementer as an EXPORT and `{is_decimal, 1}` in `__info__(:macros)`.
    ; The atom names a LIVE host leaf in this VM, so the beam is read by swapping
    ; it in, reading it, and restoring the live module.
    (let [decimal-beam (Path/join out "Elixir.BeamLisp.Decimal.beam")]
      (is (has? (beam-exports decimal-beam) (tuple :"MACRO-is_decimal" 2))
          "the published Decimal beam exports the MACRO-is_decimal/2 implementer")
      (is (has? (beam-exports decimal-beam) (tuple :seeded-probe 1))
          "and the fixture's own defn, so the beam read here is the one this run compiled")
      (is (erlang/== (list (tuple :is_decimal 1))
                     (with-swapped-module :"Elixir.BeamLisp.Decimal" decimal-beam
                       (fn [m] (erlang/apply m :__info__ (list :macros)))))
          "and advertises it through __info__(:macros), so `require BeamLisp.Decimal` expands is_decimal/1"))
    (let [c (seed-check! {:root root :out out :host hd})]
      (is (:ok? c) (str "a floor generated from this source is current: " (pr-str (:moved c))))
      (doseq [n nss]
        (is (has? (:current c) n) (str n " is judged current"))))
    ; SOURCE DRIFT: one leaf's source moves while its beam stays in the floor.
    ; Checked per leaf, because the whole point of the table is that each pinned
    ; source is judged on its OWN digest, not on the set's.
    (doseq [e hosts]
      (File/write! (:source e) (host-fixture "(defn extra [x] x)\n"))
      (let [c (seed-check! {:root root :out out :host hd})]
        (is (not (:ok? c)) (str (:module e) " moved — the floor is STALE"))
        (is (has? (map (fn [r] (:ns r)) (:moved c)) (str (:module e))))))
    ; ABSENCE also blocks: there is no action-only host source.
    (doseq [e hosts]
      (File/rm! (Path/join out (seed/host-beam e)))
      (let [c (seed-check! {:root root :out out :host hd})]
        (is (not (:ok? c))
            (str "a floor missing " (seed/host-beam e) " is not current"))))
    (File/rm_rf! out)
    (File/rm_rf! hd)))

(deftest the-sorted-struct-types-publish-a-struct-surface-without-struct-fields
  ;; `SortedMap`/`SortedSet` are bare `defstruct [:tree]` types whose
  ;; `__struct__/0,1` and `__info__/1` the pinned source writes BY HAND:
  ;; `compile_host_file` refuses a source with no top-level `defn`, and the
  ;; `:struct_fields` opt REFUSES a module that already spells the surface out.
  ;; So the mapping is FUNCTIONS-ONLY — and the beam the floor PUBLISHES must
  ;; still be a struct module. Judged from the beam's own export chunk, not from
  ;; the mapping's options: this is the fact the options cannot state.
  (let [root (BeamLisp/cwd)
        ebin (Path/join root "build")
        out (scratch "struct-out")
        real {"Elixir.BeamLisp.Sorted.SortedMap" (Path/join root "priv/host/sorted_map.bl")
              "Elixir.BeamLisp.Sorted.SortedSet" (Path/join root "priv/host/sorted_set.bl")}
        hd (host-scratch "struct-src" "" real)
        r (seed-run! {:root root :out out :ebin ebin :host hd})]
    (is (:ok? r) (str "the floor is generated: " (pr-str (:errors r))))
    (doseq [m ["Elixir.BeamLisp.Sorted.SortedMap" "Elixir.BeamLisp.Sorted.SortedSet"]]
      (let [beam (Path/join out (str m ".beam"))
            exports (beam-exports beam)]
        (is (File/exists? beam) (str m " is COMPILED into the floor"))
        (is (has? exports (tuple :__struct__ 0)) (str m " exposes __struct__/0"))
        (is (has? exports (tuple :__struct__ 1)) (str m " exposes __struct__/1"))
        (is (has? exports (tuple :__info__ 1)) (str m " exposes __info__/1"))))
    (File/rm_rf! out)
    (File/rm_rf! hd)))


(deftest the-refs-struct-types-publish-their-constructor-surface
  ;; `Atom`, `Volatile`, `Reduced`, `Promise` and `Future` are the five bare
  ;; struct TYPES `lib/beam_lisp/refs.ex` declares beside `BeamLisp.Refs`; ONE
  ;; source (`refs_structs.bl`) is compiled at all five exact atoms, each entry
  ;; carrying only the `:struct-fields` that name ITS shape. The mapping maps
  ;; ENTRIES, not sources, so the floor publishes five DIFFERENT beams from the
  ;; same file — a source-path dedupe would drop four of them. Judged on the
  ;; PUBLISHED beams, from the real sources: every type must be a struct module
  ;; (`__struct__/0,1` and `__info__/1`) with the source's one `new/1`
  ;; constructor beside it, and `__info__(:struct)` must be the LIVE module's,
  ;; datum for datum — the fact the table's options cannot state. `Refs`, from
  ;; `refs.bl`, is functions-only and publishes no struct surface; its `deref`
  ;; reads all five types by their public tag, so it needs no type beam loaded.
  (let [root (BeamLisp/cwd)
        ebin (Path/join root "build")
        out (scratch "refs-out")
        structs (Path/join root "priv/host/refs_structs.bl")
        real {"Elixir.BeamLisp.Atom" structs
              "Elixir.BeamLisp.Volatile" structs
              "Elixir.BeamLisp.Reduced" structs
              "Elixir.BeamLisp.Promise" structs
              "Elixir.BeamLisp.Future" structs
              "Elixir.BeamLisp.Refs" (Path/join root "priv/host/refs.bl")}
        hd (host-scratch "refs-src" "" real)
        r (seed-run! {:root root :out out :ebin ebin :host hd})]
    (is (:ok? r) (str "the floor is generated: " (pr-str (:errors r))))
    (doseq [m ["Elixir.BeamLisp.Atom" "Elixir.BeamLisp.Volatile" "Elixir.BeamLisp.Reduced"
               "Elixir.BeamLisp.Promise" "Elixir.BeamLisp.Future"]]
      (let [mod (String/to_atom m)
            beam (Path/join out (str m ".beam"))
            exports (beam-exports beam)
            live (erlang/apply mod :__info__ (list :struct))]
        (is (File/exists? beam) (str m " is COMPILED into the floor"))
        (is (has? exports (tuple :__struct__ 0)) (str m " exposes __struct__/0"))
        (is (has? exports (tuple :__struct__ 1)) (str m " exposes __struct__/1"))
        (is (has? exports (tuple :__info__ 1)) (str m " exposes __info__/1"))
        (is (has? exports (tuple :new 1)) (str m " exposes the shared source's new/1"))
        (is (= live
               (with-swapped-module mod beam
                 (fn [mm] (erlang/apply mm :__info__ (list :struct)))))
            (str m "'s published __info__(:struct) is the live module's, datum for datum"))))
    (let [refs-beam (Path/join out "Elixir.BeamLisp.Refs.beam")
          exports (beam-exports refs-beam)]
      (is (File/exists? refs-beam) "Refs is COMPILED into the floor")
      (is (not (has? exports (tuple :__struct__ 0)))
          "Refs is functions-only: the published beam carries no struct surface")
      (is (has? exports (tuple :deref 1)) "Refs exposes deref/1"))
    (File/rm_rf! out)
    (File/rm_rf! hd)))


(deftest the-loader-server-publishes-its-genserver-callback-surface
  ;; `Loader.Server` is the OTP application child started before `BeamLisp.init/0`
  ;; interns one var: `BeamLisp.Application` passes the MODULE ATOM in the child
  ;; list, so OTP asks the PINNED beam for its generated `child_spec/1` and then
  ;; the GenServer callbacks. The mapping is functions-only with ONE opt —
  ;; `:behaviour :"Elixir.GenServer"` — and the beam the floor PUBLISHES must
  ;; carry the whole GenServer surface: the generated `child_spec/1` and the four
  ;; generated defaults (`handle_cast/2`, `handle_info/2`, `terminate/2`,
  ;; `code_change/3`) beside the module's own `start_link/1`, `init/1` and
  ;; `handle_call/3`. Judged from the beam's own export chunk, from the REAL
  ;; source, so the assertion cannot drift from the file the seed compiles.
  (let [root (BeamLisp/cwd)
        ebin (Path/join root "build")
        out (scratch "loader-out")
        real {"Elixir.BeamLisp.Loader.Server" (Path/join root "priv/host/loader_server.bl")}
        hd (host-scratch "loader-src" "" real)
        r (seed-run! {:root root :out out :ebin ebin :host hd})]
    (is (:ok? r) (str "the floor is generated: " (pr-str (:errors r))))
    (let [beam (Path/join out "Elixir.BeamLisp.Loader.Server.beam")
          exports (beam-exports beam)]
      (is (File/exists? beam) "Loader.Server is COMPILED into the floor")
      (doseq [f [["start_link" 1] ["child_spec" 1] ["init" 1] ["in_server?" 0]
                 ["run" 1] ["handle_call" 3] ["handle_cast" 2] ["handle_info" 2]
                 ["terminate" 2] ["code_change" 3]]]
        (is (has? exports (tuple (String/to_atom (first f)) (second f)))
            (str "Loader.Server exposes " (first f) "/" (second f)))))
    (File/rm_rf! out)
    (File/rm_rf! hd)))


(deftest the-supervisor-publishes-the-tree-builders-public-surface
  ;; `Elixir.BeamLisp.Supervisor` is the NAME the OTP application registers its
  ;; top supervisor under, and it is ALSO the module `rt.bl`'s `supervise`/
  ;; `worker` rows bind by VALUE and `priv/std/proc/super.bl` calls directly, so
  ;; the floor must publish the tree-builder's whole public surface at that atom.
  ;; The mapping is functions-only — no `:struct-fields`, no `:behaviour`, no
  ;; `:macro-exports` — and the published beam is judged from its own export
  ;; chunk, from the REAL source, against the live module's callables minus
  ;; Elixir's own `__info__/1`, which a pinned functions-only beam does not carry.
  (let [root (BeamLisp/cwd)
        ebin (Path/join root "build")
        out (scratch "supervisor-out")
        real {"Elixir.BeamLisp.Supervisor" (Path/join root "priv/host/supervisor.bl")}
        hd (host-scratch "supervisor-src" "" real)
        r (seed-run! {:root root :out out :ebin ebin :host hd})]
    (is (:ok? r) (str "the floor is generated: " (pr-str (:errors r))))
    (let [beam (Path/join out "Elixir.BeamLisp.Supervisor.beam")
          exports (beam-exports beam)
          live (erlang/apply :"Elixir.BeamLisp.Supervisor" :module_info (list :exports))
          want (Enum/sort (filter (fn [e] (not (erlang/== :__info__ (elem e 0)))) live))]
      (is (File/exists? beam) "Supervisor is COMPILED into the floor")
      (is (= want (Enum/sort exports))
          "the published Supervisor beam exports exactly the live module's callables — it has no defn- helper to add")
      (is (not (has? exports (tuple :__info__ 1)))
          "Supervisor is functions-only: the published beam carries no Elixir __info__/1"))
    (File/rm_rf! out)
    (File/rm_rf! hd)))


(deftest the-z3-port-publishes-the-port-drivers-public-surface
  ;; `Elixir.BeamLisp.Z3Port` is the pure-function port driver `priv/std/z3pool.bl`
  ;; owns a port and calls by name (`env_ms`, `open`, `raw_check`, `raw_command`,
  ;; `raw_scoped`, `raw_check_here3`, `alive?`), so the floor must publish the
  ;; driver's whole public surface at that atom. The mapping is functions-only —
  ;; no `:struct-fields`, no `:behaviour`, no `:macro-exports` — and the published
  ;; beam is judged from its own export chunk, from the REAL source, against the
  ;; production module's callables (already pinned). `defn-` helpers are
  ;; exported on both production and scratch beams, and are asserted by name.
  (let [root (BeamLisp/cwd)
        ebin (Path/join root "build")
        out (scratch "z3-port-out")
        real {"Elixir.BeamLisp.Z3Port" (Path/join root "priv/host/z3_port.bl")}
        hd (host-scratch "z3-port-src" "" real)
        r (seed-run! {:root root :out out :ebin ebin :host hd})]
    (is (:ok? r) (str "the floor is generated: " (pr-str (:errors r))))
    (let [beam (Path/join out "Elixir.BeamLisp.Z3Port.beam")
          exports (beam-exports beam)
          live (erlang/apply :"Elixir.BeamLisp.Z3Port" :module_info (list :exports))
          want (Enum/sort (filter (fn [e] (not (erlang/== :__info__ (elem e 0)))) live))]
      (is (File/exists? beam) "Z3Port is COMPILED into the floor")
      (is (every? (fn [e] (has? exports e)) want)
          "the published Z3Port beam exports every live callable, arity for arity")
      (is (= () (filter (fn [e] (not (has? want e))) exports))
          "the published beam matches the pinned production export surface")
      (is (every? (fn [e] (has? exports e))
                  (list (tuple :missing_solver_message 0) (tuple :resolve_exe 0)
                        (tuple :candidate_paths 0) (tuple :extract_reason 1)
                        (tuple :read_until_marker 3) (tuple :read_answer 2)
                        (tuple :read_sexp 2) (tuple :balanced? 1)))
          "all private helpers remain present in the pinned ABI")
      (is (has? exports (tuple :raw_check 3))
          "Z3Port exposes raw_check/3, the pool's primary entry")
      (is (not (has? exports (tuple :__info__ 1)))
          "Z3Port is functions-only: the published beam carries no Elixir __info__/1"))
    (File/rm_rf! out)
    (File/rm_rf! hd)))


(deftest the-multi-publishes-the-open-dispatch-public-surface
  ;; `Elixir.BeamLisp.Multi` is the runtime engine for OPEN DISPATCH — the
  ;; multimethods and protocols the language's `defmulti`/`defmethod` and
  ;; `defprotocol`/`extend-type`/`deftype` lower to and dispatch through — so
  ;; the floor must publish the engine's whole public surface at that atom. The
  ;; mapping is functions-only — no `:struct-fields`, no `:behaviour`, no
  ;; `:macro-exports` — and the published beam is judged from its own export
  ;; chunk, from the REAL source, against the live module's callables minus
  ;; Elixir's own `__info__/1`, which a pinned functions-only beam does not
  ;; carry. The pinned source inlines the live module's `defn-` helpers
  ;; (`multi!`/`no_method_error`/`walk_ancestors`/`protocol!`) as LOCAL
  ;; closures, so the export list is the live module's exactly.
  (let [root (BeamLisp/cwd)
        ebin (Path/join root "build")
        out (scratch "multi-out")
        real {"Elixir.BeamLisp.Multi" (Path/join root "priv/host/multi.bl")}
        hd (host-scratch "multi-src" "" real)
        r (seed-run! {:root root :out out :ebin ebin :host hd})]
    (is (:ok? r) (str "the floor is generated: " (pr-str (:errors r))))
    (let [beam (Path/join out "Elixir.BeamLisp.Multi.beam")
          exports (beam-exports beam)
          live (erlang/apply :"Elixir.BeamLisp.Multi" :module_info (list :exports))
          want (Enum/sort (filter (fn [e] (not (erlang/== :__info__ (elem e 0)))) live))]
      (is (File/exists? beam) "Multi is COMPILED into the floor")
      (is (= want (Enum/sort exports))
          "the published Multi beam exports exactly the live module's callables — every defn- helper is a local closure")
      (doseq [f [["type_of" 1] ["normalize_key" 1] ["define_multi" 3] ["add_method" 4]
                 ["method_keys" 2] ["dispatch" 3] ["derive" 3] ["parents" 2]
                 ["ancestors" 2] ["isa?" 3] ["underive" 3] ["define_protocol" 3]
                 ["extend_type" 4] ["dispatch_protocol" 4] ["satisfies?" 3]]]
        (is (has? exports (tuple (String/to_atom (first f)) (second f)))
            (str "Multi exposes " (first f) "/" (second f))))
      (is (not (has? exports (tuple :__info__ 1)))
          "Multi is functions-only: the published beam carries no Elixir __info__/1"))
    (File/rm_rf! out)
    (File/rm_rf! hd)))


(deftest the-server-publishes-the-defserver-public-surface
  ;; `Elixir.BeamLisp.Server` is the runtime side of the `defserver` special
  ;; form: `compile-defserver` lowers `(defserver …)` into a real `:gen_server`
  ;; behaviour module and asks this module for the generated module NAME
  ;; (`module_for/2`), the OTP callback names and clause shapes (`callback/1`,
  ;; `callback_order/0`), and the return constructors bound as locals in every
  ;; callback body (`return_constructors/0`), while `start`/`start_link`/
  ;; `call`/`cast`/`stop` are the client side that wraps `:gen_server` — so the
  ;; floor must publish the driver's whole public surface at that atom. The
  ;; mapping is functions-only — no `:struct-fields`, no `:behaviour`, no
  ;; `:macro-exports` — and the published beam is judged from its own export
  ;; chunk, from the REAL source, against the live module's callables minus
  ;; `__info__/1`. The pinned source inlines the live module's `defn-` helpers
  ;; (`convey_arg`/`unwrap`/`server_name`/`gen_opts`/`resolve`) as LOCAL
  ;; closures, so the export list is the live module's exactly.
  (let [root (BeamLisp/cwd)
        ebin (Path/join root "build")
        out (scratch "server-out")
        real {"Elixir.BeamLisp.Server" (Path/join root "priv/host/server.bl")}
        hd (host-scratch "server-src" "" real)
        r (seed-run! {:root root :out out :ebin ebin :host hd})]
    (is (:ok? r) (str "the floor is generated: " (pr-str (:errors r))))
    (let [beam (Path/join out "Elixir.BeamLisp.Server.beam")
          exports (beam-exports beam)
          live (erlang/apply :"Elixir.BeamLisp.Server" :module_info (list :exports))
          want (Enum/sort (filter (fn [e] (not (erlang/== :__info__ (elem e 0)))) live))]
      (is (File/exists? beam) "Server is COMPILED into the floor")
      (is (= want (Enum/sort exports))
          "the published Server beam exports exactly the live module's callables — every defn- helper is a local closure")
      (doseq [f [["module_for" 2] ["return_constructors" 0] ["callback" 1]
                 ["callback_order" 0] ["bind_init" 1] ["start_link" 1]
                 ["start_link" 2] ["start_link" 3] ["start" 1] ["start" 2]
                 ["start" 3] ["call" 2] ["call" 3] ["cast" 2] ["stop" 1]
                 ["stop" 2]]]
        (is (has? exports (tuple (String/to_atom (first f)) (second f)))
            (str "Server exposes " (first f) "/" (second f))))
      (is (not (has? exports (tuple :__info__ 1)))
          "Server is functions-only: the published beam carries no Elixir __info__/1"))
    (File/rm_rf! out)
    (File/rm_rf! hd)))


(deftest the-guards-publishes-its-macro-abi
  ;; `Elixir.BeamLisp.Guards` is the single place that names the "struct is a
  ;; map" invariant, and its value IS its compile-time ABI: three `defguard`s
  ;; (`is_bl_map/1`, `is_ref_type/1`, `is_data_tuple/1`) are PAIRS — a
  ;; `MACRO-<name>/2` implementer plus the `__info__(:macros)` entry the seed
  ;; declares through `:macro-exports` — beside the one plain function
  ;; `internal_tuple_tags/0`. `record.ex` `import`s `is_bl_map/1` and uses it in
  ;; a GUARD, so the published beam must carry BOTH halves of each pair or
  ;; `elixirc` refuses to expand the call at all. Judged from the beam's own
  ;; export chunk and, for the macros table, by swapping the beam in at the
  ;; production atom and reading `__info__(:macros)` — from the REAL source, so
  ;; the assertion cannot drift from the file the seed compiles.
  (let [root (BeamLisp/cwd)
        ebin (Path/join root "build")
        out (scratch "guards-out")
        real {"Elixir.BeamLisp.Guards" (Path/join root "priv/host/guards.bl")}
        hd (host-scratch "guards-src" "" real)
        r (seed-run! {:root root :out out :ebin ebin :host hd})]
    (is (:ok? r) (str "the floor is generated: " (pr-str (:errors r))))
    (let [beam (Path/join out "Elixir.BeamLisp.Guards.beam")
          exports (beam-exports beam)]
      (is (File/exists? beam) "Guards is COMPILED into the floor")
      (doseq [f [["internal_tuple_tags" 0] ["MACRO-is_bl_map" 2]
                 ["MACRO-is_ref_type" 2] ["MACRO-is_data_tuple" 2]]]
        (is (has? exports (tuple (String/to_atom (first f)) (second f)))
            (str "Guards exposes " (first f) "/" (second f))))
      (is (not (has? exports (tuple :__struct__ 0)))
          "Guards is functions-only: the published beam carries no struct surface")
      (is (erlang/== (list (tuple :is_bl_map 1) (tuple :is_data_tuple 1) (tuple :is_ref_type 1))
                     (with-swapped-module :"Elixir.BeamLisp.Guards" beam
                       (fn [m] (erlang/apply m :__info__ (list :macros)))))
          "the published beam advertises all three macros — `__info__(:macros)` is SORTED, unlike the mapping's declaration order — so `require BeamLisp.Guards` expands them"))
    (File/rm_rf! out)
    (File/rm_rf! hd)))

(deftest the-record-publishes-the-abi-surface
  ;; `Elixir.BeamLisp.Record` is beam-lisp's `defrecord`/`deftype` type factory —
  ;; the module every caller already names at that exact atom — so the floor must
  ;; publish the factory's whole public ABI there. The mapping is functions-only
  ;; (no `:struct-fields`, no `:behaviour`, no `:macro-exports`): a record is a
  ;; synthesized struct MODULE and a deftype a tagged tuple, so the factory beam
  ;; declares no struct of its own. Judged from the beam's own export chunk, from
  ;; the REAL source, against the live module's callables minus `__info__/1` (a
  ;; pinned functions-only beam does not carry Elixir's generated `__info__/1`).
  ;; The pinned file's own `defn-` helpers are exports too, so the published
  ;; surface is the live one PLUS them — hence `every?`, not equality.
  (let [root (BeamLisp/cwd)
        ebin (Path/join root "build")
        out (scratch "record-out")
        real {"Elixir.BeamLisp.Record" (Path/join root "priv/host/record.bl")}
        hd (host-scratch "record-src" "" real)
        r (seed-run! {:root root :out out :ebin ebin :host hd})]
    (is (:ok? r) (str "the floor is generated: " (pr-str (:errors r))))
    (let [beam (Path/join out "Elixir.BeamLisp.Record.beam")
          exports (beam-exports beam)
          live (erlang/apply :"Elixir.BeamLisp.Record" :module_info (list :exports))
          want (Enum/sort (filter (fn [e] (not (erlang/== :__info__ (elem e 0)))) live))]
      (is (File/exists? beam) "Record is COMPILED into the floor")
      (is (every? (fn [e] (has? exports e)) want)
          "the published Record beam exports every live callable, arity for arity")
      (doseq [f [["define" 3] ["define_type" 3] ["record?" 1] ["record_module?" 1]
                 ["deftype_module?" 1] ["info" 1] ["fields_of" 1]
                 ["positional_ctor" 1] ["map_ctor" 1] ["struct_map" 2]
                 ["map_construct" 2] ["construct_list" 2] ["literal" 3]
                 ["build_type" 2] ["deftype_field" 2]
                 ["generated_struct" 2] ["generated_struct" 3]]]
        (is (has? exports (tuple (String/to_atom (first f)) (second f)))
            (str "Record exposes " (first f) "/" (second f))))
      (is (not (has? exports (tuple :__struct__ 0)))
          "Record is functions-only: the published beam carries no struct surface")
      (is (not (has? exports (tuple :__info__ 1)))
          "Record is functions-only: the published beam carries no Elixir __info__/1"))
    (File/rm_rf! out)
    (File/rm_rf! hd)))


(deftest the-reload-watcher-publishes-its-genserver-callback-surface
  ;; `Elixir.BeamLisp.ReloadWatcher` is the dev-only live-reload watcher the
  ;; `reload` namespace starts to turn a `.bl` save into a staged bundle edit,
  ;; so the floor must publish the watcher's whole GenServer surface at that
  ;; atom. The mapping is functions-only with ONE opt — `:behaviour` (the
  ;; `Elixir.GenServer` atom, forwarded to `compile-host-file` exactly as
  ;; `Loader.Server`'s is) — so the emitted beam records `-behaviour(GenServer)`
  ;; and every behaviour reader, OTP included, judges it as a GenServer callback
  ;; module. `use GenServer`'s generated defaults (`child_spec/1`,
  ;; `handle_cast/2`, `code_change/3`) are spelled out in the pinned source
  ;; beside the module's own `start_link/1`, `init/1`, `handle_call/3`,
  ;; `handle_info/2`, `terminate/2`, the process API (`drain/0,1`, `sync/0,1,2`)
  ;; and the reload seam (`apply_change/1,2,3`), so the floor beam's export list
  ;; is the live module's exactly. Judged from the beam's own export chunk, from
  ;; the REAL source, so the assertion cannot drift from the file the seed
  ;; compiles.
  (let [root (BeamLisp/cwd)
        ebin (Path/join root "build")
        out (scratch "reload-watcher-out")
        real {"Elixir.BeamLisp.ReloadWatcher" (Path/join root "priv/host/reload_watcher.bl")}
        hd (host-scratch "reload-watcher-src" "" real)
        r (seed-run! {:root root :out out :ebin ebin :host hd})]
    (is (:ok? r) (str "the floor is generated: " (pr-str (:errors r))))
    (let [beam (Path/join out "Elixir.BeamLisp.ReloadWatcher.beam")
          exports (beam-exports beam)]
      (is (File/exists? beam) "ReloadWatcher is COMPILED into the floor")
      (is (has? exports (tuple :child_spec 1))
          "the pinned beam carries use GenServer's generated child_spec/1")
      (doseq [f [["start_link" 1] ["child_spec" 1] ["init" 1] ["handle_call" 3]
                 ["handle_cast" 2] ["handle_info" 2] ["terminate" 2]
                 ["code_change" 3] ["drain" 0] ["drain" 1] ["sync" 0] ["sync" 1]
                 ["sync" 2] ["apply_change" 1] ["apply_change" 2] ["apply_change" 3]]]
        (is (has? exports (tuple (String/to_atom (first f)) (second f)))
            (str "ReloadWatcher exposes " (first f) "/" (second f))))
      (is (not (has? exports (tuple :__struct__ 0)))
          "ReloadWatcher is functions-only: the published beam carries no struct surface")
      (is (not (has? exports (tuple :__info__ 1)))
          "ReloadWatcher is functions-only: the published beam carries no Elixir __info__/1"))
    (File/rm_rf! out)
    (File/rm_rf! hd)))

(deftest the-trace-publishes-its-bounded-tracing-surface
  ;; `Elixir.BeamLisp.Trace` is the pinned module `rt.bl`'s `trace`/`untrace`
  ;; rows bind by name: it exposes the BEAM's `:dbg` as data, tracing ONE named
  ;; function at a time and delivering `{:trace pid :call {mod fun args}}` events
  ;; to a handler. The mapping is functions-only — no `:struct-fields`, no
  ;; `:behaviour`, no `:macro-exports` — so the published beam exports exactly
  ;; `trace/3`, `trace/4` and `untrace/2`, every private helper a local closure.
  ;; Judged from the beam's own export chunk, from the REAL source, so the
  ;; assertion cannot drift from the file the seed compiles.
  (let [root (BeamLisp/cwd)
        ebin (Path/join root "build")
        out (scratch "trace-out")
        real {"Elixir.BeamLisp.Trace" (Path/join root "priv/host/trace.bl")}
        hd (host-scratch "trace-src" "" real)
        r (seed-run! {:root root :out out :ebin ebin :host hd})]
    (is (:ok? r) (str "the floor is generated: " (pr-str (:errors r))))
    (let [beam (Path/join out "Elixir.BeamLisp.Trace.beam")
          exports (beam-exports beam)]
      (is (File/exists? beam) "Trace is COMPILED into the floor")
      (doseq [f [["trace" 3] ["trace" 4] ["untrace" 2]]]
        (is (has? exports (tuple (String/to_atom (first f)) (second f)))
            (str "Trace exposes " (first f) "/" (second f))))
      (is (= (list (tuple :module_info 0) (tuple :module_info 1)
                   (tuple :trace 3) (tuple :trace 4) (tuple :untrace 2))
             (Enum/sort exports))
          "the published Trace beam exports exactly trace/3, trace/4 and untrace/2 — every helper is a local closure")
      (is (not (has? exports (tuple :__struct__ 0)))
          "Trace is functions-only: the published beam carries no struct surface")
      (is (not (has? exports (tuple :__info__ 1)))
          "Trace is functions-only: the published beam carries no Elixir __info__/1"))
    (File/rm_rf! out)
    (File/rm_rf! hd)))
