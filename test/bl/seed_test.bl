; test/bl/seed_test.bl — the bootstrap floor's generator.
;
; `bl seed` replaced `mix run priv/bootstrap/gen_manifest.exs`, and the reason
; the `.exs` needed Mix is the reason this file exists: it asked Mix where the
; compiled beams were. Everything else about it — the closure, the per-beam
; provenance stamp, the refusal to publish a manifest whose keys moved — is a
; property of the FLOOR, and properties of the floor are worth pinning here.
;
; The order of operations is the safety property, and it is the one this file
; spends most of its assertions on: a generator that clears the checked-in floor
; and THEN discovers the replacement beams are foreign has destroyed the floor.
; `seed/run` asks every shim beam what built it BEFORE it writes or deletes
; anything, so a refusal leaves the previous floor exactly where it was.
;
; Run: bl test test/bl/seed_test.bl

(ns test.seed
  (:require [seed]))

(def boot "priv/boot")

(defn- sorted [coll] (vec (sort coll)))

(defn- has? [coll x] (> (count (filter (fn [y] (= y x)) coll)) 0))

; ── what the floor must contain ───────────────────────────────────────────

(deftest the-closure-is-every-boot-source-plus-multi
  (let [sources (Path/wildcard (Path/join boot "*.bl"))
        ns* (seed/namespaces boot)]
    (is (= (inc (count sources)) (count ns*))
        (str "every boot source plus multi, got " (pr-str ns*)))
    (is (has? ns* "Multi") "multi is not a tier file but the compiler needs it")
    (is (has? ns* "Reader-node") "a hyphenated namespace keeps its hyphen in the module name")
    (is (has? ns* "Compiler"))
    (is (has? ns* "Reader"))))

(deftest a-namespace-emits-three-beams
  (is (= ["Ns.Anf" "Ns.Body.Anf" "Ns.Init.Anf"] (seed/variants "Anf")))
  (is (= "Elixir.BeamLisp.Ns.Body.Anf.beam" (seed/beam-of "Ns.Body.Anf"))))

(deftest the-closure-is-closed
  ;; Every beam the run copies belongs to a namespace the closure names: a seed
  ;; that grew a beam nobody declared would be a floor nobody can reason about.
  (let [nss (seed/namespaces boot)
        beams (mapcat (fn [ns] (map seed/beam-of (seed/variants ns))) nss)]
    (is (= (* 3 (count nss)) (count beams)))
    (is (= (count beams) (count (distinct beams))) "no namespace is emitted twice")))

; ── a beam says which namespace it belongs to, and which key it must carry ─

(deftest a-shim-knows-its-namespace
  (is (= "reader-node" (seed/ns-of "Elixir.BeamLisp.Ns.Reader-node.beam")))
  (is (= "anf" (seed/ns-of "Elixir.BeamLisp.Ns.Anf.beam")))
  (is (= "build-log" (seed/ns-of "Elixir.BeamLisp.Ns.Build-log.beam"))))

(deftest only-shims-are-asked-what-built-them
  (is (seed/shim? "Elixir.BeamLisp.Ns.Anf.beam"))
  (is (not (seed/shim? "Elixir.BeamLisp.Ns.Body.Anf.beam")))
  (is (not (seed/shim? "Elixir.BeamLisp.Ns.Init.Anf.beam"))))

(deftest the-tier-decides-which-key-a-beam-must-carry
  ;; Two toolchain keys: the codegen and the driver. A seed beam's stamp is the
  ;; key of ITS tier, and the routing is the emitter's own (`key_for_ns/1`), so a
  ;; beam's stamp and this check cannot disagree about which tier it is in.
  (is (= "COMPILER" (seed/expected-key "anf" "COMPILER" "DRIVER")))
  (is (= "COMPILER" (seed/expected-key "reader-node" "COMPILER" "DRIVER")))
  (is (= "DRIVER" (seed/expected-key "build" "COMPILER" "DRIVER")))
  (is (= "DRIVER" (seed/expected-key "seed" "COMPILER" "DRIVER"))
      "the generator's own namespace is a driver namespace: it must never be floored"))

; ── the refusal, which is what makes the generator safe to run ────────────

(defn- scratch [name]
  (let [d (Path/join (System/tmp_dir) (str "bl-seed-test-" name))]
    (File/rm_rf! d)
    (File/mkdir_p! d)
    d))

(deftest a-floor-with-no-beams-is-refused-and-nothing-is-deleted
  (let [out (scratch "empty-ebin")
        keep (Path/join out "Elixir.BeamLisp.Ns.Anf.beam")
        _ (File/write! keep "the floor that must survive")
        r (seed/run {:root (BeamLisp/cwd) :out out
                     :ebin (Path/join (System/tmp_dir) "bl-seed-test-does-not-exist")})]
    (is (not (:ok? r)) "an ebin with no boot-closure beams cannot produce a floor")
    (is (> (count (:errors r)) 0))
    (is (File/exists? keep)
        "the refusal happens BEFORE the clear: a failed run must not destroy the floor it could not rebuild")))

(deftest a-foreign-beam-is-refused-and-nothing-is-deleted
  ;; The ebin holds a file with a beam's NAME and none of its meaning. Loading it
  ;; must fail the run rather than publish a manifest describing a floor that is
  ;; not there.
  (let [ebin (scratch "foreign-ebin")
        out (scratch "foreign-out")
        keep (Path/join out "the-previous-floor")
        _ (File/write! keep "keep me")
        _ (File/write! (Path/join ebin "Elixir.BeamLisp.Ns.Anf.beam") "not a beam")
        r (seed/run {:root (BeamLisp/cwd) :out out :ebin ebin})]
    (is (not (:ok? r)) "a file that cannot be loaded is not evidence of a build")
    (is (File/exists? keep))))

(deftest a-refused-run-says-what-to-do
  (let [r (seed/run {:root (BeamLisp/cwd)
                     :out (scratch "says-out")
                     :ebin (Path/join (System/tmp_dir) "bl-seed-test-absent")})]
    (is (includes? (join " " (:errors r)) "--ebin")
        "the error names the flag that fixes it, not just the directory that was empty")))

; ── the pinned HOST floor ─────────────────────────────────────────────────
;
; A host module is not a boot shim: it is COMPILED by `seed/run` from checked-in
; source, not copied from an ebin. So its inventory is different (it must appear
; in the manifest and on disk), and its drift signal is different (the floor
; beam carries `bl_source_hash`, the digest of the source it was built from).
; These pin both, per leaf, on a scratch host source so the tree's real leaves
; are untouched. The fixture DERIVES its filenames from `seed/host-sources`, so
; it cannot drift from the mapping it is testing.

(deftest the-pinned-host-sources-are-explicit
  ;; A table, not a sweep: each pinned leaf names the EXACT module its source
  ;; becomes. All thirteen are asserted, or a leaf could be added (or dropped)
  ;; while the floor still claimed the set it was built with. The struct-field
  ;; and behaviour mappings are pinned too, because they are the options that
  ;; decide what surface a pinned beam has: a struct module
  ;; (`Delay`/`Derived`/`Set`/`SeqCursor`), a behaviour module (`WebSocket`,
  ;; `-behaviour(WebSock)`), or functions-only (`Deferred`/`Reactive`, and the
  ;; two `Enumerable` impls).
  (let [hs (seed/host-sources "priv/host")]
    (is (= 13 (count hs)) "the substrate four, the Delay/Deferred, Derived/Reactive, Set/SetEnumerable and SeqCursor/SeqCursorEnumerable pairs, and the WebSocket behaviour module")
    (is (= ["Elixir.BeamLisp.CompilerData" "Elixir.BeamLisp.Deferred" "Elixir.BeamLisp.Delay" "Elixir.BeamLisp.Derived" "Elixir.BeamLisp.Emit" "Elixir.BeamLisp.Link" "Elixir.BeamLisp.Reactive" "Elixir.BeamLisp.SeqCursor" "Elixir.BeamLisp.Set" "Elixir.BeamLisp.Tiers" "Elixir.BeamLisp.WebSocket" "Elixir.Enumerable.BeamLisp.SeqCursor" "Elixir.Enumerable.BeamLisp.Set"]
           (sorted (map (fn [e] (str (:module e))) hs))))
    (is (= ["priv/host/compiler_data.bl" "priv/host/deferred.bl" "priv/host/delay.bl" "priv/host/derived.bl" "priv/host/emit.bl" "priv/host/link.bl" "priv/host/reactive.bl" "priv/host/seq_cursor.bl" "priv/host/seq_cursor_enumerable.bl" "priv/host/set.bl" "priv/host/set_enumerable.bl" "priv/host/tiers.bl" "priv/host/web_socket.bl"]
           (sorted (map (fn [e] (:source e)) hs))))
    (is (= ["Elixir.BeamLisp.CompilerData.beam" "Elixir.BeamLisp.Deferred.beam" "Elixir.BeamLisp.Delay.beam" "Elixir.BeamLisp.Derived.beam" "Elixir.BeamLisp.Emit.beam" "Elixir.BeamLisp.Link.beam" "Elixir.BeamLisp.Reactive.beam" "Elixir.BeamLisp.SeqCursor.beam" "Elixir.BeamLisp.Set.beam" "Elixir.BeamLisp.Tiers.beam" "Elixir.BeamLisp.WebSocket.beam" "Elixir.Enumerable.BeamLisp.SeqCursor.beam" "Elixir.Enumerable.BeamLisp.Set.beam"]
           (sorted (map (fn [e] (seed/host-beam e)) hs))))
    (let [by-mod (fn [m] (first (filter (fn [e] (= (str (:module e)) m)) hs)))]
      (is (= (list (tuple :seq nil)) (:struct-fields (by-mod "Elixir.BeamLisp.Delay")))
          "Delay carries the :seq struct field the pinned beam synthesizes")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Deferred")))
          "Deferred is functions-only: no :struct_fields opt")
      (is (= (list (tuple :cell nil) (tuple :deps nil) (tuple :thunk nil))
             (:struct-fields (by-mod "Elixir.BeamLisp.Derived")))
          "Derived carries the :cell/:deps/:thunk struct fields, in that order")
      (is (= (list (tuple :members nil)) (:struct-fields (by-mod "Elixir.BeamLisp.Set")))
          "Set carries the :members struct field")
      (is (= (list (tuple :chunk ()) (tuple :tail nil) (tuple :dirty false))
             (:struct-fields (by-mod "Elixir.BeamLisp.SeqCursor")))
          "SeqCursor carries the :chunk/:tail/:dirty struct fields, in that order, with :chunk defaulting to the RAW Erlang empty list")
      (is (= :"Elixir.WebSock" (:behaviour (by-mod "Elixir.BeamLisp.WebSocket")))
          "WebSocket carries the :behaviour opt so its pinned beam records -behaviour(WebSock)"))
    (is (= ["Elixir.BeamLisp.WebSocket"]
           (sorted (keep (fn [e] (if (some? (:behaviour e)) (str (:module e)) nil)) hs)))
        "WebSocket is the ONLY entry that records a behaviour; every other beam is behaviour-free")
    (doseq [m ["Elixir.BeamLisp.CompilerData" "Elixir.BeamLisp.Emit" "Elixir.BeamLisp.Link" "Elixir.BeamLisp.Tiers"
               "Elixir.BeamLisp.Reactive" "Elixir.Enumerable.BeamLisp.Set" "Elixir.Enumerable.BeamLisp.SeqCursor"]]
      (is (nil? (:struct-fields (first (filter (fn [e] (= (str (:module e)) m)) hs))))
          (str m " stays functions-only")))))

(deftest the-host-inventory-is-the-mapping-in-table-order
  ;; The manifest's `hosts` list is written from the mapping, so its order is the
  ;; TABLE's — reproducible, not a map's iteration order — because it is an
  ;; inventory a reader (and `Bootstrap`) compares against the mapping. A
  ;; consumer selecting host beams from it gets the same set on every read.
  (let [hs (seed/host-sources "priv/host")]
    (is (= (seed/host-names hs) (vec (map (fn [e] (seed/host-beam e)) hs)))
        "host-names is host-beam over the mapping, in table order")
    (is (= (count hs) (count (seed/host-names hs))))
    (is (= ["Elixir.BeamLisp.CompilerData.beam"
            "Elixir.BeamLisp.Emit.beam"
            "Elixir.BeamLisp.Link.beam"
            "Elixir.BeamLisp.Tiers.beam"
            "Elixir.BeamLisp.Delay.beam"
            "Elixir.BeamLisp.Deferred.beam"
            "Elixir.BeamLisp.Derived.beam"
            "Elixir.BeamLisp.Reactive.beam"
            "Elixir.BeamLisp.Set.beam"
            "Elixir.Enumerable.BeamLisp.Set.beam"
            "Elixir.BeamLisp.SeqCursor.beam"
            "Elixir.Enumerable.BeamLisp.SeqCursor.beam"
            "Elixir.BeamLisp.WebSocket.beam"]
           (seed/host-names hs))
        "the table order is explicit, not sorted")))

(defn- host-fixture [extra]
  (str "(ns seed.host.fixture)\n(defn seeded-probe [x] x)\n" extra))

(defn- host-scratch
  "A scratch host dir holding a fixture source for EVERY entry
   `seed/host-sources` names. The filenames come from the mapping itself, so
   this fixture can never test a shape the seed does not look for."
  [name extra]
  (let [d (Path/join (System/tmp_dir) (str "bl-seed-host-" name))]
    (File/rm_rf! d)
    (File/mkdir_p! d)
    (doseq [e (seed/host-sources d)]
      (File/write! (:source e) (host-fixture extra)))
    d))

(defn- restore-assertions!
  "Put the test library back into `core`.

   `seed/run` and `seed/check` LOAD every boot shim to ask its provenance, and
   loading `core` puts the compiled `BeamLisp.Ns.Core` back from `core.bl` —
   which does not carry `is-report/4` (the runner interns the test library into
   core's ENV, not into that beam). Every `is` after such a call would die
   `is-report/4 is undefined or private`. Re-evaluating the library into core is
   exactly what the runner does at file start, so the assertions keep working."
  []
  (let [priv (erlang/list_to_binary (erlang/apply :code :priv_dir (list :beam_lisp)))]
    (BeamLisp.Env/with_ns "core"
      (fn [] (BeamLisp/eval (File/read! (str priv "/std/test.bl")))))))

(defn- seed-run! [opts] (let [r (seed/run opts)] (restore-assertions!) r))
(defn- seed-check! [opts] (let [c (seed/check opts)] (restore-assertions!) c))

(deftest run-publishes-every-pinned-host-beam-and-check-judges-it
  (let [root (BeamLisp/cwd)
        ebin (Path/join root "build")
        out (scratch "host-out")
        hd (host-scratch "host-src" "")
        hosts (seed/host-sources hd)
        nss (map (fn [e] (str (:module e))) hosts)
        beams (map (fn [e] (seed/host-beam e)) hosts)]
    (let [r (seed-run! {:root root :out out :ebin ebin :host hd})]
      (is (:ok? r) (str "the floor is generated: " (pr-str (:errors r))))
      (doseq [b beams]
        (is (File/exists? (Path/join out b))
            (str b " is COMPILED into the floor, not copied from an ebin")))
      ; INVENTORY: the manifest must LIST every host beam, or
      ; `Bootstrap.install!/1` never copies it and the floor silently lacks the
      ; host leaf it carries.
      (let [manifest (erlang/element 1 (erlang/apply :Elixir.Code :eval_file
                                          (list (Path/join out "manifest.exs"))))]
        (doseq [b beams]
          (is (some? (get (get manifest "modules") b))
              (str b " is in the manifest's module map")))
        ; INVENTORY: the manifest must NAME its host beams as data — the
        ; host-sources mapping's filenames, in the table's own order — so a
        ; consumer selects host beams by the list, not by a name prefix. The
        ; list is what lets a pinned leaf outside `Elixir.BeamLisp.*` be staged.
        (is (erlang/is_list (get manifest "hosts"))
            "the manifest inventory is a plain Erlang list, not a BL Vector")
        (is (= (seed/host-names hosts) (get manifest "hosts"))
            (str "the manifest's `hosts` list is the mapping's filenames in table order, got "
                 (pr-str (get manifest "hosts"))))))
    (let [c (seed-check! {:root root :out out :host hd})]
      (is (:ok? c) (str "a floor generated from this source is current: " (pr-str (:moved c))))
      (doseq [n nss]
        (is (has? (:current c) n) (str n " is judged current"))))
    ; SOURCE DRIFT: one leaf's source moves while its beam stays in the floor.
    ; Checked per leaf, because the whole point of the table is that each pinned
    ; source is judged on its OWN digest, not on the set's.
    (doseq [e hosts]
      (File/write! (:source e) (host-fixture "(defn extra [x] x)\n"))
      (let [c (seed-check! {:root root :out out :host hd})]
        (is (not (:ok? c)) (str (:module e) " moved — the floor is STALE"))
        (is (has? (map (fn [r] (:ns r)) (:moved c)) (str (:module e))))))
    ; ABSENCE also blocks: there is no action-only host source.
    (doseq [e hosts]
      (File/rm! (Path/join out (seed/host-beam e)))
      (let [c (seed-check! {:root root :out out :host hd})]
        (is (not (:ok? c))
            (str "a floor missing " (seed/host-beam e) " is not current"))))
    (File/rm_rf! out)
    (File/rm_rf! hd)))
