; test/bl/document/xberg_test.bl — the boundary contract, as assertions.
;
; Run: bl test test/bl/document/xberg_test.bl
;
; Two halves, and the split is deliberate:
;
;   • WHAT THE BOUNDARY DECIDES — config validation, canonicalisation, the
;     egress classification, engine identity, reading the native response.
;     These run with NO NIF PRESENT, because they are Lisp policy, not engine
;     behaviour. A test that needed the 112 MB artifact to check that an
;     unknown config key is rejected would be a test nobody can run.
;
;   • WHAT THE ENGINE SAYS — capability introspection. Gated on `available?`,
;     so a machine without the carrier still gets a green suite and an explicit
;     "skipped" line instead of a red one that means nothing.

(ns document.xberg-test
  (:require [document.xberg :as xb]))

;; ── reading a native response ───────────────────────────────────────────────

(def FAKE-RAW
  {:results [{:content "مادة"
              :mime_type "text/plain"
              :extraction_method "ocr"
              :counts {:pages 1 :tables 0 :images 0}
              :extraction_confidence {:text_coverage 0.97 :ocr_aggregate 0.71 :combined 0.71}
              :quality_score 1.0
              :processing_warnings [{:source "engine" :message "low coverage on page 1"}]
              :metadata {:additional {"extraction_method" "\"ocr\""}}
              :chunks [{:content "ما" :chunk_type "unknown"
                        :metadata {:byte_start 0 :byte_end 4 :chunk_index 0 :page_spans [{:page 1 :bbox nil}]}}
                       {:content "دة" :chunk_type "unknown"
                        :metadata {:byte_start 4 :byte_end 8 :chunk_index 1 :page_spans [{:page 1 :bbox nil}]}}]}]
   :errors [{:index 1 :code 1001 :error_type "io" :source "missing.pdf" :message "IO error"}]
   :summary {:inputs 2 :results 1 :errors 1 :pages_crawled 0 :documents_downloaded 0}})

(deftest results-and-errors-are-two-channels
  (is (= 1 (count (xb/results FAKE-RAW))))
  (let [e (first (xb/call-errors FAKE-RAW))]
    (is (= 1001 (:code e)))
    (is (= "io" (:error-type e))))
  (is (= 2 (:inputs (xb/summary FAKE-RAW))))
  (is (= 1 (:errors (xb/summary FAKE-RAW))))
  ; an absent field is nil, never a crash — most results have no `errors`
  (is (= [] (xb/call-errors {:results []})))
  (is (= nil (:inputs (xb/summary {:results []})))))

(deftest field-reads-either-key-encoding
  (is (= 1 (xb/field {:a 1} :a)))
  (is (= 1 (xb/field {:a 1} "a")))
  (is (= :missing (xb/field {} :a :missing))))

(deftest enums-are-decoded-from-all-four-wire-shapes
  (is (= :rectangle (xb/enum-tag (tuple :rectangle {:left 1 :top 2}))))
  (is (= {:left 1 :top 2} (xb/enum-value (tuple :rectangle {:left 1 :top 2}))))
  (is (= :native (xb/enum-tag :native)))
  (is (= "organization" (xb/enum-tag {:format_type "organization" :custom nil}))))

(deftest metadata-additional-is-de-quoted
  (is (= "native" (xb/dequote "\"native\"")))
  (is (= "native" (xb/dequote "native")))
  (is (= "" (xb/dequote "")) "an empty string is not a quote pair")
  (is (= {"k" "native"} (xb/dequote-map {"k" "\"native\""}))))

;; ── config: validate, canonicalise, hash ────────────────────────────────────

(deftest unknown-config-keys-are-rejected-in-our-layer
  ; 1.0.14 ignores this key SILENTLY; after 1.1.0 it is a hard error. Rejecting
  ; it here is what makes the contract true at both pins.
  (let [r (xb/validate-config {:chunking {:max_chars 500}})]
    (is (= "chunking.max_chars" (get-in r [:error :path]))))
  (let [r (xb/validate-config {:nonsense true})]
    (is (= "nonsense" (get-in r [:error :path])))))

(deftest known-config-keys-and-types-pass
  (let [r (xb/validate-config (xb/profile-config))]
    (is (some? (get r :ok))))
  (is (some? (get (xb/validate-config {:chunking {:max_characters 500}}) :ok)))
  ; a bad enum is a bad enum even when the key exists
  (is (some? (get (xb/validate-config {:output_format "docx"}) :error)))
  ; and so is a wrong type
  (is (some? (get (xb/validate-config {:chunking {:max_characters "500"}}) :error)))
  (is (some? (get (xb/validate-config {:ocr {:language "ara"}}) :error))))

(deftest canonical-form-is-order-independent
  (is (= (xb/canonical {:b 1 :a 2}) (xb/canonical {:a 2 :b 1})))
  (is (not= (xb/canonical {:a 1}) (xb/canonical {:a 2})))
  (is (= (xb/config-hash {:a 1 :b [1 2]}) (xb/config-hash {:b [1 2] :a 1})))
  (is (not= (xb/config-hash {:a 1}) (xb/config-hash {:a 1 :ocr {:enabled true}}))))

(deftest egress-is-classified-not-guessed
  (is (= [] (xb/egress-paths (xb/profile-config))))
  (is (seq (xb/egress-paths {:ner {:backend "llm"}})))
  (is (seq (xb/egress-paths {:summarization {:x 1}})))
  (is (seq (xb/egress-paths {:ocr {:vlm_fallback "auto"}})))
  ; vlm is refused, tesseract is not
  (is (seq (xb/egress-paths {:ocr {:backend "vlm"}})))
  (is (= [] (xb/egress-paths {:ocr {:backend "tesseract"}}))))

(deftest the-pinned-ocr-profile-names-its-languages
  (let [p (xb/ocr-profile)]
    (is (= "tesseract" (:backend p)))
    (is (= ["ara" "fra" "eng"] (:language p)))
    (is (= {:mode "disabled"} (:vlm_fallback p)))))

(deftest engine-identity-is-pinned
  (let [e (xb/engine-id)]
    (is (= "1.0.14" (:xberg e)))
    (is (= "xberg_nif" (:crate e)))
    (is (string? (:arch e)))))

;; ── budgets: absence of a native is a value, not an exception ───────────────

(deftest availability-never-raises
  (let [a (xb/available?)]
    (is (or (= true a) (= false a)))))

(deftest stats-answer-without-a-native
  (let [s (xb/stats)]
    (is (number? (:inflight s)))
    (is (number? (:timeouts s)))
    (is (number? (:saturated s)))
    (is (number? (:native-not-stopped s)))))

(deftest a-budget-refusal-happens-before-the-engine
  ; measured in BYTES with no NIF in sight: the budget is enforced by us
  (let [r (xb/extract "0123456789" "x.txt" {:budget {:max-input-bytes 4}})]
    (is (some? (get-in r [:error :xberg])))
    (is (= :budget (get-in r [:error :xberg]))))
  ; a remote URI is refused, not fetched
  (let [r (xb/extract-path "https://example.invalid/x.pdf" {})]
    (is (= :egress (get-in r [:error :xberg])))))

(deftest egress-config-is-refused-without-authorisation
  (let [r (xb/extract "x" "x.txt" {:config {:summarization {:model "x"}}})]
    (is (= :egress (get-in r [:error :xberg])))))

(deftest unknown-config-is-refused-before-the-engine
  (let [r (xb/extract "x" "x.txt" {:config {:nope 1}})]
    (is (= :config (get-in r [:error :xberg])))))

;; ── the engine half, gated ──────────────────────────────────────────────────

(deftest capabilities-are-effective-not-a-registry-listing
  (if (xb/available?)
    (let [c (xb/capabilities {:refresh true})]
      (is (some? (get c :ok)))
      (let [caps (get c :ok)]
        (is (> (count (get caps :formats)) 100))
        (is (seq (get caps :renderers)))
        ; "registered" and "ready" are different facts, and the ready set is
        ; ours — probed, not copied from the engine's list.
        (is (seq (get caps :ocr))))
      ; the language answer comes from installed data, and a missing language
      ; is reported as missing rather than assumed present
      (let [l (xb/language-capability)]
        (is (= ["ara" "fra" "eng"] (get l :required)))
        (is (vector? (get l :missing)))))
    (do (println "  ⋯ engine absent — capability probe skipped (expected without the carrier)")
        (is (= :absent (get-in (xb/capabilities) [:error :xberg]))))))

;; ── the OS worker transport, with fixtures (no NIF, no carrier) ─────────────
;
; These drive the REAL spawn / kill / read / cap path with shell fixtures, so
; the transport is proven without the 112 MB artifact: a hard kill, an output
; cap that refuses before reading, a failed exit, an in-band refusal, and the
; in-flight lease on the timeout path. The real worker (Arabic HTML + OCR)
; rides the same protocol and is exercised by the app-side suite.

(def FIX (or (System/get_env "XBERG_TEST_FIXTURES") "test/fixtures/xberg"))

(defn- probe-input [] (str FIX "/probe.txt"))

(defn- tmp-output-count []
  (count (filter (fn [f] (String/starts_with? f "xberg-worker-"))
                 (to-list (File/ls! (System/tmp_dir!))))))

(deftest an-unconfigured-worker-is-a-named-refusal
  ; A caller that ASKS for isolation and gets none must hear why, never a
  ; silent in-process read. XBERG_RUNTIME is the one thing that decides it, so
  ; it is removed for the length of this check and restored after.
  (let [saved (System/get_env "XBERG_RUNTIME")]
    (try
      (System/delete_env "XBERG_RUNTIME")
      (is (= false (xb/worker-configured?)))
      (let [r (xb/extract-path (probe-input) {:isolation :os_worker})
            e (get r :error)]
        (is (= :worker (:xberg e)))
        (is (String/contains? (str (get e :message)) "XBERG_RUNTIME")))
      (finally (if (some? saved) (System/put_env "XBERG_RUNTIME" saved))))))

(deftest an-os-worker-that-never-answers-is-hard-killed
  (let [before (xb/stats)
        r (xb/extract-path (probe-input)
                           {:isolation :os_worker
                            :worker {:cmd (str FIX "/slow-worker.sh")}
                            :budget {:timeout-ms 1200}})
        e (get r :error)
        after (xb/stats)]
    (is (= :timeout (:xberg e)))
    (is (= true (:native-stopped? e)))
    (is (= :os_worker (:isolation e)))
    ; the permit is released on the TIMEOUT path too: a leak here is a reader
    ; that stops admitting work after N timeouts.
    (is (= (get before :inflight) (get after :inflight)))
    (is (> (get after :timeouts) (get before :timeouts)))
    ; the OS kill is not the in-process leak — that counter must not move
    (is (= (get before :native-not-stopped) (get after :native-not-stopped)))))

(deftest an-oversized-response-is-refused-on-size-and-not-leaked
  (let [before (tmp-output-count)
        r (xb/extract-path (probe-input)
                           {:isolation :os_worker
                            :worker {:cmd (str FIX "/oversized-worker.sh")}
                            :budget {:max-output-bytes 256}})
        e (get r :error)]
    (is (some? e))
    (is (String/contains? (str (get e :message)) "output budget"))
    ; the response temp file is removed on the refusal path as well
    (is (= before (tmp-output-count)))))

(deftest an-enormous-request-is-refused-before-the-worker-runs
  (let [big (join "" (repeat 4000 "x"))
        r (xb/extract-path (probe-input)
                           {:isolation :os_worker
                            :worker {:cmd (str FIX "/ok-worker.sh")}
                            :config {:cache_namespace big}
                            :budget {:max-request-bytes 512}})
        e (get r :error)]
    (is (= :budget (:xberg e)))
    (is (String/contains? (str (get e :message)) "request budget"))))

(deftest a-worker-that-dies-names-its-exit
  (let [r (xb/extract-path (probe-input)
                           {:isolation :os_worker
                            :worker {:cmd (str FIX "/fail-worker.sh")}
                            :budget {:timeout-ms 5000}})
        e (get r :error)]
    (is (= :worker (:xberg e)))
    (is (String/contains? (str (get e :message)) "exited 7"))))

(deftest a-worker-refusal-surfaces-the-workers-own-kind
  (let [r (xb/extract-path (probe-input)
                           {:isolation :os_worker
                            :worker {:cmd (str FIX "/refuse-worker.sh")}
                            :budget {:timeout-ms 5000}})
        e (get r :error)]
    (is (= "runtime" (get e :xberg)))
    (is (String/contains? (str (get e :message)) "no runtime"))))

(deftest an-envelope-answer-decodes-to-the-raw-shape
  ; the `{:raw :engine}` envelope the shipped worker sends, and the BARE raw a
  ; canned fixture sends, meet at the same `:raw`: the transport adds isolation,
  ; never a second document shape.
  (let [r (xb/extract-path (probe-input)
                           {:isolation :os_worker
                            :worker {:cmd (str FIX "/ok-worker.sh")}
                            :budget {:timeout-ms 5000}})
        ok (get r :ok)]
    (is (some? ok))
    (is (= :json (get ok :transport)))
    (is (= :os_worker (get ok :isolation)))
    ; the engine identity is the WORKER's — the parent VM has no NIF loaded
    (is (= "sha256:fixture" (get-in ok [:engine :nif])))
    (is (= 1 (get (xb/summary (get ok :raw)) :results)))
    (is (= "مادة" (xb/field (first (to-list (xb/results (get ok :raw)))) :content)))))


;; ── the native review's findings, as regressions ────────────────────────────

(defn- tmp-dir [nm]
  (let [d (str (System/tmp_dir!) "/xberg-test-" nm "-"
               (erlang/apply :erlang :unique_integer (list (list :positive))))]
    (File/mkdir_p! d)
    d))

(deftest remote-ocr-pipeline-stages-are-classified-before-any-call
  ; An EXPLICIT pipeline OVERRIDES `vlm_fallback` (the engine documents it), so
  ; a remote stage there is invisible to the top-level checks. Both wire shapes
  ; are classified, and `extract` refuses without admitting anything.
  (is (seq (xb/egress-paths {:ocr {:pipeline [{:backend "vlm" :vlm_config {:model "openai/gpt-4o-mini"}}]}})))
  (is (seq (xb/egress-paths {:ocr {:pipeline {:stages [{:backend "vlm"}]}}})))
  (is (seq (xb/egress-paths {:ocr {:pipeline {:stages [{:backend "tesseract" :vlm_config {:model "x"}}]}}})))
  (is (= [] (xb/egress-paths {:ocr {:pipeline {:stages [{:backend "tesseract" :language ["ara"]}]}}})))
  (let [before (xb/stats)
        r (xb/extract "x" "x.txt" {:config {:ocr {:pipeline [{:backend "vlm" :vlm_config {:model "m"}}]}}})
        after (xb/stats)]
    (is (= :egress (get-in r [:error :xberg])))
    (is (seq (get-in r [:error :paths])))
    ; nothing was admitted, so no worker and no native call happened
    (is (= (get before :inflight) (get after :inflight)))))

(deftest pipeline-schema-fails-closed-on-unknown-nested-keys
  (is (some? (get-in (xb/validate-config {:ocr {:pipeline {:stages [{:backend "tesseract" :bogus 1}]}}}) [:error])))
  (is (some? (get-in (xb/validate-config {:ocr {:pipeline {:bogus true}}}) [:error])))
  (is (some? (get-in (xb/validate-config {:ocr {:pipeline 7}}) [:error])))
  (is (some? (get-in (xb/validate-config {:security_limits {:max_archive_size 1 :bogus 2}}) [:error])))
  ; a well-formed LOCAL pipeline is accepted in either shape
  (is (some? (get (xb/validate-config {:ocr {:pipeline {:stages [{:backend "tesseract" :language ["ara"]}]}}}) :ok)))
  (is (some? (get (xb/validate-config {:ocr {:pipeline [{:backend "tesseract"}]}}) :ok)))
  (is (some? (get-in (xb/validate-config {:ocr {:pipeline {:stages [{:backend "tesseract" :priority "x"}]}}}) [:error]))))

(deftest configured-tessdata-decides-language-readiness
  ; Readiness must follow the directory the ENGINE is pointed at. `zzz` is
  ; deliberately absent from the host, so a host-only probe and the configured
  ; directory give deliberately different answers.
  (let [d (tmp-dir "tessdata")]
    (try
      (File/write! (Path/join (list d "zzz.traineddata")) "")
      (is (= [] (xb/missing-languages ["zzz"] "tesseract" d)))
      (is (some (fn [l] (= "zzz" l)) (xb/missing-languages ["zzz"] "tesseract" nil)))
      (is (some (fn [l] (= "zzz" l)) (get (xb/tesseract-languages d) :ok)))
      ; capability follows the config
      (let [lc (xb/language-capability ["zzz"] {:config {:ocr {:backend "tesseract" :tessdata_path d}}})]
        (is (= [] (:missing lc)))
        (is (= ["zzz"] (:ready lc))))
      ; a capability probe keyed to this config's tessdata: the engine half is
      ; gated, as everywhere else in this suite
      (when (xb/available?)
        (let [c (xb/capabilities {:refresh true :config {:ocr {:tessdata_path d}}})]
          (is (some? (get c :ok)))))
      ; and extraction is not refused for a language the configured pack has.
      ; The native itself is stubbed so this makes no provider/native attempt —
      ; the readiness decision is what is under test.
      (let [r (xb/extract "x" "x.txt" {:config {:ocr {:backend "tesseract" :tessdata_path d}}
                                       :require-languages ["zzz"]
                                       :in-process-fn (fn [_i _c] {:ok {:results []}})})]
        (is (not= :capability (get-in r [:error :xberg]))))
      (finally
        (try (File/rm! (Path/join (list d "zzz.traineddata"))) (catch _ :ok))
        (try (File/rmdir! d) (catch _ :ok))))))

(deftest canonical-form-cannot-alias-a-sibling-path
  ; An unescaped newline in a value used to make two configs hash equal, so a
  ; config change never moved the artifact id.
  (is (not= (xb/canonical {:cache_namespace "a\npages.extract_pages=true"})
            (xb/canonical {:cache_namespace "a" :pages {:extract_pages true}})))
  (is (not= (xb/config-hash {:cache_namespace "a\npages.extract_pages=true"})
            (xb/config-hash {:cache_namespace "a" :pages {:extract_pages true}})))
  ; a dotted key name is not a nested path
  (is (not= (xb/config-hash {"a.b" 1}) (xb/config-hash {:a {:b 1}})))
  ; and the property the canonical form exists for still holds
  (is (= (xb/config-hash {:a 1 :b [1 2]}) (xb/config-hash {:b [1 2] :a 1}))))

(deftest duplicate-inputs-get-distinct-temp-paths-and-both-succeed
  ; Identical bytes are a normal batch case. The barrier worker records the
  ; request file it was handed and the input that request names, waits for its
  ; peer, then proves its own input still exists. Distinct paths are the fix;
  ; both calls succeeding is the contract; independent cleanup leaves the other
  ; call's files alone.
  (let [tag (str (erlang/apply :erlang :unique_integer (list (list :positive))))
        log (str (System/tmp_dir!) "/xberg-dup-" tag ".log")
        ilog (str log ".input")
        b "duplicate input bytes"]
    (try
      (let [r (xb/extract-batch [{:bytes b :filename "d.txt"} {:bytes b :filename "d.txt"}]
                                {:isolation :os_worker
                                 :worker {:cmd (str FIX "/dup-worker.sh") :args [log]}
                                 :budget {:timeout-ms 8000}})
            items (get r :ok)]
        (is (= 2 (count items)))
        (is (every? (fn [it] (= true (get it :ok))) items))
        (let [reqs (to-list (String/split (String/trim (File/read! log)) "\n"))
              ins (to-list (String/split (String/trim (File/read! ilog)) "\n"))]
          (is (= 2 (count reqs)))
          (is (not= (first reqs) (second reqs)))
          (is (= 2 (count ins)))
          (is (not= (first ins) (second ins)))))
      (finally
        (try (File/rm! log) (catch _ :ok))
        (try (File/rm! ilog) (catch _ :ok))))))

(deftest in-process-timeout-holds-its-permit-until-the-native-returns
  ; `extract_async` is a DirtyCpu NIF with no cancellation, so a BEAM-side
  ; timeout stops WAITING, not the native: the permit (and the input) must be
  ; held until the native ACTUALLY returns, or `max-concurrent` bounds nothing.
  ; The call is stubbed through the documented `:in-process-fn` seam, so this
  ; runs without the carrier.
  ;
  ; Control: the SAME budget over the OS worker DOES release, because that path
  ; proves the stop (`an-os-worker-that-never-answers-is-hard-killed`).
  (let [gate (str (System/tmp_dir!) "/xberg-gate-"
                  (str (erlang/apply :erlang :unique_integer (list (list :positive)))))
        slow (fn [_i _c]
               (loop [n 0]
                 (if (or (File/exists? gate) (> n 1200))
                   {:ok {:results []}}
                   (do (erlang/apply :timer :sleep (list 10)) (recur (+ n 1))))))
        before (get (xb/stats) :inflight)
        r1 (xb/extract "x" "x.txt" {:isolation :in_process :in-process-fn slow
                                    :budget {:timeout-ms 80 :max-concurrent 1}})
        held (get (xb/stats) :inflight)
        r2 (xb/extract "y" "y.txt" {:isolation :in_process :in-process-fn slow
                                    :budget {:timeout-ms 80 :max-concurrent 1}})]
    (is (= :timeout (get-in r1 [:error :xberg])))
    (is (= false (get-in r1 [:error :native-stopped?])))
    ; the native is STILL RUNNING, so the one permit is still held...
    (is (> held before))
    ; ...and a second call cannot be admitted on top of it
    (is (= :saturated (get-in r2 [:error :xberg])))
    (File/write! gate "go")
    (loop [n 0]
      (when (and (> (get (xb/stats) :inflight) before) (< n 600))
        (erlang/apply :timer :sleep (list 25))
        (recur (+ n 1))))
    ; the native returned; the permit and the dead call's input came back
    (is (= before (get (xb/stats) :inflight)))
    (try (File/rm! gate) (catch _ :ok))))

(deftest a-required-hard-bound-refuses-without-a-worker
  ; A caller that REQUIRES a hard bound must get one, never a silent downgrade
  ; to an in-process timeout that cannot stop the native.
  (let [saved (System/get_env "XBERG_RUNTIME")]
    (try
      (System/delete_env "XBERG_RUNTIME")
      (let [r (xb/extract "x" "x.txt" {:hard-bound? true})]
        (is (= :worker (get-in r [:error :xberg])))
        (is (= false (get-in r [:error :native-stopped?]))))
      (let [r2 (xb/extract "x" "x.txt" {:hard-bound? true :isolation :in_process})]
        (is (= :worker (get-in r2 [:error :xberg]))))
      (finally (if (some? saved) (System/put_env "XBERG_RUNTIME" saved))))))

(deftest the-worker-child-never-spawns-a-nested-worker
  ; Inside the OS worker the boundary must stay in-process: `:os_worker` there
  ; would spawn a nested copy of the worker, recursively.
  (System/put_env "XBERG_WORKER_CHILD" "1")
  (try
    (let [r (xb/extract "x" "x.txt" {:isolation :os_worker
                                     :worker {:cmd "/bin/true"}})]
      (is (= :worker (get-in r [:error :xberg])))
      (is (String/contains? (str (get-in r [:error :message])) "nested")))
    (finally (System/delete_env "XBERG_WORKER_CHILD"))))
