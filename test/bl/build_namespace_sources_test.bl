(ns build.namespace-sources-test (:require [build :as build]))

(deftest unit-initialization-remains-serialized-with-multiple-workers
  (let [root (str (System/tmp_dir!) "/build-publication-" (System/unique_integer (list :positive)))
        trace (str root "/trace")
        a (str root "/a.bl") b (str root "/b.bl")
        source (fn [unit]
                 (str "(ns build.serial." unit ")\n"
                      "(File/write! " (pr-str trace) " " (pr-str (str unit ":start\n")) " (list :append))\n"
                      "(Process/sleep 25)\n"
                      "(File/write! " (pr-str trace) " " (pr-str (str unit ":end\n")) " (list :append))\n"))]
    (File/mkdir_p! root)
    (try
      (File/write! a (source "a")) (File/write! b (source "b"))
      (let [result (build/run {:sources [a b] :root root :out (str root "/ebin") :scope :scoped :jobs 2})
            lines (vec (String/split (String/trim (File/read! trace)) "\n"))]
        (is (= [] (:errors result)))
        (is (= 2 (:compiled result)))
        (is (or (= ["a:start" "a:end" "b:start" "b:end"] lines)
                (= ["b:start" "b:end" "a:start" "a:end"] lines))))
      (finally (File/rm_rf! root)))))

(deftest namespace-inventory-keeps-named-units-and-leaves-fragments-to-their-caller
  (let [root (str (System/tmp_dir!) "/namespace-sources-" (System/unique_integer (list :positive)))
        leaf (str root "/std/leaf.bl")
        literate (str root "/lib/literate.bl.md")
        fragment (str root "/std/assertions.bl")
        runtime (str root "/lib/injected-runtime.bl")
        prose (str root "/lib/guide.bl.md")
        marker (str root "/must-not-run")]
    (File/mkdir_p! (str root "/std"))
    (File/mkdir_p! (str root "/lib"))
    (try
      (File/write! leaf (str "(ns leaf)\n(File/write! " (pr-str marker) " \"bad\")"))
      (File/write! literate "# A library\n\n```beam-lisp\n(ns literate)\n(defn value [] 42)\n```\n")
      (File/write! fragment "(defmacro check [x] x)")
      (File/write! runtime "(defn injected [x] x)")
      (File/write! prose "# A guide\nThis document has no namespace.\n")
      (let [sources (set (build/namespace-sources root))]
        (is (= #{leaf literate} sources))
        (is (not (contains? sources fragment)))
        (is (not (contains? sources runtime)))
        (is (not (contains? sources prose)))
        (is (not (File/exists? marker)) "selecting an inventory never evaluates source"))
      (finally (File/rm_rf! root)))))

(deftest packaged-index-uses-portable-identities-and-exact-byte-digests
  (let [root (str (System/tmp_dir!) "/precompiled-index-" (System/unique_integer (list :positive)))
        ebin (str root "/ebin")
        destination (str root "/precompiled.term")
        module :Elixir.BeamLisp.Ns.PackagedIndexFixture
        bytes "compiled-unit-bytes"
        key (erlang/list_to_tuple (list "compiler" "source-closure"))]
    (File/mkdir_p! ebin)
    (try
      (File/write! (str ebin "/" (Atom/to_string module) ".beam") bytes)
      (is (= 1 (build/write-precompiled-index!
                 {"fixture.bl" {:key "compiler" :hash "source-closure" :modules [module]}}
                 ebin destination)))
      (let [index (erlang/binary_to_term (File/read! destination) (list :safe))
            unit (get (:entries index) key)]
        (is (= 1 (:version index)))
        (is (= (list (Atom/to_string module)) (:modules unit)))
        (is (= (crypto/hash :sha256 bytes) (get (:digests unit) (Atom/to_string module))))
        (is (= [] (vec (Path/wildcard (str destination ".writing-*"))))))
      (finally (File/rm_rf! root)))))
