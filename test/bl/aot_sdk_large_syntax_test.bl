(ns aot-sdk-large-syntax-test)

(deftest authenticated-sdk-letfn-syntax-has-its-own-finite-data-budget
 ;; A real SDK provider with a large letfn, loaded through the ordinary
 ;; source/image path. No synthetic compiler receipt or context flag is used.
 (BeamLisp.Loader/ensure_loaded "eval.closed")
 (let [check (BeamLisp.Env/fetch_exact! "eval.closed" "check")]
  (is (= :ready (:status (check "(+ 1 2)"))))
  (is (= :refused (:status (check "(File/read! \"synthetic-unused\")"))))))
