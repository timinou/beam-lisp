; Boot callers still depend on optional libraries: readiness belongs to callee
; identity, not the caller's tier. Native kernel validation uses host services.
(ns boot-namespace-readiness-test)
(defn- anf [ns source]
 (BeamLisp.Compiler/compile (first (BeamLisp.Reader/read_string source))
   (BeamLisp.Compiler/new_env ns)))
(defn- guards [tree]
 (cond
  (map? tree)
   (if (= :lit (:op tree)) []
    (into (if (and (= :remote (:op tree)) (= :Elixir.BeamLisp.Loader (:mod tree))
                   (= :ensure_ready (:fun tree))) [(:val (first (:args tree)))] [])
      (mapcat guards (vals (dissoc tree :ann)))))
  (erlang/is_list tree) (vec (mapcat guards tree))
  (tuple? tree) (guards (erlang/tuple_to_list tree))
  :else []))
(defn- fixture [action]
 (let [id (str "bootcallee" (erlang/unique_integer (list :positive)))
       dir (str (System/get_env "HOME") "/tmp/" id) token (BeamLisp.Env/capture)]
  (File/mkdir_p! dir)
  (try (BeamLisp.Loader/with_ambient_dirs (list dir) #(action dir id))
   (finally (BeamLisp.Env/bind token) (File/rm_rf! dir)))))

(deftest boot-callers-guard-direct-ordinary-library-callees-without-guarding-boot-or-local-calls
 (fixture
  (fn [dir provider]
   (File/write! (str dir "/" provider ".bl") (str "(ns " provider ") (defn value [] 42)"))
   (BeamLisp.Loader/ensure_loaded provider)
   ;; Force the linked direct-call arm, which previously skipped the guard
   ;; solely because its caller's compile namespace was core/compiler/reader.
   (doseq [caller ["core" "compiler" "reader"]]
    (is (= [provider] (guards (anf caller (str "(" provider "/value)"))))))
   (is (= [] (guards (anf provider (str "(" provider "/value)")))))
   (is (= [] (guards (anf "core" "(core/first (list 42))"))))
   (is (= 42 (BeamLisp/eval (str "(" provider "/value)")))))))

(deftest executable-anf-dependencies-include-boot-caller-readiness-and-exclude-quoted-lookalikes
 (fixture
  (fn [dir provider]
   (File/write! (str dir "/" provider ".bl") (str "(ns " provider ") (defn value [] 42)"))
   (BeamLisp.Loader/ensure_loaded provider)
   (let [node (anf "core" (str "(" provider "/value)"))
         operations (BeamLisp.AOT/implicit_require_ops "core" {} (list node) (list))]
    (is (= 1 (count operations)))
    (is (= provider (:val (first (:args (first operations))))))
    (is (= :declare_require (:fun (first operations))))
    (is (= (list) (BeamLisp.AOT/implicit_require_ops "core" {}
                   (list {:op :lit :val node}) (list))))))))

(deftest reader-expanded-regex-literals-preserve-ordinary-and-staged-aot-behavior
 (fixture
  (fn [dir id]
   (let [pattern (BeamLisp/eval "#\"a+(b)?\"")
         ordinary (str id "ordinary") staged (str id "staged")
         source (fn [ns] (str "(ns " ns ") (defn pattern [] #\"a+(b)?\")"))]
    (is (= "a+(b)?" (:source pattern)))
    (is (= ["aaab" "b"] (vec (Regex/run pattern "aaab"))))
    (BeamLisp/eval (source ordinary))
    (is (= "a+(b)?" (:source (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! ordinary "pattern") (list)))))
    (let [beams (BeamLisp.AOT/compile_source (source staged)
                 (list (tuple :output_dir (str dir "/ebin")) (tuple :stage-sdk? true)))
          module (BeamLisp.Link/module_for staged)]
     (is (seq beams))
     (erlang/apply module :__bl_init__ (list))
     (let [compiled (erlang/apply module :pattern (list))]
      (is (= "a+(b)?" (:source compiled)))
      (is (= ["aaab" "b"] (vec (Regex/run compiled "aaab"))))))))))

(deftest native-kernel-signature-grammar-has-no-optional-regex-provider-import
 (doseq [module [:Elixir.BeamLisp.AOT :Elixir.BeamLisp.Loader]]
  (let [result (beam_lib/chunks (code/which module) (list :imports))
        imports (Keyword/get (elem (elem result 1) 1) :imports)]
   (is (= :ok (elem result 0)))
   (is (not-any? #(= :Elixir.BeamLisp.Ns.Clojure.Re (elem % 0)) imports))))
 (is (= (tuple "crate_name" (list (tuple "good-name!?" 2)))
       (BeamLisp.AOT/stage-native (first (BeamLisp.Reader/read_string
         "(defnative \"crate_name\" (good-name!? 2))")))))
 (doseq [source ["(defnative \"Invalid-crate\" (okay 1))"
                 "(defnative \"crate\" (Wrong 1))"
                 "(defnative \"crate\" (okay 256))"
                 "(defnative \"crate\" (same 1) (same 1))"]]
  (is (= :unsupported-sdk-stage-native
        (try (BeamLisp.AOT/stage-native (first (BeamLisp.Reader/read_string source))) nil
             (catch error (:kind (ex-data error))))))))
