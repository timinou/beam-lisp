; test/bl/reader_raw_string_test.bl
;
;   ./bl test test/bl/reader_raw_string_test.bl
;
; RAW STRINGS: `#|…|` and `#tag|…|`. This pins the construct so that the reason
; it exists cannot be lost, and so that the two things it is easy to get wrong
; are checked rather than assumed.
;
; WHY IT EXISTS. beam-lisp had exactly one string literal — `"…"` with `\"`/`\\`
; escapes — so text that must contain a quote (CSS, JS, SQL, prose, another
; language) paid an escape at every occurrence, and an escaped quote is what a
; tool that re-escapes its input mangles TWICE. A raw body is verbatim: no
; escapes at all, newlines and indentation preserved byte-for-byte.
;
; THE TWO INVARIANTS THAT MATTER.
;   1. The opener's pipe count is the closer's, EXACTLY: `#|` ends at the first
;      `|`, `#||` at the first `||` — and a run of a DIFFERENT length is body
;      text, not a closer. That is what lets a body carry the delimiter it did
;      not spend: `#||a|b||` is `a|b`.
;   2. Nothing else changes. `#a|b` with `a` UNREGISTERED still reads as the
;      single symbol `#a|b`: the tagged form is opt-in by registration, so no
;      source that reads today reads differently.
;
; HOW. Every case builds its source as a STRING and reads it at runtime. That is
; not only compact — it is the only way to test a data-reader tag at all: a
; reader registration must precede the READ of the unit that uses it, so a
; `#tag|…|` literal written literally below would be read before the
; `(data-reader! …)` on the line above it ever ran.

(ns reader_raw_string_test
  (:require [lsp] [repair]))

(def q  "\"")   ; "
(def bs "\\")   ; \
(def nl "\n")
(def pp "|")    ; the pipe

(defn- read-forms
  "Every form `src` reads to, bare (positions stripped)."
  [src]
  (BeamLisp.Reader/read_all src))

(defn- read-1
  "The single form `src` reads to, bare."
  [src]
  (first (read-forms src)))

(defn- read-failure
  "The reader diagnostic `src` raises, or nil when it reads.

   Through `reader/read` with `:diagnostics :collect`, not the host facade: the
   facade turns a diagnostic into `BeamLisp.Reader.SyntaxError` (a RENDERING at
   the boundary), which would leave the test inspecting a message instead of the
   structured `:kind`/`:closer` a repair pass dispatches on."
  [src]
  (get (reader/read src {:file "raw_string_test.bl" :diagnostics :collect}) :error))

(defn- node-tag [n] (erlang/element 1 n))
(defn- node-items [n] (erlang/element 2 n))

; ── 1. the bare form ─────────────────────────────────────────────────────────

(deftest a-raw-string-reads-verbatim
  (is (= "hello" (read-1 (str "#" pp "hello" pp)))
      "the simplest case: pipes around text"))

(deftest quotes-and-backslashes-need-no-escape
  ; the whole point: `"` and `\` are ordinary characters in a raw body
  (let [src (str "#" pp "a" q "b" bs "c" pp)]
    (is (= (str "a" q "b" bs "c") (read-1 src))
        "a quote and a backslash inside a raw body are content, not syntax")))

(deftest nothing-is-interpreted-not-even-an-escape-looking-sequence
  (let [src (str "#" pp "a" bs "nb" pp)
        value (read-1 src)]
    (is (= 4 (count value)) "backslash-n is TWO characters inside a raw body")
    (is (= (str "a" bs "n" "b") value)
        "no escape is interpreted — a raw string is not a string with more delimiters")))

(deftest newlines-and-indentation-survive-byte-for-byte
  (let [src (str "#" pp "first" nl "  two spaces" nl "\ttab" nl "last" pp)
        value (read-1 src)]
    (is (= (str "first" nl "  two spaces" nl "\ttab" nl "last") value)
        "a multiline body is verbatim: no dedent, no trim, no normalization")
    (is (= 3 (- (count (String/split value nl)) 1)) "three newlines survive")))

(deftest multibyte-content-survives
  (let [value (read-1 (str "#" pp "é—" pp))]
    (is (= "é—" value) "two codepoints, five UTF-8 bytes, one string")))

; ── 2. the closer rule: a count-matched run, and only that run ───────────────

(deftest a-single-pipe-closes-a-single-pipe-opener
  (let [forms (read-forms (str "#" pp "a" pp "b"))]
    (is (= "a" (first forms)) "the body ends at the first pipe")
    (is (= 2 (count forms)) "and `b` is the NEXT form, not part of the string")))

(deftest two-pipes-let-the-body-carry-one
  (is (= (str "a" pp "b") (read-1 (str "#" pp pp "a" pp "b" pp pp)))
      "`#||` closes at `||`, so a lone `|` inside is content"))

(deftest a-longer-run-is-content-not-a-closer
  (is (= (str "a" pp pp pp "b") (read-1 (str "#" pp pp "a" pp pp pp "b" pp pp)))
      "a run of THREE pipes does not close a two-pipe opener"))

(deftest three-pipes-carry-two
  (is (= (str "a" pp pp "b") (read-1 (str "#" pp pp pp "a" pp pp "b" pp pp pp)))
      "`#|||` closes at `|||`, so `||` inside is content"))

(deftest a-raw-string-sits-anywhere-a-form-does
  (let [v (read-1 (str "[" "#" pp "x" pp " 2]"))]
    (is (= :vector (node-tag v)))
    (is (= "x" (first (node-items v))) "inside a collection")
    (is (= 2 (second (node-items v))) "and the collection keeps reading after it")))

(deftest the-next-form-knows-where-it-is
  ; positions must thread through the raw body, newlines included
  (let [forms (BeamLisp.Reader/read_string (str "#" pp "a" pp " (inc 1)") "raw_string_test.bl")
        _ (is (= "a" (first forms)) "the raw string is the first form")
        second-form (second forms)
        pos (erlang/element 3 second-form)]
    (is (= 1 (get pos :line)) "the list after the literal is still on line 1")
    (is (= 6 (get pos :col)) "and its column counts the pipes it follows")))

; ── 3. the tagged form: opt-in by registration ───────────────────────────────

(defn- shout [s] (str s "!"))
(data-reader! "shout" (quote shout))

(deftest a-registered-tag-takes-a-raw-payload
  (let [form (read-1 (str "#shout" pp "hi" pp))]
    (is (= :list (node-tag form)) "a tagged literal reads as a call")
    (is (= "shout" (erlang/element 2 (first (node-items form)))) "to the registered reader fn")
    (is (= "hi" (second (node-items form))) "with the raw body as its only argument")))

(deftest a-tagged-body-may-carry-quotes
  (let [form (read-1 (str "#shout" pp "say " q "hi" q pp))]
    (is (= (str "say " q "hi" q) (second (node-items form)))
        "this is the case the feature exists for: markup with attributes")))

(deftest a-tagged-raw-payload-matches-its-own-pipe-count
  (let [form (read-1 (str "#shout" pp pp "a" pp "b" pp pp))]
    (is (= (str "a" pp "b") (second (node-items form)))
        "`#tag||…||` follows the same rule as the bare form")))

(deftest an-unregistered-tag-is-unchanged
  ; the compat invariant: a pipe in the tag position of an unknown tag still
  ; reads as ONE symbol, exactly as before this feature existed
  (let [form (read-1 (str "#nope" pp "b"))]
    (is (= :symbol (node-tag form)) "still a bare hash-symbol")
    (is (= (str "#nope" pp "b") (node-items form)) "with the pipe inside its name")))

(deftest a-registered-tag-still-refuses-whitespace
  (let [d (read-failure (str "#shout " pp "x" pp))]
    (is (some? d) "a space between tag and payload is still a read error")
    (is (String/contains? (get d :msg) "expects a collection or a string")
        "and it is still the same message")))

; ── 4. failure: an unclosed raw body is a diagnostic, not a surprise ─────────

(deftest an-unterminated-raw-string-names-the-closer-it-wanted
  (let [d (read-failure (str "#" pp pp pp "x" pp pp))]
    (is (= :unterminated-raw-string (get d :kind)) "its own kind, not a plain syntax error")
    (is (= (str pp pp pp) (get d :closer)) "the closer is the opener's pipe count")
    (is (= 1 (get d :line)) "and the carets sits on the opener")))

(deftest a-raw-opener-at-end-of-file-is-unterminated
  (let [d (read-failure (str "#" pp))]
    (is (= :unterminated-raw-string (get d :kind)))
    (is (= pp (get d :closer)) "a one-pipe opener wants a one-pipe closer")))

; ── 6. the analysis passes behind `bl lsp check` ────────────────────────────

(deftest a-raw-string-with-treacherous-content-analyzes-clean
  ; Every checker (`bl lsp check`) reads the source through the reader. A body
  ; holding a quote, an unbalanced paren and a semicolon must arrive as ONE
  ; string — if any pass saw the raw text as code, this would report.
  (let [src (str "(ns t)" nl
                 "(def body #|(a " q " b; ) [unbalanced" pp ")" nl
                 "(defn size [] (count body))" nl)
        ds (lsp/diagnostics src "raw-check")]
    (is (empty? ds) (str "no diagnostics, got: " (pr-str ds)))))

(deftest a-tagged-raw-body-reaches-its-reader-fn-in-the-analysis
  ; the tagged form is a CALL to the registered fn, so the analysis sees a call
  ; with a string argument — nothing about it is special to the checker
  (let [src (str "(ns t)" nl "(def body #shout|hi|)" nl)
        ds (lsp/diagnostics src "raw-check-tagged")]
    (is (empty? ds) (str "no diagnostics, got: " (pr-str ds)))))

; ── 5. the failure is repairable ─────────────────────────────────────────────

(deftest an-unterminated-raw-string-can-be-closed
  ; `#||a|` is one pipe short. The repair must insert the OPENER's pipe run and
  ; not a single pipe: one pipe would close the body early and leave a stray
  ; pipe behind — a different program that also reads.
  (let [src (str "#" pp pp "a" pp nl)
        d (read-failure src)
        fixed (map (fn [c] (repair/apply-fix src c)) (repair/candidates d src))]
    (is (= :unterminated-raw-string (get d :kind)) "the failure is the raw-string one")
    (is (some (fn [s] (nil? (read-failure s))) fixed)
        "at least one candidate closes the body so that the source reads")))
