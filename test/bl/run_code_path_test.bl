; run_code_path_test.bl — `bl --code-path DIR` / `BEAM_LISP_CODE_PATH` must put
; a directory of AOT beams where the loader's AOT-first branch can see it.
;
; Ported from the ExUnit `test/beam_lisp/run_code_path_test.exs`. That suite
; built through the test-only Elixir wrapper `BeamLisp.BuildTask` and drove the
; CLI through `BeamLisp.Ns.Rt.invoke`; here the build goes straight to
; `priv/build/build.bl` (`build/clean` + `build/run`), and the CLI seam is the
; live `bl.cli/parse-argv` + `bl.util/register-paths` pair that `bl run` itself
; calls — no interop layer in the path.
;
; `ERL_AFLAGS="-pa DIR"` does NOT work: Mix prunes the code path after loading
; the project, so the beams vanish and every namespace compiles from source —
; an application's 30s load with a "working" AOT build. This locks in the flag
; and the env var (parsed by `bl.cli/parse-argv`, applied by
; `bl.util/register-paths`), and that the pruned `-pa` is indeed gone (so nobody
; reinstates it as the documented way).
;
; Ward runs a file's deftests in ONE isolated fork, in definition order, with no
; per-test `setup`/`on_exit` hook. The ExUnit `setup`/`on_exit` pair is therefore
; reproduced explicitly: `fresh!` cleans the tree and rebuilds the fixture
; before each test, and each test removes it again in a `finally`.
;
; Run: bin/bl test test/bl/run_code_path_test.bl

(ns run-code-path.test
  (:require [build :as b] [bl.util :as u] [bl.cli]))

(def tmp (Path/join (System/tmp_dir!) "beam_lisp_run_code_path"))
(def src (Path/join tmp "src"))
(def out (Path/join tmp "out"))
(def manifest (Path/join out "compile.beam_lisp"))

(def fixture-src (Path/join src "rcp/fixture.bl"))
(def fixture-beam (Path/join out "Elixir.BeamLisp.Ns.Rcp.Fixture.beam"))

; The module atom the fixture compiles to (`Elixir.BeamLisp.Ns.Rcp.Fixture`).
; Built from its NAME because a bare dotted symbol is not a value in source —
; only the call shape `Mod/fn` names a module.
(def fixture-mod
  (erlang/binary_to_atom "Elixir.BeamLisp.Ns.Rcp.Fixture" :utf8))

(def fixture-source "(ns rcp.fixture)\n(defn answer [] 42)\n")

; ── setup / cleanup (the ExUnit setup + on_exit, made explicit) ──────────────

(defn- fresh!
  "The ExUnit `setup`: a clean scratch tree, the fixture compiled to `out`
   through `build/run`, and `out` absent from the VM code path with the env var
   unset — every case starts from \"not on the path\"."
  []
  (Code/delete_path out)
  (System/delete_env "BEAM_LISP_CODE_PATH")
  (File/rm_rf! tmp)
  (File/mkdir_p! (Path/dirname fixture-src))
  (File/write! fixture-src fixture-source)
  (b/clean out manifest)
  (let [r (b/run {:sources [fixture-src] :out out :manifest manifest})]
    (is (= [] (:errors r)) (str "build errors: " (pr-str (:errors r)))))
  (is (File/exists? fixture-beam) "the build emitted the fixture beam"))

(defn- cleanup!
  "The ExUnit `on_exit`, called from a `finally` so a failing assertion never
   leaves the tree — or a stale code-path entry — behind."
  []
  (Code/delete_path out)
  (code/purge fixture-mod)
  (code/delete fixture-mod)
  (System/delete_env "BEAM_LISP_CODE_PATH")
  (File/rm_rf! tmp))

; ── the entry the CLI runs ──────────────────────────────────────────────────

(defn- entry
  "Write the entry program and return its path. Its VALUE is whether `out` is on
   the VM's code path — the precondition for the loader's AOT-first branch. The
   entry's own dir is on the SOURCE search path, so `(ns main)` loads either
   way; what this checks is whether the beam DIRECTORY is on the VM's code path.

   The ExUnit suite read this through `println` + captured stdout; the value is
   the same fact read directly off `run_file`'s return, so the assertion does not
   depend on `ExUnit.CaptureIO` being started in the ward VM."
  []
  (let [path (Path/join tmp "main.bl")
        source (str "(ns main)\n"
                    "(some (fn [p] (= (unicode/characters_to_binary p) \""
                    out "\")) (code/get_path))\n")]
    (File/write! path source)
    path))

(defn- run
  "Drive the CLI's own parse and path registration — the pair `bl run
   --code-path DIR` uses — then run the entry through the loader. `bl.cli/main`
   halts the VM, which a test cannot survive, so the pieces under test are
   called directly at the same seam the command calls them."
  [argv path]
  (let [st (bl.cli/parse-argv argv)]
    (u/register-paths st)
    (BeamLisp/run_file path)))

; ── the tests ───────────────────────────────────────────────────────────────

(deftest code-path-makes-the-aot-beam-visible-to-the-vm
  (try
    (fresh!)
    (is (= true (run (list "run" "--code-path" out) (entry))))
    (finally (cleanup!))))

(deftest beam-lisp-code-path-does-the-same-from-the-environment
  (try
    (fresh!)
    (System/put_env "BEAM_LISP_CODE_PATH" out)
    (is (= true (run (list "run") (entry))))
    (finally (cleanup!))))

(deftest without-either-the-beam-is-not-on-the-path
  (try
    (fresh!)
    ; the pruned `-pa` is not a fallback: with no flag and no env var, the beam
    ; directory is not on the VM's code path at all.
    (Code/delete_path out)
    (is (nil? (run (list "run") (entry))))
    (finally (cleanup!))))
