; test/bl/floor_claim_test.bl — a FLOOR beam's generation is its floor's CLAIM.
;
; Boot/build-tier beams carry no compiler key in their bytes (`__bl_provenance__`
; answers `{hash, :floor}`, no `bl_compiler_key` attribute), so two generations
; that compile the same source write byte-identical beams. Whether a beam belongs
; to the live generation is answered by the directory it sits in:
;   * a seed directory's `manifest.term` (compiler/build key + sha256 per file);
;   * a build ebin's `compile.beam_lisp` record (per source: tier key + modules).
; `Bootstrap/claimed?` is the one reader. These tests pin that the claim refuses
; everything a wrong stamp used to refuse (BUG-048): tampered bytes, a beam from
; another floor, a missing manifest, a claim made under another key.
;
; Run: bl test test/bl/floor_claim_test.bl

(ns floor-claim.test)

(def ^:private probe-name "Elixir.BeamLisp.Ns.FloorClaimProbe.beam")
(def ^:private probe-mod (erlang/binary_to_atom "Elixir.BeamLisp.Ns.FloorClaimProbe" :utf8))

(defn- t [k v] (erlang/list_to_tuple (list k v)))

(defn- tup [& xs] (erlang/list_to_tuple xs))

(defn- keyless-beam
  "A floor-shaped beam: `__bl_provenance__/0` -> `{hash, :floor}`, no key attribute."
  [value]
  (let [clause (fn [body] (list (tup :clause 1 (list) (list) (list (erl_parse/abstract body)))))
        forms (list (tup :attribute 1 :module probe-mod)
                    (tup :attribute 1 :export (list (t :value 0) (t :__bl_provenance__ 0)))
                    (tup :function 1 :value 0 (clause value))
                    (tup :function 1 :__bl_provenance__ 0 (clause (t "hash" :floor))))]
    (elem (erlang/apply :compile :forms (list (to-list forms) (list :binary :deterministic))) 2)))

(defn- sha-of [bytes]
  (String/downcase (Base/encode16 (erlang/apply :crypto :hash (list :sha256 bytes)))))

(defn- term-text [term]
  (str (erlang/list_to_binary (erlang/apply :io_lib :format (list "~p" (list term)))) ".\n"))

(defn- with-dirs [f]
  (let [root (Path/join (System/tmp_dir!) (str "bl_floor_claim_" (erlang/unique_integer (list :positive))))
        a (Path/join root "a") b (Path/join root "b")]
    (File/mkdir_p! a) (File/mkdir_p! b)
    (try (f a b) (finally (File/rm_rf! root)))))

(defn- seed! [dir bytes key]
  (File/write! (Path/join dir probe-name) bytes)
  (File/write! (Path/join dir "manifest.term")
               (term-text {"compiler_key" key "build_key" (str key "-build")
                           "modules" {probe-name (sha-of bytes)}})))

(deftest a-keyless-beam-carries-no-generation-in-its-bytes
  (let [one (keyless-beam :v)]
    (is (= one (keyless-beam :v)) "the same code is the same bytes, whatever the generation")
    (is (nil? (Keyword/get (elem (erlang/hd (elem (elem (beam_lib/chunks one (list :attributes)) 1) 1)) 1)
                           :bl_compiler_key))
        "no bl_compiler_key attribute")))

(deftest a-seed-claim-vouches-for-its-own-bytes-under-its-own-key
  (with-dirs
    (fn [a _]
      (seed! a (keyless-beam :v) "gen-1")
      (is (BeamLisp.Bootstrap/claimed? a probe-name "gen-1"))
      (is (BeamLisp.Bootstrap/claimed? a probe-name "gen-1-build") "the build key is claimed too"))))

(deftest a-claim-under-another-key-is-stale
  (with-dirs
    (fn [a _]
      (seed! a (keyless-beam :v) "gen-1")
      (is (not (BeamLisp.Bootstrap/claimed? a probe-name "gen-2"))))))

(deftest a-tampered-byte-is-refused
  (with-dirs
    (fn [a _]
      (let [bytes (keyless-beam :v)]
        (seed! a bytes "gen-1")
        (File/write! (Path/join a probe-name)
                     (erlang/iolist_to_binary (list bytes (erlang/list_to_binary (list 0)))))
        (is (not (BeamLisp.Bootstrap/claimed? a probe-name "gen-1")))))))

(deftest a-beam-from-another-floor-is-refused
  (with-dirs
    (fn [a b]
      (seed! a (keyless-beam :a) "gen-1")
      (seed! b (keyless-beam :b) "gen-1")
      ;; swap b's beam into a: same name, same key, different bytes
      (File/write! (Path/join a probe-name) (File/read! (Path/join b probe-name)))
      (is (not (BeamLisp.Bootstrap/claimed? a probe-name "gen-1"))))))

(deftest a-missing-manifest-claims-nothing
  (with-dirs
    (fn [a _]
      (File/write! (Path/join a probe-name) (keyless-beam :v))
      (is (not (BeamLisp.Bootstrap/claimed? a probe-name "gen-1"))))))

(deftest a-build-record-claims-its-modules-under-its-tier-key
  (with-dirs
    (fn [a _]
      (File/write! (Path/join a probe-name) (keyless-beam :v))
      (File/write! (Path/join a "compile.beam_lisp")
                   (erlang/term_to_binary {"/src/priv/boot/x.bl" {:hash "h" :key "gen-1" :modules [probe-mod]}}))
      (is (BeamLisp.Bootstrap/claimed? a probe-name "gen-1"))
      (is (not (BeamLisp.Bootstrap/claimed? a probe-name "gen-2"))))))
