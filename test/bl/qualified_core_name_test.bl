; qualified_core_name_test.bl — a function that shares a core name is a code-review flag.
;
; BUG-111 is fixed: a qualified call `alias/name` means that namespace's `name`, also
; before the namespace is loaded (qualified_call_test.bl pins it). A public function
; named like a core function is still worth a second look, because the bare name
; inside its own namespace means the namespace's own, and a reader who knows core's
; `count` may not expect the other. This fails on a NEW public function in priv/std/vm or
; priv/std/proc that shares a core name; the existing ones are listed with why each is accepted.

(ns qualified-core-name-test)

(def KNOWN
  "Namespace functions that share a core name, each with why it is accepted.
   Arities, measured with BeamLisp.Env/link: count is 1 in both; osenv get is 1,2 against
   core's 2,3; vm.owner/spawn is 3 against core's 1; proc.sched/next is 2 against core's 1."
  {"vm.client/stop" "close a realm client; qualified lifecycle API"
   "vm.exec/start" "start the realm command executor; qualified lifecycle API"
   "vm.gateway/stop" "stop the realm gateway; qualified lifecycle API"
   "vm.manager/start" "start the realm manager; qualified lifecycle API"
   "vm.native/declare" "declare a native capability; callers use the qualified API rather than Core forward declaration syntax"
   "vm.net/stop" "close the realm network listener; qualified lifecycle API"
   "vm.nif-trace/start" "start the native trace session; qualified lifecycle API"
   "vm.nif-trace/stop" "stop the native trace session; qualified lifecycle API"
   "vm.owner/start" "start the realm owner registry; qualified lifecycle API"
   "vm.repl/start" "start the realm REPL endpoint; qualified lifecycle API"
   "vm.service/start" "start a realm service; qualified lifecycle API"
   "vm.session/start" "start a realm session; qualified lifecycle API"
   "vm.session/stop" "close a realm session; qualified lifecycle API"
   "vm.owner/count" "the realm's process count; same arity as core's, so the one to read twice"
   "vm.owner/spawn" "arity 3 against core's 1: the core fallback cannot accept the call (measured)"
   "proc.sched/next" "arity 2 against core's 1: no overlap (measured)"
   "vm.osenv/get" "the process-local env read; (osenv/get k default) overlaps core get's arities"
   "proc.instance/identity" "application/environment-scoped registry identity; its internal calls deliberately use this namespace's identity"
   "proc.instance/call" "SDK call boundary for this application's logical process name; native server invocation remains inside the fixed SDK"
   "proc.instance/name" "OTP registration reference for a logical keyword, including scoped global terms; internal calls deliberately use this namespace's name"})

(def ROOTS ["priv/std/vm" "priv/std/proc"])

(defn- core-name?
  "Whether core supplies a binding called `name`. Asked of the runtime's own var
   table, not a scan of one source file: `count` lives in rt.bl, `defn`s in core.bl
   and macros elsewhere, and a regex over one of them said `count` was not core."
  [name]
  (BeamLisp.Env/bound? "core" name))

(defn- ns-of [text]
  (second (Regex/run #"\(ns ([A-Za-z0-9_.\-]+)" text)))

(defn- defined-names [text]
  (set (map second (Regex/scan #"(?m)^\(defn ([^\s\[\)]+)" text))))

(defn- shadowing [file]
  (let [text (File/read! file)
        n (ns-of text)
        ]
    (map (fn [d] (str n "/" d)) (filter core-name? (defined-names text)))))

(deftest no-new-function-shares-a-core-name
  (let [files (mapcat (fn [r] (map (fn [f] (str r "/" f)) (filter (fn [f] (String/ends_with? f ".bl")) (to-list (File/ls! r))))) ROOTS)
        found (set (mapcat shadowing files))
        unexpected (remove (fn [x] (contains? KNOWN x)) found)]
    (is (empty? unexpected)
        (str "these public functions share a core name and need an explicit reviewed rationale: "
             (pr-str (vec unexpected))))
    (doseq [k (keys KNOWN)]
      (is (contains? found k) (str k " is listed as known but no longer exists: remove it from KNOWN")))))

(run-tests)
