; qualified_core_name_test.bl — a function that shares a core name is a trap until BUG-111 is fixed.
;
; A qualified call `alias/name`, compiled while the alias's namespace is declared but not
; loaded yet, resolves to core's `name` when core has one: `(owner/count id)` answered the
; length of the id string. This fails the build for a NEW instance of the shape, so nobody
; writes the trap again while the compiler still has the bug. The known instance is listed
; with the bug that tracks it; fixing the compiler empties this list.

(ns qualified-core-name-test)

(def KNOWN
  "Namespace functions that share a core name, each with why it is accepted.
   Arity is what makes a collision bite: the core fallback is only taken for a call
   the core function can accept (`count`, arity 1, in both). Measured with
   BeamLisp.Env/link: core spawn is arity 1 and vm.owner/spawn is 3; `declare` is
   not a core function at all (a special form)."
  {"vm.owner/count" "BUG-111: callers use (count (owner/procs id)); guarantees_test pins it"
   "vm.owner/spawn" "arity 3 against core's 1: the core fallback cannot accept the call (measured)"
   "vm.native/declare" "core has no function of that name, only a special form (measured)"})

(def ROOTS ["priv/std/vm" "priv/std/proc"])

(defn- core-names []
  (set (map second (re-seq #"(?m)^\(def(?:n|macro)?-? ([^\s\[\)]+)" (File/read! "priv/boot/core.bl")))))

(defn- ns-of [text]
  (second (re-find #"\(ns ([A-Za-z0-9_.\-]+)" text)))

(defn- defined-names [text]
  (set (map second (re-seq #"(?m)^\(defn ([^\s\[\)]+)" text))))

(defn- shadowing [file]
  (let [text (File/read! file)
        n (ns-of text)
        core (core-names)]
    (map (fn [d] (str n "/" d)) (filter (fn [d] (contains? core d)) (defined-names text)))))

(deftest no-new-function-shares-a-core-name
  (let [files (mapcat (fn [r] (map (fn [f] (str r "/" f)) (filter (fn [f] (String/ends_with? f ".bl")) (to-list (File/ls! r))))) ROOTS)
        found (set (mapcat shadowing files))
        unexpected (remove (fn [x] (contains? KNOWN x)) found)]
    (is (empty? unexpected)
        (str "these public functions share a core name and would be miscompiled by a deferred caller (BUG-111): "
             (pr-str (vec unexpected))))
    (doseq [k (keys KNOWN)]
      (is (contains? found k) (str k " is listed as known but no longer exists: remove it from KNOWN")))))

(run-tests)
