; wave18_rt_port_test.bl — wave 18's runtime contract, ported verbatim from
; the ExUnit `test/beam_lisp/wave18_rt_test.exs`.
;
; Wave 18 is sets, `seq`-on-map iteration, sort/compare, the cpp/* interop shim,
; and the select-keys/flatten dependencies (conj map-entry, sequential?,
; tree-seq, complement). The load-bearing claim is the STRUCT-IS-A-MAP AUDIT:
; every collection fn that guards on `is_map` must match the set struct FIRST
; (count, first, seq, next, contains?, coll?, printing) — otherwise a set is read
; as its struct fields and reports the wrong thing.
;
; WHY THIS PORT IS MOSTLY PLAIN EXPRESSIONS
;
; The ExUnit suite wrapped every expression in `eval_in(source)`
; (`BeamLisp.Compiler.eval_string(source, new_env(ns))`) because the ExUnit
; process is not the language under test. A BL deftest IS the runtime, so the
; expression is evaluated in place — same value, no eval round-trip. Only the
; VENDORED jank slices still need `eval-in`/`load-fixture`: they redefine core
; names (`set`, `name`, `select-keys`, …) and must land in their own namespace,
; exactly as the ExUnit harness loaded them (`(ns jank.slice_XX)`, comments
; stripped, body never rewritten).
;
; THE `is` TRANSLATION, PRECISELY
;
; BL's `is` UNWRAPS an `(= a b)` form into a two-operand compare. So
;   ExUnit `assert eval_in("(= A B)") == true`  →  `(is (= A B))`
;   ExUnit `assert eval_in("(= A B)") == false` →  `(is (not= A B))`
;   ExUnit `assert eval_in("(p x)") == false`   →  `(is (not (p x)))`
; Getting the FALSE cases backwards here would invert the assertion silently —
; which is why each one below is written as the negation of the fact asserted.
;
; Run: bin/bl test test/bl/wave18_rt_port_test.bl

(ns wave18.rt.test)

; --- vendored-fixture loading (same shape as the ExUnit harness) -------------

(defn- eval-in
  "Evaluate `source` in a fresh env for `ns` — the exact driver the ExUnit
   `eval_in/2` used."
  [ns source]
  (BeamLisp.Compiler/eval_string source (BeamLisp.Compiler/new_env ns)))

(defn- load-fixture
  "Load a vendored jank slice VERBATIM into `ns`, stripping `;` comment lines and
   wrapping in `(ns …)` — the slice text itself is never rewritten. A slice that
   fails to load is a recorded FAIL, not something to fix here."
  [fixture ns]
  (let [raw (File/read! (str "test/fixtures/jank/" fixture))
        code (join "\n" (filter (fn [l] (not (starts-with? l ";")))
                                (String/split raw "\n")))]
    (BeamLisp.Compiler/eval_string (str "(ns " ns ")\n" code)
                                   (BeamLisp.Compiler/new_env ns))))

(defn- caught
  "The exception `thunk` raises, or nil when it returns normally — the value the
   ExUnit `assert_raise` inspected."
  [thunk]
  (try (do (thunk) nil) (catch e e)))

; --- sets -------------------------------------------------------------------

(deftest set-constructs-distinct-members
  (is (= (set [1 2 2 3]) (set [1 2 3])))
  (is (= (set '(a b a)) (set '(a b))))
  (is (= (set []) (set nil))))

(deftest set?-and-map?-is-false
  (is (set? (set [1 2])))
  (is (not (set? [1 2])))
  (is (not (set? {:a 1})))
  (is (not (set? nil)))
  (is (not (map? (set [1 2])))))

(deftest membership-via-contains?
  (is (contains? (set [1 2 3]) 2))
  (is (not (contains? (set [1 2 3]) 9))))

(deftest conj-adds-idempotent-disj-removes-idempotent
  (is (= (conj (set [1 2]) 3) (set [1 2 3])))
  (is (= (conj (set [1 2]) 2) (set [1 2])))
  (is (= (disj (set [1 2 3]) 2) (set [1 3])))
  (is (= (disj (set [1 2]) 9) (set [1 2]))))

(deftest count-first-seq-coll?-read-members-not-struct-fields
  (is (= 3 (count (set [1 2 2 3]))))
  (is (= 0 (count (set []))))
  (is (coll? (set [1 2])))
  (is (nil? (seq (set []))))
  (is (not (nil? (seq (set [5 1])))))
  ; every member of (seq (set [5 1])) is a member of the set
  (is (every? (fn [m] (contains? (set [5 1]) m)) (seq (set [5 1]))))
  (is (set? (first (map identity [(set [1])])))))

(deftest equality-set-set-structural-set-distinct-from-vector-list-map
  (is (= (set [1 2 3]) (set [3 2 1])))
  (is (not= (set [1 2]) (set [1 2 3])))
  (is (not= (set [1 2]) [1 2]))
  (is (not= (set [1 2]) '(1 2)))
  (is (not= (set [1 2]) {:a 1}))
  (is (not= (set [1]) (set [2]))))

(deftest printing-is-a-set-literal
  (let [result (pr-str (set [1 2 3]))]
    (is (or (= result "#{1 2 3}") (= result "#{3 2 1}")))))

(deftest map-filter-iterate-set-members
  (is (= (set (map inc (set [1 2 3]))) (set [2 3 4]))))

; The struct-is-a-map audit: every collection fn that guards on `is_map` must see
; a set's members, never its struct fields.
(deftest is_map-audit-a-set-flows-through-every-is_map-guarded-fn
  (is (= 3 (count (set [1 2 3]))))
  (is (contains? #{1 5} (first (set [5 1]))))
  (is (nil? (seq (set []))))
  (is (nil? (next (set [1]))))
  (is (contains? (set [1 2]) 2))
  (is (coll? (set [1 2])))
  (is (not (map? (set [1 2]))))
  (is (= :a (get (set [:a :b]) :a)))
  (is (nil? (get (set [:a :b]) :zz)))
  (is (not (vector? (set [1]))))
  (is (not (list? (set [1]))))
  ; rest of a set is its remaining members (a list), empty when done
  (is (= (rest (set [1 2])) (seq (disj (set [1 2]) (first (set [1 2]))))))
  ; assoc on a set is a clean, typed refusal
  (is (= :Elixir.ArgumentError
         (:__struct__ (caught (fn [] (assoc (set [1 2]) :k :v)))))))

; --- seq on a map (merge-with) ----------------------------------------------

(deftest seq-yields-kv-entries-driving-reduce-key-val
  (is (= :a (key (find {:a 1} :a))))
  (is (= 1 (val (find {:a 1} :a))))
  (is (= (set [:a :b]) (set (map key (seq {:a 1 :b 2}))))))

(deftest slice-58-merge-with-loads-verbatim-and-behaves
  (load-fixture "slice_58_merge_with.bl" "wave18.mw")
  (let [ns "wave18.mw"]
    (is (= {:a 4 :b 2 :c 4} (eval-in ns "(merge-with + {:a 1 :b 2} {:a 3 :c 4})")))
    (is (= {:a 6 :b 4} (eval-in ns "(merge-with (fn [x y] (* x y)) {:a 2} {:a 3 :b 4})")))
    (is (= {:a 1} (eval-in ns "(merge-with + {:a 1} nil)")))))

; --- sort and compare -------------------------------------------------------

(deftest compare-orders-numbers-strings-keywords-symbols-nil
  (is (= -1 (compare 1 2)))
  (is (= 1 (compare 2 1)))
  (is (= 0 (compare 3 3)))
  (is (= -1 (compare nil 1)))
  (is (= 1 (compare 1 nil)))
  (is (= -1 (compare false true)))
  (is (= -1 (compare "a" "b")))
  (is (= -1 (compare :a :b)))
  (is (= -1 (compare 'a 'b))))

(deftest compare-orders-collections-element-wise
  (is (= -1 (compare [1 2] [1 3])))
  (is (= 0 (compare [1 2] [1 2])))
  (is (= -1 (compare [1] [1 2])))
  (is (= -1 (compare [1 2] [2]))))

(deftest mixed-type-total-order
  (is (= '(nil false true 5 10 "x" :a) (sort [10 :a nil "x" 5 false true]))))

(deftest sort-asc-and-with-a-comparator
  (is (= '(1 2 3) (sort [3 1 2])))
  (is (= '(3 2 1) (sort (fn [a b] (- b a)) [3 1 2])))
  (is (= 0 (count (sort [])))))

(deftest slice-59-sort-by-loads-verbatim-and-behaves
  (load-fixture "slice_59_sort_by.bl" "wave18.sb")
  (is (= '([1 2] [2 3] [3 1]) (eval-in "wave18.sb" "(sort-by first [[3 1] [1 2] [2 3]])"))))

; --- cpp/* interop shim (slices 31/32/33) -----------------------------------

(deftest slice-31-name-loads-verbatim-and-behaves
  (load-fixture "slice_31_name.bl" "wave18.nm")
  (is (= "foo" (eval-in "wave18.nm" "(name :foo)")))
  (is (= "foo" (eval-in "wave18.nm" "(name 'foo)")))
  (is (= "foo" (eval-in "wave18.nm" "(name \"foo\")"))))

(deftest slice-32-namespace-loads-verbatim-and-behaves
  (load-fixture "slice_32_namespace.bl" "wave18.nsp")
  (is (= "a" (eval-in "wave18.nsp" "(namespace :a/b)")))
  (is (= "a" (eval-in "wave18.nsp" "(namespace 'a/b)")))
  (is (nil? (eval-in "wave18.nsp" "(namespace :plain)"))))

(deftest slice-33-keyword-loads-verbatim-and-behaves
  (load-fixture "slice_33_keyword.bl" "wave18.kw")
  (is (= :a/b (eval-in "wave18.kw" "(keyword \"a\" \"b\")")))
  (is (= :foo (eval-in "wave18.kw" "(keyword \"foo\")")))
  (is (= :foo (eval-in "wave18.kw" "(keyword 'foo)")))
  (is (= :already (eval-in "wave18.kw" "(keyword :already)"))))

; --- flatten deps (slice 50) ------------------------------------------------

(deftest sequential?-distinguishes-sequential-from-map-set-string
  (is (sequential? [1 2]))
  (is (sequential? '(1 2)))
  (is (not (sequential? {:a 1})))
  (is (not (sequential? (set [1]))))
  (is (not (sequential? "abc"))))

(deftest tree-seq-walks-nested-vectors
  (is (= '([1 [2 [3 4]] 5] 1 [2 [3 4]] 2 [3 4] 3 4 5)
         (tree-seq sequential? seq [1 [2 [3 4]] 5]))))

(deftest slice-50-flatten-loads-verbatim-and-behaves
  (load-fixture "slice_50_flatten.bl" "wave18.fl")
  (is (= '(1 2 3 4 5) (doall (eval-in "wave18.fl" "(flatten [1 [2 [3 4]] 5])"))))
  ; flatten is lazy: flattening nil is an empty lazy seq, realized here
  (is (= '() (doall (eval-in "wave18.fl" "(flatten nil)")))))

; --- select-keys (slice 28, conj map-entry) ---------------------------------

(deftest conj-with-a-kv-entry-adds-to-a-map
  (is (= {:a 1} (conj {} (find {:a 1} :a))))
  (is (= {:a 1 :b 2} (conj {:b 2} (find {:a 1} :a)))))

(deftest slice-28-select-keys-loads-verbatim-and-behaves
  (load-fixture "slice_28_select_keys.bl" "wave18.sk")
  (is (= {:a 1 :c 3} (eval-in "wave18.sk" "(select-keys {:a 1 :b 2 :c 3} [:a :c])")))
  (is (= {:a 1} (eval-in "wave18.sk" "(select-keys {:a 1 :b 2} [:a :zz])"))))

; --- slice 30 set -----------------------------------------------------------

(deftest slice-30-set-runs-on-the-readers-set-literal-and-a-transient-set
  ; The slice body is `(persistent! (reduce … (transient #\{}) coll))`, so it
  ; needs three things that now exist: the reader's set literal, a set type, and
  ; a transient whose kind is a set.
  (load-fixture "slice_30_set.bl" "wave18.set")
  (is (= 3 (eval-in "wave18.set" "(count (set [1 2 2 3]))")))
  (is (eval-in "wave18.set" "(contains? (set [1 2]) 2)")))
