; core_backend_test.bl — the Core Erlang backend, graduated (PLAN-079 S-A).
;
; self.core lowers priv/boot/compiler.bl's emitted (quoted) output to Core
; Erlang (cerl → compile:forms → .beam), the same tree the Elixir backend
; consumes. This is the BEHAVIOURAL oracle: compile one form, evaluate it
; BOTH ways, assert the values are `=`. Value-identity is a stronger gate than
; the tree-identity oracle (priv/self/oracle.bl) — it tests what the code DOES,
; not what it looks like — and it is the gate that carries to the whole prelude
; as the backend becomes the default (S-D).

(ns core-backend.test
  (:require [compiler :as c] [self.core :as sc]))

(def kenv (assoc (c/new-env "user") :ns "user"))

(defn- quoted-of
  "compiler.bl's emitted (Elixir-quoted) output for a source string."
  [src]
  (c/compile (BeamLisp.Reader/read_one src) kenv))

(defn- via-elixir
  "Evaluate the quoted tree through the Elixir backend (Code.eval_quoted)."
  [q]
  (first (erlang/tuple_to_list (Code/eval_quoted q))))

(def ctr (atom 0))
(defn- via-core
  "Evaluate the SAME quoted tree through the Core Erlang backend (self.core)."
  [q]
  (sc/eval-core (erlang/binary_to_atom (str "bl_cbt_" (swap! ctr inc))) (sc/lower q)))

(defn- same?
  "True when a source form yields the same value through both backends."
  [src]
  (let [q (quoted-of src)]
    (= (via-elixir q) (via-core q))))

(deftest literals-and-calls
  (testing "literals, collections, and the call paths evaluate identically"
    (is (same? "42"))
    (is (same? "[1 :a \"s\"]"))
    (is (same? "{:a 1 :b [2 3]}"))
    (is (same? "#{1 2}"))
    (is (same? "(+ 1 2)"))
    (is (same? "(str \"a\" \"b\" \"c\")"))
    (is (same? "(first [1 2])"))
    (is (same? "(erlang/tuple_size (erlang/list_to_tuple (list 1 2 3)))"))))

(deftest binding-and-control
  (testing "let, if truthiness, cond, loop/recur"
    (is (same? "(let [x 5 y 3] (* x y))"))
    (is (same? "(if (> 3 2) :yes :no)"))
    (is (same? "(if nil :yes :no)"))
    (is (same? "(cond (> 1 2) :a (< 1 2) :b :else :c)"))
    (is (same? "(loop [i 0 acc 0] (if (< i 10) (recur (+ i 1) (+ acc i)) acc))"))))

(deftest fns-and-destructuring
  (testing "closures, variadic, multi-clause, destructuring"
    (is (same? "((fn [n] (if (< n 2) 1 n)) 5)"))
    (is (same? "((fn [x & xs] xs) 1 2 3)"))
    (is (same? "(let [[a b] [1 2]] (+ a b))"))
    (is (same? "(let [f (fn ([a] :one) ([a b] :two))] [(f 1) (f 1 2)])"))))

(deftest errors-and-messages
  (testing "try/throw/catch, ex-data, finally ordering"
    (is (same? "(try (throw :x) (catch e (ex-message e)))"))
    (is (same? "(try (+ 1 (throw {:boom 1})) (catch e [:caught (ex-data e)]))"))
    (is (same? "(let [a (atom 0)] (try (throw :x) (catch e (swap! a inc)) (finally (swap! a (fn [n] (+ n 10))))) (deref a))"))
    (is (same? "(let [a (atom 0)] (try (swap! a inc) (finally (swap! a (fn [n] (+ n 10))))) (deref a))"))
    (is (same? "(try (erlang/error :boom) (catch ErlangError e :caught-erlang))"))))

(deftest messaging-and-hof
  (testing "receive/after, and higher-order prelude fns"
    (is (same? "(do (erlang/send (erlang/self) [:hi 7]) (receive [:hi n] (* n 2) (after 100 :timeout)))"))
    (is (same? "(receive [:never x] x (after 10 :timeout))"))
    (is (same? "(map inc [1 2 3])"))
    (is (same? "(reduce + 0 (range 5))"))))

(deftest defn-in-core
  (testing "a defn lowers to a Core body module and computes correctly"
    ; core-defvar defines `fact` in ns user via body+shim Core modules
    (sc/eval-def (quoted-of "(defn cbt-fact ([n] (cbt-fact n 1)) ([n acc] (if (< n 2) acc (cbt-fact (- n 1) (* acc n)))))"))
    (is (= 3628800 (BeamLisp.Ns.User/cbt-fact 10)))))

(deftest closure-survives-redefinition
  (testing "a closure from an early def survives 3 redefinitions (body module never reloaded)"
    (sc/eval-def (quoted-of "(defn cbt-mk [k] (fn [x] [k x]))"))
    (let [clo (BeamLisp.Ns.User/cbt-mk :v1)]
      (sc/eval-def (quoted-of "(defn cbt-mk [k] :v2)"))
      (sc/eval-def (quoted-of "(defn cbt-mk [k] :v3)"))
      (sc/eval-def (quoted-of "(defn cbt-mk [k] :v4)"))
      (is (= [:v1 7] (clo 7)))
      (is (= :v4 (BeamLisp.Ns.User/cbt-mk 0))))))

(run-tests)
