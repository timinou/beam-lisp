(ns async.http-ownership-test
 (:require [anf :as a] [lower :as lower] [web :as web]))

(defn router-descriptor [mod]
 (a/module mod
  (list {:op :defn-clause :fname :router :params (list (a/pvar "conn"))
         :guard nil :body (a/var "conn") :ann {}})
  (list [:router 1]) (list)))
(defn wait-retired [mod]
 (loop [attempt 0]
  (if (BeamLisp.Env/retire_module! mod) true
   (if (= attempt 1000) false
    (do (Process/sleep 10) (recur (inc attempt)))))))

(deftest http-listener-registration-retains-router-until-unregister
 (let [mod :bl_registered_http_router log-mod :bl_registered_http_log]
  (lower/reload-descriptor! (router-descriptor mod))
  (lower/reload-descriptor! (router-descriptor log-mod))
  (let [result (web/serve {:port 0 :ip (tuple 127 0 0 1)
                         :log (tuple :"$blfn" {1 (erlang/make_fun log-mod :router 1)} nil)
                         :plug (erlang/make_fun mod :router 1)})
        pid (when (= :ok (elem result 0)) (elem result 1))]
   (try
    (is (= :ok (elem result 0)))
    (is (not (BeamLisp.Env/retire_module! mod)) "bootstrap lifetime owns the router")
    (is (not (BeamLisp.Env/retire_module! log-mod)) "descriptor log callback is retained too")
    (lower/reload-descriptor! (router-descriptor mod))
    (is (try (lower/reload-descriptor! (router-descriptor mod)) false (catch _ true)))
    (when pid (Supervisor/stop pid :normal 30000))
    (is (wait-retired mod) "listener termination releases registration")
    (is (wait-retired log-mod))
    (finally (when (and pid (Process/alive? pid)) (Supervisor/stop pid :normal 30000))
             (wait-retired mod) (wait-retired log-mod))))))
