; test/bl/js_diff_test.bl — the BEAM <-> JS differential, inside `bl test`.
;
; The corpus (test/js/diff/diff/corpus.bl) runs here, on the BEAM, and is
; compiled to ES modules by the SAME build `bl js build` runs (bl.js/build!);
; Node prints the JS side and compare.mjs canonicalizes map/set order and
; compares. One VM, one build, one node process. Skipped (not failed) when
; node is not installed.

(ns bl.js.diff-test
  (:require [bl.cli] [bl.js :as js]
            [bl.util :as u]))

(def ^:private dir "test/js/diff")

(def ^:private cases
  ["numbers" "equality" "collections" "seqs" "strings" "functions" "destructuring" "control"])

(defn- beam-lines []
  (BeamLisp.Env/add_search_path dir)
  (BeamLisp.Loader/ensure_loaded "diff.corpus")
  (join "\n" (map (fn [c]
                    (str c "\t" (try (pr-str ((BeamLisp.Env/fetch! "diff.corpus" (str "case-" c))))
                                     (catch e (str "#error " (ex-message e))))))
                  cases)))

(defn- tmp-dir []
  (let [d (str (or (System/get_env "TMPDIR") (System/tmp_dir!)) "/bl-jsdiff-" (System/unique_integer (u/to-list [:positive])))]
    (File/mkdir_p! d)
    d))

(deftest beam-and-js-print-every-case-identically
  (if (nil? (System/find_executable "node"))
    (is true "node not installed: differential skipped")
    ; the BEAM side runs FIRST: the JS build interns placeholders for names it
    ; has not seen bound, so a namespace it compiles before the VM loads it
    ; would be clobbered (PLAN-163 U2: the build must stop touching the env)
    (let [out (tmp-dir)
          _ (File/write! (str out "/beam.out") (beam-lines))
          _ (js/build! "diff.corpus" {:paths (list dir) :out out})
          [jsout jcode] (u/to-list (erlang/tuple_to_list (System/cmd "node" (u/to-list [(str dir "/js-side.mjs") out]))))
          _ (File/write! (str out "/js.out") jsout)
          [report code] (u/to-list (erlang/tuple_to_list (System/cmd "node" (u/to-list [(str dir "/compare.mjs") (str out "/beam.out") (str out "/js.out")]))))]
      (is (= 0 jcode) jsout)
      (is (= 0 code) report)
      (File/rm_rf! out))))

(deftest js-is-a-verb
  (is (contains? bl.cli/commands "js") "the dispatcher must know it")
  (is (some? (get bl.cli/command-help "js")) "help must know it")
  (is (pos? (count (filterv (fn [c] (= c "js")) (mapcat second bl.cli/usage-groups))))
      "the usage overview must list it"))
