; test/bl/js_diff_test.bl — the BEAM <-> JS differential, inside `bl test`.
;
; The corpus (test/js/diff/diff/corpus.bl) runs here, on the BEAM, and is
; compiled to ES modules by the SAME build `bl js build` runs (bl.js/build!);
; Node prints the JS side and compare.mjs canonicalizes map/set order and
; compares. One VM, one build, one node process. Skipped (not failed) when
; node is not installed.
(ns bl.js.diff-test
  (:require [bl.cli] [bl.js :as js]
            [bl.util :as u]))

(def ^:private dir "test/js/diff")

(def ^:private cases
  ["numbers" "equality" "collections" "seqs" "strings" "functions" "destructuring" "control"])

(defn- beam-lines []
  (BeamLisp.Env/add_search_path dir)
  (BeamLisp.Loader/ensure_loaded "diff.corpus")
  (join "\n" (map (fn [c]
                    (str c "\t" (try (pr-str ((BeamLisp.Env/fetch! "diff.corpus" (str "case-" c))))
                                     (catch e (str "#error " (ex-message e))))))
                  cases)))

(defn- tmp-dir []
  (let [d (str (or (System/get_env "TMPDIR") (System/tmp_dir!)) "/bl-jsdiff-" (System/unique_integer (u/to-list [:positive])))]
    (File/mkdir_p! d)
    d))

(deftest beam-and-js-print-every-case-identically
  (if (nil? (System/find_executable "node"))
    (is true "node not installed: differential skipped")
    ; ONE target: the default build compiles core and rt from priv/boot; there
    ; is no hand-written core to opt into and no mode flag. The BEAM side runs
    ; FIRST: the JS build interns placeholders for names it has not seen bound,
    ; so a namespace it compiles before the VM loads it would be clobbered
    ; (PLAN-163 U2: the build must stop touching the env).
    (let [out (tmp-dir)
          _ (File/write! (str out "/beam.out") (beam-lines))
          r (js/build! "diff.corpus" {:paths (list dir) :out out})
          [jsout jcode] (u/to-list (erlang/tuple_to_list (System/cmd "node" (u/to-list [(str dir "/js-side.mjs") out]))))
          _ (File/write! (str out "/js.out") jsout)
          [report code] (u/to-list (erlang/tuple_to_list (System/cmd "node" (u/to-list [(str dir "/compare.mjs") (str out "/beam.out") (str out "/js.out")]))))]
      (is (contains? (set (:modules r)) "rt") "rt is a compiled namespace of the build")
      (is (contains? (set (:modules r)) "core") "core is a compiled namespace of the build")
      (is (not (File/exists? (str out "/core.mjs"))) "no hand-written core.mjs is copied beside the runtime")
      (is (= 0 jcode) jsout)
      (is (= 0 code) report)
      (File/rm_rf! out))))

; ── ONE LINK RULE (PLAN-163 structural fix 1). The static linker (build.bl
;    link-ctx) and the eval-time linker (leaves.mjs `X`) resolve a remote
;    through the SAME key `mod/fun/arity`: a compiled namespace's export first,
;    else the exact LEAF. The rule `remote-link` is leaf-only (`[:leaf key]` or
;    nil — a core name is never a port), and `core-links-module` emits the
;    build's LINKS/REST_FNS from the LIVE BEAM link table. This pins the
;    generated module against that table and against the runtime's leaf set. ──

(deftest the-eval-linker-and-the-static-linker-agree
  (if (nil? (System/find_executable "node"))
    (is true "node not installed: skipped")
    (let [core (js/core-names)
          leaves (js/leaf-names)
          src (BeamLisp.Ns.Js.Build/core-links-module core leaves)
          linked (set (keep (fn [nm]
                              (let [l (try (BeamLisp.Env/link "core" nm) (catch e :error))]
                                (when (and (erlang/is_tuple l) (= :ok (erlang/element 1 l))) nm)))
                            (sort (concat core ["+" "-" "*" "/" "<" ">" "<=" ">=" "==" "="]))))
          link-rows (re-seq #"\n  \[\"([^\"]+)\", R\.tup\(\[R\.kw\(\"([^\"]+)\"\)," src)
          rest-rows (map (fn [[_ m f a]] [m f (erlang/binary_to_integer a)])
                         (re-seq #"\n  \[\"([^\"]+)\", \"([^\"]+)\", (\d+)\]" src))]
      (is (< 50 (count link-rows)) "LINKS has rows")
      (is (= linked (set (map second link-rows))) "LINKS names are the live core links")
      ; `==` is the numeric tower; `=` is the language's own equality (rt/eqv)
      (is (some? (index-of src "[\"==\", R.tup([R.kw(\"Elixir.BeamLisp.Num\"), R.hashMap(2, R.kw(\"num_eq\")), null])]"))
          "== is the live numeric eq, not erlang/==")
      (is (some? (index-of src "[\"=\", R.tup([R.kw(\"Elixir.BeamLisp.Ns.Rt\"), R.hashMap(2, R.kw(\"eqv\")), null])]"))
          "= is the live rt/eqv, not erlang/==")
      ; REST_FNS is the live variadic table at its rest-list arity (min + 1)
      (is (= (set (BeamLisp.Ns.Js.Build/rest-fns (vec core))) (set rest-rows))
          "REST_FNS is the live BEAM rest-list table, verbatim")
      (is (some? (index-of src "[\"Elixir.BeamLisp.Refs\", \"swap!\", 3]"))
          "a variadic core fn is declared at its rest-list arity")
      ; erlang/== is the BEAM's TERM equality, never core `=`
      (is (contains? leaves "erlang/==/2") "erlang/== has its own leaf")
      (is (= [:leaf "erlang/==/2"] (BeamLisp.Ns.Js.Build/remote-link
                                     (erlang/binary_to_atom "erlang")
                                     (erlang/binary_to_atom "==")
                                     2 leaves))
          "the one rule sends erlang/== to its term-equality leaf")
      (is (erlang/== false (erlang/== [1] (list 1))) "[1] == (1) is false on the BEAM")
      (is (erlang/== true (= [1] (list 1))) "[1] = (1) is true: BL `=` is sequential equality")
      ; every runtime leaf key is a static leaf: the two linkers share one table
      (doseq [k leaves]
        (let [i (last-index-of k "/") j (index-of k "/")]
          (is (= [:leaf k] (BeamLisp.Ns.Js.Build/remote-link
                             (erlang/binary_to_atom (subs k 0 j))
                             (erlang/binary_to_atom (subs k (inc j) i))
                             (erlang/binary_to_integer (subs k (inc i)))
                             leaves))
              (str "runtime leaf " k " is not a static leaf"))))
      ; a compiled-namespace name is resolved by the module table, never a port
      (is (nil? (BeamLisp.Ns.Js.Build/remote-link
                  (erlang/binary_to_atom "Elixir.BeamLisp.Ns.Core")
                  (erlang/binary_to_atom "map")
                  2 leaves))
          "a compiled-core name is not a leaf port")
      (is (nil? (index-of src "OPS")) "the generated module carries no core-key port table"))))

(deftest js-is-a-verb
  (is (contains? bl.cli/commands "js") "the dispatcher must know it")
  (is (some? (get bl.cli/command-help "js")) "help must know it")
  (is (pos? (count (filterv (fn [c] (= c "js")) (mapcat second bl.cli/usage-groups))))
      "the usage overview must list it"))

; ── the self-hosted READER, compiled to JS, reads what the BEAM reader reads ──

(defn- reader-canon [x]
  (cond
    (nil? x) "nil"
    (erlang/is_tuple x) (str "{" (join " " (map reader-canon (erlang/tuple_to_list x))) "}")
    (erlang/is_list x) (str "(" (join " " (map reader-canon x)) ")")
    (vector? x) (str "[" (join " " (map reader-canon x)) "]")
    (map? x) (str "{" (join ", " (sort (map (fn [[k v]] (str (reader-canon k) " " (reader-canon v))) x))) "}")
    (string? x) (str "\"" (join "," (map str (unicode/characters_to_list x))) "\"")
    :else (pr-str x)))

(deftest the-js-reader-reads-the-compiler-sources-like-the-beam
  (if (nil? (System/find_executable "node"))
    (is true "node not installed: skipped")
    (let [out (tmp-dir)
          files ["priv/boot/compiler.bl" "priv/boot/core.bl" "priv/boot/rt.bl" "priv/boot/reader.bl"
                 "priv/std/bl/doc/spans.bl" "apps/bl-ed/ed/forms.bl" "test/js/diff/diff/corpus.bl"]
          _ (js/build! "reader" {:paths (list "priv/boot") :out out})
          beam (join "\n" (map (fn [p] (str p "\t" (reader-canon (BeamLisp.Ns.Reader/read_all (File/read! p))))) files))
          _ (File/write! (str out "/beam.out") beam)
          [jsout jcode] (u/to-list (erlang/tuple_to_list
                                     (System/cmd "node" (u/to-list (concat ["test/js/reader/js-side.mjs" out] files)))))
          _ (File/write! (str out "/js.out") jsout)]
      (is (= 0 jcode) jsout)
      (let [got (trim jsout)]
        (when (not= beam got)
          (doseq [[a b] (map (fn [a b] [a b]) (split beam "\n") (split got "\n"))]
            (when (not= a b)
              (let [off (binary/longest_common_prefix (list a b))
                    start (max 0 (- off 60))
                    cut (fn [s] (erlang/binary_part s start (min 180 (- (erlang/byte_size s) start))))]
                (println (str "reader mismatch at byte " off "\nBEAM: " (cut a) "\nJS:   " (cut b)))))))
        (is (= beam got) "every file reads to the same forms"))
      (File/rm_rf! out))))

; ── Beam Lisp EVALUATED in JS (reader + compiler + emitter, compiled to JS,
;    core's own macros loaded from core.bl) gives the BEAM's answers ─────────

(defn- beam-eval-lines
  "Each top-level form of `corpus` evaluated on the BEAM, in order, as
   `<index>\\t<pr-str>` lines (test/js/eval/js-side.mjs prints the same shape)."
  [corpus]
  (join "\n" (map-indexed
               (fn [i f]
                 (str i "\t"
                      (try (let [v (BeamLisp.Compiler/eval_form f (BeamLisp.Compiler/new_env "eval-user"))]
                             (cond (fn? v) "#fn"
                                   (and (erlang/is_tuple v) (= :$macro (erlang/element 1 v))) "#macro"
                                   :else (pr-str v)))
                           (catch e (str "#error " (ex-message e))))))
               (BeamLisp.Ns.Reader/read_string (File/read! corpus) "corpus"))))

; corpus.bl: the language at large. lazy.bl: lazy NODE semantics (realise
; once, retry after a thrown thunk, recursive force, the cyclic-memo guard,
; delay/force/realized?), the answers lazy.mjs owes the BEAM. leaves.bl: the
; host leaves compiled core reaches (host-leaves.mjs), called directly.
(deftest beam-lisp-evaluated-in-js-gives-the-beams-answers
  (if (nil? (System/find_executable "node"))
    (is true "node not installed: skipped")
    (let [out (tmp-dir)
          _ (js/build! "js.eval" {:paths (list "priv/lib" "priv/boot") :out out
                                  :stub "lower" :with "reader" :host "run"})]
      (doseq [corpus ["test/js/eval/corpus.bl" "test/js/eval/lazy.bl" "test/js/eval/leaves.bl"]]
        (let [_ (File/write! (str out "/beam.out") (beam-eval-lines corpus))
              [jsout jcode] (u/to-list (erlang/tuple_to_list (System/cmd "node" (u/to-list ["test/js/eval/js-side.mjs" out corpus "."]))))
              _ (File/write! (str out "/js.out") jsout)
              [report code] (u/to-list (erlang/tuple_to_list (System/cmd "node" (u/to-list ["test/js/diff/compare.mjs" (str out "/beam.out") (str out "/js.out")]))))]
          (is (= 0 jcode) (str corpus ": " jsout))
          (is (= 0 code) (str corpus ": " report))))
      (File/rm_rf! out))))
