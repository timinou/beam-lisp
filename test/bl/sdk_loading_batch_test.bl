(ns sdk-loading-batch-test)

(deftest sealed-dependency-admission-preserves-deferred-initializers-and-converges
 (let [image (Path/join (BeamLisp.Tiers/priv_root) "sdk-code.term")
       root "data.bounded-cache"
       namespaces [root "data.cache-budget" "data.cache-pool"]
       pattern (tuple :Elixir.BeamLisp.AOT :sdk_runtime_inventory! 1)]
  (if-not (File/exists? image)
   (is (nil? (BeamLisp.AOT/preload_sdk_image_closure! root))
       "source images keep ordinary per-unit loading")
   (BeamLisp.Env/with_env :global (fn []
    (let [before (mapv BeamLisp.Env/loaded_ns? namespaces)
          binding (BeamLisp.Env/lookup (tuple root "OWNER-TIMEOUT-MS"))
          prior (BeamLisp.AOT/source_sdk_receipt (BeamLisp.Emit/module_for root))]
     (is (= false (first before)) "the consumer starts with this SDK namespace cold")
     ;; Ward can already have admitted this dependency's immutable code while
     ;; leaving its namespace cold. That existing proof needs no new traversal.
     (when prior (is (BeamLisp.AOT/sdk_unit_compiled? root)))
     (try
      (erlang/trace_pattern pattern true (list :local :call_count))
      (BeamLisp.Loader.Server/run (fn [] (BeamLisp.AOT/preload_sdk_image_closure! root)))
      (is (BeamLisp.AOT/sdk_unit_compiled? root))
      (is (= before (mapv BeamLisp.Env/loaded_ns? namespaces))
          "loading immutable objects does not initialize their namespaces")
      (is (= binding (BeamLisp.Env/lookup (tuple root "OWNER-TIMEOUT-MS")))
          "value initializers remain deferred")
      (let [admitted (erlang/trace_info pattern :call_count)]
       (is (= (tuple :call_count (if prior 0 1)) admitted)
           "a new group needs one issuer traversal; an admitted group needs none")
       (BeamLisp.Loader/ensure_loaded root)
       (BeamLisp.Env/ensure_sdk_runtime!)
       (BeamLisp.Env/ensure_sdk_runtime!)
       (is (= admitted (erlang/trace_info pattern :call_count))
           "initialization and subsequent no-ops reuse that exact admitted set")
       (is (= (tuple :ok 25) (BeamLisp.Env/lookup (tuple root "OWNER-TIMEOUT-MS"))))
       (is (= (assoc before 0 true) (mapv BeamLisp.Env/loaded_ns? namespaces))
           "only the requested namespace initializes; unused dependencies stay lazy"))
      (finally (erlang/trace_pattern pattern false (list :local :call_count))))))))))

(deftest single-class-queries-never-materialize-the-whole-image-inventory
 (let [pattern (tuple :Elixir.BeamLisp.AOT :inventory_term 1)
       module (BeamLisp.Server/module_for "proc.owner-registry" "registry")]
  (try
   (erlang/trace_pattern pattern true (list :local :call_count))
   (is (= module (:module (BeamLisp.AOT/sdk_class_evidence! module))))
   (is (= false (BeamLisp.AOT/sdk_generated_class? :Elixir.BeamLisp.Vector)))
   (is (= false (BeamLisp.AOT/sdk_generated_class? :bl_non_record_metadata_probe)))
   (is (= (tuple :call_count 0) (erlang/trace_info pattern :call_count)))
   (finally (erlang/trace_pattern pattern false (list :local :call_count))))))


(deftest first-diagnostics-do-not-rediscover-the-sdk-for-every-provider
 (let [image (Path/join (BeamLisp.Tiers/priv_root) "sdk-code.term")
       pattern (tuple :Elixir.BeamLisp.AOT :sdk_runtime_inventory! 1)]
  (if-not (File/exists? image)
   (is (nil? (BeamLisp.AOT/preload_sdk_image_closure! "bl.check")))
   (try
    (erlang/trace_pattern pattern true (list :local :call_count))
    (BeamLisp.Loader/ensure_loaded "bl.check")
    (let [analyze (BeamLisp.Env/fetch_exact! "bl.check" "analyze-source")
          result (BeamLisp.Ns.Rt/invoke analyze
                   (list "batch-probe.bl" "(ns batch.probe) (defn value [x] (+ x 1))"))
          walks (elem (erlang/trace_info pattern :call_count) 1)]
     (println "SDK FIRST DIAGNOSTIC WALKS" walks)
     (is (= false (:unreadable result)))
     (is (<= walks 4) "new providers admit bounded dependency groups, not repeated growing SDK walks"))
    (finally (erlang/trace_pattern pattern false (list :local :call_count)))))))


(deftest private-owner-never-prepares-a-loading-batch
 (let [pattern (tuple :code :prepare_loading 1)]
  (try
   (erlang/trace_pattern pattern true (list :local :call_count))
   (is (nil? (Agent/get :Elixir.BeamLisp.Env
               (fn [_] (BeamLisp.AOT/preload_sdk_image_closure! "wry")))))
   (is (= (tuple :call_count 0) (erlang/trace_info pattern :call_count)))
   (finally (erlang/trace_pattern pattern false (list :local :call_count))))))
