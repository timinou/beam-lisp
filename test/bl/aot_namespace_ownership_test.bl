(ns aot.namespace-ownership-test)

(defn- options [out file]
 (list (tuple :output_dir out) (tuple :file file)))

(deftest namespace-only-unit-emits-its-own-initializer-never-the-caller
 (let [root (str (System/tmp_dir!) "/aot-ownership-" (System/unique_integer (list :positive)))
       environment (BeamLisp.Env/fork)]
  (File/mkdir_p! root)
  (try
   (BeamLisp.Env/with_env environment
    (fn []
     (BeamLisp.Compiler/eval_string "(ns user) (defn intact [] 42)")
     (let [before (BeamLisp.Env/ns_defs "user")
           beams (BeamLisp.AOT/compile_source "(ns ownership.empty)"
                   (options root (str root "/empty.bl")))
           modules (set (map first beams))]
      (is (contains? before "intact") "the initial user namespace has inherited definitions")
      (is (contains? modules (BeamLisp.Emit/module_for "ownership.empty")))
      (is (not (contains? modules (BeamLisp.Emit/module_for "user"))))
      (is (= before (BeamLisp.Env/ns_defs "user")))
      (is (= (list) (BeamLisp.AOT/compile_source "(+ 1 2)" (options root (str root "/action.bl")))))
      (is (= before (BeamLisp.Env/ns_defs "user")))
      (is (= 42 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! "user" "intact") (list)))))))
   (finally (BeamLisp.Env/destroy environment) (File/rm_rf! root)))))

(deftest namespace-only-reexports-replay-from-the-artifact-in-a-fresh-vm
 (let [root (str (System/tmp_dir!) "/aot-facade-" (System/unique_integer (list :positive)))
       source (str root "/source") out (str root "/ebin")
       provider (str source "/ownership/provider.bl") facade (str source "/ownership/facade.bl")
       consumer (str root "/consumer.bl") environment (BeamLisp.Env/fork)]
  (try
   (File/mkdir_p! (Path/dirname provider)) (File/mkdir_p! out)
   (File/write! provider "(ns ownership.provider) (defn meter [x] x) (defn- hidden [] :secret)")
   (File/write! facade "(ns ownership.facade (:require [ownership.provider :refer :all]))")
   (BeamLisp.Env/with_env environment
    (fn [] (BeamLisp.Loader/with_search_dir source
     (fn []
      (BeamLisp.AOT/compile_file provider (list (tuple :output_dir out)))
      (BeamLisp.AOT/compile_file facade (list (tuple :output_dir out)))))))
   (File/write! consumer
    (str "(ns ownership.consumer)\n"
     "(Code/prepend_path " (pr-str out) ")\n"
     "(BeamLisp.Loader/with_search_dir " (pr-str source) " (fn [] "
     "(BeamLisp.Loader/ensure_loaded \"ownership.facade\") "
     "(assert (= 42 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! \"ownership.facade\" \"meter\") (list 42)))) "
     "(assert (nil? (BeamLisp.Env/refer_source \"ownership.facade\" \"hidden\"))) "
     "(assert (= (String/to_charlist "
     (pr-str (str out "/Elixir.BeamLisp.Ns.Ownership.Facade.beam"))
     ") (code/which (BeamLisp.Emit/module_for \"ownership.facade\")))) "
     "(println \"FACADE_ARTIFACT_OK\")))\n"))
   (let [[text status] (System/cmd (Path/expand "bin/bl" (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd)))
                       (list "--cold" "run" consumer)
                       (list (tuple :stderr_to_stdout true)
                             (tuple :env (list (tuple "BL_DAEMON" "off") (tuple "BEAM_LISP_AOT_REPAIR" "off")))))]
    (is (= 0 status) text)
    (is (String/contains? text "FACADE_ARTIFACT_OK") text))
   (finally (BeamLisp.Env/destroy environment) (File/rm_rf! root)))))
