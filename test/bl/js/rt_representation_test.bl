(ns js.rt-representation-test
  "PLAN-163 structural fix 4. core.bl and rt.bl compile to EVERY target (the
   BEAM and, with `bl js build --self-host`, JavaScript). A host value's kind
   is read through the struct protocol (`:__struct__`, which each target
   answers for its own classes). Its FIELDS are not: a vector's `:items`
   tuple or `:bl_vec` trie, a Reduced's `:value`, a Decimal's
   `:unscaled`/`:scale` are the BEAM layout, and JS values do not have them
   (U2 found 14 functions reading them).

   This test scans the two sources for every field read or build on a map
   and allows it only inside a function listed here, with the reason it may
   touch that layout. A new site fails the test. Move it behind the owning
   host module (BeamLisp.Vector/…, BeamLisp.Decimal/…) or list it here,
   with a JS-side answer."
  (:require [bl.test :refer [deftest is]]))

(def ^:private allowed
  "{fn-name → [#{field …} reason]}."
  {"carries-meta?"  [#{:meta :items} "BEAM vector fast path, guarded by (is_map_key :items x); JS vectors take the Vector/to_list branch"]
   "hash-hash-key"  [#{:meta :items} "BEAM vector fast path, guarded by (is_map_key :items x); JS vectors are rebuilt via Vector/new"]
   "reduce-vector"  [#{:items}       "in-place walk of the BEAM dense tuple / :bl_vec trie, guarded by (is_map_key :items v)"]
   "unwrap"         [#{:value}       "Reduced is a by-hand map {:__struct__ Reduced :value v} on BOTH targets (reduce-reduced builds it)"]
   "reduce-reduced" [#{:value}       "builds that by-hand map; JS reads it as a plain HMap"]})

(def ^:private field-re
  #"(?:erlang/map_get|maps/get|maps/put|erlang/is_map_key|maps/remove) :\"?([a-z_][a-z_0-9]*)\"?")

(defn- sites
  "[file fn field] for every field access in `path` other than :__struct__,
   attributed to the enclosing top-level defn."
  [path]
  (loop [lines (split (File/read! path) "\n") fname nil acc []]
    (if (empty? lines)
      acc
      (let [line (first lines)
            fname (if-let [[_ n] (re-find #"^\(defn-? ([^ \[]+)" line)] n fname)
            code (first (split line ";"))
            hits (keep (fn [[_ f]] (when (not= f "__struct__") [path fname (keyword f)]))
                       (re-seq field-re code))]
        (recur (rest lines) fname (into acc hits))))))

(deftest core-and-rt-read-struct-fields-only-through-allowed-functions
  (let [all (concat (sites "priv/boot/rt.bl") (sites "priv/boot/core.bl"))
        bad (remove (fn [[_ f field]] (contains? (first (get allowed f [#{}])) field)) all)]
    (is (< 0 (count all)) "the scan finds the known sites (it is not vacuous)")
    (is (empty? bad)
        (str "struct fields read outside an allowed function — move them behind the owning host module:\n"
             (join "\n" (map (fn [[p f field]] (str "  " p " " f " " field)) bad))))))

(deftest every-allowance-is-still-used
  (let [used (set (map second (concat (sites "priv/boot/rt.bl") (sites "priv/boot/core.bl"))))]
    (doseq [f (keys allowed)]
      (is (contains? used f) (str f " no longer reads struct fields: drop its allowance")))))
