; test/bl/seed_trace_abi_test.bl — test.seed-trace-abi.
;
; Split from test/bl/seed_test.bl so each file stays under the runner's 300 s
; per-file bound. Shared helpers live in test.bl.seed-support.

(ns test.seed-trace-abi
  (:require [seed] [test.bl.seed-support :as s]))

(deftest the-trace-publishes-its-bounded-tracing-surface
  ;; `Elixir.BeamLisp.Trace` is the pinned module `rt.bl`'s `trace`/`untrace`
  ;; rows bind by name: it exposes the BEAM's `:dbg` as data, tracing ONE named
  ;; function at a time and delivering `{:trace pid :call {mod fun args}}` events
  ;; to a handler. The mapping is functions-only — no `:struct-fields`, no
  ;; `:behaviour`, no `:macro-exports` — so the published beam exports exactly
  ;; `trace/3`, `trace/4` and `untrace/2`, every private helper a local closure.
  ;; Judged from the beam's own export chunk, from the REAL source, so the
  ;; assertion cannot drift from the file the seed compiles.
  (let [root (BeamLisp/cwd)
        ebin (Path/join root "build")
        out (s/scratch "trace-out")
        real {"Elixir.BeamLisp.Trace" (Path/join root "priv/host/trace.bl")}
        hd (s/host-scratch "trace-src" "" real)
        r (s/seed-run! {:root root :out out :ebin ebin :host hd})]
    (is (:ok? r) (str "the floor is generated: " (pr-str (:errors r))))
    (let [beam (Path/join out "Elixir.BeamLisp.Trace.beam")
          exports (s/beam-exports beam)]
      (is (File/exists? beam) "Trace is COMPILED into the floor")
      (doseq [f [["trace" 3] ["trace" 4] ["untrace" 2]]]
        (is (s/has? exports (tuple (String/to_atom (first f)) (second f)))
            (str "Trace exposes " (first f) "/" (second f))))
      (is (= (list (tuple :module_info 0) (tuple :module_info 1)
                   (tuple :trace 3) (tuple :trace 4) (tuple :untrace 2))
             (Enum/sort exports))
          "the published Trace beam exports exactly trace/3, trace/4 and untrace/2 — every helper is a local closure")
      (is (not (s/has? exports (tuple :__struct__ 0)))
          "Trace is functions-only: the published beam carries no struct surface")
      (is (not (s/has? exports (tuple :__info__ 1)))
          "Trace is functions-only: the published beam carries no Elixir __info__/1"))
    (File/rm_rf! out)
    (File/rm_rf! hd)))

(deftest the-anf-interpreter-publishes-its-oracle-abi
  ;; `Elixir.BeamLisp.AnfInterpreter` is the test-only raise model
  ;; `priv/self/anf.bl`'s reference interpreter runs every canonical `:try`
  ;; through: `capture/1` invokes a thunk with no arguments and answers a
  ;; `{:ok value}` or a `{:raised kind reason {:interpreted_trace frames}}` — the
  ;; raw Erlang catch class, the RAW reason and the frame list — and `reraise/3`
  ;; re-raises such a tagged trace through the real `erlang:raise/3` BIF. The
  ;; mapping is functions-only — no `:struct-fields`, no `:behaviour`, no
  ;; `:macro-exports` — so the published beam's export list is the oracle ABI
  ;; EXACTLY: those TWO functions, no helper, no struct surface, no Elixir
  ;; `__info__/1`. Judged from the beam's own export chunk, from the REAL source,
  ;; so the assertion cannot drift from the file the seed compiles.
  (let [root (BeamLisp/cwd)
        ebin (Path/join root "build")
        out (s/scratch "anf-interpreter-out")
        real {"Elixir.BeamLisp.AnfInterpreter" (Path/join root "priv/host/anf_interpreter.bl")}
        hd (s/host-scratch "anf-interpreter-src" "" real)
        r (s/seed-run! {:root root :out out :ebin ebin :host hd})]
    (is (:ok? r) (str "the floor is generated: " (pr-str (:errors r))))
    (let [beam (Path/join out "Elixir.BeamLisp.AnfInterpreter.beam")
          exports (s/beam-exports beam)]
      (is (File/exists? beam) "AnfInterpreter is COMPILED into the floor")
      (is (= (list (tuple :capture 1) (tuple :module_info 0) (tuple :module_info 1)
                   (tuple :reraise 3))
             (Enum/sort exports))
          "the published AnfInterpreter beam exports exactly capture/1 and reraise/3 — the oracle ABI, every helper a local closure")
      (is (s/has? exports (tuple :reraise 3))
          "AnfInterpreter exposes reraise/3, the tagged trace's way back to a real erlang:raise/3")
      (is (not (s/has? exports (tuple :__struct__ 0)))
          "AnfInterpreter is functions-only: the published beam carries no struct surface")
      (is (not (s/has? exports (tuple :__info__ 1)))
          "AnfInterpreter is functions-only: the published beam carries no Elixir __info__/1"))
    (File/rm_rf! out)
    (File/rm_rf! hd)))
