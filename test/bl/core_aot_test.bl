; core_aot_test.bl — Core Erlang → .beam on disk (PLAN-079 S-D.aot).
;
; The AOT edge: a namespace's defns, built by the Core backend, compile to a
; .beam BINARY, persist to disk, and load + run correctly in the SAME VM — with
; NO Elixir compiler on that path (compile:forms [from_core]). And the persisted
; beam is byte-reproducible: a rebuild of the same source is the same bytes. This
; is what a committed Core boot SEED (S-SEED) is made of.

(ns core-aot.test
  (:require [lower :as sc] [anf :as a]))

(defn- dclause [fname params guard body ann]
  {:op :defn-clause :fname fname :params params :guard guard :body body :ann ann})

(deftest core-beam-loads-and-runs
  (testing "a Core-compiled namespace beam persists, loads, and runs"
    (let [dir (str (System/tmp_dir!) "/bl_core_aot_" (erlang/unique_integer (list :positive)))
          desc (a/module :bl_ca_body
                 [(dclause :ca-cube [(a/pvar "n")] nil
                    (a/remote :erlang :* [(a/var "n") (a/remote :erlang :* [(a/var "n") (a/var "n")])]) {})]
                 [[:ca-cube 1]]
                 [])
          built (sc/descriptor->beam desc)
          module (elem built 0)
          beam (elem built 1)
          path (sc/write-beam! dir module beam)]
      ; load the on-disk beam fresh and call it
      (code/load_binary module (erlang/binary_to_list path) (File/read! path))
      (is (= 27 (erlang/apply module :ca-cube (list 3))))
      (is (erlang/is_binary beam))
      (File/rm_rf! dir))))

(deftest core-beam-is-reproducible
  (testing "two Core AOT builds of the same source emit byte-identical beams"
    (let [desc (a/module :bl_ca_rep
                 [(dclause :ca-add [(a/pvar "a") (a/pvar "b")] nil
                    (a/remote :erlang :+ [(a/var "a") (a/var "b")]) {})
                  (dclause :ca-add [(a/pvar "a") (a/pvar "b") (a/pvar "c")] nil
                    (a/remote :erlang :+ [(a/var "a") (a/remote :erlang :+ [(a/var "b") (a/var "c")])]) {})]
                 [[:ca-add 2] [:ca-add 3]]
                 [])
          b1 (elem (sc/descriptor->beam desc) 1)
          b2 (elem (sc/descriptor->beam desc) 1)]
      (is (= b1 b2)))))

(defn- complete-descriptor []
  (a/module :bl_descriptor_probe
    [(dclause :choose [(a/pvar "x")] (a/remote :erlang :> [(a/var "x") (a/lit 0)]) (a/lit :positive) {:file "descriptor.bl" :line 3})
     (dclause :choose [(a/pvar "_")] nil (a/lit :other) {:file "descriptor.bl" :line 4})
     (dclause :__bl_init__ [] nil (a/lit :initialized) {:file "descriptor.bl" :line 6})
     (dclause :__bl_provenance__ [] nil (a/lit {:source "demo.bl" :digest {:sha 1}}) {:file "descriptor.bl" :line 7})]
    [[:choose 1] [:__bl_init__ 0] [:__bl_provenance__ 0]]
    [[:behaviour :bl_descriptor_behaviour] [:bl_freshness {:compiler-key "test"}]]
    {:file "descriptor.bl"}))

(deftest complete-module-descriptor-loads
  (testing "guarded clauses, explicit init/provenance, attrs, and module_info"
    (let [d (complete-descriptor) built (sc/descriptor->beam d)
          mod (elem built 0) beam (elem built 1)]
      (code/load_binary mod (erlang/binary_to_list "descriptor.core") beam)
      (is (= :positive (erlang/apply mod :choose (list 2))))
      (is (= :other (erlang/apply mod :choose (list -1))))
      (is (= :initialized (erlang/apply mod :__bl_init__ (list))))
      (is (= {:source "demo.bl" :digest {:sha 1}} (erlang/apply mod :__bl_provenance__ (list))))
      (is (some (fn [e] (= :bl_freshness (elem e 0))) (erlang/apply mod :module_info (list :attributes)))))))

(deftest descriptor-boundary-rejects-malformed-input
  (testing "schema, quoted payload, exports, reserved names, and paths"
    (let [d (complete-descriptor)]
      (is (thrown-with-msg? "$.version" (a/validate-module! (assoc d :version 2))))
      (is (thrown-with-msg? "$.clauses[0].body" (a/validate-module! (assoc d :clauses (cons (assoc (first (:clauses d)) :body (tuple :quoted [] [])) (rest (:clauses d)))))))
      (is (thrown-with-msg? "export has no matching clause" (a/validate-module! (assoc d :exports (list [:missing 0])))))
      (is (thrown-with-msg? "reserved compiler function" (a/module :bad [(dclause :module_info [] nil (a/lit nil) {})] [] []))))))

(deftest descriptor-rejects-live-runtime-values
  (testing "thunks and resource identities never become Core literals"
    (is (thrown-with-msg? "literal" (a/module :bad_literal [(dclause :f [] nil (a/lit (fn [] :effect)) {})] [[:f 0]] [])))
    (is (thrown-with-msg? "literal" (a/module :bad_reference [(dclause :f [] nil (a/lit (erlang/make_ref)) {})] [[:f 0]] [])))))

(deftest descriptor-emission-is-byte-deterministic
  (let [d (complete-descriptor)
        b1 (elem (sc/descriptor->beam d) 1)
        b2 (elem (sc/descriptor->beam d) 1)]
    (is (= b1 b2))
    (is (< 0 (erlang/byte_size b1)))))

(run-tests)
