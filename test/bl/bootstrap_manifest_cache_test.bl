(ns bootstrap-manifest-cache-test)

(deftest manifest-parsing-is-reused-only-for-identical-current-bytes
  (let [path (str (System/tmp_dir!) "/bl-manifest-cache-" (erlang/unique_integer (list :positive)))
        trace (tuple :Elixir.BeamLisp.Bootstrap :read_manifest_uncached! 2)]
    (try
      (File/write! path "#{version => 1}.")
      (erlang/trace_pattern trace true (list :local :call_count))
      (is (= {:version 1} (BeamLisp.Bootstrap/read_manifest! path)))
      (doseq [_ (range 20)]
        (is (= {:version 1} (BeamLisp.Bootstrap/read_manifest! path))))
      (is (= (tuple :call_count 1) (erlang/trace_info trace :call_count)))
      (let [before (File/stat! path)]
        (File/write! path "#{version => 2}.")
        (File/touch! path (:mtime before))
        (is (= {:version 2} (BeamLisp.Bootstrap/read_manifest! path)))
        (is (= (tuple :call_count 2) (erlang/trace_info trace :call_count))))
      (File/write! path "this is malformed")
      (is (= :refused (try (BeamLisp.Bootstrap/read_manifest! path) :accepted (catch _ :refused))))
      (File/rm! path)
      (is (= :refused (try (BeamLisp.Bootstrap/read_manifest! path) :accepted (catch _ :refused))))
      (finally
        (erlang/trace_pattern trace false (list :local :call_count))
        (File/rm path)))))
