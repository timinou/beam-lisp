(ns loader.timing-test (:require [diagnostics :as diag] [interop]))

(deftest loader-worker-costs-carry-request-context-and-restore-worker-scope
 (let [dir (str (System/tmp_dir!) "/loader-timing-" (erlang/unique_integer (list :positive)))
       source (str (BeamLisp/cwd) "/priv/host/loader.bl")
       probe :Elixir.BeamLisp.LoaderTimingProbe
       _ (File/mkdir_p! dir)
       beam (BeamLisp.AOT/compile_host_file source
              (list (tuple :module probe) (tuple :output_dir dir) (tuple :file source)
                    (tuple :source_hash (crypto/hash :sha256 (File/read! source)))
                    (tuple :load? false)))
       _ (code/load_binary probe (erlang/binary_to_list (elem beam 1)) (File/read! (elem beam 1)))
       records (atom [])
       before (BeamLisp.Loader.Server/run (fn [] (erlang/get :bl_diagnostics)))
       before-ns (BeamLisp.Loader.Server/run (fn [] (Process/get :bl_loader_timing_ns)))
       worker-env (BeamLisp.Loader.Server/run (fn [] (BeamLisp.Env/env_id)))]
  (try
   (File/mkdir_p! (str dir "/loader/timing"))
   (File/write! (str dir "/loader/timing/owned_fixture.bl")
                "(ns loader.timing.owned-fixture) (defn answer [] 42)")
   (diag/with-options {:sink (fn [event] (swap! records conj event))}
    (diag/with-context {:diagnostics/operation-id "loader-request"}
     (is (= :ok (erlang/apply probe :with_ambient_dirs
                   (list (list dir) (fn [] (erlang/apply probe :ensure_loaded (list "loader.timing.owned-fixture")))))))
     (is (= 42 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! "loader.timing.owned-fixture" "answer") (list))))
     (is (= :caught (try (erlang/apply probe :ensure_loaded (list "loader.timing.missing.fixture"))
                        (catch _ :caught))))
     (is (= "loader-request" (:diagnostics/operation-id (diag/context))))))
   (let [phases (filter (fn [event] (= :runtime.phase/completed (:diagnostics/event event))) @records)]
    (is (contains? (set (map :runtime.phase/name phases)) :loader-worker))
    (is (contains? (set (map :runtime.phase/name phases)) :loader-wait))
    (is (contains? (set (map :runtime.phase/namespace phases)) "loader.timing.owned-fixture"))
    (is (contains? (set (map :runtime.phase/namespace phases)) "loader.timing.missing.fixture"))
    (doseq [event phases]
     (is (= "loader-request" (:diagnostics/operation-id event)))
     (is (string? (:runtime.phase/namespace event)))
     (is (>= (:runtime.phase/duration-us event) 0))
     (is (>= (:runtime.phase/reductions event) 0))
     (println "navigation-phase" (interop/->json event))))
   (is (= before (BeamLisp.Loader.Server/run (fn [] (erlang/get :bl_diagnostics)))))
   (is (= worker-env (BeamLisp.Loader.Server/run (fn [] (BeamLisp.Env/env_id)))))
   (is (= before-ns (BeamLisp.Loader.Server/run (fn [] (Process/get :bl_loader_timing_ns)))))
   (is (= nil (Process/get :bl_loader_timing_ns)))
   (diag/with-options {:sink nil} (is (= nil (diag/timing-hook))))
   (let [original (BeamLisp.Env/fetch! "diagnostics" "timing-hook")
         calls (atom 0)
         missing (fn [] (try (erlang/apply probe :ensure_loaded (list "loader.timing.recursion.fixture"))
                            (catch _ :missing)))]
    (try
     (BeamLisp.Env/intern "diagnostics" "timing-hook"
       (fn []
        (swap! calls inc)
        ;; Simulate an AOT callback whose deferred dependencies enter Loader.
        (missing)
        (fn [_ f] (f))))
     (diag/with-options {:sink nil}
      (is (= :missing (missing)))
      (is (= 0 @calls) "disabled telemetry must never invoke optional code"))
     (diag/with-options {:sink (fn [_] nil)}
      (is (= :missing (missing)))
      (is (= 1 @calls) "deferred callback initialization cannot recursively discover itself"))
     (is (= nil (Process/get :bl_loader_timing_active)))
     (finally (BeamLisp.Env/intern "diagnostics" "timing-hook" original))))
   (let [token (BeamLisp.Env/capture) global-records (atom [])
         provider (BeamLisp.Env/fetch! "diagnostics" "timing-hook")
         root-provider (atom nil) root-calls (atom 0)]
    (try
     ;; diagnostics keys the absent root scope by :undefined, not :global.
     (Process/delete :bl_env)
     (Process/delete :bl_env_chain)
     (reset! root-provider (BeamLisp.Env/lookup (tuple "diagnostics" "timing-hook")))
     (BeamLisp.Env/intern "diagnostics" "timing-hook" (fn [] (swap! root-calls inc) (provider)))
     (diag/with-options {:sink (fn [event] (swap! global-records conj event))}
      (diag/with-context {:diagnostics/operation-id "unbound-root"}
       (is (= :missing (try (erlang/apply probe :ensure_loaded (list "loader.timing.unbound.missing"))
                            (catch _ :missing))))))
     (println "loader-unbound-probe" {:calls @root-calls :records (count @global-records)
                                      :operations (mapv :diagnostics/operation-id @global-records)})
     (is (some (fn [event] (= "unbound-root" (:diagnostics/operation-id event))) @global-records))
     (finally
      (if (= :error @root-provider)
        (BeamLisp.Env/delete_key (tuple "diagnostics" "timing-hook"))
        (when (and (tuple? @root-provider) (= :ok (elem @root-provider 0)))
          (BeamLisp.Env/intern "diagnostics" "timing-hook" (elem @root-provider 1))))
      (BeamLisp.Env/bind token))))
   (finally (code/soft_purge probe) (code/delete probe) (File/rm_rf! dir)))))
