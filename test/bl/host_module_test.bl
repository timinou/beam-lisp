; host_module_test.bl — pinned host-module emission: the exact-name host ABI.
;
; `BeamLisp.AOT/compile_host_file` compiles ONE `.bl` file into ONE beam at a
; caller-given EXACT module atom, carrying the file's `defn`s as plain exported
; functions. That is how a `.bl` port can stand in for an existing
; `Elixir.BeamLisp.X` host module — same name, same call surface, no Ns shim
; between the caller and the code — while the ordinary `BeamLisp.Ns.*`
; namespace compilation stays exactly as it is.

(ns host-module.test)

(defn- tmp-dir []
  (str (System/tmp_dir!) "/bl_host_module_" (erlang/unique_integer (list :positive))))

(defn- write-source!
  "Write a fixture .bl file; return its path."
  [dir text]
  (File/mkdir_p! dir)
  (let [p (str dir "/host_probe.bl")]
    (File/write! p text)
    p))

(defn- opts [module out]
  (list (erlang/list_to_tuple (list :module module))
        (erlang/list_to_tuple (list :output_dir out))))

(defn- three-defns []
  (str "(ns host.probe)\n"
       "(defn probe-add [a b] (+ a b))\n"
       "(defn probe-mul [a b] (* a b))\n"
       "(defn probe-triple [a] (probe-add a (probe-add a a)))\n"))

(deftest emits-the-exact-atom-and-runs-in-fresh-state
  (testing "one .bl file → one beam at the caller's exact atom, self-contained"
    (let [dir (tmp-dir)
          src (write-source! dir (three-defns))
          out (str dir "/out")
          result (BeamLisp.AOT/compile_host_file src (opts :Elixir.BeamLisp.HostProbe out))
          mod (elem result 0)
          path (elem result 1)
          beam (File/read! path)]
      (is (= :Elixir.BeamLisp.HostProbe mod))
      (is (= (str out "/Elixir.BeamLisp.HostProbe.beam") path))
      (is (File/exists? path))
      ; The ordinary namespace compile still ran: its shim is loaded beside the
      ; pinned module. `compile_host_file` ADDS a beam; it replaces nothing.
      (is (= :module (elem (erlang/apply :code :ensure_loaded
                                (list :Elixir.BeamLisp.Ns.Host.Probe)) 0)))
      ; FRESH STATE. Drop the pinned module AND the namespace shim the compiler
      ; loaded, then load the PINNED BEAM alone and call it. `probe-triple`
      ; calls a sibling, so this only works if that call was re-pointed at the
      ; pinned atom — a leftover shim reference would be `undef` here.
      (code/purge mod)
      (code/delete mod)
      (code/purge :Elixir.BeamLisp.Ns.Host.Probe)
      (code/delete :Elixir.BeamLisp.Ns.Host.Probe)
      (code/load_binary mod (erlang/binary_to_list path) (File/read! path))
      ; A beam-lisp fn name IS its atom, hyphen and all (`probe-add`), exactly
      ; as the namespace shim exports it — the pinned module reuses that surface.
      (is (= 5 (erlang/apply mod :probe-add (list 2 3))))
      (is (= 6 (erlang/apply mod :probe-mul (list 2 3))))
      (is (= 6 (erlang/apply mod :probe-triple (list 2))))
      ; REPRODUCIBLE: a rebuild of the same source is the same bytes, so a host
      ; beam can be committed into the seed and re-derived (PLAN-150 W0).
      (is (= beam
             (File/read!
               (elem (BeamLisp.AOT/compile_host_file src (opts :Elixir.BeamLisp.HostProbe out)) 1))))
      ; A `-behaviour` attribute rides through to the emitted module — what an
      ; OTP callback module (a ported `use GenServer`-style host module) needs.
      (let [res (BeamLisp.AOT/compile_host_file src
                  (list (erlang/list_to_tuple (list :module :Elixir.BeamLisp.HostProbeB))
                        (erlang/list_to_tuple (list :output_dir out))
                        (erlang/list_to_tuple (list :behaviour :gen_server))))
            bmod (elem res 0)]
        (is (some (fn [a] (= :behaviour (elem a 0)))
                  (erlang/apply bmod :module_info (list :attributes)))))
      (File/rm_rf! dir))))

(deftest refuses-invalid-module-names
  (testing "non-atom, reserved, and namespace-scheme names are refused"
    (let [dir (tmp-dir)
          src (write-source! dir (three-defns))
          out (str dir "/out")]
      (is (thrown? (BeamLisp.AOT/compile_host_file src (opts "Elixir.BeamLisp.HostProbe" out))))
      (is (thrown? (BeamLisp.AOT/compile_host_file src (opts :nil out))))
      (is (thrown? (BeamLisp.AOT/compile_host_file src (opts :Elixir.BeamLisp.Ns.Clash out))))
      (File/rm_rf! dir))))

(deftest refuses-a-file-with-no-functions
  (testing "a source with no top-level defn has nothing to pin"
    (let [dir (tmp-dir)
          src (write-source! dir "(ns host.empty)\n")
          out (str dir "/out")]
      (is (thrown? (BeamLisp.AOT/compile_host_file src (opts :Elixir.BeamLisp.EmptyProbe out))))
      (File/rm_rf! dir))))

(deftest refuses-value-definitions
  (testing "a pinned module is functions only; a `def` value is an explicit gap"
    (let [dir (tmp-dir)
          src (write-source! dir
                (str "(ns host.vals)\n"
                     "(def limit 10)\n"
                     "(defn read-limit [] limit)\n"))
          out (str dir "/out")]
      (is (thrown? (BeamLisp.AOT/compile_host_file src (opts :Elixir.BeamLisp.ValsProbe out))))
      (File/rm_rf! dir))))

(deftest load-false-writes-the-beam-without-publishing-it
  (testing "a generator can emit a pinned beam for the NEXT boot, not this VM"
    (let [dir (tmp-dir)
          src (write-source! dir (three-defns))
          out (str dir "/out")
          mod :Elixir.BeamLisp.HostQuiet
          result (BeamLisp.AOT/compile_host_file src
                   (list (erlang/list_to_tuple (list :module mod))
                         (erlang/list_to_tuple (list :output_dir out))
                         (erlang/list_to_tuple (list :load? false))))
          path (elem result 1)]
      (is (File/exists? path) "the beam is still written — that is the artifact")
      (is (= :non_existing (erlang/apply :code :which (list mod)))
          "`load? false` must not load the module: a pinned leaf may be a LIVE module in the compiling VM")
      ; it is a complete beam, loadable by the VM that wants it
      (code/load_binary mod (erlang/binary_to_list path) (File/read! path))
      (is (= 5 (erlang/apply mod :probe-add (list 2 3))))
      (code/purge mod)
      (code/delete mod)
      (File/rm_rf! dir))))

; ── the first production host leaf: CompilerData ───────────────────────────
;
; `priv/host/compiler_data.bl` is compiled to the exact atom the compiler already
; calls (`Elixir.BeamLisp.CompilerData`) and committed in the bootstrap seed. The
; tests below pin the two things that make it a replacement rather than a copy:
; its answers are the pinned answers, and the beam it emits answers the committed
; floor beam over a corpus, answer for answer. There is no legacy Elixir module
; to diff against any more — the corpus is compared to the SEED artifact.
; (Whether the floor was built from the CURRENT source is `bl seed --check`'s
; question, judged on `bl_source_hash`; these tests judge the emitted ABI.)

(defn- compiler-data-source []
  (Path/join (BeamLisp/cwd) "priv/host/compiler_data.bl"))

(defn- compiler-data-seed []
  (Path/join (BeamLisp/cwd) "priv/bootstrap/seed/Elixir.BeamLisp.CompilerData.beam"))

(defn- improper-list []
  ;; [1 | :tail] — the one shape `is_list/1` accepts and `length/1` refuses.
  ;; Built from its external term format because the shape has no constructor.
  (erlang/binary_to_term
    (erlang/list_to_binary (list 131 108 0 0 0 1 97 1 119 4 116 97 105 108))))

(defn- t [k v] (erlang/list_to_tuple (list k v)))

(defn- answer
  "The whole answer of `mod` applied to `name`/`args`, normalized so a raise is
   a value too: `[:value v]` or `[:raise Class message]`. Lets a corpus compare
   calls that may or may not raise, CLASS included."
  [mod name args]
  (try [:value (erlang/apply mod name args)]
       (catch e [:raise (:__struct__ e) (ex-message e)])))

(defn- same-answer? [a b name args]
  (= (answer a name args) (answer b name args)))

(def corpus
  "The ABI corpus: nil, a proper list, a vector, a raw map, and an improper list
   (a refusal); every eager traversal at every arity; callbacks that are real
   callables. Compared question for question, never as a single number."
  (list
    (list :eager_to_list (list nil))
    (list :eager_to_list (list (list 1 2 3)))
    (list :eager_to_list (list (BeamLisp.Vector/new (list 1 2 3))))
    (list :eager_to_list (list {:a 1}))
    (list :eager_to_list (list (improper-list)))
    (list :eager_map (list (fn [x] (* x 2)) (BeamLisp.Vector/new (list 1 2))))
    (list :eager_map (list (fn [a b] (+ a b)) (list 1 2) (list 10)))
    (list :eager_filter (list (fn [x] x) (list false nil 0 :ok)))
    (list :eager_concat (list (list nil (list 1) (BeamLisp.Vector/new (list 2 3)) (list))))
    (list :eager_mapcat (list (fn [x] (list x (+ x 1))) (list 1 3)))
    (list :eager_map_indexed (list (fn [i x] (erlang/list_to_tuple (list i x))) (list :a :b)))
    (list :eager_sort_by (list (fn [x] (rem x 2)) (list 3 1 4 2 5)))
    (list :eager_group_by (list (fn [x] (rem x 2)) (list 3 1 2 4)))
    (list :eager_distinct (list (list 2 1 2 3 1)))
    (list :eager_range (list 3))
    (list :eager_range (list 2 4))
    (list :eager_range (list 4 2))))

(deftest the-pinned-compiler-data-answers-with-the-pinned-abi
  (testing "a fresh compile of the pinned source answers the corpus as pinned"
    (let [dir (tmp-dir)
          out (str dir "/out")
          probe :Elixir.BeamLisp.HostCompilerDataProbe
          path (elem (BeamLisp.AOT/compile_host_file (compiler-data-source)
                        (list (t :module probe) (t :output_dir out) (t :load? false)))
                     1)]
      (code/purge probe)
      (code/delete probe)
      (code/load_binary probe (erlang/binary_to_list path) (File/read! path))

      (is (= (list 2 4)
             (erlang/apply probe :eager_map
               (list (fn [x] (* x 2)) (BeamLisp.Vector/new (list 1 2))))))
      (is (= (list 11)
             (erlang/apply probe :eager_map (list (fn [a b] (+ a b)) (list 1 2) (list 10)))))
      (is (= (list) (erlang/apply probe :eager_map (list (fn [x] x) nil))))
      (is (= (list (BeamLisp.Vector/new (list :a 1)))
             (erlang/apply probe :eager_to_list (list {:a 1}))))
      (is (= (list (erlang/list_to_tuple (list 0 :a)) (erlang/list_to_tuple (list 1 :b)))
             (erlang/apply probe :eager_map_indexed
               (list (fn [i x] (erlang/list_to_tuple (list i x))) (list :a :b)))))
      (is (= (list 0 :ok)
             (erlang/apply probe :eager_filter (list (fn [x] x) (list false nil 0 :ok)))))
      (is (= (list 1 2 3)
             (erlang/apply probe :eager_concat
               (list (list nil (list 1) (BeamLisp.Vector/new (list 2 3)) (list))))))
      (is (= (list 1 2 3 4)
             (erlang/apply probe :eager_mapcat (list (fn [x] (list x (+ x 1))) (list 1 3)))))
      (is (= (list 4 2 3 1 5)
             (erlang/apply probe :eager_sort_by (list (fn [x] (rem x 2)) (list 3 1 4 2 5)))))
      (is (= {0 (list 2 4) 1 (list 3 1)}
             (erlang/apply probe :eager_group_by (list (fn [x] (rem x 2)) (list 3 1 2 4)))))
      (is (= (list 2 1 3) (erlang/apply probe :eager_distinct (list (list 2 1 2 3 1)))))
      (is (= (list 0 1 2) (erlang/apply probe :eager_range (list 3))))
      (is (= (list 2 3) (erlang/apply probe :eager_range (list 2 4))))
      (is (= (list) (erlang/apply probe :eager_range (list 4 2))))

      ; THE CLASS IS PART OF THE ABI: a caller's `rescue`/`catch` names it.
      (is (try (erlang/apply probe :eager_to_list (list (improper-list)))
               false
               (catch ArgumentError e (includes? (ex-message e) "finite data"))
               (catch e false))
          "malformed input is refused with ArgumentError, as the compiler expects")
      (is (try (erlang/apply probe :eager_filter (list (fn [x] x) (improper-list)))
               false
               (catch ArgumentError e true)
               (catch e false))
          "the refusal reaches every traversal, not just eager_to_list")

      (code/purge probe)
      (code/delete probe)
      (File/rm_rf! dir))))

(deftest the-pinned-compiler-data-is-the-committed-seed-for-a-corpus
  (testing "the freshly compiled probe answers the corpus as the committed floor beam does"
    (let [dir (tmp-dir)
          src (compiler-data-source)
          seed (compiler-data-seed)
          probe :Elixir.BeamLisp.HostCompilerDataProbe
          probe-path (elem (BeamLisp.AOT/compile_host_file src
                          (list (t :module probe) (t :output_dir (str dir "/probe")) (t :load? false)))
                       1)]
      (code/purge probe)
      (code/delete probe)
      (code/load_binary probe (erlang/binary_to_list probe-path) (File/read! probe-path))

      ; ANSWER FOR ANSWER against the COMMITTED seed — loaded here under its real
      ; atom, so the comparison is against the artifact and never against a copy
      ; the build VM happened to boot with. (That the floor was built from THIS
      ; source is `bl seed --check`'s question, judged on `bl_source_hash`;
      ; these tests judge the ABI the source emits.)
      (code/purge :Elixir.BeamLisp.CompilerData)
      (code/delete :Elixir.BeamLisp.CompilerData)
      (code/load_binary :Elixir.BeamLisp.CompilerData
        (erlang/binary_to_list seed) (File/read! seed))
      (is (every? (fn [q] (same-answer? probe :Elixir.BeamLisp.CompilerData
                                         (first q) (second q)))
                  corpus)
          "the freshly compiled probe answers the corpus exactly as the committed seed does")
      (File/rm_rf! dir))))
