; Builds and exercises the self-hosted JS language, separately from static tests.
; Run: BL_TEST_TIMEOUT=1200 bin/bl test test/bl/js_native_live_test.bl
(ns bl.js.native-live-test (:require [bl.js :as js]))

(deftest native-live-compiler
  (let [out (str (System/tmp_dir!) "/bl-native-live-" (System/unique_integer (list :positive)))]
    (try
      (js/build! "js.eval" {:paths (list "priv/lib" "priv/boot") :out out
                            :stub "lower" :with "reader" :host "run"})
      (let [r (System/cmd "node" (list "test/js/native-live.mjs" out (File/cwd!)))]
        (is (= 0 (erlang/element 2 r)) (erlang/element 1 r)))
      (finally (File/rm_rf! out)))))
