; aot_tier_key_test.bl — the two toolchain keys and the tier→key routing, pinned.
;
; Ported from the ExUnit `test/beam_lisp/aot_tier_key_test.exs`. The suite asked
; `BeamLisp.AOTCache` directly then and does so now — there was no build shell in
; the path to remove — so the port is a transliteration plus two additions the
; suite never had and the pinned host now makes checkable at the same call
; surface:
;
;   · EXPLICIT STAGED ROOTS — `key_for_source/2` takes the priv the question is
;     about; a self-build runs over a STAGED copy of the payload's priv so the
;     paths baked into beams are stable generation to generation. Without that
;     root every staged source would read as ordinary and the driver's beams
;     would lose the tier key the drift gate depends on.
;
;   · SYMLINK IDENTITY — the launcher builds `beam_lisp-<vsn>/{ebin,priv}` with
;     `priv` a SYMLINK to the tree's `priv` (measured: that is this VM's own
;     `Tiers.priv_root/0`). A path THROUGH the link must classify by the inode it
;     points at, not by a string prefix, or a released image's toolchain sources
;     would lose their tier.
;
; Tier classification is asked of the RUNTIME host — `BeamLisp.Tiers`, a pinned
; BL leaf since `lib/beam_lisp/tiers.ex` was removed — never of a source path.
; `key_for_ns/1` and `key_for_source/1,2` route through it, so the key these
; tests read IS the tier the running tree computes.
;
; W1: the toolchain has TWO keys, and the split is what stops a build-tool edit
; from invalidating every beam in the tree. Codegen (`priv/boot/`) hashes into
; `compiler_key/0`; the build driver (`priv/build/`) into `build_key/0`, which
; folds `compiler_key/0` in because the driver is compiled BY the codegen.
; Before the split, `compiler_key/0` hashed the whole of `priv/boot/` — the
; driver included — so editing `build.bl` moved the toolchain key and rebuilt
; ~300 beams. Measured cost of that amplifier: 8 key generations in ~21h.
;
; Run: bl test test/bl/aot_tier_key_test.bl

(ns aot-tier-key.test)

; ── the two key classes ─────────────────────────────────────────────────────

(deftest the-two-tier-keys-exist-differ-and-are-stable-across-a-recompute
  (BeamLisp.AOTCache/reset_keys)
  (let [compiler (BeamLisp.AOTCache/compiler_key)
        build (BeamLisp.AOTCache/build_key)]
    (is (string? compiler))
    (is (= 64 (erlang/byte_size compiler)))
    (is (string? build))
    (is (= 64 (erlang/byte_size build)))
    (is (not= build compiler))
    ; Recomputing from the same tree yields the same keys: a key is a function
    ; of the bytes, never of time.
    (BeamLisp.AOTCache/reset_keys)
    (is (= compiler (BeamLisp.AOTCache/compiler_key)))
    (is (= build (BeamLisp.AOTCache/build_key)))))

(deftest a-namespaces-stamp-key-is-its-tiers-key
  (let [compiler (BeamLisp.AOTCache/compiler_key)
        build (BeamLisp.AOTCache/build_key)]
    (is (= compiler (BeamLisp.AOTCache/key_for_ns "compiler")))
    (is (= compiler (BeamLisp.AOTCache/key_for_ns "reader-node")))
    (is (= compiler (BeamLisp.AOTCache/key_for_ns "core")))

    (is (= build (BeamLisp.AOTCache/key_for_ns "build")))
    (is (= build (BeamLisp.AOTCache/key_for_ns "build-plan")))
    (is (= build (BeamLisp.AOTCache/key_for_ns "source-graph")))
    (is (= build (BeamLisp.AOTCache/key_for_ns "ns-interface")))

    ; An ordinary namespace is stamped with the codegen key, as before.
    (is (= compiler (BeamLisp.AOTCache/key_for_ns "datom")))))

(deftest a-sources-stamp-key-is-the-tier-of-its-file
  (let [compiler (BeamLisp.AOTCache/compiler_key)
        build (BeamLisp.AOTCache/build_key)]
    (is (= compiler (BeamLisp.AOTCache/key_for_source (Path/join (BeamLisp.Tiers/priv_root) "boot/compiler.bl"))))
    (is (= compiler (BeamLisp.AOTCache/key_for_source (Path/join (BeamLisp.Tiers/priv_root) "std/errors.bl"))))
    (is (= compiler (BeamLisp.AOTCache/key_for_source (Path/join (BeamLisp.Tiers/priv_root) "lib/datom.bl"))))
    (is (= build (BeamLisp.AOTCache/key_for_source (Path/join (BeamLisp.Tiers/priv_root) "build/build.bl"))))
    (is (= build (BeamLisp.AOTCache/key_for_source (Path/join (BeamLisp.Tiers/priv_root) "build/build-plan.bl"))))))

(deftest the-build-tier-is-exactly-the-set-the-gate-cannot-closure-hash
  ; `ns_closure_hash/1` answers through `build-plan` → `source-graph`, so a
  ; build-tier namespace asked for its own closure would recurse into the load
  ; the gate is vetting. That is WHY the tier is keyed by a hash of its own
  ; directory instead of by an interface closure. If a driver namespace ever
  ; moves out of `priv/build/`, the gate would have no sound key for it — this
  ; test fails first.
  ;
  ; The tier is read from the RUNNING host (`BeamLisp.Tiers`), the same authority
  ; `key_for_ns/1` routes through — not from a `.ex` source path, which no longer
  ; exists.
  (doseq [name (list "build" "build-plan" "source-graph" "ns-interface")]
    (is (= :build (BeamLisp.Tiers/tier_of_ns name)) name))

  ; `reader-node` is the fourth namespace the gate runs on, and it is codegen.
  (is (= :boot (BeamLisp.Tiers/tier_of_ns "reader-node"))))

(deftest the-app-release-version-is-not-an-input-to-the-toolchain-keys
  ; The compiler_key is the TOOLCHAIN GENERATION, not the release. A release
  ; build stamps env.bl `:vsn` (0.1.0 -> 2026.4.0) with no source change, and
  ; that stamp must not manufacture a new generation: the committed bootstrap
  ; floor is seeded once at a fixed version, and a version-rotated key made the
  ; floor foreign to every stamped release, so the launcher rebuilt the boot
  ; tier from a mismatched floor and died `undefined var: compiler/special-forms`.
  ; Keys are a function of codegen + toolchain sources + Elixir/OTP/backend,
  ; never of the release label.
  ;
  ; There is no public API to mutate a loaded app's :vsn, so this asserts the
  ; invariant at the SOURCE — `priv/host/aot_cache.bl`, the pinned host leaf the
  ; module now lives in: its `compute_compiler_key` reads neither the app's
  ; `:vsn` nor `env.bl`'s version. A future edit that reintroduces the version
  ; into the toolchain key fails here.
  (let [source (File/read! "priv/host/aot_cache.bl")
        body (-> source
                 (String/split "(defn- compute_compiler_key")
                 (second)
                 (String/split "\n  []\n")
                 (second)
                 (String/split "(defn- ")
                 (first))]
    (is (> (erlang/byte_size body) 100)
        "the body of compute_compiler_key was located in the source")
    (is (not (includes? body ":vsn"))
        "compute_compiler_key must not read the app version into the toolchain key")
    (is (not (includes? body "beam_lisp:#"))
        "compute_compiler_key must not hash the app version string into the key"))

  ; And the keys are a pure function of the bytes: recomputing yields the same
  ; value, so nothing time- or run-varying (which a version bump would be)
  ; leaked in.
  (BeamLisp.AOTCache/reset_keys)
  (let [compiler (BeamLisp.AOTCache/compiler_key)
        build (BeamLisp.AOTCache/build_key)]
    (BeamLisp.AOTCache/reset_keys)
    (is (= compiler (BeamLisp.AOTCache/compiler_key)))
    (is (= build (BeamLisp.AOTCache/build_key)))))

; ── the root is a parameter, and the walk is inode-based ────────────────────

(deftest the-boot-build-distinction-survives-an-explicit-staged-root
  ; A self-build stages the payload's priv and asks about THAT root, so a staged
  ; source keeps the tier key its beam is stamped with. The root is load-bearing:
  ; the very same path under the default priv root is NOT the build tier — which
  ; is the bug a missing/ignored root would reintroduce.
  (let [tmp (str (System/tmp_dir!) "/bl_tier_key_stage_"
                 (erlang/unique_integer (list :positive)))
        staged (Path/join tmp "staged")
        compiler (BeamLisp.AOTCache/compiler_key)
        build (BeamLisp.AOTCache/build_key)]
    (File/mkdir_p! (Path/join staged "boot"))
    (File/mkdir_p! (Path/join staged "build"))
    (try
      (testing "the explicit root classifies by what the path points at"
        (is (= build (BeamLisp.AOTCache/key_for_source
                       (Path/join staged "build/build.bl") staged)))
        (is (= compiler (BeamLisp.AOTCache/key_for_source
                          (Path/join staged "boot/compiler.bl") staged))))
      (testing "without the root the staged path is not the build tier"
        ; The default root is the running priv; `/tmp/.../staged/build` is not
        ; under it, so the answer falls back to codegen. Pins that the explicit
        ; root is what carries the tier, not the shape of the path.
        (is (= compiler (BeamLisp.AOTCache/key_for_source
                          (Path/join staged "build/build.bl")))))
      (finally (File/rm_rf! tmp)))))

(deftest the-tier-identity-holds-through-a-symlink
  ; The launcher's image is `beam_lisp-<vsn>/priv -> <tree>/priv`; a path THROUGH
  ; the link must classify by the inode it resolves to, not a string prefix, or a
  ; released image's toolchain sources would read as ordinary and their beams
  ; would lose the tier key the drift gate checks.
  (let [tmp (str (System/tmp_dir!) "/bl_tier_key_link_"
                 (erlang/unique_integer (list :positive)))
        img (Path/join tmp "beam_lisp-0.1.0")
        priv (BeamLisp.Tiers/priv_root)
        compiler (BeamLisp.AOTCache/compiler_key)
        build (BeamLisp.AOTCache/build_key)]
    (File/mkdir_p! img)
    (try
      (File/ln_s! priv (Path/join img "priv"))
      (let [linked-priv (Path/join img "priv")]
        (testing "an explicit symlinked root, exactly the launcher's shape"
          (is (= build (BeamLisp.AOTCache/key_for_source
                         (Path/join linked-priv "build/build.bl") linked-priv)))
          (is (= compiler (BeamLisp.AOTCache/key_for_source
                            (Path/join linked-priv "boot/compiler.bl") linked-priv))))
        (testing "the default root agrees: the link and priv are one inode"
          (is (= build (BeamLisp.AOTCache/key_for_source
                         (Path/join linked-priv "build/build.bl"))))))
      (finally (File/rm_rf! tmp)))))
