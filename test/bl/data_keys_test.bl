(ns data-keys-test (:require [data.keys :as keys]))

(deftest known-keys-convert-and-unknown-keys-never-intern-atoms
 (is (= {:known "value" :nested [{:known 42}]} (keys/keywordize-existing
          {"known" "value" "nested" [{"known" 42}]})))
 (keys/keywordize-existing {"__warm_unknown_key__" "value"})
 (let [before (erlang/system_info :atom_count)
       names (mapv (fn [n] (str "__unknown_data_key_" n "_" (erlang/unique_integer))) (range 50))
       converted (keys/keywordize-existing (zipmap names (repeat "value")))]
  (is (= (set names) (set (keys converted))))
  (is (= before (erlang/system_info :atom_count)))))

(deftest hostile-values-refuse-before-key-or-enumerable-protocol-dispatch
 (is (= :unsafe-first-order-data
      (try (keys/keywordize-existing
             (maps/put :__struct__ :Elixir.File.Stream {:path "unused"})) nil
        (catch e (:kind (ex-data e)))))))

(deftest normalization-cannot-create-structs-or-collapse-authority-keys
 (is (= {"__struct__" :Elixir.File.Stream}
      (keys/keywordize-existing {"__struct__" :Elixir.File.Stream})))
 (is (= :keyword-key-collision
      (try (keys/keywordize-existing {:known 1 "known" 2}) nil
        (catch e (:kind (ex-data e)))))))
