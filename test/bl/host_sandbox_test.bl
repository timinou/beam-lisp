; host_sandbox_test.bl — the pinned `Sandbox` and `ExUnitCase` ABI.
;
; Two `.bl` sources under `priv/host/` replace the two halves of the
; test-support surface at their exact module atoms:
;
;   * `priv/host/sandbox.bl` → `Elixir.BeamLisp.Sandbox`, FUNCTIONS-ONLY:
;     `warm!`/`base!`/`checkout`/`checkin`/`load_file`/`load_ns`/`eval` and
;     NOTHING else — the live module's one private helper is a local closure.
;   * `priv/host/ex_unit_case.bl` → `Elixir.BeamLisp.ExUnitCase`, whose PUBLIC
;     ABI is `resolve_base/1` plus the `MACRO-__using__/2` implementer
;     advertised through `:macro_exports`.
;
; Nothing here replaces a live module. The Sandbox source is compiled at its
; OWN probe atom and the pinned beam is loaded ALONE — the compile's namespace
; shim is dropped, so a leftover shim reference would be `undef` here — and the
; whole surface, the fork semantics, the `is_atom` guard failures and the
; DISASSEMBLED remote-module set are checked against the live module, answer for
; answer.
;
; THE `use` EXPANSION IS COMPARED IN A COLD CHILD, because that is the only way
; to put the pinned ExUnitCase beam at the PRODUCTION atom without unloading the
; live one in this VM: the pinned beam is compiled into a scratch dir and the
; child is handed that dir LAST on `-pa`, so `:code.which/1` answers with the
; pinned beam. The child expands `use BeamLisp.ExUnitCase, opts` for a list of
; opts and prints each expansion as base64 of its external term; the parent
; compares that, term for term, to the LIVE module's expansion for the same
; opts — hygiene contexts and all, with no normalisation to hide a difference
; behind. `:code.which` and a real `use`-ing consumer module compiled in the
; child prove the expansion came from the pinned beam and that the caller's
; compiler accepts it.
;
; Run: bin/bl test test/bl/host_sandbox_test.bl

(ns host.sandbox.test)

(defn- t2 [k v] (erlang/list_to_tuple (list k v)))

(defn- tmp-dir []
  (str (System/tmp_dir!) "/bl_host_sandbox_" (erlang/unique_integer (list :positive))))

(defn- sandbox-source [] (Path/join (BeamLisp/cwd) "priv/host/sandbox.bl"))
(defn- ex-unit-case-source [] (Path/join (BeamLisp/cwd) "priv/host/ex_unit_case.bl"))
(defn- math-fixture [] (Path/join (BeamLisp/cwd) "test/fixtures/aot/math.bl"))

(def ^:private live-sandbox :Elixir.BeamLisp.Sandbox)
(def ^:private live-euc :Elixir.BeamLisp.ExUnitCase)
(def ^:private sandbox-probe :Elixir.BeamLisp.SandboxHostProbe)
(def ^:private euc-probe :Elixir.BeamLisp.ExUnitCaseHostProbe)
(def ^:private sandbox-shim :Elixir.BeamLisp.Ns.Host.Sandbox)
(def ^:private euc-shim :Elixir.BeamLisp.Ns.Host.ExUnitCase)

(defn- sandbox-opts [dir]
  (list (t2 :module sandbox-probe) (t2 :output_dir dir) (t2 :load? false)))

(defn- euc-probe-opts [dir]
  (list (t2 :module euc-probe) (t2 :output_dir dir) (t2 :load? false)
        (t2 :macro_exports (list (t2 :__using__ 1)))))

(defn- euc-live-opts [dir]
  (list (t2 :module live-euc) (t2 :output_dir dir) (t2 :load? false)
        (t2 :macro_exports (list (t2 :__using__ 1)))))

(defn- drop! [mod]
  (do (code/purge mod) (code/delete mod) :ok))

(defn- load-pinned [mod path]
  (do (drop! mod)
      (code/load_binary mod (erlang/binary_to_list path) (File/read! path))
      mod))

; Compile the pinned source at the probe atom and publish ONLY the pinned beam:
; the compile's namespace shim is dropped, so every answer below comes from the
; pinned bytes with no namespace behind them.
(defn- compile-sandbox [dir]
  (let [res (BeamLisp.AOT/compile_host_file (sandbox-source) (sandbox-opts dir))
        m (load-pinned sandbox-probe (erlang/element 2 res))]
    (drop! sandbox-shim)
    m))

(defn- compile-euc-probe [dir]
  (let [res (BeamLisp.AOT/compile_host_file (ex-unit-case-source) (euc-probe-opts dir))
        m (load-pinned euc-probe (erlang/element 2 res))]
    (drop! euc-shim)
    m))

(defn- struct-tag [x] (if (erlang/is_map x) (maps/get :__struct__ x) nil))

(defn- ok-value [r] (erlang/element 2 r))

(defn- raised-shape
  "The observable shape of `f`'s raise: the exception's struct tag, its
   `:function`/`:arity` (for a `FunctionClauseError`), and its message."
  [f]
  (try
    (do (f) :no-raise)
    (catch e (list (struct-tag e)
                   (if (erlang/is_map_key :function e) (maps/get :function e) nil)
                   (if (erlang/is_map_key :arity e) (maps/get :arity e) nil)
                   (ex-message e)))))

; ── the Sandbox surface ──────────────────────────────────────────────────

(def pinned-exports
  "The absolute export surface of the pinned Sandbox beam: the live module's
   public API plus `module_info`, and NOT the Elixir-generated `__info__/1` a
   functions-only pinned module deliberately does not carry."
  (list (t2 :base! 1) (t2 :checkin 1) (t2 :checkout 0) (t2 :checkout 1)
        (t2 :eval 1) (t2 :load_file 1) (t2 :load_ns 1)
        (t2 :module_info 0) (t2 :module_info 1) (t2 :warm! 2)))

(deftest sandbox-pinned-surface-is-the-live-surface
  (testing "one export per live export, and no helper leaks the surface"
    (let [dir (tmp-dir)]
      (let [m (compile-sandbox dir)]
        ; NO SHIM: the compile's namespace module is gone; the pinned beam answers.
        (is (erlang/== :non_existing (erlang/apply :code :which (list sandbox-shim))))
        ; THE PUBLIC ABI, pinned absolutely.
        (is (erlang/== pinned-exports
                       (lists/sort (erlang/apply m :module_info (list :exports))))
            "the pinned module is the live module's public API and nothing else")
        ; EVERY LIVE EXPORT is present, `__info__/1` excepted by name — the ONE
        ; documented divergence for a functions-only pinned module.
        (is (every? (fn [e] (or (erlang/== :__info__ (erlang/element 1 e))
                                (erlang/function_exported m (erlang/element 1 e)
                                                          (erlang/element 2 e))))
                    (erlang/apply live-sandbox :module_info (list :exports)))
            "the pinned ABI covers every live export")
        ; REPRODUCIBLE: a rebuild of the same source is the same bytes, so the
        ; beam can be committed into the seed and re-derived.
        (let [dir2 (tmp-dir)]
          (is (erlang/== (File/read! (erlang/element 2 (BeamLisp.AOT/compile_host_file
                                                         (sandbox-source) (sandbox-opts dir))))
                         (File/read! (erlang/element 2 (BeamLisp.AOT/compile_host_file
                                                         (sandbox-source) (sandbox-opts dir2))))))
          (File/rm_rf! dir2)))
      (File/rm_rf! dir))))

; ── the guard failures, as live reports them ─────────────────────────────

(defn- guard-cases []
  (list
    (erlang/list_to_tuple (list :warm! 2 (fn [m] (erlang/apply m :warm! (list "x" (list))))))
    (erlang/list_to_tuple (list :warm! 2 (fn [m] (erlang/apply m :warm! (list :x :notlist)))))
    (erlang/list_to_tuple (list :base! 1 (fn [m] (erlang/apply m :base! (list "x")))))
    (erlang/list_to_tuple (list :load_ns 1 (fn [m] (erlang/apply m :load_ns (list :x)))))
    (erlang/list_to_tuple (list :eval 1 (fn [m] (erlang/apply m :eval (list :x)))))))

(deftest sandbox-pinned-reports-the-live-guard-failures
  (testing "`is_atom`/`is_binary` rejection is the same FunctionClauseError"
    (let [dir (tmp-dir)
          m (compile-sandbox dir)]
      (doseq [c (guard-cases)]
        (let [fun (erlang/element 1 c)
              arity (erlang/element 2 c)
              call (erlang/element 3 c)
              pinned (raised-shape (fn [] (call m)))
              live (raised-shape (fn [] (call live-sandbox)))]
          (is (erlang/== :Elixir.FunctionClauseError (first pinned))
              (str (erlang/atom_to_list fun) ": class"))
          (is (erlang/== (first live) (first pinned))
              (str (erlang/atom_to_list fun) ": the same class as live"))
          (is (erlang/== (list fun arity) (list (nth pinned 1) (nth pinned 2)))
              (str (erlang/atom_to_list fun) ": names the function and arity"))
          (is (erlang/== (list (nth live 1) (nth live 2)) (list (nth pinned 1) (nth pinned 2)))
              (str (erlang/atom_to_list fun) ": function/arity match live"))))
      ; `base!/1`'s MISS is a RuntimeError whose message is reproduced byte for
      ; byte, because a caller's `rescue` reads it.
      (let [pinned (raised-shape (fn [] (erlang/apply m :base! (list :never_warmed))))
            live (raised-shape (fn [] (erlang/apply live-sandbox :base! (list :never_warmed))))]
        (is (erlang/== :Elixir.RuntimeError (first pinned)))
        (is (erlang/== (nth live 3) (nth pinned 3))
            "the no-warm-base message is the live one, byte for byte"))
      (File/rm_rf! dir))))

; ── the fork semantics ───────────────────────────────────────────────────

(defn- fork-observation
  "Warm a base from the math fixture, fork it, shadow a var in the fork, check
   the fork back in and re-fork the UNTOUCHED base, then eval into a fork and
   cold-fork `:global`. Returns only values — no env ids — so the live module's
   observation and the pinned module's are directly comparable."
  [mod]
  (BeamLisp.Env/isolated
    (fn []
      (let [base (erlang/apply mod :warm! (list :sandbox_fork_math (list (math-fixture))))
            env (erlang/apply mod :checkout (list base))
            seen (ok-value (BeamLisp.Env/fetch "math" "answer"))]
        (BeamLisp.Env/intern "math" "answer" 43)
        (let [shadow (ok-value (BeamLisp.Env/fetch "math" "answer"))]
          (erlang/apply mod :checkin (list env))
          ; the base was never written through the fork, and warm! is idempotent
          (let [base2 (erlang/apply mod :warm! (list :sandbox_fork_math (list "ignored")))
                env2 (erlang/apply mod :checkout (list base))
                fresh (ok-value (BeamLisp.Env/fetch "math" "answer"))]
            (erlang/apply mod :eval (list "(ns pinned.cold) (def x 7)"))
            (let [cold (ok-value (BeamLisp.Env/fetch "pinned.cold" "x"))]
              (erlang/apply mod :checkin (list env2))
              ; a COLD fork sees the prelude only
              (let [env3 (erlang/apply mod :checkout (list))
                    cold-see (BeamLisp.Env/fetch "math" "answer")
                    _ (erlang/apply mod :checkin (list env3))]
                (list seen shadow (erlang/== base base2) fresh cold cold-see)))))))))

(defn- fn-source-observation
  "The zero-arg-function source dispatch: the fn runs INSIDE the base env, so a
   fork of the base sees what it interned."
  [mod]
  (BeamLisp.Env/isolated
    (fn []
      (erlang/apply mod :warm!
                    (list :sandbox_fn_source
                          (list (fn [] (erlang/apply mod :eval (list "(ns fn.src) (def y 5)"))))))
      (let [env (erlang/apply mod :checkout (list :sandbox_fn_source))
            y (ok-value (BeamLisp.Env/fetch "fn.src" "y"))]
        (erlang/apply mod :checkin (list env))
        y))))

(deftest sandbox-pinned-fork-semantics
  (testing "warm/base/checkout/checkin/eval, value for value with the live module"
    (let [dir (tmp-dir)
          m (compile-sandbox dir)]
      (let [observed (fork-observation m)]
       (is (erlang/== (list 42 43 true 42 7 :error) observed)
           (str "fork truth table: base, local shadow, untouched base, cold prelude: "
                (pr-str observed))))
      (is (erlang/== (fork-observation live-sandbox) (fork-observation m))
          "live and pinned agree on every fork reading")
      (is (erlang/== 5 (fn-source-observation m)) "the fn source is called inside the base")
      (is (erlang/== (fn-source-observation live-sandbox) (fn-source-observation m)))
      ; the live module was never substituted mid-flight
      (is (erlang/function_exported live-sandbox :warm! 2))
      (File/rm_rf! dir))))

; ── the dependency contract, read off the beam ──────────────────────────

(defn- remote-mods
  "Every remote module the beam calls."
  [path]
  (let [funs (erlang/element 6 (erlang/apply :beam_disasm :file
                                             (list (erlang/binary_to_list path))))]
    (Enum/uniq
      (Enum/flat_map
        (Enum/filter funs (fn [f] (erlang/== :function (erlang/element 1 f))))
        (fn [f]
          (Enum/flat_map (erlang/element 5 f)
            (fn [ins]
              (if (and (erlang/is_tuple ins)
                       (erlang/> (erlang/tuple_size ins) 2)
                       (erlang/== :call_ext (erlang/element 1 ins))
                       (erlang/is_tuple (erlang/element 3 ins)))
                (list (erlang/element 2 (erlang/element 3 ins)))
                (list)))))))))

(defn- ns-deps
  "Every remote target module in the beam that is a beam-lisp NAMESPACE
   (`Elixir.BeamLisp.Ns.*`) — the modules interned DURING boot, so a call into
   one from a beam `elixirc` resolves before the boot is the circularity
   `priv/host/vector.bl` documents."
  [path]
  (Enum/filter (remote-mods path)
               (fn [m] (String/starts_with? (Atom/to_string m) "Elixir.BeamLisp.Ns."))))

(deftest sandbox-pinned-dependency-contract
  (testing "the whole remote set of each pinned beam, asserted from the disassembly"
    (let [dir (tmp-dir)]
      ; SANDBOX is RUNTIME-TIER: it builds tuples and lists with the language's
      ; own `(tuple …)`/`(list …)`, i.e. `BeamLisp.Ns.Core`, the same trade
      ; `priv/host/reload_watcher.bl` makes. Its whole remote set is pinned, so a
      ; dependency added by accident is a test failure, not a silent new edge.
      (compile-sandbox dir)
      (is (erlang/== (lists/sort (list :erlang :"Elixir.BeamLisp" :"Elixir.BeamLisp.Compiler"
                                       :"Elixir.BeamLisp.Env" :"Elixir.BeamLisp.Loader"
                                       :"Elixir.BeamLisp.Ns.Core" :"Elixir.File"
                                       :"Elixir.FunctionClauseError" :"Elixir.Kernel"
                                       :"Elixir.Path" :"Elixir.RuntimeError"))
                     (lists/sort (Enum/reject (remote-mods (Path/join dir (str sandbox-probe ".beam")))
                                              (fn [m] (erlang/== m sandbox-probe)))))
          (str "the sandbox beam's remote modules; got "
               (pr-str (lists/sort (remote-mods (Path/join dir (str sandbox-probe ".beam")))))))
      ; EXUNITCASE is boot-safe: NO `BeamLisp.Ns.*` target at all, so the beam
      ; resolves against the live modules alone and can be loaded and called
      ; before the language is booted.
      (compile-euc-probe dir)
      (let [path (Path/join dir (str euc-probe ".beam"))]
        (is (erlang/== (list) (ns-deps path))
            "no `Elixir.BeamLisp.Ns.*` target: the AST is built from :erlang alone")
        (is (erlang/== (lists/sort (list :erlang :"Elixir.FunctionClauseError" :"Elixir.Keyword"))
                       (lists/sort (Enum/reject (remote-mods path)
                                                (fn [m] (erlang/== m euc-probe)))))
            (str "the ExUnitCase beam's remote modules; got "
                 (pr-str (lists/sort (remote-mods path))))))
      (File/rm_rf! dir))))

; ── the ExUnitCase ABI ───────────────────────────────────────────────────

(defn- expansion-b64
  "The live `use` expansion for `opts`, as base64 of its external term — the
   exact bytes a child must reproduce from the pinned beam."
  [mod opts]
  (Base/encode64
    (erlang/term_to_binary
      (erlang/apply mod :"MACRO-__using__"
                    (list (erlang/apply :Elixir.Macro.Env :__struct__ (list)) opts)))))

(defn- expansion-optss []
  (list (list (t2 :warm (t2 :my_app (list))) (t2 :async false))
        (list (t2 :warm :pre_warmed))
        (list)
        (list (t2 :async true))))

(deftest ex-unit-case-pinned-matches-the-live-module
  (testing "resolve_base/1, the macro surface, and the export coverage"
    (let [dir (tmp-dir)
          m (compile-euc-probe dir)]
      (is (erlang/== :non_existing (erlang/apply :code :which (list euc-shim))))
      ; THE PUBLIC MACROS: `:macro_exports` synthesizes `__info__(:macros)`, the
      ; entry `require`/`use` read before they will expand anything.
      (is (erlang/== (list (t2 :__using__ 1)) (erlang/apply m :__info__ (list :macros))))
      (is (erlang/== (erlang/apply live-euc :__info__ (list :macros))
                     (erlang/apply m :__info__ (list :macros)))
          "`__info__(:macros)` is the live module's")
      (is (erlang/function_exported m :"MACRO-__using__" 2))
      (is (not (Enum/member? (erlang/apply m :__info__ (list :functions))
                             (t2 :"MACRO-__using__" 2)))
          "the implementer is NOT advertised as a function, as in Elixir")
      (is (erlang/== nil (erlang/apply m :__info__ (list :struct)))
          "no struct surface, exactly as the live module has none")
      (is (every? (fn [e] (erlang/function_exported m (erlang/element 1 e) (erlang/element 2 e)))
                  (erlang/apply live-euc :module_info (list :exports)))
          "the pinned ABI covers every live export")
      ; `resolve_base/1`: nil, a warmed NAME, and a `{name, sources}` pair.
      (is (erlang/== :global (erlang/apply m :resolve_base (list nil))))
      (is (erlang/== :global (erlang/apply live-euc :resolve_base (list nil))))
      (BeamLisp.Env/isolated
        (fn []
          (let [warmed (erlang/apply m :resolve_base
                                     (list (t2 :sandbox_euc_base (list (math-fixture)))))]
            (is (erlang/== warmed (erlang/apply m :resolve_base (list :sandbox_euc_base)))
                "a warmed NAME resolves to the base the pair built")
            (is (erlang/== warmed (erlang/apply live-euc :resolve_base
                                                (list (t2 :sandbox_euc_base (list (math-fixture))))))
                "and to the same base the live module answers with"))))
      ; A bad argument is the live FunctionClauseError.
      (is (erlang/== (list :Elixir.FunctionClauseError :resolve_base 1)
                     (let [s (raised-shape (fn [] (erlang/apply m :resolve_base (list "x"))))]
                       (list (first s) (nth s 1) (nth s 2)))))
      (is (erlang/== (let [s (raised-shape (fn [] (erlang/apply live-euc :resolve_base (list "x"))))]
                       (list (first s) (nth s 1) (nth s 2)))
                     (let [s (raised-shape (fn [] (erlang/apply m :resolve_base (list "x"))))]
                       (list (first s) (nth s 1) (nth s 2)))))
      (File/rm_rf! dir))))

; ── the expansion, live here and pinned in a cold child ──────────────────

(defn- child-code-args
  "This VM's whole code path as `-pa` args, with `pinned` LAST so it lands
   FIRST: `-pa` PREPENDS, so the last one named wins."
  [pinned]
  (to-list (concat (mapcat (fn [p] (list "-pa" (erlang/list_to_binary p))) (code/get_path))
                   (list "-pa" pinned))))

(defn- cmd-opts [payload fixture]
  (to-list (list (t2 :stderr_to_stdout true)
                 (t2 :env (list (t2 "ERL_CRASH_DUMP" "/dev/null")
                                (t2 "BL_OPTS_B64" payload)
                                (t2 "BL_FIXTURE" fixture))))))

(defn- child-run [exe args payload fixture]
  (System/cmd exe (to-list args) (cmd-opts payload fixture)))

(defn- child-script []
  (str
    "opts_list = System.get_env(\"BL_OPTS_B64\") |> Base.decode64!() |> :erlang.binary_to_term()\n"
    "env = Macro.Env.__struct__()\n"
    "Enum.with_index(opts_list) |> Enum.each(fn {opts, i} ->\n"
    "  ast = BeamLisp.ExUnitCase.\"MACRO-__using__\"(env, opts)\n"
    "  IO.puts(\"observed\" <> Integer.to_string(i) <> \"=\" <> Base.encode64(:erlang.term_to_binary(ast)))\n"
    "end)\n"
    "IO.puts(\"which=\" <> List.to_string(:code.which(BeamLisp.ExUnitCase)))\n"
    "IO.puts(\"macros=\" <> inspect(BeamLisp.ExUnitCase.__info__(:macros)))\n"
    "try do\n"
    "  Application.ensure_all_started(:beam_lisp)\n"
    "  ExUnit.start(autorun: false)\n"
    "  defmodule SandboxUseConsumer do\n"
    "    use BeamLisp.ExUnitCase, warm: {:sandbox_use_probe, [System.get_env(\"BL_FIXTURE\")]}, async: false\n"
    "    test \"a test forks the warmed base\" do\n"
    "      assert {:ok, 42} = BeamLisp.Env.fetch(\"math\", \"answer\")\n"
    "      BeamLisp.Env.intern(\"math\", \"answer\", 43)\n"
    "      assert {:ok, 43} = BeamLisp.Env.fetch(\"math\", \"answer\")\n"
    "    end\n"
    "    test \"the next test sees the untouched base\" do\n"
    "      assert {:ok, 42} = BeamLisp.Env.fetch(\"math\", \"answer\")\n"
    "    end\n"
    "  end\n"
    "  case ExUnit.run() do\n"
    "    %{failures: 0, total: n} -> IO.puts(\"consumer=ok tests=\" <> Integer.to_string(n))\n"
    "    other -> IO.puts(\"consumer=error \" <> inspect(other))\n"
    "  end\n"
    "rescue\n"
    "  e -> IO.puts(\"consumer=error \" <> Exception.message(e))\n"
    "end\n"))

(deftest ex-unit-case-pinned-expansion-is-the-live-expansion-in-a-cold-child
  (testing "one `use` expansion per opts: live here, pinned at the production atom in a child"
    (let [dir (tmp-dir)
          out (str dir "/pin")
          optss (expansion-optss)
          expected (map (fn [o] (expansion-b64 live-euc o)) optss)]
      (File/mkdir_p! out)
      ; THE PINNED BEAM at the PRODUCTION atom, written but NOT loaded here.
      (BeamLisp.AOT/compile_host_file (ex-unit-case-source) (euc-live-opts out))
      (is (File/exists? (Path/join out "Elixir.BeamLisp.ExUnitCase.beam")))
      (is (erlang/function_exported live-euc :resolve_base 1)
          "the live module was never substituted mid-flight")
      (let [payload (Base/encode64 (erlang/term_to_binary optss))
            r (child-run "elixir" (concat (child-code-args out) (list "-e" (child-script)))
                         payload (math-fixture))
            text (erlang/element 1 r)]
        (is (zero? (erlang/element 2 r)) (str "the cold child exited " (erlang/element 2 r) ":\n" text))
        (is (includes? text (str "which=" out "/Elixir.BeamLisp.ExUnitCase.beam"))
            "from the pinned beam: the child's ONLY added code path entry")
        (is (includes? text "macros=[__using__: 1]") "the child's module advertises the macro")
        ; THE DIFFERENTIAL: every expansion, term for term.
        (loop [os optss es expected i 0]
          (when (not (empty? os))
            (is (includes? text (str "observed" (erlang/integer_to_binary i) "=" (first es)))
                (str "opts " (pr-str (first os)) ": the pinned expansion is the live one"))
            (recur (rest os) (rest es) (erlang/+ i 1))))
        (is (includes? text "consumer=ok")
            (str "a real ExUnit module `use`s the pinned expansion and its tests pass:\n" text)))
      (File/rm_rf! dir))))
