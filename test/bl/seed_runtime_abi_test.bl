; test/bl/seed_runtime_abi_test.bl — test.seed-runtime-abi.
;
; Split from test/bl/seed_test.bl so each file stays under the runner's 300 s
; per-file bound. Shared helpers live in test.bl.seed-support.

(ns test.seed-runtime-abi
  (:require [seed] [test.bl.seed-support :as s]))

(deftest the-supervisor-publishes-the-tree-builders-public-surface
  ;; `Elixir.BeamLisp.Supervisor` is the NAME the OTP application registers its
  ;; top supervisor under, and it is ALSO the module `rt.bl`'s `supervise`/
  ;; `worker` rows bind by VALUE and `priv/std/proc/super.bl` calls directly, so
  ;; the floor must publish the tree-builder's whole public surface at that atom.
  ;; The mapping is functions-only — no `:struct-fields`, no `:behaviour`, no
  ;; `:macro-exports` — and the published beam is judged from its own export
  ;; chunk, from the REAL source, against the live module's callables minus
  ;; Elixir's own `__info__/1`, which a pinned functions-only beam does not carry.
  (let [root (BeamLisp/cwd)
        ebin (Path/join root "build")
        out (s/scratch "supervisor-out")
        real {"Elixir.BeamLisp.Supervisor" (Path/join root "priv/host/supervisor.bl")}
        hd (s/host-scratch "supervisor-src" "" real)
        r (s/seed-run! {:root root :out out :ebin ebin :host hd})]
    (is (:ok? r) (str "the floor is generated: " (pr-str (:errors r))))
    (let [beam (Path/join out "Elixir.BeamLisp.Supervisor.beam")
          exports (s/beam-exports beam)
          live (erlang/apply :"Elixir.BeamLisp.Supervisor" :module_info (list :exports))
          want (Enum/sort (filter (fn [e] (not (erlang/== :__info__ (elem e 0)))) live))]
      (is (File/exists? beam) "Supervisor is COMPILED into the floor")
      (is (= want (Enum/sort exports))
          "the published Supervisor beam exports exactly the live module's callables — it has no defn- helper to add")
      (is (not (s/has? exports (tuple :__info__ 1)))
          "Supervisor is functions-only: the published beam carries no Elixir __info__/1"))
    (File/rm_rf! out)
    (File/rm_rf! hd)))

(deftest the-z3-port-publishes-the-port-drivers-public-surface
  ;; `Elixir.BeamLisp.Z3Port` is the pure-function port driver `priv/std/z3pool.bl`
  ;; owns a port and calls by name (`env_ms`, `open`, `raw_check`, `raw_command`,
  ;; `raw_scoped`, `raw_check_here3`, `alive?`), so the floor must publish the
  ;; driver's whole public surface at that atom. The mapping is functions-only —
  ;; no `:struct-fields`, no `:behaviour`, no `:macro-exports` — and the published
  ;; beam is judged from its own export chunk, from the REAL source, against the
  ;; production module's callables (already pinned). `defn-` helpers are
  ;; exported on both production and scratch beams, and are asserted by name.
  (let [root (BeamLisp/cwd)
        ebin (Path/join root "build")
        out (s/scratch "z3-port-out")
        real {"Elixir.BeamLisp.Z3Port" (Path/join root "priv/host/z3_port.bl")}
        hd (s/host-scratch "z3-port-src" "" real)
        r (s/seed-run! {:root root :out out :ebin ebin :host hd})]
    (is (:ok? r) (str "the floor is generated: " (pr-str (:errors r))))
    (let [beam (Path/join out "Elixir.BeamLisp.Z3Port.beam")
          exports (s/beam-exports beam)
          live (erlang/apply :"Elixir.BeamLisp.Z3Port" :module_info (list :exports))
          want (Enum/sort (filter (fn [e] (not (erlang/== :__info__ (elem e 0)))) live))]
      (is (File/exists? beam) "Z3Port is COMPILED into the floor")
      (is (every? (fn [e] (s/has? exports e)) want)
          "the published Z3Port beam exports every live callable, arity for arity")
      (is (= () (filter (fn [e] (not (s/has? want e))) exports))
          "the published beam matches the pinned production export surface")
      (is (every? (fn [e] (s/has? exports e))
                  (list (tuple :missing_solver_message 0) (tuple :resolve_exe 0)
                        (tuple :candidate_paths 0) (tuple :extract_reason 1)
                        (tuple :read_until_marker 3) (tuple :read_answer 2)
                        (tuple :read_sexp 2) (tuple :balanced? 1)))
          "all private helpers remain present in the pinned ABI")
      (is (s/has? exports (tuple :raw_check 3))
          "Z3Port exposes raw_check/3, the pool's primary entry")
      (is (not (s/has? exports (tuple :__info__ 1)))
          "Z3Port is functions-only: the published beam carries no Elixir __info__/1"))
    (File/rm_rf! out)
    (File/rm_rf! hd)))
