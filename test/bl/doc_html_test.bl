; doc_html_test.bl — the static rendering: prose subset, cell anchors,
; result embedding (stored span for frozen, fresh facts for live), and the
; build-file verb writing a real page to disk.

(ns bl.doc.html.test
  (:require [bl.doc :as doc]
            [bl.doc.html :as h]))

(def md-doc
  "# Demo

A **bold** claim with `code` and a [link](https://example.com).

```beam-lisp id=gross
(defn gross [rate hours]
  (* rate hours))
```

```beam-lisp id=call
(gross 50 160)
```

```bl-result call
8000
```
")

(deftest page-renders-prose-and-cells
  (let [d (:ok (doc/slice-text md-doc :md))
        html (h/page d {})]
    (is (includes? html "<h1>Demo</h1>"))
    (is (includes? html "<strong>bold</strong>"))
    (is (includes? html "<code>code</code>"))
    (is (includes? html "<a href=\"https://example.com\">link</a>"))
    (is (includes? html "id=\"cell-gross\""))
    (is (includes? html "language-beam-lisp"))))

(deftest page-embeds-stored-and-fresh-results
  (let [d (:ok (doc/slice-text md-doc :md))
        html (h/page d {"gross" "&fn[gross]"})]
    ;; `call` has a stored span: its result renders from the file
    (is (includes? html ">8000<"))
    ;; `gross` has none: the fresh result renders instead
    (is (includes? html "&amp;fn[gross]"))))

(deftest page-escapes-code
  (let [d (:ok (doc/slice-text
                 "```beam-lisp\n(str \"<a>\")\n```\n" :md))
        html (h/page d {})]
    (is (includes? html "(str &quot;&lt;a&gt;&quot;)"))
    (is (not (includes? html "<a>")))))

(deftest org-page-renders-headings-and-results
  (let [d (:ok (doc/slice-text
                 "* Title\n\n#+begin_src beam-lisp :id a\n(+ 1 2)\n#+end_src\n\n#+RESULTS: a\n: 3\n"
                 :org))
        html (h/page d {})]
    (is (includes? html "<h1>Title</h1>"))
    (is (includes? html ">3<"))))

(deftest build-file-writes-a-page
  (let [src "test/fixtures/docs/docx/payroll.bl.md"
        out "tmp/doc-html-test"
        r (h/build-file src out)
        page (File/read! "tmp/doc-html-test/payroll.html")]
    (is (contains? r :path))
    (is (= 2 (:cells r)))
    (is (includes? page "id=\"cell-gross\""))
    ;; the frozen cell renders its STORED result, untouched by any run
    (is (includes? page ":payroll-v1"))))
