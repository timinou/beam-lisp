; The pinned LazyMemo beam has the Rust crate's exact module atom only when
; installed by the committed seed. A probe atom must NEVER try to bind the
; same NIF in this test VM: the crate rejects a second/module-mismatched load.
(ns host.lazy-memo.test)

(defn- t2 [a b] (erlang/list_to_tuple (list a b)))
(def ^:private probe :Elixir.BeamLisp.HostLazyMemoProbe)
(def ^:private shim :Elixir.BeamLisp.Ns.Host.LazyMemo)
(def ^:private nif-stubs
  (list (t2 :nif_loaded? 0) (t2 :nif_new 3) (t2 :nif_read 1)
        (t2 :nif_read_fast 1) (t2 :nif_fast_lane_bytes 0)
        (t2 :nif_set_fast_lane_bytes 1) (t2 :nif_compare_exchange_fast 6)
        (t2 :nif_compare_exchange 6) (t2 :nif_id 1)
        (t2 :nif_resource_id 1) (t2 :nif_stats 0) (t2 :nif_new_fast 3)
        (t2 :nif_cursor 3) (t2 :nif_cursor_chunk 1)
        (t2 :nif_cursor_chunk_fast 1) (t2 :nif_cursor_dirty_chunks 1)
        (t2 :nif_dependency_resource 1)))

(defn- compile-probe [dir]
  (File/mkdir_p! dir)
  (let [res (BeamLisp.AOT/compile_host_file "priv/host/lazy_memo.bl"
              (list (t2 :module probe) (t2 :output_dir dir) (t2 :load? false)))
        path (elem res 1)]
    (code/purge probe)
    (code/delete probe)
    (code/load_binary probe (erlang/binary_to_list path) (File/read! path))
    (code/purge shim)
    (code/delete shim)
    path))

(deftest the-native-facade-emits-the-complete-stub-surface
  (let [dir (str (System/tmp_dir!) "/bl_lazy_host_" (erlang/unique_integer (list :positive)))
        path (compile-probe dir)]
    (testing "the NIF binder sees every Rust registration at its exact arity"
      (is (= 17 (count nif-stubs)))
      (is (every? (fn [entry] (erlang/function_exported probe (elem entry 0) (elem entry 1)))
                  nif-stubs))
      (is (every? (fn [entry]
                    (erlang/function_exported probe (elem entry 0) (elem entry 1)))
                  (list (t2 :ensure_loaded! 0) (t2 :create 1) (t2 :create_ref 1)
                        (t2 :exchange_ref 3) (t2 :exchange_ref 4)
                        (t2 :exchange 3) (t2 :exchange 4)
                        (t2 :dependencies 1) (t2 :cursor 1)
                        (t2 :cursor_dirty_chunks? 1) (t2 :cursor_chunk 1)
                        (t2 :cursor_chunk 2) (t2 :estimate_bytes 1)
                        (t2 :admit! 0) (t2 :new 3) (t2 :read 1)
                        (t2 :fast_lane_bytes 0) (t2 :set_fast_lane_bytes 1)
                        (t2 :compare_exchange 5) (t2 :id 1) (t2 :stats 0))))
      (is (= :non_existing (code/which shim))
          "the host beam answers without its compiler namespace shim")
      (is (= false (erlang/apply probe :nif_loaded? (list)))
          "a probe atom cannot accidentally claim the production NIF")
      (is (= :nif_not_loaded
             (try (erlang/apply probe :nif_stats (list))
                  (catch e (BeamLisp.ExInfo/ex_original e))))
          "the unbound stub refuses without touching the production NIF")
      (is (not (erlang/function_exported probe :__info__ 1)))
      (is (File/exists? path)))
    (File/rm_rf! dir)))

(deftest the-pinned-native-facade-is-reproducible
  (let [a (str (System/tmp_dir!) "/bl_lazy_a_" (erlang/unique_integer (list :positive)))
        b (str (System/tmp_dir!) "/bl_lazy_b_" (erlang/unique_integer (list :positive)))
        pa (compile-probe a)
        pb (compile-probe b)]
    (is (= (File/read! pa) (File/read! pb))
        "the source, not the output directory, determines the beam bytes")
    (File/rm_rf! a)
    (File/rm_rf! b)))

(run-tests)
