(ns aot.floor-forwarder-test)

(deftest a-floor-namespace-outside-the-boot-directory-keeps-its-declaration-proof
  (let [module :Elixir.BeamLisp.Ns.Multi
        path (Path/join (BeamLisp.Bootstrap/seed_dir) "Elixir.BeamLisp.Ns.Multi.beam")
        metadata (BeamLisp.AOT/seed_forwarder_metadata module (File/read! path))]
    (is (= :mutable-forwarder (:role metadata)))
    (is (= "multi" (:forwarder-namespace metadata)))
    (is (= :Elixir.BeamLisp.Ns.Body.Multi
           (get (:forwarder-routes metadata) (erlang/list_to_tuple (list :derive 2)))))
    (is (some? (:declarations metadata)))
    (is (some? (:callable-kinds metadata)))))
