; wave1415_seq_macro_test.bl — the wave 14 (recursive-seq machinery) and
; wave 15 (macro-authoring surface) ExUnit suites, ported whole.
;
; Ported from:
;   * test/beam_lisp/wave14_seq_test.exs — `next` (nil-vs-empty), `list*`,
;     variadic `apply`, 2-arity `reduce`, the predicate/utility prims from
;     docs/jank-compat.md's ranked gap list, and the jank core.jank slices those
;     prims unlock (some, not-any?, comp, partial, juxt, trampoline) loaded
;     VERBATIM from test/fixtures/jank/*.bl and called to prove load-and-behave.
;   * test/beam_lisp/wave15_macro_test.exs — `loop*`/`let*`/`fn*`, form
;     metadata (`meta`/`with-meta` on the datum a macro receives), `&form`/`&env`
;     bound inside every macro, the `clojure.core` alias, `assert-macro-args`,
;     and the vendored macro slices (thread/if-let/when-let/dotimes/doto/
;     memoize/doseq) loaded verbatim.
;
; Coverage (assertion parity — no case dropped, no assertion dropped):
;   wave14_seq_test.exs    16 tests /102 assertions → 16 deftests /102 `is`
;   wave15_macro_test.exs  21 tests / 45 assertions → 21 deftests / 45 `is`
;   total                  37 tests /147 assertions → 37 deftests /147 `is`
;
; Mapping (ExUnit describe/test → this file's deftest), one line per case:
;
;   wave14 "next — nil-vs-empty is the contract"
;     "nil when the remainder is empty, the tail seq otherwise" → w14-next-nil-vs-empty
;     "drives the (if (next xs) …) idiom…"                       → w14-next-drives-the-if-idiom
;     "over a LazySeq it forces the head and answers…"           → w14-next-over-a-lazys-eq-forces-head
;   wave14 "list* — variadic cons onto the final collection"
;     "prepends leading args onto the last…"                     → w14-list-star-prepends-onto-seq
;   wave14 "variadic apply — leading args prepend the final seq"
;     "2-arity keeps working (lists and vectors)"                → w14-apply-2-arity
;     "extra leading args are prepended before the seq"          → w14-apply-leading-args-prepend
;   wave14 "reduce 2-arity — folds without an initial accumulator"
;     "comp's `(reduce comp (list* f g fs))` shape"              → w14-reduce-2-arity
;   wave14 "predicate and utility prims (Clojure-correct)"
;     "fn? / seq? / boolean"                                     → w14-fn-q-seq-q-boolean
;     "find returns the map entry as a [key value] vector…"      → w14-find-returns-entry-vector
;     "contains? checks KEYS for maps and INDICES for vectors…"  → w14-contains-keys-and-indices
;     "type predicates"                                         → w14-type-predicates
;   wave14 "jank core.jank slices unlocked by this wave"
;     "some + not-any? (slices 08, 09)…"                         → w14-jank-some-not-any
;     "comp (slice 04)…"                                         → w14-jank-comp
;     "partial (slice 06)…"                                      → w14-jank-partial
;     "juxt (slice 05)…"                                         → w14-jank-juxt
;     "trampoline (slice 19)…"                                   → w14-jank-trampoline
;
;   wave15 "the *-suffixed primitives"
;     "loop* is the primitive beneath loop"                      → w15-loop-star-primitive
;     "let* and fn* are the primitives beneath let and fn"       → w15-let-star-fn-star-primitives
;   wave15 "form metadata"
;     "meta reads what with-meta attached, nil when absent"      → w15-meta-reads-with-meta
;     "with-meta nil clears"                                     → w15-with-meta-nil-clears
;     "a with-meta'd form compiles identically (macro round-trip)"→ w15-with-meta-form-compiles-identically
;     "metadata round-trips through a macro…"                    → w15-metadata-round-trips-through-macro
;     "form metadata never leaks into value equality or printing"→ w15-form-metadata-never-leaks
;   wave15 "&form and &env"
;     "&form is the whole macro call form"                       → w15-form-is-the-whole-call
;     "&env is the compile-time locals map"                      → w15-env-is-compile-time-locals
;   wave15 "clojure.core alias"
;     "qualified clojure.core/ names resolve to beam-lisp's core"→ w15-clojure-core-alias
;   wave15 "assert-macro-args"
;     "accepts a valid shape and returns nil"                    → w15-assert-macro-args-valid
;     "throws naming the failing macro from &form"               → w15-assert-macro-args-throws-naming-macro
;     "checks all conditions in sequence"                        → w15-assert-macro-args-checks-in-sequence
;   wave15 "jank core.jank macro slices (loaded verbatim)"
;     "-> threads the first argument (slice_10)"                 → w15-jank-thread-first
;     "->> threads the last argument (slice_11)"                 → w15-jank-thread-last
;     "if-let binds the test value in the then branch (slice_13)"→ w15-jank-if-let
;     "when-let runs the body only when the test is truthy (14)" → w15-jank-when-let
;     "dotimes repeats the body with i from 0..n-1 (slice_16)"   → w15-jank-dotimes
;     "doto threads x through each form and returns x (slice_18)"→ w15-jank-doto
;     "memoize caches by arguments (slice_21, needs if-let)"     → w15-jank-memoize
;     "doseq loads verbatim (slice_17); behavior gated on RT"    → w15-jank-doseq-loads
;
; Fidelity notes
;   · Helpers mirror the ExUnit ones EXACTLY. `fixture_code`/`load_slice`/
;     `eval_in` are the same `File.read! |> split |> reject ";" |> join` +
;     `Compiler.eval_string(source, Compiler.new_env(ns))` the originals used,
;     so every vendored slice is still loaded verbatim (minus its `;` header).
;   · `ev` reproduces the ExUnit `setup` + `BeamLisp.eval/1` pair. wave15's
;     setup added `Env.in_ns("user")`; wave14's did not, but every wave14 prim
;     asserted here is namespace-independent, so one `user`-bound `ev` serves
;     both — the same source strings the ExUnit `assert eval(...) == …`
;     compared.
;   · List-vs-vector. The ExUnit `eval` returned Elixir terms, so `next`/`list*`/
;     `map`/`apply`-list all compared `== [..]` (an Elixir LIST). Here those
;     producers yield beam-lisp LISTS, which `=` distinguishes from vectors, so
;     the assertions pin `'(…)`; `find`/`juxt`/`dotimes`/doto still yield
;     vectors and keep `[…]`.
;   · `Test.realize/1` (wave15 clojure.core/map and ->>) has no port: `=` forces
;     a lazy seq structurally, so the realized value is pinned directly.
;   · `assert_raise`/`rescue → Exception.message` → a `try` around the runtime
;     `ev` call (so the macro-expansion CompileError is raised INSIDE the call
;     and is catchable) with `includes?` on the message needle the ExUnit
;     matched with `=~`.
;   · `match?({:"$macro", _}, load_slice(...))` → tuple + element 1 checks.
;
; Run: bin/bl test test/bl/wave1415_seq_macro_test.bl

(ns wave1415.seq-macro.test)

; ── helpers ────────────────────────────────────────────────────────────────

(defn- ev
  "Evaluate `src` at `*ns*` = \"user\" — the port of the ExUnit `setup` +
   `BeamLisp.eval/1` pair (wave15's `Env.in_ns(\"user\")`; harmless for wave14's
   ns-independent prims)."
  [src]
  (BeamLisp.Env/with_ns "user" (fn [] (BeamLisp/eval src))))

; The fixture minus its `;` provenance header — the same harness as
; jank_compat_test.exs / the ExUnit originals.
(defn- fixture-code
  [fixture]
  (-> (File/read! (Path/join (list "test" "fixtures" "jank" fixture)))
      (String/split "\n")
      (Enum/reject (fn [line] (String/starts_with? line ";")))
      (Enum/join "\n")))

(defn- load-slice
  "Load a vendored jank slice into `ns`, wrapped in a throwaway `(ns <ns>)`."
  [fixture ns]
  (BeamLisp.Compiler/eval_string
    (str "(ns " ns ")\n" (fixture-code fixture))
    (BeamLisp.Compiler/new_env ns)))

(defn- ev-in
  "Evaluate `src` against a fresh `Compiler.new_env(ns)` — the ExUnit
   `Compiler.eval_string(source, Compiler.new_env(ns))` helper."
  [ns src]
  (BeamLisp.Compiler/eval_string src (BeamLisp.Compiler/new_env ns)))

; ══ wave14_seq_test.exs ════════════════════════════════════════════════════

; ── describe "next — nil-vs-empty is the contract" (3) ─────────────────────

(deftest w14-next-nil-vs-empty
  (is (nil? (ev "(next nil)")))
  (is (nil? (ev "(next '())")))
  (is (nil? (ev "(next [])")))
  (is (nil? (ev "(next '(1))")))
  (is (nil? (ev "(next [1])")))
  (is (= '(2) (ev "(next '(1 2))")))
  (is (= '(2 3) (ev "(next '(1 2 3))")))
  (is (= '(2 3) (ev "(next [1 2 3])"))))

(deftest w14-next-drives-the-if-idiom
  (is (= :done (ev "(if (next '(1)) :more :done)")))
  (is (= :more (ev "(if (next '(1 2)) :more :done)")))
  (is (= :more (ev "(if (next [1 2 3]) :more :done)"))))

(deftest w14-next-over-a-lazys-eq-forces-head
  ; Clojure's `next` is `(seq (rest x))`: it must realize the tail to answer
  ; nil-vs-empty, and returning an unrealized tail would make an exhausted seq
  ; truthy. map chunks at 32, so `rest` and `next` each force one chunk — the
  ; counting evals are the laziness contract the ExUnit test pinned.
  (is (= 32 (ev "(let [n (atom 0) s (map (fn [x] (swap! n inc) x) (range))] (rest s) (deref n))")))
  (is (= 32 (ev "(let [n (atom 0) s (map (fn [x] (swap! n inc) x) (range))] (next s) (deref n))")))
  (is (= '(1 2) (ev "(next (range 3))")))
  (is (nil? (ev "(next (range 1))")))
  ; next of an infinite lazy seq is non-nil (a LazySeq tail), not a force.
  (is (= :more (ev "(if (next (range)) :more :done)"))))

; ── describe "list* — variadic cons onto the final collection" (1) ─────────

(deftest w14-list-star-prepends-onto-seq
  (is (= '(1 2 3 4) (ev "(list* 1 2 [3 4])")))
  (is (= '(1 2 3 4) (ev "(list* 1 2 '(3 4))")))
  (is (= '(1) (ev "(list* 1 [])")))
  (is (= '(1 2) (ev "(list* 1 2 [])")))
  (is (= '(3 4) (ev "(list* '(3 4))")))
  (is (nil? (ev "(list*)"))))

; ── describe "variadic apply — leading args prepend the final seq" (2) ─────

(deftest w14-apply-2-arity
  (is (= 6 (ev "(apply + [1 2 3])")))
  (is (= 6 (ev "(apply + '(1 2 3))")))
  (is (= '(1 2) (ev "(apply (fn [& xs] xs) [1 2])"))))

(deftest w14-apply-leading-args-prepend
  (is (= 6 (ev "(apply + 1 [2 3])")))
  (is (= 10 (ev "(apply + 1 2 [3 4])")))
  (is (= 10 (ev "(apply + 1 2 3 [4])")))
  (is (= '(1 2 3 4) (ev "(apply list 1 2 [3 4])")))
  (is (= '(1 2 3) (ev "(apply (fn [a b c] (list a b c)) 1 2 [3])"))))

; ── describe "reduce 2-arity — folds without an initial accumulator" (1) ───

(deftest w14-reduce-2-arity
  (is (= 10 (ev "(reduce + [1 2 3 4])")))
  (is (= 24 (ev "(reduce * [2 3 4])")))
  (is (= 0 (ev "(reduce + [])")))
  (is (= "abc" (ev "(reduce (fn [a b] (str a b)) [\"a\" \"b\" \"c\"])"))))

; ── describe "predicate and utility prims (Clojure-correct)" (4) ───────────

(deftest w14-fn-q-seq-q-boolean
  (is (= true (ev "(fn? (fn [x] x))")))
  (is (= true (ev "(fn? (fn ([x] x) ([x y] y)))")))
  (is (= false (ev "(fn? 5)")))
  (is (= false (ev "(fn? :a)")))
  (is (= true (ev "(seq? '(1 2))")))
  (is (= false (ev "(seq? [])")))
  (is (= false (ev "(seq? nil)")))
  (is (= false (ev "(boolean nil)")))
  (is (= false (ev "(boolean false)")))
  (is (= true (ev "(boolean 0)")))
  (is (= true (ev "(boolean \"\")"))))

(deftest w14-find-returns-entry-vector
  ; ExUnit: Vector.new([:a, 1]); find yields a two-element vector.
  (is (= [:a 1] (ev "(find {:a 1} :a)")))
  (is (nil? (ev "(find {:a 1} :b)")))
  (is (nil? (ev "(find nil :a)")))
  (is (= [:a 7] (ev "(find {:a 7} :a)"))))

(deftest w14-contains-keys-and-indices
  (is (= true (ev "(contains? {:a 1} :a)")))
  (is (= false (ev "(contains? {:a 1} 1)")))
  (is (= false (ev "(contains? {:a 1} :b)")))
  (is (= false (ev "(contains? {} :a)")))
  (is (= true (ev "(contains? [10 20 30] 0)")))
  (is (= true (ev "(contains? [10 20 30] 2)")))
  (is (= false (ev "(contains? [10 20 30] 3)")))
  (is (= false (ev "(contains? [10 20 30] 30)")))
  (is (= false (ev "(contains? nil :a)"))))

(deftest w14-type-predicates
  (is (= true (ev "(keyword? :a)")))
  (is (= false (ev "(keyword? true)")))
  (is (= false (ev "(keyword? nil)")))
  (is (= false (ev "(keyword? \"a\")")))
  (is (= true (ev "(symbol? 'a)")))
  (is (= false (ev "(symbol? :a)")))
  (is (= true (ev "(string? \"abc\")")))
  (is (= false (ev "(string? :a)")))
  (is (= true (ev "(number? 1)")))
  (is (= true (ev "(number? 1.5)")))
  (is (= true (ev "(int? 1)")))
  (is (= false (ev "(int? 1.5)")))
  (is (= true (ev "(map? {:a 1})")))
  (is (= false (ev "(map? [1])")))
  (is (= true (ev "(vector? [1 2])")))
  (is (= false (ev "(vector? '(1 2))")))
  (is (= true (ev "(list? '(1 2))")))
  (is (= false (ev "(list? [1 2])")))
  (is (= false (ev "(list? nil)")))
  (is (= true (ev "(coll? [1 2])")))
  (is (= true (ev "(coll? '(1 2))")))
  (is (= true (ev "(coll? {:a 1})")))
  (is (= true (ev "(coll? (range 3))")))
  (is (= false (ev "(coll? nil)")))
  (is (= true (ev "(ident? :a)")))
  (is (= true (ev "(ident? 'a)")))
  (is (= false (ev "(ident? 5)"))))

; ── describe "jank core.jank slices unlocked by this wave" (5) ─────────────

(deftest w14-jank-some-not-any
  ; Loaded into one shared ns within a single test: `not-any?` calls `some`,
  ; exactly as they resolve each other in clojure.core.
  (load-slice "slice_08_some.bl" "jank.w14.seq")
  (load-slice "slice_09_not_any.bl" "jank.w14.seq")
  (is (= true (ev-in "jank.w14.seq" "(some even? [1 2 3])")))
  (is (nil? (ev-in "jank.w14.seq" "(some even? [1 3 5])")))
  ; first selector result is nil (falsy) → recurse via `next` → the exact
  ; path next unlocks.
  (is (= 7 (ev-in "jank.w14.seq" "(some :a [{:a nil} {:a 7}])")))
  (is (nil? (ev-in "jank.w14.seq" "(some :a [])")))
  (is (= true (ev-in "jank.w14.seq" "(not-any? even? [1 3 5])")))
  (is (= false (ev-in "jank.w14.seq" "(not-any? even? [1 2 3])")))
  (is (= true (ev-in "jank.w14.seq" "(not-any? odd? [])"))))

(deftest w14-jank-comp
  (load-slice "slice_04_comp.bl" "jank.w14.comp")
  (is (= 7 (ev-in "jank.w14.comp" "((comp inc inc) 5)")))
  ; the ([f g & fs] …) clause: (reduce comp (list* f g fs))
  (is (= 3 (ev-in "jank.w14.comp" "((comp inc inc inc) 0)")))
  (is (= "4" (ev-in "jank.w14.comp" "((comp str inc) 3)"))))

(deftest w14-jank-partial
  (load-slice "slice_06_partial.bl" "jank.w14.partial")
  (is (= 6 (ev-in "jank.w14.partial" "((partial + 1) 2 3)")))
  ; 4+ fixed clause: (fn [& args] (apply f arg1 arg2 arg3 (concat more args)))
  (is (= 15 (ev-in "jank.w14.partial" "((partial + 1 2 3 4) 5)")))
  (is (= 15 (ev-in "jank.w14.partial" "((partial + 1 2 3) 4 5)"))))

(deftest w14-jank-juxt
  (load-slice "slice_05_juxt.bl" "jank.w14.juxt")
  (is (= [6 4] (ev-in "jank.w14.juxt" "((juxt inc dec) 5)")))
  ; the ([f g h & fs] …) clause: reduce conj over (list* f g h fs)
  (is (= [6 6 6 4] (ev-in "jank.w14.juxt" "((juxt inc inc inc dec) 5)"))))

(deftest w14-jank-trampoline
  (load-slice "slice_19_trampoline.bl" "jank.w14.tramp")
  ; 1-arity: `(if (fn? ret) (recur ret) ret)` — fn? is the dispatch prim
  (is (= 42 (ev-in "jank.w14.tramp" "(trampoline (fn [] 42))")))
  (is (= true
         (ev-in "jank.w14.tramp"
                "(defn e? [n] (if (zero? n) true (fn [] (o? (dec n)))))
                 (defn o? [n] (if (zero? n) false (fn [] (e? (dec n)))))
                 (trampoline (fn [] (e? 10000)))"))))

; ══ wave15_macro_test.exs ══════════════════════════════════════════════════

; ── describe "the *-suffixed primitives" (2) ───────────────────────────────

(deftest w15-loop-star-primitive
  (is (= '(2 1 0) (ev "(loop* [i 0 acc ()] (if (< i 3) (recur (+ i 1) (cons i acc)) acc))")))
  ; recur targets the innermost loop, exactly as with `loop`
  (is (= 3 (ev "(loop* [i 0] (if (< i 3) (recur (+ i 1)) i))")))
  (is (= '(2 1 0) (ev "(loop* [i 0 acc ()] (if (< i 3) (recur (+ i 1) (cons i acc)) acc))"))))

(deftest w15-let-star-fn-star-primitives
  (is (= 3 (ev "(let* [x 1 y 2] (+ x y))")))
  (is (= 6 (ev "((fn* [x] (+ x 1)) 5)")))
  ; fn* supports the named form jank's head uses
  (is (= 3 (ev "((fn* named-fn [x] (if (= x 0) 0 (+ 1 (named-fn (- x 1))))) 3)"))))

; ── describe "form metadata" (5) ───────────────────────────────────────────

(deftest w15-meta-reads-with-meta
  (is (= {:line 7} (ev "(meta (with-meta '(1 2) {:line 7}))")))
  (is (nil? (ev "(meta '(1 2))")))
  (is (= {:file "x.bl" :line 3} (ev "(meta (with-meta '(+ 1 2) {:file \"x.bl\" :line 3}))"))))

(deftest w15-with-meta-nil-clears
  (is (nil? (ev "(meta (with-meta (with-meta '(1) {:a 1}) nil))"))))

(deftest w15-with-meta-form-compiles-identically
  ; The macro carries metadata on the form it returns; the compiler strips it
  ; before codegen, so the value is unaffected.
  (is (= 5 (ev "(defmacro tm [x] (with-meta `(inc ~x) {:line 1})) (tm 4)")))
  (is (= true (ev "(defmacro tm [x] (with-meta `(inc ~x) {:line 1})) (= (tm 4) (tm 4))")))
  (is (= 3 (ev "(defmacro tm [x] (with-meta x {:line 1})) (tm (+ 1 2))"))))

(deftest w15-metadata-round-trips-through-macro
  ; Attach meta to a form datum, read it back inside the same macro.
  (is (= true
         (ev "(defmacro roundtrip [x] (let [t (with-meta x {:line 99})] (= 99 (get (meta t) :line)))) (roundtrip (+ 1 2))")))
  ; with-meta nil clears the wrapper back to the bare form.
  (is (nil? (ev "(meta (with-meta (with-meta '(1) {:a 1}) nil))"))))

(deftest w15-form-metadata-never-leaks
  ; The compiled value of a with-meta'd form is the bare form's value.
  (is (= true (ev "(defmacro m1 [x] (with-meta `(identity ~x) {:a 1})) (= (m1 5) 5)")))
  (is (= 2 (ev "(defmacro m2 [x] (with-meta `(+ ~x 1) {:a 1})) (m2 1)"))))

; ── describe "&form and &env" (2) ──────────────────────────────────────────

(deftest w15-form-is-the-whole-call
  (is (= true (ev "(defmacro name-of [& _] (= (first &form) 'name-of)) (name-of 1 2)")))
  (is (= true
         (ev "(defmacro head-is? [x] (and (list? &form) (= (first &form) 'head-is?))) (head-is? 5)"))))

(deftest w15-env-is-compile-time-locals
  (is (= true (ev "(defmacro has-x? [] (contains? &env 'x)) (defn f [x] (has-x?)) (f 1)")))
  (is (= false (ev "(defmacro has-x? [] (contains? &env 'x)) (defn g [a] (has-x?)) (g 1)"))))

; ── describe "clojure.core alias" (1) ──────────────────────────────────────

(deftest w15-clojure-core-alias
  (is (= 6 (ev "(clojure.core/inc 5)")))
  (is (= "1a" (ev "(clojure.core/str 1 \"a\")")))
  (is (= false (ev "(clojure.core/not 3)")))
  ; ExUnit wrapped in Test.realize/1; `=` forces the lazy seq, so the realized
  ; value is pinned directly.
  (is (= '(2 3 4) (ev "(clojure.core/map clojure.core/inc [1 2 3])")))
  ; as a value (a var, not a call)
  (is (= true (ev "(fn? clojure.core/inc)"))))

; ── describe "assert-macro-args" (3) ───────────────────────────────────────

(deftest w15-assert-macro-args-valid
  (is (nil?
        (ev "(defmacro v [bindings] (assert-macro-args (vector? bindings) \"a vector\")) (v [1])"))))

(deftest w15-assert-macro-args-throws-naming-macro
  ; The failing macro source is compiled INSIDE the runtime `ev` call (exactly
  ; as the ExUnit wrapped `eval/1` in a try), so the expansion error is raised
  ; within the call and is catchable here.
  (let [err (try
              (do (ev "(defmacro bad [bindings] (assert-macro-args (vector? bindings) \"a vector\")) (bad 5)")
                  nil)
              (catch e (ex-message e)))]
    (is (includes? err "bad requires a vector"))))

(deftest w15-assert-macro-args-checks-in-sequence
  (let [err (try
              (do (ev "(defmacro bad2 [bindings] (assert-macro-args (vector? bindings) \"a vector\" (= 2 (count bindings)) \"exactly 2 forms\")) (bad2 [1 2 3])")
                  nil)
              (catch e (ex-message e)))]
    (is (includes? err "bad2 requires exactly 2 forms"))))

; ── describe "jank core.jank macro slices (loaded verbatim)" (8) ───────────

(deftest w15-jank-thread-first
  (load-slice "slice_10_thread_macro.bl" "w15.thread")
  (is (= 7 (ev-in "w15.thread" "(-> 5 inc inc)")))
  (is (= 12 (ev-in "w15.thread" "(-> 5 (+ 1) (* 2))")))
  (is (= :a (ev-in "w15.thread" "(-> :a identity)"))))

(deftest w15-jank-thread-last
  (load-slice "slice_11_thread_last_macro.bl" "w15.threadl")
  (is (= '(3 4 5) (ev-in "w15.threadl" "(->> [1 2 3] (map inc) (map inc))")))
  (is (= -4 (ev-in "w15.threadl" "(->> 5 (- 1))"))))

(deftest w15-jank-if-let
  (load-slice "slice_13_if_let.bl" "w15.iflet")
  (is (= 5 (ev-in "w15.iflet" "(if-let [x 5] x :none)")))
  (is (= :none (ev-in "w15.iflet" "(if-let [x nil] x :none)")))
  ; the 2-arity form (no else) yields nil on a falsy test
  (is (nil? (ev-in "w15.iflet" "(if-let [x false] x)"))))

(deftest w15-jank-when-let
  (load-slice "slice_14_when_let.bl" "w15.whenlet")
  (is (= 5 (ev-in "w15.whenlet" "(when-let [x 5] x)")))
  (is (nil? (ev-in "w15.whenlet" "(when-let [x nil] x)"))))

(deftest w15-jank-dotimes
  (load-slice "slice_16_dotimes.bl" "w15.dotimes")
  (is (= [0 1 2 3]
         (ev-in "w15.dotimes" "(def a (atom [])) (dotimes [i 4] (swap! a conj i)) (deref a)"))))

(deftest w15-jank-doto
  (load-slice "slice_18_doto.bl" "w15.doto")
  (let [a (ev-in "w15.doto" "(doto (atom []) (swap! conj 1) (swap! conj 2))")]
    (is (= [1 2] (deref a)))))

(deftest w15-jank-memoize
  ; key/val come from slice_12, co-loaded as upstream itself requires
  (load-slice "slice_12_map_entries.bl" "w15.memo")
  (load-slice "slice_21_memoize.bl" "w15.memo")
  (is (= 9 (ev-in "w15.memo" "(def mm (memoize (fn [x] (* x x)))) (mm 3)")))
  (is (= 16 (ev-in "w15.memo" "(mm 4)")))
  ; a repeat call hits the cache — same result
  (is (= 9 (ev-in "w15.memo" "(mm 3)"))))

(deftest w15-jank-doseq-loads
  ; The doseq macro itself loads: its definition compiles against the macro
  ; surface (assert-macro-args, when-let, gensym, cond, nnext…). Behavior is
  ; gated on `(steppair 0)` — an RT.invoke gap, not this wave — so the original
  ; `match?({:"$macro", _}, …)` is preserved as ONE tuple + element check.
  (let [r (load-slice "slice_17_doseq.bl" "w15.doseq")]
    (is (and (erlang/is_tuple r) (= (keyword "$macro") (erlang/element 1 r))))))
