; test/bl/is_map_lint_test.bl — the "struct is a map" lint, ported from
; `test/beam_lisp/is_map_lint_test.exs`.
;
; Source-level lint, NOT a runtime check: this file never evaluates beam-lisp
; source, so it is a pure scan over repository files.
;
; On the BEAM a struct IS a map: `is_map(%BeamLisp.Vector{})` is `true`, because
; a struct is a map carrying a `:__struct__` key. beam-lisp has 11 struct kinds
; (Vector, Set, LazySeq, the references Atom/Ref/Volatile/Agent/Task, Transient,
; and user records) that must never take a "beam-lisp map" collection path.
; Collection fns in `BeamLisp.Ns.Rt` guard their plain-map clauses with
; `BeamLisp.Guards.is_bl_map/1`; the genuine exceptions are annotated
; `# is_map-ok: <reason>`.
;
; Nothing previously prevented someone reintroducing a bare `is_map(` — and
; "a moduledoc is a claim, not proof": 38 of 40 sites had decayed before the
; guards landed. This test scans every `.ex` under `lib/` and fails on any bare
; `is_map(` that is not one of the sanctioned forms, so the NEXT contributor
; (or agent that has never read the bug report) trips on it the moment they
; reintroduce the footgun.
;
; The rule, deliberately:
;   * `is_map(x) and not is_struct(x)` — the correct inline form — is fine.
;   * `lib/beam_lisp/guards.ex` is where `is_bl_map/1` is DEFINED; exempt.
;   * an `# is_map-ok: <reason>` comment on the line or within the ~3 lines
;     above marks a deliberate "any map, structs included" call site.
;   * `is_map` mentioned inside a comment, moduledoc, or heredoc string is
;     prose, not code — never flagged.
;   * `not is_map(x)` is SAFE and deliberately not flagged: it asserts the
;     argument is NOT a map, and since every struct IS a map it can never
;     admit a struct onto a map path. The footgun is only the positive test
;     `is_map(x)` that swallows structs. Negation is a documented decision,
;     not an oversight.
;   * `is_map_key/2` is a different Erlang guard; `is_bl_map(` is the guard
;     this lint protects — neither is `is_map(`, so neither matches.
;
; ── coverage map (ExUnit test → BL deftest) ────────────────────────────────
; All eighteen ExUnit tests map one-to-one onto a same-named BL deftest, in the
; original order, assertion for assertion. The scanner is the SAME pure
; `{filename, source} → [violation]` function; the last test is the end-to-end
; walk of the real tree.
;
; ADAPTATIONS (ExUnit → ward), and why:
;   * The scanner is byte-for-byte the same state machine. Elixir's
;     `String.to_charlist`/`List.to_string` become `binary_to_list`/
;     `list_to_binary` — masking only ever has to recognise ASCII delimiters,
;     so bytes and codepoints coincide and the round-trip is exact. Charm
;     literals (`?"`) become their integer codes (34, 35, 92, 10).
;   * `Regex.scan(re, code, return: :index)` → `Regex/scan` with the same
;     `return: :index` option; each match is a one-element group list whose
;     entry is the `{pos, len}` tuple.
;   * `violations/1` answers a VECTOR, not a lazy seq, so the fixture
;     assertions compare like for like (`[]` is a beam-lisp vector literal).
;   * `assert [%{file:, line:, text:}] = …` keeps the same field values; the
;     one-field partial matches (`[%{line: 2}]`) become an explicit count plus
;     a field read, which is what the partial match asserted.
;   * `assert msg =~ "…"` → `(is (includes? msg "…"))`.
;
; Run: bin/bl test test/bl/is_map_lint_test.bl

(ns is.map.lint.test)

; ── the scanner. Pure over {filename, source_string} → [violation]. ────────

(def ^:private is-map-call-re (Regex/compile! "is_map\\("))
(def ^:private negation-prefix-re (Regex/compile! "not\\s*\\(?\\s*$"))
(def ^:private inline-conjunction-re
  (Regex/compile! "^is_map\\([^)]*\\)\\s+and\\s+not\\s+is_struct\\("))
(def ^:private guard-definition-re (Regex/compile! "(^|/)lib/beam_lisp/guards\\.ex$"))

(defn- triple-quote?
  "Whether `cs` opens (or closes) a `\"\"\"` heredoc."
  [cs]
  (and (erlang/== 34 (first cs))
       (>= (count cs) 3)
       (erlang/== 34 (nth cs 1))
       (erlang/== 34 (nth cs 2))))

; The state machine over the file's bytes. :code — normal text; `#` opens a
; comment, `\"\"\"` a heredoc, `\"` a string. Every masked byte becomes a space so
; byte offsets (and therefore `is_map(` positions and `binary_part` slices)
; survive; every newline is preserved so line numbers hold.
(defn- do-mask [cs state]
  (if (empty? cs)
    (list)
    (cond
      (erlang/== state :code)
      (cond
        (triple-quote? cs) (erlang/++ (list 32 32 32) (do-mask (drop 3 cs) :heredoc))
        (erlang/== 35 (first cs)) (erlang/++ (list 32) (do-mask (rest cs) :comment))
        (erlang/== 34 (first cs)) (erlang/++ (list 32) (do-mask (rest cs) :string))
        :else (erlang/++ (list (first cs)) (do-mask (rest cs) :code)))

      ; :comment — through end of line (newline returns to :code).
      (erlang/== state :comment)
      (if (erlang/== 10 (first cs))
        (erlang/++ (list 10) (do-mask (rest cs) :code))
        (erlang/++ (list 32) (do-mask (rest cs) :comment)))

      ; :string — a `"..."` literal; `\"` is escaped, a newline is preserved
      ; defensively (a real Elixir string cannot span lines).
      (erlang/== state :string)
      (cond
        (and (erlang/== 92 (first cs))
             (not (empty? (rest cs)))
             (erlang/== 34 (first (rest cs))))
        (erlang/++ (list 32 32) (do-mask (drop 2 cs) :string))

        (or (erlang/== 10 (first cs)) (erlang/== 34 (first cs)))
        (erlang/++ (list (first cs)) (do-mask (rest cs) :code))

        :else (erlang/++ (list 32) (do-mask (rest cs) :string)))

      ; :heredoc — a `\"\"\"...\"\"\"` moduledoc/docstring; newlines preserved.
      :else
      (cond
        (triple-quote? cs) (erlang/++ (list 32 32 32) (do-mask (drop 3 cs) :code))
        (erlang/== 10 (first cs)) (erlang/++ (list 10) (do-mask (rest cs) :heredoc))
        :else (erlang/++ (list 32) (do-mask (rest cs) :heredoc))))))

(defn- mask
  "Mask every comment/string/heredoc span of `source` to spaces, preserving
   byte offsets and newlines, so only CODE is ever scanned."
  [source]
  (erlang/list_to_binary (do-mask (erlang/binary_to_list source) :code)))

(defn- mask-lines [lines]
  (String/split (mask (Enum/join lines "\n")) "\n"))

; Every `is_map(` byte index in the code-only view of a line. Note the token is
; `is_map` *immediately* followed by `(` — so `is_map_key(` (which reads
; `is_map_key(`) and `is_bl_map(` (which reads `is_bl_map(`) never match here
; by construction.
(defn- is-map-call-indexes [code]
  (map (fn [m] (erlang/element 1 (first m)))
       (Regex/scan is-map-call-re code (list (tuple :return :index)))))

; `not is_map(x)` / `not(is_map(x))` — negation, safe (see the header).
(defn- negation? [code idx]
  (Regex/match? negation-prefix-re (erlang/binary_part code 0 idx)))

; The correct inline form, `is_map(x) and not is_struct(x)`, possibly with the
; conjunction wrapped across lines. Look forward up to 3 lines and match
; anchored at the call site so only THIS `is_map(` is checked.
(defn- inline-conjunction? [masked n idx]
  (let [forward (Enum/join (take 3 (drop (- n 1) masked)) " ")
        from (erlang/binary_part forward idx (- (erlang/byte_size forward) idx))]
    (Regex/match? inline-conjunction-re from)))

; An `# is_map-ok:` comment on the line itself or any of the ~3 lines directly
; above (the existing exemptions put it there; e.g. compiler.ex, meta.ex,
; form_meta.ex all span 0–3 lines).
(defn- ok-comment? [lines n]
  (some (fn [l] (String/contains? l "is_map-ok:"))
        (take 4 (drop (max (- n 4) 0) lines))))

(defn- exempt? [code masked lines n idx]
  (or (negation? code idx)
      (inline-conjunction? masked n idx)
      (ok-comment? lines n)))

; Only `lib/beam_lisp/guards.ex` — the canonical definition — is exempt.
(defn- guard-definition-file? [filename]
  (Regex/match? guard-definition-re filename))

(defn violations
  "Returns every unsanctioned `is_map(` in `source` as a vector of
   `{:file filename :line n :text raw_line}`."
  [[filename source]]
  (if (guard-definition-file? filename)
    []
    (let [lines (String/split source "\n")
          masked (mask-lines lines)]
      (vec
        (mapcat
          (fn [pair]
            (let [i (first pair)
                  raw (second pair)
                  n (+ i 1)
                  code (nth masked i)]
              (map (fn [_] {:file filename :line n :text raw})
                   (filter (fn [idx] (not (exempt? code masked lines n idx)))
                           (is-map-call-indexes code)))))
          (map-indexed (fn [i l] [i l]) lines))))))

; ── failure rendering — written for the 2am reader with no context. ────────

(defn- render-one [v]
  (str (:file v) ":" (:line v) "\n"
       "    " (String/trim (:text v)) "\n"
       "\n"
       "is_map/1 is true for EVERY struct -- a struct is a map carrying a\n"
       ":__struct__ key. beam-lisp has 11 struct types (Vector, Set, LazySeq,\n"
       "Atom, Ref, Volatile, Agent, Task, Transient, records) that must never\n"
       "take a \"beam-lisp map\" path.\n"
       "\n"
       "  * If you mean \"a beam-lisp map\": use BeamLisp.Guards.is_bl_map/1.\n"
       "  * If you genuinely mean \"any map, structs included\": add a comment\n"
       "    `# is_map-ok: <why this accepts structs too>` above or on the line.\n"))

(defn render [violations]
  (Enum/join (map render-one violations) "\n\n"))

; ── unit tests — the rule, proven on fixture strings without touching lib/. ─

(deftest bare-is-map-is-flagged
  (let [src "def f(x) when is_map(x), do: x\n"]
    (is (= [{:file "foo.ex" :line 1 :text "def f(x) when is_map(x), do: x"}]
           (violations ["foo.ex" src])))))

(deftest bare-is-map-on-a-later-line-reports-the-right-line-number
  (let [src "defmodule Foo do\n  def f(x) when is_map(x), do: x\nend\n"
        v (violations ["foo.ex" src])]
    (is (= 1 (count v)))
    (is (= 2 (:line (first v))))))

(deftest inline-conjunction-is-map-and-not-is-struct-is-not-flagged
  (let [src "def f(x) when is_map(x) and not is_struct(x), do: x\n"]
    (is (= [] (violations ["foo.ex" src])))))

(deftest multi-line-conjunction-and-not-is-struct-is-not-flagged
  (let [src "def f(x) when is_map(x) and\n    not is_struct(x), do: x\n"]
    (is (= [] (violations ["foo.ex" src])))))

(deftest is-map-ok-comment-on-the-same-line-is-not-flagged
  (let [src "def f(x) when is_map(x), do: x # is_map-ok: internal meta map\n"]
    (is (= [] (violations ["foo.ex" src])))))

(deftest is-map-ok-comment-on-the-directly-preceding-line-is-not-flagged
  (let [src (str "# is_map-ok: internal meta map\n" "def f(x) when is_map(x), do: x\n")]
    (is (= [] (violations ["foo.ex" src])))))

(deftest is-map-ok-comment-up-to-three-lines-above-is-not-flagged
  (let [src (str "# is_map-ok: reader position map (:line/:col/:file), never user data\n"
                 "# -- two blank-ish comment lines between the reason and the call.\n"
                 "defp pos_env(env, m) when is_map(m) do\n"
                 "  env\n"
                 "end\n")]
    (is (= [] (violations ["foo.ex" src])))))

(deftest is-map-key-is-a-different-guard-and-is-not-flagged
  (let [src "def f(k, m) when is_map_key(k, m), do: :ok\n"]
    (is (= [] (violations ["foo.ex" src])))))

(deftest is-bl-map-is-the-guard-this-lint-protects-and-is-not-flagged
  (let [src "def f(x) when is_bl_map(x), do: x\n"]
    (is (= [] (violations ["foo.ex" src])))))

(deftest not-is-map-is-safe-and-is-not-flagged
  ; Documented decision: negation can never admit a struct onto a map path, so
  ; it is not the footgun — see the header.
  (let [src "def f(x) when not is_map(x), do: :not_map\n"]
    (is (= [] (violations ["foo.ex" src])))))

(deftest is-map-in-guards-ex-is-exempt
  (let [src "defguard is_bl_map(x) when is_map(x) and not is_struct(x)\n"]
    (is (= [] (violations ["lib/beam_lisp/guards.ex" src])))))

(deftest the-guards-ex-exemption-is-keyed-on-the-filename-not-the-content
  ; Rule 2 exempts the whole definition file; the SAME source under a different
  ; name is still fully checked.
  (let [src (str "defguard is_bl_map(x) when is_map(x) and not is_struct(x)\n"
                 "def g(y) when is_map(y), do: y\n")]
    (is (= [] (violations ["lib/beam_lisp/guards.ex" src])))
    (let [v (violations ["some/other.ex" src])]
      (is (= 1 (count v)))
      (is (= 2 (:line (first v)))))))

(deftest is-map-inside-a-moduledoc-is-prose-not-code-and-is-not-flagged
  (let [src (str "defmodule Foo do\n"
                 "  @moduledoc \"\"\"\n"
                 "  is_map(%BeamLisp.Vector{}) is true because a struct is a map with a\n"
                 "  :__struct__ key, so is_map( alone cannot tell them apart.\n"
                 "  \"\"\"\n"
                 "\n"
                 "  def f(x) when is_struct(x), do: x\n"
                 "end\n")]
    (is (= [] (violations ["foo.ex" src])))))

(deftest is-map-inside-an-inline-comment-is-prose-and-is-not-flagged
  (let [src (str "# never call is_map( on user data\n" "def f(x), do: x\n")]
    (is (= [] (violations ["foo.ex" src])))))

(deftest is-map-inside-a-regular-string-literal-is-not-flagged
  (let [src "msg = \"is_map( on a struct returns true\"\n"]
    (is (= [] (violations ["foo.ex" src])))))

(deftest a-moduledoc-mentioning-is-map-does-not-mask-a-real-violation-elsewhere
  (let [src (str "defmodule Foo do\n"
                 "  @moduledoc \"\"\"\n"
                 "  is_map( is the footgun; prefer is_bl_map/1.\n"
                 "  \"\"\"\n"
                 "\n"
                 "  def f(x) when is_map(x), do: x\n"
                 "end\n")
        v (violations ["foo.ex" src])]
    (is (= 1 (count v)))
    (is (= 6 (:line (first v))))))

(deftest the-rendered-failure-names-the-file-line-text-hazard-and-both-remedies
  (let [v (violations ["foo.ex" "def f(x) when is_map(x), do: x\n"])
        msg (render v)]
    (is (includes? msg "foo.ex:1"))
    (is (includes? msg "def f(x) when is_map(x), do: x"))
    (is (includes? msg "is_map/1 is true for EVERY struct"))
    (is (includes? msg "use BeamLisp.Guards.is_bl_map/1"))
    (is (includes? msg "is_map-ok:"))))

; ── end-to-end: the enforcement against the real tree. Every `.ex` under lib/
; must be clean; a new module is covered automatically by the walk. ─────────

(deftest every-bare-is-map-in-lib-is-sanctioned
  (let [files (Path/wildcard "lib/**/*.ex")
        v (vec (mapcat (fn [file] (violations [file (File/read! file)])) files))]
    (is (= [] v) (render v))))
