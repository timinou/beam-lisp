(ns bl.js.macro-recursion-test (:require [bl.js :as js] [bl.util :as u]))

(deftest staged-defn-helpers-dispatch-recursion-across-fixed-and-variadic-arities
 (let [root (Path/join (System/tmp_dir!)
              (str "bl-js-macro-dispatch-" (erlang/unique_integer (list :positive))))
       source (Path/join root "src") output (Path/join root "out")]
  (try
   (File/mkdir_p! (Path/join source "dispatch"))
   (File/write! (Path/join source "dispatch/macros.bl")
    (str "(ns dispatch.macros)\n"
         "(defn- route ([x] (route x :two)) ([x y] (route x y :three)) "
         "([x y z & more] (list 'inc x)))\n"
         "(defmacro bump [x] (route x))\n"))
   (File/write! (Path/join source "dispatch/main.bl")
    "(ns dispatch.main (:require [dispatch.macros :as m])) (println (m/bump 41))")
   (js/build! "dispatch.main" {:paths [source] :out output})
   (is (not (BeamLisp.Env/loaded_ns? "dispatch.macros")))
   (let [result (System/cmd "node" (u/to-list [(Path/join output "ns/dispatch.main.mjs")])
                            (u/kw [:stderr_to_stdout true]))]
    (is (= 0 (elem result 1)) (elem result 0))
    (is (= "42\n" (elem result 0))))
   (finally (File/rm_rf! root)))))
