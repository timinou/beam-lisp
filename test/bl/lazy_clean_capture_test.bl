; lazy_clean_capture_test.bl — a lazy cell must not re-walk a big clean value it
; captures through a SMALL wrapper, and the memo must not thrash past 16 values.
;
; Every lazy cell walks its thunk's captured environment for memo resources
; (`BeamLisp.LazyMemo/dependencies`). A big immutable value proven clean is
; remembered by identity, so re-capturing it is O(1). Measured in an app render:
; 40 small wrappers `{:snap snap :i i}` around ONE snapshot cost 327 ms (the
; wrapper is not "big", so the snapshot inside it was re-walked every time), and
; 18 rotating big values cost 810 ms (a 16-entry most-recent list thrashes).
;
; The probe is `:bl_deps_walked` — the count of big values actually walked, which
; the host bumps once per real walk. Reductions/wall-clock would be flaky.
;
; Run: ./bin/bl test test/bl/lazy_clean_capture_test.bl

(ns lazy-clean-capture-test)

; Test the actual NIF-backed host. scripts/check-runtime-hosts stages edited
; hosts in a fresh image, so this needs neither a probe compile nor a new floor.
(defn- P [f & args] (erlang/apply :Elixir.BeamLisp.LazyMemo f args))

(defn- big-map [tag]
  (into {} (map (fn [i] [(str tag "-" i) {"kind" "k" "n" i}]) (range 200))))

(defn- walks [] (Process/get :bl_deps_walked 0))

(defn- capture-lazily
  "What a lazy cell creation does to its thunk: split the captured env —
   here exactly `[v]`, the one value the thunk closes over."
  [v]
  (P :deps_env (list v) () ()))

(deftest small-wrappers-around-one-big-value-walk-it-once
  (let [snap {:world (big-map "w") :now 1}
        before (walks)]
    (doseq [i (range 40)] (capture-lazily {:snap snap :i i}))
    (is (<= (- (walks) before) 1)
        "the big world inside 40 distinct small wrappers is walked at most once")))

(deftest a-four-key-world-holding-a-big-map-walks-it-once
  (let [w {"entities" (big-map "e") "clock" {} "active" {} "faults" {}}
        before (walks)]
    (doseq [_ (range 40)] (capture-lazily w))
    (is (<= (- (walks) before) 1)
        "a small top-level map is not 'big', but the big map inside it is remembered")))

(deftest more-than-sixteen-rotating-values-do-not-thrash
  (let [bigs (mapv (fn [i] (big-map (str "r" i))) (range 24))
        _ (doseq [b bigs] (capture-lazily b))
        before (walks)]
    (doseq [_ (range 3)] (doseq [b bigs] (capture-lazily b)))
    (is (= 0 (- (walks) before))
        "after one pass, every one of 24 live big values is already remembered")))

(deftest a-hidden-lazy-dependency-is-still-recorded
  (let [resource (BeamLisp.LazyMemo/create_ref 1)
        holder (assoc (big-map "dirty") :resource resource)
        id (BeamLisp.LazyMemo/id resource)]
    (doseq [_ (range 3)]
      (is (= [id] (mapv BeamLisp.LazyMemo/id
                          (BeamLisp.LazyMemo/dependencies {:holder holder})))))
    (is (not (P :deps_clean_hit? holder nil)))))

(deftest an-already-seen-sibling-cannot-make-a-dirty-value-clean
  (let [resource (BeamLisp.LazyMemo/create_ref 1)
        id (BeamLisp.LazyMemo/id resource)
        holder (assoc (big-map "sibling") :resource resource)]
    ;; The resource was already seen in a sibling. The isolated cleanliness
    ;; check must discover it again, then merge/deduplicate it in the outer walk.
    (is (= (list resource)
           (P :deps_walk :inspect holder (list nil) (MapSet/new (list id))
                         (MapSet/new) (list resource))))
    (is (not (P :deps_clean_hit? holder nil)))
    (is (= (list resource) (BeamLisp.LazyMemo/dependencies holder)))))

(deftest plain-refuses-to-hide-a-resource
  (let [resource (BeamLisp.LazyMemo/create_ref 1)
        value {:resource resource}]
    (is (= :refused (try (P :plain! value) :accepted (catch _ :refused))))
    (is (not (P :deps_clean_hit? value nil)))
    (is (= (list resource) (BeamLisp.LazyMemo/dependencies value)))))

(deftest plain-declares-a-value-clean
  (let [v {"entities" (big-map "p") "x" 1}
        v2 (P :plain! v)
        before (walks)]
    (is (identical? v v2) "plain! returns its argument")
    (doseq [_ (range 10)] (capture-lazily {:w v :i 1}))
    (is (= 0 (- (walks) before)) "a declared-plain value is never walked")))


(deftest tagged-public-maps-cannot-crash-dependency-discovery-or-hide-resources
  (let [resource (BeamLisp.LazyMemo/create_ref :held)
        id (BeamLisp.LazyMemo/id resource)
        forged {:__struct__ :Elixir.BeamLisp.LazySeq
                :constructor-frame :forged :constructor-id 1}]
    (is (= (list) (BeamLisp.LazyMemo/dependencies forged)))
    ;; This is how compiler diagnostics and ordinary lazy maps carry data.
    (is (erlang/=:= forged (first (map identity (list forged)))))
    (doseq [value [(Map/put forged :hidden resource)
                  (Map/merge {:__struct__ :Elixir.BeamLisp.LazySeq} {:resource nil :metadata resource})
                  (Map/merge {:__struct__ :Elixir.BeamLisp.LazySeq} {:resource (erlang/make_ref) :metadata resource})
                  (Map/merge {:__struct__ :Elixir.BeamLisp.LazySeq} {:resource resource :metadata nil :extra resource})]]
      (is (= [id] (mapv BeamLisp.LazyMemo/id (BeamLisp.LazyMemo/dependencies value)))))))
