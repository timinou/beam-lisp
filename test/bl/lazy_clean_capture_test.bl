; lazy_clean_capture_test.bl — a lazy cell must not re-walk a big clean value it
; captures through a SMALL wrapper, and the memo must not thrash past 16 values.
;
; Every lazy cell walks its thunk's captured environment for memo resources
; (`BeamLisp.LazyMemo/dependencies`). A big immutable value proven clean is
; remembered by identity, so re-capturing it is O(1). Measured in an app render:
; 40 small wrappers `{:snap snap :i i}` around ONE snapshot cost 327 ms (the
; wrapper is not "big", so the snapshot inside it was re-walked every time), and
; 18 rotating big values cost 810 ms (a 16-entry most-recent list thrashes).
;
; The probe is `:bl_deps_walked` — the count of big values actually walked, which
; the host bumps once per real walk. Reductions/wall-clock would be flaky.
;
; Run: bl test test/bl/lazy_clean_capture_test.bl

(ns lazy-clean-capture-test)

(defn- t2 [a b] (erlang/list_to_tuple (list a b)))

;; The walk is pure host code; the pinned LazyMemo beam is the FLOOR's until the
;; floor is regenerated, so the current source is compiled as a probe module and
;; its walk (`dependencies` without the NIF: `deps_env`/`deps_walk`) is asserted.
;; No lazy NIF is bound by the probe: only resource-free values are walked, and
;; the one lazy-node case uses a hand-built struct with no resource.
(defn- ensure-probe! []
  ;; compiled once per VM, inside a fn: compiling a host file rebinds the current
  ;; namespace, so a top-level form after it would resolve in the wrong one
  (when-not (erlang/function_exported :Elixir.BeamLisp.LazyCleanProbe :deps_env 3)
    (let [dir (str (System/tmp_dir!) "/bl_lazy_clean_" (erlang/unique_integer (list :positive)))
          _ (File/mkdir_p! dir)
          res (BeamLisp.Env/with_ns "lazy-clean-capture-test"
                (fn [] (BeamLisp.AOT/compile_host_file "priv/host/lazy_memo.bl"
                         (list (t2 :module :Elixir.BeamLisp.LazyCleanProbe) (t2 :output_dir dir) (t2 :load? false)))))
          path (elem res 1)]
      (code/purge :Elixir.BeamLisp.LazyCleanProbe) (code/delete :Elixir.BeamLisp.LazyCleanProbe)
      (code/load_binary :Elixir.BeamLisp.LazyCleanProbe (erlang/binary_to_list path) (File/read! path))))
  :ok)

(defn- P [f & args] (ensure-probe!) (erlang/apply :Elixir.BeamLisp.LazyCleanProbe f args))

(defn- big-map [tag]
  (into {} (map (fn [i] [(str tag "-" i) {"kind" "k" "n" i}]) (range 200))))

(defn- walks [] (Process/get :bl_deps_walked 0))

(defn- capture-lazily
  "What a lazy cell creation does to its thunk: split the captured env —
   here exactly `[v]`, the one value the thunk closes over."
  [v]
  (P :deps_env (list v) () ()))

(deftest small-wrappers-around-one-big-value-walk-it-once
  (let [snap {:world (big-map "w") :now 1}
        before (walks)]
    (doseq [i (range 40)] (capture-lazily {:snap snap :i i}))
    (is (<= (- (walks) before) 1)
        "the big world inside 40 distinct small wrappers is walked at most once")))

(deftest a-four-key-world-holding-a-big-map-walks-it-once
  (let [w {"entities" (big-map "e") "clock" {} "active" {} "faults" {}}
        before (walks)]
    (doseq [_ (range 40)] (capture-lazily w))
    (is (<= (- (walks) before) 1)
        "a small top-level map is not 'big', but the big map inside it is remembered")))

(deftest more-than-sixteen-rotating-values-do-not-thrash
  (let [bigs (mapv (fn [i] (big-map (str "r" i))) (range 24))
        _ (doseq [b bigs] (capture-lazily b))
        before (walks)]
    (doseq [_ (range 3)] (doseq [b bigs] (capture-lazily b)))
    (is (= 0 (- (walks) before))
        "after one pass, every one of 24 live big values is already remembered")))

(deftest a-hidden-lazy-dependency-is-still-recorded
  ; correctness: a wrapper around a value that DOES hold a lazy seq must still
  ; report that dependency, however many times it is captured
  (let [inner [1 2 3]
        ;; a memo handle the walk must report: a reference whose resource is
        ;; looked up natively — the probe has no NIF, so assert the structural
        ;; rule instead: a value holding a FUNCTION is never remembered clean
        holder2 {:data (big-map "h2") :f (fn [] inner)}
        _ (capture-lazily {:holder holder2 :i 0})
        _ (capture-lazily {:holder holder2 :i 1})]
    (is (not (P :deps_clean_hit? holder2 nil))
        "a value that captures a function is walked every time, never remembered")))

(deftest plain-declares-a-value-clean
  (let [v {"entities" (big-map "p") "x" 1}
        v2 (P :plain! v)
        before (walks)]
    (is (identical? v v2) "plain! returns its argument")
    (doseq [_ (range 10)] (capture-lazily {:w v :i 1}))
    (is (= 0 (- (walks) before)) "a declared-plain value is never walked")))
