; build_substrate_test.bl — the Elixir substrate stage's contract, pinned.
;
; Ported from the ExUnit `test/beam_lisp/build_substrate_test.exs`. Those tests
; ran through the Elixir façade `BeamLisp.Substrate`; here they call
; `priv/build/substrate.bl` DIRECTLY, with no Elixir seam in the path.
;
; The substrate is the one stage that compiles ELIXIR sources: `lib/**/*.ex`
; minus the Mix-task shells, in-process, tracked in the same fact log as the
; AOT waves. What this pins, and why each one is worth a test:
;
;   * the project's OWN source root (`lib/`) is EMPTY of Elixir source: the
;     stage answers `[]` for it and writes no beam — PLAN-150's boundary, held;
;   * a full pass over a tree that HAS sources produces a beam for every module
;     — the ebin a release needs — and NO `Mix` beam comes out of it, which is
;     the whole point of doing this without a Mix project;
;   * freshness is the content hash, so a second pass compiles NOTHING, an
;     edited file compiles alone, and a beam that vanished pulls its own source
;     back in (the hole W1-R1 documents for the AOT side);
;   * a file that will not compile is REPORTED and records no fact, so it stays
;     stale for the next run instead of being marked done.
;
; Run: bl test test/bl/build_substrate_test.bl

(ns build.substrate.test
  (:require [substrate :as sub] [build-log :as blog]))

(def mix-excludes ["mix"])

; ── helpers ──────────────────────────────────────────────────────────────────

(defn- scratch
  "A fresh scratch directory, unique per test: two tests never share a tree."
  [tag]
  (let [root (str (System/tmp_dir!) "/bl_substrate_" tag "_"
                  (erlang/unique_integer (list :positive)))]
    (File/mkdir_p! root)
    root))

(defn- empty-state
  "The build's state shape, empty — the same shape `build-log/replay` starts
   from, so a fold here replays exactly as the build's does."
  []
  {:sources {} :ex {} :runs [] :errors []})

(defn- stale
  "The sources `sources` `out` the log cannot vouch for, from an EMPTY log —
   the first pass."
  [sources out]
  (sub/stale (empty-state) sources out))

(defn- state-after
  "The stage returns facts; the build owns appending them. Here the test is the
   caller, so it folds them the same way the build does — build-log's own fold."
  [result]
  (blog/apply-facts (empty-state) (:facts result)))

(defn- fixture-module [src suffix]
  (str "Sub.F" (last (String/split src "_")) "." suffix))

(defn- fixture!
  "Three compiling sources with module names unique to this scratch tree."
  [src]
  (let [a (fixture-module src "A")]
    (File/write! (Path/join src "a.ex")
                 (str "defmodule " a " do\n  def v, do: 1\nend\n"))
    (File/write! (Path/join src "b.ex")
                 (str "defmodule " (fixture-module src "B")
                      " do\n  def v, do: " a ".v()\nend\n"))
    (File/write! (Path/join src "c.ex")
                 (str "defmodule " (fixture-module src "C")
                      " do\n  def v, do: 3\nend\n")))
  (sub/sources src []))

; ── the project's own substrate ──────────────────────────────────────────────

(deftest the-projects-own-substrate-is-source-free-and-still-excludes-mix
  ; The stage's root is the SOURCE root (`lib`), the one directory the substrate
  ; compiled. PLAN-150 emptied it, so the live assertion is the BOUNDARY itself:
  ; `lib/` answers `[]` — portable absence, not a crash — and compiling that
  ; empty set writes no beam and never needs Mix.
  (let [out (scratch "own-out")
        root (Path/join (BeamLisp/cwd) "lib")]
    (try
      (let [sources (sub/sources root mix-excludes)]
        (is (= [] sources)
            (str "lib/ must be source-free — the substrate has nothing left to "
                 "compile, got " (pr-str sources)))
        (is (not (File/exists? (Path/join root "beam_lisp/aot.ex")))
            "the live compiler host's `.ex` is deleted — priv/host/aot.bl is its home")

        (let [result (sub/compile! sources out)]
          (is (= [] (:errors result))
              (str "substrate errors: " (str (vec (take 3 (:errors result))))))
          (is (= 0 (:compiled result)) "an empty source set compiles nothing")
          (is (= [] (:facts result)) "an empty pass records no facts")
          (is (= [] (vec (Path/wildcard (Path/join out "*.beam"))))
              "an empty pass writes no beam")
          (is (not (File/exists? (Path/join out "Elixir.Mix.beam")))
              "the substrate must not need — or produce — Mix")))
      (finally (File/rm_rf! out)))))

; ── the mix exclusion still holds where there is source to exclude ───────────

(deftest the-mix-task-shells-stay-out-of-the-substrate-source-set
  ; This is what kept the Mix-task shells out of the payload build: a `mix/`
  ; shell beside a real source is not in the set. It must not be dropped with
  ; `lib/`.
  (let [src (scratch "mix-src")
        real (Path/join src "thing.ex")]
    (try
      (File/mkdir_p! (Path/join src "mix"))
      (File/write! real "defmodule Sub.MixFixture do\nend\n")
      (File/write! (Path/join src "mix/task.ex")
                   "defmodule Sub.MixFixture.Task do\nend\n")
      (is (= [real] (vec (sub/sources src mix-excludes)))
          "the Mix-task shells must not be in the set")
      (finally (File/rm_rf! src)))))

; ── freshness is the content hash ────────────────────────────────────────────

(deftest a-second-pass-compiles-nothing-and-an-edit-compiles-one-file
  (let [src (scratch "edit-src")
        out (scratch "edit-out")]
    (try
      (let [sources (fixture! src)
            first-pass (sub/compile! (stale sources out) out)
            state (state-after first-pass)]
        (is (= 3 (:compiled first-pass)))
        (is (= [] (vec (sub/stale state sources out))) "nothing stale after a full pass")

        ; A body edit: the hash moves, and only that file is stale.
        (File/write! (Path/join src "b.ex")
                     (str "defmodule " (fixture-module src "B")
                          " do\n  def v, do: 2\nend\n"))
        (is (= [(Path/join src "b.ex")] (vec (sub/stale state sources out))))

        (let [second-pass (sub/compile! (sub/stale state sources out) out)]
          (is (= 1 (:compiled second-pass)))))
      (finally (File/rm_rf! src) (File/rm_rf! out)))))

(deftest a-beam-that-vanished-makes-its-own-source-stale-again
  (let [src (scratch "vanish-src")
        out (scratch "vanish-out")]
    (try
      (let [sources (fixture! src)
            first-pass (sub/compile! sources out)
            state (state-after first-pass)]
        (is (= [] (vec (sub/stale state sources out))))
        (is (contains? (set (:modules (get (:ex state) (Path/join src "a.ex"))))
                       (str "Elixir." (fixture-module src "A")))
            (str "compiler attributed source modules: " (pr-str (:ex state))))

        ; The hash still matches; the OUTPUT is gone. A freshness rule that only
        ; compared hashes would call this source done forever.
        (File/rm! (Path/join out (str "Elixir." (fixture-module src "A") ".beam")))

        (is (= [(Path/join src "a.ex")] (vec (sub/stale state sources out)))))
      (finally (File/rm_rf! src) (File/rm_rf! out)))))

(deftest a-source-that-will-not-compile-is-reported-and-stays-stale
  (let [src (scratch "broken-src")
        out (scratch "broken-out")]
    (try
      (let [sources (fixture! src)]
        (File/write! (Path/join src "c.ex")
                     (str "defmodule " (fixture-module src "C")
                          " do\n  def v, do: (\nend\n"))

        (let [result (sub/compile! sources out)]
          (is (= 0 (:compiled result)))
          (is (= [] (:facts result)) "a failed batch records nothing")
          (is (some (fn [e] (includes? (str e) "c.ex")) (:errors result))
              (str "the failure must name the file, got: " (str (vec (:errors result)))))

          ; Nothing was recorded, so every source is still stale — the next run
          ; retries rather than believing a broken file is done.
          (is (= 3 (count (sub/stale (empty-state) sources out))))))
      (finally (File/rm_rf! src) (File/rm_rf! out)))))
