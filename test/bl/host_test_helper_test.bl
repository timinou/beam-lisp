; The pinned test helper is the only BeamLisp.Test implementation once the
; remaining ExUnit suites stop compiling test/support/*.ex.
(ns host.test-helper.test)

(def ^:private probe :Elixir.BeamLisp.TestHelperProbe)
(def ^:private shim :Elixir.BeamLisp.Ns.Host.TestHelper)

(deftest test-helper-realizes-only-lazy-values
  (let [dir (str (System/tmp_dir!) "/bl_test_helper_" (erlang/unique_integer (list :positive)))]
    (File/mkdir_p! dir)
    (let [res (BeamLisp.AOT/compile_host_file "priv/host/test_helper.bl"
                (list (tuple :module probe) (tuple :output_dir dir) (tuple :load? false)))
          path (elem res 1)]
      (code/purge probe)
      (code/delete probe)
      (code/load_binary probe (erlang/binary_to_list path) (File/read! path))
      (code/purge shim)
      (code/delete shim)
      (testing "plain values pass through without coercion"
        (is (= :non_existing (code/which shim)))
        (is (= (list 1 2) (erlang/apply probe :realize (list (list 1 2)))))
        (is (= 4 (erlang/apply probe :realize (list 4))))
        (is (nil? (erlang/apply probe :realize (list nil))))
        (is (erlang/function_exported probe :realize 1)))
      (testing "a native-backed lazy seq is realized once"
        (let [calls (atom 0)
              lazy (BeamLisp.LazySeq/new (fn [] (do (swap! calls inc) (list 1 2 3))))]
          (is (= (list 1 2 3) (erlang/apply probe :realize (list lazy))))
          (is (= (list 1 2 3) (erlang/apply probe :realize (list lazy))))
          (is (= 1 @calls))))
      (testing "an improper list ending in a lazy seq becomes a proper list"
        (let [tail (BeamLisp.LazySeq/new (fn [] (list 3 4)))
              improper (erlang/apply :lists :foldr
                         (list (fn [x acc] (cons x acc)) tail (list 1 2)))]
          (is (= (list 1 2 3 4) (erlang/apply probe :realize (list improper))))))
      (File/rm_rf! dir))))

(run-tests)
