; doc_loader_test.bl — the seam: a .bl.md / .bl.org document resolves as a
; namespace through the ordinary loader, and this plain .bl test file
; requires both dialects without knowing or caring which is which.

(ns bl.doc.loader.test
  (:require [bl.doc :as doc]))

;; the fixture directory joins the search path before anything loads; the
;; ns form above must not require the docx.* namespaces itself, because a
;; ns form's requires resolve BEFORE the following top-level forms run.
(BeamLisp.Env/add_search_path "test/fixtures/docs")

(defn eval-doc
  [form]
  (BeamLisp/eval form))

(deftest loader-finds-a-markdown-document
  (is (= :ok (BeamLisp.Loader/ensure_loaded "docx.payroll")))
  (is (= 800 (eval-doc "(docx.payroll/gross 40 20)")))
  (is (= 640.0 (eval-doc "(docx.payroll/net 40 20)"))))

(deftest loader-finds-an-org-document
  (is (= :ok (BeamLisp.Loader/ensure_loaded "docx.stats")))
  (is (= 3 (eval-doc "(docx.stats/mean [1 2 3 6])"))))

(deftest frozen-cell-does-not-spoil-the-namespace
  ;; the frozen cell in payroll.bl.md must not have run: its stored result
  ;; span is the truth, and the load evaluates it away harmlessly
  (is (= :ok (BeamLisp.Loader/ensure_loaded "docx.payroll"))))

(deftest loader-extractor-agrees-with-bl-doc
  (let [raw (File/read! "test/fixtures/docs/docx/payroll.bl.md")]
    (is (= (BeamLisp.Loader/doc_source raw :md)
           (doc/doc-source raw :md))))
  (let [raw (File/read! "test/fixtures/docs/docx/stats.bl.org")]
    (is (= (BeamLisp.Loader/doc_source raw :org)
           (doc/doc-source raw :org)))))

(deftest plain-bl-wins-over-same-named-document
  ;; extension order is .bl, .bl.md, .bl.org: the plain form shadows
  (is (= :ok (BeamLisp.Loader/ensure_loaded "docx.shadow")))
  (is (= :plain (eval-doc "(docx.shadow/which)"))))
