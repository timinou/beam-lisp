(ns typed-numeric-predicate-test (:require [typed]))

(deftest a-false-value-predicate-still-contains-numbers
 (doseq [predicate ["zero?" "pos?" "neg?"]]
  (let [source (str "(defn run [n] (if (" predicate " n) 0 (dec n)))")
        warnings (:warnings (typed/check-source source "numeric-predicate.fixture"))]
   (is (= [] (vec warnings)) (str predicate " does not exclude numeric types from its false branch")))))

(deftest partial-numeric-guards-do-not-claim-the-entire-number-domain
 (let [source "(defn run ([x] :when (pos? x) :positive) ([x] :when (neg? x) :negative) ([x] :when (zero? x) :zero))"
       warnings (:warnings (typed/check-source source "numeric-coverage.fixture"))]
  (is (empty? (filter #(= :unreachable-clause (:kind %)) warnings)))))


(deftest local-definitions-and-bindings-never-borrow-core-signatures
 (doseq [source
  ["(defn keep [x] (fn [] x)) (defn run [x] (keep (inc x)))"
   "(defn run [keep] (keep 42))"
   "(defn run [] (let [keep identity] (keep 42)))"]]
  (is (= [] (:warnings (typed/check-source source "typed.shadowed")))))
 (let [warnings (:warnings (typed/check-source "(defn run [] (let [keep 42] (keep 1)))" "typed.shadowed"))]
  (is (= [:not-callable] (mapv :kind warnings))))
 (let [warnings (:warnings (typed/check-source "(defn run [] (keep 42 [1]))" "typed.unshadowed"))]
  (is (= [:type-mismatch] (mapv :kind warnings)))))

(deftest shadowed-predicates-cannot-claim-core-type-refinements
 (doseq [source
  ["(defn int? [x] true) (defn run [x] (if (int? x) (str x) (+ x 1)))"
   "(defn run [int? x] (if (int? x) (str x) (+ x 1)))"
   "(defn run [x] (let [int? identity] (if (int? x) (str x) (+ x 1))))"]]
  (is (= [] (:warnings (typed/check-source source "typed.shadowed-predicate"))))))
