; test/bl/wave22_server_test.bl — `defserver` must produce a GENUINE
; `:gen_server`, ported from test/beam_lisp/wave22_server_test.exs.
;
; That distinction is the whole premise of the wave: the reason to put a Lisp on
; the BEAM is the BEAM, so a server that `:observer`, `Supervisor` and `:sys` do
; not recognise would be worth nothing. Every test here therefore pokes the
; generated module with real OTP tooling (`:gen_server`, `:sys`, `Supervisor`)
; rather than with beam-lisp's own client fns — and one test does use those fns,
; because a server you can only talk to through raw interop defeats the point.
;
; Ported verbatim in behaviour and in the values asserted: the same
; `counter`/`holder`/`refuses` sources, the same `reply`/`noreply`/`ok`/`stop`
; return constructors, the same `:sys.get_state` round-trips, the same
; behaviour-attribute check, the same vector-through-state identity, the same
; `{:error, :nope}` refusal. `BeamLisp.Vector` crossing the callback boundary
; twice is asserted as the original asserted it (`%BeamLisp.Vector{}`), here as
; the runtime's own `(type v) → :vector`.
;
; ── coverage map (ExUnit test → BL deftest) ────────────────────────────────
;   the generated module declares the :gen_server behaviour → the-generated-module-declares-the-gen-server-behaviour
;   raw :gen_server call and cast work against it           → raw-gen-server-call-and-cast-work-against-it
;   :sys.get_state sees the server's state                  → sys-get-state-sees-the-servers-state
;   a real Supervisor adopts it as a child                  → a-real-supervisor-adopts-it-as-a-child
;   a beam-lisp vector survives as server state             → a-beam-lisp-vector-survives-as-server-state
;   the client fns reach the server without raw interop     → the-client-fns-reach-the-server-without-raw-interop
;   init can refuse to start                                → init-can-refuse-to-start
;
; Run: bin/bl test test/bl/wave22_server_test.bl

(ns wave22-server.test)

; The ExUnit `eval/2` verbatim: `BeamLisp.init/0` then compile and run `source`
; at a fresh env. Unlike the OTP suite this one does NOT claim the namespace
; globally — the original did not, and every source starts with its own `(ns …)`
; so `defserver`'s `module_for` reads the module under test from the env alone.
(defn- ev [ns source]
  (BeamLisp/init)
  (BeamLisp.Compiler/eval_string source (BeamLisp.Compiler/new_env ns)))

; The shared counter source: one `init`, two `handle-call`s and a `handle-cast`,
; answering with the canonical `ok`/`reply`/`noreply` constructors. The trailing
; `counter` is what the form evaluates to — the generated module atom.
(defn- counter-mod [ns]
  (ev ns (str "(ns " ns ")"
              " (defserver counter"
              " (init [arg] (ok arg))"
              " (handle-call :inc [_from state] (reply (inc state) (inc state)))"
              " (handle-call :get [_from state] (reply state state))"
              " (handle-cast :reset [_state] (noreply 0)))"
              " counter")))

(deftest the-generated-module-declares-the-gen-server-behaviour
  (let [mod (counter-mod "w22decl")
        attrs (erlang/apply mod :module_info (list :attributes))]
    (is (= (list :gen_server) (Keyword/get attrs :behaviour)))))

(deftest raw-gen-server-call-and-cast-work-against-it
  (let [mod (counter-mod "w22raw")
        pid (erlang/element 2 (erlang/apply :gen_server :start_link (list mod 5 (list))))]
    (is (= 6 (erlang/apply :gen_server :call (list pid :inc))))
    (is (= 6 (erlang/apply :gen_server :call (list pid :get))))
    (is (= :ok (erlang/apply :gen_server :cast (list pid :reset))))
    ; A cast is asynchronous; the following call is the synchronisation point, so
    ; no sleep is needed to observe its effect.
    (is (= 0 (erlang/apply :gen_server :call (list pid :get))))))

(deftest sys-get-state-sees-the-servers-state
  ; `:sys` is the OTP debugging interface. It works only on a process that
  ; genuinely implements the behaviour, so this is the sharpest single test that
  ; the module is not a lookalike.
  (let [mod (counter-mod "w22sys")
        pid (erlang/element 2 (erlang/apply :gen_server :start_link (list mod 41 (list))))]
    (is (= 41 (erlang/apply :sys :get_state (list pid))))
    (is (= 42 (erlang/apply :gen_server :call (list pid :inc))))
    (is (= 42 (erlang/apply :sys :get_state (list pid))))))

(deftest a-real-supervisor-adopts-it-as-a-child
  (let [mod (counter-mod "w22sup")
        children (list {:id :counter
                        :start (tuple :gen_server :start_link (list mod 0 (list)))})
        sup (erlang/element 2
                            (Supervisor/start_link children (list (tuple :strategy :one_for_one))))
        c (Supervisor/count_children sup)]
    (is (= 1 (get c :active)))
    (is (= 1 (get c :workers)))
    (is (= 1 (get c :specs)))

    (let [kids (Enum/to_list (Supervisor/which_children sup))]
      (is (= 1 (count kids)))
      (let [k (first kids)]
        (is (= :counter (erlang/element 1 k)))
        (is (erlang/is_pid (erlang/element 2 k)))
        (is (= :worker (erlang/element 3 k)))))

    (Supervisor/stop sup)))

(deftest a-beam-lisp-vector-survives-as-server-state
  ; State crosses the callback boundary twice per call. A `%Vector{}` is a
  ; struct, and a struct is a map on the BEAM — the recurring hazard in this
  ; codebase — so it is exactly the value most likely to be silently mangled
  ; into something else on the way through.
  (let [mod (ev "w22vec"
                (str "(ns w22vec)"
                     " (defserver holder"
                     " (init [arg] (ok arg))"
                     " (handle-call :push [_from state] (reply (conj state 9) (conj state 9)))"
                     " (handle-call :get [_from state] (reply state state)))"
                     " holder"))
        pid (erlang/element 2
                            (erlang/apply :gen_server :start_link
                                          (list mod (BeamLisp.Vector/new (list 1 2)) (list))))
        got (erlang/apply :gen_server :call (list pid :get))
        pushed (erlang/apply :gen_server :call (list pid :push))]
    (is (= :vector (type got)))
    (is (= :vector (type pushed)))
    (is (= 3 (BeamLisp.Ns.Rt/count pushed)))))

(deftest the-client-fns-reach-the-server-without-raw-interop
  ; A server you can only talk to through :gen_server interop defeats the point
  ; of having the form at all — `start-link`/`call`/`cast` are the language side
  ; of the generated module.
  (is (== 1 (ev "w22client"
                (str "(ns w22client)"
                     " (defserver c"
                     " (init [arg] (ok arg))"
                     " (handle-call :inc [_from state] (reply (inc state) (inc state)))"
                     " (handle-cast :reset [_state] (noreply 0)))"
                     " (def p (start-link c 10))"
                     " (call p :inc)"
                     " (cast p :reset)"
                     " (call p :inc)")))))

(deftest init-can-refuse-to-start
  (let [mod (ev "w22stop"
                (str "(ns w22stop)"
                     " (defserver refuses"
                     " (init [_arg] (stop :nope))"
                     " (handle-call :x [_from state] (reply state state)))"
                     " refuses"))]
    (Process/flag :trap_exit true)
    (is (= (tuple :error :nope)
           (erlang/apply :gen_server :start_link (list mod nil (list)))))))
