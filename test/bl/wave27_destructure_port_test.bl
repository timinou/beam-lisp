; wave27_destructure_port_test.bl — quoted-symbol keys in map destructuring,
; ported from the ExUnit `test/beam_lisp/wave27_destructure_test.exs`.
;
; `{binding 'sym}` / `{binding (quote sym)}`: the reader turns `'sym` into
; `(quote sym)`, and the runtime key is the tagged symbol a quoted symbol
; evaluates to — a lookup by symbol VALUE, never by a keyword. This was the
; single biggest Specter load wall: Specter's `nav` macro destructures its
; implementations against a LITERAL QUOTED SYMBOL as the map key.
;
; Every existing key kind is unchanged: keyword, string, `:keys`/`:strs`/`:syms`,
; `:as`, `:or`, nested patterns. Lenient destructuring is a project invariant —
; a missing key binds nil. A quoted symbol that happens to spell a directive name
; (`'keys`/`'as`/`'or`) is a KEY: a quote list can never match a bare-keyword
; directive clause, so the ambiguity resolves by construction.
;
; WHERE THE ExUnit `eval` WENT
;
; The ExUnit suite drove `BeamLisp.Compiler.eval_string/2` from a test process
; (`eval(ns, source)`), one fresh namespace per test. A BL deftest IS the
; runtime, so each pattern is written in place — the same compiler path with no
; eval round-trip (the idiom of wave27_for_port_test.bl). The one shape that must
; stay TOP-LEVEL is the Specter `nav` macro: a macro's body runs at EXPANSION
; time, so `determine-params-impls` and `nav` are declared before the deftest
; that expands `nav`.
;
; ASSERTION MAP (ExUnit test → BL deftest), all 10 originals, none dropped:
;   reader-shorthand {x 'foo} looks up by the symbol value
;     → reader-shorthand-looks-up-by-the-symbol-value          (== 42)
;   expanded (quote foo) form works the same as the shorthand
;     → expanded-quote-form-works-the-same-as-the-shorthand     (== 7)
;   nested vector pattern with & rest against a quoted-symbol key
;     → nested-vector-pattern-with-rest-against-a-quoted-symbol-key
;       (`[10, 20, [30, 40]]` (Elixir list) → `'(10 20 (30 40))`)
;   nested pattern works on the real Specter select* shape
;     → nested-pattern-works-on-the-real-specter-select-shape
;       (`[{:symbol,"vals"}, …]` (Elixir tuples) → `'(vals structure vals structure)`)
;   :or default applies when the quoted-symbol key is absent
;     → or-default-applies-when-the-quoted-symbol-key-is-absent  (99; then nil)
;   :as binds the whole map alongside quoted-symbol keys
;     → as-binds-the-whole-map-alongside-quoted-symbol-keys      (`'(5 6)`)
;   'keys/'as/'or are keys, not destructuring directives
;     → keys-as-or-are-keys-not-destructuring-directives         (`'(1 2 3)`)
;   the real :keys/:as/:or directives still work alongside quoted keys
;     → the-real-keys-as-or-directives-still-work-alongside-quoted-keys (`'(1 2 1)`)
;   missing quoted-symbol key binds nil leniently (no raise)
;     → missing-quoted-symbol-key-binds-nil-leniently            (true)
;   keyword and string keys still destructure unchanged
;     → keyword-and-string-keys-still-destructure-unchanged      (`'(1 2)`)
;
; Run: bin/bl test test/bl/wave27_destructure_port_test.bl

(ns wave27.destructure.test)

; --- reader shorthand and the expanded quote form ---------------------------

(deftest reader-shorthand-looks-up-by-the-symbol-value
  (is (= 42 (let [{x 'foo} {'foo 42}] x))))

(deftest expanded-quote-form-works-the-same-as-the-shorthand
  (is (= 7 (let [{x (quote foo)} {'foo 7}] x))))

; --- nested patterns, including the real Specter shapes ----------------------

(deftest nested-vector-pattern-with-rest-against-a-quoted-symbol-key
  ; The Specter nav shape: bind a nested vector (and its rest) from the value
  ; stored under a quoted-symbol key. Both halves must cooperate — a test
  ; covering only `{x 'foo}` proves nothing about this.
  (is (= '(10 20 (30 40))
         (let [{[a b & rest] 'sel} {'sel '(10 20 30 40)}] (list a b rest)))))

; The Specter `nav` macro: `determine-params-impls` maps 'select* to the impl
; body whose first element is the params vector `([this vals structure next-fn]
; …)`; `nav` destructures that nested vector (and its rest) by the quoted key and
; splices the bound symbols back out as data, the way Specter does.
(defn determine-params-impls [impls]
  {'select* '([this vals structure next-fn] (next-fn vals structure))
   'transform* '([this vals structure next-fn] (next-fn vals structure))})

(defmacro nav [params & impls]
  (let [{[[_ s-structure-sym s-next-fn-sym] & s-body] 'select*
         [[_ t-structure-sym t-next-fn-sym] & t-body] 'transform*}
        (determine-params-impls impls)]
    ; splice the bound symbols back out as data; quoting keeps them symbols,
    ; not vars
    `(list '~s-structure-sym '~s-next-fn-sym '~t-structure-sym '~t-next-fn-sym)))

(deftest nested-pattern-works-on-the-real-specter-select-shape
  (is (= '(vals structure vals structure)
         (nav foo
              (select* [this vals structure next-fn] (next-fn vals structure))
              (transform* [this vals structure next-fn] (next-fn vals structure))))))

; --- the directives, and the ambiguity that resolves by construction ---------

(deftest or-default-applies-when-the-quoted-symbol-key-is-absent
  (is (= 99 (let [{x 'missing :or {x 99}} {}] x)))
  ; a present key with a nil value stays nil — Map.get/3 semantics
  (is (= nil (let [{x 'k :or {x 99}} {'k nil}] x))))

(deftest as-binds-the-whole-map-alongside-quoted-symbol-keys
  (is (= '(5 6) (let [{x 'foo :as whole} {'foo 5 'bar 6}] (list x (get whole 'bar))))))

(deftest keys-as-or-are-keys-not-destructuring-directives
  ; A quote list can never match the bare-keyword directive clauses, so these
  ; quoted directive-looking keys resolve as KEYS by construction.
  (is (= '(1 2 3) (let [{a 'keys b 'as c 'or} {'keys 1 'as 2 'or 3}] (list a b c)))))

(deftest the-real-keys-as-or-directives-still-work-alongside-quoted-keys
  (is (= '(1 2 1)
         (let [{a 'sel :keys [k] :or {k 9} :as whole} {'sel 1 :k 2}]
           (list a k (get whole 'sel))))))

; --- leniency and the unchanged key kinds ------------------------------------

(deftest missing-quoted-symbol-key-binds-nil-leniently
  ; Lenient destructuring is the project invariant: a missing key binds nil and
  ; never raises.
  (is (let [{x 'foo} {}] (nil? x))))

(deftest keyword-and-string-keys-still-destructure-unchanged
  (is (= '(1 2) (let [{k :kw s "str"} {:kw 1 "str" 2}] (list k s)))))
