; test/bl/daemon/executor_state_test.bl — a busy worker says so, as DATA.
;
; The executor runs ONE command at a time (a beam-lisp program shares VM-global
; state with the daemon: loaded modules, the pinned Loader.Server, ETS tables,
; NIF state), so a second client waits in the mailbox. What it must NOT do is
; wait in SILENCE. Before this, `hello` reported a `queue_depth` read from a
; counter nothing ever incremented, so a client could not tell "the daemon is
; idle" from "you are queued behind someone else's two-minute command" — and a
; parked command is indistinguishable from a hung one. Measured 2026-09-16: a
; trivial `bl run` printed nothing and made no progress for the full 120s of
; another client's command.
;
; The fix is a published row (the same shape IndexWorker uses for build
; progress), read by anyone, never a call — a reader must not have to queue
; behind the thing it is asking about.
;
; Run: bl test test/bl/daemon/executor_state_test.bl
(ns daemon.executor-state-test
  (:require [vm.exec]))

;; A test VM has no daemon, so the worker tree is started here (idempotent by
;; name, so a second file's setup finds the first's).
(defn- worker [] (vm.exec/start))

(deftest an-idle-worker-reports-idle-as-data
  (worker)
  (let [st (vm.exec/state)]
    (is (nil? (:busy st)) "idle: nothing is running")
    (is (number? (:queued st)) "and the queue count is a NUMBER, not a constant")))

(deftest a-command-in-flight-is-published-with-its-argv-and-age
  ;; run_capture occupies the SAME worker a request does, so this is the worker
  ;; under load without needing a client socket.
  (worker)
  (let [running (future (vm.exec/run-capture (fn [] (Process/sleep 1200))))]
    (Process/sleep 300)
    (let [st (vm.exec/state)
          b (:busy st)]
      (is (map? b) "a worker with a command in flight reports busy")
      (is (number? (:since_ms b)) "and says since when")
      (is (string? (first (:argv b))) "and names what it is running")
      (is (string? (:cwd b)) "and where")
      (is (>= (:queued st) 1) "queued counts the command in flight"))
    (is (some? (deref running)) "the capture finishes")))

(deftest reading-the-state-never-queues-behind-the-work
  ;; The property that makes this usable: a SECOND process reads the row while
  ;; the worker is busy. If the read were a GenServer.call it would park behind
  ;; the in-flight command and this test would HANG rather than fail — which is
  ;; exactly the failure mode the row exists to remove.
  (worker)
  (let [running (future (vm.exec/run-capture (fn [] (Process/sleep 1200))))
        reader (future (Process/sleep 300) (vm.exec/state))]
    (is (map? (deref reader)) "the read answered while the worker was busy")
    (is (deref running) "and the work still finished")))

(deftest queued-counts-every-command-ahead-of-a-new-request
  (worker)
  (let [slow (future (vm.exec/run-capture (fn [] (Process/sleep 1500))))
        _ (Process/sleep 200)
        waiting (future (vm.exec/run-capture (fn [] :second)))
        _ (Process/sleep 300)
        st (vm.exec/state)]
    (is (>= (:queued st) 2)
        "one in flight + one waiting = a new request is third in line, not first")
    (is (some? (deref slow)) "first finishes")
    (is (some? (deref waiting)) "second finishes")))
