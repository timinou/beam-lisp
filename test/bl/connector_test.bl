(ns connector.test
  (:require [datom]
            [datom.query.parse :as parse]
            [connector :as conn]
            [connector.google.gmail :as gmail]
            [connector.google.gdrive :as gdrive]
            [msg]
            [files]))

;; Registration is explicit — see `msg/register!` for why an AOT-compiled
;; namespace cannot do this at load.
(msg/register!)
(files/register!)

;; ── building a URL ───────────────────────────────────────────────────

(deftest a-nil-parameter-is-omitted
  ; A caller passes every parameter a method knows about and lets absence mean
  ; absence — which is what a query string already means. Requiring them to
  ; filter first is how a `q=` with no value ends up on the wire.
  (is (= "https://x/y?a=1" (conn/with-query "https://x/y" [["a" "1"] ["b" nil]])))
  (is (= "https://x/y" (conn/with-query "https://x/y" [])))
  (is (= "https://x/y" (conn/with-query "https://x/y" [["b" nil]]))))

(deftest a-parameter-is-encoded-as-a-form-value
  ; Space is `+` and not `%20` because that is what
  ; `application/x-www-form-urlencoded` says, and a `q=import+AI` that arrived
  ; as `q=import%20AI` would still work — which is why this is pinned rather
  ; than left to luck.
  (is (= "https://x/y?q=import+AI" (conn/with-query "https://x/y" [["q" "import AI"]])))
  (is (= "https://x/y?q=a%2Fb" (conn/with-query "https://x/y" [["q" "a/b"]]))))

;; ── a connection ─────────────────────────────────────────────────────

(deftest a-connection-holds-no-grant
  ; Deliberate. A grant expires and rotates, and a copy held in a struct is a
  ; copy that goes stale while every reader believes it. `access!` reads it
  ; from the store, renews only if it must, and writes it back — so there is
  ; one access token in the world and it is the current one.
  (let [c (conn/open gmail/spec {:service :google :account-id "a" :store :s :client :cl})]
    (is (= "a" (:account-id c)))
    (is (= :s (:store c)))
    (is (not (contains? c :access))
        "the grant is NOT here — it lives in the store, where renewal can write it back")))

;; ── the provisioned registry ─────────────────────────────────────────

(deftest have!-makes-an-aspect-answerable
  (let [aspect :~test/things]
    (is (not (conn/connected? aspect)))
    (conn/have! {:spec {} :account-id "a"} aspect)
    (is (conn/connected? aspect))
    (is (= 1 (count (conn/connections-for aspect))))
    (conn/have! {:spec {} :account-id "b"} aspect)
    (is (= 2 (count (conn/connections-for aspect)))
        "two accounts is the normal case, not a special one")))

;; ── a message projects to a tuple ────────────────────────────────────

(def A-MESSAGE
  {"id" "m1"
   "internalDate" "1790093339000"
   "payload" {"headers" [{"name" "Subject" "value" "Hello"}
                         {"name" "From" "value" "a@b.c"}]}})

(deftest the-entity-is-composite-never-the-remote-id
  ; Two mailboxes both have a message `1a0c…`. Gmail's ids are unique within an
  ; account and NOT across them, so keying on the id alone silently merges two
  ; people's mail into one entity — and the merge looks like a sync bug for as
  ; long as it takes to find.
  (is (= [:google "acct" "m1"] (gmail/entity "acct" A-MESSAGE)))
  (is (not (= (gmail/entity "acct-a" A-MESSAGE) (gmail/entity "acct-b" A-MESSAGE)))))

(deftest a-message-tuple-is-entity-subject-from-when
  (let [t (gmail/tuple "acct" A-MESSAGE)]
    (is (= 4 (count t)) "arity matches what the relation declares")
    (is (= [:google "acct" "m1"] (get t 0)))
    (is (= "Hello" (get t 1)))
    (is (= "a@b.c" (get t 2)))
    (is (= 1790093339000 (get t 3)))))

(deftest the-instant-comes-from-internalDate-not-the-Date-header
  ; The `Date` header is RFC 2822 in whatever timezone the sender's client
  ; chose, with a long tail of malformed senders. `internalDate` is the same
  ; instant already normalised, which is why nothing here parses a date.
  (let [m (assoc A-MESSAGE "internalDate" "0")
        t (gmail/tuple "acct" (assoc m "payload" {"headers" [{"name" "Date" "value" "Tue, 22 Sep 2026 18:08:59 +0200"}]}))]
    (is (= 0 (get t 3)))))

(deftest a-message-missing-a-header-is-nil-not-a-crash
  (let [t (gmail/tuple "acct" {"id" "m2" "internalDate" "5" "payload" {"headers" []}})]
    (is (nil? (get t 1)))
    (is (nil? (get t 2)))
    (is (= 5 (get t 3)))))

;; ── a file projects to a tuple ───────────────────────────────────────

(deftest an-rfc3339-instant-becomes-milliseconds
  ; One `DateTime.from_iso8601` away from the integer every other instant in
  ; this tree is.
  (is (= 1790092800000 (gdrive/millis "2026-09-22T16:00:00Z")))
  (is (nil? (gdrive/millis nil)))
  (is (nil? (gdrive/millis "not a date"))
      "a malformed timestamp is a MISSING value on one file, not a failed sync of ten thousand"))

(deftest a-file-tuple-is-entity-name-when
  (let [t (gdrive/tuple "acct" {"id" "f1" "name" "notes.md" "modifiedTime" "2026-09-22T16:00:00Z"})]
    (is (= 3 (count t)))
    (is (= [:google "acct" "f1"] (get t 0)))
    (is (= "notes.md" (get t 1)))
    (is (= 1790092800000 (get t 2)))))

;; ── the specs are values that name their relations ───────────────────

(deftest every-method-names-the-relation-it-is
  ; `:as` is what keeps the one rule from eroding the first time something is
  ; awkward: a method that cannot name its relation would be a method with no
  ; way to be reached except by a bespoke call, which is the parallel
  ; implementation the design forbids.
  (doseq [spec [gmail/spec gdrive/spec]
          [_ res] (seq (:resources spec))
          [_ m] (seq res)]
    (is (some? (get m :as)) (str (:id spec) " method has no :as"))
    (is (some? (get-in m [:as :relation])))))

(deftest the-specs-hold-no-code
  ; A spec is a value: nothing in it can make a request. That separation is
  ; what lets the same spec drive the real transport, a mock, and a budget
  ; line without any of the three knowing about the others.
  (doseq [spec [gmail/spec gdrive/spec]]
    (is (not (includes? (pr-str spec) "#<")) "no closures in a spec")))

(deftest both-domain-relations-are-registered
  (is (datom.query.relation/computed? :~msg/messages))
  (is (datom.query.relation/computed? :~file/files))
  (is (= 4 (get (datom.query.relation/relation :~msg/messages) :arity)))
  (is (= 3 (get (datom.query.relation/relation :~file/files) :arity))))

;; ── two spellings, one relation ──────────────────────────────────────

(deftest the-attribute-spelling-parses-to-the-generating-form
  ; `register-relation!` promises that `[?a :~rel ?b]` and `[(:~rel) [?a ?b]]`
  ; are one relation with two spellings. Until this normalisation only the
  ; second parsed: `analytic-clause?` requires a CALL FORM in first position, so
  ; in attribute position the clause fell through to the stored-attribute path,
  ; where no such attribute exists — a valid query rejected as `invalid query`,
  ; naming neither the clause nor the reason.
  (let [c (first (:where (parse/parse '[:find ?s :where [?m :~msg/messages ?s ?f ?w]])))]
    (is (vector? c))
    (is (list? (get c 0)) "the attribute moved into the OPERATOR position")
    (is (= :~msg/messages (first (get c 0))))
    (is (= '[?m ?s ?f ?w] (get c 1)) "and the entity joined the output tuple, order kept")))

(deftest a-stored-attribute-is-left-alone
  ; The normalisation is keyed on the attribute BEING a registered computed
  ; relation. A keyword that merely looks like one must go down the ordinary
  ; path, or every `:foo/bar` clause in the language becomes a relation lookup.
  (is (= '[[?e :msg/subject ?s]] (:where (parse/parse '[:find ?s :where [?e :msg/subject ?s]]))))
  (is (= '[[?e :conn/key ?k]] (:where (parse/parse '[:find ?k :where [?e :conn/key ?k]])))))

(deftest both-spellings-answer-the-same
  (let [db (datom/db (datom/connect))
        attr (datom/q '[:find ?s :where [?m :~msg/messages ?s ?f ?w]] db)
        gen (datom/q '[:find ?s :where [(:~msg/messages) [?m ?s ?f ?w]]] db)]
    (is (= attr gen) "one relation, two spellings, one answer")))
