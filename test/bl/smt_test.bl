; smt_test.bl — the one SMT printer, pinned.
;
; smt/emit is the only place a form becomes SMT-LIB text. Everything the
; checker, veritas and the translators build flows through it, so its rules
; ARE the system's SMT syntax: names not strings, `(- n)` for negatives,
; doubled quotes in string literals, one command per line, nils skipped.
(ns smt.test
  (:require [smt :as s]))

(deftest emit-symbols-and-sorts
  (is (= "x" (s/emit 'x)))
  ; a syntax-quoted operator can arrive namespaced (`sq/=`); SMT-LIB has no
  ; namespaces, so the printer keeps the NAME only
  (is (= "=" (s/emit 'sq/=)))
  (is (= "Int" (s/emit 'Int)))
  (is (= "Int" (s/emit :Int)))                       ; a sort by keyword
  (is (= "str.len" (s/emit 'str.len)))               ; a dotted SMT name is one name
  (is (= "(_ is E_mode-on)" (s/emit '(_ is E_mode-on)))))

(deftest emit-literals
  (is (= "42" (s/emit 42)))
  ; SMT-LIB numerals are non-negative; the negation is a term
  (is (= "(- 42)" (s/emit -42)))
  (is (= "1.5" (s/emit 1.5)))                        ; Real theory wants the point
  (is (= "2.0" (s/emit 2.0)))
  (is (= "(- 1.5)" (s/emit -1.5)))
  (is (= "true" (s/emit true)))
  (is (= "false" (s/emit false)))
  (is (= "\"hi\"" (s/emit "hi")))
  ; a string literal's quotes double — SMT-LIB's only escape
  (is (= "\"a\"\"b\"" (s/emit "a\"b"))))

(deftest emit-terms
  (is (= "(>= x 0)" (s/emit '(>= x 0))))
  (is (= "(ite (> x 0) 1 (- 2))" (s/emit '(ite (> x 0) 1 (- 2)))))
  ; vectors emit as terms; a string in term position is a String-theory
  ; literal, quotes and all
  (is (= "(+ x \"y\" z)" (s/emit ['+ 'x "y" :z])))
  (is (= "(= x (- 1))" (s/emit `(= ~'x -1)))))       ; spliced negatives render

(deftest emit-rejects-nil
  (is (thrown? (s/emit nil))))

(deftest script-commands
  ; one command per line, trailing newline
  (is (= "(declare-const x Int)\n(assert (>= x 0))\n"
         (s/script [(s/declare-const "x" "Int") (s/assert '(>= x 0))])))
  ; nils vanish, so a conditional command is (s/assert (when g form))
  (is (= "(assert p)\n" (s/script [nil (s/assert 'p)]))))

(deftest builders
  (is (= '(declare-const x Int) (s/declare-const "x" "Int")))
  (is (= '(declare-const x Int) (s/declare-const 'x :Int)))
  (is (= '(assert (>= x 0)) (s/assert '(>= x 0))))
  (is (nil? (s/assert nil)))
  ; sym: parts concatenated, symbols and strings alike
  (is (= 'bal2 (s/sym 'bal "2")))
  (is (= 'x2_i (s/sym "x2_" 'i))))
