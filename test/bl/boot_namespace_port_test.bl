; boot_namespace_port_test.bl — the bootstrap namespace contracts, in beam-lisp.
;
; Ported from the ExUnit `test/beam_lisp/boot_namespace_test.exs` (BUG-093).
; Three contracts, each of which had a silent-wrong-answer failure mode:
;
;   1. THE BOOT TIER'S NAMESPACE SET. `BeamLisp.Tiers.boot_namespaces/0` is the
;      list of `priv/boot/*.bl` namespaces that carry a namespace BEAM. An
;      action-only source (`data-readers.bl`: a body of `(data-reader! …)`
;      registrations) declares a namespace but emits no `Ns.Data-readers` shim,
;      so it must never be DEMANDED as one — nor left permanently `:unjudged`,
;      which is what made `bl seed --check` report STALE with 0 namespaces
;      moved. It stays in `sources/0` (it is a source the build compiles), but
;      not in `boot_namespaces/0`.
;
;   2. COLD PROVENANCE. `BeamLisp.AOT.beam_provenance/1` answers the
;      `{hash, key}` a beam was stamped with — but only after `ensure_loaded?/1`.
;      The ExUnit test pinned the regression: a COLD module (purged, present
;      only as a beam on the code path) answered `function_exported? == false`
;      and forced a rebuild, so the read has to load first. This test builds the
;      cold module for real: compile a fixture, purge/delete it, drop its beam in
;      a temp dir on the code path, and ask for its provenance.
;
;   3. THE SEED INVENTORY. `seed/namespaces` is the list of namespaces the
;      bootstrap floor must contain for a boot directory.
;
; ── THE ONE DELIBERATE DIVERGENCE FROM THE EXUNIT ASSERTION ─────────────────
;
; Case 3's ExUnit assertion was `Enum.sort(names) == Enum.sort(["Sample-boot",
; "Multi"])` for a boot dir holding `different-file.bl` (declares `(ns
; sample-boot)`) and `data-readers.bl` (no `(ns …)`). It pinned a HEADER-FILTERED
; inventory — read each file's `(ns …)` and keep the declared name.
;
; That approach was REVERTED in b39da4b8 ("the earlier partial BUG-093 attempt
; filtered `namespaces` by source header; that was wrong — data-readers HAS a
; header. Reverted to the original inventory; the fix belongs in the verdict,
; not the inventory."). The real `priv/boot/data-readers.bl` DOES declare `(ns
; data-readers)`, so a header-filter would keep it and the floor would again be
; permanently STALE; BUG-093's actual fix is the `:absent` verdict in
; `seed/check` (a namespace that emits no shim beam is reported, not blocking).
; The ExUnit assertion was never updated after the revert, so it has been RED
; ever since — it encodes a design the tree deliberately rejected. Reproducing
; it verbatim in the default `bl test` corpus would add a failing test.
;
; So case 3 pins the LIVE contract instead: the inventory is the boot directory's
; `.bl` FILE BASENAMES, camelized, plus `multi` — the declaration is NOT read.
; The action-only concern the header-filter was reaching for is covered by case 1
; (the tier set) and by `seed/check`'s `:absent` verdict.
;
; Run: bin/bl test test/bl/boot_namespace_port_test.bl

(ns boot-namespace-port-test)

; ── 1. the boot tier's namespace set ────────────────────────────────────────

(deftest action-only-boot-files-are-compiled-but-never-demanded-as-namespace-beams
  (let [namespaces (BeamLisp.Tiers/boot_namespaces)]
    (is (Enum/member? namespaces "compiler")
        "the compiler is a boot namespace")
    (is (Enum/member? namespaces "reader")
        "the reader is a boot namespace")
    (is (Enum/member? namespaces "core")
        "the prelude is a boot namespace")
    (is (not (Enum/member? namespaces "data-readers"))
        "an action-only source declares a namespace but emits no shim beam, so
         it must not be demanded as one")
    (is (Enum/any? (BeamLisp.Tiers/sources)
                   (fn [p] (ends-with? p "/boot/data-readers.bl")))
        "it IS a source the build compiles — excluded from the namespace set,
         not from the tree")))

; ── 2. cold provenance ──────────────────────────────────────────────────────
;
; The fixture is compiled, then purged and deleted so the ONLY way to answer its
; provenance is to load the beam off the prepended path. The ExUnit test used
; `setup`/`on_exit`; ward has no such hook, so the cleanup is an explicit
; `finally` (purge/delete/purge, drop the path, remove the tree) — the same
; purge-delete-purge the original ran, so a later test cannot see the fixture.

(deftest provenance-loads-a-cold-namespace-before-testing-its-export
  (let [root (str (System/tmp_dir!) "/bl-cold-provenance-"
                  (erlang/unique_integer (list :positive)))
        _ (File/mkdir_p! root)
        pair (first (Code/compile_string
                      (str "defmodule BeamLisp.ColdProvenanceFixture do\n"
                           "  def __bl_provenance__, do: {\"source\", \"generation\"}\n"
                           "end\n")))
        module (erlang/element 1 pair)
        beam (erlang/element 2 pair)]
    (code/purge module)
    (code/delete module)
    (File/write! (Path/join root (str (Atom/to_string module) ".beam")) beam)
    (Code/prepend_path root)
    (try
      (is (not (Kernel/function_exported? module :__bl_provenance__ 0))
          "the module is COLD — unloaded, present only as a beam on the path")
      (is (= (tuple "source" "generation") (BeamLisp.AOT/beam_provenance module))
          "beam_provenance ensure_loaded? the cold beam and read its stamp")
      (finally
        (code/purge module)
        (code/delete module)
        (code/purge module)
        (Code/delete_path root)
        (File/rm_rf! root)))))

; ── 3. the seed inventory ───────────────────────────────────────────────────
;
; A temp boot dir with two `.bl` files and no compiled beams: the inventory is
; read straight from the filenames, so it needs nothing but the files. `seed` is
; loaded here (the test VM may not carry the build tier yet) and its `namespaces`
; var is invoked the same way the floor's caller does.

(deftest the-seed-inventory-is-the-boot-dirs-file-basenames-plus-multi
  (BeamLisp/init)
  (let [root (str (System/tmp_dir!) "/bl-seed-names-"
                  (erlang/unique_integer (list :positive)))]
    (File/mkdir_p! root)
    (try
      (File/write! (Path/join root "different-file.bl") "(ns sample-boot)\n(def value 1)\n")
      (File/write! (Path/join root "data-readers.bl") "(println :action-only)\n")
      (BeamLisp.Loader/ensure_loaded "seed")
      (let [names (Enum/to_list
                    (BeamLisp.Ns.Rt/invoke
                      (BeamLisp.Env/fetch! "seed" "namespaces")
                      (list root)))]
        (is (= (Enum/sort ["Data-readers" "Different-file" "Multi"])
               (Enum/sort names))
            "the inventory is the boot dir's basenames, camelized, plus `multi`")
        (is (not (Enum/member? names "Sample-boot"))
            "the `(ns sample-boot)` DECLARATION is not read — the prior
             header-filtered inventory was reverted in b39da4b8 (BUG-093)"))
      (finally (File/rm_rf! root)))))
