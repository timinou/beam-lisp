; proc_clause_aot_test.bl — a clause registration survives the AOT beam.
;
; The clause contract: a bundle registers its clause at the FOOT of its file
; (`extend-clause!`), and a consumer requires that bundle and then writes the
; clause (`(registry (keys …))`, `(bus …)`, `(tick …)`).
;
; An AOT image used to break exactly that, invisibly. `bl build` writes a beam
; per namespace, and the beam's `__bl_init__/0` — the whole of what a fresh VM
; replays — re-runs a namespace's requires, its refers, its fn vars and its
; VALUE DEFS, but never a bare top-level CALL. So a registration written as a
; call was present from source and GONE from the beam: the vocabulary came back
; empty, and every clause of that bundle died with `unknown clause` in a tree
; that loads fine from source (measured 2026-09-20: `bl build`, then
; `(proc/registered-clauses)` → `[]`, and `priv/std/proc/table.bl`'s
; `(registry …)` clause failed to expand at load).
;
; The fix makes `extend-clause!` a MACRO whose expansion is a `def`, and a value
; def's initializer is replayed. This file pins THAT property, on a throwaway
; namespace, so it fails if the registration ever stops being replayable: build
; a probe that registers a clause, empty the vocabulary the way a fresh VM has
; it, replay the beam's `__bl_init__/0`, and require the clause to be back.
;
; Run: bin/bl -p priv/std test --shared test/bl/proc_clause_aot_test.bl

(ns proc-clause-aot.test
  (:require [proc.server :as ps]
            [build :as b]
            [proc.reg :as reg]))

(def root
  (str (System/tmp_dir!) "/bl_proc_clause_aot_" (erlang/unique_integer (list :positive))))
(def out (str root "/ebin"))

(def probe-ns "proc-clause-aot.probe")

(def probe-src
  (str "(ns " probe-ns "\n"
       "  (:require [proc.server :refer [extend-clause!]]))\n"
       "\n"
       "(defn probe-transform [clause _ctx]\n"
       "  {:init {:probe (second clause)}})\n"
       "\n"
       "(extend-clause! :probe-in-aot probe-transform)\n"))

(defn- build-probe!
  "AOT-compile the probe namespace into an isolated ebin. The clause it
   registers is the whole input; the beam is the whole output."
  []
  (File/rm_rf! root)
  (File/mkdir_p! root)
  (System/put_env "BEAM_LISP_AOT_CACHE" "off")
  (let [src (str root "/probe.bl")]
    (File/write! src probe-src)
    (b/run {:sources [src]
            :out out
            :manifest (str out "/compile.beam_lisp")
            :jobs 1})))

(deftest a-clause-registration-is-replayed-from-the-beam
  (let [before @ps/registry]
    (try
      (let [r (build-probe!)]
        (is (= [] (:errors r)) "the probe namespace compiled")
        (is (fn? (get @ps/registry :probe-in-aot))
            "compiling the source registered the clause — the source path works"))
      ;; A FRESH VM's vocabulary, and then the ONLY thing an AOT load runs.
      (reset! ps/registry {})
      (let [mod (BeamLisp.Emit/module_for probe-ns)]
        (code/ensure_loaded mod)
        (erlang/apply mod :__bl_init__ (list)))
      (is (some (fn [c] (= "probe-in-aot" c)) (ps/registered-clauses))
          "`__bl_init__/0` replayed the registration, so the clause survives `bl build`")
      (is (fn? (get @ps/registry :probe-in-aot))
          "…and what came back is the transform, not a placeholder")
      (is (= [] (:unknown (ps/clause-plan {:name 'x
                                           :clauses '((probe-in-aot 1))
                                           :vocabulary @ps/registry
                                           :native-heads #{"init"}})))
          "the replayed registration is visible to the PURE model — not just to the atom")
      (finally
        (reset! ps/registry before)
        (File/rm_rf! root)))))


;; ── the pure model: an EXPLICIT vocabulary, no VM ────────────────────────
;;
;; `clause-plan` is the expansion as DATA. It is exercised here with a
;; vocabulary built BY HAND — no `BeamLisp.Server/callback`, no registry — which
;; is the whole point: the DSL transformation is a pure function of the forms
;; and the vocabulary, so a backend that has neither can consume the same
;; declaration.

(deftest an-explicit-vocabulary-decides-pass-contribute-unknown
  (let [vocab {:probe (fn [clause _ctx]
                        {:init {:probe (second clause)}
                         :clauses '((handle-call [:probe] [_from st] (reply (:probe st) st)))})}
        p (ps/clause-plan {:name 'x
                           :clauses '((init [_] (ok {:n 0}))
                                      (probe 42)
                                      (terminate [_ _] :ok))
                           :vocabulary vocab
                           :native-heads #{"init" "terminate"}})]
    (is (= [] (:unknown p)) "every head is either native or in the vocabulary")
    (is (= 1 (count (:contributions p))) "the `probe` head was contributed")
    (is (= 1 (count (:injected p))) "its clause form is injected")
    (is (= 3 (count (:body p))) "rebuilt init + injected clause + the user's `terminate`")
    (is (= 'init (first (first (:body p)))) "the rebuilt init leads")
    (is (= 'handle-call (first (second (:body p)))) "injected clauses precede the user's")
    (is (= 'terminate (first (nth (:body p) 2))) "a native clause passes through")
    (is (nil? (:down-clause p)) "nothing watches, so there is no :DOWN path")))

(deftest an-unknown-clause-is-reported-and-named
  (let [p (ps/clause-plan {:name 'x
                           :clauses '((frobnicate 1))
                           :vocabulary {}
                           :native-heads #{"init"}})]
    (is (= 1 (count (:unknown p))) "the head is reported, not guessed")
    (is (= "frobnicate" (:head (first (:unknown p)))))
    (is (= 'x (:where (first (:unknown p)))))
    (is (empty? (:body p)) "nothing is emitted for a form that is invalid"))
  (let [msg (ex-message (ps/unknown-clause-error 'x {:head "frobnicate" :where 'x}))]
    (is (>= (index-of msg "frobnicate") 0) "the message names the offending head")
    (is (>= (index-of msg "registry") 0)
        "and lists the accepted vocabulary, so the fix is read off it")
    (is (>= (index-of msg "COMPILED") 0) "and carries the rule about WHEN a clause resolves")))

;; ── the shipping registry clause, reused: slices AND one merged :DOWN ────
;;
;; `registry-clause` is the contribution a bundle SHIPS; this reuses it rather
;; than a stand-in, and pairs it with a second watcher. Two clauses that each
;; catch every `:DOWN` cannot coexist (first match wins), so the expander must
;; thread both through ONE clause — the property a second backend must inherit.

(deftest a-registry-and-a-second-watcher-share-one-down-path
  (let [watcher (fn [_clause _ctx]
                  {:down [(fn [st _ref _pid _reason] (assoc st :saw-down true))]})
        p (ps/clause-plan {:name 'x
                           :clauses '((init [_] (ok {}))
                                      (registry (keys :id))
                                      (watch))
                           :vocabulary {:registry reg/registry-clause
                                        :watch watcher}
                           :native-heads #{"init"}})]
    (is (= [] (:unknown p)))
    (is (= (:clauses (first (:contributions p))) (:injected p))
        "the planner preserves the registry contribution without losing a call")
    (is (= 2 (count (:down p))) "two clauses contributed a :down handler")
    (is (some? (:down-clause p)) "…and the expander merged them into ONE clause")
    (is (= 'handle-info (first (:down-clause p))) "which is a handle-info")
    (is (= 1 (count (filter (fn [c] (= 'handle-info (first c))) (:body p))))
        "the server body carries exactly one handle-info for :DOWN")
    (is (= 1 (count (:down (first (:contributions p)))))
        "the registry's contribution is reused unchanged")))
