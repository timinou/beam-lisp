; Exercise generated ES-module initialization with a tiny runtime graph, so a
; bootstrap regression is diagnosed without compiling the whole prelude.
(ns bl.js.boot-order-test (:require [js.build :as build] [bl.util :as u]))

(deftest core-seeding-is-a-real-dependency-even-when-core-is-requested-first
 (let [root (str (System/tmp_dir!) "/bl-js-order-" (System/pid) "-" (System/unique_integer (list :positive)))
       source (str root "/src") out (str root "/out")
       runtime (Path/dirname (BeamLisp.Loader/source_path "js.build"))]
  (try
   (File/mkdir_p! source)
   (File/write! (str source "/rt.bl")
    "(ns rt)\n(defn seed-core [] (js/mark \"seed\"))\n(defn call-invoke [f args] nil)\n(defn seq-to-args [xs] xs)\n(defn read-core [] core/boot-value)\n")
   (File/write! (str source "/core.bl")
    "(ns core)\n(def boot-value (js/mark \"core\"))\n")
   (File/write! (str source "/boot-order.bl")
    "(ns boot-order)\n(js/mark \"entry\")\n")
   (let [result (build/build {:roots [source] :entry "boot-order" :out out
                             :with ["core" "rt"] :core #{} :leaves #{} :host #{"mark"}})]
    (is (= ["rt" "core" "boot-order"] (:modules result))))
   (doseq [file ["rt.mjs" "abi.mjs" "lazy.mjs" "leaves.mjs" "env.mjs" "interop.mjs"
                 "native-values.mjs" "host-leaves.mjs" "core-links.mjs"]]
    (File/cp! (str runtime "/" file) (str out "/" file)))
   (File/mkdir_p! (str out "/actor"))
   (doseq [file ["host.mjs" "native.mjs" "module.mjs"]]
    (File/cp! (str runtime "/actor/" file) (str out "/actor/" file)))
   (File/write! (str out "/host.mjs") "export const H=globalThis.BL_HOST;\n")
   (File/write! (str out "/proof.mjs")
    "import assert from 'node:assert/strict';\nconst events=[];globalThis.BL_HOST={mark:x=>{events.push(x);return 42;}};\nawait import('./ns/boot-order.mjs');\nassert.deepEqual(events,['seed','core','entry']);\nconst rt=await import('./ns/rt.mjs');\nassert.equal(rt.d_read_core(),42);\nconsole.log('BOOT_ORDER_OK');\n")
   (let [result (System/cmd "node" (u/to-list [(str out "/proof.mjs")]) (u/kw [:stderr_to_stdout true]))]
    (is (= 0 (elem result 1)) (elem result 0))
    (is (= "BOOT_ORDER_OK\n" (elem result 0))))
   (finally (File/rm_rf! root)))))
