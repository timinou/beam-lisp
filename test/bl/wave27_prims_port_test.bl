; test/bl/wave27_prims_port_test.bl — the ten wave-27 prims that gate the
; Specter slices (type, instance?, symbol, sequence, keys, vals, vec, subs,
; dissoc, unreduced), ported from the ExUnit
; `test/beam_lisp/wave27_prims_test.exs`.
;
; The ExUnit file held the ELIXIR-SIDE assertions — the ones the self-hosted
; `test/bl/prelude_test.bl` cannot make, because prelude IS the language:
;   * `symbol`'s exact reader tuple `{:symbol name}` (a beam-lisp symbol IS that
;     2-tuple, so the value is the one the reader yields for `'x`);
;   * the collection fns still RAISE on reference types (wave-1 consistency),
;     and `dissoc` on an atom raises rather than reading %Atom{}'s fields;
;   * `vec` REALIZES a lazy seq instead of returning a LazySeq;
;   * `subs` out of range raises `BeamLisp.ExInfo` — the CLASS is the contract.
;
; WHERE THE ExUnit DRIVER WENT
;   `BeamLisp.Test.realize/1` forced a lazy seq before every comparison. `=` is
;   structural and realizes, and each assertion below still pins the REALIZED
;   value, so a seq that stopped being lazy in the wrong way still fails. The
;   ExUnit `assert_raise`/`raises?` pair becomes the framework's own `thrown?`
;   (any raise) for the loose cases, and a TYPED `(catch BeamLisp.ExInfo e …)`
;   for `subs`, where the original named the exact class.
;
; ASSERTION MAP (ExUnit test → BL deftest), all 10 originals, none dropped:
;   symbol builds the exact reader tuple {:symbol, name}
;     → symbol-builds-the-exact-reader-tuple
;   type returns the type_of vocabulary for builtins and the module for a record
;     → type-returns-the-type-of-vocabulary-for-builtins-and-the-module-for-a-record
;   instance? checks type identity for builtins and user types
;     → instance-checks-type-identity-for-builtins-and-user-types
;   vec realizes a lazy seq and nil-puns to []
;     → vec-realizes-a-lazy-seq-and-nil-puns-to-empty
;   collection fns still RAISE on reference types (wave-1 consistency)
;     → collection-fns-still-raise-on-reference-types
;   sequence returns () on empty and an actual seq otherwise
;     → sequence-returns-empty-on-empty-and-an-actual-seq-otherwise
;   keys and vals round-trip the map and agree with seq
;     → keys-and-vals-round-trip-the-map-and-agree-with-seq
;   subs is char-based and raises out of range (BeamLisp.ExInfo)
;     → subs-is-char-based-and-raises-out-of-range
;   unreduced unwraps a Reduced and passes values through
;     → unreduced-unwraps-a-reduced-and-passes-values-through
;   dissoc on a record's declared field yields a plain map
;     → dissoc-on-a-records-declared-field-yields-a-plain-map
;
; Run: bin/bl test test/bl/wave27_prims_port_test.bl

(ns wave27.prims.test)

(defrecord W27ET [x y])
(defrecord W27EI [x y])
(defrecord W27ED [x y])

(deftest symbol-builds-the-exact-reader-tuple
  (is (= (tuple :symbol "x") (symbol "x")))
  (is (= (tuple :symbol "foo/bar") (symbol "foo" "bar")))
  (is (= (tuple :symbol "x") (symbol nil "x")))
  (is (= (tuple :symbol "kw") (symbol :kw))))

(deftest type-returns-the-type-of-vocabulary-for-builtins-and-the-module-for-a-record
  (is (= :integer (type 5)))
  (is (= :float (type 1.5)))
  (is (= :binary (type "s")))
  (is (= :vector (type [1])))
  (is (= :map (type {:a 1})))
  (is (= :nil (type nil)))
  ; the module is a beam-lisp record module, and the Specter shape works
  (is (erlang/is_atom (type (->W27ET 1 2))))
  (is (contains? #{W27ET} (type (->W27ET 1 2)))))

(deftest instance-checks-type-identity-for-builtins-and-user-types
  (is (= true (instance? :vector [1 2])))
  (is (= true (instance? :integer 5)))
  (is (= false (instance? :integer 5.0)))
  (is (= false (instance? :map [1 2])))
  (is (= true (instance? W27EI (->W27EI 1 2))))
  (is (= false (instance? W27EI {:a 1}))))

(deftest vec-realizes-a-lazy-seq-and-nil-puns-to-empty
  (is (= [] (vec nil)))
  (is (= [1 2 3] (vec [1 2 3])))
  ; (range 3) is a lazy seq; vec must FORCE it, not return a LazySeq
  (is (vector? (vec (range 3))))
  (is (= [0 1 2] (vec (range 3)))))

(deftest collection-fns-still-raise-on-reference-types
  ; Reference types are not collections; if any of these starts reading one it
  ; is reading %Atom{}'s internal struct fields.
  (is (thrown? (keys (atom 1))))
  (is (thrown? (vals (atom 1))))
  (is (thrown? (vec (atom 1))))
  (is (thrown? (sequence (atom 1))))
  (is (thrown? (dissoc (atom 1) :k)))
  (is (thrown? (dissoc (atom 1) :value))))

(deftest sequence-returns-empty-on-empty-and-an-actual-seq-otherwise
  (is (= () (sequence nil)))
  (is (= () (sequence [])))
  (is (= true (seq? (sequence [1 2 3]))))
  (is (= '(1 2 3) (sequence [1 2 3])))
  (is (= '(1 2) (sequence (take 2) [1 2 3 4])))
  (is (= () (sequence (take 0) [1 2 3 4]))))

(deftest keys-and-vals-round-trip-the-map-and-agree-with-seq
  (is (= #{:a :b} (set (keys {:a 1 :b 2}))))
  (is (= #{1 2} (set (vals {:a 1 :b 2}))))
  ; zipmap over the two seqs rebuilds the map, so keys/vals agree with seq
  (is (= {:a 1 :b 2} (zipmap (keys {:a 1 :b 2}) (vals {:a 1 :b 2}))))
  ; nil punning
  (is (= nil (keys nil)))
  (is (= nil (vals nil)))
  (is (= nil (keys {}))))

(deftest subs-is-char-based-and-raises-out-of-range
  (is (= "ello" (subs "hello" 1)))
  (is (= "el" (subs "hello" 1 3)))
  (is (= "é" (subs "héllo" 1 2)))
  (is (= "" (subs "hello" 5)))
  ; the CLASS is the contract: a bare "it raised" would pass on the wrong
  ; internal failure
  (is (try (do (subs "hello" 9) false)
           (catch BeamLisp.ExInfo e true))))

(deftest unreduced-unwraps-a-reduced-and-passes-values-through
  (is (= 42 (unreduced (reduced 42))))
  (is (= 42 (unreduced 42)))
  (is (= nil (unreduced nil))))

(deftest dissoc-on-a-records-declared-field-yields-a-plain-map
  ; a real map, not a half-broken struct
  (is (= {:y 2} (dissoc (->W27ED 1 2) :x)))
  (is (= false (BeamLisp.Record/record? (dissoc (->W27ED 1 2) :x))))
  ; dissoc'ing a non-declared key keeps it a record
  (is (= true (BeamLisp.Record/record? (dissoc (->W27ED 1 2) :zz))))
  ; the constructor still yields a value (the ExUnit `refute is_nil(r)`)
  (is (not (nil? (->W27ED 1 2))))
  (is (= nil (dissoc nil :k))))
