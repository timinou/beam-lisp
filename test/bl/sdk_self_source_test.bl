(ns sdk-self-source-test)
(deftest reference-tooling-source-does-not-claim-fixed-sdk-ownership
 (let [root (BeamLisp.Tiers/priv_root)]
  (is (not (BeamLisp.AOT/sdk_library_source? "self.anf" (Path/join root "self/anf.bl"))))
  (is (BeamLisp.AOT/sdk_library_source? "datom" (BeamLisp.Loader/source_path "datom")))))
