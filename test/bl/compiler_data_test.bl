; compiler_data_test.bl — the eager, finite-data traversal leaf the compiler
; calls on every compile, tested at its INSTALLED home.
;
; Ported from the ExUnit `test/beam_lisp/compiler_data_test.exs`. That suite
; called `BeamLisp.CompilerData` — the Elixir module — because the leaf was
; authored in `lib/`. The leaf is now a pinned HOST BEAM: `priv/host/compiler_data.bl`
; compiled to `Elixir.BeamLisp.CompilerData.beam`, committed in the bootstrap
; seed and installed into the build's ebin by `Bootstrap.install!/1`. So the
; suite still calls the same atom, and what it calls is the SEED beam — not a
; source compile. The last two tests pin that: the live module's beam IS the
; committed seed's bytes, it carries the pinned attributes, and a FRESH `bin/bl`
; loads the same bytes. There is no `lib/*.ex` fallback left.
;
; Behaviour is asserted as concrete expected values, never by diffing against a
; second implementation: after the `.ex` is deleted there is no second
; implementation, and an answer both sides get wrong is not a contract.
;
; Run: bin/bl test test/bl/compiler_data_test.bl

(ns compiler-data.test)

; [1 | :tail] — the one shape `is_list/1` accepts and `length/1` refuses. Built
; from its external term format because the reader has no improper-cons literal.
(defn- improper-list []
  (erlang/binary_to_term
    (erlang/list_to_binary (list 131 108 0 0 0 1 97 1 119 4 116 97 105 108))))

(defn- attr [mod key]
  (some (fn [a] (when (= key (erlang/element 1 a)) (erlang/element 2 a)))
        (erlang/apply mod :module_info (list :attributes))))

; ── the ported suite ────────────────────────────────────────────────────────

(deftest finite-collections-and-zipped-mapping-remain-eager
  (is (= (list 2 4)
         (BeamLisp.CompilerData/eager_map (fn [x] (* x 2)) (BeamLisp.Vector/new (list 1 2)))))
  (is (= (list 11)
         (BeamLisp.CompilerData/eager_map (fn [a b] (+ a b)) (list 1 2) (list 10)))
      "the two-collection arity zips to the SHORTER input")
  (is (= (list)
         (BeamLisp.CompilerData/eager_map (fn [x] x) nil)))
  (is (= (list (BeamLisp.Vector/new (list :a 1)))
         (BeamLisp.CompilerData/eager_to_list {:a 1}))
      "a raw map becomes [key value] vectors, so a compiler dict is finite data")
  (is (= (list (erlang/list_to_tuple (list 0 :a)) (erlang/list_to_tuple (list 1 :b)))
         (BeamLisp.CompilerData/eager_map_indexed
           (fn [i x] (erlang/list_to_tuple (list i x))) (list :a :b)))
      "eager_map_indexed passes the INDEX first"))

(deftest mapping-and-grouping-invoke-callbacks-once-in-source-order
  (Process/put :compiler_order (list))
  (BeamLisp.CompilerData/eager_map
    (fn [x] (Process/put :compiler_order (cons x (Process/get :compiler_order))) (rem x 2))
    (list 3 1 2))
  (is (= (list 2 1 3) (Process/get :compiler_order))
      "eager_map visits each element once, in source order")
  (Process/put :compiler_order (list))
  (BeamLisp.CompilerData/eager_group_by
    (fn [x] (Process/put :compiler_order (cons x (Process/get :compiler_order))) (rem x 2))
    (list 3 1 2))
  (is (= (list 2 1 3) (Process/get :compiler_order))
      "eager_group_by computes keys in source order too")
  (is (= {0 (list 2 4) 1 (list 3 1)}
         (BeamLisp.CompilerData/eager_group_by (fn [x] (rem x 2)) (list 3 1 2 4)))
      "each group keeps its elements in source order"))

(deftest filter-truthiness-stable-sort-and-distinct-preserve-order
  (is (= (list 0 :ok) (BeamLisp.CompilerData/eager_filter (fn [x] x) (list false nil 0 :ok)))
      "only false and nil are falsy")
  (is (= (list 4 2 3 1 5)
         (BeamLisp.CompilerData/eager_sort_by (fn [x] (rem x 2)) (list 3 1 4 2 5)))
      "stable: elements with equal keys keep source order")
  (is (= (list 2 1 3) (BeamLisp.CompilerData/eager_distinct (list 2 1 2 3 1)))
      "distinct keeps first occurrences, in order"))

(deftest concat-and-mapcat-preserve-nested-collection-order
  (is (= (list 1 2 3)
         (BeamLisp.CompilerData/eager_concat
           (list nil (list 1) (BeamLisp.Vector/new (list 2 3)) (list)))))
  (is (= (list 1 2 3 4)
         (BeamLisp.CompilerData/eager_mapcat (fn [x] (list x (+ x 1))) (list 1 3)))))

(deftest improper-inputs-are-refused-before-invoking-callbacks
  (is (erlang/is_list (improper-list))
      "an improper cons is a valid list-shaped term — constructible before it is refused")
  (Process/put :compiler_effect false)
  (is (thrown-with-msg? "finite data"
        (BeamLisp.CompilerData/eager_map (fn [x] (Process/put :compiler_effect true)) (improper-list))))
  (is (= false (Process/get :compiler_effect))
      "the malformed spine is refused before any callback runs"))

(deftest lazy-inputs-and-lazy-mapcat-results-are-not-realized
  (Process/put :compiler_effect false)
  (let [lazy (BeamLisp.LazySeq/new (fn [] (Process/put :compiler_effect true) (list 1)))]
    (is (thrown-with-msg? "LazySeq" (BeamLisp.CompilerData/eager_map (fn [x] x) lazy)))
    (is (thrown-with-msg? "LazySeq" (BeamLisp.CompilerData/eager_filter (fn [x] x) lazy)))
    (is (thrown-with-msg? "LazySeq" (BeamLisp.CompilerData/eager_concat (list (list 0) lazy))))
    (is (thrown-with-msg? "LazySeq" (BeamLisp.CompilerData/eager_mapcat (fn [_] lazy) (list 0))))
    (is (= false (Process/get :compiler_effect))
        "no traversal realized the LazySeq")))

(deftest callback-exceptions-preserve-their-original-class-and-stop-traversal
  (Process/put :compiler_order (list))
  (is (= :function-clause
         (try (BeamLisp.CompilerData/eager_map
                (fn [x]
                  (Process/put :compiler_order (cons x (Process/get :compiler_order)))
                  (if (= x 2) (erlang/apply :lists :nth (list 0 (list))) x))
                (list 1 2 3))
              :returned
              (catch FunctionClauseError e :function-clause)
              (catch e :other-class)))
      "the callback's own exception class propagates unchanged")
  (is (= (list 2 1) (Process/get :compiler_order))
      "traversal stops at the raising element — 3 is never visited")
  (is (= :erlang-error
         (try (BeamLisp.CompilerData/eager_map (fn [x] (erlang/error :boom)) (list 1))
              :returned
              (catch ErlangError e :erlang-error)
              (catch e :other-class)))
      "a second class proves the module wraps nothing"))

(deftest finite-ranges-use-exclusive-endpoints-and-empty-bounds
  (is (= (list 0 1 2) (BeamLisp.CompilerData/eager_range 3)))
  (is (= (list 2 3) (BeamLisp.CompilerData/eager_range 2 4)))
  (is (= (list) (BeamLisp.CompilerData/eager_range 0)))
  (is (= (list) (BeamLisp.CompilerData/eager_range 4 2))))

(deftest every-eager-entry-point-has-the-arity-the-compiler-calls
  (let [m :Elixir.BeamLisp.CompilerData
        exported? (fn [f a] (erlang/apply :erlang :function_exported (list m f a)))]
    (is (exported? :eager_to_list 1))
    (is (exported? :eager_map 2))
    (is (exported? :eager_map 3))
    (is (exported? :eager_filter 2))
    (is (exported? :eager_concat 1))
    (is (exported? :eager_mapcat 2))
    (is (exported? :eager_map_indexed 2))
    (is (exported? :eager_sort_by 2))
    (is (exported? :eager_group_by 2))
    (is (exported? :eager_distinct 1))
    (is (exported? :eager_range 1))
    (is (exported? :eager_range 2))))

; ── the installed module IS the committed seed ──────────────────────────────
;
; With the `.ex` gone there is no `lib` source to fall back to, but the proof
; that the RUNNING module came from the seed (and not, say, a stale beam an old
; elixirc pass left in the ebin) is the beam itself: it must be the committed
; floor's bytes, and it must carry the pinned attributes. `bl_compiler_key` is
; the generation claim `Bootstrap.fresh_generation?/2` reads; the presence of
; `bl_source_hash` is what separates a pinned host beam from an elixirc build.
; Whether the SEED is current for its source is `bl seed --check`'s question,
; not this suite's.

(deftest the-installed-module-is-the-committed-seed-beam
  (let [root (BeamLisp/cwd)
        seed (Path/join root "priv/bootstrap/seed/Elixir.BeamLisp.CompilerData.beam")
        installed (unicode/characters_to_binary (code/which :Elixir.BeamLisp.CompilerData))
        hash (attr :Elixir.BeamLisp.CompilerData :bl_source_hash)]
    (is (File/exists? seed) "the committed floor carries the host leaf")
    (is (some? installed) "the module is loaded from a beam")
    (is (= (File/read! seed) (File/read! installed))
        "the live module's bytes ARE the committed seed's bytes — no lib source fallback")
    (is (= 64 (erlang/byte_size hash))
        "the beam carries a pinned source digest (an elixirc build has none)")
    (is (nil? (attr :Elixir.BeamLisp.CompilerData :bl_compiler_key))
        "a floor beam carries no generation key: the seed manifest claims it")
    (is (BeamLisp.Bootstrap/claimed? (Path/join root "priv/bootstrap/seed")
          "Elixir.BeamLisp.CompilerData.beam" (BeamLisp.AOTCache/compiler_key))
        "and the committed manifest claims these bytes under this toolchain's key")))

(deftest a-fresh-bin-bl-loads-the-same-seed-beam
  (let [root (BeamLisp/cwd)
        probe (Path/join (System/tmp_dir!)
                (str "bl_seed_probe_" (erlang/unique_integer (list :positive)) ".bl"))
        installed (unicode/characters_to_binary (code/which :Elixir.BeamLisp.CompilerData))
        hash (attr :Elixir.BeamLisp.CompilerData :bl_source_hash)]
    (File/write! probe
      (str "(ns bl.seed.probe)\n"
           "(let [m :Elixir.BeamLisp.CompilerData\n"
           "      attrs (erlang/apply m :module_info (list :attributes))\n"
           "      attr (fn [k] (some (fn [a] (when (= k (erlang/element 1 a)) (erlang/element 2 a))) attrs))]\n"
           "  (println (str \"BLSEED path=\" (unicode/characters_to_binary (code/which m))\n"
           "                \" source=\" (attr :bl_source_hash)\n"
           "                \" key=\" (attr :bl_compiler_key))))\n"))
    (let [r (System/cmd (Path/join root "bin/bl") (to-list (list "run" probe))
              (to-list (list (erlang/list_to_tuple (list :cd root))
                             (erlang/list_to_tuple (list :stderr_to_stdout true)))))
          out (elem r 0)
          code (elem r 1)]
      (is (= 0 code) (str "a fresh bin/bl boots and answers:\n" out))
      (is (includes? out (str "source=" hash))
          "a process that compiled nothing carries the seed beam's source digest")
      (is (includes? out "key=")
          "and reports its (absent) key attribute")
      (is (includes? out (str "path=" installed))
          "loaded from the same beam path this VM resolved"))
    (File/rm! probe)))
