; Union builds expose library entrypoints. Boot must own its base initialization
; and refuse incomplete macro caches, independently of the application's entry.
; Run: BL_TEST_TIMEOUT=1200 bin/bl test test/bl/js_union_boot_test.bl
(ns bl.js.union-boot-test (:require [bl.js :as js] [bl.util :as u]))
(deftest evaluator-boots-first-from-a-union-and-rejects-an-incomplete-cache
 (if (nil? (System/find_executable "node")) (is true "node unavailable")
  (let [root (str (System/tmp_dir!) "/bl-union-boot-" (System/pid) "-" (System/unique_integer (list :positive)))
        out (str root "/out") source (str root "/source")]
   (try
    (File/mkdir_p! (str source "/union"))
    (File/write! (str source "/union/main.bl") "(ns union.main (:require [js.eval]))")
    (js/build! "union.main" {:paths (list source) :out out :stub "lower" :with "reader" :host "run"})
    (let [script (str root "/boot-proof.mjs")]
     (File/write! script
      "const out=process.argv[2];
const {start}=await import(out+'/repl.mjs');
const vm=await start(()=>{throw new Error('compiled bootstrap must not fetch');});
const C=await import(out+'/boot-cache.mjs');
if(C.VERSION!==1||C.REQUIRED_MACROS.length<34)throw new Error('incomplete macro inventory');
const v=vm.evalString('(loop [x 0] (cond (< x 4) (recur (+ x 1)) :else x))');
if(v!==4)throw new Error('cond/recur failed');
console.log('union bootstrap ready');")
     (let [result (System/cmd "node" (u/to-list [script out]) (u/kw [:stderr_to_stdout true]))]
      (is (= 0 (elem result 1)) (elem result 0))
      (is (= "union bootstrap ready\n" (elem result 0)))))
    (File/write! (str out "/boot-cache.mjs")
     "export const VERSION=1; export const REQUIRED_MACROS=[['core','missing']]; export const PRELOADS=[]; export const ENTRIES=[['core','stub',[],true]];")
    (let [script (str root "/missing-proof.mjs")]
     (File/write! script
      "const {start}=await import(process.argv[2]+'/repl.mjs');
try{await start(()=>{throw new Error('unexpected source fallback');});throw new Error('accepted incomplete cache');}
catch(e){if(!e.message.includes('Cached bootstrap macro missing'))throw e;console.log('incomplete cache refused');}")
     (let [result (System/cmd "node" (u/to-list [script out]) (u/kw [:stderr_to_stdout true]))]
      (is (= 0 (elem result 1)) (elem result 0))
      (is (= "incomplete cache refused\n" (elem result 0)))))
    (finally (File/rm_rf! root))))))
