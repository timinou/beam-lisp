; test/bl/system/z3_conversation_test.bl — a conversation is one caller's.
;
; `z3/check` is one conversation in one call: reset, assert, check-sat. z3 also
; keeps state ACROSS calls — assertions, push/pop scopes, named assertions whose
; unsat core is readable — and that state belongs to exactly one caller. Two
; callers interleaving in one z3 context is the same defect as two callers reading
; each other's port replies: measured, 98 wrong verdicts in 200 concurrent
; verifies (see z3_concurrent_test.bl).
;
; So the verbs below require a LEASE. This file pins three things: the lease
; excludes a second borrower until release; the conversation verbs do what z3
; says they do (push/pop, unsat cores, assumptions); and a verb used WITHOUT the
; lease is refused rather than tolerated.

(ns mcp.z3.conversation.test
  (:require [z3]))

(defn- until [pred]
  (let [t (atom false)]
    (loop [n 0]
      (cond
        (pred) true
        (> n 5000) false
        :else (do (Process/sleep 10) (recur (inc n)))))))

;; ── the lease ─────────────────────────────────────────────────────────────

(deftest a-conversation-excludes-a-second-borrower
  (let [parent (erlang/self)
        body-a (fn []
                 (z3/with-solver (fn []
                                   (erlang/send parent [:in-a])
                                   (Process/sleep 500)
                                   (erlang/send parent [:out-a]))))
        body-b (fn [] (z3/with-solver (fn [] (erlang/send parent [:in-b]))))
        _a (erlang/spawn body-a)
        entered-a (receive [:in-a] true (after 10000 :none))
        _b (erlang/spawn body-b)
        while-held (receive [:in-b] :in-b (after 200 :none))]
    (is (= true entered-a) "A took the conversation")
    (is (= :none while-held) "B cannot enter while A holds it")
    (is (= true (receive [:out-a] true (after 10000 :none))) "A finished")
    (is (= :in-b (receive [:in-b] :in-b (after 10000 :none)))
        "and B enters the moment A releases — the lease is handed over, not dropped")))

(deftest a-dead-borrower-returns-its-lease
  ; The monitor half of the rule: `finally` cannot run in a process that is
  ; killed, so the solver watches the borrower instead.
  (let [holder (erlang/spawn (fn [] (z3/with-solver (fn [] (Process/sleep 30000)))))]
    (is (until (fn [] (= holder (BeamLisp.Z3.Solver/owner nil))))
        "the holder owns the solver")
    (erlang/exit holder :kill)
    (is (until (fn [] (nil? (BeamLisp.Z3.Solver/owner nil))))
        "killing the holder releases it — a crashed borrower strands nothing")))

;; ── what a conversation buys ──────────────────────────────────────────────

(deftest push-and-pop-scope-assertions
  (let [answers (z3/with-solver
                  (fn []
                    (z3/command "(declare-const z Int)")
                    (z3/command "(assert (> z 5))")
                    (let [before (z3/check-here)]
                      (z3/push)
                      (z3/command "(assert (< z 2))")
                      (let [scoped (z3/check-here)]
                        (z3/pop)
                        [before scoped (z3/check-here)]))))]
    (is (= ["sat" "unsat" "sat"] answers)
        "the contradiction exists only inside the push/pop scope")))

(deftest an-unsat-core-names-the-guilty-assertions
  (let [r (z3/with-solver
            (fn []
              ;; z3 refuses this option once any assertion exists ("option value
              ;; cannot be modified after assertions have been added") — verified
              ;; against the pinned binary, so it must come first.
              (z3/command "(set-option :produce-unsat-cores true)")
              (z3/command "(declare-const x Int)")
              (z3/command "(assert (! (> x 0) :named g_pos))")
              (z3/command "(assert (! (< x 0) :named g_neg))")
              (z3/check-core)))]
    (is (= "unsat" (:status r)))
    (is (< 1 (count (split (str (:core r)) "g_pos"))) "the core names one guilty assertion")
    (is (< 1 (count (split (str (:core r)) "g_neg"))) "and the other")))

(deftest assumptions-ask-what-if-without-asserting
  (let [r (z3/with-solver
            (fn []
              (z3/command "(declare-const a Bool)")
              (z3/command "(declare-const b Bool)")
              (z3/command "(assert (or a b))")
              {:both-off (z3/check-assuming ["(not a)" "(not b)"])
               :a-on (z3/check-assuming ["a"])}))]
    (is (= "unsat" (:status (:both-off r))) "neither can hold, given (or a b)")
    (is (= "sat" (:status (:a-on r))) "and either alone can")))

;; ── the guard ─────────────────────────────────────────────────────────────

(deftest conversation-verbs-are-refused-outside-a-conversation
  ; A verb that mutates solver state with no lease is a bug in the caller, and
  ; saying so beats corrupting whoever holds the solver.
  (let [who (BeamLisp.Z3.Solver/owner nil)
        outcome (try (do (z3/command "(push 1)") :no-error)
                     (catch e (str "refused: " e)))]
    (is (nil? who) (str "no lease is open here (owner=" (pr-str who) ", me=" (pr-str (erlang/self)) ")"))
    (is (not= :no-error outcome) (str "a conversation verb without a lease is refused, got " (pr-str outcome)))
    (is (< 1 (count (split (str outcome) "conversation")))
        (str "and the reason names the missing conversation: " (str outcome)))))
