; test/bl/system/ports_test.bl — the ports verb: reading the registry the session
; writes, and the one address it answers on.
;
; Run: bl test test/bl/system/ports_test.bl
(ns system.ports-test
  (:require [bl.ports :as ports] [bl.util :as u] [vm.ports :as vports] [vm.gateway :as vgw]))

(defn- capture [f]
  (let [prev (Process/group_leader)
        dev (erlang/element 2 (StringIO/open ""))]
    (Process/group_leader (erlang/self) dev)
    (let [r (try (f) (finally (Process/group_leader (erlang/self) prev)))]
      (list r (erlang/element 2 (StringIO/contents dev))))))

(defn- name-for [] (str "t_ports_" (erlang/unique_integer (list :positive))))

; The root claims are made FOR. A claim is read back through the session's own
; tree, so the tests claim where they run — /tmp would be a different session and
; the verbs would (rightly) answer about that one instead.
(defn- tree-root [] (second (File/cwd)))

; ── reading the registry ──────────────────────────────────────────────

(deftest a-claim-is-visible-to-this-process
  (let [n (name-for)
        r (vports/claim n 0 {:root (tree-root)})
        port (:ok r)]
    (try
      (is (contains? r :ok))
      (is (erlang/is_integer port))
      (is (= port (ports/port-of n)) "the number behind a name is one lookup")
      (is (some (fn [c] (= n (:name c))) (ports/list-ports)))
      (finally (vports/release n)))))

(deftest an-unclaimed-name-has-no-port
  (is (nil? (ports/port-of (name-for)))))

(deftest a-release-removes-it
  (let [n (name-for)]
    (vports/claim n 0 {:root (tree-root)})
    (vports/release n)
    (is (nil? (ports/port-of n)))))

; ── the verbs ─────────────────────────────────────────────────────────

(deftest the-listing-prints-what-is-held
  (let [n (name-for)]
    (vports/claim n 0 {:root (tree-root)})
    (try
      (let [[code out] (capture (fn [] (ports/run nil nil)))]
        (is (= 0 code))
        (is (includes? out n) "the name is listed")
        (is (includes? out (Path/basename (tree-root))) "with the owning tree"))
      (finally (vports/release n)))))

(deftest an-empty-registry-says-so-rather-than-printing-nothing
  ;; the registry may hold other trees' claims, so this asserts the SHAPE of the
  ;; answer: either a listing or the one-line notice, never silence.
  (let [[code out] (capture (fn [] (ports/run nil nil)))]
    (is (= 0 code))
    (is (or (includes? out "no session has claimed a port")
            (includes? out "  "))
        "a listing or a notice, never silence")))

(deftest ui-answers-with-the-session-url-or-says-why-not
  (let [saved (ports/url)
        [code out] (capture (fn [] (ports/run-ui (list) nil)))]
    (if (nil? saved)
      (do (is (= 1 code) "no live session: the verb reports it (on stderr)")
          (is (= "" out) "and prints no URL"))
      (do (is (= 0 code))
          (is (includes? out "http://127.0.0.1:") "the session's one address")))))

; ── the names a claim answers to ──────────────────────────────────────

(deftest a-claim-with-hosts-answers-at-a-name
  ;; `kw` takes ONE PAIR PER VECTOR — (kw [:a 1] [:b 2]) — and refuses a flat
  ;; four-element vector, so a dropped option can never pass unnoticed here.
  (let [n (name-for)
        r (vports/claim
                     n 0
                     {:root (tree-root) :hosts (u/to-list ["web.pulse.test" "web.pulse.localhost"])})
        port (:ok r)]
    (try
      (is (contains? r :ok))
      (is (starts-with? (ports/url-for n) "http://web.pulse.test")
          "the name is the address a human keeps")
      ;; The port rule, exactly, with the port-80 answer supplied: `url/2` asks
      ;; the MACHINE (a probe), and a test asserting what an address looks like
      ;; must not depend on what this machine happens to be running.
      (is (= "http://web.pulse.test/" (vgw/url "web.pulse.test" 80 false))
          "on 80 the name stands alone")
      (is (= "http://web.pulse.test:7777/"
             (vgw/url "web.pulse.test" 7777 false))
          "off it, the port is in the URL — an address that omits it answers refused")
      (is (= "http://web.pulse.test/" (vgw/url "web.pulse.test" 7777 true))
          "and with port 80 answered for us — a redirect, say — it drops out again")
      (is (= port (ports/port-of n)) "and the number is still behind it")
      (is (= n (:name (ports/claim-for n)))
          "claim-for finds the claim the name belongs to")
      (finally (vports/release n {:root (tree-root)})))))

(deftest the-listing-prints-the-name-beside-the-number
  (let [n (name-for)]
    (vports/claim n 0 {:root "/tmp/bl" :hosts (u/to-list ["named.test"])})
    (try
      (let [[code out] (capture (fn [] (ports/run nil nil)))]
        (is (= 0 code))
        (is (includes? out "named.test") "the name is in the listing")
        (is (includes? out "→") "with the port beside it, not instead of it"))
      (finally (vports/release n)))))

(deftest a-port-nobody-named-has-no-name
  ;; claiming a port without a project to name it is not an error — it is a
  ;; port with no host, and the loopback address is the honest answer
  (let [n (name-for)]
    (vports/claim n 0 {:root (tree-root)})
    (try
      (is (nil? (ports/url-for n)))
      (is (erlang/is_integer (ports/port-of n)))
      (finally (vports/release n)))))

(deftest a-port-already-held-is-refused-by-name-never-silently-moved
  (let [n (name-for)]
    (vports/claim n 0 {:root (tree-root)})
    (try
      (let [r (vports/claim n 0 {:root (tree-root) :pid 4194303})]
        (is (contains? r :error) "another pid cannot take the name"))
      (finally (vports/release n {:root (tree-root)})))))

; An ephemeral claim is the SESSION's address — nobody chose that number — so
; two checkouts asking for the same one must both be served. Keying them by name
; alone made the second tree's dashboard refuse to start because a sibling tree
; happened to be running one.
(deftest two-trees-may-each-hold-an-ephemeral-name
  (let [n (name-for)]
    (try
      (let [r-one (vports/claim n 0 {:root "/tmp/ports-one"})
            r-two (vports/claim n 0 {:root "/tmp/ports-two"})
            one (:ok r-one) two (:ok r-two)]
        (is (contains? r-one :ok))
        (is (contains? r-two :ok))
        (is (not= one two) "each session gets a port of its own"))
      (finally
        (vports/release n {:root "/tmp/ports-one"})
        (vports/release n {:root "/tmp/ports-two"})))))

; A CHOSEN number is a promise about a port, and the machine keeps it once.
(deftest a-chosen-port-is-machine-wide
  (let [n (name-for)
        other (name-for)]
    (try
      (let [port (:ok (vports/claim n 0 {:root (tree-root)}))
            ;; The promise is made by ANOTHER session — pid 1 is alive and is
            ;; not us — because re-claiming your own name is idempotent by
            ;; design, not a collision.
            r-pin (vports/claim other port {:root "/tmp/ports-pin" :pid 1})
            pinned (:ok r-pin)
            r (vports/claim other port {:root "/tmp/ports-thief"})]
        (is (contains? r-pin :ok))
        (is (= port pinned) "a chosen number is honoured exactly")
        (is (contains? r :error)
            "a second tree cannot promise the same number"))
      (finally
        (vports/release n {:root (tree-root)})
        (vports/release other {:root "/tmp/ports-pin"})
        (vports/release other {:root "/tmp/ports-thief"})))))

