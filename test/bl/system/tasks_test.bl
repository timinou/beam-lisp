; test/bl/system/tasks_test.bl — project tasks: dispatch, shadowing, arguments,
; the listing, and which of them keep their own process.
;
; Run: bl test test/bl/system/tasks_test.bl
(ns system.tasks-test
  (:require [bl.cli :as cli] [bl.env :as env]))

(defn- scratch [f]
  (let [root (str (System/tmp_dir!) "/bl_tasks_" (erlang/unique_integer (list :positive)))]
    (try
      (File/mkdir_p! root)
      (f root)
      (finally (File/rm_rf! root)))))

(defn- write! [root rel text]
  (let [p (str root "/" rel)]
    (File/mkdir_p! (Path/dirname p))
    (File/write! p text)
    p))

(defn- capture [f]
  (let [prev (Process/group_leader)
        dev (erlang/element 2 (StringIO/open ""))]
    (Process/group_leader (erlang/self) dev)
    (let [r (try (f) (finally (Process/group_leader (erlang/self) prev)))]
      (list r (erlang/element 2 (StringIO/contents dev))))))

(defn- run-in
  "Run a `bl` command in `dir`, cold, with the cwd bound the way a daemon binds
   its client's. Returns [exit-code output]."
  [dir argv]
  (BeamLisp/with_cwd dir
    (fn [] (capture (fn [] (cli/run-argv (to-list argv)))))))

(defn- project-with-tasks
  "A tree whose env.bl declares `tasks-text`, plus a program that prints its
   argv. Returns the root."
  [root tasks-text]
  (write! root "env.bl" (str "{:paths [\"src\"] :tasks " tasks-text "}"))
  (write! root "src/prog.bl"
    "(println (str \"ran with \" (pr-str (BeamLisp/argv))))\n")
  root)

; ── dispatch ──────────────────────────────────────────────────────────

(deftest a-declared-task-runs
  (scratch
    (fn [root]
      (project-with-tasks root "{:hi \"src/prog.bl\"}")
      (let [[code out] (run-in root ["hi"])]
        (is (= 0 code))
        (is (includes? out "ran with"))))))

(deftest a-tasks-arguments-become-the-program-argv
  (scratch
    (fn [root]
      (project-with-tasks root "{:hi \"src/prog.bl\"}")
      (let [[code out] (run-in root ["hi" "one" "two"])
            [_ out2] (run-in root ["hi" "--" "three"])]
        (is (= 0 code))
        (is (includes? out "(\"one\" \"two\")")
            "the command's own arguments reach the program")
        (is (includes? out2 "(\"three\")")
            "and so do post-`--` ones")))))

(deftest an-unknown-command-is-still-a-usage-error
  (scratch
    (fn [root]
      (project-with-tasks root "{:hi \"src/prog.bl\"}")
      (let [[code out] (run-in root ["nope"])]
        (is (= 2 code))
        (is (includes? out "usage: bl")
            "no task named `nope`: the builtin grammar reports it, and the usage follows")))))

(deftest a-task-for-a-missing-file-fails-loudly
  (scratch
    (fn [root]
      (project-with-tasks root "{:gone \"src/not-here.bl\"}")
      (let [[code out] (run-in root ["gone"])]
        (is (= 1 code) "a task whose file is gone fails; it does not silently succeed")
        (is (not (includes? out "ran with")))))))

; ── shadowing ─────────────────────────────────────────────────────────

(deftest a-task-that-shadows-a-builtin-is-dropped-and-reported
  (scratch
    (fn [root]
      (project-with-tasks root "{:test \"src/prog.bl\" :hi \"src/prog.bl\"}")
      ;; Running any command binds the tree's project for dispatch; the bound
      ;; value is what the dispatcher decides on, so this is the honest place to
      ;; read the judgment from.
      (run-in root ["tasks"])
      (let [p (cli/project-value)]
        (is (nil? (get-in p [:tasks "test"])) "the shadowing task is dropped")
        (is (some (fn [e] (includes? e "shadows a bl command")) (:errors p))
            "and the drop is reported as data, naming the collision"))
      (let [[code out] (run-in root ["test" "test/bl/system/tasks_test.bl"])]
        ;; `bl test` still means the builtin.
        (is (= 2 code) "the builtin ran — and found no .bl test files under that path")
        (is (not (includes? out "ran with")) "the shadowing task never ran")))))

(deftest the-listing-shows-what-can-run
  (scratch
    (fn [root]
      (project-with-tasks root
        "{:hi \"src/prog.bl\" :dev {:run \"src/prog.bl\" :doc \"the loop\"}}")
      (let [[code out] (run-in root ["tasks"])]
        (is (= 0 code))
        (is (includes? out "hi"))
        (is (includes? out "dev"))
        (is (includes? out "the loop"))))))

(deftest a-tree-with-no-tasks-says-so
  (scratch
    (fn [root]
      (write! root "env.bl" "{:name \"quiet\"}")
      (let [[code out] (run-in root ["tasks"])]
        (is (= 0 code))
        (is (includes? out "declares none"))))))

; ── which commands keep their own process ─────────────────────────────

(deftest owning-commands-are-named
  (scratch
    (fn [root]
      (project-with-tasks root
        "{:hi \"src/prog.bl\" :dev {:run \"src/prog.bl\" :watch true}}")
      (is (cli/owns-process? (list "repl") root))
      (is (cli/owns-process? (list "serve" "x.bl") root))
      (is (cli/owns-process? (list "mcp") root))
      (is (cli/owns-process? (list "lsp" "serve") root))
      (is (cli/owns-process? (list "dev") root)
          "a task declared :watch owns its process — the daemon refuses it")
      (is (not (cli/owns-process? (list "hi") root))
          "a plain task does not")
      (is (not (cli/owns-process? (list "run" "x.bl") root)))
      (is (not (cli/owns-process? (list "watch" "src") root))
          "`bl watch` is HOSTED by the daemon, not refused"))))
