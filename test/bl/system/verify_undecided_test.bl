; test/bl/system/verify_undecided_test.bl — a verdict must not outrun its evidence.
;
; `system/core` collapses a three-valued solver answer into two: `preserves-joint?`
; returns `{:preserved (= "unsat" (z3/check …))}`, so `unknown` lands on the
; NOT-PROVEN side, `verify-process` reports `:holds false`, and `mcp.tools` renders
; that as `verdict "violated"`.
;
; That was theoretical until the deadline chain landed (FUP-057): a hard obligation
; now returns `"unknown"` instead of killing its caller, so "the solver gave up" and
; "your invariant is broken" became the same answer. Measured before the fix, with
; the ceiling at 1 ms and a machine whose invariant z3 proves in milliseconds:
;
;   mcp ->  verdict "violated", "invariant not preserved by withdraw"
;
; The fix is at the boundary, not at each of the engine's twenty z3 call sites: the
; ledger already records every decision, so it now records the STATUS too, and
; `mcp.tools` asks it before letting a verdict out.
;
; WHY TWO MACHINES. The undecided path has to be reached DETERMINISTICALLY, and a
; small ceiling does not do it: z3 decides a one-variable linear query in
; microseconds, so a 1 ms budget is a race — the same machine answered `holds` on one
; run and `unknown` on the next (measured). So `hard` carries a guard whose
; satisfiability z3 cannot settle at all: the semiprime instance takes more than 30 s
; on the bare binary, and any ceiling the pool arms fires long before that. The
; ceiling that matters here is the pool's own 10 s, not a test knob.

(ns verify.undecided.test
  (:require [mcp.tools :as tools]
            [z3pool]))

; the invariant HOLDS and z3 proves it in milliseconds
(def easy
  "(defserver ^{:invariant (>= balance 0)} account
     (init [balance] (ok balance))
     (handle-call [:withdraw amt] [_ balance] :when (and (>= amt 0) (>= balance amt))
       (reply :ok (- balance amt))))")

; 43925755729223607997806993733463 is a product of two 16-digit primes. The handler
; ":work" drives the state to [1 1], which VIOLATES the invariant — so `¬inv'` is
; trivially true and drops out, leaving the obligation `p>1 ∧ q>1 ∧ p·q = N`: the
; factoring instance itself, which z3 cannot settle (more than 30 s on the bare
; binary, measured). The product has to be LOAD-BEARING this way: with a handler
; that preserves the invariant instead, z3 prunes the nonlinear conjunct as
; irrelevant and answers in microseconds (measured first — the test said `holds`).
(def hard
  "(defserver ^{:invariant (and (> p 1) (> q 1))} factor
     (init [p q] (ok [p q]))
     (handle-call [:work] [_ p q] :when (= (* p q) 43925755729223607997806993733463)
       (reply :ok [1 1])))")

(defn- verdict-of [src]
  (tools/code-verify-handler {"source" src}))

(deftest a-held-invariant-is-proved
  (let [r (verdict-of easy)]
    (is (= "holds" (:verdict r)) "the invariant is proved")
    (is (= :z3 (:tier r)) "and the oracle is what proved it")
    (is (empty? (:undecided r)) "with nothing left undecided")))

(deftest a-solver-that-gives-up-is-not-a-violation
  ;; The regression. Before the fix this was the bug: the same machine, the same
  ;; invariant, `violated` — a claim the evidence did not support.
  (let [r (verdict-of hard)]
    (is (= "undecided" (:verdict r))
        "the solver gave up, and that is not a verdict about the invariant")
    (is (not= "violated" (:verdict r)) "in particular it is not a violation")
    (is (pos? (:undecided r)) "and the reply counts the decisions it could not make")
    (is (= :z3 (:tier r)) "the tier is still the oracle's — it answered, `unknown`")))
