; test/bl/system/lsp_server_test.bl — the stdio loop's framing contract.
;
; lsp.server reads Content-Length-framed JSON from stdin and writes it back on
; stdout, one frame at a time. The framing it shares with lsp.rpc is the part
; worth pinning: a frame must survive a byte-for-byte round trip including
; multi-byte bodies, and a malformed header must be reported rather than crash
; the loop. Run: mix bl test test/bl/system/lsp_server_test.bl
(ns system.lsp-server-test
  (:require [lsp.rpc :as rpc]
            [lsp.server :as server]))

(deftest encode-then-decode-is-identity
  (let [msg {"jsonrpc" "2.0" "id" 1 "method" "initialize" "params" {}}]
    (is (= msg (:msg (rpc/decode-frame (rpc/encode-frame msg)))))))

(deftest content-length-counts-bytes-not-characters
  (let [msg {"jsonrpc" "2.0" "id" 1 "params" {"s" "héllo 🎉"}}
        frame (rpc/encode-frame msg)
        head (subs frame 0 (index-of frame "\r\n\r\n"))
        n (String/to_integer (String/trim (subs head (+ 1 (index-of head ":")))))]
    (is (= n (erlang/byte_size (Jason/encode! msg)))
        "the announced length is the encoded byte count, not the grapheme count")
    (is (= msg (:msg (rpc/decode-frame frame))) "and the multi-byte body round-trips")))

(deftest read-frame-is-the-loop-s-reader
  (is (some? server/read-frame) "the loop exposes its frame reader"))
