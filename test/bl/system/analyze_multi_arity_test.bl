; test/bl/system/analyze_multi_arity_test.bl — the inter-procedural pass must
; read EVERY clause of a multi-arity/multi-clause defn. The review's
; counterexample — `(defn overloaded ([x] x) ([x y] (File/read! x)))` — used to
; report an empty call set, an empty footprint and `terminates true`, because
; only the first clause was parsed (performance-review.md, finding 8).

(ns system.analyze-multi-arity-test
  (:require [system.analyze :as an]))

(deftest later-arity-io-is-not-omitted
  (testing "the second clause's File/read! contributes the host call and effect"
    (let [s (an/analyze "(defn overloaded ([x] x) ([x y] (File/read! x)))")
          o (get s "overloaded")]
      (is (contains? (:calls o) [:Elixir.File :read!])
          "the later arity's I/O call is in the call set")
      (is (not (empty? (:footprint o)))
          "the later arity's effect is in the footprint")
      (is (= true (:terminates o))))))

(deftest first-clause-effects-are-kept-too
  (testing "union, not replacement: the first clause's resource survives"
    (let [s (an/analyze "(defn f ([x] (swap! acc inc))
                                ([x y] (File/write! x y)))")
          o (get s "f")]
      (is (contains? (:footprint o) "acc") "the first clause's resource is kept")
      (is (not (empty? (:footprint o))) "the later I/O clause is not dropped"))))

(deftest later-arity-call-edge-is-recorded
  (testing "a call only in a later arity still becomes an edge"
    (let [s (an/analyze "(defn helper [] (swap! acc inc))
                         (defn busy ([x] x) ([x y] (helper)))")]
      (is (contains? (:edges (get s "busy")) "helper")
          "busy -> helper comes from the SECOND clause"))))

(deftest returns-union-across-clauses
  (testing "a fn's return tagset is the union over its arities, never narrowed
            to one clause"
    (let [s (an/analyze "(defn mixed ([x] 1) ([x y] \"s\"))")
          r (:returns (get s "mixed"))]
      (is (contains? r :int))
      (is (contains? r :string)))))

(deftest recursive-overloaded-still-summarized
  (testing "a recursive overloaded fn summarizes over all clauses"
    (let [s (an/analyze "(defn walk ([x] (walk x 0))
                                ([x n] (if (> n x) n (walk x (erlang/+ n 1)))))")
          o (get s "walk")]
      (is (= true (:terminates o)))
      (is (contains? (:edges o) "walk") "the self-call is an edge"))))

(deftest docstring-does-not-shift-clause-parsing
  (testing "a docstring before the clauses does not hide the later arity"
    (let [s (an/analyze "(defn documented \"doc\" ([x] x) ([x y] (File/read! x)))")]
      (is (contains? (:calls (get s "documented")) [:Elixir.File :read!])))))


(deftest source-clause-guards-are-not-dropped
  ; `(> x 0)` is a REAL guard (the compiler refuses a host call like
  ; `erlang/>` there), and its comparison still reaches the call set.
  (let [s (get (an/analyze "(defn guarded [x] :when (> x 0) x)") "guarded")]
    (is (contains? (:calls s) [:erlang :>]))))


(run-tests)
