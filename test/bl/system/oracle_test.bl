; test/bl/system/oracle_test.bl — the four things the cutover added, each pinned by
; an observation rather than an argument.
;
;   1. the MEMO     an identical script is answered from memory, and only a real
;                   answer is cached — `unknown` (the ceiling) and `error` (a
;                   transport failure) must not stick to a script
;   2. the COST     every decision lands in the ledger with its microseconds, so a
;                   deadline can be chosen from a distribution (FUP-057 chose one
;                   from an argument, because nothing was timed)
;   3. the EFFECT   the oracle is a handler: a verifier runs against a TABLE with
;                   no z3 at all, and `deny` refuses in a sandbox
;   4. the FAN-OUT  N questions run on N solvers — the pool's width, used

(ns system.oracle-test
  (:require [oracle]
            [z3]
            [system.core :as sys]
            [system.decide :as decide]
            [z3pool]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))

(def machine
  "(defserver ^{:invariant (>= balance 0)} account
     (init [balance] (ok balance))
     (handle-call [:withdraw amt] [_ balance] :when (and (>= amt 0) (>= balance amt))
       (reply :ok (- balance amt))))")

(def obl (oracle/obligation :probe ['(declare-const x Int) '(assert (> x 1))]))

(deftest a-repeated-question-costs-no-solver
  (z3/pool! 4)
  (oracle/memo-clear!)
  (let [a (oracle/ask obl)
        calls-after-first (count (filter (fn [d] (= :z3 (:tier d))) (decide/here)))
        _ (decide/clear-here!)
        b (oracle/ask obl)
        calls-after-second (count (filter (fn [d] (= :z3 (:tier d))) (decide/here)))]
    (is (= (:status a) (:status b)) "the second answer is the first answer")
    (is (= :memo (:tier b)) "and it came from memory")
    (is (< 0 calls-after-first) "the first ask reached the solver")
    (is (zero? calls-after-second) "the second did not")))

(deftest the-memo-is-switchable
  (oracle/memo-clear!)
  (let [asks (atom 0)
        counted (fn [text model?] (swap! asks inc) (oracle/pool-handler text model?))]
    (oracle/with-memo false
      (fn []
        (oracle/with-oracle counted (fn [] (oracle/ask obl) (oracle/ask obl)))))
    (is (= 2 @asks) "with the memo off, both asks reach the handler")))

(deftest only-a-real-answer-is-cached
  (oracle/memo-clear!)
  ;; The ceiling is read from the environment PER LEASE (FUP-057), so 1 ms is the
  ;; whole mechanism: the answer is `unknown`, which is NOT a fact about the
  ;; script and must not be remembered as one.
  (System/put_env "BL_Z3_TIMEOUT" "1")
  (let [v (oracle/ask (oracle/obligation :hard
                        ['(declare-const p Int) '(declare-const q Int)
                         '(assert (> p 1)) '(assert (> q 1))
                         '(assert (= (* p q) 43925755729223607997806993733463))]))]
    (is (= :unknown (:status v)) "the ceiling fires before the factoring does")
    (is (zero? (oracle/memo-size)) "and nothing was cached for it"))
  (System/delete_env "BL_Z3_TIMEOUT"))

(deftest every-decision-carries-its-cost
  (oracle/memo-clear!)
  (decide/clear-here!)
  (oracle/ask obl)
  (let [c (decide/cost)]
    (is (< 0 (:count c)) "the decision is counted")
    (is (< 0 (:total_us c)) "and it has a measured cost")
    (is (<= (:max_us c) (:total_us c)) "the slowest is not slower than the total")))

(deftest a-verifier-runs-with-no-z3-at-all
  (let [answers (atom 0)
        table (fn [_text _model?] (swap! answers inc)
                                  {:status "unsat" :model nil :core nil})
        r (oracle/with-oracle table (fn [] (sys/verify-process (z3/open) (read1 machine))))]
    (is (:holds r) "the machine verifies against a TABLE, not the solver")
    (is (< 0 @answers) "and the table was the handler")))

(deftest the-sandbox-can-refuse-the-oracle
  (oracle/memo-clear!)   ; nothing cached, or the handler is never reached at all
  (is (thrown? (oracle/with-oracle oracle/deny (fn [] (oracle/ask obl))))
      "deny raises instead of quietly reaching for a solver"))

(deftest questions-fan-out-across-the-pool
  (z3/pool! 4)
  (oracle/memo-clear!)
  (let [obls (vec (map (fn [i] (oracle/obligation (keyword (str "q" i))
                                     ['(declare-const x Int)
                                      (list 'assert (list '< 'x i))
                                      (list 'assert (list '>= 'x i))]))
                       (range 8)))
        vs (oracle/ask-all obls)]
    (is (= 8 (count vs)) "every question has an answer")
    (is (every? (fn [v] (oracle/proven? v)) vs) "and every answer is a proof")
    (is (<= 2 (z3pool/high-water)) "the pool ran more than one conversation at once")))
