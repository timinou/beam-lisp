; test/bl/system/facts_test.bl — clause topology as datom facts (P19 R4).
;
; model.bl's clauses, projected into facts, so the STRUCTURAL invariants — which
; labels are handled, which are total vs guarded-only, the guard preconditions —
; are datalog queries, not hand-walks. Structure is datom's job; z3 stays out.

(ns system.facts-test
  (:require [system.facts :as facts] [datom]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- mk-conn [schema] (datom/connect schema))
(defn- transact [conn fs] (datom/transact! conn fs))
(defn- q-fn [db query & args] (apply datom/q query db args))

(def conn-src
  "(defserver conn
     (init [] (ok {:phase :idle}))
     (handle-call [:open] [_ {:keys [phase]}] :when (= phase :idle) (reply :ok {:phase :open}))
     (handle-call [:send] [_ {:keys [phase]}] :when (= phase :open) (reply :ok {:phase :open}))
     (handle-cast [:close] [_ {:keys [phase]}] (noreply {:phase :closed})))")

(defn- report [src]
  (let [conn (facts/facts-db (read1 src) mk-conn transact)]
    (facts/dispatch-report (datom/db conn) q-fn)))

(deftest facts-handled-labels-are-every-message-clause
  (is (= #{:open :send :close} (:handled (report conn-src)))
      "all three message labels handled; :init is excluded (establishment)"))

(deftest facts-always-fireable-are-the-unguarded-clauses
  (is (= #{:close} (:always-fireable (report conn-src)))
      ":close has no :when → total handler; :open/:send are guarded"))

(deftest facts-guarded-only-are-partial-handlers
  (is (= #{:open :send} (:guarded-only (report conn-src)))
      ":open and :send fire only when their :when matches — a sender can be ignored"))

(deftest facts-preconditions-are-extracted-from-when-clauses
  (let [pre (:preconditions (report conn-src))]
    (is (= ["(= phase :idle)"] (get pre :open)) ":open's implicit precondition, read not annotated")
    (is (= ["(= phase :open)"] (get pre :send)) ":send's precondition")
    (is (nil? (get pre :close)) ":close is unguarded → no precondition")))

; a label with BOTH a guarded and an unguarded clause is total (the unguarded
; one always fires) — the anti-join must see the unguarded clause.
(deftest facts-mixed-guard-clause-is-total
  (let [src "(defserver m
               (init [] (ok {:n 0}))
               (handle-call [:tick] [_ {:keys [n]}] :when (> n 0) (reply :ok {:n (- n 1)}))
               (handle-call [:tick] [_ {:keys [n]}] (reply :ok {:n 0})))"
        rep (report src)]
    (is (contains? (:always-fireable rep) :tick)
        ":tick has an unguarded clause → total despite the guarded one")
    (is (not (contains? (:guarded-only rep) :tick)) "so it is not guarded-only")))
