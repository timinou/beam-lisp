; test/bl/system/cli_util_test.bl — the bridges every bl verb shares.
;
; bl.util is where a command's value meets the two outside shapes: Jason
; (which cannot encode a beam-lisp vector or set) and an Elixir API reading a
; keyword list. These tests pin the lowering rules and the path expansion the
; commands rely on.
;
; Run: bl test test/bl/system/cli_util_test.bl
(ns system.cli-util-test
  (:require [bl.util :as u]))

; ── plain: beam-lisp shapes → what Jason encodes ──────────────────────

(deftest plain-turns-a-keyword-into-its-name
  (is (= "foo" (u/plain :foo)) "a keyword is its name, a JSON string")
  (is (= "name" (u/plain :ns/name)) "`name` drops the namespace, Clojure's rule"))

(deftest plain-lowers-collections-to-erlang-lists
  (is (= (list 1 2 3) (u/plain [1 2 3])) "a vector becomes a list")
  (is (= (list "a" "b") (u/plain (list :a :b))) "a list is rebuilt, elements lowered")
  (let [s (u/plain (set [:x :y]))]
    (is (= 2 (count s)) "a set becomes a list of its members")
    (is (some (fn [x] (= x "x")) s))
    (is (some (fn [x] (= x "y")) s))))

(deftest plain-lowers-a-nested-map-and-keys
  (let [p (u/plain {:k [1 :two] :m {:n (set [:x])}})]
    (is (= (list 1 "two") (get p "k")) "a keyword key becomes a string")
    (is (= (list "x") (get-in p ["m" "n"])) "the lowering is recursive")
    (is (nil? (get p :k)) "no keyword key survives")))

(deftest plain-is-json-encodable
  (is (= "{\"k\":[1,\"two\"]}"
         (Jason/encode! (u/plain {:k [1 :two]})))
      "the lowered value encodes as one JSON object"))

; ── expand-targets: PATH arguments → the sources to act on ────────────

(defn- tmp-root []
  (str (System/tmp_dir!) "/bl_cli_util_" (erlang/unique_integer (list :positive))))

(deftest source-file?-knows-the-loader-extensions
  (is (u/source-file? "a.bl"))
  (is (u/source-file? "a.bl.md"))
  (is (u/source-file? "a.bl.org"))
  (is (not (u/source-file? "a.txt"))))

(deftest expand-targets-walks-a-directory-in-sorted-order
  (let [root (tmp-root)]
    (try
      (File/mkdir_p! (str root "/sub"))
      (File/write! (str root "/a.bl") "(ns a)\n")
      (File/write! (str root "/b.bl.md") "# b\n")
      (File/write! (str root "/.hidden.bl") "(ns h)\n")
      (File/write! (str root "/notes.txt") "prose\n")
      (File/write! (str root "/sub/c.bl") "(ns c)\n")
      (is (= ["a.bl" "b.bl.md" "sub/c.bl"]
             (into [] (map (fn [p] (String/replace p (str root "/") ""))
                           (u/expand-targets root))))
          "sources only, hidden entries skipped, subdirectories walked")
      (is (= [(str root "/a.bl")] (into [] (u/expand-targets (str root "/a.bl"))))
          "a source file expands to itself")
      (is (= [] (into [] (u/expand-targets (str root "/notes.txt"))))
          "a non-source expands to nothing")
      (is (= [] (into [] (u/expand-targets (str root "/missing.bl")))))
      (finally (File/rm_rf! root)))))

; ── join-args: a shell-split expression back into one form ────────────

(deftest join-args-rebuilds-a-split-expression
  (is (= "(+ 1 2)" (u/join-args (list "(+ 1" "2)"))))
  (is (= "one" (u/join-args (list "one"))))
  (is (nil? (u/join-args (list)))))
