; test/bl/system/cli_util_test.bl — the bridges every bl verb shares.
;
; bl.util is where a command's value meets the two outside shapes: JSON (via
; `bl.json`, which encodes beam-lisp data as it stands) and an Elixir API
; reading a keyword list. These tests pin the encoding seam and the path
; expansion the commands rely on.
;
; Run: bl test test/bl/system/cli_util_test.bl
(ns system.cli-util-test
  (:require [bl.util :as u]))

; ── `--json`: beam-lisp shapes encode as they are ────────────────────
;
; `bl.util` used to carry a `plain` lowering for exactly one reason: Jason
; refused a `BeamLisp.Vector` and a `BeamLisp.Set` deep in its encoder, so
; every `--json` value crossed a converter first. `bl.json` takes the value as
; it stands, so the converter is gone and these tests pin the contract at the
; seam that replaced it.

(deftest a-keyword-is-its-name-on-the-wire
  (is (= "\"foo\"" (bl.json/encode :foo)) "a keyword is its name, a JSON string")
  (is (= "\"ns/name\"" (bl.json/encode :ns/name))
      "a namespace KEEPS its namespace. `plain` dropped it (Clojure's `name`
       rule), which made `:a/x` and `:b/x` collapse into one JSON key; the
       encoder is lossless here, so two such keys stay two keys"))

(deftest collections-encode-as-arrays
  (is (= "[1,2,3]" (bl.json/encode [1 2 3])) "a vector")
  (is (= "[\"a\",\"b\"]" (bl.json/encode (list :a :b))) "a list, elements mapped")
  (is (= "[1,2]" (bl.json/encode #{1 2})) "a set, in a stable order"))

(deftest a-nested-map-encodes-without-a-lowering-step
  (is (= "{\"k\":[1,\"two\"],\"m\":{\"n\":[\"x\"]}}"
         (bl.json/encode {:k [1 :two] :m {:n (set [:x])}}))
      "the whole shape — keyword keys, vectors, a set — encodes in one pass"))

; ── expand-targets: PATH arguments → the sources to act on ────────────

(defn- tmp-root []
  (str (System/tmp_dir!) "/bl_cli_util_" (erlang/unique_integer (list :positive))))

(deftest source-file?-knows-the-loader-extensions
  (is (u/source-file? "a.bl"))
  (is (u/source-file? "a.bl.md"))
  (is (u/source-file? "a.bl.org"))
  (is (not (u/source-file? "a.txt"))))

(deftest expand-targets-walks-a-directory-in-sorted-order
  (let [root (tmp-root)]
    (try
      (File/mkdir_p! (str root "/sub"))
      (File/write! (str root "/a.bl") "(ns a)\n")
      (File/write! (str root "/b.bl.md") "# b\n")
      (File/write! (str root "/.hidden.bl") "(ns h)\n")
      (File/write! (str root "/notes.txt") "prose\n")
      (File/write! (str root "/sub/c.bl") "(ns c)\n")
      (is (= ["a.bl" "b.bl.md" "sub/c.bl"]
             (into [] (map (fn [p] (String/replace p (str root "/") ""))
                           (u/expand-targets root))))
          "sources only, hidden entries skipped, subdirectories walked")
      (is (= [(str root "/a.bl")] (into [] (u/expand-targets (str root "/a.bl"))))
          "a source file expands to itself")
      (is (= [] (into [] (u/expand-targets (str root "/notes.txt"))))
          "a non-source expands to nothing")
      (is (= [] (into [] (u/expand-targets (str root "/missing.bl")))))
      (finally (File/rm_rf! root)))))

; ── join-args: a shell-split expression back into one form ────────────

(deftest join-args-rebuilds-a-split-expression
  (is (= "(+ 1 2)" (u/join-args (list "(+ 1" "2)"))))
  (is (= "one" (u/join-args (list "one"))))
  (is (nil? (u/join-args (list)))))
