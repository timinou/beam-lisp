; test/bl/system/theories_test.bl — content invariants + liveness (P22).
;
; Two widenings past Int safety: verify-content proves a collection's ELEMENTS
; (no duplicates) over the z3 Array theory; verify-liveness proves ◇ (a goal is
; eventually unavoidable) as a least fixpoint — the dual of the safe-region gfp.

(ns system.theories-test
  (:require [system.core :as sys] [system.gfp :as gfp] [z3]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(def port (z3/open))

; ── content: no-duplicate over a z3 Array ─────────────────────────────────

(def uniqueset
  "(defserver ^{:invariant true} uniqset
     (init [] (ok {:items []}))
     (handle-call [:add x] [_ {:keys [items]}] :when (not (includes? items x))
       (reply :ok {:items (conj items x)})))")

(def dupset
  "(defserver ^{:invariant true} dupset
     (init [] (ok {:items []}))
     (handle-call [:add x] [_ {:keys [items]}]
       (reply :ok {:items (conj items x)})))")

(deftest content-freshness-guarded-stays-distinct
  (let [r (sys/verify-content port (read1 uniqueset))]
    (is (:checked r) "a single collection field is checked over the Array theory")
    (is (:holds r) "the freshness-guarded add keeps the set duplicate-free")
    (is (= :approximate (:extension r)) "quantified array reasoning is an approximate guarantee")
    (is (empty? (:warnings r)) "no warnings")))

(deftest content-unguarded-add-is-caught
  (let [r (sys/verify-content port (read1 dupset))]
    (is (not (:holds r)) "an unguarded add can insert a duplicate")
    (is (includes? (:msg (first (:warnings r))) "add") "the offending transition is named")))

; ── liveness: AF over the phase graph ─────────────────────────────────────

(def completing-job
  "(defserver job
     (init [] (ok {:phase :pending}))
     (handle-call [:start]  [_ {:keys [phase]}] :when (= phase :pending)
       (reply :ok {:phase :running}))
     (handle-call [:finish] [_ {:keys [phase]}] :when (= phase :running)
       (reply :ok {:phase :done})))")

(def starving-job
  "(defserver stuck
     (init [] (ok {:phase :pending}))
     (handle-call [:start] [_ {:keys [phase]}] :when (= phase :pending)
       (reply :ok {:phase :running}))
     (handle-call [:retry] [_ {:keys [phase]}] :when (= phase :running)
       (reply :ok {:phase :running})))")

(deftest liveness-holds-when-goal-is-unavoidable
  (let [r (sys/verify-liveness (read1 completing-job) "phase" #{"done"})]
    (is (:checked r) "the phase field is an enum → liveness is checkable")
    (is (:holds r) "every path from pending eventually reaches done")
    (is (= "pending" (:from r)) "checked from the init phase")))

(deftest liveness-fails-on-a-starvation-loop
  (let [r (sys/verify-liveness (read1 starving-job) "phase" #{"done"})]
    (is (not (:holds r)) "a running→running loop can avoid done forever")))

; ── the fixpoint duality directly ─────────────────────────────────────────

(deftest af-and-safe-region-are-duals
  (let [succ {0 [1] 1 [2] 2 [0] 3 [3]}
        succ-fn (fn [s] (get succ s []))
        ; AF (least fp): states that always reach the goal {2}
        live (gfp/af [0 1 2 3] succ-fn (fn [s] (= s 2)))
        ; AG (greatest fp): states that never reach bad {3}
        safe (gfp/safe-region [0 1 2 3] succ-fn (fn [s] (= s 3)))]
    (is (= #{0 1 2} live) "AF goal grows from the goal — the 0-cycle reaches 2; 3 starves")
    (is (= #{0 1 2} safe) "AG¬bad shrinks from all — the 0-cycle avoids 3; 3 is bad")
    (is (not (contains? live 3)) "the trap satisfies neither: it never reaches the goal")))
