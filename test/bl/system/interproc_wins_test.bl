; test/bl/system/interproc_wins_test.bl — the two Phase-4 wins:
; (a) partial-verification signal (soundness), (b) inter-procedural type errors.
(ns system.interproc-wins-test
  (:require [system.core :as sys]
            [system.typecheck :as tc]
            [z3]))

(deftest partial-verification-signal
  (testing "an unmodellable transition is surfaced, not silently dropped"
    (let [port (z3/open)
          buggy "(defserver ^{:invariant (>= balance 0)} acct
                   (init [] (ok {:balance 100}))
                   (handle-call [:withdraw amt] [_ {:keys [balance]}]
                     (reply :ok {:balance (unchecked-sub balance amt)})))"
          r (sys/verify-process port (first (BeamLisp.Reader/read_string buggy)))]
      (is (= false (:complete r)) "a helper-computed next-state is not modelled")
      (is (contains? (set (:unmodelled r)) :withdraw) ":withdraw is named as unverified"))))

(deftest full-verification-stays-complete
  (testing "a fully-arithmetic server reports complete"
    (let [port (z3/open)
          good "(defserver ^{:invariant (>= balance 0)} acct2
                  (init [] (ok {:balance 100}))
                  (handle-call [:withdraw amt] [_ {:keys [balance]}] :when (<= amt balance)
                    (reply :ok {:balance (- balance amt)})))"
          r (sys/verify-process port (first (BeamLisp.Reader/read_string good)))]
      (is (= true (:complete r)))
      (is (= [] (:unmodelled r))))))

(deftest interprocedural-type-error
  (testing "a type error visible only across a call is caught"
    (let [ws (tc/check-source "(defn mk [] :a-keyword)
                               (defn use-it [] (erlang/+ 1 (mk)))")]
      (is (= 1 (count ws)) "one warning: + on mk's keyword return")
      (is (some? (:line (first ws))) "warning carries a source position"))))

(deftest interprocedural-clean-no-false-positive
  (testing "a well-typed cross-call program warns nothing"
    (is (= 0 (count (tc/check-source "(defn mk [] 42)
                                      (defn use-it [] (erlang/+ 1 (mk)))"))))))
