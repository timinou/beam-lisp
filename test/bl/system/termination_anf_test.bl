; test/bl/system/termination_anf_test.bl — termination over bl-ANF.
; The ∃-ranking rule, recognised on the compiler's loop desugaring, over the
; same acceptance corpus the surface engine proved (research lowerers spike).
(ns system.termination-anf-test
  (:require [termination :as t]))

(defn- verdict [s] (:status (first (t/check-source (str "(ns tt)\n" s)))))

(deftest accepts-well-founded-loops
  (testing "count-down, seq-shrink, count-up+bound, accumulators"
    (is (= :accepted (verdict "(loop [i 10] (if (> i 0) (recur (dec i)) i))"))
        "count-down")
    (is (= :accepted (verdict "(loop [i 0] (if (< i 100) (recur (inc i)) i))"))
        "count-up with upper bound")
    (is (= :accepted (verdict "(loop [i 0 acc 0] (if (< i 100) (recur (inc i) (+ acc i)) acc))"))
        "count-up + accumulator — acc need not shrink")
    (is (= :accepted (verdict "(loop [i 10 acc 0] (if (> i 0) (recur (dec i) (+ acc i)) acc))"))
        "count-down + accumulator")))

(deftest rejects-unfounded-loops
  (testing "count-up without a bound, and a spin"
    (is (= :rejected (verdict "(loop [i 0] (if (keep? i) (recur (inc i)) i))"))
        "count-up, no upper-bound guard")
    (is (= :rejected (verdict "(loop [i 0] (recur i))"))
        "pure spin — no measure")))

(deftest trusted-escape-hatch
  (testing "^{:decreasing} measure is trusted"
    (is (= :trusted
           (verdict "(loop ^{:decreasing (custom i)} [i x] (if (done? i) i (recur (weird i))))")))))

(deftest measure-dir-over-anf
  (testing "measure-dir reads resolved ANF arithmetic"
    ;; build the ANF for (dec i)/(inc i) directly through check via a loop
    (is (= :accepted (verdict "(loop [i n] (if (> i 0) (recur (- i 2)) i))"))
        "(- i 2) count-down by positive literal")))
