; test/bl/system/termination_anf_test.bl — termination over bl-ANF.
; The ∃-ranking rule, recognised on the compiler's loop desugaring, over the
; same acceptance corpus the surface engine proved (research lowerers spike).
(ns system.termination-anf-test
  (:require [termination :as t]))

(defn- verdict [s] (:status (first (t/check-source (str "(ns tt)\n" s)))))

(deftest accepts-well-founded-loops
  (testing "count-down, seq-shrink, count-up+bound, accumulators"
    (is (= :accepted (verdict "(loop [i 10] (if (> i 0) (recur (dec i)) i))"))
        "count-down")
    (is (= :accepted (verdict "(loop [i 0] (if (< i 100) (recur (inc i)) i))"))
        "count-up with upper bound")
    (is (= :accepted (verdict "(loop [i 0 acc 0] (if (< i 100) (recur (inc i) (+ acc i)) acc))"))
        "count-up + accumulator — acc need not shrink")
    (is (= :accepted (verdict "(loop [i 10 acc 0] (if (> i 0) (recur (dec i) (+ acc i)) acc))"))
        "count-down + accumulator")))

(deftest rejects-unfounded-loops
  (testing "count-up without a bound, and a spin"
    (is (= :rejected (verdict "(loop [i 0] (if (keep? i) (recur (inc i)) i))"))
        "count-up, no upper-bound guard")
    (is (= :rejected (verdict "(loop [i 0] (recur i))"))
        "pure spin — no measure")))

(deftest trusted-escape-hatch
  (testing "^{:decreasing} measure is trusted"
    (is (= :trusted
           (verdict "(loop ^{:decreasing (custom i)} [i x] (if (done? i) i (recur (weird i))))")))))

(deftest measure-dir-over-anf
  (testing "measure-dir reads resolved ANF arithmetic"
    ;; build the ANF for (dec i)/(inc i) directly through check via a loop
    (is (= :accepted (verdict "(loop [i n] (if (> i 0) (recur (- i 2)) i))"))
        "(- i 2) count-down by positive literal")))

(deftest the-bound-must-guard-the-recur
  (testing "counting down with no floor on the recur's path diverges"
    (is (= :rejected (verdict "(loop [i 0] (recur (dec i)))")))
    (is (= :rejected (verdict "(loop [i n] (if (> i 0) i (recur (dec i))))"))
        "the guard holds on the OTHER branch"))
  (testing "counting up needs a ceiling on the recur's path, not anywhere"
    (is (= :rejected (verdict "(loop [i 0] (if (< i 10) i (recur (inc i))))"))))
  (testing "the bound must not move with the loop"
    (is (= :rejected (verdict "(loop [i 10 j 0] (if (> i j) (recur (dec i) (dec j)) i))"))))
  (testing "guards the else branch knows by negation"
    (is (= :accepted (verdict "(loop [i n] (if (<= i 0) i (recur (dec i))))")))
    (is (= :accepted (verdict "(loop [i n] (if (pos? i) (recur (dec i)) i))")))
    (is (= :accepted (verdict "(loop [i 0] (if (>= i n) i (recur (inc i))))"))))
  (testing "a sequence walked with rest/next is finite"
    (is (= :accepted (verdict "(loop [s xs] (if (empty? s) 0 (recur (rest s))))")))))

(deftest a-bound-must-be-loop-invariant
  (testing "a bound derived from a collection the loop grows moves with the measure"
    (is (= :rejected (verdict "(fn [xs] (loop [i 0 ys xs] (if (< i (count ys)) (recur (inc i) (conj ys 1)) i)))")))
    (is (= :rejected (verdict "(loop [i 0 xs [1]] (let [n (count xs)] (if (< i n) (recur (inc i) (conj xs 1)) i)))"))
        "a let inside the body is recomputed each iteration"))
  (testing "count or arithmetic over values fixed outside the loop is a bound"
    (is (= :accepted (verdict "(fn [xs] (loop [i 0] (if (< i (count xs)) (recur (inc i)) i)))")))
    (is (= :accepted (verdict "(fn [n] (loop [i 0] (let [m (+ n 1)] (if (< i m) (recur (inc i)) i))))")))))

(deftest a-sequence-step-needs-a-non-empty-guard
  (testing "(rest []) is () — truthy and no shorter — so an unguarded walk never ends"
    (is (= :rejected (verdict "(loop [s [1]] (recur (rest s)))")))
    (is (= :rejected (verdict "(loop [s [1]] (if s (recur (rest s)) 0))"))
        "truthiness is not non-emptiness for rest"))
  (testing "the guards that prove a first element"
    (is (= :accepted (verdict "(fn [xs] (loop [s xs] (if (seq s) (recur (rest s)) 0)))")))
    (is (= :accepted (verdict "(fn [xs] (loop [s xs] (if (not (empty? s)) (recur (rest s)) 0)))")))
    (is (= :accepted (verdict "(fn [xs] (loop [s (seq xs)] (if s (recur (next s)) 0)))"))
        "next of a truthy seq is nil or shorter")
    (is (= :accepted (verdict "(fn [xs] (loop [s xs] (if (nil? s) 0 (recur (next s)))))")))))
