; tier_test.bl — the progressive-lowering prototype's proof obligations.
;
; The claim system.tier makes: the raised tier (:arith) carries EVERYTHING
; the canonical tier's scaffold does, so analysis can live above the
; lowering and the scaffold can move to the emitter. The proof:
;
;   1. recognition is exact  — the compiler's own output raises, and a
;      user-written let-let-if that merely rhymes does not;
;   2. the round trip holds  — lower(raise(anf)) ≡ anf for the corpus,
;      modulo invented names (alpha=) and annotations;
;   3. analysis gets simpler — the op census and the growth image are
;      one-clause functions on the raised tier;
;   4. alpha= itself is sound — compiling one source twice fails raw `=`
;      (fresh names) and passes alpha=; a different source fails both.

(ns system.tier-test
  (:require [compiler :as c] [system.ir :as ir] [system.tier :as tier]))

(BeamLisp.Env/add_search_path (BeamLisp.Tiers/priv_root))
(BeamLisp.Loader/ensure_loaded "self.anf")

(def kenv (assoc (c/new-env "user") :ns "user"))

(defn- compile-anf [src] (c/compile (BeamLisp.Reader/read_one src) kenv))

(deftest recognition-is-exact
  (testing "the compiler's own scaffold raises to one :arith node"
    (let [raised (tier/raise (compile-anf "(let [x 1] (+ x 2))"))
          arith (:body raised)]
      (is (= :let (:op raised)))
      (is (= :arith (:op arith)) "the whole dispatch is one node")
      (is (= :add (:fun arith)))
      (is (= :+ (:bif arith)))
      (is (= 2 (count (:args arith))))))
  (testing "a user-written let-let-if that merely rhymes is left alone"
    (let [raised (tier/raise (compile-anf "(let [a 1] (let [b 2] (if a b a)))"))]
      (is (= :let (:op raised)))
      (is (= :let (:op (:body raised))) "no :arith appeared — not the scaffold")
      (is (empty? (tier/arith-ops raised))))))

(deftest the-round-trip-is-lossless
  (testing "lower(raise(anf)) is alpha-equivalent to anf across the corpus"
    (let [corpus ["(+ x 2)"
                  "(+ 1 (* 2 3))"
                  "(- n 1)"
                  "(if (< n 2) n (+ n 1))"
                  "(let [a (+ 1 2)] (let [b (* a 3)] (+ a b)))"
                  "(fn [n] (if (< n 2) n (+ (recur-inner n) 1)))"
                  "(do (+ 1 2) (- 3 4) 5)"
                  "(+ x y)"]]
      (doseq [src corpus]
        (let [anf (compile-anf src)
              raised (tier/raise anf)
              lowered (tier/lower raised)]
          (is (tier/alpha= anf lowered)
              (str "round trip holds for " src))))))
  (testing "a scaffold nested inside a scaffold's operand round-trips too"
    (let [anf (compile-anf "(+ (+ 1 2) (+ 3 4))")]
      (is (= 3 (count (tier/arith-ops (tier/raise anf)))))
      (is (tier/alpha= anf (tier/lower (tier/raise anf)))))))

(deftest analysis-is-one-clause-on-the-raised-tier
  (testing "the op census needs no scaffold knowledge"
    (let [fib (compile-anf "(fn [n] (if (< n 2) n (+ (f (- n 1)) (f (- n 2)))))")
          raised (tier/raise fib)]
      (is (= (list :lt :sub :sub :add) (tier/arith-ops raised))
          "guard, two decrements, the combine — in evaluation order")))
  (testing "the growth image is the node itself"
    (let [raised (tier/raise (compile-anf "(- n 1)"))]
      (is (= :- (tier/arith-image raised)))
      (is (nil? (tier/arith-image (compile-anf "(if true 1 2)")))
          "a non-call node has no image"))))

(deftest alpha-equivalence-is-sound
  (testing "the same source compiled twice fails raw = and passes alpha="
    (let [a (compile-anf "(let [x 1] (+ x 2))")
          b (compile-anf "(let [x 1] (+ x 2))")]
      (is (not (= a b)) "fresh names differ between compiles")
      (is (tier/alpha= a b) "alpha= sees the same program")))
  (testing "a different program fails alpha="
    (let [a (compile-anf "(+ 1 2)")
          b (compile-anf "(- 1 2)")]
      (is (not (tier/alpha= a b))))))

(run-tests)
