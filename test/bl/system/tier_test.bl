; tier_test.bl — the canonical tier's :arith contract, post-cutover.
;
; compiler.bl emits 2-arity core numeric ops as {:op :arith :fun :bif :args}
; DIRECTLY (the is_map dispatch exists only in lower.bl, at emission). What
; is pinned here:
;
;   1. emission        — compiling arithmetic yields :arith, with the tower
;                        name and its BIF, over the operand nodes; nested
;                        arithmetic nests the nodes;
;   2. the vocabulary  — anf's validator accepts :arith and rejects a
;                        malformed one;
;   3. analysis        — the op census and the growth image are one-clause
;                        functions with nothing to know about a dispatch;
;   4. alpha=          — the same source compiled twice fails raw `=` and
;                        passes alpha=; a different program fails both.

(ns system.tier-test
  (:require [compiler :as c] [anf :as anf] [system.ir :as ir] [system.tier :as tier]))

(BeamLisp.Env/add_search_path (BeamLisp.Tiers/priv_root))
(BeamLisp.Loader/ensure_loaded "self.anf")

(def kenv (assoc (c/new-env "user") :ns "user"))

(defn- compile-anf [src] (c/compile (BeamLisp.Reader/read_one src) kenv))

(deftest emission-is-the-abstract-node
  (testing "compiling (+ x 2) yields ONE :arith node, not a dispatch"
    (let [n (compile-anf "(let [x 1] (+ x 2))")
          arith (:body n)]
      (is (= :let (:op n)))
      (is (= :arith (:op arith)) "the dispatch has not happened at this tier")
      (is (= :add (:fun arith)))
      (is (= :+ (:bif arith)))
      (is (= 2 (count (:args arith))))
      (is (= :var (:op (first (:args arith)))) "the operands are the ORIGINAL nodes")))
  (testing "nested arithmetic nests :arith nodes"
    (let [n (compile-anf "(+ (* 2 3) 1)")]
      (is (= :arith (:op n)))
      (is (= :add (:fun n)))
      (is (= :arith (:op (first (:args n)))))
      (is (= :mul (:fun (first (:args n)))))))
  (testing "ordering ops are :arith too"
    (let [n (compile-anf "(< n 2)")]
      (is (= :arith (:op n)))
      (is (= :lt (:fun n)))
      (is (= :< (:bif n))))))

(deftest the-validator-knows-arith
  (letfn [(defmod [mname body]
            (anf/module mname
                        (list {:op :defn-clause :fname :run :params (list)
                               :guard nil :body body :ann {}})
                        (list) (list)))]
    (testing "a module carrying :arith validates"
      (is (map? (defmod (erlang/binary_to_atom "Elixir.ArithOk")
                        (anf/arith :add :+ (list (anf/lit 1) (anf/lit 2)))))))
    (testing "a malformed :arith is refused"
      (is (thrown? (defmod (erlang/binary_to_atom "Elixir.ArithBad")
                           (assoc (anf/arith :add :+ (list (anf/lit 1) (anf/lit 2)))
                                  :bif "not-an-atom")))))))

(deftest analysis-is-one-clause
  (testing "the op census, in evaluation order"
    (let [fib (compile-anf "(fn [n] (if (< n 2) n (+ (f (- n 1)) (f (- n 2)))))")]
      (is (= (list :lt :sub :sub :add) (tier/arith-ops fib)))))
  (testing "the growth image is the node itself"
    (is (= :- (tier/arith-image (compile-anf "(- n 1)"))))
    (is (nil? (tier/arith-image (compile-anf "(if true 1 2)")))
        "a non-call node has no image"))
  (testing "ir/arith-bif renames to the BIF over the same operands"
    (let [n (compile-anf "(+ x 2)")
          bif (ir/arith-bif n)]
      (is (= :remote (:op bif)))
      (is (= :erlang (:mod bif)))
      (is (= :+ (:fun bif)))
      (is (= (:args n) (:args bif)) "same operand nodes, not copies"))))

(deftest alpha-equivalence-is-sound
  (testing "the same source compiled twice fails raw = and passes alpha="
    (let [a (compile-anf "(let [x 1] (+ x 2))")
          b (compile-anf "(let [x 1] (+ x 2))")]
      (is (not (= a b)) "fresh names differ between compiles")
      (is (tier/alpha= a b) "alpha= sees the same program")))
  (testing "a different program fails alpha="
    (is (not (tier/alpha= (compile-anf "(+ 1 2)") (compile-anf "(- 1 2)"))))))

(run-tests)
