; test/bl/system/native_eligible_test.bl — the doc-05 native-offload gate,
; computed INTER-PROCEDURALLY over the call graph.
;
; The win: a function that calls a pure helper inherits the helper's purity
; through system.analyze's footprint closure, so whole call trees become
; offloadable — not just leaf functions. Every refusal names the failed theorem.
(ns system.native-eligible-test
  (:require [native.eligible :as el]))

(def src (str "(defn dist2 [dx dy] (erlang/+ (erlang/* dx dx) (erlang/* dy dy)))\n"
              "(defn step [x y] (dist2 (erlang/- x 1) (erlang/- y 1)))\n"
              "(defn noisy [x] (do (io/format \"~p~n\" [x]) (erlang/+ x 1)))\n"
              "(defn mk-kw [] :kw)\n"
              "(defn bad-sort [x] (mk-kw))"))

(deftest leaf-kernel-is-eligible
  (testing "a pure, terminating, machine-sorted leaf is offloadable"
    (let [v (el/eligible src "dist2")]
      (is (:eligible v) "dist2 is eligible")
      (is (= "Int" (:sort v)) "its values are machine ints"))))

(deftest call-tree-eligible-via-closure
  (testing "step is eligible ONLY because dist2's purity flows through the summary"
    (let [v (el/eligible src "step")]
      (is (:eligible v) "step is eligible")
      (is (some? (index-of (pr-str (:calls v)) "dist2")) "it calls dist2")
      (is (some? (index-of (:note v) "whole tree")) "noted as whole-tree offload"))))

(deftest impure-refused-by-named-theorem
  (testing "a function doing IO is refused as impure, and so is its caller"
    (is (= :impure (:reason (el/eligible src "noisy"))) "noisy: IO → impure")))

(deftest wrong-sort-refused
  (testing "a keyword return is not a NIF-safe sort"
    (is (= :sort (:reason (el/eligible src "mk-kw"))) "mk-kw returns :kw → sort")
    (is (= :sort (:reason (el/eligible src "bad-sort"))) "bad-sort inherits :kw")))

(deftest report-covers-every-fn
  (testing "eligibility-report verdicts every function"
    (let [r (el/eligibility-report src)]
      (is (= 5 (count (into [] r))) "all five functions")
      (is (:eligible (get r "step")) "step eligible")
      (is (not (:eligible (get r "noisy"))) "noisy refused"))))
