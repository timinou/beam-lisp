; test/bl/system/repair_test.bl — synthesis and repair (P21).
;
; The checker is a relation: run backwards it synthesizes the guard a broken
; transition needs. The repair is the WEAKEST sound guard, and it is round-
; tripped — accepted only when the forward checker then passes.

(ns system.repair-test
  (:require [system.core :as sys] [z3]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(def port (z3/open))

(def overdraft
  "(defserver ^{:invariant (>= balance 0)} account
     (init [] (ok {:balance 100}))
     (handle-call [:withdraw amt] [_ {:keys [balance]}]
       (reply :ok {:balance (- balance amt)}))
     (handle-call [:deposit amt] [_ {:keys [balance]}] :when (>= amt 0)
       (reply :ok {:balance (+ balance amt)})))")

(def correct
  "(defserver ^{:invariant (>= balance 0)} account2
     (init [] (ok {:balance 100}))
     (handle-call [:withdraw amt] [_ {:keys [balance]}] :when (<= amt balance)
       (reply :ok {:balance (- balance amt)})))")

; ── repair-process finds and fixes broken transitions ─────────────────────

(deftest repair-finds-the-broken-transition
  (let [r (sys/repair-process port (read1 overdraft))]
    (is (not (:holds r)) "the overdraft account has a broken transition")
    (is (= 1 (count (:repairs r))) "exactly one transition needs repair")
    (is (= :withdraw (:label (first (:repairs r)))) "it is :withdraw (deposit is already guarded)")))

(deftest repair-synthesizes-a-guard
  (let [r (sys/repair-process port (read1 overdraft))
        g (:guard (first (:repairs r)))]
    (is (some? g) "a guard was synthesized (not nil/unrepairable)")))

(deftest repair-reports-nothing-for-a-correct-process
  (let [r (sys/repair-process port (read1 correct))]
    (is (:holds r) "a correct process has nothing to repair")
    (is (empty? (:repairs r)) "no repairs proposed")))

; ── the round trip: the synthesized guard, inserted, verifies ─────────────

(deftest repair-round-trips-through-the-forward-checker
  (let [r (sys/repair-process port (read1 overdraft))
        g (:guard (first (:repairs r)))
        ; splice the synthesized guard into the withdraw clause
        fixed (str "(defserver ^{:invariant (>= balance 0)} account
                      (init [] (ok {:balance 100}))
                      (handle-call [:withdraw amt] [_ {:keys [balance]}] :when " g "
                        (reply :ok {:balance (- balance amt)})))")
        v (sys/verify-process port (read1 fixed))]
    (is (:holds v) "the repaired machine passes the forward checker — synth backward, verify forward")))

; ── the weakest-guard ranking ─────────────────────────────────────────────

(deftest repair-transition-picks-the-weakest-sound-guard
  (let [r (sys/repair-transition port (fn [x] (str "(>= " x " 0)")) "balance"
            "(declare-const balance Int)\n(declare-const amt Int)\n"
            "(- balance amt)" (list "balance" "amt" "0"))]
    (is (some? (:repair r)) "a repair is found")
    (is (> (count (:alternatives r)) 1) "several sound guards exist")
    ; the chosen repair must be implied BY the degenerate (<= amt 0), i.e. weaker
    (is (not (= "(<= amt 0)" (:repair r)))
        "the degenerate (<= amt 0) is NOT chosen — the ranking prefers the permissive guard")))

; ── the repair is sound: it actually closes the triple ────────────────────

(deftest repair-transition-guard-is-sound
  (let [r (sys/repair-transition port (fn [x] (str "(>= " x " 0)")) "balance"
            "(declare-const balance Int)\n(declare-const amt Int)\n"
            "(- balance amt)" (list "balance" "amt" "0"))]
    (is (sys/sufficient? port (fn [x] (str "(>= " x " 0)")) "balance"
          "(declare-const balance Int)\n(declare-const amt Int)\n"
          (:repair r) "(- balance amt)" "true")
        "the synthesized guard, as a precondition, preserves the invariant")))
