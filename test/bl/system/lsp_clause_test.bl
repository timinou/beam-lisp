; test/bl/system/lsp_clause_test.bl — position features and call info read a
; multi-arity/multi-clause fn's LATER clauses, not only the first.
;
; `fn-bodies`' :body/:params are the FIRST clause; the position index and the
; highlight walk used to read only those, so a point inside a second arity
; answered :none and a call living only in a later clause was invisible. The
; SUMMARY tables are already the union over all clauses (system.analyze), so
; the effects/calls of a later arity were never the gap — reading it was.
(ns system.lsp-clause-test
  (:require [lsp] [system.analyze :as analyze]))

; line 1: (defn f ([x] x)
; line 2:          ([x y] (g x y)))          <- f's SECOND clause
; line 3: (defn g [a b] (erlang/+ a b))
; line 4: (defn self ([n] n)
; line 5:           ([n m] (erlang/+ n (self n))))  <- self's SECOND clause
; line 6: (defn use-it [a b] (f a b))
(def src
  (str "(defn f ([x] x)\n"
       "         ([x y] (g x y)))\n"
       "(defn g [a b] (erlang/+ a b))\n"
       "(defn self ([n] n)\n"
       "          ([n m] (erlang/+ n (self n))))\n"
       "(defn use-it [a b] (f a b))\n"))

; ── the position index covers every clause ─────────────────────────────────

(deftest hover-resolves-inside-a-later-clause
  (testing "a call in f's second clause is a real node, not :none"
    (let [h (lsp/hover src 2 18)]
      (is (= :call (:kind h)) "a user call")
      (is (= "g" (:label h)) "named g"))))

(deftest hover-resolves-a-later-clause-recursive-call
  (testing "self's second clause calls self; the point answers there too"
    (let [h (lsp/hover src 5 30)]
      (is (= :call (:kind h)) "a call node")
      (is (= "self" (:label h)) "named self"))))

(deftest definition-resolves-inside-a-later-clause
  (is (= "g" (:resolves-to (lsp/definition src 2 18)))
      "definition on a call in a later clause resolves the callee"))

(deftest highlight-finds-a-later-clause-call
  (testing "the call `(g x y)` lives ONLY in f's second clause"
    (let [spans (into [] (lsp/document-highlight src "g"))]
      (is (= 1 (count spans)) "exactly the one call site")
      (is (= 2 (:line (first spans))) "on the second-clause line"))))

(deftest highlight-finds-a-later-clause-recursive-call
  (let [spans (into [] (lsp/document-highlight src "self"))]
    (is (= 1 (count spans)) "the recursive call in self's second clause")
    (is (= 5 (:line (first spans))) "found on the later-clause line")))

; ── call info observes all arities ─────────────────────────────────────────

(deftest signature-help-reports-every-arity
  (testing "the signature names both arities of f, not only the first"
    (is (= "(f [x] [x y])" (:label (lsp/signature-help src 6 22))))))

(deftest call-graph-and-references-see-a-later-clause-edge
  (testing "f->g comes from f's second clause; the graph and references see it"
    (is (contains? (:edges (get (analyze/analyze src) "f")) "g")
        "the later clause's call is a graph edge")
    (is (= ["f"] (into [] (lsp/references src "g")))
        "references reports f as g's caller")
    (is (contains? (:edges (get (analyze/analyze src) "self")) "self")
        "a later clause's self-call is an edge")))

; ── a later clause's EFFECTS reach the reader ──────────────────────────────

(def noisy-src
  (str "(defn noisy ([x] x)\n"
       "           ([x y] (File/write! x y)))\n"))

(deftest outline-carries-a-later-clause-effect
  (testing "the I/O lives only in the second clause; the outline still shows it"
    (let [s (first (filter (fn [sym] (= "noisy" (:name sym)))
                           (into [] (lsp/document-symbols noisy-src))))]
      (is (some? s) "noisy is in the outline")
      (is (not (:pure s)) "not pure — the later clause touches state")
      (is (seq (:footprint s)) "and the footprint says which effect"))))

(run-tests)
