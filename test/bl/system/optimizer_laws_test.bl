(ns optimizer.laws.test
  (:require [z3] [oracle]))

; Algebraic obligations for the checked strict integer map/left-fold rule.
; F and M are arbitrary total functions in the admitted domain. The callback
; domain/effect checks are tested separately against actual executable ANF.
(def decl
  "(declare-fun M (Int) Int) (declare-fun F (Int Int) Int)
   (declare-fun originalTail (Int) Int) (declare-fun fusedTail (Int) Int)
   (declare-const x Int) (declare-const acc Int)
   (assert (forall ((a Int)) (= (originalTail a) (fusedTail a)))) ")

(deftest strict-map-fold-base-and-inductive-step
  (let [port (z3/open)]
    (is (oracle/proven? (z3/check port
      "(declare-const acc Int) (assert (not (= acc acc)))")))
    (is (oracle/proven? (z3/check port
      (str decl "(assert (not (= (originalTail (F (M x) acc))
                                   (fusedTail (F (M x) acc)))))"))))))

(deftest the-law-does-not-authorize-reversing-fold-arguments
  (let [port (z3/open)
        wrong (z3/check port
          (str decl "(assert (not (= (originalTail (F (M x) acc))
                                       (fusedTail (F acc (M x))))))"))]
    (is (= :sat (:status wrong)))
    (is (not (oracle/proven? wrong)))))
