; test/bl/system/z3_stats_test.bl — the rollup, pinned by observation.
;
; `bl z3 stats` is a view over VM state, and these tests pin the pieces that go
; wrong SILENTLY:
;
;   1. THE REPORT IS A VALUE. `stats-report` returns the corpus, its coverage
;      guard, the cost, the histograms, the undecided list and the failures — a
;      test and a future MCP tool read the map, never the text.
;   2. A VACUOUS ZERO IS LOUD. An empty corpus prints the file count it examined,
;      says plainly that no machine was found, and fails the coverage line; `run`
;      exits 1. Zero is never green.
;   3. THE COVERAGE GUARD BITES. A file that only MENTIONS `defserver` cannot
;      lift the machine count to the independent raw-text bound, and the walk
;      fails.
;   4. AN UNDECIDED MACHINE NAMES ITS WHY. z3's own reason is kept on the
;      decision and carried onto the machine, so "undecided" is explainable and
;      never a bare count.
;   5. THE MODE IS PRINTED. A ledger-only run says so, so it cannot be read as a
;      clean corpus.
;
; Run: mix bl test test/bl/system/z3_stats_test.bl

(ns system.z3-stats-test
  (:require [bl.z3 :as bz]
            [oracle]))

(defn- capture
  "Run `f` with this process's group leader on a StringIO, so a command's output
   is a value here. Returns [return-value output]; restores the leader in a
   finally."
  [f]
  (let [prev (Process/group_leader)
        dev (erlang/element 2 (StringIO/open ""))]
    (Process/group_leader (erlang/self) dev)
    (let [r (try (f) (finally (Process/group_leader (erlang/self) prev)))]
      (list r (erlang/element 2 (StringIO/contents dev))))))

(defn- tmp-root []
  (str (System/tmp_dir!) "/bl_z3stats_" (erlang/unique_integer (list :positive))))

(defn- with-tmp [f]
  (let [root (tmp-root)]
    (try (File/mkdir_p! root) (f root) (finally (File/rm_rf! root)))))

;; ── the fixture sources ─────────────────────────────────────────────────────

;; a live/reactive machine with no invariant: the engine DECLINES it
(def plain-src
  "(defserver plain
     (init [x] (ok x))
     (handle-call [:get] [_ x] (reply :ok x)))")

;; a machine whose invariant the engine can prove
(def annotated-src
  "(defserver ^{:invariant (>= balance 0)} acct
     (init [balance] (ok balance))
     (handle-call [:deposit amt] [_ balance] :when (>= amt 0)
       (reply :ok (+ balance amt))))")

;; raw text that spells the needle but holds no machine — the guard's whole point
(def mention-src
  "; this file spells defserver but holds no machine
(defn f [x] (inc x))
")

;; ── 1: the report shape on a fixture corpus ─────────────────────────────────

(deftest report-shape-on-a-fixture-corpus
  (with-tmp
    (fn [root]
      (File/write! (str root "/plain.bl") (str plain-src "\n"))
      (File/write! (str root "/annotated.bl") (str annotated-src "\n"))
      (let [r (bz/stats-report {:dirs [root] :walk? true})]
        (is (= :walk (:mode r)) "the full walk ran")
        (is (= 2 (:files r)) "both machines' files were walked")
        (is (= 2 (:machines r)) "and both machines were found")
        (is (= 2 (:examined r)) "the examined count is the machine count")
        (is (= 1 (get-in r [:counts :proven])) "the annotated machine is proved")
        (is (= 1 (get-in r [:counts :declined])) "the live machine is declined")
        (is (= 0 (get-in r [:counts :error])) "and nothing threw")
        (is (= true (get-in r [:coverage :pass])) "the count reaches the grep bound")
        (is (= true (:ok r)) "so the walk is ok")
        (is (= 1 (get-in r [:cost :count])) "the cost records the walk's decisions")
        (is (some? (get-in r [:cost :worst :name])) "and names the worst machine")
        (is (seq (get-in r [:tiers :tiers])) "the tier histogram is present")
        (is (string? (bz/render r)) "render returns text")
        (is (includes? (bz/render r) "1. corpus") "with the five labelled sections")))))

;; ── 5: skipping the walk is a mode, and it says so ──────────────────────────

(deftest ledger-only-mode-skips-the-walk
  (let [r (bz/stats-report {:dirs ["priv" "examples"] :walk? false})]
    (is (= :ledger (:mode r)) "no corpus was walked")
    (is (= 0 (:files r)) "so no file was examined")
    (is (nil? (:coverage r)) "and there is no coverage claim to make")
    (is (:ok r) "a ledger-only read does not fail")
    (is (includes? (bz/render r) "ledger-only") "and the mode is printed")))

;; ── 2: an empty corpus must not print zeros and exit green ──────────────────

(deftest an-empty-corpus-is-loud
  (with-tmp
    (fn [root]
      (File/write! (str root "/notes.md") "# no machines here\nsome (defserver prose\n")
      (let [r (bz/stats-report {:dirs [root] :walk? true})]
        (is (= 0 (:files r)) "the file count examined is printed as zero")
        (is (= 0 (:machines r)) "no machine was found")
        (is (= false (get-in r [:coverage :pass])) "a vacuous 0 >= 0 can never pass")
        (is (= false (:ok r)) "so the report is not ok")
        (is (includes? (bz/render r) "NO MACHINE FOUND") "and the text says so plainly"))
      (let [out (capture (fn [] (bz/run [] {:paths [root]})))]
        (is (= 1 (first out)) "the command exits non-zero on an empty corpus")
        (is (includes? (second out) "FAIL") "and the coverage line fails loudly")))))

;; ── 3: the coverage guard refuses a count below the bound ───────────────────

(deftest coverage-refuses-a-count-below-the-bound
  (with-tmp
    (fn [root]
      (File/write! (str root "/mention.bl") mention-src)
      (let [r (bz/stats-report {:dirs [root] :walk? true})]
        (is (= 1 (:files r)) "the mentioning file was walked")
        (is (= 0 (:machines r)) "but it holds no machine")
        (is (= 1 (get-in r [:coverage :bound])) "the raw text spells the needle")
        (is (= false (get-in r [:coverage :pass])) "0 machines cannot reach a bound of 1")
        (is (= false (:ok r)) "so the walk fails"))
      (let [out (capture (fn [] (bz/run [] {:paths [root]})))]
        (is (= 1 (first out)) "and the command exits 1")))))

;; ── 4: an undecided machine names z3's own why ──────────────────────────────

(deftest an-undecided-machine-names-its-why
  (with-tmp
    (fn [root]
      (File/write! (str root "/machine.bl") (str annotated-src "\n"))
      ;; a handler that always gives up with a reason: the ceiling path made
      ;; deterministic (z3 would decide a small linear query in microseconds).
      (let [unknown (fn [_text _model?]
                      {:status "unknown" :why "timeout" :model nil :core nil})
            r (oracle/with-oracle
                unknown
                (fn [] (bz/stats-report {:dirs [root] :walk? true})))]
        (is (= 1 (get-in r [:counts :undecided])) "the machine is undecided")
        (is (= 1 (count (:undecided r))) "and it is listed")
        (is (= [:timeout] (:why (first (:undecided r))))
            "with z3's own reason, not a label invented here")
        (is (includes? (bz/render r) ":timeout") "named in the text")
        (is (= 1 (:examined r)) "beside the count of machines examined")))))

;; ── the command, end to end ─────────────────────────────────────────────────

(deftest run-prints-five-sections-and-exits-zero
  (with-tmp
    (fn [root]
      (File/write! (str root "/machine.bl") (str annotated-src "\n"))
      (let [out (capture (fn [] (bz/run [] {:paths [root]})))
            text (second out)]
        (is (= 0 (first out)) "a covered corpus exits 0")
        (is (includes? text "1. corpus"))
        (is (includes? text "2. cost"))
        (is (includes? text "3. tiers"))
        (is (includes? text "4. undecided"))
        (is (includes? text "5. failures"))
        (is (includes? text "verdict: ok"))))))

(deftest run-accepts-the-dry-run-flag-and-an-unknown-subcommand-is-usage
  (is (= 0 (first (capture (fn [] (bz/run [] {:dry_run true})))))
      "--dry-run reports the ledger and exits 0")
  (is (= 2 (first (capture (fn [] (bz/run ["nope"] {})))))
      "an unknown subcommand is a usage error"))
