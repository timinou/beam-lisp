(ns system.contract-identity-test (:require [anf :as a] [system.tier :as tier]))

(defn validate-node [node]
 (a/module :Elixir.ContractIdentityProbe
  (list {:op :defn-clause :fname :run :params (list) :guard nil :body node :ann {}})
  (list [:run 0]) (list)))

(deftest record-type-is-executable-meaning-not-an-annotation
 (let [one (a/structt :Elixir.FirstRecord (list [(a/lit :value) (a/lit 1)]))
       other (assoc one :mod :Elixir.OtherRecord)]
  (is (map? (validate-node one)))
  (is (map? (validate-node other)))
  (is (not (tier/alpha= one other)))
  (is (not (tier/alpha= other one)))
  (is (tier/alpha= one (assoc one :ann {:line 999 :file "elsewhere.bl"})))))

(deftest internal-stack-and-public-frame-list-are-different-operations
 (let [frames (a/remote :erlang :raise (list (a/lit :error) (a/lit :badarg) a/enil))
       raw (assoc frames :stack-format :raw)]
  (is (map? (validate-node frames)))
  (is (map? (validate-node raw)))
  (is (not (tier/alpha= frames raw)))
  (is (not (tier/alpha= raw frames)))
  (is (tier/alpha= raw (assoc raw :ann {:line 2})))))

(deftest harmless-local-renaming-remains-equivalent
 (let [one (a/lett "old" (a/lit 1) (a/var "old"))
       other (a/lett "new" (a/lit 1) (a/var "new"))]
  (is (tier/alpha= one other))
  (is (not (tier/alpha= one (a/lett "new" (a/lit 2) (a/var "new")))))))
