; test/bl/system/growth_test.bl — the growth class of a fn's own recursion,
; read off bl-ANF by termination/growth. Linear / quadratic / exponential, and
; the structural-descent false-positive guard.
;
; Run: bl test test/bl/system/growth_test.bl
(ns system.growth-test
  (:require [termination :as term]))

(def prog
  (str "(defn fib [n] (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))\n"
       "(defn nested [n] (if (< n 1) 0 (inc (nested (nested (- n 1))))))\n"
       "(defn sum-to [n acc] (if (= n 0) acc (sum-to (- n 1) (+ acc n))))\n"
       "(defn tail-loop [n acc] (loop [i n a acc] (if (= i 0) a (recur (- i 1) (+ a i)))))\n"
       "(defn walk [t] (if (nil? t) 0 (+ (walk (left t)) (walk (right t)))))\n"
       "(defn mapp [xs f] (if (nil? xs) (cons (f (first xs)) (mapp (rest xs) f))))\n"
       "(defn plain [x] (erlang/+ x 1))"))

(defn- entry [name] (get (term/growth prog) name))
(defn- class-of [name] (:class (entry name)))

(deftest branching-arithmetic-is-exponential
  (testing "fib's two self-calls step the same parameter by arithmetic"
    (is (= :exponential (class-of "fib")))
    (is (= "O(2^n)" (:label (entry "fib"))))))

(deftest nested-self-call-is-quadratic
  (testing "a self-call inside another self-call's arguments redoes the work"
    (is (= :quadratic (class-of "nested")))
    (is (= ">= O(n^2)" (:label (entry "nested"))))))

(deftest tail-loop-and-accumulator-are-linear
  (testing "a recognised loop, and a single self-call with an accumulator"
    (is (= :linear (class-of "tail-loop")))
    (is (= :linear (class-of "sum-to")))
    (is (= "O(n)" (:label (entry "sum-to"))))))

(deftest structural-descents-are-not-exponential
  (testing "a tree walk over differing fields has disjoint subproblems — linear"
    (is (= :linear (class-of "walk")))
    (is (not= :exponential (class-of "walk"))))
  (testing "map over rest is one structural descent — linear"
    (is (= :linear (class-of "mapp")))))

(deftest non-recursive-is-absent
  (testing "a fn that neither calls itself nor loops says nothing"
    (is (nil? (entry "plain")))
    (is (nil? (class-of "plain")))))

(deftest growth-entry-carries-witness-and-detail
  (testing "each class carries a label, a witness and a reason"
    (let [g (entry "fib")]
      (is (string? (:witness g)) "witness is a string")
      (is (string? (:detail g)) "detail is a string"))))

(deftest growth-never-raises
  (testing "an unreadable source yields no entries rather than an error"
    (is (= {} (term/growth "(defn broken [x] (")))))
