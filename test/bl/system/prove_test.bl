; test/bl/system/prove_test.bl — proofs travel as :ann, consumed by the gate.
(ns system.prove-test
  (:require [compiler :as c] [anf] [lower]
            [system.ir :as ir]
            [system.prove :as prove]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- anf [s] (c/compile-node (read1 s) (c/new-env "provetest")))

(deftest per-node-proof
  (testing "footprint, pure, terminates written onto :ann"
    (let [pure-node (prove/prove-node (anf "(erlang/+ (binary/at b i) 1)"))]
      (is (= {} (ir/ann-get pure-node :footprint)))
      (is (= true (ir/ann-get pure-node :pure)))
      (is (= true (ir/ann-get pure-node :terminates))))
    (let [eff-node (prove/prove-node (anf "(swap! a inc)"))]
      (is (= {"a" :W} (ir/ann-get eff-node :footprint)))
      (is (= false (ir/ann-get eff-node :pure))))))

(deftest terminates-over-loops
  (testing "well-founded loop proven terminating; unbounded not"
    (is (= true (ir/ann-get (prove/prove-node
                              (anf "(loop [i 10] (if (> i 0) (recur (dec i)) i))")) :terminates))
        "count-down terminates")
    (is (= false (ir/ann-get (prove/prove-node
                               (anf "(loop [i 0] (if (keep? i) (recur (inc i)) i))")) :terminates))
        "unbounded count-up not proven")))

(deftest native-eligibility-from-ann
  (testing "gate reads :ann, never re-derives"
    (let [hot (prove/prove-node (anf "(loop [i 0 acc 0] (if (< i 100) (recur (inc i) (+ acc (binary/at b i))) acc))"))]
      (is (prove/native-eligible? hot) "pure + terminating counted loop is eligible")
      (is (= true (:eligible (prove/eligibility-report hot)))))
    (let [effy (prove/prove-node (anf "(loop [i 0] (if (< i 100) (do (swap! a inc) (recur (inc i))) i))"))]
      (is (not (prove/native-eligible? effy)) "impure loop not eligible"))
    (is (not (prove/native-eligible? (anf "(erlang/+ 1 2)")))
        "un-annotated node is never eligible (sound default)")))

(deftest annotated-descriptor-still-emits
  (testing "a proof-annotated descriptor validates, emits, loads and runs"
    (let [body (anf "(loop [i 0 acc 0] (if (< i 10) (recur (inc i) (+ acc i)) acc))")
          clause {:op :defn-clause :fname :sum :params (list) :guard nil :body body :ann {}}
          d (anf/module :prove_probe (list clause) [[:sum 0]] (list) {:file "prove.bl"})
          annotated (prove/annotate-descriptor d)
          mb (lower/descriptor->beam annotated)]
      (code/load_binary (elem mb 0) (erlang/binary_to_list "prove.bl") (elem mb 1))
      (is (= 45 (prove_probe/sum)) "sum 0..9 = 45, with proofs in :ann")
      (is (= true (ir/ann-get (:body (first (:clauses annotated))) :terminates))))))
