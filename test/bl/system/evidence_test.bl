(ns system.evidence-test
  (:require [system.evidence :as evidence] [system.incr :as incr] [system.prove :as prove]
            [native.eligible :as native] [compiler :as compiler] [system.ir :as ir]
            [data.bounded-cache :as cache]))

(deftest unconditional-value-reads-and-callbacks-have-distinct-contracts
  (let [src "(defn value [] 1) (defn read [] (deref state)) (defn callback [f] (do (f) 1))"
        p (evidence/publish {} src)]
    (is (:admitted p))
    (is (= :value-candidate (get-in p [:functions "value" :reuse])))
    (is (= :refused (get-in p [:functions "read" :reuse])))
    (is (get-in p [:functions "read" :read-only]))
    (is (= :versioned-candidate
           (:reuse (evidence/classify {:footprint {"state" :R} :latent {} :calls #{}
                                      :returns #{:int} :terminates true}))))
    (is (= :refused (get-in p [:functions "callback" :reuse])))
    (is (= :conditional-effects (:reason (native/eligible src "callback"))))))

(deftest read-only-node-is-not-a-state-independent-native-kernel
  (let [node (compiler/compile-node (first (BeamLisp.Reader/read_string "(deref state)")) (compiler/new-env "proof.read"))
        annotated (prove/prove-node node)]
    (is (= true (ir/ann-get annotated :read-only)))
    (is (= false (ir/ann-get annotated :pure)))
    (is (not (prove/native-eligible? annotated)))))

(deftest incremental-publication-reuses-independent-round-summaries
  (let [a "(defn leaf [] 1) (defn caller [] (leaf)) (defn unrelated [] true)"
        b "(defn leaf [] 2) (defn caller [] (leaf)) (defn unrelated [] true)"
        p1 (evidence/publish {} a)
        p2 (evidence/publish (get-in p1 [:analysis :cache]) b)
        warm (evidence/publish (get-in p2 [:analysis :cache]) b)]
    (is (:admitted p2))
    (is (= ["unrelated"] (get-in p2 [:analysis :hits])))
    (is (= 0 (get-in warm [:analysis :summaries-evaluated])))
    (println "incremental-proof-summary-work" {:cold (get-in p1 [:analysis :summaries-evaluated])
                                               :edit (get-in p2 [:analysis :summaries-evaluated])
                                               :unchanged (get-in warm [:analysis :summaries-evaluated])})))

(deftest publication-is-retained-and-replaced-code-invalidates
  (cache/clear! :system.evidence)
  (let [src "(defn value [] 1)" a (evidence/source src) b (evidence/source src)]
    (is (:admitted a))
    (is (= a b))
    (is (= 1 (:size (cache/stats :system.evidence))))
    (BeamLisp.Env/intern "system.evidence" "__generation_probe" :changed)
    (let [c (evidence/source src)]
      (is (:admitted c))
      (is (not= (:generation a) (:generation c))))))
