; test/bl/system/smt_fragment_test.bl — the fragment CLOSURE assurance.
;
; The load-bearing claim: the source→SMT translator (system.smt) and the bl
; evaluator (veritas holds?) share ONE vocabulary. Every symbol veritas lets a
; predicate use MUST translate to SMT-LIB *and* evaluate in bl — otherwise a
; predicate that falls to the bl fallback raises and spuriously :refutes.
;
; This file pins the SMT half: each fragment form translates (never
; :untranslatable). The bl half is pinned in veritas_test / smt_symmetry_test.

(ns system.smt-fragment-test
  (:require [oracle] [system.smt :as smt] [smt :as smtlib] [z3]))

(defn- tx
  "Translate a source string under vars {a b c p} — the veritas predicate vars.
   The translator returns FORMS; the emitted text is what the fragment
   contract pins."
  [src]
  (let [r (smt/of-source #{"a" "b" "c" "n" "p"} src)]
    (if (= r :untranslatable) r (smtlib/emit r))))

(defn- ok? [src] (not (= :untranslatable (tx src))))

; ── implication + conditional: the two that were MISSING ────────────────────

(deftest implies-translates
  (is (ok? "(=> (> a 0) (> a -1))"))
  ; The ANF translator reads the compiler's resolved form, where `=>` has
  ; already been desugared to (or (not X) Y) — it is not a primitive in the IR.
  ; The two are logically identical (z3 proves (= old new) unsat over the parity
  ; corpus; see docs/tools/07). Negatives render as SMT-LIB terms: (- 1).
  (is (= "(or (not (> a 0)) (> a (- 1)))" (tx "(=> (> a 0) (> a -1))"))))

(deftest ite-translates
  (is (ok? "(ite (> a 0) a 0)"))
  (is (= "(ite (> a 0) a 0)" (tx "(ite (> a 0) a 0)"))))

; ── if desugars to ite (bl's `if` = z3's `ite`) ─────────────────────────────

(deftest if-desugars-to-ite
  (is (ok? "(if (> a 0) a 0)"))
  (is (= "(ite (> a 0) a 0)" (tx "(if (> a 0) a 0)"))))

; ── max / min desugar to ite (the floor/ceiling idiom relay money needs) ────

(deftest max-desugars-to-ite
  (is (ok? "(max 0 a)"))
  (is (= "(ite (>= 0 a) 0 a)" (tx "(max 0 a)"))))

(deftest min-desugars-to-ite
  (is (ok? "(min a b)"))
  (is (= "(ite (<= a b) a b)" (tx "(min a b)"))))

; ── nth on a positional tuple var: (nth p 0) → p_0 (the p_N foot-gun fix) ────

(deftest nth-positional-translates
  (is (ok? "(nth p 0)"))
  (is (= "p_0" (tx "(nth p 0)")))
  (is (= "(<= (nth p 0) (+ (nth p 0) (nth p 1)))"
         "(<= (nth p 0) (+ (nth p 0) (nth p 1)))"))   ; sanity: source is literal
  (is (= "(<= p_0 (+ p_0 p_1))" (tx "(<= (nth p 0) (+ (nth p 0) (nth p 1)))"))))

; ── the composite: a floor invariant now fully translatable ─────────────────

(deftest floor-invariant-is-symbolic
  (let [port (z3/open)]
    ; ∀ a. (max 0 a) ≥ 0 — the billing floor, now z3-PROVEN not sampled.
    (is (oracle/proven? (z3/check port
             (str "(declare-const a Int)\n"
                  "(assert (not " (tx "(>= (max 0 a) 0)") "))\n"))))))

; ── `not`: the compiler LINKS it, so a bare `(not X)` is a RESOLVED remote ──
;
; `not` is a linked head ("not" → Rt.not_/1 in rt's core link table), so the
; compiler lowers `(not X)` to a direct remote call, NOT to RT/invoke. The
; translator must cover that resolved [rt :not_] form directly; reading only the
; invoke-desugar path left negation :untranslatable and silently dropped whole
; predicates from the proof. These exercise the compiler's own lowering (every
; `tx` call runs fresh `compile-node` via of-source), not a hand-built table row.

(deftest not-equality-translates
  (is (ok? "(not (= a 1))"))
  (is (= "(not (= a 1))" (tx "(not (= a 1))"))))

(deftest not-nested-translates
  (is (ok? "(not (not (= a 1)))"))
  (is (= "(not (not (= a 1)))" (tx "(not (not (= a 1)))"))))

(deftest not-around-<=-translates
  (is (ok? "(not (<= a 1))"))
  (is (= "(not (<= a 1))" (tx "(not (<= a 1))"))))

(deftest not-true-false-translates
  (is (= "(not true)"  (tx "(not true)")))
  (is (= "(not false)" (tx "(not false)"))))

(deftest not-in-implication-translates
  ; `=>` desugars to (or (not X) Y): the antecedent's `not` is the scaffold's,
  ; the consequent's is the DIRECT remote lowering under test. Both must land.
  (is (ok? "(=> (> a 0) (not (= a 1)))"))
  (is (= "(or (not (> a 0)) (not (= a 1)))"
         (tx "(=> (> a 0) (not (= a 1)))"))))

(deftest not-in-short-circuit-translates
  (is (ok? "(and (not (= a 1)) (not (= a 2)))"))
  (is (= "(and (not (= a 1)) (not (= a 2)))"
         (tx "(and (not (= a 1)) (not (= a 2)))")))
  (is (= "(not (or (= a 1) (= a 2)))"
         (tx "(not (or (= a 1) (= a 2)))"))))

; ── and a SEMANTIC pin: the emitted form must MEAN negation, not merely exist ─

(deftest not-means-complement
  ; `(not (= a 1))` asserted with `(= a 1)` is UNSAT ⟹ z3 proves `not` is the
  ; exact complement. A translated-but-wrong term (or a dropped negation) fails.
  (let [port (z3/open)]
    (is (oracle/proven?
          (z3/check port
            (str "(declare-const a Int)\n"
                 "(assert " (tx "(not (= a 1))") ")\n"
                 "(assert (= a 1))\n"))))))

(deftest double-not-is-identity
  (let [port (z3/open)]
    (is (oracle/proven?
          (z3/check port
            (str "(declare-const a Int)\n"
                 "(assert (not (= " (tx "(not (not (= a 1)))") " (= a 1))))\n"))))))

(run-tests)
