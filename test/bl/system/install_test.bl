; test/bl/system/install_test.bl — the install verb's target table, and the
; gateway target specifically.
;
; WHY THIS FILE EXISTS: the gateway target's port-80 probe called
; `erlang/gen_tcp` (that is `:erlang.gen_tcp`, which does not exist), so the
; whole `--check` died with `function :erlang.gen_tcp/3 is undefined`. The
; gateway's own tests never touched it — they drive `bl gateway`, which probes
; no port. A check that is never run is a check that is never tested.
;
; Run: bl test test/bl/system/install_test.bl
(ns system.install-test
  (:require [bl.install :as install] [bl.util :as u] [env] [clojure.string :as str]))

(defn- capture [f]
  (let [prev (Process/group_leader)
        dev (erlang/element 2 (StringIO/open ""))]
    (Process/group_leader (erlang/self) dev)
    (let [r (try (f) (finally (Process/group_leader (erlang/self) prev)))]
      (list r (erlang/element 2 (StringIO/contents dev))))))

(defn- target [name] (get install/targets name))

(defn- check [name] (BeamLisp.RT/invoke (:check (target name)) (list nil)))

;; The verb's state is the PARSED argv — a map. Handing `run` an Elixir keyword
;; list instead makes `(:check st)` nil, so `--check` silently falls through to
;; the INSTALLER: the test would write a unit file and call it a check. Driving
;; parse-argv, the way the CLI does, is the only shape worth testing against.
(defn- argv-state [argv]
  (BeamLisp.RT/invoke (BeamLisp.Env/fetch! "bl.cli" "parse-argv") (list argv)))

(defn- step-named [steps n]
  (some (fn [s] (when (= n (:name s)) s)) (to-list steps)))

; ── the table ─────────────────────────────────────────────────────────

(deftest every-target-carries-a-summary-a-runner-and-a-check
  (is (some? (target "gateway")))
  (u/each
   (fn [name]
     (let [t (target name)]
       (is (string? (:summary t)) (str name " has a summary for the listing"))
       (is (some? (:run t)) (str name " knows how to install"))
       (is (some? (:check t)) (str name " knows how to verify"))))
   (keys install/targets)))

(deftest listing-with-no-target-names-them-and-succeeds
  (let [[code out] (capture (fn [] (install/run nil {})))]
    (is (= 0 code))
    (is (includes? out "bl install"))
    (u/each
     (fn [name] (is (includes? out (str name)) (str name " appears in the listing")))
     (keys install/targets))
    (is (includes? out "usage: bl install TARGET"))))

(deftest an-unknown-target-is-a-usage-error
  (let [[code _out] (capture (fn [] (install/run (list "nope") {})))]
    (is (= 2 code) "usage, not a runtime failure")))

; ── the gateway target ────────────────────────────────────────────────

(deftest the-port-80-probe-answers-with-a-reason-never-a-crash
  ;; The regression this file exists for: the probe CALLS the socket API, so a
  ;; typo in the module name is a raise and not a wrong answer. Whatever this
  ;; machine thinks of port 80, it must be one of the four known verdicts.
  (let [probe (BeamLisp.Env/fetch! "bl.install" "port-80-verdict")
        v (BeamLisp.RT/invoke probe (list))]
    (is (or (= :ok v) (= :eacces v) (= :eaddrinuse v) (= :error v))
        (str "a verdict, not a raise: " (pr-str v)))))

(deftest check-reports-the-unit-the-service-and-the-port
  (let [steps (check "gateway")]
    (is (= 3 (count (to-list steps))))
    (u/each
     (fn [n] (is (some? (step-named steps n)) (str "the report names " n)))
     (list "unit" "gateway" "port 80"))
    (u/each
     (fn [s]
       (is (or (= true (:ok s)) (= false (:ok s))) (str (:name s) " answers yes or no"))
       (is (string? (:detail s)) (str (:name s) " says why")))
     (to-list steps))
    ;; the port-80 step carries the ONE root step when it is privileged — the
    ;; thing a developer reading the report has to be able to act on
    (let [p (step-named steps "port 80")]
      (is (or (:ok p) (includes? (:detail p) "ip_unprivileged_port_start"))))))

(deftest --check-writes-nothing-and-reports-one-line-per-step
  ;; A check that installed something would be an install. HOME is redirected
  ;; to a scratch directory so "the unit is absent" is a fact of this test and
  ;; not of the machine it runs on.
  (let [home (str (System/tmp_dir!) "/bl_install_check_" (erlang/unique_integer (list :positive)))
        prev (System/get_env "XDG_CONFIG_HOME")]
    (System/put_env "XDG_CONFIG_HOME" home)
    (try
      (let [[code out] (capture (fn [] (install/run (list "gateway") (argv-state (list "install" "gateway" "--check")))))]
        (is (or (= 0 code) (= 1 code)) (str "0 = every step ok, 1 = one did not; got " code))
        (is (includes? out "bl install gateway"))
        (u/each
         (fn [n] (is (includes? out n) (str "the report renders " n)))
         (list "unit" "gateway" "port 80"))
        (is (not (File/exists? (str home "/systemd/user/bl-gateway.service")))
            "checking does not write the unit"))
      (finally
        (if (nil? prev)
          (System/delete_env "XDG_CONFIG_HOME")
          (System/put_env "XDG_CONFIG_HOME" prev))))))

; ── the redirect target ───────────────────────────────────────────────
;
; `bl install redirect` gives names a portless address without privilege: a
; loopback redirect of port 80 to the gateway, plus a system unit that
; reapplies it at boot. Only root can install either, so what is tested here is
; everything up to that line — the text we install and the script that does it
; — plus the verdict we report afterwards, which must be the LIVE answer (does
; port 80 reach the gateway?) and never an assumption about a file we wrote.

(deftest the-ruleset-redirects-loopback-80-to-the-gateway-port-and-nothing-else
  (let [rules (install/redirect-rules 7777)]
    (is (includes? rules "table ip bl_gateway_redirect"))
    (is (includes? rules "table ip6 bl_gateway_redirect")
        "the v6 half: *.localhost resolves to ::1")
    (is (includes? rules "ip daddr 127.0.0.0/8 tcp dport 80 redirect to :7777"))
    (is (includes? rules "ip6 daddr ::1 tcp dport 80 redirect to :7777"))
    ;; Our OWN tables and loopback DESTINATIONS only: a LAN client, or a service
    ;; on a real address, is never rewritten by this.
    (is (not (includes? rules "oifname")))
    (is (not (includes? rules "0.0.0.0/0")))))

(deftest the-install-script-installs-ours-and-removes-ours
  (let [script (install/install-script "/tmp/stage")
        rm (install/remove-script)]
    (is (includes? script "install -D -m644 /tmp/stage/redirect.nft /etc/bl-gateway-redirect.nft"))
    (is (includes? script "nft -f /etc/bl-gateway-redirect.nft"))
    (is (includes? script "systemctl enable --now bl-gateway-redirect.service"))
    ;; Idempotent by construction: dropping our own tables first is what makes a
    ;; second run a no-op instead of `table already exists`.
    (is (includes? script "nft delete table ip bl_gateway_redirect"))
    (is (includes? script "nft delete table ip6 bl_gateway_redirect"))
    (is (includes? rm "systemctl disable --now bl-gateway-redirect.service"))
    (is (includes? rm "rm -f /etc/bl-gateway-redirect.nft /etc/systemd/system/bl-gateway-redirect.service"))
    ;; Neither script ever touches a table it did not create.
    (is (not (includes? rm "flush")))
    (is (not (includes? script "flush")))))

(deftest the-unit-reapplies-the-ruleset-at-boot
  (let [unit (install/redirect-unit-text "/etc/bl-gateway-redirect.nft")]
    (is (includes? unit "ExecStart=/usr/bin/nft -f /etc/bl-gateway-redirect.nft"))
    (is (includes? unit "Type=oneshot"))
    (is (includes? unit "WantedBy=multi-user.target"))))

(deftest check-redirect-answers-the-live-question
  (let [steps (to-list (check "redirect"))
        p (step-named steps "port 80")]
    (is (= 3 (count steps)))
    (u/each
     (fn [n] (is (some? (step-named steps n)) (str "the report names " n)))
     (list "port 80" "ruleset file" "unit"))
    ;; The verdict is the PROBE, not a file: if the redirect is gone the report
    ;; must say so, even with /etc still holding the ruleset.
    (is (= (BeamLisp.Daemon.Gateway/ours_on? 80) (:ok p))
        "the port-80 step is the live answer")
    (is (string? (:detail p)))))

(deftest the-port-80-report-names-what-is-actually-there
  ;; Three sentences out of one probe. The `:other` one is the reason the probe
  ;; kept its third case: when a server already holds port 80, the redirect does
  ;; not open a free port — it takes loopback 80 away from that server — and the
  ;; report has to say so BEFORE handing the paste over, not after.
  (let [step (BeamLisp.Env/fetch! "bl.install" "port-80-step")
        render (fn [state] (BeamLisp.RT/invoke step (list state "the gateway answers here")))
        mine (render :ours)
        other (render :other)
        closed (render :closed)]
    (is (:ok mine) ":ours is the answered state")
    (is (= "the gateway answers here" (:detail mine)) "the caller supplies its own ours line")
    (is (not (:ok other)) ":other is not an answer for us")
    (is (includes? (:detail other) "something else answers"))
    (is (includes? (:detail other) "including requests to whatever is there now")
        "the redirect's cost is stated, not implied")
    (is (not (:ok closed)))
    (is (includes? (:detail closed) "bl install redirect"))))


; ── the mcp target ────────────────────────────────────────────────────
;
; `bl install mcp` is a table of AGENTS (claude, pi), and what can go wrong
; in a table is invisible from the happy path: a detection branch no test
; enters, a config merge that eats a neighbour's server, a skill whose examples
; stopped being true. So detection is driven through an INJECTED context — a
; scratch dir, a scratch home, a stub PATH — and the config writers through
; fixture files. Those are the target's two seams.
;
; The regression this section exists for, one release after the generator bug:
; the config writers asked `clojure.string/index-of` for a position and compared
; it against -1. It answers NIL. The happy path never noticed, because a fresh
; file takes the "no mcp node, append" branch — only a file that ALREADY had an
; mcp node reached the arithmetic, and only there did it raise.

(defn- fresh-dir [tag]
  (let [d (str (System/tmp_dir!) "/bl_install_" tag "_"
               (erlang/unique_integer (list :positive)))]
    (File/mkdir_p d)
    d))

(defn- call
  "Invoke a FUNCTION def of `ns-name` by name — the seam these tests drive.
   A def that is a VALUE (a name, a version) is read with `fetch!` instead:
   `fetch!` answers the value, and a value is not callable."
  [ns-name fn-name & args]
  (BeamLisp.Loader/ensure_loaded ns-name)
  (BeamLisp.RT/invoke (BeamLisp.Env/fetch! ns-name fn-name) (to-list args)))

(defn- mcp-ctx
  "A context for `dir` with the ambient machine taken OUT of it: a scratch
   home and a PATH that finds nothing. Detection is a function of this map, so
   a test can be the whole machine."
  [dir home]
  {:dir dir :home home :which (fn [_] nil)})

(defn- all-ok-steps? [steps]
  (empty? (filter (fn [s] (not (:ok s))) (to-list steps))))

(deftest every-agent-descriptor-carries-what-the-table-needs
  (let [agents (to-list install/agents)]
    (is (>= (count agents) 2) "at least claude and pi")
    (u/each
     (fn [a]
       (u/each
        (fn [k] (is (some? (get a k)) (str (get a "name") " carries " k)))
        (list "name" "root" "detect" "register" "registered?")))
     agents)))

(deftest detection-reports-what-it-saw-and-nothing-more
  ;; the project's own marker is the first evidence, and it IS the path reported
  (let [dir (fresh-dir "proj") home (fresh-dir "home")]
    (File/mkdir_p (str dir "/.claude"))
    (File/mkdir_p (str dir "/.spell"))
    (is (= (str dir "/.claude") (call "bl.install" "claude-here" (mcp-ctx dir home))))
    (is (= (str dir "/.spell") (call "bl.install" "pi-here" (mcp-ctx dir home)))))
  ;; the user's config next...
  (let [dir (fresh-dir "proj2") home (fresh-dir "home2")]
    (File/write! (str home "/.claude.json") "{}\n")
    (is (= (str home "/.claude.json") (call "bl.install" "claude-here" (mcp-ctx dir home)))))
  ;; ...a spell.kdl in the project counts as a project marker
  (let [dir (fresh-dir "proj3") home (fresh-dir "home3")]
    (File/write! (str dir "/spell.kdl") "mcp {\n}\n")
    (is (= (str dir "/spell.kdl") (call "bl.install" "pi-here" (mcp-ctx dir home)))))
  ;; ...and a binary on PATH is LAST: a client that never visits this tree is
  ;; not a reason to configure it here
  (let [dir (fresh-dir "proj4") home (fresh-dir "home4")
        on-path {:dir dir :home home
                 :which (fn [n] (if (= n "claude") "/usr/bin/claude" nil))}]
    (is (includes? (call "bl.install" "claude-here" on-path) "/usr/bin/claude")))
  ;; none of the three, and nothing is claimed
  (let [dir (fresh-dir "proj5") home (fresh-dir "home5")]
    (is (nil? (call "bl.install" "claude-here" (mcp-ctx dir home))))
    (is (nil? (call "bl.install" "pi-here" (mcp-ctx dir home))))))

(deftest the-brace-scan-counts-braces-and-skips-text
  (let [text "mcp {\n\t// a }\n\tserver \"x\" type=\"http\" {\n\t\turl \"http://a/b\"\n\t}\n}\n"
        open (call "bl.install" "mcp-block-open" text)
        close (call "bl.install" "block-end" text open)]
    (is (= 4 open) "the mcp node's own brace")
    (is (= (- (count text) 2) close)
        "the LAST brace: the comment's and the string's are text")
    (is (= "" (call "bl.install" "line-indent" text open)))
    (is (= "\t" (call "bl.install" "line-indent" text (+ open 2)))))
  ;; a file with no mcp node answers nil rather than guessing
  (is (nil? (call "bl.install" "mcp-block-open" "# a file\nfoo {\n}\n")))
  ;; a node that never closes is nil, so the caller reports instead of truncating
  (is (nil? (call "bl.install" "block-end" "mcp {" 4))))

(deftest the-spell-config-is-extended-never-replaced
  (let [dir (fresh-dir "kdl")
        ctx (mcp-ctx dir (fresh-dir "kdlhome"))
        path (str dir "/spell.kdl")]
    ;; no file at all: the whole node is written
    (is (contains? (call "bl.install" "pi-register" ctx) :wrote))
    (let [text (File/read! path)]
      (is (includes? text (str "server \"" install/mcp-server-name "\"")))
      (is (includes? text "command \"bl\"")))
    ;; a second install changes nothing
    (let [before (File/read! path)]
      (is (= :already (call "bl.install" "pi-register" ctx)))
      (is (= before (File/read! path))))
    ;; a file with its own mcp node keeps its own servers, and ours lands
    ;; INSIDE that node — after the one already there
    (File/write! path
                 "// a project file\nmcp {\n\tserver \"tidewave\" type=\"http\" {\n\t\turl \"http://x/y\"\n\t}\n}\n")
    (is (contains? (call "bl.install" "pi-register" ctx) :wrote))
    (let [text (File/read! path)]
      (is (includes? text "server \"tidewave\""))
      (is (includes? text (str "server \"" install/mcp-server-name "\"")))
      (is (< (str/index-of text "tidewave") (str/index-of text install/mcp-server-name))
          "ours goes after theirs, inside the node")
      (is (includes? text "// a project file") "the file's own prose survives"))
    (is (call "bl.install" "pi-registered?" ctx))))

(deftest the-claude-config-merges-and-refuses-garbage
  (let [dir (fresh-dir "mcpjson")
        ctx (mcp-ctx dir (fresh-dir "jsonhome"))
        path (str dir "/.mcp.json")]
    (is (contains? (call "bl.install" "claude-register" ctx) :wrote))
    (is (call "bl.install" "claude-registered?" ctx))
    (let [servers (get (Jason/decode! (File/read! path)) "mcpServers")]
      (is (= "bl" (get (get servers install/mcp-server-name) "command"))))
    (is (= :already (call "bl.install" "claude-register" ctx)) "a second install is a no-op")
    ;; a neighbour's server survives
    (File/write! path "{\"mcpServers\":{\"other\":{\"command\":\"other\"}}}\n")
    (call "bl.install" "claude-register" ctx)
    (let [servers (get (Jason/decode! (File/read! path)) "mcpServers")]
      (is (some? (get servers "other")))
      (is (some? (get servers install/mcp-server-name))))
    ;; a file that does not parse is REPORTED, never overwritten
    (File/write! path "{not json")
    (is (contains? (call "bl.install" "claude-register" ctx) :error))
    (is (= "{not json" (File/read! path)) "an unreadable config is left alone")))

(deftest the-skill-is-the-corpus-with-a-release-tag
  (let [dir (fresh-dir "skill")
        d (call "mcp.skill" "db")
        paths (to-list (call "mcp.skill" "write!" dir d))
        skill (BeamLisp.Env/fetch! "mcp.skill" "skill-name")]
    (is (= 4 (count paths)) "SKILL.md and the three .bl.md references")
    (u/each (fn [p] (is (File/regular? p) (str p " exists"))) paths)
    (let [head (File/read! (str dir "/SKILL.md"))]
      (is (includes? head (str "name: " skill)))
      (is (includes? head "description: ")
          "the native loader needs one to show the skill at all")
      (is (includes? head (str "version: " (u/version)))
          "the release tag is what makes a stale skill answerable"))
    ;; the supporting files are literate, not markdown in a costume
    (is (includes? (File/read! (str dir "/modules.bl.md")) "```beam-lisp"))
    (is (includes? (File/read! (str dir "/usage.bl.md")) "```beam-lisp"))))

(deftest every-cell-in-the-skill-corpus-runs
  ;; `:instr/code` is a form, not a quotation of one: an idiom in the module
  ;; index that stops being true fails HERE instead of misleading a reader.
  (let [d (call "mcp.skill" "db")
        cells (into []
                    (mapcat
                     (fn [kind]
                       (keep (fn [f] (:code f))
                             (call "mcp.instructions" "fragments" d "skill" kind)))
                     (list :onboarding :modules :usage :protocol)))]
    (is (>= (count cells) 7) "the module index carries one per module")
    (u/each
     (fn [code]
       (is (some? (env/eval
                   (str "(ns skill-cell (:require [datom] [codebase] [web] [auth]"
                        " [live] [deodorant] [veritas]))\n" code)))
           (str "a cell runs: " (first (String/split code "\n")))))
     cells)))

(deftest staleness-is-answerable-without-rendering
  (let [dir (fresh-dir "stale")]
    (is (= :absent (call "mcp.skill" "stale?" dir)))
    (File/write! (str dir "/SKILL.md") "---\nname: beam-lisp\nversion: 1999.1.0\n---\n")
    (is (= :stale (call "mcp.skill" "stale?" dir)))
    (File/write! (str dir "/SKILL.md") (str "---\nversion: " (u/version) "\n---\n"))
    (is (= :current (call "mcp.skill" "stale?" dir)))
    ;; a skill with no version cannot say what it describes, so it is not trusted
    (File/write! (str dir "/SKILL.md") "---\nname: beam-lisp\n---\n")
    (is (= :stale (call "mcp.skill" "stale?" dir)))))

(deftest install-mcp-writes-both-halves-for-every-agent-it-found
  (let [dir (fresh-dir "e2e")
        found (to-list (call "bl.install" "found-agents" (call "bl.install" "ctx" dir)))]
    (is (not (empty? found)) "this machine has at least one client")
    (let [[code out] (capture (fn [] (install/run (list "mcp" dir)
                                                 (argv-state (list "install" "mcp" dir)))))]
      (is (= 0 code) "every step ok on a machine that has a client")
      (is (includes? out "found — "))
      (u/each
       (fn [pair]
         (let [a (first pair)]
           (is (File/regular? (str dir "/" (get a "root") "/skills/beam-lisp/SKILL.md"))
               (str (get a "name") " got the skill"))))
       found))
    ;; the check agrees with what the install just wrote...
    (is (all-ok-steps? (call "bl.install" "check-mcp" dir)))
    ;; ...and an empty project is reported as empty, not assumed fine
    (let [bare (fresh-dir "e2e-bare")]
      (File/mkdir_p (str bare "/.claude"))
      (is (not (all-ok-steps? (call "bl.install" "check-mcp" bare)))
          "an absent skill is a failed check"))))

(deftest --remove-parses-and-a-target-with-nothing-to-remove-is-a-usage-error
  (is (:remove (argv-state (list "install" "redirect" "--remove"))))
  (is (:remove (install/targets "redirect")) "the redirect target knows how to undo itself")
  (let [[code _out] (capture (fn [] (install/run (list "gateway")
                                                 (argv-state (list "install" "gateway" "--remove")))))]
    (is (= 2 code) "2 = you asked for a removal that does not exist")))


; The grammar dir, through the one seam that decides which machine it runs on:
; `home` is an argument, so a scratch directory IS the machine. A fresh Doom
; install has no grammar directory — Emacs makes that directory only when you
; run `treesit-install-language-grammar` — so the install has to be able to
; make one, and `--check` has to keep its hands off.
(deftest grammar-dir-makes-one-only-when-an-emacs-is-there-to-make-it-for
  (let [bare (fresh-dir "grammar-bare")          ; no Emacs at all
        emacs (fresh-dir "grammar-emacs")]       ; an Emacs, no grammar dir yet
    (File/mkdir_p (str emacs "/.config/emacs"))
    ;; nothing to make it for
    (is (nil? (call "bl.install" "grammar-dir" bare true)))
    (is (not (File/exists? (str bare "/.config/emacs"))))
    ;; a check asks, and writes nothing
    (is (nil? (call "bl.install" "grammar-dir" emacs false)))
    (is (not (File/exists? (str emacs "/.config/emacs/.local/etc/tree-sitter"))))
    ;; an install makes the directory this profile uses
    (is (= (str emacs "/.config/emacs/.local/etc/tree-sitter")
           (call "bl.install" "grammar-dir" emacs true)))
    (is (File/dir? (str emacs "/.config/emacs/.local/etc/tree-sitter")))
    ;; a directory that is already there wins, wherever it sits in the order
    (let [legacy (fresh-dir "grammar-legacy")]
      (File/mkdir_p (str legacy "/.emacs.d/tree-sitter"))
      (is (= (str legacy "/.emacs.d/tree-sitter")
             (call "bl.install" "grammar-dir" legacy false))))))

