; test/bl/system/doctor_test.bl — the environment report.
;
; bl.doctor asks the host what it can do, one probe at a time, and never lets a
; missing native become a crash. These tests pin the shape of a probe, the one
; fact this checkout cannot lack, and the table a reader reads.
;
; Run: mix bl test test/bl/system/doctor_test.bl
(ns system.doctor-test
  (:require [bl.cli :as cli]
            [bl.doctor :as v]))

(defn- probe-named [name ps]
  (first (filter (fn [p] (= name (:name p))) ps)))

(deftest probes-carry-name-ok-and-detail
  (let [ps (v/probes)]
    (is (>= (count ps) 8) "every environment fact is one line of the report")
    (is (empty?
          (filter (fn [p]
                    (not (and (string? (:name p))
                              (or (= true (:ok p)) (= false (:ok p)))
                              (string? (:detail p))
                              (or (= true (:required p)) (= false (:required p))))))
                  ps))
        "each probe carries a string :name, a boolean :ok, a string :detail")))

(deftest the-language-probe-passes-and-is-required
  (let [p (probe-named "language" (v/probes))]
    (is (some? p) "the language probe is always present")
    (is (:ok p) "a working eval is what makes this beam-lisp")
    (is (:required p) "and its failure is a broken build, not a missing native")))

(deftest the-native-probes-answer-instead-of-raising
  ;; A NIF that did not load reads as ok=false with its reason; it never
  ;; escapes as an exception, and every native probe still reports a detail.
  (let [nat (filter (fn [p] (contains? #{"datom_fjall" "explorer" "lazy_memo" "z3" "wry"}
                                       (:name p)))
                    (v/probes))]
    (is (= 5 (count nat)) "every native tier is probed")
    (is (empty? (filter (fn [p] (not (string? (:detail p)))) nat))
        "an absent native still reports why")))

(deftest render-prints-a-table-and-a-verdict
  (let [text (v/render {:ok true :probes (v/probes)})]
    (is (includes? text "beam-lisp doctor"))
    (is (includes? text "language"))
    (is (includes? text "otp"))
    (is (includes? text "ok   ") "a passing probe reads `ok` in the first column")
    (is (includes? text "required probes ok") "the verdict line names the gate")))

(deftest render-marks-an-absent-optional-with-dashes
  (let [text (v/render {:ok true
                        :probes [{:name "wry" :ok false :detail "absent (optional)" :required false}]})]
    (is (includes? text "--   wry") "an absent optional reads `--`, never a crash")))

(deftest run-exits-zero-when-the-required-probes-pass
  (let [st (cli/parse-argv (list "doctor" "--json"))]
    (is (= 0 (v/run (list) st)) "this checkout has a working language and fast lane")))

(deftest run-rejects-a-positional
  (let [st (cli/parse-argv (list "doctor" "extra"))]
    (is (= 2 (v/run (list "extra") st)) "doctor takes flags only")))

; ── the deep half: the TOOLCHAIN's facts ─────────────────────────────────
;
; `--deep` answers a different question from the table above, and the assertions
; below are about the RULE rather than this machine's answer: whether Mix is
; loaded here is a fact the probe reads, and the same probe must read it the same
; way in a drop. That is why `the-mix-probe` compares the probe against a second
; observation instead of asserting a constant — a test that hard-codes "absent"
; would pass here and lie in an image where it is not.

(deftest the-mix-probe-answers-the-truth-about-this-vm
  (let [mix (probe-named "mix" (v/deep-probes))]
    (is (some? mix) "the toolchain report always names Mix")
    (is (:required mix) "and its answer is the point of --deep: absent is a PASS")
    (is (= (not (Enum/any? (Application/started_applications)
                           (fn [t] (= :mix (erlang/element 1 t)))))
           (:ok mix))
        "a PASS means Mix is absent, and the detail says which it found")))

(deftest residue-is-reported-and-not-required
  (let [p (probe-named "mix-residue" (v/deep-probes))]
    (is (string? (:detail p)))
    (is (not (:required p))
        "mix.exs/mix.lock/deps cannot be deleted until a locked library compiles without Mix (FUP-050) — a required probe this tree cannot pass would lie about it")))

(deftest the-store-probe-reads-the-lock-and-the-store
  (let [p (probe-named "store" (v/deep-probes))]
    (is (includes? (:detail p) "locked")
        (str "the store probe answers against the lock, missing library or not: " (:detail p)))))

(deftest the-seed-probe-names-the-toolchain-that-built-the-floor
  (let [p (probe-named "seed" (v/deep-probes))]
    (is (some? (BeamLisp.Bootstrap/manifest)) "this checkout ships a bootstrap floor")
    (is (includes? (:detail p) "beams"))))

(deftest the-image-probe-asks-the-one-implementation
  (let [p (probe-named "image" (v/deep-probes))]
    (is (:ok p))
    (is (includes? (:detail p) (BeamLisp.Image/kind))
        "the report quotes the rule, not a second opinion about it")))

(deftest deep-run-exits-zero-exactly-when-mix-is-absent
  ;; Under `bl` Mix is not RUNNING and this is green — which is the claim the wave
  ;; makes. Under `mix test` Mix IS running, and then 1 is the honest answer: the
  ;; image depends on it. Either way the code follows the probe.
  (let [st (cli/parse-argv (list "doctor" "--deep"))
        code (v/run (list) st)
        started? (Enum/any? (Application/started_applications)
                            (fn [t] (= :mix (erlang/element 1 t))))]
    (is (= (if started? 1 0) code))))

(deftest render-names-the-question-that-was-asked
  (is (includes? (v/render {:ok true :deep true :probes (v/probes)})
                 "beam-lisp doctor --deep"))
  (is (not (includes? (v/render {:ok true :probes (v/probes)}) "--deep"))
      "the shallow report stays shallow"))
