(ns system.incremental-evidence-test
  (:require [system.incr :as incr] [system.analyze :as analyze]))

(defn semantic-summaries [summaries]
  ;; Compiler gensym names in [:flow var] are incidental; resolved edges and
  ;; all effect/return/termination/latent evidence must remain identical.
  (into {} (map (fn [[n s]] [n (update s :calls (fn [calls]
                     (set (map (fn [k] (if (and (vector? k) (= :flow (first k))) :flow k)) calls))))]) summaries)))

(deftest hash-equality-is-not-identity-equality
  (let [a "(defn pick [a b] a)" b "(defn pick [a b] b)"
        first (incr/analyze-incremental {} a)
        desired (incr/fn-hash (get (analyze/fn-bodies b) "pick"))
        forged (assoc-in (:cache first) ["pick" :hash] desired)
        next (incr/analyze-incremental forged b)]
    (is (= ["pick"] (:misses next)))
    (is (= [] (:hits next)))))

(deftest local-evidence-is-generation-bound
  (let [src "(defn leaf [] 1)" first (incr/analyze-incremental {} src)
        stale (assoc-in (:cache first) ["leaf" :generation] :previous-toolchain)]
    (is (= ["leaf"] (:misses (incr/analyze-incremental stale src))))))

(deftest whole-program-edits-match-authoritative-analysis
  (let [versions ["(defn leaf [] 1) (defn mid [] (leaf)) (defn entry [] (mid)) (defn other [] true)"
                  "(defn leaf [] \"new\") (defn mid [] (leaf)) (defn entry [] (mid)) (defn other [] true)"
                  "(defn mid [] (leaf)) (defn entry [] (mid)) (defn other [] true)"
                  "(defn leaf [] 2) (defn mid [] (leaf)) (defn entry [] (mid)) (defn other [] true)"]]
    (loop [xs versions cache {}]
      (when (seq xs)
        (let [src (first xs) r (incr/analyze-program cache src)]
          (is (= (analyze/analyze src) (:summaries r)))
          (when (seq cache) (is (some (fn [n] (= "other" n)) (:hits r))))
          (recur (rest xs) (:cache r)))))))

(deftest function-values-and-unknown-callbacks-are-not-missing-dependencies
  (let [a "(defn leaf [] 1) (defn value [] leaf) (defn entry [f] (f))"
        b "(defn leaf [] (io/format \"changed\" [])) (defn value [] leaf) (defn entry [f] (f))"
        r1 (incr/analyze-program {} a) r2 (incr/analyze-program (:cache r1) b)]
    (is (contains? (:dirty r2) "value"))
    (is (= (semantic-summaries (analyze/analyze b)) (semantic-summaries (:summaries r2))))
    ;; This analysis explicitly assumes supplier-owned effects for callbacks.
    ;; A consumer must still refuse unresolved flow as unconditional evidence.
    (is (some (fn [k] (and (vector? k) (= :flow (first k))))
              (:calls (get (:summaries r2) "entry"))))))

(deftest recursion-and-later-clause-edits-match-full-fixpoint
  (let [a "(defn a [x] (if x (b false) 1)) (defn b [x] (if x (a false) 2)) (defn multi ([] 0) ([x] (a x)))"
        b "(defn a [x] (if x (b false) \"s\")) (defn b [x] (if x (a false) 2)) (defn multi ([] 0) ([x] (a x)))"
        r1 (incr/analyze-program {} a) r2 (incr/analyze-program (:cache r1) b)]
    (is (= (analyze/analyze b) (:summaries r2)))
    (is (every? (fn [n] (contains? (:dirty r2) n)) ["a" "b" "multi"]))))
