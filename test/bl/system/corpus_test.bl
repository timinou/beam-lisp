; test/bl/system/corpus_test.bl — the corpus walker, pinned by observation.
;
; `priv/lib/z3corpus.bl` finds every `defserver` in a tree of `.bl` files and asks
; `system.core/verify-process` about each. The things that can go wrong are all
; silent, so each is pinned by a measurement rather than a comment:
;
;   1. THE WALK SEES EVERY SHAPE. A machine is a plain form, a STRING literal, or
;      a `^{:invariant …}` METADATA-wrapped form. A walker that matches only bare
;      top-level lists found 4 machines over 104 files and was deleted; the
;      fixture below holds one of each, and all three must be found.
;   2. THE FILTER IS A GUARD. Reading a `.md` as source KILLS the VM (rc=141, no
;      diagnostic). The fixture plants one, and the run must survive it.
;   3. FOUR OUTCOMES, NOT TWO. proved / refuted / undecided / declined are
;      distinct; a live machine (no invariant) is DECLINED, not "proven".
;   4. DETERMINISM. Two runs over the same input give the same outcome column.
;   5. THE ANTI-ZERO BOUND. On the real corpus the machine count must reach an
;      independent, text-level grep bound — a cheerful zero cannot.
;
; Run: bl test test/bl/system/corpus_test.bl

(ns system.corpus-test
  (:require [z3corpus :as cor]
            [z3]
            [oracle]
            [system.core :as sys]
            [system.decide :as decide]))

(defn- read1 [s] (first (vec (BeamLisp.Reader/read_string s))))

(defn- tmp-root []
  (str (System/tmp_dir!) "/bl_corpus_" (erlang/unique_integer (list :positive))))

(defn- with-tmp [f]
  (let [root (tmp-root)]
    (try (File/mkdir_p! root) (f root) (finally (File/rm_rf! root)))))

;; ── the fixture sources ─────────────────────────────────────────────────────

(def plain-src
  "(defserver plain
     (init [x] (ok x))
     (handle-call [:get] [_ x] (reply :ok x)))")

(def annotated-src
  "(defserver ^{:invariant (>= balance 0)} acct
     (init [balance] (ok balance))
     (handle-call [:deposit amt] [_ balance] :when (>= amt 0)
       (reply :ok (+ balance amt))))")

(def quoted-src
  "(def quoted \"(defserver ^{:invariant (>= n 0)} qm
       (init [n] (ok n))
       (handle-call [:inc k] [_ n] :when (>= k 0) (reply :ok (+ n k))))\")")

(def hostile-md
  (str "# notes\n\n"
       "A machine reads `(defserver account \"unterminated\n\n"
       "and the rest is prose\n"))

(defn- plant! [root]
  (File/write! (str root "/plain.bl") (str plain-src "\n"))
  (File/write! (str root "/annotated.bl") (str annotated-src "\n"))
  (File/write! (str root "/quoted.bl") (str quoted-src "\n"))
  (File/write! (str root "/notes.md") hostile-md))

(defn- names-of [r] (vec (sort (vec (map (fn [m] (:name m)) (:machines r))))))

;; ── 1 & 2: every shape, and the .md survives ────────────────────────────────

(deftest the-walk-finds-every-machine-shape
  (z3/pool! 2)
  (with-tmp
    (fn [root]
      (plant! root)
      (let [fs (cor/files (list root))
            r (cor/corpus (list root))]
        (is (= 3 (count fs)) "only the three .bl files are walked, never the .md")
        (is (every? (fn [p] (String/ends_with? p ".bl")) fs) "every file is .bl")
        (is (= 3 (:files r)) "the report counts the same three files")
        (is (= ["acct" "plain" "qm"] (names-of r))
            "plain form + metadata-wrapped + string-literal machine — all three")
        (is (empty? (:unreadable r)) "nothing unreadable")
        (is (empty? (:failures r)) "and no string re-read threw")))))

(deftest a-markdown-file-is-not-even-opened
  (with-tmp
    (fn [root]
      (plant! root)
      (is (not (cor/bl-file? (str root "/notes.md"))) "the filter rejects .md")
      (is (not (some (fn [p] (String/ends_with? p ".md")) (cor/files (list root))))
          "and .md never reaches the file list, so it is never handed to the reader"))))

;; ── 3: the four outcomes ────────────────────────────────────────────────────

(deftest the-four-outcomes-are-distinguished
  ;; unit: the mapping from the engine's result map to the outcome column
  (is (= :proven (cor/outcome {:checked true :holds true})))
  (is (= :refuted (cor/outcome {:checked true :holds false :undecided []})))
  (is (= :undecided (cor/outcome {:checked true :holds false :undecided [:t]})))
  (is (= :declined (cor/outcome {:checked false :holds nil})))
  (is (= :error (cor/outcome {:error "boom"})) "a throw is its own outcome, not a decline"))

(deftest a-live-machine-is-declined
  ;; end to end: a machine with no invariant is DECLINED by the engine — not
  ;; "proven", and not an error. This is the fourth outcome the report needs.
  (z3/pool! 2)
  (is (= :declined (cor/outcome (sys/verify-process (z3/open) (read1 plain-src)))))
  (is (= :proven (cor/outcome (sys/verify-process (z3/open) (read1 annotated-src))))))

(deftest an-undecided-machine-is-neither-proven-nor-refuted
  ;; The engine's third answer made deterministic: with the oracle handled by a
  ;; table that always says `unknown`, every step is undecided — so the verdict is
  ;; `:undecided`, and it must not read as either a proof or a refutation.
  (oracle/memo-clear!)
  (let [unknown (fn [_text _model?] {:status "unknown" :model nil :core nil})
        r (oracle/with-oracle unknown
            (fn [] (sys/verify-process (z3/open) (read1 annotated-src))))]
    (is (= :undecided (cor/outcome r)))
    (is (not (:holds r)) "an undecided machine does not hold")
    (is (seq (:undecided r)) "and the undecided transitions are named")))

;; ── 4: determinism ──────────────────────────────────────────────────────────

(deftest two-runs-give-the-same-outcome-column
  (z3/pool! 2)
  (with-tmp
    (fn [root]
      (plant! root)
      (let [r1 (cor/corpus (list root))
            r2 (cor/corpus (list root))]
        (is (= (names-of r1) (names-of r2)) "the same machines, in the same order")
        (is (= (vec (map (fn [m] (:outcome m)) (:machines r1)))
               (vec (map (fn [m] (:outcome m)) (:machines r2))))
            "and the same outcome for each")))))

;; ── 5: the anti-zero bound over the real corpus ─────────────────────────────

(deftest the-corpus-count-reaches-the-grep-bound
  (z3/pool! 4)
  (decide/reset-ledger!)
  (let [dirs (list "priv" "examples")
        bound (cor/grep-bound dirs "defserver")
        r (cor/corpus dirs)
        measured (count (:machines r))]
    (is (< 0 bound) "the bound is a real count, not a vacuous zero")
    (is (empty? (:unreadable r)) "no .bl file in the tree is unreadable")
    (is (<= bound measured)
        (str "walker found " measured " machines, below the grep bound " bound)))) 
