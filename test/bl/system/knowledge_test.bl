; test/bl/system/knowledge_test.bl — the composition flywheel (P20).
;
; Every process guarantee projected into one datom relation, so cross-cutting
; questions are datalog joins. These check the projectors reproduce their source
; capability and the cross-cutting queries answer what no single check can.

(ns system.knowledge-test
  (:require [system.knowledge :as k] [datom]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- mk-conn [schema] (datom/connect schema))
(defn- transact [conn fs] (datom/transact! conn fs))
(defn- q-fn [db query & args] (apply datom/q query db args))

(def account
  "(defserver ^{:invariant (>= balance 0)} account
     (init [] (ok {:balance 100}))
     (handle-call [:withdraw amt] [_ {:keys [balance]}] :when (>= balance amt)
       (reply :ok {:balance (- balance amt)}))
     (handle-call [:deposit amt] [_ {:keys [balance]}]
       (reply :ok {:balance (+ balance amt)})))")

(def ledger
  "(defserver ledger
     (init [] (ok {:count 0}))
     (handle-cast [:log entry] [_ {:keys [count]}]
       (noreply {:count (+ count 1)})))")

(def sends
  [["client" "account" :withdraw]
   ["client" "account" :deposit]
   ["client" "account" :close]
   ["client" "ledger"  :log]])

(defn- kdb []
  (datom/db (k/knowledge [(read1 account) (read1 ledger)] sends mk-conn transact)))

; ── projectors reproduce their source ────────────────────────────────────

(deftest knowledge-projects-invariants
  (let [inv (k/processes-with-invariant (kdb) q-fn)]
    (is (= 1 (count inv)) "one process carries an invariant (account; ledger has none)")
    (is (= "(>= balance 0)" (:invariant (first inv))) "account's invariant is projected verbatim")))

; ── cross-cutting: guarded sends ─────────────────────────────────────────

(deftest knowledge-finds-guarded-sends
  (let [g (k/guarded-sends (kdb) q-fn)]
    (is (= 1 (count g)) "one send hits a guarded handler")
    (is (= :withdraw (:label (first g))) "it is :withdraw")
    (is (= "(>= balance amt)" (:guard (first g))) "with its guard precondition")))

; ── cross-cutting: dropped sends (anti-join) ─────────────────────────────

(deftest knowledge-finds-unhandled-sends
  (let [u (k/unhandled-sends (kdb) q-fn)]
    (is (= 1 (count u)) "one send is dropped")
    (is (= :close (:label (first u))) ":close is sent to account, which has no :close handler")))

(deftest knowledge-does-not-flag-handled-sends-as-dropped
  (let [dropped (into #{} (map :label (k/unhandled-sends (kdb) q-fn)))]
    (is (not (contains? dropped :deposit)) ":deposit IS handled → not dropped")
    (is (not (contains? dropped :log)) ":log is handled by ledger → not dropped")))

; ── the composition: send × guard × receiver invariant ───────────────────

(deftest knowledge-composition-links-send-guard-invariant
  (let [x (k/invariant-bearing-guarded-sends (kdb) q-fn)]
    (is (= 1 (count x)) "one send could break a downstream invariant")
    (let [w (first x)]
      (is (= :withdraw (:label w)) "the :withdraw send")
      (is (= "(>= balance amt)" (:guard w)) "hits guard (>= balance amt)")
      (is (= "(>= balance 0)" (:receiver-invariant w))
          "on a receiver whose invariant (>= balance 0) that guard protects"))))

; ── a send to a process with NO invariant is not flagged by composition ──

(deftest knowledge-composition-ignores-invariant-free-receiver
  (let [x (k/invariant-bearing-guarded-sends (kdb) q-fn)
        receivers (into #{} (map :to x))]
    (is (not (contains? receivers "ledger"))
        "ledger carries no invariant → its sends are not composition risks")))
