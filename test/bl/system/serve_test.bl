; test/bl/system/serve_test.bl — the port a serve program reads.
;
; `bl serve` runs a file and then parks. The one thing the file needs from the
; command is the port the operator asked for, and `bl.serve/port` is that
; answer: the default the program wrote, or the `--port` value when there is
; one.
;
; Run: bl test test/bl/system/serve_test.bl
(ns system.serve-test
  (:require [bl.cli :as cli]
            [bl.serve :as v]))

(deftest port-answers-the-programs-own-default
  (reset! v/port-override nil)
  (is (= 4043 (v/port 4043)) "no flag, so the literal the program wrote stands"))

(deftest port-answers-the-flag
  (reset! v/port-override 8080)
  (is (= 8080 (v/port 4043)) "a program that reads the helper honours --port")
  (reset! v/port-override nil)
  (is (= 4043 (v/port 4043)) "and falls back when no port is asked for"))

(deftest run-without-a-file-is-a-usage-error
  (is (= 2 (v/run (list) (cli/parse-argv (list "serve"))))
      "no FILE reports usage and parks nothing"))
