; test/bl/system/z3_concurrent_test.bl — one solver, one conversation at a time.
;
; The defect: `mcp.tools/port!` memoizes ONE z3 port per VM, and a port's replies
; are delivered to its OWNER's mailbox (`Z3Port.read_answer/2` receives
; `{port, {:data, …}}`). Two callers driving one port interleave their SMT-LIB and
; each reads the other's answer. Measured on the shipped runtime (drop payload
; 03cd2b3d) with the soak below: 98 wrong verdicts in 200 verifies; with the owner
; process in (`BeamLisp.Z3.Solver`, commit 9d6cd69): 0 in 200.
;
; Two lessons about HOW to measure this are encoded here, because I got both wrong
; first and reported a false number:
;
;   1. RESULTS MUST COME BACK AS MESSAGES. An earlier version collected into one
;      atom with `(reset! out (conj @out …))` — a read-modify-write — and
;      concurrent writers LOST updates, so 7 workers that had finished normally
;      looked like 7 workers that never answered. The instrument, not the code,
;      was broken. Hence: `erlang/send` to the parent, then drain.
;   2. ASSERT THE INSTRUMENT. "0 mismatches" means nothing if only one worker
;      reported, so every worker must check in and the count is asserted.
;
; The questions are deliberately MIXED (a defserver whose invariant holds, and a
; broken one): a desync hands somebody the other answer, which shows up as a wrong
; verdict — a corrupted answer is worse than a hang, and a test that only asserts
; "no crash" would miss it.

(ns mcp.z3.concurrent.test
  (:require [mcp.tools :as tools]))

(def good
  "(defserver ^{:invariant (>= balance 0)} account
     (init [balance] (ok balance))
     (handle-call [:withdraw amt] [_ balance] :when (and (>= amt 0) (>= balance amt))
       (reply :ok (- balance amt))))")

(def buggy
  "(defserver ^{:invariant (>= balance 0)} account
     (init [balance] (ok balance))
     (handle-call [:withdraw amt] [_ balance] (reply :ok (- balance amt))))")

(def rounds 25)          ; 4 workers x 25 rounds x 2 questions = 200 verifies
(def workers 4)

(deftest concurrent-verifies-never-see-each-others-answers
  (let [g good
        b buggy
        rs rounds
        nw workers
        parent (erlang/self)
        verdict (fn [src] (get (tools/code-verify-handler {"source" src}) :verdict))
        worker (fn [i]
                 (loop [n 0 bad 0]
                   (if (= n rs)
                     (erlang/send parent [:done i bad])
                     (let [h (try (verdict g) (catch e (str "ERR " (pr-str e))))
                           v (try (verdict b) (catch e (str "ERR " (pr-str e))))]
                       (recur (inc n)
                              (+ bad (if (= h "holds") 0 1) (if (= v "violated") 0 1)))))))
        collect (fn [want]
                  (loop [acc [] k 0]
                    (if (> k want)
                      acc
                      (let [m (receive [:done i bad] [i bad] (after 120000 :timeout))]
                        (if (= m :timeout) acc (recur (conj acc m) (inc k)))))))
        pids (vec (map (fn [i] (erlang/spawn (fn [] (worker i)))) (to-list [0 1 2 3])))
        got (vec (collect nw))]
    (is (= nw (count pids)) "four workers started")
    (is (= nw (count got))
        (str "every worker reported (a lost update here means the INSTRUMENT is "
             "broken, not the solver): " (pr-str got)))
    (is (zero? (reduce (fn [a p] (+ a (get p 1))) 0 got))
        (str "no verdict was anyone else's — mismatches per worker: " (pr-str got)))))

