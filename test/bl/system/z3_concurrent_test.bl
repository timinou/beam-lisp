; test/bl/system/z3_concurrent_test.bl — one solver, one conversation at a time.
;
; Found by soaking the HTTP surface (4 threads, 1000 code/verify calls):
; 15 failures, and the daemon's stderr named the truth —
;
;   tool handler error: %RuntimeError{message: "z3 timeout (acc: \"\")"}
;   tool handler error: %ArgumentError{message: "argument error"}
;
; The same 1000 calls issued SEQUENTIALLY failed none. The z3 process is a
; single stream of SMT-LIB — `(reset)`, assertions, `(check-sat)`,
; `(get-model)` — so two callers driving it at once interleave those lines and
; neither gets its own answer. The client sees only the catch-all in
; `call-tool` ("-32602 Invalid params"), which is why this looked like a bad
; request rather than two requests sharing one conversation.
;
; The memo in `mcp.tools/port!` is per-VM, so ANY concurrent verify shares it:
; two editors, an HTTP client with a pool, a daemon serving several sessions.
;
; This test is the repro without the transport: N processes verify at once, and
; every one of them must get its own verdict.

(ns mcp.z3.concurrent.test
  (:require [mcp.tools :as tools]))

(defn- until
  "Poll `pred` for up to 60 s — a verify is a solver round trip, not an instant."
  [pred]
  (loop [n 0]
    (cond
      (pred) true
      (> n 6000) false
      :else (do (Process/sleep 10) (recur (inc n))))))

;; a defserver whose invariant holds, so the ONLY thing that can fail is sharing
(def account
  "(defserver ^{:invariant (>= balance 0)} account
     (init [balance] (ok balance))
     (handle-call [:withdraw amt] [_ balance] :when (and (>= amt 0) (>= balance amt))
       (reply :ok (- balance amt))))")

(deftest concurrent-verifies-each-get-their-own-verdict
  (let [src account
        idx (to-list [0 1 2 3 4 5 6 7])
        out (atom [])
        pids (map (fn [i]
                    (erlang/spawn (fn []
                                    (reset! out (conj @out [i (get (tools/code-verify-handler {"source" src})
                                                                   :verdict)])))))
                  idx)]
    (is (= (count idx) (count pids)) "eight verifies started")
    (is (until (fn [] (= (count idx) (count @out)))) "and all eight answered")
    (let [verdicts (map (fn [pair] (get pair 1)) @out)]
      (is (= (count idx) (count verdicts)))
      (is (every? (fn [v] (= v "holds")) verdicts)
          (str "every concurrent verify holds — got " (pr-str verdicts))))))

(deftest a-second-wave-over-the-same-memo-still-answers
  ; A reader's takeaway: the memo is shared, so the SECOND wave must be as good
  ; as the first — a gate that only works on a cold port is no gate.
  (let [src account
        idx (to-list [0 1 2 3])
        run (fn []
              (let [out (atom [])
                    pids (map (fn [i]
                                (erlang/spawn (fn []
                                                (reset! out (conj @out [i (get (tools/code-verify-handler {"source" src})
                                                                               :verdict)])))))
                              idx)]
                (until (fn [] (= (count idx) (count @out))))
                (map (fn [pair] (get pair 1)) @out)))]
    (is (every? (fn [v] (= v "holds")) (run)))
    (is (every? (fn [v] (= v "holds")) (run)))))
