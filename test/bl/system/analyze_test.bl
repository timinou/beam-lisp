; test/bl/system/analyze_test.bl — the shared inter-procedural pass: one call
; graph, one fixpoint, feeding footprint / return-flow / reachability.
(ns system.analyze-test
  (:require [system.analyze :as an]))

(deftest interprocedural-footprint
  (testing "a caller inherits its callee's global effect"
    (let [s (an/analyze "(defn helper [] (swap! acc inc))
                         (defn caller [] (helper))")]
      (is (= {"acc" :W} (:footprint (get s "helper"))))
      (is (= {"acc" :W} (:footprint (get s "caller")))
          "footprint closes over the call graph"))))

(deftest interprocedural-return-flow
  (testing "a callee's return tagset flows to its call sites"
    (let [s (an/analyze "(defn mk [] :a-keyword)
                         (defn use-it [] (mk))")]
      (is (= #{:kw} (:returns (get s "mk"))))
      (is (contains? (:edges (get s "use-it")) "mk")))))

(deftest higher-order-edges
  (testing "a call through a parameter is a resolved edge (0-CFA)"
    (let [s (an/analyze "(defn inc2 [n] (erlang/+ n 1))
                         (defn apply-twice [f x] (f (f x)))
                         (defn main [] (apply-twice inc2 5))")]
      (is (contains? (:edges (get s "apply-twice")) "inc2")
          "apply-twice→inc2 through parameter f")
      (is (contains? (an/reachable s ["main"]) "inc2")
          "inc2 is LIVE — reached only via the higher-order call"))))

(deftest dead-code-sound
  (testing "unused fns are dead; callback-only fns are live"
    (let [s (an/analyze "(defn used [] 1)
                         (defn dead [] 2)
                         (defn root [] (used))")]
      (is (= ["dead"] (into [] (an/dead-fns s ["root"]))))
      (is (not (contains? (set (an/dead-fns s ["root"])) "used"))))))

(deftest honest-opacity
  (testing "a fn reached only at runtime stays unresolved — no invented edge"
    (let [s (an/analyze "(defn add1 [n] (erlang/+ n 1))
                         (defn runtime-call [chooser x] ((chooser) x))
                         (defn go [] (runtime-call some-external 5))")]
      ; runtime-call invokes (chooser) — a runtime value; no edge to add1
      (is (not (contains? (:edges (get s "runtime-call")) "add1"))
          "no edge invented to a fn chosen at runtime"))))

(deftest fn-bodies-keeps-every-clause
  (testing "a multi-arity defn exposes ALL its clauses, not just the first"
    (let [b (an/fn-bodies "(defn f ([x] 1) ([x y] 2))")]
      (is (= 2 (count (:clauses (get b "f")))))))
  (testing "a single-clause defn is a one-entry clause set (no behavior lost)"
    (let [b (an/fn-bodies "(defn f [x] (erlang/+ x 1))")]
      (is (= 1 (count (:clauses (get b "f")))))
      (is (= (:body (get b "f")) (:body (first (:clauses (get b "f")))))))))

(deftest effect-in-later-clause-is-not-pure
  (testing "a same-arity SECOND clause's write joins the fn's footprint"
    (let [s (an/analyze "(defn f ([x] 1) ([y] (swap! acc inc)))")]
      (is (= {"acc" :W} (:footprint (get s "f")))
          "the later clause's effect cannot be labelled pure")))
  (testing "an arity-VARIANT second clause's write joins too"
    (let [s (an/analyze "(defn f ([] 1) ([x] (swap! acc inc)))")]
      (is (= {"acc" :W} (:footprint (get s "f")))))))

(deftest calls-in-later-clause-become-edges
  (testing "a same-arity later clause's call is a resolved edge"
    (let [s (an/analyze "(defn helper [x] (erlang/+ x 1))
                         (defn f ([x] x) ([y] (helper y)))")]
      (is (contains? (:edges (get s "f")) "helper"))))
  (testing "an arity-variant later clause's call is a resolved edge"
    (let [s (an/analyze "(defn helper [x] (erlang/+ x 1))
                         (defn f ([] 1) ([x] (helper x)))")]
      (is (contains? (:edges (get s "f")) "helper"))
      (is (contains? (an/reachable s ["f"]) "helper")))))

(deftest opacity-in-later-clause-fails-closed
  (testing "an opaque call in a later clause keeps the whole fn opaque"
    (let [s (an/analyze "(defn f ([x] 1) ([x y] (some-unknown-op x)))")]
      (is (= {:opaque-world :W} (:footprint (get s "f")))
          "one opaque clause is not averaged away by a pure sibling")))
  (testing "a non-terminating later clause makes the fn non-terminating"
    (let [s (an/analyze "(defn f ([x] 1) ([x y] (loop [n x] (recur n))))")]
      (is (= false (:terminates (get s "f")))))))

(deftest higher-order-through-later-clause
  (testing "a callback passed at a later clause's call site is a live edge"
    (let [s (an/analyze "(defn inc2 [n] (erlang/+ n 1))
                         (defn apply2 ([f x] f) ([f x] (f x)))
                         (defn main [] (apply2 inc2 5))")]
      (is (contains? (:edges (get s "apply2")) "inc2"))
      (is (contains? (an/reachable s ["main"]) "inc2")))))


(deftest first-order-core-values-are-pure
  (testing "str, not and name are first-order core values: no footprint of their own"
    (let [s (an/analyze "(defn label [n] (str (name :open) \" \" n))
                         (defn off [x] (not x))")]
      (is (= {} (:footprint (get s "label"))))
      (is (= {} (:footprint (get s "off"))))))
  (testing "a higher-order core name stays opaque: it calls its argument"
    (let [s (an/analyze "(defn each [f xs] (filter f xs))")]
      (is (contains? (:footprint (get s "each")) :opaque-world))))
  (testing "a program that redefines a core name is judged by its own body"
    (let [s (an/analyze "(defn str [x] (swap! acc inc))
                         (defn use-it [] (str 1))")]
      (is (= {"acc" :W} (:footprint (get s "use-it")))
          "the local `str` wins over the core table")))
  (testing "an unknown global is still opaque"
    (let [s (an/analyze "(defn go [] (mystery 1))")]
      (is (contains? (:footprint (get s "go")) :opaque-world)))))
