; test/bl/system/analyze_test.bl — the shared inter-procedural pass: one call
; graph, one fixpoint, feeding footprint / return-flow / reachability.
(ns system.analyze-test
  (:require [system.analyze :as an]))

(deftest interprocedural-footprint
  (testing "a caller inherits its callee's global effect"
    (let [s (an/analyze "(defn helper [] (swap! acc inc))
                         (defn caller [] (helper))")]
      (is (= {"acc" :W} (:footprint (get s "helper"))))
      (is (= {"acc" :W} (:footprint (get s "caller")))
          "footprint closes over the call graph"))))

(deftest interprocedural-return-flow
  (testing "a callee's return tagset flows to its call sites"
    (let [s (an/analyze "(defn mk [] :a-keyword)
                         (defn use-it [] (mk))")]
      (is (= #{:kw} (:returns (get s "mk"))))
      (is (contains? (:edges (get s "use-it")) "mk")))))

(deftest higher-order-edges
  (testing "a call through a parameter is a resolved edge (0-CFA)"
    (let [s (an/analyze "(defn inc2 [n] (erlang/+ n 1))
                         (defn apply-twice [f x] (f (f x)))
                         (defn main [] (apply-twice inc2 5))")]
      (is (contains? (:edges (get s "apply-twice")) "inc2")
          "apply-twice→inc2 through parameter f")
      (is (contains? (an/reachable s ["main"]) "inc2")
          "inc2 is LIVE — reached only via the higher-order call"))))

(deftest dead-code-sound
  (testing "unused fns are dead; callback-only fns are live"
    (let [s (an/analyze "(defn used [] 1)
                         (defn dead [] 2)
                         (defn root [] (used))")]
      (is (= ["dead"] (into [] (an/dead-fns s ["root"]))))
      (is (not (contains? (set (an/dead-fns s ["root"])) "used"))))))

(deftest honest-opacity
  (testing "a fn reached only at runtime stays unresolved — no invented edge"
    (let [s (an/analyze "(defn add1 [n] (erlang/+ n 1))
                         (defn runtime-call [chooser x] ((chooser) x))
                         (defn go [] (runtime-call some-external 5))")]
      ; runtime-call invokes (chooser) — a runtime value; no edge to add1
      (is (not (contains? (:edges (get s "runtime-call")) "add1"))
          "no edge invented to a fn chosen at runtime"))))
