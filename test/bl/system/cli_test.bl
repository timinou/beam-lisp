; test/bl/system/cli_test.bl — the CLI's argv grammar and its exit codes.
;
; bl.cli parses one uniform shape: global flags may appear anywhere before
; `--`, the first positional is the command, the rest are its arguments, and
; everything after `--` belongs to the running program. `run-argv` turns that
; shape into an exit code and never halts, so a daemon can call it.
;
; Run: bl test test/bl/system/cli_test.bl
(ns system.cli-test
  (:require [bl.cli :as cli]))

(defn- parse [argv] (cli/parse-argv argv))

(defn- capture
  "Run `f` with this process's group leader on a StringIO, so the command's
   stdout is a value here. Returns a two-element list of the return value and
   the captured output; restores the leader in a finally."
  [f]
  (let [prev (Process/group_leader)
        dev (erlang/element 2 (StringIO/open ""))]
    (Process/group_leader (erlang/self) dev)
    (let [r (try (f) (finally (Process/group_leader (erlang/self) prev)))]
      (list r (erlang/element 2 (StringIO/contents dev))))))

; ── argv grammar ──────────────────────────────────────────────────────

(deftest global-flags-appear-anywhere-before-double-dash
  (let [st (parse (list "eval" "(+ 1 2)" "--json"))]
    (is (= "eval" (:cmd st)))
    (is (:json st) "a global flag after the positionals still parses")
    (is (= (list "(+ 1 2)") (:args st)))))

(deftest double-dash-splits-the-program-argv
  (let [st (parse (list "run" "x.bl" "--" "a" "b"))]
    (is (= (list "x.bl") (:args st)) "positionals before `--` belong to the command")
    (is (= (list "a" "b") (:dd st)) "tokens after `--` belong to the program")))

(deftest a-bare-dash-is-a-positional
  (let [st (parse (list "eval" "-"))]
    (is (= (list "-") (:args st)) "`-` is stdin, not a flag")
    (is (nil? (:unknown st)))))

(deftest an-unknown-flag-is-reported
  (is (= "--nope" (:unknown (parse (list "eval" "--nope"))))))

(deftest code-path-repeats-and-stacks
  (let [st (parse (list "run" "x.bl" "--code-path" "/a" "--code-path" "/b"))]
    (is (= (list "/b" "/a") (:code-paths st)) "repeatable, newest first")))

(deftest tier-takes-a-value
  (is (= "safe" (:tier (parse (list "lint" "x.bl" "--tier" "safe"))))))

(deftest port-parses-as-an-integer
  (let [st (parse (list "serve" "s.bl" "--port" "8080"))]
    (is (= 8080 (:port st)))
    (is (int? (:port st)))))

(deftest check-flags-are-boolean
  (let [st (parse (list "check" "--changed" "--update" "--fix" "--install-hook"))]
    (is (:changed st))
    (is (:update st))
    (is (:fix st))
    (is (:install-hook st))))

(deftest -p-and-path-are-the-same-flag
  (let [st (parse (list "run" "x.bl" "-p" "lib" "--path" "src"))]
    (is (= (list "src" "lib") (:paths st)) "repeatable, newest first")))

; ── run-argv: exit codes and output ───────────────────────────────────

(deftest exit-codes
  (is (= 0 (first (capture (fn [] (cli/run-argv (list "help")))))) "help is ok")
  (is (= 2 (first (capture (fn [] (cli/run-argv (list "nope")))))) "an unknown command is a usage error")
  (is (= 2 (first (capture (fn [] (cli/run-argv (list "eval" "--nope")))))) "an unknown flag is a usage error")
  (is (= 0 (first (capture (fn [] (cli/run-argv (list "version")))))))
  (is (= 0 (first (capture (fn [] (cli/run-argv (list "eval" "(+ 1 2)"))))))))

(deftest eval-prints-the-value
  (let [r (capture (fn [] (cli/run-argv (list "eval" "(+ 1 2)"))))]
    (is (= 0 (first r)))
    (is (= "3\n" (second r)))))

(deftest eval-json-prints-one-json-value
  (let [r (capture (fn [] (cli/run-argv (list "eval" "(+ 1 2)" "--json"))))]
    (is (= 0 (first r)))
    (is (= "3\n" (second r)) "the value itself is the JSON document")))

(deftest help-lists-every-verb
  (let [out (second (capture (fn [] (cli/run-argv (list "help")))))]
    (is (includes? out "bl check"))
    (is (includes? out "bl lint"))
    (is (includes? out "bl fix"))
    (is (includes? out "bl ask"))
    (is (includes? out "bl doctor"))
    (is (includes? out "bl serve"))
    (is (includes? out "bl monitor"))
    (is (includes? out "bl examples"))
    (is (includes? out "bl mcp"))
    (is (includes? out "lsp serve"))))
