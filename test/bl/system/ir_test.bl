; test/bl/system/ir_test.bl — the shared ANF engine substrate.
(ns system.ir-test
  (:require [compiler :as c] [anf] [lower] [system.ir :as ir]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- anf [s] (c/compile-node (read1 s) (c/new-env "irtest")))

(deftest node-access
  (testing "child-nodes walks each op's spine"
    (is (= 2 (count (ir/child-nodes (anf "(erlang/+ 1 2)")))))
    (let [n (anf "(let [x 1] (erlang/+ x 2))")]
      (is (= :let (ir/op n)))
      (is (= 2 (count (ir/child-nodes n)))))
    (is (= 3 (count (ir/child-nodes (anf "(if a b c)")))))))

(deftest pattern-vars
  (testing "pvars harvested recursively"
    (let [n (anf "(let [{:keys [x]} m] x)")]
      ;; the destructure binds a whole_N then x_N; just assert non-empty walk
      (is (ir/node? n)))))

(deftest annotate-survives-emission
  (testing "an :ann-annotated node validates, emits, loads and runs"
    (let [node (ir/annotate (fn [_] :touched) :probe (anf "(let [x 1] (erlang/+ x 41))"))
          clause {:op :defn-clause :fname :answer :params (list) :guard nil :body node :ann {}}
          descriptor (anf/module :sys_ir_probe (list clause) [[:answer 0]] (list) {:file "irtest.bl"})
          mb (lower/descriptor->beam descriptor)]
      (code/load_binary (elem mb 0) (erlang/binary_to_list "irtest.bl") (elem mb 1))
      (is (= 42 (sys_ir_probe/answer)))
      (is (= :touched (ir/ann-get node :probe))))))

(deftest alias-env
  (testing "let binding a global aliases it; a computed local does not"
    (let [g {:op :global :ns "u" :name "conn"}
          v {:op :var :name "r_1"}
          lit {:op :lit :val 1}]
      (is (= "conn" (ir/resource-of ir/empty-aliases g)))
      (is (= ir/opaque-world (ir/resource-of ir/empty-aliases v)))
      (is (= "conn" (ir/resource-of {"r_1" "conn"} v)))
      ;; let-env: init is a global → local aliases it
      (is (= "conn" (get (ir/let-env ir/empty-aliases {:op :let :name "r_1" :init g}) "r_1")))
      ;; let-env: init is computed → no alias, shadows any prior
      (is (nil? (get (ir/let-env {"r_1" "old"} {:op :let :name "r_1" :init lit}) "r_1"))))))
