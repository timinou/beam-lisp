; test/bl/system/mcp_registry_test.bl — a server over a CALLER's registry.
;
; The protocol core used to be usable by exactly one server: tools/list, the
; resources and the prompts were read straight out of mcp.tools and
; mcp.instructions, so an app with its own nouns had to fork the module or
; hand-roll the wire (which is what knowledger did). `registry-state` is that
; seam.
;
; What these tests are FOR: proving the seam is a seam and not a rename. A
; registry this module has never heard of answers tools/list, tools/call,
; resources/read, prompts/* and discover through the SAME dispatch; an empty
; registry answers empty rather than falling back to someone else's tools; and
; a registry that names no conn mounts no codebase.
;
; Run: mix bl test test/bl/system/mcp_registry_test.bl
(ns system.mcp-registry-test
  (:require [mcp.server :as server]))

(def ^:private meta
  {"io.modelcontextprotocol/protocolVersion" "2026-07-28"})

(defn- call
  ([id method] (call id method nil))
  ([id method params]
   (merge {"jsonrpc" "2.0" "id" id "method" method "_meta" meta}
          (if (nil? params) {} {"params" params}))))

(defn- notes-registry []
  (server/registry-state
   {:tools
    [["notes/search"
      "Search the company's notes"
      {"type" "object" "properties" {"q" {"type" "string"}}}
      (fn [args] {"hits" [(get args "q")]})]
     ["notes/save"
      "Save a note"
      {"type" "object" "properties" {"body" {"type" "string"}}}
      (fn [_args] {"saved" true})]]
    :resources
    [{"uri" "notes://schema" "name" "notes schema"
      "description" "the note fact schema" "mimeType" "application/json"}]
    :resource-read
    (fn [_state uri]
      (if (= uri "notes://schema")
        {"contents" [{"uri" uri "mimeType" "application/json"
                      "text" "{\"note\":[\"body\",\"author\"]}"}]}
        nil))
    :prompts
    [{"name" "notes/onboarding" "description" "how to hold this server"}]
    :prompt-get
    (fn [_state name]
      (if (= name "notes/onboarding")
        {:description "how to hold this server" :text "Search before you save."}
        nil))
    :instructions "This server answers questions about company notes."}))

;; ── the tools come from the registry, not from mcp.tools ────────────
(deftest tools-list-is-the-callers-tools
  (let [r (server/request-response (notes-registry) (call 1 "tools/list"))
        ts (get-in r ["result" "tools"])
        names (map (fn [t] (get t "name")) ts)]
    (is (some (fn [n] (= "notes/search" n)) names) "notes/search is listed")
    (is (some (fn [n] (= "notes/save" n)) names) "notes/save is listed")
    (is (nil? (some (fn [n] (= "code/ask" n)) names))
        "the codebase's own tools are NOT listed by a foreign registry")
    (is (= 2 (count ts)) "exactly the two tools the registry named")
    (is (= "Search the company's notes"
           (get (first (filter (fn [t] (= "notes/search" (get t "name"))) ts))
                "description"))
        "the description and inputSchema travel with the name")))

(deftest a-callers-tool-is-callable
  (let [r (server/request-response
           (notes-registry)
           (call 2 "tools/call" {"name" "notes/search" "arguments" {"q" "invoice"}}))]
    (is (= "invoice" (first (get-in r ["result" "hits"])))
        "the handler's value crosses the wire — a beam-lisp vector becomes a
         list on the way, because Jason has no encoder for our vector")
    (is (= "complete" (get-in r ["result" "resultType"])) "a complete envelope")))

(deftest an-unknown-tool-is-still-an-error
  (let [r (server/request-response
           (notes-registry)
           (call 3 "tools/call" {"name" "code/ask" "arguments" {}}))]
    (is (= -32602 (get-in r ["error" "code"]))
        "a tool the registry does not define is invalid params, not a fallback")))

;; ── an empty registry is empty, not somebody else's server ──────────
(deftest an-empty-registry-answers-empty
  (let [st (server/registry-state {})
        tools (server/request-response st (call 4 "tools/list"))
        prompts (server/request-response st (call 5 "prompts/list"))
        resources (server/request-response st (call 6 "resources/list"))]
    (is (empty? (get-in tools ["result" "tools"])) "no tools")
    (is (empty? (get-in prompts ["result" "prompts"])) "no prompts")
    (is (empty? (get-in resources ["result" "resources"])) "no resources")))

(deftest another-servers-uris-are-not-answerable
  ;; the sharpest proof that nothing mounted a codebase: the URI that the
  ;; codebase registry answers is unknown to this one.
  (let [r (server/request-response
           (server/registry-state {})
           (call 7 "resources/read" {"uri" "code://beam-lisp/schema"}))]
    (is (= -32602 (get-in r ["error" "code"])) "unknown resource URI")))

(deftest resources-read-goes-through-the-caller
  (let [st (notes-registry)
        ok (server/request-response st (call 8 "resources/read" {"uri" "notes://schema"}))
        missing (server/request-response st (call 9 "resources/read" {"uri" "notes://nope"}))]
    (is (= "{\"note\":[\"body\",\"author\"]}"
           (get (first (get-in ok ["result" "contents"])) "text")))
    (is (= -32602 (get-in missing ["error" "code"])) "a URI the caller declines")))

;; ── prompts and instructions are the caller's words ─────────────────
(deftest prompts-come-from-the-caller
  (let [st (notes-registry)
        listed (server/request-response st (call 10 "prompts/list"))
        got (server/request-response st (call 11 "prompts/get" {"name" "notes/onboarding"}))]
    (is (= "notes/onboarding"
           (get (first (get-in listed ["result" "prompts"])) "name")))
    (is (= "Search before you save."
           (get-in (first (get-in got ["result" "messages"])) ["content" "text"])))
    (is (= "how to hold this server" (get-in got ["result" "description"])))))

(deftest discover-reports-the-callers-instructions
  (let [r (server/request-response
           (notes-registry)
           (call 12 "server/discover"))]
    (is (= "This server answers questions about company notes."
           (get-in r ["result" "instructions"]))
        "the caller's instruction text, not the beam-lisp corpus")
    (is (some? (get-in r ["result" "supportedProtocolVersions"]))
        "discover still carries the version surface")))

(deftest an-empty-instruction-string-is-omitted
  (let [r (server/request-response (server/registry-state {}) (call 13 "server/discover"))]
    (is (nil? (get-in r ["result" "instructions"]))
        "a server with nothing to say says nothing rather than saying \"\"")))

;; ── the classic lifecycle wraps a foreign registry's result too ─────
(deftest classic-lifecycle-wraps-a-callers-tool-result
  (let [st (assoc (notes-registry) :lifecycle :legacy)
        r (server/request-response
           st (call 14 "tools/call" {"name" "notes/search" "arguments" {"q" "q"}}))]
    (is (= "text" (get (first (get-in r ["result" "content"])) "type"))
        "a classic client gets the content envelope")
    (is (some? (get-in r ["result" "structuredContent"]))
        "and the same value as structured content")
    (is (nil? (get r "_meta")) "with no _meta beside result")))

(deftest classic-lifecycle-carries-the-tools-own-isError
  ;; A refusal that arrives as isError=false is not a refusal: the text saying
  ;; no survives inside `content`, so the client reads a successful call. This
  ;; envelope is the last layer that can still tell the truth.
  (let [registry (server/registry-state
                  {:tools
                   [["notes/refuse"
                     "Always refuses"
                     {"type" "object"}
                     (fn [_args] {:resultType "complete" :isError true
                                  :content [{"type" "text" "text" "no"}]})]
                    ["notes/ok"
                     "Always succeeds"
                     {"type" "object"}
                     (fn [_args] {"fine" true})]]})
        st (assoc registry :lifecycle :legacy)
        failed (server/request-response
                st (call 60 "tools/call" {"name" "notes/refuse" "arguments" {}}))
        ok (server/request-response
            st (call 61 "tools/call" {"name" "notes/ok" "arguments" {}}))]
    (is (= true (get-in failed ["result" "isError"]))
        "a handler that returned :isError true is reported as an error")
    (is (= false (get-in ok ["result" "isError"]))
        "and a successful result is still not an error")))

;; ── the server's NAME is the caller's, not this core's ─────────────
(deftest discover-serves-under-the-callers-identity
  (let [named (server/registry-state
               {:server-info {"name" "notes-mcp" "version" "9.9"}
                :capabilities {"tools" {} "subscriptions" {"listChanged" true}}})
        r (server/request-response named (call 70 "server/discover"))
        init (server/request-response
              named (call 71 "initialize" {"protocolVersion" "2025-06-18"}))]
    (is (= "notes-mcp" (get-in r ["result" "serverInfo" "name"]))
        "a caller that names itself is not told it is beam-lisp")
    (is (= "9.9" (get-in r ["result" "serverInfo" "version"])))
    (is (some? (get-in r ["result" "capabilities" "subscriptions"]))
        "capabilities come from the registry, so an app can advertise its own")
    (is (= "notes-mcp" (get-in init ["result" "serverInfo" "name"]))
        "the classic handshake answers with the same identity")))

(deftest a-registry-that-names-no-identity-keeps-this-cores
  ;; the regression guard for the seam: absent keys must change nothing.
  (let [r (server/request-response (server/registry-state {}) (call 72 "server/discover"))]
    (is (= "beam-lisp-mcp-server" (get-in r ["result" "serverInfo" "name"]))
        "no :server-info ⇒ this core's name, exactly as before")
    (is (some? (get-in r ["result" "capabilities" "tools"]))
        "no :capabilities ⇒ this core's set")))
