; test/bl/system/incremental_test.bl — content-addressed incremental proofs.
;
; A function's summary is a pure function of its ANF structure, so it is
; content-addressable: edit one function and only that function (plus its
; transitive callers) re-proves. The hash is position- AND rename-invariant, so
; reindentation and comments never invalidate a proof.
(ns system.incremental-test
  (:require [system.incr :as incr] [system.analyze :as analyze]))

; ── the content hash ────────────────────────────────────────────────────────

(deftest reindent-and-comment-are-cache-hits
  (testing "structure-preserving edits do not invalidate a summary"
    (let [v1 "(defn a [x] (erlang/+ x 1))\n(defn b [y] (erlang/* y 2))\n(defn c [z] (erlang/- z 3))"
          v2 "(defn a [x]\n  ; adds one\n  (erlang/+ x 1))\n(defn b [y] (erlang/* y 4))\n(defn c [z] (erlang/- z 3))"
          r1 (incr/analyze-incremental {} v1)
          r2 (incr/analyze-incremental (:cache r1) v2)]
      (is (= 3 (count (:misses r1))) "cold: everything misses")
      (is (some? (index-of (pr-str (:hits r2)) "a")) "a: reindent+comment → HIT")
      (is (some? (index-of (pr-str (:hits r2)) "c")) "c: untouched → HIT")
      (is (some? (index-of (pr-str (:misses r2)) "b")) "b: constant changed → MISS"))))

(deftest hash-is-alpha-invariant
  (testing "a body differing only in a bound-variable name hashes the same"
    (let [ba (:body (get (into {} (analyze/fn-bodies "(defn f [x] (erlang/+ x 1))")) "f"))
          bb (:body (get (into {} (analyze/fn-bodies "(defn f [y] (erlang/+ y 1))")) "f"))]
      (is (= (incr/body-hash ba) (incr/body-hash bb)) "rename doesn't change the hash"))))

(deftest hash-distinguishes-real-change
  (testing "a body with a different constant hashes differently"
    (let [ba (:body (get (into {} (analyze/fn-bodies "(defn f [x] (erlang/+ x 1))")) "f"))
          bb (:body (get (into {} (analyze/fn-bodies "(defn f [x] (erlang/+ x 2))")) "f"))]
      (is (not (= (incr/body-hash ba) (incr/body-hash bb))) "1 vs 2 → different hash"))))

; ── transitive invalidation ─────────────────────────────────────────────────

(deftest dirty-set-includes-transitive-callers
  (testing "changing a leaf dirties its transitive callers, not the whole module"
    ; caller -> mid -> leaf ; sibling is independent
    (let [src (str "(defn leaf [x] (erlang/+ x 1))\n"
                   "(defn mid [x] (leaf x))\n"
                   "(defn caller [x] (mid x))\n"
                   "(defn sibling [x] (erlang/* x 2))")
          summaries (analyze/analyze src)
          dirty (incr/dirty-set summaries ["leaf"])]
      (is (contains? dirty "leaf") "the changed fn")
      (is (contains? dirty "mid") "its direct caller")
      (is (contains? dirty "caller") "its transitive caller")
      (is (not (contains? dirty "sibling")) "an independent fn stays clean"))))

(deftest reverse-graph-inverts-edges
  (testing "reverse-graph maps each callee to its callers"
    (let [src "(defn leaf [x] x)\n(defn mid [x] (leaf x))"
          rg (incr/reverse-graph (analyze/call-graph (analyze/analyze src)))]
      (is (contains? (get rg "leaf") "mid") "mid calls leaf → leaf's callers include mid"))))
