; test/bl/system/place_test.bl — where a piece of a program may run.
(ns system.place-test
  (:require [system.place :as pl]))

(deftest functions-are-placed-by-the-analyzer
  (let [ps (pl/placements (str "(defn sq [x] (* x x))\n"
                               "(defn total [xs] (reduce + (map sq xs)))\n"
                               "(defn slurp-it [p] (File/read! p))\n"
                               "(defn uses-slurp [p] (count (slurp-it p)))\n"))]
    (is (= {:place :local} (get ps "sq")))
    (is (= {:place :local} (get ps "total")) "pure callees keep a caller local")
    (is (= :beam (:place (get ps "slurp-it"))))
    (is (= :effect (:reason (:why (get ps "slurp-it")))))
    (is (= "slurp-it" (:via (:why (get ps "uses-slurp")))) "an inherited effect names its source")))

(deftest cells-are-placed-over-the-whole-document
  (let [ps (pl/cell-placements
             [{:id "sq" :forms ["(defn sq [x] (* x x))"]}
              {:id "total" :forms ["(defn total [xs] (reduce + (map sq xs)))" "(total [1 2 3])"]}
              {:id "file" :forms ["(defn slurp-it [p] (File/read! p))"]}
              {:id "uses" :forms ["(count (slurp-it \"x\"))"]}
              {:id "nums" :forms ["(def nums [1 2 3])"]}
              {:id "uses-nums" :forms ["(map sq nums)"]}
              {:id "fx" :forms ["(def fx (File/read! \"x\"))"]}
              {:id "uses-fx" :forms ["(count fx)"]}
              {:id "ns" :forms ["(ns demo)"]}
              {:id "clock" :forms ["(System/os_time)"]}])]
    (is (= :local (:place (get ps "sq"))))
    (is (= :local (:place (get ps "total"))) "a cell calling another cell's pure defn")
    (is (= :beam (:place (get ps "file"))))
    (is (= "slurp-it" (:via (:why (get ps "uses")))) "a cell using an effectful defn says which")
    (is (= :local (:place (get ps "nums"))) "a pure def")
    (is (= :local (:place (get ps "uses-nums"))) "a bare reference to a pure def")
    (is (= :beam (:place (get ps "fx"))) "an effectful def")
    (is (= :beam (:place (get ps "uses-fx"))) "a bare reference to an effectful def")
    (is (= :local (:place (get ps "ns"))) "an ns form is setup, never forces the BEAM")
    (is (= :beam (:place (get ps "clock"))))))
