; test/bl/system/mcp_test.bl — the MCP request surface.
;
; mcp.server dispatches discovery, tool listing and tool calls to pure data.
; The protocol envelopes are asserted here against the real dispatch, and one
; case drives the gen_server entry (`request`) that the stdio transport uses.
; Run: mix bl test test/bl/system/mcp_test.bl
(ns system.mcp-test
  (:require [mcp.server :as server]
            [mcp.tools :as tools]))

(def ^:private meta
  {"io.modelcontextprotocol/protocolVersion" "2026-07-28"})

(defn- request [id method]
  {"jsonrpc" "2.0" "id" id "method" method "_meta" meta})

(deftest discover-advertises-capabilities
  (let [r (server/request-response {} (request 1 "server/discover"))]
    (is (= "2026-07-28" (get-in r ["result" "protocolVersion"])))
    (is (some? (get-in r ["result" "capabilities" "tools"]))
        "the tools capability is advertised")))

(deftest tools-list-includes-the-code-tools
  (let [r (server/request-response {} (request 2 "tools/list"))
        ts (get-in r ["result" "tools"])]
    (is (some (fn [t] (= "code/ask" (get t "name"))) ts) "code/ask is listed")
    (is (some (fn [t] (= "code/verify" (get t "name"))) ts) "code/verify is listed")
    (is (= "complete" (get-in r ["result" "resultType"])) "a complete envelope")))

(deftest an-unknown-method-is-method-not-found
  (let [r (server/request-response {} (request 3 "nope/nope"))]
    (is (= -32601 (get-in r ["error" "code"])) "JSON-RPC MethodNotFound")))

(deftest the-gen-server-entry-answers-too
  (let [srv (server/start)]
    (try
      (let [r (server/request srv (request 4 "tools/list"))]
        (is (= "complete" (get-in r ["result" "resultType"])))
        (is (some (fn [t] (= "code/ask" (get t "name")))
                  (get-in r ["result" "tools"]))))
      (finally (server/stop srv)))))

;; ── the served surface, over the REAL state ─────────────────────────────
;;
;; Everything above answers with `{}` as the state — the one state the server
;; never actually serves. The stdio transport builds `(server/state)`: the
;; mounted codebase plus the tool table. Three bugs lived exactly in that gap.
;; `resources/list` and `resources/read` answered with beam-lisp vectors, which
;; the transport's Jason encoder refused, and a refused response is DROPPED (a
;; stderr line, no reply, the client waits forever); and the mount read its
;; sources relative to the process's cwd, so it worked from a checkout and
;; crashed in a release run from any other directory. These tests ask the
;; questions a client asks.

(defn- call [id method params]
  (let [base {"jsonrpc" "2.0" "id" id "method" method "_meta" meta}]
    (if (nil? params) base (assoc base "params" params))))

(deftest every-response-the-server-produces-is-json-encodable
  (let [st (server/state)
        answers (map (fn [r] (server/request-response st r))
                     [(call 1 "server/discover" nil)
                      (call 2 "tools/list" nil)
                      (call 3 "resources/list" nil)
                      (call 4 "resources/read" {"uri" "code://beam-lisp/schema"})
                      (call 5 "resources/read" {"uri" "code://beam-lisp/namespaces"})
                      (call 6 "tools/call" {"name" "code/list" "arguments" {}})
                      (call 7 "no/such-method" nil)])]
    (doseq [a answers]
      (is (string? (Jason/encode! a))
          "the transport encodes with Jason; a response it refuses is dropped"))))

(deftest the-served-surface-answers-over-the-mounted-codebase
  (let [r (server/request-response (server/state)
                                   (call 10 "tools/call"
                                         {"name" "code/list" "arguments" {}}))
        cb (first (get-in r ["result" "codebases"]))]
    (is (= "complete" (get-in r ["result" "resultType"])))
    (is (pos? (get-in cb ["entities" "functions"])) "the mount indexed functions")
    (is (pos? (get-in cb ["entities" "calls"])) "the mount indexed calls")
    (is (= (to-list tools/MOUNTED) (to-list (get-in cb ["sources"])))
        "the reported sources are the mounted namespaces")))

(deftest the-mount-resolves-its-sources-by-namespace-not-by-cwd
  ;; `bl mcp` from a directory with no beam-lisp sources in it is the case that
  ;; broke in a release: `priv/std/codebase.bl` read relative to the cwd is
  ;; `:enoent` there, and `:enoent` then reached the reader as if it were the
  ;; program text. A mount resolves by NAMESPACE, through the same paths a
  ;; require uses — which is what makes it independent of where you stand.
  (is (= ["codebase" "typed"] tools/MOUNTED)
      "MOUNTED holds namespaces, not paths")
  (doseq [ns-str (to-list tools/MOUNTED)]
    (is (string? (BeamLisp.Loader/source_content ns-str))
        (str ns-str " resolves on the load path")))
  ;; Pinned to a foreign search dir, the priv tier still answers: the mount
  ;; never depended on the cwd, and must not start.
  (BeamLisp.Loader/with_search_dir "/tmp"
    (fn []
      (doseq [ns-str (to-list tools/MOUNTED)]
        (is (string? (BeamLisp.Loader/source_content ns-str))
            (str ns-str " resolves through the priv tier alone"))))))
