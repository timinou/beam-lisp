; test/bl/system/span_rewrite_test.bl — trivia-preserving structural rewrite.
;
; The property that matters: a fix changes ONLY the matched span. Comments,
; multi-line shape, indentation, and non-smell siblings survive byte-for-byte —
; which the old pr-str-splicing fix-source could not guarantee.
(ns system.span-rewrite-test
  (:require [deodorant :as deo] [span-rewrite :as sr]))

(defn- kept? [s sub] (some? (index-of s sub)))
(defn- reparses? [s] (some? (first (BeamLisp.Reader/read_string s))))

(deftest preserves-multiline-and-comment
  (testing "(if (not P) A nil) -> (when-not P A) keeps A's multi-line body + comment"
    (let [src (str "(defn process [items]\n"
                   "  (if (not (empty? items))\n"
                   "    (do\n"
                   "      ; keep the good ones\n"
                   "      (filter good? items))\n"
                   "    nil))")
          out (deo/fix-source-preserving (deo/all-rules) src)]
      (is (= 1 (:changed out)) "exactly one fix applied")
      (is (kept? (:source out) "; keep the good ones") "the comment survives")
      (is (kept? (:source out) "(filter good? items)") "the body survives")
      (is (reparses? (:source out)) "the result is valid source"))))

(deftest old-fix-source-loses-the-comment
  (testing "the contrast: pr-str-splicing fix-source drops the comment"
    (let [src (str "(defn process [items]\n"
                   "  (if (not (empty? items))\n"
                   "    (do\n"
                   "      ; keep the good ones\n"
                   "      (filter good? items))\n"
                   "    nil))")
          old (deo/fix-source (deo/all-rules) src)
          new (deo/fix-source-preserving (deo/all-rules) src)]
      (is (not (kept? (:source old) "keep the good ones")) "old fixer loses the comment")
      (is (kept? (:source new) "keep the good ones") "preserving fixer keeps it"))))

(deftest untouched-bytes-are-identical
  (testing "everything outside the matched span is byte-identical"
    (let [src (str ";; a leading comment\n"
                   "(defn f [x]\n"
                   "  (if (not (nil? x)) x :default))\n"
                   ";; a trailing comment")
          out (deo/fix-source-preserving (deo/all-rules) src)]
      (is (kept? (:source out) ";; a leading comment") "leading comment kept")
      (is (kept? (:source out) ";; a trailing comment") "trailing comment kept")
      (is (reparses? (:source out)) "valid source"))))

(deftest no-smell-is-a-noop
  (testing "source with no smell is returned unchanged"
    (let [src "(defn clean [x] (inc x))"
          out (deo/fix-source-preserving (deo/all-rules) src)]
      (is (= 0 (:changed out)) "nothing changed")
      (is (= src (:source out)) "byte-identical to input"))))

(deftest guard-is-honored
  (testing "a smell's :when guard rides through the bridge (keyword-key guards)"
    ; nested-kw->get-in fires only when keys are keyword literals; a variable
    ; key must be left alone. Bridged rule must honor the same guard.
    (let [src "(get (:ann node) k)"
          out (deo/fix-source-preserving (deo/every-rule) src)]
      (is (= src (:source out)) "variable key: guard vetoes, no rewrite"))))

(deftest bridge-produces-a-rule
  (testing "smell->rule yields a pattern node + a render fn + the guard"
    (let [smell (first (deo/all-rules))
          rule (sr/smell->rule smell)]
      (is (contains? rule :pattern) "has a pattern")
      (is (contains? rule :render) "has a render fn"))))

(deftest nil-literal-not-confused-with-nil-string
  (testing "(= x \"nil\") must NOT rewrite to (nil? x) — a string is not nil"
    ; Regression: node-match once compared scalars by pr-str, which prints both
    ; the nil atom and the \"nil\" string as `nil`, so (= token \"nil\") was
    ; wrongly rewritten to (nil? token) — which broke the reader's literal parse.
    (let [rules (deo/all-rules)]
      (is (= "(= token \"nil\")"
             (:source (deo/fix-source-preserving rules "(= token \"nil\")")))
          "string \"nil\" is left alone")
      (is (= "(nil? x)"
             (:source (deo/fix-source-preserving rules "(= x nil)")))
          "the real (= x nil) still becomes (nil? x)")
      (is (= "(= a \"foo\")"
             (:source (deo/fix-source-preserving rules "(= a \"foo\")")))
          "an unrelated string comparison is untouched"))))

(deftest quote-templates-are-not-swept
  (testing "a syntax-quote template is data, not code — left untouched"
    ; `(if ~test (do ~@body) nil) BUILDS an if; simplifying it to `when` would
    ; both change meaning and (once) mangle the unquote spans into garbage.
    (let [src "(defmacro when [test & body]\n  `(if ~test (do ~@body) nil))"
          out (deo/fix-source-preserving (deo/all-rules) src)]
      (is (= 0 (:changed out)) "nothing inside the template is rewritten")
      (is (= src (:source out)) "byte-identical"))))

(deftest self-definition-not-made-recursive
  (testing "a call inside f's own defn is not rewritten into a call to f"
    ; (defn inc [x] (+ x 1)) must NOT become (defn inc [x] (inc x)).
    (let [src "(defn inc [x] (+ x 1))"
          out (deo/fix-source-preserving (deo/all-rules) src)]
      (is (= src (:source out)) "inc's own body is left as (+ x 1)"))
    ; but the SAME idiom in a DIFFERENT fn is fixed normally.
    (let [src "(defn bump [x] (+ x 1))"
          out (deo/fix-source-preserving (deo/all-rules) src)]
      (is (= "(defn bump [x] (inc x))" (:source out)) "a non-self call is fixed"))))
