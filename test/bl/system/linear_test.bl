; test/bl/system/linear_test.bl — emission linearity, three tiers.
;
; The compiler bug: `self-apply` spliced the compiled inner fn twice, so every
; fn/loop doubled its body and nested `for`s compounded ×24 per level. These
; tests are the proof it is gone and the fence that keeps it gone:
;   tier 1 — the compiler's own source is affine in compiled children (datalog
;            over its ANF), and the OLD self-apply is caught by the same check;
;   tier 2 — z3: affine ⟹ linear bound; a double placement breaks it;
;   tier 3 — the emitted IR of the worst scaffolds has no duplicated subtree,
;            and the emission ratio stays bounded across nesting depth.
(ns system.linear-test
  (:require [system.linear :as lin]
            [system.ir :as ir]
            [compiler :as c]
            [z3]))

(def compiler-src (File/read! "priv/boot/compiler.bl"))

; ── tier 3: the artefact ─────────────────────────────────────────────────

(deftest emitted-ir-has-no-duplicated-subtree
  (testing "fn, loop, lazy-seq, for — none duplicates its body"
    (doseq [src ["(fn [x] (erlang/+ x 1))"
                 "(loop [i 0 acc 0] (if (< i 10) (recur (inc i) (+ acc i)) acc))"
                 "(lazy-seq (cons 1 nil))"
                 "(for [x xs] (f x))"
                 "(for [x xs y ys :when (< x y) :let [z (+ x y)]] [x y z])"]]
      (let [r (lin/blowup src "lin-t")]
        (is (empty? (:duplicates r)) (str src " → " (pr-str (:duplicates r))))))))

(deftest emission-ratio-is-bounded-in-nesting-depth
  (testing "a `for` nested 1..4 deep: emitted/source ratio does not grow with depth"
    (let [ratios (map (fn [n]
                        (let [body (reduce (fn [acc i] (str "(for [v" i " xs] " acc ")")) "(f a)" (range n))]
                          (:ratio (lin/blowup body "lin-t"))))
                      [1 2 3 4])
          r1 (first ratios) r4 (last ratios)]
      ; before the fix: 24× per level. Now the per-level ratio is flat: the
      ; 4-deep ratio is within 2× of the 1-deep one.
      (is (<= r4 (* 2 r1)) (str "ratios " (pr-str ratios)))
      (is (< r4 60) (str "absolute ratio " r4)))))

; A macro that splices its body twice — the `for` defect, minimal. Tier 1
; cannot see it (the compiler is linear; the MACRO is not); tier 3 must.
(defmacro twice-bad [x] `(if (rand-nth [true false]) ~x ~x))

(deftest a-duplicating-macro-is-caught-by-the-sentinel
  (testing "tier 3 names the caller whose emitted IR carries the duplicate"
    (let [src "(defn victim [xs] (system.linear-test/twice-bad (reduce (fn [a b] (erlang/+ a (erlang/* b 2))) 0 xs)))"
          ds (lin/check-source src)]
      (is (= ["victim"] (map :fn ds)))
      (is (= 2 (:count (first (:duplicates (first ds))))))
      ; and as an LSP diagnostic, positioned, with a message a human can act on
      (let [d (first (lin/diagnostics src))]
        (is (= :non-linear-emission (:kind d)))
        (is (int? (:line d)))
        (is (some? (index-of (:msg d) "victim")))))))

; ── tier 1: the compiler's source ────────────────────────────────────────

(deftest compiler-source-is-affine-in-compiled-children
  (testing "no compile-* fn hands the same compiled child to a constructor twice"
    (let [v (lin/check-compiler compiler-src)]
      (is (empty? v) (pr-str (map (fn [x] [(:fn x) (map :local (:violations x))]) v))))))

(deftest the-old-self-apply-is-caught
  (testing "the pre-fix scaffold (inner spliced as let body) is an affine violation"
    (let [old "(defn- self-apply [self inner-fn]
                 (let [outer-fn (a/fnn (list (a/clause (list (a/pvar self)) nil inner-fn)))]
                   (a/lett self outer-fn inner-fn)))"
          fixed "(defn- self-apply [self inner-fn]
                   (let [outer-fn (a/fnn (list (a/clause (list (a/pvar self)) nil inner-fn)))]
                     (a/lett self outer-fn (a/app (a/var self) (list (a/var self))))))"]
      ; `inner-fn` is a parameter, not a let-bound compiled child, so the
      ; affine check reads it through the constructor's argument list: a
      ; parameter used twice inside ONE constructor call is the same defect.
      (is (seq (lin/param-violations old)) "old self-apply: inner-fn placed twice")
      (is (empty? (lin/param-violations fixed)) "fixed self-apply: once"))))

(deftest the-boot-toolchain-emits-linearly
  (testing "tier 3 over every priv/boot source: every fn's emitted/source ratio stays under the bound"
    ; The seed is built from these files. Measured today every one of their
    ; ~480 fns emits ≤ 1 IR node per source node; the bound asserted is 4 —
    ; a constructor that started splicing (×2 on every fn/loop, as
    ; self-apply did) or a macro that doubled its body would cross it on the
    ; fns paying for it, before the change is blessed into a seed.
    (doseq [f ["priv/boot/core.bl" "priv/boot/sugar.bl" "priv/boot/anf.bl" "priv/boot/lower.bl"
               "priv/boot/reader.bl" "priv/boot/build.bl" "priv/boot/compiler.bl"]]
      (let [bad (lin/over-ratio (File/read! f) 4)]
        (is (empty? bad) (str f ": " (pr-str bad)))))))

; ── tier 2: the bound, by z3 ─────────────────────────────────────────────

(deftest z3-discharges-the-size-lemma
  (testing "affine placement ⟹ |emit| ≤ k·|src| (unsat); double placement breaks it (sat)"
    (let [port (z3/open)
          r (lin/prove-bound port 12 8 6)]
      (is (= true (:holds r)) (pr-str (:arities r))))))
