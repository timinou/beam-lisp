(ns system.loading-test
  (:require [bl.loading :as l] [bl.env :as env] [bl.serve :as serve] [bl.cli :as cli]))

(defn- kind [f] (try (f) nil (catch e (:kind (ex-data e)))))

(deftest defaults-and-mode-selection
  (let [p (l/validate nil)]
    (is (= "BL_ENV" (:environment-env p)))
    (doseq [e [nil "development" "test" "dev"]] (is (= :lazy (l/mode p e))))
    (doseq [e ["production" "prod"]] (is (= :startup (l/mode p e))))))

(deftest malformed-configuration-is-refused
  (doseq [p ["startup" {:wat true} {:production :lazy} {:development :background}
             {:environment-env ""} {:roots "a"} {:roots [nil]} {:roots [""]}]]
    (is (= :loading-config (kind (fn [] (l/validate p)))))))

(deftest lazy-mode-does-not-discover-or-load
  (let [fail (fn [& _] (throw (ex-info "unexpected" {})))]
    (is (= {:mode :lazy :namespaces 0} (l/prepare nil nil fail fail fail)))))

(deftest startup-loads-shared-cyclic-closure-once-without-entry
  (let [loaded (atom [])
        edges {"a" ["b"] "b" ["a"] "extra" ["b"]}
        r (l/prepare {:roots ["extra"]} "production"
                     (fn [] "(ns entry (:require [a] [b]))")
                     (fn [n] (get edges n [])) (fn [n] (swap! loaded conj n)))]
    (is (= {:mode :startup :namespaces 3} r))
    (is (= ["a" "b" "extra"] @loaded))))

(deftest entry-cycles-and-missing-header-refuse-before-loading
  (doseq [[policy source deps]
          [[nil "(println 1)" (fn [_] [])]
           [{:roots ["entry"]} "(ns entry)" (fn [_] [])]
           [nil "(ns entry (:require [a]))" (fn [_] ["entry"])]]]
    (let [loaded (atom [])]
      (is (= :loading-entry
             (kind (fn [] (l/prepare policy "production" (fn [] source) deps
                                    (fn [n] (swap! loaded conj n)))))))
      (is (= [] @loaded)))))

(deftest discovery-and-load-failures-propagate
  (is (= :discovery
         (kind (fn [] (l/prepare nil "production" (fn [] "(ns entry (:require [a]))")
                                (fn [_] (throw (ex-info "no" {:kind :discovery})))
                                (fn [_] nil))))))
  (is (= :load
         (kind (fn [] (l/prepare nil "production" (fn [] "(ns entry (:require [a]))")
                                (fn [_] [])
                                (fn [_] (throw (ex-info "no" {:kind :load})))))))))

(deftest literate-declaration-matches-requested-library
  (let [[n deps] (l/header-for "actual"
                  "(ns illustrative)\n(ns actual (:require [datom]))")]
    (is (= "actual" n))
    (is (= ["datom"] (vec deps))))
  (is (= :loading-source (kind (fn [] (l/dependencies "missing.loading.fixture"))))))

(deftest project-normalization-retains-loading-and-reports-invalid-policy
  (let [p (env/normalize {:loading {:environment-env "APP_ENV"}} "/a" "/a/env.bl")]
    (is (= [] (:errors p)))
    (is (= "APP_ENV" (get-in p [:loading :environment-env])))
    (is (= :startup (get-in p [:loading :production]))))
  (is (seq (:errors (env/normalize {:loading {:production :lazy}} "/a" "/a/env.bl")))))

(deftest serve-failure-never-executes-entry
  (let [root (Path/join (System/tmp_dir) (str "loading-test-" (erlang/unique_integer (list :positive))))
        file (Path/join root "entry.bl")
        marker (Path/join root "executed")
        previous (System/get_env "BL_LOADING_TEST_MODE")]
    (File/mkdir_p! root)
    (try
      (File/write! (Path/join root "env.bl")
        "{:loading {:environment-env \"BL_LOADING_TEST_MODE\"}}")
      (File/write! file (str "(ns loading.entry (:require [missing.loading.fixture]))\n"
                            "(File/write! " (pr-str marker) " \"bad\")\n"))
      (System/put_env "BL_LOADING_TEST_MODE" "production")
      (is (= 1 (BeamLisp/with_cwd root
                  (fn [] (serve/run (list file) (cli/parse-argv (list "serve" file)))))))
      (is (not (File/exists? marker)))
      (finally
        (if (nil? previous) (System/delete_env "BL_LOADING_TEST_MODE")
          (System/put_env "BL_LOADING_TEST_MODE" previous))
        (File/rm_rf! root)))))

(deftest unrelated-project-warnings-do-not-block-entry
  (let [root (Path/join (System/tmp_dir) (str "loading-warning-" (erlang/unique_integer (list :positive))))
        file (Path/join root "entry.bl")
        marker (Path/join root "executed")]
    (File/mkdir_p! root)
    (try
      (File/write! (Path/join root "env.bl") "{:unknown-project-option true}")
      (File/write! file (str "(ns loading.warning.entry)\n"
                            "(File/write! " (pr-str marker) " \"yes\")\n"
                            "(throw (ex-info \"intentional test exit\" {}))\n"))
      (is (= 1 (BeamLisp/with_cwd root
                  (fn [] (serve/run (list file) (cli/parse-argv (list "serve" file)))))))
      (is (File/exists? marker))
      (finally (File/rm_rf! root)))))

(deftest shared-roots-are-discovered-once
  (let [calls (atom {})
        deps (fn [n] (swap! calls update n (fn [v] (inc (or v 0))))
                     (get {"a" ["shared"] "b" ["shared"] "shared" ["a"]} n []))]
    (is (= #{"a" "b" "shared"} (l/discover ["a" "b" "a"] deps)))
    (is (= {"a" 1 "b" 1 "shared" 1} @calls))))

(deftest phase-receipts-are-bounded-and-lazy-is-empty
  (let [r (l/prepare-measured nil "production" (fn [] "(ns entry (:require [a]))")
              (fn [n] (if (= n "a") (mapv str (range 30)) [])) (fn [_] :ok) true)]
    (is (= 31 (:namespaces r)))
    (is (= 20 (count (:slowest r))))
    (is (<= 0 (:discovery-us r)))
    (is (<= 0 (:loading-us r)))
    (is (< 0 (:reductions r))))
  (is (= {:mode :lazy :namespaces 0 :discovery-us 0 :loading-us 0 :reductions 0}
         (l/prepare-measured nil "development" (fn [] (throw :unexpected))
           (fn [_] (throw :unexpected)) (fn [_] (throw :unexpected)) true))))

(deftest async-is-development-only-and-never-an-entry-barrier
 (let [p (l/validate {:development :async})]
  (is (= :async (l/mode p "development")))
  (is (= :startup (l/mode p "production")))
  (is (= {:mode :async :namespaces 0}
         (l/prepare p "development" (fn [] (throw :unexpected))
                           (fn [_] (throw :unexpected)) (fn [_] (throw :unexpected)))))))
