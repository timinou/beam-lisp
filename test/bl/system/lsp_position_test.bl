; test/bl/system/lsp_position_test.bl — position consistency of the language
; server's answers: no point inside code may answer "No beam-lisp expression
; here". Invariants S/P1/P2/E/T documented below.
(ns system.lsp-position-test
  (:require [lsp]))

; The bug class this suite exists to keep out: a point INSIDE code answering
; "No beam-lisp expression here". The reader stamps only list forms with
; positions, so every positional answer is a two-layer resolution — the ANF
; resolves the form, the token layer resolves the cursor inside it. These
; tests pin the invariants of that composition:
;
;   S  safety:      hovering ANY position answers — it never raises
;   P1 coverage:    every position inside a CALL form resolves (≠ :none)
;   P2 gaps:        comments and blank lines answer :none, honestly
;   E  equivalence: `(+ x 1)` and `(erlang/+ x 1)` are ONE op — same kind,
;                   same inferred type; neither reads "expression / any"
;   T  tokens:      params, literals, and strings answer as themselves
;
; The span walker here is INDEPENDENT of lsp.bl (its own paren matcher), so a
; mistake in the implementation's position math cannot hide behind the same
; mistake in the test.

; ── an independent span walker ────────────────────────────────────────────

(def ^:private opens {"(" ")", "[" "]", "{" "}"})
(def ^:private closers #{")" "]" "}"})

(defn- form-spans
  "Every collection form's span in `src`: {:line :col :end-line :end-col
   :head}, 1-based, end-col ON the closer. :head is the first token for a
   list, nil for a vector/map. Computed by a standalone string- and
   comment-aware scan — the test's own arithmetic, not the server's."
  [src]
  (let [lines (into [] (split src "\n"))]
    (loop [ln 1 col 1 stack [] spans [] in-str false esc false]
      (if (> ln (count lines))
        spans
        (let [cps (into [] (String/codepoints (get lines (dec ln) "")))]
          (if (> col (count cps))
            (recur (inc ln) 1 stack spans in-str false)
            (let [c (nth cps (dec col))]
              (cond
                esc (recur ln (inc col) stack spans in-str false)
                (and in-str (= c "\\")) (recur ln (inc col) stack spans in-str true)
                (= c "\"") (recur ln (inc col) stack spans (not in-str) false)
                in-str (recur ln (inc col) stack spans in-str false)
                (= c ";") (recur (inc ln) 1 stack spans in-str false)
                (contains? opens c)
                (recur ln (inc col) (conj stack {:open c :line ln :col col}) spans false false)
                (contains? closers c)
                (let [top (last stack)]
                  (if (and (some? top) (= (get opens (:open top)) c))
                    (let [head (when (= "(" (:open top))
                                 (let [rest-line (join "" (drop col (take (count cps) cps)))]
                                   nil))
                        ; head is read below from the opening line's text
                        headtok (when (= "(" (:open top))
                                  (let [oline (get lines (dec (:line top)) "")
                                        ocps (into [] (String/codepoints oline))
                                        n (count ocps)
                                        start (:col top)
                                        end (loop [j start]
                                              (if (and (< j n)
                                                       (not (contains? #{" " "\t" "(" ")" "[" "]" "{" "}" "\""}
                                                                       (nth ocps j))))
                                                (recur (inc j)) j))]
                                    (join "" (take (- end start) (drop start ocps)))))]
                      (recur ln (inc col) (into [] (take (dec (count stack)) stack))
                             (conj spans {:line (:line top) :col (:col top)
                                          :end-line ln :end-col col :head headtok})
                             false false))
                    (recur ln (inc col) stack spans false false)))
                :else (recur ln (inc col) stack spans false false)))))))))

(defn- positions-of
  "Every [line col] a span covers, inclusive of both ends."
  [s]
  (if (= (:line s) (:end-line s))
    (map (fn [c] [(:line s) c]) (range (:col s) (inc (:end-col s))))
    (concat
      ; a multi-line span's first line runs to its end; the corpus keeps its
      ; call forms on one line, so the general case is deliberately plain
      [])))

; ── the corpus ────────────────────────────────────────────────────────────

(def corpus
  (str "(defn double [x] (erlang/* x 2))\n"
       "(defn inc2 [y] (+ y 1))\n"
       "\n"
       "; a comment line\n"
       "(defn greet\n"
       "  \"Doc.\"\n"
       "  [who]\n"
       "  (str \"hi \" who))\n"
       "(defn use [] (greet (double 2)))\n"
       "(defn tags [m] {:k 1 :v 2.5 :b true :n nil})\n"))

; ── S: safety ─────────────────────────────────────────────────────────────

(deftest hovering-any-position-answers-never-raises
  (testing "every [line col] of the corpus gets a hover map with a :kind"
    (let [lines (into [] (split corpus "\n"))]
      (doseq [ln (range 1 (inc (count lines)))]
        (let [len (count (String/codepoints (get lines (dec ln) "")))]
          (doseq [c (range 1 (+ len 2))]
            (let [h (lsp/hover corpus ln c)]
              (is (map? h) (str "hover answers a map at " ln ":" c))
              (is (contains? h :kind) (str "with a :kind at " ln ":" c)))))))))

; ── P1: coverage inside call forms ─────────────────────────────────────────

(def ^:private non-expression-heads
  "Forms whose head region is NOT an expression: definitions and the ns
   declaration. Their BODIES are covered by their own inner call forms."
  #{"defn" "defn-" "defmacro" "defmacro-" "ns"})

(deftest every-position-inside-a-call-resolves
  (testing "no 'No beam-lisp expression here' between a call's parens"
    (let [spans (filter (fn [s] (and (some? (:head s))
                                     (not (contains? non-expression-heads (:head s)))))
                        (form-spans corpus))]
      (is (<= 5 (count spans)) "the corpus has call forms to walk")
      (doseq [s spans]
        (doseq [pos (positions-of s)]
          (let [h (lsp/hover corpus (first pos) (second pos))]
            (is (not= :none (:kind h))
                (str "position " (first pos) ":" (second pos)
                     " inside (" (:head s) " …) resolves"))))))))

; ── P2: the honest gaps ───────────────────────────────────────────────────

(deftest comments-and-blank-lines-answer-none
  (is (= :none (:kind (lsp/hover corpus 3 1))) "a blank line")
  (is (= :none (:kind (lsp/hover corpus 4 5))) "inside a comment"))

(deftest a-defn-name-answers-its-own-card
  (testing "pointing at the definition itself resolves to the fn, no fallback needed"
    (let [h (lsp/hover corpus 1 8)]
      (is (= :fn (:kind h)) "the name resolves to the fn it defines")
      (is (some? (:projection h)) "with the whole proof card"))))

; ── E: erlang/* ≡ core spelling ───────────────────────────────────────────

(deftest arith-and-host-spelling-are-one-op
  (testing "(+ y 1) and (erlang/* x 2) answer as operators, not 'expression'"
    (let [core (lsp/hover corpus 2 16)      ; inside (+ y 1)
          host (lsp/hover corpus 1 24)]     ; inside (erlang/* x 2)
      (is (= :op (:kind core)) "core spelling is an operator")
      (is (= :op (:kind host)) "host spelling is an operator")
      (is (= "+" (:label core)) "named as written")
      (is (= "erlang/*" (:label host)) "named as written")
      (is (= #{:int :float} (set (:type core))) "the BIF's tagset, not any")
      (is (= #{:int :float} (set (:type host))) "the same tagset either way"))))

(deftest comparisons-infer-bool
  (is (= #{:bool} (set (:type (lsp/hover "(defn f [n] (< n 2))" 1 17)))))
      "(< n 2) returns bool, the same fact erlang/< carries")

; ── T: the token layer ────────────────────────────────────────────────────

(deftest params-answer-as-parameters
  (let [h (lsp/hover corpus 2 19)]          ; the y in (+ y 1)
    (is (= :param (:kind h)) "a parameter use answers as itself")
    (is (= "y" (:label h)))
    (is (= "inc2" (:in-fn h)) "and names its owner")))

(deftest literals-answer-with-their-tag
  (let [i (lsp/hover corpus 2 21)]          ; the 1 in (+ y 1)
    (is (= :literal (:kind i)) "1 is a literal")
    (is (= #{:int} (set (:type i))) "an int"))
  (let [kw (lsp/hover corpus 10 18)]        ; :k in the map
    (is (= :literal (:kind kw)) "a keyword is a literal")
    (is (= #{:kw} (set (:type kw)))))
  (let [f (lsp/hover corpus 10 26)]         ; 2.5
    (is (= #{:float} (set (:type f))) "2.5 is a float"))
  (let [b (lsp/hover corpus 10 35)]         ; true
    (is (= #{:bool} (set (:type b))) "true is a bool"))
  (let [s (lsp/hover corpus 8 9)]           ; inside "hi "
    (is (= :literal (:kind s)) "a string literal answers as a literal")
    (is (= #{:string} (set (:type s))))))

(deftest a-fn-named-as-a-value-carries-its-projection
  (let [h (lsp/hover corpus 9 19)]          ; the greet token of (greet …)
    (is (some? (:projection h)) "resolving to a local fn carries the projection")
    (is (= "Doc." (:doc (:projection h))) "with the author's docstring")
    (is (= "(greet who)" (:sig (:projection h))) "and the source's signature")))

; ── the rich projection ───────────────────────────────────────────────────

(def rich-src
  (str "(defn fib [n] (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))\n"
       "(defn double\n"
       "  \"Doubles X.\"\n"
       "  [x]\n"
       "  (erlang/* x 2))\n"))

(deftest the-projection-is-the-whole-proof-card
  (let [p (lsp/fn-projection rich-src "double")]
    (is (= "Doubles X." (:doc p)) "docstring")
    (is (= "(double x)" (:sig p)) "signature")
    (is (= #{:float :int} (set (:returns p))) "inferred return")
    (is (:pure p) "purity")
    (is (:terminates p) "termination")
    (is (:native p) "native eligibility — pure ∧ terminating")
    (is (nil? (:growth p)) "not self-recursive: no growth class")))

(deftest growth-is-part-of-the-projection-and-the-card
  (let [p (lsp/fn-projection rich-src "fib")]
    (is (= :exponential (:growth p)) "fib branches over n")
    (is (= "O(2^n)" (:growth-label p))))
  (let [c (lsp/hover-card rich-src 1 33)]   ; the (fib …) call in fib's body
    (is (some? (index-of c "O(2^n)")) "the card carries the growth class"))
  (let [c (lsp/fn-card rich-src "double")]
    (is (some? (index-of c "native-eligible")) "a pure ∧ terminating fn's card says so")))

; ── code actions: the provider table ──────────────────────────────────────

(deftest providers-are-data
  (testing "the registry is a table of {:id :kind :doc :applies? :offer}"
    (is (<= 3 (count lsp/action-providers)) "quickfix, native, annotate")
    (doseq [p lsp/action-providers]
      (is (keyword? (:id p)) "a stable id")
      (is (contains? #{:quickfix :refactor} (:kind p)) "an LSP kind")
      (is (string? (:doc p)) "a doc")
      (is (fn? (:applies? p)) "a relevance predicate")
      (is (fn? (:offer p)) "an offer fn"))))

(def actions-src
  (str "(defn bad [m] (merge nil m))\n"
       "(defn double [x] (erlang/* x 2))\n"
       "(defn noisy [x] (do (IO/puts \"hi\") x))\n"
       "(defn vague [x] (str x))\n"))

(deftest quickfix-per-diagnostic
  (let [acts (lsp/code-actions actions-src "t" 1 16)
        fixes (filter (fn [a] (= :quickfix (:kind a))) acts)]
    (is (= 1 (count fixes)) "one diagnostic, one fix")
    (is (some? (index-of (:title (first fixes)) "merge")) "naming the problem")))

(deftest native-compile-follows-the-proof
  (is (some (fn [a] (some? (index-of (:title a) "compile 'double'")))
            (lsp/code-actions actions-src "t" 2 24))
      "pure ∧ terminating → offered")
  (is (nil? (some (fn [a] (if (some? (index-of (:title a) "compile 'noisy'")) a nil))
                  (lsp/code-actions actions-src "t" 3 24)))
      "impure → not offered"))

(deftest annotate-materializes-the-inferred-type
  (testing "double returns float|int — the edit writes the checker's metadata"
    (let [acts (lsp/code-actions actions-src "t" 2 24)
          ann (first (filter (fn [a] (some? (:edit a))) acts))]
      (is (some? ann) "an annotate action is offered")
      (is (= "^{:args [any] :ret number} " (:insert (:edit ann)))
          "in the typed checker's own annotation language")
      (is (= 2 (:line (:edit ann))) "on the defn's line")
      (is (= 7 (:col (:edit ann))) "at the name, where ^ metadata belongs")))
  (testing "an `any` return is not worth writing down"
    (is (nil? (some (fn [a] (if (some? (:edit a)) a nil))
                    (lsp/code-actions actions-src "t" 4 14)))
        "vague returns any: no annotate action")))

(deftest an-annotated-defn-is-not-re-offered
  (let [src "(defn ^{:args [any] :ret number} double [x] (erlang/* x 2))\n"
        acts (lsp/code-actions src "t" 1 40)]
    (is (nil? (some (fn [a] (if (some? (:edit a)) a nil)) acts))
        "already annotated: the provider stands down")))
