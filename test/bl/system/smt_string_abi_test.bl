(ns system.smt-string-abi-test (:require [system.smt :as smt]))
(deftest canonical-variadic-string-calls-preserve-the-entire-operand-list
 (is (= '(str.contains (str.++ s t) "hi")
        (smt/of-source #{"s" "t"} "(str-contains? (str s t) \"hi\")")))
 (is (= "" (smt/of-source #{} "(str)")))
 ;; Keep the String sort obligation even for a single operand; returning its
 ;; symbol alone would turn numeric-to-string coercion into integer identity.
 (is (= '(str.++ "" s) (smt/of-source #{"s"} "(str s)"))))
(deftest an-unknown-tail-or-foreign-function-cannot-supply-a-string-proof
 (let [ctx {:env {} :variants {} :colls #{}}
       dynamic {:op :remote :mod :Elixir.BeamLisp.Ns.Rt :fun :str_v
                :args [{:op :cons :head {:op :lit :val "known"} :tail {:op :global :ns "fixture" :name "tail"}}]}]
  (is (= :untranslatable (smt/translate-node ctx dynamic)))
  (is (= :untranslatable (smt/translate-node ctx (assoc dynamic :mod :Elixir.Foreign.Strings))))))
