(ns system.return-flow-test (:require [system.summary :as summary] [compiler :as c]))
(defn- tags [source]
 (summary/returns-tag {} (c/compile-node (first (BeamLisp.Reader/read_string source)) (c/new-env "return.flow.fixture"))))
(deftest local-values-and-loop-carried-types-reach-normal-exits
 (is (= #{:int} (tags "(let [x \"outer\"] (let [x 1] x))")))
 (is (= #{:int} (tags "(loop [i 0 acc 0] (if (< i 3) (recur (+ i 1) (+ (* 31 acc) (binary/at buf i))) acc))")))
 (is (= #{:int :string} (tags "(loop [i 0 value 1] (if (< i 3) (recur (+ i 1) \"changed\") value))")))
 (is (= #{:int} (tags "(loop [i 0 acc 0] (if (< i 3) (recur (+ i 1) (loop [j 0 n 0] (if (< j 2) (recur (+ j 1) (+ n 2)) n))) acc))"))))
(deftest unknown-back-edges-and-numeric-unions-remain-conservative
 (is (= summary/all-tags (tags "(loop [i 0 value 1] (if (< i 3) (recur (+ i 1) (unknown i)) value))")))
 (is (contains? (tags "(loop [i 0 value 1] (if (< i 3) (recur (+ i 1) (+ value 0.5)) value))") :float))
 (is (= #{} (tags "(loop [value 1] (recur \"changed\"))"))))
