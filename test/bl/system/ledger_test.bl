; test/bl/system/ledger_test.bl — the ledger's contract, pinned by observation.
;
; `system.ledger` (priv/lib/system/ledger.bl) is the single home for the
; decision ladder's rollup and its per-process trail. It replaced the former
; Elixir ledger module; there is no dual implementation, and this test reaches
; the API only through the BL namespace — no host module is named here.
;
; What goes wrong SILENTLY, and is pinned below:
;
;   1. A LOST INCREMENT. The rollup is `:counters` precisely because an earlier
;      atom-based rollup lost concurrent writes ("one of eight answered"). The
;      concurrent test resets the GLOBAL rollup before and after itself, runs its
;      writers as fresh, uniquely-owned processes, and asserts they ALL checked
;      in: a count below workers x records means an increment was lost, and a
;      missing report means the INSTRUMENT (not the ledger) is broken.
;   2. A TRAIL THAT ISN'T PER-PROCESS. Attribution only means anything if a
;      decision's tiers belong to the caller. The same test asserts each worker's
;      own trail holds exactly its own records while the PARENT's stays empty —
;      so the shared rollup and the per-process trail are shown to be different
;      mechanisms, which is the whole design.
;   3. A REFUSAL READ AS A VERDICT. `unknown` is an answer about the SOLVER, so
;      `undecided` must find it whether the status is spelled as a string or an
;      atom, and must carry the solver's own `why` beside it.
;   4. AN ATOM MINTED FROM DATA. Keys are canonicalised against the FIXED set;
;      anything else is refused — and the refusal must not have interned the
;      arbitrary text as a persistent atom.
;
; The rollup is VM-global by design, so this suite assumes the SEQUENTIAL runner
; (`bl test` default; not the file-parallel `--async`): it resets the rollup
; before and after every test so no other test sees or leaves counts.
;
; Run: bl test test/bl/system/ledger_test.bl

(ns system.ledger-test
  (:require [system.ledger :as ledger]))

;; ── 1: a decision is fragment + tier + status + cost ────────────────────────

(deftest a-decision-records-fragment-tier-status-and-cost
  (ledger/reset)
  (try
    (ledger/record :arith :native-witness "sat" 12 nil)
    (ledger/record :general :oracle "unknown" 340 "timeout")
    (testing "the trail keeps one map per decision, oldest first"
      (let [h (ledger/here)]
        (is (= 2 (count h)) "two decisions, two entries")
        (is (= {:fragment :arith :tier :native-witness :status "sat" :us 12 :why nil}
               (first h))
            "the fragment, tier, status and cost all travel with the decision")
        (is (= {:fragment :general :tier :oracle :status "unknown" :us 340 :why "timeout"}
               (second h))
            "and an undecided entry keeps the solver's own reason")))
    (testing "the rollup counts the fragment, the tier and the total"
      (let [hist (ledger/histogram)]
        (is (= 2 (:total hist)) "both decisions counted")
        (is (= {:tag-lattice 0 :arith 1 :general 1} (:fragments hist))
            "every fragment slot is present, a missing one visibly zero")
        (is (= {:native-witness 1 :oracle 1 :memo 0} (:tiers hist))
            "and every tier slot too")))
    (testing "cost reads the trail's microseconds"
      (is (= {:count 2 :total_us 352 :max_us 340} (ledger/cost))
          "count, sum and max — the shape a deadline is chosen from"))
    (testing "the two-arg form records a decision with no status or cost"
      (ledger/reset)
      (ledger/record :general :memo)
      (is (= {:fragment :general :tier :memo :status nil :us nil :why nil}
             (first (ledger/here))))
      (is (= {:count 1 :total_us 0 :max_us 0} (ledger/cost))
          "a nil cost reads as zero, not as nothing"))
    (finally (ledger/reset))))

;; ── 2: an unknown status is attributed to the solver, with its why ──────────

(deftest undecided-attribution-finds-both-spellings
  (ledger/reset)
  (try
    (ledger/record :arith :oracle "sat" 5 nil)
    (ledger/record :general :oracle "unknown" 11 "timeout")           ; string spelling
    (ledger/record :tag-lattice :native-witness :unknown 7 "memout")  ; atom spelling
    (testing "only the decisions the solver could not make are undecided"
      (let [u (ledger/undecided)]
        (is (= 2 (count u)) "both unknowns, and neither of the decided ones")
        (is (= "timeout" (:why (first u))) "oldest first — the string spelling matched")
        (is (= "memout" (:why (second u))) "and the atom spelling matched too")))
    (testing "the decided decision stays in the trail"
      (is (= 3 (count (ledger/here))))
      (is (= {:count 3 :total_us 23 :max_us 11} (ledger/cost))
          "cost covers every decision, decided or not"))
    (finally (ledger/reset))))

;; ── 3: reset zeroes the rollup and clears this process's trail ──────────────

(deftest reset-zeroes-the-rollup-and-clears-the-trail
  (ledger/reset)
  (try
    (ledger/record :general :memo "unsat" 9 "cached")
    (is (= 1 (:total (ledger/histogram))) "a record landed first")
    (is (= 1 (count (ledger/here))))
    (ledger/reset)
    (testing "the rollup is all zeroes, every slot still present"
      (is (= 0 (:total (ledger/histogram))))
      (is (= {:tag-lattice 0 :arith 0 :general 0} (:fragments (ledger/histogram))))
      (is (= {:native-witness 0 :oracle 0 :memo 0} (:tiers (ledger/histogram)))))
    (testing "and the trail is gone"
      (is (empty? (ledger/here)))
      (is (empty? (ledger/undecided)))
      (is (= {:count 0 :total_us 0 :max_us 0} (ledger/cost))))
    (finally (ledger/reset))))

;; ── 4: a key outside the fixed set is refused, never interned ───────────────

(deftest a-key-outside-the-fixed-set-is-refused-not-interned
  (ledger/reset)
  (try
    (ledger/record :arith :oracle "sat" 1 nil)
    (let [before (ledger/histogram)]
      (is (thrown? (ledger/record :not-a-ledger-key :oracle "sat"))
          "an unknown FRAGMENT is refused")
      (is (= before (ledger/histogram))
          "and the refusal changed no counter — a refused record is not a decision"))
    (let [before (ledger/histogram)]
      (is (thrown? (ledger/record :arith :not-a-tier "sat"))
          "an unknown TIER is refused")
      (is (= before (ledger/histogram))
          "a rejected tier must not partially increment the fragment"))
    (let [k (str "ledger-unknown-key-" (erlang/unique_integer (list :positive)))]
      (is (thrown-with-msg? "unknown ledger key" (ledger/record k :oracle "sat"))
          "arbitrary TEXT is refused, not taken as a key")
      (is (not (try (do (erlang/binary_to_existing_atom k :utf8) true)
                    (catch e false)))
          "and the refused text was never interned as a persistent atom"))
    (finally (ledger/reset))))

;; ── 5: concurrency — atomic rollup, process-local trail ─────────────────────

(deftest concurrent-increments-are-atomic-and-trails-are-process-local
  (ledger/reset)
  (try
    (let [workers 8
          per-worker 400
          total (* workers per-worker)
          parent (erlang/self)
          worker (fn [i]
                   (erlang/spawn
                     (fn []
                       (loop [k 0]
                         (if (= k per-worker)
                           (erlang/send parent
                                        [:done i
                                         (count (ledger/here))
                                         (:count (ledger/cost))])
                           (do (ledger/record :arith :native-witness "sat" 1 nil)
                               (recur (inc k))))))))
          _ (vec (map worker (to-list [0 1 2 3 4 5 6 7])))
          collect (fn [want]
                    (loop [acc [] k 0]
                      (if (= k want)
                        acc
                        (let [m (receive [:done i trail cost] [i trail cost]
                                         (after 60000 :timeout))]
                          (if (= m :timeout)
                            acc
                            (recur (conj acc m) (inc k)))))))
          got (collect workers)]
      (is (= workers (count got))
          "every worker checked in — a missing report means the instrument, not the ledger")
      (is (every? (fn [r] (= per-worker (get r 1))) got)
          "each worker's OWN trail holds exactly its own records")
      (is (every? (fn [r] (= per-worker (get r 2))) got)
          "and its own cost counts the same decisions")
      (testing "the shared rollup lost nothing"
        (let [hist (ledger/histogram)]
          (is (= total (:total hist)) "workers x records, none lost")
          (is (= total (get-in hist [:fragments :arith])) "the fragment counted every record")
          (is (= total (get-in hist [:tiers :native-witness])) "so did the tier")
          (is (= 0 (get-in hist [:fragments :general])))
          (is (= 0 (get-in hist [:tiers :memo])))))
      (testing "the parent's trail is untouched — the trail belongs to the process"
        (is (empty? (ledger/here)))
        (is (= {:count 0 :total_us 0 :max_us 0} (ledger/cost)))))
    (finally (ledger/reset))))
