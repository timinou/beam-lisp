; test/bl/system/anf_smt_test.bl — translating bl-ANF (not surface syntax) to
; an SMT formula, and inlining proven-pure helpers.
;
; The win over the surface translator: it can SEE THROUGH a call. A guard that
; calls a pure helper is opaque to the surface translator (:untranslatable) —
; the transition it guards would be silently dropped (the Phase-4 soundness
; hole). The ANF translator inlines the helper's body, so the invariant is
; modelled through the abstraction.
(ns system.anf-smt-test
  (:require [system.smt :as smt] [z3]))

(def prog "(defn margin [b r] (erlang/- b r))\n(defn safe? [b] (erlang/>= b 0))")

; ── parity: on plain arithmetic, ANF and surface agree ──────────────────────

(deftest parity-on-plain-arithmetic
  (testing "a guard with no call translates the same via ANF as via surface"
    (is (= '(>= balance 0)
           (smt/of-source-inlining prog ["balance"] "(erlang/>= balance 0)"))
        "ANF translation")
    (is (= '(>= balance 0)
           (smt/of-source #{"balance"} "(>= balance 0)"))
        "surface translation agrees")))

; ── the win: inline a pure helper the surface translator cannot see ─────────

(deftest surface-cannot-see-through-a-call
  (testing "a helper-computed predicate is untranslatable to the surface layer"
    (is (= :untranslatable (smt/of-source #{"balance"} "(safe? balance)"))
        "surface: opaque call")))

(deftest anf-inlines-a-pure-helper
  (testing "the ANF translator inlines safe? into the formula"
    (is (= '(>= balance 0)
           (smt/of-source-inlining prog ["balance"] "(safe? balance)"))
        "safe? inlined to (>= balance 0)")))

(deftest anf-inlines-a-nested-pure-helper
  (testing "a helper used inside a comparison is inlined in place"
    (is (= '(>= (- balance reserved) 0)
           (smt/of-source-inlining prog ["balance" "reserved"]
                         "(erlang/>= (margin balance reserved) 0)"))
        "(margin b r) inlined to (- b r)")))

; ── end-to-end: an invariant PROVEN through a helper, via z3 ─────────────────

(deftest invariant-preserved-through-helper-proven
  (testing "I=margin>=0; withdraw guarded by amt<=margin preserves I (unsat)"
    (let [inv (smt/of-source-inlining prog ["balance" "reserved"]
                            "(erlang/>= (margin balance reserved) 0)")
          inv-post (smt/of-source-inlining prog ["bpost" "reserved"]
                                 "(erlang/>= (margin bpost reserved) 0)")
          guard (smt/of-source-inlining prog ["balance" "reserved" "amt"]
                              "(erlang/=< amt (margin balance reserved))")
          port (z3/open)
          cmds (list
                 (list 'declare-const 'balance 'Int)
                 (list 'declare-const 'reserved 'Int)
                 (list 'declare-const 'amt 'Int)
                 (list 'declare-const 'bpost 'Int)
                 (list 'assert inv)
                 (list 'assert (list '>= 'amt 0))
                 (list 'assert guard)
                 (list 'assert (list '= 'bpost (list '- 'balance 'amt)))
                 (list 'assert (list 'not inv-post)))]
      (is (= "unsat" (z3/check port cmds))
          "the invariant is preserved through the helper"))))

(deftest negative-control-invariant-can-break
  (testing "without the guard, the invariant can break (sat)"
    (let [inv (smt/of-source-inlining prog ["balance" "reserved"]
                            "(erlang/>= (margin balance reserved) 0)")
          inv-post (smt/of-source-inlining prog ["bpost" "reserved"]
                                 "(erlang/>= (margin bpost reserved) 0)")
          port (z3/open)
          cmds (list
                 (list 'declare-const 'balance 'Int)
                 (list 'declare-const 'reserved 'Int)
                 (list 'declare-const 'amt 'Int)
                 (list 'declare-const 'bpost 'Int)
                 (list 'assert inv)
                 (list 'assert (list '>= 'amt 0))
                 (list 'assert (list '= 'bpost (list '- 'balance 'amt)))
                 (list 'assert (list 'not inv-post)))]
      (is (= "sat" (z3/check port cmds))
          "z3 finds a counterexample when the guard is dropped"))))
