; test/bl/system/smt_quot_rem_test.bl — quot/rem fragment closure + soundness.
;
; system.smt now translates beam-lisp `quot`/`rem` (BEAM/C TRUNCATED division)
; into SMT built from z3's EUCLIDEAN div/mod. Those two disagree on negative
; operands, so the translation is only sound if it reconstructs truncation
; EXACTLY. This file pins both halves:
;   1. CLOSURE  — quot/rem translate (no longer :untranslatable), and the
;      emitted string is the expected reconstruction.
;   2. SOUNDNESS — z3 PROVES the emitted encoding IS truncated division: it
;      satisfies the three laws that uniquely characterize trunc-div
;      (a=b·q+r, |r|<|b|, sign(r)=sign(a)) for ALL a,b≠0. This is the guardrail
;      against a translation that quietly reasons about a different function.
;   3. PAYOFF   — the acid-shell u32-le→read-u32 roundtrip, whose encode half is
;      all quot/rem, is now z3-PROVEN the identity ∀ n∈[0,2^32) — the property
;      that used to only sample (:witnessed).

(ns system.smt-quot-rem-test
  (:require [system.smt :as smt] [smt :as smtlib] [z3]))

; W6: of-source returns a DATA FORM (or :untranslatable). smt/emit is the one
; form→SMT-LIB-text crossing, so string assertions render through it.
(defn- tx [src] (smt/of-source #{"a" "b" "n"} src))
(defn- txs [src] (smtlib/emit (tx src)))
(defn- ok? [src] (not (= :untranslatable (tx src))))

; ── 1. CLOSURE: quot/rem translate ──────────────────────────────────────────

(deftest quot-translates
  (is (ok? "(quot a b)"))
  (is (ok? "(quot n 256)")))

(deftest rem-translates
  (is (ok? "(rem a b)"))
  (is (ok? "(rem n 256)")))

(deftest quot-emits-truncation-reconstruction
  ; quot a b = (div a b) + sign(b)-correction when a<0 ∧ (mod a b)>0
  (is (= "(+ (div a b) (ite (and (< a 0) (> (mod a b) 0)) (ite (> b 0) 1 (- 1)) 0))"
         (txs "(quot a b)"))))

(deftest rem-emits-division-identity
  ; rem a b = a − b·(quot a b)
  (is (= "(- a (* b (+ (div a b) (ite (and (< a 0) (> (mod a b) 0)) (ite (> b 0) 1 (- 1)) 0))))"
         (txs "(rem a b)"))))

; ── 2. SOUNDNESS: z3 proves the encoding IS truncated division ──────────────
;
; The three laws below UNIQUELY characterize truncated division; any function
; satisfying all three for every a,b≠0 rounds toward zero with a
; dividend-signed remainder — exactly BEAM/C `quot`/`rem`. z3 unsat on their
; negation = a proof, not a sample.

(deftest encoding-is-truncated-division
  (let [port (z3/open)
        q (txs "(quot a b)")
        r (txs "(rem a b)")
        prelude (str "(declare-const a Int)\n(declare-const b Int)\n"
                     "(assert (not (= b 0)))\n")]
    (is (= "unsat"
           (z3/check port
             (str prelude
                  "(assert (not (and "
                  "(= a (+ (* b " q ") " r "))"            ; (1) a = b·q + r
                  "(< (abs " r ") (abs b))"                 ; (2) |r| < |b|
                  "(or (= " r " 0) (and (> a 0) (> " r " 0)) (and (< a 0) (< " r " 0)))"  ; (3) sign
                  ")))\n"))))))

; ── 3. PAYOFF: the u32 roundtrip is now PROVEN, not sampled ──────────────────

(deftest u32-roundtrip-proven-symbolically
  (let [port (z3/open)
        ; each lane is (rem (quot n 2^k) 256), translated through the real smt
        lane (fn [shift] (txs (str "(rem (quot n " shift ") 256)")))
        l0 (txs "(rem n 256)")
        recomb (str "(+ " l0
                    " (* 256 " (lane 256) ")"
                    " (* 65536 " (lane 65536) ")"
                    " (* 16777216 " (lane 16777216) "))")]
    (is (= "unsat"
           (z3/check port
             (str "(declare-const n Int)\n"
                  "(assert (>= n 0))\n(assert (<= n 4294967295))\n"
                  "(assert (not (= " recomb " n)))\n"))))))

(run-tests)
