(ns system.suspension-test
  (:require [system.suspension :as suspension] [system.ir :as ir]))
(defn node [source]
  (BeamLisp.Ns.Compiler/compile (BeamLisp.Ns.Reader/read_one source)
    (BeamLisp.Ns.Compiler/new_env "proof")))
(defn leaves [site] (= :erlang (:mod site)))
(deftest synchronous-is-not-pure-and-closure-creation-is-not-execution
  (is (suspension/function-synchronous? (node "(fn [x] (erlang/+ x 1))") leaves))
  (let [waiting (node "(fn [] (receive x x))")]
    (is (suspension/synchronous? waiting leaves) "creating the callback does not receive")
    (is (not (suspension/function-synchronous? waiting leaves)) "running it would suspend")
    (is (not (suspension/function-synchronous? (assoc waiting :ann {:synchronous true}) leaves))
        "an authored annotation cannot forge a proof")))
(deftest later-arities-and-unknown-callees-fail-closed
  (is (not (suspension/function-synchronous? (node "(fn ([x] x) ([x y] (receive m m)))") leaves)))
  (is (not (suspension/function-synchronous? (node "(fn [handler] (handler 1))") leaves)))
  (is (suspension/function-synchronous?
        (node "(fn [x] (let [f (fn [y] (erlang/+ y 1))] (f x)))") leaves)))
(deftest hidden-suspension-propagates-through-the-whole-call-graph
  (let [definitions {"a" (node "(fn [] (b))") "b" (node "(fn [] (receive x x))")}
        report (suspension/analyze definitions
                 (fn [models] (fn [site] (get models (:name (:callee site)) false))))]
    (is (:converged report))
    (is (= {"a" false "b" false} (:proofs report)))))
(deftest canonical-rewrite-does-not-execute-or-rewrite-literal-data
  (let [value {:op :global :ns "data" :name "unchanged"}
        literal {:op :lit :val value :ann {:op :global :ns "annotation"}}
        rewritten (ir/rewrite (fn [n] (if (= :global (:op n)) (assoc n :ns "wrong") n)) literal)]
    (is (= literal rewritten))
    (is (= 1.50M (:val (ir/rewrite identity {:op :lit :val 1.50M}))))))
