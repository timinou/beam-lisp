; test/bl/system/lsp_cli_test.bl — the `bl lsp` terminal report.
;
; lsp.cli/report renders the language server's analysis (lsp.bl) for a terminal:
; diagnostics + a per-definition summary with the compiler's proof badges. These
; tests exercise the render path and the badge logic over a small program.
(ns system.lsp-cli-test
  (:require [lsp.cli :as lc] [lsp]))

(def prog
  (str "(defn add [x y] (erlang/+ x y))\n"
       "(defn step [p] (erlang/* (add p 1) 2))\n"
       "(defn noisy [x] (do (IO/puts \"hi\") x))"))

(deftest report-returns-diagnostic-count
  (testing "report returns the number of diagnostics (0 = clean)"
    (is (= 0 (lc/report prog "demo")) "a clean program reports zero diagnostics")))

(deftest native-eligibility-flows-interprocedurally
  (testing "step is native-eligible because add (its only callee) is pure"
    (is (:eligible (lsp/native-eligible prog "step")) "step: pure via pure callee")
    (is (:eligible (lsp/native-eligible prog "add")) "add: leaf pure")))

(deftest impure-fn-is-not-native-eligible
  (testing "noisy does IO, so it is refused with a named reason"
    (let [e (lsp/native-eligible prog "noisy")]
      (is (not (:eligible e)) "noisy: not eligible")
      (is (= :impure (:reason e)) "the theorem that failed is named"))))

(deftest document-symbols-carry-proven-facts
  (testing "each symbol carries its return type, purity, termination, callees"
    (let [syms (into {} (map (fn [s] [(:name s) s]) (into [] (lsp/document-symbols prog))))]
      (is (:pure (get syms "add")) "add is pure")
      (is (not (:pure (get syms "noisy"))) "noisy is not pure")
      (is (some (fn [c] (= c "add")) (:calls (get syms "step"))) "step calls add"))))
