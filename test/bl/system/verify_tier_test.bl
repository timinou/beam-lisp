; test/bl/system/verify_tier_test.bl — the tool entry reports WHICH TIER answered,
; and a proof is never attributed to the cheap rung.
;
; `code/verify` is the one place the ledger's trail reaches a caller, and the place
; where a wrong attribution is worst: an agent reading `:tier :native-witness` on a
; "holds" verdict would believe a bounded BEAM search discharged an obligation that
; only z3 could. The three rules the entry obeys, all pinned below:
;
;   holds           → :oracle, whatever this process's trail saw
;   violated / etc. → the WEAKEST rung that appears in the trail
;   empty trail     → :oracle, one notch more careful than the trail alone would say
;
; The trail is per-process and the verify path evaluates lazily, so it can
; legitimately MISS checks that ran elsewhere. Under-reporting z3's part in a PROOF
; is the dangerous direction; the first rule closes it by construction, so this test
; does not depend on the trail being complete.

(ns mcp.z3.verify-tier.test
  (:require [mcp.tools :as tools]))

(def ^:private holds-src
  "(defserver ^{:invariant (>= balance 0)} account (init [balance] (ok balance)) (handle-call [:withdraw amt] [_ balance] :when (and (>= amt 0) (>= balance amt)) (reply :ok (- balance amt))))")

;; the guard `(>= balance amt)` is gone, so a withdraw of more than the balance is
;; legal and the invariant is reachable-false — z3 answers with a counterexample.
(def ^:private violated-src
  "(defserver ^{:invariant (>= balance 0)} account (init [balance] (ok balance)) (handle-call [:withdraw amt] [_ balance] :when (>= amt 0) (reply :ok (- balance amt))))")

;; no ^{:invariant} at all: nothing to prove, and nothing to attribute either.
(def ^:private unchecked-src
  "(defserver account (init [balance] (ok balance)) (handle-call [:withdraw amt] [_ balance] (reply :ok (- balance amt))))")

(deftest a-proof-is-never-attributed-to-the-native-rung
  (let [out (tools/code-verify-handler {"source" holds-src})]
    (is (= "holds" (:verdict out)))
    (is (= :oracle (:tier out))
        "a holds verdict means an UNSAT was proved; the native rung never claims unsat")
    (is (contains? out :tiers) "the trail goes out with the verdict, even when empty")))

(deftest a-counterexample-carries-the-fragment-that-found-it
  (let [out (tools/code-verify-handler {"source" violated-src})
        tiers (:tiers out)]
    (is (= "violated" (:verdict out)))
    (is (sequential? tiers) "the trail is a sequence of entries")
    (is (every? (fn [e] (contains? e :fragment)) tiers)
        "each entry names the fragment that was checked")
    (is (every? (fn [e] (contains? e :tier)) tiers)
        "and the rung that answered it")
    ;; this source is pure linear arithmetic, so if the rung spoke at all it was
    ;; answering the arith fragment — and z3 was consulted regardless.
    (is (= :oracle (:tier out)))))

(deftest an-unchecked-question-claims-nothing-cheaper-either
  (let [out (tools/code-verify-handler {"source" unchecked-src})]
    (is (= "unchecked" (:verdict out)))
    (is (= :oracle (:tier out))
        "with no observation at all the weakest claim is the oracle's, never native")))
