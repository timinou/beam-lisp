; test/bl/system/lint_test.bl — the `bl lint` verb.
;
; bl.lint finds the deodorant smells in a source and reports each with the rule
; that matched, its tier, the line the form starts on, and the before/after
; text. These tests pin the tier mapping, the position of a smell, the count's
; agreement with deodorant's own report, and the exit codes of `run`.
;
; Run: mix bl test test/bl/system/lint_test.bl
(ns system.lint-test
  (:require [bl.lint :as lint] [deodorant]))

(defn- capture
  "Run `f` with this process's group leader on a StringIO, so `run`'s output is
   a value here. Returns a two-element list of the return value and the
   captured output; restores the leader in a finally."
  [f]
  (let [prev (Process/group_leader)
        dev (erlang/element 2 (StringIO/open ""))]
    (Process/group_leader (erlang/self) dev)
    (let [r (try (f) (finally (Process/group_leader (erlang/self) prev)))]
      (list r (erlang/element 2 (StringIO/contents dev))))))

; ── tiers ─────────────────────────────────────────────────────────────

(deftest tier-rules-map-the-three-tiers
  (testing "nil and \"idiomatic\" are the default safe+idiomatic set"
    (is (= (count (deodorant/all-rules)) (count (lint/tier-rules nil))))
    (is (= (count (deodorant/all-rules)) (count (lint/tier-rules "idiomatic")))))
  (testing "safe is the value-identical rules alone"
    (is (= (count (deodorant/safe-rules)) (count (lint/tier-rules "safe")))))
  (testing "every adds the reinvention tier"
    (is (= (count (deodorant/all-smells)) (count (lint/tier-rules "every"))))
    (is (> (count (lint/tier-rules "every")) (count (lint/tier-rules nil)))))
  (testing "an unknown tier is nil, so run reports a usage error"
    (is (nil? (lint/tier-rules "bogus")))))

; ── finding one smell ─────────────────────────────────────────────────

(def src "(defn f [p a b]\n  (if (not p) a b))\n")

(deftest lint-source-finds-a-smell-with-its-line
  (let [report (lint/lint-source (deodorant/all-rules) "t.bl" src)
        smells (:smells report)
        s (first (filter (fn [x] (= "if→if-not" (:name x))) smells))]
    (is (= 1 (count smells)) "one smell in the source")
    (is (some? s) "the if-not smell is found")
    (is (= "safe" (name (:tier s))) "it is a safe rule")
    (is (= 2 (:line s)) "the matched form starts on line 2")
    (is (= "(if (not p) a b)" (:before s)))
    (is (= "(if-not p a b)" (:after s)))
    (is (= "t.bl" (:path report)))))

; ── a map argument must not hide the smell ────────────────────────────

(def map-src "(defn g [m]\n  (Map/get m :k {}))\n")

(deftest a-map-argument-still-reports
  (testing "the count equals deodorant's own report for the same source"
    (let [rules (deodorant/all-rules)
          smells (:smells (lint/lint-source rules "m.bl" map-src))]
      (is (= 1 (count smells)) "one smell: the defaulted map get")
      (is (= (lint/smell-count rules map-src) (count smells))
          "the walk covers the same surface deodorant/report-source covers")
      (is (= "(Map/get m :k {})" (:before (first smells))))
      (is (= "(get m :k {})" (:after (first smells)))))))

; ── the render ────────────────────────────────────────────────────────

(deftest render-names-the-path-and-the-totals
  (let [report {:files [(lint/lint-source (deodorant/all-rules) "t.bl" src)] :total 1}
        out (lint/render report)]
    (is (includes? out "t.bl") "the path is in the report")
    (is (includes? out "if→if-not") "the rule is named")
    (is (includes? out "1 smell in 1 file") "the tally closes the report")))

; ── an advisory rule: a nested per-row rescan ─────────────────────────

(def nested-src
  (str "(defn mismatches [db]\n"
       "  (datom/q '[:find ?caller\n"
       "            :where\n"
       "            [?c :call/caller ?caller]\n"
       "            [:not-join [?callee] [?d :fn/name ?callee]]]\n"
       "           db))\n"))

(deftest advisory-smell-has-a-note-and-no-after
  (let [report (lint/lint-source (deodorant/all-rules) "n.bl" nested-src)
        s (first (filter (fn [x] (= "datalog/nested-scan" (:name x))) (:smells report)))]
    (is (some? s) "the nested scan is reported, namespace and all")
    (is (= "idiomatic" (name (:tier s))))
    (is (nil? (:after s)) "an advisory rule has no local rewrite")
    (is (some? (:note s)) "it carries its note instead")
    (let [out (lint/render {:files [report] :total (count (:smells report))})]
      (is (includes? out "datalog/nested-scan"))
      (is (includes? out "note:")))))

; ── run ───────────────────────────────────────────────────────────────

(defn- tmp-file [name content]
  (let [dir (str (System/tmp_dir!) "/bl_lint_" (erlang/unique_integer (list :positive)))]
    (File/mkdir_p! dir)
    (let [p (str dir "/" name)]
      (File/write! p content)
      p)))

(deftest run-exits-one-on-a-smell-and-zero-on-a-clean-file
  (let [dirty (tmp-file "dirty.bl" src)
        clean (tmp-file "clean.bl" "(defn f [x] (inc x))\n")]
    (try
      (is (= 1 (first (capture (fn [] (lint/run (list dirty) {:json false})))))
          "a smell is a failure exit")
      (is (= 0 (first (capture (fn [] (lint/run (list clean) {:json false})))))
          "a clean file is ok")
      (is (= 2 (first (capture (fn [] (lint/run (list dirty) {:tier "bogus"})))))
          "an unknown tier is a usage error")
      (finally (File/rm_rf! (Path/dirname dirty))))))
