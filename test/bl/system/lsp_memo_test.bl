; test/bl/system/lsp_memo_test.bl — the content memo behind the LSP requests.
;
; Every request in lsp.bl is a pure function of the source text, and the
; whole-program analysis behind them used to run per CALL: `bl lsp check FILE`
; asked for it once per symbol, so a 133-defn file paid 133 analyses. The memo is
; keyed by the source's SHA-256 — the key IS the bytes — and bounded to a few
; sources.
;
; These tests assert that contract deterministically, off `lsp/memo-stats`
; (occupancy plus real compute counts), never off a stopwatch. A build-count test
; names a source no other test analyzes, so its delta is its own.
(ns system.lsp-memo-test
  (:require [lsp]
            [lsp.cli :as lc]
            [lsp.rpc :as rpc]
            [data.bounded-cache :as cache]
            [system.typecheck :as tc]))

; The reuse counters measure stable engine inputs. Runtime initialization is
; tested separately; introducing a provider may conservatively decline caching.
(BeamLisp.Loader/ensure_loaded "lsp.cli")
(lsp/check-document "(defn memo-engine-initialization [x] x)" "memo-engine-initialization")

(def src-a
  (str "(defn add [x y] (erlang/+ x y))\n"
       "(defn step [p] (erlang/* (add p 1) 2))\n"
       "(defn noisy [x] (do (IO/puts \"hi\") x))"))

; ── one analysis per source ────────────────────────────────────────────────

(deftest analyzed-is-built-once-per-source
  (testing "two calls for the same text share ONE whole-program analysis"
    (let [src "(defn mm-one [q] (erlang/+ q 1))"
          before (:builds (lsp/memo-stats))
          b1 (lsp/analyzed src)
          b2 (lsp/analyzed src)]
      (is (= 1 (- (:builds (lsp/memo-stats)) before)) "one build for two calls")
      (is (= b1 b2) "the same bundle comes back")
      (is (= b1 b2) "equal too, not merely shared")
      (is (map? (:known b1)) "the type checker's return table rides along"))))

(deftest distinct-sources-build-separately
  (testing "a text the memo has not seen is a real build"
    (let [before (:builds (lsp/memo-stats))]
      (lsp/analyzed "(defn mm-two [q] (erlang/+ q 1))")
      (lsp/analyzed "(defn mm-three [q] (erlang/* q 2))")
      (is (= 2 (- (:builds (lsp/memo-stats)) before)) "two texts, two builds"))))

(deftest project-scans-retain-more-than-four-files
  (testing "an unchanged six-file project does no new analysis on its second pass"
    (let [sources (mapv (fn [n] (str "(defn project-cache-" n " [x] (+ x " n "))")) (range 6))]
      (doseq [src sources] (lsp/analyzed src))
      (let [before (:builds (lsp/memo-stats))]
        (doseq [src sources] (lsp/analyzed src))
        (is (= before (:builds (lsp/memo-stats))) "no project-sized cache thrash")
        (is (>= (:analyzed (lsp/memo-stats)) 6)))
      (is (<= (:bytes (lsp/memo-stats)) (:max-bytes (lsp/memo-stats)))
          "retention obeys the shared byte budgets"))))

(deftest summary-consumers-do-not-request-growth
  (let [before (:growth-builds (lsp/memo-stats))]
    (is (= ["summary-only"] (map :name (lsp/function-summaries "(defn summary-only [x] x)"))))
    (is (= before (:growth-builds (lsp/memo-stats))))))

(deftest a-small-document-does-not-retain-an-expanded-context-tree
  (let [before (:bytes (cache/stats :lsp.analysis))]
    (lsp/analyzed "(defn small-context-footprint [x] x)")
    (let [extra (- (:bytes (cache/stats :lsp.analysis)) before)]
      (is (> extra 0) "the small document was retained")
      (is (< extra 16384) (str "one small document retained " extra " bytes")))))

(deftest diagnostics-lowers-once
  (let [trace (tuple :Elixir.BeamLisp.Ns.System.Analyze :fn-bodies 1)]
    (erlang/trace_pattern trace true (list :local :call_count))
    (try
      (lsp/diagnostics "(defn shared-lowering-probe [x] (+ x 345))" "shared-lowering-probe")
      (is (= (tuple :call_count 1) (erlang/trace_info trace :call_count))
          "summary and linearity engines share one lowering")
      (finally (erlang/trace_pattern trace false (list :local :call_count))))))

(deftest outline-sharing-does-not-depend-on-cache-admission
  (cache/ready! :lsp.analysis)
  (let [owner (Process/whereis :lsp.analysis)
        trace (tuple :Elixir.BeamLisp.Ns.System.Analyze :fn-bodies 1)]
    (erlang/suspend_process owner)
    (erlang/trace_pattern trace true (list :local :call_count))
    (try
      (is (= ["outline-without-retention"]
             (mapv :name (lsp/document-symbols "(defn outline-without-retention [x] (+ x 8765))"))))
      (is (= (tuple :call_count 1) (erlang/trace_info trace :call_count))
          "facts and growth share the document even when retention declines")
      (finally
        (erlang/trace_pattern trace false (list :local :call_count))
        (erlang/resume_process owner)))))

; ── every request reads the memo ───────────────────────────────────────────

(deftest requests-share-one-bundle
  (testing "many requests for one text re-analyze nothing"
    (let [src "(defn only-here [q] (erlang/+ q 1))"
          before (:builds (lsp/memo-stats))]
      (lsp/hover src 1 8)
      (lsp/definition src 1 8)
      (lsp/completion src 1 1)
      (lsp/inlay-hints src)
      (lsp/signature-help src 1 8)
      (lsp/proof-hover src "only-here")
      (lsp/impact src "only-here")
      (lsp/dead-code src [])
      (is (= 1 (- (:builds (lsp/memo-stats)) before))
          "one build across eight requests"))))

(deftest diagnostics-analyzes-once
  (testing "tc, typed and lin ride ONE bundle per diagnostics call"
    (let [before (:builds (lsp/memo-stats))]
      (lsp/diagnostics "(defn mm-diag [q] (erlang/+ q 1))" "t")
      (is (= 1 (- (:builds (lsp/memo-stats)) before)) "exactly one analysis"))))

(deftest document-symbols-reuse-the-growth-walk
  (testing "the growth pass is memoized with the rest"
    (let [src "(defn mm-grow [q] (erlang/+ q 1))"
          before (:growth-builds (lsp/memo-stats))]
      (lsp/document-symbols src)
      (is (= 1 (- (:growth-builds (lsp/memo-stats)) before)) "one growth walk")
      (lsp/document-symbols src)
      (is (= (+ 1 before) (:growth-builds (lsp/memo-stats)))
          "a second outline walks nothing"))))

(deftest report-analyzes-once-not-per-symbol
  (testing "lsp.cli/report threads one bundle through every symbol badge"
    (let [src "(defn mm-rep [q] (erlang/+ q 1))"]
      (lsp/analyzed src)
      (let [before (:builds (lsp/memo-stats))]
        (lc/report src "demo")
        (is (= before (:builds (lsp/memo-stats))) "no analysis during the report")))))

; ── the bundle-taking variants agree with the source-taking ones ───────────

(deftest native-eligible-bundle-variant-matches
  (let [a (lsp/analyzed src-a)]
    (doseq [n ["add" "step" "noisy"]]
      (is (= (lsp/native-eligible src-a n) (lsp/native-eligible* a n))
          (str n " reads the same verdict from the bundle")))))

(deftest check-source-bundle-variant-matches
  (let [a (lsp/analyzed src-a)]
    (is (= (into [] (tc/check-source src-a))
           (into [] (tc/check-source* (:known a) (:bodies a))))
        "the bundled check is the very same warnings")))

; ── the server keeps the text, so the memo holds ───────────────────────────

(deftest the-server-does-not-defeat-the-memo
  (testing "didOpen + repeated requests over the SAME stored text analyze once"
    (let [[st1 _] (rpc/handle (rpc/initial-state)
                             {"jsonrpc" "2.0" "id" 1 "method" "initialize" "params" {}})
          [st2 _] (rpc/handle st1
                             {"jsonrpc" "2.0" "method" "textDocument/didOpen"
                              "params" {"textDocument" {"uri" "file:///memo.bl"
                                                        "text" "(defn served [q] (erlang/+ q 1))"
                                                        "version" 1}}})
          ; didOpen publishes diagnostics, which builds the bundle; every request
          ; after it must be a hit, because the doc stores the text once.
          before (:builds (lsp/memo-stats))]
      (rpc/handle st2 {"jsonrpc" "2.0" "id" 2 "method" "textDocument/hover"
                       "params" {"textDocument" {"uri" "file:///memo.bl"}
                                 "position" {"line" 0 "character" 8}}})
      (rpc/handle st2 {"jsonrpc" "2.0" "id" 3 "method" "textDocument/documentSymbol"
                       "params" {"textDocument" {"uri" "file:///memo.bl"}}})
      (rpc/handle st2 {"jsonrpc" "2.0" "id" 4 "method" "textDocument/references"
                       "params" {"textDocument" {"uri" "file:///memo.bl"}
                                 "position" {"line" 0 "character" 8}}})
      (is (= before (:builds (lsp/memo-stats)))
          "hover + symbols + references added no analysis"))))

(deftest definition-publication-invalidates-an-existing-bundle
  (let [src "(defn provider-cache-probe [x] (+ x 9))"]
    (lsp/analyzed src)
    (let [before (:builds (lsp/memo-stats))]
      (lsp/analyzed src)
      (is (= before (:builds (lsp/memo-stats))))
      (BeamLisp.Env/put_key (tuple "memo.unlisted-provider" "value") 1)
      (lsp/analyzed src)
      (is (= (inc before) (:builds (lsp/memo-stats))))
      (lsp/analyzed src)
      (is (= (inc before) (:builds (lsp/memo-stats)))))))
