(ns system.publication-closure-test
 (:require [system.publication-closure :as closure] [env]))
(defn fixture [source]
 (let [ns (str "closure.actual.p" (erlang/unique_integer (list :positive)))]
  (env/eval (str "(ns " ns ") " source)) ns))
(deftest actual-helper-and-global-value-closure
 (let [ns (fixture "(def answer 7) (defn helper [x] answer) (defn root [x] (helper x))")
       proof (closure/certificate ns "root")]
  (is (some? proof))
  (is (= 2 (count (:definitions proof))))
  (is (closure/valid? proof))
  (env/eval (str "(ns " ns ") (def answer 8)"))
  (is (not (closure/valid? proof)))
  (let [next (closure/certificate ns "root")]
   (is (some? next))
   (env/eval (str "(ns " ns ") (defn helper [x] x)"))
   (is (not (closure/valid? next))))))
(deftest dynamic-functions-and-resource-values-refuse
 (let [ns (fixture "(defn root [f x] (f x))")]
  (is (nil? (closure/certificate ns "root"))))
 (let [ns (fixture "(def held (atom 1)) (defn root [x] held)")]
  (is (nil? (closure/certificate ns "root")))))
(deftest recursion-is-finite-and-effects-are-not-hidden
 (let [ns (fixture "(defn root [x] (if x (root nil) x))")
       proof (closure/certificate ns "root")]
  (is (some? proof)) (is (= 1 (count (:definitions proof)))))
 (let [ns (fixture "(defn root [x] (erlang/send x :message))")
       proof (closure/certificate ns "root")]
  ;; Dependency completeness does not mean purity. The effect remains visible.
  (is (some? proof))
  (is (contains? (:remotes proof) [:erlang :send]))))
(deftest literal-callee-and-multiple-clauses-and-guards-participate
 (let [ns (fixture "(def gate 1) (defn helper [x] gate) (defn root ([x] x) ([x y] (helper y)))")
       proof (closure/certificate ns "root")]
  (is (some? proof))
  (is (= 2 (count (:definitions proof))))
  (env/eval (str "(ns " ns ") (def gate 2)"))
  (is (not (closure/valid? proof)))))

(deftest unrelated-publication-does-not-invalidate-closed-dependencies
 (let [ns (fixture "(def answer 7) (defn helper [x] answer) (defn root [x] (helper x))")
       proof (closure/certificate ns "root")]
  (is (some? proof))
  (fixture "(defn unrelated [x] x)")
  (is (closure/valid? proof))
  (env/eval (str "(ns " ns ") (defn independent [x] x)"))
  (is (closure/valid? proof))
  (env/eval (str "(ns " ns ") (def answer 9)"))
  (is (not (closure/valid? proof)))))
