(ns system.qualified-identity-test
  (:require [anf :as anf] [system.ir :as ir] [system.footprint :as fp]
            [system.summary :as summary] [system.smt :as smt] [termination :as term]))

(deftest qualified-resources-do-not-alias-an-unrelated-member
  (let [one (anf/global-exact "one" "value") two (anf/global-exact "two" "value")
        lexical (anf/global "one" "value")]
    (is (not= (ir/resource-of {} one) (ir/resource-of {} two)))
    (is (not= (ir/alias-for {} one) (ir/alias-for {} lexical)))))

(deftest a-foreign-function-does-not-inherit-a-local-functions-proof
  (let [call (anf/app (anf/global-exact "foreign" "identity") (list (anf/lit 1)))
        resolver (fn [name] (if (= "identity" name) {} :unknown))]
    (is (= {fp/opaque-world :W} (fp/fp-anf {} resolver call)))
    (is (= summary/all-tags (summary/returns-tag {"identity" #{:kw}} call)))
    (is (not (contains? (summary/calls-in call) "identity")))
    (is (= {} (fp/fp-anf {} resolver (anf/app (anf/global "local" "identity") (list (anf/lit 1))))))))

(deftest a-foreign-member-is-not-a-provers-builtin-by-spelling
  (let [call (anf/remote :Elixir.BeamLisp.Ns.Rt :invoke
                        (list (anf/global-exact "foreign" "str-len")
                              (anf/cons-cell (anf/lit "abc") anf/enil)))]
    (is (= :untranslatable (smt/translate-node {:env {} :variants {} :colls #{} :funs nil} call)))))


(deftest a-foreign-same-name-call-is-not-recursion-of-the-current-function
  (let [call (anf/remote :Elixir.BeamLisp.Ns.Rt :invoke
                        (list (anf/global-exact "foreign" "repeat") anf/enil))]
    (is (empty? (term/self-call-nodes call "repeat")))))
