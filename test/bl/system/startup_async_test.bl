(ns system.startup-async-test (:require [bl.loading :as loading]))

(deftest background-start-is-post-entry-and-concurrent-demand-initializes-once
 (let [root (Path/join (System/tmp_dir) (str "startup-async-" (erlang/unique_integer (list :positive))))
       ns (str "startup.warm.p" (erlang/unique_integer (list :positive)))
       source (Path/join root (str (String/replace ns "." "/") ".bl"))
       entry (Path/join root "entry.bl") marker (Path/join root "initialized")
       prior (System/get_env "STARTUP_ASYNC_ENV")
       policy {:loading {:environment-env "STARTUP_ASYNC_ENV" :development :async}}]
  (File/mkdir_p! (Path/dirname source))
  (File/write! source (str "(ns " ns ") (def initialized (File/write! " (pr-str marker)
                       " (System/get_env \"STARTUP_ASYNC_ENV\") (list :append))) (defn value [] 7)"))
  (File/write! entry (str "(ns warm.entry (:require [" ns "]))"))
  (try
   (System/put_env "STARTUP_ASYNC_ENV" "development")
   (BeamLisp.Loader/with_ambient_dirs (list root)
    (fn []
     ;; The entry has returned before serve invokes this hook.
     (is (not (File/exists? marker)))
     (let [pid (loading/start-background! policy entry)
           monitor (erlang/monitor :process pid)
           demand (BeamLisp.Env/convey (fn [_] (BeamLisp.Loader/ensure_loaded ns)))
           request (erlang/spawn_monitor (fn [] (demand nil)))]
       (receive [:DOWN monitor :process pid reason] (is (= :normal reason))
                (after 60000 (throw :warm-timeout)))
       (receive [:DOWN _ :process _ reason] (is (= :normal reason))
                (after 60000 (throw :demand-timeout)))
       (is (= "development" (File/read! marker))))))
   (System/put_env "STARTUP_ASYNC_ENV" "production")
   (is (nil? (loading/start-background! policy entry)))
   (System/put_env "STARTUP_ASYNC_ENV" "development")
   (is (nil? (loading/start-background! {:loading {:environment-env "STARTUP_ASYNC_ENV"}} entry)))
   (finally
    (if prior (System/put_env "STARTUP_ASYNC_ENV" prior) (System/delete_env "STARTUP_ASYNC_ENV"))
    (File/rm_rf! root)))))
