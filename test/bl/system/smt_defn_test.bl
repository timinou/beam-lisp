; test/bl/system/smt_defn_test.bl — a defn's BODY as an SMT function.
;
; The load-bearing claim: an arithmetic defn lowers to an SMT-LIB (define-fun …)
; whose meaning IS the function's computation. This is the seam that turns a
; STRUCTURAL check (does an input land in a clause?) into a FUNCTIONAL proof
; (does the function's OUTPUT satisfy a law for every input?). Single-clause
; bodies translate directly; multi-clause guarded defns fold to nested ite.

(ns system.smt-defn-test
  (:require [system.smt :as smt] [z3]))

; ── single clause, no guard: direct body translation ───────────────────────

(deftest single-clause-defines
  (let [d (smt/defn->define-fun "(defn floor [c] (if (< c 0) 0 c))" "Int")]
    (is (= "(define-fun floor ((c Int)) Int (ite (< c 0) 0 c))" d))))

; ── multi-clause guarded defn folds to nested ite ───────────────────────────

(deftest guarded-clauses-fold-to-ite
  (let [d (smt/defn->define-fun
            "(defn sign ([n] :when (pos? n) 1) ([n] :when (neg? n) -1) ([n] 0))" "Int")]
    ; last clause has no guard ⇒ the else; earlier guards nest outermost-first
    (is (= "(define-fun sign ((n Int)) Int (ite (> n 0) 1 (ite (< n 0) -1 0)))" d))))

; ── the define-fun is USABLE: prove a law over the function's output ────────

(deftest floor-output-is-nonnegative
  (let [port (z3/open)
        d (smt/defn->define-fun "(defn floor [c] (if (< c 0) 0 c))" "Int")]
    ; ∀ c. (floor c) ≥ 0 — a FUNCTIONAL proof over the real computation.
    (is (= "unsat"
           (z3/check port
             (str d "\n(declare-const c Int)\n(assert (not (>= (floor c) 0)))\n"))))))

(deftest floor-output-preserves-nonneg-input
  (let [port (z3/open)
        d (smt/defn->define-fun "(defn floor [c] (if (< c 0) 0 c))" "Int")]
    ; ∀ c ≥ 0. (floor c) = c — the floor is identity on the nonnegative half.
    (is (= "unsat"
           (z3/check port
             (str d "\n(declare-const c Int)\n(assert (>= c 0))\n(assert (not (= (floor c) c)))\n"))))))

; ── an untranslatable body returns :untranslatable (honest, no false def) ───

(deftest untranslatable-body-declines
  (is (= :untranslatable
         (smt/defn->define-fun "(defn weird [x] (frobnicate x 3))" "Int"))))

(run-tests)
