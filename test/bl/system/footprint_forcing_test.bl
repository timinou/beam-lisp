; footprint_forcing_test.bl — the op tables in system.footprint are CLAIMS about
; the runtime, so this file measures the runtime instead of trusting them.
;
; `rt-value-ops` claims: the op never forces a lazy seq in any argument
; position. `applying-ops` claims: the op may run a value the caller handed it
; (forces a lazy argument, or calls a fn argument). A claim of "value op" that
; the runtime contradicts would let a printing lazy producer read as pure; that
; is the soundness hole this file closes. It also pins the closed-world
; settlement in system.analyze: applying is charged to whoever created the
; applied value.

(ns system.footprint-forcing-test
  (:require [system.footprint :as fp]
            [system.analyze :as an]))

(defn- fresh-lazy [n] (lazy-seq (swap! n inc) (list 1 2 3)))

(defn- forces?
  "Did `f` run a value handed to it? Each probe gets the value twice over:
   as a fresh lazy seq (forcing runs its producer) and as a fn (calling runs
   it). Either running is what `applying-ops` means; a VALUE op does neither."
  [f]
  (let [n (atom 0)]
    (try (f (fresh-lazy n)) (catch e nil))
    (try (f (fn [& _] (swap! n inc) 1)) (catch e nil))
    (pos? @n)))

; One probe per argument position of every op classified as a VALUE op. The
; key is the [mod fun arity] the compiler emits for the surface call.
(def value-op-probes
  {[fp/rt :not_ 1] [not]
   [fp/rt :assoc 3] [#(assoc % 0 1) #(assoc {} % 1) #(assoc {} :k %)]
   [fp/rt :conj 2] [#(conj % 1) #(conj [] %)]
   [fp/rt :cons 2] [#(cons % nil) #(cons 1 %)]
   [fp/rt :get 2] [#(get % 0) #(get {} %)]
   [fp/rt :get 3] [#(get % 0 1) #(get {} % 1) #(get {} :k %)]
   [fp/rt :range 1] [#(range %)]
   [fp/rt :range 2] [#(range % 3) #(range 0 %)]
   [fp/core-mod :list__bl_v 1] [#(list %) #(list 1 %)]
   [fp/rt :repeat 2] [#(repeat 2 %)]
   [:Elixir.BeamLisp.Set :new 1] [#(hash-set %) #(BeamLisp.Set/new (list 1 %))]
   [fp/rt :hash_key 1] [#(BeamLisp.Ns.Rt/hash_key %) #(BeamLisp.Ns.Rt/hash_key [%]) #(BeamLisp.Ns.Rt/hash_key {:a %})]
   [fp/rt :coll? 1] [coll?] [fp/rt :float? 1] [float?] [fp/rt :fn? 1] [fn?]
   [fp/rt :int? 1] [int?] [fp/rt :keyword? 1] [keyword?] [fp/rt :map? 1] [map?]
   [fp/rt :number? 1] [number?] [fp/rt :seq? 1] [seq?] [fp/rt :sequential? 1] [sequential?]
   [fp/rt :set? 1] [set?] [fp/rt :string? 1] [string?] [fp/rt :vector? 1] [vector?]
   [fp/rt :even? 1] [even?] [fp/rt :odd? 1] [odd?] [fp/rt :neg? 1] [neg?]
   [fp/rt :pos? 1] [pos?] [fp/rt :zero? 1] [zero?]
   [fp/core-mod :abs 1] [abs] [fp/core-mod :boolean? 1] [boolean?]
   [fp/core-mod :dec 1] [dec] [fp/core-mod :inc 1] [inc]
   [fp/core-mod :dissoc 2] [#(dissoc % :a) #(dissoc {} %)]
   [fp/core-mod :identity 1] [identity]
   [fp/core-mod :max 2] [#(max % 1) #(max 1 %)] [fp/core-mod :min 2] [#(min % 1) #(min 1 %)]
   [fp/core-mod :mod 2] [#(mod % 2) #(mod 2 %)] [fp/core-mod :quot 2] [#(quot % 2) #(quot 2 %)]
   [fp/core-mod :nil? 1] [nil?] [fp/core-mod :some? 1] [some?] [fp/core-mod :type 1] [type]
   [fp/core-mod :ex-data 1] [ex-data] [fp/core-mod :ex-info 2] [#(ex-info % {}) #(ex-info "m" %)]
   [fp/core-mod :trim 1] [trim] [fp/core-mod :index-of 2] [#(index-of % "a") #(index-of "a" %)]
   [fp/core-mod :upper-case 1] [upper-case] [fp/core-mod :lower-case 1] [lower-case]
   [fp/core-mod :comp 0] [(fn [_] (comp))] [fp/core-mod :comp 1] [#(comp %)]
   [fp/core-mod :comp 2] [#(comp % %)] [fp/core-mod :comp 3] [#(comp % % %)]
   [fp/core-mod :comp__bl_v 4] [#(comp % % % %)]
   [fp/core-mod :juxt 1] [#(juxt %)] [fp/core-mod :juxt 2] [#(juxt % %)]
   [fp/core-mod :juxt 3] [#(juxt % % %)] [fp/core-mod :juxt__bl_v 4] [#(juxt % % % %)]
   [fp/core-mod :partial 1] [#(partial %)] [fp/core-mod :partial 2] [#(partial % 1) #(partial inc %)]
   [fp/core-mod :partial 3] [#(partial % 1 2) #(partial + %  2)]
   [fp/core-mod :partial 4] [#(partial % 1 2 3) #(partial + 1 2 %)]
   [fp/core-mod :partial__bl_v 5] [#(partial % 1 2 3 4) #(partial + 1 2 3 %)]
   [fp/core-mod :complement 1] [complement] [fp/core-mod :constantly 1] [constantly]})

(deftest building-a-combinator-calls-nothing
  ; forcing is one way a value runs; CALLING a fn argument is the other.
  ; A combinator only builds a closure: none of its fn arguments may run yet.
  (let [calls (atom 0)
        g (fn [x] (swap! calls inc) x)]
    (comp g g) (comp g g g) (comp g g g g) (juxt g) (juxt g g g g) (partial g 1)
    (partial g 1 2 3 4) (complement g) (constantly g)
    (is (zero? @calls))))

(deftest every-value-op-is-measured
  (testing "the probe table covers rt-value-ops exactly (no unmeasured claim)"
    (let [claimed (set (filter (fn [[m _ _]] (or (= m fp/rt) (= m fp/core-mod) (= m :Elixir.BeamLisp.Set)))
                               fp/rt-value-ops))]
      (is (= claimed (set (keys value-op-probes)))))))

(deftest value-ops-never-force
  (doseq [[op probes] value-op-probes]
    (doseq [p probes]
      (is (not (forces? p)) (str (pr-str op) " forced a lazy argument but is classified as a value op")))))

(deftest applying-ops-are-not-value-ops
  (is (empty? (filter (fn [op] (contains? fp/rt-value-ops op)) fp/applying-ops))))

(deftest representative-applying-ops-really-force
  ; the claim "applying" is the conservative side; these pin that the
  ; classification is not vacuous for the ops UI code calls most.
  (doseq [[label f] [["count" count] ["first" first] ["seq" seq] ["=" #(= % [1])]
                     ["into" #(into [] %)] ["compare" #(compare % [1 2 3])] ["str" str] ["mapv" #(mapv inc %)]
                     ["get-in ks" #(get-in {} %)] ["assoc-in ks" #(assoc-in {} % 1)]
                     ["subs" #(subs % 0)] ["sort-by/3" #(sort-by identity compare %)]]]
    (is (forces? f) (str label " should force"))))

(deftest literals-are-pure
  (testing "vector and map literals build values; nothing runs"
    (is (= {} (fp/fp-walk nil (BeamLisp.Reader/read_one "[{:key :a :label \"x\"} [1 2] #{3}]")))))
  (testing "a vector literal's elements still count"
    (is (= {"a" :W} (fp/fp-walk nil (BeamLisp.Reader/read_one "[(swap! a inc)]"))))))

(deftest forcing-charges-the-creator
  (testing "a printing lazy producer makes its consumer effectful"
    (let [s (an/analyze "(defn mk [] (lazy-seq (println 1) nil))
                         (defn user [] (count (mk)))")]
      (is (= {:io :W} (:footprint (get s "user"))))
      (is (= {:io :W} (:latent (get s "mk"))) "creating it defers the print")
      (is (= {} (:footprint (get s "mk"))) "creating a lazy seq does nothing yet")))
  (testing "consuming a pure collection is pure"
    (let [s (an/analyze "(defn total [xs] (count (filterv odd? (mapv inc xs))))")]
      (is (= {} (:footprint (get s "total"))))))
  (testing "a consumer of a PARAMETER is pure; the supplier carries the effect"
    (let [s (an/analyze "(defn n-of [xs] (count xs))
                         (defn caller [] (n-of (lazy-seq (println 1) nil)))")]
      (is (= {} (:footprint (get s "n-of"))))
      (is (= {:io :W} (:footprint (get s "caller")))
          "caller creates the printing seq AND applies (via n-of's count), so it is charged")))
  (testing "with no program context a forcing op stays opaque (single-node answer)"
    (is (contains? (fp/fp-walk nil (BeamLisp.Reader/read_one "(count xs)")) fp/opaque-world))))
