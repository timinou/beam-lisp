; test/bl/system/model_test.bl — the extraction assurance (P16a), as tests.
;
; The load-bearing claim of the system-model tier: five surface forms lower to
; the IDENTICAL transition graph, so verification written once is inherited by
; every dispatch form — defserver unchanged.

(ns system.model-test
  (:require [system.model :as model]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))

; the same counter machine, three ways
(def loop-src
  "(loop [n n]
     (receive
       [:inc]              (recur (+ n 1))
       [:dec] :when (> n 0) (recur (- n 1))
       [:reset]            (recur 0)))")

(def server-src
  "(defserver counter
     (init [n] (ok n))
     (handle-call [:inc]  [_from n] (reply :ok (+ n 1)))
     (handle-call [:dec]  [_from n] :when (> n 0) (reply :ok (- n 1)))
     (handle-call [:reset] [_from n] (reply :ok 0)))")

(def methods-src
  ["(defmethod step :inc  [n _] (+ n 1))"
   "(defmethod step :dec  [n _] (- n 1))"
   "(defmethod step :reset [n _] 0)"])

(defn- msg-graph [clauses]
  ; drop the :init transition (server-only) and compare (label,next)
  (model/graph (filter (fn [c] (not (= :init (:label c)))) clauses)))

(deftest five-forms-one-graph
  (let [loop-g   (msg-graph (model/transitions (read1 loop-src)))
        server-g (msg-graph (model/transitions (read1 server-src)))
        multi-g  (msg-graph (model/extract-defmethods (map read1 methods-src)))]
    (is (= loop-g multi-g) "raw receive-loop and defmulti produce the same graph")
    (is (= loop-g server-g)
        "defserver produces the same graph as a raw receive loop — OTP inherits, unchanged")
    (is (= 3 (count loop-g)) "three message transitions")))

(deftest guard-reported-faithfully
  ; the loop/server encode :dec's guard as :when; the extractor reports it,
  ; and never fabricates a guard the source did not write.
  (let [loop-cs (model/transitions (read1 loop-src))
        dec-c   (first (filter (fn [c] (= :dec (:label c))) loop-cs))
        inc-c   (first (filter (fn [c] (= :inc (:label c))) loop-cs))]
    (is (= "(> n 0)" (:guard dec-c)) ":dec carries its :when guard")
    (is (nil? (:guard inc-c)) ":inc has no guard — none is invented")))

(deftest naming-trichotomy
  ; 1. binding name from defserver
  (is (= "counter" (:name (model/system-model (read1 server-src))))
      "a defserver is named by its binding")
  ; 3. content-hash for an anonymous loop — stable, structural
  (let [n1 (:name (model/system-model (read1 loop-src)))
        n2 (:name (model/system-model (read1 loop-src)))]
    (is (= n1 n2) "the content-hash is stable across identical structure")
    (is (includes? n1 "↻") "the content-hash is human-readable (↻⟨labels⟩·hash)")))

(deftest next-state-normalized
  ; a loop's (recur S), a server's (reply val S), a defmethod's bare S all
  ; name the SAME next-state — the normalization that makes the graphs coincide.
  (let [loop-inc   (first (filter (fn [c] (= :inc (:label c)))
                                  (model/transitions (read1 loop-src))))
        server-inc (first (filter (fn [c] (= :inc (:label c)))
                                  (model/transitions (read1 server-src))))]
    (is (= "(+ n 1)" (:next loop-inc)) "recur wrapper stripped to the state expr")
    (is (= (:next loop-inc) (:next server-inc))
        "reply wrapper strips to the same state expr as recur")))
