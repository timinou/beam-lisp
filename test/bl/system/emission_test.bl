(ns system.emission-test (:require [system.emission :as emission] [system.ir.identity :as identity]))

(defn- chain [n]
  (reduce (fn [body i]
            {:op :let :name (str "binding-" i) :init {:op :lit :val i} :body body})
          {:op :lit :val -1} (range n)))

(deftest unique-deep-ir-never-verifies-whole-subtrees
 (doseq [n [64 128 256]]
  (let [report (emission/duplicate-report (chain n))]
   (is (:complete? report))
   (is (= (inc (* 2 n)) (:nodes report)))
   (is (= 0 (:verification-nodes report)))
   (is (empty? (:duplicates report))))))

(deftest hash-hints-are-not-duplicate-authority
 (let [leaf (fn [v] {:op :var :name v})
       pair (fn [a b] {:op :remote :mod :erlang :fun :+ :args [(leaf a) (leaf b)]
                      :ann {:line 1 :col 1 :end-line 1 :end-col 9}})
       report (emission/duplicate-report {:op :tuple :elems [(pair "x" "x") (pair "y" "z")]} 3)]
  (is (:complete? report))
  (is (> (:verification-nodes report) 0) "the coarse collision was actually verified")
  (is (empty? (:duplicates report)) "aliasing differs despite identical coarse shape")))

(deftest alpha-equivalent-splices-have-one-maximal-witness
 (let [body (chain 12)
       report (emission/duplicate-report {:op :tuple :elems [body body]})]
  (is (:complete? report))
  (is (= 1 (count (:duplicates report))) "nested duplicate reports are subsumed")
  (is (= 2 (:count (first (:duplicates report)))))
  (is (= 25 (:size (first (:duplicates report)))))
  (is (<= (:verification-nodes report) (:budget report)))))

(deftest equal-code-at-different-source-sites-is-not-a-splice
 (let [body (chain 5)
       at (fn [line]
            (let [ann {:line line :col 1 :end-line line :end-col 9}]
              (reduce (fn [tail i]
                        {:op :let :name (str "position-" i) :ann ann
                         :init {:op :lit :val i :ann ann} :body tail})
                      {:op :lit :val -1 :ann ann} (range 5))))
       a (at 1) b (at 2)]
  (is (empty? (emission/duplicates {:op :tuple :elems [a b]})))))

(deftest an-exhausted-budget-never-claims-completeness
 (let [body (chain 12)
       report (emission/duplicate-report {:op :tuple :elems [body body]} 3 0)]
  (is (not (:complete? report)))
  (is (= 0 (:verification-nodes report)))))

(deftest quoted-ir-shaped-values-retain-every-bit-of-data
 (let [literal {:op :var :name "quoted-name" :ann {:line 123}}
       body {:op :lit :val literal :ann {:line 1}}
       changed {:op :lit :val (assoc literal :ann {:line 456})}]
  (is (= {:op :lit :val literal} (identity/strip-ann body)))
  (is (= {:op :lit :val literal} (identity/body-identity body)))
  (is (not= (identity/body-identity body) (identity/body-identity changed)))))

(deftest identity-normalizes-nested-pairs-and-preserves-aliasing
 (let [body (fn [a b] {:op :map :pairs [[{:op :var :name a} {:op :var :name b}]]})]
  (is (= (identity/body-identity (body "x" "y")) (identity/body-identity (body "a" "b"))))
  (is (not= (identity/body-identity (body "x" "x")) (identity/body-identity (body "a" "b"))))))
