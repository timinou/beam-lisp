(ns system.publication-test (:require [system.publication :as publication] [env]))
(defn fixture []
 (let [ns (str "publication.actual.p" (erlang/unique_integer (list :positive)))]
  (env/eval (str "(ns " ns ") (defn choose [a b] a)")) ns))
(deftest successful-emitted-binding-and-reload
 (let [ns (fixture) a (publication/snapshot ns "choose")]
  (is (some? a))
  (is (publication/valid? a))
  (env/eval (str "(ns " ns ") (defn choose [a b] b)"))
  (let [b (publication/snapshot ns "choose")]
   (is (some? b))
   (is (not= (:identity a) (:identity b)))
   (is (not (publication/valid? a)))
   (is (publication/valid? b)))
  (BeamLisp.Env/intern ns "choose" (fn [a b] a))
  (is (nil? (publication/snapshot ns "choose")))))
(deftest closure-and-unpublished-function-decline
 (let [ns (str "publication.captured.p" (erlang/unique_integer (list :positive)))]
  (env/eval (str "(ns " ns ") (let [captured 7] (defn closed [x] captured))"))
  (is (nil? (publication/snapshot ns "closed")))
  (is (nil? (publication/snapshot ns "missing")))))
(deftest failed-descriptor-does-not-publish-new-evidence
 (let [ns (fixture) before (publication/snapshot ns "choose")
       failure (try (BeamLisp.Link/defvar ns "choose"
                       (list (tuple :fixed 2 :choose {:op :not-a-clause})))
                    nil (catch _ :failed))
       after (publication/snapshot ns "choose")]
  (is (= :failed failure))
  (is (some? after))
  (is (= (:identity before) (:identity after)))
  (is (= 1 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! ns "choose") (list 1 2))))))
(deftest publication-fence-is-nested-and-exception-safe
 (let [ns (fixture) before (publication/snapshot ns "choose")]
  (BeamLisp.Env/with_publication ns
   (fn []
    (is (nil? (publication/snapshot ns "choose")))
    (BeamLisp.Env/with_publication ns
     (fn [] (is (nil? (BeamLisp.Env/namespace_generations (list ns))))))
    (is (nil? (publication/snapshot ns "choose")))))
  (is (some? (publication/snapshot ns "choose")))
  (is (not (publication/valid? before)))
  (try (BeamLisp.Env/with_publication ns (fn [] (throw "failed publication"))) (catch _ nil))
  (is (some? (publication/snapshot ns "choose")))))

(deftest settled-forwarding-shims-retain-valid-evidence
 (let [ns (str "publication.settled.p" (erlang/unique_integer (list :positive)))
       forms ["(defn first-one [x] x)" "(defn second-one [x] x)" "(defn third-one [x] x)"]]
  (BeamLisp.Env/in_ns ns)
  (doseq [src forms]
   (BeamLisp.Compiler/eval_form
    (first (to-list (BeamLisp.Ns.Reader/read_string src nil)))
    (BeamLisp.Compiler/new_env ns)))
  (let [before (publication/snapshot ns "third-one")]
   (is (some? before))
   (BeamLisp.Link/settle)
   (let [after (publication/snapshot ns "third-one")]
    (is (some? after)) (is (publication/valid? after))
    (is (= (:identity before) (:identity after)))
    (is (= 9 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! ns "third-one") (list 9))))))))

(deftest concurrent-publisher-refuses-read-evidence
 (let [ns (fixture) parent (erlang/self) token (env/capture)
       child (erlang/spawn
        (fn [] (env/bind token) (BeamLisp.Env/with_publication ns
                 (fn [] (erlang/send parent [:publication-inflight])
                   (receive [:publication-release] :ok (after 5000 :timeout))))
               (erlang/send parent [:publication-finished])))]
  (try
   (is (= :ready (receive [:publication-inflight] :ready (after 5000 :timeout))))
   (is (nil? (publication/snapshot ns "choose")))
   (erlang/send child [:publication-release])
   (is (= :done (receive [:publication-finished] :done (after 5000 :timeout))))
   (is (some? (publication/snapshot ns "choose")))
   (finally (when (Process/alive? child) (Process/exit child :kill))))))

(deftest body-bytes-cannot-borrow-the-old-emitted-descriptor
 (let [ns (fixture) before (publication/snapshot ns "choose")
       entry (first (:entries before)) body (elem entry 4)
       changed (assoc (elem entry 3) :body (BeamLisp.Emit/lit 99))
       beam (BeamLisp.Emit/compile_descriptor (BeamLisp.Emit/descriptor_for body (list changed)))]
  (is (some? before))
  (BeamLisp.Emit/load_binary! beam "publication-body-tamper-test")
  (is (= 99 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! ns "choose") (list 1 2))))
  (is (nil? (publication/snapshot ns "choose")))
  (is (not (publication/valid? before)))))

(deftest repeated-rebinding-keeps-body-receipts-bounded
 (let [ns (fixture)]
  (doseq [n (range 30)] (env/eval (str "(ns " ns ") (defn choose [a b] " n ")")))
  (let [snapshot (publication/snapshot ns "choose")]
   (is (some? snapshot))
   (is (<= (count (:bodies (:shim snapshot))) 8))
   (is (= 29 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! ns "choose") (list 1 2)))))))

(deftest aot-publication-names-the-loaded-stabilized-bodies
 (let [ns (str "publication.aot.p" (erlang/unique_integer (list :positive)))
       dir (str (System/tmp_dir!) "/publication-aot-" (erlang/unique_integer (list :positive)))]
  (try
   (BeamLisp.AOT/compile_source (str "(ns " ns ") (defn choose [a b] b)")
       (list (tuple :output_dir dir)))
   (let [snapshot (publication/snapshot ns "choose")
         actual (erlang/apply (BeamLisp.Emit/module_for ns) :__bl_ns_defs__ (list))]
    (is (some? snapshot))
    (is (= actual (BeamLisp.Env/ns_defs ns)))
    (is (publication/valid? snapshot))
    (is (= 2 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! ns "choose") (list 1 2)))))
   (finally (File/rm_rf! dir)))))

(deftest metadata-cannot-borrow-valid-body-bytes-for-fictional-ir
 (let [ns (fixture) original (BeamLisp.Env/ns_defs ns)
       entry (first (get original "choose"))
       fake (erlang/setelement 4 entry (assoc (elem entry 3) :body (BeamLisp.Emit/lit 99)))]
  (try
   (BeamLisp.Env/put_ns_defs ns (assoc original "choose" (list fake)))
   (is (= 1 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! ns "choose") (list 1 2))))
   (is (nil? (publication/snapshot ns "choose")))
   (finally (BeamLisp.Env/put_ns_defs ns original)))))


(deftest publication-roots-stay-small-and-retire-definition-owned-evidence
 (let [ns (str "publication.rows.p" (erlang/unique_integer (list :positive)))
       payload (apply str (repeat 512 "x")) sizes (atom [])]
  (doseq [n (range 32)]
   (env/eval (str "(ns " ns ") (defn f" n " [x] [x \"" payload "\"])"))
   (let [root (elem (BeamLisp.Env/lookup (tuple :emitted_publication ns)) 1)]
    (is (= #{:version :module :md5} (set (keys root))))
    (swap! sizes conj (erlang/external_size root))))
  (is (= (first @sizes) (last @sizes)))
  (is (< (last @sizes) 1024))
  (is (= 32 (count (BeamLisp.Env/match_own
                     (tuple (tuple :emitted_definition ns :"$1") :_)))))
  (let [snapshot (publication/snapshot ns "f31")]
   (is (some? snapshot))
   (is (publication/valid? snapshot))
   (is (= [9 payload] (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! ns "f31") (list 9)))))
  (BeamLisp.Env/undefine_var ns "f31")
  (is (= :error (BeamLisp.Env/lookup (tuple :emitted_definition ns "f31"))))
  (is (nil? (publication/snapshot ns "f31")))
  (is (some? (publication/snapshot ns "f0")))
  ;; Full publication removes rows that do not belong to its current table.
  (BeamLisp.Env/put_key (tuple :emitted_definition ns "obsolete") {:version 1 :entries [] :bodies {}})
  (BeamLisp.Env/mark_emitted ns (BeamLisp.Emit/module_for ns))
  (is (= :error (BeamLisp.Env/lookup (tuple :emitted_definition ns "obsolete"))))
  (is (= 31 (count (BeamLisp.Env/match_own
                     (tuple (tuple :emitted_definition ns :"$1") :_)))))
  (is (some? (publication/snapshot ns "f0")))
  (println "emitted-publication-row-metrics"
           {:definitions 32 :payload-bytes 512 :first-root-bytes (first @sizes)
            :last-root-bytes (last @sizes) :remaining-definition-rows 31})))
