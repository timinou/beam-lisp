; test/bl/system/footprint_anf_test.bl — footprint over bl-ANF: the macro
; forms the surface walker collapsed to :opaque-world are now exact, and the
; local-naming unsoundness is gone.
(ns system.footprint-anf-test
  (:require [system.footprint :as fp] [compiler :as c]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(defn- fpo [s] (fp/fp-walk {} (read1 s)))

(deftest plain-idioms-unchanged
  (is (= {"a" :R} (fpo "(deref a)")))
  (is (= {"a" :W} (fpo "(swap! a inc)")))
  (is (= {"a" :R fp/opaque-world :W} (fpo "(erlang/+ (deref a) (count xs))"))
      "count may force an effectful lazy producer")
  (is (= {"conn" :W fp/opaque-world :W} (fpo "(datom/transact! conn tx)"))
      "the namespace readiness guard may initialize its provider")
  (is (= {"p" :S} (fpo "(erlang/send p m)")))
  (is (= {} (fpo "(binary/at b i)")) "immutable index is pure")
  (is (= {} (fpo "(fn [q] (swap! q inc))")) "fn body deferred"))

(deftest macros-are-exact
  (testing "threading and conditional macros no longer collapse to :opaque-world"
    (is (= {"a" :R} (fpo "(-> a deref (erlang/+ 1))")))
    (is (= {"a" :W} (fpo "(-> a (swap! inc))")))
    (is (= {"a" :W} (fpo "(doto a (swap! inc))")))
    (is (= {"conn" :W fp/opaque-world :W} (fpo "(->> tx (datom/transact! conn))")))
    (is (= {"a" :R} (fpo "(if-let [v (deref a)] v 0)"))
        "if-let tests the bound value directly in canonical IR")
    (is (= {"a" :R} (fpo "(as-> (deref a) v (erlang/+ v 1))")))
    (is (= {"a" :R} (fpo "(some-> a deref)"))
        "some-> tests with core nil?, which never forces its argument (measured in footprint_forcing_test)")
    (is (= {"a" :W} (fpo "(when (> n 0) (swap! a inc))")))))

(deftest locals-are-not-resources
  (testing "a computed local is unnameable; a global-aliased local resolves"
    (is (= fp/opaque-world (first (keys (fpo "(let [r (pick)] (swap! r inc))"))))
        "computed local → opaque, never a spurious resource named r")
    (is (= {"a" :W} (fpo "(let [r a] (swap! r inc))"))
        "local aliasing a global resolves to the global")
    (is (= fp/opaque-world (first (keys (fpo "(let [r a] (let [r (pick)] (swap! r inc)))"))))
        "inner shadow is not the outer alias")))

(deftest algebra-preserved
  (let [orders (fpo "(swap! orders conj o)")
        balance (fpo "(swap! balance + n)")]
    (is (fp/frame-independent? orders balance) "disjoint resources ⟹ frame-independent")
    (is (fp/commute? orders balance) "disjoint ⟹ commute")
    (is (not (fp/commute? (fpo "(swap! a inc)") (fpo "(deref a)")))
        "W and R on the same resource conflict")
    (is (= :atom (fp/rung (fpo "(swap! a inc)"))))
    (is (= :pure (fp/rung (fpo "(deref a)")))))) ; a single read is pure rung

(deftest op-rung-name-bridge
  (testing "effects.bl's name-keyed leaf query still answers"
    (is (= :pure (fp/op-rung "count")))
    (is (= :atom (fp/op-rung "swap!")))
    (is (= :io (fp/op-rung "println")))
    (is (= :process (fp/op-rung "erlang/send")))
    (is (nil? (fp/op-rung "totally-unknown-fn")))))

(defn- direct-op [fun args]
  {:op :remote :mod fp/datom :fun fun :args args})

(deftest opaque-resource-is-a-wildcard
  (doseq [mode [:R :A :W :S :K :X]]
    (is (= false (fp/frame-independent? {fp/opaque-world :R} {"a" mode})))
    (is (= false (fp/frame-independent? {"a" mode} {fp/opaque-world :R})))
    (is (= false (fp/commute? {fp/opaque-world :W} {"a" mode})))
    (is (= false (fp/commute? {"a" mode} {fp/opaque-world :W}))))
  (is (= true (fp/commute? {fp/opaque-world :R} {"a" :R})))
  (is (= true (fp/frame-independent? {} {fp/opaque-world :W})))
  (is (= true (fp/commute? {} {fp/opaque-world :W})))
  (is (= false (fp/commute? {fp/opaque-world :A} {"a" :W}))))

(deftest database-effects-do-not-license-append-commutativity
  (let [c {:op :global :name "conn"}
        db {:op :global :name "database"}
        q {:op :lit :value :query}
        tx (fp/fp-anf (direct-op :transact! [c {:op :lit :value []}]))
        listen (fp/fp-anf (direct-op :listen! [c]))
        query (fp/fp-anf (direct-op :q [q db]))]
    (is (= :W (get tx "conn")))
    (is (= false (fp/monotone? tx)))
    (is (= false (fp/commute? tx tx)))
    (is (= :W (get listen "conn")))
    (is (= :R (get query "database")))
    (is (= :W (get query fp/opaque-world)))
    (is (= false (fp/pure? query)))
    (is (= false (fp/frame-independent? query {"elsewhere" :W})))))
