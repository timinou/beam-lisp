; test/bl/system/mcp_conn_memo_test.bl — the memo must not outlive its owner.
;
; The bug this pins, found in a built drop rather than in dev:
;
;   $ bl run examples/mcp-demo.bl        # through the daemon
;   bl: daemon connection lost mid-command; outcome unknown
;
; The daemon runs every command in ONE worker, and `mcp.tools` mounts the
; codebase on first use into a VM-global atom — older than any worker. When a
; worker died (the demo links an in-process MCP server, whose crash took the
; worker with it), the atom still held the conn, but its ETS tables had died
; with the worker that mounted them. The next request therefore died inside
; `:ets.lookup`: "the table identifier does not refer to an existing ETS
; table" — read by a user as a corrupt database.
;
; The test is small and honest about the mechanism: MOUNT in a process, let that
; process EXIT, then ask again. That is a worker restart, minus the daemon.

(ns mcp.conn.memo.test
  (:require [datom] [mcp.tools :as tools]))

(defn- until
  "Poll `pred` for up to 60 s — a mount takes seconds, a process exit takes
   milliseconds, and neither has a fixed duration worth sleeping for."
  [pred]
  (loop [n 0]
    (cond
      (pred) true
      (> n 6000) false
      :else (do (Process/sleep 10) (recur (inc n))))))

(defn- fact-count [conn]
  (get (get (into [] (datom/q '[:find (count ?d) :where [?d :fn/name _]]
                              (datom/db conn)))
            0)
       0))

(defn- mount-in-a-process-that-then-exits
  "Mount the codebase in a process, hand the conn out, and let the process
   exit — the daemon's worker restart, minus the daemon."
  [out]
  (let [done (atom false)
        owner (erlang/spawn (fn []
                              (reset! out (tools/conn))
                              (reset! done true)))]
    (is (until (fn [] @done)) "the owner mounted the codebase")
    (is (until (fn [] (not (Process/alive? owner)))) "and then exited")
    owner))

(deftest a-conn-memo-whose-owner-died-is-re-mounted
  (let [stale (atom nil)]
    (mount-in-a-process-that-then-exits stale)
    ; The memo now names tables owned by a dead process. Asking again must NOT
    ; hand it over: it must notice and re-mount.
    (is (pos? (fact-count (tools/conn)))
        "the codebase is served again, without a daemon restart")))

(deftest the-conn-handed-out-is-always-alive
  ; Order-independent companion to the test above, and the property a reader of
  ; this file should take away: the memo is per-VM state, so by the time this
  ; runs it may well be owned by a process that is still alive — this one.
  ; That is the guarantee: whoever asked, whatever died, `tools/conn` hands out
  ; a conn whose substrate is there.
  (let [stale (atom nil)]
    (mount-in-a-process-that-then-exits stale)
    (let [c (tools/conn)]
      (is (datom/alive? c))
      (is (pos? (fact-count c))))))

