; test/bl/system/mcp_conn_memo_test.bl — the memo must not outlive its owner.
;
; The bug this pins, found in a built drop rather than in dev:
;
;   $ bl run examples/mcp-demo.bl        # through the daemon
;   bl: daemon connection lost mid-command; outcome unknown
;
; The daemon runs every command in ONE worker, and `mcp.tools` mounts the
; codebase on first use into a VM-global atom — older than any worker. When a
; worker died (the demo links an in-process MCP server, whose crash took the
; worker with it), the atom still held the conn, but its ETS tables had died
; with the worker that mounted them. The next request therefore died inside
; `:ets.lookup`: "the table identifier does not refer to an existing ETS
; table" — read by a user as a corrupt database.
;
; The test is small and honest about the mechanism: MOUNT in a process, let that
; process EXIT, then ask again. That is a worker restart, minus the daemon.

(ns mcp.conn.memo.test
  (:require [datom] [mcp.server :as server] [mcp.tools :as tools]))

;; Where this file stands: a directory with no project above it, so the mount
;; the memo holds is the ENGINE (seconds) rather than this repo's own 327
;; sources (minutes — env.bl's :paths). The subject here is the memo's LIFETIME,
;; and it is the same question either way. `:bl_cwd` is the key
;; `BeamLisp/with_cwd` binds; a spawned process does not inherit the process
;; dictionary, so the mount helper below binds it there as well — and this def is
;; PLAIN rather than ^:private, because a private var does not resolve from a
;; spawned process.
(def nowhere (System/tmp_dir!))
(Process/put :bl_cwd nowhere)

(defn- until
  "Poll `pred` for up to 60 s — a mount takes seconds, a process exit takes
   milliseconds, and neither has a fixed duration worth sleeping for."
  [pred]
  (loop [n 0]
    (cond
      (pred) true
      (> n 6000) false
      :else (do (Process/sleep 10) (recur (inc n))))))

(defn- fact-count [conn]
  (get (get (into [] (datom/q '[:find (count ?d) :where [?d :fn/name _]]
                              (datom/db conn)))
            0)
       0))

(defn- mount-in-a-process-that-then-exits
  "Mount the codebase in a process, hand the conn out, and let the process
   exit — the daemon's worker restart, minus the daemon. DIR is passed IN rather
   than closed over: a spawned process resolves no test-file var (only its own
   arguments), and standing where NOWHERE is makes the mount cost the engine
   rather than the repo it lives in."
  [dir out]
  (let [done (atom false)
        owner (erlang/spawn (fn []
                              (BeamLisp/with_cwd dir
                                (fn [] (reset! out (tools/conn))))
                              (reset! done true)))]
    (is (until (fn [] @done)) "the owner mounted the codebase")
    (is (until (fn [] (not (Process/alive? owner)))) "and then exited")
    owner))

(defn- state-in-a-process-that-then-exits
  "Build a SERVER STATE in a process, hand it out, and let the process exit —
   the shape the daemon's HTTP MCP leaves behind: its persistent_term outlives
   the connection process that opened the conn inside it. DIR is passed IN
   rather than closed over: a spawned process resolves no test-file var."
  [dir out]
  (let [done (atom false)
        owner (erlang/spawn (fn []
                              (BeamLisp/with_cwd dir
                                (fn [] (reset! out (server/state))))
                              (reset! done true)))]
    (is (until (fn [] @done)) "the owner built the state")
    (is (until (fn [] (not (Process/alive? owner)))) "and then exited")
    owner))

(deftest a-state-whose-owner-died-still-answers-its-handshake
  ;; FUP-014, at the seam the daemon actually uses. The HTTP MCP builds the
  ;; server STATE once and keeps it in a persistent_term for the session
  ;; (lib/beam_lisp/daemon/http.ex, `mcp_state/1`), while the conn inside that
  ;; state belongs to the process that mounted it — the first request's
  ;; connection, which exits when the client's connection closes. The next
  ;; client then asks a state whose tables are gone.
  ;;
  ;; Measured before the state learned to ask: `server/discover` AND
  ;; `prompts/get` on such a state throw ArgumentError (`the table identifier
  ;; does not refer to an existing ETS table`), which reaches the client as
  ;; -32603 Internal error. The tools never showed it — they go through
  ;; `live-mount`, which asks.
  (let [stale (atom nil)]
    (state-in-a-process-that-then-exits nowhere stale)
    (let [r (server/request-response
              @stale
              {"jsonrpc" "2.0" "id" 1 "method" "server/discover" "params" {}
               "_meta" {"io.modelcontextprotocol/protocolVersion" "2026-07-28"}})]
      (is (nil? (get r "error")) "the handshake is answered, not an internal error")
      (is (pos? (count (str (get-in r ["result" "instructions"]))))
          "and it carries the corpus a client needs to hold this server"))))

(deftest a-conn-memo-whose-owner-died-is-re-mounted
  (let [stale (atom nil)]
    (mount-in-a-process-that-then-exits nowhere stale)
    ; The memo now names tables owned by a dead process. Asking again must NOT
    ; hand it over: it must notice and re-mount.
    (is (pos? (fact-count (tools/conn)))
        "the codebase is served again, without a daemon restart")))

(deftest the-conn-handed-out-is-always-alive
  ; Order-independent companion to the test above, and the property a reader of
  ; this file should take away: the memo is per-VM state, so by the time this
  ; runs it may well be owned by a process that is still alive — this one.
  ; That is the guarantee: whoever asked, whatever died, `tools/conn` hands out
  ; a conn whose substrate is there.
  (let [stale (atom nil)]
    (mount-in-a-process-that-then-exits nowhere stale)
    (let [c (tools/conn)]
      (is (datom/alive? c))
      (is (pos? (fact-count c))))))

