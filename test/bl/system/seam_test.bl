; test/bl/system/seam_test.bl — the checker seam (P17), as tests.
;
; The seam is what turns eight libraries into one point-and-verify checker:
; annotate a defserver with ^{:invariant …} and it gets proven, no hand-written
; SMT, no hand-written transition maps. Plus the two structural guarantees
; (message coverage, dispatch determinism), the SMT translator, and :~step.

(ns system.seam-test
  (:require [system.core :as sys] [system.model :as model]
            [system.smt :as smt] [system.step :as step]
            [z3] [datom]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(def port (z3/open))

; ── the SMT translator (P17) ────────────────────────────────────────────

(deftest smt-translates-arithmetic-and-predicates
  (let [vars #{"balance" "amt" "n"}]
    (is (= "(>= balance amt)" (smt/of-source vars "(>= balance amt)")) "arithmetic passthrough")
    (is (= "(+ n 1)" (smt/of-source vars "(inc n)")) "inc desugars to +1")
    (is (= "(> n 0)" (smt/of-source vars "(pos? n)")) "pos? desugars to >0")
    (is (= "(= n 0)" (smt/of-source vars "(zero? n)")) "zero? desugars to =0")))

(deftest smt-detects-untranslatable
  (let [vars #{"s"}]
    (is (= :untranslatable (smt/of-source vars "(get s :balance)")) "map access is untranslatable")
    (is (= :untranslatable (smt/of-source vars "(str n)")) "string op is untranslatable")))

; ── the seam: point-and-verify (P17) ────────────────────────────────────

(def good-account
  "(defserver ^{:invariant (>= balance 0)} account
     (init [balance] (ok balance))
     (handle-call [:deposit amt] [_ balance] :when (>= amt 0) (reply :ok (+ balance amt)))
     (handle-call [:withdraw amt] [_ balance] :when (and (>= amt 0) (>= balance amt)) (reply :ok (- balance amt))))")

(def buggy-account
  "(defserver ^{:invariant (>= balance 0)} account2
     (init [balance] (ok balance))
     (handle-call [:withdraw amt] [_ balance] (reply :ok (- balance amt))))")

(deftest verify-process-proves-a-correct-server
  (let [r (sys/verify-process port (read1 good-account))]
    (is (:checked r) "an annotated server is checked")
    (is (:holds r) "the correctly-guarded account proves □(balance ≥ 0)")
    (is (empty? (:warnings r)) "no warnings")))

(deftest verify-process-catches-a-buggy-server
  (let [r (sys/verify-process port (read1 buggy-account))]
    (is (:checked r) "checked")
    (is (not (:holds r)) "the unguarded withdraw fails")
    (is (= 1 (count (:warnings r))) "one warning")
    (is (includes? (:msg (first (:warnings r))) "withdraw") "naming the offending transition")))

(deftest verify-process-silent-without-annotation
  (let [r (sys/verify-process port
            (read1 "(defserver counter (init [n] (ok n)) (handle-call [:inc] [_ n] (reply :ok (+ n 1))))"))]
    (is (not (:checked r)) "no ^{:invariant} → not checked")
    (is (empty? (:warnings r)) "and silent — sound-warnings-only")))

(deftest verify-file-renders-warnings
  (let [rendered (sys/verify-file port "account.bl" buggy-account)]
    (is (= 1 (count rendered)) "one rendered warning")
    (is (includes? (first rendered) "account.bl:") "file:line:col prefix")
    (is (includes? (first rendered) "│") "the source line + caret gutter")))

; ── message coverage (P17) ──────────────────────────────────────────────

(deftest message-coverage-finds-unhandled
  (let [cs (model/transitions (read1 good-account))]
    (is (= #{:deposit :withdraw} (sys/handled-labels cs)) "handles deposit + withdraw")
    (is (= '(:close) (sys/unhandled-messages cs #{:deposit :withdraw :close}))
        ":close is sent but unhandled — a latent FunctionClauseError")
    (is (empty? (sys/unhandled-messages cs #{:deposit :withdraw}))
        "no unhandled when senders match handlers")))

; ── dispatch determinism (P17) ──────────────────────────────────────────

(deftest determinism-flags-overlapping-guards
  (let [decls "(declare-const n Int)\n"]
    (is (seq (sys/nondeterministic-pairs port decls
               [{:label :dec :guard "(> n 0)"} {:label :dec :guard "(> n 5)"}]))
        "overlapping same-label guards are nondeterministic")
    (is (empty? (sys/nondeterministic-pairs port decls
                  [{:label :dec :guard "(> n 5)"} {:label :dec :guard "(< n 0)"}]))
        "disjoint guards are fine")))

; ── multi-variable relational invariants (P18 Rung 1) ────────────────────

(def reservation-account
  "(defserver ^{:invariant (and (>= reserved 0) (>= balance reserved))} acct
     (init [balance reserved] (ok [balance reserved]))
     (handle-call [:reserve amt]  [_ [balance reserved]] :when (and (>= amt 0) (>= (- balance reserved) amt))
       (reply :ok [balance (+ reserved amt)]))
     (handle-call [:withdraw amt] [_ [balance reserved]] :when (and (>= amt 0) (>= (- balance reserved) amt))
       (reply :ok [(- balance amt) reserved])))")

(def buggy-reservation
  "(defserver ^{:invariant (and (>= reserved 0) (>= balance reserved))} acct
     (init [balance reserved] (ok [balance reserved]))
     (handle-call [:withdraw amt] [_ [balance reserved]] :when (and (>= amt 0) (>= balance amt))
       (reply :ok [(- balance amt) reserved])))")

(deftest multivar-relational-invariant-proven-jointly
  (let [r (sys/verify-process port (read1 reservation-account))]
    (is (:checked r) "a tuple-state server with ^{:invariant} is checked")
    (is (:holds r) "the relational invariant (balance ≥ reserved ≥ 0) holds for the whole tuple")
    (is (empty? (:warnings r)) "no warnings — reserve and withdraw both preserve the coupling")))

(deftest multivar-catches-reservation-ignoring-bug
  (let [r (sys/verify-process port (read1 buggy-reservation))]
    (is (:checked r) "checked")
    (is (not (:holds r)) "a withdraw guarding the WHOLE balance breaks balance ≥ reserved")
    (is (includes? (:msg (first (:warnings r))) "withdraw")
        "the bug invisible to a single-variable model is named")))

; ── :~step as a defrelation (P17) ───────────────────────────────────────

(deftest step-relation-reachability-and-counterexample
  (let [labels [:inc :dec :reset]
        stepper (fn [l n] (cond (= l :inc) (min 3 (+ n 1)) (= l :dec) (- n 1)
                                (= l :reset) 0 :else n))
        guarded (fn [l n] (cond (= l :dec) (> n 0) :else true))]
    (is (not (step/reaches? labels stepper guarded 2 (fn [n] (< n 0))))
        "n<0 is unreachable under the (> n 0) guard on :dec")
    (is (= [1 0 -1] (step/path-to labels stepper (fn [l n] true) 1 (fn [n] (< n 0))))
        "without the guard, the counterexample path is 1→0→-1")))
