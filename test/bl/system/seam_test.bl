; test/bl/system/seam_test.bl — the checker seam (P17), as tests.
;
; The seam is what turns eight libraries into one point-and-verify checker:
; annotate a defserver with ^{:invariant …} and it gets proven, no hand-written
; SMT, no hand-written transition maps. Plus the two structural guarantees
; (message coverage, dispatch determinism), the SMT translator, and :~step.

(ns system.seam-test
  (:require [system.core :as sys] [system.model :as model]
            [system.smt :as smt] [system.step :as step]
            [errors] [z3] [datom]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))
(def port (z3/open))

; ── the SMT translator (P17) ────────────────────────────────────────────

(deftest smt-translates-arithmetic-and-predicates
  (let [vars #{"balance" "amt" "n"}]
    (is (= "(>= balance amt)" (smt/of-source vars "(>= balance amt)")) "arithmetic passthrough")
    (is (= "(+ n 1)" (smt/of-source vars "(inc n)")) "inc desugars to +1")
    (is (= "(> n 0)" (smt/of-source vars "(pos? n)")) "pos? desugars to >0")
    (is (= "(= n 0)" (smt/of-source vars "(zero? n)")) "zero? desugars to =0")))

(deftest smt-detects-untranslatable
  (let [vars #{"s"}]
    (is (= :untranslatable (smt/of-source vars "(get s :balance)")) "map access is untranslatable")
    ; NB: (str …) is now the String theory (→ str.++), no longer untranslatable —
    ; P19 lifted the Int-only limit. A genuinely unmodelled op stays untranslatable.
    (is (= :untranslatable (smt/of-source vars "(reduce + s)")) "a higher-order op is untranslatable")))

; ── the seam: point-and-verify (P17) ────────────────────────────────────

(def good-account
  "(defserver ^{:invariant (>= balance 0)} account
     (init [balance] (ok balance))
     (handle-call [:deposit amt] [_ balance] :when (>= amt 0) (reply :ok (+ balance amt)))
     (handle-call [:withdraw amt] [_ balance] :when (and (>= amt 0) (>= balance amt)) (reply :ok (- balance amt))))")

(def buggy-account
  "(defserver ^{:invariant (>= balance 0)} account2
     (init [balance] (ok balance))
     (handle-call [:withdraw amt] [_ balance] (reply :ok (- balance amt))))")

(deftest verify-process-proves-a-correct-server
  (let [r (sys/verify-process port (read1 good-account))]
    (is (:checked r) "an annotated server is checked")
    (is (:holds r) "the correctly-guarded account proves □(balance ≥ 0)")
    (is (empty? (:warnings r)) "no warnings")))

(deftest verify-process-catches-a-buggy-server
  (let [r (sys/verify-process port (read1 buggy-account))]
    (is (:checked r) "checked")
    (is (not (:holds r)) "the unguarded withdraw fails")
    (is (= 1 (count (:warnings r))) "one warning")
    (is (includes? (:msg (first (:warnings r))) "withdraw") "naming the offending transition")))

(deftest verify-process-silent-without-annotation
  (let [r (sys/verify-process port
            (read1 "(defserver counter (init [n] (ok n)) (handle-call [:inc] [_ n] (reply :ok (+ n 1))))"))]
    (is (not (:checked r)) "no ^{:invariant} → not checked")
    (is (empty? (:warnings r)) "and silent — sound-warnings-only")))

(deftest verify-file-renders-warnings
  (let [rendered (sys/verify-file port "account.bl" buggy-account)]
    (is (= 1 (count rendered)) "one rendered warning")
    (is (includes? (first rendered) "account.bl:") "file:line:col prefix")
    (is (includes? (first rendered) "│") "the source line + caret gutter")))

; ── message coverage (P17) ──────────────────────────────────────────────

(deftest message-coverage-finds-unhandled
  (let [cs (model/transitions (read1 good-account))]
    (is (= #{:deposit :withdraw} (sys/handled-labels cs)) "handles deposit + withdraw")
    (is (= '(:close) (sys/unhandled-messages cs #{:deposit :withdraw :close}))
        ":close is sent but unhandled — a latent FunctionClauseError")
    (is (empty? (sys/unhandled-messages cs #{:deposit :withdraw}))
        "no unhandled when senders match handlers")))

; ── dispatch determinism (P17) ──────────────────────────────────────────

(deftest determinism-flags-overlapping-guards
  (let [decls "(declare-const n Int)\n"]
    (is (seq (sys/nondeterministic-pairs port decls
               [{:label :dec :guard "(> n 0)"} {:label :dec :guard "(> n 5)"}]))
        "overlapping same-label guards are nondeterministic")
    (is (empty? (sys/nondeterministic-pairs port decls
                  [{:label :dec :guard "(> n 5)"} {:label :dec :guard "(< n 0)"}]))
        "disjoint guards are fine")))

; ── multi-variable relational invariants (P18 Rung 1) ────────────────────

(def reservation-account
  "(defserver ^{:invariant (and (>= reserved 0) (>= balance reserved))} acct
     (init [balance reserved] (ok [balance reserved]))
     (handle-call [:reserve amt]  [_ [balance reserved]] :when (and (>= amt 0) (>= (- balance reserved) amt))
       (reply :ok [balance (+ reserved amt)]))
     (handle-call [:withdraw amt] [_ [balance reserved]] :when (and (>= amt 0) (>= (- balance reserved) amt))
       (reply :ok [(- balance amt) reserved])))")

(def buggy-reservation
  "(defserver ^{:invariant (and (>= reserved 0) (>= balance reserved))} acct
     (init [balance reserved] (ok [balance reserved]))
     (handle-call [:withdraw amt] [_ [balance reserved]] :when (and (>= amt 0) (>= balance amt))
       (reply :ok [(- balance amt) reserved])))")

(deftest multivar-relational-invariant-proven-jointly
  (let [r (sys/verify-process port (read1 reservation-account))]
    (is (:checked r) "a tuple-state server with ^{:invariant} is checked")
    (is (:holds r) "the relational invariant (balance ≥ reserved ≥ 0) holds for the whole tuple")
    (is (empty? (:warnings r)) "no warnings — reserve and withdraw both preserve the coupling")))

(deftest multivar-catches-reservation-ignoring-bug
  (let [r (sys/verify-process port (read1 buggy-reservation))]
    (is (:checked r) "checked")
    (is (not (:holds r)) "a withdraw guarding the WHOLE balance breaks balance ≥ reserved")
    (is (includes? (:msg (first (:warnings r))) "withdraw")
        "the bug invisible to a single-variable model is named")))

; ── record / mixed-sort state (P18 Rung 2) ────────────────────────────

(def freezable-vault
  "(defserver ^{:invariant (or (not frozen) (= balance 0))} vault
     (init [balance] (ok {:balance balance :frozen false}))
     (handle-call [:deposit amt] [_ {:keys [balance frozen]}] :when (and (not frozen) (>= amt 0))
       (reply :ok {:balance (+ balance amt) :frozen frozen}))
     (handle-call [:freeze] [_ {:keys [balance frozen]}] :when (= balance 0)
       (reply :ok {:balance balance :frozen true})))")

(def buggy-vault
  "(defserver ^{:invariant (or (not frozen) (= balance 0))} vault
     (init [balance] (ok {:balance balance :frozen false}))
     (handle-call [:deposit amt] [_ {:keys [balance frozen]}] :when (>= amt 0)
       (reply :ok {:balance (+ balance amt) :frozen frozen})))")

(deftest record-mixed-sort-invariant-proven
  (let [r (sys/verify-process port (read1 freezable-vault))]
    (is (:checked r) "a record-state server (Int balance, Bool frozen) is checked")
    (is (:holds r) "the cross-sort invariant (frozen ⇒ balance = 0) holds")
    (is (empty? (:warnings r)) "no warnings — deposit and freeze both preserve it")))

(deftest record-catches-freeze-ignoring-bug
  (let [r (sys/verify-process port (read1 buggy-vault))]
    (is (:checked r) "checked")
    (is (not (:holds r)) "a deposit with no (not frozen) guard can add to a frozen vault")
    (is (includes? (:msg (first (:warnings r))) "deposit")
        "the offending mixed-sort transition is named")))

; ── invariant discovery, from nothing (P18 ★) ─────────────────────

(def unannotated-account
  "(defserver account
     (init [] (ok 0))
     (handle-call [:deposit amt] [_ balance] :when (>= amt 0)
       (reply :ok (+ balance amt)))
     (handle-call [:withdraw amt] [_ balance] :when (and (>= amt 0) (>= balance amt))
       (reply :ok (- balance amt))))")

(deftest discovers-invariant-from-nothing
  (let [d (sys/discover-invariant port (read1 unannotated-account))]
    (is (:checked d) "an un-annotated machine is still analysable")
    (is (includes? (:discovered d) "(>= balance 0)")
        "the Houdini fixpoint discovers (>= balance 0) with no annotation")))

(deftest discovered-invariant-is-sound
  ; feed the discovery back as an annotation — it must prove (sound by construction)
  (let [d (sys/discover-invariant port (read1 unannotated-account))
        annotated (str "(defserver ^{:invariant " (:discovered d) "} account"
                       "  (init [balance] (ok balance))"
                       "  (handle-call [:deposit amt] [_ balance] :when (>= amt 0)"
                       "    (reply :ok (+ balance amt)))"
                       "  (handle-call [:withdraw amt] [_ balance] :when (and (>= amt 0) (>= balance amt))"
                       "    (reply :ok (- balance amt))))")
        v (sys/verify-process port (read1 annotated))]
    (is (:holds v) "the discovered invariant proves when annotated back")))

(deftest discovery-is-honest-when-unbounded
  ; a dec-only machine has no lower bound — discovery must NOT invent (>= n 0)
  (let [d (sys/discover-invariant port
            (read1 "(defserver leaky (init [] (ok 0)) (handle-call [:dec] [_ n] (reply :ok (- n 1))))"))]
    (is (not (includes? (or (:discovered d) "") "(>= n 0)"))
        "an unbounded-below machine discovers no false lower bound")))

; ── collection state / capacity (P18 Rung 3) ───────────────────────

(def bounded-queue
  "(defserver ^{:invariant (<= (count pending) 10)} worker
     (init [] (ok []))
     (handle-call [:enqueue job] [_ pending] :when (< (count pending) 10)
       (reply :ok (conj pending job)))
     (handle-call [:dequeue] [_ pending] :when (> (count pending) 0)
       (reply :ok (rest pending))))")

(def overflowing-queue
  "(defserver ^{:invariant (<= (count pending) 10)} worker
     (init [] (ok []))
     (handle-call [:enqueue job] [_ pending] (reply :ok (conj pending job))))")

(deftest capacity-invariant-proven-exact
  (let [r (sys/verify-capacity port (read1 bounded-queue))]
    (is (:checked r) "a collection is abstracted to its length and checked")
    (is (:holds r) "the capacity invariant (count pending ≤ 10) holds for all traces")
    (is (= :exact (:extension r)) "capacity is an EXACT guarantee, not bounded")
    (is (empty? (:warnings r)) "no warnings")))

(deftest capacity-catches-overflow
  (let [r (sys/verify-capacity port (read1 overflowing-queue))]
    (is (not (:holds r)) "an unguarded enqueue can overflow the capacity")
    (is (includes? (:msg (first (:warnings r))) "enqueue") "the overflowing transition is named")))

(deftest smt-length-abstraction
  (let [colls #{"queue"}]
    (is (= "(<= queue_len 10)" (smt/of-source-len #{"queue"} colls "(<= (count queue) 10)"))
        "(count c) abstracts to c_len")
    (is (= "(+ queue_len 1)" (smt/of-source-len #{"queue"} colls "(conj queue x)"))
        "(conj c x) is length +1")
    (is (= :untranslatable (smt/of-source-len #{"queue"} colls "(contains? queue x)"))
        "a CONTENT op stays untranslatable — that is the bounded check, not this")))

; ── sum-typed protocol state (P18 Rung 4) ────────────────────────

(def connection
  "(defserver ^{:invariant (or (not sending) (= phase 1))} conn
     (init [] (ok {:phase 0 :sending false}))
     (handle-call [:open]  [_ {:keys [phase sending]}] :when (= phase 0)
       (reply :ok {:phase 1 :sending false}))
     (handle-call [:send]  [_ {:keys [phase sending]}] :when (= phase 1)
       (reply :ok {:phase 1 :sending true}))
     (handle-call [:close] [_ {:keys [phase sending]}] :when (= phase 1)
       (reply :ok {:phase 2 :sending false})))")

(def use-after-close
  "(defserver ^{:invariant (or (not sending) (= phase 1))} conn
     (init [] (ok {:phase 0 :sending false}))
     (handle-call [:send] [_ {:keys [phase sending]}] :when (= phase 2)
       (reply :ok {:phase 2 :sending true})))")

(deftest protocol-conformance-proven
  (let [r (sys/verify-process port (read1 connection))]
    (is (:checked r) "a phase-coded variant state is checked")
    (is (:holds r) "the session type (sending ⇒ phase=open) holds")
    (is (empty? (:warnings r)) "open/send/close all conform")))

(deftest protocol-catches-use-after-close
  (let [r (sys/verify-process port (read1 use-after-close))]
    (is (not (:holds r)) "a :send from :closed violates the session type")
    (is (includes? (:msg (first (:warnings r))) "send") "use-after-close is named")))

; ── :~step as a defrelation (P17) ───────────────────────────────────────

(deftest step-relation-reachability-and-counterexample
  (let [labels [:inc :dec :reset]
        stepper (fn [l n] (cond (= l :inc) (min 3 (+ n 1)) (= l :dec) (- n 1)
                                (= l :reset) 0 :else n))
        guarded (fn [l n] (cond (= l :dec) (> n 0) :else true))]
    (is (not (step/reaches? labels stepper guarded 2 (fn [n] (< n 0))))
        "n<0 is unreachable under the (> n 0) guard on :dec")
    (is (= [1 0 -1] (step/path-to labels stepper (fn [l n] true) 1 (fn [n] (< n 0))))
        "without the guard, the counterexample path is 1→0→-1")))

; ═══════════════════════════════════════════════════════════════════════
; P19 — the SORT FUNCTOR: z3 is not an Int solver. Each field's tag-lattice
; tag picks its z3 theory (:int→Int :float→Real :bool→Bool :string→String),
; so one verify-process spans theories. The Int-only limit was in smt.bl's
; translator, never the port.
; ═══════════════════════════════════════════════════════════════════════

(deftest functor-maps-each-tag-to-its-z3-sort
  (is (= "Int"    (smt/sort-of-value (read1 "42")))    "int literal → Int")
  (is (= "Real"   (smt/sort-of-value (read1 "1.5")))   "float literal → Real")
  (is (= "Bool"   (smt/sort-of-value (read1 "true")))  "bool literal → Bool")
  (is (= "String" (smt/sort-of-value (read1 "\"hi\""))) "string literal → String"))

(deftest translator-emits-real-and-string-theory
  (is (= "(>= rate 0.05)" (smt/of-source #{"rate"} "(>= rate 0.05)"))
      "a Real literal passes through with its decimal")
  (is (= "(str.contains reply \"ok\")" (smt/of-source #{"reply"} "(str-contains? reply \"ok\")"))
      "str-contains? → str.contains, string constant quoted")
  (is (= "(str.prefixof \"evt:\" last)" (smt/of-source #{"last"} "(str-prefix? \"evt:\" last)"))
      "str-prefix? → str.prefixof")
  (is (= "(str.len name)" (smt/of-source #{"name"} "(str-len name)"))
      "str-len → str.len"))

(def real-account
  "(defserver ^{:invariant (>= rate 0.0)} rated
     (init [] (ok {:rate 0.05}))
     (handle-call [:bump amt] [_ {:keys [rate]}] :when (>= amt 0.0)
       (reply :ok {:rate (+ rate amt)})))")

(def real-buggy
  "(defserver ^{:invariant (>= rate 0.0)} rated2
     (init [] (ok {:rate 0.05}))
     (handle-call [:bump amt] [_ {:keys [rate]}]
       (reply :ok {:rate (+ rate amt)})))")

(deftest real-valued-invariant-proven-over-reals
  (let [r (sys/verify-process port (read1 real-account))]
    (is (:checked r) "a float-init field makes rate:Real, and it is checked")
    (is (:holds r) "□(rate ≥ 0.0) holds; amt inferred Real by flow into rate")
    (is (empty? (:warnings r)) "no warnings")))

(deftest real-valued-invariant-catches-unguarded
  (let [r (sys/verify-process port (read1 real-buggy))]
    (is (not (:holds r)) "an unguarded real amount breaks rate ≥ 0.0")
    (is (includes? (:msg (first (:warnings r))) "bump") "naming the transition")))

(def string-log
  "(defserver ^{:invariant (str-prefix? \"evt:\" last)} auditlog
     (init [] (ok {:last \"evt:init\"}))
     (handle-cast [:append body] [_ {:keys [last]}]
       (noreply {:last (str \"evt:\" body)})))")

(def string-buggy
  "(defserver ^{:invariant (str-prefix? \"evt:\" last)} auditlog2
     (init [] (ok {:last \"evt:init\"}))
     (handle-cast [:append body] [_ {:keys [last]}]
       (noreply {:last body})))")

(deftest string-content-invariant-proven-over-strings
  (let [r (sys/verify-process port (read1 string-log))]
    (is (:checked r) "a string-init field makes last:String, and it is checked")
    (is (:holds r) "□(evt: prefixes last) holds — content, not length")
    (is (empty? (:warnings r)) "the prefix is preserved by append")))

(deftest string-content-invariant-catches-dropped-prefix
  (let [r (sys/verify-process port (read1 string-buggy))]
    (is (not (:holds r)) "storing the raw body can drop the evt: prefix")
    (is (includes? (:msg (first (:warnings r))) "append") "naming the transition")))

; regression: delaborate must round-trip a string AS a string (bl's pr-str
; does not quote; an unquoted "evt:init" would re-parse as a symbol and break
; establishment). This is the root fix that made the string machine sound.
(deftest delaborate-round-trips-string-literals
  (is (= "{:last \"evt:init\"}" (errors/delaborate (read1 "{:last \"evt:init\"}")))
      "a string value in a map keeps its quotes through delaborate"))
