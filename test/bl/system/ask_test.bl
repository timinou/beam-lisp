; test/bl/system/ask_test.bl — bl.ask: the named questions over source.
;
; One small program is indexed into facts, then the questions a coding agent
; asks of it are answered. The database questions are checked on their rows;
; the file questions on the file's own analysis.
;
; Run: mix bl test test/bl/system/ask_test.bl
(ns system.ask-test
  (:require [bl.ask :as ask]
            [codebase]
            [typed]
            [datom]
            [mcp.tools :as tools]))

(def prog
  (str "(ns demo)\n"
       "(defn c [x] (erlang/+ x 1))\n"
       "(defn b [x] (c x))\n"
       "(defn a [x] (b x))\n"
       "(defn d [x] (erlang/- x 1))\n"
       "(println (a 1))\n"))

(def prog-path "/tmp/bl_ask_test_prog.bl")

(defn- capture
  "Run `f` with this process's group leader on a StringIO, so its stdout is a
   value here. Returns [return-value output]; restores the leader in a finally."
  [f]
  (let [prev (Process/group_leader)
        dev (erlang/element 2 (StringIO/open ""))]
    (Process/group_leader (erlang/self) dev)
    (let [r (try (f) (finally (Process/group_leader (erlang/self) prev)))]
      (list r (erlang/element 2 (StringIO/contents dev))))))

(defn- st [] {:paths [] :code-paths [] :json false})
(defn- jst [] {:paths [] :code-paths [] :json true})

(defn- sigs [] (merge typed/core-sigs typed/core-seeds-v2 typed/host-seeds))

(defn- indexed []
  (File/write! prog-path prog)
  (let [conn (codebase/connect-codebase)]
    (ask/index! conn (sigs) [prog-path])
    conn))

(defn- core-names []
  (reduce (fn [s n] (into s (codebase/core-callee-names n))) #{} ["demo"]))

(defn- names-of [rows]
  (set (map first (to-list rows))))

(defn- source-names-of [rows]
  (set (map second (map to-list (to-list rows)))))

; ── the table ─────────────────────────────────────────────────────────

(deftest questions-are-named
  (testing "every question carries its name, target-need and doc"
    (let [qs (into [] (ask/questions))]
      (is (= 8 (count qs)))
      (is (ask/needs-target? "impact"))
      (is (not (ask/needs-target? "arity-mismatches")))
      (is (ask/db-question? "callers"))
      (is (not (ask/db-question? "dead-code")))
      (is (not (ask/db-question? "nope")) "an unknown name is not a question"))))

(deftest db-questions-are-the-six-fact-questions
  (is (= ["impact" "callers" "reachable" "returns-type"
          "arity-mismatches" "unknown-callees"]
         (into [] (ask/db-questions)))))

; ── the database questions ────────────────────────────────────────────

(deftest impact-is-reverse-reachability
  (testing "impact of c is everything that transitively calls it"
    (let [db (datom/db (indexed))
          rows (ask/answer db "impact" "c" (core-names))]
      (is (contains? (names-of rows) "a"))
      (is (contains? (names-of rows) "b")))))

(deftest callers-report-call-sites
  (testing "callers of b is a, with the call's line"
    (let [db (datom/db (indexed))
          rows (to-list (ask/answer db "callers" "b" (core-names)))]
      (is (= 1 (count rows)))
      (is (= "a" (first (to-list (first rows)))))
      (is (int? (second (to-list (first rows))))))))

(deftest reachable-is-forward-reachability
  (testing "reachable from a is b and c"
    (let [db (datom/db (indexed))]
      (is (= #{"b" "c"} (names-of (ask/answer db "reachable" "a" (core-names))))))))

(deftest nullary-questions-run
  (testing "arity-mismatches and unknown-callees answer over the facts"
    (let [db (datom/db (indexed))]
      (is (= 0 (count (to-list (ask/answer db "arity-mismatches" nil (core-names)))))
          "every call in the program matches its callee's arity"))))

(deftest unknown-question-is-honest
  (is (= :unknown-question (ask/answer (datom/db (indexed)) "nope" nil (core-names)))))

; ── the file questions ────────────────────────────────────────────────

(deftest roots-are-the-top-level-entry-points
  (testing "a is called at top level; d is not"
    (let [rs (set (to-list (ask/roots prog)))]
      (is (contains? rs "a"))
      (is (not (contains? rs "d"))))))

(deftest dead-code-finds-the-unreachable-fn
  (testing "d is never called, so it is dead; a, b and c are live"
    (let [dead (source-names-of (ask/source-rows "dead-code" prog-path prog))]
      (is (= #{"d"} dead)))))

(deftest symbols-carry-proven-facts
  (testing "each definition is reported with its returns, purity and termination"
    (let [rows (to-list (ask/source-rows "symbols" prog-path prog))]
      (is (= 4 (count rows)))
      (is (= #{"a" "b" "c" "d"} (source-names-of rows))))))

; ── the verb ──────────────────────────────────────────────────────────

(deftest run-usage-errors
  (testing "a missing or unknown question, or a missing path, is a usage error"
    (is (= 2 (first (capture (fn [] (ask/run [] (st)))))))
    (is (= 2 (first (capture (fn [] (ask/run ["nope"] (st)))))))
    (is (= 2 (first (capture (fn [] (ask/run ["impact"] (st)))))
           ) "a target question with no target")
    (is (= 2 (first (capture (fn [] (ask/run ["arity-mismatches"] (st))))))
        "no path and no src/ here")))

(deftest run-answers-a-question
  (testing "impact answers with a header and one row per line"
    (let [r (capture (fn [] (ask/run ["impact" "c" prog-path] (st))))
          out (second r)]
      (is (= 0 (first r)))
      (is (includes? out "impact c"))
      (is (includes? out "a\n"))
      (is (includes? out "b\n"))))
  (testing "a question with no rows still exits 0 and says so"
    (let [r (capture (fn [] (ask/run ["dead-code" prog-path] (st))))]
      (is (= 0 (first r)))
      (is (includes? (second r) "d\n") "the dead fn is listed"))))

(deftest run-json-is-one-object
  (testing "--json prints the same answer as one JSON object"
    (let [r (capture (fn [] (ask/run ["impact" "c" prog-path] (jst))))
          out (second r)]
      (is (= 0 (first r)))
      (is (includes? out "\"question\":\"impact\""))
      (is (includes? out "\"target\":\"c\""))
      (is (includes? out "\"count\":3")))))

; ── one implementation, two interfaces ───────────────────────────────

(deftest mcp-delegates-to-ask
  (testing "the MCP handler validates through bl.ask without touching a database"
    (is (= "input_required" (:resultType (tools/code-ask-handler {"question" "impact"})))
        "a target question with no target is elicited (MRTR)")
    (is (:isError (tools/code-ask-handler {"question" "nope"}))
        "an unknown question is this surface's error envelope"))
  (testing "and a real question is answered from the mounted self-index"
    (let [r (tools/code-ask-handler {"question" "arity-mismatches"})]
      (is (= "complete" (:resultType r)))
      (is (list? (:rows r)) "rows come back as plain lists"))))
