(ns system.z3-rejected-script-test)
(deftest a-rejected-assertion-is-an-error-and-the-next-query-keeps-its-own-answer
 (let [port (BeamLisp.Z3Port/open)]
  (try
   (is (= "error" (:status (BeamLisp.Z3Port/check port "(assert (= undeclared_symbol 1))\n" false))))
   (is (= "unsat" (:status (BeamLisp.Z3Port/check port "(assert false)\n" false))))
   (is (= "sat" (:status (BeamLisp.Z3Port/check port "(assert true)\n" false))))
   (finally (BeamLisp.Z3Port/close port)))))
