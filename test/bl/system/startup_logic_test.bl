; Actual code and lifecycle checks; sampled histories are never called proofs.
(ns system.startup-logic-test
 (:require [bl.loading :as loading] [source-graph :as graph]
           [system.publication-closure :as closure] [veritas.model :as vm] [env]))

(deftest all-three-node-graphs-preserve-closure-and-single-discovery
 (doseq [bits (range 512)]
  (let [edges (fn [n] (vec (filter (fn [m] (not= 0 (erlang/band bits (erlang/bsl 1 (+ (* n 3) m)))) ) (range 3))))
        calls (atom {})
        seen (loading/discover [0 1 0] (fn [n] (swap! calls update n (fn [v] (inc (or v 0)))) (edges n)))
        expected (into (set (graph/closure 0 edges)) (graph/closure 1 edges))]
   (is (= expected seen))
   (is (every? (fn [v] (= 1 v)) (vals @calls))))))

(deftest generated-publication-histories-preserve-certificate-validity
 (let [m (vm/model "actual emitted dependencies"
          {:state true
           :init (fn []
                   (let [ns (str "startup.model.p" (erlang/unique_integer (list :positive)))]
                    (env/eval (str "(ns " ns ") (def answer 1) (defn root [] answer)"))
                    (atom {:ns ns :proof (closure/certificate ns "root") :value 1})))
           :commands
           {:unrelated {:next (fn [valid _] valid)
                        :run (fn [sys _] (env/eval (str "(ns " (:ns @sys) ") (defn independent [] 3)")))}
            :change {:next (fn [_ _] false)
                     :run (fn [sys _]
                            (let [value (inc (:value @sys))]
                              (env/eval (str "(ns " (:ns @sys) ") (def answer " value ")"))
                              (swap! sys assoc :value value)))}
            :refresh {:next (fn [_ _] true)
                      :run (fn [sys _] (swap! sys assoc :proof (closure/certificate (:ns @sys) "root")))}}
           :invariants {:matches (fn [valid sys] (= valid (boolean (closure/valid? (:proof @sys)))) )}})
       r (vm/check m {:seed 37 :histories 12 :max-len 10})]
  (println (pr-str r))
  (is (= :witnessed (:modality r)))
  (is (= [] (:unexercised r)))))
