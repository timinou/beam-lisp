; test/bl/system/gateway_test.bl — the gateway verb: the report it gives, and the
; route it says it serves.
;
; Run: bl test test/bl/system/gateway_test.bl
(ns system.gateway-test
  (:require [bl.gateway :as gw] [bl.util :as u] [vm.ports] [vm.gateway]))

(defn- capture [f]
  (let [prev (Process/group_leader)
        dev (erlang/element 2 (StringIO/open ""))]
    (Process/group_leader (erlang/self) dev)
    (let [r (try (f) (finally (Process/group_leader (erlang/self) prev)))]
      (list r (erlang/element 2 (StringIO/contents dev))))))

(defn- name-for [] (str "t_gw_" (erlang/unique_integer (list :positive))))

; ── the unit it would install ─────────────────────────────────────────

(deftest the-unit-file-is-the-user-systemd-one
  (is (ends-with? (gw/unit-path) "/systemd/user/bl-gateway.service")))

; ── the report ────────────────────────────────────────────────────────

(deftest status-answers-with-a-port-or-says-none-is-running
  ;; a gateway may genuinely be running on this machine — a developer's own —
  ;; so the assertion is the SHAPE of the answer: a port and the names it
  ;; routes, or the one line that says it is not running. Never silence.
  (let [[code out] (capture (fn [] (gw/run-status nil nil)))]
    (if (gw/running?)
      (do (is (= 0 code))
          (is (includes? out "bl gateway on")))
      (do (is (= 1 code))
          (is (includes? out "not running"))))))

(deftest a-gateway-in-this-vm-answers-and-reports-its-routes
  (let [n (name-for)
        _ (vm.ports/claim n 0 {:root "/tmp/bl" :hosts (u/to-list ["gw-report.test"])})]
    ;; the gateway is its own foreground process (vm.gateway/run blocks); spawn
    ;; one on an ephemeral port, then query it through bl.gateway as a verb would.
    (spawn (fn [] (vm.gateway/run {:port 0})))
    (erlang/apply :timer :sleep (list 800))
    (let [our-port (vm.gateway/port)]
      (try
        (is (erlang/is_integer our-port) "the gateway is up on an ephemeral port")
        (let [[code out] (capture (fn [] (gw/run-status nil nil)))]
          (is (= 0 code))
          (is (includes? out "bl gateway on"))
          (is (includes? out "gw-report.test") "the route it serves is named"))
        (finally
          (vm.gateway/stop)
          (vm.ports/release n {:root "/tmp/bl"}))))))
