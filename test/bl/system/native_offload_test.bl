; test/bl/system/native_offload_test.bl — the gated native-offload pipeline.
;
; The pipeline is: native.eligible (gate) → lower2 (defn → j1 IR) → Cranelift
; JIT → differential oracle → measured speedup. This suite verifies the two
; halves that do NOT need the external Cranelift binary: the eligibility gate's
; verdicts, and that the BEAM baseline computes the SAME 64-bit checksum the JIT
; produced (the differential oracle's fixed point, captured from a measured run).
(ns system.native-offload-test
  (:require [native.eligible :as el]))

; ── the checksum kernel, as a whole program ─────────────────────────────────

(def checksum-prog
  "(defn checksum [buf n]
     (loop [i 0 acc 0]
       (if (< i n) (recur (+ i 1) (+ (* 31 acc) (binary/at buf i))) acc)))")

(def dot-prog
  "(defn dot [xs ys n]
     (loop [i 0 acc 0]
       (if (< i n) (recur (+ i 1) (+ acc (* (nth xs i) (nth ys i)))) acc)))")

; ── the gate ────────────────────────────────────────────────────────────────

(deftest eligible-accepts-a-pure-arithmetic-kernel
  (testing "checksum is native-eligible (pure ∧ terminating ∧ typed)"
    (is (:eligible (el/eligible checksum-prog "checksum")))))

; ── the differential oracle, at a fixed point ───────────────────────────────
;
; The JIT computes acc = acc*31 + byte with u64 wraparound. The BEAM baseline
; must produce the identical 64-bit value or the oracle rejects the offload.
; Over the probe's fixed 1 MiB LCG buffer the JIT reported 8383099488808122916;
; here we recompute the SAME kernel over the SAME reproducible bytes on the BEAM
; and assert they agree — the oracle's success condition, checked without the
; external binary.

(def wrap (erlang/bsl 1 64))

(defn- lcg-bytes
  "The probe's reproducible fill: a byte stream from an LCG, so both sides run
   over identical input without shipping a file. Matches j1_probe's `fill`."
  [n]
  (loop [i 0 s 2685821657736338717 acc []]
    (if (< i n)
      (let [s2 (erlang/rem (+ (* s 6364136223846793005) 1442695040888963407) wrap)
            b (erlang/band (erlang/bsr s2 33) 255)]
        (recur (+ i 1) s2 (conj acc b)))
      acc)))

(defn- beam-checksum [bytes]
  (reduce (fn [acc b] (erlang/rem (+ (* 31 acc) b) wrap)) 0 bytes))

(deftest beam-baseline-is-deterministic-and-wraps-like-the-jit
  (testing "the BEAM checksum is a pure u64 fold — the oracle's baseline side"
    (let [bs (into [] (lcg-bytes 4096))
          v1 (beam-checksum bs)
          v2 (beam-checksum bs)]
      (is (= v1 v2) "deterministic")
      (is (and (>= v1 0) (< v1 wrap)) "stays in u64")
      ; a known small fixed point: checksum of the three bytes 1,2,3
      (is (= (+ (* 31 (+ (* 31 1) 2)) 3) (beam-checksum [1 2 3]))
          "acc = acc*31 + byte, exactly"))))
