(ns system.host-effect-signatures-test
  (:require [system.footprint :as fp]))

(defn- effect-of [m f argc]
  (fp/fp-anf {} fp/no-resolver
    {:op :remote :mod m :fun f :args (repeat argc {:op :lit :val 1})}))

(deftest immutable-primitives-have-exact-purity-evidence
  (doseq [[m f arity] [[:erlang :+ 2] [:erlang :length 1]
                       [:erlang :is_function 2] [:maps :get 3]
                       [:lists :sort 1] [:binary :part 3]]]
    (is (= {} (effect-of m f arity)) (pr-str [m f arity]))))

(deftest process-and-indirect-call-effects-are-not-hidden-by-module-name
  (doseq [[f arity] [[:put 2] [:get 1] [:erase 1] [:apply 2]
                     [:process_info 2] [:spawn_link 1] [:monotonic_time 0]
                     [:binary_to_atom 1]]]
    (is (= :W (get (effect-of :erlang f arity) fp/opaque-world))
        (pr-str [f arity]))))

(deftest higher-order-host-operations-require-callback-evidence
  (doseq [[m f arity] [[:lists :map 2] [:lists :foldl 3]
                       [:lists :sort 2] [:maps :map 2]
                       [:Elixir.Enum :map 2]]]
    (is (= :W (get (effect-of m f arity) fp/opaque-world))
        (pr-str [m f arity]))))

(deftest lazy-forcing-and-native-state-are-not-value-only-operations
  (doseq [[m f arity] [[:Elixir.BeamLisp.Ns.Rt :first 1]
                       [:Elixir.BeamLisp.LazySeq :first 1]
                       [:Elixir.BeamLisp.LazyMemo :peek 1]
                       [:Elixir.BeamLisp.LazyMemo :read 1]
                       [:Elixir.BeamLisp.LazyMemo :new 1]
                       [:Elixir.BeamLisp.LazyMemo :cas 3]]]
    (is (= :W (get (effect-of m f arity) fp/opaque-world))
        (pr-str [m f arity]))))

(deftest arithmetic-propagates-child-effects
  (let [n {:op :arith :bif :+ :args [{:op :lit :val 1}
                                   {:op :remote :mod :erlang :fun :put
                                    :args [{:op :lit :val :k} {:op :lit :val 2}]}]}]
    (is (= :W (get (fp/fp-anf {} fp/no-resolver n) fp/opaque-world)))))

(deftest unknown-instructions-and-struct-hooks-are-not-a-purity-proof
  (doseq [n [{:op :future-op} {:op :struct :mod :custom :fields []}]]
    (is (= :W (get (fp/fp-anf {} fp/no-resolver n) fp/opaque-world)))))
