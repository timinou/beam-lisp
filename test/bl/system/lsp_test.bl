; test/bl/system/lsp_test.bl — the first-party language server, as pure
; functions over the analyzed program. Each request is a projection of :ann +
; system.analyze; the beyond-LSP requests read proofs no protocol can express.
(ns system.lsp-test
  (:require [lsp]
            [system.analyze :as analyze]))

(def src (str "(defn mk [] :kw)\n"
              "(defn double [x] (erlang/* x 2))\n"
              "(defn use-it [n] (erlang/+ 1 (mk)))\n"
              "(defn caller [n] (double (use-it n)))\n"
              "(defn dead [] 42)"))

; ── core LSP ──────────────────────────────────────────────────────────────

(deftest hover-names-what-the-point-is-on
  (testing "hover answers as data: the kind, the name, and the inferred type"
    (let [h (lsp/hover src 2 18)]
      (is (= :op (:kind h)) "a direct host call")
      (is (= "erlang/*" (:label h)) "named the way the source writes it")
      (is (contains? (:type h) :int) "carrying its inferred tagset"))))

(deftest diagnostics-catch-interprocedural-type-error
  (testing "the (+ 1 (mk:kw)) bug is caught at the argument position"
    (let [ds (lsp/diagnostics src "t")]
      (is (= 1 (count ds)) "exactly one diagnostic")
      (is (= 3 (:line (first ds))) "on line 3 (use-it)")
      (is (some? (index-of (:msg (first ds)) "type error")) "a type error"))))

(deftest document-symbols-carry-proofs
  (testing "each defn reports returns/terminates/pure/calls"
    (let [syms (lsp/document-symbols src)
          by-name (reduce (fn [m s] (assoc m (:name s) s)) {} syms)]
      (is (= 5 (count syms)) "all five defns")
      (is (:pure (get by-name "double")) "double is pure")
      (is (:terminates (get by-name "mk")) "mk terminates"))))

(deftest references-are-graph-based
  (testing "references to double come from the call graph, not text"
    (is (= ["caller"] (lsp/references src "double")) "only caller calls double")))

(deftest definition-resolves-callee
  (testing "definition on a user call resolves the callee name"
    (let [d (lsp/definition src 4 18)]
      (is (= "double" (:resolves-to d)) "resolves to double")
      (is (= :user-fn (:kind d)) "a user fn"))))

; ── beyond LSP: proof-backed requests ──────────────────────────────────────

(deftest proof-hover-reports-the-proof
  (testing "proof-hover returns the whole summary for a fn"
    (let [p (lsp/proof-hover src "double")]
      (is (:pure p) "double is pure")
      (is (:terminates p) "double terminates")
      (is (= #{:float :int} (set (:returns p))) "its return tagset"))))

(deftest native-eligible-is-a-proof-verdict
  (testing "native-eligible reads the doc-05 gate off the summary"
    (is (:eligible (lsp/native-eligible src "double")) "pure+terminating → eligible")))

(deftest impact-is-transitive-callers
  (testing "impact is what breaks when a fn changes: its transitive callers"
    (let [i (lsp/impact src "mk")]
      (is (some? (index-of (pr-str i) "use-it")) "mk's impact includes its direct caller use-it")
      (is (some? (index-of (pr-str i) "caller")) "and caller, which reaches mk through use-it")
      (is (nil? (index-of (pr-str i) "double")) "double never calls mk, so it is not in mk's impact"))))

(deftest dead-code-is-sound
  (testing "dead-code finds functions unreachable from roots"
    (is (some? (index-of (pr-str (lsp/dead-code src ["caller"])) "dead"))
        "dead is unreachable from caller")))

; ── the completed surface ───────────────────────────────────────────────────

(deftest completion-ranks-by-proof
  (testing "completion lists names with their proven detail"
    (let [cs (lsp/completion src 1 1)]
      (is (<= 5 (count cs)) "at least the five defns")
      (is (some (fn [c] (= "double" (:label c))) cs) "includes double"))))

(deftest inlay-hints-show-return-and-effect
  (testing "inlay hints carry the inferred return type"
    (let [hs (lsp/inlay-hints src)]
      (is (some (fn [h] (and (= "double" (:fn h)) (some? (index-of (:hint h) "int")))) hs)
          "double's hint names its int return"))))

(def recursive-src
  (str "(defn fib [n] (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))\n"
       "(defn plain [x] (erlang/+ x 1))"))

(deftest document-symbols-carry-growth
  (testing "a self-recursive symbol carries its growth class; others are nil"
    (let [syms (into {} (map (fn [s] [(:name s) s])
                             (into [] (lsp/document-symbols recursive-src))))]
      (is (= :exponential (:growth (get syms "fib"))) "fib branches over n")
      (is (= "O(2^n)" (:growth-label (get syms "fib"))))
      (is (nil? (:growth (get syms "plain"))) "plain is not self-recursive"))))


; ── top-level (script) forms: the <top> frontier ──────────────────────────
;
; A script's meat lives OUTSIDE any defn. system.analyze compiles those forms
; into a synthetic "<top>" function, so every position feature answers there
; too — and the presentation surfaces never show the plumbing.

(def script-src
  (str "(defn mk [] :kw)\n"
       "(defn double [x] (erlang/* x 2))\n"
       "(println (double 21))\n"
       "(println (mk))\n"))

(deftest top-level-forms-get-a-synthetic-body
  (let [bodies (analyze/fn-bodies script-src)]
    (is (contains? bodies "<top>") "<top> is present")
    (is (contains? bodies "double") "defns still indexed")))

(deftest hover-answers-at-top-level
  (testing "a top-level call names its callee and its interprocedural tagset"
    (let [h (lsp/hover script-src 3 14)]
      (is (= :call (:kind h)) "a user call")
      (is (= "double" (:label h)) "names the callee, not the RT trampoline")
      (is (contains? (:type h) :float) "the interprocedural tagset"))
    (is (contains? (:type (lsp/hover script-src 4 11)) :kw) "through the outer call too")))

(deftest signature-help-answers-at-top-level
  (is (some? (lsp/signature-help script-src 3 14)) "the callee's inferred signature"))

(deftest highlight-finds-top-level-call-sites
  (is (= 1 (count (lsp/document-highlight script-src "double")))
      "the script's call to double is a real occurrence"))

(deftest top-level-callers-count-as-references
  (is (some? (index-of (pr-str (lsp/references script-src "mk")) "<top>"))
      "the script's call to mk is a reference"))

(deftest script-calls-keep-fns-alive
  (is (= [] (into [] (lsp/dead-code script-src [])))
      "nothing is dead: <top> roots the script's uses"))

(deftest top-level-does-not-pollute-the-outline
  (let [syms (lsp/document-symbols script-src)]
    (is (nil? (some (fn [s] (if (= "<top>" (:name s)) s nil)) (into [] syms)))
        "<top> is not a document symbol")))

(deftest top-level-does-not-pollute-completion-or-inlays
  (is (nil? (some (fn [c] (if (= "<top>" (:label c)) c nil)) (into [] (lsp/completion script-src 1 1))))
      "<top> is not a completion")
  (is (nil? (some (fn [h] (if (= "<top>" (:fn h)) h nil)) (into [] (lsp/inlay-hints script-src))))
      "<top> has no inlay hint"))

; ── the hover card ────────────────────────────────────────────────────────
;
; `lsp/hover` answers as DATA; `lsp/hover-card` is what a reader sees. These
; assert the properties a reader depends on: the card is markdown a human reads
; (several lines, a fenced signature), it says what the thing IS, it carries the
; docstring the author wrote — and it never shows an escaped literal, a
; hygienic parameter name, or a fourteen-tag type where `any` would do.

(def documented-src
  (str "(ns demo)\n"
       "\n"
       "(defn greet\n"
       "  \"Say hello to someone.\"\n"
       "  [who]\n"
       "  (str \"hello \" who))\n"
       "\n"
       "(defn use-it []\n"
       "  (greet \"world\"))\n"))

(deftest card-is-multiline-markdown
  (let [c (lsp/hover-card documented-src 9 4)]
    (is (string? c) "a card, not a label")
    (is (some? (index-of c "\n")) "several lines, not one")
    (is (some? (index-of c "```beam-lisp")) "with a fenced signature")))

(deftest card-carries-the-docstring
  (is (some? (index-of (lsp/hover-card documented-src 9 4) "Say hello to someone."))
      "the author's words reach the tooltip"))

(deftest card-uses-the-source-parameter-names
  (is (= "(greet who)" (lsp/signature-of documented-src "greet"))
      "the name the programmer wrote, not the hygienic one the ANF carries"))

(deftest card-names-the-callee-not-the-trampoline
  (let [c (lsp/hover-card documented-src 9 4)]
    (is (some? (index-of c "greet")) "names greet")
    (is (nil? (index-of c "RT/invoke")) "never the trampoline every user call compiles to")
    (is (nil? (index-of c "Elixir.")) "and never a host module name")))

(deftest defn-info-reads-the-docstring-and-the-params
  (let [i (get (lsp/defn-info documented-src) "greet")]
    (is (= "Say hello to someone." (:doc i)) "the docstring, read through the reader")
    (is (= [["who"]] (:params i)) "and the source's parameter names")))

(deftest a-body-string-is-not-a-docstring
  (is (nil? (:doc (get (lsp/defn-info "(defn f [] \"not a doc\")") "f")))
      "a string in the body is not a docstring"))

(deftest tagset-reads-as-any-when-it-is-every-tag
  (let [syms (into {} (map (fn [s] [(:name s) s]) (into [] (lsp/document-symbols documented-src))))]
    (is (= "any" (lsp/tagset-str (:returns (get syms "greet"))))
        "fourteen tags nobody reads is `any`")))

(deftest tagset-lists-the-tags-it-has
  (is (= "float | int" (lsp/tagset-str #{:int :float})) "sorted, colonless")
  (is (= "never" (lsp/tagset-str #{})) "the empty tagset is never"))

(deftest a-literal-is-quoted-once
  (is (= "\"world\"" (lsp/value-str "world")) "quoted once, never escaped")
  (is (nil? (index-of (lsp/value-str "world") "\\")) "no backslash reaches the reader")
  (is (= ":ok" (lsp/value-str :ok)) "a keyword keeps its colon")
  (is (= "42" (lsp/value-str 42)) "a number is itself"))

(deftest the-outline-carries-the-footprint-it-proves
  (let [s (first (lsp/document-symbols "(defn noisy [x] (do (IO/puts \"hi\") x))"))]
    (is (not (:pure s)) "noisy is not pure")
    (is (seq (:footprint s)) "and the outline says WHICH effects, not only that there are some")))
