; test/bl/system/model_defmethod_test.bl — a multimethod lowers to the SAME
; transition clause set as every other dispatch form, so verification written
; once over clauses covers open dispatch too.
;
; The unit is the whole dispatch table: `transitions-for-multi` gathers every
; `defmethod` for a name into one clause set (each arm a branch), and the live
; `Multi` registry supplies keys for runtime-added methods that have no source.

(ns system.model-defmethod-test
  (:require [system.model :as model] [multi]))

(defn- read-src [s] (BeamLisp.Reader/read_string s))

(def area-src
  (str "(defmulti area :shape)\n"
       "(defmethod area :circle [s] (* 3 (:r s) (:r s)))\n"
       "(defmethod area :rect [s] (* (:w s) (:h s)))\n"
       "(defmethod area :tri [s] (* 0.5 (:base s) (:height s)))\n"))

; ── use case 1: a whole multimethod → one clause per method ─────────────

(deftest multimethod-lowers-to-clauses
  (let [clauses (model/transitions-for-multi (read-src area-src) "area")]
    (is (= 3 (count clauses)))
    ; each dispatch value is a branch label, exactly like a defserver's heads
    (is (= #{:circle :rect :tri} (set (map :label clauses))))
    ; the body's value is the next-state expression of each branch
    (is (some? (some (fn [c] (= :circle (:label c))) clauses)))))

; ── use case 2: a single defmethod routes through `transitions` ─────────

(deftest single-defmethod-is-one-clause
  (let [one (first (filter (fn [n] (= "defmethod" (model/head-name n)))
                           (read-src area-src)))]
    (is (= 1 (count (model/transitions one))))
    (is (= :circle (:label (first (model/transitions one)))))))

; ── use case 3: the graph is dispatch-form-independent ─────────────────
;
; The same three arms, whether spelled as a multimethod or as a defserver's
; handle-call clauses, produce the SAME (label → next) graph — the invariance
; the whole model rests on.

(deftest graph-matches-across-forms
  (let [multi-graph (model/graph (model/transitions-for-multi (read-src area-src) "area"))
        server-src (str "(defserver area-srv\n"
                        "  (handle-call [:circle s] [_ st] (reply (* 3 (:r s) (:r s)) st))\n"
                        "  (handle-call [:rect s] [_ st] (reply (* (:w s) (:h s)) st))\n"
                        "  (handle-call [:tri s] [_ st] (reply (* 0.5 (:base s) (:height s)) st)))")
        server-node (first (read-src server-src))
        server-graph (model/graph (model/transitions server-node))]
    ; same set of labels — the dispatch form is invisible to the graph
    (is (= (set (map first multi-graph)) (set (map first server-graph))))
    (is (= #{:circle :rect :tri} (set (map first multi-graph))))))

; ── use case 4: runtime-added methods are enumerable via the registry ──
;
; A method added by evaluation (not source) has no text body — it cannot be
; verified from source — but its dispatch key IS in the live registry, so a
; verifier can enumerate it and report it :approximate rather than miss it.

(deftest runtime-methods-enumerable
  ; define a multimethod live, then add a method at runtime
  (BeamLisp/eval (str "(ns mm.live)\n" area-src))
  (BeamLisp/eval "(ns mm.live)\n(defmethod area :pentagon [s] (* 5 (:side s)))")
  (let [keys (multi/method-keys "mm.live" "area")]
    ; all four arms are registered, including the runtime pentagon
    (is (contains? (set keys) :circle))
    (is (contains? (set keys) :pentagon))
    (is (= 4 (count keys)))))
