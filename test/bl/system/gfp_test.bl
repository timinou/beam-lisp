; test/bl/system/gfp_test.bl — the greatest-fixpoint primitive (P19 R2).
;
; gfp is the dual of datom's least-fixpoint recursion: seed full, shrink to the
; largest stable set. One driver hosts CTL safe-regions and bisimulation; the
; per-step decision is the caller's. These check the driver + the two wrappers
; against closed-form answers.

(ns system.gfp-test
  (:require [system.gfp :as gfp]))

; ── the raw driver ──────────────────────────────────────────────────────

(deftest gfp-shrinks-to-the-largest-stable-set
  (let [r (gfp/gfp #{1 2 3 4 5 6} (fn [t s] (= 0 (mod t 2))))]
    (is (= #{2 4 6} (:fixpoint r)) "keeps exactly the evens")))

(deftest gfp-empty-when-nothing-survives
  (is (= #{} (:fixpoint (gfp/gfp #{1 2 3} (fn [t s] false)))) "everything falls → empty"))

(deftest gfp-identity-when-all-survive
  (is (= #{1 2 3} (:fixpoint (gfp/gfp #{1 2 3} (fn [t s] true)))) "nothing falls → seed"))

; mutual dependence: a tuple survives only if its 'partner' is still in S. Seed
; {1 2 3}; 1 needs 2, 2 needs 1, 3 needs a missing 9. 3 falls, then 1&2 hold.
(deftest gfp-handles-mutual-dependence
  (let [needs {1 2, 2 1, 3 9}
        r (gfp/gfp #{1 2 3} (fn [t s] (contains? s (get needs t))))]
    (is (= #{1 2} (:fixpoint r)) "3 falls (needs 9); 1 and 2 mutually support")))

; ── the semi-naive delta does less work, same answer ────────────────────

(deftest gfp-delta-matches-naive-with-fewer-checks
  (let [succ {0 [1] 1 [2] 2 [3] 3 [] 4 [3]}
        surv? (fn [s S] (and (not (= s 3)) (every? (fn [n] (contains? S n)) (get succ s []))))
        dep?  (fn [t fell] (some (fn [n] (contains? fell n)) (get succ t [])))
        naive (gfp/gfp #{0 1 2 3 4} surv?)
        delta (gfp/gfp-delta #{0 1 2 3 4} surv? dep?)]
    (is (= (:fixpoint naive) (:fixpoint delta)) "delta reaches the same fixpoint")
    (is (= #{} (:fixpoint delta)) "3 is bad and everything reaches it → empty here")))

; ── provenance records why each tuple fell ──────────────────────────────

(deftest gfp-explained-logs-the-derivation
  (let [r (gfp/gfp-explained #{1 2 3}
            (fn [t s] (if (= t 2) :too-even nil)))]
    (is (= #{1 3} (:fixpoint r)) "2 falls")
    (is (= 1 (count (:log r))) "one fall logged")
    (is (= :too-even (:witness (first (:log r)))) "the witness is recorded")))

; ── CTL AG: the safe region ─────────────────────────────────────────────

(deftest safe-region-is-states-that-never-reach-bad
  (let [succ {0 [1] 1 [2] 2 [3] 3 [0] 4 [2 5] 5 []}
        safe (gfp/safe-region [0 1 2 3 4 5] (fn [s] (get succ s [])) (fn [s] (= s 5)))]
    (is (= #{0 1 2 3} safe) "the 0-3 cycle stays safe; 4 reaches 5; 5 is bad")))

(deftest safe-region-empty-when-init-cycle-is-doomed
  (let [succ {0 [1] 1 [0] 2 []}
        safe (gfp/safe-region [0 1 2] (fn [s] (get succ s [])) (fn [s] (= s 2)))]
    (is (contains? safe 0) "the 0↔1 cycle never reaches 2 → safe")
    (is (not (contains? safe 2)) "2 is bad → not safe")))

; ── bisimulation: behavioural minimization ──────────────────────────────

(deftest bisimulation-merges-behaviourally-equal-states
  (let [delta {[0 :a] 1 [0 :b] 2 [1 :a] 3 [2 :a] 3 [3 :a] 3}
        labels (fn [s] (into #{} (keep (fn [l] (if (contains? delta [s l]) l nil)) [:a :b])))
        step (fn [s l] (get delta [s l]))
        bisim (gfp/bisimulation [0 1 2 3] labels step)]
    ; 1,2,3 all do exactly :a→(:a-sink); 0 alone has a :b. So {1,2,3} merge.
    (is (contains? bisim [1 2]) "1 and 2 are bisimilar (both only :a→3)")
    (is (contains? bisim [2 3]) "2 and 3 are bisimilar")
    (is (not (contains? bisim [0 1])) "0 is distinct — it has a :b transition")))
