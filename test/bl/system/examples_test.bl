; test/bl/system/examples_test.bl — the example runner's selection and verdict.
;
; bl.examples hands files to ward's isolated, timed, dep-aware runner and turns
; its aggregate into an exit code. These tests pin the glob selection, the
; aggregate a trivial example produces, and the two verdicts — a failing
; example fails the run, a skipped one does not.
;
; Run: mix bl test test/bl/system/examples_test.bl
(ns system.examples-test
  (:require [bl.cli :as cli]
            [bl.examples :as v]))

(defn- tmp-root []
  (str (System/tmp_dir!) "/bl_examples_" (erlang/unique_integer (list :positive))))

(defn- capture
  "Run `f` with this process's group leader on a StringIO, so the command's
   stdout is a value here. Returns a two-element list of the return value and
   the captured output; restores the leader in a finally."
  [f]
  (let [prev (Process/group_leader)
        dev (erlang/element 2 (StringIO/open ""))]
    (Process/group_leader (erlang/self) dev)
    (let [r (try (f) (finally (Process/group_leader (erlang/self) prev)))]
      (list r (erlang/element 2 (StringIO/contents dev))))))

(defn- with-tmp [f]
  (let [root (tmp-root)]
    (try (File/mkdir_p! root) (f root) (finally (File/rm_rf! root)))))

(deftest match-paths-expands-globs-sorted-and-unique
  (with-tmp
    (fn [root]
      (File/mkdir_p! (str root "/sub"))
      (File/write! (str root "/b.bl") "(println :b)\n")
      (File/write! (str root "/sub/a.bl") "(println :a)\n")
      (is (= [(str root "/b.bl") (str root "/sub/a.bl")]
             (into [] (v/match-paths (list (str root "/**/*.bl")))))
          "one glob, every file, in one order")
      (is (= [(str root "/b.bl")]
             (into [] (v/match-paths (list (str root "/b.bl") (str root "/b.bl")))))
          "the same file named twice is selected once")
      (is (= [] (into [] (v/match-paths (list (str root "/nothing/*.bl")))))))))

(deftest a-trivial-example-passes
  (with-tmp
    (fn [root]
      (File/write! (str root "/ok.bl") "(println :hi)\n")
      (let [d (v/analyze (v/match-paths (list (str root "/*.bl"))))]
        (is (= 1 (:passed d)))
        (is (= 0 (:failed d)))
        (is (= 0 (:skipped d)))
        (is (:ok d))))))

(deftest a-throwing-example-fails-the-run
  (with-tmp
    (fn [root]
      (File/write! (str root "/bad.bl") "(throw (ex-info \"boom\" {}))\n")
      (let [d (v/analyze (v/match-paths (list (str root "/*.bl"))))]
        (is (= 1 (:failed d)))
        (is (not (:ok d)))))))

(deftest run-exits-per-the-verdict-and-emits-one-json-object
  (with-tmp
    (fn [root]
      (File/write! (str root "/ok.bl") "(println :hi)\n")
      (let [r (capture
                (fn []
                  (v/run (list (str root "/*.bl"))
                         (cli/parse-argv (list "examples" "--json")))))]
        (is (= 0 (first r)) "a green example exits 0")
        (is (includes? (second r) "\"passed\":1") "the JSON names the totals")
        (is (includes? (second r) "\"ok\":true")))
      (File/write! (str root "/bad.bl") "(throw (ex-info \"boom\" {}))\n")
      (is (= 1 (first (capture
                        (fn []
                          (v/run (list (str root "/*.bl"))
                                 (cli/parse-argv (list "examples" "--json")))))))
          "a failing example exits 1"))))

(deftest run-with-no-matching-glob-is-a-usage-error
  (with-tmp
    (fn [root]
      (is (= 2 (first (capture
                        (fn []
                          (v/run (list (str root "/*.bl"))
                                 (cli/parse-argv (list "examples")))))))
          "an empty selection is a typo, not a green run over nothing"))))
