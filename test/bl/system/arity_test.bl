; test/bl/system/arity_test.bl — call-site arity, and the bug class it fences.
;
; The bug: `(into {} (keep (fn [l] …)) coll)` — one closing paren too many, so
; `keep` is called with ONE argument (the transducer shape). bl's `keep` is
; `[f coll]`; `into` IS 3-arity-transducer-capable, so the code reads as valid
; Clojure, compiles, and dies at RUNTIME with `BadArityError … keep/2 called
; with 1 argument` — on the request that first reached the expression. It cost a
; customer-facing 500, and five more instances of the same shape were written
; while fixing it (two inside this very tier).
;
; This file exists for the second half of that sentence. `diagnostics` fails
; safe — a source it cannot read yields NO findings — which is right for a
; checker and dangerous for its author: a tier broken by its own misplaced paren
; reports "nothing to report" exactly like a clean tree. So the tier gets a
; test, and the test asserts BOTH directions: the shape is caught, and the
; shapes one keyword away from it are not.
(ns system.arity-test
  (:require [system.arity :as ar]))

(def wrong-arity
  "(ns demo)\n(defn t [f] (keep f))\n")

(def the-real-thing
  "(ns demo)\n(defn t [f c]\n  (into {} (keep (fn [l] (if (nil? l) nil [l c]))) c))\n")

(def right-arity
  "(ns demo)\n(defn t [f c] (keep f c))\n")

(def variadic-is-fine
  "(ns demo)\n(defn t [a b c] (str a b c))\n")

(def transducer-is-fine
  "(ns demo)\n(defn t [f c] (filter f c))\n")

(def a-local-shadows-core
  "(ns demo)\n(defn keep [x] x)\n(defn t [f] (keep f))\n")

(def unknown-head-is-not-judged
  "(ns demo)\n(defn t [f] (some-module/some-fn f f f f f f))\n")

(def unreadable-source
  "(ns demo)\n(defn t [f]\n")

(deftest catches-a-core-callee-called-at-an-arity-it-does-not-have
  (testing "(keep f)"
    (let [ds (ar/diagnostics wrong-arity)]
      (is (= 1 (count ds)))
      (is (= :call-arity (:kind (first ds))))
      (is (= "t" (:fn (first ds))))
      (is (= 2 (:line (first ds))))
      (is (String/contains? (:msg (first ds)) "keep is called with 1 argument"))))
  (testing "the nested shape that actually shipped — found inside the expression"
    (let [ds (ar/diagnostics the-real-thing)]
      (is (= 1 (count ds)))
      (is (String/contains? (:msg (first ds)) "keep is called with 1 argument")))))

(deftest leaves-the-legal-neighbours-alone
  (testing "(keep f c) — the whole point of the check"
    (is (empty? (ar/diagnostics right-arity))))
  (testing "(str a b c) — a variadic callee accepts any arity above its min"
    (is (empty? (ar/diagnostics variadic-is-fine))))
  (testing "(filter f c) — bl's filter IS 1-arity (it returns a transducer)"
    (is (empty? (ar/diagnostics transducer-is-fine))))
  (testing "a source that defines `keep` itself is not held to core's keep"
    (is (empty? (ar/diagnostics a-local-shadows-core))))
  (testing "a qualified head this VM cannot resolve is not judged"
    (is (empty? (ar/diagnostics unknown-head-is-not-judged))))
  (testing "a source that does not parse yields no findings, and does not throw"
    (is (empty? (ar/diagnostics unreadable-source)))))

(deftest reading-a-file-is-what-it-costs
  (testing "the tier walks reader forms — it must not run the definition/type pass
            (`codebase/index-source`) it once used: measured 1.7–16.2 s per file
            there, 0.01–0.25 s here. A generous ceiling still catches that
            regression, which is invisible in the findings."
    (let [src (File/read! "priv/lib/lsp.bl")
          t0 (erlang/monotonic_time :millisecond)
          _ (ar/diagnostics src)
          ms (- (erlang/monotonic_time :millisecond) t0)]
      (is (< ms 2000) (str "took " ms "ms")))))
