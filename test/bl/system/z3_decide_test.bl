; test/bl/system/z3_decide_test.bl — the ladder decides what it can prove, passes
; down what it cannot, and records which rung answered.
;
; The classification reads the COMMANDS — the forms `z3/check` was handed — not the
; rendered SMT text, because the caller already has the forms. A raw SMT string is
; classified `:general` and goes to z3: not read, not claimed.
;
; The rung that exists today is a bounded witness search, and it is sound in ONE
; direction only (finding an assignment proves "sat"; never claims unsat, and only
; when EVERY assertion parsed). Everything the tests below assert is that
; behaviour, including the cases where it must stay silent.

(ns mcp.z3.decide.test
  (:require [z3]
            [system.decide :as decide]
            [mcp.tools :as tools]))

(defn- cmds [& forms] (apply list forms))

(deftest classification-is-conservative
  (is (= :arith (decide/classify (cmds (list 'declare-const 'x 'Int)
                                       (list 'assert (list '> 'x 2))))))
  (is (= :general (decide/classify (cmds (list 'assert (list '= (list '* 'x 'x) 4)))))
      "a product leaves linear arithmetic")
  (is (= :general (decide/classify "(assert (* x x))"))
      "a raw SMT string was never read, so it is never claimed")
  (is (= :tag-lattice (decide/classify (cmds (list 'assert (list '= 'tag_x 1)))))
      "value-model names with no arithmetic"))

(deftest a-witness-is-an-answer-not-a-guess
  (is (some? (decide/witness (cmds (list 'declare-const 'x 'Int)
                                   (list 'assert (list '> 'x 0)))))
      "an assignment satisfies it, so the question is answered natively")
  (is (nil? (decide/witness (cmds (list 'declare-const 'x 'Int)
                                  (list 'assert (list '> 'x 900))))))
  (is (nil? (decide/witness (cmds (list 'assert (list 'or (list '> 'x 0) (list '< 'x 0))))))
      "an assertion it did not understand means NO claim")
  (is (nil? (decide/witness (cmds (list 'declare-const 'x 'Int)
                                  (list 'assert (list '> 'x 0))
                                  (list 'assert (list '< 'x 0)))))))

(deftest the-ladder-answers-cheap-and-falls-through
  ;; The oracle thunk LIES ("unsat", whatever is asked). So a "sat" here can only
  ;; be the cheap rung answering without consulting z3 — asserting the status alone
  ;; would pass even if the rung had never run.
  (let [sat (decide/decide-native (cmds (list 'declare-const 'x 'Int) (list 'assert (list '> 'x 0)))
                                  (fn [] "unsat"))
        contra (decide/decide-native (cmds (list 'declare-const 'x 'Int)
                                           (list 'assert (list '> 'x 0))
                                           (list 'assert (list '< 'x 0)))
                                     (fn [] "unsat"))]
    (is (= "sat" (:status sat)) "the native rung answered a satisfiable question")
    (is (= :native-witness (:tier sat)) "and took the credit for it")
    (is (= "unsat" (:status contra)) "and fell through on the one it refused to claim")
    (is (= :z3 (:tier contra)) "leaving it to the oracle"))
  (decide/reset-ledger!)
  (let [_x (decide/decide-native (cmds (list 'declare-const 'x 'Int) (list 'assert (list '> 'x 0))) (fn [] "unsat"))
        _y (decide/decide-native (cmds (list 'assert (list '= 'x 1))) (fn [] "sat"))
        h (decide/histogram)]
    (is (>= (:total h) 2) (str "both decisions were recorded: " (pr-str h)))
    (is (>= (get (:tiers h) :native-witness) 1) (str "one native: " (pr-str h)))
    (is (>= (get (:tiers h) :z3) 1) (str "one z3: " (pr-str h)))
    (is (>= (get (:fragments h) :arith) 1) (str "and the fragment is known: " (pr-str h)))))

(deftest a-verify-reports-which-tier-answered
  ;; The MECHANISM a tool call reads to say what proved the answer. The one consumer
  ;; today — a wrapper on `code-verify-handler` that adds :tiers/:tier — lives in
  ;; priv/lib/mcp/tools.bl, which another session is actively editing, so it is NOT
  ;; part of this commit. Asserting it here would make a fresh checkout fail; the
  ;; wrapper's own behaviour is verified on the built drop and recorded in PLAN-106
  ;; step 4, and gets its assertion back when that file settles.
  (decide/clear-here!)
  (let [status (z3/check nil (cmds (list 'declare-const 'x 'Int) (list 'assert (list '> 'x 1))))
        trail (decide/here)
        r (tools/code-verify-handler
            {"source" "(defserver ^{:invariant (>= balance 0)} account (init [balance] (ok balance)) (handle-call [:withdraw amt] [_ balance] :when (and (>= amt 0) (>= balance amt)) (reply :ok (- balance amt))))"})]
    (is (= "sat" status) "a check runs")
    (is (not (empty? trail)) (str "and leaves a trail this process can read: " (pr-str trail)))
    (is (= :z3 (decide/tier-for trail)) "the oracle is the weakest tier that took part")
    (is (= :z3 (decide/tier-for (to-list []))) "an empty trail never claims a native answer")
    (is (= :native-witness (decide/tier-for (to-list [{:fragment :arith :tier :native-witness}])))
        "a native-only trail does")
    (is (= "holds" (:verdict r)) "the verifier still proves the invariant")))

;; ── FUP-053: the counterexample, pinned ─────────────────────────────────────
;;
;; Measured, not reasoned about: enumerating guard pairs against z3 found 12 of 256
;; where the rung said SAT and z3 said unsat. Every one had a COMPOUND left side.
;; `(> (- x) 5)` was read as a guard over a variable named by the printed form of
;; `(- x)`; that key can never be in an assignment, so the comparison ran against
;; nil — and Erlang sorts atoms ABOVE all numbers, so `(> nil 5)` is TRUE and the
;; guard passed vacuously. The minimal shape is `x > 5 and -x > 5`, which is unsat.

(deftest a-compound-left-side-is-not-a-guard
  (is (nil? (decide/witness (cmds (list 'declare-const 'x 'Int)
                                  (list 'assert (list '> 'x 5))
                                  (list 'assert (list '> (list '- 'x) 5)))))
      "the pair z3 proved unsat: a form on the left of a comparison is not a variable")
  (is (nil? (decide/witness (cmds (list 'declare-const 'x 'Int)
                                  (list 'assert (list '= (list '- 'x) 0)))))
      "and one such guard alone is already unwitnessable, not a free answer"))

(deftest silence-about-a-name-is-not-a-satisfied-guard
  (is (nil? (decide/witness (cmds (list 'declare-const 'x 'Int)
                                  (list 'assert (list '>= 'y 0)))))
      "a guard over an undeclared name has no value to compare, so nothing is claimed")
  (is (nil? (decide/witness (cmds (list 'declare-const 'b 'Bool)
                                  (list 'assert (list '> 'b 5)))))
      "a sort this rung cannot evaluate is not modelled at all"))

(deftest an-unreadable-assertion-sinks-the-whole-question
  (is (nil? (decide/witness (cmds (list 'declare-const 'x 'Int)
                                  (list 'assert (list '> 'x 0))
                                  (list 'assert)))))
      "a question is all of its assertions or none of them — never the readable subset")
