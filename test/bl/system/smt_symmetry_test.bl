; test/bl/system/smt_symmetry_test.bl — the fragment SYMMETRY assurance.
;
; The load-bearing claim: every symbol in the veritas fragment evaluates in bl
; with the SAME meaning it has in z3. This is the other half of fragment
; closure — smt_fragment_test pins the z3 translation, this pins the bl eval.
;
; Why it matters: veritas escalates z3 → enumerate → sample. When a predicate
; falls to the bl fallback (holds?), a fragment symbol that RAISES in bl is
; counted as "not holds" and SPURIOUSLY refutes. `=>` and `ite` were exactly
; that trap. This test forbids the regression: each must eval, and ite must be
; LAZY (only the taken branch evaluates — z3's ite is not strict).

(ns system.smt-symmetry-test
  (:require [core]))

; ── => : logical implication, an ordinary 2-ary bl fn (both args are bools) ──

(deftest implies-evaluates
  (is (= true  (=> true true)))
  (is (= false (=> true false)))
  (is (= true  (=> false true)))
  (is (= true  (=> false false))))

(deftest implies-matches-or-not
  ; (=> a b) ≡ (or (not a) b) — the classical identity, for every combination
  (is (= (=> true true)   (or (not true) true)))
  (is (= (=> true false)  (or (not true) false)))
  (is (= (=> false true)  (or (not false) true)))
  (is (= (=> false false) (or (not false) false))))

; ── ite : z3's conditional. MUST be lazy — the untaken branch never evaluates ─

(deftest ite-evaluates
  (is (= 1 (ite true 1 2)))
  (is (= 2 (ite false 1 2))))

(deftest ite-is-lazy
  ; the untaken branch RAISES if evaluated; a lazy ite never touches it.
  (is (= 1 (ite true 1 (/ 1 0))))
  (is (= 2 (ite false (/ 1 0) 2))))

(deftest ite-matches-if
  (is (= (if (> 3 2) :a :b) (ite (> 3 2) :a :b)))
  (is (= (if (< 3 2) :a :b) (ite (< 3 2) :a :b))))

; ── the composite predicate that used to spuriously refute ──────────────────

(deftest floor-predicate-evals-in-bl
  ; (>= (ite (< a 0) 0 a) 0) — the billing floor, as bl. For a<0 → 0≥0 true;
  ; for a≥0 → a≥0 true. The exact shape that raised (ite unknown) before.
  (let [pred (fn [a] (>= (ite (< a 0) 0 a) 0))]
    (is (= true (pred -5)))
    (is (= true (pred 0)))
    (is (= true (pred 7)))))

(run-tests)
