; test/bl/system/test_verb_test.bl — `bl test` owns the shapes: which files it
; will run, where the retired `ward` went, and that the command table holds one
; runner rather than two.
;
; The runner itself is exercised in test/beam_lisp/test_verb_test.exs, where no
; outer ward is running: the isolated runner is not reentrant on itself, so a
; bl-language test may not start a suite inside a suite.
;
; Run: bl test test/bl/system/test_verb_test.bl
(ns system.test-verb-test
  (:require [bl.test :as t] [bl.cli :as cli] [bl.util :as u]))

(defn- scratch [f]
  (let [root (str (System/tmp_dir!) "/bl_testverb_" (erlang/unique_integer (list :positive)))]
    (try
      (File/mkdir_p! root)
      (f root)
      (finally (File/rm_rf! root)))))

(defn- write! [root rel text]
  (let [p (str root "/" rel)]
    (File/mkdir_p! (Path/dirname p))
    (File/write! p text)
    p))

(defn- capture [f]
  (let [prev (Process/group_leader)
        dev (erlang/element 2 (StringIO/open ""))]
    (Process/group_leader (erlang/self) dev)
    (let [r (try (f) (finally (Process/group_leader (erlang/self) prev)))]
      (list r (erlang/element 2 (StringIO/contents dev))))))

(defn- run-in [dir argv]
  (BeamLisp/with_cwd dir
    (fn [] (capture (fn [] (cli/run-argv (to-list argv)))))))

; ── choosing the files ────────────────────────────────────────────────

(deftest a-directory-expands-to-its-sources
  (scratch
    (fn [root]
      (write! root "test/b_test.bl" "(ns b-test)\n(deftest b (is true))\n")
      (write! root "test/a_test.bl" "(ns a-test)\n(deftest a (is true))\n")
      (write! root "test/notes.md" "not a source\n")
      (let [fs (t/files (list root))]
        (is (= 2 (count fs)) "only loader sources")
        (is (includes? (first fs) "a_test.bl") "sorted, so a run is reproducible")))))

(deftest a-file-argument-is-itself
  (scratch
    (fn [root]
      (let [p (write! root "test/only_test.bl" "(ns only-test)\n(deftest x (is true))\n")]
        (is (= (list p) (t/files (list p))))))))

(deftest a-literate-file-argument-is-itself
  (scratch
    (fn [root]
      (let [p (write! root "test/doc_test.bl.md"
                      "# A document\n\n```beam-lisp\n(ns doc-test)\n(deftest x (is true))\n```\n")]
        (is (= (list p) (t/files (list p)))
            "a `.bl.md` is a loader source, so an explicit name runs it")))))

(deftest the-default-corpus-is-named-for-tests-not-documents
  (scratch
    (fn [root]
      (write! root "test/real_test.bl" "(ns real-test)\n(deftest a (is true))\n")
      ;; A document is NOT a suite. Its cells may declare an expensive scenario —
      ;; a live world, a walkthrough — that only an explicit name may run, so the
      ;; conventional corpus says `_test.bl` and says it about `.bl` files.
      (write! root "test/scenario.bl.md"
              "# A walkthrough\n\n```beam-lisp\n(ns scenario)\n(deftest expensive (is true))\n```\n")
      (BeamLisp/with_cwd root
        (fn []
          (let [fs (t/files (list))]
            (is (= 1 (count fs)) "no arguments means the `_test.bl` corpus — unchanged")
            (is (includes? (first fs) "real_test.bl"))))))))

(deftest no-arguments-means-test
  (scratch
    (fn [root]
      (let [p (write! root "test/some_test.bl" "(ns some-test)\n(deftest x (is true))\n")]
        (BeamLisp/with_cwd root
          (fn []
            (is (some (fn [f] (= f p)) (t/files (list)))
                "with no arguments, `test` is the directory searched — resolved
                 against the command's cwd, not the process's")))))))

(deftest no-test-files-is-a-usage-error-not-a-green-run
  (scratch
    (fn [root]
      (let [[code out] (run-in root ["test"])]
        (is (= 2 code))
        (is (not (includes? out "passed")) "nothing to run is not a pass")))))

; ── the retired verb ──────────────────────────────────────────────────

(deftest ward-points-at-what-replaced-it
  (scratch
    (fn [root]
      (write! root "test/ok_test.bl" "(ns ok-test)\n(deftest fine (is true))\n")
      (let [[code _out] (run-in root ["ward" "test/ok_test.bl"])]
        (is (= 2 code) "`bl ward` is a usage error with a pointer, not a runner")))))

(deftest there-is-one-test-runner-in-the-command-table
  (is (not (nil? (get-in cli/commands ["test"]))) "test is a command")
  (is (nil? (get-in cli/commands ["ward"]))
      "and ward is not: one runner, no second word to learn")
  (is (includes? (get-in cli/command-help ["test"]) "--shared")
      "the escape hatch is documented where the command is"))

; ── discovery is the FILESYSTEM, and a hole is NAMED ───────────────────

(deftest a-file-written-a-moment-ago-is-discovered-by-name
  (scratch
    (fn [root]
      (let [p (write! root "test/brand_new_test.bl" "(ns brand-new-test)\n(deftest t (is true))\n")]
        ; Written and discovered in the same breath: discovery reads the
        ; filesystem, so there is no index to be cold, no cache to be stale and
        ; no manifest to disagree — the file is in the list because it EXISTS.
        (is (= (list p) (to-list (t/files (list root))))
            "a directory expands to the test files under it")
        (is (= (list p) (to-list (t/files (list p))))
            "and by name, when the caller names it")))))

(deftest the-checkout-corpus-is-discovered-by-name
  ; The question the post-cutover runs could not answer: is a file the suite
  ; never announced still FOUND? Discovery is `File/ls!` walking the tree, so
  ; this prints the very list a run is built from and names one file in it.
  (let [fs (to-list (t/files (list)))
        rel "test/bl/datom/datahike_differential_test.bl"
        found (some (fn [f] (if (includes? f rel) f nil)) fs)]
    (println (str "discovery: " (count fs) " test file(s) under test/, including"))
    (println (str "  " rel))
    (is (some? found)
        (str rel " is discovered BY NAME — it is on the filesystem, so it is in the run"))))

(deftest a-target-that-names-nothing-is-named-not-dropped
  (scratch
    (fn [root]
      (write! root "test/good_test.bl" "(ns good-test)\n(deftest ok (is true))\n")
      (let [absent (str root "/test/typo_test.bl")
            missing (BeamLisp/with_cwd root
                      (fn [] (to-list (t/missing-targets (list "test" "test/typo_test.bl")))))]
        (is (= (list absent) missing)
            "an argument that resolves to nothing is REPORTED by name, not dropped")
        (let [[code _out] (run-in root ["test" "test/typo_test.bl"])]
          (is (= 2 code)
              "and it is the usage-class exit: every named target was a hole — the report named it"))))))
