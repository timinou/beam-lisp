; test/bl/system/ir_smells_test.bl — the ANF-access house smells detect and fix.
(ns system.ir-smells-test
  (:require [deodorant :as deo] [system.ir-smells]))

; deodorant matches PEELED data (native forms), not reader nodes — the same
; input deo/fix-source reads. read_all_data is that reader.
(defn- rd [s] (first (BeamLisp.Compiler/read_all_data s)))
(defn- fix [s] (deo/deodorize-with (deo/all-rules) (rd s)))

(deftest ann-get-detected-and-fixed
  (testing "raw :ann reads rewrite to system.ir/ann-get"
    (is (= (rd "(system.ir/ann-get node :pure)") (fix "(get (:ann node) :pure)")))
    (is (= (rd "(system.ir/ann-get node :footprint)") (fix "(get-in node [:ann :footprint])")))))

(deftest ann-put-detected
  (testing "hand-rolled :ann write rewrites to ann-put"
    (is (= (rd "(system.ir/ann-put n :k v)") (fix "(assoc n :ann (assoc (:ann n) :k v))")))))

(deftest computed-key-left-alone
  (testing "a variable key is not a keyword literal — untouched"
    (is (= (rd "(get (:ann node) k)") (fix "(get (:ann node) k)")))))

(deftest op-smell-is-reinvention-tier
  (testing "op-of is opt-in (every-rule), not in the default set"
    (let [in-default (some (fn [s] (= (:name s) 'op-of)) (deo/all-rules))
          in-every   (some (fn [s] (= (:name s) 'op-of)) (deo/every-rule))]
      (is (nil? in-default) "op-of not in default deodorize")
      (is (some? in-every) "op-of present under every-rule"))))
