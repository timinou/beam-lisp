; test/bl/system/watch_test.bl — the watch verb's renderer and usage contract.
;
; `bl.watch/render` is the ONE rendering of a reload commit: the daemon calls it
; through the runtime, a standalone `bl watch` calls it in process, so a commit
; line cannot drift between the two hosts. A line must name the file that
; changed and read as prose — never a raw map dump — and a hold must say WHY.
;
; Run: mix bl test test/bl/system/watch_test.bl
(ns system.watch-test
  (:require [bl.cli :as cli]
            [bl.watch :as v]))

(def sample
  "A representative watch result: one applied commit for one file."
  {:path    "/tmp/watch-demo/app/foo.bl"
   :status  :applied
   :bundle  ["app.foo"]
   :applied ["app.foo"]
   :errors  []})

(def held
  "A representative HOLD: the bundle was incoherent, the old code keeps serving."
  {:path   "/tmp/watch-demo/app/bar.bl"
   :status :held
   :bundle ["app.bar"]
   :errors [{:kind :dangling :msg "calls app.gone/f, which is not live"}]})

(deftest render-names-the-changed-file
  (let [s (v/render sample)]
    (is (not= "" s) "a commit renders something")
    (is (includes? s "/tmp/watch-demo/app/foo.bl") "the saved path is in the line")
    (is (includes? s "applied") "the outcome is in the line")
    (is (includes? s "app.foo") "the namespaces touched are in the line")))

(deftest render-is-not-a-map-dump
  (is (not (includes? (v/render sample) "%{"))
      "the result map is rendered, never printed"))

(deftest render-says-why-a-bundle-was-held
  (let [s (v/render held)]
    (is (includes? s "/tmp/watch-demo/app/bar.bl"))
    (is (includes? s "held"))
    (is (includes? s "calls app.gone/f, which is not live")
        "a hold shows the reason the old code kept serving")))

(deftest render-tolerates-a-result-without-a-path
  (let [s (v/render {:status :applied :bundle ["app.x"] :errors []})]
    (is (not= "" s))
    (is (includes? s "applied"))))

(deftest run-without-a-target-is-a-usage-error
  (is (= 2 (v/run (list) (cli/parse-argv (list "watch"))))
      "no FILE|DIR reports usage and parks nothing"))
