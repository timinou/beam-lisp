; test/bl/system/sorts_test.bl — a field's SMT sort comes from its literal.
;
; Before this, every init shape except a map of fields became `Int`: a bare
; literal init (`(init [x] (ok 0.5))`) fell through to the invariant's mentioned
; variables, all Int. The same establishment script through the bundled z3:
;
;   (define-fun Inv ((x Real)) Bool (= (* x 2) 1))  (assert (not (Inv 0.5)))  → unsat
;   (define-fun Inv ((x Int))  Bool (= (* x 2) 1))  (assert (not (Inv 0.5)))  → sat
;
; so a correct machine read as broken. These three tests are the fix and its
; control: the control matters more, because a sort inference that made every
; machine verify would pass the first test and be useless.

(ns system.sorts-test
  (:require [system.core :as sys]
            [system.smt :as smt]
            [z3]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))

(defn- holds? [src] (:holds (sys/verify-process (z3/open) (read1 src))))

(deftest a-real-valued-state-gets-the-real-theory
  (is (holds? "(defserver ^{:invariant (= (* x 2) 1)} half
                 (init [x] (ok 0.5))
                 (handle-call [:noop] [_ x] (reply :ok x)))")
      "0.5 doubles to 1 — true of a Real, false of every Int"))

(deftest an-integer-state-still-verifies
  (is (holds? "(defserver ^{:invariant (>= n 0)} counter
                 (init [n] (ok 0))
                 (handle-call [:bump] [_ n] (reply :ok (+ n 1))))")))

(deftest the-control-a-false-invariant-is-still-refused
  ;; 0.75 doubles to 1.5, so the invariant is false of the initial state. The
  ;; fix teaches the runtime a SORT, not optimism.
  (is (not (holds? "(defserver ^{:invariant (= (* x 2) 1)} wrong
                      (init [x] (ok 0.75))
                      (handle-call [:noop] [_ x] (reply :ok x)))"))))

(deftest the-sort-functor-itself
  (let [n1 (fn [s] (first (BeamLisp.Reader/read_string s)))]
    ;; The functor answers SMT SORT NAMES (strings), with `:unknown` as the
    ;; sentinel for "no readable sort" — which `state-shape` turns into Int.
    (is (= "Int" (smt/sort-of-value (n1 "3"))))
    (is (= "Real" (smt/sort-of-value (n1 "0.5"))))
    (is (= "Real" (smt/sort-of-value (n1 "-0.25"))))
    (is (= "Bool" (smt/sort-of-value (n1 "true"))))
    ;; A bare symbol has no readable value and lands on the integer default —
    ;; that is the common case, and it is why the literal shapes are the ones
    ;; that matter.
    (is (= "Int" (smt/sort-of-value (n1 "x"))))))
