; test/bl/system/sorts_test.bl — what SORT a field is checked under, and who says.
;
; Before this, every init shape except a map of fields became `Int`: a bare
; literal init (`(init [x] (ok 0.5))`) fell through to the invariant's mentioned
; variables, all Int. The same establishment script through the bundled z3:
;
;   (define-fun Inv ((x Real)) Bool (= (* x 2) 1))  (assert (not (Inv 0.5)))  → unsat
;   (define-fun Inv ((x Int))  Bool (= (* x 2) 1))  (assert (not (Inv 0.5)))  → sat
;
; so a correct machine read as broken. These first three tests are the fix and
; its control: the control matters more, because a sort inference that made every
; machine verify would pass the first test and be useless.
;
; The rest pin the two lanes added on top of it:
;   * ^{:sorts …} — a DECLARED sort beats the literal rule and the Int fallback,
;     and a declaration that cannot be honoured (an unknown sort, a sort that
;     contradicts the init literal) THROWS instead of quietly becoming Int;
;   * :k — the induction DEPTH, so a machine that is safe but not 1-inductive can
;     be decided at 2 while `:k 1` stays exactly what it was.

(ns system.sorts-test
  (:require [system.core :as sys]
            [system.smt :as smt]
            [smt :as smtlib]
            [z3]))

(defn- read1 [s] (first (BeamLisp.Reader/read_string s)))

(defn- holds? [src] (:holds (sys/verify-process (z3/open) (read1 src))))

(defn- verify
  ([src] (verify src 1))
  ([src k] (sys/verify-process (z3/open) (read1 src) {:k k :emit true})))

(defn- holds-k? [src k] (:holds (sys/verify-process (z3/open) (read1 src) {:k k})))

(defn- decls-text
  "The (declare-const …) forms the engine emitted for `src` — the SORTS the
   verdict is a statement about, as SMT-LIB text."
  [src]
  (smtlib/script (:decls (:emitted (verify src)))))

(defn- threw?
  "Run `f`, and say whether it THREW. A refusal to check is a value here, not an
   accident: the two negative controls below are the whole reason the declared
   lane is safe to use."
  [f]
  (try (do (f) false) (catch _e true)))

(deftest a-real-valued-state-gets-the-real-theory
  (is (holds? "(defserver ^{:invariant (= (* x 2) 1)} half
                 (init [x] (ok 0.5))
                 (handle-call [:noop] [_ x] (reply :ok x)))")
      "0.5 doubles to 1 — true of a Real, false of every Int"))

(deftest an-integer-state-still-verifies
  (is (holds? "(defserver ^{:invariant (>= n 0)} counter
                 (init [n] (ok 0))
                 (handle-call [:bump] [_ n] (reply :ok (+ n 1))))")))

(deftest the-control-a-false-invariant-is-still-refused
  ;; 0.75 doubles to 1.5, so the invariant is false of the initial state. The
  ;; fix teaches the runtime a SORT, not optimism.
  (is (not (holds? "(defserver ^{:invariant (= (* x 2) 1)} wrong
                      (init [x] (ok 0.75))
                      (handle-call [:noop] [_ x] (reply :ok x)))"))))

(deftest the-sort-functor-itself
  (let [n1 (fn [s] (first (BeamLisp.Reader/read_string s)))]
    ;; The functor answers SMT SORT NAMES (strings), with `:unknown` as the
    ;; sentinel for "no readable sort" — which `state-shape` turns into Int.
    (is (= "Int" (smt/sort-of-value (n1 "3"))))
    (is (= "Real" (smt/sort-of-value (n1 "0.5"))))
    (is (= "Real" (smt/sort-of-value (n1 "-0.25"))))
    (is (= "Bool" (smt/sort-of-value (n1 "true"))))
    ;; A bare symbol has no readable value and lands on the integer default —
    ;; that is the common case, and it is why the literal shapes are the ones
    ;; that matter.
    (is (= "Int" (smt/sort-of-value (n1 "x"))))))

; ── the DECLARED lane (FUP-059) ─────────────────────────────────────────

(def bank-plain
  "(defserver ^{:invariant (>= rate 0.0)} bank
     (init [rate] (ok {:rate rate}))
     (handle-call [:bump amt] [_ {:keys [rate]}] :when (>= amt 0.0)
       (reply :ok {:rate (+ rate amt)})))")

(def bank-declared
  "(defserver ^{:invariant (>= rate 0.0) :sorts {:rate Real}} bank
     (init [rate] (ok {:rate rate}))
     (handle-call [:bump amt] [_ {:keys [rate]}] :when (>= amt 0.0)
       (reply :ok {:rate (+ rate amt)})))")

(deftest a-declared-sort-beats-the-int-fallback
  ;; The init is the caller's PARAMETER, so the literal rule has nothing to read
  ;; and both fields fall back to Int. `:sorts` states the answer — and the
  ;; assertion is on the emitted declarations, not on a guess about them: this is
  ;; the script the verdict was decided over.
  (is (= "(declare-const rate Int)\n(declare-const amt Int)\n"
         (decls-text bank-plain))
      "with nothing declared, an unreadable init still means Int")
  (is (= "(declare-const rate Real)\n(declare-const amt Real)\n"
         (decls-text bank-declared))
      "a declared Real wins, and the amount that flows into it follows")
  (is (:holds (verify bank-declared)) "□(rate ≥ 0) holds over the reals"))

(deftest the-fallback-can-only-be-wrong-by-accepting
  ;; `2·rate = 1` has NO integer solution, so over Int every induction question
  ;; is unsatisfiable for the wrong reason: the machine HOLDS and nothing was
  ;; proved. Over Real the same machine is correctly REFUSED — `:scale` turns
  ;; rate 0.5 into 1.0. This is the honest direction of the fallback's error:
  ;; an Int model is also a Real model, so Int can never REFUSE a true claim,
  ;; but it can accept a false one.
  (let [m "(defserver ^{:invariant (= (* rate 2) 1)} half
             (init [rate] (ok {:rate rate}))
             (handle-call [:scale] [_ {:keys [rate]}] (reply :ok {:rate (* rate 2)})))"
        ann "(defserver ^{:invariant (= (* rate 2) 1) :sorts {:rate Real}} half
                (init [rate] (ok {:rate rate}))
                (handle-call [:scale] [_ {:keys [rate]}] (reply :ok {:rate (* rate 2)})))"
        plain (verify m) real (verify ann)]
    (is (= "(declare-const rate Int)\n" (decls-text m)))
    (is (= "(declare-const rate Real)\n" (decls-text ann)))
    (is (:holds plain) "over Int the question is vacuously unsatisfiable")
    (is (not (:holds real)) "over Real the SAME machine is refused")
    (is (= :scale (:label (first (:failures real))))
        "and the refusal names the transition that breaks it")))

(deftest an-unknown-declared-sort-throws
  ;; The whole point of the lane: never silently degrade to Int. A sort nobody
  ;; implements is a question the engine cannot ask, and it says so by name.
  (is (threw? (fn [] (verify "(defserver ^{:invariant (>= x 0) :sorts {:x Ratz}} m
                                (init [x] (ok 0))
                                (handle-call [:n] [_ x] (reply :ok x)))")))
      "an unsupported sort throws, naming the sort and the variable"))

(deftest a-declared-sort-that-contradicts-the-init-throws
  ;; Declared Int over an init of 0.5 is the annotation and the code disagreeing
  ;; about what the state IS. A silent override would hide that behind a green
  ;; check, so it throws instead.
  (is (threw? (fn [] (verify "(defserver ^{:invariant (>= x 0) :sorts {:x Int}} m
                                (init [x] (ok 0.5))
                                (handle-call [:n] [_ x] (reply :ok x)))")))
      "a Real init literal cannot be declared Int"))

(deftest a-declared-real-over-an-integer-literal-is-not-a-contradiction
  ;; The other half of the rule: `3` IS a fine init for a Real field (z3 coerces
  ;; an integer literal into a Real context), so the widening must NOT throw.
  (let [r (verify "(defserver ^{:invariant (>= x 0) :sorts {:x Real}} m
                     (init [x] (ok 3))
                     (handle-call [:n] [_ x] (reply :ok x)))")]
    (is (= "(declare-const x Real)\n" (decls-text "(defserver ^{:invariant (>= x 0) :sorts {:x Real}} m
                     (init [x] (ok 3))
                     (handle-call [:n] [_ x] (reply :ok x)))")))
    (is (:holds r))))

; ── k-INDUCTION (P20) ───────────────────────────────────────────────────

; Safe, but NOT 1-inductive: `Inv` admits the unreachable island `x = 5`, and
; `:leap` steps off it. Every reachable state (0,1,2,3) satisfies `Inv`.
(def island
  "(defserver ^{:invariant (or (<= x 3) (= x 5))} island
     (init [x] (ok 0))
     (handle-call [:up] [_ x] :when (< x 3) (reply :ok (+ x 1)))
     (handle-call [:stay] [_ x] :when (and (>= x 3) (< x 5)) (reply :ok x))
     (handle-call [:leap] [_ x] :when (>= x 5) (reply :ok (+ x 1))))")

(deftest k1-still-refuses-a-machine-that-is-not-1-inductive
  ;; The negative control for the whole k feature: the default must not have got
  ;; kinder. `:leap` from the island is a real counterexample to 1-induction.
  (let [r (verify island)]
    (is (= 1 (:k r)) ":k is 1 unless asked for more")
    (is (not (:holds r)))
    (is (= :leap (:label (first (:failures r)))))))

(deftest k2-proves-what-k1-refuses
  (let [r (verify island 2)]
    (is (= 2 (:k r)))
    (is (:holds r) "assuming Inv at s0 AND s1 excludes the island")
    (is (empty? (:failures r)) "nothing refused at k=2")
    (is (:complete r))))

(deftest a-1-inductive-machine-holds-at-every-depth
  ;; k-induction is a stronger QUESTION, so a machine that answers the weaker one
  ;; must answer the stronger — otherwise the depth is changing the answer rather
  ;; than the argument.
  (let [c "(defserver ^{:invariant (>= n 0)} counter
             (init [n] (ok 0))
             (handle-call [:bump] [_ n] (reply :ok (+ n 1))))"]
    (is (holds-k? c 1))
    (is (holds-k? c 2))
    (is (holds-k? c 3))))

(deftest the-k-base-is-a-real-check
  ;; The step alone says "if Inv held for the previous k states...". Something has
  ;; to say it holds for the FIRST ones, and this machine is unsafe inside them:
  ;; `:jump` leaves 0 for 7 on the very first step. Without a base, a k>1 run
  ;; could report a proof about a path that never reaches an `Inv` state.
  (let [r (verify "(defserver ^{:invariant (or (<= x 3) (= x 5))} jumper
                      (init [x] (ok 0))
                      (handle-call [:jump] [_ x] (reply :ok 7)))" 2)
        labels (into #{} (map :label (:failures r)))]
    (is (not (:holds r)) "an unsafe first step is not hidden by a deeper question")
    (is (contains? labels :base) "the refusal names the base, not just a step")))
