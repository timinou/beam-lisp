(ns compiler.public-raise-safety-test)

(defn- source-for [kind check]
  (str "(let [saved (atom nil)] "
       "(try (try (erlang/error :original) "
       "(catch original (reset! saved __STACKTRACE__) "
       "(erlang/raise " kind " :replayed __STACKTRACE__))) "
       "(catch value (and (= " kind " __EXCEPTION_KIND__) " check
       " (= @saved __STACKTRACE__)))))"))

(deftest public-frame-list-raises-and-internal-raw-rethrows-survive-in-a-child-vm
  ;; A compiler regression at this boundary can crash ERTS. Keep the parent
  ;; test VM alive so a SIGSEGV is reported as a failed assertion.
  (let [dir (Path/join (System/tmp_dir!) (str "public-raise-" (erlang/unique_integer (list :positive))))
        script (Path/join dir "verify.exs")
        sources (list
          (source-for ":throw" "(= :replayed value)")
          (source-for ":error" "(= :replayed (:original value))")
          (source-for ":exit" "(= :replayed (elem value 1))")
          ;; Unmatched typed catches use the compiler's explicitly raw stack.
          "(try (try (erlang/throw :raw) (catch RuntimeError wrong :missed)) (catch value (and (= :throw __EXCEPTION_KIND__) (= :raw value))))")
        program (str
          "{:ok, _} = Application.ensure_all_started(:beam_lisp)\nBeamLisp.init()\n"
          "BeamLisp.Env.add_search_path(BeamLisp.Tiers.priv_root())\n"
          "BeamLisp.Loader.ensure_loaded(\"self.anf\")\n"
          "sources = " (Kernel/inspect sources) "\n"
          "Enum.each(sources, fn source ->\n"
          "  unless BeamLisp.Compiler.eval_string(source) == true, do: raise(\"compiled raise mismatch\")\n"
          "  node = BeamLisp.Ns.Compiler.compile(BeamLisp.Reader.read_one(source), BeamLisp.Ns.Compiler.new_env(\"user\"))\n"
          "  interp = BeamLisp.Env.fetch_exact!(\"self.anf\", \"interp\")\n"
          "  unless BeamLisp.Ns.Rt.invoke(interp, [node, %{}]) == true, do: raise(\"interpreted raise mismatch\")\n"
          "end)\nIO.puts(\"PUBLIC_RAISE_SAFETY_OK\")\n")]
    (try
      (File/mkdir_p! dir) (File/write! script program)
      (let [args (concat (list "-k" "10" "300" "elixir")
                   (mapcat (fn [path] (list "-pa" (erlang/list_to_binary path))) (code/get_path))
                   (list script))
            result (System/cmd "timeout" (to-list args) (list (tuple :stderr_to_stdout true)
                    (tuple :cd dir)
                    (tuple :env (list
                     (tuple "BL_ROOT" (Path/dirname (Path/dirname (erlang/list_to_binary (code/which :Elixir.BeamLisp)))))
                     (tuple "BEAM_LISP_PATH" nil) (tuple "BL_DAEMON" "off")))))]
        (is (= 0 (elem result 1)) (elem result 0))
        (is (includes? (elem result 0) "PUBLIC_RAISE_SAFETY_OK") (elem result 0)))
      (finally (File/rm_rf! dir)))))
