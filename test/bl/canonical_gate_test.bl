; test/bl/canonical_gate_test.bl — the three live contracts the Mix-era canonical
; gates pinned, kept as ONE focused gate after those scripts were retired.
;
; The retired artifacts, and what each actually proved:
;
;   !tasks/artifacts/canonical-upgrade-gate.exs
;       The canonical-only harness: compile the toolchain with NO legacy host or
;       quoted importer, print a GENERATION_RECEIPT, then run the canonical
;       module-contract suites.
;   !tasks/artifacts/canonical-seed-stage.exs
;       Build a candidate floor from the boot sources in priority order and
;       generate its manifest, then report CANDIDATE_SEED_GENERATION.
;   !tasks/artifacts/candidate-smoke.exs
;       Boot a FRESH candidate (a staged ebin + the committed seed), evaluate,
;       and assert the running toolchain carries NO legacy generation: no
;       `BeamLisp.Ns.Compiler2`, every stored definition a canonical
;       `:defn-clause`, and no legacy Anf/Lower exports.
;
; All three entered through `Mix.start`/`Code.require_file` and the deleted
; `lib/*.ex`; `candidate-smoke.exs` also reached for `Mix.Project.compile_path/0`
; and `canonical-seed-stage.exs` for the deleted `priv/bootstrap/gen_manifest.exs`.
; They cannot run on this tree. Their LIVE contracts survive here, each pinned
; against the RUNNING toolchain instead of a staged Elixir one:
;
;   1. SEED BOOTSTRAP (canonical-seed-stage.exs, candidate-smoke.exs)
;      The committed floor is a COMPLETE, CURRENT candidate. Its DATA manifest
;      (`manifest.term`, read with `file:consult/1` — never evaluated) names the
;      tree's own pinned-host inventory and records a sha256 per beam; every
;      named beam is on disk with the recorded bytes; every boot namespace that
;      emits a stamped shim has its whole shim/body/init set present; and
;      `seed/check` judges the whole floor current against the sources beside it.
;      The install-and-boot half is proven elsewhere and is not re-staged here:
;      `bootstrap_host_stage_test.bl` (verified staging before `elixirc`),
;      `bootstrap_host_freshness_test.bl` (sha-authoritative `install!`/
;      `install_hosts!`) and the launcher itself, which installs this floor on
;      every `bl` start.
;
;   2. CANONICAL COMPILER (canonical-upgrade-gate.exs, candidate-smoke.exs)
;      The live toolchain is exactly ONE generation: `BeamLisp.Ns.Compiler2` is
;      not loadable, every definition interned for `compiler`/`anf`/`lower` is a
;      canonical `:defn-clause`, and no legacy `Anf`/`Lower` export survives
;      (`normalise`, `quote-node`, `norm-pattern`, `eval-core`,
;      `core-defvar-anf`, `defs->module-anf-any`). The companion SOURCE scan —
;      no quoted reverse bridge in `priv/host/emit.bl`, `priv/host/link.bl` or
;      `lib/beam_lisp/aot.ex` — lives in `anf_emit_test.bl`.
;
;   3. TIER RECEIPT (all three: GENERATION_RECEIPT / CANDIDATE_SEED_GENERATION)
;      `vm.generation/receipt` keeps the running SOURCE key, the committed SEED
;      digest and the LOADED code apart, and the digest it reports is the seed
;      manifest this tree ships. The exhaustive per-field contract is
;      `test/bl/vm/generation_test.bl`; this gate asserts the cross-artifact tie
;      the retired gates PRINTED — running code bound to the committed seed.
;
; Run: bl test test/bl/canonical_gate_test.bl

(ns canonical-gate.test
  (:require [seed]
            [vm.generation :as gen]))

(def ^:private SEED-DIR "priv/bootstrap/seed")

(defn- root [] (BeamLisp/cwd))

(defn- seed-path [name] (str (root) "/" SEED-DIR "/" name))

(defn- sha256-hex [bytes]
  (String/downcase
    (Base/encode16 (erlang/apply :crypto :hash (list :sha256 bytes)))))

(defn- term-manifest
  "The seed manifest as DATA, read the way the pre-`elixirc` stage reads it:
   `file:consult/1` over the Erlang term. Never `Code.eval_file` — the manifest
   is data, and the moment it stops being readable as data the stage has nothing
   to read before the runtime exists."
  [path]
  (let [r (erlang/apply :file :consult (list (erlang/binary_to_list path)))]
    (when-not (= :ok (erlang/element 1 r))
      (throw (str "the manifest at " path " is not consultable: " (pr-str r))))
    (erlang/hd (erlang/element 2 r))))

(defn- exports [mod]
  (erlang/apply mod :module_info (list :exports)))

(defn- exported? [es name]
  (some? (some (fn [pair] (= name (erlang/element 1 pair))) es)))

(defn- restore-assertions!
  "Put the test library back into `core`.

   `seed/check` LOADS every boot shim to ask its provenance, and loading `core`
   puts the compiled `BeamLisp.Ns.Core` back from `core.bl` — which does not
   carry `is-report/4` (the runner interns the test library into core's ENV, not
   into that beam). Every `is` after such a call would die `is-report/4 is
   undefined or private`. Re-evaluating the library into core is exactly what the
   runner does at file start, so the assertions keep working."
  []
  (let [priv (erlang/list_to_binary (erlang/apply :code :priv_dir (list :beam_lisp)))]
    (BeamLisp.Env/with_ns "core"
      (fn [] (BeamLisp/eval (File/read! (str priv "/std/test.bl")))))))

(defn- check! [opts]
  (let [verdict (seed/check opts)]
    (restore-assertions!)
    verdict))

; ── 1. seed bootstrap ───────────────────────────────────────────────────────

(deftest the-committed-floor-is-a-complete-current-candidate
  (let [manifest (term-manifest (seed-path "manifest.term"))
        hosts (seed/host-sources (str (root) "/priv/host"))
        boot (str (root) "/priv/boot")]
    ; The DATA manifest names its pinned-host inventory, and that inventory is
    ; the tree's own mapping — the list a consumer selects host beams from
    ; (a prefix rule cannot name a pinned leaf outside `Elixir.BeamLisp.*`).
    (is (= (seed/host-names hosts) (get manifest "hosts"))
        "the floor's `hosts` list is the tree's pinned-host inventory, in table order")

    ; Every beam the manifest records is on disk with the recorded bytes: the
    ; floor's own inventory and its provenance agree.
    (doseq [[name sha] (get manifest "modules")]
      (let [path (seed-path name)]
        (is (File/exists? path) (str name " is in the committed floor"))
        (is (= sha (sha256-hex (File/read! path)))
            (str name " is the manifest's bytes"))))

    ; Every boot namespace that emits a shim publishes it BESIDE its body beam;
    ; `Ns.Init.<X>` rides along only when the namespace has top-level init forms,
    ; so it is not required. The only namespace allowed to publish NO shim is an
    ; action-only source (`data-readers`), which registers data and emits no beam.
    (doseq [ns (seed/namespaces boot)]
      (let [beams (map seed/beam-of (seed/variants ns))
            shim (first beams)
            body (second beams)]
        (if (File/exists? (seed-path shim))
          (is (File/exists? (seed-path body))
              (str body " rides beside " shim))
          (is (= "Data-readers" ns)
              (str "only an action-only source publishes no shim, got " ns)))))

    ; And the whole floor is CURRENT against the sources beside it — the verdict
    ; `bl seed --check` gives, computed here with the same closure hashes. A
    ; floor that moved is not a candidate a fresh boot can install.
    (let [verdict (check! {:root (root)})]
      (is (:ok? verdict)
          (str "the committed floor is current: " (pr-str (take 3 (:moved verdict)))))
      (is (empty? (:moved verdict)) "no namespace or host leaf has moved")
      (is (empty? (:unjudged verdict)) "every stamped shim was judged")
      (is (erlang/> (:namespaces verdict) 0) "the floor names namespaces"))))

; ── 2. canonical compiler ───────────────────────────────────────────────────

(deftest the-live-toolchain-has-one-canonical-generation
  ; The pre-canonical generation is GONE, not merely unused: the namespace that
  ; carried it is not on the code path.
  (is (not (Code/ensure_loaded? :"Elixir.BeamLisp.Ns.Compiler2"))
      "the pre-canonical `Compiler2` namespace is not loadable")

  ; Every stored definition of the three codegen namespaces is canonical. A
  ; legacy `{:def, …}` or mixed-shape clause would store under a different
  ; `:op`; there is exactly one shape left.
  (doseq [ns ["compiler" "anf" "lower"]]
    (BeamLisp.Loader/ensure_loaded ns)
    (let [defs (BeamLisp.Env/ns_defs ns)
          entries (mapcat (fn [name] (get defs name)) (keys defs))
          legacy (vec (filter (fn [e] (not= :"defn-clause" (get (erlang/element 4 e) :op)))
                              entries))]
      (is (erlang/> (count entries) 0) (str ns " has interned definitions"))
      (is (empty? legacy)
          (str ns " stores only canonical :defn-clause definitions; found "
               (pr-str (take 3 legacy))))))

  ; No legacy export survives on the two namespaces candidate-smoke named.
  (let [anf (exports :"Elixir.BeamLisp.Ns.Anf")
        lower (exports :"Elixir.BeamLisp.Ns.Lower")]
    (doseq [name [:"normalise" :"quote-node" :"norm-pattern"]]
      (is (not (exported? anf name))
          (str "Ns.Anf exposes no legacy " name)))
    (doseq [name [:"eval-core" :"core-defvar-anf" :"defs->module-anf-any"]]
      (is (not (exported? lower name))
          (str "Ns.Lower exposes no legacy " name)))))

; ── 3. tier receipt ─────────────────────────────────────────────────────────

(deftest the-generation-receipt-ties-loaded-code-to-the-committed-seed
  (let [r (gen/receipt)
        shipped (seed-path "manifest.term")]
    ; The receipt's SOURCE identity is this tree's codegen key — not a stale
    ; memoized one.
    (is (= (BeamLisp.AOTCache/current_compiler_key) (:codegen_key (:source r)))
        "the receipt reports this source's codegen key")

    ; The receipt's SEED identity is the manifest this tree ships: the retired
    ; gates printed this tie between the running code and the committed floor.
    (is (= (sha256-hex (File/read! shipped)) (:manifest_sha256 (:seed r)))
        "the receipt's seed digest is the committed manifest's sha256")
    (is (= 64 (erlang/byte_size (:manifest_sha256 (:seed r)))))

    ; The LOADED identity fingerprints the live codegen shims by their running
    ; md5 — the code this VM is actually executing, not the file on disk.
    (doseq [mod ["Elixir.BeamLisp.Ns.Compiler"
                 "Elixir.BeamLisp.Ns.Lower"
                 "Elixir.BeamLisp.Ns.Anf"]]
      (let [identity (get (:modules (:loaded r)) mod)]
        (is (some? identity) (str mod " is fingerprinted by the receipt"))
        (is (= 32 (erlang/byte_size (:loaded_md5 identity)))
            (str mod " reports a live module md5 (hex md5, 32 chars)"))))))
