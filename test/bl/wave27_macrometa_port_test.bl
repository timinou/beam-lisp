; test/bl/wave27_macrometa_port_test.bl — two gaps found by loading Specter's
; navigator macro stack, ported from the ExUnit
; `test/beam_lisp/wave27_macrometa_test.exs`.
;
;   1. METADATA A MACRO ATTACHED, rather than metadata someone WROTE.
;      `var_meta_ast/4` compiled each metadata value as a reader FORM — correct
;      when an author writes `^{:arglists '([x])}`, but a macro that builds
;      metadata itself (`(vary-meta name assoc :arglists '([]))`) stores DATUM:
;      by the time the macro runs the quoted form has already been evaluated
;      into data. The fix routes such values through `data_to_form/1`, so the
;      form path and the datum path converge on one mechanism. This gated four
;      Specter slices at once (defnav/defrichnav attach :arglists exactly so).
;   2. `declare` — a file must be able to forward-reference a function defined
;      later, which mutually recursive definitions and navigator libraries need.
;
; WHERE THE ExUnit DRIVER WENT
;   The ExUnit suite ran every case through `BeamLisp.Compiler.eval_string/2`
;   with a fresh `user` env, because a macro must be INTERNED in a namespace
;   before a second string can EXPAND it, and the test process is not the
;   language. That is exactly `eval-in/1` below — the same compiler path the
;   original drove. The `setup` (init + `in_ns "user"`) is folded into the env:
;   `eval_string` enters the env's namespace itself, so nothing else is needed.
;
; ASSERTION MAP (ExUnit test → BL deftest), all 6 originals, none dropped:
;   a macro may attach a quoted list as metadata
;     → a-macro-may-attach-a-quoted-list-as-metadata
;   the attached metadata is readable, not merely survivable
;     → the-attached-metadata-is-readable-not-merely-survivable
;   metadata written in source still works unchanged
;     → metadata-written-in-source-still-works-unchanged
;   a function may reference one defined later in the file
;     → a-function-may-reference-one-defined-later-in-the-file
;   declare takes several names
;     → declare-takes-several-names
;   mutual recursion, which is the reason declare exists
;     → mutual-recursion-which-is-the-reason-declare-exists
;
; Run: bin/bl test test/bl/wave27_macrometa_port_test.bl

(ns wave27.macrometa.test)

(defn- eval-in
  "Read, compile and evaluate `source` in a fresh `user` env — the driver the
   ExUnit `eval/1` used. Returns the last form's value."
  [source]
  (BeamLisp.Compiler/eval_string source (BeamLisp.Compiler/new_env "user")))

(defn- user-meta
  "The metadata map of var `nm` in the `user` namespace — `{:ok, map}`'s second
   element, the map the ExUnit `{:ok, m} = …` destructured."
  [nm]
  (erlang/element 2 (BeamLisp.Env/meta "user" nm)))

; --- metadata attached by a macro -------------------------------------------

(deftest a-macro-may-attach-a-quoted-list-as-metadata
  ; The exact shape `defnav` uses: `(vary-meta name assoc :arglists
  ; (list 'quote (list params)))` — the value is built with `list`, so it
  ; reaches the compiler as DATA, not as a reader form. Before the fix this
  ; raised a FunctionClauseError from deep inside the compiler.
  (eval-in "
  (defmacro w27-defthing [nm params]
    (let [tagged (vary-meta nm assoc :arglists (list 'quote (list params)))]
      `(defn ~tagged [] :made)))
  ")
  (eval-in "(w27-defthing w27-widget [x])")
  (is (= :made (eval-in "(w27-widget)")))
  (is (contains? (user-meta "w27-widget") :arglists)))

(deftest the-attached-metadata-is-readable-not-merely-survivable
  ; Compiling without crashing is not enough — the value has to arrive intact,
  ; or the macro silently lost what it attached.
  (eval-in "
  (defmacro w27-tagged [nm]
    `(defn ~(vary-meta nm assoc :kind :navigator) [] 1))
  ")
  (eval-in "(w27-tagged w27-nav)")
  (is (= :navigator (:kind (user-meta "w27-nav")))))

(deftest metadata-written-in-source-still-works-unchanged
  ; The other half of the same function: a fix that rerouted the datum path but
  ; broke the form path would trade one bug for another.
  (eval-in "(defn ^{:arglists '([x])} w27-src [] 1)")
  (is (= 1 (eval-in "(w27-src)")))
  (eval-in "(defn ^{:doc \"a docstring\"} w27-doc [] 2)")
  (is (= "a docstring" (:doc (user-meta "w27-doc"))))
  ; a bare symbol value stays the symbol datum Clojure stores; it must NOT be
  ; compiled, which would try to resolve it as a var.
  (eval-in "(defn ^{:tag String} w27-tag [] 3)")
  (is (= 3 (eval-in "(w27-tag)"))))

; --- declare -----------------------------------------------------------------

(deftest a-function-may-reference-one-defined-later-in-the-file
  (is (= 42
         (eval-in "
         (do
           (declare w27-later)
           (defn w27-early [] (w27-later))
           (defn w27-later [] 42)
           (w27-early))
         "))))

(deftest declare-takes-several-names
  (is (= 3
         (eval-in "
         (do
           (declare w27-a w27-b)
           (defn w27-uses [] (+ (w27-a) (w27-b)))
           (defn w27-a [] 1)
           (defn w27-b [] 2)
           (w27-uses))
         "))))

(deftest mutual-recursion-which-is-the-reason-declare-exists
  (is (= [true true]
         (eval-in "
         (do
           (declare w27-odd?)
           (defn w27-even? [n] (if (= n 0) true (w27-odd? (- n 1))))
           (defn w27-odd? [n] (if (= n 0) false (w27-even? (- n 1))))
           [(w27-even? 10) (w27-odd? 7)])
         "))))
