(ns diagnostics.token-test (:require [diagnostics :as diag] [env]))

(deftest ordinary-env-token-conveys-registered-diagnostics-to-raw-workers
 (diag/with-options {:sink (fn [_] nil)}
  (diag/with-context {:diagnostics/operation-id "token-worker"}
   (let [parent (erlang/self) token (env/capture)
         _ (erlang/put :unregistered-token-fixture "private fixture")
         child (erlang/spawn (fn []
                              (env/bind token)
                              (erlang/send parent [:token-context (diag/context)
                                                   (erlang/get :unregistered-token-fixture)])))]
    (try
     (receive [:token-context context private]
       (do (is (= "token-worker" (:diagnostics/operation-id context)))
           (is (= :undefined private)))
       (after 5000 (is false "token worker did not reply")))
     (finally (erlang/erase :unregistered-token-fixture)
              (when (Process/alive? child) (Process/exit child :kill))))))))

(deftest binding-clear-or-legacy-tokens-erases-reused-worker-context
 (let [original (env/capture)
       clear (dissoc original :diagnostics)]
  (try
   (diag/with-options {:sink (fn [_] nil)}
    (diag/with-context {:diagnostics/operation-id "old-worker"}
     (let [scoped (env/capture)]
      (is (= "old-worker" (:diagnostics/operation-id (diag/context))))
      (env/bind clear)
      (is (= :undefined (erlang/get :bl_diagnostics)))
      (is (nil? (:diagnostics/operation-id (diag/context))))
      (env/bind scoped)
      (is (= "old-worker" (:diagnostics/operation-id (diag/context))))
      (env/bind (assoc scoped :diagnostics nil))
      (is (= :undefined (erlang/get :bl_diagnostics)))
      (is (nil? (:diagnostics/operation-id (diag/context)))))))
   (finally (env/bind original)))))
