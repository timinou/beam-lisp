(ns aot-ordered-generated-owner-test)
(defn- compile-server [namespace]
 (BeamLisp.Compiler/compile
  (first (BeamLisp.Reader/read_string "(defserver worker (init [x] (tuple :ok x)))"))
  (BeamLisp.Compiler/new_env namespace)))
(defn- prepare [node namespace name]
 (BeamLisp.AOT/prepare_generated_modules node namespace name (list) {}))
(defn- attributes [beam]
 (Keyword/get (elem (elem (beam_lib/chunks (elem beam 1) (list :attributes)) 1) 1) :attributes))
(defn- attr [beam name]
 (BeamLisp.AOT/normalized_attribute (attributes beam) name))
(defn- refusal [node namespace]
 (try (prepare node namespace nil) nil
  (catch error
   ;; Erlang error atoms are normalized by the Source exception boundary. Only
   ;; unwrap this exact native exception class; unrelated failures still fail
   ;; the expected-atom assertion rather than becoming generic refusals.
   (if (and (erlang/is_map error)
            (erlang/== :Elixir.ErlangError (Map/get error :__struct__)))
    (Map/get error :original) error))))

(deftest unnamed-ordered-actor-actions-keep-their-exact-embedded-owner
 (let [namespace "aot.ordered.actor.fixture" compiled (compile-server namespace)
       module (BeamLisp.Server/module_for namespace "worker")
       prepared (prepare compiled namespace nil) beam (Map/get (elem prepared 1) module)]
  (is (some? beam))
  (is (= (tuple namespace "worker") (attr beam :bl_declaration_owner)))
  (is (= :actor (attr beam :bl_aot_artifact_role)))
  (is (= false (erlang/module_loaded module)))
  (is (= :replay_generated_module! (:fun (first (:stmts (elem prepared 0))))))
  (let [alias (prepare compiled namespace "outer-alias")]
   (is (= (tuple namespace "worker") (attr (Map/get (elem alias 1) module) :bl_declaration_owner)))
   (is (= false (Map/has_key? (elem alias 1) (BeamLisp.Server/module_for namespace "outer-alias")))))))

(deftest malformed-executable-actor-scaffolds-refuse-before-emission
 (let [namespace "aot.ordered.malformed.fixture" compiled (compile-server namespace)
       statements (:stmts compiled) create (first statements) intern (second statements)
       result (nth statements 2)
       bad-intern (Map/put intern :args (list (BeamLisp.Emit/lit namespace)
                          (BeamLisp.Emit/lit "other") (nth (:args intern) 2)))]
  (doseq [node [(Map/put compiled :stmts (list create bad-intern result))
                (Map/put compiled :stmts (list create intern (BeamLisp.Emit/lit :wrong-module)))
                (Map/put compiled :stmts (list create result))]]
   (is (= :invalid_generated_server_scaffold (refusal node namespace)))))
 (let [namespace "aot.ordered.bare.fixture" create (first (:stmts (compile-server namespace)))]
  (is (= :unowned_generated_actor_scaffold (refusal create namespace)))))

(deftest quoted-scaffolds-remain-inert-data
 (let [namespace "aot.ordered.quoted.fixture" node (BeamLisp.Emit/lit (compile-server namespace))
       prepared (prepare node namespace nil)]
  (is (= node (elem prepared 0)))
  (is (= {} (elem prepared 1)))))

(deftest unnamed-generated-classes-use-canonical-class-identity
 (let [namespace "aot.ordered.class.fixture"
       descriptor (BeamLisp.Record/declaration_descriptor namespace "Box" :record (list "value"))
       node (BeamLisp.Emit/remote :Elixir.BeamLisp.Record :publish_declaration!
              (list (BeamLisp.Emit/lit descriptor)))
       prepared (prepare node namespace nil) module (:name descriptor)
       beam (Map/get (elem prepared 1) module)]
  (is (= (tuple namespace "Box") (attr beam :bl_declaration_owner)))
  (is (= :generated-class (attr beam :bl_aot_artifact_role)))
  (is (= false (erlang/module_loaded module)))
  (is (= :invalid_generated_class_owner (refusal node "aot.ordered.foreign.fixture")))))
