; host_compile_error_test.bl — the pinned exception ABI for the compiler's
; `BeamLisp.CompileError`.
;
; `priv/host/compile_error.bl` is ONE pinned source that `compile_host_file/2`
; compiles at the exact production atom with the `defexception
; [:message, :file, :line, :form]` shape and the `Exception` behaviour:
;
;     :struct_fields [{:__exception__ true} {:message nil} {:file nil} {:line nil} {:form nil}]
;     :behaviour     :"Elixir.Exception"
;
; The live `lib/beam_lisp/errors.ex` still declares the Hand-written module and
; is the ground truth, so the suite is DIFFERENTIAL: the same corpus runs through
; a probe compiled from the pinned source and through the live module, and the
; two answer sets must be equal — values, exception CLASSES and MESSAGES.
;
; Nothing here replaces the live module. The probe is compiled at its own atom
; with `:load? false`, the namespace shim beside it is dropped, and the pinned
; beam is loaded ALONE — so a leftover shim reference would be `undef` here.
;
; What each block pins:
;   * the synthesized struct surface — `__struct__/0,1`, `__info__(:struct)`
;     (keys, order, defaults), the module-exact self tag, and the `:behaviour`
;     attribute (`:Elixir.Exception`, recorded as the BARE atom — the pinned
;     family's shape, not Elixir's one-element list);
;   * `exception/1` and `message/1` against the live code, clause for clause:
;     the list clause's `Keyword.fetch!`/`Keyword.get` reads (missing `:message`
;     → the live KeyError with `key` and `term`; an undeclared key is ignored),
;     the `file:line` / `line N` prefix, the `printable_limit: 240, limit: 12`
;     form inspect, a bare binary, bad args → FunctionClauseError, `message/1`
;     value / nil / BadMapError / KeyError, `Exception.exception?/1`,
;     `Exception.message/1`, rescue, and `inspect` (the `__exception__` field is
;     filtered by `Inspect.Any`, so the rendering is `%Mod{message: …}`);
;   * the export surface is the live module's, datum for datum — `build_message`
;     was `defp` and the generated `exception/1` was replaced, so the pinned
;     beam exports exactly `exception/1`, `message/1`, `__struct__/0,1`;
;   * the explicit seed option contract (`host-opts`'s exact list);
;   * the cutover — the pinned beam loaded OVER the live atom, exercised, and the
;     live beam restored afterwards;
;   * the cold child — a fresh VM with NO application boot resolves the pinned
;     beam and answers, proving the exception module needs no host-namespace Env.
;
; Run: bin/bl test test/bl/host_compile_error_test.bl

(ns host.compile-error.test)

(defn- t2 [k v] (erlang/list_to_tuple (list k v)))

(defn- tmp-dir []
  (str (System/tmp_dir) "/bl_host_compile_error_" (erlang/unique_integer (list :positive))))

(defn- src [] (Path/join (BeamLisp/cwd) "priv/host/compile_error.bl"))

(def ^:private probe :Elixir.BeamLisp.CompileErrorProbe)
(def ^:private shim :Elixir.BeamLisp.Ns.Host.CompileError)
(def ^:private body-mod :Elixir.BeamLisp.Ns.Body.Host.CompileError)
(def ^:private live :Elixir.BeamLisp.CompileError)

(defn- drop! [mod]
  (do (code/purge mod) (code/delete mod) :ok))

(defn- struct-fields
  "The `:struct_fields` list, in order: the handwritten `defexception
   [:message, :file, :line, :form]` shape."
  []
  (list (t2 :__exception__ true) (t2 :message nil) (t2 :file nil) (t2 :line nil) (t2 :form nil)))

(defn- seed-opts
  "The EXACT option list the seed's `host-opts` builds for the CompileError
   entry: the isolated base (`:module`/`:output_dir`/`:file`/`:source_hash`/
   `:load? false`) followed by `:struct_fields` then `:behaviour`, in that order."
  [mod dir]
  (list (t2 :module mod)
        (t2 :output_dir dir)
        (t2 :file (src))
        (t2 :source_hash (crypto/hash :sha256 (File/read! (src))))
        (t2 :load? false)
        (t2 :struct_fields (struct-fields))
        (t2 :behaviour :"Elixir.Exception")))

(defn- compile-at
  "Compile the pinned source at exact atom `mod`, then publish ONLY the pinned
   beam: the compile's own load (and the namespace shim/body it built beside it)
   is dropped first."
  [mod dir]
  (let [res (BeamLisp.AOT/compile_host_file (src) (seed-opts mod dir))
        path (elem res 1)]
    (drop! mod)
    (code/load_binary mod (erlang/binary_to_list path) (File/read! path))
    (drop! shim)
    (drop! body-mod)
    mod))

(defn- compile-pinned-file
  "Compile the source at `mod` and return the beam PATH, never loading it."
  [mod dir]
  (elem (BeamLisp.AOT/compile_host_file (src) (seed-opts mod dir)) 1))

; ── normalization: the probe names ITS own atom, by design ────────────────

(defn- norm [m]
  (if (erlang/is_binary m)
    (String/replace m "BeamLisp.CompileErrorProbe" "BeamLisp.CompileError")
    m))

; ── the observation: a call's whole answer, a raise included ──────────────

(defn- ex-data-of [e]
  (if (and (erlang/is_map e) (erlang/is_map_key :data e)) (erlang/map_get :data e) nil))

(defn- value-shape
  "A struct value drops its own tag (`Map.from_struct`), so a probe-built struct
   and a live-built one compare equal despite different `__struct__` atoms."
  [v]
  (if (and (erlang/is_map v) (erlang/is_map_key :__struct__ v))
    (list :struct (Map/from_struct v))
    (list :value v)))

(defn- obs
  "`[:ok shape]` or `[:raise class message data]`, message normalized by the
   caller so the probe's own atom compares equal to the live module's."
  [normf thunk]
  (try (let [v (thunk)]
         (list :ok (value-shape (if (erlang/is_binary v) (normf v) v))))
       (catch e (list :raise (:__struct__ e) (normf (ex-message e)) (ex-data-of e)))))

; ── the differential corpus ──────────────────────────────────────────────

(defn- corpus
  "Every observation the CompileError ABI owes, as a LIST so probe and live
   compare index for index. `mod` supplies the exception entry points; `normf`
   maps the probe's own name out of a message."
  [mod normf]
  (let [E (fn [arg] (fn [] (erlang/apply mod :exception (list arg))))
        M (fn [arg] (fn [] (erlang/apply mod :message (list arg))))]
    (list
      ; ── exception/1: keyword lists, the Keyword.fetch! KeyError ───────
      (obs normf (E (list)))
      (obs normf (E (list (t2 :message nil))))
      (obs normf (E (list (t2 :message "hi"))))
      (obs normf (E (list (t2 :message "a") (t2 :message "b"))))
      (obs normf (E (list (t2 :message :synthetic))))
      (obs normf (E (list (t2 :message 5))))
      (obs normf (E (list (t2 :file "f"))))
      (obs normf (E (list (t2 :other 1))))
      (obs normf (E (list (t2 :message "a") (t2 :other 1))))
      ; ── exception/1: the location prefix ──────────────────────────────
      (obs normf (E (list (t2 :message "m") (t2 :file "a.ex"))))
      (obs normf (E (list (t2 :message "m") (t2 :line 3))))
      (obs normf (E (list (t2 :message "m") (t2 :file "a.ex") (t2 :line 3))))
      (obs normf (E (list (t2 :message "m") (t2 :file nil) (t2 :line 3))))
      (obs normf (E (list (t2 :message "m") (t2 :file "a.ex") (t2 :line nil))))
      (obs normf (E (list (t2 :message "m") (t2 :line 0))))
      (obs normf (E (list (t2 :message "m") (t2 :file ""))))
      (obs normf (E (list (t2 :message "m") (t2 :file :atom))))
      (obs normf (E (list (t2 :message "m") (t2 :file 7))))
      (obs normf (E (list (t2 :message "m") (t2 :line "7"))))
      (obs normf (E (list (t2 :message "m") (t2 :file :atom) (t2 :line 3))))
      ; ── exception/1: the offending-form suffix ────────────────────────
      (obs normf (E (list (t2 :message "m") (t2 :form (tuple :a 1)))))
      (obs normf (E (list (t2 :message "m") (t2 :form (Enum/to_list (range 1 101))))))
      (obs normf (E (list (t2 :message "m") (t2 :form (String/duplicate "x" 400)))))
      (obs normf (E (list (t2 :message "m") (t2 :form nil))))
      (obs normf (E (list (t2 :message "m") (t2 :form false))))
      (obs normf (E (list (t2 :message "m") (t2 :file "a.ex") (t2 :line 3) (t2 :form (tuple :a (list 1 2 3))))))
      ; ── exception/1: __struct__ is an ordinary ignored key here ───────
      (obs normf (E (list (t2 :__struct__ :other))))
      (obs normf (E (list (t2 :__struct__ mod))))
      (obs normf (E (list (t2 :__struct__ mod) (t2 :message "m"))))
      (obs normf (E (list (t2 :message "m") (t2 :__struct__ :other))))
      ; ── exception/1: a bare binary message ────────────────────────────
      (obs normf (E "bin"))
      (obs normf (E ""))
      ; ── exception/1: bad args are FunctionClauseError ─────────────────
      (obs normf (E :nope))
      (obs normf (E nil))
      (obs normf (E 42))
      (obs normf (E (maps/new)))
      ; ── message/1: value, nil, and the live field-access refusals ─────
      (obs normf (M (maps/put :message "m" (maps/new))))
      (obs normf (M (maps/put :message nil (maps/new))))
      (obs normf (M (maps/put :message "" (maps/new))))
      (obs normf (M (maps/new)))
      (obs normf (M 1))
      (obs normf (M nil))
      (obs normf (M "str"))
      (obs normf (M (erlang/apply mod :exception (list "m"))))
      ; ── the Exception protocol surface ────────────────────────────────
      (obs normf (fn [] (Elixir.Exception/exception? (erlang/apply mod :exception (list "x")))))
      (obs normf (fn [] (Elixir.Exception/exception? (erlang/apply mod :exception (list (list (t2 :message "y")))))))
      (obs normf (fn [] (Elixir.Exception/exception? :not-an-exception)))
      (obs normf (fn [] (Elixir.Exception/message (erlang/apply mod :exception (list "x")))))
      (obs normf (fn [] (Elixir.Exception/message (M (maps/put :message nil (maps/new))))))
      ; ── inspect: `__exception__` filtered, message shown ──────────────
      (obs normf (fn [] (Kernel/inspect (erlang/apply mod :exception (list "hi")))))
      (obs normf (fn [] (Kernel/inspect (erlang/apply mod :exception (list (list (t2 :message nil)))))))
      (obs normf (fn [] (Kernel/inspect (erlang/apply mod :exception (list (list (t2 :message "m") (t2 :file "a.ex") (t2 :line 3)))))))
      ; ── rescue: raise the struct, catch it by its own type ────────────
      (obs normf (fn [] (try (do (erlang/error (erlang/apply mod :exception (list "boom")))
                                 :no-raise)
                            (catch e (list :rescued (= mod (:__struct__ e)) (normf (ex-message e)))))))
      ; ── the struct's own map, tag aside ──────────────────────────────
      (obs normf (fn [] (Map/from_struct (erlang/apply mod :exception (list "hi")))))
      (obs normf (fn [] (Map/from_struct (erlang/apply mod :exception (list (list (t2 :message "hi") (t2 :file "a.ex") (t2 :line 3) (t2 :form (tuple :a 1)))))))))))

; ── the pinned ABI, observation for observation ──────────────────────────

(defn- differential [probe-mod live-mod normf]
  (is (= (corpus live-mod normf) (corpus probe-mod normf))
      "probe answers equal the live module's on the whole corpus")
  (let [ls (corpus live-mod normf)
        ps (corpus probe-mod normf)]
    (doseq [i (range (count ls))]
      (is (= (nth ls i) (nth ps i)) (str "observation " i)))))

(deftest compile-error-pinned-matches-the-live-module
  (testing "the exception answers exactly as the live module does"
    (let [dir (tmp-dir)]
      (compile-at probe dir)
      ; NO SHIM: the compile's namespace modules are gone; the pinned beam answers.
      (is (= :non_existing (erlang/apply :code :which (list shim))))
      (differential probe live norm)
      (File/rm_rf! dir))))

; ── the struct surface: keys, order, tag, behaviour, export set ──────────

(defn- struct-info [mod]
  (erlang/apply mod :__info__ (list :struct)))

(defn- functions [mod]
  (erlang/apply mod :__info__ (list :functions)))

(defn- attributes [mod]
  (erlang/apply mod :module_info (list :attributes)))

(defn- has-behaviour? [mod modname]
  (some (fn [pair] (and (= :behaviour (elem pair 0)) (= modname (elem pair 1))))
        (attributes mod)))

(deftest compile-error-pinned-struct-surface
  (testing ":struct_fields + :behaviour synthesize the defexception surface"
    (let [dir (tmp-dir)]
      (compile-at probe dir)
      (is (erlang/function_exported probe :__struct__ 0))
      (is (erlang/function_exported probe :__struct__ 1))
      (is (erlang/function_exported probe :__info__ 1))
      (is (erlang/function_exported probe :exception 1))
      (is (erlang/function_exported probe :message 1))
      ; __struct__/0 — the tag is MODULE-EXACT, defaults are the declared pair.
      (let [s0 (erlang/apply probe :__struct__ (list))]
        (is (erlang/is_map s0))
        (is (= 6 (erlang/map_size s0)))
        (is (= probe (erlang/map_get :__struct__ s0)))
        (is (= true (erlang/map_get :__exception__ s0)))
        (is (nil? (erlang/map_get :message s0)))
        (is (nil? (erlang/map_get :file s0)))
        (is (nil? (erlang/map_get :line s0)))
        (is (nil? (erlang/map_get :form s0))))
      ; __struct__/1 folds the given values over the defaults.
      (let [s1 (erlang/apply probe :__struct__ (list (list (t2 :message "hi") (t2 :line 4))))]
        (is (= probe (erlang/map_get :__struct__ s1)))
        (is (= true (erlang/map_get :__exception__ s1)))
        (is (= "hi" (erlang/map_get :message s1)))
        (is (= 4 (erlang/map_get :line s1)))
        (is (nil? (erlang/map_get :file s1)))
        (is (nil? (erlang/map_get :form s1))))
      ; __info__(:struct) is the live module's, datum for datum: keys, order
      ; and defaults — what `Inspect.Any` reads to rebuild `%Mod{…}`.
      (is (= (struct-info live) (struct-info probe)))
      (is (= (list (maps/put :field :__exception__ (maps/put :required false (maps/put :default true (maps/new))))
                   (maps/put :field :message (maps/put :required false (maps/put :default nil (maps/new))))
                   (maps/put :field :file (maps/put :required false (maps/put :default nil (maps/new))))
                   (maps/put :field :line (maps/put :required false (maps/put :default nil (maps/new))))
                   (maps/put :field :form (maps/put :required false (maps/put :default nil (maps/new)))))
             (struct-info probe)))
      ; The export surface is the LIVE module's, datum for datum: the pinned
      ; source defines only the two callbacks; `build_message/4` was `defp` and
      ; the generated `exception/1` was replaced, so no helper is exported.
      (is (= (sort (functions live)) (sort (functions probe))))
      (is (= (list (t2 :__struct__ 0) (t2 :__struct__ 1) (t2 :exception 1) (t2 :message 1))
             (sort (functions probe))))
      ; -behaviour Exception, as the pinned emitter records it (BARE atom; the
      ; live Elixir beam records the one-element list — a family-wide shape).
      (is (has-behaviour? probe :"Elixir.Exception"))
      ; the pinned __info__/1 does NOT serve :attributes — the family shape.
      (is (= :Elixir.FunctionClauseError
             (:__struct__ (try (erlang/apply probe :__info__ (list :attributes)) nil (catch e e)))))
      ; the exception/1 return is a GENUINE struct of its own type.
      (let [s (erlang/apply probe :exception (list "hi"))]
        (is (Elixir.Exception/exception? s))
        (is (= probe (:__struct__ s))))
      (let [k (erlang/apply probe :exception (list (list (t2 :message "m") (t2 :file "a.ex") (t2 :line 3))))]
        (is (Elixir.Exception/exception? k))
        (is (= probe (:__struct__ k)))
        (is (= "a.ex:3: m" (erlang/map_get :message k))))
      (File/rm_rf! dir))))

; ── the explicit seed option contract ────────────────────────────────────

(deftest compile-error-pinned-seed-option-contract
  (testing "the seed's host-opts shape, exactly"
    (let [dir (tmp-dir)]
      (let [opts (seed-opts probe dir)]
        (is (= probe (Keyword/fetch! opts :module)))
        (is (= (src) (Keyword/fetch! opts :file)))
        (is (= false (Keyword/fetch! opts :load?)))
        (is (erlang/is_binary (Keyword/fetch! opts :source_hash)))
        (is (= (struct-fields) (Keyword/fetch! opts :struct_fields)))
        (is (= :"Elixir.Exception" (Keyword/fetch! opts :behaviour)))
        ; the struct-fields list is the defexception shape, in order.
        (is (= (list (t2 :__exception__ true) (t2 :message nil) (t2 :file nil) (t2 :line nil) (t2 :form nil))
               (Keyword/fetch! opts :struct_fields))))
      (File/rm_rf! dir))))

; ── the pinned beam AT the production atom, saved and restored ───────────

(deftest compile-error-pinned-beam-stands-in-at-the-production-atom
  (testing "the production atom serves and renders on the pinned beam, then the live beam returns"
    (let [dir (tmp-dir)]
      (let [out (str dir "/prod")
            beam (Path/join out (str live ".beam"))
            orig-path (erlang/apply :code :which (list live))
            orig-bin (File/read! (erlang/list_to_binary orig-path))
            before (corpus live (fn [m] m))]
        (is (not= :non_existing orig-path) "precondition: the live beam is a readable file")
        (compile-pinned-file live out)
        (is (File/exists? beam))
        (try
          (drop! live)
          (code/load_binary live (erlang/binary_to_list beam) (File/read! beam))
          (drop! shim)
          (drop! body-mod)
          (is (erlang/function_exported live :__info__ 1)
              "the struct surface rides along: __info__/1 is served")
          ; the pinned beam answers EXACTLY as the live one did at this atom,
          ; observation for observation (the module name already IS the live one).
          (is (= before (corpus live (fn [m] m))))
          (is (= live (:__struct__ (erlang/apply live :exception (list "x")))))
          (is (= "hi" (erlang/apply live :message (list (erlang/apply live :exception (list (list (t2 :message "hi"))))))))
          (is (= "%BeamLisp.CompileError{message: \"x\", file: nil, line: nil, form: nil}"
                 (Kernel/inspect (erlang/apply live :exception (list "x")))))
          (is (= "a.ex:3: boom"
                 (erlang/map_get :message (erlang/apply live :exception (list (list (t2 :message "boom") (t2 :file "a.ex") (t2 :line 3)))))))
          (finally
            (drop! live)
            (code/load_binary live orig-path orig-bin)))
        ; RESTORED: the live beam owns the atom and answers again.
        (is (= orig-path (erlang/apply :code :which (list live))))
        (is (= before (corpus live (fn [m] m))) "the restored live beam answers as before"))
      (File/rm_rf! dir))))

; ── the COLD CHILD: a fresh VM, no application boot, no host-ns Env ──────

(defn- child-code-args
  "This VM's whole code path as `-pa` args, with `pinned` LAST so it lands FIRST:
   `-pa` PREPENDS, so the last one named wins."
  [pinned]
  (concat (mapcat (fn [p] (list "-pa" (erlang/list_to_binary p))) (code/get_path))
          (list "-pa" pinned)))

(defn- cold-script
  "The child VM's program. It NEVER starts the application: it resolves the
   pinned exception beam off the path and exercises it, so a host-namespace Env
   dependency would be a load-time `undef` here."
  []
  (str
    "IO.puts(\"which=\" <> List.to_string(:code.which(BeamLisp.CompileError)))\n"
    "e = BeamLisp.CompileError.exception(\"cold\")\n"
    "IO.puts(\"msg=\" <> inspect(BeamLisp.CompileError.message(e)))\n"
    "IO.puts(\"inspect=\" <> inspect(e))\n"
    "IO.puts(\"exc=\" <> inspect(Exception.exception?(e)))\n"
    "k = BeamLisp.CompileError.exception([message: \"k\", file: \"a.ex\", line: 3])\n"
    "IO.puts(\"kw-msg=\" <> inspect(Map.get(k, :message)))\n"
    "IO.puts(\"kw-inspect=\" <> inspect(k))\n"
    "f = BeamLisp.CompileError.exception([message: \"f\", form: {:a, 1}])\n"
    "IO.puts(\"form-msg=\" <> inspect(Map.get(f, :message)))\n"
    "IO.puts(\"map=\" <> inspect(Enum.sort(Map.to_list(Map.from_struct(k)))))\n"
    "rescued =\n"
    "  try do\n"
    "    raise BeamLisp.CompileError, \"boom\"\n"
    "  rescue\n"
    "    e in BeamLisp.CompileError -> Exception.message(e)\n"
    "  end\n"
    "IO.puts(\"rescued=\" <> inspect(rescued))\n"
    "rescued2 =\n"
    "  try do\n"
    "    raise BeamLisp.CompileError, message: \"boom2\", line: 7\n"
    "  rescue\n"
    "    e in BeamLisp.CompileError -> Exception.message(e)\n"
    "  end\n"
    "IO.puts(\"rescued2=\" <> inspect(rescued2))\n"
    "IO.puts(\"ok\")\n"))

(deftest compile-error-pinned-beam-answers-in-a-cold-child-vm
  (testing "a fresh VM with no application boot resolves and exercises the pinned exception"
    (let [dir (tmp-dir)
          out (str dir "/cold")
          script (Path/join dir "cold.exs")
          beam (compile-pinned-file live out)]
      (is (File/exists? beam))
      (File/write! script (cold-script))
      (let [r (System/cmd "elixir"
                          (to-list (concat (child-code-args out) (list script)))
                          (to-list [(tuple :stderr_to_stdout true)
                                    (tuple :env (list (tuple "ERL_CRASH_DUMP" "/dev/null")))]))
            text (elem r 0)]
        (is (zero? (elem r 1)) (str "the child VM exited " (elem r 1) ":\n" text))
        ; THE REPLACEMENT: the code server resolves the atom to the pinned beam,
        ; in a VM that never booted the language.
        (is (includes? text (str "which=" beam)) text)
        ; exception/1 (binary + keyword), message/1, inspect, Exception.exception?.
        (is (includes? text "msg=\"cold\"") text)
        (is (includes? text "inspect=%BeamLisp.CompileError{message: \"cold\", file: nil, line: nil, form: nil}") text)
        (is (includes? text "exc=true") text)
        (is (includes? text "kw-msg=\"a.ex:3: k\"") text)
        (is (includes? text "form-msg=\"f\\n  offending form: {:a, 1}\"") text)
        (is (includes? text "map=[__exception__: true, file: \"a.ex\", form: nil, line: 3, message: \"a.ex:3: k\"]") text)
        ; raise + rescue through its own type.
        (is (includes? text "rescued=\"boom\"") text)
        (is (includes? text "rescued2=\"line 7: boom2\"") text)
        (is (includes? text "ok") text))
      (File/rm_rf! dir))))
