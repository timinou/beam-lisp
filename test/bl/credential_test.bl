(ns credential.test
  (:require [credential :as cred]))

;; ── the two halves ───────────────────────────────────────────────────

(def GRANT
  {:service :google :account-id "112362662281204820657" :label "a@b.c"
   :client-id "cid" :access "OLD" :refresh "RT" :scopes #{"openid"}
   :expires-at 1000000})

(def CLIENT {:client-id "cid" :client-secret "sec"})

(defn- post-returning [status body] (fn [_url _b] {:status status :body body}))

;; ── expiry ───────────────────────────────────────────────────────────

(deftest a-token-near-expiry-is-already-gone
  ; The skew is the point: a token with 400ms left is expired for anything
  ; that takes longer than 400ms, and the failure it produces is a 401 inside
  ; a batch rather than a refresh before it.
  (is (cred/expired? {:expires-at 1000000} 950000 60000) "50s out, 60s skew → gone")
  (is (not (cred/expired? {:expires-at 1000000} 800000 60000)) "3min out → live")
  (is (cred/expired? {:expires-at 1000000} 1000000 0) "at expiry → gone"))

(deftest an-absent-expiry-is-live
  ; An absent expiry is the provider saying `this does not expire`. Refreshing
  ; on it would be one request per call, for nothing.
  (is (not (cred/expired? {:access "x"} 99999999999 60000))))

(deftest bearer-is-a-bearer
  (is (= "Bearer OLD" (cred/bearer GRANT))))

;; ── refresh ──────────────────────────────────────────────────────────

(deftest a-refresh-keeps-the-refresh-token-we-already-had
  ; Google omits `refresh_token` on every refresh. Dropping ours because the
  ; response did not repeat it turns a renewable grant into a one-hour grant,
  ; and the failure surfaces an hour later, far from here.
  (let [r (cred/refresh! GRANT CLIENT
            (post-returning 200 "{\"access_token\":\"NEW\",\"expires_in\":3600,\"token_type\":\"Bearer\"}"))]
    (is (cred/good? r))
    (is (= "NEW" (get (cred/ok r) :access)))
    (is (= "RT" (get (cred/ok r) :refresh)) "carried forward, not dropped")
    (is (= "112362662281204820657" (get (cred/ok r) :account-id))
        "a refresh does not re-identify anyone")
    (is (pos? (get (cred/ok r) :expires-at)))))

(deftest a-refresh-response-that-narrows-scopes-is-believed
  ; A narrowed scope set is a real answer. Keeping the old one would claim
  ; authority the provider just withdrew.
  (let [r (cred/refresh! GRANT CLIENT
            (post-returning 200 "{\"access_token\":\"NEW\",\"expires_in\":60,\"scope\":\"openid email\"}"))]
    (is (= #{"openid" "email"} (get (cred/ok r) :scopes)))))

(deftest an-absent-scope-is-not-a-narrowing
  (let [r (cred/refresh! GRANT CLIENT
            (post-returning 200 "{\"access_token\":\"NEW\",\"expires_in\":60}"))]
    (is (= #{"openid"} (get (cred/ok r) :scopes)) "ours survives")))

(deftest a-grant-with-no-refresh-token-needs-reauth
  ; And says so rather than posting a request that cannot succeed.
  (let [r (cred/refresh! (dissoc GRANT :refresh) CLIENT
            (post-returning 200 "{}"))]
    (is (= :no-refresh-token (get r :error)))
    (is (= :reauth (get r :disposition))
        ":reauth, never :retry — retrying this burns quota forever")))

(deftest a-refused-refresh-carries-its-disposition
  (let [r (cred/refresh! GRANT CLIENT
            (post-returning 400 "{\"error\":\"invalid_grant\",\"error_description\":\"revoked\"}"))]
    (is (= :refresh-failed (get r :error)))
    (is (= :reauth (get r :disposition)))))

;; ── fresh! ───────────────────────────────────────────────────────────

(deftest fresh-does-not-post-when-the-token-is-live
  (let [called (atom false)
        post (fn [_u _b] (reset! called true) {:status 200 :body "{}"})
        r (cred/fresh! (assoc GRANT :expires-at (+ (erlang/system_time :millisecond) 3600000))
                       CLIENT post)]
    (is (= "OLD" (get (cred/ok r) :access)))
    (is (not (deref called)) "a live token costs no request")))

(deftest fresh-renews-when-the-token-is-gone
  (let [r (cred/fresh! (assoc GRANT :expires-at 1) CLIENT
            (post-returning 200 "{\"access_token\":\"NEW\",\"expires_in\":3600}"))]
    (is (= "NEW" (get (cred/ok r) :access)))
    (is (= "RT" (get (cred/ok r) :refresh)))))
