(ns code.lease-test (:require [anf :as a] [lower :as lower]))
(defn descriptor [module value]
 (a/module module (list {:op :defn-clause :fname :run :params (list) :guard nil
                         :body (a/lit value) :ann {}}) (list [:run 0]) (list)))
(deftest retained-callback-prevents-retirement-and-third-generation
 (let [module :bl_owned_lease_fixture]
  (lower/reload-descriptor! (descriptor module 1))
  (try
   (BeamLisp.Env/with_code_lease (list module)
    (fn []
     (is (not (BeamLisp.Env/retire_module! module)))
     (is (= 1 (erlang/apply module :run (list))))
     (lower/reload-descriptor! (descriptor module 2))
     (is (try (lower/reload-descriptor! (descriptor module 3)) false (catch _ true)))
     (is (= 2 (erlang/apply module :run (list))))))
   (is (BeamLisp.Env/retire_module! module))
   (finally (BeamLisp.Env/retire_module! module)))))
(deftest dead-lease-owner-cannot-prevent-retirement
 (let [module :bl_dead_lease_fixture parent (erlang/self)]
  (lower/reload-descriptor! (descriptor module 9))
  (let [owner (erlang/spawn
                (fn [] (BeamLisp.Env/with_code_lease (list module)
                          (fn [] (erlang/send parent :leased) (receive :never :done)))))]
   (try
    (is (= :leased (receive :leased :leased (after 10000 :timeout))))
    (is (not (BeamLisp.Env/retire_module! module)))
    (erlang/exit owner :kill)
    (Process/sleep 10)
    (is (BeamLisp.Env/retire_module! module))
    (finally (when (Process/alive? owner) (erlang/exit owner :kill))
             (BeamLisp.Env/retire_module! module))))))
(deftest failed-compilation-keeps-installed-generation
 (let [module :bl_failed_reload_fixture]
  (lower/reload-descriptor! (descriptor module 7))
  (try
   (is (try (lower/reload-descriptor! :invalid) false (catch _ true)))
   (is (= 7 (erlang/apply module :run (list))))
   (finally (BeamLisp.Env/retire_module! module)))))

(deftest loader-callbacks-acquire-physical-code-leases-automatically
 (let [module :bl_loader_callback_lease
       body (a/remote :Elixir.BeamLisp.Env :retire_module! [(a/lit module)])
       descriptor (a/module module
                     (list {:op :defn-clause :fname :run :params (list) :guard nil :body body :ann {}})
                     (list [:run 0]) (list))]
  (lower/reload-descriptor! descriptor)
  (try
   (is (= false (BeamLisp.Loader.Server/run (erlang/make_fun module :run 0))))
   (is (not= false (code/is_loaded module)) "callback cannot delete itself while admitted")
   (is (BeamLisp.Env/retire_module! module))
   (finally (BeamLisp.Env/retire_module! module)))))
