; test/bl/gen/llm_test.bl — reading a chat-completions body.
; Run: bl test test/bl/gen/llm_test.bl
;
; Offline: `content-of` is the whole contract between a provider's JSON and
; every caller (harness.model, gen.code, the djinn-bl arena). The live call is
; one httpc request around it.

(ns gen.llm-test
  (:require [gen.llm :as llm]))

(defn- body [choice usage]
  (erlang/iolist_to_binary
   (json/encode {"choices" (list choice) "usage" usage})))

(deftest a-reply-is-its-content
  (is (= {:ok "pong"}
         (llm/content-of (body {"message" {"content" "pong"} "finish_reason" "stop"} {})))))

(deftest a-reply-cut-off-before-any-content-is-an-error-not-an-empty-answer
  ;; deepseek-flash: max_tokens spent on reasoning, nothing said
  (let [r (llm/content-of (body {"message" {"content" "" "reasoning_content" "…"} "finish_reason" "length"}
                                {"completion_tokens" 2000}))]
    (is (contains? r :error))
    (is (= {"completion_tokens" 2000} (:truncated (:error r))))))

(deftest a-long-reply-cut-off-mid-sentence-keeps-what-it-said
  ;; the caller still gets the text; a harness cell cut mid-way is repaired by harness.doc
  (is (= {:ok "Let me check"}
         (llm/content-of (body {"message" {"content" "Let me check"} "finish_reason" "length"} {})))))

(deftest a-null-content-is-empty-text
  ;; a tool-call turn: "content": null on the wire (:null is how OTP's json writes it)
  (is (= {:ok ""}
         (llm/content-of (body {"message" {"content" :null} "finish_reason" "stop"} {})))))

(deftest no-choices-is-an-error
  (is (contains? (llm/content-of (erlang/iolist_to_binary (json/encode {"choices" (list)}))) :error)))
