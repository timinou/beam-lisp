; test/bl/bus_test.bl — the bus as a CLAUSE of the one server form.
; Run: bin/bl -p priv/std test --shared test/bl/bus_test.bl
;
; The bus was a macro that copied a whole `defserver`; a clause contributes its
; slice instead. Two things this file pins:
;
;   · the declaration COMPOSES — a bus that also carries the author's state, or
;     shares a server with a registry, is one form with one `init`; and a
;     subscriber's death is still noticed when a registry watches :DOWN too;
;   · an impossible declaration is refused when the form is EXPANDED.

(ns bus.test
  (:require [proc :as proc]
            [proc.bus :as bus]
            [proc.flow :as flow]
            [proc.reg :as reg]))

;; ── the clause ──────────────────────────────────────────────────────────

(deftest the-bus-is-a-clause-of-the-one-server-form
  (is (some (fn [c] (= "bus" c)) (proc/registered-clauses))
      "`bus` is a clause of the one server form, not a form of its own"))

(deftest the-transform-returns-a-state-slice-and-the-down-handler
  (let [c (proc.bus/bus-clause '(bus (demand 4)) {:name 'x})]
    (is (some? (:init c)) "a bus CONTRIBUTES state")
    (is (= 7 (count (:clauses c)))
        "publish call/cast, subscribe, flow-options, demand twice, terminate")
    (is (= 1 (count (:down c))) "and one :down handler, merged by the expander")))

(deftest the-demand-clause-is-optional-and-refused-when-impossible
  (is (some? (proc.bus/bus-clause '(bus) {:name 'x})) "no demand clause is the default")
  (is (thrown? (proc.bus/bus-clause '(bus (demand)) {:name 'x})))
  (is (thrown? (proc.bus/bus-clause '(bus 8) {:name 'x})))
  (is (thrown? (proc.bus/bus-clause '(bus (demand 1) (demand 2)) {:name 'x}))))

(deftest the-start-argument-overrides-the-declared-demand
  (is (= 8 (:demand (proc.bus/init-state nil 8))))
  (is (= 3 (:demand (proc.bus/init-state {:demand 3} 8))) "the start argument wins")
  (is (= 1024 (:max-lag (proc.bus/init-state nil 8))))
  (is (= 64 (:max-lag (proc.bus/init-state {:max-lag 64} 8)))))

;; ── a live bus, and the clause composing with a registry ────────────────

(proc/defserver events
  (init [_] (ok {:own :bus-owner}))
  (registry (keys :id))
  (bus (demand 1))
  (handle-call [:own] [_from st] (reply (:own st) st))
  (handle-call [:subs] [_from st] (reply (count (:subs st)) st)))

(defn- recv [ms]
  (receive
    [:got ev] ev
    (after ms :timeout)))

(deftest an-event-reaches-a-subscriber
  (let [parent (erlang/self)
        b (start events nil {})
        sub (proc.flow/subscribe b :fast
              (fn [ev] (erlang/send parent [:got ev]))
              {:demand 1 :on-lag :block :max-lag 8})]
    (is (= :ok (proc.bus/publish b 1)))
    (is (= 1 (recv 2000)) "the subscriber saw the event it had demand for")
    (is (= :bus-owner (call b [:own])) "the bus slice and the author's slice are ONE state")
    (is (= :ok (proc.reg/register b (erlang/self) {:id 9})))
    (is (= (erlang/self) (proc.reg/whereis b {:id 9})) "…and a registry in the same server works")
    (stop b)
    (Process/sleep 30)))

(deftest a-dead-subscriber-is-dropped-even-with-a-registry-watching-down
  ; THE REGRESSION. `handle_info` clauses match in order and the FIRST match
  ; wins, so two clauses that each catch every `:DOWN` cannot both run: with a
  ; registry in this server the bus's handler would be unreachable, and this
  ; subscriber would sit in the subscriber set forever. The expander merges the
  ; handlers into ONE clause (see proc.server's `:down` contract) — that is what
  ; makes this pass, and it is why the two clauses compose at all.
  (let [b (start events nil {})
        sub (proc.flow/subscribe b :s (fn [_] nil) {:demand 1 :on-lag :block :max-lag 4})]
    (Process/sleep 50)
    (is (= 1 (call b [:subs])) "one subscriber")
    (kill sub)
    (Process/sleep 100)
    (is (= 0 (call b [:subs])) "its subscription went with it")
    (stop b)))
