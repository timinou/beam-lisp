; test/bl/loader_host_test.bl — the pinned `BeamLisp.Loader`.
;
; `priv/host/loader.bl` ports `lib/beam_lisp/loader.ex` to ONE exact-named beam,
; `Elixir.BeamLisp.Loader` — the namespace resolver `BeamLisp.Compiler`'s
; `enable_bl_backend/0` calls as boot interns the compiler, and `bin/bl`'s cold
; path calls before any of the language exists. That is why the port has to be
; RIGHT before it is ever wired into the seed. This suite pins it three ways:
;
;   * SURFACE — the pinned probe's export set covers every public function of
;     the live module, and the pinned beam answers with the SHIM GONE: the
;     compile's namespace shim is dropped, so a leftover self-reference would be
;     `undef` here.
;
;   * DIFFERENTIAL — the same source compiled at a PROBE atom and asked the same
;     questions as the live module, value for value, over the PURE half of the
;     loader: `declared_ns/1` (the ns-head scanner), `source_relatives/1`,
;     `doc_extensions/0`, `doc_source/2`, `read_source/1`, and — against a
;     temporary search dir — `find_file/1`'s answer as `source_hash/1`,
;     `source_content/1`, `source_path/1` and `resolvable?/1` see it, including
;     the `{:wrong_ns, …}` refusal. `load_attribution/4,5` is compared as a
;     VALUE over a source whose form faults, so the whole message — file, form
;     index/total/position/text, and the formatted failure — has to agree.
;
;   * THE COLD CHILD — a fresh VM whose code path resolves `BeamLisp.Loader` to
;     the pinned beam, with NO application boot and NO Env var table, answers
;     the pure half. That is the pre-boot contract: the scanner is bytes and
;     stdlib, so it runs before `Ns.Rt` interned a var.
;
; `ensure_loaded/1`, `do_load/3` and `do_load_miss/2` ARE exercised, against a
; temporary root bound through `with_ambient_dirs/2`: a fresh namespace really
; loads through the LIVE `Loader.Server` (and its var answers), a same-named file
; that declares another ns is refused with the identical message, and a source
; that faults re-raises the original error with the namespace left unmarked.
; What is NOT exercised, deliberately, is the stand-in-at-the-production-atom
; swap (purging the live `BeamLisp.Loader` module while the suite is running on
; it) — that is the wave-that-deletes-`loader.ex`'s to pin, on a cold tree.
;
; Run: bin/bl test test/bl/loader_host_test.bl

(ns host.loader.test)

(defn- t2 [k v] (erlang/list_to_tuple (list k v)))

(defn- tmp-dir []
  (str (System/tmp_dir!) "/bl_host_loader_" (erlang/unique_integer (list :positive))))

(defn- src [] (Path/join (BeamLisp/cwd) "priv/host/loader.bl"))

(def ^:private probe :Elixir.BeamLisp.HostLoaderProbe)
(def ^:private shim :Elixir.BeamLisp.Ns.Host.Loader)
(def ^:private live :Elixir.BeamLisp.Loader)

(defn- drop! [mod]
  (do (code/purge mod) (code/delete mod) :ok))

; Compile the pinned source at `mod` and publish ONLY the pinned beam: the
; compile's own namespace shim is dropped, so every cross-call in the probe must
; have been re-pointed at the pinned atom.
(defn- compile-pinned [mod dir]
  (let [res (BeamLisp.AOT/compile_host_file (src)
              (list (t2 :module mod) (t2 :output_dir dir) (t2 :load? false)))
        path (elem res 1)]
    (drop! mod)
    (code/load_binary mod (erlang/binary_to_list path) (File/read! path))
    (drop! shim)
    mod))

(defn- exports [mod]
  (Enum/sort (erlang/apply mod :module_info (list :exports))))

; `__info__/1` is generated by the Elixir compiler and is NOT part of the ABI a
; pinned (functions-only) port carries.
(defn- functional-exports [mod]
  (Enum/sort (filter (fn [e] (not (erlang/== :__info__ (elem e 0)))) (exports mod))))

(defn- exported? [mod f a]
  (erlang/function_exported mod f a))

(defn- pcall
  "Call `f`/`args` on a module, answering the value or the caught value — the
   BL fold: an `:error` is the normalized exception struct, a `:throw` its raw
   value."
  [mod f args]
  (try (erlang/apply mod f args) (catch e e)))

(defn- stack-of
  "The frame list a raise produces — the `__STACKTRACE__` a catch handler sees."
  [f]
  (try (f) (catch _e __STACKTRACE__)))

; ── the surface: every public export is reproduced, with the shim gone ──────

(deftest loader-pinned-surface-is-the-live-module
  (testing "the pinned export set covers the live module's public functions"
    (let [dir (tmp-dir)]
      (compile-pinned probe dir)
      ; NO SHIM: the compile's namespace shim is gone; the pinned beam answers.
      (is (= :non_existing (erlang/apply :code :which (list shim))))

      ; The production module is loaded — the precondition the diff is
      ; meaningful under.
      (is (erlang/function_exported live :ensure_loaded 1))

      ; Every production export remains present at the probe atom.
      (is (= () (filter (fn [e] (not (exported? probe (elem e 0) (elem e 1))))
                        (functional-exports live)))
          "all production exports are reproduced")

      ; THE PUBLIC ABI, named one by one, so a dropped clause cannot hide in a
      ; set-difference that still matched.
      (doseq [ea (list (list :with_load_path 2) (list :source_hash 1)
                       (list :source_content 1) (list :with_search_dir 2)
                       (list :source_hash_in 2) (list :with_ambient_dirs 2)
                       (list :resolvable? 1) (list :ensure_loaded 1)
                       (list :load_attribution 4) (list :load_attribution 5)
                       (list :source_relatives 1) (list :source_path 1)
                       (list :read_source 1) (list :doc_extensions 0)
                       (list :doc_source 2) (list :declared_ns 1))]
        (is (exported? probe (first ea) (second ea))
            (str "probe exports " (first ea) "/" (second ea))))

      ; The private helpers the pinned emitter exports are present too — the
      ; scanner is the one part of this module that cannot be reached through a
      ; public function alone on every input.
      (doseq [ea (list (list :find_file 1) (list :declares? 2) (list :doc_content 2)
                       (list :strip_shebang 1) (list :collect_doc_cells 3)
                       (list :take_until 2) (list :take_until 3)
                       (list :skip_leading 1) (list :skip_metadata 1)
                       (list :take_token 1) (list :split_token 2)
                       (list :search_dirs 0) (list :ambient_dirs 0)
                       (list :extra_dirs 0) (list :env_paths 0))]
        (is (exported? probe (first ea) (second ea))
            (str "probe exports helper " (first ea) "/" (second ea))))

      ; The pinned beam carries no synthesized struct surface.
      (is (not (exported? probe :__struct__ 0)))
      (is (not (exported? probe :__struct__ 1)))

      ; REPRODUCIBLE: the same source compiled again is the same bytes.
      (let [again (tmp-dir)
            again-beam (elem (BeamLisp.AOT/compile_host_file (src)
                             (list (t2 :module probe) (t2 :output_dir again)
                                   (t2 :load? false)))
                           1)]
        (is (= (File/read! (Path/join dir "Elixir.BeamLisp.HostLoaderProbe.beam"))
               (File/read! again-beam))
            "a rebuild of priv/host/loader.bl is the same beam")
        (File/rm_rf! again))

      (File/rm_rf! dir))))

; ── declared_ns: the ns-head scanner, byte for byte ─────────────────────────

(defn- ns-corpus []
  (list
    "(ns foo.bar)\n"
    "(ns   spaced.name  )\n"
    "; leading comment\n(ns after.comment)\n"
    "\n\t (ns  tabbed.d)\n"
    "(ns host.ex-info)\n(ns second.one)\n"
    "  (ns a-b.c_d)\n"
    "(ns ^{:instr {…}} codebase x)\n"
    "(ns\n  multi.line)\n"
    "(defn foo [] 1)\n"
    ";; only a comment\n"
    ""
    "(:not-a-list)\n"
    "(ns) \n"
    "(NS upper)\n"
    "#!/usr/bin/env bl\n(ns shebanged.script)\n"))

(deftest loader-pinned-declared-ns-matches-the-live-scanner
  (testing "declared_ns/1 answers the live module's, string for string"
    (let [dir (tmp-dir)]
      (compile-pinned probe dir)
      (let [live-answers (Enum/map (ns-corpus)
                           (fn [c] (BeamLisp.Loader/declared_ns c)))
            probe-answers (Enum/map (ns-corpus)
                            (fn [c] (erlang/apply probe :declared_ns (list c))))]
        (is (= live-answers probe-answers) "the whole corpus, index for index"))
      ; A few named answers, so a corpus-wide false-vs-false agreement on a
      ; broken scanner cannot pass.
      (is (= "foo.bar" (erlang/apply probe :declared_ns (list "(ns foo.bar)\n"))))
      (is (= "codebase" (erlang/apply probe :declared_ns (list "(ns ^{:instr {…}} codebase x)\n"))))
      (is (= "after.comment" (erlang/apply probe :declared_ns (list "; c\n(ns after.comment)\n"))))
      (is (= "multi.line" (erlang/apply probe :declared_ns (list "(ns\n  multi.line)\n"))))
      (is (nil? (erlang/apply probe :declared_ns (list "(defn foo [] 1)\n"))))
      (is (nil? (erlang/apply probe :declared_ns (list ";; only a comment\n"))))
      (is (nil? (erlang/apply probe :declared_ns (list ""))))
      ; Non-binary input: the live scanner answers nil (its `skip_leading`
      ; fall-through clause matches any value), so the port must too.
      (is (nil? (erlang/apply probe :declared_ns (list 42))))
      (is (= (BeamLisp.Loader/declared_ns 42)
             (erlang/apply probe :declared_ns (list 42))))
      (File/rm_rf! dir))))

; ── source_relatives / doc_extensions ───────────────────────────────────────

(deftest loader-pinned-source-relatives-and-extensions
  (testing "the ns→file spellings and the extension list are the live module's"
    (let [dir (tmp-dir)]
      (compile-pinned probe dir)
      (is (= (BeamLisp.Loader/doc_extensions) (erlang/apply probe :doc_extensions (list))))
      (doseq [ns (list "core" "a.b.c" "a-b.c" "a.b-c.d" "a-b.c-d" "spell.machine"
                       "kontor.tax.corporate-income-tax" "x")]
        (is (= (BeamLisp.Loader/source_relatives ns)
               (erlang/apply probe :source_relatives (list ns)))
            (str "source_relatives " (pr-str ns))))
      ; The munged spelling is present for a dashed segment and absent otherwise.
      (is (= (list "a-b/c.bl" "a-b/c.bl.md" "a-b/c.bl.org" "a-b/c.clj" "a-b/c.cljc"
                   "a_b/c.bl" "a_b/c.bl.md" "a_b/c.bl.org" "a_b/c.clj" "a_b/c.cljc")
             (erlang/apply probe :source_relatives (list "a-b.c"))))
      (is (= (list "a/b.bl" "a/b.bl.md" "a/b.bl.org" "a/b.clj" "a/b.cljc")
             (erlang/apply probe :source_relatives (list "a.b"))))
      (File/rm_rf! dir))))

; ── doc_source: literate cell extraction ────────────────────────────────────

(defn- md-fixture []
  (str "title\n"
       "```beam-lisp\n"
       "(+ 1 2)\n"
       "```\n"
       "prose\n"
       "```beam-lisp id=c1\n"
       "(+ 3 4)\n"
       "(+ 5 6)\n"
       "```\n"
       "```clojure\n"
       "(ignored)\n"
       "```\n"))

(defn- org-fixture []
  (str "#+title: x\n"
       "#+begin_src beam-lisp\n"
       "(inc 1)\n"
       "#+end_src\n"
       "text\n"
       "#+begin_src clojure\n"
       "(nope)\n"
       "#+end_src\n"))

(deftest loader-pinned-doc-source-matches-the-live-extractor
  (testing "doc_source/2 concatenates the same cells, in the same order"
    (let [dir (tmp-dir)]
      (compile-pinned probe dir)
      (doseq [fix (list (md-fixture) (org-fixture) "" "plain\nlines\n" "```beam-lisp\n```\n")]
        (is (= (BeamLisp.Loader/doc_source fix :md)
               (erlang/apply probe :doc_source (list fix :md)))
            "md fixture")
        (is (= (BeamLisp.Loader/doc_source fix :org)
               (erlang/apply probe :doc_source (list fix :org)))
            "org fixture"))
      (is (= "(+ 1 2)\n(+ 3 4)\n(+ 5 6)"
             (erlang/apply probe :doc_source (list (md-fixture) :md))))
      (is (= "(inc 1)"
             (erlang/apply probe :doc_source (list (org-fixture) :org))))
      ; A non-`:md`/`:org` format is the live guard's FunctionClauseError.
      (is (= (maps/get :__struct__ (pcall live :doc_source (list "x" :other)) nil)
             (maps/get :__struct__ (pcall probe :doc_source (list "x" :other)) nil)))
      (File/rm_rf! dir))))

; ── read_source: plain / literate / shebang ─────────────────────────────────

(deftest loader-pinned-read-source-matches-the-live-reader
  (testing "read_source/1 answers the same bytes for every extension"
    (let [dir (tmp-dir)]
      (compile-pinned probe dir)
      (let [plain (Path/join dir "plain.bl")
            shebanged (Path/join dir "shebanged.bl")
            md (Path/join dir "lit.bl.md")
            org (Path/join dir "lit.bl.org")
            clj (Path/join dir "clj.clj")]
        (File/write! plain "#!/usr/bin/env bl\n(defn hi [] :ok)\n")
        (File/write! shebanged "#!/usr/bin/env bl\n(defn hi [] :ok)\n")
        (File/write! md (md-fixture))
        (File/write! org (org-fixture))
        (File/write! clj "(ns x.clj)\n")
        (doseq [p (list plain shebanged md org clj)]
          (is (= (BeamLisp.Loader/read_source p)
                 (erlang/apply probe :read_source (list p)))
              (str "read_source " (Path/basename p))))
        ; The shebang is replaced by an EMPTY line, so line 2 keeps its number.
        (is (= "\n(defn hi [] :ok)\n"
               (erlang/apply probe :read_source (list plain))))
        (File/rm_rf! dir)))))

; ── find_file as the public surface sees it, on a temp search dir ───────────

(defn- write-source! [dir ns]
  (let [rel (String/replace ns "." "/")
        path (Path/join dir (erlang/iolist_to_binary (list rel ".bl")))]
    (File/mkdir_p! (Path/dirname path))
    (File/write! path (erlang/iolist_to_binary (list "(ns " ns ")\n(defn hi [] :ok)\n")))
    path))

(deftest loader-pinned-search-dir-resolution
  (testing "with_search_dir/2 drives find_file/1 identically on both modules"
    (let [dir (tmp-dir)
          ns "host.loader.probe.fixture"
          content "(ns host.loader.probe.fixture)\n(defn hi [] :ok)\n"
          path (write-source! dir ns)
          wrong-ns "host.loader.probe.wrong"
          wrong-rel "host/loader/probe/wrong.bl"
          wrong-path (Path/join dir wrong-rel)]
      (compile-pinned probe dir)
      (File/mkdir_p! (Path/dirname wrong-path))
      (File/write! wrong-path "(ns some.other.ns)\n(defn hi [] :ok)\n")

      (let [lit (fn [f] (BeamLisp.Loader/with_search_dir dir f))
            pit (fn [f] (erlang/apply probe :with_search_dir (list dir f)))
            lh (lit (fn [] (BeamLisp.Loader/source_hash ns)))
            ph (pit (fn [] (erlang/apply probe :source_hash (list ns))))]
        (is (erlang/is_binary lh))
        (is (= lh ph) "source_hash agrees")
        (is (= lh (erlang/apply probe :source_hash_in (list dir ns)))
            "source_hash_in is source_hash under the pinned dir")
        (is (= content (lit (fn [] (BeamLisp.Loader/source_content ns)))))
        (is (= content (pit (fn [] (erlang/apply probe :source_content (list ns))))))
        (is (= path (lit (fn [] (BeamLisp.Loader/source_path ns)))))
        (is (= path (pit (fn [] (erlang/apply probe :source_path (list ns))))))
        (is (erlang/== true (lit (fn [] (BeamLisp.Loader/resolvable? ns)))))
        (is (erlang/== true (pit (fn [] (erlang/apply probe :resolvable? (list ns)))))))

      ; A same-named file declaring ANOTHER ns is not a source: nil hash/content,
      ; not resolvable — the live refusal, on both.
      (let [lit (fn [f] (BeamLisp.Loader/with_search_dir dir f))
            pit (fn [f] (erlang/apply probe :with_search_dir (list dir f)))]
        (is (nil? (lit (fn [] (BeamLisp.Loader/source_hash wrong-ns)))))
        (is (nil? (pit (fn [] (erlang/apply probe :source_hash (list wrong-ns))))))
        (is (nil? (lit (fn [] (BeamLisp.Loader/source_content wrong-ns)))))
        (is (nil? (pit (fn [] (erlang/apply probe :source_content (list wrong-ns))))))
        (is (erlang/== false (lit (fn [] (BeamLisp.Loader/resolvable? wrong-ns)))))
        (is (erlang/== false (pit (fn [] (erlang/apply probe :resolvable? (list wrong-ns)))))))

      ; Nothing findable: nil on both.
      (is (nil? (BeamLisp.Loader/with_search_dir dir (fn [] (BeamLisp.Loader/source_hash "no.such.ns.x")))))
      (is (nil? (erlang/apply probe :with_search_dir
                  (list dir (fn [] (erlang/apply probe :source_hash (list "no.such.ns.x")))))))

      ; `core` is always resolvable, and a bound ambient dir is restored after.
      (is (erlang/== true (erlang/apply probe :resolvable? (list "core"))))
      (is (nil? (Process/get :bl_search_dirs)) "with_search_dir restored the prior binding")
      (File/rm_rf! dir))))

; ── with_load_path / with_ambient_dirs: the stack discipline ────────────────

(deftest loader-pinned-path-binding-restores
  (testing "with_load_path/2 and with_ambient_dirs/2 push, run, and restore"
    (let [dir (tmp-dir)]
      (compile-pinned probe dir)
      (let [before (BeamLisp.Env/load_paths)]
        (is (= :ok (erlang/apply probe :with_load_path (list "/tmp/bl_probe_dir" (fn [] :ok)))))
        (is (= before (BeamLisp.Env/load_paths)) "the load path is restored"))
      (let [dirs (list "/tmp/bl_probe_ambient")
            seen (erlang/apply probe :with_ambient_dirs
                   (list dirs (fn [] (Process/get :bl_ambient_dirs))))]
        (is (= dirs seen) "the thunk sees the bound ambient dirs")
        (is (nil? (Process/get :bl_ambient_dirs)) "the prior binding is restored"))
      ; A raised thunk still restores (the `finally`).
      (is (erlang/is_map (pcall probe :with_load_path
                           (list "/tmp/bl_probe_dir"
                                 (fn [] (erlang/error (RuntimeError/exception "boom")))))))
      (is (nil? (Process/get :bl_search_dirs)))
      (File/rm_rf! dir))))

; ── ensure_loaded: the miss report and a real load ───────────────────────

(deftest loader-pinned-ensure-loaded-misses
  (testing "ensure_loaded/1 refuses a namespace that exists nowhere, as the live module does"
    (let [dir (tmp-dir)]
      (compile-pinned probe dir)
      ; `core` is always loaded, so the guard short-circuits on both.
      (is (erlang/== :ok (erlang/apply probe :ensure_loaded (list "core"))))
      (let [l (pcall live :ensure_loaded (list "bl.host.loader.nope.xyz"))
            p (pcall probe :ensure_loaded (list "bl.host.loader.nope.xyz"))]
        (is (erlang/is_map l) "precondition: the live loader refused the miss")
        (is (= (maps/get :__struct__ l nil) (maps/get :__struct__ p nil)))
        (is (= (erlang/apply :Elixir.Exception :message (list l))
               (erlang/apply :Elixir.Exception :message (list p)))
            "the same not-found message, search path included"))
      (File/rm_rf! dir))))

; ── ensure_loaded: a REAL load through the live server, with the shim gone ──

(deftest loader-pinned-ensure-loaded-loads-a-fresh-namespace
  (testing "the pinned loader evaluates a source namespace and interns its var"
    (let [dir (tmp-dir)
          ns "bl.host.loader.fixture"
          path (Path/join dir "bl/host/loader/fixture.bl")]
      (File/mkdir_p! (Path/dirname path))
      (File/write! path "(ns bl.host.loader.fixture)\n(defn hi [] :from-pinned)\n")
      (compile-pinned probe dir)
      (is (erlang/== false (BeamLisp.Env/loaded_ns? ns)) "precondition: not loaded")
      ; The pinned `with_ambient_dirs` binds the root the load resolves against;
      ; `ensure_loaded` captures it, hops into `Loader.Server`, and the sibling
      ; `ensure_loaded_locked`/`ensure_loaded_source`/`do_load` run there — all of
      ; them re-pointed at the pinned atom, since the shim is gone.
      (is (erlang/== :ok (erlang/apply probe :with_ambient_dirs
                            (list (list dir)
                                  (fn [] (erlang/apply probe :ensure_loaded (list ns)))))))
      (is (erlang/== true (BeamLisp.Env/loaded_ns? ns)))
      (is (= :from-pinned
             (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! ns "hi") (list)))
          "the loaded var answers")
      (File/rm_rf! dir))))

; ── do_load_miss: the same-named-file refusal, and a FAULTING load ──────────

(deftest loader-pinned-wrong-ns-refusal-matches
  (testing "a same-named file declaring another ns is refused identically"
    (let [dir (tmp-dir)
          ns "bl.host.loader.wrong"
          path (Path/join dir "bl/host/loader/wrong.bl")]
      (File/mkdir_p! (Path/dirname path))
      (File/write! path "(ns some.other.ns)\n(defn hi [] :ok)\n")
      (compile-pinned probe dir)
      ; The file is never evaluated — the declared ns does not match — so
      ; running both modules changes no state.
      (let [l (erlang/apply live :with_ambient_dirs
                (list (list dir) (fn [] (pcall live :ensure_loaded (list ns)))))
            p (erlang/apply probe :with_ambient_dirs
                (list (list dir) (fn [] (pcall probe :ensure_loaded (list ns)))))]
        (is (erlang/is_map l) "precondition: the live loader refused the file")
        (is (= (maps/get :__struct__ l nil) (maps/get :__struct__ p nil)))
        (is (= (erlang/apply :Elixir.Exception :message (list l))
               (erlang/apply :Elixir.Exception :message (list p)))
            "the same wrong-ns message, path and search list included")
        (is (String/contains? (erlang/apply :Elixir.Exception :message (list p))
                              (str "declares (ns some.other.ns), not " ns))))
      (File/rm_rf! dir))))

(deftest loader-pinned-do-load-reports-and-reraises
  (testing "a source that faults re-raises through the pinned loader, unmarked"
    (let [dir (tmp-dir)
          ns "bl.host.loader.broken.source"
          path (Path/join dir "bl/host/loader/broken/source.bl")]
      (File/mkdir_p! (Path/dirname path))
      (File/write! path "(ns bl.host.loader.broken.source)\n(erlang/error (RuntimeError/exception \"kaboom\"))\n")
      (compile-pinned probe dir)
      (let [e (erlang/apply probe :with_ambient_dirs
                       (list (list dir)
                             (fn [] (pcall probe :ensure_loaded (list ns)))))]
        (is (erlang/is_map e) "a raise crossed back, not a value")
        (is (erlang/== :"Elixir.RuntimeError" (maps/get :__struct__ e nil)))
        (is (= "kaboom" (maps/get :message e nil)))
        ; A crashed load is retried by the next require: the ns is not marked.
        (is (erlang/== false (BeamLisp.Env/loaded_ns? ns))))
      (File/rm_rf! dir))))

; ── load_attribution: the whole message, as a value ─────────────────────────

(defn- attr-content []
  "(ns host.loader.attr.demo)\n(defn ok [] 1)\n(erlang/error (RuntimeError/exception \"kaboom\"))\n")

(deftest loader-pinned-load-attribution-matches
  (testing "load_attribution/4 and /5 answer the live module's message"
    (let [dir (tmp-dir)
          ns "host.loader.attr.demo"
          path "/tmp/bl_attr_demo.bl"
          content (attr-content)
          e (Elixir.RuntimeError/exception "kaboom")]
      (compile-pinned probe dir)
      (is (= (BeamLisp.Loader/load_attribution ns path content e)
             (erlang/apply probe :load_attribution (list ns path content e)))
          "the 4-arity attribution agrees")
      ; With an explicit stacktrace the failure is `Exception.format/3`.
      (let [st (stack-of (fn [] (erlang/apply :erlang :error (list e))))]
        (is (= (BeamLisp.Loader/load_attribution ns path content e st)
               (erlang/apply probe :load_attribution (list ns path content e st)))
            "the 5-arity attribution agrees"))
      ; The named pieces are actually there (a both-empty agreement cannot pass).
      (let [msg (erlang/apply probe :load_attribution (list ns path content e))]
        (is (String/contains? msg (str "LOAD FAILED — " path)))
        (is (String/contains? msg (str "(namespace " ns ")")))
        (is (String/contains? msg "form 3 of 3"))
        (is (String/contains? msg "(RuntimeError) kaboom")))
      ; An unreadable source degrades to the "could not be isolated" line, on
      ; both modules.
      (is (= (BeamLisp.Loader/load_attribution ns path "(((" e)
             (erlang/apply probe :load_attribution (list ns path "(((" e))))
      (File/rm_rf! dir))))

; ── the COLD CHILD: no application boot, no Env var table ───────────────────

(defn- child-code-args
  "This VM's whole code path as `-pa` args, with `pinned` LAST so it lands
   FIRST: `-pa` PREPENDS, so the last one named wins."
  [pinned]
  (concat (mapcat (fn [p] (list "-pa" (erlang/list_to_binary p))) (code/get_path))
          (list "-pa" pinned)))

(defn- cold-script
  "The child VM's program. It NEVER starts the application: it resolves the
   pinned loader off the path and asks the pure half — the ns-head scanner, the
   ns→file spellings, the extension list and the literate extractor."
  []
  (str
    "IO.puts(\"which=\" <> List.to_string(:code.which(BeamLisp.Loader)))\n"
    "IO.puts(\"app=\" <> inspect(Enum.any?(Application.started_applications(), fn {a,_,_} -> a == :beam_lisp end)))\n"
    "IO.puts(\"vars=\" <> inspect(:ets.info(:beam_lisp_vars)))\n"
    "IO.puts(\"declared=\" <> inspect(BeamLisp.Loader.declared_ns(\"; c\\n  (ns cold.demo)\\n\")))\n"
    "IO.puts(\"meta=\" <> inspect(BeamLisp.Loader.declared_ns(\"(ns ^{:instr {}} codebase x)\")))\n"
    "IO.puts(\"none=\" <> inspect(BeamLisp.Loader.declared_ns(\"(defn foo [] 1)\")))\n"
    "IO.puts(\"relatives=\" <> inspect(BeamLisp.Loader.source_relatives(\"a-b.c\")))\n"
    "IO.puts(\"exts=\" <> inspect(BeamLisp.Loader.doc_extensions()))\n"
    "IO.puts(\"docsrc=\" <> inspect(BeamLisp.Loader.doc_source(\"t\\n```beam-lisp\\n(+ 1 2)\\n```\\n\", :md)))\n"
    "IO.puts(\"ok\")\n"))

(deftest loader-pinned-beam-answers-in-a-cold-child-vm
  (testing "a fresh VM with no application boot resolves and exercises the pinned loader"
    (let [dir (tmp-dir)
          out (str dir "/cold")
          script (Path/join dir "cold.exs")
          beam (Path/join out "Elixir.BeamLisp.Loader.beam")]
      ; The pinned beam AT the production atom, written here, never loaded here:
      ; loading it would purge the module the whole suite is running on.
      (BeamLisp.AOT/compile_host_file (src)
        (list (t2 :module live) (t2 :output_dir out) (t2 :load? false)))
      (is (File/exists? beam))
      (File/write! script (cold-script))

      (let [r (System/cmd "elixir"
                          (to-list (concat (child-code-args out) (list script)))
                          (to-list [(tuple :stderr_to_stdout true)
                                    (tuple :env (list (tuple "ERL_CRASH_DUMP" "/dev/null")))]))
            text (elem r 0)]
        (is (zero? (elem r 1)) (str "the child VM exited " (elem r 1) ":\n" text))
        ; THE REPLACEMENT: the code server resolves the atom to the pinned beam,
        ; in a VM that never booted the language.
        (is (includes? text (str "which=" beam)) text)
        ; NO APPLICATION, NO VAR TABLE: the pre-boot state the port must serve.
        (is (includes? text "app=false") text)
        (is (includes? text "vars=:undefined") text)
        ; THE PURE HALF ANSWERS.
        (is (includes? text "declared=\"cold.demo\"") text)
        (is (includes? text "meta=\"codebase\"") text)
        (is (includes? text "none=nil") text)
        (is (includes? text "relatives=[\"a-b/c.bl\", \"a-b/c.bl.md\", \"a-b/c.bl.org\", \"a-b/c.clj\", \"a-b/c.cljc\", \"a_b/c.bl\", \"a_b/c.bl.md\", \"a_b/c.bl.org\", \"a_b/c.clj\", \"a_b/c.cljc\"]") text)
        (is (includes? text "exts=[\".bl\", \".bl.md\", \".bl.org\", \".clj\", \".cljc\"]") text)
        (is (includes? text "docsrc=\"(+ 1 2)\"") text)
        (is (includes? text "ok") text))
      (File/rm_rf! dir))))
