; test/bl/bl_search_test.bl — `bl search`, the CLI command.
; Run: mix bl test test/bl/bl_search_test.bl
;
; ── What must hold ────────────────────────────────────────────────────
;
; 1. The command is REGISTERED in all three places a command lives: the
;    dispatcher map, the help map, and the usage list. Registering two of
;    three is a command that runs and cannot be discovered, or is documented
;    and cannot be run — so the test asks all three.
; 2. `-k` takes a COUNT: a number is accepted, a missing value and a
;    non-number are usage errors (exit 2) rather than crashes (exit 1). The
;    difference matters because exit 1 means "the program broke" and exit 2
;    means "the command line was wrong", and a user acts differently.
; 3. A query with no text and no `--like` is a usage error, not an empty
;    result — silently answering nothing is how a typo becomes a mystery.
; 4. With a corpus on disk the command runs end to end and exits 0.
;
; The model is OPTIONAL here the same way it is everywhere else: without
; `mix bl.embed.fetch` the search test asserts the OTHER branch — the
; command says which file is missing and exits 2 — so the suite is meaningful
; on a checkout that has never downloaded the weights.

(ns bl.search.test
  (:require [bl.cli] [bl.search] [code.embed]))

(def DIR "/tmp/bl-search-test")

(def FIXTURES
  [["persist-index.bl"
    "(ns fix.persist)\n\n(defn persist-index\n  \"Write an embedding index to disk so the next run reloads it.\"\n  [index path]\n  (File/write! path index))\n"]
   ["read-lines.bl"
    "(ns fix.lines)\n\n(defn read-lines\n  \"Read a file as a sequence of lines, one string per line.\"\n  [path]\n  (re/split (File/read! path) \"\\n\"))\n"]])

(defn- write-fixtures! []
  (File/mkdir_p DIR)
  (doseq [f FIXTURES]
    (File/write! (str DIR "/" (get f 0)) (get f 1))))

(deftest the-command-is-registered-where-a-command-lives
  (is (contains? bl.cli/commands "search") "the dispatcher must know it")
  (is (some? (get bl.cli/command-help "search")) "help must know it")
  (is (pos? (count (filterv (fn [c] (= c "search")) (mapcat second bl.cli/usage-groups))))
      "`bl` alone prints the usage, and the verb has to appear in it"))

(deftest the-k-flag-takes-a-count-and-refuses-anything-else
  (is (= 5 (:k (bl.cli/parse-argv ["search" "q" "-k" "5"]))))
  (is (= "missing value for -k" (:error (bl.cli/parse-argv ["search" "q" "-k"])))
      "a flag with no value is a usage error")
  (is (includes? (:error (bl.cli/parse-argv ["search" "q" "-k" "abc"])) "-k needs a number")
      "a non-number is a usage error, and the message names the flag")
  (is (includes? (:error (bl.cli/parse-argv ["search" "q" "-k" ""])) "-k needs a number")
      "an empty value is a usage error too — it parses as no number at all"))

(deftest a-search-with-nothing-to-search-for-is-a-usage-error
  (is (= 2 (bl.cli/run-argv ["search"])) "no query, no --like: exit 2"))

(deftest an-absent-model-is-reported-as-absent-and-not-as-a-crash
  ; The optional contract, exercised on a machine that HAS the model: point the
  ; cache at nothing and the command must say what is missing and exit 2 — the
  ; same thing a checkout without the weights sees. Without this, that branch is
  ; only tested on machines that lack the model, which is to say never on the
  ; machine of whoever wrote it.
  (let [saved (System/get_env (BeamLisp.Model/dir_env))]
    (System/put_env (BeamLisp.Model/dir_env) "/tmp/bl-search-no-model")
    (let [code (bl.cli/run-argv ["search" "anything at all" "-p" DIR])]
      (if (some? saved)
        (System/put_env (BeamLisp.Model/dir_env) saved)
        (System/delete_env (BeamLisp.Model/dir_env)))
      (is (= 2 code) "an absent model is a usage error, not a crash"))))

(deftest a-search-over-a-corpus-runs-end-to-end
  (write-fixtures!)
  (if (code.embed/available?)
    (is (zero? (bl.cli/run-argv ["search" "read a file into lines"
                                 "-p" DIR "-k" "2"]))
        "with the model: a real query over a real corpus exits 0")
    (is (= 2 (bl.cli/run-argv ["search" "read a file into lines" "-p" DIR]))
        "without the model: exit 2, and the guidance names the fetch command")))

(deftest the-store-belongs-to-the-corpus-not-the-shell
  ;; The store is resolved from the CORPUS, not from whatever directory the shell
  ;; happens to sit in: searching another project must not scatter its stores into
  ;; the cwd, and a project's facts must be deletable by deleting the project.
  ;; This fixture corpus has no project marker above it, so it is its own project.
  (write-fixtures!)
  (let [saved (System/get_env "BLANALYSIS_DIR")]
    (System/delete_env "BLANALYSIS_DIR")
    (let [code (bl.cli/run-argv ["search" "read a file into lines" "-p" DIR "-k" "1"])
          dir  (str DIR "/.local/bl/cache")]
      (if (nil? saved)
        (System/delete_env "BLANALYSIS_DIR")
        (System/put_env "BLANALYSIS_DIR" saved))
      (if (zero? code)
        (do (is (File/dir? dir) "the store landed under the corpus, not under the cwd")
            (is (pos? (count (File/ls! dir))) "and it holds one store per source it read"))
        (is (= 2 code) "without the model the command says so and exits 2")))))

