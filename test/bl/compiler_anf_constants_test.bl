(ns compiler-anf-constant-test (:require [anf :as a]))

(defn- compile-form [text]
 (BeamLisp.Compiler/reset_fresh!)
 (BeamLisp.Compiler/compile (first (BeamLisp.Reader/read_string text))
                            (BeamLisp.Compiler/new_env "compiler.anf.constant.fixture")))

(defn- shadow-values [poison action]
 (let [previous (BeamLisp.Env/capture) scope (BeamLisp.Env/fork :global)]
  (try
   (BeamLisp.Env/with_env scope
    (fn []
     (BeamLisp.Env/intern "anf" "enil" poison)
     (BeamLisp.Env/intern "anf" "pnil" poison)
     (BeamLisp.Env/intern "anf" "var" poison)
     (BeamLisp.Env/intern "reader-node" "node-form" poison)
     (action)))
   (finally (BeamLisp.Env/destroy scope) (BeamLisp.Env/bind previous)))))

(deftest immutable-anf-construction-preserves-public-value-compatibility
 (is (= {:op :enil :ann {}} (a/empty-list-node)))
 (is (= {:pop :pnil} (a/empty-list-pattern)))
 (is (= a/enil (a/empty-list-node)))
 (is (= a/pnil (a/empty-list-pattern))))

(deftest compiler-ir-never-borrows-mutable-anf-empty-values
 (doseq [text ["()" "'(a b)" "`(a ~x ~@xs)" "(fn [& xs] xs)"
               "(let [[x & xs] []] xs)" "(defn f [x & xs] xs)"
               "(defmacro macro_probe [& xs] `(or ~@xs))"
               "(System/get_env \"HOME\")"
               "(defserver callback_probe (init [arg] (ok arg)))"]]
  (let [expected (compile-form text)]
   (doseq [poison [nil {:op :poison :pop :poison}]]
    (is (= expected (shadow-values poison (fn [] (compile-form text)))))))))


(defn- anf-value-symbols
 ([node aliases call-position?] (anf-value-symbols node aliases call-position? 0))
 ([node aliases call-position? quote-depth]
 (let [node (BeamLisp.AOT/stage-unmeta node)]
  (if-not (erlang/is_tuple node) (list)
   (let [tag (erlang/element 1 node)]
    (cond
     (= :symbol tag)
      (let [symbol (erlang/element 2 node) parts (String/split symbol "/")]
       (if (and (= 0 quote-depth) (not call-position?) (= 2 (count parts)) (contains? aliases (first parts)))
        (list symbol) (list)))
     (= :list tag)
      (let [items (erlang/element 2 node) head (when (seq items) (BeamLisp.AOT/stage-unmeta (first items)))
            name (when (and (erlang/is_tuple head) (= :symbol (erlang/element 1 head))) (erlang/element 2 head))]
       (cond
        (and (= 0 quote-depth) (= "quote" name)) (list)
        (= "syntax-quote" name)
         (Enum/flat_map (rest items) (fn [item] (anf-value-symbols item aliases false (inc quote-depth))))
        (and (> quote-depth 0) (contains? #{"unquote" "unquote-splicing"} name))
         (Enum/flat_map (rest items) (fn [item] (anf-value-symbols item aliases false (dec quote-depth))))
        :else
         (erlang/++ (if (seq items) (anf-value-symbols (first items) aliases true quote-depth) (list))
          (Enum/flat_map (rest items) (fn [item] (anf-value-symbols item aliases false quote-depth))))))
     (contains? #{:vector :set} tag)
      (Enum/flat_map (erlang/element 2 node) (fn [item] (anf-value-symbols item aliases false quote-depth)))
     (= :map tag)
      (Enum/flat_map (erlang/element 2 node)
       (fn [pair] (erlang/++ (anf-value-symbols (erlang/element 1 pair) aliases false quote-depth)
                            (anf-value-symbols (erlang/element 2 pair) aliases false quote-depth))))
     :else (list)))))))

(defn- compile-refusal [text]
 (try (compile-form text) :unexpected-success
  (catch error [(ex-message error) (ex-data error)])))

(deftest malformed-function-diagnostics-never-borrow-reader-callback-values
 (let [expected (compile-refusal "(fn 1)")]
  (doseq [poison [nil {:op :poison}]]
   (is (= expected (shadow-values poison (fn [] (compile-refusal "(fn 1)"))))))))

(deftest reader-guard-detects-executable-anf-values-without-literal-false-positives
 (doseq [[text expected] [["(defn f [xs] (map a/var xs))" (list "a/var")]
                         ["(defn f [] a/enil)" (list "a/enil")]
                         ["(defn f [x] (a/lit x))" (list)]
                         ["'(a/enil a/var)" (list)]
                         ["`(a/enil a/var)" (list)]
                         ["`(~a/var)" (list "a/var")]
                         ["; a/enil in a comment\n(defn f [] \"a/enil\")" (list)]]]
  (is (= expected (Enum/flat_map (BeamLisp.Reader/read_string text)
                   (fn [form] (anf-value-symbols form #{"a" "anf"} false)))))))

(deftest compiler-source-keeps-anf-construction-on-native-call-sites
 (let [path (or (System/get_env "BL_COMPILER_SOURCE_UNDER_TEST")
                (Path/join (BeamLisp/cwd) "priv/boot/compiler.bl"))
       forms (BeamLisp.Reader/read_string (File/read! path) path)
       header (BeamLisp.AOT/stage-requires (first forms))
       aliases (conj (set (Enum/map (Enum/filter (:aliases (:metadata header))
                                    (fn [pair] (contains? #{"anf" "reader-node"} (erlang/element 2 pair))))
                                   (fn [pair] (erlang/element 1 pair)))) "anf")]
  (is (= (list) (Enum/flat_map (rest forms)
                  (fn [form] (anf-value-symbols form aliases false)))))))
