; The ordinary build suite disables caching. Exercise the native cache ABI.
(ns build.cache-test (:require [build :as build] [build-log :as log]))
(deftest native-build-publishes-and-reuses-cache-entries
  (let [root (str (System/tmp_dir!) "/native-build-cache-" (System/unique_integer (list :positive)))
        source (str root "/cache-leaf.bl") out (str root "/ebin")
        previous-dir (System/get_env "BEAM_LISP_AOT_CACHE_DIR")
        previous-enabled (System/get_env "BEAM_LISP_AOT_CACHE")]
    (File/mkdir_p! root)
    (System/put_env "BEAM_LISP_AOT_CACHE_DIR" (str root "/cache"))
    (System/put_env "BEAM_LISP_AOT_CACHE" "on")
    (try
      (File/write! source "(ns cache-leaf)\n(defn value [] 42)")
      (let [opts {:sources [source] :out out :jobs 1}
            first-run (build/run opts)]
        (is (= [] (:errors first-run)))
        (is (= 1 (:built first-run)))
        (let [module (first (:modules (get (:manifest first-run) source)))]
          (is (seq (Path/wildcard (str root "/cache/**/" (Atom/to_string module) ".beam")))))
        (File/rm_rf! out)
        (let [warm (build/run opts)
              facts (filter #(= :build/built (first %))
                      (log/read-facts (log/path-for (build/manifest-path out))))]
          (is (= [] (:errors warm)))
          (is (= 1 (count facts)))
          (is (= true (nth (first facts) 5)))))
      (finally
        (if previous-dir (System/put_env "BEAM_LISP_AOT_CACHE_DIR" previous-dir) (System/delete_env "BEAM_LISP_AOT_CACHE_DIR"))
        (if previous-enabled (System/put_env "BEAM_LISP_AOT_CACHE" previous-enabled) (System/delete_env "BEAM_LISP_AOT_CACHE"))
        (File/rm_rf! root)))))

(deftest sdk-dependency-provenance-survives-fresh-output
  (let [root (str (System/tmp_dir!) "/sdk-build-cache-" (System/unique_integer (list :positive)))
        source (str root "/sdk-cache-consumer.bl") out (str root "/ebin")
        old-dir (System/get_env "BEAM_LISP_AOT_CACHE_DIR")
        old-enabled (System/get_env "BEAM_LISP_AOT_CACHE")]
    (File/mkdir_p! root)
    (System/put_env "BEAM_LISP_AOT_CACHE_DIR" (str root "/cache"))
    (System/put_env "BEAM_LISP_AOT_CACHE" "on")
    (try
      (File/write! source "(ns sdk-cache-consumer (:require [bl.json :as json]))\n(defn value [] (json/encode {:answer 42}))")
      (let [opts {:sources [source] :out out :jobs 1}
            cold (build/run opts)]
        (is (= [] (:errors cold)))
        (let [entry (get (:manifest cold) source)]
          (is (BeamLisp.AOTCache/beam_provenance_matches?
                (str out "/Elixir.BeamLisp.Ns.Sdk-cache-consumer.beam") (:key entry) (:hash entry))))
        (File/rm_rf! out)
        (let [warm (build/run opts)
              facts (filter #(= :build/built (first %))
                      (log/read-facts (log/path-for (build/manifest-path out))))]
          (is (= [] (:errors warm)))
          (is (= 1 (count facts)))
          (is (= true (nth (first facts) 5)))))
      (finally
        (if old-dir (System/put_env "BEAM_LISP_AOT_CACHE_DIR" old-dir) (System/delete_env "BEAM_LISP_AOT_CACHE_DIR"))
        (if old-enabled (System/put_env "BEAM_LISP_AOT_CACHE" old-enabled) (System/delete_env "BEAM_LISP_AOT_CACHE"))
        (File/rm_rf! root)))))
