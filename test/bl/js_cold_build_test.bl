; A cold CLI build must initialize its emitter dependencies before staging
; the same namespaces as target source. Warm compiler tests cannot expose this.
(ns bl.js.cold-build-test
  (:require [bl.util :as u]))

(deftest cold-cli-build-can-compile-the-emitter-own-ir-dependency
  (if (nil? (System/find_executable "node"))
    (is true "node not installed: skipped")
    (let [checkout (BeamLisp/cwd)
          root (Path/join (System/tmp_dir!)
                 (str "bl-jscold-" (System/unique_integer (u/to-list [:positive]))))
          source (str root "/src")
          out (str root "/out")]
      (try
        (File/mkdir_p! (str source "/cold"))
        (File/write! (str source "/cold/main.bl")
          "(ns cold.main)\n(defn answer [] 42)\n(println (answer))\n")
        (let [[report code] (u/to-list (erlang/tuple_to_list
                             (System/cmd (Path/join checkout "bin/bl")
                               (u/to-list ["js" "build" "cold.main" "-p" source
                                           "--with" "system.ir" "--out" out])
                               (u/kw [:cd checkout] [:stderr_to_stdout true]))))]
          (is (= 0 code) report)
          (when (= 0 code)
            (let [[printed result] (u/to-list (erlang/tuple_to_list
                                      (System/cmd "node" (u/to-list [(str out "/ns/cold.main.mjs")])
                                                  (u/kw [:stderr_to_stdout true]))))]
              (is (= 0 result) printed)
              (is (= "42\n" printed) "the cold build runs against its compiled core"))))
        (finally (File/rm_rf! root))))))
