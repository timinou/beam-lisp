(ns env-definition-context-test)

(deftest context-tracks-definition-changes-in-any-namespace
 (BeamLisp.Env/isolated (fn []
  (let [before (BeamLisp.Env/definition_context)]
   (is (some? before))
   (BeamLisp.Env/put_key (tuple "context.unlisted-provider" "value") 1)
   (is (not= before (BeamLisp.Env/definition_context)))
   (let [changed (BeamLisp.Env/definition_context)]
    (BeamLisp.Env/delete_key (tuple "context.unlisted-provider" "value"))
    (is (not= changed (BeamLisp.Env/definition_context))))))))

(deftest private-analysis-forks-do-not-invalidate-parent-context
 (let [before (BeamLisp.Env/definition_context)]
  (BeamLisp.Env/isolated (fn []
   (BeamLisp.Env/put_key (tuple "context.private-provider" "value") 1)))
  (is (= before (BeamLisp.Env/definition_context)))))

(deftest context-declines-during-publication-and-changes-after-failure
 (BeamLisp.Env/isolated (fn []
  (let [before (BeamLisp.Env/definition_context)]
   (try (BeamLisp.Env/with_publication "context.writer" (fn []
          (is (nil? (BeamLisp.Env/definition_context)))
          (throw :expected-publication-failure)))
        (catch _ nil))
   (is (some? (BeamLisp.Env/definition_context)))
   (is (not= before (BeamLisp.Env/definition_context)))))))

(deftest bulk-deletion-invalidates-and-destroyed-scopes-decline
 (let [child (BeamLisp.Env/fork)]
  (try
   (BeamLisp.Env/with_env child (fn []
    (let [before (BeamLisp.Env/definition_context)]
     (BeamLisp.Env/match_delete_own (tuple (tuple "context.bulk-provider" :_) :_))
     (is (not= before (BeamLisp.Env/definition_context))))))
   (finally (BeamLisp.Env/destroy child)))
  (BeamLisp.Env/with_env child (fn [] (is (nil? (BeamLisp.Env/definition_context)))))))
