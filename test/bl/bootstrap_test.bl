; bootstrap_test.bl — the pinned `Elixir.BeamLisp.Bootstrap` host leaf.
;
; `priv/host/bootstrap.bl` is the `.bl` port of the recalled
; `lib/beam_lisp/bootstrap.ex`: the seed staging/verification API every boot
; call sits on. It is compiled by `BeamLisp.AOT/compile_host_file` into ONE
; exact-named beam whose top-level `defn`s are the call surface every caller
; already names at `Elixir.BeamLisp.Bootstrap`. This file judges the three
; things that make the pin sound, and nothing about the seed mapping (which is
; added only after this passes):
;
;   1. THE PUBLIC ABI IS the recalled one: `install!/1,2`, `install_hosts!/1,2`,
;      `seed_dir/0`, `manifest/0`, `key_matches?/1` (plus the BEAM's own
;      `module_info/0,1`). The pinned emitter exports every top-level `defn` it
;      compiles, so the file's PRIVATE helpers appear as extra exports too; that
;      is a deliberate, recorded deviation (`defn-` is not privatized on this
;      path), and the extra names are asserted callable rather than hidden.
;
;   2. THE ANSWERS MATCH THE LIVE MODULE, question for question: the read-only
;      surface (`seed_dir`, `manifest`, `key_matches?`) AND both install paths
;      against identical scratch seeds — the return value, the installed BYTES,
;      and the RAISE (class + message) for a corrupt seed and a malformed
;      inventory. A fresh compile of the source at a PROBE atom is compared to
;      `Elixir.BeamLisp.Bootstrap` under a normaliser that makes a raise a value.
;
;   3. THE EMITTED BEAM RUNS AT PREBOOT. That is the property the pin exists for
;      and the one a same-VM differential cannot see: the compiler that produced
;      the probe has `BeamLisp.Ns.Rt` and all of `core` loaded, so a call that
;      secretly went through the runtime would pass every test above. So the
;      source is compiled at the REAL atom, `load? false`, into a throwaway dir;
;      its atom table is checked for `Elixir.BeamLisp.Ns.Rt` /
;      `Elixir.BeamLisp.Env` / `Elixir.BeamLisp.Ns.Core` in the PARENT; and a
;      fresh `elixir` child with ONLY that dir added to the code path calls
;      `seed_dir` and `manifest`, asserting `BeamLisp.Ns.Rt` is not loaded
;      before or after and that `BeamLisp.Env` is not on the path at all.
;
; Run: bin/bl test test/bl/bootstrap_test.bl

(ns bootstrap.test)

(def ^:private PROBE :Elixir.BeamLisp.BootstrapProbe)
(def ^:private LIVE :Elixir.BeamLisp.Bootstrap)

; A non-production probe module: `Elixir.BeamLisp.*` (so it is judged a HOST
; leaf) but never shipped, so loading it in this VM is harmless.
(def ^:private probe-beam "Elixir.BeamLisp.HostSeedProbe.beam")
(def ^:private probe-mod (erlang/binary_to_atom "Elixir.BeamLisp.HostSeedProbe" :utf8))

; A second probe OUTSIDE the `Elixir.BeamLisp.*` prefix — the leaf the explicit
; `hosts` list exists to name.
(def ^:private enum-probe-beam "Elixir.Enumerable.BeamLisp.BootProbe.beam")
(def ^:private enum-probe-mod
  (erlang/binary_to_atom "Elixir.Enumerable.BeamLisp.BootProbe" :utf8))

; A generation-ladder name, to be refused if a manifest lists it as a pinned host.
(def ^:private ns-beam "Elixir.BeamLisp.Ns.Core.beam")

(defn- t [k v] (erlang/list_to_tuple (list k v)))

(defn- tmp-root []
  (Path/join (System/tmp_dir!)
             (str "bl_bootstrap_" (erlang/unique_integer (list :positive)))))

(defn- bootstrap-source [] (Path/join (BeamLisp/cwd) "priv/host/bootstrap.bl"))

(defn- ensure-probe!
  "The pinned `Bootstrap`, compiled from `priv/host/bootstrap.bl` at `PROBE`
   with `load? false`, then loaded here. Compiled once per VM."
  []
  (if (not= false (code/is_loaded PROBE))
    PROBE
    (let [out (str (System/tmp_dir!) "/bl_bootstrap_probe_"
                   (erlang/unique_integer (list :positive)))
          result (BeamLisp.AOT/compile_host_file (bootstrap-source)
                   (list (t :module PROBE) (t :output_dir out) (t :load? false)))
          path (erlang/element 2 result)]
      (code/purge PROBE)
      (code/delete PROBE)
      (code/load_binary PROBE (erlang/binary_to_list path) (File/read! path))
      PROBE)))

(defn- exports [mod] (erlang/apply mod :module_info (list :exports)))

(defn- sha-of [bytes]
  (String/downcase (Base/encode16 (erlang/apply :crypto :hash (list :sha256 bytes)))))

(defn- beam
  "A host-leaf beam: module + `value/0` + the `__bl_provenance__/0` stamp and the
   `bl_compiler_key` attribute `AOT.emit_module` writes beside it."
  [mod value key]
  (let [value-fn (tuple :function 1 :value 0
                        (list (tuple :clause 1 (list) (list)
                                     (list (erl_parse/abstract value)))))
        provenance (tuple :function 1 :__bl_provenance__ 0
                          (list (tuple :clause 1 (list) (list)
                                       (list (erl_parse/abstract (tuple nil key))))))
        exports (list (tuple :value 0) (tuple :__bl_provenance__ 0))
        stamp (list (tuple :attribute 1 :bl_compiler_key key))
        forms (concat (list (tuple :attribute 1 :module mod)
                            (tuple :attribute 1 :export exports))
                      stamp
                      (list value-fn provenance))]
    (elem (erlang/apply :compile :forms (list (to-list forms) (list :binary))) 2)))

(defn- write-seed! [seed bytes]
  (File/write! (Path/join seed probe-beam) bytes)
  (let [sha (sha-of bytes)
        manifest (Path/join seed "manifest.exs")]
    (File/write! manifest
                 (str "%{\"modules\" => %{\"" probe-beam "\" => \"" sha "\"}}"))))

(defn- write-seed-listed! [seed name bytes]
  (let [sha (sha-of bytes)]
    (File/write! (Path/join seed name) bytes)
    (File/write! (Path/join seed "manifest.exs")
                 (str "%{\"hosts\" => [\"" name "\"], "
                      "\"modules\" => %{\"" name "\" => \"" sha "\"}}"))))

(defn- write-hosts-src! [seed hosts-src modules-src]
  (File/write! (Path/join seed "manifest.exs")
               (str "%{\"hosts\" => " hosts-src ", \"modules\" => " modules-src "}")))

(defn- with-scratch
  "A fresh `{seed, ebin}` tree, with the `:bootstrap_staging` restore and the
   probe purges the ExUnit `setup`/`on_exit` pair would provide."
  [f]
  (let [root (tmp-root)
        seed (Path/join root "seed")
        ebin (Path/join root "ebin")
        staging (erlang/apply :application :get_env (list :beam_lisp :bootstrap_staging))
        key (BeamLisp.AOTCache/compiler_key)]
    (File/mkdir_p! seed)
    (File/mkdir_p! ebin)
    (try
      (f {:seed seed :ebin ebin :key key})
      (finally
        (code/purge probe-mod)
        (code/delete probe-mod)
        (code/purge enum-probe-mod)
        (code/delete enum-probe-mod)
        (if (= staging :undefined)
          (erlang/apply :application :unset_env (list :beam_lisp :bootstrap_staging))
          (erlang/apply :application :set_env
                        (list :beam_lisp :bootstrap_staging (elem staging 1))))
        (File/rm_rf! root)))))

(defn- outcome
  "The whole answer of `(f)`: `[:value v]` or `[:raise Class message]`. Lets the
   corpus compare calls that refuse, CLASS and message included."
  [f]
  (try [:value (f)]
       (catch e [:raise (:__struct__ e) (ex-message e)])))

; ── 1. the ABI ──────────────────────────────────────────────────────────────

(def ^:private RECALLED-PUBLIC
  "The recalled module's PUBLIC call surface (the pinned beam carries no
   Elixir-generated `__info__/1`)."
  (list
    (t :install! 1) (t :install! 2)
    (t :install_hosts! 1) (t :install_hosts! 2)
    (t :key_matches? 1)
    (t :manifest 0)
    (t :module_info 0) (t :module_info 1)
    (t :seed_dir 0)))

(deftest the-pinned-bootstrap-exports-the-recalled-public-surface
  (let [probe-exports (exports (ensure-probe!))]
    (doseq [want RECALLED-PUBLIC]
      (is (Enum/member? probe-exports want) (str "missing public export " (pr-str want))))
    (is (= (sort (list (t :install! 1) (t :install! 2)))
           (sort (Enum/filter RECALLED-PUBLIC (fn [p] (= :install! (elem p 0)))))))
    (testing "the recorded deviation: the file's private helpers are exports here"
      (doseq [want (list (t :stamped_key 1) (t :loaded_is? 2) (t :install_one 3)
                         (t :verify_seed_file! 3) (t :host_names 1)
                         (t :cat__bl_v 1) (t :tup__bl_v 1))]
        (is (Enum/member? probe-exports want) (str "helper not callable: " (pr-str want)))))
    (testing "and every recalled public function is callable at both arities"
      (let [m (ensure-probe!)]
        (is (= (BeamLisp.Bootstrap/seed_dir) (erlang/apply m :seed_dir (list))))
        (is (erlang/is_boolean (erlang/apply m :key_matches? (list (BeamLisp.Bootstrap/manifest)))))
        (is (= (BeamLisp.Bootstrap/seed_dir)
               (erlang/apply m :seed_dir (list))))))))

(deftest the-pinned-module-is-a-deterministic-function-of-its-source
  (let [out (str (System/tmp_dir!) "/bl_bootstrap_repro_"
                 (erlang/unique_integer (list :positive)))
        build (fn []
                (erlang/element 2
                  (BeamLisp.AOT/compile_host_file (bootstrap-source)
                    (list (t :module :Elixir.BeamLisp.BootstrapRepro)
                          (t :output_dir out) (t :load? false)))))]
    (is (= (File/read! (build)) (File/read! (build)))
        "the pinned emitter is deterministic, so a committed seed beam can be
         re-derived from this source and judged by its digest")))

; ── 2. the read-only differential ───────────────────────────────────────────

(defn- answer [mod name args]
  (try [:value (erlang/apply mod name args)]
       (catch e [:raise (:__struct__ e) (ex-message e)])))

(defn- same-answer? [a b name args]
  (= (answer a name args) (answer b name args)))

(deftest the-pinned-read-only-surface-answers-as-the-live-module
  (let [probe (ensure-probe!)]
    (is (same-answer? probe LIVE :seed_dir (list))
        "seed_dir resolves the same priv path")
    (is (same-answer? probe LIVE :manifest (list))
        "manifest reads the committed seed and agrees, key for key")
    (testing "key_matches? on the committed manifest (a mismatch on this tree)"
      (let [m (BeamLisp.Bootstrap/manifest)]
        (is (same-answer? probe LIVE :key_matches? (list m)))))
    (testing "key_matches? is TRUE when the manifest carries this toolchain's keys"
      (let [m {"compiler_key" (BeamLisp.AOTCache/compiler_key)
               "build_key" (BeamLisp.AOTCache/build_key)}]
        (is (= true (erlang/apply probe :key_matches? (list m))))
        (is (same-answer? probe LIVE :key_matches? (list m)))))
    (testing "and FALSE when one key differs"
      (let [m {"compiler_key" "not-the-key" "build_key" (BeamLisp.AOTCache/build_key)}]
        (is (= false (erlang/apply probe :key_matches? (list m))))
        (is (same-answer? probe LIVE :key_matches? (list m)))))
    (testing "the answers are concrete, not merely equal"
      (is (pos? (erlang/byte_size (erlang/apply probe :seed_dir (list)))))
      (is (erlang/is_map (erlang/apply probe :manifest (list)))))))

; ── 2b. install_hosts!/2 differential ───────────────────────────────────────

(deftest the-pinned-install-hosts-installs-the-same-bytes-as-the-live-module
  (with-scratch
    (fn [{:keys [seed ebin key]}]
      (let [new (beam probe-mod :seed key)
            dst (Path/join ebin probe-beam)]
        (write-seed! seed new)
        (let [probe-ret (outcome (fn [] (erlang/apply (ensure-probe!) :install_hosts!
                                               (list ebin (list (t :seed_dir seed))))))
              probe-bytes (File/read! dst)]
          (File/rm! dst)
          (let [live-ret (outcome (fn [] (erlang/apply LIVE :install_hosts!
                                                (list ebin (list (t :seed_dir seed))))))
                live-bytes (File/read! dst)]
            (is (= live-ret probe-ret))
            (is (= [:value :ok] probe-ret) (str "install_hosts! answered " (pr-str probe-ret)))
            (is (= live-bytes probe-bytes) "both install the seed's bytes")
            (is (= new live-bytes) "the installed beam IS the seed beam")
            (is (= :seed (erlang/apply probe-mod :value (list)))
                "the installed host was loaded")))))))

(deftest the-pinned-install-hosts-installs-a-listed-out-of-prefix-host
  (with-scratch
    (fn [{:keys [seed ebin key]}]
      (let [new (beam enum-probe-mod :seed key)
            dst (Path/join ebin enum-probe-beam)]
        (write-seed-listed! seed enum-probe-beam new)
        (let [probe-ret (outcome (fn [] (erlang/apply (ensure-probe!) :install_hosts!
                                               (list ebin (list (t :seed_dir seed))))))
              probe-bytes (File/read! dst)]
          (File/rm! dst)
          (let [live-ret (outcome (fn [] (erlang/apply LIVE :install_hosts!
                                                (list ebin (list (t :seed_dir seed))))))]
            (is (= live-ret probe-ret))
            (is (= [:value :ok] probe-ret))
            (is (= probe-bytes (File/read! dst))
                "the manifest's `hosts` list, not the prefix, selects the leaf")))))))

; ── 2c. install!/2 differential ─────────────────────────────────────────────

(deftest the-pinned-install-stages-a-mismatched-floor-as-the-live-module
  (with-scratch
    (fn [{:keys [seed ebin key]}]
      (let [new (beam probe-mod :seed key)
            dst (Path/join ebin probe-beam)]
        (write-seed! seed new)
        (let [probe-ret (outcome (fn [] (erlang/apply (ensure-probe!) :install!
                                               (list ebin (list (t :seed_dir seed))))))
              probe-bytes (File/read! dst)]
          (File/rm! dst)
          (let [live-ret (outcome (fn [] (erlang/apply LIVE :install!
                                                (list ebin (list (t :seed_dir seed))))))
                live-bytes (File/read! dst)]
            (is (= live-ret probe-ret))
            (is (= [:value (erlang/list_to_tuple (list :staged :compiler_key_mismatch))]
                   probe-ret)
                "a keyless floor is STAGED, not fatal")
            (is (= live-bytes probe-bytes))
            (is (= new live-bytes))))))))

(deftest the-pinned-install-returns-ok-on-a-matching-floor-as-the-live-module
  ;; A floor whose `compiler_key`/`build_key` equal THIS toolchain's is the
  ;; finished compiler: install and answer `:ok`, clearing any staging flag.
  (with-scratch
    (fn [{:keys [seed ebin key]}]
      (let [new (beam probe-mod :seed key)
            dst (Path/join ebin probe-beam)]
        (File/write! (Path/join seed probe-beam) new)
        (File/write! (Path/join seed "manifest.exs")
                     (str "%{\"compiler_key\" => \"" (BeamLisp.AOTCache/compiler_key) "\", "
                          "\"build_key\" => \"" (BeamLisp.AOTCache/build_key) "\", "
                          "\"modules\" => %{\"" probe-beam "\" => \"" (sha-of new) "\"}}"))
        (let [probe-ret (outcome (fn [] (erlang/apply (ensure-probe!) :install!
                                              (list ebin (list (t :seed_dir seed))))))
              probe-bytes (File/read! dst)]
          (is (= [:value :ok] probe-ret) (str "matching floor: " (pr-str probe-ret)))
          (is (= new probe-bytes))
          (File/rm! dst)
          (let [live-ret (outcome (fn [] (erlang/apply LIVE :install!
                                                (list ebin (list (t :seed_dir seed))))))]
            (is (= live-ret probe-ret))
            (is (= :ok (get live-ret 1)))
            (is (= probe-bytes (File/read! dst)))))))))

(deftest the-pinned-install-stages-the-app-resource-only-when-absent
  (with-scratch
    (fn [{:keys [seed ebin key]}]
      (let [new (beam probe-mod :seed key)
            app-bytes "% this stands in for beam_lisp.app"
            app-sha (sha-of app-bytes)
            app-dst (Path/join ebin "beam_lisp.app")]
        (File/write! (Path/join seed probe-beam) new)
        (File/write! (Path/join seed "beam_lisp.app") app-bytes)
        (File/write! (Path/join seed "manifest.exs")
                     (str "%{\"app\" => %{\"file\" => \"beam_lisp.app\""
                          ", \"sha256\" => \"" app-sha "\"}, "
                          "\"modules\" => %{\"" probe-beam "\" => \"" (sha-of new) "\"}}"))
        (let [probe-ret (outcome (fn [] (erlang/apply (ensure-probe!) :install!
                                              (list ebin (list (t :seed_dir seed))))))]
          (is (= [:value (erlang/list_to_tuple (list :staged :compiler_key_mismatch))] probe-ret))
          (is (= app-bytes (File/read! app-dst)) "an absent app resource is staged")
          (File/write! app-dst "the tree's own app resource")
          (File/rm! (Path/join ebin probe-beam))
          (let [live-ret (outcome (fn [] (erlang/apply LIVE :install!
                                                (list ebin (list (t :seed_dir seed))))))]
            (is (= live-ret probe-ret))
            (is (= "the tree's own app resource" (File/read! app-dst))
                "a floor is a bootstrap, not a correction: an existing app is kept")))))))

; ── 2d. the refusals, differentially ────────────────────────────────────────

(deftest a-corrupt-host-seed-is-refused-identically-and-writes-nothing
  (with-scratch
    (fn [{:keys [seed ebin key]}]
      (let [dst (Path/join ebin probe-beam)
            run (fn [] (erlang/apply (ensure-probe!) :install_hosts!
                           (list ebin (list (t :seed_dir seed)))))]
        (write-seed! seed (beam probe-mod :seed key))
        (File/write! (Path/join seed probe-beam) "not a beam")
        (let [probe-ret (outcome run)]
          (is (= :"Elixir.RuntimeError" (get probe-ret 1)))
          (is (includes? (get probe-ret 2) "checksum mismatch"))
          (is (not (File/exists? dst)) "a refused seed writes nothing")
          (let [live-ret (outcome (fn [] (erlang/apply LIVE :install_hosts!
                                                (list ebin (list (t :seed_dir seed))))))]
            (is (= live-ret probe-ret) "same class and same message")))))))

(deftest a-malformed-hosts-inventory-is-refused-identically
  (with-scratch
    (fn [{:keys [seed ebin key]}]
      (let [bytes (beam enum-probe-mod :seed key)
            sha (sha-of bytes)
            mods (str "%{\"" enum-probe-beam "\" => \"" sha "\", "
                      "\"" ns-beam "\" => \"" sha "\"}")
            run (fn [] (erlang/apply (ensure-probe!) :install_hosts!
                           (list ebin (list (t :seed_dir seed)))))]
        (testing "a generation-ladder module named as a pinned host"
          (write-hosts-src! seed (str "[\"" ns-beam "\"]") mods)
          (let [probe-ret (outcome run)]
            (is (includes? (get probe-ret 2) "generation-ladder"))
            (is (= (outcome (fn [] (erlang/apply LIVE :install_hosts!
                                           (list ebin (list (t :seed_dir seed))))))
                   probe-ret))))
        (testing "a duplicate entry"
          (write-hosts-src! seed
            (str "[\"" enum-probe-beam "\", \"" enum-probe-beam "\"]") mods)
          (let [probe-ret (outcome run)]
            (is (includes? (get probe-ret 2) "more than once"))
            (is (= (outcome (fn [] (erlang/apply LIVE :install_hosts!
                                           (list ebin (list (t :seed_dir seed))))))
                   probe-ret))))
        (testing "a name absent from `modules`"
          (write-hosts-src! seed "[\"Elixir.Enumerable.BeamLisp.Missing.beam\"]" mods)
          (let [probe-ret (outcome run)]
            (is (includes? (get probe-ret 2) "absent"))
            (is (= (outcome (fn [] (erlang/apply LIVE :install_hosts!
                                           (list ebin (list (t :seed_dir seed))))))
                   probe-ret))))
        (testing "a malformed name (no `.beam`) and a non-list `hosts`"
          (write-hosts-src! seed "[\"Elixir.Enumerable.BeamLisp.NoExt\"]" mods)
          (is (= (outcome (fn [] (erlang/apply LIVE :install_hosts!
                                         (list ebin (list (t :seed_dir seed))))))
                 (outcome run)))
          (write-hosts-src! seed "\"nope\"" mods)
          (let [probe-ret (outcome run)]
            (is (includes? (get probe-ret 2) "not a list"))
            (is (= (outcome (fn [] (erlang/apply LIVE :install_hosts!
                                           (list ebin (list (t :seed_dir seed))))))
                   probe-ret))))))))

(deftest a-missing-manifest-is-refused-identically-by-install!
  (with-scratch
    (fn [{:keys [ebin seed]}]
      (let [run (fn [mod] (erlang/apply mod :install! (list ebin (list (t :seed_dir seed)))))
            probe-ret (outcome (fn [] (run (ensure-probe!))))]
        (is (= :"Elixir.RuntimeError" (get probe-ret 1)))
        (is (includes? (get probe-ret 2) "beam-lisp bootstrap seed is missing"))
        (is (= (outcome (fn [] (run LIVE))) probe-ret))))))

; ── 3. the isolated preboot proof ───────────────────────────────────────────

(defn- beam-atoms [path]
  (let [r (erlang/apply :beam_lib :chunks
                        (list (erlang/binary_to_list path) (list :atoms)))]
    (if (and (erlang/is_tuple r) (= :ok (erlang/element 1 r)))
      (erlang/element 2 (first (erlang/element 2 (erlang/element 2 r))))
      [])))

(deftest the-pinned-beam-does-not-name-the-runtime-it-must-not-call
  (let [out (str (System/tmp_dir!) "/bl_bootstrap_preboot_"
                 (erlang/unique_integer (list :positive)))
        result (BeamLisp.AOT/compile_host_file (bootstrap-source)
                 (list (t :module LIVE) (t :output_dir out) (t :load? false)))
        path (erlang/element 2 result)
        atoms (beam-atoms path)]
    (is (pos? (count atoms)) "the emitted beam was read back")
    (doseq [bad (list :"Elixir.BeamLisp.Ns.Rt" :"Elixir.BeamLisp.Env"
                      :"Elixir.BeamLisp.Ns.Core")]
      (is (not (Enum/member? atoms bad))
          (str "the pinned beam never mentions " bad
               " — no core/Rt convenience and no bare symbol leaked into the
               preboot path")))
    (File/rm_rf! out)))

(defn- preboot-script []
  (str
    "mod = :\"Elixir.BeamLisp.Bootstrap\"\n"
    "{:module, ^mod} = :code.ensure_loaded(mod)\n"
    "IO.puts(\"loaded_from_tmp=\" <> to_string(:code.which(mod)))\n"
    "IO.puts(\"env_absent=\" <> to_string(:code.which(:\"Elixir.BeamLisp.Env\") == :non_existing))\n"
    "IO.puts(\"rt_before=\" <> to_string(:code.is_loaded(:\"Elixir.BeamLisp.Ns.Rt\")))\n"
    "dir = mod.seed_dir()\n"
    "IO.puts(\"seed_dir=\" <> dir)\n"
    "m = mod.manifest()\n"
    "IO.puts(\"manifest?=\" <> to_string(is_map(m)))\n"
    "IO.puts(\"manifest_schema=\" <> to_string(Map.get(m, \"schema\")))\n"
    "IO.puts(\"rt_after=\" <> to_string(:code.is_loaded(:\"Elixir.BeamLisp.Ns.Rt\")))\n"))

(deftest a-fresh-elixir-runs-the-candidate-beam-with-no-runtime-loaded
  (let [out (str (System/tmp_dir!) "/bl_bootstrap_preboot_"
                 (erlang/unique_integer (list :positive)))
        _ (BeamLisp.AOT/compile_host_file (bootstrap-source)
            (list (t :module LIVE) (t :output_dir out) (t :load? false)))
        r (System/cmd "elixir"
                      (to-list (list "-pa" out "-e" (preboot-script)))
                      (to-list (list (tuple :cd (BeamLisp/cwd))
                                     (tuple :stderr_to_stdout true))))
        text (elem r 0)]
    (is (= 0 (elem r 1)) (str "the child VM exited " (elem r 1) ":\n" text))
    (testing "nothing but Elixir/OTP and the candidate beam"
      (is (includes? text "env_absent=true")
          "BeamLisp.Env is not on the child's code path at all")
      (is (includes? text "rt_before=false") "BeamLisp.Ns.Rt is not loaded up front")
      (is (includes? text (str "loaded_from_tmp=" out "/Elixir.BeamLisp.Bootstrap.beam"))
          "the child loaded the CANDIDATE beam, not a repo ebin"))
    (testing "the preboot answers are the tree's"
      (is (includes? text "seed_dir=priv/bootstrap/seed")
          "priv_dir is unavailable with no application, so the source tree is used")
      (is (includes? text "manifest?=true") "the committed manifest was read via Code.eval_file")
      (is (includes? text "manifest_schema=beam-lisp-bootstrap-seed-v2"))
      (is (includes? text "rt_after=false")
          "no call dragged the runtime in — the whole proof"))
    (File/rm_rf! out)))
