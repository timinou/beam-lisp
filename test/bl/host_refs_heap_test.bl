; A hard OTP heap bound must kill only the future, not the caller. Exercise the
; checked-in BL host before the seed is regenerated: the currently loaded Refs
; beam may still be the previous generation.
(ns host.refs-heap.test)

(deftest bounded-future-is-killed-without-killing-caller
  (let [dir (str (System/tmp_dir!) "/bl-refs-heap-"
                 (System/system_time :millisecond) "-"
                 (erlang/unique_integer (list :positive)))
        mod :Elixir.BeamLisp.HeapRefsProbe
        env (BeamLisp.Env/fork :global (list (tuple :max_heap_words 50000)))]
    (try
      (File/mkdir_p! dir)
      (let [res (BeamLisp.AOT/compile_host_file
                  "priv/host/refs.bl"
                  (list (tuple :module mod)
                        (tuple :output_dir dir)
                        (tuple :load? false)))
            path (erlang/element 2 res)]
        (code/purge mod)
        (code/delete mod)
        (code/load_binary mod (String/to_charlist path) (File/read! path))
        (BeamLisp.Env/with_env env
          (fn []
            (is (= 50000 (BeamLisp.Env/max_heap)))
            (let [f (erlang/apply mod :future_exec
                      (list (fn [] (erlang/apply :lists :seq (list 1 1000000)))))]
              (is (= :heap_bound_enforced
                     (erlang/apply mod :deref (list f 5000 :heap_bound_enforced))))
              (is (not (Process/alive? (erlang/map_get :pid (erlang/map_get :task f))))
                  "the task is dead and its caller is still running")))))
      (finally
        (BeamLisp.Env/destroy env)
        (code/purge mod)
        (code/delete mod)
        (File/rm_rf! dir)))))
