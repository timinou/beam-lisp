(ns application.realm-package-test
 (:require [application.package :as package] [vm.core :as vmc]))
(defn realm-run [key action]
 (let [environment (BeamLisp.Env/fork (BeamLisp.Env/env_id))]
  (try
   (BeamLisp.Env/with_env environment (fn []
    (BeamLisp.Env/put_key (tuple :realm_key) key)
    (BeamLisp.Env/put_key (tuple :realm_decl) {:shadow [] :uses {}})
    (action)))
   (finally (BeamLisp.Env/destroy environment)))))
(defn refused? [action] (try (action) false (catch _ true)))

;; A release certificate deliberately refuses scoped compiler definitions. The
;; test runner adds its assertion macros to Core in a private harness fork;
;; execute release fixtures against the native compiler, restoring that fork
;; afterward. Assertion counters are process-local and remain fully recorded.
(defmacro release-test [name & body]
 (list 'deftest name
  (list 'BeamLisp.Env/with_env :global (list 'fn [] (cons 'do body)))))

(release-test compiler-time-source-drift-is-checked-after-the-shared-pass
 (let [root (str (System/tmp_dir!) "/realm-package-drift-" (erlang/unique_integer (list :positive)))
       source (str root "/src") leaf (str source "/rpdrift/leaf.bl")
       entry (str root "/entry.bl") output (str root "/release")
       original "(ns rpdrift.leaf) (defn value [] 1)"
       changed "(ns rpdrift.leaf) (defn value [] 2)"]
  (try
   (File/mkdir_p! (Path/dirname leaf))
   (File/write! leaf original)
   (File/write! (str source "/rpdrift/macros.bl")
    (str "(ns rpdrift.macros) (defmacro emit [] (File/write! "
         (pr-str leaf) " " (pr-str changed) ") 7)"))
   (File/write! (str source "/rpdrift/consumer.bl")
    "(ns rpdrift.consumer (:require [rpdrift.leaf :as leaf] [rpdrift.macros :as m])) (defn answer [] (+ (leaf/value) (m/emit)))")
   (File/write! entry "(ns rpdrift.entry (:require [rpdrift.consumer]))")
   (BeamLisp.Loader/with_search_dir source (fn []
    (realm-run (str "PackageDrift" (erlang/unique_integer (list :positive)))
     (fn [] (is (refused? (fn [] (package/build! entry output []))))))))
   (is (= changed (File/read! leaf)))
   (is (not (File/exists? output)))
   (finally (File/rm_rf! root)))))

(release-test realm-packages-bind-homes-and-replay-in-distinct-environments
 (let [root (str (System/tmp_dir!) "/realm-package-" (erlang/unique_integer (list :positive)))
       source (str root "/src") file (str source "/rp/fixture.bl") entry (str root "/main.bl")
       program "(ns rp.entry (:require [rp.fixture]))"
       text "(ns rp.fixture) (def setting (System/get_env \"REALM_PACKAGE_VALUE\")) (defn answer [] setting)"
       key-a (str "PackageA" (erlang/unique_integer (list :positive)))
       key-b (str "PackageB" (erlang/unique_integer (list :positive)))
       out-a (str root "/a") out-b (str root "/b")
       old (System/get_env "REALM_PACKAGE_VALUE") old-repair (System/get_env "BEAM_LISP_AOT_REPAIR")
       paths (code/get_path)]
  (try
   (File/mkdir_p! (Path/dirname file)) (File/write! file text) (File/write! entry program)
   (BeamLisp.Loader/with_search_dir source (fn []
    (let [a (realm-run key-a (fn [] (package/build! entry out-a [])))
          b (realm-run key-b (fn [] (package/build! entry out-b [])))]
     (is (= 2 (:format a))) (is (= 2 (:format b)))
     (is (= :all (:caps a)))
     (let [restricted (vmc/spawn-vm {:id "package-caps-probe" :key key-a :decl {:shadow [] :uses {}} :caps []})]
      (try (vmc/run restricted (fn [] (is (refused? (fn [] (package/install! out-a program []))))))
       (finally (vmc/drain restricted))))
     (is (= ["rp.fixture"] (:artifacts a)))
     (is (not= (:local-modules a) (:local-modules b)))
     (is (not (BeamLisp.Env/loaded_ns? "rp.fixture")))
     (is (refused? (fn [] (package/install! out-a program []))))
     (realm-run key-b (fn [] (is (refused? (fn [] (package/install! out-a program []))))))
     (File/write! file (str text "\n(def changed 1)"))
     (realm-run key-a (fn [] (is (refused? (fn [] (package/install! out-a program []))))))
     (File/write! file text)
     ;; Installing must not alter the global code path. Loading still takes
     ;; the package path with repair disabled, rather than masking a miss by AOT.
     (System/put_env "BEAM_LISP_AOT_REPAIR" "off")
     (doseq [[key output value] [[key-a out-a "first"] [key-a out-a "second"] [key-b out-b "other-realm"]]]
      (System/put_env "REALM_PACKAGE_VALUE" value)
      (realm-run key (fn []
       (package/install! output program [])
       (is (= paths (code/get_path)))
       (BeamLisp.Loader/ensure_loaded "rp.fixture")
       (is (= value (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! "rp.fixture" "answer") (list))))
       (let [module (BeamLisp.Emit/module_for "rp.fixture")
             expected (elem (elem (beam_lib/md5 (File/read! (str output "/ebin/" (Atom/to_string module) ".beam"))) 1) 1)]
        (is (= expected (erlang/apply module :module_info (list :md5))))))))
     ;; The immutable source copy remains usable without a live project file.
     (File/rm! file)
     (realm-run key-a (fn []
      (BeamLisp.AOT/with_source_snapshot (fn []
       (is (nil? (BeamLisp.AOT/ns_closure_hash "rp.fixture")))
       (let [installed (package/install! out-a program [])]
        (is (= (get (:closures installed) "rp.fixture") (BeamLisp.AOT/ns_closure_hash "rp.fixture"))))))
      (BeamLisp.Loader/ensure_loaded "rp.fixture")
      (is (= "other-realm" (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! "rp.fixture" "answer") (list))))
      (is (= (str out-a "/source/rp/fixture.bl") (BeamLisp.Loader/source_path "rp.fixture")))))
     (is (= paths (code/get_path)))
     (doseq [[key manifest] [[key-a a] [key-b b]]]
      (let [project (vmc/spawn-vm {:id (str "package-retirement@" key) :root root
                                 :key key :alias key :decl {:shadow [] :uses {}}})
            modules (map (fn [name] (String/to_atom name)) (mapcat second (:local-modules manifest)))]
       (try
        (vmc/drain project)
        (doseq [module modules]
         (is (= false (code/is_loaded module)))
         (is (not (erlang/check_old_code module))))
        ;; Drain is idempotent; also clean up when retirement assertions fail.
        (finally (vmc/drain project))))))))
   (finally
    (if old (System/put_env "REALM_PACKAGE_VALUE" old) (System/delete_env "REALM_PACKAGE_VALUE"))
    (if old-repair (System/put_env "BEAM_LISP_AOT_REPAIR" old-repair) (System/delete_env "BEAM_LISP_AOT_REPAIR"))
    (File/rm_rf! root)))))

(release-test realm-package-provider-and-artifact-tampering-refuse-before-replay
 (let [root (str (System/tmp_dir!) "/realm-package-fence-" (erlang/unique_integer (list :positive)))
       source (str root "/src") file (str source "/rpf/fixture.bl") entry (str root "/entry.bl")
       program "(ns rpf.entry (:require [rpf.fixture]))" output (str root "/release")
       key (str "Fence" (erlang/unique_integer (list :positive)))]
  (try
   (File/mkdir_p! (Path/dirname file)) (File/write! entry program)
   (File/write! file "(ns rpf.fixture) (defn answer [] 42)")
   (BeamLisp.Loader/with_search_dir source (fn []
    (realm-run key (fn [] (package/build! entry output [])))
    (realm-run key (fn []
     (package/install! output program [])
     (BeamLisp.Env/put_key (tuple :realm_decl) {:shadow [] :uses {"other" "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}})
     (is (refused? (fn [] (BeamLisp.Loader/ensure_loaded "rpf.fixture"))))))
    (realm-run key (fn []
     (package/install! output program [])
     (let [original (BeamLisp.Env/with_env :global (fn [] (BeamLisp.Env/fetch! "compiler" "mod-num")))]
      (try
       (BeamLisp.Env/with_env :global (fn [] (BeamLisp.Env/intern "compiler" "mod-num" :untrusted_numeric_provider)))
       (is (refused? (fn [] (BeamLisp.Loader/ensure_loaded "rpf.fixture"))))
       (is (not (BeamLisp.Env/loaded_ns? "rpf.fixture")))
       (finally (BeamLisp.Env/with_env :global (fn [] (BeamLisp.Env/intern "compiler" "mod-num" original))))))))
    (realm-run key (fn []
     (let [manifest (package/install! output program [])
           module (first (get (:local-modules manifest) "rpf.fixture"))
           path (str output "/ebin/" module ".beam") bytes (File/read! path)]
      (try
       (File/write! path (str bytes "tamper"))
       (is (refused? (fn [] (BeamLisp.Loader/ensure_loaded "rpf.fixture"))))
       (is (not (BeamLisp.Env/loaded_ns? "rpf.fixture")))
       (finally (File/write! path bytes))))))))
   (finally (File/rm_rf! root)))))

(release-test realm-package-replays-code-and-source-effects-in-fresh-vms
 (let [root (str (System/tmp_dir!) "/realm-package-child-" (erlang/unique_integer (list :positive)))
       source (str root "/src") entry (str root "/entry.bl") output (str root "/release")
       consumer (str root "/consumer.bl") marker (str root "/effect")
       key (str "Fresh" (erlang/unique_integer (list :positive)))
       program "(ns rpc.entry (:require [rpc.leaf]))"]
  (try
   (File/mkdir_p! (str source "/rpc")) (File/write! entry program)
   (File/write! (str source "/rpc/effect.bl")
    (str "(ns rpc.effect) (File/write! " (pr-str marker) " \"ran\") (def ready true)"))
   (File/write! (str source "/rpc/leaf.bl")
    "(ns rpc.leaf (:require [rpc.effect])) (def setting (System/get_env \"REALM_CHILD_VALUE\")) (defn answer [] setting)")
   (BeamLisp.Loader/with_search_dir source (fn []
    (let [built (realm-run key (fn [] (package/build! entry output [])))]
     (is (= ["rpc.leaf"] (:artifacts built)))
     (is (= ["rpc.effect"] (:source-fallback built))))))
   (File/write! consumer
    (str "(ns rpc.consumer (:require [application.package])) "
     "(let [e (BeamLisp.Env/fork (BeamLisp.Env/env_id))] (try (BeamLisp.Env/with_env e (fn [] "
     "(BeamLisp.Env/put_key (tuple :realm_key) " (pr-str key) ") "
     "(BeamLisp.Env/put_key (tuple :realm_decl) {:shadow [] :uses {}}) "
     "(application.package/install! " (pr-str output) " " (pr-str program) " []) "
     "(BeamLisp.Loader/ensure_loaded \"rpc.leaf\") "
     "(assert (= (System/get_env \"REALM_CHILD_VALUE\") (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! \"rpc.leaf\" \"answer\") (list)))) "
     "(assert (= \"ran\" (File/read! " (pr-str marker) "))) "
     "(assert (String/starts_with? (erlang/list_to_binary (code/which (BeamLisp.Emit/module_for \"rpc.leaf\"))) "
     (pr-str (str output "/ebin/")) ")) (println \"REALM_CHILD_OK\"))) "
     "(finally (BeamLisp.Env/destroy e))))"))
   (doseq [value ["fresh-a" "fresh-b"]]
    (File/rm marker)
    (let [[text status] (System/cmd
      (Path/expand "bin/bl" (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd)))
      (list "run" consumer) (list (tuple :stderr_to_stdout true)
       (tuple :env (list (tuple "BL_DAEMON" "off") (tuple "BEAM_LISP_AOT_REPAIR" "off")
                        (tuple "REALM_CHILD_VALUE" value)))))]
     (is (= 0 status) text) (is (String/contains? text "REALM_CHILD_OK") text)))
   (finally (File/rm_rf! root)))))

(release-test package-compiler-authority-binds-live-callables
 ;; Trusted companion loading mirrors release preparation. A canonical runtime
 ;; operator closure is portable; an application closure carrying a ref is not.
 (doseq [n ["sugar" "compiler" "lower" "anf"]]
  (is (Code/ensure_loaded? (Module/concat (list :Elixir.BeamLisp.Ns.Body (Macro/camelize n))))))
 (let [baseline (BeamLisp.AOT/local_package_authority)]
  (is (string? baseline))
  (doseq [[namespace name] [["compiler" "compile-node"] ["core" "+"] ["sugar" "cond->"]]]
   (let [original (BeamLisp.Env/with_env :global (fn [] (BeamLisp.Env/fetch! namespace name)))
         token (erlang/make_ref) replacement (fn [] token)]
    (try
     (BeamLisp.Env/with_env :global (fn [] (BeamLisp.Env/intern namespace name replacement)))
     (is (nil? (BeamLisp.AOT/local_package_authority)))
     (finally (BeamLisp.Env/with_env :global (fn [] (BeamLisp.Env/intern namespace name original)))))))
  (is (= baseline (BeamLisp.AOT/local_package_authority)))))

(release-test package-compiler-authority-binds-transitive-support-fetches
 (doseq [n ["sugar" "compiler" "lower" "anf"]]
  (is (Code/ensure_loaded? (Module/concat (list :Elixir.BeamLisp.Ns.Body (Macro/camelize n))))))
 (let [baseline (BeamLisp.AOT/local_package_authority)
       original (BeamLisp.Env/with_env :global (fn [] (BeamLisp.Env/fetch! "core" "list")))
       declaration (BeamLisp.Env/lookup (tuple :refer "compiler" "list"))]
  (is (string? baseline))
  ;; compile-each passes list as a VALUE to apply. Its direct-call link and
  ;; compiler Body MD5 remain unchanged when this value is replaced.
  (try
   (BeamLisp.Env/with_env :global (fn [] (BeamLisp.Env/intern "core" "list" :invalid_list_callable)))
   (is (not= baseline (BeamLisp.AOT/local_package_authority)))
   (finally (BeamLisp.Env/with_env :global (fn [] (BeamLisp.Env/intern "core" "list" original)))))
  (is (= baseline (BeamLisp.AOT/local_package_authority)))
  ;; Even redirecting to the SAME provider must bind the changed declaration;
  ;; own stage bindings and the fetched callable are otherwise identical.
  (try
   (BeamLisp.Env/with_env :global (fn [] (BeamLisp.Env/add_refer "compiler" "list" "core")))
   (is (not= baseline (BeamLisp.AOT/local_package_authority)))
   (finally
    (BeamLisp.Env/with_env :global
     (fn []
      (if (= :error declaration)
       (BeamLisp.Env/delete_key (tuple :refer "compiler" "list"))
       (BeamLisp.Env/put_key (tuple :refer "compiler" "list") (elem declaration 1)))))))
  (is (= baseline (BeamLisp.AOT/local_package_authority)))))

(release-test package-compiler-authority-memo-is-bounded-and-ignores-unrelated-init
 (doseq [n ["sugar" "compiler" "lower" "anf"]]
  (is (Code/ensure_loaded? (Module/concat (list :Elixir.BeamLisp.Ns.Body (Macro/camelize n))))))
 (let [key (tuple :Elixir.BeamLisp.AOT :package_authority_memo)
       baseline (BeamLisp.AOT/local_package_authority)
       memo (Process/get key)
       environment (BeamLisp.Env/fork :global)]
  (is (string? baseline))
  (is (= baseline (BeamLisp.AOT/local_package_authority)))
  (is (= memo (Process/get key)))
  (try
   (BeamLisp.Env/intern "authority.unrelated" "initialized" true)
   (is (= baseline (BeamLisp.AOT/local_package_authority)))
   ;; The recorded miss epoch remains identical: this was an actual hit,
   ;; despite the global publication epoch changing during application init.
   (is (= (:projection_epoch memo) (:projection_epoch (Process/get key))))
   (BeamLisp.Env/with_env environment
    (fn []
     (is (= baseline (BeamLisp.AOT/local_package_authority)))
     (is (= environment (:env (Process/get key))))
     (is (= (:projection_epoch memo) (:projection_epoch (Process/get key)))
         "Empty forks reuse the exact checked compiler projection")))
   (BeamLisp.Env/destroy environment)
   (is (nil? (BeamLisp.Env/with_env environment (fn [] (BeamLisp.AOT/local_package_authority)))))
   (is (nil? (Process/get key)))
   (is (= baseline (BeamLisp.AOT/local_package_authority)))
   (finally
    (BeamLisp.Env/destroy environment)
    (BeamLisp.Env/delete_key (tuple "authority.unrelated" "initialized"))))))

(release-test package-compiler-authority-memo-binds-alias-and-literal-overrides
 (doseq [n ["sugar" "compiler" "lower" "anf"]]
  (is (Code/ensure_loaded? (Module/concat (list :Elixir.BeamLisp.Ns.Body (Macro/camelize n))))))
 (let [baseline (BeamLisp.AOT/local_package_authority)
       original (BeamLisp.Env/lookup (tuple "compiler" "mod-num"))
       alias (BeamLisp.Env/lookup (tuple :alias "compiler" "list"))]
  (is (string? baseline))
  (try
   (BeamLisp.Env/with_env :global (fn [] (BeamLisp.Env/intern "compiler" "mod-num" :invalid_numeric_provider)))
   (is (not= baseline (BeamLisp.AOT/local_package_authority)))
   (finally (BeamLisp.Env/with_env :global (fn [] (BeamLisp.Env/intern "compiler" "mod-num" (elem original 1))))))
  (is (= baseline (BeamLisp.AOT/local_package_authority)))
  (try
   (BeamLisp.Env/with_env :global (fn [] (BeamLisp.Env/add_alias "compiler" "list" "core")))
   (is (not= baseline (BeamLisp.AOT/local_package_authority)))
   (finally
    (BeamLisp.Env/with_env :global
     (fn []
      (if (= :error alias)
       (BeamLisp.Env/delete_key (tuple :alias "compiler" "list"))
       (BeamLisp.Env/put_key (tuple :alias "compiler" "list") (elem alias 1)))))))
  (is (= baseline (BeamLisp.AOT/local_package_authority)))))

(release-test package-compiler-authority-memo-checks-backing-module-bytes
 (doseq [n ["sugar" "compiler" "lower" "anf" "reader-node"]]
  (is (Code/ensure_loaded? (Module/concat (list :Elixir.BeamLisp.Ns.Body (Macro/camelize n))))))
 (let [baseline (BeamLisp.AOT/local_package_authority)
       body :"Elixir.BeamLisp.Ns.Body.Reader-node"
       original (code/get_object_code body)
       forms (list (tuple :attribute 1 :module body)
                   (tuple :attribute 1 :export (list (tuple :support_marker 0)))
                   (tuple :function 1 :support_marker 0
                     (list (tuple :clause 1 (list) (list) (list (tuple :atom 1 :changed))))))
       compiled (compile/forms forms (list :binary :return))]
  (is (string? baseline))
  (is (= body (elem original 0)))
  (is (= :ok (elem compiled 0)))
  ;; No Env binding changes: physical executable evidence alone invalidates.
  ;; Restore before returning, even when recertification deliberately declines
  ;; the reduced fixture ABI instead of producing a different certificate.
  (let [published (try
                   (BeamLisp.Env/publish_binaries! (list (tuple body (elem compiled 2))) "authority-module-fixture")
                   true
                   (catch error
                    (if (= :sdk_runtime_replacement_requires_handover (Map/get error :original)) false
                     (throw error))))]
   (if published
    (try
     (is (not= baseline (BeamLisp.AOT/local_package_authority)))
     (finally (BeamLisp.Env/publish_binaries! (list (tuple body (elem original 1))) (erlang/list_to_binary (elem original 2)))))
    ;; A sealed SDK's lifetime pin must refuse physical replacement. Its exact
    ;; executable and certificate stay unchanged; mutable-image coverage above
    ;; still requires invalidation when publication is permitted.
    (do (is (= (elem (elem (beam_lib/md5 (elem original 1)) 1) 1)
               (erlang/apply body :module_info (list :md5))))
        (is (= baseline (BeamLisp.AOT/local_package_authority))))))
  (is (= baseline (BeamLisp.AOT/local_package_authority)))))

(release-test compiler-authority-admits-canonical-dotted-support-modules
 (BeamLisp.Env/with_env :global (fn [] (BeamLisp.Loader/ensure_loaded "clojure.core-ext")))
 (is (Code/ensure_loaded? :"Elixir.BeamLisp.Ns.Body.Clojure.Core-ext"))
 (is (string? (BeamLisp.AOT/local_package_authority)))
 (realm-run "DottedSupportProof"
  (fn [] (is (string? (BeamLisp.AOT/local_package_authority))))))
