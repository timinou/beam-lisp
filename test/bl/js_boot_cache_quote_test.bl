(ns bl.js.boot-cache-quote-test (:require [bl.js :as js]))

(deftest preload-source-is-not-display-truncated
  (when (System/find_executable "node")
    (let [root (str (System/tmp_dir!) "/bl-cache-quote-" (System/unique_integer (list :positive)))
          source (str "; " (apply str (repeat 6000 "x")) " quoted \"text\" \\ unicode é\n(ns cache.long)\n(def answer 42)\n")]
      (File/mkdir_p! (str root "/cache"))
      (try
        (File/write! (str root "/cache/long.bl") source)
        (BeamLisp.Env/add_search_path root)
        (BeamLisp.Loader/ensure_loaded "cache.long")
        (File/write! (str root "/leaves.mjs") "export const run=()=>{};\n")
        (File/write! (str root "/boot.mjs") "export async function capture(read,preloads){return preloads[0][2];}\n")
        ((BeamLisp.Env/fetch! "bl.js" "write-boot-cache!") root ["cache.long"])
        (is (= source (File/read! (str root "/boot-cache.mjs"))))
        (finally (File/rm_rf! root))))))
