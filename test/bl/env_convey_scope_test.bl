(ns env.convey-scope-test (:require [env] [diagnostics :as diag]))
(defn action [fails?]
 (diag/with-options {:sink (fn [_] nil)}
  (diag/with-context {:diagnostics/operation-id "caller-scope"}
   (env/convey (fn [x]
                 (assert (= "caller-scope" (:diagnostics/operation-id (diag/context))))
                 (if fails? (throw "scope fixture") x))))))

(deftest conveyed-actions-restore-the-workers-registered-context
 (let [ok (action false) bad (action true)]
  (diag/with-options {:sink (fn [_] nil)}
   (diag/with-context {:diagnostics/operation-id "worker-scope"}
    (let [before (env/capture)]
     (is (= :value (erlang/apply ok (list :value))))
     (is (= "worker-scope" (:diagnostics/operation-id (diag/context))))
     (is (= before (env/capture)))
     (try (erlang/apply bad (list :value)) (catch _ nil))
     (is (= "worker-scope" (:diagnostics/operation-id (diag/context))))
     (is (= before (env/capture))))))))

(deftest reusable-agents-do-not-retain-a-callers-diagnostics-sink
 (let [agent (elem (Agent/start (fn [] :state)) 1) f (action false)]
  (try
   (is (= :state (Agent/get agent f)))
   (is (= :undefined (Agent/get agent (fn [_] (erlang/get :bl_diagnostics)))))
   (finally (Agent/stop agent :normal 30000)))))
