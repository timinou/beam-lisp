; host_aot_test.bl — the pinned `BeamLisp.AOT` facade.
;
; `priv/host/aot.bl` ports `lib/beam_lisp/aot.ex` to ONE exact-named beam.
; The live Elixir module is still the ground truth here, so this suite is
; DIFFERENTIAL: the same questions run through the pinned probe and through
; `Elixir.BeamLisp.AOT`, and the two answer sets must be equal.
;
; WHAT IS PINNED, AND HOW.
;
;   * THE EXPORT SURFACE. `AOT`'s live PUBLIC surface is `compile_file/1,2`,
;     `compile_source/1,2`, `compile_host_file/1,2`, `ensure_loaded/1`,
;     `boot/0`, `ns_closure_hash/1,2`, `beam_provenance/1` and
;     `default_output_dir/0`; every one is present at its exact name and
;     arity, and each is DIFFED against the live module.
;
;   * BYTE PARITY OF THE EMIT PATH. The private machinery (the form walkers,
;     the validator family, `host_attrs`, `retarget_host`, `struct_clauses`,
;     `host_info_clauses`, `write_beam`, `emit_module`, `build_init_ast`) is
;     verified the only way a caller can see it: by COMPILING, through both
;     modules, the same fixtures — plain defns, multi-clause defns, a struct
;     module, a macro module, a behaviour module — and requiring the emitted
;     beams to be byte-identical. The REFUSALS (value defs, two namespaces, no
;     functions, a bad field default, a bad module name) are compared as class
;     AND message.
;
;   * THE PINNED HELPERS the live module keeps PRIVATE cannot be called on the
;     live module at all (`apply/3` refuses a private function), so they are
;     pinned by LITERAL expectation against the Elixir source's own answer —
;     the same move `host_compiler_test.bl` makes for a raise it cannot
;     trigger. Byte parity is what proves they agree with the live module on
;     the real paths; these literals name the shapes.
;
;   * THE PINNED BEAM RUNS ALONE. The namespace shim the compile built beside
;     the pinned beam is DELETED before any call, so a body that still leaned
;     on the shim would be `undef` here — the pin's whole point.
;
; Run: bin/bl test test/bl/host_aot_test.bl

(ns host.aot.test)

(defn- t2 [k v] (erlang/list_to_tuple (list k v)))

(defn- tmp-dir []
  (str (System/tmp_dir!) "/bl_host_aot_" (erlang/unique_integer (list :positive))))

(defn- aot-source [] (Path/join (BeamLisp/cwd) "priv/host/aot.bl"))

(def ^:private probe :Elixir.BeamLisp.HostAotProbe)
(def ^:private live :Elixir.BeamLisp.AOT)

(defn- shim [] (BeamLisp.Emit/module_for "host.aot"))

(defn- drop! [mod]
  (do (code/purge mod) (code/delete mod) :ok))

(defn- load-pinned [mod path]
  (drop! mod)
  (code/load_binary mod (erlang/binary_to_list path) (File/read! path))
  mod)

; Compile the pinned source at `mod` and publish ONLY the pinned beam: the
; compile's own load (and the namespace shim it built beside it) is dropped.
; The compile EVALUATES the source, whose `(ns host.aot)` form switches the
; current namespace — so the caller's ns is restored around it.
(defn- compile-pinned [mod dir]
  (BeamLisp.Env/with_ns (BeamLisp.Env/current_ns)
    (fn []
      (let [res (BeamLisp.AOT/compile_host_file (aot-source)
                  (list (t2 :module mod) (t2 :output_dir dir) (t2 :load? false)))]
        (load-pinned mod (elem res 1))))))

; ── the observation: a call's whole answer, a raise's class included ────────

(defn- answer
  "`[:value v]` or `[:raise Class Message]`. Both are ABI a caller reads."
  [mod fname args]
  (try (list :value (erlang/apply mod fname args))
       (catch e (list :raise (:__struct__ e) (:message e)))))

(defn- answers [mod qs]
  (map (fn [q] (list (first q) (answer mod (first q) (second q)))) qs))

(defn- raise-class [f]
  (try (do (f) :no-raise) (catch e (:__struct__ e))))

(defn- raise-message [f]
  (try (do (f) :no-raise) (catch e (:message e))))

; ── fixtures ───────────────────────────────────────────────────────────────

(defn- write-fixture [dir name content]
  (let [p (Path/join dir name)]
    (File/write! p content)
    p))

(defn- read-beams [pairs]
  (map (fn [p] (File/read! (elem p 1))) pairs))

(defn- host-opts [mod dir file extra]
  (erlang/++ (list (t2 :module mod) (t2 :output_dir dir) (t2 :file file) (t2 :load? false)) extra))

(defn- run-host
  "Run `compile_host_file/2` through `impl` and describe the OUTCOME: the
   emitted beam BYTES, or the raise's class and message. `load? false` means
   the live module's own beam is never replaced mid-run."
  [impl dir file opts]
  (BeamLisp.Env/with_ns (BeamLisp.Env/current_ns)
    (fn []
      (try
        (let [res (erlang/apply impl :compile_host_file (list file opts))]
          (tuple :ok (File/read! (elem res 1))))
        (catch e (tuple :raise (:__struct__ e) (:message e)))))))

(defn- parity
  "The same fixture through both modules, into SEPARATE output dirs. Answers
   `:same` when the emitted bytes match, or when both raise the same class and
   message; otherwise the two outcomes, for the failure message."
  [dir file mod extra]
  (let [ldir (Path/join dir "live")
        pdir (Path/join dir "probe")
        lo (run-host live ldir file (host-opts mod ldir file extra))
        po (run-host probe pdir file (host-opts mod pdir file extra))]
    (cond
      (and (erlang/== :ok (elem lo 0)) (erlang/== :ok (elem po 0)))
        (if (erlang/== (elem lo 1) (elem po 1)) :same (tuple :bytes-differ lo po))
      (erlang/== lo po) :same
      :else (tuple :outcome-differ lo po))))

; ── the live public surface, diffed ────────────────────────────────────────

(defn- public-queries []
  (list
    (list :beam_provenance (list :Elixir.BeamLisp.Emit))
    (list :beam_provenance (list :Elixir.BeamLisp.AOT))
    (list :beam_provenance (list :Elixir.BeamLisp.NoSuchModule))
    (list :beam_provenance (list :Elixir.BeamLisp.Ns.Body.Core))
    (list :ns_closure_hash (list "core"))
    (list :ns_closure_hash (list "compiler"))
    (list :ns_closure_hash (list "no.such.ns.at.all"))
    (list :ns_closure_hash (list "core" "priv/boot/core.bl"))
    (list :default_output_dir (list))
    (list :boot (list))
    (list :ensure_loaded (list "core"))
    (list :ensure_loaded (list "no.such.ns.at.all"))))

(deftest pinned-aot-matches-the-live-facade
  (testing "the public ABI, answer for answer"
    (let [dir (tmp-dir)]
      (compile-pinned probe dir)
      (drop! (shim))
      (is (= :non_existing (erlang/apply :code :which (list (shim)))))
      (is (not (erlang/function_exported probe :__struct__ 0)))
      (is (not (erlang/function_exported probe :__info__ 1)))
      (is (every? (fn [e] (erlang/function_exported probe (elem e 0) (elem e 1)))
                  (list (t2 :compile_file 1) (t2 :compile_file 2)
                        (t2 :compile_source 1) (t2 :compile_source 2)
                        (t2 :compile_host_file 1) (t2 :compile_host_file 2)
                        (t2 :ensure_loaded 1) (t2 :boot 0)
                        (t2 :ns_closure_hash 1) (t2 :ns_closure_hash 2)
                        (t2 :beam_provenance 1) (t2 :default_output_dir 0)))
          "every live public export is present at its exact name and arity")
      (let [qs (public-queries)]
        (is (= (answers live qs) (answers probe qs)))
        (doseq [q qs]
          (is (= (answer live (first q) (second q))
                 (answer probe (first q) (second q)))
              (str "AOT " (first q)))))
      (File/rm_rf! dir))))

; ── the emit path: byte parity through both modules ────────────────────────

(defn- byte-parity-fixtures
  "`[name source extra-opts module]` — one row per pinned-host shape the seed
   builds. `module` is the pinned atom the fixture is compiled to."
  [dir]
  (list
    (list "plain"
          (write-fixture dir "plain.bl"
            "(ns host.aot.fx.plain)\n(defn greet [name] name)\n(defn add2 [a b] (erlang/+ a b))\n")
          (list) :Elixir.Aot.Fx.Plain)
    (list "multi"
          (write-fixture dir "multi.bl"
            "(ns host.aot.fx.multi)\n(defn size-of ([x] :when (string? x) (erlang/byte_size x)) ([x] :when (list? x) (erlang/length x)) ([x] :else 0))\n")
          (list) :Elixir.Aot.Fx.Multi)
    (list "struct"
          (write-fixture dir "struct.bl"
            "(ns host.aot.fx.struct)\n(defn noop [] :ok)\n")
          (list (t2 :struct_fields (list (t2 :a 1) (t2 :b nil)))) :Elixir.Aot.Fx.Struct)
    (list "macro"
          (write-fixture dir "macro.bl"
            "(ns host.aot.fx.mac)\n(defn MACRO-mm [env x] x)\n(defn win [x] x)\n")
          (list (t2 :macro_exports (list (t2 :mm 1)))) :Elixir.Aot.Fx.Mac)
    (list "behaviour"
          (write-fixture dir "beh.bl"
            "(ns host.aot.fx.beh)\n(defn init [x] x)\n")
          (list (t2 :behaviour :Elixir.GenServer)) :Elixir.Aot.Fx.Beh)
    (list "require"
          (write-fixture dir "req.bl"
            "(ns host.aot.fx.req (:require [core :as c] [compiler]))\n(defn f [] :ok)\n(defn- g [] 1)\n")
          (list) :Elixir.Aot.Fx.Req)))

(deftest pinned-aot-emits-byte-identical-host-beams
  (testing "the whole pinned-host emit path, diffed by its output"
    (let [dir (tmp-dir)]
      (compile-pinned probe dir)
      (drop! (shim))
      (doseq [row (byte-parity-fixtures dir)]
        (is (erlang/== :same
              (parity dir (second row) (Enum/at row 3) (Enum/at row 2)))
            (str "the " (first row) " fixture is byte-identical")))

      (testing "the REFUSALS raise the same class and message in both"
        (let [vals (write-fixture dir "vals.bl"
                     "(ns host.aot.fx.vals)\n(def answer 42)\n(defn f [] 1)\n")
              two (write-fixture dir "two.bl"
                    "(ns host.aot.fx.a)\n(defn f [] 1)\n(ns host.aot.fx.b)\n(defn g [] 2)\n")
              none (write-fixture dir "none.bl"
                     "(ns host.aot.fx.none)\n(comment \"x\")\n")
              bad-field (write-fixture dir "badfield.bl"
                          "(ns host.aot.fx.bf)\n(defn f [] 1)\n")
              bad-module (write-fixture dir "badmod.bl"
                           "(ns host.aot.fx.bm)\n(defn f [] 1)\n")]
          (is (erlang/== :same (parity dir vals :Elixir.Aot.Fx.V (list)))
              "value definitions refuse identically")
          (is (erlang/== :same (parity dir two :Elixir.Aot.Fx.T (list)))
              "two namespaces refuse identically")
          (is (erlang/== :same (parity dir none :Elixir.Aot.Fx.N (list)))
              "a file with no functions refuses identically")
          (is (erlang/== :same
                (parity dir bad-field :Elixir.Aot.Fx.BF
                        (list (t2 :struct_fields (list (t2 :a (fn [] 1)))))))
              "a non-literal struct default refuses identically")
          (is (erlang/== :same (parity dir bad-module :Elixir.BeamLisp.Ns.Bad (list)))
              "a colliding module name refuses identically")
          (is (erlang/== :same (parity dir bad-module "not-an-atom" (list)))
              "a non-atom module name refuses identically")
          (is (= (tuple :raise :Elixir.ArgumentError
                        "pinned host module source must define functions in exactly one namespace, got: [\"host.aot.fx.a\", \"host.aot.fx.b\"]")
                 (run-host live (Path/join dir "t1") two
                           (host-opts :Elixir.Aot.Fx.T (Path/join dir "t1") two (list))))
              "the refusal names both namespaces")))
      (File/rm_rf! dir))))

; ── the namespace emitter: byte parity through both modules ────────────────

(deftest pinned-aot-emits-byte-identical-namespace-beams
  (testing "`compile_source/2` through the pinned module matches the live one"
    (let [dir (tmp-dir)]
      (compile-pinned probe dir)
      (drop! (shim))
      (let [src "(ns host.aot.nsfx.diff)\n(defn inc2 [x] (erlang/+ x 2))\n(def answer 7)\n(defn greet [n] (str \"hi \" n))\n"
            file (write-fixture dir "nsfx.bl" src)
            ldir (Path/join dir "live")
            pdir (Path/join dir "probe")
            live-out (BeamLisp.Env/with_ns (BeamLisp.Env/current_ns)
                        (fn [] (erlang/apply live :compile_source
                                 (list src (list (t2 :output_dir ldir) (t2 :file file))))))
            probe-out (BeamLisp.Env/with_ns (BeamLisp.Env/current_ns)
                         (fn [] (erlang/apply probe :compile_source
                                  (list src (list (t2 :output_dir pdir) (t2 :file file))))))]
        (is (= (map (fn [p] (elem p 0)) live-out) (map (fn [p] (elem p 0)) probe-out))
            "the same modules are emitted")
        (is (= (read-beams live-out) (read-beams probe-out))
            "the namespace shim, body and init beams are byte-identical"))
      (File/rm_rf! dir))))

; ── the private helpers, pinned by literal ─────────────────────────────────

(deftest pinned-aot-helpers-answer-exactly
  (testing "the helpers the live module keeps private, pinned by literal"
    (let [dir (tmp-dir)]
      (compile-pinned probe dir)
      (drop! (shim))
      (is (= "<none>" (erlang/apply probe :short (list nil))))
      (is (= "abcdefghijkl" (erlang/apply probe :short (list "abcdefghijklmnop"))))
      (is (= false (erlang/apply probe :strict_aot? (list))))

      (is (= :Elixir.Aot.Ok (erlang/apply probe :validate_host_module! (list :Elixir.Aot.Ok))))
      (is (= :Elixir.ArgumentError
             (raise-class (fn [] (erlang/apply probe :validate_host_module! (list nil))))))
      (is (= "pinned host module name nil is reserved"
             (raise-message (fn [] (erlang/apply probe :validate_host_module! (list nil))))))
      (is (= "pinned host module name must be an atom, got: \"s\""
             (raise-message (fn [] (erlang/apply probe :validate_host_module! (list "s"))))))

      (is (= "only"
             (erlang/apply probe :pinned_namespace! (list {"only" (MapSet/new (list "f"))}))))
      (is (= "pinned host module source defines no functions in any namespace"
             (raise-message (fn [] (erlang/apply probe :pinned_namespace! (list {}))))))

      (is (= true (erlang/apply probe :literal_data? (list 1))))
      (is (= true (erlang/apply probe :literal_data? (list (list 1 2)))))
      (is (= true (erlang/apply probe :literal_data? (list {:a 1}))))
      (is (= false (erlang/apply probe :literal_data? (list (fn [] 1)))))
      (is (= false (erlang/apply probe :literal_data? (list (list 1 (fn [] 1))))))

      (is (= true (erlang/apply probe :macro_clause? (list {:fname :"MACRO-foo"}))))
      (is (= false (erlang/apply probe :macro_clause? (list {:fname :foo}))))

      (is (= {:op :lit :val 5 :ann {}} (erlang/apply probe :anf_lit (list 5))))
      (is (= {:op :var :name "x" :ann {}} (erlang/apply probe :anf_var (list "x"))))
      (is (= {:pop :pvar :name "x"} (erlang/apply probe :anf_pvar (list "x"))))
      (is (= {:op :"defn-clause" :fname :__info__ :params (list {:pop :plit :val :module})
              :guard nil :body {:op :lit :val :Elixir.M :ann {}} :ann {}}
             (erlang/apply probe :info_clause (list :module :Elixir.M))))

      (is (= (list (list :behaviour :Elixir.WebSock))
             (erlang/apply probe :host_attrs (list (list (t2 :behaviour :Elixir.WebSock))))))
      (is (= (list)
             (erlang/apply probe :host_attrs (list (list (t2 :struct_fields (list (t2 :a 1))))))))

      (is (= (list (tuple :a 1) (tuple :b nil))
             (erlang/apply probe :validate_struct_fields!
               (list (list (tuple :a 1) (tuple :b nil))))))
      (is (= "cannot set :__struct__ in struct definition"
             (raise-message (fn []
               (erlang/apply probe :validate_struct_fields! (list (list (tuple :__struct__ 1))))))))
      (is (= (list (tuple :m 1))
             (erlang/apply probe :validate_macro_exports!
               (list (list (tuple :m 1))
                     (list {:op :"defn-clause" :fname :"MACRO-m"
                            :params (list {:pop :pvar :name "e"} {:pop :pvar :name "x"})
                            :guard nil :body {} :ann {}})))))

      (is (= {:op :lit :val :S :ann {}}
             (erlang/apply probe :retarget_host (list {:op :lit :val :S :ann {}} :S :T))))
      (is (= :T
             (get (erlang/apply probe :retarget_host
                    (list {:op :remote :mod :S :fun :f :args (list) :ann {}} :S :T))
                  :mod)))

      (is (= :Elixir.BeamLisp.Ns.Init.A.B (erlang/apply probe :init_module_for (list "a.b"))))
      (is (= nil (erlang/apply probe :native_declaration (list "no.such.ns"))))

      ; ── the reader-form walkers, over REAL forms ────────────────────────
      ; A form is read once and handed to the pinned walker; the expected
      ; value is the Elixir source's own answer.
      (let [read1 (fn [src] (first (BeamLisp.Reader/read_string src nil)))
            empty-acc (tuple (list) (list) (list))]
        (is (= "x.y" (erlang/apply probe :ns_decl (list (read1 "(ns x.y)")))))
        (is (= nil (erlang/apply probe :ns_decl (list (read1 "(defn f [] 1)")))))
        (is (= "foo" (erlang/apply probe :defn_name (list (read1 "(defn foo [x] x)")))))
        (is (= "bar" (erlang/apply probe :defn_name (list (read1 "(defn- bar [] 1)")))))
        (is (= nil (erlang/apply probe :defn_name (list (read1 "(def x 1)")))))
        (is (= {"x" (MapSet/new (list "f" "g"))}
               (erlang/apply probe :unit_defns
                 (list (BeamLisp.Reader/read_string "(ns x)\n(defn f [] 1)\n(defn- g [] 2)\n(def h 3)" nil)))))

        (is (= "alpha" (erlang/apply probe :require_target (list (read1 "[alpha :as a]")))))
        (is (= (tuple (list (tuple "a" "alpha")) (list) (list))
               (erlang/apply probe :capture_require_spec (list (read1 "[alpha :as a]") empty-acc))))
        (is (= (tuple (list) (list (tuple "b" "beta") (tuple "c" "beta")) (list))
               (erlang/apply probe :capture_require_spec (list (read1 "[beta :refer [b c]]") empty-acc))))
        (is (= (tuple (list) (list) (list "gamma"))
               (erlang/apply probe :capture_require_spec (list (read1 "[gamma :refer :all]") empty-acc))))
        (is (= {"x" {:aliases (list (tuple "a" "alpha"))
                      :refers (list (tuple "b" "beta") (tuple "c" "beta"))
                      :refer_alls (list "gamma")
                      :requires (list "alpha" "beta" "gamma" "delta")}}
               (erlang/apply probe :capture_ns_decl
                 (list {} (read1 "(ns x (:require [alpha :as a] [beta :refer [b c]] [gamma :refer :all] delta))")))))

        (let [init (read1 "42")
              form (read1 "(def answer 42)")]
          (is (= {"demo" (list (tuple "answer" nil init false))}
                 (erlang/apply probe :capture_value_def (list {} form "demo")))))
        (let [init (read1 "7")
              form (read1 "(def ^:private secret 7)")]
          (is (= {"demo" (list (tuple "secret" nil init false))}
                 (erlang/apply probe :capture_value_def (list {} form "demo")))))
        (let [form (read1 "(defrecord R [a b])")]
          (is (= {"demo" (list (tuple "R" nil form false))}
                 (erlang/apply probe :capture_value_def (list {} form "demo")))))

        (is (= {"n" (list (tuple "v" nil 1 false))}
               (erlang/apply probe :put_value_def (list {} "n" "v" nil 1))))
        (is (= {"n" (list (tuple "v" nil 1 true))}
               (erlang/apply probe :put_value_def (list {} "n" "v" nil 1 (list (tuple :per_env true))))))

        (is (= {:op :map
                :pairs (list (list {:op :lit :val :__struct__ :ann {}} {:op :lit :val :Elixir.M :ann {}})
                             (list {:op :lit :val :a :ann {}} {:op :lit :val 1 :ann {}}))
                :ann {}}
               (erlang/apply probe :struct_default_node (list :Elixir.M (list (tuple :a 1))))))
        (let [r (erlang/apply probe :struct_reducer_node (list))]
          (is (= :fn (get r :op)))
          (is (= 2 (erlang/length (get r :clauses))))))
      (is (= false (erlang/apply probe :tier_key_moved? (list :boot (BeamLisp.AOTCache/compiler_key)))))
      (is (= true (erlang/apply probe :tier_key_moved? (list :boot "not-the-key"))))
      (is (= false (erlang/apply probe :tier_key_moved? (list :build (BeamLisp.AOTCache/build_key)))))

      ; SEED SHAPE: the same source compiles AT THE REAL ATOM with `load? false`,
      ; which is exactly what `priv/build/seed.bl` will ask for.
      (let [res (BeamLisp.Env/with_ns (BeamLisp.Env/current_ns)
                  (fn [] (BeamLisp.AOT/compile_host_file (aot-source)
                            (list (t2 :module :Elixir.BeamLisp.AOT)
                                  (t2 :output_dir (Path/join dir "seed"))
                                  (t2 :source_hash "deadbeef")
                                  (t2 :load? false)))))
            chunks (erlang/element 2
                     (erlang/element 2 (erlang/apply :beam_lib :chunks
                       (list (String/to_charlist (elem res 1)) (list :exports)))))
            exports (elem (first chunks) 1)]
        (is (= :Elixir.BeamLisp.AOT (elem res 0)))
        (is (Enum/member? exports (t2 :compile_host_file 2)))
        (is (Enum/member? exports (t2 :beam_provenance 1))))

      (let [beam (erlang/apply probe :write_beam (list :Elixir.Aot.Diff.Beam "bytes" dir))
            path (elem beam 1)]
        (is (= :Elixir.Aot.Diff.Beam (elem beam 0)))
        (is (= "bytes" (File/read! path)))
        (is (String/ends_with? path "Elixir.Aot.Diff.Beam.beam")))

      (File/rm_rf! dir))))

(run-tests)
