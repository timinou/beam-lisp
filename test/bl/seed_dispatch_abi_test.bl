; test/bl/seed_dispatch_abi_test.bl — test.seed-dispatch-abi.
;
; Split from test/bl/seed_test.bl so each file stays under the runner's 300 s
; per-file bound. Shared helpers live in test.bl.seed-support.

(ns test.seed-dispatch-abi
  (:require [seed] [test.bl.seed-support :as s]))

(deftest the-multi-publishes-the-open-dispatch-public-surface
  ;; `Elixir.BeamLisp.Multi` is the runtime engine for OPEN DISPATCH — the
  ;; multimethods and protocols the language's `defmulti`/`defmethod` and
  ;; `defprotocol`/`extend-type`/`deftype` lower to and dispatch through — so
  ;; the floor must publish the engine's whole public surface at that atom. The
  ;; mapping is functions-only — no `:struct-fields`, no `:behaviour`, no
  ;; `:macro-exports` — and the published beam is judged from its own export
  ;; chunk, from the REAL source, against the live module's callables minus
  ;; Elixir's own `__info__/1`, which a pinned functions-only beam does not
  ;; carry. The pinned source inlines the live module's `defn-` helpers
  ;; (`multi!`/`no_method_error`/`walk_ancestors`/`protocol!`) as LOCAL
  ;; closures, so the export list is the live module's exactly.
  (let [root (BeamLisp/cwd)
        ebin (Path/join root "build")
        out (s/scratch "multi-out")
        real {"Elixir.BeamLisp.Multi" (Path/join root "priv/host/multi.bl")}
        hd (s/host-scratch "multi-src" "" real)
        r (s/seed-run! {:root root :out out :ebin ebin :host hd})]
    (is (:ok? r) (str "the floor is generated: " (pr-str (:errors r))))
    (let [beam (Path/join out "Elixir.BeamLisp.Multi.beam")
          exports (s/beam-exports beam)
          live (erlang/apply :"Elixir.BeamLisp.Multi" :module_info (list :exports))
          want (Enum/sort (filter (fn [e] (not (erlang/== :__info__ (elem e 0)))) live))]
      (is (File/exists? beam) "Multi is COMPILED into the floor")
      (is (= want (Enum/sort exports))
          "the published Multi beam exports exactly the live module's callables — every defn- helper is a local closure")
      (doseq [f [["type_of" 1] ["normalize_key" 1] ["define_multi" 3] ["add_method" 4]
                 ["method_keys" 2] ["dispatch" 3] ["derive" 3] ["parents" 2]
                 ["ancestors" 2] ["isa?" 3] ["underive" 3] ["define_protocol" 3]
                 ["extend_type" 4] ["dispatch_protocol" 4] ["satisfies?" 3]]]
        (is (s/has? exports (tuple (String/to_atom (first f)) (second f)))
            (str "Multi exposes " (first f) "/" (second f))))
      (is (not (s/has? exports (tuple :__info__ 1)))
          "Multi is functions-only: the published beam carries no Elixir __info__/1"))
    (File/rm_rf! out)
    (File/rm_rf! hd)))

(deftest the-server-publishes-the-defserver-public-surface
  ;; `Elixir.BeamLisp.Server` is the runtime side of the `defserver` special
  ;; form: `compile-defserver` lowers `(defserver …)` into a real `:gen_server`
  ;; behaviour module and asks this module for the generated module NAME
  ;; (`module_for/2`), the OTP callback names and clause shapes (`callback/1`,
  ;; `callback_order/0`), and the return constructors bound as locals in every
  ;; callback body (`return_constructors/0`), while `start`/`start_link`/
  ;; `call`/`cast`/`stop` are the client side that wraps `:gen_server` — so the
  ;; floor must publish the driver's whole public surface at that atom. The
  ;; mapping is functions-only — no `:struct-fields`, no `:behaviour`, no
  ;; `:macro-exports` — and the published beam is judged from its own export
  ;; chunk, from the REAL source, against the live module's callables minus
  ;; `__info__/1`. The pinned source inlines the live module's `defn-` helpers
  ;; (`convey_arg`/`unwrap`/`server_name`/`gen_opts`/`resolve`) as LOCAL
  ;; closures, so the export list is the live module's exactly.
  (let [root (BeamLisp/cwd)
        ebin (Path/join root "build")
        out (s/scratch "server-out")
        real {"Elixir.BeamLisp.Server" (Path/join root "priv/host/server.bl")}
        hd (s/host-scratch "server-src" "" real)
        r (s/seed-run! {:root root :out out :ebin ebin :host hd})]
    (is (:ok? r) (str "the floor is generated: " (pr-str (:errors r))))
    (let [beam (Path/join out "Elixir.BeamLisp.Server.beam")
          exports (s/beam-exports beam)
          live (erlang/apply :"Elixir.BeamLisp.Server" :module_info (list :exports))
          want (Enum/sort (filter (fn [e] (not (erlang/== :__info__ (elem e 0)))) live))]
      (is (File/exists? beam) "Server is COMPILED into the floor")
      (is (= want (Enum/sort exports))
          "the published Server beam exports exactly the live module's callables — every defn- helper is a local closure")
      (doseq [f [["module_for" 2] ["return_constructors" 0] ["callback" 1]
                 ["callback_order" 0] ["bind_init" 1] ["start_link" 1]
                 ["start_link" 2] ["start_link" 3] ["start" 1] ["start" 2]
                 ["start" 3] ["call" 2] ["call" 3] ["cast" 2] ["stop" 1]
                 ["stop" 2]]]
        (is (s/has? exports (tuple (String/to_atom (first f)) (second f)))
            (str "Server exposes " (first f) "/" (second f))))
      (is (not (s/has? exports (tuple :__info__ 1)))
          "Server is functions-only: the published beam carries no Elixir __info__/1"))
    (File/rm_rf! out)
    (File/rm_rf! hd)))
