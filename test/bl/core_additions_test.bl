; test/bl/core_additions_test.bl — the core vocabulary added in PLAN-021,
; tested in beam-lisp itself.
; Run: mix beam_lisp.test test/bl/core_additions_test.bl
;
; These 23 fns (get-in/assoc-in/update/update-in, mapv/filterv/remove,
; group-by/sort-by, comp/partial/constantly/juxt, letfn, to-list, and the
; string surface) were found MISSING by probing the live runtime, then written
; in beam-lisp over existing primitives.
;
; What these tests are for: each fn has a CONTRACT that a plausible-looking
; implementation can violate silently. `sort-by` shipped returning a vector and
; passed every hand-probe — it took jank's own vendored `sort-by` fixture to
; expose it, because the two disagree only in RETURN TYPE. So the assertions
; below pin semantics (nil handling, laziness, return type, arity) rather than
; happy-path values.

(ns core-additions.test)

;; ── nested access ───────────────────────────────────────────────────────────

(deftest get-in-basics
  (is (= 1 (get-in {:a {:b 1}} [:a :b])))
  (is (= {:b 1} (get-in {:a {:b 1}} [:a])))
  ; an empty path is identity, not an error
  (is (= {:a 1} (get-in {:a 1} [])))
  ; vectors are associative by index, so a path can descend into one
  (is (= 30 (get-in {:a [10 20 30]} [:a 2]))))

(deftest get-in-absence-is-distinguishable
  ; The reason the 3-arity exists: a nil VALUE and an ABSENT key are different
  ; facts, and a caller that cannot tell them apart writes a bug.
  (is (= nil (get-in {:a 1} [:x])))
  (is (= :none (get-in {:a 1} [:x] :none)))
  (is (= :none (get-in {:a {:b 1}} [:a :x :y] :none)))
  ; present-but-nil returns the nil, NOT the default
  (is (= nil (get-in {:a nil} [:a] :none)))
  ; a nil root short-circuits to the default rather than throwing
  (is (= :none (get-in nil [:a] :none))))

(deftest assoc-in-creates-intermediates
  (is (= {:a {:b 1}} (assoc-in {} [:a :b] 1)))
  (is (= {:a {:b {:c 2}}} (assoc-in {} [:a :b :c] 2)))
  ; existing siblings survive
  (is (= {:a {:b 1 :c 2}} (assoc-in {:a {:c 2}} [:a :b] 1)))
  (is (= {:a 9} (assoc-in {:a 1} [:a] 9))))

(deftest update-applies-f
  (is (= {:a 2} (update {:a 1} :a inc)))
  ; extra args are passed through after the current value
  (is (= {:a 11} (update {:a 1} :a + 10)))
  (is (= {:a 6} (update {:a 1} :a + 2 3)))
  ; an ABSENT key hands f nil, as Clojure does — it does not skip
  (is (= {:a [nil]} (update {} :a (fn [v] [v])))))

(deftest update-in-nested
  (is (= {:a {:b 2}} (update-in {:a {:b 1}} [:a :b] inc)))
  (is (= {:a {:b 11}} (update-in {:a {:b 1}} [:a :b] + 10)))
  (is (= {:a {:b 1}} (update-in {} [:a :b] (fn [_] 1)))))

;; ── eager variants ──────────────────────────────────────────────────────────

(deftest mapv-filterv-are-eager-vectors
  (is (= [2 3] (mapv inc [1 2])))
  (is (= [1 3] (filterv odd? [1 2 3])))
  ; the POINT of these over map/filter: the result is a vector, so it indexes
  (is (vector? (mapv inc [1 2])))
  (is (vector? (filterv odd? [1 2 3])))
  (is (= 3 (get (mapv inc [1 2]) 1)))
  (is (= [] (mapv inc [])))
  (is (= [] (filterv odd? []))))

(deftest remove-is-filter-complement
  (is (= (list 2) (remove odd? [1 2 3 1])))
  (is (= (list) (remove (fn [_] true) [1 2])))
  ; nil-punning: falsey means REMOVED by filter, so remove KEEPS it
  (is (= (list nil) (remove identity [nil]))))

;; ── grouping and ordering ───────────────────────────────────────────────────

(deftest group-by-collects
  (let [g (group-by odd? [1 2 3 4])]
    (is (= [1 3] (get g true)))
    (is (= [2 4] (get g false))))
  ; order WITHIN a group is insertion order, which is what makes it usable
  (is (= ["aa" "bb"] (get (group-by count ["aa" "bb"]) 2)))
  (is (= {} (group-by odd? []))))

(deftest sort-by-returns-a-sequence
  ; THE regression this file exists for. `sort-by` first shipped delegating to
  ; Enum/sort_by, which returns a VECTOR. Every hand-probe passed; jank's
  ; vendored sort-by (test/fixtures/jank/slice_59_sort_by.bl, byte-for-byte
  ; upstream) delegates to `sort` and expects a LIST, and two suites failed.
  ; The fixture is the specification.
  (is (= (list 1 2 3) (sort-by identity [3 1 2])))
  (is (not (vector? (sort-by identity [3 1 2]))))
  (is (= (list "a" "aa" "aaa") (sort-by count ["aaa" "a" "aa"]))))

(deftest sort-by-comparator-is-three-way
  ; The 3-arity takes a THREE-WAY comparator (negative/zero/positive), not a
  ; boolean predicate — `sort` tests the result with `<= 0`, so passing `<`
  ; makes every pair compare greater-than and the order goes arbitrary.
  (is (= (list 3 2 1) (sort-by identity (fn [a b] (compare b a)) [1 3 2])))
  (is (= (list 1 2 3) (sort-by identity compare [3 1 2]))))

(deftest sort-by-keyfn-sees-the-element
  (is (= (list {:a 1} {:a 2}) (sort-by (fn [m] (get m :a)) [{:a 2} {:a 1}])))
  ; NB an empty input comes back as the empty VECTOR, not the empty list:
  ; `sort` routes its result through RT.empty_contract, which is the runtime's
  ; single representation of "empty". Pinned so a future change is deliberate.
  (is (= [] (sort-by identity []))))

;; ── composition ─────────────────────────────────────────────────────────────

(deftest comp-composes-right-to-left
  (is (= 3 ((comp inc inc) 1)))
  (is (= 4 ((comp inc inc inc) 1)))
  ; right-to-left MATTERS: inc-then-double ≠ double-then-inc
  (is (= 4 ((comp (fn [x] (* x 2)) inc) 1)))
  (is (= 3 ((comp inc (fn [x] (* x 2))) 1)))
  ; identity cases
  (is (= 1 ((comp) 1)))
  (is (= 2 ((comp inc) 1)))
  ; the composed fn is variadic in its rightmost position
  (is (= 7 ((comp inc +) 3 3))))

(deftest partial-fixes-leading-args
  (is (= 3 ((partial + 1) 2)))
  (is (= 6 ((partial + 1 2) 3)))
  (is (= 10 ((partial + 1 2 3) 4)))
  (is (= 15 ((partial + 1 2 3 4) 5)))
  (is (= 1 ((partial inc) 0))))

(deftest constantly-ignores-everything
  (is (= 7 ((constantly 7))))
  (is (= 7 ((constantly 7) 1)))
  (is (= 7 ((constantly 7) 1 2 3)))
  (is (= nil ((constantly nil) 1))))

(deftest juxt-returns-a-vector
  (is (= [6 4] ((juxt inc dec) 5)))
  (is (= [5] ((juxt identity) 5)))
  (is (= [1 2 3] ((juxt (constantly 1) (constantly 2) (constantly 3)) :x)))
  (is (vector? ((juxt inc dec) 5)))
  ; juxt over multiple args
  (is (= [3 -1] ((juxt + -) 1 2))))

;; ── letfn ───────────────────────────────────────────────────────────────────

(deftest letfn-binds-locals
  (is (= 42 (letfn [(f [x] (* x 2))] (f 21))))
  (is (= 3 (letfn [(f [a b] (+ a b))] (f 1 2)))))

(deftest letfn-is-recursive
  ; the property `let` + `fn` CANNOT provide: a binding seeing its own name
  (is (= 120 (letfn [(fact [n] (if (= n 0) 1 (* n (fact (dec n)))))]
               (fact 5)))))

(deftest letfn-is-mutually-recursive
  ; and the property that motivates the atom-table construction: `od?` is
  ; referenced by `ev?` BEFORE it is defined
  (is (= true (letfn [(ev? [n] (if (= n 0) true (od? (dec n))))
                      (od? [n] (if (= n 0) false (ev? (dec n))))]
                (ev? 10))))
  (is (= false (letfn [(ev? [n] (if (= n 0) true (od? (dec n))))
                       (od? [n] (if (= n 0) false (ev? (dec n))))]
                 (ev? 7)))))

(deftest letfn-forward-reference
  (is (= 42 (letfn [(a [n] (b n))
                    (b [n] (+ n 1))]
              (a 41)))))

;; ── to-list ─────────────────────────────────────────────────────────────────

(deftest to-list-normalizes
  (is (= (list 1 2) (to-list [1 2])))
  (is (= (list 1 2) (to-list (list 1 2))))
  ; nil is the empty list, not an error — every Enum call downstream needs this
  (is (= (list) (to-list nil)))
  (is (= (list) (to-list [])))
  ; a lazy seq is forced
  (is (= (list 1 2 3) (to-list (map identity [1 2 3])))))

;; ── strings ─────────────────────────────────────────────────────────────────

(deftest join-arg-order-is-clojures
  ; sep FIRST (Clojure), not collection-first (Elixir). Getting this backwards
  ; type-checks and silently produces garbage.
  (is (= "a,b" (join "," ["a" "b"])))
  (is (= "ab" (join ["a" "b"])))
  (is (= "" (join "," [])))
  (is (= "a" (join "," ["a"])))
  (is (= "1,2" (join "," [1 2])))
  ; works over a list as well as a vector
  (is (= "x,y" (join "," (list "x" "y")))))

(deftest split-returns-a-vector
  (is (= ["a" "b"] (split "a,b" ",")))
  (is (= ["a"] (split "a" ",")))
  (is (vector? (split "a,b" ","))))

(deftest trim-family
  (is (= "x" (trim "  x  ")))
  (is (= "x  " (triml "  x  ")))
  (is (= "  x" (trimr "  x  ")))
  (is (= "" (trim "   "))))

(deftest blank?-is-not-empty?
  ; the distinction that makes it worth having: `(empty? "  ")` is FALSE, so a
  ; validator written with empty? accepts a whitespace-only submission
  (is (= true (blank? "")))
  (is (= true (blank? "   ")))
  (is (= true (blank? "\n\t")))
  (is (= true (blank? nil)))
  (is (= false (blank? "a")))
  (is (= false (blank? " a "))))

(deftest string-predicates
  (is (= true (starts-with? "abc" "a")))
  (is (= false (starts-with? "abc" "b")))
  (is (= true (ends-with? "abc" "c")))
  (is (= false (ends-with? "abc" "a")))
  (is (= true (includes? "abc" "b")))
  (is (= false (includes? "abc" "z"))))

(deftest case-conversion
  (is (= "ABC" (upper-case "abc")))
  (is (= "abc" (lower-case "ABC"))))

(deftest replace-str-replaces-every-occurrence
  ; named replace-str because Clojure's `replace` is the COLLECTION fn
  (is (= "a-b-c" (replace-str "aXbXc" "X" "-")))
  (is (= "abc" (replace-str "abc" "z" "-")))
  (is (= "" (replace-str "" "a" "b"))))

;; ── hashing ─────────────────────────────────────────────────────────────────

(deftest sha256-hex-matches-the-standard
  ; the published SHA-256 of "abc" — this must agree byte-for-byte with every
  ; other runtime, because contract fingerprints are compared ACROSS languages
  (is (= "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
         (sha256-hex "abc")))
  (is (= 64 (count (sha256-hex "abc"))))
  ; deterministic, and lowercase
  (is (= (sha256-hex "x") (sha256-hex "x")))
  (is (not (= (sha256-hex "x") (sha256-hex "y"))))
  (is (= (lower-case (sha256-hex "x")) (sha256-hex "x"))))

;; ── substring search ────────────────────────────────────────────────────────

(deftest index-of-returns-nil-not-minus-one
  ; nil rather than -1: a sentinel INDEX is a number arithmetic will consume, so
  ; `(subs s (index-of s x))` on a miss silently reads from the end instead of
  ; failing. nil forces the caller to decide.
  (is (= 1 (index-of "abc" "b")))
  (is (= 0 (index-of "abc" "a")))
  (is (= nil (index-of "abc" "z")))
  (is (= nil (index-of "" "a")))
  ; the first occurrence, not the last
  (is (= 0 (index-of "aa" "a"))))

(deftest index-of-counts-GRAPHEMES-not-bytes
  ; `subs` and `String/split` are grapheme-aware here, so a byte offset mixed
  ; into them would corrupt any non-ASCII string
  (is (= 2 (index-of "héllo" "l")))
  (is (= "llo" (subs "héllo" (index-of "héllo" "l")))))

(deftest last-index-of
  (is (= 3 (last-index-of "a.b.c" ".")))
  (is (= nil (last-index-of "abc" ".")))
  (is (= 0 (last-index-of "abc" "a"))))
