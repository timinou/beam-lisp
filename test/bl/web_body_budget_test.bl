(ns web.body-budget-test (:require [web]))
(defn conn [body]
 (erlang/apply :Elixir.Plug.Test :conn (list "POST" "/" body)))
(deftest bounded-body-read-preserves-response-connection
 (let [r (web/read-body-limited* (conn "abc") 3 1000)]
  (is (= "abc" (:body r)))
  (is (nil? (:error r)))
  (is (erlang/is_map (:conn r))))
 (is (= "" (:body (web/read-body-limited* (conn "") 1 1000))))
 (is (= :body-too-large (:error (web/read-body-limited* (conn "abcd") 3 1000))))
 (is (= :body-too-large (:error (web/read-body-limited* (conn (join "" (repeat 20000 "x"))) 9000 1000)))))
(deftest body-budget-is-a-closed-native-contract
 (doseq [limit [nil 0 -1 134217729] timeout [nil 0 -1 30001]]
  (is (try (web/read-body-limited* (conn "x") limit timeout) false (catch _ true)))))

(deftest attachment-endpoints-can-declare-a-larger-bounded-body
 (let [body (join "" (repeat 1048600 "x"))]
  (is (= body (:body (web/read-body-limited* (conn body) 2097152 1000))))
  (is (= :body-too-large (:error (web/read-body-limited* (conn body) 1048576 1000)))))
 (is (try (web/read-body-limited* (conn "x") 134217729 1000) false (catch _ true))))
