(ns loader.queue-admission-test)
(def probe :Elixir.BeamLisp.LoaderQueueProbe)
(defn tmp-dir []
  (str (System/tmp_dir!) "/loader-queue-" (erlang/unique_integer (list :positive))))
(defn stop-probe! []
  (when-let [pid (Process/whereis probe)]
    (Process/unlink pid) (GenServer/stop pid :normal 5000)))
(defn compile-pinned [module dir]
  (stop-probe!)
  (let [res (BeamLisp.AOT/compile_host_file
              (Path/join (BeamLisp/cwd) "priv/host/loader_server.bl")
              (list (tuple :module module) (tuple :output_dir dir) (tuple :load? false)))]
    (code/soft_purge module) (code/delete module)
    (code/load_binary module (erlang/binary_to_list (elem res 1)) (File/read! (elem res 1)))))

(deftest installed-loader-declines-dead-owner
  ;; Exercise the installed host, not a freshly compiled probe: this catches a
  ;; stale bootstrap/SDK that ships the old admission policy with new sources.
  (let [parent (erlang/self) dead (erlang/spawn (fn [] nil))
        ref (erlang/monitor :process dead)]
    (is (= :dead (receive [:DOWN received :process _ _] :when (= received ref)
                  :dead (after 5000 :timeout))))
    (is (= (tuple :reply (tuple :ok :cancelled) :state)
      (BeamLisp.Loader.Server/handle_call
        (tuple :run (fn [] (erlang/send parent :installed-unexpected-evaluation)))
        (tuple dead (erlang/make_ref)) :state)))
    (is (= :none (receive :installed-unexpected-evaluation :ran (after 0 :none))))))

(deftest loader-server-dead-queued-owner-is-not-admitted
  (let [dir (tmp-dir) parent (erlang/self)]
    (compile-pinned probe dir)
    (try
      (let [dead (erlang/spawn (fn [] nil)) ref (erlang/monitor :process dead)]
        (is (= :dead (receive [:DOWN received :process _ _] :when (= received ref)
                      :dead (after 5000 :timeout))))
        (is (= (tuple :reply (tuple :ok :cancelled) :state)
          (erlang/apply probe :handle_call
            (list (tuple :run (fn [] (erlang/send parent :unexpected-evaluation)))
                  (tuple dead (erlang/make_ref)) :state))))
        (is (= :none (receive :unexpected-evaluation :ran (after 0 :none)))))
      (finally (stop-probe!) (File/rm_rf! dir)))))

(deftest loader-server-admitted-initializer-drains-after-owner-death
  (let [dir (tmp-dir) parent (erlang/self)]
    (compile-pinned probe dir)
    (stop-probe!)
    (try
      (let [px probe
            server (erlang/apply probe :run (list (fn [] (erlang/self))))
            caller (erlang/spawn (fn []
                     (erlang/apply px :run
                       (list (fn []
                         (erlang/send parent :initializer-admitted)
                         (receive :finish-initializer nil (after 5000 nil))
                         (erlang/send parent :initializer-drained))))))]
        (is (= :admitted (receive :initializer-admitted :admitted (after 5000 :timeout))))
        (Process/exit caller :kill)
        (erlang/send server :finish-initializer)
        (is (= :drained (receive :initializer-drained :drained (after 5000 :timeout))))
        (is (= :healthy (erlang/apply probe :run (list (fn [] :healthy))))))
      (finally (stop-probe!) (File/rm_rf! dir)))))
