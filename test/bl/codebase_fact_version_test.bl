; A schema bump invalidates both the warm held corpus and the persisted
; semantic manifest, not just their per-file facts. No native cache is needed.
(ns codebase.fact-version-test
  (:require [codebase :as cb] [code.index :as idx]))

(deftest warm-corpus-key-includes-fact-schema
  (let [entries [["app.view" "source-hash"]]
        legacy (sha256-hex (str idx/MANIFEST-VERSION "|app.view source-hash"))
        expected (sha256-hex (str idx/MANIFEST-VERSION "|" cb/FACTS-VERSION
                                  "|app.view source-hash"))]
    (is (= expected (idx/key-of entries)))
    (is (not= legacy (idx/key-of entries))
        "an old live conn must not be returned after a schema bump")))

(deftest disk-corpus-key-includes-fact-schema
  (let [entries [["app.view" "source-hash"]]
        legacy (sha256-hex "model-v1|app.view source-hash")
        expected (sha256-hex (str "model-v1|" cb/FACTS-VERSION
                                  "|app.view source-hash"))]
    (is (= expected (cb/manifest-key "model-v1" entries)))
    (is (not= legacy (cb/manifest-key "model-v1" entries))
        "an old semantic memo must not merge stale fact columns")))
