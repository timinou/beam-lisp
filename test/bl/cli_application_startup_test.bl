; Release eval enters the pinned host before the runtime application exists.
; A namespace entry may auto-boot Env before its body, too late for supervision.
(ns cli.application-startup-test)

(def managed-source
 "(ns cli.managed-probe)
  (defserver owner (init [_] (ok nil)) (handle-call :ping [_ state] (reply :pong state)))
  (defn start-owner [] (start owner))")

(def probe-source
 (str
 "(ns cli.application-probe (:require [proc.inventory :as inv] [reload.generation :as g]))
  (when-not (and (Process/whereis :Elixir.BeamLisp.Supervisor)
                 (Process/whereis :beam_lisp_owner_registry)
                 (= (Process/whereis :Elixir.BeamLisp.Env) (ets/info :beam_lisp_owner_index :owner)))
   (throw (ex-info \"CLI omitted supervised runtime startup\" {})))
  (let [generation (g/prepare! {:application-id \"cli-application-probe\"
         :sources {\"cli.managed-probe\" " (pr-str managed-source) "}})
        pid (g/invoke! generation \"cli.managed-probe/start-owner\" [])]
   (try
    (let [result (inv/snapshot \"cli-application-probe\")]
     (when-not (and (= :valid (:status result)) (= [pid] (mapv :pid (:participants result))))
      (throw (ex-info \"CLI lost automatic managed registration\" {}))))
    (when-not (= :pong (GenServer/call pid :ping)) (throw (ex-info \"CLI owner failed\" {})))
    (finally (core/stop pid) (g/retire! generation))))
  (println \"CLI-SUPERVISED-APPLICATION-OK\")"))

(deftest packaged-native-entry-starts-application-before-namespace-dispatch
 (let [dir (str (System/tmp_dir!) "/cli-startup-" (erlang/unique_integer (list :positive)))
       program (str dir "/probe.bl") runner (str dir "/entry.exs")]
  (File/mkdir_p! dir)
  (try
   ;; Exercise the actual SDK CLI. Recompiling its protected canonical shim
   ;; in a live runtime is deliberately refused by immutable SDK custody.
   (File/write! program probe-source)
   (File/write! runner (str "BeamLisp.Launcher.start_app!([\"run\", " (Kernel/inspect program) "], %{})\n"))
   (let [paths (mapcat #(list "-pa" (erlang/list_to_binary %)) (code/get_path))
         result (System/cmd "elixir" (to-list (concat paths (list runner)))
                  (list (tuple :stderr_to_stdout true)))
         text (elem result 0)]
    (is (= 0 (elem result 1)) text)
    (is (String/contains? text "CLI-SUPERVISED-APPLICATION-OK") text))
   (finally (File/rm_rf! dir)))))
