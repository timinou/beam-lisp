(ns env.namespace-lock-test)
(defn contender-can-enter? [ns]
 (Task/await (Task/async (fn []
  (let [id (tuple (tuple :bl_namespace_publication ns) (erlang/self))
        acquired (global/set_lock id (list (erlang/node)) 0)]
   (when acquired (global/del_lock id (list (erlang/node))))
   acquired))) 5000))
(deftest nested-publication-keeps-the-outer-lock
 (let [ns "navigation.lock.fixture"]
  (BeamLisp.Env/with_namespace_lock ns
   (fn []
    (is (= false (contender-can-enter? ns)))
    (is (= :nested (BeamLisp.Env/with_namespace_lock ns (fn [] :nested))))
    (is (= false (contender-can-enter? ns)))
    (is (= :caught (try (BeamLisp.Env/with_namespace_lock ns (fn [] (throw :probe)))
                       (catch _ :caught))))
    (is (= false (contender-can-enter? ns)))))
  (is (= true (contender-can-enter? ns)))
  (is (= :caught (try (BeamLisp.Env/with_namespace_lock ns (fn [] (throw :probe)))
                     (catch _ :caught))))
  (is (= true (contender-can-enter? ns)))))
(deftest lock-ownership-is-never-conveyed
 (let [ns "navigation.lock.convey.fixture"]
  (BeamLisp.Env/with_namespace_lock ns
   (fn []
    (let [action (BeamLisp.Env/convey (fn [_]
                   (erlang/get (tuple :bl_namespace_lock_held ns))))]
     (is (= :undefined
       (Task/await (Task/async (fn [] (erlang/apply action (list nil)))) 5000))))))))
