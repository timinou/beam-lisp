(ns aot-constructor-diagnostics-test)

(defn- with-exhausted-frame [action]
 ;; Privileged native negative component only. This is a fuel counter, never
 ;; an execution ticket, SDK owner receipt or actor admission capability.
 (let [key (tuple :constructor-machine-frame (erlang/make_ref))
       state {:counter-frame key :max-collection 16384}]
  (erlang/put key {:remaining 0 :depth 0 :allocation-nodes 1000000 :allocation-bytes 16777216
                   :new-atoms 64 :recipes {} :callables {}})
  (try (action state) (finally (erlang/erase key)))))

(deftest exhausted-input-cost-reports-fixed-operation-without-payload
 (let [marker "CONSTRUCTOR_ARGUMENT_MUST_NOT_APPEAR_IN_DIAGNOSTIC"
       error (with-exhausted-frame
               (fn [state]
                (try (BeamLisp.AOT/constructor_primitive :Elixir.BeamLisp.Ns.Core :count
                         (list marker) state) nil (catch e e))))]
  (is (= :constructor-machine-refused (:kind (ex-data error))))
  (is (= :step-budget (:detail (ex-data error))))
  (is (= [:Elixir.BeamLisp.Ns.Core :count 1] (:constructor-operation (ex-data error))))
  (is (String/contains? (ex-message error) "step-budget"))
  (is (String/contains? (ex-message error) "Elixir.BeamLisp.Ns.Core:count/1"))
  (is (= false (String/contains? (ex-message error) marker)))))

(deftest nested-diagnostic-wrappers-preserve-first-actual-operation
 (let [first-op [:Elixir.BeamLisp.Ns.Core :count 1]
       error (ex-info "original" {:kind :constructor-machine-refused :detail :step-budget
                                  :constructor-operation first-op})
       annotated (BeamLisp.AOT/constructor_diagnostic_error error [:erlang :length 1])]
  (is (= first-op (:constructor-operation (ex-data annotated))))
  (is (= :step-budget (:detail (ex-data annotated))))
  (is (= false (String/contains? (ex-message annotated) "erlang:length/1")))))

(deftest unrelated-native-errors-and-private-value-fields-are-not-reformatted
 (let [native (Elixir.ArgumentError/exception "original-native-error")]
  (is (erlang/=:= native (BeamLisp.AOT/constructor_diagnostic_error native [:erlang :length 1]))))
 (let [marker "PRIVATE_CAPTURE_MUST_NOT_APPEAR_IN_DIAGNOSTIC"
       error (ex-info "original" {:kind :constructor-machine-refused
                                  :detail {:unrecognized marker} :arguments (list marker)})
       annotated (BeamLisp.AOT/constructor_diagnostic_error error [:Elixir.File :write! 2])]
  (is (= :constructor-machine-refused (:kind (ex-data annotated))))
  (is (String/contains? (ex-message annotated) "unsupported-operation"))
  (is (= false (String/contains? (ex-message annotated) marker)))))
