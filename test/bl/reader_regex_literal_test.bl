; test/bl/reader_regex_literal_test.bl
;
;   bin/bl test test/bl/reader_regex_literal_test.bl
;
; THE `#"…"` REGEX LITERAL. Clojure code writes `(re-find #"\d+" s)` without a
; second thought; before this, beam-lisp read `#"…"` as the bare symbol `#`
; followed by a string, and the failure surfaced far away as
; `undefined var: user/#` — the construct that told you nothing about itself.
;
; THE CONTRACT PINNED HERE.
;   1. The body is the REGEX's text, verbatim: `\d` stays backslash-d, it is not
;      a string escape. `\"` does not close the body (and is kept as written).
;   2. The literal reads to `(clojure.re/re-pattern "<body>")` — compiled at
;      evaluation, because a compiled pattern cannot be embedded in an AOT
;      module — and needs NO require, as on the JVM.
;   3. Clojure's re-find shapes come back: no groups → the string; groups → a
;      vector.
;   4. An unterminated literal is a structured `:unterminated-string` failure
;      that names the closer, so repair and the LSP treat it like a string.
;
; Sources that exercise the READER are built as strings (so the escapes under
; test are exactly the ones written); the evaluation cases are literal, which is
; the point — this file itself must read.

(ns reader_regex_literal_test
  (:require [clojure.string :as cs]))

(def bs "\\")
(def q "\"")

(defn- read-1 [src] (first (BeamLisp.Reader/read_all src)))
(defn- node-tag [n] (erlang/element 1 n))
(defn- node-items [n] (erlang/element 2 n))
(defn- read-failure [src]
  (get (reader/read src {:file "regex_literal_test.bl" :diagnostics :collect}) :error))

; ── 1. the read shape ─────────────────────────────────────────────────────────

(deftest a-regex-literal-reads-as-a-re-pattern-call
  (let [form (read-1 (str "#" q "a+" q))]
    (is (= :list (node-tag form)))
    (is (= [:symbol "clojure.re/re-pattern"] (vec (erlang/tuple_to_list (first (node-items form))))))
    (is (= "a+" (second (node-items form))))))

(deftest the-body-keeps-regex-escapes-verbatim
  (is (= (str bs "d+" bs "." bs "s") (second (node-items (read-1 (str "#" q bs "d+" bs "." bs "s" q))))))
  (is (= (str "a" bs q "b") (second (node-items (read-1 (str "#" q "a" bs q "b" q)))))
      "an escaped quote does not close the body and is kept as written"))

(deftest the-form-after-a-literal-still-reads
  (let [forms (BeamLisp.Reader/read_all (str "[#" q "x" q " :next]"))]
    (is (= 1 (count forms)))))

(deftest an-unterminated-literal-names-its-closer
  (let [d (read-failure (str "(re-find #" q "abc"))]
    (is (= :unterminated-string (get d :kind)))
    (is (= q (get d :closer)))))

; ── 2. evaluation: Clojure's contracts, no require ───────────────────────────

(deftest re-find-without-groups-is-the-string
  (is (= "aaa" (re-find #"a+" "baaa")))
  (is (nil? (re-find #"z" "baaa"))))

(deftest re-find-with-groups-is-the-vector
  (is (= ["12-34" "12" "34"] (re-find #"(\d+)-(\d+)" "x 12-34"))))

(deftest literals-work-inside-functions
  (let [has? (fn [s] (boolean (re-find #"MARK" s)))]
    (is (true? (has? "a MARK b")))
    (is (false? (has? "nothing")))))

(deftest an-escaped-quote-matches-a-quote
  (is (= [(str q "q" q)] (vec (re-seq #"\"q\"" (str "a " q "q" q " b"))))))

(deftest re-matches-and-split-take-a-literal
  (is (= "dev.bl" (re-matches #"[a-z]+\.bl" "dev.bl")))
  (is (nil? (re-matches #"[a-z]+\.bl" "devXbl")))
  (is (= ["a" "b" "c"] (cs/split "a1b22c" #"\d+"))))

(deftest a-newline-escape-is-the-regexs
  (is (= "\n" (re-find #"\n" "a\nb"))))
