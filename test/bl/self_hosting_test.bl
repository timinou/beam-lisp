; self_hosting_test.bl — the self-hosted compiler's test suite, in beam-lisp.
;
; The compiler is written in beam-lisp (priv/boot/compiler.bl); its tests are too.
; Each test compiles a form with BOTH the self-hosted compiler and the existing
; Elixir compiler (the oracle) and asserts the two produce the same Elixir
; syntax tree — the differential-oracle discipline that gated every prototype,
; now expressed as ordinary deftests. A final group compiles-and-RUNS code to
; prove the output is not just matching but working.

(ns self-hosting.test
  (:require [compiler :as c] [self.oracle :as o]))

(defn- ast-equal?
  "True when the self-hosted compiler and the oracle produce the same Elixir
   syntax tree for `src` (compiled in namespace `ns`)."
  [ns src]
  (let [form (BeamLisp.Reader/read_one src)
        oenv (BeamLisp.Compiler/new_env ns)
        kenv (assoc (c/new-env ns) :ns ns)]
    (o/ast-equal? (o/oracle-compile form oenv) (c/compile form kenv))))

(defn- runs-to
  "Compile `src` with the self-hosted compiler, evaluate its output, and return
   the value — proving the compiler emits working code."
  [src]
  (let [kenv (assoc (c/new-env "user") :ns "user")
        ast (c/compile (BeamLisp.Reader/read_one src) kenv)]
    (first (erlang/tuple_to_list (Code/eval_quoted ast)))))

(deftest literals-and-calls
  (testing "literals, collections, and the call paths compile identically"
    (is (ast-equal? "user" "42"))
    (is (ast-equal? "user" "[1 2 3]"))
    (is (ast-equal? "user" "{:a 1 :b 2}"))
    (is (ast-equal? "user" "#{1 2}"))
    (is (ast-equal? "user" "(+ 1 2)"))
    (is (ast-equal? "user" "(String/upcase s)"))
    (is (ast-equal? "user" "(:a m)"))))

(deftest binding-and-control
  (testing "let/loop/recur/if/do/quote/throw compile identically"
    (is (ast-equal? "user" "(let [x 1 y 2] (+ x y))"))
    (is (ast-equal? "user" "(loop [i 0] (if (< i 10) (recur (+ i 1)) i))"))
    (is (ast-equal? "user" "(if a b c)"))
    (is (ast-equal? "user" "(quote (a b c))"))
    (is (ast-equal? "user" "(try (foo) (catch e (bar e)))"))))

(deftest functions-and-destructuring
  (testing "fn shapes, destructuring, and guards compile identically"
    (is (ast-equal? "user" "(fn [x] x)"))
    (is (ast-equal? "user" "(fn ([x] x) ([x y] (+ x y)))"))
    (is (ast-equal? "user" "(fn [x & rest] rest)"))
    (is (ast-equal? "user" "(let [{:keys [a b]} m] a)"))
    (is (ast-equal? "user" "(fn [n] :when (int? n) n)"))))

(deftest definitions
  (testing "def/defn/defmacro compile identically, docstrings included"
    (is (ast-equal? "user" "(def x 42)"))
    (is (ast-equal? "user" "(defn sq [x] (* x x))"))
    (is (ast-equal? "user" "(defn id \"the identity\" [x] x)"))
    (is (ast-equal? "user" "(defmacro twice [x] `(do ~x ~x))"))))

(deftest macros-and-hygiene
  (testing "macro expansion and syntax-quote compile identically"
    (is (ast-equal? "user" "(when c x)"))
    (is (ast-equal? "user" "(and a b c)"))
    (is (ast-equal? "user" "(-> x f g)"))
    (testing "the documented capture case does not capture"
      (is (ast-equal? "user" "(let [and-tmp 5] (and 1 and-tmp))")))))

(deftest objects-and-concurrency
  (testing "dispatch/objects/servers compile identically"
    (is (ast-equal? "user" "(defrecord Point [x y])"))
    (is (ast-equal? "user" "(defprotocol Shape (area [s]))"))
    (is (ast-equal? "user" "(defmulti area :shape)"))
    (is (ast-equal? "user" "(receive [:ping] :pong (after 100 :t))"))
    (is (ast-equal? "user" "(defserver c (init [n] (ok n)))"))))

(deftest end-to-end-runs
  (testing "the compiler's output is not just matching but WORKING code"
    (is (= 3 (runs-to "(+ 1 2)")))
    (is (= 15 (runs-to "(let [x 5 y 3] (* x y))")))
    (is (= 5 (runs-to "((fn [n] (if (< n 2) 1 n)) 5)")))
    (is (= 45 (runs-to "(loop [i 0 acc 0] (if (< i 10) (recur (+ i 1) (+ acc i)) acc))")))))
