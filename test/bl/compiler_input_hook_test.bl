(ns compiler.input-hook-compile-test)
(defn- compiler-call [name args]
 (erlang/apply :Elixir.BeamLisp.Ns.Compiler name (to-list args)))
(deftest native-pattern-walk-collects-real-bindings-without-wildcards
 (let [pattern {:pop :palias :a {:pop :pvar :name "whole"}
                :b {:pop :pstruct :mod :Elixir.CompilerPatternFixture
                    :fields (list (list :items {:pop :pcons
                       :head {:pop :pmap :pairs (list (list {:pop :plit :val :key}
                                                                    {:pop :pvar :name "value"}))}
                       :tail {:pop :pvar :name "_"}}))}}]
  (is (= (list "whole" "value")
         (compiler-call :server-input-pattern-vars [pattern])))
  (is (= (list) (compiler-call :server-input-pattern-vars [{:pop :pvar :name "_"}])))
  (is (= (list) (compiler-call :server-input-pattern-vars [{:pop :plit :val "quoted"}])))))
(deftest native-hook-names-exact-source-export-and-actual-key-bindings
 (let [module :Elixir.CompilerInputFixture
       params (list {:pop :palias :a {:pop :pvar :name "z"}
                    :b {:pop :ptuple :elems (list {:pop :pvar :name "a"}
                                                {:pop :pvar :name "z"}
                                                {:pop :pvar :name "_"})}})
       guard {:op :remote :mod :erlang :fun :is_number
              :args (list {:op :var :name "a" :ann {}}) :ann {}}
       hook (compiler-call :server-input-check [module :handle_call params guard])
       call (:else hook) args (:args call)]
  (is (= :if (:op hook)))
  (is (= :Elixir.BeamLisp.Env (:mod call)))
  (is (= :check_server_inputs! (:fun call)))
  (is (= module (:val (first args))))
  (is (= (list :handle_call params guard) (:val (second args))))
  (is (= (list "a" "z") (to-list (mapv (fn [pair] (:val (first pair))) (:pairs (nth args 2))))))
  (is (= (list "a" "z") (to-list (mapv (fn [pair] (:name (second pair))) (:pairs (nth args 2))))))
  (is (= :ok (:val (:then hook))))))
(deftest actual-native-actor-compilation-emits-check-without-loading-or-running-class
 (let [form (first (BeamLisp.Reader/read_string
              "(defserver input_compile_only
                 (init [parent] (erlang/send parent :compile-entered) (ok 0))
                 (handle-call [:run n] [_ state] :when (number? n)
                  (erlang/send state :compile-entered) (reply (erlang/+ n 1) state)))"))
       node (BeamLisp.Compiler/compile form (BeamLisp.Compiler/new_env "compiler.input.compile.only"))
       descriptor (:val (first (:args (first (:stmts node)))))
       dispatch (first (filter #(= :handle_call (:fname %)) (:clauses descriptor)))
       init (first (filter #(= :init (:fname %)) (:clauses descriptor)))
       wrapper (:body dispatch) action (nth (:args wrapper) 2)
       user (:body (first (:clauses action))) hook (first (:stmts user))]
  (is (= :module (:op descriptor)))
  (is (= false (erlang/module_loaded (:name descriptor))))
  (is (= :Elixir.BeamLisp.Env (:mod wrapper)))
  (is (= :with_server_execution! (:fun wrapper)))
  (is (= (:name descriptor) (:val (first (:args wrapper)))))
  (is (= :handle_call (:val (second (:args wrapper)))))
  (is (= :check_server_inputs! (:fun (:else hook))))
  (is (= (list :handle_call (:params dispatch) (:guard dispatch))
         (:val (second (:args (:else hook))))))
  ;; Compile actual bytes without loading the class or executing its init.
  (let [pair (BeamLisp.Ns.Lower/descriptor->beam descriptor)
        chunks (beam_lib/chunks (elem pair 1) (list :imports))
        imports (Keyword/get (elem (elem chunks 1) 1) :imports)]
   (is (Enum/member? imports (tuple :Elixir.BeamLisp.Env :check_server_inputs! 3)))
   (is (not (Enum/any? imports
             (fn [row] (= :Elixir.BeamLisp.Ns.Proc.Contract (elem row 0)))))))
  (is (= :let (:op (:body init))))
  (is (= :quiet (receive :compile-entered :effect (after 0 :quiet))))))
