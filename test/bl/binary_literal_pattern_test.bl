(ns binary-literal-pattern-test (:require [env]))
(deftest binary-literals-are-exact-patterns-in-all-containers
 (is (= :hit (env/eval "(case \"caller\" \"caller\" :hit :miss)")))
 (is (= :miss (env/eval "(case \"callers\" \"caller\" :hit :miss)")))
 (is (= :hit (env/eval "(case \"\" \"\" :hit :miss)")))
 (is (= :hit (env/eval "(case \"héλ\" \"héλ\" :hit :miss)")))
 (is (= :hit (env/eval "(case {:name \"value\"} {:name \"value\"} :hit :miss)")))
 (is (= :hit (env/eval "(case [:key \"value\"] [:key \"value\"] :hit :miss)")))
 (is (= :miss (env/eval "(case [:key \"values\"] [:key \"value\"] :hit :miss)"))))
(deftest receive-matches-nested-binary-literals
 (is (= :hit (env/eval
  "(do (erlang/send (erlang/self) [:binary-pattern \"caller\" {:name \"project\"}])
       (receive [:binary-pattern \"caller\" {:name \"project\"}] :hit (after 1000 :timeout)))"))))
(deftest receive-binary-patterns-cover-empty-unicode-and-exact-length
 (is (= :hit (env/eval
  "(do (erlang/send (erlang/self) [:binary-empty \"\"])
       (receive [:binary-empty \"\"] :hit (after 1000 :timeout)))")))
 (is (= :hit (env/eval
  "(do (erlang/send (erlang/self) [:binary-unicode \"héλ\"])
       (receive [:binary-unicode \"héλ\"] :hit (after 1000 :timeout)))")))
 (is (= :miss (env/eval
  "(do (erlang/send (erlang/self) [:binary-exact \"callers\"])
       (receive [:binary-exact \"caller\"] :hit [:binary-exact value] :miss (after 1000 :timeout)))"))))
