(ns loader.worker-protocol-test (:require [system.model :as model]))

(deftest selective-worker-pump-has-no-unscoped-transition
  ;; Read the actual host source through the system transition extractor. This
  ;; architectural sentinel catches an added wildcard/ordinary-call arm that
  ;; could run an unrelated initializer while partial state is visible.
  (let [forms (BeamLisp.Reader/read_string
                (File/read! (Path/join (BeamLisp/cwd) "priv/host/loader_server.bl")))
        definition (first (filter (fn [node]
          (and (= "defn-" (model/head-name node))
               (= "await_worker" (model/nm (nth (model/items node) 1))))) forms))
        clauses (model/transitions (nth (model/items definition) 3))
        guards (into {} (map (fn [clause] [(:label clause) (:guard clause)]) clauses))]
    (is (= #{:bl_loader_dependency :bl_loader_worker :DOWN} (set (keys guards))))
    (is (= "(== ref ticket)" (:bl_loader_dependency guards)))
    (is (= "(== ref ticket)" (:bl_loader_worker guards)))
    (is (= "(== ref monitor)" (:DOWN guards)))
    (is (= 3 (count clauses)))))
