; provenance_test.bl — where a build came from (PLAN-144 W1).
;
; Runs against a throwaway git repository, so the answers do not depend on the
; state of the tree the suite runs in.

(ns provenance.test
  (:require [provenance :as prov]))

(defn- sh! [dir & args]
  (let [r (System/cmd "git" (to-list args)
                      (to-list [(tuple :cd dir) (tuple :stderr_to_stdout true)
                                (tuple :env (to-list [(tuple "GIT_AUTHOR_NAME" "t") (tuple "GIT_AUTHOR_EMAIL" "t@t")
                                                      (tuple "GIT_COMMITTER_NAME" "t") (tuple "GIT_COMMITTER_EMAIL" "t@t")]))]))]
    (when (not= 0 (elem r 1)) (throw (ex-info (str "git " (pr-str args) ": " (elem r 0)) {})))
    (String/trim (elem r 0))))

(defn- repo []
  (let [dir (str (System/tmp_dir) "/bl-prov-" (erlang/unique_integer (list :positive)))]
    (File/mkdir_p! (str dir "/lib"))
    (sh! dir "init" "-q" "-b" "main")
    (File/write! (str dir "/lib/a.txt") "one\n")
    (File/write! (str dir "/notes.org") "a note\n")
    (sh! dir "add" ".")
    (sh! dir "commit" "-q" "-m" "one")
    dir))

(deftest a-clean-tree-is-its-commit
  (let [dir (repo)
        info (prov/collect dir)]
    (is (= (sh! dir "rev-parse" "HEAD") (:commit info)))
    (is (= "main" (:branch info)))
    (is (= false (:dirty info)))
    (is (nil? (:diffhash info)))
    (is (= (:commit info) (:source-key info)))
    (File/rm_rf! dir)))

(deftest uncommitted-work-moves-the-key-and-only-then
  (let [dir (repo)
        head (sh! dir "rev-parse" "HEAD")]
    (testing "a change outside the build inputs is not dirty"
      (File/write! (str dir "/notes.org") "another note\n")
      (File/write! (str dir "/scratch.md") "untracked, not an input")
      (is (= false (:dirty (prov/collect dir)))))
    (File/write! (str dir "/lib/a.txt") "two\n")
    (let [one (prov/collect dir)
          again (prov/collect dir)]
      (testing "an edit makes the tree dirty, keyed commit+diff"
        (is (= true (:dirty one)))
        (is (String/starts_with? (:source-key one) (str head "+"))))
      (testing "the same edits answer the same key"
        (is (= (:source-key one) (:source-key again))))
      (testing "a new untracked input file moves it"
        (File/write! (str dir "/lib/new.txt") "x")
        (is (not= (:source-key one) (:source-key (prov/collect dir)))))
      (testing "an ignored file does not"
        (File/write! (str dir "/.gitignore") "lib/ignored.txt\n")
        (let [before (:source-key (prov/collect dir))]
          (File/write! (str dir "/lib/ignored.txt") "y")
          (is (= before (:source-key (prov/collect dir)))))))
    (File/rm_rf! dir)))

(deftest a-worktree-names-its-repository
  (let [dir (repo)
        wt (str dir "-wt")]
    (sh! dir "worktree" "add" "-q" "-b" "feature" wt)
    (let [info (prov/collect wt)]
      (is (= "feature" (:branch info)))
      (is (= (Path/expand wt) (Path/expand (:worktree info))))
      (is (= (Path/expand dir) (Path/expand (:source-repo info)))))
    (sh! dir "worktree" "remove" "--force" wt)
    (File/rm_rf! dir)))

(deftest the-file-round-trips-as-data
  (let [dir (repo)
        info (prov/collect dir)]
    (prov/write! dir info)
    (is (= info (prov/read dir)))
    (testing "nothing there reads as nil, never an error"
      (is (nil? (prov/read (str dir "/nope")))))
    (File/rm_rf! dir)))

(deftest the-summary-says-only-what-it-knows
  (is (= "beam-lisp 1.0" (prov/summary "1.0" nil)))
  (let [line (prov/summary "1.0" {:commit "1cf72d26294b95444125" :dirty true :branch "main"
                                  :worktree "/somewhere/else" :built-at "2026-09-24T08:00:00Z"
                                  :build "7154e76a"})]
    (is (= "beam-lisp 1.0 · 1cf72d26+dirty (main) · /somewhere/else · built 2026-09-24T08:00:00Z · build 7154e76a"
           line)))
  (is (= "beam-lisp 1.0 · abc · running from source"
         (prov/summary "1.0" {:commit "abc" :source-mode true :build "src"}))))

(defn- data-line
  "The map line of a `BUILD_INFO.bl`'s text (line 2; line 1 is the header)."
  [text]
  (second (String/split text "\n")))

(defn- keys-in-order
  "The keys of the file's map, in the order the file lists them. Parses only
   key tokens from the data line; the values here are strings/nil/booleans."
  [text]
  (vec (map (fn [part]
              (first (String/split (if (String/starts_with? part "{") (subs part 1) part) " ")))
            (String/split (data-line text) ", "))))

(deftest nil-valued-keys-survive-and-the-file-bytes-are-canonical
  ;; The fixpoint gate compares two generations' `BUILD_INFO.bl` byte for byte.
  ;; `pr-str` prints a map in the BEAM's own map order, and that order is NOT a
  ;; function of the map's value: measured across the gate's gen-2 and gen-3,
  ;; which wrote ONE `collect` map with `:source-key`/`:diffhash` adjacent in
  ;; one file and apart in the other. So `write!` must impose an order of its
  ;; own — key-sorted — and a clean build's nil-valued keys (`:commit`,
  ;; `:diffhash`, `:source-key`, `:branch`, `:remote`) must survive it whole.
  (let [dir (str (System/tmp_dir) "/bl-prov-canon-" (erlang/unique_integer (list :positive)))
        info {:version "0.1.0" :dirty false :otp "27" :remote nil :elixir "1.18"
              :compiler-key "abc" :branch nil :commit nil :source-key nil
              :diffhash nil :source-repo "/src" :worktree "/src"
              :built-at "2026-09-26T00:00:00Z" :built-by "host"}]
    (File/mkdir_p! dir)
    (testing "an explicit nil-key map survives write!/read with every nil intact"
      (let [p (prov/write! dir info)
            back (prov/read dir)]
        (is (= info back))
        (is (nil? (:commit back)))
        (is (nil? (:diffhash back)))
        (is (nil? (:source-key back)))
        (is (nil? (:remote back)))
        (is (nil? (:branch back)))
        (testing "re-writing the map read back reproduces the same bytes"
          (let [b1 (File/read! p)
                b2 (File/read! (prov/write! dir back))
                b3 (File/read! (prov/write! dir (prov/read dir)))]
            (is (= b1 b2))
            (is (= b2 b3))
            (testing "because the file lists keys in a canonical (sorted) order"
              (is (= (vec (map pr-str (sort-by (fn [k] (pr-str k)) (keys info))))
                     (keys-in-order b1))))))))
    (File/rm_rf! dir)))

(run-tests)
