; host_set_test.bl — the pinned `Set` type and its `Enumerable` impl.
;
; Two `.bl` sources under `priv/host/` replace the two halves of
; `lib/beam_lisp/set.ex` at their exact module atoms:
;
;   * `priv/host/set.bl` → `Elixir.BeamLisp.Set`, a STRUCT whose `__struct__/0,1`
;     pair and `__info__/1` are synthesized by `compile_host_file`'s
;     `:struct_fields` option, plus the public `new/0,1` `add/2` `del/2`
;     `member?/2` `count/1` `to_list/1`.
;   * `priv/host/set_enumerable.bl` → `Elixir.Enumerable.BeamLisp.Set`, the
;     protocol impl, FUNCTIONS-ONLY.
;
; The live modules are never left replaced. Each source is compiled at its OWN
; probe atom, the namespace shim beside it is dropped, and the pinned beam is
; loaded ALONE — so a leftover shim reference would be `undef` here.
;
;   * the `Set` probe is checked structurally (the tag is the probe atom, not a
;     hard-coded one) and diffed against the live module on the same inputs,
;     including `Rt.hash_key` metadata normalization and `MapSet.new/1` over a
;     bl VECTOR;
;   * the impl is exercised by DIRECT invocation over a live `BeamLisp.Set`
;     value — the tag its `BeamLisp.Set/*` calls resolve against — and by
;     `Enumerable.impl_for`, which derives the impl atom from the value's tag;
;   * and, the live impl beam saved first, the impl is loaded under its EXACT
;     atom `Elixir.Enumerable.BeamLisp.Set`, dispatched the live `BeamLisp.Set`
;     through, and the live beam RESTORED afterwards.
;
; Run: bin/bl test test/bl/host_set_test.bl

(ns host.set.test)

(defn- t2 [k v] (erlang/list_to_tuple (list k v)))

(defn- tmp-dir []
  (str (System/tmp_dir!) "/bl_host_set_" (erlang/unique_integer (list :positive))))

(defn- set-source [] (Path/join (BeamLisp/cwd) "priv/host/set.bl"))
(defn- enum-source [] (Path/join (BeamLisp/cwd) "priv/host/set_enumerable.bl"))

(def ^:private set-mod :Elixir.BeamLisp.HostSetProbe)
(def ^:private enum-mod :Elixir.Enumerable.BeamLisp.HostSetProbe)
(def ^:private set-shim :Elixir.BeamLisp.Ns.Host.Set)
(def ^:private enum-shim :Elixir.BeamLisp.Ns.Host.SetEnumerable)
(def ^:private live-set :Elixir.BeamLisp.Set)
(def ^:private live-enum :Elixir.Enumerable.BeamLisp.Set)

(defn- drop! [mod]
  (do (code/purge mod) (code/delete mod) :ok))

(defn- load-pinned [mod path]
  (do (drop! mod)
      (code/load_binary mod (erlang/binary_to_list path) (File/read! path))
      mod))

; Compile `src` at `mod` and publish ONLY the pinned beam: the compile's own
; load (and the namespace shim it built beside it) is dropped first.
(defn- compile-pinned [mod src opts]
  (let [res (BeamLisp.AOT/compile_host_file src opts)]
    (load-pinned mod (elem res 1))))

(defn- compile-set [dir]
  (let [m (compile-pinned set-mod (set-source)
            (list (t2 :module set-mod) (t2 :output_dir dir) (t2 :load? false)
                  (t2 :struct_fields (list (t2 :members nil)))))]
    (drop! set-shim)
    m))

(defn- compile-enum [dir]
  (let [m (compile-pinned enum-mod (enum-source)
            (list (t2 :module enum-mod) (t2 :output_dir dir) (t2 :load? false)))]
    (drop! enum-shim)
    m))

(defn- raise-class [f]
  (try (do (f) :no-raise)
       (catch e (:__struct__ e))))

; A metadata-bearing vector: same `=`, different raw term. `Rt.hash_key`
; normalizes it to the plain vector, so a set keyed by hash must treat the pair
; as ONE member.
(defn- meta-vec [m v] (maps/put :meta m v))

; ── the Set struct surface ───────────────────────────────────────────────

(deftest set-pinned-struct-is-probe-tagged
  (testing "`:struct_fields` synthesizes __struct__/0,1; `new/0,1` is module-exact"
    (let [dir (tmp-dir)]
      (compile-set dir)
      ; NO SHIM: the compile's namespace shim is gone; the pinned beam answers.
      (is (= :non_existing (erlang/apply :code :which (list set-shim))))
      ; The export surface IS the live module's, datum for datum.
      (is (= (Enum/sort (erlang/apply live-set :module_info (list :exports)))
             (Enum/sort (erlang/apply set-mod :module_info (list :exports)))))
      (is (erlang/function_exported set-mod :new 0))
      (is (erlang/function_exported set-mod :new 1))
      (is (erlang/function_exported set-mod :add 2))
      (is (erlang/function_exported set-mod :del 2))
      (is (erlang/function_exported set-mod :member? 2))
      (is (erlang/function_exported set-mod :count 1))
      (is (erlang/function_exported set-mod :to_list 1))
      ; __struct__/0 — the tag is the PROBE atom, and the one field defaults nil.
      (let [s0 (erlang/apply set-mod :__struct__ (list))]
        (is (erlang/is_map s0))
        (is (= 2 (erlang/map_size s0)))
        (is (= set-mod (erlang/map_get :__struct__ s0)))
        (is (nil? (erlang/map_get :members s0))))
      ; new/0 is the empty set, tagged with the PROBE atom — a hard-coded
      ; `BeamLisp.Set` tag would make the next line false.
      (let [e (erlang/apply set-mod :new (list))]
        (is (= set-mod (erlang/map_get :__struct__ e)))
        (is (= 0 (erlang/apply set-mod :count (list e))))
        (is (= () (erlang/apply set-mod :to_list (list e)))))
      ; __info__(:struct) is the live beam's list, datum for datum, so
      ; `Inspect.Any` renders the same.
      (is (= (erlang/apply live-set :__info__ (list :struct))
             (erlang/apply set-mod :__info__ (list :struct))))
      (is (= "%BeamLisp.HostSetProbe{members: MapSet.new([])}"
             (Kernel/inspect (erlang/apply set-mod :new (list)))))
      ; The struct leaks NO extra structural key: exactly the tag and `:members`.
      (is (= (list :__struct__ :members)
             (Enum/sort (maps/keys (erlang/apply set-mod :new (list))))))
      ; ... and a probe set carries NO Enumerable impl while the enum probe is
      ; not loaded: the impl atom derives from the tag and nothing is there.
      (is (nil? (erlang/apply :Elixir.Enumerable :impl_for
                              (list (erlang/apply set-mod :new (list))))))
      ; The SAME source compiles at its PRODUCTION atom — read, not loaded:
      ; `:load? false` writes the beam without replacing the live module.
      (let [res (BeamLisp.AOT/compile_host_file (set-source)
                  (list (t2 :module live-set) (t2 :output_dir dir) (t2 :load? false)))]
        (is (= live-set (elem res 0)))
        (is (File/exists? (elem res 1))))
      (File/rm_rf! dir))))

; ── the Set API, diffed against the live module ──────────────────────────

; One observation vector over the whole public API. Every binding is a `let`,
; because beam-lisp evaluates a call's arguments right-to-left and the sequence
; matters here (add then count, etc.).
(defn- api-obs [mod]
  (let [v (erlang/apply mod :new (list [1 2 2 3]))            ; bl VECTOR input
        c (erlang/apply mod :count (list v))
        l (Enum/sort (erlang/apply mod :to_list (list v)))
        m1 (erlang/apply mod :member? (list v 2))
        m2 (erlang/apply mod :member? (list v 9))
        a (erlang/apply mod :add (list v 9))
        c2 (erlang/apply mod :count (list a))
        a2 (erlang/apply mod :add (list a 9))                 ; idempotent
        c3 (erlang/apply mod :count (list a2))
        d (erlang/apply mod :del (list a 9))
        c4 (erlang/apply mod :count (list d))
        d2 (erlang/apply mod :del (list d 9))                 ; idempotent
        c5 (erlang/apply mod :count (list d2))
        ; metadata normalization on add/member?
        wm (erlang/apply mod :add (list (erlang/apply mod :new (list)) (meta-vec {:a 1} [4 5])))
        cm (erlang/apply mod :count (list wm))
        fm (erlang/apply mod :member? (list wm [4 5]))
        fm2 (erlang/apply mod :member? (list wm (meta-vec {:b 2} [4 5])))
        ; del by the metadata-bearing twin removes the plain member
        dm (erlang/apply mod :count (list (erlang/apply mod :del (list wm (meta-vec {:c 3} [4 5])))))]
    (list c l m1 m2 c2 c3 c4 c5 cm fm fm2 dm)))

(deftest set-pinned-api-matches-the-live-module
  (testing "same answers as live `BeamLisp.Set` — same hash keying, same MapSet"
    (let [dir (tmp-dir)]
      (compile-set dir)
      ; PINNED ANSWERS first — the ABI itself, not merely probe == live.
      (is (= (list 3 (list 1 2 3) true false 4 4 3 3 1 true true 0)
             (api-obs set-mod)))
      ; And against the live module at the public ABI atom.
      (is (= (api-obs live-set) (api-obs set-mod)))
      ; `to_list` order is set-internal, not sorted — so equal members answer
      ; equal SORTED (already done above), and the raw order is the MapSet's.
      (is (= (erlang/apply live-set :to_list (list (erlang/apply live-set :new (list [3 1 2]))))
             (erlang/apply set-mod :to_list (list (erlang/apply set-mod :new (list [3 1 2]))))))
      ; A production-tagged Set routes keyword lookup through membership.
      ; Reading the private backing field must bypass that dispatch, or
      ; member? recurses into itself during prelude/source-graph loading.
      (let [s (maps/put :__struct__ live-set (erlang/apply set-mod :new (list [1 2 2])))]
        (is (= 2 (erlang/apply set-mod :count (list s))))
        (is (= (list 1 2) (Enum/sort (erlang/apply set-mod :to_list (list s)))))
        (is (erlang/apply set-mod :member? (list s 2)))
        (is (not (erlang/apply set-mod :member? (list s 9))))
        (let [a (erlang/apply set-mod :add (list s 9))
              d (erlang/apply set-mod :del (list a 2))]
          (is (= live-set (erlang/map_get :__struct__ a)))
          (is (= 3 (erlang/apply set-mod :count (list a))))
          (is (= (list 1 9) (Enum/sort (erlang/apply set-mod :to_list (list d)))))))
      ; A metadata-bearing value is ONE member with its plain twin: the struct
      ; leaks no second slot for the same `=` value.
      (let [wm (erlang/apply set-mod :add
                 (list (erlang/apply set-mod :new (list)) (meta-vec {:a 1} [4 5])))]
        (is (= 2 (erlang/map_size wm)))
        (is (= 1 (erlang/apply set-mod :count (list wm)))))
      (File/rm_rf! dir))))

; ── the Enumerable impl: direct probe invocation ─────────────────────────

(deftest enum-pinned-direct-probe
  (testing "impl surface and direct invocation over a live Set value"
    (let [dir (tmp-dir)]
      (compile-set dir)
      ; Before the impl beam exists, the tag-derived impl atom resolves to nothing.
      (is (nil? (erlang/apply :Elixir.Enumerable :impl_for
                   (list (erlang/apply set-mod :new (list))))))
      (compile-enum dir)
      ; After it exists, the SAME derivation (tag → `Enumerable.<tag>`) finds it.
      (is (= enum-mod (erlang/apply :Elixir.Enumerable :impl_for
                          (list (erlang/apply set-mod :new (list))))))
      (is (= :non_existing (erlang/apply :code :which (list enum-shim))))
      (is (erlang/function_exported enum-mod :__impl__ 1))
      (is (erlang/function_exported enum-mod :count 1))
      (is (erlang/function_exported enum-mod :member? 2))
      (is (erlang/function_exported enum-mod :reduce 3))
      (is (erlang/function_exported enum-mod :slice 1))
      ; FUNCTIONS-ONLY: no synthesized struct surface.
      (is (not (erlang/function_exported enum-mod :__struct__ 0)))
      (is (not (erlang/function_exported enum-mod :__info__ 1)))
      ; __impl__/1 answers exactly the live impl's pair; unknown key refuses.
      (is (= (erlang/apply live-enum :__impl__ (list :for))
             (erlang/apply enum-mod :__impl__ (list :for))))
      (is (= (erlang/apply live-enum :__impl__ (list :protocol))
             (erlang/apply enum-mod :__impl__ (list :protocol))))
      (is (= :Elixir.BeamLisp.Set (erlang/apply enum-mod :__impl__ (list :for))))
      (is (= :Elixir.Enumerable (erlang/apply enum-mod :__impl__ (list :protocol))))
      (is (= :Elixir.FunctionClauseError
             (raise-class (fn [] (erlang/apply enum-mod :__impl__ (list :bogus))))))
      ; The impl is FOR `BeamLisp.Set`: direct-invoke its functions on a LIVE
      ; Set value — the tag its `BeamLisp.Set/*` calls resolve against.
      (let [s (erlang/apply live-set :new (list [1 2 3]))]
        (is (= (tuple :ok 3) (erlang/apply enum-mod :count (list s))))
        (is (= (tuple :ok true) (erlang/apply enum-mod :member? (list s 2))))
        (is (= (tuple :ok false) (erlang/apply enum-mod :member? (list s 9))))
        (is (= (tuple :error enum-mod) (erlang/apply enum-mod :slice (list s))))
        (is (= (tuple :error live-enum) (erlang/apply live-enum :slice (list s))))
        ; reduce/3 straight through the tagged accumulator protocol.
        (is (= (list 1 2 3)
               (Enum/sort
                 (erlang/element 2
                   (erlang/apply enum-mod :reduce
                     (list s (tuple :cont ()) (fn [x acc] (tuple :cont (cons x acc))))))))))
      (File/rm_rf! dir))))

; ── the impl under its EXACT atom, then restored ─────────────────────────

(deftest enum-pinned-live-dispatch-at-the-exact-atom
  (testing "loads at Elixir.Enumerable.BeamLisp.Set, dispatches the live Set, restores"
    (let [dir (tmp-dir)
          orig-path (erlang/apply :code :which (list live-enum))
          orig-bin (File/read! (erlang/list_to_binary orig-path))
          probe (Path/join dir "Elixir.Enumerable.BeamLisp.Set.beam")]
      (is (not= :non_existing orig-path)
          "precondition: the live impl beam is a readable file")
      (try
        ; Compile at the EXACT atom, then load it OVER the live impl.
        (BeamLisp.AOT/compile_host_file (enum-source)
          (list (t2 :module live-enum) (t2 :output_dir dir) (t2 :load? false)))
        (drop! live-enum)
        (code/load_binary live-enum (erlang/binary_to_list probe) (File/read! probe))
        (let [s (erlang/apply live-set :new (list [1 2 3]))]
          (is (= live-enum (erlang/apply :Elixir.Enumerable :impl_for (list s))))
          (is (= (tuple :ok 3) (Elixir.Enumerable/count s)))
          (is (= (tuple :ok true) (Elixir.Enumerable/member? s 2)))
          (is (= (list 1 2 3) (Enum/sort (Enum/to_list s))))
          (is (= (tuple :error live-enum) (Elixir.Enumerable/slice s)))
          (is (= :Elixir.FunctionClauseError
                 (raise-class (fn [] (erlang/apply live-enum :__impl__ (list :bogus)))))))
        (finally
          (drop! live-enum)
          (code/load_binary live-enum orig-path orig-bin)))
      ; RESTORED: the live impl answers again at the same atom.
      (is (= live-enum
             (erlang/apply :Elixir.Enumerable :impl_for
               (list (erlang/apply live-set :new (list [1]))))))
      (is (= (list 1 2 3)
             (Enum/sort (Enum/to_list (erlang/apply live-set :new (list [1 2 3]))))))
      (File/rm_rf! dir))))
