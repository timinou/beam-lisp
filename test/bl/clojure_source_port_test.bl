; test/bl/clojure_source_port_test.bl — Clojure source on the load path, in beam-lisp.
;
; Ported from the ExUnit `test/beam_lisp/clojure_source_test.exs`.
;
; A Clojure library on disk is not a beam-lisp library with a different
; extension: it arrives with conventions the loader never had to honour before.
; Two of them decide whether the file is found at all, and one decides whether
; it survives its first form.
;
;   1. **The extension.** `.clj` and `.cljc` are source. `.cljs` is not — its
;      contents are ClojureScript, and this platform presents as `:clj`.
;   2. **The name.** A namespace's dashes are underscores in the file name
;      (`kontor.tax.corporate-income-tax` lives at `corporate_income_tax.clj`),
;      which is every Clojure library's layout and none of beam-lisp's.
;   3. **The docstring.** `(ns app "what it is" (:require …))` is ordinary
;      Clojure; the string is not a clause, and walking it as one used to end
;      inside the host with a raw argument error.
;
; Resolution ORDER is asserted, not merely resolution: a project's own `.bl`
; must still shadow a Clojure file that claims the same namespace, and a `.clj`
; must win over a `.cljc` exactly as it does on the JVM.
;
; ── coverage map (ExUnit test → BL deftest) ────────────────────────────────
; All 15 ExUnit tests map one-to-one onto a same-named BL deftest, in the
; original order: .clj serves a require; .cljc serves a require; dashed ns →
; underscore file; literal dashed spelling; .clj wins over .cljc; .bl shadows
; .clj; ns docstring; branch-less reader conditional; cljs-only require/impl in
; .cljc; a real library from a nested tree; :import records by short name;
; :import spec qualified; :refer-clojure :exclude; unknown ns clause; and the
; 46-row JVM-reader answer table.
;
; Adaptations, and why:
;   * `use ExUnit.Case, async: false` has no ward equivalent: `bl test` runs each
;     FILE in its own isolated fork, and a file's tests run in order in that one
;     env. A fresh namespace per test is still used (namespaces load ONCE per VM)
;     exactly as the original's `uniq_ns` did.
;   * `alias BeamLisp.{Env, Loader}` becomes direct module calls; `setup`'s
;     `Env.clear_search_paths()` plus `on_exit` become `in-scratch`, which
;     registers the scratch root around each test and ALWAYS removes it. The
;     root is registered on `:global` (see `in-scratch`) so a loaded file's own
;     nested require can resolve its sibling — the ExUnit original ran at
;     `:global`, so registering there is the faithful equivalent under a ward
;     fork.
;   * `assert :ok = Loader.ensure_loaded(ns)` becomes an `is` in `load-and-eval`,
;     which then compiles the expression — the original's two steps.
;   * `Enum.to_list()` comparisons become direct equality: a vector literal
;     `[1 2]` compares equal to the read result, so the round-trip through
;     `Enum.to_list` is unnecessary.
;   * `assert_raise BeamLisp.Reader.SyntaxError, ~r/odd number of forms/, fn ->
;     eval_string("[1 #?(:clj) 2]") end` is ported as a REFUSAL assertion on the
;     compile path plus the TYPED struct on the reader edge, for this reason:
;     the boot reader raises its diagnostic map directly (`erlang/error`, a move
;     made in `eaea5b5c`), so `Compiler.eval_string` surfaces an `ErlangError`
;     carrying `%{msg: "reader conditional has an odd number of forms"}`; the
;     typed `BeamLisp.Reader.SyntaxError` is rendered by the pinned host reader
;     edge (`priv/host/reader.bl`), which is where the type IS the contract
;     (see `test/bl/wave25_reader_test.bl`). The malformed form is REFUSED on
;     both paths, so the live contract is pinned, not weakened.
;
; Run:  bl test test/bl/clojure_source_port_test.bl

(ns clojure-source-port.test)

; --- scaffolding --------------------------------------------------------------

(defn- tmp-dir!
  [label]
  (str (System/tmp_dir!) "/blclj_" label "_" (System/unique_integer (list :positive))))

; A fresh namespace per test: namespaces load ONCE per VM, so a shared name
; would have the second test assert against the first test's image.
(defn- uniq-ns [prefix]
  (str prefix "_" (System/unique_integer (list :positive))))

(defn- munge [ns]
  (-> ns (String/replace "." "/") (String/replace "-" "_")))

(defn- write-source!
  [dir rel body]
  (let [path (str dir "/" rel)]
    (File/mkdir_p! (Path/dirname path))
    (File/write! path body)
    path))

(defn- global! [f]
  (BeamLisp.Env/with_env :global f))

(defn- in-scratch
  "Run `f` with a fresh scratch search root for `label`, and ALWAYS remove the
   root and the directory — the original's `setup` + `on_exit` folded together.

   The root is registered on `:global`, not only on this ward fork, and that is
   load-bearing: a loaded Clojure file's own nested `(:require …)` is resolved
   by the loader inside its `:global` env, so a fork-local root is invisible to
   it (the nested namespace then reports `namespace not found`). The ExUnit
   original never had to say so because it ran AT `:global`; registering there
   is the faithful equivalent under `bl test`'s per-file fork. The root is
   REMOVED (not `clear_search_paths`d) so nothing else on the shared `:global`
   search path is disturbed."
  [label f]
  (let [dir (tmp-dir! label)]
    (try
      (global! (fn [] (BeamLisp.Env/add_search_path dir)))
      (f dir)
      (finally
        (global! (fn [] (BeamLisp.Env/remove_search_path dir)))
        (File/rm_rf! dir)))))

(defn- load-and-eval
  "Add `dir` to the search path, load `ns` (asserting it loads), then compile
   `expr` — the original's `load_and_eval/3`."
  [dir ns expr]
  (BeamLisp.Env/add_search_path dir)
  (let [r (BeamLisp.Loader/ensure_loaded ns)]
    (is (= :ok r) (str "ensure_loaded " ns))
    (if (= :ok r) (BeamLisp.Compiler/eval_string expr) r)))

(defn- raised
  "The exception `thunk` raises, or nil — the value an `assert_raise` inspected."
  [thunk]
  (try (do (thunk) nil) (catch e e)))

; --- the loader's three conventions -------------------------------------------

(deftest a-clj-file-serves-a-require
  (BeamLisp/init)
  (in-scratch "clj"
    (fn [dir]
      (let [ns (uniq-ns "cljlib")]
        (write-source! dir (str (munge ns) ".clj") (str "(ns " ns ")\n(defn answer [] 41)\n"))
        (is (= 41 (load-and-eval dir ns (str "(" ns "/answer)"))))))))

(deftest a-cljc-file-serves-a-require-reader-conditionals-and-all
  (BeamLisp/init)
  (in-scratch "cljc"
    (fn [dir]
      (let [ns (uniq-ns "cljclib")]
        (write-source! dir (str (munge ns) ".cljc")
          (str "(ns " ns ")\n"
               "(defn where [] #?(:clj :jvm-lane :cljs :js-lane))\n"
               "(defn docstring? [] (string? \"yes\"))\n"))
        ; The platform presents as `:clj`, so the `:clj` branch is the one loaded.
        (is (= :jvm-lane (load-and-eval dir ns (str "(" ns "/where)"))))))))

(deftest a-dashed-namespace-resolves-to-its-underscore-file-name
  (BeamLisp/init)
  (in-scratch "munged"
    (fn [dir]
      (let [ns (uniq-ns "clj-lib-dashed")
            rel (str (munge ns) ".clj")]
        (is (includes? rel "_") "the munged spelling carries the underscore")
        (write-source! dir rel (str "(ns " ns ")\n(defn source [] :underscore-file)\n"))
        (is (= :underscore-file (load-and-eval dir ns (str "(" ns "/source)"))))))))

(deftest the-literal-dashed-spelling-still-resolves
  (BeamLisp/init)
  (in-scratch "literal"
    (fn [dir]
      ; A beam-lisp tree that named a file with the dash keeps working: the
      ; literal spelling is tried before the munged one.
      (let [ns (uniq-ns "clj-lib-literal")]
        (write-source! dir (str (String/replace ns "." "/") ".bl")
          (str "(ns " ns ")\n(defn source [] :literal-file)\n"))
        (is (= :literal-file (load-and-eval dir ns (str "(" ns "/source)"))))))))

(deftest clj-wins-over-cljc-as-it-does-on-the-jvm
  (BeamLisp/init)
  (in-scratch "precedence"
    (fn [dir]
      (let [ns (uniq-ns "cljlib_both")]
        (write-source! dir (str (munge ns) ".clj") (str "(ns " ns ")\n(defn which [] :from-clj)\n"))
        (write-source! dir (str (munge ns) ".cljc") (str "(ns " ns ")\n(defn which [] :from-cljc)\n"))
        (is (= :from-clj (load-and-eval dir ns (str "(" ns "/which)"))))))))

(deftest a-projects-bl-shadows-a-clojure-file-claiming-the-same-ns
  (BeamLisp/init)
  (in-scratch "shadow"
    (fn [dir]
      (let [ns (uniq-ns "cljlib_shadow")]
        (write-source! dir (str (munge ns) ".bl") (str "(ns " ns ")\n(defn which [] :bl)\n"))
        (write-source! dir (str (munge ns) ".clj") (str "(ns " ns ")\n(defn which [] :clj)\n"))
        (is (= :bl (load-and-eval dir ns (str "(" ns "/which)"))))))))

(deftest a-namespace-docstring-is-accepted-not-walked-as-a-clause
  (BeamLisp/init)
  (in-scratch "nsdoc"
    (fn [dir]
      ; The crash this closes was a raw host argument error, so the assertion is
      ; that the namespace LOADS with its docstring in place.
      (let [ns (uniq-ns "cljlib_doc")]
        (write-source! dir (str (munge ns) ".clj")
          (str "(ns " ns "\n"
               "  \"A docstring.\"\n"
               "  (:require [clojure.string :as s]))\n\n"
               "(defn shout [] (s/upper-case \"hi\"))\n"))
        (is (= "HI" (load-and-eval dir ns (str "(" ns "/shout)"))))))))

; --- reader conditionals ------------------------------------------------------

(deftest a-branch-less-reader-conditional-reads-as-nothing-as-in-clojure
  (BeamLisp/init)
  ; `[1 #?(:cljs :x) 2]` is `[1 2]` on the JVM (verified against the Clojure
  ; reader). `.cljc` libraries depend on it: a cljs-only require and a cljs-only
  ; implementation are skipped, not refused.
  (is (= [1 2] (BeamLisp.Compiler/eval_string "[1 #?(:cljs :skipped) 2]")))
  (is (= [] (BeamLisp.Compiler/eval_string "[#?@(:cljs [1 2 3])]")))
  (is (= [1] (BeamLisp.Compiler/eval_string "[1 #?( :cljs :skipped)]")))

  ; A dangling feature with NO expr: skipped when it is not ours (there is no
  ; branch to take), an error when it IS ours (the form is malformed). Both
  ; verified against the JVM reader: `[1 #?(:cljs) 2]` → `[1 2]`, while
  ; `[1 #?(:clj) 2]` raises, and a dangling feature AFTER a match is never
  ; reached at all.
  (is (= [1 2] (BeamLisp.Compiler/eval_string "[1 #?(:cljs) 2]")))
  (is (= [1] (BeamLisp.Compiler/eval_string "[#?(:clj 1 :cljs)]")))

  ; The malformed conditional is REFUSED. The original asserted the reader's
  ; typed SyntaxError at `Compiler.eval_string`; since `eaea5b5c` the boot reader
  ; raises its diagnostic directly, so the refusal is asserted here with its
  ; message, and the TYPED edge is pinned on the pinned host reader below.
  (is (thrown-with-msg? "odd number of forms"
        (BeamLisp.Compiler/eval_string "[1 #?(:clj) 2]")))
  (is (= :Elixir.BeamLisp.Reader.SyntaxError
         (:__struct__ (raised (fn [] (BeamLisp.Reader/read_string "[1 #?(:clj) 2]" "conditional.clj")))))
      "the host reader edge renders the refusal as the typed SyntaxError"))

(deftest a-cljc-namespace-with-a-cljs-only-require-and-cljs-only-impl-loads
  (BeamLisp/init)
  (in-scratch "cljc-skip"
    (fn [dir]
      (let [ns (uniq-ns "cljlib_cljs_skip")]
        (write-source! dir (str (munge ns) ".cljc")
          (str "(ns " ns "\n"
               "  \"Clojure on one platform, something else on the other.\"\n"
               "  (:require #?(:clj [clojure.string :as str])\n"
               "            #?(:cljs [some.client-only.lib :as bd])))\n\n"
               "#?(:cljs (defn amount [] :a-bigint))\n"
               "#?(:clj  (defn amount [] :a-decimal))\n\n"
               "(defn shout [] (str/upper-case \"hi\"))\n"))
        (is (= "HI" (load-and-eval dir ns (str "(" ns "/shout)"))))
        (is (= :a-decimal (BeamLisp.Compiler/eval_string (str "(" ns "/amount)"))))))))

(deftest a-real-clojure-library-namespace-loads-from-a-nested-tree
  (BeamLisp/init)
  (in-scratch "library"
    (fn [dir]
      ; The shape a ported library arrives in: a docstring, a dashed namespace,
      ; a nested directory, requiring a sibling — all at once.
      (let [pkg (uniq-ns "acme.tax")
            inner (str pkg ".rate-schedule")]
        (write-source! dir (str (munge inner) ".clj")
          (str "(ns " inner "\n"
               "  \"The rate half of a tax: base in, liability out.\"\n"
               "  (:require [clojure.string :as str]))\n\n"
               "(defn label [] (str/join \"-\" [\"rate\" \"schedule\"]))\n"
               "(defn flat [rate base] (* rate base))\n"))
        (write-source! dir (str (munge pkg) ".clj")
          (str "(ns " pkg "\n"
               "  \"An outer namespace requiring the dashed sibling.\"\n"
               "  (:require [" inner " :as rs]))\n\n"
               "(defn name-of-lib [] (rs/label))\n"
               "(defn tax [base] (rs/flat 3 base))\n"))
        (is (= "rate-schedule" (load-and-eval dir pkg (str "(" pkg "/name-of-lib)"))))
        (is (= 21 (BeamLisp.Compiler/eval_string (str "(" pkg "/tax 7)"))))))))

; --- ns clauses ---------------------------------------------------------------

(deftest an-import-clause-records-the-class-by-short-name-and-loads-nothing
  (BeamLisp/init)
  (BeamLisp.Compiler/eval_string
    (str "(ns import.probe\n"
         "  (:import [java.math BigDecimal RoundingMode]\n"
         "           (java.util Date)\n"
         "           java.security.MessageDigest))\n"))
  (is (= "java.math.BigDecimal" (BeamLisp.Env/import_target "import.probe" "BigDecimal")))
  (is (= "java.math.RoundingMode" (BeamLisp.Env/import_target "import.probe" "RoundingMode")))
  (is (= "java.util.Date" (BeamLisp.Env/import_target "import.probe" "Date")))
  (is (= "java.security.MessageDigest" (BeamLisp.Env/import_target "import.probe" "MessageDigest")))
  (is (nil? (BeamLisp.Env/import_target "import.probe" "UUID"))))

(deftest an-import-spec-must-be-package-qualified-with-class-names
  (BeamLisp/init)
  (is (thrown-with-msg? "invalid :import spec"
        (BeamLisp.Compiler/eval_string "(ns import.bad (:import [java.math]))")))
  (is (thrown-with-msg? "invalid :import spec"
        (BeamLisp.Compiler/eval_string "(ns import.bad2 (:import Date))"))))

(deftest refer-clojure-exclude-is-recorded-and-the-same-ns-def-shadows-core
  (BeamLisp/init)
  (let [r (BeamLisp.Compiler/eval_string
            (str "(do\n"
                 "  (ns refer.probe (:refer-clojure :exclude [zero? name]))\n"
                 "  (defn zero? [_] :shadowed)\n"
                 "  (zero? 0))\n"))]
    (is (= :shadowed r))
    (is (= (list "zero?" "name") (BeamLisp.Env/core_excludes "refer.probe")))
    (is (= 0 (count (BeamLisp.Env/core_excludes "import.probe"))))
    (is (thrown-with-msg? "supports only :exclude"
          (BeamLisp.Compiler/eval_string "(ns refer.bad (:refer-clojure :only [inc]))")))))

(deftest an-unknown-ns-clause-is-refused-by-name
  (BeamLisp/init)
  (is (thrown-with-msg? "got :use"
        (BeamLisp.Compiler/eval_string "(ns clause.bad (:use [x]))"))))

; --- the JVM reader's answer key ----------------------------------------------
;
; The reader's answers for reader conditionals, CAPTURED FROM THE JVM READER
; AND EVALUATOR (`clojure -M -e` over these exact sources) — an oracle, not a
; re-statement of this implementation. Which cases pin which rule:
;
;   [#?(:cljs)]            -> []      a dangling NON-matching feature is no
;                                     branch to take, not a malformed form
;   [#?(:clj)]             -> error   a dangling MATCHING feature is malformed
;   [#?(:clj 1 :cljs)]     -> [1]     …and a dangling feature after a match is
;                                     never reached
;   [1 #? (:cljs 2) 3]     -> [1 3]   `#? (` may carry whitespace
;   [1 #?@ (:clj [2 3]) 4] -> [1 2 3 4]
;   [1 # (inc 1) 2]        -> error   but `# (` is a tag, and stays an error

(def ^:private conditional-cases
  [["[1 #?(:clj 2) 3]" "[1 2 3]"]
   ["[1 #?(:cljs 2) 3]" "[1 3]"]
   ["[1 #?(:cljs 2)]" "[1]"]
   ["[#?(:clj 1)]" "[1]"]
   ["[#?(:cljs 1)]" "[]"]
   ["[#?@(:clj [1 2])]" "[1 2]"]
   ["[#?@(:cljs [1 2])]" "[]"]
   ["[1 #?@(:cljs [2 3]) 4]" "[1 4]"]
   ["[1 #?@(:clj [2 3]) 4]" "[1 2 3 4]"]
   ["{:a 1 #?(:cljs :b) 2}" :error]
   ["#{1 #?(:cljs 2)}" "#{1}"]
   ["[1 #?(:cljs 2 :default 3) 4]" "[1 3 4]"]
   ["(list 1 #?(:cljs 2) 3)" "(1 3)"]
   ["[#?(:cljs)]" "[]"]
   ["[1 #?(:cljs 2) #?(:cljs 3) 4]" "[1 4]"]
   ["[#?@(:cljs [])]" "[]"]
   ["[#?(:cljs [1 2])]" "[]"]
   ["[1 #? (:cljs 2) 3]" "[1 3]"]
   ["[[1 #?(:cljs 2)] 3]" "[[1] 3]"]
   ["[#?(:cljs 1 :clj 2)]" "[2]"]
   ["[1 #?(:clj 2 :default 3) 4]" "[1 2 4]"]
   ["{:a #?(:cljs 1) :b 2}" :error]
   ["[1 #?(:cljs 2) #?(:clj 3) 4]" "[1 3 4]"]
   ["[#?(:clj)]" :error]
   ["[#?(:cljs)]" "[]"]
   ["[#?(:cljs 1 :clj)]" :error]
   ["[#?(:clj 1 :cljs)]" "[1]"]
   ["[1 #?@ (:cljs [2 3]) 4]" "[1 4]"]
   ["[1 #?@(:clj [2 3]) 4]" "[1 2 3 4]"]
   ["[1 #_ 2 3]" "[1 3]"]
   ["[#_]" :error]
   ["[1 #_ 2]" "[1]"]
   ["[(#(inc 1))]" "[2]"]
   ["[1 # (inc 1) 2]" :error]
   ["[#{1 2}]" "[#{1 2}]"]
   ["[1 # {1} 2]" :error]
   ["[1 #?@ ( :clj [2]) 3]" "[1 2 3]"]
   ["[#?()]" "[]"]
   ["[#? ()]" "[]"]
   ["[1 #? () 2]" "[1 2]"]
   ["[1 #?@ () 2]" "[1 2]"]
   ["[1 #? (:cljs 2 :default 3) 4]" "[1 3 4]"]
   ["[1 #?@ (:clj [2]) 3]" "[1 2 3]"]
   ["{:a 1 #?(:clj :b 2)}" :error]
   ["[1 #?(:cljs 2) 3 #?(:clj 4) 5]" "[1 3 4 5]"]
   ["[#?@(:cljs [1]) #?@(:clj [2])]" "[2]"]])

(deftest reader-conditional-answers-match-the-jvm-reader
  (BeamLisp/init)
  (doseq [c conditional-cases]
    (let [src (first c)
          expected (second c)
          got (try (pr-str (BeamLisp.Compiler/eval_string src))
                   (catch _e :error))]
      (is (= got expected)
          (str "reader conditional " src ": JVM said " expected ", this reader said " got)))))
