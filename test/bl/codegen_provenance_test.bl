; codegen_provenance_test.bl — the live codegen source digest, pinned to the
; FILES it must read.
;
; BUG-106: `BeamLisp.AtomGuard` is a member of `@codegen_modules` and a pinned
; host leaf — its exact-name beam is compiled from `priv/host/atom_guard.bl` and
; committed in the seed's `hosts` list — but `@pinned_host_sources` had no row
; for it, and `lib/beam_lisp/atom_guard.ex` was deleted when the port landed. So
; `codegen_source_path(BeamLisp.AtomGuard)` named a file that does not exist,
; `live_codegen_digest/0` halted at `:missing`, and `codegen_part/0` fell through
; to the frozen `priv/codegen.sources`. The whole point of the toolchain key —
; "an edit under `lib/` must rotate the key, or the drift gate would accept beams
; produced by a different codegen" — silently stopped holding: this checkout,
; carrying an edited `lib/beam_lisp/aot.ex`, computed the PRE-EDIT key
; (`1c4af9d4…`, byte-identical to the committed seed manifest's).
;
; What is pinned, and why each assertion is worth a test:
;
;   · the module list here mirrors `@codegen_modules` — drift between them is
;     exactly how a leaf stops being covered, so it fails loudly;
;   · production's key EQUALS the key predicted from the live sources' bytes,
;     computed here by the documented rule (each module's source bytes then its
;     name, in `@codegen_modules` order, NUL-joined, sha256). Before the fix the
;     sentinel baked digest survived and both answers disagreed with the prediction;
;   · each codegen module's source is READABLE at the path the rule names —
;     `BeamLisp.AtomGuard` at `priv/host/atom_guard.bl` and `BeamLisp.Record` at
;     `priv/host/record.bl`, never the legacy `.ex`;
;   · every one of those files is an INPUT: a scratch copy hashes like the real
;     tree, and editing one leaf in the scratch copy moves the digest. The real
;     tree is never edited;
;   · the baked digest (`priv/codegen.sources`, what a source-less release DROP
;     falls back to) is the checkout's own live digest and has the 64-hex shape
;     the fallback accepts, so a drop built from this checkout boots with the key
;     its beams were stamped with instead of being born stale.
;
; The test writes `priv/codegen.sources` only through production's own bake path
; (it is a gitignored, derived artifact) and restores the previous bytes
; afterwards. No `.ex`/`.bl` source is ever touched.
;
; Run: bin/bl test test/bl/codegen_provenance_test.bl

(ns codegen-provenance.test)

; ── the digest rule, reproduced ──────────────────────────────────────────────
;
; `live_codegen_digest/0` is private, so the test recomputes it. That is the
; point: production's PUBLIC key is then required to equal this prediction, so
; the test fails the moment production stops hashing the files named here.

(defn- sha256-hex
  [data]
  (String/downcase (Base/encode16 (crypto/hash :sha256 data))))

(defn- hash-parts
  "`AOTCache.hash_parts/1` — sha256 over the parts joined by a NUL byte."
  [parts]
  (sha256-hex (IO/iodata_to_binary (Enum/intersperse parts 0))))

(defn- codegen-modules
  "`@codegen_modules` in order, paired with the source its bytes MUST come from:
   a pinned host leaf from `priv/host/<leaf>.bl`, a module still authored under
   `lib/` from `lib/beam_lisp/<name>.ex`. The `BeamLisp.AtomGuard` row is the
   BUG-106 contract — `priv/host/atom_guard.bl`, NOT `lib/beam_lisp/atom_guard.ex`
   — and `BeamLisp.Record` is the same contract's second row: `priv/host/record.bl`
   is its only home, so the digest must not answer the deleted
   `lib/beam_lisp/record.ex`."
  []
  (list (list :Elixir.BeamLisp.AOT          "lib/beam_lisp/aot.ex")
        (list :Elixir.BeamLisp.AtomGuard    "priv/host/atom_guard.bl")
        (list :Elixir.BeamLisp.CompilerData "priv/host/compiler_data.bl")
        (list :Elixir.BeamLisp.Record       "priv/host/record.bl")
        (list :Elixir.BeamLisp.Emit         "priv/host/emit.bl")
        (list :Elixir.BeamLisp.Link         "priv/host/link.bl")
        (list :Elixir.BeamLisp.Tiers        "priv/host/tiers.bl")))

(defn- root
  "The checkout — the same tree `bin/bl` ran from, and the one whose `lib/` the
   pinned host sources sit beside."
  []
  (BeamLisp/cwd))

(defn- digest-of
  "The live codegen digest as it would be computed from a tree rooted at `base`.
   `AOTCache.live_codegen_digest/0` folds `[\"codegen\" | pairs]` — each module's
   SOURCE BYTES then its NAME, in `@codegen_modules` order — with a NUL between
   every part. (The reduce accumulates `[name, bytes | acc]` and reverses, so the
   bytes of each pair land first.)"
  [base]
  (hash-parts
    (concat (list "codegen")
            (mapcat (fn [m] (list (File/read! (Path/join base (second m)))
                                  (str (first m))))
                    (codegen-modules)))))

(defn- live-codegen-digest []
  (digest-of (root)))

(defn- toolchain-source-contents
  "`AOTCache.toolchain_source_contents/0` — every `priv/boot/**/*.bl` plus the
   `priv/self/**/*.bl` oracle, sorted by path. Both directories are asked of the
   running `BeamLisp.Tiers`, the authority production asks."
  []
  (let [boot (Path/wildcard (Path/join (BeamLisp.Tiers/boot_dir) "**/*.bl"))
        self (Path/wildcard (Path/join (BeamLisp.Tiers/priv_root) "self/**/*.bl"))]
    (map File/read! (sort (concat boot self)))))

(defn- predicted-key
  "`AOTCache.compute_compiler_key/0` with `codegen-part` as its codegen input."
  [codegen-part]
  (hash-parts
    (concat (list (str "elixir:" (System/version))
                  (str "otp:" (erlang/list_to_binary (erlang/system_info :otp_release)))
                  (str "aot_backend:" (BeamLisp.AOTCache/aot_backend))
                  codegen-part)
            (toolchain-source-contents))))

(defn- baked-path [] (Path/join (BeamLisp.Tiers/priv_root) "codegen.sources"))

(defn- with-baked
  "Run `f` with `priv/codegen.sources` holding `content`, restoring the previous
   bytes on the way out — including when a write fails part-way."
  [content f]
  (let [path (baked-path)
        original (when (File/exists? path) (File/read! path))]
    (try
      (File/write! path content)
      (f)
      (finally
        (if (nil? original) (File/rm path) (File/write! path original))))))

; ── the module list is the same set, in the same order ───────────────────────

(deftest the-module-list-mirrors-at-codegen-modules
  (let [source (File/read! (Path/join (root) "lib/beam_lisp/aot_cache.ex"))
        block (-> source
                  (String/split "@codegen_modules [")
                  (second)
                  (String/split "]")
                  (first))]
    (is (> (erlang/byte_size block) 50)
        "the @codegen_modules block was located in the source")
    ; Every module named in the source must be named here — a leaf added to the
    ; attribute without a row here would stop being covered, the BUG-106 gap.
    (is (= (inc (count (codegen-modules)))
           (count (String/split block "BeamLisp.")))
        "no module drift between @codegen_modules and this test")
    (doseq [m (codegen-modules)]
      (let [name (String/replace (str (first m)) "Elixir." "")]
        (is (includes? block name)
            (str name " must still be a member of @codegen_modules"))))))

; ── the digest follows the LIVE sources, and so does the key ─────────────────

(deftest the-toolchain-key-is-the-key-of-the-live-codegen-sources
  ; A SENTINEL baked digest: valid 64-hex, and not the answer. Taking the live
  ; branch overwrites it (and bakes the live digest for future drops); falling
  ; through to it — BUG-106 — leaves the sentinel in place, and every answer
  ; below then disagrees with the sources on disk.
  (let [sentinel (String/duplicate "0" 64)
        live (live-codegen-digest)]
    (with-baked sentinel
      (fn []
        (let [key (BeamLisp.AOTCache/current_compiler_key)]
          (is (= live (String/trim (File/read! (baked-path))))
              "production must BAKE the digest of the live sources, not keep a stale one")
          (is (= (predicted-key (str "codegen-source:" live)) key)
              "the toolchain key must be the key of the LIVE codegen sources"))))))

(deftest every-codegen-source-is-readable-at-the-path-the-rule-names
  (doseq [m (codegen-modules)]
    (let [rel (second m)
          path (Path/join (root) rel)]
      (is (File/exists? path) (str rel " must exist — the digest names it"))
      (is (> (erlang/byte_size (File/read! path)) 0) (str rel " must be non-empty"))))
  ; The legacy `.ex` this row replaced is gone: the mapping must not answer it.
  (is (not (File/exists? (Path/join (root) "lib/beam_lisp/atom_guard.ex")))
      "the pinned leaf's `.ex` is deleted — priv/host/atom_guard.bl is its only home"))

(deftest every-named-source-is-an-input-to-the-digest
  ; The digest is a function of the FILES: a byte-identical scratch copy hashes
  ; like the real tree, and editing ONE leaf in the scratch copy moves it. That
  ; is "editing a codegen source rotates the key", proved on copies — a module
  ; the digest names but never READS would contribute nothing, which is the way
  ; BUG-106 stayed invisible.
  (let [tmp (str (System/tmp_dir!) "/bl_codegen_prov_"
                 (erlang/unique_integer (list :positive)))
        rels (map second (codegen-modules))]
    (try
      (doseq [rel rels]
        (let [dst (Path/join tmp rel)]
          (File/mkdir_p! (Path/dirname dst))
          (File/write! dst (File/read! (Path/join (root) rel)))))
      (is (= (digest-of (root)) (digest-of tmp))
          "a byte-identical copy of the codegen sources hashes identically")
      (doseq [rel rels]
        (let [dst (Path/join tmp rel)
              before (digest-of tmp)]
          (File/write! dst (str (File/read! dst) "\n; provenance fixture edit\n"))
          (is (not= before (digest-of tmp))
              (str rel " must be an input to the live codegen digest"))
          (File/write! dst (File/read! (Path/join (root) rel)))))
      (finally (File/rm_rf! tmp)))))

; ── the baked digest is what a source-less drop computes its key from ────────

(deftest a-drop-carrying-the-baked-digest-gets-this-checkouts-key
  ; A release drop ships no `.ex` and no `priv/host/*.bl`: `live_codegen_digest/0`
  ; is `:error` and `codegen_part/0` reads `priv/codegen.sources`. The file must
  ; therefore be (a) the 64-hex shape `baked_codegen_digest/0` accepts — else the
  ; drop falls through to the legacy beam-bytes rule — and (b) exactly this
  ; checkout's live digest, which is the property that makes a drop built FROM a
  ; checkout boot with the key its beams carry. The checkout bakes it whenever it
  ; computes the key; this asserts the result.
  (let [path (baked-path)
        original (when (File/exists? path) (File/read! path))]
    (try
      (let [key (BeamLisp.AOTCache/current_compiler_key)
            baked (String/trim (File/read! path))]
        (is (Regex/match? (Regex/compile! "^[0-9a-f]{64}$") baked)
            "the baked digest must be the shape the drop's fallback accepts")
        (is (= (live-codegen-digest) baked)
            "the baked digest must BE the live digest, or a drop is born stale")
        (is (= (predicted-key (str "codegen-source:" baked)) key)
            "a drop computing its key from the baked digest gets this checkout's key"))
      (finally
        (if (nil? original) (File/rm path) (File/write! path original))))))
