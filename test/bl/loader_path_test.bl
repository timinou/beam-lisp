; test/bl/loader_path_test.bl — the loader's configurable search paths, ported
; from `test/beam_lisp/loader_path_test.exs`.
;
; These exist for one concrete reason: a library that lives outside cwd was
; reachable ONLY as an entry file's own directory, so `spell/src/spell/*.bl`
; could be run but never *tested* — a suite pushes its own directory, not the
; library's. Code you cannot write a test against is code you cannot safely
; move, which is what blocked the priv/ → spell/ migration.
;
; The tests below assert PRECEDENCE, not merely resolution. "The loader found a
; file" is the weak claim; "the loader preferred the right file when two
; declare the same ns" is the one that keeps a configured root from silently
; shadowing a project's own source.
;
; ── coverage map (ExUnit test → BL deftest) ────────────────────────────────
; All eight ExUnit tests map one-to-one onto a same-named BL deftest, in the
; original order, assertion for assertion:
;   add_search_path makes an out-of-cwd library requirable
;   BEAM_LISP_PATH resolves the same way, colon-separated
;   cwd shadows a configured path: a project file still wins
;   a configured path shadows priv/: a shipped library can be overridden
;   priv/ still serves a ns no configured path claims
;   search paths are ambient: they survive a completed nested load
;   add_search_path is idempotent and order-preserving
;   a path added inside a forked env reaches the pinned loader
;
; ADAPTATIONS (ExUnit → ward), and why:
;   * `setup`/`on_exit` (BeamLisp.init/0, clear_search_paths, delete
;     BEAM_LISP_PATH) → `clean-env`, which does the same around each test body.
;     Ward has no per-test setup, and the file's fork is shared by its tests, so
;     clearing explicitly is what keeps one test's path out of the next.
;   * `assert_raise RuntimeError, ~r/…/` keeps BOTH halves: a typed
;     `catch RuntimeError` (any other class fails) plus `re-find` of the same
;     regex on `ex-message`.
;   * `BeamLisp.Compiler.eval_string("(#{ns}/answer)")` → `BeamLisp/eval`, the
;     runtime's own entry (it compiles and runs in the current env).
;   * `Application.app_dir(:beam_lisp, "priv/lib")` → `code:priv_dir(:beam_lisp)`
;     joined with "lib" — the same directory the loader's tier search consults.
;   * The order-preserving assertion captures the ANCESTOR search paths first.
;     The ExUnit suite ran with no env binding, so clearing reset the whole
;     list; a ward file runs in a fork whose reads still fall through to its
;     ancestors, so `search_paths/0` is exactly the fork's own paths followed by
;     theirs. Asserting `["/tmp/one" "/tmp/two"] ++ before` pins the SAME two
;     properties (idempotent, order-preserving) without wiping a shared
;     ancestor's paths out from under a sibling suite.
;
; Run: bin/bl test test/bl/loader_path_test.bl

(ns loader.path.test
  (:require [env]))

(defn- uniq-ns
  "A fresh namespace name; namespaces load ONCE per VM, so reusing a name across
   tests would have the second test assert against the first test's already
   loaded vars — green regardless of the loader's behaviour."
  [prefix]
  (str prefix (erlang/unique_integer (list :positive))))

(defn- write-ns!
  "Write `(ns <ns>)` plus `body` to `dir/<ns>.bl` (dotted names become nested
   directories), answering the path."
  [dir ns body]
  (File/mkdir_p! dir)
  (let [path (Path/join dir (str (String/replace ns "." "/") ".bl"))]
    (File/mkdir_p! (Path/dirname path))
    (File/write! path (str "(ns " ns ")\n" body "\n"))
    path))

(defn- tmp-dir [label]
  (str (System/tmp_dir!) "/" label "_" (erlang/unique_integer (list :positive))))

(defn- clean-env
  "Run `f` with the ambient configuration the ExUnit `setup` gave each test —
   the runtime initialised, no configured search paths, no BEAM_LISP_PATH —
   and restore that clean state afterwards."
  [f]
  (BeamLisp/init)
  (BeamLisp.Env/clear_search_paths)
  (System/delete_env "BEAM_LISP_PATH")
  (try
    (f)
    (finally
      (BeamLisp.Env/clear_search_paths)
      (System/delete_env "BEAM_LISP_PATH"))))

(defn- priv-lib-dir
  "The shipped library tier the loader searches (`priv/lib`)."
  []
  (Path/join (erlang/list_to_binary (erlang/apply :code :priv_dir (list :beam_lisp))) "lib"))

; ── configured search paths ────────────────────────────────────────────────

(deftest add-search-path-makes-an-out-of-cwd-library-requirable
  (clean-env
    (fn []
      (let [dir (tmp-dir "blpath")
            ns (uniq-ns "lptest_lib")]
        (try
          (write-ns! dir ns "(defn answer [] 42)")

          ; Precondition: without the path it is genuinely unreachable. Without
          ; this assertion the test could pass on a loader that searches /tmp.
          (let [e (try (do (BeamLisp.Loader/ensure_loaded ns) nil)
                       (catch RuntimeError ex ex))]
            (is (some? e) "a namespace nowhere on the paths raises RuntimeError")
            (is (includes? (ex-message e) "namespace not found")
                "the miss names the reason"))

          (BeamLisp.Env/add_search_path dir)
          (is (= :ok (BeamLisp.Loader/ensure_loaded ns)))
          (is (= 42 (BeamLisp/eval (str "(" ns "/answer)"))))
          (finally (File/rm_rf! dir)))))))

(deftest beam-lisp-path-resolves-the-same-way-colon-separated
  (clean-env
    (fn []
      (let [base (tmp-dir "blpath_env")
            a (Path/join base "a")
            b (Path/join base "b")
            ns-a (uniq-ns "lptest_a")
            ns-b (uniq-ns "lptest_b")]
        (try
          (write-ns! a ns-a "(defn who [] :from_a)")
          (write-ns! b ns-b "(defn who [] :from_b)")

          (System/put_env "BEAM_LISP_PATH" (str a ":" b))

          (is (= :ok (BeamLisp.Loader/ensure_loaded ns-a)))
          (is (= :ok (BeamLisp.Loader/ensure_loaded ns-b)))
          (is (= :from_a (BeamLisp/eval (str "(" ns-a "/who)"))))
          (is (= :from_b (BeamLisp/eval (str "(" ns-b "/who)"))))
          (finally (File/rm_rf! base)))))))

; ── precedence ─────────────────────────────────────────────────────────────

(deftest cwd-shadows-a-configured-path
  ; The precedence that matters most. If a configured library root could
  ; outrank the project's own source, adding a path would silently change which
  ; code runs — the failure mode is a test suite exercising the wrong copy of a
  ; file it thinks it is editing.
  (clean-env
    (fn []
      (let [ns (uniq-ns "lptest_shadow")
            ; cwd-relative candidate: the loader joins cwd with the ns path, so
            ; the file must sit at cwd/<ns>.bl to be the cwd candidate.
            cwd-file (Path/join (File/cwd!) (str ns ".bl"))
            far-dir (tmp-dir "blpath_far")]
        (try
          (File/write! cwd-file (str "(ns " ns ")\n(defn source [] :cwd)\n"))
          (write-ns! far-dir ns "(defn source [] :configured)")

          (BeamLisp.Env/add_search_path far-dir)
          (is (= :ok (BeamLisp.Loader/ensure_loaded ns)))
          (is (= :cwd (BeamLisp/eval (str "(" ns "/source)")))
              "a project file still wins over a configured path")
          (finally (File/rm! cwd-file) (File/rm_rf! far-dir)))))))

(deftest a-configured-path-shadows-priv
  ; An application must be able to replace a library priv/ ships. Asserted with
  ; a UNIQUE ns planted in priv/lib for the duration, never by overriding a real
  ; shipped library: namespaces load once per VM and the registry is global, so
  ; shadowing a real lib would hand the stub to every sibling suite that
  ; requires it.
  (clean-env
    (fn []
      (let [ns (uniq-ns "lptest_privoverride")
            ; A shipped library lives in a TIER (`priv/lib`), which is what the
            ; loader searches; a flat `priv/` file is not on any path.
            priv-file (Path/join (priv-lib-dir) (str ns ".bl"))
            far-dir (tmp-dir "blpath_override")]
        (File/write! priv-file (str "(ns " ns ")\n(defn source [] :priv)\n"))
        (write-ns! far-dir ns "(defn source [] :configured)")

        (try
          (BeamLisp.Env/add_search_path far-dir)
          (is (= :ok (BeamLisp.Loader/ensure_loaded ns)))
          (is (= :configured (BeamLisp/eval (str "(" ns "/source)")))
              "a configured path overrides the shipped library")
          (finally
            (File/rm! priv-file)
            (File/rm_rf! far-dir)))))))

(deftest priv-still-serves-a-ns-no-configured-path-claims
  ; The other half of the precedence claim: adding a search path must not
  ; DISPLACE priv for namespaces it does not define. Without this, a passing
  ; override test is consistent with a loader that simply stopped consulting
  ; priv at all.
  (clean-env
    (fn []
      (let [ns "loader.path.fallback-fixture"
            priv-file (Path/join (priv-lib-dir) (str (String/replace ns "." "/") ".bl"))
            far-dir (tmp-dir "blpath_privonly")]
        (File/mkdir_p! far-dir)
        (is (File/regular? priv-file) "the SDK fixture is a permanent source input")

        (try
          (BeamLisp.Env/add_search_path far-dir)
          (is (= :ok (BeamLisp.Loader/ensure_loaded ns)))
          (is (= :priv (BeamLisp/eval (str "(" ns "/source)")))
              "priv still serves a namespace no configured path defines")
          (is (tuple? (BeamLisp.AOT/sdk_runtime_inventory!))
              "the retained SDK inventory remains valid after tier selection")
          (finally
            (File/rm_rf! far-dir)))))))

(deftest search-paths-are-ambient-across-a-nested-load
  ; The distinction from load_paths (a stack popped after each load). If search
  ; paths were pushed onto that stack, the first completed require would drop
  ; them and the SECOND require would fail — a bug that only shows up on the
  ; second call, which is why it is asserted explicitly.
  (clean-env
    (fn []
      (let [dir (tmp-dir "blpath_ambient")
            first (uniq-ns "lptest_first")
            second (uniq-ns "lptest_second")]
        (try
          (write-ns! dir first "(defn v [] 1)")
          (write-ns! dir second "(defn v [] 2)")

          (BeamLisp.Env/add_search_path dir)
          (is (= :ok (BeamLisp.Loader/ensure_loaded first)))
          (is (= :ok (BeamLisp.Loader/ensure_loaded second)))
          (is (= 2 (BeamLisp/eval (str "(" second "/v)"))))
          (finally (File/rm_rf! dir)))))))

(deftest add-search-path-is-idempotent-and-order-preserving
  (clean-env
    (fn []
      (let [before (BeamLisp.Env/search_paths)]
        (BeamLisp.Env/clear_search_paths)
        (BeamLisp.Env/add_search_path "/tmp/one")
        (BeamLisp.Env/add_search_path "/tmp/two")
        (BeamLisp.Env/add_search_path "/tmp/one")

        (is (= (concat (list "/tmp/one" "/tmp/two") before)
               (BeamLisp.Env/search_paths))
            "the second add of an existing path is a no-op and order holds")))))

(deftest a-path-added-inside-a-forked-env-reaches-the-pinned-loader
  ; The load runs in Loader.Server, a pinned process whose env binding is
  ; :global. A search path the CALLER added to a forked env used to be invisible
  ; across that hop — Env.search_paths/0 resolves through the caller's chain,
  ; and the binding does not cross processes — so a warm base or test fork could
  ; not load a namespace its own env could see.
  (clean-env
    (fn []
      (let [dir (tmp-dir "blfork")
            ns (uniq-ns "forkpath_lib")]
        (try
          (write-ns! dir ns "(defn answer [] 42)")

          (let [fork (env/fork :global)]
            (env/with-env fork
              (fn []
                (BeamLisp.Env/add_search_path dir)
                (is (= :ok (BeamLisp.Loader/ensure_loaded ns))))))

          (is (= 42 (BeamLisp/eval (str "(" ns "/answer)"))))
          (finally (File/rm_rf! dir)))))))
