; test/bl/reader_literal_test.bl
;
;   ./bl -p priv/boot -p priv/std test test/bl/reader_literal_test.bl
;
; A STRING IS A STRING. This pins the reader on the construct that took the
; checkout down for a day (BUG-090/091, measured): a docstring containing
; backticks.
;
; The failure was not a reader bug in this tree — the reader here reads all of
; these correctly. The failure was BOOTSTRAP: the boot tier is rebuilt by THE
; FLOOR, a previous generation's reader, whose string scanner loses its place at
; a backtick inside a string. It handed the compiler a form that was not a form
; — the docstring split into fragments with the bare symbols `no source
; location` between them — and the compiler died in whichever helper touched it
; first, naming no file and no form.
;
; So this suite has two jobs, and the second is the one that matters:
;
;   1. the tree's reader keeps strings literal (backticks, quotes, em dashes);
;   2. the SHAPE of a defn read back is exactly what the compiler expects — a
;      docstring is ONE element in position 3, not several. Assertion 2 is the
;      mangle detector: the broken generation produced 7 elements where there
;      are 5, and that difference is checkable without knowing WHY a reader
;      would mangle anything.
;
; (2) is cheap enough to run over every tier source before a rebuild, which is
; where it belongs: the generation that cannot read a source is the one that
; rebuilds it, and it is the ONE place the failure can be caught before a
; `:erlang.tuple_to_list` names a helper in a file nobody edited.

(ns reader_literal_test
  (:require [errors]))

(def q (unicode/characters_to_binary (list 34)))     ; "
(def bs (unicode/characters_to_binary (list 92)))    ; \
(def bt (unicode/characters_to_binary (list 96)))    ; `

(defn- quoted
  "A beam-lisp string literal with `body` between its quotes — the reader's own
   spelling, built here so the test's source does not have to escape anything."
  [body]
  (str q body q))

(defn- read-1
  "The single form `src` reads to, or the failure."
  [src]
  (first (BeamLisp.Reader/read_string src "literal_test.bl")))

(defn- list-items
  "The item list of a list node, through the reader's meta wrapper — nil when
   `n` is not a list node. The wrapper is what the reader attaches to every
   collection: {:meta, {:list, items}, pos}."
  [n]
  (cond
    (and (erlang/is_tuple n) (= 3 (erlang/tuple_size n)) (= :meta (erlang/element 1 n)))
      (list-items (erlang/element 2 n))
    (and (erlang/is_tuple n) (= 2 (erlang/tuple_size n)) (= :list (erlang/element 1 n)))
      (erlang/element 2 n)
    :else nil))

; ── 1. a string is literal ───────────────────────────────────────────────────

(deftest backticks-inside-a-string-are-literal
  (let [doc (str "a " bt "kind" bt " b")]
    (is (= doc (read-1 (quoted doc)))
        "backticks must survive inside a string, not terminate it")))

(deftest the-outage-docstring-reads-as-one-string
  ; The exact text of typed.bl's warn! docstring when it broke the boot: three
  ; backticked phrases, a colon-keyword, an em dash, an inner :ann.
  (let [doc (str "sentinel for " bt "no source location" bt ", which is a case")]
    (is (= doc (read-1 (quoted doc)))
        "the whole docstring is ONE string, verbatim")))

(deftest an-escaped-quote-stays-inside-the-string
  (let [content (str "say " q "once" q)
        src (str q "say " bs q "once" bs q q)]
    (is (= content (read-1 src))
        "an escaped quote is content, not a terminator")))

(deftest an-em-dash-survives
  (let [doc (str "a — b")]              ; 3 codepoints, 5 bytes
    (is (= doc (read-1 (quoted doc)))
        "a multi-byte character inside a string is one character")))

; ── 2. the shape a defn reads back to ────────────────────────────────────────

(deftest a-docstring-is-one-element-in-position-3
  (let [doc (str "a " bt "kind" bt " b " bt "no source x" bt " c")
        src (str "(defn f " (quoted doc) " [a] a)")
        items (list-items (read-1 src))
        [_ nm d] items]
    (is (= 5 (erlang/length items))
        "a defn is (defn name doc params body) — five elements, never more")
    (is (= "f" (erlang/element 2 nm))
        "element 2 is the name symbol")
    (is (= doc d)
        "element 3 is the docstring, whole")))

(deftest a-mangled-defn-is-detectable-by-element-count
  ; The shape the broken generation produced: the docstring's tail became its
  ; own element after three bare symbols. This is what makes (2) a detector
  ; rather than a wish — the two shapes differ in a way a checker can see.
  (let [mangled "(defn f \"a \" no source \" b\" [a] a)"
        items (list-items (read-1 mangled))]
    (is (> (erlang/length items) 5)
        "the mangled shape is LONGER than a defn — the difference is the tell")))

(deftest a-defn-without-a-docstring-is-still-four-or-more
  (let [items (list-items (read-1 "(defn f [a] a)"))]
    (is (= 4 (erlang/length items))
        "(defn name params body) has no docstring element at all")))
