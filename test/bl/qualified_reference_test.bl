(ns qualified-reference.test (:require [anf :as anf]))

(defn- evaluate [source]
  (let [outer (BeamLisp.Env/capture)]
    (try {:value (BeamLisp/eval source)}
      (catch e {:error (ex-message e)})
      (finally (BeamLisp.Env/bind outer)))))

(deftest an-explicit-provider-never-falls-through-to-a-core-name
  (doseq [form ["(idx/identity 42)" "(let [f idx/identity] (f 42))"
               "(datom.index/identity 42)"]]
    (let [result (evaluate (str "(ns qualified-reference.consumer (:require [datom.index :as idx]))\n" form))]
      (is (some? (:error result)))
      (is (and (:error result) (String/contains? (:error result) "datom.index/identity")))))
  (is (= 42 (:value (evaluate "(ns qualified-reference.control) (identity 42)"))))
  (is (= 42 (:value (evaluate "(ns qualified-reference.control) (core/identity 42)")))))


(deftest exact-lookup-is-a-validated-executable-field
  (let [body (anf/global-exact "datom.index" "identity")
        descriptor (fn [node] (anf/module :"Elixir.ExactLookupFixture"
                                 (list {:op :defn-clause :fname :run :params (list)
                                        :guard nil :body node :ann {}})
                                 (list) (list)))]
    (is (map? (descriptor body)))
    (is (thrown? (descriptor (assoc body :lookup :approximate))))
    (is (thrown? (descriptor (assoc body :extra true))))))

(deftest declared-reexports-preserve-exact-member-identity-without-core-fallback
  (BeamLisp.Env/intern "qualified.provider" "identity" :provided)
  (BeamLisp.Env/add_refer "qualified.facade" "identity" "qualified.provider")
  (BeamLisp.Env/add_refer "qualified.outer" "identity" "qualified.facade")
  (is (= :provided (BeamLisp.Env/fetch_exact! "qualified.facade" "identity")))
  (is (= :provided (BeamLisp.Env/fetch_exact! "qualified.outer" "identity")))
  (BeamLisp.Env/intern "qualified.facade" "identity" :own)
  (is (= :own (BeamLisp.Env/fetch_exact! "qualified.facade" "identity")))
  (BeamLisp.Env/add_refer "qualified.cycle-a" "identity" "qualified.cycle-b")
  (BeamLisp.Env/add_refer "qualified.cycle-b" "identity" "qualified.cycle-a")
  (is (= :error (BeamLisp.Env/fetch_exact "qualified.cycle-a" "identity"))))
