; test/bl/view_test.bl — defview: the page as three planes.
; Run: mix beam_lisp.test test/bl/view_test.bl
;
; ── why three planes, and why they are FLAT ─────────────────────────────────
;
; `StFile` has three, and they are bound by SELECTOR, not by nesting:
;
;   markup  — `@template &card($c) { <article>…</article> }`, a DOM tree
;   style   — `.card { border-radius: 0.75rem; }`, CSS regions
;   binds   — `.card { @drag(…) { … } }`, behaviour attached
;
; That is why `.card` legitimately appears in more than one: one template is
; styled by many rules, one rule hits many templates. An earlier design of mine
; collapsed them into "one element, one place" — it would have destroyed the
; many-to-many the language is built on, so these tests pin the separation.
;
; markup NESTS (a DOM is a tree); style and binds are FLAT selector lists.
; The file's shape mirrors the MODEL, not the DOM.
;
; Every document here was fed through verse's own `to_st_file` and confirmed to
; produce the scopes and constructs it claims.

(ns spell.view.test
  (:require [spell.contract :refer [parse-view view-document]]
            [spell.live :refer [css-prop]]))

;; ── planes are separated, and an unknown one FAILS ──────────────────────────

(deftest parses-the-three-planes
  (let [v (parse-view :x (list (quote (markup (template &a [$m] [:p "x"])))
                               (quote (style [".a" {:color "red"}]))
                               (quote (binds [".a" (st/on :click (fire :go))]))))]
    (is (= 1 (count (get v :markup))))
    (is (= 1 (count (get v :style))))
    (is (= 1 (count (get v :binds)))))) 

(deftest an-unknown-plane-fails-rather-than-being-ignored
  ; a silently-dropped plane is a page missing its styles
  (is (thrown? (parse-view :x (list (quote (scripts "alert(1)")))))))

(deftest an-empty-view-is-legal
  (let [v (parse-view :x (list))]
    (is (= [] (get v :markup)))
    (is (= [] (get v :style)))
    (is (= [] (get v :binds)))))

;; ── style ───────────────────────────────────────────────────────────────────

(deftest style-emits-scopes
  (let [d (view-document (parse-view :x (list (quote (style [".chat" {:display "grid"}])))) [])]
    (is (includes? d ":st/scopes ["))
    (is (includes? d "{:selector \".chat\" :decls {\"display\" \"grid\"}}"))))

(deftest declaration-keys-are-sorted
  ; deterministic output: the same view must emit the same bytes
  (let [d (view-document (parse-view :x (list (quote (style [".a" {:zoom "1" :color "red"}])))) [])]
    (is (includes? d "{\"color\" \"red\" \"zoom\" \"1\"}"))))

(deftest inject-emits-the-ARROW-not-a-css-property
  ; `<-` (DOM injection) and `:` (CSS surface) route differently at runtime —
  ; setAttribute vs style.setProperty. Collapsing them silently reroutes a
  ; reactive binding, which is BUG-091 in verse.
  (let [d (view-document (parse-view :x (list (quote (style [".v" {:text (inject @count)}])))) [])]
    (is (includes? d "[:st/inject \"$count\"]"))
    (is (not (includes? d "\"text\" \"$count\"")))))

(deftest a-seam-binding-becomes-a-signal
  ; `@count` is ONE name resolved per runtime: `socket.assigns.count` on the
  ; BEAM, `$count` in Spacetime. The author never writes the mapping.
  (let [d (view-document (parse-view :x (list (quote (style [".v" {:text (inject @count)}])))) [])]
    (is (includes? d "$count"))
    (is (not (includes? d "@count")))))

;; ── markup ──────────────────────────────────────────────────────────────────

(deftest markup-emits-a-construct-body
  (let [d (view-document (parse-view :x (list (quote (markup (template &bubble [$m] [:p "hi"]))))) [])]
    (is (includes? d ":st/constructs ["))
    (is (includes? d ":kind \"template\""))
    ; the parser's construct scopes are keyed `@template:<name>` with the BARE
    ; name — `&bubble` is an element ref, and the `&` is not part of it
    (is (includes? d ":selector \"@template:bubble\""))
    (is (not (includes? d "@template:&bubble")))))

(deftest holes-in-a-template-body-are-backtick-expressions
  ; A hole is a BINDING, but HOW it is spelled depends on the plane it lands in.
  ;
  ; The `:st/html` plane carries `[:st/hole N]` markers plus an ordered
  ; expression list, because a top-level HTML block must be ADDRESSABLE — that
  ; is BUG-369, and it is what lets optics patch a node instead of running a
  ; regex over text.
  ;
  ; A `@template` BODY is a different plane: it is reconstructed as source, and
  ; it spells its holes inline as backtick expressions. Confirmed by parsing a
  ; real `.st` file and reading the construct scope back:
  ;   html = "<article data-role=\"`$m.role`\">…"
  ;
  ; Emitting markers here instead printed `data-role=[:st/hole 0]` — a literal,
  ; unparseable attribute value where an interpolation belonged. The tests that
  ; used to live here asserted the marker spelling and passed, because they
  ; checked the emitter against ITSELF rather than against the grammar.
  (let [d (view-document (parse-view :x (list (quote (markup (template &b [$m] [:p @m.text]))))) [])]
    (is (includes? d "`$m.text`"))
    (is (not (includes? d ":st/hole")))
    (is (not (includes? d "{@m.text}")))))

(deftest every-hole-in-a-body-is-converted-not-just-the-first
  (let [d (view-document (parse-view :x (list (quote (markup (template &b [$m] [:i @m.a] [:b @m.b]))))) [])]
    (is (includes? d "`$m.a`"))
    (is (includes? d "`$m.b`"))))

(deftest markup-without-holes-is-carried-verbatim
  (let [d (view-document (parse-view :x (list (quote (markup (template &b [] [:hr]))))) [])]
    (is (includes? d "\"<hr>\""))
    (is (not (includes? d ":st/hole")))))

(deftest raw-markup-passes-through-verbatim
  ; [:st/raw ...] is the explicit escape hatch for verbatim HTML; no tree parsing.
  (let [d (view-document (parse-view :x (list (quote (markup (template &b [] [:st/raw "<p>{oops</p>"]))))) [])]
    (is (includes? d "oops"))
    (is (includes? d "</p>"))))

;; ── binds ───────────────────────────────────────────────────────────────────

(deftest text-content-is-html-escaped
  (let [d (view-document (parse-view :x (list (quote (markup (template &b [] [:p "a < b & c"]))))) [])]
    (is (includes? d "a &lt; b &amp; c"))
    (is (not (includes? d "a < b")))))

(deftest a-boolean-attribute-is-bare
  (let [d (view-document (parse-view :x (list (quote (markup (template &b [] [:div {:data-log true}]))))) [])]
    (is (includes? d "<div data-log></div>"))))

(deftest class-shorthand-merges-with-the-class-attr
  (let [d (view-document (parse-view :x (list (quote (markup (template &b [] [:div.a.b {:class "c"}]))))) [])]
    (is (includes? d "class='a b c'"))))

(deftest binds-emit-the-REGISTERED-macro-name
  ; `on` is only how the directive is SPELLED in .st source; the registry knows
  ; it as `on-driver-body`. The EDN reader refuses to invent syntax —
  ;   unknown macro "on" — no `%macro` of that name is registered
  ; — which is how emitting the source spelling was caught immediately.
  (let [d (view-document (parse-view :x (list (quote (binds [".b" (st/on :click (fire :send))])))) [])]
    (is (includes? d "(on-driver-body"))
    (is (includes? d "\"member\" click"))
    (is (includes? d "\"signal\" send"))))

(deftest fire-names-the-signal-the-page-sends
  ; this is how a bind reaches the seam the contract declares.
  ;
  ; `{"stmt" {"args" … "signal" name}}` is the shape `on_signal_call` produces,
  ; read off the printer for `@on &.click { $send($draft); }`. An earlier
  ; version invented `"call"`/`"target"` — keys no capture type declares — and
  ; the document still PARSED, so nothing here objected. It printed back as
  ; `$.($draft,)`: a call with no callee.
  ;
  ; Hence the second assertion. Checking the emitted keys only proves the
  ; emitter agrees with itself; printing the document back and reading what it
  ; SAYS is what catches an invented spelling.
  (let [d (view-document (parse-view :x (list (quote (binds [".b" (st/on :click (fire :inc))])))) [])]
    (is (includes? d "\"signal\" inc"))
    (is (not (includes? d "\"target\" inc")))))

(deftest a-view-with-no-binds-emits-an-empty-forms-list
  (let [d (view-document (parse-view :x (list (quote (style [".a" {:color "red"}])))) [])]
    (is (includes? d ":st/forms []"))))

;; ── the document ────────────────────────────────────────────────────────────

(deftest emits-a-document-the-ingress-path-accepts
  ; The whole validation story: a generated page enters at the SAME parse step
  ; a hand-written `.st` does, so E0928, the corpus gate and every %form
  ; validator apply unchanged. The generated half cannot be less checked than
  ; the hand-written one.
  (let [d (view-document (parse-view :x (list (quote (style [".a" {:color "red"}])))) ["stdlib/macros/data-kind"])]
    (is (starts-with? d "{:st/imports ["))
    (is (includes? d "\"stdlib/macros/data-kind\""))
    (is (includes? d ":st/forms ["))
    (is (includes? d ":st/scopes ["))))

(deftest all-three-planes-in-one-document
  (let [d (view-document
            (parse-view :chat
              (list (quote (markup (template &bubble [$m] [:article @m.text])))
                    (quote (style [".bubble" {:padding "0.75rem"}]))
                    (quote (binds [".composer__send" (st/on :click (fire :send))]))))
            [])]
    (is (includes? d ":st/constructs ["))
    (is (includes? d ":st/scopes [{:selector \".bubble\""))
    (is (includes? d "(on-driver-body"))))

;; ── a template is TWO things ────────────────────────────────────────────────
;;
;; The defect these pin was invisible to every test above, because every test
;; above asked whether the emitter produced the shape the emitter intended. It
;; did. What it never produced was the DECLARATION.
;;
;; In an `StFile` a template is a form in `:st/forms` (`(template :name … )`)
;; AND a `Construct("template")` scope carrying its body. Emitting only the
;; scope yields a document that reads back with three template bodies and zero
;; template declarations — so `@each` invokes a template the file never
;; declares, and the page renders nothing.
;;
;; It was found by comparing the emitted document against a real one:
;;   hand-written chat.st  → matches=7 scopes=13
;;   emitted view.edn      → matches=3 scopes=12   ← no template form at all
;; The lesson is the same one three times over in this build: a test that
;; measures the emitter against itself cannot see an omission.

(deftest a-template-emits-its-declaring-form
  (let [d (view-document (parse-view :x (list (quote (markup (template &bubble [$m] [:p @m.text]))))) [])]
    (is (includes? d "(template :name bubble"))
    (is (includes? d ":body [:st/component-body]"))
    ; and still its body scope — both, not either
    (is (includes? d ":selector \"@template:bubble\""))))

(deftest a-template-parameter-carries-the-paramlist-shape
  ; `["m" :binding false nil nil false]` — name WITHOUT the `$`, then the
  ; capture kind and the variadic/default/type/optional slots. Copied from the
  ; printer's own output rather than guessed: a paramlist the parser cannot
  ; read makes the whole template silently unparseable.
  (let [d (view-document (parse-view :x (list (quote (markup (template &b [$m] [:p "x"]))))) [])]
    (is (includes? d "[:st/paramlist [\"m\" :binding false nil nil false]]"))))

(deftest a-zero-parameter-template-still-declares-an-empty-paramlist
  (let [d (view-document (parse-view :x (list (quote (markup (template &shell [] [:main]))))) [])]
    (is (includes? d "(template :name shell :params [:st/paramlist ]"))))

(deftest every-template-is-declared-not-just-the-first
  (let [d (view-document
            (parse-view :chat
              (list (quote (markup (template &shell [] [:main])
                                   (template &bubble [$m] [:p @m.text])
                                   (template &thinking [] [:i])))))
            [])]
    (is (includes? d "(template :name shell"))
    (is (includes? d "(template :name bubble"))
    (is (includes? d "(template :name thinking"))))

(deftest declarations-precede-the-binds-that-invoke-them
  ; `.log`'s `@each` invokes `&bubble`; the file must declare it first. The
  ; printer emits forms in order, so order in the document is order in the page.
  (let [d (view-document
            (parse-view :chat
              (list (quote (markup (template &bubble [$m] [:p @m.text])))
                    (quote (binds [".log" (st/each @messages :as @m :template &bubble)]))))
            [])]
    (is (< (index-of d "(template :name bubble") (index-of d "(sel \".log\"")))))

(deftest an-each-invocation-names-its-template-as-a-string
  ; `{"args" [:st/array "$m"] "name" "bubble"}` with `:key` present — the shape
  ; the printer produces for the same construct. Bare symbols instead printed
  ; `@each(…) { [$m] bubble }`: the invocation inverted and unparseable.
  (let [d (view-document
            (parse-view :x (list (quote (binds [".log" (st/each @messages :as @m :template &bubble)]))))
            [])]
    (is (includes? d "\"name\" \"bubble\""))
    (is (includes? d "\"args\" [:st/array \"$m\"]"))
    (is (includes? d ":key [:st/expr \"null\"]"))))

;; ── where a hole SITS decides how it is spelled ─────────────────────────────
;;
;; Position in the tree decides spelling: attr-map values are quoted;
;; child holes are unquoted text expressions.

(deftest a-hole-in-attribute-position-is-quoted
  ; Holes in attr map values are double-quoted by the emitter; attr position is tree position.
  (let [d (view-document (parse-view :x (list (quote (markup (template &b [$m] [:p {:data-r @m.r} "y"]))))) [])]
    (is (includes? d "data-r=\\\"`$m.r`\\\""))
    (is (not (includes? d "data-r='`$m.r`'")))))

(deftest a-hole-in-text-position-is-NOT-quoted
  ; Holes in text children are unquoted; text position is tree position (child, not attr map).
  (let [d (view-document (parse-view :x (list (quote (markup (template &b [$m] [:p "x=" @m.v]))))) [])]
    (is (includes? d "x=`$m.v`"))
    (is (not (includes? d "x='`$m.v`'")))))

(deftest an-equals-with-spaces-in-prose-is-text
  (let [d (view-document (parse-view :x (list (quote (markup (template &b [$m] [:p "a = " @m.x]))))) [])]
    (is (includes? d "a = `$m.x`"))
    (is (not (includes? d "'`$m.x`'")))))

(deftest a-mixed-attribute-value-is-a-part-list
  ; The author never writes the quoting anymore; tree position tells the emitter.
  (let [d (view-document (parse-view :x (list (quote (markup (template &b [$m] [:p {:data-v ["pre-" @m.x]} "y"]))))) [])]
    (is (includes? d "data-v=\\\"pre-`$m.x`\\\""))))

;; ── @view: binding a scalar assign to a template ────────────────────────────

(deftest view-emits-scoped-dispatch
  ;; `@status` was declared, `&thinking` was declared AND styled, and nothing
  ;; connected them. `@view` (stdlib/enum/dispatch) is the affordance: reactive
  ;; dispatch that re-mounts the matching arm when the signal changes.
  (let [v (parse-view :v
            (list (quote (markup (template &spin [] [:i {:class "spin"}])))
                  (quote (style [".spin" {:color "red"}]))
                  (quote (binds [".slot" (st/view @status ["thinking" &spin])]))))
        d (view-document v ["stdlib/enum/dispatch"])]
    ;; the arm must carry a template INVOCATION, not a bare word: verse's
    ;; printer turned `&spin()` into `"spin"` (BUG-373), which re-parses as an
    ;; arm whose consequence is a string and mounts nothing.
    (is (includes? d "\"name\" \"spin\""))
    (is (includes? d "\"lit\" \"thinking\""))
    ;; and it must be SCOPED: `dispatch-mount` mounts into `&self`, so a bare
    ;; file-level @view has nowhere to put the template (BUG-374).
    (is (includes? d "(sel \".slot\""))))

(deftest view-wildcard-arm-is-not-a-literal
  ;; `_` as a NAME is the catch-all; `"_"` as a literal matches only a tag
  ;; spelled `_`. Collapsing them yields a page that matches everything or
  ;; nothing — the same distinction `seam/arm-decodes?` already models.
  (let [v (parse-view :w
            (list (quote (markup (template &a [] [:i {:class "a"}])))
                  (quote (style [".a" {:color "red"}]))
                  (quote (binds [".s" (st/view @status ["thinking" &a] [_ &a])]))))
        d (view-document v ["stdlib/enum/dispatch"])]
    (is (includes? d "\"wild\" _"))))

;; ── the stylesheet the BROWSER loads ────────────────────────────────────────

(deftest a-camelcase-property-is-folded-to-kebab-case
  ;; The silent failure that reached a served page. A model asked for an
  ;; uppercase label emitted `:textTransform "uppercase"` — the JS spelling it
  ;; sees in every `element.style.x` example. CSS has no such property, so the
  ;; browser DROPS the declaration with no console message: the element
  ;; rendered, in the wrong case, and `getComputedStyle` was the only witness.
  ;;
  ;; Every rung passed it. The class is rendered, the selector is bound, and
  ;; verse compiles a stylesheet containing `textTransform: uppercase;` without
  ;; complaint — it is not verse's job to know the CSS property registry.
  ;;
  ;; Asserted on the EMITTED text, not on `css-prop` alone: the property this
  ;; protects is that the stylesheet a browser loads contains valid CSS, and a
  ;; test of the helper in isolation would keep passing if `css-decl` stopped
  ;; calling it.
  (is (= "text-transform" (css-prop :textTransform)))
  (is (= "font-size" (css-prop :fontSize)))
  ;; already-correct spellings are untouched
  (is (= "font-size" (css-prop :font-size)))
  (is (= "color" (css-prop :color))))

(deftest a-custom-property-keeps-its-capitals
  ;; `--myVar` and `--my-var` are DIFFERENT names in CSS: custom properties are
  ;; case-sensitive and are not folded. Normalising one would silently break a
  ;; page whose var() reference kept the capital.
  (is (= "--myVar" (css-prop :--myVar)))
  (is (= "--brand" (css-prop :--brand))))
