; test/bl/spell/provider_cassette_test.bl — the loop's provider half, offline.
; Run: mix beam_lisp.test test/bl/spell/provider_cassette_test.bl
;
; Every fixture here is a REAL turn from a live glm-5.3, recorded by
; `scripts/record_cassette.exs`. That is the whole point: a hand-written
; fixture only proves the test agrees with itself, and the shapes that matter
; most — where a provider chooses to break an SSE frame — are precisely the
; ones nobody would guess correctly.
;
; ── the defect these exist to keep dead ─────────────────────────────────────
;
; Two loops were built. The one that could call tools could not stream
; (`ask-turn` is synchronous); the one that streamed offered no tools and threw
; tool-call deltas away, because `parse-sse-deltas` keeps only `content`
; fields. So a streamed turn that asked for `define` decoded to nothing: the
; page showed an empty answer, and the machine never grew. Nothing raised.
;
; `stream-tool-call.edn` is that exact turn, recorded: 163 SSE frames, one
; `define` call whose 412 bytes of arguments are split across them. If the
; assembly regresses, this suite fails; before W2 it could not have passed.
;
; ── what is NOT tested here ─────────────────────────────────────────────────
;
; That the recordings match what the provider would send TODAY. Nothing can
; test that offline, and pretending otherwise is how a cassette suite becomes
; a fossil. Re-record when a provider changes shape; the recorder prints what
; it captured so the change is visible when it happens.

(ns spell.provider-cassette.test
  (:require [spell.cassette :refer [replay recorded-request read-cassette]]
            [spell.provider :refer [extract-turn parse-sse-deltas stream-tool-calls
                                    send-request transport]]))

;; ── the transport seam ──────────────────────────────────────────────────────

(deftest transport-defaults-to-httpc
  ;; The safe default is the real one: a cfg that forgot to say means "call the
  ;; provider", never "quietly answer with a fixture".
  (is (= :httpc (transport {:model "m"}))))

(deftest transport-is-chosen-by-DATA-not-by-an-env-var
  (is (= :fake (transport {:transport :fake})))
  (is (= {:cassette "x"} (transport {:transport {:cassette "x"}}))))

;; ── replay ──────────────────────────────────────────────────────────────────

(deftest a-recorded-content-turn-decodes-as-content
  (let [r (replay "content-turn" "" false)
        turn (extract-turn (get r :body))]
    (is (= 200 (get r :status)))
    (is (= :content (get turn :kind)))
    ;; A real model wrote this; assert it said SOMETHING rather than pinning
    ;; its prose, which would make the test a transcript of one sampling.
    (is (> (count (get turn :content)) 0))
    (is (= [] (get turn :tool-calls)))))

(deftest a-recorded-tool-turn-decodes-as-a-tool-call
  (let [r (replay "tool-call" "" false)
        turn (extract-turn (get r :body))
        calls (get turn :tool-calls)]
    (is (= :tool-calls (get turn :kind)))
    (is (= 1 (count calls)))
    (is (= "define" (get (first calls) :name)))
    ;; `arguments` is a JSON STRING on the wire. Decoded, never parsed, by the
    ;; provider layer — parsing belongs to whoever knows the tool's schema.
    (is (includes? (get (first calls) :arguments) "\"kind\""))))

;; ── the streaming half ──────────────────────────────────────────────────────

(deftest a-recorded-stream-yields-content-deltas
  (let [r (replay "stream-content" "" true)
        deltas (parse-sse-deltas (get r :body))]
    (is (> (count deltas) 1))
    ;; More than one delta is the assertion that matters: a single delta would
    ;; mean the page renders the finished answer in one frame, which is the
    ;; thing streaming exists NOT to do.
    (is (every? (fn [d] (string? d)) deltas))))

(deftest a-recorded-stream-carries-no-tool-calls-when-there-are-none
  ;; The negative half. Without it, a `stream-tool-calls` that returned a
  ;; spurious call for every stream would still pass the positive test.
  (is (= [] (stream-tool-calls (get (replay "stream-content" "" true) :body)))))

(deftest a-tool-call-SPLIT-ACROSS-FRAMES-is-reassembled
  ;; The turn that was undecodable before W2, recorded from a live model:
  ;; 163 SSE frames, one `define` call, its arguments split across them.
  (let [body (get (replay "stream-tool-call" "" true) :body)
        calls (stream-tool-calls body)]
    (is (= 1 (count calls)))
    (is (= "define" (get (first calls) :name)))

    ;; Reassembly is the claim, so assert the JOIN: the arguments must be
    ;; syntactically whole. A per-frame decoder would produce a fragment that
    ;; looks plausible and parses as nothing.
    (let [args (get (first calls) :arguments)]
      (is (starts-with? args "{"))
      (is (ends-with? args "}"))
      (is (includes? args "\"kind\""))
      (is (includes? args "\"name\"")))))

(deftest a-streamed-tool-turn-has-no-content-to-render
  ;; Why `stream` sends `[:tool-calls …]` INSTEAD of deltas rather than as well
  ;; as: the assistant's content on a tool turn is empty by construction, so
  ;; streaming it would flash a blank bubble before the machine changes.
  (is (= [] (parse-sse-deltas (get (replay "stream-tool-call" "" true) :body)))))

;; ── the request, which is the half that had no coverage ─────────────────────

(deftest a-recorded-tool-request-actually-OFFERED-the-tool
  ;; The defect this whole cluster exists for was not a decoding bug: the
  ;; served page's cfg had no `:tools` key, so `request-body` omitted the array
  ;; and the model was structurally INCAPABLE of proposing anything. Every test
  ;; passed, because every test only ever looked at responses.
  (let [req (recorded-request "tool-call")]
    (is (includes? req "\"tools\""))
    (is (includes? req "\"define\""))
    ;; The schema travels with the declaration, or the model is guessing at
    ;; field names.
    (is (includes? req "\"parameters\""))))

(deftest a-recorded-non-tool-request-offers-NO-tools
  ;; An empty `tools` array is not the same as no key: some providers reject
  ;; `"tools":[]`, and an offered-but-empty tool list is a claim we do not mean
  ;; to make.
  (is (not (includes? (recorded-request "content-turn") "\"tools\""))))

(deftest a-streaming-request-says-so
  (is (includes? (recorded-request "stream-content") "\"stream\":true"))
  (is (includes? (recorded-request "content-turn") "\"stream\":false")))

;; ── replay refuses the mismatch that reads as a broken provider ─────────────

(deftest replaying-a-single-turn-as-a-stream-is-REFUSED
  ;; Silence is the worst possible answer here: a caller expecting SSE deltas
  ;; that receives a single JSON body renders nothing and reads it as a broken
  ;; stream. Saying so names the cassette and both shapes.
  (let [r (replay "content-turn" "" true)]
    (is (not (nil? (get r :error))))
    (is (= "single" (get (get r :error) :recorded)))
    (is (= "stream" (get (get r :error) :wanted)))))

(deftest a-missing-cassette-says-where-it-looked
  (let [r (replay "no-such-recording" "" false)]
    (is (not (nil? (get r :error))))
    (is (includes? (get (get r :error) :looked-in) "no-such-recording"))))

;; ── the canned answer, for checks that carry no fixtures ────────────────────

(deftest the-fake-transport-answers-in-the-providers-own-shape
  ;; Not a second code path: the same decoders run over it. `stream-fake` used
  ;; to imitate the message protocol without building a request or parsing a
  ;; frame, so every bug in those was invisible to the offline path that
  ;; existed to catch bugs.
  (let [single (send-request {:transport :fake :model "m"} [{:role "user" :content "hi"}] false)
        streamed (send-request {:transport :fake :model "m"} [{:role "user" :content "hi"}] true)]
    (is (= :content (get (extract-turn (get single :body)) :kind)))
    (is (> (count (parse-sse-deltas (get streamed :body))) 1))))
