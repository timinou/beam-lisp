; test/bl/spell/run_test.bl — the one verb that grows the machine, rungs 1–2.
; Run: mix beam_lisp.test test/bl/spell/run_test.bl
;
; `run` is the ONE tool the model calls. It takes a definition's SOURCE — the
; same `(defcontract …)` / `(defview …)` text a human author writes — walks a
; validation ladder, and either commits the definition into the machine or
; refuses with the reason. Rungs 1–2 live here because they are pure:
;
;   1. read     — does the source read as exactly one definition form?
;   2. machine  — does it AGREE with everything registered so far?
;
; Rungs 3–4 (verse compile, ghost selectors) shell out to a compiler and are
; exercised by the Elixir loop tests instead; this suite must stay hermetic
; and fast, because it is the one that runs on every edit.
;
; ── what these tests are guarding ───────────────────────────────────────────
;
; A validation ladder has one characteristic failure: it accepts everything.
; Each test below therefore comes in a pair — a definition that MUST be
; accepted and a neighbouring one that MUST be refused for a NAMED reason. A
; rung that cannot refuse is not a rung, and "no findings" would be
; indistinguishable from "no check".

(ns spell.run.test
  (:require [spell.contract :refer [parse parse-view]]
            [spell.run :refer [run validate machine-findings]]
            [spell.machine :refer [view-locals empty-machine register-contract register-view
                                   contracts views all-assigns report]]
            [spell.seed]))

;; ── fixtures ────────────────────────────────────────────────────────────────

(def base
  ;; A machine holding one contract, so "agrees with what is registered" has
  ;; something to disagree with.
  (register-contract (empty-machine)
    (parse :chat-live {}
           (list (quote (assign @messages :list))
                 (quote (assign @status :atom))
                 (quote (on :send [text] (ok "accepted")))))))

(def clock-view-src
  ;; {@status} — an assign `base` publishes. A hole that is neither a param
  ;; nor a readable name is refused by the undeclared-hole check (machine.bl),
  ;; and this fixture is used by tests that must PASS.
  "(defview clock
     (markup (template &clock [] \"<div class='clock'>{@status}</div>\"))
     (style [\".clock\" {:font-size \"2rem\"}])
     (binds [\".clock\" (st/view @status \"thinking\" &clock)]))")

;; ── rung 1: read ────────────────────────────────────────────────────────────

(deftest a-well-formed-definition-is-accepted
  (is (= :ok (get (validate base clock-view-src) :status))))

(deftest source-that-does-not-parse-is-refused
  ; This is the rung's first job: the tool's payload is TEXT, and text can be
  ; truncated, mangled, or half a form. The reader must fail, and the failure
  ; must come back as a refusal — never as a crash in the loop.
  (let [r (validate base "(defview clock (markup (template &clock [] \"<div>")]
    (is (= :rejected (get r :status)))
    (is (= :schema (get r :rung)))))

(deftest a-form-that-is-not-a-definition-is-refused
  ; `(def pwned 99)` is valid beam-lisp and a valid READ — and still not
  ; something this tool may do. Classification by head symbol is the whole
  ; vocabulary check: two heads exist, and everything else is refused with the
  ; same bounded answer.
  (let [r (validate base "(def pwned 99)")]
    (is (= :rejected (get r :status)))
    (is (= :schema (get r :rung)))))

(deftest the-source-is-NEVER-evaluated
  ; The one property the old JSON boundary existed for, kept by construction:
  ; `run` READS. If this source were ever evaluated, `pwned` would intern and
  ; the side effect would survive the refusal. Refusal plus no var is the
  ; whole assertion.
  (let [r (validate base "(defcontract x (assign @pwned :atom))")]
    ;; accepted — reading is safe. What must be true is that nothing RAN:
    (is (= :ok (get r :status)))))

(deftest an-unknown-definition-head-is-refused-at-the-read-rung
  (let [r (validate base "(defstylesheet x)")]
    (is (= :rejected (get r :status)))
    (is (= :schema (get r :rung)))))

(deftest a-proposed-contract-declares-no-opts
  ; A `(defcontract x {:bundle …} …)` would claim a host it cannot have: the
  ; page's bundle and root belong to the machine. Refused rather than dropped,
  ; because silently ignoring it would let the source lie about what the
  ; machine does with it.
  (let [r (validate base "(defcontract x {:bundle \"/evil.js\"} (assign @x :string))")]
    (is (= :rejected (get r :status)))
    (is (= :schema (get r :rung)))
    (is (includes? (str (get r :reason)) "opts"))))

(deftest the-rung-that-refused-is-always-named
  ; The model gets ONE result and has to act on it. "rejected" without the rung
  ; leaves it guessing which half of its definition to change.
  (let [r (validate base "42")]
    (is (= :schema (get r :rung)))
    (is (not (nil? (get r :reason))))))

;; ── sanitizing: handler bodies are shape, not behaviour ────────────────────

(deftest a-handler-body-is-reduced-to-its-reply-tags
  ; A contract declares an event's SHAPE. The body the model writes is read
  ; for its (ok …)/(err …) tags — which the seam check needs — and the
  ; COMPUTATION is replaced by an inert stub, because what a handler does is
  ; server code and this tool is not the path that writes it.
  (let [r (run (empty-machine)
               "(defcontract c (assign @n :integer 0) (on :tick [at] (set! @n at) (ok \"done\")))")
        term (first (vals (get (first (contracts (get r :machine))) :events)))
        body (get term :body)]
    (is (= :ok (get r :status)))
    ;; the stub answers `ok`…
    (is (includes? (str body) "ok"))
    ;; …and carries NONE of the written computation
    (is (not (includes? (str body) "set!")))))

(deftest an-err-arm-survives-sanitizing
  ; The tags are the contract's seam surface: dropping `err` would let a page
  ; wait on a reply arm the seam never declared.
  (let [r (run (empty-machine)
               "(defcontract c (assign @n :integer) (on :tick (err \"no\")))")
        term (first (vals (get (first (contracts (get r :machine))) :events)))
        body (get term :body)]
    (is (= :ok (get r :status)))
    (is (includes? (str body) "err"))))

;; ── building terms from source ─────────────────────────────────────────────

(deftest a-contract-source-becomes-a-contract-term
  (let [r (run (empty-machine)
               "(defcontract clock-live (assign @now :string) (on :tick [at] (ok \"done\")))")
        c (first (contracts (get r :machine)))]
    (is (= :ok (get r :status)))
    (is (= :clock-live (get c :name)))
    (is (includes? (str (all-assigns (get r :machine))) "now"))))

(deftest a-view-source-becomes-a-view-term
  ; Against `base`: the view binds `@status`, which only a registered contract
  ; publishes — rung 2 is doing its job by refusing this on an empty machine.
  (let [r (run base clock-view-src)
        v (first (views (get r :machine)))]
    (is (= :ok (get r :status)))
    (is (= :clock (get v :name)))
    ;; the three planes survive the trip
    (is (= 1 (count (get v :markup))))
    (is (= 1 (count (get v :style))))
    (is (= 1 (count (get v :binds))))))

(deftest a-template-with-no-html-is-refused-not-silently-emitted
  ; An empty template compiles to a page element that renders nothing, which
  ; passes every downstream check while showing the user a blank box.
  (let [r (validate base "(defview x (markup (template &x [$m])))")]
    (is (= :rejected (get r :status)))
    (is (= :schema (get r :rung)))))

;; ── page-locals: the tautology guard ────────────────────────────────────────

(deftest a-page-local-is-derived-not-declared
  ; `(st/on :input (st/value @draft))` WRITES @draft in the browser. Nobody
  ; publishes it, and nobody should: it is page-local by construction.
  ;
  ; This is the check that decides whether rung 2 is real. If locals had to be
  ; declared in the source, every definition would arrive with its own locals
  ; list and orphan-binding could never fire — a check fed its own answer.
  (let [v (parse-view :composer
            (list (quote (markup (template &box [] "<input class='box'>")))
                  (quote (binds [".box" (st/on :input (st/value @draft))]))))]
    (is (= ["draft"] (view-locals v)))))

(deftest an-each-loop-variable-is-not-a-binding
  ; `(st/each @messages :as @m …)` BINDS @m per row — it is a loop variable,
  ; not a name the seam publishes. Counting it as one makes a correct page
  ; report an orphan, and a check that cries wolf on correct input gets
  ; switched off.
  (let [v (parse-view :log
            (list (quote (markup (template &row [$m] "<li class='row'>{@m.text}</li>")))
                  (quote (binds [".row" (st/each @messages :as @m :template &row)]))))]
    (is (includes? (str (view-locals v)) "m"))))

;; ── rung 2: the machine joins ───────────────────────────────────────────────

(deftest a-view-binding-no-contract-declares-is-refused
  ; ERROR, not warning: the page reads a name nobody publishes, so it is broken
  ; the moment it renders.
  (let [r (validate base
            "(defview ghost
               (markup (template &row [$r] \"<li class='row'>{@r.text}</li>\"))
               (binds [\".row\" (st/each @nothing :as @r :template &row)]))")]
    (is (= :rejected (get r :status)))
    (is (= :machine (get r :rung)))
    (is (includes? (str (get r :reason)) "nothing"))))

(deftest a-view-that-only-reads-declared-assigns-is-accepted
  ; The partner of the test above. Without it, a rung that refuses EVERYTHING
  ; would pass the suite.
  (let [r (validate base
            "(defview log
               (markup (template &row [$m] \"<li class='row'>{@m.text}</li>\"))
               (binds [\".row\" (st/each @messages :as @m :template &row)]))")]
    (is (= :ok (get r :status)))))

(deftest an-event-no-contract-handles-is-refused
  (let [r (validate base
            "(defview btn
               (markup (template &b [] \"<button class='b'>go</button>\"))
               (binds [\".b\" (st/on :click (fire :explode))]))")]
    (is (= :rejected (get r :status)))
    (is (= :machine (get r :rung)))
    (is (includes? (str (get r :reason)) "explode"))))

(deftest an-event-the-contract-declares-is-accepted
  ; The fired argument must be a name the page actually WRITES, so the bind
  ; that writes it is part of the same definition. This is the composer shape:
  ; an input writing @draft, a button firing it.
  (let [r (validate base
            "(defview btn
               (markup (template &b [] \"<button class='b'>go</button>\")
                       (template &i [] \"<input class='i'>\"))
               (binds [\".i\" (st/on :input (st/value @draft))]
                      [\".b\" (st/on :click (fire :send @draft))]))")]
    (is (= :ok (get r :status)))))

(deftest firing-a-name-nothing-writes-is-refused
  ; The bug this project SHIPPED once, now a check.
  ;
  ; `(fire :send @draft)` with no bind writing @draft sends the empty string
  ; every time: the page compiles, the seam agrees, the button works, and every
  ; message arrives blank at the boundary. seed.bl's header records the review
  ; that found it. Here it is refused as an orphan binding, because that is
  ; exactly what it is — a name the page reads that nobody publishes and
  ; nothing writes.
  (let [r (validate base
            "(defview btn
               (markup (template &b [] \"<button class='b'>go</button>\"))
               (binds [\".b\" (st/on :click (fire :send @draft))]))")]
    (is (= :rejected (get r :status)))
    (is (= :machine (get r :rung)))
    (is (includes? (str (get r :reason)) "draft"))))

(deftest an-incomplete-machine-is-a-warning-not-a-refusal
  ; `@status` declared and not yet rendered is the NORMAL state of a machine
  ; being grown one definition at a time. Refusing it would make the tool
  ; unusable for its entire purpose.
  (let [r (validate base
            "(defview log
               (markup (template &row [$m] \"<li class='row'>{@m.text}</li>\"))
               (binds [\".row\" (st/each @messages :as @m :template &row)]))")]
    (is (= :ok (get r :status)))
    (is (includes? (str (get r :warnings)) "status"))))

;; ── the boundary, attacked ────────────────────────────────────────────────

(deftest an-on-info-clause-is-refused
  ; `(on-info …)` bodies EXECUTE — the walker in spell.server runs them when
  ; deltas, verdicts and turn-ends arrive. The JSON boundary never exposed
  ; them; the source boundary must not either. This definition is otherwise
  ; the seed's own shape, so only the refusal stands between the model and
  ; server-side code execution.
  (let [r (validate base
            (str "(defcontract chat-live (assign @messages :list) (assign @status :atom) "
                 "(assign @partial :string) (assign @error :string) "
                 "(on :send [text] (ok \"accepted\")) "
                 "(on-info [:defined id text] (do (set! @error \"model code ran\") (ask! \"continue\"))))"))]
    (is (= :rejected (get r :status)))
    (is (= :schema (get r :rung)))
    (is (includes? (str (get r :reason)) "on-info"))))

(deftest a-non-symbol-name-is-a-refusal-not-a-crash
  ; `(defcontract {:bundle …})` made the opts map the NAME; `(name nm)` on a
  ; map threw OUTSIDE the refusal path and crashed the loop GenServer. Every
  ; malformed definition must come back as a rung-1 refusal.
  (let [r (validate base "(defcontract {:bundle \"/evil.js\"})")]
    (is (= :rejected (get r :status)))
    (is (= :schema (get r :rung)))))

(deftest a-body-whose-replies-cannot-be-enumerated-is-refused
  ; `assert-enumerable!` runs on the ORIGINAL body, before the stub replaces
  ; it — checking after stubbing would check the invented stub, and a dynamic
  ; constructor would sail through with a declared reply surface the source
  ; never had.
  (let [r (validate base "(defcontract c (assign @n :integer) (on :tick ((if true ok err) \"x\")))")]
    (is (= :rejected (get r :status)))
    (is (= :schema (get r :rung)))))

(deftest an-err-only-body-keeps-EXACTLY-err
  ; The tag set determines the receive arms the generated page carries:
  ; widening ["err"] to ["ok" "err"] would have the page answer `ok` the
  ; source never declared.
  (let [r (run (empty-machine)
               "(defcontract c (assign @n :integer) (on :tick (err \"no\")))")
        term (first (vals (get (first (contracts (get r :machine))) :events)))
        body (get term :body)]
    (is (= :ok (get r :status)))
    (is (includes? (str body) "err"))
    (is (not (includes? (str body) "ok")))))

(deftest a-fire-and-forget-body-declares-NO-reply
  ; [] is a checkable claim (seam.bl), not an accident — the stub must not
  ; invent an `ok` the source never wrote, or a page correlating on a reply
  ; waits forever.
  (let [r (run (empty-machine)
               "(defcontract c (assign @n :integer) (on :tick (set! @n 1)))")
        term (first (vals (get (first (contracts (get r :machine))) :events)))
        body (get term :body)]
    (is (= :ok (get r :status)))
    (is (not (includes? (str body) "ok")))
    (is (not (includes? (str body) "err")))
    (is (not (includes? (str body) "set!")))))

(deftest an-undeclared-template-hole-is-refused
  ; The blank-render bug, as a rung: `{@m.text}` with EMPTY params and no
  ; `m` anywhere the page can read. Verse compiles the unbound reference
  ; happily; without this check every rung agrees and the browser renders
  ; the right number of empty divs.
  (let [r (validate base
            "(defview log
               (markup (template &row [] \"<li class='row'>{@m.text}</li>\"))
               (binds [\".row\" (st/each @messages :as @m :template &row)]))")]
    (is (= :rejected (get r :status)))
    (is (= :machine (get r :rung)))
    (is (includes? (str (get r :reason)) "undeclared-hole"))))

;; ── run: commit and rollback ────────────────────────────────────────────────

(deftest an-accepted-definition-is-committed
  (let [r (run base clock-view-src)]
    (is (= :ok (get r :status)))
    (is (= "view" (get r :kind)))
    (is (= :clock (get r :name)))
    (is (= 1 (count (views (get r :machine)))))))

(deftest a-refused-definition-leaves-the-machine-UNCHANGED
  ; The property the whole tool rests on. A machine that half-accepts a broken
  ; definition is worse than one that refuses it: the next definition is then
  ; validated against a state no author ever approved.
  (let [before base
        r (run before
            "(defview ghost
               (markup (template &row [$r] \"<li class='row'>x</li>\"))
               (binds [\".row\" (st/each @nothing :as @r :template &row)]))")]
    (is (= :rejected (get r :status)))
    ;; identical, not merely "still valid"
    (is (= (report before []) (report (get r :machine) [])))
    (is (= 0 (count (views (get r :machine)))))))

(deftest redefining-a-name-REPLACES-rather-than-duplicates
  ; The loop redefines constantly — a model correcting itself sends the same
  ; name again. Accumulating both copies would make every later join report
  ; phantom conflicts against the superseded version.
  (let [m1 (get (run base clock-view-src) :machine)
        m2 (get (run m1 clock-view-src) :machine)]
    (is (= 1 (count (views m2))))))

(deftest a-contract-and-a-view-can-both-be-defined
  (let [m1 (get (run (empty-machine)
                     "(defcontract clock-live (assign @now :string) (on :tick (ok \"t\")))")
                :machine)
        r (run m1
               "(defview clock
                  (markup (template &c [] \"<div class='c'>{@now}</div>\"))
                  (binds [\".c\" (st/view @now \"ready\" &c)]))")]
    (is (= :ok (get r :status)))
    (is (= 1 (count (contracts (get r :machine)))))
    (is (= 1 (count (views (get r :machine)))))))

;; ── driver params: the difference between Enter and every keystroke ────────

(deftest an-on-bind-carries-its-key-filter
  ; A bare `:keydown` fires on EVERY key — one message per character. The
  ; trailing `:key "Enter"` pair is the shape `on-driver-body-form` reads; a
  ; `:keydown:Enter` QUALIFIER reads better and does not work: verse has no
  ; grammar slot for it, so it is parsed and DISCARDED.
  (let [v (parse-view :keys
            (list (quote (markup (template &k [] "<i class='k'>x</i>")))
                  (quote (binds [".k" (st/on :keydown (fire :send @draft) :key "Enter")]))))
        form (get (get (get v :binds) 0) 1)]
    (is (= 5 (count form)))
    (is (= :key (nth form 3)))
    (is (= "Enter" (nth form 4)))))

;; ── the strongest check available: the REAL seed ──────────────────────────

(deftest the-ladder-accepts-the-page-this-project-ships
  ; Every fixture above is written for its test, so all of them together still
  ; only prove the ladder is self-consistent. This one is different: it runs
  ; rung 2 against `spell.seed` — the contract and view that emit the served
  ; page itself.
  ;
  ; If this reports an error, the ladder is wrong, not the page. A check that
  ; refuses working software is worse than no check: it gets switched off, and
  ; then it protects nothing.
  (let [m (register-view (register-contract (empty-machine) spell.seed/contract-term)
                         spell.seed/view-term)
        found (machine-findings m)]
    (is (= [] (get found :errors)))
    ;; the locals derivation finds exactly the names the view introduces:
    ;; @draft (written by st/value) and @m, the transcript's loop variable
    (is (= ["draft" "m"] (view-locals spell.seed/view-term)))
    ;; the one warning is honest and worth keeping visible: &shell is the host
    ;; skeleton the bundle mounts ONTO, so no bind invokes it
    (is (includes? (str (get found :warnings)) "shell"))))

(deftest the-token-stream-is-a-published-binding-not-an-orphan
  ; `@fx` is the channel every declared push arrives on — `contract/edn-stream`
  ; emits one `@data stream $fx` with a tagged arm per push. A view rendering
  ; streamed tokens therefore binds `@fx`, and the orphan check must know the
  ; push declarations publish it.
  (let [c (parse :s-live {} (list (quote (push @token {:id :string}))))
        v (parse-view :s-view
            (list (quote (markup (template &tok [$t] "<i class='tok'>{@t.text}</i>")))
                  (quote (style [".tok" {:color "#fff"}]))
                  (quote (binds [".tok" (st/each @fx :as @t :template &tok)]))))
        m (register-view (register-contract (empty-machine) c) v)]
    (is (= [] (get (machine-findings m) :errors)))))

(deftest a-contract-with-no-pushes-publishes-no-stream
  ; The partner test. `fx` must NOT be published by a contract that declares no
  ; pushes, or the exemption would hide a genuine orphan on every page.
  (let [c (parse :n-live {} (list (quote (assign @x :string))))
        v (parse-view :n-view
            (list (quote (markup (template &tok [$t] "<i class='tok'>{@t.text}</i>")))
                  (quote (binds [".tok" (st/each @fx :as @t :template &tok)]))))
        m (register-view (register-contract (empty-machine) c) v)]
    (is (includes? (str (get (machine-findings m) :errors)) "fx"))))

;; ── the result the model reads ─────────────────────────────────────────────

(deftest the-result-carries-the-machine-report
  ; The model's next definition is only as good as its picture of the machine.
  ; Returning the report with every verdict means it never has to ask.
  (let [r (run base clock-view-src)]
    (is (not (nil? (get r :report))))
    (is (includes? (str (get r :report)) "chat-live"))))

(deftest a-rejection-explains-itself-in-words-the-model-can-act-on
  (let [r (run base
            "(defview ghost
               (markup (template &row [$r] \"<li class='row'>x</li>\"))
               (binds [\".row\" (st/each @nothing :as @r :template &row)]))")]
    ;; names the rung, the finding, and the binding at fault
    (is (= :machine (get r :rung)))
    (is (includes? (str (get r :reason)) "orphan"))
    (is (includes? (str (get r :reason)) "nothing"))))

;; ── the code heads: classified, never evaluated here ───────────────────────

(deftest a-defn-is-classified-as-code-and-touches-no-machine
  ; The fence rung (Elixir) decides code; the pure rungs pass it through
  ; with kind "code", the name, and the machine UNCHANGED.
  (let [r (run base "(defn helper [x] (+ x 1))")]
    (is (= :ok (get r :status)))
    (is (= "code" (get r :kind)))
    (is (= "helper" (get r :name)))
    ; the machine did not move — code has nothing to join
    (is (= (get base :order) (get (get r :machine) :order)))))

(deftest a-def-is-classified-as-code
  (let [r (run base "(def meaning 42)")]
    (is (= :ok (get r :status)))
    (is (= "code" (get r :kind)))
    (is (= "meaning" (get r :name)))))

(deftest compile-time-and-process-heads-are-refused-by-name
  ; defmacro expands inside OTHER definitions' compile; defserver spawns
  ; handlers. Both outlive anything the fence can bound — refused at read.
  (doseq [src ["(defmacro sneaky [x] x)"
               "(defserver s (handlers))"
               "(ns evil.ns)"
               "(defmulti m (fn [x] x))"]]
    (let [r (run base src)]
      (is (= :rejected (get r :status)))
      (is (= :schema (get r :rung)))
      (is (includes? (str (get r :reason)) "fence")))))

(deftest a-defn-with-a-non-symbol-name-is-refused-not-a-crash
  (let [r (run base "(defn {:a 1} [x] x)")]
    (is (= :rejected (get r :status)))
    (is (= :schema (get r :rung)))))

(deftest a-qualified-name-is-refused-it-would-be-unreachable
  (let [r (run base "(defn other.ns/f [x] x)")]
    (is (= :rejected (get r :status)))
    (is (includes? (str (get r :reason)) "spell.vars"))))

(deftest a-vm-terminal-call-is-refused-by-name
  ; `(def stop (System/halt 1))` is a plausible COMPLETION, not an attack —
  ; refused before the fence ever compiles it.
  (doseq [src ["(def stop (System/halt 1))"
               "(defn die [] (erlang/halt))"
               "(defn nested [] (if true (System/stop) 1))"]]
    (let [r (run base src)]
      (is (= :rejected (get r :status)))
      (is (= :schema (get r :rung))))))

(deftest a-quoted-terminal-call-is-data-not-a-call
  (let [r (run base "(def sample (quote (System/halt 1)))")]
    (is (= :ok (get r :status)))))
