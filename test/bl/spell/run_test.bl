; test/bl/spell/define_test.bl — the tool that grows the machine, rungs 1–2.
; Run: mix beam_lisp.test test/bl/spell/define_test.bl
;
; `define` is the ONE tool the model calls. It takes a proposal, walks a
; validation ladder, and either commits a contract/view into the machine or
; refuses with the reason. Rungs 1–2 live here because they are pure:
;
;   1. schema   — is the proposal well-formed?
;   2. machine  — does it AGREE with everything registered so far?
;
; Rungs 3–4 (verse compile, ghost selectors) shell out to a compiler and are
; exercised by scripts/define_check.exs instead; this suite must stay hermetic
; and fast, because it is the one that runs on every edit.
;
; ── what these tests are guarding ───────────────────────────────────────────
;
; A validation ladder has one characteristic failure: it accepts everything.
; Each test below therefore comes in a pair — a proposal that MUST be accepted
; and a neighbouring one that MUST be refused for a NAMED reason. A rung that
; cannot refuse is not a rung, and "no findings" would be indistinguishable
; from "no check".

(ns spell.define.test
  (:require [spell.contract :refer [view-document]]
            [spell.define :refer [define validate proposal->contract proposal->view
                                  view-locals machine-findings]]
            [spell.machine :refer [empty-machine register-contract register-view
                                   contracts views all-assigns report]]
            [spell.seed]
            [spell.contract :refer [parse parse-view]]))

;; ── fixtures ────────────────────────────────────────────────────────────────

(def base
  ;; A machine holding one contract, so "agrees with what is registered" has
  ;; something to disagree with.
  (register-contract (empty-machine)
    (parse :chat-live {}
           (list (quote (assign @messages :list))
                 (quote (assign @status :atom))
                 (quote (on :send [text] (ok "accepted")))))))

(def clock-view
  {:kind "view"
   :name "clock"
   :rationale "show server time"
   :templates [{:name "clock" :params [] :html "<div class='clock'>{@now}</div>"}]
   :style [{:selector ".clock" :rules {:font-size "2rem"}}]
   :binds [{:selector ".clock" :view {:binding "status" :arms [["thinking" "clock"]]}}]})

;; ── rung 1: schema ──────────────────────────────────────────────────────────

(deftest a-proposal-needs-a-kind-a-name-and-a-rationale
  ; The rationale is required deliberately: it is what renders in the chat
  ; bubble, and a proposal nobody can read is a change nobody can review.
  (is (= :ok (get (validate base {:kind "view" :name "x" :rationale "why"
                                  :templates [{:name "x" :html "<i class='x'></i>"}]
                                  :binds [{:selector ".x" :each {:binding "messages"
                                                                 :as "m" :template "x"}}]})
                  :status)))
  (is (= :rejected (get (validate base {:name "x" :rationale "why"}) :status)))
  (is (= :rejected (get (validate base {:kind "view" :rationale "why"}) :status)))
  (is (= :rejected (get (validate base {:kind "view" :name "x"}) :status))))

(deftest an-unknown-kind-is-refused-at-the-schema-rung
  (let [r (validate base {:kind "stylesheet" :name "x" :rationale "why"})]
    (is (= :rejected (get r :status)))
    (is (= :schema (get r :rung)))))

(deftest the-rung-that-refused-is-always-named
  ; The model gets ONE result and has to act on it. "rejected" without the rung
  ; leaves it guessing which half of its proposal to change.
  (let [r (validate base {:kind "view" :name "x"})]
    (is (= :schema (get r :rung)))
    (is (not (nil? (get r :reason))))))

;; ── building terms from a proposal ──────────────────────────────────────────

(deftest a-contract-proposal-becomes-a-contract-term
  (let [c (proposal->contract {:kind "contract" :name "clock-live" :rationale "r"
                               :assigns [{:name "now" :type "string"}]
                               :events [{:name "tick" :params ["at"]}]})]
    (is (= :clock-live (get c :name)))
    (is (includes? (str (all-assigns (register-contract (empty-machine) c))) "now"))))

(deftest a-view-proposal-becomes-a-view-term
  (let [v (proposal->view clock-view)]
    (is (= :clock (get v :name)))
    ;; the three planes survive the trip
    (is (= 1 (count (get v :markup))))
    (is (= 1 (count (get v :style))))
    (is (= 1 (count (get v :binds))))))

(deftest a-template-with-no-html-is-refused-not-silently-emitted
  ; An empty template compiles to a page element that renders nothing, which
  ; passes every downstream check while showing the user a blank box.
  (let [r (validate base {:kind "view" :name "x" :rationale "r"
                          :templates [{:name "x"}]})]
    (is (= :rejected (get r :status)))
    (is (= :schema (get r :rung)))))

;; ── page-locals: the tautology guard ────────────────────────────────────────

(deftest a-page-local-is-derived-not-declared
  ; `(st/on :input (st/value @draft))` WRITES @draft in the browser. Nobody
  ; publishes it, and nobody should: it is page-local by construction.
  ;
  ; This is the check that decides whether rung 2 is real. If locals had to be
  ; passed in by the caller, every proposal would arrive with its own locals
  ; list and orphan-binding could never fire — a check fed its own answer.
  (let [v (proposal->view
            {:kind "view" :name "composer" :rationale "r"
             :templates [{:name "box" :html "<input class='box'>"}]
             :binds [{:selector ".box" :on {:event "input" :value "draft"}}]})]
    (is (= ["draft"] (view-locals v)))))

(deftest an-each-loop-variable-is-not-a-binding
  ; `(st/each @messages :as @m …)` BINDS @m per row — it is a loop variable,
  ; not a name the seam publishes. Counting it as one makes a correct page
  ; report an orphan, and a check that cries wolf on correct input gets
  ; switched off.
  (let [v (proposal->view
            {:kind "view" :name "log" :rationale "r"
             :templates [{:name "row" :html "<li class='row'>{@m.text}</li>"}]
             :binds [{:selector ".row" :each {:binding "messages" :as "m" :template "row"}}]})]
    (is (includes? (str (view-locals v)) "m"))))

;; ── rung 2: the machine joins ───────────────────────────────────────────────

(deftest a-view-binding-no-contract-declares-is-refused
  ; ERROR, not warning: the page reads a name nobody publishes, so it is broken
  ; the moment it renders.
  (let [r (validate base
            {:kind "view" :name "ghost" :rationale "r"
             :templates [{:name "row" :html "<li class='row'>{@r.text}</li>"}]
             :binds [{:selector ".row" :each {:binding "nothing" :as "r" :template "row"}}]})]
    (is (= :rejected (get r :status)))
    (is (= :machine (get r :rung)))
    (is (includes? (str (get r :reason)) "nothing"))))

(deftest a-view-that-only-reads-declared-assigns-is-accepted
  ; The partner of the test above. Without it, a rung that refuses EVERYTHING
  ; would pass the suite.
  (let [r (validate base
            {:kind "view" :name "log" :rationale "r"
             :templates [{:name "row" :html "<li class='row'>{@m.text}</li>"}]
             :binds [{:selector ".row" :each {:binding "messages" :as "m" :template "row"}}]})]
    (is (= :ok (get r :status)))))

(deftest an-event-no-contract-handles-is-refused
  (let [r (validate base
            {:kind "view" :name "btn" :rationale "r"
             :templates [{:name "b" :html "<button class='b'>go</button>"}]
             :binds [{:selector ".b" :on {:event "click" :fire "explode"}}]})]
    (is (= :rejected (get r :status)))
    (is (= :machine (get r :rung)))
    (is (includes? (str (get r :reason)) "explode"))))

(deftest an-event-the-contract-declares-is-accepted
  ; The fired argument must be a name the page actually WRITES, so the bind
  ; that writes it is part of the same proposal. This is the composer shape:
  ; an input writing @draft, a button firing it.
  (let [r (validate base
            {:kind "view" :name "btn" :rationale "r"
             :templates [{:name "b" :html "<button class='b'>go</button>"}
                         {:name "i" :html "<input class='i'>"}]
             :binds [{:selector ".i" :on {:event "input" :value "draft"}}
                     {:selector ".b" :on {:event "click" :fire "send" :arg "draft"}}]})]
    (is (= :ok (get r :status)))))

(deftest firing-a-name-nothing-writes-is-refused
  ; The bug this project SHIPPED once, now a check.
  ;
  ; `(fire :send @draft)` with no bind writing @draft sends the empty string
  ; every time: the page compiles, the seam agrees, the button works, and every
  ; message arrives blank at the boundary. seed.bl's header records the review
  ; that found it. Here it is refused as an orphan binding, because that is
  ; exactly what it is — a name the page reads that nobody publishes and
  ; nothing writes.
  (let [r (validate base
            {:kind "view" :name "btn" :rationale "r"
             :templates [{:name "b" :html "<button class='b'>go</button>"}]
             :binds [{:selector ".b" :on {:event "click" :fire "send" :arg "draft"}}]})]
    (is (= :rejected (get r :status)))
    (is (= :machine (get r :rung)))
    (is (includes? (str (get r :reason)) "draft"))))

(deftest an-incomplete-machine-is-a-warning-not-a-refusal
  ; `@status` declared and not yet rendered is the NORMAL state of a machine
  ; being grown one definition at a time. Refusing it would make the tool
  ; unusable for its entire purpose.
  (let [r (validate base
            {:kind "view" :name "log" :rationale "r"
             :templates [{:name "row" :html "<li class='row'>{@m.text}</li>"}]
             :binds [{:selector ".row" :each {:binding "messages" :as "m" :template "row"}}]})]
    (is (= :ok (get r :status)))
    (is (includes? (str (get r :warnings)) "status"))))

;; ── define: commit and rollback ─────────────────────────────────────────────

(deftest an-accepted-proposal-is-committed
  (let [r (define base clock-view)]
    (is (= :ok (get r :status)))
    (is (= 1 (count (views (get r :machine)))))))

(deftest a-refused-proposal-leaves-the-machine-UNCHANGED
  ; The property the whole tool rests on. A machine that half-accepts a broken
  ; definition is worse than one that refuses it: the next proposal is then
  ; validated against a state no author ever approved.
  (let [before base
        r (define before
            {:kind "view" :name "ghost" :rationale "r"
             :templates [{:name "row" :html "<li class='row'>x</li>"}]
             :binds [{:selector ".row" :each {:binding "nothing" :as "r" :template "row"}}]})]
    (is (= :rejected (get r :status)))
    ;; identical, not merely "still valid"
    (is (= (report before []) (report (get r :machine) [])))
    (is (= 0 (count (views (get r :machine)))))))

(deftest redefining-a-name-REPLACES-rather-than-duplicates
  ; The loop redefines constantly — a model correcting itself sends the same
  ; name again. Accumulating both copies would make every later join report
  ; phantom conflicts against the superseded version.
  (let [m1 (get (define base clock-view) :machine)
        m2 (get (define m1 (assoc clock-view :rationale "second attempt")) :machine)]
    (is (= 1 (count (views m2))))))

(deftest a-contract-and-a-view-can-both-be-defined
  (let [m1 (get (define (empty-machine)
                  {:kind "contract" :name "clock-live" :rationale "r"
                   :assigns [{:name "now" :type "string"}]
                   :events [{:name "tick" :params []}]})
                :machine)
        r (define m1
            {:kind "view" :name "clock" :rationale "r"
             :templates [{:name "c" :html "<div class='c'>{@now}</div>"}]
             :binds [{:selector ".c" :view {:binding "now" :arms [["ready" "c"]]}}]})]
    (is (= :ok (get r :status)))
    (is (= 1 (count (contracts (get r :machine)))))
    (is (= 1 (count (views (get r :machine)))))))

(deftest a-view-bind-emits-FLAT-arms
  ; `(st/view @x ["a" &t])`, not `[["a" &t]]`.
  ;
  ; The double-nested form passed every pure rung and was refused by verse with
  ; `E0946: Expected capture $arms:body but no tokens remaining` — found only by
  ; running the loop against a real model, whose proposal was correct and whose
  ; definition my emitter rejected twice. A shape test here is cheaper than a
  ; live turn, and it fails for the same reason.
  (let [v (proposal->view
            {:kind "view" :name "banner" :rationale "r"
             :templates [{:name "title" :html "<h1 class='banner'>x</h1>"}]
             :binds [{:selector ".banner"
                      :view {:binding "status" :arms [["thinking" "title"]]}}]})
        bind (get (get v :binds) 0)
        arms (nth (get bind 1) 2)]
    ;; two flat elements, the literal and the template ref — not one nested pair
    (is (= 2 (count arms)))
    (is (= "thinking" (get arms 0)))
    (is (includes? (str (get arms 1)) "&title"))))

(deftest a-view-bind-with-two-arms-stays-flat
  (let [v (proposal->view
            {:kind "view" :name "b2" :rationale "r"
             :templates [{:name "a" :html "<i class='a'>a</i>"}
                         {:name "b" :html "<i class='b'>b</i>"}]
             :binds [{:selector ".x"
                      :view {:binding "status" :arms [["one" "a"] ["two" "b"]]}}]})
        arms (nth (get (get (get v :binds) 0) 1) 2)]
    (is (= 4 (count arms)))))

;; ── template params: the difference between a value and a blank ───────────

(deftest a-template-derives-its-params-from-the-html-it-interpolates
  ; A model proposed a template with no `params` and it was RIGHT to: the loop
  ; variable is named by the BIND (`:as "m"`), so listing it again is redundant
  ; and a model reading the schema has no reason to.
  ;
  ; The emitter took that literally and emitted `@template &clockface() { …
  ; $m.text … }`. Verse compiled it happily — an unbound reference in a template
  ; body is not an error, it is a name that resolves to nothing — so the
  ; definition passed all four rungs and the browser rendered TWO EMPTY DIVS:
  ; the right number of elements, none of them saying anything.
  ;
  ; Observed in a real browser after a real model's definition was accepted.
  ; Every check agreed the page was correct; the page said nothing.
  (let [v (proposal->view
            {:kind "view" :name "clock" :rationale "r"
             :templates [{:name "clockface" :html "<div class='clock'>{@m.text}</div>"}]
             :binds [{:selector ".log"
                      :each {:binding "messages" :as "m" :template "clockface"}}]})
        tpl (first (get v :markup))]
    ;; (template &clockface [$m] "…")
    (is (= 1 (count (nth tpl 2))))
    (is (= "$m" (str (first (nth tpl 2)))))))

(deftest an-explicit-param-list-still-wins
  ; A template may take an argument it does not interpolate directly — passing
  ; it on to another template, say — so an explicit list is authoritative.
  (let [v (proposal->view
            {:kind "view" :name "explicit" :rationale "r"
             :templates [{:name "row" :params ["x" "y"] :html "<i class='row'>{@x.a}</i>"}]})
        tpl (first (get v :markup))]
    (is (= 2 (count (nth tpl 2))))))

(deftest a-template-with-no-interpolation-takes-no-params
  ; The negative half: deriving must not invent a parameter for a static
  ; template. `&thinking` in the seed view takes none.
  (let [v (proposal->view
            {:kind "view" :name "static" :rationale "r"
             :templates [{:name "dots" :html "<div class='dots'><span></span></div>"}]})
        tpl (first (get v :markup))]
    (is (= 0 (count (nth tpl 2))))))

(deftest repeated-interpolations-of-one-name-yield-ONE-param
  (let [v (proposal->view
            {:kind "view" :name "twice" :rationale "r"
             :templates [{:name "b" :html "<i class='b' data-role={@m.role}>{@m.text}</i>"}]})
        tpl (first (get v :markup))]
    (is (= 1 (count (nth tpl 2))))))

;; ── driver params: the difference between Enter and every keystroke ────────

(deftest an-on-bind-carries-its-key-filter
  ; Without this a model can only propose a bare `:keydown`, which fires on
  ; EVERY key — one message per character. The seed view carries a comment
  ; about exactly that defect (verse BUG-375), fixed there BY HAND while this
  ; path could not express the fix at all, so every model-proposed keyboard
  ; binding would have re-created it.
  (let [v (proposal->view
            {:kind "view" :name "keys" :rationale "r"
             :templates [{:name "k" :html "<i class='k'>x</i>"}]
             :binds [{:selector ".k"
                      :on {:event "keydown" :fire "send" :arg "draft" :key "Enter"}}]})
        form (get (get (get v :binds) 0) 1)]
    ;; (st/on :keydown (fire :send @draft) :key "Enter") — the param is a
    ;; trailing pair after the action, which is the shape `on-driver-body-form`
    ;; reads. A `:keydown:Enter` QUALIFIER reads better and does not work:
    ;; verse has no grammar slot for it, so it is parsed and DISCARDED.
    (is (= 5 (count form)))
    (is (= :key (nth form 3)))
    (is (= "Enter" (nth form 4)))))

(deftest an-on-bind-without-a-key-stays-unfiltered
  ; The negative half: a click must NOT grow a driver param, or every binding
  ; would carry an empty filter that verse reads as an arg list.
  (let [v (proposal->view
            {:kind "view" :name "clicks" :rationale "r"
             :templates [{:name "c" :html "<i class='c'>x</i>"}]
             :binds [{:selector ".c" :on {:event "click" :fire "send"}}]})
        form (get (get (get v :binds) 0) 1)]
    (is (= 3 (count form)))))

(deftest a-driver-key-containing-a-quote-emits-VALID-edn
  ; `"` is a legal key filter, and the value was printed between hand-written
  ; quotes with no escaping — so the document did not parse and the whole page
  ; stopped compiling for one keystroke. It now goes through `edn-str`, the
  ; same printer every other capture uses.
  (let [v (proposal->view
            {:kind "view" :name "quoted" :rationale "r"
             :templates [{:name "q" :html "<i class='q'>x</i>"}]
             :binds [{:selector ".q" :on {:event "keydown" :fire "send" :key "\""}}]})
        doc (view-document v ["stdlib/macros/data-kind"])]
    ;; the escaped form, not a bare quote closing the capture early
    (is (includes? doc "\"value\" \"\\\"\""))))

;; ── the strongest check available: the REAL seed ──────────────────────────

(deftest the-ladder-accepts-the-page-this-project-ships
  ; Every fixture above is written for its test, so all of them together still
  ; only prove the ladder is self-consistent. This one is different: it runs
  ; rung 2 against `spell.seed` — the contract and view that emit the page in
  ; docs/proof/chat-live.png and that peek.sh screenshots.
  ;
  ; If this reports an error, the ladder is wrong, not the page. A check that
  ; refuses working software is worse than no check: it gets switched off, and
  ; then it protects nothing.
  (let [m (register-view (register-contract (empty-machine) spell.seed/contract-term)
                         spell.seed/view-term)
        found (machine-findings m)]
    (is (= [] (get found :errors)))
    ;; the locals derivation finds exactly the names the view introduces:
    ;; @draft (written by st/value) and the two each loop variables, @m over
    ;; the transcript and @t over the token stream
    ; `t` is gone with the `@each @fx :as @t` bind it belonged to: a stream
    ; decodes to the LATEST variant, not a list, so iterating it rendered
    ; nothing. The partial answer is a subscribed assign now, and `@view` binds
    ; it without introducing a loop variable.
    (is (= ["draft" "m"] (view-locals spell.seed/view-term)))
    ;; the one warning is honest and worth keeping visible: &shell is the host
    ;; skeleton the bundle mounts ONTO, so no bind invokes it
    (is (includes? (str (get found :warnings)) "shell"))))

(deftest the-token-stream-is-a-published-binding-not-an-orphan
  ; `@fx` is the channel every declared push arrives on — `contract/edn-stream`
  ; emits one `@data stream $fx` with a tagged arm per push. A view rendering
  ; streamed tokens therefore binds `@fx`, and the orphan check must know the
  ; push declarations publish it.
  ;
  ; This is the check reporting a REAL gap first and then being taught: wiring
  ; the seed's streaming bubble made it report `fx` as an orphan, which was the
  ; check's model being wrong rather than the page.
  (let [c (parse :s-live {} (list (quote (push @token {:id :string}))))
        v (parse-view :s-view
            (list (quote (markup (template &tok [$t] "<i class='tok'>{@t.text}</i>")))
                  (quote (style [".tok" {:color "#fff"}]))
                  (quote (binds [".tok" (st/each @fx :as @t :template &tok)]))))
        m (register-view (register-contract (empty-machine) c) v)]
    (is (= [] (get (machine-findings m) :errors)))))

(deftest a-contract-with-no-pushes-publishes-no-stream
  ; The partner test. `fx` must NOT be published by a contract that declares no
  ; pushes, or the exemption would hide a genuine orphan on every page.
  (let [c (parse :n-live {} (list (quote (assign @x :string))))
        v (parse-view :n-view
            (list (quote (markup (template &tok [$t] "<i class='tok'>{@t.text}</i>")))
                  (quote (binds [".tok" (st/each @fx :as @t :template &tok)]))))
        m (register-view (register-contract (empty-machine) c) v)]
    (is (includes? (str (get (machine-findings m) :errors)) "fx"))))

;; ── the result the model reads ─────────────────────────────────────────

(deftest the-result-carries-the-machine-report
  ; The model's next proposal is only as good as its picture of the machine.
  ; Returning the report with every verdict means it never has to ask.
  (let [r (define base clock-view)]
    (is (not (nil? (get r :report))))
    (is (includes? (str (get r :report)) "chat-live"))))

(deftest a-rejection-explains-itself-in-words-the-model-can-act-on
  (let [r (define base
            {:kind "view" :name "ghost" :rationale "r"
             :templates [{:name "row" :html "<li class='row'>x</li>"}]
             :binds [{:selector ".row" :each {:binding "nothing" :as "r" :template "row"}}]})]
    ;; names the rung, the finding, and the binding at fault
    (is (= :machine (get r :rung)))
    (is (includes? (str (get r :reason)) "orphan"))
    (is (includes? (str (get r :reason)) "nothing"))))
