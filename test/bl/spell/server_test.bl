; test/bl/spell/server_test.bl — the contract's server half, executed.
; Run: mix beam_lisp.test test/bl/spell/server_test.bl
;
; These assert the thing that did not exist until FEAT-002: a contract's handler
; bodies RUNNING. Every other test in this suite asserts what a contract emits;
; these assert what it DOES, which is the half that had never been observed —
; and the half whose absence hid a missing `append`, unrecorded event
; parameters, and a contract that promised to join a finished answer to the
; transcript without any clause doing so.
;
; No socket, no browser, no provider: `spell.server/handle` is a pure function
; of (contract, event, payload, assigns), which is exactly why the loop can be
; verified without any of them.

(ns spell.server.test
  (:require [spell.seed :refer [contract-term]]
            [spell.server :refer [handle handle-info seed-assigns params-for bind-params]]))

;; ── the wire ────────────────────────────────────────────────────────────────

(deftest event-parameters-are-recorded
  ; `(on :send [text] …)` folded its parameter list INTO the body before this
  ; feature, so the names were lost. The wire is positional; without names there
  ; is nothing to bind a payload to.
  (is (= ["text"] (params-for contract-term :send))))

(deftest a-bare-payload-binds-to-a-single-parameter
  ; `fire :send @draft` compiles to `pushEvent("send", "<the draft>")` — the
  ; emitted signal declares no body template, so the runtime sends the raw
  ; argument. Verified against the real compiled bundle, not assumed.
  (is (= {"text" "hello"} (bind-params contract-term :send "hello"))))

(deftest a-named-payload-binds-by-name
  (is (= {"text" "hello"} (bind-params contract-term :send {"text" "hello"}))))

;; ── the handler ─────────────────────────────────────────────────────────────

(deftest an-empty-draft-is-refused-and-changes-nothing
  (let [r (handle contract-term :send "" {"messages" [] "status" "idle"})]
    (is (= {:tag "err" :value "Say something first"} (get r :reply)))
    (is (= [] (get (get r :assigns) "messages")))
    (is (nil? (get r :ask)))))

(deftest a-real-message-is-accepted-appended-and-asks-the-provider
  (let [r (handle contract-term :send "hello" {"messages" [] "status" "idle"})
        msgs (get (get r :assigns) "messages")]
    (is (= {:tag "ok" :value "accepted"} (get r :reply)))
    ; APPENDED, not prepended: `conj` on a list prepends, which would have
    ; reversed the transcript. `append` exists because of this.
    (is (= 1 (count msgs)))
    (is (= "user" (get (first msgs) :role)))
    (is (= "hello" (get (first msgs) :text)))
    (is (= :thinking (get (get r :assigns) "status")))
    ; the provider turn is REQUESTED, never performed here
    (is (= "hello" (get r :ask)))))

(deftest the-transcript-keeps-its-order-across-turns
  (let [one (handle contract-term :send "first" {"messages" [] "status" "idle"})
        two (handle contract-term :send "second" (get one :assigns))
        msgs (get (get two :assigns) "messages")]
    (is (= 2 (count msgs)))
    (is (= "first" (get (first msgs) :text)))
    (is (= "second" (get (last msgs) :text)))))

;; ── server-internal messages ────────────────────────────────────────────────

(deftest a-token-accumulates-into-the-rendered-assign
  ; A token used to do two things — accumulate into `@partial` AND ride a
  ; `push!` — and the push half rendered nothing: no bind consumed the page's
  ; effect stream, which is what verse kept reporting as `W0201: 'fx' is
  ; defined but never used`. The push is gone; what remains is the half that
  ; the page actually shows.
  (let [r (handle-info contract-term [:delta "m1" "hel"] {"partial" "" "status" "thinking"})]
    (is (= "hel" (get (get r :assigns) "partial")))
    (is (= 0 (count (get r :pushes))))))

(deftest tokens-accumulate-in-order
  (let [a (handle-info contract-term [:delta "m1" "hel"] {"partial" "" "status" "thinking"})
        b (handle-info contract-term [:delta "m1" "lo"] (get a :assigns))]
    (is (= "hello" (get (get b :assigns) "partial")))))

(deftest done-joins-the-answer-to-the-transcript
  ; The contract's own comment promised this and no clause did it. A conversation
  ; the page can render IS the transcript; a streamed answer that never lands
  ; there vanishes when the turn ends.
  (let [r (handle-info contract-term [:done "m1"]
                       {"messages" [{:role "user" :text "hi"}]
                        "partial" "the answer"
                        "status" "thinking"})
        msgs (get (get r :assigns) "messages")]
    (is (= 2 (count msgs)))
    (is (= "model" (get (last msgs) :role)))
    (is (= "the answer" (get (last msgs) :text)))
    ; cleared, or the next turn inherits this one's text
    (is (= "" (get (get r :assigns) "partial")))
    (is (= :idle (get (get r :assigns) "status")))))

(deftest a-failure-clears-the-turn-and-reports-it
  ; The reason reaches an ASSIGN, not a push. A push had no subscriber, so a
  ; 401, an exhausted quota and a dropped connection were indistinguishable
  ; from nothing happening: the indicator stopped and the page said nothing.
  (let [r (handle-info contract-term [:failed "m1" "HTTP 403"]
                       {"partial" "half an ans" "status" "thinking"})]
    (is (= :idle (get (get r :assigns) "status")))
    (is (= "" (get (get r :assigns) "partial")))
    (is (= "HTTP 403" (get (get r :assigns) "error")))
    (is (= 0 (count (get r :pushes))))))

(deftest an-undescribed-message-changes-nothing
  ; A protocol drift must not silently mutate state.
  (let [r (handle-info contract-term [:unknown "x"] {"status" "thinking"})]
    (is (= "unmatched" (get r :status)))
    (is (= "thinking" (get (get r :assigns) "status")))))

(deftest arity-is-part-of-the-match
  ; `[:done id]` must not swallow a longer `[:done id extra]` from a later
  ; protocol — truncation is the quietest possible incompatibility.
  (is (= "unmatched" (get (handle-info contract-term [:done "m1" "extra"] {}) :status))))

;; ── the boundary ────────────────────────────────────────────────────────────

(deftest the-vocabulary-is-CLOSED
  ; The walker is not an evaluator. A body calling something outside the
  ; whitelist is refused by name — this is what keeps a model-proposed contract
  ; from reaching the runtime through its handler.
  (let [c (assoc-in contract-term [:events :evil]
                    {:params [] :body (quote (System/halt))})]
    (is (thrown? (handle c :evil {} {})))))

(deftest an-unbound-name-is-refused-rather-than-nil
  ; A handler reading a parameter the wire never sent is a seam defect; nil
  ; would turn it into a quiet empty message.
  (let [c (assoc-in contract-term [:events :typo]
                    {:params [] :body (quote (ok missing-name))})]
    (is (thrown? (handle c :typo {} {})))))

(deftest a-contract-with-no-handler-says-so
  (let [c (assoc-in contract-term [:events :orphan] {:params [] :body nil})]
    (is (= "no-handler" (get (handle c :orphan {} {}) :status)))))

;; ── mount ───────────────────────────────────────────────────────────────────

(deftest the-seed-carries-every-declared-assign
  (let [seed (seed-assigns contract-term {})]
    (is (contains? seed "messages"))
    (is (contains? seed "status"))
    (is (contains? seed "partial"))))

(deftest held-state-wins-over-the-seed
  ; A reconnect must not wipe the transcript.
  (let [seed (seed-assigns contract-term {"messages" [{:role "user" :text "kept"}]})]
    (is (= 1 (count (get seed "messages"))))))
