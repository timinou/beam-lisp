; test/bl/contract_edn_test.bl — defcontract's Spacetime (EDN) half.
; Run: mix beam_lisp.test test/bl/contract_edn_test.bl
;
; The BEAM half is checked against a known-good fingerprint (contract_test.bl).
; The EDN half has no such constant, so these tests pin the properties that make
; the two halves UNABLE to disagree:
;
;   * every declared assign becomes a `@data subscribe`
;   * every declared event becomes a `@data signal`
;   * a signal's receive arms are DERIVED from the handler's reply tags
;   * every declared push becomes an arm on the effect stream
;
; The last two are the point. A page cannot be missing an arm for a tag the
; server can produce, because the arms ARE the tags — not a parallel declaration
; that has to be kept in sync, which is exactly the drift FUP-143 describes and
; Elixir cannot check.
;
; Shapes here are taken from REAL printer output for a page that compiles today
; (`spacetime edn elixir/spacetime_lv/frontend/counter.st`), not from reading the
; grammar by eye. Verified end to end: this emitter's output is accepted by
; verse's own reader and renders back to valid `.st`.

(ns spell.contract-edn.test
  (:require [spell.contract :refer [parse parse-view edn-forms edn-document]]
            [spell.seam :refer [reply-tags handler-for]]
            [spell.live :refer [machine-view-edn machine-page-edn]]
            [spell.seed]
            [spell.machine :refer [empty-machine register-contract register-view]]))

(def counter
  (parse :counter-live
         {:bundle "/spacetime/counter/spacetime.js" :root ".counter"}
         (list
           (quote (assign @count :integer 0))
           (quote (push @flash {:message :string :kind :atom}))
           (quote (on :inc (set! @count (inc @count)) (ok @count)))
           (quote (on :dec (if (zero? @count)
                             (err "Count cannot go below zero")
                             (do (set! @count (dec @count)) (ok @count))))))))

(def forms (edn-forms counter "counter"))
(def joined (join "\n" forms))

;; ── one form per declaration ────────────────────────────────────────────────

(deftest every-assign-becomes-a-subscribe
  (is (includes? joined "(data-subscribe :name $count :host $counter :assign count)")))

(deftest every-event-becomes-a-signal
  (is (includes? joined "(data-signal :name $inc"))
  (is (includes? joined "(data-signal :name $dec")))

(deftest every-push-becomes-a-stream-arm
  (is (includes? joined "(data-live-stream :name $fx"))
  (is (includes? joined "\"ctor\" Flash")))

(deftest the-count-is-exact
  ; 1 assign + 2 events + 1 stream. A form appearing twice would silently
  ; double-declare a signal.
  (is (= 4 (count forms))))

;; ── the arms ARE the reply tags ─────────────────────────────────────────────
;; This is the property that makes the seam unable to drift.

(deftest an-ok-only-handler-gets-one-arm
  (let [sig (first (filter (fn [f] (includes? f ":name $inc")) forms))]
    (is (= (list "ok") (reply-tags (handler-for counter "inc"))))
    (is (includes? sig "\"lit\" \"ok\""))
    ; and NO catch-all, because the handler cannot fail
    (is (not (includes? sig "\"name\" _")))))

(deftest a-handler-that-can-fail-gets-both-arms
  (let [sig (first (filter (fn [f] (includes? f ":name $dec")) forms))]
    (is (= (list "err" "ok") (reply-tags (handler-for counter "dec"))))
    (is (includes? sig "\"lit\" \"ok\""))
    ; the err tag becomes the catch-all arm — without it a rejected
    ; decrement silently drops in the browser
    (is (includes? sig "\"name\" _"))))

(deftest adding-a-failure-path-adds-an-arm
  ; the drift scenario, made impossible: change the handler, the page follows
  (let [before (parse :x {} (list (quote (on :go (ok 1)))))
        after (parse :x {} (list (quote (on :go (if p (err "no") (ok 1))))))
        f-before (first (edn-forms before "h"))
        f-after (first (edn-forms after "h"))]
    (is (not (includes? f-before "\"name\" _")))
    (is (includes? f-after "\"name\" _"))))

(deftest each-signal-declares-its-sum-type
  ; a page needs a name to decode replies into; deriving it means the two
  ; halves cannot disagree about what that name is
  (is (includes? joined ":sum IncResult"))
  (is (includes? joined ":sum DecResult")))

(deftest each-signal-targets-its-event-name
  (is (includes? joined ":target \"inc\""))
  (is (includes? joined ":target \"dec\"")))

;; ── bindings print bare ─────────────────────────────────────────────────────

(deftest bindings-are-symbols-not-strings
  ; SPEC §4: a Binding is a `$`-prefixed SYMBOL. Quoting it would make it a
  ; string and change its meaning — the form would no longer name a signal.
  (is (includes? joined ":name $count"))
  (is (not (includes? joined ":name \"$count\""))))

;; ── the document ────────────────────────────────────────────────────────────

(deftest emits-a-document-not-a-bare-form-list
  (let [doc (edn-document counter "counter" ["stdlib/macros/data-kind"])]
    (is (starts-with? doc "{:st/imports ["))
    (is (includes? doc ":st/forms ["))
    (is (includes? doc "\"stdlib/macros/data-kind\""))))

(deftest a-contract-with-no-pushes-emits-no-stream
  ; an empty stream form would declare a channel nothing ever sends on
  (let [c (parse :x {} (list (quote (assign @a :string ""))
                             (quote (on :go (ok 1)))))]
    (is (not (includes? (join "\n" (edn-forms c "h")) "data-live-stream")))
    (is (= 2 (count (edn-forms c "h"))))))

(deftest a-fire-and-forget-handler-still-emits-a-signal
  ; no reply tags means no arms — but the page must still be able to FIRE it
  (let [c (parse :x {} (list (quote (on :ping (set! @n 1)))))
        f (first (edn-forms c "h"))]
    (is (includes? f "(data-signal :name $ping"))
    (is (includes? f ":arms [:st/array ]"))))

;; ── merging is DATA, not text ─────────────────────────────────────────────
;;
;; A machine's page is many contracts and many views at once. Merging them used
;; to mean printing each as text and PARSING IT BACK to find its sections —
;; ~90 lines of scanning in `spell.live` with hand-rolled string- and
;; escape-state tracking. Both payloads below defeated an earlier version of
;; that scanner; neither can reach a parser any more, because there is none.

(deftest a-bracket-inside-template-html-does-not-truncate-the-document
  ;; `edn-str` emits template html with its quotes escaped, so `data-x="a]b"`
  ;; arrives as `\"a]b\"`. A scanner that toggled string mode on every quote
  ;; left it at the escape, then read the `]` inside `a]b` as the section
  ;; terminator — producing a 445-byte document ending mid-template.
  (let [v (parse-view :brackety
            (list (quote (markup (template &t [$m] "<i class='t' data-x=\"a]b\">{@m.text}</i>")))
                  (quote (binds [".t" (st/each @messages :as @m :template &t)]))))
        doc (machine-view-edn (register-view (empty-machine) v))]
    (is (ends-with? (trim doc) "}"))
    (is (includes? doc "a]b"))))

(deftest a-section-header-inside-a-style-value-is-not-a-section-header
  ;; The second hardening: a value containing the literal text `:st/scopes [`
  ;; could be mistaken for the header and the scan would start inside it.
  (let [v (parse-view :forgery
            (list (quote (markup (template &t [$m] "<i class='t'>{@m.text}</i>")))
                  (quote (style [".t" {"content" "]:st/scopes ["}]))
                  (quote (binds [".t" (st/each @messages :as @m :template &t)]))))
        doc (machine-view-edn (register-view (empty-machine) v))]
    (is (ends-with? (trim doc) "}"))
    (is (includes? doc ":st/constructs"))))

(deftest a-merged-document-declares-ONE-imports-key
  ;; Concatenating printed text produced a document with repeated
  ;; `:st/imports` keys, which the reader silently takes one of.
  (let [m (register-view (register-view (empty-machine)
                                        (parse-view :a
                                          (list (quote (markup (template &ta [] "<i class='a'>x</i>"))))))
                         (parse-view :b
                           (list (quote (markup (template &tb [] "<i class='b'>y</i>"))))))
        doc (machine-view-edn m)]
    ;; n occurrences of a separator split into n+1 pieces, so ONE key is two.
    (is (= 2 (count (split doc ":st/imports"))))))


(deftest the-seed-machine-emits-one-complete-page
  (let [m (register-view (register-contract (empty-machine) spell.seed/contract-term)
                         spell.seed/view-term)
        doc (machine-page-edn m "SpellWeb")]
    (is (includes? doc ":st/imports"))
    (is (includes? doc "(host-live"))
    (is (includes? doc ":name $chat-live"))
    (is (includes? doc "[:st/expr \"\\\"SpellWeb.ChatLive\\\"\"]"))
    (is (includes? doc "(data-inline :name $draft"))
    (is (includes? doc ":st/css [[:st/raw"))))

(deftest a-driver-key-containing-a-quote-emits-VALID-edn
  ;; `"` is a legal key filter, and the value was once printed between
  ;; hand-written quotes with no escaping — the document did not parse and
  ;; the whole page stopped compiling for one keystroke. It goes through
  ;; `edn-str`, the same printer every other capture uses.
  (let [v (parse-view :quoted
            (list (quote (markup (template &q [] "<i class='q'>x</i>")))
                  (quote (binds [".q" (st/on :keydown (fire :send) :key "\"")]))))
        doc (machine-view-edn (register-view (empty-machine) v))]
    ;; the escaped form, not a bare quote closing the capture early
    (is (includes? doc "\"value\" \"\\\"\""))))

