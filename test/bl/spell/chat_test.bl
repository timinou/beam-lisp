; test/bl/chat_test.bl — the chat interface as one term.
; Run: mix beam_lisp.test test/bl/chat_test.bl
;
; The deliverable: a `defcontract` + `defview` from which BOTH halves of the
; app are emitted. These tests assert the properties that make the two unable to
; disagree, not the incidental shape of the output.
;
; Every document asserted here was fed through verse's own `to_st_file`:
;   page: OK — 4 forms, 0 scopes
;   view: OK — 1 forms, 11 scopes (2 construct)

(ns spell.chat.test
  (:require [spell.seed :refer [contract-term view-term server-contract page-document
                          view-page module]]
            [spell.seam :refer [events assigns pushes reply-tags handler-for
                          disagreements agree?]]))

;; ── the seam ────────────────────────────────────────────────────────────────

(deftest declares-the-whole-seam
  (is (= (list "send") (events contract-term)))
  (is (= (list "messages" "partial" "status") (assigns contract-term)))
  (is (= (list "failed" "token") (pushes contract-term))))

(deftest the-send-handler-can-answer-BOTH-ways
  ; an empty draft is refused; a real one is accepted. Both paths are literal,
  ; which is what lets the page be checked against them.
  (is (= (list "err" "ok") (reply-tags (handler-for contract-term "send")))))

(deftest the-emitted-page-decodes-every-tag-the-server-can-send
  ; THE property. The page's arms are DERIVED from the handler's reply tags, so
  ; a page missing an arm is not merely unlikely — it is unrepresentable.
  ;
  ; NB the page projection is built FROM THE EMITTED DOCUMENT, not hand-written.
  ; A review found the earlier version supplying a map that already matched the
  ; contract by construction, so it stayed green while the real artifacts had an
  ; empty send payload and rendered nothing.
  (let [d (page-document)
        page {:fires (if (includes? d ":target \"send\"") ["send"] [])
              :subscribes (filterv (fn [a] (includes? d (str ":assign " a)))
                                   ["messages" "partial" "status"])
              :arms {:send (filterv (fn [t] (includes? d t)) ["ok" "_"])}}]
    (is (= ["send"] (get page :fires)) "the emitted page can fire send")
    (is (= ["messages" "partial" "status"] (get page :subscribes)) "and subscribes to every assign")
    (is (= [] (disagreements contract-term page)))
    (is (= true (agree? contract-term page)))))

;; ── the app must actually WORK ──────────────────────────────────────────────
;; A review found the first version emitting documents verse accepted while
;; being unable to send a message or show a reply: it styled `.log` and
;; `.composer__send` without ever creating them, and never rendered `@messages`.
;; CSS does not create DOM, and a subscription nothing reads is a no-op.

(deftest every-styled-element-EXISTS-in-the-markup
  (let [v (view-page)
        dom (subs v (index-of v ":st/constructs"))]
    (is (includes? dom "class='log'"))
    (is (includes? dom "class='composer__input'"))
    (is (includes? dom "class='composer__send'"))))

(deftest the-page-has-an-input-and-a-send-control
  ; without these there is no way for a user to say anything at all
  (let [v (view-page)]
    (is (includes? v "<input"))
    (is (includes? v "<button"))))

(deftest what-the-user-TYPES-reaches-a-signal
  ; the input writes `$draft` on every keystroke; without the mutation the
  ; message is lost before it can be sent
  (let [v (view-page)]
    (is (includes? v "\"member\" input"))
    (is (includes? v "\"target\" draft"))
    (is (includes? v "$.value"))))

(deftest the-draft-CROSSES-the-seam-as-an-argument
  ; the handler takes `text` as a PARAMETER. Reading a page-local `@draft` on
  ; the server would mean every message arrives empty at the boundary.
  (let [v (view-page)]
    (is (includes? v "\"signal\" send"))
    (is (includes? v "$draft"))))

(deftest the-transcript-is-RENDERED-not-merely-subscribed
  ; an `@each` over `$messages` instantiating the bubble template
  (let [v (view-page)]
    (is (includes? v "(each :source $messages"))
    ;; `"name"` and `"args"` are STRINGS on the wire — the shape the printer
    ;; produces for the same construct. Bare symbols printed the invocation
    ;; inverted (`@each(…) { [$m] bubble }`) and unparseable.
    (is (includes? v "\"name\" \"bubble\""))))

(deftest every-bind-carries-its-SELECTOR
  ; `(sel "…" form)` is the reader's scope wrapper — `selector` is a FormMatch
  ; FIELD, not a capture, so a bare form is unattached behaviour: the page
  ; compiles clean and the button does nothing.
  (let [v (view-page)]
    (is (includes? v "(sel \".log\""))
    (is (includes? v "(sel \".composer__input\""))
    (is (includes? v "(sel \".composer__send\""))))

(deftest the-handler-drives-a-provider-turn
  ; accepting a send that never asks anything is a chat app that cannot answer
  (let [body (handler-for contract-term "send")]
    (is (includes? (pr-str body) "ask!"))
    (is (includes? (pr-str body) "thinking"))))

(deftest provider-outcomes-are-handled
  ; delta/done/failed all arrive as ordinary BEAM messages
  (let [infos (pr-str (get contract-term :infos))]
    (is (includes? infos "delta"))
    (is (includes? infos "done"))
    (is (includes? infos "failed"))))

(deftest a-page-missing-the-err-arm-IS-a-disagreement
  ; the failure the seam check exists to catch: without it, a refused send
  ; silently does nothing in the browser
  (let [page {:fires ["send"] :subscribes [] :arms {:send ["ok"]}}
        d (disagreements contract-term page)]
    (is (= 1 (count d)))
    (is (= :reply-not-decoded (get (first d) :kind)))
    (is (= "err" (get (first d) :tag)))))

;; ── the server sidecar ──────────────────────────────────────────────────────

(deftest the-sidecar-carries-reply-tags
  ; the field Elixir cannot write, because its handler bodies are opaque
  (let [s (server-contract)]
    (is (includes? s "\"name\":\"send\",\"replies\":[\"err\",\"ok\"]"))
    ; `SpellWeb`, not `SpacetimeLvWeb`: the module the page's `@host` names is
    ; now GENERATED from this contract and compiled into this app. It used to
    ; name a module in verse's demo Phoenix app that nobody had written.
    (is (includes? s "\"module\":\"SpellWeb.ChatLive\""))
    (is (includes? s "\"fingerprint\":"))))

(deftest the-sidecar-declares-both-transient-effects
  ; a token is NOT an assign: pushing the transcript per token would send the
  ; whole conversation once per word
  (let [s (server-contract)]
    (is (includes? s "\"name\":\"token\""))
    (is (includes? s "\"name\":\"failed\""))
    (is (includes? s "\"text\":\"string\""))))

;; ── the page's seam declarations ────────────────────────────────────────────

(deftest the-page-subscribes-to-every-assign
  (let [d (page-document)]
    (is (includes? d "(data-subscribe :name $messages"))
    (is (includes? d "(data-subscribe :name $status"))))

(deftest the-page-can-fire-send
  (let [d (page-document)]
    (is (includes? d "(data-signal :name $send"))
    (is (includes? d ":target \"send\""))
    (is (includes? d ":sum SendResult"))))

(deftest the-page-decodes-BOTH-reply-shapes
  (let [d (page-document)]
    (is (includes? d "\"lit\" \"ok\""))
    ; the catch-all that carries the err reply
    (is (includes? d "\"name\" _"))))

(deftest tokens-arrive-on-the-effect-stream
  ; the same receive-arm vocabulary as replies — one decode vocabulary, no
  ; parallel protocol (bridge principle 4)
  (let [d (page-document)]
    (is (includes? d "(data-live-stream :name $fx"))
    (is (includes? d "\"ctor\" Token"))
    (is (includes? d "\"ctor\" Failed"))))

;; ── the view ────────────────────────────────────────────────────────────────

(deftest the-view-emits-all-three-planes
  (let [v (view-page)]
    (is (includes? v ":st/constructs ["))
    (is (includes? v ":st/scopes ["))
    (is (includes? v ":st/forms ["))))

(deftest both-templates-are-carried
  (let [v (view-page)]
    (is (includes? v "@template:bubble"))
    (is (includes? v "@template:thinking"))))

(deftest the-bubble-template-reads-its-message
  ; A hole in a TEMPLATE BODY is spelled as a backtick expression, not as a
  ; `[:st/hole N]` marker — that spelling belongs to the `:st/html` plane, where
  ; a top-level block must be addressable (BUG-369). A template body is
  ; reconstructed as source, so it carries its holes inline.
  ;
  ; The ATTRIBUTE hole is quoted. `data-role=`$m.role`` unquoted is read by the
  ; HTML tokenizer as a literal attribute value, so the DOM came out carrying
  ; the characters `$m.role` instead of "user" — the page rendered, the bubbles
  ; appeared, and every `[data-role='user']` rule silently missed.
  (let [v (view-page)]
    (is (includes? v "'`$m.role`'"))
    (is (includes? v "`$m.text`"))
    (is (not (includes? v ":st/hole")))))

(deftest the-send-button-fires-the-declared-signal
  ; `on-driver-body` is the REGISTERED macro name; `on` is only how the
  ; directive is spelled in .st source, and the EDN reader refuses to invent
  ; syntax — which is how the wrong name was caught immediately
  (let [v (view-page)]
    (is (includes? v "(on-driver-body"))
    (is (includes? v "\"member\" click"))
    ;; `{"stmt" {"args" … "signal" name}}` — the shape `on_signal_call`
    ;; produces. Invented keys (`"call"`/`"target"`) still PARSED, and printed
    ;; back as `$.($draft,)`: a call with no callee.
    (is (includes? v "\"signal\" send"))))

(deftest a-selector-may-appear-in-BOTH-style-and-binds
  ; the many-to-many the three planes exist to preserve: `.composer__send` is
  ; styled here and bound there
  (let [v (view-page)]
    (is (includes? v ".composer__send"))
    (is (includes? v "(on-driver-body"))))

(deftest role-styling-distinguishes-user-from-model
  (let [v (view-page)]
    (is (includes? v "[data-role='user']"))
    (is (includes? v "[data-role='model']"))))
