; test/bl/spell/live_state_test.bl — the live-environment definition.
; Run: mix beam_lisp.test test/bl/spell/live_state_test.bl
;
; What is asserted here is the shell's SECOND definition behaving like the
; first: the contract parses, its handler RUNS against the real environment
; (the one this test itself is loaded into — no fixture could be more honest),
; and the machine holding BOTH definitions reports no errors.

(ns spell.live-state.test
  (:require [spell.live-state :refer [contract-term view-term]]
            [spell.server :refer [handle mount-event]]
            [spell.machine :as machine]
            [spell.live :as live]
            [spell.seed]))

;; ── the contract ────────────────────────────────────────────────────────────

(deftest the-contract-declares-its-seam
  (is (= :live-state (get contract-term :name)))
  (is (contains? (get contract-term :assigns) :vars))
  (is (contains? (get contract-term :assigns) :vars_count))
  (is (contains? (get contract-term :events) :refresh)))

(deftest the-contract-asks-for-a-mount-event
  ; `:mount-event :refresh` is what populates @vars before the first render —
  ; the browser remounts when the machine grows, so this opt IS the growth
  ; notification.
  (is (= :refresh (mount-event contract-term))))

(deftest the-chat-contract-has-no-mount-event
  (is (nil? (mount-event spell.seed/contract-term))))

;; ── the handler, against the real environment ───────────────────────────────

(deftest refresh-populates-the-loaded-vars
  (let [r (handle contract-term :refresh nil {})]
    (is (= "ok" (get r :status)))
    (is (= {:tag "ok" :value "refreshed"} (get r :reply)))
    (let [vars (get (get r :assigns) "vars")]
      (is (not (empty? vars)))
      ; the environment under test is the environment under test: this very
      ; namespace and function are loaded, so they appear
      (is (some (fn [v] (and (= "spell.server" (get v :ns))
                             (= "handle" (get v :name))
                             (= "fn" (get v :kind))))
                vars))
      ; a namespace of plain defs appears too — `namespaces` was widened for
      ; exactly this, and live-state is itself a contract-only namespace
      (is (some (fn [v] (and (= "spell.live-state" (get v :ns))
                             (= "contract-term" (get v :name))))
                vars)))))

(deftest the-count-is-the-length
  (let [r (handle contract-term :refresh nil {})
        vars (get (get r :assigns) "vars")]
    (is (= (count vars) (get (get r :assigns) "vars_count")))))

(deftest the-list-is-sorted-so-refresh-is-stable
  (let [r (handle contract-term :refresh nil {})
        keys (vec (map (fn [v] (str (get v :ns) "/" (get v :name)))
                       (get (get r :assigns) "vars")))]
    ; vec on both sides: seq/vector cross-equality is not the claim here
    (is (= (vec (sort keys)) keys))))

(deftest the-values-are-seam-safe-strings
  ; @vars crosses the bridge as JSON: atoms, tuples and fns would fail there,
  ; far from this handler.
  (let [r (handle contract-term :refresh nil {})]
    (is (every? (fn [v] (and (string? (get v :ns))
                             (string? (get v :name))
                             (string? (get v :kind))))
                (get (get r :assigns) "vars")))))

(deftest live-vars-takes-no-arguments
  (let [r (try
            (handle (assoc-in contract-term
                              [:events :refresh :body]
                              (quote (do (set! @vars (live-vars 1))
                                         (ok "refreshed"))))
                    :refresh nil {})
            (catch e :thrown))]
    (is (= :thrown r))))

;; ── the machine, with both definitions ──────────────────────────────────────

(defn- default-shell []
  (live/seeded (machine/empty-machine)
               [[spell.seed/contract-term spell.seed/view-term]
                [contract-term view-term]]))

(deftest the-default-shell-holds-both-definitions
  (let [m (default-shell)]
    ; names are KEYWORDS — `parse :chat-live`, not strings
    (is (= [:chat-live :live-state]
           (mapv (fn [c] (get c :name)) (machine/contracts m))))
    (is (= [:chat-view :live-state-view]
           (mapv (fn [v] (get v :name)) (machine/views m))))))

(deftest the-default-shell-reports-no-errors
  (let [m (default-shell)
        locals (vec (distinct (mapcat machine/view-locals (machine/views m))))]
    (is (= [] (machine/errors m locals)))))

(deftest the-page-has-one-host
  ; ONE page, ONE LiveView socket: every contract's seam points at the first
  ; contract's host. A second host would register subscriptions under a module
  ; the bridge never hears from.
  (let [m (default-shell)]
    (is (= ["chat-live"] (live/machine-hosts m)))))

(deftest the-panel-renders-into-the-shell
  ; the live-state view binds selectors the seed's &shell renders
  (let [m (default-shell)
        shell (live/machine-shell m)]
    (is (includes? shell "state__list"))
    (is (includes? shell "state__count"))
    (is (includes? shell "state__refresh"))))
