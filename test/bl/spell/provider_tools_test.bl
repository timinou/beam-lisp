; test/bl/spell/provider_tools_test.bl — decoding a TOOL-CALL turn.
; Run: mix beam_lisp.test test/bl/spell/provider_tools_test.bl
;
; No network. The payload shapes below are the ones PLAN-023 captured from a
; live k3-256k probe, which is what makes them worth pinning: on a tool-call
; turn Kimi sends `finish_reason: "tool_calls"`, an EMPTY `content`, the
; payload in `tool_calls[].function.arguments` (itself a JSON *string*), and —
; being a reasoning model — a sibling `reasoning_content` field.
;
; The failure this suite exists to prevent is specific and quiet:
; `extract-content` anchors on `choices` → `content` and returns "" for such a
; turn. A loop built on it sees the model "say nothing", renders an empty
; bubble, and never learns a tool was requested. Nothing raises. The machine
; simply never grows.

(ns spell.provider-tools.test
  (:require [spell.provider :refer [extract-turn extract-content tool-calls
                                    request-body]]))

;; ── fixtures: recorded shapes ───────────────────────────────────────────────

(def content-turn
  (str "{\"id\":\"c1\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\","
       "\"content\":\"Hello there\"},\"finish_reason\":\"stop\"}]}"))

(def tool-turn
  ;; The shape that broke the old scan: content is "" and the payload is in
  ;; tool_calls. `arguments` is a JSON STRING, so its quotes arrive escaped.
  (str "{\"id\":\"c2\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\","
       "\"content\":\"\",\"tool_calls\":[{\"id\":\"call_abc\",\"type\":\"function\","
       "\"function\":{\"name\":\"define\",\"arguments\":"
       "\"{\\\"kind\\\":\\\"view\\\",\\\"name\\\":\\\"clock\\\"}\"}}]},"
       "\"finish_reason\":\"tool_calls\"}]}"))

(def reasoning-turn
  ;; A reasoning model puts thinking in `reasoning_content` BEFORE `content`.
  ;; A scan that takes the first `content`-ish field it meets answers with the
  ;; model's working notes presented as its reply.
  (str "{\"id\":\"c3\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\","
       "\"reasoning_content\":\"Let me think about this step by step\","
       "\"content\":\"The answer is 42\"},\"finish_reason\":\"stop\"}]}"))

(def two-tool-turn
  (str "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"\","
       "\"tool_calls\":["
       "{\"id\":\"c_1\",\"type\":\"function\",\"function\":{\"name\":\"define\","
       "\"arguments\":\"{\\\"kind\\\":\\\"contract\\\"}\"}},"
       "{\"id\":\"c_2\",\"type\":\"function\",\"function\":{\"name\":\"inspect_machine\","
       "\"arguments\":\"{}\"}}]},\"finish_reason\":\"tool_calls\"}]}"))

;; ── extract-turn: one decoder, both kinds ───────────────────────────────────

(deftest a-content-turn-decodes-as-content
  (let [t (extract-turn content-turn)]
    (is (= :content (get t :kind)))
    (is (= "Hello there" (get t :content)))
    ;; tool-calls is always present as a vector, never nil: a caller that has
    ;; to nil-check before counting will eventually forget to.
    (is (= [] (get t :tool-calls)))))

(deftest a-tool-turn-decodes-as-tool-calls
  ; THE regression this suite exists for. Before extract-turn, this response
  ; produced "" and the loop reported an empty answer.
  (let [t (extract-turn tool-turn)]
    (is (= :tool-calls (get t :kind)))
    (is (= 1 (count (get t :tool-calls))))
    (let [c (get (get t :tool-calls) 0)]
      (is (= "define" (get c :name)))
      (is (= "call_abc" (get c :id)))
      ;; arguments arrive as a JSON string, UNESCAPED by the decoder: the
      ;; caller parses it. Handing back the raw escaped form would push the
      ;; same unescaping bug into every call site.
      (is (= "{\"kind\":\"view\",\"name\":\"clock\"}" (get c :arguments))))))

(deftest reasoning-content-is-not-the-answer
  ; Anchoring must reach the real `content`, not the reasoning that precedes
  ; it — otherwise the user reads the model's notes as its reply.
  (let [t (extract-turn reasoning-turn)]
    (is (= :content (get t :kind)))
    (is (= "The answer is 42" (get t :content)))))

(deftest every-tool-call-in-the-turn-is-decoded
  ; A turn may request several tools. Decoding only the first silently drops
  ; work the model asked for, and the loop then reports success having done
  ; half of it.
  (let [t (extract-turn two-tool-turn)
        cs (get t :tool-calls)]
    (is (= 2 (count cs)))
    (is (= "define" (get (get cs 0) :name)))
    (is (= "inspect_machine" (get (get cs 1) :name)))
    (is (= "{}" (get (get cs 1) :arguments)))))

(deftest a-turn-with-neither-is-an-error-not-an-empty-answer
  ; A 200 that carries no assistant text and no tool call is a FAILURE. `{:kind
  ; :content :content ""}` would render as a blank bubble and look like the
  ; model chose to say nothing.
  (let [t (extract-turn "{\"choices\":[{\"message\":{\"role\":\"assistant\"}}]}")]
    (is (= :error (get t :kind))))
  (let [t (extract-turn "{\"error\":{\"message\":\"upstream boom\"}}")]
    (is (= :error (get t :kind)))))

(deftest an-error-envelope-does-not-masquerade-as-content
  ; The anchoring lesson from extract-content, re-asserted for the new decoder:
  ; an `error` object carrying its own `content` must not be returned as the
  ; model's reply.
  (let [t (extract-turn
            (str "{\"error\":{\"content\":\"upstream detail\"},"
                 "\"choices\":[{\"message\":{\"content\":\"real answer\"}}]}"))]
    (is (= :content (get t :kind)))
    (is (= "real answer" (get t :content)))))

;; ── extract-content still works, unchanged ──────────────────────────────────

(deftest extract-content-is-unchanged-for-content-turns
  ; extract-turn is additive. The existing decoder keeps its contract, because
  ; `ask` and the whole non-tool path still use it.
  (is (= "Hello there" (extract-content content-turn)))
  (is (= "The answer is 42" (extract-content reasoning-turn))))

(deftest extract-content-reports-nothing-for-a-tool-turn
  ; Documents the LIMIT of the old decoder rather than pretending it grew a new
  ; ability: on a tool turn it sees the empty content string, which is exactly
  ; why extract-turn exists.
  (is (= "" (extract-content tool-turn))))

;; ── tool-calls accessor ─────────────────────────────────────────────────────

(deftest tool-calls-reads-straight-from-a-body
  ; The convenience the loop actually calls. Same decoding, one step.
  (let [cs (tool-calls tool-turn)]
    (is (= 1 (count cs)))
    (is (= "define" (get (get cs 0) :name))))
  (is (= [] (tool-calls content-turn))))

;; ── the request side ────────────────────────────────────────────────────────

(deftest tools-are-omitted-when-none-are-offered
  ; A `"tools":[]` key is not the same as no key: some providers reject an
  ; empty array, and every byte here is a byte the model reads.
  (let [b (request-body {:model "k3"} [{:role "user" :content "hi"}] false)]
    (is (= false (includes? b "tools")))))

(deftest tools-are-declared-when-offered
  (let [b (request-body {:model "k3"
                         :tools [{:name "define"
                                  :description "Add a contract or a view"
                                  :parameters "{\"type\":\"object\"}"}]}
                        [{:role "user" :content "hi"}] false)]
    (is (includes? b "\"tools\":["))
    (is (includes? b "\"type\":\"function\""))
    (is (includes? b "\"name\":\"define\""))
    (is (includes? b "\"description\":\"Add a contract or a view\""))
    ;; parameters is a pre-built JSON schema string and must be EMBEDDED, not
    ;; quoted as a string value — a quoted schema is a provider 400 that reads
    ;; like an auth problem.
    (is (includes? b "\"parameters\":{\"type\":\"object\"}"))
    (is (= false (includes? b "\"parameters\":\"{")))))

(deftest a-tool-result-is-a-message-role
  ; The loop feeds a tool's OUTPUT back as a message with role "tool" carrying
  ; the originating call id. Without the id the provider cannot correlate the
  ; result with the request, and the next turn reasons about nothing.
  (let [b (request-body {:model "k3"}
                        [{:role "user" :content "add a clock"}
                         {:role "assistant" :content "" :tool-calls
                          [{:id "call_abc" :name "define" :arguments "{}"}]}
                         {:role "tool" :tool-call-id "call_abc" :content "{\"ok\":true}"}]
                        false)]
    (is (includes? b "\"role\":\"tool\""))
    (is (includes? b "\"tool_call_id\":\"call_abc\""))
    ;; the assistant's own tool_calls must be echoed back, or the provider
    ;; rejects the tool message as unsolicited
    (is (includes? b "\"tool_calls\":["))
    (is (includes? b "\"name\":\"define\""))))
