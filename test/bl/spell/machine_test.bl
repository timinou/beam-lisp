; test/bl/machine_test.bl — the machine reasoning about itself.
;
; Each test asserts against a machine built from REAL terms (`chat.bl`) or from
; a term deliberately broken for the test. The thing being checked is a set
; difference, so the tests are written to fail LOUD in the direction that
; matters: a check that reports nothing must be shown to report something when
; something is wrong, otherwise "no findings" is indistinguishable from "no
; check".

(ns spell.machine.test
  (:require [spell.contract :refer [parse parse-view]]
            [spell.machine :refer [empty-machine register-contract register-view
                             contracts views all-assigns all-events
                             view-bindings view-templates view-template-refs
                             view-fires view-selectors rendered-classes
                             class-tokens
                             orphan-bindings unrendered-assigns unhandled-fires
                             dead-templates errors warnings valid? report]]))

;; ── fixtures ────────────────────────────────────────────────────────────────

(def c-ok
  (parse :t-live {}
         (list (quote (assign @count :integer))
               (quote (assign @label :string))
               (quote (on :bump [n] (ok "done"))))))

(def v-ok
  (parse-view :t-view
    (list (quote (markup (template &row [$r] "<li class='row'>{@r.text}</li>")))
          (quote (style [".row" {:color "red"}]))
          (quote (binds [".list" (st/each @count :as @r :template &row)]
                        [".btn" (st/on :click (fire :bump @count))])))))

(defn m-ok []
  (register-view (register-contract (empty-machine) c-ok) v-ok))

;; ── projections ─────────────────────────────────────────────────────────────

(deftest bindings-are-found-through-reader-expansion
  ;; `@count` reaches this code as `(deref count)`, NOT as a symbol named
  ;; "@count". The first version of `view-bindings` scanned for an `@` prefix
  ;; and returned [] for a view full of bindings — a check that passed because
  ;; it was looking for a shape that does not exist.
  (is (= ["count" "r"] (view-bindings v-ok))))

(deftest templates-declared-and-invoked-are-different-questions
  (is (= ["row"] (view-templates v-ok)))
  (is (= ["row"] (view-template-refs v-ok))))

(deftest fires-are-anchored-on-the-fire-head
  ;; Not "every keyword in the binds plane": `:click` and `:as` are keywords
  ;; too, and reporting them as events would drown the real finding in noise.
  (is (= ["bump"] (view-fires v-ok))))

(deftest selectors-come-from-the-style-plane
  (is (= [".row"] (view-selectors v-ok))))

(deftest class-tokens-reads-both-quote-styles
  (is (= ["a" "b"] (vec (sort (class-tokens "<i class='a'></i><b class=\"b\"></b>")))))
  (is (= [] (class-tokens "<i data-x='y'></i>"))))

;; ── the machine holds what it is given ──────────────────────────────────────

(deftest registering-is-keyed-by-name-so-redefinition-replaces
  (let [m (register-contract (register-contract (empty-machine) c-ok) c-ok)]
    (is (= 1 (count (contracts m))))))

(deftest projections-span-every-registered-contract
  (is (= ["count" "label"] (all-assigns (m-ok))))
  (is (= ["bump"] (all-events (m-ok)))))

;; ── errors: the machine is broken NOW ───────────────────────────────────────

(def v-orphan
  (parse-view :orphan
    (list (quote (markup (template &x [] "<div class='x'></div>")))
          (quote (style [".x" {:color "red"}]))
          (quote (binds [".x" (st/each @ghost :as @g :template &x)])))))

(deftest a-binding-no-contract-declares-is-an-error
  (let [m (register-view (register-contract (empty-machine) c-ok) v-orphan)
        found (orphan-bindings m ["g"])]
    (is (= 1 (count found)))
    (is (= "ghost" (get (first found) :binding)))
    (is (not (valid? m ["g"])))))

(deftest page-locals-are-exempt
  ;; A page-local is declared BY USE and must never appear in a contract, so
  ;; treating it as an orphan would make every real page permanently invalid.
  (let [m (register-view (register-contract (empty-machine) c-ok) v-orphan)]
    (is (= 0 (count (orphan-bindings m ["g" "ghost"]))))))

(def v-fires-nothing
  (parse-view :firer
    (list (quote (markup (template &b [] "<button class='b'></button>")))
          (quote (style [".b" {:color "red"}]))
          (quote (binds [".b" (st/on :click (fire :nosuch @count))])))))

(deftest firing-an-event-no-contract-handles-is-an-error
  (let [m (register-view (register-contract (empty-machine) c-ok) v-fires-nothing)
        found (unhandled-fires m)]
    (is (= 1 (count found)))
    (is (= "nosuch" (get (first found) :event)))))

(deftest a-machine-with-no-errors-is-valid
  (is (valid? (m-ok) ["r"])))

;; ── warnings: the machine is INCOMPLETE, which is allowed ───────────────────

(deftest an-assign-no-view-reads-is-a-warning-not-an-error
  ;; `label` is declared and never rendered. This must NOT block: a contract
  ;; may legitimately land before the view that consumes it, and a machine that
  ;; refuses that cannot be grown one definition at a time.
  (let [w (unrendered-assigns (m-ok))]
    (is (= 1 (count w)))
    (is (= "label" (get (first w) :assign)))
    (is (valid? (m-ok) ["r"]))))

(deftest a-template-never-invoked-is-a-warning
  (let [v (parse-view :dead
            (list (quote (markup (template &used [] "<i class='u'></i>")
                                 (template &never [] "<i class='n'></i>")))
                  (quote (style [".u" {:color "red"}]))
                  (quote (binds [".u" (st/each @count :as @g :template &used)]))))
        m (register-view (register-contract (empty-machine) c-ok) v)
        d (dead-templates m)]
    (is (= 1 (count d)))
    (is (= "never" (get (first d) :template)))
    ;; still valid — dead markup is not a broken seam
    (is (valid? m ["g"]))))

;; ── the roll-up ─────────────────────────────────────────────────────────────

(deftest report-names-both-halves-and-both-severities
  (let [r (report (m-ok) ["r"])]
    (is (= ["t-live"] (get r :contracts)))
    (is (= ["t-view"] (get r :views)))
    (is (= ["count" "label"] (get r :assigns)))
    (is (= [] (get r :errors)))
    ;; label is unrendered: the report must SAY so rather than be silently empty
    (is (= 1 (count (get r :warnings))))))

(deftest errors-and-warnings-do-not-overlap
  (let [m (register-view (register-contract (empty-machine) c-ok) v-orphan)
        e (errors m ["g"])
        w (warnings m)]
    (is (> (count e) 0))
    ;; an error must never also be reported as a warning, or a fix looks
    ;; incomplete after it lands
    (is (= 0 (count (filterv (fn [x] (some (fn [y] (= x y)) w)) e))))))
