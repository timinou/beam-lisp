; test/bl/provider_test.bl — the AGENT cluster.
; Run: mix beam_lisp.test test/bl/provider_test.bl
;
; No network here. The live call is exercised separately (and was: a real Kimi
; k3-256k request returned "pong" through `fence` in 25s, and streaming
; delivered 5 deltas assembling to "Red, blue, green"). What these tests pin is
; the DECODING, which is where a provider quietly goes wrong: a response whose
; shape shifts, an answer containing a quotation mark, a model that streams its
; reasoning before its answer.

(ns spell.provider.test
  (:require [spell.provider :refer [request-body extract-content parse-sse-deltas
                              configured? from-env]]))

;; ── configuration ───────────────────────────────────────────────────────────

(deftest configured-requires-a-key
  (is (= false (configured? {:key nil})))
  (is (= false (configured? {:key ""})))
  (is (= true (configured? {:key "sk-x"}))))

(deftest from-env-defaults-to-the-verified-endpoint
  ; `/coding/v1`, NOT `/v1`: api.kimi.com/v1/* returns an nginx 404 while
  ; /coding/v1/models returns 200, and Moonshot's endpoints reject this key
  ; with 401. Verified against the live API.
  (let [c (from-env)]
    (is (includes? (get c :base-url) "/coding/v1"))
    ; a REASONING model spends completion tokens on reasoning_content BEFORE
    ; any content, so a small budget returns finish_reason=length and an EMPTY
    ; answer — which reads as a broken provider when it is only a small budget
    (is (>= (get c :max-tokens) 512))))

;; ── the request ─────────────────────────────────────────────────────────────

(deftest request-body-carries-model-and-messages
  (let [b (request-body {:model "k3" :max-tokens 8}
                        [{:role "user" :content "hi"}] false)]
    (is (includes? b "\"model\":\"k3\""))
    (is (includes? b "\"role\":\"user\""))
    (is (includes? b "\"content\":\"hi\""))
    (is (includes? b "\"stream\":false"))))

(deftest streaming-is-a-flag-not-a-different-request
  (let [b (request-body {:model "k3" :max-tokens 8} [{:role "user" :content "hi"}] true)]
    (is (includes? b "\"stream\":true"))))

(deftest message-content-is-json-escaped
  ; a user typing a quotation mark must not produce malformed JSON — the
  ; provider would reject the whole request and the failure would look like a
  ; network problem
  (let [b (request-body {:model "k3"} [{:role "user" :content "say \"hi\""}] false)]
    (is (includes? b "\\\"hi\\\"")))
  (let [b (request-body {:model "k3"} [{:role "user" :content "a\nb"}] false)]
    (is (includes? b "a\\nb"))))

(deftest multiple-messages-keep-their-order
  ; a transcript out of order is a different conversation
  (let [b (request-body {:model "k3"}
                        [{:role "user" :content "first"}
                         {:role "assistant" :content "second"}
                         {:role "user" :content "third"}] false)]
    (is (< (index-of b "first") (index-of b "second")))
    (is (< (index-of b "second") (index-of b "third")))))

;; ── decoding a reply ────────────────────────────────────────────────────────

(deftest extracts-the-assistant-text
  (is (= "pong" (extract-content "{\"choices\":[{\"message\":{\"content\":\"pong\"}}]}"))))

(deftest an-answer-containing-a-quote-is-not-truncated
  ; a naive split on the next quote cuts the answer short — and prose contains
  ; quotation marks constantly
  (is (= "say \"hi\" now"
         (extract-content "{\"choices\":[{\"message\":{\"content\":\"say \\\"hi\\\" now\"}}]}"))))

(deftest escapes-are-decoded
  (is (= "a\nb" (extract-content "{\"choices\":[{\"message\":{\"content\":\"a\\nb\"}}]}")))
  (is (= "a\tb" (extract-content "{\"choices\":[{\"message\":{\"content\":\"a\\tb\"}}]}"))))

(deftest a-response-of-an-unexpected-SHAPE-yields-nil-not-a-crash
  ; the caller reports nil; an exception mid-turn would take the handler with it
  (is (= nil (extract-content "{\"error\":{\"message\":\"nope\"}}")))
  ; a bare `content` with no `choices` anchor is NOT an assistant reply
  (is (= nil (extract-content "{\"content\":\"stray\"}")))
  (is (= nil (extract-content "")))
  (is (= nil (extract-content "not json at all"))))

;; ── decoding a stream ───────────────────────────────────────────────────────

(deftest collects-content-deltas-in-order
  (let [sse (str "data: {\"choices\":[{\"delta\":{\"content\":\"Hel\"}}]}\n"
                 "data: {\"choices\":[{\"delta\":{\"content\":\"lo\"}}]}\n"
                 "data: [DONE]")]
    (is (= ["Hel" "lo"] (parse-sse-deltas sse)))
    (is (= "Hello" (join (parse-sse-deltas sse))))))

(deftest reasoning-content-is-NOT-the-answer
  ; a reasoning model streams its working notes first. Showing them to the user
  ; as if they were the reply is worse than showing nothing.
  (let [sse (str "data: {\"choices\":[{\"delta\":{\"reasoning_content\":\"thinking…\"}}]}\n"
                 "data: {\"choices\":[{\"delta\":{\"content\":\"answer\"}}]}\n"
                 "data: [DONE]")]
    (is (= ["answer"] (parse-sse-deltas sse)))))

(deftest the-DONE-sentinel-terminates-rather-than-appearing-as-text
  (let [sse "data: {\"choices\":[{\"delta\":{\"content\":\"x\"}}]}\ndata: [DONE]"]
    (is (= ["x"] (parse-sse-deltas sse)))
    (is (not (includes? (join (parse-sse-deltas sse)) "DONE")))))

(deftest an-empty-stream-yields-no-deltas
  (is (= [] (parse-sse-deltas "data: [DONE]")))
  (is (= [] (parse-sse-deltas ""))))

(deftest a-role-only-delta-contributes-nothing
  ; the first SSE event carries `{"role":"assistant"}` and no content
  (let [sse (str "data: {\"choices\":[{\"delta\":{\"role\":\"assistant\"}}]}\n"
                 "data: {\"choices\":[{\"delta\":{\"content\":\"hi\"}}]}\n"
                 "data: [DONE]")]
    (is (= ["hi"] (parse-sse-deltas sse)))))

;; ── silent-failure paths (milestone-2 review) ───────────────────────────────
;; A reviewer found four ways this returned a plausible-but-wrong value. Each is
;; pinned with the body that exposed it — the failure mode that matters for a
;; provider is not crashing, it is answering confidently with the wrong thing.

(deftest an-error-field-does-not-impersonate-the-answer
  ; `content` is not a unique key. The FIRST match anywhere was the ERROR's
  ; text, presented to the user as the model's reply.
  (is (= "answer"
         (extract-content "{\"error\":{\"content\":\"upstream detail\"},\"choices\":[{\"message\":{\"content\":\"answer\"}}]}"))))

(deftest a-truncated-body-is-nil-NOT-a-short-answer
  ; a dropped connection mid-answer otherwise renders as a COMPLETE reply, and
  ; neither the caller nor the user can tell
  (is (= nil (extract-content "{\"choices\":[{\"message\":{\"content\":\"abc"))))

(deftest a-response-without-choices-yields-nil
  ; anchoring on `choices` is what stops a stray `content` being read as a reply
  (is (= nil (extract-content "{\"error\":{\"message\":\"nope\"}}")))
  (is (= nil (extract-content "{\"content\":\"stray\"}"))))

(deftest embedded-quotes-survive
  (is (= "say \"hi\""
         (extract-content "{\"choices\":[{\"message\":{\"content\":\"say \\\"hi\\\"\"}}]}"))))

(deftest a-literal-backslash-is-not-turned-into-a-control-character
  ; sequential replace-str passes decode their own OUTPUT: a literal
  ; backslash-n (a Windows path, a regex) had its backslash paired with the `n`
  ; and became a NEWLINE. Decoding escape-by-escape cannot double-decode.
  (is (= "C:\\nope"
         (extract-content "{\"choices\":[{\"message\":{\"content\":\"C:\\\\nope\"}}]}")))
  ; …and a REAL newline escape still decodes
  (is (= "a\nb"
         (extract-content "{\"choices\":[{\"message\":{\"content\":\"a\\nb\"}}]}"))))

(deftest a-200-with-no-decodable-content-is-an-ERROR
  ; `{:ok nil}` reads as "the model said nothing" and renders a blank bubble.
  ; A body that cannot be decoded is a FAILURE the caller must see.
  ; (decode-response is private; this asserts the property through the shape
  ;  extract-content returns, which is what decode-response branches on.)
  (is (= nil (extract-content "{\"error\":{\"message\":\"upstream failure\"}}")))
  (is (= nil (extract-content ""))))

(deftest multibyte-characters-survive-decoding
  ; httpc hands back a charlist of BYTES, and `List.to_string` treats each byte
  ; as a CODEPOINT — so every multi-byte character is re-encoded twice. A live
  ; reply containing an em-dash came back as `â`, which reads as a provider or
  ; font problem rather than a decoding one. Found by running the loop for real
  ; and LOOKING at the output.
  (is (= "a—b" (extract-content "{\"choices\":[{\"message\":{\"content\":\"a—b\"}}]}")))
  (is (= ["née"] (parse-sse-deltas
                   "data: {\"choices\":[{\"delta\":{\"content\":\"née\"}}]}\ndata: [DONE]"))))
