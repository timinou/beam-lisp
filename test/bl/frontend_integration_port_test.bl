; frontend_integration_port_test.bl — three ExUnit suites, ported whole:
;
;   * test/beam_lisp/compiler_test.exs — the compiler's front door: literals,
;     collections, def/var lookup, arithmetic through seeded core vars, fn
;     values and closures, defn (and multi-arity), recursion through the var,
;     let, if, do, quote, keyword-as-fn, Elixir/Erlang interop, remote fns as
;     first-class values, the undefined-var error class, and apply.
;   * test/beam_lisp/babashka_showcase_test.exs — the Babashka showcase scripts
;     under examples/babashka/ RUN as real scripts and print the RIGHT report
;     (wordfreq, edn_report, loc), the reseeded variadic `conj` regression, and
;     the runnable guidebook docs/babashka-on-the-beam.bl.md end to end.
;   * test/beam_lisp/clojure_compat_docs_test.exs — the literate Clojure-compat
;     walkthroughs (docs/*.bl.md) plus examples/clojure-compat/decimal.bl
;     execute EVERY code cell and print the answers the JVM printed for the
;     same computations — docs cannot rot, and the claims in them stay claims.
;
; Mapping (ExUnit test → this file's deftest), one line per case:
;
;   compiler_test.exs (20 tests / 45 assertions → 20 deftests / 45 `is`)
;     "literals evaluate to themselves"            → c-literals-evaluate-to-themselves
;     "collections"                                → c-collections
;     "def and var lookup"                         → c-def-and-var-lookup
;     "arithmetic through seeded core vars"        → c-arithmetic-through-seeded-core-vars
;     "fn values are real Elixir fns"              → c-fn-values-are-real-elixir-fns
;     "fn closes over locals"                      → c-fn-closes-over-locals
;     "defn defines and calls"                     → c-defn-defines-and-calls
;     "defn with docstring"                        → c-defn-with-docstring
;     "multi-arity defn dispatches on argument count" → c-multi-arity-defn-dispatches-on-argument-count
;     "recursion through the var"                  → c-recursion-through-the-var
;     "let binds sequentially"                     → c-let-binds-sequentially
;     "if treats nil and false as falsey, …"       → c-if-treats-nil-and-false-as-falsey-everything-else-truthy
;     "do returns the last form"                   → c-do-returns-the-last-form
;     "quote yields data"                          → c-quote-yields-data
;     "keywords are functions of maps"             → c-keywords-are-functions-of-maps
;     "elixir interop: uppercase prefix is an Elixir module" → c-elixir-interop-uppercase-prefix-is-an-elixir-module
;     "erlang interop: lowercase prefix is an Erlang module" → c-erlang-interop-lowercase-prefix-is-an-erlang-module
;     "remote functions are first-class values"    → c-remote-functions-are-first-class-values
;     "undefined vars raise"                       → c-undefined-vars-raise
;     "functions pass through apply"               → c-functions-pass-through-apply
;
;   babashka_showcase_test.exs (7 tests / 22 assertions → 7 deftests / 22 `is`)
;     wordfreq "reports the top words of a file, ranked by frequency" → b-wordfreq-reports-the-top-words-ranked-by-frequency
;     wordfreq "self-demos on no args (bundled sample)"               → b-wordfreq-self-demos-on-no-args
;     edn_report "summarizes an EDN file of people"                   → b-edn-report-summarizes-an-edn-file-of-people
;     edn_report "self-demos on no args (bundled sample of 4 people)" → b-edn-report-self-demos-on-no-args
;     loc "counts lines of code under a directory, grouped by extension" → b-loc-counts-lines-of-code-under-a-directory
;     "set union retains variadic conj when the core root is reseeded"   → b-set-union-retains-variadic-conj
;     "docs/babashka-on-the-beam.bl.md executes every code cell"         → b-guidebook-executes-every-code-cell
;
;   clojure_compat_docs_test.exs (9 tests / 55 assertions → 9 deftests / 55 `is`)
;     "docs/exact-decimals.bl.md executes every code cell"                  → d-exact-decimals
;     "docs/running-clojure-libraries.bl.md loads acme/money.cljc unmodified and agrees with the JVM" → d-running-clojure-libraries
;     "examples/clojure-compat/decimal.bl runs and splits a bill exactly"   → d-decimal-example
;     "docs/datahike-on-datom.bl.md drives the datahike.api shim over datom end to end" → d-datahike-on-datom
;     "docs/datom-find-specs.bl.md shows every find spec and the :with fix" → d-datom-find-specs
;     "docs/datom-excision.bl.md erases from every index and from history"  → d-datom-excision
;     "docs/datom-branches.bl.md isolates copy-on-write branches over one template" → d-datom-branches
;     "docs/datom-bitemporal.bl.md shows valid time as the second axis"     → d-datom-bitemporal
;     "docs/datom-for-accounting.bl.md exercises decimals, tuple keys and guards" → d-datom-for-accounting
;
;   total: 36 tests / 122 assertions → 36 deftests / 122 `is`
;
; Adaptations, and why:
;   · `use ExUnit.Case, async: false` has no ward equivalent: `bl test` runs each
;     FILE in its own isolated fork and the file's tests run in order in that one
;     env. The ExUnit `setup`/`setup_all` (`BeamLisp.init()` / `BeamLisp.AOT.boot()`)
;     is satisfied by the runner, which calls `BeamLisp.init/0` before loading
;     the file; `BeamLisp/run_file` and `BeamLisp/eval` re-assert it (idempotent).
;   · `ExUnit.CaptureIO.capture_io` → `capture-out`, the StringIO group-leader
;     helper the other `.bl` suites use (legacy_wave678, legacy_wave1214).
;   · `BeamLisp.with_argv(list, fn -> BeamLisp.run_file(p) end)` →
;     `(BeamLisp/with_argv args (fn [] (BeamLisp/run_file p)))`.
;   · `assert_raise RuntimeError, ~r/undefined var/` keeps BOTH halves: a typed
;     `catch RuntimeError` plus `re-find` of the same pattern on `ex-message`.
;   · `is_function(f, 1)` → `(erlang/is_function f 1)`; `f.(x)` → `(f x)`.
;   · `out =~ ~r/…/` → `(some? (re-find (re-pattern "…") out))`; `out =~ "…"`
;     → `(includes? out "…")`. Source strings are carried VERBATIM so a
;     compiler/runtime regression fails here exactly as it failed there.
;   · Elixir `[1 2 3]` result lists become BL list literals `'(1 2 3)` where the
;     answer is a sequence (Set/to_list, sort, lists/seq); BL vector literals
;     `[1 2 3]` where the answer is a beam-lisp Vector.
;
; Run: bin/bl test test/bl/frontend_integration_port_test.bl

(ns frontend.integration.port.test)

; ── helpers ────────────────────────────────────────────────────────────────

(defn- capture-out
  "Run `f` with this process's group leader on a StringIO, returning its stdout
   as a string — the port of ExUnit's `capture_io/1`."
  [f]
  (let [prev (Process/group_leader)
        dev (erlang/element 2 (StringIO/open ""))]
    (Process/group_leader (erlang/self) dev)
    (try (f) (finally (Process/group_leader (erlang/self) prev)))
    (erlang/element 2 (StringIO/contents dev))))

(defn- ev
  "The compiler suite's `eval/1`: `BeamLisp.Compiler.eval_string/1` — the same
   live front door, in the current namespace."
  [src]
  (BeamLisp.Compiler/eval_string src))

(defn- raises-with?
  "The port of `assert_raise cls, ~r/…/, fn -> … end`: true only when `(f)`
   raises `cls-kw` whose message contains `needle`. The patterns here are plain
   substrings, so `includes?` matches exactly what `~r/…/` did."
  [cls-kw needle f]
  (try
    (do (f) false)
    (catch e (and (= cls-kw (:__struct__ e))
                  (includes? (str (ex-message e)) needle)))))

(defn- run-script
  "Run a showcase script under examples/babashka/ with `args` bound as argv,
   returning its stdout — `bl run FILE -- args`, captured."
  [script args]
  (capture-out
    (fn []
      (BeamLisp/with_argv args
        (fn [] (BeamLisp/run_file (Path/join "examples/babashka" script)))))))

(defn- run-doc
  "Capture the stdout of running a literate doc / example through `run_file`."
  [path]
  (capture-out (fn [] (BeamLisp/run_file path))))

; ══ compiler_test.exs ══════════════════════════════════════════════════════

(deftest c-literals-evaluate-to-themselves
  (is (= 42 (ev "42")))
  (is (= 2.5 (ev "2.5")))
  (is (= "hi" (ev "\"hi\"")))
  (is (= nil (ev "nil")))
  (is (= true (ev "true")))
  (is (= :kw (ev ":kw"))))

(deftest c-collections
  (is (= [1 2 3] (ev "[1 2 3]")))
  (is (= [2 4] (ev "[(+ 1 1) (+ 2 2)]")))
  (is (= {:a 1} (ev "{:a 1}"))))

(deftest c-def-and-var-lookup
  (is (= 42 (ev "(def meaning 42) meaning"))))

(deftest c-arithmetic-through-seeded-core-vars
  (is (= 3 (ev "(+ 1 2)")))
  (is (= 9 (ev "(* (+ 1 2) 3)")))
  (is (= true (ev "(< 1 2)"))))

(deftest c-fn-values-are-real-elixir-fns
  (let [f (ev "(fn [x] (* x x))")]
    (is (erlang/is_function f 1))
    (is (= 49 (f 7)))
    (is (= 11 (ev "((fn [x] (+ x 1)) 10)")))))

(deftest c-fn-closes-over-locals
  (let [add1 (ev "((fn [x] (fn [y] (+ x y))) 1)")]
    (is (= 3 (add1 2)))))

(deftest c-defn-defines-and-calls
  (is (= 42 (ev "(defn double [x] (+ x x)) (double 21)"))))

(deftest c-defn-with-docstring
  (is (= 5 (ev "(defn d \"docs\" [x] x) (d 5)"))))

(deftest c-multi-arity-defn-dispatches-on-argument-count
  (is (= 50 (ev "(defn f ([x] (* x 10)) ([x y] (+ x y))) (f 5)")))
  (is (= 7 (ev "(defn g ([x] (* x 10)) ([x y] (+ x y))) (g 3 4)"))))

(deftest c-recursion-through-the-var
  (is (= 10 (ev "(defn sum [xs] (if (empty? xs) 0 (+ (first xs) (sum (rest xs))))) (sum [1 2 3 4])"))))

(deftest c-let-binds-sequentially
  (is (= 10 (ev "(let [a 1 b (+ a 2) c (+ b 3)] (+ a (+ b c)))")))
  (is (= 2 (ev "(let [x 1] (let [x (+ x 1)] x))"))))

(deftest c-if-treats-nil-and-false-as-falsey-everything-else-truthy
  (is (= 2 (ev "(if nil 1 2)")))
  (is (= 2 (ev "(if false 1 2)")))
  (is (= 1 (ev "(if 0 1 2)")))
  (is (= 1 (ev "(if true 1)")))
  (is (= nil (ev "(if false 1)"))))

(deftest c-do-returns-the-last-form
  (is (= 3 (ev "(do 1 2 3)"))))

(deftest c-quote-yields-data
  (is (= (list (tuple :symbol "a") (tuple :symbol "b") (tuple :symbol "c"))
         (ev "(quote (a b c))")))
  (is (= (list 1 :two "three") (ev "'(1 :two \"three\")")))
  (is (= (tuple :symbol "foo") (ev "'foo"))))

(deftest c-keywords-are-functions-of-maps
  (is (= 1 (ev "(:a {:a 1 :b 2})")))
  (is (= nil (ev "(:missing {})")))
  (is (= :fallback (ev "(:missing {} :fallback)"))))

(deftest c-elixir-interop-uppercase-prefix-is-an-elixir-module
  (is (= "BEAM" (ev "(String/upcase \"beam\")")))
  (is (= 6 (ev "(Enum/sum [1 2 3])")))
  (is (= 4 (ev "(String/length \"four\")"))))

(deftest c-erlang-interop-lowercase-prefix-is-an-erlang-module
  (is (= '(3 2 1) (ev "(lists/reverse '(1 2 3))")))
  (is (= '(1 2 3) (ev "(lists/seq 1 3)"))))

(deftest c-remote-functions-are-first-class-values
  (let [handle (ev "String/upcase")]
    (is (= "BEAM" (BeamLisp.Ns.Rt/invoke handle (list "beam"))))
    (is (= "#fn[Elixir.String/upcase]" (BeamLisp.Ns.Rt/print_str handle)))))

(deftest c-undefined-vars-raise
  (is (raises-with? :Elixir.RuntimeError "undefined var"
        (fn [] (ev "(missing 1)")))))

(deftest c-functions-pass-through-apply
  (is (= 7 (ev "(apply (fn [x y] (+ x y)) [3 4])"))))

; ══ babashka_showcase_test.exs ═════════════════════════════════════════════

(deftest b-wordfreq-reports-the-top-words-ranked-by-frequency
  (let [tmp (Path/join (System/tmp_dir!) "bl_showcase_wf.txt")]
    (try
      (File/write! tmp "the cat the dog the cat bird")
      (let [out (run-script "wordfreq.bl" (list tmp "3"))]
        (is (includes? out "Top 3 words"))
        ; ranked: the(3), cat(2), then a 1.  The 3 and 2 lead.
        (let [lines (mapv String/trim (String/split out "\n"))]
          (is (= "3  the" (nth lines 1)))
          (is (= "2  cat" (nth lines 2)))))
      (finally (File/rm tmp)))))

(deftest b-wordfreq-self-demos-on-no-args
  (let [out (run-script "wordfreq.bl" (list))]
    (is (includes? out "bundled sample"))
    (is (includes? out "the"))))

(deftest b-edn-report-summarizes-an-edn-file-of-people
  (let [tmp (Path/join (System/tmp_dir!) "bl_showcase_people.edn")]
    (try
      (File/write! tmp
        (str "[{:name \"Ada\" :age 30 :roles [:admin :dev]}\n"
             " {:name \"Bob\" :age 50 :roles [:dev]}]\n"))
      (let [out (run-script "edn_report.bl" (list tmp))]
        (is (includes? out "People:  2"))
        (is (includes? out "Roles:   admin, dev"))
        (is (includes? out "Avg age: 40"))
        (is (includes? out "admin: Ada"))
        (is (includes? out "dev: Ada, Bob")))
      (finally (File/rm tmp)))))

(deftest b-edn-report-self-demos-on-no-args
  (let [out (run-script "edn_report.bl" (list))]
    (is (includes? out "bundled sample"))
    (is (includes? out "People:  4"))))

(deftest b-loc-counts-lines-of-code-under-a-directory
  (let [out (run-script "loc.bl" (list "priv/compat" "**/*.bl"))]
    (is (includes? out "LOC under priv/compat"))
    (is (includes? out "bl"))
    (is (includes? out "TOTAL"))
    ; the compat layer is many files and hundreds of lines
    (is (some? (re-find (re-pattern "bl\\s+\\d+\\s+\\d+") out)))))

(deftest b-set-union-retains-variadic-conj
  (BeamLisp.Loader/ensure_loaded "clojure.set")
  (let [original (BeamLisp.Env/fetch! "core" "conj")]
    (try
      (BeamLisp.Env/intern "core" "conj"
        (BeamLisp.Ns.Rt/multi_fn
          {1 (fn [a] (BeamLisp.Ns.Rt/conj a))
           2 (fn [a b] (BeamLisp.Ns.Rt/conj a b))}))
      (let [value (BeamLisp/eval "(clojure.set/union #{1} #{2} #{3})")]
        (is (= '(1 2 3) (sort (BeamLisp.Set/to_list value)))))
      (finally (BeamLisp.Env/intern "core" "conj" original)))))

(deftest b-guidebook-executes-every-code-cell
  ; A literate `.bl.md` doc: run_file reads its beam-lisp code cells and
  ; evaluates them. This pins that the whole guidebook runs end to end and that
  ; its key computations are right — so the doc cannot rot.
  (let [out (run-doc "docs/babashka-on-the-beam.bl.md")]
    ; a spread of sections, and the final marker proving it reached the end
    (is (includes? out "hell0 w0rld"))
    (is (includes? out "safety — (inc 1) stays DATA: (inc 1)"))
    (is (includes? out "south: 550"))
    (is (includes? out "north: 250"))
    (is (includes? out "everything above executed"))))

; ══ clojure_compat_docs_test.exs ═══════════════════════════════════════════

(deftest d-exact-decimals
  (let [out (run-doc "docs/exact-decimals.bl.md")]
    (is (includes? out "decimal: 0.3M"))
    (is (includes? out "=   false   ==  true"))
    (is (includes? out "2.34M 2.36M"))
    (is (includes? out ":decimal/non-terminating"))
    (is (includes? out "[33.34M 33.33M 33.33M] → sum 100.00M"))
    (is (includes? out "[0.15M 0.15M 0.14M 0.14M 0.14M 0.14M 0.14M] → sum 1.00M"))))

(deftest d-running-clojure-libraries
  (BeamLisp.Env/add_search_path "examples/clojure-compat/ledger/src")
  (let [out (run-doc "docs/running-clojure-libraries.bl.md")]
    ; answers captured from `clojure -M` over the same expressions
    (is (includes? out "15.10 EUR"))
    (is (includes? out "2.34 EUR"))
    (is (includes? out "[\"33.34 EUR\" \"33.33 EUR\" \"33.33 EUR\"]"))
    (is (includes? out "[\"0.04 USD\" \"0.01 USD\"]"))
    (is (includes? out "currency mismatch"))
    (is (includes? out "not exact"))
    (is (includes? out "no Java method .frobnicate in the interop manifest"))))

(deftest d-decimal-example
  (let [out (run-doc "examples/clojure-compat/decimal.bl")]
    (is (includes? out "[33.34M 33.33M 33.33M] sum 100.00M"))
    (is (includes? out ":decimal/inexact-operand"))))

(deftest d-datahike-on-datom
  (let [out (run-doc "docs/datahike-on-datom.bl.md")]
    (is (includes? out "tx-data datoms: 10"))
    (is (includes? out "in credit: ([\"Bank\" 250] [\"Cash\" 100])"))
    (is (some? (re-find (re-pattern "pull cash: \\{.*:account/name \"Cash\".*\\}") out)))
    (is (some? (re-find (re-pattern "pull cash: \\{.*:account/balance 100.*\\}") out)))
    (is (includes? out "bank name: Bank balance: 250"))
    (is (includes? out "accounts now: 3"))
    (is (includes? out "accounts if applied: 4"))))

(deftest d-datom-find-specs
  (let [out (run-doc "docs/datom-find-specs.bl.md")]
    (is (includes? out "relation:  ([\"Ada\" 100] [\"Grace\" 100] [\"Lin\" 90])"))
    (is (includes? out "scalar:    90"))
    (is (includes? out "collection: (\"Ada\" \"Grace\" \"Lin\")"))
    (is (includes? out "tuple:     [\"Ada\" 100]"))
    (is (includes? out "sum of distinct pay values:  190"))
    (is (includes? out "sum of pay per person:       290"))
    (is (includes? out "pay by dept:  ([\"eng\" 200] [\"sales\" 90])"))
    (is (includes? out "count by dept: ([\"eng\" 2] [\"sales\" 1])"))))

(deftest d-datom-excision
  (let [out (run-doc "docs/datom-excision.bl.md")]
    (is (includes? out "temp — history: #{[\"Temp\"]}"))
    (is (includes? out "ssn after erasure:  nil"))
    (is (includes? out "name still there:   Alice"))
    (is (includes? out "ssn in history:     #{}"))
    (is (includes? out "datoms excised: 2"))
    (is (includes? out "alice — current: nil"))
    (is (includes? out "alice — history: #{}"))))

(deftest d-datom-branches
  (let [out (run-doc "docs/datom-branches.bl.md")]
    (is (includes? out "template: ([\"cash\" 1000] [\"loan\" -500])"))
    (is (includes? out "payoff branch:   ([\"cash\" 500] [\"loan\" 0])"))
    (is (includes? out "withdraw branch: ([\"cash\" 700] [\"loan\" -500])"))
    (is (includes? out "template still:  ([\"cash\" 1000] [\"loan\" -500])"))))

(deftest d-datom-bitemporal
  (let [out (run-doc "docs/datom-bitemporal.bl.md")]
    (is (includes? out "price on day 90:   100"))
    (is (includes? out "price on day 200:  120"))
    (is (includes? out "price on day 180:  120"))
    (is (includes? out "price on day 90, still: 100"))
    (is (includes? out "pulled @day 90:  100"))
    (is (includes? out "prices true across days 90..200: ([100] [120])"))))

(deftest d-datom-for-accounting
  (let [out (run-doc "docs/datom-for-accounting.bl.md")]
    (is (includes? out "ascending: (\"9.99\" \"100.05\" \"100.50\")"))
    (is (includes? out "1.0M == 1.00M by value: true"))
    (is (includes? out "derived key: [100 1]"))
    (is (includes? out "duplicate (100,1) refused: refused"))
    (is (includes? out "distinct postings: 2"))
    (is (includes? out "balanced entry committed: 2"))
    (is (includes? out "unbalanced entry: refused"))
    (is (includes? out "batch 2 datoms after refusal: 0"))))
