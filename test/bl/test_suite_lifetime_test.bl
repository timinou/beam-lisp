(ns test-suite-lifetime-test)

(defn- environments []
 (set (Agent/get :Elixir.BeamLisp.Env (fn [state] (maps/keys (:envs state))))))

(defn- suite-result [path options]
 ;; Keep the nested runner's assertion context in its own process while the
 ;; environments it allocates remain observable in the actual Env owner.
 (Task/await (Task/async (fn []
   (try (BeamLisp.TestRT/run_suite (list path) options)
        (catch _ :refused)))) 30000))

(deftest repeated-suites-release-their-base-environment-on-success-and-error
 (let [root (Path/join (System/tmp_dir!) (str "bl-suite-lifetime-" (erlang/unique_integer (list :positive))))
       fixture (Path/join root "pass.bl") missing (Path/join root "missing.bl")]
  (try
   (File/mkdir_p! root)
   (File/write! fixture "(ns suite-lifetime.fixture) (deftest value (is (= 1 1)))")
   (doseq [options [(list) (list (tuple :async true))]]
    (let [before (environments)]
     (doseq [_ (range 3)]
      (let [result (suite-result fixture options)]
       (is (= {:tests 1 :pass 1 :fail 0 :error 0} result)))
      (is (= before (environments))))
     (is (= :refused (suite-result missing options)))
     (is (= before (environments)))))
   (finally (File/rm_rf! root)))))
