; test/bl/seed_absence_2_test.bl — test.seed-absence-2.
;
; Split from test/bl/seed_test.bl so each file stays under the runner's 300 s
; per-file bound. Shared helpers live in test.bl.seed-support.

(ns test.seed-absence-2
  (:require [seed] [test.bl.seed-support :as s]))

(deftest absence-blocks-a-current-floor-2
  (let [root (BeamLisp/cwd)
        ebin (Path/join root "build")
        out (s/scratch "absence-2-out")
        hd (s/host-scratch "absence-2-src" "")
        hosts (seed/host-sources hd)
        chunk (take 23 (drop 24 hosts))
        r (s/seed-run! {:root root :out out :ebin ebin :host hd})]
    (when-not (:ok? r)
      (throw (str "the floor is generated: " (pr-str (:errors r)))))
    ; ABSENCE also blocks: there is no action-only host source. This file
    ; carries hosts 24..46 of 70, split across three files so 70
    ; `seed/check` calls stay inside the runner's 300 s per-file bound.
    (doseq [e chunk]
      (File/rm! (Path/join out (seed/host-beam e)))
      (let [c (s/seed-check! {:root root :out out :host hd})]
        (is (not (:ok? c))
            (str "a floor missing " (seed/host-beam e) " is not current"))))
    (File/rm_rf! out)
    (File/rm_rf! hd)))
