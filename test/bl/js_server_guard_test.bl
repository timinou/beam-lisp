(ns js.server-guard-test (:require [js.actor :as actor]))
(deftest emitted-javascript-enforces-callback-guards
 (let [root (str (System/tmp_dir!) "/server-guards-" (System/pid) "-" (System/unique_integer (list :positive)))]
  (try
   (File/mkdir_p! root)
   (actor/build-one root "server-guards.bl" "guards.mjs" []
     {:source-root (Path/expand "test/js/fixtures") :prune true})
   (actor/link-runtime! root "./canonical/actor")
   (let [r (System/cmd "node" (list (str root "/out/guards.mjs")))]
    (is (= 0 (elem r 1)) (elem r 0))
    (is (includes? (elem r 0) "native/JS callback guard contract PASS")))
   (finally (File/rm_rf! root)))))
