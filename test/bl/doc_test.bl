; doc_test.bl — the livebook core: slicing, the round-trip covenant,
; id minting, the writer's owned spans, and the runner. Every fixture is
; inline, both dialects are exercised, and the assertions are exact.

(ns bl.doc.test
  (:require [bl.doc :as doc]))

(def md-doc
  "# Payroll

Prose stays.

```beam-lisp id=gross
(defn gross [rate hours]
  (* rate hours))
```

And now:

```beam-lisp
(gross 50 160)
```

```bl-result gross
OLD
```
")

(def org-doc
  "* Payroll
Some prose.

#+begin_src beam-lisp :id gross
(defn gross [rate hours]
  (* rate hours))
#+end_src

And now:

#+begin_src beam-lisp
(gross 50 160)
#+end_src

#+RESULTS: gross
: OLD
")

(deftest md-round-trip-is-identity
  (let [d (:ok (doc/slice-text md-doc :md))]
    (is (= "gross" (get-in (first (doc/cells d)) [:id])))
    (is (= "cell1" (get-in (second (doc/cells d)) [:id])))
    (is (= md-doc (doc/render-doc d)))))

(deftest org-round-trip-is-identity
  (let [d (:ok (doc/slice-text org-doc :org))]
    (is (= "gross" (get-in (first (doc/cells d)) [:id])))
    (is (= org-doc (doc/render-doc d)))))

(deftest format-detection
  (is (= :org (doc/format-of "docs/x.bl.org")))
  (is (= :md (doc/format-of "docs/x.bl.md")))
  (is (= :md (doc/format-of "docs/x.bl"))))

(deftest prose-is-sacrosanct
  (let [d (:ok (doc/slice-text md-doc :md))
            written (doc/write-results d {"gross" "8000" "cell1" "8000"})]
    (is (includes? written "Prose stays."))
    (is (includes? written "And now:"))
    (is (includes? written "```bl-result gross\n8000\n```"))
    (is (not (includes? written "OLD")))))

(deftest org-results-rewrite-in-place
  (let [d (:ok (doc/slice-text org-doc :org))
            written (doc/write-results d {"gross" "8000"})]
    (is (includes? written "#+RESULTS: gross\n: 8000"))
    (is (not (includes? written "OLD")))
    ;; the second cell has no span yet: none inserted when not requested
    (is (= 1 (count (filter (fn [l] (starts-with? l "#+RESULTS"))
                            (split written "\n")))))))

(deftest missing-span-inserts-after-cell
  (let [mini "# T\n\n```beam-lisp id=x\n(+ 1 2)\n```\n\ntail\n"
        d (:ok (doc/slice-text mini :md))
        written (doc/write-results d {"x" "3"})]
    (is (includes? written "```bl-result x\n3\n```"))
    ;; insertion sits between the cell's close and the prose tail
    (is (includes? written "```\n\n```bl-result x"))
    ;; idempotent: writing the same result again changes nothing
    (is (= written (doc/write-results (:ok (doc/slice-text written :md))
                                      {"x" "3"})))))

(deftest cell-source-strips-fences
  (let [d (:ok (doc/slice-text md-doc :md))
        c (first (doc/cells d))]
    (is (= "(defn gross [rate hours]\n  (* rate hours))" (doc/cell-source c)))))

(deftest cells-source-concatenates-in-order
  (let [d (:ok (doc/slice-text md-doc :md))]
    (is (= "(defn gross [rate hours]\n  (* rate hours))\n(gross 50 160)"
           (doc/cells-source d)))))

(deftest declared-ns-found
  (let [d (:ok (doc/slice-text
                 "```beam-lisp\n(ns my.book)\n(defn f [] 1)\n```\n" :md))]
    (is (= "my.book" (:ns d)))))

(deftest unterminated-fence-is-an-error
  (let [r (doc/slice-text "```beam-lisp\n(+ 1 2)\n" :md)]
    (is (contains? r :error))
    (is (= 1 (get-in r [:error :line])))))

(deftest frozen-cells-are-skipped-by-the-runner
  (let [d (:ok (doc/slice-text
                 "```beam-lisp id=a\n(+ 1 2)\n```\n\n```beam-lisp id=b frozen\n(+ 40 2)\n```\n\n```bl-result b\n:stored\n```\n"
                 :md))
        r (doc/run-doc d)]
    (is (= {"a" "3"} (:results r)))
    (is (empty? (:errors r)))))

(deftest silent-cells-run-but-show-nothing
  (let [d (:ok (doc/slice-text
                 "```beam-lisp id=a silent\n(defn seen [] :yes)\n```\n" :md))
        r (doc/run-doc d)]
    (is (= {} (:results r)))
    (is (= 1 (count (:details r))))))

(deftest cell-errors-become-results-not-crashes
  (let [d (:ok (doc/slice-text
                 "```beam-lisp id=boom\n(undefined-thing 1)\n```\n" :md))
        r (doc/run-doc d)]
    (is (= ["boom"] (:errors r)))
    (is (includes? (get-in r [:results "boom"]) ";; error:"))))

(deftest loader-contract-matches-the-slicer
  (let [md-src "# P\n\n```beam-lisp id=a\n(defn a [] 1)\n```\n\n```beam-lisp\n(a)\n```\n"
        org-src "#+begin_src beam-lisp\n(ns o)\n(defn b [] 2)\n#+end_src\n"]
    (is (= (BeamLisp.Loader/doc_source md-src :md) (doc/doc-source md-src :md)))
    (is (= (BeamLisp.Loader/doc_source org-src :org) (doc/doc-source org-src :org)))))
