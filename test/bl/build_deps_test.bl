; test/bl/build_deps_test.bl — W7's library store, and the hex client that fills
; it.
;
; Ported from the ExUnit `test/beam_lisp/build_deps_test.exs`; the assertions are
; the same ones, asked of the same real tarballs. (The server-side half — the API
; contract and its derived mock — stays in `test/bl/deps_test.bl`, which is where
; this suite's ExUnit original pointed.)
;
; The store's half is proved with real tarballs: VERSION, CHECKSUM,
; metadata.config, contents.tar.gz — the four entries hex actually ships, where
; the outer archive is a PLAIN tar and the inner is gzipped, and CHECKSUM is
; stated in UPPERCASE. All three of those were measured against jason-1.4.4 from
; hex.pm rather than assumed, and each one is a bug if assumed the other way.
;
; Three refusals matter, and each asserts the store is UNCHANGED afterwards — an
; artifact that fails a check must never become visible under its content
; address:
;
;   * a tarball whose digest is not the one the lock names,
;   * a tarball whose CHECKSUM lies about its contents (the outer digest matches,
;     so only the inner check can catch it),
;   * a lock naming a library the store does not hold.
;
; ── Case mapping (ExUnit → BL) ─────────────────────────────────────────────
;   "a locked tarball installs, and the store holds what it claims"
;        → a-locked-tarball-installs-and-the-store-holds-what-it-claims
;   "a tarball that is not what the lock names is refused, and nothing is
;    installed"
;        → a-tarball-that-is-not-what-the-lock-names-is-refused-and-nothing-is-installed
;   "a tarball whose CHECKSUM is not sha256-shaped is refused"
;        → a-tarball-whose-checksum-is-not-sha256-shaped-is-refused
;   "an API document the client cannot use is an error, not a crash"
;        → an-api-document-the-client-cannot-use-is-an-error-not-a-crash
;   "verify is offline, reports what is missing, and list reads the DISK"
;        → verify-is-offline-reports-what-is-missing-and-list-reads-the-disk
;   "a leftover temp install is swept and never mistaken for a library"
;        → a-leftover-temp-install-is-swept-and-never-mistaken-for-a-library
;   helpers contents_tar_gz!/1 hex_tarball!/3,4 transport_for/1,2
;        → contents-tar-gz!, hex-tarball!, transport-for
;   the ExUnit `setup` (a fresh store + scratch per case) → fresh-store! /
;   scratch-for
;
; Run: bl test test/bl/build_deps_test.bl

(ns test.build-deps
  (:require [deps :as dp] [store :as st] [hex]))

; Every case gets its own store and scratch — as the ExUnit `setup` gave each
; one — so no test reads another's installs and a run leaves the developer's
; real cache untouched.
(def base
  (str (System/tmp_dir!) "/bl_build_deps_" (erlang/unique_integer (list :positive))))
(File/mkdir_p! base)

(defn- fresh-store! [label]
  (let [cache (Path/join base (str label "-cache"))]
    (File/rm_rf! cache)
    (File/mkdir_p! cache)
    (System/put_env "XDG_CACHE_HOME" cache)
    cache))

(defn- scratch-for [label]
  (let [s (Path/join base (str label "-scratch"))]
    (File/rm_rf! s)
    (File/mkdir_p! s)
    s))

; ── a real hex-shaped tarball ────────────────────────────────────────────

(defn- contents-tar-gz!
  "Write `content/lib/thing.ex` into `dir`, gzip it as `contents.tar.gz`, and
   return the bytes."
  [dir]
  (let [src (Path/join dir "content")
        cgz (Path/join dir "contents.tar.gz")]
    (File/rm_rf! src)
    (File/mkdir_p! (Path/join src "lib"))
    (File/write! (Path/join src "lib/thing.ex") "defmodule Thing do\nend\n")
    ; `:erl_tar.create/3` takes names RELATIVE TO THE CWD — it has no `:cwd`
    ; option (extract does) — so the fixture chdirs, the way the tool expects.
    (File/cd! src
      (fn []
        (erlang/apply :erl_tar :create
                      (list (erlang/binary_to_list cgz)
                            (list (erlang/binary_to_list "lib")
                                  (erlang/binary_to_list "lib/thing.ex"))
                            (list :compressed)))))
    (File/read! cgz)))

(defn- hex-tarball!
  "A tar as hex serves one: VERSION, CHECKSUM, metadata.config, contents.tar.gz.
   `checksum-override` lets a case write a CHECKSUM that is not sha256-shaped."
  ([dir name vsn] (hex-tarball! dir name vsn nil))
  ([dir name vsn checksum-override]
   (let [work (Path/join dir (str "tarball-" name "-" vsn))]
     (File/rm_rf! work)
     (File/mkdir_p! work)
     (contents-tar-gz! work)
     ; 64 hex characters — the SHAPE hex writes. What hex puts in this file is its
     ; canonical INNER checksum, which this client does not recompute: measured on
     ; toml 0.7.0 it is neither sha256(outer tar) nor sha256(contents.tar.gz), and
     ; hex_core calls it deprecated in favour of the outer checksum. The fixture
     ; therefore only has to have the shape — the outer digest below is the one
     ; that pins the bytes.
     (File/write! (Path/join work "CHECKSUM")
                  (if (nil? checksum-override)
                    (String/duplicate "F" 64)
                    checksum-override))
     (File/write! (Path/join work "VERSION") "3")
     (File/write! (Path/join work "metadata.config") "{ok}.\n")

     (let [out (Path/join dir (str name "-" vsn ".tar"))]
       (File/cd! work
         (fn []
           (erlang/apply :erl_tar :create
                         (list (erlang/binary_to_list out)
                               (list (erlang/binary_to_list "VERSION")
                                     (erlang/binary_to_list "CHECKSUM")
                                     (erlang/binary_to_list "metadata.config")
                                     (erlang/binary_to_list "contents.tar.gz"))
                               (list)))))
       (let [bytes (File/read! out)]
         {:path out
          :bytes bytes
          :sha (String/downcase (Base/encode16 (crypto/hash :sha256 bytes)))})))))

(def api-json
  "{\"name\":\"jason\",\"releases\":[{\"version\":\"1.4.4\",\"checksum\":\"ABC\"}]}")

; The transport answers in the shape the CLIENT reads: a map with `:ok` or
; `:error`. An Elixir tuple would cross as a tuple, and bl's keyword lookup on a
; tuple answers nil — a transport contract is part of the interface.
(defn- transport-for
  ([tar-bytes] (transport-for tar-bytes api-json))
  ([tar-bytes api]
   (fn [url opts]
     (cond
       (String/contains? url "/api/packages/") {:ok api}
       (and (String/contains? url ".tar") (:binary? opts)) {:ok tar-bytes}
       :else {:error (str "no route for " url)}))))

; ── the store ────────────────────────────────────────────────────────────

(deftest a-locked-tarball-installs-and-the-store-holds-what-it-claims
  (let [_ (fresh-store! "install")
        scratch (scratch-for "install")
        t (hex-tarball! scratch "jason" "1.4.4")
        r (hex/install! (transport-for (:bytes t))
                        {:name "jason" :vsn "1.4.4" :sha (:sha t)} scratch)]
    (is (:ok? r) (str "install failed: " (pr-str (:why r))))
    (is (st/present? "jason" "1.4.4" (:sha t)))
    (is (File/exists? (Path/join (:dir r) "lib/thing.ex")))
    (is (= (:sha t) (String/trim (File/read! (Path/join (:dir r) ".hex-sha")))))))

(deftest a-tarball-that-is-not-what-the-lock-names-is-refused-and-nothing-is-installed
  (let [_ (fresh-store! "wrong-digest")
        scratch (scratch-for "wrong-digest")
        t (hex-tarball! scratch "jason" "1.4.4")
        wrong (String/duplicate "0" 64)
        r (hex/install! (transport-for (:bytes t))
                        {:name "jason" :vsn "1.4.4" :sha wrong} scratch)]
    (is (not (:ok? r)))
    (is (String/contains? (:why r) "digest differs from the lock"))
    (is (not (st/present? "jason" "1.4.4" wrong)))
    (is (not (st/present? "jason" "1.4.4" (:sha t))))))

; This test used to assert the opposite rule — that CHECKSUM is sha256 of
; contents.tar.gz — and so AGREED with a client that could not install a single
; real package. It is now about the rule that exists: the value must have the
; shape hex writes, because 47 of 47 real tarballs have it and a malformed one
; is a reason to stop.
(deftest a-tarball-whose-checksum-is-not-sha256-shaped-is-refused
  (let [_ (fresh-store! "bad-checksum")
        scratch (scratch-for "bad-checksum")
        t (hex-tarball! scratch "jason" "1.4.4" "not-a-digest")
        r (hex/install! (transport-for (:bytes t))
                        {:name "jason" :vsn "1.4.4" :sha (:sha t)} scratch)]
    (is (not (:ok? r)))
    (is (String/contains? (:why r) "not sha256-shaped"))
    (is (not (st/present? "jason" "1.4.4" (:sha t))))))

(deftest an-api-document-the-client-cannot-use-is-an-error-not-a-crash
  (let [r (hex/package (transport-for "" "not json at all") "jason")]
    (is (String/contains? (:error r) "package document"))))

(deftest verify-is-offline-reports-what-is-missing-and-list-reads-the-disk
  (let [_ (fresh-store! "verify")
        scratch (scratch-for "verify")
        t (hex-tarball! scratch "jason" "1.4.4")
        tr (transport-for (:bytes t))
        tree (Path/join scratch "tree")]
    (File/mkdir_p! tree)

    (dp/write-lock! tree
      [{:name "jason" :vsn "1.4.4" :sha (:sha t) :source :hex}
       {:name "decimal" :vsn "2.3.0" :sha (String/duplicate "b" 64) :source :hex}])

    (let [v (dp/verify tree)]
      (is (not (:ok? v)))
      (is (= 2 (:checked v)))
      (is (= 2 (count (:missing v)))))

    (is (:ok? (hex/install! tr {:name "jason" :vsn "1.4.4" :sha (:sha t)} scratch)))

    (let [v2 (dp/verify tree)
          missing (:missing v2)]
      (is (not (:ok? v2)))
      (is (= 1 (count missing)))
      (is (= "decimal" (:name (first missing)))))

    (let [rows (dp/installed)]
      (is (= 1 (count rows)))
      (is (= "jason" (:name (first rows)))))

    ; The lock is FACTS: one line each, readable by anything that reads lines.
    (let [text (File/read! (Path/join tree "bl.lock"))]
      (is (String/contains? text (str "[:dep jason 1.4.4 " (:sha t) " hex]")))
      (is (= 2 (count (String/split (String/trim text) "\n")))))

    ; An absent lock and an empty lock are different answers.
    (let [empty (Path/join scratch "emptytree")]
      (File/mkdir_p! empty)
      (is (String/contains? (:why (dp/verify empty)) "no lock at")))))

(deftest a-leftover-temp-install-is-swept-and-never-mistaken-for-a-library
  (let [cache (fresh-store! "sweep")
        lib (Path/join (Path/join cache "beam_lisp") "lib")
        tmp (Path/join lib "jason-1.4.4-deadbeef.tmp-999")]
    (File/mkdir_p! lib)
    (File/mkdir_p! tmp)

    (is (= 1 (st/sweep-temp!)))
    (is (not (File/exists? tmp)))
    (is (= [] (vec (st/entries))))))
