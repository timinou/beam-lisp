(ns build.relocation-test (:require [build :as build] [build-log :as log]))

(deftest relocating-a-source-preserves-newly-published-module-ownership
 (let [root (str (System/tmp_dir!) "/build-relocation-" (System/unique_integer (list :positive)))
       old (str root "/old/owned.bl") moved (str root "/new/owned.bl")
       deleted (str root "/old/deleted.bl") out (str root "/ebin")
       run (fn [sources] (build/run {:sources sources :out out :jobs 1 :force? true}))]
  (try
   (File/mkdir_p! (Path/dirname old)) (File/mkdir_p! (Path/dirname moved))
   (File/write! old "(ns relocation.owned) (def initialized :old) (defn value [] 1)")
   (File/write! deleted "(ns relocation.deleted) (defn value [] 0)")
   (let [before (run [old deleted])
         old-modules (:modules (get (:manifest before) old))
         deleted-modules (:modules (get (:manifest before) deleted))]
    (is (= [] (:errors before)))
    (is (>= (count old-modules) 2) "exercise physical shim/body/initializer files")
    (File/rename! old moved)
    (File/write! moved "(ns relocation.owned) (def initialized :new) (defn value [] 2)")
    (let [after (run [moved]) modules (:modules (get (:manifest after) moved))]
     (is (= [] (:errors after)))
     (is (= #{moved} (set (keys (:manifest after)))))
     (is (= (set old-modules) (set modules)))
     (doseq [module modules]
      (is (File/exists? (log/beam-path out module))
          "pruning the old path must not delete the new owner's emitted code"))
     (doseq [module deleted-modules]
      (is (not (File/exists? (log/beam-path out module)))
          "genuinely unowned modules are still removed"))
     (let [empty-build (run [])]
      (is (= [] (:errors empty-build)))
      (is (= {} (:manifest empty-build)))
      (doseq [module modules]
       (is (not (File/exists? (log/beam-path out module))))))))
   (finally (File/rm_rf! root)))))
