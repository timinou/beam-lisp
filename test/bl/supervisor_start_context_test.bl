(ns supervisor-start-context-test (:require [proc.instance :as instance] [env]))
(defserver scoped-child
 (init [_]
  (instance/register! :supervisor-start-context/child (erlang/self))
  (ok (env/current)))
 (handle-call :scope [_ state] (reply state state)))
(defn child [sup]
 (some (fn [row] (let [pid (elem row 1)] (when (erlang/is_pid pid) pid))) (Supervisor/which_children sup)))
(defn replacement [sup old]
 (loop [left 200]
  (let [pid (child sup)]
   (cond (and pid (not= pid old)) pid
         (zero? left) nil
         :else (do (Process/sleep 5) (recur (dec left)))))))
(defn exercise [module]
 (let [a (env/fork) b (env/fork) started (atom [])
       spec {:strategy :one-for-one :children
              (list (erlang/apply module :server (list :child scoped-child nil {:restart :permanent})))}]
  (try
   (let [sa (env/with-env a #(erlang/apply module :start_link (list spec)))
         _ (swap! started conj sa) pa (child sa)]
    (is (= a (call pa :scope)))
    (is (= pa (env/with-env a #(instance/whereis :supervisor-start-context/child))))
    (is (nil? (env/with-env b #(instance/whereis :supervisor-start-context/child))))
    (let [sb (env/with-env b #(erlang/apply module :start_link (list spec)))
          _ (swap! started conj sb) pb (child sb)]
     (is (not= pa pb))
     (is (= b (call pb :scope)))
     (is (= pb (env/with-env b #(instance/whereis :supervisor-start-context/child))))
     (Process/exit pa :kill)
     (let [next (replacement sa pa)]
      (is (erlang/is_pid next))
      (when next
       (is (= a (call next :scope)))
       (is (= next (env/with-env a #(instance/whereis :supervisor-start-context/child))))))
     (is (= b (call pb :scope)))))
   (finally (doseq [sup @started] (when (Process/alive? sup) (Supervisor/stop sup)))
    (env/destroy a) (env/destroy b)))))
(deftest source-tree-binds-starter-environment-for-initial-start-and-restart
 (let [source (Path/join (BeamLisp/cwd) "priv/host/supervisor.bl")
       output (str (System/tmp_dir!) "/supervisor-start-context-" (erlang/unique_integer (list :positive)))
       probe :Elixir.BeamLisp.SupervisorStartContextProbe
       compiled (BeamLisp.AOT/compile_host_file source
                 (list (tuple :module probe) (tuple :output_dir output) (tuple :file source)
                       (tuple :source_hash (crypto/hash :sha256 (File/read! source))) (tuple :load? false)))]
  (code/load_binary probe (erlang/binary_to_list (elem compiled 1)) (File/read! (elem compiled 1)))
  (try (exercise probe)
   (finally (code/purge probe) (code/delete probe) (File/rm_rf! output)))))
(deftest installed-tree-binds-starter-environment-for-initial-start-and-restart
 (exercise :Elixir.BeamLisp.Supervisor))
