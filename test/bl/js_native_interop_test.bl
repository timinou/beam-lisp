; Checks native-JS compilation, evidence and a generated static program.
; Run: BL_TEST_TIMEOUT=1200 bin/bl test test/bl/js_native_interop_test.bl
(ns bl.js.native-interop-test
  (:require [bl.js :as js] [js.build :as build] [compiler :as c]
            [reader :as reader] [system.js :as native] [system.ir :as ir]
            [system.footprint :as fp] [system.summary :as summary] [typed]))

(defn- compile-js [source granted]
  (native/check!
    (c/compile (first (reader/read-string source "native-test"))
               (assoc (c/new-env "native.test") :target :js :js-interop granted))))

(deftest beam-set-function-remains-an-ordinary-call
  ; tooling.pulse exports a BEAM function named set!, not a JS assignment.
  (is (map? (c/compile (first (reader/read-string "(set! :path 1)" "beam-set-test"))
                       (c/new-env "native.test")))))

(deftest compile-boundaries-and-evidence
  (is (= :array (:kind (compile-js "#js [1 2]" true))))
  (is (= :object (:kind (compile-js "#js {:x 1}" true))))
  (is (thrown? (compile-js "#js [1]" false)))
  (is (thrown? (compile-js "(.push [1] 2)" true)))
  (is (thrown? (compile-js "(let [x {:a 1}] (.keys js/Object x))" true)))
  (is (thrown? (compile-js "(js/JSON.stringify {:x 1})" true)))
  (is (thrown? (compile-js "#js {:x 1 \"x\" 2}" true)))
  (is (thrown? (compile-js "(set! x 1)" true)))
  (is (thrown? (compile-js "(js/Math.sin 0.5M)" true)))
  (is (thrown? (compile-js "(js/JSON.stringify (quote {:x 1}))" true)))
  (is (thrown? (compile-js "(aget #js [] 0 1)" true)))
  (is (= :method (:kind (compile-js "(.push unknown 2)" true))))
  (is (thrown? (c/compile (first (reader/read-string "#js []" "native-test"))
                           (assoc (c/new-env "native.test") :js-interop true))))
  (let [node (compile-js "(js/Math.max 1 2)" true)]
    (is (= 2 (count (ir/child-nodes node))))
    (is (= {fp/opaque-world :W} (fp/fp-anf node)))
    (is (= false (:terminates (summary/summarize {} node)))))
  (let [node (c/compile (first (reader/read-string "(js/JSON.stringify {:x 1})" "native-test"))
                         (assoc (c/new-env "native.test") :target :js :js-interop true))]
    (is (= 1 (count (:warnings (typed/check-js-ir node)))))))

(deftest native-static-build
  (let [root (str (System/tmp_dir!) "/bl-native-" (System/unique_integer (list :positive)))
        src (str root "/src") out (str root "/out")]
    (File/mkdir_p! src)
    (try
      (File/write! (str src "/native.bl")
        (str "(ns ^:js native (:require [js.frame]))\n"
             "(defn- secret [] 9)\n"
             "(defn add [a b] (+ a b))\n"
             "(def obj #js {:x 7 :f (fn [] 4)})\n"
             "(println (.stringify js/JSON #js {:a #js [1 2]}))\n"
             "(println (js/Math.max 4 9))\n"
             "(println (.f obj))\n"
             "(set! (.-x obj) 12)\n(println (.-x obj))\n"
             "(println (aget #js [4 5] 1))\n"
             "(println (:x (js->bl #js {:x 3} :keywordize-keys true)))\n"
             "(println (js/undefined? js/undefined))\n"))
      (js/build! "native" {:paths (list src) :out out})
      (let [r (System/cmd "node" (list (str out "/ns/native.mjs")))]
        (is (= 0 (erlang/element 2 r)))
        (is (= "{\"a\":[1,2]}\n9\n4\n12\n5\n3\ntrue\n" (erlang/element 1 r))))
      (let [r (System/cmd "node" (list "test/js/native-static.mjs" out))]
        (is (= 0 (erlang/element 2 r)) (erlang/element 1 r)))
      (let [r (System/cmd "node" (list "test/js/frame-static.mjs" out))]
        (is (= 0 (erlang/element 2 r)) (erlang/element 1 r)))
      (finally (File/rm_rf! root)))))
