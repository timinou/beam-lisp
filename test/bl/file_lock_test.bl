(ns file-lock.test)

(defn- lock [path shared]
  (BeamLisp.LazyMemo/ensure_loaded!)
  (BeamLisp.LazyMemo/nif_file_lock path shared true))
(defn- unlock [r] (BeamLisp.LazyMemo/nif_file_unlock (elem r 1)))

(deftest shared-custody-excludes-retirement-until-every-reader-leaves
  (let [root (str (System/tmp_dir!) "/bl-file-lock-" (System/unique_integer (list :positive)))
        path (str root "/anchor") a (lock path true) b (lock path true)]
    (try
      (is (= :ok (elem a 0))) (is (= :ok (elem b 0)))
      (is (= :busy (elem (lock path false) 0)))
      (unlock a)
      (is (= :busy (elem (lock path false) 0)))
      (unlock b)
      (let [writer (lock path false)]
        (try
          (is (= :ok (elem writer 0)))
          (is (= :busy (elem (lock path true) 0)))
          (is (= :busy (elem (lock path false) 0)))
          (finally (unlock writer))))
      (finally (unlock a) (unlock b) (File/rm_rf! root)))))

(deftest dead-owner-releases-even-a-handle-retained-by-another-process
  (let [root (str (System/tmp_dir!) "/bl-file-death-" (System/unique_integer (list :positive)))
        path (str root "/anchor") parent (erlang/self)
        worker (spawn (fn [] (erlang/send parent (tuple :locked (lock path false))) (receive :done :ok)))]
    (try
      (let [retained (receive [:locked r] r (after 5000 nil))]
        (is (= :ok (elem retained 0)))
        (is (= :busy (elem (lock path false) 0)))
        (erlang/exit worker :kill)
        (let [next (loop [n 200]
                     (let [r (lock path false)]
                       (if (or (= :ok (elem r 0)) (zero? n)) r
                         (do (Process/sleep 5) (recur (dec n))))))]
          (try (is (= :ok (elem next 0)))
               (finally (when (= :ok (elem next 0)) (unlock next)))))
        (unlock retained))
      (finally (erlang/exit worker :kill) (File/rm_rf! root)))))

(run-tests)
