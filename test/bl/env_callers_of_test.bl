; test/bl/env_callers_of_test.bl — `BeamLisp.Env/callers_of` walks every shape of
; ANF node without crashing.
;
; `callers_of` is what `reload`'s coherence gate asks to learn who would dangle
; if a var changed, so a crash in it takes down the HOT-RELOAD path, not just a
; query. The 2026-09-29 cutover of env.ex to env.bl ported
; `Map.delete(node, :op)` as `maps/delete` — which does not exist in Erlang
; (`maps:remove/2` is the function; `Map.delete` is Elixir's wrapper). Nothing
; exercised the line, so it shipped, and the first caller to REACH it was a
; vps_spike (04_hot_reload) that asked who calls a var from a namespace that also
; calls OTHER qualified functions:
;
;     error: function :maps.delete/2 is undefined or private
;       at BeamLisp.Env/node_calls_remote?
;
; The branch is only reached by a `:remote` node that is NOT the target — i.e. a
; caller that calls some OTHER qualified function. A caller whose only qualified
; call is the target never touches it, which is why a smoke test of `callers_of`
; passes without this one. So the fixture below has all three shapes: a caller
; of the target, a caller of a DIFFERENT qualified fn, and a caller of nothing.
;
; Run: bin/bl test test/bl/env_callers_of_test.bl

(ns test.env-callers-of)

(ns coi.callee)
(defn target [x] (inc x))
(defn other [x] (dec x))

(ns coi.calls-target)
(defn go [x] (coi.callee/target x))

(ns coi.calls-other)
; a qualified call that is NOT the target: the node that takes the
; non-matching-:remote branch, the one that used to crash.
(defn go [x] (coi.callee/other x))

(ns coi.calls-both)
(defn go [x] (+ (coi.callee/other x) (coi.callee/target x)))

(ns coi.calls-nothing)
(defn go [x] (inc x))

(ns test.env-callers-of)

(defn- callers [] (set (map vec (BeamLisp.Env/callers_of "coi.callee" "target"))))

(deftest callers-of-does-not-crash-on-a-non-target-remote
  (is (set? (callers))
      "a caller of a DIFFERENT qualified fn used to raise maps:delete/2 undef"))

(deftest callers-of-finds-exactly-the-callers-of-the-target
  (is (= #{["coi.calls-target" "go"] ["coi.calls-both" "go"]} (callers))
      "the target's callers, found past a sibling call to another fn")
  (is (not (contains? (callers) ["coi.calls-other" "go"]))
      "calling a different fn in the same namespace is not calling the target")
  (is (not (contains? (callers) ["coi.calls-nothing" "go"]))))

(deftest callers-of-excludes-the-targets-own-namespace
  (is (empty? (filter (fn [[ns _]] (= ns "coi.callee")) (callers)))))

; The port keeps env.ex's `when is_binary` guard: a non-string is a
; FunctionClauseError (`fce!`), not an empty answer. Pinned so a "friendlier"
; edit that silently answers [] for a typo'd atom is a deliberate choice.
(deftest callers-of-on-a-non-string-is-a-function-clause-error
  (is (thrown? (BeamLisp.Env/callers_of :nope "x"))))
