; test/bl/proc_home_test.bl — a bundle has ONE home, and it is not the root.
; Run: bin/bl test --shared test/bl/proc_home_test.bl
;
; A bundle is `priv/std/proc/<name>.bl` declaring `(ns proc.<name>)`: the file
; name and the namespace are the same fact, so a bundle has exactly one place to
; be and one way to be named. Two consequences are pinned here.
;
;   · ONE DOOR. `(:require [proc :as proc])` reaches a verb from every bundle,
;     so a consumer writes one require for the whole pattern language instead of
;     knowing which of ten namespaces a verb lives in. Reaching into a single
;     bundle (`[proc.tick]`) still works — the door is a convenience, not a wall.
;
;   · NO SECOND HOME. A bare `flow`, `bus`, `reg`, `super` or `fence` resolves
;     to nothing: no source file declares it and no compiled module serves it. A
;     shim left at the old path, or a beam whose source was moved out from under
;     it, would answer one question two ways — and that last assertion is why
;     this test earns its keep, because a stale module is invisible to anyone
;     reading the new files.
;
; The layout itself is stated for a reader in docs/the-process-pattern-language.md
; (the tier's own document) and enumerated in priv/std/proc.bl (the door).

(ns proc.home-test
  (:require [proc :as proc]
            [proc.flow]
            [proc.bus]
            [proc.reg]
            [proc.super]
            [proc.fence]))

(def bundles ["flow" "bus" "reg" "super" "fence"])

(deftest a-bundle-lives-under-proc
  (doseq [n bundles]
    (let [ns-name (str "proc." n)
          path (BeamLisp.Loader/source_path ns-name)]
      (is (some? path) (str ns-name " resolves to a source file"))
      (is (>= (index-of path (str "priv/std/proc/" n ".bl")) 0)
          (str ns-name " lives at priv/std/proc/" n ".bl — got " path)))))

(deftest the-umbrella-is-the-one-door
  ; One require, and the verbs of every bundle arrive through it.
  (is (fn? proc/whereis)    "proc/whereis is proc.reg's verb")
  (is (fn? proc/publish)    "proc/publish is proc.bus's verb")
  (is (fn? proc/from-seq)   "proc/from-seq is proc.flow's verb")
  (is (fn? proc/children)   "proc/children is proc.super's verb")
  (is (fn? proc/fence-fn)   "proc/fence-fn is proc.fence's verb")
  (is (fn? proc/tick-delay) "proc/tick-delay is proc.tick's verb")
  ; The pure clause model is the tier's contract for a SECOND backend (the JS
  ; actor compiler), so it arrives through the same door as the verbs — a
  ; consumer needs no knowledge of which bundle owns the expander.
  (is (fn? proc/clause-plan) "proc/clause-plan is proc.server's pure expander")
  ; Same contract, the supervisor half: a tree's expansion is data a SECOND
  ; backend consumes, so its expander arrives through the one door too.
  (is (fn? proc/supervisor-plan) "proc/supervisor-plan is proc.super's pure tree expander"))

(deftest a-trees-own-namespace-wins-over-the-std
  ; The documented search order is tree > configured roots > shipped tiers, and
  ; `overrides/` is built on it. `multi` is the honest witness: the command line
  ; does not load it on the way to a program, so a tree's own root is consulted.
  ; The other half is NOT true today and FUP-110 records it — a namespace the CLI
  ; DOES preload (`bl.env`, `proc.tick`) has already been answered by the time a
  ; tree's roots are known, so the tree's file loses.
  (let [dir (str (System/tmp_dir!) "/bl-own-root-test")
        file (str dir "/multi.bl")]
    (File/mkdir_p! dir)
    (File/write! file "(ns multi)\n(defn whoami [] :the-tree)\n")
    (try
      (let [content (BeamLisp.Loader/with_search_dir dir
                      (fn [] (BeamLisp.Loader/source_content "multi")))]
        (is (some? content) "the tree's own root serves the namespace")
        (is (>= (index-of content ":the-tree") 0)
            "and the bytes are the tree's, not the shipped tier's"))
      (finally
        (File/rm! file)
        (File/rmdir dir)))))

(deftest the-old-top-level-path-is-gone
  (doseq [n bundles]
    ; `source_content` is the LOADER's answer — it applies the rule that a file
    ; serves a namespace only if it DECLARES it. `source_path` does not apply
    ; that rule, so it would answer `examples/bus.bl` here, a file that declares
    ; `example.bus` and is no home for `bus` at all.
    (is (nil? (BeamLisp.Loader/source_content n))
        (str "no source file declares the bare name " n))
    (let [loaded (try
                   (do (BeamLisp.Loader/ensure_loaded n)
                       (BeamLisp.Env/loaded_ns? n))
                   (catch _ false))]
      (is (not loaded)
          (str "the bare name " n " does not load — a shim at the old path or a "
               "stale module would give one namespace two answers")))))


;; ── a tree is a plan: the supervisor's contract for a second backend ─────
;;
;; `proc.super/supervisor-plan` is the whole `defsupervisor` expansion as DATA —
;; no VM, and no `BeamLisp.Supervisor/*`. A backend (the JS actor compiler) hands
;; it the SAME source clause data and renders the plan it gets back, so the DSL
;; is decided once. These call the pure function directly, which is exactly the
;; input a backend has.

(deftest a-tree-plan-carries-defaults-and-order
  (let [p (proc/supervisor-plan {:name 'shop
                                 :clauses '((child :boss worker :boss)
                                            (child :hands worker :hands))})]
    (is (:valid? p) "a tree with no strategy and no intensity is valid")
    (is (= :one-for-one (:strategy p)) ":one-for-one is the default strategy")
    (is (nil? (:intensity p)) "no intensity clause means no intensity")
    (is (= [:boss :hands] (vec (map :id (:children p))))
        "children are in DECLARATION order")
    (is (= [0 1] (vec (map :order (:children p)))) "and each carries its index")
    (is (= :server (:kind (first (:children p)))) "a defserver child is a :server")
    (is (= 'worker (:target (first (:children p)))))
    (is (= [:boss] (:args (first (:children p))))
        "the init arg is the first positional")))

(deftest a-tree-plan-keeps-strategy-intensity-and-options
  (let [p (proc/supervisor-plan
            {:name 'shop
             :clauses '((strategy :rest-for-one)
                        (intensity 3 5000)
                        (child :acct account 100
                               {:restart :transient :shutdown 5000}))})
        c (first (:children p))]
    (is (:valid? p))
    (is (= :rest-for-one (:strategy p)))
    (is (= [3 5000] (:intensity p)) "intensity is [max-restarts window-ms]")
    (is (= {:restart :transient :shutdown 5000} (:options c)))
    (is (:has-options c) "the trailing map is recorded as the options")))

(deftest a-pool-is-one-child-and-the-boundary-is-explicit
  (let [p (proc/supervisor-plan {:name 'shop
                                 :clauses '((child :boss worker :boss)
                                            (child :hands (pool worker 4)))})
        pool (second (:children p))]
    (is (:valid? p))
    (is (= 2 (count (:children p))) "the pool's workers are NOT top-level children")
    (is (= :pool (:kind pool)) "a pool declaration is its own child kind")
    (is (= 'worker (:target pool)))
    (is (= 4 (:size pool)) "…and its count is the whole boundary")))

(deftest an-unknown-strategy-is-reported-not-guessed
  (let [p (proc/supervisor-plan {:name 'shop
                                 :clauses '((strategy :everyone-for-one))})]
    (is (not (:valid? p)))
    (is (= :bad-strategy (:kind (first (:errors p)))))
    (is (>= (index-of (:msg (first (:errors p))) "one-for-one") 0)
        "the message names the accepted strategies")))

(deftest a-malformed-intensity-is-reported
  (let [p (proc/supervisor-plan {:name 'shop :clauses '((intensity 3))})]
    (is (not (:valid? p)))
    (is (= :bad-intensity (:kind (first (:errors p))))))
  (let [p (proc/supervisor-plan {:name 'shop :clauses '((intensity -1 5000))})]
    (is (= :bad-intensity (:kind (first (:errors p))))))
  (let [p (proc/supervisor-plan {:name 'shop :clauses '((intensity 3 0))})]
    (is (= :bad-intensity (:kind (first (:errors p))))
        "the window must be positive")))

(deftest duplicate-child-ids-are-reported
  (let [p (proc/supervisor-plan {:name 'shop
                                 :clauses '((child :a worker 0)
                                            (child :a worker 1))})]
    (is (not (:valid? p)))
    (is (some (fn [e] (= :duplicate-child-id (:kind e))) (:errors p)))
    (is (= 2 (count (:children p))) "both children are still described")))

(deftest brutal-kill-is-a-valid-child-shutdown
  (let [p (proc/supervisor-plan
            {:name 'shop
             :clauses '((child :worker work {:shutdown :brutal_kill}))})]
    (is (:valid? p))
    (is (= :brutal_kill (:shutdown (:options (first (:children p))))))))

(deftest a-bad-child-option-is-reported
  (let [p (proc/supervisor-plan
            {:name 'shop
             :clauses '((child :a worker 0 {:restart :sometimes
                                            :shutdown -1
                                            :whatever 1}))})]
    (is (not (:valid? p)))
    (is (some (fn [e] (= :bad-restart (:kind e))) (:errors p)))
    (is (some (fn [e] (= :bad-shutdown (:kind e))) (:errors p)))
    (is (some (fn [e] (= :unknown-option (:kind e))) (:errors p)))))

(deftest an-unknown-tree-clause-and-a-malformed-child-are-reported
  (let [p (proc/supervisor-plan {:name 'shop :clauses '((frobnicate 1))})]
    (is (not (:valid? p)))
    (is (= 1 (count (:unknown p))))
    (is (= "frobnicate" (:head (first (:unknown p)))))
    (is (= 'shop (:where (first (:unknown p))))))
  (let [p (proc/supervisor-plan {:name 'shop :clauses '((child :a))})]
    (is (= :child-missing-target (:kind (first (:errors p)))))
    (is (empty? (:children p)) "a child the plan cannot describe is not invented")))
