(ns code-lease-observation-test)

(deftest native-owner-observation-does-not-invert-the-module-to-env-lock-order
  (let [modules (list :Elixir.BeamLisp.Ns.Core)
        handle (BeamLisp.Env/retain_code! modules)
        parent (erlang/self) ticket (erlang/make_ref)]
    (try
      (let [answer
            (BeamLisp.Env/with_module_locks modules
              (fn []
                (erlang/spawn
                  (fn []
                    (let [live (Agent/get :Elixir.BeamLisp.Env
                                 (fn [_] (BeamLisp.Env/code_lease_active? handle)))]
                      (erlang/send parent (tuple :observed ticket live)))))
                (let [timer (erlang/start_timer 2000 (erlang/self) :observation-timeout)]
                  (receive
                    [:observed observed live] :when (= observed ticket)
                    (do (erlang/cancel_timer timer) live)
                    [:timeout expired :observation-timeout] :when (= expired timer) :timed-out))))]
        (is (= true answer) "Env can observe while another process holds the module fence"))
      (finally (BeamLisp.Env/release_code! handle)))
    (is (not (BeamLisp.Env/code_lease_active? handle)) "released tickets never remain live")))

(deftest loaded-namespace-observation-reuses-the-live-ets-mirror
  (BeamLisp.Env/isolated
    (fn []
      (BeamLisp.Env/mark_loaded "lease-observation.loaded")
      (let [trace (tuple :Elixir.Agent :get 2)]
        (erlang/trace_pattern trace true (list :local :call_count))
        (let [result (try
                       (let [answers (mapv (fn [_] (BeamLisp.Env/loaded_ns? "lease-observation.loaded")) (range 20))]
                         [answers (erlang/trace_info trace :call_count)])
                       (finally (erlang/trace_pattern trace false (list :local :call_count))))]
          (is (every? true? (first result)))
          (is (= (tuple :call_count 0) (second result)) "positive reads never queue on Env"))))))
