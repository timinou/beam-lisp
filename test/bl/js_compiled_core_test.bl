(ns bl.js.compiled-core-test
  (:require [bl.js :as js]
            [bl.util :as u]
            [reader-node :as rn]))

(defn- tmp-dir []
  (let [d (str (or (System/get_env "TMPDIR") (System/tmp_dir!)) "/bl-jscompiled-" (System/unique_integer (u/to-list [:positive])))]
    (File/mkdir_p! d)
    d))

; ── COMPILED-CORE CORPUS DIFFERENTIAL (PLAN-163 U2 follow-up) ─────────────
;
; Each test/js/eval/*.bl corpus above is a whole language area; the test above
; builds `js.eval` with the in-page compiler and evaluates forms one at a time.
; This differential instead turns each corpus into ONE synthetic namespace of
; zero-arg case functions and compiles them (plus core, rt and seed) with ONE
; `js.build` — the compiled target, the default — the same shared-core path,
; once per run.
;
; Generation is structural: the reader's streaming `read-next-string` returns
; every top-level form WITH its own exact source slice, so a syntax-quoted
; node's shrunken end never matters and the corpus is read once, never per form.
; A `def`/`defn`/`defmacro` stays a top-level declaration (later forms compile
; against it) and gets a case returning the declared value (`:__macro` for a
; macro, the sentinel its BEAM value prints as); the fixture-init shape
; `(do (def x init) nil)` is LIFTED to a top-level `def` with its case returning
; nil — recognised on the reader AST (`do-def-init`), never parsed by hand.
; The BEAM oracle still runs the ORIGINAL forms, in order, in an isolated
; namespace per corpus; test/js/diff/compare.mjs diffs the two printings.

(def ^:private eval-corpora
  "[[corpus-name path] …]; the emission order is the label order."
  [["general" "test/js/eval/corpus.bl"]
   ["lazy" "test/js/eval/lazy.bl"]
   ["lazy-core" "test/js/eval/lazy-core.bl"]
   ["compare" "test/js/eval/compare.bl"]
   ["leaves" "test/js/eval/leaves.bl"]
   ["metadata" "test/js/eval/metadata.bl"]
   ["callbacks" "test/js/eval/callbacks.bl"]])

(defn- node-tag [n] (rn/node-tag (rn/node-form n)))
(defn- node-items [n] (rn/node-items n))

(defn- node-sym-name
  "The text of a symbol node (one metadata layer peeled), or nil."
  [n]
  (let [f (rn/node-form n)]
    (when (= :symbol (rn/node-tag f)) (rn/node-name f))))

(defn- form-head
  "The head symbol of a list form `n`, or nil."
  [n]
  (when (= :list (node-tag n)) (node-sym-name (first (node-items n)))))

(defn- cp-slice
  "Text of codepoints `start`..`end` (0-based offsets) of charlist `cps`.
   `lists/sublist` is 1-based, so the start shifts by one."
  [cps start end]
  (unicode/characters_to_binary (lists/sublist cps (inc start) (max 0 (- end start)))))

(defn- corpus-forms
  "Read the source string ONCE as a reader stream: [[form source-text] …] for every
   top-level form, in order; comments INSIDE a form are kept. If `src` is provided,
   use it; otherwise read `path`."
  [path & [src]]
  (let [content (or src (File/read! path))]
    (loop [st (BeamLisp.Ns.Reader/stream content path) out []]
      (let [r (BeamLisp.Ns.Reader/read-next-string st)]
        (if (= :ok (first r))
          (recur (nth r 3) (conj out [(second r) (nth r 2)]))
          out)))))
(defn- do-def-init
  "The inner `(def …)` node of the fixture-init form `(do (def name init) nil)`
   — the shape whose printed value would force a lazy node — or nil. Recognised
   on the reader AST, never by a regex."
  [f]
  (when (and (= "do" (form-head f)) (= 3 (count (node-items f))))
    (let [inner (second (node-items f))
          tail (nth (node-items f) 2)]
      (when (and (= "def" (form-head inner))
                 (= :scalar (rn/node-tag (rn/node-form tail)))
                 (nil? (rn/node-form tail)))
        inner))))

(defn- def-name
  "The declared name of a `def`/`defn`/`defmacro` form, metadata unwrapped."
  [f]
  (rn/node-name (rn/node-form (second (node-items f)))))
(defn- corpus-ns-source
  "The synthetic namespace `(ns eval.corpus.<name>)` for corpus `path`, reading the source once."
  [path k]
  (let [src (File/read! path)
        src-cps (unicode/characters_to_list src)
        forms (corpus-forms path src)]
    (str "(ns eval.corpus." k ")\n\n"
         (join "\n"
           (map-indexed
             (fn [i [f text]]
               (let [dd (do-def-init f)
                     head (form-head f)]
                 (cond
                   (some? dd)
                     (let [p (rn/node-pos dd)]
                       (str (cp-slice src-cps (get p :offset) (get p :end-offset))
                            "\n(defn f" i " [] nil)\n"))
                   (or (= "def" head) (= "defn" head) (= "defn-" head))
                     (str text "\n(defn f" i " [] " (def-name f) ")\n")
                   (= "defmacro" head)
                     (str text "\n(defn f" i " [] :__macro)\n")
                   :else
                     (str "(defn f" i " [] " text "\n)\n"))))
             forms)))))

(defn- umbrella-source
  "One entry namespace requiring the corpora and the seed fixture."
  [ks]
  (str "(ns eval.corpus.all\n  (:require "
       (join " " (map (fn [k] (str "[eval.corpus." k "]")) ks))
       " [seed.main]))\n\n(defn f0 [] (seed.main/case-results))\n"))


(defn- write-corpora!
  "Generate the synthetic namespaces and the umbrella under `root`."
  [root]
  (File/mkdir_p! (str root "/eval/corpus"))
  (doseq [[k p] eval-corpora]
    (File/write! (str root "/eval/corpus/" k ".bl") (corpus-ns-source p k)))
  (File/write! (str root "/eval/corpus/all.bl") (umbrella-source (map first eval-corpora))))

(defn- eval-print
  "The shared printing protocol: a fn (JS or a raw `{:$blfn …}` tuple) is
   `#fn`, a macro value `{:$macro …}` is `#macro`, anything else `pr-str`."
  [v]
  (cond (fn? v) "#fn"
        (and (erlang/is_tuple v) (> (erlang/tuple_size v) 0) (= :$macro (erlang/element 1 v))) "#macro"
        :else (pr-str v)))

(defn- beam-corpus-lines
  "The ORIGINAL top-level forms of `path`, evaluated in order in the isolated
   namespace `ns`, one `<ns>#<i>\t<value>` line each — the oracle the generated
   case functions must match."
  [ns path]
  (println (str "js-diff: BEAM " ns))
  (join "\n"
    (map-indexed
      (fn [i f]
        (str ns "#" i "\t"
             (try (eval-print (BeamLisp.Compiler/eval_form f (BeamLisp.Compiler/new_env ns)))
                  (catch e (str "#error " (ex-message e))))))
      (BeamLisp.Ns.Reader/read_string (File/read! path) path))))

(defn- seed-case-lines
  "The cross-namespace seed fixture, evaluated on the BEAM through the Loader
   with its own root — the first labelled case. `case-results` rebinds
   `core/map` only inside its one call and restores it in a `finally`; the
   current namespace and the var are snapshotted and restored here too."
  []
  (let [before (BeamLisp.Env/current_ns)
        old-map (BeamLisp.Env/fetch! "core" "map")]
    (try
      (BeamLisp.Env/add_search_path "test/js/fixtures/seed")
      (BeamLisp.Loader/ensure_loaded "seed.main")
      (let [v ((BeamLisp.Env/fetch! "seed.main" "case-results"))]
        {:value v :line (str "eval.corpus.all#0\t" (eval-print v))})
      (finally
        (BeamLisp.Env/in_ns before)
        (BeamLisp.Env/intern "core" "map" old-map)))))
(deftest same-core-compiled-corpora-match-the-beam
  (if (nil? (System/find_executable "node"))
    (is true "node not installed: differential skipped")
    (let [root (tmp-dir)]
      (try
        (write-corpora! root)
        ; counts come from the same reader the generator uses, so the label
        ; ranges the runner is told cannot drift from the f<i> functions
        (let [counts (into {} (map (fn [[k p]] [k (count (BeamLisp.Ns.Reader/read_string (File/read! p) p))])
                                   eval-corpora))
              total (+ 1 (reduce + 0 (vals counts)))
              ; the BEAM side FIRST: the build interns placeholders for names
              ; the VM has not bound, which would clobber a namespace it
              ; compiled before the VM loaded it
              seed-case (seed-case-lines)
              beam (str (:line seed-case) "\n"
                        (join "\n" (map (fn [[k p]] (beam-corpus-lines (str "eval.corpus." k) p)) eval-corpora)))
              _ (File/write! (str root "/beam.out") beam)
              out (str root "/out")
              _ (println (str "js-diff: compiling " total " cases over one core"))
              ; compile-ns requires use the loader, after the original oracle
              ; has run. This root stays inside the ward's isolated env.
              _ (BeamLisp.Env/add_search_path root)
              r (js/build! "eval.corpus.all" {:paths (list root "test/js/fixtures/seed") :out out})
              args (concat ["test/js/eval/compiled-side.mjs" out "eval.corpus.all:1"]
                           (map (fn [[k _]] (str "eval.corpus." k ":" (get counts k))) eval-corpora))
              _ (println "js-diff: running compiled cases")
              [jsout jcode] (u/to-list (erlang/tuple_to_list (System/cmd "node" (u/to-list args))))
              _ (File/write! (str root "/js.out") jsout)
              [report code] (u/to-list (erlang/tuple_to_list
                                         (System/cmd "node" (u/to-list ["test/js/diff/compare.mjs"
                                                                         (str root "/beam.out") (str root "/js.out")]))))]
          (is (contains? (set (:modules r)) "core") "core is compiled from priv/boot")
          (is (contains? (set (:modules r)) "rt") "rt is compiled from priv/boot")
          (is (= 0 jcode) (str "compiled-side: " jsout))
          (is (= 0 code) report)
          (is (< 250 total) (str "substantial corpus: " total " cases"))
          (is (= [true true false true true
                  (list 2 3 4) 6 (list 2 3 4) 6 7 9 1
                  [:rebound (list 5 6)] true]
                 (:value seed-case))
              (str "seed.main/case-results: " (pr-str (:value seed-case))))
          (let [lazy (File/read! (str root "/eval/corpus/lazy.bl"))
                general (File/read! (str root "/eval/corpus/general.bl"))]
            (is (some? (index-of lazy "(defn f0 [] nil)")) "fixture init lifted to a case returning nil")
            (is (nil? (index-of lazy "(do (def")) "no (do (def …) nil) fixture init remains")
            (is (some? (index-of general "(defmacro unless")) "the macro declaration stays top-level")
            (is (some? (index-of general ":__macro")) "the macro case carries the sentinel")))
        (finally (File/rm_rf! root))))))
