; guards_test.bl — guards and clause dispatch, ported from the ExUnit suite
; test/beam_lisp/guards_test.exs (17 KB, 30 `test` blocks).
;
; The ExUnit file pinned the half of Elixir's quoted format beam-lisp could
; always express but never offered a spelling for: `:when` guards on `defn`/`fn`
; clauses, `receive` clauses and `defserver` callbacks, the restricted guard
; dialect and its refusals, nested vector patterns (BUG-002), and the tuple's
; positional destructuring. Every live assertion is preserved here, one
; `deftest` per `test`, one `is` per `assert`, in source order.
;
; PARITY MAPPING (ExUnit `test` → BL `deftest`):
;   same-arity clauses are chosen by their guards  → same-arity-clauses-are-chosen-by-their-guards
;   an anonymous fn dispatches on guards too       → an-anonymous-fn-dispatches-on-guards-too
;   guards compose with multi-arity dispatch       → guards-compose-with-multi-arity-dispatch
;   same-arity clauses need not be adjacent        → same-arity-clauses-need-not-be-adjacent
;   recur crosses a guard boundary                 → recur-crosses-a-guard-boundary-into-the-next-clause
;   a guarded fn still works through invoke        → a-guarded-fn-still-works-through-invoke
;   a variadic clause coexists with guarded fixed  → a-variadic-clause-coexists-with-guarded-fixed-clauses
;   a receive guard leaves non-matching messages   → a-receive-guard-leaves-non-matching-messages-in-the-mailbox
;   a receive clause without a guard is unchanged  → a-receive-clause-without-a-guard-is-unchanged
;   nested vector patterns compile and match       → nested-vector-patterns-compile-and-match
;   nesting works at depth 3 and through a map     → nesting-works-at-depth-3-and-through-a-map
;   a nested pattern matches a tuple and a vector  → a-nested-pattern-matches-a-tuple-and-a-vector-alike
;   excessive nesting is refused by name           → excessive-nesting-is-refused-by-name
;   a defserver callback dispatches on a guard     → a-defserver-callback-dispatches-on-a-guard
;   the guard vocabulary covers the predicates     → the-guard-vocabulary-covers-the-own-predicates
;   a guard predicate agrees with the function     → a-guard-predicate-agrees-with-the-function-of-the-same-name
;   map? covers records and sorted maps            → map-predicate-in-a-guard-covers-records-and-sorted-maps
;   numeric guards use term order                  → numeric-guards-use-term-order
;   a guard declines rather than raising           → a-guard-declines-rather-than-raising
;   and / or / not compose inside a guard          → and-or-not-compose-inside-a-guard
;   clause bodies expand macros in source order    → clause-bodies-expand-their-macros-in-source-order
;   a side-effecting call in a guard is refused    → a-side-effecting-call-in-a-guard-is-refused
;   a guard may only read variables the head binds → a-guard-may-only-read-variables-the-head-binds
;   a guard cannot read a destructured parameter   → a-guard-cannot-read-a-destructured-parameter
;   a dangling :when is refused                    → a-dangling-when-is-refused
;   a tuple destructures positionally              → a-tuple-destructures-positionally
;   nested tuple destructuring needs no conversion → nested-tuple-destructuring-needs-no-conversion
;   a too-short tuple destructures leniently       → a-too-short-tuple-destructures-leniently
;   internal tagged values stay opaque             → internal-tagged-values-stay-opaque-despite-being-tuples
;   every internal tuple tag is registered         → every-internal-tuple-tag-is-registered-as-machinery
;
; ADAPTATIONS (ExUnit → ward):
;   * `eval(ns, source)` was `BeamLisp.Compiler.eval_string(source,
;     BeamLisp.Compiler.new_env(ns))` — a FRESH compile env per call, so one
;     test's `defn` never leaked into the next. `ev` reproduces that: it runs
;     the source inside `env/isolated` under a fresh `(ns guards.srcN)`, so the
;     definitions land in a throwaway fork and this suite's own namespace is
;     never switched. (Running `eval_string` with an explicit env directly would
;     have made the runtime's current ns follow the eval — the ExUnit suite was
;     saved from that only by each test using a distinct ns name and running in
;     its own process.)
;   * `assert_raise BeamLisp.CompileError` → a TYPED catch (`compile-error`)
;     returning the raised struct, which the `is`/`msg-of` assertions inspect.
;   * `assert err.message =~ "…"` → `(is (includes? (msg-of e) "…"))`.
;   * `refute X == Y` → `(is (not (= Y X)))` (ward has no `refute`).
;   * two-`assert` blocks (the depth-3 nesting test) keep two `is`.
;
; Run: bin/bl test test/bl/guards_test.bl

(ns guards.test
  (:require [env]))

; ── helpers ────────────────────────────────────────────────────────────────

(defn- ev
  "Evaluate `src` in a throwaway fork under a fresh namespace — the direct
   equivalent of the ExUnit `eval/2` helper. Returns the value of `src`'s last
   form; the fork (and its defs) is destroyed on the way out."
  [src]
  (env/isolated
    (fn []
      (env/eval (str "(ns guards.src"
                     (erlang/unique_integer (list :positive))
                     ")\n" src)))))

(defn- compile-error
  "The `BeamLisp.CompileError` `src` raises, or nil when it evaluates cleanly —
   the value ExUnit's `assert_raise` inspected."
  [src]
  (try
    (do (ev src) nil)
    (catch BeamLisp.CompileError e e)))

(defn- msg-of
  "The message of a raised exception, or \"\" when none was raised, so the
   substring assertions read as ExUnit's `=~` did."
  [e]
  (if (nil? e) "" (str (ex-message e))))

; ── defn / fn clause dispatch ──────────────────────────────────────────────

(deftest same-arity-clauses-are-chosen-by-their-guards
  (is (= (list :integer :string :other)
         (ev "
(defn classify
  ([x] :when (int? x) :integer)
  ([x] :when (string? x) :string)
  ([x] :other))
(list (classify 1) (classify \"a\") (classify :k))
"))))

(deftest an-anonymous-fn-dispatches-on-guards-too
  (is (= (list :pos :nonpos :nonpos)
         (ev "
(def f (fn ([x] :when (pos? x) :pos) ([x] :nonpos)))
(list (f 3) (f -3) (f 0))
"))))

(deftest guards-compose-with-multi-arity-dispatch
  (is (= (list :one-int :one-other :two)
         (ev "
(defn f
  ([x] :when (int? x) :one-int)
  ([x] :one-other)
  ([x y] :two))
(list (f 1) (f :k) (f 1 2))
"))))

; Clojure conventionally writes arities in ascending order but nothing enforces
; it. Grouping by ADJACENCY would put these two `[x]` clauses in separate groups
; and lose the first — the exact bug this wave fixed, reintroduced for anyone who
; interleaved.
(deftest same-arity-clauses-need-not-be-adjacent
  (is (= (list :one-int :one-other :two)
         (ev "
(defn f
  ([x] :when (int? x) :one-int)
  ([x y] :two)
  ([x] :one-other))
(list (f 1) (f :k) (f 1 2))
"))))

; `recur` re-enters the DISPATCHER, so a recur whose new arguments fail this
; clause's guard lands in the next clause.
(deftest recur-crosses-a-guard-boundary-into-the-next-clause
  (is (= [:done 0]
         (ev "
(defn countdown
  ([n] :when (pos? n) (recur (- n 1)))
  ([n] [:done n]))
(countdown 5)
"))))

(deftest a-guarded-fn-still-works-through-invoke
  (is (= (list :+ :- :zero)
         (ev "
(defn sign
  ([n] :when (pos? n) :+)
  ([n] :when (neg? n) :-)
  ([_n] :zero))
(to-list (map sign [3 -3 0]))
"))))

(deftest a-variadic-clause-coexists-with-guarded-fixed-clauses
  (is (= (list :int :other [:many 2])
         (ev "
(defn f
  ([x] :when (int? x) :int)
  ([x] :other)
  ([x & more] [:many (count more)]))
(list (f 1) (f :k) (f 1 2 3))
"))))

; ── receive ────────────────────────────────────────────────────────────────

; A non-matching message is never received, so it stays in the mailbox for a
; later clause — an `if` in the body cannot do this.
(deftest a-receive-guard-leaves-non-matching-messages-in-the-mailbox
  (is (= (list -1 5)
         (ev "
(erlang/send (erlang/self) [:take 5])
(erlang/send (erlang/self) [:take -1])
(let [neg (receive [:take n] :when (neg? n) n (after 200 :timeout))
      pos (receive [:take n] :when (pos? n) n (after 200 :timeout))]
  (list neg pos))
"))))

(deftest a-receive-clause-without-a-guard-is-unchanged
  (is (= :pong
         (ev "
(erlang/send (erlang/self) :ping)
(receive :ping :pong (after 200 :timeout))
"))))

; ── nested patterns (BUG-002) ──────────────────────────────────────────────

(deftest nested-vector-patterns-compile-and-match
  (is (= 1
         (ev "
(erlang/send (erlang/self) [:a [:b 1]])
(receive [:a [:b n]] n (after 200 :timeout))
"))))

(deftest nesting-works-at-depth-3-and-through-a-map
  (is (= 7
         (ev "
(erlang/send (erlang/self) [:a [:b [:c 7]]])
(receive [:a [:b [:c n]]] n (after 200 :timeout))
")))
  (is (= 2
         (ev "
(erlang/send (erlang/self) {:k [:x [:y 2]]})
(receive {:k [:x [:y n]]} n (after 200 :timeout))
"))))

(deftest a-nested-pattern-matches-a-tuple-and-a-vector-alike
  (is (= 3
         (ev "
(erlang/send (erlang/self) (tuple :a (tuple :b 3)))
(receive [:a [:b n]] n (after 200 :timeout))
"))))

; The alternatives are a Cartesian product, so deep nesting is refused with a
; count and a remedy rather than emitting hundreds of bodies.
(deftest excessive-nesting-is-refused-by-name
  (let [e (compile-error "(receive [[[[[[[n]]]]]]] n (after 10 :t))")]
    (is (some? e) "excessive nesting is a compile error")
    (is (includes? (msg-of e) "nests too deeply"))
    (is (includes? (msg-of e) "128"))))

; ── defserver ──────────────────────────────────────────────────────────────

(deftest a-defserver-callback-dispatches-on-a-guard
  (is (= (list :ok :insufficient :invalid 70)
         (ev "
(defserver bank
  (init [x] (ok x))
  (handle-call [:withdraw n] :when (pos? n) [_from state]
    (if (>= state n) (reply :ok (- state n)) (reply :insufficient state)))
  (handle-call [:withdraw n] [_from state] (reply :invalid state))
  (handle-call :balance [_from state] (reply state state)))
(let [p (start-link bank 100)
      a (call p [:withdraw 30])
      b (call p [:withdraw 1000])
      c (call p [:withdraw -5])
      d (call p :balance)]
  (stop p)
  (list a b c d))
"))))

; ── the guard dialect, and its edges ───────────────────────────────────────

(deftest the-guard-vocabulary-covers-the-own-predicates
  (is (= (list :keyword :map :vector nil :float :int :string :pid :other)
         (ev "
(defn kind
  ([x] :when (keyword? x) :keyword)
  ([x] :when (map? x) :map)
  ([x] :when (vector? x) :vector)
  ([x] :when (nil? x) :nil)
  ([x] :when (float? x) :float)
  ([x] :when (int? x) :int)
  ([x] :when (string? x) :string)
  ([x] :when (pid? x) :pid)
  ([_x] :other))
(to-list (map kind [:k {:a 1} [1] nil 1.5 2 \"s\" (erlang/self) (list 1)]))
"))))

; THE contract for the guard dialect: a predicate must mean in a guard exactly
; what the function of the same name means. Checked against the RUNTIME function,
; not a hardcoded expectation.
(deftest a-guard-predicate-agrees-with-the-function-of-the-same-name
  (let [rows (ev "
(defrecord GvPoint [a b])
(defn m? ([x] :when (map? x) true) ([_x] false))
(defn f? ([x] :when (fn? x) true) ([_x] false))
(defn p? ([x] :when (pos? x) true) ([_x] false))
(let [vals [{:a 1} [1 2] (atom 1) (->GvPoint 1 2) (sorted-map :a 1)
            (fn ([x] x) ([x y] y)) inc 1 -1 :k \"s\"]]
  ; every value, every predicate, guard form vs function form
  (to-list (map (fn [v] [(= (m? v) (map? v))
                         (= (f? v) (fn? v))
                         (= (p? v) (pos? v))])
                vals)))
")]
    ; the outer ExUnit `assert` covered the `Enum.each` result; the meaningful
    ; half is that every corpus row is present AND agrees, so both are asserted.
    (is (= 11 (count rows)) "every corpus row is present")
    (doseq [row rows]
      (is (= [true true true] row)
          (str "a guard predicate disagreed with its function: " row)))))

; `map?` accepts a RECORD and a sorted map, because `RT.map?/1` does; it excludes
; the non-map structs. Spelled out so the intended answers are visible.
(deftest map-predicate-in-a-guard-covers-records-and-sorted-maps
  (is (= (list true true true false false)
         (ev "
(defrecord GvRec [a])
(defn m? ([x] :when (map? x) true) ([_x] false))
(list (m? {:a 1}) (m? (->GvRec 1)) (m? (sorted-map :a 1))
      (m? [1 2]) (m? (atom 1)))
"))))

; `pos?`/`zero?`/`neg?` are bare comparisons, and BEAM comparison is a TOTAL
; order, so `(pos? :k)` is true. The guard must not invent a different answer.
(deftest numeric-guards-use-term-order
  (is (= (list :pos :no :pos :pos :no :no)
         (ev "
(defn p? ([x] :when (pos? x) :pos) ([_x] :no))
(defn np? ([x] :when (and (number? x) (pos? x)) :pos) ([_x] :no))
(list (p? 1) (p? -1) (p? :k) (np? 1) (np? -1) (np? :k))
"))))

; A guard never raises, whatever it is handed.
(deftest a-guard-declines-rather-than-raising
  (is (= (list :num :other :other :other)
         (ev "
(defn r? ([x] :when (> (+ x 1) 0) :num) ([_x] :other))
(list (r? 1) (r? :k) (r? nil) (r? \"s\"))
"))))

(deftest and-or-not-compose-inside-a-guard
  (is (= (list :small :other :name :name :other nil)
         (ev "
(defn r?
  ([x] :when (and (int? x) (> x 0) (< x 10)) :small)
  ([x] :when (or (string? x) (keyword? x)) :name)
  ([x] :when (not (nil? x)) :other)
  ([_x] :nil))
(to-list (map r? [5 50 \"s\" :k 1.5 nil]))
"))))

; Clauses are EMITTED grouped by shape but compiled in source order, because
; compiling a body expands its macros and expansion is observable.
(deftest clause-bodies-expand-their-macros-in-source-order
  (is (= (list 1 2)
         (ev "
(def GV-COUNTER (atom 0))
(defmacro tick [] (swap! GV-COUNTER inc) (deref GV-COUNTER))
(defn f
  ([_a] (tick))
  ([_a _b] (tick)))
(list (f 1) (f 1 2))
"))))

(deftest a-side-effecting-call-in-a-guard-is-refused
  (let [e (compile-error "(defn f ([x] :when (println x) 1) ([_x] 2))")]
    (is (some? e) "a side-effecting call in a guard is a compile error")
    (is (includes? (msg-of e) "not allowed in a guard"))
    (is (includes? (msg-of e) "`int?`"))))

(deftest a-guard-may-only-read-variables-the-head-binds
  (let [e (compile-error "(defn f ([x] :when (> y 1) 1) ([_x] 2))")]
    (is (some? e) "an unbound variable in a guard is a compile error")
    (is (includes? (msg-of e) "not bound by this clause's pattern"))))

; A destructured name is bound by a body prelude that has not run when the BEAM
; evaluates the head, so it is out of scope for the guard.
(deftest a-guard-cannot-read-a-destructured-parameter
  (let [e (compile-error "(defn f ([[a b]] :when (int? a) 1) ([_x] 2))")]
    (is (some? e) "a destructured parameter in a guard is a compile error")
    (is (includes? (msg-of e) "not bound by this clause's pattern"))))

(deftest a-dangling-when-is-refused
  (is (some? (compile-error "(defn f [x] :when)")))
  (is (some? (compile-error "(defn f [x] :when (int? x))")))
  (is (some? (compile-error "(receive n :when (pos? n))"))))

; ── a tuple is positional data ─────────────────────────────────────────────

(deftest a-tuple-destructures-positionally
  (is (= [:ok 42]
         (ev "(let [[a b] (tuple :ok 42)] [a b])"))))

(deftest nested-tuple-destructuring-needs-no-conversion
  (is (= [:x 1]
         (ev "(let [[_ok [l r]] (tuple :ok (tuple :x 1))] [l r])"))))

(deftest a-too-short-tuple-destructures-leniently
  (is (= (list 1 2 nil)
         (ev "(let [[a b c] (tuple 1 2)] (list a b c))"))))

; The language's own tagged values ARE tuples, but making tuples positional must
; not hand them a collection surface. `count` RAISES for these, while `first`
; answers nil — both readings agree that the tuple's ELEMENTS are not reachable.
(deftest internal-tagged-values-stay-opaque-despite-being-tuples
  (is (= (list :opaque nil :opaque :opaque)
         (ev "
(deftype GTLine [a b])
(list (try (count (->GTLine 1 2)) (catch e :opaque))
      (first (->GTLine 1 2))
      (try (count (fn ([x] x) ([x y] y))) (catch e :opaque))
      (try (nth (->GTLine 1 2) 0) (catch e :opaque)))
"))))

; The exclusion list is the single place that decides data vs machinery.
(deftest every-internal-tuple-tag-is-registered-as-machinery
  (let [tags (BeamLisp.Guards/internal_tuple_tags)]
    (doseq [tag (list :"$blfn" :"$remote" :"$macro" :symbol :bl_deftype :bl_reify :bl_vec)]
      (is (Enum/member? tags tag)
          (str tag " must be registered in internal_tuple_tags/0")))
    ; And the guard really excludes them, while ordinary data passes. `count`
    ; either declines with a `FunctionClauseError` or answers a value that is
    ; not the tuple's field count — the check is computed OUTSIDE `is`, because
    ; ward's `is-report` catches a raising form itself and would record an
    ; `:error` before this `try` ever saw the raise.
    (try
      (let [n (BeamLisp.Ns.Rt/count (tuple :bl_deftype :Foo (tuple 1 2)))]
        (is (not (= 3 n)) "an internal tuple's elements are not countable"))
      (catch FunctionClauseError _ :ok))))
