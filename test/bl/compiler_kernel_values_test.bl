(ns compiler-kernel-values-test)

(defn- kernel-names []
 ["anf" "compiler" "lower" "reader-node" "rt" "reader" "sugar"
  "optimize" "server-clause" "diag" "data-readers"])

(defn- kernel-source [namespace]
 (let [root (System/get_env "BL_KERNEL_SOURCE_UNDER_TEST")
       candidate (when root (Path/join root (str namespace ".candidate.bl")))]
  (if (and candidate (File/exists? candidate)) candidate
   (Path/join (BeamLisp/cwd) (str "priv/boot/" namespace ".bl")))))

(defn- owned-declarations [namespace]
 (let [module (BeamLisp.Emit/module_for namespace)
       definitions (erlang/apply module :__bl_ns_defs__ (list))
       forms (BeamLisp.Reader/read_string (File/read! (kernel-source namespace)))
       values (Enum/flat_map forms
                (fn [form]
                 (if (and (erlang/is_tuple (BeamLisp.AOT/stage-unmeta form))
                          (= :list (erlang/element 1 (BeamLisp.AOT/stage-unmeta form)))
                          (= "def" (BeamLisp.AOT/stage-head form)))
                  (list (BeamLisp.AOT/stage-symbol
                         (second (BeamLisp.AOT/stage-items form :list))))
                  (list))))]
  (set (erlang/++ (Map/keys definitions) values))))

(defn- owned-inventory []
 (Map/new (Enum/map (kernel-names) (fn [namespace] (tuple namespace (owned-declarations namespace))))))

(defn- executable-owned-globals [node inventory]
 (cond
  (erlang/is_map node)
   (let [op (Map/get node :op)]
    (cond
     (or (contains? #{:lit :plit} op) (= :plit (Map/get node :pop))) (list)
     (= :global op)
      (if (contains? (Map/get inventory (Map/get node :ns) #{}) (Map/get node :name))
       (list [(Map/get node :ns) (Map/get node :name)]) (list))
     :else (Enum/flat_map (Map/values (Map/delete node :ann))
              (fn [value] (executable-owned-globals value inventory)))))
  (erlang/is_list node)
   (Enum/flat_map node (fn [value] (executable-owned-globals value inventory)))
  (erlang/is_tuple node)
   (Enum/flat_map (erlang/tuple_to_list node) (fn [value] (executable-owned-globals value inventory)))
  :else (list)))

(deftest semantic-global-guard-preserves-literals-and-lexical-callbacks
 (let [inventory {"kernel" #{"helper" "constant"}}]
  (is (= (list ["kernel" "helper"])
         (executable-owned-globals {:op :global :ns "kernel" :name "helper"} inventory)))
  (is (= (list ["kernel" "constant"])
         (executable-owned-globals {:op :global :ns "kernel" :name "constant"} inventory)))
  (is (= (list) (executable-owned-globals {:op :global :ns "kernel" :name "count"} inventory)))
  (is (= (list) (executable-owned-globals {:op :var :name "helper"} inventory)))
  (is (= (list) (executable-owned-globals {:op :lit :val {:op :global :ns "kernel" :name "helper"}} inventory)))
  (is (= (list) (executable-owned-globals {:pop :plit :val {:op :global :ns "kernel" :name "constant"}} inventory)))
  (is (= (list) (executable-owned-globals {:op :var :name "x" :ann {:op :global :ns "kernel" :name "helper"}} inventory)))))

(deftest compiled-boot-kernel-never-borrows-its-source-function-or-data-values
 (let [inventory (owned-inventory)]
  (doseq [namespace (kernel-names)]
   (let [definitions (erlang/apply (BeamLisp.Emit/module_for namespace) :__bl_ns_defs__ (list))
         reads (Enum/flat_map (Map/values definitions)
                 (fn [entries] (Enum/flat_map entries
                   (fn [entry] (executable-owned-globals (erlang/element 4 entry) inventory)))))]
    (is (= (list) reads))))))

(defn- compile-probe [text]
 (BeamLisp.Compiler/reset_fresh!)
 (BeamLisp.Ns.Lower/reset-fresh!)
 (BeamLisp.Compiler/compile (first (BeamLisp.Reader/read_string text))
                           (BeamLisp.Compiler/new_env "compiler.kernel.fixture")))

(defn- with-masked-kernel [inventory poison action]
 (let [previous (BeamLisp.Env/capture) scope (BeamLisp.Env/fork :global)]
  (try
   (BeamLisp.Env/with_env scope
    (fn []
     (Enum/each (Map/to_list inventory)
      (fn [entry]
       (let [namespace (erlang/element 1 entry)]
        (Enum/each (BeamLisp.Set/to_list (erlang/element 2 entry))
         (fn [binding] (BeamLisp.Env/intern namespace binding poison))))))
     (action)))
   (finally (BeamLisp.Env/destroy scope) (BeamLisp.Env/bind previous)))))

(deftest native-compilation-and-lowering-ignore-masked-source-kernel-values
 (let [inventory (owned-inventory)]
  (doseq [text ["()" "'(a b)" "(fn [x] x)" "(fn [& xs] xs)"
               "(let [[x & xs] []] xs)" "(System/get_env \"HOME\")"
               "(try 1 (catch error error) (finally nil))"
               "(receive x x (after 0 nil))"]]
   (let [expected (compile-probe text)
         expected-core (BeamLisp.Ns.Lower/lower-anf expected)]
    (doseq [poison [nil {:op :poison :pop :poison}]]
     (is (= [expected expected-core]
       (with-masked-kernel inventory poison
        (fn [] (let [compiled (compile-probe text)]
                 [compiled (BeamLisp.Ns.Lower/lower-anf compiled)]))))))))))

; Append to compiler_kernel_values_test.bl; shares the actual private-scope mask helper.
; Two tests, 90 EXPECTED assertions: 28 literal rows x3 +2 poisons x3 behavior controls.
(defn- kernel-data-bindings []
 [["compiler" "mod-erlang" "kernel-mod-erlang-literal"]
 ["compiler" "mod-num" "kernel-mod-num-literal"]
 ["compiler" "num-bifs" "kernel-num-bifs-literal"]
 ["compiler" "mod-body-lower" "kernel-mod-body-lower-literal"]
 ["compiler" "mod-rt" "kernel-mod-rt-literal"]
 ["compiler" "mod-env" "kernel-mod-env-literal"]
 ["compiler" "mod-vector" "kernel-mod-vector-literal"]
 ["compiler" "mod-set" "kernel-mod-set-literal"]
 ["compiler" "mod-record" "kernel-mod-record-literal"]
 ["compiler" "mod-exinfo" "kernel-mod-exinfo-literal"]
 ["compiler" "mod-exception" "kernel-mod-exception-literal"]
 ["compiler" "mod-formmeta" "kernel-mod-formmeta-literal"]
 ["compiler" "mod-link" "kernel-mod-link-literal"]
 ["compiler" "mod-loader" "kernel-mod-loader-literal"]
 ["compiler" "mod-multi" "kernel-mod-multi-literal"]
 ["compiler" "mod-server" "kernel-mod-server-literal"]
 ["compiler" "mod-module" "kernel-mod-module-literal"]
 ["compiler" "mod-code" "kernel-mod-code-literal"]
 ["compiler" "fresh-key" "kernel-fresh-key-literal"]
 ["compiler" "java-lang-classes" "kernel-java-lang-classes-literal"]
 ["compiler" "ifn-arities" "kernel-ifn-arities-literal"]
 ["compiler" "special-forms" "kernel-special-forms-literal"]
 ["compiler" "max-pattern-alternatives" "kernel-max-pattern-alternatives-literal"]
 ["compiler" "guard-bifs" "kernel-guard-bifs-literal"]
 ["diag" "severities" "kernel-severities-literal"]
 ["diag" "position-keys" "kernel-position-keys-literal"]
 ["diag" "vocabulary" "kernel-vocabulary-literal"]
 ["reader" "CONDITIONAL-FEATURE" "kernel-CONDITIONAL-FEATURE-literal"]])

(deftest immutable-kernel-data-is-one-literal-and-preserves-compatibility-vars
 (doseq [[namespace binding getter] (kernel-data-bindings)]
  (let [module (BeamLisp.Emit/module_for namespace)
        expected (BeamLisp.Env/fetch_exact! namespace binding)
        literal (erlang/apply module (erlang/binary_to_atom getter) (list))
        entries (Map/get (erlang/apply module :__bl_ns_defs__ (list)) getter)
        body (:body (erlang/element 4 (first entries)))]
   (is (= expected literal))
   (is (= :lit (:op body)))
   (is (= literal (:val body))))))

(deftest private-kernel-data-poison-cannot-change-native-reader-diag-or-compiler
 (let [inventory (Map/new
                   (Enum/map ["compiler" "diag" "reader"]
                    (fn [namespace]
                     (tuple namespace
                      (set (Enum/map
                            (Enum/filter (kernel-data-bindings)
                             (fn [entry] (= namespace (nth entry 0))))
                            (fn [entry] (nth entry 1))))))))
       reader-expected (BeamLisp.Ns.Reader/read_one "#?(:clj 9 :default 1)")
       diag-expected (BeamLisp.Ns.Diag/why-not {:diag true :severity :error :kind :test :msg "bounded"})
       compiler-expected (compile-probe "(fn [x] (if (number? x) (+ x 1) 0))")]
  (doseq [poison [nil {:op :poison :pop :poison}]]
   (is (= reader-expected
          (with-masked-kernel inventory poison
            (fn [] (BeamLisp.Ns.Reader/read_one "#?(:clj 9 :default 1)")))))
   (is (= diag-expected
          (with-masked-kernel inventory poison
           (fn [] (BeamLisp.Ns.Diag/why-not
                     {:diag true :severity :error :kind :test :msg "bounded"})))))
   (is (= compiler-expected
          (with-masked-kernel inventory poison
           (fn [] (compile-probe "(fn [x] (if (number? x) (+ x 1) 0))"))))))))
