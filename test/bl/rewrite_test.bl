; test/bl/rewrite_test.bl — pattern-directed rewriting, tested in beam-lisp.
; Run: mix beam_lisp.test test/bl/rewrite_test.bl

(ns rewrite.test
  (:require [rewrite :refer [walk prewalk postwalk match? subst defrule
                             apply-rule apply-rules]]))

; --- walk: shapes are preserved, every collection is descended into ---

(deftest walk-shape
  ; A vector stays a vector, a list stays a list — never coerced.
  (is (= (walk identity identity [1 [2 3]]) [1 [2 3]]))
  (is (= (walk identity identity '(a (b c))) '(a (b c))))
  ; empty collections survive (outer still sees them)
  (is (= (walk identity identity []) []))
  (is (= (walk identity identity {}) {}))
  (is (= (walk identity identity ())) ()))

(deftest walk-descends
  ; vectors, maps and sets are walked, not treated as atoms
  (is (= (postwalk (fn [x] (if (vector? x) (conj x :v) x)) [1]) [1 :v]))
  (is (= (postwalk (fn [x] (if (map? x) (assoc x :tag true) x)) {:a 1})
         {:a 1 :tag true}))
  (is (= (postwalk (fn [x] (if (set? x) (conj x :s) x)) #{1}) #{1 :s})))

; --- prewalk vs postwalk: the ordering, proven not asserted ---

; Collapse single-element lists. Not idempotent, so the direction the
; walker applies it in shows: prewalk flattens the outer list first (its
; result is no longer a nesting to flatten), postwalk flattens the inner
; list first and the outer one after — ending one step further.
(defn collapse-singletons [x]
  (if (and (list? x) (= 1 (count x))) (first x) x))

(deftest prewalk-vs-postwalk-order
  (is (= (prewalk collapse-singletons '((a))) '(a)))
  (is (= (postwalk collapse-singletons '((a))) 'a))
  ; a single pass of each agrees on an already-flat form
  (is (= (prewalk collapse-singletons '(a b)) '(a b)))
  (is (= (postwalk collapse-singletons '(a b)) '(a b))))

; --- match? ---

(deftest match-basics
  ; a ?-prefixed symbol binds whatever the form holds
  (let [b (match? '(= ?x nil) '(= 5 nil))]
    (is (some? b))
    (is (= (get b '?x nil) 5)))
  ; non-matches return nil
  (is (nil? (match? '(= ?x nil) '(= 5 6))))
  (is (nil? (match? '(= ?x nil) '(< 5 nil))))
  ; a literal symbol matches only itself
  (is (some? (match? 'x 'x)))
  (is (nil? (match? 'x 'y))))

(deftest match-repeated-variable
  ; (?x ?x) unifies: both positions must hold equal forms
  (is (some? (match? '(?x ?x) '(5 5))))
  (is (nil? (match? '(?x ?x) '(5 6)))))

(deftest match-shapes
  ; patterns match structurally: a vector pattern needs a vector form
  (is (some? (match? '[?x ?y] '[1 2])))
  (is (nil? (match? '[?x ?y] '(1 2))))
  (is (some? (match? '{:a ?x} '{:a 7})))
  (is (nil? (match? '{:a ?x} '{:b 7})))
  (is (some? (match? '() '()))))

; --- subst ---

(deftest subst-core
  (is (= (subst '{?x 1} '(+ ?x ?x)) '(+ 1 1)))
  ; a binding whose value is itself a form splices in whole
  (is (= (subst '{?x (f 1)} '(g ?x)) '(g (f 1))))
  ; unbound variables are left alone, not silently dropped
  (is (= (subst '{?x 1} '(= ?x ?y)) '(= 1 ?y))))

; --- defrule / apply-rule ---

(defrule nil-eq (= ?x nil) (nil? ?x))

(deftest apply-rule-core
  (is (= (apply-rule nil-eq '(= y nil)) '(nil? y)))
  ; no match → the form is returned unchanged
  (is (= (apply-rule nil-eq '(= y 5)) '(= y 5))))

; --- a multi-rule ruleset, as an ordinary collection ---

(defrule if-nil (if ?p ?x nil) (when ?p ?x))

(deftest apply-rules-core
  ; nil-eq rewrites the inner (= a nil) first (postwalk), then if-nil
  ; matches the now-modern outer form in the same pass.
  (is (= (apply-rules (list nil-eq if-nil) '(if (= a nil) 1 nil))
         '(when (nil? a) 1)))
  ; two passes' worth of nesting still converges to a fixed point
  (is (= (apply-rules (list nil-eq if-nil)
                      '(if (= a nil) (if b nil nil) nil))
         '(when (nil? a) (when b nil)))))

; --- the non-termination guard: a cycle must raise, not hang ---

(defrule flip-a (foo ?x) (bar ?x))
(defrule flip-b (bar ?x) (foo ?x))

(deftest non-termination-guard
  ; two rules that undo each other flip the form forever; the cap trips
  (is (= (try (apply-rules (list flip-a flip-b) '(foo 1) 50) :silent
              (catch e :raised))
         :raised))
  ; and the error names the cycle, not some unrelated failure
  (is (= (try (apply-rules (list flip-a flip-b) '(foo 1) 5) :silent
              (catch e (get (ex-data e) :non-terminating nil)))
         true))
  ; a terminating rule set under the same small cap is unaffected
  (is (= (apply-rules (list nil-eq) '(= a nil) 5) '(nil? a))))
