(ns application.package-sdk-test (:require [application.package :as package]))
(defn refused? [action] (try (action) false (catch _ true)))
(deftest application-packages-keep-sdk-json-at-its-authenticated-provider
 (let [root (str (System/tmp_dir!) "/package-sdk-json-" (erlang/unique_integer (list :positive)))
       source (str root "/src") output (str root "/release") entry (str root "/main.bl")
       program "(ns package.sdk-entry (:require [package.sdk-leaf]))"]
  (try
   (File/mkdir_p! (str source "/package"))
   (File/write! entry program)
   (File/write! (str source "/package/sdk-leaf.bl")
    "(ns package.sdk-leaf (:require [bl.json :as json])) (defn encode [value] (json/encode value))")
   (BeamLisp.Loader/with_ambient_dirs (list source)
    (fn []
     (let [built (package/build! entry output []) manifest (package/verify! output)]
      (is (= ["package.sdk-leaf"] (:namespaces manifest)))
      (is (= ["package.sdk-leaf"] (:artifacts manifest)))
      (is (contains? (:sdk-sources manifest) "bl.json"))
      (is (contains? (:sdk-sources manifest) "bl.json-native"))
      (is (not (File/exists? (str output "/source/bl/json.bl"))))
      (is (not (File/exists? (str output "/source/bl/json_native.bl"))))
      (is (map? (:sdk (:runtime manifest))))
      (package/install! output program [])
      (package/with-source-root (str output "/source")
       (fn []
        (BeamLisp.Loader/ensure_loaded "package.sdk-leaf")
        (is (= "{\"answer\":42}"
             (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! "package.sdk-leaf" "encode") (list {"answer" 42}))))))
      ;; A local replacement is not authorized by matching the SDK name.
      (File/mkdir_p! (str source "/bl"))
      (File/write! (str source "/bl/json.bl") "(ns bl.json) (defn encode [value] \"replacement\")")
      (is (refused? (fn [] (package/verify! output)))))))
   (finally (File/rm_rf! root)))))
