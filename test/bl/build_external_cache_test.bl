(ns build.external-cache-test (:require [build :as build] [build-log :as log]))

(deftest external-interface-invalidates-without-taking-build-ownership
  (let [root (str (System/tmp_dir!) "/external-build-cache-" (System/unique_integer (list :positive)))
        source (str root "/cache-owned.bl") dependency (str root "/cache-external.bl")
        out (str root "/ebin")
        previous-dir (System/get_env "BEAM_LISP_AOT_CACHE_DIR")
        previous-enabled (System/get_env "BEAM_LISP_AOT_CACHE")
        run (fn [] (BeamLisp.Loader/with_load_path root
                     (fn [] (build/run {:sources [source] :out out :jobs 1}))))
        facts (fn [] (filter #(= :build/built (first %))
                       (log/read-facts (log/path-for (build/manifest-path out)))))]
    (File/mkdir_p! root)
    (System/put_env "BEAM_LISP_AOT_CACHE_DIR" (str root "/cache"))
    (System/put_env "BEAM_LISP_AOT_CACHE" "on")
    (try
      (File/write! dependency "(ns cache-external)\n(defn value [] 41)")
      (File/write! source "(ns cache-owned (:require [cache-external :as external]))\n(defn value [] (external/value))")
      (let [cold (run) old-key (:hash (get (:manifest cold) source))]
        (is (= [] (:errors cold)))
        (is (= #{source} (set (keys (:manifest cold)))))
        (File/rm_rf! out)
        (is (= [] (:errors (run))))
        (is (= true (nth (first (facts)) 5)))
        (File/write! dependency "(ns cache-external)\n(defn value [] 41)\n(defn another [x] x)")
        (File/rm_rf! out)
        (let [changed (run)]
          (is (= [] (:errors changed)))
          (is (= #{source} (set (keys (:manifest changed)))))
          (is (not= old-key (:hash (get (:manifest changed) source))))
          (is (= false (nth (first (facts)) 5))))
        (File/rm_rf! out)
        (is (= [] (:errors (run))))
        (is (= true (nth (first (facts)) 5))))
      (finally
        (if previous-dir (System/put_env "BEAM_LISP_AOT_CACHE_DIR" previous-dir) (System/delete_env "BEAM_LISP_AOT_CACHE_DIR"))
        (if previous-enabled (System/put_env "BEAM_LISP_AOT_CACHE" previous-enabled) (System/delete_env "BEAM_LISP_AOT_CACHE"))
        (File/rm_rf! root)))))
