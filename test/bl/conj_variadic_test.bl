; conj_variadic_test.bl — `conj` and `disj` take many items, as in Clojure.
;
; `(conj coll x & xs)` adds each item in order, exactly as repeated `conj`;
; `(disj set k & ks)` removes each. Before this, a 3-argument `conj` raised
; "a fn called with 3 arguments — a fn of 1/2 arguments", which pushed callers
; to `into` or nested `conj` for the ordinary Clojure spelling.
;
; `conj`/`disj` are kernel primitives (priv/boot/rt.bl seed rows), so this is
; verified in an ordinary VM only after the floor is regenerated.
;
; Run: bl test test/bl/conj_variadic_test.bl

(ns conj-variadic-test)

(deftest conj-many-onto-a-vector-appends-in-order
  (is (= [1 2 3 4] (conj [1] 2 3 4)))
  (is (= [[:put 1] [:delete 2]] (conj [] [:put 1] [:delete 2]))))

(deftest conj-many-onto-a-list-prepends-each
  (is (= '(4 3 2 1) (conj '(1) 2 3 4))))

(deftest conj-many-onto-a-set-and-a-map
  (is (= #{1 2 3} (conj #{1} 2 3 2)))
  (is (= {:a 1 :b 2 :c 3} (conj {:a 1} [:b 2] [:c 3]))))

(deftest conj-many-onto-nil-is-a-list
  (is (= '(3 2 1) (conj nil 1 2 3))))

(deftest conj-variadic-is-a-value-too
  ; passed as a function value and applied, the variadic arity still holds
  (is (= [1 2 3] (apply conj [1] [2 3])))
  (is (= [[0 1 2] [9 1 2]] (mapv (fn [v] (conj [v] 1 2)) [0 9]))))

(deftest disj-many
  (is (= #{1} (disj #{1 2 3} 2 3)))
  (is (= #{1 2} (disj #{1 2} 9 8)))
  (is (= #{1 2} (disj #{1 2}))))
