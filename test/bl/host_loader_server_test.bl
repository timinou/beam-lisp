; test/bl/host_loader_server_test.bl — the pinned `BeamLisp.Loader.Server`.
;
; `priv/host/loader_server.bl` ports `lib/beam_lisp/loader_server.ex` to ONE
; exact-named beam, `Elixir.BeamLisp.Loader.Server` — the OTP application child
; `env.bl`'s supervisor starts beside `BeamLisp.Env`, BEFORE `BeamLisp.init/0`
; interns one var. That is why the port has to be RIGHT before it is ever wired
; into the seed. This suite pins it four ways:
;
;   * SURFACE — the pinned probe's exports, its `-behaviour` attribute and its
;     callback coverage, diffed against `Elixir.BeamLisp.Loader.Server` AND
;     against `GenServer`'s own `behaviour_info/1`. The migrated module and its
;     probe both lack the Elixir-generated `__info__/1`; every callback the live
;     module exports — including the four DEFAULT implementations
;     `use GenServer` generates, which the live SOURCE never spells out — must
;     be present, because the export surface IS the contract a port has to
;     reproduce.
;
;   * DIFFERENTIAL — the same source compiled at a PROBE atom and asked the
;     same questions as the live module, value for value: `child_spec/1`'s map,
;     `init/1`, `in_server?/0`, the three `handle_call/3` reply shapes, the
;     clause errors, `handle_cast/2`'s raise, `handle_info/2`, `terminate/2`
;     and `code_change/3`. The probe is a SEPARATE REGISTERED NAME, so nothing
;     here touches the live application's supervised loader — the one thing
;     this suite must not damage: that process is RUNNING, and `code:purge/1`
;     on its module would kill it.
;
;   * THE RACE AND THE LIFECYCLE — `run/1`'s `ensure_started` path, exercised by
;     many processes at once against a server that is not yet up, and the inline
;     nested run that a self-call would deadlock on.
;
;   * THE BOOT — a fresh CHILD VM whose code path resolves
;     `BeamLisp.Loader.Server` to the pinned beam starts the application ON it:
;     same supervisor, same two children, the pinned module IS the supervised
;     child, `BeamLisp.init/0` ran after them, nested runs are inline, an
;     exception crosses with its original raise site and the server survives, a
;     `:throw` stays a `:throw`, a stray message is logged by the generated
;     `handle_info/2`, and an exit takes the child down — which the supervisor
;     restarts. The child is not tidiness: an exit is SUPPOSED to take the
;     server down, and asking that question in this VM would take down the live
;     loader the whole suite is running on.
;
; A pinned beam has no `__info__/1` (only Elixir's compiler generates it).
; `compile_host_file` records the behaviour module as a bare atom rather than
; the one-element list generated by `@behaviour`; OTP dispatches on the callback
; exports, not on either representation of this metadata.
;
; Run: bin/bl test test/bl/host_loader_server_test.bl

(ns host.loader-server.test)

(defn- t2 [k v] (erlang/list_to_tuple (list k v)))

(defn- tmp-dir []
  (str (System/tmp_dir!) "/bl_host_loader_server_" (erlang/unique_integer (list :positive))))

(defn- src [] (Path/join (BeamLisp/cwd) "priv/host/loader_server.bl"))

(def ^:private probe :Elixir.BeamLisp.HostLoaderServerProbe)
(def ^:private shim :Elixir.BeamLisp.Ns.Host.Loader-server)
(def ^:private live :Elixir.BeamLisp.Loader.Server)
(def ^:private behaviour-mod :Elixir.GenServer)

(defn- drop! [mod]
  (do (code/purge mod) (code/delete mod) :ok))

(defn- load-beam! [mod path]
  (drop! mod)
  (code/load_binary mod (erlang/binary_to_list path) (File/read! path))
  mod)

; Compile the pinned source at `mod` and publish ONLY the pinned beam: the
; compile's own load (and the namespace shim it built beside it) is dropped.
;
; Any process ALREADY REGISTERED under `mod` is unlinked FIRST. `run/1` starts
; the probe with `start_link/1`, so the server is linked to whichever test
; started it; purging the module out from under a linked server would take this
; process down with it if the purge ever caught it mid-callback. Unlinking
; costs nothing and removes the hazard entirely.
(defn- compile-pinned [mod dir]
  (let [p (Process/whereis mod)]
    (if (erlang/is_pid p) (Process/unlink p) nil))
  (let [res (BeamLisp.AOT/compile_host_file (src)
              (list (t2 :module mod) (t2 :output_dir dir) (t2 :load? false)
                    (t2 :behaviour behaviour-mod)))]
    (load-beam! mod (elem res 1))
    (drop! shim)
    mod))

(defn- exports [mod]
  (Enum/sort (erlang/apply mod :module_info (list :exports))))

; What a pinned beam's surface is measured against: `__info__/1` is generated
; by the Elixir compiler for every Elixir module and is NOT part of the ABI a
; pinned (functions-only) port carries.
(defn- functional-exports [mod]
  (Enum/sort (filter (fn [e] (not (erlang/== :__info__ (elem e 0)))) (exports mod))))

(defn- behaviour-attr
  "The `-behaviour` attribute's value for `mod`, normalized to a LIST: Elixir
   collects them (`[GenServer]`), a pinned host records the bare atom
   (`GenServer`). `nil` when the module carries no such attribute."
  [mod]
  (let [v (first (map (fn [a] (elem a 1))
                      (filter (fn [a] (erlang/== :behaviour (elem a 0)))
                              (erlang/apply mod :module_info (list :attributes)))))]
    (cond
      (nil? v) nil
      (erlang/is_list v) v
      :else (list v))))

(defn- behaviour-info [key]
  (erlang/apply behaviour-mod :behaviour_info (list key)))

(defn- optional-callbacks [] (Enum/sort (behaviour-info :optional_callbacks)))

(defn- required-callbacks
  "The behaviour's `:callbacks` minus its `:optional_callbacks` — asked of OTP
   rather than written down twice."
  []
  (let [opt (optional-callbacks)]
    (Enum/sort (filter (fn [c] (not (some (fn [o] (erlang/== o c)) opt)))
                       (behaviour-info :callbacks)))))

(defn- exported? [mod c] (erlang/function_exported mod (elem c 0) (elem c 1)))

(defn- grab
  "Run `f`, answering what it threw/raised/returned — the BL fold of a catch:
   an `:error` is normalized into its exception struct, an `:exit` into
   `{:exit, v}`, and a `:throw` stays the value."
  [f]
  (try (f) (catch e e)))

(defn- stack-of [f]
  (try (f) (catch _e __STACKTRACE__)))

(defn- child-spec-shape
  "A `child_spec/1` answer as the fields a differential can compare across two
   module atoms: the id names the module compiled into, the start names the same
   module with `:start_link` and the OTP-supplied argument, and the key set is
   exactly `use GenServer`'s. `[id-is-atom, start-names-id, start-mfa, args,
   keys]`."
  [spec]
  (let [id (maps/get :id spec nil)
        start (maps/get :start spec nil)]
    [(erlang/is_atom id)
     (erlang/== id (erlang/element 1 start))
     (erlang/== :start_link (erlang/element 2 start))
     (erlang/element 3 start)
     (Enum/sort (maps/keys spec))]))

(defn- clause-shape
  "A `FunctionClauseError`'s function/arity — what two modules' clause errors
   agree on; the module field is the module name, by definition."
  [e]
  [(maps/get :__struct__ e nil) (maps/get :function e nil) (maps/get :arity e nil)])

(defn- capture-info-log
  "Call `handle_info/2` on `mod` and answer `{return, event}` — where `event`
   is the logger event the generated callback emitted, captured by a PRIMARY
   `:logger` filter that forwards it to this process and answers `:ignore`
   (which leaves the event's own journey to the handlers untouched). A ref
   carried as the filter's `Extra` scopes the catch to THIS call, and the
   filter is removed again immediately — including on the raise path."
  [mod]
  (let [pid (erlang/self)
        ref (erlang/make_ref)
        f (fn [event extra] (erlang/send pid (tuple extra event)) :ignore)]
    (erlang/apply :logger :add_primary_filter (list :bl_hls_capture (tuple f ref)))
    (let [ret (try
                (erlang/apply mod :handle_info (list :stray :state))
                (finally (erlang/apply :logger :remove_primary_filter (list :bl_hls_capture))))]
      (tuple ret
             (receive [r event] :when (= r ref) event
               (after 2000 nil))))))

(defn- info-log-shape
  "A `handle_info/2` log event as the fields a differential can compare across
   two module atoms: the level, the report's `label` and its whole `report` map
   with `module` normalised, the metadata's `domain` and `error_logger`, and the
   `report_cb`'s IDENTITY — module, name and arity — because the live callback
   ships `&GenServer.format_report/1`, not a look-alike closure."
  [event]
  (let [msg (maps/get :msg event nil)
        report (if (erlang/is_tuple msg) (erlang/element 2 msg) nil)
        meta (maps/get :meta event nil)
        cb (maps/get :report_cb meta nil)]
    [(maps/get :level event nil)
     (if (erlang/is_tuple msg) (erlang/element 1 msg) nil)
     (maps/get :label report nil)
     (maps/put :module :any (maps/get :report report nil))
     (maps/get :domain meta nil)
     (maps/get :error_logger meta nil)
     (erlang/apply :erlang :fun_info (list cb :module))
     (erlang/apply :erlang :fun_info (list cb :name))
     (erlang/apply :erlang :fun_info (list cb :arity))]))

; ── lifecycle of the PROBE server, which is never the live one ─────────────
;
; `start_link/1` links the server to whichever process won `ensure_started`, so
; the probe is UNLINKED the moment `run/1` has started it (below): a later
; recompile purges the probe module, and an unlinked probe cannot take the test
; process with it.

(defn- stop-probe! []
  (let [p (Process/whereis probe)]
    (if (erlang/is_pid p)
      (do (Process/unlink p)
          (Process/exit p :kill)
          (Process/sleep 20)
          :ok)
      :ok)))

; ── the surface: what the callback module exports, and what it must not ───

(deftest loader-server-pinned-surface-is-the-live-module
  (testing "exports, behaviour attribute and callback coverage, against the live module and the behaviour"
    (let [dir (tmp-dir)]
      (compile-pinned probe dir)
      ; NO SHIM: the compile's namespace shim is gone; the pinned beam answers.
      (is (= :non_existing (erlang/apply :code :which (list shim))))

      ; The production module this port stands in for is loaded — the
      ; precondition the diff below is meaningful under.
      (is (erlang/function_exported live :run 1) "the production loader server is loaded")
      (is (erlang/function_exported live :handle_call 3))

      ; Every production export remains present at the probe atom, and the
      ; pinned surface equals the live module's minus `__info__/1`.
      (is (= () (filter (fn [e] (not (exported? probe e))) (functional-exports live)))
          "all production exports are reproduced")
      (is (= (functional-exports live) (exports probe))
          "the pinned export surface equals the live module's minus __info__/1")

      ; THE GENERATED DEFAULTS ARE PRESENT. `use GenServer` writes default
      ; implementations of every OPTIONAL callback into the live module, which
      ; is why the live source — four functions long — exports ten. A port that
      ; shipped only the four hand-written ones would have a SMALLER ABI than
      ; the module it stands in for.
      (is (erlang/function_exported probe :handle_call 3))
      (is (erlang/function_exported probe :handle_cast 2))
      (is (erlang/function_exported probe :handle_info 2))
      (is (erlang/function_exported probe :terminate 2))
      (is (erlang/function_exported probe :code_change 3))
      (is (erlang/function_exported probe :child_spec 1))
      (is (erlang/function_exported probe :start_link 1))
      (is (erlang/function_exported probe :init 1))

      ; A pinned module is functions-only: no synthesized struct pair either.
      (is (not (erlang/function_exported probe :__struct__ 0)))
      (is (not (erlang/function_exported probe :__struct__ 1)))

      ; THE BEHAVIOUR ATTRIBUTE. `use GenServer` records `-behaviour GenServer`;
      ; `compile_host_file`'s `:behaviour` option records the same module, so
      ; the emitted beam is judgeable as a GenServer exactly as the live one is.
      (is (= (list behaviour-mod) (behaviour-attr probe)))
      (is (= (behaviour-attr live) (behaviour-attr probe)))

      ; THE CALLBACK CONTRACT, asked of the behaviour rather than guessed: the
      ; required callbacks (`init/1`) and the optional ones are all exported by
      ; BOTH modules. `format_status/2` is an optional callback NEITHER module
      ; defines, so it must stay undefined on both.
      (is (= (list (tuple :init 1)) (required-callbacks)))
      (is (every? (fn [c] (exported? probe c)) (required-callbacks)))
      (is (every? (fn [c] (exported? live c)) (required-callbacks)))
      (is (some (fn [c] (erlang/== c (tuple :handle_call 3))) (optional-callbacks)))
      (is (= () (filter (fn [c] (contains? (optional-callbacks) c))
                        (list (tuple :format_status 2)))))
      (doseq [c (optional-callbacks)]
        (is (= (exported? live c) (exported? probe c))
            (str "optional callback " (pr-str c) " agrees with the live module")))

      ; REPRODUCIBLE: the same source compiled again is the same bytes. The
      ; seed records a sha256 per host beam and `seed/check` re-derives it, so a
      ; non-deterministic emitter would make the committed floor unverifiable.
      (let [again (tmp-dir)
            again-beam (elem (BeamLisp.AOT/compile_host_file (src)
                                 (list (t2 :module probe) (t2 :output_dir again)
                                       (t2 :load? false) (t2 :behaviour behaviour-mod)))
                           1)]
        (is (= (File/read! (Path/join dir "Elixir.BeamLisp.HostLoaderServerProbe.beam"))
               (File/read! again-beam))
            "a rebuild of priv/host/loader_server.bl is the same beam")
        (File/rm_rf! again))

      (File/rm_rf! dir))))

; ── child_spec/1: the map the application supervisor starts the child from ─

(deftest loader-server-pinned-child-spec-is-the-generated-one
  (testing "the pinned child_spec/1 answers the shape `use GenServer` generates, at the OTP argument"
    (let [dir (tmp-dir)]
      (compile-pinned probe dir)
      (doseq [arg (list (list) :ok nil 42 :anything)]
        (is (= (child-spec-shape (erlang/apply live :child_spec (list arg)))
               (child-spec-shape (erlang/apply probe :child_spec (list arg))))
            (str "child_spec/1 vs the live module, argument " (pr-str arg))))
      ; The application supervisor passes the MODULE ATOM in its child list, and
      ; OTP asks that atom for `child_spec([])`: the id must be the module and
      ; the start argument `[]`, or the child's identity is not the live
      ; module's. (A `children` start tuple holds RAW lists, so these compare
      ; against `(list)`/`(list :ok)`, never against a beam-lisp vector.)
      (is (= (list (list)) (nth (child-spec-shape (erlang/apply probe :child_spec (list (list)))) 3)))
      (is (= (list :ok) (nth (child-spec-shape (erlang/apply probe :child_spec (list :ok))) 3)))
      (File/rm_rf! dir))))

; ── init/1, in_server?/0 and the run/1 round trip ─────────────────────────

(deftest loader-server-pinned-init-and-flag
  (testing "init/1, in_server?/0, the flag's lifetime and the clause error"
    (let [dir (tmp-dir)]
      (compile-pinned probe dir)
      (is (= (erlang/apply live :init (list :ok)) (erlang/apply probe :init (list :ok))))
      (is (= (tuple :ok (maps/new)) (erlang/apply probe :init (list :ok))))
      ; The live clause head is `init(:ok)`; anything else is the BEAM's
      ; FunctionClauseError, and the port raises the same one by hand.
      (is (= (clause-shape (grab (fn [] (erlang/apply live :init (list :bad)))))
             (clause-shape (grab (fn [] (erlang/apply probe :init (list :bad)))))))
      ; NO PROCESS HAS THE FLAG HERE, and neither module's `in_server?/0` may
      ; say otherwise. `run/1`'s inline branch is keyed on it, so a port that
      ; answered `true` outside the server would run library loads in whatever
      ; process asked.
      (is (= false (erlang/apply live :in_server? (list))))
      (is (= false (erlang/apply probe :in_server? (list))))
      (is (= (erlang/apply live :in_server? (list)) (erlang/apply probe :in_server? (list))))
      (File/rm_rf! dir))))

(deftest loader-server-pinned-run-is-inline-when-already-inside
  (testing "run/1 executes the thunk in ONE server process, and a nested run does not self-call"
    (let [dir (tmp-dir)
          ; A LOCAL capture of the probe atom. A thunk handed to `run/1` runs in
          ; the SERVER process, whose env is not this file's — only a local a
          ; closure captured crosses that boundary (the same holds for
          ; `erlang/spawn`). A bare reference to the top-level `probe` resolves
          ; to `undefined var` there.
          px probe]
      (compile-pinned px dir)
      (stop-probe!)
      ; The first `run/1` starts the server (its `ensure_started` path); every
      ; thunk then executes in that process — one pid, never the caller's.
      (let [caller (erlang/self)
            server (erlang/apply px :run (list (fn [] (erlang/self))))]
        (is (erlang/is_pid server))
        (is (not (erlang/== caller server)) "the thunk did not run in the caller")
        (is (= 41 (erlang/apply px :run (list (fn [] 41)))))
        ; INLINE: the nested run is on the server's own process dictionary, so
        ; it runs in place. A `GenServer.call` to oneself would block until the
        ; `:infinity` timeout — this assertion is the anti-deadlock proof.
        (let [nested (erlang/apply px :run
                       (list (fn [] [(erlang/self)
                                     (erlang/apply px :in_server? (list))
                                     (erlang/apply px :run (list (fn [] (erlang/self))))])))]
          (is (erlang/== server (nth nested 0)))
          (is (erlang/== true (nth nested 1)) "in_server? is true INSIDE the server")
          (is (erlang/== server (nth nested 2)) "the nested run ran in the same process"))
        ; ...and the flag is the CALLING process's, so it is gone again here.
        (is (= false (erlang/apply px :in_server? (list))))
        (is (nil? (Process/get :bl_in_loader_server))))
      (File/rm_rf! dir))))

(deftest loader-server-pinned-run-classifies-what-crosses-back
  (testing "value, exception with its ORIGINAL stacktrace, and throw — against the live module"
    (let [dir (tmp-dir)
          thunk (fn [] (erlang/apply :erlang :error (list (Elixir.RuntimeError/exception "boom"))))
          thrown (fn [] (erlang/apply :erlang :throw (list (tuple :tag :v))))]
      (compile-pinned probe dir)
      (stop-probe!)
      ; A VALUE is the value, from either server.
      (is (= :fine (erlang/apply live :run (list (fn [] :fine)))))
      (is (= :fine (erlang/apply probe :run (list (fn [] :fine)))))
      ; AN EXCEPTION crosses as itself, from either server.
      (is (= (grab (fn [] (erlang/apply live :run (list thunk))))
             (grab (fn [] (erlang/apply probe :run (list thunk))))))
      (is (erlang/== :"Elixir.RuntimeError"
                     (maps/get :__struct__ (grab (fn [] (erlang/apply probe :run (list thunk)))) nil)))
      ; ...carrying the ORIGINAL stacktrace: the raise site is the thunk's own
      ; frame, byte for byte what raising the thunk directly produces — not the
      ; server's `handle_call`, which is where the exception was CAUGHT.
      (let [direct (Enum/take (stack-of thunk) 1)
            via-live (Enum/take (stack-of (fn [] (erlang/apply live :run (list thunk)))) 1)
            via-probe (Enum/take (stack-of (fn [] (erlang/apply probe :run (list thunk)))) 1)]
        (is (= direct via-live) "the live server preserves the original stacktrace")
        (is (= direct via-probe) "the pinned server preserves the original stacktrace"))
      ; A THROW stays a THROW: the BL fold keeps a `:throw`'s value raw, so a
      ; value that is not an exception struct and not an `{:exit, v}` pair is
      ; re-thrown, and the caller's catch sees the thrown value — not an
      ; `%ErlangError{}`, which is what an `:error` of the same value normalizes
      ; to.
      (is (= (tuple :tag :v) (grab (fn [] (erlang/apply live :run (list thrown))))))
      (is (= (tuple :tag :v) (grab (fn [] (erlang/apply probe :run (list thrown))))))
      (is (erlang/is_map (grab (fn [] (erlang/apply probe :run
                                       (list (fn [] (erlang/apply :erlang :error (list (tuple :tag :v))))))))))
      ; THE SERVER SURVIVES both: it is still the same process and still answers.
      (is (= :alive (erlang/apply probe :run (list (fn [] :alive)))))
      ; A non-zero-arity argument is the live guard's FunctionClauseError.
      (is (= (clause-shape (grab (fn [] (erlang/apply live :run (list :not-a-fun)))))
             (clause-shape (grab (fn [] (erlang/apply probe :run (list :not-a-fun)))))))
      (File/rm_rf! dir))))

; ── handle_call/3: the three reply shapes, the exit, the flag and the head ─

(deftest loader-server-pinned-handle-call-replies
  (testing "handle_call/3's replies are the live module's, and the flag is cleared on every path"
    (let [dir (tmp-dir)
          thunk (fn [] (erlang/apply :erlang :error (list (Elixir.RuntimeError/exception "boom"))))
          thrown (fn [] (erlang/apply :erlang :throw (list (tuple :tag :v))))
          exited (fn [] (erlang/apply :erlang :exit (list :boom)))]
      (compile-pinned probe dir)
      (is (= (erlang/apply live :handle_call (list (tuple :run (fn [] :fine)) :from :state))
             (erlang/apply probe :handle_call (list (tuple :run (fn [] :fine)) :from :state))))
      (is (= (tuple :reply (tuple :ok :fine) :state)
             (erlang/apply probe :handle_call (list (tuple :run (fn [] :fine)) :from :state))))
      ; The flag is set for the thunk's duration and deleted after it — checked
      ; FROM INSIDE, which is the only place it is visible.
      (is (= true (erlang/element 2 (erlang/element 2
                     (erlang/apply probe :handle_call
                       (list (tuple :run (fn [] (Process/get :bl_in_loader_server))) :from :state))))))
      (is (nil? (Process/get :bl_in_loader_server)) "the flag is cleared after a value")
      ; RAISED: the exception and its stacktrace, exactly as the live server
      ; reports them.
      (let [live-r (erlang/apply live :handle_call (list (tuple :run thunk) :from :state))
            probe-r (erlang/apply probe :handle_call (list (tuple :run thunk) :from :state))
            live-inner (erlang/element 2 live-r)
            probe-inner (erlang/element 2 probe-r)]
        (is (erlang/== :reply (erlang/element 1 live-r)))
        (is (erlang/== :reply (erlang/element 1 probe-r)))
        (is (erlang/== :raised (erlang/element 1 live-inner)))
        (is (erlang/== :raised (erlang/element 1 probe-inner)))
        (is (= (erlang/element 2 live-inner) (erlang/element 2 probe-inner))
            "the same exception struct crosses either server")
        (is (= (Enum/take (erlang/element 3 live-inner) 1) (Enum/take (erlang/element 3 probe-inner) 1))
            "the raise site is the thunk's own frame in either server")
        (is (= :state (erlang/element 3 probe-r))))
      (is (nil? (Process/get :bl_in_loader_server)) "the flag is cleared after a raise")
      ; A `{:run, fun}` whose second element is NOT a function is the
      ; BadFunctionError the live `fun.()` raises — the head matched, the CALL
      ; failed — not a clause error, and it is reported as a raise.
      (let [live-b (erlang/apply live :handle_call (list (tuple :run :not-a-fun) :from :state))
            probe-b (erlang/apply probe :handle_call (list (tuple :run :not-a-fun) :from :state))]
        (is (erlang/== :raised (erlang/element 1 (erlang/element 2 probe-b))))
        (is (= (erlang/element 2 (erlang/element 2 live-b))
               (erlang/element 2 (erlang/element 2 probe-b)))
            "the same BadFunctionError crosses either server"))
      (is (nil? (Process/get :bl_in_loader_server)) "the flag is cleared after a bad function")
      ; THROWN: the raw value, both modules.
      (is (= (erlang/apply live :handle_call (list (tuple :run thrown) :from :state))
             (erlang/apply probe :handle_call (list (tuple :run thrown) :from :state))))
      (is (= (tuple :reply (tuple :thrown (tuple :tag :v)) :state)
             (erlang/apply probe :handle_call (list (tuple :run thrown) :from :state))))
      (is (nil? (Process/get :bl_in_loader_server)) "the flag is cleared after a throw")
      ; EXIT: neither live `rescue` nor live `catch :throw` catches one, so the
      ; exit leaves `handle_call` — and the port re-raises it as an EXIT rather
      ; than folding it into a reply. The fold is the reason it can: an exit
      ; arrives as `{:exit, v}`, and re-raising is `:erlang.raise(:exit, v, …)`.
      (is (= (tuple :exit :boom) (grab (fn [] (erlang/apply live :handle_call (list (tuple :run exited) :from :state))))))
      (is (= (tuple :exit :boom) (grab (fn [] (erlang/apply probe :handle_call (list (tuple :run exited) :from :state))))))
      (is (nil? (Process/get :bl_in_loader_server)) "the flag is cleared after an exit")
      ; THE CLAUSE HEAD IS `{:run, fun}` AND NOTHING ELSE.
      (is (= (clause-shape (grab (fn [] (erlang/apply live :handle_call (list :bogus :from :state)))))
             (clause-shape (grab (fn [] (erlang/apply probe :handle_call (list :bogus :from :state)))))))
      (is (= (clause-shape (grab (fn [] (erlang/apply probe :handle_call (list (tuple :run) :from :state)))))
             (clause-shape (grab (fn [] (erlang/apply probe :handle_call (list :bogus :from :state)))))))
      (File/rm_rf! dir))))

; ── the raw-kind corners the fold cannot see ───────────────────────────────

(deftest loader-server-pinned-raw-kind-corners
  (testing "a raw throw of a struct and of an {:exit, v} pair keep their class, live and pinned"
    (let [dir (tmp-dir)
          struct (fn [] (erlang/apply :erlang :throw (list (Elixir.RuntimeError/exception "raw"))))
          pair (fn [] (erlang/apply :erlang :throw (list (erlang/list_to_tuple (list :exit 7)))))
          raised (fn [] (erlang/apply :erlang :error (list (Elixir.RuntimeError/exception "raised"))))
          exited (fn [] (erlang/apply :erlang :exit (list :boom)))]
      (compile-pinned probe dir)
      (stop-probe!)
      ; THE REPLY TAG IS THE DIFFERENTIAL. The folded `e` is identical for a
      ; raw throw and a raise of the same struct, and identical for a thrown
      ; `{:exit, v}` pair and a real exit — so only the CLASS tells them apart.
      ; `__EXCEPTION_KIND__` is that class: a raw throw answers `{:thrown, v}`
      ; even when `v` is a struct or an `{:exit, v}` pair, which the old
      ; shape-guess reported as `{:raised, …}` / an exit.
      (is (= (erlang/apply live :handle_call (list (tuple :run struct) :from :state))
             (erlang/apply probe :handle_call (list (tuple :run struct) :from :state))))
      (is (erlang/== :thrown (erlang/element 1 (erlang/element 2
                     (erlang/apply probe :handle_call (list (tuple :run struct) :from :state))))))
      (is (= (erlang/apply live :handle_call (list (tuple :run pair) :from :state))
             (erlang/apply probe :handle_call (list (tuple :run pair) :from :state))))
      (is (erlang/== :thrown (erlang/element 1 (erlang/element 2
                     (erlang/apply probe :handle_call (list (tuple :run pair) :from :state))))))
      ; a genuine raise of the SAME struct is still `{:raised, …}` with the
      ; exception and its stacktrace, live and pinned alike.
      (let [li (erlang/element 2 (erlang/apply live :handle_call (list (tuple :run raised) :from :state)))
            pi (erlang/element 2 (erlang/apply probe :handle_call (list (tuple :run raised) :from :state)))]
        (is (erlang/== :raised (erlang/element 1 li)))
        (is (erlang/== :raised (erlang/element 1 pi)))
        (is (= (erlang/element 2 li) (erlang/element 2 pi)))
        (is (= (Enum/take (erlang/element 3 li) 1) (Enum/take (erlang/element 3 pi) 1))))
      ; a genuine exit still leaves `handle_call` as an exit, live and pinned.
      (is (= (grab (fn [] (erlang/apply live :handle_call (list (tuple :run exited) :from :state))))
             (grab (fn [] (erlang/apply probe :handle_call (list (tuple :run exited) :from :state))))))
      (File/rm_rf! dir))))

; ── the rest of the generated surface: cast, info, terminate, code_change ──

(deftest loader-server-pinned-generated-callbacks
  (testing "the four defaults `use GenServer` writes answer as the live module's do"
    (let [dir (tmp-dir)]
      (compile-pinned probe dir)
      ; handle_cast/2: `:erlang.phash2(1, 1)` is always 0, so the reachable
      ; branch raises the macro's RuntimeError — message, registered-name
      ; fallback and all.
      (let [live-e (grab (fn [] (erlang/apply live :handle_cast (list :msg :state))))
            probe-e (grab (fn [] (erlang/apply probe :handle_cast (list :msg :state))))]
        (is (erlang/== :"Elixir.RuntimeError" (maps/get :__struct__ probe-e nil)))
        (is (= live-e probe-e) "handle_cast/2 raises the live module's RuntimeError"))
      (is (= (erlang/apply live :terminate (list :normal :state))
             (erlang/apply probe :terminate (list :normal :state))))
      (is (= :ok (erlang/apply probe :terminate (list :normal :state))))
      (is (= (erlang/apply live :code_change (list :old :state :extra))
             (erlang/apply probe :code_change (list :old :state :extra))))
      (is (= (tuple :ok :state) (erlang/apply probe :code_change (list :old :state :extra))))
      ; handle_info/2 logs the stray message and answers `{:noreply, state}`.
      ; The EVENT is compared, not just the answer: the level, the label, the
      ; report (its `message` and `name`, with the module atom normalised) and
      ; the `report_cb`'s identity all have to agree, or a handler downstream
      ; of this port would render something the live module never logged.
      (is (= (erlang/apply live :handle_info (list :stray :state))
             (erlang/apply probe :handle_info (list :stray :state))))
      (is (= (tuple :noreply :state) (erlang/apply probe :handle_info (list :stray :state))))
      (let [live-cap (capture-info-log live)
            probe-cap (capture-info-log probe)
            probe-event (erlang/element 2 probe-cap)]
        (is (erlang/== :noreply (erlang/element 1 (erlang/element 1 probe-cap))))
        (is (erlang/is_map probe-event) "the pinned callback logged an event")
        (is (erlang/== :error (maps/get :level probe-event nil)))
        (is (erlang/== :report (erlang/element 1 (maps/get :msg probe-event nil))))
        (is (erlang/== (tuple :Elixir.GenServer :no_handle_info)
                       (maps/get :label (erlang/element 2 (maps/get :msg probe-event nil)) nil)))
        (is (erlang/== (list :otp :elixir) (maps/get :domain (maps/get :meta probe-event nil) nil)))
        (is (= (info-log-shape (erlang/element 2 live-cap))
               (info-log-shape probe-event))
            "the logged event is the live module's, report_cb identity included"))
      (File/rm_rf! dir))))

; ── ensure_started: the race, from processes that stay alive while it runs ─

(deftest loader-server-pinned-ensure-started-races-once
  (testing "many processes racing run/1 against a dead server start ONE server"
    (let [dir (tmp-dir)
          parent (erlang/self)
          px probe
          n 24]
      (compile-pinned px dir)
      (stop-probe!)
      (is (= nil (Process/whereis px)) "precondition: the probe server is not running")
      ; Each racer calls `run/1`, reports the pid its thunk ran in, and HOLDS
      ; until told to finish. Holding matters: whoever WINS the race is the
      ; server's parent (`start_link` links), and a parent that exits takes its
      ; server with it — so a racer that returned immediately would pull the
      ; server out from under the others' calls.
      (let [racers (vec (map (fn [i]
                               (erlang/spawn
                                 (fn []
                                   (erlang/send parent (tuple i (erlang/apply px :run (list (fn [] (erlang/self))))))
                                   (receive :release :released))))
                             (range n)))
            results (vec (map (fn [_] (receive [i pid] (tuple i pid)
                                            (after 20000 (tuple :timeout :timeout))))
                              (range n)))
            answered (filter (fn [pr] (erlang/is_pid (elem pr 1))) results)
            pids (distinct (map (fn [pr] (elem pr 1)) answered))]
        (is (= n (count results)) "every racer answered")
        (is (= n (count answered)) (str "every thunk ran: " (pr-str results)))
        (is (= 1 (count pids)) "every thunk ran in ONE server process")
        (is (erlang/is_pid (first pids)))
        (is (= (Process/whereis px) (first pids)) "the process the racers reached is the registered server")
        (doseq [p racers] (erlang/send p :release))
        (Process/sleep 50)
        ; The holders released: those processes ended, so the server's parent
        ; is gone and it may stop. A fresh `run/1` starts it again — the
        ; recovery the application supervisor also relies on.
        (is (erlang/is_pid (erlang/apply px :run (list (fn [] (erlang/self))))))
        (is (= :again (erlang/apply px :run (list (fn [] :again))))))
      (File/rm_rf! dir))))

; ── the boot: a fresh VM starting the application on the pinned child ─────

(defn- child-code-args
  "This VM's whole code path as `-pa` args, with `pinned` LAST so it lands
   FIRST: `-pa` PREPENDS, so the last one named wins."
  [pinned]
  (concat (mapcat (fn [p] (list "-pa" (erlang/list_to_binary p))) (code/get_path))
          (list "-pa" pinned)))

(defn- boot-script
  "The child VM's program, as Elixir source. Every line it prints is read back
   as an assertion: the beam the code server resolved, the supervisor and its
   children, the pinned module AS the supervised child, the seeded language,
   the inline nested run, the crossing exception and its raise site, the throw,
   the generated `handle_info/2`'s log line, and the exit the supervisor
   restarts."
  []
  (str
    "app = :beam_lisp\n"
    "IO.puts(\"which=\" <> List.to_string(:code.which(BeamLisp.Loader.Server)))\n"
    "{:ok, _} = Application.ensure_all_started(app)\n"
    "sup = Process.whereis(BeamLisp.Supervisor)\n"
    "IO.puts(\"supervisor=\" <> inspect(is_pid(sup)))\n"
    "IO.puts(\"children=\" <> inspect(Supervisor.which_children(sup) |> Enum.map(&elem(&1, 0)) |> Enum.sort()))\n"
    "IO.puts(\"specs=\" <> inspect(Map.get(Supervisor.count_children(sup), :specs)))\n"
    "server = Process.whereis(BeamLisp.Loader.Server)\n"
    "IO.puts(\"server-is-child=\" <> inspect(server == Enum.find_value(Supervisor.which_children(sup), fn {id, pid, _, _} -> if id == BeamLisp.Loader.Server, do: pid end)))\n"
    "IO.puts(\"seeded=\" <> inspect(BeamLisp.Env.seeded?()))\n"
    "IO.puts(\"eval=\" <> inspect(BeamLisp.eval(\"(+ 1 2)\")))\n"
    "IO.puts(\"run=\" <> inspect(BeamLisp.Loader.Server.run(fn -> 41 end)))\n"
    "IO.puts(\"ran-in-server=\" <> inspect(BeamLisp.Loader.Server.run(fn -> self() end) == server))\n"
    "IO.puts(\"outside=\" <> inspect(BeamLisp.Loader.Server.in_server?()))\n"
    "IO.puts(\"inside=\" <> inspect(BeamLisp.Loader.Server.run(fn -> BeamLisp.Loader.Server.in_server?() end)))\n"
    "IO.puts(\"nested=\" <> inspect(BeamLisp.Loader.Server.run(fn -> [BeamLisp.Loader.Server.in_server?(), BeamLisp.Loader.Server.run(fn -> self() end) == self()] end)))\n"
    "IO.puts(\"outside2=\" <> inspect(BeamLisp.Loader.Server.in_server?()))\n"
    "res = try do\n"
    "  BeamLisp.Loader.Server.run(fn -> raise \"kaboom\" end)\n"
    "  :none\n"
    "rescue\n"
    "  e -> {Exception.message(e), Enum.take(__STACKTRACE__, 1) |> inspect()}\n"
    "end\n"
    "IO.puts(\"rescued=\" <> inspect(elem(res, 0)))\n"
    "IO.puts(\"raise-site=\" <> inspect(String.contains?(elem(res, 1), \"boot.exs\")))\n"
    "IO.puts(\"survives=\" <> inspect(BeamLisp.Loader.Server.run(fn -> :alive end)))\n"
    "t = try do\n"
    "  BeamLisp.Loader.Server.run(fn -> throw(:tossed) end)\n"
    "  :none\n"
    "catch\n"
    "  :throw, v -> {:thrown, v}\n"
    "end\n"
    "IO.puts(\"thrown=\" <> inspect(t))\n"
    "IO.puts(\"survives2=\" <> inspect(BeamLisp.Loader.Server.run(fn -> :alive2 end)))\n"
    ; THE RAW-KIND CORNERS, read with Elixir's OWN `catch kind, reason` so the
    ; CLASS is visible — the folded value cannot show it. A raw throw of an
    ; exception struct must reach the caller as `:throw` (not `:error`), and a
    ; raw throw of an `{:exit, v}` pair as `:throw` (not `:exit`).
    "cs = try do\n"
    "  BeamLisp.Loader.Server.run(fn -> :erlang.throw(RuntimeError.exception(\"raw\")) end)\n"
    "  :none\n"
    "catch\n"
    "  :throw, v -> {:thrown, v.__struct__}\n"
    "  :error, e -> {:raised, e.__struct__}\n"
    "  :exit, r -> {:exit, r}\n"
    "end\n"
    "IO.puts(\"throw-struct=\" <> inspect(cs))\n"
    "cp = try do\n"
    "  BeamLisp.Loader.Server.run(fn -> :erlang.throw({:exit, 7}) end)\n"
    "  :none\n"
    "catch\n"
    "  :throw, v -> {:thrown, v}\n"
    "  :error, e -> {:raised, e.__struct__}\n"
    "  :exit, r -> {:exit, r}\n"
    "end\n"
    "IO.puts(\"throw-exitpair=\" <> inspect(cp))\n"
    "cr = try do\n"
    "  BeamLisp.Loader.Server.run(fn -> :erlang.error(RuntimeError.exception(\"raised\")) end)\n"
    "  :none\n"
    "catch\n"
    "  :throw, v -> {:thrown, v.__struct__}\n"
    "  :error, e -> {:raised, e.__struct__}\n"
    "  :exit, r -> {:exit, r}\n"
    "end\n"
    "IO.puts(\"raise-struct=\" <> inspect(cr))\n"
    "send(server, :stray)\n"
    "Process.sleep(200)\n"
    "IO.puts(\"still-ready=\" <> inspect(BeamLisp.Loader.Server.run(fn -> :ready end)))\n"
    ; THE EXIT carries its RAW reason: monitor the child, run a non-atom exit
    ; through `run/1`, and read the exit reason off the DOWN message — the
    ; folded `{:exit, v}`'s `v`, re-raised as a true exit.
    "ref = Process.monitor(server)\n"
    "ex = try do\n"
    "  BeamLisp.Loader.Server.run(fn -> exit({:bye, 1}) end)\n"
    "  :none\n"
    "catch\n"
    "  :exit, _ -> :exited\n"
    "end\n"
    "down = receive do {:DOWN, ^ref, :process, ^server, reason} -> reason after 2000 -> :no_down end\n"
    "Process.sleep(300)\n"
    "IO.puts(\"exited=\" <> inspect(ex))\n"
    "IO.puts(\"exit-reason=\" <> inspect(down))\n"
    "restarted = Process.whereis(BeamLisp.Loader.Server)\n"
    "IO.puts(\"restarted=\" <> inspect(is_pid(restarted) and restarted != server))\n"
    "IO.puts(\"back=\" <> inspect(BeamLisp.Loader.Server.run(fn -> :back end)))\n"
    "IO.puts(\"ok\")\n"))

(deftest loader-server-pinned-beam-boots-the-application
  (testing "a fresh child VM resolves the pinned beam and starts the app on it"
    (let [dir (tmp-dir)
          out (str dir "/boot")
          script (Path/join dir "boot.exs")
          beam (Path/join out "Elixir.BeamLisp.Loader.Server.beam")]
      ; The pinned beam AT the production atom, written here, never loaded here:
      ; loading it would purge the module the LIVE loader server process is
      ; running, which is the one thing this suite must not do.
      (BeamLisp.AOT/compile_host_file (src)
        (list (t2 :module live) (t2 :output_dir out) (t2 :load? false)
              (t2 :behaviour behaviour-mod)))
      (is (File/exists? beam))
      (File/write! script (boot-script))

      (let [r (System/cmd "elixir"
                          (to-list (concat (child-code-args out) (list script)))
                          (to-list [(tuple :stderr_to_stdout true)]))
            text (elem r 0)]
        (is (zero? (elem r 1)) (str "the child VM exited " (elem r 1) ":\n" text))

        ; THE REPLACEMENT: the code server resolves the child module to the
        ; pinned beam, before and after the application start.
        (is (includes? text (str "which=" beam)) text)

        ; THE TREE: the same supervisor, the same two children, and the pinned
        ; module IS the supervised child — which is only true because the
        ; pinned `child_spec/1` kept the child id the module atom.
        (is (includes? text "supervisor=true") text)
        (is (includes? text "children=[BeamLisp.Env, BeamLisp.Loader.Server, :beam_lisp_owner_registry]") text)
        (is (includes? text "specs=3") text)
        (is (includes? text "server-is-child=true") text)

        ; THE SEQUENCING: `init/0` ran after the children, on top of them.
        (is (includes? text "seeded=true") text)
        (is (includes? text "eval=3") text)

        ; THE PINNED `run/1`: a value crosses back, the thunk ran in the
        ; supervised server, and `in_server?/0` follows the flag.
        (is (includes? text "run=41") text)
        (is (includes? text "ran-in-server=true") text)
        (is (includes? text "outside=false") text)
        (is (includes? text "inside=true") text)
        (is (includes? text "nested=[true, true]") text)
        (is (includes? text "outside2=false") text)

        ; THE EXCEPTION: it crosses with its message, its raise site is the
        ; THUNK's frame (the script), and the server survives it.
        (is (includes? text "rescued=\"kaboom\"") text)
        (is (includes? text "raise-site=true") text)
        (is (includes? text "survives=:alive") text)

        ; THE THROW stays a throw, and the server survives that too.
        (is (includes? text "thrown={:thrown, :tossed}") text)
        (is (includes? text "survives2=:alive2") text)

        ; THE RAW-KIND CORNERS: read with Elixir's own `catch kind, reason`, a
        ; raw throw of an exception struct stays a THROW, a raw throw of an
        ; `{:exit, v}` pair stays a THROW, and a genuine raise of the same
        ; struct is a RAISE — the classes the fold alone cannot distinguish.
        (is (includes? text "throw-struct={:thrown, RuntimeError}") text)
        (is (includes? text "throw-exitpair={:thrown, {:exit, 7}}") text)
        (is (includes? text "raise-struct={:raised, RuntimeError}") text)

        ; THE GENERATED `handle_info/2`: a stray message is logged through
        ; `:logger` with the macro's own report, naming the supervised child.
        (is (includes? text "received unexpected message in handle_info/2: :stray") text)
        (is (includes? text "still-ready=:ready") text)

        ; THE EXIT: it takes the child down (neither live `rescue` nor live
        ; `catch :throw` catches one), and the supervisor restarts it — the
        ; tree is intact afterwards.
        (is (includes? text "exited=:exited") text)
        (is (includes? text "exit-reason={:bye, 1}") text)
        (is (includes? text "restarted=true") text)
        (is (includes? text "back=:back") text)
        (is (includes? text "ok") text))

      (File/rm_rf! dir))))
