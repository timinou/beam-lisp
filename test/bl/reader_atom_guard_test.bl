; reader_atom_guard_test.bl — the self-hosted reader (priv/boot/reader.bl) must
; enforce the SAME atom-table safety guard the live Elixir reader does.
;
; WHY THIS EXISTS
;
; Erlang atoms are never garbage-collected, and a full atom table does not
; raise — it ABORTS THE WHOLE VM, uncatchably. Every layer that turns source
; text into atoms (symbols, keywords) must therefore sample the table and
; refuse BEFORE the VM would die, converting an unrecoverable abort into an
; ordinary catchable error (see docs/trust-boundary.md, lib/beam_lisp/reader.ex
; check_atom_safety!/2, and lib/beam_lisp/atom_guard.ex).
;
; reader.ex has this guard. reader.bl did NOT — it read a brand-new symbol even
; with the high-water fraction pinned to 0.0, where reader.ex refuses. That is a
; security-relevant parity gap: a self-hosted reader that skips the guard would,
; once it becomes the live reader, reopen the exact VM-abort hole the guard
; closes. This suite is the gate for closing it.
;
; HOW WE TEST WITHOUT FILLING THE ATOM TABLE
;
; The guard reads its ceiling from application env (:beam_lisp,
; :atom_high_water_fraction / :atom_check_interval). Set the fraction to 0.0 and
; the interval to 1: EVERY sampled symbol/keyword token is then "past the
; ceiling", so the guard must fire on the first fresh name — no need to actually
; approach the real table limit. This mirrors reader_safety_test.exs exactly.
;
; Run:  mix beam_lisp.test test/bl/reader_atom_guard_test.bl

(ns reader-atom-guard.test
  (:require [reader :as r]))

; --- guard-config scaffolding -------------------------------------------------
;
; `with-tight-guard` pins the guard to refuse on the first sampled token, runs
; the thunk, and ALWAYS restores the env — a leaked 0.0 fraction would make
; every later read in the same VM refuse, so the cleanup is not optional.

(defn- set-guard! [fraction interval]
  (Application/put_env :beam_lisp :atom_high_water_fraction fraction)
  (Application/put_env :beam_lisp :atom_check_interval interval))

(defn- clear-guard! []
  (Application/delete_env :beam_lisp :atom_high_water_fraction)
  (Application/delete_env :beam_lisp :atom_check_interval))

(defn- refuses?
  "True when reading `src` with reader.bl raises under a fraction-0.0 guard.
   A UNIQUE symbol name each call (via gensym) guarantees a genuinely fresh
   atom — a name already interned would cost nothing and never trip the
   sampler, masking a missing guard."
  [f]
  (set-guard! 0.0 1)
  (BeamLisp.AtomGuard/reset)
  (try
    (try (do (f) false) (catch e true))
    (finally (clear-guard!))))

(defn- ex-refuses? [f]
  (set-guard! 0.0 1)
  (BeamLisp.AtomGuard/reset)
  (try
    (try (do (f) false) (catch e true))
    (finally (clear-guard!))))

; --- the parity the guard owes ------------------------------------------------

(deftest fresh-symbol-is-refused-like-reader-ex
  (testing "a brand-new symbol trips the guard in BOTH readers"
    ; The answer key: reader.ex refuses a fresh symbol at fraction 0.0.
    (is (ex-refuses? (fn [] (BeamLisp.Reader/read_all "danger-unique-sym-a"))))
    ; The parity obligation: reader.bl must refuse it too.
    (is (refuses? (fn [] (r/read-all "danger-unique-sym-a"))))))

(deftest fresh-keyword-is-refused-like-reader-ex
  (testing "a brand-new keyword trips the guard in BOTH readers"
    (is (ex-refuses? (fn [] (BeamLisp.Reader/read_all ":danger-unique-kw-a"))))
    (is (refuses? (fn [] (r/read-all ":danger-unique-kw-a"))))))

; --- the guard must NOT fire where reader.ex does not -------------------------
;
; A guard that refuses EVERYTHING is not parity — it is a different bug. Plain
; literals (numbers, strings, nil, booleans) intern no atoms, so even at
; fraction 0.0 / interval 1 they must read cleanly in both readers.

(deftest plain-literals-never-trip-the-guard
  (testing "numbers, strings, nil, booleans intern no atoms — no refusal"
    (is (not (refuses? (fn [] (r/read-all "42 -7 2.5 \"text\" nil true false")))))
    (is (not (ex-refuses? (fn [] (BeamLisp.Reader/read_all "42 -7 2.5 \"text\" nil true false")))))))

(deftest default-config-never-fires-on-normal-reads
  (testing "with no env override, a normal read of symbols/keywords succeeds"
    ; No set-guard! here: the live table is far below the 0.9 default ceiling,
    ; so an ordinary read must not raise. Guards the false-positive direction.
    (clear-guard!)
    (is (= 3 (count (r/read-all "alpha :beta gamma"))))))
