(ns startup-metadata-test)
(deftest selected-definitions-preserve-shadowing-and-snapshot
 (let [ns "startup.metadata.fixture"
       e (BeamLisp.Env/fork :global)]
  (try
   (BeamLisp.Env/with_env e
    (fn []
     (BeamLisp.Env/put_ns_defs ns {"a" [:a] "b" [:b]})
     (is (= {"b" [:b]} (BeamLisp.Env/selected_ns_definitions ns ["b" "missing"])))
     (BeamLisp.Env/put_ns_definition ns "b" [:changed])
     (is (= {"b" [:changed]} (BeamLisp.Env/selected_ns_definitions ns ["b"])))
     (is (= 2 (BeamLisp.Env/ns_definition_count ns)))))
   (finally (BeamLisp.Env/destroy e)))))
