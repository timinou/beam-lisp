(ns realm-aot-reuse-test)
(defn count-compiles [action]
 (let [parent (erlang/self)
       drain (fn drain [n]
               (receive [:trace _ _ _] (drain (inc n))
                        :finish (erlang/send parent [:compiled n])
                        _ (drain n)))
       tracer (erlang/spawn (fn [] (drain 0)))
       pid (Process/whereis :Elixir.BeamLisp.Loader.Server)
       pattern (tuple :Elixir.BeamLisp.AOT :compile_source 2)]
  (erlang/trace_pattern pattern true (list :local))
  (erlang/trace pid true (list :call (tuple :tracer tracer)))
  (try (action)
    (finally
      (erlang/trace pid false (list :call))
      (erlang/trace_pattern pattern false (list :local))
      (erlang/trace_delivered pid)
      (receive [:trace_delivered _ _] nil (after 5000 (throw :trace-timeout)))
      (erlang/send tracer :finish)))
  (receive [:compiled n] n (after 5000 -1))))

(deftest finite-admission-refuses-custom-expansion-and-top-level-effects
 (is (BeamLisp.AOT/local_cacheable_source? "(ns a) (def n (System/get_env \"X\")) (defn answer [] n)"))
 (is (not (BeamLisp.AOT/local_cacheable_source? "(ns a) (defmacro m [] 7) (defn a [] (m))")))
 (is (not (BeamLisp.AOT/local_cacheable_source? "(ns a) (File/write! \"x\" \"bad\") (defn a [] 7)")))
 (is (not (BeamLisp.AOT/local_cacheable_source? "(ns a) (defn a [] (custom.macro/call))"))))

(deftest cached-realm-code-replays-values-in-each-environment
 (let [root (Path/join (System/tmp_dir) (str "realm-aot-" (erlang/unique_integer (list :positive))))
       ns "realm.cached.fixture"
       file (Path/join root "realm/cached/fixture.bl")
       key (str "Cache" (erlang/unique_integer (list :positive)))
       previous (System/get_env "REALM_AOT_TEST_VALUE")
       run (fn [value]
             (let [e (BeamLisp.Env/fork :global)]
               (try
                 (System/put_env "REALM_AOT_TEST_VALUE" value)
                 (BeamLisp.Env/with_env e
                   (fn []
                     (BeamLisp.Env/put_key (tuple :realm_key) key)
                     (BeamLisp.Env/put_key (tuple :realm_decl) {:shadow [] :uses {}})
                     (BeamLisp.Loader/with_search_dir root
                       (fn [] (BeamLisp.Loader/ensure_loaded ns)))
                     (is (= value (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! ns "answer") (list))))
                     (is (some? (BeamLisp.Emit/realm_of ns)))
                     (is (erlang/function_exported (BeamLisp.Emit/module_for ns) :__bl_init__ 0))))
                 (finally (BeamLisp.Env/destroy e)))))]
   (File/mkdir_p! (Path/dirname file))
   (File/write! file "(ns realm.cached.fixture) (def setting (System/get_env \"REALM_AOT_TEST_VALUE\")) (defn answer [] setting)")
   (try (run "first") (is (= 0 (count-compiles (fn [] (run "second")))))
     (is (not (BeamLisp.Env/loaded_ns? ns)))
     (finally
       (if previous (System/put_env "REALM_AOT_TEST_VALUE" previous) (System/delete_env "REALM_AOT_TEST_VALUE"))
       (File/rm_rf! root)))))

(deftest alternate-namespaces-and-compiler-aliases-decline-before-effects
 (is (not (BeamLisp.AOT/local_cacheable_source? "(ns a) (defn x [] 1) (ns b) (defn y [] 2)")))
 (is (not (BeamLisp.AOT/local_cacheable_source? "(ns a (:require [custom :refer [+]])) (defn x [] (+ 1 2))")))
 (is (not (BeamLisp.AOT/local_cacheable_source? "(ns a (:require [custom :as System])) (defn x [] (System/value))"))))
