; pristine_test.bl — the PRISTINE comparison, pinned at its own entry point.
;
; Ported from the ExUnit `test/beam_lisp/build_pristine_test.exs`: the same
; assertions, now against `priv/build/pristine.bl` with no Elixir façade in the
; call path. The façade's one interop wrinkle is gone with it — bl maps crossed
; to Elixir with ATOM keys only when the keyword had no hyphen (`same?`,
; `fields`, `sizes`), and bl vectors (the path lists) arrived as
; `%BeamLisp.Vector{}`, normalised by the old `bl/1` helper. Both facts are
; native here: values are read directly and the path lists compare against
; `[...]` literals.
;
; The PRISTINE comparison is the machinery PLAN-108's W6 fixpoint gate rests on.
; A comparison that always answers "identical" is not a gate, so the negative
; half IS the point of this suite: three mutations applied at once must produce
; three named differences (an extra path, a missing path, a changed byte) and
; the report must name ALL THREE, not the first. A gate that reports one
; mismatch at a time turns a fixpoint into a guessing game.
;
; The positive half pins the one measured trap in the artifact layer: the Rust
; packer's output and the language's, for ONE tree, agree on the trailer fields,
; the payload digest and the DECOMPRESSED payload — while their file bytes
; differ, because flate2 and Erlang's `:zlib` are different compressors. The
; comparison reports that as `:sizes` and deliberately does not fail `same?` on
; it; that grain is the fixpoint's.
;
; The real release tree is compared with itself when one is on this machine (it
; hashes ~300 MB twice). That is the anchor saying the machinery works on the
; thing it will be pointed at, not only on fixtures. The two-producer and the
; single-producer fixpoint cases are likewise optional on their fixtures being
; present, and each says so out loud rather than passing silently.
;
; Run: bl test test/bl/pristine_test.bl

(ns pristine.test
  (:require [pristine :as p] [drop :as dr] [build :as b]))

(def base "/tmp/beam_lisp_pristine_base")
(def mutated "/tmp/beam_lisp_pristine_mutated")
(def release-tree "/tmp/beam_lisp_release_tree")

(defn- tree!
  "A release tree of exactly four files: a launcher, a 1024-byte beam, an empty
   priv file and a 2000-byte one — the counts and byte totals the difference
   assertions below rely on."
  [root]
  (File/rm_rf! root)
  (doseq [d ["bin" "lib/thing-0.1.0/ebin" "lib/thing-0.1.0/priv"]]
    (File/mkdir_p! (Path/join root d)))
  (File/write! (Path/join root "bin/bl") "#!/bin/sh\nexec node\n")
  (File/write! (Path/join root "lib/thing-0.1.0/ebin/Elixir.Thing.beam")
               (crypto/strong_rand_bytes 1024))
  (File/write! (Path/join root "lib/thing-0.1.0/priv/data.txt") "")
  (File/write! (Path/join root "lib/thing-0.1.0/priv/big.txt") (String/duplicate "x" 2000))
  root)

(defn- copy-of-base! []
  (File/rm_rf! mutated)
  (File/cp_r! base mutated)
  mutated)

(deftest an-identical-tree-is-identical-and-the-report-is-one-word
  (tree! base)
  (copy-of-base!)
  (let [diff (p/trees base mutated)]
    (is (:same? diff))
    (is (:same? (:trees diff)))
    (is (= [] (:added (:trees diff))))
    (is (= [] (:removed (:trees diff))))
    (is (= [] (:changed (:trees diff))))
    (is (= {:a 4 :b 4} (:files (:trees diff))))
    (is (= (get-in diff [:trees :bytes :a]) (get-in diff [:trees :bytes :b])))
    (is (:same? (:tar diff)))
    (is (= (get-in diff [:tar :sizes :a]) (get-in diff [:tar :sizes :b])))
    (is (= "identical" (p/report diff)))))

(deftest an-extra-path-a-missing-path-and-a-changed-byte-are-three-findings-all-reported
  (tree! base)
  (copy-of-base!)
  (File/write! (Path/join mutated "lib/thing-0.1.0/priv/extra.txt") "new\n")
  (File/rm! (Path/join mutated "lib/thing-0.1.0/priv/data.txt"))
  (File/write! (Path/join mutated "bin/bl") "#!/bin/sh\nexec node --changed\n")
  (let [diff (p/trees base mutated)]
    (is (not (:same? diff)))
    (is (= ["lib/thing-0.1.0/priv/extra.txt"] (:added (:trees diff))))
    (is (= ["lib/thing-0.1.0/priv/data.txt"] (:removed (:trees diff))))
    (is (= ["bin/bl"] (:changed (:trees diff))))

    ; one file added, one removed: the counts stay equal while the byte totals
    ; do not — the added file is 4 bytes, and `bin/bl` is 10 bytes longer.
    (is (= {:a 4 :b 4} (:files (:trees diff))))
    (is (= 14 (- (get-in diff [:trees :bytes :b]) (get-in diff [:trees :bytes :a]))))

    ; EVERY difference, not the first: a gate that names one mismatch at a time
    ; makes a fixpoint a guessing game.
    (let [report (p/report diff)]
      (is (includes? report "extra.txt"))
      (is (includes? report "data.txt"))
      (is (includes? report "bin/bl"))
      (is (= 3 (count (clojure.string/split report "\n")))))))

(deftest the-tar-layer-has-teeth-content-changes-even-when-the-size-does-not
  (tree! base)
  (copy-of-base!)
  (File/write! (Path/join mutated "bin/bl") "#!/bin/sh\nexec node\nX")
  (let [diff (p/trees base mutated)]
    (is (= ["bin/bl"] (:changed (:trees diff))))
    (is (not (:same? (:tar diff))))

    ; tar is block-granular (512 B), so ONE added byte does not move the total:
    ; the CONTENT changed, which is what `same?` reads. A comparison that only
    ; looked at sizes would miss this edit entirely.
    (is (= (get-in diff [:tar :sizes :a]) (get-in diff [:tar :sizes :b])))

    ; and a change large enough to cross a block does move the size
    (File/write! (Path/join mutated "bin/bl") (String/duplicate "y" 600))
    (let [bigger (p/trees base mutated)]
      (is (not (:same? (:tar bigger))))
      (is (> (get-in bigger [:tar :sizes :b]) (get-in bigger [:tar :sizes :a]))))))

(deftest a-file-that-is-not-a-drop-is-refused-by-name
  (tree! base)
  (let [plain (Path/join base "bin/not-a-drop")]
    (File/write! plain (crypto/strong_rand_bytes 4096))
    (let [d (p/drops plain plain)]
      (is (not (:same? d)))
      (is (not (get-in d [:a :drop?])))
      (is (includes? (p/report d) "not a v1 drop")))))

(deftest two-producers-of-one-tree-same-trailer-same-payload-same-bytes-once-decompressed
  (let [rust "/tmp/beam_lisp_pack_rust.bl"
        ours "/tmp/beam_lisp_pack_ours.bl"]
    (if (and (File/exists? rust) (File/exists? ours))
      (let [d (p/drops rust ours)]
        (is (:same? (:fields d)))
        (is (:same? (:arithmetic d)))
        (is (:same? (:stored d)))
        ; the layer that makes the comparison trustworthy at all: whatever the
        ; compressor did, the bytes that come back are the same bytes.
        (is (:same? (:decompressed d)))
        (is (:same? d))

        ; and the measured trap, ASSERTED rather than hidden: two compressors
        ; make different COMPRESSED payloads and different file sizes for
        ; identical bytes (measured: len 1973 vs 1998 on one fixture tree).
        ; Those two sections are reported without failing `same?`.
        (is (not (:same? (:compressed d))))
        (is (not (:same? (:sizes d))))
        (is (not= (get-in d [:compressed :a :len]) (get-in d [:compressed :b :len])))
        (is (includes? (p/report d) "compressed"))
        (is (includes? (p/report d) "sizes")))

      ; Those fixtures belong to the pack test, which packs one tree with both
      ; producers. Failing here would be a false alarm; passing silently would
      ; be a lie, so the suite says which it is.
      (do
        (println (str "pristine_test: skipped the two-producer case — "
                      rust " / " ours " not present"))
        (is true)))))

(deftest the-same-sources-compiled-twice-give-an-identical-beam-set
  ; The property W6's fixpoint rests on, made checkable by existing machinery:
  ; two independent builds of ONE source set must agree file for file. This is
  ; the AOT half only — no release, no pack, no `bl self-build` — and each build
  ; gets its own output dir AND its own manifest/log, so neither can read the
  ; other's state.
  (let [srcs (Path/wildcard "priv/build/*.bl")]
    (is (> (count srcs) 5))
    (let [a "/tmp/beam_lisp_pristine_build_a"
          b "/tmp/beam_lisp_pristine_build_b"]
      (doseq [d [a b]]
        (File/rm_rf! d)
        (File/mkdir_p! d))

      (doseq [out [a b]]
        (let [r (b/run {:sources srcs :out out :force? true :jobs 4 :log nil})]
          (is (= [] (:errors r)))
          (is (= (count srcs) (:built r)))))

      (let [diff (p/trees a b ["build.log"])]
        (is (:same? diff))
        (is (= (get-in diff [:trees :files :a]) (get-in diff [:trees :files :b])))
        (is (>= (get-in diff [:trees :files :a]) (count srcs)))

        ; The manifest IS inside the comparison — it carries per-source hashes
        ; and keys — and it came out identical. Only the log differs, because it
        ; records the run id and the time.
        (is (= [] (:changed (:trees diff))))

        ; And the exclusion is DISCLOSED, not silent: a tar is the whole
        ; directory, so the tar layer cannot be compared over a tree holding
        ; build state, and the report says NOT COMPARED instead of quietly
        ; passing.
        (is (nil? (:same? (:tar diff))))
        (is (= ["build.log"] (:skipped (:tar diff))))
        (is (includes? (p/report diff) "NOT COMPARED"))

        ; without the exclusion the difference is exactly the log: the
        ; comparison notices it rather than filtering it away behind our backs.
        (let [raw (p/trees a b)]
          (is (not (:same? raw)))
          (is (= ["build.log"] (:changed (:trees raw)))))))))

(deftest one-producers-two-packs-of-one-tree-are-byte-identical-end-to-end
  (let [tree release-tree
        launcher (or (System/get_env "BL_LAUNCHER")
                     "/home/user/.cache/cargo-target/release/drop-launcher")]
    (if (and (File/dir? tree) (File/exists? launcher))
      ; Self-contained on purpose: two packs made HERE, from the tree as it is
      ; now. Comparing two stored files instead was wrong once already — one of
      ; them turned out to be a pack of a tree from before the priv fix, and the
      ; mismatch looked like nondeterminism when it was a stale fixture.
      (let [a (dr/pack tree launcher "/tmp/beam_lisp_pristine_pack_a.bl" 0)
            b (dr/pack tree launcher "/tmp/beam_lisp_pristine_pack_b.bl" 0)]
        (is (and (:ok? a) (:ok? b)))

        ; The fixpoint ONE producer can demand of itself: not merely the same
        ; payload once decompressed, but the same FILE. `pack`'s result carries
        ; `:out`, not `:path` — asking for the latter raises, which is how the
        ; first version of this test spent a run looking like nondeterminism.
        (is (p/compounds-identical? (:out a) (:out b)))
        (let [d (p/drops (:out a) (:out b))]
          (is (:same? d))
          (is (:same? (:compressed d)))
          (is (:same? (:sizes d)))
          (is (= "identical" (p/report d)))))

      (do
        (println (str "pristine_test: skipped the single-producer fixpoint — "
                      tree " / " launcher " missing"))
        (is true)))))

(deftest the-real-release-tree-compared-with-itself-is-identical
  (if (File/dir? release-tree)
    (let [diff (p/trees release-tree release-tree)]
      (is (:same? diff))
      (is (> (get-in diff [:trees :files :a]) 200))
      (is (> (get-in diff [:trees :bytes :a]) 10000000))
      (is (= "identical" (p/report diff))))
    (do
      (println (str "pristine_test: skipped the real-tree anchor — "
                    release-tree " not present"))
      (is true))))
