; reader_meta_test.bl — ^{:key …} author metadata reaches runtime collections.
;
; The fix (PLAN-052 W0): reader metadata carries two kinds of key. Positional
; keys (:line/:col/:file) are the compiler's source-location channel and never
; reach a value; AUTHOR keys (e.g. a hiccup `^{:key (:slug t)}`) ARE data and
; must survive onto the value, exactly as in Clojure. Before the fix, the
; compiler dropped ALL form metadata for collection literals, so `^{:key}` was
; silently lost — which broke keyed diffing for the live-view layer.
;
; Two boundaries had to carry it: `compile/2` (a literal in code) and the
; `datum`/`data_to_form` macro-argument round-trip (a literal inside `for`,
; whose body is a macro argument).

(ns reader-meta.test)

(deftest literal-key-survives
  (testing "a ^{:key} literal attaches to the value and reads back via meta"
    (is (= {:key "s1"} (meta ^{:key "s1"} [:li "x"]))))
  (testing "the value itself is a fully usable vector (meta is a side field)"
    (let [v ^{:key "s1"} [:li "x"]]
      (is (= 2 (count v)))
      (is (= :li (first v)))
      (is (= [:li "x"] v)))))

(deftest expression-key-evaluates
  (testing "^{:key EXPR} evaluates the value, not quotes it"
    (let [slug "task-42"]
      (is (= {:key "task-42"} (meta ^{:key slug} [:article "body"]))))))

(deftest for-rows-are-keyed
  (testing "the idiomatic keyed-row form: every for-row carries its key"
    ; `for`'s body is a MACRO ARGUMENT — it crosses the datum boundary, the
    ; second site the fix had to cover. Before W0 these keys were all nil.
    (let [rows (for [t [{:slug "a"} {:slug "b"} {:slug "c"}]]
                 ^{:key (:slug t)} [:li (:slug t)])]
      (is (= ["a" "b" "c"] (mapv (fn [r] (:key (meta r))) rows))))))

(deftest map-preserves-key
  (testing "map (like for) preserves author meta across the fn boundary"
    (let [rows (map (fn [t] ^{:key (:id t)} [:li (:id t)]) [{:id 1} {:id 2}])]
      (is (= [1 2] (mapv (fn [r] (:key (meta r))) rows))))))

(deftest meta-invisible-to-equality
  (testing "metadata never affects = (the pre-existing invariant, re-asserted)"
    (is (= ^{:key "x"} [:li 1] [:li 1]))
    (is (= [:li 1] ^{:key "y"} [:li 1]))))

(deftest no-meta-is-nil
  (testing "a plain literal with no author meta reads back nil (unchanged path)"
    (is (= nil (meta [:li 1])))
    (is (= nil (meta [1 2 3])))))

(deftest only-vectors-carry-runtime-meta
  ; The BEAM term model is value-typed: only a %BeamLisp.Vector{} (and lazy
  ; seqs) has a per-instance struct field to hold metadata. Plain maps and
  ; lists are bare BEAM terms, so `with-meta` on them is a documented no-op
  ; (BeamLisp.Meta.with_meta/2) and `meta` reads back nil. This is the honest
  ; boundary, and it is exactly right for hiccup: a node is a VECTOR
  ; (`[:tag …]`), never a bare map, so keyed diffing always has its field.
  (testing "a vector literal carries author meta (the hiccup node case)"
    (is (= {:key "v"} (meta ^{:key "v"} [:li 1]))))
  (testing "a map literal does not (value-typed term, no meta field)"
    (is (= nil (meta ^{:key "m"} {:a 1})))))

(deftest threading-still-works
  (testing "positional meta is still stripped, so rest-based macros are intact"
    ; This is the exact regression the original strip existed to prevent: a
    ; positional {:meta, list, m} wrapper broke `->`'s `rest`. The fix splits
    ; positional from author meta, so `->` stays correct.
    (is (= 16 (-> 5 (+ 3) (* 2))))
    (is (= 9 (->> [1 2 3] (map inc) (reduce +))))
    (is (= 2 (-> {:a 1} (assoc :b 2) (get :b))))))

