; test/bl/compiler_special_form_names_test.bl
;
;   ./bin/bl test test/bl/compiler_special_form_names_test.bl
;
; A list whose head is a special form name (`loop*`, `let*`, `fn*`, `if`, …)
; always compiles as that special form. So:
;
;   1. defining a var with such a name warns where it is written, with the
;      file, the line and the qualified spelling that does reach it (Clojure
;      warns too; a qualified-only definition such as `act/do` is real code);
;   2. an unqualified call that hands the special form something other than a
;      binding vector reports the special form and the position, not a crash in
;      the reader-node accessors;
;   3. an empty binding vector stays valid, as in Clojure.

(ns compiler-special-form-names-test
  (:require [bl.test :refer [deftest is testing]]))

(def ^:private fixture-ns "special-names-fixture")

(defn- compile-src
  "Compile `src` as file special_test.bl, capturing compile warnings.
   → {:error msg-or-nil :value v :stderr warning-text}."
  [src]
  (let [dev (second (erlang/tuple_to_list (StringIO/open "")))
        _ (erlang/put :bl-compile-warnings dev)
        r (try {:value (BeamLisp.Compiler/eval_string src (BeamLisp.Compiler/new_env fixture-ns)
                                                      "special_test.bl")}
               (catch e {:error (ex-message e)})
               (finally (erlang/erase :bl-compile-warnings)))
        text (second (erlang/tuple_to_list (StringIO/contents dev)))]
    (StringIO/close dev)
    (assoc r :stderr text)))

(defn- has? [s part]
  (and (string? s) (not= :nomatch (binary/match s part))))

(deftest defining-a-special-form-name-warns-with-its-position
  (testing "the reported case: defn- loop* then an unqualified call"
    (let [r (compile-src "(ns special-names-fixture)\n\n(defn- loop* [p] p)\n(loop* \"a\")")]
      (is (has? (:stderr r) "special_test.bl:3: defn- loop*: `loop*` is a special form") (:stderr r))
      (is (has? (:stderr r) "special-names-fixture/loop*") (:stderr r))
      (is (has? (:error r) "special_test.bl:4") (:error r))
      (is (has? (:error r) "`loop*` is a special form; it expects a binding vector") (:error r))))
  (testing "the qualified call reaches the var"
    (let [r (compile-src "(ns special-names-fixture)\n(defn let* [x] [:mine x])\n(special-names-fixture/let* 1)")]
      (is (nil? (:error r)) (:error r))
      (is (= [:mine 1] (:value r)))
      (is (has? (:stderr r) "special_test.bl:2: defn let*") (:stderr r))))
  (testing "every defining form warns"
    (doseq [[src kind name] [["(defn fn* [x] x)" "defn" "fn*"]
                             ["(def recur 1)" "def" "recur"]
                             ["(defmacro if [x] x)" "defmacro" "if"]
                             ["(defmulti let* identity)" "defmulti" "let*"]]]
      (let [r (compile-src (str "(ns special-names-fixture)\n" src))]
        (is (has? (:stderr r) (str "special_test.bl:2: " kind " " name ": `" name "` is a special form"))
            (:stderr r)))))
  (testing "an ordinary name does not warn"
    (is (= "" (:stderr (compile-src "(ns special-names-fixture)\n(defn loop-ish [x] x)"))))))

(deftest a-binding-form-without-a-vector-names-itself
  (doseq [[src head] [["(loop* \"a\")" "loop*"]
                      ["(loop \"a\")" "loop"]
                      ["(let* x 1)" "let*"]
                      ["(let)" "let"]]]
    (let [msg (:error (compile-src (str "(ns special-names-fixture)\n\n" src)))]
      (is (has? msg (str "`" head "` is a special form; it expects a binding vector")) msg)
      (is (has? msg "special_test.bl:3") msg))))

(defn- loop-empty [n] (loop [] (if (pos? n) :done (recur))))
(defn- let-empty [] (let [] :ok))

(deftest empty-binding-vectors-are-valid
  (is (= :done (loop-empty 1)))
  (is (= :ok (let-empty)))
  (is (= 3 (loop [] 3)))
  (is (= :ok (let* [] :ok)))
  (is (= 6 (loop* [i 0 acc 0] (if (> i 3) acc (recur (inc i) (+ acc i)))))))
