; test/bl/deps_compile_test.bl — `bl deps compile` — FUP-050's step 1: what a
; lock NAMES becomes a library that can be loaded, with no Mix anywhere in the
; path.
;
; Ported from the ExUnit `test/beam_lisp/deps_compile_test.exs`; the assertions
; are the same ones, asked of the same store and the same lock.
;
; Five properties, each because getting it wrong is silent:
;
;   * a package's sources compile into a directory addressed by content, and its
;     `.app` file CONSULTS — a term file nobody can read is not an application,
;     and the failure would surface as a missing app two stages later;
;   * `priv/` arrives next to `ebin`, which is where OTP looks for it;
;   * the marker appears only after a successful compile, so a directory a build
;     died in is redone rather than trusted;
;   * a second run is `:cached`, because a library that recompiles on every
;     build is not a cache;
;   * a package that cannot compile is REPORTED with the compiler's own message
;     and does not end the run — 47 packages are compiled in a loop, and any one
;     of them can be wrong.
;
; ── Case mapping (ExUnit → BL) ─────────────────────────────────────────────
;   "an Elixir package compiles into a content-addressed directory with a
;    readable .app"
;        → an-elixir-package-compiles-into-a-content-addressed-directory-with-a-readable-app
;   "runtime deps join the .app's applications, as Mix writes them"
;        → runtime-deps-join-the-apps-applications-as-mix-writes-them
;   "a second run is :cached, and a broken package is reported without ending
;    the run"
;        → a-second-run-is-cached-and-a-broken-package-is-reported-without-ending-the-run
;   "an Erlang package compiles through erlc, and its .app.src is honoured"
;        → an-erlang-package-compiles-through-erlc-and-its-app-src-is-honoured
;   helpers store_package!/4 lock!/2 compile!/1 sha/1 → store-package!, lock!,
;   compile!, sha
;
; Run: bl test test/bl/deps_compile_test.bl

(ns test.deps-compile
  (:require [deps :as dp] [deps-compile :as dc]))

; ── one throwaway cache for the whole file ────────────────────────────────
;
; The library store AND the compiled-library root both live under
; `XDG_CACHE_HOME`; pointing it at a fresh directory keeps this suite off the
; developer's real cache and makes every "compiled" a real compile.
(def cache
  (str (System/tmp_dir!) "/bl_deps_compile_" (erlang/unique_integer (list :positive))))
(File/rm_rf! cache)
(File/mkdir_p! cache)
(System/put_env "XDG_CACHE_HOME" cache)

(defn- sha
  "A 64-hex-shaped digest seeded from one character, the way the fixtures name
   content: only its first 8 characters address a directory, and only its
   equality to itself matters to a check."
  [seed]
  (subs (String/duplicate seed 64) 0 64))

; A package as `hex/install!` leaves one: its sources under the content
; address, and the digest beside them.
(defn- store-package! [name vsn sha-value files]
  (let [dir (Path/join (Path/join cache "beam_lisp/lib")
                       (str name "-" vsn "-" (subs sha-value 0 8)))]
    (doseq [pair files]
      (let [path (Path/join dir (first pair))]
        (File/mkdir_p! (Path/dirname path))
        (File/write! path (second pair))))
    (File/write! (Path/join dir ".hex-sha") sha-value)
    dir))

(defn- lock! [dir entries]
  (dp/write-lock! dir
    (map (fn [e] {:name (first e) :vsn (second e) :sha (nth e 2) :source :hex}) entries)))

(defn- compile! [dir]
  (let [r (dc/compile! dir 60000 nil)
        results (:results r)]
    {:ok? (:ok? r)
     :passes (:passes r)
     :results results
     :by-name (into {} (map (fn [x] [(:name x) x]) results))}))

(defn- consult! [path]
  (erlang/apply :file :consult (list (erlang/binary_to_list path))))

(defn- prop [props k]
  (erlang/apply :proplists :get_value (list k props)))

(defn- has?
  "Whether `coll` holds `x` — collection membership, where `includes?` is
   String.contains?. An Erlang proplist/`applications` list is a plain seq."
  [coll x]
  (some? (some (fn [e] (= e x)) (vec coll))))

; The `.app` a compile wrote, opened as an Erlang term: `{:application, app, props}`.
(defn- consulted-app [path]
  (let [r (consult! path)
        term (first (erlang/element 2 r))]
    {:ok? (= :ok (erlang/element 1 r))
     :term (erlang/element 1 term)
     :app (erlang/element 2 term)
     :props (erlang/element 3 term)}))

(defn- ebin-path [name vsn d]
  (Path/join (Path/join cache "beam_lisp/ebin")
             (str name "-" vsn "-" (subs d 0 8) "-" (dc/runtime-tag))))

; ── the fixtures ─────────────────────────────────────────────────────────

(def elixir-pkg
  [["mix.exs"
    (str "defmodule DepsCompileFx.MixProject do\n"
         "  use Mix.Project\n\n"
         "  def project, do: [app: :thing, version: \"0.1.0\"]\n"
         "  def application, do: [extra_applications: [:logger]]\n"
         "end\n")]
   ["lib/deps_compile_fx.ex" "defmodule DepsCompileFx do\n  def answer, do: 42\nend\n"]
   ["priv/data.txt" "the library's data directory\n"]])

(def erlang-pkg
  [["src/thing_erl.app.src"
    "{application, thing_erl, [{vsn, \"0.2.0\"}, {applications, [kernel, stdlib]}]}.\n"]
   ["src/thing_erl.erl" "-module(thing_erl).\n-export([answer/0]).\nanswer() -> 42.\n"]])

; bandit's `.app` used to name only its extra_applications, so every release
; closure dropped thousand_island and `web/serve` could not start. The project
; declaration below is the shape a Mix package has: runtime deps, an override, a
; test-only dep, a `runtime: false` dep, and an optional one.
(def server-pkg
  [["mix.exs"
    (str "defmodule DepsCompileServer.MixProject do\n"
         "  use Mix.Project\n\n"
         "  def project, do: [app: :server, version: \"0.1.0\", deps: deps()]\n"
         "  def application, do: [extra_applications: [:logger]]\n\n"
         "  defp deps do\n"
         "    [\n"
         "      {:thousand_island, \"~> 1.5\"},\n"
         "      {:plug, \"~> 1.18\", override: true},\n"
         "      {:req, \"~> 0.3\", only: [:dev, :test]},\n"
         "      {:ex_doc, \"~> 0.24\", runtime: false},\n"
         "      {:jason, \"~> 1.0\", optional: true}\n"
         "    ]\n"
         "  end\n"
         "end\n")]
   ["lib/server.ex" "defmodule DepsCompileServer do\nend\n"]])

(def broken-pkg
  [["mix.exs"
    "defmodule Broken.MixProject do\n  def project, do: [app: :broken, version: \"0.1.0\"]\nend\n"]
   ["lib/broken.ex" "defmodule Broken do\n  def broken do\nend\n"]])

; ── the properties ───────────────────────────────────────────────────────

(deftest an-elixir-package-compiles-into-a-content-addressed-directory-with-a-readable-app
  (let [d (sha "a")]
    (store-package! "thing" "0.1.0" d elixir-pkg)
    (let [proj (Path/join cache "proj")]
      (File/mkdir_p! proj)
      (lock! proj [["thing" "0.1.0" d]])

      (let [r (compile! proj)
            app-dir (ebin-path "thing" "0.1.0" d)
            app (consulted-app (Path/join (Path/join app-dir "ebin") "thing.app"))]

        (is (:ok? r) (str "compile refused: " (pr-str (:results r))))
        (is (= :compiled (:state (get (:by-name r) "thing"))))
        (is (= 1 (:modules (get (:by-name r) "thing"))))

        ; the address is content AND runtime
        (is (File/dir? app-dir) (str "expected " app-dir))

        ; the beams
        (is (File/exists? (Path/join app-dir "ebin/Elixir.DepsCompileFx.beam")))

        ; the .app CONSULTS — that is the property, not that a file exists
        (is (:ok? app))
        (is (= :application (:term app)))
        (is (= :thing (:app app)))
        (is (= [:Elixir.DepsCompileFx] (vec (prop (:props app) :modules)))
            (str "the modules list must be an Erlang list of atoms, got "
                 (pr-str (prop (:props app) :modules))))
        (is (has? (prop (:props app) :applications) :logger))

        ; priv/ is beside ebin, which is where OTP finds it
        (is (File/exists? (Path/join app-dir "priv/data.txt")))))))

(deftest runtime-deps-join-the-apps-applications-as-mix-writes-them
  (let [d (sha "c")]
    (store-package! "server" "0.1.0" d server-pkg)
    (let [proj (Path/join cache "proj2")]
      (File/mkdir_p! proj)
      (lock! proj [["server" "0.1.0" d]])

      (let [r (compile! proj)
            app (consulted-app
                  (Path/join (Path/join (ebin-path "server" "0.1.0" d) "ebin") "server.app"))
            apps (vec (prop (:props app) :applications))]

        (is (= :compiled (:state (get (:by-name r) "server"))) (pr-str (:results r)))

        (is (has? apps :logger))
        (is (has? apps :thousand_island))
        (is (has? apps :plug))
        (is (not (has? apps :req)))
        (is (not (has? apps :ex_doc)))
        (is (not (has? apps :jason)))))))

(deftest a-second-run-is-cached-and-a-broken-package-is-reported-without-ending-the-run
  (let [good (sha "b")
        bad (sha "c")]
    (store-package! "good" "0.1.0" good elixir-pkg)
    (store-package! "broken" "0.1.0" bad broken-pkg)

    (let [proj (Path/join cache "proj3")]
      (File/mkdir_p! proj)
      (lock! proj [["good" "0.1.0" good] ["broken" "0.1.0" bad]])

      (let [r (compile! proj)
            broken (:why (get (:by-name r) "broken"))]

        (is (not (:ok? r)) "a package that will not compile must make the run report failure")
        (is (= :compiled (:state (get (:by-name r) "good"))))
        (is (= :failed (:state (get (:by-name r) "broken"))))
        (is (string? broken) (str "a failure must carry a reason, got " (pr-str broken)))

        ; the marker is the proof a compile FINISHED, so the broken one has none
        (is (File/exists? (Path/join (ebin-path "good" "0.1.0" good) ".compiled")))
        (is (not (File/exists? (Path/join (ebin-path "broken" "0.1.0" bad) ".compiled"))))

        ; second run: the good one is cache, not work
        (let [r2 (compile! proj)]
          (is (= :cached (:state (get (:by-name r2) "good"))))
          (is (= :failed (:state (get (:by-name r2) "broken")))))))))

(deftest an-erlang-package-compiles-through-erlc-and-its-app-src-is-honoured
  (let [d (sha "d")]
    (store-package! "thing_erl" "0.2.0" d erlang-pkg)
    (let [proj (Path/join cache "proj4")]
      (File/mkdir_p! proj)
      (lock! proj [["thing_erl" "0.2.0" d]])

      (let [r (compile! proj)
            app-dir (ebin-path "thing_erl" "0.2.0" d)
            app (consulted-app (Path/join (Path/join app-dir "ebin") "thing_erl.app"))]

        (is (:ok? r) (str "erlc path refused: " (pr-str (:results r))))
        (is (= :compiled (:state (get (:by-name r) "thing_erl"))))
        (is (= :erlang (:tool (get (:by-name r) "thing_erl"))))

        (is (File/exists? (Path/join app-dir "ebin/thing_erl.beam")))

        (is (:ok? app))
        (is (= :application (:term app)))
        (is (= :thing_erl (:app app)))
        (is (= [:thing_erl] (vec (prop (:props app) :modules))))
        ; the lock's version wins over the .app.src's, because the lock is the truth
        (is (= "0.2.0" (erlang/list_to_binary (prop (:props app) :vsn))))))))

(def mixed-pkg
  [["mix.exs" "defmodule DepsCompileMixed.MixProject do\n  use Mix.Project\n  def project, do: [app: :mixed, version: \"0.3.0\"]\nend\n"]
   ["src/mixed_nif.erl" "-module(mixed_nif).\n-export([platform/0]).\nplatform() -> desk.\n"]
   ["lib/mixed.ex" "defmodule Mixed do\n  @p :mixed_nif.platform()\n  def platform, do: @p\nend\n"]])

(deftest a-mix-package-compiles-erlang-before-elixir
  (let [d (sha "e") proj (Path/join cache "proj-mixed")]
    (store-package! "mixed" "0.3.0" d mixed-pkg)
    (File/mkdir_p! proj)
    (lock! proj [["mixed" "0.3.0" d]])
    (let [r (compile! proj) app-dir (ebin-path "mixed" "0.3.0" d)
          app (consulted-app (Path/join app-dir "ebin/mixed.app"))]
      (is (:ok? r) (pr-str (:results r)))
      (is (= 2 (:modules (get (:by-name r) "mixed"))))
      (is (File/exists? (Path/join app-dir "ebin/mixed_nif.beam")))
      (is (File/exists? (Path/join app-dir "ebin/Elixir.Mixed.beam")))
      (is (= #{:mixed_nif :Elixir.Mixed} (set (prop (:props app) :modules)))))))

(deftest test-tooling-is-skipped-only-when-exunit-is-absent
  (let [kase (Path/join cache "case.ex") plain (Path/join cache "plain.ex")]
    (File/write! kase "defmodule C do\n  use ExUnit.CaseTemplate\nend\n")
    (File/write! plain "defmodule P do\n  def x, do: :ExUnit\nend\n")
    (is (dc/test-support? kase false))
    (is (not (dc/test-support? kase true)))
    (is (not (dc/test-support? plain false)))))
