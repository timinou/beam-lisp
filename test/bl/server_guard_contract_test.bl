(ns server.guard-contract-test
 (:require [server-clause :as clause] [system.model :as model] [js.actor :as actor]))

(defn source [position guard]
 (str "(defserver guarded_" (System/unique_integer (list :positive))
  " (init [observer] (Process/put :guard-observer observer) (ok 10))"
  " (handle-call [:take n]"
  (when (= position :before) (str " :when " guard)) " [_ state]"
  (when (= position :after) (str " :when " guard))
  " (erlang/send (Process/get :guard-observer) :entered) (reply :accepted (- state n)))"
  " (handle-call [:take _] [_ state] (reply :refused state))"
  " (handle-call :read [_ state] (reply state state)))"))

(deftest both-guard-spellings-refuse-before-handler-effects
 (doseq [position [:before :after]]
  (let [p (core/start (BeamLisp/eval (source position "(and (int? n) (> n 0) (>= state n))")) (erlang/self))]
   (try
    (doseq [bad ["wrong" nil 0 -1 11]]
     (is (= :refused (GenServer/call p [:take bad])))
     (is (= :quiet (receive :entered :effect (after 0 :quiet)))))
    (is (= 10 (GenServer/call p :read)))
    (is (= :accepted (GenServer/call p [:take 3])))
    (is (= :entered (receive :entered :entered (after 1000 :missing))))
    (is (= 7 (GenServer/call p :read)))
    (finally (GenServer/stop p))))))

(deftest explicit-nil-and-false-guards-are-not-unguarded
 (doseq [position [:before :after] guard ["nil" "false"]]
  (let [p (core/start (BeamLisp/eval (source position guard)) (erlang/self))]
   (try
    (is (= :refused (GenServer/call p [:take 1])))
    (is (= 10 (GenServer/call p :read)))
    (is (= :quiet (receive :entered :effect (after 0 :quiet))))
    (finally (GenServer/stop p))))))

(deftest nil-guards-also-remain-false-for-functions-and-selective-receive
 (is (= :correct (BeamLisp/eval "((fn ([x] :when nil :wrong) ([_] :correct)) 1)")))
 (is (= :correct (BeamLisp/eval "(do (erlang/send (erlang/self) :guard-probe) (receive :guard-probe :when nil :wrong :guard-probe :correct))"))))

(deftest shared-parser-refuses-ambiguous-or-incomplete-declarations
 (doseq [tail ['(:when (int? n) [_ state] :when true :body)
               '([_ state] :when)
               '(:when)
               '(:when true)
               '([_ state] :when true)
               '(not-a-vector :body)]]
  (is (try (clause/data-tail tail) false
        (catch e (= :invalid-server-clause (:kind (ex-data e))))))))

(deftest analysis-and-javascript-lowering-use-the-same-guard
 (doseq [position [:before :after]]
  (let [src (source position "(and (int? n) (> n 0) (>= state n))")
        node (first (BeamLisp.Reader/read_string src))
        transition (first (filter #(= :take (:label %)) (model/transitions node)))
        spelling (if (= position :before)
                   '(handle-call [:take n] :when (and (int? n) (> n 0) (>= state n)) [_ state] (reply :ok state))
                   '(handle-call [:take n] [_ state] :when (and (int? n) (> n 0) (>= state n)) (reply :ok state)))
        arm (actor/lower-arm spelling 'loop 'current 'ref "guard-test")]
   (is (= true (:guarded? transition)))
   (is (= "(and (int? n) (> n 0) (>= state n))" (:guard transition)))
   (is (= 4 (count arm)))
   (is (= :when (second arm)))
   (is (= '(and (int? n) (> n 0) (>= current n)) (nth arm 2)))
   (is (not (includes? (pr-str (last arm)) ":when"))))))
