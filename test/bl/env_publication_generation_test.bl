(ns test.env-publication-generation)

(deftest publication-evidence-follows-definitions-not-instances
  (let [e (BeamLisp.Env/fork)]
    (try
      (BeamLisp.Env/with_env e
        (fn []
          (let [names '("generation.fixture")
                initial (BeamLisp.Env/namespace_generations names)]
            (is (some? initial))
            (BeamLisp.Env/put_key (tuple :per_env_instance "generation.fixture" "memo") :initialized)
            (is (= initial (BeamLisp.Env/namespace_generations names)))
            (BeamLisp.Env/intern "generation.other" "x" :other)
            (is (= initial (BeamLisp.Env/namespace_generations names)))
            (BeamLisp.Env/intern "generation.fixture" "x" :first)
            (let [published (BeamLisp.Env/namespace_generations names)]
              (is (not= initial published))
              (BeamLisp.Env/delete_key (tuple "generation.fixture" "x"))
              (is (not= published (BeamLisp.Env/namespace_generations names))))
            (let [before-bulk (BeamLisp.Env/namespace_generations names)]
              (BeamLisp.Env/match_delete_own (tuple :_ :_))
              (is (not= before-bulk (BeamLisp.Env/namespace_generations names)))))))
      (finally (BeamLisp.Env/destroy e)))))

(deftest destroyed-captured-environments-decline-evidence
  (let [outer (BeamLisp.Env/capture) e (BeamLisp.Env/fork)
        token (BeamLisp.Env/with_env e (fn [] (BeamLisp.Env/capture)))]
    (try
      (BeamLisp.Env/destroy e)
      (is (= 0 (ets/select_count :beam_lisp_vars
                  (list (tuple (tuple :"$1" :_ :_)
                               (list (tuple :andalso
                                            (tuple :is_tuple :"$1")
                                            (tuple :== (tuple :element 1 :"$1") (tuple :const e))))
                               (list true))))))
      (BeamLisp.Env/bind token)
      (is (nil? (BeamLisp.Env/namespace_generations '("generation.fixture"))))
      (finally (BeamLisp.Env/bind outer)))))
