(ns aot.cached-table-detachment-test)

(defn clause [name value]
 (BeamLisp.Emit/function_clause name (BeamLisp.Emit/lit value)))
(defn definitions [mod name value]
 {(erlang/atom_to_binary name :utf8)
  (list (tuple :fixed 0 name (clause name value) mod))})
(defn provider-beam [mod name value defs]
 (BeamLisp.Emit/compile_descriptor
  (BeamLisp.Emit/descriptor_for mod
   (list (clause name value)
         (clause :__bl_ns_defs__ defs)
         (clause :__bl_init__ :ok)))))

(deftest cached-shim-replacement-preserves-other-scopes-lazy-metadata
 (let [ns (str "navigation.cached-table-p" (System/unique_integer (list :positive)))
       mod (BeamLisp.Emit/module_for ns)
       old-scope (BeamLisp.Env/fork) new-scope (BeamLisp.Env/fork)
       old-defs (definitions mod :old_value 11)
       new-defs (definitions mod :new_value 22)
       initial (provider-beam mod :old_value 11 old-defs)
       replacement (provider-beam mod :new_value 22 new-defs)
       directory (Path/join (System/tmp_dir!) (str "aot-table-" (System/unique_integer (list :positive))))
       filename (str (erlang/atom_to_binary mod :utf8) ".beam")]
  (try
   (File/mkdir_p! directory)
   (BeamLisp.Emit/load_binary! initial)
   (BeamLisp.Env/with_env old-scope (fn [] (BeamLisp.Env/link_ns_defs ns mod)))
   (is (= old-defs (BeamLisp.Env/with_env old-scope (fn [] (BeamLisp.Env/ns_defs ns)))))
   (File/write! (Path/join directory filename) (elem replacement 1))
   (is (= :ok (BeamLisp.Env/with_env new-scope
    (fn []
     ;; The old ABI permits an actual negative reproduction before the fix.
     ;; The new ABI explicitly carries namespace ownership, not ambient state.
     (if (erlang/function_exported :Elixir.BeamLisp.AOT :load_cached_entry 4)
      (erlang/apply :Elixir.BeamLisp.AOT :load_cached_entry
                    (list ns (list mod) directory directory))
      (erlang/apply :Elixir.BeamLisp.AOT :load_cached_entry
                    (list (list mod) directory directory)))))))
   (is (= 22 (erlang/apply mod :new_value (list))))
   (is (= old-defs (BeamLisp.Env/with_env old-scope (fn [] (BeamLisp.Env/ns_defs ns)))))
   (finally
    (BeamLisp.Env/destroy old-scope)
    (BeamLisp.Env/destroy new-scope)
    (code/purge mod)
    (code/delete mod)
    (File/rm_rf! directory)))))

(deftest retired-cache-replay-never-loads-or-initializes
 (let [ns (str "navigation.retired-cache-p" (System/unique_integer (list :positive)))
       mod (BeamLisp.Emit/module_for ns)
       scope (BeamLisp.Env/fork)
       marker (tuple :retired_cache_initialized mod)
       directory (Path/join (System/tmp_dir!) (str "retired-cache-" (System/unique_integer (list :positive))))
       beam (BeamLisp.Emit/compile_descriptor
              (BeamLisp.Emit/descriptor_for mod
               (list (BeamLisp.Emit/function_clause :__bl_init__
                       (BeamLisp.Emit/remote :erlang :put
                        (list (BeamLisp.Emit/lit marker) (BeamLisp.Emit/lit true)))))))]
  (try
   (File/mkdir_p! directory)
   (File/write! (Path/join directory (str (erlang/atom_to_binary mod :utf8) ".beam")) (elem beam 1))
   (BeamLisp.Env/destroy scope)
   (is (= :retired
    (try
     (BeamLisp.Env/with_env scope
      (fn []
       (if (erlang/function_exported :Elixir.BeamLisp.AOT :load_cached_entry 4)
        (erlang/apply :Elixir.BeamLisp.AOT :load_cached_entry
                      (list ns (list mod) directory directory))
        (erlang/apply :Elixir.BeamLisp.AOT :load_cached_entry
                      (list (list mod) directory directory)))))
     :incorrect
     (catch _ :retired))))
   (is (= false (code/is_loaded mod)))
   (is (nil? (Process/get marker)))
   (finally
    (BeamLisp.Env/destroy scope)
    (Process/delete marker)
    (code/purge mod)
    (code/delete mod)
    (File/rm_rf! directory)))))

(deftest cached-unit-preserves-every-provider-not-only-the-requested-namespace
 (let [suffix (str (System/unique_integer (list :positive)))
       first-ns (str "navigation.cached-unit-one-p" suffix)
       second-ns (str "navigation.cached-unit-two-p" suffix)
       old-scope (BeamLisp.Env/fork) new-scope (BeamLisp.Env/fork)
       directory (Path/join (System/tmp_dir!) (str "cached-unit-" suffix))
       providers (mapv (fn [[ns old-value new-value]]
                    (let [mod (BeamLisp.Emit/module_for ns)
                          old (definitions mod :old_value old-value)
                          new (definitions mod :new_value new-value)]
                     [ns mod old (provider-beam mod :old_value old-value old)
                      (provider-beam mod :new_value new-value new) new-value]))
                    [[first-ns 11 22] [second-ns 33 44]])]
  (try
   (File/mkdir_p! directory)
   (doseq [[ns mod old initial replacement _] providers]
    (BeamLisp.Emit/load_binary! initial)
    (BeamLisp.Env/with_env old-scope (fn [] (BeamLisp.Env/link_ns_defs ns mod)))
    (is (= old (BeamLisp.Env/with_env old-scope (fn [] (BeamLisp.Env/ns_defs ns)))))
    (File/write! (Path/join directory (str (erlang/atom_to_binary mod :utf8) ".beam")) (elem replacement 1)))
   (is (= :ok (BeamLisp.Env/with_env new-scope
    (fn []
     (if (erlang/function_exported :Elixir.BeamLisp.AOT :load_cached_entry 4)
      (erlang/apply :Elixir.BeamLisp.AOT :load_cached_entry
       (list first-ns (mapv second providers) directory directory))
      (erlang/apply :Elixir.BeamLisp.AOT :load_cached_entry
       (list (mapv second providers) directory directory)))))))
   (doseq [[ns mod old _ _ new-value] providers]
    (is (= new-value (erlang/apply mod :new_value (list))))
    (is (= old (BeamLisp.Env/with_env old-scope (fn [] (BeamLisp.Env/ns_defs ns))))))
   (finally
    (BeamLisp.Env/destroy old-scope)
    (BeamLisp.Env/destroy new-scope)
    (doseq [[_ mod] providers] (code/purge mod) (code/delete mod))
    (File/rm_rf! directory)))))

(deftest missing-provider-is-frozen-empty-before-it-is-ever-loaded
 (let [ns (str "navigation.absent-provider-p" (System/unique_integer (list :positive)))
       mod (BeamLisp.Emit/module_for ns)
       scope (BeamLisp.Env/fork)
       defs (definitions mod :new_value 55)
       beam (provider-beam mod :new_value 55 defs)]
  (try
   (BeamLisp.Env/with_env scope (fn [] (BeamLisp.Env/put_ns_defs ns (tuple :"$beam" mod))))
   (is (= {} (BeamLisp.Env/with_env scope (fn [] (BeamLisp.Env/ns_defs ns)))))
   (is (= :ok (BeamLisp.Env/publish_binaries! (list beam) "absent-provider-probe")))
   (is (= 55 (erlang/apply mod :new_value (list))))
   (is (= {} (BeamLisp.Env/with_env scope (fn [] (BeamLisp.Env/ns_defs ns)))))
   (finally
    (BeamLisp.Env/destroy scope)
    (code/purge mod)
    (code/delete mod)))))

(defn wait-for-scope-reader [pid]
 (let [deadline (+ 5000 (erlang/monotonic_time :millisecond))]
  (loop []
   (let [info (erlang/process_info pid :current_stacktrace)
         blocked? (and (tuple? info)
                    (some (fn [frame]
                      (and (= :Elixir.BeamLisp.Env (elem frame 0))
                           (contains? #{:acquire_local_lock :acquire_scope_lock :with_local_lock} (elem frame 1))))
                     (elem info 1)))]
    (cond blocked? :waiting
          (> (erlang/monotonic_time :millisecond) deadline) (throw (ex-info "reader barrier timeout" {:frames (when (tuple? info) (mapv (fn [f] [(elem f 0) (elem f 1) (elem f 2)]) (elem info 1)))}))
          :else (do (Process/sleep 1) (recur)))))))

(deftest reader-rechecks-lazy-root-after-waiting-for-owner-scope
 (doseq [round (range 10) kind [:whole :selected :count]]
  (let [suffix (str (System/unique_integer (list :positive)))
        ns (str "navigation.waiting-reader-p" suffix)
        mod (BeamLisp.Emit/module_for ns)
        old-scope (BeamLisp.Env/fork) new-scope (BeamLisp.Env/fork)
        old-defs (definitions mod :old_value 11)
        new-defs (merge (definitions mod :new_value 22) (definitions mod :extra_value 33))
        initial (provider-beam mod :old_value 11 old-defs)
        replacement (BeamLisp.Emit/compile_descriptor
                     (BeamLisp.Emit/descriptor_for mod
                      (list (clause :new_value 22) (clause :extra_value 33)
                            (clause :__bl_ns_defs__ new-defs) (clause :__bl_init__ :ok))))
        expected (case kind :whole old-defs :selected (get old-defs "old_value") :count 1)
        reader (atom nil) publisher (atom nil)
        parent (erlang/self) acquired-row (atom nil)]
   (try
    (BeamLisp.Emit/load_binary! initial)
    (BeamLisp.Env/with_env old-scope (fn [] (BeamLisp.Env/link_ns_defs ns mod)))
    ;; Hold the owner scope until the reader has captured the lazy root and is
    ;; waiting at its lock. Suspend ONLY this owned reader, then release scope.
    ;; Publication must complete while the reader still owns its namespace lock.
    (is (= 1 (erlang/trace_pattern (tuple :Elixir.BeamLisp.Env :acquire_local_lock 1) true (list :local))))
    (BeamLisp.Env/with_scope_commit old-scope
     (fn []
      (let [task (Task/async (fn []
                    (erlang/trace (erlang/self) true (list :call (tuple :tracer parent)))
                    (BeamLisp.Env/with_env old-scope
                     (fn [] (case kind :whole (BeamLisp.Env/ns_defs ns)
                                      :selected (BeamLisp.Env/ns_definition ns "old_value")
                                      :count (BeamLisp.Env/ns_definition_count ns))))))]
       (reset! reader task)
       (is (= :waiting (wait-for-scope-reader (:pid task))))
       (is (= true (erlang/suspend_process (:pid task))))
       (reset! acquired-row
         (receive [:trace _ :call mfa] (first (elem mfa 2))
                  (after 5000 :trace_timeout)))
       (erlang/trace (:pid task) false (list :call))
       (is (= (tuple (tuple :bl_scope_commit_lock :Elixir.BeamLisp.Env old-scope) (:pid task))
              (tuple (elem @acquired-row 0) (elem @acquired-row 1)))))))
    (let [task (Task/async (fn [] (BeamLisp.Env/with_env new-scope
                                  (fn [] (BeamLisp.Env/publish_binaries!
                                           (list replacement) "waiting-reader-probe")))))
          _ (reset! publisher task)
          published (Task/yield task 5000)]
     (is (= (tuple :ok :ok) published))
     (erlang/resume_process (:pid @reader))
     (let [result (Task/yield @reader 5000)]
      (when (nil? result)
       (let [before (erlang/process_info (:pid @reader) :reductions)
             _ (Process/sleep 100)
             after (erlang/process_info (:pid @reader) :reductions)
             info (erlang/process_info (:pid @reader) :current_stacktrace)]
        (throw (ex-info "resumed reader timeout"
                {:kind kind :round round :acquired-row @acquired-row :reductions-before before :reductions-after after
                 :all-locks (Enum/filter (ets/tab2list :beam_lisp_vars)
                              (fn [r] (let [k (elem r 0)]
                                (and (tuple? k) (> (erlang/tuple_size k) 0)
                                     (contains? #{:bl_scope_commit_lock :bl_native_publication_lock} (elem k 0))))))
                 :lock-markers (let [d (erlang/process_info (:pid @reader) :dictionary)]
                                 (when (tuple? d)
                                  (Enum/filter (elem d 1)
                                   (fn [r] (let [k (elem r 0)]
                                     (and (tuple? k) (> (erlang/tuple_size k) 0)
                                      (contains? #{:bl_scope_commit_held :bl_native_publication_held} (elem k 0))))))))
                 :old-scope old-scope
                 :status (erlang/process_info (:pid @reader) :status)
                 :scope-lock (ets/lookup :beam_lisp_vars
                               (tuple :bl_scope_commit_lock :Elixir.BeamLisp.Env old-scope))
                 :frames (when (tuple? info)
                           (mapv (fn [f] [(elem f 0) (elem f 1) (elem f 2)]) (elem info 1)))}))))
      (is (= (tuple :ok expected) result)))
     (when (nil? published) (Task/await task 5000)))
    (finally
     (erlang/trace_pattern (tuple :Elixir.BeamLisp.Env :acquire_local_lock 1) false (list :local))
     (when @reader
      (try (erlang/resume_process (:pid @reader)) (catch _ nil))
      (Task/shutdown @reader :brutal_kill))
     (when @publisher (Task/shutdown @publisher :brutal_kill))
     (BeamLisp.Env/destroy old-scope)
     (BeamLisp.Env/destroy new-scope)
     (code/purge mod)
     (code/delete mod))))))

(deftest killed-lazy-pointer-writer-does-not-strand-physical-provider-ownership
 (let [ns (str "navigation.provider-owner-p" (System/unique_integer (list :positive)))
       mod (BeamLisp.Emit/module_for ns)
       old-scope (BeamLisp.Env/fork) new-scope (BeamLisp.Env/fork)
       old-defs (definitions mod :old_value 11)
       replacement (provider-beam mod :new_value 22 (definitions mod :new_value 22))
       key (tuple :bl_native_publication_lock :Elixir.BeamLisp.Env mod)
       worker (atom nil)]
  (try
   (BeamLisp.Emit/load_binary! (provider-beam mod :old_value 11 old-defs))
   (BeamLisp.Env/with_env old-scope (fn [] (BeamLisp.Env/link_ns_defs ns mod)))
   (BeamLisp.Env/with_scope_commit old-scope
    (fn []
     (let [pid (spawn (fn [] (BeamLisp.Env/with_env old-scope
                              (fn [] (BeamLisp.Env/put_ns_defs ns (tuple :"$beam" mod))))))
           monitor (erlang/monitor :process pid)
           deadline (+ 5000 (erlang/monotonic_time :millisecond))]
      (reset! worker pid)
      (is (= :owned
       (loop []
        (let [rows (ets/lookup :beam_lisp_vars key)]
         (cond (and (seq rows) (= pid (elem (first rows) 1))) :owned
               (> (erlang/monotonic_time :millisecond) deadline) :timeout
               :else (do (Process/sleep 1) (recur)))))))
      (erlang/exit pid :kill)
      (is (= :killed (receive [:DOWN _ :process _ reason] reason (after 5000 :timeout)))))))
   (is (= :ok (BeamLisp.Env/with_env new-scope
                (fn [] (BeamLisp.Env/publish_binaries! (list replacement) "provider-owner-probe")))))
   (is (= 22 (erlang/apply mod :new_value (list))))
   (is (= old-defs (BeamLisp.Env/with_env old-scope (fn [] (BeamLisp.Env/ns_defs ns)))))
   (is (= (list) (ets/lookup :beam_lisp_vars key)))
   (finally
    (when @worker (erlang/exit @worker :kill))
    (BeamLisp.Env/destroy old-scope)
    (BeamLisp.Env/destroy new-scope)
    (code/purge mod)
    (code/delete mod)))))

(deftest contended-retry-consumes-only-its-own-timer-event
 ;; Pinned host private helpers are exported by the emitter; this is a focused
 ;; protocol check, not a new public application API.
 (let [foreign (erlang/make_ref)]
  (erlang/send (erlang/self) (tuple :timeout foreign :bl_local_lock_retry))
  (is (= :ok (BeamLisp.Env/wait_for_local_lock_retry)))
  (is (= :preserved
        (receive [:timeout observed :bl_local_lock_retry]
                 :when (== observed foreign) :preserved
                 (after 0 :missing))))))
