; Production strict fusion: definition-scope callback aliases + private
; let-bound map->fold. Always on (no option). Every case is differential:
; baseline (:enabled? false) vs the default optimizer, over normal compiled source.
(ns optimizer.lexical-prototype-test
  (:require [optimize :as o] [anf :as a] [compiler :as c] [lower :as l]))

(defn- fresh [stem]
  (erlang/binary_to_atom (str "Elixir.OptimizerLexical." stem "." (erlang/unique_integer (list :positive)))))

(defn- descriptor [source]
  (c/reset-fresh!)
  (a/module (fresh "Image")
    (list {:op :defn-clause :fname :run :params (list) :guard nil
           :body (c/compile-node (BeamLisp.Reader/read_one source) (c/new-env "user")) :ann {}})
    (list [:run 0]) (list)))

(defn- emit [m enabled opts]
  (let [pair (l/descriptor->beam m (assoc opts :enabled? enabled))]
    (is (= (tuple :module (elem pair 0)) (code/load_binary (elem pair 0) '() (elem pair 1))))
    pair))
(defn- baseline [source] (erlang/apply (elem (emit (descriptor source) false {}) 0) :run '()))
(defn- enabled [source] (erlang/apply (elem (emit (descriptor source) true {}) 0) :run '()))
(defn- outcome [f args]
  (try [:ok (erlang/apply f args)] (catch-raw [kind reason stack] [kind reason])))
(defn- run-outcome [source enabled? opts]
  (let [mod (elem (emit (descriptor source) enabled? opts) 0)]
    (try
      (let [value (erlang/apply mod :run '())]
        [:ok (if (erlang/is_function value 0) [:callable-result (erlang/apply value '())] value)])
      (catch-raw [kind reason stack] [kind reason]))))
(defn- same? [source]
  (= (run-outcome source false {}) (run-outcome source true {})))
(defn- rules-used [source] (set (map :rule (:evidence (o/explain (descriptor source) {})))))
(defn- refusal-reasons [source] (set (map :reason (:refusals (o/explain (descriptor source) {})))))

(defn- instructions [beam]
  (let [image (beam_disasm/file beam)]
    (mapcat (fn [f] (nth (erlang/tuple_to_list f) 4)) (nth (erlang/tuple_to_list image) 5))))
(defn- references? [beam module fun arity]
  (some (fn [ins] (and (erlang/is_tuple ins)
                      (some (fn [v] (= v (tuple :extfunc module fun arity))) (erlang/tuple_to_list ins))))
        (instructions beam)))

(deftest alias-chain-and-private-map-emit-one-fold
  (let [src (str "(let [f (fn [x a] (+ a x)) g f h g m (fn [x] (* x 2)) n m "
                 "xs (lists/map n (lists/seq 0 64))] (lists/foldl h 0 xs))")
        beam (elem (emit (descriptor src) true {}) 1)]
    (is (= 4160 (enabled src)))
    (is (= (baseline src) (enabled src)))
    (is (contains? (rules-used src) :strict-map-fold))
    (is (not (references? beam :lists :map 2)))
    (is (references? beam :lists :foldl 3))
    ; the strict intermediate stays in the baseline image
    (is (references? (elem (emit (descriptor src) false {}) 1) :lists :map 2)))
  ; alias-only standalone fold: callback identity is kept, never cloned
  (let [src "(let [f (fn [x a] (+ a x)) g f] (lists/foldl g 0 (lists/seq 0 31)))"
        m (descriptor src) r (o/explain m {})]
    (is (= (baseline src) (enabled src)))
    (is (not (contains? (set (map :rule (:evidence r))) :integer-callback)))
    (is (= 0 (:inlined-nodes (:stats r))))
    (is (contains? (refusal-reasons src) :callback-rematerialization-not-profitable))
    (is (= (:descriptor r) (o/module m {:enabled? false}))))
  ; unsafe alias keeps its safety refusal, not the profitability label
  (let [src "(let [k 3 g (fn [x a] (+ a (* x k)))] (lists/foldl g 0 (lists/seq 0 5)))"]
    (is (not (contains? (refusal-reasons src) :callback-rematerialization-not-profitable))))
  ; literal standalone fold still specializes
  (let [src "(lists/foldl (fn [x a] (+ a x)) 0 (lists/seq 0 31))"]
    (is (contains? (rules-used src) :integer-callback))))

(deftest default-recognizes-strict-fusion-and-disabled-is-baseline
  (let [m (descriptor (str "(let [xs (lists/map (fn [x] (* x 2)) (lists/seq 0 8))] "
                           "(lists/foldl (fn [x a] (+ a x)) 0 xs))"))]
    (is (= (o/module m) (o/module m {})))
    (is (not= (o/module m) (o/module m {:enabled? false})))
    (is (contains? (set (map :rule (:evidence (o/explain m)))) :strict-map-fold))
    (is (not (contains? (set (map :rule (:evidence (o/explain m {:enabled? false})))) :strict-map-fold)))))

(deftest integer-domains-negative-bignum-and-noncommutative-folds
  (doseq [[init lo hi] [[0 -5 5] [123456789012345678901234567890 0 40] [-7 -40 -1] [0 3 2]]
          fold ["(- a x)" "(- x a)" "(+ (* a 3) x)" "(- (* x x) a)"]]
    (let [src (str "(let [g (fn [x a] " fold ") m (fn [x] (- (* x 3) 11)) xs (lists/map m (lists/seq "
                   lo " " hi "))] (lists/foldl g " init " xs))")]
      (is (= (run-outcome src false {}) (run-outcome src true {})))
      (is (contains? (rules-used src) :strict-map-fold))))
  (let [src "(let [m (fn [x] (* x 4611686018427387904)) xs (lists/map m (lists/seq 1 9))] (lists/foldl (fn [x a] (+ a x)) 0 xs))"]
    (is (same? src))))

(deftest shadowing-never-uses-the-wrong-definition
  (doseq [src ["(let [f (fn [x a] (+ a x))] ((fn [f] (lists/foldl f 0 (lists/seq 0 3))) (fn [x a] (- a x))))"
               "(let [f (fn [x a] (+ a x)) f (fn [x a] (- a x))] (lists/foldl f 0 (lists/seq 0 3)))"
               "(let [f (fn [x a] (+ a x)) g f f (fn [x a] (- a x))] (lists/foldl g 0 (lists/seq 0 3)))"
               "(let [f (fn [x a] (+ a x)) g f] (let [f (fn [x a] (- a x))] (lists/foldl g 0 (lists/seq 0 3))))"
               "(let [f (fn [x a] (+ a x)) g f] ((fn [g] (lists/foldl g 0 (lists/seq 0 3))) (fn [x a] (* a 2))))"
               "(let [f (fn [x a] (+ a x)) g f] (case 7 g (lists/foldl g 0 (lists/seq 0 3))))"
               "(let [m (fn [x] (* x 2)) xs (lists/map m (lists/seq 0 3))] (let [m (fn [x] (- x)) xs xs] (lists/foldl (fn [x a] (+ a x)) 0 xs)))"
               "(let [xs (lists/map (fn [x] (* x 2)) (lists/seq 0 3))] (let [xs (lists/seq 0 2)] (lists/foldl (fn [x a] (+ a x)) 0 xs)))"]]
    (is (same? src) src))
  ; unknown rebinding of an alias name must not keep the old callback
  (let [src "(fn [h] (let [f (fn [x a] (+ a x)) f h] (lists/foldl f 0 (lists/seq 0 3))))"
        b (elem (emit (descriptor src) false {}) 0) e (elem (emit (descriptor src) true {}) 0)
        h (fn [x a] (- a x)) f (erlang/apply b :run '()) g (erlang/apply e :run '())]
    (is (= (outcome f (list h)) (outcome g (list h))))
    (is (= -6 (erlang/apply g (list h))))
    (is (= (outcome f (list :not-a-fn)) (outcome g (list :not-a-fn))))))

(deftest multiple-use-escape-and-unsupported-shapes-refuse
  (doseq [src ["(let [xs (lists/map (fn [x] (* x 2)) (lists/seq 0 31))] [(lists/foldl (fn [x a] (+ a x)) 0 xs) xs])"
               "(let [xs (lists/map (fn [x] (* x 2)) (lists/seq 0 31))] (lists/foldl (fn [x a] (+ a x)) (lists/foldl (fn [x a] (+ a x)) 0 xs) xs))"
               "(let [xs (lists/map (fn [x] (* x 2)) (lists/seq 0 31))] xs)"
               "(let [xs (lists/map (fn [x] (* x 2)) (lists/seq 0 31))] {:k xs})"
               "(let [xs (lists/map (fn [x] (* x 2)) (lists/seq 0 31))] (fn [] (lists/foldl (fn [x a] (+ a x)) 0 xs)))"
               "(let [xs (lists/map (fn [x] (* x 2)) (lists/seq 0 31))] (do (lists/foldl (fn [x a] (+ a x)) 0 xs) 1))"
               "(let [xs (lists/map (fn [x] (* x 2)) (lists/seq 0 31))] (lists/foldl (fn [x a] (+ a x)) 0 (lists/reverse xs)))"
               "(let [xs (lists/map (fn [x] (* x 2)) (lists/seq 0 31))] (lists/foldl (fn [x a] (+ a x)) (erlang/length xs) xs))"
               "(let [f (fn [x a] (+ a x)) xs (lists/map (fn [x] (* x 2)) (lists/seq 0 31))] (lists/foldl f f xs))"
               "(let [xs (lists/map (fn [x] (* x 2)) (lists/seq 0 31))] (lists/foldl xs 0 xs))"]]
    (is (same? src) src)
    (is (not (contains? (rules-used src) :strict-map-fold)) src))
  ; the immediate let->fold shape with an unprovable init/domain reports a refusal
  (let [src "(let [xs (lists/map (fn [x] (+ x 1)) (lists/seq 0 5))] (lists/foldl (fn [x a] (+ a x)) (erlang/length xs) xs))"]
    (is (contains? (refusal-reasons src) :private-use-not-provable)))
  ; escaping callback: stored in a container, then folded
  (let [src "(let [f (fn [x a] (+ a x)) c [f]] (lists/foldl (first c) 0 (lists/seq 0 3)))"]
    (is (same? src))
    (is (not (contains? (rules-used src) :integer-callback)))))

(deftest effects-failure-and-order-stay-observable
  (let [seen (atom [])
        mark (fn [x] (swap! seen conj x) x)
        stop (fn [x] (swap! seen conj x) (throw x))
        sources ["(fn [mark] (let [xs (lists/map (fn [x] (* x 2)) (lists/seq 0 7))] (lists/foldl (fn [x a] (+ a x)) (mark 1) xs)))"
                 "(fn [mark] (let [xs (lists/map (fn [x] (* x 2)) (lists/seq 0 (mark 7)))] (lists/foldl (fn [x a] (+ a x)) (mark 1) xs)))"
                 "(fn [mark] (let [xs (lists/map (fn [x] (mark x)) (lists/seq 0 3))] (lists/foldl (fn [x a] (+ a x)) 0 xs)))"
                 "(fn [mark] (let [xs (lists/map (fn [x] (* x 2)) (lists/seq 0 7))] (lists/foldl (fn [x a] (+ a (mark x))) 0 xs)))"
                 "(fn [mark] (let [xs (lists/map (fn [x] (/ 1 x)) (lists/seq 0 3))] (lists/foldl (fn [x a] (+ a x)) 0 xs)))"
                 "(fn [mark] (let [xs (lists/map (fn [x] (* x 2)) (lists/seq 0 7))] (lists/foldl (fn [x a] (+ a x)) (/ 1 0) xs)))"
                 "(fn [mark] (let [xs (lists/map (fn [x] (* x 2)) (lists/seq 0 7))] (lists/foldl (fn [x a] (+ a x)) (let [t (mark 5)] (+ t 1)) xs)))"]]
    (doseq [src sources callable [mark stop]]
      (let [b (elem (emit (descriptor src) false {}) 0) e (elem (emit (descriptor src) true {}) 0)]
        (reset! seen [])
        (let [rb (outcome (erlang/apply b :run '()) (list callable)) tb @seen]
          (reset! seen [])
          (let [re (outcome (erlang/apply e :run '()) (list callable))]
            (is (= rb re) src)
            (is (= tb @seen) src)))))))

(deftest wildcard-parameters-keep-the-native-fun-abi
  (let [rf (a/fnn (list (a/clause (list (a/pvar "x") (a/pvar "a")) nil
                         (a/arith :add :+ (list (a/var "a") (a/var "x"))))))
        mf (a/fnn (list (a/clause (list (a/pvar "_")) nil
                         (a/arith :add :+ (list (a/var "_") (a/lit 1))))))
        source (a/remote :lists :seq (list (a/lit 0) (a/lit 3)))
        n (a/lett "m" mf
            (a/lett "xs" (a/remote :lists :map (list (a/var "m") source))
              (a/remote :lists :foldl (list rf (a/lit 0) (a/var "xs")))))]
    (is (= n (o/node n {})))
    (let [captured (a/lett "_" (a/lit 8) n)
          m (a/module (fresh "Wildcard")
              (list {:op :defn-clause :fname :run :params '() :guard nil :body captured :ann {}})
              (list [:run 0]) '())]
      (is (= 10 (erlang/apply (elem (emit m false {}) 0) :run '())))
      (is (= 10 (erlang/apply (elem (emit m true {}) 0) :run '()))))))

(deftest adversarial-fresh-names-do-not-capture
  (doseq [src ["(let [__bl_opt_mapped_0 (fn [x] (* x 2)) xs (lists/map __bl_opt_mapped_0 (lists/seq 0 9))] (lists/foldl (fn [x a] (+ a x)) 0 xs))"
               "(let [xs (lists/map (fn [__bl_opt_mapped_0] (* __bl_opt_mapped_0 2)) (lists/seq 0 9))] (lists/foldl (fn [__bl_opt_mapped_1 __bl_opt_mapped_2] (- __bl_opt_mapped_2 __bl_opt_mapped_1)) 0 xs))"
               "(let [__bl_opt_mapped_1 5 __bl_opt_mapped_2 7 xs (lists/map (fn [x] (+ x 1)) (lists/seq 0 9))] (lists/foldl (fn [x __bl_opt_mapped_0] (+ __bl_opt_mapped_0 x)) __bl_opt_mapped_1 xs))"
               "(let [xs (lists/map (fn [x] (let [__bl_opt_mapped_0 (+ x 1)] (* __bl_opt_mapped_0 x))) (lists/seq 0 9))] (lists/foldl (fn [x a] (let [__bl_opt_mapped_1 (+ x 1)] (- a __bl_opt_mapped_1))) 0 xs))"
               "(let [__bl_opt_arg_0 3 xs (lists/map (fn [x] (+ x __bl_opt_arg_0)) (lists/seq 0 9))] (lists/foldl (fn [x a] (+ a x)) 0 xs))"]]
    (is (same? src) src)))

(deftest domain-mismatch-and-captures-refuse
  (doseq [src ["(let [xs (lists/map (fn [x] (+ x 1)) '(1 :wrong 3))] (lists/foldl (fn [x a] (+ a x)) 0 xs))"
               "(let [xs (lists/map (fn [x] (+ x 1)) '(1.5 2.5))] (lists/foldl (fn [x a] (+ a x)) 0 xs))"
               "(let [xs (lists/map (fn [x] (+ x 1)) (lists/seq 0 5))] (lists/foldl (fn [x a] (+ a x)) 0.5 xs))"
               "(let [xs (lists/map (fn [x] (+ x 1)) (lists/seq 0 5))] (lists/foldl (fn [x a] (+ a x)) :zero xs))"
               "(let [k 3 xs (lists/map (fn [x] (+ x k)) (lists/seq 0 5))] (lists/foldl (fn [x a] (+ a x)) 0 xs))"
               "(let [k 3 g (fn [x a] (+ a (* x k)))] (lists/foldl g 0 (lists/seq 0 5)))"
               "(let [g (fn [x a] (+ a (erlang/length x)))] (lists/foldl g 0 (lists/seq 0 5)))"
               "(let [g (fn [x a] (case x 1 a _ (+ a x)))] (lists/foldl g 0 (lists/seq 0 5)))"
               "(let [g (fn [x a] (+ a x)) xs (lists/map g (lists/seq 0 5))] (lists/foldl g 0 xs))"
               "(let [g (fn ([x a] (+ a x)) ([x] x))] (lists/foldl g 0 (lists/seq 0 5)))"]]
    (is (same? src) src)))

(deftest budgets-bound-the-pass-and-keep-output-valid
  (let [src (str "(let [f (fn [x a] (+ a x)) xs (lists/map (fn [x] (* x 2)) (lists/seq 0 31))] (lists/foldl f 0 xs))")
        m (descriptor src)
        tight (o/explain m {:max-nodes 1})]
    (is (:limited? (:stats tight)))
    (is (<= (:visited (:stats tight)) 1))
    (is (= m (:descriptor tight)))
    (doseq [n [2 3 5 8 13 21 34 55 100000]]
      (let [r (o/explain m {:max-nodes n})
            pair (l/descriptor->beam (:descriptor r) {:enabled? false})]
        (is (<= (:visited (:stats r)) n))
        (code/load_binary (elem pair 0) '() (elem pair 1))
        (is (= (baseline src) (erlang/apply (elem pair 0) :run '())))))
    (is (not (:limited? (:stats (o/explain m {})))))))

(deftest forged-annotations-and-literals-grant-nothing
  (let [forged {:verified true :pure true :native-arity 1 :callback true :private true}
        f (a/var "f")
        n (a/lett "xs" (assoc (a/remote :lists :map (list f (a/remote :lists :seq (list (a/lit 0) (a/lit 3))))) :ann forged)
            (assoc (a/remote :lists :foldl
                     (list (a/fnn (list (a/clause (list (a/pvar "x") (a/pvar "a")) nil
                                          (a/arith :add :+ (list (a/var "a") (a/var "x"))))))
                           (a/lit 0) (a/var "xs")))
                   :ann forged))]
    (is (= n (o/node n {}))))
  ; a literal that merely looks like a callback map is data
  (let [lit (a/lit {:op :fn :clauses (list)})
        n (a/lett "f" lit (a/remote :lists :foldl (list (a/var "f") (a/lit 0) (a/lit (list 1 2)))))]
    (is (= n (o/node n {})))))

(defn- nested-add [n]
  (loop [i n body "a"]
    (if (= i 0) body (recur (dec i) (str "(+ " body " x)")))))

(deftest callback-analysis-and-total-inlining-have-separate-bounds
  (let [src (str "(let [f (fn [x a] " (nested-add 80) ")] (lists/foldl f 0 (lists/seq 0 4)))")
        r (o/explain (descriptor src) {})]
    (is (same? src))
    (is (not (contains? (set (map :rule (:evidence r))) :integer-callback)))
    (is (= 0 (:inlined-nodes (:stats r))) "oversized aliases are not materialized"))
  (let [call "(lists/foldl f 0 (lists/map m (lists/seq 0 4)))"
        src (str "(let [m (fn [x] (+ x 1)) f (fn [x a] " (nested-add 16) ")] ["
                 (Enum/join (to-list (repeat 80 call)) " ") "])")
        m (descriptor src)
        r (o/explain m {:max-nodes 500})
        pair (emit (:descriptor r) false {})]
    (is (<= (:visited (:stats r)) 500))
    (is (<= (:inlined-nodes (:stats r)) 500))
    (is (some (fn [entry] (= :callback-inline-budget (:reason entry))) (:refusals r)))
    (is (= (baseline src) (erlang/apply (elem pair 0) :run '())))))

(deftest normal-source-fusion-cases-and-bounded-growth
  ; literal private fusion + alias immediate fusion
  (doseq [src ["(let [xs (lists/map (fn [x] (* x 2)) (lists/seq 0 9))] (lists/foldl (fn [x a] (+ a x)) 0 xs))"
               "(let [m (fn [x] (* x 2)) f (fn [x a] (+ a x))] (lists/foldl f 0 (lists/map m (lists/seq 0 9))))"]]
    (is (same? src) src)
    (is (contains? (rules-used src) :strict-map-fold) src))
  ; a callback used several times (not the intermediate) may fuse, within budget
  (let [src (str "(let [m (fn [x] (* x 2)) f (fn [x a] (+ a x))] "
                 "[(lists/foldl f 0 (lists/map m (lists/seq 0 5))) (lists/foldl f 1 (lists/map m (lists/seq 0 6)))])")
        r (o/explain (descriptor src) {})]
    (is (same? src))
    (is (= 2 (count (filter (fn [e] (= :strict-map-fold (:rule e))) (:evidence r)))))
    (is (> (:inlined-nodes (:stats r)) 0)))
  ; repeated non-fusing aliases cannot grow output
  (let [call "(lists/foldl f 0 (lists/seq 0 4))"
        src (str "(let [f (fn [x a] " (nested-add 16) ")] [" (Enum/join (to-list (repeat 40 call)) " ") "])")
        m (descriptor src) r (o/explain m {})]
    (is (same? src))
    (is (= 0 (:inlined-nodes (:stats r))))
    (is (= (:descriptor r) (o/module m {:enabled? false}))))
  ; a post-shadowed definition never feeds the earlier callback
  (let [src "(let [f (fn [x a] (+ a x)) m (fn [x] (* x 2)) g f] (let [f (fn [x a] (- a x)) m (fn [x] x)] (lists/foldl g 0 (lists/map m (lists/seq 0 5)))))"]
    (is (same? src))))
