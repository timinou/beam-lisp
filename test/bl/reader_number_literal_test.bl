; test/bl/reader_number_literal_test.bl
;
;   ./bin/bl test test/bl/reader_number_literal_test.bl
;
; Integer spellings beyond decimal, as Clojure reads them:
;
;   0xD431 0XD431   hexadecimal           0666     octal (leading zero)
;   16rD431 2r101   radix 2..36           -0x10    a sign applies to all of them
;
; And the other half of the contract: a token that starts with a digit is a
; number or a reader error. It is never a symbol, so `0o666` cannot turn into
; "undefined var: x/0o666" at run time.

(ns reader-number-literal-test
  (:require [bl.test :refer [deftest is testing]]))

(defn- read-one [src] (BeamLisp.Reader/read_one src))

(defn- read-error
  "The message `src` is refused with, or nil when it reads."
  [src]
  (try
    (do (BeamLisp.Reader/read_string src "number_test.bl") nil)
    (catch e (ex-message e))))

(defn- contains-text? [s part]
  (and (string? s) (not= :nomatch (binary/match s part))))

(deftest hexadecimal
  (is (= 54321 (read-one "0xD431")))
  (is (= 54321 (read-one "0XD431")))
  (is (= 54321 (read-one "0xd431")))
  (is (= 0 (read-one "0x0")))
  (is (= -16 (read-one "-0x10")))
  (is (= 16 (read-one "+0x10")))
  (is (= 255 (read-one "0xFFN")))
  (is (= 18446744073709551615 (read-one "0xFFFFFFFFFFFFFFFF"))))

(deftest radix
  (is (= 54321 (read-one "16rD431")))
  (is (= 5 (read-one "2r101")))
  (is (= 438 (read-one "8r666")))
  (is (= 35 (read-one "36rZ")))
  (is (= 35 (read-one "36Rz")))
  (is (= -255 (read-one "-16rFF")))
  (is (= 255 (read-one "16rFFN")))
  ; in base 24 and above N is a digit, not the bigint suffix
  (is (= (+ (* 35 36) 23) (read-one "36rZN"))))

(deftest octal
  ; Clojure reads a leading 0 as octal: 0666 is 438, not 666.
  (is (= 438 (read-one "0666")))
  (is (= -8 (read-one "-010")))
  (is (= 7 (read-one "07N")))
  (is (= 0 (read-one "00"))))

(deftest decimal-is-unchanged
  (is (= 0 (read-one "0")))
  (is (= 42 (read-one "42")))
  (is (= -7 (read-one "-7")))
  (is (= 1.5 (read-one "1.5")))
  (is (= 0.5 (read-one "0.5")))
  (is (= 1000.0 (read-one "1e3")))
  (is (= 7 (read-one "7N"))))

(deftest digit-led-tokens-are-reader-errors
  (testing "a token that starts like a number is never read as a symbol"
    (doseq [bad ["0o666" "0b101" "08" "09N" "0x" "0xG" "1x" "37r1" "2r102" "-0o666" "1ab"]]
      (is (contains-text? (read-error bad) (str "invalid number literal: " bad)) bad)))
  (testing "the error names the file and position"
    (is (contains-text? (read-error "(ns x)\n(println 0o666)") "number_test.bl:2:10"))))

(deftest names-that-only-look-numeric-stay-symbols
  ; a sign followed by a digit and then punctuation is a name, as deodorant's
  ; `+1→inc` smells are
  (is (= [:symbol "+1→inc"] (vec (erlang/tuple_to_list (read-one "+1→inc")))))
  (is (= [:symbol "-"] (vec (erlang/tuple_to_list (read-one "-")))))
  (is (= [:symbol "+x"] (vec (erlang/tuple_to_list (read-one "+x"))))))

(deftest evaluates-in-code
  (is (= 54321 0xD431))
  (is (= 54321 16rD431))
  (is (= 438 0666))
  (is (= -16 -0x10)))
