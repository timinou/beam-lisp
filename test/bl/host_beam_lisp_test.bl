; Root BeamLisp host: exact API and bootstrap order, not a parallel runner.
(ns host.beam-lisp.test)

(def ^:private probe :Elixir.BeamLisp.RootProbe)
(def ^:private shim :Elixir.BeamLisp.Ns.Host.BeamLisp)

(defn- pin! []
  (let [dir (str (System/tmp_dir!) "/bl_root_probe_" (erlang/unique_integer (list :positive)))]
    (File/mkdir_p! dir)
    (let [res (BeamLisp.AOT/compile_host_file "priv/host/beam_lisp.bl"
                (list (tuple :module probe) (tuple :output_dir dir) (tuple :load? false)))
          path (elem res 1)]
      (code/purge probe)
      (code/delete probe)
      (code/load_binary probe (erlang/binary_to_list path) (File/read! path))
      (code/purge shim)
      (code/delete shim)
      dir)))

(deftest root-host-reproduces-public-surface-and-process-bindings
  (let [dir (pin!)
        public (list (tuple :argv 0) (tuple :cwd 0) (tuple :with_argv 2)
                     (tuple :with_cwd 2) (tuple :init 0) (tuple :eval 1)
                     (tuple :run_file 1) (tuple :repl 0))]
    (is (= :non_existing (code/which shim)))
    (is (every? (fn [e] (erlang/function_exported probe (elem e 0) (elem e 1))) public))
    (is (not (erlang/function_exported probe :__info__ 1)))
    (testing "command process state restores through both return and error"
      (let [orig-argv (BeamLisp/argv)
            orig-cwd (BeamLisp/cwd)]
        (is (= (list "a" "b")
               (erlang/apply probe :with_argv
                 (list (list "a" "b") (fn [] (erlang/apply probe :argv (list)))))))
        (is (= "/tmp"
               (erlang/apply probe :with_cwd
                 (list "/tmp" (fn [] (erlang/apply probe :cwd (list)))))))
        (is (= orig-argv (BeamLisp/argv)))
        (is (= orig-cwd (BeamLisp/cwd)))
        (try (erlang/apply probe :with_argv
               (list (list "bad") (fn [] (erlang/error :sentinel))))
             (catch e nil))
        (is (= orig-argv (BeamLisp/argv)))))
    (File/rm_rf! dir)))

(deftest root-host-evaluates-the-same-inputs-as-the-live-module
  (let [dir (pin!)
        path (str dir "/root_fixture.bl")]
    (is (= :ok (erlang/apply probe :init (list))))
    (is (= 42 (erlang/apply probe :eval (list "(+ 40 2)"))))
    (is (= (BeamLisp/eval "(+ 40 2)")
           (erlang/apply probe :eval (list "(+ 40 2)"))))
    (File/write! path "(ns host.root.fixture)\n(+ 5 6)\n")
    (is (= 11 (erlang/apply probe :run_file (list path))))
    (is (= 11 (BeamLisp/run_file path)))
    (File/rm_rf! dir)))

(deftest tagged-reader-registration-is-embedded-without-a-runtime-file-read
  (let [source (File/read! "priv/boot/data-readers.bl")
        host (File/read! "priv/host/beam_lisp.bl")]
    (is (String/contains? source "(data-reader! \"d\" (quote datom/read-query))"))
    (is (String/contains? source "(data-reader! \"time\" (quote datom.time/read-iso8601))"))
    (is (String/contains? host "datom/read-query"))
    (is (String/contains? host "datom.time/read-iso8601"))))

(deftest prelude-floor-members-require-current-manifest-bytes-and-live-code
  (let [dir (pin!)
        manifest (BeamLisp.Bootstrap/manifest)
        seed (BeamLisp.Bootstrap/seed_dir)
        module :Elixir.BeamLisp.CompilerData
        name "Elixir.BeamLisp.CompilerData.beam"
        actual (erlang/apply probe :floor-unit-beam! (list manifest seed module))
        changed (assoc manifest "modules" (assoc (get manifest "modules") name "wrong-digest"))]
    (try
      (is (= module (elem actual 0)))
      (is (= (File/read! (Path/join seed name)) (elem actual 1)))
      (is (= :refused (try (erlang/apply probe :floor-unit-beam! (list changed seed module))
                           (catch _ :refused))))
      (finally (File/rm_rf! dir)))))

(run-tests)
