; eval_module_release_test.bl — a long-lived VM does not keep a module per form.
;
; Every evaluated form compiles to its own module. Nearly all of them (a `def` of
; a literal, a `println`, an `ns`) return a plain value and are never called
; again, so `lower/eval-anf` unloads them once run/0 returns. A form that could
; have produced a closure keeps its module, because the closure's code lives
; there. Run: bin/bl test test/bl/eval_module_release_test.bl

(ns eval-module-release.test (:require [compiler :as c] [lower :as sc]))

(def kenv (assoc (c/new-env "user") :ns "user"))
(def ctr (atom 0))
(defn- fresh [] (erlang/binary_to_atom (str "bl_emr_" (swap! ctr inc))))
(defn- compile-anf [src] (c/compile (BeamLisp.Reader/read_one src) kenv))
(defn- loaded? [m] (erlang/module_loaded m))
(defn- run [src] (let [m (fresh)] [m (sc/eval-anf m (compile-anf src))]))

(deftest closure-free-form-is-unloaded
  (testing "a form that only computes a value leaves no module behind"
    (let [[m v] (run "(+ 40 2)")]
      (is (= 42 v))
      (is (not (loaded? m))))
    (let [[m v] (run "(let [x 5 y 3] (* x y))")]
      (is (= 15 v))
      (is (not (loaded? m))))
    (let [[m v] (run "(reduce + 0 [1 2 3 4 5])")]
      (is (= 15 v))
      (is (not (loaded? m))))))

(deftest closure-bearing-form-keeps-its-module
  (testing "the returned fn still runs: its code is in the module that was kept"
    (let [[m f] (run "(let [k :kept] (fn [x] [k x]))")]
      (is (loaded? m))
      (is (= [:kept 7] (f 7)))
      (is (= [:kept 9] (f 9))))))

(deftest release-decision-reads-the-loaded-module
  (testing "closure-free? is true exactly when run/0 is the only function"
    (let [plain (fresh) lam (fresh)]
      ;; build both modules WITHOUT running them, so nothing has released them
      (doseq [[m src] [[plain "(+ 1 2)"] [lam "(fn [x] x)"]]]
        (let [pair (sc/descriptor->beam
                     (BeamLisp.Ns.Anf/module m
                       (list {:op :defn-clause :fname :run :params (list) :guard nil
                              :body (compile-anf src) :ann {}})
                       (list [:run 0]) (list)))]
          (code/load_binary (elem pair 0) (erlang/binary_to_list "x.beam") (elem pair 1))))
      (is (sc/closure-free? plain))
      (is (not (sc/closure-free? lam)))
      (code/delete plain) (code/soft_purge plain)
      (code/delete lam) (code/soft_purge lam))))

(deftest raising-form-keeps-its-module
  (testing "a run/0 that raises still reports from code that is loaded"
    (let [m (fresh)]
      (is (thrown? (sc/eval-anf m (compile-anf "(throw (ex-info \"boom\" {}))"))))
      (is (loaded? m))
      (code/delete m)
      (code/soft_purge m))))

(deftest session-code-area-is-bounded
  (testing "a thousand value-only forms do not grow the loaded-module count"
    (let [before (count (code/all_loaded))]
      (doseq [i (range 1000)] (run (str "(+ " i " 1)")))
      (is (< (- (count (code/all_loaded)) before) 10)))))

(deftest defns-and-macros-survive-through-the-real-eval-path
  (testing "forms evaluated by eval_string keep working after later forms are released"
    (BeamLisp.Compiler/eval_string
      "(ns emr.live) (defn emr-add [a b] (+ a b)) (defmacro emr-twice [x] `(* 2 ~x))"
      kenv "emr.bl")
    (doseq [i (range 50)] (BeamLisp.Compiler/eval_string (str "(def emr-v" i " " i ")") kenv "emr.bl"))
    (is (= 5 (BeamLisp.Compiler/eval_string "(emr.live/emr-add 2 3)" kenv "emr.bl")))
    (is (= 14 (BeamLisp.Compiler/eval_string "(emr.live/emr-twice 7)" kenv "emr.bl")))
    (is (= 49 (BeamLisp.Compiler/eval_string "user/emr-v49" kenv "emr.bl")))))

(run-tests)
