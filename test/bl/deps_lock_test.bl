; test/bl/deps_lock_test.bl — `bl.lock`, the Mix-free lock, against `mix.lock`,
; the one Mix wrote.
;
; Ported from the ExUnit `test/beam_lisp/deps_lock_test.exs`; the assertions are
; the same ones, asked of the same files.
;
; The conversion is a change of FILE FORMAT, not a re-resolution: same names,
; same versions, same tarball digests. A conversion that drifted silently would
; be a lie about what a build installs, and nothing else in the tree would
; notice, so it is pinned here.
;
; WHICH digest is pinned matters, and the first version got it wrong in a way
; this test could not see because it made the same mistake: `mix.lock` carries
; TWO, and the 4th field is hex's deprecated INNER checksum (the value of the
; `CHECKSUM` file inside the tarball), while the 8th is sha256 of the tarball as
; served — what `bl deps fetch` downloads, hashes, and must compare against.
; Measured on toml 0.7.0: 4th = fbcd773c…, 8th = 0690246a…, and neither is
; sha256 of contents.tar.gz (that is a third value, 8cf00edd…). Comparing `bl.lock`
; against the wrong field is how the fetcher came to refuse all 47 real packages
; while its own suite stayed green. So this test compares field 8.
;
; `mix.lock` has since been DELETED, so this test is now the only thing standing
; behind the lock: it asserts that `bl.lock` is the whole truth — the resolved
; closure, not a sample, with a version and a 64-hex tarball digest per entry.
; The comparison branch stays for a tree that still carries a `mix.lock`, and it
; earned its place: the conversion DID drift once, by exactly one package
; (`x509`, added to `mix.lock` by the merge that gave `bl` its local CA), and the
; compare is what named it. A lock that is merely *plausible* is a lie about what
; a build installs.
;
; ── Case mapping (ExUnit → BL) ─────────────────────────────────────────────
;   "bl.lock names the same deps, with the same digests, as mix.lock"
;        → bl-lock-names-the-same-deps-with-the-same-digests-as-mix-lock
;   "every entry names a source this tree can act on"
;        → every-entry-names-a-source-this-tree-can-act-on
;   helper parse_bl!/1 → parse-bl!, parse_mix!/1 → parse-mix!
;
; Run: bl test test/bl/deps_lock_test.bl

(ns test.deps-lock
  (:require [clojure.re]))

; The tree root is the command's own project, where `bl.lock` lives.
(def root (BeamLisp/cwd))

(defn- parse-bl!
  "The lock as `{name → [vsn sha]}`, or a raise naming the unreadable line.

   The same reader as `deps/fact->entry`, but STRICTER: a line that is not a
   well-formed `[:dep …]` fact is a failure here, where the lock reader would
   skip it. A test that silently skips a line proves nothing about the lock."
  [path]
  (into {}
    (map (fn [line]
           (let [parts (String/split line " ")]
             (if (and (= 5 (count parts))
                      (= "[:dep" (first parts))
                      (= "hex]" (nth parts 4)))
               [(nth parts 1) [(nth parts 2) (nth parts 3)]]
               (throw (ex-info (str "unreadable lock line: " (pr-str parts)) {})))))
         (remove (fn [l] (or (= "" l) (starts-with? l ";")))
                 (map (fn [s] (String/trim s)) (String/split (File/read! path) "\n"))))))

(defn- parse-mix!
  "`mix.lock` read with Elixir's own reader, reduced to the same
   `{name → [vsn shift-8-digest]}` shape: field 8 is the outer tarball digest,
   the one hex serves and the fetcher checks."
  [path]
  (into {}
    (map (fn [t]
           (let [entry (erlang/element 2 t)]
             [(erlang/element 1 t)
              [(erlang/element 3 entry) (erlang/element 8 entry)]]))
         (Enum/to_list (elem (Code/eval_file path) 0)))))

(deftest bl-lock-names-the-same-deps-with-the-same-digests-as-mix-lock
  (let [bl (parse-bl! (Path/join root "bl.lock"))]
    (is (>= (count bl) 40) "the lock is the resolved closure, not a sample")

    (let [mix-path (Path/join root "mix.lock")]
      (if (File/exists? mix-path)
        (is (= bl (parse-mix! mix-path))
            "bl.lock and mix.lock disagree — one of them lies about what a build installs")
        (is (every? (fn [name]
                      (let [sha (second (get bl name))]
                        (and (string? (first (get bl name)))
                             (not= "" (first (get bl name)))
                             (= 64 (erlang/byte_size sha)))))
                    (keys bl)))))))

(deftest every-entry-names-a-source-this-tree-can-act-on
  (let [bl (parse-bl! (Path/join root "bl.lock"))]
    (doseq [name (keys bl)]
      (let [entry (get bl name)
            vsn (first entry)
            sha (second entry)]
        (is (and (string? name) (not= "" name)))
        (is (and (string? vsn) (not= "" vsn)))
        (is (some? (re-matches (re-pattern "^[0-9a-f]{64}$") sha))
            (str name " " vsn " has a digest that is not a sha256"))))))
