   "record" {"count" [:eq 2]
             "seq" [:entries [[:a 1] [:b 2]]]
             "first" [:entry_one_of [[:a 1] [:b 2]]]
             "rest" [:one_of [[:entries [[:a 1]]] [:entries [[:b 2]]]]]
             "next" [:one_of [[:entries [[:a 1]]] [:entries [[:b 2]]]]]
             "get" [:eq 1]
