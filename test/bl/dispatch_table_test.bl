                "seq" [:raises :Elixir.FunctionClauseError]
                "first" [:eq nil]
                "rest" [:eq (list)]
                "next" [:eq nil]
                "get" [:eq 1]
                "assoc" [:gap [:raises :Elixir.FunctionClauseError] :transient_map_ops]
                "conj" [:gap [:raises :Elixir.FunctionClauseError] :transient_map_ops]
                "contains?" [:gap [:eq false] :transient_map_ops]
                "find" [:gap [:eq nil] :transient_map_ops]
                "empty?" [:raises :Elixir.FunctionClauseError]
                "coll?" [:gap [:eq false] :transient_coll_false]
                "map?" [:gap [:eq false] :transient_coll_false]
                "vector?" [:eq false]
                "set?" [:eq false]
                "seq?" [:eq false]
                "transientable?" [:eq false]
                "print-str" [:prefix "{:\"$transient\""]}})

; Every `[:gap _, _, reason]` reason that the table must currently record.
; A divergence that is known, deliberate, and reported is acceptable; a silent
; one is not. Adding a new gap here is a conscious act.
; (`:record_map_deliberate_false` was retired in wave 27 — `map?` now answers
; true for a record, as Clojure does. `:string_seq` was retired when strings
; became seqable. This list shrinking is the point: a resolved gap must leave
; the inventory.)
(def known-gap-reasons
  [:transient_map_ops :transient_coll_false])

; ── the comparison engine ────────────────────────────────────────────────────

; Elixir `==` restricted to the types this table produces. `=:=` is exact
; term equality, so it keeps the Vector-vs-list distinction the ExUnit
; original's `==` had, and two independently-built Sets/records/maps compare
; structurally. (No cell mixes an int and a float, where `==` and `=:=`
; would differ.)
(defn- same? [a b] (erlang/=:= a b))

; `{:entries kvs}`: a single entry vector normalizes to itself; a seq of
; entries normalizes element-wise and sorts, so map/set iteration order is
; not part of the contract.
(defn- normalize-entries [x]
  (if (vector? x)
    [(nth x 0) (nth x 1)]
    (sort (map normalize-entries x))))

(defn- matches? [result exp]
  (let [k (nth exp 0) v (nth exp 1)]
    (cond
      (= :eq k) (same? result v)
      (= :entry k) (same? result v)
      (= :truthy k) (if result true false)
      (= :falsey k) (not (if result true false))
      (= :prefix k) (and (string? result) (starts-with? result v))
      (= :entry_one_of k) (and (vector? result) (some? (some (fn [e] (same? e result)) v)))
      (= :entries k) (same? (normalize-entries result) (sort v))
      (= :one_of k) (some? (some (fn [e] (matches? result e)) v))
      (= :record_fields k) (and (BeamLisp.Record/record? result)
                                (same? (dissoc result :__struct__) v))
      (= :gap k) (matches? result v)
      :else false)))

; `[:ok value]` or `[:raised class]` — the RAW exception module, what the
; ExUnit `assert_raise mod` compared.
(defn- outcome [thunk]
  (try (list :ok (thunk))
       (catch e (list :raised (Map/get e :__struct__)))))

; Run one cell: `true` when it satisfies `exp`, else a human sentence naming
; what was seen. `:raises` cannot go through `matches?` (it must not evaluate
; to a value), and a `:gap` wraps either shape.
(defn- cell-result [src exp]
  (let [inner (if (= :gap (nth exp 0)) (nth exp 1) exp)
        o (outcome (fn [] (ev-user src)))]
    (cond
      (= :raises (nth inner 0))
      (if (and (= :raised (nth o 0)) (same? (nth inner 1) (nth o 1)))
        true
        (str "expected raise " (nth inner 1) ", got " (nth o 0) " " (nth o 1)))

      (= :raised (nth o 0)) (str "unexpected raise " (nth o 1))
      (matches? (nth o 1) inner) true
      :else (str "got " (pr-str (nth o 1)) ", expected " (pr-str inner)))))

; ── the matrix ───────────────────────────────────────────────────────────────

(deftest every-value-answers-every-collection-fn-per-the-decided-semantics
  (doseq [[vn vex] values
          [fnn shape] fns]
    (let [exp (get (get expectations vn) fnn)]
      ; A cell with no decided expectation is a bug in the table itself.
      (is (some? exp) (str "missing expectation for " vn " x " fnn))
      (when (some? exp)
        (let [r (cell-result (replace-str shape "%s" vex) exp)]
          (is (same? true r) (str "cell " vn " x " fnn ": " r))))))

  ; Every value was actually exercised (324 = 18 x 18); the loop above already
  ; asserts each cell, so this count guards the table's own shape.
  (is (= 324 (* (count values) (count fns)))))

(deftest the-known-gap-inventory-is-exactly-what-is-recorded-no-silent-drift
  ; Static over the table DATA (not the run): every `[:gap _, _, reason]`
  ; recorded in the expectation matrix must be in the deliberate inventory, and
  ; every deliberate reason must actually appear. A divergence that is known,
  ; deliberate, and reported is acceptable; a silent one is not — and adding a
  ; gap becomes a conscious act, not an accidental one.
  (let [reasons (for [[vn _] values
                      [fnn _] fns
                      :let [exp (get (get expectations vn) fnn)]
                      :when (and (some? exp) (= :gap (nth exp 0)))]
                  (nth exp 2))]
    (is (= (sort (distinct reasons)) (sort known-gap-reasons)))))

; ── cells a single fixed call shape cannot express ───────────────────────────

(deftest map-assoc-with-a-new-key-and-conj-with-a-k-v-entry
  (is (= {:a 1 :c 3} (ev-user "(assoc {:a 1} :c 3)")))
  (is (= {:a 1 :c 3} (ev-user "(conj {:a 1} [:c 3])"))))

(deftest record-assoc-conj-add-a-new-field-while-preserving-the-type
  (let [rec (ev-user "(->R 1 2)")]
    (is (same? (ev-user "(assoc (->R 1 2) :c 3)") (Map/put rec :c 3)))
    (is (same? (ev-user "(conj (->R 1 2) [:c 3])") (Map/put rec :c 3)))))

(deftest a-set-get-contains-with-a-present-member-reads-through
  (is (= 2 (ev-user "(get #{1 2 3} 2)")))
  (is (= true (ev-user "(contains? #{1 2 3} 2)")))
  ; `(find #{1 2 3} 2)` in Clojure is `[2 2]`; beam-lisp answers nil (find
  ; is a map fn and a set is not a map). Reported; not fixed.
  (is (= nil (ev-user "(find #{1 2 3} 2)"))))

(deftest a-lazy-seq-conj-prepends-without-corrupting-improper-tail
  (is (= 4 (ev-user "(first (conj (map inc (range 1 4)) 4))"))))

(deftest empty-lazy-results-are-not-empty-vector
  (is (= nil (ev-user "(seq (map inc (range 4 1)))"))))
