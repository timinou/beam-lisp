               "coll?" [:eq false]
               "map?" [:eq false]
               "vector?" [:eq false]
               "set?" [:eq false]
               "seq?" [:eq false]
               "transientable?" [:eq false]
               "print-str" [:prefix "%BeamLisp.Atom"]}
   "volatile" {"count" [:raises :Elixir.ArgumentError]
               "seq" [:raises :Elixir.ArgumentError]
               "first" [:raises :Elixir.ArgumentError]
               "rest" [:raises :Elixir.ArgumentError]
               "next" [:raises :Elixir.ArgumentError]
               "get" [:raises :Elixir.ArgumentError]
               "assoc" [:raises :Elixir.ArgumentError]
               "conj" [:raises :Elixir.ArgumentError]
               "contains?" [:raises :Elixir.ArgumentError]
               "find" [:raises :Elixir.ArgumentError]
               "empty?" [:raises :Elixir.ArgumentError]
               "coll?" [:eq false]
               "map?" [:eq false]
               "vector?" [:eq false]
               "set?" [:eq false]
               "seq?" [:eq false]
               "transientable?" [:eq false]
               "print-str" [:prefix "%BeamLisp.Volatile"]}
   "promise" {"count" [:raises :Elixir.ArgumentError]
              "seq" [:raises :Elixir.ArgumentError]
              "first" [:raises :Elixir.ArgumentError]
              "rest" [:raises :Elixir.ArgumentError]
              "next" [:raises :Elixir.ArgumentError]
              "get" [:raises :Elixir.ArgumentError]
              "assoc" [:raises :Elixir.ArgumentError]
              "conj" [:raises :Elixir.ArgumentError]
              "contains?" [:raises :Elixir.ArgumentError]
              "find" [:raises :Elixir.ArgumentError]
              "empty?" [:raises :Elixir.ArgumentError]
              "coll?" [:eq false]
              "map?" [:eq false]
