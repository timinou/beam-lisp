; realm_ownership_test.bl — who owns a namespace (PLAN-164, docs/design/realm/namespace-ownership.md).
;
; Every namespace has one HOME. `namespace_home` decides it from five facts and is tested
; pure, as a table. The rest drives the real loader with realm envs built the way
; `vm.core/spawn-vm` builds them (a key row and a declaration row in the env), so the rows
; under test are the rows production writes.
;
;   :tier     the platform's own          loaded once, shared
;   :realm    a project's own             BeamLisp.Ns.R<key>.<Ns>
;   :shadow   a declared replacement      the same, replacing a library name, this realm only
;   :shared   declared with a hash        BeamLisp.Ns.S<full verified hash>.<Ns>
;   :refuse   an undeclared replacement   a named error, never a silent one

(ns realm-ownership-test
  (:require [vm.core :as vmc] [vm.shared :as shared]))

(def OWN-A "test/bl/fixtures/realm_ns/a")
(def OWN-B "test/bl/fixtures/realm_ns/b")
(def SHADOW-DIR "test/bl/fixtures/realm_ns/shadow")
(def USES-A "test/bl/fixtures/realm_ns/uses_a")
(def USES-B "test/bl/fixtures/realm_ns/uses_b")
(def SHADOWED "system.ir-smells")      ; a library namespace; the fixture replaces it
(def OVERRIDES "/tmp/realm_ownership_overrides")

; ── the pure table ───────────────────────────────────────────────────────────

(def HOME (fn [& args] (apply BeamLisp.Loader/namespace_home args)))

(deftest the-home-is-a-pure-function-of-five-facts
  ;;           kind    owned? declared? shared? isolate? in_realm?  → home
  (testing "a tier file is the platform's, whatever else is true"
    (is (= :tier (HOME :tier true false false true true)))
    (is (= :tier (HOME :tier true true true true true))))
  (testing "a name no tier owns"
    (is (= :realm  (HOME :project false false false true true)) "a keyed realm owns it")
    (is (= :global (HOME :project false false false false false)) "no realm: as before")
    (is (= :shared (HOME :project false false true true true)) "declared in :uses"))
  (testing "a name a tier owns"
    (is (= :shadow (HOME :project true true false true true)) "declared: a shadow, in its realm")
    (is (= :refuse (HOME :project true false false true true)) "undeclared in a realm: refused")
    (is (= :refuse (HOME :path true false false false false)) "from BEAM_LISP_PATH, undeclared: refused")
    (is (= :global (HOME :project true false false false false)) "a bare tree developing its own library")
    (is (= :global (HOME :project true true false false false)) "declared but no keyed realm: as before")))

; ── real loads ───────────────────────────────────────────────────────────────

(defn- realm-env
  "A realm env shaped exactly as `vm.core/spawn-vm` leaves one."
  [key decl]
  (let [e (BeamLisp.Env/fork)]       ; off the CURRENT env, so the test's own vars stay visible
    (BeamLisp.Env/with_env e
      (fn []
        (BeamLisp.Env/put_key (tuple :realm_key) key)
        (BeamLisp.Env/put_key (tuple :realm_decl) decl)))
    e))

(defn- decl [m] (merge {:shadow [] :uses {} :overrides OVERRIDES} m))

(defn- in-realm [e dir src]
  (BeamLisp.Env/with_env e
    (fn []
      (BeamLisp.Loader/with_ambient_dirs (list (Path/expand dir))
        (fn [] (BeamLisp.Compiler/eval_string src (BeamLisp.Compiler/new_env "user") "realm_ownership_test"))))))

(defn- loaded-modules [] (set (map (fn [m] (Atom/to_string m)) (map first (code/all_loaded)))))

(defn- error-of
  "The message of the error `thunk` raises, or nil."
  [thunk]
  (try (do (thunk) nil) (catch e (ex-message e))))

(defn- says? [msg needle] (and (some? msg) (String/contains? msg needle)))

(deftest a-declared-shadow-is-the-realms-own
  (let [a (realm-env "oa1" (decl {:shadow [SHADOWED]}))
        b (realm-env "ob1" (decl {}))
        src (str "(ns user (:require [" SHADOWED " :as s])) (s/whose)")]
    (is (= "the project's" (in-realm a SHADOW-DIR src)) "the declaring realm sees its file")
    (is (contains? (loaded-modules) "Elixir.BeamLisp.Ns.Roa1.System.Ir-smells")
        "compiled under the realm's key")
    (is (= :Elixir.BeamLisp.Ns.System.Ir-smells
           (BeamLisp.Env/with_env b (fn [] (BeamLisp.Link/module_for SHADOWED))))
        "another realm still names the library's module")
    (is (= :Elixir.BeamLisp.Ns.System.Ir-smells (BeamLisp.Link/module_for SHADOWED))
        "and so does the global env")))

(deftest an-undeclared-shadow-is-refused-with-the-line-to-add
  (let [b (realm-env "ob2" (decl {}))
        msg (error-of (fn [] (in-realm b SHADOW-DIR (str "(ns user (:require [" SHADOWED "])) 1"))))]
    (is (says? msg "LOAD REFUSED") msg)
    (is (says? msg SHADOWED) "names the namespace")
    (is (says? msg "fixtures/realm_ns/shadow/system/ir_smells.bl") "names the file")
    (is (says? msg ":shadow [\"system.ir-smells\"]") "and the env.bl line that would make it legal")))

(deftest a-file-under-overrides-is-a-declared-shadow
  (testing "`bl override vendor` puts a replacement there; that is the declaration"
    (File/mkdir_p! (str OVERRIDES "/system"))
    (File/write! (str OVERRIDES "/system/ir_smells.bl")
                 "(ns system.ir-smells)\n(defn whose [] \"vendored\")\n")
    (let [c (realm-env "oc1" (decl {}))]
      (is (= "vendored"
             (in-realm c OVERRIDES (str "(ns user (:require [" SHADOWED " :as s])) (s/whose)")))))))

(deftest a-shared-namespace-is-named-from-its-hash
  (let [h-a (BeamLisp.Loader/with_ambient_dirs (list (Path/expand USES-A))
              (fn [] (shared/hash-of "rn-common")))
        h-b (BeamLisp.Loader/with_ambient_dirs (list (Path/expand USES-B))
              (fn [] (shared/hash-of "rn-common")))
        p1 (realm-env "su1" (decl {:uses {"rn-common" h-a}}))
        p2 (realm-env "su2" (decl {:uses {"rn-common" h-a}}))
        p3 (realm-env "su3" (decl {:uses {"rn-common" h-b}}))
        go "(ns user (:require [rn-common :as c])) (c/who)"]
    (is (= "common-A" (in-realm p1 USES-A go)))
    (is (= "common-A" (in-realm p2 USES-A go)) "the same hash is the same module")
    (is (= "common-B" (in-realm p3 USES-B go)) "a different hash cannot clash with it")
    (is (= "common-A" (in-realm p1 USES-A "(rn-common/who)")) "and p1 still sees its own")
    (let [mods (loaded-modules)]
      (is (contains? mods (str "Elixir.BeamLisp.Ns.S" (subs h-a 7) ".Rn-common")))
      (is (contains? mods (str "Elixir.BeamLisp.Ns.S" (subs h-b 7) ".Rn-common")))
      (is (not (contains? mods "Elixir.BeamLisp.Ns.Rn-common")) "never an unprefixed copy"))))

(defn- run-in-vm
  "Evaluate `src` in the realm env of `vm`, with `dir` as the project directory."
  [vm dir src]
  (let [dirs (list (Path/expand dir))]          ; resolved HERE: the realm's env does not see this namespace's vars
    (BeamLisp.Env/with_env (:env vm)
      (fn []
        (BeamLisp.Loader/with_ambient_dirs dirs
          (fn [] (BeamLisp.Compiler/eval_string src (BeamLisp.Compiler/new_env "user") "realm_ownership_test")))))))

(def LOAD-APP "(ns user (:require [rn-app])) (rn-app/go)")

(deftest a-realm-purges-its-modules-when-it-closes
  (let [vm-a (vmc/spawn-vm {:id "purge@a" :root "/tmp/purge_a" :key "pg1" :alias "pa" :decl (decl {})})]
    (run-in-vm vm-a OWN-A LOAD-APP)
    (is (contains? (loaded-modules) "Elixir.BeamLisp.Ns.Rpg1.Rn-app"))
    (let [r (vmc/drain vm-a)]
      (is (pos? (:purged r)) "it reports what it deleted")
      (is (not-any? (fn [m] (String/starts_with? m "Elixir.BeamLisp.Ns.Rpg1.")) (loaded-modules))
          "nothing of the realm is left loaded"))))

(defn- atoms-named
  "How many atoms exist whose name starts with `prefix`, among the module names a realm
   can have: sampled by asking for the names it would use (`binary_to_existing_atom`
   answers without creating one)."
  [names]
  (count (filter (fn [s] (try (do (erlang/binary_to_existing_atom s) true) (catch e false))) names)))

(def REALM-NAME-SAMPLE
  (concat ["Elixir.BeamLisp.Ns.Rra1" "Elixir.BeamLisp.Ns.Rra1.Rn-app" "Elixir.BeamLisp.Ns.Rra1.Rn-lib"]
          (map (fn [i] (str "Elixir.BeamLisp.Ns.Fn.Rra1.M" i)) (range 1 40))))

(deftest reopening-a-realm-reuses-its-module-names
  ;; The language's own `eval_string` mints one `Eval.M<n>` module per form it evaluates
  ;; (about 16 atoms), whatever realm runs it; that is not the realm's. What the realm
  ;; owns is the names of ITS modules, and those must not grow with each reopen: body
  ;; modules are numbered from 1 per realm and the numbering starts over when the realm closes.
  (let [one-cycle (fn []
                    (let [vm (vmc/spawn-vm {:id "atoms@x" :root "/tmp/atoms_x" :key "ra1" :alias "ax" :decl (decl {})})]
                      (run-in-vm vm OWN-A LOAD-APP)
                      (vmc/drain vm)))]
    (one-cycle)
    (let [named (atoms-named REALM-NAME-SAMPLE)]
      (is (pos? named) "the first open named some modules")
      (doseq [_ (range 5)] (one-cycle))
      (is (= named (atoms-named REALM-NAME-SAMPLE))
          "five more open/close cycles named no new realm module: the same names are reused"))))
