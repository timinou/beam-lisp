(ns aot-constructor-walk-budget-test)
;; Regression: proc.queue-runtime's defserver clause plan is a finite program,
;; but re-walking its growing values at every primitive boundary spent ~97% of
;; the interpreter's step budget (1.07M of 1.11M) and refused it with
;; step-budget. Data-shape walks now charge their own :walk-steps budget.
(deftest a-defserver-heavy-sdk-namespace-loads-within-the-constructor-budget
 (is (= :ok (try (BeamLisp.Loader/ensure_loaded "proc.queue-runtime") :ok
              (catch e (ex-message e))))))
