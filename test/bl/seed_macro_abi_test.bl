; test/bl/seed_macro_abi_test.bl — test.seed-macro-abi.
;
; Split from test/bl/seed_test.bl so each file stays under the runner's 300 s
; per-file bound. Shared helpers live in test.bl.seed-support.

(ns test.seed-macro-abi
  (:require [seed] [test.bl.seed-support :as s]))

(deftest the-guards-publishes-its-macro-abi
  ;; `Elixir.BeamLisp.Guards` is the single place that names the "struct is a
  ;; map" invariant, and its value IS its compile-time ABI: three `defguard`s
  ;; (`is_bl_map/1`, `is_ref_type/1`, `is_data_tuple/1`) are PAIRS — a
  ;; `MACRO-<name>/2` implementer plus the `__info__(:macros)` entry the seed
  ;; declares through `:macro-exports` — beside the one plain function
  ;; `internal_tuple_tags/0`. `record.ex` `import`s `is_bl_map/1` and uses it in
  ;; a GUARD, so the published beam must carry BOTH halves of each pair or
  ;; `elixirc` refuses to expand the call at all. Judged from the beam's own
  ;; export chunk and, for the macros table, by swapping the beam in at the
  ;; production atom and reading `__info__(:macros)` — from the REAL source, so
  ;; the assertion cannot drift from the file the seed compiles.
  (let [root (BeamLisp/cwd)
        ebin (Path/join root "build")
        out (s/scratch "guards-out")
        real {"Elixir.BeamLisp.Guards" (Path/join root "priv/host/guards.bl")}
        hd (s/host-scratch "guards-src" "" real)
        r (s/seed-run! {:root root :out out :ebin ebin :host hd})]
    (is (:ok? r) (str "the floor is generated: " (pr-str (:errors r))))
    (let [beam (Path/join out "Elixir.BeamLisp.Guards.beam")
          exports (s/beam-exports beam)]
      (is (File/exists? beam) "Guards is COMPILED into the floor")
      (doseq [f [["internal_tuple_tags" 0] ["MACRO-is_bl_map" 2]
                 ["MACRO-is_ref_type" 2] ["MACRO-is_data_tuple" 2]]]
        (is (s/has? exports (tuple (String/to_atom (first f)) (second f)))
            (str "Guards exposes " (first f) "/" (second f))))
      (is (not (s/has? exports (tuple :__struct__ 0)))
          "Guards is functions-only: the published beam carries no struct surface")
      (is (erlang/== (list (tuple :is_bl_map 1) (tuple :is_data_tuple 1) (tuple :is_ref_type 1))
                     (s/with-swapped-module :"Elixir.BeamLisp.Guards" beam
                       (fn [m] (erlang/apply m :__info__ (list :macros)))))
          "the published beam advertises all three macros — `__info__(:macros)` is SORTED, unlike the mapping's declaration order — so `require BeamLisp.Guards` expands them"))
    (File/rm_rf! out)
    (File/rm_rf! hd)))

(deftest the-record-publishes-the-abi-surface
  ;; `Elixir.BeamLisp.Record` is beam-lisp's `defrecord`/`deftype` type factory —
  ;; the module every caller already names at that exact atom — so the floor must
  ;; publish the factory's whole public ABI there. The mapping is functions-only
  ;; (no `:struct-fields`, no `:behaviour`, no `:macro-exports`): a record is a
  ;; synthesized struct MODULE and a deftype a tagged tuple, so the factory beam
  ;; declares no struct of its own. Judged from the beam's own export chunk, from
  ;; the REAL source, against the live module's callables minus `__info__/1` (a
  ;; pinned functions-only beam does not carry Elixir's generated `__info__/1`).
  ;; The pinned file's own `defn-` helpers are exports too, so the published
  ;; surface is the live one PLUS them — hence `every?`, not equality.
  (let [root (BeamLisp/cwd)
        ebin (Path/join root "build")
        out (s/scratch "record-out")
        real {"Elixir.BeamLisp.Record" (Path/join root "priv/host/record.bl")}
        hd (s/host-scratch "record-src" "" real)
        r (s/seed-run! {:root root :out out :ebin ebin :host hd})]
    (is (:ok? r) (str "the floor is generated: " (pr-str (:errors r))))
    (let [beam (Path/join out "Elixir.BeamLisp.Record.beam")
          exports (s/beam-exports beam)
          live (erlang/apply :"Elixir.BeamLisp.Record" :module_info (list :exports))
          want (Enum/sort (filter (fn [e] (not (erlang/== :__info__ (elem e 0)))) live))]
      (is (File/exists? beam) "Record is COMPILED into the floor")
      (is (every? (fn [e] (s/has? exports e)) want)
          "the published Record beam exports every live callable, arity for arity")
      (doseq [f [["define" 3] ["define_type" 3] ["record?" 1] ["record_module?" 1]
                 ["deftype_module?" 1] ["info" 1] ["fields_of" 1]
                 ["positional_ctor" 1] ["map_ctor" 1] ["struct_map" 2]
                 ["map_construct" 2] ["construct_list" 2] ["literal" 3]
                 ["build_type" 2] ["deftype_field" 2]
                 ["generated_struct" 2] ["generated_struct" 3]]]
        (is (s/has? exports (tuple (String/to_atom (first f)) (second f)))
            (str "Record exposes " (first f) "/" (second f))))
      (is (not (s/has? exports (tuple :__struct__ 0)))
          "Record is functions-only: the published beam carries no struct surface")
      (is (not (s/has? exports (tuple :__info__ 1)))
          "Record is functions-only: the published beam carries no Elixir __info__/1"))
    (File/rm_rf! out)
    (File/rm_rf! hd)))
