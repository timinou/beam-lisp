; host_num_test.bl — the pinned `BeamLisp.Num` ABI, diffed against the live one.
;
; `priv/host/num.bl` ports `lib/beam_lisp/num.ex` to ONE exact-named beam. The
; live Elixir module is still the ground truth here, so this suite is
; DIFFERENTIAL: the same corpus is run through the pinned probe and through
; `Elixir.BeamLisp.Num`, and the two answer sets must be equal — values,
; exception classes, messages AND the `data` an `ExInfo` carries.
;
; Nothing here replaces the live module. The source is compiled at its own
; probe atom with `:load? false`, the namespace shim beside it is dropped, and
; the pinned beam is loaded ALONE — a leftover shim reference would be `undef`.
;
; The one thing that cannot be compared identity-for-identity is the module
; name inside a `FunctionClauseError` message: the probe names ITS own atom (by
; design — the pinned file reads its module from a fun literal, so the same
; source raises `BeamLisp.Num.neg/1` at production and
; `NumHostProbe.neg/1` here). `norm/1` maps the probe's name back onto the
; live one before the comparison, and a separate assertion pins the
; module-exactness itself.
;
; What the corpus is FOR:
;   * ints/floats take the BIF; decimals lift an integer exactly (scale 0);
;   * a decimal beside a float is REFUSED (`:decimal/inexact-operand`) — int
;     and float must not be laundered into exact arithmetic;
;   * a non-number beside a number keeps the plain `:badarith`;
;   * ordering and sign predicates are TOTAL over Erlang term order for a
;     non-decimal pair, so strings and atoms answer instead of raising;
;   * `==`/`<` are NUMERIC (`1 == 1.0`, `1.00M == 1.0M`) while `=`/scale are
;     untouched;
;   * zero division (`1 / 0`, decimal / zero) and non-terminating decimal
;     division answer as the live module answers.
;
; Run: bin/bl test test/bl/host_num_test.bl

(ns host.num.test)

(defn- t2 [k v] (erlang/list_to_tuple (list k v)))

(defn- tmp-dir []
  (str (System/tmp_dir!) "/bl_host_num_" (erlang/unique_integer (list :positive))))

(defn- num-source [] (Path/join (BeamLisp/cwd) "priv/host/num.bl"))

(def ^:private probe :Elixir.BeamLisp.NumHostProbe)
(def ^:private shim :Elixir.BeamLisp.Ns.Host.Num)
(def ^:private live :Elixir.BeamLisp.Num)

(defn- drop! [mod]
  (do (code/purge mod) (code/delete mod) :ok))

; Compile the pinned source at the probe atom and publish ONLY the pinned beam:
; the compile's own load (and the namespace shim it built beside it) is dropped.
(defn- compile-probe [dir]
  (let [res (BeamLisp.AOT/compile_host_file (num-source)
              (list (t2 :module probe) (t2 :output_dir dir) (t2 :load? false)))
        path (elem res 1)]
    (drop! probe)
    (code/load_binary probe (erlang/binary_to_list path) (File/read! path))
    (drop! shim)
    probe))

; ── the observation: a call's whole answer, a raise included -------------

(defn- dec [x] (BeamLisp.Decimal/new x))
(defn- of [unscaled scale] (BeamLisp.Decimal/of unscaled scale))

(defn- ex-data-of
  "The `:data` an exception carries, or nil — safe for any raised value."
  [e]
  (if (and (erlang/is_map e) (erlang/is_map_key :data e)) (erlang/map_get :data e) nil))

(defn- norm
  "Map the probe's own atom out of a message, so a `FunctionClauseError` name
   compares equal to the live module's. Live messages never contain the probe
   string, so they pass through unchanged."
  [m]
  (if (erlang/is_binary m) (String/replace m "BeamLisp.NumHostProbe" "BeamLisp.Num") m))

(defn- answer
  "`[:value v]` or `[:raise class message data]`. The class, message and data
   are all part of the ABI a caller's `catch`/`ex-message`/`ex-data` reads."
  [mod fname args]
  (try (list :value (erlang/apply mod fname args))
       (catch e (list :raise (:__struct__ e) (norm (ex-message e)) (ex-data-of e)))))

(defn- answers [mod qs]
  (map (fn [q] (list (first q) (answer mod (first q) (second q)))) qs))

; ── the corpus ───────────────────────────────────────────────────────────

(def pairs-2
  "Every 2-arity input class the port must answer: ints, floats, decimals
   (exact and inexact mixes), zero divisors, and non-numbers — a string, an
   atom, nil, booleans, an Erlang list and a bl vector."
  (list (list 1 2) (list 2 1) (list 1 1) (list 7 2) (list 1 0) (list 0 0) (list 0 1)
        (list 1 2.5) (list 2.5 1) (list 1.5 2.5) (list 1.0 0) (list 1 0.0) (list 1.0 1)
        (list (dec 1) (dec 2)) (list (dec 2) (dec 1)) (list (dec 1) (dec 1))
        (list (dec 1) (dec 3)) (list (dec 1) (dec 0)) (list (of 100 2) (of 1 0))
        (list 1 (dec 2)) (list (dec 1) 2) (list 2.0 (dec 1)) (list (dec 1) 2.0)
        (list (dec 1) :a) (list :a :b) (list "a" "b") (list "b" "a") (list "" :a)
        (list nil 1) (list 1 nil) (list true false) (list :b :a)
        (list (list 1) 2) (list (list 1) (list 2)) (list [1 2] [1 3])))

(def singles
  "Every 1-arity input class: zero, sign, floats, decimals (exact and with a
   scale), and the non-numbers."
  (list 0 1 (erlang/- 1) 5 (erlang/- 5)
        0.0 1.5 (erlang/- 1.5) 1.0
        (dec 0) (dec 1) (dec (erlang/- 1)) (of 0 0) (of 15 1) (dec 100)
        :x "s" nil (list) (list 1) {} {:a 1} true [1 2]))

(defn- queries
  "The whole differential corpus as `[fname args]` questions."
  []
  (concat
    (mapcat (fn [f] (map (fn [p] (list f p)) pairs-2))
            (list :add :sub :mul :div :lt :gt :le :ge :num_eq :cmp))
    (mapcat (fn [f] (map (fn [x] (list f (list x))) singles))
            (list :neg :zero? :pos? :neg? :number?))))

; ── the pinned ABI, answer for answer ────────────────────────────────────

(deftest num-pinned-matches-the-live-module
  (testing "the whole corpus: probe answers equal the live module's, question for question"
    (let [dir (tmp-dir)]
      (compile-probe dir)
      ; NO SHIM: the compile's namespace shim is gone; the pinned beam answers.
      (is (= :non_existing (erlang/apply :code :which (list shim))))
      ; FUNCTIONS-ONLY: no synthesized struct surface.
      (is (not (erlang/function_exported probe :__struct__ 0)))
      (is (not (erlang/function_exported probe :__info__ 1)))
      ; The production module's functional ABI is present on the probe beam.
      ; The seeded BL module intentionally has no Elixir-generated __info__/1.
      (is (erlang/function_exported live :add 2)
          "the production numeric module is loaded")
      (is (every? (fn [e] (or (erlang/== :__info__ (elem e 0))
                              (erlang/function_exported probe (elem e 0) (elem e 1))))
                  (erlang/apply live :module_info (list :exports)))
          "the pinned ABI covers every FUNCTIONAL live export")
      ; PINNED ANSWERS first — the ABI itself, not merely probe == live.
      (is (= (list :value 3) (answer probe :add (list 1 2))))
      (is (= (list :value 3.5) (answer probe :div (list 7 2))))
      (is (= (list :value 4.0) (answer probe :mul (list 2 2.0))))
      (is (= (list :value (dec 3)) (answer probe :add (list 1 (dec 2)))))
      (is (= (list :value true) (answer probe :num_eq (list 1 1.0))))
      (is (= (list :value false) (answer probe :lt (list 1 1.0))))
      (is (= (list :value 0) (answer probe :cmp (list 1 1.0))))
      (is (= (list :value true) (answer probe :number? (list (dec 1)))))
      (is (= (list :value false) (answer probe :number? (list "1"))))
      (is (= (list :value true) (answer probe :pos? (list :x)))
          "a non-number answers the Erlang term order, not an error")
      (is (= (list :value false) (answer probe :neg? (list "s"))))
      ; THE DIFF. One question list, two modules, equal answers.
      (let [qs (queries)]
        (is (= (answers live qs) (answers probe qs))))
      ; and per-function, so a failure names the operation instead of dumping
      ; the whole corpus.
      (doseq [f (list :add :sub :mul :div :lt :gt :le :ge :num_eq :cmp)]
        (let [qs (map (fn [p] (list f p)) pairs-2)]
          (is (= (answers live qs) (answers probe qs)) (str "2-ary " f))))
      (doseq [f (list :neg :zero? :pos? :neg? :number?)]
        (let [qs (map (fn [x] (list f (list x))) singles)]
          (is (= (answers live qs) (answers probe qs)) (str "1-ary " f))))
      ; REPRODUCIBLE: a rebuild of the same source is the same bytes, so the
      ; beam can be committed into the seed and re-derived.
      (let [dir2 (tmp-dir)
            again (elem (BeamLisp.AOT/compile_host_file (num-source)
                          (list (t2 :module probe) (t2 :output_dir dir2) (t2 :load? false)))
                        1)]
        (is (= (File/read! (elem (BeamLisp.AOT/compile_host_file (num-source)
                                (list (t2 :module probe) (t2 :output_dir dir) (t2 :load? false)))
                              1))
               (File/read! again))))
      ; The SAME source compiles at its PRODUCTION atom — read, not loaded:
      ; `:load? false` writes the beam without replacing the live module.
      (let [res (BeamLisp.AOT/compile_host_file (num-source)
                  (list (t2 :module live) (t2 :output_dir dir) (t2 :load? false)))]
        (is (= live (elem res 0)))
        (is (File/exists? (elem res 1)))
        (is (= 3 (erlang/apply live :add (list 1 2)))
            "the live module was never substituted mid-flight"))
      (File/rm_rf! dir))))

; ── the exception surface, pinned by class / message / data ──────────────

(deftest num-pinned-errors-are-the-live-errors
  (testing "zero division, decimal division by zero, non-terminating, inexact"
    (let [dir (tmp-dir)]
      (compile-probe dir)

      ; INT/FLOAT zero division: the native BIF's own ArithmeticError.
      (is (= (list :raise :Elixir.ArithmeticError "bad argument in arithmetic expression" nil)
             (answer probe :div (list 1 0))))
      (is (= (answer live :div (list 1 0)) (answer probe :div (list 1 0))))
      (is (= (answer live :div (list 1.0 0)) (answer probe :div (list 1.0 0))))

      ; DECIMAL division is exact and refuses what money cannot express.
      (let [a (answer probe :div (list (dec 1) (dec 0)))]
        (is (= :raise (first a)))
        (is (= :Elixir.BeamLisp.ExInfo (nth a 1)))
        (is (= "decimal division by zero" (nth a 2)))
        (is (= :"decimal/divide-by-zero" (maps/get :type (nth a 3) nil)))
        (is (= (dec 1) (maps/get :dividend (nth a 3) nil)))
        (is (= a (answer live :div (list (dec 1) (dec 0))))))

      (let [a (answer probe :div (list (dec 1) (dec 3)))]
        (is (= :Elixir.BeamLisp.ExInfo (nth a 1)))
        (is (= "non-terminating decimal expansion; no exact representable decimal result"
               (nth a 2)))
        (is (= :"decimal/non-terminating" (maps/get :type (nth a 3) nil)))
        (is (= (dec 1) (maps/get :dividend (nth a 3) nil)))
        (is (= (dec 3) (maps/get :divisor (nth a 3) nil)))
        (is (= a (answer live :div (list (dec 1) (dec 3))))))

      ; A FLOAT beside a DECIMAL is refused, from either side, with the tuned
      ; message and the float as `data`.
      (let [a (answer probe :add (list (dec 1) 1.0))]
        (is (= :Elixir.BeamLisp.ExInfo (nth a 1)))
        (is (= "a float cannot enter decimal arithmetic: 1.0 (use decimal/from-float to approximate on purpose)"
               (nth a 2)))
        (is (= :"decimal/inexact-operand" (maps/get :type (nth a 3) nil)))
        (is (= 1.0 (maps/get :value (nth a 3) nil)))
        (is (= a (answer live :add (list (dec 1) 1.0))))
        (is (= (answer live :mul (list 2.5 (dec 1))) (answer probe :mul (list 2.5 (dec 1)))))
        (is (= (answer live :cmp (list 1.0 (dec 1))) (answer probe :cmp (list 1.0 (dec 1))))))

      ; A DECIMAL beside a value that can be neither lifted nor converted
      ; falls through to the BIF's own `:badarith` — ordering included.
      (is (= (answer live :add (list (dec 1) :a)) (answer probe :add (list (dec 1) :a))))
      (is (= (answer live :lt (list (dec 1) "a")) (answer probe :lt (list (dec 1) "a"))))
      (is (= (list :raise :Elixir.ArithmeticError "bad argument in arithmetic expression" nil)
             (answer probe :lt (list (dec 1) "a"))))

      ; A NON-NUMBER, non-decimal `neg/1` is a `FunctionClauseError` naming the
      ; module that raised — the pinned file reads its own atom, so this equals
      ; the live answer once the name is mapped, and the raw class matches too.
      (is (= (answer live :neg (list :x)) (answer probe :neg (list :x))))
      (is (= (list :raise :Elixir.FunctionClauseError
                   "no function clause matching in BeamLisp.Num.neg/1" nil)
             (answer probe :neg (list :x))))
      ; the module-exactness itself: the raised `:module` is the probe atom,
      ; which is what makes the same source raise `BeamLisp.Num` at production.
      (is (= probe (erlang/map_get :module (try (erlang/apply probe :neg (list :x)) nil
                                                (catch e e)))))
      (is (= live (erlang/map_get :module (try (erlang/apply live :neg (list :x)) nil
                                               (catch e e)))))

      ; ORDERING over two non-decimals is the total Erlang term order — a
      ; string and an atom answer rather than raise (`cmp` is the exception:
      ; it is Clojure's ranked comparison and always takes the tower).
      (is (= (list :value true) (answer probe :lt (list "a" "b"))))
      (is (= (list :value true) (answer probe :gt (list :b :a))))
      (is (= (list :value true) (answer probe :lt (list 1 nil))))
      (is (= (answer live :lt (list "a" "b")) (answer probe :lt (list "a" "b"))))
      (is (= (answer live :cmp (list "a" "b")) (answer probe :cmp (list "a" "b"))))

      (File/rm_rf! dir))))

; ── equality and scale ───────────────────────────────────────────────────

(deftest num-pinned-keeps-numeric-equality-and-decimal-scale
  (testing "== / < are numeric; = and the scale of a decimal are untouched"
    (let [dir (tmp-dir)]
      (compile-probe dir)
      (let [a (of 100 2)   ; 1.00
            b (of 1 0)     ; 1
            c (of 10 1)]   ; 1.0
        ; the value model keeps the scale: `1.00M` and `1M` are NOT `=`.
        (is (not= a b))
        (is (= 2 (BeamLisp.Decimal/scale a)))
        (is (= 0 (BeamLisp.Decimal/scale b)))
        (is (= 1 (BeamLisp.Decimal/scale c)))
        ; ... while the tower's numeric equality does not.
        (is (erlang/apply probe :num_eq (list a b)))
        (is (erlang/apply probe :num_eq (list a c)))
        (is (= 0 (erlang/apply probe :cmp (list a b))))
        (is (erlang/apply probe :le (list a b)))
        (is (erlang/apply probe :ge (list a b)))
        (is (not (erlang/apply probe :lt (list a b))))
        (doseq [f (list :num_eq :cmp :lt :gt :le :ge)]
          (is (= (erlang/apply live f (list a b)) (erlang/apply probe f (list a b)))
              (str "decimal scale on " f)))
        ; int vs float: the language's `=` on raw numbers IS the numeric
        ; `==` (`erlang/==`), and so is the tower's `==` — while a decimal
        ; pair differs structurally because the map carries the scale.
        (is (= 1 1.0))
        (is (not= a b))
        (is (erlang/apply probe :num_eq (list 1 1.0)))
        (is (not (erlang/apply probe :lt (list 1 1.0))))
        (is (= 0 (erlang/apply probe :cmp (list 1 1.0)))))
      (File/rm_rf! dir))))

; ── the pinned beam AT the production atom ───────────────────────────────
;
; The differential above proves the ABI at a probe atom. This one proves the
; CUTOVER shape: the same source compiled to `Elixir.BeamLisp.Num` and loaded
; OVER the live module answers the LANGUAGE — the operator table's decimal
; paths run through it — and the live beam is restored afterwards. Loading a
; pinned port mid-flight is exactly what `:load? false` exists to avoid for a
; generator; doing it deliberately, with the saved beam put back in `finally`,
; is what shows the pinned beam can take the atom.
(deftest num-pinned-beam-stands-in-at-the-production-atom
  (testing "the language's decimal paths run on the pinned module, then the live beam is restored"
    (let [dir (tmp-dir)
          out (str dir "/prod")
          beam (Path/join out "Elixir.BeamLisp.Num.beam")
          orig-path (erlang/apply :code :which (list live))
          orig-bin (File/read! (erlang/list_to_binary orig-path))]
      (is (not= :non_existing orig-path) "precondition: the live beam is a readable file")
      (BeamLisp.AOT/compile_host_file (num-source)
        (list (t2 :module live) (t2 :output_dir out) (t2 :load? false)))
      (try
        (drop! live)
        (code/load_binary live (erlang/binary_to_list beam) (File/read! beam))
        (is (not (erlang/function_exported live :__info__ 1))
            "the pinned beam is functions-only; the language never calls __info__/1")
        ; int/float pairs keep the BIF fast path ...
        (is (= 3 (BeamLisp/eval "(+ 1 2)")))
        ; ... and a DECIMAL operand takes the tower into the pinned module.
        (is (= (dec 3) (BeamLisp/eval "(+ (BeamLisp.Decimal/new 1) (BeamLisp.Decimal/new 2))")))
        (is (= true (BeamLisp/eval "(== (BeamLisp.Decimal/new 1) (BeamLisp.Decimal/new 1))")))
        (is (= true (BeamLisp/eval "(< (BeamLisp.Decimal/new 1) (BeamLisp.Decimal/new 2))")))
        (is (= true (BeamLisp/eval "(>= (BeamLisp.Decimal/new 2) (BeamLisp.Decimal/new 2))")))
        (is (= :Elixir.BeamLisp.ExInfo
               (:__struct__ (try (BeamLisp/eval "(+ 1.0 (BeamLisp.Decimal/new 1))") nil
                                 (catch e e))))
            "the inexact refusal survives the language's operator path")
        (is (= :Elixir.ArithmeticError
               (:__struct__ (try (BeamLisp/eval "(/ 1 0)") nil (catch e e))))
            "int zero division is the BIF's own ArithmeticError")
        (is (= :Elixir.BeamLisp.ExInfo
               (:__struct__ (try (BeamLisp/eval "(/ (BeamLisp.Decimal/new 1) 0)") nil
                                 (catch e e))))
            "decimal zero division runs on the pinned module and refuses")
        (finally
          (drop! live)
          (code/load_binary live orig-path orig-bin)))
      ; RESTORED: the live module answers again at the same atom.
      (is (= 3 (erlang/apply live :add (list 1 2))))
      (is (= :Elixir.BeamLisp.ExInfo
             (:__struct__ (try (erlang/apply live :add (list 1.0 (dec 1))) nil (catch e e)))))
      (File/rm_rf! dir))))
