; namespace_readiness_fast_path_test.bl — the steady-state cost of the
; cross-namespace readiness guard.
;
; The compiler emits `BeamLisp.Loader/ensure_ready(ns)` ahead of every DIRECT
; call into another namespace. The guard's answer for an already-initialized
; namespace must be O(1) and must not walk the env chain or ask `whereis`:
; `priv/host/env.bl`'s `ns_ready?/1` therefore reads a `persistent_term` fact
; first — set once, when the namespace's init completes IN THE GLOBAL ENV —
; and only falls back to the `{env, :ns_ready, ns}` ETS mirror plus the chain
; walk when that fact is absent.
;
; WHAT THIS FILE CAN AND CANNOT SEE. `priv/host/*.bl` is the source of the
; PINNED host beams the committed floor carries, so the code a `bl test` VM
; executes is the FLOOR's, not this tree's (`docs/bootstrap-regeneration.org`).
; The assertions below therefore run in a fresh `elixir` VM whose code path
; prefers `Elixir.BeamLisp.Env` and `Elixir.BeamLisp.Loader` compiled from the
; CURRENT sources — the technique `env_host_test.bl` uses — and the whole run
; prints `check-…=ok` lines. After the coordinator regenerates the floor these
; same assertions hold in the ordinary test VM; the child-VM harness keeps
; working because it only ever compiles the source it is given.
;
; Run: bin/bl test test/bl/namespace_readiness_fast_path_test.bl

(ns namespace-readiness-fast-path-test)

(defn- t2 [k v] (erlang/list_to_tuple (list k v)))

(defn- tmp-dir []
  (str (System/tmp_dir!) "/bl_ns_guard_" (System/system_time :millisecond)
       "_" (erlang/unique_integer (list :positive))))

(defn- source-root []
  (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd)))

(defn- host-source [leaf] (Path/join (source-root) (str "priv/host/" leaf)))

(defn- compile-pinned! [leaf mod out]
  (let [res (BeamLisp.AOT/compile_host_file (host-source leaf)
              (list (t2 :module mod) (t2 :output_dir out) (t2 :load? false)))]
    (is (File/exists? (elem res 1)) (str "compiled " leaf))
    (elem res 1)))

(defn- child-code-args
  "This VM's code path as `-pa` args, with `pinned` LAST so it lands FIRST:
   `-pa` PREPENDS, so the last one named wins."
  [pinned]
  (concat (mapcat (fn [p] (list "-pa" (erlang/list_to_binary p))) (code/get_path))
          (list "-pa" pinned)))

(deftest the-readiness-guard-is-o-1-once-a-namespace-is-ready
  (let [dir (tmp-dir)
        out (str dir "/ebin")
        script (Path/join (Path/join (source-root) "test/fixtures") "ns_guard_child.exs")]
    (try
      ; Both host modules are compiled from the CURRENT sources. Loader is the
      ; call site that must stop asking `whereis` on the hot path; Env is where
      ; the fact lives.
      (compile-pinned! "env.bl" :Elixir.BeamLisp.Env out)
      (compile-pinned! "loader.bl" :Elixir.BeamLisp.Loader out)
      (is (File/exists? script) "the child fixture is in the tree")
      (let [r (System/cmd "elixir"
                          (to-list (concat (child-code-args out) (list script)))
                          (to-list [(tuple :stderr_to_stdout true)]))
            text (elem r 0)
            status (elem r 1)]
        (is (zero? status) (str "the child VM exited " status ":\n" text))
        ; The override really took: the production atoms resolve to the beams
        ; compiled from this tree's sources, not to the floor's.
        (is (String/contains? text (str "env-beam=" out "/Elixir.BeamLisp.Env.beam"))
            (str "Env was not the compiled source beam:\n" text))
        (is (String/contains? text (str "loader-beam=" out "/Elixir.BeamLisp.Loader.beam"))
            (str "Loader was not the compiled source beam:\n" text))
        ; (a) A deferred namespace still initializes exactly once, on the first
        ; direct call, and the guard is a no-op afterwards.
        (is (String/contains? text "check-declared-is-not-ready=ok") text)
        (is (String/contains? text "check-direct-call-initializes=ok") text)
        (is (String/contains? text "check-init-ran-once=ok") text)
        (is (String/contains? text "check-ready-after-init=ok") text)
        (is (String/contains? text "check-guard-is-a-no-op-when-ready=ok") text)
        ; (b) The fast path is a global-env fact read BEFORE the chain.
        (is (String/contains? text "check-global-flag-set=ok") text)
        (is (String/contains? text "check-fast-path-skips-chain=ok") text)
        (is (String/contains? text "check-unknown-namespace-stays-false=ok") text)
        ; (c) A namespace initialized in a child env is not globally ready.
        (is (String/contains? text "check-child-env-load-is-ready-in-child=ok") text)
        (is (String/contains? text "check-fast-fact-agrees-with-global-mirror=ok") text)
        ; The cost bound: the old chain walk was ~600 reductions per guard.
        (is (String/contains? text "check-guard-reduction-bound=ok") text)
        (is (String/contains? text "semantics=ok")
            (str "the child VM reported a failed check:\n" text)))
      (finally (File/rm_rf! dir)))))
