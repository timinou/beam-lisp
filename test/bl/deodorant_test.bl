; test/bl/deodorant_test.bl — the smell registry, guards, tiers, and the
; span-preserving fixer, tested in beam-lisp.
; Run: bl test test/bl/deodorant_test.bl
;
; The Map/get smells are the load-bearing case for GUARDS: `(Map/get m
; :k)` is the smell, `(Map/get m k)` with a variable key is not — the key
; might not be a keyword at runtime. Every claim here is asserted both
; structurally (the rewrite produces the idiomatic form) and by value
; (the two spellings evaluate identically on real maps).

(ns deodorant.test
  (:require [deodorant :as d] [bl.lint :as lint]))

(defn- smell-named [n]
  (first (filter (fn [s] (= (:name s) n)) (d/all-smells))))

; ── registry ──────────────────────────────────────────────────────────

(deftest registry-has-the-map-smells
  (let [names (map :name (d/all-smells))]
    (is (some (fn [n] (= n 'map-get->kw-access)) names))
    (is (some (fn [n] (= n 'map-get-default->get)) names))
    (is (some (fn [n] (= n 'kw-of-get-default->get-in)) names))
    (is (some (fn [n] (= n 'nested-kw->get-in)) names))))

(deftest tiers-filter-the-registry
  (let [safe-names  (map :name (d/safe-rules))
        all-names   (map :name (d/all-rules))
        every-names (map :name (d/every-rule))]
    ; the map smells are :idiomatic — never in the apply-blind :safe set,
    ; always in the default deodorize set
    (is (not (some (fn [n] (= n 'map-get->kw-access)) safe-names)))
    (is (some (fn [n] (= n 'map-get->kw-access)) all-names))
    ; :reinvention is opt-in only
    (is (not (some (fn [n] (= n 'reduce->count)) all-names)))
    (is (some (fn [n] (= n 'reduce->count)) every-names))))

; ── guards ────────────────────────────────────────────────────────────
;
; A guard receives the match's bindings map keyed by the PATTERN VARIABLE
; and can veto the rewrite. These use a raw smell map so the global
; registry is not touched.

(deftest guard-can-veto-a-matched-pattern
  (let [s {:name 't :tier :idiomatic
           :pattern '(Map/get ?m ?k) :replacement '(?k ?m)
           :when (fn [b] (keyword? (get b '?k)))}]
    (is (some? (d/smell-match s '(Map/get req :opts))))
    (is (nil? (d/smell-match s '(Map/get m k))))
    (is (nil? (d/smell-match s '(Map/get headers "authorization"))))
    ; a pattern that does not match at all never reaches the guard
    (is (nil? (d/smell-match s '(other req :opts))))))

(deftest builtin-guards-hold
  (let [s (smell-named 'map-get->kw-access)]
    (is (some? (d/smell-match s '(Map/get req :opts))))
    (is (nil? (d/smell-match s '(Map/get m k))))
    (is (nil? (d/smell-match s '(Map/get headers "authorization")))))
  (let [s2 (smell-named 'map-get-default->get)]
    (is (some? (d/smell-match s2 '(Map/get req :opts {}))))
    (is (nil? (d/smell-match s2 '(Map/get m k {})))))
  (let [s3 (smell-named 'nested-kw->get-in)]
    (is (some? (d/smell-match s3 '(:cache? (:opts req)))))
    ; inner head is a CALL, not a keyword — no rewrite
    (is (nil? (d/smell-match s3 '(:b (f m)))))))

; ── rewrites (structural) ─────────────────────────────────────────────

(deftest map-get-rewrites-to-idiomatic-forms
  (is (= (d/deodorize '(Map/get req :opts))
         '(:opts req)))
  (is (= (d/deodorize '(Map/get req :opts {}))
         '(get req :opts {})))
  ; fixed-point: inner rewrites first, the get-in rules collapse on
  ; the next pass
  (is (= (d/deodorize '(Map/get (Map/get req :opts {}) :cache?))
         '(get-in req [:opts :cache?])))
  (is (= (d/deodorize '(:cache? (:opts req)))
         '(get-in req [:opts :cache?]))))

(deftest non-keyword-keys-are-untouched
  (is (= (d/deodorize '(Map/get m k)) '(Map/get m k)))
  (is (= (d/deodorize '(Map/get headers "authorization"))
         '(Map/get headers "authorization")))
  (is (= (d/deodorize '(Map/get m (name k))) '(Map/get m (name k)))))

; ── rewrites (by value) ───────────────────────────────────────────────

(deftest map-access-rewrites-are-value-identical
  (let [m {:opts {:cache? true} :model "gpt"}]
    (is (= (:opts m) (Map/get m :opts)))
    (is (= (get m :missing {}) (Map/get m :missing {})))
    (is (= (get-in m [:opts :cache?]) (:cache? (:opts m))))
    (is (= (get-in m [:opts :cache?])
           (Map/get (Map/get m :opts {}) :cache?))))
  ; the ONE divergence, pinned so the tiering note stays honest:
  ; keyword-as-fn on nil returns nil where Map/get on nil would raise —
  ; the rewrite trades a crash for a nil on that edge alone.
  (is (nil? (:opts nil))))

; ── detect ────────────────────────────────────────────────────────────

(deftest scan-reports-guarded-hits-only
  (let [form '(defn f [m k] [(Map/get m :opts) (Map/get m k)])
        hits (d/scan (d/all-rules) form)]
    (is (= 1 (count (filter (fn [h] (= (:rule h) 'map-get->kw-access))
                            hits))))))

(deftest report-counts-by-smell-name
  (let [r (d/report (d/all-rules) '(defn f [m] [(Map/get m :a) (Map/get m :b)]))]
    (is (= 2 (get r 'map-get->kw-access)))))

; ── the fixer: span-preserving source rewrite ─────────────────────────

(deftest fixer-splices-and-preserves-comments
  (let [src "(defn f [req]\n  ; this comment survives\n  (Map/get req :opts {}))\n\n; trailing note\n"
        res (d/fix-source (d/all-rules) src)
        out (:source res)]
    (is (= (:changed res) 1))
    (is (String/contains? out "; this comment survives"))
    (is (String/contains? out "; trailing note"))
    (is (String/contains? out "(get req :opts {})"))
    (is (not (String/contains? out "Map/get")))))

(deftest fixer-touches-only-smelled-spans
  (let [src "(defn a [m] (Map/get m :x))\n(defn b [m] (Map/get m k))\n"
        res (d/fix-source (d/all-rules) src)]
    ; the variable-key sibling is not a smell — byte-for-byte untouched
    (is (= (:changed res) 1))
    (is (String/contains? (:source res) "(:x m)"))
    (is (String/contains? (:source res) "(defn b [m] (Map/get m k))"))))

(deftest fixer-ignores-delimiters-inside-strings
  ; the span scanner must not count parens inside a string literal
  (let [src "(defn h [m] (str (Map/get m :k) \"))))\"))\n"
        res (d/fix-source (d/all-rules) src)]
    (is (= (:changed res) 1))
    (is (String/contains? (:source res) "(:k m)"))
    (is (String/contains? (:source res) "\"))))\""))))

(deftest fixer-is-idempotent
  (let [src   "(defn g [m] (:b (:a m)))\n"
        once  (d/fix-source (d/all-rules) src)
        twice (d/fix-source (d/all-rules) (:source once))]
    (is (= (:changed once) 1))
    (is (String/contains? (:source once) "(get-in m [:a :b])"))
    (is (= (:changed twice) 0))))

(deftest fix-file-roundtrip
  (let [path "/tmp/deodorant-test-fixme.bl"
        src  "; header comment\n(defn f [m] (Map/get m :x))\n"]
    (File/write path src)
    (let [res (d/fix-file! (d/all-rules) path)
          out (second (File/read path))]
      (is (= (:changed res) 1))
      (is (String/contains? out "; header comment"))
      (is (String/contains? out "(:x m)"))
      ; second run: nothing left to do, no write
      (is (= (:changed (d/fix-file! (d/all-rules) path)) 0)))))

; ── user extension ────────────────────────────────────────────────────

(deftest advisory-rules-carry-their-flag
  (let [s (smell-named 'datalog/nested-scan)]
    (is (some? s) "the datalog plan rule is registered")
    (is (= :idiomatic (:tier s)))
    (is (= true (:advisory s)) "defsmell forwards :advisory into the smell map")
    (is (string? (:note s)) "and forwards :note")))

(deftest defsmell-extends-the-registry
  (let [before (count (d/all-smells))]
    (d/defsmell inc-inc->plus-two :idiomatic (inc (inc ?x)) => (+ ?x 2))
    (is (= (count (d/all-smells)) (+ before 1)))
    (is (= (d/deodorize '(inc (inc 5))) '(+ 5 2)))))

; ── MIGRATION: a smell whose target may not exist, and its second edit ──
;
; A migration is correct but its target is only SOMETIMES available, and its
; output may need a require on the header. The three claims that matter: the
; rule is INERT until its prerequisite resolves (and says so), the fixer drags
; the second edit with it, and the report names the kind.

(deftest migrations-are-their-own-tier-not-in-the-default-set
  (let [mig-names     (map :name (d/migration-rules))
        every-names   (map :name (d/every-rule))
        default-names (map :name (d/all-rules))]
    (is (some (fn [n] (= n 'defregistry→registry-clause)) mig-names)
        "the defregistry migration is registered :migration")
    (is (some (fn [n] (= n 'defregistry→registry-clause)) every-names))
    (is (not (some (fn [n] (= n 'defregistry→registry-clause)) default-names))
        "a migration is NEVER in the default ruleset — it is a diff to review")))

(deftest a-migration-fires-only-when-its-target-resolves
  (let [live {:name 'live :tier :migration
              :pattern '(old ?x) :replacement '(new ?x)
              :requires-ns 'rewrite/match?}
        dead {:name 'dead :tier :migration
              :pattern '(old ?x) :replacement '(new ?x)
              :requires-ns 'no.such.ns/thing}]
    (is (some? (d/smell-match live '(old 1))))
    (is (nil? (d/smell-match dead '(old 1)))
        "an unmet prerequisite makes the rule inert")
    (is (= '(new 1) (d/deodorize-with (list live) '(old 1))))
    (is (= '(old 1) (d/deodorize-with (list dead) '(old 1)))
        "and the fixer is a no-op, never a rewrite to an unresolvable word")))

(deftest an-inert-migration-is-reported-skipped
  (let [dead  {:name 'dead :tier :migration :pattern '(old ?x) :replacement '(new ?x)
               :requires-ns 'no.such.ns/thing}
        plain {:name 'plain :tier :safe :pattern '(old ?x) :replacement '(new ?x)}]
    (is (= '(dead) (map :name (d/skipped-rules (list dead plain)))))
    (is (some (fn [s] (= (:name s) 'srv-defserver→defserver))
              (d/skipped-rules (d/every-rule)))
        "the qualifier drop is parked on core/defserver, and says so")))

(deftest ensure-requires-appends-a-require-or-refuses
  ; a file with a :require clause gets the entry appended as a NEW vector
  (let [r (d/ensure-requires "(ns demo\n  (:require [reg :as reg]))\n(x)\n"
                             (list '[proc.server :as srv]))]
    (is (:changed r))
    (is (String/contains? (:source r)
                          "(ns demo\n  (:require [reg :as reg] [proc.server :as srv]))"))
    (is (nil? (:refused r))))
  ; already required → idempotent, no change
  (let [src "(ns demo (:require [proc.server :as srv]))\n"
        r   (d/ensure-requires src (list '[proc.server :as srv]))]
    (is (not (:changed r)))
    (is (= (:source r) src)))
  ; no :require clause → refused, source untouched, the line named
  (let [src "(ns demo)\n\n(x)\n"
        r   (d/ensure-requires src (list '[proc.server :as srv]))]
    (is (string? (:refused r)))
    (is (String/contains? (:refused r) "line 1"))
    (is (= (:source r) src)))
  ; the same namespace under a DIFFERENT alias → refused, never two requires
  (let [r (d/ensure-requires "(ns demo (:require [proc.server :as server]))\n"
                             (list '[proc.server :as srv]))]
    (is (string? (:refused r)))))

(deftest a-migration-fix-lands-its-second-edit-and-refuses-safely
  (let [mig {:name 'm :tier :migration
             :pattern '(old ?name) :replacement '(srv/new ?name)
             :requires-ns 'rewrite/match?
             :ensure-require '[proc.server :as srv]}
        good (d/fix-source-preserving
              (list mig)
              "(ns demo.legacy\n  (:require [reg :as reg]))\n\n(old thing)\n")]
    (is (= (:changed good) 1))
    (is (String/contains? (:source good) "(srv/new thing)"))
    (is (String/contains? (:source good) "[proc.server :as srv]")
        "the second edit lands on the header")
    (is (= '[[proc.server :as srv]] (:requires-added good)))
    (is (nil? (:refused good))))
  ; a header with no :require → refused, and NOTHING is emitted
  (let [mig {:name 'm2 :tier :migration
             :pattern '(old ?name) :replacement '(srv/new ?name)
             :requires-ns 'rewrite/match?
             :ensure-require '[proc.server :as srv]}
        src "(ns demo.bare)\n\n(old thing)\n"
        bad (d/fix-source-preserving (list mig) src)]
    (is (string? (:refused bad)))
    (is (= (:changed bad) 0))
    (is (= (:source bad) src)
        "the rewrite is withheld when the header cannot be amended")))

(deftest a-rest-pattern-migration-rewrites-every-arity
  (d/defsmell drop-server-qualifier :migration
    (srv/defserver ?name ?*clauses) => (defserver ?name ?*clauses)
    :requires-ns rewrite/match?)
  (let [s (smell-named 'drop-server-qualifier)]
    (is (some? s) "the shape migration registered through its own rule")
    (is (= '(defserver beat)
           (d/deodorize-with (list s) '(srv/defserver beat))))
    (is (= '(defserver beat (tick 5))
           (d/deodorize-with (list s) '(srv/defserver beat (tick 5)))))
    (is (= '(defserver beat (a 1) (b 2) (c 3) (d 4) (e 5) (f 6) (g 7))
           (d/deodorize-with (list s)
                             '(srv/defserver beat (a 1) (b 2) (c 3) (d 4) (e 5) (f 6) (g 7))))))
  ; end-to-end through the trivia-preserving fixer, the one `bl fix` uses
  (let [res (d/fix-source-preserving
             (list (smell-named 'drop-server-qualifier))
             "(srv/defserver reaper (tick 15 :minutes))\n")]
    (is (= (:changed res) 1))
    (is (= (:source res) "(defserver reaper (tick 15 :minutes))\n"))))

(deftest a-met-prerequisite-makes-the-registry-migration-available
  (let [s (smell-named 'defregistry→registry-clause)]
    (is (some? s) "the registry migration is registered")
    (is (d/available? s)
        "proc.reg/registry-clause resolves, so the rule is no longer inert")
    (is (not (some (fn [x] (= (:name x) 'defregistry→registry-clause))
                   (d/skipped-rules (d/every-rule))))
        "and it is not reported skipped"))
  ; a met prerequisite means the migration actually FIRES through the
  ; trivia-preserving fixer `bl fix` calls — the rewrite AND its second edit.
  (let [src "(ns demo.legacy\n  (:require [reg :as reg]))\n\n(reg/defregistry thing (keys :id))\n"
        res (d/fix-source-preserving (list (smell-named 'defregistry→registry-clause)) src)]
    (is (= 1 (:changed res)) "the defregistry form was rewritten")
    (is (String/contains? (:source res) "(srv/defserver thing (registry (keys :id)))"))
    (is (String/contains? (:source res) "[proc.server :as srv]")
        "the second edit landed on the (ns …) require clause")
    (is (nil? (:refused res)))))

(deftest the-rest-pattern-migration-fires-once-unparked
  ; The shipped srv-defserver→defserver rule is parked on the ladder
  ; (core/defserver). Satisfy ONLY that prerequisite and it must rewrite a
  ; ?*clauses tail at every arity through fix-source-preserving — the property
  ; span-rewrite's own node matcher must reach (FUP-095).
  (let [live (assoc (smell-named 'srv-defserver→defserver) :requires-ns 'rewrite/match?)]
    (doseq [tail ["" " (tick 5)" " (a 1) (b 2) (c 3)"]]
      (let [src (str "(srv/defserver beat" tail ")\n")
            res (d/fix-source-preserving (list live) src)]
        (is (= 1 (:changed res)) (str "rewrote with tail:" tail))
        (is (= (str "(defserver beat" tail ")\n") (:source res))
            "the clause tail is spliced verbatim")))))

(deftest the-report-says-which-kind-of-finding-it-was
  (let [mig  {:name 'm :tier :migration :pattern '(old ?x) :replacement '(new ?x)
              :requires-ns 'rewrite/match? :ensure-require '[proc.server :as srv]}
        safe {:name 's :tier :safe :pattern '(old2 ?x) :replacement '(new2 ?x)}
        rep  (lint/lint-source (list mig safe) "x.bl" "(old 1)\n(old2 2)\n")
        by-name (fn [n] (first (filter (fn [s] (= (:name s) n)) (:smells rep))))]
    (is (= :migration (:tier (by-name "m"))) "the migration keeps its own tier")
    (is (= :safe (:tier (by-name "s"))))
    (is (= ["[proc.server :as srv]"] (:ensures (by-name "m")))
        "and the report names the second edit it implies")))
