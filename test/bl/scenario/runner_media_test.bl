(ns scenario.runner-media-test
 (:require [scenario.runner.app :as runner] [scenario.runner.nle :as nle]
           [live.app :as app] [live.diff :as diff]))
(defn nodes [tree]
 (if (sequential? tree) (cons tree (mapcat nodes tree)) []))
(defn render-at [at]
 (app/dispatch nil nil {:app (runner/app-value) :me "viewer" :route "/run/film" :at at}))
(deftest scrubbing-a-film-preserves-the-player-and-changes-its-seek-coordinate
 (runner/set-suite! {:title "Film" :runs [{:id "film" :title "A demo" :verdict :witnessed :world :browser
   :media {:src "/demo.mp4" :captions "/demo.vtt"}
   :steps [{:i 1 :actor :viewer :verdict :witnessed :t 0}
           {:i 2 :actor :viewer :verdict :witnessed :t 8.25}]}]})
 (let [a (render-at 1) b (render-at 2)
       video (fn [tree] (first (filter (fn [n] (= :video (first n))) (nodes tree))))
       ops (diff/diff a b)]
  (is (= "0" (:data-media-seek (second (video a)))))
  (is (= "8.25" (:data-media-seek (second (video b)))))
  (is (= "scenario-media" (:key (second (video a)))))
  (is (not (some (fn [op] (and (contains? #{:replace :insert} (first op))
                        (some (fn [n] (= :video (first n))) (nodes op)))) ops)))
  (is (= (diff/normalize b) (diff/apply-ops ops a)))))

(deftest movie-clocks-use-measured-seconds-and-state-runs-use-step-numbers
 (let [run {:duration-ms 91300 :media {:src "/movie.mp4"}
            :steps [{:i 1 :t 0} {:i 2 :t 65.2}]}
       movie (pr-str (nle/transport-deck run 2))
       state (pr-str (nle/transport-deck (dissoc run :media) 2))]
  (is (String/contains? movie "00:01:05 / 00:01:31"))
  (is (String/contains? state "step 2 / 2"))
  (is (= "01:00:05" (nle/timecode 3605.9)))
  (is (= "—" (nle/timecode nil)))))
