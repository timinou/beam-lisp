(ns scenario.demo-test
  (:require [scenario :as s] [scenario.demo :as demo] [scenario.runner.adapt :as adapt]
            [clojure.edn :as edn] [interop]))

(def root (str "/tmp/bl-demo-" (erlang/unique_integer (list :positive))))
(defn fake-world [disposed]
  (let [n (atom 0)]
    {:kind :browser :open (fn [_] nil)
     :step! (fn [_ event] (if (= :explode (get-in event [2 0]))
                           (throw (ex-info "Action exploded" {})) :ok))
     :claim! (fn [_ _ claim ctx] (claim nil ctx)) :observe (fn [_ _ lens] (lens nil))
     :liveness (fn [_] nil) :close! (fn [_] {}) :views-fn (fn [basis _] basis)
     :basis (fn [_] {:frame (str "shot-" (swap! n inc) ".png")})
     :dispose! (fn [] (swap! disposed inc))}))
(defn story []
  (s/scenario "Two features" {:viewer {}}
    [(s/does :viewer [:navigate "/"])
     (demo/scene :open {:say "Ouvrez votre dossier."}
       (s/does :viewer [:click "#open"])
       (s/sees :viewer (fn [_ _] true) "The dossier opens"))
     (demo/scene :approve {:say "Validez les documents." :subtitle "Validez vos documents."}
       (s/sees :viewer (fn [_ _] true) "Approval is available"))]))

(deftest annotations-preserve-the-ordinary-scenario-and-pattern-semantics
  (let [disposed (atom 0) scen (story) result (s/run-world scen (fake-world disposed))]
    (is (= 4 (count (:steps scen))))
    (is (= [:act :act :expect :expect] (mapv first (:steps scen))))
    (is (:ok result))
    (is (= 2 (count (:verdicts result))))
    (is (= "open" (get-in (meta (nth (:steps scen) 1)) [:scenario.demo/scene :id]))))
  (is (= 2 (count (demo/scene :pattern {:say "Les deux vues se mettent à jour."}
                    (s/converges :writer [:save] :viewer (fn [_ _] true) "Converged")))))
  (is (thrown? (demo/scene :empty {:say "Bonjour."}))))

(deftest captures-and-presentation-clocks-derive-from-the-same-inline-scenes
  (let [disposed (atom 0) out (str root "/clock")
        result (demo/run! {:id "clock" :output out :world (fake-world disposed) :export? false} (story))
        scenes (get-in result [:film :scenes])
        manifest {"duration" 10 "language" "fr" "scenes"
                  (mapv (fn [scene offset] {"id" (:id scene) "offset" offset
                                            "step-marks" (mapv (fn [m] {"step" (:step m) "at" (:at m)}) (:step-marks scene))})
                        scenes [0 6])}
        shown (demo/presentation (:run result) manifest (fn [p] (str "/evidence/" p)))]
    (is (= 1 @disposed))
    (is (= ["open" "approve"] (mapv :id scenes)))
    (is (= (:run result) (edn/read-string (File/read! (str out "/run.edn")))))
    (is (= [0 0.6 1.2 6.6] (mapv :t (:steps shown))))
    (is (= (:claims (:run result)) (:claims shown)))
    (is (= "/evidence/demo.mp4" (get-in shown [:media :src])))
    (is (nil? (:manifest result)))
    (is (= 1 (count (:runs (demo/load-suite out "Captured demos")))))
    (File/rm_rf! out)))

(deftest failures-stay-refuted-and-clean-up-before-export
  (let [disposed (atom 0)
        scen (s/scenario "Refuted" {:viewer {}}
               [(demo/scene :false {:say "Une assertion échoue."}
                  (s/sees :viewer (fn [_ _] false) "Deliberately false"))])
        opts {:id "failed" :output (str root "/failed") :world (fake-world disposed) :export? false}
        result (demo/run! opts scen)]
    (is (= false (:ok result)))
    (is (= :refuted (get-in result [:film :run :verdict])))
    (is (= 1 @disposed))
    (is (thrown-with-msg? "failed demo" (demo/run! (assoc opts :export? true) scen)))
    (is (File/exists? (str root "/failed/run.json"))))
  (let [disposed (atom 0)]
    (is (thrown-with-msg? "Action exploded"
          (demo/run! {:id "exception" :output (str root "/exception") :world (fake-world disposed)}
            (s/scenario "Exception" {:viewer {}} [(s/does :viewer [:explode])]))))
    (is (= 1 @disposed)))
  (File/rm_rf! root))

(deftest scene-name-collisions-fail-before-opening-a-world
  (let [opened (atom 0)
        scen (s/scenario "Duplicate" {:viewer {}}
               [(demo/scene :same {:say "Un."} (s/does :viewer [:a]))
                (s/does :viewer [:gap])
                (demo/scene :same {:say "Deux."} (s/does :viewer [:b]))])]
    (is (thrown-with-msg? "unique" (demo/run! {:id "duplicate" :world (fn [_] (swap! opened inc))} scen)))
    (is (= 0 @opened))))

(deftest adjacent-scenes-cannot-reuse-a-name
  (is (thrown-with-msg? "unique"
        (demo/plan (s/scenario "Duplicate" {:viewer {}}
                     [(demo/scene :same {:say "Un."} (s/does :viewer [:a]))
                      (demo/scene :same {:say "Deux."} (s/does :viewer [:b]))])
                   {} {}))))

(deftest fixtures-wrap-cleanup-and-failed-exports-retain-a-gallery-entry
  (let [calls (atom []) out (str root "/fixture")
        opts {:id "fixture" :output out :world (fake-world (atom 0)) :export? true
              :with-fixture (fn [f] (swap! calls conj :setup)
                              (try (f) (finally (swap! calls conj :cleanup))))}]
    (is (thrown-with-msg? "failed demo"
          (demo/run! opts (s/scenario "Failure" {:viewer {}}
                            [(demo/scene :failed {:say "Échec."}
                               (s/sees :viewer (fn [_ _] false) "False"))]))))
    (is (= [:setup :cleanup] @calls))
    (is (= :refuted (get-in (demo/load-suite out "Failed demos") [:runs 0 :verdict])))
    (File/rm_rf! out)))

(demo/defdemo first-independent-demo
  {:output (str root "/first") :world (fake-world (atom 0)) :export? false}
  (s/scenario "First demo" {:viewer {}}
    [(demo/scene :first {:say "Premier exemple."} (s/sees :viewer (fn [_ _] true) "First demo works"))]))

(demo/defdemo second-independent-demo
  {:output (str root "/second") :world (fake-world (atom 0)) :export? false}
  (s/scenario "Second demo" {:viewer {}}
    [(demo/scene :second {:say "Deuxième exemple."} (s/sees :viewer (fn [_ _] true) "Second demo works"))]))
