; test/bl/scenario/patterns_test.bl — the five films' properties, as
; patterns, PROVEN in the model world.
;
; film_scenarios.bl proves these on the real app with a browser; this file
; proves the same properties on the datom log alone — milliseconds, no
; browser, no flake — because a convergence you can't decide in-model has no
; business being filmed. :model → :kernel is the honesty chain: the model
; PROVES the property, the browser WITNESSES it, the film SHOWS the witness.
;
; The five properties (printflow/film_scenarios.bl):
;   rush-incident   → converges  : the operator's tap moves the commercial's promise
;   cascade-visible → shifts     : the promise moves by EXACTLY the computed delta
;   isolation       → isolated   : an incident elsewhere does not contaminate
;   resolve-honest  → stays      : resolving un-blocks, the lost time stays lost
;   full-chain      → (lively)   : every actor's plane stays up across the take
;
; Run: bl test test/bl/scenario/patterns_test.bl

(ns scenario.patterns-test
  (:require [scenario :as s]
            [scenario.plant :as plant]
            [datom :as datom] [datom.time :as time]))

;; ── the shared plant store (all actors act on THIS) ─────────────────
(def conn (datom/connect plant/plant-schema))
(def r1 (datom/transact! conn
  [{:db/id -1 :job/id "j-1" :job/status :planned}
   {:db/id -2 :resource/id "cd102" :resource/kind :machine :resource/status :up}
   {:db/id -3 :resource/id "cd103" :resource/kind :machine :resource/status :up}]))
(def CD102 (get (:tempids r1) -2))
(def CD103 (get (:tempids r1) -3))
(def r2 (datom/transact! conn
  [{:db/id -4 :assign/id "a-1" :assign/status :pending
    :assign/span (time/interval :year 2026 :month 9 :day 3 :hour 10)}]))
(def A (get (:tempids r2) -4))               ; the press assignment

;; ── the domain perform fn: how each action becomes datoms ───────────
(defn perform [conn actor action]
  (let [kind (first action)]
    (cond
      (= kind :log-incident)
        (do (datom/transact! conn
              [{:db/id -10 :incident/id "inc-1" :incident/scope :artifact
                :incident/kind :paper-jam :incident/at A :incident/resolved false}
               [:db/add A :assign/status :blocked]
               [:db/add A :assign/span (time/interval :year 2026 :month 9 :day 4 :hour 14)]])
          {:logged true})
      (= kind :log-incident-2)
        (do (datom/transact! conn
              [{:db/id -11 :incident/id "inc-2" :incident/scope :resource
                :incident/kind :blade :incident/at CD103 :incident/resolved false}
               [:db/add CD103 :resource/status :down]])
          {:logged true})
      (= kind :resolve-incident)
        (do (datom/transact! conn [[:db/add A :assign/status :planned]])
          {:resolved true})
      :else :ok)))

;; ── lenses: what an actor can observe ───────────────────────────────
(def promise-lens (fn [db] (:assign/span (datom/entity db A))))
(def press-lens   (fn [db] (:resource/status (datom/entity db CD102))))

;; measure: span delta in seconds (the cascade's exact arithmetic)
(def secs (fn [after before] (- (:to after) (:to before))))

;; ── claims: (fn [db ctx] bool) — ctx carries the witnesses ──────────
(def thu-int (time/interval :year 2026 :month 9 :day 3 :hour 10))

(println "== the five film properties, as patterns, proven in-model ==")

;; ── the scenario VALUE: one skeleton, four patterns ─────────────────
(def rush
  (s/scenario "kernel rush"
    {:amina {:role :commerciale} :rachid {:role :chef-atelier}
     :karim {:role :prepresse} :op12 {:role {:kiosk :cd102}}}

    ;; witness + claim over the witness ctx: the primitive pairing
    [(s/witness :amina promise-lens :thu)
     (s/sees :amina (fn [db ctx] (time/overlaps? (get-in ctx [:witnesses :thu]) thu-int))
             "promise is Thursday 10:00 — the witnessed basis is bound")

     ;; rush-incident + cascade-visible, as ONE pattern: the operator acts,
     ;; the promise moves by EXACTLY +28h (Thu 10:00 → Fri 14:00), computed
     (s/shifts :op12 (s/act :log-incident) :amina promise-lens secs 100800
               "promesse décalée de 28h — calculée, pas devinée")
     (s/sees :amina (fn [db ctx] (= :blocked (:assign/status (datom/entity db A))))
             "the step reads :blocked everywhere")
     (s/beat 0)

     ;; isolation: an incident on cd103 does not touch what karim watches
     (s/isolated :op12 (s/act :log-incident-2) :karim press-lens
                 "l'incident est ailleurs — cd102 reste :up")

     ;; resolve-honest: rachid resolves; the promise STAYS moved (stays, below)
     (s/does :rachid (s/act :resolve-incident))
     (s/sees :amina (fn [db ctx] (= :planned (:assign/status (datom/entity db A))))
             "débloqué — mais la promesse reste Friday 14:00")]

    ;; run-level patterns: checked across the whole stretch at close
    [(s/stays :amina promise-lens "le temps perdu reste perdu")
     (s/lively :amina :op12 :karim)]))

;; ── the scenario VALUE: one skeleton, four patterns ─────────────────
(def world (s/model-world conn perform
  (fn [db actor] {:actor actor
                  :status (:assign/status (datom/entity db A))
                  :promised-date (:assign/span (datom/entity db A))})))
(def result (s/run-world rush world))

(println "   → certificate:")
(doseq [v (:verdicts result)]
  (println "     " (:verdict v) (:actor v) "—" (:msg v)))
(doseq [st (:stretches result)]
  (println "     " (:kind st) "→" (:verdict st) (or (:msg st) "")))

;; every claim proven, every stretch held
(deftest all-proven
  (is (= true (:ok result)))
  (is (= true (s/all-proven? result)))
  (is (= 5 (count (filter (fn [v] (= :proven (:verdict v))) (:verdicts result))))))

;; the stretches: stays proven, lively :unknown — the model world honestly
;; cannot decide liveness (no live plane); a browser world will witness it.
(deftest stretches
  (is (= :proven (:verdict (first (filter (fn [p] (= :stays (:kind p))) (:stretches result))))))
  (is (= :unknown (:verdict (first (filter (fn [p] (= :lively (:kind p))) (:stretches result)))))))

;; the witnesses landed: karim's :before capture (the isolated pattern's)
(deftest witnesses-bound
  (is (= :up (get-in result [:witnesses :before]))))

;; the trace is an inspectable history — every event recorded with verdict
(deftest trace-inspectable
  (is (= 12 (count (:trace result))))
  (println "   → history:")
  (doseq [t (:trace result)]
    (println "     " (:step t) (:actor t) "→" (pr-str (first (:action t)))
             ":" (pr-str (:outcome t)) "/" (pr-str (:verdict t)))))

;; v1 surface still reads the same run: amina's projected final view
(deftest v1-surface
  (is (= true (s/all-expects-passed? result)))
  (is (= true (s/converged? result :amina
                (fn [v] (and (= :planned (:status v))
                             (time/overlaps? (:promised-date v)
                               (time/interval :year 2026 :month 9 :day 4 :hour 14))))))))

;; ── refutation has teeth: a false claim refutes, with the witness kept ──
(println "== a false claim refutes — the certificate reads red, honestly ==")
(def bad
  (s/scenario "refutation demo"
    {:amina {:role :commerciale} :op12 {:role {:kiosk :cd102}}}
    [(s/does :op12 (s/act :noop))
     (s/sees :amina (fn [db ctx] false) "the promise is Thursday — a LIE after the incident")]))
(def bad-result (s/run-world bad world))

(deftest refutation
  (is (= false (:ok bad-result)))
  (is (= false (s/all-proven? bad-result)))
  (is (= 1 (count (s/refuted bad-result))))
  (is (= :refuted (:verdict (first (s/refuted bad-result)))))
  (is (= "the promise is Thursday — a LIE after the incident" (:msg (first (s/refuted bad-result))))))

(println)
