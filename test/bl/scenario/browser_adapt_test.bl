; test/bl/scenario/browser_adapt_test.bl — the browser-evidence adapter, proven.
;
; (research/90-agh-reconciliation/52-browser-evidence-contract.md)
;
; of-browser is a PURE function from (descriptor, manifest, current expected
; provenance) to the shared Run. This file pins its honesty:
;
;   · nil / empty / legacy / stale / running / global-failure / incomplete
;     takes NEVER yield a witnessed frame;
;   · a complete take is a witness ONLY when its provenance carries a
;     nonempty sourceFingerprintAfter equal to BOTH the before
;     sourceFingerprint and the host's expected source, and its startedAt /
;     finishedAt are valid ISO instants in order (missing/null/drifted
;     post-source or invalid/reversed instants read stale/time, never green);
;   · a matching, terminal COMPLETE take is witnessed ONLY when a manifest beat
;     row exists with status complete, completedSteps cover every required index,
;     every required op has a complete matching (actor/beat/op) step row and
;     every required assertion has an explicit successful matching row — and is
;     NEVER :proven;
;   · a failed assertion, a missing/conflicting required shot (or one the host's
;     availability callback rejects), an unknown actor/op, an authored hole, an
;     assertion pinned to an unknown beat, a pending/absent beat, a missing
;     completedSteps list, a duplicated step index and an empty executable beat
;     are all surfaced, not ignored;
;   · the frame carries the stable beat :id and a :trace with the reason, so a
;     host projects a verdict without reinterpreting the manifest;
;   · keyword and camelCase-JSON descriptors normalize to the same run.
;
; The fixtures below are authored INDEPENDENTLY of the take manifest: the
; descriptor's required ops/assertions are stated by hand, never derived from the
; manifest being validated.
;
; Run: bl test test/bl/scenario/browser_adapt_test.bl

(ns scenario.browser-adapt-test
  (:require [scenario.runner.adapt :as a]))

;; ── the synthetic descriptor (keyword form) and a matching take ─────

(def D1
  {:schema-version 1
   :id "t1" :title "T"
   :actors {"a" {:role "A" :path "/a"}}
   :story-fingerprint "sha256:story"
   :beats [{:id "b1" :title "B1" :actor "a"
            :missing? false :caveat nil :hole nil :narrative nil
            :at nil :screen nil :roster []
            :required-steps [0 1 2]
            :required-ops [{:step 0 :actor "a" :op "visit"}
                           {:step 1 :actor "a" :op "expect-value"}
                           {:step 2 :actor "a" :op "screenshot"}]
            :required-assertions [{:step 1 :actor "a" :kind "value" :text "OK"}]
            :required-shots [{:step 2 :actor "a" :name "b1"}]}]})

(def D-hole
  (assoc D1 :beats
         (conj (:beats D1)
               {:id "hr" :title "RH" :actor "a"
                :missing? true :hole "aucun écran RH" :caveat nil :narrative nil
                :at nil :screen nil :roster []
                :required-steps [] :required-ops [] :required-assertions []
                :required-shots []})))

;; A selector-only requirement the take never records a row for.
(def D1-sel
  (assoc D1 :beats
         [(assoc (first (:beats D1)) :required-assertions
                 [{:step 1 :actor "a" :kind "selector" :selector "text=OK"}])]))

;; A beat that declares no required work at all (not authored as a hole).
(def D-empty
  {:schema-version 1
   :id "t1" :title "T"
   :actors {"a" {:role "A" :path "/a"}}
   :story-fingerprint "sha256:story"
   :beats [{:id "b1" :title "B1" :actor "a"
            :missing? false :caveat nil :hole nil :narrative nil
            :at nil :screen nil :roster []
            :required-steps [] :required-ops [] :required-assertions []
            :required-shots []}]})

(def D1-wire
  {"schemaVersion" 1
   "id" "t1" "title" "T"
   "actors" {"a" {"role" "A" "path" "/a"}}
   "storyFingerprint" "sha256:story"
   "beats" [{"id" "b1" "title" "B1" "actor" "a" "missing" false
             "requiredSteps" [0 1 2]
             "requiredOps" [{"step" 0 "actor" "a" "op" "visit"}
                            {"step" 1 "actor" "a" "op" "expect-value"}
                            {"step" 2 "actor" "a" "op" "screenshot"}]
             "requiredAssertions" [{"step" 1 "actor" "a" "kind" "value" "text" "OK"}]
             "requiredShots" [{"step" 2 "actor" "a" "name" "b1"}]}]})

(def M
  {"schemaVersion" 1
   "runId" "run-1"
   "name" "t1"
   "provenance" {"storyFingerprint" "sha256:story"
                 "sourceFingerprint" "sha256:src"
                 "sourceFingerprintAfter" "sha256:src"
                 "runtimeVersion" "bl 1"
                 "serverRuntimeVersion" "bl 1"}
   "startedAt" "2026-10-05T10:00:00Z"
   "finishedAt" "2026-10-05T10:01:00Z"
   "status" "complete"
   "ok" true
   "beats" [{"id" "b1" "status" "complete" "completedSteps" [0 1 2]}]
   "steps" [{"i" 0 "beat" "b1" "actor" "a" "op" "visit" "status" "complete"
             "startedAt" "2026-10-05T10:00:01Z" "finishedAt" "2026-10-05T10:00:02Z"}
            {"i" 1 "beat" "b1" "actor" "a" "op" "expect-value" "status" "complete"
             "startedAt" "2026-10-05T10:00:02Z" "finishedAt" "2026-10-05T10:00:03Z"}
            {"i" 2 "beat" "b1" "actor" "a" "op" "screenshot" "status" "complete"
             "startedAt" "2026-10-05T10:00:03Z" "finishedAt" "2026-10-05T10:00:04Z"}]
   "asserts" [{"step" 1 "beat" "b1" "actor" "a" "kind" "value" "text" "OK" "ok" true}]
   "screenshots" [{"step" 2 "beat" "b1" "actor" "a" "name" "b1"
                   "path" "/takes/run-1/a-b1.png" "sha256" "abc123"}]
   "videos" {"a" "/takes/run-1/a.webm"}
   "errors" []})

(def EP {:source-fingerprint "sha256:src"
         :runtime-version "bl 1"
         :server-runtime-version "bl 1"})

(def run (a/of-browser D1 M EP))

;; ── the happy take: witnessed, never proven ─────────────────────────

(deftest happy-take-is-witnessed
  (is (= :witnessed (:verdict run)))
  (is (= :browser (:world run)))
  (is (= 60000 (:duration-ms run)))            ; one minute, from real instants
  (is (= 1 (count (:steps run))))
  (let [f (first (:steps run))]
    (is (= :witnessed (:verdict f)))
    (is (= "b1" (:id f)))                       ; stable beat id
    (is (= 1 (:i f)))
    (is (= :a (:actor f)))
    (is (= "complete" (get-in f [:trace :status])))
    (is (= [0 1 2] (get-in f [:trace :required-steps])))
    ;; the default view exposes the real artifact path/hash, not ambient IO
    (is (= "/takes/run-1/a-b1.png" (get-in f [:views :a :path])))
    (is (= "abc123" (get-in f [:views :a :sha256]))))
  ;; claims carry step/beat identity: one per assertion, one per required shot
  (is (= 2 (count (:claims run))))
  (is (every? (fn [c] (= :witnessed (:verdict c))) (:claims run)))
  (is (= ["b1" "b1"] (mapv :beat (:claims run))))
  (is (= [1 1] (mapv :step (:claims run))))
  (is (= #{"value" :shot} (set (map (fn [c] (get-in c [:evidence :kind])) (:claims run))))))

(deftest browser-evidence-is-never-proven
  (is (not (some (fn [c] (= :proven (:verdict c))) (:claims run))))
  (is (not (some (fn [s] (= :proven (:verdict s))) (:stretches run))))
  (is (not (some (fn [f] (= :proven (:verdict f))) (:steps run)))))

(deftest json-descriptor-normalizes-the-same
  (let [r (a/of-browser D1-wire M EP)]
    (is (= :witnessed (:verdict r)))
    (is (= "b1" (:id (first (:steps r)))))))

(deftest shot-view-resolver-is-used
  (let [r (a/of-browser D1 M EP {:shot-view (fn [s] (str "link:" (get s "path")))})]
    (is (= "link:/takes/run-1/a-b1.png" (get-in r [:steps 0 :views :a])))))

;; ── negative cases: no newly witnessed green ────────────────────────

(defn- witnessed-in? [coll]
  (some (fn [x] (= :witnessed (:verdict x))) coll))

(defn- no-witness? [r]
  (and (not= :witnessed (:verdict r))
       (not (witnessed-in? (:steps r)))
       (not (witnessed-in? (:claims r)))))

(deftest empty-evidence
  (let [r (a/of-browser nil nil nil)]
    (is (no-witness? r))
    (is (empty? (:steps r)))
    (is (some (fn [s] (= :unplayed (:kind s))) (:stretches r)))))

(deftest no-manifest
  (let [r (a/of-browser D1 nil EP)]
    (is (no-witness? r))
    (is (= :unknown (:verdict (first (:steps r)))))))

(deftest legacy-manifest-is-not-evidence
  (let [r (a/of-browser D1 (dissoc M "schemaVersion") EP)]
    (is (no-witness? r))
    (is (some (fn [s] (= :legacy (:kind s))) (:stretches r)))))

(deftest global-run-error-refutes
  (let [r (a/of-browser D1 (assoc M "status" "failed"
                                  "errors" [{"scope" "run" "message" "cleanup failed"}]) EP)]
    (is (= :refuted (:verdict r)))
    (is (no-witness? r))))

(deftest stale-story-fingerprint
  (let [r (a/of-browser D1 (update M "provenance"
                                  (fn [p] (assoc p "storyFingerprint" "sha256:other"))) EP)]
    (is (no-witness? r))
    (is (some (fn [s] (= :stale (:kind s))) (:stretches r)))))

(deftest source-and-runtime-mismatch
  (is (no-witness? (a/of-browser D1 (update M "provenance"
                                          (fn [p] (assoc p "sourceFingerprint" "sha256:other"))) EP)))
  (is (no-witness? (a/of-browser D1 (update M "provenance"
                                          (fn [p] (assoc p "runtimeVersion" "bl 2"))) EP)))
  ;; parent and server must match each other and the pin
  (is (no-witness? (a/of-browser D1 (update M "provenance"
                                          (fn [p] (assoc p "serverRuntimeVersion" "bl 2"))) EP))))

(deftest missing-source-after-is-untrusted
  ;; a matching complete take with no post-source measurement is never a
  ;; witnessed green — and never a legacy compatibility pass
  (let [r (a/of-browser D1 (update M "provenance" dissoc "sourceFingerprintAfter") EP)]
    (is (no-witness? r))
    (is (some (fn [s] (= :stale (:kind s))) (:stretches r)))))

(deftest null-source-after-is-untrusted
  (let [r (a/of-browser D1 (update M "provenance" assoc "sourceFingerprintAfter" nil) EP)]
    (is (no-witness? r))
    (is (some (fn [s] (= :stale (:kind s))) (:stretches r)))))

(deftest drifted-source-after-is-untrusted
  ;; the source moved during the take: before matches, after disagrees
  (let [r (a/of-browser D1 (update M "provenance" assoc "sourceFingerprintAfter" "sha256:other") EP)]
    (is (no-witness? r))
    (is (some (fn [s] (= :stale (:kind s))) (:stretches r)))))

(deftest unparseable-start-instant-is-untrusted
  (let [r (a/of-browser D1 (assoc M "startedAt" "not-a-time") EP)]
    (is (no-witness? r))
    (is (some (fn [s] (= :time (:kind s))) (:stretches r)))))

(deftest unparseable-finish-instant-is-untrusted
  (let [r (a/of-browser D1 (assoc M "finishedAt" "2026-13-40T99:99:99Z") EP)]
    (is (no-witness? r))
    (is (some (fn [s] (= :time (:kind s))) (:stretches r)))))

(deftest reversed-instants-are-untrusted
  ;; finish before start: the implied duration is negative nonsense
  (let [r (a/of-browser D1 (assoc M "finishedAt" "2026-10-05T09:59:00Z") EP)]
    (is (no-witness? r))
    (is (some (fn [s] (= :time (:kind s))) (:stretches r)))))

(deftest unknown-duration-is-absent-not-negative
  ;; a running take has no finished instant: duration is nil, never invented
  (let [r (a/of-browser D1 (assoc M "status" "running" "finishedAt" nil) EP)]
    (is (nil? (:duration-ms r)))))

(deftest malformed-expected-provenance-is-not-silently-nil
  (let [r (a/of-browser D1 M "not-a-map")]
    (is (no-witness? r))
    (is (some (fn [s] (= :stale (:kind s))) (:stretches r)))))

(deftest nonterminal-take-is-running
  (let [r (a/of-browser D1 (assoc M "status" "running" "finishedAt" nil) EP)]
    (is (no-witness? r))
    (is (some (fn [s] (= :running (:kind s))) (:stretches r)))))

(deftest missing-required-shot-refutes
  (let [r (a/of-browser D1 (assoc M "screenshots" []) EP)]
    (is (= :refuted (:verdict r)))
    (is (no-witness? r))
    (is (= :refuted (:verdict (first (:steps r)))))
    (is (= ["b1"] (get-in (first (:steps r)) [:trace :missing-shots])))))

(deftest removed-shot-rejected-by-host
  ;; the artifact was valid at take time but is gone now
  (let [r (a/of-browser D1 M EP {:available-shot? (fn [_] false)})]
    (is (= :refuted (:verdict r)))
    (is (no-witness? r))))

(deftest missing-required-step-refutes
  (let [r (a/of-browser D1 (assoc M "steps" [(first (get M "steps"))]) EP)]
    (is (= :refuted (:verdict r)))
    (is (no-witness? r))))

(deftest failed-selector-assertion-refutes
  (let [r (a/of-browser D1 (update M "asserts"
                                  (fn [as] [(assoc (first as) "ok" false)])) EP)]
    (is (= :refuted (:verdict r)))
    (is (no-witness? r))))

(deftest unknown-actor-is-a-failure
  (let [r (a/of-browser D1 (update M "steps"
                                  (fn [ss] [(assoc (first ss) "actor" "ghost") (second ss) (nth ss 2)]) ) EP)]
    (is (= :refuted (:verdict r)))
    (is (no-witness? r))))

(deftest empty-op-is-a-failure
  (let [r (a/of-browser D1 (update M "steps"
                                  (fn [ss] [(assoc (first ss) "op" "") (second ss) (nth ss 2)]) ) EP)]
    (is (= :refuted (:verdict r)))
    (is (no-witness? r))))

(deftest orphan-assertion-refutes
  (let [r (a/of-browser D1 (update M "asserts"
                                  conj {"step" 0 "beat" "ghost" "actor" "a"
                                        "kind" "value" "text" "OK" "ok" true}) EP)]
    (is (= :refuted (:verdict r)))
    (is (= :witnessed (:verdict (first (:steps r)))))
    (is (not (some (fn [c] (= :proven (:verdict c))) (:claims r))))
    (is (some (fn [c] (= :refuted (:verdict c))) (:claims r)))))

;; ── the declared positive-completion contract, refused case by case ──

(deftest absent-manifest-beat-cannot-witness
  (let [r (a/of-browser D1 (assoc M "beats" []) EP)]
    (is (no-witness? r))
    (is (= :refuted (:verdict (first (:steps r)))))))

(deftest pending-beat-cannot-witness
  (let [r (a/of-browser D1 (assoc M "beats"
                                  [{"id" "b1" "status" "pending" "completedSteps" [0 1 2]}]) EP)]
    (is (no-witness? r))
    (is (= :refuted (:verdict (first (:steps r)))))))

(deftest missing-completed-steps-cannot-witness
  (let [r (a/of-browser D1 (assoc M "beats" [{"id" "b1" "status" "complete"}]) EP)]
    (is (no-witness? r))
    (is (= :refuted (:verdict (first (:steps r)))))))

(deftest incomplete-completed-steps-cannot-witness
  (let [r (a/of-browser D1 (assoc M "beats"
                                  [{"id" "b1" "status" "complete" "completedSteps" [0 1]}]) EP)]
    (is (no-witness? r))))

(deftest wrong-op-cannot-witness
  (let [r (a/of-browser D1 (update M "steps"
                                  (fn [ss] [(first ss) (assoc (second ss) "op" "click") (nth ss 2)])) EP)]
    (is (no-witness? r))
    (is (= :refuted (:verdict r)))))

(deftest wrong-actor-cannot-witness
  (let [r (a/of-browser D1 (update M "steps"
                                  (fn [ss] [(first ss) (assoc (second ss) "actor" "b") (nth ss 2)])) EP)]
    (is (no-witness? r))
    (is (= :refuted (:verdict r)))))

(deftest missing-successful-selector-assertion-cannot-witness
  ;; the take is complete but records no row for the required selector assertion
  (let [r (a/of-browser D1-sel M EP)]
    (is (no-witness? r))
    (is (= :refuted (:verdict (first (:steps r)))))
    (is (some (fn [c] (and (= :refuted (:verdict c))
                           (some? (index-of (:msg c) "no successful row"))))
              (:claims r)))))

(deftest duplicated-step-index-cannot-witness
  (let [r (a/of-browser D1 (update M "steps"
                                  (fn [ss] [(first ss) (second ss) (second ss) (nth ss 2)])) EP)]
    (is (no-witness? r))
    (is (= :refuted (:verdict r)))))

(deftest duplicated-beat-id-cannot-witness
  (let [r (a/of-browser D1 (update M "beats"
                                  (fn [bs] [(first bs) (first bs)])) EP)]
    (is (no-witness? r))
    (is (= :refuted (:verdict r)))))

(deftest failed-duplicate-assertion-refutes
  ;; two rows for the one requirement, one successful and one failed: the
  ;; conflict cannot be resolved by taking the first match — it refutes.
  (let [r (a/of-browser D1 (update M "asserts"
                                  conj (assoc (first (get M "asserts")) "ok" false)) EP)]
    (is (= :refuted (:verdict r)))
    (is (no-witness? r))))

(deftest empty-executable-beat-cannot-witness
  (let [r (a/of-browser D-empty (assoc M "steps" [] "asserts" [] "screenshots" []) EP)]
    (is (no-witness? r))
    (is (= :refuted (:verdict (first (:steps r)))))))

;; ── an authored hole is skipped + partial, never a pass or a failure ─

(deftest authored-hole-is-skipped
  (let [r (a/of-browser D-hole M EP)]
    (is (not= :witnessed (:verdict r)))
    (is (not= :refuted (:verdict r)))          ; a hole is not a failed implementation
    (is (some (fn [s] (= :partial (:kind s))) (:stretches r)))
    (is (some (fn [t] (= :partial t)) (:tags r)))
    (let [hole (last (:steps r))]
      (is (= "hr" (:id hole)))
      (is (= :skipped (:verdict hole)))
      (is (= "skipped" (get-in hole [:trace :status])))))
  ;; the played beat is still witnessed; the run is not
  (is (= :witnessed (:verdict (first (:steps (a/of-browser D-hole M EP)))))))

(println)