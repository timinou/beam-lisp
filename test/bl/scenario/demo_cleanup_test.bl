; Public native scenario capture/disposal separation; synthetic world only.
(ns scenario.demo-cleanup-test
 (:require [scenario :as scenario] [scenario.demo :as demo]
  [clojure.edn :as edn]))
(Logger/configure (list (tuple :level :warning)))
(def private-value "PRIVATE-DEMO-WORLD-AND-ERROR-DATA-MUST-NOT-BE-SAVED")
(defn check [label value]
 (is value label))
(defn read-edn [out name]
 (let [path (str out "/" name ".edn")]
  (when (File/exists? path) (edn/read-string (File/read! path)))))
(defn world [disposed stepped broken-cleanup?]
 (let [frames (atom 0)
       private-handle {:db {:private private-value} :actors {:viewer private-value}
                       :requests [private-value] :credentials {:token private-value}}]
  {:kind :browser :credentials private-value
   :open (fn [_] private-handle)
   :step! (fn [_ event]
            (swap! stepped inc)
            (when (= :explode (get-in event [2 0]))
             (throw (ex-info "Primary synthetic capture failure"
                      {:code :synthetic-primary :private private-value :db private-handle})))
            :ok)
   :claim! (fn [handle _ claim context] (claim handle context))
   :observe (fn [handle _ lens] (lens handle)) :liveness (fn [_] nil)
   :close! (fn [handle] handle)
   ;; The ordinary world contract explicitly supplies safe bases and views.
   ;; Its raw final handle and error ex-data must never enter saved evidence.
   :views-fn (fn [_ _] {:visible "Public synthetic view"})
   :basis (fn [_] {:frame (str "synthetic-shot-" (swap! frames inc) ".png")
                   :predicate (fn [_] true)})
   :dispose! (fn []
               (swap! disposed inc)
               (when broken-cleanup?
                (throw (ex-info "Synthetic disposal failure"
                         {:code :synthetic-cleanup :private private-value :actor private-handle}))))}))
(defn story [passing?]
 (scenario/scenario "Original capture verdict" {:viewer {:private private-value}}
  [(demo/scene :claim {:say "A synthetic property is assessed."}
    (scenario/sees :viewer (fn [_ _] passing?) "Original authored property"))]))
(defn throwing-story []
 (scenario/scenario "Original capture exception" {:viewer {:private private-value}}
  [(scenario/does :viewer [:prime]) (scenario/does :viewer [:explode])]))
(defn invoke [opts scen]
 (try {:returned (demo/run! opts scen)}
  (catch error {:error error :message (ex-message error) :code (:code (ex-data error))})))
(defn exports-absent? [out]
 (every? (fn [name] (not (File/exists? (str out "/" name))))
  ["run.edn" "run.json" "suite.edn" "suite.json" "film.json"
   "film/manifest.json" "film/demo.mp4" "presentation.edn" "presentation.json"]))

(deftest capture-evidence-survives-independent-disposal-failure
(let [root (str ".local/demo-cleanup-" (Base/encode16 (crypto/strong_rand_bytes 8)))
      control-out (str root "/control") failed-out (str root "/refuted")
      passing-out (str root "/passing") thrown-out (str root "/thrown")
      control-disposed (atom 0) failed-disposed (atom 0) passing-disposed (atom 0) thrown-disposed (atom 0)
      control-stepped (atom 0) failed-stepped (atom 0) passing-stepped (atom 0) thrown-stepped (atom 0)
      control (invoke {:id "control" :output control-out :export? false
                       :world (world control-disposed control-stepped false)} (story false))
      failed (invoke {:id "refuted" :output failed-out :export? false
                      :world (world failed-disposed failed-stepped true)} (story false))
      passing (invoke {:id "passing" :output passing-out :export? true
                       :world (world passing-disposed passing-stepped true)} (story true))
      thrown (invoke {:id "thrown" :output thrown-out :export? true
                      :world (world thrown-disposed thrown-stepped true)} (throwing-story))
      capture (read-edn failed-out "capture") failed-capsule (read-edn failed-out "failure")
      passing-capture (read-edn passing-out "capture") passing-capsule (read-edn passing-out "failure")
      failure (read-edn thrown-out "failure")
      cleanup (mapv (fn [out] (read-edn out "cleanup")) [failed-out passing-out thrown-out])]
 ;; All three real public calls complete before the first desired assertion,
 ;; retaining independent returned-failure/pass/primary-throw observations on RED.
 (File/write! (str root "/observed.edn")
  (pr-str {:control-returned? (some? (:returned control))
           :failed-threw? (some? (:error failed)) :passing-threw? (some? (:error passing))
           :primary-error-preserved? (= :synthetic-primary (:code thrown))
           :dispose-counts [@control-disposed @failed-disposed @passing-disposed @thrown-disposed]
           :capture-present? (some? capture) :run-present? (some? (read-edn failed-out "run"))
           :independent-cleanup-receipt-count (count (filter some? cleanup))}))
 (println "Retained public demo cleanup regression" root)
 (check "Ordinary public demo capture retains its original failed claim and safe predicate marker when cleanup succeeds"
  (and (= false (get-in control [:returned :ok]))
       (= :refuted (get-in control [:returned :run :verdict]))
       (= :refuted (get-in control [:returned :run :claims 0 :verdict]))
       (= {:kind :function} (get-in control [:returned :run :steps 0 :trace :action 2]))))
 (check "Every public scenario invokes its real disposal exactly once including the original thrown capture"
  (and (= [1 1 1 1] [@control-disposed @failed-disposed @passing-disposed @thrown-disposed])
       (= 2 @thrown-stepped)))
 (check "Both returned primary captures still fail publicly when their independent cleanup throws"
  (and (= :synthetic-cleanup (:code failed)) (= :synthetic-cleanup (:code passing))))
 ;; Expected RED on old execute!: finally disposal throws before adapting or
 ;; writing the original returned scenario. Do not invent a substitute result.
 (check "A disposal exception preserves the original returned refuted capture and failed step as ordinary portable evidence"
  (and capture (= :refuted (:verdict capture))
       (= :refuted (get-in capture [:claims 0 :verdict])) (= 1 (get-in capture [:claims 0 :step]))
       (= :refuted (get-in capture [:steps 0 :verdict]))
       (= "Original authored property" (get-in capture [:claims 0 :msg]))
       (File/exists? (str failed-out "/capture.json"))))
 (check "Primary authored predicates remain inert markers and original claims and steps are not replaced by cleanup"
  (and (= {:kind :function} (get-in capture [:steps 0 :trace :action 2]))
       (= (dissoc (get-in control [:returned :run]) :id) (dissoc capture :id))))
 (check "All independent cleanup failures retain versioned safe receipts separately from capture evidence"
  (every? (fn [receipt]
   (and (= 1 (:schema-version receipt)) (= :cleanup (:phase receipt)) (= :failed (:status receipt))
        (= #{:schema-version :phase :status :message} (set (keys receipt)))
        (= "Demo resource disposal failed." (:message receipt)))) cleanup))
 (check "A separate cleanup failure capsule references the original capture without inventing lifecycle claims"
  (and (= :error (:status failed-capsule)) (= :cleanup (:phase failed-capsule))
       (= "Demo resource disposal failed." (:message failed-capsule))
       (= :refuted (:capture-verdict failed-capsule))
       (= {:edn "capture.edn" :json "capture.json"} (:capture failed-capsule))
       (= :failed (get-in failed-capsule [:cleanup :status]))
       (= (get-in control [:returned :run :stretches]) (:stretches capture))))
 (check "A witnessed primary capture keeps its original verdict separately and never becomes an accepted run after cleanup fails"
  (and (= :witnessed (:verdict passing-capture))
       (= :witnessed (get-in passing-capture [:claims 0 :verdict]))
       (= :witnessed (:capture-verdict passing-capsule))
       (= :cleanup (:phase passing-capsule)) (= :failed (get-in passing-capsule [:cleanup :status]))
       (nil? (read-edn passing-out "run"))))
 (check "Requested client export is refused for passing capture with failed disposal before film publication"
  (and (= :synthetic-cleanup (:code passing)) (exports-absent? passing-out)
       (not (File/exists? (str passing-out "/film.json")))))
 (check "An original capture exception remains the public primary error when disposal also throws"
  (and (= :synthetic-primary (:code thrown)) (= "Primary synthetic capture failure" (:message thrown))))
 (check "Thrown capture evidence preserves its original phase message and last media checkpoint with independent cleanup status"
  (and (= :error (:status failure)) (= :capture (:phase failure))
       (= "Primary synthetic capture failure" (:message failure))
       (= "synthetic-shot-1.png" (get-in failure [:last-basis :frame]))
       (= :failed (get-in failure [:cleanup :status]))
       (File/exists? (str thrown-out "/failure.json"))))
 (check "A thrown capture never fabricates a completed run or accepted client export"
  (and (nil? (read-edn thrown-out "capture")) (nil? (read-edn thrown-out "run"))
       (exports-absent? thrown-out)))
 (let [files (Path/wildcard (str root "/**/*.{edn,json}"))]
  (check "Portable evidence excludes raw world handles database actor request credential and exception ex-data"
   (and (seq files) (every? (fn [file] (not (includes? (File/read! file) private-value))) files))))
 (check "Every failed-disposal case has a separate JSON cleanup receipt and no accepted presentation"
  (every? (fn [out] (and (File/exists? (str out "/cleanup.json")) (exports-absent? out)))
   [failed-out passing-out thrown-out])))
)
