(ns scenario.film-test (:require [scenario.film :as film]))

(deftest a-presentation-retains-the-original-verdict-and-claims
  (let [run {:id "review" :title "Review" :verdict :unknown
             :claims [{:msg "Unobserved" :verdict :unknown}] :steps [{:i 1}]}
        value (film/from-run run [{:id "start" :source "frame.png" :say "Bonjour."}] {})]
    (is (= :unknown (get-in value [:run :verdict])))
    (is (= (:claims run) (get-in value [:run :claims])))
    (is (= "aura-2-hector-fr" (:voice value)))
    (is (= 1 (:version value)))))
