; test/bl/scenario/runner_patch_test.bl — the patch contract, proven.
;
; THE BUG (FUP-008): a live scrub updated STATE correctly but scrambled the
; DOM. Two independent causes, both about which ops the differ may safely
; emit to the live client:
;
;   1. The client applies ops IN WIRE ORDER; the server's reference apply-ops
;      does all STRUCTURAL ops first, then deep ops. A keyed list whose
;      reconcile MOVES a node therefore patches the pre-move node — wrong
;      target. (Upstream candidate; runner-side we simply never move.)
;   2. The client renders an inserted/replaced subtree with createElement —
;      no createElementNS — so an SVG node born in a patch paints BLANK (the
;      "empty filmstrip mini-frames").
;
; THE CONTRACT, as a property over the real screens:
;   a scrub forward (:at a → a+1) may emit
;     :set-attr :remove-attr :text :remove
;   and NEVER :insert / :replace / :move / :remove-at — attributes and text
;   morph in place; a keyed region may leave whole. frame/poster holds up its
;   half with a constant-arity SVG (fixed hud-line count, per-instance
;   gradient uids); run-screen keys its inspector regions so the witness
;   block's exit is a keyed remove, not a positional shuffle.
;   A scrub BACKWARD may re-insert an HTML region (safe — the hole is
;   SVG-only) but must never birth an SVG node.
;
; The round-trip property (apply-ops ∘ diff = identity, up to normalize) is
; the differ's own contract, pinned here per-op-set: a scrub reconstructs the
; new tree EXACTLY — the state correctness we observed live, now algebra.

(ns scenario.runner-patch-test
  (:require [scenario.runner.app :as rapp]
            [scenario.runner.nle :as nle]
            [scenario.plant :as plant]
            [live.app :as app]
            [live.diff :as diff]
            [live.hiccup :as lh]
            [loom.token :as t]))

;; the differ's round-trip contract is exercised per scrub below; op KIND
;; safety is asserted by `unsafe` (moves/positional) + `svg-born` (render hole)

;; tags an :insert/:replace subtree must never have — anything the browser
;; must build in the SVG namespace (client render() builds HTML nodes only)
(def ^:private svg-tags #{:svg :defs :linearGradient :radialGradient
                          :rect :circle :text :tspan :path :line :g})

(defn- seed! [] (rapp/set-suite! (plant/suite)))

(def ^:private av (rapp/app-value))

(defn- tree-at [run-id at]
  (app/dispatch nil nil {:app av :me "viewer"
                         :route (str "/run/" run-id) :at at}))

(defn- unsafe [ops]
  ;; a MOVE hits the client's apply-in-wire-order divergence (it patches the
  ;; pre-move node); a REMOVE-AT is the positional fallback we exist to avoid.
  (filter (fn [op] (contains? #{:move :remove-at} (first op))) ops))

(defn- svg-born [ops]
  (filter (fn [op]
            (and (contains? #{:insert :replace} (first op))
                 (let [sub (if (= :insert (first op)) (nth op 4) (nth op 2))]
                   (and (vector? sub) (contains? svg-tags (first sub))))))
          ops))

(deftest scrub-forward-is-morph-only
  (seed!)
  (doseq [r (:runs (rapp/suite))]
    (let [id (name (:id r))
          n  (count (:steps r))]
      (doseq [a (drop 1 (range n))]
        (let [old (tree-at id a)
              new (tree-at id (inc a))
              ops (diff/diff old new)]
          (is (empty? (concat (unsafe ops) (svg-born ops)))
              (str "scrub " id " " a "→" (inc a)
                   " emitted unsafe ops: "
                   (mapv first (concat (unsafe ops) (svg-born ops)))))
          (is (= (diff/normalize new) (diff/apply-ops ops old))
              (str "scrub " id " " a "→" (inc a) " must reconstruct exactly")))))))

(deftest scrub-backward-never-births-svg
  ;; the witness block APPEARS again on the way back to a refuted step: that
  ;; is an :insert of an HTML subtree — allowed. An SVG subtree is not.
  (seed!)
  (doseq [r (:runs (rapp/suite))]
    (let [id (name (:id r))
          n  (count (:steps r))]
      (doseq [a (drop 1 (range n))]
        (let [ops (diff/diff (tree-at id (inc a)) (tree-at id a))]
          (is (empty? (concat (svg-born ops) (unsafe ops)))
              (str "back-scrub " id (inc a) "→" a " births an SVG node or moves"))
          (is (= (diff/normalize (tree-at id a))
                 (diff/apply-ops ops (tree-at id (inc a))))))))))

(deftest html-region-inserts-are-keyed
  ;; the witness block's appearance/disappearance — the only child-list
  ;; membership change a scrub can cause — must be a KEYED insert/remove
  ;; (whole-region, stable identity), never a positional shuffle. Assert the
  ;; exact shape on rush-refuted, where the refuted step sits mid-run.
  (seed!)
  (let [ops (diff/diff (tree-at "rush-refuted" 2) (tree-at "rush-refuted" 3))
        witness-inserts (filter (fn [op]
                                  (and (= :insert (first op))
                                       (= "witness" (nth op 2))))
                                ops)]
    (is (= 1 (count witness-inserts)) "exactly one keyed insert, key = witness")
    (is (= 2 (nth (first witness-inserts) 3)) "inserted at its keyed slot (after claims)")))

(deftest gradient-ids-are-per-instance
  ;; the monitor and clip-5 used to BOTH own `bg-5`: url(#…) resolved to the
  ;; first in document order, and a patched svg kept another poster's gradient.
  (seed!)
  (let [html (lh/hiccup->html (tree-at "cascade" 5))]
    (is (String/contains? html "fbg-mon")  "monitor poster carries its uid")
    (is (String/contains? html "fbg-clip1") "clip posters carry their own uid")
    (is (not (String/contains? html "url(#bg-5)")) "scene-numbered ids are gone")))

;; ════════════════════════════════════════════════════════════════════
;; WARM PARITY — the stylesheet the server ships must name every class a
;; request emits, even when a prior render left a foreign theme in the process.
;; ════════════════════════════════════════════════════════════════════
;;
;; THE BUG (this fix): a loom class name is `phash2` of its RESOLVED css, and
;; token resolution reads the theme from the PROCESS dict. The runner declared
;; no :theme, so its chrome hashed against whatever theme happened to be
;; installed. `warm-style` runs at boot in a process the host's `film` first
;; tainted with printflow's brand (cream palette, 9px radius), while every HTTP
;; request renders in a fresh Bandit process on loom's dark defaults. The two
;; disagreed: warm captured 9px-radius class names, the request emitted
;; 8px-radius ones, and ~25 NLE-chrome classes shipped RULELESS — grey UA
;; buttons, invisible dark-on-cream title. The app declaring its own :theme
;; pins BOTH renders to the same tokens, so the class names match.
;;
;; The guard reproduces the taint: install a foreign brand into THIS process
;; (what film does), warm the sheet exactly as live.app/serve does — reset,
;; apply the app :theme, render every :warm path — then assert the run body's
;; classes are all named in it. Without :theme this fails; with it, it holds.

(def ^:private foreign-brand
  ;; a stand-in for printflow.brand: a different radius scale is enough to move
  ;; every class hash on the chrome (deck buttons, clips, panels use t/radius).
  {:radius {:none "0" :sm "5px" :md "9px" :lg "15px" :xl "24px" :full "9999px"}
   :color {:bg "#f6f5f1" :text "#221f1a"}})

(defn- warm-sheet-css
  "Reproduce live.app/serve's warm exactly: reset the per-process sheet, apply
   the app's :theme thunk, render every warm path so their classes register,
   then collect the sheet. Returns the full <style> text. Rebuilds the app
   value AFTER seeding so :warm reflects the seeded suite (the load-time `av`
   baked an empty warm list — the suite is seeded per-test, not at load)."
  []
  (let [av2 (rapp/app-value)]
    (t/reset-sheet!)
    (when-let [th (get av2 :theme)] (th))
    (doseq [p (get av2 :warm)]
      (lh/hiccup->html (app/dispatch nil nil {:app av2 :me "viewer" :route p})))
    (lh/hiccup->html (t/style-tag))))

(defn- body-classes
  "Every s-prefixed class token the OUTER chrome emits for a route, rendered as
   a REAL HTTP request does. A request lands in a fresh Bandit process (loom
   defaults in the dict, no boot taint), then live.app applies the app :theme.
   We simulate that fresh process by resetting the theme to loom defaults
   before dispatch — so warm (tainted boot process) and request (clean process)
   only agree when the app pins both via :theme. The iframe srcdoc (the host
   app's own classes + <style>) is excluded: we test the runner's chrome
   against the runner's warmed sheet."
  [route]
  (let [av2 (rapp/app-value)]
    (t/install-theme! {})                              ; fresh Bandit process: loom defaults
    (when-let [th (get av2 :theme)] (th))              ; then live.app applies the app theme
    (let [html (lh/hiccup->html (app/dispatch nil nil {:app av2 :me "viewer" :route route}))
          outer (first (String/split html "srcdoc="))  ; chrome precedes the first iframe
          segs (rest (String/split outer "class=\""))]
      (distinct
        (mapcat (fn [seg]
                  (let [v (first (String/split seg "\""))]
                    (filter (fn [c] (and (> (count c) 0) (String/starts_with? c "s")))
                            (String/split v " "))))
                segs)))))

(deftest warm-sheet-names-every-chrome-class
  ;; TAINT the process first — exactly what boot's `set-suite!`→`film` does when
  ;; it SSRs the host's themed screens before `serve` warms. The runner's own
  ;; :theme must override this so warm and request still agree.
  (seed!)
  (t/install-theme! foreign-brand)
  (let [sheet (warm-sheet-css)]
    (doseq [r (:runs (rapp/suite))]
      (let [route (str "/run/" (name (:id r)))
            classes (body-classes route)
            missing (filter (fn [c] (not (String/contains? sheet (str "." c "{")))) classes)]
        (is (empty? missing)
            (str route ": " (count missing) " chrome class(es) shipped ruleless "
                 "(warm/request theme mismatch) — " (pr-str (take 8 missing))))))))

(deftest runner-canvas-is-loom-dark
  ;; the NLE chrome is authored for loom's dark defaults; a leaked host brand
  ;; (light canvas) makes the dark-on-dark text invisible. The warmed base-css
  ;; must carry the dark bg regardless of a foreign theme in the process.
  (seed!)
  (t/install-theme! foreign-brand)
  (let [sheet (warm-sheet-css)]
    (is (String/contains? sheet "background:#0b0c0e")
        "page canvas is loom-dark #0b0c0e, not a leaked host palette")))

