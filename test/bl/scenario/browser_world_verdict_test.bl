(ns scenario.browser-world-verdict-test (:require [scenario :as s]))

(defn- replay [kind held?]
  (s/run-world
    (s/scenario "world evidence strength" {:reader {}}
      [(s/sees :reader (fn [_ _] held?) "observable claim")])
    {:kind kind :open (fn [_] {}) :step! (fn [_ _] :ok)
     :claim! (fn [_ _ claim ctx] (claim nil ctx))
     :observe (fn [_ _ lens] (lens nil)) :liveness (fn [_] nil)
     :close! (fn [_] nil)}))

(deftest live-browser-claims-are-witnessed
  (let [r (replay :browser true)]
    (is (:ok r))
    (is (= :witnessed (:verdict (first (:trace r)))))
    (is (= :witnessed (:verdict (first (:verdicts r)))))))

(deftest model-claims-stay-proven-and-false-claims-refuted
  (is (= :proven (:verdict (first (:verdicts (replay :model true))))))
  (let [r (replay :browser false)]
    (is (= false (:ok r)))
    (is (= :refuted (:verdict (first (:verdicts r)))))))
