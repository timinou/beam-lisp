; test/bl/scenario/scenario_test.bl — multi-actor convergence, proven.
;
; The exact stakeholder scenario the owner described: the commercial promises a
; date, the operator logs a paper incident, and the commercial SEES the date
; move — through the shared datom log, with no one coordinating. This is the
; whole product thesis, as a decidable model trace.
;
; Run: bl test test/bl/scenario/scenario_test.bl

(ns scenario.scenario-test
  (:require [scenario :as s]
            [scenario.plant :as plant]
            [datom :as datom] [datom.time :as time]))

;; ── the shared plant store (all four actors act on THIS) ────────────
(def conn (datom/connect plant/plant-schema))
;; seed: a job with a planned assignment (Thursday 10:00), and a press
(datom/transact! conn
  [{:db/id -1 :job/id "j-1" :job/status :planned}
   {:db/id -2 :resource/id "cd102" :resource/kind :machine :resource/status :up}])
(def seed
  (datom/transact! conn
    [{:db/id -3 :assign/id "a-1" :assign/status :pending
      :assign/span (time/interval :year 2026 :month 9 :day 3 :hour 10)}]))
(def A (get (:tempids seed) -3))   ; the assignment eid — lookup-refs don't resolve in entity   ; Thursday 10:00

;; ── the domain perform fn: how each action becomes datoms/queries ───
(defn perform [conn actor action]
  (let [kind (first action)]
    (cond
      ;; the commercial reads the promised date
      (= kind :read-date)
        (let [db (datom/db conn)
              span (:assign/span (datom/entity db A))]
          {:date span})
      ;; the operator logs a paper incident → blocks the step, reschedules later
      (= kind :log-incident)
        (let [assign-eid A]
          (datom/transact! conn
            [{:db/id -10 :incident/id "inc-1" :incident/scope :artifact
              :incident/kind :paper-jam :incident/at assign-eid :incident/resolved false}
             ;; the step is blocked AND the plan moves to Friday 14:00
             [:db/add assign-eid :assign/status :blocked]
             [:db/add assign-eid :assign/span (time/interval :year 2026 :month 9 :day 4 :hour 14)]])
          {:logged true})
      ;; an embedded assertion over the current shared db
      (= kind :expect)
        (if ((second action) (datom/db conn)) :ok :fail)
      :else :ok)))

;; ── each actor's projection (a pure view of the shared db) ──────────
(defn project [db actor]
  (let [a (datom/entity db A)]
    {:role actor
     :promised-date (:assign/span a)
     :status (:assign/status a)}))

;; ── the scenario VALUE: four actors, an interleaved history ─────────
(def rush-incident
  (s/scenario "rush incident"
    {:amina {:role :commerciale} :rachid {:role :chef-atelier}
     :karim {:role :prepresse} :op12 {:role {:kiosk :cd102}}}
    [[:amina (s/act :read-date)]
     ;; before the incident, the promise is Thursday
     [:amina (s/expect (fn [db] (time/overlaps? (:assign/span (datom/entity db A))
                                                (time/interval :year 2026 :month 9 :day 3 :hour 10)))
                       "promise is Thursday 10:00")]
     ;; the operator logs a paper incident on the floor
     [:op12  (s/act :log-incident)]
     ;; ...and WITHOUT anyone telling her, the commercial's view now shows Friday
     [:amina (s/expect (fn [db] (time/overlaps? (:assign/span (datom/entity db A))
                                                (time/interval :year 2026 :month 9 :day 4 :hour 14)))
                       "promise moved to Friday 14:00 — converged through the log")]
     [:amina (s/expect (fn [db] (= :blocked (:assign/status (datom/entity db A))))
                       "the step reads :blocked everywhere")]]))

(println "== the multi-actor scenario runs as a model trace ==")
(def result (s/run rush-incident conn perform project))

(deftest scenario-runs
  (is (= true (:ok result)))
  ;; every embedded assertion held as the concurrent history unfolded
  (is (= true (s/all-expects-passed? result))))

(println "== CONVERGENCE: the commercial saw the operator's incident, no message ==")
(deftest convergence
  ;; amina's FINAL projection reflects a fact op12 wrote — the two-tabs property
  (is (= true (s/converged? result :amina
                (fn [v] (and (= :blocked (:status v))
                             (time/overlaps? (:promised-date v)
                               (time/interval :year 2026 :month 9 :day 4 :hour 14)))))))
  ;; and EVERY actor converges on the same truth (one shared log)
  (doseq [actor [:amina :rachid :karim :op12]]
    (is (= :blocked (:status (get (:views result) actor)))))
  (println "   → all four actors see :blocked, Friday 14:00 — through the log alone"))

(println "== the trace is an inspectable history ==")
(deftest trace-inspectable
  (is (= 5 (count (:trace result))))
  (println "   → history:")
  (doseq [t (:trace result)]
    (println "     " (:step t) (:actor t) "→" (pr-str (first (:action t))) ":" (pr-str (:outcome t)))))

(println)
