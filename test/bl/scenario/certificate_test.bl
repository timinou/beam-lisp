; test/bl/scenario/certificate_test.bl — refuted-with-witness, proven.
;
; The certificate is the film before the film. This file proves the two
; properties that make it more than a pretty page:
;
;   1. BISECT IS TRUE TIME TRAVEL — (s/bisect result n) returns the world as
;      it EXACTLY was after step n. The same conn, two steps apart, answers
;      differently: the promise is Thursday at step 1 and Friday at step 2.
;      (datom is bitemporal; a basis is a value, not a copy.)
;   2. A REFUTED CLAIM CARRIES ITS WITNESS — the lie ("the promise is
;      Thursday") is stored WITH the basis that falsifies it. The certificate
;      renders that witness. No message reading "expected X got Y": a
;      falsifiable refutation.
;
; Run: bl test test/bl/scenario/certificate_test.bl

(ns scenario.certificate-test
  (:require [scenario :as s] [scenario.certificate :as cert]
            [scenario.plant :as plant]
            
            [datom :as datom] [datom.time :as time]))

;; ── the plant ───────────────────────────────────────────────────────
(def conn (datom/connect plant/plant-schema))
(datom/transact! conn
  [{:db/id -1 :job/id "j-1" :job/status :planned}
   {:db/id -2 :resource/id "cd102" :resource/kind :machine :resource/status :up}])
(def r (datom/transact! conn
  [{:db/id -3 :assign/id "a-1" :assign/status :pending
    :assign/span (time/interval :year 2026 :month 9 :day 3 :hour 10)}]))
(def A (get (:tempids r) -3))   ; the ASSIGNMENT whose span is the promise

(defn perform [conn actor action]
  (if (= :log-incident (first action))
    (do (datom/transact! conn
          [{:db/id -10 :incident/id "inc-1" :incident/scope :artifact
            :incident/kind :paper-jam :incident/at A :incident/resolved false}
           [:db/add A :assign/status :blocked]
           [:db/add A :assign/span (time/interval :year 2026 :month 9 :day 4 :hour 14)]])
      {:logged true})
    :ok))

(def promise-lens (fn [db] (:assign/span (datom/entity db A))))
(def thu (time/interval :year 2026 :month 9 :day 3 :hour 10))
(def fri (time/interval :year 2026 :month 9 :day 4 :hour 14))

(def world (s/model-world conn perform
  (fn [db actor] {:actor actor
                  :status (:assign/status (datom/entity db A))
                  :promised-date (:assign/span (datom/entity db A))})))

;; ── the lie: act first, THEN claim Thursday ─────────────────────────
(def liar
  (s/scenario "the promise is Thursday — a lie after the incident"
    {:amina {:role :commerciale} :op12 {:role {:kiosk :cd102}}}
    [(s/sees :amina (fn [db ctx] (time/overlaps? (promise-lens db) thu))
            "the promise is Thursday")
     (s/does :op12 (s/act :log-incident))
     (s/sees :amina (fn [db ctx] (time/overlaps? (promise-lens db) thu))
             "the promise is Thursday — a LIE after the incident")]))
(def liar-result (s/run-world liar world))

(println "== refuted-with-witness ==")
(println "   ok:" (:ok liar-result)
        " refuted:" (count (s/refuted liar-result)))

(deftest refuted-claims-carry-witness
  (is (= false (:ok liar-result)))
  (is (= 1 (count (s/refuted liar-result))))
  ;; the refuted verdict carries the basis where the claim was false
  (is (not (nil? (:evidence (first (s/refuted liar-result)))))))

;; ── bisect is TRUE time travel ──────────────────────────────────────
;; step 1: after the incident act — the promise ALREADY moved to Friday
;; step 2: the lie, evaluated against a world that says Friday
(deftest bisect-time-travel
  (let [before (s/bisect liar-result 1)
        at-lie (s/bisect liar-result 3)]
    ;; at the lie's basis, amina's view contradicts the claim — the witness
    (is (= true (time/overlaps? (get-in at-lie [:views :amina :promised-date]) fri)))
    (is (= :blocked (get-in at-lie [:views :amina :status])))
    ;; one step earlier, the same view still reads Thursday — the past is intact
    (is (= true (time/overlaps? (get-in before [:views :amina :promised-date]) thu)))
    (println "   → bisect step 1 (promise):" (pr-str (get-in before [:views :amina :promised-date])))
    (println "   → bisect step 3 (promise):" (pr-str (get-in at-lie [:views :amina :promised-date])))
    (println "   → the lie said Thursday; the basis at step 3 says otherwise")))

;; ── the certificate renders the run ─────────────────────────────────
(def html (cert/render liar-result))

(deftest certificate-renders
  (is (= true (String/contains? html "refuted")))
  ;; the witness is IN the artifact: the actor's view at the false basis
  (is (= true (String/contains? html ":blocked")))
  ;; the claim's own text is in the artifact
  (is (= true (String/contains? html "the promise is Thursday")))
  ;; every history step is present
  (is (= true (String/contains? html "history"))))

;; determinism: same run, same bytes (no timestamps, no JS, no network)
(deftest certificate-is-deterministic
  (is (= html (cert/render liar-result))))

;; write! round-trips
(deftest write-round-trips
  (let [p "/tmp/scenario-certificate-test.html"]
    (cert/write! p liar-result)
    (is (= html (File/read! p)))))

(println)
