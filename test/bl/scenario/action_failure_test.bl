(ns scenario.action-failure-test
  (:require [datom] [scenario :as s] [scenario.runner.adapt :as a]))

(defn- result-for [outcome expected? noop-ok?]
  (let [conn (datom/connect [])
        event (if expected?
                (s/refused :actor (s/act :save {}) "expected refusal" noop-ok?)
                [:actor (s/act :save {})])
        scen (s/scenario "action outcome" {:actor {:role :tester}}
                [event (s/sees :actor (fn [_ _] true) "an unrelated claim holds")])
        result (s/run-world scen (s/model-world conn (fn [_ _ _] outcome) (fn [_ _] {})))]
    (datom/close! conn)
    result))

(deftest an-unexpected-refusal-never-rolls-up-green
  (doseq [outcome [{:denied "not allowed"} {:refused "invalid"} {:ok false :noop true}]]
    (let [r (result-for outcome false false)
          run (a/of-scenario r)]
      (is (= false (:ok r)))
      (is (= :refuted (:verdict (first (:trace r)))))
      (is (= :refuted (:verdict run)))
      (is (some (fn [st] (= :execution (:kind st))) (:stretches run))))))

(deftest a-refusal-is-success-only-when-the-story-expects-it
  (is (= true (:ok (result-for {:denied "expected"} true false))))
  (is (= :proven (:verdict (a/of-scenario (result-for {:denied "expected"} true false)))))
  (is (= false (:ok (result-for {:ok false :noop true} true false))))
  (is (= true (:ok (result-for {:ok false :noop true} true true))))
  (is (= true (:ok (result-for {:ok true} false false)))))
