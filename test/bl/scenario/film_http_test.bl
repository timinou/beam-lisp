(ns scenario.film-http-test (:require [scenario.film.http :as http]))
(deftest media-ranges-are-bounded-and-support-browser-seeking
 (is (= {:status 200 :offset 0 :length 100} (http/byte-range nil 100)))
 (is (= {:status 206 :offset 10 :length 10} (http/byte-range "bytes=10-19" 100)))
 (is (= {:status 206 :offset 90 :length 10} (http/byte-range "bytes=90-" 100)))
 (is (= {:status 206 :offset 95 :length 5} (http/byte-range "bytes=-5" 100)))
 (is (= {:status 206 :offset 0 :length 100} (http/byte-range "bytes=-1000" 100)))
 (is (= {:status 206 :offset 99 :length 1} (http/byte-range "bytes=99-1000" 100)))
 (doseq [header ["bytes=100-" "bytes=20-10" "bytes=-0" "bytes=-" "bytes=0-1,5-6"
                 "bytes=+1-2" "items=0-5" "bytes=9999999999999999999999999-"]]
  (is (= 416 (:status (http/byte-range header 100)))))
 (is (= 416 (:status (http/byte-range "bytes=0-" 0)))))
