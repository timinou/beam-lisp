; wave28_prims_test.bl — the prims Specter's engine needs, and the `name`
; namespace-drop bug, ported from ExUnit test/beam_lisp/wave28_prims_test.exs.
;
; `name` used to keep the namespace, so `(name :a/b)` answered "a/b" where
; Clojure answers "b"; every caller building a string quietly got a qualified
; one. `name`, `namespace` and `keyword` are tested TOGETHER because their
; contract is a ROUNDTRIP — `(keyword (namespace k) (name k))` must be `k` —
; not three independent behaviours. `satisfies?` is pinned against the call it
; guards (a predicate that disagrees with dispatch is worse than none), and
; `extend-protocol`'s primitive KEYWORD tags are the shape Specter's engine
; actually extends to.
;
; PARITY MAPPING. One `deftest` per ExUnit `test`, same order, one `is` per
; `assert` (the `refute` in the atom-guard scan becomes `(is (not …))`; the
; `assert_raise` blocks become `raised` + a typed struct check):
;
;   describe "name"
;     drops the namespace, as Clojure does                 3 `is`
;     passes a string through                              2 `is`
;     the / var is a name, not a qualification             2 `is`
;   describe "namespace"
;     returns the qualifier or nil                         4 `is`
;     nil rather than empty string is the contract         1 `is`
;   describe "keyword"
;     builds from a name and from a namespace plus a name  2 `is`
;     is equal to the literal it names                     2 `is`
;     is idempotent on a keyword                           2 `is`
;     accepts a symbol                                     2 `is`
;     roundtrips with name and namespace                   1 `is`
;     goes through the atom guard, not String.to_atom      2 `is`
;   describe "satisfies?"
;     is true exactly when the call dispatches             4 `is`
;     is false for an unknown protocol rather than raising 1 `is`
;     a partial extension cannot exist to be satisfied     3 `is`
;     works for records, deftypes and reify values         3 `is`
;     resolves a protocol referred in from another ns      1 `is`
;   describe "extend-protocol reaches primitive type tags"
;     a keyword tag dispatches for a primitive value       1 `is`
;     and satisfies? agrees with it                        1 `is`
;                                                         33 `is`
;
; ADAPTATIONS.
;   * The ExUnit module `setup` (`{:ok, e: new_env("w28prims")}`) becomes a
;     fresh env at the top of each `deftest`; the `satisfies?` describe's extra
;     `setup` (Shape on :integer) becomes `shape-env`.
;   * Every body runs bound at the `:global` env (`deftest-global`) — the binding
;     an ExUnit test process implicitly had. `Loader.Server` resolves a
;     `:require` in its OWN process, so a namespace declared in ward's private
;     per-file fork would be invisible to it.
;   * The atom-guard scan reads `priv/boot/core.bl` off `(BeamLisp/cwd)` (the
;     ExUnit path was cwd-relative) and uses the same literal split/slice. The
;     regex-free `includes?` checks are exact for these needles.
;
; Run: bin/bl test test/bl/wave28_prims_test.bl

(ns wave28.prims.test)

(defmacro deftest-global
  "A `deftest` whose body runs bound at the `:global` env — the binding an ExUnit
   test process implicitly had. Ward runs a file in a private env fork, but
   `Loader.Server` resolves a `:require` in its OWN process, so a namespace
   declared in the fork is invisible to it; `:global` is the one env both share."
  [name & body]
  `(deftest ~name (BeamLisp.Env/with_env :global (fn [] ~@body))))

(defn- prims-env
  "The ExUnit module `setup`: a fresh `w28prims` compile env."
  []
  (BeamLisp.Compiler/new_env "w28prims"))

(defn- ev
  "The ExUnit `ev/2`: `BeamLisp.Compiler.eval_string(src, e)`."
  [src e]
  (BeamLisp.Compiler/eval_string src e))

(defn- raised
  "The exception `thunk` raised, or nil when it returned normally — the value
   `assert_raise` inspected."
  [thunk]
  (try (do (thunk) nil) (catch e e)))

; ══ describe "name" ═════════════════════════════════════════════════════════

(deftest-global name-drops-the-namespace-as-clojure-does
  (let [e (prims-env)]
    (is (= "a" (ev "(name :a)" e)))
    (is (= "b" (ev "(name :a/b)" e)))
    (is (= "y" (ev "(name 'x/y)" e)))
    (is (= "plain" (ev "(name 'plain)" e)))))

(deftest-global name-passes-a-string-through
  (let [e (prims-env)]
    (is (= "s" (ev "(name \"s\")" e)))
    (is (= "b" (ev "(name \"a/b\")" e)))))

(deftest-global the-slash-var-is-a-name-not-a-qualification
  ; `/` is division's name. Splitting on the first slash would make it an empty
  ; name in an empty namespace, which is why the split rule requires a non-empty
  ; left half rather than merely a slash.
  (let [e (prims-env)]
    (is (= "/" (ev "(name '/)" e)))
    (is (nil? (ev "(namespace '/)" e)))))

; ══ describe "namespace" ═══════════════════════════════════════════════════

(deftest-global namespace-returns-the-qualifier-or-nil
  (let [e (prims-env)]
    (is (= "a" (ev "(namespace :a/b)" e)))
    (is (nil? (ev "(namespace :a)" e)))
    (is (= "x" (ev "(namespace 'x/y)" e)))
    (is (nil? (ev "(namespace 'x)" e)))))

(deftest-global nil-rather-than-empty-string-is-the-contract
  ; Callers branch on it; "" is truthy and would silently take the qualified
  ; path.
  (let [e (prims-env)]
    (is (= :bare (ev "(if (namespace :a) :qualified :bare)" e)))))

; ══ describe "keyword" ═════════════════════════════════════════════════════

(deftest-global keyword-builds-from-a-name-and-from-a-namespace-plus-a-name
  (let [e (prims-env)]
    (is (= :a (ev "(keyword \"a\")" e)))
    (is (= :ns/n (ev "(keyword \"ns\" \"n\")" e)))))

(deftest-global keyword-is-equal-to-the-literal-it-names
  (let [e (prims-env)]
    (is (= true (ev "(= (keyword \"a\") :a)" e)))
    (is (= true (ev "(= (keyword \"a\" \"b\") :a/b)" e)))))

(deftest-global keyword-is-idempotent-on-a-keyword
  (let [e (prims-env)]
    (is (= :a (ev "(keyword (keyword \"a\"))" e)))
    (is (= :a/b (ev "(keyword :a/b)" e)))))

(deftest-global keyword-accepts-a-symbol
  (let [e (prims-env)]
    (is (= :foo (ev "(keyword 'foo)" e)))
    ; a qualified symbol keeps its qualification through the roundtrip
    (is (= :x/y (ev "(keyword 'x/y)" e)))))

(deftest-global keyword-roundtrips-with-name-and-namespace
  ; The contract that makes the three functions one feature.
  (let [e (prims-env)]
    (is (= true (ev "(let [k :a/b] (= k (keyword (namespace k) (name k))))" e)))))

(deftest-global keyword-goes-through-the-atom-guard-not-string-to-atom
  ; A keyword built at RUNTIME comes from data, and data can be unbounded where
  ; source text is not: a loop interning one atom per input row is exactly how
  ; the atom table fills, and a full table aborts the VM uncatchably rather than
  ; raising. Asserted by construction rather than by exhausting the table: the
  ; prim must route through BeamLisp.AtomGuard, so a source scan is the honest
  ; check that no bare intern crept back in.
  (let [src (File/read! (Path/join (BeamLisp/cwd) "priv/boot/core.bl"))
        keyword_def (nth (String/split src "(defn keyword") 1)
        body (String/slice keyword_def 0 400)]
    (is (not (includes? body "binary_to_atom"))
        "keyword/1,2 must not intern directly — route through the atom guard")
    (is (includes? body "cpp/jank.runtime.keyword"))))

; ══ describe "satisfies?" ══════════════════════════════════════════════════

(defn- shape-env
  "The `satisfies?` describe's extra ExUnit `setup`: `w28prims` with a `Shape`
   protocol extended to `:integer`."
  []
  (let [e (prims-env)]
    (ev "(ns w28prims)
         (defprotocol Shape (area [x]) (perim [x]))
         (extend-type :integer Shape (area [x] (* x x)) (perim [x] (* 4 x)))"
        e)
    e))

(deftest-global satisfies-is-true-exactly-when-the-call-dispatches
  ; The whole point of the predicate: it must not disagree with the call it
  ; guards. Wave 27 retired `map?`-on-records for exactly this failure mode.
  (let [e (shape-env)]
    (is (= true (ev "(satisfies? Shape 3)" e)))
    (is (= 9 (ev "(area 3)" e)))
    (is (= false (ev "(satisfies? Shape \"s\")" e)))
    (let [err (raised (fn [] (ev "(area \"s\")" e)))]
      (is (= :Elixir.RuntimeError (:__struct__ err)))
      (is (includes? (ex-message err) "No implementation of method")))))

(deftest-global satisfies-is-false-for-an-unknown-protocol-rather-than-raising
  ; A predicate that raises is not a predicate.
  (let [e (shape-env)]
    (is (= false (ev "(satisfies? NoSuchProtocol 3)" e)))))

(deftest-global a-partial-extension-cannot-exist-to-be-satisfied
  ; satisfies? demands every method. Probing whether it does revealed that the
  ; question is unreachable through the public API: extend_type REFUSES an
  ; incomplete extension outright, naming the missing methods. That is the
  ; stronger guarantee — the invalid state is unrepresentable rather than merely
  ; unsatisfying — so the test pins the refusal instead of the predicate.
  (BeamLisp.Multi/define_protocol "w28prims" "Partial" ["one" "two"])
  (let [err (raised
              (fn []
                (BeamLisp.Multi/extend_type "w28prims" "Partial" :float
                                            {"one" (fn [_] :ok)})))]
    (is (includes? (ex-message err) "missing methods: [\"two\"]"))
    (is (not (BeamLisp.Multi/satisfies? "w28prims" "Partial" 1.5))))
  ; and a complete one satisfies
  (BeamLisp.Multi/extend_type "w28prims" "Partial" :float
                              {"one" (fn [_] :ok) "two" (fn [_] :ok)})
  (is (BeamLisp.Multi/satisfies? "w28prims" "Partial" 1.5)))

(deftest-global satisfies-works-for-records-deftypes-and-reify-values
  ; The navigator values Specter builds are reify values, so this is the case
  ; the engine actually depends on.
  (let [e (prims-env)]
    (ev "(ns w28prims)
         (defprotocol Nav (go [x]))
         (defrecord Rec [a])
         (extend-type Rec Nav (go [x] :rec))"
        e)
    (is (= true (ev "(satisfies? Nav (->Rec 1))" e)))
    (is (= false (ev "(satisfies? Nav 1)" e)))
    ; a reify satisfies the protocol it reifies, and its identity is
    ; per-evaluation — two reifys are separately registered
    (is (= true (ev "(satisfies? Nav (reify Nav (go [x] :r)))" e)))))

(deftest-global satisfies-resolves-a-protocol-referred-in-from-another-namespace
  ; Same resolution path extend-type uses; a bare name may belong to somebody
  ; else.
  (let [e (prims-env)]
    (ev "(ns w28prims.p)
         (defprotocol Far (f [x]))
         (extend-type :integer Far (f [x] :yes))"
        e)
    (is (= true
           (ev "(ns w28prims.q (:require [w28prims.p :refer :all])) (satisfies? Far 1)" e)))))

; ══ describe "extend-protocol reaches primitive type tags" ═════════════════

(deftest-global a-keyword-tag-dispatches-for-a-primitive-value
  ; Specter's :cljs branch extends its protocols to number/string rather than
  ; to JVM classes, so primitive tags are the shape the engine actually needs.
  (let [e (prims-env)]
    (is (= [:int :str :vec]
           (ev "(ns w28prims)
                (defprotocol Desc (desc [x]))
                (extend-protocol Desc
                  :integer (desc [x] :int)
                  :binary (desc [x] :str)
                  :vector (desc [x] :vec))
                [(desc 1) (desc \"a\") (desc [1 2])]"
               e)))))

(deftest-global satisfies-agrees-with-extend-protocol-on-primitive-tags
  (let [e (prims-env)]
    (ev "(ns w28prims)
         (defprotocol D2 (d2 [x]))
         (extend-protocol D2 :integer (d2 [x] :int))"
        e)
    (is (= [true false] (ev "[(satisfies? D2 1) (satisfies? D2 :kw)]" e)))))
