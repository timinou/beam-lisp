; executor/ssh_bl_test.bl — end-to-end for the MAXIMALIST bl SSH executor
; (priv/std/executor/ssh.bl): the whole daemon is beam-lisp.
;
; A real `ssh` client (openssh CLI) authenticates by a store-enrolled public
; key and drives the capped `bl>` REPL. Three properties, each a positive and a
; negative:
;   granted cap runs            String/upcase reaches the REPL and answers
;   ungranted cap denied        File/read is refused at COMPILE time
;   non-enrolled key refused    auth fails before the REPL is reachable
;   revoked principal refused   enrol-then-revoke closes the same door
;
; Uses the openssh CLI (not OTP's ssh client) because it reliably offers an
; explicit `-i` identity with IdentitiesOnly, and its stdin is piped with no
; PTY so IO.gets sees clean newline-framed lines.
;
; Every daemon this file starts, it stops — in the test's own `finally` — so a
; focused run leaves no listener behind.

(ns executor.ssh.bl.test
  (:require [executor.ssh :as ex] [executor.store :as st] [auth]))

(def ^:private POLICY
  {:mem-per-session 2000000 :mem-per-user 8000000
   :disk-per-session 0 :disk-per-user 0})

(defn- opt [k v] (erlang/list_to_tuple (list k v)))

(defn- ensure-ssh! []
  (erlang/apply :application :ensure_all_started (list :ssh)))

;; ── fixtures ─────────────────────────────────────────────────────────

(defn- mk-tmp
  "A fresh, empty scratch dir under the system tmp dir."
  [prefix]
  (let [dir (str (System/tmp_dir!) "/" prefix "_" (erlang/unique_integer (list :positive)))]
    (File/rm_rf! dir)
    (File/mkdir_p! dir)
    dir))

(defn- keygen! [args]
  (let [r (System/cmd "ssh-keygen" (to-list args))]
    (erlang/element 2 r)))

(defn- client-key
  "A fresh ed25519 client identity: its scratch dir and its public line."
  []
  (let [dir (mk-tmp "blssh_c")]
    (keygen! (list "-t" "ed25519" "-f" (str dir "/id") "-N" "" "-q"))
    {:dir dir :line (String/trim (File/read! (str dir "/id.pub")))}))

(defn- host-dir
  "A host-key dir holding an ssh_host_rsa_key, as sshd requires."
  []
  (let [dir (mk-tmp "blssh_h")]
    (keygen! (list "-t" "rsa" "-b" "2048"
                   "-f" (str dir "/ssh_host_rsa_key") "-N" "" "-q"))
    dir))

(defn- serve
  "Start the warm VM against `store`/`root`. Returns {:ref :port} — the ref
   is the test's to close."
  [root conn host]
  (let [ref (erlang/element 2 (ex/serve {:port 0 :system-dir host :store conn
                                         :root-pub (auth/public root)
                                         :policy POLICY}))]
    {:ref ref :port (ex/port ref)}))

(defn- new-stack
  "A trusted root + store with alice enrolled under `line`."
  [line]
  (let [root (auth/keypair)
        conn (st/open)]
    (st/enroll! conn "alice" line
      (auth/encode-base64
        (auth/issue root [["user" "alice"] ["right" "Elixir.String" "call"]])))
    {:root root :conn conn}))

;; ── the client: pipe a script through a real ssh ─────────────────────

(defn- ssh-pipe
  "Run `input` (a printf format string so `\\n` frames lines) through a real
   openssh client against the daemon on `port`, authenticating as alice with the
   key in `key-dir`. Returns merged stdout+stderr."
  [port key-dir input]
  (let [cmd (str "printf '" input "' | ssh -p " port
                 " -i " key-dir "/id -o IdentitiesOnly=yes"
                 " -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
                 " -o PasswordAuthentication=no -o BatchMode=yes"
                 " alice@127.0.0.1 2>&1")]
    (erlang/element 1
      (System/cmd "bash" (list "-c" cmd) (list (opt :stderr_to_stdout true))))))

(def ^:private GRANTED-DENIED "(String/upcase \\\"hi\\\")\\n(File/read \\\"/etc/passwd\\\")\\n:quit\\n")
(def ^:private QUIT ":quit\\n")

;; ── tests ────────────────────────────────────────────────────────────

(deftest enrolled-key-granted-runs-ungranted-denied
  (ensure-ssh!)
  (let [ck (client-key)
        host (host-dir)
        {:keys [root conn]} (new-stack (:line ck))
        s (serve root conn host)]
    (try
      (let [out (ssh-pipe (:port s) (:dir ck) GRANTED-DENIED)]
        (is (includes? out "=> HI")
            (str "granted String/upcase must run:\n" out))
        (is (includes? out "not granted")
            (str "ungranted File must be denied at compile time:\n" out)))
      (finally (ex/stop (:ref s))))))

(deftest non-enrolled-key-refused-at-authentication
  (ensure-ssh!)
  (let [alice (client-key)
        eve (client-key)                    ; eve's key is NOT enrolled
        host (host-dir)
        {:keys [root conn]} (new-stack (:line alice))
        s (serve root conn host)]
    (try
      (let [out (ssh-pipe (:port s) (:dir eve) QUIT)]
        (is (not (includes? out "=> HI"))
            (str "unenrolled key must not reach the REPL:\n" out))
        (is (or (includes? out "Permission denied") (includes? out "publickey"))
            (str "auth should be refused:\n" out)))
      (finally (ex/stop (:ref s))))))

(deftest revoked-principal-can-no-longer-authenticate
  (ensure-ssh!)
  (let [ck (client-key)
        host (host-dir)
        {:keys [root conn]} (new-stack (:line ck))]
    ; revoke through the SAME store the daemon will authenticate against
    (st/revoke! conn "alice")
    (let [s (serve root conn host)]
      (try
        (let [out (ssh-pipe (:port s) (:dir ck) QUIT)]
          (is (not (includes? out "=> HI"))
              (str "revoked principal must not reach the REPL:\n" out)))
        (finally (ex/stop (:ref s)))))))
