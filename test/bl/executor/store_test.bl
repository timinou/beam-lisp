; executor/store_test.bl — the principal directory: enroll, rotate, revoke, auth reads.

(ns executor.store.test
  (:require [executor.store :as st]))

(def ^:private ALICE "ssh-ed25519 AAAAALICEKEYDATA alice@laptop")
(def ^:private BOB   "ssh-ed25519 AAAABOBKEYDATA bob@desktop")

(deftest enroll-and-authorize
  (let [conn (st/open)]
    (st/enroll! conn "alice" ALICE "tok-a")
    (is (st/authorized? conn ALICE))
    (is (= "alice" (st/user-for conn ALICE)))
    (is (= "tok-a" (st/token-for conn "alice")))))

(deftest normalization-strips-comment
  ; enrolled WITH a comment; looked up by the comment-stripped canonical line.
  (let [conn (st/open)
        canonical "ssh-ed25519 AAAAALICEKEYDATA"]
    (st/enroll! conn "alice" ALICE "tok-a")
    (is (st/authorized? conn canonical))
    (is (= "alice" (st/user-for conn canonical)))))

(deftest unknown-key-denied
  (let [conn (st/open)]
    (st/enroll! conn "alice" ALICE "tok-a")
    (is (not (st/authorized? conn "ssh-ed25519 NOSUCHKEY x@y")))
    (is (nil? (st/user-for conn "ssh-ed25519 NOSUCHKEY x@y")))))

(deftest rotate-keeps-key-changes-token
  (let [conn (st/open)]
    (st/enroll! conn "alice" ALICE "tok-v1")
    (is (= "tok-v1" (st/token-for conn "alice")))
    (st/rotate-token! conn "alice" "tok-v2")
    (is (= "tok-v2" (st/token-for conn "alice")))
    ; the key still authorizes after rotation
    (is (st/authorized? conn ALICE))))

(deftest revoke-denies-key-and-token
  (let [conn (st/open)]
    (st/enroll! conn "alice" ALICE "tok-a")
    (st/revoke! conn "alice")
    (is (not (st/authorized? conn ALICE)))
    (is (nil? (st/user-for conn ALICE)))     ; revoked key names no one
    (is (nil? (st/token-for conn "alice")))  ; and carries no token
    ; re-enable restores both
    (st/enable! conn "alice")
    (is (st/authorized? conn ALICE))
    (is (= "tok-a" (st/token-for conn "alice")))))

(deftest revoke-is-per-principal
  ; revoking alice must not touch bob
  (let [conn (st/open)]
    (st/enroll! conn "alice" ALICE "tok-a")
    (st/enroll! conn "bob" BOB "tok-b")
    (st/revoke! conn "alice")
    (is (not (st/authorized? conn ALICE)))
    (is (st/authorized? conn BOB))
    (is (= "tok-b" (st/token-for conn "bob")))))

(deftest a-key-owned-by-one-user-is-not-anothers
  ; user-for returns the ENROLLED owner, so the SSH layer's ownership check
  ; (owner == login-user) refuses a mismatch.
  (let [conn (st/open)]
    (st/enroll! conn "alice" ALICE "tok-a")
    (is (= "alice" (st/user-for conn ALICE)))
    (is (not (= "bob" (st/user-for conn ALICE))))))

(deftest list-principals-reflects-state
  (let [conn (st/open)]
    (st/enroll! conn "alice" ALICE "tok-a")
    (st/enroll! conn "bob" BOB "tok-b")
    (st/revoke! conn "bob")
    (let [ps (into [] (st/list-principals conn))
          by-user (reduce (fn [m p] (assoc m (:user p) (:enabled p))) {} ps)]
      (is (= 2 (count ps)))
      (is (= true (get by-user "alice")))
      (is (= false (get by-user "bob"))))))
