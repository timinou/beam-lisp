; test/bl/watches_test.bl — `add-watch` / `remove-watch`, atom eagerness, and the
; `spell.st` connector built on them (verse PLAN-148 W6).
;
; Ported from the ExUnit `test/beam_lisp/watches_test.exs`. Before this, atoms
; supported `deref` / `swap!` / `reset!` / `compare-and-set!` but nothing could
; OBSERVE a change — a genuine Clojure-compat hole, and the one primitive
; standing between an atom and an automatic UI connector where an ordinary
; `swap!` drives the browser.
;
; PARITY MAPPING (ExUnit `test` → BL `deftest`):
;   a watch sees every change, with old and new        → a-watch-sees-every-change-with-old-and-new
;   reset! notifies too, not only swap!                → reset-notifies-too-not-only-swap
;   remove-watch stops notifications                   → remove-watch-stops-notifications
;   the watch receives its own key, so one fn serves   → the-watch-receives-its-own-key-so-one-fn-can-serve-several
;   swap! still returns the new value                  → swap-still-returns-the-new-value
;   reset! still returns the value it set              → reset-still-returns-the-value-it-set
;   an unwatched atom behaves exactly as before        → an-unwatched-atom-behaves-exactly-as-before
;   add-watch on a non-atom is a named error           → add-watch-on-a-non-atom-is-a-named-error
;   an atom may point at another atom that points back → an-atom-may-point-at-another-atom-that-points-back
;   an atom survives the process that created it       → an-atom-survives-the-process-that-created-it
;   spell.st: an ordinary swap! pushes the signals     → an-ordinary-swap-pushes-the-declared-signals
;   spell.st: only CHANGED declared keys push          → only-changed-declared-keys-push
;   spell.st: an undeclared key never pushes           → an-undeclared-key-never-pushes
;   spell.st: re-setting the same value pushes nothing → re-setting-the-same-value-pushes-nothing
;   spell.st: disconnect! stops the pushes             → disconnect-stops-the-pushes
;   spell.st: the inbound cycle closes                 → the-inbound-cycle-closes-with-no-ui-code-in-the-handler
;   spell.st: an unknown inbound signal reports false  → an-unknown-inbound-signal-reports-false-rather-than-raising
;
; ONE assertion the ExUnit could not state, added here because the atom is
; eager and the watch runs AFTER the commit: a watch that THROWS does not undo
; the committed change — the value is already in the cell when the watch runs,
; so a broken observer cannot corrupt state. That is the error-isolation
; contract of the watch table, and this is where it is pinned.
;
; ADAPTATIONS (ExUnit → ward):
;   * `eval(source)` is `BeamLisp/eval`, whose namespace follows the eval; `ev`
;     comes home to `watches.test` before and after, so a `def` in one case does
;     not land in the namespace the previous case left behind.
;   * `realize_pairs` (which unwrapped `BeamLisp.Vector` structs the Elixir
;     boundary handed back) is unnecessary: inside the language a vector IS a
;     vector, so `is (= …)` compares it directly.
;   * `assert_raise ArgumentError, ~r/add-watch/` becomes `thrown-with-msg?`.
;   * the `spell.st` connector is real BL at `test/fixtures/bl/st-connector.bl`;
;     each case re-evaluates it, which re-`def`s its `pushes` tap to a fresh
;     atom, exactly as the ExUnit's `connector/1` did.
;
; Run: bin/bl test test/bl/watches_test.bl

(ns watches.test)

(defn- ev
  "Evaluate `src` in this suite's namespace, then come home. `BeamLisp/eval`
   leaves the image in whatever namespace the source declared."
  [src]
  (BeamLisp.Env/in_ns "watches.test")
  (let [r (BeamLisp/eval src)]
    (BeamLisp.Env/in_ns "watches.test")
    r))

(defn- connector
  "The `spell.st` connector fixture, followed by `body`, evaluated together —
   the ExUnit's `connector/1`."
  [body]
  (ev (str (File/read! "test/fixtures/bl/st-connector.bl") "\n" body)))

; ── add-watch / remove-watch ─────────────────────────────────────────────

(deftest a-watch-sees-every-change-with-old-and-new
  (let [r (ev "
(def a (atom {:n 0}))
(def seen (atom []))
(add-watch a :k (fn [_k _r old new]
                  (swap! seen conj [(get old :n) (get new :n)])))
(swap! a assoc :n 1)
(swap! a assoc :n 2)
@seen
")]
    (is (= r [[0 1] [1 2]]))))

(deftest reset-notifies-too-not-only-swap
  (let [r (ev "
(def a (atom 1))
(def seen (atom []))
(add-watch a :k (fn [_k _r old new] (swap! seen conj [old new])))
(reset! a 9)
@seen
")]
    (is (= r [[1 9]]))))

(deftest remove-watch-stops-notifications
  (let [r (ev "
(def a (atom 0))
(def seen (atom []))
(add-watch a :k (fn [_k _r _old new] (swap! seen conj new)))
(reset! a 1)
(remove-watch a :k)
(reset! a 2)
[@seen @a]
")]
    (is (= r [[1] 2]))))

(deftest the-watch-receives-its-own-key-so-one-fn-can-serve-several
  (let [r (ev "
(def a (atom 0))
(def seen (atom []))
(add-watch a :one (fn [k _r _o _n] (swap! seen conj k)))
(add-watch a :two (fn [k _r _o _n] (swap! seen conj k)))
(reset! a 1)
@seen
")]
    (is (= (Enum/sort r) (list :one :two)))))

(deftest swap-still-returns-the-new-value
  (is (= 2 (ev "(let [a (atom 1)] (swap! a inc))"))))

(deftest reset-still-returns-the-value-it-set
  (is (= 7 (ev "(let [a (atom 1)] (reset! a 7))"))))

(deftest an-unwatched-atom-behaves-exactly-as-before
  ; The zero-change guarantee for the existing surface: adding watches must not
  ; alter an atom that has none.
  (is (= 3 (ev "(let [a (atom 1)] (swap! a + 2) @a)")))
  (is (= true (ev "(let [a (atom 1)] (compare-and-set! a 1 5))")))
  (is (= 1 (ev "(let [a (atom 1)] (compare-and-set! a 9 5) @a)"))))

(deftest add-watch-on-a-non-atom-is-a-named-error
  (is (thrown-with-msg? "add-watch"
        (ev "(add-watch 42 :k (fn [_k _r _o _n] nil))"))))

(deftest a-watch-that-throws-does-not-undo-the-committed-change
  ; The watch runs AFTER the commit and IN the caller's process, and the atom's
  ; value is already in the cell — so a failing observer surfaces its error but
  ; cannot roll the change back. This is the isolation the watch table promises
  ; an eager atom.
  (let [r (ev "
(def a (atom 0))
(add-watch a :boom (fn [_k _r _o _n] (throw (ex-info \"boom\" {}))))
(def outcome (try (do (swap! a inc) :no-throw) (catch e [:threw (ex-message e)])))
[outcome @a]
")]
    (is (= r [[:threw "boom"] 1]))))

; ── atoms hold eager data, including cycles ──────────────────────────────

(deftest an-atom-may-point-at-another-atom-that-points-back
  ; Atoms are eager reference cells, not lazy memos: a value that refers to
  ; another atom (which refers back) is legal, as in Clojure. The lazy memo's
  ; cycle rejection must NOT apply here.
  (let [r (ev "
(def a (atom nil))
(def b (atom nil))
(reset! a b)
(reset! b a)
[(= b @a) (= a @b)]
")]
    (is (= r [true true]))))

(deftest an-atom-survives-the-process-that-created-it
  ; A cell-backed atom is a value behind a reference, not a running process, so
  ; it outlives its creator (Clojure semantics), unlike the old Agent. The atom
  ; is built INSIDE the child, which then ends; the test still derefs and swaps
  ; it, so the cell — not the task — owns the value.
  (let [holder (atom nil)
        t (Task/async (fn [] (reset! holder (atom 41))))]
    (Task/await t 5000)
    (is (= 42 (swap! @holder inc)))))

; ── spell.st connector ───────────────────────────────────────────────────

(deftest an-ordinary-swap-pushes-the-declared-signals
  (is (= [['$status "thinking"]]
         (connector "
(def state (atom {:messages [] :status \"idle\"}))
(connect! state {:messages '$messages :status '$status})
(swap! state assoc :status \"thinking\")
(pushed)
"))))

(deftest only-changed-declared-keys-push
  ; The reason the diff lives in the connector: an atom carrying many fields
  ; where one moved must send one update, not many.
  (is (= [['$a 9]]
         (connector "
(def state (atom {:a 1 :b 2 :untracked 0}))
(connect! state {:a '$a :b '$b})
(swap! state assoc :a 9)
(pushed)
"))))

(deftest an-undeclared-key-never-pushes
  (is (= []
         (connector "
(def state (atom {:a 1 :untracked 0}))
(connect! state {:a '$a})
(swap! state assoc :untracked 42)
(pushed)
"))))

(deftest re-setting-the-same-value-pushes-nothing
  (is (= []
         (connector "
(def state (atom {:a 1}))
(connect! state {:a '$a})
(swap! state assoc :a 1)
(pushed)
"))))

(deftest disconnect-stops-the-pushes
  (let [r (connector "
(def state (atom {:a 1}))
(connect! state {:a '$a})
(swap! state assoc :a 2)
(disconnect! state)
(swap! state assoc :a 3)
[(pushed) @state]
")]
    (is (= (first r) [['$a 2]]))
    (is (= (second r) {:a 3}))))

(deftest the-inbound-cycle-closes-with-no-ui-code-in-the-handler
  ; browser signal → handler → swap! → watch → push. The handler mutates state
  ; and nothing else; the interface update is a consequence.
  (let [r (connector "
(def state (atom {:messages [] :status \"idle\"}))
(connect! state {:messages '$messages :status '$status})
(on :send (fn [payload]
            (swap! state assoc :messages [(get payload :body)])
            (swap! state assoc :status \"thinking\")))
(def ran (dispatch! :send {:body \"hello\"}))
[ran (pushed)]
")]
    (is (= (first r) true))
    (is (= (second r)
           [['$messages ["hello"]] ['$status "thinking"]]))))

(deftest an-unknown-inbound-signal-reports-false-rather-than-raising
  (is (= false
         (connector "
(def state (atom {}))
(dispatch! :nobody-listens {})
"))))
