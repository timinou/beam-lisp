; realm_namespace_test.bl — a realm's own namespaces are its own (FUP-151, namespaces).
;
; Two realms that each declare a namespace of the same name must each see THEIR code:
; the namespace, the macros it defines, and the servers it generates. Before this, the
; module a namespace compiled into was named from the namespace string alone
; (`BeamLisp.Ns.<Ns>`), so the second load replaced the first realm's code in place and
; both answered with the second's. Measured; the fixtures below are what it measured.
;
; A "realm" here is an env whose chain records `{:realm_key k}`. Namespaces served from
; a tier directory (std/lib/boot) stay shared by every realm; only a file outside the
; tiers is realm-local.

(ns realm-namespace-test)

(def FIXTURE-A "test/bl/fixtures/realm_ns/a")
(def FIXTURE-B "test/bl/fixtures/realm_ns/b")
(def REQUIRE-APP "(ns user (:require [rn-app]))")

(defn- open-realm
  "A fresh env that is a realm named `key`, forked off :global."
  [key]
  (let [e (BeamLisp.Env/fork :global)]
    (BeamLisp.Env/with_env e (fn [] (BeamLisp.Env/put_key (tuple :realm_key) key)))
    e))

(defn- in-realm
  "Evaluate `src` in realm env `e`, whose project lives in `dir`."
  [e dir src]
  (BeamLisp.Env/with_env e
    (fn []
      (BeamLisp.Loader/with_ambient_dirs (list (Path/expand dir))
        (fn [] (BeamLisp.Compiler/eval_string src (BeamLisp.Compiler/new_env "user") "realm_namespace_test"))))))

(defn- load-in [e dir] (in-realm e dir (str REQUIRE-APP " (rn-app/go)")))

(defn- server-answer [e dir]
  (let [pid (in-realm e dir "(rn-app/start)")]
    (gen_server/call (if (vector? pid) (second pid) (if (tuple? pid) (elem pid 1) pid)) [:get])))

(deftest two-realms-each-see-their-own-namespace
  (let [a (open-realm "ta") b (open-realm "tb")]
    (testing "load A, then B; each answers with its own code, including a macro of the provider"
      (is (= "app-A>lib-A>macro-A" (load-in a FIXTURE-A)))
      (is (= "app-B>lib-B>macro-B" (load-in b FIXTURE-B)))
      (is (= "app-A>lib-A>macro-A" (in-realm a FIXTURE-A "(rn-app/go)"))
          "loading B did not replace A's code"))
    (testing "the global env never saw either"
      (is (not (BeamLisp.Env/loaded_ns? "rn-app")))
      (is (not (BeamLisp.Env/loaded_ns? "rn-lib"))))))

(deftest two-realms-each-get-their-own-server
  (let [a (open-realm "sa") b (open-realm "sb")]
    (load-in a FIXTURE-A)
    (load-in b FIXTURE-B)
    (is (= "srv-A" (server-answer a FIXTURE-A)))
    (is (= "srv-B" (server-answer b FIXTURE-B))
        "a defserver compiles into a module named from the realm too")
    (is (= "srv-A" (server-answer a FIXTURE-A)) "A's server is still A's after B started one")))

(deftest the-module-names-carry-the-realm
  (let [a (open-realm "ma") b (open-realm "mb")]
    (load-in a FIXTURE-A)
    (load-in b FIXTURE-B)
    (let [names (set (map (fn [m] (Atom/to_string m)) (map first (code/all_loaded))))]
      (is (contains? names "Elixir.BeamLisp.Ns.Rma.Rn-app"))
      (is (contains? names "Elixir.BeamLisp.Ns.Rmb.Rn-app"))
      (is (not (contains? names "Elixir.BeamLisp.Ns.Rn-app")) "no unprefixed module for a realm-local namespace"))))

(deftest tier-namespaces-stay-shared
  (let [a (open-realm "xa") b (open-realm "xb")]
    (testing "a std function is the same module in every realm"
      (is (= (in-realm a FIXTURE-A "(str (inc 1))") (in-realm b FIXTURE-B "(str (inc 1))")))
      (is (= :Elixir.BeamLisp.Ns.Core (BeamLisp.Env/with_env a (fn [] (BeamLisp.Link/module_for "core")))))
      (is (= :Elixir.BeamLisp.Ns.Vm.Owner (BeamLisp.Env/with_env b (fn [] (BeamLisp.Link/module_for "vm.owner"))))))))

(deftest an-env-outside-any-realm-loads-as-before
  (let [e (BeamLisp.Env/fork :global)]
    (testing "no realm key: the global path, unchanged"
      (is (= :Elixir.BeamLisp.Ns.Rn-app (BeamLisp.Env/with_env e (fn [] (BeamLisp.Link/module_for "rn-app"))))))))
