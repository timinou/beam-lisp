(ns test.env-peek (:require [env]))

;; Host edits are compiled at a probe atom; the live registry is never
;; replaced. This view needs only the shared ETS registry and current scope.
(def PROBE :Elixir.BeamLisp.PeekInitializedProbe)
(deftest installed-host-exports-initialized-observation
  ;; Source-probe parity alone cannot establish the shipped host ABI.
  (is (erlang/function_exported :Elixir.BeamLisp.Env :peek_initialized 2))
  (is (= :error (BeamLisp.Env/peek_initialized "peek.missing" "value"))))

(defn peek [ns name]
  (when-not (erlang/function_exported PROBE :peek_initialized 2)
    (let [dir (str (System/tmp_dir!) "/bl-peek-" (erlang/unique_integer (list :positive)))
          result (BeamLisp.AOT/compile_host_file (Path/join (BeamLisp/cwd) "priv/host/env.bl")
                   (list (tuple :module PROBE) (tuple :output_dir dir) (tuple :load? false)))
          path (elem result 1)]
      (code/load_binary PROBE (erlang/binary_to_list path) (File/read! path))))
  (erlang/apply PROBE :peek_initialized (list ns name)))


(deftest observation-does-not-initialize-or-follow-a-fallback
  (let [scope (env/fork) calls (atom 0)]
    (try
      (env/with-env scope
        (fn []
          (BeamLisp.Env/define_per_env "peek.fixture" "schema"
            (fn [] (swap! calls inc) [{:db/ident :fixture/id}]))
          (is (= :error (peek "peek.fixture" "schema")))
          (is (zero? @calls))
          (is (= :Elixir.BeamLisp.Env.PerEnvDef
                 (get (elem (BeamLisp.Env/peek "peek.fixture" "schema") 1) :__struct__)))
          (is (zero? @calls))
          (is (= [{:db/ident :fixture/id}] (BeamLisp.Env/fetch! "peek.fixture" "schema")))
          (is (= 1 @calls))
          (is (= (tuple :ok [{:db/ident :fixture/id}]) (peek "peek.fixture" "schema")))
          (is (= 1 @calls))
          (is (= :error (peek "peek.missing" "map")))
          (BeamLisp.Env/define_per_env "peek.fixture" "schema" (fn [] (swap! calls inc) :replacement))
          (is (= :error (peek "peek.fixture" "schema")))
          (is (= 1 @calls))))
      (finally (env/destroy scope)))))

(deftest nil-and-false-are-bound-values-and-a-shadow-is-not-a-parent-instance
  (let [scope (env/fork)]
    (try
      (env/with-env scope
        (fn []
          (BeamLisp.Env/intern "peek.fixture" "nil" nil)
          (BeamLisp.Env/intern "peek.fixture" "false" false)
          (is (= (tuple :ok nil) (peek "peek.fixture" "nil")))
          (is (= (tuple :ok false) (peek "peek.fixture" "false")))
          (is (= :error (peek "peek.fixture" "absent")))
          (BeamLisp.Env/define_per_env "peek.fixture" "owned" (fn [] (erlang/make_ref)))
          (let [parent (BeamLisp.Env/fetch! "peek.fixture" "owned") child (env/fork)]
            (try
              (env/with-env child
                (fn []
                  (is (= :error (peek "peek.fixture" "owned")))
                  (let [value (BeamLisp.Env/fetch! "peek.fixture" "owned")]
                    (is (not= parent value))
                    (is (= (tuple :ok value) (peek "peek.fixture" "owned"))))))
              (finally (env/destroy child)))
            (is (= (tuple :ok parent) (peek "peek.fixture" "owned"))))))
      (finally (env/destroy scope)))))

(deftest an-in-flight-definition-declines-observation
  (let [scope (env/fork)]
    (try
      (env/with-env scope
        (fn []
          (BeamLisp.Env/intern "peek.fixture" "value" :ready)
          (BeamLisp.Env/with_publication "peek.fixture"
            (fn [] (is (= :error (peek "peek.fixture" "value")))))
          (is (= (tuple :ok :ready) (peek "peek.fixture" "value")))))
      (finally (env/destroy scope)))))
