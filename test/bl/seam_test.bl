; test/bl/seam_test.bl — the seam vocabulary.
; Run: mix beam_lisp.test test/bl/seam_test.bl
;
; The claim these tests defend: a beam-lisp contract term can answer questions
; about itself that an Elixir module CANNOT answer about itself — specifically,
; which reply tags a handler can produce.
;
; If `reply-tags` ever UNDER-reports, every seam check silently degrades to a
; tautology: it passes, the page is missing a receive arm, and a user finds out.
; So most of this file is adversarial cases for that one function.

(ns seam.test
  (:require [seam :refer [events assigns pushes handler-for reply-tags
                          fingerprint handles? declares-assign?
                          undecoded-tags decodes? disagreements agree?]]))

;; ── fixtures ────────────────────────────────────────────────────────────────
;; A contract term is plain data; a handler body is a QUOTED form, which is what
;; makes it walkable.

(def counter
  {:events {:inc {:body (quote (do (set! @count (inc @count)) (ok @count)))}
            :dec {:body (quote (if (zero? @count)
                                 (err "Count cannot go below zero")
                                 (do (set! @count (dec @count)) (ok @count))))}}
   :assigns {:count :integer}
   :pushes {:flash {:message :string}}})

(def page
  {:fires ["inc" "dec"]
   :subscribes ["count"]
   :arms {:inc ["ok"] :dec ["ok" "err"]}})

;; ── projection ──────────────────────────────────────────────────────────────

(deftest projects-the-surface
  (is (= (list "dec" "inc") (events counter)))
  (is (= (list "count") (assigns counter)))
  (is (= (list "flash") (pushes counter))))

(deftest handler-for-finds-bodies
  (is (not (nil? (handler-for counter "inc"))))
  (is (not (nil? (handler-for counter :inc))))
  ; nil for an event with no handler — the caller MUST decide what that means
  (is (nil? (handler-for counter "nope"))))

;; ── reply-tag enumeration: the load-bearing walk ────────────────────────────

(deftest finds-tags-at-top-level
  (is (= (list "ok") (reply-tags (quote (ok 1)))))
  (is (= (list "err") (reply-tags (quote (err "boom"))))))

(deftest finds-tags-in-both-branches
  ; the case that motivates the whole design: a tag inside an `if` arm
  (is (= (list "err" "ok")
         (reply-tags (quote (if p (ok 1) (err "x")))))))

(deftest finds-tags-nested-arbitrarily-deep
  (is (= (list "err" "ok")
         (reply-tags (quote (do (let [a 1]
                                  (if p
                                    (do (log a) (ok a))
                                    (case k
                                      :x (err "x")
                                      :y (err "y"))))))))))

(deftest descends-into-vectors-and-maps
  ; a tag can hide in a data literal, not only in a call position
  (is (= (list "ok") (reply-tags (quote [1 2 (ok 3)]))))
  (is (= (list "err") (reply-tags (quote {:a (err "e")}))))
  (is (= (list "err" "ok") (reply-tags (quote [(ok 1) {:k (err "e")}])))))

(deftest descends-through-unknown-forms
  ; THE anti-tautology property. The walk does not know `with-retry` or
  ; `transaction`, and must still find the tags inside them. Skipping unknown
  ; heads is exactly how a check silently stops checking.
  (is (= (list "ok")
         (reply-tags (quote (with-retry {:n 3} (transaction (ok 1)))))))
  (is (= (list "err" "ok")
         (reply-tags (quote (some-macro-nobody-wrote-yet
                              (ok 1)
                              (another-unknown (err "x"))))))))

(deftest descends-even-below-a-contributing-form
  ; pathological but must not lose the inner tag
  (is (= (list "err" "ok") (reply-tags (quote (ok (if p (err "x") 1)))))))

(deftest deduplicates-and-sorts
  (is (= (list "ok") (reply-tags (quote (do (ok 1) (ok 2) (ok 3))))))
  (is (= (list "err" "ok") (reply-tags (quote (do (err "a") (ok 1) (err "b")))))))

(deftest fire-and-forget-is-empty-not-an-error
  ; a handler with no reply is a legitimate DECLARATION: the page must not
  ; correlate on it. Empty is the answer, never a failure.
  (is (= [] (reply-tags (quote (set! @count 1)))))
  (is (= [] (reply-tags nil)))
  (is (= [] (reply-tags (quote ())))))

(deftest tags-are-not-confused-with-other-symbols
  ; `ok` in a NON-head position is data, not a reply
  (is (= [] (reply-tags (quote (log :ok)))))
  (is (= [] (reply-tags (quote (f "ok")))))
  ; but a head named ok still counts wherever it appears
  (is (= (list "ok") (reply-tags (quote (log (ok 1)))))))

(deftest reads-tags-from-the-real-fixture
  (is (= (list "ok") (reply-tags (handler-for counter "inc"))))
  ; dec can answer BOTH ways — the fact a page must know to be correct
  (is (= (list "err" "ok") (reply-tags (handler-for counter "dec")))))

;; ── fingerprint ─────────────────────────────────────────────────────────────

(deftest fingerprint-is-stable-and-order-independent
  (is (= (fingerprint counter) (fingerprint counter)))
  (is (= 64 (count (fingerprint counter))))
  ; a pure REORDER is not a contract change
  (let [reordered {:events {:dec (get-in counter [:events :dec])
                            :inc (get-in counter [:events :inc])}
                   :assigns {:count :integer}
                   :pushes {:flash {:message :string}}}]
    (is (= (fingerprint counter) (fingerprint reordered)))))

(deftest fingerprint-changes-on-a-real-change
  (let [added (assoc-in counter [:events :reset] {:body (quote (ok 0))})]
    (is (not (= (fingerprint counter) (fingerprint added)))))
  (let [renamed (assoc counter :assigns {:total :integer})]
    (is (not (= (fingerprint counter) (fingerprint renamed)))))
  (let [pushed (assoc counter :pushes {})]
    (is (not (= (fingerprint counter) (fingerprint pushed))))))

(deftest fingerprint-ignores-handler-BODIES
  ; deliberate: the fingerprint is the SURFACE. A body rewrite that keeps the
  ; surface identical is a compatible revision, and this pins that meaning so
  ; nobody later reads `fingerprint` as "did anything change".
  (let [rewritten (assoc-in counter [:events :inc :body]
                            (quote (do (audit!) (set! @count (inc @count)) (ok @count))))]
    (is (= (fingerprint counter) (fingerprint rewritten)))))

;; ── the seam checks ─────────────────────────────────────────────────────────

(deftest handles-requires-BOTH-declaration-and-handler
  (is (= true (handles? counter "inc")))
  (is (= false (handles? counter "nope")))
  ; declared but with a nil body = firing into the void (FUP-143 hole #1)
  (let [void (assoc-in counter [:events :ghost] {:body nil})]
    (is (= false (handles? void "ghost")))))

(deftest declares-assign
  (is (= true (declares-assign? counter "count")))
  (is (= false (declares-assign? counter "missing"))))

(deftest decodes-checks-hole-2
  (is (= true (decodes? counter "dec" ["ok" "err"])))
  ; a page decoding only "ok" will DROP the err reply — the exact runtime
  ; surprise Elixir cannot catch at compile time
  (is (= false (decodes? counter "dec" ["ok"])))
  (is (= ["err"] (undecoded-tags counter "dec" ["ok"])))
  ; decoding MORE than produced is fine (harmless, just unused arms)
  (is (= true (decodes? counter "inc" ["ok" "err" "weird"]))))

(deftest agreeing-halves-report-nothing
  (is (= [] (disagreements counter page)))
  (is (= true (agree? counter page))))

(deftest each-disagreement-is-named
  ; an event the server does not handle
  (let [d (disagreements counter (assoc page :fires ["inc" "ghost"]))]
    (is (= 1 (count d)))
    (is (= :event-not-handled (get (first d) :kind)))
    (is (= "ghost" (get (first d) :event))))

  ; an assign the server does not declare
  (let [d (disagreements counter (assoc page :subscribes ["count" "phantom"]))]
    (is (= 1 (count d)))
    (is (= :assign-not-declared (get (first d) :kind)))
    (is (= "phantom" (get (first d) :assign))))

  ; a reply tag the page cannot decode — hole #2, named down to the tag
  (let [d (disagreements counter (assoc page :arms {:inc ["ok"] :dec ["ok"]}))]
    (is (= 1 (count d)))
    (is (= :reply-not-decoded (get (first d) :kind)))
    (is (= "dec" (get (first d) :event)))
    (is (= "err" (get (first d) :tag)))))

(deftest multiple-disagreements-all-reported
  ; a failure must not stop at the first problem: a fix-one-see-the-next loop
  ; is how a five-minute repair becomes an afternoon
  ; NB `dec` must be FIRED for its reply arms to be checked at all: a page
  ; cannot receive a reply to an event it never sends, so declaring arms for an
  ; unfired event is not a disagreement. Firing it is what exposes the missing
  ; "err" arm.
  (let [d (disagreements counter {:fires ["inc" "dec" "ghost"]
                                  :subscribes ["count" "phantom"]
                                  :arms {:inc ["ok"] :dec ["ok"]}})]
    (is (= 3 (count d)))
    (is (= (list "assign-not-declared" "event-not-handled" "reply-not-decoded")
           (sort (map (fn [x] (name (get x :kind))) d))))))

(deftest a-page-that-fires-nothing-trivially-agrees
  (is (= true (agree? counter {:fires [] :subscribes [] :arms {}}))))

(deftest arms-for-an-unfired-event-are-not-a-disagreement
  ; Found by a test of mine that expected 3 disagreements and got 2. The
  ; implementation was right and the expectation wrong: reply arms are only
  ; checked for events the page actually FIRES, because a page cannot receive a
  ; reply to a message it never sends. Declaring arms for an unfired event is
  ; dead code, not a broken seam.
  ;
  ; Pinned because the opposite behaviour looks equally plausible, and a future
  ; reader deserves to know which one was chosen and why.
  (is (= [] (disagreements counter {:fires ["inc"]
                                    :subscribes []
                                    :arms {:inc ["ok"] :dec ["ok"]}})))
  ; …and firing it immediately surfaces the missing arm
  (is (= 1 (count (disagreements counter {:fires ["dec"]
                                          :subscribes []
                                          :arms {:dec ["ok"]}})))))
