(ns aot-pinned-declaration-test)

(defn- fixture [action]
 (let [dir (str (System/get_env "HOME") "/tmp/pinned-declaration-"
                (System/unique_integer (list :positive)))
       previous (BeamLisp.Env/capture)]
  (File/mkdir_p! dir)
  (try (action dir)
   (finally (BeamLisp.Env/bind previous) (File/rm_rf! dir)))))

(deftest executable-nested-host-declarations-refuse-before-source-effects
 (fixture
  (fn [dir]
   (doseq [head ["defn" "defn-" "ns"]]
    (let [source (str "(ns pinned.boundary.fixture) "
                      "(File/write! " (pr-str (str dir "/effect")) " \"ran\") "
                      "(defn outer [] (" head " inner" (if (= "ns" head) "" " [] :nested") "))")
          file (str dir "/" head ".bl")
          _ (File/write! file source)
          refusal (try
                    (BeamLisp.AOT/compile_host_file file
                     (list (tuple :module :Elixir.BeamLisp.PinnedDeclarationProbe)
                           (tuple :output_dir dir))) nil
                    (catch error (ex-data error)))]
     (is (= :nested-pinned-host-declaration (:kind refusal)))
     (is (= head (:head refusal)))
     (is (= false (File/exists? (str dir "/effect"))))
     (is (= false (File/exists? (str dir "/Elixir.BeamLisp.PinnedDeclarationProbe.beam")))))))))

(deftest genuine-host-forward-calls-and-quoted-declaration-data-remain-valid
 (fixture
  (fn [dir]
   (let [file (str dir "/forward.bl")
         _ (File/write! file
             "(ns pinned.forward.fixture) (defn first-call [] (later)) (defn later [] :linked) (defn quoted [] '(defn inert [] :data)) (defn syntax [] `(defn inert [] :data))")
         result (BeamLisp.AOT/compile_host_file file
                  (list (tuple :module :Elixir.BeamLisp.PinnedDeclarationProbe)
                        (tuple :output_dir dir)))]
    (is (= :Elixir.BeamLisp.PinnedDeclarationProbe (first result)))
    (is (= :linked (erlang/apply :Elixir.BeamLisp.PinnedDeclarationProbe :first-call (list))))
    (is (seq (erlang/apply :Elixir.BeamLisp.PinnedDeclarationProbe :quoted (list))))
    (is (seq (erlang/apply :Elixir.BeamLisp.PinnedDeclarationProbe :syntax (list))))))))

(deftest constructor-clause-and-form-helpers-are-actual-native-module-exports
 ;; A misplaced closing parenthesis once hid both under another defn; global
 ;; delimiter balance alone could not catch it, and normal prelink was correct.
 (is (erlang/function_exported :Elixir.BeamLisp.AOT :constructor_record_clause! 2))
 (is (erlang/function_exported :Elixir.BeamLisp.AOT :stage-sdk-forms! 5)))


(deftest first-class-pinned-local-functions-refuse-before-native-emission
 (fixture
  (fn [dir]
   (doseq [expression ["helper" "(list helper)" "(fn [] helper)"]]
    (let [file (str dir "/global.bl") marker (str dir "/effect")
          _ (File/write! file
              (str "(ns pinned.value.fixture) "
                   "(defn helper [] (File/write! " (pr-str marker) " \"bad\")) "
                   "(defn result [] " expression ")"))
          refusal (try
                    (BeamLisp.AOT/compile_host_file file
                     (list (tuple :module :Elixir.BeamLisp.PinnedValueProbe)
                           (tuple :output_dir dir))) nil
                    (catch error (ex-data error)))]
     (is (= :unbound-pinned-host-global (:kind refusal)))
     (is (= "helper" (:name refusal)))
     (is (= false (File/exists? marker)))
     (is (= false (File/exists? (str dir "/Elixir.BeamLisp.PinnedValueProbe.beam")))))))))

(deftest explicit-native-local-closures-work-after-temporary-bindings-disappear
 (fixture
  (fn [dir]
   (let [file (str dir "/closed.bl")
         _ (File/write! file
             "(ns pinned.closed.fixture) (defn use [f] (f)) (defn first-call [] (use (fn [] (later)))) (defn later [] :linked) (defn quoted [] 'later)")
         result (BeamLisp.AOT/compile_host_file file
                  (list (tuple :module :Elixir.BeamLisp.PinnedClosedProbe)
                        (tuple :output_dir dir)))
         previous (BeamLisp.Env/capture) scope (BeamLisp.Env/fork :global)]
    (try
     (is (= :Elixir.BeamLisp.PinnedClosedProbe (first result)))
     (is (= :linked
            (BeamLisp.Env/with_env scope
             (fn []
              (BeamLisp.Env/intern "pinned.closed.fixture" "later" nil)
              (erlang/apply :Elixir.BeamLisp.PinnedClosedProbe :first-call (list))))))
     (is (= 'later (erlang/apply :Elixir.BeamLisp.PinnedClosedProbe :quoted (list))))
     (is (= previous (BeamLisp.Env/capture)))
     (finally (BeamLisp.Env/destroy scope)))))))
