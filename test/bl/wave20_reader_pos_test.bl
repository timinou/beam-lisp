; test/bl/wave20_reader_pos_test.bl — reader position, ported from
; test/beam_lisp/wave20_reader_pos_test.exs.
;
; The position-aware entry returns WRAPPED forms: the position map rides on a
; `{:meta, form, m}` tuple. Pull the position map off the wrapper; forms that
; never carry a wrapper (scalars, keywords, vectors, maps, sets) come back with
; nil meta — the documented no-op.
;
; ── coverage map (ExUnit test → BL deftest) ────────────────────────────────
; All fourteen ExUnit tests map one-to-one onto a same-named BL deftest:
;   a form on line 1 carries line 1, col 1, and the file
;   a form on line 5 is attributed to line 5
;   a form after a comment lands on the next line
;   a form after a blank line lands past it
;   two forms on the same line carry their distinct columns
;   leading indentation sets the column
;   a nested list carries its own position, independent of its parent
;   only lists carry position; symbols and scalars stay bare
;   file is threaded into every list, nested and sibling alike
;   read_string/1 defaults the file to nil
;   read_all/read_one still return the bare shapes
;   vectors, maps and sets stay bare — they are shape tokens too
;   fn literal, quote and deref sugar attach the prefix position
;   auto-gensym and char literals are unaffected by position tracking
;
; Run: bin/bl test test/bl/wave20_reader_pos_test.bl

(ns wave20-reader-pos.test)

(defn- pos [form] (BeamLisp.FormMeta/meta form))
(defn- line [form] (get (pos form) :line))
(defn- col [form] (get (pos form) :col))

(deftest a-form-on-line-1-carries-line-1-col-1-and-the-file
  (let [list (first (BeamLisp.Reader/read_string "(+ 1 2)" "a.bl"))]
    ; the start position is the contract these tests guard; the reader now ALSO
    ; records the end span (:end-line/:end-col) for underline diagnostics.
    (is (= 1 (line list)))
    (is (= 1 (col list)))
    (is (= "a.bl" (get (pos list) :file)))
    (is (= 1 (get (pos list) :end-line)))
    (is (= 8 (get (pos list) :end-col)))))

(deftest a-form-on-line-5-is-attributed-to-line-5
  (let [list (nth (BeamLisp.Reader/read_string "a\nb\nc\nd\n(+ 1 2)" "f.bl") 4)]
    (is (= 5 (line list)))
    (is (= 1 (col list)))))

(deftest a-form-after-a-comment-lands-on-the-next-line
  (let [list (first (BeamLisp.Reader/read_string "; leading comment\n(+ 1 2)" "f.bl"))]
    (is (= 2 (line list)))
    (is (= 1 (col list)))))

(deftest a-form-after-a-blank-line-lands-past-it
  (let [list (first (BeamLisp.Reader/read_string "\n\n(+ 1 2)" "f.bl"))]
    (is (= 3 (line list)))))

(deftest two-forms-on-the-same-line-carry-their-distinct-columns
  (let [forms (BeamLisp.Reader/read_string "(foo)  (bar)" "f.bl")
        a (first forms) b (second forms)]
    (is (= [1 1] [(line a) (col a)]))
    (is (= [1 8] [(line b) (col b)]))))

(deftest leading-indentation-sets-the-column
  (let [list (first (BeamLisp.Reader/read_string "    (x)" "f.bl"))]
    (is (= 5 (col list)))))

(deftest a-nested-list-carries-its-own-position-independent-of-its-parent
  (let [outer (first (BeamLisp.Reader/read_string "(outer\n  (inner 1))" "n.bl"))
        inner (nth (erlang/element 2 (erlang/element 2 outer)) 1)]
    (is (= 1 (line outer)))
    ; the inner list opens on line 2 — the parent's line must not leak down.
    (is (= 2 (line inner)))
    (is (= 3 (col inner)))))

(deftest only-lists-carry-position-symbols-and-scalars-stay-bare
  ; A symbol is as often a *shape token* as a value — a parameter, a binding
  ; name, a `def` name — and the compiler matches those structurally in many
  ; places. A list is where evaluation happens, so a list is what an error names.
  (let [sym (first (BeamLisp.Reader/read_string "foo" "f.bl"))]
    (is (= (tuple :symbol "foo") sym))
    (is (= nil (pos sym))))
  (is (= (tuple :keyword "ok") (first (BeamLisp.Reader/read_string ":ok" "f.bl"))))
  (is (= 42 (first (BeamLisp.Reader/read_string "42" "f.bl"))))
  (let [list (first (BeamLisp.Reader/read_string "(foo 42)" "f.bl"))]
    (is (= 1 (line list)))
    (is (= 1 (col list)))
    (is (= "f.bl" (get (pos list) :file)))))

(deftest file-is-threaded-into-every-list-nested-and-sibling-alike
  (let [forms (BeamLisp.Reader/read_string "(one)\n(two (three))" "src/app.bl")
        a (first forms) b (second forms)]
    (is (= "src/app.bl" (get (pos a) :file)))
    (is (= "src/app.bl" (get (pos b) :file)))
    (is (= 2 (line b)))
    (let [nested (nth (erlang/element 2 (erlang/element 2 b)) 1)]
      (is (= "src/app.bl" (get (pos nested) :file))))))

(deftest read-string-1-defaults-the-file-to-nil
  (let [list (first (BeamLisp.Reader/read_string "(+ 1 2)"))]
    (is (= 1 (line list)))
    (is (= 1 (col list)))
    (is (= nil (get (pos list) :file)))
    (is (= 8 (get (pos list) :end-col)))))

(deftest read-all-and-read-one-still-return-the-bare-shapes
  (is (= (tuple :list [(tuple :symbol "+") 1 2]) (BeamLisp.Reader/read_one "(+ 1 2)")))
  (is (= (tuple :symbol "foo") (BeamLisp.Reader/read_one "foo")))
  (let [forms (BeamLisp.Reader/read_all "(def x 1) (+ x 2)")]
    (is (= 2 (count forms)))
    (is (= (tuple :list [(tuple :symbol "def") (tuple :symbol "x") 1]) (first forms)))
    (is (= (tuple :list [(tuple :symbol "+") (tuple :symbol "x") 2]) (second forms)))))

(deftest vectors-maps-and-sets-stay-bare-they-are-shape-tokens-too
  ; A param vector, a `let` binding vector and a destructuring pattern are all
  ; `{:vector, _}`; positions on them would break the same sites.
  (is (= nil (pos (first (BeamLisp.Reader/read_string "[1 2]" "f.bl")))))
  (is (= nil (pos (first (BeamLisp.Reader/read_string "{:a 1}" "f.bl")))))
  (is (= nil (pos (first (BeamLisp.Reader/read_string (str "#" "{1}") "f.bl"))))))

(deftest fn-literal-quote-and-deref-sugar-attach-the-prefix-position
  (let [f (first (BeamLisp.Reader/read_string "#(+ % 1)" "f.bl"))]
    (is (= [1 1] [(line f) (col f)])))
  (let [q (first (BeamLisp.Reader/read_string "'foo" "f.bl"))]
    (is (= [1 1] [(line q) (col q)])))
  (let [d (first (BeamLisp.Reader/read_string "@x" "f.bl"))]
    (is (= [1 1] [(line d) (col d)]))))

(deftest auto-gensym-and-char-literals-are-unaffected-by-position-tracking
  (is (= (tuple :symbol "x#") (BeamLisp.Reader/read_one "x#")))
  (is (= \a (BeamLisp.Reader/read_one "\\a")))
  (is (= \newline (BeamLisp.Reader/read_one "\\newline"))))
