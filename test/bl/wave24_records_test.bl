; test/bl/wave24_records_test.bl — deftype/defrecord, ported from
; test/beam_lisp/wave24_records_test.exs.
;
; Records are real Elixir structs (a map with a known key set plus a type) so
; Elixir interop, printing and pattern matching work on them; the type name is
; interned as a var whose value is the struct module. Because a struct
; satisfies `is_map`, the RT's map clauses are routed through record-aware
; clauses that exclude the internal `__struct__` key — these tests exist to
; prove a record is never silently swallowed by a plain-map clause.
;
; ── coverage map (ExUnit test → BL deftest) ────────────────────────────────
; All 31 ExUnit tests map one-to-one onto a same-named BL deftest, in the
; original order (the ExUnit `describe` blocks flatten into the same sequence):
;   canonical host module: preserves the Elixir struct ABI through repeated
;     redefinition; record and deftype generation contains no quoted compiler
;     route
;   constructors: ->Point; map->Point; missing field defaults to nil; arity
;   record is a map: keyword/get; assoc known; assoc unknown;
;     count/keys/vals/seq; __struct__ is not part of the surface; map?/coll?
;   equality: same type+value; different types; record vs plain map; nested value
;   inline protocol implementations: inline methods; inline vs extend-type;
;     non-implementing type raises; extend-type dispatch
;   deftype: constructor + named-field access + no map semantics; inline
;     protocol; distinct by type
;   pr-str round-trip: prints readably and reads back; source literal
;   no is_map clause swallows a record: map/filter; reduce; into; merge;
;     str/print-str; conj with [k v]
;
; Adaptations, and why:
;   * `BeamLisp.Test.realize/1` (Elixir) → `doall` (the language's own seq
;     realization) — the port keeps the same values.
;   * The ExUnit `setup` (init + `in_ns "user"`) has no ward equivalent; each
;     test calls `(start)` itself.
;   * The source-route assertion read `lib/beam_lisp/record.ex`, which no longer
;     exists — record codegen is now `priv/host/record.bl`. The property is
;     unchanged: the generator must build a real struct module, with NO
;     `Module/create` and NO quoted route. The check moves to the live source.
;   * Raw Elixir struct literals (`%BeamLisp.Vector{items: {...}}`) are written
;     as the equivalent map literal, so the comparison is still against a
;     hand-built value rather than a second evaluation of the code under test.
;
; Run: bin/bl test test/bl/wave24_records_test.bl

(ns wave24.records.test)

(defn- start []
  (BeamLisp/init)
  (BeamLisp.Env/in_ns "user"))

(defn- eval [source]
  (BeamLisp.Compiler/eval_string source (BeamLisp.Compiler/new_env "user")))

; A `BeamLisp.Vector` struct built by hand: `items` is a tuple of elements.
(defn- vt [pairs]
  {:__struct__ :Elixir.BeamLisp.Vector :items (erlang/list_to_tuple pairs)})

; ── canonical host module ──────────────────────────────────────────────────

(deftest preserves-the-elixir-struct-abi-through-repeated-redefinition
  (start)
  (eval "(defrecord W24Abi [x y])")
  (eval "(defrecord W24Abi [x y])")
  (eval "(defrecord W24Abi [x y])")
  (is (= {:__struct__ :Elixir.BeamLisp.Record.User.W24Abi :x nil :y nil}
         (erlang/apply :Elixir.BeamLisp.Record.User.W24Abi :__struct__ (list))))
  (is (= {:__struct__ :Elixir.BeamLisp.Record.User.W24Abi :x 1 :y nil}
         (Elixir.Kernel/struct :Elixir.BeamLisp.Record.User.W24Abi {:x 1 :unknown 2})))
  (is (try (do (Elixir.Kernel/struct! :Elixir.BeamLisp.Record.User.W24Abi {:x 1 :unknown 2}) false)
           (catch KeyError _e true))))

(deftest record-and-deftype-generation-contains-no-quoted-compiler-route
  (start)
  (let [source (File/read! "priv/host/record.bl")]
    (is (not (includes? source "Module/create")))
    (is (not (includes? source "(quote"))))
  (eval "(deftype W24CanonicalType [x])")
  (is (not (erlang/function_exported :Elixir.BeamLisp.Record.User.W24CanonicalType :__struct__ 0))))

; ── constructors ───────────────────────────────────────────────────────────

(deftest arrow-point-builds-a-record-with-the-declared-fields
  (start)
  (eval "(defrecord W24Point [x y])")
  (is (= {:__struct__ :Elixir.BeamLisp.Record.User.W24Point :x 1 :y 2} (eval "(->W24Point 1 2)"))))

(deftest map-arrow-point-builds-a-record-from-a-maps-known-fields-dropping-extras
  (start)
  (eval "(defrecord W24Point [x y])")
  (is (= {:__struct__ :Elixir.BeamLisp.Record.User.W24Point :x 1 :y 2} (eval "(map->W24Point {:x 1 :y 2 :z 3})"))))

(deftest a-field-not-in-the-map-defaults-to-nil
  (start)
  (eval "(defrecord W24Point [x y])")
  (is (= {:__struct__ :Elixir.BeamLisp.Record.User.W24Point :x 1 :y nil} (eval "(map->W24Point {:x 1})"))))

(deftest the-constructor-enforces-arity
  (start)
  (eval "(defrecord W24Point [x y])")
  (is (try (do (eval "(->W24Point 1)") false) (catch ArgumentError _e true)))
  (is (try (do (eval "(->W24Point 1 2 3)") false) (catch ArgumentError _e true))))

; ── record is a map ────────────────────────────────────────────────────────

(deftest keyword-lookup-and-get-both-work
  (start)
  (eval "(defrecord W24Point [x y])")
  (is (= 1 (eval "(:x (->W24Point 1 2))")))
  (is (= 2 (eval "(:y (->W24Point 1 2))")))
  (is (= 1 (eval "(get (->W24Point 1 2) :x)")))
  (is (= :missing (eval "(get (->W24Point 1 2) :z :missing)"))))

(deftest assoc-on-a-known-key-preserves-the-record-type
  (start)
  (eval "(defrecord W24Point [x y])")
  (is (= {:__struct__ :Elixir.BeamLisp.Record.User.W24Point :x 9 :y 2} (eval "(assoc (->W24Point 1 2) :x 9)"))))

(deftest assoc-on-an-unknown-key-adds-it-and-stays-a-record
  (start)
  (eval "(defrecord W24Point [x y])")
  (is (= {:__struct__ :Elixir.BeamLisp.Record.User.W24Point :x 1 :y 2 :z 3}
         (eval "(assoc (->W24Point 1 2) :z 3)"))))

(deftest count-keys-vals-seq-read-the-public-fields-never-struct
  (start)
  (eval "(defrecord W24Point [x y])")
  (is (= 2 (eval "(count (->W24Point 1 2))")))
  (is (= 3 (eval "(count (assoc (->W24Point 1 2) :z 3))")))
  (is (= (list :x :y) (doall (eval "(keys (->W24Point 1 2))"))))
  (is (= (list 1 2) (doall (eval "(vals (->W24Point 1 2))"))))
  (is (= (list :x :y) (doall (eval "(map first (seq (->W24Point 1 2)))"))))
  (is (= true (eval "(contains? (->W24Point 1 2) :x)")))
  (is (= (vt (list :y 2)) (eval "(find (->W24Point 1 2) :y)"))))

(deftest the-internal-struct-key-is-not-part-of-the-record-surface
  (start)
  (eval "(defrecord W24Point [x y])")
  (is (= nil (eval "(get (->W24Point 1 2) :__struct__)")))
  (is (= false (eval "(contains? (->W24Point 1 2) :__struct__)")))
  (is (= nil (eval "(find (->W24Point 1 2) :__struct__)")))
  (is (try (do (eval "(assoc (->W24Point 1 2) :__struct__ 9)") false)
           (catch ArgumentError _e true))))

(deftest map-coll-report-a-record-the-way-clojure-does
  (start)
  (eval "(defrecord W24Point [x y])")
  (is (= true (eval "(map? (->W24Point 1 2))")))
  (is (= true (eval "(coll? (->W24Point 1 2))")))
  (is (= false (eval "(map? (map inc [1 2]))")))
  (is (= false (eval "(map? [1 2])")))
  (is (= false (eval "(map? (atom 1))"))))

; ── equality ───────────────────────────────────────────────────────────────

(deftest records-of-the-same-type-and-value-are-equal
  (start)
  (eval "(defrecord W24Point [x y])")
  (is (= true (eval "(= (->W24Point 1 2) (->W24Point 1 2))")))
  (is (= false (eval "(= (->W24Point 1 2) (->W24Point 1 3))"))))

(deftest records-of-different-types-with-identical-fields-are-not-equal
  (start)
  (eval "(defrecord W24Point [x y])")
  (eval "(defrecord W24Coord [x y])")
  (is (= false (eval "(= (->W24Point 1 2) (->W24Coord 1 2))"))))

(deftest a-record-and-a-plain-map-with-the-same-entries-are-not-equal
  (start)
  (eval "(defrecord W24Point [x y])")
  (is (= false (eval "(= (->W24Point 1 2) {:x 1 :y 2})"))))

(deftest the-map-value-equality-is-preserved
  (start)
  (eval "(defrecord W24Point [x y])")
  (eval "(defrecord W24InlineVector [v])")
  (is (= true (eval "(= (->W24InlineVector [1 2]) (->W24InlineVector [1 2]))"))))

; ── inline protocol implementations ────────────────────────────────────────

(deftest defrecord-inline-protocol-methods-dispatch-on-the-record
  (start)
  (eval (str "(defprotocol W24Shape (w24-area [this]) (w24-perim [this]))\n"
             "(defrecord W24Rect [w h]\n"
             "  W24Shape\n"
             "  (w24-area [this] (* (:w this) (:h this)))\n"
             "  (w24-perim [this] (+ (* 2 (:w this)) (* 2 (:h this)))))"))
  (is (= 12 (eval "(w24-area (->W24Rect 3 4))")))
  (is (= 14 (eval "(w24-perim (->W24Rect 3 4))"))))

(deftest inline-impl-and-a-separate-extend-type-are-interchangeable
  (start)
  (eval (str "(defprotocol W24Shape2 (w24-area2 [this]))\n"
             "(defrecord W24Rect [w h] W24Shape2 (w24-area2 [this] (* (:w this) (:h this))))"))
  (is (= 10 (eval "(w24-area2 (->W24Rect 2 5))")))
  ; extend-type on the same record type keys the same tag.
  (eval "(extend-type W24Rect W24Shape2 (w24-area2 [this] (+ (:w this) (:h this))))")
  (is (= 7 (eval "(w24-area2 (->W24Rect 2 5))"))))

(deftest a-record-of-a-non-implementing-type-has-no-method-raises
  (start)
  (eval (str "(defprotocol W24Shape3 (w24-area3 [this]))\n"
             "(defrecord W24Rect [w h] W24Shape3 (w24-area3 [this] 42))\n"
             "(defrecord W24Point [x y])"))
  (is (= 42 (eval "(w24-area3 (->W24Rect 1 2))")))
  (is (try (do (eval "(w24-area3 (->W24Point 1 2))") false)
           (catch RuntimeError _e true))))

(deftest a-protocol-extended-via-extend-type-dispatches-on-a-record
  (start)
  (eval "(defrecord W24Pt [x y])")
  (eval "(defprotocol W24Norm (w24-norm [this]))")
  (eval "(extend-type W24Pt W24Norm (w24-norm [this] (+ (:x this) (:y this))))")
  (is (= 7 (eval "(w24-norm (->W24Pt 3 4))"))))

; ── deftype ────────────────────────────────────────────────────────────────

(deftest deftype-has-the--name-constructor-and-named-field-access-but-no-map-semantics
  (start)
  (eval "(deftype W24Line [a b])")
  (is (= 1 (eval "(.-a (->W24Line 1 2))")))
  (is (= 2 (eval "(.b (->W24Line 1 2))")))
  ; No map semantics: not a map, and keyword/get NEVER read fields. Lookup on a
  ; non-associative value is the decided total-get nil; count stays a hard error.
  (is (= false (eval "(map? (->W24Line 1 2))")))
  (is (= nil (eval "(:a (->W24Line 1 2))")))
  (is (= nil (eval "(get (->W24Line 1 2) :a)")))
  (is (try (do (eval "(count (->W24Line 1 2))") false)
           (catch FunctionClauseError _e true))))

(deftest deftype-implements-a-protocol-inline
  (start)
  (eval (str "(defprotocol W24Len (w24-len [this]))\n"
             "(deftype W24InlineVector [x y] W24Len (w24-len [this] (+ (.-x this) (.-y this))))"))
  (is (= 7 (eval "(w24-len (->W24InlineVector 3 4))"))))

(deftest deftype-instances-are-distinct-by-type
  (start)
  (eval "(deftype W24A [n])")
  (eval "(deftype W24B [n])")
  (is (= true (eval "(= (->W24A 1) (->W24A 1))")))
  (is (= false (eval "(= (->W24A 1) (->W24B 1))"))))

; ── pr-str round-trip ──────────────────────────────────────────────────────

(deftest a-record-prints-readably-and-reads-back-to-an-equal-record
  (start)
  (eval "(defrecord W24Point [x y])")
  (let [printed (eval "(pr-str (->W24Point 1 2))")]
    (is (= "#user/W24Point{:x 1, :y 2}" printed))
    (let [read-back (BeamLisp.Compiler/eval_string printed (BeamLisp.Compiler/new_env "user"))
          original (eval "(->W24Point 1 2)")]
      (is (BeamLisp.Ns.Rt/eqv read-back original))
      (is (= false (BeamLisp.Ns.Rt/eqv read-back (eval "(->W24Point 1 3)")))))))

(deftest a-record-literal-in-source-constructs-the-record
  (start)
  (eval "(defrecord W24Point [x y])")
  (is (= true (eval "(= #user/W24Point{:x 1 :y 2} (->W24Point 1 2))"))))

; ── no is_map clause swallows a record ─────────────────────────────────────

(deftest map-filter-over-a-record-iterate-its-entries-not-struct-fields
  (start)
  (eval "(defrecord W24Point [x y])")
  (is (= (list :x :y) (doall (eval "(map first (seq (->W24Point 1 2)))"))))
  (is (= 2 (eval "(count (map identity (seq (->W24Point 1 2))))")))
  (is (= (list (vt (list :y 2)))
         (doall (eval "(filter (fn [e] (> (second e) 1)) (seq (->W24Point 1 2)))")))))

(deftest reduce-over-a-record-folds-its-entries
  (start)
  (eval "(defrecord W24Point [x y])")
  (is (= 3 (eval "(reduce (fn [acc e] (+ acc (second e))) 0 (seq (->W24Point 1 2)))"))))

(deftest into-collects-the-records-entries-into-a-vector
  (start)
  (eval "(defrecord W24Point [x y])")
  (is (= (vt (list (vt (list :x 1)) (vt (list :y 2))))
         (eval "(into [] (seq (->W24Point 1 2)))")))
  (is (= 2 (eval "(count (into [] (seq (->W24Point 1 2))))"))))

(deftest merge-reads-the-records-entries-into-a-map
  (start)
  (eval "(defrecord W24Point [x y])")
  ; merge starts from {} so the result is a plain map; the point is that
  ; seq/assoc over the record never leak __struct__.
  (is (= {:x 1 :y 2 :z 3} (eval "(merge (->W24Point 1 2) {:z 3})")))
  (is (= (list :x :y :z) (doall (eval "(keys (merge (->W24Point 1 2) {:z 3}))")))))

(deftest str-and-print-str-print-the-record-not-its-struct-fields
  (start)
  (eval "(defrecord W24Point [x y])")
  (is (= "#user/W24Point{:x 1, :y 2}" (eval "(str (->W24Point 1 2))")))
  (is (= "#user/W24Point{:x 1, :y 2}" (eval "(print-str (->W24Point 1 2))")))
  (is (not (includes? (eval "(str (->W24Point 1 2))") "__struct__"))))

(deftest conj-with-a-k-v-entry-assocs-onto-a-record
  (start)
  (eval "(defrecord W24Point [x y])")
  (is (= {:__struct__ :Elixir.BeamLisp.Record.User.W24Point :x 1 :y 2 :z 3}
         (eval "(conj (->W24Point 1 2) [:z 3])"))))
