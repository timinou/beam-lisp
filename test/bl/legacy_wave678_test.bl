; legacy_wave678_test.bl — the wave6 / wave7 / wave8 ExUnit suites, ported whole.
;
; Ported from test/beam_lisp/wave6_errors_test.exs (18 cases),
; wave7_refs_test.exs (20 cases) and wave8_fidelity_test.exs (37 cases).
; Every describe/test case is carried here, one `deftest` each, named by
; kebab-casing the ExUnit title and grouped by the same `describe` blocks so
; the mapping is structural: each group comment below names its source suite
; and describe, and the deftest names appear in source order.
;
; Coverage (assertion parity — no case dropped, no assertion dropped):
;   wave6_errors_test.exs    18 tests / 22 assertions → 18 deftests / 22 `is`
;   wave7_refs_test.exs      20 tests / 37 assertions → 20 deftests / 37 `is`
;   wave8_fidelity_test.exs  37 tests / 48 assertions → 37 deftests / 48 `is`
;   total                    75 tests /107 assertions → 75 deftests /107 `is`
;
; Fidelity notes
;   · Setup. The ExUnit `setup` ran `BeamLisp.init()` then
;     `BeamLisp.Env.in_ns("user")`, and `eval/1` = `BeamLisp.eval/1` then
;     evaluated in whatever ns was current. `run_suite/2` initializes the
;     runtime itself, and `ev` binds `user` around every source eval
;     (`Env/with_ns`), so each form runs in the same home ns the ExUnit helper
;     saw — including the wave8 meta/doc lookups that name `"user"`.
;   · Sources are kept VERBATIM. `ev` evaluates the original source string and
;     the assertions are the ExUnit `assert eval(...) == …` comparisons, so a
;     runtime regression fails here exactly as it failed there.
;   · assert_raise → TYPED catch. `BeamLisp.CompileError`, `ArgumentError`,
;     `ArithmeticError` and `BeamLisp.Reader.SyntaxError` are caught by a typed
;     `catch`; where ExUnit matched `~r/…/` the message is checked with
;     `includes?` on the same substring.
;   · assert_received → a real receive. The ExUnit `finally` cases pre-sent the
;     marker with `self_send` and then called `assert_received`, which matches
;     the PRE-sent copy — so the assertion held even if the eval never sent.
;     Here the marker is received from the eval itself (the same feature, now
;     actually asserted): `w6-ran`, `w6-caught`, `w6-discard`, `w6-first`.
;   · capture_io → the StringIO group-leader helper the other `.bl` suites use.
;
; Run: bin/bl test test/bl/legacy_wave678_test.bl

(ns legacy.wave678)

; ── helpers ────────────────────────────────────────────────────────────────

(defn- ev
  "Evaluate `src` in the `user` namespace — the port of the ExUnit helper's
   `BeamLisp.Env.in_ns(\"user\")` + `BeamLisp.eval/1`. A source that switches ns
   itself (wave7's cross-namespace case) does so inside this binding."
  [src]
  (BeamLisp.Env/with_ns "user" (fn [] (BeamLisp/eval src))))

(defn- capture-out
  "Run `f` with this process's group leader on a StringIO, returning its stdout
   as a string — the port of ExUnit's `capture_io/1`."
  [f]
  (let [prev (Process/group_leader)
        dev (erlang/element 2 (StringIO/open ""))]
    (Process/group_leader (erlang/self) dev)
    (try (f) (finally (Process/group_leader (erlang/self) prev)))
    (erlang/element 2 (StringIO/contents dev))))

; ══ wave6_errors_test.exs ══════════════════════════════════════════════════

; ── describe "throw / untyped catch" (5) ───────────────────────────────────

(deftest w6-a-thrown-ex-info-round-trips-through-ex-data
  (is (= {:code 42}
         (ev "(try (throw (ex-info \"boom\" {:code 42})) (catch e (ex-data e)))"))))

(deftest w6-ex-message-recovers-the-payload-message
  (is (= "boom"
         (ev "(try (throw (ex-info \"boom\" {:code 42})) (catch e (ex-message e)))"))))

(deftest w6-a-thrown-bare-value-is-wrapped-and-its-message-is-the-print-form
  (is (= ":plain" (ev "(ex-message (try (throw :plain) (catch e e)))"))))

(deftest w6-a-non-map-payload-has-nil-ex-data
  (is (nil? (ev "(ex-data (try (throw :plain) (catch e e)))"))))

(deftest w6-ex-data-on-a-non-exception-is-nil
  (is (nil? (ev "(ex-data 42)"))))

; ── describe "ex-info / ex-message helpers" (2) ────────────────────────────

(deftest w6-ex-info-builds-a-payload-with-data
  (is (= {:n 7} (ev "(ex-data (ex-info \"kaboom\" {:n 7}))"))))

(deftest w6-ex-message-returns-the-message
  (is (= "kaboom" (ev "(ex-message (ex-info \"kaboom\" {:n 7}))"))))

; ── describe "finally" (3) ─────────────────────────────────────────────────

(deftest w6-finally-runs-on-success-and-the-body-value-wins
  (is (= :body (ev "(try :body (finally (erlang/send (erlang/self) :w6-ran)))")))
  (is (receive :w6-ran true (after 1000 false)) "finally ran on success"))

(deftest w6-finally-runs-on-a-caught-raise
  (is (= :caught
         (ev "(try (throw :x) (catch e :caught) (finally (erlang/send (erlang/self) :w6-caught)))")))
  (is (receive :w6-caught true (after 1000 false)) "finally ran on a caught raise"))

(deftest w6-finallys-value-is-discarded
  (is (= :body
         (ev "(try :body (finally (do (erlang/send (erlang/self) :w6-discard) :discarded)))")))
  (is (receive :w6-discard true (after 1000 false)) "finally ran and its value was discarded"))

; ── describe "typed catch" (2) ─────────────────────────────────────────────

(deftest w6-typed-catch-matches-only-its-struct
  (is (= :matched
         (ev "(try (throw (ex-info \"boom\" {:code 42})) (catch BeamLisp.ExInfo e :matched))"))))

(deftest w6-a-different-exception-falls-through-and-re-raises
  (is (try
        (do (ev "(try (/ 1 0) (catch BeamLisp.ExInfo e :matched))") false)
        (catch ArithmeticError e true))))

; ── describe "raw Erlang errors" (2) ───────────────────────────────────────

(deftest w6-an-arithmetic-error-is-caught-and-normalized-to-a-struct
  (is (= "bad argument in arithmetic expression"
         (ev "(try (/ 1 0) (catch e (ex-message e)))"))))

(deftest w6-ex-data-on-a-non-ex-info-error-is-nil
  (is (nil? (ev "(try (/ 1 0) (catch e (ex-data e)))"))))

; ── describe "structure" (3) ───────────────────────────────────────────────

(deftest w6-nested-try-inner-catch-wins
  (is (= :inner-caught
         (ev "(try (try (throw :inner) (catch e :inner-caught)) (catch e :outer-caught))"))))

(deftest w6-first-matching-clause-wins
  (is (= :a
         (ev "(try (throw :x) (catch e (erlang/send (erlang/self) :w6-first) :a) (catch e :b))")))
  (is (receive :w6-first true (after 1000 false)) "the first clause ran"))

(deftest w6-try-value-semantics-bare-try-is-its-body
  (is (= 42 (ev "(try 42)"))))

; ── describe "compile errors" (1) ──────────────────────────────────────────

(deftest w6-a-catch-whose-first-arg-is-not-a-symbol-is-a-compile-error
  (is (try
        (do (ev "(try :x (catch :bad e :h))") false)
        (catch BeamLisp.CompileError e
          (includes? (str (ex-message e)) "catch requires a variable or Module.Name")))))

; ══ wave7_refs_test.exs ════════════════════════════════════════════════════

; ── describe "atoms" (6) ───────────────────────────────────────────────────

(deftest w7-create-and-deref
  (is (= 42 (ev "(deref (atom 42))"))))

(deftest w7-at-reader-sugar-reads-as-deref-x
  (ev "(def w7-a (atom 5))")
  (is (= 5 (ev "@w7-a")))
  (is (= 5 (ev "(deref w7-a)")))
  (is (= 5 (ev "@ w7-a"))))

(deftest w7-swap-with-extra-args-via-plus
  (ev "(def w7-a (atom 10))")
  (is (= 13 (ev "(swap! w7-a + 1 2)")))
  (is (= 13 (ev "@w7-a")))
  (is (= 18 (ev "(swap! w7-a + 5)"))))

(deftest w7-swap-with-a-user-defn
  (ev "(defn w7-acc [total x] (+ total x))")
  (ev "(def w7-a (atom 100))")
  (is (= 105 (ev "(swap! w7-a w7-acc 5)")))
  (is (= 105 (ev "@w7-a"))))

(deftest w7-reset
  (ev "(def w7-a (atom 1))")
  (is (= 99 (ev "(reset! w7-a 99)")))
  (is (= 99 (ev "@w7-a"))))

(deftest w7-compare-and-set-succeeds-on-match-and-fails-on-mismatch
  (ev "(def w7-a (atom 0))")
  (is (= true (ev "(compare-and-set! w7-a 0 1)")))
  (is (= 1 (ev "@w7-a")))
  (is (= false (ev "(compare-and-set! w7-a 0 99)")))
  (is (= 1 (ev "@w7-a"))))

; ── describe "futures" (5) ─────────────────────────────────────────────────

(deftest w7-deref-a-future-returns-its-value
  (is (= 3 (ev "(deref (future (+ 1 2)))"))))

(deftest w7-future-predicate
  (ev "(def w7-f (future 42))")
  (is (= true (ev "(future? w7-f)")))
  (is (= false (ev "(future? 42)")))
  (is (= 42 (ev "(deref w7-f)"))))

(deftest w7-deref-with-a-timeout-returns-the-timeout-value-on-a-slow-future
  ; Task.await is single-use: a timed-out await demonitors, so we assert only
  ; the timeout branch here.
  (ev "(def w7-f (future (Process/sleep 200) :slow))")
  (is (= :timeout (ev "(deref w7-f 20 :timeout)"))))

(deftest w7-future-cancel-kills-a-running-future
  (ev "(def w7-f (future (Process/sleep 500) :slow))")
  (is (= true (ev "(future-cancel w7-f)"))))

(deftest w7-future-cancel-on-an-already-completed-future-is-false
  (ev "(def w7-f (future 1))")
  (is (= 1 (ev "(deref w7-f)")))
  (is (= false (ev "(future-cancel w7-f)"))))

; ── describe "promises" (4) ────────────────────────────────────────────────

(deftest w7-deliver-then-deref
  (ev "(def w7-p (promise))")
  (is (some? (ev "(deliver w7-p 7)")))
  (is (= 7 (ev "(deref w7-p)"))))

(deftest w7-deref-with-timeout-before-deliver-returns-the-timeout-value
  (ev "(def w7-p (promise))")
  (is (= :timeout (ev "(deref w7-p 30 :timeout)")))
  (ev "(deliver w7-p :later)")
  (is (= :later (ev "(deref w7-p)"))))

(deftest w7-at-on-a-delivered-promise
  (ev "(def w7-p (promise))")
  (ev "(deliver w7-p 9)")
  (is (= 9 (ev "@w7-p"))))

(deftest w7-a-promise-is-delivered-only-once
  (ev "(def w7-p (promise))")
  (is (some? (ev "(deliver w7-p 1)")))
  (is (nil? (ev "(deliver w7-p 2)")))
  (is (= 1 (ev "@w7-p"))))

; ── describe "reader" (2) ──────────────────────────────────────────────────

(deftest w7-at-alone-or-with-only-whitespace-is-a-reader-error
  (is (try
        (do (BeamLisp.Reader/read_all "@") false)
        (catch BeamLisp.Reader.SyntaxError e true)))
  (is (try
        (do (BeamLisp.Reader/read_all "@   ") false)
        (catch BeamLisp.Reader.SyntaxError e true))))

(deftest w7-at-inside-a-string-literal-is-untouched
  (is (= "@a" (ev "\"@a\""))))

; ── describe "errors and cross-namespace" (3) ──────────────────────────────

(deftest w7-deref-on-a-non-reference-raises
  (is (try
        (do (ev "(deref 42)") false)
        (catch ArgumentError e true))))

(deftest w7-swap-on-a-non-reference-raises
  (is (try
        (do (ev "(swap! 42 + 1)") false)
        (catch ArgumentError e true))))

(deftest w7-future-works-in-any-namespace
  (is (= 42 (ev "(ns w7.other) (deref (future (* 6 7)))"))))

; ══ wave8_fidelity_test.exs ════════════════════════════════════════════════

; ── describe "docstrings" (13) ─────────────────────────────────────────────

(deftest w8-defn-with-a-docstring-records-it-as-metadata
  (ev "(defn w8-fn \"Squares a number.\" [n] (* n n))")
  (is (= (tuple :ok {:doc "Squares a number."})
         (BeamLisp.Env/meta "user" "w8-fn"))))

(deftest w8-defn-without-a-docstring-records-no-metadata
  (ev "(defn w8-nodoc [x] x)")
  (is (= :error (BeamLisp.Env/meta "user" "w8-nodoc"))))

(deftest w8-defn-with-a-docstring-still-returns-the-fn-value
  (let [f (ev "(defn w8-v \"doc\" [x] (* 2 x))")]
    (is (fn? f))
    (is (= 42 (apply f (list 21))))
    (is (= 10 (ev "(w8-v 5)")))))

(deftest w8-def-with-a-docstring-records-it-and-returns-the-value
  (is (= 42 (ev "(def w8-const \"A constant.\" 42)")))
  (is (= (tuple :ok {:doc "A constant."})
         (BeamLisp.Env/meta "user" "w8-const"))))

(deftest w8-defmacro-with-a-docstring-records-it-and-still-expands
  (ev "(defmacro w8-m \"Returns its first body form.\" [& body] (first body))")
  (is (= (tuple :ok {:doc "Returns its first body form."})
         (BeamLisp.Env/meta "user" "w8-m")))
  (is (= 1 (ev "(w8-m 1 2 3)"))))

(deftest w8-redefining-a-var-with-a-new-docstring-latest-wins
  (ev "(defn w8-redef \"first doc\" [x] x)")
  (is (= (tuple :ok {:doc "first doc"}) (BeamLisp.Env/meta "user" "w8-redef")))
  (ev "(defn w8-redef \"second doc\" [x] x)")
  (is (= (tuple :ok {:doc "second doc"}) (BeamLisp.Env/meta "user" "w8-redef"))))

(deftest w8-defn-with-no-clauses-is-a-compile-error
  (is (try
        (do (ev "(defn w8-empty)") false)
        (catch BeamLisp.CompileError e
          (includes? (str (ex-message e)) "expected at least one parameter vector")))))

(deftest w8-a-lone-string-in-defn-is-an-error
  (is (try
        (do (ev "(defn w8-lone \"just a string\")") false)
        (catch BeamLisp.CompileError e
          (includes? (str (ex-message e)) "expected a parameter vector, got a string literal")))))

(deftest w8-doc-string-resolves-a-quoted-symbol-a-string-and-a-missing-var
  (ev "(defn w8-greet \"Says hi.\" [n] (str \"hi \" n))")
  (is (= {:ns "user" :name "w8-greet" :doc "Says hi."}
         (BeamLisp.Env/doc_string "user" (tuple :symbol "w8-greet"))))
  (is (= {:ns "user" :name "w8-greet" :doc "Says hi."}
         (BeamLisp.Env/doc_string "user" "w8-greet")))
  (is (nil? (BeamLisp.Env/doc_string "user" (tuple :symbol "nope")))))

(deftest w8-doc-string-resolves-a-var-with-no-docstring-to-nil
  (ev "(defn w8-plain [x] x)")
  (is (nil? (BeamLisp.Env/doc_string "user" "w8-plain"))))

(deftest w8-doc-prints-a-vars-docstring-in-clojures-shape
  (ev "(defn w8-doc \"Squares n.\" [n] (* n n))")
  (let [out (capture-out (fn [] (ev "(doc (quote w8-doc))")))]
    (is (includes? out "-------------------------"))
    (is (includes? out "user/w8-doc"))
    (is (includes? out "Squares n."))))

(deftest w8-doc-resolves-a-core-fn-through-the-core-fallback
  (let [out (capture-out (fn [] (ev "(doc (quote zipmap))")))]
    (is (includes? out "core/zipmap"))
    (is (includes? out "Builds a map from parallel keys and values."))))

(deftest w8-doc-on-a-var-without-a-docstring-prints-a-friendly-message
  (ev "(defn w8-nd [x] x)")
  (let [out (capture-out (fn [] (ev "(doc (quote w8-nd))")))]
    (is (includes? out "No doc found"))))

; ── describe "map destructuring in let" (16) ───────────────────────────────

(deftest w8-keys-binds-keyword-keys-by-local-name
  (is (= 3 (ev "(let [{:keys [a b]} {:a 1 :b 2}] (+ a b))"))))

(deftest w8-keys-with-a-kebab-name-binds-the-local-verbatim
  (is (= 5 (ev "(let [{:keys [b-c]} {:b-c 5}] b-c)"))))

(deftest w8-strs-binds-string-keys
  (is (= "hiyo" (ev "(let [{:strs [s t]} {\"s\" \"hi\" \"t\" \"yo\"}] (str s t))"))))

(deftest w8-as-binds-the-whole-map
  (is (= 2 (ev "(let [{:keys [a] :as whole} {:a 1 :b 2}] (get whole :b nil))"))))

(deftest w8-or-supplies-a-default-when-a-key-is-absent
  (is (= (BeamLisp.Vector/new (list 1 20))
         (ev "(let [{:keys [a b] :or {a 10 b 20}} {:a 1}] [a b])"))))

(deftest w8-or-keeps-a-present-nil
  (is (nil? (ev "(let [{:keys [a] :or {a 99}} {:a nil}] a)"))))

(deftest w8-general-form-local-key-binds-from-a-keyword-key
  (is (= 3 (ev "(let [{x :x, y :y} {:x 1 :y 2}] (+ x y))"))))

(deftest w8-general-form-with-a-string-key
  (is (= 7 (ev "(let [{x \"x\"} {\"x\" 7}] x)"))))

(deftest w8-established-key-local-spelling-still-works
  (is (= 3 (ev "(let [{:x x :y y} {:x 1 :y 2}] (+ x y))"))))

(deftest w8-missing-keys-bind-nil
  (is (= (BeamLisp.Vector/new (list 1 nil))
         (ev "(let [{:keys [a b]} {:a 1}] [a b])"))))

(deftest w8-extra-keys-are-ignored
  (is (= 1 (ev "(let [{:keys [a]} {:a 1 :zz 2}] a)"))))

(deftest w8-destructuring-nil-binds-everything-nil
  (is (= (BeamLisp.Vector/new (list nil nil))
         (ev "(let [{:keys [a b]} nil] [a b])"))))

(deftest w8-nested-vector-pattern-inside-a-map-pattern
  (is (= 3 (ev "(let [{[a b] :pair} {:pair [1 2]}] (+ a b))"))))

(deftest w8-nested-map-pattern-inside-a-vector-pattern
  (is (= 3 (ev "(let [[{:keys [a]} {b :b}] [{:a 1} {:b 2}]] (+ a b))"))))

(deftest w8-nested-map-pattern-inside-a-map-pattern
  (is (= 9 (ev "(let [{{:keys [x]} :inner} {:inner {:x 9}}] x)"))))

(deftest w8-a-keys-bind-and-a-nested-bind-share-one-map-pattern
  (is (= "8080true"
         (ev (str "(let [{:keys [port] {:keys [enabled]} :tls}"
                  " {:port 8080 :tls {:enabled true}}] (str port enabled))")))))

; ── describe "map destructuring in fn and defn params" (6) ─────────────────

(deftest w8-fn-params-destructure-a-map
  (is (= 3 (ev "((fn [{:keys [a b]}] (+ a b)) {:a 1 :b 2})"))))

(deftest w8-defn-params-destructure-a-map
  (ev "(defn w8-p [{:keys [a b] :or {b 10}}] (+ a b))")
  (is (= 11 (ev "(w8-p {:a 1})")))
  (is (= 3 (ev "(w8-p {:a 1 :b 2})"))))

(deftest w8-defn-params-destructure-via-a-linked-call
  (ev "(defn w8-pair [{:keys [x]} {y :y}] (+ x y))")
  (is (= 3 (ev "(w8-pair {:x 1} {:y 2})"))))

(deftest w8-defn-param-missing-keys-bind-nil
  (ev "(defn w8-missing [{:keys [a b]}] (str a \"-\" b))")
  (is (= "1-" (ev "(w8-missing {:a 1})"))))

(deftest w8-defn-param-that-is-nil-binds-everything-nil
  (ev "(defn w8-nilparam [{:keys [a]}] a)")
  (is (nil? (ev "(w8-nilparam nil)"))))

(deftest w8-nested-destructuring-in-defn-params
  (ev "(defn w8-nest [{:keys [cfg]} {[x y] :pt}] (str cfg x y))")
  (is (= "123" (ev "(w8-nest {:cfg 1} {:pt [2 3]})"))))

; ── describe "map destructuring in loop bindings" (2) ──────────────────────

(deftest w8-loop-bindings-destructure-a-map-at-entry
  (is (= 5 (ev "(loop [{:keys [a] :or {a 5}} {}] a)"))))

(deftest w8-recur-re-supplies-the-pattern-values
  (is (= :x
         (ev "(loop [i 3 {:keys [tag]} {:tag :x}] (if (= i 0) tag (recur (dec i) {:tag :x})))"))))

(run-tests)
