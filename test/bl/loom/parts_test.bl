; test/bl/loom/parts_test.bl — the shared parts render what they say.
;
; The ns form comes FIRST: `bl test` finds a file's namespace with
; `Loader/declared_ns`, which reads the first form — so the legacy
; `(BeamLisp.Compiler/eval_string …)` preamble this file used to carry made it
; INCOHERENT ("test file declares no (ns …) form") and its assertions never ran
; at all. Nothing here needed it: `bl test` preloads priv/std/test.bl, so
; `deftest`/`is` are available in every test file.

(ns loom.parts-test
  (:require [loom.parts :as parts] [loom.token :as t] [live.hiccup :as h]))

(t/reset-sheet!)

(defn- html [x] (h/hiccup->html x))

(deftest table-vector-rows
  (let [s (html (parts/table {:columns ["A" "B"] :rows [["1" "2"]]}))]
    (is (String/contains? s "<th"))
    (is (String/contains? s ">1<"))))

(deftest table-map-rows-keyed-sortable-clickable
  (let [s (html (parts/table {:columns [{:key :name :label "Nom"} {:key :n :label "N" :align "right" :render (fn [r] (str (:n r) "×"))}]
                              :rows [{:name "x" :n 3}]
                              :row-key :name
                              :on-row (fn [r] [:navigate (str "/x/" (:name r))])
                              :sort {:col :name :dir :asc :on-sort (fn [k d] [:assign :sort {:col k :dir d}])}}))]
    (is (String/contains? s "3×"))
    (is (String/contains? s "aria-sort=\"ascending\""))
    (is (String/contains? s "Nom ▲"))
    (is (String/contains? s "cursor:pointer"))))

; ── drawer: a dialog when the caller gave it a way out (FUP-035) ────────
;
; The trap was a full-viewport layer with NO close: the page's pointer events
; went to the layer and there was nothing to click, press or type. The contract
; is one option — `:on-close` — and every route to it: the ✕, the scrim, Escape.

(deftest drawer-with-a-close-is-a-dialog
  (let [s (html (parts/drawer {:id "notifs" :open true :side :right
                               :on-close [:assign :bell-open nil]}
                              [:p "corps"]))]
    (is (String/contains? s "data-drawer=\"notifs\""))
    (is (String/contains? s "close-notifs") "a ✕ exists")
    (is (String/contains? s "data-ev-click") "the scrim closes too")
    (is (String/contains? s "data-ev-keydown.escape") "…and Escape is wired")
    (is (String/contains? s "aria-modal=\"true\""))
    (is (String/contains? s "corps") "the body renders")))

(deftest drawer-without-a-close-is-honest
  ;; no :on-close ⇒ a static panel: no ✕, no handler, nothing that pretends to
  ;; be an affordance. Callers that want a dialog say so.
  (let [s (html (parts/drawer {:id "static" :open true} [:p "x"]))]
    (is (String/contains? s "data-drawer=\"static\""))
    (is (not (String/contains? s "data-ev-click")))
    (is (not (String/contains? s "close-static")))
    (is (String/contains? s "aria-modal=\"false\""))))

(deftest table-empty
  (is (String/contains? (html (parts/table {:columns ["A"] :rows [] :empty "Rien."})) "Rien.")))

(deftest progress-captioned
  (let [s (html (parts/progress {:value 62 :max 100 :label "62 / 100" :caption "62%" :tone :danger}))]
    (is (String/contains? s "role=\"progressbar\""))
    (is (String/contains? s "aria-valuenow=\"62\""))
    (is (String/contains? s "width:62%"))
    (is (String/contains? s "62 / 100"))))

(deftest progress-bare
  (let [s (html (parts/progress {:value 1 :max 4}))]
    (is (String/contains? s "width:25%"))))

(deftest events-keyed-who-when-what
  (let [s (html (parts/events {:items [{:key "t1" :who "Rachid" :role "conducteur" :when "J1 · 9h15" :what "a démarré X" :tone :success :meta "kiosk:sm74"}]}))]
    (is (String/contains? s "role=\"list\""))
    (is (String/contains? s "Rachid"))
    (is (String/contains? s "kiosk:sm74"))
    (is (String/contains? s "J1 · 9h15"))))

(deftest events-empty
  (is (String/contains? (html (parts/events {:items [] :empty "Rien."})) "Rien.")))

; ── tabs: URL-addressed link tabs vs the original button tabs ───────────
;
; Adding :href to ANY item flips the part to a <nav> of links; with no :href
; anywhere the render is byte-identical to the original button tablist.

(defn- occurrences [s sub]
  (loop [rest-s s n 0]
    (let [j (index-of rest-s sub)]
      (if (nil? j)
        n
        (recur (subs rest-s (+ j (count sub)) (count rest-s)) (inc n))))))

(deftest tabs-links-nav-aria-current-only-on-active
  (let [s (html (parts/tabs {:active :audit :label "Sections"
                             :tabs [{:id :audit :label "Audit" :href "/audit"}
                                    {:id :traces :label "Traces" :href "/traces"}]}))]
    (is (String/contains? s "<nav"))
    (is (String/contains? s "aria-label=\"Sections\""))
    (is (= 1 (occurrences s "aria-current=\"page\"")) "only the active link")
    (is (String/contains? s "href=\"/audit\""))
    (is (String/contains? s ">Audit<"))))

(deftest tabs-links-nil-active-selects-nothing
  (let [s (html (parts/tabs {:tabs [{:id :a :label "A" :href "/a"}]}))]
    (is (String/contains? s "<nav"))
    (is (String/contains? s "aria-label=\"Sections\"") "default nav label")
    (is (not (String/contains? s "aria-current")))))

(deftest tabs-links-count-pill
  (let [s (html (parts/tabs {:active :a
                             :tabs [{:id :a :label "Audit" :href "/a" :count 240}]}))]
    (is (String/contains? s ">Audit<"))
    (is (String/contains? s "240"))))

(deftest tabs-links-empty-nav
  (let [s (html (parts/tabs {:active :x :tabs []}))]
    (is (String/contains? s "<nav"))
    (is (String/contains? s "</nav>"))
    (is (not (String/contains? s "<a ")))))

(deftest tabs-pills-variant-differs-from-underline
  (let [items [{:id :a :label "A" :href "/a"} {:id :b :label "B" :href "/b"}]
        u (html (parts/tabs {:active :a :tabs items}))
        p (html (parts/tabs {:active :a :variant :pills :tabs items}))]
    (is (String/contains? u "<nav"))
    (is (String/contains? p "<nav"))
    (is (not= u p) "the two variants paint differently")))

(deftest tabs-mixed-href-renders-span-for-the-hrefless
  (let [s (html (parts/tabs {:active :a
                             :tabs [{:id :a :label "A" :href "/a"}
                                    {:id :b :label "B"}]}))]
    (is (String/contains? s "<a "))
    (is (String/contains? s "aria-disabled=\"true\""))))

(deftest tabs-buttons-unchanged
  (let [s (html (parts/tabs {:active :b
                             :tabs [{:id :a :label "A" :on-select [:navigate "/a"]}
                                    {:id :b :label "B"}]}))]
    (is (String/contains? s "role=\"tablist\""))
    (is (String/contains? s "<button"))
    (is (String/contains? s "aria-selected=\"true\""))
    (is (String/contains? s "aria-selected=\"false\""))
    (is (String/contains? s "data-ev-click"))
    (is (not (String/contains? s "<nav")))))

; ── disclosure: a native <details>, the browser owns the state ──────────

(deftest disclosure-renders-details-open-only-when-asked
  (let [closed (html (parts/disclosure {:summary "Détail"} [:p "corps"]))
        open   (html (parts/disclosure {:summary "Détail" :open true :hint "12 lignes"}
                                       [:p "corps"]))]
    (is (String/contains? closed "<details"))
    (is (String/contains? closed "<summary"))
    (is (String/contains? closed "Détail"))
    (is (String/contains? closed "corps"))
    (is (not (String/contains? closed " open")) "closed by default")
    (is (String/contains? open " open") "open when asked")
    (is (String/contains? open "12 lignes"))))

; ── facts: compact key → value pairs ─────────────────────────────────────

(deftest facts-renders-dl-dt-dd-and-dash-for-nil
  (let [s (html (parts/facts {:cols 2} [["Début" "22/09/2026"]
                                        ["Graine" nil]
                                        ["Code" [:code "1326"]]]))]
    (is (String/contains? s "<dl"))
    (is (String/contains? s "<dt"))
    (is (String/contains? s "<dd"))
    (is (String/contains? s "Début"))
    (is (String/contains? s "22/09/2026"))
    (is (String/contains? s "—") "a nil value is an em dash")
    (is (String/contains? s "<code>1326</code>"))))

(deftest facts-accepts-rows-varargs
  (let [s (html (parts/facts ["Clé" "valeur"] ["Autre" "x"]))]
    (is (String/contains? s "<dl"))
    (is (String/contains? s "Clé"))
    (is (String/contains? s "valeur"))))

(run-tests)
