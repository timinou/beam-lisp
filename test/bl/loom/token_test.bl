; token_test.bl — loom.token's motion primitive: an animation is a value.
;
; Run: bl test test/bl/loom/token_test.bl
;
; `keyframes` must behave exactly like `sx`: a value in, a hashed name out, one
; rule in the per-render sheet — so equal motions collapse, the page's <style>
; carries it, and a live socket ships it with the first patch that reaches it.

(ns loom.token.test
  (:require [loom.token :as t]))

(deftest keyframes-is-a-value-hashed-to-a-name
  (t/reset-sheet!)
  (let [a (t/keyframes {:from {:opacity 0} 60 {:opacity 1}})
        b (t/keyframes {60 {:opacity 1} :from {:opacity 0}})]
    (is (= a b) "map order never changes the name")
    (is (starts-with? a "k"))
    (is (not= a (t/keyframes {:from {:opacity 0.5}})) "a different motion is a different name")))

(deftest keyframes-lands-in-the-sheet-in-stop-order
  (t/reset-sheet!)
  (let [k (t/keyframes {:to {:opacity 1} 40 {:opacity 0.2} :from {:opacity 0}})
        css (t/sheet-css)]
    (is (includes? css (str "@keyframes " k "{0%{opacity:0}40%{opacity:0.2}100%{opacity:1}}")))
    (is (= 1 (count (filter (fn [c] (= c k)) (t/sheet-classes)))) "registered once")))

(deftest a-live-socket-can-ship-it
  ;; live.socket ships `css-for` of the names a render reached that the client
  ;; has not seen — a keyframes name must be one of them
  (t/reset-sheet!)
  (let [k (t/keyframes {:from {:transform "scale(0)"}})]
    (is (contains? (t/sheet-classes) k))
    (is (includes? (t/css-for #{k}) "@keyframes"))))

(deftest a-stop-that-is-not-a-stop-fails-loud
  (is (= :threw (try (t/keyframes {"40%" {:opacity 1}}) (catch _ :threw)))))

;; ── realize: an empty child group is nil, never `()` (FUP-123 Finding E) ──
(deftest realize-empty-for-is-nil
  (is (= [:div nil [:p "x"]] (t/realize [:div (for [x []] x) [:p "x"]])))
  (is (= [:ul (list [:li "a"])] (t/realize [:ul (for [x ["a"]] [:li x])])))
  (is (seq? (second (t/realize [:ul (for [x ["a"]] [:li x])])))))

(deftest cached-declarations-still-register-in-every-new-sheet
  (let [style {:color "#123456" :display "grid" :gap "12px"}
        a (t/sx style)]
    (t/reset-sheet!)
    (let [b (t/sx style)]
      (is (= a b))
      (is (contains? (t/sheet-classes) b))
      (is (includes? (t/sheet-css) "color:#123456")))))

(deftest style-value-cache-never-hides-a-theme-change
  (let [before (t/theme)]
    (try
      (t/install-theme! {:color {:accent "#111111"} :screen {:md "700px"}})
      (let [a (t/sx* {:base {:color (t/color :accent)} :at {:md {:display "grid"}}})]
        (t/install-theme! {:color {:accent "#222222"} :screen {:md "900px"}})
        (t/reset-sheet!)
        (let [b (t/sx* {:base {:color (t/color :accent)} :at {:md {:display "grid"}}})
              css (t/sheet-css)]
          (is (not= a b))
          (is (includes? css "color:#222222"))
          (is (includes? css "min-width:900px"))
          (is (not (includes? css "700px")))))
      (finally (t/install-theme! before)))))

(deftest style-cache-is-bounded-under-unique-declarations
  (doseq [n (range 1100)] (t/style->css {:left (str n "px")}))
  (is (<= (count (Process/get :loom.token/style-cache)) 512)))

(deftest canonical-declarations-do-not-depend-on-authoring-order
  (is (= (t/style->css (assoc {} :z-index 3 :color "red" :padding "8px"))
         (t/style->css (assoc {} :padding "8px" :color "red" :z-index 3)))))
