; catalog_test.bl — the self-cataloging engine: source → facts → datalog.
;
; Run: mix beam_lisp.test --path priv test/bl/loom/catalog_test.bl
;
; Proves the whole pipeline against a controlled fixture (test/fixtures/catalog):
;   - a defn with ^:catalog becomes a catalogued entry with its metadata intact
;   - a defn without ^:catalog is still recorded (coverage)
;   - every query returns the right rows (groups, entries-in, by-tag, counts)
;   - a missing group returns EMPTY, not an error
;   - the live example resolves and renders (the fn is callable by ns+name)

(ns loom.catalog.test
  (:require [tooling.catalog :as cat]
            [live.hiccup :as h]))

;; index the fixture once; every test reads this db.
(def db (cat/index-dir "test/fixtures/catalog"))

;; ── extraction ──────────────────────────────────────────────────────

(deftest groups-are-discovered
  (is (= ["Alpha" "Beta"] (into [] (cat/groups db)))))

(deftest entries-in-a-group
  (let [es (cat/entries-in db "Alpha")]
    (is (= 2 (count es)))
    ; ordered by source line → First before Second
    (is (= "First" (:title (first es))))
    (is (= "Second" (:title (second es))))
    ; metadata round-trips
    (is (= "demo-one" (:name (first es))))
    (is (= "The first demo." (:doc (first es))))
    (is (= "fixture.catalog.demo" (:ns (first es))))))

(deftest a-single-group-in-isolation
  (let [es (cat/entries-in db "Beta")]
    (is (= 1 (count es)))
    (is (= "Third" (:title (first es))))))

(deftest a-missing-group-is-empty-not-an-error
  (is (= [] (cat/entries-in db "Nonexistent"))))

;; ── tags ────────────────────────────────────────────────────────────

(deftest entries-by-tag
  ; :x is on demo-one and demo-three; :y only on demo-one
  (is (= ["demo-one" "demo-three"] (into [] (cat/entries-by-tag db :x))))
  (is (= ["demo-one"] (into [] (cat/entries-by-tag db :y)))))

(deftest a-missing-tag-is-empty
  (is (= [] (into [] (cat/entries-by-tag db :nope)))))

;; ── counts (the nav badges) ─────────────────────────────────────────

(deftest group-counts
  (is (= 2 (cat/count-in-group db "Alpha")))
  (is (= 1 (cat/count-in-group db "Beta")))
  (is (= 0 (cat/count-in-group db "Nonexistent"))))

;; ── coverage: un-catalogued defns ───────────────────────────────────

(deftest uncatalogued-are-recorded
  ; helper-fn has no ^:catalog → it is the coverage report's content
  (is (includes-str? (cat/uncatalogued db) "helper-fn")))

(deftest catalogued-set-is-exactly-the-tagged-defns
  (is (= ["demo-one" "demo-three" "demo-two"] (into [] (sort (cat/all-catalogued db))))))

;; ── the live example resolves and renders ───────────────────────────

(deftest an-entry-renders-its-live-example
  (let [e (first (cat/entries-in db "Alpha"))
        node (cat/render-example e)
        html (h/hiccup->html node)]
    ; demo-one is a primary button → real, styled markup
    (is (includes? html "<button"))
    (is (includes? html "One"))))

(deftest every-catalogued-entry-renders-without-error
  ; the whole catalog must be renderable — no entry blows up the page
  (doseq [g (cat/groups db)]
    (doseq [e (cat/entries-in db g)]
      (let [html (h/hiccup->html (cat/render-example e))]
        (is (> (count html) 0) (str (:name e) " renders non-empty"))))))

;; ── helper: membership over a seq of strings ────────────────────────

(defn- includes-str? [xs s] (contains? (set (into [] xs)) s))
