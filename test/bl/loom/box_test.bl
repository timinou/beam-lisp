; box_test.bl — the layout algebra, pressure-tested across many configurations.
;
; Run: mix beam_lisp.test --path priv test/bl/loom/box_test.bl
;
; Two things are proven here:
;   1. COVERAGE   — every axis of the layout space maps to the right CSS, and
;                   the common arrangements (col/row/wrap/grid/center/split/
;                   responsive) all fall out of ONE primitive.
;   2. NO CEILING — the escape hatches hold: a raw value anywhere, a `:style`
;                   override that wins, arbitrary attrs forwarded. A beam-lisp
;                   app can always go past what the vocabulary anticipated.

(ns loom.box.test
  (:require [loom.box :as b]
            [loom.token :as t]))

;; a render helper: fresh sheet, return [class-attr collected-css]
(defn- render [node]
  (t/reset-sheet!)
  ;; force the node to register its class, then read the sheet
  (let [cls (get (second node) :class)]
    [cls (t/sheet-css)]))

(defn- css-of [node]
  ;; the CSS text of the (single) class this box produced
  (t/reset-sheet!)
  (second node)                     ; realise attrs (class already registered at build)
  (t/sheet-css))

;; Because `box` registers its class at BUILD time (when `t/sx` runs), we must
;; build under a fresh sheet and read immediately. This helper does both.
(defn- build-css [thunk]
  (t/reset-sheet!)
  (let [node (thunk)
        css (t/sheet-css)]
    {:node node :class (get (second node) :class) :css css}))

;; ════════════════════════════════════════════════════════════════════
;; COVERAGE — each axis lands the right CSS
;; ════════════════════════════════════════════════════════════════════

(deftest direction-maps
  (is (includes? (:css (build-css (fn [] (b/box {:dir :col})))) "flex-direction:column"))
  (is (includes? (:css (build-css (fn [] (b/box {:dir :row})))) "flex-direction:row"))
  (is (includes? (:css (build-css (fn [] (b/box {:dir :row-reverse})))) "flex-direction:row-reverse")))

(deftest gap-takes-a-token
  (is (includes? (:css (build-css (fn [] (b/box {:gap :4})))) "gap:16px")))

(deftest align-and-justify-map-to-flex-keywords
  (let [css (:css (build-css (fn [] (b/box {:align :center :justify :between}))))]
    (is (includes? css "align-items:center"))
    (is (includes? css "justify-content:space-between"))))

(deftest wrap-and-grow
  (is (includes? (:css (build-css (fn [] (b/box {:wrap true})))) "flex-wrap:wrap"))
  (is (includes? (:css (build-css (fn [] (b/box {:grow 1})))) "flex-grow:1")))

(deftest padding-scalar-pair-and-quad
  (is (includes? (:css (build-css (fn [] (b/box {:pad :5})))) "padding:24px"))
  (is (includes? (:css (build-css (fn [] (b/box {:pad [:2 :4]})))) "padding:8px 16px"))
  (is (includes? (:css (build-css (fn [] (b/box {:pad [:1 :2 :3 :4]})))) "padding:4px 8px 12px 16px")))

(deftest dimensions-full-and-screen
  (is (includes? (:css (build-css (fn [] (b/box {:w :full})))) "width:100%"))
  (is (includes? (:css (build-css (fn [] (b/box {:h :screen})))) "height:100vh"))
  (is (includes? (:css (build-css (fn [] (b/box {:max-w "560px"})))) "max-width:560px")))

;; ── grid: equal columns, auto-fit, and a raw template ──

(deftest grid-equal-columns
  (is (includes? (:css (build-css (fn [] (b/box {:grid 3}))))
                 "grid-template-columns:repeat(3,minmax(0,1fr))")))

(deftest grid-auto-fit-uses-min-col
  (let [css (:css (build-css (fn [] (b/box {:grid :auto-fit :min-col 200}))))]
    (is (includes? css "display:grid"))
    (is (includes? css "repeat(auto-fit,minmax(200px,1fr))"))))

(deftest grid-raw-template-passes-through
  (is (includes? (:css (build-css (fn [] (b/box {:grid "1fr 2fr"}))))
                 "grid-template-columns:1fr 2fr")))

;; ── skin passthroughs ──

(deftest skin-bg-radius-shadow-border
  (let [css (:css (build-css (fn [] (b/box {:bg :surface :radius :lg :shadow :md :border true}))))]
    (is (includes? css "background:#151719"))
    (is (includes? css "border-radius:14px"))
    (is (includes? css "box-shadow:"))
    (is (includes? css "border:1px solid #2a2e33"))))

;; ════════════════════════════════════════════════════════════════════
;; NO CEILING — the escape hatches
;; ════════════════════════════════════════════════════════════════════

(deftest raw-length-anywhere
  ; a number → px, a raw string → verbatim: the scale is never a fence
  (is (includes? (:css (build-css (fn [] (b/box {:gap 13})))) "gap:13px"))
  (is (includes? (:css (build-css (fn [] (b/box {:gap "1.5rem"})))) "gap:1.5rem"))
  (is (includes? (:css (build-css (fn [] (b/box {:w "clamp(320px,50vw,640px)"}))))
                 "width:clamp(320px,50vw,640px)")))

(deftest raw-colour-anywhere
  (is (includes? (:css (build-css (fn [] (b/box {:bg "#abcdef"})))) "background:#abcdef")))

(deftest style-escape-hatch-wins
  ; :style is merged LAST — it overrides any prop the algebra computed
  (let [css (:css (build-css (fn [] (b/box {:bg :surface :style {:background "hotpink"}}))))]
    (is (includes? css "background:hotpink"))
    (is (not (includes? css "background:#151719")))))

(deftest style-can-say-what-props-cannot
  ; a property with no box axis at all still ships, via :style
  (is (includes? (:css (build-css (fn [] (b/box {:style {:backdrop-filter "blur(8px)"}}))))
                 "backdrop-filter:blur(8px)")))

(deftest arbitrary-attrs-forward-to-the-element
  ; non-layout keys reach the DOM node untouched (events, ids, data-*)
  (let [node (b/box {:gap :2 :id "hero" :on-click [:intent :go {}] :data-role "banner"} "x")]
    (is (= :div (first node)))
    (is (= "hero" (get (second node) :id)))
    (is (= [:intent :go {}] (get (second node) :on-click)))
    (is (= "banner" (get (second node) :data-role)))))

(deftest author-class-is-appended-not-replaced
  ; a caller's own class rides alongside the generated one
  (let [node (b/box {:gap :2 :class "custom"} "x")
        cls (get (second node) :class)]
    (is (includes? cls "custom"))
    (is (includes? cls "s"))))

(deftest as-picks-the-tag
  (is (= :section (first (b/box {:as :section} "x"))))
  (is (= :ul (first (b/box {:as :ul}))))
  (is (= :div (first (b/box {})))))

;; ════════════════════════════════════════════════════════════════════
;; RESPONSIVE — `:at` produces cascading media queries
;; ════════════════════════════════════════════════════════════════════

(deftest at-emits-a-media-query
  (let [css (:css (build-css (fn [] (b/box {:dir :col :at {:md {:dir :row}}}))))]
    (is (includes? css "flex-direction:column"))          ; base
    (is (includes? css "@media (min-width:768px)"))        ; the breakpoint
    (is (includes? css "flex-direction:row"))))            ; the override

(deftest at-cascades-small-to-large-regardless-of-order
  ; declare lg before md; the rendered media blocks must still be md then lg
  (let [css (:css (build-css (fn [] (b/box {:at {:lg {:gap :6} :md {:gap :4}}}))))
        md-i (index-of css "min-width:768px")
        lg-i (index-of css "min-width:1024px")]
    (is (and (>= md-i 0) (>= lg-i 0)))
    (is (< md-i lg-i) "md media block precedes lg so the wider rule wins the cascade")))

(deftest at-takes-a-raw-breakpoint
  (is (includes? (:css (build-css (fn [] (b/box {:at {"900px" {:gap :2}}}))))
                 "@media (min-width:900px)")))

;; ════════════════════════════════════════════════════════════════════
;; STATEFUL — `:on` produces pseudo-class rules
;; ════════════════════════════════════════════════════════════════════

(deftest on-hover-emits-a-pseudo-rule
  (let [css (:css (build-css (fn [] (b/box {:bg :surface :on {:hover {:background (t/color :surface-2)}}}))))]
    (is (includes? css ":hover{"))
    (is (includes? css "background:#1e2124"))))

;; ════════════════════════════════════════════════════════════════════
;; DEDUP — identical layouts collapse to one class and one rule
;; ════════════════════════════════════════════════════════════════════

(deftest identical-boxes-share-a-class
  (t/reset-sheet!)
  (let [a (b/box {:dir :row :gap :3 :align :center})
        b (b/box {:align :center :gap :3 :dir :row})]   ; different order, same content
    (is (= (get (second a) :class) (get (second b) :class))
        "content-addressed: key order does not matter")))

(deftest different-boxes-differ
  (t/reset-sheet!)
  (is (not= (get (second (b/box {:gap :3})) :class)
            (get (second (b/box {:gap :4})) :class))))

(deftest sheet-collapses-duplicates
  (t/reset-sheet!)
  (b/box {:gap :3})
  (b/box {:gap :3})           ; same → one rule
  (b/box {:gap :4})           ; different → a second
  (is (= 2 (count (split (t/sheet-css) "\n")))))

;; ════════════════════════════════════════════════════════════════════
;; COMPOSED ARRANGEMENTS — the common points, as one-liners
;; ════════════════════════════════════════════════════════════════════

(deftest named-arrangements-are-points-in-the-space
  ; col/row/wrap/grid/center add nothing box can't do — they're named defaults
  (is (includes? (:css (build-css (fn [] (b/col)))) "flex-direction:column"))
  (is (includes? (:css (build-css (fn [] (b/row)))) "flex-direction:row"))
  (is (includes? (:css (build-css (fn [] (b/wrap)))) "flex-wrap:wrap"))
  (is (includes? (:css (build-css (fn [] (b/center)))) "justify-content:center"))
  (is (includes? (:css (build-css (fn [] (b/grid)))) "display:grid")))

(deftest named-arrangement-overrides-still-work
  ; a named default is just a starting point — override any axis
  (is (includes? (:css (build-css (fn [] (b/col {:gap :6})))) "gap:32px")))

(deftest a-real-sidebar-split-in-one-expression
  ; sidebar + content: a row where the aside is fixed-basis and main grows.
  ; The point: a non-trivial layout is still ONE point in the space per box.
  (let [aside (build-css (fn [] (b/box {:basis "240px" :shrink 0 :pad :4})))
        main  (build-css (fn [] (b/box {:grow 1 :pad :5})))]
    (is (includes? (:css aside) "flex-basis:240px"))
    (is (includes? (:css aside) "flex-shrink:0"))
    (is (includes? (:css main) "flex-grow:1"))))

(deftest spacer-grows
  (is (includes? (:css (build-css (fn [] (b/spacer)))) "flex-grow:1"))
  (is (includes? (:css (build-css (fn [] (b/spacer 2)))) "flex-grow:2")))
