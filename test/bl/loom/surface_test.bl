; surface_test.bl — the host-agnostic half of a loom app.
;
; Run: bl test test/bl/loom/surface_test.bl
;
; What every host relies on: a frame is body + sheet, the fold only emits
; JavaScript when the state moved, reserved events never reach the reducer, and
; everything sent DOWN is pure ASCII that a real JavaScript engine reads back as
; the original text (checked with node when it is on PATH).

(ns loom.surface.test
  (:require [loom.surface :as s]
            [loom.ui :as ui]
            [interop]))

(defn- view [n] (ui/button {:on-click [:inc]} (str "count: " n)))
(defn- on-event [n ev] (if (= [:inc] ev) (+ n 1) n))

(defn- ascii? [x] (= :nomatch (re/run x "[^\\x00-\\x7f]")))

(defn- node
  "Run `js` in node and return its stdout, or nil when node is absent."
  [js]
  (when (System/find_executable "node")
    (let [r (System/cmd "node" (list "-e" js) (list (tuple :stderr_to_stdout true)))]
      (erlang/element 1 r))))

(deftest a-frame-is-the-body-and-its-sheet
  (let [f (s/frame view 3)]
    (is (includes? (:body f) "count: 3"))
    (is (includes? (:body f) "data-ev-click='[\"inc\"]'") "the view's event term is on the element")
    (let [cls (second (split (:body f) "\""))]
      (is (includes? (:css f) (str "." cls)) "the sheet carries the class the body uses"))))

(deftest the-fold-speaks-only-when-the-state-moved
  (let [[n js] (s/step view on-event 0 [:inc])]
    (is (= 1 n))
    (is (includes? js "count: 1"))
    (is (starts-with? js "window.__loom_style(") "the sheet goes first, so the body's classes exist"))
  (let [[n js] (s/step view on-event 5 [:nothing])]
    (is (= 5 n))
    (is (nil? js) "an unchanged state sends nothing down")))

(deftest events-come-back-as-the-terms-the-view-wrote
  (is (= [:inc] (s/parse-event "[\"inc\"]")))
  (is (= [[:set-name] "Rita"] (s/parse-event "[[\"set-name\"],\"Rita\"]"))
      "an input wraps its term with the field's value")
  (is (= [:raw "not json"] (s/parse-event "not json"))))

(deftest reserved-events-are-the-surfaces-own
  (is (= [:height 120] (s/reserved (s/parse-event "[\"__loom-height\",120]"))))
  (is (= [:ready] (s/reserved (s/parse-event "[\"__loom-ready\"]"))))
  (is (= [:reply 7 {"ok" 3}] (s/reserved (s/parse-event "[\"__loom-reply\",7,{\"ok\":3}]"))))
  (is (nil? (s/reserved [:inc])) "an app event is not reserved"))

(deftest everything-sent-down-is-ascii
  (let [txt "Sofia 😀 — «ça va?» </script> \u2028"]
    (is (ascii? (s/js-str txt)))
    (is (ascii? (s/swap-js (s/frame (fn [_] (ui/prose {} txt)) nil))))
    (is (= "\"\\u00e9\"" (s/js-str "é")))
    (is (= "\"\\ud83d\\ude00\"" (s/js-str "😀")) "beyond the BMP: a surrogate pair")
    (is (= "plain" (s/ascii "plain")) "ASCII passes through untouched")))

(deftest a-javascript-engine-reads-the-escapes-back
  (let [txt "Sofia 😀 — «ça va?» </script>"
        out (node (str "process.stdout.write(Buffer.from(" (s/js-str txt) ").toString('base64'))"))]
    (when out
      (is (= txt (base64/decode out)) "node decodes the ASCII literal to the original text"))))

(deftest the-page-code-parses
  (let [f (s/frame view 0)
        doc (s/document f {:title "t" :shim "window.bl={send:function(){}};"})
        out (node (str "new Function(" (interop/->json s/client-hook) ");"
                       "new Function(" (interop/->json (s/repaint-js view 2)) ");"
                       "new Function(" (interop/->json (s/probe-js 4 "document.title")) ");"
                       "process.stdout.write('ok')"))]
    (is (includes? doc "<div id=\"loom-root\">"))
    (is (< (index-of doc "window.bl=") (index-of doc "window.__loom =")) "the host's shim runs before the hook")
    (when out (is (= "ok" out) out))))
