; form_test.bl — a form derived from a datom schema value.
;
; Run: mix beam_lisp.test --path priv test/bl/loom/form_test.bl
;
; Proves form-for is a correct, pure projection: one field per attribute, the
; right input kind per valueType, pre-fill + errors + only-filter + edit-mode,
; and the accessibility wiring inherited from loom.ui/field.

(ns loom.form.test
  (:require [loom.form :as form] [loom.token :as t] [live.hiccup :as h]))

;; a fixture schema exercising every valueType branch + hints
(def schema
  [{:db/ident :person/name  :db/valueType :db.type/string :db/unique :db.unique/identity
    :db/doc "Their full name."}
   {:db/ident :person/age   :db/valueType :db.type/long}
   {:db/ident :person/admin :db/valueType :db.type/boolean}
   {:db/ident :person/role  :db/valueType :db.type/keyword
    :form/enum [[:admin "Admin"] [:member "Member"]]}
   {:db/ident :person/bio   :db/valueType :db.type/string :form/multiline true}
   {:db/ident :person/at    :db/valueType :db.type/instant}])

(defn- render [node] (do (t/reset-sheet!) (h/hiccup->html node)))

;; ── one field per attribute, right kind ─────────────────────────────

(deftest string-becomes-a-text-input
  ; ui/field strips the keyword namespace: :person/name → id "f-name"
  (let [html (render (form/form-for schema {}))]
    (is (includes? html "id=\"f-name\""))
    (is (includes? html "type=\"text\""))))

(deftest long-becomes-a-number-input
  (is (includes? (render (form/form-for schema {})) "type=\"number\"")))

(deftest boolean-becomes-a-checkbox
  (is (includes? (render (form/form-for schema {})) "type=\"checkbox\"")))

(deftest keyword-with-enum-becomes-a-select
  (let [html (render (form/form-for schema {}))]
    (is (includes? html "<select"))
    (is (includes? html "value=\"admin\""))
    (is (includes? html "Member"))))

(deftest multiline-string-becomes-a-textarea
  (is (includes? (render (form/form-for schema {})) "<textarea")))

(deftest instant-becomes-a-datetime-input
  (is (includes? (render (form/form-for schema {})) "type=\"datetime-local\"")))

;; ── pre-fill ────────────────────────────────────────────────────────

(deftest values-prefill-the-fields
  (let [html (render (form/form-for schema {:values {:person/name "Ada" :person/age 36}}))]
    (is (includes? html "value=\"Ada\""))
    (is (includes? html "value=\"36\""))))

;; ── errors are aria-wired (inherited from loom.ui/field) ────────────

(deftest errors-are-announced
  (let [html (render (form/form-for schema {:errors {:person/name "required"}}))]
    (is (includes? html "aria-invalid=\"true\""))
    (is (includes? html "role=\"alert\""))
    (is (includes? html "required"))))

;; ── doc becomes a hint ──────────────────────────────────────────────

(deftest doc-becomes-a-hint
  (is (includes? (render (form/form-for schema {})) "Their full name.")))

;; ── :only filters, in order ─────────────────────────────────────────

(deftest only-renders-a-subset
  (let [html (render (form/form-for schema {:only [:person/age]}))]
    (is (includes? html "id=\"f-age\""))
    (is (not (includes? html "id=\"f-name\"")))))

;; ── edit? makes identity attrs read-only ────────────────────────────

(deftest edit-mode-locks-identity-attrs
  ; :person/name is unique/identity → disabled when editing
  (let [html (render (form/form-for schema {:edit? true}))]
    (is (includes? html "disabled"))))

(deftest create-mode-leaves-identity-editable
  ; without :edit?, identity attrs are editable (no disabled on the name input)
  (let [html (render (form/form-for schema {:only [:person/name]}))]
    (is (not (includes? html "disabled")))))

;; ── the submit button carries the intent ────────────────────────────

(deftest submit-button-fires-the-intent
  (let [html (render (form/form-for schema {:on-submit [:intent :save {}]}))]
    (is (includes? html "data-ev-click"))
    (is (includes? html "Save"))))

(deftest no-submit-without-on-submit
  ; a form with no :on-submit renders fields but no button
  (is (not (includes? (render (form/form-for schema {})) "<button"))))

(deftest custom-submit-label
  (is (includes? (render (form/form-for schema {:on-submit [:intent :x {}] :submit "Create"}))
                 "Create")))

;; ── the form element ────────────────────────────────────────────────

(deftest renders-a-form-element
  (is (includes? (render (form/form-for schema {})) "<form")))

;; ── purity: same inputs, same output ────────────────────────────────

(deftest form-for-is-pure
  (t/reset-sheet!)
  (let [a (h/hiccup->html (form/form-for schema {:values {:person/name "X"}}))]
    (t/reset-sheet!)
    (let [b (h/hiccup->html (form/form-for schema {:values {:person/name "X"}}))]
      (is (= a b) "a pure projection: identical inputs → identical markup"))))
