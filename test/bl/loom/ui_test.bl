; ui_test.bl — the loom component vocabulary: accessibility + the no-ceiling contract.
;
; Run: mix beam_lisp.test --path priv test/bl/loom/ui_test.bl
;
; Two things are proven for EVERY component:
;   1. A11Y GUARANTEES — the semantics you cannot ship broken: real labels tied
;      to inputs, ARIA state on error, disabled controls that carry no handler,
;      correct roles, focusable structure.
;   2. NO CEILING — inherited from loom.box: a raw :style that wins, arbitrary
;      attrs forwarded (events, ids, data-*), an author :class appended.

(ns loom.ui.test
  (:require [loom.ui :as ui] [loom.token :as t] [live.hiccup :as h]))

(defn- render [node] (do (t/reset-sheet!) (h/hiccup->html node)))
;; css takes a THUNK so the node is BUILT under a fresh sheet (its sx calls run
;; after the reset), then read — otherwise reset wipes rules registered at build.
(defn- css [thunk] (do (t/reset-sheet!) (h/hiccup->html (thunk)) (t/sheet-css)))

;; ════════════════════════════════════════════════════════════════════
;; Button
;; ════════════════════════════════════════════════════════════════════

(deftest button-has-type-and-handler
  (let [html (render (ui/button {:on-click [:intent :save {}]} "Save"))]
    (is (includes? html "type=\"button\""))
    (is (includes? html "data-ev-click"))
    (is (includes? html ">Save</button>"))
    (is (includes? html "<button"))))

(deftest disabled-button-drops-its-handler
  ; a disabled action must be un-fireable: no data-ev-click, real disabled attrs
  (let [html (render (ui/button {:disabled true :on-click [:intent :x {}]} "No"))]
    (is (includes? html "disabled"))
    (is (includes? html "aria-disabled=\"true\""))
    (is (not (includes? html "data-ev-click")))))

(deftest button-variants-paint-differently
  (is (not= (css (fn [] (ui/button {:variant :primary} "a")))
            (css (fn [] (ui/button {:variant :danger} "a")))))
  ; primary uses the accent background
  (is (includes? (css (fn [] (ui/button {:variant :primary} "a"))) "#5b8def")))

(deftest button-sizes-differ
  (is (not= (css (fn [] (ui/button {:size :sm} "a")))
            (css (fn [] (ui/button {:size :lg} "a"))))))

(deftest button-no-ceiling
  ; a raw :style wins, arbitrary attrs forward
  (let [html (render (ui/button {:style {:background "hotpink"} :id "go"
                                 :data-role "cta" :on-click [:intent :x {}]} "X"))]
    (is (includes? html "id=\"go\""))
    (is (includes? html "data-role=\"cta\""))
    (is (includes? (css (fn [] (ui/button {:style {:background "hotpink"}} "X"))) "hotpink"))))

;; ════════════════════════════════════════════════════════════════════
;; Field
;; ════════════════════════════════════════════════════════════════════

(deftest field-label-is-tied-to-input
  ; clicking the label must focus the input → for/id must match
  (let [html (render (ui/field {:name :email :label "Email" :value ""}))]
    (is (includes? html "for=\"f-email\""))
    (is (includes? html "id=\"f-email\""))))

(deftest field-error-is-announced
  ; an error must be reachable by assistive tech
  (let [html (render (ui/field {:name :email :label "Email" :value "x" :error "Not valid"}))]
    (is (includes? html "aria-invalid=\"true\""))
    (is (includes? html "aria-describedby=\"f-email-err\""))
    (is (includes? html "id=\"f-email-err\""))
    (is (includes? html "role=\"alert\""))
    (is (includes? html "Not valid"))))

(deftest field-hint-is-described
  (let [html (render (ui/field {:name :pw :label "Password" :hint "8+ chars"}))]
    (is (includes? html "aria-describedby=\"f-pw-hint\""))
    (is (includes? html "8+ chars"))))

(deftest field-hint-and-error-both-described
  ; describedby lists BOTH ids when hint and error coexist
  (let [html (render (ui/field {:name :x :label "X" :hint "h" :error "e"}))]
    (is (includes? html "aria-describedby=\"f-x-hint f-x-err\""))))

(deftest field-multiline-is-a-textarea
  (let [html (render (ui/field {:name :bio :label "Bio" :multiline true :value "hi"}))]
    (is (includes? html "<textarea"))
    (is (not (includes? html "type=\"text\"")))))

(deftest field-forwards-events-and-attrs
  ; the :on-input event term must reach the DOM as data-ev-input
  (let [html (render (ui/field {:name :q :label "Q" :on-input [:assign :q [:from :value]]
                                :placeholder "search" :autocomplete "off"}))]
    (is (includes? html "data-ev-input"))
    (is (includes? html "placeholder=\"search\""))
    (is (includes? html "autocomplete=\"off\""))))

;; ════════════════════════════════════════════════════════════════════
;; Checkbox
;; ════════════════════════════════════════════════════════════════════

(deftest checkbox-is-labelled-and-tied
  (let [html (render (ui/checkbox {:name :agree :label "I agree" :checked true}))]
    (is (includes? html "type=\"checkbox\""))
    (is (includes? html "id=\"c-agree\""))
    (is (includes? html "for=\"c-agree\""))
    (is (includes? html "checked"))
    (is (includes? html "I agree"))))

(deftest checkbox-unchecked-has-no-checked-attr
  (is (not (includes? (render (ui/checkbox {:name :x :label "X" :checked false})) "checked"))))

;; ════════════════════════════════════════════════════════════════════
;; Select
;; ════════════════════════════════════════════════════════════════════

(deftest select-renders-options-and-selection
  (let [html (render (ui/select {:name :role :value :admin
                                 :options [[:admin "Admin"] [:member "Member"]]}))]
    (is (includes? html "<select"))
    (is (includes? html "id=\"s-role\""))
    (is (includes? html "value=\"admin\""))
    (is (includes? html "value=\"member\""))
    (is (includes? html "selected"))
    (is (includes? html "Admin"))))

(deftest select-forwards-events
  (let [html (render (ui/select {:name :r :value :a :options [[:a "A"]]
                                 :on-change [:assign :r [:from :value]]}))]
    (is (includes? html "data-ev-change"))))

;; ════════════════════════════════════════════════════════════════════
;; Card / Alert / Badge / Divider / Skeleton
;; ════════════════════════════════════════════════════════════════════

(deftest card-is-a-surface
  (let [html (render (ui/card {} "content"))]
    (is (includes? html "content"))
    (is (includes? html "class="))))

(deftest card-no-ceiling
  (let [html (render (ui/card {:id "hero" :style {:background "black"}} "x"))]
    (is (includes? html "id=\"hero\""))
    (is (includes? (css (fn [] (ui/card {:style {:background "black"}} "x"))) "background:black"))))

(deftest alert-has-role
  (let [html (render (ui/alert {:tone :danger} "Something broke"))]
    (is (includes? html "role=\"alert\""))
    (is (includes? html "Something broke")))
  ; the tone tints the accent border
  (is (includes? (css (fn [] (ui/alert {:tone :danger} "x"))) "#e5534b")))

(deftest badge-renders-with-tone
  (is (includes? (render (ui/badge {:tone :success} "Live")) "Live"))
  (is (includes? (css (fn [] (ui/badge {:tone :success} "Live"))) "#3fb950")))

(deftest divider-is-a-separator
  (is (includes? (render (ui/divider)) "<hr")))

(deftest skeleton-is-hidden-from-at
  ; a loading placeholder must not be announced
  (is (includes? (render (ui/skeleton {:w :8 :h :5})) "aria-hidden=\"true\"")))

;; ════════════════════════════════════════════════════════════════════
;; Typography
;; ════════════════════════════════════════════════════════════════════

(deftest heading-levels
  (is (includes? (render (ui/heading 1 "T")) "<h1"))
  (is (includes? (render (ui/heading 2 "T")) "<h2"))
  (is (includes? (render (ui/heading 3 "T")) "<h3"))
  ; larger level → larger type
  (is (not= (css (fn [] (ui/heading 1 "T"))) (css (fn [] (ui/heading 3 "T"))))))

(deftest prose-tones
  (is (includes? (css (fn [] (ui/prose {:tone :muted} "x"))) "#9aa0a6"))
  (is (includes? (render (ui/prose {} "hello")) "hello")))

(deftest link-points-somewhere
  (let [html (render (ui/link {:href "/about"} "About"))]
    (is (includes? html "<a"))
    (is (includes? html "href=\"/about\""))
    (is (includes? html "About"))))

;; ════════════════════════════════════════════════════════════════════
;; The whole vocabulary collects valid, styled markup
;; ════════════════════════════════════════════════════════════════════

(deftest a-page-collects-its-styles
  (let [result (t/with-sheet
                 (fn []
                   (ui/card {}
                     (ui/heading 1 "Title")
                     (ui/field {:name :email :label "Email" :value ""})
                     (ui/button {:variant :primary} "Go"))))]
    ; the style tag has real rules for the classes the components used
    (is (includes? (second (:style result)) "display:flex"))
    (is (includes? (second (:style result)) "#5b8def"))))     ; the accent button
