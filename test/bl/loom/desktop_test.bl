; test/bl/loom/desktop_test.bl — a desktop window converges by keyed patches.
;
; The window itself needs a display; what it is SENT does not. `render-frame`
; and `patch-script` are the whole render path short of `wry/eval`, so these
; tests pin it: a render ships a live.diff of the last tree, never the page,
; and every class a patch introduces ships its rule with it.

(ns loom.desktop-test
  (:require [loom.desktop :as d] [loom.box :as b] [loom.ui :as ui] [live.diff :as diff]))

(defn- view [s]
  (b/col {:pad :4}
    [:p (str "n=" (:n s))]
    (b/col {} (for [i (:items s)] [:div {:key i} i]))
    (when (:loud s) (ui/badge {:tone :danger} "loud"))))

(deftest an-update-ships-the-keyed-diff-not-the-page
  (let [f0 (d/render-frame view {:n 0 :items ["a" "b"]})
        f1 (d/render-frame view {:n 1 :items ["a" "b" "c"]})
        [js _] (d/patch-script f0 f1)]
    (is (starts-with? js "window.__loom_patch("))
    (is (= (diff/diff (:tree f0) (:tree f1))
           [[:text [0 0] "n=1"] [:insert [1] "c" 2 [:div {:key "c"} "c"]]]))
    (is (not (includes? js "n=0")) "the old content is not resent")))

(deftest an-unchanged-state-ships-nothing
  (let [f0 (d/render-frame view {:n 0 :items []})
        [js remembered] (d/patch-script f0 (d/render-frame view {:n 0 :items []}))]
    (is (nil? js))
    (is (= (:classes f0) (:classes remembered)))))

(deftest new-classes-ship-their-rules-once
  (let [f0 (d/render-frame view {:n 0 :items []})
        f1 (d/render-frame view {:n 0 :items [] :loud true})
        [js1 r1] (d/patch-script f0 f1)
        new-classes (remove (fn [c] (contains? (:classes f0) c)) (:classes f1))]
    (is (seq new-classes) "the badge introduces classes")
    (is (every? (fn [c] (includes? js1 (str "." c))) new-classes) "their rules ride the patch")
    (let [[js2 _] (d/patch-script r1 (d/render-frame view {:n 1 :items [] :loud true}))]
      (is (not (includes? js2 (str "." (first new-classes) "{"))) "and are not shipped again"))))
