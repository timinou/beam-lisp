; transform_test.bl — the view is data: the path-algebra transforms it.
;
; Run: mix beam_lisp.test --path priv test/bl/loom/transform_test.bl
;
; Proves each transform is a correct, pure function over a hiccup value — the
; compounding advantage: no new engine, the existing tools already apply.

(ns loom.transform.test
  (:require [loom.transform :as tf]))

(def sample
  [:div {:class "root"}
   [:button {:on-click [:intent :save {}] :style {:color "red"}} "Save"]
   [:button {:on-click [:intent :cancel {}]} "Cancel"]
   [:input {:id "email" :type "text"}]
   [:input {:type "text"}]                       ; NO id/label — an a11y hole
   [:span {} "hello"]])

;; ── retheme ─────────────────────────────────────────────────────────

(deftest retheme-swaps-values-anywhere
  (let [out (tf/retheme {"red" "blue"} sample)]
    ; the first button's :style color "red" became "blue" (button at index 2)
    (is (= "blue" (get (get (nth (nth out 2) 1) :style) :color)))
    ; unrelated values untouched (div attrs at index 1)
    (is (= "root" (get (nth out 1) :class)))))

(deftest retheme-leaves-unmatched-alone
  (is (= sample (tf/retheme {"nonexistent" "x"} sample))))

;; ── retarget-events ─────────────────────────────────────────────────

(deftest retarget-redirects-every-handler
  ; sample = [:div attrs button button input input span] → buttons at 2,3
  (let [out (tf/retarget-events (fn [_k _v] [:navigate :home]) sample)
        b1 (nth out 2) b2 (nth out 3)]
    (is (= [:navigate :home] (get (nth b1 1) :on-click)))
    (is (= [:navigate :home] (get (nth b2 1) :on-click)))))

(deftest retarget-can-inspect-the-old-term
  ; wrap every intent's op, leaving the shape a legal event
  (let [out (tf/retarget-events
              (fn [_k v] (if (= :intent (first v)) [:intent :audited (nth v 2)] v))
              sample)]
    (is (= :audited (nth (get (nth (nth out 2) 1) :on-click) 1)))))

(deftest retarget-touches-only-event-keys
  ; a non-event attr (:style) is left alone
  (let [out (tf/retarget-events (fn [_k _v] [:navigate :x]) sample)]
    (is (= {:color "red"} (get (nth (nth out 2) 1) :style)))))

;; ── expand-aliases ──────────────────────────────────────────────────

(deftest alias-expands-a-custom-tag
  (let [aliases {:ui/pill (fn [a cs] (into [:span (assoc a :class "pill")] cs))}
        out (tf/expand-aliases aliases [:ui/pill {:id "x"} "hi"])]
    (is (= :span (first out)))
    (is (= "pill" (get (nth out 1) :class)))
    (is (= "x" (get (nth out 1) :id)))
    (is (= "hi" (nth out 2)))))

(deftest alias-expands-nested-occurrences
  (let [aliases {:ui/b (fn [_a cs] (into [:strong {}] cs))}
        out (tf/expand-aliases aliases [:div {} [:ui/b {} "x"] [:ui/b {} "y"]])]
    (is (= :strong (first (nth out 2))))
    (is (= :strong (first (nth out 3))))))

(deftest alias-leaves-unknown-tags
  (is (= [:div {} "x"] (tf/expand-aliases {:ui/pill (fn [_ _] [:span])} [:div {} "x"]))))

;; ── find-nodes / audit ──────────────────────────────────────────────

(deftest find-nodes-collects-matches
  (let [buttons (tf/find-nodes (fn [x] (and (tf/element? x) (= :button (tf/tag-of x)))) sample)]
    (is (= 2 (count buttons)))))

(deftest audit-flags-the-unlabelled-input
  ; exactly one input has no id/aria — the audit finds it, and only it
  (let [holes (tf/audit-missing-labels sample)]
    (is (= 1 (count holes)))
    (is (= :input (tf/tag-of (first holes))))
    (is (not (contains? (tf/attrs-of (first holes)) :id)))))

(deftest audit-passes-a-clean-tree
  (is (= 0 (count (tf/audit-missing-labels
                    [:div {} [:input {:id "ok"}] [:input {:aria-label "search"}]])))))

;; ── map-text ────────────────────────────────────────────────────────

(deftest map-text-transforms-every-leaf
  (let [out (tf/map-text (fn [s] (String/upcase s)) [:div {} "hi" [:span {} "there"]])]
    (is (= "HI" (nth out 2)))
    (is (= "THERE" (nth (nth out 3) 2)))))

(deftest map-text-leaves-non-strings
  ; attribute values that are strings ARE transformed (they are leaves too),
  ; but structural keywords/numbers are not
  (let [out (tf/map-text (fn [s] (str s "!")) [:div {} "x"])]
    (is (= :div (first out)))
    (is (= "x!" (nth out 2)))))
