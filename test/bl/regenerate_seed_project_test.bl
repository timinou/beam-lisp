(ns regenerate-seed-project-test)

(defn- load-script-functions! []
 (let [path (or (System/get_env "BL_REGENERATE_SCRIPT_UNDER_TEST")
                (Path/join (BeamLisp/cwd) "scripts/regenerate-seed.bl"))
       forms (BeamLisp.Reader/read_string (File/read! path) path)]
  ;; Compile the real script definitions, leaving its final invocation inert.
  (Enum/each forms
   (fn [form]
    (when (contains? #{"ns" "defn" "defn-"} (BeamLisp.AOT/stage-head form))
     (BeamLisp.Compiler/eval_form form (BeamLisp.Compiler/new_env "tooling.regenerate-seed")))))))

(defn- script-call [binding args]
 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! "tooling.regenerate-seed" binding) args))

(deftest physical-project-preflight-ignores-missing-or-foreign-cli-cache
 (load-script-functions!)
 (let [previous (erlang/get :bl-cli-project)]
  (try
   (doseq [cached [nil {:app {:name "foreign-project"} :root "/unrelated"}]]
    (erlang/put :bl-cli-project cached)
    (let [app (script-call "bootstrap-project-app!" (list (BeamLisp/cwd)))]
     (is (= true (:ok? app)))
     (is (= "beam_lisp" (:name app)))
     (is (= cached (erlang/get :bl-cli-project)))))
   (finally (if (= :undefined previous) (erlang/erase :bl-cli-project)
               (erlang/put :bl-cli-project previous))))))

(deftest invalid-physical-project-refuses-before-any-host-or-build-output
 (load-script-functions!)
 (let [base (Path/join (System/tmp_dir) (str "bl-regenerate-project-" (erlang/unique_integer (list :positive))))]
  (try
   (doseq [[name content] [["missing-app" "{:name \"missing-app\"}"]
                           ["malformed" "["]
                           ["inherited" "{:app {:name \"ancestor\"}}"]]]
    (let [parent (Path/join base name)
          root (if (= "inherited" name) (Path/join parent "child") parent)
          output (Path/join root "out")]
     (File/mkdir_p! root)
     (File/ln_s! (Path/join (BeamLisp/cwd) "priv") (Path/join root "priv"))
     (File/write! (Path/join parent "env.bl") content)
     (let [previous-root (erlang/apply :Elixir.System :get_env (list "BL_ROOT"))
           previous-code-path (code/get_path)
           kind (try (script-call "regenerate-source-floor!" (list root output)) :unexpected-success
                  (catch error (:kind (ex-data error)))
                  (finally
                   (BeamLisp.Env/remove_search_path (Path/join root "priv/build"))
                   (code/set_path previous-code-path)
                   (if previous-root
                    (erlang/apply :Elixir.System :put_env (list "BL_ROOT" previous-root))
                    (erlang/apply :Elixir.System :delete_env (list "BL_ROOT")))))]
      (is (= :bootstrap-project-invalid kind))
      (is (= false (File/exists? output)))
      (is (= false (File/exists? (Path/join output "fresh-hosts")))))))
   (finally (File/rm_rf! base)))))
