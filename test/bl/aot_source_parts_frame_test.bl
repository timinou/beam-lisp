(ns aot.source-parts-frame-test)

(deftest planner-frames-bind-content-and-decline-corrupt-or-incomplete-data
 (let [path (str (System/tmp_dir!) "/planner-frame-" (erlang/unique_integer (list :positive)))
       content "(ns frame.fixture) (defn value [] 1)"
       hash (crypto/hash :sha256 content)
       parts (BeamLisp.BuildPlan/build-content-parts content)
       frame (fn [value] (let [payload (erlang/term_to_binary value (list :deterministic))]
                          (IO/iodata_to_binary (list (crypto/hash :sha256 payload) payload))))]
  (try
   (File/write! path (frame parts))
   (is (= parts (BeamLisp.AOTCache/read_source_parts path hash)))
   (is (nil? (BeamLisp.AOTCache/read_source_parts path (crypto/hash :sha256 "other"))))
   (File/write! path (frame (dissoc parts :headers)))
   (is (nil? (BeamLisp.AOTCache/read_source_parts path hash)))
   (File/write! path "truncated")
   (is (nil? (BeamLisp.AOTCache/read_source_parts path hash)))
   (File/write! path (IO/iodata_to_binary (list (String/duplicate "x" 32) (erlang/term_to_binary parts))))
   (is (nil? (BeamLisp.AOTCache/read_source_parts path hash)))
   (finally (File/rm path)))))
