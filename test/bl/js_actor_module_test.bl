(ns js.actor-module-test (:require [bl.js :as js] [bl.util :as u]))
(deftest ordinary-modules-use-the-canonical-frame-machine
 (let [result (js/build! "actor-module.fixture"
               {:paths (list "test/js/fixtures") :out "/tmp/bl-actor-module-prototype"})
       [output code] (u/to-list (erlang/tuple_to_list
                     (System/cmd "node" (u/to-list ["--test" "test/js/actor-module.test.mjs"]))))]
  (println output)
  (is (= 0 code))
  (is (contains? (set (:modules result)) "core"))))
