; The cached answer is compared with the unchanged live host in an isolated
; environment. Only the probe beam is loaded; the namespace shim is removed.
; Set BL_ENV_CACHE_REPORT to retain the optional seven-sample comparison.
(ns test.env-namespace-cache (:require [bl.json :as json]))
(def probe :Elixir.BeamLisp.NamespaceCacheProbe)
(defn assert! [answer message] (when-not answer (throw (ex-info message {}))))
(defn exists? [ns] (erlang/apply probe :ns_exists? (list ns)))
(defn same! [ns expected]
  (assert! (= expected (BeamLisp.Env/ns_exists? ns)) (str "live answer: " ns))
  (assert! (= expected (exists? ns)) (str "cached answer: " ns)))
(defn measure [f ns]
  (let [before (erlang/element 2 (erlang/process_info (erlang/self) :reductions))
        result (timer/tc (fn [] (doseq [_ (range 100)] (f ns))))
        after (erlang/element 2 (erlang/process_info (erlang/self) :reductions))]
    {:us (erlang/element 1 result) :reductions (- after before)}))
(defn run-probe []
  (let [dir (str "/tmp/actor-env-cache-probe-" (System/unique_integer (list :positive)))
      source (Path/join (BeamLisp/cwd) "priv/host/env.bl")
      k (tuple probe :ns_exists_cache)]
  (File/mkdir_p! dir)
  (try
    (let [built (BeamLisp.AOT/compile_host_file source
                  (list (tuple :module probe) (tuple :output_dir dir) (tuple :load? false)))
          path (erlang/element 2 built)]
      (code/purge probe) (code/delete probe)
      (code/load_binary probe (erlang/binary_to_list path) (File/read! path))
      (code/purge :Elixir.BeamLisp.Ns.Host.Env) (code/delete :Elixir.BeamLisp.Ns.Host.Env))
    (BeamLisp.Env/isolated (fn []
      (Process/delete k)
      (same! "actor.cache.absent" false)
      (BeamLisp.Env/intern "actor.cache.absent" "x" 1)
      (same! "actor.cache.absent" true)
      (BeamLisp.Env/delete_key (tuple "actor.cache.absent" "x"))
      (same! "actor.cache.absent" false)
      (BeamLisp.Env/declare_ns "actor.cache.empty")
      (same! "actor.cache.empty" true)
      (BeamLisp.Env/put_key (tuple :ns "actor.cache.empty") false)
      (same! "actor.cache.empty" false)
      (BeamLisp.Env/intern "actor.cache.child" "parent" 1)
      (same! "actor.cache.child" true)
      (BeamLisp.Env/isolated (fn []
        (same! "actor.cache.child" true)
        (same! "actor.cache.only-child" false)
        (BeamLisp.Env/intern "actor.cache.only-child" "x" 1)
        (same! "actor.cache.only-child" true)))
      (same! "actor.cache.only-child" false)
      (same! "actor.cache.bulk" false)
      (BeamLisp.Env/intern "actor.cache.bulk" "x" 1)
      (same! "actor.cache.bulk" true)
      ; Only delete this owned child's two-component rows, preserving its
      ; lifetime and wide-generation rows; the wide certificate must still change.
      (BeamLisp.Env/match_delete_own (tuple (tuple :_ :_) :_))
      (same! "actor.cache.bulk" false)
      (same! "actor.cache.publishing" false)
      (let [parent (erlang/self)
            work (BeamLisp.Env/convey (fn [_]
              (BeamLisp.Env/with_publication "actor.cache.publishing" (fn []
                (BeamLisp.Env/intern "actor.cache.publishing" "x" 1)
                (erlang/send parent :published)
                (receive :finish :ok)))
              (erlang/send parent :finished)))
            pid (erlang/spawn (fn [] (work nil)))]
        (try
          (receive :published :ok)
          (assert! (nil? (BeamLisp.Env/namespace_generations (list "actor.cache.publishing"))) "writer did not fence certificate")
          (same! "actor.cache.publishing" true)
          (erlang/send pid :finish)
          (receive :finished :ok)
          (same! "actor.cache.publishing" true)
          (finally (when (erlang/is_process_alive pid) (erlang/exit pid :kill)))))
      (doseq [i (range 300)] (exists? (str "actor.cache.bound." i)))
      (assert! (<= (erlang/map_size (Process/get k {})) 128) "namespace cache unbounded")
      (let [oversized (apply str (repeat 513 "x")) before (Process/get k {})]
        (same! oversized false)
        (assert! (= before (Process/get k {})) "oversized namespace entered cache"))
      (let [outer (BeamLisp.Env/capture) child (BeamLisp.Env/fork)
            token (BeamLisp.Env/with_env child (fn []
              (BeamLisp.Env/intern "actor.cache.destroyed" "x" 1)
              (same! "actor.cache.destroyed" true)
              (BeamLisp.Env/capture)))]
        (try
          (BeamLisp.Env/destroy child)
          (BeamLisp.Env/bind token)
          (same! "actor.cache.destroyed" false)
          (finally (BeamLisp.Env/bind outer))))
      ; Public forks cap their computed chain at eight. Inject a controlled
      ; oversized chain only to exercise the defensive cache bound, then restore.
      (let [chain (Process/get :bl_env_chain) before (Process/get k {})]
        (try
          (Process/put :bl_env_chain (apply list (concat (repeat 33 :global) chain)))
          (same! "actor.cache.deep" false)
          (assert! (= before (Process/get k {})) "oversized chain entered cache")
          (finally (Process/put :bl_env_chain chain))))
      (let [name "actor.cache.benchmark" _ (exists? name)
            result {:schema "beam-lisp.namespace-cache-probe" :version 1 :calls-per-sample 100
                    :live (mapv (fn [_] (measure (fn [ns] (BeamLisp.Env/ns_exists? ns)) name)) (range 7))
                    :cached (mapv (fn [_] (measure exists? name)) (range 7))}]
        (when-let [path (System/get_env "BL_ENV_CACHE_REPORT")]
          (File/write! path (str (json/encode result) "\n"))))
      (println "PASS namespace cache mutation, declaration, fork, destroy, bulk publication, concurrent writer, bounds")
      :ok))
    (finally (Process/delete k) (code/purge probe) (code/delete probe) (File/rm_rf! dir)))))

(deftest namespace-existence-cache-follows-publication
  (is (= :ok (run-probe))))
