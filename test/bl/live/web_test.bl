; web_test.bl — the pure-bl WebSocket adapter boundary.
;
; The adapter (BeamLisp.WebSocket) is the one runtime primitive that lets a
; `.bl` app own a WebSocket: it implements the WebSock behaviour and delegates
; every callback to bl functions. These tests pin that a bl handler's
; ergonomic returns ([:ok s] · [:push msgs s] · [:stop r s]) lower to the exact
; WebSock tuples, and that hyphenated handler keys (:handle-in) resolve.

(ns live.web.test)

(def ^:private Adapter (erlang/binary_to_atom "Elixir.BeamLisp.WebSocket"))
(defn- wrap [handlers state] (erlang/apply Adapter :wrap (list handlers state)))
(defn- init [w] (erlang/apply Adapter :init (list w)))
(defn- handle-in [frame w] (erlang/apply Adapter :handle_in (list frame w)))

;; a text frame as WebSock delivers it: {payload, [opcode: :text]}
(defn- text-frame [s]
  (erlang/list_to_tuple
    (list s (list (erlang/list_to_tuple (list :opcode :text))))))

;; ── init returns a push ──────────────────────────────────────────────

(deftest init-push-lowers-to-websock-tuple
  (let [handlers {:init (fn [s] [:push [[:text "hi"]] s])}
        w (wrap handlers nil)
        r (init w)]
    ; {:push, [{:text, "hi"}], wrap}
    (is (= :push (erlang/element 1 r)))
    (is (= (erlang/list_to_tuple (list :text "hi"))
           (first (erlang/element 2 r))))))

;; ── handle-in (hyphenated key!) echoes ───────────────────────────────

(deftest handle-in-key-resolves-and-echoes
  ; the whole reason `wrap` normalizes keys: :handle-in crosses as a string
  (let [handlers {:handle-in (fn [frame s]
                               [:push [[:text (str "echo:" (nth frame 1))]] s])}
        w (wrap handlers nil)
        r (handle-in (text-frame "yo") w)]
    (is (= :push (erlang/element 1 r)))
    (is (= (erlang/list_to_tuple (list :text "echo:yo"))
           (first (erlang/element 2 r))))))

;; ── :ok return keeps the connection, updates state ───────────────────

(deftest ok-return-updates-state
  (let [handlers {:handle-in (fn [frame s] [:ok (+ s 1)])}
        w (wrap handlers 0)
        r (handle-in (text-frame "x") w)]
    (is (= :ok (erlang/element 1 r)))
    ; the wrap's :state field advanced to 1
    (is (= 1 (erlang/map_get :state (erlang/element 2 r))))))

;; ── a missing optional callback is a no-op (stays connected) ─────────

(deftest missing-callback-is-ok
  (let [w (wrap {} 42)
        r (handle-in (text-frame "anything") w)]
    (is (= :ok (erlang/element 1 r)))
    (is (= 42 (erlang/map_get :state (erlang/element 2 r))))))
