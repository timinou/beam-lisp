(ns live.ssr-style.test
  (:require [live.app :as app] [loom.token :as t]))

(defn- page [application route]
  (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! "live.app" "render-page")
                       (list application "viewer" route)))

(defn- application []
  {:worlds (fn [_ _] {})
   :theme (fn [ctx] (t/install-theme! {:color {:bg (if (= "/dark" (:route ctx)) "#123456" "#fafafa")}}))
   :routes [["/light" (fn [_] [:ul (for [n [1 2]] [:li {:class (t/sx {:padding "7px"})} n])])]
            ["/dark" (fn [_] [:p {:class (t/sx {:color "green"})} "dark"])]]})

(deftest actual-ssr-collects-lazy-rules-without-warm-paths
  (t/reset-sheet!)
  (t/sx {:margin "313px"})
  (let [html (page (application) "/light")]
    (is (includes? html "padding:7px"))
    (is (includes? html "background:#fafafa"))
    (is (not (includes? html "margin:313px")) "previous request rules are excluded")
    (is (< (index-of html "padding:7px") (index-of html "</head>")))
    (is (includes? html "<li"))))

(deftest routes-and-themes-have-isolated-first-paints
  (page (application) "/light")
  (let [html (page (application) "/dark")]
    (is (includes? html "color:green"))
    (is (includes? html "background:#123456"))
    (is (not (includes? html "padding:7px")))))

(deftest stylesheet-collection-never-renders-sample-routes
  (let [calls (atom 0)
        a (assoc (application) :warm ["/forbidden"] :warm-me "other"
                   :routes (conj (:routes (application))
                             ["/forbidden" (fn [_] (swap! calls inc) (throw "must not render"))]))]
    (page a "/light")
    (is (= 0 @calls))
    ;; A real listener launch must also avoid :warm; port zero is ephemeral.
    (let [started (app/serve (assoc a :principal (fn [_] "viewer")) {:port 0 :ip (tuple 127 0 0 1) :log :off})]
      (try (is (= 0 @calls)) (finally (app/stop! started))))))

(deftest animations-and-responsive-rules-are-collected-on-first-request
  (let [a (assoc (application) :routes
            [["/light" (fn [_]
                          (let [motion (t/keyframes {:from {:opacity 0} :to {:opacity 1}})]
                            [:div {:class (t/sx* {:base {:animation (str motion " 1s")}
                                                 :at {:sm {:padding "13px"}}})} "animated"]))]])
        html (page a "/light")]
    (is (includes? html "@keyframes"))
    (is (includes? html "opacity:0"))
    (is (includes? html "padding:13px"))
    (is (includes? html "@media"))))

(deftest public-router-preserves-custom-shell-and-legacy-extra-css
  (Application/put_env :plug :validate_header_keys_during_test false)
  (let [a (assoc (application) :principal (fn [_] "viewer")
                 :shell (fn [_ body css] (str "CUSTOM" css body)))
        request (fn [] (erlang/apply :Elixir.Plug.Test :conn (list "GET" "/light" "")))
        current (app/router a (request))
        legacy (app/router a "<style>.external{color:purple}</style>" (request))]
    (is (= 200 (:status current)))
    (is (includes? (:resp_body current) "CUSTOM"))
    (is (includes? (:resp_body current) "padding:7px"))
    (is (includes? (:resp_body legacy) ".external{color:purple}"))
    (is (includes? (:resp_body legacy) "padding:7px"))))

(deftest each-ssr-installs-the-theme-once
  (let [calls (atom 0)
        a (assoc (application) :theme (fn [_] (swap! calls inc) (t/install-theme! {})))]
    (page a "/light")
    (is (= 1 @calls))))
