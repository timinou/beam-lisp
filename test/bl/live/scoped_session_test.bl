; Same SID and principal cannot cross application instances. A new generation
; of the same instance may reconnect, retaining the old session's exact graph.
(ns live.scoped-session.test
 (:require [live.app :as app] [live.hiccup :as h] [proc.instance :as instance]
           [reload.generation :as gen] [datom]))

(defn- prepared [application label]
 (gen/prepare!
  {:application-id application
   :sources {"scoped.session.application"
     (str "(ns scoped.session.application) "
          "(defn application [] {:home \"/\" :worlds (fn [_ _] {}) "
          ":routes [[\"/\" (fn [_] [:main \"" label "\"])] ]})")}}))

(defn- attach [generation connection sid]
 (gen/with! generation
  (fn []
   (let [application (gen/invoke! generation "scoped.session.application/application" [])
         result ((get app/ws-handlers :init)
                   {:app application :me "same-principal" :route "/"
                    :shared connection :observe [] :sid sid})]
    (get (nth result 1) :srv)))))

(defn- flush-frames [] (receive _ (flush-frames) (after 0 nil)))

(deftest same-session-and-principal-are-isolated-across-instances
 (let [suffix (str (erlang/unique_integer (list :positive)))
       alpha-id (str "session-alpha-" suffix) beta-id (str "session-beta-" suffix)
       old (prepared alpha-id "ALPHA-OLD-PRIVATE") fresh (prepared alpha-id "ALPHA-NEW-PRIVATE")
       beta (prepared beta-id "BETA-PRIVATE")
       alpha-conn (datom/connect []) beta-conn (datom/connect [])
       alpha-pid (atom nil) beta-pid (atom nil)
       alpha-registry (atom nil) beta-registry (atom nil)]
  (try
   (is (= :live-sessions (instance/name :live-sessions)) "ordinary callers retain their existing registry identity")
   (reset! alpha-pid (attach old alpha-conn "known-session-id"))
   (reset! alpha-registry (gen/with! old #(instance/whereis :live-sessions)))
   (is (erlang/is_pid @alpha-pid))
   (is (nil? (gen/with! beta #(app/session-of "known-session-id")))
       "a known session ID does not resolve in another application")
   (reset! beta-registry (gen/with! beta #(instance/whereis :live-sessions)))
   (reset! beta-pid (attach beta beta-conn "known-session-id"))
   (is (not= @alpha-registry @beta-registry))
   (is (not= @alpha-pid @beta-pid) "same authenticated principal cannot attach to the other instance")
   (is (= @alpha-pid (gen/with! fresh #(app/session-of "known-session-id")))
       "instance identity is stable across source generations")
   (is (= @alpha-pid (attach fresh alpha-conn "known-session-id"))
       "reconnect preserves the physical session PID")
   (is (= @beta-pid (gen/with! beta #(app/session-of "known-session-id"))))
   (let [alpha-html (h/hiccup->html (:tree (call @alpha-pid [:state])))
         beta-html (h/hiccup->html (:tree (call @beta-pid [:state])))]
    (is (String/contains? alpha-html "ALPHA-OLD-PRIVATE"))
    (is (not (String/contains? alpha-html "ALPHA-NEW-PRIVATE")) "reconnect does not silently swap old app callbacks")
    (is (not (String/contains? alpha-html "BETA-PRIVATE")))
    (is (String/contains? beta-html "BETA-PRIVATE"))
    (is (not (String/contains? beta-html "ALPHA-OLD-PRIVATE"))))
   (is (= :waiting (:status (gen/retire! old))) "the actual session actor retains the complete old graph")
   (stop @alpha-pid)
   (is (= :retired (:status (gen/retire! old))) "socket death releases its graph while the shared registry survives")
   (reset! alpha-pid (attach fresh alpha-conn "known-session-id"))
   (is (= @alpha-registry (gen/with! fresh #(instance/whereis :live-sessions)))
       "the data-only registry remains usable after its starting generation retires")
   (is (String/contains? (h/hiccup->html (:tree (call @alpha-pid [:state]))) "ALPHA-NEW-PRIVATE")
       "a new session uses the candidate only after the old session actually ended")
   (finally
    (doseq [pid (filter some? [@alpha-pid @beta-pid @alpha-registry @beta-registry])]
     (when (Process/alive? pid) (stop pid)))
    (datom/close! alpha-conn) (datom/close! beta-conn)
    (doseq [g [old fresh beta]] (gen/retire! g))
    (flush-frames)))))
