(ns live.intent-locals.test
  (:require [live.socket :as socket] [datom]))

(defn- flush-frames []
  (receive _ (flush-frames) (after 0 nil)))

(deftest references-resolve-without-evaluating-code
  (let [locals {:name "current" :draft {:title "new title"}}]
    (is (= "current" (socket/resolve-intent-payload [:live/local :name] locals)))
    (is (= "new title" (socket/resolve-intent-payload ["live/local" ["draft" "title"]] locals)))
    (is (nil? (socket/resolve-intent-payload [:live/local :missing] locals)))
    (is (= {:items [{:value "current"}]}
           (socket/resolve-intent-payload {:items [{:value [:live/local :name]}]} locals)))
    (is (= [:live/local :name]
           (socket/resolve-intent-payload [:live/literal [:live/local :name]] locals)))
    (is (= (list 1 "current")
           (socket/resolve-intent-payload (list 1 (list "live/local" "name")) locals)))
    (is (= {:literal ["unchanged" 3]} (socket/resolve-intent-payload {:literal ["unchanged" 3]} locals)))))

(deftest queued-input-is-visible-to-authorizer-and-performer
  (let [conn (datom/connect [{:db/ident :entry/title :db/valueType :db.type/string}])
        authorized (atom nil)
        performed (atom nil)
        state (socket/mount
                {:shared conn :sink (erlang/self)
                 :view (fn [_ _ _] [:div "view"])
                 :locals {:draft {:title "old rendered value"}}
                 :auth {:principal "curator"
                        :fn (fn [_ payload _]
                              (reset! authorized payload)
                              {:verdict :allow})}
                 :intents {:save (fn [_ payload _]
                                   (reset! performed payload)
                                   [{:db/id -1 :entry/title (:title payload)}])}})
        after-input (socket/handle-event state [:assign [:draft :title] [:from :value]] {:value "latest typed value"})
        stale-button (socket/normalize-event
                       (list "intent" "save" {"title" (list "live/local" (list "draft" "title"))}))]
    ;; Deliberately never regenerate the button after the assign. The event
    ;; carries a reference, not an obsolete copy of the field value.
    (socket/handle-event after-input stale-button {:title "stale DOM fallback"})
    (is (= "latest typed value" (:title @authorized)))
    (is (= @authorized @performed))
    (is (= #{["latest typed value"]}
           (datom/q '[:find ?title :where [?e :entry/title ?title]] (datom/db conn))))
    (datom/close! conn)
    (flush-frames)))

(deftest literal-resource-keys-still-win-and-denial-still-stops-writes
  (let [conn (datom/connect [{:db/ident :entry/title :db/valueType :db.type/string}])
        called (atom false)
        authorized (atom nil)
        state (socket/mount
                {:shared conn :sink (erlang/self)
                 :view (fn [_ _ _] [:div "view"])
                 :locals {:draft "current"}
                 :auth {:principal "curator"
                        :fn (fn [_ payload _] (reset! authorized payload) {:verdict :deny :why :blocked})}
                 :intents {:save (fn [_ _ _] (reset! called true) [])}})]
    (socket/handle-event state [:intent :save {:library "owned" :title [:live/local :draft]}]
                         {:library "forged"})
    (is (= "owned" (:library @authorized)))
    (is (= "current" (:title @authorized)))
    (is (= false @called))
    (is (= #{} (datom/q '[:find ?t :where [?e :entry/title ?t]] (datom/db conn))))
    (datom/close! conn)
    (flush-frames)))
