(ns test.live.app-around (:require [live.app :as app] [web]))
(deftest around-wraps-the-real-router-and-preserves-response
  (let [port (+ 29000 (rem (erlang/system_time :millisecond) 1000))
        called (atom false)]
    (let [started (app/serve {:title "Test" :principal (fn [_] nil) :http (fn [conn _] (web/text conn 201 "wrapped-response"))}
               {:port port :ip (tuple 127 0 0 1) :log :off
                :around (fn [handler conn] (reset! called true) (handler conn))})]
     (try
    (let [r (gen_tcp/connect (tuple 127 0 0 1) port (list :binary (tuple :active false)) 3000)
          socket (erlang/element 2 r)]
      (is (= :ok (erlang/element 1 r)))
      (try
        (gen_tcp/send socket "GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n")
        (let [response (gen_tcp/recv socket 0 3000)]
          (is (= :ok (erlang/element 1 response)))
          (is (String/contains? (erlang/element 2 response) "201"))
          (is (String/contains? (erlang/element 2 response) "wrapped-response"))
          (is @called))
        (finally (gen_tcp/close socket))))
      (finally (app/stop! started))))))
