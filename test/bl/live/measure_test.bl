(ns live.measure-test (:require [live.measure :as measure] [diagnostics :as diag]))

(deftest phase-measurement-is-opt-in-and-preserves-values-and-exceptions
 (let [records (atom []) calls (atom 0)]
  (diag/with-options {:sink nil}
   (is (= :value (measure/phase :view (swap! calls inc) :value))))
  (is (= 1 @calls))
  (is (= [] @records))
  (diag/with-options {:sink (fn [event] (swap! records conj event))}
   (is (= :value (measure/phase :view (swap! calls inc) :value)))
   (is (= :caught (try (measure/phase :realize (throw :fixture)) (catch _ :caught))))
   (is (= 2 @calls))
   (is (= 2 (count @records)))
   (is (= [:view :realize] (mapv :live.phase/name @records)))
   (doseq [event @records]
    (is (>= (:live.phase/duration-us event) 0))
    (is (>= (:live.phase/reductions event) 0))
    (is (= :live.phase/completed (:diagnostics/event event)))))))
