(ns live.measure-test (:require [live.measure :as measure] [diagnostics :as diag]))

(deftest phase-measurement-is-opt-in-and-preserves-values-and-exceptions
 (let [records (atom []) calls (atom 0)]
  (diag/with-options {:sink nil}
   (is (= :value (measure/phase :view (swap! calls inc) :value))))
  (is (= 1 @calls))
  (is (= [] @records))
  (diag/with-options {:sink (fn [event] (swap! records conj event))}
   (is (= :value (measure/phase :view (swap! calls inc) :value)))
   (is (= :caught (try (measure/phase :realize (throw :fixture)) (catch _ :caught))))
   (is (= 2 @calls))
   (is (= 2 (count @records)))
   (is (= [:view :realize] (mapv :live.phase/name @records)))
   (doseq [event @records]
    (is (>= (:live.phase/duration-us event) 0))
    (is (>= (:live.phase/reductions event) 0))
    (is (= :live.phase/completed (:diagnostics/event event)))))))

(deftest navigation-aggregates-phases-at-info-without-enabling-debug
 (let [records (atom [])]
  (diag/with-options {:sink (fn [event] (swap! records conj event)) :min-level :info}
   (is (= :value
          (measure/navigation
           (measure/phase :view (measure/phase :screen :value)))))
   (is (= 1 (count @records)))
   (let [event (first @records)]
    (is (= :live.navigation/completed (:diagnostics/event event)))
    (is (= :info (:diagnostics/level event)))
    (is (string? (:diagnostics/trace-id event)))
    (is (string? (:diagnostics/operation-id event)))
    (is (= :returned (:live.navigation/outcome event)))
    (is (>= (:live.navigation/duration-us event) (:live.navigation/view-us event)))
    (is (>= (:live.navigation/view-us event) (:live.navigation/screen-us event)))
    (is (>= (:live.navigation/reductions event) 0))
    (is (>= (:live.navigation/mailbox-count event) 0)))
   ;; The collector is dynamically scoped; later ordinary phases stay disabled.
   (is (= :later (measure/phase :view :later)))
   (is (= 1 (count @records))))))

(deftest navigation-failure-and-nesting-restore-the-outer-collector
 (let [records (atom [])]
  (diag/with-options {:sink (fn [event] (swap! records conj event)) :min-level :info}
   (is (= :caught
          (try (measure/navigation (measure/phase :screen (throw :fixture)))
               (catch _ :caught))))
   (is (= :raised (:live.navigation/outcome (first @records))))
   (is (= :outer
          (measure/navigation
           (measure/phase :view (measure/navigation (measure/phase :screen :inner)))
           (measure/phase :diff :outer))))
   (is (= 3 (count @records)))
   (is (some? (:live.navigation/screen-us (nth @records 1))))
   (is (nil? (:live.navigation/screen-us (nth @records 2))))
   (is (some? (:live.navigation/diff-us (nth @records 2))))
   (is (= :after (measure/phase :view :after)))
   (is (= 3 (count @records))))))

(deftest navigation-disabled-and-unknown-phases-do-not-leak-data
 (let [records (atom []) calls (atom 0)]
  (diag/with-options {:sink nil :min-level :info}
   (is (= :value (measure/navigation (swap! calls inc) :value))))
  (is (= 1 @calls))
  (diag/with-options {:sink (fn [event] (swap! records conj event)) :min-level :info}
   (is (= :value (measure/navigation (measure/timed :private-document-name (fn [] :value)))))
   (is (= 1 (count @records)))
   (is (nil? (:live.phase/name (first @records))))
   (is (not (contains? (first @records) :private-document-name))))))


(deftest navigation-receipt-clock-measures-queue-and-restores-on-failure
 (let [records (atom [])]
  (diag/with-options {:sink nil}
   (is (nil? (measure/navigation-arrival))))
  (diag/with-options {:sink (fn [event] (swap! records conj event)) :min-level :info}
   (is (erlang/is_integer (measure/navigation-arrival)))
   (let [arrival (- (erlang/monotonic_time :microsecond) 1000)]
    (is (= :caught (try (measure/with-arrival-fn arrival
                          (fn [] (measure/navigation (throw :fixture))))
                       (catch _ :caught))))
    (is (>= (:live.navigation/queue-us (first @records)) 1000)))
   (measure/navigation :later)
   (is (nil? (:live.navigation/queue-us (nth @records 1)))))))
