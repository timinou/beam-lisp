(ns live.app-context.test
  (:require [live.app :as app] [live.diff :as diff] [live.socket :as socket] [datom]))

(defn- flush-frames []
  (receive _ (flush-frames) (after 0 nil)))

(deftest editable-locals-cannot-change-the-app-principal
  (let [seen (atom nil)
        application {:home "/"
                     :worlds (fn [me _] (reset! seen me) {})
                     :routes [["/" (fn [ctx] [:main (:me ctx)])]]}
        conn (datom/connect [])
        started (start app/app-socket {:view app/dispatch :shared conn
                                       :sink (erlang/self) :me "alice"
                                       :locals {:app application :me "alice" :route "/"}})
        pid (if (map? started) (:pid started) started)]
    (try
      (is (= "alice" @seen))
      (let [state (call pid [:state])]
        (is (not (contains? (:locals state) :app)) "privileged app closures are not client-editable locals")
        (is (not (contains? (:locals state) :me)) "authenticated identity is not client-editable state"))
      (is (nil? (socket/resolve-intent-payload [:live/local :app] (:locals (call pid [:state])))))
      (call pid [:event [:assign [:me :id] "bob"]])
      (is (= "alice" @seen) "nested identity writes cannot replace connection identity")
      (call pid [:event [:assign [:app :worlds] "forged"]])
      (is (= "alice" @seen) "nested config writes cannot replace guarded world resolution")
      (call pid [:event [:assign :draft "current input"]])
      (is (= "current input" (socket/resolve-intent-payload [:live/local :draft] (:locals (call pid [:state])))))
      (call pid [:event [:assign :me "bob"]])
      (is (= "alice" @seen) "forged locals must not switch the guarded world resolver")
      (reset! seen nil)
      (call pid [:event [:assign :app nil]])
      (is (= "alice" @seen) "forged app configuration cannot replace the immutable view context")
      (finally (stop pid) (datom/close! conn) (flush-frames)))))

(deftest route-changes-replace-page-boundaries
  (let [application {:home "/a" :worlds (fn [_ _] {})
                     :routes [["/a" (fn [ctx] [:main [:h1 "A"] [:section [:p (get-in ctx [:locals :draft] "first")]]])]
                              ["/b" (fn [_] [:main [:aside [:div "B"]] [:article [:ul [:li "new"]]]])]]}
        a (app/dispatch nil nil {:app application :me "alice" :route "/a"})
        b (app/dispatch nil nil {:app application :me "alice" :route "/b"})
        changed (app/dispatch nil nil {:app application :me "alice" :route "/a" :draft "edited"})
        route-ops (diff/diff a b)
        local-ops (diff/diff a changed)]
    (is (some (fn [op] (= :remove (first op))) route-ops) "the old route subtree is removed")
    (is (some (fn [op] (= :insert (first op))) route-ops) "the new route subtree is inserted coherently")
    (is (not (some (fn [op] (= :remove (first op))) local-ops)) "same-route editing does not remount the page")))

(deftest writing-world-is-observed-without-explicit-observe-list
  (let [conn (datom/connect [{:db/ident :item/title :db/valueType :db.type/string}])
        view (fn [db _ _]
               [:main (str (count (datom/q '[:find ?title :where [_ :item/title ?title]] db)))])
        started (start app/app-socket {:view view :shared conn :observe []
                                       :sink (erlang/self) :locals {}})
        pid (if (map? started) (:pid started) started)]
    (try
      (flush-frames)
      (datom/transact! conn [{:db/id -1 :item/title "visible"}])
      (is (vector? (receive [:patch ops] ops (after 1000 nil)))
          "a committed write must reach its writer's screen without :observe wiring")
      (finally (stop pid) (datom/close! conn) (flush-frames)))))

(deftest query-state-keeps-the-page-lifetime-and-patches-only-changes
  (let [application {:home "/feed" :worlds (fn [_ _] {})
                     :routes [["/feed" (fn [ctx]
                                          [:main [:h1 "Feed"]
                                           [:p (get-in ctx [:query :sel] "none")]])]]}
        old (app/dispatch nil nil {:app application :route "/feed"})
        new (app/dispatch nil nil {:app application :route "/feed?sel=row-9"})
        ops (diff/diff old new)]
    (is (= (get-in old [1 1 :key]) (get-in new [1 1 :key]))
        "an inspector/filter change stays in the same page lifetime")
    (is (= "/feed?sel=row-9" (get-in new [1 1 :data-live-route])))
    (is (every? (fn [op] (contains? #{:set-attr :text} (first op))) ops)
        "query state does not remove/insert the whole page")
    (is (= (diff/normalize new) (diff/apply-ops ops old)))))

(deftest different-entity-paths-retain-distinct-page-lifetimes
  (let [application {:worlds (fn [_ _] {})
                     :routes [["/item/:id" (fn [ctx] [:main (get-in ctx [:params :id])])]]}
        old (app/dispatch nil nil {:app application :route "/item/one"})
        new (app/dispatch nil nil {:app application :route "/item/two"})
        ops (diff/diff old new)]
    (is (not= (get-in old [1 1 :key]) (get-in new [1 1 :key])))
    (is (some (fn [op] (= :remove (first op))) ops))
    (is (some (fn [op] (= :insert (first op))) ops))
    (is (= (diff/normalize new) (diff/apply-ops ops old)))))
