; app_test.bl — the live.app wire boundary: which frames the ws endpoint
; accepts, and what each does to the socket process.
;
; ws-handle-in is private, but the PUBLIC ws-handlers map carries it — that
; map is the contract web/upgrade serves, so it is what these tests pin.
; :srv is nil throughout: any branch that (call (:srv state) …)s on a frame
; it should have swallowed crashes here, which is exactly the regression a
; heartbeat is meant to never cause.

(ns live.app.test
  (:require [live.app :as app]))

(defn- handle-in [payload]
  ((get app/ws-handlers :handle-in) [:text payload] {:srv nil}))

;; ── ["ping"] — the heartbeat ─────────────────────────────────────────
;;
;; The client beats every heartbeatMs (default 30s) so a quiet page's socket
;; never hits the server's 120s idle timeout (web/upgrade). The keepalive is
;; the frame's ARRIVAL — the server answers with silence and the socket
;; process must not be touched.

(deftest ping-frame-is-a-noop
  (is (= [:ok {:srv nil}] (handle-in "[\"ping\"]"))))

;; ── anything unrecognised is ignored, not crashed on ─────────────────

(deftest unknown-frame-is-ignored
  (is (= [:ok {:srv nil}] (handle-in "[\"nope\"]"))))

(deftest malformed-payload-is-ignored
  (is (= [:ok {:srv nil}] (handle-in "\"just-a-string\""))))
