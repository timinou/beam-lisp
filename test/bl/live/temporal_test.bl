(ns live.temporal.test
 (:require [live.temporal :as temporal] [connector.clock :as clock]))
(defn- drain [] (receive _ (drain) (after 0 nil)))
(deftest virtual-hints-coalesce-and-refuse-stale-projects
 (let [c (clock/virtual 100) opened (temporal/open! c)
       before (temporal/rearm! opened 200 true)]
  (try
   (is (not (:armed? (temporal/status before))))
   (clock/advance! c 101)
   (let [identity (receive [:connector.clock/changed token] token (after 100 nil))
         pending (temporal/clock-changed! before identity true)
         again (temporal/clock-changed! pending identity true)
         ticket (receive [:live/temporal-project token] token (after 100 nil))]
    (is (= (:pending pending) (:pending again)))
    (is (temporal/project? pending ticket))
    (is (= :none (receive [:live/temporal-project _] :duplicate (after 0 :none))))
    (let [projected (temporal/rearm! pending nil true)]
     (is (not (temporal/project? projected ticket)))
     (is (nil? (:deadline projected)))
     (is (= projected (temporal/clock-changed! projected identity true)))))
   (finally (temporal/close! before) (drain)))))
(deftest real-timer-is-owned-cancelable-and-generation-fenced
 (let [c (clock/system) opened (temporal/open! c)
       armed (temporal/rearm! opened (+ (clock/now c) 60000) true)
       timer (:timer armed) ticket (:timer-ticket armed)
       paused (temporal/pause! armed)]
  (try
   (is (:armed? (temporal/status armed)))
   (is (not (:armed? (temporal/status paused))))
   (is (= false (erlang/read_timer timer)))
   (is (= paused (temporal/deadline! paused ticket true)))
   (is (nil? (:pending (temporal/clock-changed! paused (erlang/make_ref) true))))
   (let [denied (temporal/rearm! armed (+ (clock/now c) 60000) false)]
    (is (nil? (:deadline denied)))
    (is (not (:armed? (temporal/status denied)))))
   (finally (temporal/close! paused) (drain)))))
(deftest past-deadline-cannot-spin
 (let [c (clock/virtual 200) opened (temporal/open! c)]
  (try
   (let [past (temporal/rearm! opened 100 true)]
    (is (nil? (:deadline past)))
    (is (not (:pending? (temporal/status past))))
    (is (= :none (receive [:live/temporal-project _] :loop (after 0 :none)))))
   (finally (temporal/close! opened) (drain)))))
