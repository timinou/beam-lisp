; style_test.bl — the design-token + atomic-style engine.
;
; The contract: a style map produces a stable, content-addressed class;
; identical styles anywhere collapse to one class and one rule; tokens are
; the single source of truth and a typo fails loud.

(ns live.style.test
  (:require [live.style :as s]))

;; ── tokens ──────────────────────────────────────────────────────────

(deftest tokens-resolve
  (is (= "16px" (s/space :4)))
  (is (= "#5b8def" (s/color :accent)))
  (is (= "8px" (s/radius :md))))

(deftest token-typo-fails-loud
  ; a design bug (an off-scale value) must be caught, not silently dropped
  (is (thrown? (s/space :99)))
  (is (thrown? (s/color :not-a-color))))

;; ── sx: stable, deduped classes ─────────────────────────────────────

(deftest same-style-same-class
  (s/reset-sheet!)
  (let [a (s/sx {:color "red" :padding "8px"})
        b (s/sx {:padding "8px" :color "red"})]   ; different order, same content
    (is (= a b) "identical styles collapse to one class regardless of key order")))

(deftest different-style-different-class
  (s/reset-sheet!)
  (is (not= (s/sx {:color "red"}) (s/sx {:color "blue"}))))

(deftest css-is-canonical-and-sorted
  (is (= "color:red;padding:8px" (s/style->css {:padding "8px" :color "red"}))))

(deftest keyword-values-render-as-names
  (is (= "display:flex" (s/style->css {:display :flex}))))

;; ── composition via merge ───────────────────────────────────────────

(deftest sx-merges-maps-left-to-right
  (s/reset-sheet!)
  (let [base {:padding "8px" :color "red"}
        cls (s/sx base {:color "blue"})]           ; later map wins
    (is (includes? (s/sheet-css) "color:blue"))
    (is (includes? (s/sheet-css) "padding:8px"))
    (is (not (includes? (s/sheet-css) "color:red")))))

;; ── the sheet: collect used rules ───────────────────────────────────

(deftest sheet-collects-each-used-class-once
  (s/reset-sheet!)
  (s/sx {:color "red"})
  (s/sx {:color "red"})       ; used twice
  (s/sx {:color "blue"})
  ; two distinct rules, the duplicate collapsed
  (is (= 2 (count (split (s/sheet-css) "\n")))))

(deftest reset-clears-the-sheet
  (s/sx {:color "red"})
  (s/reset-sheet!)
  (is (= "" (s/sheet-css))))

;; ── base css carries the accessibility floor ────────────────────────

(deftest base-css-has-a11y-floor
  (let [css (s/base-css)]
    (is (includes? css "prefers-reduced-motion") "respects reduced-motion")
    (is (includes? css "focus-visible") "a visible keyboard focus ring")
    (is (includes? css "box-sizing:border-box") "a sane reset")))

;; ── with-sheet: scope a render's collected styles ───────────────────

(deftest with-sheet-returns-tree-and-style
  (let [result (s/with-sheet
                 (fn [] [:div {:class (s/sx {:color "red"})} "hi"]))]
    (is (contains? result :tree))
    (is (contains? result :style))
    (is (= :style (first (:style result))))
    ; the style tag's text includes the class this render used
    (is (includes? (second (:style result)) "color:red"))))
