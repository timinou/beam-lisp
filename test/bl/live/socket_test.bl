; socket_test.bl — W3: the live socket loop, headless.
;
; The test socket's :sink is the test process itself, so every push! lands
; in the mailbox and is asserted by receiving (the watch_test.bl pattern).
; No browser, no channel — the whole server-side loop, deterministically.

(ns live.socket.test
  (:require [live.socket :as s] [datom] [datom.store-ets] [data.tap]))

;; ── a shared world + a view + a performer, reused across tests ──────

(defn- fresh-conn []
  (let [c (datom/connect
            [{:db/ident :task/slug :db/valueType :db.type/string
              :db/unique :db.unique/identity}
             {:db/ident :task/title :db/valueType :db.type/string}
             {:db/ident :task/owner :db/valueType :db.type/string}])]
    c))

;; view: (shared-db session-db locals) → hiccup. Optionally owner-scoped.
(defn- board [db _session locals]
  (let [owner (:owner locals)
        q (if (nil? owner)
            '[:find ?slug ?title
              :where [?e :task/slug ?slug] [?e :task/title ?title]]
            ['(:find ?slug ?title
               :where [?e :task/slug ?slug] [?e :task/title ?title]
                      [?e :task/owner ?owner])])
        rows (if (nil? owner)
               (datom/q '[:find ?slug ?title
                          :where [?e :task/slug ?slug] [?e :task/title ?title]] db)
               (datom/q '[:find ?slug ?title
                          :in $ ?owner
                          :where [?e :task/slug ?slug] [?e :task/title ?title]
                                 [?e :task/owner ?owner]] db owner))]
    [:main {:data-draft (or (:draft locals) "")}
     [:ul (for [t (sort rows)]
            [:li {:key (first t)} (second t)])]]))

(defn- create-task [conn payload _principal]
  [{:db/id -1 :task/slug (:slug payload) :task/title (:title payload)
    :task/owner (or (:owner payload) "nobody")}])

(defn- drain
  "Receive the next socket message, or :none after ms."
  [ms]
  (receive
    [:mount html] [:mount html]
    [:patch ops] [:patch ops]
    [:denied why] [:denied why]
    [:style css] [:style css]
    (after ms :none)))

(defn- drain-all
  "Every pending socket message, in order."
  []
  (loop [out []]
    (let [m (drain 50)]
      (if (= :none m) out (recur (conj out m))))))

(defn- flush-mailbox
  "Consume every message the socket pushed at `(erlang/self)`. The runner is a
   single process for the whole tree, so a test that pushes more than it drains
   leaves frames where the NEXT FILE's catch-all receive reads them as its own
   (a residue the `[:tap …]` frames only enlarge). Drain before the test ends."
  []
  (loop []
    (receive
      _ (recur)
      (after 0 :ok))))

;; ── mount ───────────────────────────────────────────────────────────

(deftest mount-paints-full-html
  (let [conn (fresh-conn)]
    (datom/transact! conn [{:db/id -1 :task/slug "a" :task/title "First"}])
    (s/mount {:view board :shared conn :sink (erlang/self) :intents {}})
    (let [[tag html] (drain 200)]
      (is (= :mount tag))
      (is (includes? html "data-key=\"a\""))
      (is (includes? html "First")))))

;; ── assign: a local change re-renders immediately ──────────────────

(deftest assign-is-local-and-immediate
  (let [conn (fresh-conn)]
    (datom/transact! conn [{:db/id -1 :task/slug "a" :task/title "First"}])
    (let [st (s/mount {:view board :shared conn :sink (erlang/self) :intents {}})]
      (drain 200)  ; consume mount
      (s/handle-event st [:assign :draft "hello"] {})
      (let [[tag ops] (drain 200)]
        (is (= :patch tag))
        ; exactly the draft attr changed, nothing else
        (is (= [[:set-attr [] "data-draft" "hello"]] ops))))))

;; ── from-source: a value read at fire time ─────────────────────────

(deftest assign-from-event-data
  (let [conn (fresh-conn)]
    (datom/transact! conn [{:db/id -1 :task/slug "a" :task/title "First"}])
    (let [st (s/mount {:view board :shared conn :sink (erlang/self) :intents {}})]
      (drain 200)
      ; [:from :value] pulls from the event-data map the client sends
      (s/handle-event st [:assign :draft [:from :value]] {:value "typed"})
      (let [[_ ops] (drain 200)]
        (is (= [[:set-attr [] "data-draft" "typed"]] ops))))))

;; ── intent: commits SHARED, does not render here ───────────────────

(deftest intent-commits-and-does-not-render-locally
  (let [conn (fresh-conn)]
    (let [st (s/mount {:view board :shared conn :sink (erlang/self)
                       :intents {:create create-task}})]
      (drain 200)  ; mount
      ; an intent must NOT push a patch from handle-event itself
      (s/handle-event st [:intent :create {:slug "b" :title "Second"}] {})
      (is (= :none (drain 150)) "intent renders via the commit path, not inline")
      ; but the shared world DID change
      (is (= 1 (count (datom/q '[:find ?s :where [_ :task/slug ?s]] (datom/db conn))))))))

;; ── intent → commit path re-renders with a minimal patch ───────────

(deftest commit-path-emits-minimal-insert
  (let [conn (fresh-conn)]
    (datom/transact! conn [{:db/id -1 :task/slug "a" :task/title "First"}])
    (let [st (s/mount {:view board :shared conn :sink (erlang/self)
                       :intents {:create create-task}})]
      (drain 200)  ; mount
      (let [st2 (s/handle-event st [:intent :create {:slug "b" :title "Second"}] {})]
        ; simulate the datom commit landing → on-commit
        (s/on-commit st2)
        (let [[tag ops] (drain 200)]
          (is (= :patch tag))
          ; one keyed insert, not a re-render of the list
          (is (= 1 (count ops)))
          (is (= :insert (first (first ops)))))))))

;; ── unregistered intent: denied, never fatal ───────────────────────

(deftest unknown-intent-denies-and-socket-survives
  (let [conn (fresh-conn)]
    (datom/transact! conn [{:db/id -1 :task/slug "a" :task/title "First"}])
    (let [st (s/mount {:view board :shared conn :sink (erlang/self) :intents {}})]
      (drain 200)  ; mount
      ; the view named an op nobody wired — deny like auth does
      (let [before (count (datom/q '[:find ?s :where [?e :task/slug ?s]]
                                   (datom/db conn)))
            st2 (s/handle-event st [:intent :retry {}] {})]
        (let [[tag why] (drain 200)]
          (is (= :denied tag))
          (is (includes? why "no performer")))
        ; nothing wrote to the shared world
        (is (= before (count (datom/q '[:find ?s :where [?e :task/slug ?s]]
                                     (datom/db conn)))))
        ; and the socket lives on — a local assign still re-renders
        (s/handle-event st2 [:assign :draft "x"] {})
        (is (= :patch (first (drain 200))))))))

;; ── :live/outcome — the socket's verdict on the last intent, in locals ──
;;
;; A view must never say "saved" before the socket knows. After an intent the
;; locals carry {:op :status :seq (:why)} with status :committed | :noop |
;; :denied; the next gesture from this viewer clears it.

(defn- noop-task [_conn _payload _principal] nil)

;; a view that SHOWS the outcome — the toast a real screen would render
(defn- board+outcome [db session locals]
  (let [o (:live/outcome locals)]
    [:div (board db session locals)
     (when o [:output {:data-outcome (name (:status o))} (or (:why o) "")])]))

(deftest outcome-committed-noop-denied
  (let [conn (fresh-conn)
        st (s/mount {:view board+outcome :shared conn :sink (erlang/self)
                     :intents {:create create-task :noop noop-task}})]
    (drain 200)
    ;; committed: recorded in locals, no inline render (the commit path renders)
    (let [st2 (s/handle-event st [:intent :create {:slug "c" :title "C"}] {})
          o (get-in st2 [:locals :live/outcome])]
      (is (= :committed (:status o)))
      (is (= :create (:op o)))
      (is (= :none (drain 100)))
      ;; noop: recorded AND rendered here (nothing else will render it)
      (let [st3 (s/handle-event st2 [:intent :noop {}] {})
            o3 (get-in st3 [:locals :live/outcome])]
        (is (= :noop (:status o3)))
        (is (> (:seq o3) (:seq o)))
        (drain 200)   ; the noop's own render (nothing else would show it)
        ;; denied: recorded with :why, [:denied why] pushed, THIS viewer re-rendered
        (let [st4 (s/handle-event st3 [:intent :nowhere {}] {})
              o4 (get-in st4 [:locals :live/outcome])]
          (is (= :denied (:status o4)))
          (is (includes? (:why o4) "no performer"))
          (is (= :denied (first (drain 200))))   ; the push
          (is (= :patch (first (drain 200))))    ; and this viewer's re-render
          ;; a fresh gesture clears the outcome
          (let [st5 (s/handle-event st4 [:assign :draft "x"] {})]
            (is (nil? (get-in st5 [:locals :live/outcome])))
            (drain 200)))))))

(deftest outcome-survives-a-fold-and-stops-on-denial
  (let [conn (fresh-conn)
        st (s/mount {:view board :shared conn :sink (erlang/self)
                     :intents {:create create-task}})]
    (drain 200)
    ;; intent first, then an assign: the assign runs and the outcome stays
    (let [st2 (s/handle-event st [[:intent :create {:slug "d" :title "D"}] [:assign :draft "after"]] {})]
      (is (= :committed (get-in st2 [:locals :live/outcome :status])))
      (is (= "after" (get-in st2 [:locals :draft])))
      (drain 200))   ; the assign's patch
    ;; a denied intent stops the fold: the assign after it never runs
    (let [st3 (s/handle-event st [[:intent :nowhere {}] [:assign :draft "never"]] {})]
      (is (= :denied (get-in st3 [:locals :live/outcome :status])))
      (is (not= "never" (get-in st3 [:locals :draft])))
      (drain 200) (drain 200))))   ; denied push + re-render

;; ── the deflive MACRO: a real gen_server ────────────────────────────

(s/deflive board-socket
  :view board
  :intents {:create create-task})

(deftest deflive-is-a-real-server
  (let [conn (fresh-conn)]
    (datom/transact! conn [{:db/id -1 :task/slug "a" :task/title "First"}])
    (let [sock (start-link board-socket {:shared conn :sink (erlang/self)})]
      ; mount pushed on init
      (let [[tag html] (drain 300)]
        (is (= :mount tag))
        (is (includes? html "First")))
      ; fire an event as a call
      (call sock [:event [:assign :draft "x"]])
      (let [[tag ops] (drain 300)]
        (is (= :patch tag))
        (is (= [[:set-attr [] "data-draft" "x"]] ops)))
      (stop sock))))

;; ── the wire boundary: normalize-event (JSON strings → keywords) ─────

(deftest normalize-event-intent
  ; a term that crossed JSON arrives as strings (and as a LIST, not a vector)
  (is (= [:intent :post {:text "hi"}]
         (s/normalize-event (list "intent" "post" {"text" "hi"}))))
  (is (= [:intent :post {:text "hi"}]
         (s/normalize-event ["intent" "post" {"text" "hi"}]))))

(deftest normalize-event-assign
  (is (= [:assign :draft [:from :value]]
         (s/normalize-event ["assign" "draft" ["from" "value"]]))))

(deftest normalize-event-navigate-keeps-the-target-as-data
  ; The target is a URL STRING, never a name. Keywordizing it broke two ways,
  ; both measured: a screen that string-splits its route got
  ; `String.split(:"/app", "?")` (FunctionClauseError, socket dead mid-render,
  ; every later event call timed out), and every distinct URL minted an atom
  ; from client input. The op is still keywordized.
  (is (= [:navigate "/lib/x?q=1"]
         (s/normalize-event ["navigate" "/lib/x?q=1"])))
  (is (= [:navigate "/app"]
         (s/normalize-event (list "navigate" "/app"))))
  ; a keyword target (an in-process caller naming a route) passes through
  (is (= [:navigate :home] (s/normalize-event [:navigate :home]))))

(deftest normalize-event-assign-from-list-source
  ; the REAL wire shape: interop/json-> decodes the inner ["from" "value"] as a
  ; LIST, not a vector. normalize-event must still recognise it as [:from …] —
  ; else the source passes through raw and the field value is never read (every
  ; controlled input in a live app breaks). Regression for that bug.
  (is (= [:assign :q [:from :value]]
         (s/normalize-event (list "assign" "q" (list "from" "value")))))
  ; a non-:from literal source still passes through unchanged
  (is (= [:assign :open true]
         (s/normalize-event (list "assign" "open" true)))))

(deftest normalize-event-vector-of-terms
  (is (= [[:assign :draft [:from :value]] [:intent :post {}]]
         (s/normalize-event [["assign" "draft" ["from" "value"]] ["intent" "post" {}]]))))

(deftest normalized-event-dispatches
  ; the real point: a wire term, normalized, drives handle-event end to end
  (let [conn (fresh-conn)
        allow (fn [_ _ _] {:verdict :allow})
        st (s/mount {:view board :shared conn :sink (erlang/self)
                     :intents {:create create-task}
                     :auth {:fn allow :principal "ada"}})]
    (drain 200)
    (s/handle-event st (s/normalize-event (list "intent" "create" {"slug" "x" "title" "Wired"})) {})
    (is (= 1 (count (datom/q '[:find ?s :where [_ :task/slug ?s]] (datom/db conn))))
        "a JSON-decoded intent term commits after normalization")))

;; ── auth: a DENIED intent never commits ────────────────────────────

(deftest denied-intent-never-commits
  (let [conn (fresh-conn)
        ; a pluggable authorizer: deny :create for everyone
        deny-create (fn [op _payload _principal]
                      (if (= op :create)
                        {:verdict :deny :why :not-allowed}
                        {:verdict :allow}))
        st (s/mount {:view board :shared conn :sink (erlang/self)
                     :intents {:create create-task}
                     :auth {:fn deny-create :principal "alice"}})]
    (drain 200)  ; mount
    (s/handle-event st [:intent :create {:slug "x" :title "Nope"}] {})
    ; a [:denied …] is pushed, and the shared world is UNCHANGED
    (let [[tag why] (drain 200)]
      (is (= :denied tag))
      (is (= :not-allowed why)))
    (is (= 0 (count (datom/q '[:find ?s :where [_ :task/slug ?s]] (datom/db conn))))
        "a denied intent must never reach transact!")))

(deftest allowed-intent-commits
  (let [conn (fresh-conn)
        allow-all (fn [_op _payload _principal] {:verdict :allow})
        st (s/mount {:view board :shared conn :sink (erlang/self)
                     :intents {:create create-task}
                     :auth {:fn allow-all :principal "alice"}})]
    (drain 200)
    (s/handle-event st [:intent :create {:slug "x" :title "Yes"}] {})
    (is (= 1 (count (datom/q '[:find ?s :where [_ :task/slug ?s]] (datom/db conn))))
        "an allowed intent commits")))

;; ── two viewers converge on ONE write, through the log ──────────────

(s/deflive convergent-socket
  :view board
  :intents {:create create-task}
  :listen {})

(deftest two-sockets-converge-on-one-write
  (let [conn (fresh-conn)
        me (erlang/self)]
    (datom/transact! conn [{:db/id -1 :task/slug "a" :task/title "First"}])
    ; two sockets, each sinking to a labelled collector so we can tell them apart
    (let [collector (fn [label]
                      (erlang/spawn
                        (fn []
                          (loop []
                            (receive
                              [:mount _] (recur)
                              [:patch ops] (do (erlang/send me [label ops]) (recur))
                              (after 2000 nil))))))
          a (collector :a)
          b (collector :b)
          sa (start-link convergent-socket {:shared conn :sink a})
          sb (start-link convergent-socket {:shared conn :sink b})]
      (Process/sleep 50)
      ; ONE write to the shared world
      (datom/transact! conn [{:db/id -1 :task/slug "b" :task/title "Second"}])
      (Process/sleep 100)
      ; BOTH sockets should have pushed a patch inserting "b"
      (let [got-a (receive [:a ops] ops (after 500 :none))
            got-b (receive [:b ops] ops (after 500 :none))]
        (is (not= :none got-a) "socket A re-rendered on the shared commit")
        (is (not= :none got-b) "socket B re-rendered on the shared commit")
        (is (= :insert (first (first got-a))))
        (is (= :insert (first (first got-b)))))
      (stop sa)
      (stop sb))))

(deftest assign-key-vector-path-survives-json
  ;; a per-component assign [:assign [:draft :name] [:from :value]] crosses the
  ;; wire as lists of strings; normalize-event must hand back a VECTOR path so
  ;; assign-path nests instead of writing a list-keyed top-level entry
  (let [ev (s/normalize-event (list "assign" (list "draft" "name") (list "from" "value")))]
    (is (= [:assign [:draft :name] [:from :value]] ev))
    (let [st (s/mount {:view (fn [_ _ locals] [:div (str (get-in locals [:draft :name]))])
                          :shared (datom/connect []) :session nil :sink (erlang/self) :locals {}})
          st2 (s/handle-event st ev {:value "hello"})]
      (is (= "hello" (get-in (:locals st2) [:draft :name])))
      (flush-mailbox))))

(deftest a-denied-intent-stops-the-rest-of-the-vector
  ;; [intent, flash, navigate]: when the intent is denied, the flash and the
  ;; navigate must NOT run — they would claim a write that did not happen.
  (let [conn (fresh-conn)
        st (s/mount {:view (fn [_ _ locals] [:div (str (:flash locals)) (str (:route locals))])
                     :shared conn :sink (erlang/self) :locals {}
                     :auth {:principal "x" :fn (fn [_ _ _] {:verdict :deny :why "no"})}
                     :intents {:post (fn [_ _ _] nil)}})
        st2 (s/handle-event st [[:intent :post {}] [:assign :flash "saved"] [:navigate "/away"]] {})]
    (is (nil? (:flash (:locals st2))))
    (is (nil? (:route (:locals st2))))
    (is (not (contains? st2 :denied-last)))
    ;; a COMMITTED intent lets the rest run
    (let [st3 (s/mount {:view (fn [_ _ locals] [:div (str (:flash locals))])
                        :shared conn :sink (erlang/self) :locals {}
                        :intents {:post create-task}})
          st4 (s/handle-event st3 [[:intent :post {:slug "p" :title "P"}] [:assign :flash "saved"]] {})]
      (is (= "saved" (:flash (:locals st4)))))
    ;; a NO-OP (the performer validated and declined: nil tx) wrote nothing,
    ;; so "saved" would be a lie — the fold stops there too
    (let [st5 (s/mount {:view (fn [_ _ locals] [:div (str (:flash locals))])
                        :shared conn :sink (erlang/self) :locals {}
                        :intents {:post (fn [_ _ _] nil)}})
          st6 (s/handle-event st5 [[:intent :post {}] [:assign :flash "saved"]] {})]
      (is (= :noop (get-in st6 [:locals :live/outcome :status])))
      (is (nil? (:flash (:locals st6))))
      (flush-mailbox))))

;; ── the tap: every mount/commit publishes a frame ───────────────────

(deftest tap-receives-a-frame-per-mount-and-commit
  (let [conn (datom/connect [{:db/ident :n/v :db/valueType :db.type/long}])
        _ (datom/transact! conn [{:db/id -1 :n/v 1}])
        view (fn [db _s locals]
               [:div [:span (str (count (datom/q '[:find ?v :where [_ :n/v ?v]] db)))]
                     [:b (str (:label locals))]])
        t (data.tap/open)
        me (erlang/self)
        st (s/mount {:view view :shared conn :sink me :locals {:label "a"} :tap t})]
    ;; mount → one frame of kind :mount, ops empty, tree held
    (is (= 1 (data.tap/size t)))
    (let [f (data.tap/latest t)]
      (is (= :mount (:kind f)))
      (is (= [] (:ops f)))
      (is (= :div (first (:tree f))))
      (is (number? (:ms f)))
      (is (nil? (:event f))))
    ;; the browser was told which :t the mount is
    (is (= [:tap 1] (receive [:tap n _b] [:tap n] (after 100 :none))))
    ;; a local :assign → commit frame with the causing event + the ops
    (let [st2 (s/handle-event st [:assign :label "b"])
          f (data.tap/latest t)]
      (is (= 2 (data.tap/size t)))
      (is (= :commit (:kind f)))
      (is (= [:assign :label "b"] (:event f)))
      (is (= 1 (count (:ops f))))
      (is (= :text (first (first (:ops f)))))
      ;; a no-op commit still publishes (0 ops) — a tool can see "recomputed, nothing changed"
      (s/on-commit st2)
      (is (= 3 (data.tap/size t)))
      (is (= [] (:ops (data.tap/latest t))))
      (flush-mailbox))))

;; ── the stylesheet keeps up with the tree ───────────────────────────



(deftest mount-ships-classes-born-inside-lazy-children
  ;; the mount trap: a `for` produces a LAZY seq, so its `sx` fires only when
  ;; the seq is walked. Pre-fix, mount ran ship-css! BEFORE hiccup->html
  ;; walked the tree — a lazy child's rule missed the mount frame and the
  ;; first paint referenced it naked until the next commit.
  (loom.token/reset-sheet!)
  (let [view (fn [_ _ _]
               [:ul (for [x ["a" "b"]]
                      [:li {:key x :class (loom.token/sx {:padding "7px"})} x])])
        st (s/mount {:view view :shared (datom/connect) :sink (erlang/self) :locals {}})
        styles (filter (fn [f] (= :style (first f))) (drain-all))]
    (is (= 1 (count styles)) "the mount ships one style frame")
    (is (includes? (second (first styles)) "padding:7px")
        "a lazy for-child's rule rides the MOUNT frame, not the next commit's")
    (flush-mailbox)))

(deftest a-patch-ships-classes-born-inside-lazy-children
  ;; the navigation bug: a route change is a whole-screen :replace, and diff
  ;; embeds the new subtree WHOLE — never walking it. Pre-fix the `sx` inside
  ;; its lazy `for` children first fired at JSON serialization, in the WS
  ;; process, AFTER ship-css!, under loom's DEFAULT theme: the DOM named a
  ;; class no stylesheet held (and a different class than SSR produced for
  ;; the same element). The rule must ride WITH the patch, from the socket
  ;; process's own sheet.
  (loom.token/reset-sheet!)
  (let [view (fn [_ _ locals]
               (if (:alt locals)
                 [:div [:ul (for [x ["a" "b"]]
                              [:li {:key x :class (loom.token/sx {:color "green"})} x])]]
                 [:div [:p {:class (loom.token/sx {:color "red"})} "plain"]]))
        st (s/mount {:view view :shared (datom/connect) :sink (erlang/self) :locals {}})
        _ (drain-all)
        _ (s/handle-event st [:assign :alt true] {})
        frames (drain-all)
        styles (filter (fn [f] (= :style (first f))) frames)]
    (is (= 1 (count styles)) "the patch ships exactly one style frame")
    (is (includes? (second (first styles)) "color:green")
        "a class born inside the patch's lazy `for` ships WITH it")
    (is (= :style (first (first frames))) "and the style frame precedes the patch")
    (flush-mailbox)))

(deftest a-theme-flip-ships-the-new-base
  ;; the SSR shell emits body{…} for the FIRST route only; a live navigation
  ;; to a differently-themed route never reloads, so the socket must carry
  ;; the new base — or dark-route light text paints on the light route's
  ;; page. An unchanged base ships nothing (no per-commit noise).
  (loom.token/reset-sheet!)
  (loom.token/install-theme! {:color {:bg "#fafafa" :text "#111111"}})
  (let [view (fn [_ _ locals]
               (loom.token/install-theme!
                 (if (:dark locals)
                   {:color {:bg "#111111" :text "#eeeeee"}}
                   {:color {:bg "#fafafa" :text "#111111"}}))
               ;; IDENTICAL markup under both themes: zero diff ops on the
               ;; flip — the base must still ship (on-commit cannot gate the
               ;; stylesheet on (seq ops)).
               [:div "x"])
        st (s/mount {:view view :shared (datom/connect) :sink (erlang/self) :locals {}})
        mstyles (filter (fn [f] (= :style (first f))) (drain-all))]
    (is (= 1 (count mstyles)) "the mount ships the base once")
    (is (includes? (second (first mstyles)) "background:#fafafa")
        "the mount's base is the light theme's")
    (let [st2 (s/handle-event st [:assign :dark true] {})
          frames (drain-all)
          styles (filter (fn [f] (= :style (first f))) frames)]
      (is (= 1 (count styles)) "the flip ships a style frame despite an empty diff")
      (is (includes? (second (first styles)) "background:#111111")
          "carrying the DARK base")
      (is (not (includes? (second (first styles)) "background:#fafafa"))
          "and not the old one")
      ;; a commit under the SAME theme ships nothing at all
      (let [_ (s/handle-event st2 [:assign :dark true] {})
            frames2 (drain-all)]
        (is (= 0 (count (filter (fn [f] (= :style (first f))) frames2)))
            "an unchanged base ships no style frame")
        (flush-mailbox)))))

(deftest a-socket-ships-the-rules-of-the-classes-it-reaches
  ;; a view that reaches a NEW class on the second render: the mount carries
  ;; the first class's rule, the patch carries only the second's — never a
  ;; rule twice, never a class without its rule (the bug: a route the warm
  ;; list omitted painted unstyled; live.app warms only :warm routes).
  (loom.token/reset-sheet!)
  (let [view (fn [_ _ locals]
               [:div {:class (loom.token/sx {:color "red"})}
                (when (:more locals) [:span {:class (loom.token/sx {:color "blue"})} "more"])])
        st (s/mount {:view view :shared (datom/connect) :sink (erlang/self) :locals {}})
        styles (filter (fn [f] (= :style (first f))) (drain-all))]
    (is (= 1 (count styles)) "the mount ships one style frame")
    (is (includes? (second (first styles)) "color:red"))
    (is (not (includes? (second (first styles)) "color:blue")))
    (let [_ (s/handle-event st [:assign :more true] {})
          styles2 (filter (fn [f] (= :style (first f))) (drain-all))]
      (is (= 1 (count styles2)) "the patch ships the new rule once")
      (is (includes? (second (first styles2)) "color:blue"))
      (is (not (includes? (second (first styles2)) "color:red")) "and never re-ships one the client has"))))
