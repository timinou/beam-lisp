; hiccup_test.bl — W1: the pure hiccup→HTML renderer, golden-tested.
;
; Every case asserts exact string equality: a renderer is a function whose
; contract is its output, character for character. Grouped by the concern
; each pins.

(ns live.hiccup.test
  (:require [live.hiccup :as h]))

;; ── tag shorthand: :div#id.a.b splitting ────────────────────────────

(deftest parse-tag-plain
  (is (= {:tag "h1" :id nil :classes []} (h/parse-tag :h1))))

(deftest parse-tag-classes
  (is (= {:tag "section" :id nil :classes ["panel"]} (h/parse-tag :section.panel)))
  (is (= {:tag "div" :id nil :classes ["card" "wide"]} (h/parse-tag :div.card.wide))))

(deftest parse-tag-id
  (is (= {:tag "div" :id "main" :classes []} (h/parse-tag :div#main))))

(deftest parse-tag-id-and-classes
  (is (= {:tag "div" :id "app" :classes ["card" "wide"]}
         (h/parse-tag :div#app.card.wide))))

;; ── rendering: elements, attrs, text ────────────────────────────────

(deftest render-simple-element
  (is (= "<h1>Tasks</h1>" (h/hiccup->html [:h1 "Tasks"]))))

(deftest render-shorthand-and-attrs
  (is (= "<div id=\"app\" class=\"board\" data-role=\"admin\">hi</div>"
         (h/hiccup->html [:div#app.board {:data-role "admin"} "hi"]))))

(deftest render-class-merge
  ; shorthand classes come first, then :class
  (is (= "<div class=\"card active\">x</div>"
         (h/hiccup->html [:div.card {:class "active"} "x"]))))

(deftest render-explicit-id-wins
  (is (= "<div id=\"real\">x</div>"
         (h/hiccup->html [:div#shorthand {:id "real"} "x"]))))

(deftest render-nested
  (is (= "<div><h3>t</h3><p>body</p></div>"
         (h/hiccup->html [:div [:h3 "t"] [:p "body"]]))))

;; ── the seq-splice rule (the one that deletes the §8 footguns) ───────

(deftest render-seq-splice
  (is (= "<ul><li>a</li><li>b</li></ul>"
         (h/hiccup->html [:ul (for [x ["a" "b"]] [:li x])]))))

(deftest render-empty-seq
  (is (= "<ul></ul>" (h/hiccup->html [:ul (for [x []] [:li x])]))))

;; ── a VECTOR group in child position splices too ─────────────────────
;; `(mapv (fn [x] [:li x]) xs)` is the eager counterpart of `(for …)`.
;; A vector whose head is not a keyword is a GROUP of children: it splices,
;; recursively, exactly like a seq. Otherwise an app that builds rows with
;; `mapv` (no lazy-dependency walk) could not use the result as a child.

(deftest render-mapv-vector-group
  (is (= "<ul><li>a</li><li>b</li></ul>"
         (h/hiccup->html [:ul (mapv (fn [x] [:li x]) ["a" "b"])]))))

(deftest render-empty-vector-group
  (is (= "<div></div>" (h/hiccup->html [:div []])))
  (is (= "<div><p>x</p></div>" (h/hiccup->html [:div [] [:p "x"]]))))

(deftest render-nested-vector-groups
  ; a group may itself contain groups: [(mapv …) [(mapv …)] [:p …]]
  (is (= "<ul><li>a</li><li>b</li><li>c</li><li>d</li></ul>"
         (h/hiccup->html [:ul [(mapv (fn [x] [:li x]) ["a" "b"])
                              [(mapv (fn [x] [:li x]) ["c"])
                               [:li "d"]]]]))))

(deftest render-mixed-seq-and-vector-groups
  (is (= "<ul><li>a</li><li>b</li><li>c</li><li>d</li></ul>"
         (h/hiccup->html [:ul (map (fn [x] [:li x]) ["a" "b"])
                          (mapv (fn [x] [:li x]) ["c" "d"])]))))

(deftest render-vector-group-of-text
  ; a group's items obey the ordinary child rules: strings are text, nil drops
  (is (= "<p>ab</p>" (h/hiccup->html [:p ["a" nil "b"]])))
  (is (= "<p>12</p>" (h/hiccup->html [:p [1 2]]))))

(deftest render-element-semantics-unchanged
  ; [:tag …] keeps its meaning: the first item being a keyword is an ELEMENT,
  ; never a group — even when it is the only item.
  (is (= "<div></div>" (h/hiccup->html [:div])))
  (is (= "<div><span></span></div>" (h/hiccup->html [:div [:span]]))))

(deftest render-vector-group-without-tag-is-not-an-error
  ; the old rule threw here; the vector is a group now
  (is (= "<ul><li>1</li><li>2</li></ul>"
         (h/hiccup->html [:ul (mapv (fn [n] [:li n]) [1 2])]))))

(deftest render-vector-with-attrs-but-no-tag-still-errors
  ; a vector whose first item is an attrs map is genuinely malformed: it has
  ; attributes and children but no tag. Groups are made of NODES, not attrs.
  (is (thrown? (h/hiccup->html [:div [{:class "x"} [:p "y"]]]))))

;; ── text escaping ───────────────────────────────────────────────────

(deftest render-escapes-text
  (is (= "<p>Bob &amp; &lt;co&gt;</p>" (h/hiccup->html [:p "Bob & <co>"]))))

(deftest render-escapes-attr
  (is (= "<a href=\"?a=1&amp;b=2\">x</a>"
         (h/hiccup->html [:a {:href "?a=1&b=2"} "x"]))))

(deftest render-escapes-quotes
  (is (= "<p>say &quot;hi&quot;</p>" (h/hiccup->html [:p "say \"hi\""]))))

;; ── numbers as text ─────────────────────────────────────────────────

(deftest render-number-child
  (is (= "<span>42</span>" (h/hiccup->html [:span 42]))))

;; ── void elements ───────────────────────────────────────────────────

(deftest render-void
  (is (= "<br>" (h/hiccup->html [:br])))
  (is (= "<input class=\"composer\" value=\"draft\">"
         (h/hiccup->html [:input.composer {:value "draft"}]))))

;; ── reserved attributes: :key stripped, :on-* → data-ev-* ───────────

(deftest render-key-becomes-data-key
  ; :key is emitted as data-key so the client can address keyed children
  ; for insert/remove/move, exactly as the differ does.
  (is (= "<li class=\"task\" data-key=\"s1\">First</li>"
         (h/hiccup->html [:li.task {:key "s1"} "First"]))))

(deftest render-event-to-marker
  ; the [:intent …] term travels to the browser as a JSON attribute so the
  ; client can relay it back verbatim on fire.
  (is (= "<button data-ev-click='[\"intent\",\"go\",{}]'>Go</button>"
         (h/hiccup->html [:button {:on-click [:intent :go {}]} "Go"]))))

(deftest render-multiple-events
  (is (= (str "<input value=\"d\""
              " data-ev-input='[\"assign\",\"draft\",[\"from\",\"value\"]]'"
              " data-ev-keydown='[\"intent\",\"create\",{}]'>")
         (h/hiccup->html [:input {:value "d"
                                  :on-input [:assign :draft [:from :value]]
                                  :on-keydown [:intent :create {}]}]))))

;; ── boolean attributes ──────────────────────────────────────────────

(deftest render-boolean-true
  (is (= "<button disabled>x</button>"
         (h/hiccup->html [:button {:disabled true} "x"]))))

(deftest render-boolean-false-omitted
  (is (= "<button>x</button>"
         (h/hiccup->html [:button {:disabled false} "x"]))))

(deftest render-nil-attr-omitted
  (is (= "<div>x</div>" (h/hiccup->html [:div {:title nil} "x"]))))

;; ── nil children dropped ────────────────────────────────────────────

(deftest render-nil-child
  (is (= "<div>ab</div>" (h/hiccup->html [:div "a" nil "b"]))))

(deftest render-empty-seq-child
  ;; `(map row [])` over an empty model: nothing, never the text "()"
  (is (= "<div><p>a</p></div>" (h/hiccup->html [:div [:p "a"] (map (fn [x] [:i x]) (list))])))
  (is (= "<div></div>" (h/hiccup->html [:div (list)]))))

(deftest render-when-nil
  (is (= "<div>a</div>" (h/hiccup->html [:div "a" (when false "b")]))))

;; ── the real thing: a keyed list, the view-layer shape ──────────────

(deftest render-keyed-task-list
  (is (= (str "<ul>"
              "<li class=\"task\" data-key=\"a\" data-ev-click='[\"intent\",\"pick\",{\"slug\":\"a\"}]'>First</li>"
              "<li class=\"task\" data-key=\"b\" data-ev-click='[\"intent\",\"pick\",{\"slug\":\"b\"}]'>Bob &amp; &lt;co&gt;</li>"
              "</ul>")
         (h/hiccup->html
           [:ul (for [t [{:slug "a" :title "First"}
                         {:slug "b" :title "Bob & <co>"}]]
                  [:li.task {:key (:slug t) :on-click [:intent :pick {:slug (:slug t)}]}
                   (:title t)])]))))

;; ── an EMPTY child group renders as nothing (FUP-123 Finding E) ─────
;; In this runtime an empty list is `list?` but not `seq?`. The renderer used to
;; test `seq?` only, so `(apply list [])` fell through to `escape` and printed
;; the literal "()" — on every live page that mapped an empty collection.

(deftest render-empty-list-child-group
  (is (= "<div><p>x</p></div>" (h/hiccup->html [:div (apply list []) [:p "x"]])))
  (is (= "<div><p>x</p></div>" (h/hiccup->html [:div (list) [:p "x"]])))
  (is (= "<div><i>a</i></div>" (h/hiccup->html [:div (apply list [[:i "a"]])]))))


(deftest render-event-escapes-apostrophes-in-source-data
  (is (= "<button data-ev-click='[\"intent\",\"review\",{\"quote\":\"L&#39;Agent consulte la Mémoire.\"}]'>Review</button>"
         (h/hiccup->html [:button {:on-click [:intent :review {:quote "L'Agent consulte la Mémoire."}]} "Review"]))))

(deftest render-event-preserves-literal-entities-and-markup-as-data
  (is (= "<button data-ev-click='[\"intent\",\"review\",{\"quote\":\"&amp;#39; &amp; &lt;source&gt;\"}]'>Review</button>"
         (h/hiccup->html [:button {:on-click [:intent :review {:quote "&#39; & <source>"}]} "Review"]))))
