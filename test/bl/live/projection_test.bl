(ns live.projection-test
  (:require [live.projection :as p] [veritas.model :as vm]))

(deftest ordered-lookahead-has-hard-barriers
  (is (p/superseded? [:commit] [[:navigate "/new"]]))
  (is (p/superseded? [:navigate] [[:commit] [:navigate "/new"]]))
  (is (p/superseded? [:assign :q] [[:commit] [:assign :q "last"]]))
  (doseq [barrier [[:intent :save] [:barrier] [[:assign :q 1] [:navigate "/new"]]
                   [:assign :other 1]]]
    (is (not (p/superseded? [:navigate] [barrier [:navigate "/new"]])))
    (is (not (p/superseded? [:assign :q] [barrier [:assign :q 2]]))))
  (is (not (p/superseded? [:navigate] [[:commit]])))
  (is (not (p/superseded? [:navigate] []))))

;; Compare the optimized scheduler with a reference that projects EVERY event.
;; A barrier observes the previously painted locals; eventual output must match.
(defn- project-history [history]
  (loop [xs (seq history) locals {} painted {} seen [] renders 0]
    (if (empty? xs)
      {:locals locals :painted painted :seen seen :renders renders}
      (let [e (first xs) tail (rest xs) kind (first e)
            next (cond (= kind :navigate) (assoc locals :route (second e))
                       (= kind :assign) (assoc locals (second e) (nth e 2))
                       :else locals)
            barrier (= kind :barrier)
            skip (and (not barrier) (p/superseded? e tail))]
        (recur tail next (if (or skip barrier) painted next)
               (if barrier (conj seen painted) seen)
               (if (or skip barrier) renders (+ renders 1)))))))

(defn- reference [history]
  (reduce (fn [s e]
            (let [kind (first e) old (:locals s)
                  next (cond (= kind :navigate) (assoc old :route (second e))
                             (= kind :assign) (assoc old (second e) (nth e 2))
                             :else old)]
              (if (= kind :barrier)
                (update s :seen conj (:painted s))
                (assoc s :locals next :painted next))))
          {:locals {} :painted {} :seen []} history))

(def projection-model
  (vm/model "ordered projection convergence"
    {:state [] :init (fn [] (atom []))
     :commands
     {:enqueue {:args (vm/one-of [[:navigate "/a"] [:navigate "/b"]
                                  [:assign :q "a"] [:assign :q "b"]
                                  [:assign :other 1] [:commit] [:barrier]])
                :next (fn [s e] (conj s e))
                :run (fn [sys e] (swap! sys conj e))}}
     :invariants {:events-preserved (fn [s sys] (= s @sys))}
     :eventually
     {:same-final-and-observed-state
       (fn [s _]
         (let [actual (project-history s)]
           (= (reference s) (dissoc actual :renders))))}}))

(deftest generated-histories-preserve-visible-state-and-converge
  (let [r (vm/check projection-model {:seed 67 :histories 300 :max-len 30})]
    (is (= :witnessed (:modality r)) (pr-str r))
    (is (= 300 (:tried r)))))

(deftest burst-projection-budget-is-independent-of-route-count
  (let [history (mapv (fn [n] [:navigate (str "/route/" n)]) (range 100))
        result (project-history history)]
    (is (= 1 (:renders result)))
    (is (= {:route "/route/99"} (:painted result)))))
