; diff_test.bl — W2: the keyed structural differ.
;
; Two kinds of assertion:
;   1. GOLDEN — a specific (old,new) pair yields a specific, MINIMAL op set.
;      This pins that a reorder is :move (not :replace), an append is one
;      :insert, etc. — the properties that make this better than string diff.
;   2. PROPERTY — for every pair, (apply-ops (diff a b) a) == b. The ops are
;      not just plausible; applying them reconstructs the target exactly.

(ns live.diff.test
  (:require [live.diff :as d]))

;; these tests deliberately diff unkeyed lists; silence the advisory warning
;; so the suite output stays clean (one test re-enables it to check the toggle).
(d/set-keyless-warning! false)

;; ── golden: minimal ops ─────────────────────────────────────────────

(deftest text-change-one-op
  (is (= [[:text [0 0] "new"]]
         (d/diff [:div [:h3 "old"]] [:div [:h3 "new"]]))))

(deftest attr-change-one-op
  (is (= [[:set-attr [] "data-state" "open"]]
         (d/diff [:div {:data-state "closed"}] [:div {:data-state "open"}]))))

(deftest attr-removed
  (is (= [[:remove-attr [] "title"]]
         (d/diff [:div {:title "x"}] [:div {}]))))

(deftest tag-change-is-replace
  (is (= [[:replace [] [:span "x"]]]
         (d/diff [:div "x"] [:span "x"]))))

(deftest keyed-append-one-insert
  ; op shape: [:insert path key index subtree]
  (is (= [[:insert [] "b" 1 [:li {:key "b"} "B"]]]
         (d/diff [:ul [:li {:key "a"} "A"]]
                 [:ul [:li {:key "a"} "A"] [:li {:key "b"} "B"]]))))

(deftest keyed-remove-one-op
  (is (= [[:remove [] "a"]]
         (d/diff [:ul [:li {:key "a"} "A"] [:li {:key "b"} "B"]]
                 [:ul [:li {:key "b"} "B"]]))))

(deftest keyed-reorder-is-moves-not-replace
  ; the signature property: reordering N keyed rows emits :move ops, so the
  ; DOM nodes are preserved (a string diff would rewrite them all)
  (let [ops (d/diff [:ul [:li {:key "a"} "A"] [:li {:key "b"} "B"] [:li {:key "c"} "C"]]
                    [:ul [:li {:key "c"} "C"] [:li {:key "a"} "A"] [:li {:key "b"} "B"]])]
    (is (every? (fn [op] (contains? #{:move} (first op))) ops))
    (is (not (some (fn [op] (= :replace (first op))) ops)))))

(deftest unchanged-is-empty
  (is (= [] (d/diff [:div "same"] [:div "same"]))))

(deftest keyed-content-change-recurses
  ; same key, changed inner text → descends to a :text op at the child path,
  ; no :move (index unchanged), no :replace
  (is (= [[:text [0 0] "B2"]]
         (d/diff [:ul [:li {:key "a"} "B"]]
                 [:ul [:li {:key "a"} "B2"]]))))

;; ── the round-trip property: apply-ops ∘ diff = identity to new ─────

(defn- round-trips? [a b]
  ; apply-ops reconstructs in normalized form (explicit attrs slot), so we
  ; compare normalized-to-normalized: structural equality, not whether an
  ; empty `{}` happens to be written. The DIFF is computed on the authored
  ; trees; only the equality check is normalized.
  (= (d/normalize b) (d/apply-ops (d/diff a b) a)))

(deftest property-text-change
  (is (round-trips? [:div [:h3 "old"]] [:div [:h3 "new"]])))

(deftest property-attr-change
  (is (round-trips? [:div {:data-state "closed"} "x"]
                    [:div {:data-state "open"} "x"])))

(deftest property-keyed-insert
  (is (round-trips? [:ul [:li {:key "a"} "A"]]
                    [:ul [:li {:key "a"} "A"] [:li {:key "b"} "B"]])))

(deftest property-keyed-remove
  (is (round-trips? [:ul [:li {:key "a"} "A"] [:li {:key "b"} "B"]]
                    [:ul [:li {:key "b"} "B"]])))

(deftest property-keyed-reorder
  (is (round-trips? [:ul [:li {:key "a"} "A"] [:li {:key "b"} "B"] [:li {:key "c"} "C"]]
                    [:ul [:li {:key "c"} "C"] [:li {:key "a"} "A"] [:li {:key "b"} "B"]])))

(deftest property-tag-change
  (is (round-trips? [:div "x"] [:span "x"])))

(deftest property-nested-mixed
  (is (round-trips?
        [:main [:header [:h1 "Old"]] [:section [:p "a"] [:p "b"]]]
        [:main [:header [:h1 "New"]] [:section [:p "a"] [:p "c"]]])))

(deftest property-insert-and-reorder
  ; a combined change: one new row AND a reorder of the existing ones
  (is (round-trips?
        [:ul [:li {:key "a"} "A"] [:li {:key "b"} "B"]]
        [:ul [:li {:key "b"} "B"] [:li {:key "c"} "C"] [:li {:key "a"} "A"]])))

(deftest property-positional-children
  ; unkeyed children fall back to positional diff — still must round-trip
  (is (round-trips? [:div [:span "a"] [:span "b"]]
                    [:div [:span "a"] [:span "c"]])))

;; ── unkeyed LENGTH changes: the case that silently dropped/blanked nodes ──
;; A positional diff of lists of DIFFERENT length must still round-trip. These
;; pin the bug where a longer NEW list emitted `:replace` at a nonexistent
;; index (dropping the surplus) and a longer OLD list emitted a blanking
;; `:text` (keeping ghosts). Correctness is independent of keys; keys only
;; change whether nodes MOVE vs re-diff in place.

(deftest property-positional-grow
  (is (round-trips? [:div [:p "a"]]
                    [:div [:p "a"] [:p "b"] [:p "c"]])))

(deftest property-positional-shrink
  (is (round-trips? [:div [:p "a"] [:p "b"] [:p "c"]]
                    [:div [:p "a"]])))

(deftest property-positional-empty-to-many
  (is (round-trips? [:div] [:div [:p "a"] [:p "b"]])))

(deftest property-positional-many-to-empty
  (is (round-trips? [:div [:p "a"] [:p "b"]] [:div])))

(deftest property-positional-grow-and-change
  ; the real catalog case: a list changes length AND its content differs
  (is (round-trips?
        [:div [:section [:h3 "Button"]] [:section [:h3 "Field"]] [:section [:h3 "Checkbox"]]]
        [:div [:section [:h3 "Card"]] [:section [:h3 "Badge"]]
              [:section [:h3 "Alert"]] [:section [:h3 "Divider"]]])))

(deftest keyless-warning-can-be-silenced
  ; the warning is advisory, never affects correctness, and is suppressible
  (d/set-keyless-warning! false)
  (is (round-trips? [:div [:p "a"]] [:div [:p "a"] [:p "b"]]))
  (d/set-keyless-warning! true))

(deftest unkeyed-to-keyed-list-reconciles-positionally
  ;; an unkeyed empty-state (several children) replaced by ONE keyed row: the
  ;; old children must actually be removed. A keyed reconcile with no keys on
  ;; the old side emits [:remove path nil], which names nothing — zombies.
  (let [a [:div [:span "icon"] [:b "Nothing yet"] [:p "hint"] [:a {:href "/x"} "go"]]
        b [:div [:article {:key "c1"} "row"]]
        ops (d/diff a b)]
    (is (= (d/normalize b) (d/apply-ops ops a)))
    (is (not (some (fn [op] (and (= :remove (first op)) (nil? (nth op 2)))) ops)))
    ;; and back again
    (is (= (d/normalize a) (d/apply-ops (d/diff b a) b)))
    ;; an empty keyed list growing stays keyed (insert by key)
    (let [ops2 (d/diff [:ul] [:ul [:li {:key "k"} "x"]])]
      (is (= (d/normalize [:ul [:li {:key "k"} "x"]]) (d/apply-ops ops2 [:ul])))
      (is (= :insert (first (first ops2))))
      (is (= "k" (nth (first ops2) 2))))))
