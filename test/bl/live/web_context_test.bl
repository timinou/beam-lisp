(ns live.web-context-test (:require [web] [env] [vm.osenv :as osenv]))
(defn free-port []
 (let [s (elem (gen_tcp/listen 0 (list :binary (tuple :active false) (tuple :ip (tuple 127 0 0 1)))) 1)
       p (elem (elem (inet/sockname s) 1) 1)]
  (gen_tcp/close s) p))
(defn get-body [port]
 (let [socket (elem (gen_tcp/connect (tuple 127 0 0 1) port
                       (list :binary (tuple :active false)) 3000) 1)]
  (try
   (gen_tcp/send socket "GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n")
   (let [response (loop [parts ""]
                    (let [r (gen_tcp/recv socket 0 3000)]
                     (if (= :ok (elem r 0))
                      (do (when (> (count parts) 8192) (throw (ex-info "oversize response" {})))
                          (recur (str parts (elem r 1)))) parts)))]
    (last (split response "\r\n\r\n")))
   (finally (gen_tcp/close socket)))))
(defn start-scoped [scope port marker root]
 (env/with-env scope
  (fn []
   (osenv/with-env {"BL_WEB_CONTEXT_FIXTURE" marker "BEAM_LISP_DEV" "0" "BEAM_LISP_IMAGE" "release"}
    (fn []
     (BeamLisp/with_cwd root
      (fn []
       (elem (web/serve {:port port :ip (tuple 127 0 0 1) :log :off
                         :plug (fn [c] (web/text c (str (System/get_env "BL_WEB_CONTEXT_FIXTURE")
                                                     ":" (BeamLisp/cwd))))}) 1))))))))

(deftest cold-http-starts-native-dependencies-and-conveys-serving-scope
 ;; The runtime can carry Bandit's modules without starting its OTP app.
 ;; Stop it in this isolated test VM to reproduce executable-drop startup.
 (Application/stop :bandit)
 (is (not (some (fn [app] (= :bandit (elem app 0))) (Application/started_applications))))
 (let [a (env/fork) b (env/fork) pa (free-port) pb (free-port)
       before (env/current) overlay (osenv/overlay)
       sa (start-scoped a pa "alpha" "/scope/alpha")
       sb (start-scoped b pb "beta" "/scope/beta")]
  (try
   (is (boolean (some (fn [app] (= :bandit (elem app 0))) (Application/started_applications))))
   (is (= "alpha:/scope/alpha" (get-body pa)))
   (is (= "beta:/scope/beta" (get-body pb)))
   (is (= "alpha:/scope/alpha" (get-body pa)))
   (is (= before (env/current)))
   (is (= overlay (osenv/overlay)))
   (finally (Supervisor/stop sa :normal 30000) (Supervisor/stop sb :normal 30000)
            (env/destroy a) (env/destroy b)))))
