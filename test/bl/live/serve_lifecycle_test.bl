(ns live.serve-lifecycle-test (:require [live.app :as app] [datom] [web]))
(defn registry []
 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! "datom.conn" "registry") (list)))
(defn cells [] (Agent/get (registry) (fn [entries] entries)))
(defn close-added! [before]
 (doseq [[store cell] (cells)]
  (when (not (contains? before store)) (datom/close! (assoc cell :store store)))))
(defn held-port [f]
 (let [socket (elem (gen_tcp/listen 0 (list :binary (tuple :active false)
                                          (tuple :ip (tuple 127 0 0 1)))) 1)
       port (elem (elem (inet/sockname socket) 1) 1)]
  (try (f port) (finally (gen_tcp/close socket)))))
(deftest failed-listener-start-is-reported-and-releases-its-owned-connection
 (held-port (fn [port]
  (let [before (cells)]
   (try
    (is (= :raised (try (app/serve {} {:port port :ip (tuple 127 0 0 1) :log :off})
                       :returned (catch _ :raised))))
    (is (= (count before) (count (cells))))
    (finally (close-added! before)))))))
(deftest failed-listener-start-preserves-a-caller-owned-connection
 (let [shared (datom/connect [])]
  (try
   (held-port (fn [port]
    (is (= :raised (try (app/serve {:shared-conn shared}
                                 {:port port :ip (tuple 127 0 0 1) :log :off})
                       :returned (catch _ :raised))))
    (is (datom/alive? shared))))
   (finally (datom/close! shared)))))

(deftest stop-releases-an-owned-listener-and-connection
 (let [started (app/serve {} {:port 0 :ip (tuple 127 0 0 1) :log :off})
       listener (:live/listener started) shared (:shared-conn started)]
  (try
   (is (Process/alive? listener))
   (is (datom/alive? shared))
   (is (= nil (app/stop! started)))
   (is (not (Process/alive? listener)))
   (is (not (datom/alive? shared)))
   (is (= nil (app/stop! started)))
   (finally (app/stop! started)))))
(deftest stop-preserves-a-caller-owned-connection
 (let [shared (datom/connect [])
       started (app/serve {:shared-conn shared} {:port 0 :ip (tuple 127 0 0 1) :log :off})]
  (try
   (app/stop! started)
   (is (not (Process/alive? (:live/listener started))))
   (is (datom/alive? shared))
   (is (= nil (app/stop! started)))
   (finally (app/stop! started) (datom/close! shared)))))

(deftest listener-follows-its-owner-even-after-startup-handoff
 (let [parent (erlang/self)
       owner (spawn (fn []
          (let [result (web/serve {:port 0 :ip (tuple 127 0 0 1) :log :off
                                   :plug (fn [c] (web/text c 200 "owned"))})]
           (erlang/send parent [:owned-listener (elem result 1)])
           (receive :finish nil))))
       listener (receive [:owned-listener p] p (after 10000 nil))]
  (try
   (is (some? listener))
   (when listener
    (let [monitor (erlang/monitor :process listener)]
     (erlang/exit owner :kill)
     (is (= :down (receive [:DOWN r :process _ _] :when (= r monitor) :down
                          (after 5000 :timeout))))))
   (finally
    (erlang/exit owner :kill)
    (when (and listener (Process/alive? listener)) (Supervisor/stop listener :normal 30000))))))
