; lint_test.bl — the static unkeyed-rendered-list lint.
;
; Run: mix beam_lisp.test --path priv test/bl/live/lint_test.bl
;
; The compile/start-time counterpart to diff.bl's runtime warning: find every
; (for/map …) whose body is a hiccup element literal without :key, BEFORE the
; app runs. These pin what it flags (high signal) and what it must NOT (keys in
; attrs, keys in ^{:key …} metadata, non-UI seqs, component-fn bodies).

(ns live.lint.test
  (:require [live.lint :as lint] [datom]))

(defn- kinds [src] (into [] (map :kind (lint/lint-source src))))
(defn- tags  [src] (into [] (map :tag  (lint/lint-source src))))
(defn- n     [src] (count (lint/lint-source src)))

;; ── flags the real thing ────────────────────────────────────────────

(deftest flags-unkeyed-for
  (is (= 1 (n "(defn v [] (for [x xs] [:li {:class \"a\"} x]))")))
  (is (= ["li"] (tags "(defn v [] (for [x xs] [:li {:class \"a\"} x]))"))))

(deftest flags-unkeyed-for-without-attrs
  ; [:li x] — no attrs map at all, still no key
  (is (= 1 (n "(defn v [] (for [x xs] [:li x]))"))))

(deftest flags-unkeyed-map-with-fn-body
  (is (= 1 (n "(defn v [] (map (fn [t] [:tr {} (:name t)]) rows))")))
  (is (= ["tr"] (tags "(defn v [] (map (fn [t] [:tr {} (:name t)]) rows))"))))

(deftest flags-mapv-and-map-indexed
  (is (= 1 (n "(defn v [] (mapv (fn [x] [:span x]) xs))")))
  (is (= 1 (n "(defn v [] (map-indexed (fn [i x] [:li x]) xs))"))))

(deftest kind-is-unkeyed-list
  (is (= [:unkeyed-list] (kinds "(defn v [] (for [x xs] [:li x]))"))))

;; ── does NOT flag keyed lists ───────────────────────────────────────

(deftest key-in-attrs-is-clean
  (is (= 0 (n "(defn v [] (for [x xs] [:li {:key (:id x)} x]))"))))

(deftest key-in-metadata-is-clean
  ; ^{:key …} on the vector counts as keyed
  (is (= 0 (n "(defn v [] (for [x xs] ^{:key x} [:li {} x]))"))))

(deftest key-among-other-attrs-is-clean
  (is (= 0 (n "(defn v [] (for [x xs] [:li {:class \"a\" :key (:id x)} x]))"))))

;; ── does NOT flag non-UI or indirect bodies ─────────────────────────

(deftest non-hiccup-seq-is-clean
  ; a seq of numbers is not a rendered list
  (is (= 0 (n "(defn v [] (map inc (range 3)))"))))

(deftest component-fn-body-is-clean
  ; the body is a CALL to a component fn, not a hiccup literal — that fn is
  ; where its own list (if any) would be flagged, not here
  (is (= 0 (n "(defn v [] (for [x xs] (row x)))"))))

(deftest map-with-named-fn-is-clean
  ; (map some-fn coll) has no literal element to inspect
  (is (= 0 (n "(defn v [] (map render-row rows))"))))

;; ── metadata: ns, form, line ────────────────────────────────────────

(deftest carries-ns-form-and-line
  (let [w (first (lint/lint-source "(ns my.app)\n(defn v [] (for [x xs] [:li x]))"))]
    (is (= "my.app" (:ns w)))
    (is (= "for" (:form w)))
    (is (= 2 (:line w)))))

;; ── the datalog surface: facts are queryable ────────────────────────

(deftest lint-db-is-queryable
  (let [warnings (lint/lint-source
                   "(ns app)\n(defn a [] (for [x xs] [:li x]))\n(defn b [] (map (fn [y] [:tr y]) ys))")
        db (lint/lint-db warnings)]
    ; two unkeyed lists → two entities
    (is (= 2 (count (datom/q '[:find ?w :where [?w :warn/kind :unkeyed-list]] db))))
    ; query by tag
    (is (= 1 (count (datom/q '[:find ?w :where [?w :warn/tag "tr"]] db))))))

;; ── the report renders ──────────────────────────────────────────────

(deftest format-is-empty-when-clean
  (is (= "" (lint/format-warnings []))))

(deftest format-names-the-offenders
  (let [out (lint/format-warnings (lint/lint-source "(ns app)\n(defn v [] (for [x xs] [:li x]))"))]
    (is (includes? out "loom/lint"))
    (is (includes? out ":li"))
    (is (includes? out ":key"))))
