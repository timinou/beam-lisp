; print_test.bl — printing values that beam-lisp did not define.
; Run: mix beam_lisp.test test/bl/print_test.bl
;
; ── Why this suite exists ────────────────────────────────────────────────────
;
; `pr-str`, `str` and `println` all funnel into `BeamLisp.RT.print_str`. Every
; value beam-lisp defines has a clause there — vector, set, sorted map, lazy
; seq, record, reference. A value from the HOST does not: a `Date`, a `Regex`,
; an exception. Those are ordinary values in a program that talks to a
; filesystem, a clock, or a parser, and they arrive at the printer in exactly
; the place where printing matters most — a caught error rendered into a log, a
; `{:error e}` map handed back to a caller.
;
; A printer that throws on the value it was asked to describe converts a
; recoverable failure into an unrecoverable one, and it does it at the moment a
; human is reading output to find out what went wrong. So the contract this
; suite pins is narrow and absolute: **print_str is total**. Every value it can
; be handed comes back as a string.
;
; ── What "printable" means for a host value ─────────────────────────────────
;
; A host struct is OPAQUE: beam-lisp cannot render it in its own syntax because
; it is not its own value. Two shapes are the exception, and both have a
; reader-facing form:
;
;   · an EXCEPTION prints as its message — `(str e)` inside a catch handler is
;     how a beam-lisp program reports a failure, and a struct dump there is not
;     a report;
;   · a struct that enumerates as key/value PAIRS is map-shaped (a parsed JSON
;     object), and prints as one.
;
; Everything else prints via `inspect` — the same choice the printer already
; makes for references, and for the same reason: showing the host value's real
; contents beats inventing a beam-lisp rendering for something that is not.

(ns print.test)

(defrecord Point [x y])

; ── an exception is a value you can print ────────────────────────────────────

(deftest a-caught-error-prints-as-its-message
  (is (includes? (pr-str (ex-info "boom" {})) "boom"))
  (is (includes? (try (throw (ex-info "kaput" {}))
                     (catch e (str e)))
                 "kaput")))

(deftest an-error-inside-a-structure-does-not-poison-the-structure
  ; The fence/RPC shape: a failure travelling inside a result map. The map is
  ; still a map, and the error inside it is still readable.
  (let [s (pr-str {:error (ex-info "boom" {}) :ok false})]
    (is (string? s))
    (is (includes? s "boom"))
    (is (includes? s ":ok"))
    (is (includes? s "false"))))

; ── a host value is printable ────────────────────────────────────────────────

(deftest a-host-struct-prints-without-raising
  (is (string? (str (Date/utc_today))))
  (is (string? (str (Regex/compile! "ab+"))))
  (is (includes? (str (Regex/compile! "ab+")) "ab+")
      "a compiled pattern shows its source"))

(deftest a-host-struct-inside-a-beam-lisp-structure-prints
  (is (includes? (pr-str {:today (Date/utc_today)}) ":today"))
  (is (string? (pr-str [(Date/utc_today)]))))

(deftest a-host-struct-prints-in-a-collection-of-many
  ; Printing one host value is the easy case; the failure mode is a printer
  ; that walks a collection and dies on the first element it does not know.
  (is (string? (pr-str (map (fn [_] (Date/utc_today)) [1 2 3])))))

; ── the contract: print_str is total ────────────────────────────────────────

(deftest every-value-shape-prints-to-a-string
  (is (= "[1 2]" (pr-str [1 2])))
  (is (= "#{1}" (pr-str (set [1]))))
  (is (= "{:a 1}" (pr-str {:a 1})))
  (is (= "(1 2)" (pr-str (list 1 2))))
  (is (= "nil" (pr-str nil)))
  (is (= "true" (pr-str true)))
  (is (= "false" (pr-str false)))
  (is (= "abc" (pr-str "abc")))
  (is (= ":kw" (pr-str :kw)))
  (is (= "sym" (pr-str (symbol "sym"))))
  (is (= "3.5" (pr-str 3.5)))
  (is (string? (pr-str (Date/utc_today))))
  (is (string? (pr-str (ex-info "x" {})))))

(deftest a-record-still-prints-as-a-record
  ; A record is a struct AND a beam-lisp value: it must not be swallowed by the
  ; host-struct path. `#ns/Name{field val}` is the form the reader lowers back
  ; into a record, so it is the form the printer owes.
  (let [s (pr-str (->Point 1 2))]
    (is (includes? s "Point{"))
    (is (includes? s ":x 1"))
    (is (includes? s ":y 2"))))
